#lang rhombus
import: "../../rhombus/hol/fusion.rhm" open
import: "../../rhombus/hol/private/compat.rhm" open
export: emit_theorem

fun json_string(s):
  "\"" +& s.replace("\\","\\\\",~all:#true).replace("\"","\\\"",~all:#true).replace("\n","\\n",~all:#true).replace("\r","\\r",~all:#true).replace("\t","\\t",~all:#true) +& "\""
fun join(l):
  match l
  | PairList []: ""
  | PairList [h]: h
  | PairList [h,&t]: h +& "," +& join(t)
fun sty(ty):
  if is_vartype(ty)
  | "[\"Tyvar\","+&json_string(dest_vartype(ty))+&"]"
  | block:
      let [n, args]=dest_type(ty)
      "[\"Tyapp\","+&json_string(n)+&",["+&join(map(sty)(args))+&"]]"
fun stm(tm):
  match tm
  | Var(n,ty): "[\"Var\","+&json_string(n)+&","+&sty(ty)+&"]"
  | Const(n,ty): "[\"Const\","+&json_string(n)+&","+&sty(ty)+&"]"
  | Comb(f,a): "[\"Comb\","+&stm(f)+&","+&stm(a)+&"]"
  | Abs(v,b): "[\"Abs\","+&stm(v)+&","+&stm(b)+&"]"
fun emit_theorem(id,th):
  println(id+&"\t[["+&join(map(stm)(hyp(th)))+&"],"+&stm(concl(th))+&"]")
