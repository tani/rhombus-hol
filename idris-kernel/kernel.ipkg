package kernel

-- LCF kernel prototype, ported from
-- rhombus-hol-lib/rhombus/hol/private/{htype,term,kernel}.rhm.
--
-- Status: exploratory port, compiled through Idris2's Racket backend.
-- NOT wired into the build yet -- rhombus-hol-lib/.../kernel.rhm remains
-- the trust boundary that Rhombus/HOL actually uses.  See ../PLAN.md.

version = 0.1
authors = "Rhombus/HOL"

sourcedir = "src"

modules = HType
        , Term
        , Kernel

main = Main
executable = kernel
