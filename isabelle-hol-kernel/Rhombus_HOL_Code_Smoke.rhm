#lang rhombus

import:
  "./rhombus_hol_kernel.rhm" open

fun is_some(value):
  match value
  | Some(_): #true
  | None(): #false

fun is_none(value):
  match value
  | None(): #true
  | Some(_): #false

fun require_some(value):
  match value
  | Some(result): result
  | None(): error("expected Some")

def n0 = nat_value(0)
def n1 = nat_value(1)
def n2 = nat_value(2)
def n3 = nat_value(3)
def n10 = nat_value(10)
def n11 = nat_value(11)
def thy0 = initial_theory(n0)
def bool_type = TyApp(NBool(), Nil())
def proposition = FVar(NUser(n10, Nil()), bool_type)
def ill_typed = Comb(proposition, proposition)

check check_type(thy0)(bool_type) ~is #true
check check_term(thy0)(proposition) ~is #true
check check_term(thy0)(ill_typed) ~is #false
check is_none(run_code_rule(CodeRefl(thy0, ill_typed))) ~is #true

def refl_thm = require_some(run_code_rule(CodeRefl(thy0, proposition)))
check:
  match concl(refl_thm)
  | Comb(Comb(Const(NEq(), _), left), right): left == proposition && right == proposition
  | ~else: #false
  ~is #true

def child_stamp = next_stamp(n1)(thy_stamp(thy0))
def sibling_stamp = fresh_stamp(n2)
check is_some(combine_stamps(thy_stamp(thy0))(child_stamp)) ~is #true
check is_none(combine_stamps(child_stamp)(sibling_stamp)) ~is #true

def entries = Cons(PairValue(NAlpha(), bool_type), Nil())
def type_request = CodeInstType(thy0, entries, refl_thm)
check valid_code_rule_request(type_request) ~is #true
check is_some(run_code_rule(type_request)) ~is #true

def duplicate_entries = Cons(PairValue(NAlpha(), bool_type), entries)
def invalid_type_request = CodeInstType(thy0, duplicate_entries, refl_thm)
check valid_code_rule_request(invalid_type_request) ~is #false
check is_none(run_code_rule(invalid_type_request)) ~is #true

def type_name = NUser(n10, Nil())
def thy1 = require_some(new_type(n1)(thy0)(type_name)(n0))
check is_none(new_type(n2)(thy1)(type_name)(n0)) ~is #true

def constant_name = NUser(n11, Nil())
def thy2 = require_some(new_constant(n2)(thy1)(constant_name)(bool_type))
check is_none(new_constant(n3)(thy2)(constant_name)(bool_type)) ~is #true
