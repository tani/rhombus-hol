#lang rhombus

import:
  rhombus/hol/kernel_abi as abi
  "./rhombus_hol_kernel.rhm" open

fun require_success(value):
  match value
  | Success(result): result
  | Failure(_): error("expected generated success")

fun is_success(value):
  match value
  | Success(_): #true
  | Failure(_): #false

fun is_failure(value):
  !is_success(value)

fun fun_type(dom, cod):
  abi.raw.tyapp(abi.name_fun, [dom, cod])

fun eq_term(left, right):
  let ty = left.ty
  let eq_ty = fun_type(ty, fun_type(ty, bool_type))
  abi.raw.comb(abi.raw.comb(abi.raw.const(abi.name_eq, eq_ty), left), right)

def bool_type = abi.raw.tyapp(abi.name_bool, [])
def bool_to_bool = fun_type(bool_type, bool_type)
def thy0 = initial_theory(0)
def p = abi.raw.fvar(#'p, bool_type)
def q = abi.raw.fvar(#'q, bool_type)
def identity = abi.raw.abs(bool_type, abi.raw.bvar(0, bool_type))
def beta_redex = abi.raw.comb(identity, p)
def malformed = abi.raw.bvar(0, bool_type)

check check_type(thy0)(bool_type) ~is #true
check check_term(thy0)(p) ~is #true
check check_term(thy0)(malformed) ~is #false
check is_failure(refl(thy0)(malformed)) ~is #true

def refl_p = require_success(refl(thy0)(p))
check concl(refl_p) ~is eq_term(p, p)
def assume_p = require_success(assume(thy0)(p))
check is_success(trans(thy0)(refl_p)(refl_p)) ~is #true
check is_success(mk_comb(thy0)(require_success(refl(thy0)(identity)))(refl_p)) ~is #true
check is_failure(mk_comb(thy0)(refl_p)(refl_p)) ~is #true
check is_success(abs(thy0)(#'q)(bool_type)(refl_p)) ~is #true
check is_success(beta(thy0)(beta_redex)) ~is #true
check is_success(eq_mp(thy0)(refl_p)(assume_p)) ~is #true
check is_success(deduct_antisym(thy0)(assume_p)(assume_p)) ~is #true
check is_success(inst(thy0)([PairValue(q, p)])(refl_p)) ~is #true
def alpha = abi.raw.tyvar(abi.name_alpha)
def polymorphic = abi.raw.fvar(#'x, alpha)
def refl_poly = require_success(refl(thy0)(polymorphic))
def type_entries = [PairValue(abi.name_alpha, bool_type)]
check is_success(inst_type(thy0)(type_entries)(refl_poly)) ~is #true
def duplicate_type_result = inst_type(thy0)([PairValue(abi.name_alpha, bool_type), PairValue(abi.name_alpha, bool_type)])(refl_poly)
check is_failure(duplicate_type_result) ~is #true

def same_text_1 = Symbol.uninterned_from_string("same")
def same_text_2 = Symbol.uninterned_from_string("same")
check same_text_1 == same_text_2 ~is #false
def type_extension_1 = require_success(new_type(1)(thy0)(same_text_1)(0))
def thy1 = match type_extension_1 | PairValue(thy, _): thy
def type_extension_2 = require_success(new_type(2)(thy1)(same_text_2)(0))
def thy2 = match type_extension_2 | PairValue(thy, _): thy
check is_failure(new_type(3)(thy2)(same_text_1)(0)) ~is #true

def constant_extension = require_success(new_constant(4)(thy2)(#'c)(bool_type))
def thy3 = match constant_extension | PairValue(thy, _): thy
check is_failure(new_constant(5)(thy3)(#'c)(bool_type)) ~is #true
def axiom_pair = require_success(new_axiom(6)(thy3)(p))
def thy4:
  match axiom_pair
  | PairValue(thy, _): thy

def definition = eq_term(abi.raw.fvar(#'id, bool_to_bool), identity)
def definition_pair = require_success(new_basic_definition(7)(thy4)(definition))
def thy5:
  match definition_pair
  | PairValue(thy, _): thy

def witness_prop = abi.raw.comb(identity, p)
def witness_pair = require_success(new_axiom(8)(thy5)(witness_prop))
def thy6:
  match witness_pair
  | PairValue(thy, _): thy
def witness:
  match witness_pair
  | PairValue(_, AxiomDelta(th)): th
def type_definition_result = new_basic_type_definition(9)(thy6)(#'sub)(#'mk_sub)(#'dest_sub)(witness)
check is_success(type_definition_result) ~is #true
