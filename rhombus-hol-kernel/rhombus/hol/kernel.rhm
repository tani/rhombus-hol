#lang rhombus/static
// SPDX-License-Identifier: 0BSD AND BSD-2-Clause
// Conservatively covered by the HOL Light notice in THIRD_PARTY_NOTICES.

// Public compatibility boundary for the Isabelle-generated LCF kernel.
// `kernel_generated.rhm` is the theorem-producing implementation. This module
// preserves the established Symbol/HType/Term API, error behavior, readable
// theorem fields, derivation tracing, and opaque Stamp/Theory/Thm types. The
// generated values carried in private fields are the authority used by every
// primitive inference and theory extension.

import:
  "htype.rhm" open
  "term.rhm" open
  "names.rhm" open
  "printer.rhm" open
  "kernel_generated.rhm" as generated

export:
  hol_version
  Stamp
  Thm
  Theory
  descends
  hyps_of
  concl_of
  stamp_of
  check_type
  check_term
  is_bool
  mk_eq
  dest_eq
  is_eq
  REFL
  TRANS
  MK_COMB
  ABS
  BETA
  ASSUME
  EQ_MP
  DEDUCT_ANTISYM_RULE
  INST
  INST_TYPE
  initial_theory
  new_type
  new_constant
  new_axiom
  new_basic_definition
  new_basic_type_definition
  type_arity
  const_type
  axioms_of
  definition_of
  hyps
  trace
  all_from("htype.rhm")
  all_from("term.rhm")

def hol_version :: String = "0.1"

// -- representation bridge -------------------------------------------------

// Isabelle's finite names use a generated natural as identity. Keep a
// process-local bijection so distinct uninterned Symbols remain distinct even
// when they have the same printed spelling. Built-in names retain their
// dedicated generated constructors.
def name_serial :: Box = Box(0)
def names_to_generated :: Box = Box({})
def names_from_generated :: Box = Box({})
def stamp_serial :: Box = Box(0)
def types_to_generated = WeakMutableMap.by(===)()
def types_from_generated = WeakMutableMap.by(===)()
def terms_to_generated = WeakMutableMap.by(===)()
def terms_from_generated = WeakMutableMap.by(===)()

fun fresh_generated_nat():
  let n = stamp_serial.value :~ Int
  stamp_serial.value := n + 1
  generated.nat_value(n)

fun to_generated_name(n :: Symbol):
  cond
  | n == ty_fun: generated.NFun()
  | n == ty_bool: generated.NBool()
  | n == c_eq: generated.NEq()
  | n == v_alpha: generated.NAlpha()
  | n == v_rep: generated.NRepVar()
  | ~else:
      match (names_to_generated.value :~ Map).get(n, #false)
      | #false:
          let k = name_serial.value :~ Int
          let gn = generated.NUser(generated.nat_value(k), generated.Nil())
          name_serial.value := k + 1
          names_to_generated.value := (names_to_generated.value :~ Map) ++ {n: gn}
          names_from_generated.value := (names_from_generated.value :~ Map) ++ {k: n}
          gn
      | gn: gn

fun from_generated_name(n):
  match n
  | generated.NFun(): ty_fun
  | generated.NBool(): ty_bool
  | generated.NEq(): c_eq
  | generated.NAlpha(): v_alpha
  | generated.NRepVar(): v_rep
  | generated.NUser(k, _):
      let i = generated.integer_value(k)
      match (names_from_generated.value :~ Map).get(i, #false)
      | #false: error(~who: #'kernel, "generated kernel returned an unknown name")
      | name: name

fun to_generated_list(xs :: List, convert):
  match xs
  | []: generated.Nil()
  | List.cons(x, rest): generated.Cons(convert(x), to_generated_list(rest, convert))

fun from_generated_list(xs, convert) :: List:
  match xs
  | generated.Nil(): []
  | generated.Cons(x, rest): List.cons(convert(x), from_generated_list(rest, convert))

fun remember_type(ty :: HType, raw):
  types_to_generated[ty] := raw
  types_from_generated[raw] := ty
  raw

fun to_generated_type(ty :: HType):
  types_to_generated.maybe[ty]
    || block:
         let raw:
           match ty
           | TyVar(n): generated.TyVar(to_generated_name(n))
           | TyApp(n, args):
               generated.TyApp(to_generated_name(n),
                               to_generated_list(args, to_generated_type))
         remember_type(ty, raw)

fun from_generated_type(raw) :: HType:
  types_from_generated.maybe[raw]
    || block:
         let ty:
           match raw
           | generated.TyVar(n): mk_tyvar(from_generated_name(n))
           | generated.TyApp(n, args):
               mk_tyapp(from_generated_name(n),
                        from_generated_list(args, from_generated_type))
         remember_type(ty, raw)
         ty

fun remember_term(tm :: Term, raw):
  terms_to_generated[tm] := raw
  terms_from_generated[raw] := tm
  raw

fun to_generated_term(tm :: Term):
  terms_to_generated.maybe[tm]
    || block:
         let raw:
           match tm
           | FVar(n, ty):
               generated.FVar(to_generated_name(n), to_generated_type(ty))
           | BVar(i, ty):
               generated.BVar(generated.nat_value(i), to_generated_type(ty))
           | Const(n, ty):
               generated.Const(to_generated_name(n), to_generated_type(ty))
           | Comb(f, x):
               generated.Comb(to_generated_term(f), to_generated_term(x))
           | Abs(ty, body):
               generated.Abs(to_generated_type(ty), to_generated_term(body))
         remember_term(tm, raw)

fun from_generated_term(raw) :: Term:
  terms_from_generated.maybe[raw]
    || block:
         let tm:
           match raw
           | generated.FVar(n, ty):
               unsafe.raw_fvar(from_generated_name(n), from_generated_type(ty))
           | generated.BVar(i, ty):
               unsafe.raw_bvar(generated.integer_value(i),
                               from_generated_type(ty))
           | generated.Const(n, ty):
               unsafe.raw_const(from_generated_name(n),
                                from_generated_type(ty))
           | generated.Comb(f, x):
               unsafe.raw_comb(from_generated_term(f),
                               from_generated_term(x))
           | generated.Abs(ty, body):
               unsafe.raw_abs(from_generated_type(ty),
                              from_generated_term(body))
         remember_term(tm, raw)
         tm

// -- opaque public values ---------------------------------------------------

class Stamp(id :: Symbol,
            gen :: Int,
            ancestors :: Set.of(Symbol),
            private raw):
  constructor ~none
  reconstructor ~none
  internal _Stamp

class Thm(hyps :: List.of(Term),
          concl :: Term,
          stamp :: Stamp,
          private raw,
          private raw_theory):
  authentic
  constructor ~none
  reconstructor ~none
  internal _Thm
  private implements Equatable
  private override equals(other :: Thm, recur):
    (recur(concl, other.concl)
       && hyps.length() == other.hyps.length()
       && (for all (h in hyps):
             for any (k in other.hyps): recur(h, k)))
  private override hash_code(recur):
    let hs = for values(acc = 0) (h in hyps): acc + recur(h)
    Equatable.hash_code_combine(recur(concl), hyps.length(), hs)

class Theory(tyops :: Map.of(Symbol, Int),
             consts :: Map.of(Symbol, HType),
             axioms :: List.of(Thm),
             defs :: Map.of(Symbol, Thm),
             stamp :: Stamp,
             private raw):
  constructor ~none
  reconstructor ~none
  internal _Theory

fun raw_stamp(st :: Stamp): _Stamp.raw(st)
fun raw_thm(th :: Thm): _Thm.raw(th)
fun raw_thm_theory(th :: Thm): _Thm.raw_theory(th)
fun raw_theory(thy :: Theory): _Theory.raw(thy)

fun fresh_stamp(raw) :: Stamp:
  let id = Symbol.uninterned_from_string("thy")
  _Stamp(id, 0, {id}, raw)

fun next_stamp(prev :: Stamp, raw) :: Stamp:
  let id = Symbol.uninterned_from_string("thy")
  _Stamp(id, prev.gen + 1, prev.ancestors ++ {id}, raw)

fun descends(a :: Stamp, b :: Stamp) :: Boolean:
  a.id in b.ancestors

fun combine_stamps(who :: Symbol, a :: Stamp, b :: Stamp) :: Stamp:
  cond
  | descends(a, b): b
  | descends(b, a): a
  | ~else:
      error(~who: who,
            "theorems come from different theories",
            error.val(~label: "detail",
                      "neither theory is an extension of the other, so the "
                        ++ "two theorems may disagree about what a shared name means"))

fun later_raw_theory(a :: Thm, b :: Thm):
  (if descends(a.stamp, b.stamp) | raw_thm_theory(b) | raw_thm_theory(a))

fun wrap_raw_thm(raw, stamp :: Stamp, raw_thy) :: Thm:
  _Thm(from_generated_list(generated.hyps(raw), from_generated_term),
       from_generated_term(generated.concl(raw)),
       stamp,
       raw,
       raw_thy)

fun generated_thm(who :: Symbol, result, stamp :: Stamp, raw_thy) :: Thm:
  match result
  | generated.Some(raw): wrap_raw_thm(raw, stamp, raw_thy)
  | generated.None():
      error(~who: who,
            "generated kernel rejected an inference accepted by the compatibility checks")

fun hyps_of(th :: Thm) :: List.of(Term): th.hyps
fun concl_of(th :: Thm) :: Term: th.concl
fun stamp_of(th :: Thm) :: Stamp: th.stamp

// -- hypothesis-set compatibility -----------------------------------------

namespace hyps:
  export:
    hyp_insert
    hyp_union
    hyp_remove
    rehash_hyps

  fun hyp_insert(t :: Term, hs :: List.of(Term)) :: List.of(Term):
    (if hs.contains(t) | hs | hs ++ [t])

  fun hyp_union(a :: List.of(Term), b :: List.of(Term)) :: List.of(Term):
    cond
    | a.length() == 0: b
    | b.length() == 0: a
    | ~else: for values(acc :~ List = a) (t in b): hyp_insert(t, acc)

  fun hyp_remove(t :: Term, hs :: List.of(Term)) :: List.of(Term):
    hs.filter(~skip: fun (h :: Term): h == t)

  fun rehash_hyps(hs :: List.of(Term)) :: List.of(Term):
    for values(acc :~ List = []) (h in hs): hyp_insert(h, acc)

def hyp_insert = hyps.hyp_insert
def hyp_union = hyps.hyp_union
def hyp_remove = hyps.hyp_remove
def rehash_hyps = hyps.rehash_hyps

// -- theories and queries ---------------------------------------------------

fun type_arity(thy :: Theory, n :: Symbol) :: maybe(Int):
  thy.tyops.get(n, #false)

fun const_type(thy :: Theory, n :: Symbol) :: maybe(HType):
  thy.consts.get(n, #false)

fun axioms_of(thy :: Theory) :: List.of(Thm): thy.axioms
fun definition_of(thy :: Theory, n :: Symbol) :: maybe(Thm): thy.defs.get(n, #false)

fun initial_theory() :: Theory:
  let raw = generated.initial_theory(fresh_generated_nat())
  let a = mk_tyvar(v_alpha)
  let st = fresh_stamp(generated.thy_stamp(raw))
  let res = _Theory({ty_bool: 0, ty_fun: 2},
                    {c_eq: mk_fun(a, mk_fun(a, mk_tyapp(ty_bool, [])))},
                    [],
                    {},
                    st,
                    raw)
  when tracing.value
  | note(#'initial_theory, #false, [], [], st.id, [])
  res

fun extended_theory(thy :: Theory,
                    raw,
                    ~tyops: tyops = thy.tyops,
                    ~consts: consts = thy.consts,
                    ~axioms: axioms = thy.axioms,
                    ~defs: defs = thy.defs) :: Theory:
  _Theory(tyops, consts, axioms, defs,
          next_stamp(thy.stamp, generated.thy_stamp(raw)), raw)

fun in_theory(who :: Symbol, thy :: Theory, th :: Thm) :: Void:
  unless descends(th.stamp, thy.stamp)
  | error(~who: who,
          "theorem was not proved in this theory or an ancestor of it")

// -- compatibility validation ---------------------------------------------

fun check_type(thy :: Theory, t :: HType) :: Void:
  match t
  | TyVar(_): #void
  | TyApp(n, args):
      match type_arity(thy, n)
      | #false:
          error(~who: #'check_type, "undeclared type constructor",
                error.val(~label: "name", n))
      | ar when ar != args.length():
          error(~who: #'check_type, "type constructor arity mismatch",
                error.val(~label: "name", n),
                error.val(~label: "expected", ar),
                error.val(~label: "given", args.length()))
      | _: for (a in args): check_type(thy, a)

fun check_term(thy :: Theory, t :: Term) :: Void:
  check_open_term(thy, t, [])

fun check_open_term(thy :: Theory, t :: Term, env :: List.of(HType)) :: Void:
  match t
  | FVar(_, ty): check_type(thy, ty)
  | BVar(i, ty):
      cond
      | i >= env.length():
          error(~who: #'check_term, "term has an unbound de Bruijn index",
                error.val(~label: "index", i),
                error.val(~label: "binders in scope", env.length()))
      | env[i] != ty:
          error(~who: #'check_term,
                "bound variable's type does not match its binder",
                error.val(~label: "index", i),
                error.val(~label: "binder type", type_to_string(env[i])),
                error.val(~label: "claimed", type_to_string(ty)))
      | ~else: check_type(thy, ty)
  | Const(n, ty):
      check_type(thy, ty)
      match const_type(thy, n)
      | #false:
          error(~who: #'check_term, "undeclared constant",
                error.val(~label: "name", n))
      | gty:
          when type_match(gty, ty, {}) == #false
          | error(~who: #'check_term, "constant used at a non-instance type",
                  error.val(~label: "name", n),
                  error.val(~label: "generic", type_to_string(gty)),
                  error.val(~label: "used at", type_to_string(ty)))
  | Abs(aty, b):
      check_type(thy, aty)
      check_open_term(thy, b, List.cons(aty, env))
  | Comb(f, x):
      check_open_term(thy, f, env)
      check_open_term(thy, x, env)
      let fty = type_of(f)
      cond
      | !is_fun(fty):
          error(~who: #'check_term, "operator is not a function",
                error.val(~label: "term", show(t)))
      | ~else:
          let (dom, _) = dest_fun(fty)
          unless dom == type_of(x)
          | error(~who: #'check_term, "ill-typed application",
                  error.val(~label: "term", show(t)))

fun is_bool(t :: Term) :: Boolean:
  type_of(t) == mk_tyapp(ty_bool, [])

fun check_prop(who :: Symbol, thy :: Theory, t :: Term) :: Void:
  check_term(thy, t)
  unless is_bool(t)
  | error(~who: who, "term is not a proposition",
          error.val(~label: "term", show_typed(t)))

fun mk_eq(l :: Term, r :: Term) :: Term:
  let ty = type_of(l)
  unless ty == type_of(r)
  | error(~who: #'mk_eq, "sides of an equation have different types",
          error.val(~label: "left", show_typed(l)),
          error.val(~label: "right", show_typed(r)))
  mk_comb(mk_comb(mk_const(c_eq, mk_fun(ty, mk_fun(ty, mk_tyapp(ty_bool, [])))), l), r)

fun dest_eq(t :: Term) :: maybe(List.of(Term)):
  match t
  | Comb(Comb(Const(n, _), l), r) when n == c_eq: [l, r]
  | ~else: #false

fun is_eq(t :: Term) :: Boolean: dest_eq(t) != #false

fun need_eq(who :: Symbol, th :: Thm) :: List.of(Term):
  match dest_eq(th.concl)
  | #false: error(~who: who, "theorem is not an equation",
                  error.val(~label: "theorem", show(th.concl)))
  | pair: pair

// -- derivation tracing -----------------------------------------------------

namespace trace:
  export:
    TraceStep
    start
    stop

  class TraceStep(rule :: Symbol,
                  thy :: maybe(Symbol),
                  thms :: List,
                  data :: List,
                  out_thy :: maybe(Symbol),
                  out_thms :: List)

  fun start() :: Void:
    trace_log.value := []
    tracing.value := #true

  fun stop() :: List:
    tracing.value := #false
    let steps = (trace_log.value :~ List).reverse()
    trace_log.value := []
    steps

fun thm_key(th :: Thm) :: List: [th.stamp.id, th.hyps, th.concl]
def tracing :: Box = Box(#false)
def trace_log :: Box = Box([])

fun note(rule :: Symbol, thy, thms :: List, data :: List,
         out_thy, out_thms :: List) :: Void:
  trace_log.value := List.cons(trace.TraceStep(rule, thy, thms, data,
                                               out_thy, out_thms),
                               trace_log.value :~ List)

// -- ten generated primitive rules -----------------------------------------

fun REFL(thy :: Theory, t :: Term) :: Thm:
  check_term(thy, t)
  let request = generated.CodeRefl(raw_theory(thy), to_generated_term(t))
  let res = generated_thm(#'REFL, generated.run_code_rule(request),
                          thy.stamp, raw_theory(thy))
  when tracing.value | note(#'REFL, thy.stamp.id, [], [t], #false, [thm_key(res)])
  res

fun TRANS(a :: Thm, b :: Thm) :: Thm:
  let st = combine_stamps(#'TRANS, a.stamp, b.stamp)
  let [l, m1] = need_eq(#'TRANS, a)
  let [m2, r] = need_eq(#'TRANS, b)
  unless m1 == m2
  | error(~who: #'TRANS, "middle terms do not match",
          error.val(~label: "left", show(m1)),
          error.val(~label: "right", show(m2)))
  let rthy = later_raw_theory(a, b)
  let request = generated.CodeTrans(rthy, raw_thm(a), raw_thm(b))
  let res = generated_thm(#'TRANS, generated.run_code_rule(request), st, rthy)
  when tracing.value | note(#'TRANS, #false, [thm_key(a), thm_key(b)], [], #false, [thm_key(res)])
  res

fun MK_COMB(fth :: Thm, xth :: Thm) :: Thm:
  let st = combine_stamps(#'MK_COMB, fth.stamp, xth.stamp)
  let [f, _] = need_eq(#'MK_COMB, fth)
  let [x, _] = need_eq(#'MK_COMB, xth)
  let fty = type_of(f)
  unless is_fun(fty) | error(~who: #'MK_COMB, "operator is not a function")
  let (dom, _) = dest_fun(fty)
  unless dom == type_of(x) | error(~who: #'MK_COMB, "types do not agree")
  let rthy = later_raw_theory(fth, xth)
  let request = generated.CodeMkComb(rthy, raw_thm(fth), raw_thm(xth))
  let res = generated_thm(#'MK_COMB, generated.run_code_rule(request), st, rthy)
  when tracing.value | note(#'MK_COMB, #false, [thm_key(fth), thm_key(xth)], [], #false, [thm_key(res)])
  res

fun ABS(thy :: Theory, v :: FVar, th :: Thm) :: Thm:
  in_theory(#'ABS, thy, th)
  check_term(thy, v)
  when (for any (h in th.hyps): vfree_in(v, h))
  | error(~who: #'ABS, "abstracted variable is free in the hypotheses",
          error.val(~label: "variable", v.name))
  need_eq(#'ABS, th)
  let request = generated.CodeAbs(raw_theory(thy), to_generated_name(v.name),
                                  to_generated_type(v.ty), raw_thm(th))
  let res = generated_thm(#'ABS, generated.run_code_rule(request),
                          thy.stamp, raw_theory(thy))
  when tracing.value | note(#'ABS, thy.stamp.id, [thm_key(th)], [v], #false, [thm_key(res)])
  res

fun BETA(thy :: Theory, t :: Term) :: Thm:
  check_term(thy, t)
  match t
  | Comb(Abs(_, _), _):
      let request = generated.CodeBeta(raw_theory(thy), to_generated_term(t))
      let res = generated_thm(#'BETA, generated.run_code_rule(request),
                              thy.stamp, raw_theory(thy))
      when tracing.value | note(#'BETA, thy.stamp.id, [], [t], #false, [thm_key(res)])
      res
  | ~else:
      error(~who: #'BETA, "not a beta redex",
            error.val(~label: "term", show(t)))

fun ASSUME(thy :: Theory, p :: Term) :: Thm:
  check_prop(#'ASSUME, thy, p)
  let request = generated.CodeAssume(raw_theory(thy), to_generated_term(p))
  let res = generated_thm(#'ASSUME, generated.run_code_rule(request),
                          thy.stamp, raw_theory(thy))
  when tracing.value | note(#'ASSUME, thy.stamp.id, [], [p], #false, [thm_key(res)])
  res

fun EQ_MP(eqth :: Thm, th :: Thm) :: Thm:
  let st = combine_stamps(#'EQ_MP, eqth.stamp, th.stamp)
  let [p, _] = need_eq(#'EQ_MP, eqth)
  unless p == th.concl
  | error(~who: #'EQ_MP, "antecedent does not match",
          error.val(~label: "expected", show(p)),
          error.val(~label: "given", show(th.concl)))
  let rthy = later_raw_theory(eqth, th)
  let request = generated.CodeEqMp(rthy, raw_thm(eqth), raw_thm(th))
  let res = generated_thm(#'EQ_MP, generated.run_code_rule(request), st, rthy)
  when tracing.value | note(#'EQ_MP, #false, [thm_key(eqth), thm_key(th)], [], #false, [thm_key(res)])
  res

fun DEDUCT_ANTISYM_RULE(a :: Thm, b :: Thm) :: Thm:
  let st = combine_stamps(#'DEDUCT_ANTISYM_RULE, a.stamp, b.stamp)
  let rthy = later_raw_theory(a, b)
  let request = generated.CodeDeductAntisym(rthy, raw_thm(a), raw_thm(b))
  let res = generated_thm(#'DEDUCT_ANTISYM_RULE,
                          generated.run_code_rule(request), st, rthy)
  when tracing.value
  | note(#'DEDUCT_ANTISYM_RULE, #false, [thm_key(a), thm_key(b)], [], #false, [thm_key(res)])
  res

fun INST(thy :: Theory, theta :: List, th :: Thm) :: Thm:
  in_theory(#'INST, thy, th)
  for ([rep, v] in theta):
    unless v is_a FVar
    | error(~who: #'INST, "substitution target is not a free variable",
            error.val(~label: "target", show(v)))
    check_term(thy, rep)
    unless type_of(rep) == type_of(v)
    | error(~who: #'INST, "instantiation changes a variable's type",
            error.val(~label: "variable", show_typed(v)),
            error.val(~label: "replacement", show_typed(rep)))
  let entries = to_generated_list(
    theta,
    fun ([rep, v]): generated.PairValue(to_generated_term(rep), to_generated_term(v)))
  let request = generated.CodeInst(raw_theory(thy), entries, raw_thm(th))
  let res = generated_thm(#'INST, generated.run_code_rule(request),
                          thy.stamp, raw_theory(thy))
  when tracing.value | note(#'INST, thy.stamp.id, [thm_key(th)], [theta], #false, [thm_key(res)])
  res

fun INST_TYPE(thy :: Theory, tyin :: Map.of(Symbol, HType), th :: Thm) :: Thm:
  in_theory(#'INST_TYPE, thy, th)
  for ((_, ty) in tyin): check_type(thy, ty)
  let raw_entries = for List ((n, ty) in tyin):
                      generated.PairValue(to_generated_name(n),
                                          to_generated_type(ty))
  let entries = to_generated_list(raw_entries, fun (entry): entry)
  let request = generated.CodeInstType(raw_theory(thy), entries, raw_thm(th))
  let res = generated_thm(#'INST_TYPE, generated.run_code_rule(request),
                          thy.stamp, raw_theory(thy))
  when tracing.value | note(#'INST_TYPE, thy.stamp.id, [thm_key(th)], [tyin], #false, [thm_key(res)])
  res

// -- generated theory extensions ------------------------------------------

fun generated_extension(who :: Symbol, result):
  match result
  | generated.Some(raw): raw
  | generated.None():
      error(~who: who,
            "generated kernel rejected an extension accepted by the compatibility checks")

fun new_type(thy :: Theory, n :: Symbol, arity :: NonnegInt) :: Theory:
  when type_arity(thy, n) != #false
  | error(~who: #'new_type, "type constructor is already declared",
          error.val(~label: "name", n))
  let result = generated.new_type(fresh_generated_nat())(raw_theory(thy))(to_generated_name(n))(generated.nat_value(arity))
  let raw = generated_extension(#'new_type, result)
  let res = extended_theory(thy, raw, ~tyops: thy.tyops ++ {n: arity})
  when tracing.value | note(#'new_type, thy.stamp.id, [], [n, arity], res.stamp.id, [])
  res

fun new_constant(thy :: Theory, n :: Symbol, ty :: HType) :: Theory:
  when const_type(thy, n) != #false
  | error(~who: #'new_constant, "constant is already declared",
          error.val(~label: "name", n))
  check_type(thy, ty)
  let result = generated.new_constant(fresh_generated_nat())(raw_theory(thy))(to_generated_name(n))(to_generated_type(ty))
  let raw = generated_extension(#'new_constant, result)
  let res = extended_theory(thy, raw, ~consts: thy.consts ++ {n: ty})
  when tracing.value | note(#'new_constant, thy.stamp.id, [], [n, ty], res.stamp.id, [])
  res

fun new_axiom(thy :: Theory, p :: Term) :: values(Theory, Thm):
  check_prop(#'new_axiom, thy, p)
  let result = generated.new_axiom(fresh_generated_nat())(raw_theory(thy))(to_generated_term(p))
  match result
  | generated.Some(generated.PairValue(raw, raw_th)):
      let st = next_stamp(thy.stamp, generated.thy_stamp(raw))
      let th = wrap_raw_thm(raw_th, st, raw)
      let thy2 = _Theory(thy.tyops, thy.consts, List.cons(th, thy.axioms),
                         thy.defs, st, raw)
      when tracing.value
      | note(#'new_axiom, thy.stamp.id, [], [p], thy2.stamp.id, [thm_key(th)])
      values(thy2, th)
  | generated.None():
      error(~who: #'new_axiom,
            "generated kernel rejected an axiom accepted by the compatibility checks")

fun term_type_vars(t :: Term) :: List.of(Symbol):
  fun add(ty :: HType, acc :~ List) :~ List:
    for values(a :~ List = acc) (v in type_vars(ty)):
      (if a.contains(v) | a | a ++ [v])
  fun walk(t :: Term, acc :~ List) :~ List:
    match t
    | FVar(_, ty): add(ty, acc)
    | BVar(_, ty): add(ty, acc)
    | Const(_, ty): add(ty, acc)
    | Comb(f, x): walk(x, walk(f, acc))
    | Abs(aty, b): walk(b, add(aty, acc))
  walk(t, [])

fun new_basic_definition(thy :: Theory, tm :: Term) :: values(Theory, Thm):
  match dest_eq(tm)
  | #false: error(~who: #'new_basic_definition, "definition is not an equation")
  | [lhs, rhs]:
      match lhs
      | FVar(n, ty):
          when const_type(thy, n) != #false
          | error(~who: #'new_basic_definition, "constant is already declared",
                  error.val(~label: "name", n))
          check_term(thy, rhs)
          unless free_vars(rhs).length() == 0
          | error(~who: #'new_basic_definition, "right-hand side is not closed",
                  error.val(~label: "free", show(free_vars(rhs)[0])))
          unless ty == type_of(rhs)
          | error(~who: #'new_basic_definition, "type mismatch in definition")
          let rhs_tvs = term_type_vars(rhs)
          let ty_tvs = type_vars(ty)
          unless (for all (v in rhs_tvs): ty_tvs.contains(v))
          | error(~who: #'new_basic_definition,
                  "right-hand side has type variables not in the type")
          let result = generated.new_basic_definition(fresh_generated_nat())(raw_theory(thy))(to_generated_term(tm))
          match result
          | generated.Some(generated.PairValue(raw, raw_th)):
              let st = next_stamp(thy.stamp, generated.thy_stamp(raw))
              let th = wrap_raw_thm(raw_th, st, raw)
              let thy2 = _Theory(thy.tyops, thy.consts ++ {n: ty}, thy.axioms,
                                 thy.defs ++ {n: th}, st, raw)
              when tracing.value
              | note(#'new_basic_definition, thy.stamp.id, [], [tm],
                     thy2.stamp.id, [thm_key(th)])
              values(thy2, th)
          | generated.None():
              error(~who: #'new_basic_definition,
                    "generated kernel rejected a definition accepted by the compatibility checks")
      | ~else:
          error(~who: #'new_basic_definition,
                "left-hand side is not a fresh name")

fun new_basic_type_definition(thy :: Theory,
                              tyname :: Symbol,
                              absname :: Symbol,
                              repname :: Symbol,
                              th :: Thm) :: values(Theory, Thm, Thm):
  in_theory(#'new_basic_type_definition, thy, th)
  when const_type(thy, absname) != #false || const_type(thy, repname) != #false
  | error(~who: #'new_basic_type_definition, "constant is already declared")
  when type_arity(thy, tyname) != #false
  | error(~who: #'new_basic_type_definition,
          "type constructor is already declared",
          error.val(~label: "name", tyname))
  when absname == repname
  | error(~who: #'new_basic_type_definition,
          "abstraction and representation functions have the same name")
  unless th.hyps.length() == 0
  | error(~who: #'new_basic_type_definition, "witness theorem has hypotheses")
  match th.concl
  | Comb(pred, witness):
      unless free_vars(pred).length() == 0
      | error(~who: #'new_basic_type_definition, "predicate is not closed")
      let tvs = term_type_vars(pred)
      let rty = type_of(witness)
      unless (for all (v in type_vars(rty)): tvs.contains(v))
      | error(~who: #'new_basic_type_definition,
              "witness has type variables not present in the predicate",
              error.val(~label: "representing type", type_to_string(rty)))
      let make1 = generated.new_basic_type_definition(fresh_generated_nat())
      let make2 = make1(raw_theory(thy))
      let make3 = make2(to_generated_name(tyname))
      let make4 = make3(to_generated_name(absname))
      let make5 = make4(to_generated_name(repname))
      match make5(raw_thm(th))
      | generated.Some(generated.PairValue(raw, generated.PairValue(raw_abs_rep, raw_pred))):
          let st = next_stamp(thy.stamp, generated.thy_stamp(raw))
          let aty = mk_tyapp(tyname, tvs.map(fun (v :: Symbol): mk_tyvar(v)))
          let abs_ty = mk_fun(rty, aty)
          let rep_ty = mk_fun(aty, rty)
          let abs_rep = wrap_raw_thm(raw_abs_rep, st, raw)
          let pred_th = wrap_raw_thm(raw_pred, st, raw)
          let thy2 = _Theory(thy.tyops ++ {tyname: tvs.length()},
                             thy.consts ++ {absname: abs_ty, repname: rep_ty},
                             thy.axioms,
                             thy.defs,
                             st,
                             raw)
          when tracing.value
          | note(#'new_basic_type_definition, thy.stamp.id, [thm_key(th)],
                 [tyname, absname, repname], thy2.stamp.id,
                 [thm_key(abs_rep), thm_key(pred_th)])
          values(thy2, abs_rep, pred_th)
      | generated.None():
          error(~who: #'new_basic_type_definition,
                "generated kernel rejected a type definition accepted by the compatibility checks")
  | ~else:
      error(~who: #'new_basic_type_definition,
            "witness theorem is not an application")
