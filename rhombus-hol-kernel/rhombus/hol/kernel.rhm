def hol_version :: String = "0.1"

// --- Errors: translate generated-kernel failures into Rhombus errors ---

fun raise_generated_failure(who :: Symbol, failure) :: Void:
  match failure
  | generated.UndeclaredType(n):
      error(~who: who, "undeclared type constructor",
            error.val(~label: "name", n))
  | generated.TypeArity(n, expected, given):
      error(~who: who, "type constructor arity mismatch",
            error.val(~label: "name", n),
            error.val(~label: "expected", expected),
            error.val(~label: "given", given))
  | generated.InvalidType(ty):
      error(~who: who, "generated kernel rejected the type",
            error.val(~label: "type", type_to_string(ty)))
  | generated.UnboundIndex(index, binders):
      error(~who: who, "term has an unbound de Bruijn index",
            error.val(~label: "index", index),
            error.val(~label: "binders in scope", binders))
  | generated.BinderTypeMismatch(index, binder_ty, claimed_ty):
      error(~who: who, "bound variable's type does not match its binder",
            error.val(~label: "index", index),
            error.val(~label: "binder type", type_to_string(binder_ty)),
            error.val(~label: "claimed", type_to_string(claimed_ty)))
  | generated.UndeclaredConstant(n):
      error(~who: who, "undeclared constant",
            error.val(~label: "name", n))
  | generated.ConstantTypeMismatch(n, generic_ty, used_ty):
      error(~who: who, "constant used at a non-instance type",
            error.val(~label: "name", n),
            error.val(~label: "generic", type_to_string(generic_ty)),
            error.val(~label: "used at", type_to_string(used_ty)))
  | generated.OperatorNotFunction(t):
      error(~who: who, "operator is not a function",
            error.val(~label: "term", term_to_string(t)))
  | generated.IllTypedApplication(t):
      error(~who: who, "ill-typed application",
            error.val(~label: "term", term_to_string(t)))
  | generated.NotProposition(t):
      error(~who: who, "term is not a proposition",
            error.val(~label: "term", typed_to_string(t)))
  | generated.NotEquation(t):
      error(~who: who, "theorem is not an equation",
            error.val(~label: "theorem", term_to_string(t)))
  | generated.MiddleTermsDiffer(left, right):
      error(~who: who, "middle terms do not match",
            error.val(~label: "left", term_to_string(left)),
            error.val(~label: "right", term_to_string(right)))
  | generated.CombinationTypeMismatch():
      error(~who: who, "types do not agree")
  | generated.VariableFreeInHypotheses(n):
      error(~who: who, "abstracted variable is free in the hypotheses",
            error.val(~label: "variable", n))
  | generated.NotBetaRedex(t):
      error(~who: who, "not a beta redex",
            error.val(~label: "term", term_to_string(t)))
  | generated.AntecedentMismatch(expected, given):
      error(~who: who, "antecedent does not match",
            error.val(~label: "expected", term_to_string(expected)),
            error.val(~label: "given", term_to_string(given)))
  | generated.InvalidInstantiationTarget(t):
      error(~who: who, "substitution target is not a free variable",
            error.val(~label: "target", term_to_string(t)))
  | generated.InstantiationTypeMismatch(variable, replacement):
      error(~who: who, "instantiation changes a variable's type",
            error.val(~label: "variable", typed_to_string(variable)),
            error.val(~label: "replacement", typed_to_string(replacement)))
  | generated.InvalidTypeSubstitution():
      error(~who: who, "invalid type substitution")
  | generated.DuplicateType(n):
      error(~who: who, "type constructor is already declared",
            error.val(~label: "name", n))
  | generated.DuplicateConstant(n):
      error(~who: who, "constant is already declared",
            error.val(~label: "name", n))
  | generated.DefinitionNotEquation():
      error(~who: who, "definition is not an equation")
  | generated.DefinitionLeftNotVariable():
      error(~who: who, "left-hand side is not a fresh name")
  | generated.DefinitionOpen(t):
      error(~who: who, "right-hand side is not closed",
            error.val(~label: "free", term_to_string(t)))
  | generated.DefinitionTypeMismatch():
      error(~who: who, "type mismatch in definition")
  | generated.DefinitionExtraTypeVariables():
      error(~who: who, "right-hand side has type variables not in the type")
  | generated.TypeDefinitionSameConstants():
      error(~who: who,
            "abstraction and representation functions have the same name")
  | generated.TypeDefinitionHasHypotheses():
      error(~who: who, "witness theorem has hypotheses")
  | generated.TypeDefinitionOpenPredicate():
      error(~who: who, "predicate is not closed")
  | generated.TypeDefinitionExtraTypeVariables(rty):
      error(~who: who,
            "witness has type variables not present in the predicate",
            error.val(~label: "representing type", type_to_string(rty)))
  | generated.TypeDefinitionBadWitness():
      error(~who: who, "witness theorem is not an application")
  | generated.RuleRejected():
      error(~who: who, "generated kernel rejected the inference")
  | generated.ExtensionRejected():
      error(~who: who, "generated kernel rejected the extension")

// --- Trace: optional recording of primitive-rule and theory-extension calls ---

namespace trace:
  export:
    TraceStep
    with_recording

  class TraceStep(rule :: Symbol,
                  thy :: maybe(Symbol),
                  thms :: List,
                  data :: List,
                  out_thy :: maybe(Symbol),
                  out_thms :: List)

  fun with_recording(thunk):
    let session = TraceSession(Box([]))
    parameterize { current_trace: session }:
      let result = thunk()
      values(result, (session.log.value :~ List).reverse())

class TraceSession(log :: Box)

Parameter.def current_trace :: maybe(TraceSession) = #false

fun note(rule :: Symbol, thy, thms :: List, data :: List,
         out_thy, out_thms :: List) :: Void:
  match current_trace()
  | #false: #void
  | session :: TraceSession:
      let step = trace.TraceStep(rule, thy, thms, data, out_thy, out_thms)
      session.log.value := List.cons(step, session.log.value :~ List)

fun generated_thm(who :: Symbol, result, stamp :: Stamp, raw_thy) :: Thm:
  match result
  | generated.Success(raw):
      let theorem = wrap_raw_thm(raw, stamp, raw_thy)
      theorem
  | generated.Failure(failure): raise_generated_failure(who, failure)

fun check_type(thy :: Theory, ty :: HType) :: Void:
  match generated.check_type_result(raw_theory(thy))(ty)
  | generated.Success(_): #void
  | generated.Failure(failure): raise_generated_failure(#'check_type, failure)

fun check_term(thy :: Theory, t :: Term) :: Void:
  match generated.check_term_result(raw_theory(thy))(t)
  | generated.Success(_): #void
  | generated.Failure(failure): raise_generated_failure(#'check_term, failure)

fun mk_nat_lit(thy :: Theory, value :: NonnegInt) :: NatLit:
  let literal = unsafe.raw_nat_lit(value)
  check_term(thy, literal)
  literal
// Every `NAT_LIT_*_CONV` is the same ceremony: the caller checks its
// evidence theorems against `thy`, then the primitive is applied and the
// result recorded.  `nat_lit_rule` is that ceremony; each CONV below is
// just its data (name, evidence, displayed arguments, generated call).
fun nat_lit_rule(name :: Symbol,
                 evidence :: List.of(Thm),
                 thy :: Theory,
                 args :: List,
                 raw_result) :: Thm:
  for (th in evidence):
    in_theory(name, thy, th)
  let res = generated_thm(name, raw_result, thy.stamp, raw_theory(thy))
  note(name, thy.stamp.id, evidence, args, #false, [res])
  res

fun NAT_LIT_CONV(thy :: Theory, value :: NonnegInt) :: Thm:
  nat_lit_rule(#'NAT_LIT_CONV, [], thy,
               [mk_nat_lit(thy, value)],
               generated.nat_lit_conv(raw_theory(thy))(value))

fun NAT_LIT_EQ_CONV(thy :: Theory,
                    zero_not_succ :: Thm,
                    succ_injective :: Thm,
                    m :: NonnegInt,
                    n :: NonnegInt) :: Thm:
  let evidence = [zero_not_succ, succ_injective]
  nat_lit_rule(#'NAT_LIT_EQ_CONV, evidence, thy,
               [mk_nat_lit(thy, m), mk_nat_lit(thy, n)],
               generated.nat_lit_eq_conv(raw_theory(thy))(
                 raw_thm(zero_not_succ))(raw_thm(succ_injective))(m)(n))

fun NAT_LIT_ADD_CONV(thy :: Theory,
                     add_zero :: Thm,
                     add_succ :: Thm,
                     m :: NonnegInt,
                     n :: NonnegInt) :: Thm:
  let evidence = [add_zero, add_succ]
  nat_lit_rule(#'NAT_LIT_ADD_CONV, evidence, thy,
               [mk_nat_lit(thy, m), mk_nat_lit(thy, n)],
               generated.nat_lit_add_conv(raw_theory(thy))(
                 raw_thm(add_zero))(raw_thm(add_succ))(m)(n))

fun NAT_LIT_MUL_CONV(thy :: Theory,
                     add_zero :: Thm,
                     add_succ :: Thm,
                     mul_zero :: Thm,
                     mul_succ :: Thm,
                     m :: NonnegInt,
                     n :: NonnegInt) :: Thm:
  let evidence = [add_zero, add_succ, mul_zero, mul_succ]
  nat_lit_rule(#'NAT_LIT_MUL_CONV, evidence, thy,
               [mk_nat_lit(thy, m), mk_nat_lit(thy, n)],
               generated.nat_lit_mul_conv(raw_theory(thy))(
                 raw_thm(add_zero))(raw_thm(add_succ))(
                 raw_thm(mul_zero))(raw_thm(mul_succ))(m)(n))

fun NAT_LIT_LE_CONV(thy :: Theory,
                    le_zero :: Thm,
                    le_succ_zero :: Thm,
                    le_succ_succ :: Thm,
                    m :: NonnegInt,
                    n :: NonnegInt) :: Thm:
  let evidence = [le_zero, le_succ_zero, le_succ_succ]
  nat_lit_rule(#'NAT_LIT_LE_CONV, evidence, thy,
               [mk_nat_lit(thy, m), mk_nat_lit(thy, n)],
               generated.nat_lit_le_conv(raw_theory(thy))(
                 raw_thm(le_zero))(raw_thm(le_succ_zero))(
                 raw_thm(le_succ_succ))(m)(n))

fun NAT_LIT_SUB_CONV(thy :: Theory,
                     sub_zero :: Thm,
                     sub_succ_zero :: Thm,
                     sub_succ_succ :: Thm,
                     m :: NonnegInt,
                     n :: NonnegInt) :: Thm:
  let evidence = [sub_zero, sub_succ_zero, sub_succ_succ]
  nat_lit_rule(#'NAT_LIT_SUB_CONV, evidence, thy,
               [mk_nat_lit(thy, m), mk_nat_lit(thy, n)],
               generated.nat_lit_sub_conv(raw_theory(thy))(
                 raw_thm(sub_zero))(raw_thm(sub_succ_zero))(
                 raw_thm(sub_succ_succ))(m)(n))

fun NAT_LIT_POW_CONV(thy :: Theory,
                     add_zero :: Thm,
                     add_succ :: Thm,
                     mul_zero :: Thm,
                     mul_succ :: Thm,
                     pow_zero :: Thm,
                     pow_succ :: Thm,
                     base :: NonnegInt,
                     exponent :: NonnegInt) :: Thm:
  let evidence = [add_zero, add_succ, mul_zero, mul_succ, pow_zero, pow_succ]
  nat_lit_rule(#'NAT_LIT_POW_CONV, evidence, thy,
               [mk_nat_lit(thy, base), mk_nat_lit(thy, exponent)],
               generated.nat_lit_pow_conv(raw_theory(thy))(
                 raw_thm(add_zero))(raw_thm(add_succ))(
                 raw_thm(mul_zero))(raw_thm(mul_succ))(
                 raw_thm(pow_zero))(raw_thm(pow_succ))(base)(exponent))

fun is_bool(t :: Term) :: Boolean:
  generated.is_bool(t)

fun mk_eq(l :: Term, r :: Term) :: Term:
  let ty = type_of(l)
  unless ty == type_of(r)
  | error(~who: #'mk_eq, "sides of an equation have different types",
          error.val(~label: "left", typed_to_string(l)),
          error.val(~label: "right", typed_to_string(r)))
  mk_comb(mk_comb(mk_const(c_eq, mk_fun(ty, mk_fun(ty, mk_tyapp(ty_bool, [])))), l), r)

fun dest_eq(t :: Term) :: maybe(List.of(Term)):
  match t
  | Comb(Comb(Const(n, _), l), r) when n == c_eq: [l, r]
  | ~else: #false

fun is_eq(t :: Term) :: Boolean: dest_eq(t) != #false

namespace hyps:
  export:
    hyp_insert
    hyp_union
    hyp_remove
    rehash_hyps

  fun hyp_insert(t :: Term, hs :: List.of(Term)) :: List.of(Term):
    (if hs.contains(t) | hs | hs ++ [t])

  fun hyp_union(a :: List.of(Term), b :: List.of(Term)) :: List.of(Term):
    cond
    | a.length() == 0: b
    | b.length() == 0: a
    | ~else: for values(acc :~ List = a) (t in b): hyp_insert(t, acc)

  fun hyp_remove(t :: Term, hs :: List.of(Term)) :: List.of(Term):
    hs.filter(~skip: fun (h :: Term): h == t)

  fun rehash_hyps(hs :: List.of(Term)) :: List.of(Term):
    for values(acc :~ List = []) (h in hs): hyp_insert(h, acc)

fun initial_theory() :: Theory:
  let thy = make_initial_theory()
  note(#'initial_theory, #false, [], [], thy.stamp.id, [])
  thy

fun REFL(thy :: Theory, t :: Term) :: Thm:
  let res = generated_thm(#'REFL,
                          generated.refl(raw_theory(thy))(t),
                          thy.stamp,
                          raw_theory(thy))
  note(#'REFL, thy.stamp.id, [], [t], #false, [res])
  res

fun TRANS(a :: Thm, b :: Thm) :: Thm:
  let st = combine_stamps(#'TRANS, a.stamp, b.stamp)
  let rthy = later_raw_theory(a, b)
  let res = generated_thm(#'TRANS,
                          generated.trans(rthy)(raw_thm(a))(raw_thm(b)),
                          st,
                          rthy)
  note(#'TRANS, #false, [a, b], [], #false, [res])
  res

fun MK_COMB(fth :: Thm, xth :: Thm) :: Thm:
  let st = combine_stamps(#'MK_COMB, fth.stamp, xth.stamp)
  let rthy = later_raw_theory(fth, xth)
  let res = generated_thm(#'MK_COMB,
                          generated.mk_comb(rthy)(raw_thm(fth))(raw_thm(xth)),
                          st,
                          rthy)
  note(#'MK_COMB, #false, [fth, xth], [], #false, [res])
  res

fun ABS(thy :: Theory, v :: FVar, th :: Thm) :: Thm:
  in_theory(#'ABS, thy, th)
  let res = generated_thm(#'ABS,
                          generated.abs(raw_theory(thy))(v.name)(v.ty)(raw_thm(th)),
                          thy.stamp,
                          raw_theory(thy))
  note(#'ABS, thy.stamp.id, [th], [v], #false, [res])
  res

fun BETA(thy :: Theory, t :: Term) :: Thm:
  let res = generated_thm(#'BETA,
                          generated.beta(raw_theory(thy))(t),
                          thy.stamp,
                          raw_theory(thy))
  note(#'BETA, thy.stamp.id, [], [t], #false, [res])
  res

fun ASSUME(thy :: Theory, p :: Term) :: Thm:
  let res = generated_thm(#'ASSUME,
                          generated.assume(raw_theory(thy))(p),
                          thy.stamp,
                          raw_theory(thy))
  note(#'ASSUME, thy.stamp.id, [], [p], #false, [res])
  res

fun EQ_MP(eqth :: Thm, th :: Thm) :: Thm:
  let st = combine_stamps(#'EQ_MP, eqth.stamp, th.stamp)
  let rthy = later_raw_theory(eqth, th)
  let res = generated_thm(#'EQ_MP,
                          generated.eq_mp(rthy)(raw_thm(eqth))(raw_thm(th)),
                          st,
                          rthy)
  note(#'EQ_MP, #false, [eqth, th], [], #false, [res])
  res

fun DEDUCT_ANTISYM_RULE(a :: Thm, b :: Thm) :: Thm:
  let st = combine_stamps(#'DEDUCT_ANTISYM_RULE, a.stamp, b.stamp)
  let rthy = later_raw_theory(a, b)
  let res = generated_thm(
    #'DEDUCT_ANTISYM_RULE,
    generated.deduct_antisym(rthy)(raw_thm(a))(raw_thm(b)),
    st,
    rthy)
  note(#'DEDUCT_ANTISYM_RULE, #false, [a, b], [], #false, [res])
  res

fun INST(thy :: Theory, theta :: List, th :: Thm) :: Thm:
  in_theory(#'INST, thy, th)
  let entries = theta.map(fun ([replacement, target]):
                            generated.PairValue(replacement, target))
  let res = generated_thm(#'INST,
                          generated.inst(raw_theory(thy))(entries)(raw_thm(th)),
                          thy.stamp,
                          raw_theory(thy))
  note(#'INST, thy.stamp.id, [th], [theta], #false, [res])
  res

fun INST_TYPE(thy :: Theory, tyin :: Map.of(Symbol, HType), th :: Thm) :: Thm:
  in_theory(#'INST_TYPE, thy, th)
  let entries = for List ((n, ty) in tyin): generated.PairValue(n, ty)
  let res = generated_thm(
    #'INST_TYPE,
    generated.inst_type(raw_theory(thy))(entries)(raw_thm(th)),
    thy.stamp,
    raw_theory(thy))
  note(#'INST_TYPE, thy.stamp.id, [th], [tyin], #false, [res])
  res

fun raise_or_theory(who :: Symbol, thy :: Theory, result) :: Theory:
  match result
  | generated.Success(raw): wrap_new_theory(thy, raw)
  | generated.Failure(failure): raise_generated_failure(who, failure)

fun new_type(thy :: Theory, n :: Symbol, arity :: NonnegInt) :: Theory:
  let res = raise_or_theory(
    #'new_type,
    thy,
    generated.new_type(fresh_generation())(raw_theory(thy))(n)(arity))
  note(#'new_type, thy.stamp.id, [], [n, arity], res.stamp.id, [])
  res

fun new_nat_type(thy :: Theory) :: values(Theory, Thm, Thm, Thm):
  match generated.new_nat_type(fresh_generation())(raw_theory(thy))
  | generated.Success(result):
      match result
      | generated.PairValue(raw, rest):
          match rest
          | generated.PairValue(raw_zns, tail):
              match tail
              | generated.PairValue(raw_si, raw_ind):
                  let res = wrap_new_theory(thy, raw)
                  let zns = wrap_raw_thm(raw_zns, res.stamp, raw)
                  let si = wrap_raw_thm(raw_si, res.stamp, raw)
                  let ind = wrap_raw_thm(raw_ind, res.stamp, raw)
                  note(#'new_nat_type, thy.stamp.id, [], [], res.stamp.id,
                       [zns, si, ind])
                  values(res, zns, si, ind)
  | generated.Failure(failure): raise_generated_failure(#'new_nat_type, failure)

fun new_constant(thy :: Theory, n :: Symbol, ty :: HType) :: Theory:
  let res = raise_or_theory(
    #'new_constant,
    thy,
    generated.new_constant(fresh_generation())(raw_theory(thy))(n)(ty))
  note(#'new_constant, thy.stamp.id, [], [n, ty], res.stamp.id, [])
  res

fun new_axiom(thy :: Theory, p :: Term) :: values(Theory, Thm):
  match generated.new_axiom(fresh_generation())(raw_theory(thy))(p)
  | generated.Success(generated.PairValue(raw, raw_th)):
      let res = wrap_new_theory(thy, raw)
      let th = wrap_raw_thm(raw_th, res.stamp, raw)
      note(#'new_axiom, thy.stamp.id, [], [p], res.stamp.id, [th])
      values(res, th)
  | generated.Failure(failure): raise_generated_failure(#'new_axiom, failure)

fun new_basic_definition(thy :: Theory, tm :: Term) :: values(Theory, Thm):
  match generated.new_basic_definition(fresh_generation())(raw_theory(thy))(tm)
  | generated.Success(generated.PairValue(raw, raw_th)):
      let res = wrap_new_theory(thy, raw)
      let th = wrap_raw_thm(raw_th, res.stamp, raw)
      note(#'new_basic_definition, thy.stamp.id, [], [tm], res.stamp.id, [th])
      values(res, th)
  | generated.Failure(failure): raise_generated_failure(#'new_basic_definition, failure)

fun new_basic_type_definition(thy :: Theory,
                              tyname :: Symbol,
                              absname :: Symbol,
                              repname :: Symbol,
                              th :: Thm) :: values(Theory, Thm, Thm):
  in_theory(#'new_basic_type_definition, thy, th)
  match generated.new_basic_type_definition(
      fresh_generation())(raw_theory(thy))(tyname)(absname)(repname)(raw_thm(th))
  | generated.Success(generated.PairValue(raw, generated.PairValue(raw_th1, raw_th2))):
      let res = wrap_new_theory(thy, raw)
      let abs_rep = wrap_raw_thm(raw_th1, res.stamp, raw)
      let pred_th = wrap_raw_thm(raw_th2, res.stamp, raw)
      note(#'new_basic_type_definition, thy.stamp.id, [th],
           [tyname, absname, repname], res.stamp.id,
           [abs_rep, pred_th])
      values(res, abs_rep, pred_th)
  | generated.Failure(failure):
      raise_generated_failure(#'new_basic_type_definition, failure)

// --- Printing: canonical string rendering for terms and hypothesis lists ---

fun show(t :: Term) :: String:
  term_to_string(t)

fun show_typed(t :: Term) :: String:
  typed_to_string(t)

fun show_hyps(hyps :: List.of(Term)) :: String:
  cond
  | hyps.length() == 0: ""
  | ~else: String.join(hyps.map(show), ", ") ++ " |- "
