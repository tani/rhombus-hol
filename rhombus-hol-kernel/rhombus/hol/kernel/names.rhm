#lang rhombus/static

// Canonical names of the logical constants and type constructors.
//
// These are the names the kernel, the printer, the elaborator and the derived
// layer must all agree on.  HOL spells them `=`, `==>`, `/\`, `\/`, `~`, `!`,
// `?`; we use identifier symbols instead, because `#'/\` is not writable in
// Rhombus, and reserve the operator spellings for the *surface* syntax
// (`===`, `==>`, `and`, `or`, `not`, `forall`, `exists`).

export:
  ty_bool
  ty_fun
  v_alpha
  v_rep
  c_eq
  c_imp
  c_conj
  c_disj
  c_neg
  c_true
  c_false
  c_forall
  c_exists
  c_exists1
  c_select
  c_cond
  c_wf
  suffixed
  internal_name
  derived_name
  abstraction_name
  representation_name
  subterm_relation_name

def ty_bool :: Symbol = #'bool
def ty_fun :: Symbol = #'fun

// Two names the kernel writes for itself rather than receiving from a
// caller: the type variable of `eq`'s generic type (which
// `new_basic_type_definition` reuses as the variable it abstracts over),
// and the representation variable that rule introduces.  Nothing reserves
// them -- a user may write `a` or `r` too, and it would be harmless, since
// `new_basic_type_definition` checks its predicate closed and a free
// variable in a conclusion is instantiable anyway. They live here because
// this is where names spelled directly by the kernel belong.
def v_alpha :: Symbol = #'a
def v_rep :: Symbol = #'r

def c_eq :: Symbol = #'eq
def c_imp :: Symbol = #'imp
def c_conj :: Symbol = #'conj
def c_disj :: Symbol = #'disj
def c_neg :: Symbol = #'neg
def c_true :: Symbol = #'true
def c_false :: Symbol = #'false
def c_forall :: Symbol = #'forall
def c_exists :: Symbol = #'exists
def c_exists1 :: Symbol = #'exists1
def c_select :: Symbol = #'select
def c_cond :: Symbol = #'cond
// Well-foundedness: `WF(R) <=> every nonempty set has an R-minimal element`.
// Defined, not axiomatic (see `wellfounded.rhm`), but reserved here alongside
// the other logical constants since it is base-theory vocabulary every
// datatype's subterm relation and every recursive definition's termination
// argument is stated in terms of.
def c_wf :: Symbol = #'wf

// A constant name with a fixed suffix appended.
fun suffixed(name :: Symbol, suffix :: String) :: Symbol:
  Symbol.from_string(to_string(name) ++ suffix)

// Names no source identifier can spell, since none contains `'`. Every
// constant and type the derived layer introduces for itself has one, so no
// declaration can collide with it and no name a user might want is taken.
// The names above are the logic's own vocabulary and stay reserved as they
// are.
//
// A fixed construction of the base theory -- the product, sum and number
// types and their constants -- is its text followed by `'`: `fst'`.
fun internal_name(text :: String) :: Symbol:
  Symbol.from_string(text ++ "'")

// A constant or type made for a declaration is the declaration's name, `'`,
// and what it is: `size'rel`, `List'abs`. The part after the last `'` is
// never empty, so a derived name is never a fixed one, and two differ
// whenever their bases or kinds do.
fun derived_name(base :: Symbol, kind :: String) :: Symbol:
  Symbol.from_string(to_string(base) ++ "'" ++ kind)

// The structural subterm relation generated alongside a datatype: `Nat_lt`
// for `Nat`.  It lives here rather than in `subterm.rhm` because
// `recdef.rhm` has to resolve it when checking a measure, and `subterm.rhm`
// is downstream of `recdef.rhm`.
fun subterm_relation_name(tyname :: Symbol) :: Symbol:
  suffixed(tyname, "_lt")

// The bijection `new_basic_type_definition` introduces for a type the derived
// layer builds -- a datatype, its family's union, the product -- between the
// type and its representation.
fun abstraction_name(tyname :: Symbol) :: Symbol:
  derived_name(tyname, "abs")

fun representation_name(tyname :: Symbol) :: Symbol:
  derived_name(tyname, "rep")
