#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// HOL Light is a design reference, not a source-license scope; see THIRD_PARTY_NOTICES.

// Representation ABI shared by the public syntax modules and the
// Isabelle-generated kernel. This module owns the class identities. Ordinary
// clients use `htype.rhm` and `term.rhm`; generated code and representation
// tests import this module directly.

export:
  kernel_abi_version
  HType
  TyVar
  TyApp
  Term
  FVar
  BVar
  Const
  Comb
  Abs
  NatLit
  raw
  name_fun
  name_bool
  name_eq
  name_alpha
  name_rep
  name_nat
  name_zero
  name_succ
  name_nat_n
  name_nat_m
  name_nat_p
  user_name
  structural_equal
  list_nil
  list_cons

def kernel_abi_version :: Int = 1

class HType():
  nonfinal

class TyVar(name :: Symbol):
  extends HType
  constructor ~none
  internal _TyVar

class TyApp(name :: Symbol, args :: List.of(HType)):
  extends HType
  constructor ~none
  internal _TyApp

class Term():
  nonfinal

class FVar(name :: Symbol, ty :: HType):
  extends Term
  constructor ~none
  internal _FVar

class BVar(index :: NonnegInt, ty :: HType):
  extends Term
  constructor ~none
  internal _BVar

class Const(name :: Symbol, ty :: HType):
  extends Term
  constructor ~none
  internal _Const

class Comb(func :: Term, arg :: Term):
  extends Term
  constructor ~none
  internal _Comb

class Abs(arg_ty :: HType, body :: Term):
  extends Term
  constructor ~none
  internal _Abs

class NatLit(value :: NonnegInt):
  extends Term
  constructor ~none
  internal _NatLit

namespace raw:
  export:
    tyvar
    tyapp
    fvar
    bvar
    const
    comb
    abs
    nat_lit

  fun tyvar(name :: Symbol) :: TyVar: _TyVar()(name)
  fun tyapp(name :: Symbol, args :: List.of(HType)) :: TyApp:
    _TyApp()(name, args)
  fun fvar(name :: Symbol, ty :: HType) :: FVar: _FVar()(name, ty)
  fun bvar(index :: NonnegInt, ty :: HType) :: BVar: _BVar()(index, ty)
  fun const(name :: Symbol, ty :: HType) :: Const: _Const()(name, ty)
  fun comb(func :: Term, arg :: Term) :: Comb: _Comb()(func, arg)
  fun abs(arg_ty :: HType, body :: Term) :: Abs: _Abs()(arg_ty, body)
  fun nat_lit(value :: NonnegInt) :: NatLit: _NatLit()(value)

// Canonical identities for the formal kernel's fixed names.
def name_fun :: Symbol = #'fun
def name_bool :: Symbol = #'bool
def name_eq :: Symbol = #'eq
def name_alpha :: Symbol = #'a
def name_rep :: Symbol = #'r
def name_nat :: Symbol = #'Nat
def name_zero :: Symbol = #'zero
def name_succ :: Symbol = #'succ
def name_nat_n :: Symbol = #'n
def name_nat_m :: Symbol = #'m
def name_nat_p :: Symbol = #'P

fun user_name(identity :: NonnegInt, _display) :: Symbol:
  Symbol.from_string("__kernel_user_" ++ to_string(identity))

fun structural_equal(a):
  fun (b): a == b

// Small host-representation operations used by generated code. Keeping these
// here makes list mappings explicit instead of depending on generated
// wrapper datatypes.
fun list_nil() :: List: []
fun list_cons(x, xs :: List) :: List: List.cons(x, xs)
