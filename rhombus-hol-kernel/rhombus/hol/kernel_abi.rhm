#lang rhombus/static
// SPDX-License-Identifier: 0BSD AND BSD-2-Clause
// Conservatively covered by the HOL Light notice in THIRD_PARTY_NOTICES.

// Representation ABI shared by the public syntax modules and the
// Isabelle-generated kernel. This module owns the class identities. Ordinary
// clients use `htype.rhm` and `term.rhm`; generated code and representation
// tests import this module directly.

export:
  kernel_abi_version
  HType
  TyVar
  TyApp
  Term
  FVar
  BVar
  Const
  Comb
  Abs
  raw
  name_fun
  name_bool
  name_eq
  name_alpha
  name_rep
  symbol_equal
  structural_equal
  list_nil
  list_cons
  nat_from_integer
  integer_from_nat
  nat_add
  nat_subtract
  nat_less
  nat_equal
  nat_add_curried
  nat_subtract_curried
  nat_less_curried
  nat_equal_curried

def kernel_abi_version :: Int = 1

class HType():
  nonfinal

class TyVar(name :: Symbol):
  extends HType
  constructor ~none
  internal _TyVar

class TyApp(name :: Symbol, args :: List.of(HType)):
  extends HType
  constructor ~none
  internal _TyApp

class Term():
  nonfinal

class FVar(name :: Symbol, ty :: HType):
  extends Term
  constructor ~none
  internal _FVar

class BVar(index :: NonnegInt, ty :: HType):
  extends Term
  constructor ~none
  internal _BVar

class Const(name :: Symbol, ty :: HType):
  extends Term
  constructor ~none
  internal _Const

class Comb(func :: Term, arg :: Term):
  extends Term
  constructor ~none
  internal _Comb

class Abs(arg_ty :: HType, body :: Term):
  extends Term
  constructor ~none
  internal _Abs

namespace raw:
  export:
    tyvar
    tyapp
    fvar
    bvar
    const
    comb
    abs

  fun tyvar(name :: Symbol) :: TyVar: _TyVar()(name)
  fun tyapp(name :: Symbol, args :: List.of(HType)) :: TyApp:
    _TyApp()(name, args)
  fun fvar(name :: Symbol, ty :: HType) :: FVar: _FVar()(name, ty)
  fun bvar(index :: NonnegInt, ty :: HType) :: BVar: _BVar()(index, ty)
  fun const(name :: Symbol, ty :: HType) :: Const: _Const()(name, ty)
  fun comb(func :: Term, arg :: Term) :: Comb: _Comb()(func, arg)
  fun abs(arg_ty :: HType, body :: Term) :: Abs: _Abs()(arg_ty, body)

// Canonical identities for the formal kernel's fixed names.
def name_fun :: Symbol = #'fun
def name_bool :: Symbol = #'bool
def name_eq :: Symbol = #'eq
def name_alpha :: Symbol = #'a
def name_rep :: Symbol = #'r

fun symbol_equal(a :: Symbol, b :: Symbol) :: Boolean: a == b
fun structural_equal(a):
  fun (b): a == b

// Small host-representation operations used by generated code. Keeping these
// here makes list and natural mappings explicit instead of depending on
// generated wrapper datatypes.
fun list_nil() :: List: []
fun list_cons(x, xs :: List) :: List: List.cons(x, xs)

fun nat_from_integer(n :: Int): (if n < 0 | 0 | n)
fun integer_from_nat(n :: NonnegInt) :: Int: n
fun nat_add(m :: NonnegInt, n :: NonnegInt): m + n
fun nat_subtract(m :: NonnegInt, n :: NonnegInt):
  (if m < n | 0 | m - n)
fun nat_less(m :: NonnegInt, n :: NonnegInt) :: Boolean: m < n
fun nat_equal(m :: NonnegInt, n :: NonnegInt) :: Boolean: m == n
fun nat_add_curried(m :: NonnegInt):
  fun (n :: NonnegInt): nat_add(m, n)
fun nat_subtract_curried(m :: NonnegInt):
  fun (n :: NonnegInt): nat_subtract(m, n)
fun nat_less_curried(m :: NonnegInt):
  fun (n :: NonnegInt): nat_less(m, n)
fun nat_equal_curried(m :: NonnegInt):
  fun (n :: NonnegInt): nat_equal(m, n)
