fun new_basic_definition(arg): «
  fun (arh): «
    fun (ari): «
      match [arg, arh, ari]
      | [fresh, thy, tm] : «
        (block: «
           match (dest_eq)(tm)
           | None() : «
             None()
             »
           | Some(PairValue(FVar(n, ty), rhs)) : «
             (if (((!(is_none)(((const_tab)(thy))(n))) || ((!((check_term)(thy))(rhs)) || ((!(null)((free_vars)(rhs))) || ((!(((equal_option)(equal_htype()))((type_of)(rhs)))(Some(ty))) || (!(((superset)(equal_hname()))((type_vars)(ty)))((term_type_vars)(rhs)))))))) | (None()) | ((block: «
    match ((next_stamp)(fresh))((thy_stamp)(thy))
    | st : «
      (block: «
         match Const(n, ty)
         | c : «
           (block: «
              match Hthm_ext(Nil(), (((eq_term)(ty))(c))(rhs), st, Unity())
              | dth : «
                (block: «
                   match Htheory_ext((tyops)(thy), ((((fun_upd)(equal_hname()))((const_tab)(thy)))(n))(Some(ty)), (axiom_list)(thy), ((((fun_upd)(equal_hname()))((def_tab)(thy)))(n))(Some(dth)), st, Unity())
                   | thya : «
                     (if (((wf_thm)(thya))(dth)) | (Some(PairValue(thya, dth))) | (None()))
                     »
                   »)
                »
              »)
           »
         »)
      »
    »)))
