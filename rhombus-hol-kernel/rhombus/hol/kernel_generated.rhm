fun run_code_rule(arg): «
  match [arg]
  | [CodeRefl(thy, t)] : «
    ((refl)(thy))(t)
    »
  | [CodeTrans(thy, a, b)] : «
    (((trans)(thy))(a))(b)
    »
  | [CodeMkComb(thy, a, b)] : «
    (((mk_comb_rule)(thy))(a))(b)
    »
  | [CodeAbs(thy, n, ty, th)] : «
    ((((abs_rule)(thy))(n))(ty))(th)
    »
  | [CodeBeta(thy, t)] : «
    ((beta)(thy))(t)
    »
  | [CodeAssume(thy, p)] : «
    ((assume_rule)(thy))(p)
    »
  | [CodeEqMp(thy, a, b)] : «
    (((eq_mp)(thy))(a))(b)
    »
  | [CodeDeductAntisym(thy, a, b)] : «
    (((deduct_antisym_rule)(thy))(a))(b)
    »
  | [CodeInst(thy, entries, th)] : «
    (((inst)(thy))(entries))(th)
    »
  | [CodeInstType(thy, entries, th)] : «
    (((inst_type_entries)(thy))(entries))(th)
    »
  | ~else: «
    error ("non-exhaustive match in Rhombus_HOL_Code.run_code_rule")
    »
  »

