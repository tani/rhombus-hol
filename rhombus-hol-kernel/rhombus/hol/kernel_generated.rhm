    | [abi.BVar(v, va), th] : «
      AxiomDelta(th)
      »
    | [abi.Const(v, va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.FVar(vb, vc), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.BVar(vb, vc), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.Const(vb, vc), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.Comb(abi.FVar(vd, ve), vc), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.Comb(abi.BVar(vd, ve), vc), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.Comb(abi.Comb(vd, ve), vc), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.Comb(abi.Abs(vd, ve), vc), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.Comb(vb, abi.BVar(vd, ve)), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.Comb(vb, abi.Const(vd, ve)), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.Comb(vb, abi.Comb(vd, ve)), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.Comb(vb, abi.Abs(vd, ve)), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Comb(abi.Abs(vb, vc), va), th] : «
      AxiomDelta(th)
      »
    | [abi.Abs(v, va), th] : «
      AxiomDelta(th)
      »
    | ~else: «
      error ("non-exhaustive match in Rhombus_HOL_Code_API.definition_delta_of")
      »
    »
  »

