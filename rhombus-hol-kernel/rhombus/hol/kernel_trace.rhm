#lang rhombus/static
// SPDX-License-Identifier: 0BSD AND BSD-2-Clause

import:
  "kernel_values.rhm" open

export:
  trace
  note
  thm_key

namespace trace:
  export:
    TraceStep
    with_recording

  class TraceStep(rule :: Symbol,
                  thy :: maybe(Symbol),
                  thms :: List,
                  data :: List,
                  out_thy :: maybe(Symbol),
                  out_thms :: List)

  fun with_recording(thunk):
    let was_recording = recording.value
    let outer_log = trace_log.value
    recording.value := #true
    trace_log.value := []
    try:
      let result = thunk()
      let steps = (trace_log.value :~ List).reverse()
      values(result, steps)
      ~finally:
        recording.value := was_recording
        trace_log.value := outer_log

fun thm_key(th :: Thm) :: List: [th.stamp.id, th.hyps, th.concl]
def recording :: Box = Box(#false)
def trace_log :: Box = Box([])

fun note(rule :: Symbol, thy, thms :: List, data :: List,
         out_thy, out_thms :: List) :: Void:
  when recording.value
  | let step = trace.TraceStep(rule, thy, thms, data, out_thy, out_thms)
    trace_log.value := List.cons(step, trace_log.value :~ List)
