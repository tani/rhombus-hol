#lang rhombus/static
// SPDX-License-Identifier: 0BSD

import:
  "htype.rhm" open
  "term.rhm" open
  "names.rhm" open
  "kernel_generated.rhm" as generated

export:
  Stamp
  Thm
  Theory
  fresh_generation
  raw_thm
  raw_thm_theory
  raw_theory
  descends
  combine_stamps
  later_raw_theory
  wrap_raw_thm
  make_initial_theory
  wrap_new_theory
  hyps_of
  concl_of
  stamp_of
  type_arity
  const_type
  axioms_of
  definition_of
  in_theory

class Stamp(id :: Symbol,
            gen :: Int,
            ancestors :: Set.of(Symbol),
            private raw):
  constructor ~none
  reconstructor ~none
  internal _Stamp

class Thm(hyps :: List.of(Term),
          concl :: Term,
          stamp :: Stamp,
          private raw,
          private raw_theory):
  authentic
  constructor ~none
  reconstructor ~none
  internal _Thm
  private implements Equatable
  private override equals(other :: Thm, recur):
    (recur(concl, other.concl)
       && hyps.length() == other.hyps.length()
       && (for all (h in hyps):
             for any (k in other.hyps): recur(h, k)))
  private override hash_code(recur):
    let hs = for values(acc = 0) (h in hyps): acc + recur(h)
    Equatable.hash_code_combine(recur(concl), hyps.length(), hs)

// The theory's contents are queried straight from the Isabelle-generated
// value on every call, not cached here. Isabelle's `fun_upd`-built lookup
// functions (`tyops`/`const_tab`/`def_tab`) are code-printed to a persistent
// per-base map (`Rhombus_HOL_Code.thy`'s `rhombus_fun_upd`), so a direct call
// is already an O(1) amortized lookup; keeping a second, hand-synchronized
// cache here would just be two representations of the same fact.
class Theory(stamp :: Stamp, private raw):
  constructor ~none
  reconstructor ~none
  internal _Theory

fun raw_thm(th :: Thm): _Thm.raw(th)
fun raw_thm_theory(th :: Thm): _Thm.raw_theory(th)
fun raw_theory(thy :: Theory): _Theory.raw(thy)

fun fresh_stamp(raw) :: Stamp:
  let id = Symbol.uninterned_from_string("thy")
  _Stamp(id, 0, {id}, raw)

fun next_stamp(prev :: Stamp, raw) :: Stamp:
  let id = Symbol.uninterned_from_string("thy")
  _Stamp(id, prev.gen + 1, prev.ancestors ++ {id}, raw)

def stamp_serial :: Box = Box(0)

fun fresh_generation() :: NonnegInt:
  let n = stamp_serial.value :~ NonnegInt
  stamp_serial.value := n + 1
  n

fun descends(a :: Stamp, b :: Stamp) :: Boolean:
  a.id in b.ancestors

fun combine_stamps(who :: Symbol, a :: Stamp, b :: Stamp) :: Stamp:
  cond
  | descends(a, b): b
  | descends(b, a): a
  | ~else:
      error(~who: who,
            "theorems come from different theories",
            error.val(~label: "detail",
                      "neither theory is an extension of the other, so the "
                        ++ "two theorems may disagree about what a shared name means"))

fun later_raw_theory(a :: Thm, b :: Thm):
  (if descends(a.stamp, b.stamp) | raw_thm_theory(b) | raw_thm_theory(a))

fun wrap_raw_thm(raw, stamp :: Stamp, raw_thy) :: Thm:
  _Thm(generated.hyps(raw), generated.concl(raw), stamp, raw, raw_thy)

fun hyps_of(th :: Thm) :: List.of(Term): th.hyps
fun concl_of(th :: Thm) :: Term: th.concl
fun stamp_of(th :: Thm) :: Stamp: th.stamp

fun type_arity(thy :: Theory, n :: Symbol) :: maybe(Int):
  match (generated.tyops(raw_theory(thy)))(n)
  | generated.None(): #false
  | generated.Some(arity): arity

fun const_type(thy :: Theory, n :: Symbol) :: maybe(HType):
  match (generated.const_tab(raw_theory(thy)))(n)
  | generated.None(): #false
  | generated.Some(ty): ty

fun axioms_of(thy :: Theory) :: List.of(Thm):
  let raw_axioms :~ List = generated.axiom_list(raw_theory(thy))
  for List (raw_th in raw_axioms):
    wrap_raw_thm(raw_th, thy.stamp, raw_theory(thy))

fun definition_of(thy :: Theory, n :: Symbol) :: maybe(Thm):
  match (generated.def_tab(raw_theory(thy)))(n)
  | generated.None(): #false
  | generated.Some(raw_th): wrap_raw_thm(raw_th, thy.stamp, raw_theory(thy))

fun make_initial_theory() :: Theory:
  let raw = generated.initial_theory(fresh_generation())
  _Theory(fresh_stamp(generated.thy_stamp(raw)), raw)

// Every `new_*` kernel primitive hands back a fresh raw theory value; this
// wraps it with a `Stamp` descending from `thy`'s. Callers that also get a
// theorem back wrap it separately with `wrap_raw_thm`, using the same new
// stamp and this same new raw theory as its provenance.
fun wrap_new_theory(thy :: Theory, raw) :: Theory:
  _Theory(next_stamp(thy.stamp, generated.thy_stamp(raw)), raw)

fun in_theory(who :: Symbol, thy :: Theory, th :: Thm) :: Void:
  unless descends(th.stamp, thy.stamp)
  | error(~who: who,
          "theorem was not proved in this theory or an ancestor of it")
