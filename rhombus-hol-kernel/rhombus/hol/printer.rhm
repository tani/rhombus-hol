#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// Canonical rendering for the modern locally-nameless kernel.

import:
  "htype.rhm" open
  "term.rhm" open

export:
  show
  show_with_type
  show_typed
  show_hyps

fun show(t :: Term) :: String:
  term_to_string(t)

// The modern term renderer is self-contained. Surface notation may replace
// type spellings around it, but it must not rebuild or reinterpret the term.
fun show_with_type(t :: Term, _render_type :: Function.of_arity(1)) :: String:
  show(t)

fun show_typed(t :: Term) :: String:
  typed_to_string(t)

fun show_hyps(hyps :: List.of(Term)) :: String:
  cond
  | hyps.length() == 0: ""
  | ~else: String.join(hyps.map(show), ", ") ++ " |- "
