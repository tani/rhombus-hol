#lang rhombus/static

// The glue the generated phase-1 code calls.
//
// A `#lang rhombus/hol` module's declarations thread a `HolState` through the
// module body: `#%module_block` emits `meta def _hol_st0 = initial_state()`
// and then one `meta def _hol_stN = <step>(_hol_stN-1, ...)` per declaration.
// So the state is an ordinary phase-1 definition *in the user's module*, not
// compile-time state belonging to the macro, which is what keeps two modules
// compiled in one `raco make` from sharing it.
//
// Each step re-parses the user's own syntax rather than receiving a
// pre-digested value: the same `elab` functions run at expansion time, to
// generate the runtime code, and again here, to make the logical
// declaration.  One parser, so the two views cannot drift.

import:
  lib("racket/base.rkt") as rb
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  "bool.rhm" open
  "datatype.rhm" open
  "datatype_gen.rhm" open
  "algebra.rhm" open
  "recdef.rhm" open
  "dtree.rhm" open
  "subterm.rhm" open
  "ruledb.rhm" open
  "taut.rhm" open
  "waterfall.rhm" open
  "wfrec.rhm" open
  "terminate.rhm" open
  "stepfn.rhm" open
  "elab.rhm" as elab

export:
  hol_error
  hol_reraise
  HolState
  initial_state
  state_context
  declared_names
  add_type
  add_function
  add_theorem
  set_rules
  adopt
  note_decl
  expect_declared

// Failures reported from here happen while the user's module is being visited
// at phase 1, not inside a macro transformer, so `syntax_meta.error` is not
// available -- it is bound only in meta contexts.  Raising a syntax error with
// the offending form attached is what gets the user a line number rather than
// just a module name.
//
// Pass the *head term* of a declaration, not the whole group: a group built by
// a template carries the template's location, and the head still carries the
// user's.
fun hol_error(who :: Symbol, message :: String, at :: Syntax):
  rb.#{raise-syntax-error}(who, message, at)

// Re-raise a failure from the logical layer at the user's source location.
//
// The caught message already begins with its own `who: ` prefix, and
// `raise-syntax-error` adds one of its own taken from the form -- so the
// prefix has to be stripped or the reader sees `type: type: ...`.
fun hol_reraise(e :: Exn.Fail, at :: Syntax):
  rb.#{raise-syntax-error}(#false, strip_who(e.message), at)

fun strip_who(msg :: String) :~ String:
  match msg.find(": ")
  | #false: msg
  | i:
      let head = msg.substring(0 .. i)
      // Only a bare word is a `who` prefix; anything with a space in it is
      // already part of the message.
      (if head.contains(" ") || head.contains("\n")
       | msg
       | msg.substring((i + 2) .. msg.length()))

class HolState(thy :: Theory,
               db :: RuleDB,
               dts :: Map.of(Symbol, DatatypeThms),
               funs :: Map.of(Symbol, FunInfo),
               thms :: Map.of(Symbol, Thm),
               // declaration order, for diagnostics
               names :: List.of(Symbol),
               // `wfrec_rel`'s definition (`wfrec.rhm`'s `build_wfrec_rel`),
               // installed exactly once at the very start of the session so
               // every structurally derived `function` can share it --
               // `new_basic_definition` refuses a second declaration of the
               // same constant.
               wfrec_def :: Thm)

fun initial_state() :: HolState:
  // `wfrec_base_theory()`/`wfrec_base_def()` (`wfrec.rhm`) are memoized the
  // same way `bool.rhm`'s `base_theory()` is: `new_basic_definition` mints
  // a fresh `Stamp` on every call, so calling `build_wfrec_rel` fresh here
  // would give every module's `HolState.thy` an incomparable stamp,
  // breaking `adopt`'s check the moment one module imports another's state.
  let thy = wfrec_base_theory()
  // Propositional cleanup is in the database from the start: without it a
  // finished proof can look stuck at `true and true`.
  let db = for values(d :~ RuleDB = empty_db) (th in tautologies(thy)):
             add_thm(thy, d, #'propositional, th)
  // The two `if` rules are separate so that `disable_rules [conditional]` can
  // turn them off without also losing propositional cleanup.
  let db = for values(d :~ RuleDB = db) (th in conditionals(thy)):
             add_thm(thy, d, #'conditional, th)
  HolState(thy, db, {}, {}, {}, [], wfrec_base_def())

fun declared_names(st :: HolState) :: List.of(Symbol):
  st.names

// The prover context for the state as it currently stands.
fun state_context(st :: HolState) :: Context:
  mk_context(st.thy, ~rules: st.db, ~datatypes: st.dts, ~functions: st.funs)

// -- type --------------------------------------------------------------------

fun add_type(st :: HolState, form :: Syntax, at :: Syntax) :: HolState:
  let spec = elab.parse_type_decl(form)
  // Non-recursive specs (no self-recursive fields) get a genuinely derived
  // `DatatypeThms` -- proved from `unit`/`prod`/`sum` via
  // `new_basic_type_definition`, with zero `new_axiom` calls -- rather than
  // the axiom schema below; see PLAN.md section 9.2.1.  Self-recursive
  // datatypes (phase 2/3, need an infinity axiom) still use the axioms.
  let (thy2, thms) = try:
                       (if is_nonrecursive_spec(spec)
                        | build_nonrecursive_datatype_thms(st.thy, spec)
                        | datatype_axioms(st.thy, spec))
                       ~catch e :: Exn.Fail: hol_reraise(e, at)
  // Every equation the datatype brings -- injectivity, distinctness,
  // discriminators, selectors -- goes straight into the rule database, which
  // is what makes `match`-defined functions simplify.
  let db2 = for values(d :~ RuleDB = st.db) (th in datatype_rules(thms)):
              add_thm(thy2, d, spec.name, th)
  add_subterm_relation(
    HolState(thy2, db2, st.dts ++ {spec.name: thms}, st.funs, st.thms,
             st.names ++ [spec.name], st.wfrec_def),
    spec, at)

// Every recursive datatype brings its structural subterm relation with it, so
// that a `~measure` into it has an order to decrease in.  It is an ordinary
// definition installed through the ordinary seam -- see `subterm.rhm` for why
// that is the whole soundness argument -- and its equations join the rule
// database under their own name, so `disable_rules [Nat_lt]` reaches them
// without touching the datatype's own rules.
fun add_subterm_relation(st :: HolState, spec :: DatatypeSpec,
                         at :: Syntax) :: HolState:
  match subterm_spec(spec)
  | #false: st
  | fs:
      let fs :~ FunSpec = fs
      when const_type(st.thy, fs.name) != #false
      | hol_error(#'type,
                  "the name of this datatype's subterm relation, "
                    ++ to_string(fs.name)
                    ++ ", is already taken",
                  at)
      let dt_specs = for values(m :~ Map = {}) ((n, thms) in st.dts):
                       m ++ {n: (thms :~ DatatypeThms).spec}
      let (thy2, info0) = try:
                            install_function(st.thy, fs, dt_specs)
                            ~catch e :: Exn.Fail: hol_reraise(e, at)
      let info :~ FunInfo = info0
      let db2 = add_thms(thy2, st.db, fs.name, info.equations)
      HolState(thy2, db2, st.dts, st.funs ++ {fs.name: info}, st.thms,
               st.names ++ [fs.name], st.wfrec_def)

// -- function ----------------------------------------------------------------

fun add_function(st :: HolState, form :: Syntax, at :: Syntax) :: HolState:
  let spec :~ FunSpec = try:
                          elab.parse_function_decl(st.thy, form)
                          ~catch e :: Exn.Fail: hol_reraise(e, at)
  let dt_specs = for values(m :~ Map = {}) ((n, thms) in st.dts):
                   m ++ {n: (thms :~ DatatypeThms).spec}
  try:
    check_function_spec(st.thy, spec, dt_specs)
    ~catch e :: Exn.Fail: hol_reraise(e, at)
  // An un-measured definition that recurses structurally, with one argument
  // column descending at every recursive call into a *known* (`st.dts`)
  // datatype, gets a genuine `WFREC` derivation (`stepfn.rhm`) instead of
  // `new_axiom`; several arguments are derived over their tuple.  Anything
  // else -- an explicit `~measure`, lexicographic descent where no single
  // column always shrinks, or an argument type this module never declared
  // -- falls back to `install_function`'s postulating seam, exactly as
  // `add_type` falls back to `datatype_axioms` for self-recursive types
  // beside `datatype_gen.rhm`'s derivation.
  let arity = spec.arg_types.length()
  let derivable:
    cond
    | arity == 0: #false
    | ~else:
        let fn_ph = mk_const(spec.name, fun_type(spec))
        let measure:
          match spec.measure
          | #false: #false
          | m: Measure(m :~ Term, discharger(st))
        let recinfo = try:
                        check_termination(#'function, spec.name, arity,
                                          spec.clauses.map(fun (cl :: DefClause): [cl.pats, cl.rhs]),
                                          fn_ph,
                                          ~measure: measure)
                        ~catch e :: Exn.Fail: hol_reraise(e, at)
        // The same tree `check_function_spec` just checked, kept this time:
        // `stepfn.rhm` builds `H` and its congruence proof from it, so the
        // logical and executable readings of the patterns cannot drift.
        let tree = try:
                     function_decision_tree(#'function, spec, dt_specs)
                     ~catch e :: Exn.Fail: hol_reraise(e, at)
        cond
        | !can_derive_structurally(spec, recinfo, tree, st.dts): #false
        | ~else:
            // `can_derive_structurally` has already checked the descending
            // column's type is a declared datatype at its own schematic self
            // type; what is left is that the type's subterm relation was
            // actually installed, which it is for every datatype `add_type`
            // declared.
            // The order's own type: the measure's result type for a
            // `~measure`, the descending column's otherwise.
            let order_ty:
              cond
              | spec.measure: measure_result_type(spec)
              | ~else:
                  let k = (match descent_column(spec, fn_ph,
                                                ~usable: fun (ty :: HType):
                                                           match ty
                                                           | TyApp(n, _): st.dts.get(n, #false) != #false
                                                           | ~else: #false)
                           | c: c :~ Int)
                  spec.arg_types[k]
            let tyname = (match order_ty | TyApp(n, _): n)
            match st.dts.get(tyname, #false)
            | #false: #false
            | thms:
                match st.funs.get(subterm_relation_name(tyname), #false)
                | #false: #false
                | tlt_info:
                    [thms :~ DatatypeThms, (tlt_info :~ FunInfo).equations,
                     recinfo, tree]
  let (thy2, info0) = try:
                        match derivable
                        | [thms, t_lt_equations, recinfo, tree]:
                            install_structural_function(st.thy, st.wfrec_def, spec,
                                                        thms :~ DatatypeThms,
                                                        st.dts,
                                                        tree :~ DecisionTree,
                                                        t_lt_equations :~ List.of(Thm),
                                                        recinfo :~ RecursionInfo,
                                                        algebra_base_thms())
                        | #false:
                            install_function(st.thy, spec, dt_specs,
                                             ~discharge: discharger(st))
                        ~catch e :: Exn.Fail: hol_reraise(e, at)
  let info :~ FunInfo = info0
  // The defining equations become rewrite rules straight away: that is what
  // makes a `match`-defined function compute during simplification.
  let db2 = add_thms(thy2, st.db, spec.name, info.equations)
  HolState(thy2, db2, st.dts, st.funs ++ {spec.name: info}, st.thms,
           st.names ++ [spec.name], st.wfrec_def)

// Discharge a termination obligation against the state as it stands -- which
// is to say, without the function being defined.  That is not a limitation to
// work around but the point: a measure that needed the definition it justifies
// would justify nothing.
fun discharger(st :: HolState) :: Function:
  fun (obligation :: Term) :: values(maybe(Thm), maybe(String)):
    let (th, node) = prove(state_context(st), obligation)
    match th
    | #false: values(#false, residue_message(#'measure, node))
    | proved :~ Thm: values(proved, #false)

// -- theorem -----------------------------------------------------------------

// `attrs` arrive as keywords -- `~rewrite_rule` reads as `#:rewrite_rule` --
// so they are normalised to symbols here rather than at every use.
fun add_theorem(st :: HolState, name :: Symbol, attr_kws :: List,
                stmt :: Syntax, tactic :: maybe(Syntax),
                at :: Syntax) :: HolState:
  let attrs = attr_kws.map(fun (k): Symbol.from_string(to_string(k)))
  let (statement, names) = try:
                             elab.parse_theorem_statement(st.thy, stmt)
                             ~catch e :: Exn.Fail: hol_reraise(e, at)
  let [induct, using_names, do_not_names, in_theory_names, case_stxs] = elab.parse_tactic(tactic)
  // `~using:` adds named theorems for this proof only, and overrides
  // `disable_rules`: an explicit request beats a blanket one.
  let db0 = for values(d :~ RuleDB = st.db) (u in (using_names :~ List)):
              match st.thms.get(u, #false)
              | #false:
                  hol_error(#'proof, "no such theorem to use: " ++ to_string(u), at)
              | th: add_thm(st.thy, d, u :~ Symbol, th :~ Thm)
  // `~in_theory:` disables further rules for this proof only, on top of the
  // module's own `disable_rules`; it never re-enables one `disable_rules`
  // already turned off, since the module-level rules are already baked into
  // `st.db` by the time this runs.
  let db = disable(db0, in_theory_names :~ List)
  let ctx = mk_context(st.thy, ~rules: db, ~datatypes: st.dts,
                       ~functions: st.funs)
  let do_not = for values(acc :~ Set = Set()) (d in (do_not_names :~ List)):
                 acc ++ {d :~ Symbol}
  // `~cases:` terms are parsed against the theorem's own leading-binder
  // variables, the same ones the statement itself was parsed with -- so a
  // case term can name `xs` when the theorem reads `forall (xs :: ...): ...`.
  let cases:
    match case_stxs :~ List
    | []: []
    | _:
        let (vars, _) = strip_forall_all(statement, names)
        let tyvars = elab.collect_type_vars(stmt)
        let env = for values(m :~ Map = {}) (v in vars):
                    m ++ {(v :~ FVar).name: v :~ Term}
        for List (c in case_stxs :~ List):
          try:
            elab.parse_prop(st.thy, tyvars, env, c :~ Syntax)
            ~catch e :: Exn.Fail: hol_reraise(e, at)
  let (th, node) = try:
                     prove(ctx, statement, ~names: names,
                           ~induct: (induct :~ maybe(Symbol)),
                           ~do_not: do_not,
                           ~cases: cases)
  match th
  | #false: hol_error(#'theorem, residue_message(name, node), at)
  | proved :~ Thm:
      let db2 = (cond
                 | attrs.contains(#'rewrite_rule) || attrs.contains(#'simp):
                     add_thm(st.thy, st.db, name, proved)
                 | ~else: st.db)
      HolState(st.thy, db2, st.dts, st.funs, st.thms ++ {name: proved},
               st.names ++ [name], st.wfrec_def)

// -- adopting an imported theory ----------------------------------------------

// Adopt an imported theory wholesale.
//
// The imported state arrives as a live value: the same `Theory`, the same
// `Thm` objects, the same rule database.  Nothing is re-parsed and nothing is
// re-asserted, so there is no trust boundary here at all -- a `Thm` cannot be
// fabricated without the kernel, which is what its being opaque is for.  A
// description of a theory, by contrast, is data, and anything can write one.
//
// The single check is that the imported theory really extends the current one.
// That is not bureaucracy: `combine_stamps` refuses to mix theorems from two
// theories neither of which extends the other, so a module that adopted a
// sibling would be left holding two sets of theorems it could not use
// together.  Keeping the lineage a chain is what makes this a comparison
// rather than a theory merge.
fun adopt(st :: HolState, imported :: HolState, at :: Syntax) :: HolState:
  unless st.thy.stamp == imported.thy.stamp
           || descends(st.thy.stamp, imported.thy.stamp)
  | hol_error(#'import,
              "this theory does not extend the one in scope; an `import` of a "
                ++ "theory must come before the module's own declarations, "
                ++ "and several of them must be given in dependency order",
              at)
  // A rule switched off before the import stays off after it.
  let off = for values(acc :~ List = []) (n in st.db.disabled): acc ++ [n]
  HolState(imported.thy, disable(imported.db, off),
           imported.dts, imported.funs, imported.thms, imported.names,
           imported.wfrec_def)

// -- rule control ------------------------------------------------------------

fun set_rules(st :: HolState, on :: Boolean,
              names :: List.of(Symbol)) :: HolState:
  let db2 = (if on | enable(st.db, names) | disable(st.db, names))
  HolState(st.thy, db2, st.dts, st.funs, st.thms, st.names, st.wfrec_def)

fun datatype_rules(thms :: DatatypeThms) :: List.of(Thm):
  let inj = for values(acc :~ List = []) ((_, th) in thms.injectivity): acc ++ [th]
  inj ++ thms.distinctness ++ thms.discriminators ++ thms.selectors

// -- test hooks --------------------------------------------------------------
//
// `declare` and `expect` are not part of the language the specification
// describes; they exist so that the state threading can be tested directly,
// which is worth having because everything else depends on it.

fun note_decl(st :: HolState, n :: Symbol) :: HolState:
  HolState(st.thy, st.db, st.dts, st.funs, st.thms, st.names ++ [n], st.wfrec_def)

fun expect_declared(st :: HolState, expected :: List.of(Symbol),
                    ~at: at :: Syntax) :: HolState:
  unless st.names == expected
  | hol_error(#'expect,
              "declarations do not match\n  expected: " ++ to_string(expected)
                ++ "\n  got: " ++ to_string(st.names),
              at)
  st
