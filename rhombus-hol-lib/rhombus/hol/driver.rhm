#lang rhombus/static

// The glue the generated phase-1 code calls.
//
// A `#lang rhombus/hol` module's declarations thread a `HolState` through the
// module body: `#%module_block` emits `meta def _hol_st0 = initial_state()`
// and then one `meta def _hol_stN = <step>(_hol_stN-1, ...)` per declaration.
// So the state is an ordinary phase-1 definition *in the user's module*, not
// compile-time state belonging to the macro, which is what keeps two modules
// compiled in one `raco make` from sharing it.
//
// Each step re-parses the user's own syntax rather than receiving a
// pre-digested value: the same `elab` functions run at expansion time, to
// generate the runtime code, and again here, to make the logical
// declaration.  One parser, so the two views cannot drift.

import:
  lib("racket/base.rkt") as rb
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  "bool.rhm" open
  "datatype.rhm" open
  "datatype_gen.rhm" open
  "datatype_rec.rhm" open
  "infinity.rhm" open
  "algebra.rhm" open
  "recdef.rhm" open
  "funcases.rhm" open
  "dtree.rhm" open
  "subterm.rhm" open
  "ruledb.rhm" open
  "taut.rhm" open
  "waterfall.rhm" open
  "wfrec.rhm" open
  "terminate.rhm" open
  "stepfn.rhm" open
  "elab.rhm" as elab

export:
  hol_error
  hol_reraise
  HolState
  initial_state
  state_context
  declared_names
  add_type
  add_function
  add_axiomatic_function
  add_theorem
  set_rules
  adopt
  note_decl
  expect_declared

// Failures reported from here happen while the user's module is being visited
// at phase 1, not inside a macro transformer, so `syntax_meta.error` is not
// available -- it is bound only in meta contexts.  Raising a syntax error with
// the offending form attached is what gets the user a line number rather than
// just a module name.
//
// Pass the *head term* of a declaration, not the whole group: a group built by
// a template carries the template's location, and the head still carries the
// user's.
fun hol_error(who :: Symbol, message :: String, at :: Syntax):
  rb.#{raise-syntax-error}(who, message, at)

// Re-raise a failure from the logical layer at the user's source location.
//
// The caught message already begins with its own `who: ` prefix, and
// `raise-syntax-error` adds one of its own taken from the form -- so the
// prefix has to be stripped or the reader sees `type: type: ...`.
fun hol_reraise(e :: Exn.Fail, at :: Syntax):
  rb.#{raise-syntax-error}(#false, strip_who(e.message), at)

fun strip_who(msg :: String) :~ String:
  match msg.find(": ")
  | #false: msg
  | i:
      let head = msg.substring(0 .. i)
      // Only a bare word is a `who` prefix; anything with a space in it is
      // already part of the message.
      (if head.contains(" ") || head.contains("\n")
       | msg
       | msg.substring((i + 2) .. msg.length()))

class HolState(thy :: Theory,
               db :: RuleDB,
               dts :: Map.of(Symbol, DatatypeThms),
               funs :: Map.of(Symbol, FunInfo),
               thms :: Map.of(Symbol, Thm),
               // declaration order, for diagnostics
               names :: List.of(Symbol),
               // `wfrec_rel`'s definition (`wfrec.rhm`'s `build_wfrec_rel`),
               // installed exactly once at the very start of the session so
               // every structurally derived `function` can share it --
               // `new_basic_definition` refuses a second declaration of the
               // same constant.
               wfrec_def :: Thm)

fun initial_state() :: HolState:
  // `wfrec_base_theory()`/`wfrec_base_def()` (`wfrec.rhm`) are memoized the
  // same way `bool.rhm`'s `base_theory()` is: `new_basic_definition` mints
  // a fresh `Stamp` on every call, so calling `build_wfrec_rel` fresh here
  // would give every module's `HolState.thy` an incomparable stamp,
  // breaking `adopt`'s check the moment one module imports another's state.
  let thy = infinity_base_theory()
  // Propositional cleanup is in the database from the start: without it a
  // finished proof can look stuck at `true and true`.
  let db = for values(d :~ RuleDB = empty_db) (th in tautologies(thy)):
             add_thm(thy, d, #'propositional, th)
  // The two `if` rules are separate so that `disable_rules [conditional]` can
  // turn them off without also losing propositional cleanup.
  let db = for values(d :~ RuleDB = db) (th in conditionals(thy)):
             add_thm(thy, d, #'conditional, th)
  HolState(thy, db, {}, {}, {}, [], wfrec_base_def())

fun declared_names(st :: HolState) :: List.of(Symbol):
  st.names

// The prover context for the state as it currently stands.
fun state_context(st :: HolState) :: Context:
  mk_context(st.thy, ~rules: st.db, ~datatypes: st.dts, ~functions: st.funs)

// -- type --------------------------------------------------------------------

fun add_type(st :: HolState, form :: Syntax, at :: Syntax) :: HolState:
  let spec = elab.parse_type_decl(form)
  // Non-recursive specs (no self-recursive fields) get a genuinely derived
  // `DatatypeThms` -- proved from `unit`/`prod`/`sum` via
  // `new_basic_type_definition`, with zero `new_axiom` calls -- rather than
  // see PLAN.md section 9.2.1.  A *self-recursive*
  // one is derived too, by carving it out of the labelled trees over `num`
  // (`datatype_rec.rhm`, PLAN.md 9.2 phase 3): its characterisation and its
  // observers are proved, and the one axiom they rest on -- infinity -- is in
  // the base theory once, not once per datatype.
  let (thy2, thms) = try:
                       (cond
                        | is_nonrecursive_spec(spec):
                            build_nonrecursive_datatype_thms(st.thy, spec)
                        | ~else:
                            // The two are exact complements -- a field is
                            // either the type itself or it is not -- so there
                            // is no third case and `datatype_axioms` is no
                            // longer on this path at all.  It survives only as
                            // the differential baseline the derivations are
                            // tested against.
                            build_recursive_datatype_thms(st.thy, spec,
                                                          infinity_base_ind()))
                       ~catch e :: Exn.Fail: hol_reraise(e, at)
  require_no_new_axioms(#'type, st.thy, thy2, spec.name, at)
  // Every equation the datatype brings -- injectivity, distinctness,
  // discriminators, selectors -- goes straight into the rule database, which
  // is what makes `match`-defined functions simplify.
  let db2 = for values(d :~ RuleDB = st.db) (th in datatype_rules(thms)):
              add_thm(thy2, d, spec.name, th)
  add_subterm_relation(
    HolState(thy2, db2, st.dts ++ {spec.name: thms}, st.funs, st.thms,
             st.names ++ [spec.name], st.wfrec_def),
    spec, at)

// Every recursive datatype brings its structural subterm relation with it, so
// that a `~measure` into it has an order to decrease in.  It is *derived*:
// `T_child` is a non-recursive predicate over the discriminators and
// selectors, `T_lt` is its transitive closure, and the constructor equations
// are proved from those two definitions (`subterm.rhm`, PLAN.md 9.29).  It
// used to be a clausal definition whose equations `install_function`
// postulated -- the last `new_axiom` a `type` declaration reached.  The
// equations join the rule database under their own name, so
// `disable_rules [Nat_lt]` reaches them without touching the datatype's own
// rules.
fun add_subterm_relation(st :: HolState, spec :: DatatypeSpec,
                         at :: Syntax) :: HolState:
  match subterm_spec(spec)
  | #false: st
  | fs:
      let fs :~ FunSpec = fs
      when const_type(st.thy, fs.name) != #false
      | hol_error(#'type,
                  "the name of this datatype's subterm relation, "
                    ++ to_string(fs.name)
                    ++ ", is already taken",
                  at)
      let dt :~ DatatypeThms = st.dts[spec.name]
      let (thy2, equations) = try:
                                derive_subterm_relation(st.thy, spec, dt)
                                ~catch e :: Exn.Fail: hol_reraise(e, at)
      require_no_new_axioms(#'type, st.thy, thy2, fs.name, at)
      require_closed_theorems(#'type, thy2, fs.name, equations, at)
      let self = mk_tyapp(spec.name, spec.params.map(fun (p :: Symbol):
                                                       mk_tyvar(p) :~ HType))
      // Not defined by recursion any more, so there is no descent to record.
      let info = FunInfo(fs, mk_const(fs.name, mk_fun(self, mk_fun(self, bool))),
                         equations, RecursionInfo([], #'none, [], []))
      let db2 = add_thms(thy2, st.db, fs.name, equations)
      HolState(thy2, db2, st.dts, st.funs ++ {fs.name: info}, st.thms,
               st.names ++ [fs.name], st.wfrec_def)

// -- function ----------------------------------------------------------------

// `function` never adds an axiom.  A definition it cannot derive is refused,
// naming what about the recursion the deriver could not handle, so that
// "this module compiled" and "this module assumed nothing new" are the same
// statement for the ordinary declaration form.
fun add_function(st :: HolState, form :: Syntax, at :: Syntax) :: HolState:
  install_declared_function(st, form, at, ~postulate: #false)

// `axiomatic_function` is the escape hatch, and it is a different word on
// purpose: a reader scanning a module can see which declarations extended
// the theory by assumption without knowing which recursion schemes this
// version happens to derive.
fun add_axiomatic_function(st :: HolState, form :: Syntax,
                           at :: Syntax) :: HolState:
  install_declared_function(st, form, at, ~postulate: #true)

fun install_declared_function(st :: HolState, form :: Syntax, at :: Syntax,
                              ~postulate: postulate :: Boolean) :: HolState:
  let spec :~ FunSpec = try:
                          elab.parse_function_decl(st.thy, form)
                          ~catch e :: Exn.Fail: hol_reraise(e, at)
  let dt_specs = for values(m :~ Map = {}) ((n, thms) in st.dts):
                   m ++ {n: (thms :~ DatatypeThms).spec}
  try:
    check_function_spec(st.thy, spec, dt_specs)
    ~catch e :: Exn.Fail: hol_reraise(e, at)
  // A definition that does not recurse is *defined* from its decision tree
  // (`funcases.rhm`).  One that does gets a genuine `WFREC` derivation
  // (`stepfn.rhm`) whenever an order can be built: structural descent in one
  // column, several arguments over their tuple, a lexicographic product of
  // several columns, or an explicit `~measure`.  What is left over --- a
  // recursion scheme with no such order --- is refused here, and reaches
  // `install_function`'s postulating seam only through
  // `axiomatic_function`.
  let arity = spec.arg_types.length()
  let derivable:
    cond
    | arity == 0: #false
    | ~else:
        let fn_ph = mk_const(spec.name, fun_type(spec))
        let measure:
          match spec.measure
          | #false: #false
          | m: Measure(m :~ Term, discharger(st))
        let recinfo = try:
                        check_termination(#'function, spec.name, arity,
                                          spec.clauses.map(fun (cl :: DefClause): [cl.pats, clause_terms(cl)]),
                                          fn_ph,
                                          ~measure: measure)
                        ~catch e :: Exn.Fail: hol_reraise(e, at)
        // The same tree `check_function_spec` just checked, kept this time:
        // `stepfn.rhm` builds `H` and its congruence proof from it, so the
        // logical and executable readings of the patterns cannot drift.
        let tree = try:
                     function_decision_tree(#'function, spec, dt_specs)
                     ~catch e :: Exn.Fail: hol_reraise(e, at)
        cond
        | !can_derive_structurally(spec, recinfo, tree, st.dts): #false
        | ~else:
            // `can_derive_structurally` has already checked that every type
            // the order compares in is a declared datatype at its own
            // schematic self type; what is left is that each one's subterm
            // relation was actually installed, which it is for every
            // datatype `add_type` declared.
            //
            // The types the order compares in: the measure's result type
            // for a `~measure`, the descending column's for structural
            // descent, and every ordered column's when the descent is
            // lexicographic.  Each one needs its subterm relation to have
            // been installed -- true of every *recursive* datatype
            // `add_type` declared, and of no other -- so a definition over
            // a non-recursive datatype has no order here and takes the
            // definitional path instead.
            let order_tys:
              cond
              | spec.measure: [measure_result_type(spec)]
              | ~else:
                  match descent_column(spec, fn_ph,
                                       ~usable: fun (ty :: HType):
                                                  declared_datatype(st, ty))
                  | k :: Int: [spec.arg_types[k]]
                  | ~else:
                      match lex_descent_columns(spec, fn_ph, st.dts)
                      | ks :: List: for List (k in ks): spec.arg_types[k]
                      | ~else: #false
            cond
            | !order_tys: #false
            | !(for all (ty in order_tys :~ List): has_subterm_relation(st, ty)):
                #false
            | ~else:
                let tyname = (match (order_tys :~ List)[0] | TyApp(n, _): n)
                [st.dts[tyname] :~ DatatypeThms, all_subterm_equations(st),
                 recinfo, tree]
  // Refused here rather than inside the `try` below: this is not a failure
  // of the logical layer to be re-raised, it is this declaration form saying
  // no.
  unless postulate || derivable || nonrecursive_function(st, spec)
  | hol_error(#'function,
              "the termination analysis succeeded, but this version has no "
                ++ "proof-producing definition compiler for this recursion "
                ++ "scheme: " ++ undecidable_reason(st, spec)
                ++ "; write `axiomatic_function` to postulate the equations "
                ++ "instead",
              at)
  let (thy2, info0) = try:
                        match derivable
                        | [thms, t_lt_equations, recinfo, tree]:
                            install_structural_function(st.thy, st.wfrec_def, spec,
                                                        thms :~ DatatypeThms,
                                                        st.dts,
                                                        tree :~ DecisionTree,
                                                        t_lt_equations :~ List.of(Thm),
                                                        recinfo :~ RecursionInfo,
                                                        algebra_base_thms())
                        | #false:
                            // A function that does not call itself has
                            // nothing to justify: its decision tree is
                            // already a closed term, so it is *defined* and
                            // its clausal equations are proved
                            // (`funcases.rhm`).  Only recursion the deriver
                            // cannot handle still reaches the postulating
                            // seam.
                            cond
                            | nonrecursive_function(st, spec):
                                let tree = function_decision_tree(#'function,
                                                                  spec,
                                                                  dt_specs)
                                let (t, info, _) = define_by_cases(st.thy, spec,
                                                                   tree, st.dts)
                                values(t, info)
                            | ~else:
                                // Only reachable under `postulate`: the
                                // refusal above has already run.
                                install_function(st.thy, spec, dt_specs,
                                                 ~discharge: discharger(st))
                        ~catch e :: Exn.Fail: hol_reraise(e, at)
  let info :~ FunInfo = info0
  // `function` claims to add no axiom, so it is checked -- unconditionally,
  // because every branch it can take is a derivation now.  Only
  // `axiomatic_function` is exempt, and that is the whole difference between
  // the two forms.
  unless postulate
  | require_no_new_axioms(#'function, st.thy, thy2, spec.name, at)
    require_closed_theorems(#'function, thy2, spec.name, info.equations, at)
  // The defining equations become rewrite rules straight away: that is what
  // makes a `match`-defined function compute during simplification.
  let db2 = add_thms(thy2, st.db, spec.name, info.equations)
  HolState(thy2, db2, st.dts, st.funs ++ {spec.name: info}, st.thms,
           st.names ++ [spec.name], st.wfrec_def)

// Why the deriver could not take this definition, as a phrase to finish
// "no proof-producing definition compiler for this recursion scheme: ...".
// Guessing is not good enough here: the difference between "give it a
// `~measure`" and "this type is not one I can recurse in" is the difference
// between a fixable declaration and one that has to wait for the compiler.
fun undecidable_reason(st :: HolState, spec :: FunSpec) :: String:
  let fn_ph = mk_const(spec.name, fun_type(spec))
  let undeclared = for values(acc :~ List = []) (ty in spec.arg_types):
                     if has_subterm_relation(st, ty :~ HType)
                     | acc
                     | acc ++ [type_to_string(ty :~ HType)]
  cond
  | spec.measure:
      "the measure lands in "
        ++ type_to_string(measure_result_type(spec))
        ++ ", which is not a recursive datatype declared here"
  | !no_nested_calls(spec, fn_ph):
      "a recursive call appears inside another recursive call's arguments"
  | undeclared.length() == spec.arg_types.length():
      "no argument type is a recursive datatype declared here (saw "
        ++ String.join(undeclared, ", ") ++ ")"
  | ~else:
      "no argument column descends at every call, and no lexicographic "
        ++ "order over the columns whose types are recursive datatypes "
        ++ "declared here settles them either"

// A type this module declared as a datatype, at its own schematic self type.
fun declared_datatype(st :: HolState, ty :: HType) :: Boolean:
  match ty
  | TyApp(n, _): st.dts.get(n, #false) != #false
  | ~else: #false

// A path that claims to derive must not have added an axiom.  Every
// declaration below that is documented as derived runs through this, so the
// claim is checked at each one rather than resting on the reader following
// the construction.  It costs a length comparison.
//
// This is the check that would have caught the `type` declaration quietly
// falling back to the axiom schema, and it is why the fallback's removal is
// something the compiler enforces rather than something a comment asserts.
fun require_no_new_axioms(who :: Symbol, before :: Theory, after :: Theory,
                          what :: Symbol, at :: Syntax) :: Void:
  // Three things, because "added no axiom" on its own is not the whole
  // claim and each of the other two is a different way to break it while
  // satisfying the count.
  //
  // The theory has to be an *extension* of the one we started from: a
  // declaration that returned a theory off to the side would pass an axiom
  // count and be unusable with everything already proved.
  unless descends(before.stamp, after.stamp)
  | hol_error(who,
              "a derived declaration did not extend the theory it was given: "
                ++ to_string(what),
              at)
  let n0 = axioms_of(before).length()
  let n1 = axioms_of(after).length()
  unless n1 == n0
  | hol_error(who,
              "a derived declaration introduced "
                ++ to_string(n1 - n0)
                ++ " new axiom(s): " ++ to_string(what),
              at)

// And the theorems it hands back have to be theorems *of* that theory, with
// nothing left assumed.  An equation with an undischarged hypothesis costs
// no axiom and is not the equation it looks like: registered as a rewrite
// rule, it would rewrite unconditionally on the strength of something never
// proved.
fun require_closed_theorems(who :: Symbol, thy :: Theory,
                            what :: Symbol, equations :: List.of(Thm),
                            at :: Syntax) :: Void:
  for (th in equations):
    let th :~ Thm = th
    unless hyps_of(th).length() == 0
    | hol_error(who,
                "a derived declaration produced an equation with "
                  ++ to_string(hyps_of(th).length())
                  ++ " undischarged hypothesis(es): " ++ to_string(what),
                at)
    unless descends(stamp_of(th), thy.stamp)
    | hol_error(who,
                "a derived declaration produced an equation from another "
                  ++ "theory: " ++ to_string(what),
                at)

// A declared datatype whose subterm relation was actually installed, which
// is every recursive one and no other.
fun has_subterm_relation(st :: HolState, ty :: HType) :: Boolean:
  match ty
  | TyApp(n, _):
      st.dts.get(n, #false) != #false
        && st.funs.get(subterm_relation_name(n), #false) != #false
  | ~else: #false

// Every declared datatype's subterm-relation equations, together.  A
// lexicographic order compares in more than one datatype, and the extra
// equations are harmless where it compares in only one: they are rewrite
// rules about relations the definition never mentions.
fun all_subterm_equations(st :: HolState) :: List.of(Thm):
  for values(acc :~ List = []) ((n, _) in st.dts):
    match st.funs.get(subterm_relation_name(n), #false)
    | #false: acc
    | info: acc ++ (info :~ FunInfo).equations

// No clause's right-hand side mentions the function being declared, so there
// is no recursion to justify -- whatever the patterns look like.
fun nonrecursive_function(st :: HolState, spec :: FunSpec) :: Boolean:
  let fn = mk_const(spec.name, fun_type(spec))
  let recurses = for any (cl in spec.clauses):
                   mentions(fn, (cl :~ DefClause).rhs)
  !recurses && !spec.measure

// Discharge a termination obligation against the state as it stands -- which
// is to say, without the function being defined.  That is not a limitation to
// work around but the point: a measure that needed the definition it justifies
// would justify nothing.
fun discharger(st :: HolState) :: Function:
  fun (obligation :: Term) :: values(maybe(Thm), maybe(String)):
    let (th, node) = prove(state_context(st), obligation)
    match th
    | #false: values(#false, residue_message(#'measure, node))
    | proved :~ Thm: values(proved, #false)

// -- theorem -----------------------------------------------------------------

// `attrs` arrive as keywords -- `~rewrite_rule` reads as `#:rewrite_rule` --
// so they are normalised to symbols here rather than at every use.
fun add_theorem(st :: HolState, name :: Symbol, attr_kws :: List,
                stmt :: Syntax, tactic :: maybe(Syntax),
                at :: Syntax) :: HolState:
  let attrs = attr_kws.map(fun (k): Symbol.from_string(to_string(k)))
  let (statement, names) = try:
                             elab.parse_theorem_statement(st.thy, stmt)
                             ~catch e :: Exn.Fail: hol_reraise(e, at)
  let [induct, using_names, do_not_names, in_theory_names, case_stxs,
       search_steps] = elab.parse_tactic(tactic)
  // `~using:` adds named theorems for this proof only, and overrides
  // `disable_rules`: an explicit request beats a blanket one.
  let db0 = for values(d :~ RuleDB = st.db) (u in (using_names :~ List)):
              match st.thms.get(u, #false)
              | #false:
                  hol_error(#'proof, "no such theorem to use: " ++ to_string(u), at)
              | th:
                  // `add_thm` does not touch `disabled`, so registering the
                  // theorem was not enough to override a module-level
                  // `disable_rules` -- the comment above claimed an override
                  // the code did not perform.  Enable it explicitly.
                  enable(add_thm(st.thy, d, u :~ Symbol, th :~ Thm),
                         [u :~ Symbol])
  // `~in_theory:` disables further rules for this proof only, on top of the
  // module's own `disable_rules`; it never re-enables one `disable_rules`
  // already turned off, since the module-level rules are already baked into
  // `st.db` by the time this runs.
  let db = disable(db0, in_theory_names :~ List)
  let ctx = mk_context(st.thy, ~rules: db, ~datatypes: st.dts,
                       ~functions: st.funs)
  let do_not = for values(acc :~ Set = Set()) (d in (do_not_names :~ List)):
                 acc ++ {d :~ Symbol}
  // `~cases:` terms are parsed against the theorem's own leading-binder
  // variables, the same ones the statement itself was parsed with -- so a
  // case term can name `xs` when the theorem reads `forall (xs :: ...): ...`.
  let cases:
    match case_stxs :~ List
    | []: []
    | _:
        let (vars, _) = strip_forall_all(statement, names)
        let tyvars = elab.collect_type_vars(stmt)
        let env = for values(m :~ Map = {}) (v in vars):
                    m ++ {(v :~ FVar).name: v :~ Term}
        for List (c in case_stxs :~ List):
          try:
            elab.parse_prop(st.thy, tyvars, env, c :~ Syntax)
            ~catch e :: Exn.Fail: hol_reraise(e, at)
  // A budget the proof asked for, or the default.  Nested searches still
  // join it rather than opening one of their own -- that is what makes the
  // number mean anything -- so this raises the ceiling for the whole proof,
  // side conditions included.
  let limits :~ SearchLimits:
    match search_steps
    | #false: SearchLimits()
    | n: SearchLimits(n :~ NonnegInt)
  // Reported at the `theorem`, like every other failure of this
  // declaration: running out of budget is something one proof did, and the
  // reader needs to know which.
  let (th, node) = try:
                     prove(ctx, statement, ~names: names,
                           ~induct: (induct :~ maybe(Symbol)),
                           ~do_not: do_not,
                           ~cases: cases,
                           ~limits: limits)
                     ~catch e :: Exn.Fail: hol_reraise(e, at)
  match th
  | #false: hol_error(#'theorem, residue_message(name, node), at)
  | proved :~ Thm:
      let db2 = (cond
                 | attrs.contains(#'rewrite_rule) || attrs.contains(#'simp):
                     add_thm(st.thy, st.db, name, proved)
                 | ~else: st.db)
      HolState(st.thy, db2, st.dts, st.funs, st.thms ++ {name: proved},
               st.names ++ [name], st.wfrec_def)

// -- adopting an imported theory ----------------------------------------------

// Adopt an imported theory wholesale.
//
// The imported state arrives as a live value: the same `Theory`, the same
// `Thm` objects, the same rule database.  Nothing is re-parsed and nothing is
// re-asserted, so there is no trust boundary here at all -- a `Thm` cannot be
// fabricated without the kernel, which is what its being opaque is for.  A
// description of a theory, by contrast, is data, and anything can write one.
//
// The single check is that the imported theory really extends the current one.
// That is not bureaucracy: `combine_stamps` refuses to mix theorems from two
// theories neither of which extends the other, so a module that adopted a
// sibling would be left holding two sets of theorems it could not use
// together.  Keeping the lineage a chain is what makes this a comparison
// rather than a theory merge.
fun adopt(st :: HolState, imported :: HolState, at :: Syntax) :: HolState:
  unless st.thy.stamp == imported.thy.stamp
           || descends(st.thy.stamp, imported.thy.stamp)
  | hol_error(#'import,
              "this theory does not extend the one in scope; an `import` of a "
                ++ "theory must come before the module's own declarations, "
                ++ "and several of them must be given in dependency order",
              at)
  // A rule switched off before the import stays off after it.
  let off = for values(acc :~ List = []) (n in st.db.disabled): acc ++ [n]
  HolState(imported.thy, disable(imported.db, off),
           imported.dts, imported.funs, imported.thms, imported.names,
           imported.wfrec_def)

// -- rule control ------------------------------------------------------------

fun set_rules(st :: HolState, on :: Boolean,
              names :: List.of(Symbol)) :: HolState:
  let db2 = (if on | enable(st.db, names) | disable(st.db, names))
  HolState(st.thy, db2, st.dts, st.funs, st.thms, st.names, st.wfrec_def)

fun datatype_rules(thms :: DatatypeThms) :: List.of(Thm):
  let inj = for values(acc :~ List = []) ((_, th) in thms.injectivity): acc ++ [th]
  inj ++ thms.distinctness ++ thms.discriminators ++ thms.selectors

// -- test hooks --------------------------------------------------------------
//
// `declare` and `expect` are not part of the language the specification
// describes; they exist so that the state threading can be tested directly,
// which is worth having because everything else depends on it.

fun note_decl(st :: HolState, n :: Symbol) :: HolState:
  HolState(st.thy, st.db, st.dts, st.funs, st.thms, st.names ++ [n], st.wfrec_def)

fun expect_declared(st :: HolState, expected :: List.of(Symbol),
                    ~at: at :: Syntax) :: HolState:
  unless st.names == expected
  | hol_error(#'expect,
              "declarations do not match\n  expected: " ++ to_string(expected)
                ++ "\n  got: " ++ to_string(st.names),
              at)
  st
