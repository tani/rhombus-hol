#lang rhombus/static

// Reading the surface syntax into the logical world.
//
// This module only *analyses*: syntax in, kernel-level data out.  It builds no
// templates, because a syntax template created at phase 0 loses its bindings
// on the way out of a phase-1 macro -- `'def x = 1'` written here and returned
// from a macro reports `def: unbound identifier`.  Emission therefore lives in
// `module_block.rhm`; see the note at the top of `expand.rhm`.
//
// Everything here is called twice: once at expansion time, so that the runtime
// code can be generated, and once at phase 1, so that the logical declaration
// can be made.  Both go through the same functions on the same syntax, so the
// two views of a declaration cannot drift apart.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  "datatype.rhm" open
  "recdef.rhm" open
  "bool.rhm" open
  "tyunify.rhm" open

export:
  parse_type
  parse_type_decl
  type_decl_shape
  decl_name
  syntax_error

// `~a` reads as the keyword `#:a`; the logical side wants the plain symbol.
fun keyword_symbol(k :: Syntax) :: Symbol:
  Symbol.from_string(to_string(Syntax.unwrap(k)))

fun syntax_error(who :: Symbol, message :: String, at :: Syntax):
  error(~who: who, message, error.val(~label: "in", to_string(at)))

// -- types -------------------------------------------------------------------
//
// A type variable is written `~a`, which shrubbery reads as the keyword
// `#:a`.  The specification writes `'a`, but `'` opens a syntax literal, so
// `type List('a)` cannot be lexed at all.

fun parse_type(stx :: Syntax, params :: List.of(Symbol)) :: HType:
  match stx
  | '$(k :: Keyword)':
      let n = keyword_symbol(k)
      unless params.contains(n)
      | syntax_error(#'type, "unbound type variable", stx)
      mk_tyvar(n)
  | '$(id :: Identifier)($arg, ...)':
      mk_tyapp(Syntax.unwrap(id),
               [parse_type(arg, params), ...])
  | 'Boolean':
      // Spelled as Rhombus spells it: a function's parameter annotations are
      // erased on the way to the executable half, but its `if` conditions are
      // not, so the two halves have to agree on what a Boolean is.
      bool
  | '$(id :: Identifier)':
      mk_tyapp(Syntax.unwrap(id), [])
  | ~else:
      syntax_error(#'type, "not a type", stx)

// -- datatype declarations ---------------------------------------------------

// The name a declaration introduces, for diagnostics and ordering.
fun decl_name(stx :: Syntax) :: Symbol:
  match stx
  | 'type $(id :: Identifier) $_ ...': Syntax.unwrap(id)
  | 'function $(id :: Identifier) $_ ...': Syntax.unwrap(id)
  | ~else: #'unknown

fun parse_type_decl(stx :: Syntax) :: DatatypeSpec:
  match stx
  | 'type $(name :: Identifier)($param, ...)
     | $ctor
     | ...':
      let params = [parse_param(param), ...]
      DatatypeSpec(Syntax.unwrap(name), params,
                   [parse_ctor(ctor, params), ...])
  | 'type $(name :: Identifier)
     | $ctor
     | ...':
      DatatypeSpec(Syntax.unwrap(name), [], [parse_ctor(ctor, []), ...])
  | ~else:
      syntax_error(#'type, "malformed datatype declaration", stx)

fun parse_param(stx :: Syntax) :: Symbol:
  match stx
  | '$(k :: Keyword)': keyword_symbol(k)
  | ~else:
      syntax_error(#'type,
                   "a type parameter is written `~a`, not a plain name", stx)

fun parse_ctor(stx :: Syntax, params :: List.of(Symbol)) :: Ctor:
  match stx
  | '$(name :: Identifier)($field, ...)':
      Ctor(Syntax.unwrap(name), [parse_field(field, params), ...])
  | '$(name :: Identifier)':
      Ctor(Syntax.unwrap(name), [])
  | ~else:
      syntax_error(#'type, "malformed constructor", stx)

fun parse_field(stx :: Syntax, params :: List.of(Symbol)) :: Field:
  match stx
  | '$(name :: Identifier) :: $ty ...':
      Field(Syntax.unwrap(name), parse_type('$ty ...', params))
  | ~else:
      syntax_error(#'type,
                   "a constructor field needs a name and a type", stx)

// The identifiers a datatype declaration introduces, as syntax rather than as
// symbols: `[name, [[ctor, [field, ...]], ...]]`.
//
// Emission needs the user's own identifiers, not reconstructed ones.  A name
// built with `Syntax.make_id` would carry the macro's scopes, and then a
// `Cons(...)` the user writes would not refer to the class we generated.
fun type_decl_shape(stx :: Syntax) :: List:
  fun ctor_shape(c :: Syntax) :: List:
    match c
    | '$(name :: Identifier)($field, ...)': [name, [field_name(field), ...]]
    | '$(name :: Identifier)': [name, []]
    | ~else: syntax_error(#'type, "malformed constructor", c)
  fun field_name(f :: Syntax) :: Syntax:
    match f
    | '$(name :: Identifier) :: $_ ...': name
    | ~else: syntax_error(#'type, "malformed constructor field", f)
  match stx
  | 'type $(name :: Identifier)($_, ...)
     | $ctor
     | ...':
      [name, [ctor_shape(ctor), ...]]
  | 'type $(name :: Identifier)
     | $ctor
     | ...':
      [name, [ctor_shape(ctor), ...]]
  | ~else: syntax_error(#'type, "malformed datatype declaration", stx)

// ============================================================================
// Function declarations
// ============================================================================
//
// The admissible shape is exactly what `recdef.rhm` can install:
//
//   function f(p1 :: T1, ..., pn :: Tn) :: T:
//     match pi
//     | C(v, ...): <expr>
//     | ...
//
// possibly with nested `match`es on further arguments, or a single-clause body
// with no `match` at all.
//
// The keyword is `function`, not `fun`.  Intercepting `fun` would mean deciding
// from the shape alone whether an ordinary Rhombus definition was meant to be a
// logical one -- and getting that wrong silently strips its annotations.  With
// a separate keyword the intent is explicit, so anything outside the grammar is
// an error naming the offending expression rather than a silent pass-through.

export:
  function_decl_shape
  body_clauses
  row_parts
  parse_function_decl

// A declaration split into its parts: `[name, [param, ...], result_type,
// measure_or_false, body]`.  One matcher, used by both halves -- the executable
// code generator wants the names and the body, the logical elaborator wants the
// types and the measure, and neither should re-parse the declaration for
// itself.
//
// Raises, with the offending syntax, when the declaration is not one this
// version can admit.
fun function_parts(stx :: Syntax) :: List:
  match stx
  | 'function $(name :: Identifier)($param, ...) $rest ...':
      let [rty, measure, body] = split_signature('$rest ...', stx)
      [name, [param, ...], rty, measure, body]
  | ~else:
      syntax_error(#'function,
                   "expected `function name(param :: Type, ...) :: Type: body`",
                   stx)

// `:: Type: body`, or `:: Type ~measure(e): body`, or the clausal form
// `:: Type | (pat, ...): body | ...` -- see `clause_rows`.  The clausal form
// is returned as a body of the same shape everything downstream already
// reads, so only `parse_body` and the emitter have to know about it.
fun split_signature(rest :: Syntax, at :: Syntax) :: List:
  match rest
  | ':: $ty ... ~measure($m): $body; ...': ['$ty ...', m, '$body; ...']
  | ':: $ty ...: $body; ...': ['$ty ...', #false, '$body; ...']
  | ':: $ty ... ~measure($m)
     | $c
     | ...': ['$ty ...', m, clause_body([c, ...])]
  | ':: $ty ...
     | $c
     | ...': ['$ty ...', #false, clause_body([c, ...])]
  | ~else:
      syntax_error(#'function, "a function needs a result type", at)

// The clausal form's body, tagged so `parse_body` can tell it from an
// ordinary expression body.  Keeping it a `Syntax` rather than a separate
// field means `function_parts`, `fun_signature` and the measure path are
// untouched.
fun clause_body(cs :: List.of(Syntax)) :: Syntax:
  let [c, ...] = cs
  '#%hol_clauses:
     $c
     ...'

// The clauses back out of that shape, for the emitter.  `#false` when the
// body is an ordinary expression body.
fun body_clauses(body :: Syntax) :: maybe(List.of(Syntax)):
  match body
  | '#%hol_clauses: $c; ...': [c, ...]
  | ~else: #false

// `[name, [param, ...], body]`, the executable half's view.
fun function_decl_shape(stx :: Syntax) :: List:
  let [name, params, _, _, body] = function_parts(stx)
  let ps :~ List = params
  [name, ps.map(param_name), body]

fun param_name(p :: Syntax) :: Syntax:
  match p
  | '$(n :: Identifier) :: $_ ...': n
  | ~else:
      syntax_error(#'function,
                   "a parameter needs a name and a type", p)

// -- the logical meaning -----------------------------------------------------

// Signature pieces: `[name, [[param_id, HType], ...], HType]`.
fun fun_signature(parts :: List, params :: List.of(Symbol)) :: List:
  let [name, ps, rty, _, _] = parts
  [Syntax.unwrap(name :~ Syntax),
   (ps :~ List).map(fun (p :: Syntax): param_binding(p, params)),
   parse_type(rty :~ Syntax, params)]

fun param_binding(p :: Syntax, params :: List.of(Symbol)) :: List:
  match p
  | '$(n :: Identifier) :: $ty ...': [Syntax.unwrap(n), parse_type('$ty ...', params)]
  | ~else: syntax_error(#'function, "a parameter needs a name and a type", p)

// The type variables a declaration mentions, so that `~a` resolves.  A
// function is implicitly polymorphic in every type variable it uses.
//
// Scanning the unwrapped datum rather than the syntax keeps this to one short
// walk: `~a` is a keyword wherever it appears.
fun collect_type_vars(stx :: Syntax) :: List.of(Symbol):
  fun walk(d, acc :~ List) :~ List:
    cond
    | d is_a Keyword:
        let n = Symbol.from_string(to_string(d))
        (if acc.contains(n) | acc | acc ++ [n])
    | d is_a List:
        let items :~ List = d
        for values(a :~ List = acc) (i in items): walk(i, a)
    | ~else: acc
  walk(Syntax.unwrap_all(stx), [])

// -- expressions -------------------------------------------------------------

// The instance of a constant's generic type at which it is being applied.
fun const_instance(thy :: Theory, name :: Symbol,
                   args :: List.of(Term), at :: Syntax) :: HType:
  let gty = (match const_type(thy, name)
             | #false: syntax_error(#'function, "unknown constant", at)
             | t: t)
  let res = mk_tyvar(#'_result)
  let want = for values(ty :~ HType = res) (a in args.reverse()):
               mk_fun(type_of(a), ty)
  match type_unify(gty, want, {})
  | #false:
      syntax_error(#'function, "constant is applied at a type it does not have", at)
  | sub: type_subst(sub, gty)

// A function body is read by the same precedence parser as a proposition,
// in `#'expr` mode.  One parser, because the alternative -- a second,
// simpler walker for bodies -- is what let `if` be a special case here and
// not there.
//
// The spellings differ between the modes and that is deliberate.  A body is
// emitted as Rhombus *verbatim*, so every operator a body may use has to
// already mean the right thing in Rhombus: `&&`, `||`, `!`, `==`, `#true`,
// `#false`, `if`.  A proposition is never emitted, so it uses the logical
// spellings `and`, `or`, `not`, `===`.
fun elab_expr(thy :: Theory, self_name :: Symbol, self :: Term,
              env :: Map.of(Symbol, Term), e :: Syntax) :: Term:
  parse_group(PEnv(thy, [], env, #'expr, self_name, self), e)

// -- clauses -----------------------------------------------------------------

// `C(v, ...)` as a pattern term, plus the variables it binds, at the type
// the scrutinee actually has.  Each `v` is a bare identifier (a fresh
// variable, as ever) or itself `SubC(...)` -- a nested constructor
// pattern written directly in the clause head (`Cons(x, Nil())`), parsed
// the same recursive way, at that field's own type.  This is a second,
// independent route to a nested pattern beside a separate nested `match`
// statement in the body (`parse_body`'s `matched_var`/`refine_pats`) --
// both build the same kind of nested `Term`, and neither the coverage
// checker nor the termination checker cares which surface form produced
// it.
fun ctor_pattern(thy :: Theory, cname :: Symbol, vids :: List.of(Syntax),
                 scrut_ty :: HType, at :: Syntax) :: values(Term, List.of(FVar)):
  let gty = (match const_type(thy, cname)
             | #false: syntax_error(#'function, "unknown constructor", at)
             | t: t)
  let (doms, res) = peel_fun(gty, vids.length())
  let tyin = (match type_match(res, scrut_ty, {})
              | #false:
                  syntax_error(#'function,
                               "constructor does not build the matched type", at)
              | m: m)
  let field_tys = doms.map(fun (d :: HType): type_subst(tyin, d))
  let parsed = for List (v in vids, ty in field_tys):
                 parse_sub_pattern(thy, v, ty :~ HType)
  let subpats = parsed.map(fun (pr :: List): pr[0] :~ Term)
  let bound = for values(acc :~ List = []) (pr in parsed):
                acc ++ (pr :~ List)[1]
  values(list_mk_comb(mk_const(cname, type_subst(tyin, gty)), subpats),
         bound)

// One constructor-argument position: `_` (a position the clause does not
// name), a bare identifier (a fresh variable), or `SubC(sv, ...)` -- a
// further nested pattern, recursing into `ctor_pattern` at `SubC`'s own
// matched type.
//
// `_` is a fresh variable under a name nothing can write, so every layer
// below -- coverage, termination, the step-function compiler -- goes on
// seeing exactly the variable pattern it already understands.  Two `_`s in
// one row must be distinct variables (patterns bind distinct names), which
// `genvar` gives for free.
def wildcard_counter :: Box = Box(0)

// A pattern variable under a name no source text can write, so nothing can
// refer to what `_` matched.
fun fresh_wildcard(ty :: HType) :: FVar:
  let n = wildcard_counter.value
  wildcard_counter.value := n + 1
  mk_var(Symbol.from_string("_ %" ++ to_string(n)), ty)

fun parse_sub_pattern(thy :: Theory, v :: Syntax,
                      ty :: HType) :: List:
  match v
  | '_':
      let fv = fresh_wildcard(ty)
      [fv :~ Term, [fv]]
  | '$(n :: Identifier)($sv, ...)':
      let (pat, bound) = ctor_pattern(thy, Syntax.unwrap(n), [sv, ...], ty, v)
      [pat, bound]
  | '$(n :: Identifier)':
      let fv = mk_var(Syntax.unwrap(n), ty)
      [fv :~ Term, [fv]]
  | ~else:
      syntax_error(#'function, "malformed pattern", v)

fun peel_fun(ty :: HType, n :: Int) :: values(List.of(HType), HType):
  recur loop (ty :~ HType = ty, k = n, acc :~ List = []):
    cond
    | k == 0: values(acc, ty)
    | ~else:
        let (d, r) = dest_fun(ty)
        loop(r, k - 1, acc ++ [d])

fun parse_function_decl(thy :: Theory, stx :: Syntax) :: FunSpec:
  let tyvars = collect_type_vars(stx)
  let parts = function_parts(stx)
  let [_, _, _, measure_stx, body] = parts
  let [name0, bindings0, rty0] = fun_signature(parts, tyvars)
  let name :~ Symbol = name0
  let bindings :~ List = bindings0
  let rty :~ HType = rty0
  let arg_tys :~ List = bindings.map(fun (b :: List): b[1] :~ HType)
  let fty = for values(t :~ HType = rty) (a in arg_tys.reverse()): mk_fun(a, t)
  let self = mk_const(name, fty)
  let pvars = for List (b in bindings): mk_var((b :~ List)[0], (b :~ List)[1])
  let env0 = for values(m :~ Map = {}) (v in pvars): m ++ {(v :~ FVar).name: v}
  // The measure sees the parameters and nothing else, and it must not mention
  // the function being defined: it is what justifies the definition, so it
  // cannot depend on it.
  let measure:
    match measure_stx
    | #false: #false
    | ms:
        let e = parse_group(PEnv(thy, tyvars, env0, #'expr, #false, #false),
                            ms :~ Syntax)
        list_mk_abs(pvars, e)
  let clauses = parse_body(thy, name, self,
                           pvars.map(fun (v :: FVar): v :~ Term),
                           env0, body :~ Syntax, stx)
  FunSpec(name, arg_tys, rty, clauses, measure)

// A body, as the clauses it stands for.
//
// `match` may be nested to any depth, on any parameter or on a variable a
// prior pattern in the same clause already bound, and the nesting is
// flattened into a pattern matrix: `match m | zero(): ... | succ(p): match n
// | ...` becomes `[zero(), n]`, `[succ(p), zero()]`, `[succ(p), succ(q)]`;
// `match xs | Cons(x, rest): match rest | Nil(): ... | Cons(y, ys): ...`
// refines the *tail* of `Cons(x, rest)` in place, becoming `[Cons(x, Nil())]`,
// `[Cons(x, Cons(y, ys))]`.  That is what lets a definition descend on more
// than one argument, and into more than one level of a single argument --
// `check_coverage` (`recdef.rhm`) checks the whole tree for exhaustiveness
// and non-overlap, and the termination checker looks for a descending
// position anywhere in it.
//
// `pats` is the row built so far: initially the bare parameters, refined one
// position at a time -- possibly nested inside an earlier refinement -- as
// the matching descends.
fun parse_body(thy :: Theory, self_name :: Symbol, self :: Term,
               pats :: List.of(Term), env :: Map.of(Symbol, Term),
               body :: Syntax, at :: Syntax) :: List.of(DefClause):
  match body
  | '#%hol_clauses: $c; ...':
      clause_rows(thy, self_name, self, pats, env, [c, ...], at)
  | 'match $(sv :: Identifier)
     | $c
     | ...':
      let v = matched_var(env, pats, Syntax.unwrap(sv), body)
      let cs = [c, ...]
      for values(acc :~ List = []) (c in cs):
        acc ++ parse_clause(thy, self_name, self, pats, v, env, c, at)
  | 'let $(n :: Identifier) = $rhs ...
     $more; ...':
      // A multi-statement body's first statement must be `let name = expr`;
      // anything else there falls through to the generic `not_admitted`
      // error below, the same as any other unrecognised body shape.
      let v = elab_expr(thy, self_name, self, env, '$rhs ...')
      let env2 = env ++ {Syntax.unwrap(n): v}
      parse_body(thy, self_name, self, pats, env2, '$more; ...', at)
  | ~else:
      [DefClause(pats, elab_expr(thy, self_name, self, env, body))]

// The declaration-level clause matrix (review item 9): a row of patterns
// covering *every* argument at once, the way Rhombus's own multi-case `fun`
// is written, instead of a `match` on one argument with the rest destructured
// by nesting.
//
//   function app(xs :: List(~a), ys :: List(~a)) :: List(~a)
//   | (Nil(), ys): ys
//   | (Cons(x, rest), ys): Cons(x, app(rest, ys))
//
// This is sugar in the strict sense: a row refines the same `pats` vector the
// nested form refines, one column at a time, and produces the same
// `DefClause` rows.  Everything downstream -- the decision tree, the coverage
// and termination checks, the `WFREC` derivation -- sees no difference, which
// is why ordering, `_` and nested patterns work here for free.
fun clause_rows(thy :: Theory, self_name :: Symbol, self :: Term,
                pats :: List.of(Term), env :: Map.of(Symbol, Term),
                cs :: List.of(Syntax), at :: Syntax) :: List.of(DefClause):
  for values(acc :~ List = []) (c in cs):
    acc ++ clause_row(thy, self_name, self, pats, env, c, at)

fun clause_row(thy :: Theory, self_name :: Symbol, self :: Term,
               pats :: List.of(Term), env :: Map.of(Symbol, Term),
               c :: Syntax, at :: Syntax) :: List.of(DefClause):
  let (row, body) = row_parts(c, pats.length())
  // Left to right, so a later column's pattern sees the variables an earlier
  // one bound -- the same order the nested form reads in.
  let (pats2, env2):
    for values(ps :~ List = pats, e :~ Map = env) (col in List.iota(row.length())):
      let v :~ FVar:
        match ps[col]
        | FVar(_, _): ps[col]
        | ~else:
            syntax_error(#'function,
                         "this argument has already been matched",
                         (row :~ List)[col])
      let [pat, bound] = parse_sub_pattern(thy, (row :~ List)[col], v.ty)
      values(refine_pats(ps, v, pat :~ Term),
             for values(m :~ Map = e) (bv in bound :~ List):
               m ++ {(bv :~ FVar).name: bv :~ Term})
  parse_body(thy, self_name, self, pats2, env2, body, at)

// `(pat, ...): body`, or `pat: body` when there is exactly one argument.
fun row_parts(c :: Syntax, arity :: Int) :: values(List.of(Syntax), Syntax):
  match c
  | '($p, ...): $body; ...':
      let ps = [p, ...]
      unless ps.length() == arity
      | syntax_error(#'function,
                     "this clause has " ++ to_string(ps.length())
                       ++ " patterns but the function takes "
                       ++ to_string(arity),
                     c)
      values(ps, '$body; ...')
  | '$pt ...: $body; ...':
      let p = '$pt ...'
      // One argument may drop the parentheses, exactly as a one-argument
      // `match` clause does.
      unless arity == 1
      | syntax_error(#'function,
                     "this clause has 1 pattern but the function takes "
                       ++ to_string(arity),
                     c)
      values([p], '$body; ...')
  | ~else:
      syntax_error(#'function,
                   "expected `(pattern, ...): body`", c)

// The pattern variable a `match` refines: `n` must name something still a
// *live*, unrefined position somewhere in `pats` -- a top-level parameter
// not yet matched, or a variable an enclosing pattern in this same clause
// just bound.  Refusing anything else catches every way `n` could fail to
// denote a fresh scrutinee: unbound entirely, already matched (its own name
// lingers in `env` after refinement, since `env` only ever grows), or bound
// by `let` to a computed term rather than a pattern position (matching on a
// computed value has no constructor test to check exhaustively against).
//
// A pattern variable may shadow a parameter -- `function f(n)` with a clause
// `succ(n)` -- and without checking liveness in `pats` (not just presence in
// `env`) a nested `match n` after that would look like a fresh match on the
// now-inaccessible outer `n` and silently refine nothing.
fun matched_var(env :: Map.of(Symbol, Term), pats :: List.of(Term),
                n :: Symbol, at :: Syntax) :: FVar:
  match env.get(n, #false)
  | #false:
      syntax_error(#'function, "the matched name is not in scope", at)
  | v when !(v is_a FVar):
      syntax_error(#'function,
                   "this name is not a pattern variable to match on", at)
  | v0:
      let v :~ FVar = v0
      unless pattern_var_live(pats, v)
      | syntax_error(#'function,
                     "this argument has already been matched; a nested "
                       ++ "`match` must be on a still-unmatched variable",
                     at)
      v

// Whether `v` occurs, unrefined, somewhere in `pats`'s pattern trees.
fun pattern_var_live(pats :: List.of(Term), v :: FVar) :: Boolean:
  fun walk(t :: Term) :: Boolean:
    match t
    | FVar(_, _): t == (v :~ Term)
    | ~else:
        let (head, args) = strip_comb(t)
        match head
        | Const(_, _): for any (a in args): walk(a)
        | ~else: #false
  for any (p in pats): walk(p)

// `pats` with the one live occurrence of `v` replaced by `new_pat`.
fun refine_pats(pats :: List.of(Term), v :: FVar,
                new_pat :: Term) :: List.of(Term):
  fun walk(t :: Term) :: Term:
    match t
    | FVar(_, _): (if t == (v :~ Term) | new_pat | t)
    | ~else:
        let (head, args) = strip_comb(t)
        match head
        | Const(_, _): list_mk_comb(head, args.map(walk))
        | ~else: t
  pats.map(walk)

// One `match` clause.  `_: body` is the catch-all: it refines nothing, so
// the row keeps `v` as it stood and the decision tree treats it exactly as
// the variable pattern it is -- earlier clauses win wherever they match,
// and this one covers whatever is left.  That is the same reading the
// emitted Rhombus `match` gives the same text.
fun parse_clause(thy :: Theory, self_name :: Symbol, self :: Term,
                 pats :: List.of(Term), v :: FVar,
                 env0 :: Map.of(Symbol, Term), c :: Syntax,
                 at :: Syntax) :: List.of(DefClause):
  match c
  | '_: $body; ...':
      parse_body(thy, self_name, self, pats, env0, '$body; ...', at)
  | ~else:
      let (cname, vids, body) = clause_parts(c)
      let (pat, bound) = ctor_pattern(thy, cname, vids, v.ty, c)
      let env = for values(m :~ Map = env0) (bv in bound):
                  m ++ {(bv :~ FVar).name: bv :~ Term}
      let pats2 = refine_pats(pats, v, pat)
      parse_body(thy, self_name, self, pats2, env, body, at)

fun clause_parts(c :: Syntax) :: values(Symbol, List.of(Syntax), Syntax):
  match c
  | '$(cname :: Identifier)($v, ...): $body; ...':
      values(Syntax.unwrap(cname), [v, ...], '$body; ...')
  | '$(cname :: Identifier): $body; ...':
      values(Syntax.unwrap(cname), [], '$body; ...')
  | ~else: syntax_error(#'function, "malformed match clause", c)

// ============================================================================
// Propositions
// ============================================================================
//
// A hand-written precedence parser rather than a `space.enforest` space.
// Shrubbery does not know precedence -- it hands back a flat sequence of terms
// in a group -- so something has to climb precedences either way, and the
// proposition grammar is fixed and small.  What `space.enforest` would buy is
// user extensibility, which v0.1 does not need.
//
// The levels must match `printer.rhm`'s, or a residue printed for the user
// would not read back as the same proposition.

export:
  parse_prop
  parse_theorem_statement
  parse_tactic
  collect_type_vars

def prec_iff = 20
def prec_imp = 30
def prec_or = 40
def prec_and = 50
def prec_not = 60
def prec_eq = 70

// An infix connective: `[precedence, right_associative, build]`.
//
// Matched by literal pattern rather than by unwrapping: `Syntax.unwrap` on an
// operator term gives the tagged datum, not the operator's name.
//
// The two tables share their levels, so `a == b && c` and `a === b and c`
// group the same way.  The expression levels also agree with Rhombus's own,
// which they must: the body is emitted verbatim, so a disagreement would make
// the logical and the executable readings of one source differ.
fun infix_info(mode :: Symbol, t :: Syntax) :: maybe(List):
  cond
  | mode == #'prop:
      match t
      | '===': [prec_eq, #false, mk_eq]
      | '<=>': [prec_iff, #false, mk_eq]
      | '==>': [prec_imp, #true, mk_imp]
      | 'and': [prec_and, #false, mk_conj]
      | 'or': [prec_or, #false, mk_disj]
      | ~else: #false
  | ~else:
      match t
      | '==': [prec_eq, #false, mk_eq]
      | '&&': [prec_and, #false, mk_conj]
      | '||': [prec_or, #false, mk_disj]
      | ~else: #false

// `self_name` and `self` are the definition being elaborated, so that a
// recursive call resolves before the constant exists in the theory.  In
// `#'prop` mode there is no such definition and both are `#false`.
class PEnv(thy :: Theory,
           tyvars :: List.of(Symbol),
           vars :: Map.of(Symbol, Term),
           mode :: Symbol,
           self_name :: maybe(Symbol),
           self :: maybe(Term)):
  property who :: Symbol: (if mode == #'prop | #'theorem | #'function)

fun parse_prop(thy :: Theory, tyvars :: List.of(Symbol),
               vars :: Map.of(Symbol, Term), stx :: Syntax) :: Term:
  parse_group(PEnv(thy, tyvars, vars, #'prop, #false, #false), stx)

fun parse_group(env :: PEnv, stx :: Syntax) :: Term:
  let ts = group_terms(env, stx)
  let (t, rest) = parse_at(env, ts, 0)
  unless rest.length() == 0
  | syntax_error(env.who, "unexpected text after an expression", stx)
  t

fun sub_env(env :: PEnv, vars :: Map.of(Symbol, Term)) :: PEnv:
  PEnv(env.thy, env.tyvars, vars, env.mode, env.self_name, env.self)

fun group_terms(env :: PEnv, stx :: Syntax) :: List.of(Syntax):
  match stx
  | '$t ...': [t, ...]
  | ~else: syntax_error(env.who, not_admitted(env), stx)

fun parse_at(env :: PEnv, ts :: List.of(Syntax), min_prec :: Int)
     :: values(Term, List.of(Syntax)):
  let (left, rest) = parse_prefix(env, ts)
  climb(env, left, rest, min_prec)

fun climb(env :: PEnv, left :: Term, ts :: List.of(Syntax), min_prec :: Int)
     :: values(Term, List.of(Syntax)):
  match ts
  | []: values(left, ts)
  | List.cons(op, rest):
      match infix_info(env.mode, op)
      | #false: values(left, ts)
      | [prec, right_assoc, build]:
          let prec :~ Int = prec
          cond
          | prec < min_prec: values(left, ts)
          | ~else:
              let next_min = (if right_assoc | prec | prec + 1)
              let (right, rest2) = parse_at(env, rest, next_min)
              climb(env, build(left, right), rest2, min_prec)

fun parse_prefix(env :: PEnv, ts :: List.of(Syntax))
     :: values(Term, List.of(Syntax)):
  match ts
  | []: error(~who: env.who, "expression ended early")
  | List.cons(t, rest):
      match t
      | '#true': values(tm_true, rest)
      | '#false': values(tm_false, rest)
      | '!' when env.mode == #'expr:
          let (inner, rest2) = parse_at(env, rest, prec_not + 1)
          values(mk_neg(inner), rest2)
      | '$(id :: Identifier)':
          match Syntax.unwrap(id)
          | #'not when env.mode == #'prop:
              let (inner, rest2) = parse_at(env, rest, prec_not + 1)
              values(mk_neg(inner), rest2)
          | #'if: parse_conditional(env, ts)
          | #'cond: parse_cond(env, ts)
          | #'forall when env.mode == #'prop: parse_quantifier(env, #'forall, ts)
          | #'exists when env.mode == #'prop: parse_quantifier(env, #'exists, ts)
          | ~else: parse_application(env, t, rest)
      | ~else: parse_application(env, t, rest)

// `if c | a | b`.  The alternatives close the group, so like a quantifier this
// consumes everything that is left.
//
// Both branches are elaborated even though only one will run: `cond` is a
// total function of three arguments, and the termination checker reads the
// recursive calls out of both.
fun parse_conditional(env :: PEnv, ts :: List.of(Syntax))
     :: values(Term, List.of(Syntax)):
  let [t, ...] = ts
  let whole = '$t ...'
  match whole
  | 'if $c ...
     | $a; ...
     | $b; ...':
      let ct = parse_group(env, '$c ...')
      unless type_of(ct) == bool
      | syntax_error(env.who, "the condition of an `if` must be a Boolean",
                     '$c ...')
      let at = parse_group(env, '$a; ...')
      let bt = parse_group(env, '$b; ...')
      unless type_of(at) == type_of(bt)
      | syntax_error(env.who, "the two branches of an `if` have different types",
                     whole)
      values(mk_cond(ct, at, bt), [])
  | ~else:
      syntax_error(env.who, "an `if` needs a condition and two branches", whole)

// `cond | c1: e1 | c2: e2 | ... | ~else: en`.  Desugars to nested `if`;
// requires an explicit `~else` clause -- this reflected subset does not do
// exhaustiveness analysis over arbitrary Boolean guards the way `match`
// does over constructors, so unlike `match` there is no way to check a
// `cond` without a catch-all is total.
fun parse_cond(env :: PEnv, ts :: List.of(Syntax))
     :: values(Term, List.of(Syntax)):
  let [t, ...] = ts
  let whole = '$t ...'
  match whole
  | 'cond | $clause | ...':
      values(build_cond(env, [clause, ...], whole), [])
  | ~else:
      syntax_error(env.who, "a `cond` needs at least one clause", whole)

fun build_cond(env :: PEnv, cs :: List.of(Syntax), at :: Syntax) :: Term:
  match cs
  | []:
      syntax_error(env.who, "a `cond` needs a final `~else` clause", at)
  | List.cons(c, rest):
      match c
      | '~else: $b; ...':
          unless rest.length() == 0
          | syntax_error(env.who, "`~else` must be the last `cond` clause", c)
          parse_group(env, '$b; ...')
      | '$g ...: $b; ...':
          let ct = parse_group(env, '$g ...')
          unless type_of(ct) == bool
          | syntax_error(env.who, "a `cond` condition must be a Boolean",
                         '$g ...')
          let at_t = parse_group(env, '$b; ...')
          let bt = build_cond(env, rest, at)
          unless type_of(at_t) == type_of(bt)
          | syntax_error(env.who,
                         "the branches of a `cond` have different types", c)
          mk_cond(ct, at_t, bt)
      | ~else: syntax_error(env.who, "malformed `cond` clause", c)

// `forall (x :: T, ...): body`.  The body extends as far right as it can, so a
// quantifier always swallows the rest of the sequence -- which is why this
// matches the reassembled group rather than picking terms off one at a time.
fun parse_quantifier(env :: PEnv, which :: Symbol, ts :: List.of(Syntax))
     :: values(Term, List.of(Syntax)):
  let [t, ...] = ts
  let whole = '$t ...'
  let (binders, body_stx):
    match whole
    | 'forall ($b, ...): $g; ...': values([b, ...], '$g; ...')
    | 'exists ($b, ...): $g; ...': values([b, ...], '$g; ...')
    | 'forall ($b, ...) $more ...': values([b, ...], '$more ...')
    | 'exists ($b, ...) $more ...': values([b, ...], '$more ...')
    | ~else:
        syntax_error(env.who,
                     "a quantifier needs a parenthesised binder list and a body",
                     whole)
  let bs :~ List = binders
  let vs = for List (b in bs): binder_var(env, b)
  let vars2 = for values(m :~ Map = env.vars) (v in vs):
                m ++ {(v :~ FVar).name: v :~ Term}
  let body = parse_group(sub_env(env, vars2), body_stx)
  let build = (if which == #'forall | mk_forall | mk_exists)
  values(for values(acc :~ Term = body) (v in vs.reverse()): build(v, acc), [])

fun binder_var(env :: PEnv, b :: Syntax) :: FVar:
  match b
  | '$(n :: Identifier) :: $ty ...':
      mk_var(Syntax.unwrap(n), parse_type('$ty ...', env.tyvars))
  | ~else: syntax_error(env.who, "a binder needs a name and a type", b)

fun parse_application(env :: PEnv, t :: Syntax, rest :: List.of(Syntax))
     :: values(Term, List.of(Syntax)):
  match t
  | '($g)':
      values(parse_group(env, g), rest)
  | '$(id :: Identifier)':
      let n = Syntax.unwrap(id)
      match rest
      | List.cons(args, more) when is_parens(args):
          let as_ = for List (a in paren_groups(args)): parse_group(env, a)
          values(apply_named(env, n, as_, t), more)
      | ~else: values(lookup_atom(env, n, t), rest)
  | ~else: syntax_error(env.who, not_admitted(env), t)

// What the grammar admits, said in the terms of whichever mode is running.
// A body that falls outside it is a compile error, so the message is the only
// guidance the author gets.
fun not_admitted(env :: PEnv) :: String:
  cond
  | env.mode == #'prop:
      "a proposition admits variables, named applications, `not`, `and`, "
        ++ "`or`, `===`, `<=>`, `==>`, `forall`, `exists` and `if`"
  | ~else:
      "this version admits only variables, named applications, `if`, "
        ++ "`cond`, and the Boolean operators `!`, `&&`, `||` and `==` in "
        ++ "a function body"

fun is_parens(t :: Syntax) :: Boolean:
  match t
  | '($_, ...)': #true
  | ~else: #false

fun paren_groups(t :: Syntax) :: List.of(Syntax):
  match t
  | '($g, ...)': [g, ...]
  | ~else: []

fun lookup_atom(env :: PEnv, n :: Symbol, at :: Syntax) :: Term:
  match env.vars.get(n, #false)
  | #false:
      cond
      | n == env.self_name: env.self :~ Term
      | ~else: mk_const(n, const_instance(env.thy, n, [], at))
  | v: v

fun apply_named(env :: PEnv, n :: Symbol, args :: List.of(Term),
                at :: Syntax) :: Term:
  match env.vars.get(n, #false)
  | #false:
      cond
      | n == env.self_name: list_mk_comb(env.self :~ Term, args)
      | ~else:
          list_mk_comb(mk_const(n, const_instance(env.thy, n, args, at)), args)
  | v: list_mk_comb(v, args)

// The statement, plus the names of its leading universal binders -- the prover
// needs them for `~induct:` and for readable residues, because a locally
// nameless term does not carry them.
fun parse_theorem_statement(thy :: Theory, stx :: Syntax)
     :: values(Term, List.of(Symbol)):
  let tyvars = collect_type_vars(stx)
  values(parse_prop(thy, tyvars, {}, stx), leading_binder_names(stx))

fun leading_binder_names(stx :: Syntax) :: List.of(Symbol):
  match stx
  | 'forall ($b, ...): $g; ...':
      let here = for List (bb in [b, ...]): binder_name(bb)
      here ++ leading_binder_names('$g; ...')
  | 'forall ($b, ...) $rest ...':
      let here = for List (bb in [b, ...]): binder_name(bb)
      here ++ leading_binder_names('$rest ...')
  | ~else: []

fun binder_name(b :: Syntax) :: Symbol:
  match b
  | '$(n :: Identifier) :: $_ ...': Syntax.unwrap(n)
  | ~else: #'unknown

// ============================================================================
// Tactics
// ============================================================================
//
// `auto`, `auto ~induct: x`, or `auto(~induct: x, ~using: [a, b], ~do_not:
// [stage, ...], ~in_theory: [rule, ...], ~cases: [term, ...])`.  The
// parenthesised form exists because two `~kw:` blocks written in sequence
// mis-nest: shrubbery reads `auto ~induct: xs ~using: [a]` as `~using:`
// inside the `~induct:` block.
//
// `~do_not:` names waterfall stages to skip for this proof only -- ACL2's own
// `:do-not` hint -- as a rare escape hatch when a stage's heuristic gets in
// the way (it changes what the prover tries, never what it is allowed to
// conclude: a bad choice of `~do_not:` just produces a residue).  The
// recognised names are `simplify`, `eliminate`, `fertilize`, `generalize`,
// `irrelevance` and `induct`; see `waterfall.rhm`'s pipeline comment.
//
// `~in_theory:` disables rules for this proof only -- ACL2's own
// `:in-theory (disable ...)` -- layered on top of whatever a module-level
// `disable_rules`/`enable_rules` already set: it can turn a rule off that
// the module leaves enabled, but (like `~using:`, see `driver.rhm`) cannot
// turn back on a rule the module disabled -- there is no
// `~in_theory: enable [...]` in this version, only the module-level
// declaration for that. Disabling a rule can only make the simplifier try
// fewer rewrites, never more, so a bad choice just produces a residue, the
// same as `~do_not:`.
//
// `~cases:` case-splits the goal on one or more Boolean terms up front,
// before the waterfall runs -- ACL2's own `:cases` -- each term producing a
// true branch and a false branch (so `n` terms give `2^n` subgoals, one per
// combination), justified by `taut.rhm`'s `excluded_middle`, never
// postulated: a bad choice of terms just produces more, or less useful,
// residues to read.  The terms are returned here as unparsed syntax,
// because parsing them needs the theorem's own bound variables in scope,
// which only `driver.rhm` has assembled by the time it calls `parse_tactic`.
//
// Returns `[induct_name_or_false, [using_name, ...], [do_not_name, ...],
// [in_theory_name, ...], [case_term_stx, ...]]`.
fun parse_tactic(stx :: maybe(Syntax)) :: List:
  match stx
  | #false: [#false, [], [], [], []]
  | s :~ Syntax:
      match s
      | 'auto': [#false, [], [], [], []]
      | 'auto ~induct: $(n :: Identifier)': [Syntax.unwrap(n), [], [], [], []]
      | 'auto ($opt, ...)': tactic_options([opt, ...], s)
      | 'auto: $g; ...': tactic_options(['$g; ...'], s)
      | ~else:
          syntax_error(#'proof,
                       "this version understands `auto`, `auto ~induct: x`, "
                         ++ "and `auto(~induct: x, ~using: [t, ...], "
                         ++ "~do_not: [stage, ...], ~in_theory: [rule, ...], "
                         ++ "~cases: [term, ...])`",
                       s)

fun tactic_options(opts :: List.of(Syntax), at :: Syntax) :: List:
  for values(acc :~ List = [#false, [], [], [], []]) (o in opts):
    match o
    | '~induct: $(n :: Identifier)':
        [Syntax.unwrap(n), acc[1], acc[2], acc[3], acc[4]]
    | '~using: [$(u :: Identifier), ...]':
        [acc[0], (acc[1] :~ List) ++ [Syntax.unwrap(u), ...], acc[2], acc[3], acc[4]]
    | '~do_not: [$(d :: Identifier), ...]':
        [acc[0], acc[1], (acc[2] :~ List) ++ [Syntax.unwrap(d), ...], acc[3], acc[4]]
    | '~in_theory: [$(r :: Identifier), ...]':
        [acc[0], acc[1], acc[2], (acc[3] :~ List) ++ [Syntax.unwrap(r), ...], acc[4]]
    | '~cases: [$c, ...]':
        [acc[0], acc[1], acc[2], acc[3], (acc[4] :~ List) ++ ['$c', ...]]
    | ~else: syntax_error(#'proof, "unknown proof option", o)

// ============================================================================
// check_property
// ============================================================================
//
//   check_property name(~samples: 200):
//     forall (xs :: List(Nat), ys :: List(Nat)):
//       rev(app(xs, ys)) == app(rev(xs), rev(ys))
//
// The options are parenthesised for the same reason the proof options are: two
// `~kw:` blocks written in sequence mis-nest.
//
// Returns `[name, samples, [[binder_id, HType], ...], body_syntax, size]`.
// The body is arbitrary executable Rhombus syntax. It is evaluated by the
// emitted code, so it must reach that code unchanged.

export:
  check_property_shape

fun check_property_shape(stx :: Syntax) :: List:
  let (name, opts, body):
    match stx
    | 'check_property $(n :: Identifier)($o, ...): $g; ...':
        values(n, [o, ...], '$g; ...')
    | 'check_property $(n :: Identifier): $g; ...':
        values(n, [], '$g; ...')
    | ~else:
        syntax_error(#'check_property, "malformed property declaration", stx)
  let [samples, size] = property_options(opts, stx)
  match body
  | 'forall ($b, ...): $g; ...':
      [name, samples, [property_binder(b), ...], '$g; ...', size]
  | ~else:
      syntax_error(#'check_property,
                   "a property starts with concrete, universally quantified "
                     ++ "inputs, written `forall (x :: T, ...): expression`",
                   body)

// `[samples, size]`.  `~size` bounds how big a generated value can get; the
// generator halves it at each recursive field, so it is a depth, not a count.
fun property_options(opts :: List.of(Syntax), at :: Syntax) :: List:
  for values(acc :~ List = [100, 6]) (o in opts):
    match o
    | '~samples: $(n :: Int)': [Syntax.unwrap(n), acc[1]]
    | '~size: $(n :: Int)': [acc[0], Syntax.unwrap(n)]
    | ~else: syntax_error(#'check_property, "unknown option", o)

// The type must be concrete: a generator cannot be built for a type variable.
fun property_binder(b :: Syntax) :: List:
  match b
  | '$(n :: Identifier) :: $ty ...': [n, parse_type('$ty ...', [])]
  | ~else:
      syntax_error(#'check_property,
                   "a property binder needs a name and a concrete type", b)
