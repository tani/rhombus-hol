#lang rhombus/static

// Recognising the declaration forms in a `#lang rhombus/hol` module body.
//
// This module only *classifies*: it says which groups are declarations, what
// their pieces are, and in what order they thread state.  Turning that into
// syntax is `module_block.rhm`'s job, because a syntax template built here
// would carry this module's phase-0 bindings and lose them on the way to the
// user's module -- a literal `'def x = 1'` created at phase 0 and returned
// from a phase-1 macro reports `def: unbound identifier`.
//
// Keeping recognition separate also keeps it testable as an ordinary phase-0
// function, which matters: the tricky parts -- pairing a `theorem` with an
// optional following `proof:`, and descending into `disable_rules` blocks --
// live here.

import:
  rhombus/hol/htype open
  "datatype.rhm" open
  "elab.rhm" as elab

export:
  Decl
  plan_next
  declaration_heads

// `kind` selects the template `module_block.rhm` will use; `parts` carries
// the pieces it needs, as syntax taken from the user's own source.
class Decl(kind :: Symbol,
           form :: Syntax,
           parts :: List)

// The heads this language claims.  Anything else is passed through untouched,
// so ordinary Rhombus definitions keep working.
// `check_property` is not here: it is a genuine bound macro now (see
// `module_block.rhm`), so ordinary Rhombus expansion finds it -- including
// when it arrives via a macro of the user's own, which a spelling-based scan
// here could never see through.
def declaration_heads :: List.of(Symbol) = [#'type, #'function,
                                            #'axiomatic_function,
                                            #'theorem, #'proof,
                                            #'disable_rules, #'enable_rules,
                                            #'import, #'declare, #'expect]

fun head_of(form :: Syntax) :: maybe(Symbol):
  match form
  | '$(id :: Identifier) $_ ...':
      let n = Syntax.unwrap(id)
      (if declaration_heads.contains(n) | n | #false)
  | ~else: #false

// Return exactly one declaration and the still-unexpanded tail. A caller can
// emit the first declaration and let the Rhombus expander install any bindings
// before asking for the next one.
fun plan_next(forms :: List.of(Syntax))
     :: values(maybe(Decl), List.of(Syntax)):
  match forms
  | []: values(#false, [])
  | List.cons(form, rest):
      match theorem_parts(form)
      | #false: values(plan_one(form), rest)
      | [name, attrs, stmt]:
          match rest
          | List.cons(nxt, more) when proof_tactic(nxt) != #false:
              values(Decl(#'theorem, form,
                          [name, attrs, stmt, proof_tactic(nxt)]),
                     more)
          | ~else:
              values(Decl(#'theorem, form, [name, attrs, stmt, #false]),
                     rest)


// `theorem ~rewrite_rule name: <prop>`, or `#false` if this is not one.
fun theorem_parts(form :: Syntax) :: maybe(List):
  match form
  | 'theorem $(attr :: Keyword) ... $(name :: Identifier): $g; ...':
      [name, [attr, ...], [g, ...]]
  | ~else: #false

fun proof_tactic(form :: Syntax) :: maybe(List.of(Syntax)):
  match form
  | 'proof: $g; ...': [g, ...]
  | ~else: #false

fun plan_one(form :: Syntax) :: Decl:
  match head_of(form)
  | #'type:
      // Runtime identifiers and the logical DatatypeSpec below are derived
      // from this one traversal of the user's declaration.
      let [name, ctors] = elab.type_decl_shape(form)
      let spec = elab.parse_type_decl(form)
      let self = mk_tyapp(spec.name, spec.params.map(fun (q :: Symbol): mk_tyvar(q)))
      let cs :~ List = ctors
      let gen = for List (c in cs, sc in spec.ctors):
                  let tys = (sc :~ Ctor).fields.map(fun (f :: Field): f.ty)
                  [(c :~ List)[0], tys,
                   for any (t in tys): t == self]
      Decl(#'type, form, [name, ctors, spec.params, gen])
  | #'function:
      // `function` says the definition is meant to be logical, so a body
      // outside the grammar is an error naming the offending expression --
      // not a silent pass-through.  Ordinary Rhombus `fun` is untouched.
      let [name, params, body] = elab.function_decl_shape(form)
      Decl(#'function, form, [name, params, body])
  | #'axiomatic_function:
      // Same grammar, different contract: this one is allowed to postulate
      // its equations, and `function` is not.  See `driver.rhm`.
      let [name, params, body] = elab.function_decl_shape(form)
      Decl(#'axiomatic_function, form, [name, params, body])
  | #'declare:
      match form
      | 'declare $(name :: Identifier)': Decl(#'declare, form, [name])
      | ~else:
          error(~who: #'declare, "expected a single name",
                error.val(~label: "form", to_string(form)))
  | #'expect:
      match form
      | 'expect [$name, ...]': Decl(#'expect, form, [[name, ...]])
      | ~else:
          error(~who: #'expect, "expected a bracketed list of names",
                error.val(~label: "form", to_string(form)))
  | #'proof:
      syntax_error_here(#'proof, "a `proof:` with no `theorem` before it", form)
  | #'import:
      // An ordinary Rhombus import, with one extra reading: if what it names
      // is a theory, its logic is adopted as well as its values.  The import
      // itself is passed through untouched -- this only looks at it.
      Decl(#'import, form, [theory_paths(form)])
  | #'disable_rules: rule_control(#'disable_rules, form)
  | #'enable_rules: rule_control(#'enable_rules, form)
  | ~else: Decl(#'other, form, [])

fun rule_control(kind :: Symbol, form :: Syntax) :: Decl:
  match form
  | 'disable_rules [$(n :: Identifier), ...]': Decl(kind, form, [[n, ...]])
  | 'enable_rules [$(n :: Identifier), ...]': Decl(kind, form, [[n, ...]])
  | ~else:
      syntax_error_here(kind, "expected a bracketed list of rule names", form)

fun syntax_error_here(who :: Symbol, message :: String, at :: Syntax):
  error(~who: who, message, error.val(~label: "in", to_string(at)))

// -- imports -----------------------------------------------------------------

// The module paths in an `import` that name `rhombus/hol` theories, each as
// its list of *terms*.
//
// Terms rather than an assembled group, because the group would be built here
// and this module is a phase-0 helper: a template built here loses its
// bindings on the way out of the phase-1 macro, and an emitted import whose
// path had lost them cannot read its own string literal.  The terms are the
// user's own syntax and carry the user's context; `module_block.rhm`
// reassembles them.
//
// A module is a theory exactly when it has a `hol_theory` submodule, and that
// is *checked*, not guessed from the shape of the path: an ordinary import has
// to pass through untouched, and a theory import must not be missed.
fun theory_paths(form :: Syntax) :: List.of(List.of(Syntax)):
  for values(acc :~ List = []) (c in import_clauses(form)):
    let chosen = clause_path(c)
    check_no_stray_theory(c, chosen)
    cond
    | chosen && is_theory(chosen :~ Syntax):
        acc ++ [clause_terms(chosen :~ Syntax)]
    | ~else: acc

fun import_clauses(form :: Syntax) :: List.of(Syntax):
  match form
  | 'import: $c; ...': [c, ...]
  | ~else: []

fun clause_terms(c :: Syntax) :: List.of(Syntax):
  match c
  | '$t ...': [t, ...]
  | ~else: []

// The longest prefix of the clause that reads as a module path.
//
// Trying prefixes rather than matching a list of modifier names keeps this
// from having to track Rhombus's import grammar: whatever the modifiers are,
// they are whatever is left once the path stops parsing.
fun clause_path(c :: Syntax) :: maybe(Syntax):
  let ts = clause_terms(c)
  recur loop (k = ts.length()):
    cond
    | k == 0: #false
    | ~else:
        let [t, ...] = (for List (i in List.iota(k)): ts[i])
        let cand = '$t ...'
        (if ModulePath.maybe(cand) | cand | loop(k - 1))

// Probing a path that is not a module at all raises rather than answering --
// a missing *collection* is an error, where a missing submodule is not -- and
// every term of every import clause gets probed here.  A path that cannot be
// resolved is simply not a theory; if it was meant to be one, the user's own
// import reports the real reason.
fun is_theory(p :: Syntax) :: Boolean:
  match ModulePath.maybe('$p ! hol_theory')
  | #false: #false
  | mp:
      try:
        Evaluator.module_is_declared(mp :~ ModulePath, ~load: #true)
        ~catch _ :: Exn.Fail: #false

// A clause whose path is not what the prefix rule picked -- `import: meta:
// "a.rhm"` reads its path out of a block, so the rule stops at `meta` -- would
// otherwise drop a theory without a word.  Rather than grow the rule to cover
// every such form, refuse the ones it cannot read.
fun check_no_stray_theory(c :: Syntax, chosen :: maybe(Syntax)) :: Void:
  let chosen_str = (if chosen | to_string(chosen :~ Syntax) | "")
  for (cand in path_candidates(c)):
    when to_string(cand) != chosen_str && is_theory(cand)
    | syntax_error_here(
        #'import,
        "this import names a theory in a form `rhombus/hol` cannot read; "
          ++ "write it as a plain `import: \"path.rhm\"` clause so that its "
          ++ "theory can be adopted",
        c)

// Every group in the clause that might be a module path: each term on its
// own, and, for a term that is a block, each group inside it.  The block case
// is what catches `import: meta: "a.rhm"`, whose path the prefix rule never
// reaches.
fun path_candidates(c :: Syntax) :: List.of(Syntax):
  for values(acc :~ List = []) (t in clause_terms(c)):
    match t
    | ': $g; ...': acc ++ [g, ...]
    | ~else: acc ++ ['$t']
