#lang rhombus/static
// SPDX-License-Identifier: 0BSD AND BSD-2-Clause AND BSD-3-Clause
// Adapts HOL Light/HOL4 natural-number constructions; see THIRD_PARTY_NOTICES.


// The axiom of infinity and the natural numbers derived from it, used as the
// basis for recursive datatype representations.
//
// This is the type every *recursive* datatype has to be carved out of.  HOL's
// type definition principle can only cut a nonempty subset out of a type that
// already exists, and every self-recursive datatype is infinite, so without
// an infinite type in the base there is nothing to cut.  That is the whole
// reason `datatype.rhm`'s axiom schema is still there for recursive
// declarations: not a gap in the derivation, a missing foundation.
//
// The trade the review asks for is one standard axiom, audited once, in
// place of a schema instantiated afresh for every recursive datatype a user
// writes.  This module builds the axiom's consequences but does *not* put
// the axiom in the session's base theory: `build_ind` extends whatever
// theory it is handed, so a session that never declares a recursive datatype
// pays nothing, exactly as `algebra.rhm`'s `unit`/`prod`/`sum` did before
// `add_type` used them.
//
// The construction is HOL Light's `nums.ml`, in the same order:
//
//   INFINITY_AX   ?f :: ind -> ind. one-one f and not onto f
//   IND_SUC/IND_0 a witnessing pair, pinned down with the choice operator
//   NUM_REP       the least subset of `ind` holding IND_0 and closed under
//                 IND_SUC
//   num           whatever is in bijection with NUM_REP
//   zero/suc      IND_0 and IND_SUC carried across that bijection
//
// and the three Peano properties come out as theorems about the bijection:
// `suc` is injective because IND_SUC is and `dest_num` is; `suc n` is never
// `zero` because IND_SUC never hits IND_0; induction is NUM_REP's own
// minimality, which is what "least subset" was chosen to mean.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  "wellfounded.rhm" open
  "wfrec.rhm" open
  "taut.rhm" open
  "datatype.rhm" open
  "subterm.rhm" open
  rhombus/hol/printer open
  "bool.rhm" open
  "conv.rhm" open
  "drule.rhm" open

export:
  ty_ind
  ty_num
  c_zero
  c_suc
  c_num_pred
  c_pre
  c_num_rec
  num_ty
  IndThms
  NumRec
  NumDatatype
  build_ind
  infinity_base_theory
  infinity_base_ind
  build_num_recursion
  num_spec
  build_num_datatype

def ty_ind :: Symbol = #'ind
def ty_num :: Symbol = #'num
def c_ind_suc :: Symbol = #'IND_SUC
def c_ind_0 :: Symbol = #'IND_0
def c_num_rep :: Symbol = #'NUM_REP
def c_mk_num :: Symbol = #'mk_num
def c_dest_num :: Symbol = #'dest_num
def c_zero :: Symbol = #'zero_num
def c_suc :: Symbol = #'suc_num
def c_num_pred :: Symbol = #'num_pred
def c_pre :: Symbol = #'pre_num
def c_rec_step :: Symbol = #'num_rec_step
def c_num_rec :: Symbol = #'num_rec

fun ind_ty() :: HType: mk_tyapp(ty_ind, [])
fun num_ty() :: HType: mk_tyapp(ty_num, [])

// What a caller gets: the type is in the returned `Theory`, and these are
// the three facts anything built on top of `num` needs.  Nothing else about
// the construction escapes -- `ind`, `IND_SUC`, `NUM_REP` and the bijection
// are implementation, the same way `unit`'s `rep_unit` is.
//
//   `suc_injective`  |- !m n. suc m = suc n <=> m = n
//   `suc_not_zero`   |- !n. not (suc n = zero)
//   `induction`      |- !P. P zero and (!n. P n ==> P (suc n)) ==> !n. P n
class PeanoThms(suc_injective :: Thm, suc_not_zero :: Thm, induction :: Thm)

// `existence` is the recursion theorem as it is usually stated.  `at_zero`
// and `at_suc` are the same content about the named combinator `num_rec`,
// which is what a caller defining a function by recursion actually wants:
// `num_rec e f` *is* the function, so there is no existential to eliminate
// and no `CHOOSE` in the way.
class NumRec(existence :: Thm, at_zero :: Thm, at_suc :: Thm)

class IndThms(suc_injective :: Thm, suc_not_zero :: Thm, induction :: Thm,
              wf :: Thm, cases :: Thm, pre_suc :: Thm, pred_def :: Thm)

// `|- P(@x. P x)` from `|- ?x. P x`.  The same derivation `wfrec.rhm` uses;
// it is not exported from there, and duplicating six lines beats widening
// that module's surface for one caller.
fun select_intro(thy :: Theory, v :: FVar, body :: Term, ex :: Thm) :: Thm:
  let pred = mk_abs(v, body)
  let sel = mk_select(v, body)
  let ax = INST_TYPE(thy, {#'a: v.ty}, base_axiom(#'SELECT_AX))
  let ax_at_v = SPEC(thy, v :~ Term, SPEC(thy, pred, ax))
  let beta_v = (match BETA_CONV(thy, mk_comb(pred, v))
                | th :: Thm: th
                | ~else: error(~who: #'select_intro, "beta failed"))
  let pred_v = EQ_MP(SYM(thy, beta_v), ASSUME(thy, body))
  let pred_sel = MP(thy, ax_at_v, pred_v)
  let beta_sel = (match BETA_CONV(thy, mk_comb(pred, sel))
                  | th :: Thm: th
                  | ~else: error(~who: #'select_intro, "beta failed"))
  CHOOSE(thy, v, ex, EQ_MP(beta_sel, pred_sel))

// `one_one(f) and not_onto(f)`, written out rather than behind named
// combinators: two extra constants would have to be defined, exported and
// explained, and they are used exactly once each.
//
//   one_one   !x1 x2. f x1 = f x2 ==> x1 = x2
//   not_onto  ?y. !x. not (f x = y)
//
// "not onto" is stated positively, as a point outside the image.  That is
// classically the same thing and it is the form the construction actually
// consumes -- IND_0 *is* that point.
fun infinity_body(f :: Term, fty :: HType) :: Term:
  let ity = ind_ty()
  let x1 = mk_var(#'x1, ity)
  let x2 = mk_var(#'x2, ity)
  let x = mk_var(#'x, ity)
  let y = mk_var(#'y, ity)
  let inj_body = mk_imp(mk_eq(mk_comb(f, x1), mk_comb(f, x2)),
                        mk_eq(x1 :~ Term, x2))
  let one_one = mk_forall(x1, mk_forall(x2, inj_body))
  let not_onto = mk_exists(y, mk_forall(x, mk_neg(mk_eq(mk_comb(f, x), y))))
  mk_conj(one_one, not_onto)

fun build_ind(thy0 :: Theory) :: values(Theory, IndThms):
  let thy1 = new_type(thy0, ty_ind, 0)
  let ity = ind_ty()
  let fty = mk_fun(ity, ity)
  let fv = mk_var(#'f, fty)

  // -- the axiom ------------------------------------------------------------
  let ax_stmt = mk_exists(fv, infinity_body(fv :~ Term, fty))
  let (thy2, infinity_ax) = new_axiom(thy1, ax_stmt)

  // -- IND_SUC: a witnessing injection, pinned down by choice ---------------
  let suc_sel = mk_select(fv, infinity_body(fv :~ Term, fty))
  let (thy3, def_suc):
    new_basic_definition(thy2, mk_eq(mk_var(c_ind_suc, fty), suc_sel))
  let ind_suc = mk_const(c_ind_suc, fty)
  // `|- <body>[@f. body / f]`, then rewritten to talk about `IND_SUC`.
  let at_sel = select_intro(thy2, fv, infinity_body(fv :~ Term, fty), infinity_ax)
  let suc_props:
    EQ_MP(cong_at(thy3, def_suc, concl_of(at_sel), suc_sel), at_sel)

  // -- IND_0: the point outside IND_SUC's image -----------------------------
  let yv = mk_var(#'y, ity)
  let xv = mk_var(#'x, ity)
  let miss_body = mk_forall(xv, mk_neg(mk_eq(mk_comb(ind_suc, xv), yv)))
  let miss_ex = CONJUNCT2(thy3, suc_props)
  let zero_sel = mk_select(yv, miss_body)
  let (thy4, def_0):
    new_basic_definition(thy3, mk_eq(mk_var(c_ind_0, ity), zero_sel))
  let ind_0 = mk_const(c_ind_0, ity)
  let at_zero_sel = select_intro(thy3, yv, miss_body, miss_ex)
  let ind_suc_ne_0:
    EQ_MP(cong_at(thy4, def_0, concl_of(at_zero_sel), zero_sel), at_zero_sel)
  let ind_suc_inj = CONJUNCT1(thy4, suc_props)

  // -- NUM_REP: the least subset holding IND_0 and closed under IND_SUC -----
  let pv = mk_var(#'P, mk_fun(ity, bool))
  let av = mk_var(#'a, ity)
  let closed = mk_conj(mk_comb(pv, ind_0),
                       mk_forall(xv, mk_imp(mk_comb(pv, xv),
                                            mk_comb(pv, mk_comb(ind_suc, xv)))))
  let rep_body = mk_forall(pv, mk_imp(closed, mk_comb(pv, av)))
  let nrty = mk_fun(ity, bool)
  let (thy5, def_rep):
    new_basic_definition(thy4, mk_eq(mk_var(c_num_rep, nrty),
                                     mk_abs(av, rep_body)))
  let num_rep = mk_const(c_num_rep, nrty)

  // `|- NUM_REP(a) <=> !P. ...` -- the defining equation, ready to use.
  fun rep_at(t :: Term) :: Thm:
    unfold_def(thy5, def_rep, [t])

  // Witness for the type definition: `|- NUM_REP(IND_0)`.  Assume the two
  // closure clauses; the first *is* `P IND_0`.
  let witness:
    let asm = ASSUME(thy5, closed)
    let body = GEN(thy5, pv, DISCH(thy5, closed, CONJUNCT1(thy5, asm)))
    EQ_MP(SYM(thy5, INST(thy5, [[ind_0, av]], rep_at(av :~ Term))), body)

  let (thy6, abs_rep, rep_pred):
    new_basic_type_definition(thy5, ty_num, c_mk_num, c_dest_num, witness)
  let nty = num_ty()
  let mk_num = mk_const(c_mk_num, mk_fun(ity, nty))
  let dest_num = mk_const(c_dest_num, mk_fun(nty, ity))

  // -- zero and suc ---------------------------------------------------------
  let nv = mk_var(#'n, nty)
  let mv = mk_var(#'m, nty)
  let (thy7, def_zero):
    new_basic_definition(thy6, mk_eq(mk_var(c_zero, nty), mk_comb(mk_num, ind_0)))
  let zero = mk_const(c_zero, nty)
  let sucty = mk_fun(nty, nty)
  let (thy8, def_suc_num):
    new_basic_definition(thy7,
                         mk_eq(mk_var(c_suc, sucty),
                               mk_abs(nv, mk_comb(mk_num,
                                                  mk_comb(ind_suc,
                                                          mk_comb(dest_num, nv))))))
  let suc = mk_const(c_suc, sucty)

  // -- num is well-founded --------------------------------------------------
  //
  // `num_pred m n` reads "n is m's successor", so it is the relation
  // recursion on `num` descends along.  Giving it a name of its own is not
  // cosmetic: `WFREC` and the rule database index relations by head constant
  // and cannot see through a lambda (see `stepfn.rhm`).
  let predty = mk_fun(nty, mk_fun(nty, bool))
  let pred_rhs = mk_abs(mv, mk_abs(nv, mk_eq(nv :~ Term, mk_comb(suc, mv))))
  let (thy9, def_pred):
    new_basic_definition(thy8, mk_eq(mk_var(c_num_pred, predty), pred_rhs))
  let num_pred = mk_const(c_num_pred, predty)

  let thms0:
    derive_peano(thy9, abs_rep, rep_pred, def_rep, def_zero, def_suc_num,
                 ind_suc, ind_0, num_rep, mk_num, dest_num,
                 zero, suc, ind_suc_inj, ind_suc_ne_0)
  let wf = derive_num_wf(thy9, def_pred, num_pred, zero, suc, nty, thms0)
  let cases = derive_num_cases(thy9, zero, suc, nty, thms0)
  // The predecessor, as a partial inverse pinned down by choice: `pre_num n`
  // is the `k` with `n = suc k`, and `suc`'s injectivity is what makes that
  // `k` unique, so the equation below is provable rather than stipulated.
  // At `zero` the choice is unconstrained and nothing here says what it is.
  let kv = mk_var(#'k, nty)
  let pre_rhs = mk_abs(nv, mk_select(kv, mk_eq(nv :~ Term, mk_comb(suc, kv))))
  let (thy10, def_pre):
    new_basic_definition(thy9, mk_eq(mk_var(c_pre, mk_fun(nty, nty)), pre_rhs))
  let pre_suc:
    derive_pre_suc(thy10, def_pre, mk_const(c_pre, mk_fun(nty, nty)),
                   suc, nty, thms0)
  values(thy10, IndThms(thms0.suc_injective, thms0.suc_not_zero,
                        thms0.induction, wf, cases, pre_suc, def_pred))

// `|- t = t'` where `t'` is `t` with `rhs` replaced by the constant `def`
// introduces for it.  `def : |- c = rhs`, so rewriting is `cong_rewrite`
// with the equation the other way round.
fun cong_at(thy :: Theory, def_th :: Thm, t :: Term, rhs :: Term) :: Thm:
  cong_replace(thy, rhs, lhs_of(def_th), SYM(thy, def_th), t)

// `|- t = t[to/from]`, structurally, justified by `eq : |- from = to`.
fun cong_replace(thy :: Theory, from :: Term, to :: Term, eq :: Thm,
                 t :: Term) :: Thm:
  cond
  | t == from: eq
  | ~else:
      match t
      | Comb(g, x):
          MK_COMB(cong_replace(thy, from, to, eq, g),
                  cong_replace(thy, from, to, eq, x))
      | Abs(_, _):
          let (v, body) = dest_abs(t)
          ABS(thy, v, cong_replace(thy, from, to, eq, body))
      | ~else: REFL(thy, t)

// The three Peano properties, transported across the bijection.
//
//   `abs_rep`   |- mk_num(dest_num a) = a          (kernel's own variables)
//   `rep_pred`  |- NUM_REP(r) <=> dest_num(mk_num r) = r
//
// so `dest_num` is injective outright, and it commutes with the two
// constructors wherever `NUM_REP` holds -- which is everywhere it is applied
// to a `num`, since `NUM_REP(dest_num n)` follows from `abs_rep`.
fun derive_peano(thy :: Theory, abs_rep :: Thm, rep_pred :: Thm,
                 def_rep :: Thm, def_zero :: Thm, def_suc_num :: Thm,
                 ind_suc :: Term, ind_0 :: Term, num_rep :: Term,
                 mk_num :: Term, dest_num :: Term, zero :: Term, suc :: Term,
                 ind_suc_inj :: Thm, ind_suc_ne_0 :: Thm) :: PeanoThms:
  let ity = ind_ty()
  let nty = num_ty()
  let av = mk_var(v_alpha, nty)
  let rv = mk_var(v_rep, ity)
  let nv = mk_var(#'n, nty)
  let mv = mk_var(#'m, nty)
  let xv = mk_var(#'x, ity)
  let pv = mk_var(#'P, mk_fun(ity, bool))

  // `NUM_REP`'s defining equation, re-instantiated in *this* theory: the
  // one `build_ind` used was closed over the theory before `num` existed.
  fun rep_at(t :: Term) :: Thm:
    unfold_def(thy, def_rep, [t])

  // `|- NUM_REP(dest_num n)`: the right-hand side of `rep_pred` at
  // `r := dest_num n` is `dest_num(mk_num(dest_num n)) = dest_num n`, which
  // is `abs_rep` with `dest_num` applied to both sides.
  fun num_rep_dest(n :: Term) :: Thm:
    let at_r = INST(thy, [[mk_comb(dest_num, n), rv]], rep_pred)
    let holds = AP_TERM(thy, dest_num, INST(thy, [[n, av]], abs_rep))
    EQ_MP(SYM(thy, at_r), holds)

  // `|- dest_num(mk_num x) = x`, given `|- NUM_REP(x)`.
  fun dest_mk(x :: Term, rep_x :: Thm) :: Thm:
    EQ_MP(INST(thy, [[x, rv]], rep_pred), rep_x)

  // `|- NUM_REP(IND_0)`: exactly the witness the type definition used, which
  // is not returned by the kernel, so it is re-derived here the same way.
  // The closure premise, rebuilt rather than read back off the unfolded
  // definition: a locally nameless binder has no name to recover, so
  // `dest_forall` would hand back a fresh variable that `GEN` could not
  // then bind.  Rebuilding at `pv` produces the same term.
  let closed = mk_conj(mk_comb(pv, ind_0),
                       mk_forall(xv, mk_imp(mk_comb(pv, xv),
                                            mk_comb(pv, mk_comb(ind_suc, xv)))))
  let num_rep_0:
    let asm = ASSUME(thy, closed)
    EQ_MP(SYM(thy, rep_at(ind_0)),
          GEN(thy, pv, DISCH(thy, closed, CONJUNCT1(thy, asm))))

  // `|- NUM_REP(IND_SUC x)`, given `|- NUM_REP(x)`.  Take any closed `P`:
  // `NUM_REP(x)` hands over `P x`, and the closure clause carries it up.
  fun num_rep_suc(x :: Term, rep_x :: Thm) :: Thm:
    let sx = mk_comb(ind_suc, x)
    let asm = ASSUME(thy, closed)
    let p_x = MP(thy, SPEC(thy, pv :~ Term, EQ_MP(rep_at(x), rep_x)), asm)
    let step = SPEC(thy, x, CONJUNCT2(thy, asm))
    EQ_MP(SYM(thy, rep_at(sx)),
          GEN(thy, pv, DISCH(thy, closed, MP(thy, step, p_x))))

  // `|- dest_num(zero) = IND_0` and `|- dest_num(suc n) = IND_SUC(dest_num n)`.
  let dest_zero = TRANS(AP_TERM(thy, dest_num, def_zero), dest_mk(ind_0, num_rep_0))
  fun dest_suc(n :: Term) :: Thm:
    let unf = unfold_def(thy, def_suc_num, [n])
    let inner = mk_comb(ind_suc, mk_comb(dest_num, n))
    TRANS(AP_TERM(thy, dest_num, unf),
          dest_mk(inner, num_rep_suc(mk_comb(dest_num, n), num_rep_dest(n))))

  // -- suc is injective ------------------------------------------------------
  let suc_injective:
    let lhs = mk_eq(mk_comb(suc, mv), mk_comb(suc, nv))
    let fwd:
      let asm = ASSUME(thy, lhs)
      let on_ind = TRANS(SYM(thy, dest_suc(mv :~ Term)),
                         TRANS(AP_TERM(thy, dest_num, asm), dest_suc(nv :~ Term)))
      let dest_eq = MP(thy, SPEC(thy, mk_comb(dest_num, nv),
                                 SPEC(thy, mk_comb(dest_num, mv), ind_suc_inj)),
                       on_ind)
      let back = AP_TERM(thy, mk_num, dest_eq)
      TRANS(SYM(thy, INST(thy, [[mv :~ Term, av]], abs_rep)),
            TRANS(back, INST(thy, [[nv :~ Term, av]], abs_rep)))
    let bwd:
      AP_TERM(thy, suc, ASSUME(thy, mk_eq(mv :~ Term, nv)))
    GENL(thy, [mv, nv],
         IMP_ANTISYM_RULE(thy, DISCH(thy, lhs, fwd),
                          DISCH(thy, mk_eq(mv :~ Term, nv), bwd)))

  // -- suc n is never zero ---------------------------------------------------
  let suc_not_zero:
    let eqn = mk_eq(mk_comb(suc, nv), zero)
    let asm = ASSUME(thy, eqn)
    let on_ind = TRANS(SYM(thy, dest_suc(nv :~ Term)),
                       TRANS(AP_TERM(thy, dest_num, asm), dest_zero))
    let contra = MP(thy, NOT_ELIM(thy, SPEC(thy, mk_comb(dest_num, nv),
                                            ind_suc_ne_0)),
                    on_ind)
    GEN(thy, nv, NOT_INTRO(thy, DISCH(thy, eqn, contra)))

  // -- induction -------------------------------------------------------------
  //
  // `NUM_REP`'s minimality, at the predicate `. NUM_REP(a) and P(mk_num a)`.
  // The `NUM_REP(a)` conjunct is not decoration: the closure step needs
  // `dest_num(mk_num x) = x`, which only holds under it.
  let induction:
    let qp = mk_var(#'Q, mk_fun(nty, bool))
    let base = mk_comb(qp, zero)
    let step_stmt = mk_forall(nv, mk_imp(mk_comb(qp, nv),
                                         mk_comb(qp, mk_comb(suc, nv))))
    let hyp = mk_conj(base, step_stmt)
    let asm = ASSUME(thy, hyp)
    let base_th = CONJUNCT1(thy, asm)
    let step_th = CONJUNCT2(thy, asm)

    let pred_body = mk_conj(mk_comb(num_rep, xv),
                            mk_comb(qp, mk_comb(mk_num, xv)))
    let pred = mk_abs(xv, pred_body)
    fun pred_at(t :: Term) :: Thm:
      (match BETA_CONV(thy, mk_comb(pred, t))
       | th :: Thm: th
       | ~else: error(~who: #'build_ind, "beta failed"))

    // `pred(IND_0)`
    let pred_0:
      let q_zero = EQ_MP(AP_TERM(thy, qp, def_zero), base_th)
      EQ_MP(SYM(thy, pred_at(ind_0)), CONJ(thy, num_rep_0, q_zero))
    // `!x. pred(x) ==> pred(IND_SUC x)`
    let pred_step:
      let px = ASSUME(thy, mk_comb(pred, xv))
      let parts = EQ_MP(pred_at(xv :~ Term), px)
      let rep_x = CONJUNCT1(thy, parts)
      let q_mk_x = CONJUNCT2(thy, parts)
      let q_suc = MP(thy, SPEC(thy, mk_comb(mk_num, xv), step_th), q_mk_x)
      // `suc(mk_num x) = mk_num(IND_SUC x)`, using `dest_num(mk_num x) = x`.
      let unf = unfold_def(thy, def_suc_num, [mk_comb(mk_num, xv)])
      let fix = AP_TERM(thy, mk_num,
                        AP_TERM(thy, ind_suc, dest_mk(xv :~ Term, rep_x)))
      let suc_mk = TRANS(unf, fix)
      let q_at = EQ_MP(AP_TERM(thy, qp, suc_mk), q_suc)
      let concl = CONJ(thy, num_rep_suc(xv :~ Term, rep_x), q_at)
      GEN(thy, xv, DISCH(thy, mk_comb(pred, xv),
                         EQ_MP(SYM(thy, pred_at(mk_comb(ind_suc, xv))), concl)))

    // `NUM_REP(dest_num n)` instantiated at `pred` gives `pred(dest_num n)`.
    let dn = mk_comb(dest_num, nv)
    let closed_at = CONJ(thy, pred_0, pred_step)
    let pred_dn = MP(thy, SPEC(thy, pred, EQ_MP(rep_at(dn), num_rep_dest(nv :~ Term))),
                     closed_at)
    let q_mk_dn = CONJUNCT2(thy, EQ_MP(pred_at(dn), pred_dn))
    let q_n = EQ_MP(AP_TERM(thy, qp, INST(thy, [[nv :~ Term, av]], abs_rep)), q_mk_dn)
    GEN(thy, qp, DISCH(thy, hyp, GEN(thy, nv, q_n)))

  PeanoThms(suc_injective, suc_not_zero, induction)

// `|- WF(num_pred)`.
//
// `WF` is reached the way `subterm.rhm` reaches it for a datatype: prove the
// well-founded induction scheme for the relation, then hand it to
// `prove_wf_from_induction`.  For `num_pred` the scheme is Peano induction
// with the two constructor cases read off the two Peano theorems -- nothing
// below `zero`, and exactly one thing below `suc k`.
fun derive_num_wf(thy :: Theory, def_pred :: Thm, num_pred :: Term,
                  zero :: Term, suc :: Term,
                  nty :: HType, thms :: PeanoThms) :: Thm:
  let bigP = mk_var(#'P, mk_fun(nty, bool))
  let x = mk_var(#'x, nty)
  let y = mk_var(#'y, nty)
  let k = mk_var(#'k, nty)

  // `!y. num_pred y x ==> P y`, the step's premise, at a given `x`.
  fun below(t :: Term) :: Term:
    mk_forall(y, mk_imp(list_mk_comb(num_pred, [y :~ Term, t]),
                        mk_comb(bigP, y)))
  let step_stmt = mk_forall(x, mk_imp(below(x :~ Term), mk_comb(bigP, x)))
  let step = ASSUME(thy, step_stmt)

  // `num_pred y t` unfolded to `t = suc y`.
  fun pred_at(t :: Term) :: Thm:
    unfold_def(thy, def_pred, [y :~ Term, t])

  // base: nothing is below `zero`, because `zero` is no successor.
  let at_zero:
    let asm = ASSUME(thy, list_mk_comb(num_pred, [y :~ Term, zero]))
    let as_eq = EQ_MP(pred_at(zero), asm)
    let absurd = MP(thy, NOT_ELIM(thy, SPEC(thy, y, thms.suc_not_zero)),
                    SYM(thy, as_eq))
    let vacuous = GEN(thy, y, DISCH(thy, list_mk_comb(num_pred, [y :~ Term, zero]),
                                    CCONTR(thy, mk_comb(bigP, y), absurd)))
    MP(thy, SPEC(thy, zero, step), vacuous)

  // step: the only thing below `suc k` is `k`, because `suc` is injective.
  fun at_suc(pk :: Thm) :: Thm:
    let sk = mk_comb(suc, k)
    let asm = ASSUME(thy, list_mk_comb(num_pred, [y :~ Term, sk]))
    let as_eq = EQ_MP(pred_at(sk), asm)                 // |- suc k = suc y
    let k_is_y = EQ_MP(SPEC(thy, y, SPEC(thy, k, thms.suc_injective)), as_eq)
    let py = EQ_MP(AP_TERM(thy, bigP, k_is_y), pk)
    let vacuous = GEN(thy, y, DISCH(thy, list_mk_comb(num_pred, [y :~ Term, sk]),
                                    py))
    MP(thy, SPEC(thy, sk, step), vacuous)

  let base_case = mk_comb(bigP, zero)
  let step_case = mk_forall(k, mk_imp(mk_comb(bigP, k),
                                      mk_comb(bigP, mk_comb(suc, k))))
  let ind_prem = CONJ(thy, at_zero,
                      GEN(thy, k, DISCH(thy, mk_comb(bigP, k),
                                        at_suc(ASSUME(thy, mk_comb(bigP, k))))))
  let all_p = MP(thy, SPEC(thy, bigP :~ Term, thms.induction), ind_prem)
  let scheme = GEN(thy, bigP, DISCH(thy, step_stmt, all_p))
  prove_wf_from_induction(thy, num_pred, scheme)

// `|- !n. n = zero or ?k. n = suc k`.
//
// Every `num` is one of the two constructors' -- the exhaustiveness half of
// what a datatype declaration would postulate.  Straight from induction: the
// base case is reflexivity, and the step case never even looks at its
// hypothesis, since `suc k = suc k` settles the right disjunct on its own.
fun derive_num_cases(thy :: Theory, zero :: Term, suc :: Term,
                     nty :: HType, thms :: PeanoThms) :: Thm:
  let n = mk_var(#'n, nty)
  let k = mk_var(#'k, nty)
  let j = mk_var(#'j, nty)
  fun body(t :: Term) :: Term:
    mk_disj(mk_eq(t, zero), mk_exists(j, mk_eq(t, mk_comb(suc, j))))
  let pred = mk_abs(n, body(n :~ Term))

  // Induction specialised at `pred` and beta-reduced once, so both the
  // premise built below and the conclusion are in the shape they read in.
  let ind_at = BETA_RULE(thy, SPEC(thy, pred, thms.induction))
  let base:
    DISJ1(thy, REFL(thy, zero), mk_exists(j, mk_eq(zero, mk_comb(suc, j))))
  let step:
    let sk = mk_comb(suc, k)
    let ex = EXISTS(thy, mk_exists(j, mk_eq(sk, mk_comb(suc, j))), k :~ Term,
                    REFL(thy, sk))
    GEN(thy, k, DISCH(thy, body(k :~ Term),
                      DISJ2(thy, mk_eq(sk, zero), ex)))
  MP(thy, ind_at, CONJ(thy, base, step))

// `|- !j. pre_num(suc_num j) = j`.
//
// `pre_num(suc j)` unfolds to `@k. suc j = suc k`.  By `suc`'s injectivity
// that predicate holds of `k` exactly when `k = j`, so choice has no room:
// `SELECT_UNIQUE` turns "holds at `j`, and holds only at `j`" into the
// equation.
fun derive_pre_suc(thy :: Theory, def_pre :: Thm, pre :: Term, suc :: Term,
                   nty :: HType, thms :: PeanoThms) :: Thm:
  let j = mk_var(#'j, nty)
  let k = mk_var(#'k, nty)
  let sj = mk_comb(suc, j)
  let body = mk_eq(sj, mk_comb(suc, k))
  // `|- suc j = suc j`, the witness, in the unreduced shape `SELECT_UNIQUE`
  // asks for.
  let pred = mk_abs(k, body)
  let beta_j = (match BETA_CONV(thy, mk_comb(pred, j :~ Term))
                | th :: Thm: th
                | ~else: error(~who: #'derive_pre_suc, "beta failed"))
  let pa = EQ_MP(SYM(thy, beta_j), REFL(thy, sj))
  // `|- !k. suc j = suc k ==> k = j`
  let uniq:
    let asm = ASSUME(thy, body)
    let j_is_k = EQ_MP(SPEC(thy, k, SPEC(thy, j, thms.suc_injective)), asm)
    GEN(thy, k, DISCH(thy, body, SYM(thy, j_is_k)))
  let sel_eq = SELECT_UNIQUE(thy, k, body, j :~ Term, pa, uniq)
  GEN(thy, j, TRANS(unfold_def(thy, def_pre, [sj]), sel_eq))

// The primitive recursion theorem for `num`:
//
//   |- !e f. ?fn. fn(zero_num) = e and !n. fn(suc_num n) = f (fn n) n
//
// This is what makes `num` a base to build on rather than a type with some
// theorems about it: every function defined by recursion on the naturals --
// addition, multiplication, the pairing a general recursive-datatype
// construction needs -- comes from an instance of it.
//
// It is not postulated and it is not a new principle.  It is `WFREC`, the
// existence theorem already derived in `wfrec.rhm`, applied to the
// well-founded relation `num_pred` from `derive_num_wf` and the step function
//
//   H = \g n. if n = zero_num then e else f (g (pre_num n)) (pre_num n)
//
// with the congruence hypothesis `WFREC` asks for proved by splitting `n`
// with the `cases` theorem: at `zero_num` neither side makes a recursive
// call, and at `suc_num k` both make exactly the call the hypothesis covers.
fun build_num_recursion(thy0 :: Theory, thms :: IndThms) :: values(Theory, NumRec):
  let (thy, wr_def) = build_wfrec_rel(thy0)
  let nty = num_ty()
  let tyB :: HType = mk_tyvar(#'b)
  let zero = mk_const(c_zero, nty)
  let suc = mk_const(c_suc, mk_fun(nty, nty))
  let pre = mk_const(c_pre, mk_fun(nty, nty))
  let num_pred = mk_const(c_num_pred, mk_fun(nty, mk_fun(nty, bool)))

  let e = mk_var(#'e, tyB)
  let f = mk_var(#'f, mk_fun(tyB, mk_fun(nty, tyB)))
  let gty = mk_fun(nty, tyB)
  let g = mk_var(#'g, gty)
  let n = mk_var(#'n, nty)
  let k = mk_var(#'k, nty)
  let x = mk_var(#'x, nty)
  let f1 = mk_var(#'f1, gty)
  let f2 = mk_var(#'f2, gty)

  // The step function gets a name of its own before `WFREC` sees it.  That is
  // not decoration: `WFREC` compares terms of the form `H f x` structurally,
  // and a lambda `H` makes every one of them a redex, so the ones that get
  // reduced along the way stop matching the ones that do not.  It rejects a
  // lambda outright for that reason.
  fun step_body(gv :: Term, nv :: Term) :: Term:
    mk_cond(mk_eq(nv, zero), e :~ Term,
            list_mk_comb(f, [mk_comb(gv, mk_comb(pre, nv)),
                             mk_comb(pre, nv)]))
  let step_ty = mk_fun(tyB, mk_fun(type_of(f :~ Term),
                                   mk_fun(gty, mk_fun(nty, tyB))))
  let step_rhs:
    mk_abs(e, mk_abs(f, mk_abs(g, mk_abs(n, step_body(g :~ Term, n :~ Term)))))
  let (thy, def_step):
    new_basic_definition(thy, mk_eq(mk_var(c_rec_step, step_ty), step_rhs))
  let step_c = mk_const(c_rec_step, step_ty)
  let bigH = list_mk_comb(step_c, [e :~ Term, f :~ Term])

  // `|- H gv t = if t = zero then e else f (gv (pre t)) (pre t)`, the two
  // beta steps done by hand so the result is the reduced shape and not a
  // theorem whose both sides were reduced.
  fun unfold_h(th :: Theory, gv :: Term, t :: Term) :: Thm:
    unfold_def(th, def_step, [e :~ Term, f :~ Term, gv, t])

  let [cond_t0, cond_f0] = conditionals(thy)
  let cond_t = INST_TYPE(thy, {#'a: tyB}, cond_t0)
  let cond_f = INST_TYPE(thy, {#'a: tyB}, cond_f0)

  // `|- (if c then a else b) = a` given `|- c = true`, and dually.
  fun cond_at(th :: Theory, c_eq :: Thm, which :: Boolean,
              a :: Term, b :: Term) :: Thm:
    let lit = (if which | tm_true | tm_false)
    let rule = (if which | cond_t | cond_f)
    let to_lit = AP_THM(th, AP_THM(th, AP_TERM(th, mk_const(c_cond, mk_fun(bool, mk_fun(tyB, mk_fun(tyB, tyB)))), c_eq), a), b)
    TRANS(to_lit, SPECL(th, [a, b], rule))

  // `|- H gv t = e` when `t` is `zero_num`.
  fun h_at_zero(th :: Theory, gv :: Term) :: Thm:
    let branch = list_mk_comb(f, [mk_comb(gv, mk_comb(pre, zero)),
                                  mk_comb(pre, zero)])
    TRANS(unfold_h(th, gv, zero),
          cond_at(th, EQT_INTRO(th, REFL(th, zero)), #true, e :~ Term, branch))

  // `|- H gv (suc t) = f (gv t) t`.
  fun h_at_suc(th :: Theory, gv :: Term, t :: Term) :: Thm:
    let st = mk_comb(suc, t)
    let branch = list_mk_comb(f, [mk_comb(gv, mk_comb(pre, st)),
                                  mk_comb(pre, st)])
    let taken = cond_at(th, EQF_INTRO(th, SPEC(th, t, thms.suc_not_zero)),
                        #false, e :~ Term, branch)
    let pre_t = SPEC(th, t, thms.pre_suc)
    let fix = MK_COMB(AP_TERM(th, f, AP_TERM(th, gv, pre_t)), pre_t)
    TRANS(unfold_h(th, gv, st), TRANS(taken, fix))

  // -- the congruence hypothesis -------------------------------------------
  let congr:
    let hyp_term = mk_forall(k, mk_imp(list_mk_comb(num_pred, [k :~ Term, x]),
                                       mk_eq(mk_comb(f1, k), mk_comb(f2, k))))
    let hyp = ASSUME(thy, hyp_term)
    let goal_lhs = mk_comb(mk_comb(bigH, f1 :~ Term), x :~ Term)
    let goal_rhs = mk_comb(mk_comb(bigH, f2 :~ Term), x :~ Term)
    let goal = mk_eq(goal_lhs, goal_rhs)

    // `x = zero_num`: neither side calls, both are `e`.
    let case_zero:
      let asm = ASSUME(thy, mk_eq(x :~ Term, zero))
      fun side(fi :: Term) :: Thm:
        TRANS(AP_TERM(thy, mk_comb(bigH, fi), asm), h_at_zero(thy, fi))
      TRANS(side(f1 :~ Term), SYM(thy, side(f2 :~ Term)))

    // `x = suc k`: both call at `k`, which the hypothesis covers because
    // `num_pred k x` unfolds to exactly `x = suc k`.
    let case_suc:
      let asm = ASSUME(thy, mk_eq(x :~ Term, mk_comb(suc, k)))
      let pred_kx = EQ_MP(SYM(thy, unfold_def(thy, thms.pred_def,
                                              [k :~ Term, x :~ Term])),
                          asm)
      let fk_eq = MP(thy, SPEC(thy, k, hyp), pred_kx)
      let bodies = AP_THM(thy, AP_TERM(thy, f, fk_eq), k :~ Term)
      fun side(fi :: Term) :: Thm:
        TRANS(AP_TERM(thy, mk_comb(bigH, fi), asm), h_at_suc(thy, fi, k :~ Term))
      TRANS(side(f1 :~ Term),
            TRANS(bodies, SYM(thy, side(f2 :~ Term))))

    let split = SPEC(thy, x, thms.cases)
    let chosen = CHOOSE(thy, k, ASSUME(thy, mk_exists(k, mk_eq(x :~ Term,
                                                               mk_comb(suc, k)))),
                        case_suc)
    let both = DISJ_CASES(thy, split, case_zero, chosen)
    GENL(thy, [f1, f2, x], DISCH(thy, hyp_term, both))

  let (soln, sat) = WFREC(thy, wr_def, num_pred, bigH, thms.wf, congr)

  // The solution gets a name too, for the same reason the step function did:
  // `WFREC` hands back a lambda, so every `soln t` is a redex, and the
  // equations below would be stated about a term that beta-reduces out from
  // under them.  `num_rec e f` is the recursion combinator callers want to
  // see anyway.
  let rec_ty = mk_fun(tyB, mk_fun(type_of(f :~ Term), gty))
  let (thy2, def_rec):
    new_basic_definition(thy, mk_eq(mk_var(c_num_rec, rec_ty),
                                    mk_abs(e, mk_abs(f, soln))))
  let rec_c = mk_const(c_num_rec, rec_ty)
  let rec_ef = list_mk_comb(rec_c, [e :~ Term, f :~ Term])

  // Restate the fixed-point equation about the *name* before reading
  // anything off it.  `|- num_rec e f = soln` lets every `soln t` -- a redex,
  // since `soln` is a lambda -- be replaced by `num_rec e f t`, which is not.
  // After this nothing in the derivation can beta-reduce out from under an
  // equation.
  let rec_eq_soln = unfold_def(thy2, def_rec, [e :~ Term, f :~ Term])
  let sat_named:
    EQ_MP(cong_replace(thy2, soln, rec_ef, SYM(thy2, rec_eq_soln),
                       concl_of(sat)),
          sat)

  let at_zero:
    TRANS(SPEC(thy2, zero, sat_named), h_at_zero(thy2, rec_ef))
  let at_suc:
    let sn = mk_comb(suc, n)
    GEN(thy2, n, TRANS(SPEC(thy2, sn, sat_named), h_at_suc(thy2, rec_ef, n :~ Term)))
  let both = CONJ(thy2, at_zero, at_suc)

  let fnv = mk_var(#'fn, gty)
  let target:
    mk_exists(fnv,
              mk_conj(mk_eq(mk_comb(fnv, zero), e :~ Term),
                      mk_forall(n, mk_eq(mk_comb(fnv, mk_comb(suc, n)),
                                         list_mk_comb(f, [mk_comb(fnv, n), n :~ Term])))))
  values(thy2,
         NumRec(GENL(thy2, [e, f], EXISTS(thy2, target, rec_ef, both)),
                GENL(thy2, [e, f], at_zero),
                GENL(thy2, [e, f], at_suc)))

// The session's shared infinity bootstrap, memoized exactly as
// `algebra_base_theory()` and `wfrec_base_theory()` are: every call to
// `build_ind` mints fresh `Stamp`s, so building it per module would give two
// modules incomparable theories and `adopt` would refuse to join them.
//
// It sits on top of `wfrec_base_theory()` because the derivations above need
// `WFREC`, and everything downstream of it -- notably every recursive
// datatype -- shares this one axiom rather than paying its own.
class IndBase(thy :: Theory, thms :: IndThms)
fun build_ind_base() :: IndBase:
  let (t, i) = build_ind(wfrec_base_theory())
  IndBase(t, i)
def ind_base :: IndBase = build_ind_base()
fun infinity_base_theory() :: Theory: ind_base.thy
fun infinity_base_ind() :: IndThms: ind_base.thms

// -- num as a datatype the rest of the system can consume --------------------
//
// Everything a self-recursive `type` declaration installs, for `num`, derived.
// The point is not that `num` is special: this is the exact shape required
// for an arbitrary recursive datatype, built once by hand so that
// the target is a thing that exists rather than a description.
//
// `wf_lt` is produced by `subterm.rhm`'s own `prove_wf_t_lt`, unmodified --
// which is the check that the derived type really does fit the machinery, and
// not merely resemble it.
class NumDatatype(thms :: DatatypeThms,
                  lt_equations :: List.of(Thm),
                  wf_lt :: Thm)

// The declaration `num` would have had, if it had been written as one.
fun num_spec() :: DatatypeSpec:
  DatatypeSpec(ty_num, [],
               [Ctor(c_zero, []),
                Ctor(c_suc, [Field(#'pre, num_ty())])])

fun build_num_datatype(thy0 :: Theory, ind :: IndThms,
                       rec :: NumRec) :: values(Theory, NumDatatype):
  let spec = num_spec()
  let nty = num_ty()
  let zero = mk_const(c_zero, nty)
  let suc = mk_const(c_suc, mk_fun(nty, nty))
  let pre = mk_const(c_pre, mk_fun(nty, nty))
  let nb = mk_fun(nty, bool)
  let x = mk_var(#'x, nty)
  let y = mk_var(#'y, nty)
  let k = mk_var(#'k, nty)
  let r = mk_var(#'r, nb)

  // -- the subterm relation, defined by recursion rather than postulated ----
  //
  //   num_lt x zero      <=> false
  //   num_lt x (suc y)   <=> x = y or num_lt x y
  //
  // which is `num_rec` at `'b := num -> bool`, with the two arguments in the
  // order `T_lt` uses.
  let e0 = mk_abs(x, tm_false)
  let f0 = mk_abs(r, mk_abs(y, mk_abs(x, mk_disj(mk_eq(x :~ Term, y),
                                                 mk_comb(r, x)))))
  let rec_ty = mk_fun(nb, mk_fun(mk_fun(nb, mk_fun(nty, nb)), mk_fun(nty, nb)))
  let core = list_mk_comb(mk_const(c_num_rec, rec_ty), [e0, f0])
  let lt_ty = mk_fun(nty, mk_fun(nty, bool))
  let lt_name = subterm_name(spec)
  let (thy, def_lt):
    new_basic_definition(thy0,
                         mk_eq(mk_var(lt_name, lt_ty),
                               mk_abs(x, mk_abs(y, mk_comb(mk_comb(core, y),
                                                           x :~ Term)))))
  fun lt_at(a :: Term, b :: Term) :: Thm: unfold_def(thy, def_lt, [a, b])
  let rz = SPECL(thy, [e0, f0], INST_TYPE(thy, {#'b: nb}, rec.at_zero))
  let rs = SPECL(thy, [e0, f0], INST_TYPE(thy, {#'b: nb}, rec.at_suc))
  let lt_zero:
    GEN(thy, x, TRANS(lt_at(x :~ Term, zero),
                      BETA_RULE(thy, AP_THM(thy, rz, x :~ Term))))
  let lt_suc:
    let disj_c = mk_const(c_disj, mk_fun(bool, mk_fun(bool, bool)))
    let applied = BETA_RULE(thy, AP_THM(thy, SPEC(thy, y, rs), x :~ Term))
    let fold = AP_TERM(thy, mk_comb(disj_c, mk_eq(x :~ Term, y)),
                       SYM(thy, lt_at(x :~ Term, y :~ Term)))
    GENL(thy, [x, y], TRANS(lt_at(x :~ Term, mk_comb(suc, y)),
                            TRANS(applied, fold)))
  let lt_eqs = [lt_zero, lt_suc]
  let wf_lt = prove_wf_t_lt(thy, spec, lt_eqs, ind.induction)

  // -- selector and discriminators ------------------------------------------
  let sel_ty = mk_fun(nty, nty)
  let (thy, def_sel):
    new_basic_definition(thy, mk_eq(mk_var(selector_name(spec.ctors[1], (spec.ctors[1] :~ Ctor).fields[0]), sel_ty), pre))
  let (thy, def_isz):
    new_basic_definition(thy, mk_eq(mk_var(discriminator_name(spec.ctors[0]), nb),
                                    mk_abs(x, mk_eq(x :~ Term, zero))))
  let (thy, def_iss):
    new_basic_definition(thy, mk_eq(mk_var(discriminator_name(spec.ctors[1]), nb),
                                    mk_abs(x, mk_neg(mk_eq(x :~ Term, zero)))))
  let sel = mk_const(selector_name(spec.ctors[1], (spec.ctors[1] :~ Ctor).fields[0]), sel_ty)
  let isz = mk_const(discriminator_name(spec.ctors[0]), nb)
  let iss = mk_const(discriminator_name(spec.ctors[1]), nb)

  let sel_eq:
    GEN(thy, x, TRANS(unfold_def(thy, def_sel, [mk_comb(suc, x)]),
                      SPEC(thy, x, ind.pre_suc)))

  let zero_true = EQT_INTRO(thy, REFL(thy, zero))
  let suc_false = EQF_INTRO(thy, SPEC(thy, y, ind.suc_not_zero))
  let disc_zz = TRANS(unfold_def(thy, def_isz, [zero]), zero_true)
  let disc_zs:
    GEN(thy, y, TRANS(unfold_def(thy, def_isz, [mk_comb(suc, y)]), suc_false))
  let disc_sz:
    let nz = mk_neg(mk_eq(zero, zero))
    let contra = MP(thy, NOT_ELIM(thy, ASSUME(thy, nz)), REFL(thy, zero))
    TRANS(unfold_def(thy, def_iss, [zero]),
          EQF_INTRO(thy, NOT_INTRO(thy, DISCH(thy, nz, contra))))
  let disc_ss:
    GEN(thy, y, TRANS(unfold_def(thy, def_iss, [mk_comb(suc, y)]),
                      EQT_INTRO(thy, SPEC(thy, y, ind.suc_not_zero))))

  // -- distinctness, in the `[i, j]` order the schema states it -------------
  let distinct:
    let stmt = mk_eq(zero, mk_comb(suc, y))
    let contra = MP(thy, NOT_ELIM(thy, SPEC(thy, y, ind.suc_not_zero)),
                    SYM(thy, ASSUME(thy, stmt)))
    GEN(thy, y, NOT_INTRO(thy, DISCH(thy, stmt, contra)))

  // -- destructor elimination ------------------------------------------------
  let elim_zero:
    let asm = ASSUME(thy, mk_comb(isz, x))
    GEN(thy, x, DISCH(thy, mk_comb(isz, x),
                      SYM(thy, EQ_MP(unfold_def(thy, def_isz, [x :~ Term]),
                                     asm))))
  let elim_suc:
    let asm = ASSUME(thy, mk_comb(iss, x))
    let not_zero = EQ_MP(unfold_def(thy, def_iss, [x :~ Term]), asm)
    let goal = mk_eq(mk_comb(suc, mk_comb(sel, x)), x :~ Term)
    let from_zero:
      CCONTR(thy, goal,
             MP(thy, NOT_ELIM(thy, not_zero),
                ASSUME(thy, mk_eq(x :~ Term, zero))))
    let from_suc:
      let a = ASSUME(thy, mk_eq(x :~ Term, mk_comb(suc, k)))
      TRANS(AP_TERM(thy, suc, TRANS(AP_TERM(thy, sel, a),
                                    SPEC(thy, k, sel_eq))),
            SYM(thy, a))
    let ex = mk_exists(k, mk_eq(x :~ Term, mk_comb(suc, k)))
    GEN(thy, x, DISCH(thy, mk_comb(iss, x),
                      DISJ_CASES(thy, SPEC(thy, x, ind.cases), from_zero,
                                 CHOOSE(thy, k, ASSUME(thy, ex), from_suc))))

  values(thy,
         NumDatatype(DatatypeThms(spec,
                                  {c_suc: ind.suc_injective},
                                  [distinct],
                                  ind.induction,
                                  ind.cases,
                                  [disc_zz, disc_zs, disc_sz, disc_ss],
                                  [sel_eq],
                                  [elim_zero, elim_suc]),
                     lt_eqs, wf_lt))
