#lang rhombus/and_meta

// The `#%module_block` of `#lang rhombus/hol`.
//
// It hands the module body to `expand.rhm` for recognition, then emits, for
// each declaration, the runtime code and one step of the compile-time state.
//
// The state is threaded as ordinary phase-1 definitions *in the user's
// module* -- `_hol_st0`, `_hol_st1`, ... -- rather than as compile-time state
// belonging to this macro.  `raco make` compiles many modules in one process,
// so macro-level state would be shared between them; per-module phase-1
// definitions cannot be.  Every generated identifier comes out of a single
// expansion of this one macro, so they share an introduction scope, refer to
// each other with no name surgery, and cannot be captured by user code.
//
// All syntax templates live here.  A template built in a phase-0 helper module
// loses its bindings on the way out of a phase-1 macro -- `'def x = 1'`
// written there and returned from a macro reports `def: unbound identifier` --
// so `expand.rhm` and `elab.rhm` analyse, and this module emits.

import:
  rhombus/meta open
  meta:
    "htype.rhm" open
    "expand.rhm" as expand
    "elab.rhm" as elab

export:
  module_block
  check_property

meta:
  // Any literal from this module will do as a lexical context: what matters is
  // that all the generated identifiers share one, and that the expander's
  // introduction scope lands on them alike.
  def id_ctx :: Syntax = 'hol_state'

  fun st(n :: Int) :: Syntax:
    Syntax.make_id("_hol_st" ++ to_string(n), id_ctx)

  // A term rebuilt with this module's context.
  //
  // Needed for the terms of a module path emitted into the `hol_theory`
  // submodule: that submodule's language is plain `rhombus`, and a term
  // carrying the user's `rhombus/hol` context cannot reach the implicit import
  // forms there -- a string path fails looking for `#%literal`.  Only the
  // datum matters for a module path, so rebuilding it loses nothing.
  fun recontext(t :: Syntax) :: Syntax:
    Syntax.make(Syntax.unwrap(t), id_ctx)

  // -- datatypes -------------------------------------------------------------

  // `class.together` so that a datatype can refer to itself, and an
  // `interface` rather than a base class as the sum: an interface carries no
  // fields and imposes no field order on the variants.
  //
  // Field annotations are dropped -- that is the type erasure.  Rhombus has no
  // parametric polymorphism, so `List(~a)` has nothing to erase *to*, and the
  // logical side has already checked the types.
  fun emit_type(name :: Syntax, ctors :: List) :: Syntax:
    let [variant, ...] = ctors.map(fun (c :: List): emit_variant(name, c))
    'class.together:
       interface $name
       $variant
       ...'

  fun emit_variant(iface :: Syntax, c :: List) :: Syntax:
    let [cname, fields] = c
    let fs :~ List = fields
    let [f, ...] = fs
    'class $cname($f, ...):
       implements $iface'

  // -- generators and shrinkers ----------------------------------------------
  //
  // Emitted alongside a datatype, from the same declaration, so that
  // `check_property` has something to draw values from.  They are ordinary
  // Rhombus functions over the emitted classes -- the property is checked by
  // running the real code, which is the whole point of doing it at runtime.
  //
  // They reach `check_property` through `qc.rhm`'s registry rather than
  // through a name it has to guess: `type` registers its generator and
  // shrinker under the type's own name as an ordinary run-time effect, when
  // the type's own module is instantiated.  That happens automatically for a
  // datatype declared in another module too, since instantiating an import
  // runs its top-level effects before this module's own body -- no export of
  // the generator or shrinker is needed, because nothing outside this file
  // ever refers to one by name.
  //
  // A name has to travel as a plain string, not a `Symbol`: a symbol written
  // `#'foo` cannot appear inside a syntax template, the quote would close it.

  fun type_name_str(n :: Symbol) :: Syntax:
    Syntax.make(to_string(n), id_ctx)

  fun param_gen_id(p :: Symbol) :: Syntax:
    Syntax.make_id("_hol_g_" ++ to_string(p), id_ctx)

  // A generator expression for a type: a function from a size to a value.
  fun gen_expr(ty) :: Syntax:
    match ty
    | TyVar(a): param_gen_id(a)
    | TyApp(n, args):
        let nm = type_name_str(n)
        let [sub, ...] = args.map(fun (t): gen_expr(t))
        // Parenthesised: a `fun ...:` block cannot sit in application position
        // or before a comma without one.
        '(fun (_hol_s): _hol_qc.lookup_gen($nm)(_hol_s, $sub, ...))'

  fun shrink_expr(ty, at :: Syntax) :: Syntax:
    match ty
    | TyApp(n, _): '_hol_qc.lookup_shrink($(type_name_str(n)))'
    | ~else:
        error(~who: #'check_property,
              "cannot shrink a value of variable type",
              error.val(~label: "in", to_string(at)))

  fun emit_generator(name :: Syntax, params :: List, ctors :: List) :: Syntax:
    let nm = type_name_str(Syntax.unwrap(name))
    let [pg, ...] = params.map(fun (p :: Symbol): param_gen_id(p))
    let base = ctors.filter(~keep: fun (c :: List): !(c[2] :~ Boolean))
    let [b, ...] = base.map(ctor_builder)
    let [a, ...] = ctors.map(ctor_builder)
    let build = 'fun (_hol_sz, $pg, ...):
                   _hol_qc.pick(_hol_sz, [$b, ...], [$a, ...])'
    '_hol_qc.register_gen($nm, $build)'

  // `[ctor_id, [field_type, ...], recursive?]`
  fun ctor_builder(c :: List) :: Syntax:
    let cname = c[0] :~ Syntax
    let ftys :~ List = c[1]
    let [arg, ...] = ftys.map(fun (t): '$(gen_expr(t))(_hol_sz - 1)')
    'fun (): $cname($arg, ...)'

  fun emit_shrinker(name :: Syntax, ctors :: List) :: Syntax:
    let nm = type_name_str(Syntax.unwrap(name))
    let [clause, ...] = ctors.map(fun (c :: List): shrink_clause(name, c))
    let build = 'fun (_hol_v):
                   match _hol_v
                   | $clause
                   | ...'
    '_hol_qc.register_shrink($nm, $build)'

  // The classic shrink for an algebraic value: its recursive subterms.
  fun shrink_clause(tname :: Syntax, c :: List) :: Syntax:
    let cname = c[0] :~ Syntax
    let ftys :~ List = c[1]
    let n = ftys.length()
    let vs = for List (i in List.iota(n)):
               Syntax.make_id("_hol_f" ++ to_string(i), id_ctx)
    let [v, ...] = vs
    let keep = for values(acc :~ List = []) (t in ftys, vv in vs):
                 (if same_type_name(t, tname) | acc ++ [vv] | acc)
    let [k, ...] = keep
    '$cname($v, ...): [$k, ...]'

  fun same_type_name(ty, tname :: Syntax) :: Boolean:
    match ty
    | TyApp(n, _): n == Syntax.unwrap(tname)
    | ~else: #false

  // -- check_property --------------------------------------------------------
  //
  // `check_property` is a genuine, independently bound macro rather than a
  // form `#%module_block` recognises by scanning.  It can do this because,
  // unlike `type`/`function`/`theorem`, it never touches the theory chain --
  // `driver.rhm` has no step for it at all, since a property is checked by
  // running the emitted code, and its value is the outcome.  With nothing to
  // thread, there is nothing standing between it and being an ordinary macro,
  // usable directly or from within a macro of the user's own.

  fun emit_property_from(name :: Syntax, samples, binders :: List,
                         body :: Syntax, size, at :: Syntax) :: Syntax:
    let [v, ...] = binders.map(fun (b :: List): b[0] :~ Syntax)
    let [g, ...] = binders.map(fun (b :: List): gen_expr(b[1]))
    let [sh, ...] = binders.map(fun (b :: List): shrink_expr(b[1], at))
    let prop = 'fun ($v, ...):
                  $body'
    let count = Syntax.make(samples, id_ctx)
    let sz = Syntax.make(size, id_ctx)
    // `check_property` imports `qc` for itself, as `_hol_qc` -- the same
    // spelling `gen_expr`/`shrink_expr` write, and this is what makes the two
    // resolve to the same binding.  `check_property` is a separate macro
    // expansion from `type`'s, so an identifier introduced by one is never the
    // same binding as the same spelling introduced by the other; what makes
    // this pair line up is that both the import and the references it
    // supports are produced as part of *this one* expansion, regardless of
    // which file's function assembled them.
    'import: rhombus/hol/private/qc as _hol_qc
     def $name:
       _hol_qc.run(Syntax.unwrap('$name'),
                   ~samples: $count,
                   ~size: $sz,
                   ~gens: [$g, ...],
                   ~shrinks: [$sh, ...],
                   ~prop: $prop)'

  // -- functions -------------------------------------------------------------

  // The executable meaning: the surface code with its annotations removed.
  //
  // Not a second translation that could drift from the logical one.  The
  // surface *is* Rhombus; the only difference is the types.  What makes
  // Rhombus's first-match `match` agree with the unordered clausal equations is
  // the exhaustiveness and non-overlap `recdef.rhm` checks before installing
  // anything.
  fun emit_function(name :: Syntax, params :: List, body :: Syntax) :: Syntax:
    let [p, ...] = params
    'fun $name($p, ...):
       $body'

  // -- rule control ----------------------------------------------------------

  fun rule_step(d :: expand.Decl, n :: Int, cur :: Syntax, nxt :: Syntax,
                on :: Boolean) :: values(List.of(Syntax), Int):
    let [names] = d.parts
    let ns :~ List = names
    let [nm, ...] = ns
    let flag = (if on | '#true' | '#false')
    values(['meta def $nxt
               = _hol_driver.set_rules($cur, $flag,
                                       [Syntax.unwrap('$nm'), ...])'],
           n + 1)

  // -- diagnostics -----------------------------------------------------------

  // `raise-syntax-error` reports the location of the syntax object it is
  // given, and a *group* built by a template carries the template's location,
  // not the user's.  The head term still carries the user's.
  fun head_term(form :: Syntax) :: Syntax:
    match form
    | '$head $_ ...': head
    | ~else: form

  // -- one declaration -------------------------------------------------------

  // Two outputs, because they go to two places: the runtime forms stay in the
  // module, and the chain steps go into the `hol_theory` submodule.  Nothing
  // in the runtime half ever refers to the chain, which is what makes the
  // split possible.
  fun emit_one(d :: expand.Decl, n :: Int)
       :: values(List.of(Syntax), List.of(Syntax), Int):
    let cur = st(n)
    let nxt = st(n + 1)
    match d.kind
    | #'other: values([d.form], [], n)
    | #'import:
        // The import itself is passed through untouched.  When it names
        // theories, the submodule imports their theories too and adopts them,
        // one step per theory, in the order written.
        let [paths] = d.parts
        let at = head_term(d.form)
        let (chain, n2):
          for values(acc :~ List = [], k = n) (terms in (paths :~ List)):
            let alias = Syntax.make_id("_hol_used" ++ to_string(k), id_ctx)
            // Reassembled here, not in `expand.rhm`: see the note there.
            //
            // Rebuilt with this module's context as well.  The submodule's
            // language is plain `rhombus`, and a term carrying the user's
            // `rhombus/hol` context cannot find the implicit import forms
            // there -- a string path fails on `#%literal`.  The datum is all
            // that matters for a module path.
            let [t, ...] = (terms :~ List).map(recontext)
            let p = '$t ...'
            values(acc ++ ['import: $p!hol_theory as $alias',
                           'def $(st(k + 1))
                              = _hol_driver.adopt($(st(k)), $(alias).theory,
                                                  '$at')'],
                   k + 1)
        values([d.form], chain, n2)
    | #'type:
        let [name, ctors, params, gen] = d.parts
        let at = head_term(d.form)
        let form = d.form
        values([emit_type(name, ctors :~ List),
                emit_generator(name, params :~ List, gen :~ List),
                emit_shrinker(name, gen :~ List)],
               ['def $nxt = _hol_driver.add_type($cur, '$form', '$at')'],
               n + 1)
    | #'function:
        let [name, params, body] = d.parts
        let at = head_term(d.form)
        let form = d.form
        values([emit_function(name, params :~ List, body)],
               ['def $nxt = _hol_driver.add_function($cur, '$form', '$at')'],
               n + 1)
    | #'theorem:
        // A theorem emits no runtime code: it is a claim about the logic, and
        // the proof runs while the module is compiled.
        //
        // The `proof:` clause is optional, and the two cases need separate
        // templates: a nested syntax literal can only be written inside one,
        // not built up as a value beforehand.
        let [name, attrs, stmt, tactic] = d.parts
        let at = head_term(d.form)
        let as_ :~ List = attrs
        let [a, ...] = as_
        match tactic
        | #false:
            values([],
                   ['def $nxt
                       = _hol_driver.add_theorem($cur, Syntax.unwrap('$name'),
                                                 [Syntax.unwrap('$a'), ...],
                                                 '$stmt', #false, '$at')'],
                   n + 1)
        | tac:
            values([],
                   ['def $nxt
                       = _hol_driver.add_theorem($cur, Syntax.unwrap('$name'),
                                                 [Syntax.unwrap('$a'), ...],
                                                 '$stmt', '$tac', '$at')'],
                   n + 1)
    | #'disable_rules: rule_step(d, n, cur, nxt, #false)
    | #'enable_rules: rule_step(d, n, cur, nxt, #true)
    | #'declare:
        let [name] = d.parts
        values([],
               ['def $nxt = _hol_driver.note_decl($cur, Syntax.unwrap('$name'))'],
               n + 1)
    | #'expect:
        let [names] = d.parts
        let ns :~ List = names
        let [nm, ...] = ns
        let at = head_term(d.form)
        values([],
               ['def $nxt
                   = _hol_driver.expect_declared($cur,
                                                 [Syntax.unwrap('$nm'), ...],
                                                 ~at: '$at')'],
               n + 1)

  // -- the whole body --------------------------------------------------------

  fun emit_all(decls :: List.of(expand.Decl))
       :: values(List.of(Syntax), List.of(Syntax)):
    let (rt, ch, n):
      for values(rt :~ List = [], ch :~ List = [], n = 0) (d in decls):
        let (r, c, n2) = emit_one(d, n)
        values(rt ++ r, ch ++ c, n2)
    values(rt, ch ++ ['def theory = $(st(n))'])

// `check_property` is a genuine, independently bound macro, not a form
// `#%module_block` recognises by scanning -- see the note by
// `emit_property_from` above for why it alone can be one.  Because it is
// bound, `#%module_block`'s generic pass-through (the `#'other` case in
// `emit_one`) is what reaches it: Rhombus's own expansion discovers this
// binding exactly as it would for `fun` or `class`, including when the use
// arrives via a macro of the user's own.
defn.macro 'check_property $rest ...':
  let whole = 'check_property $rest ...'
  let [name, samples, binders, body, size] = elab.check_property_shape(whole)
  emit_property_from(name :~ Syntax, samples, binders :~ List,
                     body :~ Syntax, size, whole)

// Every `#lang rhombus/hol` module carries its theory in a `hol_theory`
// submodule: the whole logical chain, at the submodule's phase 0.
//
// A submodule rather than an exported value, because the name is the same in
// every theory and `open`ing two of them would collide on it.  Submodules are
// reached by path, so an ordinary `import` of a theory needs no adjusting --
// which is what lets `import` do this job at all.
//
// `~lang rhombus` is what makes it a separate module rather than part of this
// one: were it to inherit `rhombus/hol`, this very `#%module_block` would
// process its body.  It is declared before the rest of the module is expanded,
// so the module can import it from `self` -- which is how the proofs come to
// run while the module is compiled rather than when it is used.
//
// The price is that an importer's compilation visits this submodule, which
// re-runs its proofs.  That is paid once per importing compilation.
decl.macro 'module_block: $form; ...':
  let (rt, ch) = emit_all(expand.plan_body([form, ...]))
  let [r, ...] = rt
  let [c, ...] = ch
  '#%module_block:
     module hol_theory ~lang rhombus:
       import: rhombus/hol/private/driver as _hol_driver
       export: theory
       def $(st(0)) = _hol_driver.initial_state()
       $c
       ...
     import: rhombus/hol/private/qc as _hol_qc
     import: meta: self!hol_theory as _hol_self
     $r
     ...'
