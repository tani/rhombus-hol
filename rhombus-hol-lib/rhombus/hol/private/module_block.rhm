#lang rhombus/and_meta

// The `#%module_block` of `#lang rhombus/hol`.
//
// Proof obligations are discharged eagerly, inside the `theorem` form, so this
// hook is *not* where proving happens.  It exists to seed the per-module HOL
// state and to report end-of-module diagnostics.

import:
  meta:
    "kernel.rhm" as kernel

export:
  module_block

decl.macro 'module_block: $form; ...':
  // M0: pass-through.  The `meta:` import above is deliberate -- it proves the
  // language layer can pull the (phase-0-written) kernel in at phase 1.
  let _ = kernel.hol_version
  '#%module_block:
     $form
     ...'
