#lang rhombus/static

// Recursive function definitions.
//
// A definition is given as a list of *clauses* `f(p1, ..., pn) = rhs`, where
// each `pi` is a variable or a constructor applied to distinct variables.
// That clausal shape is not an accident of the surface syntax: it is what the
// rewriter wants (each clause becomes one unconditional rewrite rule) and what
// the induction-scheme generator reads.
//
// Like `datatype.rhm`, this module postulates rather than derives.  Once
// termination, exhaustiveness and non-overlap are established, the clausal
// equations are a conservative extension -- that is the standard argument --
// and `install_function` is the single seam behind which the postulation
// happens.  Replacing it with a `WF_REC` derivation changes nothing above it.

import:
  rhombus/hol/private/htype open
  rhombus/hol/private/term open
  rhombus/hol/private/names open
  rhombus/hol/private/kernel open
  rhombus/hol/private/printer open
  "bool.rhm" open
  "datatype.rhm" open
  "terminate.rhm" open

export:
  DefClause
  FunSpec
  FunInfo
  fun_type
  install_function
  recursive_calls
  pattern_vars
  pattern_ctor
  check_function_spec

// `f(pats...) === rhs`.  The variables are those bound by the patterns.
class DefClause(pats :: List.of(Term), rhs :: Term)

// `measure` is the author's `~measure(e)`, as an abstraction over the
// parameters; `#false` when they gave none and the definition has to descend
// structurally.
class FunSpec(name :: Symbol,
              arg_types :: List.of(HType),
              ret_type :: HType,
              clauses :: List.of(DefClause),
              measure :: maybe(Term) = #false)

class FunInfo(spec :: FunSpec,
              fn :: Term,                  // the declared constant
              equations :: List.of(Thm),   // one per clause, universally closed
              recinfo :: RecursionInfo)

fun fun_type(spec :: FunSpec) :: HType:
  for values(ty :~ HType = spec.ret_type) (a in spec.arg_types.reverse()):
    mk_fun(a, ty)

// -- pattern checking ------------------------------------------------------

// A pattern is a variable, or a constructor applied to patterns -- which may
// themselves be variables or further constructor patterns, nested to any
// depth (`Cons(x, Cons(y, zs))` is as much a pattern as `Cons(x, zs)`).  What
// is *not* a pattern is a constructor applied to a general term: patterns
// describe a shape to test and destructure, and only variables and nested
// constructor applications are shapes -- an arbitrary computed term has no
// well-defined "which constructor, at which arguments" to check exhaustion
// or overlap against.
fun pattern_vars(who :: Symbol, p :: Term) :: List.of(FVar):
  match p
  | FVar(_, _): [p :~ FVar]
  | ~else:
      let (head, args) = strip_comb(p)
      match head
      | Const(_, _):
          for values(acc :~ List = []) (a in args):
            acc ++ pattern_vars(who, a)
      | ~else:
          error(~who: who, "not a pattern",
                error.val(~label: "pattern", show(p)))

// The constructor a pattern matches, or `#false` for a variable pattern.
fun pattern_ctor(p :: Term) :: maybe(Symbol):
  match p
  | FVar(_, _): #false
  | ~else:
      let (head, _) = strip_comb(p)
      match head
      | Const(n, _): n
      | ~else: #false

fun check_distinct(who :: Symbol, vs :: List.of(FVar)) :: Void:
  recur loop (vs :~ List = vs, seen :~ List = []):
    match vs
    | []: #void
    | List.cons(v, rest):
        when seen.contains(v)
        | error(~who: who, "pattern variable is repeated",
                error.val(~label: "variable", (v :~ FVar).name))
        loop(rest, List.cons(v, seen))

// -- recursive calls -------------------------------------------------------

// Every application of `fn` to a full argument list inside `t`.
fun recursive_calls(fn :: Term, arity :: Int, t :: Term) :: List.of(List.of(Term)):
  fun walk(t :: Term, acc :~ List) :~ List:
    let acc2:
      let (head, args) = strip_comb(t)
      cond
      | head == fn && args.length() == arity: acc ++ [args]
      | ~else: acc
    match t
    | Comb(f, x): walk(x, walk(f, acc2))
    | Abs(_, b): walk(b, acc2)
    | ~else: acc2
  walk(t, [])

// -- installation ----------------------------------------------------------

// `dts` maps a type constructor name to its datatype declaration, so that
// exhaustiveness can be checked against the real constructor list.
// `discharge` proves a measure obligation, returning `#false` on success and
// a residue message otherwise.  It is a callback because the prover is built
// on top of this module, not below it.
fun check_function_spec(thy :: Theory, spec :: FunSpec,
                        dts :: Map.of(Symbol, DatatypeSpec)) :: Void:
  let who = #'function
  let fty = fun_type(spec)
  when const_type(thy, spec.name) != #false
  | error(~who: who, "constant is already declared",
          error.val(~label: "name", spec.name))
  when spec.clauses.length() == 0
  | error(~who: who, "a definition needs at least one clause",
          error.val(~label: "name", spec.name))
  let arity = spec.arg_types.length()

  // -- shape and typing of each clause
  for (cl in spec.clauses):
    let cl :~ DefClause = cl
    unless cl.pats.length() == arity
    | error(~who: who, "clause has the wrong number of arguments",
            error.val(~label: "name", spec.name),
            error.val(~label: "expected", arity),
            error.val(~label: "given", cl.pats.length()))
    for (p in cl.pats, ty in spec.arg_types):
      unless type_of(p) == ty
      | error(~who: who, "pattern has the wrong type",
              error.val(~label: "pattern", show(p)),
              error.val(~label: "expected", type_to_string(ty)))
    let vs = clause_vars(who, cl)
    check_distinct(who, vs)
    unless type_of(cl.rhs) == spec.ret_type
    | error(~who: who, "clause result has the wrong type",
            error.val(~label: "expected", type_to_string(spec.ret_type)),
            error.val(~label: "given", type_to_string(type_of(cl.rhs))))
    // A variable free in the body but not bound by the patterns would make
    // the equation say something about an arbitrary value.
    for (v in free_vars(cl.rhs)):
      unless vs.contains(v) || v == mk_var(spec.name, fty)
      | error(~who: who, "clause body mentions an unbound variable",
              error.val(~label: "variable", (v :~ FVar).name))

  // -- exhaustiveness and non-overlap, over the pattern matrix
  check_coverage(who, spec, dts)

fun install_function(thy :: Theory,
                     spec :: FunSpec,
                     dts :: Map.of(Symbol, DatatypeSpec),
                     ~discharge: discharge :: maybe(Function.of_arity(1)) = #false)
     :: values(Theory, FunInfo):
  let who = #'function
  let fty = fun_type(spec)
  check_function_spec(thy, spec, dts)
  let arity = spec.arg_types.length()

  // -- termination
  let fn_placeholder = mk_const(spec.name, fty)
  let measure:
    match spec.measure
    | #false: #false
    | m:
        unless discharge
        | error(~who: who,
                "a measure needs a prover to discharge its obligations",
                error.val(~label: "name", spec.name))
        Measure(m :~ Term, discharge :~ Function)
  let recinfo = check_termination(
    who, spec.name, arity,
    spec.clauses.map(fun (cl :: DefClause): [cl.pats, cl.rhs]),
    fn_placeholder,
    ~measure: measure)

  // -- only now is anything added to the theory
  let thy2 = new_constant(thy, spec.name, fty)
  let fn = mk_const(spec.name, fty)
  let (thy3, eqs):
    for values(t :~ Theory = thy2, acc :~ List = []) (cl in spec.clauses):
      let cl :~ DefClause = cl
      let lhs = list_mk_comb(fn, cl.pats)
      let stmt = mk_forall_list(clause_vars(who, cl), mk_eq(lhs, cl.rhs))
      let (t2, th) = new_axiom(t, stmt)
      values(t2, acc ++ [th])
  values(thy3, FunInfo(spec, fn, eqs, recinfo))

fun clause_vars(who :: Symbol, cl :: DefClause) :: List.of(FVar):
  for values(acc :~ List = []) (p in cl.pats): acc ++ pattern_vars(who, p)

// Exhaustiveness and non-overlap, over the whole pattern matrix -- now a
// genuine decision tree, not a flat table.  A "position" is a slot in a
// row's node list; initially there is one position per argument, holding
// that argument's own (possibly deeply nested) pattern.  Checking finds a
// position where some row has a constructor test, requires every
// constructor of that position's type to be covered, and recurs into each
// branch with that position *replaced by its fields* -- spliced into the
// row in place, since a constructor's own fields are new positions to
// check exactly the same way.  A row that is a bare variable there matches
// every constructor, so it is refined with fresh placeholder fields of its
// own (their identity never matters -- coverage checking only asks
// "variable or which constructor" at a position, never what a variable is
// named) rather than dropped, so it stays eligible in every branch and the
// row list's width stays uniform across branches.  A leaf -- no position
// left with a constructor anywhere -- must be a single row, or two clauses
// match the same arguments.
//
// A position is *searched for* rather than taken left to right, because
// nesting need not follow argument order: `match n` outer and `match m`
// inner leaves a matrix that only splits cleanly on the second argument
// first.
class Row(nodes :: List.of(Term), clause :: DefClause)

fun check_coverage(who :: Symbol, spec :: FunSpec,
                   dts :: Map.of(Symbol, DatatypeSpec)) :: Void:
  let rows = spec.clauses.map(fun (cl :: DefClause): Row(cl.pats, cl))
  cover(who, spec, dts, rows)

fun cover(who :: Symbol, spec :: FunSpec, dts :: Map.of(Symbol, DatatypeSpec),
          rows :: List.of(Row)) :: Void:
  match find_splittable(rows)
  | #false:
      // Nothing left to split on: every row is a variable at every
      // position.  More than one such row is an unconditional overlap --
      // nothing left distinguishes them, including a row that started out
      // a bare catch-all variable next to a more specific one.
      unless rows.length() == 1
      | error(~who: who, "two clauses match the same arguments",
              error.val(~label: "name", spec.name),
              error.val(~label: "clause",
                        show(list_mk_comb(mk_const(spec.name, fun_type(spec)),
                                          (rows[0] :~ Row).clause.pats))))
  | idx:
      let idx :~ Int = idx
      let self_ty = type_of((rows[0] :~ Row).nodes[idx])
      let dt = datatype_at_type(who, spec, dts, self_ty)
      for (r in rows):
        let r :~ Row = r
        match pattern_ctor(r.nodes[idx])
        | #false: #void
        | c:
            unless (for any (k in dt.ctors): (k :~ Ctor).name == (c :~ Symbol))
            | error(~who: who,
                    "a constructor that does not build the matched type",
                    error.val(~label: "constructor", c))
      for (c in dt.ctors):
        let c :~ Ctor = c
        let field_tys = ctor_field_types(dt, self_ty, c)
        let branch = for values(acc :~ List = []) (r in rows):
                       let r :~ Row = r
                       match pattern_ctor(r.nodes[idx])
                       | #false:
                           let placeholders = field_tys.map(
                             fun (ty): mk_var(#'_wild, ty :~ HType) :~ Term)
                           acc ++ [Row(splice(r.nodes, idx, placeholders), r.clause)]
                       | cn when cn == c.name:
                           let (_, args) = strip_comb(r.nodes[idx])
                           acc ++ [Row(splice(r.nodes, idx, args), r.clause)]
                       | ~else: acc
        when branch.length() == 0
        | error(~who: who, "definition is not exhaustive",
                error.val(~label: "name", spec.name),
                error.val(~label: "missing constructor", c.name))
        cover(who, spec, dts, branch)

// A position where some row has a constructor test, or `#false` if every
// row is a variable at every position (nothing left to split).
fun find_splittable(rows :: List.of(Row)) :: maybe(Int):
  let width = (rows[0] :~ Row).nodes.length()
  recur loop (i = 0):
    cond
    | i >= width: #false
    | ~else:
        let has_ctor = for any (r in rows): pattern_ctor((r :~ Row).nodes[i]) != #false
        (if has_ctor | i | loop(i + 1))

// `xs` with the element at `i` replaced by every element of `repl` --
// `repl.length() == 1` keeps the list the same length, `== 0` shrinks it by
// one, and anything longer splices in that many new positions.
fun splice(xs :: List.of(Term), i :: Int, repl :: List.of(Term)) :: List.of(Term):
  for values(acc :~ List = []) (x in xs, k in List.iota(xs.length())):
    (if k == i | acc ++ repl | acc ++ [x])

// `c`'s field types, instantiated at the concrete type arguments `self_ty`
// actually carries -- `dt`'s own parameters name the constructor's generic
// field types, so a positional substitution turns them concrete (`List(~a)`
// instantiated at `List(Nat)` turns `Cons`'s `tail :: List(~a)` field into
// `List(Nat)`, matching the type the placeholder or nested sub-pattern at
// that position actually has).
fun ctor_field_types(dt :: DatatypeSpec, self_ty :: HType,
                     c :: Ctor) :: List.of(HType):
  let args :~ List = (match self_ty | TyApp(_, a): a | ~else: [])
  let theta = for values(m :~ Map = {}) (p in dt.params, a in args):
                m ++ {p :~ Symbol: a :~ HType}
  c.fields.map(fun (f :: Field): type_subst(theta, f.ty))

fun datatype_at_type(who :: Symbol, spec :: FunSpec,
                     dts :: Map.of(Symbol, DatatypeSpec), ty :: HType) :: DatatypeSpec:
  let tyname = (match ty
                | TyApp(n, _): n
                | ~else:
                    error(~who: who,
                          "cannot match on an argument of variable type",
                          error.val(~label: "name", spec.name)))
  match dts.get(tyname, #false)
  | #false:
      error(~who: who, "no datatype declaration for the matched type",
            error.val(~label: "type", tyname))
  | d: d :~ DatatypeSpec
