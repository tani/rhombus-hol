#lang rhombus/static

// Recursive function definitions.
//
// A definition is given as a list of *clauses* `f(p1, ..., pn) = rhs`, where
// each `pi` is a variable or a constructor applied to distinct variables.
// That clausal shape is not an accident of the surface syntax: it is what the
// rewriter wants (each clause becomes one unconditional rewrite rule) and what
// the induction-scheme generator reads.
//
// This module holds the shared function specification, the well-formedness
// checks every declaration goes through, and the one seam that installs a
// definition by *postulating* its equations.
//
// That seam is no longer how an ordinary `function` is installed.  Those are
// derived -- `funcases.rhm` when the definition does not recurse,
// `stepfn.rhm`'s `WFREC` derivation when it does -- and a declaration whose
// recursion has no order the deriver can build is refused rather than
// postulated.  `install_function` is reached only from
// `axiomatic_function`, which exists to say in the source that a definition
// was assumed.
//
// The argument that postulating is conservative is unchanged and still the
// reason the seam is allowed to exist: once termination, exhaustiveness and
// non-overlap are established, the clausal equations are a conservative
// extension.  What changed is that a reader no longer has to know which
// recursion schemes this version handles in order to know whether a given
// declaration relied on that argument.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  "bool.rhm" open
  "datatype.rhm" open
  "drule.rhm" open
  "terminate.rhm" open
  "dtree.rhm" open

export:
  DefClause
  clause_terms
  FunSpec
  FunInfo
  fun_type
  install_function
  recursive_calls
  pattern_vars
  pattern_ctor
  check_function_spec
  function_decision_tree

// `f(pats...) === rhs`.  The variables are those bound by the patterns.
// `rhs` is the logical reading of the body; `obligations` is every term the
// compiled program evaluates on the way to it (`core.rhm`).  For a body with
// no `let` the two carry the same information, and `obligations` is the
// single-element list holding `rhs`.  They come apart exactly where a `let`
// initializer's value is not read: the equation does not mention it, and the
// program still runs it, so termination has to see it.
class DefClause(pats :: List.of(Term), rhs :: Term,
                obligations :: List.of(Term) = [])

// `measure` is the author's `~measure(e)`, as an abstraction over the
// parameters; `#false` when they gave none and the definition has to descend
// structurally.
// Every term of a clause the compiled program evaluates.  A `DefClause`
// built without obligations -- by a library that generates its own clauses
// rather than elaborating a body -- evaluates exactly its right-hand side.
fun clause_terms(cl :: DefClause) :: List.of(Term):
  cond
  | cl.obligations.length() == 0: [cl.rhs]
  | ~else: cl.obligations

class FunSpec(name :: Symbol,
              arg_types :: List.of(HType),
              ret_type :: HType,
              clauses :: List.of(DefClause),
              measure :: maybe(Term) = #false)

class FunInfo(spec :: FunSpec,
              fn :: Term,                  // the declared constant
              equations :: List.of(Thm),   // one per clause, universally closed
              recinfo :: RecursionInfo)

fun fun_type(spec :: FunSpec) :: HType:
  for values(ty :~ HType = spec.ret_type) (a in spec.arg_types.reverse()):
    mk_fun(a, ty)

// -- pattern checking ------------------------------------------------------

// A pattern is a variable, or a constructor applied to patterns -- which may
// themselves be variables or further constructor patterns, nested to any
// depth (`Cons(x, Cons(y, zs))` is as much a pattern as `Cons(x, zs)`).  What
// is *not* a pattern is a constructor applied to a general term: patterns
// describe a shape to test and destructure, and only variables and nested
// constructor applications are shapes -- an arbitrary computed term has no
// well-defined "which constructor, at which arguments" to check exhaustion
// or overlap against.
fun pattern_vars(who :: Symbol, p :: Term) :: List.of(FVar):
  match p
  | FVar(_, _): [p :~ FVar]
  | ~else:
      let (head, args) = strip_comb(p)
      match head
      | Const(_, _):
          for values(acc :~ List = []) (a in args):
            acc ++ pattern_vars(who, a)
      | ~else:
          error(~who: who, "not a pattern",
                error.val(~label: "pattern", show(p)))

// The constructor a pattern matches, or `#false` for a variable pattern.
fun pattern_ctor(p :: Term) :: maybe(Symbol):
  match p
  | FVar(_, _): #false
  | ~else:
      let (head, _) = strip_comb(p)
      match head
      | Const(n, _): n
      | ~else: #false

fun check_distinct(who :: Symbol, vs :: List.of(FVar)) :: Void:
  recur loop (vs :~ List = vs, seen :~ List = []):
    match vs
    | []: #void
    | List.cons(v, rest):
        when seen.contains(v)
        | error(~who: who, "pattern variable is repeated",
                error.val(~label: "variable", (v :~ FVar).name))
        loop(rest, List.cons(v, seen))

// -- recursive calls -------------------------------------------------------

// Every application of `fn` to a full argument list inside `t`.
fun recursive_calls(fn :: Term, arity :: Int, t :: Term) :: List.of(List.of(Term)):
  fun walk(t :: Term, acc :~ List) :~ List:
    let acc2:
      let (head, args) = strip_comb(t)
      cond
      | head == fn && args.length() == arity: acc ++ [args]
      | ~else: acc
    match t
    | Comb(f, x): walk(x, walk(f, acc2))
    | Abs(_, b): walk(b, acc2)
    | ~else: acc2
  walk(t, [])

// -- installation ----------------------------------------------------------

// `dts` maps a type constructor name to its datatype declaration, so that
// exhaustiveness can be checked against the real constructor list.
// `discharge` proves a measure obligation, returning `#false` on success and
// a residue message otherwise.  It is a callback because the prover is built
// on top of this module, not below it.
fun check_function_spec(thy :: Theory, spec :: FunSpec,
                        dts :: Map.of(Symbol, DatatypeSpec)) :: Void:
  let who = #'function
  let fty = fun_type(spec)
  when const_type(thy, spec.name) != #false
  | error(~who: who, "constant is already declared",
          error.val(~label: "name", spec.name))
  when spec.clauses.length() == 0
  | error(~who: who, "a definition needs at least one clause",
          error.val(~label: "name", spec.name))
  let arity = spec.arg_types.length()

  // -- shape and typing of each clause
  for (cl in spec.clauses):
    let cl :~ DefClause = cl
    unless cl.pats.length() == arity
    | error(~who: who, "clause has the wrong number of arguments",
            error.val(~label: "name", spec.name),
            error.val(~label: "expected", arity),
            error.val(~label: "given", cl.pats.length()))
    for (p in cl.pats, ty in spec.arg_types):
      unless type_of(p) == ty
      | error(~who: who, "pattern has the wrong type",
              error.val(~label: "pattern", show(p)),
              error.val(~label: "expected", type_to_string(ty)))
    let vs = clause_vars(who, cl)
    check_distinct(who, vs)
    unless type_of(cl.rhs) == spec.ret_type
    | error(~who: who, "clause result has the wrong type",
            error.val(~label: "expected", type_to_string(spec.ret_type)),
            error.val(~label: "given", type_to_string(type_of(cl.rhs))))
    // A variable free in the body but not bound by the patterns would make
    // the equation say something about an arbitrary value.
    for (v in free_vars(cl.rhs)):
      unless vs.contains(v) || v == mk_var(spec.name, fty)
      | error(~who: who, "clause body mentions an unbound variable",
              error.val(~label: "variable", (v :~ FVar).name))

  // -- exhaustiveness and non-overlap, over the pattern matrix
  check_coverage(who, spec, dts)

fun install_function(thy :: Theory,
                     spec :: FunSpec,
                     dts :: Map.of(Symbol, DatatypeSpec),
                     ~discharge: discharge :: maybe(Function.of_arity(1)) = #false)
     :: values(Theory, FunInfo):
  let who = #'function
  let fty = fun_type(spec)
  check_function_spec(thy, spec, dts)
  let arity = spec.arg_types.length()
  let tree = function_decision_tree(who, spec, dts)

  // -- termination
  let fn_placeholder = mk_const(spec.name, fty)
  let measure:
    match spec.measure
    | #false: #false
    | m:
        unless discharge
        | error(~who: who,
                "a measure needs a prover to discharge its obligations",
                error.val(~label: "name", spec.name))
        Measure(m :~ Term, discharge :~ Function)
  let recinfo = check_termination(
    who, spec.name, arity,
    spec.clauses.map(fun (cl :: DefClause): [cl.pats, clause_terms(cl)]),
    fn_placeholder,
    ~measure: measure)

  // -- a definition that is only a definition
  //
  // One clause, distinct variables for patterns, no reference to itself:
  // there is nothing to compile and nothing to justify, and `f = \xs. rhs`
  // is exactly what `new_basic_definition` takes.  Going through the seam
  // below instead would postulate an equation the kernel would have handed
  // over for free.
  cond
  | can_define_directly(spec):
      let cl :~ DefClause = spec.clauses[0]
      let vars = for List (p in cl.pats): (p :~ FVar)
      let body = for values(b :~ Term = cl.rhs) (v in vars.reverse()):
                   mk_abs(v :~ FVar, b)
      let (thy2, def_th) = new_basic_definition(thy, mk_eq(mk_var(spec.name,
                                                                  fty),
                                                           body))
      let eqn = GENL(thy2, vars,
                     unfold_def(thy2, def_th,
                                vars.map(fun (v :: FVar): v :~ Term)))
      values(thy2, FunInfo(spec, mk_const(spec.name, fty), [eqn], recinfo))
  | ~else:
      // -- only now is anything added to the theory
      let thy2 = new_constant(thy, spec.name, fty)
      let fn = mk_const(spec.name, fty)
      // One axiom per *leaf* of the decision tree, not per clause as written.
      //
      // Clauses are ordered, so a clause that an earlier one shadows at some
      // argument shapes does not hold at those shapes, and postulating it as
      // written would be inconsistent: `f(Nil) = a` beside `!x. f(x) = b` says
      // `a = b`.  The leaves are exactly the shapes where each clause actually
      // wins.  This is also what `install_structural_function` derives, so a
      // definition means the same thing whichever seam installed it.
      let dt_of = for values(m :~ Map = {}) ((n, d) in dts): m ++ {n: d}
      let roots = for List (ty in spec.arg_types, i in List.iota(arity)):
                    mk_var(Symbol.from_string("_eqx" ++ to_string(i)),
                           ty :~ HType) :~ Term
      let (thy3, eqs):
        for values(t :~ Theory = thy2, acc :~ List = []) (ls in leaf_shapes(dt_of, tree, roots)):
          let ls :~ LeafShape = ls
          let pats :~ List = ls.patterns
          let cl :~ DefClause = spec.clauses[ls.clause]
          let rename = for List (b in ls.bindings):
                         let b :~ DTBinding = b
                         [path_subterm(pats, b.path), b.var]
          let lhs = list_mk_comb(fn, pats)
          let stmt = mk_forall_list(row_vars(pats),
                                    mk_eq(lhs, inst_fvar(rename, cl.rhs)))
          let (t2, th) = new_axiom(t, stmt)
          values(t2, acc ++ [th])
      values(thy3, FunInfo(spec, fn, eqs, recinfo))

// One clause, every pattern a distinct variable, no self-reference: a plain
// definition, not a recursion to justify or a match to compile.  A measure
// disqualifies it only because a measure implies the author expected
// recursion; there would be nothing for it to discharge.
fun can_define_directly(spec :: FunSpec) :: Boolean:
  cond
  | spec.clauses.length() != 1: #false
  | spec.measure: #false
  | ~else:
      let cl :~ DefClause = spec.clauses[0]
      let vars = for values(acc :~ List = []) (p in cl.pats):
                   if p is_a FVar | acc ++ [p] | acc
      cond
      | vars.length() != cl.pats.length(): #false
      | distinct_vars(vars).length() != vars.length(): #false
      | ~else: !mentions(mk_const(spec.name, fun_type(spec)), cl.rhs)

fun distinct_vars(vs :: List.of(FVar)) :: List.of(FVar):
  for values(acc :~ List = []) (v in vs):
    if acc.contains(v) | acc | acc ++ [v]

fun clause_vars(who :: Symbol, cl :: DefClause) :: List.of(FVar):
  for values(acc :~ List = []) (p in cl.pats): acc ++ pattern_vars(who, p)

// Exhaustiveness and non-overlap are exactly the well-formedness of the
// decision tree the patterns compile to, so they are checked by compiling
// it (`dtree.rhm`) and discarding the result.  `install_structural_function`
// (`stepfn.rhm`) compiles the same matrix and *keeps* the tree, which is
// what lets a nested pattern reach the `WFREC` derivation instead of
// falling back here.
fun check_coverage(who :: Symbol, spec :: FunSpec,
                   dts :: Map.of(Symbol, DatatypeSpec)) :: Void:
  function_decision_tree(who, spec, dts)
  #void

// The decision tree for `spec`'s clauses, checked on the way.
fun function_decision_tree(who :: Symbol, spec :: FunSpec,
                           dts :: Map.of(Symbol, DatatypeSpec)) :: DecisionTree:
  compile_patterns(who, spec.name,
                   spec.clauses.map(fun (cl :: DefClause): cl.pats),
                   dts,
                   ~show_clause: fun (i :: Int):
                                   show(list_mk_comb(
                                     mk_const(spec.name, fun_type(spec)),
                                     (spec.clauses[i] :~ DefClause).pats)))
