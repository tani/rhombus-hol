#lang rhombus/static
// SPDX-License-Identifier: 0BSD AND BSD-3-Clause
// Adapts ACL2 rule behavior and type-prescription classes; see THIRD_PARTY_NOTICES.


// Rewrite rules and the database they live in.
//
// A rule is only constructible from a `Thm`, so a rule can never assert more
// than a theorem does.  Applying one goes back through the kernel -- the rule
// carries its own justifying theorem and instantiates it -- so a bug here can
// make rewriting fail or loop, never make it unsound.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  "order.rhm" open
  "bool.rhm" open
  "conv.rhm" open
  "drule.rhm" open
  "tmatch.rhm" open

export:
  RewriteRule
  RuleDB
  empty_db
  mk_rule
  spec_all_vars
  add_rule
  add_thm
  add_rewrite_thm
  add_thms
  disable
  enable
  rules_of
  rule_names
  type_facts_of
  db_conv
  refl_conv
  simp_conv

class RewriteRule(name :: Symbol,
                  // the specialised theorem `|- cond1 ==> ... ==> lhs === rhs`
                  // (an empty `conds` when there are none); instantiating it
                  // and discharging each instantiated `cond` is how the rule
                  // fires
                  src :: Thm,
                  vars :: List.of(FVar),
                  conds :: List.of(Term),
                  lhs :: Term,
                  rhs :: Term,
                  head :: Symbol,
                  // lhs and rhs are variants of one another, so the rule can
                  // only be allowed to fire downhill
                  permutative :: Boolean)

// `type_by_head` is a second, independent classification of the same
// theorems `add_thm` sees: ACL2's rule classes are not mutually exclusive,
// and a fact of the shape `|- forall xs. P(f(xs))` is registered *both* as
// an ordinary rewrite rule for `P` (unchanged from before -- ordinary
// rewriting is not touched by this) *and*, separately, as a type fact about
// what `f`'s result always satisfies, keyed by `f` rather than by `P`.
//
// Each entry is `[registered_name, fact]`.  The name is not the key -- a
// fact about `f` is found by asking about `f` -- but it is what `disable`
// matches on, so that switching off a name reaches its type fact as well as
// its rewrite rule.  Every existing `rules_of` query returns exactly what
// it always did.
class RuleDB(by_head :: Map.of(Symbol, List.of(RewriteRule)),
             disabled :: Set.of(Symbol),
             type_by_head :: Map.of(Symbol, List))

def empty_db :: RuleDB = RuleDB({}, Set(), {})

// -- building a rule from a theorem ----------------------------------------

// Constant-headed rules are global. An unquantified free-variable head is
// also safe for a goal assumption: with no pattern variables it matches only
// that exact term, never arbitrary expressions.
fun head_symbol(t :: Term) :: maybe(Symbol):
  let (h, _) = strip_comb(t)
  match h
  | Const(n, _): n
  | FVar(n, _): n
  | ~else: #false

// Orient a proved statement into an equation:
//   `l === r`  ->  as it stands
//   `not p`    ->  `p <=> false`
//   `p`        ->  `p <=> true`
fun orient(thy :: Theory, th :: Thm) :: Thm:
  let c = concl_of(th)
  cond
  | is_eq(c): th
  | is_neg(c): EQF_INTRO(thy, th)
  | ~else: EQT_INTRO(thy, th)

// `#false` when the theorem cannot serve as a rewrite rule, with `why`
// explaining which condition failed.
// Strip the leading quantifiers, reporting which variables were stripped.
//
// Those, and *only* those, are the rule's pattern variables.  Taking
// `free_vars(lhs)` instead would be a serious bug: an assumption is a fact
// about particular variables, not a schema, and treating its variables as
// patterns lets the induction hypothesis `app(y, nil) === y` match
// `app(cons(x, y), nil)` with `y := cons(x, y)` -- so the goal rewrites to
// `true` while the justifying theorem quietly carries the *goal itself* as a
// hypothesis.  The proof then fails much later, at the `GEN` that cannot
// discharge it.
fun spec_all_vars(thy :: Theory, th :: Thm) :: values(List.of(FVar), Thm):
  recur loop (th :~ Thm = th, acc :~ List = []):
    cond
    | is_forall(concl_of(th)):
        let [v0, _] = (match dest_forall(concl_of(th)) | pair: pair)
        let v = variant(hyps_of(th) ++ [concl_of(th)], v0 :~ FVar)
        loop(SPEC(thy, v, th), acc ++ [v])
    | ~else: values(acc, th)

// A theorem `|- cond1 ==> ... ==> condn ==> consequent` becomes a
// *conditional* rewrite rule: `conds` are carried along, unoriented, and
// only the final `consequent` is turned into an equation (ACL2's rewrite
// rules work the same way -- the hypotheses are side conditions to
// discharge at firing time, not part of what gets rewritten). Peel the
// antecedents off with `UNDISCH` to expose `consequent` for `orient`, then
// put them back with `DISCH` in the same nesting order -- this is not
// postulating anything new, just repackaging `th` through primitive rules.
fun strip_conditions(thy :: Theory, spec :: Thm) :: values(List.of(Term), Thm):
  let (conds, consequent) = strip_imp(concl_of(spec))
  cond
  | conds.length() == 0: values([], orient(thy, spec))
  | ~else:
      let peeled = for values(acc :~ Thm = spec) (c in conds): UNDISCH(thy, acc)
      let oriented = orient(thy, peeled)
      let redischarged = for values(acc :~ Thm = oriented) (c in conds.reverse()):
                           DISCH(thy, c, acc)
      values(conds, redischarged)

fun mk_rule(thy :: Theory, name :: Symbol, th :: Thm)
     :: maybe(RewriteRule):
  let (pvars, spec) = spec_all_vars(thy, th)
  mk_rule_from_spec(thy, name, pvars, spec)

// `add_thm` may classify the same theorem both as rewrite and
// type-prescription. It supplies this already-specialized view so quantified
// variables are instantiated exactly once.
fun mk_rule_from_spec(thy :: Theory, name :: Symbol,
                      pvars :: List.of(FVar), spec0 :: Thm)
     :: maybe(RewriteRule):
  let (conds, spec) = strip_conditions(thy, spec0)
  let (_, consequent) = strip_imp(concl_of(spec))
  match dest_eq(consequent)
  | #false: #false
  | [lhs, rhs]:
      let lfv = free_vars(lhs)
      let vars = pvars.filter(~keep: fun (v :: FVar): lfv.contains(v))
      let rvars = pvars.filter(~keep: fun (v :: FVar): vfree_in(v, rhs))
      // A side condition may mention a pattern variable the left side does
      // not determine either -- exactly the same hazard `rvars` guards
      // against on the right side, and for the same reason: matching would
      // leave it uninstantiated.
      let cvars = for values(acc :~ List = []) (c in conds):
                    for values(a :~ List = acc) (v in pvars):
                      (if vfree_in(v, c) && !a.contains(v) | a ++ [v] | a)
      cond
      // A quantified variable left-hand side would match the whole world.
      // An unquantified assumption variable is an exact-match local rule.
      | lhs is_a FVar && vars.length() > 0: #false
      // A pattern variable on the right that the left side does not determine
      // would be left uninstantiated by matching.
      | !(for all (v in rvars): vars.contains(v)): #false
      | !(for all (v in cvars): vars.contains(v)): #false
      | lhs == rhs: #false
      | ~else:
          match head_symbol(lhs)
          | #false: #false
          | h:
              // A type variable only on the right would likewise be
              // undetermined by the match.
              let ltv = type_vars_of(lhs)
              let rtv = type_vars_of(rhs)
              cond
              | !(for all (v in rtv): ltv.contains(v)): #false
              | ~else:
                  RewriteRule(name, spec, vars, conds, lhs, rhs, h,
                              is_variant(vars, lhs, rhs))
fun type_vars_of(t :: Term) :: List.of(Symbol):
  fun add(ty :: HType, acc :~ List) :~ List:
    for values(a :~ List = acc) (x in type_vars(ty)):
      (if a.contains(x) | a | a ++ [x])
  fun walk(t :: Term, acc :~ List) :~ List:
    match t
    | FVar(_, ty): add(ty, acc)
    | BVar(_, ty): add(ty, acc)
    | Const(_, ty): add(ty, acc)
    | Comb(f, x): walk(x, walk(f, acc))
    | Abs(aty, b): walk(b, add(aty, acc))
  walk(t, [])

// Each side matches the other: `x + y === y + x`, `x + (y + z) === y + (x + z)`.
// Such a rule can always fire again on its own output, so it may only run
// downhill under `term_order`.
fun is_variant(vars :: List.of(FVar), lhs :: Term, rhs :: Term) :: Boolean:
  let rvars = vars.filter(~keep: fun (v :: FVar): vfree_in(v, rhs))
  term_match(vars, lhs, rhs) != #false && term_match(rvars, rhs, lhs) != #false

// -- the database ----------------------------------------------------------

fun add_rule(db :: RuleDB, r :: RewriteRule) :: RuleDB:
  let cur = db.by_head.get(r.head, [])
  // Newest first, as ACL2 does: a later rule shadows an earlier one.
  RuleDB(db.by_head ++ {r.head: List.cons(r, cur :~ List)}, db.disabled, db.type_by_head)

// The function a type-prescription fact is about, or `#false`.
//
// A type-prescription is a plain Boolean fact `|- forall vs. P(f(vs...))`:
// not an equation (an equation is already a rewrite rule and needs no
// second classification), with the whole proposition applying some
// predicate to a *single* argument headed by a declared function `f`. This
// deliberately does not try to recognise `P(f(vs), other)` or other shapes;
// widening it is easy later and narrowing a published classification is
// not.
fun type_prescription_head(spec :: Thm) :: maybe(Symbol):
  let c = concl_of(spec)
  cond
  | is_eq(c): #false
  | ~else:
      match c
      | Comb(_, arg):
          let (h, _) = strip_comb(arg)
          match h
          | Const(n, _): n
          | ~else: #false
      | ~else: #false

// Add a theorem as both applicable rule classes after one quantifier
// specialization. Assumption contexts use `add_rewrite_thm` below instead,
// because they never participate in type-prescription search.
fun add_thm(thy :: Theory, db :: RuleDB, name :: Symbol, th :: Thm) :: RuleDB:
  let (pvars, spec) = spec_all_vars(thy, th)
  let db2 :~ RuleDB:
    match mk_rule_from_spec(thy, name, pvars, spec)
    | #false: db
    | rule: add_rule(db, rule)
  match type_prescription_head(spec)
  | #false: db2
  | fname:
      let cur = db2.type_by_head.get(fname, [])
      RuleDB(db2.by_head, db2.disabled,
             db2.type_by_head ++ {fname: List.cons([name, th], cur :~ List)})

// Add only a rewrite rule. Local assumptions are never queried as
// type-prescription facts, so classifying them there is avoidable work.
fun add_rewrite_thm(thy :: Theory, db :: RuleDB, name :: Symbol,
                    th :: Thm) :: RuleDB:
  match mk_rule(thy, name, th)
  | #false: db
  | rule: add_rule(db, rule)

// A definition contributes one rule per clause; they share a name so that
// `disable` can switch the whole definition off at once.
fun add_thms(thy :: Theory, db :: RuleDB, name :: Symbol,
             ths :: List.of(Thm)) :: RuleDB:
  for values(d :~ RuleDB = db) (th in ths): add_thm(thy, d, name, th)

// `disable` and `enable` swap only the suppressed set, so a scoped rule
// change shares the whole index with its parent.
fun disable(db :: RuleDB, names :: List.of(Symbol)) :: RuleDB:
  let disabled2 = for values(s :~ Set = db.disabled) (n in names): s ++ {n}
  RuleDB(db.by_head, disabled2, db.type_by_head)

fun enable(db :: RuleDB, names :: List.of(Symbol)) :: RuleDB:
  let disabled2 = for values(s :~ Set = db.disabled) (n in names): s.remove(n)
  RuleDB(db.by_head, disabled2, db.type_by_head)

fun rules_of(db :: RuleDB, head :: Symbol) :: List.of(RewriteRule):
  (db.by_head.get(head, []) :~ List).filter(
    ~skip: fun (r :: RewriteRule): r.name in db.disabled)

fun rule_names(db :: RuleDB) :: List.of(Symbol):
  for values(acc :~ List = []) ((_, rs) in db.by_head):
    acc ++ (rs :~ List).map(fun (r :: RewriteRule): r.name)

// Every *enabled* type-prescription fact registered about `head`'s results,
// newest first.
//
// Filtered by `disabled` exactly as `rules_of` is.  ACL2's `disable` takes a
// name and silences every rune wearing it -- `(:rewrite f)` and
// `(:type-prescription f)` alike -- and that is what a user writing
// `~in_theory: [f]` or `disable_rules [f]` is asking for: stop using what
// you know under that name.  Leaving type facts on would let a
// generalization keep quietly consuming a fact the proof had just been told
// to do without, which is the opposite of what an in-theory hint is for.
fun type_facts_of(db :: RuleDB, head :: Symbol) :: List.of(Thm):
  for values(acc :~ List = []) (e in (db.type_by_head.get(head, []) :~ List)):
    let [n, th] = e :~ List
    (if (n :~ Symbol) in db.disabled | acc | acc ++ [th :~ Thm])

// -- rewriting -------------------------------------------------------------

// Instantiate a rule and, if it has side conditions, try to discharge each
// one by simplifying it against the *same* database with this rule's own
// name disabled first.  Excluding the rule from its own conditions' proof is
// not a shortcut for termination -- discharging can still recurse through
// every *other* enabled rule, and `simp_conv`'s own termination properties
// (or lack of them) are unchanged either way -- it exists so
// that a rule can never be used to prove its own side condition circularly,
// which would make firing it prove nothing.  A condition that fails to
// discharge just means the rule does not fire here, exactly like a
// non-matching left-hand side: never an error, never a wrong rewrite.
fun apply_rule(r :: RewriteRule, thy :: Theory, db :: RuleDB, t :: Term)
     :: maybe(Thm):
  match term_match(r.vars, r.lhs, t)
  | #false: #false
  | m :~ MatchResult:
      // Instantiate the theorem first, then read the conditions off *it*.
      //
      // The conditions used to be instantiated separately, as
      // `inst_type(m.tyin, inst_fvar(m.theta, c))` -- terms before types,
      // which is the opposite order from the theorem's own
      // `INST(theta, INST_TYPE(tyin, src))`.  `m.theta`'s replacements are
      // already at the instantiated types, so for a polymorphic rule the
      // separately built condition came out at the wrong type and could
      // never be discharged: `!x:?a. P x ==> f x = g x` simply never fired
      // at a concrete type, even with `P(c)` in the database.
      //
      // Reading them back from the instantiated theorem removes the second
      // copy entirely, so there is no order left to get wrong.  `r.conds`
      // stays as an index for display and admission checks.
      let inst_th = INST(thy, m.theta, INST_TYPE(thy, m.tyin, r.src))
      let (inst_conds, _) = strip_imp(concl_of(inst_th))
      match discharge_all(thy, disable(db, [r.name]), inst_conds)
      | #false: #false
      | proofs :~ List:
          let th = for values(acc :~ Thm = inst_th) (p in proofs): MP(thy, acc, p :~ Thm)
          // Stripping implications off the instantiated theorem can in
          // principle leave something that is not an equation; that is a
          // rule that does not apply, not an internal error.
          match dest_eq(concl_of(th))
          // Stripping implications off the instantiated theorem can in
          // principle leave something that is not an equation; that is a
          // rule which does not apply, not an internal error.
          | #false: #false
          | [l, rr]:
              cond
              // The match should have produced exactly this term; if it did
              // not, the rule would silently rewrite something else.
              | l != t: #false
              // A permutative rule fires only when it strictly decreases the
              // term, so it cannot oscillate.
              | r.permutative && !term_lt(rr, l): #false
              | ~else: th

// A proof of each condition in order, or `#false` if any one does not
// simplify all the way to `true`.
fun discharge_all(thy :: Theory, db :: RuleDB, conds :: List.of(Term))
     :: maybe(List.of(Thm)):
  match conds
  | []: []
  | List.cons(c, rest):
      match simp_conv(db)(thy, c)
      | #false: #false
      | eq :~ Thm when rhs_of(eq) == tm_true:
          match discharge_all(thy, db, rest)
          | #false: #false
          | more: List.cons(EQT_ELIM(thy, eq), more :~ List)
      | ~else: #false

// Try every enabled rule whose head matches, newest first.
// Each *candidate* costs a step, not just each successful rewrite: a large
// database tried repeatedly is work whether or not anything fires, and
// discharging a rule's side conditions recurses back through here.
fun db_conv(db :: RuleDB):
  fun (thy :: Theory, t :: Term) :: maybe(Thm):
    match head_symbol(t)
    | #false: #false
    | h:
        // Walk the indexed list directly. `rules_of` remains the allocating
        // public inspection API; simplification does not need its filtered
        // intermediate list.
        recur loop (rs :~ List = db.by_head.get(h, [])):
          match rs
          | []: #false
          | List.cons(r, rest):
              let rule :~ RewriteRule = r
              cond
              | rule.name in db.disabled: loop(rest)
              | ~else:
                  match apply_rule(rule, thy, db, t)
                  | #false: loop(rest)
                  | th: th


// Close the tiny equality/implication tautologies that arise before the
// waterfall's induction stage. Keeping these local avoids a general
// implication-introduction pass, which would consume guarded measure goals
// before induction can analyze them.
fun implication_fallback(thy :: Theory, p :: Term, q :: Term) :: maybe(Thm):
  match dest_disj(q)
  | [left, right] when right == p:
      EQT_INTRO(thy, DISCH(thy, p, DISJ2(thy, left, ASSUME(thy, p))))
  | [left, right] when left == p:
      EQT_INTRO(thy, DISCH(thy, p, DISJ1(thy, ASSUME(thy, p), right)))
  | ~else:
      match [dest_forall(p), dest_eq(q)]
      | [[x, body1], [f, g]]:
          match dest_forall(body1)
          | [y, body]:
              match dest_eq(body)
              | [Comb(Comb(f2, x2), y2), Comb(Comb(g2, x3), y3)] when f == f2 && g == g2 && x == x2 && x == x3 && y == y2 && y == y3:
                  let asm = ASSUME(thy, p)
                  let pointwise = SPEC(thy, y, SPEC(thy, x, asm))
                  EQT_INTRO(thy, DISCH(thy, p, EXT(thy, x, EXT(thy, y, pointwise))))
              | ~else: #false
          | ~else:
              match dest_eq(body1)
              | [Comb(f2, x2), Comb(g2, y2)] when f == f2 && g == g2 && x == x2 && x == y2:
                  EQT_INTRO(thy, DISCH(thy, p, EXT(thy, x, SPEC(thy, x, ASSUME(thy, p)))))
              | ~else: #false
      | ~else:
          match dest_imp(q)
          | [p2, q2]:
              match [dest_eq(p), dest_eq(p2), dest_eq(q2)]
              | [[a, b], [b2, c], [a2, c2]] when a == a2 && b == b2 && c == c2:
                  EQT_INTRO(
                    thy,
                    DISCH(thy, p,
                          DISCH(thy, p2, TRANS(ASSUME(thy, p), ASSUME(thy, p2)))))
              | ~else: #false
          | ~else: #false

fun refl_conv(thy :: Theory, t :: Term) :: maybe(Thm):
  match dest_eq(t)
  | [a, b] when a == b: EQT_INTRO(thy, REFL(thy, a))
  | ~else:
      match dest_imp(t)
      | [p, q] when p == q:
          EQT_INTRO(thy, DISCH(thy, p, ASSUME(thy, p)))
      | [p, q]:
          match [dest_eq(p), dest_eq(q)]
          | [[a, b], [b2, a2]] when a == a2 && b == b2:
              EQT_INTRO(thy, DISCH(thy, p, SYM(thy, ASSUME(thy, p))))
          | [[f, g], [Comb(f2, x), Comb(g2, y)]] when f == f2 && g == g2 && x == y:
              EQT_INTRO(thy, DISCH(thy, p, MK_COMB(ASSUME(thy, p), REFL(thy, x))))
          | [[x, y], [Comb(f, x2), Comb(g, y2)]] when f == g && x == x2 && y == y2:
              EQT_INTRO(thy, DISCH(thy, p, MK_COMB(REFL(thy, f), ASSUME(thy, p))))
          | ~else:
              match dest_forall(p)
              | [v, body]:
                  match term_match([v :~ FVar], body, q)
                  | #false: implication_fallback(thy, p, q)
                  | mr :~ MatchResult:
                      let witness = (mr.theta[0] :~ List)[0] :~ Term
                      EQT_INTRO(thy, DISCH(thy, p, SPEC(thy, witness, ASSUME(thy, p))))
              | #false: implication_fallback(thy, p, q)
      | ~else: #false
// The simplifier's conversion: rewrite top-down, revisiting after each change,
// so that a rule which collapses a whole subterm saves the work of
// normalising it first.
// Bounded, and cycle-detecting per rewrite position.  The budget is shared
// with any search already running, so a side condition discharged from inside
// a rewrite cannot buy itself a fresh allowance.
fun simp_conv(db :: RuleDB):
  BOUNDED_TOP_DEPTH_CONV(ORELSEC(db_conv(db), refl_conv))
