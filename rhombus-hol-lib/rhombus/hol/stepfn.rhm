#lang rhombus/static

// Deriving a recursive function's clausal equations via `WFREC` instead of
// postulating them with `new_axiom` (PLAN.md section 9.1, wiring item 5:
// the `H` step-function decision-tree compiler).
//
// Scope of this module: a function whose termination check found
// *structural* descent (`RecursionInfo.method == #'structural`), and for
// which some one argument column strictly descends at *every* recursive
// call.  That is the case `check_termination` settles without any measure
// obligation at all, so the descending argument is literally a constructor
// subterm of the corresponding pattern (`terminate.rhm`'s `descends_at`) --
// which is exactly what makes both the well-founded relation to recurse in
// (`T_lt`, `subterm.rhm`) and the congruence hypothesis `WFREC` needs
// provable in one uniform way, below.
//
// `WFREC` recurses over a single domain, so a several-argument definition
// is derived over the *tuple* of its arguments (`algebra.rhm`'s
// `prod`/`mk_tuple`/`tuple_proj`) and the well-founded relation is `T_lt`
// pulled back along the projection onto the descending column
// (`wellfounded.rhm`'s `prove_wf_pullback`).  Everything between those two
// ends -- building `H`, proving congruence, reading the equations back off
// -- is written once against a `Carrier`, which is the only thing that
// knows whether the recursion's domain is the argument itself or a tuple.
//
// Two cases are still out of scope and fall back to `install_function`
// (`recdef.rhm`)'s postulating seam, exactly as `datatype.rhm`'s axiom
// schema remains the fallback for self-recursive types beside
// `datatype_gen.rhm`'s derivation:
//
//   * `~measure`-based recursion.  Its descent facts are discharged
//     obligations rather than the syntactic `descends_at`, so the
//     congruence proof would have to consume `RecursionInfo.proofs`
//     instead of re-deriving each step from `T_lt`'s own equations.
//
//   * lexicographic descent, where no single column descends everywhere
//     (Ackermann's function is the standard example).  That needs the
//     lexicographic product of two well-founded relations, not a pullback
//     along one projection.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  "bool.rhm" open
  "conv.rhm" open
  "drule.rhm" open
  "taut.rhm" open
  "ruledb.rhm" open
  "datatype.rhm" open
  "algebra.rhm" open
  "subterm.rhm" open
  "wellfounded.rhm" open
  "wfrec.rhm" open
  "recdef.rhm" open
  "dtree.rhm" open
  "terminate.rhm" open

export:
  can_derive_structurally
  descent_column
  install_structural_function

fun self_type(spec :: DatatypeSpec) :: HType:
  TyApp(spec.name, spec.params.map(fun (p :: Symbol): TyVar(p) :~ HType))

// -- applicability ---------------------------------------------------------

// The one argument column every recursive call strictly descends in and
// whose type `usable` accepts, or `#false` if there is none.
//
// Not `RecursionInfo.positions`: that is the *lexicographic* order, whose
// leading column is only required to shrink at some call sites and stay
// equal at the rest.  A pullback along one projection needs strictly more
// -- every call must descend in the same column, or the relation the
// recursion runs in does not relate the call to its caller.  The tree is
// not consulted here: descent is a property of the clauses as written, and
// `descends_at` is the same check `check_termination` used.
//
// A definition with no recursive calls satisfies the descent condition at
// *every* column vacuously, which is right: it needs a well-founded
// relation to hand `WFREC`, but nothing has to be below anything in it.
// `usable` is what then picks a column whose type actually has one.
fun descent_column(spec :: FunSpec, fn_ph :: Term,
                   ~usable: usable = fun (ty :: HType): #true) :: maybe(Int):
  let arity = spec.arg_types.length()
  recur loop (k = 0):
    cond
    | k >= arity: #false
    | !usable(spec.arg_types[k]): loop(k + 1)
    | ~else:
        let ok = for all (cl in spec.clauses):
                   let cl :~ DefClause = cl
                   for all (call in recursive_calls(fn_ph, arity, cl.rhs)):
                     descends_at(cl.pats[k], (call :~ List)[k])
        (if ok | k | loop(k + 1))

// Whether this module's derivation applies: termination settled without a
// measure -- either plain structural descent or no recursion at all -- one
// column descending at every call and landing in a declared datatype, and
// every position the pattern matrix splits on carrying a datatype whose
// *schematic* self type is exactly the type at that position.
//
// `#'none` is admitted alongside `#'structural` because a non-recursive
// definition has nothing that could fail: `WFREC` still needs a
// well-founded relation, but the congruence proof has no recursive call to
// bridge, so it goes through exactly as the recursive case does with an
// empty set of call sites.  Leaving it out was costing every non-recursive
// `function` one postulated equation for no reason.
//
// Pattern depth is not a condition.  `H` is built from the decision tree
// (`dtree.rhm`), which records a selector *path* to every variable, so a
// nested pattern is just a `Switch` whose branch holds another `Switch`,
// and the congruence proof case-splits at the nested position exactly as it
// does at the top one.
//
// The type condition is what makes that case-split possible: it needs the
// position's datatype `cases` theorem, which is stated at the schematic
// self type, to apply at the position's type directly.  A field declared at
// a concrete instance of another datatype would need `cases` instantiated
// first, which this version does not do.
fun can_derive_structurally(spec :: FunSpec, recinfo :: RecursionInfo,
                            tree :: DecisionTree,
                            dts :: Map.of(Symbol, DatatypeThms)) :: Boolean:
  cond
  | recinfo.method != #'structural && recinfo.method != #'none: #false
  | spec.arg_types.length() == 0: #false
  | descent_column(spec, mk_const(spec.name, fun_type(spec)),
                   ~usable: fun (ty :: HType): schematic_datatype(dts, ty))
      == #false: #false
  | ~else: switch_types_ok(tree, dts)

fun schematic_datatype(dts :: Map.of(Symbol, DatatypeThms),
                       ty :: HType) :: Boolean:
  match ty
  | TyApp(n, _):
      match dts.get(n, #false)
      | #false: #false
      | thms: self_type((thms :~ DatatypeThms).spec) == ty
  | ~else: #false

fun switch_types_ok(t :: DecisionTree,
                    dts :: Map.of(Symbol, DatatypeThms)) :: Boolean:
  match t
  | DTLeaf(_, _): #true
  | DTSwitch(_, self_ty, branches):
      cond
      | !schematic_datatype(dts, self_ty): #false
      | ~else: for all (b in branches): switch_types_ok((b :~ DTBranch).tree, dts)

// The `DatatypeThms` at a switched position's type.  Total in practice:
// `can_derive_structurally` has already established every lookup succeeds.
fun thms_at(dts :: Map.of(Symbol, DatatypeThms), ty :: HType) :: DatatypeThms:
  match ty
  | TyApp(n, _):
      match dts.get(n, #false)
      | #false:
          error(~who: #'install_structural_function,
                "no datatype for a switched position",
                error.val(~label: "type", n))
      | thms: thms :~ DatatypeThms
  | ~else:
      error(~who: #'install_structural_function,
            "cannot switch on a position of variable type")

// -- the carrier -----------------------------------------------------------

// What `WFREC` recurses over, and how the definition's several arguments
// sit inside it.  There are exactly two instances: `direct_carrier` (one
// argument, the domain *is* that argument's type) and `tuple_carrier`
// (several, the domain is their product).  Everything below is written
// against this and never asks which it has.
//
//   `arg_terms(x)`      the arguments, as terms, reading them out of a term
//                       of the domain -- the identity, or projections
//   `build(args)`       a term of the domain, from the argument terms
//   `split(c)`          the argument terms *syntactically* inside a
//                       concrete domain term (a literal tuple, or the term
//                       itself); the inverse of `build` on things `build`
//                       made
//   `open(thy, x, k)`   `k` applied to `|- x = <domain term over fresh
//                       variables>`, wrapped in whatever `CHOOSE`s
//                       introducing those variables needs
class Carrier(dom :: HType,
              rel :: Term,
              wf :: Thm,
              arg_terms :: Function.of_arity(1),
              build :: Function.of_arity(1),
              split :: Function.of_arity(1),
              open :: Function.of_arity(3))

// How the definition's arguments sit inside the recursion's domain, which
// is all the carrier's shape amounts to: for one argument the domain *is*
// that argument, for several it is their tuple.  The order the recursion
// runs in (`rel`/`wf`) is chosen separately -- structural descent pulls
// `T_lt` back along a projection, a `~measure` pulls it back along the
// measure -- and everything else is the same either way.
fun shape_of(prod_thms :: maybe(ProdThms), tys :: List.of(HType))
     :: values(HType, Function, Function, Function, Function):
  cond
  | tys.length() == 1:
      values(tys[0],
             fun (x :: Term): [x],
             fun (args :: List.of(Term)): args[0],
             fun (c :: Term): [c],
             fun (thy :: Theory, x :: FVar, k): k(REFL(thy, x :~ Term)))
  | ~else:
      values(tuple_ty(tys),
             fun (x :: Term):
               for List (j in List.iota(tys.length())): tuple_proj(tys, j, x),
             fun (args :: List.of(Term)): mk_tuple(args),
             fun (c :: Term): split_tuple(tys, c),
             fun (thy :: Theory, x :: FVar, k):
               open_tuple(thy, prod_thms :~ ProdThms, tys, x :~ Term, k))

// A relation given a name of its own, with its defining equation for the
// reduction database and `WF` transported onto the name.
//
// `prove_wf_pullback` hands back `WF(\x y. R(f x, f y))`, a literal
// abstraction, and `wfrec.rhm` beta-reduces wholesale (`BETA_RULE`) inside
// its own derivation -- with the relation a lambda, its applications are
// redexes that some steps reduce and others do not, and `CHOOSE` ends up
// reporting its chosen variable free in the other hypotheses.  This is the
// same invariant `H` is kept behind a constant for (see `reduce_h`),
// applied to the relation `WFREC` takes.
fun name_relation(thy :: Theory, name :: Symbol, dom :: HType, wf0 :: Thm)
     :: values(Theory, Term, Thm, Thm):
  let (wf_op, rel_rhs) = dest_comb(concl_of(wf0))
  let rname = Symbol.from_string(to_string(name) ++ "_rel")
  let rty = type_of(rel_rhs)
  let (thy1, def_rel) = new_basic_definition(thy,
                                             mk_eq(mk_var(rname, rty), rel_rhs))
  let rel = mk_const(rname, rty)
  let wf = EQ_MP(SYM(thy1, AP_TERM(thy1, wf_op, def_rel)), wf0)
  let av = mk_var(#'_tra, dom)
  let bv = mk_var(#'_trb, dom)
  let rel_eq = GENL(thy1, [av, bv],
                    unfold_def(thy1, def_rel, [av :~ Term, bv :~ Term]))
  values(thy1, rel :~ Term, wf, rel_eq)

// A function given a name of its own, for the same reason: the thing
// `prove_wf_pullback` pulls back along has to be a constant too, since it
// builds terms around `f(x)` and matches them against each other.
fun name_function(thy :: Theory, nm :: Symbol, dom :: HType,
                  body :: Term, v :: FVar) :: values(Theory, Term, Thm):
  let fty = mk_fun(dom, type_of(body))
  let (thy1, def_f) = new_basic_definition(thy, mk_eq(mk_var(nm, fty),
                                                      mk_abs(v, body)))
  let f = mk_const(nm, fty)
  let qv = mk_var(#'_nfq, dom)
  values(thy1, f :~ Term, GEN(thy1, qv, unfold_def(thy1, def_f, [qv :~ Term])))

// One argument, descending structurally: the domain is the argument's own
// type and the order is its datatype's subterm relation, already a
// constant with equations in the database.
fun direct_carrier(dom :: HType, rel :: Term, wf :: Thm) :: Carrier:
  let (_, arg_terms, build, split, open_c) = shape_of(#false, [dom])
  Carrier(dom, rel, wf, arg_terms, build, split, open_c)

// Several arguments, descending structurally in column `k`: the domain is
// their tuple and the order is `T_lt` pulled back along the projection onto
// that column -- `R(p, q)` holds exactly when `p`'s `k`-th component is a
// proper subterm of `q`'s.  Well-founded because `T_lt` is
// (`prove_wf_pullback`), and every recursive call satisfies it because
// `descent_column` said column `k` descends at every one of them.
fun tuple_carrier(thy :: Theory, name :: Symbol, prod_thms :: ProdThms,
                  tys :: List.of(HType), k :: Int, wf_t_lt :: Thm)
     :: values(Theory, Carrier, List.of(Thm)):
  let (dom, arg_terms, build, split, open_c) = shape_of(prod_thms, tys)
  let pv = mk_var(#'_tpp, dom)
  let (thy1, proj, proj_eq):
    name_function(thy, Symbol.from_string(to_string(name) ++ "_arg"), dom,
                  tuple_proj(tys, k, pv :~ Term), pv)
  let (thy2, rel, wf, rel_eq):
    name_relation(thy1, name, dom, prove_wf_pullback(thy1, wf_t_lt, proj))
  values(thy2, Carrier(dom, rel, wf, arg_terms, build, split, open_c),
         [rel_eq, proj_eq, prod_thms.fst_pair, prod_thms.snd_pair])

// The components of a literal tuple, as they stand.
fun split_tuple(tys :: List.of(HType), c :: Term) :: List.of(Term):
  match tys
  | [_]: [c]
  | List.cons(_, rest):
      let (_, args) = strip_comb(c)
      List.cons(args[0], split_tuple(rest, args[1]))
  | []: error(~who: #'install_structural_function, "empty tuple")

// `kont` applied to `|- p = PAIR(g0, PAIR(g1, ... gn))` for fresh `gi`,
// under the `CHOOSE`s that introduce them.  Surjective pairing, one nesting
// level at a time: `|- !p. ?a b. p = PAIR(a, b)`.
fun open_tuple(thy :: Theory, prod_thms :: ProdThms, tys :: List.of(HType),
               p :: Term, kont) :: Thm:
  match tys
  | [_]: kont(REFL(thy, p))
  | List.cons(t0, rest):
      let rest_ty = tuple_ty(rest)
      let inst = INST_TYPE(thy, {#'a: t0, #'b: rest_ty}, prod_thms.surjective)
      let ex_a = SPEC(thy, p, inst)
      let [va, body_a] = (match dest_exists(concl_of(ex_a)) | l: l)
      let va :~ FVar = va
      let ga = genvar(t0)
      let body_ga = inst_fvar([[ga :~ Term, va]], body_a)
      let ex_b = ASSUME(thy, body_ga)
      let [vb, body_b] = (match dest_exists(body_ga) | l: l)
      let vb :~ FVar = vb
      let gb = genvar(rest_ty)
      let body_gb = inst_fvar([[gb :~ Term, vb]], body_b)
      let p_eq = ASSUME(thy, body_gb)
      let inner = open_tuple(thy, prod_thms, rest, gb :~ Term,
                             fun (gb_eq :: Thm):
                               kont(TRANS(p_eq,
                                          cong_rewrite(thy, [gb_eq], rhs_of(p_eq)))))
      CHOOSE(thy, ga, ex_a, CHOOSE(thy, gb, ex_b, inner))
  | []: error(~who: #'install_structural_function, "empty tuple")

// -- building `H` ------------------------------------------------------

// Every full application of `fn_ph` inside `t` becomes an application of
// `f_var` to the carrier term its arguments build -- for one argument that
// is the argument itself, for several it is their tuple.  Constructing a
// term, not proving anything.  Function bodies in the reflected subset
// never introduce a lambda of their own, so the `Abs` case (rebuilt through
// `dest_abs`/`mk_abs`, since raw `Abs` construction is closed) is not
// exercised today, only defensive.
fun rewrite_recursive_head(fn_ph :: Term, arity :: Int, f_var :: Term,
                           build, t :: Term) :: Term:
  fun go(t :: Term) :: Term:
    let (head, args) = strip_comb(t)
    cond
    | head == fn_ph && args.length() == arity:
        mk_comb(f_var, build(args.map(go)))
    | ~else:
        match t
        | Comb(f, x): mk_comb(go(f), go(x))
        | Abs(_, _):
            let (v, body) = dest_abs(t)
            mk_abs(v, go(body))
        | ~else: t
  go(t)

// `H := \f x. <the decision tree, as nested `cond`s>`.
//
// A `Switch` becomes a `cond` chain over the position's discriminators --
// the last constructor is the final `else`, since the tree is exhaustive
// and its branches are mutually exclusive.  A `Leaf` is its clause's own
// body with every pattern variable replaced by the chain of selectors that
// reads it back out of `x` (`path_term`, off whichever argument the path
// names), and every recursive self-call replaced by an application of `f`.
//
// Neither nesting nor several arguments need anything special here: a
// nested pattern is a `Switch` inside a `Switch`, and the path already says
// which argument to start from and how deep to read.
fun build_step_body(spec :: FunSpec, tree :: DecisionTree,
                    dts :: Map.of(Symbol, DatatypeThms), carrier :: Carrier,
                    fn_ph :: Term, f_var :: FVar, x_var :: FVar) :: Term:
  let arity = spec.arg_types.length()
  let args :~ List = carrier.arg_terms(x_var :~ Term)
  fun dt_of(ty :: HType) :: DatatypeSpec: thms_at(dts, ty).spec
  fun go(t :: DecisionTree) :: Term:
    match t
    | DTLeaf(ci, bindings):
        let cl :~ DefClause = spec.clauses[ci]
        let subst = for List (b in bindings):
                      let b :~ DTBinding = b
                      [path_term(dt_of, args, b.path), b.var]
        inst_fvar(subst,
                  rewrite_recursive_head(fn_ph, arity, f_var, carrier.build,
                                         cl.rhs))
    | DTSwitch(path, self_ty, branches):
        let scrut = path_term(dt_of, args, path)
        recur build (bs :~ List = branches):
          match bs
          | [b]: go((b :~ DTBranch).tree)
          | List.cons(b, rest):
              let b :~ DTBranch = b
              mk_cond(mk_comb(mk_const(discriminator_name(b.ctor),
                                       mk_fun(self_ty, bool)),
                              scrut),
                      go(b.tree),
                      build(rest))
  go(tree)

// -- the reduction database ----------------------------------------------

// Everything the reduction from `H(f)(C(vars))` down to the matching
// clause's body needs, once `H`'s own application has already been peeled
// off by `unfold_def` (below).
//
// The discriminators and selectors are those of *every* declared datatype,
// not just the recursion's own: a definition may match on one argument's
// type while descending in another's (`drop(n :: Nat, xs :: List(~a))`), or
// nest into a field of a different type, and `H` cannot reduce past an
// `is_Ci` it has no rule for.  Narrowing this to the descending column's
// datatype leaves such a definition with a stuck `cond` and a `TRANS` that
// fails to line up -- a loud failure, but a needless one.
//
// The rest: `T_lt`'s own defining equations (so `prove_congruence` can see
// `T_lt(v, C(vars)) = true` for a field `v`), whatever `extra` the carrier
// asked for (`fst`/`snd` on a literal pair, and the tupled relation's and
// projection's own equations), `cond`'s two reduction rules (once a
// discriminator has resolved to a literal `true`/`false`), and
// propositional cleanup (`refl_conv`, folded into `simp_conv` itself,
// handles `v = v -> true`; the `or`/`true` tautologies then collapse the
// disjunction `T_lt`'s equations expand a query into).
fun base_reduction_db(thy :: Theory, dts :: Map.of(Symbol, DatatypeThms),
                      t_lt_equations :: List.of(Thm),
                      extra :: List.of(Thm)) :: RuleDB:
  let db = for values(d :~ RuleDB = empty_db) ((_, dt) in dts):
             let dt :~ DatatypeThms = dt
             let d2 = for values(e :~ RuleDB = d) (th in dt.discriminators):
                        add_thm(thy, e, #'disc, th)
             for values(e :~ RuleDB = d2) (th in dt.selectors):
               add_thm(thy, e, #'sel, th)
  let db = for values(d :~ RuleDB = db) (th in t_lt_equations):
             add_thm(thy, d, #'tlt, th)
  let db = for values(d :~ RuleDB = db) (th in extra):
             add_thm(thy, d, #'proj, th)
  let db = for values(d :~ RuleDB = db) (th in tautologies(thy)):
             add_thm(thy, d, #'taut, th)
  for values(d :~ RuleDB = db) (th in conditionals(thy)):
    add_thm(thy, d, #'cond, th)

// Reduce a `T_lt`-headed (or otherwise ordinary constant-headed) query
// with `db`, beta-reducing first (`simp_conv` alone does not beta-reduce;
// see `conv.rhm`).  Never used on an `H`-application: see `reduce_h`.
fun reduce(thy :: Theory, db :: RuleDB, t :: Term) :: Thm:
  let beta_th = TOP_DEPTH_CONV(BETA_CONV)(thy, t) :~ Thm
  match simp_conv(db)(thy, rhs_of(beta_th))
  | #false: beta_th
  | s :~ Thm: TRANS(beta_th, s)

// `|- H_const(f)(x) = ...`, unfolding `H_const`'s definition *once*
// (`unfold_def`, not a blanket beta pass) and then simplifying with `db`.
//
// This is deliberately not `reduce`: `f` can itself be a genuine lambda
// (`WFREC`'s own solution term, `wfrec_soln`, when this runs on the final
// equations), and a blanket `TOP_DEPTH_CONV(BETA_CONV)` would reduce
// straight through an application `f(v)` the caller wants left alone as a
// literal subterm to rewrite away later (`cong_rewrite`, below).  `H` is
// kept behind an opaque constant (`H_const`, `install_structural_function`)
// for the same reason from the other direction: `WFREC`'s own derivation
// (`wfrec.rhm`) internally applies its generic `H` parameter to schematic
// functions and beta-reduces the result, and every use there was written
// (and tested, `tests/wfrec.rhm`) assuming `H` never itself unfolds into
// anything -- handing it a literal lambda breaks that invariant in ways
// `wfrec_inv_closure` cannot recover from (a fresh `CHOOSE` variable ends
// up free in a hypothesis it does not expect to see).
fun reduce_h(thy :: Theory, db :: RuleDB, def_h :: Thm, f :: Term, x :: Term) :: Thm:
  let unfolded = unfold_def(thy, def_h, [f, x])
  match simp_conv(db)(thy, rhs_of(unfolded))
  | #false: unfolded
  | s :~ Thm: TRANS(unfolded, s)

// `|- t = t'`, `t'` being `t` with every occurrence of a `facts` key
// (matched by exact structural equality, not first-order matching --
// `RuleDB` cannot index a variable- or lambda-headed left-hand side such
// as `f1(v)` or `soln(v)`) replaced by its equal value.  Purely
// structural: each fact fires only at a subterm that is *exactly* its own
// left-hand side, so several facts about disjoint subterms compose safely
// in any order.
fun find_fact(facts :: List.of(Thm), t :: Term) :: maybe(Thm):
  match facts
  | []: #false
  | List.cons(f, rest):
      (if lhs_of(f :~ Thm) == t | f :~ Thm | find_fact(rest, t))

fun cong_rewrite(thy :: Theory, facts :: List.of(Thm), t :: Term) :: Thm:
  match find_fact(facts, t)
  | #false:
      match t
      | Comb(g, x): MK_COMB(cong_rewrite(thy, facts, g), cong_rewrite(thy, facts, x))
      | Abs(_, _):
          let (v, body) = dest_abs(t)
          ABS(thy, v, cong_rewrite(thy, facts, body))
      | ~else: REFL(thy, t)
  | th :: Thm: th

// `A, c |- a = a'`, `B, not c |- b = b'`, `|- c = c'`
//   ==>  `A u B |- cond(c, a, b) = cond(c', a', b')`
//
// By cases on `c` (`BOOL_CASES_AX`, the same skeleton as `CCONTR`).  With
// `c = true` both conditionals collapse to their `then` branch and the
// hypothesis `c` the left theorem carries is what `EQT_ELIM` supplies; with
// `c = false` the same on the `else` side with `not c` from `EQF_ELIM`.
//
// The step that rewrites the test itself goes through `AP_TERM`/`AP_THM` on
// the conditional's own head rather than `cong_rewrite`: a structural
// rewrite would also replace occurrences of `c` *inside* the branches, and
// then the collapse rule -- whose left-hand side is `cond(true, a, b)` with
// `a`, `b` as they were -- would no longer match.
//
// `conditionals` states its rules at the schematic branch type, so each has
// to be instantiated at the branch type in hand before its `t1`/`t2` can be
// specialised.
fun COND_CONG(thy :: Theory, th_cond :: Thm,
              th_then :: Thm, th_else :: Thm) :: Thm:
  let c = lhs_of(th_cond)
  let a = lhs_of(th_then)
  let a2 = rhs_of(th_then)
  let b = lhs_of(th_else)
  let b2 = rhs_of(th_else)
  let (cond_op, _) = strip_comb(mk_cond(c, a, b))
  let [cond_true, cond_false] = conditionals(thy)
  let branch_ty = type_of(a)
  fun side(which :: Boolean) :: Thm:
    let lit = (if which | tm_true | tm_false)
    let ceq = ASSUME(thy, mk_eq(c, lit))
    let c2eq = TRANS(SYM(thy, th_cond), ceq)
    let rule = INST_TYPE(thy, {#'a: branch_ty},
                         (if which | cond_true | cond_false) :~ Thm)
    let inner = (if which
                 | PROVE_HYP(thy, EQT_ELIM(thy, ceq), th_then)
                 | PROVE_HYP(thy, EQF_ELIM(thy, ceq), th_else))
    let to_lit = AP_THM(thy, AP_THM(thy, AP_TERM(thy, cond_op, ceq), a), b)
    let collapse = SPECL(thy, [a, b], rule)
    let rebuild = SYM(thy, SPECL(thy, [a2, b2], rule))
    let back = SYM(thy, AP_THM(thy, AP_THM(thy, AP_TERM(thy, cond_op, c2eq), a2), b2))
    TRANS(to_lit, TRANS(collapse, TRANS(inner, TRANS(rebuild, back))))
  DISJ_CASES(thy, SPEC(thy, c, base_axiom(#'BOOL_CASES_AX)),
             side(#true), side(#false))

// `|- t = t'`, where `fact` has replaced whatever it recognised.
//
// Like `cong_rewrite`, but carrying the branch conditions that reach each
// subterm: descending into `cond(c, a, b)` adds `c` on the way into `a` and
// `not c` on the way into `b`, and `COND_CONG` puts the pieces back
// together.  A structurally recursive definition never looks at `conds` --
// `T_lt` relates a field to its constructor unconditionally -- but a
// `~measure` one must, because that is how its obligation was discharged:
// the measure only decreases down the branch the guard admits.
fun bridge_calls(thy :: Theory, t :: Term, conds :: List.of(Term),
                 fact) :: Thm:
  match fact(t, conds)
  | #false:
      match dest_cond(t)
      | [c, a, b]:
          COND_CONG(thy,
                    bridge_calls(thy, c, conds, fact),
                    bridge_calls(thy, a, conds ++ [c], fact),
                    bridge_calls(thy, b, conds ++ [mk_neg(c)], fact))
      | ~else:
          match t
          | Comb(g, x):
              MK_COMB(bridge_calls(thy, g, conds, fact),
                      bridge_calls(thy, x, conds, fact))
          | Abs(_, _):
              let (v, body) = dest_abs(t)
              ABS(thy, v, bridge_calls(thy, body, conds, fact))
          | ~else: REFL(thy, t)
  | th :: Thm: th

// The distinct carrier terms the recursive calls in `t` are made at, in
// order of first occurrence.
fun call_carriers(fn_ph :: Term, arity :: Int, build,
                  t :: Term) :: List.of(Term):
  for values(acc :~ List = []) (call in recursive_calls(fn_ph, arity, t)):
    let v :~ Term = build(call :~ List)
    (if acc.contains(v) | acc | acc ++ [v])

// -- the congruence hypothesis --------------------------------------------

// `|- !f1 f2 x. (!z. R(z,x) ==> f1(z)=f2(z)) ==> H(f1)(x) = H(f2)(x)`.
//
// The proof walks the same decision tree `H` was built from, refining `x`
// as it descends.  It starts by opening the carrier -- nothing to do when
// the domain is the one argument, surjective pairing when it is a tuple --
// and then, at a `Switch`, splits the position's own variable with that
// datatype's `cases` theorem, carrying the refinement into the running
// `x_eq : |- x = <concrete>` by rewriting with the split equation.
//
// Splitting at a *nested* position is the same move as splitting at the top
// one, which is what lets nested patterns through: `H` cannot reduce past a
// test whose scrutinee is still a variable, so the proof keeps splitting
// until every test resolves -- which is exactly when the tree reaches a
// leaf.
//
// At a leaf, `H_const(f1)` and `H_const(f2)` applied to the refined `x`
// both reduce (`reduce_h`) to that clause's body with `f1`/`f2` standing in
// for the recursive call.  The two differ only where a recursive call
// happens, and `R(<call>, <concrete>)` always holds -- for one argument
// because `T_lt` is the proper-subterm relation, so it covers a field of a
// field just as it covers an immediate one; for several because `R` is
// exactly `T_lt` on the descending column, which `descent_column` checked
// every call shrinks.  So the hypothesis gives `f1(v) = f2(v)` there, and
// `bridge_calls` carries that through whatever the body builds around the
// call -- including down into the branches of a `cond`, which it rebuilds
// with `COND_CONG`.
fun prove_congruence(thy :: Theory, spec :: FunSpec,
                     dts :: Map.of(Symbol, DatatypeThms), tree :: DecisionTree,
                     carrier :: Carrier, fn_ph :: Term, h_const :: Term,
                     def_h :: Thm, db :: RuleDB) :: Thm:
  let arity = spec.arg_types.length()
  let dom = carrier.dom
  let rel = carrier.rel
  let fty = mk_fun(dom, spec.ret_type)
  let f1 = mk_var(#'_cgf1, fty)
  let f2 = mk_var(#'_cgf2, fty)
  let xv = mk_var(#'_cgx, dom)
  let zv = mk_var(#'_cgz, dom)
  let hyp_term = mk_forall(zv, mk_imp(list_mk_comb(rel, [zv :~ Term, xv]),
                                      mk_eq(mk_comb(f1, zv), mk_comb(f2, zv))))
  let hyp = ASSUME(thy, hyp_term)

  // `x_eq : |- xv = concrete`, `concrete` being `xv` refined by every split
  // taken to reach this leaf.  The clause's own variable names mean nothing
  // here -- the concrete term is built from whichever fresh variables the
  // `CHOOSE`s introduced -- so the body is re-expressed in terms of them,
  // position by position, using the leaf's own bindings.
  fun at_leaf(ci :: Int, bindings :: List.of(DTBinding), x_eq :: Thm) :: Thm:
    let concrete = rhs_of(x_eq)
    let cargs :~ List = carrier.split(concrete)
    let cl :~ DefClause = spec.clauses[ci]
    let rename = for List (b in bindings):
                   let b :~ DTBinding = b
                   [path_subterm(cargs, b.path), b.var]
    let rhs_here = inst_fvar(rename, cl.rhs)
    // Structural descent holds unconditionally, so the facts can all be
    // built up front and the branch conditions `bridge_calls` offers are
    // not consulted.  Descending into `cond` still goes through
    // `COND_CONG` rather than plain congruence, which costs a case split
    // per conditional and is what a `~measure` definition would need to
    // reach its obligation (PLAN.md section 9.10).
    let call_facts = for List (v in call_carriers(fn_ph, arity, carrier.build,
                                                  rhs_here)):
                       let v :~ Term = v
                       let below = EQT_ELIM(thy, reduce(thy, db,
                                                        list_mk_comb(rel, [v, concrete])))
                       let below_xv = EQ_MP(SYM(thy, AP_TERM(thy, mk_comb(rel, v), x_eq)),
                                            below)
                       MP(thy, SPEC(thy, v, hyp), below_xv)
    let l1 = reduce_h(thy, db, def_h, f1, concrete)
    let l2 = reduce_h(thy, db, def_h, f2, concrete)
    let bridge = bridge_calls(thy, rhs_of(l1), [],
                              fun (t :: Term, _conds): find_fact(call_facts, t))
    let step_at_c = TRANS(l1, TRANS(bridge, SYM(thy, l2)))
    let lift1 = AP_TERM(thy, mk_comb(h_const, f1), x_eq)
    let lift2 = AP_TERM(thy, mk_comb(h_const, f2), x_eq)
    TRANS(lift1, TRANS(step_at_c, SYM(thy, lift2)))

  fun walk(t :: DecisionTree, x_eq :: Thm) :: Thm:
    match t
    | DTLeaf(ci, bindings): at_leaf(ci, bindings, x_eq)
    | DTSwitch(path, self_ty, branches):
        let concrete = rhs_of(x_eq)
        // Always a variable: a position is split at most once, and the
        // path's own steps are the splits already taken above it.
        let v :~ FVar = path_subterm(carrier.split(concrete), path)
        let dtt :~ DatatypeThms = thms_at(dts, self_ty)
        fun peel(sub :: DecisionTree, target :: Term) :: Thm:
          match dest_exists(target)
          | [w, body]:
              let w :~ FVar = w
              let gv = genvar(w.ty)
              CHOOSE(thy, gv, ASSUME(thy, target),
                     peel(sub, inst_fvar([[gv, w]], body)))
          | #false:
              // `target : v = C(ws)`; rewriting `concrete` with it pushes
              // the refinement into the running equation for `xv`.
              let v_eq = ASSUME(thy, target)
              walk(sub, TRANS(x_eq, cong_rewrite(thy, [v_eq], concrete)))
        // A `cases` disjunction is left-associated (`datatype.rhm`'s
        // `build_cases`): `((a0 or a1) or a2) or ... or an`.  Peeling from
        // the outside in, the left branch is the prefix disjunction
        // (recurse) and the right branch is one constructor's own case,
        // walking the branches back to front as `upto` shrinks.  The tree's
        // branch order is the datatype's own constructor order, which is
        // the order `cases` disjoins them in.
        fun combine(upto :: Int, stmt :: Term, th :: Thm) :: Thm:
          cond
          | upto == 0: peel((branches[0] :~ DTBranch).tree, stmt)
          | ~else:
              let [dl, dr] = (match dest_disj(stmt) | l: l)
              let left = combine(upto - 1, dl, ASSUME(thy, dl))
              let right = peel((branches[upto] :~ DTBranch).tree, dr)
              DISJ_CASES(thy, th, left, right)
        let disj_at_v = SPEC(thy, v :~ Term, dtt.cases)
        combine(branches.length() - 1, concl_of(disj_at_v), disj_at_v)

  let per_x = carrier.open(thy, xv, fun (x_eq :: Thm): walk(tree, x_eq))
  GENL(thy, [f1, f2], GEN(thy, xv, DISCH(thy, hyp_term, per_x)))

// -- installation ----------------------------------------------------------

// `|- f a0 ... an-1 = soln(<carrier>)`, peeling the *definition's own*
// binders and no further.
//
// Not plain `unfold_def`: `soln` is itself a lambda (`WFREC`'s solution
// term), so with one argument `unfold_def` would beta-reduce `soln(a)` as
// well and leave a right-hand side that no longer matches the `SPEC` of
// `WFREC`'s own equation, which is stated about the unreduced application.
// With one argument the definition has no binders to peel at all, so
// `AP_THM` alone is the whole of it; with several, each `unfold_def` step
// reduces exactly the redex that step's `AP_THM` created, and the last one
// stops at `soln(<tuple>)` for the same reason -- `BETA_CONV` fires once,
// at the top.
fun apply_fn_def(thy :: Theory, def_fn :: Thm, arity :: Int,
                 args :: List.of(Term)) :: Thm:
  cond
  | arity == 1: AP_THM(thy, def_fn, args[0])
  | ~else: unfold_def(thy, def_fn, args)

// `wr_def` is `build_wfrec_rel(thy)`'s result: `wfrec_rel`'s definition,
// installed exactly once per theory (a `new_basic_definition`, not
// reinstallable) and threaded in by the caller so every structurally
// derived function in a session shares the one copy.
//
// `dts` is every declared datatype's theorems, not just the recursion
// type's: a nested pattern splits at a position whose type need not be the
// descending argument's, and the congruence proof needs that type's own
// `cases`.  `alg` supplies `prod` for the several-argument case; it is
// unused when there is only one argument.
fun install_structural_function(thy :: Theory, wr_def :: Thm,
                                spec :: FunSpec, dt :: DatatypeThms,
                                dts :: Map.of(Symbol, DatatypeThms),
                                tree :: DecisionTree,
                                t_lt_equations :: List.of(Thm),
                                recinfo :: RecursionInfo,
                                alg :: AlgebraThms)
     :: values(Theory, FunInfo):
  let arity = spec.arg_types.length()
  let fty = fun_type(spec)
  let fn_ph = mk_const(spec.name, fty)
  let self = self_type(dt.spec)
  let k = (match descent_column(spec, fn_ph,
                                ~usable: fun (ty :: HType): schematic_datatype(dts, ty))
           | #false:
               error(~who: #'install_structural_function,
                     "no argument column descends at every recursive call",
                     error.val(~label: "name", spec.name))
           | c: c :~ Int)
  let t_lt = mk_const(subterm_name(dt.spec), mk_fun(self, mk_fun(self, bool)))
  let wf_t_lt = prove_wf_t_lt(thy, dt.spec, t_lt_equations, dt.induction)
  let (thy0, carrier, proj_rules):
    cond
    | arity == 1: values(thy, direct_carrier(self, t_lt, wf_t_lt), [])
    | ~else:
        tuple_carrier(thy, spec.name, alg.prod, spec.arg_types, k, wf_t_lt)

  let hdom = mk_fun(carrier.dom, spec.ret_type)
  let f_var = mk_var(#'_stepf, hdom)
  let x_var = mk_var(#'_stepx, carrier.dom)
  let h_body = build_step_body(spec, tree, dts, carrier, fn_ph, f_var, x_var)
  let h_term = mk_abs(f_var, mk_abs(x_var, h_body))
  // `H` stays behind an opaque constant everywhere `WFREC`'s own machinery
  // touches it -- see `reduce_h`'s comment for why a literal lambda there
  // is unsound to hand off.
  let h_name = Symbol.from_string(to_string(spec.name) ++ "_H")
  let hfty = mk_fun(hdom, hdom)
  let (thy1, def_h) = new_basic_definition(thy0, mk_eq(mk_var(h_name, hfty), h_term))
  let h_const = mk_const(h_name, hfty)
  let db = base_reduction_db(thy1, dts, t_lt_equations, proj_rules)
  let congr = prove_congruence(thy1, spec, dts, tree, carrier, fn_ph, h_const,
                               def_h, db)
  let (soln, final_thm) = WFREC(thy1, wr_def, carrier.rel, h_const, carrier.wf, congr)
  // One argument: the function *is* the solution.  Several: it is the
  // solution composed with tupling, so that `f a b` and `soln(PAIR(a,b))`
  // are interchangeable by `unfold_def` in both directions.
  let fn_rhs:
    cond
    | arity == 1: soln
    | ~else:
        let params = for List (ty in spec.arg_types, i in List.iota(arity)):
                       mk_var(Symbol.from_string("_fa" ++ to_string(i)), ty :~ HType)
        list_mk_abs(params,
                    mk_comb(soln, mk_tuple(params.map(fun (v :: FVar): v :~ Term))))
  let (thy2, def_fn) = new_basic_definition(thy1, mk_eq(mk_var(spec.name, fty), fn_rhs))
  let roots = for List (ty in spec.arg_types, i in List.iota(arity)):
                mk_var(Symbol.from_string("_eqx" ++ to_string(i)), ty :~ HType) :~ Term
  let dt_specs = for values(m :~ Map = {}) ((n, th) in dts):
                   m ++ {n: (th :~ DatatypeThms).spec}
  let eqs = for List (ls in leaf_shapes(dt_specs, tree, roots)):
              let ls :~ LeafShape = ls
              let pats :~ List = ls.patterns
              let carrier_at = carrier.build(pats)
              let cl :~ DefClause = spec.clauses[ls.clause]
              let rename = for List (b in ls.bindings):
                             let b :~ DTBinding = b
                             [path_subterm(pats, b.path), b.var]
              let rhs_here = inst_fvar(rename, cl.rhs)
              // `|- f p0 ... pn = soln(<carrier>)`, which for one argument
              // is `AP_THM` and for several is that plus the betas.
              let fn_eq_soln = apply_fn_def(thy2, def_fn, arity, pats)
              let spec_at_c = SPEC(thy2, carrier_at, final_thm)
              let reduced = reduce_h(thy2, db, def_h, soln, carrier_at)
              // `reduced`'s right-hand side still carries `soln(<carrier>)`
              // (a genuine lambda application, so `RuleDB` cannot rewrite
              // it) at every recursive-call site; fold each one back into
              // `fn` the same structural way `prove_congruence` bridges
              // `f1`/`f2`.
              let soln_facts = for List (call in recursive_calls(fn_ph, arity, rhs_here)):
                                 SYM(thy2, apply_fn_def(thy2, def_fn, arity, call :~ List))
              let folded = cong_rewrite(thy2, soln_facts, rhs_of(reduced))
              let final_reduced = TRANS(reduced, folded)
              GENL(thy2, row_vars(pats),
                   TRANS(fn_eq_soln, TRANS(spec_at_c, final_reduced)))
  values(thy2, FunInfo(spec, mk_const(spec.name, fty), eqs, recinfo))
