#lang rhombus/static

// Termination checking for recursive definitions.
//
// The output is a `RecursionInfo`, and it is *also* the input to the
// induction-scheme generator: the argument position a function recurses on is
// the position the prover should induct on.  Computing it twice would let the
// two drift apart, so it is computed once, here.
//
// Two methods, tried in that order:
//
//   structural  the arguments descend lexicographically: there is an order of
//               argument positions such that every recursive call leaves some
//               prefix of them unchanged and shrinks the next one to a proper
//               constructor subterm of its pattern.  Purely syntactic, no
//               proof obligations.
//
//   measure     tried only when no order exists, so a measure on a definition
//               that descends structurally is never checked -- the structural
//               argument is complete on its own.  The author supplied
//               `~measure(e)`, and `e` decreases in the
//               subterm order of its own type at every recursive call.  That
//               is a real theorem, one per call site, and it is discharged
//               through the waterfall by a callback the caller supplies.
//
// The callback is why this module does not import the prover: `recdef.rhm`
// sits below `waterfall.rhm`, so the obligation has to travel out as a term
// and the verdict back as a message.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  "bool.rhm" open

export:
  RecursionInfo
  CallSite
  Measure
  check_termination
  descends_at
  measure_positions
  call_sites_in
  measure_at
  mentions
  lexicographic_order

class CallSite(args :: List.of(Term))

class RecursionInfo(// argument positions that strictly decrease, or -- for a
                    // measure -- that the measure reads; empty for a
                    // non-recursive definition
                    positions :: List.of(Int),
                    method :: Symbol,          // #'none | #'structural | #'measure
                    sites :: List.of(CallSite),
                    // The actual decrease proof discharged at each measure
                    // call site, in the same order as `sites` -- empty for
                    // `#'none`/`#'structural`, where descent is a syntactic
                    // fact (`descends_at`) rather than a kernel theorem.
                    // This is what a `WFREC`-based derivation needs for its
                    // congruence obligation; PLAN.md section 9.1.2 tracks
                    // the remaining wiring.
                    decrease_proofs :: List.of(Thm))

// `term` is `fun (p1, ..., pn): e`, an abstraction over the parameters, so
// that instantiating it at a clause's patterns or at a call's arguments is
// just application -- no substitution and no capture to worry about.
//
// `discharge` returns `values(th, #false)` with the actual proof when it
// discharged the obligation, and `values(#false, message)` with a message
// describing what was left over otherwise.
class Measure(term :: Term,
              discharge :: Function.of_arity(1))

// `arg` is a subterm of `pat` reached through zero or more of `pat`'s own
// *recursive* fields -- fields whose type is exactly `pat`'s own type, the
// chain `T_lt`'s defining equations actually connect (`subterm.rhm`):
// `T_lt(v, C(...)) <=> v === xi or T_lt(v, xi) or ...` over the recursive
// fields `xi` only.  One step (`arg` is literally one of `pat`'s own
// recursive fields) is the base case; a nested pattern's variable, several
// destructurings deep, is still connected by the same chain one field at a
// time, so the check recurses into each recursive field in turn.
fun descends_at(pat :: Term, arg :: Term) :: Boolean:
  match pat
  | FVar(_, _): #false
  | ~else:
      let (head, fields) = strip_comb(pat)
      match head
      | Const(_, _):
          for any (f in fields):
            type_of(f) == type_of(pat) && (f == arg || descends_at(f, arg))
      | ~else: #false

// Look for one argument position that descends at every recursive call in
// every clause; failing that, check the measure if there is one.
//
// The clauses arrive as `[patterns, body]` pairs rather than as the
// `FunSpec` that `recdef.rhm` owns: the induction-scheme generator needs this
// module too, and passing the two fields it reads keeps the dependency going
// one way only.
fun check_termination(who :: Symbol,
                      name :: Symbol,
                      arity :: Int,
                      clauses :: List,
                      fn :: Term,
                      ~measure: measure :: maybe(Measure) = #false)
     :: RecursionInfo:
  // Collect every recursive call together with the clause patterns it sits
  // under and the branch conditions guarding it, so that a failure can point
  // at the offending call and a measure obligation can assume its context.
  // `terms` is every term the clause evaluates, not only the one its
  // equation states: a `let` initializer whose value the equation drops is
  // still run, and a recursive call in it still has to descend (`core.rhm`,
  // PLAN.md 9.34).
  // A `let` initializer is an obligation *and*, where the body reads it, a
  // subterm of the right-hand side, so the same call is found twice.  The
  // duplicate is one call, and discharging its obligation twice is wasted
  // work -- for a `~measure` it is a second proof of the same thing.
  //
  // Deduplicated on the whole site, patterns and guards included, never on
  // the call alone.  The two are genuinely different sites when the guards
  // differ: in
  //
  //   let x = f(k)
  //   if p | x | zero()
  //
  // `f(k)` runs unconditionally, and the occurrence inside the `if` runs
  // under `p`.  Keeping only the guarded one would be unsound; keeping only
  // the unguarded one happens to be right here and is not right in general,
  // so neither is dropped.
  let all_sites = for values(acc :~ List = []) ([pats, terms] in clauses):
                    for values(a :~ List = acc) (t in terms :~ List):
                      let calls = call_sites_in(who, name, fn, arity,
                                                t :~ Term)
                      for values(b :~ List = a) ([conds, args] in calls):
                        let site = [pats, conds, args]
                        if b.contains(site) | b | b ++ [site]
  cond
  | all_sites.length() == 0:
      RecursionInfo([], #'none, [], [])
  | ~else:
      let sites = all_sites.map(fun ([_, _, args]): CallSite(args :~ List))
      let order = lexicographic_order(arity, all_sites)
      cond
      | order: RecursionInfo(order :~ List, #'structural, sites, [])
      | measure:
          let m :~ Measure = measure
          let proofs = check_measure(who, name, arity, fn, m, all_sites)
          RecursionInfo(measure_positions(arity, m.term), #'measure, sites, proofs)
      | ~else:
          let [pats, _, args] = all_sites[0]
          error(~who: who,
                "cannot see that the definition terminates",
                error.val(~label: "name", name),
                error.val(~label: "clause",
                          show(list_mk_comb(fn, pats :~ List))),
                error.val(~label: "recursive call",
                          show(list_mk_comb(fn, args :~ List))),
                error.val(~label: "hint",
                          "no argument position is a strict constructor "
                            ++ "subterm of the corresponding pattern in every "
                            ++ "recursive call; give the definition a "
                            ++ "`~measure(...)` if it terminates for another "
                            ++ "reason"))

// -- lexicographic structural descent ----------------------------------------

// An order of argument positions the calls descend in, or `#false`.
//
// Greedy, and that is not a heuristic: a column admissible at this step stays
// admissible later, and taking it can only discharge call sites, so if any
// order works this one does.  At each step, look for a column that no call
// site *grows* -- each either leaves it alone or shrinks it to a constructor
// subterm -- and that at least one site shrinks.  The sites it shrinks are
// settled; the rest carry on to the next column.
//
// Descending on one argument is the common case and comes out as a
// single-element order, so this subsumes the plain structural check rather
// than sitting beside it.
fun lexicographic_order(arity :: Int, all_sites :: List) :: maybe(List.of(Int)):
  recur loop (pending :~ List = all_sites, used :~ List = [], order :~ List = []):
    cond
    | pending.length() == 0: order ++ fully_descending(arity, all_sites, order)
    | ~else:
        match next_column(arity, pending, used)
        | #false: #false
        | col:
            let col :~ Int = col
            let rest = pending.filter(
              ~keep: fun ([pats, _, args]):
                       !descends_at((pats :~ List)[col], (args :~ List)[col]))
            loop(rest, used ++ [col], order ++ [col])

fun next_column(arity :: Int, pending :: List, used :: List.of(Int)) :: maybe(Int):
  recur loop (i = 0):
    cond
    | i >= arity: #false
    | used.contains(i): loop(i + 1)
    | ~else:
        let ok = for all ([pats, _, args] in pending):
                   let p = (pats :~ List)[i]
                   let a = (args :~ List)[i]
                   descends_at(p, a) || a == p
        let any_shrinks = for any ([pats, _, args] in pending):
                            descends_at((pats :~ List)[i], (args :~ List)[i])
        (if ok && any_shrinks | i | loop(i + 1))

// Columns that shrink at *every* call site, beyond those the order already
// names.  They are not needed for termination, but the prover uses them to
// pick an induction variable, and a column that always shrinks is a good
// guess whether or not the lexicographic search happened to reach it.
fun fully_descending(arity :: Int, all_sites :: List,
                     order :: List.of(Int)) :: List.of(Int):
  for values(acc :~ List = []) (i in List.iota(arity)):
    cond
    | order.contains(i): acc
    | ~else:
        let ok = for all ([pats, _, args] in all_sites):
                   descends_at((pats :~ List)[i], (args :~ List)[i])
        (if ok | acc ++ [i] | acc)

// -- the measure -------------------------------------------------------------

// The argument positions the measure actually reads.  Only a heuristic: it
// tells the prover which variable to induct on when reasoning about calls to
// this function, and a wrong guess costs time, not soundness.
fun measure_positions(arity :: Int, m :: Term) :: List.of(Int):
  let (params, body) = peel_params(arity, m)
  for values(acc :~ List = []) (v in params, i in List.iota(arity)):
    (if vfree_in(v, body) | acc ++ [i] | acc)

// Open the measure's `arity` leading binders into fresh variables.
fun peel_params(arity :: Int, m :: Term) :: values(List.of(FVar), Term):
  recur loop (t :~ Term = m, k = arity, acc :~ List = []):
    cond
    | k == 0: values(acc, t)
    | ~else:
        let v = variant(acc.map(fun (x :: FVar): x :~ Term) ++ [t],
                        mk_var(#'p, (t :~ Abs).arg_ty))
        loop(open_abs(v, t), k - 1, acc ++ [v])

// `m` applied to `args`, beta-reduced.  The measure is an abstraction over
// exactly the parameters, so this is a total operation with no residue.
fun measure_at(m :: Term, args :: List.of(Term)) :: Term:
  recur loop (t :~ Term = list_mk_comb(m, args)):
    cond
    | is_beta_redex(t): loop(beta_reduce(t))
    | ~else:
        match t
        | Comb(f, x) when is_beta_redex(f): loop(mk_comb(loop(f), x))
        | ~else: t

// One obligation per recursive call: under the branch conditions that reach
// it, the measure of the arguments is below the measure of the patterns.
//
// Well-foundedness is not re-argued here.  `T_lt` is the structural subterm
// relation of a declared datatype, and the datatype's induction axiom is
// exactly the statement that it has no infinite descending chains; see
// `subterm.rhm`.
fun check_measure(who :: Symbol, name :: Symbol, arity :: Int, fn :: Term,
                  measure :: Measure, all_sites :: List) :: List.of(Thm):
  let mty = measure_type(who, name, arity, measure.term)
  let tyname = (match mty
                | TyApp(n, _) when n != ty_fun && n != ty_bool: n
                | ~else:
                    error(~who: who,
                          "a measure must land in a declared datatype that recurses",
                          error.val(~label: "name", name),
                          error.val(~label: "measure type",
                                    type_to_string(mty))))
  let relname = subterm_relation_name(tyname)
  let rel = mk_const(relname, mk_fun(mty, mk_fun(mty, bool)))
  for List ([pats, conds, args] in all_sites):
    let pats :~ List = pats
    let args :~ List = args
    // The obligation would mention `fn`, which is not a constant yet.
    for (a in args):
      when mentions(fn, a)
      | error(~who: who,
              "a recursive call inside the arguments of another",
              error.val(~label: "name", name),
              error.val(~label: "recursive call",
                        show(list_mk_comb(fn, args))),
              error.val(~label: "hint",
                        "this version cannot state a measure obligation for "
                          ++ "nested recursion"))
    let core = list_mk_comb(rel, [measure_at(measure.term, args),
                                  measure_at(measure.term, pats)])
    let guarded = for values(acc :~ Term = core) (c in (conds :~ List).reverse()):
                    mk_imp(c, acc)
    let obligation = mk_forall_list(free_vars(guarded), guarded)
    let (th_opt, residue) = measure.discharge(obligation)
    match th_opt
    | #false:
        error(~who: who,
              "cannot see that the measure decreases",
              error.val(~label: "name", name),
              error.val(~label: "clause",
                        show(list_mk_comb(fn, pats))),
              error.val(~label: "recursive call",
                        show(list_mk_comb(fn, args))),
              error.val(~label: "obligation", show(obligation)),
              error.val(~label: "residue", residue))
    | th :~ Thm: th

// The measure's result type, checking on the way that it really is an
// abstraction over every parameter.
fun measure_type(who :: Symbol, name :: Symbol, arity :: Int,
                 m :: Term) :: HType:
  recur loop (ty :~ HType = type_of(m), k = arity):
    cond
    | k == 0: ty
    | is_fun(ty):
        let (_, r) = dest_fun(ty)
        loop(r, k - 1)
    | ~else:
        error(~who: who, "the measure does not take every parameter",
              error.val(~label: "name", name))

fun mentions(fn :: Term, t :: Term) :: Boolean:
  cond
  | t == fn: #true
  | ~else:
      match t
      | Comb(f, x): mentions(fn, f) || mentions(fn, x)
      | Abs(_, b): mentions(fn, b)
      | ~else: #false

// -- finding the recursive calls ---------------------------------------------

// Every application of `fn` to a full argument list inside `t`, paired with
// the branch conditions that reach it.
//
// Descending into `if c | a | b` adds `c` on the way into `a` and `not c` on
// the way into `b`.  Without that, a definition whose recursion is guarded --
// which is most of what a measure is for -- would have to prove its measure
// decreases even down the branch that is never taken.
fun call_sites_in(who :: Symbol, name :: Symbol, fn :: Term, arity :: Int,
                  t :: Term) :: List:
  fun walk(t :: Term, conds :~ List, under_binder :: Boolean,
           acc :~ List) :~ List:
    let acc2:
      let (head, args) = strip_comb(t)
      cond
      | head == fn && args.length() == arity:
          when under_binder
          | error(~who: who, "a recursive call under a binder",
                  error.val(~label: "name", name),
                  error.val(~label: "recursive call",
                            show(list_mk_comb(fn, args))))
          acc ++ [[conds, args]]
      | ~else: acc
    match dest_cond(t)
    | [c, a, b]:
        let acc3 = walk(c, conds, under_binder, acc2)
        let acc4 = walk(a, conds ++ [c], under_binder, acc3)
        walk(b, conds ++ [mk_neg(c)], under_binder, acc4)
    | ~else:
        match t
        | Comb(f, x):
            walk(x, conds, under_binder, walk(f, conds, under_binder, acc2))
        | Abs(_, b): walk(b, conds, #true, acc2)
        | ~else: acc2
  walk(t, [], #false, [])
