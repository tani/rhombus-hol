#lang rhombus/static

// First-order matching of a rewrite rule's left-hand side against a term.
//
// Matching is one-way: it finds a type instantiation and a term instantiation
// that turn the pattern into the target, and never touches the target.  Both
// are needed, because rules are polymorphic -- `app(nil, ys)` with
// `ys :: List('a)` has to match `app(nil, zs)` with `zs :: List(num)`.
//
// Deliberately first-order.  Keeping ordinary rewriting first-order is what
// makes it fast; the one higher-order thing the prover needs, instantiating an
// induction scheme's predicate variable, is done directly by the kernel's
// `INST` rather than by search.

import:
  rhombus/hol/htype open
  rhombus/hol/term open

export:
  MatchResult
  term_match

class MatchResult(tyin :: Map.of(Symbol, HType),
                  // `[replacement, variable]` pairs, ready for `INST`, with
                  // the variables already type-instantiated
                  theta :: List)

// Match `pat` against `t`, where `pvars` are the pattern's variables.
// Everything else in `pat` -- constants, and free variables not in `pvars` --
// must appear literally in `t`.
fun term_match(pvars :: List.of(FVar), pat :: Term, t :: Term)
     :: maybe(MatchResult):
  // Bindings are keyed by the *uninstantiated* pattern variable, since that is
  // what appears in the pattern.
  fun go(pat :: Term, t :: Term, depth :: NonnegInt,
         tyin :: Map.of(Symbol, HType), binds :~ List) :: maybe(List):
    match pat
    | FVar(_, _) when pvars.contains(pat):
        // A pattern variable may not capture a bound variable of the target.
        // At depth 0 the target subterm is closed anyway, so only pay for the
        // check when the pattern really did descend under a binder.
        cond
        | depth > 0 && !is_locally_closed(t): #false
        | ~else:
            match type_match((pat :~ FVar).ty, type_of(t), tyin)
            | #false: #false
            | tyin2:
                match lookup(binds, pat)
                | #false: [tyin2, List.cons([pat, t], binds)]
                | prev: (if prev == t | [tyin2, binds] | #false)
    | FVar(_, _): (if pat == t | [tyin, binds] | #false)
    | BVar(i, _):
        match t
        | BVar(j, _): (if i == j | [tyin, binds] | #false)
        | ~else: #false
    | Const(n, ty):
        match t
        | Const(m, ty2) when n == m:
            match type_match(ty, ty2, tyin)
            | #false: #false
            | tyin2: [tyin2, binds]
        | ~else: #false
    | Comb(pf, px):
        match t
        | Comb(tf, tx):
            match go(pf, tf, depth, tyin, binds)
            | #false: #false
            | [tyin2, binds2]: go(px, tx, depth, tyin2, binds2)
        | ~else: #false
    | Abs(paty, pbody):
        match t
        | Abs(taty, tbody):
            match type_match(paty, taty, tyin)
            | #false: #false
            | tyin2: go(pbody, tbody, depth + 1, tyin2, binds)
        | ~else: #false
  match go(pat, t, 0, {}, [])
  | #false: #false
  | [tyin, binds]:
      let tyin :~ Map = tyin
      // Report the variables as `INST` will see them: after `INST_TYPE` has
      // run, a pattern variable's type has been instantiated too.
      let theta = (binds :~ List).map(
        fun ([v, s]): [s, inst_type(tyin, v :~ FVar)])
      // Every pattern variable must have been bound, or the instantiation
      // would leave a variable behind and the rule would not be an instance.
      cond
      | (for all (pv in pvars): lookup(binds, pv) != #false):
          MatchResult(tyin, theta)
      | ~else: #false

fun lookup(binds :~ List, v :: Term) :: maybe(Term):
  recur loop (bs :~ List = binds):
    match bs
    | []: #false
    | List.cons([x, s], rest): (if x == v | s | loop(rest))
