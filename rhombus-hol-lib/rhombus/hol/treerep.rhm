#lang rhombus/static

// The representation a recursive datatype gets carved out of (PLAN.md
// section 9.2 phase 3, design settled in 9.21).
//
// A value of a self-recursive datatype is a finite tree.  Trees are indexed
// by *paths* rather than by node numbers:
//
//   Path = num -> num     a digit sequence; `0` ends the path, and `d > 0`
//                         descends into child `d - 1`
//   Rep  = Path -> Opt    `Opt` is the label type plus a marker for "no node
//                         here", which the caller supplies as a sum
//
//   node(lab, kids) = \p. if p(0) = 0 then inl(lab)
//                         else kids(pre_num(p 0))(\i. p(suc_num i))
//
// Paths, not numbers, is the whole design decision.  Numbering nodes
// breadth-first also works for *building* a node, but grafting needs the
// inverse -- given an index, which subtree and which position -- so it needs
// division with a uniqueness theorem.  Descending a path needs only
// `pre_num(suc n) = n` and `suc n /= 0`, both of which `infinity.rhm` already
// proves.  That is also why no pairing function appears here: HOL Light's
// `NUMPAIR` exists to fold a (tag, index) pair back into `num`, and nothing
// here ever needs to.
//
// What this module supplies is the one load-bearing fact about `node`: it is
// injective in both arguments.  Everything the carving does afterwards --
// injectivity of the datatype's own constructors, distinctness from the
// labels, induction from the minimality of the carved set -- rests on it.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  "bool.rhm" open
  "conv.rhm" open
  "drule.rhm" open
  "taut.rhm" open
  "infinity.rhm" open

export:
  path_ty
  rep_ty
  mk_node
  prove_node_injective
  num_lit
  prove_lit_distinct
  mk_kids
  prove_kids_injective
  prove_kids_cong
  CtorRep
  mk_ctor_term
  mk_rep_pred
  prove_rep_closed
  Carved
  prove_rep_in_set
  prove_abs_injective
  mk_abs_ctor
  prove_ctor_in_set
  prove_ctor_injective
  prove_ctor_distinct
  prove_datatype_induction
  prove_datatype_cases

fun path_ty() :: HType: mk_fun(num_ty(), num_ty())

// `Rep` over an option type `oty` the caller chose: `Path -> oty`.
fun rep_ty(oty :: HType) :: HType: mk_fun(path_ty(), oty)

// `node(lab, kids)`, given the injection `inl : lty -> oty` that marks a
// present node.
fun mk_node(inl :: Term, lab :: Term, kids :: Term) :: Term:
  let nty = num_ty()
  let zero = mk_const(c_zero, nty)
  let suc = mk_const(c_suc, mk_fun(nty, nty))
  let pre = mk_const(c_pre, mk_fun(nty, nty))
  let p = mk_var(#'p, path_ty())
  let i = mk_var(#'i, nty)
  mk_abs(p, mk_cond(mk_eq(mk_comb(p, zero), zero),
                    mk_comb(inl, lab),
                    mk_comb(mk_comb(kids, mk_comb(pre, mk_comb(p, zero))),
                            mk_abs(i, mk_comb(p, mk_comb(suc, i))))))

// `|- !l1 k1 l2 k2. node(l1,k1) = node(l2,k2) <=> l1 = l2 and k1 = k2`.
//
// Forward, the two halves read the equation at two paths chosen to select
// them:
//
//   the empty path `\i. 0` takes the `then` branch, leaving `inl l1 = inl l2`,
//   which `inl_inj` opens;
//
//   the path `\i. if i = 0 then suc j else q(pre_num i)` takes the `else`
//   branch, and is built so that `pre_num` of its head is `j` and its tail is
//   `q` -- so it leaves `k1 j q = k2 j q` for arbitrary `j` and `q`, and
//   extensionality closes that into `k1 = k2`.  Every path is reachable this
//   way, which is why injectivity in `kids` holds for the whole function and
//   not just below some arity.
//
// `inl_inj` is `!x y. inl x = inl y <=> x = y`, already instantiated at the
// caller's label and marker types.
fun prove_node_injective(thy :: Theory, ind :: IndThms, inl :: Term,
                         inl_inj :: Thm) :: Thm:
  let nty = num_ty()
  let zero = mk_const(c_zero, nty)
  let suc = mk_const(c_suc, mk_fun(nty, nty))
  let pre = mk_const(c_pre, mk_fun(nty, nty))
  let (lty, oty) = dest_fun(type_of(inl))
  let kty = mk_fun(nty, rep_ty(oty))

  let i = mk_var(#'i, nty)
  let j = mk_var(#'j, nty)
  let q = mk_var(#'q, path_ty())
  let l1 = mk_var(#'l1, lty)
  let l2 = mk_var(#'l2, lty)
  let k1 = mk_var(#'k1, kty)
  let k2 = mk_var(#'k2, kty)

  fun node(lab :: Term, kids :: Term) :: Term: mk_node(inl, lab, kids)
  fun beta(t :: Term) :: Thm:
    match BETA_CONV(thy, t)
    | th :: Thm: th
    | ~else: error(~who: #'prove_node_injective, "beta failed")

  let [cond_t, cond_f] = conditionals(thy)
  fun cond_pick(ty :: HType, c_eq :: Thm, which :: Boolean,
                a :: Term, b :: Term) :: Thm:
    let rule = INST_TYPE(thy, {#'a: ty}, (if which | cond_t | cond_f))
    let cc = mk_const(c_cond, mk_fun(bool, mk_fun(ty, mk_fun(ty, ty))))
    TRANS(AP_THM(thy, AP_THM(thy, AP_TERM(thy, cc, c_eq), a), b),
          SPECL(thy, [a, b], rule))

  let eq_c = mk_const(c_eq, mk_fun(nty, mk_fun(nty, bool)))
  let asm_term = mk_eq(node(l1 :~ Term, k1 :~ Term), node(l2 :~ Term, k2 :~ Term))
  let asm = ASSUME(thy, asm_term)

  // -- the label, read at the empty path ------------------------------------
  let empty = mk_abs(i, zero)
  let label_eq:
    let c_true = EQT_INTRO(thy, beta(mk_comb(empty, zero)))
    fun side(lab :: Term, kids :: Term) :: Thm:
      let branch = mk_comb(mk_comb(kids, mk_comb(pre, mk_comb(empty, zero))),
                           mk_abs(i, mk_comb(empty, mk_comb(suc, i))))
      TRANS(beta(mk_comb(node(lab, kids), empty)),
            cond_pick(oty, c_true, #true, mk_comb(inl, lab), branch))
    let inls = TRANS(SYM(thy, side(l1 :~ Term, k1 :~ Term)),
                     TRANS(AP_THM(thy, asm, empty),
                           side(l2 :~ Term, k2 :~ Term)))
    EQ_MP(SPECL(thy, [l1 :~ Term, l2 :~ Term], inl_inj), inls)

  // -- the children, read at a path that descends into `j` and then is `q` --
  let descend = mk_abs(i, mk_cond(mk_eq(i :~ Term, zero), mk_comb(suc, j),
                                  mk_comb(q, mk_comb(pre, i))))
  let head_eq:
    TRANS(beta(mk_comb(descend, zero)),
          cond_pick(nty, EQT_INTRO(thy, REFL(thy, zero)), #true,
                    mk_comb(suc, j), mk_comb(q, mk_comb(pre, zero))))
  let tail_eq:
    let si = mk_comb(suc, i)
    let step:
      TRANS(beta(mk_comb(descend, si)),
            cond_pick(nty, EQF_INTRO(thy, SPEC(thy, i, ind.suc_not_zero)),
                      #false, mk_comb(suc, j), mk_comb(q, mk_comb(pre, si))))
    EXT(thy, i, TRANS(step, AP_TERM(thy, q, SPEC(thy, i, ind.pre_suc))))

  let kids_eq:
    fun side(lab :: Term, kids :: Term) :: Thm:
      let branch = mk_comb(mk_comb(kids, mk_comb(pre, mk_comb(descend, zero))),
                           mk_abs(i, mk_comb(descend, mk_comb(suc, i))))
      let c_false:
        TRANS(AP_THM(thy, AP_TERM(thy, eq_c, head_eq), zero),
              EQF_INTRO(thy, SPEC(thy, j, ind.suc_not_zero)))
      let taken = TRANS(beta(mk_comb(node(lab, kids), descend)),
                        cond_pick(oty, c_false, #false, mk_comb(inl, lab),
                                  branch))
      let idx = TRANS(AP_TERM(thy, pre, head_eq), SPEC(thy, j, ind.pre_suc))
      TRANS(taken, MK_COMB(AP_TERM(thy, kids, idx), tail_eq))
    EXT(thy, j,
        EXT(thy, q,
            TRANS(SYM(thy, side(l1 :~ Term, k1 :~ Term)),
                  TRANS(AP_THM(thy, asm, descend),
                        side(l2 :~ Term, k2 :~ Term)))))

  let forward = DISCH(thy, asm_term, CONJ(thy, label_eq, kids_eq))

  // -- and the converse, which is just congruence ---------------------------
  let backward:
    let both = mk_conj(mk_eq(l1 :~ Term, l2), mk_eq(k1 :~ Term, k2))
    let a = ASSUME(thy, both)
    let p = mk_var(#'p, path_ty())
    let le = CONJUNCT1(thy, a)
    let ke = CONJUNCT2(thy, a)
    let body:
      let head = mk_eq(mk_comb(p, zero), zero)
      let branch_eq:
        MK_COMB(MK_COMB(ke, REFL(thy, mk_comb(pre, mk_comb(p, zero)))),
                REFL(thy, mk_abs(i, mk_comb(p, mk_comb(suc, i)))))
      let cc = mk_const(c_cond, mk_fun(bool, mk_fun(oty, mk_fun(oty, oty))))
      MK_COMB(MK_COMB(AP_TERM(thy, cc, REFL(thy, head)),
                      AP_TERM(thy, inl, le)),
              branch_eq)
    DISCH(thy, both, ABS(thy, p, body))

  GENL(thy, [l1, k1, l2, k2], IMP_ANTISYM_RULE(thy, forward, backward))

// -- constructor arities ------------------------------------------------------
//
// `node` takes its children as a function `num -> Rep`, but a constructor has
// a fixed finite number of them.  `mk_kids` packs `n` children into such a
// function, filling every index at or past `n` with a junk value the caller
// supplies -- which never has to be a real tree, because nothing ever reads
// those slots.  Injectivity only needs the `n` slots that are read.

// `suc_num(...(zero_num))`, `m` times.
fun num_lit(m :: Int) :: Term:
  let nty = num_ty()
  let suc = mk_const(c_suc, mk_fun(nty, nty))
  recur loop (k = m, acc :~ Term = mk_const(c_zero, nty)):
    cond
    | k == 0: acc
    | ~else: loop(k - 1, mk_comb(suc, acc))

// `|- (num_lit(a) === num_lit(b)) = false` for `a /= b`, by peeling `suc`s
// with injectivity until one side is `zero_num` and the other is not.
fun prove_lit_distinct(thy :: Theory, ind :: IndThms,
                       a :: Int, b :: Int) :: Thm:
  let nty = num_ty()
  let zero = mk_const(c_zero, nty)
  let suc = mk_const(c_suc, mk_fun(nty, nty))
  when a == b
  | error(~who: #'prove_lit_distinct, "indices are equal")
  recur loop (i = a, j = b):
    cond
    | i == 0:
        // `zero = suc ...` is false: `suc_not_zero` the other way round
        let t = num_lit(j - 1)
        let stmt = mk_eq(zero, mk_comb(suc, t))
        let contra = MP(thy, NOT_ELIM(thy, SPEC(thy, t, ind.suc_not_zero)),
                        SYM(thy, ASSUME(thy, stmt)))
        EQF_INTRO(thy, NOT_INTRO(thy, DISCH(thy, stmt, contra)))
    | j == 0:
        let t = num_lit(i - 1)
        EQF_INTRO(thy, SPEC(thy, t, ind.suc_not_zero))
    | ~else:
        // peel: `suc x = suc y <=> x = y`, so the outer equation is the inner
        let inner = loop(i - 1, j - 1)
        TRANS(SPECL(thy, [num_lit(i - 1), num_lit(j - 1)], ind.suc_injective),
              inner)

// `\j. if j = 0 then t0 else if j = 1 then t1 else ... else junk`
fun mk_kids(junk :: Term, ts :: List.of(Term)) :: Term:
  let nty = num_ty()
  let j = mk_var(#'j, nty)
  let body:
    recur loop (i = ts.length() - 1, acc :~ Term = junk):
      cond
      | i < 0: acc
      | ~else: loop(i - 1, mk_cond(mk_eq(j :~ Term, num_lit(i)), ts[i], acc))
  mk_abs(j, body)

// `|- mk_kids(junk, ts) (num_lit m) = ts[m]`, the only fact about the packing
// that anything downstream needs.
fun prove_kids_at(thy :: Theory, ind :: IndThms, junk :: Term,
                  ts :: List.of(Term), m :: Int) :: Thm:
  let nty = num_ty()
  let rty = type_of(junk)
  let j = mk_var(#'j, nty)
  let lit = num_lit(m)
  let [cond_t, cond_f] = conditionals(thy)
  fun pick(c_eq :: Thm, which :: Boolean, x :: Term, y :: Term) :: Thm:
    let rule = INST_TYPE(thy, {#'a: rty}, (if which | cond_t | cond_f))
    let cc = mk_const(c_cond, mk_fun(bool, mk_fun(rty, mk_fun(rty, rty))))
    TRANS(AP_THM(thy, AP_THM(thy, AP_TERM(thy, cc, c_eq), x), y),
          SPECL(thy, [x, y], rule))
  let beta:
    match BETA_CONV(thy, mk_comb(mk_kids(junk, ts), lit))
    | th :: Thm: th
    | ~else: error(~who: #'prove_kids_at, "beta failed")
  // walk the cond chain from the outside in, taking the false branch until
  // the index matches
  let walk:
    recur loop (i = 0, acc :~ Thm = beta):
      let rest:
        recur build (k = ts.length() - 1, a :~ Term = junk):
          cond
          | k < i + 1: a
          | ~else: build(k - 1, mk_cond(mk_eq(lit, num_lit(k)), ts[k], a))
      cond
      | i == m: TRANS(acc, pick(EQT_INTRO(thy, REFL(thy, lit)), #true,
                                ts[i], rest))
      | ~else:
          loop(i + 1,
               TRANS(acc, pick(prove_lit_distinct(thy, ind, m, i), #false,
                               ts[i], rest)))
  walk

// `|- mk_kids(junk, ts) = mk_kids(junk, us)  ==>  ts[m] = us[m]`, for each
// slot the constructor actually uses.
fun prove_kids_injective(thy :: Theory, ind :: IndThms, junk :: Term,
                         ts :: List.of(Term), us :: List.of(Term),
                         m :: Int) :: Thm:
  let eq_term = mk_eq(mk_kids(junk, ts), mk_kids(junk, us))
  let asm = ASSUME(thy, eq_term)
  let at = AP_THM(thy, asm, num_lit(m))
  DISCH(thy, eq_term,
        TRANS(SYM(thy, prove_kids_at(thy, ind, junk, ts, m)),
              TRANS(at, prove_kids_at(thy, ind, junk, us, m))))

// `|- mk_kids(junk, us) = mk_kids(junk, vs)`, given `|- u_k = v_k` for each
// slot.  Congruence under the binder: the packing is a chain of conditionals
// whose tests do not mention the children, so only the branches move.
fun prove_kids_cong(thy :: Theory, junk :: Term,
                    eqs :: List.of(Thm)) :: Thm:
  let nty = num_ty()
  let j = mk_var(#'j, nty)
  let rty = type_of(junk)
  let cc = mk_const(c_cond, mk_fun(bool, mk_fun(rty, mk_fun(rty, rty))))
  let body:
    recur loop (k = eqs.length() - 1, acc :~ Thm = REFL(thy, junk)):
      cond
      | k < 0: acc
      | ~else:
          let test = REFL(thy, mk_eq(j :~ Term, num_lit(k)))
          loop(k - 1, MK_COMB(MK_COMB(AP_TERM(thy, cc, test),
                                      (eqs[k] :~ Thm)),
                              acc))
  ABS(thy, j, body)

// -- the carved set ----------------------------------------------------------
//
// A datatype's representation is the *least* set of trees closed under its
// constructors.  Written the way `NUM_REP` is written in `infinity.rhm`:
//
//   REP t  :=  !P. closed(P) ==> P t
//
//   closed(P)  :=  for each constructor i,
//                    !a t1..tn. P t1 and ... and P tn
//                               ==> P (node (label_i a) (kids [t1..tn]))
//
// Least, not merely closed, is what gives induction: a predicate that
// survives every constructor holds of everything in the set, because the set
// was defined as the intersection of all such predicates.  Nothing about
// finiteness has to be said -- infinite trees are simply not reachable by the
// closure, so they are not in the intersection.
//
// `label` is the map from a constructor's non-recursive fields to the label
// type: `A_i -> Label`, so a nullary-field constructor passes a constant
// function's worth of `unit`.
class CtorRep(label :: Term, arity :: Int)

// `node (label_i a) (kids [t1..tn])`, the tree constructor `i` builds.
fun mk_ctor_term(inl :: Term, junk :: Term, c :: CtorRep,
                 a :: Term, ts :: List.of(Term)) :: Term:
  unless ts.length() == c.arity
  | error(~who: #'mk_ctor_term, "wrong number of children",
          error.val(~label: "arity", c.arity))
  mk_node(inl, mk_comb(c.label, a), mk_kids(junk, ts))

// The closure conjunct for one constructor, at a predicate `p`.
fun ctor_closure(inl :: Term, junk :: Term, rty :: HType, p :: Term,
                 c :: CtorRep, i :: Int) :: Term:
  let (aty, _) = dest_fun(type_of(c.label))
  let a = mk_var(Symbol.from_string("a" ++ to_string(i)), aty)
  let ts = for List (k in List.iota(c.arity)):
             mk_var(Symbol.from_string("t" ++ to_string(i) ++ "_" ++ to_string(k)), rty)
  let concl = mk_comb(p, mk_ctor_term(inl, junk, c, a :~ Term,
                                      ts.map(fun (v :: FVar): v :~ Term)))
  let body:
    cond
    | c.arity == 0: concl
    | ~else:
        let prem:
          recur loop (k = ts.length() - 1,
                      acc :~ Term = mk_comb(p, (ts[ts.length() - 1] :~ FVar) :~ Term)):
            cond
            | k <= 0: acc
            | ~else: loop(k - 1, mk_conj(mk_comb(p, (ts[k - 1] :~ FVar) :~ Term), acc))
        mk_imp(prem, concl)
  mk_forall_list([a] ++ ts, body)

// `closed(p)`, the conjunction over every constructor.
fun closure_term(inl :: Term, junk :: Term, rty :: HType, p :: Term,
                 ctors :: List.of(CtorRep)) :: Term:
  let parts = for List (c in ctors, i in List.iota(ctors.length())):
                ctor_closure(inl, junk, rty, p, c :~ CtorRep, i)
  recur loop (k = parts.length() - 1, acc :~ Term = parts[parts.length() - 1]):
    cond
    | k <= 0: acc
    | ~else: loop(k - 1, mk_conj(parts[k - 1], acc))

// `\t. !P. closed(P) ==> P t`
fun mk_rep_pred(inl :: Term, junk :: Term,
                ctors :: List.of(CtorRep)) :: Term:
  let rty = type_of(junk)
  let t = mk_var(#'t, rty)
  let p = mk_var(#'P, mk_fun(rty, bool))
  mk_abs(t, mk_forall(p, mk_imp(closure_term(inl, junk, rty, p :~ Term, ctors),
                                mk_comb(p, t))))

// `|- REP t1 and ... and REP tn ==> REP (ctor_i a t1..tn)` -- one per
// constructor, the fact that says the carved set really is closed under what
// it was defined to be closed under.
//
// `rep_at` is the caller's `|- REP t <=> !P. closed(P) ==> P t`, so this works
// against the *named* constant rather than the raw lambda.
fun prove_rep_closed(thy :: Theory, inl :: Term, junk :: Term,
                     ctors :: List.of(CtorRep), rep :: Term,
                     rep_at :: Function.of_arity(1), i :: Int) :: Thm:
  let rty = type_of(junk)
  let c :~ CtorRep = ctors[i]
  let (aty, _) = dest_fun(type_of(c.label))
  let a = mk_var(#'a, aty)
  let ts = for List (k in List.iota(c.arity)):
             mk_var(Symbol.from_string("t" ++ to_string(k)), rty)
  let p = mk_var(#'P, mk_fun(rty, bool))
  let closed = closure_term(inl, junk, rty, p :~ Term, ctors)
  let closed_asm = ASSUME(thy, closed)
  // the conjunct for this constructor, specialised at `a` and the children
  let mine:
    recur loop (k = 0, acc :~ Thm = closed_asm):
      cond
      | k == ctors.length() - 1: acc
      | k == i: CONJUNCT1(thy, acc)
      | ~else: loop(k + 1, CONJUNCT2(thy, acc))
  let mine_at = SPECL(thy, [a :~ Term] ++ ts.map(fun (v :: FVar): v :~ Term),
                      mine)
  // The children's memberships arrive as one conjunction, matching the shape
  // the closure clause states -- not curried, which is what a caller feeding
  // this to `MP` has in hand.
  let members_term:
    cond
    | c.arity == 0: tm_true
    | ~else:
        recur loop (k = ts.length() - 1,
                    acc :~ Term = mk_comb(rep, (ts[ts.length() - 1] :~ FVar) :~ Term)):
          cond
          | k <= 0: acc
          | ~else: loop(k - 1, mk_conj(mk_comb(rep, (ts[k - 1] :~ FVar) :~ Term), acc))
  let members_asm:
    cond
    | c.arity == 0: #false
    | ~else: ASSUME(thy, members_term)
  let member_of:
    fun (k :: Int) :: Thm:
      recur loop (n = 0, acc :~ Thm = (members_asm :~ Thm)):
        cond
        | n == ts.length() - 1: acc
        | n == k: CONJUNCT1(thy, acc)
        | ~else: loop(n + 1, CONJUNCT2(thy, acc))
  // `P t_k` for each child, from `REP t_k` and the same `closed`
  let child_ps = for List (k in List.iota(ts.length())):
                   MP(thy, SPEC(thy, p,
                                EQ_MP(rep_at((ts[k] :~ FVar) :~ Term),
                                      member_of(k))),
                      closed_asm)
  let concl:
    cond
    | c.arity == 0: mine_at
    | ~else:
        let prem:
          recur loop (k = child_ps.length() - 1,
                      acc :~ Thm = child_ps[child_ps.length() - 1]):
            cond
            | k <= 0: acc
            | ~else: loop(k - 1, CONJ(thy, child_ps[k - 1] :~ Thm, acc))
        MP(thy, mine_at, prem)
  let built = mk_ctor_term(inl, junk, c, a :~ Term,
                           ts.map(fun (v :: FVar): v :~ Term))
  let rep_built = EQ_MP(SYM(thy, rep_at(built)),
                        GEN(thy, p, DISCH(thy, closed, concl)))
  let discharged:
    cond
    | c.arity == 0: rep_built
    | ~else: DISCH(thy, members_term, rep_built)
  GENL(thy, [a] ++ ts, discharged)

// -- from the representation to the type -------------------------------------
//
// What `new_basic_type_definition` hands back, kept together: the carved
// type, its two coercions, and the two theorems relating them.  `rep_const`
// is the `REP` constant the type was carved against.
class Carved(ty :: HType, abs :: Term, rep :: Term,
             rep_const :: Term, abs_rep :: Thm, rep_pred :: Thm)

// `|- REP(rep x)`: everything in the type came from the set.  The kernel
// states its two theorems about fixed variables, so this instantiates them
// rather than reaching for anything by name.
fun prove_rep_in_set(thy :: Theory, cv :: Carved, x :: Term) :: Thm:
  let (tree_ty, _) = dest_fun(type_of(cv.rep_const))
  let rv = mk_var(v_rep, tree_ty)
  let av = mk_var(v_alpha, cv.ty)
  let at_r = INST(thy, [[mk_comb(cv.rep, x), rv]], cv.rep_pred)
  EQ_MP(SYM(thy, at_r),
        AP_TERM(thy, cv.rep, INST(thy, [[x, av]], cv.abs_rep)))

// `abs` is injective where `REP` holds: given `|- REP t1`, `|- REP t2` and
// `|- abs t1 = abs t2`, conclude `|- t1 = t2`.  This is where the carving
// does its work -- the type is exactly the set, so two representatives that
// abstract alike were equal already.
fun prove_abs_injective(thy :: Theory, cv :: Carved, t1 :: Term, t2 :: Term,
                        r1 :: Thm, r2 :: Thm, eq :: Thm) :: Thm:
  let rv = mk_var(v_rep, type_of(t1))
  let ra = EQ_MP(INST(thy, [[t1, rv]], cv.rep_pred), r1)
  let rb = EQ_MP(INST(thy, [[t2, rv]], cv.rep_pred), r2)
  TRANS(SYM(thy, ra), TRANS(AP_TERM(thy, cv.rep, eq), rb))

// `C_i(a, x1..xn) = abs(node(label_i a, kids [rep x1, ..., rep xn]))`
fun mk_abs_ctor(inl :: Term, junk :: Term, cv :: Carved, c :: CtorRep,
                a :: Term, xs :: List.of(Term)) :: Term:
  mk_comb(cv.abs,
          mk_ctor_term(inl, junk, c, a,
                       xs.map(fun (x :: Term): mk_comb(cv.rep, x))))

// `|- !a xs a' xs'. C_i(a, xs) = C_i(a', xs') ==> a = a' and xs = xs'`.
//
// Four steps, each one already available: both sides are in the set (the
// closure theorem, fed the children's own membership), so `abs` is injective
// on them; `node` is injective, splitting label from children; the label's
// own injection separates `a`; and `kids` gives back each child's
// representative, which `abs_rep` turns back into the child.
//
// `label_inj` is `!x y. label_i x = label_i y <=> x = y`, which the caller
// has from whatever sum encodes the tags.
fun prove_ctor_injective(thy :: Theory, inl :: Term, junk :: Term,
                         ctors :: List.of(CtorRep), cv :: Carved,
                         closed :: Thm, node_inj :: Thm, label_inj :: Thm,
                         kids_inj :: Function.of_arity(3),
                         i :: Int) :: Thm:
  let c :~ CtorRep = ctors[i]
  let (aty, _) = dest_fun(type_of(c.label))
  let av = mk_var(v_alpha, cv.ty)
  let a1 = mk_var(#'a1, aty)
  let a2 = mk_var(#'a2, aty)
  let xs1 = for List (k in List.iota(c.arity)):
              mk_var(Symbol.from_string("x1_" ++ to_string(k)), cv.ty)
  let xs2 = for List (k in List.iota(c.arity)):
              mk_var(Symbol.from_string("x2_" ++ to_string(k)), cv.ty)
  fun reps(xs :: List) :: List.of(Term):
    for List (x in xs): mk_comb(cv.rep, (x :~ FVar) :~ Term)
  fun tree(a :: Term, xs :: List) :: Term:
    mk_ctor_term(inl, junk, c, a, reps(xs))
  fun in_set(a :: Term, xs :: List) :: Thm:
    prove_ctor_in_set(thy, cv, closed, c, a,
                      xs.map(fun (x :: FVar): x :~ Term))

  let asm_t = mk_eq(mk_comb(cv.abs, tree(a1 :~ Term, xs1)),
                    mk_comb(cv.abs, tree(a2 :~ Term, xs2)))
  let asm = ASSUME(thy, asm_t)
  let nodes_eq = prove_abs_injective(thy, cv, tree(a1 :~ Term, xs1),
                                     tree(a2 :~ Term, xs2),
                                     in_set(a1 :~ Term, xs1),
                                     in_set(a2 :~ Term, xs2), asm)
  let parts:
    EQ_MP(SPECL(thy, [mk_comb(c.label, a1 :~ Term), mk_kids(junk, reps(xs1)),
                      mk_comb(c.label, a2 :~ Term), mk_kids(junk, reps(xs2))],
                node_inj),
          nodes_eq)
  let field_eq = EQ_MP(SPECL(thy, [a1 :~ Term, a2 :~ Term], label_inj),
                       CONJUNCT1(thy, parts))
  let child_eqs = for List (k in List.iota(c.arity)):
                    let reps_eq = MP(thy, kids_inj(reps(xs1), reps(xs2), k),
                                     CONJUNCT2(thy, parts))
                    TRANS(SYM(thy, INST(thy, [[(xs1[k] :~ FVar) :~ Term, av]],
                                        cv.abs_rep)),
                          TRANS(AP_TERM(thy, cv.abs, reps_eq),
                                INST(thy, [[(xs2[k] :~ FVar) :~ Term, av]],
                                     cv.abs_rep)))
  // the field equation and one per child, conjoined left to right
  let concl:
    let parts = [field_eq] ++ child_eqs
    recur loop (k = parts.length() - 1,
                acc :~ Thm = (parts[parts.length() - 1] :~ Thm)):
      cond
      | k <= 0: acc
      | ~else: loop(k - 1, CONJ(thy, (parts[k - 1] :~ Thm), acc))
  GENL(thy, [a1] ++ xs1 ++ [a2] ++ xs2, DISCH(thy, asm_t, concl))

// `|- REP(node (label_i a) (kids [rep x1, ..., rep xn]))`: the constructor's
// own tree is in the carved set, because each child's representative is.
fun prove_ctor_in_set(thy :: Theory, cv :: Carved, closed :: Thm,
                      c :: CtorRep, a :: Term,
                      xs :: List.of(Term)) :: Thm:
  let reps = xs.map(fun (x :: Term): mk_comb(cv.rep, x))
  let base = SPECL(thy, [a] ++ reps, closed)
  cond
  | c.arity == 0: base
  | ~else:
      let ms = for List (x in xs): prove_rep_in_set(thy, cv, x :~ Term)
      let prem:
        recur loop (k = ms.length() - 1, acc :~ Thm = (ms[ms.length() - 1] :~ Thm)):
          cond
          | k <= 0: acc
          | ~else: loop(k - 1, CONJ(thy, (ms[k - 1] :~ Thm), acc))
      MP(thy, base, prem)

// `|- !a xs b ys. not (C_i(a, xs) = C_j(b, ys))`, for `i /= j`.
//
// If they were equal then, both being in the set, their trees would be --
// and `node`'s injectivity would make their labels equal, which the tag
// sum says they are not.  `label_distinct` is
// `!x y. not (label_i x = label_j y)`.
fun prove_ctor_distinct(thy :: Theory, inl :: Term, junk :: Term,
                        ctors :: List.of(CtorRep), cv :: Carved,
                        closed_i :: Thm, closed_j :: Thm, node_inj :: Thm,
                        label_distinct :: Thm, i :: Int, j :: Int) :: Thm:
  let ci :~ CtorRep = ctors[i]
  let cj :~ CtorRep = ctors[j]
  let (ity, _) = dest_fun(type_of(ci.label))
  let (jty, _) = dest_fun(type_of(cj.label))
  let a = mk_var(#'a, ity)
  let b = mk_var(#'b, jty)
  let xs = for List (k in List.iota(ci.arity)):
             mk_var(Symbol.from_string("x" ++ to_string(k)), cv.ty)
  let ys = for List (k in List.iota(cj.arity)):
             mk_var(Symbol.from_string("y" ++ to_string(k)), cv.ty)
  fun reps(vs :: List) :: List.of(Term):
    for List (v in vs): mk_comb(cv.rep, (v :~ FVar) :~ Term)
  let ti = mk_ctor_term(inl, junk, ci, a :~ Term, reps(xs))
  let tj = mk_ctor_term(inl, junk, cj, b :~ Term, reps(ys))
  let asm_t = mk_eq(mk_comb(cv.abs, ti), mk_comb(cv.abs, tj))
  let asm = ASSUME(thy, asm_t)
  let nodes_eq:
    prove_abs_injective(thy, cv, ti, tj,
                        prove_ctor_in_set(thy, cv, closed_i, ci, a :~ Term,
                                          xs.map(fun (v :: FVar): v :~ Term)),
                        prove_ctor_in_set(thy, cv, closed_j, cj, b :~ Term,
                                          ys.map(fun (v :: FVar): v :~ Term)),
                        asm)
  let labels_eq:
    CONJUNCT1(thy,
              EQ_MP(SPECL(thy, [mk_comb(ci.label, a :~ Term),
                                mk_kids(junk, reps(xs)),
                                mk_comb(cj.label, b :~ Term),
                                mk_kids(junk, reps(ys))], node_inj),
                    nodes_eq))
  let contra = MP(thy, NOT_ELIM(thy, SPECL(thy, [a :~ Term, b :~ Term],
                                           label_distinct)),
                  labels_eq)
  GENL(thy, [a] ++ xs ++ [b] ++ ys,
       NOT_INTRO(thy, DISCH(thy, asm_t, contra)))

// `|- !P. (for each constructor: !a xs. P x1 and ... and P xn
//                                      ==> P (C_i(a, xs)))
//         ==> !x. P x`
//
// The carved set was defined as the least one closed under the constructors,
// so this is that minimality read through the bijection.  The predicate it is
// applied to is `\t. REP t and P (abs t)`: the `REP t` conjunct is not
// decoration, because the step needs `rep(abs t) = t` to see that the
// hypothesis's `C_i(a, [abs t1, ...])` is the very tree being built, and that
// only holds for `t` in the set.
fun prove_datatype_induction(thy :: Theory, inl :: Term, junk :: Term,
                             ctors :: List.of(CtorRep), cv :: Carved,
                             closed :: List.of(Thm), node_inj :: Thm,
                             rep_at :: Function.of_arity(1)) :: Thm:
  let rty = type_of(junk)
  let bigP = mk_var(#'P, mk_fun(cv.ty, bool))
  let t = mk_var(#'t, rty)
  let x = mk_var(#'x, cv.ty)
  let av = mk_var(v_alpha, cv.ty)
  let rv = mk_var(v_rep, rty)

  // the datatype-level case for constructor `i`
  fun case_term(i :: Int) :: Term:
    let c :~ CtorRep = ctors[i]
    let (aty, _) = dest_fun(type_of(c.label))
    let a = mk_var(Symbol.from_string("ca" ++ to_string(i)), aty)
    let xs = for List (k in List.iota(c.arity)):
               mk_var(Symbol.from_string("cx" ++ to_string(i) ++ "_" ++ to_string(k)),
                      cv.ty)
    let built = mk_abs_ctor(inl, junk, cv, c, a :~ Term,
                            xs.map(fun (v :: FVar): v :~ Term))
    let concl = mk_comb(bigP, built)
    let body:
      cond
      | c.arity == 0: concl
      | ~else:
          let prem:
            recur loop (k = xs.length() - 1,
                        acc :~ Term = mk_comb(bigP, (xs[xs.length() - 1] :~ FVar) :~ Term)):
              cond
              | k <= 0: acc
              | ~else: loop(k - 1, mk_conj(mk_comb(bigP, (xs[k - 1] :~ FVar) :~ Term), acc))
          mk_imp(prem, concl)
    mk_forall_list([a] ++ xs, body)

  let cases = for List (i in List.iota(ctors.length())): case_term(i)
  let hyp_term:
    recur loop (k = cases.length() - 1, acc :~ Term = cases[cases.length() - 1]):
      cond
      | k <= 0: acc
      | ~else: loop(k - 1, mk_conj(cases[k - 1], acc))
  let hyp = ASSUME(thy, hyp_term)
  fun case_of(i :: Int) :: Thm:
    recur loop (k = 0, acc :~ Thm = hyp):
      cond
      | k == ctors.length() - 1: acc
      | k == i: CONJUNCT1(thy, acc)
      | ~else: loop(k + 1, CONJUNCT2(thy, acc))

  // `Q = \t. REP t and P (abs t)`
  let qbody = mk_conj(mk_comb(cv.rep_const, t :~ Term),
                      mk_comb(bigP, mk_comb(cv.abs, t :~ Term)))
  let q = mk_abs(t, qbody)
  fun q_at(u :: Term) :: Thm:
    match BETA_CONV(thy, mk_comb(q, u))
    | th :: Thm: th
    | ~else: error(~who: #'prove_datatype_induction, "beta failed")

  // `Q` survives every constructor
  fun q_case(i :: Int) :: Thm:
    let c :~ CtorRep = ctors[i]
    let (aty, _) = dest_fun(type_of(c.label))
    let a = mk_var(#'qa, aty)
    let ts = for List (k in List.iota(c.arity)):
               mk_var(Symbol.from_string("qt" ++ to_string(k)), rty)
    let tts = ts.map(fun (v :: FVar): v :~ Term)
    // the children's `Q`s arrive as one conjunction, matching the closure
    // clause's own shape -- assuming them separately would leave hypotheses
    // that the single `DISCH` below could not remove
    let prem_term:
      cond
      | c.arity == 0: tm_true
      | ~else:
          recur loop (k = tts.length() - 1,
                      acc :~ Term = mk_comb(q, tts[tts.length() - 1])):
            cond
            | k <= 0: acc
            | ~else: loop(k - 1, mk_conj(mk_comb(q, tts[k - 1]), acc))
    let prem_asm:
      cond
      | c.arity == 0: #false
      | ~else: ASSUME(thy, prem_term)
    let q_asms = for List (k in List.iota(tts.length())):
                   recur loop (n = 0, acc :~ Thm = (prem_asm :~ Thm)):
                     cond
                     | n == tts.length() - 1: acc
                     | n == k: CONJUNCT1(thy, acc)
                     | ~else: loop(n + 1, CONJUNCT2(thy, acc))
    let parts = for List (u in tts, qa in q_asms):
                  EQ_MP(q_at(u), qa :~ Thm)
    let reps = for List (pp in parts): CONJUNCT1(thy, pp :~ Thm)
    let ps = for List (pp in parts): CONJUNCT2(thy, pp :~ Thm)
    // the tree is in the set
    let in_set:
      let base = SPECL(thy, [a :~ Term] ++ tts, (closed[i] :~ Thm))
      cond
      | c.arity == 0: base
      | ~else:
          let prem:
            recur loop (k = reps.length() - 1, acc :~ Thm = (reps[reps.length() - 1] :~ Thm)):
              cond
              | k <= 0: acc
              | ~else: loop(k - 1, CONJ(thy, (reps[k - 1] :~ Thm), acc))
          MP(thy, base, prem)
    // and `P` holds of it: the hypothesis, at the children's abstractions
    let p_holds:
      let abs_ts = for List (u in tts): mk_comb(cv.abs, u)
      let inst = SPECL(thy, [a :~ Term] ++ abs_ts, case_of(i))
      let got:
        cond
        | c.arity == 0: inst
        | ~else:
            let prem:
              recur loop (k = ps.length() - 1, acc :~ Thm = (ps[ps.length() - 1] :~ Thm)):
                cond
                | k <= 0: acc
                | ~else: loop(k - 1, CONJ(thy, (ps[k - 1] :~ Thm), acc))
            MP(thy, inst, prem)
      // `C_i(a, [abs t]) = abs(node(label a)(kids ts))`, since `rep(abs t) = t`
      cond
      | c.arity == 0: got
      | ~else:
          let back = for List (u in tts, rp in reps):
                       EQ_MP(INST(thy, [[u, rv]], cv.rep_pred), rp :~ Thm)
          let kids_eq = prove_kids_cong(thy, junk, back)
          let node_eq:
            let lab = mk_comb(c.label, a :~ Term)
            let bwd = SPECL(thy, [lab, mk_kids(junk, for List (u in tts): mk_comb(cv.rep, mk_comb(cv.abs, u))),
                                  lab, mk_kids(junk, tts)], node_inj)
            EQ_MP(SYM(thy, bwd), CONJ(thy, REFL(thy, lab), kids_eq))
          EQ_MP(AP_TERM(thy, bigP, AP_TERM(thy, cv.abs, node_eq)), got)
    let built = mk_ctor_term(inl, junk, c, a :~ Term, tts)
    let q_built = EQ_MP(SYM(thy, q_at(built)), CONJ(thy, in_set, p_holds))
    let discharged:
      cond
      | c.arity == 0: q_built
      | ~else: DISCH(thy, prem_term, q_built)
    GENL(thy, [a] ++ ts, discharged)

  // Hmm: `closed(Q)` is stated with the conjunction of `Q t_k` as premise,
  // which is what `q_case` discharges above.
  let q_closed:
    let cs = for List (i in List.iota(ctors.length())): q_case(i)
    recur loop (k = cs.length() - 1, acc :~ Thm = (cs[cs.length() - 1] :~ Thm)):
      cond
      | k <= 0: acc
      | ~else: loop(k - 1, CONJ(thy, (cs[k - 1] :~ Thm), acc))

  // and then every element of the type is reached
  let rep_x = mk_comb(cv.rep, x :~ Term)
  let q_rep = MP(thy, SPEC(thy, q, EQ_MP(rep_at(rep_x),
                                         prove_rep_in_set(thy, cv, x :~ Term))),
                 q_closed)
  let p_abs = CONJUNCT2(thy, EQ_MP(q_at(rep_x), q_rep))
  let p_x = EQ_MP(AP_TERM(thy, bigP, INST(thy, [[x :~ Term, av]], cv.abs_rep)),
                  p_abs)
  GEN(thy, bigP, DISCH(thy, hyp_term, GEN(thy, x, p_x)))

// `|- !x. (?a. x = C_0(a, ...)) or ... or (?a xs. x = C_m(a, xs))`
//
// Exhaustiveness, from induction: take the predicate to be the disjunction
// itself.  At each constructor the obligation is discharged by choosing that
// disjunct and witnessing it with the arguments in hand, so the case
// hypotheses are never used -- exhaustiveness does not depend on anything
// holding of the children, only on there being no other way to build a value.
fun prove_datatype_cases(thy :: Theory, inl :: Term, junk :: Term,
                         ctors :: List.of(CtorRep), cv :: Carved,
                         induction :: Thm) :: Thm:
  let m = ctors.length()
  let x = mk_var(#'x, cv.ty)

  fun ctor_vars(i :: Int, prefix :: String) :: values(FVar, List.of(FVar)):
    let c :~ CtorRep = ctors[i]
    let (aty, _) = dest_fun(type_of(c.label))
    values(mk_var(Symbol.from_string(prefix ++ "a" ++ to_string(i)), aty),
           for List (k in List.iota(c.arity)):
             mk_var(Symbol.from_string(prefix ++ to_string(i) ++ "_" ++ to_string(k)),
                    cv.ty))

  // `?a xs. scrut = C_i(a, xs)`
  fun disjunct(scrut :: Term, i :: Int) :: Term:
    let (a, xs) = ctor_vars(i, "d")
    let built = mk_abs_ctor(inl, junk, cv, (ctors[i] :~ CtorRep), a :~ Term,
                            xs.map(fun (v :: FVar): v :~ Term))
    for values(t :~ Term = mk_eq(scrut, built)) (v in ([a] ++ xs).reverse()):
      mk_exists(v :~ FVar, t)

  // the disjunction of `d_k .. d_{m-1}`, nested to the right
  fun rest(scrut :: Term, k :: Int) :: Term:
    recur loop (n = m - 2, acc :~ Term = disjunct(scrut, m - 1)):
      cond
      | n < k: acc
      | ~else: loop(n - 1, mk_disj(disjunct(scrut, n), acc))

  let bigP = mk_abs(x, rest(x :~ Term, 0))
  fun p_at(t :: Term) :: Thm:
    match BETA_CONV(thy, mk_comb(bigP, t))
    | th :: Thm: th
    | ~else: error(~who: #'prove_datatype_cases, "beta failed")

  // the induction premise for constructor `i`, discharged outright
  fun premise_for(i :: Int) :: Thm:
    let c :~ CtorRep = ctors[i]
    let (a, xs) = ctor_vars(i, "c")
    let args = [a :~ Term] ++ xs.map(fun (v :: FVar): v :~ Term)
    let built = mk_abs_ctor(inl, junk, cv, c, a :~ Term,
                            xs.map(fun (v :: FVar): v :~ Term))
    // fill this disjunct's existentials from the inside out
    let witnessed:
      recur loop (k = args.length() - 1, acc :~ Thm = REFL(thy, built)):
        cond
        | k < 0: acc
        | ~else:
            let target:
              recur peel (n = 0, t :~ Term = disjunct(built, i)):
                cond
                | n == k: t
                | ~else:
                    match dest_exists(t)
                    | [v, body]: peel(n + 1, inst_fvar([[args[n], v :~ FVar]], body))
                    | ~else: error(~who: #'prove_datatype_cases, "shape")
            loop(k - 1, EXISTS(thy, target, args[k], acc))
    // inject it into the disjunction: right first, then wrap leftwards
    let innermost:
      cond
      | i == m - 1: witnessed
      | ~else: DISJ1(thy, witnessed, rest(built, i + 1))
    let chosen:
      recur loop (k = i - 1, acc :~ Thm = innermost):
        cond
        | k < 0: acc
        | ~else: loop(k - 1, DISJ2(thy, disjunct(built, k), acc))
    let at_built = EQ_MP(SYM(thy, p_at(built)), chosen)
    let body:
      cond
      | c.arity == 0: at_built
      | ~else:
          let prem:
            recur loop (k = xs.length() - 1,
                        acc :~ Term = mk_comb(bigP, (xs[xs.length() - 1] :~ FVar) :~ Term)):
              cond
              | k <= 0: acc
              | ~else: loop(k - 1, mk_conj(mk_comb(bigP, (xs[k - 1] :~ FVar) :~ Term), acc))
          DISCH(thy, prem, at_built)
    GENL(thy, [a] ++ xs, body)

  let parts = for List (i in List.iota(m)): premise_for(i)
  let prem:
    recur loop (k = parts.length() - 1, acc :~ Thm = (parts[parts.length() - 1] :~ Thm)):
      cond
      | k <= 0: acc
      | ~else: loop(k - 1, CONJ(thy, (parts[k - 1] :~ Thm), acc))
  let all_p = MP(thy, SPEC(thy, bigP, induction), prem)
  // `SPEC` reduces the head application here but not inside the premise
  // above, so reduce only if there is something left to reduce.
  let at_x = SPEC(thy, x, all_p)
  GEN(thy, x,
      match BETA_CONV(thy, concl_of(at_x))
      | th :: Thm: EQ_MP(th, at_x)
      | ~else: at_x)
