#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Concrete prover-backed capabilities for the definition layer. This is the
// only boundary adapter that knows the opaque rewrite handle is a RuleDB.

import:
  rhombus/hol/backend/proof/definition/capabilities open
  rhombus/hol/backend/proof/automation/tautology open
  rhombus/hol/backend/proof/automation/rules open
  rhombus/hol/backend/proof/automation/limits open

export:
  definition_logic_rules
  definition_rewrite_support

def definition_logic_rules :: LogicRules:
  LogicRules(tautologies, conditionals, NOT_TRUE_EQ_FALSE, excluded_middle)

def definition_rewrite_support :: RewriteSupport:
  RewriteSupport(
    fun (): empty_db,
    fun (thy, db, name, th): add_thm(thy, db :~ RuleDB, name, th),
    fun (thy, db, name, th): add_rewrite_thm(thy, db :~ RuleDB, name, th),
    fun (db, thy, t):
      simp_conv(db :~ RuleDB, fresh_budget(default_search_steps))(thy, t))
