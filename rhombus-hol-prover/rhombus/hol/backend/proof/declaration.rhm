#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Lowering checked declarations into kernel data: a `function` into a
// `FunSpec`, and any other declared expression into a term.
//
// The declarations arrive checked and closed (`frontend/checker/
// declaration.rhm`); this module decides nothing about names or types.

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel open
  rhombus/hol/frontend/checker/datatype open
  rhombus/hol/frontend/checker/checked open
  rhombus/hol/frontend/checker/declaration open
  rhombus/hol/backend/proof/definition/function/spec open
  rhombus/hol/backend/proof/elaborate open

export:
  elaborate_function_decl
  lower_expr

// The function's own name stands for the constant being defined, at its
// checked type, so recursive calls lower before the constant exists. A
// measure is a function of the parameters: it is lowered over the variables
// the parameter patterns bind and abstracted over the parameters.
fun elaborate_function_decl(
      thy :: Theory, decl :: CheckedFunctionDecl,
      ~datatypes: datatypes :: Map.of(Symbol, DatatypeSpec) = {})
     :: FunSpec:
  let self = mk_const(decl.name, decl.fn.ty)
  let binding_env = ElabEnv(thy, {}, #'function, decl.name, self, datatypes)
  let (pvars, result_ty, clauses) = checked_function_clauses(binding_env,
                                                             decl.fn)
  let arg_tys = decl.fn.params.map(fun (binder :: CheckedBinder): binder.ty)
  let measure:
    match decl.measure
    | #false: #false
    | expr:
        let env0:
          for values(out :~ Map = {}) (binder in decl.fn.params,
                                       variable in pvars):
            let binder :~ CheckedBinder = binder
            merge_pattern_bindings(
              #'function, out,
              bind_checked_irrefutable_pattern(
                binding_env, binder.pat, variable :~ Term),
              binder.at)
        let value = checked_to_term(
                      ElabEnv(thy, env0, #'function, #false, #false,
                              datatypes),
                      expr :~ CheckedExpr)
        list_mk_abs(pvars, value)
  FunSpec(decl.name, arg_tys, result_ty, clauses, measure)

// A declared expression with `vars` in scope.
fun lower_expr(thy :: Theory, expr :: CheckedExpr,
               ~who: who :: Symbol = #'theorem,
               ~vars: vars :: Map.of(Symbol, Term) = {},
               ~datatypes: datatypes :: Map.of(Symbol, DatatypeSpec) = {})
    :: Term:
  checked_to_term(ElabEnv(thy, vars, who, #false, #false, datatypes), expr)
