#lang rhombus/static
// SPDX-License-Identifier: 0BSD


// Fixed native terms for the kernel's checked Nat literals.
//
// These names describe the kernel-installed Nat type and constructors; they
// carry no user-defined arithmetic or proof-search policy.

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open

export:
  nat_type
  nat_zero
  nat_succ

def nat_type_name :: Symbol = #'Nat
def nat_type :: HType = mk_tyapp(nat_type_name, [])
def nat_zero :: Term = mk_const(#'zero, nat_type)
def nat_succ :: Term = mk_const(#'succ, mk_fun(nat_type, nat_type))
