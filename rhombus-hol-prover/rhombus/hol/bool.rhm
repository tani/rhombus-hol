//
// HOL Light bool.ml compatibility layer.
// The logical constants live in backend/proof/logic/bool.rhm and all proof
// producing operations are implemented by backend/proof/logic/derived.rhm.
// This module restores the conventional HOL Light surface API without adding
// any trusted inference rule.

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel/names open
  rhombus/hol/kernel open
  rhombus/hol/backend/proof/logic/bool open
  rhombus/hol/backend/proof/logic/conversion open
  rhombus/hol/backend/proof/logic/derived open

export:
  // logical syntax
  bool
  tm_true
  tm_false
  is_iff
  dest_iff
  mk_iff
  mk_conj
  list_mk_conj
  mk_imp
  mk_forall
  list_mk_forall
  mk_exists
  list_mk_exists
  mk_disj
  list_mk_disj
  mk_neg
  mk_uexists
  // definitions
  T_DEF
  AND_DEF
  IMP_DEF
  FORALL_DEF
  EXISTS_DEF
  OR_DEF
  F_DEF
  NOT_DEF
  EXISTS_UNIQUE_DEF
  // rules
  PINST
  PROVE_HYP
  TRUTH
  EQT_ELIM
  EQT_INTRO
  CONJ
  CONJUNCT1
  CONJUNCT2
  CONJ_PAIR
  CONJUNCTS
  LIST_CONJ
  MP
  DISCH
  DISCH_ALL
  UNDISCH
  UNDISCH_ALL
  IMP_ANTISYM_RULE
  ADD_ASSUM
  EQ_IMP_RULE
  IMP_TRANS
  SPEC
  SPECL
  SPEC_VAR
  SPEC_ALL
  ISPEC
  ISPECL
  GEN
  GENL
  GEN_ALL
  EXISTS
