#lang rhombus/static

// Algebraic datatypes: their specification, well-formedness checks, and the
// theorem bundle installed by a declaration.
//
// A `datatype` is derived -- a non-recursive one as a sum of products over `unit`
// (`datatype_gen.rhm`), a self-recursive one carved out of the labelled trees
// over `num` (`datatype_rec.rhm`) -- and `driver.rhm` checks at each
// declaration that no axiom was added. The test suite owns the separate
// axiom-schema oracle used to compare the derived theorem statements.
//
// `check_spec` is still load-bearing, but for a different reason than it was
// when the properties were postulated.  It no longer guards a consistency
// claim about assumed axioms; an ill-founded declaration now has no set of
// labelled trees to be carved out of, so it fails to be constructed.  What
// the check buys is that the failure is a legible message here rather than
// an inscrutable one three modules down.

import:
  rhombus/hol/htype open
  rhombus/hol/kernel open

export:
  Field
  Ctor
  DatatypeSpec
  DatatypeThms
  DatatypeView
  instantiate_datatype
  check_spec
  is_recursive_field
  occurs_in_type
  ctor_type
  ctor_index
  discriminator_name
  selector_name
  self_type
  recursive_field_indexes
  all_ctor_names

class Field(name :: Symbol, ty :: HType)
class Ctor(name :: Symbol, fields :: List.of(Field))
class DatatypeSpec(name :: Symbol,
                   params :: List.of(Symbol),
                   ctors :: List.of(Ctor))

class DatatypeThms(spec :: DatatypeSpec,
                   // `Ci x... = Ci y... <=> x = y and ...`, one per ctor with fields
                   injectivity :: Map.of(Symbol, Thm),
                   // `not (Ci x... === Cj y...)`, keyed by `[i, j]` with i < j
                   distinctness :: Map.of(List.of(NonnegInt), Thm),
                   // `forall P. <case> and ... ==> forall x. P(x)`
                   induction :: Thm,
                   // `forall x. (exists ... x === C1 ...) or ...`
                   cases :: Thm,
                   // `is_Ci(Cj y...) <=> true/false`
                   discriminators :: List.of(Thm),
                   // `Ci_f(Ci x...) === x`
                   selectors :: List.of(Thm),
                   // `is_Ci(x) ==> Ci(Ci_f1(x), ...) === x`, for destructor elimination, keyed by constructor name
                   elim_rules :: Map.of(Symbol, Thm))

// A datatype's facts at one *instance* of it.
//
// `DatatypeThms` states everything at the declaration's own type --
// `List.of(?a)` -- because that is where it is proved.  A definition recursing
// over `List.of(Nat)` needs the same facts at `List.of(Nat)`, and instantiating
// them is a type substitution, not a re-derivation: the theorems are
// polymorphic and `INST_TYPE` is exactly the rule for this.
//
// Keeping the specialised facts in a value of their own, rather than
// instantiating at each use, means a consumer cannot accidentally mix a
// theorem at `List.of(?a)` with a term at `List.of(Nat)` -- the mismatch would
// surface as a confusing `SPEC` failure deep inside a derivation.
class DatatypeView(spec :: DatatypeSpec,
                   self_ty :: HType,
                   injectivity :: Map.of(Symbol, Thm),
                   distinctness :: Map.of(List.of(NonnegInt), Thm),
                   induction :: Thm,
                   cases :: Thm,
                   discriminators :: List.of(Thm),
                   selectors :: List.of(Thm),
                   elim_rules :: Map.of(Symbol, Thm))

fun self_type(spec :: DatatypeSpec) :: HType:
  mk_tyapp(spec.name, spec.params.map(fun (p :: Symbol): mk_tyvar(p)))

// `#false` unless `ty` is an instance of `dt` -- the same type constructor,
// applied to as many arguments as the declaration has parameters.  The
// schematic type is the instance that substitutes each parameter for
// itself, so this subsumes the case where nothing needs instantiating.
fun instantiate_datatype(thy :: Theory, dt :: DatatypeThms,
                         ty :: HType) :: maybe(DatatypeView):
  match ty
  | TyApp(n, args) when n == dt.spec.name
                          && (args :~ List).length() == dt.spec.params.length():
      let theta = for values(m :~ Map = {}) (p in dt.spec.params,
                                             a in (args :~ List)):
                    m ++ {p: a :~ HType}
      fun at(th :: Thm) :: Thm: INST_TYPE(thy, theta, th)
      DatatypeView(dt.spec, ty,
                   for values(m :~ Map = {}) ((k, th) in dt.injectivity):
                     m ++ {k: at(th :~ Thm)},
                   for values(m :~ Map = {}) ((k, th) in dt.distinctness):
                     m ++ {k: at(th :~ Thm)},
                   at(dt.induction),
                   at(dt.cases),
                   dt.discriminators.map(fun (th :: Thm): at(th)),
                   dt.selectors.map(fun (th :: Thm): at(th)),
                   for values(m :~ Map = {}) ((k, th) in dt.elim_rules):
                     m ++ {k: at(th :~ Thm)})
  | ~else: #false

fun is_recursive_field(spec :: DatatypeSpec, f :: Field) :: Boolean:
  f.ty == self_type(spec)

fun ctor_type(spec :: DatatypeSpec, c :: Ctor) :: HType:
  for values(ty :~ HType = self_type(spec)) (f in c.fields.reverse()):
    mk_fun(f.ty, ty)

fun ctor_index(spec :: DatatypeSpec, name :: Symbol) :: Int:
  recur loop (remaining :~ List.of(Ctor) = spec.ctors, i = 0):
    match remaining
    | []:
        error(~who: #'datatype, "unknown constructor",
              error.val(~label: "constructor", name))
    | List.cons(c, rest):
        (if (c :~ Ctor).name == name | i | loop(rest, i + 1))

// Every constructor name across a set of declared datatypes, for the
// tactics that must not treat one as an ordinary function.
fun all_ctor_names(dts :: Map.of(Symbol, DatatypeThms)) :: Set.of(Symbol):
  for values(acc :~ Set = Set()) (d in dts.values()):
    for values(a :~ Set = acc) (c in (d :~ DatatypeThms).spec.ctors):
      a ++ {(c :~ Ctor).name}

fun discriminator_name(c :: Ctor) :: Symbol:
  Symbol.from_string("is_" ++ to_string(c.name))

fun selector_name(c :: Ctor, f :: Field) :: Symbol:
  Symbol.from_string(to_string(c.name) ++ "_" ++ to_string(f.name))

fun nonrecursive_ctors(spec :: DatatypeSpec) :: List.of(Ctor):
  spec.ctors.filter(~keep: fun (c :: Ctor):
                             for all (f in c.fields): !is_recursive_field(spec, f))

fun recursive_field_indexes(spec :: DatatypeSpec, c :: Ctor) :: List.of(Int):
  for values(acc :~ List = []) (f in c.fields, i in List.iota(c.fields.length())):
    (if is_recursive_field(spec, f) | acc ++ [i] | acc)

// -- the positivity checker: the load-bearing soundness component ----------

fun occurs_in_type(n :: Symbol, t :: HType) :: Boolean:
  match t
  | TyVar(_): #false
  | TyApp(m, args): m == n || (for any (a in args): occurs_in_type(n, a))

// An argument type is admissible when it is either the datatype applied to
// exactly its own parameters -- a direct recursive occurrence -- or a type in
// which the datatype does not occur at all.
//
// This rejects, deliberately and with a clear message:
//   * negative occurrences   `datatype Bad | mk(Bad -> Bad)`  -- inconsistent
//   * any function type mentioning the datatype                -- ditto
//   * nested occurrences     `datatype Rose | node(List.of(Rose))` -- sound, but
//     the induction scheme this file emits would be wrong for it
//   * infinitary branching   `datatype Inf | lim(num -> Inf)`  -- outside the
//     finitary directly-recursive fragment the construction covers: a value
//     would have infinitely many children, and the labelled trees it would
//     be carved out of have finitely many
fun check_field_type(spec :: DatatypeSpec, thy :: Theory, c :: Ctor,
                     f :: Field) :: Void:
  let self = self_type(spec)
  cond
  | f.ty == self: #void
  | occurs_in_type(spec.name, f.ty):
      error(~who: #'datatype,
            "constructor field mentions the type being defined in a position "
              ++ "this version cannot admit",
            error.val(~label: "type", spec.name),
            error.val(~label: "constructor", c.name),
            error.val(~label: "field", f.name),
            error.val(~label: "field type", type_to_string(f.ty)),
            error.val(~label: "admissible", "either exactly "
                        ++ type_to_string(self)
                        ++ ", or a type not mentioning "
                        ++ to_string(spec.name)))
  | ~else:
      // Not recursive: it just has to be a real type over the parameters.
      check_type(thy, f.ty)
      for (v in type_vars(f.ty)):
        unless spec.params.contains(v)
        | error(~who: #'datatype, "constructor field mentions an unbound type variable",
                error.val(~label: "type", spec.name),
                error.val(~label: "constructor", c.name),
                error.val(~label: "field", f.name),
                error.val(~label: "variable", v))

fun check_spec(thy :: Theory, spec :: DatatypeSpec) :: Void:
  when type_arity(thy, spec.name) != #false
  | error(~who: #'datatype, "type constructor is already declared",
          error.val(~label: "name", spec.name))
  when spec.ctors.length() == 0
  | error(~who: #'datatype, "a datatype needs at least one constructor",
          error.val(~label: "name", spec.name))
  // Duplicate parameter names would make the arity meaningless.
  recur dup (ps :~ List = spec.params, seen :~ List = []):
    match ps
    | []: #void
    | List.cons(p, rest):
        when seen.contains(p)
        | error(~who: #'datatype, "duplicate type parameter",
                error.val(~label: "name", spec.name),
                error.val(~label: "parameter", p))
        dup(rest, List.cons(p, seen))
  recur dupc (cs :~ List = spec.ctors, seen :~ List = []):
    match cs
    | []: #void
    | List.cons(c, rest):
        let c :~ Ctor = c
        when seen.contains(c.name)
        | error(~who: #'datatype, "duplicate constructor",
                error.val(~label: "constructor", c.name))
        when const_type(thy, c.name) != #false
        | error(~who: #'datatype, "constructor name is already a constant",
                error.val(~label: "constructor", c.name))
        recur dupf (fs :~ List = c.fields, fseen :~ List = []):
          match fs
          | []: #void
          | List.cons(f, frest):
              let f :~ Field = f
              when fseen.contains(f.name)
              | error(~who: #'datatype, "duplicate field",
                      error.val(~label: "constructor", c.name),
                      error.val(~label: "field", f.name))
              dupf(frest, List.cons(f.name, fseen))
        dupc(rest, List.cons(c.name, seen))
  // The field types are checked against the theory *extended* with the type
  // being defined, so that a recursive occurrence resolves.
  let thy_with = new_type(thy, spec.name, spec.params.length())
  for (c in spec.ctors):
    let c :~ Ctor = c
    for (f in c.fields): check_field_type(spec, thy_with, c, f)
  // HOL types are inhabited by assumption, so a datatype with no base case
  // would be an inconsistency, not merely an empty type.
  when nonrecursive_ctors(spec).length() == 0
  | error(~who: #'datatype,
          "every constructor is recursive, so the type would be empty",
          error.val(~label: "name", spec.name),
          error.val(~label: "hint", "add a constructor with no field of type "
                      ++ type_to_string(self_type(spec))))
