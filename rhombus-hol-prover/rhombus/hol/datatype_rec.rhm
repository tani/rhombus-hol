#lang rhombus/static
// SPDX-License-Identifier: 0BSD AND BSD-2-Clause
// Conservatively covered as a HOL Light-style datatype construction.


// Carving a self-recursive datatype out of the labelled trees over `num`
// using the recursive-datatype representation.
//
// `treerep.rhm` supplies the representation and the facts about it; this
// module is what turns an arbitrary `DatatypeSpec` into the pieces those
// facts are stated about -- the label type, the tag injections, the junk
// subtree, the `REP` predicate, and the type itself.
//
// A constructor's *label* carries only its non-recursive fields, tagged by
// which constructor it is; its recursive fields become the node's children.
// So the label type is exactly the sum-of-products `datatype_gen.rhm` already
// builds for non-recursive datatypes, taken over the non-recursive fields --
// which is why that machinery is shared rather than repeated.
//
// The tags are introduced as *constants*, not as lambdas.  A lambda label
// would make every `label a` a redex, and the pieces that get beta-reduced
// along the way would stop matching the ones that do not; that is the trap
// `WFREC` documents and the one `EXISTS` was silently falling into.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  "bool.rhm" open
  "conv.rhm" open
  "drule.rhm" open
  "algebra.rhm" open
  "datatype.rhm" open
  "datatype_gen.rhm" open
  "datatype_common.rhm" open
  "infinity.rhm" open
  "treerep.rhm" open

export:
  is_selfrecursive_spec
  RecCarving
  carve_recursive_datatype
  RecTreeThms
  derive_tree_theorems
  RecCtors
  define_recursive_ctors
  restate_injectivity
  restate_distinctness
  restate_induction
  restate_cases
  build_recursive_datatype_thms

def unitty :: HType = mk_tyapp(ty_unit, [])

// Directly self-recursive, which is the class `check_spec` already admits:
// at least one field somewhere is the type itself, and no field is anything
// *containing* the type (nesting is refused before this point).
fun is_selfrecursive_spec(spec :: DatatypeSpec) :: Boolean:
  for any (c in spec.ctors):
    for any (f in (c :~ Ctor).fields): is_recursive_field(spec, f :~ Field)

fun nonrec_fields(spec :: DatatypeSpec, c :: Ctor) :: List.of(Field):
  c.fields.filter(~keep: fun (f :: Field): !is_recursive_field(spec, f))

fun rec_count(spec :: DatatypeSpec, c :: Ctor) :: Int:
  c.fields.filter(~keep: fun (f :: Field): is_recursive_field(spec, f)).length()

// Everything the carving produced, in one place.  `ctors` is what
// `treerep.rhm`'s theorems are stated against, and `label_defs` are the
// defining equations of the tag constants, which the layer above needs in
// order to restate those theorems about the datatype's own constructors.
class RecCarving(carved :: Carved,
                 ctors :: List.of(CtorRep),
                 label_types :: List.of(HType),
                 label_defs :: List.of(Thm),
                 junk :: Term,
                 node_inl :: Term,
                 rep_def :: Thm)

// `<Type>_lab<i>`, `<Type>_bot`, `<Type>_REP`: names derived from the type's
// own, so two datatypes in one module cannot collide.
fun suffixed(spec :: DatatypeSpec, s :: String) :: Symbol:
  Symbol.from_string(to_string(spec.name) ++ s)

fun carve_recursive_datatype(thy0 :: Theory, spec :: DatatypeSpec,
                             alg :: AlgebraThms) :: values(Theory, RecCarving):
  unless is_selfrecursive_spec(spec)
  | error(~who: #'carve_recursive_datatype,
          "specification has no recursive field",
          error.val(~label: "name", spec.name))

  let ptys = for List (c in spec.ctors):
               payload_type_of_fields(nonrec_fields(spec, c :~ Ctor))
  let lab_ty = repr_type_from(ptys)
  let opt_ty = sum_ty(lab_ty, unitty)
  let tree_ty = rep_ty(opt_ty)
  let node_inl = mk_const(c_inl, mk_fun(lab_ty, opt_ty))

  // -- the tag constants ----------------------------------------------------
  let (thy1, label_terms, label_defs):
    for values(t :~ Theory = thy0, ls :~ List = [], ds :~ List = []) (i in List.iota(spec.ctors.length())):
      let pty = ptys[i]
      let a = mk_var(#'a, pty)
      let name = suffixed(spec, "_lab" ++ to_string(i))
      let (t2, d):
        new_basic_definition(t, mk_eq(mk_var(name, mk_fun(pty, lab_ty)),
                                      mk_abs(a, inject_from(ptys, i, a :~ Term))))
      values(t2, ls ++ [mk_const(name, mk_fun(pty, lab_ty))], ds ++ [d])

  // -- the junk subtree ------------------------------------------------------
  //
  // Any term of the representation type will do: it fills child slots past a
  // constructor's arity, and nothing ever reads them.  The empty tree is the
  // readable choice.
  let (thy2, _junk_def):
    new_basic_definition(thy1,
                         mk_eq(mk_var(suffixed(spec, "_bot"), tree_ty),
                               mk_abs(mk_var(#'p, path_ty()),
                                      mk_comb(mk_const(c_inr,
                                                       mk_fun(unitty, opt_ty)),
                                              mk_const(c_one, unitty)))))
  let junk = mk_const(suffixed(spec, "_bot"), tree_ty)

  let ctors = for List (c in spec.ctors, lab in label_terms):
                CtorRep(lab :~ Term, rec_count(spec, c :~ Ctor))

  // -- the least set closed under the constructors --------------------------
  let rep_name = suffixed(spec, "_REP")
  let (thy3, rep_def):
    new_basic_definition(thy2,
                         mk_eq(mk_var(rep_name, mk_fun(tree_ty, bool)),
                               mk_rep_pred(node_inl :~ Term, junk, ctors)))
  let rep_const = mk_const(rep_name, mk_fun(tree_ty, bool))
  fun rep_at(t :: Term) :: Thm: unfold_def(thy3, rep_def, [t])

  // -- and the type ----------------------------------------------------------
  //
  // The witness is any constructor with no recursive fields, at an arbitrary
  // payload.  `@x. true` is a well-formed term at every type, and no
  // inhabitation theorem is needed: the closure theorem is already universally
  // quantified over the payload, so specialising it is enough.
  let base_i:
    recur loop (i = 0):
      cond
      | i >= spec.ctors.length():
          error(~who: #'carve_recursive_datatype,
                "every constructor recurses, so the type would be empty",
                error.val(~label: "name", spec.name))
      | rec_count(spec, (spec.ctors[i] :~ Ctor)) == 0: i
      | ~else: loop(i + 1)
  let arb = mk_select(mk_var(#'w, ptys[base_i]), tm_true)
  let witness = SPEC(thy3, arb,
                     prove_rep_closed(thy3, node_inl :~ Term, junk, ctors,
                                      rep_const, rep_at, base_i))
  let (thy4, abs_rep, rep_pred):
    new_basic_type_definition(thy3, spec.name,
                              abstraction_name(spec.name),
                              representation_name(spec.name), witness)
  let self = mk_tyapp(spec.name, spec.params.map(fun (p :: Symbol): mk_tyvar(p)))
  let carved:
    Carved(self,
           mk_const(abstraction_name(spec.name), mk_fun(tree_ty, self)),
           mk_const(representation_name(spec.name), mk_fun(self, tree_ty)),
           rep_const, abs_rep, rep_pred)
  values(thy4,
         RecCarving(carved, ctors, ptys, label_defs, junk, node_inl :~ Term,
                    rep_def))

fun abstraction_name(n :: Symbol) :: Symbol:
  Symbol.from_string("abs_" ++ to_string(n))
fun representation_name(n :: Symbol) :: Symbol:
  Symbol.from_string("rep_" ++ to_string(n))

// -- the tag constants' own facts --------------------------------------------
//
// `treerep.rhm` asks for the label's injectivity and the labels' pairwise
// distinctness; the tags are `inject_from` behind a name, so both come from
// unfolding the name and handing the result to the sum machinery.

// `|- !x y. lab_i x = lab_i y <=> x = y`
fun prove_label_injective(thy :: Theory, alg :: AlgebraThms,
                          rc :: RecCarving, i :: Int) :: Thm:
  let pty = rc.label_types[i]
  let lab = (rc.ctors[i] :~ CtorRep).label
  let x = mk_var(#'x, pty)
  let y = mk_var(#'y, pty)
  fun unf(t :: Term) :: Thm:
    unfold_def(thy, (rc.label_defs[i] :~ Thm), [t])
  let lhs = mk_eq(mk_comb(lab, x :~ Term), mk_comb(lab, y :~ Term))
  let fwd:
    let inject_eq = TRANS(SYM(thy, unf(x :~ Term)),
                          TRANS(ASSUME(thy, lhs), unf(y :~ Term)))
    DISCH(thy, lhs,
          payload_eq_from_inject_eq(thy, alg.sum, rc.label_types, i,
                                    x :~ Term, y :~ Term, inject_eq))
  let bwd:
    let rhs = mk_eq(x :~ Term, y :~ Term)
    let inj = inject_congr(thy, rc.label_types, i, ASSUME(thy, rhs))
    DISCH(thy, rhs,
          TRANS(unf(x :~ Term), TRANS(inj, SYM(thy, unf(y :~ Term)))))
  GENL(thy, [x, y], IMP_ANTISYM_RULE(thy, fwd, bwd))

// `|- !x y. not (lab_i x = lab_j y)`, for `i /= j`
fun prove_label_distinct(thy :: Theory, alg :: AlgebraThms,
                         rc :: RecCarving, i :: Int, j :: Int) :: Thm:
  let x = mk_var(#'x, rc.label_types[i])
  let y = mk_var(#'y, rc.label_types[j])
  let li = (rc.ctors[i] :~ CtorRep).label
  let lj = (rc.ctors[j] :~ CtorRep).label
  let stmt = mk_eq(mk_comb(li, x :~ Term), mk_comb(lj, y :~ Term))
  let inject_eq:
    TRANS(SYM(thy, unfold_def(thy, (rc.label_defs[i] :~ Thm), [x :~ Term])),
          TRANS(ASSUME(thy, stmt),
                unfold_def(thy, (rc.label_defs[j] :~ Thm), [y :~ Term])))
  let contra = MP(thy,
                  NOT_ELIM(thy, distinct_repr(thy, alg.sum, rc.label_types,
                                              i, j, x :~ Term, y :~ Term)),
                  inject_eq)
  GENL(thy, [x, y], NOT_INTRO(thy, DISCH(thy, stmt, contra)))

// -- the four theorems, about the representation ------------------------------
//
// Still stated with the constructors spelled out as `abs(node(...))`: naming
// them is the next layer's job.  What matters here is that all four are
// derived, for any spec, from the pieces `carve_recursive_datatype` produced.
class RecTreeThms(injectivity :: List.of(Thm),
                  distinctness :: List.of(Thm),
                  induction :: Thm,
                  cases :: Thm)

fun derive_tree_theorems(thy :: Theory, rc :: RecCarving, alg :: AlgebraThms,
                         ind :: IndThms) :: RecTreeThms:
  let cv :~ Carved = rc.carved
  fun rep_at(t :: Term) :: Thm:
    unfold_def(thy, rc.rep_def, [t])
  let closed = for List (i in List.iota(rc.ctors.length())):
                 prove_rep_closed(thy, rc.node_inl, rc.junk, rc.ctors,
                                  cv.rep_const, rep_at, i)
  let node_inj:
    let (lab_ty, opt_ty) = dest_fun(type_of(rc.node_inl))
    let (_, unit_side) = (match opt_ty
                          | TyApp(_, [l, r]): values(l, r)
                          | ~else: error(~who: #'derive_tree_theorems,
                                         "option type is not a sum"))
    prove_node_injective(thy, ind, rc.node_inl,
                         INST_TYPE(thy, {#'a: lab_ty, #'b: unit_side},
                                   alg.sum.inl_inj))
  let injectivity:
    for List (i in List.iota(rc.ctors.length())):
      prove_ctor_injective(thy, rc.node_inl, rc.junk, rc.ctors, cv,
                           (closed[i] :~ Thm), node_inj,
                           prove_label_injective(thy, alg, rc, i),
                           fun (ts :: List, us :: List, k :: Int):
                             prove_kids_injective(thy, ind, rc.junk, ts, us, k),
                           i)
  // one per ordered pair `i < j`, the order `DatatypeThms` states them in
  let distinctness:
    for values(acc :~ List = []) (i in List.iota(rc.ctors.length())):
      acc ++ (for values(a2 :~ List = []) (j in List.iota(rc.ctors.length())):
                cond
                | j <= i: a2
                | ~else:
                    a2 ++ [prove_ctor_distinct(thy, rc.node_inl, rc.junk,
                                               rc.ctors, cv,
                                               (closed[i] :~ Thm),
                                               (closed[j] :~ Thm), node_inj,
                                               prove_label_distinct(thy, alg,
                                                                    rc, i, j),
                                               i, j)])
  let induction:
    prove_datatype_induction(thy, rc.node_inl, rc.junk, rc.ctors, cv,
                             closed, node_inj, rep_at)
  RecTreeThms(injectivity, distinctness, induction,
              prove_datatype_cases(thy, rc.node_inl, rc.junk, rc.ctors, cv,
                                   induction))

// -- naming the constructors --------------------------------------------------
//
// So far the theorems talk about `abs(node(label_i a, kids [rep x, ...]))`.
// A user talks about `Cons(h, t)`.  The two differ in more than a name: the
// representation binds one *packed* payload where the declaration binds the
// non-recursive fields one at a time, so converting between them is the
// pack/unpack bijection, not a rewrite.
class RecCtors(terms :: List.of(Term), defs :: List.of(Thm))

fun ctor_field_vars(spec :: DatatypeSpec, c :: Ctor,
                    prefix :: String) :: List.of(FVar):
  mk_field_vars(c.fields, prefix)

fun split_fields(spec :: DatatypeSpec, c :: Ctor,
                 vs :: List.of(FVar)) :: values(List.of(Term), List.of(Term)):
  let pairs = for List (f in c.fields, v in vs): [f, v]
  values(for values(acc :~ List = []) ([f, v] in pairs):
           (if is_recursive_field(spec, f :~ Field) | acc | acc ++ [(v :~ FVar) :~ Term]),
         for values(acc :~ List = []) ([f, v] in pairs):
           (if is_recursive_field(spec, f :~ Field) | acc ++ [(v :~ FVar) :~ Term] | acc))

fun define_recursive_ctors(thy0 :: Theory, spec :: DatatypeSpec,
                           rc :: RecCarving) :: values(Theory, RecCtors):
  let cv :~ Carved = rc.carved
  let (thy, terms, defs):
    for values(t :~ Theory = thy0, ts :~ List = [], ds :~ List = []) (c in spec.ctors, i in List.iota(spec.ctors.length())):
      let c :~ Ctor = c
      let vs = ctor_field_vars(spec, c, "f")
      let (nonrec, rec) = split_fields(spec, c, vs)
      let body:
        mk_comb(cv.abs,
                mk_ctor_term(rc.node_inl, rc.junk, (rc.ctors[i] :~ CtorRep),
                             pack_fields(nonrec),
                             rec.map(fun (x :: Term): mk_comb(cv.rep, x))))
      let cty = ctor_type(spec, c)
      let (t2, d):
        new_basic_definition(t, mk_eq(mk_var(c.name, cty),
                                      list_mk_abs(vs, body)))
      values(t2, ts ++ [mk_const(c.name, cty)], ds ++ [d])
  values(thy, RecCtors(terms, defs))

// `|- !xs ys. C_i(xs) = C_i(ys) <=> x0 = y0 and ...`, in the left-nested
// shape `datatype_axioms` states it.
fun restate_injectivity(thy :: Theory, spec :: DatatypeSpec, alg :: AlgebraThms,
                        rc :: RecCarving, cs :: RecCtors,
                        tree_inj :: Thm, i :: Int) :: Thm:
  let c :~ Ctor = spec.ctors[i]
  let ci = cs.terms[i]
  let xs = ctor_field_vars(spec, c, "x")
  let ys = ctor_field_vars(spec, c, "y")
  let (xn, xr) = split_fields(spec, c, xs)
  let (yn, yr) = split_fields(spec, c, ys)
  let nf = nonrec_fields(spec, c)
  fun unf(vs :: List.of(FVar)) :: Thm:
    unfold_def(thy, (cs.defs[i] :~ Thm), vs.map(fun (v :: FVar): v :~ Term))
  let lhs = mk_eq(list_mk_comb(ci, xs.map(fun (v :: FVar): v :~ Term)),
                  list_mk_comb(ci, ys.map(fun (v :: FVar): v :~ Term)))
  let rhs = left_fold_term(for List (x in xs, y in ys):
                             mk_eq((x :~ FVar) :~ Term, (y :~ FVar) :~ Term))
  let fwd:
    let node_eq = TRANS(SYM(thy, unf(xs)), TRANS(ASSUME(thy, lhs), unf(ys)))
    let parts = MP(thy,
                   SPECL(thy, [pack_fields(xn)] ++ xr
                                ++ [pack_fields(yn)] ++ yr, tree_inj),
                   node_eq)
    // `payload_eq and child0 and child1 and ...`, nested to the right
    let split :~ List:
      recur loop (k = 0, acc :~ Thm = parts, out :~ List = []):
        cond
        | k == xr.length(): out ++ [acc]
        | ~else: loop(k + 1, CONJUNCT2(thy, acc), out ++ [CONJUNCT1(thy, acc)])
    let payload_eq :~ Thm = split[0]
    let child_eqs = for List (k in List.iota(xr.length())): (split[k + 1] :~ Thm)
    let nonrec_eqs :~ List:
      cond
      | nf.length() == 0: []
      | ~else: collect_field_eqs(thy, alg.prod, nf, xn, yn, payload_eq)
    // put them back in declaration order
    let ordered :~ List:
      recur loop (k = 0, ni = 0, ri = 0, out :~ List = []):
        cond
        | k == c.fields.length(): out
        | is_recursive_field(spec, (c.fields[k] :~ Field)):
            loop(k + 1, ni, ri + 1, out ++ [(child_eqs[ri] :~ Thm)])
        | ~else: loop(k + 1, ni + 1, ri, out ++ [(nonrec_eqs[ni] :~ Thm)])
    DISCH(thy, lhs, left_fold_conj(thy, ordered))
  let bwd:
    let asm = ASSUME(thy, rhs)
    let eqs = split_left_conj_local(thy, asm, xs.length())
    // the converse is plain congruence on the constructor -- no unfolding
    DISCH(thy, rhs, congruence_chain(thy, ci, eqs))
  GENL(thy, xs ++ ys, IMP_ANTISYM_RULE(thy, fwd, bwd))

fun left_fold_term(ts :: List.of(Term)) :: Term:
  match ts
  | List.cons(t0, rest): for values(acc :~ Term = t0) (t in rest): mk_conj(acc, t)

fun split_left_conj_local(thy :: Theory, th :: Thm, k :: Int) :: List.of(Thm):
  cond
  | k == 1: [th]
  | ~else: split_left_conj_local(thy, CONJUNCT1(thy, th), k - 1)
             ++ [CONJUNCT2(thy, th)]

// `|- !xs ys. not (C_i(xs) = C_j(ys))`
fun restate_distinctness(thy :: Theory, spec :: DatatypeSpec, rc :: RecCarving,
                         cs :: RecCtors, tree_dist :: Thm,
                         i :: Int, j :: Int) :: Thm:
  let ci :~ Ctor = spec.ctors[i]
  let cj :~ Ctor = spec.ctors[j]
  let xs = ctor_field_vars(spec, ci, "x")
  let ys = ctor_field_vars(spec, cj, "y")
  let (xn, xr) = split_fields(spec, ci, xs)
  let (yn, yr) = split_fields(spec, cj, ys)
  let stmt = mk_eq(list_mk_comb(cs.terms[i], xs.map(fun (v :: FVar): v :~ Term)),
                   list_mk_comb(cs.terms[j], ys.map(fun (v :: FVar): v :~ Term)))
  let node_eq:
    TRANS(SYM(thy, unfold_def(thy, (cs.defs[i] :~ Thm),
                              xs.map(fun (v :: FVar): v :~ Term))),
          TRANS(ASSUME(thy, stmt),
                unfold_def(thy, (cs.defs[j] :~ Thm),
                           ys.map(fun (v :: FVar): v :~ Term))))
  let contra:
    MP(thy,
       NOT_ELIM(thy, SPECL(thy, [pack_fields(xn)] ++ xr
                                  ++ [pack_fields(yn)] ++ yr, tree_dist)),
       node_eq)
  GENL(thy, xs ++ ys, NOT_INTRO(thy, DISCH(thy, stmt, contra)))

// `|- !P. (for each constructor: !f1..fk. P(recursive fields) ==> P(C_i(fs)))
//         ==> !x. P x`
//
// The representation's induction quantifies its case over one packed payload;
// the declaration's quantifies over the non-recursive fields separately.  So
// this is not a rewrite: given a payload, the fields have to be *recovered*
// from it, which is surjective pairing (`unpack_payload_exists`), and at zero
// non-recursive fields it is `unit`'s single-value theorem instead.
fun restate_induction(thy :: Theory, spec :: DatatypeSpec, alg :: AlgebraThms,
                      rc :: RecCarving, cs :: RecCtors,
                      tree_induction :: Thm) :: Thm:
  let cv :~ Carved = rc.carved
  let bigP = mk_var(#'P, mk_fun(cv.ty, bool))
  let x = mk_var(#'x, cv.ty)

  // the declaration-level case for constructor `i`
  fun case_term(i :: Int) :: Term:
    let c :~ Ctor = spec.ctors[i]
    let vs = ctor_field_vars(spec, c, "v")
    let (_, rec) = split_fields(spec, c, vs)
    let concl = mk_comb(bigP, list_mk_comb(cs.terms[i],
                                           vs.map(fun (v :: FVar): v :~ Term)))
    // curried, one implication per recursive field -- the shape
    // `datatype_axioms` states, so the two are interchangeable
    let body:
      for values(acc :~ Term = concl) (t in rec.reverse()):
        mk_imp(mk_comb(bigP, t :~ Term), acc)
    mk_forall_list(vs, body)

  let cases = for List (i in List.iota(spec.ctors.length())): case_term(i)
  let hyp_term:
    recur loop (k = cases.length() - 1, acc :~ Term = cases[cases.length() - 1]):
      cond
      | k <= 0: acc
      | ~else: loop(k - 1, mk_conj(cases[k - 1], acc))
  let hyp = ASSUME(thy, hyp_term)
  fun case_of(i :: Int) :: Thm:
    recur loop (k = 0, acc :~ Thm = hyp):
      cond
      | k == spec.ctors.length() - 1: acc
      | k == i: CONJUNCT1(thy, acc)
      | ~else: loop(k + 1, CONJUNCT2(thy, acc))

  // the representation-level case for constructor `i`, from it
  fun tree_case(i :: Int) :: Thm:
    let c :~ Ctor = spec.ctors[i]
    let nf = nonrec_fields(spec, c)
    let a = mk_var(#'pa, rc.label_types[i])
    let xs = for List (k in List.iota(rec_count(spec, c))):
               mk_var(Symbol.from_string("tx" ++ to_string(k)), cv.ty)
    let txs = xs.map(fun (v :: FVar): v :~ Term)
    // the representation's case still conjoins its hypotheses; the
    // declaration's curries them.  Assume each separately, use them one at a
    // time, and rebuild the conjunction only where the tree case wants it.
    let child_asms = for List (t in txs): ASSUME(thy, mk_comb(bigP, t :~ Term))
    let prem_term:
      cond
      | txs.length() == 0: tm_true
      | ~else:
          recur loop (k = txs.length() - 1,
                      acc :~ Term = mk_comb(bigP, txs[txs.length() - 1])):
            cond
            | k <= 0: acc
            | ~else: loop(k - 1, mk_conj(mk_comb(bigP, txs[k - 1]), acc))

    // `|- P (abs(node(label_i a, kids [rep x, ...])))`, given the payload's
    // fields `fs` and `|- a = pack(fs)`
    fun at_fields(fs :: List.of(Term), a_eq :: Thm) :: Thm:
      let all_vs:
        recur loop (k = 0, ni = 0, ri = 0, out :~ List = []):
          cond
          | k == c.fields.length(): out
          | is_recursive_field(spec, (c.fields[k] :~ Field)):
              loop(k + 1, ni, ri + 1, out ++ [txs[ri]])
          | ~else: loop(k + 1, ni + 1, ri, out ++ [(fs[ni] :~ Term)])
      let inst = SPECL(thy, all_vs, case_of(i))
      let got:
        for values(acc :~ Thm = inst) (a2 in child_asms):
          MP(thy, acc, (a2 :~ Thm))
      // unfold `C_i` and move the payload back to `a`
      let unf = unfold_def(thy, (cs.defs[i] :~ Thm), all_vs)
      let to_a:
        cong_pack(thy, rc, cv, i, fs, a :~ Term, a_eq, txs)
      EQ_MP(AP_TERM(thy, bigP, TRANS(unf, to_a)), got)

    let body:
      cond
      | nf.length() == 0:
          // payload is `unit`, so `a` is `one` and there is nothing to unpack
          at_fields([], SPEC(thy, a, alg.unit_unique))
      | ~else:
          let ex = unpack_payload_exists(thy, alg.prod, nf, a :~ Term)
          choose_through_and_rewrap(thy, ex, nf.length(),
                                    fun (vars, flat_th):
                                      at_fields(for List (v in (vars :~ List)):
                                                  (v :~ FVar) :~ Term,
                                                flat_th))
    // the tree case wants one conjunctive premise, so put the individual
    // assumptions back together before discharging
    let discharged:
      cond
      | txs.length() == 0: body
      | ~else:
          let conj_asm = ASSUME(thy, prem_term)
          let pieces = for List (k in List.iota(txs.length())):
                         recur loop (n = 0, acc :~ Thm = conj_asm):
                           cond
                           | n == txs.length() - 1: acc
                           | n == k: CONJUNCT1(thy, acc)
                           | ~else: loop(n + 1, CONJUNCT2(thy, acc))
          let reproved:
            for values(acc :~ Thm = body) (k in List.iota(txs.length())):
              PROVE_HYP(thy, (pieces[k] :~ Thm), acc)
          DISCH(thy, prem_term, reproved)
    GENL(thy, [a] ++ xs, discharged)

  let parts = for List (i in List.iota(spec.ctors.length())): tree_case(i)
  let prem:
    recur loop (k = parts.length() - 1, acc :~ Thm = (parts[parts.length() - 1] :~ Thm)):
      cond
      | k <= 0: acc
      | ~else: loop(k - 1, CONJ(thy, (parts[k - 1] :~ Thm), acc))
  let all_p = MP(thy, SPEC(thy, bigP, tree_induction), prem)
  GEN(thy, bigP, DISCH(thy, hyp_term, all_p))

// `|- abs(node(label_i (pack fs), kids [rep x...]))
//     = abs(node(label_i a,       kids [rep x...]))`, from `|- a = pack fs`.
fun cong_pack(thy :: Theory, rc :: RecCarving, cv :: Carved, i :: Int,
              fs :: List.of(Term), a :: Term, a_eq :: Thm,
              txs :: List.of(Term)) :: Thm:
  let lab = (rc.ctors[i] :~ CtorRep).label
  let kids = mk_kids(rc.junk, txs.map(fun (t :: Term): mk_comb(cv.rep, t)))
  let lab_eq = AP_TERM(thy, lab, SYM(thy, a_eq))
  // `node` is built by `mk_node`, a lambda over the path, so congruence has
  // to go under that binder
  AP_TERM(thy, cv.abs,
          node_cong(thy, rc.node_inl, mk_comb(lab, pack_fields(fs)),
                    mk_comb(lab, a), kids, lab_eq))

// `|- node(l1, k) = node(l2, k)` from `|- l1 = l2`
fun node_cong(thy :: Theory, inl :: Term, l1 :: Term, l2 :: Term,
              kids :: Term, lab_eq :: Thm) :: Thm:
  let nty = num_ty()
  let zero = mk_const(c_zero, nty)
  let suc = mk_const(c_suc, mk_fun(nty, nty))
  let pre = mk_const(c_pre, mk_fun(nty, nty))
  let p = mk_var(#'p, path_ty())
  let i = mk_var(#'i, nty)
  let (_, oty) = dest_fun(type_of(inl))
  let cc = mk_const(c_cond, mk_fun(bool, mk_fun(oty, mk_fun(oty, oty))))
  let test = REFL(thy, mk_eq(mk_comb(p, zero), zero))
  let branch = REFL(thy, mk_comb(mk_comb(kids, mk_comb(pre, mk_comb(p, zero))),
                                 mk_abs(i, mk_comb(p, mk_comb(suc, i)))))
  ABS(thy, p, MK_COMB(MK_COMB(AP_TERM(thy, cc, test),
                              AP_TERM(thy, inl, lab_eq)),
                      branch))

// `|- !x. (?f1..fk. x = C_0(fs)) or ... or (?f1..fj. x = C_m(fs))`
//
// From the *restated* induction, so it never mentions the representation: the
// predicate is the disjunction, and each constructor fills its own disjunct
// with the fields in hand.  The case hypotheses go unused, which is the
// content of the theorem -- exhaustiveness does not depend on anything
// holding of the children.
fun restate_cases(thy :: Theory, spec :: DatatypeSpec, cs :: RecCtors,
                  induction :: Thm) :: Thm:
  let self:
    mk_tyapp(spec.name, spec.params.map(fun (p :: Symbol): mk_tyvar(p)))
  let m = spec.ctors.length()
  let x = mk_var(#'x, self)

  fun disjunct(scrut :: Term, i :: Int) :: Term:
    let c :~ Ctor = spec.ctors[i]
    let vs = mk_field_vars(c.fields, "d" ++ to_string(i) ++ "_")
    let built = list_mk_comb(cs.terms[i], vs.map(fun (v :: FVar): v :~ Term))
    for values(t :~ Term = mk_eq(scrut, built)) (v in vs.reverse()):
      mk_exists(v :~ FVar, t)
  fun rest(scrut :: Term, k :: Int) :: Term:
    recur loop (n = m - 2, acc :~ Term = disjunct(scrut, m - 1)):
      cond
      | n < k: acc
      | ~else: loop(n - 1, mk_disj(disjunct(scrut, n), acc))

  let bigP = mk_abs(x, rest(x :~ Term, 0))
  fun p_at(t :: Term) :: Thm:
    match BETA_CONV(thy, mk_comb(bigP, t))
    | th :: Thm: th
    | ~else: error(~who: #'restate_cases, "beta failed")

  fun premise_for(i :: Int) :: Thm:
    let c :~ Ctor = spec.ctors[i]
    let vs = mk_field_vars(c.fields, "f")
    let args = vs.map(fun (v :: FVar): v :~ Term)
    let built = list_mk_comb(cs.terms[i], args)
    let witnessed:
      recur loop (k = args.length() - 1, acc :~ Thm = REFL(thy, built)):
        cond
        | k < 0: acc
        | ~else:
            let target:
              recur peel (n = 0, t :~ Term = disjunct(built, i)):
                cond
                | n == k: t
                | ~else:
                    match dest_exists(t)
                    | [v, body]: peel(n + 1, inst_fvar([[args[n], v :~ FVar]], body))
                    | ~else: error(~who: #'restate_cases, "shape")
            loop(k - 1, EXISTS(thy, target, args[k], acc))
    let innermost:
      cond
      | i == m - 1: witnessed
      | ~else: DISJ1(thy, witnessed, rest(built, i + 1))
    let chosen:
      recur loop (k = i - 1, acc :~ Thm = innermost):
        cond
        | k < 0: acc
        | ~else: loop(k - 1, DISJ2(thy, disjunct(built, k), acc))
    let at_built = EQ_MP(SYM(thy, p_at(built)), chosen)
    let recs = for values(acc :~ List = []) (f in c.fields, v in vs):
                 (if is_recursive_field(spec, f :~ Field)
                  | acc ++ [(v :~ FVar) :~ Term]
                  | acc)
    let body:
      cond
      | recs.length() == 0: at_built
      | ~else:
          for values(acc :~ Thm = at_built) (t in recs.reverse()):
            DISCH(thy, mk_comb(bigP, t :~ Term), acc)
    GENL(thy, vs, body)

  let parts = for List (i in List.iota(m)): premise_for(i)
  let prem:
    recur loop (k = parts.length() - 1, acc :~ Thm = (parts[parts.length() - 1] :~ Thm)):
      cond
      | k <= 0: acc
      | ~else: loop(k - 1, CONJ(thy, (parts[k - 1] :~ Thm), acc))
  let all_p = MP(thy, SPEC(thy, bigP, induction), prem)
  let at_x = SPEC(thy, x, all_p)
  GEN(thy, x,
      match BETA_CONV(thy, concl_of(at_x))
      | th :: Thm: EQ_MP(th, at_x)
      | ~else: at_x)

// -- the whole construction ---------------------------------------------------
//
// A self-recursive `DatatypeSpec` in, a `DatatypeThms` out, with every
// theorem proved.  The observers come from `datatype_common.rhm`, the same
// code the non-recursive construction uses: what a discriminator or a
// selector means does not depend on how the type was built, only on
// injectivity, distinctness and cases -- which are now derived here too.
fun build_recursive_datatype_thms(thy0 :: Theory, spec :: DatatypeSpec,
                                  ind :: IndThms,
                                  alg :: AlgebraThms = algebra_base_thms())
     :: values(Theory, DatatypeThms):
  let (thy1, rc) = carve_recursive_datatype(thy0, spec, alg)
  let tree = derive_tree_theorems(thy1, rc, alg, ind)
  let (thy2, cs) = define_recursive_ctors(thy1, spec, rc)

  let injectivity:
    for values(acc :~ Map = {}) (c in spec.ctors, i in List.iota(spec.ctors.length())):
      cond
      | (c :~ Ctor).fields.length() == 0: acc
      | ~else:
          acc ++ {(c :~ Ctor).name:
                    restate_injectivity(thy2, spec, alg, rc, cs,
                                        (tree.injectivity[i] :~ Thm), i)}
  // `i < j` in the order `DatatypeThms` states them, and `derive_tree_theorems`
  // produced them in that same order
  let distinctness :~ List:
    let pairs = for values(acc :~ List = []) (i in List.iota(spec.ctors.length())):
                  for values(a2 :~ List = acc) (j in List.iota(spec.ctors.length())):
                    (if i < j | a2 ++ [[i, j]] | a2)
    for List (ij in pairs, t in tree.distinctness):
      restate_distinctness(thy2, spec, rc, cs, t :~ Thm,
                           ((ij :~ List)[0] :~ Int), ((ij :~ List)[1] :~ Int))
  let induction = restate_induction(thy2, spec, alg, rc, cs, tree.induction)
  let cases = restate_cases(thy2, spec, cs, induction)

  fun ctor_distinct(i :: Int, j :: Int) :: Thm:
    let idx:
      recur loop (a = 0, b = 1, k = 0):
        cond
        | a == i && b == j: k
        | b == spec.ctors.length() - 1: loop(a + 1, a + 2, k + 1)
        | ~else: loop(a, b + 1, k + 1)
    (distinctness[idx] :~ Thm)
  let (thy, discriminators, selectors, elim_rules):
    build_observers(thy2, spec, fun (i :: Int): (cs.terms[i] :~ Term),
                    injectivity, ctor_distinct, cases)
  values(thy,
         DatatypeThms(spec, injectivity, distinctness, induction, cases,
                      discriminators, selectors, elim_rules))
