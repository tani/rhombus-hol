#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// The definition layer depends only on these capabilities, never on a
// particular prover implementation. The rewrite database handle is opaque
// here; its concrete representation belongs to the prover adapter.

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel open

export:
  LogicRules
  RewriteSupport

class LogicRules(tautologies :: Function.of_arity(1),
                 conditionals :: Function.of_arity(1),
                 not_true_eq_false :: Function.of_arity(1),
                 excluded_middle :: Function.of_arity(2))

class RewriteSupport(new_db :: Function.of_arity(0),
                     add_thm :: Function.of_arity(4),
                     add_rewrite_thm :: Function.of_arity(4),
                     simplify :: Function.of_arity(3))
