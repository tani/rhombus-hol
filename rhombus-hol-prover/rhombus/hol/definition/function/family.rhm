#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// A family of mutually recursive functions.
//
// Nothing here is a new recursion principle.  The family is read as *one*
// ordinary function over a tagged argument -- the domain datatype, one
// constructor per member carrying that member's parameters -- and each member
// is then an ordinary non-recursive definition that tags its arguments and
// reads the result back:
//
//     function.together:            becomes   D          the domain datatype
//       function even(n :: Nat)               C          the result datatype,
//       function odd(n :: Nat)                           when the members'
//                                                        results differ
//                                             impl       one function over D
//                                             even, odd  impl at their own tag
//
// So mutual recursion needs no second well-founded-recursion path: `impl` is
// derived by the machinery an ordinary recursive `function` already uses, and
// the members' clausal equations are *derived* from `impl`'s, one rewrite
// each way -- unfold the member, use `impl`'s equation, drop the result tag,
// and fold the calls back into the members they came from.
//
// What a family does need is a descent order that spans it, since a call
// leaves the member it was made in.  That is a measure into a single type:
// either the one every member's `proof: ~measure:` produces, or, for a
// structural family, the argument column each member descends in -- read
// through a mutually recursive datatype's union type when the members recurse
// over a datatype family, which is exactly why that union exists.

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel/names open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/logic/conversion open
  rhombus/hol/logic/derived open
  rhombus/hol/definition/datatype/define open
  rhombus/hol/definition/function/spec open
  rhombus/hol/definition/function/termination open
  rhombus/hol/definition/function/decision_tree open

export:
  FamilyMemberFn
  family_impl_name
  family_domain_spec
  family_codomain_spec
  family_members
  family_call_sites
  combined_function_spec
  member_definition_term
  derive_member_equations

// One member, with the pieces that translate between it and the combined
// function: how its arguments are tagged, and how its result is tagged and
// read back.  `cod_ctor` and `cod_selector` are `#false` when every member
// returns the same type, since then nothing has to be tagged.
class FamilyMemberFn(name :: Symbol,
                     fn :: Term,
                     arg_types :: List.of(HType),
                     ret_type :: HType,
                     dom_ctor :: Term,
                     cod_ctor :: maybe(Term),
                     cod_selector :: maybe(Term))

fun joined(names :: List.of(Symbol)) :: String:
  for values(acc :~ String = "") (name in names):
    acc ++ (if acc == "" | "" | "_") ++ to_string(name :~ Symbol)

fun family_base_name(names :: List.of(Symbol)) :: Symbol:
  Symbol.from_string(joined(names))

fun family_domain_name(names :: List.of(Symbol)) :: Symbol:
  suffixed(family_base_name(names), "_dom")

fun family_codomain_name(names :: List.of(Symbol)) :: Symbol:
  suffixed(family_base_name(names), "_cod")

fun family_impl_name(names :: List.of(Symbol)) :: Symbol:
  suffixed(family_base_name(names), "_impl")

fun tag_ctor_name(type_name :: Symbol, member :: Symbol) :: Symbol:
  Symbol.from_string(to_string(type_name) ++ "_" ++ to_string(member))

// `D`: one constructor per member, its fields that member's parameters.
// Field names are positional, not the member's own parameter names, so two
// members cannot collide in the selector namespace.
fun family_domain_spec(specs :: List.of(FunSpec),
                       params :: List.of(Symbol)) :: DatatypeSpec:
  let name = family_domain_name(specs.map(fun (s :: FunSpec): s.name))
  DatatypeSpec(
    name, params,
    for List (spec in specs):
      let spec :~ FunSpec = spec
      Ctor(tag_ctor_name(name, spec.name),
           for List (ty in spec.arg_types, i in List.iota(spec.arg_types.length())):
             Field(Symbol.from_string("a" ++ to_string(i)), ty :~ HType)))

// `C`, or `#false` when every member returns the same type and no result tag
// is needed.
fun family_codomain_spec(specs :: List.of(FunSpec),
                         params :: List.of(Symbol)) :: maybe(DatatypeSpec):
  let first = (specs[0] :~ FunSpec).ret_type
  let uniform = for all (spec in specs): (spec :~ FunSpec).ret_type == first
  cond
  | uniform: #false
  | ~else:
      let name = family_codomain_name(specs.map(fun (s :: FunSpec): s.name))
      DatatypeSpec(
        name, params,
        for List (spec in specs):
          let spec :~ FunSpec = spec
          Ctor(tag_ctor_name(name, spec.name),
               [Field(#'value, spec.ret_type)]))

fun family_members(specs :: List.of(FunSpec),
                   dom :: DatatypeSpec,
                   cod :: maybe(DatatypeSpec)) :: List.of(FamilyMemberFn):
  let dom_ty = self_type(dom)
  for List (spec in specs, i in List.iota(specs.length())):
    let spec :~ FunSpec = spec
    let dom_ctor = mk_const((dom.ctors[i] :~ Ctor).name,
                            ctor_type(dom, dom.ctors[i] :~ Ctor))
    let (cod_ctor, cod_selector):
      match cod
      | #false: values(#false, #false)
      | cod_spec:
          let cod_spec :~ DatatypeSpec = cod_spec
          let c :~ Ctor = cod_spec.ctors[i]
          let cod_ty = self_type(cod_spec)
          values(mk_const(c.name, ctor_type(cod_spec, c)),
                 mk_const(selector_name(c, c.fields[0] :~ Field),
                          mk_fun(cod_ty, spec.ret_type)))
    FamilyMemberFn(spec.name, mk_const(spec.name, fun_type(spec)),
                   spec.arg_types, spec.ret_type, dom_ctor :~ Term,
                   cod_ctor, cod_selector)

// The position of the member whose combined-function head is `head`, or
// `#false` when no member matches. Shared by every caller that needs to
// locate a member by its head constant, rather than each re-running its own
// linear scan.
fun member_index(members :: List.of(FamilyMemberFn),
                 head :: Term) :: maybe(NonnegInt):
  recur loop (i = 0):
    cond
    | i >= members.length(): #false
    | (members[i] :~ FamilyMemberFn).fn == head: i
    | ~else: loop(i + 1)

fun member_for_head(members :: List.of(FamilyMemberFn),
                    head :: Term) :: maybe(FamilyMemberFn):
  match member_index(members, head)
  | #false: #false
  | i :: NonnegInt: members[i] :~ FamilyMemberFn

fun tagged_argument(m :: FamilyMemberFn, args :: List.of(Term)) :: Term:
  list_mk_comb(m.dom_ctor, args)

fun wrap_result(m :: FamilyMemberFn, t :: Term) :: Term:
  match m.cod_ctor
  | #false: t
  | c: mk_comb(c :~ Term, t)

fun read_result(m :: FamilyMemberFn, t :: Term) :: Term:
  match m.cod_selector
  | #false: t
  | s: mk_comb(s :~ Term, t)

// A member call, as the combined function makes it.
fun impl_call(impl :: Term, m :: FamilyMemberFn,
              args :: List.of(Term)) :: Term:
  read_result(m, mk_comb(impl, tagged_argument(m, args)))

// Every call of a member, replaced by the combined function's own call.  A
// member mentioned without all of its arguments has no such reading: the
// combined function takes one tagged argument, and there is nothing to tag.
fun rewrite_family_calls(members :: List.of(FamilyMemberFn), impl :: Term,
                         t :: Term) :: Term:
  let (head, args) = strip_comb(t)
  match member_for_head(members, head)
  | m :: FamilyMemberFn:
      unless args.length() == m.arg_types.length()
      | error(~who: #'function,
              "a member of a function family must be called with all of "
                ++ "its arguments",
              error.val(~label: "member", m.name),
              error.val(~label: "in", show(t)))
      impl_call(impl, m,
                args.map(fun (a :: Term):
                           rewrite_family_calls(members, impl, a)))
  | ~else:
      match t
      | Comb(f, x):
          mk_comb(rewrite_family_calls(members, impl, f :~ Term),
                  rewrite_family_calls(members, impl, x :~ Term))
      | Abs(_, _):
          let (v, body) = dest_abs(t)
          mk_abs(v :~ FVar, rewrite_family_calls(members, impl, body :~ Term))
      | ~else: t

// `|- rewrite_family_calls(t) = t`, by congruence: the two differ only at the
// calls, and there each member's own definition is the equation between them.
fun fold_family_calls(thy :: Theory, members :: List.of(FamilyMemberFn),
                      definitions :: List.of(Thm), impl :: Term,
                      t :: Term) :: Thm:
  fun walk(t :: Term) :: Thm:
    let (head, args) = strip_comb(t)
    match member_index(members, head)
    | index :: NonnegInt when args.length()
                               == (members[index] :~ FamilyMemberFn).arg_types.length():
        let m :~ FamilyMemberFn = members[index]
        let sub = args.map(walk)
        let rewritten = args.map(
                          fun (a :: Term):
                            rewrite_family_calls(members, impl, a))
        // `|- impl-call(rewritten args) = f(rewritten args)`
        let unfolded = unfold_def(thy, definitions[index] :~ Thm, rewritten)
        // `|- f(rewritten args) = f(args)`
        let congruent:
          for values(acc :~ Thm = REFL(thy, m.fn)) (eq in sub):
            MK_COMB(acc, eq :~ Thm)
        TRANS(SYM(thy, unfolded), congruent)
    | ~else:
        match t
        | Comb(f, x): MK_COMB(walk(f :~ Term), walk(x :~ Term))
        | Abs(_, _):
            let (v, body) = dest_abs(t)
            ABS(thy, v :~ FVar, walk(body :~ Term))
        | ~else: REFL(thy, t)
  walk(t)

// The combined function: one clause per member clause, its patterns tagged
// and its body rewritten. Every evaluated term is rewritten -- a `let`
// initializer inside a member's body runs whether or not the family
// carries its value, and a recursive call inside it still has to leave the
// member the same way one in the logical result does -- but only the last,
// the logical result, gets the result tag: an initializer is never itself
// what a member's own equation returns.
fun wrap_last(m :: FamilyMemberFn, terms :: List.of(Term)) :: List.of(Term):
  let last = terms.length() - 1
  for List (t in terms, i in List.iota(terms.length())):
    (if i == last | wrap_result(m, t :~ Term) | t :~ Term)

fun combined_function_spec(impl_name :: Symbol,
                           specs :: List.of(FunSpec),
                           members :: List.of(FamilyMemberFn),
                           dom :: DatatypeSpec,
                           cod :: maybe(DatatypeSpec),
                           measure :: maybe(Term)) :: FunSpec:
  let dom_ty = self_type(dom)
  let ret_ty:
    match cod
    | #false: (specs[0] :~ FunSpec).ret_type
    | cod_spec: self_type(cod_spec :~ DatatypeSpec)
  let impl = mk_const(impl_name, mk_fun(dom_ty, ret_ty))
  let clauses:
    for values(acc :~ List.of(DefClause) = []) (spec in specs, m in members):
      acc ++ (for List (cl in (spec :~ FunSpec).clauses):
                let cl :~ DefClause = cl
                let rewritten = cl.terms.map(
                                  fun (t :: Term):
                                    rewrite_family_calls(members, impl :~ Term, t))
                DefClause([tagged_argument(m :~ FamilyMemberFn, cl.pats)],
                          wrap_last(m :~ FamilyMemberFn, rewritten)))
  FunSpec(impl_name, [dom_ty], ret_ty, clauses, measure)

// `f = \x1..xn. read(impl(tag(x1..xn)))`, the member as an ordinary
// definition over the combined function.
fun member_definition_term(impl :: Term, m :: FamilyMemberFn) :: Term:
  let vars = for List (ty in m.arg_types, i in List.iota(m.arg_types.length())):
               mk_var(Symbol.from_string("x" ++ to_string(i)), ty :~ HType)
  list_mk_abs(vars,
              impl_call(impl, m, vars.map(fun (v :: FVar): v :~ Term)))

// -- the members' equations ---------------------------------------------------

// A first-order match of two terms of the same shape, as a substitution
// taking the first's variables to the second's.  Used to state the combined
// function's clause equation at the variables the member's clause was
// written with, rather than at whatever the equation's own binders are
// called.
fun match_variables(source :: Term, target :: Term) :: List.of(List.of(Term)):
  recur walk (p :: Term = source, t :: Term = target,
              acc :~ List.of(List.of(Term)) = []):
    match p
    | FVar(_, _):
        (if (for any (pair in acc): (pair :~ List)[1] == p :~ Term)
         | acc
         | acc ++ [[t, p :~ Term]])
    | Comb(pf, px):
        match t
        | Comb(tf, tx): walk(px :~ Term, tx :~ Term,
                             walk(pf :~ Term, tf :~ Term, acc))
        | ~else: acc
    | ~else: acc

// `|- !vars. guards ==> f(pats) = rhs`, for one reachable decision-tree
// leaf of one member. A source catch-all can own several leaves after earlier
// clauses refine it, so the leaf's patterns and guards -- not merely the
// source-clause index -- determine the member equation.
fun derive_member_equation(thy :: Theory, members :: List.of(FamilyMemberFn),
                           definitions :: List.of(Thm), impl :: Term,
                           selector_theorems :: List.of(Thm),
                           index :: NonnegInt,
                           clause :: DefClause,
                           patterns :: List.of(Term),
                           impl_equation :: Thm) :: Thm:
  let m :~ FamilyMemberFn = members[index]
  let vars = pattern_variables(patterns)
  let rhs_substitution:
    for values(out :~ Map = {}) (
          source in clause.pats, target in patterns):
      for values(acc :~ Map = out) (
            pair in match_variables(source :~ Term, target :~ Term)):
        let [t, p] = pair :~ List
        acc ++ {p :~ FVar: t :~ Term}
  let rhs_here = inst_fvar(rhs_substitution, clause_rhs(clause))
  let lhs_target = mk_comb(impl, tagged_argument(m, patterns))
  let opened = specialize_all(thy, impl_equation)
  let (guards, _) = strip_imp(concl_of(opened))
  let unguarded = UNDISCH_ALL(thy, opened)
  let substitution:
    for values(out :~ Map = {}) (
          pair in match_variables(
                    lhs_of_equation(concl_of(unguarded)), lhs_target)):
      let [t, p] = pair :~ List
      out ++ {p :~ FVar: t :~ Term}
  let instance = INST(thy, substitution, unguarded)
  let instantiated_guards:
    guards.map(
      fun (guard :: Term): inst_fvar(substitution, guard))
  // `|- f(pats) = read(impl(tag(pats)))`
  let unfolded = unfold_def(thy, definitions[index] :~ Thm, patterns)
  // `|- read(impl(tag(pats))) = read(wrap(rhs'))`
  let through:
    match m.cod_selector
    | #false: instance
    | s: AP_TERM(thy, s :~ Term, instance)
  // `|- read(wrap(rhs')) = rhs'`
  let untagged:
    match m.cod_selector
    | #false: through
    | _:
        TRANS(through,
              SPEC(thy, rewrite_family_calls(members, impl, rhs_here),
                   selector_theorems[index] :~ Thm))
  let folded = fold_family_calls(thy, members, definitions, impl, rhs_here)
  let equation = TRANS(unfolded, TRANS(untagged, folded))
  let guarded:
    for values(acc :~ Thm = equation) (
          guard in instantiated_guards.reverse()):
      DISCH(thy, guard :~ Term, acc)
  GENL(thy, vars, guarded)

fun lhs_of_equation(t :: Term) :: Term:
  match dest_eq(t)
  | [a, _]: a :~ Term
  | ~else: error(~who: #'function, "internal non-equation",
                 error.val(~label: "term", show(t)))

// Every universally quantified variable of `th`, opened at its own name.
fun specialize_all(thy :: Theory, th :: Thm) :: Thm:
  recur loop (current :~ Thm = th):
    cond
    | is_forall(concl_of(current)):
        let [v, _] = (match dest_forall(concl_of(current)) | pair: pair)
        loop(SPEC(thy, variant(hyps_of(current) ++ [concl_of(current)],
                               v :~ FVar) :~ Term,
                  current))
    | ~else: current

fun pattern_variables(patterns :: List.of(Term)) :: List.of(FVar):
  for values(acc :~ List.of(FVar) = []) (pat in patterns):
    for values(out :~ List.of(FVar) = acc) (
          variable in free_vars(pat :~ Term)):
      (if out.contains(variable)
       | out
       | out ++ [variable :~ FVar])

fun member_leaf_patterns(member :: FamilyMemberFn,
                         shape :: LeafShape) :: List.of(Term):
  match shape.patterns
  | [tagged]:
      let (head, arguments) = strip_comb(tagged :~ Term)
      unless head == member.dom_ctor
               && arguments.length() == member.arg_types.length()
      | error(~who: #'function,
              "internal family decision-tree leaf has the wrong tag")
      arguments
  | ~else:
      error(~who: #'function,
            "internal family decision-tree leaf has the wrong arity")

// One equation per reachable decision-tree leaf of every member, in member
// and leaf order. `shapes` and `impl_equations` are generated from the same
// prepared tree, so their positions correspond exactly.
fun derive_member_equations(
      thy :: Theory, specs :: List.of(FunSpec),
      members :: List.of(FamilyMemberFn),
      definitions :: List.of(Thm), impl :: Term,
      selector_theorems :: List.of(Thm),
      prepared :: PreparedFunction,
      dt_specs :: Map.of(Symbol, DatatypeSpec),
      impl_equations :: List.of(Thm))
     :: List.of(List.of(Thm)):
  let roots:
    for List (ty in prepared.spec.arg_types,
              i in List.iota(prepared.spec.arg_types.length())):
      mk_var(Symbol.from_string("_eqx" ++ to_string(i)), ty :~ HType) :~ Term
  let shapes = leaf_shapes(dt_specs, prepared.tree, roots)
  unless shapes.length() == impl_equations.length()
  | error(~who: #'function,
          "internal family equation and decision-tree leaf counts differ")
  recur loop (index = 0, offset = 0,
              acc :~ List.of(List.of(Thm)) = []):
    cond
    | index >= specs.length(): acc
    | ~else:
        let spec :~ FunSpec = specs[index]
        let limit = offset + spec.clauses.length()
        let equations:
          for values(out :~ List.of(Thm) = []) (
                shape in shapes, impl_equation in impl_equations):
            let shape :~ LeafShape = shape
            cond
            | shape.clause >= offset && shape.clause < limit:
                let clause :~ DefClause = spec.clauses[shape.clause - offset]
                let patterns = member_leaf_patterns(
                                 members[index] :~ FamilyMemberFn, shape)
                out ++ [
                  derive_member_equation(
                    thy, members, definitions, impl, selector_theorems,
                    index :~ NonnegInt, clause, patterns,
                    impl_equation :~ Thm)
                ]
            | ~else: out
        loop(index + 1, limit, acc ++ [equations])


// Every call one member makes to a member, as
// `[caller, clause, callee, arguments]`.  Every term a clause evaluates is
// searched, not only its right-hand side, for the same reason the
// single-function checker searches them: a `let` initializer runs whether or
// not its value is read.
fun family_call_sites(members :: List.of(FamilyMemberFn),
                      specs :: List.of(FunSpec)) :: List.of(List):
  fun calls_in(t :: Term, acc :~ List.of(List)) :: List.of(List):
    let (head, args) = strip_comb(t)
    let here:
      match member_index(members, head)
      | #false: acc
      | j :: NonnegInt when args.length()
                             == (members[j] :~ FamilyMemberFn).arg_types.length():
          acc ++ [[j, args]]
      | ~else: acc
    match t
    | Comb(f, x): calls_in(x :~ Term, calls_in(f :~ Term, here))
    | Abs(_, _):
        let (_, body) = dest_abs(t)
        calls_in(body :~ Term, here)
    | ~else: here
  for values(sites :~ List.of(List) = []) (
        spec in specs, i in List.iota(specs.length())):
    for values(out :~ List.of(List) = sites) (
          cl in (spec :~ FunSpec).clauses,
          c in List.iota((spec :~ FunSpec).clauses.length())):
      for values(inner :~ List.of(List) = out) (
            t in (cl :~ DefClause).terms):
        for values(final :~ List.of(List) = inner) (
              call in calls_in(t :~ Term, [])):
          let [j, args] = call :~ List
          let site = [i, c, j, args]
          (if final.contains(site) | final | final ++ [site])
