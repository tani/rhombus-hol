#lang rhombus/static

// A small, explicit free computation. Domain modules define typed operation
// variants under `EffectOperation`; handlers interpret only the variants they
// own and forward every other request. Keeping continuations as data fields
// makes the control boundary inspectable and keeps machinery out of the kernel.

class EffectOperation():
  nonfinal

class.together:
  class Computation():
    nonfinal

  class Pure(value):
    extends Computation

  class Request(operation :: EffectOperation, resume :: Function):
    extends Computation

export:
  EffectOperation
  Computation
  Pure
  Request
  pure
  perform
  bind
  handle

fun pure(value) :: Computation:
  Pure(value)

fun perform(operation :: EffectOperation) :: Computation:
  Request(operation, fun (value): Pure(value))

fun bind(computation :: Computation, next :: Function) :: Computation:
  match computation
  | Pure(value): next(value)
  | Request(operation, resume):
      Request(operation, fun (value): bind(resume(value), next))

// `handler` receives a typed operation and a handled resumption. It returns
// `#false` to forward the request unchanged, or a computation to interpret it.
// Forwarding is what allows independently defined operation classes to compose.
fun handle(computation :: Computation, handler :: Function) :: Computation:
  match computation
  | Pure(_): computation
  | Request(operation, resume):
      let handled_resume = fun (value): handle(resume(value), handler)
      match handler(operation, handled_resume)
      | #false: Request(operation, handled_resume)
      | result: result :~ Computation
