#lang rhombus/static

import:
  "core.rhm" open

// Semantic failure is explicit. It is distinct from a request being
// inapplicable (`#false` in conversion code), resource exhaustion, and an
// implementation error.

class Failure(reason):
  extends EffectOperation

class Failed(reason):
  extends Computation

export:
  Failed
  Failure
  fail
  handle_fail
  run_fail

fun fail(reason) :: Computation:
  perform(Failure(reason))

fun handle_fail(computation :: Computation) :: Computation:
  match computation
  | Pure(_): computation
  | Failed(_): computation
  | Request(operation, resume):
      match operation
      | Failure(reason): Failed(reason)
      | ~else:
          Request(operation,
                  fun (value): handle_fail(resume(value)))

// Use only when Failure is the last remaining effect. The success value stays
// in `Pure`, preserving the core result representation for outer consumers.
fun run_fail(computation :: Computation) :: Computation:
  let result = handle_fail(computation)
  match result
  | Pure(_): result
  | Failed(_): result
  | _: error(~who: #'run_fail, "unhandled effect")
