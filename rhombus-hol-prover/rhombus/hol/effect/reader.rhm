#lang rhombus/static

import:
  "syntax.rhm" open
  "core.rhm" open

// Reader supplies an immutable, dynamically scoped environment. `local`
// scopes only the computation it wraps; its continuation resumes in the
// enclosing environment.

class ReaderAsk():
  extends EffectOperation

class ReaderLocal(transform :: Function, body :: Computation):
  extends EffectOperation

export:
  ReaderLocal
  ReaderAsk
  ask
  local
  handle_reader
  run_reader

fun ask() :: Computation:
  perform(ReaderAsk())

fun local(transform :: Function, body :: Computation) :: Computation:
  perform(ReaderLocal(transform, body))

fun handle_reader(computation :: Computation, environment) :: Computation:
  fun loop(computation :: Computation, environment):
    match computation
    | Pure(_): computation
    | Request(operation, resume):
        match operation
        | ReaderAsk():
            loop(resume(environment), environment)
        | ReaderLocal(transform, body):
            effect:
              let value <- handle_reader(body, transform(environment))
              loop(resume(value), environment)
        | ~else:
            Request(operation,
                    fun (value): loop(resume(value), environment))
  loop(computation, environment)

fun run_reader(computation :: Computation, environment) :: Computation:
  let result = handle_reader(computation, environment)
  match result
  | Pure(_): result
  | _: error(~who: #'run_reader, "unhandled effect")
