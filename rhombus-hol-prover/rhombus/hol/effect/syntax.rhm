#lang rhombus/static

// `effect:` is the surface syntax for a free `Computation`: `<-` sequences a
// request, ordinary clauses stay in the continuation, and `return` lifts the
// final plain value. Handlers remain explicit; this syntax never installs one.

import:
  rhombus/meta open
  "core.rhm" open

export:
  effect
  return
  reader_effect
  state_effect
  failure_effect

macro 'return $value':
  'pure($value)'


class_clause.macro 'reader_effect':
  'class Ask():
     extends EffectOperation
   class Local(transform :: Function, body :: Computation):
     extends EffectOperation

   fun ask() :: Computation:
     perform(Ask())
   fun local(transform :: Function, body :: Computation) :: Computation:
     perform(Local(transform, body))
   fun handle(environment, computation :: Computation) :: Computation:
     recur loop (current :: Computation = computation,
                 current_env = environment):
       match current
       | Pure(_): current
       | Request(operation, resume):
           match operation
           | Ask(): loop(resume(current_env), current_env)
           | Local(transform, body):
               bind(handle(transform(current_env), body),
                    fun (value): loop(resume(value), current_env))
           | ~else:
               Request(operation,
                       fun (value): loop(resume(value), current_env))
   export:
     ask
     local
     handle'

class_clause.macro 'state_effect':
  'class Get():
     extends EffectOperation
   class Put(value):
     extends EffectOperation
   class Modify(transform :: Function):
     extends EffectOperation
   class Result(value, state)

   fun get() :: Computation:
     perform(Get())
   fun put(value) :: Computation:
     perform(Put(value))
   fun modify(transform :: Function) :: Computation:
     perform(Modify(transform))
   fun handle(initial, computation :: Computation) :: Computation:
     recur loop (current :: Computation = computation,
                 state = initial):
       match current
       | Pure(value): Pure(Result(value, state))
       | Request(operation, resume):
           match operation
           | Get(): loop(resume(state), state)
           | Put(value): loop(resume(value), value)
           | Modify(transform):
               let next = transform(state)
               loop(resume(#void), next)
           | ~else:
               Request(operation,
                       fun (value): loop(resume(value), state))
   export:
     Result
     get
     put
     modify
     handle'

class_clause.macro 'failure_effect':
  'class Fail(reason):
     extends EffectOperation
   class Failed(reason):
     extends Computation

   fun fail(reason) :: Computation:
     perform(Fail(reason))
   fun handle(computation :: Computation) :: Computation:
     match computation
     | Pure(_): computation
     | Failed(_): computation
     | Request(operation, resume):
         match operation
         | Fail(reason): Failed(reason)
         | ~else:
             Request(operation,
                     fun (value): handle(resume(value)))
   export:
     Failed
     fail
     handle'
meta:
  // `Block` retains its colon wrapper, so lowering first extracts the raw
  // groups and later rebuilds a scoped block at each generated continuation.
  fun make_block(groups :: List, context :: Syntax) :: Syntax:
    Syntax.make([#'block] ++ groups, context)

  fun clause_syntax(group, context :: Syntax) :: Syntax:
    match group
    | List.cons(#'group, terms): Syntax.make_group(terms, context)
    | ~else:
        syntax_meta.error("internal malformed effect clause", context)

  // Expand the unprocessed tail through `effect:` and retain the resulting
  // groups, so typed and untyped binds share exactly one continuation path.
  fun lower_tail(groups :: List, context :: Syntax) :: List:
    let source = make_block(groups, context)
    let lowered = 'effect $source'
    lowered.unwrap_sequence()

  fun continuation_block(groups :: List, context :: Syntax) :: Syntax:
    make_block(lower_tail(groups, context), context)

  fun lower_effect(groups :: List, context :: Syntax) :: Syntax:
    match groups
    | []:
        syntax_meta.error("an effect block needs a final computation", context)
    | List.cons(group, rest):
        let clause = clause_syntax(group, context)
        match clause
        | 'let $(name :: Identifier) :: $type ... <- $(computation :: Group)':
            let continuation = continuation_block(rest, context)
            'bind($computation, fun ($name :: $type ...) $continuation)'
        | 'let $(name :: Identifier) <- $(computation :: Group)':
            let continuation = continuation_block(rest, context)
            'bind($computation, fun ($name) $continuation)'
        | 'return $(value :: Group)':
            unless rest == []
            | syntax_meta.error("`return` must be the final effect clause",
                                clause)
            'pure($value)'
        | ~else:
            cond
            | rest == []:
                let final_block = make_block([group], context)
                'block $final_block'
            | ~else:
                let content = make_block([group] ++ lower_tail(rest, context),
                                         context)
                'block $content'

expr.macro 'effect: $(body :: Block)':
  match body.unwrap_all()
  | List.cons(#'block, groups): lower_effect(groups, body)
  | ~else: syntax_meta.error("internal malformed effect block", body)
