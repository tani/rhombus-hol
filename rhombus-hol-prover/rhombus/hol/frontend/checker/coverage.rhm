#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Pattern coverage and the other structural rules of a closed checked tree.
//
// Checking a declaration settles names and types; this pass settles what
// depends on the whole tree rather than one node:
//
// - every `match`, and every clause-form function, covers its argument type
//   and has no clause an earlier one shadows everywhere;
// - a binder -- a parameter, a quantifier's binder, a `let` -- accepts only
//   a pattern that cannot fail;
// - executable code never compares functions.
//
// Coverage is decided by the usual matrix usefulness test (Maranget's): a
// clause is reachable when some value it matches escapes every earlier
// clause, and a match is exhaustive when no value escapes all of them. A
// numeral pattern is its `succ(...(zero()))` spelling, which is what it
// matches.

import:
  rhombus/hol/kernel/type open
  rhombus/hol/frontend/parser/core open
  rhombus/hol/frontend/checker/checked open

export:
  check_structure

// A pattern as coverage sees it: anything, or a constructor of the type
// `ty` applied to sub-patterns.
class Any()
class Con(ty :: Symbol, name :: Symbol, args :: List)

// What the pass reads: each datatype's constructors, as `[name, arity]`
// under the type's kernel name; who to blame; and whether the tree is
// executable.
class Scope(datatypes :: Map.of(Symbol, List.of(List)),
            who :: Symbol,
            executable :: Boolean)

fun type_name(ty :: HType) :: Symbol:
  match ty
  | TyApp(name, _): name
  | ~else: error(~who: #'check_structure, "a constructor pattern at a type variable")

fun nat_pattern(value :: NonnegInt) :: Con:
  if value == 0
  | Con(#'Nat, #'zero, [])
  | Con(#'Nat, #'succ, [nat_pattern(value - 1)])

fun simple(pat :: CheckedPattern) :: Any || Con:
  match pat
  | CheckedPatCtor(name, args, _, ty, _):
      Con(type_name(ty), name, args.map(simple))
  | CheckedPatLiteral(value, _, _): nat_pattern(value)
  | ~else: Any()

fun anys(n :: NonnegInt) :: List:
  for List (_ in 0..n): Any()

// The first constructor pattern among `heads`, if any.
fun first_con(heads :: List) :: maybe(Con):
  for values(found = #false) (head in heads):
    found || (if head is_a Con | head | #false)

fun con_names(heads :: List) :: List.of(Symbol):
  for values(out :~ List = []) (head in heads):
    match head
    | Con(_, name, _): out ++ [name]
    | ~else: out

// Rows whose first pattern admits constructor `name`, with that pattern
// replaced by its `arity` sub-patterns.
fun specialize(rows :: List.of(List), name :: Symbol,
               arity :: NonnegInt) :: List.of(List):
  for values(out :~ List = []) (row in rows):
    let row :~ List = row
    match row[0]
    | Con(_, n, args) when n == name: out ++ [args ++ row.drop(1)]
    | Con(_, _, _): out
    | ~else: out ++ [anys(arity) ++ row.drop(1)]

// Rows whose first pattern admits anything, without it.
fun default_rows(rows :: List.of(List)) :: List.of(List):
  for values(out :~ List = []) (row in rows):
    let row :~ List = row
    match row[0]
    | Con(_, _, _): out
    | ~else: out ++ [row.drop(1)]

// The first column's type's constructors when the column names every one of
// them, else `#false`.
fun complete_signature(scope :: Scope, heads :: List) :: maybe(List.of(List)):
  let named = con_names(heads)
  match first_con(heads)
  | Con(ty, _, _):
      match scope.datatypes.get(ty, #false)
      | #false: #false
      | constructors :~ List:
          if (for all (entry in constructors): named.contains((entry :~ List)[0]))
          | constructors
          | #false
  | ~else: #false

// Whether some value matching `row` escapes every one of `rows`.
fun useful(scope :: Scope, rows :: List.of(List), row :: List) :: Boolean:
  match row
  | []: rows == []
  | List.cons(Con(_, name, args), rest):
      useful(scope, specialize(rows, name, args.length()), args ++ rest)
  | List.cons(_, rest):
      match complete_signature(scope, rows.map(fun (r :: List): r[0]))
      | #false: useful(scope, default_rows(rows), rest)
      | constructors :~ List:
          for any (entry in constructors):
            let [name, arity] = entry :~ List
            useful(scope, specialize(rows, name, arity),
                   anys(arity) ++ rest)

// A row of `width` patterns matching a value no row of `rows` matches, or
// `#false` when the rows are exhaustive.
fun uncovered(scope :: Scope, rows :: List.of(List),
              width :: NonnegInt) :: maybe(List):
  cond
  | width == 0: (if rows == [] | [] | #false)
  | ~else:
      let heads = rows.map(fun (r :: List): r[0])
      match complete_signature(scope, heads)
      | #false:
          match uncovered(scope, default_rows(rows), width - 1)
          | #false: #false
          | rest :~ List: [missing_head(scope, heads)] ++ rest
      | constructors :~ List:
          let ty = (first_con(heads) :~ Con).ty
          for values(found = #false) (entry in constructors):
            found
              || (block:
                    let [name, arity] = entry :~ List
                    match uncovered(scope, specialize(rows, name, arity),
                                    arity + width - 1)
                    | #false: #false
                    | witness :~ List:
                        [Con(ty, name, witness.take(arity))]
                          ++ witness.drop(arity))

// A pattern for the first column that no head names: a missing constructor
// when the column names any, else anything.
fun missing_head(scope :: Scope, heads :: List) :: Any || Con:
  match first_con(heads)
  | Con(ty, _, _):
      let named = con_names(heads)
      let constructors :~ List = scope.datatypes.get(ty, [])
      for values(found = Any()) (entry in constructors):
        let [name, arity] = entry :~ List
        cond
        | found is_a Con || named.contains(name): found
        | ~else: Con(ty, name, anys(arity))
  | ~else: Any()

fun show(pat :: Any || Con) :: String:
  match pat
  | Con(_, #'true, []): "#true"
  | Con(_, #'false, []): "#false"
  | Con(_, name, args):
      let label = (if name == c_pair | "Pair" | to_string(name))
      label ++ "(" ++ show_row(args) ++ ")"
  | ~else: "_"

fun show_row(row :: List) :: String:
  for values(out :~ String = "") (pat in row, i in 0..):
    (if i == 0 | "" | out ++ ", ") ++ show(pat)

// -- the rules ------------------------------------------------------------

fun fail(scope :: Scope, message :: String, at :: Syntax):
  syntax_error(scope.who, message, at)

fun check_rows(scope :: Scope, rows :: List.of(CheckedMatchRow),
               width :: NonnegInt, at :: Syntax) :: Void:
  let simple_rows:
    rows.map(fun (row :: CheckedMatchRow): row.patterns.map(simple))
  for (row in rows, i in 0..):
    let row :~ CheckedMatchRow = row
    unless useful(scope, simple_rows.take(i), simple_rows[i])
    | fail(scope,
           "this clause can never match: an earlier clause already covers "
             ++ "every argument shape this one does",
           row.at)
  match uncovered(scope, simple_rows, width)
  | #false: #void
  | witness :~ List:
      fail(scope,
           "the match is not exhaustive; it does not cover "
             ++ show_row(witness),
           at)

// The value shapes a binder pattern misses, or `#false` if it misses none.
fun refuted(scope :: Scope, pat :: CheckedPattern) :: maybe(List):
  uncovered(scope, [[simple(pat)]], 1)

fun fail_refutable(scope :: Scope, pat :: CheckedPattern, missed :: List):
  fail(scope,
       "a binder accepts only irrefutable patterns; it does not cover "
         ++ show_row(missed),
       checked_pattern_at(pat))

fun checked_pattern_at(pat :: CheckedPattern) :: Syntax:
  match pat
  | CheckedPatWildcard(_, at): at
  | CheckedPatVar(_, _, at): at
  | CheckedPatCtor(_, _, _, _, at): at
  | CheckedPatLiteral(_, _, at): at

fun check_binder_pattern(scope :: Scope, pat :: CheckedPattern) :: Void:
  match refuted(scope, pat)
  | #false: #void
  | missed :~ List: fail_refutable(scope, pat, missed)

fun walk_expr(scope :: Scope, expr :: CheckedExpr) :: Void:
  match expr
  | CheckedIf(c, t, e, _, _):
      walk_expr(scope, c)
      walk_expr(scope, t)
      walk_expr(scope, e)
  | CheckedBoolOp(_, args, _):
      for (arg in args): walk_expr(scope, arg :~ CheckedExpr)
  | CheckedEq(left, right, operand_ty, at):
      when scope.executable && is_fun(operand_ty)
      | fail(scope, "function equality has no sound executable interpretation",
             at)
      walk_expr(scope, left)
      walk_expr(scope, right)
  | CheckedApply(head, args, _, _):
      walk_expr(scope, head)
      for (arg in args): walk_expr(scope, arg :~ CheckedExpr)
  | CheckedQuantifier(binders, body, _, _):
      for (binder in binders):
        check_binder_pattern(scope, (binder :~ CheckedBinder).pat)
      walk_expr(scope, body)
  | fn :: CheckedFunction: walk_function(scope, fn)
  | CheckedBlock(body, _, _): walk_body(scope, body)
  | CheckedMatch(scrutinee, matrix, _, at):
      walk_expr(scope, scrutinee)
      walk_match_rows(scope, matrix, at)
  | ~else: #void

fun walk_function(scope :: Scope, fn :: CheckedFunction) :: Void:
  for (binder in fn.params):
    check_binder_pattern(scope, (binder :~ CheckedBinder).pat)
  match fn.body
  | matrix :: CheckedPatternMatrix:
      check_rows(scope, matrix.rows, fn.params.length(), fn.at)
      for (row in matrix.rows):
        walk_body(scope, (row :~ CheckedMatchRow).body)
  | body: walk_body(scope, body)

fun walk_match_rows(scope :: Scope, matrix :: CheckedPatternMatrix,
                    at :: Syntax) :: Void:
  check_rows(scope, matrix.rows, 1, at)
  for (row in matrix.rows):
    walk_body(scope, (row :~ CheckedMatchRow).body)

fun walk_body(scope :: Scope, body :: CheckedBody) :: Void:
  match body
  | CheckedBodyExpr(expr): walk_expr(scope, expr)
  | CheckedBodyLet(pat, init, tail, _, _):
      check_binder_pattern(scope, pat)
      walk_expr(scope, init)
      walk_body(scope, tail)
  | CheckedBodyMatch(scrutinee, matrix, _, at):
      walk_expr(scope, scrutinee)
      walk_match_rows(scope, matrix, at)
  | ~else:
      error(~who: #'check_structure, "function clauses inside a body")

// Check `expr`, a closed checked tree, against the rules above.
fun check_structure(datatypes :: Map.of(Symbol, List.of(List)),
                    expr :: CheckedExpr, who :: Symbol,
                    ~executable: executable :: Boolean = #false) :: Void:
  walk_expr(Scope(datatypes, who, executable), expr)
