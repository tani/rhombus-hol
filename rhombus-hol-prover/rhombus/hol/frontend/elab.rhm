#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// ACL2 hint handling is a design reference; see THIRD_PARTY_NOTICES.


// Reading the surface syntax into the logical world.
//
// This module only *analyses*: syntax in, kernel-level data out.  It builds no
// templates, because a syntax template created at phase 0 loses its bindings
// on the way out of a phase-1 macro -- `'def x = 1'` written here and returned
// from a macro reports `def: unbound identifier`.  Emission therefore lives in
// `module_block.rhm`; see the note at the top of `expand.rhm`.
//
// Shared source-level typing and name resolution live in `checked_core.rhm`.
// This module only lowers that representation into kernel terms and function
// specifications.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/datatype/datatype open
  rhombus/hol/datatype/algebra open
  rhombus/hol/recursion/recdef open
  rhombus/hol/recursion/dtree open
  rhombus/hol/number/literal open
  rhombus/hol/frontend/surface_core open
  rhombus/hol/logic/bool open
  rhombus/hol/frontend/tyunify open
  rhombus/hol/frontend/checked_core open
  rhombus/hol/overload/overload open
  rhombus/hol/frontend/type/registry open
  rhombus/hol/frontend/type/parse open

// `?` is already one shrubbery operator token. A type variable is therefore
// parsed structurally as that operator followed by one identifier; no string
// splitting or keyword conversion is needed.

fun fresh_wildcard(ty :: HType) :: FVar:
  mk_var(Symbol.gen("_wild"), ty)

// Reify eager initializer evaluation as beta-redexes when a clause is used
// inside a lambda or expression-level match. The logical normal form remains
// the clause's last term, while recursive-call traversal still sees every
// initializer.
fun eager_clause_term(c :: DefClause) :: Term:
  recur loop (remaining :~ List.of(Term) = c.terms):
    match remaining
    | [last]: last
    | List.cons(initializer, rest):
        let initializer :~ Term = initializer
        let ignored = mk_var(Symbol.gen("_eager"), type_of(initializer))
        mk_comb(mk_abs(ignored, loop(rest)), initializer)



// The pattern variable a `match` refines: `n` must name something still a
// *live*, unrefined position somewhere in `pats` -- a top-level parameter
// not yet matched, or a variable an enclosing pattern in this same clause
// just bound.  Refusing anything else catches every way `n` could fail to
// denote a fresh scrutinee: unbound entirely, already matched (its own name
// lingers in `env` after refinement, since `env` only ever grows), or bound
// by `let` to a computed term rather than a pattern position (matching on a
// computed value has no constructor test to check exhaustively against).
//
// A pattern variable may shadow a parameter -- `function f(n)` with a clause
// `succ(n)` -- and without checking liveness in `pats` (not just presence in
// `env`) a nested `match n` after that would look like a fresh match on the
// now-inaccessible outer `n` and silently refine nothing.
fun matched_var(env :: Map.of(Symbol, Term), pats :: List.of(Term),
                n :: Symbol, at :: Syntax) :: FVar:
  match env.get(n, #false)
  | #false:
      syntax_error(#'function, "the matched name is not in scope", at)
  | v when !(v is_a FVar):
      syntax_error(#'function,
                   "this name is not a pattern variable to match on", at)
  | v0:
      let v :~ FVar = v0
      unless pattern_var_live(pats, v)
      | syntax_error(#'function,
                     "this argument has already been matched; a nested "
                       ++ "`match` must be on a still-unmatched variable",
                     at)
      v

// Whether `v` occurs, unrefined, somewhere in `pats`'s pattern trees.
fun pattern_var_live(pats :: List.of(Term), v :: FVar) :: Boolean:
  fun walk(t :: Term) :: Boolean:
    match t
    | FVar(_, _): t == (v :~ Term)
    | ~else:
        let (head, args) = strip_comb(t)
        match head
        | Const(_, _): for any (a in args): walk(a)
        | ~else: #false
  for any (p in pats): walk(p)

// `pats` with the one live occurrence of `v` replaced by `new_pat`.
fun refine_pats(pats :: List.of(Term), v :: FVar,
                new_pat :: Term) :: List.of(Term):
  fun walk(t :: Term) :: Term:
    match t
    | FVar(_, _): (if t == (v :~ Term) | new_pat | t)
    | ~else:
        let (head, args) = strip_comb(t)
        match head
        | Const(_, _): list_mk_comb(head, args.map(walk))
        | ~else: t
  pats.map(walk)


// ============================================================================
// Core elaboration
// ============================================================================
//
// Surface enforestation has already resolved precedence, associativity, and
// extension bindings. This module resolves names and types against a Theory.

export:
  parse_core_prop
  core_type_vars
  ElabEnv
  RefRestriction
  run_type_elaboration
  run_elaboration
  run_checked_elaboration
  logical_check_env
  checked_function_clauses
  merge_pattern_bindings
  bind_checked_irrefutable_pattern
  close_substitution
  append_unique
// `self_name` and `self` are the definition being elaborated, so that a
// recursive call resolves before the constant exists in the theory.  In
// `#'prop` mode there is no such definition and both are `#false`.

class ElabEnv(thy :: Theory,
              tyvars :: List.of(Symbol),
              vars :: Map.of(Symbol, Term),
              mode :: Symbol,
              self_name :: maybe(Symbol),
              self :: maybe(Term),
              operators :: OverloadRegistry = standard_overload_registry(),
              type_constructors :: TypeConstructorRegistry = standard_type_constructor_registry(),
              datatypes :: Map.of(Symbol, DatatypeSpec) = {},
              restricted_refs :: Map.of(Symbol, RefRestriction) = {},
              inference :: CheckedInference = make_checked_inference()):
  property who :: Symbol:
    cond
    | mode == #'definition: #'definition
    | mode == #'prop: #'theorem
    | ~else: #'function

fun current_substitution(env :: ElabEnv) :: Map.of(Symbol, HType):
  env.inference.substitution.value :~ Map

// Terms constructed before inference closes can still contain generated type
// variables. Apply the final fixed-point substitution at lowering boundaries.
fun close_substitution(theta :: Map.of(Symbol, HType))
     :: Map.of(Symbol, HType):
  for values(out :~ Map = {}) ((name, ty) in theta):
    out ++ {name: deep_resolve(theta, ty :~ HType, [])}

fun resolve_type(env :: ElabEnv, ty :: HType) :: HType:
  checked_resolve(env.inference, ty)

fun resolve_term(env :: ElabEnv, term :: Term) :: Term:
  inst_type(close_substitution(current_substitution(env)), term)

fun logical_check_vars(env :: ElabEnv) :: Map.of(Symbol, HType):
  let with_self:
    match env.self_name
    | name :: Symbol:
        match env.self
        | term :: Term: {name: type_of(term)}
        | #false: {}
    | #false: {}
  for values(out :~ Map = with_self) ((name, term) in env.vars):
    out ++ {name: type_of(term :~ Term) :~ HType}

fun logical_check_env(env :: ElabEnv) :: CheckEnv:
  CheckEnv(
    env.inference,
    logical_check_vars(env),
    fun (name): const_type(env.thy, name),
    fun (name): const_type(env.thy, name),
    fun (stx): parse_type(
                 stx :~ Syntax, env.tyvars, env.type_constructors),
    env.operators,
    fun (ty): type_to_surface_string(env.type_constructors, ty :~ HType),
    fun (message, at): syntax_error(
                         env.who, message :~ String, at :~ Syntax),
    env.restricted_refs)


// -- CoreExpr elaboration ----------------------------------------------------


// Specialize phantom type variables in already-elaborated arguments from the
// function domains selected by unification. This is needed for expressions
// such as `left(x) === left(y)`: each `left` initially has an independent
// unconstrained right-hand sum parameter.
fun specialize_call_args(fty :: HType, args :: List.of(Term)) :: List.of(Term):
  recur loop (ty :~ HType = fty, rest :~ List.of(Term) = args,
              acc :~ List.of(Term) = []):
    match rest
    | []: acc
    | List.cons(arg, more):
        let (domain, range) = dest_fun(ty)
        let arg2:
          cond
          | type_of(arg) == domain: arg
          | ~else:
              match type_match(type_of(arg), domain, {})
              | #false: arg
              | theta: inst_type(theta :~ Map, arg)
        loop(range, more, acc ++ [arg2])



// The kernel stores a checked natural literal compactly. Its conversion API
// exposes `zero`/`succ` only when a proof needs one step, so elaboration never
// constructs an arithmetic-depth term.
fun nat_numeral(env :: ElabEnv, value :: NonnegInt, _at :: Syntax) :: Term:
  mk_nat_lit(env.thy, value)

fun elaborate_numeral(env :: ElabEnv, value :: NonnegInt,
                      expected :: HType, at :: Syntax) :: Term:
  let nat_ty = mk_tyapp(#'Nat, [])
  let int_ty = mk_tyapp(#'Integer, [])
  let rational_ty = mk_tyapp(#'Rational, [])
  let natural = nat_numeral(env, value, at)
  fun integer() :: Term:
    mk_comb(mk_const(#'int_from_nat, mk_fun(nat_ty, int_ty)), natural)
  cond
  | expected == nat_ty: natural
  | expected == int_ty: integer()
  | expected == rational_ty:
      mk_comb(
        mk_const(
          #'rational_from_integer, mk_fun(int_ty, rational_ty)),
        integer())
  | ~else:
      syntax_error(
        env.who,
        "a numeral has no representation at type "
          ++ type_to_surface_string(env.type_constructors, expected),
        at)




fun merge_pattern_bindings(who :: Symbol,
                           left :: Map.of(Symbol, Term),
                           right :: Map.of(Symbol, Term),
                           at :: Syntax) :: Map.of(Symbol, Term):
  for values(out :~ Map = left) ((name, value) in right):
    when out.get(name, #false)
    | syntax_error(
        who, "a binding pattern repeats `" ++ to_string(name) ++ "`", at)
    out ++ {name: value :~ Term}

fun single_constructor(env :: ElabEnv, name :: Symbol, at :: Syntax) :: List:
  let matches:
    for values(out :~ List = []) ((_, spec) in env.datatypes):
      let spec :~ DatatypeSpec = spec
      let constructors:
        for values(found :~ List = []) (ctor in spec.ctors):
          let ctor :~ Ctor = ctor
          (if ctor.name == name | found ++ [ctor] | found)
      match constructors
      | [ctor] when spec.ctors.length() == 1:
          out ++ [[spec, ctor]]
      | _: out
  match matches
  | [entry]: entry :~ List
  | ~else:
      syntax_error(
        env.who,
        "a binder accepts only irrefutable patterns; `" ++ to_string(name)
          ++ "` is not the sole constructor of its datatype",
        at)

fun checked_pattern_root_name(pat :: CheckedPattern,
                              hint :: String) :: Symbol:
  match pat
  | CheckedPatVar(name, _, _): name
  | ~else: Symbol.gen(hint)

fun bind_checked_irrefutable_pattern(
      env :: ElabEnv,
      pat :: CheckedPattern,
      value :: Term)
    :: Map.of(Symbol, Term):
  match pat
  | CheckedPatWildcard(_, _): {}
  | CheckedPatVar(name, _, _): {name: value}
  | CheckedPatCtor(name, args, _, _, at) when name == c_pair:
      let resolved = resolve_term(env, value)
      let first_bindings = bind_checked_irrefutable_pattern(
                             env, args[0] :~ CheckedPattern,
                             mk_fst(resolved))
      let second_bindings = bind_checked_irrefutable_pattern(
                              env, args[1] :~ CheckedPattern,
                              mk_snd(resolved))
      merge_pattern_bindings(
        env.who, first_bindings, second_bindings, at)
  | CheckedPatCtor(name, args, _, _, at):
      let [_spec, ctor] = single_constructor(env, name, at)
      let ctor :~ Ctor = ctor
      let resolved_value = resolve_term(env, value)
      let parsed:
        for List (arg in args, field in ctor.fields):
          let arg :~ CheckedPattern = arg
          let selector_type = mk_fun(
                                type_of(resolved_value),
                                resolve_type(env, checked_pattern_ty(arg)))
          let selected = mk_comb(
                           mk_const(
                             selector_name(ctor, field :~ Field),
                             selector_type),
                           resolved_value)
          bind_checked_irrefutable_pattern(env, arg, selected)
      for values(out :~ Map = {}) (bindings in parsed):
        merge_pattern_bindings(env.who, out, bindings :~ Map, at)
  | CheckedPatLiteral(_, _, at):
      syntax_error(
        env.who, "a literal pattern is refutable and cannot bind here", at)


fun checked_local_term(env :: ElabEnv, name :: Symbol,
                       at :: Syntax) :: Term:
  match env.vars.get(name, #false)
  | term :: Term: resolve_term(env, term)
  | #false:
      match env.self_name
      | self_name :: Symbol when self_name == name:
          match env.self
          | term :: Term: resolve_term(env, term)
          | #false:
              error(~who: #'checked_local_term,
                    "checked recursive reference has no logical term")
      | ~else:
          error(~who: #'checked_local_term,
                "checked local reference is absent from the logical environment")

fun checked_quantifier_term(env :: ElabEnv,
                            binders :: List.of(CheckedBinder),
                            body :: CheckedExpr,
                            is_forall :: Boolean) :: Term:
  let variables:
    for List (binder in binders):
      let binder :~ CheckedBinder = binder
      mk_var(checked_pattern_root_name(binder.pat, "_bound"),
             resolve_type(env, binder.ty))
  let local_bindings:
    for values(out :~ Map = {}) (binder in binders,
                                 variable in variables):
      let binder :~ CheckedBinder = binder
      merge_pattern_bindings(
        env.who, out,
        bind_checked_irrefutable_pattern(
          env, binder.pat, variable :~ Term),
        binder.at)
  let inner = checked_to_term(
                sub_env(env, env.vars ++ local_bindings), body)
  let build = (if is_forall | mk_forall | mk_exists)
  for values(term :~ Term = resolve_term(env, inner)) (
        variable in variables.reverse()):
    build(resolve_term(env, variable :~ FVar) :~ FVar, term)

fun checked_to_term(env :: ElabEnv, expr :: CheckedExpr) :: Term:
  match expr
  | CheckedLocal(name, _, at): checked_local_term(env, name, at)
  | CheckedConstant(name, ty, _):
      mk_const(name, resolve_type(env, ty))
  | CheckedNumeral(value, ty, at):
      elaborate_numeral(env, value, resolve_type(env, ty), at)
  | CheckedIf(condition, then_branch, else_branch, _, _):
      mk_cond(checked_to_term(env, condition),
              checked_to_term(env, then_branch),
              checked_to_term(env, else_branch))
  | CheckedBoolOp(op, args, _):
      let terms = args.map(
                    fun (arg :: CheckedExpr):
                      checked_to_term(env, arg))
      cond
      | op == #'conj:
          mk_conj(terms[0] :~ Term, terms[1] :~ Term)
      | op == #'disj:
          mk_disj(terms[0] :~ Term, terms[1] :~ Term)
      | op == #'imp:
          mk_imp(terms[0] :~ Term, terms[1] :~ Term)
      | op == #'neg:
          mk_neg(terms[0] :~ Term)
      | ~else:
          error(~who: #'checked_to_term, "unknown checked Boolean operator")
  | CheckedEq(left, right, _, _):
      mk_eq(checked_to_term(env, left), checked_to_term(env, right))
  | CheckedApply(head, args, _, _):
      let head_term = checked_to_term(env, head)
      let arg_terms = args.map(
                        fun (arg :: CheckedExpr):
                          checked_to_term(env, arg))
      list_mk_comb(
        head_term, specialize_call_args(type_of(head_term), arg_terms))
  | CheckedQuantifier(binders, body, is_forall, _):
      checked_quantifier_term(env, binders, body, is_forall)
  | fn :: CheckedFunction:
      checked_function_term(env, fn)
  | CheckedBlock(body, _, _):
      checked_body_term(env, body)
  | CheckedMatch(scrutinee, matrix, _, at):
      checked_match_term(env, scrutinee, matrix, at)
  | ~else:
      error(~who: #'checked_to_term, "unknown CheckedExpr variant")



// The shared checker owns every source-level type decision. Logical
// elaboration only lowers its semantic result into kernel terms.
fun run_elaboration(env :: ElabEnv, expr :: CoreExpr) :: Term:
  let checked = check_expr(logical_check_env(env), expr, #false)
  resolve_term(env, checked_to_term(env, checked))

fun run_checked_elaboration(env :: ElabEnv, expr :: CoreExpr,
                            expected :: HType) :: Term:
  let checked = check_expr(logical_check_env(env), expr, expected)
  resolve_term(env, checked_to_term(env, checked))

fun run_type_elaboration(env :: ElabEnv, stx :: Syntax) :: HType:
  parse_type(stx, env.tyvars, env.type_constructors)

fun parse_core_prop(
      thy :: Theory, tyvars :: List.of(Symbol),
      vars :: Map.of(Symbol, Term), expr :: CoreExpr,
      ~operators: operators :: OverloadRegistry = standard_overload_registry(),
      ~type_constructors: type_constructors :: TypeConstructorRegistry = standard_type_constructor_registry(),
      ~datatypes: datatypes :: Map.of(Symbol, DatatypeSpec) = {})
     :: Term:
  run_elaboration(ElabEnv(thy, tyvars, vars, #'prop, #false, #false,
                          operators, type_constructors, datatypes), expr)

fun append_unique(base :: List.of(Symbol),
                  more :: List.of(Symbol)) :: List.of(Symbol):
  for values(acc :~ List = base) (n in more):
    (if acc.contains(n) | acc | acc ++ [n])

fun core_type_vars(expr :: CoreExpr) :: List.of(Symbol):
  fun optional_vars(type_stx :: maybe(Syntax)) :: List.of(Symbol):
    match type_stx
    | #false: []
    | stx: collect_type_vars(stx :~ Syntax)
  fun binders_vars(bs :: List.of(CoreBinder)) :: List.of(Symbol):
    for values(acc :~ List = []) (b in bs):
      let binder :~ CoreBinder = b
      append_unique(
        acc,
        append_unique(pattern_vars(binder.pattern),
                      optional_vars(binder.type_stx)))
  fun pattern_vars(pat :: CorePattern) :: List.of(Symbol):
    match pat
    | CorePatVar(_, _): []
    | CorePatWildcard(_): []
    | CorePatCtor(_, args, _):
        for values(acc :~ List = []) (arg in args):
          append_unique(acc, pattern_vars(arg :~ CorePattern))
    | CorePatLiteral(_, _): []
    | CorePatTyped(inner, type_stx, _):
        append_unique(pattern_vars(inner), collect_type_vars(type_stx))
    | ~else: []
  fun matrix_vars(matrix :: CorePatternMatrix) :: List.of(Symbol):
    for values(acc :~ List = []) (row in matrix.rows):
      let row :~ CoreMatchRow = row
      let from_patterns:
        for values(out :~ List = []) (pat in row.patterns):
          append_unique(out, pattern_vars(pat :~ CorePattern))
      append_unique(
        acc, append_unique(from_patterns, body_vars(row.body)))
  fun body_vars(body :: CoreFunBody) :: List.of(Symbol):
    match body
    | CoreBodyExpr(inner): core_type_vars(inner)
    | CoreBodyLet(_, init, tail, _):
        append_unique(core_type_vars(init), body_vars(tail))
    | CoreBodyMatch(_, matrix, _): matrix_vars(matrix)
    | matrix :: CorePatternMatrix: matrix_vars(matrix)
    | ~else: []
  match expr
  | CoreRef(_, _): []
  | CoreGlobalRef(_, _): []
  | CoreCall(func, args, _):
      for values(acc :~ List = core_type_vars(func)) (a in args):
        append_unique(acc, core_type_vars(a))
  | CoreIf(c, t, e, _):
      append_unique(core_type_vars(c),
                    append_unique(core_type_vars(t), core_type_vars(e)))
  | CoreForall(bs, body, _):
      append_unique(binders_vars(bs), core_type_vars(body))
  | CoreNumeral(_, _): []
  | CoreExists(bs, body, _):
      append_unique(binders_vars(bs), core_type_vars(body))
  | CoreFunctionExpr(bs, result_type, body, _):
      append_unique(
        binders_vars(bs),
        append_unique(optional_vars(result_type), body_vars(body)))
  | CoreBlockExpr(body, _): body_vars(body)
  | CoreMatchExpr(scrutinee, matrix, _):
      append_unique(core_type_vars(scrutinee), matrix_vars(matrix))
  | CoreTypedExpr(inner, type_stx, _):
      append_unique(core_type_vars(inner), collect_type_vars(type_stx))
  | ~else: []


fun checked_sub_pattern(env :: ElabEnv,
                        pat :: CheckedPattern) :: List:
  match pat
  | CheckedPatWildcard(ty, _):
      [fresh_wildcard(resolve_type(env, ty)) :~ Term, {}]
  | CheckedPatVar(name, ty, _):
      let variable = mk_var(name, resolve_type(env, ty))
      [variable :~ Term, {name: variable :~ Term}]
  // Products are not declared datatypes, so retain their irrefutable binding
  // interpretation while using the checked component types.
  | CheckedPatCtor(name, _, _, ty, _) when name == c_pair:
      let root = fresh_wildcard(resolve_type(env, ty))
      [root :~ Term, bind_checked_irrefutable_pattern(env, pat, root)]
  | CheckedPatCtor(name, args, constructor_ty, _, at):
      let parsed:
        args.map(
          fun (arg :: CheckedPattern): checked_sub_pattern(env, arg))
      let subpats = parsed.map(fun (pair :: List): pair[0] :~ Term)
      let bindings:
        for values(out :~ Map = {}) (pair in parsed):
          merge_pattern_bindings(
            env.who, out, (pair :~ List)[1] :~ Map, at)
      [list_mk_comb(
         mk_const(name, resolve_type(env, constructor_ty)), subpats),
       bindings]
  | CheckedPatLiteral(value, ty, at):
      [elaborate_numeral(env, value, resolve_type(env, ty), at), {}]


class ClauseEnv(thy :: Theory,
                self_name :: maybe(Symbol),
                self :: maybe(Term),
                pats :: List.of(Term),
                vars :: Map.of(Symbol, Term),
                at :: Syntax,
                result_type :: HType,
                operators :: OverloadRegistry,
                type_constructors :: TypeConstructorRegistry,
                tyvars :: List.of(Symbol),
                datatypes :: Map.of(Symbol, DatatypeSpec),
                restricted_refs :: Map.of(Symbol, RefRestriction),
                inference :: CheckedInference)
fun clause_elab_env(env :: ClauseEnv) :: ElabEnv:
  ElabEnv(env.thy, env.tyvars, env.vars, #'function,
          env.self_name, env.self, env.operators,
          env.type_constructors, env.datatypes,
          env.restricted_refs, env.inference)



fun checked_parse_body(env :: ClauseEnv, body :: CheckedBody) :: List:
  match body
  | matrix :: CheckedPatternMatrix:
      checked_clause_rows(env, matrix)
  | CheckedBodyMatch(target, matrix, _, body_at):
      let name:
        match target
        | CheckedLocal(local_name, _, _): local_name
        | ~else:
            error(~who: #'checked_parse_body,
                  "checked clause refinement target is not local")
      let v = matched_var(env.vars, env.pats, name, body_at)
      checked_parse_clauses(env, v, matrix)
  | CheckedBodyLet(binding_pat, init, tail, _, body_at):
      let elab_env = clause_elab_env(env)
      let value = checked_to_term(elab_env, init)
      let bindings = bind_checked_irrefutable_pattern(
                       elab_env, binding_pat, value)
      let vars2 = env.vars ++ bindings
      let env2 = ClauseEnv(env.thy, env.self_name, env.self, env.pats,
                           vars2, env.at, env.result_type, env.operators,
                           env.type_constructors, env.tyvars, env.datatypes,
                           env.restricted_refs, env.inference)
      let clauses = checked_parse_body(env2, tail)
      for List (clause in clauses):
        let clause :~ DefClause = clause
        DefClause(clause.pats, List.cons(value, clause.terms))
  | CheckedBodyExpr(expr):
      let value = checked_to_term(clause_elab_env(env), expr)
      [DefClause(env.pats, [value])]
  | ~else:
      error(~who: #'checked_parse_body, "unknown CheckedBody variant")

fun checked_parse_clauses(env :: ClauseEnv, v :: FVar,
                          matrix :: CheckedPatternMatrix) :: List:
  recur loop (remaining :~ List = matrix.rows, acc :~ List = []):
    match remaining
    | []: acc
    | List.cons(row, rest):
        let parsed = checked_parse_clause(env, v, row :~ CheckedMatchRow)
        loop(rest, acc ++ parsed)

fun checked_parse_clause(env :: ClauseEnv, v :: FVar,
                         row :: CheckedMatchRow) :: List:
  let [source_pat] = row.patterns
  let [pat, bindings] = checked_sub_pattern(
                          clause_elab_env(env),
                          source_pat :~ CheckedPattern)
  let vars2 = env.vars ++ (bindings :~ Map)
  let env2 = ClauseEnv(env.thy, env.self_name, env.self,
                       refine_pats(env.pats, v, pat :~ Term),
                       vars2, env.at, env.result_type, env.operators,
                       env.type_constructors, env.tyvars, env.datatypes,
                       env.restricted_refs, env.inference)
  checked_parse_body(env2, row.body)

fun checked_clause_rows(env :: ClauseEnv,
                        matrix :: CheckedPatternMatrix) :: List:
  recur loop (remaining :~ List = matrix.rows, acc :~ List = []):
    match remaining
    | []: acc
    | List.cons(row, rest):
        let parsed = checked_clause_row(env, row :~ CheckedMatchRow)
        loop(rest, acc ++ parsed)

fun checked_clause_row(env :: ClauseEnv, row :: CheckedMatchRow) :: List:
  unless row.patterns.length() == env.pats.length()
  | error(~who: #'checked_clause_row,
          "checked clause arity differs from its function")
  let elab_env = clause_elab_env(env)
  let (pats2, local_bindings):
    for values(ps :~ List = env.pats, bindings :~ Map = {}) (
          col in List.iota(row.patterns.length())):
      let v :~ FVar:
        match ps[col]
        | FVar(_, _): ps[col]
        | ~else:
            error(~who: #'checked_clause_row,
                  "checked argument has already been matched")
      let [pat, bound] = checked_sub_pattern(
                           elab_env,
                           row.patterns[col] :~ CheckedPattern)
      values(
        refine_pats(ps, v, pat :~ Term),
        merge_pattern_bindings(
          #'function, bindings, bound :~ Map, row.at))
  let vars2 = env.vars ++ local_bindings
  let env2 = ClauseEnv(env.thy, env.self_name, env.self, pats2, vars2, env.at,
                       env.result_type, env.operators, env.type_constructors,
                       env.tyvars, env.datatypes, env.restricted_refs,
                       env.inference)
  checked_parse_body(env2, row.body)


fun local_pattern_variables(pat :: Term) :: List.of(FVar):
  match pat
  | variable :: FVar: [variable]
  | ~else:
      let (_, args) = strip_comb(pat)
      for values(out :~ List = []) (arg in args):
        out ++ local_pattern_variables(arg :~ Term)

fun check_local_function_clauses(clauses :: List.of(DefClause),
                                 result_type :: HType,
                                 at :: Syntax):
  for (clause in clauses):
    let clause :~ DefClause = clause
    unless type_of(clause_rhs(clause)) == result_type
    | syntax_error(
        #'function,
        "a local function body has a different type from its result type",
        at)
    let variables:
      for values(out :~ List = []) (pat in clause.pats):
        out ++ local_pattern_variables(pat :~ Term)
    recur distinct (remaining :~ List = variables,
                    seen :~ List = []):
      match remaining
      | []: #void
      | List.cons(variable, rest):
          when seen.contains(variable)
          | syntax_error(#'function,
                         "a local function pattern variable is repeated",
                         at)
          distinct(rest, List.cons(variable, seen))

fun local_tree_term(spec :: FunSpec,
                    datatypes :: Map.of(Symbol, DatatypeSpec),
                    args :: List.of(Term),
                    tree :: DecisionTree) :: Term:
  fun datatype_for(ty :: HType) :: DatatypeSpec:
    match ty
    | TyApp(name, _): datatypes[name]
    | ~else:
        error(~who: #'function,
              "internal local match on a non-datatype")
  match tree
  | DTLeaf(clause_index, bindings):
      let clause :~ DefClause = spec.clauses[clause_index]
      let substitutions:
        for values(out :~ Map = {}) (binding in bindings):
          let binding :~ DTBinding = binding
          out ++ {binding.var: path_term(datatype_for, args, binding.path)}
      inst_fvar(substitutions, eager_clause_term(clause))
  | DTSwitch(path, self_type, branches):
      let scrutinee = path_term(datatype_for, args, path)
      recur branch_term (remaining :~ List = branches):
        match remaining
        | [last]:
            local_tree_term(
              spec, datatypes, args, (last :~ DTBranch).tree)
        | List.cons(first, rest):
            let first :~ DTBranch = first
            let discriminator = mk_const(
                                  discriminator_name(first.ctor),
                                  mk_fun(self_type, bool))
            mk_cond(
              mk_comb(discriminator, scrutinee),
              local_tree_term(spec, datatypes, args, first.tree),
              branch_term(rest))
  | DTLiteralSwitch(path, branches, default):
      let scrutinee = path_term(datatype_for, args, path)
      recur branch_term (remaining :~ List = branches):
        match remaining
        | []: local_tree_term(spec, datatypes, args, default)
        | List.cons(first, rest):
            let first :~ DTLiteralBranch = first
            mk_cond(
              mk_eq(scrutinee, first.literal),
              local_tree_term(spec, datatypes, args, first.tree),
              branch_term(rest))
  | ~else:
      error(~who: #'function, "unknown local function decision-tree node")
fun checked_body_term(env :: ElabEnv, body :: CheckedBody) :: Term:
  match body
  | CheckedBodyExpr(expr):
      checked_to_term(env, expr)
  | CheckedBodyLet(pat, init, tail, _, _):
      let value = checked_to_term(env, init)
      let root = mk_var(
                   checked_pattern_root_name(pat, "_let"),
                   checked_pattern_ty(pat))
      let bindings = bind_checked_irrefutable_pattern(env, pat, root)
      let result = checked_body_term(
                     sub_env(env, env.vars ++ bindings), tail)
      mk_comb(mk_abs(resolve_term(env, root) :~ FVar,
                     resolve_term(env, result)),
              resolve_term(env, value))
  | CheckedBodyMatch(scrutinee, matrix, _, at):
      checked_match_term(env, scrutinee, matrix, at)
  | _ :: CheckedPatternMatrix:
      error(~who: #'checked_body_term,
            "checked function clauses are not an expression block")
  | ~else:
      error(~who: #'checked_body_term, "unknown CheckedBody variant")

fun checked_match_term(env :: ElabEnv,
                       scrutinee :: CheckedExpr,
                       matrix :: CheckedPatternMatrix,
                       at :: Syntax) :: Term:
  let scrutinee_term = checked_to_term(env, scrutinee)
  let root = mk_var(
               Symbol.gen("_match_scrutinee"), type_of(scrutinee_term))
  let result_type = resolve_type(env, matrix.ty)
  let clause_env = ClauseEnv(
                     env.thy, env.self_name, env.self,
                     [root :~ Term], env.vars, at, result_type,
                     env.operators, env.type_constructors, env.tyvars,
                     env.datatypes, env.restricted_refs, env.inference)
  let parsed = checked_clause_rows(clause_env, matrix)
  check_local_function_clauses(parsed, result_type, at)
  let local_name = Symbol.gen("_match_expression")
  let spec = FunSpec(
               local_name, [type_of(scrutinee_term)], result_type, parsed)
  let tree = compile_patterns(
               env.thy, env.who, local_name,
               parsed.map(fun (clause :: DefClause): clause.pats),
               env.datatypes,
               ~show_clause:
                 fun (_ :: Int): "match expression clause")
  let body_term = local_tree_term(
                    spec, env.datatypes, [root :~ Term], tree)
  mk_comb(mk_abs(root, body_term), scrutinee_term)

fun checked_function_clauses(
      env :: ElabEnv,
      fn :: CheckedFunction)
    :: values(List.of(FVar), HType, List.of(DefClause)):
  let parameter_vars:
    for List (binder in fn.params):
      let binder :~ CheckedBinder = binder
      mk_var(
        checked_pattern_root_name(binder.pat, "_parameter"),
        resolve_type(env, binder.ty))
  let local_bindings:
    for values(out :~ Map = {}) (binder in fn.params,
                                 variable in parameter_vars):
      let binder :~ CheckedBinder = binder
      merge_pattern_bindings(
        env.who, out,
        bind_checked_irrefutable_pattern(
          env, binder.pat, variable :~ Term),
        binder.at)
  let vars = env.vars ++ local_bindings
  let result_type = resolve_type(env, fn.result_ty)
  let clause_env = ClauseEnv(
                     env.thy, env.self_name, env.self,
                     parameter_vars.map(
                       fun (variable :: FVar): variable :~ Term),
                     vars, fn.at, result_type, env.operators,
                     env.type_constructors, env.tyvars, env.datatypes,
                     env.restricted_refs, env.inference)
  let clauses0 = checked_parse_body(clause_env, fn.body)
  let parameter_vars:
    parameter_vars.map(
      fun (variable :: FVar):
        resolve_term(env, variable) :~ FVar)
  let clauses:
    clauses0.map(
      fun (clause :: DefClause):
        DefClause(
          clause.pats.map(fun (pat :: Term): resolve_term(env, pat)),
          clause.terms.map(
            fun (term :: Term):
              resolve_term(env, term))))
  check_local_function_clauses(clauses, result_type, fn.at)
  values(parameter_vars, result_type, clauses)

fun checked_function_term(env :: ElabEnv,
                          fn :: CheckedFunction) :: Term:
  let (parameter_vars, result_type, clauses) = checked_function_clauses(
                                                  env, fn)
  let local_name = Symbol.gen("_local_function")
  let spec = FunSpec(
               local_name,
               parameter_vars.map(
                 fun (variable :: FVar): variable.ty),
               result_type, clauses)
  let tree = compile_patterns(
               env.thy, #'function, local_name,
               clauses.map(fun (clause :: DefClause): clause.pats),
               env.datatypes,
               ~show_clause:
                 fun (_ :: Int): "local function clause")
  let body_term = local_tree_term(
                    spec, env.datatypes,
                    parameter_vars.map(
                      fun (variable :: FVar): variable :~ Term),
                    tree)
  list_mk_abs(parameter_vars, body_term)



fun sub_env(env :: ElabEnv, vars :: Map.of(Symbol, Term)) :: ElabEnv:
  ElabEnv(env.thy, env.tyvars, vars, env.mode, env.self_name, env.self,
          env.operators, env.type_constructors, env.datatypes,
          env.restricted_refs, env.inference)


// ============================================================================
// quickcheck
// ============================================================================
//
// `quickcheck` uses the same parsed HOL proposition as `theorem`. Only its
// execution controls are parsed separately here.

export:
  quickcheck_options

// `[samples, size, seed]`. `~size` bounds generated value depth.
fun quickcheck_options(opts :: List.of(Syntax)) :: List:
  for values(acc :~ List = [100, 6, 20240904]) (o in opts):
    match o
    | '~samples: $(n :: Int)': [Syntax.unwrap(n), acc[1], acc[2]]
    | '~size: $(n :: Int)': [acc[0], Syntax.unwrap(n), acc[2]]
    | '~seed: $(n :: Int)': [acc[0], acc[1], Syntax.unwrap(n)]
    | ~else: syntax_error(#'quickcheck, "unknown option", o)
