#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// ACL2 hint handling is a design reference; see THIRD_PARTY_NOTICES.


// Reading the surface syntax into the logical world.
//
// This module only *analyses*: syntax in, kernel-level data out.  It builds no
// templates, because a syntax template created at phase 0 loses its bindings
// on the way out of a phase-1 macro -- `'def x = 1'` written here and returned
// from a macro reports `def: unbound identifier`.  Emission therefore lives in
// `module_block.rhm`; see the note at the top of `expand.rhm`.
//
// Everything here is called twice: once at expansion time, so that the runtime
// code can be generated, and once at phase 1, so that the logical declaration
// can be made.  Both go through the same functions on the same syntax, so the
// two views of a declaration cannot drift apart.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/datatype/datatype open
  rhombus/hol/datatype/algebra open
  rhombus/hol/recursion/recdef open
  rhombus/hol/recursion/dtree open
  rhombus/hol/number/literal open
  rhombus/hol/frontend/surface_core open
  rhombus/hol/logic/bool open
  rhombus/hol/frontend/tyunify open
  rhombus/hol/frontend/overload open
  rhombus/hol/frontend/type/registry open
  rhombus/hol/frontend/type/parse open
  rhombus/hol/effect/core open
  rhombus/hol/effect/core as effect
  rhombus/hol/effect/syntax open

// `?` is already one shrubbery operator token. A type variable is therefore
// parsed structurally as that operator followed by one identifier; no string
// splitting or keyword conversion is needed.

fun required_pattern_name(pat :: CorePattern, who :: Symbol,
                          message :: String) :: Symbol:
  match pat
  | CorePatVar(name, _): name
  | CorePatTyped(inner, _, _):
      required_pattern_name(inner, who, message)
  | ~else: syntax_error(who, message, pattern_at(pat))

fun optional_declared_type(type_stx :: maybe(Syntax),
                           tyvars :: List.of(Symbol),
                           registry :: TypeConstructorRegistry,
                           hint :: String) :: HType:
  match type_stx
  | #false: mk_tyvar(Symbol.gen(hint))
  | stx: parse_type(stx :~ Syntax, tyvars, registry)



// ============================================================================
// Function declarations
// ============================================================================
//
// The admissible shape is exactly what `recdef.rhm` can install:
//
//   function f(p1 :: T1, ..., pn :: Tn) :: T:
//     match pi
//     | C(v, ...): <expr>
//     | ...
//
// possibly with nested `match`es on further arguments, or a single-clause body
// with no `match` at all.
//
// The keyword is `function`, not `fun`.  Intercepting `fun` would mean deciding
// from the shape alone whether an ordinary Rhombus definition was meant to be a
// logical one -- and getting that wrong silently strips its annotations.  With
// a separate keyword the intent is explicit, so anything outside the grammar is
// an error naming the offending expression rather than a silent pass-through.

export:
  function_parts
  function_proof_measure
  row_parts

// A declaration split into its parts:
// `[name, [param, ...], result_type, body, clauses]`. Exactly one of `body`
// (a plain expression body) and `clauses` (a clausal `| pat: expr` form's
// rows) is `#false`. The declaration macro calls this once, then both the
// executable and logical paths consume its encoded `CoreFunctionSpec`.
// Raises, with the offending syntax, when the declaration is not one this
// version can admit.
fun function_parts(stx :: Syntax) :: List:
  match stx
  | 'function $(name :: Identifier)($param, ...) $rest ...':
      let [rty, body, clauses] = split_signature('$rest ...', stx)
      [name, [param, ...], rty, body, clauses]
  | 'function $(name :: Identifier)
     | $c
     | ...':
      [name, #false, #false, #false, [c, ...]]
  | ~else:
      syntax_error(#'function,
                   "expected a named function declaration",
                   stx)

// `:: Type: body`, or the clausal form `:: Type | (pat, ...): body | ...`
// -- see `clause_rows`. Returns `[result_type, body_or_false,
// clauses_or_false]`; exactly one of the last two is present.
fun split_signature(rest :: Syntax, at :: Syntax) :: List:
  match rest
  | ':: $ty ... ~measure($m): $body; ...':
      syntax_error(
        #'function,
        "`~measure(...)` must be written in an adjacent `proof:` block as `~measure: expression`",
        m)
  | ':: $ty ... ~measure($m)
     | $c
     | ...':
      syntax_error(
        #'function,
        "`~measure(...)` must be written in an adjacent `proof:` block as `~measure: expression`",
        m)
  | ':: $ty ...: $body; ...': ['$ty ...', '$body; ...', #false]
  | ':: $ty ...
     | $c
     | ...': ['$ty ...', #false, [c, ...]]
  | ': $body; ...': [#false, '$body; ...', #false]
  | '| $c | ...': [#false, #false, [c, ...]]
  | ~else:
      syntax_error(#'function, "malformed function body", at)



// A function proof currently supplies exactly one termination measure. Keeping
// this parser separate from theorem tactics makes options context-sensitive:
// theorem hints cannot silently become function hints or vice versa.
fun function_proof_measure(groups :: List.of(Syntax), at :: Syntax) :: Syntax:
  recur loop (remaining :~ List = groups,
              measure :~ maybe(Syntax) = #false):
    match remaining
    | []:
        match measure
        | #false:
            syntax_error(
              #'proof,
              "a function proof needs one `~measure: expression` option",
              at)
        | value: value :~ Syntax
    | List.cons(group, rest):
        let rest :~ List = rest
        match group
        | '~measure: $expr':
            match measure
            | #false: loop(rest, expr)
            | ~else:
                syntax_error(#'proof, "duplicate `~measure` option", group)
        | '~measure: $more; ...':
            syntax_error(#'proof, "`~measure` expects one expression", group)
        | ~else:
            syntax_error(#'proof, "unknown function proof option", group)



fun fresh_wildcard(ty :: HType) :: FVar:
  mk_var(Symbol.gen("_wild"), ty)
fun peel_fun(ty :: HType, n :: Int) :: values(List.of(HType), HType):
  recur loop (ty :~ HType = ty, k = n, acc :~ List = []):
    cond
    | k == 0: values(acc.reverse(), ty)
    | ~else:
        let (d, r) = dest_fun(ty)
        loop(r, k - 1, List.cons(d, acc))

// Reify eager initializer evaluation as beta-redexes when a clause is used
// inside a lambda or expression-level match. The logical normal form remains
// the clause RHS, while recursive-call traversal still sees every initializer.
fun eager_clause_term(c :: DefClause) :: Term:
  recur loop (remaining :~ List.of(Term) = c.obligations):
    match remaining
    | []: c.rhs
    | [_]: c.rhs
    | List.cons(initializer, rest):
        let initializer :~ Term = initializer
        let ignored = mk_var(Symbol.gen("_eager"), type_of(initializer))
        mk_comb(mk_abs(ignored, loop(rest)), initializer)


// `(pat, ...): body`, or `pat: body` when there is exactly one argument.
fun row_parts(c :: Syntax, arity :: Int) :: values(List.of(Syntax), Syntax):
  match c
  | '($p, ...): $body; ...':
      let ps = [p, ...]
      unless ps.length() == arity
      | syntax_error(#'function,
                     "this clause has " ++ to_string(ps.length())
                       ++ " patterns but the function takes "
                       ++ to_string(arity),
                     c)
      values(ps, '$body; ...')
  | '$pt ...: $body; ...':
      let p = '$pt ...'
      // One argument may drop the parentheses, exactly as a one-argument
      // `match` clause does.
      unless arity == 1
      | syntax_error(#'function,
                     "this clause has 1 pattern but the function takes "
                       ++ to_string(arity),
                     c)
      values([p], '$body; ...')
  | ~else:
      syntax_error(#'function,
                   "expected `(pattern, ...): body`", c)

// The pattern variable a `match` refines: `n` must name something still a
// *live*, unrefined position somewhere in `pats` -- a top-level parameter
// not yet matched, or a variable an enclosing pattern in this same clause
// just bound.  Refusing anything else catches every way `n` could fail to
// denote a fresh scrutinee: unbound entirely, already matched (its own name
// lingers in `env` after refinement, since `env` only ever grows), or bound
// by `let` to a computed term rather than a pattern position (matching on a
// computed value has no constructor test to check exhaustively against).
//
// A pattern variable may shadow a parameter -- `function f(n)` with a clause
// `succ(n)` -- and without checking liveness in `pats` (not just presence in
// `env`) a nested `match n` after that would look like a fresh match on the
// now-inaccessible outer `n` and silently refine nothing.
fun matched_var(env :: Map.of(Symbol, Term), pats :: List.of(Term),
                n :: Symbol, at :: Syntax) :: FVar:
  match env.get(n, #false)
  | #false:
      syntax_error(#'function, "the matched name is not in scope", at)
  | v when !(v is_a FVar):
      syntax_error(#'function,
                   "this name is not a pattern variable to match on", at)
  | v0:
      let v :~ FVar = v0
      unless pattern_var_live(pats, v)
      | syntax_error(#'function,
                     "this argument has already been matched; a nested "
                       ++ "`match` must be on a still-unmatched variable",
                     at)
      v

// Whether `v` occurs, unrefined, somewhere in `pats`'s pattern trees.
fun pattern_var_live(pats :: List.of(Term), v :: FVar) :: Boolean:
  fun walk(t :: Term) :: Boolean:
    match t
    | FVar(_, _): t == (v :~ Term)
    | ~else:
        let (head, args) = strip_comb(t)
        match head
        | Const(_, _): for any (a in args): walk(a)
        | ~else: #false
  for any (p in pats): walk(p)

// `pats` with the one live occurrence of `v` replaced by `new_pat`.
fun refine_pats(pats :: List.of(Term), v :: FVar,
                new_pat :: Term) :: List.of(Term):
  fun walk(t :: Term) :: Term:
    match t
    | FVar(_, _): (if t == (v :~ Term) | new_pat | t)
    | ~else:
        let (head, args) = strip_comb(t)
        match head
        | Const(_, _): list_mk_comb(head, args.map(walk))
        | ~else: t
  pats.map(walk)


// ============================================================================
// Core elaboration
// ============================================================================
//
// Surface enforestation has already resolved precedence, associativity, and
// extension bindings. This module resolves names and types against a Theory.

export:
  parse_core_prop
  elaborate_theorem_statement
  elaborate_function_decl
  core_type_vars
  parse_tactic
  ElabEnv
  RefRestriction
  elaborate_effect
  parse_type_effect
  run_type_elaboration
  infer_core
  check_core
  run_elaboration
  run_checked_elaboration
// `self_name` and `self` are the definition being elaborated, so that a
// recursive call resolves before the constant exists in the theory.  In
// `#'prop` mode there is no such definition and both are `#false`.
class RefRestriction(message :: String, block_global :: Boolean)

class ElabEnv(thy :: Theory,
              tyvars :: List.of(Symbol),
              vars :: Map.of(Symbol, Term),
              mode :: Symbol,
              self_name :: maybe(Symbol),
              self :: maybe(Term),
              operators :: OverloadRegistry = standard_overload_registry(),
              type_constructors :: TypeConstructorRegistry = standard_type_constructor_registry(),
              datatypes :: Map.of(Symbol, DatatypeSpec) = {},
              restricted_refs :: Map.of(Symbol, RefRestriction) = {},
              inference :: Box = Box({})):
  property who :: Symbol:
    cond
    | mode == #'definition: #'definition
    | mode == #'prop: #'theorem
    | ~else: #'function

  reader_effect

fun current_substitution(env :: ElabEnv) :: Map.of(Symbol, HType):
  env.inference.value :~ Map

// Unifying two still-open metavariables binds one to the other before
// either resolves to something concrete, so a single-level `type_subst`
// can leave a stale intermediate variable in the result.
// `deep_resolve` (tyunify.rhm) chases each variable to a fixed point; this
// closes every chain in `theta` at once, safe to hand to the ordinary
// (single-level) `type_subst`/`inst_type`.
fun close_substitution(theta :: Map.of(Symbol, HType))
     :: Map.of(Symbol, HType):
  for values(out :~ Map = {}) ((name, ty) in theta):
    out ++ {name: deep_resolve(theta, ty :~ HType, [])}

fun resolve_type(env :: ElabEnv, ty :: HType) :: HType:
  deep_resolve(current_substitution(env), ty, [])

fun resolve_term(env :: ElabEnv, term :: Term) :: Term:
  inst_type(close_substitution(current_substitution(env)), term)

fun unify_types(env :: ElabEnv, left :: HType, right :: HType,
                at :: Syntax, message :: String):
  match type_unify(resolve_type(env, left), resolve_type(env, right),
                   current_substitution(env))
  | #false: syntax_error(env.who, message, at)
  | substitution:
      env.inference.value := substitution

fun reject_restricted_reference(env :: ElabEnv, name :: Symbol,
                                at :: Syntax, before_global :: Boolean):
  match env.restricted_refs.get(name, #false)
  | restriction :: RefRestriction when restriction.block_global || !before_global:
      syntax_error(env.who, restriction.message, at)
  | ~else: #void

fun blocks_global_reference(env :: ElabEnv, name :: Symbol) :: Boolean:
  match env.restricted_refs.get(name, #false)
  | restriction :: RefRestriction: restriction.block_global
  | ~else: #false

// -- CoreExpr elaboration ----------------------------------------------------

fun core_const_instance(env :: ElabEnv, name :: Symbol,
                        args :: List.of(Term), at :: Syntax) :: HType:
  reject_restricted_reference(env, name, at, #true)
  let generic = (match const_type(env.thy, name)
                 | #false:
                     reject_restricted_reference(env, name, at, #false)
                     syntax_error(env.who, "unknown constant", at)
                 | t: t)
  // A constant's type variables are schematic. Freshen them before
  // unification so a surrounding theorem variable with the same printed name
  // cannot fail the occurs check (for example, equality on `List.of(?a)`).
  let renaming:
    for values(m :~ Map = {}) (v in type_vars(generic)):
      m ++ {v: mk_tyvar(Symbol.gen(to_string(v))) :~ HType}
  let gty = type_subst(renaming, generic)
  let res = mk_tyvar(Symbol.gen("_result"))
  let want = for values(ty :~ HType = res) (a in args.reverse()):
               mk_fun(type_of(a), ty)
  match type_unify(resolve_type(env, gty), resolve_type(env, want),
                   current_substitution(env))
  | #false:
      syntax_error(env.who,
                   "constant is applied at a type it does not have",
                   at)
  | sub:
      env.inference.value := sub
      resolve_type(env, gty)

fun core_lookup(env :: ElabEnv, n :: Symbol, at :: Syntax) :: Term:
  match env.vars.get(n, #false)
  | #false:
      reject_restricted_reference(env, n, at, #true)
      cond
      | n == env.self_name:
          resolve_term(env, env.self :~ Term)
      | ~else: mk_const(n, core_const_instance(env, n, [], at))
  | v: resolve_term(env, v :~ Term)

fun core_global_lookup(env :: ElabEnv, n :: Symbol, at :: Syntax) :: Term:
  mk_const(n, core_const_instance(env, n, [], at))

// Specialize phantom type variables in already-elaborated arguments from the
// function domains selected by unification. This is needed for expressions
// such as `left(x) === left(y)`: each `left` initially has an independent
// unconstrained right-hand sum parameter.
fun specialize_call_args(fty :: HType, args :: List.of(Term)) :: List.of(Term):
  recur loop (ty :~ HType = fty, rest :~ List.of(Term) = args,
              acc :~ List.of(Term) = []):
    match rest
    | []: acc
    | List.cons(arg, more):
        let (domain, range) = dest_fun(ty)
        let arg2:
          cond
          | type_of(arg) == domain: arg
          | ~else:
              match type_match(type_of(arg), domain, {})
              | #false: arg
              | theta: inst_type(theta :~ Map, arg)
        loop(range, more, acc ++ [arg2])


fun core_location(expr :: CoreExpr) :: Syntax:
  match expr
  | CoreRef(_, at): at
  | CoreGlobalRef(_, at): at
  | CoreCall(_, _, at): at
  | CoreNumeral(_, at): at
  | CoreIf(_, _, _, at): at
  | CoreForall(_, _, at): at
  | CoreExists(_, _, at): at
  | CoreFunctionExpr(_, _, _, at): at
  | CoreBlockExpr(_, at): at
  | CoreMatchExpr(_, _, at): at
  | CoreTypedExpr(_, _, at): at
  | ~else: error(~who: #'elaborate, "unknown CoreExpr variant")

fun core_apply_effect(func :: CoreExpr, args :: List.of(CoreExpr),
                      at :: Syntax,
                      ~expected: expected :: maybe(HType) = #false)
     :: Computation:
  // Discover the full application shape before elaborating operands. This
  // lets an expected result type refine polymorphic domains first; operands
  // such as numerals can then receive the concrete type they require.
  fun application_types(env :: ElabEnv, head :: Term)
      :: values(List.of(HType), HType):
    for values(domains :~ List.of(HType) = [],
               current :~ HType = type_of(head)) (_arg in args):
      let current = resolve_type(env, current)
      when current is_a TyVar
      | let domain = mk_tyvar(Symbol.gen("_domain"))
        let range = mk_tyvar(Symbol.gen("_range"))
        unify_types(
          env, current, mk_fun(domain, range), at,
          "the applied expression is not a function")
      let current = resolve_type(env, current)
      unless is_fun(current)
      | syntax_error(
          env.who, "the applied expression is not a function", at)
      let (domain, range) = dest_fun(current)
      values(domains ++ [domain], range)
  fun replace(xs :: List, index :: Int, value) :: List:
    for List (x in xs, k in List.iota(xs.length())):
      (if k == index | value | x)
  fun apply_arguments(head :: Term) :: Computation:
    effect:
      let env :: ElabEnv <- ElabEnv.ask()
      let (domains, result_type) = application_types(env, head)
      match expected
      | #false: #void
      | wanted:
          unify_types(
            env, result_type, wanted :~ HType, at,
            "expression has an unexpected type")
      fun fit(arg :: CoreExpr, domain :: HType,
              operand :: Term) :: Void:
        unify_types(
          env, domain, type_of(operand), core_location(arg),
          "operand type does not match function domain")
      recur scan (remaining :~ List = args,
                  index = 0,
                  operands :~ List = [],
                  deferred :~ List = []):
        match remaining
        | []:
            recur fill (pending :~ List = deferred,
                        out :~ List = operands):
              match pending
              | []:
                  return for values(term :~ Term = resolve_term(env, head)) (
                               operand in out):
                    mk_comb(
                      resolve_term(env, term),
                      resolve_term(env, operand :~ Term))
              | List.cons(i, more):
                  let arg = args[i] :~ CoreExpr
                  let domain = resolve_type(env, domains[i] :~ HType)
                  effect:
                    let operand :: Term <- check_core(arg, domain)
                    fit(arg, domain, operand)
                    fill(more, replace(out, i :~ Int, operand))
        | List.cons(arg, more):
            let domain = resolve_type(env, domains[index] :~ HType)
            cond
            | requires_expected_type(arg :~ CoreExpr, env.operators)
                && domain is_a TyVar:
                scan(more, index + 1, operands ++ [#false],
                     deferred ++ [index])
            | ~else:
                effect:
                  let operand :: Term <- check_core(arg :~ CoreExpr, domain)
                  fit(arg :~ CoreExpr, domain, operand)
                  scan(more, index + 1, operands ++ [operand], deferred)
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    match func
    | CoreRef(name, _) when !env.vars.get(name, #false)
                              && name != env.self_name
                              && !blocks_global_reference(env, name)
                              && !const_type(env.thy, name)
                              && overload_arity(env.operators, name) != #false:
        elaborate_overload_effect(name, args, at, ~expected: expected)
    | ~else:
        effect:
          let head :: Term <- infer_core(func)
          apply_arguments(head)
fun elaborate_non_numerals_effect(args :: List.of(CoreExpr)) :: Computation:
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    recur loop (remaining :~ List = args, terms :~ List = []):
      match remaining
      | []: return terms
      | List.cons(first, rest):
          cond
          | requires_expected_type(first :~ CoreExpr, env.operators):
              loop(rest, terms ++ [#false])
          | ~else:
              effect:
                let term :: Term <- elaborate_effect(first :~ CoreExpr)
                loop(rest, terms ++ [term])

fun overload_signature(method :: OverloadMethod,
                       registry :: TypeConstructorRegistry) :: String:
  String.join(
    method.argument_types.map(
      fun (type): type_to_surface_string(registry, type)),
    " * ")
    ++ " -> " ++ type_to_surface_string(registry, method.result_type)
    ++ " via " ++ to_string(method.constant)

fun specialize_overload_term(term :: Term, expected :: HType) :: Term:
  cond
  | type_of(term) == expected: term
  | ~else:
      match type_match(type_of(term), expected, {})
      | #false: term
      | theta: inst_type(theta :~ Map, term)

fun numeral_apply(env :: ElabEnv, name :: Symbol,
                  args :: List.of(Term), at :: Syntax) :: Term:
  let cty = core_const_instance(env, name, args, at)
  list_mk_comb(mk_const(name, cty), specialize_call_args(cty, args))

// The kernel stores a checked natural literal compactly. Its conversion API
// exposes `zero`/`succ` only when a proof needs one step, so elaboration never
// constructs an arithmetic-depth term.
fun nat_numeral(env :: ElabEnv, value :: NonnegInt, _at :: Syntax) :: Term:
  mk_nat_lit(env.thy, value)

fun elaborate_numeral(env :: ElabEnv, value :: NonnegInt,
                      expected :: HType, at :: Syntax) :: Term:
  cond
  | expected == mk_tyapp(#'Nat, []): nat_numeral(env, value, at)
  | expected == mk_tyapp(#'Integer, []):
      numeral_apply(env, #'int_from_nat, [nat_numeral(env, value, at)], at)
  | expected == mk_tyapp(#'Rational, []):
      let integer = numeral_apply(
                      env, #'int_from_nat,
                      [nat_numeral(env, value, at)], at)
      numeral_apply(env, #'rational_from_integer, [integer], at)
  | ~else:
      syntax_error(
        env.who,
        "a numeral has no representation at type "
          ++ type_to_surface_string(env.type_constructors, expected),
        at)

fun elaborate_overload_effect(function_name :: Symbol,
                              args :: List.of(CoreExpr),
                              at :: Syntax,
                              ~expected: expected_result :: maybe(HType) = #false)
     :: Computation:
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    let arity = overload_arity(env.operators, function_name)
    unless arity
    | syntax_error(env.who,
                   "unknown overload function " ++ to_string(function_name),
                   at)
    let arity :~ NonnegInt = arity
    unless args.length() == arity
    | syntax_error(env.who,
                   "`" ++ to_string(function_name) ++ "` expects "
                     ++ to_string(arity) ++ " arguments",
                   at)
    let known :: List <- elaborate_non_numerals_effect(args)
    let argument_types:
      known.map(
        fun (term):
          match term
          | #false: #false
          | value: resolve_type(env, type_of(value :~ Term)))
    let resolved_expected:
      match expected_result
      | #false: #false
      | wanted: resolve_type(env, wanted :~ HType)
    let matches = resolve_overload(
                    env.operators, function_name,
                    argument_types, resolved_expected)
    when matches.length() == 0
    | let signatures = overload_candidates(env.operators, function_name).map(
                         fun (method :: OverloadMethod):
                           overload_signature(method, env.type_constructors))
      syntax_error(
        env.who,
        "`" ++ to_string(function_name) ++ "` has no applicable overload"
          ++ (if signatures.length() == 0
              | ""
              | "\navailable methods:\n  "
                  ++ String.join(signatures, "\n  ")),
        at)
    when matches.length() > 1
    | let signatures = matches.map(
                         fun (resolution :: OverloadResolution):
                           overload_signature(
                             resolution.method, env.type_constructors))
      syntax_error(env.who,
                   "`" ++ to_string(function_name) ++ "` has ambiguous overload"
                     ++ "\ncandidates:\n  "
                     ++ String.join(signatures, "\n  "),
                   at)
    let resolution :~ OverloadResolution = matches[0]
    // A placeholder argument -- one whose type only the selected method can
    // supply -- is `#false` here, and `#false` matches a bare pattern
    // variable, so the `#false` case has to come first or it is dead code
    // and `type_of` is handed a non-term.
    for (term in known, expected_type in resolution.argument_types):
      match term
      | #false: #void
      | value:
          unify_types(
            env, type_of(value :~ Term), expected_type :~ HType, at,
            "overload operand type does not match the selected method")
    match expected_result
    | #false: #void
    | wanted:
        unify_types(
          env, resolution.result_type, wanted :~ HType, at,
          "overload result type does not match the expected type")
    let method = resolution.method
    fun finish(index :: NonnegInt,
               out :: List.of(Term)) :: Computation:
      cond
      | index == args.length(): return out
      | ~else:
          match known[index]
          | #false:
              effect:
                let term :: Term <- check_core(
                                     args[index] :~ CoreExpr,
                                     resolution.argument_types[index])
                finish(index + 1, out ++ [term])
          | term:
              finish(
                index + 1,
                out ++ [specialize_overload_term(
                          term :~ Term,
                          resolution.argument_types[index])])
    let terms :: List.of(Term) <- finish(0, [])
    let ordered = method.argument_order.map(
                    fun (index): terms[index] :~ Term)
    return resolve_term(
             env, numeral_apply(env, method.constant, ordered, at))


fun pattern_root_name(pat :: CorePattern, hint :: String) :: Symbol:
  match pat
  | CorePatVar(name, _): name
  | CorePatTyped(inner, _, _):
      pattern_root_name(inner, hint)
  | ~else: Symbol.gen(hint)

fun merge_pattern_bindings(who :: Symbol,
                           left :: Map.of(Symbol, Term),
                           right :: Map.of(Symbol, Term),
                           at :: Syntax) :: Map.of(Symbol, Term):
  for values(out :~ Map = left) ((name, value) in right):
    when out.get(name, #false)
    | syntax_error(
        who, "a binding pattern repeats `" ++ to_string(name) ++ "`", at)
    out ++ {name: value :~ Term}

fun single_constructor(env :: ElabEnv, name :: Symbol, at :: Syntax) :: List:
  let matches:
    for values(out :~ List = []) ((_, spec) in env.datatypes):
      let spec :~ DatatypeSpec = spec
      let constructors:
        for values(found :~ List = []) (ctor in spec.ctors):
          let ctor :~ Ctor = ctor
          (if ctor.name == name | found ++ [ctor] | found)
      match constructors
      | [ctor] when spec.ctors.length() == 1:
          out ++ [[spec, ctor]]
      | _: out
  match matches
  | [entry]: entry :~ List
  | ~else:
      syntax_error(
        env.who,
        "a binder accepts only irrefutable patterns; `" ++ to_string(name)
          ++ "` is not the sole constructor of its datatype",
        at)

fun bind_irrefutable_pattern(env :: ElabEnv, pat :: CorePattern,
                             value :: Term) :: Map.of(Symbol, Term):
  match pat
  | CorePatWildcard(_): {}
  | CorePatVar(name, _): {name: value}
  | CorePatTyped(inner, type_stx, at):
      let annotated = parse_type(
                        type_stx, env.tyvars, env.type_constructors)
      unify_types(
        env, type_of(value), annotated, at,
        "a binding pattern annotation does not match its value")
      bind_irrefutable_pattern(env, inner, resolve_term(env, value))
  | CorePatCtor(name, args, at) when name == c_pair:
      unless args.length() == 2
      | syntax_error(
          env.who, "a Pair pattern needs exactly two fields", at)
      let first = args[0] :~ CorePattern
      let second = args[1] :~ CorePattern
      let current = resolve_type(env, type_of(value))
      when current is_a TyVar
      | let first_type = mk_tyvar(Symbol.gen("_pair_first"))
        let second_type = mk_tyvar(Symbol.gen("_pair_second"))
        unify_types(
          env, current, prod_ty(first_type, second_type), at,
          "a Pair binding pattern needs a `Pair.of(...)` value")
      let resolved = resolve_term(env, value)
      let first_bindings = bind_irrefutable_pattern(
                             env, first, mk_fst(resolved))
      let second_bindings = bind_irrefutable_pattern(
                              env, second, mk_snd(resolved))
      merge_pattern_bindings(env.who, first_bindings, second_bindings, at)
  | CorePatCtor(name, args, at):
      let [_spec, ctor] = single_constructor(env, name, at)
      let ctor :~ Ctor = ctor
      unless args.length() == ctor.fields.length()
      | syntax_error(
          env.who, "constructor pattern has the wrong number of fields", at)
      let constructor_type = core_const_instance(env, name, [], at)
      let (field_types, result_type) = peel_fun(
                                         constructor_type, args.length())
      unify_types(
        env, type_of(value), result_type, at,
        "constructor pattern does not match the bound value type")
      let resolved_value = resolve_term(env, value)
      let parsed:
        for List (arg in args, field in ctor.fields,
                  field_type in field_types):
          let selector_type = mk_fun(
                                type_of(resolved_value),
                                resolve_type(env, field_type :~ HType))
          let selected = mk_comb(
                           mk_const(
                             selector_name(ctor, field :~ Field),
                             selector_type),
                           resolved_value)
          bind_irrefutable_pattern(env, arg :~ CorePattern, selected)
      for values(out :~ Map = {}) (bindings in parsed):
        merge_pattern_bindings(
          env.who, out, bindings :~ Map, at)
  | CorePatLiteral(_, at):
      syntax_error(
        env.who, "a literal pattern is refutable and cannot bind here", at)

fun elaborate_binders_effect(binders :: List.of(CoreBinder), body :: CoreExpr,
                             is_forall :: Boolean) :: Computation:
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    let variables:
      for List (binder in binders):
        let binder :~ CoreBinder = binder
        mk_var(
          pattern_root_name(binder.pattern, "_bound"),
          optional_declared_type(
            binder.type_stx, env.tyvars, env.type_constructors, "_bound"))
    let local_bindings:
      for values(out :~ Map = {}) (binder in binders,
                                   variable in variables):
        let binder :~ CoreBinder = binder
        merge_pattern_bindings(
          env.who, out,
          bind_irrefutable_pattern(
            env, binder.pattern, variable :~ Term),
          binder.at)
    let inner :: Term <- ElabEnv.local(
                         fun (_):
                           sub_env(env, env.vars ++ local_bindings),
                         check_core(body, bool))
    let resolved_inner = resolve_term(env, inner)
    let resolved_variables:
      variables.map(
        fun (variable :: FVar):
          resolve_term(env, variable) :~ FVar)
    let build = (if is_forall | mk_forall | mk_exists)
    return for values(term :~ Term = resolved_inner) (variable in resolved_variables.reverse()):
             build(variable :~ FVar, term)

fun elaborate_if_effect(condition_expr :: CoreExpr, then_expr :: CoreExpr,
                        else_expr :: CoreExpr, at :: Syntax) :: Computation:
  effect:
    let condition :: Term <- elaborate_effect(condition_expr)
    let env :: ElabEnv <- ElabEnv.ask()
    unless type_of(condition) == bool
    | syntax_error(env.who, "the condition of an `if` must be a Boolean", at)
    let then_term :: Term <- elaborate_effect(then_expr)
    let else_term :: Term <- elaborate_effect(else_expr)
    unless type_of(then_term) == type_of(else_term)
    | syntax_error(env.who,
                   "the two branches of an `if` have different types",
                   at)
    return mk_cond(condition, then_term, else_term)

fun elaborate_effect(expr :: CoreExpr) :: Computation:
  match expr
  | CoreRef(name, at):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        return core_lookup(env, name, at)
  | CoreGlobalRef(name, at):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        return core_global_lookup(env, name, at)
  | CoreCall(func, args, at): core_apply_effect(func, args, at)
  | CoreNumeral(_, at):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        syntax_error(env.who,
                     "a numeral needs an expected numeric type from an operator",
                     at)
  | CoreIf(condition_expr, then_expr, else_expr, at):
      elaborate_if_effect(condition_expr, then_expr, else_expr, at)
  | CoreForall(binders, body, _):
      elaborate_binders_effect(binders, body, #true)
  | CoreExists(binders, body, _):
      elaborate_binders_effect(binders, body, #false)
  | CoreFunctionExpr(params, result_type, body, at):
      elaborate_function_expr_effect(params, result_type, body, at)
  | CoreTypedExpr(inner, type_stx, _):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        let annotated = parse_type(
                          type_stx, env.tyvars,
                          env.type_constructors)
        check_core(inner, annotated)
  | CoreBlockExpr(body, _):
      elaborate_body_effect(body, #false)
  | CoreMatchExpr(scrutinee, clauses, at):
      elaborate_match_expr_effect(
        scrutinee, clauses, at, #false)
  | ~else: error(~who: #'elaborate_effect, "unknown CoreExpr variant")

// Domain operations expose inference and checking without leaking Reader,
// State, or Fail into callers. `type_unify` installs its State/Fail handlers
// locally while Reader remains ambient to this expression computation.
fun infer_core(expr :: CoreExpr) :: Computation:
  elaborate_effect(expr)

fun requires_expected_type(
      expr :: CoreExpr,
      operators :: maybe(OverloadRegistry) = #false) :: Boolean:
  fun any_arg(args :: List.of(CoreExpr)) :: Boolean:
    for values(found = #false) (arg in args):
      found || requires_expected_type(arg :~ CoreExpr, operators)
  match expr
  | CoreNumeral(_, _): #true
  | CoreTypedExpr(_, _, _): #false
  | CoreGlobalRef(_, _): #false
  | CoreCall(CoreRef(name, _), args, _):
      any_arg(args)
        || (args.length() == 0
              && operators
              && overload_arity(
                   operators :~ OverloadRegistry, name) != #false)
  | CoreCall(_, args, _): any_arg(args)
  | CoreIf(_, then_expr, else_expr, _):
      requires_expected_type(then_expr, operators)
        || requires_expected_type(else_expr, operators)
  | ~else: #false

fun check_core(expr :: CoreExpr, expected :: HType) :: Computation:
  fun finish(term :: Term) :: Computation:
    effect:
      let env :: ElabEnv <- ElabEnv.ask()
      unify_types(
        env, type_of(term), expected, core_location(expr),
        "expression has an unexpected type")
      return resolve_term(env, term)
  match expr
  | CoreFunctionExpr(params, result_type, body, at):
      elaborate_function_expr_effect(
        params, result_type, body, at, ~expected: expected)
  | CoreNumeral(value, at):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        let wanted = resolve_type(env, expected)
        when wanted is_a TyVar
        | syntax_error(
            env.who,
            "a numeral needs a type ascription or an unambiguous numeric context",
            at)
        return elaborate_numeral(env, value, wanted, at)
  | CoreBlockExpr(body, _):
      elaborate_body_effect(body, expected)
  | CoreMatchExpr(scrutinee, clauses, at):
      elaborate_match_expr_effect(
        scrutinee, clauses, at, expected)
  | CoreCall(func, args, at):
      core_apply_effect(func, args, at, ~expected: expected)
  | CoreIf(condition_expr, then_expr, else_expr, at):
      effect:
        let condition :: Term <- check_core(condition_expr, bool)
        let then_term :: Term <- check_core(then_expr, expected)
        let else_term :: Term <- check_core(else_expr, expected)
        let env :: ElabEnv <- ElabEnv.ask()
        return mk_cond(resolve_term(env, condition),
                       resolve_term(env, then_term),
                       resolve_term(env, else_term))
  | ~else:
      effect:
        let term :: Term <- infer_core(expr)
        finish(term)

fun run_elaboration(env :: ElabEnv, expr :: CoreExpr) :: Term:
  match ElabEnv.handle(env, infer_core(expr))
  | Pure(term): resolve_term(env, term :~ Term)
  | ~else: error(~who: #'run_elaboration, "internal error: unhandled effect")

fun run_checked_elaboration(env :: ElabEnv, expr :: CoreExpr,
                            expected :: HType) :: Term:
  match ElabEnv.handle(env, check_core(expr, expected))
  | Pure(term): resolve_term(env, term :~ Term)
  | ~else:
      error(~who: #'run_checked_elaboration,
            "internal error: unhandled effect")

fun parse_type_effect(stx :: Syntax) :: Computation:
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    return parse_type(stx, env.tyvars, env.type_constructors)

fun run_type_elaboration(env :: ElabEnv, stx :: Syntax) :: HType:
  match ElabEnv.handle(env, parse_type_effect(stx))
  | Pure(ty): ty :~ HType
  | ~else: error(~who: #'run_type_elaboration, "internal error: unhandled effect")

fun parse_core_prop(
      thy :: Theory, tyvars :: List.of(Symbol),
      vars :: Map.of(Symbol, Term), expr :: CoreExpr,
      ~operators: operators :: OverloadRegistry = standard_overload_registry(),
      ~type_constructors: type_constructors :: TypeConstructorRegistry = standard_type_constructor_registry(),
      ~datatypes: datatypes :: Map.of(Symbol, DatatypeSpec) = {})
     :: Term:
  run_elaboration(ElabEnv(thy, tyvars, vars, #'prop, #false, #false,
                          operators, type_constructors, datatypes), expr)

fun append_unique(base :: List.of(Symbol),
                  more :: List.of(Symbol)) :: List.of(Symbol):
  for values(acc :~ List = base) (n in more):
    (if acc.contains(n) | acc | acc ++ [n])

fun core_type_vars(expr :: CoreExpr) :: List.of(Symbol):
  fun optional_vars(type_stx :: maybe(Syntax)) :: List.of(Symbol):
    match type_stx
    | #false: []
    | stx: collect_type_vars(stx :~ Syntax)
  fun binders_vars(bs :: List.of(CoreBinder)) :: List.of(Symbol):
    for values(acc :~ List = []) (b in bs):
      let binder :~ CoreBinder = b
      append_unique(
        acc,
        append_unique(pattern_vars(binder.pattern),
                      optional_vars(binder.type_stx)))
  fun pattern_vars(pat :: CorePattern) :: List.of(Symbol):
    match pat
    | CorePatVar(_, _): []
    | CorePatWildcard(_): []
    | CorePatCtor(_, args, _):
        for values(acc :~ List = []) (arg in args):
          append_unique(acc, pattern_vars(arg :~ CorePattern))
    | CorePatLiteral(_, _): []
    | CorePatTyped(inner, type_stx, _):
        append_unique(pattern_vars(inner), collect_type_vars(type_stx))
    | ~else: []
  fun matrix_vars(matrix :: CorePatternMatrix) :: List.of(Symbol):
    for values(acc :~ List = []) (row in matrix.rows):
      let row :~ CoreMatchRow = row
      let from_patterns:
        for values(out :~ List = []) (pat in row.patterns):
          append_unique(out, pattern_vars(pat :~ CorePattern))
      append_unique(
        acc, append_unique(from_patterns, body_vars(row.body)))
  fun body_vars(body :: CoreFunBody) :: List.of(Symbol):
    match body
    | CoreBodyExpr(inner): core_type_vars(inner)
    | CoreBodyLet(_, init, tail, _):
        append_unique(core_type_vars(init), body_vars(tail))
    | CoreBodyMatch(_, matrix, _): matrix_vars(matrix)
    | matrix :: CorePatternMatrix: matrix_vars(matrix)
    | ~else: []
  match expr
  | CoreRef(_, _): []
  | CoreGlobalRef(_, _): []
  | CoreCall(func, args, _):
      for values(acc :~ List = core_type_vars(func)) (a in args):
        append_unique(acc, core_type_vars(a))
  | CoreIf(c, t, e, _):
      append_unique(core_type_vars(c),
                    append_unique(core_type_vars(t), core_type_vars(e)))
  | CoreForall(bs, body, _):
      append_unique(binders_vars(bs), core_type_vars(body))
  | CoreNumeral(_, _): []
  | CoreExists(bs, body, _):
      append_unique(binders_vars(bs), core_type_vars(body))
  | CoreFunctionExpr(bs, result_type, body, _):
      append_unique(
        binders_vars(bs),
        append_unique(optional_vars(result_type), body_vars(body)))
  | CoreBlockExpr(body, _): body_vars(body)
  | CoreMatchExpr(scrutinee, matrix, _):
      append_unique(core_type_vars(scrutinee), matrix_vars(matrix))
  | CoreTypedExpr(inner, type_stx, _):
      append_unique(core_type_vars(inner), collect_type_vars(type_stx))
  | ~else: []

fun leading_core_binder_names(expr :: CoreExpr) :: List.of(Symbol):
  match expr
  | CoreForall(bs, body, _):
      bs.map(
        fun (b :: CoreBinder):
          required_pattern_name(
            b.pattern, #'theorem,
            "a quantified binder needs a name"))
        ++ leading_core_binder_names(body)
  | ~else: []

fun elaborate_theorem_statement(
      thy :: Theory, expr :: CoreExpr,
      ~operators: operators :: OverloadRegistry = standard_overload_registry(),
      ~type_constructors: type_constructors :: TypeConstructorRegistry = standard_type_constructor_registry(),
      ~datatypes: datatypes :: Map.of(Symbol, DatatypeSpec) = {})
     :: values(Term, List.of(Symbol)):
  let tyvars = core_type_vars(expr)
  values(parse_core_prop(thy, tyvars, {}, expr,
                         ~operators: operators,
                         ~type_constructors: type_constructors,
                         ~datatypes: datatypes),
         leading_core_binder_names(expr))

// -- CoreFunctionSpec elaboration -------------------------------------------

fun spec_type_vars(spec :: CoreFunctionSpec) :: List.of(Symbol):
  fun optional_vars(type_stx :: maybe(Syntax)) :: List.of(Symbol):
    match type_stx
    | #false: []
    | stx: collect_type_vars(stx :~ Syntax)
  let from_params:
    for values(acc :~ List = []) (b in spec.params):
      let binder :~ CoreBinder = b
      let pattern_types:
        match binder.pattern
        | CorePatTyped(_, stx, _): collect_type_vars(stx)
        | ~else: []
      append_unique(
        acc,
        append_unique(pattern_types, optional_vars(binder.type_stx)))
  append_unique(from_params, optional_vars(spec.result_type))

fun core_ctor_pattern(env :: ElabEnv, cname :: Symbol,
                      args :: List.of(CorePattern), scrut_ty :: HType,
                      at :: Syntax)
    :: values(Term, Map.of(Symbol, Term)):
  let gty = core_const_instance(env, cname, [], at)
  let (doms, res) = peel_fun(gty, args.length())
  unify_types(
    env, res, scrut_ty, at,
    "constructor does not build the matched type")
  let field_tys = doms.map(
                     fun (domain :: HType):
                       resolve_type(env, domain))
  let parsed = for List (arg in args, ty in field_tys):
                 core_sub_pattern(env, arg, ty :~ HType)
  let subpats = parsed.map(fun (pair :: List): pair[0] :~ Term)
  let bindings:
    for values(out :~ Map = {}) (pair in parsed):
      merge_pattern_bindings(
        env.who, out, (pair :~ List)[1] :~ Map, at)
  values(
    list_mk_comb(
      mk_const(cname, resolve_type(env, gty)), subpats),
    bindings)


fun core_sub_pattern(env :: ElabEnv, pat :: CorePattern,
                     ty :: HType) :: List:
  match pat
  | CorePatWildcard(_):
      [fresh_wildcard(resolve_type(env, ty)) :~ Term, {}]
  | CorePatVar(name, _):
      let variable = mk_var(name, resolve_type(env, ty))
      [variable :~ Term, {name: variable :~ Term}]
  | CorePatTyped(inner, type_stx, at):
      let annotated = parse_type(
                        type_stx, env.tyvars, env.type_constructors)
      unify_types(
        env, ty, annotated, at,
        "a pattern annotation does not match the expected type")
      core_sub_pattern(env, inner, resolve_type(env, annotated))
  // Products are not declared datatypes, so the decision tree cannot split
  // their fields. The surface decoder admits only irrefutable components.
  | CorePatCtor(name, _, _) when name == c_pair:
      let root = fresh_wildcard(resolve_type(env, ty))
      [root :~ Term, bind_irrefutable_pattern(env, pat, root)]
  | CorePatCtor(name, args, at):
      let (term, bindings) = core_ctor_pattern(
                                   env, name, args, ty, at)
      [term, bindings]
  | CorePatLiteral(value_stx, at):
      let raw = Syntax.unwrap(value_stx)
      let literal_expr:
        cond
        | raw is_a NonnegInt:
            CoreNumeral(raw, at)
        | ~else:
            syntax_error(env.who, "unsupported literal pattern", at)
      let literal = run_checked_elaboration(
                      env, literal_expr, resolve_type(env, ty))
      [literal, {}]

class ClauseEnv(thy :: Theory,
                self_name :: maybe(Symbol),
                self :: maybe(Term),
                pats :: List.of(Term),
                vars :: Map.of(Symbol, Term),
                at :: Syntax,
                result_type :: HType,
                operators :: OverloadRegistry,
                type_constructors :: TypeConstructorRegistry,
                tyvars :: List.of(Symbol),
                datatypes :: Map.of(Symbol, DatatypeSpec),
                restricted_refs :: Map.of(Symbol, RefRestriction),
                inference :: Box):
  reader_effect
fun clause_elab_env(env :: ClauseEnv) :: ElabEnv:
  ElabEnv(env.thy, env.tyvars, env.vars, #'function,
          env.self_name, env.self, env.operators,
          env.type_constructors, env.datatypes,
          env.restricted_refs, env.inference)


fun following_local_function_names(body :: CoreFunBody) :: List.of(Symbol):
  match body
  | CoreBodyLet(binding_pat, init, tail, _):
      let following = following_local_function_names(tail)
      (if init is_a CoreFunctionExpr
       | [required_pattern_name(
            binding_pat, #'function,
            "a local function needs a name")] ++ following
       | following)
  | ~else: []

fun add_reference_restrictions(
      base :: Map.of(Symbol, RefRestriction),
      names :: List.of(Symbol), message :: String,
      block_global :: Boolean)
     :: Map.of(Symbol, RefRestriction):
  for values(out :~ Map = base) (name in names):
    out ++ {name: RefRestriction(message, block_global)}

fun core_parse_body(body :: CoreFunBody) :: Computation:
  effect:
    let env :: ClauseEnv <- ClauseEnv.ask()
    match body
    | matrix :: CorePatternMatrix:
        core_clause_rows(matrix)
    | CoreBodyMatch(scrutinee, matrix, body_at):
        let v = matched_var(env.vars, env.pats, scrutinee, body_at)
        core_parse_clauses(v, matrix)
    | CoreBodyLet(binding_pat, init, tail, body_at):
        effect:
          let local_name:
            (if init is_a CoreFunctionExpr
             | required_pattern_name(
                 binding_pat, #'function,
                 "a local function needs a name")
             | #false)
          let forward_restricted = add_reference_restrictions(
                                     env.restricted_refs,
                                     following_local_function_names(tail),
                                     "forward local-function reference is not supported",
                                     #false)
          let init_restricted:
            match local_name
            | #false: forward_restricted
            | name:
                forward_restricted
                  ++ {name:
                        RefRestriction(
                          "local recursive functions are not supported",
                          #false)}
          let elab_env = ElabEnv(
                           env.thy, env.tyvars, env.vars, #'function,
                           env.self_name, env.self, env.operators,
                           env.type_constructors, env.datatypes,
                           init_restricted, env.inference)
          let value = run_elaboration(elab_env, init)
          let bindings = bind_irrefutable_pattern(
                           elab_env, binding_pat, value)
          let vars2 = env.vars ++ bindings
          fun bind_let(_):
            ClauseEnv(env.thy, env.self_name, env.self, env.pats,
                      vars2, env.at, env.result_type, env.operators,
                      env.type_constructors, env.tyvars, env.datatypes,
                      env.restricted_refs, env.inference)
          let clauses :: List <- ClauseEnv.local(
                                  bind_let, core_parse_body(tail))
          return for List (clause in clauses):
                   let clause :~ DefClause = clause
                   // The `let`'s own initializer is evaluated before
                   // anything in the body, so it goes at the front of
                   // the obligation list; `clause_terms` supplies the
                   // body's own evaluated terms, standing in its
                   // right-hand side when a clause carries no explicit
                   // obligations of its own. The logical reading is
                   // unchanged: `let` substitutes, so an initializer
                   // the body never reads is an obligation only.
                   DefClause(clause.pats, clause.rhs,
                             List.cons(value :~ Term, clause_terms(clause)))
    | CoreBodyExpr(expr):
        let elab_env = ElabEnv(
                         env.thy, env.tyvars, env.vars, #'function,
                         env.self_name, env.self, env.operators,
                         env.type_constructors, env.datatypes,
                         env.restricted_refs, env.inference)
        let value = run_checked_elaboration(
                      elab_env, expr, env.result_type)
        return [DefClause(env.pats, value, [value])]
    | ~else: error(~who: #'function, "unknown CoreFunBody variant")

fun core_parse_clauses(v :: FVar,
                       matrix :: CorePatternMatrix) :: Computation:
  recur loop (remaining :~ List = matrix.rows, acc :~ List = []):
    match remaining
    | []: return acc
    | List.cons(row, rest):
        effect:
          let parsed :: List <- core_parse_clause(
                                  v, row :~ CoreMatchRow)
          loop(rest, acc ++ parsed)

fun core_parse_clause(v :: FVar,
                      row :: CoreMatchRow) :: Computation:
  effect:
    let env :: ClauseEnv <- ClauseEnv.ask()
    let elab_env = clause_elab_env(env)
    let [source_pat] = row.patterns
    let [pat, bindings] = core_sub_pattern(
                            elab_env, source_pat :~ CorePattern, v.ty)
    let vars2 = env.vars ++ (bindings :~ Map)
    fun bind_pattern(_):
      ClauseEnv(env.thy, env.self_name, env.self,
                refine_pats(env.pats, v, pat :~ Term),
                vars2, env.at, env.result_type, env.operators,
                env.type_constructors, env.tyvars, env.datatypes,
                env.restricted_refs, env.inference)
    ClauseEnv.local(bind_pattern, core_parse_body(row.body))

fun elaborate_body_effect(body :: CoreFunBody,
                          expected :: maybe(HType)) :: Computation:
  match body
  | CoreBodyExpr(expr):
      match expected
      | #false: infer_core(expr)
      | wanted: check_core(expr, wanted :~ HType)
  | CoreBodyLet(binding_pat, init, tail, at):
      effect:
        let value :: Term <- infer_core(init)
        let root = mk_var(
                     pattern_root_name(binding_pat, "_let"),
                     type_of(value))
        let env :: ElabEnv <- ElabEnv.ask()
        let bindings = bind_irrefutable_pattern(
                         env, binding_pat, root)
        let result :: Term <- ElabEnv.local(
                               fun (_):
                                 sub_env(env, env.vars ++ bindings),
                               elaborate_body_effect(tail, expected))
        return mk_comb(mk_abs(resolve_term(env, root) :~ FVar,
                              resolve_term(env, result)),
                       resolve_term(env, value))
  | CoreBodyMatch(scrutinee, matrix, at):
      elaborate_match_expr_effect(
        CoreRef(scrutinee, at), matrix, at, expected)
  | _ :: CorePatternMatrix:
      error(~who: #'function,
            "function clauses are not an expression block")
  | ~else:
      error(~who: #'function, "unknown CoreFunBody variant")

fun elaborate_match_expr_effect(
      scrutinee :: CoreExpr,
      matrix :: CorePatternMatrix,
      at :: Syntax,
      expected :: maybe(HType)) :: Computation:
  match expected
  | #false:
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        syntax_error(
          env.who,
          "a match expression needs an expected result type",
          at)
  | wanted:
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        let scrutinee_term :: Term <- infer_core(scrutinee)
        let root = mk_var(
                     Symbol.gen("_match_scrutinee"),
                     type_of(scrutinee_term))
        let clause_env = ClauseEnv(
                           env.thy, env.self_name, env.self,
                           [root :~ Term],
                           env.vars,
                           at, wanted :~ HType, env.operators,
                           env.type_constructors, env.tyvars,
                           env.datatypes, env.restricted_refs,
                           env.inference)
        let parsed :~ List:
          match ClauseEnv.handle(
                  clause_env, core_clause_rows(matrix))
          | Pure(value): value :~ List
          | ~else:
              error(~who: #'function,
                    "internal error: unhandled match expression effect")
        let wanted = resolve_type(env, wanted :~ HType)
        check_local_function_clauses(parsed, wanted :~ HType, at)
        let local_name = Symbol.gen("_match_expression")
        let spec = FunSpec(
                     local_name,
                     [type_of(scrutinee_term)],
                     wanted :~ HType,
                     parsed)
        let tree = compile_patterns(
                     env.thy, env.who, local_name,
                     parsed.map(
                       fun (clause :: DefClause): clause.pats),
                     env.datatypes,
                     ~show_clause:
                       fun (_ :: Int): "match expression clause")
        let body_term = local_tree_term(
                          spec, env.datatypes,
                          [root :~ Term], tree)
        return mk_comb(mk_abs(root, body_term), scrutinee_term)

fun core_clause_rows(matrix :: CorePatternMatrix) :: Computation:
  recur loop (remaining :~ List = matrix.rows, acc :~ List = []):
    match remaining
    | []: return acc
    | List.cons(row, rest):
        effect:
          let parsed :: List <- core_clause_row(row :~ CoreMatchRow)
          loop(rest, acc ++ parsed)

fun core_clause_row(row :: CoreMatchRow) :: Computation:
  effect:
    let env :: ClauseEnv <- ClauseEnv.ask()
    unless row.patterns.length() == env.pats.length()
    | syntax_error(#'function,
                   "this clause has " ++ to_string(row.patterns.length())
                     ++ " patterns but the function takes "
                     ++ to_string(env.pats.length()),
                   row.at)
    let elab_env = clause_elab_env(env)
    let (pats2, local_bindings):
      for values(ps :~ List = env.pats, bindings :~ Map = {}) (col in List.iota(row.patterns.length())):
        let v :~ FVar:
          match ps[col]
          | FVar(_, _): ps[col]
          | ~else:
              syntax_error(#'function,
                           "this argument has already been matched",
                           row.at)
        let [pat, bound] = core_sub_pattern(
                             elab_env,
                             row.patterns[col] :~ CorePattern, v.ty)
        values(
          refine_pats(ps, v, pat :~ Term),
          merge_pattern_bindings(
            #'function, bindings, bound :~ Map, row.at))
    let vars2 = env.vars ++ local_bindings
    fun bind_row(_):
      ClauseEnv(env.thy, env.self_name, env.self, pats2, vars2, env.at,
                env.result_type, env.operators, env.type_constructors,
                env.tyvars, env.datatypes, env.restricted_refs,
                env.inference)
    ClauseEnv.local(bind_row, core_parse_body(row.body))

fun local_pattern_variables(pat :: Term) :: List.of(FVar):
  match pat
  | variable :: FVar: [variable]
  | ~else:
      let (_, args) = strip_comb(pat)
      for values(out :~ List = []) (arg in args):
        out ++ local_pattern_variables(arg :~ Term)

fun check_local_function_clauses(clauses :: List.of(DefClause),
                                 result_type :: HType,
                                 at :: Syntax):
  for (clause in clauses):
    let clause :~ DefClause = clause
    unless type_of(clause.rhs) == result_type
    | syntax_error(
        #'function,
        "a local function body has a different type from its result type",
        at)
    let variables:
      for values(out :~ List = []) (pat in clause.pats):
        out ++ local_pattern_variables(pat :~ Term)
    recur distinct (remaining :~ List = variables,
                    seen :~ List = []):
      match remaining
      | []: #void
      | List.cons(variable, rest):
          when seen.contains(variable)
          | syntax_error(#'function,
                         "a local function pattern variable is repeated",
                         at)
          distinct(rest, List.cons(variable, seen))

fun local_tree_term(spec :: FunSpec,
                    datatypes :: Map.of(Symbol, DatatypeSpec),
                    args :: List.of(Term),
                    tree :: DecisionTree) :: Term:
  fun datatype_for(ty :: HType) :: DatatypeSpec:
    match ty
    | TyApp(name, _): datatypes[name]
    | ~else:
        error(~who: #'function,
              "internal local match on a non-datatype")
  match tree
  | DTLeaf(clause_index, bindings):
      let clause :~ DefClause = spec.clauses[clause_index]
      let substitutions:
        for List (binding in bindings):
          let binding :~ DTBinding = binding
          [path_term(datatype_for, args, binding.path), binding.var]
      inst_fvar(substitutions, eager_clause_term(clause))
  | DTSwitch(path, self_type, branches):
      let scrutinee = path_term(datatype_for, args, path)
      recur branch_term (remaining :~ List = branches):
        match remaining
        | [last]:
            local_tree_term(
              spec, datatypes, args, (last :~ DTBranch).tree)
        | List.cons(first, rest):
            let first :~ DTBranch = first
            let discriminator = mk_const(
                                  discriminator_name(first.ctor),
                                  mk_fun(self_type, bool))
            mk_cond(
              mk_comb(discriminator, scrutinee),
              local_tree_term(spec, datatypes, args, first.tree),
              branch_term(rest))
  | DTLiteralSwitch(path, branches, default):
      let scrutinee = path_term(datatype_for, args, path)
      recur branch_term (remaining :~ List = branches):
        match remaining
        | []: local_tree_term(spec, datatypes, args, default)
        | List.cons(first, rest):
            let first :~ DTLiteralBranch = first
            mk_cond(
              mk_eq(scrutinee, first.literal),
              local_tree_term(spec, datatypes, args, first.tree),
              branch_term(rest))
  | ~else:
      error(~who: #'function, "unknown local function decision-tree node")

fun expected_function_types(env :: ElabEnv, wanted :: HType,
                            arity :: NonnegInt, at :: Syntax)
    :: values(List.of(HType), HType):
  recur loop (remaining = arity,
              current :~ HType = wanted,
              domains :~ List = []):
    cond
    | remaining == 0:
        values(domains, resolve_type(env, current))
    | ~else:
        let current = resolve_type(env, current)
        when current is_a TyVar
        | let domain = mk_tyvar(Symbol.gen("_domain"))
          let range = mk_tyvar(Symbol.gen("_range"))
          unify_types(
            env, current, mk_fun(domain, range), at,
            "a function expression does not match its expected type")
        let current = resolve_type(env, current)
        unless is_fun(current)
        | syntax_error(
            env.who,
            "a function expression has more parameters than its expected type",
            at)
        let (domain, range) = dest_fun(current)
        loop(remaining - 1, range, domains ++ [domain])

fun elaborate_function_expr_effect(
      params :: List.of(CoreBinder),
      result_type_stx :: maybe(Syntax),
      body :: CoreFunBody, at :: Syntax,
      ~expected: expected :: maybe(HType) = #false)
     :: Computation:
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    let contextual:
      match expected
      | #false: #false
      | wanted:
          let (domains, range) = expected_function_types(
                                   env, wanted :~ HType,
                                   params.length(), at)
          [domains, range]
    let parameter_types:
      for List (binder in params, index in List.iota(params.length())):
        let binder :~ CoreBinder = binder
        let declared = optional_declared_type(
                         binder.type_stx, env.tyvars,
                         env.type_constructors, "_parameter")
        match contextual
        | #false: declared
        | [domains, _]:
            let contextual_type = (domains :~ List)[index] :~ HType
            unify_types(
              env, declared, contextual_type, binder.at,
              "a function parameter does not match its expected type")
            resolve_type(env, declared)
    let result_type = optional_declared_type(
                        result_type_stx, env.tyvars,
                        env.type_constructors, "_result")
    match contextual
    | [_, contextual_result]:
        unify_types(
          env, result_type, contextual_result :~ HType, at,
          "a function result does not match its expected type")
    | #false: #void
    let parameter_vars:
      for List (binder in params, parameter_type in parameter_types):
        let binder :~ CoreBinder = binder
        mk_var(
          pattern_root_name(binder.pattern, "_parameter"),
          parameter_type :~ HType)
    let local_bindings:
      for values(out :~ Map = {}) (binder in params,
                                   variable in parameter_vars):
        let binder :~ CoreBinder = binder
        merge_pattern_bindings(
          env.who, out,
          bind_irrefutable_pattern(
            env, binder.pattern, variable :~ Term),
          binder.at)
    let vars = env.vars ++ local_bindings
    let clause_env = ClauseEnv(
                       env.thy, env.self_name, env.self,
                       parameter_vars.map(
                         fun (variable :: FVar): variable :~ Term),
                       vars, at, result_type, env.operators,
                       env.type_constructors, env.tyvars, env.datatypes,
                       env.restricted_refs, env.inference)
    let clauses :~ List:
      match ClauseEnv.handle(clause_env, core_parse_body(body))
      | Pure(value): value :~ List
      | ~else:
          error(~who: #'function,
                "internal error: unhandled local function effect")
    let result_type = resolve_type(env, result_type)
    let parameter_vars:
      parameter_vars.map(
        fun (variable :: FVar):
          resolve_term(env, variable) :~ FVar)
    let clauses:
      clauses.map(
        fun (clause :: DefClause):
          DefClause(
            clause.pats.map(fun (pat :: Term): resolve_term(env, pat)),
            resolve_term(env, clause.rhs),
            clause.obligations.map(
              fun (obligation :: Term):
                resolve_term(env, obligation))))
    check_local_function_clauses(clauses, result_type, at)
    let local_name = Symbol.gen("_local_function")
    let spec = FunSpec(
                 local_name,
                 parameter_vars.map(
                   fun (variable :: FVar): variable.ty),
                 result_type, clauses)
    let tree = compile_patterns(
                 env.thy, #'function, local_name,
                 clauses.map(fun (clause :: DefClause): clause.pats),
                 env.datatypes,
                 ~show_clause:
                   fun (_ :: Int): "local function clause")
    let body_term = local_tree_term(
                      spec, env.datatypes,
                      parameter_vars.map(
                        fun (variable :: FVar): variable :~ Term),
                      tree)
    return list_mk_abs(parameter_vars, body_term)

fun elaborate_function_decl(
      thy :: Theory, spec :: CoreFunctionSpec,
      ~operators: operators :: OverloadRegistry = standard_overload_registry(),
      ~type_constructors: type_constructors :: TypeConstructorRegistry = standard_type_constructor_registry(),
      ~datatypes: datatypes :: Map.of(Symbol, DatatypeSpec) = {})
     :: FunSpec:
  let tyvars = spec_type_vars(spec)
  unless spec.result_type
  | syntax_error(#'function, "a function needs a result type", spec.at)
  let inference = Box({})
  let arg_tys:
    spec.params.map(
      fun (binder :: CoreBinder):
        optional_declared_type(
          binder.type_stx, tyvars, type_constructors, "_parameter"))
  let result_ty = optional_declared_type(
                    spec.result_type, tyvars, type_constructors, "_result")
  let fty = for values(t :~ HType = result_ty) (a in arg_tys.reverse()):
              mk_fun(a, t)
  let self = mk_const(spec.name, fty)
  let pvars:
    for List (binder in spec.params, ty in arg_tys):
      let binder :~ CoreBinder = binder
      mk_var(pattern_root_name(binder.pattern, "_parameter"),
             ty :~ HType)
  let binding_env = ElabEnv(
                      thy, tyvars, {}, #'function, spec.name, self,
                      operators, type_constructors, datatypes, {}, inference)
  let env0:
    for values(out :~ Map = {}) (binder in spec.params, variable in pvars):
      let binder :~ CoreBinder = binder
      merge_pattern_bindings(
        #'function, out,
        bind_irrefutable_pattern(
          binding_env, binder.pattern, variable :~ Term),
        binder.at)
  let measure:
    match spec.measure
    | #false: #false
    | expr:
        let value = run_elaboration(
                      ElabEnv(thy, tyvars, env0, #'function, #false, #false,
                              operators, type_constructors, datatypes,
                              {}, inference),
                      expr :~ CoreExpr)
        list_mk_abs(pvars, value)
  let clause_env = ClauseEnv(
                     thy, spec.name, self,
                     pvars.map(fun (v :: FVar): v :~ Term),
                     env0, spec.at, result_ty, operators, type_constructors,
                     tyvars, datatypes, {}, inference)
  let clauses0 :~ List:
    match ClauseEnv.handle(clause_env, core_parse_body(spec.body))
    | Pure(clauses): clauses :~ List
    | ~else:
        error(~who: #'elaborate_function_decl,
              "internal error: unhandled effect")
  let substitution :~ Map = close_substitution(inference.value :~ Map)
  let arg_tys = arg_tys.map(
                  fun (ty :: HType): type_subst(substitution, ty))
  let result_ty = type_subst(substitution, result_ty)
  let clauses:
    for List (cl in clauses0):
      let cl :~ DefClause = cl
      DefClause(
        cl.pats.map(
          fun (pat :: Term): inst_type(substitution, pat)),
        inst_type(substitution, cl.rhs),
        cl.obligations.map(
          fun (obligation :: Term):
            inst_type(substitution, obligation)))
  let measure:
    match measure
    | #false: #false
    | term: inst_type(substitution, term :~ Term)
  FunSpec(spec.name, arg_tys, result_ty, clauses, measure)

fun sub_env(env :: ElabEnv, vars :: Map.of(Symbol, Term)) :: ElabEnv:
  ElabEnv(env.thy, env.tyvars, vars, env.mode, env.self_name, env.self,
          env.operators, env.type_constructors, env.datatypes,
          env.restricted_refs, env.inference)

// ============================================================================
// Proof options
// ============================================================================
//
// A `proof:` block is a sequence of declarative option groups. The block
// itself is the boundary: each option configures the one existing waterfall
// invocation, and none executes as a run-time Rhombus expression. `~use`,
// `~skip`, `~disable`, `~split`, and `~choose` accumulate in source order,
// while `~induct` and `~limit` are singletons.
//
// `~skip` names waterfall stages to omit for this proof only. The recognised
// names are `simplify`, `eliminate`, `fertilize`, `generalize`, `irrelevance`
// and `induct`; see `waterfall.rhm`'s pipeline comment.
//
// `~disable` removes rules from this proof only. `~use` enables named theorem
// rules for this proof only. `~split` splits the goal on Boolean terms before
// the waterfall; `~choose` supplies existential candidates.
//
// Returns `[induct, using, skipped_stages, disabled_rules, cases, witnesses,
// search_steps, extensionality]`.
fun parse_tactic(stx :: maybe(Syntax)) :: List:
  match stx
  | #false: [#false, [], [], [], [], [], #false, #false]
  | s :~ Syntax:
      match s
      | '$group; ...': parse_tactic_groups([group, ...])
      | ~else: syntax_error(#'proof, "unknown proof option", s)

fun parse_tactic_groups(groups :: List.of(Syntax)) :: List:
  recur loop (remaining :~ List = groups,
              acc :~ List = [#false, [], [], [], [], [], #false, #false]):
    match remaining
    | []: acc
    | List.cons(group, rest):
        let rest :~ List = rest
        match group
        | '~induct: $(n :: Identifier)':
            match acc[0]
            | #false:
                loop(rest,
                     [Syntax.unwrap(n), acc[1], acc[2], acc[3], acc[4],
                      acc[5], acc[6], acc[7]])
            | ~else:
                syntax_error(#'proof, "duplicate `~induct` option", group)
        | '~induct: $arg; ...':
            syntax_error(#'proof, "`~induct` expects one identifier", group)
        | '~extensionality: $(n :: Identifier)':
            match acc[7]
            | #false:
                loop(rest,
                     [acc[0], acc[1], acc[2], acc[3], acc[4], acc[5],
                      acc[6], Syntax.unwrap(n)])
            | ~else:
                syntax_error(
                  #'proof, "duplicate `~extensionality` option", group)
        | '~extensionality: $arg; ...':
            syntax_error(
              #'proof, "`~extensionality` expects one identifier", group)
        | '~use: [$(u :: Identifier), ...]':
            loop(rest,
                 [acc[0], (acc[1] :~ List) ++ [Syntax.unwrap(u), ...],
                  acc[2], acc[3], acc[4], acc[5], acc[6], acc[7]])
        | '~use: $rest; ...':
            syntax_error(#'proof,
                         "`~use` expects one bracketed list of theorem names",
                         group)
        | '~skip: [$(d :: Identifier), ...]':
            loop(rest,
                 [acc[0], acc[1],
                  (acc[2] :~ List) ++ [Syntax.unwrap(d), ...],
                  acc[3], acc[4], acc[5], acc[6], acc[7]])
        | '~skip: $rest; ...':
            syntax_error(#'proof,
                         "`~skip` expects one bracketed list of stage names",
                         group)
        | '~disable: [$(r :: Identifier), ...]':
            loop(rest,
                 [acc[0], acc[1], acc[2],
                  (acc[3] :~ List) ++ [Syntax.unwrap(r), ...],
                  acc[4], acc[5], acc[6], acc[7]])
        | '~disable: $rest; ...':
            syntax_error(#'proof,
                         "`~disable` expects one bracketed list of rule names",
                         group)
        | '~split: $c':
            loop(rest,
                 [acc[0], acc[1], acc[2], acc[3],
                  (acc[4] :~ List) ++ [c], acc[5], acc[6], acc[7]])
        | '~split: $rest; ...':
            syntax_error(#'proof, "`~split` expects one proposition", group)
        | '~choose: $w':
            loop(rest,
                 [acc[0], acc[1], acc[2], acc[3], acc[4],
                  (acc[5] :~ List) ++ [w], acc[6], acc[7]])
        | '~choose: $rest; ...':
            syntax_error(#'proof, "`~choose` expects one term", group)
        | '~limit: $(n :: Int)':
            let steps = Syntax.unwrap(n)
            unless steps >= 0
            | syntax_error(#'proof, "search steps cannot be negative", group)
            match acc[6]
            | #false:
                loop(rest,
                     [acc[0], acc[1], acc[2], acc[3], acc[4], acc[5],
                      steps, acc[7]])
            | ~else:
                syntax_error(#'proof, "duplicate `~limit` option", group)
        | '~limit: $rest; ...':
            syntax_error(#'proof,
                         "`~limit` expects one nonnegative integer",
                         group)
        | ~else:
            syntax_error(#'proof, "unknown proof option", group)

// ============================================================================
// quickcheck
// ============================================================================
//
// `quickcheck` uses the same parsed HOL proposition as `theorem`. Only its
// execution controls are parsed separately here.

export:
  quickcheck_options

// `[samples, size, seed]`. `~size` bounds generated value depth.
fun quickcheck_options(opts :: List.of(Syntax)) :: List:
  for values(acc :~ List = [100, 6, 20240904]) (o in opts):
    match o
    | '~samples: $(n :: Int)': [Syntax.unwrap(n), acc[1], acc[2]]
    | '~size: $(n :: Int)': [acc[0], Syntax.unwrap(n), acc[2]]
    | '~seed: $(n :: Int)': [acc[0], acc[1], Syntax.unwrap(n)]
    | ~else: syntax_error(#'quickcheck, "unknown option", o)
