#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// ACL2 hint handling is a design reference; see THIRD_PARTY_NOTICES.


// Reading the surface syntax into the logical world.
//
// This module only *analyses*: syntax in, kernel-level data out.  It builds no
// templates, because a syntax template created at phase 0 loses its bindings
// on the way out of a phase-1 macro -- `'def x = 1'` written here and returned
// from a macro reports `def: unbound identifier`.  Emission therefore lives in
// `module_block.rhm`; see the note at the top of `expand.rhm`.
//
// Everything here is called twice: once at expansion time, so that the runtime
// code can be generated, and once at phase 1, so that the logical declaration
// can be made.  Both go through the same functions on the same syntax, so the
// two views of a declaration cannot drift apart.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/datatype/datatype open
  rhombus/hol/recursion/recdef open
  rhombus/hol/frontend/core open
  rhombus/hol/frontend/surface_core open
  rhombus/hol/logic/bool open
  rhombus/hol/frontend/tyunify open
  rhombus/hol/frontend/dispatch open
  rhombus/hol/effect/core open
  rhombus/hol/effect/core as effect
  rhombus/hol/effect/syntax open

export:
  parse_type_decl
  type_decl_shape
  parse_open_type

// `?` is already one shrubbery operator token. A type variable is therefore
// parsed structurally as that operator followed by one identifier; no string
// splitting or keyword conversion is needed.

fun syntax_error(who :: Symbol, message :: String, at :: Syntax):
  error(~who: who, message, error.val(~label: "in", to_string(at)))

// -- types -------------------------------------------------------------------
//
// A type variable is written `?a`. Shrubbery keeps `?` as one operator token
// followed by the identifier `a`, which makes recognizing the prefix constant
// time and leaves the identifier's source location intact.

fun parse_type(stx :: Syntax, params :: List.of(Symbol)) :: HType:
  match stx
  | '? $(id :: Identifier)':
      let n = Syntax.unwrap(id)
      unless params.contains(n)
      | syntax_error(#'type, "unbound type variable", stx)
      mk_tyvar(n)
  | 'Function($domain, $range)':
      mk_fun(parse_type(domain, params), parse_type(range, params))
  | '$(id :: Identifier)($arg, ...)':
      mk_tyapp(Syntax.unwrap(id),
               [parse_type(arg, params), ...])
  | 'Boolean':
      // Spelled as Rhombus spells it: a function's parameter annotations are
      // erased on the way to the executable half, but its `if` conditions are
      // not, so the two halves have to agree on what a Boolean is.
      bool
  | '$(id :: Identifier)':
      mk_tyapp(Syntax.unwrap(id), [])
  | ~else:
      syntax_error(#'type, "not a type", stx)

// -- datatype declarations ---------------------------------------------------

fun parse_type_decl(stx :: Syntax) :: DatatypeSpec:
  match stx
  | 'type $(name :: Identifier)($param, ...)
     | $ctor
     | ...':
      let params = [parse_param(param), ...]
      DatatypeSpec(Syntax.unwrap(name), params,
                   [parse_ctor(ctor, params), ...])
  | 'type $(name :: Identifier)
     | $ctor
     | ...':
      DatatypeSpec(Syntax.unwrap(name), [], [parse_ctor(ctor, []), ...])
  | ~else:
      syntax_error(#'type, "malformed datatype declaration", stx)

fun parse_param(stx :: Syntax) :: Symbol:
  match stx
  | '? $(id :: Identifier)': Syntax.unwrap(id)
  | ~else:
      syntax_error(#'type,
                   "a type parameter is written `?a`, not a plain name", stx)

fun parse_ctor(stx :: Syntax, params :: List.of(Symbol)) :: Ctor:
  match stx
  | '$(name :: Identifier)($field, ...)':
      Ctor(Syntax.unwrap(name), [parse_field(field, params), ...])
  | '$(name :: Identifier)':
      Ctor(Syntax.unwrap(name), [])
  | ~else:
      syntax_error(#'type, "malformed constructor", stx)

fun parse_field(stx :: Syntax, params :: List.of(Symbol)) :: Field:
  match stx
  | '$(name :: Identifier) :: $ty ...':
      Field(Syntax.unwrap(name), parse_type('$ty ...', params))
  | ~else:
      syntax_error(#'type,
                   "a constructor field needs a name and a type", stx)

// The identifiers a datatype declaration introduces, as syntax rather than as
// symbols: `[name, [[ctor, [field, ...]], ...]]`.
//
// Emission needs the user's own identifiers, not reconstructed ones.  A name
// built with `Syntax.make_id` would carry the macro's scopes, and then a
// `Cons(...)` the user writes would not refer to the class we generated.
fun type_decl_shape(stx :: Syntax) :: List:
  fun ctor_shape(c :: Syntax) :: List:
    match c
    | '$(name :: Identifier)($field, ...)': [name, [field_name(field), ...]]
    | '$(name :: Identifier)': [name, []]
    | ~else: syntax_error(#'type, "malformed constructor", c)
  fun field_name(f :: Syntax) :: Syntax:
    match f
    | '$(name :: Identifier) :: $_ ...': name
    | ~else: syntax_error(#'type, "malformed constructor field", f)
  match stx
  | 'type $(name :: Identifier)($_, ...)
     | $ctor
     | ...':
      [name, [ctor_shape(ctor), ...]]
  | 'type $(name :: Identifier)
     | $ctor
     | ...':
      [name, [ctor_shape(ctor), ...]]
  | ~else: syntax_error(#'type, "malformed datatype declaration", stx)

// ============================================================================
// Function declarations
// ============================================================================
//
// The admissible shape is exactly what `recdef.rhm` can install:
//
//   function f(p1 :: T1, ..., pn :: Tn) :: T:
//     match pi
//     | C(v, ...): <expr>
//     | ...
//
// possibly with nested `match`es on further arguments, or a single-clause body
// with no `match` at all.
//
// The keyword is `function`, not `fun`.  Intercepting `fun` would mean deciding
// from the shape alone whether an ordinary Rhombus definition was meant to be a
// logical one -- and getting that wrong silently strips its annotations.  With
// a separate keyword the intent is explicit, so anything outside the grammar is
// an error naming the offending expression rather than a silent pass-through.

export:
  function_decl_shape
  function_parts
  body_clauses
  row_parts

// A declaration split into its parts: `[name, [param, ...], result_type,
// measure_or_false, body]`.  One matcher, used by both halves -- the executable
// code generator wants the names and the body, the logical elaborator wants the
// types and the measure, and neither should re-parse the declaration for
// itself.
//
// Raises, with the offending syntax, when the declaration is not one this
// version can admit.
// `axiomatic_function` has the same grammar as `function`; the two differ
// only in what the driver is allowed to do when the derivation does not
// apply, so everything that reads a declaration reads both the same way.
fun function_parts(stx :: Syntax) :: List:
  match stx
  | 'function $(name :: Identifier)($param, ...) $rest ...':
      let [rty, measure, body] = split_signature('$rest ...', stx)
      [name, [param, ...], rty, measure, body]
  | 'axiomatic_function $(name :: Identifier)($param, ...) $rest ...':
      let [rty, measure, body] = split_signature('$rest ...', stx)
      [name, [param, ...], rty, measure, body]
  | ~else:
      syntax_error(#'function,
                   "expected `function name(param :: Type, ...) :: Type: body`",
                   stx)

// `:: Type: body`, or `:: Type ~measure(e): body`, or the clausal form
// `:: Type | (pat, ...): body | ...` -- see `clause_rows`.  The clausal form
// is returned as a body of the same shape everything downstream already
// reads, so only `parse_body` and the emitter have to know about it.
fun split_signature(rest :: Syntax, at :: Syntax) :: List:
  match rest
  | ':: $ty ... ~measure($m): $body; ...': ['$ty ...', m, '$body; ...']
  | ':: $ty ...: $body; ...': ['$ty ...', #false, '$body; ...']
  | ':: $ty ... ~measure($m)
     | $c
     | ...': ['$ty ...', m, clause_body([c, ...])]
  | ':: $ty ...
     | $c
     | ...': ['$ty ...', #false, clause_body([c, ...])]
  | ~else:
      syntax_error(#'function, "a function needs a result type", at)

// The clausal form's body, tagged so `parse_body` can tell it from an
// ordinary expression body.  Keeping it a `Syntax` rather than a separate
// field means `function_parts`, `fun_signature` and the measure path are
// untouched.
fun clause_body(cs :: List.of(Syntax)) :: Syntax:
  let [c, ...] = cs
  '#%hol_clauses:
     $c
     ...'

// The clauses back out of that shape, for the emitter.  `#false` when the
// body is an ordinary expression body.
fun body_clauses(body :: Syntax) :: maybe(List.of(Syntax)):
  match body
  | '#%hol_clauses: $c; ...': [c, ...]
  | ~else: #false

// `[name, [param, ...], body]`, the executable half's view.
fun function_decl_shape(stx :: Syntax) :: List:
  let [name, params, _, _, body] = function_parts(stx)
  let ps :~ List = params
  [name, ps.map(param_name), body]

fun param_name(p :: Syntax) :: Syntax:
  match p
  | '$(n :: Identifier) :: $_ ...': n
  | ~else:
      syntax_error(#'function,
                   "a parameter needs a name and a type", p)

fun collect_type_vars(stx :: Syntax) :: List.of(Symbol):
  fun add(acc :: List.of(Symbol), more :: List.of(Symbol)) :: List.of(Symbol):
    for values(out :~ List = acc) (n in more):
      (if out.contains(n) | out | out ++ [n])
  match stx
  | '? $(id :: Identifier)': [Syntax.unwrap(id)]
  | 'Function($domain, $range)':
      add(collect_type_vars(domain), collect_type_vars(range))
  | '$(id :: Identifier)($arg, ...)':
      for values(acc :~ List = []) (a in [arg, ...]):
        add(acc, collect_type_vars(a))
  | ~else: []
fun parse_open_type(stx :: Syntax) :: HType:
  parse_type(stx, collect_type_vars(stx))


fun fresh_wildcard(ty :: HType) :: FVar:
  mk_var(Symbol.gen("_wild"), ty)
fun peel_fun(ty :: HType, n :: Int) :: values(List.of(HType), HType):
  recur loop (ty :~ HType = ty, k = n, acc :~ List = []):
    cond
    | k == 0: values(acc, ty)
    | ~else:
        let (d, r) = dest_fun(ty)
        loop(r, k - 1, acc ++ [d])

// Rebuild a clause's evaluation core so an enclosing `let` can prepend its
// initializer obligation without duplicating obligation logic.
fun clause_core(c :: DefClause) :: EvalCoreExpr:
  recur loop (obs :~ List = c.obligations):
    match obs
    | []: EvalCoreLeaf(c.rhs)
    | [_]: EvalCoreLeaf(c.rhs)
    | List.cons(o, rest): EvalCoreLet(#'_inner, EvalCoreLeaf(o :~ Term), loop(rest))


// `(pat, ...): body`, or `pat: body` when there is exactly one argument.
fun row_parts(c :: Syntax, arity :: Int) :: values(List.of(Syntax), Syntax):
  match c
  | '($p, ...): $body; ...':
      let ps = [p, ...]
      unless ps.length() == arity
      | syntax_error(#'function,
                     "this clause has " ++ to_string(ps.length())
                       ++ " patterns but the function takes "
                       ++ to_string(arity),
                     c)
      values(ps, '$body; ...')
  | '$pt ...: $body; ...':
      let p = '$pt ...'
      // One argument may drop the parentheses, exactly as a one-argument
      // `match` clause does.
      unless arity == 1
      | syntax_error(#'function,
                     "this clause has 1 pattern but the function takes "
                       ++ to_string(arity),
                     c)
      values([p], '$body; ...')
  | ~else:
      syntax_error(#'function,
                   "expected `(pattern, ...): body`", c)

// The pattern variable a `match` refines: `n` must name something still a
// *live*, unrefined position somewhere in `pats` -- a top-level parameter
// not yet matched, or a variable an enclosing pattern in this same clause
// just bound.  Refusing anything else catches every way `n` could fail to
// denote a fresh scrutinee: unbound entirely, already matched (its own name
// lingers in `env` after refinement, since `env` only ever grows), or bound
// by `let` to a computed term rather than a pattern position (matching on a
// computed value has no constructor test to check exhaustively against).
//
// A pattern variable may shadow a parameter -- `function f(n)` with a clause
// `succ(n)` -- and without checking liveness in `pats` (not just presence in
// `env`) a nested `match n` after that would look like a fresh match on the
// now-inaccessible outer `n` and silently refine nothing.
fun matched_var(env :: Map.of(Symbol, Term), pats :: List.of(Term),
                n :: Symbol, at :: Syntax) :: FVar:
  match env.get(n, #false)
  | #false:
      syntax_error(#'function, "the matched name is not in scope", at)
  | v when !(v is_a FVar):
      syntax_error(#'function,
                   "this name is not a pattern variable to match on", at)
  | v0:
      let v :~ FVar = v0
      unless pattern_var_live(pats, v)
      | syntax_error(#'function,
                     "this argument has already been matched; a nested "
                       ++ "`match` must be on a still-unmatched variable",
                     at)
      v

// Whether `v` occurs, unrefined, somewhere in `pats`'s pattern trees.
fun pattern_var_live(pats :: List.of(Term), v :: FVar) :: Boolean:
  fun walk(t :: Term) :: Boolean:
    match t
    | FVar(_, _): t == (v :~ Term)
    | ~else:
        let (head, args) = strip_comb(t)
        match head
        | Const(_, _): for any (a in args): walk(a)
        | ~else: #false
  for any (p in pats): walk(p)

// `pats` with the one live occurrence of `v` replaced by `new_pat`.
fun refine_pats(pats :: List.of(Term), v :: FVar,
                new_pat :: Term) :: List.of(Term):
  fun walk(t :: Term) :: Term:
    match t
    | FVar(_, _): (if t == (v :~ Term) | new_pat | t)
    | ~else:
        let (head, args) = strip_comb(t)
        match head
        | Const(_, _): list_mk_comb(head, args.map(walk))
        | ~else: t
  pats.map(walk)


// ============================================================================
// Core elaboration
// ============================================================================
//
// Surface enforestation has already resolved precedence, associativity, and
// extension bindings. This module resolves names and types against a Theory.

export:
  parse_core_prop
  elaborate_theorem_statement
  elaborate_function_decl
  core_type_vars
  parse_tactic
  ElabEnv
  elaborate_effect
  parse_type_effect
  run_type_elaboration
  infer_core
  check_core
  run_elaboration

// `self_name` and `self` are the definition being elaborated, so that a
// recursive call resolves before the constant exists in the theory.  In
// `#'prop` mode there is no such definition and both are `#false`.
class ElabEnv(thy :: Theory,
              tyvars :: List.of(Symbol),
              vars :: Map.of(Symbol, Term),
              mode :: Symbol,
              self_name :: maybe(Symbol),
              self :: maybe(Term),
              operators :: DispatchRegistry = standard_dispatch_registry()):
  property who :: Symbol: (if mode == #'prop | #'theorem | #'function)

  reader_effect

// -- CoreExpr elaboration ----------------------------------------------------

fun core_const_instance(env :: ElabEnv, name :: Symbol,
                        args :: List.of(Term), at :: Syntax) :: HType:
  let generic = (match const_type(env.thy, name)
                 | #false: syntax_error(env.who, "unknown constant", at)
                 | t: t)
  // A constant's type variables are schematic. Freshen them before
  // unification so a surrounding theorem variable with the same printed name
  // cannot fail the occurs check (for example, equality on `List(?a)`).
  let renaming:
    for values(m :~ Map = {}) (v in type_vars(generic)):
      m ++ {v: mk_tyvar(Symbol.gen(to_string(v))) :~ HType}
  let gty = (if args.length() == 0 | generic | type_subst(renaming, generic))
  let res = mk_tyvar(Symbol.gen("_result"))
  let want = for values(ty :~ HType = res) (a in args.reverse()):
               mk_fun(type_of(a), ty)
  match type_unify(gty, want, {})
  | #false:
      syntax_error(env.who,
                   "constant is applied at a type it does not have",
                   at)
  | sub: type_subst(sub, gty)

fun core_lookup(env :: ElabEnv, n :: Symbol, at :: Syntax) :: Term:
  match env.vars.get(n, #false)
  | #false:
      cond
      | n == env.self_name: env.self :~ Term
      | ~else: mk_const(n, core_const_instance(env, n, [], at))
  | v: v

// Specialize phantom type variables in already-elaborated arguments from the
// function domains selected by unification. This is needed for expressions
// such as `left(x) === left(y)`: each `left` initially has an independent
// unconstrained right-hand sum parameter.
fun specialize_call_args(fty :: HType, args :: List.of(Term)) :: List.of(Term):
  recur loop (ty :~ HType = fty, rest :~ List.of(Term) = args,
              acc :~ List.of(Term) = []):
    match rest
    | []: acc
    | List.cons(arg, more):
        let (domain, range) = dest_fun(ty)
        let arg2:
          cond
          | type_of(arg) == domain: arg
          | ~else:
              match type_match(type_of(arg), domain, {})
              | #false: arg
              | theta: inst_type(theta :~ Map, arg)
        loop(range, more, acc ++ [arg2])


// Effectful CoreExpr elaboration is the Reader-facing domain algebra. Every
// expression entry point below uses it; function clauses enter through
// `run_elaboration` with their explicit local binding map.
fun elaborate_arguments_effect(args :: List.of(CoreExpr)) :: Computation:
  recur loop (remaining :~ List = args, terms :~ List = []):
    match remaining
    | []: return terms
    | List.cons(first, rest):
        effect:
          let term :: Term <- elaborate_effect(first :~ CoreExpr)
          loop(rest, terms ++ [term])
fun elaborate_equality_arguments_effect(args :: List.of(CoreExpr))
     :: Computation:
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    match args
    | [left, right]:
        cond
        | requires_expected_type(right, env.operators):
            effect:
              let left_term :: Term <- infer_core(left)
              let right_term :: Term <- check_core(right, type_of(left_term))
              return [left_term, right_term]
        | requires_expected_type(left, env.operators):
            effect:
              let right_term :: Term <- infer_core(right)
              let left_term :: Term <- check_core(left, type_of(right_term))
              return [left_term, right_term]
        | ~else: elaborate_arguments_effect(args)
    | ~else: elaborate_arguments_effect(args)
fun core_location(expr :: CoreExpr) :: Syntax:
  match expr
  | CoreRef(_, at): at
  | CoreCall(_, _, at): at
  | CoreOverloadRef(_, _, at): at
  | CoreNumeral(_, at): at
  | CoreIf(_, _, _, at): at
  | CoreForall(_, _, at): at
  | CoreExists(_, _, at): at
  | ~else: error(~who: #'elaborate, "unknown CoreExpr variant")

fun elaborate_typed_arguments_effect(func :: CoreRef,
                                     args :: List.of(CoreExpr))
     :: Computation:
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    let generic:
      match func
      | CoreRef(name, at):
          match env.vars.get(name, #false)
          | value :: Term: type_of(value)
          | #false:
              cond
              | name == env.self_name: type_of(env.self :~ Term)
              | ~else:
                  match const_type(env.thy, name)
                  | #false: syntax_error(env.who, "unknown constant", at)
                  | ty:
                      let ty :~ HType = ty
                      let renaming:
                        for values(m :~ Map = {}) (v in type_vars(ty)):
                          m ++ {v: mk_tyvar(
                                     Symbol.gen(to_string(v))) :~ HType}
                      type_subst(renaming, ty)
    recur loop (remaining :~ List = args,
                current :~ HType = generic,
                theta :~ Map = {},
                terms :~ List = []):
      match remaining
      | []: return terms
      | List.cons(arg, rest):
          let instantiated = type_subst(theta, current)
          unless is_fun(instantiated)
          | syntax_error(env.who, "too many function arguments",
                         core_location(arg :~ CoreExpr))
          let (domain, range) = dest_fun(instantiated)
          effect:
            let term :: Term <- (if requires_expected_type(
                                      arg :~ CoreExpr, env.operators)
                                 | check_core(arg, domain)
                                 | infer_core(arg))
            let next:
              match type_match(domain, type_of(term), theta)
              | #false:
                  syntax_error(env.who,
                               "argument has an unexpected type",
                               core_location(arg :~ CoreExpr))
              | substitution: substitution :~ Map
            loop(rest, range, next, terms ++ [term])

fun arguments_require_expected(args :: List.of(CoreExpr)) :: Boolean:
  for values(found = #false) (arg in args):
    found || requires_expected_type(arg :~ CoreExpr)



fun core_apply_effect(func :: CoreExpr, args :: List.of(CoreExpr),
                      at :: Syntax) :: Computation:
  fun apply_terms(terms :: List.of(Term)) :: Computation:
    effect:
      let env :: ElabEnv <- ElabEnv.ask()
      match func
      | CoreRef(name, ref_at):
          match env.vars.get(name, #false)
          | #false:
              cond
              | name == env.self_name:
                  return list_mk_comb(
                    env.self :~ Term,
                    specialize_call_args(type_of(env.self :~ Term), terms))
              | ~else:
                  let cty = core_const_instance(env, name, terms, ref_at)
                  return list_mk_comb(
                    mk_const(name, cty), specialize_call_args(cty, terms))
          | value:
              return list_mk_comb(
                value, specialize_call_args(type_of(value), terms))
      | ~else:
          effect:
            let head :: Term <- elaborate_effect(func)
            return list_mk_comb(
              head, specialize_call_args(type_of(head), terms))
  fun argument_effect() :: Computation:
    match func
    | CoreRef(name, _) when name == #'eq:
        elaborate_equality_arguments_effect(args)
    | CoreRef(_, _) when arguments_require_expected(args):
        elaborate_typed_arguments_effect(func :~ CoreRef, args)
    | ~else: elaborate_arguments_effect(args)
  match func
  | CoreOverloadRef(family, display_name, _):
      elaborate_dispatch_effect(family, display_name, args, at)
  | CoreRef(name, ref_at):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        let overloaded = !env.vars.get(name, #false)
                           && name != env.self_name
                           && !const_type(env.thy, name)
                           && dispatch_family(env.operators, name)
        cond
        | overloaded:
            effect:
              let term :: Term <- elaborate_dispatch_effect(name, to_string(name), args, at)
              return term
        | ~else:
            effect:
              let terms :: List.of(Term) <- argument_effect()
              apply_terms(terms)
  | ~else:
      effect:
        let terms :: List.of(Term) <- argument_effect()
        apply_terms(terms)
fun elaborate_non_numerals_effect(args :: List.of(CoreExpr)) :: Computation:
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    recur loop (remaining :~ List = args, terms :~ List = []):
      match remaining
      | []: return terms
      | List.cons(first, rest):
          cond
          | requires_expected_type(first :~ CoreExpr, env.operators):
              loop(rest, terms ++ [#false])
          | ~else:
              effect:
                let term :: Term <- elaborate_effect(first :~ CoreExpr)
                loop(rest, terms ++ [term])

fun dispatch_signature(method :: DispatchMethod) :: String:
  String.join(method.argument_types.map(type_to_string), " * ")
    ++ " -> " ++ type_to_string(method.result_type)
    ++ " via " ++ to_string(method.constant)

fun specialize_dispatch_term(term :: Term, expected :: HType) :: Term:
  cond
  | type_of(term) == expected: term
  | ~else:
      match type_match(type_of(term), expected, {})
      | #false: term
      | theta: inst_type(theta :~ Map, term)

fun numeral_apply(env :: ElabEnv, name :: Symbol,
                  args :: List.of(Term), at :: Syntax) :: Term:
  let cty = core_const_instance(env, name, args, at)
  list_mk_comb(mk_const(name, cty), specialize_call_args(cty, args))

fun nat_numeral(env :: ElabEnv, value :: NonnegInt, at :: Syntax) :: Term:
  let zero_term = numeral_apply(env, #'zero, [], at)
  recur build (remaining = value, term = zero_term):
    (if remaining == 0
     | term
     | build(remaining - 1, numeral_apply(env, #'succ, [term], at)))

fun elaborate_numeral(env :: ElabEnv, value :: NonnegInt,
                      expected :: HType, at :: Syntax) :: Term:
  cond
  | expected == mk_tyapp(#'Nat, []): nat_numeral(env, value, at)
  | expected == mk_tyapp(#'Integer, []):
      numeral_apply(env, #'int_from_nat, [nat_numeral(env, value, at)], at)
  | expected == mk_tyapp(#'Rational, []):
      let integer = numeral_apply(
                      env, #'int_from_nat,
                      [nat_numeral(env, value, at)], at)
      numeral_apply(env, #'rational_from_integer, [integer], at)
  | ~else:
      syntax_error(env.who,
                   "a numeral has no representation at type "
                     ++ type_to_string(expected),
                   at)

fun elaborate_dispatch_effect(family_name :: Symbol,
                              display_name :: String,
                              args :: List.of(CoreExpr),
                              at :: Syntax,
                              ~expected: expected_result :: maybe(HType) = #false)
     :: Computation:
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    let family = dispatch_family(env.operators, family_name)
    unless family
    | syntax_error(env.who,
                   "unknown dispatch family " ++ to_string(family_name),
                   at)
    let family :~ DispatchFamily = family
    unless args.length() == family.arity
    | syntax_error(env.who,
                   "`" ++ display_name ++ "` expects "
                     ++ to_string(family.arity) ++ " arguments",
                   at)
    let known :: List <- elaborate_non_numerals_effect(args)
    let argument_types:
      known.map(
        fun (term):
          match term
          | #false: #false
          | value: type_of(value :~ Term))
    let matches = resolve_dispatch(
                    env.operators, family_name,
                    argument_types, expected_result)
    when matches.length() == 0
    | let signatures = dispatch_candidates(env.operators, family_name).map(
                         fun (method :: DispatchMethod):
                           dispatch_signature(method))
      syntax_error(
        env.who,
        "`" ++ display_name ++ "` has no applicable dispatch"
          ++ (if signatures.length() == 0
              | ""
              | "\navailable methods:\n  "
                  ++ String.join(signatures, "\n  ")),
        at)
    when matches.length() > 1
    | let candidates = matches.map(
                         fun (resolution :: DispatchResolution):
                           dispatch_signature(resolution.method))
      syntax_error(env.who,
                   "`" ++ display_name ++ "` has ambiguous dispatch"
                     ++ "\ncandidates:\n  "
                     ++ String.join(candidates, "\n  "),
                   at)
    let resolution :~ DispatchResolution = matches[0]
    let method = resolution.method
    fun finish(index :: NonnegInt,
               out :: List.of(Term)) :: Computation:
      cond
      | index == args.length(): return out
      | ~else:
          match known[index]
          | #false:
              effect:
                let term :: Term <- check_core(
                                     args[index] :~ CoreExpr,
                                     resolution.argument_types[index])
                finish(index + 1, out ++ [term])
          | term:
              finish(
                index + 1,
                out ++ [specialize_dispatch_term(
                          term :~ Term,
                          resolution.argument_types[index])])
    let terms :: List.of(Term) <- finish(0, [])
    let ordered = method.argument_order.map(
                    fun (index): terms[index] :~ Term)
    return numeral_apply(env, method.constant, ordered, at)


fun elaborate_binders_effect(binders :: List.of(CoreBinder), body :: CoreExpr,
                             is_forall :: Boolean) :: Computation:
  fun elaborate_in(env :: ElabEnv) :: Computation:
    let vars = for List (binder in binders):
                 let binder :~ CoreBinder = binder
                 mk_var(binder.name, parse_type(binder.type_stx, env.tyvars))
    let vars2 = for values(bindings :~ Map = env.vars) (variable in vars):
                  bindings ++ {(variable :~ FVar).name: variable :~ Term}
    fun close(inner :: Term) :: Computation:
      let build = (if is_forall | mk_forall | mk_exists)
      return for values(term :~ Term = inner) (variable in vars.reverse()):
               build(variable, term)
    effect:
      let inner :: Term <- ElabEnv.local(fun (_): sub_env(env, vars2),
                                         elaborate_effect(body))
      close(inner)
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    elaborate_in(env)

fun elaborate_if_effect(condition_expr :: CoreExpr, then_expr :: CoreExpr,
                        else_expr :: CoreExpr, at :: Syntax) :: Computation:
  effect:
    let condition :: Term <- elaborate_effect(condition_expr)
    let env :: ElabEnv <- ElabEnv.ask()
    unless type_of(condition) == bool
    | syntax_error(env.who, "the condition of an `if` must be a Boolean", at)
    let then_term :: Term <- elaborate_effect(then_expr)
    let else_term :: Term <- elaborate_effect(else_expr)
    unless type_of(then_term) == type_of(else_term)
    | syntax_error(env.who,
                   "the two branches of an `if` have different types",
                   at)
    return mk_cond(condition, then_term, else_term)

fun elaborate_effect(expr :: CoreExpr) :: Computation:
  match expr
  | CoreRef(name, at):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        return core_lookup(env, name, at)
  | CoreCall(func, args, at): core_apply_effect(func, args, at)
  | CoreOverloadRef(_, _, at):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        syntax_error(env.who, "an overloaded reference must be called", at)
  | CoreNumeral(_, at):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        syntax_error(env.who,
                     "a numeral needs an expected numeric type from an operator",
                     at)
  | CoreIf(condition_expr, then_expr, else_expr, at):
      elaborate_if_effect(condition_expr, then_expr, else_expr, at)
  | CoreForall(binders, body, _):
      elaborate_binders_effect(binders, body, #true)
  | CoreExists(binders, body, _):
      elaborate_binders_effect(binders, body, #false)
  | ~else: error(~who: #'elaborate_effect, "unknown CoreExpr variant")

// Domain operations expose inference and checking without leaking Reader,
// State, or Fail into callers. `type_unify` installs its State/Fail handlers
// locally while Reader remains ambient to this expression computation.
fun infer_core(expr :: CoreExpr) :: Computation:
  elaborate_effect(expr)

fun requires_expected_type(
      expr :: CoreExpr,
      operators :: maybe(DispatchRegistry) = #false) :: Boolean:
  fun any_arg(args :: List.of(CoreExpr)) :: Boolean:
    for values(found = #false) (arg in args):
      found || requires_expected_type(arg :~ CoreExpr, operators)
  fun every_arg(args :: List.of(CoreExpr)) :: Boolean:
    args.length() == 0
      || for values(all = #true) (arg in args):
           all && requires_expected_type(arg :~ CoreExpr, operators)
  match expr
  | CoreNumeral(_, _): #true
  | CoreCall(CoreOverloadRef(_, _, _), args, _): every_arg(args)
  | CoreCall(CoreRef(name, _), args, _):
      (if operators
            && dispatch_family(operators :~ DispatchRegistry, name) != #false
       | args.length() == 0 || any_arg(args)
       | any_arg(args))
  | CoreCall(_, args, _): any_arg(args)
  | CoreOverloadRef(_, _, _): #true
  | CoreIf(_, then_expr, else_expr, _):
      requires_expected_type(then_expr, operators)
        || requires_expected_type(else_expr, operators)
  | ~else: #false

fun check_core(expr :: CoreExpr, expected :: HType) :: Computation:
  match expr
  | CoreNumeral(value, at):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        return elaborate_numeral(env, value, expected, at)
  | CoreCall(CoreOverloadRef(family, display_name, _), args, at):
      elaborate_dispatch_effect(
        family, display_name, args, at, ~expected: expected)
  | CoreCall(CoreRef(name, ref_at), args, at):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        let overloaded = !env.vars.get(name, #false)
                           && name != env.self_name
                           && !const_type(env.thy, name)
                           && dispatch_family(env.operators, name)
        cond
        | overloaded:
            effect:
              let term :: Term <- elaborate_dispatch_effect(name, to_string(name), args, at, ~expected: expected)
              return term
        | ~else:
            effect:
              let term :: Term <- infer_core(expr)
              match type_match(type_of(term), expected, {})
              | theta: return inst_type(theta :~ Map, term)
              | #false:
                  error(~who: #'check_core,
                        "expression has an unexpected type")
  | CoreOverloadRef(_, _, at):
      effect:
        let env :: ElabEnv <- ElabEnv.ask()
        syntax_error(env.who, "an overloaded reference must be called", at)
  | CoreIf(condition_expr, then_expr, else_expr, at):
      effect:
        let condition :: Term <- infer_core(condition_expr)
        let env :: ElabEnv <- ElabEnv.ask()
        unless type_of(condition) == bool
        | syntax_error(env.who, "the condition of an `if` must be a Boolean", at)
        let then_term :: Term <- check_core(then_expr, expected)
        let else_term :: Term <- check_core(else_expr, expected)
        return mk_cond(condition, then_term, else_term)
  | ~else:
      effect:
        let term :: Term <- infer_core(expr)
        match type_match(type_of(term), expected, {})
        | theta:
            let specialized = inst_type(theta :~ Map, term)
            unless type_of(specialized) == expected
            | error(~who: #'check_core, "expression has an unexpected type")
            return specialized
        | #false:
            error(~who: #'check_core, "expression has an unexpected type")

fun run_elaboration(env :: ElabEnv, expr :: CoreExpr) :: Term:
  match ElabEnv.handle(env, infer_core(expr))
  | Pure(term): term :~ Term
  | ~else: error(~who: #'run_elaboration, "internal error: unhandled effect")

fun run_checked_elaboration(env :: ElabEnv, expr :: CoreExpr,
                            expected :: HType) :: Term:
  match ElabEnv.handle(env, check_core(expr, expected))
  | Pure(term): term :~ Term
  | ~else:
      error(~who: #'run_checked_elaboration,
            "internal error: unhandled effect")

fun parse_type_effect(stx :: Syntax) :: Computation:
  effect:
    let env :: ElabEnv <- ElabEnv.ask()
    return parse_type(stx, env.tyvars)

fun run_type_elaboration(env :: ElabEnv, stx :: Syntax) :: HType:
  match ElabEnv.handle(env, parse_type_effect(stx))
  | Pure(ty): ty :~ HType
  | ~else: error(~who: #'run_type_elaboration, "internal error: unhandled effect")

fun parse_core_prop(thy :: Theory, tyvars :: List.of(Symbol),
                    vars :: Map.of(Symbol, Term),
                    expr :: CoreExpr,
                    ~operators: operators :: DispatchRegistry = standard_dispatch_registry()) :: Term:
  run_elaboration(ElabEnv(thy, tyvars, vars, #'prop, #false, #false,
                          operators), expr)

fun append_unique(base :: List.of(Symbol),
                  more :: List.of(Symbol)) :: List.of(Symbol):
  for values(acc :~ List = base) (n in more):
    (if acc.contains(n) | acc | acc ++ [n])

fun core_type_vars(expr :: CoreExpr) :: List.of(Symbol):
  fun binders_vars(bs :: List.of(CoreBinder)) :: List.of(Symbol):
    for values(acc :~ List = []) (b in bs):
      append_unique(acc, collect_type_vars((b :~ CoreBinder).type_stx))
  match expr
  | CoreRef(_, _): []
  | CoreCall(func, args, _):
      for values(acc :~ List = core_type_vars(func)) (a in args):
        append_unique(acc, core_type_vars(a))
  | CoreIf(c, t, e, _):
      append_unique(core_type_vars(c),
                    append_unique(core_type_vars(t), core_type_vars(e)))
  | CoreForall(bs, body, _):
      append_unique(binders_vars(bs), core_type_vars(body))
  | CoreOverloadRef(_, _, _): []
  | CoreNumeral(_, _): []
  | CoreExists(bs, body, _):
      append_unique(binders_vars(bs), core_type_vars(body))
  | ~else: []

fun leading_core_binder_names(expr :: CoreExpr) :: List.of(Symbol):
  match expr
  | CoreForall(bs, body, _):
      bs.map(fun (b :: CoreBinder): b.name)
        ++ leading_core_binder_names(body)
  | ~else: []

fun elaborate_theorem_statement(
      thy :: Theory, expr :: CoreExpr,
      ~operators: operators :: DispatchRegistry = standard_dispatch_registry())
     :: values(Term, List.of(Symbol)):
  let tyvars = core_type_vars(expr)
  values(parse_core_prop(thy, tyvars, {}, expr, ~operators: operators),
         leading_core_binder_names(expr))

// -- CoreFunctionSpec elaboration -------------------------------------------

fun spec_type_vars(spec :: CoreFunctionSpec) :: List.of(Symbol):
  let from_params:
    for values(acc :~ List = []) (b in spec.params):
      append_unique(acc, collect_type_vars((b :~ CoreBinder).type_stx))
  append_unique(from_params, collect_type_vars(spec.result_type))

fun core_ctor_pattern(thy :: Theory, cname :: Symbol,
                      args :: List.of(CorePattern), scrut_ty :: HType,
                      at :: Syntax) :: values(Term, List.of(FVar)):
  let gty = (match const_type(thy, cname)
             | #false: syntax_error(#'function, "unknown constructor", at)
             | t: t)
  let (doms, res) = peel_fun(gty, args.length())
  let tyin = (match type_match(res, scrut_ty, {})
              | #false:
                  syntax_error(#'function,
                               "constructor does not build the matched type",
                               at)
              | m: m)
  let field_tys = doms.map(fun (d :: HType): type_subst(tyin, d))
  let parsed = for List (arg in args, ty in field_tys):
                 core_sub_pattern(thy, arg, ty :~ HType)
  let subpats = parsed.map(fun (pair :: List): pair[0] :~ Term)
  let bound = for values(acc :~ List = []) (pair in parsed):
                acc ++ (pair :~ List)[1]
  values(list_mk_comb(mk_const(cname, type_subst(tyin, gty)), subpats),
         bound)

fun core_sub_pattern(thy :: Theory, pat :: CorePattern,
                     ty :: HType) :: List:
  match pat
  | CorePatWildcard(_):
      let fv = fresh_wildcard(ty)
      [fv :~ Term, [fv]]
  | CorePatVar(name, _):
      let fv = mk_var(name, ty)
      [fv :~ Term, [fv]]
  | CorePatCtor(name, args, at):
      let (term, bound) = core_ctor_pattern(thy, name, args, ty, at)
      [term, bound]
  | ~else: error(~who: #'function, "unknown CorePattern variant")

class ClauseEnv(thy :: Theory,
                self_name :: Symbol,
                self :: Term,
                pats :: List.of(Term),
                vars :: Map.of(Symbol, Term),
                at :: Syntax,
                result_type :: HType,
                operators :: DispatchRegistry):
  reader_effect

fun core_parse_body(body :: CoreFunBody) :: Computation:
  effect:
    let env :: ClauseEnv <- ClauseEnv.ask()
    match body
    | CoreBodyRows(rows, _):
        core_clause_rows(rows)
    | CoreBodyMatch(scrutinee, clauses, body_at):
        let v = matched_var(env.vars, env.pats, scrutinee, body_at)
        core_parse_clauses(v, clauses)
    | CoreBodyLet(name, init, tail, _):
        effect:
          let value = run_elaboration(
                        ElabEnv(env.thy, [], env.vars, #'function,
                                env.self_name, env.self, env.operators),
                        init)
          let vars2 = env.vars ++ {name: value}
          fun bind_let(_):
            ClauseEnv(env.thy, env.self_name, env.self, env.pats,
                      vars2, env.at, env.result_type, env.operators)
          let clauses :: List <- ClauseEnv.local(bind_let, core_parse_body(tail))
          return for List (clause in clauses):
                   let clause :~ DefClause = clause
                   let core = EvalCoreLet(name, EvalCoreLeaf(value),
                                          clause_core(clause))
                   DefClause(clause.pats, eval_core_term(core),
                             eval_core_obligations(core))
    | CoreBodyExpr(expr, _):
        let elab_env = ElabEnv(
                         env.thy, [], env.vars, #'function,
                         env.self_name, env.self, env.operators)
        let value = (if requires_expected_type(expr, env.operators)
                     | run_checked_elaboration(
                         elab_env, expr, env.result_type)
                     | run_elaboration(elab_env, expr))
        return [DefClause(env.pats, value, [value])]
    | ~else: error(~who: #'function, "unknown CoreFunBody variant")

fun core_parse_clauses(v :: FVar,
                       clauses :: List.of(CoreMatchClause)) :: Computation:
  recur loop (remaining :~ List = clauses, acc :~ List = []):
    match remaining
    | []: return acc
    | List.cons(clause, rest):
        effect:
          let parsed :: List <- core_parse_clause(
                                  v, clause :~ CoreMatchClause)
          loop(rest, acc ++ parsed)

fun core_parse_clause(v :: FVar,
                      clause :: CoreMatchClause) :: Computation:
  effect:
    let env :: ClauseEnv <- ClauseEnv.ask()
    match clause.pattern
    | CorePatWildcard(_):
        core_parse_body(clause.body)
    | CorePatCtor(name, args, pat_at):
        let (pat, bound) = core_ctor_pattern(
                             env.thy, name, args, v.ty, pat_at)
        let vars2 = for values(m :~ Map = env.vars) (bv in bound):
                      m ++ {(bv :~ FVar).name: bv :~ Term}
        fun bind_pattern(_):
          ClauseEnv(env.thy, env.self_name, env.self,
                    refine_pats(env.pats, v, pat :~ Term),
                    vars2, env.at, env.result_type, env.operators)
        ClauseEnv.local(bind_pattern, core_parse_body(clause.body))
    | ~else:
        syntax_error(#'function, "malformed match clause", clause.at)

fun core_clause_rows(rows :: List.of(CoreRow)) :: Computation:
  recur loop (remaining :~ List = rows, acc :~ List = []):
    match remaining
    | []: return acc
    | List.cons(row, rest):
        effect:
          let parsed :: List <- core_clause_row(row :~ CoreRow)
          loop(rest, acc ++ parsed)

fun core_clause_row(row :: CoreRow) :: Computation:
  effect:
    let env :: ClauseEnv <- ClauseEnv.ask()
    unless row.patterns.length() == env.pats.length()
    | syntax_error(#'function,
                   "this clause has " ++ to_string(row.patterns.length())
                     ++ " patterns but the function takes "
                     ++ to_string(env.pats.length()),
                   row.at)
    let (pats2, vars2):
      for values(ps :~ List = env.pats, e :~ Map = env.vars) (col in List.iota(row.patterns.length())):
        let v :~ FVar:
          match ps[col]
          | FVar(_, _): ps[col]
          | ~else:
              syntax_error(#'function,
                           "this argument has already been matched",
                           row.at)
        let [pat, bound] = core_sub_pattern(
                             env.thy, row.patterns[col] :~ CorePattern, v.ty)
        values(refine_pats(ps, v, pat :~ Term),
               for values(m :~ Map = e) (bv in bound :~ List):
                 m ++ {(bv :~ FVar).name: bv :~ Term})
    fun bind_row(_):
      ClauseEnv(env.thy, env.self_name, env.self, pats2, vars2, env.at,
                env.result_type, env.operators)
    ClauseEnv.local(bind_row, core_parse_body(row.body))

fun elaborate_function_decl(
      thy :: Theory, spec :: CoreFunctionSpec,
      ~operators: operators :: DispatchRegistry = standard_dispatch_registry())
     :: FunSpec:
  let tyvars = spec_type_vars(spec)
  let bindings:
    for List (b in spec.params):
      let b :~ CoreBinder = b
      [b.name, parse_type(b.type_stx, tyvars)]
  let arg_tys :~ List = bindings.map(fun (b :: List): b[1] :~ HType)
  let result_ty = parse_type(spec.result_type, tyvars)
  let fty = for values(t :~ HType = result_ty) (a in arg_tys.reverse()):
              mk_fun(a, t)
  let self = mk_const(spec.name, fty)
  let pvars = for List (b in bindings):
                mk_var((b :~ List)[0], (b :~ List)[1])
  let env0 = for values(m :~ Map = {}) (v in pvars):
               m ++ {(v :~ FVar).name: v :~ Term}
  let measure:
    match spec.measure
    | #false: #false
    | expr:
        let value = run_elaboration(
                      ElabEnv(thy, tyvars, env0, #'function, #false, #false,
                              operators),
                      expr :~ CoreExpr)
        list_mk_abs(pvars, value)
  let clause_env = ClauseEnv(
                     thy, spec.name, self,
                     pvars.map(fun (v :: FVar): v :~ Term),
                     env0, spec.at, result_ty, operators)
  let clauses0 :~ List:
    match ClauseEnv.handle(clause_env, core_parse_body(spec.body))
    | Pure(clauses): clauses :~ List
    | ~else:
        error(~who: #'elaborate_function_decl,
              "internal error: unhandled effect")
  // A polymorphic constructor can leave phantom result parameters fresh
  // (`left(x)` does not mention the right-hand sum type). Specialize those
  // parameters from the declared function result before validating clauses.
  let clauses = for List (cl in clauses0):
                  let cl :~ DefClause = cl
                  match type_match(type_of(cl.rhs), result_ty, {})
                  | #false: cl
                  | theta:
                      DefClause(cl.pats,
                                inst_type(theta :~ Map, cl.rhs),
                                cl.obligations.map(
                                  fun (o :: Term): inst_type(theta :~ Map, o)))
  FunSpec(spec.name, arg_tys, result_ty, clauses, measure)

fun sub_env(env :: ElabEnv, vars :: Map.of(Symbol, Term)) :: ElabEnv:
  ElabEnv(env.thy, env.tyvars, vars, env.mode, env.self_name, env.self,
          env.operators)

// ============================================================================
// Tactics
// ============================================================================
//
// A `proof:` block is a sequence of declarative tactic groups. The block
// itself is the boundary: each group configures the one existing waterfall
// invocation, and none executes as a run-time Rhombus expression. `use`,
// `skip`, `disable`, `split`, and `choose` accumulate in source order, while
// `induct` and `limit` are singletons.
//
// `skip` names waterfall stages to omit for this proof only. The recognised
// names are `simplify`, `eliminate`, `fertilize`, `generalize`, `irrelevance`
// and `induct`; see `waterfall.rhm`'s pipeline comment.
//
// `disable` removes rules from this proof only, layered on top of module-level
// `disable_rules`/`enable_rules` declarations. `use` enables named theorem
// rules for this proof only. `split` splits the goal on Boolean terms before
// the waterfall; `choose` supplies existential candidates.
//
// Returns `[induct, using, skipped_stages, disabled_rules, cases, witnesses,
// search_steps]`.
fun parse_tactic(stx :: maybe(Syntax)) :: List:
  match stx
  | #false: [#false, [], [], [], [], [], #false]
  | s :~ Syntax:
      match s
      | '$group; ...': parse_tactic_groups([group, ...])
      | ~else: syntax_error(#'proof, "unknown proof tactic", s)

fun parse_tactic_groups(groups :: List.of(Syntax)) :: List:
  recur loop (remaining :~ List = groups,
              acc :~ List = [#false, [], [], [], [], [], #false]):
    match remaining
    | []: acc
    | List.cons(group, rest):
        let rest :~ List = rest
        match group
        | 'induct($(n :: Identifier))':
            match acc[0]
            | #false:
                loop(rest,
                     [Syntax.unwrap(n), acc[1], acc[2], acc[3], acc[4],
                      acc[5], acc[6]])
            | ~else:
                syntax_error(#'proof, "duplicate `induct` tactic", group)
        | 'induct($arg, ...)':
            syntax_error(#'proof, "induct expects one identifier", group)
        | 'use([$(u :: Identifier), ...])':
            loop(rest,
                 [acc[0], (acc[1] :~ List) ++ [Syntax.unwrap(u), ...],
                  acc[2], acc[3], acc[4], acc[5], acc[6]])
        | 'use($rest ...)':
            syntax_error(#'proof,
                         "use expects one bracketed list of theorem names",
                         group)
        | 'skip([$(d :: Identifier), ...])':
            loop(rest,
                 [acc[0], acc[1],
                  (acc[2] :~ List) ++ [Syntax.unwrap(d), ...],
                  acc[3], acc[4], acc[5], acc[6]])
        | 'skip($rest ...)':
            syntax_error(#'proof,
                         "skip expects one bracketed list of stage names",
                         group)
        | 'disable([$(r :: Identifier), ...])':
            loop(rest,
                 [acc[0], acc[1], acc[2],
                  (acc[3] :~ List) ++ [Syntax.unwrap(r), ...],
                  acc[4], acc[5], acc[6]])
        | 'disable($rest ...)':
            syntax_error(#'proof,
                         "disable expects one bracketed list of rule names",
                         group)
        | 'split($c)':
            loop(rest,
                 [acc[0], acc[1], acc[2], acc[3],
                  (acc[4] :~ List) ++ [c], acc[5], acc[6]])
        | 'split($rest ...)':
            syntax_error(#'proof, "split expects one proposition", group)
        | 'choose($w)':
            loop(rest,
                 [acc[0], acc[1], acc[2], acc[3], acc[4],
                  (acc[5] :~ List) ++ [w], acc[6]])
        | 'choose($rest ...)':
            syntax_error(#'proof, "choose expects one term", group)
        | 'limit($(n :: Int))':
            let steps = Syntax.unwrap(n)
            unless steps >= 0
            | syntax_error(#'proof, "search steps cannot be negative", group)
            match acc[6]
            | #false:
                loop(rest,
                     [acc[0], acc[1], acc[2], acc[3], acc[4], acc[5], steps])
            | ~else:
                syntax_error(#'proof, "duplicate `limit` tactic", group)
        | 'limit($rest ...)':
            syntax_error(#'proof, "limit expects one nonnegative integer", group)
        | ~else:
            syntax_error(#'proof, "unknown proof tactic", group)

// ============================================================================
// quickcheck
// ============================================================================
//
// `quickcheck` uses the same parsed HOL proposition as `theorem`. Only its
// execution controls are parsed separately here.

export:
  quickcheck_options

// `[samples, size, seed]`. `~size` bounds generated value depth.
fun quickcheck_options(opts :: List.of(Syntax)) :: List:
  for values(acc :~ List = [100, 6, 20240904]) (o in opts):
    match o
    | '~samples: $(n :: Int)': [Syntax.unwrap(n), acc[1], acc[2]]
    | '~size: $(n :: Int)': [acc[0], Syntax.unwrap(n), acc[2]]
    | '~seed: $(n :: Int)': [acc[0], acc[1], Syntax.unwrap(n)]
    | ~else: syntax_error(#'quickcheck, "unknown option", o)
