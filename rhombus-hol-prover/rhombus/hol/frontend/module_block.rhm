#lang rhombus/and_meta
// SPDX-License-Identifier: 0BSD
// QuickCheck is a design reference for generated testing support; see THIRD_PARTY_NOTICES.


// Macro expansion for the declarations of `#lang rhombus/hol`.
//
// Each public declaration macro recognises and emits one declaration. Its
// encoded logical transition is accumulated in an `ExpansionState` carried by
// a syntax parameter. The parameter contains a fresh box for each module, so
// mutating it cannot leak state through a transformer instance reused by
// `raco make`.
//
// `#%module_block` only installs that expansion-local box, splices the source
// body, and appends a finalizer. The finalizer emits the accumulated logical
// transitions as ordinary phase-1 `_hol_st0`, `_hol_st1`, ... definitions in
// the private `hol_theory` submodule.
//
// All syntax templates live here. A template built in a phase-0 helper module
// loses its bindings on the way out of a phase-1 macro -- `'def x = 1'`
// written there and returned from a macro reports `def: unbound identifier` --
// so `expand.rhm` and `elab.rhm` analyse, and this module emits.

import:
  rhombus/meta open
  rhombus/hol/qc as _hol_qc
  rhombus/hol/frontend/surface_space!meta:
    expose:
      hol_expr_meta
      encode_binder
      encode_pattern
      encode_function_body
  meta:
    lib("racket/base.rkt") as rb
    rhombus/hol/htype open
    rhombus/hol/frontend/tyunify open
    rhombus/hol/datatype/datatype open
    rhombus/hol/datatype/algebra open
    rhombus/hol/frontend/expand as expand
    rhombus/hol/frontend/elab as elab
    rhombus/hol/frontend/overload open
    rhombus/hol/frontend/surface_state open
    rhombus/hol/frontend/type/constructor open
    rhombus/hol/frontend/type/registry open
    rhombus/hol/frontend/type/parse as type_parser
    rhombus/hol/frontend/type/print open
    rhombus/hol/frontend/surface_core open
export:
  module_block
  datatype
  inductive
  definition
  function
  theorem
  proof
  overload
  quickcheck
  hol_import

meta:
  // Any literal from this module will do as a lexical context: what matters is
  // that all the generated identifiers share one, and that the expander's
  // introduction scope lands on them alike.
  def id_ctx :: Syntax = 'hol_state'
  Parameter.def runtime_context :: Syntax = id_ctx
  Parameter.def runtime_inference :: Box = Box({})
  // Mirrors `elab.rhm`'s `restricted_refs`: a local `let`-bound function's own
  // name, and every later local function name in the same body, is off
  // limits while elaborating *that* `let`'s initializer -- self- and
  // forward-recursion through local function sugar are not supported. The
  // logical path enforces this in `ElabEnv.restricted_refs`; this parameter
  // gives the runtime/executable emission path (a separate walk over the
  // same `CoreFunBody`, see the note atop `elab.rhm`) the same check, so a
  // rejected declaration is rejected for the reason it actually violates
  // instead of falling through to a generic "unknown constant".
  Parameter.def runtime_restricted_names :: Map.of(Symbol, String) = {}

  fun runtime_substitution() :: Map.of(Symbol, HType):
    (runtime_inference().value :~ Map)

  // Shares `elab.rhm`'s chain-following resolver rather than a second copy:
  // the runtime path's accumulated substitution chains variable-to-variable
  // exactly the way the logical path's does (see `elab.rhm`'s `deep_resolve`
  // for why a single-level `type_subst` is not enough), and a fork here
  // would only let the two paths' resolved types drift apart again.
  fun runtime_resolve_type(ty :: HType) :: HType:
    elab.deep_resolve(runtime_substitution(), ty, [])

  fun runtime_unify(left :: HType, right :: HType,
                    at :: Syntax, message :: String):
    match type_unify(
            runtime_resolve_type(left), runtime_resolve_type(right),
            runtime_substitution())
    | #false: syntax_meta.error(message, at)
    | substitution:
        runtime_inference().value := substitution


  fun st(n :: Int) :: Syntax:
    Syntax.make_id("_hol_st" ++ to_string(n), id_ctx)

  // Expansion-local wrapper around importable surface metadata. Imports stay
  // deferred until a state-dependent declaration actually needs them.
  class SurfaceContext(surface :: SurfaceState,
                       pending_imports :: List.of(List.of(Syntax)))

  def initial_surface_context:
    SurfaceContext(
      SurfaceState(standard_overload_registry(), {}, {},
                   standard_type_constructor_registry()),
      [])

  // Per-module expansion state. The syntax-parameter binding is rebound at
  // the start of every module, so no value is shared through the transformer
  // instance that `raco make` reuses for other modules.
  class ExpansionState(next_index :: NonnegInt,
                       surface :: SurfaceContext,
                       steps_rev :: List.of(Syntax))

  fun initial_expansion_state() :: ExpansionState:
    ExpansionState(0, initial_surface_context, [])

  fun imported_surface_context(terms :: List.of(Syntax)) :: SurfaceContext:
    let [t, ...] = terms
    let path:
      match ModulePath.maybe('$t ...')
      | #false: error(~who: #'import, "invalid imported theory path")
      | p: p :~ ModulePath
    let imported = Evaluator.instantiate(
                     path.add(ModulePath('self ! hol_surface')), #'state)
    let imported :~ SurfaceState = imported
    SurfaceContext(imported, [])

  fun force_surface_context(context :: SurfaceContext) :: SurfaceContext:
    for values(current :~ SurfaceContext = context) (
          terms in context.pending_imports):
      let imported = imported_surface_context(terms :~ List.of(Syntax))
      SurfaceContext(
        merge_surface_states(imported.surface, current.surface),
        [])

  fun defer_surface_import(context :: SurfaceContext,
                           terms :: List.of(Syntax)) :: SurfaceContext:
    SurfaceContext(context.surface, context.pending_imports ++ [terms])

  fun surface_const_type(context :: SurfaceContext, name :: Symbol)
       :: maybe(HType):
    context.surface.constants.get(name, #false)


  fun overload_argument_position(argument_names :: List,
                                 name :: Symbol,
                                 at :: Syntax) :: NonnegInt:
    recur find (index = 0):
      cond
      | index == argument_names.length():
          syntax_meta.error(
            "implementation template uses an unknown overload argument `"
              ++ to_string(name) ++ "`",
            at)
      | argument_names[index] == name: index
      | ~else: find(index + 1)

  fun overload_argument_order(argument_names :: List,
                              template_arguments :: maybe(List.of(Symbol)),
                              at :: Syntax) :: List.of(NonnegInt):
    let arity = argument_names.length()
    match template_arguments
    | #false: List.iota(arity)
    | arguments:
        when argument_names.contains(#false)
        | syntax_meta.error(
            "an implementation template needs named overload arguments", at)
        let order:
          for List (argument in (arguments :~ List.of(Symbol))):
            overload_argument_position(argument_names, argument, at)
        unless valid_argument_order(order, arity)
        | syntax_meta.error(
            "implementation template must use every overload argument "
              ++ "exactly once",
            at)
        order

  fun surface_add_method(
        context :: SurfaceContext, function_name :: Symbol,
        argument_type_stxs :: List.of(Syntax),
        result_type_stx :: maybe(Syntax),
        constant :: Symbol, argument_order :: List.of(NonnegInt),
        at :: Syntax) :: SurfaceContext:
    let ready = force_surface_context(context)
    let arity = argument_type_stxs.length()
    let registry_with_function = ensure_overload_function(
                                   ready.surface.operators,
                                   function_name, arity)
    let argument_types = argument_type_stxs.map(
                           fun (argument):
                             type_parser.parse_open_type(
                               argument,
                               ready.surface.type_constructors))
    let result_type:
      match result_type_stx
      | #false: #false
      | result_stx:
          type_parser.parse_open_type(
            result_stx :~ Syntax,
            ready.surface.type_constructors)
    let constant_type:
      match surface_const_type(ready, constant)
      | #false:
          syntax_meta.error(
            "implementation constant is not declared: "
              ++ to_string(constant),
            at)
      | ty: ty :~ HType
    let method:
      try:
        build_overload_method(
          function_name, argument_types, result_type,
          constant, constant_type, argument_order)
        ~catch e :: Exn.Fail:
          syntax_meta.error(e.message, at)
    SurfaceContext(
      SurfaceState(
        add_overload_method(registry_with_function, method),
        ready.surface.constants,
        ready.surface.runtime_arities,
        ready.surface.type_constructors),
      ready.pending_imports)

  fun core_pattern_name(pat :: CorePattern, who :: String) :: Symbol:
    match pat
    | CorePatVar(name, _): name
    | CorePatTyped(inner, _, _): core_pattern_name(inner, who)
    | ~else:
        syntax_meta.error(
          who ++ " currently needs a named binding pattern",
          (match pat
           | CorePatWildcard(at): at
           | CorePatCtor(_, _, at): at
           | CorePatLiteral(_, at): at
           | CorePatList(_, _, at): at
           | CorePatPair(_, _, at): at
           | CorePatTyped(_, _, at): at
           | CorePatVar(_, at): at))

  fun following_local_function_names(body :: CoreFunBody) :: List.of(Symbol):
    match body
    | CoreBodyLet(binding_pat, init, tail, _):
        let following = following_local_function_names(tail)
        (if init is_a CoreFunctionExpr
         | [core_pattern_name(binding_pat, "a local function needs a name")]
             ++ following
         | following)
    | ~else: []

  fun surface_optional_type(type_stx :: maybe(Syntax),
                            registry :: TypeConstructorRegistry,
                            hint :: String) :: HType:
    match type_stx
    | #false: mk_tyvar(Symbol.gen(hint))
    | stx: type_parser.parse_open_type(stx :~ Syntax, registry)

  fun surface_add_function(context :: SurfaceContext,
                           spec :: CoreFunctionSpec,
                           full_type :: HType)
       :: SurfaceContext:
    let ready = force_surface_context(context)
    SurfaceContext(
      SurfaceState(
        ready.surface.operators,
        ready.surface.constants ++ {spec.name: full_type},
        ready.surface.runtime_arities
          ++ {spec.name: spec.params.length()},
        ready.surface.type_constructors),
      [])


  fun surface_add_datatype(context :: SurfaceContext, spec :: DatatypeSpec)
       :: SurfaceContext:
    let additions:
      for values(out :~ Map = context.surface.constants) (ctor in spec.ctors):
        let ctor :~ Ctor = ctor
        out ++ {ctor.name: ctor_type(spec, ctor)}
    let runtime_arities:
      for values(out :~ Map = context.surface.runtime_arities) (
            ctor in spec.ctors):
        let ctor :~ Ctor = ctor
        out ++ {ctor.name: ctor.fields.length()}
    let type_constructors = add_declared_type_constructor(
                              context.surface.type_constructors,
                              spec.name, spec.params)
    SurfaceContext(
      SurfaceState(context.surface.operators, additions, runtime_arities,
                   type_constructors),
      context.pending_imports)

  fun surface_symbol_expr(name :: Symbol) :: Syntax:
    let text = Syntax.make(to_string(name), id_ctx)
    'Symbol.from_string($text)'

  fun surface_type_expr(ty :: HType) :: Syntax:
    match ty
    | TyVar(name):
        'mk_tyvar($(surface_symbol_expr(name)))'
    | TyApp(name, args):
        let [arg, ...] = args.map(surface_type_expr)
        'mk_tyapp($(surface_symbol_expr(name)), [$arg, ...])'

  fun surface_arity_expr(name :: Symbol, arity :: NonnegInt) :: Syntax:
    let arity_stx = Syntax.make(arity, id_ctx)
    '[$(surface_symbol_expr(name)), $arity_stx]'

  fun surface_method_expr(method :: OverloadMethod) :: Syntax:
    let [argument_type, ...] = method.argument_types.map(surface_type_expr)
    let result_type = surface_type_expr(method.result_type)
    let [position, ...] = method.argument_order.map(
                            fun (value): Syntax.make(value, id_ctx))
    'OverloadMethod(
       $(surface_symbol_expr(method.function)),
       [$argument_type, ...],
       $result_type,
       $(surface_symbol_expr(method.constant)),
       [$position, ...])'

  fun surface_constant_expr(name :: Symbol, ty :: HType) :: Syntax:
    '[$(surface_symbol_expr(name)), $(surface_type_expr(ty))]'
  fun surface_type_constructor_expr(
        constructor :: TypeConstructor) :: Syntax:
    let arity = Syntax.make(constructor.arity, id_ctx)
    let [parameter, ...] = constructor.parameter_names.map(
                            fun (name): surface_symbol_expr(name))
    'TypeConstructor(
       $(surface_symbol_expr(constructor.surface_name)),
       $(surface_symbol_expr(constructor.kernel_name)),
       $arity,
       [$parameter, ...])'

  fun emit_surface_state(context :: SurfaceContext) :: Syntax:
    let ready = force_surface_context(context).surface
    let function_exprs:
      for values(out :~ List = []) ((name, arity) in ready.operators.arities):
        out ++ [surface_arity_expr(name, arity :~ NonnegInt)]
    let [overload_function, ...] = function_exprs
    let [method, ...] = ready.operators.methods.map(
                          fun (value):
                            surface_method_expr(value :~ OverloadMethod))
    let constant_exprs:
      for values(out :~ List = []) ((name, ty) in ready.constants):
        out ++ [surface_constant_expr(name, ty :~ HType)]
    let [constant, ...] = constant_exprs
    let runtime_arity_exprs:
      for values(out :~ List = []) ((name, arity) in ready.runtime_arities):
        out ++ [surface_arity_expr(name, arity :~ NonnegInt)]
    let [runtime_arity, ...] = runtime_arity_exprs
    let type_constructor_exprs:
      for values(out :~ List = []) (
            (_, constructor) in ready.type_constructors.bindings):
        out ++ [surface_type_constructor_expr(
                  constructor :~ TypeConstructor)]
    let [type_constructor, ...] = type_constructor_exprs
    'module hol_surface ~lang rhombus:
       import:
         rhombus/hol/htype open
         rhombus/hol/frontend/overload open
         rhombus/hol/frontend/surface_state open
         rhombus/hol/frontend/type/constructor open
       export: state
       def state = make_surface_state(
                     [$overload_function, ...],
                     [$method, ...],
                     [$constant, ...],
                     [$runtime_arity, ...],
                     [$type_constructor, ...])'


  // A term rebuilt with this module's context.
  //
  // Needed for the terms of a module path emitted into the `hol_theory`
  // submodule: that submodule's language is plain `rhombus`, and a term
  // carrying the user's `rhombus/hol` context cannot reach the implicit import
  // forms there -- a string path fails looking for `#%literal`.  Only the
  // datum matters for a module path, so rebuilding it loses nothing.
  fun recontext(t :: Syntax) :: Syntax:
    Syntax.make(Syntax.unwrap(t), id_ctx)

  // -- datatypes -------------------------------------------------------------

  // `class.together` so that a datatype can refer to itself, and an
  // `interface` rather than a base class as the sum: an interface carries no
  // fields and imposes no field order on the variants.
  //
  // Field annotations are dropped -- that is the type erasure.  Rhombus has no
  // parametric polymorphism, so `List.of(?a)` has nothing to erase *to*, and the
  // logical side has already checked the types.
  fun emit_type(name :: Syntax, ctors :: List) :: Syntax:
    let [variant, ...] = ctors.map(fun (c :: List): emit_variant(name, c))
    'class.together:
       interface $name
       $variant
       ...'

  fun emit_variant(iface :: Syntax, c :: List) :: Syntax:
    let [cname, fields] = c
    let fs :~ List = fields
    let [f, ...] = fs
    'class $cname($f, ...):
       implements $iface'

  // -- generators and shrinkers ----------------------------------------------
  //
  // Emitted alongside a datatype, from the same declaration, so that
  // `quickcheck` has values to sample. They are ordinary Rhombus functions
  // over the emitted classes; checking runs the real executable code.
  //
  // They reach `quickcheck` through `qc.rhm`'s registry rather than through a
  // guessed identifier. `datatype` registers its generator and shrinker under the
  // type's own name when its module is instantiated. No generated helper needs
  // to be exported.
  //
  // A name has to travel as a plain string, not a `Symbol`: a symbol written
  // `#'foo` cannot appear inside a syntax template, the quote would close it.

  fun type_name_str(n :: Symbol) :: Syntax:
    Syntax.make(to_string(n), id_ctx)

  fun param_gen_id(p :: Symbol) :: Syntax:
    Syntax.make_id("_hol_g_" ++ to_string(p), id_ctx)

  // A generator expression for a type: a function from a size to a value.
  fun gen_expr(ty) :: Syntax:
    match ty
    | TyVar(a): param_gen_id(a)
    | TyApp(n, args):
        let nm = type_name_str(n)
        let [sub, ...] = args.map(fun (t): gen_expr(t))
        // Parenthesised: a `fun ...:` block cannot sit in application position
        // or before a comma without one.
        '(fun (_hol_s): _hol_qc.lookup_gen($nm)(_hol_s, $sub, ...))'

  fun shrink_expr(ty, at :: Syntax) :: Syntax:
    match ty
    | TyApp(n, _): '_hol_qc.lookup_shrink($(type_name_str(n)))'
    | ~else:
        error(~who: #'quickcheck,
              "cannot shrink a value of variable type",
              error.val(~label: "in", to_string(at)))

  fun emit_generator(name :: Syntax, params :: List, ctors :: List) :: Syntax:
    let nm = type_name_str(Syntax.unwrap(name))
    let [pg, ...] = params.map(fun (p :: Symbol): param_gen_id(p))
    let base = ctors.filter(~keep: fun (c :: List): !(c[2] :~ Boolean))
    let [b, ...] = base.map(ctor_builder)
    let [a, ...] = ctors.map(ctor_builder)
    let build = 'fun (_hol_sz, $pg, ...):
                   _hol_qc.pick(_hol_sz, [$b, ...], [$a, ...])'
    '_hol_qc.register_gen($nm, $build)'

  // `[ctor_id, [field_type, ...], recursive?]`
  fun ctor_builder(c :: List) :: Syntax:
    let cname = c[0] :~ Syntax
    let ftys :~ List = c[1]
    let [arg, ...] = ftys.map(fun (t): '$(gen_expr(t))(_hol_sz - 1)')
    'fun (): $cname($arg, ...)'

  fun emit_shrinker(name :: Syntax, ctors :: List) :: Syntax:
    let nm = type_name_str(Syntax.unwrap(name))
    let [clause, ...] = ctors.map(fun (c :: List): shrink_clause(name, c))
    let build = 'fun (_hol_v):
                   match _hol_v
                   | $clause
                   | ...'
    '_hol_qc.register_shrink($nm, $build)'

  // The classic shrink for an algebraic value: its recursive subterms.
  fun shrink_clause(tname :: Syntax, c :: List) :: Syntax:
    let cname = c[0] :~ Syntax
    let ftys :~ List = c[1]
    let n = ftys.length()
    let vs = for List (i in List.iota(n)):
               Syntax.make_id("_hol_f" ++ to_string(i), id_ctx)
    let [v, ...] = vs
    let keep = for values(acc :~ List = []) (t in ftys, vv in vs):
                 (if same_type_name(t, tname) | acc ++ [vv] | acc)
    let [k, ...] = keep
    '$cname($v, ...): [$k, ...]'

  fun same_type_name(ty, tname :: Syntax) :: Boolean:
    match ty
    | TyApp(n, _): n == Syntax.unwrap(tname)
    | ~else: #false

  // -- quickcheck -------------------------------------------------------------

  fun emit_quickcheck_in(state :: SurfaceContext,
                         name :: Syntax,
                         opts :: List.of(Syntax),
                         core :: Syntax,
                         at :: Syntax) :: Syntax:
    let expr = decode_prop(core)
    let (binders, body):
      match expr
      | CoreForall(bs, proposition, _): values(bs, proposition)
      | ~else:
          syntax_meta.error(
            "a quickcheck property starts with `forall (x :: T, ...):`",
            at)
    let ready = force_surface_context(state)
    let parsed:
      for List (binder in (binders :~ List.of(CoreBinder))):
        let binder :~ CoreBinder = binder
        let name = core_pattern_name(
                     binder.pattern, "a quickcheck binder")
        let ty:
          match binder.type_stx
          | #false:
              syntax_meta.error(
                "a quickcheck input needs an explicit concrete type",
                binder.at)
          | stx:
              type_parser.parse_open_type(
                stx :~ Syntax, ready.surface.type_constructors)
        when type_vars(ty).length() > 0
        | syntax_meta.error(
            "a quickcheck input type must be concrete", binder.at)
        [source_id(name, binder.at), name, ty]
    let env:
      for values(out :~ Map = {}) (entry in parsed):
        let entry :~ List = entry
        out ++ {entry[1] :~ Symbol: entry[2] :~ HType}
    let rendered = runtime_expr(
                     ready, env, body :~ CoreExpr,
                     mk_tyapp(#'bool, [])).stx
    let [v, ...] = parsed.map(fun (entry :: List): entry[0] :~ Syntax)
    let [g, ...] = parsed.map(fun (entry :: List): gen_expr(entry[2]))
    let [sh, ...] = parsed.map(fun (entry :: List): shrink_expr(entry[2], at))
    let [samples, size, seed] = elab.quickcheck_options(opts)
    let count = Syntax.make(samples, id_ctx)
    let sz = Syntax.make(size, id_ctx)
    let seed_stx = Syntax.make(seed, id_ctx)
    let prop = 'fun ($v, ...): $rendered'
    'import: rhombus/hol/qc as _hol_qc
     _hol_qc.assert_run(
       Syntax.unwrap('$name'),
       ~samples: $count,
       ~size: $sz,
       ~seed: $seed_stx,
       ~gens: [$g, ...],
       ~shrinks: [$sh, ...],
       ~prop: $prop)'

  fun emit_quickcheck(state :: SurfaceContext,
                      name :: Syntax,
                      opts :: List.of(Syntax),
                      core :: Syntax,
                      at :: Syntax) :: Syntax:
    parameterize { runtime_context: name }:
      parameterize { runtime_inference: Box({}) }:
        emit_quickcheck_in(state, name, opts, core, at)

  // -- functions -------------------------------------------------------------

  class RuntimeExpr(stx :: Syntax, ty :: HType)
  class RuntimeFunction(stx :: Syntax, ty :: HType)

  fun source_id(name :: Symbol, _at :: Syntax) :: Syntax:
    Syntax.make_id(to_string(name), runtime_context())

  fun runtime_call_syntax(name :: Symbol, args :: List.of(Syntax),
                          at :: Syntax) :: Syntax:
    let id = source_id(name, at)
    let [arg, ...] = args
    '$id($arg, ...)'

  // Logical constants are curried, while generated Rhombus functions accept
  // all declaration parameters at once. Adapt a named function whenever it is
  // used with fewer or more arguments than its generated runtime arity.
  fun runtime_named_apply(state :: SurfaceContext, name :: Symbol,
                          args :: List.of(Syntax), at :: Syntax) :: Syntax:
    match state.surface.runtime_arities.get(name, #false)
    | #false:
        (if args.length() == 0
         | source_id(name, at)
         | runtime_call_syntax(name, args, at))
    | declared:
        let arity :~ NonnegInt = declared
        cond
        | args.length() < arity:
            recur curry (all_args :: List.of(Syntax) = args):
              cond
              | all_args.length() == arity:
                  runtime_call_syntax(name, all_args, at)
              | ~else:
                  let parameter = source_id(Symbol.gen("_hol_arg"), at)
                  let body = curry(all_args ++ [parameter])
                  '(fun ($parameter): $body)'
        | ~else:
            let initial = runtime_call_syntax(
                            name, args.take(arity), at)
            for values(call :~ Syntax = initial) (
                  argument in args.drop(arity)):
              '$call($argument)'


  fun runtime_peel(ty :: HType, arity :: NonnegInt)
       :: values(List.of(HType), HType):
    recur loop (current = ty, remaining = arity,
                domains :~ List.of(HType) = []):
      cond
      | remaining == 0: values(domains, current)
      | is_fun(current):
          let (domain, range) = dest_fun(current)
          loop(range, remaining - 1, domains ++ [domain])
      | ~else:
          error(~who: #'overload,
                "constant has fewer arguments than required")

  fun runtime_expected_function_types(wanted :: HType,
                                      arity :: NonnegInt,
                                      at :: Syntax)
       :: values(List.of(HType), HType):
    recur loop (remaining = arity,
                current :~ HType = wanted,
                domains :~ List = []):
      cond
      | remaining == 0:
          values(domains, runtime_resolve_type(current))
      | ~else:
          let current = runtime_resolve_type(current)
          when current is_a TyVar
          | let domain = mk_tyvar(Symbol.gen("_domain"))
            let range = mk_tyvar(Symbol.gen("_range"))
            runtime_unify(
              current, mk_fun(domain, range), at,
              "a function expression does not match its expected type")
          let current = runtime_resolve_type(current)
          unless is_fun(current)
          | syntax_meta.error(
              "a function expression has more parameters than its expected type",
              at)
          let (domain, range) = dest_fun(current)
          loop(remaining - 1, range, domains ++ [domain])


  fun runtime_fresh_type(ty :: HType) :: HType:
    let renaming:
      for values(out :~ Map = {}) (v in type_vars(ty)):
        out ++ {v: mk_tyvar(Symbol.gen(to_string(v))) :~ HType}
    type_subst(renaming, ty)

  fun runtime_needs_expected(state :: SurfaceContext,
                             expr :: CoreExpr) :: Boolean:
    fun every_arg(args :: List.of(CoreExpr)) :: Boolean:
      args.length() == 0
        || for values(all = #true) (arg in args):
             all && runtime_needs_expected(state, arg :~ CoreExpr)
    match expr
    | CoreNumeral(_, _): #true
    | CoreTypedExpr(_, _, _): #false
    | CoreListExpr(elements, tail, _):
        let element_needs:
          for values(found = #false) (element in elements):
            found || runtime_needs_expected(
                       state, element :~ CoreExpr)
        elements.length() == 0
          || element_needs
          || (match tail
              | #false: #false
              | value:
                  runtime_needs_expected(state, value :~ CoreExpr))
    | CorePairExpr(first, second, _):
        runtime_needs_expected(state, first)
          || runtime_needs_expected(state, second)
    | CoreSetExpr(elements, _):
        elements.length() == 0
          || (for values(found = #false) (element in elements):
                found || runtime_needs_expected(
                           state, element :~ CoreExpr))
    | CoreCall(CoreRef(name, _), args, _) when overload_arity(state.surface.operators, name) != #false:
        every_arg(args)
    | CoreCall(_, args, _):
        for values(found = #false) (arg in args):
          found || runtime_needs_expected(state, arg :~ CoreExpr)
    | CoreIf(_, then_expr, else_expr, _):
        runtime_needs_expected(state, then_expr)
          || runtime_needs_expected(state, else_expr)
    | ~else: #false

  fun runtime_numeral(state :: SurfaceContext, value :: NonnegInt,
                      expected :: HType, at :: Syntax) :: RuntimeExpr:
    let nat_ty = mk_tyapp(#'Nat, [])
    let int_ty = mk_tyapp(#'Integer, [])
    let rational_ty = mk_tyapp(#'Rational, [])
    // The executable reading of a literal is the value `succ` applied that
    // many times to `zero()`, but the *code* for it need not be that deep:
    // the expander walks generated syntax, so a nested chain made compiling
    // `function f() :: Nat: 800` quadratic long before anything ran. A
    // counted loop builds the same value from syntax of constant size.
    //
    fun nat_syntax() :: Syntax:
      let go = source_id(Symbol.gen("_hol_numeral"), at)
      let count = source_id(Symbol.gen("_hol_count"), at)
      let zero_case = runtime_call_syntax(#'zero, [], at)
      let succ_case = runtime_call_syntax(#'succ, ['$go($count - 1)'], at)
      let literal = Syntax.make(value, runtime_context())
      '(block:
          fun $go($count):
            if $count == 0
            | $zero_case
            | $succ_case
          $go($literal))'
    cond
    | expected == nat_ty: RuntimeExpr(nat_syntax(), nat_ty)
    | expected == int_ty:
        RuntimeExpr(runtime_call_syntax(#'int_from_nat, [nat_syntax()], at),
                    int_ty)
    | expected == rational_ty:
        let integer = runtime_call_syntax(
                        #'int_from_nat, [nat_syntax()], at)
        RuntimeExpr(runtime_call_syntax(
                      #'rational_from_integer, [integer], at),
                    rational_ty)
    | ~else:
        syntax_meta.error(
          "a numeral has no representation at type "
            ++ type_to_surface_string(
                 state.surface.type_constructors, expected),
          at)

  fun runtime_overload_expr(state :: SurfaceContext,
                            env :: Map.of(Symbol, HType),
                            function_name :: Symbol,
                            args :: List.of(CoreExpr),
                            expected :: maybe(HType),
                            at :: Syntax) :: RuntimeExpr:
    let arity = overload_arity(state.surface.operators, function_name)
    unless arity
    | syntax_meta.error(
        "unknown overload function " ++ to_string(function_name), at)
    let arity :~ NonnegInt = arity
    unless args.length() == arity
    | syntax_meta.error(
        "`" ++ to_string(function_name) ++ "` expects "
          ++ to_string(arity) ++ " arguments",
        at)
    let known:
      for List (arg in args):
        let arg :~ CoreExpr = arg
        (if runtime_needs_expected(state, arg)
         | #false
         | runtime_expr(state, env, arg, #false))
    let argument_types:
      known.map(
        fun (value):
          match value
          | #false: #false
          | runtime: (runtime :~ RuntimeExpr).ty)
    let matches = resolve_overload(
                    state.surface.operators, function_name,
                    argument_types, expected)
    when matches.length() == 0
    | syntax_meta.error(
        "`" ++ to_string(function_name) ++ "` has no applicable overload",
        at)
    when matches.length() > 1
    | syntax_meta.error(
        "`" ++ to_string(function_name) ++ "` has ambiguous overload",
        at)
    let resolution :~ OverloadResolution = matches[0]
    let method = resolution.method
    let rendered:
      for List (arg in args, prior in known,
                expected_type in resolution.argument_types):
        match prior
        | runtime :: RuntimeExpr:
            match type_unify(runtime.ty, expected_type, {})
            | #false:
                syntax_meta.error(
                  "overload argument has an unexpected type", at)
            | _:
                RuntimeExpr(runtime.stx, expected_type)
        | #false:
            runtime_expr(
              state, env, arg :~ CoreExpr, expected_type)
    let ordered = method.argument_order.map(
                    fun (index):
                      (rendered[index] :~ RuntimeExpr).stx)
    RuntimeExpr(runtime_named_apply(state, method.constant, ordered, at),
                resolution.result_type)

  fun runtime_list_element_type(expected :: HType,
                                at :: Syntax) :: HType:
    match expected
    | TyApp(#'List, [element_type]): element_type
    | ~else:
        syntax_meta.error(
          "a list expression needs a `List.of(...)` type", at)

  fun runtime_list_expr(state :: SurfaceContext,
                        env :: Map.of(Symbol, HType),
                        elements :: List.of(CoreExpr),
                        tail :: maybe(CoreExpr),
                        at :: Syntax,
                        expected :: maybe(HType)) :: RuntimeExpr:
    let element_type:
      match expected
      | #false:
          match elements
          | List.cons(first, _):
              runtime_expr(state, env, first :~ CoreExpr, #false).ty
          | []:
              match tail
              | #false: mk_tyvar(Symbol.gen("_list_element"))
              | tail_expr:
                  runtime_list_element_type(
                    runtime_expr(
                      state, env, tail_expr :~ CoreExpr, #false).ty,
                    at)
      | wanted:
          let wanted = runtime_resolve_type(wanted :~ HType)
          match wanted
          | TyVar(_,):
              let element_type = mk_tyvar(Symbol.gen("_list_element"))
              runtime_unify(
                wanted, mk_tyapp(#'List, [element_type]), at,
                "a list expression needs a `List.of(...)` type")
              element_type
          | ~else:
              runtime_list_element_type(wanted, at)
    let list_type = mk_tyapp(#'List, [element_type])
    let rendered:
      elements.map(
        fun (element :: CoreExpr):
          runtime_expr(state, env, element, element_type).stx)
    let tail_stx:
      match tail
      | #false: runtime_named_apply(state, #'nil, [], at)
      | tail_expr:
          runtime_expr(
            state, env, tail_expr :~ CoreExpr, list_type).stx
    let result:
      for values(out :~ Syntax = tail_stx) (element in rendered.reverse()):
        runtime_named_apply(state, #'cons, [element :~ Syntax, out], at)
    RuntimeExpr(result, runtime_resolve_type(list_type))

  fun runtime_pair_types(expected :: HType, at :: Syntax)
      :: values(HType, HType):
    match expected
    | TyApp(name, [first_type, second_type]) when name == ty_prod:
        values(first_type, second_type)
    | ~else:
        syntax_meta.error(
          "a Pair expression needs a `Pair.of(...)` type", at)

  fun runtime_pair_expr(state :: SurfaceContext,
                        env :: Map.of(Symbol, HType),
                        first :: CoreExpr, second :: CoreExpr,
                        at :: Syntax,
                        expected :: maybe(HType)) :: RuntimeExpr:
    let (first_value, second_value):
      match expected
      | #false:
          values(runtime_expr(state, env, first, #false),
                 runtime_expr(state, env, second, #false))
      | wanted:
          let wanted = runtime_resolve_type(wanted :~ HType)
          let (first_type, second_type):
            match wanted
            | TyVar(_,):
                let first_type = mk_tyvar(Symbol.gen("_pair_first"))
                let second_type = mk_tyvar(Symbol.gen("_pair_second"))
                runtime_unify(
                  wanted, prod_ty(first_type, second_type), at,
                  "a Pair expression needs a `Pair.of(...)` type")
                values(first_type, second_type)
            | ~else: runtime_pair_types(wanted, at)
          values(runtime_expr(state, env, first, first_type),
                 runtime_expr(state, env, second, second_type))
    RuntimeExpr(
      'Pair($((first_value.stx)), $((second_value.stx)))',
      runtime_resolve_type(
        prod_ty(first_value.ty, second_value.ty)))

  // A string is `text` applied to its Unicode scalar-value list. Runtime
  // numerals use constant-depth emitted syntax; logical numerals use checked
  // native NatLit terms. Both readings denote the same ordinary Nat values.
  fun runtime_string_expr(state :: SurfaceContext, value :: String,
                          at :: Syntax) :: RuntimeExpr:
    let nat_type = mk_tyapp(#'Nat, [])
    let codes:
      for List (character in value.to_list()):
        runtime_numeral(state, character.to_int(), nat_type, at).stx
    let contents:
      for values(out :~ Syntax = runtime_named_apply(
                                          state, #'nil, [], at)) (
            code in codes.reverse()):
        runtime_named_apply(state, #'cons, [code :~ Syntax, out], at)
    RuntimeExpr(runtime_named_apply(state, #'text, [contents], at),
                mk_tyapp(#'String, []))

  fun runtime_set_element_type(expected :: HType,
                               at :: Syntax) :: HType:
    unless is_fun(expected)
    | syntax_meta.error(
        "a set expression needs a function-to-Boolean type", at)
    let (element_type, result_type) = dest_fun(expected)
    unless result_type == mk_tyapp(#'bool, [])
    | syntax_meta.error(
        "a set expression needs a function-to-Boolean type", at)
    element_type

  fun runtime_set_expr(state :: SurfaceContext,
                       env :: Map.of(Symbol, HType),
                       elements :: List.of(CoreExpr),
                       at :: Syntax,
                       expected :: maybe(HType)) :: RuntimeExpr:
    let element_type:
      match expected
      | #false:
          match elements
          | List.cons(first, _):
              runtime_expr(state, env, first :~ CoreExpr, #false).ty
          | []: mk_tyvar(Symbol.gen("_set_element"))
      | wanted:
          let wanted = runtime_resolve_type(wanted :~ HType)
          match wanted
          | TyVar(_,):
              let element_type = mk_tyvar(Symbol.gen("_set_element"))
              runtime_unify(
                wanted,
                mk_fun(element_type, mk_tyapp(#'bool, [])),
                at,
                "a set expression needs a function-to-Boolean type")
              element_type
          | ~else: runtime_set_element_type(wanted, at)
    let rendered:
      elements.map(
        fun (element :: CoreExpr):
          runtime_expr(state, env, element, element_type).stx)
    let element_type = runtime_resolve_type(element_type)
    when is_fun(element_type)
    | syntax_meta.error(
        "a set literal has no sound executable equality for function values",
        at)
    let variable = source_id(Symbol.gen("_set_element"), at)
    let predicate:
      for values(out :~ Syntax = Syntax.make(#false, at)) (
            element in rendered.reverse()):
        '(($variable) == ($(element :~ Syntax))) || ($out)'
    RuntimeExpr('(fun ($variable): $predicate)',
                mk_fun(runtime_resolve_type(element_type),
                       mk_tyapp(#'bool, [])))


  fun runtime_expr(state :: SurfaceContext, env :: Map.of(Symbol, HType),
                   expr :: CoreExpr,
                   expected :: maybe(HType) = #false) :: RuntimeExpr:
    fun ensure(value :: RuntimeExpr) :: RuntimeExpr:
      match expected
      | #false:
          RuntimeExpr(value.stx, runtime_resolve_type(value.ty))
      | wanted:
          runtime_unify(
            value.ty, wanted :~ HType, runtime_context(),
            "expression has an unexpected type")
          RuntimeExpr(value.stx, runtime_resolve_type(wanted :~ HType))
    match expr
    | CoreRef(name, at) when name == #'true:
        ensure(RuntimeExpr(Syntax.make(#true, runtime_context()),
                           mk_tyapp(#'bool, [])))
    | CoreRef(name, at) when name == #'false:
        ensure(RuntimeExpr(Syntax.make(#false, runtime_context()),
                           mk_tyapp(#'bool, [])))
    | CoreRef(name, at):
        match env.get(name, #false)
        | found :: HType:
            ensure(RuntimeExpr(source_id(name, at),
                               runtime_resolve_type(found)))
        | #false:
            match surface_const_type(state, name)
            | found :: HType:
                ensure(
                  RuntimeExpr(runtime_named_apply(state, name, [], at),
                              runtime_fresh_type(found)))
            | #false:
                match runtime_restricted_names().get(name, #false)
                | message :: String: syntax_meta.error(message, at)
                | #false:
                    // `at` is the encoded core form; the identifier it was
                    // encoded from is what the reader recognises, so the
                    // diagnostic quotes that instead of the encoding.
                    syntax_meta.error(
                      "unknown constant " ++ to_string(name),
                      source_id(name, at))
    | CoreNumeral(value, at):
        match expected
        | #false:
            syntax_meta.error("a numeral needs an expected numeric type", at)
        | wanted:
            let wanted = runtime_resolve_type(wanted :~ HType)
            when wanted is_a TyVar
            | syntax_meta.error(
                "a numeral needs a type ascription or an unambiguous numeric context",
                at)
            runtime_numeral(state, value, wanted, at)
    | CoreTypedExpr(inner, type_stx, _):
        let annotated = type_parser.parse_open_type(
                          type_stx,
                          state.surface.type_constructors)
        ensure(runtime_expr(state, env, inner, annotated))
    | CoreListExpr(elements, tail, at):
        ensure(runtime_list_expr(
                 state, env, elements, tail, at, expected))
    | CorePairExpr(first, second, at):
        ensure(runtime_pair_expr(
                 state, env, first, second, at, expected))
    | CoreStringExpr(value, at):
        ensure(runtime_string_expr(state, value, at))
    | CoreSetExpr(elements, at):
        ensure(runtime_set_expr(
                 state, env, elements, at, expected))
    | CoreBlockExpr(body, _):
        ensure(runtime_body_expr(state, env, body, expected))
    | CoreMatchExpr(scrutinee, clauses, at):
        ensure(runtime_match_expr(
                 state, env, scrutinee, clauses, at, expected))
    | CoreCall(func, args, at):
        match func
        | CoreRef(name, _) when !env.get(name, #false)
                                  && !surface_const_type(state, name)
                                  && overload_arity(state.surface.operators, name) != #false:
            runtime_overload_expr(
              state, env, name, args, expected, at)
        | CoreRef(name, _) when name == #'eq && args.length() == 2:
            let left_core :~ CoreExpr = args[0]
            let right_core :~ CoreExpr = args[1]
            let (left, right):
              cond
              | runtime_needs_expected(state, right_core)
                  && !runtime_needs_expected(state, left_core):
                  let left = runtime_expr(state, env, left_core, #false)
                  values(left,
                         runtime_expr(state, env, right_core, left.ty))
              | runtime_needs_expected(state, left_core)
                  && !runtime_needs_expected(state, right_core):
                  let right = runtime_expr(state, env, right_core, #false)
                  values(runtime_expr(state, env, left_core, right.ty),
                         right)
              | ~else:
                  let left = runtime_expr(state, env, left_core, #false)
                  let right = runtime_expr(state, env, right_core, #false)
                  runtime_unify(
                    left.ty, right.ty, at,
                    "equality operands have different types")
                  values(left, right)
            ensure(RuntimeExpr('($((left.stx))) == ($((right.stx)))',
                               mk_tyapp(#'bool, [])))
        | CoreRef(name, _) when (name == #'conj || name == #'disj)
                                  && args.length() == 2:
            let bool_ty = mk_tyapp(#'bool, [])
            let left = runtime_expr(state, env, args[0] :~ CoreExpr, bool_ty)
            let right = runtime_expr(state, env, args[1] :~ CoreExpr, bool_ty)
            let rendered = (if name == #'conj
                            | '($((left.stx))) && ($((right.stx)))'
                            | '($((left.stx))) || ($((right.stx)))')
            ensure(RuntimeExpr(rendered, bool_ty))
        | CoreRef(name, _) when name == #'neg && args.length() == 1:
            let bool_ty = mk_tyapp(#'bool, [])
            let operand = runtime_expr(
                            state, env, args[0] :~ CoreExpr, bool_ty)
            ensure(RuntimeExpr('! ($((operand.stx)))', bool_ty))
        | ~else:
            let head = runtime_expr(state, env, func, #false)
            recur apply (remaining :~ List = args,
                         current :~ HType = head.ty,
                         rendered :~ List = []):
              match remaining
              | []:
                  let rendered_call:
                    match func
                    | CoreRef(name, _) when !env.get(name, #false)
                                              && surface_const_type(state, name):
                        runtime_named_apply(state, name, rendered, at)
                    | ~else:
                        let [arg, ...] = rendered
                        '$((head.stx))($arg, ...)'
                  ensure(RuntimeExpr(
                           rendered_call,
                           runtime_resolve_type(current)))
              | List.cons(arg, rest):
                  let instantiated = runtime_resolve_type(current)
                  when instantiated is_a TyVar
                  | let domain = mk_tyvar(Symbol.gen("_domain"))
                    let range = mk_tyvar(Symbol.gen("_range"))
                    runtime_unify(
                      instantiated, mk_fun(domain, range), at,
                      "the applied expression is not a function")
                  let instantiated = runtime_resolve_type(current)
                  unless is_fun(instantiated)
                  | syntax_meta.error(
                      "the applied expression is not a function", at)
                  let (domain, range) = dest_fun(instantiated)
                  let value = runtime_expr(
                                state, env, arg :~ CoreExpr,
                                runtime_resolve_type(domain))
                  runtime_unify(
                    domain, value.ty, at,
                    "operand type does not match function domain")
                  apply(rest, range, rendered ++ [value.stx])
    | CoreFunctionExpr(params, result_type_stx, body, at):
        let contextual:
          match expected
          | #false: #false
          | wanted:
              let (domains, range) = runtime_expected_function_types(
                                       wanted :~ HType,
                                       params.length(), at)
              [domains, range]
        let parameter_types:
          for List (binder in params, index in List.iota(params.length())):
            let binder :~ CoreBinder = binder
            let declared = surface_optional_type(
                             binder.type_stx,
                             state.surface.type_constructors,
                             "_parameter")
            match contextual
            | #false: declared
            | [domains, _]:
                let contextual_type = (domains :~ List)[index] :~ HType
                runtime_unify(
                  declared, contextual_type, binder.at,
                  "a function parameter does not match its expected type")
                runtime_resolve_type(declared)
        let result_type = surface_optional_type(
                            result_type_stx,
                            state.surface.type_constructors,
                            "_result")
        match contextual
        | [_, contextual_result]:
            runtime_unify(
              result_type, contextual_result :~ HType, at,
              "a function result does not match its expected type")
        | #false: #void
        let function_type:
          for values(current :~ HType = result_type) (
                parameter_type in parameter_types.reverse()):
            mk_fun(parameter_type :~ HType, current)
        let rendered_function:
          match body
          | CoreBodyRows(rows):
              let rendered:
                rows.map(
                  fun (row :: CoreRow):
                    runtime_anonymous_row(
                      state, env, parameter_types, result_type, row))
              let [alternative, ...] = rendered
              'fun
               | $alternative
               | ...'
          | other_body:
              let parsed:
                for List (binder in params,
                          parameter_type in parameter_types):
                  let binder :~ CoreBinder = binder
                  let (rendered, bindings) = runtime_pattern(
                                                state, binder.pattern,
                                                parameter_type :~ HType)
                  [rendered, bindings]
              let (parameters, local_bindings) = runtime_pattern_entries(
                                                   parsed, at)
              let local_env = env ++ local_bindings
              let [parameter, ...] = parameters
              let result = runtime_body(
                             state, local_env, other_body, result_type)
              '(fun ($parameter, ...): $result)'
        ensure(
          RuntimeExpr(rendered_function,
                      runtime_resolve_type(function_type)))
    | CoreIf(condition, then_expr, else_expr, at):
        let condition_value = runtime_expr(
                                state, env, condition,
                                mk_tyapp(#'bool, []))
        let then_value = runtime_expr(state, env, then_expr, expected)
        let else_value = runtime_expr(
                           state, env, else_expr, then_value.ty)
        let rendered:
          'if $((condition_value.stx))
           | $((then_value.stx))
           | $((else_value.stx))'
        ensure(RuntimeExpr(rendered, then_value.ty))
    | ~else:
        syntax_meta.error("expression has no runtime meaning",
                          runtime_context())

  fun merge_runtime_pattern_bindings(
        left :: Map.of(Symbol, HType),
        right :: Map.of(Symbol, HType),
        at :: Syntax) :: Map.of(Symbol, HType):
    for values(out :~ Map = left) ((name, ty) in right):
      when out.get(name, #false)
      | syntax_meta.error(
          "a pattern repeats `" ++ to_string(name) ++ "`", at)
      out ++ {name: ty :~ HType}

  fun runtime_pattern_entries(parsed :: List, at :: Syntax)
       :: values(List.of(Syntax), Map.of(Symbol, HType)):
    let rendered:
      parsed.map(fun (entry :: List): entry[0] :~ Syntax)
    let bindings:
      for values(out :~ Map = {}) (entry in parsed):
        merge_runtime_pattern_bindings(
          out, (entry :~ List)[1] :~ Map, at)
    values(rendered, bindings)

  // Rhombus's guarded binding keeps executable literal patterns constant
  // size: bind the matched Nat, then compare it with the ordinary executable
  // reading of the literal. This is numeric structural equality, not a
  // string-specific or host-string comparison.
  fun runtime_numeral_pattern(
        state :: SurfaceContext, value :: NonnegInt,
        expected :: HType, at :: Syntax) :: Syntax:
    let matched = source_id(Symbol.gen("_hol_literal"), at)
    let literal = runtime_numeral(state, value, expected, at).stx
    '($matched when $matched == $literal)'

  fun runtime_pattern(state :: SurfaceContext, pat :: CorePattern,
                      expected :: HType)
       :: values(Syntax, Map.of(Symbol, HType)):
    let expected = runtime_resolve_type(expected)
    match pat
    | CorePatWildcard(at): values(source_id(#'_, at), {})
    | CorePatVar(name, at):
        values(source_id(name, at), {name: expected})
    | CorePatTyped(inner, type_stx, at):
        let annotated = type_parser.parse_open_type(
                          type_stx, state.surface.type_constructors)
        runtime_unify(
          expected, annotated, at,
          "a pattern annotation does not match the expected type")
        runtime_pattern(state, inner, runtime_resolve_type(annotated))
    | CorePatPair(first, second, at):
        let expected = runtime_resolve_type(expected)
        let (first_type, second_type):
          match expected
          | TyVar(_,):
              let first_type = mk_tyvar(Symbol.gen("_pair_first"))
              let second_type = mk_tyvar(Symbol.gen("_pair_second"))
              runtime_unify(
                expected, prod_ty(first_type, second_type), at,
                "a Pair pattern needs a `Pair.of(...)` value")
              values(first_type, second_type)
          | ~else: runtime_pair_types(expected, at)
        let (first_stx, first_bindings) = runtime_pattern(
                                                  state, first, first_type)
        let (second_stx, second_bindings) = runtime_pattern(
                                                    state, second, second_type)
        values(
          'Pair($first_stx, $second_stx)',
          merge_runtime_pattern_bindings(
            first_bindings, second_bindings, at))
    | CorePatList(elements, tail, at):
        let expected = runtime_resolve_type(expected)
        let element_type:
          match expected
          | TyVar(_,):
              let element_type = mk_tyvar(Symbol.gen("_list_element"))
              runtime_unify(
                expected, mk_tyapp(#'List, [element_type]), at,
                "a list pattern needs a `List.of(...)` value")
              element_type
          | ~else: runtime_list_element_type(expected, at)
        let parsed:
          for List (element in elements):
            let (rendered, bindings) = runtime_pattern(
                                          state, element :~ CorePattern,
                                          element_type)
            [rendered, bindings]
        let (tail_stx, tail_bindings):
          match tail
          | #false:
              values(runtime_named_apply(state, #'nil, [], at), {})
          | tail_pattern:
              runtime_pattern(
                state, tail_pattern :~ CorePattern, expected)
        let (rendered, bindings) = runtime_pattern_entries(parsed, at)
        let result:
          for values(out :~ Syntax = tail_stx) (element_stx in rendered.reverse()):
            runtime_named_apply(
              state, #'cons, [element_stx :~ Syntax, out], at)
        values(
          result,
          merge_runtime_pattern_bindings(bindings, tail_bindings, at))
    | CorePatLiteral(value_stx, at):
        let raw = Syntax.unwrap(value_stx)
        cond
        | raw is_a Boolean:
            runtime_unify(
              expected, mk_tyapp(#'bool, []), at,
              "a Boolean pattern needs a Boolean value")
            values(value_stx, {})
        | raw is_a NonnegInt:
            let expected = runtime_resolve_type(expected)
            when expected is_a TyVar
            | syntax_meta.error(
                "a numeral pattern needs a type annotation or an unambiguous context",
                at)
            values(runtime_numeral_pattern(
                     state, raw, expected, at),
                   {})
        | raw is_a String:
            runtime_unify(
              expected, mk_tyapp(#'String, []), at,
              "a string pattern needs a String value")
            let codes:
              for List (character in (raw :~ String).to_list()):
                runtime_numeral_pattern(
                  state, character.to_int(), mk_tyapp(#'Nat, []), at)
            let contents:
              for values(out :~ Syntax = runtime_named_apply(
                                              state, #'nil, [], at)) (
                    code in codes.reverse()):
                runtime_named_apply(state, #'cons, [code :~ Syntax, out], at)
            values(runtime_named_apply(state, #'text, [contents], at), {})
        | ~else:
            syntax_meta.error("unsupported literal pattern", at)
    | CorePatCtor(name, args, at):
        let generic:
          match surface_const_type(state, name)
          | #false:
              syntax_meta.error("unknown constructor " ++ to_string(name), at)
          | ty: runtime_fresh_type(ty :~ HType)
        let (domains, result) = runtime_peel(generic, args.length())
        runtime_unify(
          result, expected, at,
          "constructor does not build the matched type")
        let parsed:
          for List (arg in args, domain in domains):
            let (rendered, bindings) = runtime_pattern(
                                          state, arg :~ CorePattern,
                                          runtime_resolve_type(
                                            domain :~ HType))
            [rendered, bindings]
        let (rendered, bindings) = runtime_pattern_entries(parsed, at)
        let [rendered_stx, ...] = rendered
        let constructor = source_id(name, at)
        values('$constructor($rendered_stx, ...)', bindings)

  fun runtime_match_expr(state :: SurfaceContext,
                         env :: Map.of(Symbol, HType),
                         scrutinee :: CoreExpr,
                         clauses :: List.of(CoreMatchClause),
                         at :: Syntax,
                         expected :: maybe(HType)) :: RuntimeExpr:
    when clauses.length() == 0
    | syntax_meta.error("a match expression needs at least one clause", at)
    let target = runtime_expr(state, env, scrutinee, #false)
    let (rendered, result_type):
      for values(out :~ List.of(Syntax) = [],
                 current :~ maybe(HType) = expected) (
            clause in clauses):
        let clause :~ CoreMatchClause = clause
        let (pattern_stx, bindings) = runtime_pattern(
                                        state, clause.pattern,
                                        target.ty)
        let result = runtime_body_expr(
                       state, env ++ bindings, clause.body, current)
        values(out ++ ['$pattern_stx: $((result.stx))'],
               result.ty)
    let [clause_stx, ...] = rendered
    RuntimeExpr(
      'match ($((target.stx)))
       | $clause_stx
       | ...',
      result_type :~ HType)

  fun runtime_body_expr(state :: SurfaceContext,
                        env :: Map.of(Symbol, HType),
                        body :: CoreFunBody,
                        expected :: maybe(HType)) :: RuntimeExpr:
    match body
    | CoreBodyExpr(expr):
        runtime_expr(state, env, expr, expected)
    | CoreBodyLet(binding_pat, init, tail, at):
        let local_name:
          (if init is_a CoreFunctionExpr
           | core_pattern_name(binding_pat, "a local function needs a name")
           | #false)
        let forward_restricted:
          for values(out :~ Map = runtime_restricted_names()) (
                name in following_local_function_names(tail)):
            out ++ {name: "forward local-function reference is not supported"}
        let init_restricted:
          match local_name
          | #false: forward_restricted
          | name:
              forward_restricted
                ++ {name: "local recursive functions are not supported"}
        let value = parameterize { runtime_restricted_names: init_restricted }:
                      runtime_expr(state, env, init, #false)
        let (pattern_stx, bindings) = runtime_pattern(
                                        state, binding_pat, value.ty)
        let rest = runtime_body_expr(
                     state, env ++ bindings, tail, expected)
        RuntimeExpr(
          'block:
             let $pattern_stx = $((value.stx))
             $((rest.stx))',
          rest.ty)
    | CoreBodyMatch(scrutinee, clauses, at):
        runtime_match_expr(
          state, env, CoreRef(scrutinee, at), clauses, at, expected)
    | ~else:
        error(~who: #'function, "invalid nested function body")

  fun runtime_body(state :: SurfaceContext,
                   env :: Map.of(Symbol, HType),
                   body :: CoreFunBody,
                   expected :: HType) :: Syntax:
    runtime_body_expr(state, env, body, expected).stx

  fun runtime_row(state :: SurfaceContext,
                  base_env :: Map.of(Symbol, HType),
                  name :: Syntax,
                  parameter_types :: List.of(HType),
                  expected :: HType,
                  row :: CoreRow) :: Syntax:
    let parsed:
      for List (pat in row.patterns, ty in parameter_types):
        let (rendered, bindings) = runtime_pattern(
                                      state, pat :~ CorePattern,
                                      ty :~ HType)
        [rendered, bindings]
    let bindings:
      for values(out :~ Map = base_env) (entry in parsed):
        out ++ ((entry :~ List)[1] :~ Map)
    let result = runtime_body(state, bindings, row.body, expected)
    let [pattern_stx, ...] = parsed.map(
                               fun (entry :: List): entry[0] :~ Syntax)
    '$name($pattern_stx, ...): $result'

  fun runtime_anonymous_row(
        state :: SurfaceContext,
        base_env :: Map.of(Symbol, HType),
        parameter_types :: List.of(HType),
        expected :: HType,
        row :: CoreRow) :: Syntax:
    let parsed:
      for List (pat in row.patterns, ty in parameter_types):
        let (rendered, bindings) = runtime_pattern(
                                      state, pat :~ CorePattern,
                                      ty :~ HType)
        [rendered, bindings]
    let (patterns, local_bindings) = runtime_pattern_entries(
                                       parsed, row.at)
    let result = runtime_body(
                   state, base_env ++ local_bindings, row.body, expected)
    let [pattern_stx, ...] = patterns
    '($pattern_stx, ...): $result'

  // The executable half lowers the same CoreExpr tree as the logical half.
  // Overload methods are therefore selected at expansion time from declared
  // argument and expected-result types; generated code contains only direct
  // named calls.

  fun emit_function(spec :: CoreFunctionSpec, state :: SurfaceContext,
                    name :: Syntax) :: RuntimeFunction:
    parameterize { runtime_context: name }:
      parameterize { runtime_inference: Box({}) }:
        let parameter_types = spec.params.map(
                                fun (binder :: CoreBinder):
                                  surface_optional_type(
                                    binder.type_stx,
                                    state.surface.type_constructors,
                                    "_parameter"))
        let result_type = surface_optional_type(
                            spec.result_type,
                            state.surface.type_constructors,
                            "_result")
        let parsed_parameters:
          for List (binder in spec.params, ty in parameter_types):
            let binder :~ CoreBinder = binder
            let (rendered, bindings) = runtime_pattern(
                                          state, binder.pattern,
                                          ty :~ HType)
            [rendered, bindings]
        let (parameters, parameter_bindings) = runtime_pattern_entries(
                                                  parsed_parameters, name)
        let function_type:
          for values(ty :~ HType = result_type) (domain in parameter_types.reverse()):
            mk_fun(domain :~ HType, ty)
        let env = {spec.name: function_type} ++ parameter_bindings
        let rendered_function:
          match spec.body
          | CoreBodyRows(rows):
              let rendered = rows.map(
                               fun (row :: CoreRow):
                                 runtime_row(state, env, name,
                                             parameter_types,
                                             result_type, row))
              let [alternative, ...] = rendered
              'fun
               | $alternative
               | ...'
          | body:
              let [parameter, ...] = parameters
              let result = runtime_body(
                             state, env, body, result_type)
              'fun $name($parameter, ...):
                 $result'
        RuntimeFunction(
          rendered_function,
          runtime_resolve_type(function_type))

  // -- HOL surface parsing ---------------------------------------------------

  fun parse_hol_encoding(stx :: Syntax) :: Syntax:
    let '$(parsed :: hol_expr_meta.Parsed)' = stx
    hol_expr_meta.unpack(parsed)

  fun parse_core_encoding(stx :: Syntax) :: Syntax:
    try:
      parse_hol_encoding(stx)
      ~catch e :: Exn.Fail:
        (if e.message.contains("unbound HOL expression operator")
         | syntax_meta.error("unexpected text after an expression", stx)
         | throw e)

  fun parse_function_expression(stx :: Syntax) :: Syntax:
    try:
      parse_core_encoding(stx)
      ~catch e :: Exn.Fail:
        (if e.message.contains("hol_expr_meta.Parsed")
             && e.message.contains("annotation")
         | syntax_meta.error(
             "this version admits only variables, named applications, `if`, "
               ++ "`cond`, and HOL notation in a function body",
             stx)
         | throw e)

  fun symbol_id(n :: Symbol) :: Syntax:
    Syntax.make_id(to_string(n), id_ctx)



  fun row_encoding(row :: Syntax, arity :: Int) :: Syntax:
    let (patterns, body) = elab.row_parts(row, arity)
    let [p, ...] = patterns.map(encode_pattern)
    let b = encode_function_body(body)
    '(core_row [$p, ...] $b)'.relocate_span([row])

  fun function_body_encoding(body :: Syntax) :: Syntax:
    encode_function_body(body)

  fun function_row_arity(row :: Syntax) :: NonnegInt:
    match row
    | '($pat, ...): $body; ...': [pat, ...].length()
    | '$pat ...: $body; ...': 1
    | ~else: syntax_meta.error("malformed function clause", row)

  fun inferred_parameter_syntax(rows :: List.of(Syntax),
                                at :: Syntax) :: List.of(Syntax):
    match rows
    | []: syntax_meta.error("a case function needs at least one clause", at)
    | List.cons(first, _):
        for List (index in List.iota(function_row_arity(first))):
          Syntax.make_id("_arg" ++ to_string(index), id_ctx)

  fun function_encoding(form :: Syntax,
                        measure_stx :: maybe(Syntax))
       :: values(Syntax, Syntax):
    let [name, declared_params, result_type, body] = elab.function_parts(form)
    let clauses = elab.body_clauses(body :~ Syntax)
    let ps:
      match declared_params
      | #false:
          inferred_parameter_syntax(clauses :~ List.of(Syntax), form)
      | present: present :~ List
    let [param, ...] = (ps :~ List).map(
                         fun (p :: Syntax): encode_binder(p))
    let measure:
      match measure_stx
      | #false: Syntax.make(#false, id_ctx)
      | m: parse_function_expression(m :~ Syntax)
    let body_core:
      match clauses
      | #false: function_body_encoding(body :~ Syntax)
      | rows:
          let [row, ...] = (rows :~ List).map(
                             fun (r :: Syntax):
                               row_encoding(r, (ps :~ List).length()))
          '(core_body_rows [$row, ...])'.relocate_span([body :~ Syntax])
    let result:
      match result_type
      | #false: '#false'
      | ty: '($((ty :~ Syntax)))'
    let core:
      '(core_function $name [$param, ...] $result $measure $body_core)'.relocate_span([form])
    values(core, name)
  fun option_symbol_stx(v) :: Syntax:
    match v
    | #false: Syntax.make(#false, id_ctx)
    | n: symbol_id(n :~ Symbol)

  fun option_int_stx(v) :: Syntax:
    match v
    | #false: Syntax.make(#false, id_ctx)
    | n: Syntax.make(n, id_ctx)

  fun tactic_encoding(tactic :: maybe(List.of(Syntax)), at :: Syntax) :: Syntax:
    let tactic_stx:
      match tactic
      | #false: #false
      | groups:
          let [g, ...] = groups :~ List
          '$g; ...'
    let [induct, using_names, skipped_stage_names, disabled_rule_names,
         case_stxs, witness_stxs, search_steps, extensionality] = elab.parse_tactic(tactic_stx)
    let induct_stx = option_symbol_stx(induct)
    let extensionality_stx = option_symbol_stx(extensionality)
    let [u, ...] = (using_names :~ List).map(fun (n): symbol_id(n :~ Symbol))
    let [d, ...] = (skipped_stage_names :~ List).map(
                     fun (n): symbol_id(n :~ Symbol))
    let [r, ...] = (disabled_rule_names :~ List).map(
                     fun (n): symbol_id(n :~ Symbol))
    let [c, ...] = (case_stxs :~ List).map(
                      fun (s): parse_core_encoding(s :~ Syntax))
    let [w, ...] = (witness_stxs :~ List).map(
                      fun (s): parse_core_encoding(s :~ Syntax))
    let steps_stx = option_int_stx(search_steps)
    '(core_tactic $induct_stx [$u, ...] [$d, ...] [$r, ...] [$c, ...] [$w, ...] $steps_stx $extensionality_stx)'.relocate_span([at])

  fun render_step(step :: Syntax) :: List.of(Syntax):
    let step = step.replace_scopes(id_ctx)
    match step
    | '(~import $alias [$term, ...])':
        let [t, ...] = [term, ...]
        let path = '$t ...'
        ['import: $path!hol_theory as $alias']
    | '(~adopt $cur $nxt $alias [$at])':
        ['def $nxt = _hol_driver.adopt($cur, $(alias).theory, '$at')']
    | '(~datatype $cur $nxt [$form, ...] [$at])':
        ['def $nxt = _hol_driver.add_datatypes($cur, ['$form', ...], '$at')']
    | '(~function $cur $nxt [$core, ...] [$at])':
        ['def $nxt:
           let specs = try:
                         [_hol_surface.decode_function('$core'), ...]
                         ~catch e :: Exn.Fail:
                           _hol_driver.hol_reraise(e, '$at')
           _hol_driver.add_functions($cur, specs, '$at')']
    | '(~theorem $cur $nxt [$name] [$core] [$tactic] [$at])':
        ['def $nxt:
           let statement = try:
                            _hol_surface.decode_prop('$core')
                            ~catch e :: Exn.Fail:
                              _hol_driver.hol_reraise(e, '$at')
           let proof = try:
                         _hol_surface.decode_tactic('$tactic')
                         ~catch e :: Exn.Fail:
                           _hol_driver.hol_reraise(e, '$at')
           _hol_driver.add_theorem($cur, Syntax.unwrap('$name'),
                                   statement, proof, '$at')']
    | '(~definition $cur $nxt [$name, ...] [$type, ...] [$core, ...] [$at])':
        ['def $nxt:
           let expressions = try:
                               [_hol_surface.decode_expr('$core', #'definition), ...]
                               ~catch e :: Exn.Fail:
                                 _hol_driver.hol_reraise(e, '$at')
           _hol_driver.add_definitions(
             $cur, [Syntax.unwrap('$name'), ...], ['$type', ...],
             expressions, '$at')']
    | '(~inductive $cur $nxt [$name, ...] [$signature, ...] [$rule_name, ...] [$rule_core, ...] [$at])':
        ['def $nxt:
           let rules = try:
                         [_hol_surface.decode_prop('$rule_core'), ...]
                         ~catch e :: Exn.Fail:
                           _hol_driver.hol_reraise(e, '$at')
           _hol_driver.add_inductive(
             $cur, [Syntax.unwrap('$name'), ...],
             [_hol_driver.inductive_signature('$signature'), ...],
             [Syntax.unwrap('$rule_name'), ...], rules, '$at')']
    | '(~overload_method $cur $nxt [$function_name] [$signature] [$constant] [$order, ...] [$at])':
        ['def $nxt = _hol_driver.add_overload_method_encoded(
                       $cur, Syntax.unwrap('$function_name'), '$signature',
                       Syntax.unwrap('$constant'), [$order, ...], '$at')']
    | ~else: syntax_meta.error("internal malformed logical step", step)

  // -- diagnostics -----------------------------------------------------------

  // `raise-syntax-error` reports the location of the syntax object it is
  // given, and a *group* built by a template carries the template's location,
  // not the user's.  The head term still carries the user's.
  fun head_term(form :: Syntax) :: Syntax:
    match form
    | '$head $_ ...': head
    | ~else: form

  // A sequence macro receives the untouched tail as more groups. Peel that
  // outer sequence before recovering the declaration keyword.
  fun macro_use_head(use :: Syntax) :: Syntax:
    match use
    | '$first; $_; ...': head_term(first)
    | ~else: head_term(use)

  // Rebuild a user-facing HOL import with this module's ordinary Rhombus
  // `import` binding. Returning the original head after the language rebinds
  // `import` would invoke the HOL wrapper recursively.
  fun emit_plain_import(form :: Syntax) :: Syntax:
    match form
    | '$_: $clause; ...': 'import: $clause; ...'
    | '$_ $term ...': 'import $term ...'
    | ~else: syntax_meta.error("internal malformed import declaration", form)

  // -- a declaration family --------------------------------------------------
  //
  // `datatype`, `definition`, `function` and `inductive` are declared either
  // singly or as a `<kind>.together:` family whose members are elaborated
  // simultaneously.  One path serves both, because a lone declaration is the
  // one-member family: there is no separate single-declaration encoding to
  // keep in step, and the ordinary declarations exercise the family path.
  //
  // The whole family travels to the driver as one chain step.  It has to: a
  // member of a mutually recursive family is not a declaration on its own,
  // and the logical construction reads all of them at once.
  fun declared_function_type(state :: SurfaceContext,
                             spec :: CoreFunctionSpec) :: HType:
    let registry = state.surface.type_constructors
    let result = surface_optional_type(spec.result_type, registry, "_result")
    for values(ty :~ HType = result) (binder in spec.params.reverse()):
      mk_fun(surface_optional_type((binder :~ CoreBinder).type_stx,
                                   registry, "_parameter"),
             ty)

  fun emit_group(kind :: Symbol, decls :: List.of(expand.Decl),
                 n :: Int, runtime_state :: SurfaceContext)
       :: values(List.of(Syntax), List.of(Syntax), Int, SurfaceContext):
    let cur = st(n)
    let nxt = st(n + 1)
    let at = head_term((decls[0] :~ expand.Decl).form)
    match kind
    | #'datatype:
        let [form, ...] = decls.map(fun (d :: expand.Decl): d.form)
        let ready = force_surface_context(runtime_state)
        let specs = type_parser.parse_datatype_decls(
                      [form, ...], ready.surface.type_constructors)
        let selves:
          for List (spec in specs):
            mk_tyapp((spec :~ DatatypeSpec).name,
                     (spec :~ DatatypeSpec).params.map(
                       fun (parameter :: Symbol): mk_tyvar(parameter)))
        let runtime:
          for values(acc :~ List.of(Syntax) = []) (d in decls, spec in specs):
            let [name, ctors] = (d :~ expand.Decl).parts
            let cs :~ List = ctors
            // A field at any member of the family counts as recursive for
            // generation: a base case has to avoid every member, or sampling
            // a mutually recursive family would not terminate.
            let gen:
              for List (ctor in cs, semantic in (spec :~ DatatypeSpec).ctors):
                let types = (semantic :~ Ctor).fields.map(
                              fun (field :: Field): field.ty)
                [(ctor :~ List)[0], types,
                 for any (type in types): selves.contains(type)]
            acc ++ [emit_type(name :~ Syntax, cs),
                    emit_generator(name :~ Syntax,
                                   (spec :~ DatatypeSpec).params, gen),
                    emit_shrinker(name :~ Syntax, gen)]
        let next_runtime:
          for values(state :~ SurfaceContext = ready) (spec in specs):
            surface_add_datatype(state, spec :~ DatatypeSpec)
        values(runtime,
               ['(~datatype $cur $nxt [$form, ...] [$at])'],
               n + 1, next_runtime)
    | #'function:
        let encoded:
          for List (d in decls):
            let d = d :~ expand.Decl
            let [measure] = d.parts
            let (core, name) = function_encoding(
                                 d.form, measure :~ maybe(Syntax))
            [core, name, decode_function(core)]
        // Every member's signature is registered before any member's body is
        // rendered, so that a call to a sibling resolves while the family is
        // still being emitted.  Rhombus module-level definitions are mutually
        // visible, so the emitted `fun`s need no other arrangement.
        let declared:
          for values(state :~ SurfaceContext = force_surface_context(runtime_state)) (
                entry in encoded):
            let spec :~ CoreFunctionSpec = (entry :~ List)[2]
            surface_add_function(state, spec,
                                 declared_function_type(state, spec))
        let (runtime, next_runtime):
          for values(acc :~ List.of(Syntax) = [],
                     state :~ SurfaceContext = declared) (entry in encoded):
            let entry :~ List = entry
            let spec :~ CoreFunctionSpec = entry[2]
            let emitted = emit_function(spec, state, entry[1] :~ Syntax)
            values(acc ++ [emitted.stx],
                   surface_add_function(state, spec, emitted.ty))
        let [core, ...] = encoded.map(fun (entry :: List): entry[0] :~ Syntax)
        values(runtime,
               ['(~function $cur $nxt [$core, ...] [$at])'],
               n + 1, next_runtime)
    | #'definition:
        let [name, ...] = decls.map(
                            fun (d :: expand.Decl): (d.parts :~ List)[0])
        let [type_stx, ...] = decls.map(
                                fun (d :: expand.Decl): (d.parts :~ List)[1])
        let [core, ...]:
          for List (d in decls):
            let [g, ...] = ((d :~ expand.Decl).parts :~ List)[2] :~ List
            parse_hol_encoding('$g; ...')
        values([],
               ['(~definition $cur $nxt [$name, ...] [$type_stx, ...] [$core, ...] [$at])'],
               n + 1, runtime_state)
    | #'inductive:
        let [name, ...] = decls.map(
                            fun (d :: expand.Decl): (d.parts :~ List)[0])
        // One parenthesized group of argument types per predicate, so the
        // family's heads stay separable after encoding.
        let [signature, ...]:
          for List (d in decls):
            let [parameter_type, ...] = ((d :~ expand.Decl).parts :~ List)[1] :~ List
            '($parameter_type, ...)'
        // The family shares every rule: that is what makes the predicates
        // mutually recursive, and it is why the rules are concatenated here
        // rather than kept per member.
        let rules:
          for values(acc :~ List = []) (d in decls):
            acc ++ (((d :~ expand.Decl).parts :~ List)[2] :~ List)
        let [rule_name, ...] = rules.map(fun (r :: List): r[0] :~ Syntax)
        let [rule_core, ...]:
          for List (r in rules):
            let [g, ...] = (r :~ List)[1] :~ List
            parse_hol_encoding('$g; ...')
        values([],
               ['(~inductive $cur $nxt [$name, ...] [$signature, ...] [$rule_name, ...] [$rule_core, ...] [$at])'],
               n + 1, runtime_state)
    | ~else:
        syntax_meta.error("internal unknown declaration family",
                          (decls[0] :~ expand.Decl).form)

  // -- one declaration -------------------------------------------------------

  // Two outputs, because they go to two places: the runtime forms stay in the
  // module, and the chain steps go into the `hol_theory` submodule.  Nothing
  // in the runtime half ever refers to the chain, which is what makes the
  // split possible.
  fun emit_one(d :: expand.Decl, n :: Int, runtime_state :: SurfaceContext)
       :: values(List.of(Syntax), List.of(Syntax), Int, SurfaceContext):
    let cur = st(n)
    let nxt = st(n + 1)
    match d.kind
    | #'import:
        let [paths] = d.parts
        let at = head_term(d.form)
        let (chain, n2):
          for values(acc :~ List = [], k = n) (terms in (paths :~ List)):
            let alias = Syntax.make_id("_hol_used" ++ to_string(k), id_ctx)
            let [t, ...] = (terms :~ List).map(recontext)
            values(acc ++ ['(~import $alias [$t, ...])',
                           '(~adopt $(st(k)) $(st(k + 1)) $alias [$at])'],
                   k + 1)
        let next_runtime:
          for values(state :~ SurfaceContext = runtime_state) (terms in (paths :~ List)):
            defer_surface_import(state, terms :~ List.of(Syntax))
        values([emit_plain_import(d.form)], chain, n2, next_runtime)
    | #'theorem:
        let [name, stmt, tactic] = d.parts
        let at = head_term(d.form)
        let gs :~ List = stmt
        let [g, ...] = gs
        let core = parse_hol_encoding('$g; ...')
        let tactic_core = tactic_encoding(tactic, at)
        values([],
               ['(~theorem $cur $nxt [$name] [$core] [$tactic_core] [$at])'],
               n + 1, runtime_state)
    | #'overload_method:
        let [function_name, argument_names, argument_types,
             result_type, constant, template_arguments] = d.parts
        let at = head_term(d.form)
        let names:
          for List (name in (argument_names :~ List)):
            match name
            | #false: #false
            | name_stx: Syntax.unwrap(name_stx :~ Syntax)
        let positions = overload_argument_order(
                          names, template_arguments, at)
        let next_runtime = surface_add_method(
                             runtime_state,
                             Syntax.unwrap(function_name),
                             argument_types :~ List.of(Syntax),
                             result_type :~ maybe(Syntax),
                             Syntax.unwrap(constant),
                             positions, at)
        let [argument_type, ...] = argument_types :~ List.of(Syntax)
        let result_stx = (if result_type
                          | result_type :~ Syntax
                          | Syntax.make(#false, id_ctx))
        let signature:
          '(overload_signature [$argument_type, ...] [$result_stx])'
        let [position, ...] = positions.map(
                              fun (value): Syntax.make(value, id_ctx))
        values([],
               ['(~overload_method $cur $nxt [$function_name] [$signature] [$constant] [$position, ...] [$at])'],
               n + 1, next_runtime)

syntax_parameter.bridge hol_expansion_state:
  Box(initial_expansion_state())

meta:
  fun current_expansion_box() :: Box:
    syntax_parameter_meta.lookup('hol_expansion_state') :~ Box

  fun current_expansion_state() :: ExpansionState:
    current_expansion_box().value :~ ExpansionState

  fun ensure_module_declaration(at :: Syntax):
    unless rb.#{syntax-local-context}() == #'module
    | syntax_meta.error("allowed only in a module body", at)

  // The kinds that are declared either singly or as a `.together:` family.
  // A lone declaration of one of these is emitted as the one-member family,
  // so there is exactly one encoding, one driver entry point, and one set of
  // checks for both spellings.
  def family_kinds :: List.of(Symbol) = [#'datatype, #'definition,
                                         #'function, #'inductive]

  fun emit_planned(kind :: Symbol, decls :: List.of(expand.Decl)) :: Syntax:
    let box = current_expansion_box()
    let state = box.value :~ ExpansionState
    let (runtime, chain, next_index, surface):
      cond
      | family_kinds.contains(kind):
          emit_group(kind, decls, state.next_index, state.surface)
      | ~else:
          emit_one(decls[0] :~ expand.Decl, state.next_index, state.surface)
    let steps_rev:
      for values(acc :~ List.of(Syntax) = state.steps_rev) (step in chain):
        List.cons(step :~ Syntax, acc)
    box.value := ExpansionState(
                   next_index :~ NonnegInt, surface, steps_rev)
    let [runtime_form, ...] = runtime
    '«
       $runtime_form
       ...
     »'

  fun emit_planned_declaration(d :: expand.Decl) :: Syntax:
    emit_planned(d.kind, [d])

  fun declaration_expansion(forms :: List.of(Syntax)) :: Syntax:
    let (planned, rest) = expand.plan_next(forms)
    match planned
    | #false:
        syntax_meta.error("internal missing HOL declaration", forms[0])
    | d:
        unless rest == []
        | syntax_meta.error("internal unconsumed HOL declaration tail",
                            rest[0])
        emit_planned_declaration(d :~ expand.Decl)

  // A `<kind>.together:` block: its members are planned as ordinary
  // declarations and then emitted as one family.
  fun group_expansion(kind :: Symbol, forms :: List.of(Syntax)) :: Syntax:
    when forms.length() == 0
    | syntax_meta.error(
        "a `" ++ to_string(kind)
          ++ ".together:` block needs at least one declaration",
        Syntax.make_id(to_string(kind), id_ctx))
    ensure_module_declaration(forms[0])
    emit_planned(kind, expand.plan_group(forms, kind))

  fun quickcheck_expansion(name :: Syntax, opts :: List.of(Syntax),
                           core :: Syntax, at :: Syntax) :: Syntax:
    let box = current_expansion_box()
    let state = box.value :~ ExpansionState
    let ready = force_surface_context(state.surface)
    box.value := ExpansionState(
                   state.next_index, ready, state.steps_rev)
    emit_quickcheck(ready, name, opts, core, at)

  fun finish_expansion() :: Syntax:
    let state = current_expansion_state()
    let final = st(state.next_index)
    let rendered:
      for values(acc :~ List.of(Syntax) = []) (
            encoded in state.steps_rev):
        render_step(encoded :~ Syntax) ++ acc
    let [step, ...] = rendered
    let surface_state = emit_surface_state(state.surface)
    '«
       $surface_state
       module hol_theory ~lang rhombus:
         import: rhombus/hol/frontend/driver as _hol_driver
         import: rhombus/hol/frontend/surface_core as _hol_surface
         export: theory
         def $(st(0)) = _hol_driver.initial_state()
         $step
         ...
         def theory = $final
     »'

  fun sequence_declaration_expansion(forms :: List.of(Syntax),
                                     expected_kind :: Symbol):
    ensure_module_declaration(forms[0])
    let (planned, rest) = expand.plan_next(forms)
    match planned
    | #false:
        syntax_meta.error("internal missing HOL sequence declaration",
                          forms[0])
    | d:
        let d = d :~ expand.Decl
        unless d.kind == expected_kind
        | syntax_meta.error("internal wrong HOL sequence declaration",
                            d.form)
        let [tail, ...] = rest
        values(emit_planned_declaration(d), '$tail; ...')

decl.macro 'hol_finalize':
  finish_expansion()

// Each declaration kind that can be mutually recursive has the same two
// spellings: one declaration on its own, or a `.together:` block whose
// members are declared simultaneously.
decl.macro 'datatype $term ...':
  ~all_stx use
  let head = macro_use_head(use)
  declaration_expansion(['$head $term ...'])

namespace datatype:
  export together
  decl.macro 'together: $form; ...':
    group_expansion(#'datatype, [form, ...])

decl.macro 'inductive $term ...':
  ~all_stx use
  let head = macro_use_head(use)
  declaration_expansion(['$head $term ...'])

namespace inductive:
  export together
  decl.macro 'together: $form; ...':
    group_expansion(#'inductive, [form, ...])

decl.macro 'definition $term ...':
  ~all_stx use
  let head = macro_use_head(use)
  declaration_expansion(['$head $term ...'])

namespace definition:
  export together
  decl.macro 'together: $form; ...':
    group_expansion(#'definition, [form, ...])

namespace function:
  export together
  decl.macro 'together: $form; ...':
    group_expansion(#'function, [form, ...])

decl.macro 'overload $term ...':
  ~all_stx use
  let head = macro_use_head(use)
  declaration_expansion(['$head $term ...'])

decl.macro
| 'quickcheck $(name :: Identifier)($option, ...):
     $(stmt :: hol_expr_meta.Parsed)':
    quickcheck_expansion(
      name, [option, ...], hol_expr_meta.unpack(stmt), name)
| 'quickcheck $(name :: Identifier):
     $(stmt :: hol_expr_meta.Parsed)':
    quickcheck_expansion(name, [], hol_expr_meta.unpack(stmt), name)

decl.macro 'proof: $body; ...':
  ~all_stx form
  syntax_meta.error(
    "a `proof:` must immediately follow a `theorem` or `function` declaration",
    form)

decl.macro
| 'hol_import: $clause; ...':
    ~all_stx use
    let head = macro_use_head(use)
    declaration_expansion(['$head: $clause; ...'])
| 'hol_import $term ...':
    ~all_stx use
    let head = macro_use_head(use)
    declaration_expansion(['$head $term ...'])

defn.sequence_macro 'function $term ...; $tail; ...':
  ~all_stx use
  let head = macro_use_head(use)
  let form = '$head $term ...'
  sequence_declaration_expansion(
    [form] ++ [tail, ...], #'function)

defn.sequence_macro 'theorem $term ...; $tail; ...':
  ~all_stx use
  let head = macro_use_head(use)
  let form = '$head $term ...'
  sequence_declaration_expansion(
    [form] ++ [tail, ...], #'theorem)

// Every `#lang rhombus/hol` module initializes an expansion-local state,
// expands its declarations normally, and finalizes the accumulated surface
// metadata and logical steps after the source body.
decl.macro 'module_block: $form; ...':
  '#%module_block:
     syntax_parameter.relet hol_expansion_state:
       Box(initial_expansion_state())
     $form
     ...
     hol_finalize'
