#lang rhombus/and_meta
// SPDX-License-Identifier: 0BSD
// QuickCheck is a design reference for generated testing support; see THIRD_PARTY_NOTICES.


// The `#%module_block` of `#lang rhombus/hol`.
//
// It hands the module body to `expand.rhm` for recognition, then emits, for
// each declaration, the runtime code and one step of the compile-time state.
//
// The state is threaded as ordinary phase-1 definitions *in the user's
// module* -- `_hol_st0`, `_hol_st1`, ... -- rather than as compile-time state
// belonging to this macro.  `raco make` compiles many modules in one process,
// so macro-level state would be shared between them; per-module phase-1
// definitions cannot be.  Every generated identifier comes out of a single
// expansion of this one macro, so they share an introduction scope, refer to
// each other with no name surgery, and cannot be captured by user code.
//
// All syntax templates live here.  A template built in a phase-0 helper module
// loses its bindings on the way out of a phase-1 macro -- `'def x = 1'`
// written there and returned from a macro reports `def: unbound identifier` --
// so `expand.rhm` and `elab.rhm` analyse, and this module emits.

import:
  rhombus/meta open
  rhombus/hol/qc as _hol_qc
  rhombus/hol/frontend/surface_space!meta:
    expose:
      hol_expr_meta
  rhombus/hol/frontend/surface_notation open
  meta:
    lib("racket/base.rkt") as rb
    rhombus/hol/htype open
    rhombus/hol/kernel open
    rhombus/hol/frontend/tyunify open
    rhombus/hol/datatype/datatype open
    rhombus/hol/frontend/expand as expand
    rhombus/hol/frontend/elab as elab
    rhombus/hol/frontend/driver open
    rhombus/hol/frontend/dispatch open
    rhombus/hol/frontend/surface_state open
    rhombus/hol/frontend/surface_core open
export:
  module_block

meta:
  // Any literal from this module will do as a lexical context: what matters is
  // that all the generated identifiers share one, and that the expander's
  // introduction scope lands on them alike.
  def id_ctx :: Syntax = 'hol_state'
  Parameter.def runtime_context :: Syntax = id_ctx


  fun st(n :: Int) :: Syntax:
    Syntax.make_id("_hol_st" ++ to_string(n), id_ctx)

  // Expansion-local wrapper around the importable surface state. The fallback
  // theory is needed only for kernel primitives and legacy theory modules.
  class SurfaceContext(surface :: SurfaceState,
                       fallback_theory :: maybe(Theory),
                       pending_imports :: List.of(List.of(Syntax)))

  def surface_state_key = #'rhombus_hol_surface_state
  def initial_surface_context:
    let base = initial_state()
    SurfaceContext(SurfaceState(base.operators, {}), base.ctx.thy, [])

  fun state_on(stx :: Syntax) :: SurfaceContext:
    match rb.#{syntax-property}(stx, surface_state_key)
    | state :: SurfaceContext: state
    | #false: initial_surface_context
    | ~else: error(~who: #'module_block, "invalid surface elaboration state")

  fun carry_state(stx :: Syntax, state :: SurfaceContext) :: Syntax:
    rb.#{syntax-property}(stx, surface_state_key, state)

  fun imported_surface_context(terms :: List.of(Syntax)) :: SurfaceContext:
    let [t, ...] = terms
    let path:
      match ModulePath.maybe('$t ...')
      | #false: error(~who: #'import, "invalid imported theory path")
      | p: p :~ ModulePath
    let surface_path = path.add(ModulePath('self ! hol_surface'))
    fun load_surface() :: SurfaceContext:
      let imported = Evaluator.instantiate(surface_path, #'state)
      let imported :~ SurfaceState = imported
      SurfaceContext(imported, initial_surface_context.fallback_theory, [])
    fun load_legacy_theory() :: SurfaceContext:
      let imported = Evaluator.instantiate(
                       path.add(ModulePath('self ! hol_theory')), #'theory)
      let imported :~ HolState = imported
      SurfaceContext(SurfaceState(imported.operators, {}),
                     imported.ctx.thy, [])
    if Evaluator.module_is_declared(surface_path, ~load: #true)
    | load_surface()
    | load_legacy_theory()

  fun force_surface_context(context :: SurfaceContext) :: SurfaceContext:
    for values(current :~ SurfaceContext = context) (
          terms in context.pending_imports):
      let imported = imported_surface_context(terms :~ List.of(Syntax))
      SurfaceContext(
        merge_surface_states(imported.surface, current.surface),
        imported.fallback_theory,
        [])

  fun defer_surface_import(context :: SurfaceContext,
                           terms :: List.of(Syntax)) :: SurfaceContext:
    SurfaceContext(context.surface, context.fallback_theory,
                   context.pending_imports ++ [terms])

  fun surface_const_type(context :: SurfaceContext, name :: Symbol)
       :: maybe(HType):
    match context.surface.constants.get(name, #false)
    | ty :: HType: ty
    | #false:
        match context.fallback_theory
        | #false: #false
        | thy: const_type(thy :~ Theory, name)

  fun surface_add_family(context :: SurfaceContext, name :: Symbol,
                         arity :: NonnegInt) :: SurfaceContext:
    SurfaceContext(
      SurfaceState(
        add_dispatch_family(
          context.surface.operators, DispatchFamily(name, arity)),
        context.surface.constants),
      context.fallback_theory,
      context.pending_imports)

  fun dispatch_argument_position(argument_names :: List,
                                 name :: Symbol,
                                 at :: Syntax) :: NonnegInt:
    recur find (index = 0):
      cond
      | index == argument_names.length():
          syntax_meta.error(
            "implementation template uses an unknown dispatch argument `"
              ++ to_string(name) ++ "`",
            at)
      | argument_names[index] == name: index
      | ~else: find(index + 1)

  fun dispatch_argument_order(argument_names :: List,
                              template_arguments :: maybe(List.of(Symbol)),
                              at :: Syntax) :: List.of(NonnegInt):
    let arity = argument_names.length()
    match template_arguments
    | #false: List.iota(arity)
    | arguments:
        when argument_names.contains(#false)
        | syntax_meta.error(
            "an implementation template needs named dispatch arguments", at)
        let order:
          for List (argument in (arguments :~ List.of(Symbol))):
            dispatch_argument_position(argument_names, argument, at)
        unless valid_argument_order(order, arity)
        | syntax_meta.error(
            "implementation template must use every dispatch argument "
              ++ "exactly once",
            at)
        order

  fun surface_add_method(
        context :: SurfaceContext, family_name :: Symbol,
        argument_type_stxs :: List.of(Syntax),
        result_type_stx :: maybe(Syntax),
        constant :: Symbol, argument_order :: List.of(NonnegInt),
        at :: Syntax) :: SurfaceContext:
    let ready = force_surface_context(context)
    let arity = argument_type_stxs.length()
    let registry_with_family = add_dispatch_family(
                                 ready.surface.operators,
                                 DispatchFamily(family_name, arity))
    let argument_types = argument_type_stxs.map(elab.parse_open_type)
    let result_type:
      match result_type_stx
      | #false: #false
      | result_stx: elab.parse_open_type(result_stx :~ Syntax)
    let constant_type:
      match surface_const_type(ready, constant)
      | #false:
          syntax_meta.error(
            "implementation constant is not declared: "
              ++ to_string(constant),
            at)
      | ty: ty :~ HType
    let method:
      try:
        build_dispatch_method(
          family_name, argument_types, result_type,
          constant, constant_type, argument_order)
        ~catch e :: Exn.Fail:
          syntax_meta.error(e.message, at)
    SurfaceContext(
      SurfaceState(
        add_dispatch_method(registry_with_family, method),
        ready.surface.constants),
      ready.fallback_theory,
      ready.pending_imports)

  fun surface_add_function(context :: SurfaceContext, form :: Syntax)
       :: SurfaceContext:
    let [name, params, result_type, _, _] = elab.function_parts(form)
    let ps :~ List = params
    let result = elab.parse_open_type(result_type :~ Syntax)
    let domains = ps.map(
                    fun (param :: Syntax):
                      match param
                      | '$_ :: $ty ...':
                          elab.parse_open_type('$ty ...')
                      | ~else:
                          error(~who: #'function,
                                "a parameter needs a type"))
    let full_type = for values(ty :~ HType = result) (domain in domains.reverse()):
                      mk_fun(domain :~ HType, ty)
    SurfaceContext(
      SurfaceState(
        context.surface.operators,
        context.surface.constants ++ {Syntax.unwrap(name): full_type}),
      context.fallback_theory,
      context.pending_imports)

  fun surface_add_type(context :: SurfaceContext, form :: Syntax)
       :: SurfaceContext:
    let spec = elab.parse_type_decl(form)
    let additions:
      for values(out :~ Map = context.surface.constants) (ctor in spec.ctors):
        let ctor :~ Ctor = ctor
        out ++ {ctor.name: ctor_type(spec, ctor)}
    SurfaceContext(
      SurfaceState(context.surface.operators, additions),
      context.fallback_theory,
      context.pending_imports)

  fun surface_symbol_expr(name :: Symbol) :: Syntax:
    let text = Syntax.make(to_string(name), id_ctx)
    'Symbol.from_string($text)'

  fun surface_type_expr(ty :: HType) :: Syntax:
    match ty
    | TyVar(name):
        'mk_tyvar($(surface_symbol_expr(name)))'
    | TyApp(name, args):
        let [arg, ...] = args.map(surface_type_expr)
        'mk_tyapp($(surface_symbol_expr(name)), [$arg, ...])'

  fun surface_family_expr(family :: DispatchFamily) :: Syntax:
    let arity = Syntax.make(family.arity, id_ctx)
    'DispatchFamily($(surface_symbol_expr(family.name)), $arity)'

  fun surface_method_expr(method :: DispatchMethod) :: Syntax:
    let [argument_type, ...] = method.argument_types.map(surface_type_expr)
    let result_type = surface_type_expr(method.result_type)
    let [position, ...] = method.argument_order.map(
                            fun (value): Syntax.make(value, id_ctx))
    'DispatchMethod(
       $(surface_symbol_expr(method.family)),
       [$argument_type, ...],
       $result_type,
       $(surface_symbol_expr(method.constant)),
       [$position, ...])'

  fun surface_constant_expr(name :: Symbol, ty :: HType) :: Syntax:
    '[$(surface_symbol_expr(name)), $(surface_type_expr(ty))]'

  fun emit_surface_state(context :: SurfaceContext) :: Syntax:
    let ready = force_surface_context(context).surface
    let family_exprs:
      for values(out :~ List = []) ((_, family) in ready.operators.families):
        out ++ [surface_family_expr(family :~ DispatchFamily)]
    let [family, ...] = family_exprs
    let [method, ...] = ready.operators.methods.map(
                          fun (value):
                            surface_method_expr(value :~ DispatchMethod))
    let constant_exprs:
      for values(out :~ List = []) ((name, ty) in ready.constants):
        out ++ [surface_constant_expr(name, ty :~ HType)]
    let [constant, ...] = constant_exprs
    'module hol_surface ~lang rhombus:
       import:
         rhombus/hol/htype open
         rhombus/hol/frontend/dispatch open
         rhombus/hol/frontend/surface_state open
       export: state
       def state = make_surface_state(
                     [$family, ...],
                     [$method, ...],
                     [$constant, ...])'


  // A term rebuilt with this module's context.
  //
  // Needed for the terms of a module path emitted into the `hol_theory`
  // submodule: that submodule's language is plain `rhombus`, and a term
  // carrying the user's `rhombus/hol` context cannot reach the implicit import
  // forms there -- a string path fails looking for `#%literal`.  Only the
  // datum matters for a module path, so rebuilding it loses nothing.
  fun recontext(t :: Syntax) :: Syntax:
    Syntax.make(Syntax.unwrap(t), id_ctx)

  // -- datatypes -------------------------------------------------------------

  // `class.together` so that a datatype can refer to itself, and an
  // `interface` rather than a base class as the sum: an interface carries no
  // fields and imposes no field order on the variants.
  //
  // Field annotations are dropped -- that is the type erasure.  Rhombus has no
  // parametric polymorphism, so `List(?a)` has nothing to erase *to*, and the
  // logical side has already checked the types.
  fun emit_type(name :: Syntax, ctors :: List) :: Syntax:
    let [variant, ...] = ctors.map(fun (c :: List): emit_variant(name, c))
    'class.together:
       interface $name
       $variant
       ...'

  fun emit_variant(iface :: Syntax, c :: List) :: Syntax:
    let [cname, fields] = c
    let fs :~ List = fields
    let [f, ...] = fs
    'class $cname($f, ...):
       implements $iface'

  // -- generators and shrinkers ----------------------------------------------
  //
  // Emitted alongside a datatype, from the same declaration, so that
  // `quickcheck` has values to sample. They are ordinary Rhombus functions
  // over the emitted classes; checking runs the real executable code.
  //
  // They reach `quickcheck` through `qc.rhm`'s registry rather than through a
  // guessed identifier. `type` registers its generator and shrinker under the
  // type's own name when its module is instantiated. No generated helper needs
  // to be exported.
  //
  // A name has to travel as a plain string, not a `Symbol`: a symbol written
  // `#'foo` cannot appear inside a syntax template, the quote would close it.

  fun type_name_str(n :: Symbol) :: Syntax:
    Syntax.make(to_string(n), id_ctx)

  fun param_gen_id(p :: Symbol) :: Syntax:
    Syntax.make_id("_hol_g_" ++ to_string(p), id_ctx)

  // A generator expression for a type: a function from a size to a value.
  fun gen_expr(ty) :: Syntax:
    match ty
    | TyVar(a): param_gen_id(a)
    | TyApp(n, args):
        let nm = type_name_str(n)
        let [sub, ...] = args.map(fun (t): gen_expr(t))
        // Parenthesised: a `fun ...:` block cannot sit in application position
        // or before a comma without one.
        '(fun (_hol_s): _hol_qc.lookup_gen($nm)(_hol_s, $sub, ...))'

  fun shrink_expr(ty, at :: Syntax) :: Syntax:
    match ty
    | TyApp(n, _): '_hol_qc.lookup_shrink($(type_name_str(n)))'
    | ~else:
        error(~who: #'quickcheck,
              "cannot shrink a value of variable type",
              error.val(~label: "in", to_string(at)))

  fun emit_generator(name :: Syntax, params :: List, ctors :: List) :: Syntax:
    let nm = type_name_str(Syntax.unwrap(name))
    let [pg, ...] = params.map(fun (p :: Symbol): param_gen_id(p))
    let base = ctors.filter(~keep: fun (c :: List): !(c[2] :~ Boolean))
    let [b, ...] = base.map(ctor_builder)
    let [a, ...] = ctors.map(ctor_builder)
    let build = 'fun (_hol_sz, $pg, ...):
                   _hol_qc.pick(_hol_sz, [$b, ...], [$a, ...])'
    '_hol_qc.register_gen($nm, $build)'

  // `[ctor_id, [field_type, ...], recursive?]`
  fun ctor_builder(c :: List) :: Syntax:
    let cname = c[0] :~ Syntax
    let ftys :~ List = c[1]
    let [arg, ...] = ftys.map(fun (t): '$(gen_expr(t))(_hol_sz - 1)')
    'fun (): $cname($arg, ...)'

  fun emit_shrinker(name :: Syntax, ctors :: List) :: Syntax:
    let nm = type_name_str(Syntax.unwrap(name))
    let [clause, ...] = ctors.map(fun (c :: List): shrink_clause(name, c))
    let build = 'fun (_hol_v):
                   match _hol_v
                   | $clause
                   | ...'
    '_hol_qc.register_shrink($nm, $build)'

  // The classic shrink for an algebraic value: its recursive subterms.
  fun shrink_clause(tname :: Syntax, c :: List) :: Syntax:
    let cname = c[0] :~ Syntax
    let ftys :~ List = c[1]
    let n = ftys.length()
    let vs = for List (i in List.iota(n)):
               Syntax.make_id("_hol_f" ++ to_string(i), id_ctx)
    let [v, ...] = vs
    let keep = for values(acc :~ List = []) (t in ftys, vv in vs):
                 (if same_type_name(t, tname) | acc ++ [vv] | acc)
    let [k, ...] = keep
    '$cname($v, ...): [$k, ...]'

  fun same_type_name(ty, tname :: Syntax) :: Boolean:
    match ty
    | TyApp(n, _): n == Syntax.unwrap(tname)
    | ~else: #false

  // -- quickcheck -------------------------------------------------------------

  fun emit_quickcheck_in(state :: SurfaceContext,
                         name :: Syntax,
                         opts :: List.of(Syntax),
                         core :: Syntax,
                         at :: Syntax) :: Syntax:
    let expr = decode_prop(core)
    let (binders, body):
      match expr
      | CoreForall(bs, proposition, _): values(bs, proposition)
      | ~else:
          syntax_meta.error(
            "a quickcheck property starts with `forall (x :: T, ...):`",
            at)
    let parsed:
      for List (binder in (binders :~ List.of(CoreBinder))):
        let binder :~ CoreBinder = binder
        let ty = elab.parse_open_type(binder.type_stx)
        when type_vars(ty).length() > 0
        | syntax_meta.error(
            "a quickcheck input type must be concrete", binder.at)
        [source_id(binder.name, binder.at), binder.name, ty]
    let ready = force_surface_context(state)
    let env:
      for values(out :~ Map = {}) (entry in parsed):
        let entry :~ List = entry
        out ++ {entry[1] :~ Symbol: entry[2] :~ HType}
    let rendered = runtime_expr(
                     ready, env, body :~ CoreExpr,
                     mk_tyapp(#'bool, [])).stx
    let [v, ...] = parsed.map(fun (entry :: List): entry[0] :~ Syntax)
    let [g, ...] = parsed.map(fun (entry :: List): gen_expr(entry[2]))
    let [sh, ...] = parsed.map(fun (entry :: List): shrink_expr(entry[2], at))
    let [samples, size, seed] = elab.quickcheck_options(opts)
    let count = Syntax.make(samples, id_ctx)
    let sz = Syntax.make(size, id_ctx)
    let seed_stx = Syntax.make(seed, id_ctx)
    let prop = 'fun ($v, ...): $rendered'
    'import: rhombus/hol/qc as _hol_qc
     _hol_qc.assert_run(
       Syntax.unwrap('$name'),
       ~samples: $count,
       ~size: $sz,
       ~seed: $seed_stx,
       ~gens: [$g, ...],
       ~shrinks: [$sh, ...],
       ~prop: $prop)'

  fun emit_quickcheck(state :: SurfaceContext,
                      name :: Syntax,
                      opts :: List.of(Syntax),
                      core :: Syntax,
                      at :: Syntax) :: Syntax:
    parameterize { runtime_context: name }:
      emit_quickcheck_in(state, name, opts, core, at)

  // -- functions -------------------------------------------------------------

  class RuntimeExpr(stx :: Syntax, ty :: HType)

  fun source_id(name :: Symbol, _at :: Syntax) :: Syntax:
    Syntax.make_id(to_string(name), runtime_context())

  fun runtime_call_syntax(name :: Symbol, args :: List.of(Syntax),
                          at :: Syntax) :: Syntax:
    let id = source_id(name, at)
    let [arg, ...] = args
    '$id($arg, ...)'


  fun runtime_peel(ty :: HType, arity :: NonnegInt)
       :: values(List.of(HType), HType):
    recur loop (current = ty, remaining = arity,
                domains :~ List.of(HType) = []):
      cond
      | remaining == 0: values(domains, current)
      | is_fun(current):
          let (domain, range) = dest_fun(current)
          loop(range, remaining - 1, domains ++ [domain])
      | ~else:
          error(~who: #'dispatch,
                "constant has fewer arguments than required")

  fun runtime_fresh_type(ty :: HType) :: HType:
    let renaming:
      for values(out :~ Map = {}) (v in type_vars(ty)):
        out ++ {v: mk_tyvar(Symbol.gen(to_string(v))) :~ HType}
    type_subst(renaming, ty)

  fun runtime_needs_expected(state :: SurfaceContext,
                             expr :: CoreExpr) :: Boolean:
    fun every_arg(args :: List.of(CoreExpr)) :: Boolean:
      args.length() == 0
        || for values(all = #true) (arg in args):
             all && runtime_needs_expected(state, arg :~ CoreExpr)
    match expr
    | CoreNumeral(_, _): #true
    | CoreCall(CoreOverloadRef(_, _, _), args, _): every_arg(args)
    | CoreCall(CoreRef(name, _), args, _) when dispatch_family(state.surface.operators, name):
        every_arg(args)
    | CoreCall(_, args, _):
        for values(found = #false) (arg in args):
          found || runtime_needs_expected(state, arg :~ CoreExpr)
    | CoreOverloadRef(_, _, _): #true
    | CoreIf(_, then_expr, else_expr, _):
        runtime_needs_expected(state, then_expr)
          || runtime_needs_expected(state, else_expr)
    | ~else: #false

  fun runtime_numeral(value :: NonnegInt, expected :: HType,
                      at :: Syntax) :: RuntimeExpr:
    let nat_ty = mk_tyapp(#'Nat, [])
    let int_ty = mk_tyapp(#'Integer, [])
    let rational_ty = mk_tyapp(#'Rational, [])
    fun nat_syntax() :: Syntax:
      recur build (remaining = value,
                   term = runtime_call_syntax(#'zero, [], at)):
        if remaining == 0
        | term
        | build(remaining - 1,
                runtime_call_syntax(#'succ, [term], at))
    cond
    | expected == nat_ty: RuntimeExpr(nat_syntax(), nat_ty)
    | expected == int_ty:
        RuntimeExpr(runtime_call_syntax(#'int_from_nat, [nat_syntax()], at),
                    int_ty)
    | expected == rational_ty:
        let integer = runtime_call_syntax(
                        #'int_from_nat, [nat_syntax()], at)
        RuntimeExpr(runtime_call_syntax(
                      #'rational_from_integer, [integer], at),
                    rational_ty)
    | ~else:
        syntax_meta.error(
          "a numeral has no representation at type "
            ++ type_to_string(expected),
          at)

  fun runtime_dispatch_expr(state :: SurfaceContext,
                            env :: Map.of(Symbol, HType),
                            family_name :: Symbol,
                            display_name :: String,
                            args :: List.of(CoreExpr),
                            expected :: maybe(HType),
                            at :: Syntax) :: RuntimeExpr:
    let family:
      match dispatch_family(state.surface.operators, family_name)
      | #false:
          syntax_meta.error(
            "unknown dispatch family " ++ to_string(family_name), at)
      | value: value :~ DispatchFamily
    unless args.length() == family.arity
    | syntax_meta.error(
        "`" ++ display_name ++ "` expects "
          ++ to_string(family.arity) ++ " arguments",
        at)
    let known:
      for List (arg in args):
        let arg :~ CoreExpr = arg
        (if runtime_needs_expected(state, arg)
         | #false
         | runtime_expr(state, env, arg, #false))
    let argument_types:
      known.map(
        fun (value):
          match value
          | #false: #false
          | runtime: (runtime :~ RuntimeExpr).ty)
    let matches = resolve_dispatch(
                    state.surface.operators, family_name,
                    argument_types, expected)
    when matches.length() == 0
    | syntax_meta.error(
        "`" ++ display_name ++ "` has no applicable dispatch",
        at)
    when matches.length() > 1
    | syntax_meta.error(
        "`" ++ display_name ++ "` has ambiguous dispatch",
        at)
    let resolution :~ DispatchResolution = matches[0]
    let method = resolution.method
    let rendered:
      for List (arg in args, prior in known,
                expected_type in resolution.argument_types):
        match prior
        | runtime :: RuntimeExpr:
            match type_unify(runtime.ty, expected_type, {})
            | #false:
                syntax_meta.error(
                  "dispatch argument has an unexpected type", at)
            | _:
                RuntimeExpr(runtime.stx, expected_type)
        | #false:
            runtime_expr(
              state, env, arg :~ CoreExpr, expected_type)
    let ordered = method.argument_order.map(
                    fun (index):
                      (rendered[index] :~ RuntimeExpr).stx)
    RuntimeExpr(runtime_call_syntax(method.constant, ordered, at),
                resolution.result_type)

  fun needs_runtime_lowering(state :: SurfaceContext,
                             expr :: CoreExpr) :: Boolean:
    match expr
    | CoreNumeral(_, _) || CoreOverloadRef(_, _, _): #true
    | CoreCall(CoreRef(name, _), _, _) when dispatch_family(state.surface.operators, name): #true
    | CoreCall(func, args, _):
        needs_runtime_lowering(state, func)
          || for values(found = #false) (arg in args):
               found || needs_runtime_lowering(state, arg :~ CoreExpr)
    | CoreIf(condition, then_expr, else_expr, _):
        needs_runtime_lowering(state, condition)
          || needs_runtime_lowering(state, then_expr)
          || needs_runtime_lowering(state, else_expr)
    | ~else: #false

  fun runtime_expr(state :: SurfaceContext, env :: Map.of(Symbol, HType),
                   expr :: CoreExpr,
                   expected :: maybe(HType) = #false) :: RuntimeExpr:
    fun ensure(value :: RuntimeExpr) :: RuntimeExpr:
      match expected
      | #false: value
      | wanted:
          match type_unify(value.ty, wanted :~ HType, {})
          | #false:
              syntax_meta.error("expression has an unexpected type",
                                runtime_context())
          | _:
              RuntimeExpr(value.stx, wanted :~ HType)
    match expr
    | CoreRef(name, at) when name == #'true:
        ensure(RuntimeExpr(Syntax.make(#true, runtime_context()),
                           mk_tyapp(#'bool, [])))
    | CoreRef(name, at) when name == #'false:
        ensure(RuntimeExpr(Syntax.make(#false, runtime_context()),
                           mk_tyapp(#'bool, [])))
    | CoreRef(name, at):
        let ty:
          match env.get(name, #false)
          | found :: HType: found
          | #false:
              match surface_const_type(state, name)
              | found :: HType: found
              | #false:
                  syntax_meta.error("unknown constant " ++ to_string(name),
                                    at)
        ensure(RuntimeExpr(source_id(name, at), ty))
    | CoreNumeral(value, at):
        match expected
        | #false:
            syntax_meta.error("a numeral needs an expected numeric type", at)
        | wanted: runtime_numeral(value, wanted :~ HType, at)
    | CoreOverloadRef(_, _, at):
        syntax_meta.error("an overloaded reference must be called", at)
    | CoreCall(func, args, at):
        match func
        | CoreOverloadRef(family, display_name, _):
            runtime_dispatch_expr(
              state, env, family, display_name, args, expected, at)
        | CoreRef(name, _) when !env.get(name, #false)
                                  && !surface_const_type(state, name)
                                  && dispatch_family(state.surface.operators, name):
            runtime_dispatch_expr(
              state, env, name, to_string(name), args, expected, at)
        | CoreRef(name, _) when name == #'eq && args.length() == 2:
            let left_core :~ CoreExpr = args[0]
            let right_core :~ CoreExpr = args[1]
            let (left, right):
              cond
              | runtime_needs_expected(state, right_core)
                  && !runtime_needs_expected(state, left_core):
                  let left = runtime_expr(state, env, left_core, #false)
                  values(left,
                         runtime_expr(state, env, right_core, left.ty))
              | runtime_needs_expected(state, left_core)
                  && !runtime_needs_expected(state, right_core):
                  let right = runtime_expr(state, env, right_core, #false)
                  values(runtime_expr(state, env, left_core, right.ty),
                         right)
              | ~else:
                  let left = runtime_expr(state, env, left_core, #false)
                  let right = runtime_expr(state, env, right_core, #false)
                  unless type_unify(left.ty, right.ty, {}) != #false
                  | syntax_meta.error(
                      "equality operands have different types", at)
                  values(left, right)
            ensure(RuntimeExpr('$((left.stx)) == $((right.stx))',
                               mk_tyapp(#'bool, [])))
        | CoreRef(name, _) when (name == #'conj || name == #'disj)
                                  && args.length() == 2:
            let bool_ty = mk_tyapp(#'bool, [])
            let left = runtime_expr(state, env, args[0] :~ CoreExpr, bool_ty)
            let right = runtime_expr(state, env, args[1] :~ CoreExpr, bool_ty)
            let rendered = (if name == #'conj
                            | '$((left.stx)) && $((right.stx))'
                            | '$((left.stx)) || $((right.stx))')
            ensure(RuntimeExpr(rendered, bool_ty))
        | CoreRef(name, _) when name == #'neg && args.length() == 1:
            let bool_ty = mk_tyapp(#'bool, [])
            let operand = runtime_expr(
                            state, env, args[0] :~ CoreExpr, bool_ty)
            ensure(RuntimeExpr('! $((operand.stx))', bool_ty))
        | ~else:
            let head = runtime_expr(state, env, func, #false)
            recur apply (remaining :~ List = args,
                         current :~ HType = runtime_fresh_type(head.ty),
                         rendered :~ List = [],
                         theta :~ Map = {}):
              match remaining
              | []:
                  let [arg, ...] = rendered
                  ensure(RuntimeExpr('$((head.stx))($arg, ...)',
                                     type_subst(theta, current)))
              | List.cons(arg, rest):
                  let instantiated = type_subst(theta, current)
                  unless is_fun(instantiated)
                  | syntax_meta.error("too many function arguments", at)
                  let (domain, range) = dest_fun(instantiated)
                  let value = (if runtime_needs_expected(state, arg :~ CoreExpr)
                               | runtime_expr(
                                   state, env, arg :~ CoreExpr, domain)
                               | runtime_expr(
                                   state, env, arg :~ CoreExpr, #false))
                  let next:
                    match type_unify(domain, value.ty, theta)
                    | #false:
                        syntax_meta.error(
                          "operand type does not match function domain", at)
                    | substitution: substitution :~ Map
                  apply(rest, range, rendered ++ [value.stx], next)
    | CoreIf(condition, then_expr, else_expr, at):
        let condition_value = runtime_expr(
                                state, env, condition,
                                mk_tyapp(#'bool, []))
        let then_value = runtime_expr(state, env, then_expr, expected)
        let else_value = runtime_expr(
                           state, env, else_expr, then_value.ty)
        let rendered:
          'if $((condition_value.stx))
           | $((then_value.stx))
           | $((else_value.stx))'
        ensure(RuntimeExpr(rendered, then_value.ty))
    | ~else:
        syntax_meta.error("expression has no runtime meaning",
                          runtime_context())

  fun runtime_pattern(state :: SurfaceContext, pat :: CorePattern,
                      expected :: HType)
       :: values(Syntax, Map.of(Symbol, HType)):
    match pat
    | CorePatWildcard(at): values(source_id(#'_, at), {})
    | CorePatVar(name, at):
        values(source_id(name, at), {name: expected})
    | CorePatCtor(name, args, at):
        let generic:
          match surface_const_type(state, name)
          | #false:
              syntax_meta.error("unknown constructor " ++ to_string(name), at)
          | ty: ty :~ HType
        let (domains, result) = runtime_peel(generic, args.length())
        let theta:
          match type_match(result, expected, {})
          | #false:
              syntax_meta.error(
                "constructor does not build the matched type", at)
          | substitution: substitution :~ Map
        let parsed:
          for List (arg in args, domain in domains):
            let (rendered, bindings) = runtime_pattern(
                                          state, arg :~ CorePattern,
                                          type_subst(theta,
                                                     domain :~ HType))
            [rendered, bindings]
        let [rendered, ...] = parsed.map(
                                fun (entry :: List):
                                  entry[0] :~ Syntax)
        let bindings:
          for values(out :~ Map = {}) (entry in parsed):
            out ++ ((entry :~ List)[1] :~ Map)
        let constructor = source_id(name, at)
        values('$constructor($rendered, ...)', bindings)
    | ~else:
        error(~who: #'function, "unknown runtime pattern")

  fun runtime_body(state :: SurfaceContext,
                   env :: Map.of(Symbol, HType),
                   body :: CoreFunBody,
                   expected :: HType) :: Syntax:
    match body
    | CoreBodyExpr(expr, _):
        runtime_expr(state, env, expr, expected).stx
    | CoreBodyLet(name, init, tail, at):
        let value = runtime_expr(state, env, init, #false)
        let id = source_id(name, at)
        let rest = runtime_body(
                     state, env ++ {name: value.ty}, tail, expected)
        'let $id = $((value.stx))
         $rest'
    | CoreBodyMatch(scrutinee, clauses, at):
        let scrutinee_type:
          match env.get(scrutinee, #false)
          | #false:
              syntax_meta.error("match scrutinee is not bound", at)
          | ty: ty :~ HType
        let rendered:
          for List (clause in clauses):
            let clause :~ CoreMatchClause = clause
            let (pattern_stx, bindings) = runtime_pattern(
                                            state, clause.pattern,
                                            scrutinee_type)
            let result = runtime_body(
                           state, env ++ bindings, clause.body, expected)
            '$pattern_stx: $result'
        let target = source_id(scrutinee, at)
        let [clause, ...] = rendered
        'match $target
         | $clause
         | ...'
    | ~else:
        error(~who: #'function, "invalid nested function body")

  fun runtime_row(state :: SurfaceContext,
                  base_env :: Map.of(Symbol, HType),
                  name :: Syntax,
                  parameter_types :: List.of(HType),
                  expected :: HType,
                  row :: CoreRow) :: Syntax:
    let parsed:
      for List (pat in row.patterns, ty in parameter_types):
        let (rendered, bindings) = runtime_pattern(
                                      state, pat :~ CorePattern,
                                      ty :~ HType)
        [rendered, bindings]
    let bindings:
      for values(out :~ Map = base_env) (entry in parsed):
        out ++ ((entry :~ List)[1] :~ Map)
    let result = runtime_body(state, bindings, row.body, expected)
    let [pattern_stx, ...] = parsed.map(
                               fun (entry :: List): entry[0] :~ Syntax)
    '$name($pattern_stx, ...): $result'

  // The executable half lowers the same CoreExpr tree as the logical half.
  // Dispatch methods are therefore selected at expansion time from declared
  // argument and expected-result types; generated code contains only direct
  // named calls.
  fun body_needs_runtime_lowering(state :: SurfaceContext,
                                  body :: CoreFunBody) :: Boolean:
    match body
    | CoreBodyExpr(expr, _): needs_runtime_lowering(state, expr)
    | CoreBodyLet(_, init, tail, _):
        needs_runtime_lowering(state, init)
          || body_needs_runtime_lowering(state, tail)
    | CoreBodyMatch(_, clauses, _):
        for values(found = #false) (clause in clauses):
          found || body_needs_runtime_lowering(
                     state, (clause :~ CoreMatchClause).body)
    | CoreBodyRows(rows, _):
        for values(found = #false) (row in rows):
          found || body_needs_runtime_lowering(
                     state, (row :~ CoreRow).body)
    | ~else: #false

  fun emit_raw_function(name :: Syntax, parameter_names :: List.of(Syntax),
                        body :: Syntax) :: Syntax:
    match elab.body_clauses(body)
    | #false:
        let [parameter, ...] = parameter_names
        'fun $name($parameter, ...):
           $body'
    | clauses:
        let rendered:
          for List (clause in clauses :~ List):
            let (patterns, result) = elab.row_parts(
                                      clause :~ Syntax,
                                      parameter_names.length())
            let [pat, ...] = patterns
            '$name($pat, ...): $result'
        let [alternative, ...] = rendered
        'fun
         | $alternative
         | ...'

  fun emit_function(spec :: CoreFunctionSpec, state :: SurfaceContext,
                    name :: Syntax, parameter_names :: List.of(Syntax),
                    raw_body :: Syntax)
       :: Syntax:
    cond
    | !body_needs_runtime_lowering(state, spec.body):
        emit_raw_function(name, parameter_names, raw_body)
    | ~else:
        emit_lowered_function(spec, state, name, parameter_names)

  fun emit_lowered_function(spec :: CoreFunctionSpec, state :: SurfaceContext,
                            name :: Syntax,
                            parameter_names :: List.of(Syntax)) :: Syntax:
    parameterize { runtime_context: name }:
      let parameter_types = spec.params.map(
                              fun (binder :: CoreBinder):
                                elab.parse_open_type(binder.type_stx))
      let result_type = elab.parse_open_type(spec.result_type)
      let env:
        for values(out :~ Map = {}) (binder in spec.params,
                                     ty in parameter_types):
          out ++ {(binder :~ CoreBinder).name: ty :~ HType}
      match spec.body
      | CoreBodyRows(rows, _):
          let rendered = rows.map(
                           fun (row :: CoreRow):
                             runtime_row(state, env, name,
                                         parameter_types, result_type, row))
          let [alternative, ...] = rendered
          'fun
           | $alternative
           | ...'
      | body:
          let [parameter, ...] = parameter_names
          let result = runtime_body(state, env, body, result_type)
          'fun $name($parameter, ...):
             $result'

  // -- rule control ----------------------------------------------------------

  // `disable_rules` / `enable_rules` emit no run-time code and one
  // compile-time state step, like every other declaration here.  This used to
  // return two values where `emit_one` wants three (run-time forms,
  // compile-time forms, counter), so *any* module using either form failed to
  // expand -- the forms were documented, reachable from the grammar, and
  // untested, so nothing said so.
  fun rule_step(d :: expand.Decl, n :: Int, cur :: Syntax, nxt :: Syntax,
                on :: Boolean) :: values(List.of(Syntax), List.of(Syntax), Int):
    let [names] = d.parts
    let ns :~ List = names
    let [nm, ...] = ns
    let flag = (if on | '#true' | '#false')
    values([], ['(~rules $cur $nxt [$flag] [$nm, ...])'], n + 1)

  // -- HOL surface parsing ---------------------------------------------------

  fun parse_core_encoding(stx :: Syntax) :: Syntax:
    try:
      let '$(parsed :: hol_expr_meta.Parsed)' = stx
      hol_expr_meta.unpack(parsed)
      ~catch e :: Exn.Fail:
        (if e.message.contains("unbound HOL expression operator")
         | syntax_meta.error("unexpected text after an expression", stx)
         | throw e)

  fun parse_function_expression(stx :: Syntax) :: Syntax:
    try:
      parse_core_encoding(stx)
      ~catch e :: Exn.Fail:
        (if e.message.contains("hol_expr_meta.Parsed")
             && e.message.contains("annotation")
         | syntax_meta.error(
             "this version admits only variables, named applications, `if`, "
               ++ "`cond`, and notation with both runtime and logic meanings in a function body",
             stx)
         | throw e)

  fun symbol_id(n :: Symbol) :: Syntax:
    Syntax.make_id(to_string(n), id_ctx)


  fun binder_encoding(param :: Syntax) :: Syntax:
    match param
    | '$(name :: Identifier) :: $ty ...':
        '(core_binder $name ($ty ...))'.relocate_span([param])
    | ~else: syntax_meta.error("a parameter needs a name and a type", param)

  fun pattern_encoding(pat :: Syntax) :: Syntax:
    match pat
    | '_': '(core_pat_wildcard)'.relocate(pat)
    | '$(name :: Identifier)($arg, ...)':
        let [a, ...] = [arg, ...].map(pattern_encoding)
        '(core_pat_ctor $name [$a, ...])'.relocate_span([pat])
    | '$(name :: Identifier)':
        '(core_pat_var $name)'.relocate(pat)
    | ~else: syntax_meta.error("malformed pattern", pat)

  fun match_clause_encoding(clause :: Syntax) :: Syntax:
    match clause
    | '$pat ...: $body; ...':
        let p = pattern_encoding('$pat ...')
        let b = function_body_encoding('$body; ...')
        '(core_match_clause $p $b)'.relocate_span([clause])
    | ~else: syntax_meta.error("malformed match clause", clause)

  fun row_encoding(row :: Syntax, arity :: Int) :: Syntax:
    let (patterns, body) = elab.row_parts(row, arity)
    let [p, ...] = patterns.map(pattern_encoding)
    let b = function_body_encoding(body)
    '(core_row [$p, ...] $b)'.relocate_span([row])

  fun function_body_encoding(body :: Syntax) :: Syntax:
    match body
    | '#%hol_clauses: $row; ...':
        syntax_meta.error("internal function row needs an arity", body)
    | 'match $(name :: Identifier)
       | $clause
       | ...':
        let [c, ...] = [clause, ...].map(match_clause_encoding)
        '(core_body_match $name [$c, ...])'.relocate_span([body])
    | 'let $(name :: Identifier) = $rhs ...
       $more; ...':
        let init = parse_function_expression('$rhs ...')
        let tail = function_body_encoding('$more; ...')
        '(core_body_let $name $init $tail)'.relocate_span([body])
    | ~else:
        let expr = parse_function_expression(body)
        '(core_body_expr $expr)'.relocate_span([body])

  fun function_encoding(form :: Syntax) :: Syntax:
    let [name, params, result_type, measure_stx, body] = elab.function_parts(form)
    let ps :~ List = params
    let [param, ...] = ps.map(fun (p :: Syntax): binder_encoding(p))
    let measure:
      match measure_stx
      | #false: Syntax.make(#false, id_ctx)
      | m: parse_function_expression(m :~ Syntax)
    let body_core:
      match elab.body_clauses(body :~ Syntax)
      | #false: function_body_encoding(body :~ Syntax)
      | rows:
          let [row, ...] = (rows :~ List).map(
                             fun (r :: Syntax): row_encoding(r, ps.length()))
          '(core_body_rows [$row, ...])'.relocate_span([body :~ Syntax])
    '(core_function $name [$param, ...] ($(result_type :~ Syntax)) $measure $body_core)'.relocate_span([form])
  fun option_symbol_stx(v) :: Syntax:
    match v
    | #false: Syntax.make(#false, id_ctx)
    | n: symbol_id(n :~ Symbol)

  fun option_int_stx(v) :: Syntax:
    match v
    | #false: Syntax.make(#false, id_ctx)
    | n: Syntax.make(n, id_ctx)

  fun tactic_encoding(tactic :: maybe(List.of(Syntax)), at :: Syntax) :: Syntax:
    let tactic_stx:
      match tactic
      | #false: #false
      | groups:
          let [g, ...] = groups :~ List
          '$g; ...'
    let [induct, using_names, skipped_stage_names, disabled_rule_names,
         case_stxs, witness_stxs, search_steps] = elab.parse_tactic(tactic_stx)
    let induct_stx = option_symbol_stx(induct)
    let [u, ...] = (using_names :~ List).map(fun (n): symbol_id(n :~ Symbol))
    let [d, ...] = (skipped_stage_names :~ List).map(
                     fun (n): symbol_id(n :~ Symbol))
    let [r, ...] = (disabled_rule_names :~ List).map(
                     fun (n): symbol_id(n :~ Symbol))
    let [c, ...] = (case_stxs :~ List).map(
                      fun (s): parse_core_encoding(s :~ Syntax))
    let [w, ...] = (witness_stxs :~ List).map(
                      fun (s): parse_core_encoding(s :~ Syntax))
    let steps_stx = option_int_stx(search_steps)
    '(core_tactic $induct_stx [$u, ...] [$d, ...] [$r, ...] [$c, ...] [$w, ...] $steps_stx)'.relocate_span([at])

  fun operator_notation_form(family :: Syntax, syntax_spec :: List,
                             order :: Syntax,
                             associativity :: Symbol) :: Syntax:
    let syntax_pattern :~ Syntax = syntax_spec[0]
    match associativity
    | #'left:
        'internal_overloaded_notation $syntax_pattern:
           ~family: $family
           ~order: $order
           ~associativity: ~left'
    | #'right:
        'internal_overloaded_notation $syntax_pattern:
           ~family: $family
           ~order: $order
           ~associativity: ~right'
    | #'none:
        'internal_overloaded_notation $syntax_pattern:
           ~family: $family
           ~order: $order
           ~associativity: ~none'
    | ~else:
        syntax_meta.error("invalid operator associativity", family)

  fun box_group(g :: Syntax) :: Syntax:
    '(hol_group: $g)'

  fun unbox_group(box :: Syntax) :: Syntax:
    match box
    | '(hol_group: $g; ...)': '$g; ...'
    | ~else: syntax_meta.error("internal malformed expansion group", box)

  fun render_step(step :: Syntax) :: List.of(Syntax):
    let step = step.replace_scopes(id_ctx)
    match step
    | '(~import $alias [$term, ...])':
        let [t, ...] = [term, ...]
        let path = '$t ...'
        ['import: $path!hol_theory as $alias']
    | '(~adopt $cur $nxt $alias [$at])':
        ['def $nxt = _hol_driver.adopt($cur, $(alias).theory, '$at')']
    | '(~type $cur $nxt [$form] [$at])':
        ['def $nxt = _hol_driver.add_type($cur, '$form', '$at')']
    | '(~function $cur $nxt [$core] [$at])':
        ['def $nxt:
           let spec = try:
                        _hol_surface.decode_function('$core')
                        ~catch e :: Exn.Fail:
                          _hol_driver.hol_reraise(e, '$at')
           _hol_driver.add_function($cur, spec, '$at')']
    | '(~axiomatic $cur $nxt [$core] [$at])':
        ['def $nxt:
           let spec = try:
                        _hol_surface.decode_function('$core')
                        ~catch e :: Exn.Fail:
                          _hol_driver.hol_reraise(e, '$at')
           _hol_driver.add_axiomatic_function($cur, spec, '$at')']
    | '(~theorem $cur $nxt [$name] [$core] [$tactic] [$at])':
        ['def $nxt:
           let statement = try:
                            _hol_surface.decode_prop('$core')
                            ~catch e :: Exn.Fail:
                              _hol_driver.hol_reraise(e, '$at')
           let proof = try:
                         _hol_surface.decode_tactic('$tactic')
                         ~catch e :: Exn.Fail:
                           _hol_driver.hol_reraise(e, '$at')
           _hol_driver.add_theorem($cur, Syntax.unwrap('$name'),
                                   statement, proof, '$at')']
    | '(~dispatch_family $cur $nxt [$name] [$arity] [$at])':
        ['def $nxt = _hol_driver.add_dispatch_family_decl(
                       $cur, Syntax.unwrap('$name'), $arity, '$at')']
    | '(~dispatch_method $cur $nxt [$family] [$signature] [$constant] [$order, ...] [$at])':
        ['def $nxt = _hol_driver.add_dispatch_method_encoded(
                       $cur, Syntax.unwrap('$family'), '$signature',
                       Syntax.unwrap('$constant'), [$order, ...], '$at')']
    | '(~rules $cur $nxt [$flag] [$name, ...])':
        ['def $nxt = _hol_driver.set_rules($cur, $flag, [Syntax.unwrap('$name'), ...])']
    | ~else: syntax_meta.error("internal malformed logical step", step)

  // -- diagnostics -----------------------------------------------------------

  // `raise-syntax-error` reports the location of the syntax object it is
  // given, and a *group* built by a template carries the template's location,
  // not the user's.  The head term still carries the user's.
  fun head_term(form :: Syntax) :: Syntax:
    match form
    | '$head $_ ...': head
    | ~else: form

  // -- one declaration -------------------------------------------------------

  // Two outputs, because they go to two places: the runtime forms stay in the
  // module, and the chain steps go into the `hol_theory` submodule.  Nothing
  // in the runtime half ever refers to the chain, which is what makes the
  // split possible.
  fun emit_one(d :: expand.Decl, n :: Int, runtime_state :: SurfaceContext)
       :: values(List.of(Syntax), List.of(Syntax), Int, SurfaceContext):
    let cur = st(n)
    let nxt = st(n + 1)
    match d.kind
    | #'other: values([d.form], [], n, runtime_state)
    | #'import:
        let [paths] = d.parts
        let at = head_term(d.form)
        let (chain, n2):
          for values(acc :~ List = [], k = n) (terms in (paths :~ List)):
            let alias = Syntax.make_id("_hol_used" ++ to_string(k), id_ctx)
            let [t, ...] = (terms :~ List).map(recontext)
            values(acc ++ ['(~import $alias [$t, ...])',
                           '(~adopt $(st(k)) $(st(k + 1)) $alias [$at])'],
                   k + 1)
        let next_runtime:
          for values(state :~ SurfaceContext = runtime_state) (terms in (paths :~ List)):
            defer_surface_import(state, terms :~ List.of(Syntax))
        values([d.form], chain, n2, next_runtime)
    | #'type:
        let [name, ctors, params, gen] = d.parts
        let at = head_term(d.form)
        let form = d.form
        values([emit_type(name, ctors :~ List),
                emit_generator(name, params :~ List, gen :~ List),
                emit_shrinker(name, gen :~ List)],
               ['(~type $cur $nxt [$form] [$at])'],
               n + 1,
               surface_add_type(runtime_state, form))
    | #'function:
        let [name, params, body] = d.parts
        let at = head_term(d.form)
        let form = d.form
        let core = function_encoding(form)
        let spec = decode_function(core)
        let registered_runtime = surface_add_function(runtime_state, form)
        let next_runtime = (if body_needs_runtime_lowering(registered_runtime, spec.body)
                            | force_surface_context(registered_runtime)
                            | registered_runtime)
        values([emit_function(spec, next_runtime, name,
                              params :~ List.of(Syntax), body :~ Syntax)],
               ['(~function $cur $nxt [$core] [$at])'],
               n + 1, next_runtime)
    | #'axiomatic_function:
        let [name, params, body] = d.parts
        let at = head_term(d.form)
        let form = d.form
        let core = function_encoding(form)
        let spec = decode_function(core)
        let registered_runtime = surface_add_function(runtime_state, form)
        let next_runtime = (if body_needs_runtime_lowering(registered_runtime, spec.body)
                            | force_surface_context(registered_runtime)
                            | registered_runtime)
        values([emit_function(spec, next_runtime, name,
                              params :~ List.of(Syntax), body :~ Syntax)],
               ['(~axiomatic $cur $nxt [$core] [$at])'],
               n + 1, next_runtime)
    | #'theorem:
        let [name, stmt, tactic] = d.parts
        let at = head_term(d.form)
        let gs :~ List = stmt
        let [g, ...] = gs
        let core = parse_core_encoding('$g; ...')
        let tactic_core = tactic_encoding(tactic, at)
        values([],
               ['(~theorem $cur $nxt [$name] [$core] [$tactic_core] [$at])'],
               n + 1, runtime_state)
    | #'dispatch_family:
        let [name, syntaxes, order, associativity,
             operand_names, _] = d.parts
        let notation_forms:
          for List (syntax_spec in (syntaxes :~ List)):
            operator_notation_form(
              name, syntax_spec :~ List, order :~ Syntax,
              associativity :~ Symbol)
        let at = head_term(d.form)
        let arity = (operand_names :~ List).length()
        let arity_stx = Syntax.make(arity, id_ctx)
        values(notation_forms,
               ['(~dispatch_family $cur $nxt [$name] [$arity_stx] [$at])'],
               n + 1,
               surface_add_family(
                 runtime_state, Syntax.unwrap(name), arity))
    | #'dispatch_method:
        let [family, argument_names, argument_types,
             result_type, constant, template_arguments] = d.parts
        let at = head_term(d.form)
        let names:
          for List (name in (argument_names :~ List)):
            match name
            | #false: #false
            | name_stx: Syntax.unwrap(name_stx :~ Syntax)
        let positions = dispatch_argument_order(
                          names, template_arguments, at)
        let next_runtime = surface_add_method(
                             runtime_state,
                             Syntax.unwrap(family),
                             argument_types :~ List.of(Syntax),
                             result_type :~ maybe(Syntax),
                             Syntax.unwrap(constant),
                             positions, at)
        let [argument_type, ...] = argument_types :~ List.of(Syntax)
        let result_stx = (if result_type
                          | result_type :~ Syntax
                          | Syntax.make(#false, id_ctx))
        let signature:
          '(dispatch_signature [$argument_type, ...] [$result_stx])'
        let [position, ...] = positions.map(
                              fun (value): Syntax.make(value, id_ctx))
        values([],
               ['(~dispatch_method $cur $nxt [$family] [$signature] [$constant] [$position, ...] [$at])'],
               n + 1, next_runtime)
    | #'disable_rules:
        let (forms, chain, n2) = rule_step(d, n, cur, nxt, #false)
        values(forms, chain, n2, runtime_state)
    | #'enable_rules:
        let (forms, chain, n2) = rule_step(d, n, cur, nxt, #true)
        values(forms, chain, n2, runtime_state)



// One declaration per expansion. Emitting the current declaration before the
// recursive macro call lets imports and operator definitions establish their
// bindings before the next HOL expression is enforested. Logical steps remain
// boxed syntax until the source tail is empty.
meta:
  fun continue_theorem(n :: Syntax, step_boxes :: List, name :: Syntax,
                       core :: Syntax, tactic :: maybe(List.of(Syntax)),
                       rest :: List.of(Syntax)) :: Syntax:
    let step_n = Syntax.unwrap(n)
    let cur = st(step_n)
    let nxt = st(step_n + 1)
    let tactic_core = tactic_encoding(tactic, name)
    let chain = '(~theorem $cur $nxt [$name] [$core] [$tactic_core] [$name])'
    let prior = step_boxes.map(unbox_group)
    let [sb, ...] = (prior ++ [chain]).map(box_group)
    let [f, ...] = rest
    let next_n = carry_state(
                   Syntax.make(step_n + 1, id_ctx), state_on(n))
    'hol_expand($next_n, [$sb, ...]):
       $f
       ...'

  fun continue_quickcheck(n :: Syntax, step_boxes :: List,
                          name :: Syntax, opts :: List.of(Syntax),
                          core :: Syntax, rest :: List.of(Syntax)) :: Syntax:
    let ready = force_surface_context(state_on(n))
    let runtime = emit_quickcheck(ready, name, opts, core, name)
    let [sb, ...] = step_boxes
    let [f, ...] = rest
    let next_n = carry_state(n, ready)
    '«
       $runtime
       hol_expand($next_n, [$sb, ...]):
         $f
         ...
     »'

decl.macro
| 'hol_expand($(n :: Int), [$step_box, ...]):
     quickcheck $(name :: Identifier)($option, ...):
       $(stmt :: hol_expr_meta.Parsed)
     $rest; ...':
    continue_quickcheck(
      n, [step_box, ...], name, [option, ...],
      hol_expr_meta.unpack(stmt), [rest, ...])
| 'hol_expand($(n :: Int), [$step_box, ...]):
     quickcheck $(name :: Identifier):
       $(stmt :: hol_expr_meta.Parsed)
     $rest; ...':
    continue_quickcheck(
      n, [step_box, ...], name, [],
      hol_expr_meta.unpack(stmt), [rest, ...])
| 'hol_expand($(n :: Int), [$step_box, ...]):
     theorem $(name :: Identifier):
       $(stmt :: hol_expr_meta.Parsed)
     proof:
       $tactic; ...
     $rest; ...':
    continue_theorem(n, [step_box, ...], name,
                     hol_expr_meta.unpack(stmt), [tactic, ...], [rest, ...])
| 'hol_expand($(n :: Int), [$step_box, ...]):
     theorem $(name :: Identifier):
       $(stmt :: hol_expr_meta.Parsed)
     $rest; ...':
    continue_theorem(n, [step_box, ...], name,
                     hol_expr_meta.unpack(stmt), #false, [rest, ...])
| 'hol_expand($(n :: Int), [$step_box, ...]): $form; ...':
    let steps = [step_box, ...].map(unbox_group)
    let forms = [form, ...]
    let (next, rest) = expand.plan_next(forms)
    match next
    | #false:
        let final = st(Syntax.unwrap(n))
        let rendered:
          for values(acc :~ List = []) (encoded in steps):
            acc ++ render_step(encoded)
        let [step, ...] = rendered
        let surface_state = emit_surface_state(state_on(n))
        '«
           $surface_state
           module hol_theory ~lang rhombus:
             import: rhombus/hol/frontend/driver as _hol_driver
             import: rhombus/hol/frontend/surface_core as _hol_surface
             export: theory
             def $(st(0)) = _hol_driver.initial_state()
             $step
             ...
             def theory = $final
         »'
    | d:
        let (runtime, chain, n2, next_runtime) = emit_one(
                                                   d :~ expand.Decl,
                                                   Syntax.unwrap(n),
                                                   state_on(n))
        let [r, ...] = runtime
        let [sb, ...] = (steps ++ chain).map(box_group)
        let [f, ...] = rest
        let next_n = carry_state(Syntax.make(n2, id_ctx), next_runtime)
        '«
           $r
           ...
           hol_expand($next_n, [$sb, ...]):
             $f
             ...
         »'

// Every `#lang rhombus/hol` module carries its importable frontend state in
// `hol_surface` and its final logical state in `hol_theory`. The trampoline
// emits both only after every source declaration has been expanded in order.
decl.macro 'module_block: $form; ...':
  '#%module_block:
     hol_expand(0, []):
       $form
       ...'
