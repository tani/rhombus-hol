#lang rhombus/and_meta

import:
  rhombus/meta open
  rhombus/hol/frontend/surface_space open
  rhombus/hol/frontend/surface_space!meta:
    expose:
      hol_expr_meta

export:
  hol_operator

meta:
  fun operator_error(message :: String, at :: Syntax):
    syntax_meta.error(message, at)

  // `[head, operands, operator, fixity]`. Like Rhombus `operator`, a
  // two-identifier case is prefix; postfix identifier operators are therefore
  // intentionally unavailable without an operator token to disambiguate them.
  fun operator_pattern(head :: Syntax) :: List:
    match head
    | '$(left :: Identifier) $(op :: Name) $(right :: Identifier)':
        [head, [left, right], op, #'infix]
    | '$(op :: Name) $(operand :: Identifier)':
        [head, [operand], op, #'prefix]
    | '$(operand :: Identifier) $(op :: Operator)':
        [head, [operand], op, #'postfix]
    | ~else:
        operator_error(
          "expected a prefix, infix, or postfix operator case with identifier operands",
          head)

  fun keyword_clause(clause :: Syntax) :: Boolean:
    match clause
    | '$(keyword :: Keyword) $_ ...; ...': #true
    | ~else: #false

  fun validate_operator_option(option :: Syntax):
    match option
    | '~associativity: ~left'
        || '~associativity: ~right'
        || '~associativity: ~none':
        #void
    | '~associativity: $_ ...':
        operator_error(
          "`~associativity` must be `~left`, `~right`, or `~none`",
          option)
    | ~else: #void

  fun implementation_target(clause :: Syntax) :: Syntax:
    match clause
    | '$(target :: Identifier)': target
    | ~else:
        operator_error("an operator implementation must be one function name",
                       clause)

  // `[pattern_info, options, target]`.
  fun parse_operator_case(head :: Syntax,
                          shared :: List.of(Syntax),
                          body :: List.of(Syntax)) :: List:
    when body.length() == 0
    | operator_error("an operator case needs a final function implementation", head)
    for (option in shared):
      unless keyword_clause(option)
      | operator_error(
          "a shared operator block can contain precedence options only",
          option)
      validate_operator_option(option)
    let options = body.take(body.length() - 1)
    when keyword_clause(body.last)
    | when for any (clause in options): !keyword_clause(clause)
      | operator_error("an operator implementation must be final", body.last)
      operator_error(
        "an operator case needs a final function implementation",
        head)
    let target = implementation_target(body.last)
    for (option in options):
      unless keyword_clause(option)
      | operator_error(
          "only precedence options may precede an operator implementation",
          option)
      validate_operator_option(option)
    [operator_pattern(head), shared ++ options, target]

  fun reflected_runtime_body(target :: Syntax,
                             operands :: List.of(Syntax)) :: Syntax:
    let name = Syntax.unwrap(target)
    cond
    | name == #'conj && operands.length() == 2:
        let left = operands[0]
        let right = operands[1]
        '$left && $right'
    | name == #'disj && operands.length() == 2:
        let left = operands[0]
        let right = operands[1]
        '$left || $right'
    | name == #'eq && operands.length() == 2:
        let left = operands[0]
        let right = operands[1]
        '$left == $right'
    | name == #'neg && operands.length() == 1:
        let operand = operands[0]
        '! $operand'
    | ~else:
        let [operand, ...] = operands
        '$target($operand, ...)'

  fun runtime_case(parsed :: List) :: Syntax:
    let pattern_info :~ List = parsed[0]
    let options :~ List.of(Syntax) = parsed[1]
    let target :~ Syntax = parsed[2]
    let head :~ Syntax = pattern_info[0]
    let operands :~ List.of(Syntax) = pattern_info[1]
    let body = reflected_runtime_body(target, operands)
    let [option, ...] = options
    '$head:
       $option
       ...
       $body'

  fun hol_case(parsed :: List) :: Syntax:
    let pattern_info :~ List = parsed[0]
    let options :~ List.of(Syntax) = parsed[1]
    let target :~ Syntax = parsed[2]
    let op :~ Syntax = pattern_info[2]
    let fixity :~ Symbol = pattern_info[3]
    let target_name = to_string(Syntax.unwrap(target))
    let [option, ...] = options
    match fixity
    | #'infix:
        '«
           '$('$')left $op $('$')right':
             $option
             ...
             ~all_stx: stx
             let function_ref = hol_expr_meta.make_ref(
                                  Syntax.make_id($target_name, left),
                                  Syntax.make_id("both", left),
                                  ~track: [left, right])
             hol_expr_meta.make_call(
               function_ref,
               [left, right],
               Syntax.make_id("both", left),
               ~track: [left, right])
         »'
    | #'prefix:
        '«
           '$op $('$')operand':
             $option
             ...
             ~all_stx: stx
             let function_ref = hol_expr_meta.make_ref(
                                  Syntax.make_id($target_name, operand),
                                  Syntax.make_id("both", operand),
                                  ~track: operand)
             hol_expr_meta.make_call(
               function_ref,
               [operand],
               Syntax.make_id("both", operand),
               ~track: operand)
         »'
    | #'postfix:
        '«
           '$('$')operand $op':
             $option
             ...
             ~all_stx: stx
             let function_ref = hol_expr_meta.make_ref(
                                  Syntax.make_id($target_name, operand),
                                  Syntax.make_id("both", operand),
                                  ~track: operand)
             hol_expr_meta.make_call(
               function_ref,
               [operand],
               Syntax.make_id("both", operand),
               ~track: operand)
         »'
    | ~else: operator_error("internal unknown operator fixity", op)

  fun grouped_runtime(cases :: List.of(Syntax)) :: Syntax:
    let [case, ...] = cases
    'operator
     | $case
     | ...'

  fun grouped_hol(cases :: List.of(Syntax)) :: Syntax:
    let [case, ...] = cases
    'hol_expr.macro
     | $case
     | ...'

  fun expand_operator(shared :: List.of(Syntax),
                      heads :: List.of(Syntax),
                      bodies :: List.of(List.of(Syntax)),
                      reflected :: Boolean,
                      declared_name :: maybe(Syntax) = #false) :: Syntax:
    let parsed:
      for List (head in heads, body in bodies):
        let one = parse_operator_case(head, shared, body)
        match declared_name
        | #false: one
        | name:
            let pattern_info :~ List = one[0]
            let op :~ Syntax = pattern_info[2]
            unless to_string(op) == to_string(name :~ Syntax)
            | operator_error(
                "every case in a named operator must use the declared operator name",
                head)
            one
    let hol_cases = parsed.map(fun (one): hol_case(one :~ List))
    let forms = (if reflected
                 | [grouped_runtime(
                      parsed.map(fun (one): runtime_case(one :~ List)))]
                 | [])
                  ++ [grouped_hol(hol_cases)]
    let [form, ...] = forms
    '«
       $form
       ...
     »'


defn.macro
| 'logic_operator $(name :: Name): $shared; ...
   | $(head :: Sequence): $body; ...
   | ...':
    expand_operator([shared, ...],
                    [head, ...],
                    [[body, ...], ...],
                    #false,
                    name)
| 'logic_operator
   | $(head :: Sequence): $body; ...
   | ...':
    expand_operator([], [head, ...], [[body, ...], ...], #false)
| 'logic_operator $(head :: Sequence): $body; ...':
    expand_operator([], [head], [[body, ...]], #false)
| 'logic_operator $rest ...':
    syntax_meta.error(
      "expected an operator-style `operator.logic` case or `|` cases",
      '$rest ...')


defn.macro
| 'reflect_operator $(name :: Name): $shared; ...
   | $(head :: Sequence): $body; ...
   | ...':
    expand_operator([shared, ...],
                    [head, ...],
                    [[body, ...], ...],
                    #true,
                    name)
| 'reflect_operator
   | $(head :: Sequence): $body; ...
   | ...':
    expand_operator([], [head, ...], [[body, ...], ...], #true)
| 'reflect_operator $(head :: Sequence): $body; ...':
    expand_operator([], [head], [[body, ...]], #true)
| 'reflect_operator $rest ...':
    syntax_meta.error(
      "expected an operator-style `operator.reflect` case or `|` cases",
      '$rest ...')


defn.macro
| 'hol_operator $(dot :: Operator) $(mode :: Identifier) $rest ...':
    cond
    | to_string(dot) == "." && Syntax.unwrap(mode) == #'logic:
        'logic_operator $rest ...'
    | to_string(dot) == "." && Syntax.unwrap(mode) == #'reflect:
        'reflect_operator $rest ...'
    | ~else:
        'operator $dot $mode $rest ...'
| 'hol_operator $rest ...':
    'operator $rest ...'
