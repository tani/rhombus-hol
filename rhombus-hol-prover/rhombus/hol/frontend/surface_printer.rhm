#lang rhombus/static

// Frontend rendering layered over the kernel's canonical printer. Operator
// tables are explicit inputs; the kernel never imports or stores them.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/printer as canonical
  "dispatch.rhm" open
  rhombus/hol/frontend/type/registry open
  rhombus/hol/frontend/type/print open

export:
  SurfaceOperator
  standard_surface_operators
  show_surface

class SurfaceOperator(function :: Symbol,
                      spelling :: String,
                      precedence :: Int,
                      associativity :: Symbol,
                      prefix :: Boolean)

fun standard_surface_operators() :: Map.of(Symbol, SurfaceOperator):
  let entries = [
    SurfaceOperator(#'add, "+", 80, #'left, #false),
    SurfaceOperator(#'subtract, "-", 80, #'left, #false),
    SurfaceOperator(#'negate, "-", 90, #'right, #true),
    SurfaceOperator(#'multiply, "*", 85, #'left, #false),
    SurfaceOperator(#'power, "**", 95, #'right, #false),
    SurfaceOperator(#'less, "<", 75, #'none, #false),
    SurfaceOperator(#'less_equal, "<=", 75, #'none, #false),
    SurfaceOperator(#'greater, ">", 75, #'none, #false),
    SurfaceOperator(#'greater_equal, ">=", 75, #'none, #false),
    SurfaceOperator(#'append, "++", 78, #'right, #false),
    SurfaceOperator(#'member, "in", 75, #'none, #false),
    SurfaceOperator(#'union, "union", 76, #'left, #false),
    SurfaceOperator(#'intersection, "intersect", 77, #'left, #false)
  ]
  for values(out :~ Map = {}) (entry in entries):
    let entry :~ SurfaceOperator = entry
    out ++ {entry.function: entry}

fun show_surface(
      registry :: DispatchRegistry,
      operators :: Map.of(Symbol, SurfaceOperator),
      term :: Term,
      ~type_constructors: type_constructors :: TypeConstructorRegistry = standard_type_constructor_registry())
     :: String:
  fun canonical_show(value :: Term) :: String:
    canonical.show_with_type(
      value,
      fun (type :: HType): type_to_surface_string(type_constructors, type))
  fun parenthesize(text :: String, have :: Int, want :: Int) :: String:
    if have < want | "(" ++ text ++ ")" | text
  fun surface_arguments(method :: DispatchMethod,
                        implementation_args :: List.of(Term)) :: List.of(Term):
    for List (surface_index in 0 .. method.argument_order.length()):
      recur locate (implementation_index = 0):
        cond
        | method.argument_order[implementation_index] == surface_index:
            implementation_args[implementation_index]
        | ~else: locate(implementation_index + 1)
  fun method_for(name :: Symbol, arity :: NonnegInt)
       :: maybe(DispatchMethod):
    for values(found :~ maybe(DispatchMethod) = #false) (method in registry.methods):
      let method :~ DispatchMethod = method
      (if !found
             && method.constant == name
             && method.argument_types.length() == arity
             && operators.get(method.function, #false)
       | method
       | found)
  fun render(value :: Term, want :: Int) :: String:
    let (head, args) = strip_comb(value)
    match head
    | Const(name, _):
        match method_for(name, args.length())
        | method :: DispatchMethod:
            let operator :~ SurfaceOperator = operators[method.function]
            let ordered = surface_arguments(method, args)
            cond
            | operator.prefix && ordered.length() == 1:
                parenthesize(
                  operator.spelling ++ render(ordered[0], operator.precedence),
                  operator.precedence, want)
            | !operator.prefix && ordered.length() == 2:
                let left_want = (if operator.associativity == #'left
                                 | operator.precedence
                                 | operator.precedence + 1)
                let right_want = (if operator.associativity == #'right
                                  | operator.precedence
                                  | operator.precedence + 1)
                parenthesize(
                  render(ordered[0], left_want) ++ " " ++ operator.spelling
                    ++ " " ++ render(ordered[1], right_want),
                  operator.precedence, want)
            | ~else: canonical_show(value)
        | #false: canonical_show(value)
    | ~else: canonical_show(value)
  render(term, 0)
