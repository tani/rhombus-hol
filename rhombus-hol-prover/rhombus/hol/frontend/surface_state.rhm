#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Importable frontend state. This remains separate from `HolState`: consumers
// that only elaborate surface syntax must not instantiate or execute proofs.

import:
  rhombus/hol/htype open
  rhombus/hol/frontend/dispatch open
  rhombus/hol/frontend/type/constructor open
  rhombus/hol/frontend/type/registry open

export:
  SurfaceState
  make_surface_state
  merge_surface_states

class SurfaceState(operators :: DispatchRegistry,
                   constants :: Map.of(Symbol, HType),
                   type_constructors :: TypeConstructorRegistry)

fun make_surface_state(functions :: List,
                       methods :: List.of(DispatchMethod),
                       constants :: List,
                       type_constructors :: List.of(TypeConstructor))
     :: SurfaceState:
  let arity_map:
    for values(out :~ Map = {}) (entry in functions):
      let [name :: Symbol, arity :: NonnegInt] = entry :~ List
      out ++ {name: arity}
  let constant_map:
    for values(out :~ Map = {}) (entry in constants):
      let [name :: Symbol, ty :: HType] = entry :~ List
      out ++ {name: ty}
  let type_registry:
    for values(out :~ TypeConstructorRegistry = empty_type_constructor_registry()) (
          constructor in type_constructors):
      add_type_constructor(out, constructor)
  SurfaceState(DispatchRegistry(arity_map, methods), constant_map,
               type_registry)

fun same_dispatch_method(left :: DispatchMethod,
                         right :: DispatchMethod) :: Boolean:
  left.function == right.function
    && left.argument_types == right.argument_types
    && left.result_type == right.result_type
    && left.constant == right.constant
    && left.argument_order == right.argument_order

fun contains_dispatch_method(registry :: DispatchRegistry,
                             method :: DispatchMethod) :: Boolean:
  for values(found = #false) (existing in registry.methods):
    found || same_dispatch_method(existing :~ DispatchMethod, method)

fun merge_surface_states(imported :: SurfaceState,
                         current :: SurfaceState)
     :: SurfaceState:
  let with_functions:
    for values(registry :~ DispatchRegistry = imported.operators) (
          (name, arity) in current.operators.arities):
      ensure_dispatch_function(registry, name, arity :~ NonnegInt)
  let with_methods:
    for values(registry :~ DispatchRegistry = with_functions) (
          method in current.operators.methods):
      (if contains_dispatch_method(registry, method :~ DispatchMethod)
       | registry
       | add_dispatch_method(registry, method :~ DispatchMethod))
  SurfaceState(
    with_methods,
    imported.constants ++ current.constants,
    merge_type_constructor_registries(imported.type_constructors,
                                      current.type_constructors))
