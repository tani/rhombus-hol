#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Importable frontend state. This remains separate from `HolState`: consumers
// that only elaborate surface syntax must not instantiate or execute proofs.

import:
  rhombus/hol/htype open
  rhombus/hol/frontend/dispatch open

export:
  SurfaceState
  make_surface_state
  merge_surface_states

class SurfaceState(operators :: DispatchRegistry,
                   constants :: Map.of(Symbol, HType))

fun make_surface_state(families :: List.of(DispatchFamily),
                       methods :: List.of(DispatchMethod),
                       constants :: List)
     :: SurfaceState:
  let family_map:
    for values(out :~ Map = {}) (family in families):
      let family :~ DispatchFamily = family
      out ++ {family.name: family}
  let constant_map:
    for values(out :~ Map = {}) (entry in constants):
      let [name :: Symbol, ty :: HType] = entry :~ List
      out ++ {name: ty}
  SurfaceState(DispatchRegistry(family_map, methods), constant_map)

fun merge_surface_states(imported :: SurfaceState,
                         current :: SurfaceState)
     :: SurfaceState:
  let with_families:
    for values(registry :~ DispatchRegistry = imported.operators) (
          (_, family) in current.operators.families):
      add_dispatch_family(registry, family :~ DispatchFamily)
  let with_methods:
    for values(registry :~ DispatchRegistry = with_families) (
          method in current.operators.methods):
      add_dispatch_method(registry, method :~ DispatchMethod)
  SurfaceState(with_methods, imported.constants ++ current.constants)
