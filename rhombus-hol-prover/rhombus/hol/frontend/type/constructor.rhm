#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Frontend identity for a HOL type constructor. The surface binding may differ
// from the kernel name (`List.of` elaborates to `TyApp(#'List, ...)`).

import:
  rhombus/hol/htype open

export:
  TypeConstructor
  make_type_constructor
  apply_type_constructor

class TypeConstructor(surface_name :: Symbol,
                      kernel_name :: Symbol,
                      arity :: NonnegInt)

fun make_type_constructor(kernel_name :: Symbol,
                          arity :: NonnegInt)
     :: TypeConstructor:
  let surface_name = (if arity == 0
                      | kernel_name
                      | Symbol.from_string(to_string(kernel_name) ++ ".of"))
  TypeConstructor(surface_name, kernel_name, arity)

fun apply_type_constructor(constructor :: TypeConstructor,
                           arguments :: List.of(HType),
                           at :: Syntax) :: HType:
  let arity = constructor.arity
  unless arguments.length() == arity
  | error(~who: #'type,
          "type constructor `" ++ to_string(constructor.surface_name)
            ++ "` expects " ++ to_string(arity)
            ++ (if arity == 1 | " argument" | " arguments")
            ++ ", but received " ++ to_string(arguments.length()),
          error.val(~label: "in", to_string(at)))
  mk_tyapp(constructor.kernel_name, arguments)
