#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Surface type names are frontend metadata, not kernel Theory entries.

import:
  rhombus/hol/frontend/type/constructor open

export:
  TypeConstructorRegistry
  empty_type_constructor_registry
  standard_type_constructor_registry
  add_type_constructor
  add_declared_type_constructor
  lookup_type_constructor
  lookup_type_constructor_namespace
  type_constructor_for_kernel
  merge_type_constructor_registries

class TypeConstructorRegistry(bindings :: Map.of(Symbol, TypeConstructor),
                              namespaces :: Map.of(Symbol, TypeConstructor),
                              kernel_names :: Map.of(Symbol, TypeConstructor))

fun empty_type_constructor_registry() :: TypeConstructorRegistry:
  TypeConstructorRegistry({}, {}, {})

fun same_constructor(left :: TypeConstructor,
                     right :: TypeConstructor) :: Boolean:
  left.surface_name == right.surface_name
    && left.kernel_name == right.kernel_name
    && left.parameter_names == right.parameter_names

fun add_type_constructor(registry :: TypeConstructorRegistry,
                         constructor :: TypeConstructor)
     :: TypeConstructorRegistry:
  match registry.bindings.get(constructor.surface_name, #false)
  | prior :: TypeConstructor:
      unless same_constructor(prior, constructor)
      | error(~who: #'type,
              "duplicate type constructor binding `"
                ++ to_string(constructor.surface_name) ++ "`")
      registry
  | #false:
      match registry.kernel_names.get(constructor.kernel_name, #false)
      | prior :: TypeConstructor:
          unless same_constructor(prior, constructor)
          | error(~who: #'type,
                  "kernel type constructor `"
                    ++ to_string(constructor.kernel_name)
                    ++ "` already has a surface binding")
          registry
      | #false:
          let namespaces = (if constructor.parameter_names.length() == 0
                            | registry.namespaces
                            | registry.namespaces
                                ++ {constructor.kernel_name: constructor})
          TypeConstructorRegistry(
            registry.bindings ++ {constructor.surface_name: constructor},
            namespaces,
            registry.kernel_names ++ {constructor.kernel_name: constructor})

fun add_declared_type_constructor(registry :: TypeConstructorRegistry,
                                  kernel_name :: Symbol,
                                  parameter_names :: List.of(Symbol))
     :: TypeConstructorRegistry:
  add_type_constructor(
    registry, make_type_constructor(kernel_name, parameter_names))

fun lookup_type_constructor(registry :: TypeConstructorRegistry,
                            surface_name :: Symbol)
     :: maybe(TypeConstructor):
  registry.bindings.get(surface_name, #false)

fun lookup_type_constructor_namespace(registry :: TypeConstructorRegistry,
                                      base_name :: Symbol)
     :: maybe(TypeConstructor):
  registry.namespaces.get(base_name, #false)

fun type_constructor_for_kernel(registry :: TypeConstructorRegistry,
                                kernel_name :: Symbol)
     :: maybe(TypeConstructor):
  registry.kernel_names.get(kernel_name, #false)

fun merge_type_constructor_registries(
      imported :: TypeConstructorRegistry,
      current :: TypeConstructorRegistry)
     :: TypeConstructorRegistry:
  for values(out :~ TypeConstructorRegistry = imported) (
        (_, constructor) in current.bindings):
    add_type_constructor(out, constructor :~ TypeConstructor)

def standard_type_constructor_registry_value:
  add_type_constructor(
    add_type_constructor(
      empty_type_constructor_registry(),
      TypeConstructor(#'Boolean, #'bool, [])),
    TypeConstructor(Symbol.from_string("Pair.of"), #'prod, [#'a, #'b]))

fun standard_type_constructor_registry() :: TypeConstructorRegistry:
  standard_type_constructor_registry_value
