#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// ACL2's waterfall is a design reference; see THIRD_PARTY_NOTICES.


// Goals, proof steps, and the tree they build.
//
// A goal is a sequent: assumptions and a conclusion.  The specification's
// pipeline is described in terms of ACL2 clauses, and clauses are the right
// shape once case splitting on `if` matters; sequents are the same thing with
// less bookkeeping, and every stage this version has -- simplification,
// destructor elimination, generalization, induction -- is naturally a
// sequent-to-sequents step.  A clause layer can be added later without
// disturbing the driver, because the driver only ever sees `Step`.
//
// A `Step` carries its own justification: a function from proofs of the
// subgoals to a proof of the parent.  **That is the whole anti-bypass
// argument.** The only way a `Thm` comes out of the prover is by composing
// `justify` functions, each written in terms of derived rules, each of which
// bottoms out in the kernel's ten primitives.  There is no other exit.
//
// The tree is built first and run second.  A failed proof then pays no kernel
// cost for the branches that did succeed -- it just walks the tree collecting
// the open goals for the error message.

import:
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  "proof/node.rhm" open
  "proof/run.rhm" open

export:
  Goal
  Step
  ProofNode
  Proved
  Derived
  Open
  mk_goal
  note
  run
  residues
  is_closed
  show_goal


fun mk_goal(asms :: List.of(Term), concl :: Term) :: Goal:
  Goal(asms, concl, [])

fun note(g :: Goal, line :~ String) :: Goal:
  Goal(g.asms, g.concl, g.trail ++ [line])

// Compatibility entry points. Proof execution itself lives in
// `proof/run.rhm`; callers importing `goal.rhm` retain their API.
fun run(node :: ProofNode) :: maybe(Thm):
  execute(node)

fun is_closed(node :: ProofNode) :: Boolean:
  closed(node)

fun residues(node :: ProofNode) :: List.of(Goal):
  collect_residues(node)

fun show_goal(g :: Goal) :~ String:
  let steps = g.trail.map(fun (l :~ String): "    " ++ l)
  let head:
    cond
    | steps.length() == 0: ""
    | ~else: "  after\n" ++ String.join(steps, "\n") ++ "\n"
  let asm_lines = g.asms.map(fun (a): "    assuming " ++ show(a))
  let asms:
    cond
    | asm_lines.length() == 0: ""
    | ~else: String.join(asm_lines, "\n") ++ "\n"
  head ++ asms ++ "    " ++ show(g.concl)
