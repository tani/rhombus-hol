//
// HOL Light parser.ml compatibility surface.
//
// Rhombus-HOL uses the host reader/enforestation system instead of a private
// token stream.  The equivalent parser boundary is therefore Syntax -> Core,
// followed by type parsing through the registry-based checker.

import:
  rhombus/hol/frontend/parser/core open
  rhombus/hol/frontend/parser/expand open
  rhombus/hol/frontend/parser/declaration open
  rhombus/hol/frontend/checker/type/parse open
  rhombus/hol/frontend/checker/type/registry open

export:
  all_from(rhombus/hol/frontend/parser/core)
  all_from(rhombus/hol/frontend/parser/expand)
  all_from(rhombus/hol/frontend/parser/declaration)
  parse_type
  parse_open_type
  collect_type_vars
  parse_preterm
  parse_term
  parse_prop

// The input here is the canonical core encoding emitted by hol_expr
// enforestation. This keeps parsing theory-independent exactly as the current
// frontend requires.
fun parse_preterm(encoded :: Syntax) :: CoreExpr:
  decode_expr(encoded, #'function)

fun parse_term(encoded :: Syntax) :: CoreExpr:
  decode_expr(encoded, #'definition)

fun parse_prop(encoded :: Syntax) :: CoreExpr:
  decode_prop(encoded)
