//
// HOL Light preterm.ml compatibility surface.
//
// HOL Light combines unresolved syntax, overloading and type inference in one
// preterm module. Rhombus-HOL splits those responsibilities into CoreExpr,
// checker/checked, and backend/proof/elaborate. This file reunifies that public
// pipeline without duplicating any inference logic.

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/frontend/parser/core open
  rhombus/hol/frontend/checker/checked open
  rhombus/hol/frontend/checker/overload open
  rhombus/hol/frontend/checker/type/registry open
  rhombus/hol/backend/proof/elaborate open

export:
  all_from(rhombus/hol/frontend/parser/core)
  all_from(rhombus/hol/frontend/checker/checked)
  all_from(rhombus/hol/frontend/checker/overload)
  typify
  term_of_preterm
  type_of_preterm

// Type inference and overload resolution. The caller supplies the same CheckEnv
// used by declarations, so namespace and interface decisions are identical to
// source-level elaboration.
fun typify(env :: CheckEnv, pt :: CoreExpr,
           expected :: maybe(HType) = #false) :: CheckedExpr:
  let checked = check_expr(env, pt, expected)
  resolve_checked(env.inference, checked)

// Elaborate an already-typed preterm to a kernel term.
fun term_of_preterm(check_env :: CheckEnv,
                    elab_env :: ElabEnv,
                    pt :: CoreExpr,
                    expected :: maybe(HType) = #false) :: Term:
  checked_to_term(elab_env, typify(check_env, pt, expected))

fun type_of_preterm(check_env :: CheckEnv,
                    elab_env :: ElabEnv,
                    pt :: CoreExpr,
                    expected :: maybe(HType) = #false) :: HType:
  type_of(term_of_preterm(check_env, elab_env, pt, expected))
