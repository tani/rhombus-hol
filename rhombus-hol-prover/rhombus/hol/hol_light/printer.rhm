import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel:
    only:
      Thm
      hyps_of
      concl_of
  rhombus/hol/printer open

export:
  all_from(rhombus/hol/printer)
  string_of_type
  string_of_term
  string_of_thm
  show_thm

fun string_of_type(ty :: HType) :: String:
  type_to_string(ty)

fun string_of_term(t :: Term) :: String:
  show(t)

fun show_thm(th :: Thm) :: String:
  show_hyps(hyps_of(th)) ++ show(concl_of(th))

fun string_of_thm(th :: Thm) :: String:
  show_thm(th)
