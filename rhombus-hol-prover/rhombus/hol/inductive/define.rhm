#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Inductive predicates: the least predicates closed under a set of rules.
//
// HOL needs no new definition principle for this. A rule set whose recursive
// occurrences are all positive describes a monotone operator, and the least
// predicates closed under it can be written down directly with higher-order
// quantification -- the intersection of every predicate family the rules are
// closed under:
//
//   p_j := \x. !P_1 ... P_m. R_1[P] ==> ... ==> R_k[P] ==> P_j x
//
// where `R_i[P]` is rule `i` with the predicates being defined replaced by the
// quantified `P_1, ..., P_m`. Each `p_j` is one `new_basic_definition`, so the
// trust model is unchanged; `recursion/wfrec.rhm` writes the same encoding
// down for the one relation well-founded recursion needs.
//
// Mutual recursion needs nothing beyond that shape: all of the rules are
// premises of every definition, and the family is quantified over as a whole,
// so the `m = 1` case is the general one with a one-element family.
//
// From those definitions three families of theorems are derived here, each by
// ordinary kernel rules:
//
//   introduction  `R_i[p]` -- the predicates are closed under every rule
//   induction     `!P. R_1[P] ==> ... ==> R_k[P] ==> !x. p_j x ==> P_j x`,
//                 one per predicate -- which is immediate: it *is* the
//                 definition
//   cases         `!x. p_j x ==> (D_1 or ... or D_r)`, one per predicate,
//                 where `D_i` says some instance of a rule concluding with
//                 `p_j` concluded with `x`
//
// Induction is the easy direction and introduction is the interesting one:
// closure of `p` needs each rule's premises transported from the `p`s to the
// `P`s, which is where positivity is paid for. `monotone_instance` performs
// that transport, structurally, and it is also what makes the inversion
// theorems derivable rather than postulated.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/logic/conv open
  rhombus/hol/logic/drule open

export:
  InductiveThms
  define_inductive

// `introductions` has one theorem per rule, in rule order; `inductions` and
// `cases` have one per predicate, in declaration order.
class InductiveThms(definitions :: List.of(Thm),
                    introductions :: List.of(Thm),
                    inductions :: List.of(Thm),
                    cases :: List.of(Thm))

fun fail(message :: String, what :: Term):
  error(~who: #'inductive, message, error.val(~label: "in", show(what)))

// -- the predicate family -----------------------------------------------------

// The variables the rules were elaborated with, and the constants they turn
// into. One position per declared predicate, in declaration order.
class Family(vars :: List.of(FVar),
             constants :: List.of(Term),
             arities :: List.of(NonnegInt),
             // The position of each declared predicate variable, keyed by
             // that variable itself, for O(1) lookup by `family_index`.
             index :: Map.of(Term, NonnegInt))

fun mk_family(names :: List.of(Symbol),
              vars :: List.of(FVar)) :: Family:
  Family(vars,
         for List (name in names, v in vars):
           mk_const(name, (v :~ FVar).ty),
         vars.map(fun (v :: FVar): argument_types(v).length()),
         for values(m :~ Map = {}) (v in vars, i in List.iota(vars.length())):
           m ++ {v :~ Term: i})

fun argument_types(pred :: FVar) :: List.of(HType):
  recur loop (ty :: HType = pred.ty, acc :~ List.of(HType) = []):
    cond
    | is_fun(ty):
        let (domain, result) = dest_fun(ty)
        loop(result, acc ++ [domain])
    | ~else: acc

fun family_terms(family :: Family) :: List.of(Term):
  family.vars.map(fun (v :: FVar): v :~ Term)

// The position of `head` in the family, or `#false`.
fun family_index(family :: Family, head :: Term) :: maybe(NonnegInt):
  family.index.get(head, #false)

fun mentions_family(family :: Family, t :: Term) :: Boolean:
  for any (v in family.vars): vfree_in(v :~ Term, t)

// Every predicate variable replaced by its constant.
fun instantiate(family :: Family, t :: Term) :: Term:
  inst_fvar(
    for values(out :~ Map = {}) (v in family.vars, c in family.constants):
      out ++ {v :~ FVar: c :~ Term},
    t)

// -- positivity ---------------------------------------------------------------

// Every recursive occurrence must be an application of one of the predicates
// to arguments that do not mention any of them, and must sit in a position the
// rule operator is monotone in. `not p x`, `p x ==> q`, and `f p` each break
// monotonicity, so the fixed point the definitions denote need not be closed
// under the rules at all; the encoding would still be a definition, and the
// introduction theorems would simply not be derivable. Refusing here is what
// keeps a declaration from being accepted without its rules.
fun check_inductive_rules(family :: Family,
                          rules :: List.of(Term)) :: Void:
  for (rule in rules):
    let (_, _, premises, args) = rule_parts(family, rule, [])
    for (premise in premises):
      check_monotone(family, premise, #true)
    for (argument in args):
      check_absent(family, argument, rule)

fun check_absent(family :: Family, t :: Term, rule :: Term) :: Void:
  when mentions_family(family, t)
  | fail("an inductive rule cannot mention a declared predicate in its own "
           ++ "arguments", rule)

// `positive` is monotonicity, not truth polarity: it says the operator grows
// with the predicates at this position.
fun check_monotone(family :: Family, t :: Term,
                   positive :: Boolean) :: Void:
  cond
  | !mentions_family(family, t): #void
  | ~else:
      match dest_conj(t)
      | [a, b]:
          check_monotone(family, a, positive)
          check_monotone(family, b, positive)
      | ~else:
          match dest_disj(t)
          | [a, b]:
              check_monotone(family, a, positive)
              check_monotone(family, b, positive)
          | ~else:
              match dest_imp(t)
              | [a, b]:
                  check_monotone(family, a, !positive)
                  check_monotone(family, b, positive)
              | ~else:
                  match dest_neg(t)
                  | #false: check_monotone_binder(family, t, positive)
                  | a: check_monotone(family, a :~ Term, !positive)

fun check_monotone_binder(family :: Family, t :: Term,
                          positive :: Boolean) :: Void:
  match binder_body(family, t)
  | #false: check_monotone_atom(family, t, positive)
  | opened: check_monotone(family, opened :~ Term, positive)

// A quantifier's body, opened at a variable fresh for the family.
fun binder_body(family :: Family, t :: Term) :: maybe(Term):
  let avoid = family_terms(family) ++ [t]
  match dest_forall(t)
  | [v, body]: subst_bvar(variant(avoid, v :~ FVar), body :~ Term)
  | ~else:
      match dest_exists(t)
      | [v, body]: subst_bvar(variant(avoid, v :~ FVar), body :~ Term)
      | ~else: #false

fun check_monotone_atom(family :: Family, t :: Term,
                        positive :: Boolean) :: Void:
  let (head, args) = strip_comb(t)
  match family_index(family, head)
  | #false:
      fail("an inductive rule can only use a declared predicate applied to "
             ++ "arguments", t)
  | index:
      cond
      | !positive:
          fail("an inductive rule cannot use a declared predicate in a "
                 ++ "negative position", t)
      | args.length() != family.arities[index :~ NonnegInt]:
          fail("an inductive rule applies a declared predicate to the wrong "
                 ++ "number of arguments", t)
      | ~else:
          for (argument in args):
            check_absent(family, argument, t)

// -- rule structure -----------------------------------------------------------

// The predicate a rule concludes with, its opened binders, its premises, and
// its conclusion's arguments, for `!y. Q_1 ==> ... ==> p_j a`. The binders are
// opened at variables fresh for `avoid`.
fun rule_parts(family :: Family, rule :: Term, avoid :: List.of(Term))
    :: values(NonnegInt, List.of(FVar), List.of(Term), List.of(Term)):
  let (binders, matrix) = open_foralls(rule, avoid ++ family_terms(family))
  let (premises, conclusion) = strip_imp(matrix)
  let (head, args) = strip_comb(conclusion)
  match family_index(family, head)
  | #false:
      fail("an inductive rule must conclude with a declared predicate "
             ++ "applied to its arguments", conclusion)
  | index:
      unless args.length() == family.arities[index :~ NonnegInt]
      | fail("an inductive rule concludes with the wrong number of "
               ++ "arguments", conclusion)
      values(index, binders, premises, args)


fun mk_conj_list(ts :: List.of(Term)) :: Term:
  match ts
  | []: tm_true
  | [t]: t
  | List.cons(t, rest): mk_conj(t :~ Term, mk_conj_list(rest))

// A predicate with no rules holds of nothing, so the disjunction of the ways
// something could have got into it is empty -- that is `false`, and the
// inversion theorem then says exactly that.
fun mk_disj_list(ts :: List.of(Term)) :: Term:
  match ts
  | []: tm_false
  | [t]: t
  | List.cons(t, rest): mk_disj(t :~ Term, mk_disj_list(rest))

// -- monotonicity -------------------------------------------------------------

// `|- body[p := f] ==> body[p := g]`, given `atom(j, args)` proving
// `|- f_j args ==> g_j args` for each recursive occurrence.
//
// The two sides are not built and then justified: each case composes the
// theorems its subterms returned, so the statement that comes out is whatever
// those pieces actually prove. That is what lets the caller substitute a
// lambda for a predicate -- the instantiated premises it has to discharge are
// beta-reduced, and so are the ones this returns.
fun monotone_instance(thy :: Theory, family :: Family, body :: Term,
                      atom :: Function) :: Thm:
  cond
  | !mentions_family(family, body): DISCH(thy, body, ASSUME(thy, body))
  | ~else:
      match dest_conj(body)
      | [a, b]: monotone_conj(thy, family, a :~ Term, b :~ Term, atom)
      | ~else:
          match dest_disj(body)
          | [a, b]: monotone_disj(thy, family, a :~ Term, b :~ Term, atom)
          | ~else:
              match dest_imp(body)
              | [a, b]: monotone_imp(thy, family, a :~ Term, b :~ Term, atom)
              | ~else: monotone_binder(thy, family, body, atom)

fun antecedent_of(th :: Thm) :: Term:
  match dest_imp(concl_of(th))
  | [a, _]: a
  | ~else: error(~who: #'inductive, "internal non-implication")

fun consequent_of(th :: Thm) :: Term:
  match dest_imp(concl_of(th))
  | [_, b]: b
  | ~else: error(~who: #'inductive, "internal non-implication")

fun monotone_conj(thy :: Theory, family :: Family, a :: Term, b :: Term,
                  atom :: Function) :: Thm:
  let left = monotone_instance(thy, family, a, atom)
  let right = monotone_instance(thy, family, b, atom)
  let source = mk_conj(antecedent_of(left), antecedent_of(right))
  let h = ASSUME(thy, source)
  DISCH(thy, source,
        CONJ(thy,
             MP(thy, left, CONJUNCT1(thy, h)),
             MP(thy, right, CONJUNCT2(thy, h))))

fun monotone_disj(thy :: Theory, family :: Family, a :: Term, b :: Term,
                  atom :: Function) :: Thm:
  let left = monotone_instance(thy, family, a, atom)
  let right = monotone_instance(thy, family, b, atom)
  let source = mk_disj(antecedent_of(left), antecedent_of(right))
  let from_left = DISJ1(thy, MP(thy, left, ASSUME(thy, antecedent_of(left))),
                        consequent_of(right))
  let from_right = DISJ2(thy, consequent_of(left),
                         MP(thy, right, ASSUME(thy, antecedent_of(right))))
  DISCH(thy, source,
        DISJ_CASES(thy, ASSUME(thy, source), from_left, from_right))

// No predicate can occur in the antecedent -- `check_monotone` refused that --
// so only the consequent moves.
fun monotone_imp(thy :: Theory, family :: Family, a :: Term, b :: Term,
                 atom :: Function) :: Thm:
  when mentions_family(family, a)
  | fail("an inductive rule cannot use a declared predicate in a negative "
           ++ "position", a)
  let inner = monotone_instance(thy, family, b, atom)
  let source = mk_imp(a, antecedent_of(inner))
  DISCH(thy, source,
        DISCH(thy, a,
              MP(thy, inner, MP(thy, ASSUME(thy, source), ASSUME(thy, a)))))

fun monotone_binder(thy :: Theory, family :: Family, body :: Term,
                    atom :: Function) :: Thm:
  match dest_forall(body)
  | [v, inner]:
      monotone_forall(thy, family, v :~ FVar, inner :~ Term, body, atom)
  | ~else:
      match dest_exists(body)
      | [v, inner]:
          monotone_exists(thy, family, v :~ FVar, inner :~ Term, body, atom)
      | ~else: monotone_atom(thy, family, body, atom)

fun monotone_forall(thy :: Theory, family :: Family, v :: FVar, inner :: Term,
                    body :: Term, atom :: Function) :: Thm:
  let fresh = variant(family_terms(family) ++ [body], v)
  let step = monotone_instance(thy, family, subst_bvar(fresh :~ Term, inner),
                               atom)
  let source = mk_forall(fresh, antecedent_of(step))
  DISCH(thy, source,
        GEN(thy, fresh, MP(thy, step, SPEC(thy, fresh, ASSUME(thy, source)))))

fun monotone_exists(thy :: Theory, family :: Family, v :: FVar, inner :: Term,
                    body :: Term, atom :: Function) :: Thm:
  let fresh = variant(family_terms(family) ++ [body], v)
  let step = monotone_instance(thy, family, subst_bvar(fresh :~ Term, inner),
                               atom)
  let source = mk_exists(fresh, antecedent_of(step))
  let target = mk_exists(fresh, consequent_of(step))
  let witnessed = EXISTS(thy, target, fresh :~ Term,
                         MP(thy, step, ASSUME(thy, antecedent_of(step))))
  DISCH(thy, source, CHOOSE(thy, fresh, ASSUME(thy, source), witnessed))

fun monotone_atom(thy :: Theory, family :: Family, body :: Term,
                  atom :: Function) :: Thm:
  let (head, args) = strip_comb(body)
  match family_index(family, head)
  | #false:
      fail("an inductive rule can only use a declared predicate applied to "
             ++ "arguments", body)
  | index: atom(index, args)

// -- the definitions ----------------------------------------------------------

// `vars` are the variables the rules were elaborated with, one per declared
// predicate: their types fix the predicates' arities, and `rules` are the rule
// statements about them.
fun define_inductive(thy :: Theory, names :: List.of(Symbol),
                     vars :: List.of(FVar),
                     rules :: List.of(Term)) :: values(Theory, InductiveThms):
  when names.length() == 0
  | error(~who: #'inductive, "an inductive declaration needs a predicate")
  let family = mk_family(names, vars)
  check_inductive_rules(family, rules)
  let arguments:
    for List (v in vars):
      argument_vars(argument_types(v :~ FVar),
                    family_terms(family) ++ rules)
  let (thy2, definitions):
    for values(current :~ Theory = thy, acc :~ List.of(Thm) = []) (
          name in names, v in vars, xs in arguments):
      let body = definition_body(family, rules, v :~ FVar, xs :~ List)
      let (next, definition):
        new_basic_definition(current,
                             mk_eq(mk_var(name :~ Symbol, (v :~ FVar).ty),
                                   body))
      values(next, acc ++ [definition])
  let inductions:
    for List (definition in definitions, xs in arguments,
              index in List.iota(names.length())):
      derive_induction(thy2, definition :~ Thm, family, rules, xs :~ List,
                       index)
  let introductions:
    for List (rule in rules):
      derive_introduction(thy2, definitions, family, rules, inductions,
                          rule :~ Term)
  let cases:
    for List (index in List.iota(names.length())):
      derive_cases(thy2, family, rules, inductions, introductions, arguments,
                   index)
  values(thy2,
         InductiveThms(definitions, introductions, inductions, cases))

// `\x. !P. R_1[P] ==> ... ==> R_k[P] ==> P_j x`
fun definition_body(family :: Family, rules :: List.of(Term), v :: FVar,
                    xs :: List.of(FVar)) :: Term:
  let args = xs.map(fun (x :: FVar): x :~ Term)
  list_mk_abs(
    xs,
    mk_forall_list(family.vars,
                   implication_chain(rules, list_mk_comb(v :~ Term, args))))

fun argument_vars(arg_tys :: List.of(HType),
                  avoid :: List.of(Term)) :: List.of(FVar):
  recur loop (remaining :~ List.of(HType) = arg_tys, i = 0,
              avoid :~ List.of(Term) = avoid, acc :~ List.of(FVar) = []):
    match remaining
    | []: acc
    | List.cons(ty, rest):
        let fresh = variant(avoid,
                            mk_var(Symbol.from_string("x" ++ to_string(i)),
                                   ty :~ HType))
        loop(rest, i + 1, avoid ++ [fresh :~ Term], acc ++ [fresh])

fun implication_chain(antecedents :: List.of(Term),
                      conclusion :: Term) :: Term:
  for values(acc :~ Term = conclusion) (a in antecedents.reverse()):
    mk_imp(a :~ Term, acc)

fun discharge_all(thy :: Theory, antecedents :: List.of(Term),
                  th :: Thm) :: Thm:
  for values(acc :~ Thm = th) (a in antecedents.reverse()):
    DISCH(thy, a :~ Term, acc)

fun require_statement(th :: Thm, expected :: Term, what :: String) :: Thm:
  unless concl_of(th) == expected
  | error(~who: #'inductive,
          "internal derivation proved something else",
          error.val(~label: "step", what),
          error.val(~label: "asked", show(expected)),
          error.val(~label: "got", show(concl_of(th))))
  th

// -- induction ----------------------------------------------------------------

// `|- !P. R_1[P] ==> ... ==> R_k[P] ==> !x. p_j x ==> P_j x`
//
// The definition read back: `p_j x` *is* the statement that every rule-closed
// family holds of `x` at position `j`.
fun derive_induction(thy :: Theory, definition :: Thm, family :: Family,
                     rules :: List.of(Term), xs :: List.of(FVar),
                     index :: NonnegInt) :: Thm:
  let args = xs.map(fun (x :: FVar): x :~ Term)
  let membership = list_mk_comb(family.constants[index], args)
  let unfolded = EQ_MP(unfold_def(thy, definition, args),
                       ASSUME(thy, membership))
  let applied:
    for values(acc :~ Thm = SPECL(thy, family_terms(family), unfolded)) (
          rule in rules):
      MP(thy, acc, ASSUME(thy, rule :~ Term))
  GENL(thy, family.vars,
       discharge_all(thy, rules,
                     GENL(thy, xs, DISCH(thy, membership, applied))))

// -- introduction -------------------------------------------------------------

// `|- R_i[p]`: the predicates are closed under rule `i`.
//
// Unfolded, the goal says that every rule-closed family holds of the rule's
// conclusion. Rule `i` itself supplies that, once its premises have been
// transported from the `p`s to that family -- and induction, at this very
// family, is the pointwise implication the transport runs on.
fun derive_introduction(thy :: Theory, definitions :: List.of(Thm),
                        family :: Family, rules :: List.of(Term),
                        inductions :: List.of(Thm), rule :: Term) :: Thm:
  let (index, ys, premises, args) = rule_parts(family, rule,
                                               family.constants)
  let instantiated = premises.map(fun (p :: Term): instantiate(family, p))
  let conclusion_args = args.map(fun (a :: Term): instantiate(family, a))
  let pointwise:
    for List (induction in inductions):
      for values(acc :~ Thm = SPECL(thy, family_terms(family),
                                    induction :~ Thm)) (
            r in rules):
        MP(thy, acc, ASSUME(thy, r :~ Term))
  fun atom(position :: NonnegInt, arguments :: List.of(Term)) :: Thm:
    SPECL(thy, arguments, pointwise[position] :~ Thm)
  let transported:
    for List (source in premises, given in instantiated):
      MP(thy, monotone_instance(thy, family, source :~ Term, atom),
         ASSUME(thy, given :~ Term))
  let derived:
    for values(acc :~ Thm = SPECL(thy, ys.map(fun (y :: FVar): y :~ Term),
                                  ASSUME(thy, rule))) (
          given in transported):
      MP(thy, acc, given :~ Thm)
  let quantified = GENL(thy, family.vars, discharge_all(thy, rules, derived))
  let folded = EQ_MP(SYM(thy, unfold_def(thy, definitions[index],
                                         conclusion_args)),
                     quantified)
  require_statement(
    GENL(thy, ys, discharge_all(thy, instantiated, folded)),
    instantiate(family, rule), "introduction")

// -- cases --------------------------------------------------------------------

// `|- !x. p_j x ==> (D_1 or ... or D_r)`, over the rules that conclude with
// `p_j`.
//
// The converse of closure, by induction at the strengthened family
// `\x. p_l x and (D_1 or ... or D_r)`. The extra conjunct is what makes each
// closure case's premises available as facts about the `p`s again, which is
// how the introduction theorems re-establish the first conjunct; without it
// the disjunction would have nothing to say about a rule's recursive premises.
fun derive_cases(thy :: Theory, family :: Family, rules :: List.of(Term),
                 inductions :: List.of(Thm),
                 introductions :: List.of(Thm),
                 arguments :: List.of(List.of(FVar)),
                 index :: NonnegInt) :: Thm:
  let positions = rules.map(fun (r :: Term): rule_target(family, r))
  let disjuncts:
    for List (position in List.iota(family.vars.length())):
      for values(acc :~ List.of(Term) = []) (rule in rules, at in positions):
        cond
        | at == position:
            acc ++ [inversion_term(family, rule :~ Term,
                                   arguments[position] :~ List)]
        | ~else: acc
  let disjunctions = disjuncts.map(
                       fun (ds :: List.of(Term)): mk_disj_list(ds))
  let strong:
    for List (xs in arguments, disjunction in disjunctions,
              position in List.iota(family.vars.length())):
      list_mk_abs(
        xs :~ List,
        mk_conj(list_mk_comb(family.constants[position],
                             (xs :~ List).map(fun (x :: FVar): x :~ Term)),
                disjunction :~ Term))
  let instance = BETA_RULE(thy, SPECL(thy, strong, inductions[index]))
  let (goals, _) = strip_imp(concl_of(instance))
  let projections:
    for List (xs in arguments, disjunction in disjunctions,
              position in List.iota(family.vars.length())):
      conjunct_projection(thy, family.constants[position],
                          disjunction :~ Term, xs :~ List)
  let closed:
    for values(acc :~ Thm = instance) (
          rule in rules, introduction in introductions, goal in goals,
          at in positions):
      MP(thy, acc,
         derive_closure_case(
           thy, family, rule :~ Term, introduction :~ Thm, projections,
           disjuncts[at :~ NonnegInt] :~ List, arguments[at :~ NonnegInt] :~ List,
           disjunct_index(rules, positions, rule :~ Term, at :~ NonnegInt),
           goal :~ Term))
  let xs = arguments[index] :~ List
  let args = xs.map(fun (x :: FVar): x :~ Term)
  let membership = list_mk_comb(family.constants[index], args)
  let at_args = MP(thy, SPECL(thy, args, closed), ASSUME(thy, membership))
  GENL(thy, xs, DISCH(thy, membership, CONJUNCT2(thy, at_args)))

fun rule_target(family :: Family, rule :: Term) :: NonnegInt:
  let (index, _, _, _) = rule_parts(family, rule, [])
  index

// A rule's position among the rules that conclude with the same predicate,
// which is the disjunct it justifies.
fun disjunct_index(rules :: List.of(Term), positions :: List.of(NonnegInt),
                   rule :: Term, target :: NonnegInt) :: NonnegInt:
  recur loop (remaining :~ List.of(Term) = rules,
              at :~ List.of(NonnegInt) = positions, seen = 0):
    match remaining
    | []: error(~who: #'inductive, "internal missing rule")
    | List.cons(first, rest):
        cond
        | first == rule && at[0] == target: seen
        | at[0] == target: loop(rest, at.drop(1), seen + 1)
        | ~else: loop(rest, at.drop(1), seen)

// `D_i`: some instance of rule `i` has premises holding of the `p`s and
// concluded with `x`.
fun inversion_term(family :: Family, rule :: Term,
                   xs :: List.of(FVar)) :: Term:
  let avoid = family.constants ++ xs.map(fun (x :: FVar): x :~ Term)
  let (_, ys, premises, args) = rule_parts(family, rule, avoid)
  let equations:
    for List (x in xs, argument in args):
      mk_eq(x :~ Term, instantiate(family, argument))
  let instantiated = premises.map(fun (p :: Term): instantiate(family, p))
  for values(acc :~ Term = mk_conj_list(instantiated ++ equations)) (
        y in ys.reverse()):
    mk_exists(y :~ FVar, acc)

// One closure case: assuming a rule's premises about the strengthened family,
// both conjuncts hold of the rule's conclusion.
fun derive_closure_case(thy :: Theory, family :: Family, rule :: Term,
                        introduction :: Thm, projections :: List.of(Thm),
                        disjuncts :: List.of(Term), xs :: List.of(FVar),
                        index :: NonnegInt, goal :: Term) :: Thm:
  let (_, ys, premises, args) = rule_parts(family, rule, family.constants)
  let conclusion_args = args.map(fun (a :: Term): instantiate(family, a))
  fun atom(position :: NonnegInt, arguments :: List.of(Term)) :: Thm:
    SPECL(thy, arguments, projections[position] :~ Thm)
  let steps:
    for List (source in premises):
      monotone_instance(thy, family, source :~ Term, atom)
  let assumptions = steps.map(antecedent_of)
  let recovered:
    for List (step in steps, given in assumptions):
      MP(thy, step :~ Thm, ASSUME(thy, given :~ Term))
  let membership:
    for values(acc :~ Thm = SPECL(thy, ys.map(fun (y :: FVar): y :~ Term),
                                  introduction)) (
          given in recovered):
      MP(thy, acc, given :~ Thm)
  let substitution:
    for values(out :~ Map = {}) (x in xs, argument in conclusion_args):
      out ++ {x :~ FVar: argument :~ Term}
  let instances = disjuncts.map(
                    fun (d :: Term): inst_fvar(substitution, d))
  let injected = inject_disjunct(
                   thy, instances, index,
                   witness_inversion(thy, instances[index], ys, recovered,
                                     xs.length()))
  require_statement(
    GENL(thy, ys,
         discharge_all(thy, assumptions, CONJ(thy, membership, injected))),
    goal, "inversion closure")

// `|- !x. (p_l x and D) ==> p_l x`: dropping the strengthened predicate's
// second conjunct is what turns a premise about it back into a premise about
// `p_l`.
fun conjunct_projection(thy :: Theory, constant :: Term, disjunction :: Term,
                        xs :: List.of(FVar)) :: Thm:
  let source = mk_conj(list_mk_comb(constant,
                                    xs.map(fun (x :: FVar): x :~ Term)),
                       disjunction)
  GENL(thy, xs, DISCH(thy, source, CONJUNCT1(thy, ASSUME(thy, source))))

// The rule's own disjunct, witnessed at the variables the rule was opened
// with: its premises are the facts just recovered, and each argument equation
// is reflexivity, because the conclusion is what the disjunct was built from.
fun witness_inversion(thy :: Theory, target :: Term, ys :: List.of(FVar),
                      recovered :: List.of(Thm),
                      equations_count :: NonnegInt) :: Thm:
  let (levels, body) = existential_levels(target, ys)
  let conjuncts = conjunct_terms(body, recovered.length() + equations_count)
  let equations = conjuncts.drop(recovered.length())
  let proofs = recovered ++ equations.map(
                              fun (e :: Term): REFL(thy, equation_side(e)))
  for values(acc :~ Thm = conj_all(thy, proofs)) (
        level in levels.reverse(), y in ys.reverse()):
    EXISTS(thy, level :~ Term, y :~ Term, acc)

// Each existential's own term, outermost first, together with the body left
// once every level has been instantiated at its witness.
//
// `dest_exists` hands back a body already opened at a variable of its own
// choosing -- a *fresh* one when the witness's own variables occur free in
// the body, which is exactly the case here, since the equations were built
// by substituting the rule's conclusion. So each level is instantiated the
// way `EXISTS` will instantiate it, at the variable `dest_exists` reports;
// substituting for a de Bruijn binder that is no longer there would silently
// leave the level unopened and only fail two steps later.
fun existential_levels(target :: Term, ys :: List.of(FVar))
    :: values(List.of(Term), Term):
  recur loop (current :: Term = target, remaining :~ List.of(FVar) = ys,
              acc :~ List.of(Term) = []):
    match remaining
    | []: values(acc, current)
    | List.cons(y, rest):
        match dest_exists(current)
        | [v, inner]:
            loop(inst_fvar({v :~ FVar: y :~ Term}, inner :~ Term),
                 rest, acc ++ [current])
        | ~else:
            error(~who: #'inductive, "internal missing inversion binder")

// The `count` conjuncts of a right-nested conjunction.
fun conjunct_terms(body :: Term, count :: NonnegInt) :: List.of(Term):
  recur loop (current :: Term = body, remaining = count,
              acc :~ List.of(Term) = []):
    cond
    | remaining <= 1: acc ++ [current]
    | ~else:
        match dest_conj(current)
        | [a, b]: loop(b :~ Term, remaining - 1, acc ++ [a :~ Term])
        | ~else: error(~who: #'inductive, "internal short conjunction")

fun equation_side(t :: Term) :: Term:
  match dest_eq(t)
  | [a, _]: a
  | ~else: error(~who: #'inductive, "internal non-equation")

fun conj_all(thy :: Theory, ths :: List.of(Thm)) :: Thm:
  match ths
  | [th]: th
  | List.cons(th, rest): CONJ(thy, th :~ Thm, conj_all(thy, rest))
  | ~else: error(~who: #'inductive, "internal empty conjunction")

// Inject a proof of the `index`-th disjunct into the right-nested disjunction
// of all of them.
fun inject_disjunct(thy :: Theory, terms :: List.of(Term),
                    index :: NonnegInt, th :: Thm) :: Thm:
  cond
  | terms.length() <= 1: th
  | index == 0: DISJ1(thy, th, mk_disj_list(terms.drop(1)))
  | ~else:
      DISJ2(thy, terms[0],
            inject_disjunct(thy, terms.drop(1), index - 1, th))
