#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// HOL Light's `arith.ml` numeral conversions are the design reference; see
// THIRD_PARTY_NOTICES.


// Proof-producing arithmetic on compact numerals.
//
// Each conversion here answers a closed arithmetic question -- what is
// `a + b`, is `a` equal to `b` -- with a theorem, never with a value. The
// answer is computed the fast way, by recursion on the digit chains, but every
// step of that recursion is an instantiation of one of the derived equations
// in `number/nat.rhm`, chained with `TRANS`, `AP_TERM` and `EQ_MP`. The
// kernel therefore checks the arithmetic: a bug in the recursion below can
// only fail to produce a theorem, never produce a wrong one.
//
//   `nat_add_conv`  `add(a, b)`  ->  `|- add(a, b) === <a+b>`
//   `nat_succ_conv` `succ(a)`    ->  `|- succ(a) === <a+1>`
//   `nat_eq_conv`   `a === b`    ->  `|- (a === b) <=> true` or `<=> false`
//
// All three take literals only, and return `#false` for anything else: an
// open term is not their business.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/logic/drule open
  rhombus/hol/logic/conv open
  rhombus/hol/logic/ruledb open
  rhombus/hol/logic/tmatch open
  rhombus/hol/prover/context open
  rhombus/hol/number/literal open
  rhombus/hol/number/nat open

export:
  nat_succ_conv
  nat_add_conv
  nat_eq_conv
  nat_literal_conv
  numeral_conv

// `|- succ(a) === <a+1>` for a literal `a`.
//
//   `succ(zero())` is `b1(zero())`, `succ(b0 n)` is `b1 n`, and `succ(b1 n)`
//   carries: `b0(succ n)`, whose inner successor is the same problem one digit
//   shorter.
fun nat_succ_conv(arith :: NatArith, thy :: Theory,
                  t :: Term) :: maybe(Thm):
  let shape = arith.shape
  match t
  | Comb(Const(s, _), x) when s == shape.succ_name: succ_of(arith, thy, x)
  | ~else: #false

fun succ_of(arith :: NatArith, thy :: Theory, x :: Term) :: maybe(Thm):
  let shape = arith.shape
  match x
  | Const(z, _) when z == shape.zero_name: arith.suc_zero
  | Comb(Const(digit, _), inner) when digit == bit0_name:
      SPEC(thy, inner, arith.suc_b0)
  | Comb(Const(digit, _), inner) when digit == bit1_name:
      // `succ(b1 n) === b0(succ n)`, then the carry, then congruence.
      match succ_of(arith, thy, inner)
      | #false: #false
      | carried :: Thm:
          TRANS(SPEC(thy, inner, arith.suc_b1),
                AP_TERM(thy, shape.bit0_term, carried))
  | ~else: #false

// `|- add(a, b) === <a+b>` for literals `a` and `b`.
fun nat_add_conv(arith :: NatArith, thy :: Theory,
                 t :: Term) :: maybe(Thm):
  match dest_binary(arith.add_term, t)
  | #false: #false
  | [a, b]: add_of(arith, thy, a, b)

fun dest_binary(op :: Term, t :: Term) :: maybe(List.of(Term)):
  match t
  | Comb(Comb(f, x), y) when f == op: [x :~ Term, y :~ Term]
  | ~else: #false

fun add_of(arith :: NatArith, thy :: Theory,
           a :: Term, b :: Term) :: maybe(Thm):
  let shape = arith.shape
  fun digit_of(t :: Term) :: maybe(List):
    match t
    | Comb(Const(d, _), inner) when d == bit0_name: [#'b0, inner :~ Term]
    | Comb(Const(d, _), inner) when d == bit1_name: [#'b1, inner :~ Term]
    | ~else: #false
  cond
  | a == shape.zero_term: SPEC(thy, b, arith.zero_left)
  | b == shape.zero_term: SPEC(thy, a, arith.zero_right)
  | ~else:
      match [digit_of(a), digit_of(b)]
      | [[da, ai], [db, bi]]:
          let carry = da == #'b1 && db == #'b1
          let law:
            cond
            | da == #'b0 && db == #'b0: arith.b0b0
            | da == #'b0: arith.b0b1
            | db == #'b0: arith.b1b0
            | ~else: arith.b1b1
          let result_digit = (if da == db | shape.bit0_term | shape.bit1_term)
          match add_of(arith, thy, ai :~ Term, bi :~ Term)
          | #false: #false
          | inner :: Thm:
              // `|- add(a, b) === <digit>(...)`, with the inner sum still
              // written as an addition; rewriting it to its value is one
              // congruence step, plus the carry's successor when there is one.
              let stepped:
                cond
                | carry:
                    match succ_of(arith, thy, rhs_of(inner))
                    | #false: #false
                    | bumped :: Thm:
                        TRANS(AP_TERM(thy, arith.shape.succ_term, inner),
                              bumped)
                | ~else: inner
              match stepped
              | #false: #false
              | step :: Thm:
                  TRANS(SPEC(thy, bi :~ Term,
                             SPEC(thy, ai :~ Term, law)),
                        AP_TERM(thy, result_digit, step))
      | ~else: #false

// `|- (a === b) <=> true` when the two literals are the same number, and
// `|- (a === b) <=> false` when they are not.
//
// Distinct literals differ by some `succ d`, and `ne_add_succ` says nothing
// equals itself plus a successor. Which way round the difference goes decides
// which of the two orientations is used; both are derived.
fun nat_eq_conv(arith :: NatArith, thy :: Theory,
                t :: Term) :: maybe(Thm):
  let shape = arith.shape
  match dest_eq(t)
  | #false: #false
  | [l, r]:
      match [canonical_numeral(shape, l), canonical_numeral(shape, r)]
      | [lv :: NonnegInt, rv :: NonnegInt]:
          cond
          | l == r: EQT_INTRO(thy, REFL(thy, l))
          | lv < rv: not_equal(arith, thy, l, r, rv - lv - 1, #true)
          | ~else: not_equal(arith, thy, r, l, lv - rv - 1, #false)
      | ~else: #false

// `small` plus `succ <gap>` is `large`; `forward` says whether the goal is
// `small === large` or `large === small`.
fun not_equal(arith :: NatArith, thy :: Theory,
              small :: Term, large :: Term, gap :: NonnegInt,
              forward :: Boolean) :: maybe(Thm):
  let shape = arith.shape
  let gap_term = encode_numeral(shape, gap)
  let ne = SPEC(thy, gap_term, SPEC(thy, small, arith.ne_add_succ))
  // `|- small + succ gap === large`: the successor first, then the sum.
  match succ_of(arith, thy, gap_term)
  | #false: #false
  | bumped :: Thm:
      let add_at_small = mk_comb(arith.add_term, small)
      match add_of(arith, thy, small, rhs_of(bumped))
      | #false: #false
      | summed :: Thm:
          let sum_eq = TRANS(AP_TERM(thy, add_at_small, bumped), summed)
          // Rewrite the sum inside `not (small === small + succ gap)`.
          let eq_at_small = mk_comb(mk_const(#'eq,
                                             mk_fun(shape.ty,
                                                    mk_fun(shape.ty, bool))),
                                    small)
          let inner = AP_TERM(thy, eq_at_small, sum_eq)
          let neg_ty = mk_fun(bool, bool)
          let negated = AP_TERM(thy, mk_const(#'neg, neg_ty), inner)
          let ne_at_large = EQ_MP(negated, ne)
          let oriented = (if forward
                          | ne_at_large
                          | flip_disequality(thy, ne_at_large, small, large))
          EQF_INTRO(thy, oriented)

// `|- not (a === b)` from `|- not (b === a)`, by congruence on the two
// orientations of the same equation.
fun flip_disequality(thy :: Theory, th :: Thm,
                     small :: Term, large :: Term) :: Thm:
  let ty = type_of(small)
  let eq_ty = mk_fun(ty, mk_fun(ty, bool))
  let x = mk_var(Symbol.gen("_num_x"), ty)
  let y = mk_var(Symbol.gen("_num_y"), ty)
  // `|- (x === y) <=> (y === x)` at these two terms, from the derived
  // symmetry of equality.
  let sym_iff = IMP_ANTISYM_RULE(
                  thy,
                  DISCH(thy, mk_eq(large, small),
                        SYM(thy, ASSUME(thy, mk_eq(large, small)))),
                  DISCH(thy, mk_eq(small, large),
                        SYM(thy, ASSUME(thy, mk_eq(small, large)))))
  let negated = AP_TERM(thy, mk_const(#'neg, mk_fun(bool, bool)),
                        SYM(thy, sym_iff))
  EQ_MP(negated, th)

// `|- b0(x) === <canonical>` given `|- x === s`: doubling the chain is one
// congruence step, except that doubling zero is zero, which the chain must
// not spell as `b0(zero())`.
fun double_of(arith :: NatArith, thy :: Theory, inner :: Thm) :: Thm:
  let doubled = AP_TERM(thy, arith.shape.bit0_term, inner)
  (if rhs_of(inner) == arith.shape.zero_term
   | TRANS(doubled, arith.b0_zero)
   | doubled)

// `|- mul(a, b) === <a*b>` for literals `a` and `b`, by recursion on `a`'s
// digits: an even `a` doubles the product, an odd one doubles it and adds `b`.
fun nat_mul_conv(arith :: NatArith, thy :: Theory,
                 t :: Term) :: maybe(Thm):
  match arith.mul
  | #false: #false
  | mul :: NatMul:
      match dest_binary(mul.mul_term, t)
      | #false: #false
      | [a, b]: mul_of(arith, mul, thy, a, b)

fun mul_of(arith :: NatArith, mul :: NatMul, thy :: Theory,
           a :: Term, b :: Term) :: maybe(Thm):
  let shape = arith.shape
  cond
  | a == shape.zero_term: SPEC(thy, b, mul.zero_left)
  | b == shape.zero_term: SPEC(thy, a, mul.zero_right)
  | ~else:
      match a
      | Comb(Const(digit, _), ai) when digit == bit0_name
                                         || digit == bit1_name:
          match mul_of(arith, mul, thy, ai :~ Term, b)
          | #false: #false
          | inner :: Thm:
              let law = (if digit == bit0_name | mul.at_b0 | mul.at_b1)
              let instance = SPEC(thy, b, SPEC(thy, ai :~ Term, law))
              let doubled = double_of(arith, thy, inner)
              cond
              | digit == bit0_name: TRANS(instance, doubled)
              | ~else:
                  // The odd case still owes one `b +`, written on the left,
                  // which is the shape `at_b1` states.
                  match add_of(arith, thy, b, rhs_of(doubled))
                  | #false: #false
                  | total :: Thm:
                      let rebuilt = AP_TERM(thy,
                                            mk_comb(arith.add_term, b),
                                            doubled)
                      TRANS(instance, TRANS(rebuilt, total))
      | ~else: #false

// `|- le(a, b) <=> true` or `<=> false` for literals `a` and `b`.
//
// Which it is comes from the difference, the same way disequality does: `a`
// is at most `a + d` for any `d`, and `b + succ d` is never at most `b`.
fun nat_le_conv(arith :: NatArith, thy :: Theory,
                t :: Term) :: maybe(Thm):
  match arith.order
  | #false: #false
  | order :: NatOrder:
      let shape = arith.shape
      match dest_binary(order.le_term, t)
      | #false: #false
      | [l, r]:
          match [canonical_numeral(shape, l), canonical_numeral(shape, r)]
          | [lv :: NonnegInt, rv :: NonnegInt]:
              cond
              | lv <= rv:
                  // `le(l, l + <r-l>)`, with the sum rewritten to `r`.
                  let gap = encode_numeral(shape, rv - lv)
                  match add_of(arith, thy, l, gap)
                  | #false: #false
                  | summed :: Thm:
                      let fact = SPEC(thy, gap, SPEC(thy, l, order.le_add))
                      EQT_INTRO(thy,
                                EQ_MP(AP_TERM(thy, mk_comb(order.le_term, l),
                                              summed),
                                      fact))
              | ~else:
                  // `not le(r + succ <l-r-1>, r)`, with the sum rewritten
                  // to `l`.
                  let gap = encode_numeral(shape, lv - rv - 1)
                  match succ_of(arith, thy, gap)
                  | #false: #false
                  | bumped :: Thm:
                      match add_of(arith, thy, r, rhs_of(bumped))
                      | #false: #false
                      | summed :: Thm:
                          let sum_eq = TRANS(
                                         AP_TERM(thy,
                                                 mk_comb(arith.add_term, r),
                                                 bumped),
                                         summed)
                          let fact = SPEC(thy, gap,
                                          SPEC(thy, r, order.not_le_add_succ))
                          let inner = AP_THM(thy,
                                             AP_TERM(thy, order.le_term,
                                                     sum_eq),
                                             r)
                          let negated = AP_TERM(thy,
                                                mk_const(#'neg,
                                                         mk_fun(bool, bool)),
                                                inner)
                          EQF_INTRO(thy, EQ_MP(negated, fact))
          | ~else: #false

// `|- sub(a, b) === <a-b>` for literals, truncated at zero.
//
// Above `b` the difference `r` satisfies `b + r === a`, so `sub_add` gives it
// once the sum is rewritten to `a`; at or below `b` the answer is zero by
// `sub_below`, whose shape is `a - (a + succ d)`.
fun nat_sub_conv(arith :: NatArith, thy :: Theory,
                 t :: Term) :: maybe(Thm):
  match arith.sub
  | #false: #false
  | sub :: NatSub:
      let shape = arith.shape
      match dest_binary(sub.sub_term, t)
      | #false: #false
      | [l, r]:
          match [canonical_numeral(shape, l), canonical_numeral(shape, r)]
          | [lv :: NonnegInt, rv :: NonnegInt]:
              cond
              | lv >= rv:
                  let rest = encode_numeral(shape, lv - rv)
                  match add_of(arith, thy, r, rest)
                  | #false: #false
                  | summed :: Thm:
                      let fact = SPEC(thy, rest, SPEC(thy, r, sub.sub_add))
                      // `sub(r + rest, r) === rest` with the sum made `l`.
                      let at_sub = AP_THM(thy,
                                          AP_TERM(thy, sub.sub_term, summed),
                                          r)
                      TRANS(SYM(thy, at_sub), fact)
              | ~else:
                  let gap = encode_numeral(shape, rv - lv - 1)
                  match succ_of(arith, thy, gap)
                  | #false: #false
                  | bumped :: Thm:
                      match add_of(arith, thy, l, rhs_of(bumped))
                      | #false: #false
                      | summed :: Thm:
                          let sum_eq = TRANS(
                                         AP_TERM(thy,
                                                 mk_comb(arith.add_term, l),
                                                 bumped),
                                         summed)
                          let fact = SPEC(thy, gap,
                                          SPEC(thy, l, sub.sub_below))
                          let at_sub = AP_TERM(thy,
                                               mk_comb(sub.sub_term, l),
                                               sum_eq)
                          TRANS(SYM(thy, at_sub), fact)
          | ~else: #false

// `|- u === <canonical>` when `u` is a numeral written some other way --
// `succ` of a digit chain, which is what an argument looks like after a
// definition unfolded one constructor. `#false` when `u` is already
// canonical, or is not a numeral at all.
fun canonicalize(arith :: NatArith, thy :: Theory, u :: Term) :: maybe(Thm):
  let shape = arith.shape
  cond
  | canonical_numeral(shape, u) != #false: #false
  | ~else:
      match u
      | Comb(Const(s, _), v) when s == shape.succ_name:
          match canonicalize(arith, thy, v :~ Term)
          | #false: succ_of(arith, thy, v :~ Term)
          | inner :: Thm:
              match succ_of(arith, thy, rhs_of(inner))
              | #false: #false
              | bumped :: Thm:
                  TRANS(AP_TERM(thy, shape.succ_term, inner), bumped)
      | ~else: #false

// The one conversion the simplifier asks for.
//
// Two jobs, and the head decides which one this term gets, once and for all.
//
// An arithmetic head -- the module's addition, multiplication, comparison or
// difference, `succ`, or equality -- is a closed question this module can
// answer, so its arguments are put in digit form and the answer derived. Any
// other head is an ordinary definition, which computes by matching `zero()`
// and `succ(k)`: there the literal is *un*-compacted by one constructor,
// which is what lets the definition unfold against it, exactly as it did
// when every literal was a `succ` chain.
//
// Splitting by head is what keeps the two directions from chasing each
// other: no term is ever a candidate for both.
fun nat_literal_conv(arith :: NatArith, ctx :: Context, thy :: Theory,
                     t :: Term) :: maybe(Thm):
  let shape = arith.shape
  fun canonical(x :: Term) :: Boolean:
    canonical_numeral(shape, x) != #false
  let (head, args) = strip_comb(t)
  cond
  | !arithmetic_head(arith, head :~ Term, args :~ List):
      destructure_for_rule(arith, ctx, thy, t)
  | ~else:
      recur over_args (i = 0):
        cond
        | i >= args.length(): decide(arith, thy, t)
        | canonical(args[i] :~ Term): over_args(i + 1)
        | ~else:
            // One argument back into digit form; the rest follow on the next
            // visit, and then the question can be answered.
            match canonicalize(arith, thy, args[i] :~ Term)
            | #false: over_args(i + 1)
            | eq :: Thm:
                congruence_at(thy, head :~ Term, args :~ List, i, eq)

fun arithmetic_head(arith :: NatArith, head :: Term,
                    args :: List) :: Boolean:
  match head
  | Const(name, _):
      cond
      | args.length() == 2:
          head == arith.add_term || is_mul(arith, head)
            || is_le(arith, head) || is_sub(arith, head) || name == #'eq
      | args.length() == 1: name == arith.shape.succ_name
      | ~else: #false
  | ~else: #false

fun decide(arith :: NatArith, thy :: Theory, t :: Term) :: maybe(Thm):
  let shape = arith.shape
  match t
  | Comb(Comb(f, _), _):
      cond
      | f == arith.add_term: nat_add_conv(arith, thy, t)
      | is_mul(arith, f :~ Term): nat_mul_conv(arith, thy, t)
      | is_le(arith, f :~ Term): nat_le_conv(arith, thy, t)
      | is_sub(arith, f :~ Term): nat_sub_conv(arith, thy, t)
      | ~else: nat_eq_conv(arith, thy, t)
  | Comb(Const(s, _), _) when s == shape.succ_name:
      nat_succ_conv(arith, thy, t)
  | ~else: #false

fun is_mul(arith :: NatArith, f :: Term) :: Boolean:
  match arith.mul
  | #false: #false
  | mul :: NatMul: f == mul.mul_term

fun is_le(arith :: NatArith, f :: Term) :: Boolean:
  match arith.order
  | #false: #false
  | order :: NatOrder: f == order.le_term

fun is_sub(arith :: NatArith, f :: Term) :: Boolean:
  match arith.sub
  | #false: #false
  | sub :: NatSub: f == sub.sub_term

// What the driver installs in the `Context` as its numeral capability, and
// what the simplifier calls on every subterm it is about to rewrite.
//
// The derivation behind `nat_arith` costs a few seconds, so it must not
// happen in a module that never computes with a literal: the syntactic
// pre-check below is what keeps it from being paid for. Only a term that
// already mentions a digit constant can be decided here, since `zero()` and
// `succ` alone are what the rewriter has always handled by itself.
fun numeral_conv(ctx :: Context, thy :: Theory, t :: Term) :: maybe(Thm):
  cond
  | !mentions_digit(t): #false
  | ~else:
      match nat_arith(ctx)
      | #false: #false
      | arith :: NatArith: nat_literal_conv(arith, ctx, thy, t)

// A literal is not a constructor application, so a function defined by
// matching on `zero()` and `succ(k)` cannot reduce when it is applied to one.
// This writes the literal back as `succ(<one less>)` -- but only where a rule
// is then going to fire, which is what keeps it from undoing the compact
// representation and from cycling against the successor conversion.
//
// The rewriter takes the step immediately afterwards, so the exposed `succ`
// is consumed before the traversal ever looks at it. This is how an ordinary
// Peano-recursive function still computes on a literal argument -- one
// constructor at a time, as its own definition says, and no faster.
fun destructure_for_rule(arith :: NatArith, ctx :: Context, thy :: Theory,
                         t :: Term) :: maybe(Thm):
  let shape = arith.shape
  let (head, args) = strip_comb(t)
  match head
  | Const(name, _):
      recur over_args (i = 0):
        cond
        | i >= args.length(): #false
        | ~else:
            let arg = args[i] :~ Term
            match canonical_numeral(shape, arg)
            | #false: over_args(i + 1)
            | 0: over_args(i + 1)
            | value :: NonnegInt:
                let peeled = mk_comb(shape.succ_term,
                                     encode_numeral(shape, value - 1))
                let stepped = replace_argument(head :~ Term, args :~ List,
                                               i, peeled)
                cond
                | !some_rule_matches(ctx, name, stepped): over_args(i + 1)
                | ~else:
                    match succ_of(arith, thy, encode_numeral(shape, value - 1))
                    | #false: over_args(i + 1)
                    | bumped :: Thm:
                        // `|- <literal> === succ(<literal - 1>)`, lifted to
                        // the argument's position.
                        congruence_at(thy, head :~ Term, args :~ List, i,
                                      SYM(thy, bumped))
  | ~else: #false

fun replace_argument(head :: Term, args :: List, i :: NonnegInt,
                     replacement :: Term) :: Term:
  for values(acc :~ Term = head) (arg in args, j in List.iota(args.length())):
    mk_comb(acc, (if j == i | replacement | arg :~ Term))

// `|- f(.. a ..) === f(.. b ..)` from `|- a === b`.
fun congruence_at(thy :: Theory, head :: Term, args :: List, i :: NonnegInt,
                  eq :: Thm) :: Thm:
  for values(acc :~ Thm = REFL(thy, head)) (arg in args,
                                            j in List.iota(args.length())):
    MK_COMB(acc, (if j == i | eq | REFL(thy, arg :~ Term)))

// Whether the rule database has a rule for `name` whose left-hand side
// matches `t`. Peeling a literal is only worth a step if the step that
// follows it is there.
fun some_rule_matches(ctx :: Context, name :: Symbol, t :: Term) :: Boolean:
  for any (rule in rules_of(ctx.db, name)):
    let rule :~ RewriteRule = rule
    // Unconditional only: the step after the peel has to be certain, or the
    // exposed `succ` would be left for the traversal to fold back up.
    rule.conds == [] && term_match(rule.vars, rule.lhs, t) != #false

// Whether a digit constant occurs anywhere in `t`.
//
// This is the gate in front of everything else, so it has to be both cheap
// and complete. Cheap because a compact literal is small -- the whole point
// of the representation -- and complete because missing an occurrence means
// the rewriter unfolds a definition against a numeral one constructor at a
// time instead, which is the cost the representation exists to avoid.
fun mentions_digit(t :: Term) :: Boolean:
  match t
  | Const(name, _): name == bit0_name || name == bit1_name
  | Comb(f, x): mentions_digit(f :~ Term) || mentions_digit(x :~ Term)
  | Abs(_, body): mentions_digit(body :~ Term)
  | ~else: #false
