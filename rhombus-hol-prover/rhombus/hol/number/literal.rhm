#lang rhombus/static
// SPDX-License-Identifier: 0BSD


// The kernel's checked Nat literal is the sole numeral representation. These
// are the fixed native Nat terms needed by structural equation recognition;
// no user-defined codec or auxiliary numeral constants are involved.

import:
  rhombus/hol/htype open
  rhombus/hol/term open

export:
  nat_type_name
  nat_type
  nat_zero
  nat_succ

def nat_type_name :: Symbol = #'Nat
def nat_type :: HType = mk_tyapp(nat_type_name, [])
def nat_zero :: Term = mk_const(#'zero, nat_type)
def nat_succ :: Term = mk_const(#'succ, mk_fun(nat_type, nat_type))
