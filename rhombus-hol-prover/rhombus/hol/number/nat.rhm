#lang rhombus/static
// SPDX-License-Identifier: 0BSD


// Exact source evidence for the kernel's checked NatLit arithmetic.
//
// Operation names are deliberately irrelevant. A function is admitted only
// when its FunInfo contains exactly the universally quantified Peano equations
// below. The original theorem objects are retained; the conversion boundary
// specializes them with fresh Nat variables for the kernel validator. This
// layer neither derives replacement laws nor trusts an evaluator.

import:
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/prover/context open
  rhombus/hol/recursion/recdef open
  rhombus/hol/number/literal open

export:
  NatAddEvidence
  NatMulEvidence
  NatLeEvidence
  NatSubEvidence
  NatPowEvidence
  nat_add_evidence
  nat_mul_evidence
  nat_le_evidence
  nat_sub_evidence
  nat_pow_evidence

class NatAddEvidence(fn :: Term, zero :: Thm, succ :: Thm)
class NatMulEvidence(fn :: Term, add :: NatAddEvidence,
                     zero :: Thm, succ :: Thm)
class NatLeEvidence(fn :: Term, zero :: Thm, succ_zero :: Thm,
                    succ_succ :: Thm)
class NatSubEvidence(fn :: Term, zero :: Thm, succ_zero :: Thm,
                     succ_succ :: Thm)
class NatPowEvidence(fn :: Term, mul :: NatMulEvidence,
                     zero :: Thm, succ :: Thm)

// Open every leading universal quantifier and require exactly `arity` of them,
// no hypotheses, and an equation body.
fun opened_equation(th :: Thm, arity :: NonnegInt) :: maybe(List):
  cond
  | hyps_of(th) != []: #false
  | ~else:
      let (vars, body) = strip_forall(concl_of(th))
      match dest_eq(body)
      | [lhs, rhs] when vars.length() == arity: [vars, lhs, rhs]
      | ~else: #false

// Return exact clauses in the requested tag order. Extra, unknown, or
// duplicate equations reject the operation.
fun exact_clauses(equations :: List.of(Thm), classify :: Function,
                  tags :: List.of(Symbol)) :: maybe(List.of(Thm)):
  cond
  | equations.length() != tags.length(): #false
  | ~else:
      recur scan(rest :~ List = equations, acc :~ Map = {}):
        match rest
        | []: for List (t in tags): acc[t] :~ Thm
        | List.cons(th, more):
            let th :~ Thm = th
            match classify(th :~ Thm)
            | tag :: Symbol when tags.contains(tag) && !acc.has_key(tag):
                scan(more :~ List, acc ++ {tag: th})
            | ~else: #false

fun info_for(ctx :: Context, fn :: Term) :: maybe(FunInfo):
  match fn
  | Const(name, _):
      match ctx.funs.get(name, #false)
      | info :: FunInfo when info.fn == fn: info
      | ~else: #false
  | ~else: #false

// add(zero, n) = n
// add(succ(k), n) = succ(add(k, n))
fun add_clause(fn :: Term, th :: Thm) :: maybe(Symbol):
  match opened_equation(th, 1)
  | [[n], Comb(Comb(f, z), n2), n3]:
      (if f == fn && z == nat_zero && n == n2 && n == n3
       | #'zero
       | #false)
  | ~else:
      match opened_equation(th, 2)
      | [[k, n],
         Comb(Comb(f, Comb(s, k2)), n2),
         Comb(s2, Comb(Comb(f2, k3), n3))]:
          (if f == fn && f2 == fn && s == nat_succ && s2 == nat_succ
                 && k == k2 && k == k3 && n == n2 && n == n3
           | #'succ
           | #false)
      | ~else: #false

fun nat_add_evidence(ctx :: Context, fn :: Term) :: maybe(NatAddEvidence):
  match info_for(ctx, fn)
  | #false: #false
  | info :: FunInfo:
      match exact_clauses(info.equations,
                          fun (th :: Thm): add_clause(fn, th),
                          [#'zero, #'succ])
      | [zero, succ]: NatAddEvidence(fn, zero :~ Thm, succ :~ Thm)
      | ~else: #false

// mul(zero, n) = zero
// mul(succ(k), n) = add(n, mul(k, n))
fun mul_clause(fn :: Term, th :: Thm) :: maybe(Symbol):
  match opened_equation(th, 1)
  | [[n], Comb(Comb(f, z), n2), z2]:
      (if f == fn && z == nat_zero && z2 == nat_zero && n == n2
       | #'zero
       | #false)
  | ~else:
      (if mul_succ_add(fn, th) | #'succ | #false)

fun mul_succ_add(fn :: Term, th :: Thm) :: maybe(Term):
  match opened_equation(th, 2)
  | [[k, n],
     Comb(Comb(f, Comb(s, k2)), n2),
     Comb(Comb(add, n3), Comb(Comb(f2, k3), n4))]:
      (if f == fn && f2 == fn && s == nat_succ
             && k == k2 && k == k3 && n == n2 && n == n3 && n == n4
       | add
       | #false)
  | ~else: #false

fun nat_mul_evidence(ctx :: Context, fn :: Term) :: maybe(NatMulEvidence):
  match info_for(ctx, fn)
  | #false: #false
  | info :: FunInfo:
      match exact_clauses(info.equations,
                          fun (th :: Thm): mul_clause(fn, th),
                          [#'zero, #'succ])
      | [zero, succ]:
          match mul_succ_add(fn, succ :~ Thm)
          | #false: #false
          | add_fn:
              match nat_add_evidence(ctx, add_fn :~ Term)
              | #false: #false
              | add :: NatAddEvidence:
                  NatMulEvidence(fn, add, zero :~ Thm, succ :~ Thm)
      | ~else: #false

// le(zero, n) = true
// le(succ(k), zero) = false
// le(succ(k), succ(n)) = le(k, n)
fun le_clause(fn :: Term, th :: Thm) :: maybe(Symbol):
  match opened_equation(th, 1)
  | [[k], Comb(Comb(f, Comb(s, k2)), z), truth]:
      (if f == fn && s == nat_succ && z == nat_zero
             && k == k2 && truth == tm_false
       | #'succ_zero
       | #false)
  | [[n], Comb(Comb(f, z), n2), truth]:
      (if f == fn && z == nat_zero && n == n2 && truth == tm_true
       | #'zero
       | #false)
  | ~else:
      match opened_equation(th, 2)
      | [[k, n],
         Comb(Comb(f, Comb(s, k2)), Comb(s2, n2)),
         Comb(Comb(f2, k3), n3)]:
          (if f == fn && f2 == fn && s == nat_succ && s2 == nat_succ
                 && k == k2 && k == k3 && n == n2 && n == n3
           | #'succ_succ
           | #false)
      | ~else: #false

fun nat_le_evidence(ctx :: Context, fn :: Term) :: maybe(NatLeEvidence):
  match info_for(ctx, fn)
  | #false: #false
  | info :: FunInfo:
      match exact_clauses(info.equations,
                          fun (th :: Thm): le_clause(fn, th),
                          [#'zero, #'succ_zero, #'succ_succ])
      | [zero, succ_zero, succ_succ]:
          NatLeEvidence(fn, zero :~ Thm, succ_zero :~ Thm,
                        succ_succ :~ Thm)
      | ~else: #false

// sub(zero, n) = zero
// sub(succ(k), zero) = succ(k)
// sub(succ(k), succ(n)) = sub(k, n)
fun sub_clause(fn :: Term, th :: Thm) :: maybe(Symbol):
  match opened_equation(th, 1)
  | [[k], Comb(Comb(f, Comb(s, k2)), z), Comb(s2, k3)]:
      (if f == fn && s == nat_succ && s2 == nat_succ && z == nat_zero
             && k == k2 && k == k3
       | #'succ_zero
       | #false)
  | [[n], Comb(Comb(f, z), n2), z2]:
      (if f == fn && z == nat_zero && z2 == nat_zero && n == n2
       | #'zero
       | #false)
  | ~else:
      match opened_equation(th, 2)
      | [[k, n],
         Comb(Comb(f, Comb(s, k2)), Comb(s2, n2)),
         Comb(Comb(f2, k3), n3)]:
          (if f == fn && f2 == fn && s == nat_succ && s2 == nat_succ
                 && k == k2 && k == k3 && n == n2 && n == n3
           | #'succ_succ
           | #false)
      | ~else: #false

fun nat_sub_evidence(ctx :: Context, fn :: Term) :: maybe(NatSubEvidence):
  match info_for(ctx, fn)
  | #false: #false
  | info :: FunInfo:
      match exact_clauses(info.equations,
                          fun (th :: Thm): sub_clause(fn, th),
                          [#'zero, #'succ_zero, #'succ_succ])
      | [zero, succ_zero, succ_succ]:
          NatSubEvidence(fn, zero :~ Thm, succ_zero :~ Thm,
                         succ_succ :~ Thm)
      | ~else: #false

// pow(base, zero) = succ(zero)
// pow(base, succ(k)) = mul(base, pow(base, k))
fun pow_clause(fn :: Term, th :: Thm) :: maybe(Symbol):
  match opened_equation(th, 1)
  | [[base], Comb(Comb(f, base2), z), Comb(s, z2)]:
      (if f == fn && base == base2 && z == nat_zero
             && s == nat_succ && z2 == nat_zero
       | #'zero
       | #false)
  | ~else:
      (if pow_succ_mul(fn, th) | #'succ | #false)

fun pow_succ_mul(fn :: Term, th :: Thm) :: maybe(Term):
  match opened_equation(th, 2)
  | [[base, k],
     Comb(Comb(f, base2), Comb(s, k2)),
     Comb(Comb(mul, base3), Comb(Comb(f2, base4), k3))]:
      (if f == fn && f2 == fn && s == nat_succ
             && base == base2 && base == base3 && base == base4
             && k == k2 && k == k3
       | mul
       | #false)
  | ~else: #false

fun nat_pow_evidence(ctx :: Context, fn :: Term) :: maybe(NatPowEvidence):
  match info_for(ctx, fn)
  | #false: #false
  | info :: FunInfo:
      match exact_clauses(info.equations,
                          fun (th :: Thm): pow_clause(fn, th),
                          [#'zero, #'succ])
      | [zero, succ]:
          match pow_succ_mul(fn, succ :~ Thm)
          | #false: #false
          | mul_fn:
              match nat_mul_evidence(ctx, mul_fn :~ Term)
              | #false: #false
              | mul :: NatMulEvidence:
                  NatPowEvidence(fn, mul, zero :~ Thm, succ :~ Thm)
      | ~else: #false
