#lang rhombus/static

// Immutable declaration and proof capabilities. `Context` is durable module
// state. `ProofEnv` exposes only the logical environment and proof-local rules;
// `SearchPolicy` separately exposes immutable search configuration.

import:
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/datatype/datatype open
  rhombus/hol/recursion/recdef open
  rhombus/hol/logic/ruledb open
  rhombus/hol/effect/core as effect
  rhombus/hol/effect/syntax open

export:
  Context
  ProofEnv
  SearchPolicy
  RuleBinding
  RuleScope
  mk_context
  context_with_rules
  context_with_theory
  context_with_numerals
  context_add_datatype
  context_add_function
  run_proof_scope

class Context(thy :: Theory,
              db :: RuleDB,
              dts :: Map.of(Symbol, DatatypeThms),
              funs :: Map.of(Symbol, FunInfo),
              // Every known constructor; generalization must not hide one
              // behind a fresh variable.
              ctors :: Set.of(Symbol),
              // How to decide a closed arithmetic question about numeral
              // literals, or `#false` where the module has no numerals.
              //
              // A plain `(Context, Theory, Term) -> maybe(Thm)` rather than a
              // named type: the decision procedure is derived by the prover
              // (`number/nat.rhm`), which sits above this module, and handing
              // it down as a value is what lets the simplifier use it without
              // this layer knowing anything about arithmetic.
              numerals :: maybe(Function) = #false)

class ProofEnv(base :: Context,
               db :: RuleDB):
  reader_effect

class SearchPolicy(skipped_stages :: Set.of(Symbol)):
  reader_effect

class RuleBinding(name :: Symbol, theorem :: Thm)

class RuleScope(using :: List.of(RuleBinding) = [],
                disabled :: List.of(Symbol) = [],
                skipped_stages :: Set.of(Symbol) = Set())

fun mk_context(thy :: Theory,
               ~rules: db :: RuleDB = empty_db,
               ~datatypes: dts :: Map.of(Symbol, DatatypeThms) = {},
               ~functions: funs :: Map.of(Symbol, FunInfo) = {}) :: Context:
  let ctors = for values(acc :~ Set = Set()) ((_, datatype_thms) in dts):
                for values(names :~ Set = acc) (constructor in (datatype_thms :~ DatatypeThms).spec.ctors):
                  names ++ {(constructor :~ Ctor).name}
  Context(thy, db, dts, funs, ctors)

fun context_with_rules(ctx :: Context, db :: RuleDB) :: Context:
  Context(ctx.thy, db, ctx.dts, ctx.funs, ctx.ctors, ctx.numerals)

// A theory extension that adds no rule: a definition the rewriter must not
// see, such as a numeral digit constant.
fun context_with_theory(ctx :: Context, thy :: Theory) :: Context:
  Context(thy, ctx.db, ctx.dts, ctx.funs, ctx.ctors, ctx.numerals)

// Install the arithmetic decision procedure. The driver does this once, when
// the module's numerals become available.
fun context_with_numerals(ctx :: Context, numerals :: Function) :: Context:
  Context(ctx.thy, ctx.db, ctx.dts, ctx.funs, ctx.ctors, numerals)

fun context_add_datatype(ctx :: Context, thy :: Theory, db :: RuleDB,
                         name :: Symbol, thms :: DatatypeThms) :: Context:
  let ctors = for values(names :~ Set = ctx.ctors) (constructor in thms.spec.ctors):
               names ++ {(constructor :~ Ctor).name}
  Context(thy, db, ctx.dts ++ {name: thms}, ctx.funs, ctors, ctx.numerals)

fun context_add_function(ctx :: Context, thy :: Theory, db :: RuleDB,
                         name :: Symbol, info :: FunInfo) :: Context:
  Context(thy, db, ctx.dts, ctx.funs ++ {name: info}, ctx.ctors, ctx.numerals)

// Each nominal capability owns private operation classes and exports only its
// semantic API through the class namespace.
// Build proof-local rule state without changing the durable `Context`, then
// install the logical environment and search policy as separate capabilities.
// Other effects are deliberately forwarded to an outer public boundary.
fun run_proof_scope(ctx :: Context, scope :: RuleScope,
                    body :: effect.Computation) :: effect.Computation:
  let db0 = for values(d :~ RuleDB = ctx.db) (binding in scope.using):
              let binding :~ RuleBinding = binding
              add_thm(ctx.thy, d, binding.name, binding.theorem)
  let used_names = scope.using.map(
                     fun (binding :: RuleBinding): binding.name)
  let db1 = enable(db0, used_names)
  let db2 = disable(db1, scope.disabled)
  let environment = ProofEnv(ctx, db2)
  let policy = SearchPolicy(scope.skipped_stages)
  SearchPolicy.handle(policy, ProofEnv.handle(environment, body))
