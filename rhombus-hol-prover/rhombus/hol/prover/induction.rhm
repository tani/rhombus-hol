#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Induction schemes: kernel-derived evidence that one induction principle
// applies at a goal.
//
// Every value here carries exactly the theorem that justifies instantiating
// it -- a datatype's own case-based induction axiom, a family of inductive
// predicates' induction theorem, or a well-founded induction theorem derived
// from `WF` (`definition/function/well_founded.rhm`'s `prove_wf_induction`) at a
// specific relation. None of that theorem is re-derived or approximated
// here: this module only names *which* kernel theorem backs *which*
// candidate, so a scheme's identity is its theorem's provenance, not a
// closure.
//
// What is deliberately absent: any notion of how good a candidate is at a
// given goal. Ranking candidate variables, scoring recursive companions, and
// every other search heuristic stay in `prover/tactic/induction.rhm`, which
// reads these values but never writes one -- a scheme is either kernel
// evidence a proof can instantiate, or it does not exist.

import:
  rhombus/hol/kernel/term open
  rhombus/hol/kernel open

export:
  InductionScheme
  DatatypeScheme
  RuleScheme
  WellFoundedScheme
  FunctionScheme

class.together:
  class InductionScheme():
    nonfinal

  // A declared datatype's own case-based induction axiom
  // (`DatatypeThms.induction`): `!P. (case for C1) and ... ==> !x. P x`.
  class DatatypeScheme(type_name :: Symbol, theorem :: Thm):
    extends InductionScheme

  // One predicate of a mutually-inductive family's induction theorem
  // (`definition/inductive.rhm`'s `derive_induction`):
  // `!P_1 ... P_m. R_1[P] ==> ... ==> R_k[P] ==> !x. p_j x ==> P_j x`.
  // `predicate_names` is the whole family, in declaration order;
  // `target` is which member (`p_j`) this instance's `theorem` proves.
  class RuleScheme(predicate_names :: List.of(Symbol), target :: Symbol,
                   theorem :: Thm):
    extends InductionScheme

  // The generic well-founded induction scheme
  // (`definition/function/well_founded.rhm`'s `prove_wf_induction`), specialized at one
  // concrete well-founded `relation` and its `WF` theorem:
  // `!P. (!x. (!y. relation y x ==> P y) ==> P x) ==> !x. P x`. `name`
  // identifies the relation (typically a datatype's subterm relation).
  class WellFoundedScheme(name :: Symbol, relation :: Term, theorem :: Thm):
    extends InductionScheme

  // The same well-founded induction scheme as `WellFoundedScheme`, at the
  // carrier relation a specific recursive function was derived over
  // (`definition/function/derive.rhm`'s `install_structural_function`). `positions`
  // are the function's structural induction argument columns
  // (`definition/function/spec.rhm`'s `RecursiveInduction`), not a search ranking.
  class FunctionScheme(name :: Symbol, positions :: List.of(Int),
                       relation :: Term, theorem :: Thm):
    extends InductionScheme
