#lang rhombus/static

// Resource accounting for proof search.
//
// Rewriting had no bound at all: a rule that neither terminates nor fails --
// one that is not permutative and whose right-hand side is not smaller --
// sent `simp_conv` into a loop, and since simplification runs while a module
// compiles, that hung `raco make` rather than failing it.
//
// Two properties matter and are easy to get wrong separately.
//
// The budget is *shared*.  A nested search -- discharging a rewrite rule's
// side condition, which itself rewrites -- draws on the caller's remaining
// steps rather than starting a fresh allowance, or conditional rewriting
// would be an unbounded loop with a bound written next to it.  Sharing is
// automatic here: a `Budget` wraps a mutable counter, and passing the same
// `Budget` value to nested search is passing the same counter.
//
// Exhaustion is an *error*, never `#false`.  A conversion returning `#false`
// means "this rule does not apply here", which is an ordinary and expected
// answer; if running out of resources said the same thing, a proof would
// silently continue down a path whose search had been abandoned, and the
// failure would surface somewhere else entirely.

export:
  Budget
  default_search_steps
  fresh_budget
  spend

// One number, not two.  A depth limit would be redundant: every level of a
// bounded traversal spends a step before it recurs, so the step count bounds
// depth as well as total work, and a second knob would only be a second thing
// to tune wrongly.
def default_search_steps :: NonnegInt = 200000

// `limit` is retained only to report it back in the exhaustion error;
// `remaining` is the mutable count every nested call shares by sharing this
// `Budget` value.
class Budget(limit :: NonnegInt, remaining :: Box)

fun fresh_budget(steps :: NonnegInt) :: Budget:
  Budget(steps, Box(steps))

// Spend one step, or fail. Search code receives only this one domain-specific
// permission; nothing here can reset or enlarge the allowance.
fun spend(budget :: Budget, who :: Symbol) :: Void:
  let left = budget.remaining.value :~ NonnegInt
  when left == 0
  | error(~who: who, "proof-search step limit exceeded",
          error.val(~label: "limit", budget.limit))
  budget.remaining.value := left - 1
