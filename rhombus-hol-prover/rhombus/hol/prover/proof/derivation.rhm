#lang rhombus/static

// The inductive proof relation generated by `Step`, represented by its least
// fixed point:
//
//   Derivation = μD. (Goal × Step × List(D))
//
// subject to the constructor equation that the children's goals are exactly
// the step's subgoals. Strict, immutable Rhombus construction realizes `μD`
// as finite well-founded trees: the empty child list is the base case and a
// node whose children are already derivations is the inductive step. Cyclic or
// lazy values would instead admit a greatest fixed point and are intentionally
// absent.
//
// `solve_step` (`node.rhm`) composes `Step.justify` functions as search
// goes, one `Step` at a time, with no proof object built first. A
// `Derivation` is the same composition scheduled the other way around: the
// tree is built first, in full, as an ordinary finite Rhombus value, and
// `realize_derivation` walks it afterward. Both routes bottom out in
// exactly the same place -- `step.justify` applied to recursively-realized
// child `Thm`s, each of which itself bottoms out in the kernel's ten
// primitives -- so neither is a second trust primitive; they are two
// schedules of the one composition argument `node.rhm` already makes.
//
// `realize_derivation` never trusts the tree's shape on faith: a child
// count that disagrees with `step.subgoals`, a child whose own goal is not
// literally the subgoal it was supposed to prove, or a `justify` result
// whose hypotheses/conclusion do not match this node's own goal, is
// rejected before that result is ever accepted as this node's `Thm`.

import:
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/prover/proof/node open

export:
  Derivation
  derivation_valid
  fold_derivation
  realize_derivation

// `goal` is what this node claims to prove; `step` is the `Step` chosen to
// prove it, whose own `subgoals` must line up, one for one and in the same
// order, with `children`'s goals; `children` are the already-built
// derivations of those subgoals. A `Derivation` value is finite the same
// way any other Rhombus tree value is finite: it is fully constructed,
// top-down, before `realize_derivation` ever inspects it, so there is no
// way to hand it a node whose subtree is not already finite.
class Derivation(goal :: Goal,
                 step :: Step,
                 children :: List.of(Derivation))

// A theorem proves a goal when every hypothesis it actually used is among
// the goal's assumptions. It may use fewer: weakening is admissible, and the
// irrelevance step intentionally returns its child theorem after dropping
// assumptions that cannot affect the conclusion.
fun hypotheses_allowed(actual :: List.of(Term),
                       allowed :: List.of(Term)) :: Boolean:
  for all (t in actual): allowed.contains(t)

// A child's goal must be exactly the subgoal `step` asked for: both sides
// come from ordinary, deterministic `Goal` construction (never through the
// kernel's hypothesis set), so plain structural equality -- not the set
// comparison above -- is the right check here.
fun same_goal(a :: Goal, b :: Goal) :: Boolean:
  a.asms == b.asms && a.concl == b.concl

// The inductively generated, well-formed subset of the recursive carrier.
// This is the constructor relation whose least fixed point is the proof
// derivation relation: a node is admitted exactly when its children are
// admitted and line up with every subgoal of its Step.
fun derivation_valid(derivation :: Derivation) :: Boolean:
  derivation.step.events.length() == derivation.step.subgoals.length()
    && derivation.children.length() == derivation.step.subgoals.length()
    && (for all (child in derivation.children,
                 subgoal in derivation.step.subgoals):
          same_goal(child.goal, subgoal))
    && (for all (child in derivation.children):
          derivation_valid(child))

// The initial-algebra eliminator for `Derivation`. Its defining fixed-point
// law is:
//
//   fold(Node(g, s, cs), alg) = alg(g, s, cs, map(fold(_, alg), cs))
//
// Every consumer defined through this fold therefore has exactly the base
// (`cs = []`) and inductive (`cs != []`) cases of the least relation above.
fun fold_derivation(derivation :: Derivation,
                    algebra :: Function.of_arity(4)):
  let child_results:
    for List (child in derivation.children):
      fold_derivation(child, algebra)
  algebra(derivation.goal, derivation.step, derivation.children,
          child_results)

fun check_derivation_shape(derivation :: Derivation) :: Void:
  let step = derivation.step
  let children = derivation.children
  unless step.events.length() == step.subgoals.length()
  | error(~who: #'proof,
          "derivation step has the wrong number of trace events",
          error.val(~label: "subgoals", step.subgoals.length()),
          error.val(~label: "events", step.events.length()))
  unless children.length() == step.subgoals.length()
  | error(~who: #'proof,
          "derivation has the wrong number of children for its step",
          error.val(~label: "subgoals", step.subgoals.length()),
          error.val(~label: "children", children.length()))
  for (child in children, subgoal in step.subgoals):
    unless same_goal(child.goal, subgoal)
    | error(~who: #'proof,
            "derivation child does not match its subgoal",
            error.val(~label: "subgoal", show(subgoal.concl)),
            error.val(~label: "child goal", show(child.goal.concl)))
    check_derivation_shape(child)

// Realize the least fixed point by its structural induction principle:
//
//   base: a zero-subgoal Step receives `[]` and its result is checked;
//   step: recursively realize every child (the induction hypotheses), pass
//         those kernel theorems to `Step.justify`, then check the parent.
//
// Child goals are checked against the step's subgoals one for one and in
// order. No `Thm` is fabricated and no new primitive is added: every `Thm`
// that comes out is one `step.justify` produced from kernel-checked `Thm`s,
// exactly as `solve_step` already requires.
fun realize_derivation(thy :: Theory, derivation :: Derivation) :: Thm:
  check_derivation_shape(derivation)
  fold_derivation(
    derivation,
    fun (goal :: Goal, step :: Step, _children :: List.of(Derivation),
         child_results :: List):
      let child_thms = child_results.map(fun (th): th :~ Thm)
      let realized = step.justify(child_thms)
      in_theory(#'proof, thy, realized)
      unless hypotheses_allowed(hyps_of(realized), goal.asms)
               && concl_of(realized) == goal.concl
      | error(~who: #'proof,
              "derivation step did not prove its stated goal",
              error.val(~label: "goal", show(goal.concl)),
              error.val(~label: "proved", show(concl_of(realized))))
      realized) :~ Thm
