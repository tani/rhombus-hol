#lang rhombus/static

// Proof-tree execution is a scoped capability, separate from proof
// construction. Orchestration requests execution without choosing the
// executor; the default remains deterministic and sequential.

import:
  rhombus/hol/kernel open
  rhombus/hol/prover/proof/node open
  rhombus/hol/prover/proof/run as proof_run
  rhombus/hol/effect/core open

export:
  ProofExecutor
  sequential_executor

class ProofExecutor(run :: Function):
  class Execute(node :: ProofNode):
    extends EffectOperation

  fun execute(node :: ProofNode) :: Computation:
    perform(Execute(node))
  fun handle(run :: Function,
             computation :: Computation) :: Computation:
    match computation
    | Pure(_): computation
    | Request(operation, resume):
        match operation
        | Execute(node):
            handle(run, resume(run(node)))
        | ~else:
            Request(operation,
                    fun (value): handle(run, resume(value)))

  export:
    execute
    handle

fun sequential_executor() :: ProofExecutor:
  ProofExecutor(fun (node :: ProofNode): proof_run.execute(node))
