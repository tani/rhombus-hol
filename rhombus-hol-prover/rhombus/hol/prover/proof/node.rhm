#lang rhombus/static

// Inspectable proof computation. Step carries the proof continuation; this
// module contains no search policy and no execution strategy.

import:
  rhombus/hol/term open
  rhombus/hol/kernel open

export:
  Goal
  Step
  ProofNode
  Proved
  Derived
  Open

class Goal(asms :: List.of(Term),
           concl :: Term,
           trail :: List.of(String))

class Step(subgoals :: List.of(Goal),
           justify :: (List.of(Thm) -> Thm))

class.together:
  class ProofNode():
    nonfinal
  class Proved(thm :: Thm):
    extends ProofNode
  class Derived(step :: Step, kids :: List.of(ProofNode)):
    extends ProofNode
  class Open(goal :: Goal):
    extends ProofNode
