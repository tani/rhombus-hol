#lang rhombus/static

// Sequential proof-tree interpreter. It is separate from ProofNode so other
// execution strategies can consume the same inspected computation later.

import:
  rhombus/hol/kernel open
  "node.rhm" open

export:
  execute
  collect_residues
  closed

// `#false` when any leaf remains open. Children are visited left-to-right and
// `Step.justify` receives proofs in the corresponding subgoal order.
fun execute(node :: ProofNode) :: maybe(Thm):
  match node
  | Proved(theorem): theorem
  | Open(_): #false
  | Derived(step, children):
      recur loop (remaining :~ List = children, proofs :~ List = []):
        match remaining
        | []: step.justify(proofs)
        | List.cons(child, rest):
            match execute(child :~ ProofNode)
            | #false: #false
            | theorem: loop(rest, proofs ++ [theorem])

fun closed(node :: ProofNode) :: Boolean:
  match node
  | Proved(_): #true
  | Open(_): #false
  | Derived(_, children): for all (child in children): closed(child)

fun collect_residues(node :: ProofNode) :: List.of(Goal):
  match node
  | Proved(_): []
  | Open(goal): [goal]
  | Derived(_, children):
      for values(goals :~ List = []) (child in children):
        goals ++ collect_residues(child)
