#lang rhombus/static

// Proof-tree execution is a scoped capability, separate from proof
// construction. Orchestration requests execution without choosing the
// evaluator; the default remains deterministic and sequential.

import:
  rhombus/hol/kernel open
  rhombus/hol/prover/proof/node open
  rhombus/hol/prover/proof/run open
  rhombus/hol/effect/core open

export:
  Scheduler
  sequential_scheduler

class Scheduler(run_tree :: Function):
  class Solve(node :: ProofNode):
    extends EffectOperation

  fun solve(node :: ProofNode) :: Computation:
    perform(Solve(node))
  fun handle(run_tree :: Function,
             computation :: Computation) :: Computation:
    match computation
    | Pure(_): computation
    | Request(operation, resume):
        match operation
        | Solve(node):
            handle(run_tree, resume(run_tree(node)))
        | ~else:
            Request(operation,
                    fun (value): handle(run_tree, resume(value)))

  export:
    solve
    handle

fun sequential_scheduler() :: Scheduler:
  Scheduler(fun (node :: ProofNode): execute(node))
