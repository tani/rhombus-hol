#lang rhombus/static

// Domain-specific waterfall stage algebra. A Stage is intentionally not a
// generic effect interface: its observable contract is Goal -> Computation.
// Stages request only the proof environment capability they require.

import:
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/logic/drule open
  rhombus/hol/prover/trace open
  rhombus/hol/prover/goal open
  rhombus/hol/effect/core open
  rhombus/hol/effect/syntax open
  rhombus/hol/prover/tactic/simp open
  rhombus/hol/prover/tactic/destruct open
  rhombus/hol/prover/tactic/fertilize open
  rhombus/hol/prover/tactic/general open
  rhombus/hol/datatype/datatype open
  rhombus/hol/prover/tactic/irrelevance open
  rhombus/hol/prover/tactic/induct open
  rhombus/hol/prover/context open

export:
  Stage
  standard_stages
  induction_stage
  run_stage
  first_success

class Stage(name :: Symbol, apply :: Function)

// The module's numeral capability, if it has one, is the simplifier's
// decision procedure for closed arithmetic: `number/conv.rhm` builds the
// answer as a theorem from derived equations, which is both faster and
// shorter than peeling a literal one constructor at a time.
fun simplify_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let env :: ProofEnv <- ProofEnv.ask()
      let numerals = env.base.numerals
      let decide:
        match numerals
        | #false: #false
        | decider :: Function:
            fun (thy :: Theory, t :: Term) :: maybe(Thm):
              decider(env.base, thy, t)
      simplify_goal(env.base.thy, env.db, goal, ~decide: decide)
  Stage(#'simplify, apply)

// A goal whose conclusion is universally quantified, at a fresh variable.
//
// The prover's entry point strips the quantifiers a user wrote, so this is
// about the ones induction introduces: strengthening the induction predicate
// to hold for every *other* variable of the goal (`tactic/induct.rhm`) is
// what lets a fact about two naturals descend on both, and it puts a
// quantifier in front of each case. Nothing else in the waterfall can attack
// one, so the case would be stuck the moment it appeared.
//
// `GEN` puts it back, so this proves the goal it was given and not a weaker
// one: the variable is fresh in the goal, hypotheses included.
fun specialize_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let env :: ProofEnv <- ProofEnv.ask()
      return specialize_goal(env.base.thy, goal)
  Stage(#'specialize, apply)

fun specialize_goal(thy :: Theory, g :: Goal) :: maybe(Step):
  match dest_forall(g.concl)
  | #false: #false
  | [v, body]:
      let fresh = variant(g.asms ++ [g.concl], v :~ FVar)
      let opened = subst_bvar(fresh :~ Term, body :~ Term)
      fun close(ths :: List.of(Thm)) :: Thm:
        GEN(thy, fresh, ths[0])
      Step([Goal(g.asms, opened)], close, [Specialized(fresh.name)])

fun eliminate_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let env :: ProofEnv <- ProofEnv.ask()
      return eliminate_goal(env.base.thy, env.base.dts, goal)
  Stage(#'eliminate, apply)

fun fertilize_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let env :: ProofEnv <- ProofEnv.ask()
      return fertilize_goal(env.base.thy, goal)
  Stage(#'fertilize, apply)

fun generalize_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let env :: ProofEnv <- ProofEnv.ask()
      return generalize_goal(env.base.thy, env.db, env.base.ctors, goal)
  Stage(#'generalize, apply)

fun irrelevance_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    return eliminate_irrelevance_goal(goal)
  Stage(#'irrelevance, apply)

fun induction_stage(hint :: maybe(FVar)) :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let env :: ProofEnv <- ProofEnv.ask()
      let candidates = (cond
                        | hint: [hint]
                        | ~else: candidate_vars(env.base.funs, env.base.dts, goal))
      recur choose (remaining :~ List = candidates):
        match remaining
        | []: return #false
        | List.cons(variable, rest):
            let variable :~ FVar = variable
            match inductive_type_name(variable)
            | #false: choose(rest)
            | type_name:
                match env.base.dts.get(type_name, #false)
                | #false: choose(rest)
                | datatype_thms:
                    return induction_step(env.base.thy, env.base.funs,
                                          datatype_thms :~ DatatypeThms,
                                          variable, goal)
  Stage(#'induct, apply)

fun standard_stages() :: List.of(Stage):
  [simplify_stage(), specialize_stage(), eliminate_stage(), fertilize_stage(),
   generalize_stage(), irrelevance_stage()]

fun run_stage(stage :: Stage, goal :: Goal) :: Computation:
  stage.apply(goal)

fun first_success(stages :: List.of(Stage), goal :: Goal) :: Computation:
  effect:
    let policy :: SearchPolicy <- SearchPolicy.ask()
    recur loop (remaining :~ List = stages):
      match remaining
      | []: return #false
      | List.cons(candidate, rest):
          let candidate :~ Stage = candidate
          cond
          | policy.skipped_stages.contains(candidate.name): loop(rest)
          | ~else:
              effect:
                let result <- run_stage(candidate, goal)
                match result
                | #false: loop(rest)
                | step: return step
