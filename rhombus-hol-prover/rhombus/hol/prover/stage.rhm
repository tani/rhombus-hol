#lang rhombus/static

// Domain-specific waterfall stage algebra. A Stage is intentionally not a
// generic effect interface: its observable contract is Goal -> Computation.
// Stages request only the proof environment capability they require.

import:
  rhombus/hol/term open
  rhombus/hol/prover/goal open
  rhombus/hol/effect/core open
  rhombus/hol/effect/syntax open
  rhombus/hol/prover/tactic/simp open
  rhombus/hol/prover/tactic/destruct open
  rhombus/hol/prover/tactic/fertilize open
  rhombus/hol/prover/tactic/general open
  rhombus/hol/datatype/datatype open
  rhombus/hol/prover/tactic/irrelevance open
  rhombus/hol/prover/tactic/induct open
  rhombus/hol/prover/context open

export:
  Stage
  standard_stages
  induction_stage
  run_stage
  first_success

class Stage(name :: Symbol, apply :: Function)

fun simplify_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let env :: ProofEnv <- ProofEnv.ask()
      simplify_goal(env.base.thy, env.db, goal)
  Stage(#'simplify, apply)

fun eliminate_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let env :: ProofEnv <- ProofEnv.ask()
      return eliminate_goal(env.base.thy, env.base.dts, goal)
  Stage(#'eliminate, apply)

fun fertilize_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let env :: ProofEnv <- ProofEnv.ask()
      return fertilize_goal(env.base.thy, goal)
  Stage(#'fertilize, apply)

fun generalize_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let env :: ProofEnv <- ProofEnv.ask()
      return generalize_goal(env.base.thy, env.db, env.base.ctors, goal)
  Stage(#'generalize, apply)

fun irrelevance_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    return eliminate_irrelevance_goal(goal)
  Stage(#'irrelevance, apply)

fun induction_stage(hint :: maybe(FVar)) :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let env :: ProofEnv <- ProofEnv.ask()
      let candidates = (cond
                        | hint: [hint]
                        | ~else: candidate_vars(env.base.funs, env.base.dts, goal))
      recur choose (remaining :~ List = candidates):
        match remaining
        | []: return #false
        | List.cons(variable, rest):
            let variable :~ FVar = variable
            match inductive_type_name(variable)
            | #false: choose(rest)
            | type_name:
                match env.base.dts.get(type_name, #false)
                | #false: choose(rest)
                | datatype_thms:
                    return induction_step(env.base.thy,
                                          datatype_thms :~ DatatypeThms,
                                          variable, goal)
  Stage(#'induct, apply)

fun standard_stages() :: List.of(Stage):
  [simplify_stage(), eliminate_stage(), fertilize_stage(), generalize_stage(),
   irrelevance_stage()]

fun run_stage(stage :: Stage, goal :: Goal) :: Computation:
  stage.apply(goal)

fun first_success(stages :: List.of(Stage), goal :: Goal) :: Computation:
  effect:
    let policy :: SearchPolicy <- SearchPolicy.ask()
    recur loop (remaining :~ List = stages):
      match remaining
      | []: return #false
      | List.cons(candidate, rest):
          let candidate :~ Stage = candidate
          cond
          | policy.skipped_stages.contains(candidate.name): loop(rest)
          | ~else:
              effect:
                let result <- run_stage(candidate, goal)
                match result
                | #false: loop(rest)
                | step: return step
