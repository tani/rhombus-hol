#lang rhombus/static

// Domain-specific waterfall stage algebra. A Stage is intentionally not a
// generic effect interface: its observable contract is Goal -> maybe(Step).
// Reader supplies the lexically scoped ProofContext while a handler runs a stage.

import:
  rhombus/hol/term open
  rhombus/hol/prover/goal open
  rhombus/hol/effect/core open
  rhombus/hol/effect/syntax open
  rhombus/hol/effect/reader open
  rhombus/hol/prover/tactic/simp open
  rhombus/hol/prover/tactic/destruct open
  rhombus/hol/prover/tactic/fertilize open
  rhombus/hol/prover/tactic/general open
  rhombus/hol/datatype/datatype open
  rhombus/hol/prover/tactic/irrelevance open
  rhombus/hol/prover/tactic/induct open
  rhombus/hol/prover/context open

export:
  Stage
  standard_stages
  induction_stage
  run_stage
  first_success

class Stage(name :: Symbol, apply :: Function)

fun simplify_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let ctx :: ProofContext <- ask()
      return simplify_goal(ctx.base.thy, ctx.db, goal)
  Stage(#'simplify, apply)

fun eliminate_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let ctx :: ProofContext <- ask()
      return eliminate_goal(ctx.base.thy, ctx.base.dts, goal)
  Stage(#'eliminate, apply)

fun fertilize_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let ctx :: ProofContext <- ask()
      return fertilize_goal(ctx.base.thy, goal)
  Stage(#'fertilize, apply)

fun generalize_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let ctx :: ProofContext <- ask()
      return generalize_goal(ctx.base.thy, ctx.db, ctx.base.ctors, goal)
  Stage(#'generalize, apply)

fun irrelevance_stage() :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let _ctx :: ProofContext <- ask()
      return eliminate_irrelevance_goal(goal)
  Stage(#'irrelevance, apply)

fun induction_stage(hint :: maybe(FVar)) :: Stage:
  fun apply(goal :: Goal) :: Computation:
    effect:
      let ctx :: ProofContext <- ask()
      let candidates = (cond
                        | hint: [hint]
                        | ~else: candidate_vars(ctx.base.funs, ctx.base.dts, goal))
      recur choose (remaining :~ List = candidates):
        match remaining
        | []: return #false
        | List.cons(variable, rest):
            let variable :~ FVar = variable
            match inductive_type_name(variable)
            | #false: choose(rest)
            | type_name:
                match ctx.base.dts.get(type_name, #false)
                | #false: choose(rest)
                | datatype_thms:
                    return induction_step(ctx.base.thy,
                                          datatype_thms :~ DatatypeThms,
                                          variable, goal)
  Stage(#'induct, apply)

fun standard_stages() :: List.of(Stage):
  [simplify_stage(), eliminate_stage(), fertilize_stage(), generalize_stage(),
   irrelevance_stage()]

fun run_stage(ctx :: ProofContext, stage :: Stage, goal :: Goal) :: maybe(Step):
  match run_reader(stage.apply(goal), ctx)
  | Pure(result): result
  | ~else: error(~who: #'run_stage, "internal error: unhandled effect")

fun first_success(ctx :: ProofContext,
                  stages :: List.of(Stage), goal :: Goal) :: maybe(Step):
  recur loop (remaining :~ List = stages):
    match remaining
    | []: #false
    | List.cons(candidate, rest):
        let candidate :~ Stage = candidate
        cond
        | ctx.skipped_stages.contains(candidate.name): loop(rest)
        | ~else:
            match run_stage(ctx, candidate, goal)
            | #false: loop(rest)
            | step: step
