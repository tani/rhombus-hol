#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// ACL2 generalization is a design reference; see THIRD_PARTY_NOTICES.


// The waterfall's third stage: generalization.
//
// Replace a non-variable subterm that occurs more than once by a fresh
// variable.  The point is not to make the goal easier to read: it is to make
// induction *possible*.  A goal like
//
//     plus(size(y), succ(size(z))) === succ(plus(size(y), size(z)))
//
// has nothing to induct on -- `y` and `z` are of tree type, and inducting on
// them just makes the same shape one level deeper.  Generalize `size(y)` and
// `size(z)` to fresh naturals and the goal becomes an arithmetic fact that
// induction settles at once.
//
// The step is sound by construction, and runs backwards: from `|- C[y]` with
// `y` fresh, `SPEC(t, GEN(y, ...))` gives `|- C[t]`.  Its only risk is
// *incompleteness* -- over-generalizing turns a provable goal into an
// unprovable one, which shows up as a residue, never as a wrong theorem.
// That asymmetry is why an aggressive heuristic is acceptable here.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/logic/drule open
  rhombus/hol/logic/ruledb open
  rhombus/hol/prover/goal open
  rhombus/hol/prover/trace open

export:
  generalize_goal
  generalization_candidates

// Replace every occurrence of `old` by `new`.
//
// Occurrences under a binder are left alone: such a subterm may mention the
// bound variable, and lifting it out would change what it means.
fun replace_subterm(old :: Term, new :: Term, t :: Term) :: Term:
  cond
  | t == old: new
  | ~else:
      match t
      | Comb(f, x):
          let f2 = replace_subterm(old, new, f)
          let x2 = replace_subterm(old, new, x)
          (if f2 === f && x2 === x | t | mk_comb(f2, x2))
      | ~else: t

// Structural equality for a `Term` recursively hashes the whole tree. Using
// terms themselves as keys therefore makes a chain of nested applications
// quadratic before the candidate analysis even begins. Assign a canonical
// integer to each distinct term shape once; every count and dependency lookup
// below is then over small integers.
fun generalization_candidates(ctors :: Set.of(Symbol),
                              g :: Goal) :: List.of(Term):
  let by_identity = WeakMutableMap.by(===)()
  let canonical = MutableMap()
  let next_id = Box(0)

  fun term_id(t :: Term) :: Int:
    match by_identity.get(t, #false)
    | id :: Int: id
    | #false:
        let key:
          match t
          | FVar(n, ty): [#'fvar, n, ty]
          | BVar(i, ty): [#'bvar, i, ty]
          | Const(n, ty): [#'const, n, ty]
          | NatLit(value): [#'natlit, value]
          | Comb(f, x): [#'comb, term_id(f), term_id(x)]
          | Abs(ty, b): [#'abs, ty, term_id(b)]
        let id :~ Int:
          match canonical.get(key, #false)
          | found :: Int: found
          | #false:
              let fresh = next_id.value :~ Int
              next_id.value := fresh + 1
              canonical.set(key, fresh)
              fresh
        by_identity.set(t, id)
        id

  let parts = g.asms ++ [g.concl]
  let counts = MutableMap()
  fun count_occurrences(t :: Term) :: Void:
    let id = term_id(t)
    let old :~ Int = counts.get(id, 0)
    counts.set(id, old + 1)
    match t
    | Comb(f, x):
        count_occurrences(f)
        count_occurrences(x)
    | ~else: #void
  for (part in parts): count_occurrences(part :~ Term)

  // Candidate collection follows application arguments, not partial function
  // spines, preserving the old first-occurrence ordering.
  let concl_id = term_id(g.concl)
  let seen = MutableMap()
  let representatives = MutableMap()
  let ordered_rev = Box([])
  fun collect(t :: Term) :: Void:
    let id = term_id(t)
    let (head, args) = strip_comb(t)
    let eligible:
      cond
      | !(t is_a Comb): #false
      | id == concl_id: #false
      | is_fun(type_of(t)): #false
      | ~else:
          match head
          | Const(n, _): !(n in ctors) && n != c_eq
          | ~else: #false
    when eligible && !seen.get(id, #false)
    | seen.set(id, #true)
      representatives.set(id, t)
      ordered_rev.value := List.cons(id, ordered_rev.value :~ List)
    for (arg in args): collect(arg :~ Term)
  for (part in parts): collect(part :~ Term)
  let ordered = (ordered_rev.value :~ List).reverse()
  fun repeated(id) :: Boolean:
    let n :~ Int = counts.get(id, 0)
    n >= 2
  let counted = ordered.filter(~keep: repeated)

  // Mark a counted candidate when it occurs below another counted candidate.
  // A raw walk is required: a candidate can occur in a function position even
  // though partial application spines are not themselves collected.
  let counted_set = MutableMap()
  for (id in counted): counted_set.set(id, #true)
  let dominated = MutableMap()
  fun mark_dominated(t :: Term, inside :: Boolean) :: Void:
    let id = term_id(t)
    let candidate :~ Boolean = counted_set.get(id, #false)
    when inside && candidate
    | dominated.set(id, #true)
    let inside2 = inside || candidate
    match t
    | Comb(f, x):
        mark_dominated(f, inside2)
        mark_dominated(x, inside2)
    | ~else: #void
  for (part in parts): mark_dominated(part :~ Term, #false)

  fun maximal(id) :: Boolean: !dominated.get(id, #false)
  fun representative(id) :: Term: representatives.get(id) :~ Term
  counted.filter(~keep: maximal).map(representative)

// The first type-prescription fact about `t`'s head function that
// instantiates cleanly at `t`'s actual arguments, as a theorem `|- Q(t)` --
// or `#false` if there is none, or none instantiates (a fact whose argument
// is not exactly its own pattern variables, e.g. `Q(f(g(x)))` rather than
// `Q(f(x))`, is skipped rather than forced; that only means fewer facts are
// used, never a wrong one).
fun type_fact_at(thy :: Theory, db :: RuleDB, t :: Term) :: maybe(Thm):
  match t
  | Comb(_, _):
      let (thead, actual_args) = strip_comb(t)
      match thead
      | Const(n, _):
          recur loop (facts :~ List = type_facts_of(db, n)):
            match facts
            | []: #false
            | List.cons(fact, rest):
                match instantiate_type_fact(thy, fact :~ Thm, thead, actual_args)
                | #false: loop(rest)
                | inst: inst
      | ~else: #false
  | ~else: #false

fun instantiate_type_fact(thy :: Theory, fact :: Thm, thead :: Term,
                          actual_args :: List.of(Term)) :: maybe(Thm):
  let (pvars, spec) = spec_all_vars(thy, fact)
  match concl_of(spec)
  | Comb(_, arg):
      let (fhead, schema_args) = strip_comb(arg)
      cond
      | fhead != thead: #false
      | schema_args.length() != actual_args.length(): #false
      | !(for all (sa in schema_args): sa is_a FVar && pvars.contains(sa :~ FVar)):
          #false
      | ~else:
          let theta = for List (sa in schema_args, aa in actual_args): [aa, sa]
          INST(thy, theta, spec)
  | ~else: #false

fun generalize_goal(thy :: Theory, db :: RuleDB, ctors :: Set.of(Symbol),
                    g :: Goal) :: maybe(Step):
  match generalization_candidates(ctors, g)
  | []: #false
  | List.cons(t, _):
      let t :~ Term = t
      let avoid = g.asms ++ [g.concl]
      let y = variant(avoid, mk_var(#'g, type_of(t)))
      // A type-prescription fact about `t`, restated for `y`: what the
      // waterfall would otherwise lose in generalizing `t` away -- ACL2's
      // reason for consulting type-prescription rules during generalization
      // in the first place.
      let type_fact = type_fact_at(thy, db, t)
      let type_hyp = (match type_fact
                      | #false: #false
                      | tf: replace_subterm(t, y, concl_of(tf :~ Thm)))
      let asms2 = g.asms.map(fun (a): replace_subterm(t, y, a))
                    ++ (match type_hyp | #false: [] | h: [h :~ Term])
      let concl2 = replace_subterm(t, y, g.concl)
      let sub = Goal(asms2, concl2)
      let event = Generalized(t, y.name)
      // Discharge the assumptions before generalizing, so that the fresh
      // variable is not free in any hypothesis, then put them back afterwards.
      fun justify(ths :: List.of(Thm)) :: Thm:
        let discharged = for values(acc :~ Thm = ths[0]) (a in asms2.reverse()):
                           DISCH(thy, a, acc)
        let specialised = SPEC(thy, t, GEN(thy, y, discharged))
        let after_asms = for values(acc :~ Thm = specialised) (a in g.asms):
                           MP(thy, acc, ASSUME(thy, a))
        (match type_fact
         | #false: after_asms
         | tf: MP(thy, after_asms, tf :~ Thm))
      Step([sub], justify, [event])
