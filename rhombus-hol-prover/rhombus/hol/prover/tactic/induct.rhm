#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// ACL2's waterfall is a design reference; see THIRD_PARTY_NOTICES.


// The waterfall's last stage: structural, rule, and well-founded induction.
//
// Every case this module builds is one `InductionScheme` value
// (`prover/induction/scheme.rhm`), instantiated at a predicate and
// beta-reduced, then reconstructed by ordinary derived rules
// (`GEN`/`GENL`/`DISCH`/`MP`/`SPEC`). None of that theorem is re-derived or
// approximated here: a scheme is either kernel evidence a proof can
// instantiate, or this module does not touch it. What *does* live here is
// every heuristic about which evidence to try first -- ranking candidate
// variables, scoring recursive companions, matching an assumption's shape --
// kept in a tactic-local `Candidate` record precisely so a `Step`'s
// justification never depends on how it was chosen.
//
// Three scheme shapes are consumed automatically:
//
//   * `DatatypeScheme` -- a declared datatype's own case-based induction
//     axiom. The predicate is `\v. concl`, with the goal's *other* free
//     variables left free. That gives the induction hypothesis exactly the
//     shape the simplifier wants -- an equation about the immediate subterm,
//     in the same context.
//
//   * `RuleScheme` -- a single declared inductive predicate's induction
//     theorem, triggered when that predicate appears in the goal's
//     assumptions applied to distinct free variables. The matched membership
//     fixes the theorem's concrete type instance; mutual-family schemes remain
//     registered but require an explicit simultaneous property and are not
//     guessed here.
//
//   * `FunctionScheme` -- the generic well-founded induction theorem,
//     specialized at a recursive function's concrete relation. It reduces to
//     one subgoal: the theorem's strong-step premise, opened once.
//
// A `WellFoundedScheme` remains registered evidence for the named relation;
// this automatic tactic does not guess that a relation occurrence calls for
// strong induction. A `FunctionScheme` is selected only for a genuinely unary
// function, when it is the sole applicable function scheme for the candidate
// variable, the relation's domain matches it, and that relation is not already
// present in the assumptions. Multi-argument functions remain registered
// evidence whose tuple carrier has no corresponding single goal variable.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/logic/conv open
  rhombus/hol/logic/drule open
  rhombus/hol/datatype/datatype open
  rhombus/hol/recursion/recdef open
  rhombus/hol/prover/induction/scheme open
  rhombus/hol/prover/proof/node open
  rhombus/hol/prover/trace open

export:
  induction_step
  induction_attempt
  candidate_vars
  inductive_type_name

// The datatype a variable ranges over, or `#false` if it is not of one.
fun inductive_type_name(v :: FVar) :: maybe(Symbol):
  match v.ty
  | TyApp(n, _): n
  | ~else: #false

// Split a conjunction that `conj_all` built by folding left, into exactly `n`
// parts.
//
// `strip_conj` is the wrong tool here: a *case* can itself be a conjunction --
// the goal `f(xs) === a and g(xs) === b` has a conjunctive base case -- and
// flattening would then hand back more parts than there are constructors, each
// mis-associated with the wrong case.
fun split_cases(t :: Term, n :: Int) :: List.of(Term):
  cond
  | n <= 1: [t]
  | ~else:
      match dest_conj(t)
      | [l, r]: split_cases(l, n - 1) ++ [r]
      | ~else:
          error(~who: #'induct, "malformed induction scheme",
                error.val(~label: "term", show(t)))


// The public entry point preserves the original datatype-only API. The
// waterfall adapter below supplies the registered DatatypeScheme theorem
// instead, so the same case construction consumes the shared scheme interface.
fun induction_step(thy :: Theory, funs :: Map.of(Symbol, FunInfo),
                   dtms :: DatatypeThms, v :: FVar,
                   g :: Goal) :: Step:
  datatype_induction_step(thy, funs, dtms, dtms.induction, v, g)

fun datatype_induction_step(thy :: Theory, funs :: Map.of(Symbol, FunInfo),
                            dtms :: DatatypeThms, theorem :: Thm,
                            v :: FVar, g :: Goal) :: Step:
  let spec = dtms.spec
  let self = mk_tyapp(spec.name, spec.params.map(fun (p :: Symbol): mk_tyvar(p)))
  let tyin = (match type_match(self, v.ty, {})
              | #false:
                  error(~who: #'induct,
                        "variable is not of the datatype being inducted on",
                        error.val(~label: "variable", show_typed(v)),
                        error.val(~label: "datatype", spec.name))
              | m: m)
  let ax = INST_TYPE(thy, tyin, theorem)
  // The induction hypothesis is about the goal's *other* variables too.
  //
  // Inducting on `v` with everything else held fixed gives a hypothesis at a
  // subterm of `v` and the same other arguments, which is not enough for any
  // fact whose proof has to descend two of them at once -- the whole order
  // theory of a comparison defined by recursion on both sides. Quantifying
  // them into the predicate gives the hypothesis at every instance instead.
  //
  // Only a variable that some recursive function reads *alongside* `v`,
  // though. That is the case the strengthening is for, and a goal like
  // `m === n` has no such pair: generalizing there would put each variable
  // back under a quantifier for the other's induction to open, and the two
  // would take turns forever.
  //
  // A variable free in a hypothesis stays fixed: the hypothesis constrains
  // that one particular value, so generalizing it would be claiming more
  // than the goal does. `SPECL` below puts the quantifiers back, so the step
  // still proves exactly the goal it was given.
  let assumed = for values(acc :~ List = []) (a in g.asms):
                  acc ++ free_vars(a :~ Term)
  let companions = recursive_companions(funs, g.concl, v)
  let others = free_vars(g.concl).filter(
                 ~keep: fun (u :: FVar):
                          u != v && !assumed.contains(u :~ Term)
                            && companions.contains(u :~ Term))
  let pred = mk_abs(v, mk_forall_list(others, g.concl))
  let sp = BETA_RULE(thy, SPEC(thy, pred, ax))
  let [cases_term, _] = (match dest_imp(concl_of(sp))
                         | #false:
                             error(~who: #'induct, "malformed induction scheme")
                         | pair: pair)
  let case_terms = split_cases(cases_term, spec.ctors.length())

  // Turn each case into a goal. The scheme's predicate quantifies recursive
  // companion variables, so open those quantifiers here and remember how to
  // close them. This keeps specialization local to the induction step while
  // still letting the ordinary waterfall simplify each opened case before it
  // considers another induction.
  let avoid0 = g.asms ++ [g.concl]
  let prepared = for List (ct in case_terms, c in spec.ctors):
                   let (case_vars, body0) = open_foralls(ct, avoid0)
                   let (ihs, body1) = strip_imp(body0)
                   let (companion_vars, body):
                     open_foralls(body1, avoid0 ++ case_vars ++ ihs)
                   [case_vars, ihs, companion_vars, body,
                    (c :~ Ctor).name]
  let subgoals = for List ([_, ihs, _, body, _] in prepared):
                   Goal(g.asms ++ (ihs :~ List), body)
  let events = for List ([_, _, _, _, cname] in prepared):
                 Inducted(v.name, cname :~ Symbol)

  fun close_case(th :: Thm, case_vars :~ List, ihs :~ List,
                 companion_vars :~ List) :: Thm:
    let specialized = GENL(thy, companion_vars, th)
    let discharged = for values(acc :~ Thm = specialized) (ih in ihs.reverse()):
                       DISCH(thy, ih, acc)
    GENL(thy, case_vars, discharged)

  fun rebuild_induction(ths :: List.of(Thm)) :: Thm:
    let case_thms = for List (th in ths, pr in prepared):
                      close_case(th, (pr :~ List)[0], (pr :~ List)[1],
                                 (pr :~ List)[2])
    SPECL(thy, others.map(fun (u :: FVar): u :~ Term),
          SPEC(thy, v, MP(thy, sp, LIST_CONJ(thy, case_thms))))
  Step(subgoals, rebuild_induction, events)


// -- rule induction -----------------------------------------------------------
//
// A single-predicate `RuleScheme` theorem is
// `!P. R_1[P] ==> ... ==> R_k[P] ==> !x. p x ==> P x`. The matched
// membership fixes its concrete type instance; `P` becomes an abstraction
// over the goal's conclusion, and each `R_i[P]` becomes one ordinary
// waterfall subgoal.
//
// Mutual-family schemes remain registered evidence, but automatic selection
// does not guess a simultaneous property for their sibling predicates.

// Discharge `terms` onto `th` innermost first, so re-quantifying with
// `GENL` afterwards reconstructs exactly the implication chain they were
// peeled from.
fun discharge_terms(thy :: Theory, terms :: List, th :: Thm) :: Thm:
  for values(acc :~ Thm = th) (term in (terms :~ List).reverse()):
    DISCH(thy, term :~ Term, acc)

// Peel a right-nested implication chain `R_1 ==> (R_2 ==> ( ... ==> tail))`
// into its antecedents, in order, and the non-implication tail. Every
// `RuleScheme`/well-founded theorem here has exactly this shape once its
// predicate variables are specialized: each antecedent is one rule (or, for
// the well-founded schemes, the strong-step premise), and the tail's own top
// connective is a quantifier, not `==>`, so the walk stops there on its own
// -- no separate count of "how many rules" is needed.
fun peel_chain(t :: Term) :: values(List.of(Term), Term):
  recur loop (t = t, acc :~ List = []):
    match dest_imp(t)
    | [a, rest]: loop(rest :~ Term, acc ++ [a :~ Term])
    | ~else: values(acc, t)

fun all_distinct(vs :: List.of(FVar)) :: Boolean:
  recur loop (remaining :~ List = vs, seen :~ List = []):
    match remaining
    | []: #true
    | List.cons(v, rest):
        (if seen.contains(v :~ Term)
         | #false
         | loop(rest, List.cons(v :~ Term, seen)))

// An assumption applying `target` to exactly its own arity, all distinct
// free variables that still occur in the conclusion -- the shape rule
// induction needs to generalize the goal's property. A composite argument, a
// repeated variable, or a stale membership carried into a closure child
// cannot define that property, so the search continues past it.
fun find_rule_match(target :: Symbol, asms :: List.of(Term),
                    conclusion :: Term) :: maybe(List):
  let conclusion_vars = free_vars(conclusion)
  recur loop (remaining :~ List = asms):
    match remaining
    | []: #false
    | List.cons(a, rest):
        let (head, args) = strip_comb(a :~ Term)
        match head
        | Const(n, _) when n == target:
            let is_fvars = for all (arg in args):
                             (match arg :~ Term
                              | FVar(_, _): #true
                              | ~else: #false)
            cond
            | !is_fvars: loop(rest)
            | ~else:
                let vs = args.map(fun (t :: Term): t :~ FVar)
                let relevant = for any (v in vs):
                                 conclusion_vars.contains(v :~ Term)
                (if all_distinct(vs) && relevant
                 | [a, vs]
                 | loop(rest))
        | ~else: loop(rest)

fun family_index(names :: List.of(Symbol), target :: Symbol) :: Int:
  recur loop (remaining :~ List = names, i = 0):
    match remaining
    | List.cons(n, rest): (if (n :~ Symbol) == target | i | loop(rest, i + 1))
    | []:
        error(~who: #'induct, "rule scheme target is not a family member",
              error.val(~label: "target", target))

fun rule_induction_step(thy :: Theory, predicate_names :: List.of(Symbol),
                        target :: Symbol, theorem :: Thm,
                        g :: Goal) :: maybe(Step):
  cond
  | predicate_names.length() != 1: #false
  | ~else:
      match find_rule_match(target, g.asms, g.concl)
      | #false: #false
      | [membership, vs]:
          let membership :~ Term = membership
          let vs :~ List.of(FVar) = vs
          let target_index = family_index(predicate_names, target)
          let (generic_pvars, _) = strip_forall(concl_of(theorem))
          let (matched_predicate, _) = strip_comb(membership)
          match type_match((generic_pvars[target_index] :~ FVar).ty,
                           type_of(matched_predicate), {})
          | #false: #false
          | tyin:
              let theorem = INST_TYPE(thy, tyin :~ Map, theorem)
              let (pvars, _) = strip_forall(concl_of(theorem))
              let abstraction = list_mk_abs(vs, g.concl)
              let replacement = for List (
                    name in predicate_names,
                    i in List.iota(predicate_names.length())):
                  (if i == target_index
                   | abstraction
                   | mk_const(name :~ Symbol, (pvars[i] :~ FVar).ty))
              let spec_thm = BETA_RULE(
                               thy, SPECL(thy, replacement, theorem))
              let (rule_terms, _final) = peel_chain(concl_of(spec_thm))
              let arg_terms = vs.map(fun (v :: FVar): v :~ Term)
              let avoid = g.asms ++ [g.concl] ++ arg_terms
              // Open each rule closure -- its own leading quantifiers, then
              // its premises -- into one waterfall-friendly subgoal.
              let prepared = for List (
                    rt in rule_terms,
                    idx in List.iota(rule_terms.length())):
                  let (case_vars, body0) = open_foralls(rt :~ Term, avoid)
                  let (premises, body) = strip_imp(body0)
                  [case_vars, premises, body, idx]
              let subgoals = for List ([_, premises, body, _] in prepared):
                               Goal(g.asms ++ (premises :~ List),
                                    body :~ Term)
              let events = for List ([_, _, _, idx] in prepared):
                             Inducted(
                               target,
                               Symbol.from_string(
                                 "rule" ++ to_string(idx :~ Int)))
              fun close_case(th :: Thm, case_vars :~ List,
                             premises :~ List) :: Thm:
                GENL(thy, case_vars, discharge_terms(thy, premises, th))
              fun rebuild(ths :: List.of(Thm)) :: Thm:
                let case_thms = for List (th in ths, pr in prepared):
                                  close_case(
                                    th, (pr :~ List)[0], (pr :~ List)[1])
                let chained = for values(acc :~ Thm = spec_thm) (
                      case_th in case_thms):
                    MP(thy, acc, case_th)
                BETA_RULE(
                  thy,
                  MP(thy, SPECL(thy, arg_terms, chained),
                     ASSUME(thy, membership)))
              Step(subgoals, rebuild, events)


// -- well-founded and function induction --------------------------------------
//
// `theorem` is `!P. (!x. (!y. relation y x ==> P y) ==> P x) ==> !x. P x`
// (`recursion/wellfounded.rhm`'s `prove_wf_induction`, specialized at
// `relation`). Inducting on `v` at this scheme opens the strong-step premise
// into exactly one subgoal -- an assumption of the hypothesis at a fresh `x`,
// proving the goal's conclusion generalized over `v` at that `x` -- and
// reconstructs the goal at `v` itself by GEN/DISCH/MP/SPEC against the
// theorem. There is no companion generalization here: both schemes that
// reach this constructor gate on a single candidate variable.
fun well_founded_step(thy :: Theory, theorem :: Thm, v :: FVar, g :: Goal,
                      event :: TraceEvent) :: Step:
  let pred = mk_abs(v, g.concl)
  let sp = BETA_RULE(thy, SPEC(thy, pred, theorem))
  let [premise, _] = (match dest_imp(concl_of(sp))
                      | #false:
                          error(~who: #'induct,
                                "malformed well-founded induction scheme")
                      | pair: pair)
  let avoid = g.asms ++ [g.concl, v :~ Term]
  let (case_vars, body0) = open_foralls(premise, avoid)
  let (ihs, body) = strip_imp(body0)
  let subgoal = Goal(g.asms ++ ihs, body)
  fun rebuild(ths :: List.of(Thm)) :: Thm:
    let closed = GENL(thy, case_vars, discharge_terms(thy, ihs, ths[0]))
    SPEC(thy, v, MP(thy, sp, closed))
  Step([subgoal], rebuild, [event])

fun relation_domain(relation :: Term) :: HType:
  let (dom, _) = dest_fun(type_of(relation))
  dom

// The concrete instance at which `fn` is applied directly to `v`, if any.
// Matching types rather than comparing typed constants lets one registered
// polymorphic scheme serve each concrete use of the function.
fun applied_type_substitution(fn :: Term, t :: Term, v :: FVar)
     :: maybe(Map.of(Symbol, HType)):
  recur walk (t = t):
    let (head, args) = strip_comb(t)
    let here:
      cond
      | args.length() != 1 || args[0] != (v :~ Term): #false
      | ~else:
          match type_match(type_of(fn), type_of(head), {})
          | tyin :: Map when inst_type(tyin, fn) == head: tyin
          | ~else: #false
    match here
    | tyin :: Map: tyin
    | #false:
        match t
        | Comb(f, x):
            match walk(f)
            | tyin :: Map: tyin
            | #false: walk(x)
        | Abs(_, b): walk(b)
        | ~else: #false

fun relation_occurs(relation :: Term, t :: Term) :: Boolean:
  recur walk (t = t):
    let (head, _) = strip_comb(t)
    head == relation
      || (match t
          | Comb(f, x): walk(f) || walk(x)
          | Abs(_, b): walk(b)
          | ~else: #false)

// A `FunctionScheme` only fires for a unary recorded function at a matching
// concrete type instance. If its relation is already present in the goal's
// assumptions, this is the strong-step child produced by the same scheme;
// falling back to datatype induction makes structural progress instead of
// selecting the same strong induction forever.
fun function_scheme_instance(funs :: Map.of(Symbol, FunInfo), name :: Symbol,
                             relation :: Term, v :: FVar, g :: Goal)
     :: maybe(Map.of(Symbol, HType)):
  match funs.get(name, #false)
  | #false: #false
  | fi:
      let fi :~ FunInfo = fi
      cond
      | fi.spec.arg_types.length() != 1: #false
      | ~else:
          match applied_type_substitution(fi.fn, g.concl, v)
          | #false: #false
          | tyin:
              let tyin :~ Map = tyin
              let concrete_relation = inst_type(tyin, relation)
              let already_used = for any (a in g.asms):
                                   relation_occurs(
                                     concrete_relation, a :~ Term)
              (if relation_domain(concrete_relation) != v.ty || already_used
               | #false
               | tyin)

fun function_step_for(thy :: Theory, funs :: Map.of(Symbol, FunInfo),
                      schemes :: List.of(InductionScheme), v :: FVar,
                      g :: Goal) :: maybe(Step):
  // More than one matching function gives no principled choice. In
  // particular, an equality between two recursive functions must retain the
  // ordinary datatype decomposition that can simplify both sides.
  recur find_unique (remaining :~ List = schemes,
                     found :~ maybe(Thm) = #false):
    match remaining
    | []:
        match found
        | theorem :: Thm:
            well_founded_step(thy, theorem, v, g,
                              Inducted(v.name, #'function))
        | ~else: #false
    | List.cons(scheme, rest):
        match scheme :~ InductionScheme
        | FunctionScheme(name, _, relation, theorem):
            match function_scheme_instance(
                    funs, name :~ Symbol, relation :~ Term, v, g)
            | #false: find_unique(rest, found)
            | tyin:
                (if found == #false
                 | find_unique(
                     rest, INST_TYPE(thy, tyin :~ Map, theorem :~ Thm))
                 | #false)
        | ~else: find_unique(rest, found)


// -- candidate selection -------------------------------------------------------

fun datatype_scheme_theorem(schemes :: List.of(InductionScheme),
                            type_name :: Symbol,
                            fallback :: Thm) :: Thm:
  recur loop (remaining :~ List = schemes):
    match remaining
    | []: fallback
    | List.cons(scheme, rest):
        match scheme :~ InductionScheme
        | DatatypeScheme(name, theorem) when name == type_name: theorem
        | ~else: loop(rest)

fun datatype_step_for(thy :: Theory, funs :: Map.of(Symbol, FunInfo),
                      dts :: Map.of(Symbol, DatatypeThms),
                      schemes :: List.of(InductionScheme), v :: FVar,
                      g :: Goal) :: maybe(Step):
  match inductive_type_name(v)
  | #false: #false
  | type_name:
      match dts.get(type_name, #false)
      | #false: #false
      | datatype_thms:
          let dtms :~ DatatypeThms = datatype_thms
          datatype_induction_step(
            thy, funs, dtms,
            datatype_scheme_theorem(schemes, type_name, dtms.induction),
            v, g)

// One variable's step: an applicable function scheme when one exists, the
// datatype scheme otherwise. Raw well-founded schemes remain registered
// evidence but are not guessed from a relation occurrence: doing so changes
// termination obligations into repeated strong inductions instead of the
// datatype cases that discharge them.
fun step_for_variable(thy :: Theory, funs :: Map.of(Symbol, FunInfo),
                      dts :: Map.of(Symbol, DatatypeThms),
                      schemes :: List.of(InductionScheme), v :: FVar,
                      g :: Goal) :: maybe(Step):
  match function_step_for(thy, funs, schemes, v, g)
  | step :: Step: step
  | #false: datatype_step_for(thy, funs, dts, schemes, v, g)

fun best_rule_step(thy :: Theory, schemes :: List.of(InductionScheme),
                   g :: Goal) :: maybe(Step):
  // Registration order is not a proof-search rank. If two independent rule
  // schemes match the assumptions, retain the datatype fallback rather than
  // commit to one arbitrary declaration.
  recur find_unique (remaining :~ List = schemes,
                     found :~ maybe(Step) = #false):
    match remaining
    | []: found
    | List.cons(scheme, rest):
        match scheme :~ InductionScheme
        | RuleScheme(predicate_names, target, theorem):
            match rule_induction_step(thy,
                                      predicate_names :~ List.of(Symbol),
                                      target :~ Symbol, theorem :~ Thm, g)
            | #false: find_unique(rest, found)
            | step :: Step:
                (if found == #false
                 | find_unique(rest, step)
                 | #false)
        | ~else: find_unique(rest, found)

// Free variables of the goal that could be inducted on via the datatype
// scheme, best first, together with the heuristic tuple `gather_candidates`
// ranks by.
//
// A variable scores two points for each recursive function applied to it at
// an induction position, and one for each applied to it anywhere else. The
// second case matters for a function that recurses on both arguments: a
// variable that only ever appears as the *other* argument still has to be
// inducted on eventually, and scoring it zero left it behind whichever
// predecessor variable an earlier induction had introduced. The termination
// plan keeps these heuristic positions distinct from its minimal
// well-founded order.
fun scored_datatype_vars(funs :: Map.of(Symbol, FunInfo),
                         dts :: Map.of(Symbol, DatatypeThms),
                         g :: Goal) :: List.of(List):
  let vars = free_vars(g.concl).filter(
    ~keep: fun (v :: FVar):
             match inductive_type_name(v)
             | #false: #false
             | n: dts.get(n, #false) != #false)
  // An assumption is carried into each case unchanged, so it still speaks
  // about the variable's old value while the conclusion speaks about `zero`
  // and `succ x`: inducting on a variable an assumption mentions throws that
  // assumption away. Where there is a choice, take a variable that no
  // assumption mentions -- typically the one an earlier induction left
  // behind, rather than the predecessor it introduced.
  let assumed = for values(acc :~ List = []) (a in g.asms):
                  acc ++ free_vars(a :~ Term)
  // A variable already sitting under a constructor is a poor choice: the
  // scheme replaces it by `zero` and `succ x`, and the occurrence only grows
  // to `succ(succ x)` -- nothing there simplifies. It is usually the variable
  // an earlier induction introduced. Between two otherwise equal candidates,
  // take the one that occurs bare everywhere.
  let ctors = all_ctor_names(dts)
  let scored = for List (v in vars):
                 [v,
                  (if assumed.contains(v :~ Term) | 0 | 1),
                  score(funs, g.concl, v :~ FVar),
                  (if under_ctor(ctors, g.concl, v :~ FVar) | 0 | 1)]
  // A variable no recursive function touches is a poor guess, but it is still
  // better than giving up when it is the only one.
  scored.sort(
    fun ([_, free_a, sa, bare_a], [_, free_b, sb, bare_b]):
      cond
      | free_a != free_b: (free_a :~ Int) > (free_b :~ Int)
      | sa != sb: (sa :~ Int) > (sb :~ Int)
      | ~else: (bare_a :~ Int) > (bare_b :~ Int))

fun candidate_vars(funs :: Map.of(Symbol, FunInfo),
                   dts :: Map.of(Symbol, DatatypeThms),
                   g :: Goal) :: List.of(FVar):
  scored_datatype_vars(funs, dts, g).map(fun (row :: List): row[0] :~ FVar)

// A tactic-local pairing of a step's heuristic desirability (`rank`, exactly
// the tuple `candidate_vars` already sorts by) with the kernel evidence that
// justifies it (`step`, built from one `InductionScheme`'s theorem). Ranking
// never reads a scheme, and a scheme never computes a rank: the two meet
// only here, and only to decide *order*, never to decide *soundness*.
class Candidate(rank :: List, step :: Step)

// One `Candidate` per variable `candidate_vars` would offer, in the same
// order, resolved through whichever scheme actually applies to it
// (`step_for_variable`) -- a function scheme when one fires, the datatype
// fallback otherwise. A variable neither covers is dropped.
fun gather_candidates(thy :: Theory, funs :: Map.of(Symbol, FunInfo),
                      dts :: Map.of(Symbol, DatatypeThms),
                      schemes :: List.of(InductionScheme),
                      g :: Goal) :: List.of(Candidate):
  for values(acc :~ List = []) (row in scored_datatype_vars(funs, dts, g)):
    let row :~ List = row
    let v :~ FVar = row[0] :~ FVar
    match step_for_variable(thy, funs, dts, schemes, v, g)
    | #false: acc
    | step :: Step: acc ++ [Candidate([row[1], row[2], row[3]], step)]

// The waterfall's induction attempt.
//
// `hint` forces the variable (`~induct`) through its datatype scheme exactly
// as before this registry existed. It never lets an inferred function or rule
// scheme override the user's explicit decomposition.
//
// Without a hint, an assumption with exactly one matching single-predicate
// `RuleScheme` wins first: it is exact evidence about the goal's own
// hypotheses, not a guess among variables. Failing that, `candidate_vars`
// ranks the goal's free variables exactly as before, and `gather_candidates`
// resolves the highest ranked one that any automatic scheme covers.
fun induction_attempt(thy :: Theory, funs :: Map.of(Symbol, FunInfo),
                      dts :: Map.of(Symbol, DatatypeThms),
                      schemes :: List.of(InductionScheme),
                      hint :: maybe(FVar), g :: Goal) :: maybe(Step):
  match hint
  | v :: FVar: datatype_step_for(thy, funs, dts, schemes, v, g)
  | ~else:
      match best_rule_step(thy, schemes, g)
      | step :: Step: step
      | #false:
          match gather_candidates(thy, funs, dts, schemes, g)
          | []: #false
          | List.cons(top, _): (top :~ Candidate).step

// Does `v` appear as an argument of a constructor application in `t`?
fun under_ctor(ctors :: Set, t :: Term, v :: FVar) :: Boolean:
  recur walk (t = t):
    let (head, args) = strip_comb(t)
    let here:
      match head
      | Const(n, _): ctors.contains(n) && (args :~ List).contains(v :~ Term)
      | ~else: #false
    here
      || (match t
          | Comb(f, x): walk(f) || walk(x)
          | Abs(_, b): walk(b)
          | ~else: #false)

// The variables some recursive function of `t` reads in the same call as `v`.
//
// These are the ones an induction on `v` can be expected to need at a
// different value than the goal's -- `nat_le(a, b)` descends on both -- and
// the only ones worth quantifying into the induction predicate.
fun recursive_companions(funs :: Map.of(Symbol, FunInfo), t :: Term,
                         v :: FVar) :: List.of(Term):
  recur walk (t = t, acc :~ List = []):
    let (head, args) = strip_comb(t)
    let here:
      match head
      | Const(n, _):
          match funs.get(n, #false)
          | #false: acc
          | fi:
              let recursive:
                match (fi :~ FunInfo).induction
                | NonRecursiveInduction(): #false
                | ~else: #true
              let vars = for values(a :~ List = []) (arg in args):
                           a ++ free_vars(arg :~ Term)
              cond
              | recursive && vars.contains(v :~ Term): acc ++ vars
              | ~else: acc
      | ~else: acc
    match t
    | Comb(f, x): walk(x, walk(f, here))
    | Abs(_, b): walk(b, here)
    | ~else: here

fun score(funs :: Map.of(Symbol, FunInfo), t :: Term, v :: FVar) :: Int:
  fun walk(t :: Term, acc :: Int) :: Int:
    let acc2:
      let (head, args) = strip_comb(t)
      match head
      | Const(n, _):
          match funs.get(n, #false)
          | #false: acc
          | fi:
              let fi :~ FunInfo = fi
              let positions :~ List.of(Int):
                match fi.induction
                | RecursiveInduction(ps): ps
                | NonRecursiveInduction(): []
              cond
              | positions == []: acc
              | ~else:
                  for values(a :~ Int = acc) (arg in args,
                                              i in List.iota(args.length())):
                    cond
                    | (arg :~ Term) != v :~ Term: a
                    | positions.contains(i): a + 2
                    | ~else: a + 1
      | ~else: acc
    match t
    | Comb(f, x): walk(x, walk(f, acc2))
    | Abs(_, b): walk(b, acc2)
    | ~else: acc2
  walk(t, 0)
