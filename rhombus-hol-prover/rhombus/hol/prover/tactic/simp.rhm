#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// ACL2's waterfall is a design reference; see THIRD_PARTY_NOTICES.


// The waterfall's first stage: simplification.
//
// Rewrite the conclusion to a normal form with the rule database, with the
// goal's own assumptions thrown in as rules.  If it reaches `true` the goal is
// closed; otherwise the simplified goal replaces the original.
//
// The assumptions are simplified too, and that is not symmetry for its own
// sake.  An assumption is only a rewrite rule for the conclusion, which says
// nothing when the assumption is `not nul(zero)`: as a rule it rewrites the
// phrase `not nul(zero)`, which does not occur.  Reduced, it is `not true`,
// that is `false`, and the goal is closed whatever its conclusion.  Guarded
// recursion produces exactly that shape -- one branch condition per obligation,
// most of them contradictory in most cases -- so measure-based termination
// depends on this.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/logic/conv open
  rhombus/hol/logic/drule open
  rhombus/hol/logic/ruledb open
  rhombus/hol/prover/goal open
  rhombus/hol/prover/trace open
  rhombus/hol/effect/core open
  rhombus/hol/effect/syntax open

export:
  with_assumptions
  simplify_goal

// Extend a database with the goal's assumptions.  An equational assumption
// becomes a rewrite rule -- which is how an induction hypothesis does its work
// -- and any other assumption becomes `p === true`.
// Assumptions are local rewrite facts, never type-prescription candidates.
//
// Each gets its own name. A conditional rule discharges its side conditions
// with itself disabled, by name, so that it cannot be used to justify its own
// application; when every assumption shared one name, an induction
// hypothesis firing switched off *all* of them, including the very
// assumption its side condition was waiting to be discharged against. That
// is why a conditional induction hypothesis never fired.
fun with_assumptions(thy :: Theory, db :: RuleDB,
                     asms :: List.of(Term)) :: RuleDB:
  for values(d :~ RuleDB = db) (a in asms, i in List.iota(asms.length())):
    let name = Symbol.from_string("assumption" ++ to_string(i))
    add_rewrite_thm(thy, d, name, ASSUME(thy, a :~ Term))

// `|- a === a'` for each assumption, or `#false` when none of them moved.
//
// Each is simplified against the database plus the assumptions *before* it.
// Using all of them would let an assumption rewrite itself to `true`, which
// discards it, and would let two assumptions rewrite each other without end.
fun simplify_asms(thy :: Theory, db :: RuleDB,
                  asms :: List.of(Term),
                  ~decide: decide :: maybe(Function) = #false) :: Computation:
  recur loop (i = 0, seen :~ List = [], acc :~ List = [], changed = #false):
    cond
    | i >= asms.length(): return (if changed | acc | #false)
    | ~else:
        let a = asms[i]
        effect:
          let rewritten <- simp_conv_effect(
                               with_assumptions(thy, db, seen),
                               ~decide: decide)(thy, a)
          match rewritten
          | #false:
              loop(i + 1, seen ++ [a], acc ++ [REFL(thy, a)], changed)
          | eq :~ Thm:
              loop(i + 1, seen ++ [a], acc ++ [eq],
                   changed || rhs_of(eq) != a)

// Keep binders and antecedents intact at simplification time. The induction
// and generalization stages need that structure for termination obligations.
fun simplify_goal(thy :: Theory, db :: RuleDB, g :: Goal,
                  ~decide: decide :: maybe(Function) = #false) :: Computation:
  effect:
    let eqs <- simplify_asms(thy, db, g.asms, ~decide: decide)
    match eqs
    | #false: simplify_concl(thy, db, g, ~decide: decide)
    | eqs: return rebuild_asms(thy, db, g, eqs :~ List)

// One assumption reduced to `false` closes the goal; otherwise the goal is
// replaced by the one with reduced assumptions.
//
// Going back the other way is `PROVE_HYP`: from `|- a === a'` and `a` we get
// `a |- a'`, which trades the new hypothesis for the old one in the theorem
// the subgoal returns.
fun rebuild_asms(thy :: Theory, db :: RuleDB, g :: Goal,
                 eqs :: List.of(Thm)) :: maybe(Step):
  let bridges = for List (eq in eqs, a in g.asms):
                  EQ_MP(eq, ASSUME(thy, a))
  recur find (i = 0):
    cond
    | i >= eqs.length():
        let asms2 = eqs.map(rhs_of)
        let sub = Goal(asms2, g.concl)
        fun restore_assumptions(ths :: List.of(Thm)) :: Thm:
          for values(th :~ Thm = ths[0]) (bridge in bridges):
            PROVE_HYP(thy, bridge, th)
        Step([sub], restore_assumptions, [Simplified()])
    | rhs_of(eqs[i]) == tm_false:
        let contra = bridges[i]
        Step([], fun (_ :: List.of(Thm)): CONTR(thy, g.concl, contra), [])
    | ~else: find(i + 1)

// Turn equality between functions into pointwise equality only after ordinary
// simplification has failed. This keeps reflexive function goals cheap while
// making the HOL eta axiom usable through the proof automation.
fun extensionalize_concl(thy :: Theory, g :: Goal) :: maybe(Step):
  match dest_eq(g.concl)
  | [f, h]:
      let fty = type_of(f)
      cond
      | !is_fun(fty): #false
      | ~else:
          let (domain, _) = dest_fun(fty)
          let x = variant(g.asms ++ [g.concl], mk_var(#'x, domain))
          let pointwise = mk_eq(mk_comb(f, x), mk_comb(h, x))
          let sub = Goal(g.asms, pointwise)
          Step([sub], fun (ths :: List.of(Thm)): EXT(thy, x, ths[0]),
               [FunctionExtensionalized()])
  | ~else: #false

// Rewrite with the database, then beta-normalize whatever that exposed.
//
// The two must stay separate. A beta redex has no head constant, so no
// rewrite rule can ever be indexed for one and the simplifier alone will
// never reduce it -- yet unfolding a function whose argument is a lambda
// (or whose body came from surface sugar: an anonymous `function`, an
// expression-position `let`, a `Set` comprehension) creates redexes as it
// goes. Adding `BETA_CONV` to the simplifier's own step instead is sound
// but wrong: that step also runs while a recursive definition's equations
// are being derived, where reducing the redex replaces each folded
// recursive call with the raw `WFREC` encoding and the search stops
// terminating. Applying beta only to a goal the waterfall is holding
// keeps it away from that derivation.
fun simp_then_beta(db :: RuleDB, ~decide: decide :: maybe(Function) = #false):
  fun (thy :: Theory, t :: Term) :: Computation:
    effect:
      let rewritten <- simp_conv_effect(db, ~decide: decide)(thy, t)
      let current = (if rewritten | rhs_of(rewritten :~ Thm) | t)
      let beta = TOP_DEPTH_CONV(BETA_CONV)(thy, current)
      return (cond
              | !beta: rewritten
              | rewritten: TRANS(rewritten :~ Thm, beta :~ Thm)
              | ~else: beta)

fun simplify_concl(thy :: Theory, db :: RuleDB, g :: Goal,
                   ~decide: decide :: maybe(Function) = #false) :: Computation:
  cond
  | g.concl == tm_true:
      return Step([], fun (_ :: List.of(Thm)): TRUTH(thy), [])
  | ~else:
      let db2 = with_assumptions(thy, db, g.asms)
      effect:
        let rewritten <- simp_then_beta(db2, ~decide: decide)(thy, g.concl)
        match rewritten
        | #false: return extensionalize_concl(thy, g)
        | eqth :~ Thm:
            let simplified = rhs_of(eqth)
            cond
            | simplified == g.concl:
                return extensionalize_concl(thy, g)
            | simplified == tm_true:
                // `|- concl === true`, so the goal is closed outright.
                return Step([], fun (_ :: List.of(Thm)): EQT_ELIM(thy, eqth), [])
            | ~else:
                let sub = Goal(g.asms, simplified)
                fun restore_conclusion(ths :: List.of(Thm)) :: Thm:
                  EQ_MP(SYM(thy, eqth), ths[0])
                return Step([sub], restore_conclusion, [Simplified()])
