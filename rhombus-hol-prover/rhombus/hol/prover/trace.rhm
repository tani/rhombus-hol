#lang rhombus/static

// Scoped proof diagnostics. Logical goals do not carry execution history;
// orchestration extends an explicit trace path while it descends into each
// subgoal, and snapshots it only when search leaves a residue open.

import:
  rhombus/hol/term open

export:
  TraceEvent
  Simplified
  FunctionExtensionalized
  DestructorEliminated
  Fertilized
  Generalized
  Inducted
  DroppedIrrelevant
  Assumed
  Witnessed
  CaseSplit
  Specialized

class.together:
  class TraceEvent():
    nonfinal

  class Simplified():
    extends TraceEvent

  class FunctionExtensionalized():
    extends TraceEvent

  class DestructorEliminated(variable :: Symbol, constructor :: Symbol):
    extends TraceEvent

  class Fertilized(equation :: Term):
    extends TraceEvent

  class Generalized(term :: Term, variable :: Symbol):
    extends TraceEvent

  class Inducted(variable :: Symbol, constructor :: Symbol):
    extends TraceEvent

  class DroppedIrrelevant(count :: NonnegInt):
    extends TraceEvent

  class Assumed(term :: Term):
    extends TraceEvent

  class Witnessed(term :: Term):
    extends TraceEvent

  class Specialized(variable :: Symbol):
    extends TraceEvent

  class CaseSplit(term :: Term, positive :: Boolean):
    extends TraceEvent
