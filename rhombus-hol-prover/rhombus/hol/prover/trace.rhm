#lang rhombus/static

// Scoped proof diagnostics. Logical goals do not carry execution history;
// orchestration extends the current trace while it descends into each subgoal,
// and snapshots it only when search leaves a residue open.

import:
  rhombus/hol/term open
  rhombus/hol/effect/core open

export:
  TraceEvent
  Simplified
  FunctionExtensionalized
  DestructorEliminated
  Fertilized
  Generalized
  Inducted
  DroppedIrrelevant
  Assumed
  Witnessed
  CaseSplit
  Specialized
  Trace

class.together:
  class TraceEvent():
    nonfinal

  class Simplified():
    extends TraceEvent

  class FunctionExtensionalized():
    extends TraceEvent

  class DestructorEliminated(variable :: Symbol, constructor :: Symbol):
    extends TraceEvent

  class Fertilized(equation :: Term):
    extends TraceEvent

  class Generalized(term :: Term, variable :: Symbol):
    extends TraceEvent

  class Inducted(variable :: Symbol, constructor :: Symbol):
    extends TraceEvent

  class DroppedIrrelevant(count :: NonnegInt):
    extends TraceEvent

  class Assumed(term :: Term):
    extends TraceEvent

  class Witnessed(term :: Term):
    extends TraceEvent

  class Specialized(variable :: Symbol):
    extends TraceEvent

  class CaseSplit(term :: Term, positive :: Boolean):
    extends TraceEvent

class Trace():
  class Current():
    extends EffectOperation
  class Note(event :: TraceEvent, body :: Computation):
    extends EffectOperation

  fun current() :: Computation:
    perform(Current())
  fun note(event :: TraceEvent, body :: Computation) :: Computation:
    perform(Note(event, body))
  fun handle(computation :: Computation) :: Computation:
    recur loop (current_computation :: Computation = computation,
                stack :: List.of(TraceEvent) = []):
      match current_computation
      | Pure(_): current_computation
      | Request(operation, resume):
          match operation
          | Current(): loop(resume(stack.reverse()), stack)
          | Note(event, body):
              bind(loop(body, List.cons(event, stack)),
                   fun (value): loop(resume(value), stack))
          | ~else:
              Request(operation,
                      fun (value): loop(resume(value), stack))

  export:
    current
    note
    handle
