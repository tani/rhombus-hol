#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// ACL2's waterfall architecture is a design reference; see THIRD_PARTY_NOTICES.


// The waterfall: the driver that pushes a goal through the stages.
//
//   simplification -> destructor elimination -> fertilization ->
//   generalization -> elimination of irrelevance -> induction
//
// A stage that makes progress restarts its subgoals at the top of the
// pipeline; a goal that falls off the bottom is left open, and its trail
// becomes the stuck-residue message.
//
// The order follows ACL2's own waterfall.  Fertilization sits right after
// destructor elimination because its usual source is an induction
// hypothesis of the shape `x === f(y)`, freshly exposed by the previous
// induction step; elimination of irrelevance sits right before induction
// because its whole purpose is to keep an unrelated hypothesis from
// confusing the induction heuristics that come after it.
//
// Nothing here can produce a theorem on its own.  Each stage hands back a
// `Step` carrying its own justification, and `run` composes them; the only
// theorems that exist are the ones the kernel made.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/logic/bool open
  rhombus/hol/prover/search/limits open
  rhombus/hol/logic/drule open
  rhombus/hol/prover/goal open
  rhombus/hol/logic/taut open
  rhombus/hol/prover/context open
  rhombus/hol/prover/stage open
  rhombus/hol/prover/search/scheduler open
  rhombus/hol/effect/core open
  rhombus/hol/effect/syntax open
  rhombus/hol/effect/reader open

export:
  Context
  ProofContext
  RuleBinding
  RuleScope
  mk_context
  context_with_rules
  context_add_datatype
  context_add_function
  prove_goal
  prove
  residue_message
  strip_forall_all
  SearchLimits


// How long a chain of nested inductions the driver will follow.
//
// This is the termination argument, not a tunable budget.  Each induction
// replaces a variable by constructor patterns that introduce *new* variables
// of the same type, so `candidate_vars` will suggest one again on every
// subgoal, forever.  Duplicate detection cannot save this on its own -- the
// subgoals are genuinely different terms each time, not repeats -- so a
// limit on the length of an induction branch is what makes the driver a
// function rather than a search.  ACL2 bounds its own search the same way,
// with subgoal path limits; it does *not* use a fixed depth of two, and an
// earlier comment here saying so was wrong about its architecture.
//
// The value is set by measurement, not by principle.  On
// `tests/decl_theorem.rhm`, which is where the stuck fixtures live:
//
//     limit    2     3     4     5     6      20      100
//     time   3.19  3.07  3.06  3.05  3.08    5.75   does not finish
//
// Six is three times what the specification's examples need and still free;
// past that each further level multiplies the work on goals that are going
// to get stuck anyway by the number of constructors.  The duplicate check
// prunes real repeats but is not what bounds the search -- the `100` column
// is what that claim rests on.
def max_induction_path = 6


// The recognised `skip` names -- see `elab.rhm`'s `parse_tactic`.
def stage_names :: Set = {#'simplify, #'eliminate, #'fertilize, #'generalize,
                          #'irrelevance, #'induct}

fun check_skipped_stages(skipped :: Set.of(Symbol)) :: Void:
  for (n in skipped):
    unless stage_names.contains(n)
    | error(~who: #'proof, "no such waterfall stage to skip",
            error.val(~label: "name", n),
            error.val(~label: "understood", to_string(stage_names)))


// `hint` forces the first induction variable; deeper inductions always choose
// for themselves.
// The other public way into the waterfall, so it opens a resource scope too
// -- and joins one already open, so calling it from inside `prove` still
// spends from the same budget rather than starting over.
fun prove_goal(ctx :: Context, g :: Goal,
               ~induct: hint :: maybe(FVar) = #false,
               ~skipped_stages: skipped :: Set.of(Symbol) = Set(),
               ~limits: limits :: SearchLimits = SearchLimits()) :: ProofNode:
  fun prove_scoped() :: Computation:
    effect:
      let proof_ctx :: ProofContext <- ask()
      return prove_goal_impl(proof_ctx, g, ~induct: hint)
  fun run_scoped_proof() :: ProofNode:
    run_proof_scope(ctx, RuleScope([], [], skipped), prove_scoped())
  with_search_limits(run_scoped_proof, ~limits: limits)

fun prove_goal_impl(ctx :: ProofContext, g :: Goal,
                    ~induct: hint :: maybe(FVar) = #false) :: ProofNode:
  check_skipped_stages(ctx.skipped_stages)
  // `inducted` is the goals already inducted on along this branch, oldest
  // first: its length is the branch limit above, and membership is the
  // duplicate check.  A goal that comes back around unchanged would induct
  // to the same subgoals and get stuck the same way, so trying again only
  // costs time.
  fun go(g :: Goal, inducted :: List, hint :: maybe(FVar)) :: ProofNode:
    // One step per waterfall visit, on the same budget the simplifier spends
    // from.  Each individual simplification can terminate while the stages
    // cycle between themselves; the shared total is what stops that.
    spend_search_step(#'waterfall)
    fun descend(st :: Step, next :: List) :: ProofNode:
      Derived(st, st.subgoals.map(fun (s :: Goal): go(s, next, #false)))
    match first_success(ctx, standard_stages(), g)
    | #false:
        let key = [g.asms, g.concl]
        cond
        | inducted.length() >= max_induction_path: Open(g)
        | inducted.contains(key): Open(g)
        | ctx.skipped_stages.contains(#'induct): Open(g)
        | ~else:
            match run_stage(ctx, induction_stage(hint), g)
            | #false: Open(g)
            | step: descend(step :~ Step, inducted ++ [key])
    | step: descend(step :~ Step, inducted)
  go(g, [], hint)

// Prove a closed proposition.  Leading universal quantifiers are stripped
// first -- the prover works on the matrix and puts the quantifiers back --
// and the result is checked against what was asked for before it is returned.
//
// `names` supplies the names to give those quantified variables.  Terms are
// locally nameless, so a binder's name is not part of the statement: it lives
// in the source the statement was written from.  Anything that refers to a
// bound variable by name -- an `induct(xs)` directive, and the variable names
// a residue message shows the user -- therefore has to be told
// what the source called them.  Without `names` the prover invents its own,
// which is fine for a machine-generated goal and unhelpful for a human one.
// The public entry point opens the resource scope; `prove_impl` is the body.
// Everything the proof does -- simplification, discharging a rewrite rule's
// side conditions, the waterfall's own stages -- spends from this one budget,
// so no nested search can escape the limit by starting a fresh one.
class ProofResult(proved :: maybe(Thm), node :: ProofNode)

fun prove(ctx :: Context, statement :: Term,
          ~names: names :: List.of(Symbol) = [],
          ~induct: hint :: maybe(Symbol) = #false,
          ~scope: scope :: RuleScope = RuleScope(),
          ~cases: cases :: List.of(Term) = [],
          ~witnesses: witnesses :: List.of(Term) = [],
          ~limits: limits :: SearchLimits = SearchLimits())
     :: values(maybe(Thm), ProofNode):
  fun prove_scoped() :: Computation:
    effect:
      let proof_ctx :: ProofContext <- ask()
      let (proved, node) = prove_impl(
                             proof_ctx, statement, ~names: names,
                             ~induct: hint, ~cases: cases,
                             ~witnesses: witnesses)
      return ProofResult(proved, node)
  fun run_scoped_proof() :: ProofResult:
    run_proof_scope(ctx, scope, prove_scoped())
  let result :~ ProofResult:
    with_search_limits(run_scoped_proof, ~limits: limits)
  values(result.proved, result.node)

fun prove_impl(ctx :: ProofContext, statement :: Term,
               ~names: names :: List.of(Symbol) = [],
               ~induct: hint :: maybe(Symbol) = #false,
               ~cases: cases :: List.of(Term) = [],
               ~witnesses: witnesses :: List.of(Term) = [])
     :: values(maybe(Thm), ProofNode):
  let thy = ctx.base.thy
  let (vars, matrix) = strip_forall_all(statement, names)
  let hint_var = (cond
                  | hint:
                      recur loop (vs :~ List = vars):
                        match vs
                        | []:
                            error(~who: #'prove,
                                  "no such variable to induct on",
                                  error.val(~label: "variable", hint),
                                  error.val(~label: "quantified variables",
                                            to_string(vars.map(
                                              fun (u :: FVar): u.name))),
                                  error.val(~label: "hint",
                                            "pass the source names with "
                                              ++ "`~names:`; a locally "
                                              ++ "nameless term does not "
                                              ++ "carry them"))
                        | List.cons(v, rest):
                            (if (v :~ FVar).name == hint | v | loop(rest))
                  | ~else: #false)
  let node = apply_witnesses(ctx, witnesses, cases, mk_goal([], matrix), hint_var)
  match run_with_scheduler(sequential_scheduler(), node)
  | #false: values(#false, node)
  | th :~ Thm:
      let closed = GENL(thy, vars, th)
      // The prover is not trusted to have proved what was asked: check it.
      cond
      | hyps_of(closed).length() != 0:
          error(~who: #'prove, "proof left hypotheses behind",
                error.val(~label: "hypotheses", show_hyps(hyps_of(closed))))
      | concl_of(closed) != statement:
          error(~who: #'prove, "proof does not match the statement",
                error.val(~label: "asked", show(statement)),
                error.val(~label: "got", show(concl_of(closed))))
      | ~else: values(closed, node)

// Apply explicit existential witnesses before Boolean case splits. Each step
// is justified by the derived EXISTS rule, and mismatched hints fail loudly
// rather than being ignored.
fun apply_witnesses(ctx :: ProofContext, witnesses :: List.of(Term),
                    cases :: List.of(Term), g :: Goal,
                    hint :: maybe(FVar)) :: ProofNode:
  match witnesses
  | []: apply_cases(ctx, cases, g, hint)
  | List.cons(witness, rest):
      match dest_imp(g.concl)
      | [antecedent, consequent]:
          let sub = note(Goal(g.asms ++ [antecedent], consequent, g.trail),
                         "assuming " ++ show(antecedent))
          fun discharge_antecedent(ths :: List.of(Thm)) :: Thm:
            DISCH(ctx.base.thy, antecedent, ths[0])
          let step = Step([sub], discharge_antecedent)
          Derived(step,
                  [apply_witnesses(ctx, witnesses, cases, sub, hint)])
      | ~else:
          match dest_exists(g.concl)
          | #false:
              error(~who: #'proof,
                    "an explicit witness was supplied for a non-existential goal",
                    error.val(~label: "goal", show(g.concl)))
          | [v, body]:
              unless type_of(witness) == (v :~ FVar).ty
              | error(~who: #'proof, "existential witness has the wrong type",
                      error.val(~label: "witness", show_typed(witness)),
                      error.val(~label: "binder", type_to_string((v :~ FVar).ty)))
              let instantiated = inst_fvar([[witness, v :~ FVar]], body)
              let sub = note(Goal(g.asms, instantiated, g.trail),
                             "existential witness " ++ show(witness))
              fun introduce_witness(ths :: List.of(Thm)) :: Thm:
                EXISTS(ctx.base.thy, g.concl, witness, ths[0])
              let step = Step([sub], introduce_witness)
              Derived(step,
                      [apply_witnesses(ctx, rest :~ List, cases, sub, hint)])

// `split(p)`, applied before the waterfall runs: split the goal on each term
// in turn, true branch and false branch, so `n` terms give `2^n` subgoals.
// Justified by `taut.rhm`'s `excluded_middle`, not postulated -- a term that
// turns out irrelevant to the goal just produces two subgoals that both need
// the same proof the unsplit goal would have, so a bad choice of case terms
// costs search effort, never soundness. Every subgoal, however deep the
// nesting, restarts at the top of the ordinary waterfall (`prove_goal`), so
// `split` composes with `induct` and `skip` rather than replacing them.
fun apply_cases(ctx :: ProofContext, cases :: List.of(Term), g :: Goal,
                hint :: maybe(FVar)) :: ProofNode:
  match cases
  | []: prove_goal_impl(ctx, g, ~induct: hint)
  | List.cons(c, rest):
      let rest :~ List = rest
      let sub_true = note(Goal(g.asms ++ [c], g.concl, g.trail),
                          "case split: " ++ show(c))
      let sub_false = note(Goal(g.asms ++ [mk_neg(c)], g.concl, g.trail),
                           "case split: not (" ++ show(c) ++ ")")
      fun discharge_cases(ths :: List.of(Thm)) :: Thm:
        let em = excluded_middle(ctx.base.thy, c)
        DISJ_CASES(ctx.base.thy, em, ths[0], ths[1])
      let step = Step([sub_true, sub_false], discharge_cases)
      Derived(step, [apply_cases(ctx, rest, sub_true, hint),
                     apply_cases(ctx, rest, sub_false, hint)])

fun strip_forall_all(t :: Term, names :: List.of(Symbol))
     :: values(List.of(FVar), Term):
  recur loop (t = t, i = 0, acc :~ List = []):
    match dest_forall(t)
    | #false: values(acc, t)
    | [v0, body0]:
        let v0 :~ FVar = v0
        cond
        | i >= names.length(): loop(body0, i + 1, acc ++ [v0])
        | ~else:
            // Use the caller's name, unless something free in the body already
            // claims it.
            let wanted = mk_var(names[i], v0.ty)
            let (_, absterm) = dest_comb(t)
            // Avoid names genuinely free under the binder, but do not treat
            // this binder's temporary opening name as a collision with itself.
            let v = variant([absterm], wanted)
            loop(open_abs(v, absterm), i + 1, acc ++ [v])

// The stuck-residue message: what is left, and how it got there.
fun residue_message(name :: Symbol, node :: ProofNode) :~ String:
  let open_goals = residues(node)
  let body = String.join(open_goals.map(show_goal), "\n\n")
  to_string(name) ++ ": could not prove.\n"
    ++ (if open_goals.length() == 1
        | "Remaining goal,\n"
        | to_string(open_goals.length()) ++ " remaining goals,\n")
    ++ body
