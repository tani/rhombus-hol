#lang rhombus/static

// Execution strategy is separate from proof construction. This module exposes
// only the deterministic sequential scheduler; no parallel execution policy
// or task runtime is introduced here.

import:
  rhombus/hol/kernel open
  "../proof/node.rhm" open
  "../proof/run.rhm" open

export:
  Scheduler
  sequential_scheduler
  run_with_scheduler

class Scheduler(run_tree :: Function)

fun sequential_scheduler() :: Scheduler:
  Scheduler(fun (node :: ProofNode): execute(node))

fun run_with_scheduler(scheduler :: Scheduler, node :: ProofNode)
     :: maybe(Thm):
  scheduler.run_tree(node)
