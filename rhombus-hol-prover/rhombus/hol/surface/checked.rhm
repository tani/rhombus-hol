#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Theory-independent typing and name resolution for surface-core expressions.
// Both backends consume this representation; neither has a separate
// implementation of reference, annotation, overload, application, pattern,
// or body typing.

import:
  rhombus/hol/kernel/type open
  rhombus/hol/surface/type/unify open
  rhombus/hol/surface/overload open
  rhombus/hol/surface/core open

export:
  CheckedInference
  make_checked_inference
  checked_resolve
  checked_unify
  RefRestriction
  CheckEnv
  check_env_with
  CheckedPattern
  CheckedPatWildcard
  CheckedPatVar
  CheckedPatCtor
  CheckedPatLiteral
  checked_pattern_ty
  CheckedBinder
  CheckedBody
  CheckedBodyExpr
  CheckedBodyLet
  CheckedBodyMatch
  CheckedMatchRow
  CheckedPatternMatrix
  checked_body_ty
  CheckedExpr
  CheckedLocal
  CheckedConstant
  CheckedNumeral
  CheckedBoolOp
  CheckedEq
  CheckedApply
  CheckedIf
  CheckedQuantifier
  CheckedFunction
  CheckedBlock
  CheckedMatch
  checked_ty
  check_expr

class CheckedInference(substitution :: Box)

fun make_checked_inference() :: CheckedInference:
  CheckedInference(Box({}))

fun checked_resolve(inference :: CheckedInference, ty :: HType) :: HType:
  deep_resolve(inference.substitution.value :~ Map, ty, [])

fun checked_unify(inference :: CheckedInference,
                  left :: HType, right :: HType) :: Boolean:
  match type_unify(
          checked_resolve(inference, left),
          checked_resolve(inference, right),
          inference.substitution.value :~ Map)
  | #false: #false
  | substitution:
      inference.substitution.value := substitution
      #true

// A restriction applies before global lookup when `block_global` is true;
// otherwise an existing global may still be used, but a missing one reports
// the restriction instead of the generic unknown-constant diagnostic.
class RefRestriction(message :: String, block_global :: Boolean)

class CheckEnv(inference :: CheckedInference,
               vars :: Map.of(Symbol, HType),
               lookup :: Function.of_arity(1),
               lookup_global :: Function.of_arity(1),
               parse_type :: Function.of_arity(1),
               operators :: OverloadRegistry,
               show_type :: Function.of_arity(1),
               error :: Function.of_arity(2),
               restricted_refs :: Map.of(Symbol, RefRestriction) = {})

fun check_env_with(env :: CheckEnv,
                   vars :: Map.of(Symbol, HType) = env.vars,
                   restricted_refs :: Map.of(Symbol, RefRestriction)
                     = env.restricted_refs)
    :: CheckEnv:
  CheckEnv(env.inference, vars, env.lookup, env.lookup_global,
           env.parse_type, env.operators, env.show_type, env.error,
           restricted_refs)
class CheckedExpr():
  nonfinal


class CheckedPattern():
  nonfinal

class CheckedPatWildcard(ty :: HType, at :: Syntax):
  extends CheckedPattern
class CheckedPatVar(name :: Symbol, ty :: HType, at :: Syntax):
  extends CheckedPattern
class CheckedPatCtor(name :: Symbol,
                     args :: List.of(CheckedPattern),
                     constructor_ty :: HType,
                     ty :: HType,
                     at :: Syntax):
  extends CheckedPattern
class CheckedPatLiteral(value :: NonnegInt, ty :: HType, at :: Syntax):
  extends CheckedPattern

fun checked_pattern_ty(pat :: CheckedPattern) :: HType:
  match pat
  | CheckedPatWildcard(ty, _): ty
  | CheckedPatVar(_, ty, _): ty
  | CheckedPatCtor(_, _, _, ty, _): ty
  | CheckedPatLiteral(_, ty, _): ty
  | ~else: error(~who: #'checked_pattern_ty, "unknown checked pattern")

class CheckedBinder(pat :: CheckedPattern, ty :: HType, at :: Syntax)

class CheckedBody():
  nonfinal

class CheckedMatchRow(patterns :: List.of(CheckedPattern),
                      body :: CheckedBody,
                      at :: Syntax)

class CheckedPatternMatrix(rows :: List.of(CheckedMatchRow), ty :: HType):
  extends CheckedBody

class CheckedBodyExpr(expr :: CheckedExpr):
  extends CheckedBody
class CheckedBodyLet(pat :: CheckedPattern,
                     init :: CheckedExpr,
                     body :: CheckedBody,
                     ty :: HType,
                     at :: Syntax):
  extends CheckedBody
class CheckedBodyMatch(scrutinee :: CheckedExpr,
                       matrix :: CheckedPatternMatrix,
                       ty :: HType,
                       at :: Syntax):
  extends CheckedBody

fun checked_body_ty(body :: CheckedBody) :: HType:
  match body
  | CheckedBodyExpr(expr): checked_ty(expr)
  | CheckedBodyLet(_, _, _, ty, _): ty
  | CheckedBodyMatch(_, _, ty, _): ty
  | CheckedPatternMatrix(_, ty): ty
  | ~else: error(~who: #'checked_body_ty, "unknown checked body")


class CheckedLocal(name :: Symbol, ty :: HType, at :: Syntax):
  extends CheckedExpr
class CheckedConstant(name :: Symbol, ty :: HType, at :: Syntax):
  extends CheckedExpr
class CheckedNumeral(value :: NonnegInt, ty :: HType, at :: Syntax):
  extends CheckedExpr
class CheckedIf(cond :: CheckedExpr,
                then_branch :: CheckedExpr,
                else_branch :: CheckedExpr,
                ty :: HType,
                at :: Syntax):
  extends CheckedExpr
class CheckedBoolOp(op :: Symbol,
                    args :: List.of(CheckedExpr),
                    at :: Syntax):
  extends CheckedExpr
class CheckedEq(left :: CheckedExpr,
                right :: CheckedExpr,
                operand_ty :: HType,
                at :: Syntax):
  extends CheckedExpr
class CheckedApply(head :: CheckedExpr,
                   args :: List.of(CheckedExpr),
                   ty :: HType,
                   at :: Syntax):
  extends CheckedExpr
class CheckedQuantifier(binders :: List.of(CheckedBinder),
                        body :: CheckedExpr,
                        is_forall :: Boolean,
                        at :: Syntax):
  extends CheckedExpr
class CheckedFunction(params :: List.of(CheckedBinder),
                      result_ty :: HType,
                      body :: CheckedBody,
                      ty :: HType,
                      at :: Syntax):
  extends CheckedExpr
class CheckedBlock(body :: CheckedBody, ty :: HType, at :: Syntax):
  extends CheckedExpr
class CheckedMatch(scrutinee :: CheckedExpr,
                   matrix :: CheckedPatternMatrix,
                   ty :: HType,
                   at :: Syntax):
  extends CheckedExpr

fun checked_ty(expr :: CheckedExpr) :: HType:
  match expr
  | CheckedLocal(_, ty, _): ty
  | CheckedConstant(_, ty, _): ty
  | CheckedNumeral(_, ty, _): ty
  | CheckedIf(_, _, _, ty, _): ty
  | CheckedBoolOp(_, _, _): mk_tyapp(#'bool, [])
  | CheckedEq(_, _, _, _): mk_tyapp(#'bool, [])
  | CheckedApply(_, _, ty, _): ty
  | CheckedQuantifier(_, _, _, _): mk_tyapp(#'bool, [])
  | CheckedFunction(_, _, _, ty, _): ty
  | CheckedBlock(_, ty, _): ty
  | CheckedMatch(_, _, ty, _): ty
  | ~else: error(~who: #'checked_ty, "unknown checked expression")

fun requires_expected_type(expr :: CoreExpr,
                           operators :: OverloadRegistry) :: Boolean:
  fun any_arg(args :: List.of(CoreExpr)) :: Boolean:
    for values(found = #false) (arg in args):
      found || requires_expected_type(arg :~ CoreExpr, operators)
  fun every_arg(args :: List.of(CoreExpr)) :: Boolean:
    args.length() == 0
      || for values(all = #true) (arg in args):
           all && requires_expected_type(arg :~ CoreExpr, operators)
  fun body_requires(body :: CoreFunBody) :: Boolean:
    match body
    | CoreBodyExpr(inner):
        requires_expected_type(inner, operators)
    | CoreBodyLet(_, _, tail, _):
        body_requires(tail)
    | CoreBodyMatch(_, _, _): #true
    | _ :: CorePatternMatrix: #true
    | ~else: #false
  match expr
  | CoreNumeral(_, _): #true
  | CoreTypedExpr(_, _, _): #false
  | CoreGlobalRef(_, _): #false
  | CoreCall(CoreRef(name, _), args, _) when overload_arity(operators, name) != #false:
      every_arg(args)
  | CoreCall(_, args, _): any_arg(args)
  | CoreIf(_, then_expr, else_expr, _):
      requires_expected_type(then_expr, operators)
        || requires_expected_type(else_expr, operators)
  | CoreBlockExpr(body, _): body_requires(body)
  | CoreMatchExpr(_, _, _): #true
  | ~else: #false

fun fresh_instance(ty :: HType) :: HType:
  let renaming:
    for values(out :~ Map = {}) (name in type_vars(ty)):
      out ++ {name: mk_tyvar(Symbol.gen(to_string(name))) :~ HType}
  type_subst(renaming, ty)

fun resolve(env :: CheckEnv, ty :: HType) :: HType:
  checked_resolve(env.inference, ty)

fun fail(env :: CheckEnv, message :: String, at :: Syntax):
  env.error(message, at)

fun unify(env :: CheckEnv, left :: HType, right :: HType,
          at :: Syntax, message :: String):
  unless checked_unify(env.inference, left, right)
  | fail(env, message, at)

fun ordinary_constant_type(env :: CheckEnv, name :: Symbol, at :: Syntax)
    :: maybe(HType):
  match env.restricted_refs.get(name, #false)
  | restriction :: RefRestriction when restriction.block_global:
      fail(env, restriction.message, at)
  | ~else: #void
  match env.lookup(name)
  | found :: HType: found
  | #false:
      match env.restricted_refs.get(name, #false)
      | restriction :: RefRestriction: fail(env, restriction.message, at)
      | #false: #false

fun global_constant_type(env :: CheckEnv, name :: Symbol, at :: Syntax)
    :: HType:
  match env.lookup_global(name)
  | found :: HType: found
  | #false:
      fail(env, "unknown constant " ++ to_string(name), at)

fun optional_type(env :: CheckEnv, type_stx :: maybe(Syntax),
                  hint :: String) :: HType:
  match type_stx
  | #false: mk_tyvar(Symbol.gen(hint))
  | stx: env.parse_type(stx :~ Syntax)

fun peel_type(env :: CheckEnv, ty :: HType, count :: NonnegInt,
              at :: Syntax, message :: String)
    :: values(List.of(HType), HType):
  recur loop (remaining = count, current :~ HType = ty,
              domains :~ List.of(HType) = []):
    cond
    | remaining == 0: values(domains, resolve(env, current))
    | ~else:
        let current = resolve(env, current)
        when current is_a TyVar
        | let domain = mk_tyvar(Symbol.gen("_domain"))
          let range = mk_tyvar(Symbol.gen("_range"))
          unify(env, current, mk_fun(domain, range), at, message)
        let current = resolve(env, current)
        unless is_fun(current)
        | fail(env, message, at)
        let (domain, range) = dest_fun(current)
        loop(remaining - 1, range, domains ++ [domain])

fun merge_bindings(env :: CheckEnv,
                   left :: Map.of(Symbol, HType),
                   right :: Map.of(Symbol, HType),
                   at :: Syntax) :: Map.of(Symbol, HType):
  for values(out :~ Map = left) ((name, ty) in right):
    when out.get(name, #false)
    | fail(env, "a pattern repeats `" ++ to_string(name) ++ "`", at)
    out ++ {name: ty :~ HType}

fun required_pattern_name(env :: CheckEnv, pat :: CorePattern,
                          message :: String) :: Symbol:
  match pat
  | CorePatVar(name, _): name
  | CorePatTyped(inner, _, _): required_pattern_name(env, inner, message)
  | ~else: fail(env, message, pattern_at(pat))

fun following_local_function_names(body :: CoreFunBody) :: List.of(Symbol):
  match body
  | CoreBodyLet(pat, init, tail, _):
      let following = following_local_function_names(tail)
      (if init is_a CoreFunctionExpr
       | match pat
         | CorePatVar(name, _): [name] ++ following
         | CorePatTyped(inner, _, _):
             match inner
             | CorePatVar(name, _): [name] ++ following
             | ~else: following
         | ~else: following
       | following)
  | ~else: []

fun check_pattern(env :: CheckEnv, pat :: CorePattern,
                  expected :: HType)
    :: values(CheckedPattern, Map.of(Symbol, HType)):
  match pat
  | CorePatWildcard(at):
      values(CheckedPatWildcard(resolve(env, expected), at), {})
  | CorePatVar(name, at):
      let ty = resolve(env, expected)
      values(CheckedPatVar(name, ty, at), {name: ty})
  | CorePatTyped(inner, type_stx, at):
      let annotated = env.parse_type(type_stx)
      unify(env, expected, annotated, at,
            "a pattern annotation does not match the expected type")
      check_pattern(env, inner, resolve(env, annotated))
  | CorePatLiteral(value_stx, at):
      let raw = Syntax.unwrap(value_stx)
      unless raw is_a NonnegInt
      | fail(env, "unsupported literal pattern", at)
      let ty = resolve(env, expected)
      when ty is_a TyVar
      | fail(env,
             "a numeral pattern needs a type annotation or an unambiguous context",
             at)
      unless ty == mk_tyapp(#'Nat, [])
      | fail(env,
             "a numeral has no representation at type " ++ env.show_type(ty),
             at)
      values(CheckedPatLiteral(raw :~ NonnegInt, ty, at), {})
  | CorePatCtor(name, args, at) when name == #'pair:
      unless args.length() == 2
      | fail(env, "a Pair pattern needs exactly two fields", at)
      let first_ty = mk_tyvar(Symbol.gen("_pair_first"))
      let second_ty = mk_tyvar(Symbol.gen("_pair_second"))
      let result_ty = mk_tyapp(#'prod, [first_ty, second_ty])
      unify(env, result_ty, expected, at,
            "a Pair pattern needs a `Pair.of(...)` value")
      let parsed:
        for List (arg in args, domain in [first_ty, second_ty]):
          let (checked, bindings) = check_pattern(
                                      env, arg :~ CorePattern,
                                      resolve(env, domain :~ HType))
          [checked, bindings]
      let checked_args:
        parsed.map(fun (entry :: List): entry[0] :~ CheckedPattern)
      let bindings:
        for values(out :~ Map = {}) (entry in parsed):
          merge_bindings(env, out, (entry :~ List)[1] :~ Map, at)
      let resolved_first = resolve(env, first_ty)
      let resolved_second = resolve(env, second_ty)
      let resolved_result = resolve(env, result_ty)
      values(
        CheckedPatCtor(
          name, checked_args,
          mk_fun(resolved_first, mk_fun(resolved_second, resolved_result)),
          resolved_result, at),
        bindings)
  | CorePatCtor(name, args, at):
      let generic = fresh_instance(global_constant_type(env, name, at))
      let (domains, result) = peel_type(
                                env, generic, args.length(), at,
                                "constructor pattern has the wrong number of fields")
      unify(env, result, expected, at,
            "constructor does not build the matched type")
      let parsed:
        for List (arg in args, domain in domains):
          let (checked, bindings) = check_pattern(
                                      env, arg :~ CorePattern,
                                      resolve(env, domain :~ HType))
          [checked, bindings]
      let checked_args:
        parsed.map(fun (entry :: List): entry[0] :~ CheckedPattern)
      let bindings:
        for values(out :~ Map = {}) (entry in parsed):
          merge_bindings(env, out, (entry :~ List)[1] :~ Map, at)
      values(CheckedPatCtor(name, checked_args, resolve(env, generic),
                            resolve(env, expected), at),
             bindings)

fun check_binder(env :: CheckEnv, binder :: CoreBinder,
                 contextual :: maybe(HType), hint :: String)
    :: values(CheckedBinder, Map.of(Symbol, HType)):
  let declared = optional_type(env, binder.type_stx, hint)
  match contextual
  | #false: #void
  | wanted:
      unify(env, declared, wanted :~ HType, binder.at,
            "a binder does not match its expected type")
  let ty = resolve(env, declared)
  let (checked_pat, bindings) = check_pattern(env, binder.pattern, ty)
  values(CheckedBinder(checked_pat, resolve(env, ty), binder.at), bindings)

fun check_matrix(env :: CheckEnv, matrix :: CorePatternMatrix,
                 subject_types :: List.of(HType), expected :: maybe(HType),
                 at :: Syntax) :: CheckedPatternMatrix:
  when matrix.rows.length() == 0
  | fail(env, "a match expression needs at least one clause", at)
  let (rows, result_type):
    for values(out :~ List.of(CheckedMatchRow) = [],
               current :~ maybe(HType) = expected) (source_row in matrix.rows):
      let source_row :~ CoreMatchRow = source_row
      unless source_row.patterns.length() == subject_types.length()
      | fail(env,
             "this clause has " ++ to_string(source_row.patterns.length())
               ++ " patterns but the function takes "
               ++ to_string(subject_types.length()),
             source_row.at)
      let parsed:
        for List (pat in source_row.patterns, ty in subject_types):
          let (checked, bindings) = check_pattern(
                                      env, pat :~ CorePattern,
                                      resolve(env, ty :~ HType))
          [checked, bindings]
      let patterns:
        parsed.map(fun (entry :: List): entry[0] :~ CheckedPattern)
      let bindings:
        for values(bindings :~ Map = {}) (entry in parsed):
          merge_bindings(
            env, bindings, (entry :~ List)[1] :~ Map, source_row.at)
      let row_env = check_env_with(env, env.vars ++ bindings)
      let body = check_body(row_env, source_row.body, current)
      let row_type = checked_body_ty(body)
      match current
      | #false: #void
      | wanted:
          unify(env, row_type, wanted :~ HType, source_row.at,
                "a match clause has a different result type")
      values(out ++ [CheckedMatchRow(patterns, body, source_row.at)],
             resolve(env, row_type))
  CheckedPatternMatrix(rows, resolve(env, result_type :~ HType))

fun add_restrictions(base :: Map.of(Symbol, RefRestriction),
                     names :: List.of(Symbol), message :: String)
    :: Map.of(Symbol, RefRestriction):
  for values(out :~ Map = base) (name in names):
    out ++ {name: RefRestriction(message, #false)}

fun check_body(env :: CheckEnv, body :: CoreFunBody,
               expected :: maybe(HType)) :: CheckedBody:
  match body
  | CoreBodyExpr(expr): CheckedBodyExpr(check_expr(env, expr, expected))
  | CoreBodyLet(binding_pattern, init, tail, at):
      let local_name:
        (if init is_a CoreFunctionExpr
         | required_pattern_name(
             env, binding_pattern, "a local function needs a name")
         | #false)
      let init_restricted = add_restrictions(
                              env.restricted_refs,
                              following_local_function_names(tail),
                              "forward local-function reference is not supported")
      let init_restricted:
        match local_name
        | #false: init_restricted
        | name:
            init_restricted
              ++ {name:
                    RefRestriction(
                      "local recursive functions are not supported", #false)}
      let init_value = check_expr(
                         check_env_with(env, env.vars, init_restricted),
                         init, #false)
      let (checked_pat, bindings) = check_pattern(
                                      env, binding_pattern,
                                      checked_ty(init_value))
      let checked_tail = check_body(
                           check_env_with(env, env.vars ++ bindings),
                           tail, expected)
      CheckedBodyLet(checked_pat, init_value, checked_tail,
                     resolve(env, checked_body_ty(checked_tail)), at)
  | CoreBodyMatch(scrutinee, matrix, at):
      let target = check_expr(env, CoreRef(scrutinee, at), #false)
      let checked_matrix = check_matrix(
                             env, matrix, [checked_ty(target)], expected, at)
      CheckedBodyMatch(target, checked_matrix,
                       resolve(env, checked_body_ty(checked_matrix)), at)
  | _ :: CorePatternMatrix:
      fail(env, "function clauses are not an expression block", Syntax.make(#false))
  | ~else: error(~who: #'check_body, "unknown CoreFunBody variant")

fun check_function(env :: CheckEnv,
                   params :: List.of(CoreBinder),
                   result_type_stx :: maybe(Syntax),
                   body :: CoreFunBody,
                   at :: Syntax,
                   expected :: maybe(HType)) :: CheckedFunction:
  let contextual:
    match expected
    | #false: #false
    | wanted:
        let (domains, result) = peel_type(
                                  env, wanted :~ HType,
                                  params.length(), at,
                                  "a function expression does not match its expected type")
        [domains, result]
  let parsed_params:
    for List (binder in params, index in List.iota(params.length())):
      let contextual_type:
        match contextual
        | #false: #false
        | [domains, _]: (domains :~ List)[index] :~ HType
      let (checked, bindings) = check_binder(
                                  env, binder :~ CoreBinder,
                                  contextual_type, "_parameter")
      [checked, bindings]
  let checked_params:
    parsed_params.map(fun (entry :: List): entry[0] :~ CheckedBinder)
  let parameter_types:
    checked_params.map(fun (binder :: CheckedBinder): binder.ty)
  let parameter_bindings:
    for values(out :~ Map = {}) (entry in parsed_params):
      merge_bindings(
        env, out, (entry :~ List)[1] :~ Map,
        ((entry :~ List)[0] :~ CheckedBinder).at)
  let result_type = optional_type(env, result_type_stx, "_result")
  match contextual
  | [_, contextual_result]:
      unify(env, result_type, contextual_result :~ HType, at,
            "a function result does not match its expected type")
  | #false: #void
  let result_type = resolve(env, result_type)
  let checked_body:
    match body
    | matrix :: CorePatternMatrix:
        check_matrix(env, matrix, parameter_types, result_type, at)
    | other:
        check_body(
          check_env_with(env, env.vars ++ parameter_bindings),
          other, result_type)
  let function_type:
    for values(ty :~ HType = result_type) (domain in parameter_types.reverse()):
      mk_fun(domain :~ HType, ty)
  match expected
  | #false: #void
  | wanted:
      unify(env, function_type, wanted :~ HType, at,
            "a function expression does not match its expected type")
  CheckedFunction(checked_params, resolve(env, result_type), checked_body,
                  resolve(env, function_type), at)

fun check_quantifier(env :: CheckEnv, binders :: List.of(CoreBinder),
                     body :: CoreExpr, is_forall :: Boolean,
                     at :: Syntax) :: CheckedQuantifier:
  let parsed:
    for List (binder in binders):
      let (checked, bindings) = check_binder(
                                  env, binder :~ CoreBinder,
                                  #false, "_bound")
      [checked, bindings]
  let checked_binders:
    parsed.map(fun (entry :: List): entry[0] :~ CheckedBinder)
  let bindings:
    for values(out :~ Map = {}) (entry in parsed):
      merge_bindings(
        env, out, (entry :~ List)[1] :~ Map,
        ((entry :~ List)[0] :~ CheckedBinder).at)
  let checked_body = check_expr(
                       check_env_with(env, env.vars ++ bindings),
                       body, mk_tyapp(#'bool, []))
  CheckedQuantifier(checked_binders, checked_body, is_forall, at)

fun check_arguments(env :: CheckEnv,
                    args :: List.of(CoreExpr),
                    domains :: List.of(HType),
                    at :: Syntax) :: List.of(CheckedExpr):
  fun replace(xs :: List, index :: Int, value) :: List:
    for List (x in xs, position in List.iota(xs.length())):
      (if position == index | value | x)
  let (checked, deferred):
    for values(out :~ List.of(maybe(CheckedExpr)) = [],
               pending :~ List.of(Int) = []) (
          arg in args, domain in domains,
          index in List.iota(args.length())):
      let wanted = resolve(env, domain :~ HType)
      cond
      | requires_expected_type(arg :~ CoreExpr, env.operators)
          && wanted is_a TyVar:
          values(out ++ [#false], pending ++ [index])
      | ~else:
          let value = check_expr(env, arg :~ CoreExpr, wanted)
          unify(env, wanted, checked_ty(value), at,
                "operand type does not match function domain")
          values(out ++ [value], pending)
  recur fill (pending :~ List.of(Int) = deferred,
              out :~ List.of(maybe(CheckedExpr)) = checked):
    match pending
    | []: out.map(fun (value): value :~ CheckedExpr)
    | List.cons(index, rest):
        let wanted = resolve(env, domains[index] :~ HType)
        let value = check_expr(env, args[index] :~ CoreExpr, wanted)
        unify(env, wanted, checked_ty(value), at,
              "operand type does not match function domain")
        fill(rest, replace(out, index, value))

fun check_overload(env :: CheckEnv, name :: Symbol,
                   args :: List.of(CoreExpr), at :: Syntax,
                   expected :: maybe(HType)) :: CheckedExpr:
  let arity = overload_arity(env.operators, name)
  unless arity
  | fail(env, "unknown overload function " ++ to_string(name), at)
  let arity :~ NonnegInt = arity
  unless args.length() == arity
  | fail(env,
         "`" ++ to_string(name) ++ "` expects " ++ to_string(arity)
           ++ " arguments",
         at)
  let known:
    for List (arg in args):
      (if requires_expected_type(arg :~ CoreExpr, env.operators)
       | #false
       | check_expr(env, arg :~ CoreExpr, #false))
  let argument_types:
    known.map(
      fun (value):
        match value
        | #false: #false
        | checked: resolve(env, checked_ty(checked :~ CheckedExpr)))
  let wanted:
    match expected
    | #false: #false
    | ty: resolve(env, ty :~ HType)
  let matches = resolve_overload(env.operators, name, argument_types, wanted)
  when matches.length() == 0
  | fail(env, "`" ++ to_string(name) ++ "` has no applicable overload", at)
  when matches.length() > 1
  | fail(env, "`" ++ to_string(name) ++ "` has ambiguous overload", at)
  let resolution :~ OverloadResolution = matches[0]
  let checked_args:
    for List (arg in args, prior in known,
              domain in resolution.argument_types):
      match prior
      | #false:
          check_expr(env, arg :~ CoreExpr, domain :~ HType)
      | value:
          let value = value :~ CheckedExpr
          unify(env, checked_ty(value), domain :~ HType, at,
                "overload argument has an unexpected type")
          value
  match expected
  | #false: #void
  | wanted:
      unify(env, resolution.result_type, wanted :~ HType, at,
            "overload result type does not match the expected type")
  let method = resolution.method
  let ordered_args:
    method.argument_order.map(
      fun (index): checked_args[index] :~ CheckedExpr)
  CheckedApply(
    CheckedConstant(method.constant, resolve(env, resolution.constant_type), at),
    ordered_args, resolve(env, resolution.result_type), at)

fun check_expr(env :: CheckEnv, expr :: CoreExpr,
               expected :: maybe(HType) = #false) :: CheckedExpr:
  fun unify_with(ty :: HType, at :: Syntax):
    match expected
    | #false: #void
    | wanted:
        unify(env, ty, wanted :~ HType, at,
              "expression has an unexpected type")
  fun callable_name(value :: CoreExpr) :: maybe(Symbol):
    match value
    | CoreRef(name, _) when !env.vars.get(name, #false): name
    | CoreGlobalRef(name, _): name
    | ~else: #false
  match expr
  | CoreRef(name, at):
      match env.vars.get(name, #false)
      | found :: HType:
          unify_with(found, at)
          CheckedLocal(name, resolve(env, found), at)
      | #false:
          match ordinary_constant_type(env, name, at)
          | found :: HType:
              let instance = fresh_instance(found)
              unify_with(instance, at)
              CheckedConstant(name, resolve(env, instance), at)
          | #false:
              fail(env, "unknown constant " ++ to_string(name), at)
  | CoreGlobalRef(name, at):
      let instance = fresh_instance(global_constant_type(env, name, at))
      unify_with(instance, at)
      CheckedConstant(name, resolve(env, instance), at)
  | CoreNumeral(value, at):
      match expected
      | #false: fail(env, "a numeral needs an expected numeric type", at)
      | wanted:
          let ty = resolve(env, wanted :~ HType)
          when ty is_a TyVar
          | fail(env,
                 "a numeral needs a type ascription or an unambiguous numeric context",
                 at)
          unless ty == mk_tyapp(#'Nat, [])
                   || ty == mk_tyapp(#'Integer, [])
                   || ty == mk_tyapp(#'Rational, [])
          | fail(env,
                 "a numeral has no representation at type " ++ env.show_type(ty),
                 at)
          CheckedNumeral(value, ty, at)
  | CoreTypedExpr(inner, type_stx, at):
      let annotated = env.parse_type(type_stx)
      let checked = check_expr(env, inner, annotated)
      unify_with(checked_ty(checked), at)
      checked
  | CoreCall(func, args, at) when callable_name(func) == #'eq
                                      && args.length() == 2:
      let left_core :~ CoreExpr = args[0]
      let right_core :~ CoreExpr = args[1]
      // Infer both sides independently when possible. This preserves the
      // equality-specific mismatch diagnostic for two well-typed operands;
      // when one side needs context, the other side supplies it. A failed
      // attempt restores inference because overload checking can unify part
      // of a signature before discovering ambiguity.
      fun infer(core :: CoreExpr) :: maybe(CheckedExpr):
        let substitution = env.inference.substitution.value
        try:
          check_expr(env, core, #false)
          ~catch _ :: Exn.Fail:
            env.inference.substitution.value := substitution
            #false
      let left_guess = infer(left_core)
      let right_guess = infer(right_core)
      let (left, right):
        match left_guess
        | left :: CheckedExpr:
            match right_guess
            | right :: CheckedExpr: values(left, right)
            | #false:
                values(left, check_expr(env, right_core, checked_ty(left)))
        | #false:
            match right_guess
            | right :: CheckedExpr:
                values(check_expr(env, left_core, checked_ty(right)), right)
            | #false:
                // Neither side supplies a concrete type. Check against one
                // shared metavariable so genuinely ambiguous literals retain
                // the type-ascription diagnostic instead of losing context.
                let common = mk_tyvar(Symbol.gen("_equality"))
                let left = check_expr(env, left_core, common)
                values(left, check_expr(env, right_core, checked_ty(left)))
      unify(env, checked_ty(left), checked_ty(right), at,
            "equality operands have different types")
      unify_with(mk_tyapp(#'bool, []), at)
      CheckedEq(left, right, resolve(env, checked_ty(left)), at)
  | CoreCall(func, args, at) when (callable_name(func) == #'conj
                                        || callable_name(func) == #'disj
                                        || callable_name(func) == #'imp)
                                       && args.length() == 2:
      let name = callable_name(func) :~ Symbol
      let bool_ty = mk_tyapp(#'bool, [])
      let checked_args:
        args.map(fun (arg :: CoreExpr): check_expr(env, arg, bool_ty))
      unify_with(bool_ty, at)
      CheckedBoolOp(name, checked_args, at)
  | CoreCall(func, args, at) when callable_name(func) == #'neg
                                      && args.length() == 1:
      let name = callable_name(func) :~ Symbol
      let bool_ty = mk_tyapp(#'bool, [])
      let checked_args:
        args.map(fun (arg :: CoreExpr): check_expr(env, arg, bool_ty))
      unify_with(bool_ty, at)
      CheckedBoolOp(name, checked_args, at)
  | CoreCall(CoreRef(name, _), args, at) when !env.vars.get(name, #false)
                                                && ordinary_constant_type(env, name, at) == #false
                                                && overload_arity(env.operators, name) != #false:
      check_overload(env, name, args, at, expected)
  | CoreCall(func, args, at):
      let head = check_expr(env, func, #false)
      let (domains, result) = peel_type(
                                env, checked_ty(head), args.length(), at,
                                "the applied expression is not a function")
      unify_with(result, at)
      CheckedApply(head, check_arguments(env, args, domains, at),
                   resolve(env, result), at)
  | CoreIf(cond, then_expr, else_expr, at):
      let bool_ty = mk_tyapp(#'bool, [])
      let checked_cond = check_expr(env, cond, bool_ty)
      let checked_then = check_expr(env, then_expr, expected)
      let checked_else = check_expr(env, else_expr, checked_ty(checked_then))
      let ty = resolve(env, checked_ty(checked_else))
      unify_with(ty, at)
      CheckedIf(checked_cond, checked_then, checked_else, ty, at)
  | CoreForall(binders, body, at):
      let checked = check_quantifier(env, binders, body, #true, at)
      unify_with(mk_tyapp(#'bool, []), at)
      checked
  | CoreExists(binders, body, at):
      let checked = check_quantifier(env, binders, body, #false, at)
      unify_with(mk_tyapp(#'bool, []), at)
      checked
  | CoreFunctionExpr(params, result_type, body, at):
      check_function(env, params, result_type, body, at, expected)
  | CoreBlockExpr(body, at):
      let checked_body = check_body(env, body, expected)
      let ty = resolve(env, checked_body_ty(checked_body))
      unify_with(ty, at)
      CheckedBlock(checked_body, ty, at)
  | CoreMatchExpr(scrutinee, matrix, at):
      match expected
      | #false:
          fail(env, "a match expression needs an expected result type", at)
      | wanted:
          let target = check_expr(env, scrutinee, #false)
          let checked_matrix = check_matrix(
                                 env, matrix, [checked_ty(target)], wanted, at)
          let ty = resolve(env, checked_body_ty(checked_matrix))
          CheckedMatch(target, checked_matrix, ty, at)
  | ~else: error(~who: #'check_expr, "unknown CoreExpr variant")
