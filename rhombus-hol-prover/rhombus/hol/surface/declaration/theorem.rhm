#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Elaborating a `theorem` statement and parsing its adjacent `proof:`
// block's tactic options.
//
// This module only *analyses*: syntax and core propositions in, kernel
// terms and tactic option maps out. Shared checking, name resolution, and
// term construction live in `surface/elaborate.rhm`; this module assembles them
// into the declaration-shaped entry points `elaborate_theorem_statement` and
// `parse_tactic`.

import:
  rhombus/hol/kernel/term open
  rhombus/hol/kernel open
  rhombus/hol/definition/datatype/define open
  rhombus/hol/surface/core open
  rhombus/hol/surface/overload open
  rhombus/hol/surface/type/registry open
  rhombus/hol/surface/type/parse open
  rhombus/hol/surface/elaborate open

export:
  theorem_parts
  proof_groups
  elaborate_theorem_statement
  parse_tactic

// `theorem name: <prop>`, or `#false` if this is not one.
fun theorem_parts(form :: Syntax) :: maybe(List):
  match form
  | 'theorem $(name :: Identifier): $g; ...': [name, [g, ...]]
  | ~else: #false

fun proof_groups(form :: Syntax) :: maybe(List.of(Syntax)):
  match form
  | 'proof: $g; ...': [g, ...]
  | ~else: #false

fun required_pattern_name(pat :: CorePattern, who :: Symbol,
                          message :: String) :: Symbol:
  match pat
  | CorePatVar(name, _): name
  | CorePatTyped(inner, _, _):
      required_pattern_name(inner, who, message)
  | ~else: syntax_error(who, message, pattern_at(pat))

fun leading_core_binder_names(expr :: CoreExpr) :: List.of(Symbol):
  match expr
  | CoreForall(bs, body, _):
      bs.map(
        fun (b :: CoreBinder):
          required_pattern_name(
            b.pattern, #'theorem,
            "a quantified binder needs a name"))
        ++ leading_core_binder_names(body)
  | ~else: []

fun elaborate_theorem_statement(
      thy :: Theory, expr :: CoreExpr,
      ~operators: operators :: OverloadRegistry = standard_overload_registry(),
      ~type_constructors: type_constructors :: TypeConstructorRegistry = standard_type_constructor_registry(),
      ~datatypes: datatypes :: Map.of(Symbol, DatatypeSpec) = {})
     :: values(Term, List.of(Symbol)):
  let tyvars = core_type_vars(expr)
  values(parse_core_prop(thy, tyvars, {}, expr,
                         ~operators: operators,
                         ~type_constructors: type_constructors,
                         ~datatypes: datatypes),
         leading_core_binder_names(expr))

// ============================================================================
// Proof options
// ============================================================================
//
// A `proof:` block is a sequence of declarative option groups. The block
// itself is the boundary: each option configures the one existing waterfall
// invocation, and none executes as a run-time Rhombus expression. Every option
// occurs at most once. All options except `~limit` contain one nonempty list
// whose source order is preserved.
//
// `~skip` names waterfall stages to omit for this proof only. The recognised
// names are `simplify`, `eliminate`, `fertilize`, `generalize`, `irrelevance`
// and `induct`; see `prover/waterfall.rhm`'s pipeline comment.
//
// `~disable` removes rules from this proof only. `~use` enables named theorem
// rules for this proof only. `~split` splits the goal on Boolean terms before
// the waterfall; `~choose` supplies existential candidates.
//
// Returns a Map with keys `induct`, `use`, `skip`, `disable`, `split`,
// `choose`, `limit`, and `extensionality`.
fun parse_tactic(stx :: maybe(Syntax)) :: Map:
  match stx
  | #false:
      {#'induct: [],
       #'use: [],
       #'skip: [],
       #'disable: [],
       #'split: [],
       #'choose: [],
       #'limit: #false,
       #'extensionality: []}
  | s :~ Syntax:
      match s
      | '$group; ...': parse_tactic_groups([group, ...])
      | ~else: syntax_error(#'proof, "unknown proof option", s)

fun parse_tactic_groups(groups :: List.of(Syntax)) :: Map:
  recur loop (
        remaining :~ List = groups,
        acc :~ Map = {#'induct: [],
                      #'use: [],
                      #'skip: [],
                      #'disable: [],
                      #'split: [],
                      #'choose: [],
                      #'limit: #false,
                      #'extensionality: []},
        seen :~ List = []):
    match remaining
    | []: acc
    | List.cons(group, rest):
        let rest :~ List = rest
        match group
        | '~induct: [$(n :: Identifier), ...]':
            when seen.contains(#'induct)
            | syntax_error(#'proof, "duplicate `~induct` option", group)
            let names = [Syntax.unwrap(n), ...]
            when names.length() == 0
            | syntax_error(
                #'proof,
                "`~induct` expects one nonempty bracketed list of identifiers",
                group)
            loop(rest,
                 acc ++ {#'induct: names},
                 List.cons(#'induct, seen))
        | '~induct: $arg; ...':
            when seen.contains(#'induct)
            | syntax_error(#'proof, "duplicate `~induct` option", group)
            syntax_error(
              #'proof,
              "`~induct` expects one nonempty bracketed list of identifiers",
              group)
        | '~extensionality: [$(n :: Identifier), ...]':
            when seen.contains(#'extensionality)
            | syntax_error(
                #'proof, "duplicate `~extensionality` option", group)
            let names = [Syntax.unwrap(n), ...]
            when names.length() == 0
            | syntax_error(
                #'proof,
                "`~extensionality` expects one nonempty bracketed list of identifiers",
                group)
            loop(rest,
                 acc ++ {#'extensionality: names},
                 List.cons(#'extensionality, seen))
        | '~extensionality: $arg; ...':
            when seen.contains(#'extensionality)
            | syntax_error(
                #'proof, "duplicate `~extensionality` option", group)
            syntax_error(
              #'proof,
              "`~extensionality` expects one nonempty bracketed list of identifiers",
              group)
        | '~use: [$(u :: Identifier), ...]':
            when seen.contains(#'use)
            | syntax_error(#'proof, "duplicate `~use` option", group)
            let names = [Syntax.unwrap(u), ...]
            when names.length() == 0
            | syntax_error(
                #'proof,
                "`~use` expects one nonempty bracketed list of theorem names",
                group)
            loop(rest,
                 acc ++ {#'use: names},
                 List.cons(#'use, seen))
        | '~use: $arg; ...':
            when seen.contains(#'use)
            | syntax_error(#'proof, "duplicate `~use` option", group)
            syntax_error(
              #'proof,
              "`~use` expects one nonempty bracketed list of theorem names",
              group)
        | '~skip: [$(d :: Identifier), ...]':
            when seen.contains(#'skip)
            | syntax_error(#'proof, "duplicate `~skip` option", group)
            let names = [Syntax.unwrap(d), ...]
            when names.length() == 0
            | syntax_error(
                #'proof,
                "`~skip` expects one nonempty bracketed list of stage names",
                group)
            loop(rest,
                 acc ++ {#'skip: names},
                 List.cons(#'skip, seen))
        | '~skip: $arg; ...':
            when seen.contains(#'skip)
            | syntax_error(#'proof, "duplicate `~skip` option", group)
            syntax_error(
              #'proof,
              "`~skip` expects one nonempty bracketed list of stage names",
              group)
        | '~disable: [$(r :: Identifier), ...]':
            when seen.contains(#'disable)
            | syntax_error(#'proof, "duplicate `~disable` option", group)
            let names = [Syntax.unwrap(r), ...]
            when names.length() == 0
            | syntax_error(
                #'proof,
                "`~disable` expects one nonempty bracketed list of rule names",
                group)
            loop(rest,
                 acc ++ {#'disable: names},
                 List.cons(#'disable, seen))
        | '~disable: $arg; ...':
            when seen.contains(#'disable)
            | syntax_error(#'proof, "duplicate `~disable` option", group)
            syntax_error(
              #'proof,
              "`~disable` expects one nonempty bracketed list of rule names",
              group)
        | '~split: [$c, ...]':
            when seen.contains(#'split)
            | syntax_error(#'proof, "duplicate `~split` option", group)
            let cases = [c, ...]
            when cases.length() == 0
            | syntax_error(
                #'proof,
                "`~split` expects one nonempty bracketed list of propositions",
                group)
            loop(rest,
                 acc ++ {#'split: cases},
                 List.cons(#'split, seen))
        | '~split: $arg; ...':
            when seen.contains(#'split)
            | syntax_error(#'proof, "duplicate `~split` option", group)
            syntax_error(
              #'proof,
              "`~split` expects one nonempty bracketed list of propositions",
              group)
        | '~choose: [$w, ...]':
            when seen.contains(#'choose)
            | syntax_error(#'proof, "duplicate `~choose` option", group)
            let witnesses = [w, ...]
            when witnesses.length() == 0
            | syntax_error(
                #'proof,
                "`~choose` expects one nonempty bracketed list of expressions",
                group)
            loop(rest,
                 acc ++ {#'choose: witnesses},
                 List.cons(#'choose, seen))
        | '~choose: $arg; ...':
            when seen.contains(#'choose)
            | syntax_error(#'proof, "duplicate `~choose` option", group)
            syntax_error(
              #'proof,
              "`~choose` expects one nonempty bracketed list of expressions",
              group)
        | '~limit: $(n :: Int)':
            let steps = Syntax.unwrap(n)
            unless steps >= 0
            | syntax_error(#'proof, "search steps cannot be negative", group)
            match acc[#'limit]
            | #false:
                loop(rest, acc ++ {#'limit: steps}, seen)
            | ~else:
                syntax_error(#'proof, "duplicate `~limit` option", group)
        | '~limit: $arg; ...':
            syntax_error(#'proof,
                         "`~limit` expects one nonnegative integer",
                         group)
        | ~else:
            syntax_error(#'proof, "unknown proof option", group)
