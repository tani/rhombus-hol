#lang rhombus/static
// SPDX-License-Identifier: 0BSD

// Syntax-level parsing for `theorem` declarations and their adjacent
// `proof:` blocks, with no elaboration against a theory.

export:
  theorem_parts
  proof_groups

// `theorem name: <prop>`, or `#false` if this is not one.
fun theorem_parts(form :: Syntax) :: maybe(List):
  match form
  | 'theorem $(name :: Identifier): $g; ...': [name, [g, ...]]
  | ~else: #false

fun proof_groups(form :: Syntax) :: maybe(List.of(Syntax)):
  match form
  | 'proof: $g; ...': [g, ...]
  | ~else: #false
