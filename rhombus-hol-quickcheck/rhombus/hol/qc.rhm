#lang rhombus/static
// SPDX-License-Identifier: 0BSD
// QuickCheck is a design reference, not a source-license scope; see THIRD_PARTY_NOTICES.


// Random property checking.
//
// This runs at *runtime*, not at compile time, and that is the point: the
// property has to be evaluated by the executable code `type` and `fun` emitted,
// and that code does not exist until the module runs.  Checking it at compile
// time would mean a second interpreter for the same definitions -- exactly the
// drift the one-parser rule exists to prevent.
//
// Generators and shrinkers are emitted per datatype by `module_block.rhm`, from
// the same declaration the logic was built from. They reach `quickcheck`
// through the registry below: `type` registers both under its own name when
// its module runs, and `quickcheck` looks them up under that name.

import:
  lib("racket/base.rkt") as rb

export:
  QCPassed
  QCFailed
  pick
  run
  report
  assert_run
  register_gen
  register_shrink
  lookup_gen
  lookup_shrink

// -- the registry -------------------------------------------------------------
//
// Keyed by the type's name as a string (not a `Symbol`): a name built inside a
// syntax template has to travel as a plain datum, and a symbol written as
// `#'foo` cannot appear inside one -- the quote would close the template.
// Registration and lookup both convert back to a Rhombus value at the ends, so
// this is invisible outside this file.
//
// A generator is registered as a function of a size and one generator per type
// parameter, e.g. `List`'s takes a size and a generator for its element type;
// `Nat`'s takes only a size.  A shrinker takes a value of the type and returns
// smaller candidates; it does not need composing with sub-shrinkers, since
// shrinking recurses on the value's own structure.
def _gens :: MutableMap = MutableMap()
def _shrinks :: MutableMap = MutableMap()

fun register_gen(name :: String, build :: Function) :: Void:
  _gens.set(name, build)

fun register_shrink(name :: String, shrink :: Function) :: Void:
  _shrinks.set(name, shrink)

fun lookup_gen(name :: String) :: Function:
  match _gens.get(name, #false)
  | #false:
      error(~who: #'quickcheck,
            "no generator registered for this type",
            error.val(~label: "type", name))
  | f: f :~ Function

fun lookup_shrink(name :: String) :: Function:
  match _shrinks.get(name, #false)
  | #false:
      error(~who: #'quickcheck,
            "no shrinker registered for this type",
            error.val(~label: "type", name))
  | f: f :~ Function

class.together:
  class QCResult():
    nonfinal
  class QCPassed(samples :: Int):
    extends QCResult
  class QCFailed(inputs :: List, seed :: Int, shrinks :: Int):
    extends QCResult

// Seeded so that a reported counterexample can be reproduced: the seed goes
// into the failure report, and re-running with it gives the same inputs.
fun set_seed(seed :: Int) :: Void:
  rb.#{random-seed}(seed)

fun rand(n :: PosInt) :: Int:
  math.random(n)

// Choose a constructor to build.  At size zero only the non-recursive ones are
// available -- the positivity check guarantees there is at least one, which is
// what makes generation terminate.
fun pick(size :: Int, base :: List, all_of :: List):
  let choices :~ List = (if size <= 0 || all_of.length() == 0 | base | all_of)
  let f = choices[rand(choices.length())]
  (f :~ Function)()

// `gens` build one input each from a size; `prop` is the property; `shrinks`
// produce smaller candidates for one input.
fun run(name :: Symbol,
        ~samples: samples :: Int = 100,
        ~size: size :: Int = 6,
        ~seed: seed :: Int = 20240904,
        ~gens: gens :: List,
        ~shrinks: shrinks :: List,
        ~prop: prop :: Function) :: QCResult:
  set_seed(seed)
  recur loop (i = 0):
    cond
    | i >= samples: QCPassed(samples)
    | ~else:
        let inputs = for List (g in gens): (g :~ Function)(1 + (i mod size))
        cond
        | holds(prop, inputs): loop(i + 1)
        | ~else:
            let (small, n) = shrink(prop, shrinks, inputs)
            QCFailed(small, seed, n)

// Declaration-facing entry point: a falsified property fails immediately;
// a successful check contributes no binding or theorem.
fun assert_run(name :: Symbol,
               ~samples: samples :: Int = 100,
               ~size: size :: Int = 6,
               ~seed: seed :: Int = 20240904,
               ~gens: gens :: List,
               ~shrinks: shrinks :: List,
               ~prop: prop :: Function) :: Void:
  let result = run(name,
                   ~samples: samples,
                   ~size: size,
                   ~seed: seed,
                   ~gens: gens,
                   ~shrinks: shrinks,
                   ~prop: prop)
  match result
  | QCPassed(_): #void
  | failed :: QCFailed:
      error(~who: #'quickcheck, report(name, failed))

fun holds(prop :: Function, inputs :: List) :: Boolean:
  prop(& inputs)

// Greedy, type-directed shrinking: replace one input at a time by a smaller
// candidate, keeping the first replacement that still falsifies the property,
// until nothing smaller does.
fun shrink(prop :: Function, shrinks :: List, inputs :: List)
     :: values(List, Int):
  recur loop (cur :~ List = inputs, n = 0):
    match smaller(prop, shrinks, cur)
    | #false: values(cur, n)
    | next: loop(next :~ List, n + 1)

fun smaller(prop :: Function, shrinks :: List, inputs :: List) :: maybe(List):
  recur outer (i = 0):
    cond
    | i >= inputs.length(): #false
    | ~else:
        let candidates :~ List = ((shrinks[i] :~ Function)(inputs[i]) :~ List)
        recur inner (j = 0):
          cond
          | j >= candidates.length(): outer(i + 1)
          | ~else:
              let next = replace_at(inputs, i, candidates[j])
              (if !holds(prop, next) | next | inner(j + 1))

fun replace_at(l :: List, i :: Int, v) :: List:
  for List (x in l, k in List.iota(l.length())): (if k == i | v | x)

fun report(name :: Symbol, r :: QCResult) :~ String:
  match r
  | QCPassed(n): to_string(name) ++ ": passed " ++ to_string(n) ++ " samples"
  | QCFailed(inputs, seed, n):
      to_string(name) ++ ": counterexample found\n"
        ++ "  inputs: " ++ to_string(inputs) ++ "\n"
        ++ "  seed: " ++ to_string(seed)
        ++ ", shrinks: " ++ to_string(n)
