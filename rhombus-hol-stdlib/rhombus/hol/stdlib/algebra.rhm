#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open
  "integer.rhm" open
  "finite.rhm" open
  "rational.rhm" open
  "algorithm.rhm" open
  "number_theory.rhm" open

export:
  Magma
  magma
  magma_apply
  PointedMagma
  pointed_magma
  pointed_apply
  pointed_identity
  OrderedCarrier
  ordered_carrier
  ordered_le
  bounded_lattice_min
  bounded_lattice_max
  nat_clamp
  endomorphism_iterate

// Structure values package operations; their laws remain theorem hypotheses.
// This keeps data executable without pretending that proof obligations are
// runtime booleans.
type Magma(~a)
| magma(magma_operation :: Function(~a, Function(~a, ~a)))

function magma_apply(m :: Magma(~a), x :: ~a, y :: ~a) :: ~a:
  match m
  | magma(operation): operation(x)(y)

type PointedMagma(~a)
| pointed_magma(pointed_operation :: Function(~a, Function(~a, ~a)), pointed_element :: ~a)

function pointed_apply(m :: PointedMagma(~a), x :: ~a, y :: ~a) :: ~a:
  match m
  | pointed_magma(operation, _): operation(x)(y)

function pointed_identity(m :: PointedMagma(~a)) :: ~a:
  match m
  | pointed_magma(_, identity_element): identity_element

type OrderedCarrier(~a)
| ordered_carrier(ordered_relation :: Function(~a, Function(~a, Boolean)))

function ordered_le(order :: OrderedCarrier(~a), x :: ~a, y :: ~a) :: Boolean:
  match order
  | ordered_carrier(relation): relation(x)(y)

function bounded_lattice_min(x :: Nat, y :: Nat) :: Nat:
  nat_min(x, y)

function bounded_lattice_max(x :: Nat, y :: Nat) :: Nat:
  nat_max(x, y)

function nat_clamp(lower :: Nat, upper :: Nat, x :: Nat) :: Nat:
  nat_max(lower, nat_min(upper, x))

function endomorphism_iterate(f :: Function(~a, ~a), n :: Nat, x :: ~a) :: ~a:
  match n
  | zero(): x
  | succ(k): f(endomorphism_iterate(f, k, x))

theorem ~rewrite_rule iterate_zero:
  forall (f :: Function(~a, ~a), x :: ~a): endomorphism_iterate(f, zero(), x) === x

theorem ~rewrite_rule iterate_succ:
  forall (f :: Function(~a, ~a), n :: Nat, x :: ~a):
    endomorphism_iterate(f, succ(n), x) === f(endomorphism_iterate(f, n, x))

theorem ~rewrite_rule iterate_add:
  forall (f :: Function(~a, ~a), m :: Nat, n :: Nat, x :: ~a):
    endomorphism_iterate(f, nat_add(m, n), x) === endomorphism_iterate(f, m, endomorphism_iterate(f, n, x))
proof:
  auto ~induct: m

theorem ~rewrite_rule nat_min_idempotent:
  forall (n :: Nat): bounded_lattice_min(n, n) === n
proof:
  auto ~induct: n

theorem ~rewrite_rule nat_max_idempotent:
  forall (n :: Nat): bounded_lattice_max(n, n) === n
proof:
  auto ~induct: n

theorem ~rewrite_rule nat_min_zero_left:
  forall (n :: Nat): bounded_lattice_min(zero(), n) === zero()

theorem ~rewrite_rule nat_max_zero_left:
  forall (n :: Nat): bounded_lattice_max(zero(), n) === n
proof:
  auto ~induct: n

theorem ~rewrite_rule nat_clamp_zero:
  forall (upper :: Nat, x :: Nat): nat_clamp(zero(), upper, x) === nat_min(upper, x)
