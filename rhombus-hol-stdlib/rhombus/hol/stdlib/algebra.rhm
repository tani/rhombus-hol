#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open
  "integer.rhm" open
  "finite.rhm" open
  "rational.rhm" open
  "algorithm.rhm" open
  "number_theory.rhm" open

export:
  Magma
  magma
  magma_apply
  PointedMagma
  pointed_magma
  pointed_apply
  pointed_identity
  OrderedCarrier
  ordered_carrier
  ordered_le
  bounded_lattice_min
  bounded_lattice_max
  nat_clamp
  endomorphism_iterate
  magma_associative_at
  magma_commutative_at
  magma_idempotent_at
  pointed_left_identity_at
  pointed_right_identity_at
  ordered_reflexive_at
  ordered_antisymmetric_at
  ordered_transitive_at
  ordered_total_at

// Structure values package operations; their laws remain theorem hypotheses.
// This keeps data executable without pretending that proof obligations are
// runtime booleans.
datatype Magma.of(?a)
| magma(magma_operation :: ?a -> ?a -> ?a)

function magma_apply(m :: Magma.of(?a), x :: ?a, y :: ?a) :: ?a:
  let magma(operation) = m
  operation(x)(y)

datatype PointedMagma.of(?a)
| pointed_magma(pointed_operation :: ?a -> ?a -> ?a, pointed_element :: ?a)

function pointed_apply(m :: PointedMagma.of(?a), x :: ?a, y :: ?a) :: ?a:
  let pointed_magma(operation, _) = m
  operation(x)(y)

function pointed_identity(m :: PointedMagma.of(?a)) :: ?a:
  let pointed_magma(_, identity_element) = m
  identity_element

datatype OrderedCarrier.of(?a)
| ordered_carrier(ordered_relation :: ?a -> ?a -> Boolean)

function ordered_le(order :: OrderedCarrier.of(?a), x :: ?a, y :: ?a) :: Boolean:
  let ordered_carrier(relation) = order
  relation(x)(y)

function bounded_lattice_min(x :: Nat, y :: Nat) :: Nat:
  nat_min(x, y)

function bounded_lattice_max(x :: Nat, y :: Nat) :: Nat:
  nat_max(x, y)

function nat_clamp(lower :: Nat, upper :: Nat, x :: Nat) :: Nat:
  nat_max(lower, nat_min(upper, x))

function endomorphism_iterate(f :: ?a -> ?a, n :: Nat, x :: ?a) :: ?a:
  match n
  | zero(): x
  | succ(k): f(endomorphism_iterate(f, k, x))

function magma_associative_at(m :: Magma.of(?a), x :: ?a, y :: ?a, z :: ?a) :: Boolean:
  magma_apply(m, magma_apply(m, x, y), z) == magma_apply(m, x, magma_apply(m, y, z))

function magma_commutative_at(m :: Magma.of(?a), x :: ?a, y :: ?a) :: Boolean:
  magma_apply(m, x, y) == magma_apply(m, y, x)

function magma_idempotent_at(m :: Magma.of(?a), x :: ?a) :: Boolean:
  magma_apply(m, x, x) == x

function pointed_left_identity_at(m :: PointedMagma.of(?a), x :: ?a) :: Boolean:
  pointed_apply(m, pointed_identity(m), x) == x

function pointed_right_identity_at(m :: PointedMagma.of(?a), x :: ?a) :: Boolean:
  pointed_apply(m, x, pointed_identity(m)) == x

function ordered_reflexive_at(o :: OrderedCarrier.of(?a), x :: ?a) :: Boolean:
  ordered_le(o, x, x)

function ordered_antisymmetric_at(o :: OrderedCarrier.of(?a), x :: ?a, y :: ?a) :: Boolean:
  !(ordered_le(o, x, y) && ordered_le(o, y, x)) || x == y

function ordered_transitive_at(o :: OrderedCarrier.of(?a), x :: ?a, y :: ?a, z :: ?a) :: Boolean:
  !(ordered_le(o, x, y) && ordered_le(o, y, z)) || ordered_le(o, x, z)

function ordered_total_at(o :: OrderedCarrier.of(?a), x :: ?a, y :: ?a) :: Boolean:
  ordered_le(o, x, y) || ordered_le(o, y, x)

theorem iterate_zero:
  forall (f :: ?a -> ?a, x :: ?a): endomorphism_iterate(f, zero(), x) === x
proof:
  ~sorry

theorem iterate_succ:
  forall (f :: ?a -> ?a, n :: Nat, x :: ?a):
    endomorphism_iterate(f, succ(n), x) === f(endomorphism_iterate(f, n, x))
proof:
  ~sorry

theorem iterate_add:
  forall (f :: ?a -> ?a, m :: Nat, n :: Nat, x :: ?a):
    endomorphism_iterate(f, nat_add(m, n), x) === endomorphism_iterate(f, m, endomorphism_iterate(f, n, x))
proof:
  ~induct: [m]
  ~sorry

theorem nat_min_idempotent:
  forall (n :: Nat): bounded_lattice_min(n, n) === n
proof:
  ~induct: [n]
  ~sorry

theorem nat_max_idempotent:
  forall (n :: Nat): bounded_lattice_max(n, n) === n
proof:
  ~induct: [n]
  ~sorry

theorem nat_min_zero_left:
  forall (n :: Nat): bounded_lattice_min(zero(), n) === zero()
proof:
  ~sorry

theorem nat_max_zero_left:
  forall (n :: Nat): bounded_lattice_max(zero(), n) === n
proof:
  ~induct: [n]
  ~sorry

theorem nat_clamp_zero:
  forall (upper :: Nat, x :: Nat): nat_clamp(zero(), upper, x) === nat_min(upper, x)
proof:
  ~sorry

theorem magma_apply_constructor:
  forall (operation :: ?a -> ?a -> ?a, x :: ?a, y :: ?a):
    magma_apply(magma(operation), x, y) === operation(x)(y)
proof:
  ~sorry

theorem pointed_apply_constructor:
  forall (operation :: ?a -> ?a -> ?a, identity_element :: ?a, x :: ?a, y :: ?a):
    pointed_apply(pointed_magma(operation, identity_element), x, y) === operation(x)(y)
proof:
  ~sorry

theorem pointed_identity_constructor:
  forall (operation :: ?a -> ?a -> ?a, identity_element :: ?a):
    pointed_identity(pointed_magma(operation, identity_element)) === identity_element
proof:
  ~sorry

theorem ordered_le_constructor:
  forall (relation :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    ordered_le(ordered_carrier(relation), x, y) <=> relation(x)(y)
proof:
  ~sorry

theorem magma_associative_definition:
  forall (m :: Magma.of(?a), x :: ?a, y :: ?a, z :: ?a):
    magma_associative_at(m, x, y, z) <=> (magma_apply(m, magma_apply(m, x, y), z) === magma_apply(m, x, magma_apply(m, y, z)))
proof:
  ~sorry

theorem magma_commutative_definition:
  forall (m :: Magma.of(?a), x :: ?a, y :: ?a):
    magma_commutative_at(m, x, y) <=> magma_apply(m, x, y) === magma_apply(m, y, x)
proof:
  ~sorry

theorem magma_idempotent_definition:
  forall (m :: Magma.of(?a), x :: ?a):
    magma_idempotent_at(m, x) <=> magma_apply(m, x, x) === x
proof:
  ~sorry

theorem pointed_left_identity_definition:
  forall (m :: PointedMagma.of(?a), x :: ?a):
    pointed_left_identity_at(m, x) <=> pointed_apply(m, pointed_identity(m), x) === x
proof:
  ~sorry

theorem pointed_right_identity_definition:
  forall (m :: PointedMagma.of(?a), x :: ?a):
    pointed_right_identity_at(m, x) <=> pointed_apply(m, x, pointed_identity(m)) === x
proof:
  ~sorry

theorem ordered_reflexive_definition:
  forall (o :: OrderedCarrier.of(?a), x :: ?a):
    ordered_reflexive_at(o, x) <=> ordered_le(o, x, x)
proof:
  ~sorry

theorem ordered_antisymmetric_definition:
  forall (o :: OrderedCarrier.of(?a), x :: ?a, y :: ?a):
    ordered_antisymmetric_at(o, x, y) <=> ((ordered_le(o, x, y) and ordered_le(o, y, x)) ==> x === y)
proof:
  ~sorry

theorem ordered_transitive_definition:
  forall (o :: OrderedCarrier.of(?a), x :: ?a, y :: ?a, z :: ?a):
    ordered_transitive_at(o, x, y, z) <=> ((ordered_le(o, x, y) and ordered_le(o, y, z)) ==> ordered_le(o, x, z))
proof:
  ~sorry

theorem ordered_total_definition:
  forall (o :: OrderedCarrier.of(?a), x :: ?a, y :: ?a):
    ordered_total_at(o, x, y) <=> ordered_le(o, x, y) or ordered_le(o, y, x)
proof:
  ~sorry

theorem nat_add_magma_associative:
  forall (x :: Nat, y :: Nat, z :: Nat):
    magma_associative_at(magma(nat_add), x, y, z)
proof:
  ~use: [add_associative]
  ~sorry

theorem nat_add_magma_commutative:
  forall (x :: Nat, y :: Nat):
    magma_commutative_at(magma(nat_add), x, y)
proof:
  ~use: [add_commutative]
  ~sorry

theorem nat_add_pointed_left_identity:
  forall (x :: Nat):
    pointed_left_identity_at(pointed_magma(nat_add, zero()), x)
proof:
  ~sorry

theorem nat_add_pointed_right_identity:
  forall (x :: Nat):
    pointed_right_identity_at(pointed_magma(nat_add, zero()), x)
proof:
  ~sorry

theorem nat_mul_magma_associative:
  forall (x :: Nat, y :: Nat, z :: Nat):
    magma_associative_at(magma(nat_mul), x, y, z)
proof:
  ~use: [mul_associative]
  ~sorry

theorem nat_mul_magma_commutative:
  forall (x :: Nat, y :: Nat):
    magma_commutative_at(magma(nat_mul), x, y)
proof:
  ~use: [mul_commutative]
  ~sorry

theorem nat_mul_pointed_left_identity:
  forall (x :: Nat):
    pointed_left_identity_at(pointed_magma(nat_mul, nat_one()), x)
proof:
  ~sorry

theorem nat_mul_pointed_right_identity:
  forall (x :: Nat):
    pointed_right_identity_at(pointed_magma(nat_mul, nat_one()), x)
proof:
  ~sorry

theorem nat_order_reflexive:
  forall (x :: Nat):
    ordered_reflexive_at(ordered_carrier(nat_le), x)
proof:
  ~induct: [x]
  ~sorry

theorem nat_order_antisymmetric:
  forall (x :: Nat, y :: Nat):
    ordered_antisymmetric_at(ordered_carrier(nat_le), x, y)
proof:
  ~induct: [x]
  ~use: [le_zero_right]
  ~sorry

theorem nat_order_transitive:
  forall (x :: Nat, y :: Nat, z :: Nat):
    ordered_transitive_at(ordered_carrier(nat_le), x, y, z)
proof:
  ~induct: [x]
  ~sorry

theorem nat_order_total:
  forall (x :: Nat, y :: Nat):
    ordered_total_at(ordered_carrier(nat_le), x, y)
proof:
  ~induct: [y]
  ~sorry

theorem iterate_one:
  forall (f :: ?a -> ?a, x :: ?a):
    endomorphism_iterate(f, nat_one(), x) === f(x)
proof:
  ~sorry

theorem iterate_identity:
  forall (n :: Nat, x :: ?a):
    endomorphism_iterate(identity, n, x) === x
proof:
  ~induct: [n]
  ~sorry
