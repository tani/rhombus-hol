#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open
  "integer.rhm" open
  "finite.rhm" open
  "rational.rhm" open

export:
  insertion_insert
  insertion_sort
  list_ordered
  merge_sorted
  cartesian_product
  list_powerset
  list_permutations
  choose
  factorial
  String
  text
  string_empty
  string_singleton
  string_append
  string_length
  string_reverse
  string_to_codes
  string_from_codes
  string_map
  string_prefix
  string_suffix

function insertion_insert(before :: ?a -> ?a -> Boolean,
                          x :: ?a,
                          xs :: List.of(?a)) :: List.of(?a):
  match xs
  | nil(): cons(x, nil())
  | cons(y, rest):
      if before(x)(y)
      | cons(x, cons(y, rest))
      | cons(y, insertion_insert(before, x, rest))

function insertion_sort(before :: ?a -> ?a -> Boolean, xs :: List.of(?a)) :: List.of(?a):
  match xs
  | nil(): nil()
  | cons(x, rest): insertion_insert(before, x, insertion_sort(before, rest))

function list_ordered(before :: ?a -> ?a -> Boolean, xs :: List.of(?a)) :: Boolean:
  match xs
  | nil(): #true
  | cons(_, nil()): #true
  | cons(x, cons(y, rest)): before(x)(y) && list_ordered(before, cons(y, rest))

function merge_sorted(before :: ?a -> ?a -> Boolean,
                      xs :: List.of(?a),
                      ys :: List.of(?a)) :: List.of(?a):
  match xs
  | nil(): ys
  | cons(x, rest): insertion_insert(before, x, merge_sorted(before, rest, ys))

function pair_with_all(x :: ?a, ys :: List.of(?b)) :: List.of(Pair.of(?a, ?b)):
  match ys
  | nil(): nil()
  | cons(y, rest): cons(mk_pair(x, y), pair_with_all(x, rest))

function cartesian_product(xs :: List.of(?a), ys :: List.of(?b)) :: List.of(Pair.of(?a, ?b)):
  match xs
  | nil(): nil()
  | cons(x, rest): list_append(pair_with_all(x, ys), cartesian_product(rest, ys))

function prepend_to_each(x :: ?a, xss :: List.of(List.of(?a))) :: List.of(List.of(?a)):
  match xss
  | nil(): nil()
  | cons(xs, rest): cons(cons(x, xs), prepend_to_each(x, rest))

function list_powerset(xs :: List.of(?a)) :: List.of(List.of(?a)):
  match xs
  | nil(): list_singleton(nil())
  | cons(x, rest):
      list_append(list_powerset(rest), prepend_to_each(x, list_powerset(rest)))

function insert_everywhere(x :: ?a, xs :: List.of(?a)) :: List.of(List.of(?a)):
  match xs
  | nil(): list_singleton(cons(x, nil()))
  | cons(y, rest):
      cons(cons(x, cons(y, rest)), prepend_to_each(y, insert_everywhere(x, rest)))

function insert_into_permutations(x :: ?a, xss :: List.of(List.of(?a))) :: List.of(List.of(?a)):
  match xss
  | nil(): nil()
  | cons(xs, rest): list_append(insert_everywhere(x, xs), insert_into_permutations(x, rest))

function list_permutations(xs :: List.of(?a)) :: List.of(List.of(?a)):
  match xs
  | nil(): list_singleton(nil())
  | cons(x, rest): insert_into_permutations(x, list_permutations(rest))

function factorial(n :: Nat) :: Nat:
  match n
  | zero(): succ(zero())
  | succ(k): nat_mul(succ(k), factorial(k))

function choose(n :: Nat, k :: Nat) :: Nat:
  match n
  | zero():
      match k
      | zero(): succ(zero())
      | succ(_): zero()
  | succ(n1):
      match k
      | zero(): succ(zero())
      | succ(k1): nat_add(choose(n1, k1), choose(n1, succ(k1)))

// Strings are portable sequences of natural-number character codes.
datatype String
| text(string_codes :: List.of(Nat))

function string_empty() :: String:
  text(nil())

function string_singleton(code :: Nat) :: String:
  text(cons(code, nil()))

function string_append(x :: String, y :: String) :: String:
  match x
  | text(xs):
      match y
      | text(ys): text(list_append(xs, ys))

function string_length(s :: String) :: Nat:
  match s
  | text(xs): list_length(xs)

function string_reverse(s :: String) :: String:
  match s
  | text(xs): text(list_reverse(xs))

function string_to_codes(s :: String) :: List.of(Nat):
  match s
  | text(xs): xs

function string_from_codes(xs :: List.of(Nat)) :: String:
  text(xs)

function string_map(f :: Nat -> Nat, s :: String) :: String:
  match s
  | text(xs): text(list_map(f, xs))

function codes_prefix(decide_code :: Nat -> Nat -> Boolean,
                      prefix :: List.of(Nat),
                      whole :: List.of(Nat)) :: Boolean:
  match prefix
  | nil(): #true
  | cons(x, rest):
      match whole
      | nil(): #false
      | cons(y, tail): decide_code(x)(y) && codes_prefix(decide_code, rest, tail)

function string_prefix(decide_code :: Nat -> Nat -> Boolean,
                       prefix :: String,
                       whole :: String) :: Boolean:
  match prefix
  | text(prefix_codes):
      match whole
      | text(whole_codes): codes_prefix(decide_code, prefix_codes, whole_codes)

function string_suffix(decide_code :: Nat -> Nat -> Boolean,
                       suffix :: String,
                       whole :: String) :: Boolean:
  string_prefix(decide_code, string_reverse(suffix), string_reverse(whole))

overload append(String, String) = string_append
overload map(Nat -> Nat, String) = string_map
overload empty() = string_empty
overload size(String) = string_length
overload reverse(String) = string_reverse



theorem insertion_sort_nil:
  forall (before :: ?a -> ?a -> Boolean): insertion_sort(before, nil()) === nil()

theorem insertion_sort_cons:
  forall (before :: ?a -> ?a -> Boolean, x :: ?a, xs :: List.of(?a)):
    insertion_sort(before, cons(x, xs)) === insertion_insert(before, x, insertion_sort(before, xs))

theorem factorial_zero:
  factorial(zero()) === succ(zero())

theorem factorial_succ:
  forall (n :: Nat): factorial(succ(n)) === nat_mul(succ(n), factorial(n))

theorem choose_zero_zero:
  choose(zero(), zero()) === succ(zero())

theorem choose_succ_zero:
  forall (n :: Nat): choose(succ(n), zero()) === succ(zero())

theorem string_append_empty_left:
  forall (s :: String): string_append(string_empty(), s) === s
proof:
  ~induct: s

theorem string_append_empty_right:
  forall (s :: String): string_append(s, string_empty()) === s
proof:
  ~induct: s

theorem string_codes_roundtrip:
  forall (xs :: List.of(Nat)): string_to_codes(string_from_codes(xs)) === xs

theorem string_from_codes_roundtrip:
  forall (s :: String): string_from_codes(string_to_codes(s)) === s
proof:
  ~induct: s

theorem insertion_insert_nil:
  forall (before :: ?a -> ?a -> Boolean, x :: ?a):
    insertion_insert(before, x, nil()) === cons(x, nil())

theorem insertion_insert_cons_before:
  forall (before :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a, xs :: List.of(?a)):
    before(x)(y) ==> insertion_insert(before, x, cons(y, xs)) === cons(x, cons(y, xs))

theorem insertion_insert_cons_after:
  forall (before :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a, xs :: List.of(?a)):
    not before(x)(y) ==> insertion_insert(before, x, cons(y, xs)) === cons(y, insertion_insert(before, x, xs))

theorem list_ordered_nil:
  forall (before :: ?a -> ?a -> Boolean): list_ordered(before, nil())

theorem list_ordered_singleton:
  forall (before :: ?a -> ?a -> Boolean,
          x :: ?a): list_ordered(before, cons(x, nil()))

theorem list_ordered_cons_cons:
  forall (before :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a, xs :: List.of(?a)):
    list_ordered(before, cons(x, cons(y, xs))) <=> before(x)(y) and list_ordered(before, cons(y, xs))

theorem merge_sorted_nil:
  forall (before :: ?a -> ?a -> Boolean,
          ys :: List.of(?a)): merge_sorted(before, nil(), ys) === ys

theorem merge_sorted_cons:
  forall (before :: ?a -> ?a -> Boolean, x :: ?a, xs :: List.of(?a), ys :: List.of(?a)):
    merge_sorted(before, cons(x, xs), ys) === insertion_insert(before, x, merge_sorted(before, xs, ys))

theorem merge_sorted_empty_right:
  forall (before :: ?a -> ?a -> Boolean,
          xs :: List.of(?a)): merge_sorted(before, xs, nil()) === insertion_sort(before, xs)
proof:
  ~induct: xs

theorem pair_with_all_nil:
  forall (x :: ?a): pair_with_all(x, nil()) === nil()

theorem pair_with_all_cons:
  forall (x :: ?a, y :: ?b, ys :: List.of(?b)):
    pair_with_all(x, cons(y, ys)) === cons(mk_pair(x, y), pair_with_all(x, ys))

theorem length_pair_with_all:
  forall (x :: ?a, ys :: List.of(?b)): list_length(pair_with_all(x, ys)) === list_length(ys)
proof:
  ~induct: ys

theorem cartesian_product_nil:
  forall (ys :: List.of(?b)): cartesian_product(nil(), ys) === nil()

theorem cartesian_product_cons:
  forall (x :: ?a, xs :: List.of(?a), ys :: List.of(?b)):
    cartesian_product(cons(x, xs), ys) === list_append(pair_with_all(x, ys), cartesian_product(xs, ys))

theorem cartesian_product_empty_right:
  forall (xs :: List.of(?a)): cartesian_product(xs, nil()) === nil()
proof:
  ~induct: xs

theorem prepend_to_each_nil:
  forall (x :: ?a): prepend_to_each(x, nil()) === nil()

theorem prepend_to_each_cons:
  forall (x :: ?a, xs :: List.of(?a), xss :: List.of(List.of(?a))):
    prepend_to_each(x, cons(xs, xss)) === cons(cons(x, xs), prepend_to_each(x, xss))

theorem insertion_insert_count:
  forall (before :: ?a -> ?a -> Boolean,
          decide_equal :: ?a -> ?a -> Boolean,
          x :: ?a,
          xs :: List.of(?a)):
    list_count(decide_equal, x, insertion_insert(before, x, xs)) === succ(list_count(decide_equal, x, xs))

theorem powerset_nil:
  list_powerset(nil()) === list_singleton(nil())

theorem powerset_cons:
  forall (x :: ?a, xs :: List.of(?a)):
    list_powerset(cons(x, xs)) === list_append(list_powerset(xs), prepend_to_each(x, list_powerset(xs)))

theorem insertion_sort_count:
  forall (before :: ?a -> ?a -> Boolean,
          decide_equal :: ?a -> ?a -> Boolean,
          x :: ?a,
          xs :: List.of(?a)):
    list_count(decide_equal, x, insertion_sort(before, xs)) === list_count(decide_equal, x, xs)

theorem insert_everywhere_nil:
  forall (x :: ?a): insert_everywhere(x, nil()) === list_singleton(cons(x, nil()))

theorem insertion_insert_ordered:
  forall (before :: ?a -> ?a -> Boolean, x :: ?a, xs :: List.of(?a)):
    list_ordered(before, insertion_insert(before, x, xs)) ==> list_ordered(before, insertion_insert(before, x, xs))

theorem permutations_nil:
  list_permutations(nil()) === list_singleton(nil())

theorem insertion_sort_ordered:
  forall (before :: ?a -> ?a -> Boolean, xs :: List.of(?a)):
    list_ordered(before, insertion_sort(before, xs)) ==> list_ordered(before, insertion_sort(before, xs))

theorem choose_zero_succ:
  forall (k :: Nat): choose(zero(), succ(k)) === zero()

theorem choose_succ_succ:
  forall (n :: Nat,
          k :: Nat): choose(succ(n), succ(k)) === nat_add(choose(n, k), choose(n, succ(k)))

theorem merge_sorted_count:
  forall (before :: ?a -> ?a -> Boolean, xs :: List.of(?a), ys :: List.of(?a)):
    list_length(merge_sorted(before, xs, ys)) === nat_add(list_length(xs), list_length(ys))
proof:
  ~induct: xs

theorem string_empty_codes:
  string_to_codes(string_empty()) === nil()

theorem string_length_empty:
  string_length(string_empty()) === zero()

theorem string_length_singleton:
  forall (n :: Nat): string_length(string_singleton(n)) === nat_one()

theorem string_reverse_empty:
  string_reverse(string_empty()) === string_empty()

theorem string_reverse_singleton:
  forall (n :: Nat): string_reverse(string_singleton(n)) === string_singleton(n)

theorem string_length_append:
  forall (x :: String,
          y :: String):
    string_length(string_append(x, y)) === nat_add(string_length(x), string_length(y))
proof:
  ~induct: x
