#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open
  "integer.rhm" open
  "finite.rhm" open
  "rational.rhm" open

export:
  insertion_insert
  insertion_sort
  list_ordered
  merge_sorted
  cartesian_product
  list_powerset
  list_permutations
  choose
  factorial
  String
  text
  string_empty
  string_singleton
  string_append
  string_length
  string_reverse
  string_to_codes
  string_from_codes
  string_map
  string_prefix
  string_suffix


function insertion_insert(before :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a)) :: List(?a):
  match xs
  | nil(): cons(x, nil())
  | cons(y, rest):
      if before(x)(y)
      | cons(x, cons(y, rest))
      | cons(y, insertion_insert(before, x, rest))

function insertion_sort(before :: Function(?a, Function(?a, Boolean)), xs :: List(?a)) :: List(?a):
  match xs
  | nil(): nil()
  | cons(x, rest): insertion_insert(before, x, insertion_sort(before, rest))

function list_ordered(before :: Function(?a, Function(?a, Boolean)), xs :: List(?a)) :: Boolean:
  match xs
  | nil(): #true
  | cons(_, nil()): #true
  | cons(x, cons(y, rest)): before(x)(y) && list_ordered(before, cons(y, rest))

function merge_sorted(before :: Function(?a, Function(?a, Boolean)), xs :: List(?a), ys :: List(?a)) :: List(?a):
  match xs
  | nil(): ys
  | cons(x, rest): insertion_insert(before, x, merge_sorted(before, rest, ys))

function pair_with_all(x :: ?a, ys :: List(?b)) :: List(Pair(?a, ?b)):
  match ys
  | nil(): nil()
  | cons(y, rest): cons(mk_pair(x, y), pair_with_all(x, rest))

function cartesian_product(xs :: List(?a), ys :: List(?b)) :: List(Pair(?a, ?b)):
  match xs
  | nil(): nil()
  | cons(x, rest): list_append(pair_with_all(x, ys), cartesian_product(rest, ys))

function prepend_to_each(x :: ?a, xss :: List(List(?a))) :: List(List(?a)):
  match xss
  | nil(): nil()
  | cons(xs, rest): cons(cons(x, xs), prepend_to_each(x, rest))

function singleton_list(x :: ?a) :: List(?a):
  cons(x, nil())

function list_powerset(xs :: List(?a)) :: List(List(?a)):
  match xs
  | nil(): singleton_list(nil())
  | cons(x, rest):
      list_append(list_powerset(rest), prepend_to_each(x, list_powerset(rest)))

function insert_everywhere(x :: ?a, xs :: List(?a)) :: List(List(?a)):
  match xs
  | nil(): singleton_list(cons(x, nil()))
  | cons(y, rest):
      cons(cons(x, cons(y, rest)), prepend_to_each(y, insert_everywhere(x, rest)))

function insert_into_permutations(x :: ?a, xss :: List(List(?a))) :: List(List(?a)):
  match xss
  | nil(): nil()
  | cons(xs, rest): list_append(insert_everywhere(x, xs), insert_into_permutations(x, rest))

function list_permutations(xs :: List(?a)) :: List(List(?a)):
  match xs
  | nil(): singleton_list(nil())
  | cons(x, rest): insert_into_permutations(x, list_permutations(rest))

function factorial(n :: Nat) :: Nat:
  match n
  | zero(): succ(zero())
  | succ(k): nat_mul(succ(k), factorial(k))

function choose(n :: Nat, k :: Nat) :: Nat:
  match n
  | zero():
      match k
      | zero(): succ(zero())
      | succ(_): zero()
  | succ(n1):
      match k
      | zero(): succ(zero())
      | succ(k1): nat_add(choose(n1, k1), choose(n1, succ(k1)))

// Strings are portable sequences of natural-number character codes.
type String
| text(string_codes :: List(Nat))

function string_empty() :: String:
  text(nil())

function string_singleton(code :: Nat) :: String:
  text(cons(code, nil()))

function string_append(x :: String, y :: String) :: String:
  match x
  | text(xs):
      match y
      | text(ys): text(list_append(xs, ys))

function string_length(s :: String) :: Nat:
  match s
  | text(xs): list_length(xs)

function string_reverse(s :: String) :: String:
  match s
  | text(xs): text(list_reverse(xs))


function string_to_codes(s :: String) :: List(Nat):
  match s
  | text(xs): xs

function string_from_codes(xs :: List(Nat)) :: String:
  text(xs)

function string_map(f :: Function(Nat, Nat), s :: String) :: String:
  match s
  | text(xs): text(list_map(f, xs))

function codes_prefix(decide_code :: Function(Nat, Function(Nat, Boolean)), prefix :: List(Nat), whole :: List(Nat)) :: Boolean:
  match prefix
  | nil(): #true
  | cons(x, rest):
      match whole
      | nil(): #false
      | cons(y, tail): decide_code(x)(y) && codes_prefix(decide_code, rest, tail)

function string_prefix(decide_code :: Function(Nat, Function(Nat, Boolean)), prefix :: String, whole :: String) :: Boolean:
  match prefix
  | text(prefix_codes):
      match whole
      | text(whole_codes): codes_prefix(decide_code, prefix_codes, whole_codes)

function string_suffix(decide_code :: Function(Nat, Function(Nat, Boolean)), suffix :: String, whole :: String) :: Boolean:
  string_prefix(decide_code, string_reverse(suffix), string_reverse(whole))

theorem ~rewrite_rule insertion_sort_nil:
  forall (before :: Function(?a, Function(?a, Boolean))): insertion_sort(before, nil()) === nil()

theorem ~rewrite_rule insertion_sort_cons:
  forall (before :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a)):
    insertion_sort(before, cons(x, xs)) === insertion_insert(before, x, insertion_sort(before, xs))


theorem ~rewrite_rule factorial_zero:
  factorial(zero()) === succ(zero())

theorem ~rewrite_rule factorial_succ:
  forall (n :: Nat): factorial(succ(n)) === nat_mul(succ(n), factorial(n))

theorem ~rewrite_rule choose_zero_zero:
  choose(zero(), zero()) === succ(zero())

theorem ~rewrite_rule choose_succ_zero:
  forall (n :: Nat): choose(succ(n), zero()) === succ(zero())

theorem ~rewrite_rule string_append_empty_left:
  forall (s :: String): string_append(string_empty(), s) === s
proof:
  auto ~induct: s

theorem ~rewrite_rule string_append_empty_right:
  forall (s :: String): string_append(s, string_empty()) === s
proof:
  auto ~induct: s


theorem ~rewrite_rule string_codes_roundtrip:
  forall (xs :: List(Nat)): string_to_codes(string_from_codes(xs)) === xs

theorem ~rewrite_rule string_from_codes_roundtrip:
  forall (s :: String): string_from_codes(string_to_codes(s)) === s
proof:
  auto ~induct: s
