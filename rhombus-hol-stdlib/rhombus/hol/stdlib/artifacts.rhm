#lang rhombus/static

import rhombus/hol/artifact as artifact

export:
  certificate

def chunks = []

fun certificate(scope :: String, name :: Symbol):
  recur loop (remaining :: List = chunks):
    match remaining
    | []: #false
    | List.cons(chunk, rest):
        match artifact.certificate(artifact.decode_rows(chunk :~ String), scope, name)
        | #false: loop(rest)
        | cert: cert
