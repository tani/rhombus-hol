#lang rhombus/hol

import: "list.rhm" open
import: "finite.rhm" open


export:
  NFA
  nfa
  nfa_run
  nfa_accepts
  nfa_determinize
  EpsilonNFA
  epsilon_nfa
  epsilon_nfa_closure
  epsilon_nfa_run
  epsilon_nfa_accepts
  epsilon_nfa_eliminate
  epsilon_nfa_determinize
  DFA
  dfa
  dfa_initial
  dfa_transition
  dfa_final
  dfa_run
  dfa_accepts

datatype DFA.of(?q, ?a)
| dfa(dfa_initial_state :: ?q,
      dfa_transition_function :: ?q -> ?a -> ?q,
      dfa_final_predicate :: ?q -> Boolean)


function dfa_initial(m :: DFA.of(?q, ?a)) :: ?q:
  let dfa(initial, _, _) = m
  initial

function dfa_transition(m :: DFA.of(?q, ?a), q :: ?q, a :: ?a) :: ?q:
  let dfa(_, transition, _) = m
  transition(q)(a)

function dfa_final(m :: DFA.of(?q, ?a), q :: ?q) :: Boolean:
  let dfa(_, _, final) = m
  final(q)

// Keeping the arbitrary starting state private makes the public runner a
// conventional left fold while retaining a useful logical induction equation.
function dfa_run_from(m :: DFA.of(?q, ?a), q :: ?q, word :: List.of(?a)) :: ?q:
  let dfa(_, transition, _) = m
  list_fold_left(transition, q, word)

function dfa_run(m :: DFA.of(?q, ?a), word :: List.of(?a)) :: ?q:
  dfa_run_from(m, dfa_initial(m), word)

function dfa_accepts(m :: DFA.of(?q, ?a), word :: List.of(?a)) :: Boolean:
  dfa_final(m, dfa_run(m, word))

// Nondeterministic automata carry both an equality decision and the complete
// finite state universe. All destination searches traverse that universe
// rather than quantifying over the state type.

datatype NFA.of(?q, ?a)
| nfa(nfa_state_equal :: ?q -> ?q -> Boolean,
      nfa_state_universe :: FiniteSet.of(?q),
      nfa_initial_states :: FiniteSet.of(?q),
      nfa_transition_relation :: ?q -> ?a -> ?q -> Boolean,
      nfa_final_predicate :: ?q -> Boolean)

datatype EpsilonNFA.of(?q, ?a)
| epsilon_nfa(epsilon_nfa_state_equal :: ?q -> ?q -> Boolean,
              epsilon_nfa_state_universe :: FiniteSet.of(?q),
              epsilon_nfa_initial_states :: FiniteSet.of(?q),
              epsilon_nfa_epsilon_relation :: ?q -> ?q -> Boolean,
              epsilon_nfa_transition_relation :: ?q -> ?a -> ?q -> Boolean,
              epsilon_nfa_final_predicate :: ?q -> Boolean)

function finite_relation_has_source(relation :: ?q -> ?q -> Boolean,
                                    sources :: List.of(?q),
                                    destination :: ?q) :: Boolean:
  match sources
  | nil(): #false
  | cons(source, rest):
      relation(source)(destination) || finite_relation_has_source(relation, rest, destination)

function finite_relational_image(decide_equal :: ?q -> ?q -> Boolean,
                                 universe :: FiniteSet.of(?q),
                                 sources :: FiniteSet.of(?q),
                                 relation :: ?q -> ?q -> Boolean) :: FiniteSet.of(?q):
  fset_from_list(
    decide_equal,
    list_filter(
      finite_relation_has_source(relation, fset_to_list(sources)),
      fset_to_list(universe)))

function finite_accepting_set(final :: ?q -> Boolean,
                              states :: FiniteSet.of(?q)) :: Boolean:
  list_any(final, fset_to_list(states))

function nfa_symbol_relation(transition :: ?q -> ?a -> ?q -> Boolean,
                             symbol :: ?a,
                             source :: ?q,
                             destination :: ?q) :: Boolean:
  transition(source)(symbol)(destination)

function nfa_step(m :: NFA.of(?q, ?a),
                  states :: FiniteSet.of(?q),
                  symbol :: ?a) :: FiniteSet.of(?q):
  let nfa(decide_equal, universe, _, transition, _) = m
  finite_relational_image(
    decide_equal,
    universe,
    states,
    nfa_symbol_relation(transition, symbol))

function nfa_run(m :: NFA.of(?q, ?a),
                 word :: List.of(?a)) :: FiniteSet.of(?q):
  let nfa(_, _, initial, _, _) = m
  list_fold_left(nfa_step(m), initial, word)

function nfa_accepts(m :: NFA.of(?q, ?a),
                     word :: List.of(?a)) :: Boolean:
  let nfa(_, _, _, _, final) = m
  finite_accepting_set(final, nfa_run(m, word))

function nfa_determinize(m :: NFA.of(?q, ?a))
    :: DFA.of(FiniteSet.of(?q), ?a):
  let nfa(_, _, initial, _, final) = m
  dfa(initial, nfa_step(m), finite_accepting_set(final))

// Each closure round can add only states from the finite universe. Consuming
// one universe-list cell per round therefore supplies a structural bound.
function bounded_epsilon_closure(decide_equal :: ?q -> ?q -> Boolean,
                                 universe :: FiniteSet.of(?q),
                                 epsilon :: ?q -> ?q -> Boolean,
                                 fuel :: List.of(?q),
                                 states :: FiniteSet.of(?q)) :: FiniteSet.of(?q):
  match fuel
  | nil(): states
  | cons(_, rest):
      bounded_epsilon_closure(
        decide_equal,
        universe,
        epsilon,
        rest,
        fset_union(
          decide_equal,
          finite_relational_image(decide_equal, universe, states, epsilon),
          states))

function epsilon_nfa_closure(m :: EpsilonNFA.of(?q, ?a),
                             states :: FiniteSet.of(?q)) :: FiniteSet.of(?q):
  let epsilon_nfa(decide_equal, universe, _, epsilon, _, _) = m
  bounded_epsilon_closure(
    decide_equal,
    universe,
    epsilon,
    fset_to_list(universe),
    states)

function epsilon_nfa_step(m :: EpsilonNFA.of(?q, ?a),
                          states :: FiniteSet.of(?q),
                          symbol :: ?a) :: FiniteSet.of(?q):
  let epsilon_nfa(decide_equal, universe, _, _, transition, _) = m
  epsilon_nfa_closure(
    m,
    finite_relational_image(
      decide_equal,
      universe,
      states,
      nfa_symbol_relation(transition, symbol)))

function epsilon_nfa_run(m :: EpsilonNFA.of(?q, ?a),
                         word :: List.of(?a)) :: FiniteSet.of(?q):
  let epsilon_nfa(_, _, initial, _, _, _) = m
  list_fold_left(
    epsilon_nfa_step(m),
    epsilon_nfa_closure(m, initial),
    word)

function epsilon_nfa_accepts(m :: EpsilonNFA.of(?q, ?a),
                             word :: List.of(?a)) :: Boolean:
  let epsilon_nfa(_, _, _, _, _, final) = m
  finite_accepting_set(final, epsilon_nfa_run(m, word))

function epsilon_nfa_eliminate_image(
    m :: EpsilonNFA.of(?q, ?a),
    source :: ?q,
    symbol :: ?a) :: FiniteSet.of(?q):
  let epsilon_nfa(decide_equal, universe, _, _, transition, _) = m
  epsilon_nfa_closure(
    m,
    finite_relational_image(
      decide_equal,
      universe,
      epsilon_nfa_closure(
        m,
        fset_insert(decide_equal, source, fset_empty())),
      nfa_symbol_relation(transition, symbol)))

function epsilon_nfa_eliminate_transition(
    m :: EpsilonNFA.of(?q, ?a),
    source :: ?q,
    symbol :: ?a,
    destination :: ?q) :: Boolean:
  let epsilon_nfa(decide_equal, _, _, _, _, _) = m
  fset_member(
    decide_equal,
    destination,
    epsilon_nfa_eliminate_image(m, source, symbol))

function epsilon_nfa_eliminate_final(
    m :: EpsilonNFA.of(?q, ?a),
    state :: ?q) :: Boolean:
  let epsilon_nfa(decide_equal, _, _, _, _, final) = m
  finite_accepting_set(
    final,
    epsilon_nfa_closure(
      m,
      fset_insert(decide_equal, state, fset_empty())))

function epsilon_nfa_eliminate(m :: EpsilonNFA.of(?q, ?a))
    :: NFA.of(?q, ?a):
  let epsilon_nfa(decide_equal, universe, initial, _, _, _) = m
  nfa(
    decide_equal,
    universe,
    initial,
    epsilon_nfa_eliminate_transition(m),
    epsilon_nfa_eliminate_final(m))

function epsilon_nfa_determinize(m :: EpsilonNFA.of(?q, ?a))
    :: DFA.of(FiniteSet.of(?q), ?a):
  let epsilon_nfa(_, _, initial, _, _, final) = m
  dfa(
    epsilon_nfa_closure(m, initial),
    epsilon_nfa_step(m),
    finite_accepting_set(final))

// The well-formedness predicate records the obligations under which bounded
// epsilon elimination faithfully explores the explicit finite universe.

function epsilon_nfa_state_equal_at(
    m :: EpsilonNFA.of(?q, ?a),
    p :: ?q,
    q :: ?q) :: Boolean:
  let epsilon_nfa(decide_equal, _, _, _, _, _) = m
  decide_equal(p)(q)

function epsilon_nfa_universe_contains(
    m :: EpsilonNFA.of(?q, ?a),
    q :: ?q) :: Boolean:
  let epsilon_nfa(decide_equal, universe, _, _, _, _) = m
  fset_member(decide_equal, q, universe)

function epsilon_nfa_initial_contains(
    m :: EpsilonNFA.of(?q, ?a),
    q :: ?q) :: Boolean:
  let epsilon_nfa(decide_equal, _, initial, _, _, _) = m
  fset_member(decide_equal, q, initial)

function epsilon_nfa_epsilon_at(
    m :: EpsilonNFA.of(?q, ?a),
    p :: ?q,
    q :: ?q) :: Boolean:
  let epsilon_nfa(_, _, _, epsilon, _, _) = m
  epsilon(p)(q)

function epsilon_nfa_transition_at(
    m :: EpsilonNFA.of(?q, ?a),
    p :: ?q,
    symbol :: ?a,
    q :: ?q) :: Boolean:
  let epsilon_nfa(_, _, _, _, transition, _) = m
  transition(p)(symbol)(q)



definition epsilon_nfa_well_formed(
    m :: EpsilonNFA.of(?q, ?a))
    :: Boolean:
  (forall (p :: ?q, q :: ?q):
     epsilon_nfa_state_equal_at(m, p, q) <=> p === q)
  and
  (forall (q :: ?q):
     epsilon_nfa_initial_contains(m, q)
       ==> epsilon_nfa_universe_contains(m, q))
  and
  (forall (p :: ?q, q :: ?q):
     epsilon_nfa_universe_contains(m, p)
       ==> epsilon_nfa_epsilon_at(m, p, q)
       ==> epsilon_nfa_universe_contains(m, q))
  and
  (forall (p :: ?q, symbol :: ?a, q :: ?q):
     epsilon_nfa_universe_contains(m, p)
       ==> epsilon_nfa_transition_at(m, p, symbol, q)
       ==> epsilon_nfa_universe_contains(m, q))

// Finite enumeration lemmas.  Equality correctness is explicit because the
// finite-set representation accepts a caller-supplied decision procedure.
theorem fset_member_insert_iff:
  forall (decide_equal :: ?q -> ?q -> Boolean,
          x :: ?q,
          y :: ?q,
          states :: FiniteSet.of(?q)):
    (forall (p :: ?q, q :: ?q):
       decide_equal(p)(q) <=> p === q)
      ==> (fset_member(decide_equal, x, fset_insert(decide_equal, y, states)) <=> (decide_equal(x)(y) or fset_member(decide_equal, x, states)))
proof:
  ~induct: [states]
  ~split: [fset_member(decide_equal, y, states)]
  ~use: [member_cons]

theorem fset_from_list_member_iff:
  forall (decide_equal :: ?q -> ?q -> Boolean,
          x :: ?q,
          xs :: List.of(?q)):
    (forall (p :: ?q, q :: ?q):
       decide_equal(p)(q) <=> p === q)
      ==> (fset_member(decide_equal, x, fset_from_list(decide_equal, xs)) <=> list_member(decide_equal, x, xs))
proof:
  ~induct: [xs]
  ~use: [fset_member_insert_iff,
         member_nil,
         member_cons]

theorem list_member_filter_iff:
  forall (decide_equal :: ?q -> ?q -> Boolean,
          predicate :: ?q -> Boolean,
          x :: ?q,
          xs :: List.of(?q)):
    (forall (p :: ?q, q :: ?q):
       decide_equal(p)(q) <=> p === q)
      ==> (list_member(decide_equal, x, list_filter(predicate, xs)) <=> (list_member(decide_equal, x, xs) and predicate(x)))
proof:
  ~induct: [xs]
  ~use: [member_nil,
         member_cons,
         filter_nil,
         filter_cons_true,
         filter_cons_false]

theorem finite_relation_has_source_iff:
  forall (decide_equal :: ?q -> ?q -> Boolean,
          relation :: ?q -> ?q -> Boolean,
          sources :: List.of(?q),
          destination :: ?q):
    (forall (p :: ?q, q :: ?q):
       decide_equal(p)(q) <=> p === q)
      ==> (finite_relation_has_source(relation, sources, destination) <=> (exists (source :: ?q): list_member(decide_equal, source, sources) and relation(source)(destination)))
proof:
  ~induct: [sources]
  ~use: [member_nil,
         member_cons]

theorem finite_relational_image_member_iff:
  forall (decide_equal :: ?q -> ?q -> Boolean,
          universe :: FiniteSet.of(?q),
          sources :: FiniteSet.of(?q),
          relation :: ?q -> ?q -> Boolean,
          destination :: ?q):
    (forall (p :: ?q, q :: ?q):
       decide_equal(p)(q) <=> p === q)
      ==> (fset_member(decide_equal, destination, finite_relational_image(decide_equal, universe, sources, relation)) <=> (fset_member(decide_equal, destination, universe) and (exists (source :: ?q): fset_member(decide_equal, source, sources) and relation(source)(destination))))
proof:
  ~use: [fset_from_list_member_iff,
         list_member_filter_iff,
         finite_relation_has_source_iff]


theorem finite_accepting_set_iff:
  forall (decide_equal :: ?q -> ?q -> Boolean,
          final :: ?q -> Boolean,
          states :: FiniteSet.of(?q)):
    (forall (p :: ?q, q :: ?q):
       decide_equal(p)(q) <=> p === q)
      ==> (finite_accepting_set(final, states) <=> (exists (q :: ?q): fset_member(decide_equal, q, states) and final(q)))
proof:
  ~induct: [states]
  ~use: [member_nil,
         member_cons,
         any_nil,
         any_cons]

// The subset construction shares its runner with the produced DFA, so
// preservation requires no representation invariant.

theorem nfa_determinize_accepts_iff:
  forall (m :: NFA.of(?q, ?a), word :: List.of(?a)):
    nfa_accepts(m, word)
      <=> dfa_accepts(nfa_determinize(m), word)
proof:
  ~induct: [m]

theorem nfa_determinize_language:
  forall (m :: NFA.of(?q, ?a)):
    nfa_accepts(m)
      === dfa_accepts(nfa_determinize(m))
proof:
  ~extensionality: [word]
  ~use: [nfa_determinize_accepts_iff]

theorem epsilon_nfa_determinize_accepts_iff:
  forall (m :: EpsilonNFA.of(?q, ?a),
          word :: List.of(?a)):
    epsilon_nfa_accepts(m, word)
      <=> dfa_accepts(epsilon_nfa_determinize(m), word)
proof:
  ~induct: [m]

theorem epsilon_nfa_determinize_language:
  forall (m :: EpsilonNFA.of(?q, ?a)):
    epsilon_nfa_accepts(m)
      === dfa_accepts(epsilon_nfa_determinize(m))
proof:
  ~extensionality: [word]
  ~use: [epsilon_nfa_determinize_accepts_iff]

theorem epsilon_nfa_eliminate_accepts_iff:
  forall (m :: EpsilonNFA.of(?q, ?a),
          word :: List.of(?a)):
    epsilon_nfa_well_formed(m)
      ==> (epsilon_nfa_accepts(m, word) <=> nfa_accepts(epsilon_nfa_eliminate(m), word))
proof:
  ~induct: [word]
  ~use: [finite_relational_image_member_iff,
         finite_accepting_set_iff,
         fset_member_insert_iff]

theorem epsilon_nfa_eliminate_language:
  forall (m :: EpsilonNFA.of(?q, ?a)):
    epsilon_nfa_well_formed(m)
      ==> (epsilon_nfa_accepts(m) === nfa_accepts(epsilon_nfa_eliminate(m)))
proof:
  ~extensionality: [word]
  ~use: [epsilon_nfa_eliminate_accepts_iff]
