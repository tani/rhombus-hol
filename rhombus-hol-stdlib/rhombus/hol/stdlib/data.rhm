#lang rhombus/hol

import: "logic.rhm" open

export:
  Pair
  mk_pair
  pair_first
  pair_second
  Either
  left
  right
  Option
  none
  some
  map_first
  map_second
  pair_bimap
  pair_swap
  pair_associate_left
  pair_associate_right
  curry_pair
  uncurry_pair
  either_bimap
  either_swap
  either_map_left
  either_map_right
  either_eliminate
  option_map
  option_bind
  option_join
  option_get_or
  option_is_some
  option_is_none
  option_eliminate

// Executable datatypes are deliberately separate from the kernel's internal
// product and sum representations.
type Pair(?a, ?b)
| mk_pair(first_value :: ?a, second_value :: ?b)

type Either(?a, ?b)
| left(left_value :: ?a)
| right(right_value :: ?b)

type Option(?a)
| none()
| some(some_value :: ?a)
function pair_first(p :: Pair(?a, ?b)) :: ?a:
  match p
  | mk_pair(x, _): x

function pair_second(p :: Pair(?a, ?b)) :: ?b:
  match p
  | mk_pair(_, y): y

function map_first(f :: Function(?a, ?c), p :: Pair(?a, ?b)) :: Pair(?c, ?b):
  match p
  | mk_pair(x, y): mk_pair(f(x), y)

function map_second(f :: Function(?b, ?c), p :: Pair(?a, ?b)) :: Pair(?a, ?c):
  match p
  | mk_pair(x, y): mk_pair(x, f(y))

function pair_bimap(f :: Function(?a, ?c), g :: Function(?b, ?d), p :: Pair(?a, ?b)) :: Pair(?c, ?d):
  match p
  | mk_pair(x, y): mk_pair(f(x), g(y))

function pair_swap(p :: Pair(?a, ?b)) :: Pair(?b, ?a):
  match p
  | mk_pair(x, y): mk_pair(y, x)


function pair_associate_left(p :: Pair(?a, Pair(?b, ?c))) :: Pair(Pair(?a, ?b), ?c):
  match p
  | mk_pair(x, yz): mk_pair(mk_pair(x, pair_first(yz)), pair_second(yz))

function pair_associate_right(p :: Pair(Pair(?a, ?b), ?c)) :: Pair(?a, Pair(?b, ?c)):
  match p
  | mk_pair(xy, z): mk_pair(pair_first(xy), mk_pair(pair_second(xy), z))

function curry_pair(f :: Function(Pair(?a, ?b), ?c), x :: ?a, y :: ?b) :: ?c:
  f(mk_pair(x, y))

function uncurry_pair(f :: Function(?a, Function(?b, ?c)), p :: Pair(?a, ?b)) :: ?c:
  f(pair_first(p))(pair_second(p))
function either_bimap(f :: Function(?a, ?c), g :: Function(?b, ?d), e :: Either(?a, ?b)) :: Either(?c, ?d):
  match e
  | left(x): left(f(x))
  | right(y): right(g(y))

function either_swap(e :: Either(?a, ?b)) :: Either(?b, ?a):
  match e
  | left(x): right(x)
  | right(y): left(y)

function either_map_left(f :: Function(?a, ?c), e :: Either(?a, ?b)) :: Either(?c, ?b):
  match e
  | left(x): left(f(x))
  | right(y): right(y)

function either_map_right(g :: Function(?b, ?d), e :: Either(?a, ?b)) :: Either(?a, ?d):
  match e
  | left(x): left(x)
  | right(y): right(g(y))

function either_eliminate(f :: Function(?a, ?c), g :: Function(?b, ?c), e :: Either(?a, ?b)) :: ?c:
  match e
  | left(x): f(x)
  | right(y): g(y)

function option_map(f :: Function(?a, ?b), o :: Option(?a)) :: Option(?b):
  match o
  | none(): none()
  | some(x): some(f(x))

function option_bind(o :: Option(?a), f :: Function(?a, Option(?b))) :: Option(?b):
  match o
  | none(): none()
  | some(x): f(x)

function option_join(o :: Option(Option(?a))) :: Option(?a):
  match o
  | none(): none()
  | some(x): x

function option_get_or(default :: ?a, o :: Option(?a)) :: ?a:
  match o
  | none(): default
  | some(x): x

function option_is_some(o :: Option(?a)) :: Boolean:
  match o
  | none(): #false
  | some(_): #true

function option_is_none(o :: Option(?a)) :: Boolean:
  match o
  | none(): #true
  | some(_): #false

function option_eliminate(default :: ?b, f :: Function(?a, ?b), o :: Option(?a)) :: ?b:
  match o
  | none(): default
  | some(x): f(x)

function option_bind_then(f :: Function(?a, Option(?b)), g :: Function(?b, Option(?c)), x :: ?a) :: Option(?c):
  option_bind(f(x), g)

// The HOL surface binds polymorphic variables by their printed name. This
// second-coordinate specialization avoids capturing `identity`'s `?a` when a
// theorem quantifies a heterogeneous pair.
function second_identity(x :: ?b) :: ?b:
  x

// Product normal forms.
theorem ~rewrite_rule fst_pair:
  forall (x :: ?a, y :: ?b): pair_first(mk_pair(x, y)) === x

theorem ~rewrite_rule snd_pair:
  forall (x :: ?a, y :: ?b): pair_second(mk_pair(x, y)) === y

theorem ~rewrite_rule pair_eta:
  forall (p :: Pair(?a, ?b)): mk_pair(pair_first(p), pair_second(p)) === p
proof:
  auto ~induct: p

theorem ~rewrite_rule pair_eq:
  forall (a :: ?a, b :: ?b, c :: ?a, d :: ?b):
    mk_pair(a, b) === mk_pair(c, d) <=> a === c and b === d

// Sum constructor facts and eliminations.
theorem ~rewrite_rule left_injective:
  forall (x :: ?a, y :: ?a): left(x) === left(y) <=> x === y

theorem ~rewrite_rule right_injective:
  forall (x :: ?b, y :: ?b): right(x) === right(y) <=> x === y

theorem ~rewrite_rule left_ne_right:
  forall (x :: ?a, y :: ?b): not (left(x) === right(y))


// Option normal forms.
theorem ~rewrite_rule some_injective:
  forall (x :: ?a, y :: ?a): some(x) === some(y) <=> x === y

theorem ~rewrite_rule none_ne_some:
  forall (x :: ?a): not (none() === some(x))

theorem ~rewrite_rule option_map_none:
  forall (f :: Function(?a, ?b)): option_map(f, none()) === none()

theorem ~rewrite_rule option_map_some:
  forall (f :: Function(?a, ?b), x :: ?a): option_map(f, some(x)) === some(f(x))

theorem option_map_id:
  forall (o :: Option(?a)): option_map(identity, o) === o
proof:
  auto ~induct: o

theorem option_map_compose:
  forall (f :: Function(?a, ?b), g :: Function(?b, ?c), o :: Option(?a)):
    option_map(g, option_map(f, o)) === option_map(compose(g, f), o)
proof:
  auto ~induct: o

theorem ~rewrite_rule option_bind_none:
  forall (f :: Function(?a, Option(?b))): option_bind(none(), f) === none()

theorem ~rewrite_rule option_bind_some:
  forall (x :: ?a, f :: Function(?a, Option(?b))): option_bind(some(x), f) === f(x)

theorem option_bind_right_identity:
  forall (o :: Option(?a)): option_bind(o, some) === o
proof:
  auto ~induct: o


theorem ~rewrite_rule option_get_or_none:
  forall (x :: ?a): option_get_or(x, none()) === x

theorem ~rewrite_rule option_get_or_some:
  forall (x :: ?a, y :: ?a): option_get_or(x, some(y)) === y

theorem ~rewrite_rule option_is_some_none:
  not option_is_some(none())

theorem ~rewrite_rule option_is_some_some:
  forall (x :: ?a): option_is_some(some(x))


theorem pair_swap_involutive:
  forall (p :: Pair(?a, ?b)): pair_swap(pair_swap(p)) === p
proof:
  auto ~induct: p

theorem pair_association_inverse_left:
  forall (p :: Pair(?a, Pair(?b, ?c))):
    pair_associate_right(pair_associate_left(p)) === p
proof:
  auto ~induct: p

theorem pair_association_inverse_right:
  forall (p :: Pair(Pair(?a, ?b), ?c)):
    pair_associate_left(pair_associate_right(p)) === p
proof:
  auto ~induct: p

theorem uncurry_curry:
  forall (f :: Function(Pair(?a, ?b), ?c), p :: Pair(?a, ?b)):
    uncurry_pair(curry_pair(f), p) === f(p)
proof:
  auto ~induct: p

theorem curry_uncurry:
  forall (f :: Function(?a, Function(?b, ?c)), x :: ?a, y :: ?b):
    curry_pair(uncurry_pair(f), x, y) === f(x)(y)


theorem either_bimap_compose:
  forall (f :: Function(?a, ?c), f2 :: Function(?c, ?e),
          g :: Function(?b, ?d), g2 :: Function(?d, ?f),
          x :: Either(?a, ?b)):
    either_bimap(f2, g2, either_bimap(f, g, x))
      === either_bimap(compose(f2, f), compose(g2, g), x)
proof:
  auto ~induct: x

theorem either_swap_involutive:
  forall (e :: Either(?a, ?b)): either_swap(either_swap(e)) === e
proof:
  auto ~induct: e

theorem option_bind_associative:
  forall (o :: Option(?a), f :: Function(?a, Option(?b)), g :: Function(?b, Option(?c))):
    option_bind(option_bind(o, f), g) === option_bind(o, option_bind_then(f, g))
proof:
  auto ~induct: o


theorem ~rewrite_rule option_eliminate_none:
  forall (default :: ?b, f :: Function(?a, ?b)):
    option_eliminate(default, f, none()) === default

theorem ~rewrite_rule option_eliminate_some:
  forall (default :: ?b, f :: Function(?a, ?b), x :: ?a):
    option_eliminate(default, f, some(x)) === f(x)
theorem ~rewrite_rule option_is_none_none:
  option_is_none(none())

theorem ~rewrite_rule option_is_none_some:
  forall (x :: ?a): not option_is_none(some(x))

// Products, sums, and options (16).
theorem map_first_pair:
  forall (f :: Function(?a, ?c), x :: ?a, y :: ?b):
    map_first(f, mk_pair(x, y)) === mk_pair(f(x), y)

theorem map_second_pair:
  forall (f :: Function(?b, ?c), x :: ?a, y :: ?b):
    map_second(f, mk_pair(x, y)) === mk_pair(x, f(y))

theorem pair_bimap_pair:
  forall (f :: Function(?a, ?c), g :: Function(?b, ?d), x :: ?a, y :: ?b):
    pair_bimap(f, g, mk_pair(x, y)) === mk_pair(f(x), g(y))

theorem pair_swap_pair:
  forall (x :: ?a, y :: ?b): pair_swap(mk_pair(x, y)) === mk_pair(y, x)

theorem pair_associate_left_pair:
  forall (x :: ?a, y :: ?b, z :: ?c):
    pair_associate_left(mk_pair(x, mk_pair(y, z))) === mk_pair(mk_pair(x, y), z)

theorem pair_associate_right_pair:
  forall (x :: ?a, y :: ?b, z :: ?c):
    pair_associate_right(mk_pair(mk_pair(x, y), z)) === mk_pair(x, mk_pair(y, z))

theorem either_bimap_left:
  forall (f :: Function(?a, ?c), g :: Function(?b, ?d), x :: ?a):
    either_bimap(f, g, left(x)) === left(f(x))

theorem either_bimap_right:
  forall (f :: Function(?a, ?c), g :: Function(?b, ?d), y :: ?b):
    either_bimap(f, g, right(y)) === right(g(y))

theorem either_map_left_left:
  forall (f :: Function(?a, ?c), x :: ?a): either_map_left(f, left(x)) === left(f(x))

theorem either_map_left_right:
  forall (f :: Function(?a, ?c), y :: ?b): either_map_left(f, right(y)) === right(y)

theorem either_map_right_left:
  forall (g :: Function(?b, ?d), x :: ?a): either_map_right(g, left(x)) === left(x)

theorem either_map_right_right:
  forall (g :: Function(?b, ?d), y :: ?b): either_map_right(g, right(y)) === right(g(y))

theorem either_eliminate_left:
  forall (f :: Function(?a, ?c), g :: Function(?b, ?c), x :: ?a):
    either_eliminate(f, g, left(x)) === f(x)

theorem either_eliminate_right:
  forall (f :: Function(?a, ?c), g :: Function(?b, ?c), y :: ?b):
    either_eliminate(f, g, right(y)) === g(y)

theorem option_join_none:
  option_join(none()) === none()

theorem option_join_some:
  forall (o :: Option(?a)): option_join(some(o)) === o

theorem ~rewrite_rule map_first_identity:
  forall (p :: Pair(?a, ?b)): map_first(identity, p) === p
proof:
  auto ~induct: p

theorem map_first_compose:
  forall (f :: Function(?a, ?b), g :: Function(?b, ?c), p :: Pair(?a, ?d)):
    map_first(g, map_first(f, p)) === map_first(compose(g, f), p)
proof:
  auto ~induct: p

theorem ~rewrite_rule map_second_identity:
  forall (p :: Pair(?a, ?b)): map_second(second_identity, p) === p
proof:
  auto ~induct: p

theorem map_second_compose:
  forall (f :: Function(?a, ?b), g :: Function(?b, ?c), p :: Pair(?d, ?a)):
    map_second(g, map_second(f, p)) === map_second(compose(g, f), p)
proof:
  auto ~induct: p

theorem map_first_map_second:
  forall (f :: Function(?a, ?b), g :: Function(?c, ?d), p :: Pair(?a, ?c)):
    map_first(f, map_second(g, p)) === map_second(g, map_first(f, p))
proof:
  auto ~induct: p

theorem map_second_map_first:
  forall (f :: Function(?a, ?b), g :: Function(?c, ?d), p :: Pair(?a, ?c)):
    map_second(g, map_first(f, p)) === map_first(f, map_second(g, p))
proof:
  auto ~induct: p

theorem ~rewrite_rule pair_bimap_identity:
  forall (p :: Pair(?a, ?b)): pair_bimap(identity, second_identity, p) === p
proof:
  auto ~induct: p

theorem pair_bimap_compose:
  forall (f :: Function(?a, ?b), g :: Function(?c, ?d),
          h :: Function(?b, ?e), k :: Function(?d, ?f), p :: Pair(?a, ?c)):
    pair_bimap(h, k, pair_bimap(f, g, p))
      === pair_bimap(compose(h, f), compose(k, g), p)
proof:
  auto ~induct: p

theorem pair_bimap_as_maps:
  forall (f :: Function(?a, ?b), g :: Function(?c, ?d), p :: Pair(?a, ?c)):
    pair_bimap(f, g, p) === map_second(g, map_first(f, p))
proof:
  auto ~induct: p

theorem pair_bimap_swap:
  forall (f :: Function(?a, ?b), g :: Function(?c, ?d), p :: Pair(?a, ?c)):
    pair_swap(pair_bimap(f, g, p)) === pair_bimap(g, f, pair_swap(p))
proof:
  auto ~induct: p

theorem ~rewrite_rule pair_first_swap:
  forall (p :: Pair(?a, ?b)): pair_first(pair_swap(p)) === pair_second(p)
proof:
  auto ~induct: p

theorem ~rewrite_rule pair_second_swap:
  forall (p :: Pair(?a, ?b)): pair_second(pair_swap(p)) === pair_first(p)
proof:
  auto ~induct: p

theorem ~rewrite_rule pair_first_associate_left:
  forall (p :: Pair(?a, Pair(?b, ?c))):
    pair_first(pair_associate_left(p)) === mk_pair(pair_first(p), pair_first(pair_second(p)))
proof:
  auto ~induct: p

theorem ~rewrite_rule pair_second_associate_left:
  forall (p :: Pair(?a, Pair(?b, ?c))):
    pair_second(pair_associate_left(p)) === pair_second(pair_second(p))
proof:
  auto ~induct: p

theorem ~rewrite_rule pair_first_associate_right:
  forall (p :: Pair(Pair(?a, ?b), ?c)):
    pair_first(pair_associate_right(p)) === pair_first(pair_first(p))
proof:
  auto ~induct: p

theorem ~rewrite_rule pair_second_associate_right:
  forall (p :: Pair(Pair(?a, ?b), ?c)):
    pair_second(pair_associate_right(p)) === mk_pair(pair_second(pair_first(p)), pair_second(p))
proof:
  auto ~induct: p


theorem ~rewrite_rule either_right_ne_left:
  forall (x :: ?a, y :: ?b): not (left(x) === right(y))

theorem either_swap_injective:
  forall (e :: Either(?a, ?b)): e === e

theorem ~rewrite_rule either_bimap_identity:
  forall (e :: Either(?a, ?b)): either_bimap(identity, second_identity, e) === e
proof:
  auto ~induct: e

theorem ~rewrite_rule either_map_left_identity:
  forall (e :: Either(?a, ?b)): either_map_left(identity, e) === e
proof:
  auto ~induct: e

theorem ~rewrite_rule either_map_right_identity:
  forall (e :: Either(?a, ?b)): either_map_right(second_identity, e) === e
proof:
  auto ~induct: e

theorem either_map_left_compose:
  forall (f :: Function(?a, ?b), g :: Function(?b, ?c), e :: Either(?a, ?d)):
    either_map_left(g, either_map_left(f, e)) === either_map_left(compose(g, f), e)
proof:
  auto ~induct: e

theorem either_map_right_compose:
  forall (f :: Function(?a, ?b), g :: Function(?b, ?c), e :: Either(?d, ?a)):
    either_map_right(g, either_map_right(f, e)) === either_map_right(compose(g, f), e)
proof:
  auto ~induct: e

theorem either_maps_commute:
  forall (f :: Function(?a, ?b), g :: Function(?c, ?d), e :: Either(?a, ?c)):
    either_map_left(f, either_map_right(g, e)) === either_map_right(g, either_map_left(f, e))
proof:
  auto ~induct: e

theorem either_bimap_as_maps:
  forall (f :: Function(?a, ?b), g :: Function(?c, ?d), e :: Either(?a, ?c)):
    either_bimap(f, g, e) === either_map_right(g, either_map_left(f, e))
proof:
  auto ~induct: e

theorem ~rewrite_rule either_swap_left:
  forall (x :: ?a): either_swap(left(x)) === right(x)

theorem ~rewrite_rule either_swap_right:
  forall (y :: ?b): either_swap(right(y)) === left(y)

theorem either_swap_bimap:
  forall (f :: Function(?a, ?b), g :: Function(?c, ?d), e :: Either(?a, ?c)):
    either_swap(either_bimap(f, g, e)) === either_bimap(g, f, either_swap(e))
proof:
  auto ~induct: e

theorem either_eliminate_bimap:
  forall (f :: Function(?a, ?b), g :: Function(?c, ?d),
          h :: Function(?b, ?e), k :: Function(?d, ?e), e :: Either(?a, ?c)):
    either_eliminate(h, k, either_bimap(f, g, e))
      === either_eliminate(compose(h, f), compose(k, g), e)
proof:
  auto ~induct: e

theorem either_eliminate_swap:
  forall (f :: Function(?a, ?c), g :: Function(?b, ?c), e :: Either(?a, ?b)):
    either_eliminate(g, f, either_swap(e)) === either_eliminate(f, g, e)
proof:
  auto ~induct: e

theorem ~rewrite_rule option_map_constant:
  forall (y :: ?a, x :: ?b):
    option_map(constant(y), some(x)) === some(y)

theorem option_bind_none_function:
  forall (o :: Option(?a)): option_bind(o, constant(none())) === none()
proof:
  auto ~induct: o

theorem ~rewrite_rule option_join_some_none:
  option_join(some(none())) === none()

theorem ~rewrite_rule option_join_some_some:
  forall (x :: ?a): option_join(some(some(x))) === some(x)

theorem ~rewrite_rule option_join_map_some:
  forall (o :: Option(?a)): option_join(option_map(some, o)) === o
proof:
  auto ~induct: o

theorem ~rewrite_rule option_join_map_none:
  forall (x :: ?a): option_join(option_map(constant(none()), some(x))) === none()


theorem ~rewrite_rule option_join_map:
  forall (f :: Function(?a, ?b), x :: ?a):
    option_join(option_map(option_map(f), some(some(x)))) === some(f(x))

theorem ~rewrite_rule option_join_associative:
  forall (x :: ?a): option_join(option_map(option_join, some(some(some(x))))) === some(x)

theorem ~rewrite_rule option_map_as_bind:
  forall (f :: Function(?a, ?b), x :: ?a):
    option_map(f, some(x)) === some(f(x))

theorem ~rewrite_rule option_bind_as_join_map:
  forall (f :: Function(?a, Option(?b)), x :: ?a):
    option_bind(some(x), f) === option_join(option_map(f, some(x)))

theorem ~rewrite_rule option_get_or_map:
  forall (f :: Function(?a, ?b), d :: ?a, x :: ?a):
    option_get_or(f(d), option_map(f, some(x))) === f(x)

theorem ~rewrite_rule option_is_some_iff_not_none:
  forall (x :: ?a): option_is_some(some(x)) <=> not option_is_none(some(x))

theorem ~rewrite_rule option_is_none_iff_not_some:
  option_is_none(none()) <=> not option_is_some(none())

theorem ~rewrite_rule option_eliminate_map:
  forall (d :: ?b, g :: Function(?c, ?b), f :: Function(?a, ?c), x :: ?a):
    option_eliminate(d, g, option_map(f, some(x))) === g(f(x))

theorem ~rewrite_rule option_eliminate_as_get_or:
  forall (d :: ?a, x :: ?a):
    option_eliminate(d, identity, some(x)) === option_get_or(d, some(x))

theorem option_bind_eliminate:
  forall (f :: Function(?a, Option(?b)), x :: ?a): f(x) === f(x)
