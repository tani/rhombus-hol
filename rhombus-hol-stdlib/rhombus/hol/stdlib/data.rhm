#lang rhombus/hol

import: "logic.rhm" open

export:
  pair_first
  pair_second
  Either
  left
  right
  Option
  none
  some
  map_first
  map_second
  pair_bimap
  pair_swap
  pair_associate_left
  pair_associate_right
  curry_pair
  uncurry_pair
  either_bimap
  either_swap
  either_map_left
  either_map_right
  either_eliminate
  option_map
  option_bind
  option_join
  option_get_or
  option_is_some
  option_is_none
  option_eliminate

// `Pair.of` and `Pair(...)` are the language's canonical HOL product.

datatype Either.of(?a, ?b)
| left(left_value :: ?a)
| right(right_value :: ?b)

datatype Option.of(?a)
| none()
| some(some_value :: ?a)

function pair_first(Pair(x, _) :: Pair.of(?a, ?b)) :: ?a:
  x

function pair_second(Pair(_, y) :: Pair.of(?a, ?b)) :: ?b:
  y

function map_first(f :: ?a -> ?c, Pair(x, y) :: Pair.of(?a, ?b)) :: Pair.of(?c, ?b):
  Pair(f(x), y)

function map_second(f :: ?b -> ?c, Pair(x, y) :: Pair.of(?a, ?b)) :: Pair.of(?a, ?c):
  Pair(x, f(y))

function pair_bimap(f :: ?a -> ?c,
                    g :: ?b -> ?d,
                    Pair(x, y) :: Pair.of(?a, ?b)) :: Pair.of(?c, ?d):
  Pair(f(x), g(y))

function pair_swap(Pair(x, y) :: Pair.of(?a, ?b)) :: Pair.of(?b, ?a):
  Pair(y, x)

function pair_associate_left(Pair(x, yz) :: Pair.of(?a, Pair.of(?b, ?c))) :: Pair.of(Pair.of(?a, ?b), ?c):
  Pair(Pair(x, pair_first(yz)), pair_second(yz))

function pair_associate_right(Pair(xy, z) :: Pair.of(Pair.of(?a, ?b), ?c)) :: Pair.of(?a, Pair.of(?b, ?c)):
  Pair(pair_first(xy), Pair(pair_second(xy), z))

function curry_pair(f :: Pair.of(?a, ?b) -> ?c, x :: ?a, y :: ?b) :: ?c:
  f(Pair(x, y))

function uncurry_pair(f :: ?a -> ?b -> ?c, p :: Pair.of(?a, ?b)) :: ?c:
  f(pair_first(p))(pair_second(p))

function either_bimap(f :: ?a -> ?c,
                      g :: ?b -> ?d,
                      e :: Either.of(?a, ?b)) :: Either.of(?c, ?d):
  match e
  | left(x): left(f(x))
  | right(y): right(g(y))

function either_swap(e :: Either.of(?a, ?b)) :: Either.of(?b, ?a):
  match e
  | left(x): right(x)
  | right(y): left(y)

function either_map_left(f :: ?a -> ?c, e :: Either.of(?a, ?b)) :: Either.of(?c, ?b):
  match e
  | left(x): left(f(x))
  | right(y): right(y)

function either_map_right(g :: ?b -> ?d, e :: Either.of(?a, ?b)) :: Either.of(?a, ?d):
  match e
  | left(x): left(x)
  | right(y): right(g(y))

function either_eliminate(f :: ?a -> ?c, g :: ?b -> ?c, e :: Either.of(?a, ?b)) :: ?c:
  match e
  | left(x): f(x)
  | right(y): g(y)

function option_map(f :: ?a -> ?b, o :: Option.of(?a)) :: Option.of(?b):
  match o
  | none(): none()
  | some(x): some(f(x))

function option_bind(o :: Option.of(?a), f :: ?a -> Option.of(?b)) :: Option.of(?b):
  match o
  | none(): none()
  | some(x): f(x)

function option_join(o :: Option.of(Option.of(?a))) :: Option.of(?a):
  match o
  | none(): none()
  | some(x): x

function option_get_or(default :: ?a, o :: Option.of(?a)) :: ?a:
  match o
  | none(): default
  | some(x): x

function option_is_some(o :: Option.of(?a)) :: Boolean:
  match o
  | none(): #false
  | some(_): #true

function option_is_none(o :: Option.of(?a)) :: Boolean:
  match o
  | none(): #true
  | some(_): #false

function option_eliminate(default :: ?b, f :: ?a -> ?b, o :: Option.of(?a)) :: ?b:
  match o
  | none(): default
  | some(x): f(x)

function option_bind_then(f :: ?a -> Option.of(?b),
                          g :: ?b -> Option.of(?c),
                          x :: ?a) :: Option.of(?c):
  option_bind(f(x), g)

overload map(?a -> ?b, Option.of(?a)) = option_map
overload empty() = none


// The HOL surface binds polymorphic variables by their printed name. This
// second-coordinate specialization avoids capturing `identity`'s `?a` when a
// theorem quantifies a heterogeneous pair.
function second_identity(x :: ?b) :: ?b:
  x

// Product normal forms.
theorem fst_pair:
  forall (x :: ?a, y :: ?b): pair_first(Pair(x, y)) === x

theorem snd_pair:
  forall (x :: ?a, y :: ?b): pair_second(Pair(x, y)) === y

theorem pair_eta:
  forall (p :: Pair.of(?a, ?b)): Pair(pair_first(p), pair_second(p)) === p

theorem pair_eq:
  forall (a :: ?a, b :: ?b, c :: ?a, d :: ?b):
    Pair(a, b) === Pair(c, d) <=> a === c and b === d

// Sum constructor facts and eliminations.
theorem left_injective:
  forall (x :: ?a, y :: ?a): left(x) === left(y) <=> x === y

theorem right_injective:
  forall (x :: ?b, y :: ?b): right(x) === right(y) <=> x === y

theorem left_ne_right:
  forall (x :: ?a, y :: ?b): not (left(x) === right(y))

// Option normal forms.
theorem some_injective:
  forall (x :: ?a, y :: ?a): some(x) === some(y) <=> x === y

theorem none_ne_some:
  forall (x :: ?a): not (none() === some(x))

theorem option_map_none:
  forall (f :: ?a -> ?b): option_map(f, none()) === none()

theorem option_map_some:
  forall (f :: ?a -> ?b, x :: ?a): option_map(f, some(x)) === some(f(x))

theorem option_map_id:
  forall (o :: Option.of(?a)): option_map(identity, o) === o
proof:
  ~induct: [o]

theorem option_map_compose:
  forall (f :: ?a -> ?b, g :: ?b -> ?c, o :: Option.of(?a)):
    option_map(g, option_map(f, o)) === option_map(compose(g, f), o)
proof:
  ~induct: [o]

theorem option_bind_none:
  forall (f :: ?a -> Option.of(?b)): option_bind(none(), f) === none()

theorem option_bind_some:
  forall (x :: ?a, f :: ?a -> Option.of(?b)): option_bind(some(x), f) === f(x)

theorem option_bind_right_identity:
  forall (o :: Option.of(?a)): option_bind(o, some) === o
proof:
  ~induct: [o]

theorem option_get_or_none:
  forall (x :: ?a): option_get_or(x, none()) === x

theorem option_get_or_some:
  forall (x :: ?a, y :: ?a): option_get_or(x, some(y)) === y

theorem option_is_some_none:
  not option_is_some(none())

theorem option_is_some_some:
  forall (x :: ?a): option_is_some(some(x))

theorem pair_swap_involutive:
  forall (p :: Pair.of(?a, ?b)): pair_swap(pair_swap(p)) === p

theorem pair_association_inverse_left:
  forall (p :: Pair.of(?a, Pair.of(?b, ?c))):
    pair_associate_right(pair_associate_left(p)) === p

theorem pair_association_inverse_right:
  forall (p :: Pair.of(Pair.of(?a, ?b), ?c)):
    pair_associate_left(pair_associate_right(p)) === p

theorem uncurry_curry:
  forall (f :: Pair.of(?a, ?b) -> ?c, p :: Pair.of(?a, ?b)):
    uncurry_pair(curry_pair(f), p) === f(p)

theorem curry_uncurry:
  forall (f :: ?a -> ?b -> ?c, x :: ?a, y :: ?b):
    curry_pair(uncurry_pair(f), x, y) === f(x)(y)

theorem either_bimap_compose:
  forall (f :: ?a -> ?c, f2 :: ?c -> ?e,
          g :: ?b -> ?d, g2 :: ?d -> ?f,
          x :: Either.of(?a, ?b)):
    either_bimap(f2, g2, either_bimap(f, g, x))
      === either_bimap(compose(f2, f), compose(g2, g), x)
proof:
  ~induct: [x]

theorem either_swap_involutive:
  forall (e :: Either.of(?a, ?b)): either_swap(either_swap(e)) === e
proof:
  ~induct: [e]

theorem option_bind_associative:
  forall (o :: Option.of(?a), f :: ?a -> Option.of(?b), g :: ?b -> Option.of(?c)):
    option_bind(option_bind(o, f), g) === option_bind(o, option_bind_then(f, g))
proof:
  ~induct: [o]

theorem option_eliminate_none:
  forall (default :: ?b, f :: ?a -> ?b):
    option_eliminate(default, f, none()) === default

theorem option_eliminate_some:
  forall (default :: ?b, f :: ?a -> ?b, x :: ?a):
    option_eliminate(default, f, some(x)) === f(x)

theorem option_is_none_none:
  option_is_none(none())

theorem option_is_none_some:
  forall (x :: ?a): not option_is_none(some(x))

// Products, sums, and options (16).
theorem map_first_pair:
  forall (f :: ?a -> ?c, x :: ?a, y :: ?b):
    map_first(f, Pair(x, y)) === Pair(f(x), y)

theorem map_second_pair:
  forall (f :: ?b -> ?c, x :: ?a, y :: ?b):
    map_second(f, Pair(x, y)) === Pair(x, f(y))

theorem pair_bimap_pair:
  forall (f :: ?a -> ?c, g :: ?b -> ?d, x :: ?a, y :: ?b):
    pair_bimap(f, g, Pair(x, y)) === Pair(f(x), g(y))

theorem pair_swap_pair:
  forall (x :: ?a, y :: ?b): pair_swap(Pair(x, y)) === Pair(y, x)

theorem pair_associate_left_pair:
  forall (x :: ?a, y :: ?b, z :: ?c):
    pair_associate_left(Pair(x, Pair(y, z))) === Pair(Pair(x, y), z)

theorem pair_associate_right_pair:
  forall (x :: ?a, y :: ?b, z :: ?c):
    pair_associate_right(Pair(Pair(x, y), z)) === Pair(x, Pair(y, z))

theorem either_bimap_left:
  forall (f :: ?a -> ?c, g :: ?b -> ?d, x :: ?a):
    either_bimap(f, g, left(x)) === left(f(x))

theorem either_bimap_right:
  forall (f :: ?a -> ?c, g :: ?b -> ?d, y :: ?b):
    either_bimap(f, g, right(y)) === right(g(y))

theorem either_map_left_left:
  forall (f :: ?a -> ?c, x :: ?a): either_map_left(f, left(x)) === left(f(x))

theorem either_map_left_right:
  forall (f :: ?a -> ?c, y :: ?b): either_map_left(f, right(y)) === right(y)

theorem either_map_right_left:
  forall (g :: ?b -> ?d, x :: ?a): either_map_right(g, left(x)) === left(x)

theorem either_map_right_right:
  forall (g :: ?b -> ?d, y :: ?b): either_map_right(g, right(y)) === right(g(y))

theorem either_eliminate_left:
  forall (f :: ?a -> ?c, g :: ?b -> ?c, x :: ?a):
    either_eliminate(f, g, left(x)) === f(x)

theorem either_eliminate_right:
  forall (f :: ?a -> ?c, g :: ?b -> ?c, y :: ?b):
    either_eliminate(f, g, right(y)) === g(y)

theorem option_join_none:
  option_join(none()) === none()

theorem option_join_some:
  forall (o :: Option.of(?a)): option_join(some(o)) === o

theorem map_first_identity:
  forall (p :: Pair.of(?a, ?b)): map_first(identity, p) === p

theorem map_first_compose:
  forall (f :: ?a -> ?b, g :: ?b -> ?c, p :: Pair.of(?a, ?d)):
    map_first(g, map_first(f, p)) === map_first(compose(g, f), p)

theorem map_second_identity:
  forall (p :: Pair.of(?a, ?b)): map_second(second_identity, p) === p

theorem map_second_compose:
  forall (f :: ?a -> ?b, g :: ?b -> ?c, p :: Pair.of(?d, ?a)):
    map_second(g, map_second(f, p)) === map_second(compose(g, f), p)

theorem map_first_map_second:
  forall (f :: ?a -> ?b, g :: ?c -> ?d, p :: Pair.of(?a, ?c)):
    map_first(f, map_second(g, p)) === map_second(g, map_first(f, p))

theorem map_second_map_first:
  forall (f :: ?a -> ?b, g :: ?c -> ?d, p :: Pair.of(?a, ?c)):
    map_second(g, map_first(f, p)) === map_first(f, map_second(g, p))

theorem pair_bimap_identity:
  forall (p :: Pair.of(?a, ?b)): pair_bimap(identity, second_identity, p) === p

theorem pair_bimap_compose:
  forall (f :: ?a -> ?b, g :: ?c -> ?d,
          h :: ?b -> ?e, k :: ?d -> ?f, p :: Pair.of(?a, ?c)):
    pair_bimap(h, k, pair_bimap(f, g, p))
      === pair_bimap(compose(h, f), compose(k, g), p)

theorem pair_bimap_as_maps:
  forall (f :: ?a -> ?b, g :: ?c -> ?d, p :: Pair.of(?a, ?c)):
    pair_bimap(f, g, p) === map_second(g, map_first(f, p))

theorem pair_bimap_swap:
  forall (f :: ?a -> ?b, g :: ?c -> ?d, p :: Pair.of(?a, ?c)):
    pair_swap(pair_bimap(f, g, p)) === pair_bimap(g, f, pair_swap(p))

theorem pair_first_swap:
  forall (p :: Pair.of(?a, ?b)): pair_first(pair_swap(p)) === pair_second(p)

theorem pair_second_swap:
  forall (p :: Pair.of(?a, ?b)): pair_second(pair_swap(p)) === pair_first(p)

theorem pair_first_associate_left:
  forall (p :: Pair.of(?a, Pair.of(?b, ?c))):
    pair_first(pair_associate_left(p)) === Pair(pair_first(p), pair_first(pair_second(p)))

theorem pair_second_associate_left:
  forall (p :: Pair.of(?a, Pair.of(?b, ?c))):
    pair_second(pair_associate_left(p)) === pair_second(pair_second(p))

theorem pair_first_associate_right:
  forall (p :: Pair.of(Pair.of(?a, ?b), ?c)):
    pair_first(pair_associate_right(p)) === pair_first(pair_first(p))

theorem pair_second_associate_right:
  forall (p :: Pair.of(Pair.of(?a, ?b), ?c)):
    pair_second(pair_associate_right(p)) === Pair(pair_second(pair_first(p)), pair_second(p))



theorem either_bimap_identity:
  forall (e :: Either.of(?a, ?b)): either_bimap(identity, second_identity, e) === e
proof:
  ~induct: [e]

theorem either_map_left_identity:
  forall (e :: Either.of(?a, ?b)): either_map_left(identity, e) === e
proof:
  ~induct: [e]

theorem either_map_right_identity:
  forall (e :: Either.of(?a, ?b)): either_map_right(second_identity, e) === e
proof:
  ~induct: [e]

theorem either_map_left_compose:
  forall (f :: ?a -> ?b, g :: ?b -> ?c, e :: Either.of(?a, ?d)):
    either_map_left(g, either_map_left(f, e)) === either_map_left(compose(g, f), e)
proof:
  ~induct: [e]

theorem either_map_right_compose:
  forall (f :: ?a -> ?b, g :: ?b -> ?c, e :: Either.of(?d, ?a)):
    either_map_right(g, either_map_right(f, e)) === either_map_right(compose(g, f), e)
proof:
  ~induct: [e]

theorem either_maps_commute:
  forall (f :: ?a -> ?b, g :: ?c -> ?d, e :: Either.of(?a, ?c)):
    either_map_left(f, either_map_right(g, e)) === either_map_right(g, either_map_left(f, e))
proof:
  ~induct: [e]

theorem either_bimap_as_maps:
  forall (f :: ?a -> ?b, g :: ?c -> ?d, e :: Either.of(?a, ?c)):
    either_bimap(f, g, e) === either_map_right(g, either_map_left(f, e))
proof:
  ~induct: [e]

theorem either_swap_left:
  forall (x :: ?a): either_swap(left(x)) === right(x)

theorem either_swap_right:
  forall (y :: ?b): either_swap(right(y)) === left(y)

theorem either_swap_bimap:
  forall (f :: ?a -> ?b, g :: ?c -> ?d, e :: Either.of(?a, ?c)):
    either_swap(either_bimap(f, g, e)) === either_bimap(g, f, either_swap(e))
proof:
  ~induct: [e]

theorem either_eliminate_bimap:
  forall (f :: ?a -> ?b, g :: ?c -> ?d,
          h :: ?b -> ?e, k :: ?d -> ?e, e :: Either.of(?a, ?c)):
    either_eliminate(h, k, either_bimap(f, g, e))
      === either_eliminate(compose(h, f), compose(k, g), e)
proof:
  ~induct: [e]

theorem either_eliminate_swap:
  forall (f :: ?a -> ?c, g :: ?b -> ?c, e :: Either.of(?a, ?b)):
    either_eliminate(g, f, either_swap(e)) === either_eliminate(f, g, e)
proof:
  ~induct: [e]

theorem option_map_constant:
  forall (y :: ?a, x :: ?b):
    option_map(constant(y), some(x)) === some(y)

theorem option_bind_none_function:
  forall (o :: Option.of(?a)): option_bind(o, constant(none())) === none()
proof:
  ~induct: [o]

theorem option_join_some_none:
  option_join(some(none())) === none()

theorem option_join_some_some:
  forall (x :: ?a): option_join(some(some(x))) === some(x)

theorem option_join_map_some:
  forall (o :: Option.of(?a)): option_join(option_map(some, o)) === o
proof:
  ~induct: [o]

theorem option_join_map_none:
  forall (x :: ?a): option_join(option_map(constant(none()), some(x))) === none()

theorem option_join_map:
  forall (f :: ?a -> ?b, x :: ?a):
    option_join(option_map(option_map(f), some(some(x)))) === some(f(x))

theorem option_join_associative:
  forall (x :: ?a): option_join(option_map(option_join, some(some(some(x))))) === some(x)


theorem option_bind_as_join_map:
  forall (f :: ?a -> Option.of(?b), x :: ?a):
    option_bind(some(x), f) === option_join(option_map(f, some(x)))

theorem option_get_or_map:
  forall (f :: ?a -> ?b, d :: ?a, x :: ?a):
    option_get_or(f(d), option_map(f, some(x))) === f(x)

theorem option_is_some_iff_not_none:
  forall (x :: ?a): option_is_some(some(x)) <=> not option_is_none(some(x))

theorem option_is_none_iff_not_some:
  option_is_none(none()) <=> not option_is_some(none())

theorem option_eliminate_map:
  forall (d :: ?b, g :: ?c -> ?b, f :: ?a -> ?c, x :: ?a):
    option_eliminate(d, g, option_map(f, some(x))) === g(f(x))

theorem option_eliminate_as_get_or:
  forall (d :: ?a, x :: ?a):
    option_eliminate(d, identity, some(x)) === option_get_or(d, some(x))
