#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open
  "integer.rhm" open

export:
  FiniteSet
  finite_set
  fset_empty
  fset_member
  fset_insert
  fset_delete
  fset_union
  fset_intersection
  fset_difference
  fset_cardinality
  fset_to_list
  fset_from_list
  fset_is_empty
  fset_to_set
  AssociationList
  association_list
  alist_lookup
  alist_delete
  alist_insert
  alist_keys
  alist_values
  FiniteMap
  finite_map
  map_empty
  map_lookup
  map_insert
  map_delete
  map_member
  map_keys
  map_values
  map_map_values
  map_size
  map_to_list

type FiniteSet(?a)
| finite_set(finite_set_items :: List(?a))

function fset_empty() :: FiniteSet(?a):
  finite_set(nil())

function fset_member(decide_equal :: Function(?a, Function(?a, Boolean)), x :: ?a, s :: FiniteSet(?a)) :: Boolean:
  match s
  | finite_set(xs): list_member(decide_equal, x, xs)

function fset_insert(decide_equal :: Function(?a, Function(?a, Boolean)), x :: ?a, s :: FiniteSet(?a)) :: FiniteSet(?a):
  match s
  | finite_set(xs):
      if list_member(decide_equal, x, xs) | finite_set(xs) | finite_set(cons(x, xs))

function list_delete_all(decide_equal :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a)) :: List(?a):
  match xs
  | nil(): nil()
  | cons(y, rest):
      if decide_equal(x)(y)
      | list_delete_all(decide_equal, x, rest)
      | cons(y, list_delete_all(decide_equal, x, rest))

function fset_delete(decide_equal :: Function(?a, Function(?a, Boolean)), x :: ?a, s :: FiniteSet(?a)) :: FiniteSet(?a):
  match s
  | finite_set(xs): finite_set(list_delete_all(decide_equal, x, xs))

function insert_list_into_set(decide_equal :: Function(?a, Function(?a, Boolean)), xs :: List(?a), s :: FiniteSet(?a)) :: FiniteSet(?a):
  match xs
  | nil(): s
  | cons(x, rest): insert_list_into_set(decide_equal, rest, fset_insert(decide_equal, x, s))

function fset_union(decide_equal :: Function(?a, Function(?a, Boolean)), s :: FiniteSet(?a), t :: FiniteSet(?a)) :: FiniteSet(?a):
  match s
  | finite_set(xs): insert_list_into_set(decide_equal, xs, t)

function list_intersection(decide_equal :: Function(?a, Function(?a, Boolean)), xs :: List(?a), t :: FiniteSet(?a)) :: List(?a):
  match xs
  | nil(): nil()
  | cons(x, rest):
      if fset_member(decide_equal, x, t)
      | cons(x, list_intersection(decide_equal, rest, t))
      | list_intersection(decide_equal, rest, t)

function fset_intersection(decide_equal :: Function(?a, Function(?a, Boolean)), s :: FiniteSet(?a), t :: FiniteSet(?a)) :: FiniteSet(?a):
  match s
  | finite_set(xs): finite_set(list_intersection(decide_equal, xs, t))

function list_difference(decide_equal :: Function(?a, Function(?a, Boolean)), xs :: List(?a), t :: FiniteSet(?a)) :: List(?a):
  match xs
  | nil(): nil()
  | cons(x, rest):
      if fset_member(decide_equal, x, t)
      | list_difference(decide_equal, rest, t)
      | cons(x, list_difference(decide_equal, rest, t))

function fset_difference(decide_equal :: Function(?a, Function(?a, Boolean)), s :: FiniteSet(?a), t :: FiniteSet(?a)) :: FiniteSet(?a):
  match s
  | finite_set(xs): finite_set(list_difference(decide_equal, xs, t))

function fset_cardinality(s :: FiniteSet(?a)) :: Nat:
  match s
  | finite_set(xs): list_length(xs)

function fset_to_list(s :: FiniteSet(?a)) :: List(?a):
  match s
  | finite_set(xs): xs

function fset_from_list(decide_equal :: Function(?a, Function(?a, Boolean)),
                        xs :: List(?a)) :: FiniteSet(?a):
  match xs
  | nil(): fset_empty()
  | cons(x, rest): fset_insert(decide_equal, x, fset_from_list(decide_equal, rest))

function fset_is_empty(s :: FiniteSet(?a)) :: Boolean:
  match s
  | finite_set(xs): list_null(xs)

function fset_to_set(decide_equal :: Function(?a, Function(?a, Boolean)), s :: FiniteSet(?a), x :: ?a) :: Boolean:
  fset_member(decide_equal, x, s)

// Association lists intentionally preserve order and shadowing.
type AssociationList(?k, ?v)
| association_list(association_entries :: List(Pair(?k, ?v)))

function alist_lookup(decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k, entries :: List(Pair(?k, ?v))) :: Option(?v):
  match entries
  | nil(): none()
  | cons(entry, rest):
      if decide_key(key)(pair_first(entry))
      | some(pair_second(entry))
      | alist_lookup(decide_key, key, rest)

function alist_delete(decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k, entries :: List(Pair(?k, ?v))) :: List(Pair(?k, ?v)):
  match entries
  | nil(): nil()
  | cons(entry, rest):
      if decide_key(key)(pair_first(entry))
      | alist_delete(decide_key, key, rest)
      | cons(entry, alist_delete(decide_key, key, rest))

function alist_insert(decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k, value :: ?v, entries :: List(Pair(?k, ?v))) :: List(Pair(?k, ?v)):
  cons(mk_pair(key, value), alist_delete(decide_key, key, entries))

function alist_keys(entries :: List(Pair(?k, ?v))) :: List(?k):
  match entries
  | nil(): nil()
  | cons(entry, rest): cons(pair_first(entry), alist_keys(rest))

function alist_values(entries :: List(Pair(?k, ?v))) :: List(?v):
  match entries
  | nil(): nil()
  | cons(entry, rest): cons(pair_second(entry), alist_values(rest))

type FiniteMap(?k, ?v)
| finite_map(map_entries :: List(Pair(?k, ?v)))

function map_empty() :: FiniteMap(?k, ?v):
  finite_map(nil())

function map_lookup(decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k, m :: FiniteMap(?k, ?v)) :: Option(?v):
  match m
  | finite_map(entries): alist_lookup(decide_key, key, entries)

function map_insert(decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k, value :: ?v, m :: FiniteMap(?k, ?v)) :: FiniteMap(?k, ?v):
  match m
  | finite_map(entries): finite_map(alist_insert(decide_key, key, value, entries))

function map_delete(decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k, m :: FiniteMap(?k, ?v)) :: FiniteMap(?k, ?v):
  match m
  | finite_map(entries): finite_map(alist_delete(decide_key, key, entries))

function map_member(decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k, m :: FiniteMap(?k, ?v)) :: Boolean:
  option_is_some(map_lookup(decide_key, key, m))

function map_keys(m :: FiniteMap(?k, ?v)) :: List(?k):
  match m
  | finite_map(entries): alist_keys(entries)

function map_values(m :: FiniteMap(?k, ?v)) :: List(?v):
  match m
  | finite_map(entries): alist_values(entries)

function alist_map_values(f :: Function(?v, ?w), entries :: List(Pair(?k, ?v))) :: List(Pair(?k, ?w)):
  match entries
  | nil(): nil()
  | cons(entry, rest): cons(mk_pair(pair_first(entry), f(pair_second(entry))), alist_map_values(f, rest))

function map_map_values(f :: Function(?v, ?w), m :: FiniteMap(?k, ?v)) :: FiniteMap(?k, ?w):
  match m
  | finite_map(entries): finite_map(alist_map_values(f, entries))

function map_size(m :: FiniteMap(?k, ?v)) :: Nat:
  match m
  | finite_map(entries): list_length(entries)

function map_to_list(m :: FiniteMap(?k, ?v)) :: List(Pair(?k, ?v)):
  match m
  | finite_map(entries): entries

// Finite-set executable characterizations.
theorem ~rewrite_rule fset_member_empty:
  forall (decide_equal :: Function(?a, Function(?a, Boolean)), x :: ?a):
    not fset_member(decide_equal, x, fset_empty())


theorem ~rewrite_rule fset_member_to_set:
  forall (decide_equal :: Function(?a, Function(?a, Boolean)), s :: FiniteSet(?a), x :: ?a):
    fset_to_set(decide_equal, s, x) <=> fset_member(decide_equal, x, s)

theorem ~rewrite_rule fset_cardinality_empty:
  forall (decide_equal :: Function(?a, Function(?a, Boolean))):
    fset_cardinality(fset_empty()) === zero()

// Association-list and finite-map lookup laws. The decider assumptions are
// explicit because executable equality is supplied rather than typeclass-driven.
theorem ~rewrite_rule alist_lookup_nil:
  forall (decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k):
    alist_lookup(decide_key, key, nil()) === none()

theorem ~rewrite_rule alist_lookup_cons_hit:
  forall (decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k, value :: ?v, rest :: List(Pair(?k, ?v))):
    decide_key(key)(key) ==> alist_lookup(decide_key, key, cons(mk_pair(key, value), rest)) === some(value)

theorem ~rewrite_rule map_lookup_empty:
  forall (decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k):
    map_lookup(decide_key, key, map_empty()) === none()

theorem ~rewrite_rule map_lookup_insert_same:
  forall (decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k, value :: ?v, m :: FiniteMap(?k, ?v)):
    decide_key(key)(key) ==> map_lookup(decide_key, key, map_insert(decide_key, key, value, m)) === some(value)


theorem ~rewrite_rule map_values_compose:
  forall (f :: Function(?a, ?b), g :: Function(?b, ?c), m :: FiniteMap(?k, ?a)):
    map_map_values(g, map_map_values(f, m)) === map_map_values(compose(g, f), m)
proof:
  auto ~induct: m

// Finite collections (8).
theorem fset_to_list_empty:
  fset_to_list(fset_empty()) === nil()

theorem alist_delete_nil:
  forall (decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k):
    alist_delete(decide_key, key, nil()) === nil()

theorem alist_keys_nil:
  alist_keys(nil()) === nil()

theorem alist_values_nil:
  alist_values(nil()) === nil()

theorem map_member_empty:
  forall (decide_key :: Function(?k, Function(?k, Boolean)), key :: ?k):
    not map_member(decide_key, key, map_empty())

theorem map_keys_empty:
  map_keys(map_empty()) === nil()

theorem map_values_empty:
  map_values(map_empty()) === nil()

theorem map_map_values_empty:
  forall (f :: Function(?a, ?b)): map_map_values(f, map_empty()) === map_empty()

theorem fset_to_list_roundtrip: forall (s :: FiniteSet(?a)): finite_set(fset_to_list(s)) === s
theorem fset_cardinality_constructor: forall (xs :: List(?a)): fset_cardinality(finite_set(xs)) === list_length(xs)
theorem fset_member_constructor: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a)): fset_member(d, x, finite_set(xs)) <=> list_member(d, x, xs)
theorem fset_insert_present: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, s :: FiniteSet(?a)): fset_member(d, x, s) ==> fset_insert(d, x, s) === s
theorem fset_insert_absent: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, s :: FiniteSet(?a)): not fset_member(d, x, s) ==> fset_insert(d, x, s) === finite_set(cons(x, fset_to_list(s)))
theorem fset_insert_constructor: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a)): fset_insert(d, x, finite_set(xs)) === if list_member(d, x, xs) | finite_set(xs) | finite_set(cons(x, xs))
theorem fset_delete_constructor: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a)): fset_delete(d, x, finite_set(xs)) === finite_set(list_delete_all(d, x, xs))
theorem fset_union_constructor: forall (d :: Function(?a, Function(?a, Boolean)), xs :: List(?a), t :: FiniteSet(?a)): fset_union(d, finite_set(xs), t) === insert_list_into_set(d, xs, t)
theorem fset_intersection_constructor: forall (d :: Function(?a, Function(?a, Boolean)), xs :: List(?a), t :: FiniteSet(?a)): fset_intersection(d, finite_set(xs), t) === finite_set(list_intersection(d, xs, t))
theorem fset_difference_constructor: forall (d :: Function(?a, Function(?a, Boolean)), xs :: List(?a), t :: FiniteSet(?a)): fset_difference(d, finite_set(xs), t) === finite_set(list_difference(d, xs, t))
theorem fset_from_list_nil: forall (d :: Function(?a, Function(?a, Boolean))): fset_from_list(d, nil()) === fset_empty()

theorem fset_from_list_cons: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a)): fset_from_list(d, cons(x, xs)) === fset_insert(d, x, fset_from_list(d, xs))
theorem fset_from_list_singleton: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a): fset_from_list(d, list_singleton(x)) === finite_set(cons(x, nil()))
theorem fset_is_empty_empty: fset_is_empty(fset_empty())
theorem fset_is_empty_constructor: forall (xs :: List(?a)): fset_is_empty(finite_set(xs)) <=> list_null(xs)
theorem list_delete_all_nil: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a): list_delete_all(d, x, nil()) === nil()
theorem list_delete_all_cons_hit: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a)): d(x)(x) ==> list_delete_all(d, x, cons(x, xs)) === list_delete_all(d, x, xs)
theorem list_delete_all_cons_miss: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a, xs :: List(?a)): not d(x)(y) ==> list_delete_all(d, x, cons(y, xs)) === cons(y, list_delete_all(d, x, xs))
theorem insert_list_into_set_nil: forall (d :: Function(?a, Function(?a, Boolean)), s :: FiniteSet(?a)): insert_list_into_set(d, nil(), s) === s
theorem insert_list_into_set_cons: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a), s :: FiniteSet(?a)): insert_list_into_set(d, cons(x, xs), s) === insert_list_into_set(d, xs, fset_insert(d, x, s))
theorem list_intersection_nil: forall (d :: Function(?a, Function(?a, Boolean)), t :: FiniteSet(?a)): list_intersection(d, nil(), t) === nil()
theorem list_intersection_cons_hit: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a), t :: FiniteSet(?a)): fset_member(d, x, t) ==> list_intersection(d, cons(x, xs), t) === cons(x, list_intersection(d, xs, t))
theorem list_intersection_cons_miss: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a), t :: FiniteSet(?a)): not fset_member(d, x, t) ==> list_intersection(d, cons(x, xs), t) === list_intersection(d, xs, t)
theorem list_difference_nil: forall (d :: Function(?a, Function(?a, Boolean)), t :: FiniteSet(?a)): list_difference(d, nil(), t) === nil()
theorem list_difference_cons_hit: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a), t :: FiniteSet(?a)): fset_member(d, x, t) ==> list_difference(d, cons(x, xs), t) === list_difference(d, xs, t)
theorem list_difference_cons_miss: forall (d :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a), t :: FiniteSet(?a)): not fset_member(d, x, t) ==> list_difference(d, cons(x, xs), t) === cons(x, list_difference(d, xs, t))
theorem alist_lookup_cons_miss: forall (d :: Function(?k, Function(?k, Boolean)), key :: ?k, entry :: Pair(?k, ?v), rest :: List(Pair(?k, ?v))): not d(key)(pair_first(entry)) ==> alist_lookup(d, key, cons(entry, rest)) === alist_lookup(d, key, rest)
theorem alist_delete_cons_hit: forall (d :: Function(?k, Function(?k, Boolean)), key :: ?k, value :: ?v, rest :: List(Pair(?k, ?v))): d(key)(key) ==> alist_delete(d, key, cons(mk_pair(key, value), rest)) === alist_delete(d, key, rest)
theorem alist_delete_cons_miss: forall (d :: Function(?k, Function(?k, Boolean)), key :: ?k, entry :: Pair(?k, ?v), rest :: List(Pair(?k, ?v))): not d(key)(pair_first(entry)) ==> alist_delete(d, key, cons(entry, rest)) === cons(entry, alist_delete(d, key, rest))
theorem alist_insert_definition: forall (d :: Function(?k, Function(?k, Boolean)), key :: ?k, value :: ?v, entries :: List(Pair(?k, ?v))): alist_insert(d, key, value, entries) === cons(mk_pair(key, value), alist_delete(d, key, entries))
theorem alist_insert_lookup_same: forall (d :: Function(?k, Function(?k, Boolean)), key :: ?k, value :: ?v, entries :: List(Pair(?k, ?v))): d(key)(key) ==> alist_lookup(d, key, alist_insert(d, key, value, entries)) === some(value)
theorem alist_keys_cons: forall (key :: ?k, value :: ?v, entries :: List(Pair(?k, ?v))): alist_keys(cons(mk_pair(key, value), entries)) === cons(key, alist_keys(entries))
theorem alist_values_cons: forall (key :: ?k, value :: ?v, entries :: List(Pair(?k, ?v))): alist_values(cons(mk_pair(key, value), entries)) === cons(value, alist_values(entries))
theorem alist_length_keys: forall (entries :: List(Pair(?k, ?v))): list_length(alist_keys(entries)) === list_length(entries)
theorem alist_length_values: forall (entries :: List(Pair(?k, ?v))): list_length(alist_values(entries)) === list_length(entries)
theorem alist_map_values_nil: forall (f :: Function(?v, ?w)): alist_map_values(f, nil()) === nil()
theorem alist_map_values_cons: forall (f :: Function(?v, ?w), key :: ?k, value :: ?v, entries :: List(Pair(?k, ?v))): alist_map_values(f, cons(mk_pair(key, value), entries)) === cons(mk_pair(key, f(value)), alist_map_values(f, entries))
theorem alist_lookup_map_values: forall (f :: Function(?v, ?w), d :: Function(?k, Function(?k, Boolean)), key :: ?k, entries :: List(Pair(?k, ?v))): option_map(f, alist_lookup(d, key, entries)) === alist_lookup(d, key, alist_map_values(f, entries))
theorem map_lookup_constructor: forall (d :: Function(?k, Function(?k, Boolean)), key :: ?k, entries :: List(Pair(?k, ?v))): map_lookup(d, key, finite_map(entries)) === alist_lookup(d, key, entries)
theorem map_insert_constructor: forall (d :: Function(?k, Function(?k, Boolean)), key :: ?k, value :: ?v, entries :: List(Pair(?k, ?v))): map_insert(d, key, value, finite_map(entries)) === finite_map(alist_insert(d, key, value, entries))
theorem map_delete_constructor: forall (d :: Function(?k, Function(?k, Boolean)), key :: ?k, entries :: List(Pair(?k, ?v))): map_delete(d, key, finite_map(entries)) === finite_map(alist_delete(d, key, entries))
theorem map_member_lookup: forall (d :: Function(?k, Function(?k, Boolean)), key :: ?k, m :: FiniteMap(?k, ?v)): map_member(d, key, m) <=> option_is_some(map_lookup(d, key, m))
theorem map_delete_empty: forall (d :: Function(?k, Function(?k, Boolean)), key :: ?k): map_delete(d, key, map_empty()) === map_empty()
theorem map_keys_constructor: forall (entries :: List(Pair(?k, ?v))): map_keys(finite_map(entries)) === alist_keys(entries)
theorem map_values_constructor: forall (entries :: List(Pair(?k, ?v))): map_values(finite_map(entries)) === alist_values(entries)
theorem map_size_empty: map_size(map_empty()) === zero()
theorem map_size_constructor: forall (entries :: List(Pair(?k, ?v))): map_size(finite_map(entries)) === list_length(entries)
theorem map_to_list_constructor: forall (entries :: List(Pair(?k, ?v))): map_to_list(finite_map(entries)) === entries
