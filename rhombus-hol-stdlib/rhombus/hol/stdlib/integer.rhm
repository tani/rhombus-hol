#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open

export:
  Integer
  int_nonnegative
  int_negative
  int_negate
  int_abs
  int_add
  int_subtract
  int_multiply
  int_le
  int_lt
  int_sign
  Sign
  sign_negative
  sign_zero
  sign_positive
  int_zero
  int_one
  int_compare
  int_min
  int_max

datatype Integer
| int_nonnegative(nonnegative_value :: Nat)
| int_negative(negative_predecessor :: Nat)

datatype Sign
| sign_negative()
| sign_zero()
| sign_positive()


function int_negate(z :: Integer) :: Integer:
  match z
  | int_nonnegative(zero()): int_nonnegative(zero())
  | int_nonnegative(succ(n)): int_negative(n)
  | int_negative(n): int_nonnegative(succ(n))

function int_abs(z :: Integer) :: Nat:
  match z
  | int_nonnegative(n): n
  | int_negative(n): succ(n)

function int_from_difference(a :: Nat, b :: Nat) :: Integer:
  if nat_le(b, a)
  | int_nonnegative(nat_sub(a, b))
  | int_negative(nat_pred(nat_sub(b, a)))

function int_add(x :: Integer, y :: Integer) :: Integer:
  match x
  | int_nonnegative(a):
      match y
      | int_nonnegative(b): int_nonnegative(nat_add(a, b))
      | int_negative(b): int_from_difference(a, succ(b))
  | int_negative(a):
      match y
      | int_nonnegative(b): int_from_difference(b, succ(a))
      | int_negative(b): int_negative(succ(nat_add(a, b)))

function int_subtract(x :: Integer, y :: Integer) :: Integer:
  int_add(x, int_negate(y))

function int_negative_nat(n :: Nat) :: Integer:
  match n
  | zero(): int_nonnegative(zero())
  | succ(k): int_negative(k)

function int_multiply(x :: Integer, y :: Integer) :: Integer:
  match x
  | int_nonnegative(a):
      match y
      | int_nonnegative(b): int_nonnegative(nat_mul(a, b))
      | int_negative(b): int_negative_nat(nat_mul(a, succ(b)))
  | int_negative(a):
      match y
      | int_nonnegative(b): int_negative_nat(nat_mul(succ(a), b))
      | int_negative(b): int_nonnegative(nat_mul(succ(a), succ(b)))

function int_le(x :: Integer, y :: Integer) :: Boolean:
  match x
  | int_nonnegative(a):
      match y
      | int_nonnegative(b): nat_le(a, b)
      | int_negative(_): #false
  | int_negative(a):
      match y
      | int_nonnegative(_): #true
      | int_negative(b): nat_le(b, a)

function int_lt(x :: Integer, y :: Integer) :: Boolean:
  int_le(x, y) && !(x == y)

function int_sign(x :: Integer) :: Sign:
  match x
  | int_nonnegative(zero()): sign_zero()
  | int_nonnegative(succ(_)): sign_positive()
  | int_negative(_): sign_negative()

function int_zero() :: Integer:
  int_nonnegative(zero())

function int_one() :: Integer:
  int_nonnegative(nat_one())

function int_compare(x :: Integer, y :: Integer) :: Ordering:
  if int_lt(x, y) | less() | (if x == y | equal() | greater())

function int_min(x :: Integer, y :: Integer) :: Integer:
  if int_le(x, y) | x | y

function int_max(x :: Integer, y :: Integer) :: Integer:
  if int_le(x, y) | y | x

overload add(Integer, Integer) = int_add
overload subtract(Integer, Integer) = int_subtract
overload negate(Integer) = int_negate
overload multiply(Integer, Integer) = int_multiply
overload less(Integer, Integer) = int_lt
overload less_equal(Integer, Integer) = int_le
overload greater(
  left :: Integer,
  right :: Integer
) = int_lt(right, left)
overload greater_equal(
  left :: Integer,
  right :: Integer
) = int_le(right, left)
overload compare(Integer, Integer) = int_compare
overload minimum(Integer, Integer) = int_min
overload maximum(Integer, Integer) = int_max



theorem int_negate_zero:
  int_negate(int_nonnegative(zero())) === int_nonnegative(zero())

theorem int_negate_positive:
  forall (n :: Nat): int_negate(int_nonnegative(succ(n))) === int_negative(n)

theorem int_negate_negative:
  forall (n :: Nat): int_negate(int_negative(n)) === int_nonnegative(succ(n))

// FIXME: waterfall automation gap, not a statement/definition bug --
// confirmed with a minimal standalone reproduction (Integer/Nat only,
// no other stdlib dependencies). `~induct: [z]` triggers a needed
// second, automatic induction on the Nat wrapped by `int_nonnegative`;
// in its `zero()` case the residual left after simplification is
// exactly `int_negate(int_nonnegative(zero())) === int_nonnegative(zero())`
// -- int_negate_zero's own statement, and trivially true by int_negate's
// definition (confirmed separately: `int_negate_zero` proves fine on its
// own with zero tactic hints) -- yet neither `~use:
// [int_negate_zero, int_negate_positive, int_negate_negative]`,
// `~skip: [generalize]`, nor a much larger `~limit` change this specific
// residual at all (byte-identical error each time). Left as ~sorry
// pending guidance; a fresh induction/rewriting bug report may be
// warranted rather than a further stdlib-side workaround.
theorem int_negate_involutive:
  forall (z :: Integer): int_negate(int_negate(z)) === z
proof:
  ~sorry

theorem int_abs_nonnegative:
  forall (n :: Nat): int_abs(int_nonnegative(n)) === n

theorem int_abs_negative:
  forall (n :: Nat): int_abs(int_negative(n)) === succ(n)

theorem int_abs_negate:
  forall (z :: Integer): int_abs(int_negate(z)) === int_abs(z)
proof:
  ~induct: [z]

theorem int_add_zero_left:
  forall (z :: Integer): int_add(int_nonnegative(zero()), z) === z
proof:
  ~induct: [z]

theorem int_add_zero_right:
  forall (z :: Integer): int_add(z, int_nonnegative(zero())) === z
proof:
  ~induct: [z]

theorem int_add_inverse_left:
  forall (z :: Integer): int_add(int_negate(z), z) === int_nonnegative(zero())
proof:
  ~induct: [z]
  ~use: [sub_self, le_reflexive]

theorem int_subtract_zero:
  forall (z :: Integer): int_subtract(z, int_nonnegative(zero())) === z

theorem int_subtract_self:
  forall (z :: Integer): int_subtract(z, z) === int_nonnegative(zero())
proof:
  ~induct: [z]
  ~use: [sub_self, le_reflexive]

theorem int_multiply_zero_left:
  forall (z :: Integer): int_multiply(int_nonnegative(zero()), z) === int_nonnegative(zero())
proof:
  ~induct: [z]

theorem int_multiply_zero_right:
  forall (z :: Integer): int_multiply(z, int_nonnegative(zero())) === int_nonnegative(zero())
proof:
  ~induct: [z]

theorem int_nonnegative_add:
  forall (a :: Nat, b :: Nat):
    int_add(int_nonnegative(a), int_nonnegative(b)) === int_nonnegative(nat_add(a, b))

theorem int_nonnegative_multiply:
  forall (a :: Nat, b :: Nat):
    int_multiply(int_nonnegative(a), int_nonnegative(b)) === int_nonnegative(nat_mul(a, b))

theorem int_le_nonnegative:
  forall (a :: Nat, b :: Nat):
    int_le(int_nonnegative(a), int_nonnegative(b)) <=> nat_le(a, b)

theorem int_le_reflexive:
  forall (z :: Integer): int_le(z, z)
proof:
  ~induct: [z]

theorem int_nonnegative_injective:
  forall (a :: Nat, b :: Nat):
    int_nonnegative(a) === int_nonnegative(b) <=> a === b

theorem int_from_difference_same:
  forall (n :: Nat):
    int_from_difference(n, n) === int_zero()
proof:
  ~use: [sub_self, le_reflexive]

theorem int_from_difference_zero_right:
  forall (n :: Nat):
    int_from_difference(n, zero()) === int_nonnegative(n)

theorem int_negative_nat_zero:
  int_negative_nat(zero()) === int_zero()

theorem int_negative_nat_succ:
  forall (n :: Nat):
    int_negative_nat(succ(n)) === int_negative(n)

theorem int_add_negative_negative:
  forall (a :: Nat, b :: Nat):
    int_add(int_negative(a), int_negative(b)) === int_negative(succ(nat_add(a, b)))

// FIXME: waterfall automation gap (diverging search), not a
// statement/definition bug. Isolated with a minimal standalone
// reproduction (Integer/Nat only): even the bare nat-level fact
// `nat_add(a, b) === nat_add(b, a)` -- exactly nat.rhm's own
// add_commutative, already proved there via `~induct: [a]` -- diverges
// ("simplify: proof-search step limit exceeded") when it arises as a
// subgoal here, whether reached via `~use: [add_commutative]` or via
// `~induct: [x]`/`~induct: [x, y]` alone (byte-identical divergence in
// every combination tried). This looks like the rewriter not treating a
// commutativity-shaped fact (lhs and rhs are variants of each other) as
// restricted to fire only "downhill" when it arises this way, causing
// it to oscillate rather than terminate -- see
// backend/proof/automation/rules.rhm's own `permutative` field/comment.
// `~use: [add_commutative]` works fine elsewhere in the stdlib
// (nat.rhm, number_theory.rhm, algebra.rhm) when the surrounding goal
// has other structure to converge on; this goal is exactly the
// symmetric statement itself, with nothing else to anchor rewriting.
// Left as ~sorry pending guidance; likely a genuine prover bug rather
// than a stdlib-side workaround.
theorem int_add_commutative:
  forall (x :: Integer, y :: Integer):
    int_add(x, y) === int_add(y, x)
proof:
  ~sorry

// FIXME: waterfall automation gap (diverging search), not a
// statement/definition bug. Diverges ("simplify: proof-search step
// limit exceeded") with a bare/default proof attempt, and every tactic
// combination tried (~induct: [x], [x,y], [x,y,z]; ~use of nat.rhm's
// add_associative/sub_self/le_reflexive; combinations of both) fails
// identically, including at a much larger ~limit. Left as ~sorry
// pending guidance.
theorem int_add_associative:
  forall (x :: Integer, y :: Integer, z :: Integer):
    int_add(int_add(x, y), z) === int_add(x, int_add(y, z))
proof:
  ~sorry

theorem int_add_inverse_right:
  forall (z :: Integer):
    int_add(z, int_negate(z)) === int_zero()
proof:
  ~induct: [z]
  ~use: [sub_self, le_reflexive]

theorem int_subtract_definition:
  forall (x :: Integer, y :: Integer):
    int_subtract(x, y) === int_add(x, int_negate(y))

// FIXME: same waterfall automation gap as int_add_associative above --
// diverges with a bare proof attempt, and with ~induct: [x] ~use:
// [sub_self, le_reflexive] (this file's own nat_sub(n,n)/nat_le(n,n)
// facts, which fixed int_add_inverse_right's identical shape of
// failure). This theorem's own semantic content depends on
// int_add_associative/int_add_commutative, both already flagged
// ~sorry above for the same reason, so it was always going to hit the
// same wall. Left as ~sorry pending guidance.
theorem int_subtract_add_cancel:
  forall (x :: Integer, y :: Integer):
    int_subtract(int_add(x, y), x) === y
proof:
  ~sorry

// FIXME: same waterfall automation gap as int_add_commutative above --
// diverges with a bare proof attempt. This theorem's content is
// essentially int_add's commutativity restated through int_subtract,
// so it was always going to hit the same wall. Left as ~sorry pending
// guidance.
theorem int_subtract_inverse:
  forall (x :: Integer, y :: Integer):
    int_subtract(x, y) === int_negate(int_subtract(y, x))
proof:
  ~sorry

theorem int_multiply_one_left:
  forall (z :: Integer):
    int_multiply(int_one(), z) === z

theorem int_multiply_one_right:
  forall (z :: Integer):
    int_multiply(z, int_one()) === z

theorem int_multiply_negative_negative:
  forall (a :: Nat, b :: Nat):
    int_multiply(int_negative(a), int_negative(b)) === int_nonnegative(nat_mul(succ(a), succ(b)))

// FIXME: same waterfall automation gap as int_add_commutative above
// (diverging search on a commutativity-shaped goal). Left as ~sorry
// pending guidance.
theorem int_multiply_commutative:
  forall (x :: Integer, y :: Integer):
    int_multiply(x, y) === int_multiply(y, x)
proof:
  ~sorry

// FIXME: waterfall automation gap (diverging search), not a
// statement/definition bug. Semantically depends on
// int_add_associative/int_add_commutative (already flagged ~sorry
// above), so this was always going to hit the same wall; confirmed
// diverging in isolation (minimal standalone reproduction) too. Left
// as ~sorry pending guidance.
theorem int_multiply_associative:
  forall (x :: Integer, y :: Integer, z :: Integer):
    int_multiply(int_multiply(x, y), z) === int_multiply(x, int_multiply(y, z))
proof:
  ~sorry

// FIXME: same gap as int_multiply_associative above (depends on the
// same already-flagged int_add facts). Left as ~sorry pending guidance.
theorem int_multiply_add_left_distributive:
  forall (x :: Integer, y :: Integer, z :: Integer):
    int_multiply(x, int_add(y, z)) === int_add(int_multiply(x, y), int_multiply(x, z))
proof:
  ~sorry

// FIXME: same gap as int_multiply_associative above. Left as ~sorry
// pending guidance.
theorem int_multiply_add_right_distributive:
  forall (x :: Integer, y :: Integer, z :: Integer):
    int_multiply(int_add(x, y), z) === int_add(int_multiply(x, z), int_multiply(y, z))
proof:
  ~sorry

theorem int_le_zero_negative:
  forall (n :: Nat):
    int_le(int_negative(n), int_zero())

theorem int_le_negative_zero:
  forall (n :: Nat):
    not int_le(int_zero(), int_negative(n))

// FIXME: waterfall automation gap (diverging search) with a bare proof
// attempt; ~induct: [x, y, z] alone makes progress (no longer
// diverges) but leaves 4 residual goals still needing nat_le
// transitivity reasoning that further ~use hints didn't close cleanly
// within reasonable effort. Left as ~sorry pending guidance.
theorem int_le_transitive:
  forall (x :: Integer, y :: Integer, z :: Integer):
    int_le(x, y) ==> int_le(y, z) ==> int_le(x, z)
proof:
  ~sorry

// FIXME: waterfall automation gap (diverging search), both with a
// bare proof attempt and with ~induct: [x, y]. Left as ~sorry pending
// guidance.
theorem int_le_antisymmetric:
  forall (x :: Integer, y :: Integer):
    int_le(x, y) ==> int_le(y, x) ==> x === y
proof:
  ~sorry

theorem int_le_total:
  forall (x :: Integer, y :: Integer):
    int_le(x, y) or int_le(y, x)

theorem int_lt_definition:
  forall (x :: Integer, y :: Integer):
    int_lt(x, y) <=> int_le(x, y) and not (x === y)

theorem int_lt_irreflexive:
  forall (x :: Integer):
    not int_lt(x, x)

// FIXME: same waterfall automation gap as int_le_transitive above,
// which this theorem's own content depends on directly. Left as
// ~sorry pending guidance.
theorem int_lt_transitive:
  forall (x :: Integer, y :: Integer, z :: Integer):
    int_lt(x, y) ==> int_lt(y, z) ==> int_lt(x, z)
proof:
  ~sorry

// FIXME: same waterfall automation gap as int_le_antisymmetric above,
// which this theorem's own content depends on directly. Left as
// ~sorry pending guidance.
theorem int_lt_asymmetric:
  forall (x :: Integer, y :: Integer):
    int_lt(x, y) ==> not int_lt(y, x)
proof:
  ~sorry

theorem int_sign_zero:
  int_sign(int_zero()) === sign_zero()

theorem int_sign_positive:
  forall (n :: Nat):
    int_sign(int_nonnegative(succ(n))) === sign_positive()

theorem int_sign_negative:
  forall (n :: Nat):
    int_sign(int_negative(n)) === sign_negative()

theorem int_compare_equal_iff:
  forall (x :: Integer, y :: Integer):
    int_compare(x, y) === equal() <=> x === y

theorem int_compare_less_iff:
  forall (x :: Integer, y :: Integer):
    int_compare(x, y) === less() <=> int_lt(x, y)

theorem int_compare_greater_iff:
  forall (x :: Integer, y :: Integer):
    int_compare(x, y) === greater() <=> not int_le(x, y)

theorem int_min_left:
  forall (x :: Integer, y :: Integer):
    int_le(x, y) ==> int_min(x, y) === x

theorem int_min_right:
  forall (x :: Integer, y :: Integer):
    not int_le(x, y) ==> int_min(x, y) === y

theorem int_max_le_case:
  forall (x :: Integer, y :: Integer):
    int_le(x, y) ==> int_max(x, y) === y

theorem int_max_gt_case:
  forall (x :: Integer, y :: Integer):
    not int_le(x, y) ==> int_max(x, y) === x

theorem int_abs_zero_iff:
  forall (z :: Integer):
    int_abs(z) === zero() <=> z === int_zero()

theorem int_abs_multiply:
  forall (x :: Integer, y :: Integer):
    int_abs(int_multiply(x, y)) === nat_mul(int_abs(x), int_abs(y))
