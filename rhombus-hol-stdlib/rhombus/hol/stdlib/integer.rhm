#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open

export:
  Integer
  int_nonnegative
  int_negative
  int_from_nat
  int_negate
  int_abs
  int_add
  int_subtract
  int_multiply
  int_le
  int_lt
  int_sign
  Sign
  sign_negative
  sign_zero
  sign_positive
  int_zero
  int_one
  int_compare
  int_min
  int_max

type Integer
| int_nonnegative(nonnegative_value :: Nat)
| int_negative(negative_predecessor :: Nat)

type Sign
| sign_negative()
| sign_zero()
| sign_positive()

function int_from_nat(n :: Nat) :: Integer:
  int_nonnegative(n)

function int_negate(z :: Integer) :: Integer:
  match z
  | int_nonnegative(zero()): int_nonnegative(zero())
  | int_nonnegative(succ(n)): int_negative(n)
  | int_negative(n): int_nonnegative(succ(n))

function int_abs(z :: Integer) :: Nat:
  match z
  | int_nonnegative(n): n
  | int_negative(n): succ(n)

function int_from_difference(a :: Nat, b :: Nat) :: Integer:
  if nat_le(b, a)
  | int_nonnegative(nat_sub(a, b))
  | int_negative(nat_pred(nat_sub(b, a)))

function int_add(x :: Integer, y :: Integer) :: Integer:
  match x
  | int_nonnegative(a):
      match y
      | int_nonnegative(b): int_nonnegative(nat_add(a, b))
      | int_negative(b): int_from_difference(a, succ(b))
  | int_negative(a):
      match y
      | int_nonnegative(b): int_from_difference(b, succ(a))
      | int_negative(b): int_negative(succ(nat_add(a, b)))

function int_subtract(x :: Integer, y :: Integer) :: Integer:
  int_add(x, int_negate(y))

function int_negative_nat(n :: Nat) :: Integer:
  match n
  | zero(): int_nonnegative(zero())
  | succ(k): int_negative(k)

function int_multiply(x :: Integer, y :: Integer) :: Integer:
  match x
  | int_nonnegative(a):
      match y
      | int_nonnegative(b): int_nonnegative(nat_mul(a, b))
      | int_negative(b): int_negative_nat(nat_mul(a, succ(b)))
  | int_negative(a):
      match y
      | int_nonnegative(b): int_negative_nat(nat_mul(succ(a), b))
      | int_negative(b): int_nonnegative(nat_mul(succ(a), succ(b)))

function int_le(x :: Integer, y :: Integer) :: Boolean:
  match x
  | int_nonnegative(a):
      match y
      | int_nonnegative(b): nat_le(a, b)
      | int_negative(_): #false
  | int_negative(a):
      match y
      | int_nonnegative(_): #true
      | int_negative(b): nat_le(b, a)

function int_lt(x :: Integer, y :: Integer) :: Boolean:
  int_le(x, y) && !(x == y)

function int_sign(x :: Integer) :: Sign:
  match x
  | int_nonnegative(zero()): sign_zero()
  | int_nonnegative(succ(_)): sign_positive()
  | int_negative(_): sign_negative()

function int_zero() :: Integer:
  int_nonnegative(zero())

function int_one() :: Integer:
  int_nonnegative(nat_one())

function int_compare(x :: Integer, y :: Integer) :: Ordering:
  if int_lt(x, y) | less() | (if x == y | equal() | greater())

function int_min(x :: Integer, y :: Integer) :: Integer:
  if int_le(x, y) | x | y

function int_max(x :: Integer, y :: Integer) :: Integer:
  if int_le(x, y) | y | x

theorem ~rewrite_rule int_negate_zero:
  int_negate(int_nonnegative(zero())) === int_nonnegative(zero())

theorem ~rewrite_rule int_negate_positive:
  forall (n :: Nat): int_negate(int_nonnegative(succ(n))) === int_negative(n)

theorem ~rewrite_rule int_negate_negative:
  forall (n :: Nat): int_negate(int_negative(n)) === int_nonnegative(succ(n))

theorem ~rewrite_rule int_negate_involutive:
  forall (z :: Integer): int_negate(int_negate(z)) === z
proof:
  auto ~induct: z

theorem ~rewrite_rule int_abs_nonnegative:
  forall (n :: Nat): int_abs(int_nonnegative(n)) === n

theorem ~rewrite_rule int_abs_negative:
  forall (n :: Nat): int_abs(int_negative(n)) === succ(n)

theorem ~rewrite_rule int_abs_negate:
  forall (z :: Integer): int_abs(int_negate(z)) === int_abs(z)
proof:
  auto ~induct: z

theorem ~rewrite_rule int_add_zero_left:
  forall (z :: Integer): int_add(int_nonnegative(zero()), z) === z
proof:
  auto ~induct: z

theorem ~rewrite_rule int_add_zero_right:
  forall (z :: Integer): int_add(z, int_nonnegative(zero())) === z
proof:
  auto ~induct: z

theorem ~rewrite_rule int_add_inverse_left:
  forall (z :: Integer): int_add(int_negate(z), z) === int_nonnegative(zero())
proof:
  auto ~induct: z

theorem ~rewrite_rule int_subtract_zero:
  forall (z :: Integer): int_subtract(z, int_nonnegative(zero())) === z

theorem ~rewrite_rule int_subtract_self:
  forall (z :: Integer): int_subtract(z, z) === int_nonnegative(zero())

theorem ~rewrite_rule int_multiply_zero_left:
  forall (z :: Integer): int_multiply(int_nonnegative(zero()), z) === int_nonnegative(zero())
proof:
  auto ~induct: z

theorem ~rewrite_rule int_multiply_zero_right:
  forall (z :: Integer): int_multiply(z, int_nonnegative(zero())) === int_nonnegative(zero())
proof:
  auto ~induct: z

theorem ~rewrite_rule int_from_nat_add:
  forall (a :: Nat, b :: Nat):
    int_add(int_from_nat(a), int_from_nat(b)) === int_from_nat(nat_add(a, b))

theorem ~rewrite_rule int_from_nat_multiply:
  forall (a :: Nat, b :: Nat):
    int_multiply(int_from_nat(a), int_from_nat(b)) === int_from_nat(nat_mul(a, b))

theorem ~rewrite_rule int_le_from_nat:
  forall (a :: Nat, b :: Nat):
    int_le(int_from_nat(a), int_from_nat(b)) <=> nat_le(a, b)

theorem int_le_reflexive:
  forall (z :: Integer): int_le(z, z)
proof:
  auto ~induct: z

theorem int_from_nat_injective: forall (a :: Nat, b :: Nat): int_from_nat(a) === int_from_nat(b) <=> a === b
theorem int_from_difference_same: forall (n :: Nat): int_from_difference(n, n) === int_zero()
theorem int_from_difference_zero_right: forall (n :: Nat): int_from_difference(n, zero()) === int_from_nat(n)
theorem int_negative_nat_zero: int_negative_nat(zero()) === int_zero()
theorem int_negative_nat_succ: forall (n :: Nat): int_negative_nat(succ(n)) === int_negative(n)
theorem int_add_negative_negative: forall (a :: Nat, b :: Nat): int_add(int_negative(a), int_negative(b)) === int_negative(succ(nat_add(a, b)))
theorem int_add_commutative: forall (x :: Integer, y :: Integer): int_add(x, y) === int_add(y, x)
theorem int_add_associative: forall (x :: Integer, y :: Integer, z :: Integer): int_add(int_add(x, y), z) === int_add(x, int_add(y, z))
theorem int_add_inverse_right: forall (z :: Integer): int_add(z, int_negate(z)) === int_zero()
theorem int_subtract_definition: forall (x :: Integer, y :: Integer): int_subtract(x, y) === int_add(x, int_negate(y))
theorem int_subtract_add_cancel: forall (x :: Integer, y :: Integer): int_subtract(int_add(x, y), x) === y
theorem int_subtract_inverse: forall (x :: Integer, y :: Integer): int_subtract(x, y) === int_negate(int_subtract(y, x))
theorem int_multiply_one_left: forall (z :: Integer): int_multiply(int_one(), z) === z
theorem int_multiply_one_right: forall (z :: Integer): int_multiply(z, int_one()) === z
theorem int_multiply_negative_negative: forall (a :: Nat, b :: Nat): int_multiply(int_negative(a), int_negative(b)) === int_nonnegative(nat_mul(succ(a), succ(b)))
theorem int_multiply_commutative: forall (x :: Integer, y :: Integer): int_multiply(x, y) === int_multiply(y, x)
theorem int_multiply_associative: forall (x :: Integer, y :: Integer, z :: Integer): int_multiply(int_multiply(x, y), z) === int_multiply(x, int_multiply(y, z))
theorem int_multiply_add_left_distributive: forall (x :: Integer, y :: Integer, z :: Integer): int_multiply(x, int_add(y, z)) === int_add(int_multiply(x, y), int_multiply(x, z))
theorem int_multiply_add_right_distributive: forall (x :: Integer, y :: Integer, z :: Integer): int_multiply(int_add(x, y), z) === int_add(int_multiply(x, z), int_multiply(y, z))
theorem int_le_zero_negative: forall (n :: Nat): int_le(int_negative(n), int_zero())
theorem int_le_negative_zero: forall (n :: Nat): not int_le(int_zero(), int_negative(n))
theorem int_le_transitive: forall (x :: Integer, y :: Integer, z :: Integer): int_le(x, y) ==> int_le(y, z) ==> int_le(x, z)
theorem int_le_antisymmetric: forall (x :: Integer, y :: Integer): int_le(x, y) ==> int_le(y, x) ==> x === y
theorem int_le_total: forall (x :: Integer, y :: Integer): int_le(x, y) or int_le(y, x)
theorem int_lt_definition: forall (x :: Integer, y :: Integer): int_lt(x, y) <=> int_le(x, y) and not (x === y)
theorem int_lt_irreflexive: forall (x :: Integer): not int_lt(x, x)
theorem int_lt_transitive: forall (x :: Integer, y :: Integer, z :: Integer): int_lt(x, y) ==> int_lt(y, z) ==> int_lt(x, z)
theorem int_lt_asymmetric: forall (x :: Integer, y :: Integer): int_lt(x, y) ==> not int_lt(y, x)
theorem int_sign_zero: int_sign(int_zero()) === sign_zero()
theorem int_sign_positive: forall (n :: Nat): int_sign(int_nonnegative(succ(n))) === sign_positive()
theorem int_sign_negative: forall (n :: Nat): int_sign(int_negative(n)) === sign_negative()
theorem int_compare_equal_iff: forall (x :: Integer, y :: Integer): int_compare(x, y) === equal() <=> x === y
theorem int_compare_less_iff: forall (x :: Integer, y :: Integer): int_compare(x, y) === less() <=> int_lt(x, y)
theorem int_compare_greater_iff: forall (x :: Integer, y :: Integer): int_compare(x, y) === greater() <=> not int_le(x, y)
theorem int_min_left: forall (x :: Integer, y :: Integer): int_le(x, y) ==> int_min(x, y) === x
theorem int_min_right: forall (x :: Integer, y :: Integer): not int_le(x, y) ==> int_min(x, y) === y
theorem int_max_le_case: forall (x :: Integer, y :: Integer): int_le(x, y) ==> int_max(x, y) === y
theorem int_max_gt_case: forall (x :: Integer, y :: Integer): not int_le(x, y) ==> int_max(x, y) === x
theorem int_abs_zero_iff: forall (z :: Integer): int_abs(z) === zero() <=> z === int_zero()
theorem int_abs_multiply: forall (x :: Integer, y :: Integer): int_abs(int_multiply(x, y)) === nat_mul(int_abs(x), int_abs(y))
