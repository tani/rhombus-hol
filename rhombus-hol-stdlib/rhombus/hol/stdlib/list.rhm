#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open

export:
  List
  nil
  cons
  list_append
  list_map
  list_fold_right
  list_fold_left
  list_reverse
  list_length
  list_member
  list_filter
  list_all
  list_any
  list_take
  list_drop
  list_nth
  list_head
  list_tail
  list_last
  list_init
  list_zip
  list_unzip
  list_concat
  list_flat_map
  list_replicate
  list_range
  list_partition
  list_count
  list_find
  list_index

type List(?a)
| nil()
| cons(head_value :: ?a, tail_value :: List(?a))

function list_append(xs :: List(?a), ys :: List(?a)) :: List(?a):
  match xs
  | nil(): ys
  | cons(x, rest): cons(x, list_append(rest, ys))

function list_map(f :: Function(?a, ?b), xs :: List(?a)) :: List(?b):
  match xs
  | nil(): nil()
  | cons(x, rest): cons(f(x), list_map(f, rest))

function list_fold_right(f :: Function(?a, Function(?b, ?b)), z :: ?b, xs :: List(?a)) :: ?b:
  match xs
  | nil(): z
  | cons(x, rest): f(x)(list_fold_right(f, z, rest))

function list_fold_left(f :: Function(?b, Function(?a, ?b)), z :: ?b, xs :: List(?a)) :: ?b:
  match xs
  | nil(): z
  | cons(x, rest): list_fold_left(f, f(z)(x), rest)

function list_reverse(xs :: List(?a)) :: List(?a):
  match xs
  | nil(): nil()
  | cons(x, rest): list_append(list_reverse(rest), cons(x, nil()))

function list_length(xs :: List(?a)) :: Nat:
  match xs
  | nil(): zero()
  | cons(_, rest): succ(list_length(rest))

function list_member(decide_equal :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a)) :: Boolean:
  match xs
  | nil(): #false
  | cons(y, rest): decide_equal(x)(y) || list_member(decide_equal, x, rest)

function list_filter(p :: Function(?a, Boolean), xs :: List(?a)) :: List(?a):
  match xs
  | nil(): nil()
  | cons(x, rest):
      if p(x) | cons(x, list_filter(p, rest)) | list_filter(p, rest)

function list_all(p :: Function(?a, Boolean), xs :: List(?a)) :: Boolean:
  match xs
  | nil(): #true
  | cons(x, rest): p(x) && list_all(p, rest)

function list_any(p :: Function(?a, Boolean), xs :: List(?a)) :: Boolean:
  match xs
  | nil(): #false
  | cons(x, rest): p(x) || list_any(p, rest)

function list_take(n :: Nat, xs :: List(?a)) :: List(?a):
  match n
  | zero(): nil()
  | succ(k):
      match xs
      | nil(): nil()
      | cons(x, rest): cons(x, list_take(k, rest))

function list_drop(n :: Nat, xs :: List(?a)) :: List(?a):
  match n
  | zero(): xs
  | succ(k):
      match xs
      | nil(): nil()
      | cons(_, rest): list_drop(k, rest)

function list_nth(n :: Nat, xs :: List(?a)) :: Option(?a):
  match n
  | zero():
      match xs
      | nil(): none()
      | cons(x, _): some(x)
  | succ(k):
      match xs
      | nil(): none()
      | cons(_, rest): list_nth(k, rest)

function list_head(xs :: List(?a)) :: Option(?a):
  match xs
  | nil(): none()
  | cons(x, _): some(x)

function list_tail(xs :: List(?a)) :: Option(List(?a)):
  match xs
  | nil(): none()
  | cons(_, rest): some(rest)

function list_last(xs :: List(?a)) :: Option(?a):
  match xs
  | nil(): none()
  | cons(x, nil()): some(x)
  | cons(_, cons(y, rest)): list_last(cons(y, rest))

function option_prepend(x :: ?a, o :: Option(List(?a))) :: Option(List(?a)):
  match o
  | none(): none()
  | some(xs): some(cons(x, xs))

function list_init(xs :: List(?a)) :: Option(List(?a)):
  match xs
  | nil(): none()
  | cons(_, nil()): some(nil())
  | cons(x, cons(y, rest)): option_prepend(x, list_init(cons(y, rest)))

function list_zip(xs :: List(?a), ys :: List(?b)) :: List(Pair(?a, ?b)):
  match xs
  | nil(): nil()
  | cons(x, rest):
      match ys
      | nil(): nil()
      | cons(y, more): cons(mk_pair(x, y), list_zip(rest, more))

function list_unzip_left(xs :: List(Pair(?a, ?b))) :: List(?a):
  match xs
  | nil(): nil()
  | cons(p, rest): cons(pair_first(p), list_unzip_left(rest))

function list_unzip_right(xs :: List(Pair(?a, ?b))) :: List(?b):
  match xs
  | nil(): nil()
  | cons(p, rest): cons(pair_second(p), list_unzip_right(rest))

function list_unzip(xs :: List(Pair(?a, ?b))) :: Pair(List(?a), List(?b)):
  mk_pair(list_unzip_left(xs), list_unzip_right(xs))

function list_concat(xss :: List(List(?a))) :: List(?a):
  match xss
  | nil(): nil()
  | cons(xs, rest): list_append(xs, list_concat(rest))

function list_flat_map(f :: Function(?a, List(?b)), xs :: List(?a)) :: List(?b):
  match xs
  | nil(): nil()
  | cons(x, rest): list_append(f(x), list_flat_map(f, rest))

function list_replicate(n :: Nat, x :: ?a) :: List(?a):
  match n
  | zero(): nil()
  | succ(k): cons(x, list_replicate(k, x))

function list_range(n :: Nat) :: List(Nat):
  match n
  | zero(): nil()
  | succ(k): list_append(list_range(k), cons(k, nil()))

function list_partition(p :: Function(?a, Boolean), xs :: List(?a)) :: Pair(List(?a), List(?a)):
  match xs
  | nil(): mk_pair(nil(), nil())
  | cons(x, rest):
      let tails = list_partition(p, rest)
      if p(x)
      | mk_pair(cons(x, pair_first(tails)), pair_second(tails))
      | mk_pair(pair_first(tails), cons(x, pair_second(tails)))

function list_count(decide_equal :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a)) :: Nat:
  match xs
  | nil(): zero()
  | cons(y, rest):
      if decide_equal(x)(y) | succ(list_count(decide_equal, x, rest)) | list_count(decide_equal, x, rest)

function list_find(p :: Function(?a, Boolean), xs :: List(?a)) :: Option(?a):
  match xs
  | nil(): none()
  | cons(x, rest):
      if p(x) | some(x) | list_find(p, rest)

function option_succ(o :: Option(Nat)) :: Option(Nat):
  match o
  | none(): none()
  | some(n): some(succ(n))

function list_index(decide_equal :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a)) :: Option(Nat):
  match xs
  | nil(): none()
  | cons(y, rest):
      if decide_equal(x)(y)
      | some(zero())
      | option_succ(list_index(decide_equal, x, rest))

// Append.
theorem ~rewrite_rule append_nil_left:
  forall (ys :: List(?a)): list_append(nil(), ys) === ys

theorem ~rewrite_rule append_cons:
  forall (x :: ?a, xs :: List(?a), ys :: List(?a)):
    list_append(cons(x, xs), ys) === cons(x, list_append(xs, ys))

theorem ~rewrite_rule append_nil_right:
  forall (xs :: List(?a)): list_append(xs, nil()) === xs
proof:
  auto ~induct: xs

theorem append_associative:
  forall (xs :: List(?a), ys :: List(?a), zs :: List(?a)):
    list_append(list_append(xs, ys), zs) === list_append(xs, list_append(ys, zs))
proof:
  auto ~induct: xs


theorem ~rewrite_rule append_left_cancel:
  forall (xs :: List(?a), ys :: List(?a), zs :: List(?a)):
    list_append(xs, ys) === list_append(xs, zs) <=> ys === zs
proof:
  auto ~induct: xs

// Length.
theorem ~rewrite_rule length_nil:
  list_length(nil()) === zero()

theorem ~rewrite_rule length_cons:
  forall (x :: ?a, xs :: List(?a)): list_length(cons(x, xs)) === succ(list_length(xs))

theorem ~rewrite_rule length_append:
  forall (xs :: List(?a), ys :: List(?a)):
    list_length(list_append(xs, ys)) === nat_add(list_length(xs), list_length(ys))
proof:
  auto ~induct: xs

theorem ~rewrite_rule length_map:
  forall (f :: Function(?a, ?b), xs :: List(?a)):
    list_length(list_map(f, xs)) === list_length(xs)
proof:
  auto ~induct: xs

theorem ~rewrite_rule length_reverse:
  forall (xs :: List(?a)): list_length(list_reverse(xs)) === list_length(xs)
proof:
  auto ~induct: xs

theorem ~rewrite_rule length_replicate:
  forall (n :: Nat, x :: ?a): list_length(list_replicate(n, x)) === n
proof:
  auto ~induct: n

// Map.
theorem ~rewrite_rule map_nil:
  forall (f :: Function(?a, ?b)): list_map(f, nil()) === nil()

theorem ~rewrite_rule map_cons:
  forall (f :: Function(?a, ?b), x :: ?a, xs :: List(?a)):
    list_map(f, cons(x, xs)) === cons(f(x), list_map(f, xs))

theorem map_id:
  forall (xs :: List(?a)): list_map(identity, xs) === xs
proof:
  auto ~induct: xs

theorem ~rewrite_rule map_compose:
  forall (f :: Function(?a, ?b), g :: Function(?b, ?c), xs :: List(?a)):
    list_map(g, list_map(f, xs)) === list_map(compose(g, f), xs)
proof:
  auto ~induct: xs

theorem map_append:
  forall (f :: Function(?a, ?b), xs :: List(?a), ys :: List(?a)):
    list_map(f, list_append(xs, ys)) === list_append(list_map(f, xs), list_map(f, ys))
proof:
  auto ~induct: xs

// Reverse.
theorem ~rewrite_rule reverse_nil:
  list_reverse(nil()) === nil()

theorem ~rewrite_rule reverse_cons:
  forall (x :: ?a, xs :: List(?a)):
    list_reverse(cons(x, xs)) === list_append(list_reverse(xs), cons(x, nil()))

theorem reverse_append:
  forall (xs :: List(?a), ys :: List(?a)):
    list_reverse(list_append(xs, ys)) === list_append(list_reverse(ys), list_reverse(xs))
proof:
  auto(~induct: xs, ~using: [append_associative])

theorem ~rewrite_rule reverse_involutive:
  forall (xs :: List(?a)): list_reverse(list_reverse(xs)) === xs
proof:
  auto(~induct: xs, ~using: [reverse_append])

theorem map_reverse:
  forall (f :: Function(?a, ?b), xs :: List(?a)):
    list_map(f, list_reverse(xs)) === list_reverse(list_map(f, xs))
proof:
  auto(~induct: xs, ~using: [map_append])

// Predicates and filter.
theorem ~rewrite_rule member_nil:
  forall (decide_equal :: Function(?a, Function(?a, Boolean)), x :: ?a):
    not list_member(decide_equal, x, nil())

theorem ~rewrite_rule member_cons:
  forall (decide_equal :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a, ys :: List(?a)):
    list_member(decide_equal, x, cons(y, ys)) <=> decide_equal(x)(y) or list_member(decide_equal, x, ys)

theorem member_append:
  forall (decide_equal :: Function(?a, Function(?a, Boolean)), x :: ?a, xs :: List(?a), ys :: List(?a)):
    list_member(decide_equal, x, list_append(xs, ys)) <=> list_member(decide_equal, x, xs) or list_member(decide_equal, x, ys)
proof:
  auto(~induct: xs, ~using: [or_associative])

theorem ~rewrite_rule all_nil:
  forall (p :: Function(?a, Boolean)): list_all(p, nil())

theorem ~rewrite_rule all_cons:
  forall (p :: Function(?a, Boolean), x :: ?a, xs :: List(?a)):
    list_all(p, cons(x, xs)) <=> p(x) and list_all(p, xs)

theorem ~rewrite_rule any_nil:
  forall (p :: Function(?a, Boolean)): not list_any(p, nil())

theorem ~rewrite_rule any_cons:
  forall (p :: Function(?a, Boolean), x :: ?a, xs :: List(?a)):
    list_any(p, cons(x, xs)) <=> p(x) or list_any(p, xs)

theorem ~rewrite_rule filter_nil:
  forall (p :: Function(?a, Boolean)): list_filter(p, nil()) === nil()

theorem ~rewrite_rule filter_cons_true:
  forall (p :: Function(?a, Boolean), x :: ?a, xs :: List(?a)):
    p(x) ==> list_filter(p, cons(x, xs)) === cons(x, list_filter(p, xs))

theorem ~rewrite_rule filter_cons_false:
  forall (p :: Function(?a, Boolean), x :: ?a, xs :: List(?a)):
    not p(x) ==> list_filter(p, cons(x, xs)) === list_filter(p, xs)


// Take, drop, and indexing constructor equations.
theorem ~rewrite_rule take_zero:
  forall (xs :: List(?a)): list_take(zero(), xs) === nil()

theorem ~rewrite_rule take_nil:
  forall (n :: Nat): list_take(n, nil()) === nil()
proof:
  auto ~induct: n

theorem ~rewrite_rule take_succ_cons:
  forall (n :: Nat, x :: ?a, xs :: List(?a)):
    list_take(succ(n), cons(x, xs)) === cons(x, list_take(n, xs))

theorem ~rewrite_rule drop_zero:
  forall (xs :: List(?a)): list_drop(zero(), xs) === xs

theorem ~rewrite_rule drop_nil:
  forall (n :: Nat): list_drop(n, nil()) === nil()
proof:
  auto ~induct: n

theorem ~rewrite_rule drop_succ_cons:
  forall (n :: Nat, x :: ?a, xs :: List(?a)):
    list_drop(succ(n), cons(x, xs)) === list_drop(n, xs)


theorem ~rewrite_rule nth_nil:
  forall (n :: Nat): list_nth(n, nil()) === none()
proof:
  auto ~induct: n

theorem ~rewrite_rule nth_zero_cons:
  forall (x :: ?a, xs :: List(?a)): list_nth(zero(), cons(x, xs)) === some(x)

theorem ~rewrite_rule nth_succ_cons:
  forall (n :: Nat, x :: ?a, xs :: List(?a)):
    list_nth(succ(n), cons(x, xs)) === list_nth(n, xs)

// Concat, flat-map, and range.
theorem ~rewrite_rule concat_nil:
  list_concat(nil()) === nil()

theorem ~rewrite_rule concat_cons:
  forall (xs :: List(?a), xss :: List(List(?a))):
    list_concat(cons(xs, xss)) === list_append(xs, list_concat(xss))

theorem concat_append:
  forall (xss :: List(List(?a)), yss :: List(List(?a))):
    list_concat(list_append(xss, yss)) === list_append(list_concat(xss), list_concat(yss))
proof:
  auto(~induct: xss, ~using: [append_associative])

theorem ~rewrite_rule flat_map_nil:
  forall (f :: Function(?a, List(?b))): list_flat_map(f, nil()) === nil()

theorem ~rewrite_rule flat_map_cons:
  forall (f :: Function(?a, List(?b)), x :: ?a, xs :: List(?a)):
    list_flat_map(f, cons(x, xs)) === list_append(f(x), list_flat_map(f, xs))

theorem flat_map_append:
  forall (f :: Function(?a, List(?b)), xs :: List(?a), ys :: List(?a)):
    list_flat_map(f, list_append(xs, ys)) === list_append(list_flat_map(f, xs), list_flat_map(f, ys))
proof:
  auto(~induct: xs, ~using: [append_associative])

theorem ~rewrite_rule replicate_zero:
  forall (x :: ?a): list_replicate(zero(), x) === nil()

theorem ~rewrite_rule replicate_succ:
  forall (n :: Nat, x :: ?a): list_replicate(succ(n), x) === cons(x, list_replicate(n, x))

theorem ~rewrite_rule range_zero:
  list_range(zero()) === nil()

theorem ~rewrite_rule range_succ:
  forall (n :: Nat): list_range(succ(n)) === list_append(list_range(n), cons(n, nil()))

// Lists (16).
theorem fold_right_nil:
  forall (f :: Function(?a, Function(?b, ?b)), z :: ?b): list_fold_right(f, z, nil()) === z

theorem fold_right_cons:
  forall (f :: Function(?a, Function(?b, ?b)), z :: ?b, x :: ?a, xs :: List(?a)):
    list_fold_right(f, z, cons(x, xs)) === f(x)(list_fold_right(f, z, xs))

theorem fold_left_nil:
  forall (f :: Function(?b, Function(?a, ?b)), z :: ?b): list_fold_left(f, z, nil()) === z

theorem fold_left_cons:
  forall (f :: Function(?b, Function(?a, ?b)), z :: ?b, x :: ?a, xs :: List(?a)):
    list_fold_left(f, z, cons(x, xs)) === list_fold_left(f, f(z)(x), xs)

theorem head_nil:
  list_head(nil()) === none()

theorem head_cons:
  forall (x :: ?a, xs :: List(?a)): list_head(cons(x, xs)) === some(x)

theorem tail_nil:
  option_is_none(list_tail(nil()))

theorem tail_cons:
  forall (x :: ?a, xs :: List(?a)): list_tail(cons(x, xs)) === some(xs)

theorem last_nil:
  list_last(nil()) === none()

theorem last_singleton:
  forall (x :: ?a): list_last(cons(x, nil())) === some(x)

theorem last_cons_cons:
  forall (x :: ?a, y :: ?a, xs :: List(?a)):
    list_last(cons(x, cons(y, xs))) === list_last(cons(y, xs))

theorem init_nil:
  option_is_none(list_init(nil()))

theorem init_singleton:
  forall (x :: ?a): list_init(cons(x, nil())) === some(nil())

theorem zip_take_zero_left:
  forall (xs :: List(?a), ys :: List(?b)):
    list_zip(list_take(zero(), xs), ys) === list_take(zero(), list_zip(xs, ys))

theorem zip_take_zero_right:
  forall (xs :: List(?a), ys :: List(?b)):
    list_zip(xs, list_take(zero(), ys)) === list_take(zero(), list_zip(xs, ys))
proof:
  auto ~induct: xs

theorem zip_cons:
  forall (x :: ?a, xs :: List(?a), y :: ?b, ys :: List(?b)):
    list_zip(cons(x, xs), cons(y, ys)) === cons(mk_pair(x, y), list_zip(xs, ys))
