#lang rhombus/hol

export:
  identity
  constant
  compose
  flip_apply
  apply
  compose_left
  compose_right

function identity(x :: ?a) :: ?a:
  x

function constant(x :: ?a, _y :: ?b) :: ?a:
  x

function compose(g :: Function(?b, ?c), f :: Function(?a, ?b), x :: ?a) :: ?c:
  g(f(x))

function flip_apply(f :: Function(?a, Function(?b, ?c)), y :: ?b, x :: ?a) :: ?c:
  f(x)(y)

function apply(f :: Function(?a, ?b), x :: ?a) :: ?b:
  f(x)

function compose_left(f :: Function(?a, ?b), g :: Function(?b, ?c), x :: ?a) :: ?c:
  g(f(x))

function compose_right(x :: ?a, f :: Function(?a, ?b)) :: ?b:
  f(x)


// Safe Boolean normal forms already exist in the base simplifier; these
// declarations give them stable user-facing theorem names.
theorem ~rewrite_rule true_and:
  forall (p :: Boolean): true and p <=> p

theorem ~rewrite_rule and_true:
  forall (p :: Boolean): p and true <=> p

theorem ~rewrite_rule false_and:
  forall (p :: Boolean): false and p <=> false

theorem ~rewrite_rule and_false:
  forall (p :: Boolean): p and false <=> false

theorem ~rewrite_rule true_or:
  forall (p :: Boolean): true or p <=> true

theorem ~rewrite_rule or_true:
  forall (p :: Boolean): p or true <=> true

theorem ~rewrite_rule false_or:
  forall (p :: Boolean): false or p <=> p

theorem ~rewrite_rule or_false:
  forall (p :: Boolean): p or false <=> p

theorem ~rewrite_rule not_true:
  not true <=> false

theorem ~rewrite_rule not_false:
  not false <=> true

theorem ~rewrite_rule true_imp:
  forall (p :: Boolean): (true ==> p) <=> p

theorem ~rewrite_rule imp_true:
  forall (p :: Boolean): (p ==> true) <=> true

theorem ~rewrite_rule false_imp:
  forall (p :: Boolean): (false ==> p) <=> true

theorem ~rewrite_rule imp_refl:
  forall (p :: Boolean): p ==> p

theorem ~rewrite_rule not_not:
  forall (p :: Boolean): not (not p) <=> p
proof:
  auto(~cases: [p])

theorem de_morgan_and:
  forall (p :: Boolean, q :: Boolean): not (p and q) <=> not p or not q
proof:
  auto(~cases: [p, q])

theorem de_morgan_or:
  forall (p :: Boolean, q :: Boolean): not (p or q) <=> not p and not q
proof:
  auto(~cases: [p, q])

// Algebraic Boolean laws are intentionally plain theorems: associativity and
// commutativity are useful locally but too expansive as always-on rewrites.
theorem and_associative:
  forall (p :: Boolean, q :: Boolean, r :: Boolean):
    (p and q) and r <=> p and (q and r)
proof:
  auto(~cases: [p, q, r])

theorem and_commutative:
  forall (p :: Boolean, q :: Boolean): p and q <=> q and p
proof:
  auto(~cases: [p, q])

theorem and_idempotent:
  forall (p :: Boolean): p and p <=> p
proof:
  auto(~cases: [p])

theorem or_associative:
  forall (p :: Boolean, q :: Boolean, r :: Boolean):
    (p or q) or r <=> p or (q or r)
proof:
  auto(~cases: [p, q, r])

theorem or_commutative:
  forall (p :: Boolean, q :: Boolean): p or q <=> q or p
proof:
  auto(~cases: [p, q])

theorem or_idempotent:
  forall (p :: Boolean): p or p <=> p
proof:
  auto(~cases: [p])

theorem excluded_middle:
  forall (p :: Boolean): p or not p
proof:
  auto(~cases: [p])

theorem ~rewrite_rule if_true:
  forall (x :: ?a, y :: ?a): (if true | x | y) === x

theorem ~rewrite_rule if_false:
  forall (x :: ?a, y :: ?a): (if false | x | y) === y

theorem ~rewrite_rule if_same:
  forall (p :: Boolean, x :: ?a): (if p | x | x) === x
proof:
  auto(~cases: [p])

theorem eq_refl:
  forall (x :: ?a): x === x

theorem eq_sym:
  forall (x :: ?a, y :: ?a): x === y ==> y === x

theorem eq_trans:
  forall (x :: ?a, y :: ?a, z :: ?a): x === y ==> y === z ==> x === z

theorem ~rewrite_rule eq_true_iff:
  forall (p :: Boolean): (p === true) <=> p
proof:
  auto(~cases: [p])

theorem ~rewrite_rule eq_false_iff:
  forall (p :: Boolean): (p === false) <=> not p
proof:
  auto(~cases: [p])

theorem fun_congr:
  forall (f :: Function(?a, ?b), g :: Function(?a, ?b), x :: ?a):
    f === g ==> f(x) === g(x)

theorem arg_congr:
  forall (f :: Function(?a, ?b), x :: ?a, y :: ?a):
    x === y ==> f(x) === f(y)

theorem fun_ext:
  forall (f :: Function(?a, ?b), g :: Function(?a, ?b)):
    (forall (x :: ?a): f(x) === g(x)) ==> f === g

theorem predicate_ext:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean)):
    (forall (x :: ?a): p(x) <=> q(x)) ==> p === q



theorem ~rewrite_rule id_apply:
  forall (x :: ?a): identity(x) === x

theorem ~rewrite_rule const_apply:
  forall (x :: ?a, y :: ?b): constant(x, y) === x

theorem ~rewrite_rule compose_apply:
  forall (g :: Function(?b, ?c), f :: Function(?a, ?b), x :: ?a):
    compose(g, f, x) === g(f(x))

// Canonical propositional algebra. These remain manual because symmetric and
// distributive orientations can loop or duplicate terms under simplification.
theorem contradiction:
  forall (p :: Boolean): not (p and not p)
proof:
  auto(~cases: [p])

theorem not_excluded_middle:
  forall (p :: Boolean): not (not p and p)
proof:
  auto(~cases: [p])

theorem imp_as_or:
  forall (p :: Boolean, q :: Boolean): (p ==> q) <=> not p or q
proof:
  auto(~cases: [p, q])

theorem not_imp:
  forall (p :: Boolean, q :: Boolean): not (p ==> q) <=> p and not q
proof:
  auto(~cases: [p, q])

theorem imp_false:
  forall (p :: Boolean): (p ==> false) <=> not p
proof:
  auto(~cases: [p])

theorem contraposition:
  forall (p :: Boolean, q :: Boolean): (p ==> q) <=> (not q ==> not p)
proof:
  auto(~cases: [p, q])

theorem imp_transitive:
  forall (p :: Boolean, q :: Boolean, r :: Boolean):
    (p ==> q) ==> (q ==> r) ==> (p ==> r)
proof:
  auto(~cases: [p, q, r])

theorem and_absorption:
  forall (p :: Boolean, q :: Boolean): p and (p or q) <=> p
proof:
  auto(~cases: [p, q])

theorem or_absorption:
  forall (p :: Boolean, q :: Boolean): p or (p and q) <=> p
proof:
  auto(~cases: [p, q])

theorem and_distributes_over_or:
  forall (p :: Boolean, q :: Boolean, r :: Boolean):
    p and (q or r) <=> (p and q) or (p and r)
proof:
  auto(~cases: [p, q, r])

theorem or_distributes_over_and:
  forall (p :: Boolean, q :: Boolean, r :: Boolean):
    p or (q and r) <=> (p or q) and (p or r)
proof:
  auto(~cases: [p, q, r])

theorem iff_refl:
  forall (p :: Boolean): p <=> p

theorem iff_sym:
  forall (p :: Boolean, q :: Boolean): (p <=> q) <=> (q <=> p)
proof:
  auto(~cases: [p, q])

theorem iff_transitive:
  forall (p :: Boolean, q :: Boolean, r :: Boolean):
    (p <=> q) ==> (q <=> r) ==> (p <=> r)
proof:
  auto(~cases: [p, q, r])

theorem iff_not:
  forall (p :: Boolean, q :: Boolean): (p <=> q) <=> (not p <=> not q)
proof:
  auto(~cases: [p, q])

theorem if_not:
  forall (p :: Boolean, x :: ?a, y :: ?a):
    (if not p | x | y) === (if p | y | x)
proof:
  auto(~cases: [p])


theorem eq_iff:
  forall (p :: Boolean, q :: Boolean): (p === q) <=> (p <=> q)
proof:
  auto(~cases: [p, q])

theorem ~rewrite_rule true_ne_false:
  not (true === false)

theorem ~rewrite_rule false_ne_true:
  not (false === true)

theorem conditional_eq_right:
  forall (p :: Boolean, x :: ?a, y :: ?a, z :: ?a):
    ((if p | x | y) === z) <=> ((p ==> x === z) and (not p ==> y === z))
proof:
  auto(~cases: [p])

theorem conditional_eq_left:
  forall (p :: Boolean, x :: ?a, y :: ?a, z :: ?a):
    (z === (if p | x | y)) <=> ((p ==> z === x) and (not p ==> z === y))
proof:
  auto(~cases: [p])

theorem substitutivity:
  forall (p :: Function(?a, Boolean), x :: ?a, y :: ?a):
    x === y ==> (p(x) <=> p(y))

theorem equality_substitution:
  forall (f :: Function(?a, ?b), x :: ?a, y :: ?a):
    x === y ==> f(x) === f(y)

theorem equality_function_substitution:
  forall (f :: Function(?a, ?b), g :: Function(?a, ?b), x :: ?a):
    f === g ==> f(x) === g(x)

theorem boolean_disequality:
  forall (p :: Boolean, q :: Boolean):
    not (p === q) <=> (p and not q) or (not p and q)
proof:
  auto(~cases: [p, q])

theorem if_eq_same_condition:
  forall (p :: Boolean, a :: ?a, b :: ?a, c :: ?a, d :: ?a):
    ((if p | a | b) === (if p | c | d))
      <=> ((p ==> a === c) and (not p ==> b === d))
proof:
  auto(~cases: [p])

theorem ~rewrite_rule apply_def:
  forall (f :: Function(?a, ?b), x :: ?a): apply(f, x) === f(x)

theorem compose_identity_left:
  forall (f :: Function(?a, ?b)): compose(identity, f) === f

theorem compose_identity_right:
  forall (f :: Function(?a, ?b)): compose(f, identity) === f

theorem compose_associative:
  forall (f :: Function(?a, ?b), g :: Function(?b, ?c), h :: Function(?c, ?d)):
    compose(h, compose(g, f)) === compose(compose(h, g), f)

theorem ~rewrite_rule compose_left_apply:
  forall (f :: Function(?a, ?b), g :: Function(?b, ?c), x :: ?a):
    compose_left(f, g, x) === g(f(x))

theorem ~rewrite_rule compose_right_apply:
  forall (x :: ?a, f :: Function(?a, ?b)): compose_right(x, f) === f(x)

theorem forall_specialize:
  forall (p :: Function(?a, Boolean), x :: ?a):
    (forall (y :: ?a): p(y)) ==> p(x)
// Explicit-witness higher-order introduction laws. The witness annotation is
// proof data, not an axiom; it elaborates to the derived HOL EXISTS rule.
theorem exists_equal:
  forall (x :: ?a): exists (y :: ?a): y === x
proof:
  auto(~witnesses: [x])

theorem exists_equal_left:
  forall (x :: ?a): exists (y :: ?a): x === y
proof:
  auto(~witnesses: [x])

theorem exists_from_witness:
  forall (p :: Function(?a, Boolean), x :: ?a):
    p(x) ==> (exists (y :: ?a): p(y))
proof:
  auto(~witnesses: [x])

theorem exists_pair_witness:
  forall (p :: Function(?a, Function(?b, Boolean)), x :: ?a, y :: ?b):
    p(x)(y) ==> (exists (a :: ?a, b :: ?b): p(a)(b))
proof:
  auto(~witnesses: [x, y])

theorem forall_true:
  forall (_x :: ?a): true

theorem exists_conjunction:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    p(x) and q(x) ==> (exists (y :: ?a): p(y) and q(y))
proof:
  auto(~witnesses: [x])

theorem exists_excluded_middle:
  forall (p :: Function(?a, Boolean), x :: ?a):
    exists (y :: ?a): p(y) or not p(y)
proof:
  auto(~witnesses: [x], ~cases: [p(x)])

theorem exists_true:
  forall (x :: ?a): exists (_y :: ?a): true
proof:
  auto(~witnesses: [x])

theorem exists_disjunction_left:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    p(x) ==> (exists (y :: ?a): p(y) or q(y))
proof:
  auto(~witnesses: [x])

theorem exists_disjunction_right:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    q(x) ==> (exists (y :: ?a): p(y) or q(y))
proof:
  auto(~witnesses: [x])
