#lang rhombus/hol

import: "data.rhm" open

export:
  Nat
  zero
  succ
  nat_pred
  nat_add
  nat_mul
  nat_pow
  nat_sub
  nat_le
  nat_lt
  nat_min
  nat_max
  nat_even
  nat_odd
  nat_compare
  Ordering
  less
  equal
  greater
  nat_one
  nat_two
  ordering_reverse
  nat_ge
  nat_gt
  nat_double
  nat_square

// Peano naturals are the executable arithmetic basis. The prover's internal
// tree-index type `num` remains an implementation detail.
datatype Nat
| zero()
| succ(pred :: Nat)

datatype Ordering
| less()
| equal()
| greater()

function nat_pred(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): k

function nat_add(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(nat_add(k, n))

function nat_mul(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): zero()
  | succ(k): nat_add(n, nat_mul(k, n))

function nat_pow(base :: Nat, exponent :: Nat) :: Nat:
  match exponent
  | zero(): succ(zero())
  | succ(k): nat_mul(base, nat_pow(base, k))

function nat_sub(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): zero()
  | succ(a):
      match n
      | zero(): succ(a)
      | succ(b): nat_sub(a, b)

function nat_le(m :: Nat, n :: Nat) :: Boolean:
  match m
  | zero(): #true
  | succ(a):
      match n
      | zero(): #false
      | succ(b): nat_le(a, b)

function nat_lt(m :: Nat, n :: Nat) :: Boolean:
  nat_le(succ(m), n)

function nat_min(m :: Nat, n :: Nat) :: Nat:
  if nat_le(m, n) | m | n

function nat_max(m :: Nat, n :: Nat) :: Nat:
  if nat_le(m, n) | n | m

function nat_even(n :: Nat) :: Boolean:
  match n
  | zero(): #true
  | succ(k): !nat_even(k)

function nat_odd(n :: Nat) :: Boolean:
  !nat_even(n)

function nat_compare(m :: Nat, n :: Nat) :: Ordering:
  match m
  | zero():
      match n
      | zero(): equal()
      | succ(_): less()
  | succ(a):
      match n
      | zero(): greater()
      | succ(b): nat_compare(a, b)

function nat_one() :: Nat:
  succ(zero())

function nat_two() :: Nat:
  succ(nat_one())

function ordering_reverse(o :: Ordering) :: Ordering:
  match o
  | less(): greater()
  | equal(): equal()
  | greater(): less()

function nat_ge(m :: Nat, n :: Nat) :: Boolean:
  nat_le(n, m)

function nat_gt(m :: Nat, n :: Nat) :: Boolean:
  nat_lt(n, m)

function nat_double(n :: Nat) :: Nat:
  nat_add(n, n)

function nat_square(n :: Nat) :: Nat:
  nat_mul(n, n)

overload add(Nat, Nat) = nat_add
overload subtract(Nat, Nat) = nat_sub
overload multiply(Nat, Nat) = nat_mul
overload power(Nat, Nat) = nat_pow
overload less(Nat, Nat) = nat_lt
overload less_equal(Nat, Nat) = nat_le
overload greater(Nat, Nat) = nat_gt
overload greater_equal(Nat, Nat) = nat_ge
overload compare(Nat, Nat) = nat_compare
overload minimum(Nat, Nat) = nat_min
overload maximum(Nat, Nat) = nat_max



// Constructor and predecessor normal forms.
theorem pred_zero:
  nat_pred(zero()) === zero()

theorem pred_succ:
  forall (n :: Nat): nat_pred(succ(n)) === n

theorem zero_ne_succ:
  forall (n :: Nat): not (zero() === succ(n))

theorem succ_injective:
  forall (m :: Nat, n :: Nat): succ(m) === succ(n) <=> m === n

// Addition. Associativity and commutativity remain available but are not
// registered globally.
theorem add_zero_left:
  forall (n :: Nat): nat_add(zero(), n) === n

theorem add_succ_left:
  forall (m :: Nat, n :: Nat): nat_add(succ(m), n) === succ(nat_add(m, n))

theorem add_zero_right:
  forall (n :: Nat): nat_add(n, zero()) === n
proof:
  ~induct: n

theorem add_succ_right:
  forall (m :: Nat, n :: Nat): nat_add(m, succ(n)) === succ(nat_add(m, n))
proof:
  ~induct: m

theorem add_associative:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_add(nat_add(a, b), c) === nat_add(a, nat_add(b, c))
proof:
  ~induct: a

theorem add_commutative:
  forall (a :: Nat, b :: Nat): nat_add(a, b) === nat_add(b, a)
proof:
  ~induct: a
  ~use: [add_zero_right, add_succ_right]

theorem add_left_cancel:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_add(a, b) === nat_add(a, c) <=> b === c
proof:
  ~induct: a

theorem add_right_cancel:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_add(b, a) === nat_add(c, a) <=> b === c
proof:
  ~induct: a
  ~use: [add_zero_right, add_succ_right]

// Multiplication.
theorem mul_zero_left:
  forall (n :: Nat): nat_mul(zero(), n) === zero()

theorem mul_succ_left:
  forall (m :: Nat, n :: Nat): nat_mul(succ(m), n) === nat_add(n, nat_mul(m, n))

theorem mul_zero_right:
  forall (n :: Nat): nat_mul(n, zero()) === zero()
proof:
  ~induct: n

theorem mul_one_left:
  forall (n :: Nat): nat_mul(nat_one(), n) === n

theorem mul_one_right:
  forall (n :: Nat): nat_mul(n, nat_one()) === n
proof:
  ~induct: n

theorem mul_add_right_distributive:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_mul(nat_add(a, b), c) === nat_add(nat_mul(a, c), nat_mul(b, c))
proof:
  ~induct: a
  ~use: [add_associative]

theorem mul_add_left_distributive:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_mul(a, nat_add(b, c)) === nat_add(nat_mul(a, b), nat_mul(a, c))
proof:
  ~induct: a
  ~use: [add_associative, add_commutative]

theorem mul_associative:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_mul(nat_mul(a, b), c) === nat_mul(a, nat_mul(b, c))
proof:
  ~induct: a
  ~use: [mul_add_right_distributive]

// Powers.
theorem pow_zero:
  forall (a :: Nat): nat_pow(a, zero()) === nat_one()

theorem pow_succ:
  forall (a :: Nat, n :: Nat): nat_pow(a, succ(n)) === nat_mul(a, nat_pow(a, n))

theorem one_pow:
  forall (n :: Nat): nat_pow(nat_one(), n) === nat_one()
proof:
  ~induct: n

theorem pow_add:
  forall (a :: Nat, m :: Nat, n :: Nat):
    nat_pow(a, nat_add(m, n)) === nat_mul(nat_pow(a, m), nat_pow(a, n))
proof:
  ~induct: m
  ~use: [mul_associative, add_zero_right]

// Order and comparison.
theorem le_zero_left:
  forall (n :: Nat): nat_le(zero(), n)

theorem not_succ_le_zero:
  forall (n :: Nat): not nat_le(succ(n), zero())

theorem le_succ_succ:
  forall (m :: Nat, n :: Nat): nat_le(succ(m), succ(n)) <=> nat_le(m, n)

theorem le_reflexive:
  forall (n :: Nat): nat_le(n, n)
proof:
  ~induct: n

theorem lt_zero_zero:
  not nat_lt(zero(), zero())

theorem lt_zero_succ:
  forall (n :: Nat): nat_lt(zero(), succ(n))

theorem not_lt_succ_zero:
  forall (n :: Nat): not nat_lt(succ(n), zero())

theorem lt_succ_succ:
  forall (m :: Nat, n :: Nat): nat_lt(succ(m), succ(n)) <=> nat_lt(m, n)

theorem lt_succ_iff_le:
  forall (m :: Nat, n :: Nat): nat_lt(m, succ(n)) <=> nat_le(m, n)
proof:
  ~induct: m

theorem lt_irreflexive:
  forall (n :: Nat): not nat_lt(n, n)
proof:
  ~induct: n

theorem min_left:
  forall (a :: Nat, b :: Nat): nat_le(a, b) ==> nat_min(a, b) === a
proof:
  ~skip: [generalize]

theorem min_right:
  forall (a :: Nat, b :: Nat): not nat_le(a, b) ==> nat_min(a, b) === b

theorem max_left:
  forall (a :: Nat, b :: Nat): nat_le(a, b) ==> nat_max(a, b) === b
proof:
  ~skip: [generalize]

theorem max_right:
  forall (a :: Nat, b :: Nat): not nat_le(a, b) ==> nat_max(a, b) === a

// Truncated subtraction.
theorem sub_zero_right:
  forall (n :: Nat): nat_sub(n, zero()) === n
proof:
  ~induct: n

theorem sub_zero_left:
  forall (n :: Nat): nat_sub(zero(), n) === zero()

theorem sub_self:
  forall (n :: Nat): nat_sub(n, n) === zero()
proof:
  ~induct: n

theorem sub_succ_succ:
  forall (m :: Nat, n :: Nat): nat_sub(succ(m), succ(n)) === nat_sub(m, n)

theorem sub_add_cancel:
  forall (m :: Nat, n :: Nat): nat_sub(nat_add(m, n), m) === n
proof:
  ~induct: m

// Parity.
theorem even_zero:
  nat_even(zero())

theorem even_succ:
  forall (n :: Nat): nat_even(succ(n)) <=> not nat_even(n)

theorem odd_zero:
  not nat_odd(zero())

theorem odd_succ:
  forall (n :: Nat): nat_odd(succ(n)) <=> nat_even(n)

theorem le_zero_right:
  forall (n :: Nat): nat_le(n, zero()) <=> zero() === n
proof:
  ~induct: n

theorem le_succ_self:
  forall (n :: Nat): nat_le(n, succ(n))
proof:
  ~induct: n

theorem lt_self_succ:
  forall (n :: Nat): nat_lt(n, succ(n))
proof:
  ~induct: n

theorem not_succ_le_self:
  forall (n :: Nat): not nat_le(succ(n), n)
proof:
  ~induct: n

theorem compare_zero_zero:
  nat_compare(zero(), zero()) === equal()

theorem compare_zero_succ:
  forall (n :: Nat): nat_compare(zero(), succ(n)) === less()

theorem compare_succ_zero:
  forall (n :: Nat): nat_compare(succ(n), zero()) === greater()

theorem compare_succ_succ:
  forall (m :: Nat, n :: Nat):
    nat_compare(succ(m), succ(n)) === nat_compare(m, n)

theorem compare_reflexive:
  forall (n :: Nat): nat_compare(n, n) === equal()
proof:
  ~induct: n

theorem succ_ne_zero:
  forall (n :: Nat):
    not (succ(n) === zero())

theorem add_one_left:
  forall (n :: Nat):
    nat_add(nat_one(), n) === succ(n)

theorem add_one_right:
  forall (n :: Nat):
    nat_add(n, nat_one()) === succ(n)

theorem ordering_reverse_less:
  ordering_reverse(less()) === greater()

theorem ordering_reverse_equal:
  ordering_reverse(equal()) === equal()

theorem add_left_commutative:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_add(a, nat_add(b, c)) === nat_add(b, nat_add(a, c))
proof:
  ~induct: a
  ~use: [add_succ_right]

theorem mul_succ_right:
  forall (m :: Nat, n :: Nat):
    nat_mul(m, succ(n)) === nat_add(m, nat_mul(m, n))
proof:
  ~induct: m
  ~use: [add_left_commutative]

theorem mul_commutative:
  forall (a :: Nat, b :: Nat):
    nat_mul(a, b) === nat_mul(b, a)
proof:
  ~induct: a
  ~use: [mul_zero_right, mul_succ_right]

theorem mul_left_commutative:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_mul(a, nat_mul(b, c)) === nat_mul(b, nat_mul(a, c))
proof:
  ~induct: a
  ~use: [mul_zero_right, mul_add_left_distributive]

theorem ordering_reverse_greater:
  ordering_reverse(greater()) === less()

theorem ordering_reverse_involutive:
  forall (o :: Ordering):
    ordering_reverse(ordering_reverse(o)) === o

theorem zero_pow:
  forall (n :: Nat):
    nat_pow(zero(), n) === if n === zero() | nat_one() | zero()
proof:
  ~induct: n

theorem pow_one:
  forall (n :: Nat):
    nat_pow(n, nat_one()) === n

theorem pow_two:
  forall (n :: Nat):
    nat_pow(n, nat_two()) === nat_mul(n, n)
proof:
  ~use: [mul_succ_right, mul_zero_right, add_zero_right]

theorem pow_mul:
  forall (a :: Nat, m :: Nat, n :: Nat):
    nat_pow(a, nat_mul(m, n)) === nat_pow(nat_pow(a, m), n)
proof:
  ~induct: n
  ~use: [pow_add, mul_succ_right]

theorem pow_pow:
  forall (a :: Nat, m :: Nat, n :: Nat):
    nat_pow(nat_pow(a, m), n) === nat_pow(a, nat_mul(m, n))
proof:
  ~use: [pow_mul]

// Order facts that the automation can use as rewrite rules. An implication
// whose conclusion is a bare variable equation, or whose hypotheses mention a
// variable the conclusion does not, is not a usable rule; the equational forms
// below are, so the order laws that follow can cite them.
theorem le_antisymmetric_iff:
  forall (a :: Nat, b :: Nat): a === b <=> nat_le(a, b) and nat_le(b, a)
proof:
  ~induct: a
  ~use: [le_zero_right]

theorem le_zero_right_eq:
  forall (n :: Nat): nat_le(n, zero()) <=> n === zero()
proof:
  ~induct: n

theorem le_succ_left_eq:
  forall (m :: Nat, n :: Nat):
    nat_le(succ(m), n) <=> nat_le(m, n) and not (m === n)
proof:
  ~induct: n
  ~use: [le_zero_right_eq]

theorem le_succ_right:
  forall (m :: Nat, n :: Nat):
    nat_le(m, succ(n)) <=> nat_le(m, n) or m === succ(n)

theorem imp_imp_as_or:
  forall (p :: Boolean, q :: Boolean, r :: Boolean):
    (p ==> q ==> r) <=> (not p or not q or r)

theorem le_trans_or:
  forall (a :: Nat, b :: Nat, c :: Nat):
    not nat_le(a, b) or not nat_le(b, c) or nat_le(a, c)
proof:
  ~induct: a

theorem le_transitive:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_le(a, b) ==> nat_le(b, c) ==> nat_le(a, c)
proof:
  ~use: [imp_imp_as_or, le_trans_or]

theorem le_antisymmetric:
  forall (a :: Nat, b :: Nat):
    nat_le(a, b) ==> nat_le(b, a) ==> a === b
proof:
  ~use: [le_antisymmetric_iff]

theorem le_total:
  forall (a :: Nat, b :: Nat):
    nat_le(a, b) or nat_le(b, a)

theorem le_add_left:
  forall (a :: Nat, b :: Nat):
    nat_le(a, nat_add(b, a))
proof:
  ~induct: a
  ~use: [add_succ_right]

theorem le_add_right:
  forall (a :: Nat, b :: Nat):
    nat_le(a, nat_add(a, b))


theorem nat_double_zero:
  nat_double(zero()) === zero()

theorem lt_as_succ_le:
  forall (a :: Nat, b :: Nat):
    nat_lt(a, b) <=> nat_le(succ(a), b)

theorem lt_iff_le_not_eq:
  forall (a :: Nat, b :: Nat):
    nat_lt(a, b) <=> nat_le(a, b) and not (a === b)
proof:
  ~use: [le_succ_left_eq]

theorem lt_trans_or:
  forall (a :: Nat, b :: Nat, c :: Nat):
    not nat_lt(a, b) or not nat_lt(b, c) or nat_lt(a, c)
proof:
  ~induct: a

theorem lt_transitive:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_lt(a, b) ==> nat_lt(b, c) ==> nat_lt(a, c)
proof:
  ~use: [imp_imp_as_or, lt_trans_or]

theorem lt_asymmetric:
  forall (a :: Nat, b :: Nat):
    nat_lt(a, b) ==> not nat_lt(b, a)

theorem lt_trichotomy:
  forall (a :: Nat, b :: Nat):
    nat_lt(a, b) or a === b or nat_lt(b, a)

theorem lt_add_left:
  forall (a :: Nat, b :: Nat):
    nat_lt(a, succ(nat_add(b, a)))
proof:
  ~use: [le_add_left]

theorem lt_add_right:
  forall (a :: Nat, b :: Nat):
    nat_lt(a, succ(nat_add(a, b)))

theorem nat_double_succ:
  forall (n :: Nat):
    nat_double(succ(n)) === succ(succ(nat_double(n)))
proof:
  ~use: [add_succ_right]

theorem lt_le_transitive:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_lt(a, b) ==> nat_le(b, c) ==> nat_lt(a, c)

theorem le_lt_trans_or:
  forall (a :: Nat, b :: Nat, c :: Nat):
    not nat_le(a, b) or not nat_lt(b, c) or nat_lt(a, c)
proof:
  ~induct: a

theorem le_lt_transitive:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_le(a, b) ==> nat_lt(b, c) ==> nat_lt(a, c)
proof:
  ~use: [imp_imp_as_or, le_lt_trans_or]

theorem min_idempotent:
  forall (n :: Nat):
    nat_min(n, n) === n

theorem min_commutative:
  forall (a :: Nat, b :: Nat):
    nat_min(a, b) === nat_min(b, a)

theorem min_associative:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_min(nat_min(a, b), c) === nat_min(a, nat_min(b, c))

theorem min_zero_left:
  forall (n :: Nat):
    nat_min(zero(), n) === zero()

theorem min_zero_right:
  forall (n :: Nat):
    nat_min(n, zero()) === zero()

theorem min_le_left:
  forall (a :: Nat, b :: Nat):
    nat_le(nat_min(a, b), a)

theorem min_le_right:
  forall (a :: Nat, b :: Nat):
    nat_le(nat_min(a, b), b)

theorem min_eq_left_iff:
  forall (a :: Nat, b :: Nat):
    nat_min(a, b) === a <=> nat_le(a, b)

theorem min_eq_right_iff:
  forall (a :: Nat, b :: Nat):
    nat_min(a, b) === b <=> nat_le(b, a)

theorem max_idempotent:
  forall (n :: Nat):
    nat_max(n, n) === n

theorem max_commutative:
  forall (a :: Nat, b :: Nat):
    nat_max(a, b) === nat_max(b, a)

theorem max_associative:
  forall (a :: Nat, b :: Nat, c :: Nat):
    nat_max(nat_max(a, b), c) === nat_max(a, nat_max(b, c))

theorem max_zero_left:
  forall (n :: Nat):
    nat_max(zero(), n) === n

theorem max_zero_right:
  forall (n :: Nat):
    nat_max(n, zero()) === n

theorem le_max_left:
  forall (a :: Nat, b :: Nat):
    nat_le(a, nat_max(a, b))

theorem le_max_right:
  forall (a :: Nat, b :: Nat):
    nat_le(b, nat_max(a, b))

theorem max_eq_left_iff:
  forall (a :: Nat, b :: Nat):
    nat_max(a, b) === a <=> nat_le(b, a)

theorem max_eq_right_iff:
  forall (a :: Nat, b :: Nat):
    nat_max(a, b) === b <=> nat_le(a, b)

theorem min_max_absorption:
  forall (a :: Nat, b :: Nat):
    nat_min(a, nat_max(a, b)) === a

theorem max_min_absorption:
  forall (a :: Nat, b :: Nat):
    nat_max(a, nat_min(a, b)) === a

theorem nat_double_as_add:
  forall (n :: Nat):
    nat_double(n) === nat_add(n, n)

theorem nat_square_zero:
  nat_square(zero()) === zero()

theorem sub_add_left_cancel:
  forall (a :: Nat, b :: Nat):
    nat_sub(nat_add(a, b), a) === b

theorem sub_eq_zero_iff_le:
  forall (a :: Nat, b :: Nat):
    nat_sub(a, b) === zero() <=> nat_le(a, b)

theorem nat_square_succ:
  forall (n :: Nat):
    nat_square(succ(n)) === succ(nat_add(nat_double(n), nat_square(n)))
proof:
  ~use: [mul_succ_right, add_associative]

theorem nat_square_as_mul:
  forall (n :: Nat):
    nat_square(n) === nat_mul(n, n)

theorem even_two:
  nat_even(nat_two())

// Parity is determined pointwise by the two operands, and that equational
// form is what makes the four parity facts below one-step consequences: the
// implication forms cannot be proved directly, because the even and odd cases
// of a successor depend on each other.
theorem even_add_iff:
  forall (a :: Nat, b :: Nat):
    nat_even(nat_add(a, b)) <=> (nat_even(a) <=> nat_even(b))
proof:
  ~induct: a

theorem even_mul_iff:
  forall (a :: Nat, b :: Nat):
    nat_even(nat_mul(a, b)) <=> (nat_even(a) or nat_even(b))
proof:
  ~induct: a
  ~use: [even_add_iff]
  ~split: nat_even(b)

theorem even_add:
  forall (a :: Nat, b :: Nat):
    nat_even(a) ==> nat_even(b) ==> nat_even(nat_add(a, b))
proof:
  ~use: [even_add_iff]

theorem nat_ge_definition:
  forall (a :: Nat, b :: Nat):
    nat_ge(a, b) <=> nat_le(b, a)

theorem nat_gt_definition:
  forall (a :: Nat, b :: Nat):
    nat_gt(a, b) <=> nat_lt(b, a)

theorem odd_one:
  nat_odd(nat_one())

theorem odd_add:
  forall (a :: Nat, b :: Nat):
    nat_odd(a) ==> nat_even(b) ==> nat_odd(nat_add(a, b))
proof:
  ~use: [even_add_iff]

theorem odd_mul:
  forall (a :: Nat, b :: Nat):
    nat_odd(a) ==> nat_odd(b) ==> nat_odd(nat_mul(a, b))
proof:
  ~use: [even_mul_iff]

theorem compare_equal_iff:
  forall (a :: Nat, b :: Nat):
    nat_compare(a, b) === equal() <=> a === b

theorem compare_less_iff_lt:
  forall (a :: Nat, b :: Nat):
    nat_compare(a, b) === less() <=> nat_lt(a, b)

theorem compare_greater_iff_gt:
  forall (a :: Nat, b :: Nat):
    nat_compare(a, b) === greater() <=> nat_gt(a, b)

theorem compare_swap:
  forall (a :: Nat, b :: Nat):
    nat_compare(b, a) === ordering_reverse(nat_compare(a, b))
