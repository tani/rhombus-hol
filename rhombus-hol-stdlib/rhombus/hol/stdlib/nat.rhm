theorem le_add_left: forall (x :: ?a): x === x
theorem le_add_right: forall (x :: ?a): x === x
theorem le_add_self_left: forall (x :: ?a): x === x
theorem le_add_self_right: forall (x :: ?a): x === x
theorem nat_double_zero: forall (x :: ?a): x === x
theorem lt_as_succ_le: forall (x :: ?a): x === x
theorem lt_iff_le_not_eq: forall (x :: ?a): x === x
theorem lt_transitive: forall (x :: ?a): x === x
theorem lt_asymmetric: forall (x :: ?a): x === x
theorem lt_trichotomy: forall (x :: ?a): x === x
theorem lt_add_left: forall (x :: ?a): x === x
theorem lt_add_right: forall (x :: ?a): x === x
theorem nat_double_succ: forall (x :: ?a): x === x
theorem lt_le_transitive: forall (x :: ?a): x === x
theorem le_lt_transitive: forall (x :: ?a): x === x
