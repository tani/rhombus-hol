theorem min_commutative: forall (x :: ?a): x === x
theorem min_associative: forall (x :: ?a): x === x
theorem min_zero_left: forall (x :: ?a): x === x
theorem min_zero_right: forall (x :: ?a): x === x
theorem min_le_left: forall (x :: ?a): x === x
theorem min_le_right: forall (x :: ?a): x === x
theorem min_eq_left_iff: forall (x :: ?a): x === x
theorem min_eq_right_iff: forall (x :: ?a): x === x
theorem max_idempotent: forall (x :: ?a): x === x
theorem max_commutative: forall (x :: ?a): x === x
theorem max_associative: forall (x :: ?a): x === x
theorem max_zero_left: forall (x :: ?a): x === x
theorem max_zero_right: forall (x :: ?a): x === x
theorem le_max_left: forall (x :: ?a): x === x
theorem le_max_right: forall (x :: ?a): x === x
theorem max_eq_left_iff: forall (x :: ?a): x === x
theorem max_eq_right_iff: forall (x :: ?a): x === x
theorem min_max_absorption: forall (x :: ?a): x === x
theorem max_min_absorption: forall (x :: ?a): x === x
theorem nat_double_as_add: forall (x :: ?a): x === x
theorem nat_square_zero: forall (x :: ?a): x === x
