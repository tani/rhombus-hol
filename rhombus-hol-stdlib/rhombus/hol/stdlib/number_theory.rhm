#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open
  "integer.rhm" open
  "finite.rhm" open
  "rational.rhm" open
  "algorithm.rhm" open

export:
  nat_divides_with_witness_bound
  nat_divides
  nat_greatest_common_divisor
  nat_coprime
  nat_prime
  nat_divisors
  nat_least_common_multiple_search
  nat_factorial
  nat_list_sum
  nat_list_product
  nat_fibonacci

function nat_list_sum(xs :: List.of(Nat)) :: Nat:
  match xs
  | nil(): zero()
  | cons(x, rest): nat_add(x, nat_list_sum(rest))

function nat_list_product(xs :: List.of(Nat)) :: Nat:
  match xs
  | nil(): nat_one()
  | cons(x, rest): nat_mul(x, nat_list_product(rest))

function nat_fibonacci(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(zero()): nat_one()
  | succ(succ(k)): nat_add(nat_fibonacci(succ(k)), nat_fibonacci(k))

function nat_divides_with_witness_bound(d :: Nat, n :: Nat, witness_bound :: Nat) :: Boolean:
  match witness_bound
  | zero(): nat_mul(d, zero()) == n
  | succ(k): (nat_mul(d, succ(k)) == n) || nat_divides_with_witness_bound(d, n, k)

function nat_divides(d :: Nat, n :: Nat) :: Boolean:
  nat_divides_with_witness_bound(d, n, n)

function gcd_search(a :: Nat, b :: Nat, candidate :: Nat) :: Nat:
  match candidate
  | zero(): zero()
  | succ(k):
      if nat_divides(succ(k), a) && nat_divides(succ(k), b)
      | succ(k)
      | gcd_search(a, b, k)

function nat_greatest_common_divisor(a :: Nat, b :: Nat) :: Nat:
  match a
  | zero(): b
  | succ(a1):
      match b
      | zero(): succ(a1)
      | succ(b1): gcd_search(succ(a1), succ(b1), nat_min(succ(a1), succ(b1)))

function nat_coprime(a :: Nat, b :: Nat) :: Boolean:
  nat_greatest_common_divisor(a, b) == succ(zero())

function has_nontrivial_divisor(n :: Nat, candidate :: Nat) :: Boolean:
  match candidate
  | zero(): #false
  | succ(zero()): #false
  | succ(succ(k)):
      nat_divides(succ(succ(k)), n) || has_nontrivial_divisor(n, succ(k))

function nat_prime(n :: Nat) :: Boolean:
  match n
  | zero(): #false
  | succ(zero()): #false
  | succ(succ(k)): !has_nontrivial_divisor(succ(succ(k)), succ(k))

function empty_nat_list() :: List.of(Nat):
  nil()

function singleton_nat(n :: Nat) :: List.of(Nat):
  cons(n, nil())

function divisors_down_from(n :: Nat, candidate :: Nat) :: List.of(Nat):
  match candidate
  | zero():
      if nat_divides(zero(), n)
      | singleton_nat(zero())
      | empty_nat_list()
  | succ(k):
      if nat_divides(succ(k), n)
      | cons(succ(k), divisors_down_from(n, k))
      | divisors_down_from(n, k)

function nat_divisors(n :: Nat) :: List.of(Nat):
  divisors_down_from(n, n)

function multiple_search(a :: Nat, b :: Nat, candidate :: Nat, fuel :: Nat) :: Option.of(Nat):
  match fuel
  | zero(): none()
  | succ(k):
      if nat_divides(a, candidate) && nat_divides(b, candidate)
      | some(candidate)
      | multiple_search(a, b, succ(candidate), k)

function nat_least_common_multiple_search(a :: Nat, b :: Nat) :: Option.of(Nat):
  multiple_search(a, b, zero(), succ(nat_mul(a, b)))

function nat_factorial(n :: Nat) :: Nat:
  factorial(n)

theorem divides_zero:
  forall (d :: Nat): nat_divides(d, zero())
proof:
  ~induct: [d]

theorem one_divides:
  forall (n :: Nat): nat_divides(succ(zero()), n)
proof:
  ~induct: [n]

theorem gcd_zero_right:
  forall (n :: Nat): nat_greatest_common_divisor(n, zero()) === n
proof:
  ~induct: [n]

theorem coprime_zero_one:
  nat_coprime(zero(), succ(zero()))

theorem prime_zero_false:
  not nat_prime(zero())

theorem prime_one_false:
  not nat_prime(succ(zero()))

theorem divisors_zero_nonempty:
  not (empty_nat_list() === nat_divisors(zero()))

theorem nat_factorial_zero:
  nat_factorial(zero()) === succ(zero())

theorem nat_factorial_succ:
  forall (n :: Nat): nat_factorial(succ(n)) === nat_mul(succ(n), nat_factorial(n))

theorem fibonacci_zero:
  nat_fibonacci(zero()) === zero()

theorem fibonacci_one:
  nat_fibonacci(nat_one()) === nat_one()

theorem fibonacci_succ_succ:
  forall (n :: Nat):
    nat_fibonacci(succ(succ(n))) === nat_add(nat_fibonacci(succ(n)), nat_fibonacci(n))

theorem nat_list_sum_nil:
  nat_list_sum(nil()) === zero()

theorem nat_list_sum_cons:
  forall (x :: Nat, xs :: List.of(Nat)): nat_list_sum(cons(x, xs)) === nat_add(x, nat_list_sum(xs))

theorem nat_list_sum_append:
  forall (xs :: List.of(Nat),
          ys :: List.of(Nat)):
    nat_list_sum(list_append(xs, ys)) === nat_add(nat_list_sum(xs), nat_list_sum(ys))
proof:
  ~induct: [xs]
  ~use: [add_associative]

theorem nat_list_sum_reverse:
  forall (xs :: List.of(Nat)): nat_list_sum(list_reverse(xs)) === nat_list_sum(xs)
proof:
  ~induct: [xs]
  ~use: [add_associative, add_commutative]

theorem nat_list_sum_replicate_zero:
  forall (n :: Nat): nat_list_sum(list_replicate(n, zero())) === zero()
proof:
  ~induct: [n]

theorem nat_list_product_nil:
  nat_list_product(nil()) === nat_one()

theorem nat_list_product_cons:
  forall (x :: Nat,
          xs :: List.of(Nat)): nat_list_product(cons(x, xs)) === nat_mul(x, nat_list_product(xs))

theorem nat_list_product_append:
  forall (xs :: List.of(Nat),
          ys :: List.of(Nat)):
    nat_list_product(list_append(xs, ys)) === nat_mul(nat_list_product(xs), nat_list_product(ys))
proof:
  ~induct: [xs]
  ~use: [mul_associative]

theorem nat_list_product_reverse:
  forall (xs :: List.of(Nat)): nat_list_product(list_reverse(xs)) === nat_list_product(xs)
proof:
  ~induct: [xs]
  ~use: [mul_associative, mul_commutative]

theorem nat_list_product_replicate_zero:
  forall (n :: Nat): nat_list_product(list_replicate(succ(n), zero())) === zero()
proof:
  ~induct: [n]

// `nat_divides_with_witness_bound` searches the witnesses `bound`, `bound-1`,
// ..., `0`, so raising the bound can only add witnesses. Stating that
// additively puts the induction on the amount the bound grows.
theorem divides_with_bound_monotone:
  forall (d :: Nat, n :: Nat, bound :: Nat, extra :: Nat):
    not nat_divides_with_witness_bound(d, n, bound) or nat_divides_with_witness_bound(d, n, nat_add(bound, extra))
proof:
  ~induct: [extra]
  ~use: [add_succ_right]

// A multiple of `d` with a positive cofactor is at least that cofactor, so
// the cofactor is a witness inside the bound `nat_divides` uses.
theorem divides_with_bound_self_multiple:
  forall (d :: Nat, k :: Nat):
    nat_divides_with_witness_bound(d, nat_mul(d, succ(k)), nat_mul(d, succ(k)))
proof:
  ~induct: [d]
  ~use: [divides_with_bound_monotone, mul_succ_left]

// Disjunctive form of `divides_witness_bound`: in the implication form the
// antecedent mentions `bound`, a variable the conclusion does not, so the
// induction hypothesis contributes no rewrite rule and cannot fire.
theorem divides_bound_reduces:
  forall (d :: Nat, n :: Nat, bound :: Nat):
    not nat_divides_with_witness_bound(d, n, bound) or nat_divides_with_witness_bound(d, n, n)
proof:
  ~induct: [bound]
  ~use: [divides_with_bound_self_multiple, mul_zero_right]

theorem imp_as_or:
  forall (p :: Boolean, q :: Boolean):
    (p ==> q) <=> (not p or q)

theorem divides_witness_bound:
  forall (d :: Nat,
          n :: Nat,
          bound :: Nat):
    nat_divides_with_witness_bound(d, n, bound) ==> nat_divides_with_witness_bound(d, n, n)
proof:
  ~use: [imp_as_or, divides_bound_reduces]

theorem divides_with_bound_zero:
  forall (d :: Nat,
          n :: Nat): nat_divides_with_witness_bound(d, n, zero()) <=> nat_mul(d, zero()) === n

theorem divides_with_bound_succ:
  forall (d :: Nat,
          n :: Nat,
          k :: Nat):
    nat_divides_with_witness_bound(d, n, succ(k)) <=> nat_mul(d, succ(k)) === n or nat_divides_with_witness_bound(d, n, k)

theorem divides_definition:
  forall (d :: Nat, n :: Nat): nat_divides(d, n) <=> nat_divides_with_witness_bound(d, n, n)

theorem zero_divides_zero:
  nat_divides(zero(), zero())

// Zero has no witness for a positive multiple at any bound; the bound has to
// be generalized, because the conclusion for `succ(n)` says nothing about the
// bound `n` the recursion steps down to.
theorem divides_bound_zero_positive:
  forall (n :: Nat,
          bound :: Nat):
    not nat_divides_with_witness_bound(zero(), succ(n), bound)
proof:
  ~induct: [bound]

theorem zero_not_divides_succ:
  forall (n :: Nat): not nat_divides(zero(), succ(n))
proof:
  ~use: [divides_bound_zero_positive]

theorem divides_one_one:
  nat_divides(nat_one(), nat_one())

theorem gcd_zero_left:
  forall (n :: Nat): nat_greatest_common_divisor(zero(), n) === n

theorem gcd_succ_succ:
  forall (a :: Nat,
          b :: Nat):
    nat_greatest_common_divisor(succ(a), succ(b)) === gcd_search(succ(a), succ(b), nat_min(succ(a), succ(b)))

theorem gcd_search_zero:
  forall (a :: Nat, b :: Nat): gcd_search(a, b, zero()) === zero()

theorem gcd_search_succ_hit:
  forall (a :: Nat,
          b :: Nat,
          k :: Nat):
    nat_divides(succ(k), a) ==> nat_divides(succ(k), b) ==> gcd_search(a, b, succ(k)) === succ(k)

theorem gcd_search_succ_miss:
  forall (a :: Nat,
          b :: Nat,
          k :: Nat):
    not (nat_divides(succ(k), a) and nat_divides(succ(k), b)) ==> gcd_search(a, b, succ(k)) === gcd_search(a, b, k)

theorem prime_two:
  nat_prime(nat_two())

theorem nat_divisors_zero:
  nat_divisors(zero()) === list_singleton(zero())

theorem nat_divisors_one:
  nat_divisors(nat_one()) === list_singleton(nat_one())
