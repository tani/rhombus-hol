#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open
  "integer.rhm" open
  "finite.rhm" open
  "rational.rhm" open
  "algorithm.rhm" open

export:
  nat_divides_with_witness_bound
  nat_divides
  nat_greatest_common_divisor
  nat_coprime
  nat_prime
  nat_divisors
  nat_least_common_multiple_search
  nat_factorial
  nat_list_sum
  nat_list_product
  nat_fibonacci


function nat_list_sum(xs :: List(Nat)) :: Nat:
  match xs
  | nil(): zero()
  | cons(x, rest): nat_add(x, nat_list_sum(rest))

function nat_list_product(xs :: List(Nat)) :: Nat:
  match xs
  | nil(): nat_one()
  | cons(x, rest): nat_mul(x, nat_list_product(rest))

function nat_fibonacci(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(zero()): nat_one()
  | succ(succ(k)): nat_add(nat_fibonacci(succ(k)), nat_fibonacci(k))

function nat_divides_with_witness_bound(d :: Nat, n :: Nat, witness_bound :: Nat) :: Boolean:
  match witness_bound
  | zero(): nat_mul(d, zero()) == n
  | succ(k): (nat_mul(d, succ(k)) == n) || nat_divides_with_witness_bound(d, n, k)

function nat_divides(d :: Nat, n :: Nat) :: Boolean:
  nat_divides_with_witness_bound(d, n, n)

function gcd_search(a :: Nat, b :: Nat, candidate :: Nat) :: Nat:
  match candidate
  | zero(): zero()
  | succ(k):
      if nat_divides(succ(k), a) && nat_divides(succ(k), b)
      | succ(k)
      | gcd_search(a, b, k)

function nat_greatest_common_divisor(a :: Nat, b :: Nat) :: Nat:
  match a
  | zero(): b
  | succ(a1):
      match b
      | zero(): succ(a1)
      | succ(b1): gcd_search(succ(a1), succ(b1), nat_min(succ(a1), succ(b1)))

function nat_coprime(a :: Nat, b :: Nat) :: Boolean:
  nat_greatest_common_divisor(a, b) == succ(zero())

function has_nontrivial_divisor(n :: Nat, candidate :: Nat) :: Boolean:
  match candidate
  | zero(): #false
  | succ(zero()): #false
  | succ(succ(k)):
      nat_divides(succ(succ(k)), n) || has_nontrivial_divisor(n, succ(k))

function nat_prime(n :: Nat) :: Boolean:
  match n
  | zero(): #false
  | succ(zero()): #false
  | succ(succ(k)): !has_nontrivial_divisor(succ(succ(k)), succ(k))

function empty_nat_list() :: List(Nat):
  nil()

function singleton_nat(n :: Nat) :: List(Nat):
  cons(n, nil())

function divisors_down_from(n :: Nat, candidate :: Nat) :: List(Nat):
  match candidate
  | zero():
      if nat_divides(zero(), n)
      | singleton_nat(zero())
      | empty_nat_list()
  | succ(k):
      if nat_divides(succ(k), n)
      | cons(succ(k), divisors_down_from(n, k))
      | divisors_down_from(n, k)

function nat_divisors(n :: Nat) :: List(Nat):
  divisors_down_from(n, n)

function multiple_search(a :: Nat, b :: Nat, candidate :: Nat, fuel :: Nat) :: Option(Nat):
  match fuel
  | zero(): none()
  | succ(k):
      if nat_divides(a, candidate) && nat_divides(b, candidate)
      | some(candidate)
      | multiple_search(a, b, succ(candidate), k)

function nat_least_common_multiple_search(a :: Nat, b :: Nat) :: Option(Nat):
  multiple_search(a, b, zero(), succ(nat_mul(a, b)))

function nat_factorial(n :: Nat) :: Nat:
  factorial(n)

theorem ~rewrite_rule divides_zero:
  forall (d :: Nat): nat_divides(d, zero())
proof:
  auto ~induct: d

theorem ~rewrite_rule one_divides:
  forall (n :: Nat): nat_divides(succ(zero()), n)
proof:
  auto ~induct: n

theorem ~rewrite_rule gcd_zero_right:
  forall (n :: Nat): nat_greatest_common_divisor(n, zero()) === n
proof:
  auto ~induct: n

theorem ~rewrite_rule coprime_zero_one:
  nat_coprime(zero(), succ(zero()))

theorem ~rewrite_rule prime_zero_false:
  not nat_prime(zero())

theorem ~rewrite_rule prime_one_false:
  not nat_prime(succ(zero()))

theorem ~rewrite_rule divisors_zero_nonempty:
  not (empty_nat_list() === nat_divisors(zero()))

theorem ~rewrite_rule nat_factorial_zero:
  nat_factorial(zero()) === succ(zero())

theorem ~rewrite_rule nat_factorial_succ:
  forall (n :: Nat): nat_factorial(succ(n)) === nat_mul(succ(n), nat_factorial(n))

theorem ~rewrite_rule fibonacci_zero:
  nat_fibonacci(zero()) === zero()

theorem ~rewrite_rule fibonacci_one:
  nat_fibonacci(nat_one()) === nat_one()

theorem ~rewrite_rule fibonacci_succ_succ:
  forall (n :: Nat):
    nat_fibonacci(succ(succ(n))) === nat_add(nat_fibonacci(succ(n)), nat_fibonacci(n))

theorem nat_list_sum_nil:
  nat_list_sum(nil()) === zero()
theorem nat_list_sum_cons:
  forall (x :: Nat, xs :: List(Nat)): nat_list_sum(cons(x, xs)) === nat_add(x, nat_list_sum(xs))
theorem nat_list_sum_append:
  forall (xs :: List(Nat), ys :: List(Nat)): nat_list_sum(list_append(xs, ys)) === nat_add(nat_list_sum(xs), nat_list_sum(ys))
proof:
  auto(~induct: xs, ~using: [add_associative])
theorem nat_list_sum_reverse:
  forall (xs :: List(Nat)): nat_list_sum(list_reverse(xs)) === nat_list_sum(xs)
proof:
  auto(~induct: xs, ~using: [add_associative, add_commutative])
theorem nat_list_sum_replicate_zero:
  forall (n :: Nat): nat_list_sum(list_replicate(n, zero())) === zero()
proof:
  auto ~induct: n
theorem nat_list_product_nil:
  nat_list_product(nil()) === nat_one()
theorem nat_list_product_cons:
  forall (x :: Nat, xs :: List(Nat)): nat_list_product(cons(x, xs)) === nat_mul(x, nat_list_product(xs))
theorem nat_list_product_append:
  forall (xs :: List(Nat), ys :: List(Nat)): nat_list_product(list_append(xs, ys)) === nat_mul(nat_list_product(xs), nat_list_product(ys))
proof:
  auto(~induct: xs, ~using: [mul_associative])
theorem nat_list_product_reverse:
  forall (xs :: List(Nat)): nat_list_product(list_reverse(xs)) === nat_list_product(xs)
proof:
  auto(~induct: xs, ~using: [mul_associative, mul_commutative])
theorem nat_list_product_replicate_zero:
  forall (n :: Nat): nat_list_product(list_replicate(n, zero())) === zero()
proof:
  auto ~induct: n
theorem divides_witness_bound:
  forall (d :: Nat, n :: Nat, bound :: Nat): nat_divides_with_witness_bound(d, n, bound) ==> nat_divides_with_witness_bound(d, n, n)
theorem divides_with_bound_zero:
  forall (d :: Nat, n :: Nat): nat_divides_with_witness_bound(d, n, zero()) <=> nat_mul(d, zero()) === n
theorem divides_with_bound_succ:
  forall (d :: Nat, n :: Nat, k :: Nat): nat_divides_with_witness_bound(d, n, succ(k)) <=> nat_mul(d, succ(k)) === n or nat_divides_with_witness_bound(d, n, k)
theorem divides_definition:
  forall (d :: Nat, n :: Nat): nat_divides(d, n) <=> nat_divides_with_witness_bound(d, n, n)
theorem zero_divides_zero:
  nat_divides(zero(), zero())
theorem zero_not_divides_succ:
  forall (n :: Nat): not nat_divides(zero(), succ(n))
theorem divides_one_one:
  nat_divides(nat_one(), nat_one())
theorem gcd_zero_left:
  forall (n :: Nat): nat_greatest_common_divisor(zero(), n) === n
theorem gcd_succ_succ:
  forall (a :: Nat, b :: Nat): nat_greatest_common_divisor(succ(a), succ(b)) === gcd_search(succ(a), succ(b), nat_min(succ(a), succ(b)))
theorem gcd_search_zero:
  forall (a :: Nat, b :: Nat): gcd_search(a, b, zero()) === zero()
theorem gcd_search_succ_hit:
  forall (a :: Nat, b :: Nat, k :: Nat): nat_divides(succ(k), a) ==> nat_divides(succ(k), b) ==> gcd_search(a, b, succ(k)) === succ(k)
theorem gcd_search_succ_miss:
  forall (a :: Nat, b :: Nat, k :: Nat): not (nat_divides(succ(k), a) && nat_divides(succ(k), b)) ==> gcd_search(a, b, succ(k)) === gcd_search(a, b, k)
theorem prime_two:
  nat_prime(nat_two())
theorem nat_divisors_zero:
  nat_divisors(zero()) === list_singleton(zero())
theorem nat_divisors_one:
  nat_divisors(nat_one()) === list_singleton(nat_one())
