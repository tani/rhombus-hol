#lang rhombus/hol

import:
  "logic.rhm" open
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open
  "integer.rhm" open
  "finite.rhm" open
  "rational.rhm" open
  "algorithm.rhm" open
  "number_theory.rhm" open
  "algebra.rhm" open
  "quotient.rhm" open

export:
  predicate_not
  predicate_and
  predicate_or
  predicate_implies
  predicate_difference
  predicate_xor
  Isomorphism
  isomorphism
  iso_forward
  iso_backward
  iso_identity
  iso_inverse
  iso_compose
  iso_left_inverse_at
  iso_right_inverse_at

function predicate_not(p :: Function(?a, Boolean), x :: ?a) :: Boolean:
  !p(x)

function predicate_and(p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a) :: Boolean:
  p(x) && q(x)

function predicate_or(p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a) :: Boolean:
  p(x) || q(x)

function predicate_implies(p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a) :: Boolean:
  !p(x) || q(x)

function predicate_difference(p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a) :: Boolean:
  p(x) && !q(x)

function predicate_xor(p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a) :: Boolean:
  boolean_xor(p(x), q(x))

type Isomorphism(?a, ?b)
| isomorphism(forward_map :: Function(?a, ?b), backward_map :: Function(?b, ?a))

function iso_forward(i :: Isomorphism(?a, ?b), x :: ?a) :: ?b:
  match i
  | isomorphism(forward, _): forward(x)

function iso_backward(i :: Isomorphism(?a, ?b), y :: ?b) :: ?a:
  match i
  | isomorphism(_, backward): backward(y)

function iso_identity() :: Isomorphism(?a, ?a):
  isomorphism(identity, identity)

function iso_inverse(i :: Isomorphism(?a, ?b)) :: Isomorphism(?b, ?a):
  match i
  | isomorphism(forward, backward): isomorphism(backward, forward)

function iso_compose(j :: Isomorphism(?b, ?c), i :: Isomorphism(?a, ?b)) :: Isomorphism(?a, ?c):
  match j
  | isomorphism(j_forward, j_backward):
      match i
      | isomorphism(i_forward, i_backward):
          isomorphism(compose(j_forward, i_forward), compose(i_backward, j_backward))

function iso_left_inverse_at(i :: Isomorphism(?a, ?b), x :: ?a) :: Boolean:
  iso_backward(i, iso_forward(i, x)) == x

function iso_right_inverse_at(i :: Isomorphism(?a, ?b), y :: ?b) :: Boolean:
  iso_forward(i, iso_backward(i, y)) == y

theorem ~rewrite_rule iso_identity_forward:
  forall (x :: ?a): iso_forward(iso_identity(), x) === x

theorem ~rewrite_rule iso_identity_backward:
  forall (x :: ?a): iso_backward(iso_identity(), x) === x

theorem ~rewrite_rule iso_inverse_involutive:
  forall (i :: Isomorphism(?a, ?b)): iso_inverse(iso_inverse(i)) === i
proof:
  auto ~induct: i

theorem predicate_not_involutive:
  forall (p :: Function(?a, Boolean), x :: ?a): predicate_not(predicate_not(p), x) <=> p(x)

theorem predicate_not_apply:
  forall (p :: Function(?a, Boolean), x :: ?a): predicate_not(p, x) <=> not p(x)

theorem predicate_and_apply:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    predicate_and(p, q, x) <=> p(x) and q(x)

theorem predicate_or_apply:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    predicate_or(p, q, x) <=> p(x) or q(x)

theorem predicate_implies_apply:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    predicate_implies(p, q, x) <=> p(x) ==> q(x)

theorem predicate_difference_apply:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    predicate_difference(p, q, x) <=> p(x) and not q(x)

theorem predicate_xor_apply:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    predicate_xor(p, q, x) <=> boolean_xor(p(x), q(x))

theorem predicate_and_commutative:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    predicate_and(p, q, x) <=> predicate_and(q, p, x)
proof:
  auto(~cases: [p(x), q(x)])

theorem predicate_and_associative:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), r :: Function(?a, Boolean), x :: ?a):
    predicate_and(predicate_and(p, q), r, x) <=> predicate_and(p, predicate_and(q, r), x)
proof:
  auto(~cases: [p(x), q(x), r(x)])

theorem predicate_and_idempotent:
  forall (p :: Function(?a, Boolean), x :: ?a): predicate_and(p, p, x) <=> p(x)
proof:
  auto(~cases: [p(x)])

theorem predicate_or_commutative:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    predicate_or(p, q, x) <=> predicate_or(q, p, x)
proof:
  auto(~cases: [p(x), q(x)])

theorem predicate_or_associative:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), r :: Function(?a, Boolean), x :: ?a):
    predicate_or(predicate_or(p, q), r, x) <=> predicate_or(p, predicate_or(q, r), x)
proof:
  auto(~cases: [p(x), q(x), r(x)])

theorem predicate_or_idempotent:
  forall (p :: Function(?a, Boolean), x :: ?a): predicate_or(p, p, x) <=> p(x)
proof:
  auto(~cases: [p(x)])

theorem predicate_not_and:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    predicate_not(predicate_and(p, q), x) <=> predicate_or(predicate_not(p), predicate_not(q), x)
proof:
  auto(~cases: [p(x), q(x)])

theorem predicate_not_or:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    predicate_not(predicate_or(p, q), x) <=> predicate_and(predicate_not(p), predicate_not(q), x)
proof:
  auto(~cases: [p(x), q(x)])

theorem predicate_difference_self:
  forall (p :: Function(?a, Boolean), x :: ?a): not predicate_difference(p, p, x)
proof:
  auto(~cases: [p(x)])

theorem predicate_xor_commutative:
  forall (p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a):
    predicate_xor(p, q, x) <=> predicate_xor(q, p, x)
proof:
  auto(~cases: [p(x), q(x)])

theorem predicate_xor_self:
  forall (p :: Function(?a, Boolean), x :: ?a): not predicate_xor(p, p, x)
proof:
  auto(~cases: [p(x)])

theorem iso_forward_constructor:
  forall (forward :: Function(?a, ?b), backward :: Function(?b, ?a), x :: ?a):
    iso_forward(isomorphism(forward, backward), x) === forward(x)

theorem iso_backward_constructor:
  forall (forward :: Function(?a, ?b), backward :: Function(?b, ?a), y :: ?b):
    iso_backward(isomorphism(forward, backward), y) === backward(y)

theorem iso_inverse_forward:
  forall (i :: Isomorphism(?a, ?b), y :: ?b):
    iso_forward(iso_inverse(i), y) === iso_backward(i, y)
proof:
  auto ~induct: i

theorem iso_inverse_backward:
  forall (i :: Isomorphism(?a, ?b), x :: ?a):
    iso_backward(iso_inverse(i), x) === iso_forward(i, x)
proof:
  auto ~induct: i

theorem iso_compose_forward:
  forall (j :: Isomorphism(?b, ?c), i :: Isomorphism(?a, ?b), x :: ?a):
    iso_forward(iso_compose(j, i), x) === iso_forward(j, iso_forward(i, x))
proof:
  auto ~induct: j

theorem iso_compose_backward:
  forall (j :: Isomorphism(?b, ?c), i :: Isomorphism(?a, ?b), z :: ?c):
    iso_backward(iso_compose(j, i), z) === iso_backward(i, iso_backward(j, z))
proof:
  auto ~induct: j

theorem iso_compose_identity_left:
  forall (i :: Isomorphism(?a, ?b)):
    iso_compose(iso_identity(), i) === i
proof:
  auto ~induct: i

theorem iso_compose_identity_right:
  forall (i :: Isomorphism(?a, ?b)):
    iso_compose(i, iso_identity()) === i
proof:
  auto ~induct: i

theorem iso_compose_associative:
  forall (k :: Isomorphism(?c, ?d), j :: Isomorphism(?b, ?c), i :: Isomorphism(?a, ?b)):
    iso_compose(k, iso_compose(j, i)) === iso_compose(iso_compose(k, j), i)
proof:
  auto ~induct: k

theorem iso_identity_left_inverse:
  forall (x :: ?a): iso_left_inverse_at(iso_identity(), x)

theorem iso_identity_right_inverse:
  forall (x :: ?a): iso_right_inverse_at(iso_identity(), x)
