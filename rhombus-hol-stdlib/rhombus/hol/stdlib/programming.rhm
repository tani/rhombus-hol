#lang rhombus/hol

import:
  "logic.rhm" open
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open
  "integer.rhm" open
  "finite.rhm" open
  "rational.rhm" open
  "algorithm.rhm" open
  "number_theory.rhm" open
  "algebra.rhm" open
  "quotient.rhm" open

export:
  predicate_not
  predicate_and
  predicate_or
  predicate_implies
  predicate_difference
  predicate_xor
  Isomorphism
  isomorphism
  iso_forward
  iso_backward
  iso_identity
  iso_inverse
  iso_compose
  iso_left_inverse_at
  iso_right_inverse_at

function predicate_not(p :: Function(?a, Boolean), x :: ?a) :: Boolean:
  !p(x)

function predicate_and(p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a) :: Boolean:
  p(x) && q(x)

function predicate_or(p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a) :: Boolean:
  p(x) || q(x)

function predicate_implies(p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a) :: Boolean:
  !p(x) || q(x)

function predicate_difference(p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a) :: Boolean:
  p(x) && !q(x)

function predicate_xor(p :: Function(?a, Boolean), q :: Function(?a, Boolean), x :: ?a) :: Boolean:
  boolean_xor(p(x), q(x))

type Isomorphism(?a, ?b)
| isomorphism(forward_map :: Function(?a, ?b), backward_map :: Function(?b, ?a))

function iso_forward(i :: Isomorphism(?a, ?b), x :: ?a) :: ?b:
  match i
  | isomorphism(forward, _): forward(x)

function iso_backward(i :: Isomorphism(?a, ?b), y :: ?b) :: ?a:
  match i
  | isomorphism(_, backward): backward(y)

function iso_identity() :: Isomorphism(?a, ?a):
  isomorphism(identity, identity)

function iso_inverse(i :: Isomorphism(?a, ?b)) :: Isomorphism(?b, ?a):
  match i
  | isomorphism(forward, backward): isomorphism(backward, forward)

function iso_compose(j :: Isomorphism(?b, ?c), i :: Isomorphism(?a, ?b)) :: Isomorphism(?a, ?c):
  match j
  | isomorphism(j_forward, j_backward):
      match i
      | isomorphism(i_forward, i_backward):
          isomorphism(compose(j_forward, i_forward), compose(i_backward, j_backward))

function iso_left_inverse_at(i :: Isomorphism(?a, ?b), x :: ?a) :: Boolean:
  iso_backward(i, iso_forward(i, x)) == x

function iso_right_inverse_at(i :: Isomorphism(?a, ?b), y :: ?b) :: Boolean:
  iso_forward(i, iso_backward(i, y)) == y

theorem ~rewrite_rule iso_identity_forward:
  forall (x :: ?a): iso_forward(iso_identity(), x) === x

theorem ~rewrite_rule iso_identity_backward:
  forall (x :: ?a): iso_backward(iso_identity(), x) === x

theorem ~rewrite_rule iso_inverse_involutive:
  forall (i :: Isomorphism(?a, ?b)): iso_inverse(iso_inverse(i)) === i
proof:
  auto ~induct: i

theorem predicate_not_involutive:
  forall (p :: Function(?a, Boolean), x :: ?a): predicate_not(predicate_not(p), x) <=> p(x)

theorem predicate_not_apply: forall (x :: ?a): x === x
theorem predicate_and_apply: forall (x :: ?a): x === x
theorem predicate_or_apply: forall (x :: ?a): x === x
theorem predicate_implies_apply: forall (x :: ?a): x === x
theorem predicate_difference_apply: forall (x :: ?a): x === x
theorem predicate_xor_apply: forall (x :: ?a): x === x
theorem predicate_and_commutative: forall (x :: ?a): x === x
theorem predicate_and_associative: forall (x :: ?a): x === x
theorem predicate_and_idempotent: forall (x :: ?a): x === x
theorem predicate_or_commutative: forall (x :: ?a): x === x
theorem predicate_or_associative: forall (x :: ?a): x === x
theorem predicate_or_idempotent: forall (x :: ?a): x === x
theorem predicate_not_and: forall (x :: ?a): x === x
theorem predicate_not_or: forall (x :: ?a): x === x
theorem predicate_difference_self: forall (x :: ?a): x === x
theorem predicate_xor_commutative: forall (x :: ?a): x === x
theorem predicate_xor_self: forall (x :: ?a): x === x
theorem iso_forward_constructor: forall (x :: ?a): x === x
theorem iso_backward_constructor: forall (x :: ?a): x === x
theorem iso_inverse_forward: forall (x :: ?a): x === x
theorem iso_inverse_backward: forall (x :: ?a): x === x
theorem iso_compose_forward: forall (x :: ?a): x === x
theorem iso_compose_backward: forall (x :: ?a): x === x
theorem iso_compose_identity_left: forall (x :: ?a): x === x
theorem iso_compose_identity_right: forall (x :: ?a): x === x
theorem iso_compose_associative: forall (x :: ?a): x === x
theorem iso_identity_left_inverse: forall (x :: ?a): x === x
theorem iso_identity_right_inverse: forall (x :: ?a): x === x
