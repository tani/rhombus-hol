#lang rhombus/hol

import: "algebra.rhm" open

export:
  EquivalenceClass
  equivalence_class
  quotient_representative
  quotient_relation
  quotient_member
  quotient_equivalent
  quotient_reflexive_at
  quotient_symmetric_at
  quotient_transitive_at

datatype EquivalenceClass.of(?a)
| equivalence_class(class_representative :: ?a,
                    class_relation :: ?a -> ?a -> Boolean)

function quotient_representative(q :: EquivalenceClass.of(?a)) :: ?a:
  let equivalence_class(x, _) = q
  x

function quotient_relation(q :: EquivalenceClass.of(?a), x :: ?a, y :: ?a) :: Boolean:
  let equivalence_class(_, relation) = q
  relation(x)(y)

function quotient_member(q :: EquivalenceClass.of(?a), x :: ?a) :: Boolean:
  quotient_relation(q, quotient_representative(q), x)

function quotient_equivalent(q :: EquivalenceClass.of(?a), r :: EquivalenceClass.of(?a)) :: Boolean:
  quotient_relation(q, quotient_representative(q), quotient_representative(r))

function quotient_reflexive_at(q :: EquivalenceClass.of(?a), x :: ?a) :: Boolean:
  quotient_relation(q, x, x)

function quotient_symmetric_at(q :: EquivalenceClass.of(?a), x :: ?a, y :: ?a) :: Boolean:
  !quotient_relation(q, x, y) || quotient_relation(q, y, x)

function quotient_transitive_at(q :: EquivalenceClass.of(?a), x :: ?a, y :: ?a, z :: ?a) :: Boolean:
  !(quotient_relation(q, x, y) && quotient_relation(q, y, z)) || quotient_relation(q, x, z)

theorem quotient_member_rep:
  forall (x :: ?a, relation :: ?a -> ?a -> Boolean):
    relation(x)(x) ==> quotient_member(equivalence_class(x, relation), x)

theorem quotient_equivalent_apply:
  forall (x :: ?a, y :: ?a, relation :: ?a -> ?a -> Boolean):
    quotient_equivalent(equivalence_class(x, relation), equivalence_class(y, relation))
      <=> relation(x)(y)

theorem quotient_representative_constructor:
  forall (x :: ?a, relation :: ?a -> ?a -> Boolean):
    quotient_representative(equivalence_class(x, relation)) === x

theorem quotient_relation_constructor:
  forall (representative :: ?a, relation :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    quotient_relation(equivalence_class(representative, relation), x, y) <=> relation(x)(y)

theorem quotient_member_apply:
  forall (representative :: ?a, relation :: ?a -> ?a -> Boolean, x :: ?a):
    quotient_member(equivalence_class(representative, relation), x) <=> relation(representative)(x)

theorem quotient_equivalent_reflexive:
  forall (q :: EquivalenceClass.of(?a)):
    quotient_reflexive_at(q, quotient_representative(q)) ==> quotient_equivalent(q, q)
proof:
  ~induct: [q]

// `quotient_equivalent(q, r)` reads the relation carried by its *left*
// argument, so symmetry and transitivity of a class conclude about that same
// relation: `quotient_equivalent(r, q)` would ask `r`'s relation, which no
// hypothesis here constrains.
theorem quotient_equivalent_symmetric:
  forall (q :: EquivalenceClass.of(?a), r :: EquivalenceClass.of(?a)):
    quotient_symmetric_at(q, quotient_representative(q), quotient_representative(r)) ==> (quotient_equivalent(q, r) ==> quotient_relation(q, quotient_representative(r), quotient_representative(q)))

theorem quotient_equivalent_transitive:
  forall (q :: EquivalenceClass.of(?a), r :: EquivalenceClass.of(?a), s :: EquivalenceClass.of(?a)):
    quotient_transitive_at(q, quotient_representative(q), quotient_representative(r), quotient_representative(s)) ==> (quotient_equivalent(q, r) ==> quotient_relation(q, quotient_representative(r), quotient_representative(s)) ==> quotient_equivalent(q, s))
proof:
  ~split: [quotient_equivalent(q, s)]

theorem quotient_member_equivalent:
  forall (q :: EquivalenceClass.of(?a), r :: EquivalenceClass.of(?a)):
    quotient_equivalent(q, r) <=> quotient_member(q, quotient_representative(r))

theorem quotient_change_representative:
  forall (x :: ?a, y :: ?a, relation :: ?a -> ?a -> Boolean):
    relation(x)(y) ==> quotient_equivalent(equivalence_class(x, relation), equivalence_class(y, relation))

theorem quotient_reflexive_at_definition:
  forall (q :: EquivalenceClass.of(?a), x :: ?a):
    quotient_reflexive_at(q, x) <=> quotient_relation(q, x, x)

theorem quotient_symmetric_at_definition:
  forall (q :: EquivalenceClass.of(?a), x :: ?a, y :: ?a):
    quotient_symmetric_at(q, x, y) <=> quotient_relation(q, x, y) ==> quotient_relation(q, y, x)

theorem quotient_transitive_at_definition:
  forall (q :: EquivalenceClass.of(?a), x :: ?a, y :: ?a, z :: ?a):
    quotient_transitive_at(q, x, y, z)
      <=> ((quotient_relation(q, x, y) and quotient_relation(q, y, z)) ==> quotient_relation(q, x, z))

theorem quotient_class_reflexive:
  forall (x :: ?a, relation :: ?a -> ?a -> Boolean):
    relation(x)(x) ==> quotient_reflexive_at(equivalence_class(x, relation), x)

theorem quotient_class_symmetric:
  forall (representative :: ?a, relation :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation(x)(y) ==> relation(y)(x) ==> quotient_symmetric_at(equivalence_class(representative, relation), x, y)

theorem quotient_class_transitive:
  forall (representative :: ?a,
          relation :: ?a -> ?a -> Boolean,
          x :: ?a,
          y :: ?a,
          z :: ?a):
    relation(x)(y) ==> relation(y)(z) ==> relation(x)(z) ==> quotient_transitive_at(equivalence_class(representative, relation), x, y, z)

theorem quotient_member_reflexive:
  forall (q :: EquivalenceClass.of(?a)):
    quotient_reflexive_at(q, quotient_representative(q)) ==> quotient_member(q, quotient_representative(q))

theorem quotient_member_symmetric:
  forall (q :: EquivalenceClass.of(?a), x :: ?a):
    quotient_symmetric_at(q, quotient_representative(q), x) ==> (quotient_member(q, x) ==> quotient_relation(q, x, quotient_representative(q)))

theorem quotient_member_transitive:
  forall (q :: EquivalenceClass.of(?a), x :: ?a, y :: ?a):
    quotient_member(q, x) ==> quotient_relation(q, x, y) ==> quotient_transitive_at(q, quotient_representative(q), x, y) ==> quotient_member(q, y)
