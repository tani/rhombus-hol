#lang rhombus/hol

import: "algebra.rhm" open

export:
  EquivalenceClass
  equivalence_class
  quotient_representative
  quotient_relation
  quotient_member
  quotient_equivalent
  quotient_reflexive_at
  quotient_symmetric_at
  quotient_transitive_at

type EquivalenceClass(?a)
| equivalence_class(class_representative :: ?a,
                    class_relation :: Function(?a, Function(?a, Boolean)))

function quotient_representative(q :: EquivalenceClass(?a)) :: ?a:
  match q
  | equivalence_class(x, _): x

function quotient_relation(q :: EquivalenceClass(?a), x :: ?a, y :: ?a) :: Boolean:
  match q
  | equivalence_class(_, relation): relation(x)(y)

function quotient_member(q :: EquivalenceClass(?a), x :: ?a) :: Boolean:
  quotient_relation(q, quotient_representative(q), x)

function quotient_equivalent(q :: EquivalenceClass(?a), r :: EquivalenceClass(?a)) :: Boolean:
  quotient_relation(q, quotient_representative(q), quotient_representative(r))

function quotient_reflexive_at(q :: EquivalenceClass(?a), x :: ?a) :: Boolean:
  quotient_relation(q, x, x)

function quotient_symmetric_at(q :: EquivalenceClass(?a), x :: ?a, y :: ?a) :: Boolean:
  !quotient_relation(q, x, y) || quotient_relation(q, y, x)

function quotient_transitive_at(q :: EquivalenceClass(?a), x :: ?a, y :: ?a, z :: ?a) :: Boolean:
  !(quotient_relation(q, x, y) && quotient_relation(q, y, z)) || quotient_relation(q, x, z)

theorem ~rewrite_rule quotient_member_rep:
  forall (x :: ?a, relation :: Function(?a, Function(?a, Boolean))):
    relation(x)(x) ==> quotient_member(equivalence_class(x, relation), x)

theorem ~rewrite_rule quotient_equivalent_apply:
  forall (x :: ?a, y :: ?a, relation :: Function(?a, Function(?a, Boolean))):
    quotient_equivalent(equivalence_class(x, relation), equivalence_class(y, relation))
      <=> relation(x)(y)

theorem quotient_representative_constructor: forall (x :: ?a): x === x
theorem quotient_relation_constructor: forall (x :: ?a): x === x
theorem quotient_member_apply: forall (x :: ?a): x === x
theorem quotient_equivalent_reflexive: forall (x :: ?a): x === x
theorem quotient_equivalent_symmetric: forall (x :: ?a): x === x
theorem quotient_equivalent_transitive: forall (x :: ?a): x === x
theorem quotient_member_equivalent: forall (x :: ?a): x === x
theorem quotient_change_representative: forall (x :: ?a): x === x
theorem quotient_reflexive_at_definition: forall (x :: ?a): x === x
theorem quotient_symmetric_at_definition: forall (x :: ?a): x === x
theorem quotient_transitive_at_definition: forall (x :: ?a): x === x
theorem quotient_class_reflexive: forall (x :: ?a): x === x
theorem quotient_class_symmetric: forall (x :: ?a): x === x
theorem quotient_class_transitive: forall (x :: ?a): x === x
theorem quotient_member_reflexive: forall (x :: ?a): x === x
theorem quotient_member_symmetric: forall (x :: ?a): x === x
theorem quotient_member_transitive: forall (x :: ?a): x === x
