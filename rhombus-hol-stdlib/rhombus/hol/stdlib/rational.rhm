#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open
  "tree.rhm" open
  "integer.rhm" open
  "finite.rhm" open

export:
  Rational
  rational
  rational_denominator
  rational_from_integer
  rational_negate
  rational_add
  rational_subtract
  rational_multiply
  rational_reciprocal
  rational_divide
  rational_le
  rational_lt
  rational_equivalent
  rational_zero
  rational_one
  rational_compare
  rational_min
  rational_max


// The denominator is stored as its predecessor, making zero denominators
// unrepresentable. Values are arithmetic fractions; normalization is explicit
// rather than hidden in the constructor.
type Rational
| rational(rational_numerator :: Integer, rational_denominator_pred :: Nat)

function rational_denominator(q :: Rational) :: Nat:
  match q
  | rational(_, d): succ(d)

function rational_from_integer(z :: Integer) :: Rational:
  rational(z, zero())

function rational_negate(q :: Rational) :: Rational:
  match q
  | rational(n, d): rational(int_negate(n), d)

function rational_add(x :: Rational, y :: Rational) :: Rational:
  match x
  | rational(a, b):
      match y
      | rational(c, d):
          rational(
            int_add(
              int_multiply(a, int_from_nat(succ(d))),
              int_multiply(c, int_from_nat(succ(b)))),
            nat_pred(nat_mul(succ(b), succ(d))))

function rational_subtract(x :: Rational, y :: Rational) :: Rational:
  rational_add(x, rational_negate(y))

function rational_multiply(x :: Rational, y :: Rational) :: Rational:
  match x
  | rational(a, b):
      match y
      | rational(c, d):
          rational(int_multiply(a, c), nat_pred(nat_mul(succ(b), succ(d))))

function rational_reciprocal(q :: Rational) :: Option(Rational):
  match q
  | rational(int_nonnegative(zero()), _): none()
  | rational(int_nonnegative(succ(n)), d): some(rational(int_from_nat(succ(d)), n))
  | rational(int_negative(n), d): some(rational(int_negative(d), n))

function multiply_optional_rational(x :: Rational, y :: Option(Rational)) :: Option(Rational):
  match y
  | none(): none()
  | some(q): some(rational_multiply(x, q))

function rational_divide(x :: Rational, y :: Rational) :: Option(Rational):
  multiply_optional_rational(x, rational_reciprocal(y))

function rational_le(x :: Rational, y :: Rational) :: Boolean:
  match x
  | rational(a, b):
      match y
      | rational(c, d):
          int_le(
            int_multiply(a, int_from_nat(succ(d))),
            int_multiply(c, int_from_nat(succ(b))))

function rational_equivalent(x :: Rational, y :: Rational) :: Boolean:
  match x
  | rational(a, b):
      match y
      | rational(c, d):
          int_multiply(a, int_from_nat(succ(d))) == int_multiply(c, int_from_nat(succ(b)))

function rational_lt(x :: Rational, y :: Rational) :: Boolean:
  rational_le(x, y) && !rational_equivalent(x, y)

function rational_zero() :: Rational:
  rational_from_integer(int_zero())

function rational_one() :: Rational:
  rational_from_integer(int_one())

function rational_compare(x :: Rational, y :: Rational) :: Ordering:
  if rational_lt(x, y) | less() | (if rational_equivalent(x, y) | equal() | greater())

function rational_min(x :: Rational, y :: Rational) :: Rational:
  if rational_le(x, y) | x | y

function rational_max(x :: Rational, y :: Rational) :: Rational:
  if rational_le(x, y) | y | x


theorem ~rewrite_rule rational_denominator_positive:
  forall (q :: Rational): nat_lt(zero(), rational_denominator(q))
proof:
  auto ~induct: q

theorem ~rewrite_rule rational_negate_involutive:
  forall (q :: Rational): rational_negate(rational_negate(q)) === q
proof:
  auto ~induct: q

theorem ~rewrite_rule rational_add_zero_left:
  forall (q :: Rational): rational_add(rational_from_integer(int_from_nat(zero())), q) === q
proof:
  auto ~induct: q

theorem ~rewrite_rule rational_add_zero_right:
  forall (q :: Rational): rational_add(q, rational_from_integer(int_from_nat(zero()))) === q
proof:
  auto ~induct: q


theorem ~rewrite_rule rational_from_integer_negate:
  forall (z :: Integer): rational_negate(rational_from_integer(z)) === rational_from_integer(int_negate(z))

theorem ~rewrite_rule rational_reciprocal_zero:
  forall (d :: Nat): rational_reciprocal(rational(int_nonnegative(zero()), d)) === none()

theorem ~rewrite_rule rational_reciprocal_positive:
  forall (n :: Nat, d :: Nat):
    rational_reciprocal(rational(int_nonnegative(succ(n)), d)) === some(rational(int_from_nat(succ(d)), n))

theorem ~rewrite_rule rational_reciprocal_negative:
  forall (n :: Nat, d :: Nat):
    rational_reciprocal(rational(int_negative(n), d)) === some(rational(int_negative(d), n))

theorem ~rewrite_rule rational_divide_zero:
  forall (q :: Rational, d :: Nat):
    rational_divide(q, rational(int_nonnegative(zero()), d)) === none()

theorem rational_le_reflexive:
  forall (q :: Rational): rational_le(q, q)
proof:
  auto ~induct: q

theorem rational_equivalent_reflexive:
  forall (q :: Rational): rational_equivalent(q, q)
proof:
  auto ~induct: q

theorem rational_denominator_constructor:
  forall (n :: Integer, d :: Nat): rational_denominator(rational(n, d)) === succ(d)

theorem rational_from_integer_constructor:
  forall (z :: Integer): rational_from_integer(z) === rational(z, zero())

theorem rational_negate_constructor:
  forall (n :: Integer, d :: Nat): rational_negate(rational(n, d)) === rational(int_negate(n), d)

theorem rational_subtract_definition:
  forall (x :: Rational, y :: Rational): rational_subtract(x, y) === rational_add(x, rational_negate(y))

theorem rational_multiply_constructor:
  forall (a :: Integer, b :: Nat, c :: Integer, d :: Nat):
    rational_multiply(rational(a, b), rational(c, d)) === rational(int_multiply(a, c), nat_pred(nat_mul(succ(b), succ(d))))

theorem rational_zero_definition:
  rational_zero() === rational(int_nonnegative(zero()), zero())

theorem rational_one_definition:
  rational_one() === rational(int_nonnegative(nat_one()), zero())

theorem rational_negate_zero:
  rational_negate(rational_zero()) === rational_zero()

theorem rational_subtract_zero:
  forall (q :: Rational): rational_subtract(q, rational_zero()) === q

theorem rational_subtract_self:
  forall (q :: Rational): rational_subtract(q, q) === rational_zero()

theorem rational_multiply_zero_left:
  forall (q :: Rational): rational_multiply(rational_zero(), q) === rational_zero()
proof:
  auto ~induct: q

theorem rational_multiply_zero_right:
  forall (q :: Rational): rational_multiply(q, rational_zero()) === rational_zero()
proof:
  auto ~induct: q

theorem rational_multiply_one_left:
  forall (q :: Rational): rational_multiply(rational_one(), q) === q
proof:
  auto ~induct: q

theorem rational_multiply_one_right:
  forall (q :: Rational): rational_multiply(q, rational_one()) === q
proof:
  auto ~induct: q

theorem rational_from_integer_add:
  forall (x :: Integer, y :: Integer):
    rational_add(rational_from_integer(x), rational_from_integer(y)) === rational_from_integer(int_add(x, y))

theorem rational_from_integer_multiply:
  forall (x :: Integer, y :: Integer):
    rational_multiply(rational_from_integer(x), rational_from_integer(y)) === rational_from_integer(int_multiply(x, y))

theorem rational_equivalent_symmetric:
  forall (x :: Rational, y :: Rational):
    rational_equivalent(x, y) ==> rational_equivalent(y, x)
proof:
  auto ~induct: x

theorem rational_equivalent_definition:
  forall (a :: Integer, b :: Nat, c :: Integer, d :: Nat):
    rational_equivalent(rational(a, b), rational(c, d)) <=> (int_multiply(a, int_from_nat(succ(d))) === int_multiply(c, int_from_nat(succ(b))))

theorem rational_lt_definition:
  forall (x :: Rational, y :: Rational):
    rational_lt(x, y) <=> rational_le(x, y) and not rational_equivalent(x, y)

theorem rational_lt_irreflexive:
  forall (q :: Rational): not rational_lt(q, q)
proof:
  auto(~induct: q)

theorem rational_lt_asymmetric:
  forall (x :: Rational, y :: Rational):
    rational_lt(x, y) ==> not rational_lt(y, x)

theorem rational_compare_equal_iff:
  forall (x :: Rational, y :: Rational):
    rational_compare(x, y) === equal() <=> rational_equivalent(x, y)

theorem rational_compare_less_iff:
  forall (x :: Rational, y :: Rational):
    rational_compare(x, y) === less() <=> rational_lt(x, y)

theorem rational_compare_greater_iff:
  forall (x :: Rational, y :: Rational):
    rational_compare(x, y) === greater() <=> not rational_le(x, y)

theorem rational_min_left:
  forall (x :: Rational, y :: Rational):
    rational_le(x, y) ==> rational_min(x, y) === x

theorem rational_min_right:
  forall (x :: Rational, y :: Rational):
    not rational_le(x, y) ==> rational_min(x, y) === y

theorem rational_max_le_case:
  forall (x :: Rational, y :: Rational):
    rational_le(x, y) ==> rational_max(x, y) === y

theorem rational_max_gt_case:
  forall (x :: Rational, y :: Rational):
    not rational_le(x, y) ==> rational_max(x, y) === x
