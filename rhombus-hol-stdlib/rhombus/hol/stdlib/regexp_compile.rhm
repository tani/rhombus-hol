#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "algorithm.rhm" open
  "regexp.rhm" open

export:
  regexp_compile

// The operator stack makes concatenation explicit. Sequence operators are
// reduced before alternation operators, while group markers stop reduction.
datatype RegexpCompileOperator
| regexp_compile_alternate_operator()
| regexp_compile_sequence_operator()
| regexp_compile_group_operator()

datatype RegexpCompileStacks
| regexp_compile_stacks(
    regexp_compile_values :: List.of(Regexp.of(Codepoint)),
    regexp_compile_operators :: List.of(RegexpCompileOperator))

datatype RegexpCompileState
| regexp_compile_state(
    regexp_compile_state_values :: List.of(Regexp.of(Codepoint)),
    regexp_compile_state_operators :: List.of(RegexpCompileOperator),
    regexp_compile_expects_atom :: Boolean,
    regexp_compile_allows_star :: Boolean)

function regexp_compile_wildcard(_codepoint :: Codepoint) :: Boolean:
  #true

function regexp_compile_apply_operator(
    current_operator :: RegexpCompileOperator,
    stack_values :: List.of(Regexp.of(Codepoint))) :: Option.of(List.of(Regexp.of(Codepoint))):
  match stack_values
  | nil(): none()
  | cons(right_operand, remaining):
      match remaining
      | nil(): none()
      | cons(left_operand, rest):
          match current_operator
          | regexp_compile_alternate_operator():
              some(cons(regexp_alternate(left_operand, right_operand), rest))
          | regexp_compile_sequence_operator():
              some(cons(regexp_sequence(left_operand, right_operand), rest))
          | regexp_compile_group_operator(): none()

function regexp_compile_push_sequence(
    stack_values :: List.of(Regexp.of(Codepoint)),
    operators :: List.of(RegexpCompileOperator)) :: Option.of(RegexpCompileStacks):
  match operators
  | nil():
      some(regexp_compile_stacks(
             stack_values,
             cons(regexp_compile_sequence_operator(), nil())))
  | cons(current_operator, rest):
      // A two-way `if`/`===` rather than a `match` spanning all three
      // `RegexpCompileOperator` constructors: the well-founded-recursion
      // equation derivation cannot discharge a guarded recursive branch
      // that sits alongside two or more sibling constructor cases in one
      // `match` (confirmed with a minimal reproduction -- it fails with
      // "theorem is not an equation" on the disjunction it builds to
      // cover the non-recursive cases together, regardless of how that
      // disjunction is spelled at the surface: explicit arms or a
      // wildcard). Splitting into nested binary tests avoids ever
      // building that disjunction. Separately: the recursive call itself
      // is written as a boolean test (`option_is_none`) plus a direct
      // accessor (`option_get_or`), not a `match` binding a fresh
      // variable, because the termination checker refuses any recursive
      // call that is textually under a binder, regardless of whether the
      // argument actually decreases (see
      // backend/proof/definition/function/termination.rhm's
      // `call_sites_in`). `rest` alone already makes the recursion
      // structural; `stack_values`/the reduced value never need to
      // decrease.
      if current_operator === regexp_compile_sequence_operator()
      | if option_is_none(regexp_compile_apply_operator(current_operator, stack_values))
        | none()
        | regexp_compile_push_sequence(
            option_get_or(stack_values,
                          regexp_compile_apply_operator(current_operator, stack_values)),
            rest)
      | some(regexp_compile_stacks(
               stack_values,
               cons(regexp_compile_sequence_operator(), operators)))

function regexp_compile_push_alternate(
    stack_values :: List.of(Regexp.of(Codepoint)),
    operators :: List.of(RegexpCompileOperator)) :: Option.of(RegexpCompileStacks):
  match operators
  | nil():
      some(regexp_compile_stacks(
             stack_values,
             cons(regexp_compile_alternate_operator(), nil())))
  | cons(current_operator, rest):
      // See regexp_compile_push_sequence's own comment above (both the
      // two-way split and the guarded-recursion shape). Here
      // `alternate_operator` and `sequence_operator` share one identical
      // recursive body, so the shared branch is the non-`group_operator`
      // side of the split.
      if current_operator === regexp_compile_group_operator()
      | some(regexp_compile_stacks(
               stack_values,
               cons(regexp_compile_alternate_operator(), operators)))
      | if option_is_none(regexp_compile_apply_operator(current_operator, stack_values))
        | none()
        | regexp_compile_push_alternate(
            option_get_or(stack_values,
                          regexp_compile_apply_operator(current_operator, stack_values)),
            rest)

function regexp_compile_close_group(
    stack_values :: List.of(Regexp.of(Codepoint)),
    operators :: List.of(RegexpCompileOperator)) :: Option.of(RegexpCompileStacks):
  match operators
  | nil(): none()
  | cons(current_operator, rest):
      // See regexp_compile_push_sequence's own comment above.
      if current_operator === regexp_compile_group_operator()
      | some(regexp_compile_stacks(stack_values, rest))
      | if option_is_none(regexp_compile_apply_operator(current_operator, stack_values))
        | none()
        | regexp_compile_close_group(
            option_get_or(stack_values,
                          regexp_compile_apply_operator(current_operator, stack_values)),
            rest)

function regexp_compile_finish(
    stack_values :: List.of(Regexp.of(Codepoint)),
    operators :: List.of(RegexpCompileOperator)) :: Option.of(Regexp.of(Codepoint)):
  match operators
  | nil():
      match stack_values
      | nil(): none()
      | cons(value, nil()): some(value)
      | cons(_, cons(_, _)): none()
  | cons(current_operator, rest):
      // See regexp_compile_push_sequence's own comment above.
      if current_operator === regexp_compile_group_operator()
      | none()
      | if option_is_none(regexp_compile_apply_operator(current_operator, stack_values))
        | none()
        | regexp_compile_finish(
            option_get_or(stack_values,
                          regexp_compile_apply_operator(current_operator, stack_values)),
            rest)

function regexp_compile_insert_atom(
    atom :: Regexp.of(Codepoint),
    state :: RegexpCompileState) :: Option.of(RegexpCompileState):
  let regexp_compile_state(stack_values, operators, expects_atom, _) = state
  if expects_atom
  | some(regexp_compile_state(cons(atom, stack_values), operators, #false, #true))
  | match regexp_compile_push_sequence(stack_values, operators)
    | none(): none()
    | some(regexp_compile_stacks(next_values, next_operators)):
        some(regexp_compile_state(
               cons(atom, next_values), next_operators, #false, #true))

function regexp_compile_open_group(state :: RegexpCompileState) :: Option.of(RegexpCompileState):
  let regexp_compile_state(stack_values, operators, expects_atom, _) = state
  if expects_atom
  | some(regexp_compile_state(
           stack_values,
           cons(regexp_compile_group_operator(), operators),
           #true,
           #false))
  | match regexp_compile_push_sequence(stack_values, operators)
    | none(): none()
    | some(regexp_compile_stacks(next_values, next_operators)):
        some(regexp_compile_state(
               next_values,
               cons(regexp_compile_group_operator(), next_operators),
               #true,
               #false))

function regexp_compile_insert_alternate(state :: RegexpCompileState) :: Option.of(RegexpCompileState):
  let regexp_compile_state(stack_values, operators, expects_atom, _) = state
  if expects_atom
  | none()
  | match regexp_compile_push_alternate(stack_values, operators)
    | none(): none()
    | some(regexp_compile_stacks(next_values, next_operators)):
        some(regexp_compile_state(
               next_values, next_operators, #true, #false))

function regexp_compile_insert_close(state :: RegexpCompileState) :: Option.of(RegexpCompileState):
  let regexp_compile_state(stack_values, operators, expects_atom, _) = state
  if expects_atom
  | none()
  | match regexp_compile_close_group(stack_values, operators)
    | none(): none()
    | some(regexp_compile_stacks(next_values, next_operators)):
        some(regexp_compile_state(
               next_values, next_operators, #false, #true))

function regexp_compile_insert_star(state :: RegexpCompileState) :: Option.of(RegexpCompileState):
  let regexp_compile_state(stack_values, operators, expects_atom, allows_star) = state
  if expects_atom || !allows_star
  | none()
  | match stack_values
    | nil(): none()
    | cons(value, rest):
        some(regexp_compile_state(
               cons(regexp_star(value), rest), operators, #false, #false))

function regexp_compile_parse(
    codepoints :: List.of(Codepoint),
    state :: RegexpCompileState) :: Option.of(RegexpCompileState):
  match codepoints
  | nil(): some(state)
  | cons(current_codepoint, rest):
      let code = codepoint_to_nat(current_codepoint)
      // Each step below is a boolean test (`option_is_none`) plus a
      // direct accessor (`option_get_or`), not a `match` binding a fresh
      // `next_state` before recursing -- see
      // regexp_compile_push_sequence's own comment for why a recursive
      // call cannot sit under that binder.
      if code == 92
      | match rest
        | nil(): none()
        | cons(escaped, remaining):
            if option_is_none(regexp_compile_insert_atom(
                                 regexp_literal(codepoint_equal, escaped), state))
            | none()
            | regexp_compile_parse(
                remaining,
                option_get_or(state,
                              regexp_compile_insert_atom(
                                regexp_literal(codepoint_equal, escaped), state)))
      | if code == 124
        | if option_is_none(regexp_compile_insert_alternate(state))
          | none()
          | regexp_compile_parse(
              rest, option_get_or(state, regexp_compile_insert_alternate(state)))
        | if code == 42
          | if option_is_none(regexp_compile_insert_star(state))
            | none()
            | regexp_compile_parse(
                rest, option_get_or(state, regexp_compile_insert_star(state)))
          | if code == 40
            | if option_is_none(regexp_compile_open_group(state))
              | none()
              | regexp_compile_parse(
                  rest, option_get_or(state, regexp_compile_open_group(state)))
            | if code == 41
              | if option_is_none(regexp_compile_insert_close(state))
                | none()
                | regexp_compile_parse(
                    rest, option_get_or(state, regexp_compile_insert_close(state)))
              | if code == 46
                | if option_is_none(regexp_compile_insert_atom(
                                       regexp_atom(regexp_compile_wildcard), state))
                  | none()
                  | regexp_compile_parse(
                      rest,
                      option_get_or(state,
                                    regexp_compile_insert_atom(
                                      regexp_atom(regexp_compile_wildcard), state)))
                | if option_is_none(regexp_compile_insert_atom(
                                       regexp_literal(codepoint_equal, current_codepoint),
                                       state))
                  | none()
                  | regexp_compile_parse(
                      rest,
                      option_get_or(state,
                                    regexp_compile_insert_atom(
                                      regexp_literal(codepoint_equal, current_codepoint),
                                      state)))

function regexp_compile(source :: String) :: Option.of(Regexp.of(Codepoint)):
  let codepoints = string_to_codepoints(source)
  match codepoints
  | nil(): some(regexp_epsilon())
  | cons(_, _):
      match regexp_compile_parse(
              codepoints,
              regexp_compile_state(nil(), nil(), #true, #false))
      | none(): none()
      | some(regexp_compile_state(stack_values, operators, expects_atom, _)):
          if expects_atom | none() | regexp_compile_finish(stack_values, operators)

// The empty-pattern case is the one intentional exception to the grammar's
// ban on empty expressions.
theorem regexp_compile_empty:
  regexp_compile(string_empty()) === some(regexp_epsilon())
proof:
  ~sorry

theorem regexp_compile_dangling_escape:
  regexp_compile(string_singleton(codepoint(92))) === none()
proof:
  ~sorry
