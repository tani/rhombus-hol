#lang rhombus/hol

// Listed in dependency order, ascending (data first, regexp_compile
// last): the kernel's theory lineage is a single chain, so importing an
// earlier ancestor after a later file that already extends it fails the
// same way a genuine sibling would. See automaton.rhm's own import
// comment for the general constraint.
//
// `regexp_compile.rhm` is imported for that reason alone, not for its
// names (this file never calls `regexp_compile`): it and this file are
// both direct, otherwise-unrelated extensions of `regexp.rhm` (compiling
// a pattern vs. searching with an already-compiled one), so stdlib.rhm's
// aggregator -- which needs both -- cannot import them as siblings any
// more than it could import integer.rhm and finite.rhm as siblings.
// Importing the other one here, rather than vice versa, is arbitrary;
// what matters is that exactly one of the two files extends the other.
import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "algorithm.rhm" open
  "automaton.rhm" open
  "regexp.rhm" open
  "regexp_compile.rhm" open

export:
  RegexpMatch
  regexp_match
  regexp_match_start
  regexp_match_end
  regexp_find
  regexp_replace_first
  regexp_replace_all
  string_regexp_matches
  string_regexp_find
  string_regexp_replace_first
  string_regexp_replace_all

// Match ranges are half-open: `start` is included and `end` is excluded.
datatype RegexpMatch
| regexp_match(regexp_match_start_value :: Nat,
               regexp_match_end_value :: Nat)

function regexp_match_start(m :: RegexpMatch) :: Nat:
  let regexp_match(start, _) = m
  start

function regexp_match_end(m :: RegexpMatch) :: Nat:
  let regexp_match(_, end) = m
  end

// Search a DFA from a supplied state. Recursing to the end before considering
// the current final state makes a later accepted prefix win, hence longest.
function dfa_longest_accepted_prefix_from(m :: DFA.of(?q, ?a),
                                          q :: ?q,
                                          input :: List.of(?a)) :: Option.of(Nat):
  match input
  | nil():
      if dfa_final(m, q) | some(zero()) | none()
  | cons(x, rest):
      match dfa_longest_accepted_prefix_from(m, dfa_transition(m, q, x), rest)
      | none():
          if dfa_final(m, q) | some(zero()) | none()
      | some(n): some(succ(n))

function dfa_longest_accepted_prefix(m :: DFA.of(?q, ?a),
                                     input :: List.of(?a)) :: Option.of(Nat):
  dfa_longest_accepted_prefix_from(m, dfa_initial(m), input)

function regexp_match_shift(m :: RegexpMatch) :: RegexpMatch:
  let regexp_match(start, end) = m
  regexp_match(succ(start), succ(end))

// Suffixes are tried from left to right. The first suffix with an accepted
// prefix is therefore leftmost, while the helper above chooses its longest end.
//
// Matches on the function's own top-level parameter (`input`: nil vs.
// cons) rather than the original's `match dfa_longest_accepted_prefix(m,
// input) | ... | none(): match input | ...`, whose recursive call sat
// under two nested binders (one on a computed value, one on `input`
// itself but not at the top level) -- the kernel's termination checker
// refuses a recursive call under any binder besides the function's own
// single top-level match (see regexp_compile.rhm's
// regexp_compile_push_sequence/regexp_compile_parse for the fuller
// explanation and a minimal reproduction). `dfa_longest_accepted_prefix`
// is called twice in the `cons` case (once for the test, once for the
// accessor) rather than bound once, for the same reason.
function dfa_find(m :: DFA.of(?q, ?a),
                  input :: List.of(?a)) :: Option.of(RegexpMatch):
  match input
  | nil():
      if option_is_none(dfa_longest_accepted_prefix(m, input))
      | none()
      | some(regexp_match(zero(), option_get_or(zero(), dfa_longest_accepted_prefix(m, input))))
  | cons(_, rest):
      if option_is_none(dfa_longest_accepted_prefix(m, input))
      | option_map(regexp_match_shift, dfa_find(m, rest))
      | some(regexp_match(zero(), option_get_or(zero(), dfa_longest_accepted_prefix(m, input))))

function regexp_find(r :: Regexp.of(?a),
                     input :: List.of(?a)) :: Option.of(RegexpMatch):
  dfa_find(regexp_to_dfa(r), input)

function regexp_replace_range(input :: List.of(?a),
                              replacement :: List.of(?a),
                              range :: RegexpMatch) :: List.of(?a):
  let regexp_match(start, end) = range
  list_append(
    list_take(start, input),
    list_append(replacement, list_drop(end, input)))

function regexp_replace_first(r :: Regexp.of(?a),
                              replacement :: List.of(?a),
                              input :: List.of(?a)) :: List.of(?a):
  match regexp_find(r, input)
  | none(): input
  | some(range): regexp_replace_range(input, replacement, range)

// Fuel is one greater than the original input length. Every recursive call
// spends one unit. A nonempty match consumes original input; an empty match
// copies one original symbol before continuing, or inserts once and stops at
// EOF. Replacement symbols are only appended and are never searched.
//
// Non-recursive accessors for the pieces `dfa_replace_all_with_fuel`
// needs, each recomputing `dfa_find(m, input)` rather than having a
// caller bind it once: a recursive function cannot itself sequence a
// `let`/`block:` ahead of one of its own recursive calls either (like
// `match`, this also introduces a binder, confirmed with a minimal
// reproduction -- scratchpad/termtest/t26 vs t27), so these repeated,
// individually plain function calls are what `dfa_replace_all_with_fuel`
// below is restricted to using.
function dfa_replace_found(m :: DFA.of(?q, ?a), input :: List.of(?a)) :: RegexpMatch:
  option_get_or(regexp_match(zero(), zero()), dfa_find(m, input))

function dfa_replace_prefix(m :: DFA.of(?q, ?a), input :: List.of(?a)) :: List.of(?a):
  list_take(regexp_match_start(dfa_replace_found(m, input)), input)

function dfa_replace_unmatched(m :: DFA.of(?q, ?a), input :: List.of(?a)) :: List.of(?a):
  list_drop(regexp_match_start(dfa_replace_found(m, input)), input)

function dfa_replace_is_empty_match(m :: DFA.of(?q, ?a), input :: List.of(?a)) :: Boolean:
  let found = dfa_replace_found(m, input)
  nat_sub(regexp_match_end(found), regexp_match_start(found)) === zero()

// See dfa_find's own comment above: no nested `match` on a computed
// value (`dfa_find`'s result, the `regexp_match` pair inside it,
// `nat_sub`'s result, or `unmatched`'s shape) may sit ahead of a
// recursive call, so the helpers above replace each of those. The
// empty-match branch takes one element via `list_take`/`list_drop` with
// a literal count rather than destructuring `unmatched` into `cons(x,
// rest)`, because unlike `RegexpMatch`/`Nat` above, there is no
// arbitrary placeholder value of the function's own generic element
// type `?a` available for `option_get_or`'s default if `unmatched` were
// accessed via `list_head`/`list_tail` instead. `fuel`'s own decrease
// (`succ(rest_fuel) -> rest_fuel`, untouched by any of this) is what the
// termination checker actually verifies; the other argument position
// does not need to decrease at all.
function dfa_replace_all_with_fuel(m :: DFA.of(?q, ?a),
                                   replacement :: List.of(?a),
                                   input :: List.of(?a),
                                   fuel :: Nat) :: List.of(?a):
  match fuel
  | zero(): input
  | succ(rest_fuel):
      if option_is_none(dfa_find(m, input))
      | input
      | if dfa_replace_is_empty_match(m, input)
        | if list_null(dfa_replace_unmatched(m, input))
          | list_append(dfa_replace_prefix(m, input), replacement)
          | list_append(
              dfa_replace_prefix(m, input),
              list_append(
                replacement,
                list_append(
                  list_take(nat_one(), dfa_replace_unmatched(m, input)),
                  dfa_replace_all_with_fuel(
                    m, replacement,
                    list_drop(nat_one(), dfa_replace_unmatched(m, input)),
                    rest_fuel))))
        | list_append(
            dfa_replace_prefix(m, input),
            list_append(
              replacement,
              dfa_replace_all_with_fuel(
                m, replacement,
                list_drop(regexp_match_end(dfa_replace_found(m, input)), input),
                rest_fuel)))

function regexp_replace_all(r :: Regexp.of(?a),
                            replacement :: List.of(?a),
                            input :: List.of(?a)) :: List.of(?a):
  dfa_replace_all_with_fuel(
    regexp_to_dfa(r), replacement, input, succ(list_length(input)))

// String operations are thin codepoint-list adapters; all matching and
// replacement behavior remains in the generic list implementation.
function string_regexp_matches(
    r :: Regexp.of(Codepoint), input :: String) :: Boolean:
  regexp_matches(r, string_to_codepoints(input))

function string_regexp_find(
    r :: Regexp.of(Codepoint),
    input :: String) :: Option.of(RegexpMatch):
  regexp_find(r, string_to_codepoints(input))

function string_regexp_replace_first(
    r :: Regexp.of(Codepoint),
    replacement :: String,
    input :: String) :: String:
  string_from_codepoints(
    regexp_replace_first(
      r,
      string_to_codepoints(replacement),
      string_to_codepoints(input)))

function string_regexp_replace_all(
    r :: Regexp.of(Codepoint),
    replacement :: String,
    input :: String) :: String:
  string_from_codepoints(
    regexp_replace_all(
      r,
      string_to_codepoints(replacement),
      string_to_codepoints(input)))

// Range constructor equations.
theorem regexp_match_start_constructor:
  forall (start :: Nat, end :: Nat):
    regexp_match_start(regexp_match(start, end)) === start
proof:
  ~sorry

theorem regexp_match_end_constructor:
  forall (start :: Nat, end :: Nat):
    regexp_match_end(regexp_match(start, end)) === end
proof:
  ~sorry

theorem regexp_match_shift_constructor:
  forall (start :: Nat, end :: Nat):
    regexp_match_shift(regexp_match(start, end))
      === regexp_match(succ(start), succ(end))
proof:
  ~sorry

// Longest-prefix constructor and decision equations.
theorem dfa_longest_accepted_prefix_from_nil:
  forall (m :: DFA.of(?q, ?a), q :: ?q):
    dfa_longest_accepted_prefix_from(m, q, nil())
      === (if dfa_final(m, q) | some(zero()) | none())
proof:
  ~sorry

theorem dfa_longest_accepted_prefix_nil:
  forall (m :: DFA.of(?q, ?a)):
    dfa_longest_accepted_prefix(m, nil())
      === (if dfa_final(m, dfa_initial(m)) | some(zero()) | none())
proof:
  ~sorry

theorem dfa_longest_accepted_prefix_from_cons_some:
  forall (m :: DFA.of(?q, ?a),
          q :: ?q,
          x :: ?a,
          xs :: List.of(?a),
          n :: Nat):
    dfa_longest_accepted_prefix_from(m, dfa_transition(m, q, x), xs) === some(n)
      ==> dfa_longest_accepted_prefix_from(m, q, cons(x, xs)) === some(succ(n))
proof:
  ~sorry

theorem dfa_longest_accepted_prefix_from_cons_none_final:
  forall (m :: DFA.of(?q, ?a),
          q :: ?q,
          x :: ?a,
          xs :: List.of(?a)):
    dfa_longest_accepted_prefix_from(m, dfa_transition(m, q, x), xs) === none()
      ==> dfa_final(m, q)
      ==> dfa_longest_accepted_prefix_from(m, q, cons(x, xs)) === some(zero())
proof:
  ~sorry

theorem dfa_longest_accepted_prefix_from_cons_none_nonfinal:
  forall (m :: DFA.of(?q, ?a),
          q :: ?q,
          x :: ?a,
          xs :: List.of(?a)):
    dfa_longest_accepted_prefix_from(m, dfa_transition(m, q, x), xs) === none()
      ==> not dfa_final(m, q)
      ==> dfa_longest_accepted_prefix_from(m, q, cons(x, xs)) === none()
proof:
  ~sorry

// Find equations expose the leftmost scan and the longest result at a suffix.
theorem dfa_find_nil:
  forall (m :: DFA.of(?q, ?a)):
    dfa_find(m, nil())
      === (if dfa_final(m, dfa_initial(m))
           | some(regexp_match(zero(), zero()))
           | none())
proof:
  ~sorry

theorem dfa_find_here:
  forall (m :: DFA.of(?q, ?a), input :: List.of(?a), end :: Nat):
    dfa_longest_accepted_prefix(m, input) === some(end)
      ==> dfa_find(m, input) === some(regexp_match(zero(), end))
proof:
  ~sorry

theorem dfa_find_nil_none:
  forall (m :: DFA.of(?q, ?a)):
    dfa_longest_accepted_prefix(m, nil()) === none()
      ==> dfa_find(m, nil()) === none()
proof:
  ~sorry

theorem dfa_find_cons_later:
  forall (m :: DFA.of(?q, ?a), x :: ?a, xs :: List.of(?a)):
    dfa_longest_accepted_prefix(m, cons(x, xs)) === none() ==> dfa_find(m, cons(x, xs)) === option_map(regexp_match_shift, dfa_find(m, xs))
proof:
  ~sorry

theorem regexp_find_nil:
  forall (r :: Regexp.of(?a)):
    regexp_find(r, nil())
      === (if dfa_final(regexp_to_dfa(r), dfa_initial(regexp_to_dfa(r)))
           | some(regexp_match(zero(), zero()))
           | none())
proof:
  ~sorry

theorem regexp_find_here:
  forall (r :: Regexp.of(?a), input :: List.of(?a), end :: Nat):
    dfa_longest_accepted_prefix(regexp_to_dfa(r), input) === some(end)
      ==> regexp_find(r, input) === some(regexp_match(zero(), end))
proof:
  ~sorry

theorem regexp_find_cons_later:
  forall (r :: Regexp.of(?a), x :: ?a, xs :: List.of(?a)):
    dfa_longest_accepted_prefix(regexp_to_dfa(r), cons(x, xs)) === none() ==> regexp_find(r, cons(x, xs)) === option_map(regexp_match_shift, regexp_find(r, xs))
proof:
  ~sorry

// Replacement equations state absence, exact found-range decomposition, and
// the progress rule that makes global replacement total for nullable regexps.
theorem regexp_replace_first_none:
  forall (r :: Regexp.of(?a),
          replacement :: List.of(?a),
          input :: List.of(?a)):
    regexp_find(r, input) === none()
      ==> regexp_replace_first(r, replacement, input) === input
proof:
  ~sorry

theorem regexp_replace_first_found:
  forall (r :: Regexp.of(?a),
          replacement :: List.of(?a),
          input :: List.of(?a),
          start :: Nat,
          end :: Nat):
    regexp_find(r, input) === some(regexp_match(start, end)) ==> regexp_replace_first(r, replacement, input) === list_append(list_take(start, input), list_append(replacement, list_drop(end, input)))
proof:
  ~sorry

theorem regexp_replace_all_none:
  forall (r :: Regexp.of(?a),
          replacement :: List.of(?a),
          input :: List.of(?a)):
    regexp_find(r, input) === none()
      ==> regexp_replace_all(r, replacement, input) === input
proof:
  ~sorry

theorem regexp_replace_all_empty_cons_progress:
  forall (r :: Regexp.of(?a),
          replacement :: List.of(?a),
          x :: ?a,
          xs :: List.of(?a)):
    regexp_find(r, cons(x, xs)) === some(regexp_match(zero(), zero())) ==> regexp_replace_all(r, replacement, cons(x, xs)) === list_append(replacement, cons(x, regexp_replace_all(r, replacement, xs)))
proof:
  ~sorry

theorem regexp_replace_all_empty_nil:
  forall (r :: Regexp.of(?a), replacement :: List.of(?a)):
    regexp_find(r, nil()) === some(regexp_match(zero(), zero()))
      ==> regexp_replace_all(r, replacement, nil()) === replacement
proof:
  ~sorry
