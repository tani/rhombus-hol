#lang rhombus/hol

import: "logic.rhm" open

import: "list.rhm" open

export:
  relation_identity
  relation_empty
  relation_universal
  relation_inverse
  relation_union
  relation_intersection
  relation_reflexive_closure
  relation_difference
  relation_complement
  relation_symmetric_difference
  relation_equal_at
  relation_reflexive_at
  relation_symmetric_at
  relation_antisymmetric_at
  relation_transitive_at
  relation_total_at

  set_member
  set_empty
  set_universal
  set_singleton
  set_insert
  set_delete
  set_union
  set_intersection
  set_difference
  set_complement
  set_preimage
  set_subset_at
  set_disjoint_at
  set_symmetric_difference
  set_equal_at

// Relations and sets are extensional predicates. Operations are represented
// pointwise so they remain executable without introducing a second set type.
function relation_identity(x :: ?a, y :: ?a) :: Boolean:
  x == y

function relation_empty(_x :: ?a, _y :: ?a) :: Boolean:
  #false

function relation_universal(_x :: ?a, _y :: ?a) :: Boolean:
  #true

function relation_inverse(r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a) :: Boolean:
  r(y)(x)

function relation_union(r :: ?a -> ?a -> Boolean,
                        s :: ?a -> ?a -> Boolean,
                        x :: ?a,
                        y :: ?a) :: Boolean:
  r(x)(y) || s(x)(y)

function relation_intersection(r :: ?a -> ?a -> Boolean,
                               s :: ?a -> ?a -> Boolean,
                               x :: ?a,
                               y :: ?a) :: Boolean:
  r(x)(y) && s(x)(y)

function relation_difference(r :: ?a -> ?a -> Boolean,
                             s :: ?a -> ?a -> Boolean,
                             x :: ?a, y :: ?a) :: Boolean:
  r(x)(y) && !s(x)(y)

function relation_complement(r :: ?a -> ?a -> Boolean,
                             x :: ?a, y :: ?a) :: Boolean:
  !r(x)(y)

function relation_symmetric_difference(r :: ?a -> ?a -> Boolean,
                                       s :: ?a -> ?a -> Boolean,
                                       x :: ?a, y :: ?a) :: Boolean:
  boolean_xor(r(x)(y), s(x)(y))

function relation_equal_at(r :: ?a -> ?a -> Boolean,
                           s :: ?a -> ?a -> Boolean,
                           x :: ?a, y :: ?a) :: Boolean:
  r(x)(y) == s(x)(y)

function relation_reflexive_closure(r :: ?a -> ?a -> Boolean,
                                    x :: ?a,
                                    y :: ?a) :: Boolean:
  x == y || r(x)(y)

function relation_reflexive_at(r :: ?a -> ?a -> Boolean, x :: ?a) :: Boolean:
  r(x)(x)

function relation_symmetric_at(r :: ?a -> ?a -> Boolean,
                               x :: ?a,
                               y :: ?a) :: Boolean:
  !r(x)(y) || r(y)(x)

function relation_antisymmetric_at(r :: ?a -> ?a -> Boolean,
                                   x :: ?a,
                                   y :: ?a) :: Boolean:
  !(r(x)(y) && r(y)(x)) || x == y

function relation_transitive_at(r :: ?a -> ?a -> Boolean,
                                x :: ?a,
                                y :: ?a,
                                z :: ?a) :: Boolean:
  !(r(x)(y) && r(y)(z)) || r(x)(z)

function relation_total_at(r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a) :: Boolean:
  r(x)(y) || r(y)(x)

function set_member(s :: ?a -> Boolean, x :: ?a) :: Boolean:
  s(x)

function set_empty(_x :: ?a) :: Boolean:
  #false

function set_universal(_x :: ?a) :: Boolean:
  #true

function set_singleton(a :: ?a, x :: ?a) :: Boolean:
  x == a

function set_insert(a :: ?a, s :: ?a -> Boolean, x :: ?a) :: Boolean:
  x == a || s(x)

function set_delete(a :: ?a, s :: ?a -> Boolean, x :: ?a) :: Boolean:
  !(x == a) && s(x)

function set_union(s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a) :: Boolean:
  s(x) || t(x)

function set_intersection(s :: ?a -> Boolean,
                          t :: ?a -> Boolean,
                          x :: ?a) :: Boolean:
  s(x) && t(x)

function set_difference(s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a) :: Boolean:
  s(x) && !t(x)

function set_symmetric_difference(s :: ?a -> Boolean,
                                  t :: ?a -> Boolean, x :: ?a) :: Boolean:
  boolean_xor(s(x), t(x))

function set_equal_at(s :: ?a -> Boolean,
                      t :: ?a -> Boolean, x :: ?a) :: Boolean:
  s(x) == t(x)

function set_complement(s :: ?a -> Boolean, x :: ?a) :: Boolean:
  !s(x)

function set_preimage(f :: ?a -> ?b, s :: ?b -> Boolean, x :: ?a) :: Boolean:
  s(f(x))

function set_subset_at(s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a) :: Boolean:
  !s(x) || t(x)

function set_disjoint_at(s :: ?a -> Boolean,
                         t :: ?a -> Boolean,
                         x :: ?a) :: Boolean:
  !(s(x) && t(x))

overload member(
  element :: ?a,
  collection :: ?a -> Boolean
) = set_member(collection, element)
overload union(
  ?a -> Boolean,
  ?a -> Boolean
) = set_union
overload union(
  ?a -> ?a -> Boolean,
  ?a -> ?a -> Boolean
) = relation_union
overload intersection(
  ?a -> Boolean,
  ?a -> Boolean
) = set_intersection
overload intersection(
  ?a -> ?a -> Boolean,
  ?a -> ?a -> Boolean
) = relation_intersection
overload subtract(
  ?a -> Boolean,
  ?a -> Boolean
) = set_difference
overload subtract(
  ?a -> ?a -> Boolean,
  ?a -> ?a -> Boolean
) = relation_difference



// Relation normal forms.
theorem inverse_apply:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_inverse(r, x, y) <=> r(y)(x)

theorem inverse_inverse:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_inverse(relation_inverse(r), x, y) <=> r(x)(y)

theorem relation_union_apply:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean,
          x :: ?a,
          y :: ?a):
    relation_union(r, s, x, y) <=> r(x)(y) or s(x)(y)

theorem relation_intersection_apply:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean,
          x :: ?a,
          y :: ?a):
    relation_intersection(r, s, x, y) <=> r(x)(y) and s(x)(y)

theorem reflexive_closure_refl:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a):
    relation_reflexive_closure(r, x, x)

theorem reflexive_closure_step:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    r(x)(y) ==> relation_reflexive_closure(r, x, y)

// Set membership normal forms.
theorem member_empty:
  forall (x :: ?a): not set_member(set_empty, x)

theorem member_universal:
  forall (x :: ?a): set_member(set_universal, x)

theorem member_singleton:
  forall (a :: ?a, x :: ?a): set_member(set_singleton(a), x) <=> x === a

theorem member_insert:
  forall (a :: ?a, s :: ?a -> Boolean, x :: ?a):
    set_member(set_insert(a, s), x) <=> x === a or set_member(s, x)

theorem member_delete:
  forall (a :: ?a, s :: ?a -> Boolean, x :: ?a):
    set_member(set_delete(a, s), x) <=> not (x === a) and set_member(s, x)

theorem member_union:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_member(set_union(s, t), x) <=> set_member(s, x) or set_member(t, x)

theorem member_intersection:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_member(set_intersection(s, t), x) <=> set_member(s, x) and set_member(t, x)

theorem member_difference:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_member(set_difference(s, t), x) <=> set_member(s, x) and not set_member(t, x)

theorem member_complement:
  forall (s :: ?a -> Boolean, x :: ?a):
    set_member(set_complement(s), x) <=> not set_member(s, x)

theorem member_preimage:
  forall (f :: ?a -> ?b, s :: ?b -> Boolean, x :: ?a):
    set_member(set_preimage(f, s), x) <=> set_member(s, f(x))

// Extensionality is manual, never an always-on rewrite.
theorem set_ext:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean):
    (forall (x :: ?a): set_member(s, x) <=> set_member(t, x)) ==> s === t

theorem relation_ext:
  forall (r :: ?a -> ?a -> Boolean, s :: ?a -> ?a -> Boolean):
    (forall (x :: ?a, y :: ?a): r(x)(y) <=> s(x)(y)) ==> r === s

// Boolean-algebra laws are pointwise and deliberately not global rewrites.
theorem set_union_commutative:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_union(s, t, x) <=> set_union(t, s, x)
proof:
  ~split: s(x)
  ~split: t(x)

theorem set_union_associative:
  forall (r :: ?a -> Boolean,
          s :: ?a -> Boolean,
          t :: ?a -> Boolean,
          x :: ?a):
    set_union(set_union(r, s), t, x) <=> set_union(r, set_union(s, t), x)
proof:
  ~use: [or_associative]

theorem set_intersection_commutative:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_intersection(s, t, x) <=> set_intersection(t, s, x)
proof:
  ~split: s(x)
  ~split: t(x)

theorem set_intersection_associative:
  forall (r :: ?a -> Boolean,
          s :: ?a -> Boolean,
          t :: ?a -> Boolean,
          x :: ?a):
    set_intersection(set_intersection(r, s), t, x) <=> set_intersection(r, set_intersection(s, t), x)
proof:
  ~use: [and_associative]

theorem set_complement_involutive:
  forall (s :: ?a -> Boolean, x :: ?a):
    set_complement(set_complement(s), x) <=> s(x)
proof:
  ~split: s(x)

theorem set_de_morgan_union:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_complement(set_union(s, t), x) <=> set_intersection(set_complement(s), set_complement(t), x)
proof:
  ~use: [de_morgan_or]

theorem relation_identity_reflexive:
  forall (x :: ?a): relation_reflexive_at(relation_identity, x)

theorem relation_identity_symmetric:
  forall (x :: ?a, y :: ?a): relation_symmetric_at(relation_identity, x, y)
proof:
  ~split: x === y

theorem relation_identity_antisymmetric:
  forall (x :: ?a, y :: ?a): relation_antisymmetric_at(relation_identity, x, y)
proof:
  ~split: x === y
  ~split: y === x

theorem relation_identity_transitive:
  forall (x :: ?a, y :: ?a, z :: ?a): relation_transitive_at(relation_identity, x, y, z)
proof:
  ~split: x === y
  ~split: y === z

theorem relation_empty_irreflexive:
  forall (x :: ?a): not relation_reflexive_at(relation_empty, x)

theorem relation_empty_symmetric:
  forall (x :: ?a, y :: ?a): relation_symmetric_at(relation_empty, x, y)

theorem relation_empty_antisymmetric:
  forall (x :: ?a, y :: ?a): relation_antisymmetric_at(relation_empty, x, y)

theorem relation_empty_transitive:
  forall (x :: ?a, y :: ?a, z :: ?a): relation_transitive_at(relation_empty, x, y, z)

theorem relation_universal_reflexive:
  forall (x :: ?a): relation_reflexive_at(relation_universal, x)

theorem relation_universal_symmetric:
  forall (x :: ?a, y :: ?a): relation_symmetric_at(relation_universal, x, y)

theorem relation_universal_transitive:
  forall (x :: ?a, y :: ?a, z :: ?a): relation_transitive_at(relation_universal, x, y, z)

theorem relation_universal_total:
  forall (x :: ?a, y :: ?a): relation_total_at(relation_universal, x, y)

theorem inverse_reflexive_at:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a):
    relation_reflexive_at(relation_inverse(r), x) <=> relation_reflexive_at(r, x)

theorem inverse_symmetric_at:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_symmetric_at(relation_inverse(r), x, y) <=> relation_symmetric_at(r, y, x)

theorem inverse_antisymmetric_at:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_antisymmetric_at(relation_inverse(r), x, y) <=> relation_antisymmetric_at(r, x, y)
proof:
  ~split: r(x)(y)
  ~split: r(y)(x)
  ~split: x === y

theorem inverse_total_at:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_total_at(relation_inverse(r), x, y) <=> relation_total_at(r, x, y)
proof:
  ~split: r(x)(y)
  ~split: r(y)(x)

theorem inverse_transitive_at:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a, z :: ?a):
    relation_transitive_at(relation_inverse(r), z, y, x)
      <=> relation_transitive_at(r, x, y, z)
proof:
  ~split: r(x)(y)
  ~split: r(y)(z)
  ~split: r(x)(z)

theorem set_subset_reflexive_at:
  forall (s :: ?a -> Boolean, x :: ?a): set_subset_at(s, s, x)
proof:
  ~split: s(x)

theorem set_empty_subset_at:
  forall (s :: ?a -> Boolean, x :: ?a): set_subset_at(set_empty, s, x)

theorem set_subset_universal_at:
  forall (s :: ?a -> Boolean, x :: ?a): set_subset_at(s, set_universal, x)

theorem set_disjoint_symmetric_at:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_disjoint_at(s, t, x) <=> set_disjoint_at(t, s, x)
proof:
  ~split: s(x)
  ~split: t(x)

// Additional pointwise relation and set laws.
theorem relation_difference_apply:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean,
          x :: ?a,
          y :: ?a):
    relation_difference(r, s, x, y) <=> r(x)(y) and not s(x)(y)

theorem relation_complement_apply:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_complement(r, x, y) <=> not r(x)(y)

theorem relation_symmetric_difference_apply:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean,
          x :: ?a,
          y :: ?a):
    relation_symmetric_difference(r, s, x, y) <=> boolean_xor(r(x)(y), s(x)(y))

theorem relation_equal_at_apply:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean,
          x :: ?a,
          y :: ?a):
    relation_equal_at(r, s, x, y) <=> (r(x)(y) <=> s(x)(y))

theorem relation_union_empty_left:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_union(relation_empty, r, x, y) <=> r(x)(y)

theorem relation_union_empty_right:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_union(r, relation_empty, x, y) <=> r(x)(y)

theorem relation_union_universal_left:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_union(relation_universal, r, x, y)

theorem relation_union_universal_right:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_union(r, relation_universal, x, y)

theorem relation_union_idempotent:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_union(r, r, x, y) <=> r(x)(y)
proof:
  ~split: r(x)(y)

theorem relation_intersection_empty_left:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    not relation_intersection(relation_empty, r, x, y)

theorem relation_intersection_empty_right:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    not relation_intersection(r, relation_empty, x, y)

theorem relation_intersection_universal_left:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_intersection(relation_universal, r, x, y) <=> r(x)(y)

theorem relation_intersection_universal_right:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_intersection(r, relation_universal, x, y) <=> r(x)(y)

theorem relation_intersection_idempotent:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_intersection(r, r, x, y) <=> r(x)(y)
proof:
  ~split: r(x)(y)

theorem relation_difference_empty_right:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_difference(r, relation_empty, x, y) <=> r(x)(y)

theorem relation_difference_empty_left:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    not relation_difference(relation_empty, r, x, y)

theorem relation_difference_self:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    not relation_difference(r, r, x, y)
proof:
  ~split: r(x)(y)

theorem relation_complement_empty:
  forall (x :: ?a, y :: ?a): relation_complement(relation_empty, x, y)

theorem relation_complement_universal:
  forall (x :: ?a, y :: ?a): not relation_complement(relation_universal, x, y)

theorem relation_de_morgan_union:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean,
          x :: ?a,
          y :: ?a):
    relation_complement(relation_union(r, s), x, y) <=> relation_intersection(relation_complement(r), relation_complement(s), x, y)
proof:
  ~use: [de_morgan_or]

theorem relation_de_morgan_intersection:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean,
          x :: ?a,
          y :: ?a):
    relation_complement(relation_intersection(r, s), x, y) <=> relation_union(relation_complement(r), relation_complement(s), x, y)
proof:
  ~use: [de_morgan_and]

theorem inverse_identity:
  forall (x :: ?a, y :: ?a): relation_inverse(relation_identity, x, y) <=> relation_identity(y, x)

theorem inverse_empty:
  forall (x :: ?a, y :: ?a): not relation_inverse(relation_empty, x, y)

theorem inverse_universal:
  forall (x :: ?a, y :: ?a): relation_inverse(relation_universal, x, y)

theorem inverse_union:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean,
          x :: ?a,
          y :: ?a):
    relation_inverse(relation_union(r, s), x, y) <=> relation_union(relation_inverse(r), relation_inverse(s), x, y)

theorem inverse_intersection:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean,
          x :: ?a,
          y :: ?a):
    relation_inverse(relation_intersection(r, s), x, y) <=> relation_intersection(relation_inverse(r), relation_inverse(s), x, y)

theorem inverse_difference:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean,
          x :: ?a,
          y :: ?a):
    relation_inverse(relation_difference(r, s), x, y) <=> relation_difference(relation_inverse(r), relation_inverse(s), x, y)

theorem inverse_complement:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_inverse(relation_complement(r), x, y) <=> relation_complement(relation_inverse(r), x, y)

theorem reflexive_closure_identity:
  forall (x :: ?a, y :: ?a):
    relation_reflexive_closure(relation_identity, x, y) <=> relation_identity(x, y)
proof:
  ~use: [or_idempotent]

theorem reflexive_closure_empty:
  forall (x :: ?a, y :: ?a):
    relation_reflexive_closure(relation_empty, x, y) <=> relation_identity(x, y)

theorem reflexive_closure_idempotent:
  forall (r :: ?a -> ?a -> Boolean, x :: ?a, y :: ?a):
    relation_reflexive_closure(relation_reflexive_closure(r), x, y)
      <=> (x === y) or relation_reflexive_closure(r, x, y)

theorem member_symmetric_difference:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_member(set_symmetric_difference(s, t), x) <=> boolean_xor(set_member(s, x), set_member(t, x))

theorem set_union_empty_left:
  forall (s :: ?a -> Boolean, x :: ?a): set_union(set_empty, s, x) <=> s(x)

theorem set_union_empty_right:
  forall (s :: ?a -> Boolean, x :: ?a): set_union(s, set_empty, x) <=> s(x)

theorem set_union_universal_left:
  forall (s :: ?a -> Boolean, x :: ?a): set_union(set_universal, s, x)

theorem set_union_universal_right:
  forall (s :: ?a -> Boolean, x :: ?a): set_union(s, set_universal, x)

theorem set_union_idempotent:
  forall (s :: ?a -> Boolean, x :: ?a): set_union(s, s, x) <=> s(x)
proof:
  ~split: s(x)

theorem set_intersection_empty_left:
  forall (s :: ?a -> Boolean, x :: ?a): not set_intersection(set_empty, s, x)

theorem set_intersection_empty_right:
  forall (s :: ?a -> Boolean, x :: ?a): not set_intersection(s, set_empty, x)

theorem set_intersection_universal_left:
  forall (s :: ?a -> Boolean, x :: ?a): set_intersection(set_universal, s, x) <=> s(x)

theorem set_intersection_universal_right:
  forall (s :: ?a -> Boolean, x :: ?a): set_intersection(s, set_universal, x) <=> s(x)

theorem set_intersection_idempotent:
  forall (s :: ?a -> Boolean, x :: ?a): set_intersection(s, s, x) <=> s(x)
proof:
  ~split: s(x)

theorem set_difference_empty_right:
  forall (s :: ?a -> Boolean, x :: ?a): set_difference(s, set_empty, x) <=> s(x)

theorem set_difference_empty_left:
  forall (s :: ?a -> Boolean, x :: ?a): not set_difference(set_empty, s, x)

theorem set_difference_self:
  forall (s :: ?a -> Boolean, x :: ?a): not set_difference(s, s, x)
proof:
  ~split: s(x)

theorem set_complement_universal:
  forall (x :: ?a): not set_complement(set_universal, x)

theorem set_de_morgan_intersection:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_complement(set_intersection(s, t), x) <=> set_union(set_complement(s), set_complement(t), x)
proof:
  ~use: [de_morgan_and]

theorem set_union_absorption:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_union(s, set_intersection(s, t), x) <=> s(x)
proof:
  ~split: s(x)
  ~split: t(x)

theorem set_intersection_absorption:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_intersection(s, set_union(s, t), x) <=> s(x)
proof:
  ~split: s(x)
  ~split: t(x)

theorem set_symmetric_difference_commutative:
  forall (s :: ?a -> Boolean, t :: ?a -> Boolean, x :: ?a):
    set_symmetric_difference(s, t, x) <=> set_symmetric_difference(t, s, x)
proof:
  ~use: [xor_commutative]

theorem set_symmetric_difference_self:
  forall (s :: ?a -> Boolean, x :: ?a): not set_symmetric_difference(s, s, x)
proof:
  ~split: s(x)

theorem set_symmetric_difference_empty:
  forall (s :: ?a -> Boolean, x :: ?a): set_symmetric_difference(s, set_empty, x) <=> s(x)

theorem set_equal_at_reflexive:
  forall (s :: ?a -> Boolean, x :: ?a): set_equal_at(s, s, x)

theorem set_subset_transitive_at:
  forall (s :: ?a -> Boolean,
          t :: ?a -> Boolean,
          u :: ?a -> Boolean,
          x :: ?a):
    set_subset_at(s, t, x) ==> set_subset_at(t, u, x) ==> set_subset_at(s, u, x)
proof:
  ~split: s(x)
  ~split: t(x)
  ~split: u(x)

theorem set_disjoint_empty_at:
  forall (s :: ?a -> Boolean, x :: ?a): set_disjoint_at(s, set_empty, x)
