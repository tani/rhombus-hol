#lang rhombus/hol

import: "list.rhm" open

export:
  relation_identity
  relation_empty
  relation_universal
  relation_inverse
  relation_union
  relation_intersection
  relation_reflexive_closure
  relation_reflexive_at
  relation_symmetric_at
  relation_antisymmetric_at
  relation_transitive_at
  relation_total_at

  set_member
  set_empty
  set_universal
  set_singleton
  set_insert
  set_delete
  set_union
  set_intersection
  set_difference
  set_complement
  set_preimage
  set_subset_at
  set_disjoint_at


// Relations and sets are extensional predicates. Operations are represented
// pointwise so they remain executable without introducing a second set type.
function relation_identity(x :: ?a, y :: ?a) :: Boolean:
  x == y

function relation_empty(_x :: ?a, _y :: ?a) :: Boolean:
  #false

function relation_universal(_x :: ?a, _y :: ?a) :: Boolean:
  #true

function relation_inverse(r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a) :: Boolean:
  r(y)(x)

function relation_union(r :: Function(?a, Function(?a, Boolean)), s :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a) :: Boolean:
  r(x)(y) || s(x)(y)

function relation_intersection(r :: Function(?a, Function(?a, Boolean)), s :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a) :: Boolean:
  r(x)(y) && s(x)(y)

function relation_reflexive_closure(r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a) :: Boolean:
  x == y || r(x)(y)

function relation_reflexive_at(r :: Function(?a, Function(?a, Boolean)), x :: ?a) :: Boolean:
  r(x)(x)

function relation_symmetric_at(r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a) :: Boolean:
  !r(x)(y) || r(y)(x)

function relation_antisymmetric_at(r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a) :: Boolean:
  !(r(x)(y) && r(y)(x)) || x == y

function relation_transitive_at(r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a, z :: ?a) :: Boolean:
  !(r(x)(y) && r(y)(z)) || r(x)(z)

function relation_total_at(r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a) :: Boolean:
  r(x)(y) || r(y)(x)


function set_member(s :: Function(?a, Boolean), x :: ?a) :: Boolean:
  s(x)

function set_empty(_x :: ?a) :: Boolean:
  #false

function set_universal(_x :: ?a) :: Boolean:
  #true

function set_singleton(a :: ?a, x :: ?a) :: Boolean:
  x == a

function set_insert(a :: ?a, s :: Function(?a, Boolean), x :: ?a) :: Boolean:
  x == a || s(x)

function set_delete(a :: ?a, s :: Function(?a, Boolean), x :: ?a) :: Boolean:
  !(x == a) && s(x)

function set_union(s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a) :: Boolean:
  s(x) || t(x)

function set_intersection(s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a) :: Boolean:
  s(x) && t(x)

function set_difference(s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a) :: Boolean:
  s(x) && !t(x)

function set_complement(s :: Function(?a, Boolean), x :: ?a) :: Boolean:
  !s(x)

function set_preimage(f :: Function(?a, ?b), s :: Function(?b, Boolean), x :: ?a) :: Boolean:
  s(f(x))

function set_subset_at(s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a) :: Boolean:
  !s(x) || t(x)

function set_disjoint_at(s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a) :: Boolean:
  !(s(x) && t(x))

// Relation normal forms.
theorem ~rewrite_rule inverse_apply:
  forall (r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a):
    relation_inverse(r, x, y) <=> r(y)(x)

theorem inverse_inverse:
  forall (r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a):
    relation_inverse(relation_inverse(r), x, y) <=> r(x)(y)

theorem ~rewrite_rule relation_union_apply:
  forall (r :: Function(?a, Function(?a, Boolean)), s :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a):
    relation_union(r, s, x, y) <=> r(x)(y) or s(x)(y)

theorem ~rewrite_rule relation_intersection_apply:
  forall (r :: Function(?a, Function(?a, Boolean)), s :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a):
    relation_intersection(r, s, x, y) <=> r(x)(y) and s(x)(y)

theorem ~rewrite_rule reflexive_closure_refl:
  forall (r :: Function(?a, Function(?a, Boolean)), x :: ?a):
    relation_reflexive_closure(r, x, x)

theorem ~rewrite_rule reflexive_closure_step:
  forall (r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a):
    r(x)(y) ==> relation_reflexive_closure(r, x, y)

// Set membership normal forms.
theorem ~rewrite_rule member_empty:
  forall (x :: ?a): not set_member(set_empty, x)

theorem ~rewrite_rule member_universal:
  forall (x :: ?a): set_member(set_universal, x)

theorem ~rewrite_rule member_singleton:
  forall (a :: ?a, x :: ?a): set_member(set_singleton(a), x) <=> x === a

theorem ~rewrite_rule member_insert:
  forall (a :: ?a, s :: Function(?a, Boolean), x :: ?a):
    set_member(set_insert(a, s), x) <=> x === a or set_member(s, x)

theorem ~rewrite_rule member_delete:
  forall (a :: ?a, s :: Function(?a, Boolean), x :: ?a):
    set_member(set_delete(a, s), x) <=> not (x === a) and set_member(s, x)

theorem ~rewrite_rule member_union:
  forall (s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a):
    set_member(set_union(s, t), x) <=> set_member(s, x) or set_member(t, x)

theorem ~rewrite_rule member_intersection:
  forall (s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a):
    set_member(set_intersection(s, t), x) <=> set_member(s, x) and set_member(t, x)

theorem ~rewrite_rule member_difference:
  forall (s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a):
    set_member(set_difference(s, t), x) <=> set_member(s, x) and not set_member(t, x)

theorem ~rewrite_rule member_complement:
  forall (s :: Function(?a, Boolean), x :: ?a):
    set_member(set_complement(s), x) <=> not set_member(s, x)

theorem ~rewrite_rule member_preimage:
  forall (f :: Function(?a, ?b), s :: Function(?b, Boolean), x :: ?a):
    set_member(set_preimage(f, s), x) <=> set_member(s, f(x))

// Extensionality is manual, never an always-on rewrite.
theorem set_ext:
  forall (s :: Function(?a, Boolean), t :: Function(?a, Boolean)):
    (forall (x :: ?a): set_member(s, x) <=> set_member(t, x)) ==> s === t

theorem relation_ext:
  forall (r :: Function(?a, Function(?a, Boolean)), s :: Function(?a, Function(?a, Boolean))):
    (forall (x :: ?a, y :: ?a): r(x)(y) <=> s(x)(y)) ==> r === s

// Boolean-algebra laws are pointwise and deliberately not global rewrites.
theorem set_union_commutative:
  forall (s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a):
    set_union(s, t, x) <=> set_union(t, s, x)
proof:
  auto(~cases: [s(x), t(x)])

theorem set_union_associative:
  forall (r :: Function(?a, Boolean), s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a):
    set_union(set_union(r, s), t, x) <=> set_union(r, set_union(s, t), x)
proof:
  auto(~using: [or_associative])

theorem set_intersection_commutative:
  forall (s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a):
    set_intersection(s, t, x) <=> set_intersection(t, s, x)
proof:
  auto(~cases: [s(x), t(x)])

theorem set_intersection_associative:
  forall (r :: Function(?a, Boolean), s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a):
    set_intersection(set_intersection(r, s), t, x) <=> set_intersection(r, set_intersection(s, t), x)
proof:
  auto(~using: [and_associative])

theorem set_complement_involutive:
  forall (s :: Function(?a, Boolean), x :: ?a):
    set_complement(set_complement(s), x) <=> s(x)

theorem set_de_morgan_union:
  forall (s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a):
    set_complement(set_union(s, t), x) <=> set_intersection(set_complement(s), set_complement(t), x)
proof:
  auto(~using: [de_morgan_or])

theorem relation_identity_reflexive:
  forall (x :: ?a): relation_reflexive_at(relation_identity, x)

theorem relation_identity_symmetric:
  forall (x :: ?a, y :: ?a): relation_symmetric_at(relation_identity, x, y)
proof:
  auto(~cases: [x === y])

theorem relation_identity_antisymmetric:
  forall (x :: ?a, y :: ?a): relation_antisymmetric_at(relation_identity, x, y)
proof:
  auto(~cases: [x === y, y === x])

theorem relation_identity_transitive:
  forall (x :: ?a, y :: ?a, z :: ?a): relation_transitive_at(relation_identity, x, y, z)
proof:
  auto(~cases: [x === y, y === z])

theorem relation_empty_irreflexive:
  forall (x :: ?a): not relation_reflexive_at(relation_empty, x)

theorem relation_empty_symmetric:
  forall (x :: ?a, y :: ?a): relation_symmetric_at(relation_empty, x, y)

theorem relation_empty_antisymmetric:
  forall (x :: ?a, y :: ?a): relation_antisymmetric_at(relation_empty, x, y)

theorem relation_empty_transitive:
  forall (x :: ?a, y :: ?a, z :: ?a): relation_transitive_at(relation_empty, x, y, z)

theorem relation_universal_reflexive:
  forall (x :: ?a): relation_reflexive_at(relation_universal, x)

theorem relation_universal_symmetric:
  forall (x :: ?a, y :: ?a): relation_symmetric_at(relation_universal, x, y)

theorem relation_universal_transitive:
  forall (x :: ?a, y :: ?a, z :: ?a): relation_transitive_at(relation_universal, x, y, z)

theorem relation_universal_total:
  forall (x :: ?a, y :: ?a): relation_total_at(relation_universal, x, y)

theorem inverse_reflexive_at:
  forall (r :: Function(?a, Function(?a, Boolean)), x :: ?a):
    relation_reflexive_at(relation_inverse(r), x) <=> relation_reflexive_at(r, x)

theorem inverse_symmetric_at:
  forall (r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a):
    relation_symmetric_at(relation_inverse(r), x, y) <=> relation_symmetric_at(r, y, x)

theorem inverse_antisymmetric_at:
  forall (r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a):
    relation_antisymmetric_at(relation_inverse(r), x, y) <=> relation_antisymmetric_at(r, x, y)
proof:
  auto(~cases: [r(x)(y), r(y)(x), x === y])

theorem inverse_total_at:
  forall (r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a):
    relation_total_at(relation_inverse(r), x, y) <=> relation_total_at(r, x, y)
proof:
  auto(~cases: [r(x)(y), r(y)(x)])

theorem inverse_transitive_at:
  forall (r :: Function(?a, Function(?a, Boolean)), x :: ?a, y :: ?a, z :: ?a):
    relation_transitive_at(relation_inverse(r), z, y, x)
      <=> relation_transitive_at(r, x, y, z)
proof:
  auto(~cases: [r(x)(y), r(y)(z), r(x)(z)])

theorem set_subset_reflexive_at:
  forall (s :: Function(?a, Boolean), x :: ?a): set_subset_at(s, s, x)
proof:
  auto(~cases: [s(x)])

theorem set_empty_subset_at:
  forall (s :: Function(?a, Boolean), x :: ?a): set_subset_at(set_empty, s, x)

theorem set_subset_universal_at:
  forall (s :: Function(?a, Boolean), x :: ?a): set_subset_at(s, set_universal, x)

theorem set_disjoint_symmetric_at:
  forall (s :: Function(?a, Boolean), t :: Function(?a, Boolean), x :: ?a):
    set_disjoint_at(s, t, x) <=> set_disjoint_at(t, s, x)
proof:
  auto(~cases: [s(x), t(x)])
