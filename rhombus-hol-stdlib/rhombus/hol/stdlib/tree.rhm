#lang rhombus/hol

import:
  "data.rhm" open
  "nat.rhm" open
  "list.rhm" open
  "relation_set.rhm" open

export:
  NonemptyList
  singleton_nonempty
  prepend_nonempty
  nonempty_head
  nonempty_tail
  nonempty_to_list
  list_to_nonempty
  nonempty_map
  nonempty_append
  nonempty_fold_left
  BinaryTree
  leaf
  branch
  tree_map
  tree_size
  tree_height
  tree_mirror
  tree_flatten
  tree_member

  RoseTree
  rose_tip
  rose_branch
  rose_root
  rose_size


type NonemptyList(~a)
| singleton_nonempty(single_value :: ~a)
| prepend_nonempty(first_value :: ~a, nonempty_rest :: NonemptyList(~a))

function nonempty_head(xs :: NonemptyList(~a)) :: ~a:
  match xs
  | singleton_nonempty(x): x
  | prepend_nonempty(x, _): x


function nonempty_to_list(xs :: NonemptyList(~a)) :: List(~a):
  match xs
  | singleton_nonempty(x): cons(x, nil())
  | prepend_nonempty(x, rest): cons(x, nonempty_to_list(rest))

function nonempty_tail(xs :: NonemptyList(~a)) :: List(~a):
  match xs
  | singleton_nonempty(_): nil()
  | prepend_nonempty(_, rest): nonempty_to_list(rest)

function prepend_nonempty_option(x :: ~a, o :: Option(NonemptyList(~a))) :: Option(NonemptyList(~a)):
  match o
  | none(): none()
  | some(xs): some(prepend_nonempty(x, xs))

function list_to_nonempty(xs :: List(~a)) :: Option(NonemptyList(~a)):
  match xs
  | nil(): none()
  | cons(x, nil()): some(singleton_nonempty(x))
  | cons(x, cons(y, rest)):
      prepend_nonempty_option(x, list_to_nonempty(cons(y, rest)))

function nonempty_map(f :: Function(~a, ~b), xs :: NonemptyList(~a)) :: NonemptyList(~b):
  match xs
  | singleton_nonempty(x): singleton_nonempty(f(x))
  | prepend_nonempty(x, rest): prepend_nonempty(f(x), nonempty_map(f, rest))

function nonempty_append(xs :: NonemptyList(~a), ys :: NonemptyList(~a)) :: NonemptyList(~a):
  match xs
  | singleton_nonempty(x): prepend_nonempty(x, ys)
  | prepend_nonempty(x, rest): prepend_nonempty(x, nonempty_append(rest, ys))

function nonempty_fold_left(f :: Function(~a, Function(~a, ~a)), xs :: NonemptyList(~a)) :: ~a:
  match xs
  | singleton_nonempty(x): x
  | prepend_nonempty(x, rest): f(x)(nonempty_fold_left(f, rest))

type BinaryTree(~a)
| leaf(leaf_value :: ~a)
| branch(left_tree :: BinaryTree(~a), right_tree :: BinaryTree(~a))

// First-child/next-sibling encoding keeps recursion strictly positive under
// the datatype package's direct-recursion restriction.
type RoseTree(~a)
| rose_tip(root_value :: ~a)
| rose_branch(root_value :: ~a, first_child :: RoseTree(~a), next_sibling :: RoseTree(~a))

function rose_root(t :: RoseTree(~a)) :: ~a:
  match t
  | rose_tip(x): x
  | rose_branch(x, _, _): x

function rose_size(t :: RoseTree(~a)) :: Nat:
  match t
  | rose_tip(_): nat_one()
  | rose_branch(_, child, sibling):
      succ(nat_add(rose_size(child), rose_size(sibling)))

function tree_map(f :: Function(~a, ~b), t :: BinaryTree(~a)) :: BinaryTree(~b):
  match t
  | leaf(x): leaf(f(x))
  | branch(l, r): branch(tree_map(f, l), tree_map(f, r))

function tree_size(t :: BinaryTree(~a)) :: Nat:
  match t
  | leaf(_): nat_one()
  | branch(l, r): nat_add(tree_size(l), tree_size(r))

function tree_height(t :: BinaryTree(~a)) :: Nat:
  match t
  | leaf(_): nat_one()
  | branch(l, r): succ(nat_max(tree_height(l), tree_height(r)))

function tree_mirror(t :: BinaryTree(~a)) :: BinaryTree(~a):
  match t
  | leaf(x): leaf(x)
  | branch(l, r): branch(tree_mirror(r), tree_mirror(l))

function tree_flatten(t :: BinaryTree(~a)) :: List(~a):
  match t
  | leaf(x): cons(x, nil())
  | branch(l, r): list_append(tree_flatten(l), tree_flatten(r))

function tree_member(decide_equal :: Function(~a, Function(~a, Boolean)), x :: ~a, t :: BinaryTree(~a)) :: Boolean:
  match t
  | leaf(y): decide_equal(x)(y)
  | branch(l, r): tree_member(decide_equal, x, l) || tree_member(decide_equal, x, r)

theorem ~rewrite_rule nonempty_head_singleton:
  forall (x :: ~a): nonempty_head(singleton_nonempty(x)) === x

theorem ~rewrite_rule nonempty_head_prepend:
  forall (x :: ~a, xs :: NonemptyList(~a)): nonempty_head(prepend_nonempty(x, xs)) === x

theorem nonempty_to_list_nonempty:
  forall (xs :: NonemptyList(~a)): not (nil() === nonempty_to_list(xs))
proof:
  auto ~induct: xs

theorem ~rewrite_rule nonempty_map_identity:
  forall (xs :: NonemptyList(~a)): nonempty_map(identity, xs) === xs
proof:
  auto ~induct: xs

theorem nonempty_map_compose:
  forall (f :: Function(~a, ~b), g :: Function(~b, ~c), xs :: NonemptyList(~a)):
    nonempty_map(g, nonempty_map(f, xs)) === nonempty_map(compose(g, f), xs)
proof:
  auto ~induct: xs

theorem nonempty_append_associative:
  forall (xs :: NonemptyList(~a), ys :: NonemptyList(~a), zs :: NonemptyList(~a)):
    nonempty_append(nonempty_append(xs, ys), zs) === nonempty_append(xs, nonempty_append(ys, zs))
proof:
  auto ~induct: xs

theorem ~rewrite_rule tree_map_leaf:
  forall (f :: Function(~a, ~b), x :: ~a): tree_map(f, leaf(x)) === leaf(f(x))

theorem ~rewrite_rule tree_map_branch:
  forall (f :: Function(~a, ~b), l :: BinaryTree(~a), r :: BinaryTree(~a)):
    tree_map(f, branch(l, r)) === branch(tree_map(f, l), tree_map(f, r))

theorem tree_map_identity:
  forall (t :: BinaryTree(~a)): tree_map(identity, t) === t
proof:
  auto ~induct: t

theorem tree_map_compose:
  forall (f :: Function(~a, ~b), g :: Function(~b, ~c), t :: BinaryTree(~a)):
    tree_map(g, tree_map(f, t)) === tree_map(compose(g, f), t)
proof:
  auto ~induct: t

theorem ~rewrite_rule tree_size_map:
  forall (f :: Function(~a, ~b), t :: BinaryTree(~a)):
    tree_size(tree_map(f, t)) === tree_size(t)
proof:
  auto ~induct: t

theorem ~rewrite_rule tree_height_map:
  forall (f :: Function(~a, ~b), t :: BinaryTree(~a)):
    tree_height(tree_map(f, t)) === tree_height(t)
proof:
  auto ~induct: t

theorem ~rewrite_rule tree_mirror_involutive:
  forall (t :: BinaryTree(~a)): tree_mirror(tree_mirror(t)) === t
proof:
  auto ~induct: t

theorem ~rewrite_rule tree_length_flatten:
  forall (t :: BinaryTree(~a)): list_length(tree_flatten(t)) === tree_size(t)
proof:
  auto ~induct: t

theorem tree_flatten_map:
  forall (f :: Function(~a, ~b), t :: BinaryTree(~a)):
    tree_flatten(tree_map(f, t)) === list_map(f, tree_flatten(t))
proof:
  auto(~induct: t, ~using: [map_append])

// Nonempty lists and binary trees (10).
theorem nonempty_tail_singleton:
  forall (x :: ~a): nonempty_tail(singleton_nonempty(x)) === nil()

theorem nonempty_tail_prepend:
  forall (x :: ~a, xs :: NonemptyList(~a)):
    nonempty_tail(prepend_nonempty(x, xs)) === nonempty_to_list(xs)

theorem nonempty_to_list_singleton:
  forall (x :: ~a): nonempty_to_list(singleton_nonempty(x)) === cons(x, nil())

theorem nonempty_to_list_prepend:
  forall (x :: ~a, xs :: NonemptyList(~a)):
    nonempty_to_list(prepend_nonempty(x, xs)) === cons(x, nonempty_to_list(xs))

theorem list_to_nonempty_nil:
  option_is_none(list_to_nonempty(nil()))

theorem list_to_nonempty_singleton:
  forall (x :: ~a): list_to_nonempty(cons(x, nil())) === some(singleton_nonempty(x))

theorem tree_mirror_leaf:
  forall (x :: ~a): tree_mirror(leaf(x)) === leaf(x)

theorem tree_mirror_branch:
  forall (l :: BinaryTree(~a), r :: BinaryTree(~a)):
    tree_mirror(branch(l, r)) === branch(tree_mirror(r), tree_mirror(l))

theorem tree_flatten_leaf:
  forall (x :: ~a): tree_flatten(leaf(x)) === cons(x, nil())

theorem tree_flatten_branch:
  forall (l :: BinaryTree(~a), r :: BinaryTree(~a)):
    tree_flatten(branch(l, r)) === list_append(tree_flatten(l), tree_flatten(r))
