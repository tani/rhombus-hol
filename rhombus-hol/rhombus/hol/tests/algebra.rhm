#lang rhombus/static

// `unit` and `prod`, derived via `new_basic_type_definition` rather than
// postulated (`algebra.rhm`).  See PLAN.md section 9.2: this is "phase 1"
// scaffolding for replacing `datatype.rhm`'s `new_axiom` route with
// non-recursive type formers built once and reused by every datatype.
// `sum` is not implemented yet, so this covers `unit`/`prod` only.

import:
  rhombus/hol/private/htype open
  rhombus/hol/private/term open
  rhombus/hol/private/kernel open
  rhombus/hol/private/printer open
  rhombus/hol/private/bool open
  rhombus/hol/private/drule open
  rhombus/hol/private/algebra open

def thy = base_theory()

// -- unit --------------------------------------------------------------

def (thy1, unit_unique) = build_unit(thy)

check hyps_of(unit_unique) ~is []
check show(concl_of(unit_unique)) ~is "forall (x :: unit): x === one"

// Specialising at `one` itself gives a trivial reflexivity, not a
// tautological non-fact: the single point really is `one`.
check:
  show(concl_of(SPEC(thy1, mk_const(c_one, TyApp(ty_unit, [])), unit_unique)))
  ~is "one === one"

// -- prod ----------------------------------------------------------------

def (thy2, pt) = build_prod(thy1)

check hyps_of(pt.pair_eq) ~is []
check hyps_of(pt.surjective) ~is []
check hyps_of(pt.fst_pair) ~is []
check hyps_of(pt.snd_pair) ~is []

check:
  show(concl_of(pt.pair_eq))
  ~is "forall (x :: 'a, y :: 'b, z :: 'a, u :: 'b): "
        ++ "pair(x, y) === pair(z, u) <=> x === z and y === u"

check:
  show(concl_of(pt.surjective))
  ~is "forall (x :: prod('a, 'b)): exists (y :: 'a, z :: 'b): x === pair(y, z)"

check:
  show(concl_of(pt.fst_pair))
  ~is "forall (x :: 'a, y :: 'b): fst(pair(x, y)) === x"

check:
  show(concl_of(pt.snd_pair))
  ~is "forall (x :: 'a, y :: 'b): snd(pair(x, y)) === y"

// Instantiating `pair_eq` at two concrete, distinct types exercises the
// bijection's polymorphism, not just its schematic statement.
def tyN :: HType = TyVar(#'n)
def n1 = mk_var(#'n1, tyN)
def n2 = mk_var(#'n2, tyN)

check:
  let inst = INST_TYPE(thy2, {#'a: tyN, #'b: bool}, pt.pair_eq)
  show(concl_of(SPECL(thy2, [n1, tm_true, n2, tm_false], inst)))
  ~is "pair(n1, true) === pair(n2, false) <=> n1 === n2 and (true <=> false)"

check:
  let inst = INST_TYPE(thy2, {#'a: tyN, #'b: bool}, pt.fst_pair)
  show(concl_of(SPECL(thy2, [n1, tm_true], inst)))
  ~is "fst(pair(n1, true)) === n1"

check:
  let inst = INST_TYPE(thy2, {#'a: tyN, #'b: bool}, pt.snd_pair)
  show(concl_of(SPECL(thy2, [n1, tm_true], inst)))
  ~is "snd(pair(n1, true)) <=> true"

// -- sum -------------------------------------------------------------------

def (thy3, st) = build_sum(thy2)

check hyps_of(st.inl_inj) ~is []
check hyps_of(st.inr_inj) ~is []
check hyps_of(st.distinct) ~is []
check hyps_of(st.cases) ~is []

check:
  show(concl_of(st.inl_inj))
  ~is "forall (x :: 'a, y :: 'a): inl(x) === inl(y) <=> x === y"

check:
  show(concl_of(st.inr_inj))
  ~is "forall (x :: 'b, y :: 'b): inr(x) === inr(y) <=> x === y"

check:
  show(concl_of(st.distinct))
  ~is "forall (x :: 'a, y :: 'b): not (inl(x) === inr(y))"

check:
  show(concl_of(st.cases))
  ~is "forall (x :: sum('a, 'b)): (exists (y :: 'a): x === inl(y)) or exists (y :: 'b): x === inr(y)"

// Instantiating at two concrete, distinct types, and at the constructed
// value `INL(n1)` for `cases`, exercises the bijection beyond its schematic
// statement.
check:
  let inst = INST_TYPE(thy3, {#'a: tyN, #'b: bool}, st.inl_inj)
  show(concl_of(SPECL(thy3, [n1, n2], inst)))
  ~is "inl(n1) === inl(n2) <=> n1 === n2"

check:
  let inst = INST_TYPE(thy3, {#'a: tyN, #'b: bool}, st.distinct)
  show(concl_of(SPECL(thy3, [n1, tm_true], inst)))
  ~is "not (inl(n1) === inr(true))"

check:
  let inst_cases = INST_TYPE(thy3, {#'a: tyN, #'b: bool}, st.cases)
  let s0 = mk_comb(mk_const(c_inl, mk_fun(tyN, sum_ty(tyN, bool))), n1)
  show(concl_of(SPEC(thy3, s0, inst_cases)))
  ~is "(exists (x :: 'n): inl(n1) === inl(x)) or exists (x :: bool): inl(n1) === inr(x)"

// -- N-ary tupling -----------------------------------------------------
//
// Wiring item 4 in PLAN.md section 9.1.2/9.1.3: `WFREC` takes a single
// `A`, so a multi-argument function's parameters need tupling into one.

def tyP :: HType = TyApp(#'P, [])
def tyQ :: HType = TyApp(#'Q, [])
def tyR :: HType = TyApp(#'R, [])
def thy4 = new_type(new_type(new_type(thy3, #'P, 0), #'Q, 0), #'R, 0)
def p = mk_var(#'p, tyP)
def q = mk_var(#'q, tyQ)
def r = mk_var(#'r, tyR)
def tys3 = [tyP, tyQ, tyR]
def args3 = [p, q, r]

check type_to_string(tuple_ty(tys3)) ~is "prod(P, prod(Q, R))"
check show(mk_tuple(args3)) ~is "pair(p, pair(q, r))"

check:
  show(concl_of(prove_tuple_proj(thy4, pt, tys3, 0, args3)))
  ~is "fst(pair(p, pair(q, r))) === p"
check:
  show(concl_of(prove_tuple_proj(thy4, pt, tys3, 1, args3)))
  ~is "fst(snd(pair(p, pair(q, r)))) === q"
check:
  show(concl_of(prove_tuple_proj(thy4, pt, tys3, 2, args3)))
  ~is "snd(snd(pair(p, pair(q, r)))) === r"

// Every projection theorem carries zero hypotheses: these unfold known
// facts about the arguments handed in, nothing conditional.
check:
  for List (i in [0, 1, 2]): hyps_of(prove_tuple_proj(thy4, pt, tys3, i, args3)).length()
  ~is [0, 0, 0]
