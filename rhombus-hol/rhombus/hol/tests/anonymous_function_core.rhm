#lang rhombus/static

// Core anonymous/local function scenarios from the "First-Class Local
// Functions" design: anonymous functions as first-class values, returned
// as higher-order results, capturing enclosing lexical variables, local
// functions referencing earlier (but not later or mutually recursive)
// local functions, and arbitrarily deep non-recursive nesting. Each
// positive case proves outright; mutual recursion between two local
// functions is rejected by the same forward-reference rule as an
// ordinary forward reference.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
  "compiled"

fun stuck_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

// Anonymous function as a first-class value.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/anon_fn_as_value_ok.rhm")')
  ~is "compiled"

// Higher-order function returned from another function, then applied.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/higher_order_result_ok.rhm")')
  ~is "compiled"

// Lexical capture of an enclosing parameter.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/anon_capture_ok.rhm")')
  ~is "compiled"

// Earlier local function references resolve; arbitrary nesting elaborates.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/local_earlier_ref_ok.rhm")')
  ~is "compiled"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/local_arbitrary_nesting_ok.rhm")')
  ~is "compiled"

// Local mutual recursion is rejected (via the forward-reference rule).
check:
  stuck_message(
    ModulePath'lib("rhombus/hol/tests/fixtures/local_mutual_recursion_bad.rhm")')
    .contains("forward local-function reference is not supported")
  ~is #true
