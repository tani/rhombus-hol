#lang rhombus/hol

// Native arithmetic honors proof-local rule disabling exactly like ordinary
// equation rewriting.

datatype Nat
| zero()
| succ(pred :: Nat)

function nat_add(x :: Nat, y :: Nat) :: Nat
| (zero(), y): y
| (succ(x), y): succ(nat_add(x, y))

theorem disabled_native_addition:
  nat_add(2, 3) === (5 :: Nat)
proof:
  ~disable: [nat_add]
