#lang rhombus/hol

// No column descends -- `red()` is not a constructor subterm of `green()` --
// so the definition rests on its `~measure`.  The measure lands in `Colour`,
// which is not recursive and so has no subterm relation to decrease in.
// `function` refuses because `Colour` has no subterm relation to use.
export: Colour red green Nat zero succ f
datatype Colour
| red()
| green()
datatype Nat
| zero()
| succ(pred :: Nat)
function f(c :: Colour, n :: Nat) :: Nat:
  match c
  | red(): zero()
  | green(): f(red(), n)
proof:
  ~measure: c
