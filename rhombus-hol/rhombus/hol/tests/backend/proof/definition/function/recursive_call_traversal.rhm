#lang rhombus/static

// The termination checker finds a self-recursive call regardless of how
// deeply it is nested under surface sugar (local function, `block:`,
// `let`, `match` branch): it walks the already-elaborated kernel `Term`,
// a closed four-constructor ADT, not the surface `CoreExpr` tree, so no
// new surface construct can accidentally bypass it.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

fun bad_message() :: String:
  try:
    block:
      instantiate_hol_fixture(
        ModulePath'lib("rhombus/hol/tests/backend/proof/definition/function/fixtures/deep_recursive_call_bad.rhm")')
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

check bad_message().contains("a recursive call under a binder") ~is #true
