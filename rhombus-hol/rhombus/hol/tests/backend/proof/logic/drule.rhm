#lang rhombus/static

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel/names open
  rhombus/hol/kernel open
  rhombus/hol/backend/proof/logic/bool open
  rhombus/hol/backend/proof/logic/conversion open
  rhombus/hol/backend/proof/logic/derived open

def thy:
  let t = new_type(base_theory(), #'num, 0)
  let n = mk_tyapp(#'num, [])
  let t = new_constant(t, #'zero, n)
  let t = new_constant(t, #'s, mk_fun(n, n))
  let t = new_constant(t, #'P, mk_fun(n, bool))
  new_constant(t, #'Q, mk_fun(n, bool))

def num = mk_tyapp(#'num, [])
def zero = mk_const(#'zero, num)
def sc = mk_const(#'s, mk_fun(num, num))
def Pc = mk_const(#'P, mk_fun(num, bool))
def Qc = mk_const(#'Q, mk_fun(num, bool))
def p = mk_var(#'p, bool)
def q = mk_var(#'q, bool)
def r = mk_var(#'r, bool)
def x = mk_var(#'x, num)
def y = mk_var(#'y, num)

fun P(t): mk_comb(Pc, t)
fun Q(t): mk_comb(Qc, t)
fun s(t): mk_comb(sc, t)

// ==========================================================================
// truth
// ==========================================================================

check TRUTH(thy).concl ~is tm_true
check TRUTH(thy).hyps ~is []
check EQT_INTRO(thy, ASSUME(thy, p)).concl ~is mk_eq(p, tm_true)
check EQT_INTRO(thy, ASSUME(thy, p)).hyps ~is [p]
check:
  EQT_ELIM(thy, EQT_INTRO(thy, ASSUME(thy, p))).concl
  ~is p
check EQT_ELIM(thy, TRUTH(thy)) ~throws "not an equation"

// ==========================================================================
// conjunction
// ==========================================================================

check:
  CONJ(thy, ASSUME(thy, p), ASSUME(thy, q)).concl
  ~is mk_conj(p, q)
check CONJ(thy, ASSUME(thy, p), ASSUME(thy, q)).hyps ~is hyps.hyp_union([p], [q])
check:
  CONJUNCT1(thy, CONJ(thy, ASSUME(thy, p), ASSUME(thy, q))).concl
  ~is p
check:
  CONJUNCT2(thy, CONJ(thy, ASSUME(thy, p), ASSUME(thy, q))).concl
  ~is q
check:
  // elimination works on an assumed conjunction too, not just a built one
  CONJUNCT1(thy, ASSUME(thy, mk_conj(P(x), Q(y)))).concl
  ~is P(x)
check CONJUNCT1(thy, ASSUME(thy, p)) ~throws "not a conjunction"
check:
  let th = ASSUME(thy, mk_conj(p, mk_conj(q, r)))
  CONJUNCTS(thy, th).map(concl_of)
  ~is [p, q, r]
check:
  let ths = [ASSUME(thy, p), ASSUME(thy, q), ASSUME(thy, r)]
  LIST_CONJ(thy, ths).concl
  ~is mk_conj(mk_conj(p, q), r)
check LIST_CONJ(thy, []) ~throws "empty list"

// taking apart and rebuilding preserves the conjuncts in order
check:
  let th = ASSUME(thy, mk_conj(P(x), mk_conj(Q(x), P(y))))
  LIST_CONJ(thy, CONJUNCTS(thy, th)).concl
  ~is mk_conj(mk_conj(P(x), Q(x)), P(y))

// ==========================================================================
// implication
// ==========================================================================

check:
  DISCH(thy, p, ASSUME(thy, q)).concl
  ~is mk_imp(p, q)
// discharging removes the assumption
check DISCH(thy, p, ASSUME(thy, p)).hyps ~is []
check DISCH(thy, p, ASSUME(thy, q)).hyps ~is [q]
check:
  // `|- p ==> p`, with no hypotheses: the first real theorem
  DISCH(thy, p, ASSUME(thy, p)).concl
  ~is mk_imp(p, p)

check:
  let ith = DISCH(thy, p, ASSUME(thy, q))
  MP(thy, ith, ASSUME(thy, p)).concl
  ~is q
check MP(thy, ASSUME(thy, p), ASSUME(thy, p)) ~throws "not an implication"
check:
  MP(thy, DISCH(thy, p, ASSUME(thy, q)), ASSUME(thy, r))
  ~throws "antecedent does not match"
// hypotheses form a set; its storage order is not part of the claim
check:
  let hs = UNDISCH(thy, DISCH(thy, p, ASSUME(thy, q))).hyps
  [hs.length(), hs.contains(p), hs.contains(q)]
  ~is [2, #true, #true]
check:
  let th = DISCH(thy, p, DISCH(thy, q, ASSUME(thy, r)))
  UNDISCH_ALL(thy, th).concl
  ~is r
check:
  let a = DISCH(thy, p, ASSUME(thy, q))
  let b = DISCH(thy, q, ASSUME(thy, r))
  IMP_TRANS(thy, a, b).concl
  ~is mk_imp(p, r)
check:
  let th = ASSUME(thy, mk_conj(p, q))
  DISCH_ALL(thy, th).concl
  ~is mk_imp(mk_conj(p, q), mk_conj(p, q))

// ==========================================================================
// biconditional
// ==========================================================================

check:
  let a = DISCH(thy, p, ASSUME(thy, q))
  let b = DISCH(thy, q, ASSUME(thy, p))
  IMP_ANTISYM_RULE(thy, a, b).concl
  ~is mk_eq(p, q)
// the premises here still carry `q` and `p` as hypotheses, so the result does
check:
  let hs = IMP_ANTISYM_RULE(thy, DISCH(thy, p, ASSUME(thy, q)),
                            DISCH(thy, q, ASSUME(thy, p))).hyps
  [hs.length(), hs.contains(p), hs.contains(q)]
  ~is [2, #true, #true]
// with hypothesis-free premises the result is hypothesis-free
check:
  let refl_imp = DISCH(thy, p, ASSUME(thy, p))
  let th = IMP_ANTISYM_RULE(thy, refl_imp, refl_imp)
  [concl_of(th), hyps_of(th)]
  ~is [mk_eq(p, p), []]
check:
  let (f, g) = EQ_IMP_RULE(thy, ASSUME(thy, mk_eq(p, q)))
  [concl_of(f), concl_of(g)]
  ~is [mk_imp(p, q), mk_imp(q, p)]
// the two are inverse
check:
  let th = ASSUME(thy, mk_eq(p, q))
  let (f, g) = EQ_IMP_RULE(thy, th)
  IMP_ANTISYM_RULE(thy, f, g).concl
  ~is mk_eq(p, q)

// ==========================================================================
// universal quantification
// ==========================================================================

// The generalized variable must not be free in the hypotheses -- otherwise
// `forall x. P x` would follow from the single instance `P x`.
check:
  GEN(thy, x, ASSUME(thy, P(x)))
  ~throws "free in the hypotheses"
// an unrelated hypothesis is carried through untouched
check:
  let th = GEN(thy, x, ADD_ASSUM(thy, p, REFL(thy, x)))
  [concl_of(th), hyps_of(th)]
  ~is [mk_forall(x, mk_eq(x, x)), [p]]
check:
  let th = GEN(thy, x, REFL(thy, x))
  th.concl
  ~is mk_forall(x, mk_eq(x, x))
check:
  GENL(thy, [x, y], REFL(thy, x)).concl
  ~is mk_forall_list([x, y], mk_eq(x, x))

check:
  let th = GEN(thy, x, REFL(thy, x))
  SPEC(thy, zero, th).concl
  ~is mk_eq(zero, zero)
check:
  let th = GEN(thy, x, DISCH(thy, P(x), ASSUME(thy, P(x))))
  SPEC(thy, zero, th).concl
  ~is mk_imp(P(zero), P(zero))
check SPEC(thy, zero, ASSUME(thy, p)) ~throws "not universally quantified"
check:
  let th = GEN(thy, x, REFL(thy, x))
  SPEC(thy, p, th)
  ~throws "wrong type"
check:
  let th = GENL(thy, [x, y], REFL(thy, x))
  SPECL(thy, [zero, s(zero)], th).concl
  ~is mk_eq(zero, zero)
check:
  // `forall x y. x === y ==> y === x`, then stripped back down
  let body = DISCH(thy, mk_eq(x, y), SYM(thy, ASSUME(thy, mk_eq(x, y))))
  let th = GENL(thy, [x, y], body)
  SPEC_ALL(thy, th).concl
  ~is mk_imp(mk_eq(x, y), mk_eq(y, x))

// GEN then SPEC is the identity on the conclusion
check:
  SPEC(thy, x, GEN(thy, x, REFL(thy, x))).concl
  ~is mk_eq(x, x)

// GEN_ALL leaves variables that occur in the hypotheses alone
check:
  let th = ASSUME(thy, mk_conj(P(x), Q(y)))
  GEN_ALL(thy, CONJUNCT1(thy, th)).concl
  ~is P(x)
check:
  GEN_ALL(thy, REFL(thy, x)).concl
  ~is mk_forall(x, mk_eq(x, x))

// ==========================================================================
// disjunction
// ==========================================================================

check:
  DISJ1(thy, ASSUME(thy, p), q).concl
  ~is mk_disj(p, q)
check:
  DISJ2(thy, p, ASSUME(thy, q)).concl
  ~is mk_disj(p, q)
check DISJ1(thy, ASSUME(thy, p), q).hyps ~is [p]

check:
  let d = DISJ1(thy, ASSUME(thy, p), q)
  let a = DISCH(thy, p, ASSUME(thy, r)) |> UNDISCH(thy, _)
  let b = ADD_ASSUM(thy, q, ASSUME(thy, r))
  DISJ_CASES(thy, d, a, b).concl
  ~is r
check:
  // the two branches must prove the same thing
  let d = DISJ1(thy, ASSUME(thy, p), q)
  DISJ_CASES(thy, d, ASSUME(thy, r), ASSUME(thy, p))
  ~throws "different things"
check:
  DISJ_CASES(thy, ASSUME(thy, p), ASSUME(thy, r), ASSUME(thy, r))
  ~throws "not a disjunction"

// or-introduction followed by case analysis discharges cleanly
check:
  let d = ASSUME(thy, mk_disj(p, q))
  let a = ADD_ASSUM(thy, p, DISJ2(thy, q, ASSUME(thy, p)))
  let b = ADD_ASSUM(thy, q, DISJ1(thy, ASSUME(thy, q), p))
  DISJ_CASES(thy, d, a, b).concl
  ~is mk_disj(q, p)

// ==========================================================================
// negation and falsity
// ==========================================================================

check:
  NOT_ELIM(thy, ASSUME(thy, mk_neg(p))).concl
  ~is mk_imp(p, tm_false)
check NOT_ELIM(thy, ASSUME(thy, p)) ~throws "not a negation"
check:
  let th = DISCH(thy, p, ASSUME(thy, tm_false))
  NOT_INTRO(thy, th).concl
  ~is mk_neg(p)
check:
  NOT_INTRO(thy, DISCH(thy, p, ASSUME(thy, q)))
  ~throws "not `false`"
// the two are inverse
check:
  NOT_INTRO(thy, NOT_ELIM(thy, ASSUME(thy, mk_neg(p)))).concl
  ~is mk_neg(p)

check CONTR(thy, P(zero), ASSUME(thy, tm_false)).concl ~is P(zero)
check CONTR(thy, p, ASSUME(thy, q)) ~throws "not `false`"

check:
  EQF_INTRO(thy, ASSUME(thy, mk_neg(p))).concl
  ~is mk_eq(p, tm_false)
check:
  EQF_ELIM(thy, ASSUME(thy, mk_eq(p, tm_false))).concl
  ~is mk_neg(p)
check:
  EQF_ELIM(thy, EQF_INTRO(thy, ASSUME(thy, mk_neg(p)))).concl
  ~is mk_neg(p)
check EQF_ELIM(thy, ASSUME(thy, mk_eq(p, q))) ~throws "not `false`"

// classical reasoning: `not not p ==> p` needs BOOL_CASES
check:
  let nnp = ASSUME(thy, mk_neg(mk_neg(p)))
  let contra = MP(thy, NOT_ELIM(thy, nnp), ASSUME(thy, mk_neg(p)))
  CCONTR(thy, p, contra).concl
  ~is p
check:
  let nnp = ASSUME(thy, mk_neg(mk_neg(p)))
  let contra = MP(thy, NOT_ELIM(thy, nnp), ASSUME(thy, mk_neg(p)))
  DISCH_ALL(thy, CCONTR(thy, p, contra)).concl
  ~is mk_imp(mk_neg(mk_neg(p)), p)

// excluded middle
check:
  let na = ASSUME(thy, mk_neg(mk_disj(p, mk_neg(p))))
  let d1 = DISJ1(thy, ASSUME(thy, p), mk_neg(p))
  let f1 = MP(thy, NOT_ELIM(thy, na), d1)
  let np = NOT_INTRO(thy, DISCH(thy, p, f1))
  let d2 = DISJ2(thy, p, np)
  let f2 = MP(thy, NOT_ELIM(thy, na), d2)
  CCONTR(thy, mk_disj(p, mk_neg(p)), f2).concl
  ~is mk_disj(p, mk_neg(p))

// ==========================================================================
// hypothesis management
// ==========================================================================

check ADD_ASSUM(thy, q, ASSUME(thy, p)).hyps ~is hyps.hyp_union([p], [q])
check ADD_ASSUM(thy, q, ASSUME(thy, p)).concl ~is p
check:
  let a = ASSUME(thy, p)
  let b = ASSUME(thy, mk_conj(p, q)) |> CONJUNCT2(thy, _)
  PROVE_HYP(thy, a, b).concl
  ~is q
check:
  // PROVE_HYP is a no-op when the hypothesis is not there
  let a = ASSUME(thy, r)
  PROVE_HYP(thy, a, ASSUME(thy, p)).hyps
  ~is [p]

// ==========================================================================
// existential quantification
// ==========================================================================

check:
  let target = mk_exists(x, P(x))
  EXISTS(thy, target, zero, ASSUME(thy, P(zero))).concl == target
  ~is #true
check:
  let target = mk_exists(x, P(x))
  EXISTS(thy, target, zero, ASSUME(thy, P(zero))).hyps
  ~is [P(zero)]
check:
  EXISTS(thy, mk_exists(x, P(x)), zero, ASSUME(thy, Q(zero)))
  ~throws "does not match"
check EXISTS(thy, p, zero, ASSUME(thy, p)) ~throws "not existentially quantified"

check:
  // from `exists x. P x` and `P v |- exists x. P x`, conclude the same
  let target = mk_exists(x, P(x))
  let exth = ASSUME(thy, target)
  let v = mk_var(#'v, num)
  let inner = EXISTS(thy, target, v, ASSUME(thy, P(v)))
  CHOOSE(thy, v, exth, inner).concl == target
  ~is #true
check:
  // the chosen variable must not escape into the conclusion
  let exth = ASSUME(thy, mk_exists(x, P(x)))
  let v = mk_var(#'v, num)
  CHOOSE(thy, v, exth, ASSUME(thy, P(v)))
  ~throws "free in the conclusion"

// ==========================================================================
// eta
// ==========================================================================

check:
  let t = mk_abs(x, mk_comb(sc, x))
  (ETA_CONV(thy, t) :~ Thm).concl == mk_eq(t, sc)
  ~is #true
check ETA_CONV(thy, mk_abs(x, x)) ~is #false
check ETA_CONV(thy, s(zero)) ~is #false
// eta does not apply when the bound variable occurs in the operator
check:
  let f = mk_var(#'f, mk_fun(num, num))
  ETA_CONV(thy, mk_abs(x, mk_comb(mk_abs(y, x), x)))
  ~is #false
