#lang rhombus/static

// A binder's `:: T` annotation is optional (`optional_declared_type`
// defaults to a fresh metavariable). Verified here: a body constraint
// resolves it to the concrete type used, and no constraint leaves it a
// genuinely generalized schematic variable -- not defaulted to something
// arbitrary.

import:
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/frontend/driver open
  "fixtures/binder_type_inference_ok.rhm"!hol_theory as m

def st :~ HolState = m.theory

check:
  show(concl_of(st.thms[#'infer_binder_type_from_usage]))
  ~is "forall (x :: Nat): id_nat(x) === x"

check:
  show(concl_of(st.thms[#'generalize_unconstrained_binder])).contains("forall (x :: ?")
  ~is #true
