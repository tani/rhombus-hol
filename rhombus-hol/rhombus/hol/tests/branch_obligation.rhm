#lang rhombus/static

// The termination checker tracks each recursive call's decrease
// obligation under its own match-branch condition, not globally: a
// function with one branch that recurses on a nested-pattern-derived
// smaller argument and another branch with no recursive call at all is
// accepted and fully executes correctly.

import:
  "fixture_load.rhm" open

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/fixtures/branch_obligation_ok.rhm")')
  "compiled"
  ~is "compiled"
