#lang rhombus/static

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/bool open
  rhombus/hol/datatype open

def A = TyVar(#'a)
def base = base_theory()

// `type List(a) | nil() | cons(head :: a, tail :: List(a))`
def list_spec:
  DatatypeSpec(#'List, [#'a],
               [Ctor(#'nil, []),
                Ctor(#'cons, [Field(#'head, A),
                              Field(#'tail, TyApp(#'List, [A]))])])

def (list_thy, list_thms) = datatype_axioms(base, list_spec)
def lst = TyApp(#'List, [A])

// -- the signature the axioms live in --------------------------------------

check type_arity(list_thy, #'List) ~is 1
check const_type(list_thy, #'nil) ~is lst
check const_type(list_thy, #'cons) ~is mk_fun(A, mk_fun(lst, lst))
check const_type(list_thy, #'is_nil) ~is mk_fun(lst, bool)
check const_type(list_thy, #'is_cons) ~is mk_fun(lst, bool)
check const_type(list_thy, #'cons_head) ~is mk_fun(lst, A)
check const_type(list_thy, #'cons_tail) ~is mk_fun(lst, lst)

check ctor_type(list_spec, Ctor(#'nil, [])) ~is lst
check discriminator_name(Ctor(#'cons, [])) ~is #'is_cons
check selector_name(Ctor(#'cons, []), Field(#'head, A)) ~is #'cons_head
check nonrecursive_ctors(list_spec).map(fun (c :: Ctor): c.name) ~is [#'nil]
check:
  recursive_field_indexes(list_spec, list_spec.ctors[1])
  ~is [1]

// -- the axioms themselves -------------------------------------------------

check:
  show(list_thms.injectivity[#'cons].concl)
  ~is "forall (x :: 'a, y :: List('a), z :: 'a, u :: List('a)): "
        ++ "cons(x, y) === cons(z, u) <=> x === z and y === u"
// a constructor with no fields has nothing to be injective about
check list_thms.injectivity.get(#'nil, #false) ~is #false

check list_thms.distinctness.length() ~is 1
check:
  show(list_thms.distinctness[0].concl)
  ~is "forall (x :: 'a, y :: List('a)): not (nil === cons(x, y))"

check:
  show(list_thms.induction.concl)
  ~is "forall (x :: List('a) -> bool): "
        ++ "x(nil) and (forall (y :: 'a, z :: List('a)): x(z) ==> x(cons(y, z))) "
        ++ "==> forall (y :: List('a)): x(y)"

check:
  show(list_thms.cases.concl)
  ~is "forall (x :: List('a)): x === nil "
        ++ "or exists (y :: 'a, z :: List('a)): x === cons(y, z)"

// discriminators: one equation per (discriminator, constructor) pair
check list_thms.discriminators.length() ~is 4
check:
  list_thms.discriminators.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["is_nil(nil) <=> true",
       "forall (x :: 'a, y :: List('a)): is_nil(cons(x, y)) <=> false",
       "is_cons(nil) <=> false",
       "forall (x :: 'a, y :: List('a)): is_cons(cons(x, y)) <=> true"]

check:
  list_thms.selectors.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["forall (x :: 'a, y :: List('a)): cons_head(cons(x, y)) === x",
       "forall (x :: 'a, y :: List('a)): cons_tail(cons(x, y)) === y"]

check:
  list_thms.elim_rules.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["forall (x :: List('a)): is_nil(x) ==> nil === x",
       "forall (x :: List('a)): is_cons(x) ==> cons(cons_head(x), cons_tail(x)) === x"]

// Every emitted statement is hypothesis-free and well-formed in the theory it
// was created in -- the kernel checked that, but assert it explicitly since
// this module is a trust boundary.
check:
  let stmts = [list_thms.induction, list_thms.cases]
              ++ list_thms.distinctness ++ list_thms.discriminators
              ++ list_thms.selectors ++ list_thms.elim_rules
  for all (t in stmts): hyps_of(t) == []
  ~is #true
check:
  let stmts = [list_thms.induction, list_thms.cases]
              ++ list_thms.distinctness ++ list_thms.discriminators
              ++ list_thms.selectors ++ list_thms.elim_rules
  for all (t in stmts):
    block:
      check_term(list_thy, concl_of(t))
      #true
  ~is #true

// ==========================================================================
// A second datatype: a binary tree, to exercise multiple recursive fields
// ==========================================================================

def tree_spec:
  DatatypeSpec(#'Tree, [#'a],
               [Ctor(#'leaf, []),
                Ctor(#'node, [Field(#'value, A),
                              Field(#'left, TyApp(#'Tree, [A])),
                              Field(#'right, TyApp(#'Tree, [A]))])])

def (tree_thy, tree_thms) = datatype_axioms(list_thy, tree_spec)

// both recursive fields get an induction hypothesis
check:
  show(tree_thms.induction.concl)
  ~is "forall (x :: Tree('a) -> bool): "
        ++ "x(leaf) and (forall (y :: 'a, z :: Tree('a), u :: Tree('a)): "
        ++ "x(z) ==> x(u) ==> x(node(y, z, u))) "
        ++ "==> forall (y :: Tree('a)): x(y)"
check recursive_field_indexes(tree_spec, tree_spec.ctors[1]) ~is [1, 2]

// a datatype can be built on top of an earlier one
check:
  let both = DatatypeSpec(#'Pair, [#'a],
                          [Ctor(#'pr, [Field(#'fst, TyApp(#'List, [A])),
                                       Field(#'snd, TyApp(#'Tree, [A]))])])
  let (t, thms) = datatype_axioms(tree_thy, both)
  show(thms.cases.concl)
  ~is "forall (x :: Pair('a)): exists (y :: List('a), z :: Tree('a)): "
        ++ "x === pr(y, z)"

// three or more constructors: distinctness is quadratic
check:
  let s = DatatypeSpec(#'Colour, [],
                       [Ctor(#'red, []), Ctor(#'green, []), Ctor(#'blue, [])])
  let (t, thms) = datatype_axioms(base, s)
  [thms.distinctness.length(), thms.discriminators.length()]
  ~is [3, 9]
