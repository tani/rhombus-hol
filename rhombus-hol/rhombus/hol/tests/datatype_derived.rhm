#lang rhombus/static

// Differential test: `build_enum_thms`
// (`datatype_derived.rhm`) derives `DatatypeThms` for a nullary-only
// (enum) `DatatypeSpec` via `unit`/`sum` composition, with zero
// `new_axiom` calls.  `datatype_axioms` (`datatype.rhm`) derives the same
// shape axiomatically.  Every field of `DatatypeThms` -- injectivity,
// distinctness, induction, cases, discriminators, selectors, elim_rules --
// must agree between the two, *as printed statements*, and every theorem
// the derived side produces must carry zero hypotheses: proof that the
// axiom-free construction is not merely "close" but produces the identical
// theory a future `type`/`check_spec` could adopt outright for this
// nullary-only sub-case.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/bool open
  rhombus/hol/datatype open
  rhombus/hol/datatype_derived open
  rhombus/hol/algebra open

fun concls(ths :: List.of(Thm)) :~ List:
  ths.map(fun (t :: Thm): concl_of(t))

fun all_zero_hyps(thms :: DatatypeThms) :: Boolean:
  hyps_of(thms.induction).length() == 0
    && hyps_of(thms.cases).length() == 0
    && (for all (t in thms.distinctness): hyps_of(t).length() == 0)
    && (for all (t in thms.discriminators): hyps_of(t).length() == 0)
    && (for all (t in thms.selectors): hyps_of(t).length() == 0)
    && (for all (t in thms.elim_rules): hyps_of(t).length() == 0)
    && (for all (n in thms.injectivity.keys()): hyps_of(thms.injectivity[n]).length() == 0)

fun check_enum(n :: Int) :: Void:
  let tyname = Symbol.from_string("Enum" ++ to_string(n))
  let ctors = for List (i in List.iota(n)): Ctor(Symbol.from_string("K" ++ to_string(i)), [])
  let spec = DatatypeSpec(tyname, [], ctors)
  let (_, ax) = datatype_axioms(base_theory(), spec)
  let (_, dv) = build_enum_thms(algebra_base_theory(), spec)
  check all_zero_hyps(dv) ~is #true
  check concl_of(ax.induction) ~is concl_of(dv.induction)
  check concl_of(ax.cases) ~is concl_of(dv.cases)
  check concls(ax.distinctness) ~is concls(dv.distinctness)
  check concls(ax.discriminators) ~is concls(dv.discriminators)
  check concls(ax.elim_rules) ~is concls(dv.elim_rules)
  check ax.injectivity.length() ~is dv.injectivity.length()
  check ax.selectors.length() ~is dv.selectors.length()

// A single nullary constructor, two (the minimum needing `sum` at all),
// three (the "typical" small enum), and larger ones (four, five) to
// exercise the recursive encoding beyond one level of `sum` nesting.
check_enum(1)
check_enum(2)
check_enum(3)
check_enum(4)
check_enum(5)

// `is_nullary_spec` rejects specs with fields, and `build_enum_thms`
// refuses them outright rather than silently producing something wrong.
def field_spec = DatatypeSpec(#'Pair2, [], [Ctor(#'MkPair, [Field(#'fst, bool)])])
check is_nullary_spec(field_spec) ~is #false
fun rejects_field_spec() :: Boolean:
  try:
    build_enum_thms(algebra_base_theory(), field_spec)
    #false
    ~catch _: #true

check rejects_field_spec() ~is #true
