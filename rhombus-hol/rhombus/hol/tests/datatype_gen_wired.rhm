#lang rhombus/static

// PLAN.md section 9.2.1: `driver.rhm`'s `add_type` routes any non-recursive
// `DatatypeSpec` through `build_nonrecursive_datatype_thms`
// (`datatype_gen.rhm`) instead of `datatype_axioms` (`datatype.rhm`). This
// is the regression test for that wiring: `fixtures/nonrecursive_field_type_ok.rhm`
// declares a non-recursive, field-carrying `type`, a `function` that
// pattern-matches on it, and `theorem`s (including one that is exactly the
// derived `injectivity` statement) proved by `auto()` -- the fact that the
// fixture compiles at all is the proof that the derived `DatatypeThms` are
// usable by everything downstream (rule database, waterfall, `match`
// compilation) exactly like an axiomatic one.

import:
  "fixtures/nonrecursive_field_type_ok.rhm" as t

check t.swap(t.MkPair(#true, #false)) ~is t.MkPair(#false, #true)
check t.swap(t.swap(t.MkPair(#true, #false))) ~is t.MkPair(#true, #false)
check t.MkPair(#true, #false) is_a t.Pair ~is #true
check:
  match t.MkPair(#true, #false)
  | t.MkPair(a, b): a
  ~is #true
