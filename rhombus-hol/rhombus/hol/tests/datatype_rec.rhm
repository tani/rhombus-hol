#lang rhombus/static

// Carving an *arbitrary* self-recursive `DatatypeSpec`.
//
// `treerep.rhm` proved the facts about the representation on one hand-built
// example.  This is the step that stops it being an example: any spec in the
// class `check_spec` admits -- directly self-recursive, not nested, not
// mutual -- gets its label type, tag constants, junk subtree, `REP` predicate
// and type from the spec alone.
//
// The label carries only a constructor's *non-recursive* fields, tagged by
// which constructor it is, so it is exactly the sum-of-products
// `datatype_gen.rhm` already builds for non-recursive datatypes. The
// recursive fields become the node's children instead.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/bool open
  rhombus/hol/algebra open
  rhombus/hol/datatype open
  rhombus/hol/infinity open
  rhombus/hol/treerep open
  rhombus/hol/datatype_rec open

def base = algebra_base_theory()
def (thy0, ind) = build_ind(base)
def alg :~ AlgebraThms = algebra_base_thms()

fun tyvar_a() :: HType: mk_tyvar(#'a)

// one type parameter, one recursive field, one ordinary field
def list_spec:
  DatatypeSpec(#'MyList, [#'a],
               [Ctor(#'MyNil, []),
                Ctor(#'MyCons, [Field(#'hd, tyvar_a()),
                                Field(#'tl, mk_tyapp(#'MyList, [tyvar_a()]))])])
// *two* recursive fields in one constructor
def tree_spec:
  DatatypeSpec(#'MyTree, [#'a],
               [Ctor(#'MyLeaf, [Field(#'v, tyvar_a())]),
                Ctor(#'MyNode, [Field(#'l, mk_tyapp(#'MyTree, [tyvar_a()])),
                                Field(#'r, mk_tyapp(#'MyTree, [tyvar_a()]))])])
// three constructors, no type parameters, mixed arities
def exp_spec:
  DatatypeSpec(#'MyExp, [],
               [Ctor(#'Lit, [Field(#'n, mk_tyapp(#'num, []))]),
                Ctor(#'Neg, [Field(#'e, mk_tyapp(#'MyExp, []))]),
                Ctor(#'Add, [Field(#'l, mk_tyapp(#'MyExp, [])),
                             Field(#'r, mk_tyapp(#'MyExp, []))])])

fun carve(spec :: DatatypeSpec) :~ List:
  let (thy, rc) = carve_recursive_datatype(thy0, spec, alg)
  [thy, rc]

// -- the class this admits ---------------------------------------------------
check is_selfrecursive_spec(list_spec) ~is #true
check is_selfrecursive_spec(tree_spec) ~is #true
check:
  is_selfrecursive_spec(DatatypeSpec(#'Flat, [],
                                     [Ctor(#'A, []), Ctor(#'B, [])]))
  ~is #false

// a type every constructor of which recurses would be empty, and is refused
// rather than carved into something unusable
check:
  carve_recursive_datatype(thy0,
                           DatatypeSpec(#'Bad, [],
                                        [Ctor(#'W, [Field(#'x, mk_tyapp(#'Bad, []))])]),
                           alg)
  ~throws "every constructor recurses"

// -- and each spec really is carved ------------------------------------------
//
// The type arrives with the right arity, its two coercion theorems hold
// outright, and the only axiom in the theory is still infinity's -- one, not
// one per datatype.
check:
  for List (spec in [list_spec, tree_spec, exp_spec]):
    let [thy, rc] = carve(spec :~ DatatypeSpec)
    let rc :~ RecCarving = rc
    let cv :~ Carved = rc.carved
    [type_arity(thy :~ Theory, (spec :~ DatatypeSpec).name),
     hyps_of(cv.abs_rep).length(),
     hyps_of(cv.rep_pred).length(),
     axioms_of((thy :~ Theory)).length() - axioms_of(base).length()]
  ~is [[1, 0, 0, 1], [1, 0, 0, 1], [0, 0, 0, 1]]

// one tag constant per constructor, each with a defining equation
check:
  for List (spec in [list_spec, tree_spec, exp_spec]):
    let [_, rc] = carve(spec :~ DatatypeSpec)
    let rc :~ RecCarving = rc
    [rc.ctors.length(), rc.label_defs.length()]
  ~is [[2, 2], [2, 2], [3, 3]]

// the children counts come from the recursive fields, not the field count
check:
  let [_, rc] = carve(tree_spec)
  let rc :~ RecCarving = rc
  rc.ctors.map(fun (c :: CtorRep): c.arity)
  ~is [0, 2]
check:
  let [_, rc] = carve(exp_spec)
  let rc :~ RecCarving = rc
  rc.ctors.map(fun (c :: CtorRep): c.arity)
  ~is [0, 1, 2]

// -- the four theorems, for any spec -----------------------------------------
//
// Injectivity, distinctness, induction and cases -- the four a self-recursive
// `type` declaration currently postulates -- derived from the carved pieces,
// for each shape.  Still stated with the constructors spelled out as
// `abs(node(...))`; naming them is the next layer.
//
// The counts matter as much as the hypotheses: one injectivity per
// constructor, and one distinctness per unordered pair, so a three
// constructor type gets three of each.
fun four(spec :: DatatypeSpec) :~ List:
  let [thy, rc] = carve(spec)
  let t :~ RecTreeThms = derive_tree_theorems(thy :~ Theory, rc :~ RecCarving,
                                              alg, ind)
  let all = t.injectivity ++ t.distinctness ++ [t.induction, t.cases]
  [t.injectivity.length(), t.distinctness.length(),
   for values(m = 0) (x in all): math.max(m, hyps_of(x :~ Thm).length()),
   axioms_of(thy :~ Theory).length() - axioms_of(base).length()]

check four(list_spec) ~is [2, 1, 0, 1]
check four(tree_spec) ~is [2, 1, 0, 1]
check four(exp_spec) ~is [3, 3, 0, 1]

// a constructor with *two* recursive fields is the case that distinguishes a
// conjunctive premise from a curried one, and it is the one that broke first
check:
  let [thy, rc] = carve(tree_spec)
  let t :~ RecTreeThms = derive_tree_theorems(thy :~ Theory, rc :~ RecCarving,
                                              alg, ind)
  let (vs, body) = strip_forall(concl_of(t.injectivity[1]))
  // `!a x0 x1 a' x0' x1'. C(..) = C(..) ==> ...`
  [vs.length(), is_imp(body)]
  ~is [6, #true]

// -- and stated about the constructors, not the representation ---------------
//
// The last gap between "carved" and "usable": the theorems above mention
// `abs(node(label_i a, kids [rep x, ...]))`, and a declaration means
// `Cons(h, t)`.  The two are not a rename apart -- the representation binds
// one *packed* payload where the declaration binds the non-recursive fields
// one at a time -- so the bridge is the pack/unpack bijection.
fun named(spec :: DatatypeSpec) :~ List:
  let (thy1, rc) = carve_recursive_datatype(thy0, spec, alg)
  let tt :~ RecTreeThms = derive_tree_theorems(thy1, rc, alg, ind)
  let (thy, cs) = define_recursive_ctors(thy1, spec, rc)
  [thy, rc, cs, tt]

check:
  let [thy, rc, cs, tt] = named(list_spec)
  let th = restate_injectivity(thy :~ Theory, list_spec, alg, rc :~ RecCarving,
                               cs :~ RecCtors,
                               ((tt :~ RecTreeThms).injectivity[1] :~ Thm), 1)
  [show(concl_of(th)), hyps_of(th).length()]
  ~is ["forall (x :: 'a, y :: MyList('a), z :: 'a, u :: MyList('a)): MyCons(x, y) === MyCons(z, u) <=> x === z and y === u",
       0]

// two recursive fields, no non-recursive ones: the payload is `unit` and
// every field equation comes from the children
check:
  let [thy, rc, cs, tt] = named(tree_spec)
  let th = restate_injectivity(thy :~ Theory, tree_spec, alg, rc :~ RecCarving,
                               cs :~ RecCtors,
                               ((tt :~ RecTreeThms).injectivity[1] :~ Thm), 1)
  [show(concl_of(th)), hyps_of(th).length()]
  ~is ["forall (x :: MyTree('a), y :: MyTree('a), z :: MyTree('a), u :: MyTree('a)): MyNode(x, y) === MyNode(z, u) <=> x === z and y === u",
       0]

check:
  let [thy, rc, cs, tt] = named(list_spec)
  let th = restate_distinctness(thy :~ Theory, list_spec, rc :~ RecCarving,
                                cs :~ RecCtors,
                                ((tt :~ RecTreeThms).distinctness[0] :~ Thm),
                                0, 1)
  [show(concl_of(th)), hyps_of(th).length()]
  ~is ["forall (x :: 'a, y :: MyList('a)): not (MyNil === MyCons(x, y))", 0]

// -- the whole thing, against the axiom schema -------------------------------
//
// The claim this file exists to make precise: for a self-recursive spec, all
// four theorems come out *statement for statement* the same as
// `datatype_axioms` postulates them -- same theory, reached by proof.
//
// Getting there needed one correction worth keeping: the schema states a
// multi-child induction case *curried* (`P l ==> P r ==> P (Node l r)`), and
// the representation's own case conjoins them.  A list cannot tell those
// apart; a tree can.
fun derived_all(spec :: DatatypeSpec) :~ List:
  let (thy1, rc) = carve_recursive_datatype(thy0, spec, alg)
  let tt :~ RecTreeThms = derive_tree_theorems(thy1, rc, alg, ind)
  let (thy, cs) = define_recursive_ctors(thy1, spec, rc)
  let indn = restate_induction(thy, spec, alg, rc, cs, tt.induction)
  [thy, cs,
   for List (i in List.iota(spec.ctors.length())):
     (if (spec.ctors[i] :~ Ctor).fields.length() == 0
      | #false
      | restate_injectivity(thy, spec, alg, rc, cs, (tt.injectivity[i] :~ Thm), i)),
   restate_distinctness(thy, spec, rc, cs, (tt.distinctness[0] :~ Thm), 0, 1),
   indn,
   restate_cases(thy, spec, cs, indn)]

fun agrees(spec :: DatatypeSpec) :~ List:
  let [thy, cs, injs, dist, indn, cases] = derived_all(spec)
  let (athy, ax0) = datatype_axioms(base, spec)
  let ax :~ DatatypeThms = ax0
  let same = for values(ok = #true) (i in List.iota(spec.ctors.length())):
               let d = (injs :~ List)[i]
               cond
               | d is_a Thm:
                   ok && concl_of(d) == concl_of(ax.injectivity[(spec.ctors[i] :~ Ctor).name])
               | ~else: ok
  [concl_of(indn :~ Thm) == concl_of(ax.induction),
   concl_of(cases :~ Thm) == concl_of(ax.cases),
   concl_of(dist :~ Thm) == concl_of((ax.distinctness[0] :~ Thm)),
   same,
   axioms_of(thy :~ Theory).length() - axioms_of(base).length(),
   axioms_of(athy).length() - axioms_of(base).length()]

// derived agrees with postulated everywhere, at one axiom against twelve
check agrees(list_spec) ~is [#true, #true, #true, #true, 1, 12]
// and against fourteen, for the shape with two recursive fields
check agrees(tree_spec) ~is [#true, #true, #true, #true, 1, 14]

// the statements themselves, so a change to either side is visible here
check:
  let [_, _, _, _, indn, cases] = derived_all(list_spec)
  [show(concl_of(indn :~ Thm)), show(concl_of(cases :~ Thm))]
  ~is ["forall (x :: MyList('a) -> bool): x(MyNil) and (forall (y :: 'a, z :: MyList('a)): x(z) ==> x(MyCons(y, z))) ==> forall (y :: MyList('a)): x(y)",
       "forall (x :: MyList('a)): x === MyNil or exists (y :: 'a, z :: MyList('a)): x === MyCons(y, z)"]
check:
  let [_, _, _, _, indn, _] = derived_all(tree_spec)
  show(concl_of(indn :~ Thm))
  ~is "forall (x :: MyTree('a) -> bool): (forall (y :: 'a): x(MyLeaf(y))) and (forall (y :: MyTree('a), z :: MyTree('a)): x(y) ==> x(z) ==> x(MyNode(y, z))) ==> forall (y :: MyTree('a)): x(y)"

// -- the whole construction, end to end --------------------------------------
//
// A self-recursive spec in, a complete `DatatypeThms` out -- injectivity,
// distinctness, induction, cases, discriminators, selectors and
// destructor-elimination rules -- every one of them proved.
//
// The observers are not proved here: they come from `datatype_common.rhm`,
// the same code the non-recursive construction uses, because what a
// discriminator or a selector *means* does not depend on how the type was
// built, only on injectivity, distinctness and cases.
fun full(spec :: DatatypeSpec) :~ List:
  let (thy, d) = build_recursive_datatype_thms(thy0, spec, ind)
  let (athy, a) = datatype_axioms(base, spec)
  [thy, d :~ DatatypeThms, athy, a :~ DatatypeThms]

fun same_list(xs :: List, ys :: List) :: Boolean:
  xs.length() == ys.length()
    && (for values(ok = #true) (u in xs, v in ys):
          ok && concl_of(u :~ Thm) == concl_of(v :~ Thm))

// nothing conditional anywhere in the package
check:
  let [thy, d, athy, a] = full(list_spec)
  let d :~ DatatypeThms = d
  let all = d.distinctness ++ d.discriminators ++ d.selectors ++ d.elim_rules
              ++ [d.induction, d.cases]
  [for values(m = 0) (t in all): math.max(m, hyps_of(t :~ Thm).length()),
   d.discriminators.length(), d.selectors.length(), d.elim_rules.length()]
  ~is [0, 4, 2, 2]

// and every observer says exactly what the schema postulates
check:
  let [thy, d, athy, a] = full(list_spec)
  let d :~ DatatypeThms = d
  let a :~ DatatypeThms = a
  [same_list(d.discriminators, a.discriminators),
   same_list(d.selectors, a.selectors),
   same_list(d.elim_rules, a.elim_rules),
   axioms_of(thy :~ Theory).length() - axioms_of(base).length(),
   axioms_of(athy :~ Theory).length() - axioms_of(base).length()]
  ~is [#true, #true, #true, 1, 12]

check:
  let [thy, d, athy, a] = full(tree_spec)
  let d :~ DatatypeThms = d
  let a :~ DatatypeThms = a
  [same_list(d.discriminators, a.discriminators),
   same_list(d.selectors, a.selectors),
   same_list(d.elim_rules, a.elim_rules),
   d.selectors.length(),
   axioms_of(thy :~ Theory).length() - axioms_of(base).length(),
   axioms_of(athy :~ Theory).length() - axioms_of(base).length()]
  ~is [#true, #true, #true, 3, 1, 14]
