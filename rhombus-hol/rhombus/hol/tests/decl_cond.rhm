#lang rhombus/static

// `cond` in a function body is the reflected subset's first expansion beyond
// `if` and Boolean operators. One parser reads `cond` for both the logical
// statement (checked by
// the theorems `fixtures/cond_ok.rhm` proves while it compiles) and the
// executable code (checked here), so the two readings cannot drift.

import:
  "fixture_load.rhm" open
  "fixtures/cond_ok.rhm" as c

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

// -- the executable half ------------------------------------------------------

check c.pick3(#true, #false, c.zero(), c.two, c.succ(c.two)) ~is c.zero()
check c.pick3(#false, #true, c.zero(), c.two, c.succ(c.two)) ~is c.two
check c.pick3(#false, #false, c.zero(), c.two, c.succ(c.two)) ~is c.succ(c.two)

// A type-ascribed branch is erased to its own value at runtime -- the
// ascription is a pure type hint with no separate representation.
check c.typed_branch(#true) ~is c.two
check c.typed_branch(#false) ~is c.succ(c.zero())

// The ascription still has to agree with the `if`'s other branch: it
// pins `inner`'s own type, not an escape hatch from ordinary unification.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/typed_branch_mismatch_bad.rhm")')
  ~throws "expression has an unexpected type"

// A `Pair` expression inside an `if` branch renders and type-checks
// structurally -- both branches' element values, not just the branch
// as an opaque whole.
check c.pair_fst(c.pair_branch(#true)) ~is c.succ(c.zero())
check c.pair_snd(c.pair_branch(#true)) ~is c.succ(c.succ(c.zero()))
check c.pair_fst(c.pair_branch(#false)) ~is c.zero()
check c.pair_snd(c.pair_branch(#false)) ~is c.succ(c.zero())
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/pair_branch_mismatch_bad.rhm")')
  ~throws "expression has an unexpected type"

// A `[...]` list expression inside an `if` branch renders and type-checks
// structurally -- the element type has to reach `if`'s own unification,
// not bypass it as an opaque whole. `[]` (zero elements) exercises the
// destructure-from-expected path with no element to peek at.
check c.list_branch(#true) ~is c.cons(c.succ(c.zero()), c.cons(c.succ(c.succ(c.zero())), c.nil()))
check c.list_branch(#false) ~is c.nil()
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/list_expr_branch_mismatch_bad.rhm")')
  ~throws "expression has an unexpected type"

// A string literal inside an `if` branch renders and type-checks through
// `check_expr`'s own `CoreStringExpr` case -- confirmed indirectly, via
// `==` against a string literal outside the `if` (going through the
// legacy top-level dispatch), since the two readings have to agree.
check c.is_hi(c.string_branch(#true)) ~is #true
check c.is_empty_string(c.string_branch(#false)) ~is #true
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/string_expr_branch_mismatch_bad.rhm")')
  ~throws "expression has an unexpected type"

// -- the logical half ---------------------------------------------------------
//
// `cond_ok.rhm` proves `pick3_first`/`pick3_second`/`pick3_else` as it
// compiles, so importing it at all is the positive test.

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/cond_missing_else.rhm")')
  ~throws "a `cond` needs a final `~else` clause"
