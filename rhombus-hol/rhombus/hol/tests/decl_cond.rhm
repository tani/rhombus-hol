#lang rhombus/static

// `cond` in a function body is the reflected subset's first expansion beyond
// `if` and Boolean operators. One parser reads `cond` for both the logical
// statement (checked by
// the theorems `fixtures/cond_ok.rhm` proves while it compiles) and the
// executable code (checked here), so the two readings cannot drift.

import:
  "fixtures/cond_ok.rhm" as c

fun load(mp :: ModulePath):
  let e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }: Evaluator.instantiate(mp)

// -- the executable half ------------------------------------------------------

check c.pick3(#true, #false, c.zero(), c.two, c.succ(c.two)) ~is c.zero()
check c.pick3(#false, #true, c.zero(), c.two, c.succ(c.two)) ~is c.two
check c.pick3(#false, #false, c.zero(), c.two, c.succ(c.two)) ~is c.succ(c.two)

// -- the logical half ---------------------------------------------------------
//
// `cond_ok.rhm` proves `pick3_first`/`pick3_second`/`pick3_else` as it
// compiles, so importing it at all is the positive test.

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/cond_missing_else.rhm")')
  ~throws "a `cond` needs a final `~else` clause"
