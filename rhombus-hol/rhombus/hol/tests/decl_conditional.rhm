#lang rhombus/static

// `if` and the Boolean operators in a function body, at the surface.
//
// The point of the shared parser is that one piece of text has two readings
// that cannot drift: the logical one, checked by the theorems the fixture
// proves while it compiles, and the executable one, checked here.

import:
  "fixture_load.rhm" open
  "fixtures/conditional_ok.rhm" as c

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

// -- the executable half -----------------------------------------------------

check c.pick(#true, c.two, c.zero()) ~is c.two
check c.pick(#false, c.two, c.zero()) ~is c.zero()

check c.eqn(c.two, c.two) ~is #true
check c.eqn(c.two, c.zero()) ~is #false

// `!nul(m) && (nul(n) || eqn(m, n))`
check c.both(c.zero(), c.zero()) ~is #false
check c.both(c.two, c.zero()) ~is #true
check c.both(c.two, c.two) ~is #true
check c.both(c.two, c.succ(c.zero())) ~is #false

// -- the logical half --------------------------------------------------------
//
// `conditional_ok.rhm` proves `pick(true, m, n) === m` and its dual as it
// compiles, so importing it at all is the positive test.  The negative one
// needs its own module, since a failed proof is a failed compile.

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/conditional_stuck.rhm")')
  ~throws "pick_of_false_is_wrong: could not prove"
