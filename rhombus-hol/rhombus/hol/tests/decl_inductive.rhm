#lang rhombus/static

// The `inductive` declaration: a predicate given by rules, installed as the
// least predicate closed under them.
//
// What the declaration owes its user is three families of *theorems*, so the
// checks below are about the statements that reach the theorem database, not
// about the encoding they were derived from. `inductive.rhm` covers the
// derivations themselves.

import:
  "fixture_load.rhm" open
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/frontend/driver open
  "fixtures/inductive_mutual_ok.rhm"!hol_theory as mutual
  "fixtures/inductive_ok.rhm"!hol_theory as m

def st :~ HolState = m.theory

def tree = mk_tyapp(#'Tree, [])
def leaf = mk_const(#'leaf, tree)
def node = mk_const(#'node, mk_fun(tree, mk_fun(tree, tree)))
def spine = mk_const(#'spine, mk_fun(tree, bool))
fun spine_at(t :: Term) :: Term: mk_comb(spine, t)
fun node_of(l :: Term, r :: Term) :: Term: list_mk_comb(node, [l, r])

def r = mk_var(#'r, tree)
def t0 = mk_var(#'t, tree)

// -- one theorem per rule ----------------------------------------------------

check concl_of(st.thms[#'spine_leaf]) ~is spine_at(leaf)
check:
  concl_of(st.thms[#'spine_node])
  ~is mk_forall(r, mk_imp(spine_at(r), spine_at(node_of(leaf, r))))

// -- induction: the predicate is the *least* one closed under the rules ------

def pv = mk_var(#'spine, mk_fun(tree, bool))
check:
  concl_of(st.thms[#'spine_induct])
  ~is mk_forall(
        pv,
        mk_imp(mk_comb(pv, leaf),
               mk_imp(mk_forall(r, mk_imp(mk_comb(pv, r),
                                          mk_comb(pv, node_of(leaf, r)))),
                      mk_forall(t0, mk_imp(spine_at(t0),
                                           mk_comb(pv, t0))))))

// -- cases: membership came from one of the rules ----------------------------

def x0 = mk_var(#'x0, tree)
check:
  concl_of(st.thms[#'spine_cases])
  ~is mk_forall(
        x0,
        mk_imp(spine_at(x0),
               mk_disj(mk_eq(x0, leaf),
                       mk_exists(r, mk_conj(spine_at(r),
                                            mk_eq(x0, node_of(leaf, r)))))))

// -- derived, not postulated -------------------------------------------------
//
// The declaration is one basic definition; every theorem above was derived
// from it, so none may carry a hypothesis and none may have added an axiom.

check:
  for any (name in [#'spine_leaf, #'spine_node, #'spine_induct, #'spine_cases]):
    hyps_of(st.thms[name :~ Symbol]).length() != 0
  ~is #false
check:
  axioms_of(st.ctx.thy).length()
  ~is axioms_of(initial_state().ctx.thy).length()

// -- and they are usable in a proof ------------------------------------------
//
// The fixture's `spine_one` is proved by the waterfall from the introduction
// theorems alone, so instantiating the fixture exercises the whole path.

check st.thms.has_key(#'spine_one) ~is #true

// -- predicates declared together are one least family -----------------------
//
// The rules are shared, so each predicate's induction principle quantifies
// over a predicate for *both* positions, and each inversion theorem covers
// exactly the rules that conclude with that predicate.

def mst :~ HolState = mutual.theory

def even_depth = mk_const(#'even_depth, mk_fun(tree, bool))
def odd_depth = mk_const(#'odd_depth, mk_fun(tree, bool))
def ev = mk_var(#'even_depth, mk_fun(tree, bool))
def od = mk_var(#'odd_depth, mk_fun(tree, bool))
def t1 = mk_var(#'t, tree)

fun doubled(t :: Term) :: Term: node_of(t, t)

check concl_of(mst.thms[#'even_leaf]) ~is mk_comb(even_depth, leaf)
check:
  concl_of(mst.thms[#'odd_step])
  ~is mk_forall(t1, mk_imp(mk_comb(even_depth, t1),
                           mk_comb(odd_depth, doubled(t1))))

// Both quantified predicates are in scope in each induction principle, and
// every rule is a premise of both.
fun closure(first :: Term, second :: Term, conclusion :: Term) :: Term:
  mk_forall(
    ev,
    mk_forall(
      od,
      mk_imp(mk_comb(ev, leaf),
             mk_imp(mk_forall(t1, mk_imp(mk_comb(od, t1),
                                         mk_comb(ev, doubled(t1)))),
                    mk_imp(mk_forall(t1, mk_imp(mk_comb(ev, t1),
                                                mk_comb(od, doubled(t1)))),
                           conclusion)))))

check:
  concl_of(mst.thms[#'even_depth_induct])
  ~is closure(ev, od,
              mk_forall(x0, mk_imp(mk_comb(even_depth, x0),
                                   mk_comb(ev, x0))))
check:
  concl_of(mst.thms[#'odd_depth_induct])
  ~is closure(ev, od,
              mk_forall(x0, mk_imp(mk_comb(odd_depth, x0),
                                   mk_comb(od, x0))))

// `odd_depth` has one rule, so its inversion theorem has one disjunct, and it
// mentions the *other* predicate: the two were inverted as one family.
check:
  concl_of(mst.thms[#'odd_depth_cases])
  ~is mk_forall(
        x0,
        mk_imp(mk_comb(odd_depth, x0),
               mk_exists(t1, mk_conj(mk_comb(even_depth, t1),
                                     mk_eq(x0, doubled(t1))))))
check:
  concl_of(mst.thms[#'even_depth_cases])
  ~is mk_forall(
        x0,
        mk_imp(mk_comb(even_depth, x0),
               mk_disj(mk_eq(x0, leaf),
                       mk_exists(t1, mk_conj(mk_comb(odd_depth, t1),
                                             mk_eq(x0, doubled(t1)))))))

check:
  for any (name in [#'even_leaf, #'even_step, #'odd_step,
                    #'even_depth_induct, #'odd_depth_induct,
                    #'even_depth_cases, #'odd_depth_cases]):
    hyps_of(mst.thms[name :~ Symbol]).length() != 0
  ~is #false
check:
  axioms_of(mst.ctx.thy).length()
  ~is axioms_of(initial_state().ctx.thy).length()

// A rule concluding with one predicate from a premise about the other is
// usable in a proof, which is what mutual closure means.
check mst.thms.has_key(#'odd_one) ~is #true

// -- rules that describe no least fixed point are refused --------------------

fun bad_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

def negative_message:
  bad_message(
    ModulePath'lib("rhombus/hol/tests/fixtures/inductive_negative_bad.rhm")')
def unapplied_message:
  bad_message(
    ModulePath'lib("rhombus/hol/tests/fixtures/inductive_unapplied_bad.rhm")')
def conclusion_message:
  bad_message(
    ModulePath'lib("rhombus/hol/tests/fixtures/inductive_conclusion_bad.rhm")')

check negative_message.contains("negative position") ~is #true
check unapplied_message.contains("applied to arguments") ~is #true
check conclusion_message.contains("must conclude with") ~is #true
