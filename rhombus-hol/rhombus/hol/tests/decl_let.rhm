#lang rhombus/static

// Local `let` bindings in a function body, at the surface -- the reflected
// subset's second expansion beyond `if`/Boolean operators/`cond` (PLAN.md
// section 10, review item 8). One parser reads `let` for both the logical
// statement (checked by the theorems `fixtures/let_ok.rhm` proves while it
// compiles) and the executable code (checked here).

import:
  "fixtures/let_ok.rhm" as l

fun load(mp :: ModulePath):
  let e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }: Evaluator.instantiate(mp)

// -- the executable half ------------------------------------------------------

check l.bump(l.zero()) ~is l.succ(l.zero())
check l.bump(l.succ(l.zero())) ~is l.two
check l.bump(l.succ(l.succ(l.zero()))) ~is l.two

// -- the logical half ---------------------------------------------------------
//
// `let_ok.rhm` proves `bump_zero`/`bump_succ` as it compiles, so importing
// it at all is the positive test. A multi-statement body not starting with
// `let` falls through to the same generic "not admitted" error a body
// outside the reflected subset always gets, in its own module.

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/let_missing.rhm")')
  ~throws "this version admits only variables, named applications"
