#lang rhombus/static

// `theorem`, the optional `proof:` clause, attributes, and the residue
// a failed proof reports.

import:
  "fixture_load.rhm" open
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/bool open
  rhombus/hol/elab open
  rhombus/hol/surface_core open
  "fixtures/theorem_ok.rhm" as t

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

fun bad(which :: Symbol):
  match which
  | #'stuck: load(ModulePath'lib("rhombus/hol/tests/fixtures/theorem_stuck.rhm")')
  | #'orphan:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/theorem_orphan_proof.rhm")')
  | #'do_not_stuck:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/theorem_do_not_stuck.rhm")')
  | #'do_not_bad_name:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/theorem_do_not_bad_name.rhm")')
  | #'in_theory_stuck:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/theorem_in_theory_stuck.rhm")')
fun bad_message(which :: Symbol) :: String:
  try:
    block:
      bad(which)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

// -- the module compiled, so every theorem in it was proved ------------------
//
// `theorem_ok.rhm` asserts `expect [...]` at phase 1, which pins both that all
// six declarations were made and the order they were made in.  In particular
// two adjacent `theorem`s did not swallow one another.

check t.app(t.Cons(1, t.Nil()), t.Nil()) ~is t.Cons(1, t.Nil())

// ==========================================================================
// the proposition parser
// ==========================================================================

def thy:
  let x = new_type(base_theory(), #'Nat, 0)
  let n = mk_tyapp(#'Nat, [])
  let x = new_constant(x, #'zero, n)
  let x = new_constant(x, #'succ, mk_fun(n, n))
  let x = new_constant(x, #'p, mk_fun(n, bool))
  new_constant(x, #'q, mk_fun(n, bool))

// Core elaboration and structural printing stay inverse at every precedence
// boundary. Surface grouping itself is golden-tested by `surface_props.rhm`.
def at = 'core_expression'
fun cref(n :: Symbol): CoreRef(n, at)
fun ccall(n :: Symbol, args :: List.of(CoreExpr)):
  CoreCall(cref(n), args, at)
fun rt(e :: CoreExpr) :~ String: show(parse_prop(thy, [], {}, e))

def zero_c = cref(#'zero)
def pz = ccall(#'p, [zero_c])
def qz = ccall(#'q, [zero_c])
fun binary(n :: Symbol, left :: CoreExpr, right :: CoreExpr):
  ccall(n, [left, right])
fun binder(n :: Symbol): CoreBinder(n, 'Nat', at)

check rt(binary(#'conj, pz, qz)) ~is "p(zero) and q(zero)"
check:
  rt(binary(#'disj, binary(#'conj, pz, qz), pz))
  ~is "p(zero) and q(zero) or p(zero)"
check:
  rt(binary(#'disj, pz, binary(#'conj, qz, pz)))
  ~is "p(zero) or q(zero) and p(zero)"
check:
  rt(binary(#'conj, ccall(#'neg, [pz]), qz))
  ~is "not p(zero) and q(zero)"
check:
  rt(ccall(#'neg, [binary(#'conj, pz, qz)]))
  ~is "not (p(zero) and q(zero))"
check:
  rt(binary(#'eq, zero_c, ccall(#'succ, [zero_c])))
  ~is "zero === succ(zero)"
check:
  rt(binary(#'conj,
            binary(#'eq, zero_c, ccall(#'succ, [zero_c])),
            pz))
  ~is "zero === succ(zero) and p(zero)"
check:
  rt(binary(#'imp, pz, binary(#'imp, qz, pz)))
  ~is "p(zero) ==> q(zero) ==> p(zero)"
check:
  rt(binary(#'imp, binary(#'imp, pz, qz), pz))
  ~is "(p(zero) ==> q(zero)) ==> p(zero)"
check:
  rt(binary(#'imp, binary(#'conj, pz, qz), pz))
  ~is "p(zero) and q(zero) ==> p(zero)"
check:
  rt(binary(#'eq, pz, binary(#'imp, qz, pz)))
  ~is "p(zero) <=> q(zero) ==> p(zero)"

def nref = cref(#'n)
def mref = cref(#'m)
check:
  rt(CoreForall([binder(#'n)], ccall(#'p, [nref]), at))
  ~is "forall (x :: Nat): p(x)"
check:
  rt(CoreForall([binder(#'n), binder(#'m)],
                binary(#'imp, ccall(#'p, [nref]), ccall(#'q, [mref])),
                at))
  ~is "forall (x :: Nat, y :: Nat): p(x) ==> q(y)"
check:
  rt(CoreExists([binder(#'n)],
                binary(#'conj, ccall(#'p, [nref]), ccall(#'q, [nref])),
                at))
  ~is "exists (x :: Nat): p(x) and q(x)"

check:
  let statement = CoreForall([binder(#'xs), binder(#'ys)],
                             binary(#'eq, cref(#'xs), cref(#'ys)),
                             at)
  let (_, names) = parse_theorem_statement(thy, statement)
  names
  ~is [#'xs, #'ys]

// ==========================================================================
// the tactic parser
// ==========================================================================

check parse_tactic(#false) ~is [#false, [], [], [], [], [], #false]
check parse_tactic('auto') ~is [#false, [], [], [], [], [], #false]
check parse_tactic('auto ~induct: xs') ~is [#'xs, [], [], [], [], [], #false]
check:
  parse_tactic('auto(~induct: xs, ~using: [a, b])')
  ~is [#'xs, [#'a, #'b], [], [], [], [], #false]
check parse_tactic('auto(~using: [a])') ~is [#false, [#'a], [], [], [], [], #false]
check:
  parse_tactic('auto(~do_not: [fertilize, generalize])')
  ~is [#false, [], [#'fertilize, #'generalize], [], [], [], #false]
check:
  parse_tactic('auto(~in_theory: [foo, bar])')
  ~is [#false, [], [], [#'foo, #'bar], [], [], #false]
check:
  let [_, _, _, _, cs, _, _] = parse_tactic('auto(~cases: [p(x), q(y, z)])')
  (cs :~ List).length()
  ~is 2
check:
  let [_, _, _, _, _, ws, _] = parse_tactic('auto(~witnesses: [x, f(y)])')
  (ws :~ List).length()
  ~is 2
// A proof may raise its own ceiling; `#false` above is "take the default".
check:
  parse_tactic('auto(~search_steps: 500000)')
  ~is [#false, [], [], [], [], [], 500000]
check parse_tactic('nonsense') ~throws "this version understands"

// ==========================================================================
// a failed proof is a compile error with the residue and a location
// ==========================================================================

def stuck_message = bad_message(#'stuck)
def orphan_message = bad_message(#'orphan)
def do_not_stuck_message = bad_message(#'do_not_stuck)
def do_not_bad_name_message = bad_message(#'do_not_bad_name)
def in_theory_stuck_message = bad_message(#'in_theory_stuck)

check stuck_message.contains("could not prove") ~is #true
check stuck_message.contains("theorem_stuck.rhm:21") ~is #true
// The trail says how the prover got where it stopped -- the specific
// heuristic path (which stages fire, which variable induction picks) is not
// the thing under test and shifts as the waterfall gains stages; only that
// the trail names real tactics is.
check stuck_message.contains("induction on") ~is #true
check stuck_message.contains("simplification") ~is #true

check orphan_message.contains("no `theorem` before it") ~is #true

// -- `~do_not:` skips named waterfall stages for one proof -------------------

// turning off the one stage a proof genuinely needs leaves it stuck, same as
// any other under-powered proof -- `~do_not:` cannot make a proof succeed
// that would not otherwise, only decline to try something that would have
check do_not_stuck_message.contains("could not prove") ~is #true

// an unrecognised stage name is rejected up front, not silently ignored
check do_not_bad_name_message.contains("no such waterfall stage to skip") ~is #true

// -- `~in_theory:` disables named rules for one proof -----------------------

// disabling the one rule a proof genuinely needs leaves it stuck, same as
// `~do_not:` -- `~in_theory:` cannot make a proof succeed that would not
// otherwise, only decline to use a rule that would have
check in_theory_stuck_message.contains("could not prove") ~is #true

// the disable does not leak into a later theorem in the same module that
// needs the same rule and gives no hint of its own
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/theorem_in_theory_scoped.rhm")')
  ~completes
