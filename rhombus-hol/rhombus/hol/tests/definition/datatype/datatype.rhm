#lang rhombus/static

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel/names open
  rhombus/hol/kernel open
  rhombus/hol/backend/proof/logic/bool open
  rhombus/hol/backend/proof/definition/datatype/define open
  lib("rhombus/hol/tests/definition/datatype/datatype_axiom_support.rhm") open

def A = mk_tyvar(#'a)
def base = base_theory()

// `datatype List.of(a) | nil() | cons(head :: a, tail :: List.of(a))`
def list_spec:
  DatatypeSpec(#'List, [#'a],
               [Ctor(#'nil, []),
                Ctor(#'cons, [Field(#'head, A),
                              Field(#'tail, mk_tyapp(#'List, [A]))])])

def (list_thy, list_thms) = datatype_axioms(base, list_spec)
def lst = mk_tyapp(#'List, [A])
def nil_tm = mk_const(#'nil, lst)
fun cons_tm(head :: Term, tail :: Term) :: Term:
  list_mk_comb(mk_const(#'cons, mk_fun(A, mk_fun(lst, lst))), [head, tail])
fun discriminator_tm(name :: Symbol, value :: Term) :: Term:
  mk_comb(mk_const(name, mk_fun(lst, bool)), value)
fun selector_tm(name :: Symbol, result_ty :: HType, value :: Term) :: Term:
  mk_comb(mk_const(name, mk_fun(lst, result_ty)), value)


// -- the signature the axioms live in --------------------------------------

check type_arity(list_thy, #'List) ~is 1
check const_type(list_thy, #'nil) ~is lst
check const_type(list_thy, #'cons) ~is mk_fun(A, mk_fun(lst, lst))
check const_type(list_thy, #'is_nil) ~is mk_fun(lst, bool)
check const_type(list_thy, #'is_cons) ~is mk_fun(lst, bool)
check const_type(list_thy, #'cons_head) ~is mk_fun(lst, A)
check const_type(list_thy, #'cons_tail) ~is mk_fun(lst, lst)

check ctor_type(list_spec, Ctor(#'nil, [])) ~is lst
check ctor_index(list_spec, #'nil) ~is 0
check ctor_index(list_spec, #'cons) ~is 1
check ctor_index(list_spec, #'missing) ~throws "unknown constructor"
check discriminator_name(Ctor(#'cons, [])) ~is #'is_cons
check selector_name(Ctor(#'cons, []), Field(#'head, A)) ~is #'cons_head
check:
  recursive_field_indexes(list_spec, list_spec.ctors[1])
  ~is [1]

// -- the axioms themselves -------------------------------------------------

check:
  let x = mk_var(#'x, A)
  let y = mk_var(#'y, lst)
  let z = mk_var(#'z, A)
  let u = mk_var(#'u, lst)
  let lhs = mk_eq(cons_tm(x, y), cons_tm(z, u))
  let rhs = mk_conj(mk_eq(x, z), mk_eq(y, u))
  list_thms.injectivity[#'cons].concl
    == mk_forall_list([x, y, z, u], mk_eq(lhs, rhs))
  ~is #true
// a constructor with no fields has nothing to be injective about
check list_thms.injectivity.get(#'nil, #false) ~is #false

check list_thms.distinctness.length() ~is 1
check:
  let x = mk_var(#'x, A)
  let y = mk_var(#'y, lst)
  list_thms.distinctness[[0, 1]].concl
    == mk_forall_list([x, y], mk_neg(mk_eq(nil_tm, cons_tm(x, y))))
  ~is #true

check:
  let p = mk_var(#'p, mk_fun(lst, bool))
  let x = mk_var(#'x, A)
  let xs = mk_var(#'xs, lst)
  let y = mk_var(#'y, lst)
  let nil_case = mk_comb(p, nil_tm)
  let cons_case = mk_forall_list(
                    [x, xs],
                    mk_imp(mk_comb(p, xs), mk_comb(p, cons_tm(x, xs))))
  let all = mk_forall(y, mk_comb(p, y))
  list_thms.induction.concl
    == mk_forall(p, mk_imp(mk_conj(nil_case, cons_case), all))
  ~is #true

check:
  let value = mk_var(#'value, lst)
  let x = mk_var(#'x, A)
  let xs = mk_var(#'xs, lst)
  let nil_case = mk_eq(value, nil_tm)
  let cons_case = mk_exists(x, mk_exists(xs, mk_eq(value, cons_tm(x, xs))))
  list_thms.cases.concl == mk_forall(value, mk_disj(nil_case, cons_case))
  ~is #true

// discriminators: one equation per (discriminator, constructor) pair
check list_thms.discriminators.length() ~is 4
check:
  let x = mk_var(#'x, A)
  let xs = mk_var(#'xs, lst)
  let cons = cons_tm(x, xs)
  list_thms.discriminators.map(fun (t :: Thm): concl_of(t))
    == [mk_eq(discriminator_tm(#'is_nil, nil_tm), tm_true),
        mk_forall_list([x, xs], mk_eq(discriminator_tm(#'is_nil, cons), tm_false)),
        mk_eq(discriminator_tm(#'is_cons, nil_tm), tm_false),
        mk_forall_list([x, xs], mk_eq(discriminator_tm(#'is_cons, cons), tm_true))]
  ~is #true

check:
  let x = mk_var(#'x, A)
  let xs = mk_var(#'xs, lst)
  let cons = cons_tm(x, xs)
  list_thms.selectors.map(fun (t :: Thm): concl_of(t))
    == [mk_forall_list([x, xs], mk_eq(selector_tm(#'cons_head, A, cons), x)),
        mk_forall_list([x, xs], mk_eq(selector_tm(#'cons_tail, lst, cons), xs))]
  ~is #true

check:
  let value = mk_var(#'value, lst)
  let nil_rule = mk_imp(discriminator_tm(#'is_nil, value), mk_eq(nil_tm, value))
  let rebuilt = cons_tm(selector_tm(#'cons_head, A, value),
                        selector_tm(#'cons_tail, lst, value))
  let cons_rule = mk_imp(discriminator_tm(#'is_cons, value), mk_eq(rebuilt, value))
  [concl_of(list_thms.elim_rules[#'nil] :~ Thm), concl_of(list_thms.elim_rules[#'cons] :~ Thm)]
    == [mk_forall(value, nil_rule), mk_forall(value, cons_rule)]
  ~is #true

// Every emitted statement is hypothesis-free and well-formed in the theory it
// was created in -- the kernel checked that, but assert it explicitly since
// this module is a trust boundary.
check:
  let stmts = [list_thms.induction, list_thms.cases]
              ++ list_thms.distinctness.values() ++ list_thms.discriminators
              ++ list_thms.selectors ++ list_thms.elim_rules.values()
  for all (t in stmts): hyps_of(t) == []
  ~is #true
check:
  let stmts = [list_thms.induction, list_thms.cases]
              ++ list_thms.distinctness.values() ++ list_thms.discriminators
              ++ list_thms.selectors ++ list_thms.elim_rules.values()
  for all (t in stmts):
    block:
      check_term(list_thy, concl_of(t))
      #true
  ~is #true

// ==========================================================================
// A second datatype: a binary tree, to exercise multiple recursive fields
// ==========================================================================

def tree_spec:
  DatatypeSpec(#'Tree, [#'a],
               [Ctor(#'leaf, []),
                Ctor(#'node, [Field(#'value, A),
                              Field(#'left, mk_tyapp(#'Tree, [A])),
                              Field(#'right, mk_tyapp(#'Tree, [A]))])])

def (tree_thy, tree_thms) = datatype_axioms(list_thy, tree_spec)

// both recursive fields get an induction hypothesis
check:
  let tree = mk_tyapp(#'Tree, [A])
  let leaf = mk_const(#'leaf, tree)
  let node_c = mk_const(#'node, mk_fun(A, mk_fun(tree, mk_fun(tree, tree))))
  let node = fun (value :: Term, left :: Term, right :: Term):
               list_mk_comb(node_c, [value, left, right])
  let p = mk_var(#'p, mk_fun(tree, bool))
  let value = mk_var(#'value, A)
  let left = mk_var(#'left, tree)
  let right = mk_var(#'right, tree)
  let t = mk_var(#'t, tree)
  let leaf_case = mk_comb(p, leaf)
  let node_case = mk_forall_list(
                    [value, left, right],
                    mk_imp(mk_comb(p, left),
                           mk_imp(mk_comb(p, right),
                                  mk_comb(p, node(value, left, right)))))
  let all = mk_forall(t, mk_comb(p, t))
  tree_thms.induction.concl
    == mk_forall(p, mk_imp(mk_conj(leaf_case, node_case), all))
  ~is #true
check recursive_field_indexes(tree_spec, tree_spec.ctors[1]) ~is [1, 2]

// a datatype can be built on top of an earlier one
check:
  let both = DatatypeSpec(#'Pair, [#'a],
                          [Ctor(#'pr, [Field(#'fst, mk_tyapp(#'List, [A])),
                                       Field(#'snd, mk_tyapp(#'Tree, [A]))])])
  let (t, thms) = datatype_axioms(tree_thy, both)
  let pair = mk_tyapp(#'Pair, [A])
  let list = mk_tyapp(#'List, [A])
  let tree = mk_tyapp(#'Tree, [A])
  let value = mk_var(#'value, pair)
  let x = mk_var(#'x, list)
  let y = mk_var(#'y, tree)
  let pr = list_mk_comb(mk_const(#'pr, mk_fun(list, mk_fun(tree, pair))), [x, y])
  thms.cases.concl
    == mk_forall(value, mk_exists(x, mk_exists(y, mk_eq(value, pr))))
  ~is #true

// three or more constructors: distinctness is quadratic
check:
  let s = DatatypeSpec(#'Colour, [],
                       [Ctor(#'red, []), Ctor(#'green, []), Ctor(#'blue, [])])
  let (t, thms) = datatype_axioms(base, s)
  [thms.distinctness.length(), thms.discriminators.length()]
  ~is [3, 9]
