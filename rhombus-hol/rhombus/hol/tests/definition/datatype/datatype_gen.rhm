#lang rhombus/static

// Generalized differential test: `datatype_gen.rhm`
// generalizes `datatype_derived.rhm`'s enum-only construction to arbitrary
// non-recursive constructors (fields allowed), encoding each constructor's
// field tuple via `prod` (`algebra.rhm`) alongside the same `unit`/`sum`
// choice-among-constructors composition the enum case already used.
// The test-only oracle in `datatype_axiom_support.rhm` builds the same shape.
// Every field of `DatatypeThms` -- injectivity, distinctness, induction,
// cases, discriminators, selectors, elim_rules -- must agree between the
// two, *as printed statements*, and every theorem the derived side
// produces must carry zero hypotheses.

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/definition/datatype/define open
  lib("rhombus/hol/tests/definition/datatype/datatype_axiom_support.rhm") open
  rhombus/hol/definition/datatype/generate open
  rhombus/hol/definition/datatype/algebra open

// Compared as terms, not as printed names: two constants that display the
// same are not the same constant, and a differential test that cannot see
// the difference is not checking what it claims to.
fun concls(ths :: List.of(Thm)) :~ List:
  ths.map(fun (t :: Thm): concl_of(t))

// Canonical-order concl lists, since the Map fields no longer carry a
// positional order of their own: `[i,j]`-keyed for distinctness (`i < j`,
// matching `datatype_axiom_support.rhm`'s enumeration), constructor-name
// order for `elim_rules` (matching `spec.ctors`).
fun concls_distinctness(thms :: DatatypeThms) :~ List:
  let n = thms.spec.ctors.length()
  for values(acc :~ List = []) (i in List.iota(n)):
    for values(acc2 :~ List = acc) (j in List.iota(n)):
      (if i < j | acc2 ++ [concl_of(thms.distinctness[[i, j]] :~ Thm)] | acc2)

fun concls_elim_rules(thms :: DatatypeThms) :~ List:
  for List (c in thms.spec.ctors):
    concl_of(thms.elim_rules[(c :~ Ctor).name] :~ Thm)

fun all_zero_hyps(thms :: DatatypeThms) :: Boolean:
  hyps_of(thms.induction).length() == 0
    && hyps_of(thms.cases).length() == 0
    && (for all (t in thms.distinctness.values()): hyps_of(t).length() == 0)
    && (for all (t in thms.discriminators): hyps_of(t).length() == 0)
    && (for all (t in thms.selectors): hyps_of(t).length() == 0)
    && (for all (t in thms.elim_rules.values()): hyps_of(t).length() == 0)
    && (for all (n in thms.injectivity.keys()): hyps_of(thms.injectivity[n]).length() == 0)

fun check_dt(spec :: DatatypeSpec) :: Void:
  let (_, ax) = datatype_axioms(base_theory(), spec)
  let (_, dv) = build_nonrecursive_datatype_thms(algebra_base_theory(), spec)
  check all_zero_hyps(dv) ~is #true
  check concl_of(ax.induction) ~is concl_of(dv.induction)
  check concl_of(ax.cases) ~is concl_of(dv.cases)
  check concls_distinctness(ax) ~is concls_distinctness(dv)
  check concls(ax.discriminators) ~is concls(dv.discriminators)
  check concls(ax.selectors) ~is concls(dv.selectors)
  check concls_elim_rules(ax) ~is concls_elim_rules(dv)
  check ax.injectivity.length() ~is dv.injectivity.length()
  check (for all (n in ax.injectivity.keys()): concl_of(ax.injectivity[n]) == concl_of(dv.injectivity[n])) ~is #true



// A single one-field constructor: the minimum needing `prod` at all is
// two fields, so this exercises the `k = 1` (no `prod`, field type used
// directly as the payload) path in isolation.
check_dt(DatatypeSpec(#'Wrap, [], [Ctor(#'Wrap, [Field(#'v, bool)])]))

// Two fields: the minimum that actually needs `prod`.
check_dt(DatatypeSpec(#'Pair2, [], [Ctor(#'MkPair, [Field(#'fst, bool), Field(#'snd, bool)])]))

// Three fields: nested `prod` two levels deep, and two independent type
// variables (not just `bool`) to exercise `INST_TYPE`d field-typed helpers.
check_dt(DatatypeSpec(#'Triple, [#'a, #'b], [Ctor(#'MkTriple, [Field(#'x, mk_tyvar(#'a)), Field(#'y, mk_tyvar(#'b)), Field(#'z, bool)])]))

// Nullary mixed with a one-field constructor (an `Option`-shaped type):
// exercises `is_Ci`/selectors coexisting with a fieldless constructor.
check_dt(DatatypeSpec(#'OptionLike, [], [Ctor(#'NoneL, []), Ctor(#'SomeL, [Field(#'v, bool)])]))

// Four constructors with 0/1/2/3 fields respectively: the general case,
// covering every arity discriminators/selectors/elim_rules must handle
// together, plus the full n^2 discriminator cross product.
check_dt(DatatypeSpec(#'Mixed4, [], [Ctor(#'M0, []), Ctor(#'M1, [Field(#'a, bool)]), Ctor(#'M2, [Field(#'a, bool), Field(#'b, bool)]), Ctor(#'M3, [Field(#'a, bool), Field(#'b, bool), Field(#'c, bool)])]))

// `is_nonrecursive_spec` rejects a self-recursive field, and
// `build_nonrecursive_datatype_thms` refuses recursive specifications
// outright rather than silently producing something wrong.
def recursive_spec = DatatypeSpec(#'Lst, [#'a], [Ctor(#'Nil, []), Ctor(#'Cons, [Field(#'hd, mk_tyvar(#'a)), Field(#'tl, mk_tyapp(#'Lst, [mk_tyvar(#'a)]))])])
check is_nonrecursive_spec(recursive_spec) ~is #false
fun rejects_recursive_spec() :: Boolean:
  try:
    build_nonrecursive_datatype_thms(algebra_base_theory(), recursive_spec)
    #false
    ~catch _: #true

check rejects_recursive_spec() ~is #true
