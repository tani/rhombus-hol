#lang rhombus/static

// `function` never adds an axiom. A recursion scheme that this version cannot
// derive is refused with its specific reason instead of being postulated.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

// -- and a refusal names its real cause --------------------------------------
//
// `rhombus/hol/tests/definition/function/fixtures/function_unsupported.rhm` rests on a `~measure` landing in a
// non-recursive datatype.  The message says that, rather than reporting an
// undeclared `Colour_lt` -- true, and no use to the author -- or blaming
// something that stopped being a reason to refuse.

check:
  try:
    block:
      load(ModulePath'lib("rhombus/hol/tests/definition/function/fixtures/function_unsupported.rhm")')
      "compiled"
    ~catch e :: Exn.Fail:
      cond
      | e.message.contains("must land in a declared datatype that recurses")
          && e.message.contains("Colour"): "refused, naming the measure"
      | ~else: "refused: " ++ e.message
  ~is "refused, naming the measure"
