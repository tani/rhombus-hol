#lang rhombus/static

// The lexicographic product of two well-founded relations
// used by the recursive-function derivation.
//
// This is the order Ackermann's function recurses in: neither argument
// shrinks at every call, but the pair does.

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel open
  rhombus/hol/backend/proof/logic/bool open
  rhombus/hol/backend/proof/definition/datatype/algebra open
  rhombus/hol/backend/proof/definition/function/lexicographic open

  rhombus/hol/backend/proof/automation/definition_services open
def alg :~ AlgebraThms = algebra_base_thms()
def tyA = mk_tyapp(#'A, [])
def tyB = mk_tyapp(#'B, [])
def rel_a = mk_fun(tyA, mk_fun(tyA, bool))
def rel_b = mk_fun(tyB, mk_fun(tyB, bool))
def thy:
  let t0 = new_type(new_type(lex_base_theory(), #'A, 0), #'B, 0)
  new_constant(new_constant(t0, #'RA, rel_a), #'SB, rel_b)
def ra = mk_const(#'RA, rel_a)
def sb = mk_const(#'SB, rel_b)

// -- the closure costs no axiom ----------------------------------------------
//
// `LEX` is an ordinary definition, so the only assumptions in play are the
// two the caller brings.

check:
  axioms_of(lex_base_theory()).length()
  ~is axioms_of(base_theory()).length()

check:
  let th = prove_wf_lex(
    thy,
    alg,
    ASSUME(thy, mk_wf(ra)),
    ASSUME(thy, mk_wf(sb)),
    definition_logic_rules,
    definition_rewrite_support)
  [concl_of(th), hyps_of(th)]
  ~is [mk_wf(mk_lex(ra, sb)), [mk_wf(ra), mk_wf(sb)]]

// -- and it is `LEX` of exactly those two ------------------------------------
//
// Not, say, of the first alone: a caller that swapped the arguments would
// still get a theorem, and it would be the wrong order to recurse in.

check:
  let (_, args) = strip_comb(mk_lex(ra, sb))
  args
  ~is [ra, sb]

check:
  let (_, args) = strip_comb(mk_lex(sb, ra))
  args
  ~is [sb, ra]
