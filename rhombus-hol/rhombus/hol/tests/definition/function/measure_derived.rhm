#lang rhombus/static

// `~measure` recursion is derived through `WFREC`, not postulated.
//
// A measure has no descending argument column -- that is why it needs a
// measure -- so the order is the measure's own result type's subterm
// relation, pulled back along the measure.  The descent facts are the
// obligations `check_termination` discharged, and they hold only under the
// branch conditions that reach each call, which is what the congruence
// bridge carries.

import:
  rhombus/hol/kernel open
  rhombus/hol/backend/proof/definition/function/spec open
  rhombus/hol/backend/proof/driver open
  lib("rhombus/hol/tests/definition/function/fixtures/measure_ok.rhm") as f
  lib("rhombus/hol/tests/definition/function/fixtures/measure_ok.rhm")!hol_theory as m
  lib("rhombus/hol/tests/definition/function/fixtures/measure_types_only.rhm")!hol_theory as types_only

def st :~ HolState = m.theory

fun info_of(n :: Symbol) :~ FunInfo: st.ctx.funs[n]

// Both measured definitions really did take the measure route.
check info_of(#'count).induction ~matches RecursiveInduction(_)
check info_of(#'down).induction ~matches RecursiveInduction(_)

// `count`: the recursive argument is a *computed* term, `pred_of(succ(k))`,
// which is not a constructor subterm of `succ(k)`.  Unguarded, so the
// obligation has no antecedents.
check info_of(#'count).equations.length() ~is 2

// `down`: guarded.  The measure decreases only down the branch `nul(n)`
// rejects, so the obligation is stated under `not nul(n)` and the
// congruence proof has to be standing under that condition when it uses it.
check info_of(#'down).equations.length() ~is 1

// Every equation is a closed theorem, derived rather than assumed.
check info_of(#'count).equations.map(fun (t :: Thm): hyps_of(t)) ~is [[], []]
check info_of(#'down).equations.map(fun (t :: Thm): hyps_of(t)) ~is [[]]

// And none of the four functions in the fixture costs an axiom: the
// module's theory has exactly what declaring `Nat` alone brings, which is
// the datatype's own schema plus `Nat_lt`'s equations (`add_subterm_relation`
// still postulates those -- see trust.scrbl).
check:
  axioms_of(st.ctx.thy).length()
  ~is axioms_of((types_only.theory :~ HolState).ctx.thy).length()

// The executable half computes, as always.
check f.count(f.two) ~is f.two
check f.down(f.two) ~is f.two
check f.down(f.zero()) ~is f.zero()
