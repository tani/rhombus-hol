#lang rhombus/static

// Consolidated regression for every mandatory scenario in the
// "First-Class Local Functions" design document's §25 test list and
// §26 diagnostics, cross-referencing where each is covered:
//
// Positive scenarios (§25):
//   - Anonymous identity / application     -> anonymous_function_core.rhm
//   - Named local function                 -> multicase_function.rhm,
//                                              let_local_capture_ok.rhm (pre-existing)
//   - Capture outer parameter               -> anonymous_function_core.rhm
//   - Capture previous `let`                -> let_local_capture_ok.rhm (pre-existing)
//   - Nested local functions                -> anonymous_function_core.rhm
//   - Earlier local function reference      -> anonymous_function_core.rhm
//   - Polymorphic local lambda              -> here
//   - Higher-order return                   -> here
//
// Rejection scenarios (§25/§26):
//   - Forward reference rejection           -> let_local_forward_bad.rhm (pre-existing)
//   - Local self-recursion rejection        -> let_local_self_bad.rhm (pre-existing)
//   - Mutual recursion rejection            -> anonymous_function_core.rhm
//   - Enclosing recursive function rejection -> enclosing_function_recursion.rhm
//
// This file directly regresses the two scenarios (polymorphic local
// lambda, higher-order return) not already named elsewhere.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
  "compiled"

// Polymorphic local lambda, instantiated and applied.
check:
  load(
    ModulePath'lib("rhombus/hol/tests/fixtures/polymorphic_local_lambda_ok.rhm")')
  ~is "compiled"

// Higher-order return: a function returning a function, then applied.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/higher_order_return_ok.rhm")')
  ~is "compiled"
