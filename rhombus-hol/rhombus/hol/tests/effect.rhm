#lang rhombus/static

import:
  rhombus/hol/effect/core open
  rhombus/hol/effect/syntax open

class TestUnhandled(value):
  extends EffectOperation

class TestInner(value):
  extends EffectOperation

class TestOuter():
  extends EffectOperation

class TestReaderA():
  reader_effect

class TestReaderB():
  class Ask():
    extends EffectOperation

  fun ask() :: Computation:
    perform(Ask())
  fun handle(environment, computation :: Computation) :: Computation:
    recur loop (current :: Computation = computation):
      match current
      | Pure(_): current
      | Request(operation, resume):
          match operation
          | Ask(): loop(resume(environment))
          | ~else:
              Request(operation, fun (value): loop(resume(value)))
  export:
    ask
    handle

class TestState():
  state_effect

class TestFailure():
  failure_effect

fun pure_value(computation :: Computation):
  match computation
  | Pure(value): value
  | ~else: error(~who: #'pure_value, "expected a completed computation")

fun state_result(initial, computation :: Computation) :: TestState.Result:
  match TestState.handle(initial, computation)
  | Pure(result): result :~ TestState.Result
  | ~else: error(~who: #'state_result, "expected completed state computation")

// `effect:` expands `<-` to `bind` and `return` to `pure`.
check pure_value(return 17) ~is 17

def effect_sequence_subject:
  effect:
    let start <- TestState.get()
    let _ <- TestState.put(start + 3)
    let _ <- TestState.modify(fun (value): value * 2)
    TestState.get()
check:
  let result = state_result(5, effect_sequence_subject)
  [result.value, result.state]
  ~is [16, 16]

// Identity handling preserves an operation rather than inventing a policy.
check:
  handle(perform(TestUnhandled(17)),
         fun (_operation, _resume): #false)
  ~matches Request(TestUnhandled(17), _)

// An inner handler forwards operations owned by an enclosing handler.
def nested_subject:
  effect:
    let value <- perform(TestInner(40))
    let _ <- perform(TestOuter())
    return value
def nested:
  handle(handle(nested_subject,
                fun (operation, resume):
                  match operation
                  | TestInner(value): resume(value + 1)
                  | ~else: #false),
         fun (operation, resume):
           match operation
           | TestOuter(): resume(#void)
           | ~else: #false)
check pure_value(nested) ~is 41

// Reader operation identity belongs to the capability, not a global family.
def dual_reader_subject:
  effect:
    let a <- TestReaderA.ask()
    let b <- TestReaderB.ask()
    return [a, b]
check:
  pure_value(TestReaderA.handle(5, TestReaderB.handle(8, dual_reader_subject)))
  ~is [5, 8]

// `local` changes one capability temporarily and restores its environment.
def local_reader_subject:
  effect:
    let inside <- TestReaderA.local(fun (value): value + 1,
                                    TestReaderA.ask())
    let outside <- TestReaderA.ask()
    return [inside, outside]
check pure_value(TestReaderA.handle(5, local_reader_subject)) ~is [6, 5]

// State forwards a failure it does not own; the failure handler then aborts.
def failed_state_subject:
  effect:
    let _ <- TestState.put(9)
    let _ <- TestFailure.fail(#'unify_mismatch)
    TestState.put(10)
check:
  TestState.handle(0, failed_state_subject)
  ~matches Request(_, _)
check:
  TestFailure.handle(TestState.handle(0, failed_state_subject))
  ~matches TestFailure.Failed(#'unify_mismatch)
