#lang rhombus/static

// A recursive top-level `function`'s own self-recursion keeps working
// normally alongside a coexisting local/anonymous function declared in
// the same body -- as long as the recursive call is not routed *through*
// that local/anonymous function. Only a call from *inside* a
// local/anonymous function body back into the currently-being-defined
// enclosing function is rejected (a local `function` is non-recursive
// lambda sugar, per the "First-Class Local Functions" design).

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
  "compiled"

fun stuck_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

// Coexistence: the outer function's own recursion still elaborates and
// its stated value proves.
check:
  load(
    ModulePath'lib("rhombus/hol/tests/fixtures/local_fn_beside_recursion_ok.rhm")')
  ~is "compiled"

check:
  load(
    ModulePath'lib("rhombus/hol/tests/fixtures/anon_fn_beside_recursion_ok.rhm")')
  ~is "compiled"

// Crossing the boundary: a local/anonymous function calling the
// currently-being-defined enclosing function is rejected outright.
check:
  stuck_message(
    ModulePath'lib("rhombus/hol/tests/fixtures/local_calls_enclosing_bad.rhm")')
    .contains("recursive call")
  ~is #true

check:
  stuck_message(
    ModulePath'lib("rhombus/hol/tests/fixtures/anon_calls_enclosing_bad.rhm")')
    .contains("recursive call")
  ~is #true
