#lang rhombus/static

// `exists1`/`select` single-binder desugaring to `(core_call (core_ref
// exists1/select) [(core_function_expr [b] #false ...)])`
// (`surface_space.rhm`). Verified here: both parse and elaborate to a
// well-typed goal (a stuck-proof failure, not a parse/elaboration error),
// and both reject more than one binder. Full automatic proof of
// `exists1`/`select` goals is a separate, not-yet-implemented capability
// (no default rewrite rule unfolds either call) -- out of scope here.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

fun stuck_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

check:
  stuck_message(ModulePath'lib("rhombus/hol/tests/fixtures/exists1_select_stuck.rhm")')
    .contains("could not prove")
  ~is #true

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/exists1_multi_bad.rhm")')
  ~throws "`exists1` accepts exactly one binder"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/select_multi_bad.rhm")')
  ~throws "`select` accepts exactly one binder"
