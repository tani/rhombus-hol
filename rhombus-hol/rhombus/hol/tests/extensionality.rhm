#lang rhombus/static

// `~extensionality: x` derives function equality (`f === g`) from a
// pointwise goal (`f(x) === g(x)`) via the kernel's `EXT` rule -- no new
// axiom -- applying identically to ordinary functions and to `Set`
// values (predicates). It is rejected outright for a non-function
// equality goal.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

def load_positive = make_hol_fixture_loader()

fun bad_message() :: String:
  try:
    block:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/extensionality_non_function_bad.rhm")')
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/fixtures/function_extensionality_ok.rhm")')
  "compiled"
  ~is "compiled"

check bad_message().contains("`~extensionality` requires an equality between functions") ~is #true
