#lang rhombus/static

export:
  instantiate_hol_fixture

// A `rhombus/hol` declaration is evaluated in its generated `hol_theory`
// submodule.  Instantiating only the enclosing module can silently skip a
// precompiled negative fixture's declaration checks.
fun instantiate_hol_fixture(mp :: ModulePath):
  let e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }:
    Evaluator.instantiate(mp)
    Evaluator.instantiate(mp.add(ModulePath('self ! hol_theory')))
