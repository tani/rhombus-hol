#lang rhombus/static

export:
  instantiate_hol_fixture
  make_hol_fixture_loader

// A `rhombus/hol` declaration is evaluated in its generated `hol_theory`
// submodule. Instantiating only the enclosing module can silently skip a
// precompiled negative fixture's declaration checks.
fun instantiate_in(e, mp :: ModulePath):
  parameterize { Evaluator.current: e }:
    Evaluator.instantiate(mp)
    Evaluator.instantiate(mp.add(ModulePath('self ! hol_theory')))

// Successful fixtures may share one evaluator within a test process, allowing
// common imported modules to be instantiated once. A loader must never be
// reused after a fixture fails, since failed instantiation can leave evaluator
// state behind.
fun make_hol_fixture_loader():
  let e = Evaluator.make_rhombus()
  fun (mp :: ModulePath): instantiate_in(e, mp)

// Negative fixtures get an isolated evaluator so one expected failure cannot
// affect a later check.
fun instantiate_hol_fixture(mp :: ModulePath):
  instantiate_in(Evaluator.make_rhombus(), mp)
