#lang rhombus/hol

// An anonymous function value calling the currently-being-defined
// enclosing function is rejected for the same reason as the named-local
// case in `local_calls_enclosing_bad.rhm`.

datatype Nat
| zero()
| succ(pred :: Nat)

function apply_once(f :: Nat -> Nat, n :: Nat) :: Nat:
  f(n)

function outer(x :: Nat) :: Nat:
  match x
  | zero(): zero()
  | succ(k):
      apply_once(function (n): outer(n), k)
