#lang rhombus/hol

// An anonymous function used as an ordinary first-class value bound by
// `let`, then applied. Proves outright.

export: Nat zero succ anon_as_value

datatype Nat
| zero()
| succ(pred :: Nat)

function anon_as_value(n :: Nat) :: Nat:
  let id_fn = function (x :: Nat) :: Nat: x
  id_fn(n)

theorem anon_value_zero:
  anon_as_value(zero()) === zero()
