#lang rhombus/hol

// Same as `local_fn_beside_recursion_ok.rhm`, but the coexisting
// function is a first-class anonymous `CoreFunctionExpr` value passed as
// a higher-order argument, not named local sugar.

export: Nat zero succ outer

datatype Nat
| zero()
| succ(pred :: Nat)

function apply_twice(f :: Nat -> Nat, n :: Nat) :: Nat:
  f(f(n))

function outer(x :: Nat) :: Nat:
  match x
  | zero(): zero()
  | succ(k):
      apply_twice(function (n): succ(n), outer(k))

theorem outer_one:
  outer(succ(zero())) === succ(succ(zero()))
