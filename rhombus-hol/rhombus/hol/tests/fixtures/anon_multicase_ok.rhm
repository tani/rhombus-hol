#lang rhombus/hol

// The same `function | (pat): body | ...` case-clause form as a fully
// anonymous higher-order function value, passed directly as an argument.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

function apply1(f :: Nat -> Nat, n :: Nat) :: Nat:
  f(n)

theorem anon_multicase_zero:
  apply1(
    function
    | (zero()): zero()
    | (succ(k)): k,
    zero()) === zero()
