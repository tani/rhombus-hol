#lang rhombus/hol
export: Nat zero succ dbl

// An ordinary structural recursion, declared with the form that postulates.
// `function` would derive this one; `axiomatic_function` assumes it. The
// difference is visible in the module's axiom count, and nowhere else --
// which is the point of the two forms having the same grammar.
type Nat
| zero()
| succ(pred :: Nat)

axiomatic_function dbl(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): succ(succ(dbl(k)))
