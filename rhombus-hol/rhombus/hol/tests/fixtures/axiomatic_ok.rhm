#lang rhombus/hol
export: Nat zero succ Colour red green f

// The same declaration, spelled with the form that is allowed to postulate.
type Nat
| zero()
| succ(pred :: Nat)

type Colour
| red()
| green()

axiomatic_function f(c :: Colour, n :: Nat) :: Nat ~measure(c):
  match n
  | zero(): zero()
  | succ(p): f(c, p)
