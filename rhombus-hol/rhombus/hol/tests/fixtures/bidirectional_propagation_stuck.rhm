#lang rhombus/hol

// A call site with zero explicit type annotations anywhere
// (`Pair([zero(), succ(zero())], zero())`) elaborates correctly by
// propagating the outer function's declared parameter type
// (`Pair.of(List.of(Nat), Nat)`) bidirectionally through two levels of
// nesting: first into the `Pair` literal's two positions, then from
// there into the `List` literal's element type.
//
// The goal reduces until only `fst(pair(cons(zero, ...), zero))` is
// left: the stdlib `Pair` accessors carry no rewrite rule, a separate,
// pre-existing gap (`fst(Pair(zero(), succ(zero()))) === zero()` stated
// on its own is equally stuck). The residual still names the fully
// elaborated literal at its propagated types, which is what this
// fixture pins.

export: Nat zero succ List nil cons first_or_zero first_of_pair_list

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

function first_or_zero(xs :: List.of(Nat)) :: Nat:
  match xs
  | []: zero()
  | [x, & _]: x

function first_of_pair_list(
    p :: Pair.of(List.of(Nat), Nat)) :: Nat:
  let Pair(xs, _) = p
  first_or_zero(xs)

theorem deep_propagation:
  first_of_pair_list(Pair([zero(), succ(zero())], zero())) === zero()
