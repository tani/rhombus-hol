#lang rhombus/hol

// A binder's `:: T` annotation is optional. When the body constrains the
// variable's type, that constraint is inferred (`optional_declared_type`
// defaults to a fresh metavariable, unified by ordinary use); when nothing
// constrains it, the variable is generalized into a genuinely polymorphic
// theorem, which is sound in HOL (a fact about every type, not one type
// left unspecified by accident).

export: Nat zero succ id_nat

datatype Nat
| zero()
| succ(pred :: Nat)

function id_nat(n :: Nat) :: Nat:
  n

theorem infer_binder_type_from_usage:
  forall (x): id_nat(x) === x

theorem generalize_unconstrained_binder:
  forall (x): x === x
