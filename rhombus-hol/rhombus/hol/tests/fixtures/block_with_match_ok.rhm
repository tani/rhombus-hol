#lang rhombus/hol

// A `block:` wrapping a `match`, used directly as a general expression
// value, proving outright.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

theorem block_with_match:
  (block:
     match zero()
     | zero(): succ(zero())
     | succ(_): zero()) === succ(zero())
