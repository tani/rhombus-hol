#lang rhombus/hol

// `#true` and `#false` as patterns. `bool` is a primitive kernel type, not
// a declaration, so the decision-tree compiler is handed a `DatatypeThms`
// derived from `BOOL_CASES_AX` instead (`bool_datatype.rhm`, installed by
// `initial_context`): two nullary constructors, `not (true <=> false)` for
// distinctness, and `is_true`/`is_false` discriminators. Totality is
// checked exactly as for a declared datatype -- both cases are present, so
// the match is total -- and the derived equations reduce.

export: negate both_true Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

function negate(b :: Boolean) :: Boolean:
  match b
  | #true: #false
  | #false: #true

// A Boolean literal pattern in a second, nested match, so a split happens
// at more than one position.
function both_true(x :: Boolean, y :: Boolean) :: Nat:
  match x
  | #true:
      match y
      | #true: succ(zero())
      | #false: zero()
  | #false: zero()

theorem negate_true:
  negate(#true) === #false

theorem negate_false:
  negate(#false) === #true

theorem negate_involutive:
  forall (b :: Boolean): negate(negate(b)) === b

theorem both_true_yes:
  both_true(#true, #true) === succ(zero())

theorem both_true_no:
  both_true(#true, #false) === zero()
