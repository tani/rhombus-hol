#lang rhombus/hol

// `check_property` is a genuine, independently bound macro rather than a form
// recognised by scanning, so it can be produced by a macro of the user's own
// -- a form no scanning-based recognition could ever see through, since it
// would only ever observe the unexpanded call to that macro.

import rhombus/meta open

export:
  Nat
  zero
  succ
  plus
  comm_check

defn.macro 'commutative $(check_name :: Identifier) $(op :: Identifier)':
  'check_property $check_name:
     forall (m :: Nat, n :: Nat): $op(m, n) === $op(n, m)'

type Nat
| zero()
| succ(pred :: Nat)

function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))

commutative comm_check plus
