#lang rhombus/hol

// A clause whose row does not cover every argument is a mistake, not a
// partial application: there is no column for the pattern compiler to put
// the missing one in.

export: Nat zero succ bad

type Nat
| zero()
| succ(pred :: Nat)

function bad(m :: Nat, n :: Nat) :: Nat
| zero(): zero()
| (succ(a), b): a
