#lang rhombus/hol

// The clausal declaration form: a row of patterns covering every argument,
// written the way Rhombus's own multi-case `fun` is written, instead of a
// `match` on one argument with the rest destructured by nesting.

export: List Nil Cons Nat zero succ app len eq2 both

type List(~a)
| Nil()
| Cons(head :: ~a, tail :: List(~a))

type Nat
| zero()
| succ(pred :: Nat)

function app(xs :: List(~a), ys :: List(~a)) :: List(~a)
| (Nil(), ys): ys
| (Cons(x, rest), ys): Cons(x, app(rest, ys))

// One argument may drop the parentheses, and `_` is a pattern here too.
function len(xs :: List(~a)) :: Nat
| Nil(): zero()
| Cons(_, rest): succ(len(rest))

// A genuine two-column matrix: every row constrains both arguments.
function eq2(m :: Nat, n :: Nat) :: Nat
| (zero(), zero()): zero()
| (succ(a), succ(b)): succ(eq2(a, b))
| (_, _): zero()

// Nested patterns in a row, and an earlier row shadowing part of a later one.
function both(xs :: Nat, ys :: Nat) :: Nat
| (succ(succ(a)), _): a
| (_, y): y
