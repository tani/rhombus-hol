#lang rhombus/hol

// Every logical binder kind -- `exists`, a Set comprehension applied as
// a predicate, `exists1`, and `select` -- composes freely inside a
// single theorem statement's conjunction, each independently
// elaborating and type-checking against the shared `Nat` scrutinee.
// Reaches the correctly-elaborated stuck goal naming all four forms
// (only automatic proof of this compound goal is out of scope here --
// each binder kind's own executability/rejection/typing is separately
// regression-tested elsewhere).

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

theorem composed_binders:
  (exists (m :: Nat): m === zero()) and Set{x :: Nat | x === zero()}(zero()) and (exists1 (k :: Nat): k === zero()) and ((select (k :: Nat): k === zero()) === zero())
