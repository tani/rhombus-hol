#lang rhombus/hol

type Nat
| zero()
| succ(pred :: Nat)

// No `~else` clause: `cond` refuses this outright rather than silently
// admitting a partial function -- there is no exhaustiveness analysis over
// arbitrary Boolean guards to fall back on.
function pick2(b :: Boolean, m :: Nat, n :: Nat) :: Nat:
  cond
  | b: m
  | !b: n
