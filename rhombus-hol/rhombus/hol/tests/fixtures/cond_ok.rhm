#lang rhombus/hol

// `cond` extends the reflected function-body subset beyond `if` and Boolean
// operators. It desugars to nested `if` and requires an explicit
// `~else` clause -- there is no exhaustiveness analysis over arbitrary
// Boolean guards the way `match` has over constructors.

export:
  Nat
  zero
  succ
  pick3
  two

type Nat
| zero()
| succ(pred :: Nat)

function pick3(b1 :: Boolean, b2 :: Boolean, m :: Nat, n :: Nat, k :: Nat) :: Nat:
  cond
  | b1: m
  | b2: n
  | ~else: k

def two = succ(succ(zero()))

// Proved while this module compiles: `cond`'s desugaring into `mk_cond`
// reuses the same derived conditional rules `if` already has.
theorem pick3_first:
  forall (m :: Nat, n :: Nat, k :: Nat): pick3(true, false, m, n, k) === m

theorem pick3_second:
  forall (m :: Nat, n :: Nat, k :: Nat): pick3(false, true, m, n, k) === n

theorem pick3_else:
  forall (m :: Nat, n :: Nat, k :: Nat): pick3(false, false, m, n, k) === k
