#lang rhombus/hol

// `cond` extends the reflected function-body subset beyond `if` and Boolean
// operators. It desugars to nested `if` and requires an explicit
// `~else` clause -- there is no exhaustiveness analysis over arbitrary
// Boolean guards the way `match` has over constructors.

export:
  Nat
  zero
  succ
  pick3
  two
  typed_branch
  pair_branch
  pair_fst
  pair_snd
  List
  nil
  cons
  list_branch
  String
  text
  string_branch
  is_hi
  is_empty_string
  set_branch
  is_member
  is_not_member
  conj_branch
  disj_branch
  imp_branch
  neg_branch
  eq_left_numeral
  eq_right_numeral
  eq_neither_numeral

datatype Nat
| zero()
| succ(pred :: Nat)

function pick3(b1 :: Boolean, b2 :: Boolean, m :: Nat, n :: Nat, k :: Nat) :: Nat:
  cond
  | b1: m
  | b2: n
  | ~else: k

def two = succ(succ(zero()))

// A type-ascribed branch (`(2 :: Nat)`) is purely a type hint with no
// runtime representation of its own -- the executable reading must reduce
// through the ascription to the branch's own value.
function typed_branch(b :: Boolean) :: Nat:
  if b
  | (2 :: Nat)
  | succ(zero())

// A `Pair` expression inside an `if` branch is checked and rendered
// structurally: it has to reach `if`'s own type unification (matching
// against the other branch) through the pair's element types, not
// bypass it.
function pair_fst(p :: Pair.of(Nat, Nat)) :: Nat:
  match p
  | Pair(a, b): a

function pair_snd(p :: Pair.of(Nat, Nat)) :: Nat:
  match p
  | Pair(a, b): b

function pair_branch(b :: Boolean) :: Pair.of(Nat, Nat):
  if b
  | Pair(succ(zero()), succ(succ(zero())))
  | Pair(zero(), succ(zero()))

// A `[...]` list expression inside an `if` branch is checked and
// rendered structurally through `check_expr`'s own `CoreListExpr` case:
// its element type has to reach `if`'s own unification (matching
// against the other branch), not bypass it as an opaque whole. `[]`
// exercises the destructure-from-expected path with zero elements.
datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

function list_branch(b :: Boolean) :: List.of(Nat):
  if b
  | [succ(zero()), succ(succ(zero()))]
  | []

// A string literal inside an `if` branch is checked and rendered
// through `check_expr`'s own `CoreStringExpr` case, which unlike
// `CoreListExpr`/`CorePairExpr` has no destructuring decision to make:
// a string literal is always type `String`, so `if`'s own unification
// only has to confirm agreement, not extract element/component types.
datatype String
| text(codes :: List.of(Nat))

function string_branch(b :: Boolean) :: String:
  if b
  | "hi"
  | ""

function is_hi(s :: String) :: Boolean:
  s == "hi"

function is_empty_string(s :: String) :: Boolean:
  s == ""

// A `Set{...}` expression inside an `if` branch is checked and rendered
// through `check_expr`'s own `CoreSetExpr` case: its element type has
// to reach `if`'s own unification the same way a list's does, and the
// result renders as a predicate lambda rather than a structural value.
function set_branch(b :: Boolean) :: Nat -> Boolean:
  if b
  | Set{succ(zero()), succ(succ(zero()))}
  | Set{}

function is_member(s :: Nat -> Boolean, n :: Nat) :: Boolean:
  s(n)

function is_not_member(s :: Nat -> Boolean, n :: Nat) :: Boolean:
  !s(n)

// `conj`/`disj`/`imp`/`neg` inside an `if` branch are checked and
// rendered through `check_expr`'s own special-cased `CoreCall` arms:
// each operand still has to be `Boolean`, and so does the branch as a
// whole, matching `if`'s own unification against the other branch --
// not routed through the general apply/overload machinery at all.
function conj_branch(x :: Boolean, a :: Boolean, b :: Boolean) :: Boolean:
  if x
  | a && b
  | #false

function disj_branch(x :: Boolean, a :: Boolean, b :: Boolean) :: Boolean:
  if x
  | a || b
  | #false

function imp_branch(x :: Boolean, a :: Boolean, b :: Boolean) :: Boolean:
  if x
  | imp(a, b)
  | #false

function neg_branch(x :: Boolean, a :: Boolean) :: Boolean:
  if x
  | !a
  | #false

// `eq` (`==`) inside an `if` branch is checked and rendered through
// `check_expr`'s own dedicated `CoreCall` arm: whichever operand needs
// an expected type to elaborate at all (a bare numeral) gets deferred
// until the other, self-sufficient operand's own checked type is
// available -- bidirectionally, unlike the general apply case's
// uniform left-to-right scan.
function eq_left_numeral(x :: Boolean) :: Boolean:
  if x
  | 1 == succ(zero())
  | #false

function eq_right_numeral(x :: Boolean) :: Boolean:
  if x
  | succ(zero()) == 1
  | #false

function eq_neither_numeral(x :: Boolean) :: Boolean:
  if x
  | succ(zero()) == succ(zero())
  | #false

// Proved while this module compiles: `cond`'s desugaring into `mk_cond`
// reuses the same derived conditional rules `if` already has.
theorem pick3_first:
  forall (m :: Nat, n :: Nat, k :: Nat): pick3(true, false, m, n, k) === m

theorem pick3_second:
  forall (m :: Nat, n :: Nat, k :: Nat): pick3(false, true, m, n, k) === n

theorem pick3_else:
  forall (m :: Nat, n :: Nat, k :: Nat): pick3(false, false, m, n, k) === k
