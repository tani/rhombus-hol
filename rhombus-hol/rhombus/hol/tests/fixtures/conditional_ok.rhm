#lang rhombus/hol

// `if` and the Boolean operators, read logically and executed, from one source.
//
// The spellings are Rhombus's own -- `#true`, `!`, `&&`, `||`, `==`, `if` --
// because the body is emitted verbatim as the executable half.  The logical
// half reads the same text as `true`, `not`, `and`, `or`, `===` and `cond`.

export:
  Nat
  zero
  succ
  nul
  eqn
  pick
  both
  two

type Nat
| zero()
| succ(pred :: Nat)

function nul(n :: Nat) :: Boolean:
  match n
  | zero(): #true
  | succ(k): #false

function eqn(m :: Nat, n :: Nat) :: Boolean:
  m == n

function pick(b :: Boolean, m :: Nat, n :: Nat) :: Nat:
  if b | m | n

function both(m :: Nat, n :: Nat) :: Boolean:
  !nul(m) && (nul(n) || eqn(m, n))

def two = succ(succ(zero()))

// Proved while this module compiles: the conditional rules are derived, not
// postulated, and they are in the rule database from the start.
theorem pick_of_true:
  forall (m :: Nat, n :: Nat): pick(true, m, n) === m

theorem pick_of_false:
  forall (m :: Nat, n :: Nat): pick(false, m, n) === n
