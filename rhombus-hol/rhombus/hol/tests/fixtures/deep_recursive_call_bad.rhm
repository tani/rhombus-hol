#lang rhombus/hol

// The termination checker's recursive-call finder walks the elaborated
// kernel `Term` (a closed four-constructor ADT: `Var`/`Const`/`Comb`/
// `Abs`), not the surface `CoreExpr`, so it is exhaustive by
// construction -- no surface sugar can hide a self-reference from it.
// Here the call to the enclosing `outer` is nested four levels deep
// (local function -> `block:` -> `let` -> `match` branch) and is still
// caught.

datatype Nat
| zero()
| succ(pred :: Nat)

function outer(x :: Nat) :: Nat:
  function inner(y :: Nat) :: Nat:
    block:
      let z = succ(y)
      match z
      | zero(): zero()
      | succ(_): outer(y)
  inner(x)
