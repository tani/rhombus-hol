#lang rhombus/hol

export:
  Nat
  zero
  succ
  one
  identity

datatype Nat
| zero()
| succ(pred :: Nat)

definition one :: Nat:
  succ(zero())

definition identity :: Nat -> Nat:
  function (n :: Nat) :: Nat:
    n
// The equations from both definitions must be available to the theorem prover.
theorem identity_one:
  identity(one) === one
