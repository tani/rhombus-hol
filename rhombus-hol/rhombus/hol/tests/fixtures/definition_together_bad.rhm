#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

// A `definition` family is *simultaneous*: every body is read in the theory
// the block started in, so a member cannot mention another. A definition
// cannot be recursive, and neither can a family of them.
definition.together:
  definition step_one :: Nat: succ(zero())
  definition step_two :: Nat: succ(step_one)

def marker = "compiled"
