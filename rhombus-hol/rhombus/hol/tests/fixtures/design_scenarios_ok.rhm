#lang rhombus/hol

// Design document "First-Class Local Functions" §25 positive scenarios
// not already covered elsewhere: a polymorphic local lambda instantiated
// at the call site, and a higher-order return (a function whose body is
// itself an anonymous function value, applied immediately). Both prove
// outright.

export: Nat zero succ outer make_id

datatype Nat
| zero()
| succ(pred :: Nat)

// Design §20/§25 "Polymorphic local lambda": a local function may share
// the enclosing function's type variable (`?a`), instantiated here to
// `Nat` from the call site `outer(zero())`.
function outer(x :: ?a) :: ?a:
  let id = function (y :: ?a) :: ?a: y
  id(x)

theorem polymorphic_local_lambda:
  outer(zero()) === zero()

// Design §25 "Higher-order return": a top-level function's body is
// itself an anonymous function value (result type `Nat -> Nat`),
// immediately applicable at the call site.
function make_id(x :: Nat) :: Nat -> Nat:
  function (y :: Nat) :: Nat: y

theorem higher_order_return_applies:
  make_id(zero())(zero()) === zero()
