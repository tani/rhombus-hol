#lang rhombus/hol

export:
  Nat
  zero
  succ
  Seq
  seq_nil
  Maybe
  none
  some
  mapped_empty_seq
  mapped_some_zero
  selected_left
  selected_right

type Nat:
| zero
| succ(previous :: Nat)

type Seq(?a):
| seq_nil
| seq_cons(first :: ?a, rest :: Seq(?a))

type Maybe(?a):
| none
| some(value :: ?a)

function seq_map(f :: Function(?a, ?b), xs :: Seq(?a)) :: Seq(?b)
| (f, seq_nil()): seq_nil()
| (f, seq_cons(first, rest)): seq_cons(f(first), seq_map(f, rest))

function maybe_map(f :: Function(?a, ?b), value :: Maybe(?a)) :: Maybe(?b)
| (f, none()): none()
| (f, some(value)): some(f(value))

function seq_empty() :: Seq(?a):
  seq_nil()

function maybe_empty() :: Maybe(?a):
  none()

dispatch map(Function(?a, ?b), Seq(?a)) = seq_map
dispatch map(Function(?a, ?b), Maybe(?a)) = maybe_map
dispatch empty() = seq_empty
dispatch empty() = maybe_empty

function select_left(_flag :: Boolean, left :: Nat, _right :: Nat) :: Nat:
  left

function select_right(_left :: Nat, right :: Nat, _flag :: Boolean) :: Nat:
  right

dispatch select3(Boolean, Nat, Nat) = select_left
dispatch select3(Nat, Nat, Boolean) = select_right

function identity_nat(x :: Nat) :: Nat:
  x

function mapped_empty_seq() :: Seq(Nat):
  map(identity_nat, empty())

function mapped_some_zero() :: Maybe(Nat):
  map(identity_nat, some(zero()))

function selected_left() :: Nat:
  select3(#true, succ(zero()), zero())

function selected_right() :: Nat:
  select3(zero(), succ(zero()), #true)

theorem mapped_empty_seq_logic:
  map(identity_nat, empty()) === seq_nil()

theorem selected_left_logic:
  select3(#true, succ(zero()), zero()) === succ(zero())
