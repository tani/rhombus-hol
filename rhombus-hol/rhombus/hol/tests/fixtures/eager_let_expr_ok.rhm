#lang rhombus/hol

// `block: let x = e1; e2` is the general-expression form of an eager
// `let`: it is usable anywhere an ordinary expression is expected,
// including as a function argument, not only in a function's own tail
// position. It proves outright, since the lambda it desugars to is
// beta-normalized with the goal before the waterfall runs.

export: Nat zero succ apply1

datatype Nat
| zero()
| succ(pred :: Nat)

function apply1(f :: Nat -> Nat, n :: Nat) :: Nat:
  f(n)

theorem let_as_arg:
  apply1(
    function (x :: Nat) :: Nat:
      let y = succ(x)
      y,
    block:
      let w = succ(zero())
      w) === succ(succ(zero()))
