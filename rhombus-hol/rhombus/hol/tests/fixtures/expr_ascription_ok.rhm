#lang rhombus/hol

// `expr :: Type` ascribes an explicit expected type onto an arbitrary
// expression: it disambiguates an otherwise-ambiguous numeral, and it
// also constrains a polymorphic call's instantiation.

export: Nat zero succ id_generic

datatype Nat
| zero()
| succ(pred :: Nat)

function id_generic(x :: ?a) :: ?a:
  x

theorem ascription_disambiguates_numeral:
  (0 :: Nat) === zero()

theorem ascription_constrains_polymorphic_call:
  (id_generic(zero()) :: Nat) === zero()
