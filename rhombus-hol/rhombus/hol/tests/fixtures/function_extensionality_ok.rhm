#lang rhombus/hol

// `~extensionality: x` reduces a function-equality goal `f === g` to the
// pointwise goal `f(x) === g(x)` for a fresh variable `x`, justified by
// the derived `EXT` rule (no new axiom). The remaining pointwise goal is
// then found automatically by the ordinary waterfall (here, induction on
// `x`), proving two functions equal by extensionality without ever
// syntactically comparing their definitions.

export: Nat zero succ double add_self

datatype Nat
| zero()
| succ(pred :: Nat)

function double(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): succ(succ(double(k)))

function add_self(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): succ(succ(add_self(k)))

theorem funs_equal:
  double === add_self
proof:
  ~extensionality: x
