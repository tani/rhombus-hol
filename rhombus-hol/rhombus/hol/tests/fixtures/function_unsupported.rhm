#lang rhombus/hol
export: Nat zero succ Colour red green f

// The measure lands in `Colour`, which has no subterm relation to decrease
// in, so there is no order to recurse in.  `function` refuses.  Before, this
// declaration compiled and postulated its equations.
type Nat
| zero()
| succ(pred :: Nat)

type Colour
| red()
| green()

function f(c :: Colour, n :: Nat) :: Nat ~measure(c):
  match n
  | zero(): zero()
  | succ(p): f(c, p)
