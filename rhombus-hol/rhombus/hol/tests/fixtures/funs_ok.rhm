#lang rhombus/hol

// `fun` emits executable Rhombus with the annotations erased, and from the
// same source registers the clausal equations with the kernel.

export:
  Nil
  Cons
  List
  zero
  succ
  Nat
  app
  rev
  length
  plus
  double
  sample

type List(?a)
| Nil()
| Cons(head :: ?a, tail :: List(?a))

type Nat
| zero()
| succ(pred :: Nat)

function app(xs :: List(?a), ys :: List(?a)) :: List(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

function rev(xs :: List(?a)) :: List(?a):
  match xs
  | Nil(): Nil()
  | Cons(x, rest): app(rev(rest), Cons(x, Nil()))

function length(xs :: List(?a)) :: Nat:
  match xs
  | Nil(): zero()
  | Cons(x, rest): succ(length(rest))

function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))

// The subterm relation of each recursive datatype is declared alongside it:
// that is where a `~measure` into `Nat` or `List` finds its order.
expect [List, List_lt, Nat, Nat_lt, app, rev, length, plus]

// An ordinary Rhombus `fun` is never intercepted: only `function` declares a
// logical definition, so this needs no annotations and gains no axioms.
fun double(n): n * 2

def sample = Cons(1, Cons(2, Cons(3, Nil())))
