#lang rhombus/hol

datatype Tree
| leaf()
| node(left :: Tree, right :: Tree)

// Two predicates declared together share every rule, so each may conclude
// with either of them: `even_depth` and `odd_depth` are the least *family*
// closed under these three rules. The declaration derives one introduction
// theorem per rule, and an induction and an inversion theorem per predicate.
inductive even_depth(Tree) and odd_depth(Tree)
| even_leaf: even_depth(leaf())
| even_step: forall (t :: Tree): odd_depth(t) ==> even_depth(node(t, t))
| odd_step: forall (t :: Tree): even_depth(t) ==> odd_depth(node(t, t))

theorem odd_one:
  odd_depth(node(leaf(), leaf()))
proof:
  ~use: [even_leaf, odd_step]

export:
  Tree
  leaf
  node

def marker = "compiled"
