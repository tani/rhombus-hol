#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

// A negative occurrence makes the rule operator non-monotone, so the rules
// need not have a least predicate closed under them at all.
inductive paradox(Nat)
| paradox_rule: forall (n :: Nat): not paradox(n) ==> paradox(succ(n))

def marker = "compiled"
