#lang rhombus/hol

datatype Tree
| leaf()
| node(left :: Tree, right :: Tree)

// `spine` is the least predicate closed under these rules: a leaf, or a node
// whose left child is a leaf and whose right child is again a spine. The
// declaration derives one introduction theorem per rule, `spine_induct`, and
// the inversion theorem `spine_cases`.
inductive spine(Tree)
| spine_leaf: spine(leaf())
| spine_node: forall (r :: Tree): spine(r) ==> spine(node(leaf(), r))

// The introduction theorems are ordinary named theorems, usable in a proof.
theorem spine_one:
  spine(node(leaf(), leaf()))
proof:
  ~use: [spine_leaf, spine_node]

export:
  Tree
  leaf
  node

def marker = "compiled"
