#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

// The predicate reaches a premise as a value rather than as an application.
// Nothing is known about how that position uses it, so the rule operator
// cannot be shown monotone.
inductive opaque(Nat)
| opaque_rule: forall (n :: Nat): (opaque === opaque) ==> opaque(n)

def marker = "compiled"
