#lang rhombus/hol

// Same as `lambda_type_inference_ok.rhm`, but the lambda's *result*
// type (rather than its parameter type) is the one left to inference.

export: Nat zero succ apply_to_zero

datatype Nat
| zero()
| succ(pred :: Nat)

function apply_to_zero(f :: Nat -> Nat) :: Nat:
  f(zero())

theorem lambda_result_type_inferred:
  apply_to_zero(function (n :: Nat): succ(n)) === succ(zero())
