#lang rhombus/hol

// An anonymous function's parameter type is optional
// (`elaborate_function_expr_effect`'s `optional_declared_type`); an
// enclosing expected function type (`apply_to_zero`'s own `Nat -> Nat`)
// fills it in. Verified by the theorem below proving: the lambda
// application must have carried the *correct* concrete type (`Nat`), not
// a leftover metavariable, for it to elaborate and reduce to the stated
// value.

export: Nat zero succ apply_to_zero

datatype Nat
| zero()
| succ(pred :: Nat)

function apply_to_zero(f :: Nat -> Nat) :: Nat:
  f(zero())

theorem lambda_param_type_inferred:
  apply_to_zero(function (n): succ(n)) === succ(zero())
