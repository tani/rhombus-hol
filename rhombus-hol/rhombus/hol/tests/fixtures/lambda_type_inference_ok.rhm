#lang rhombus/hol

// An anonymous function's parameter and result types are optional; the
// enclosing expected function type (`apply_to_zero`'s own `Nat -> Nat`)
// fills in whichever one is omitted. Verified by the theorems below
// proving: the lambda application must have carried the *correct*
// concrete type (`Nat`), not a leftover metavariable, for it to
// elaborate and reduce to the stated value.

export: Nat zero succ apply_to_zero

datatype Nat
| zero()
| succ(pred :: Nat)

function apply_to_zero(f :: Nat -> Nat) :: Nat:
  f(zero())

// Parameter type inferred from the expected function type.
theorem lambda_param_type_inferred:
  apply_to_zero(function (n): succ(n)) === succ(zero())

// Result type inferred the same way.
theorem lambda_result_type_inferred:
  apply_to_zero(function (n :: Nat): succ(n)) === succ(zero())
