#lang rhombus/hol
export: Nat zero succ pick

type Nat
| zero()
| succ(pred :: Nat)

// `pick(k)` runs unconditionally; the occurrence the equation keeps is under
// the `if`.  Two sites, not one.
function pick(n :: Nat, b :: Boolean) :: Nat:
  match n
  | zero(): zero()
  | succ(k):
      let x = pick(k, b)
      if b
      | x
      | zero()
