#lang rhombus/hol

// A local named function closes over its enclosing function's parameters,
// exactly as an ordinary nested lambda would: `bump`'s body is free in
// `offset`, bound by `add_offset`, not by `bump` itself.

export: Nat zero succ add_offset

datatype Nat
| zero()
| succ(pred :: Nat)

function add_offset(offset :: Nat) :: Nat:
  function bump(k :: Nat) :: Nat:
    succ(offset)
  bump(offset)
