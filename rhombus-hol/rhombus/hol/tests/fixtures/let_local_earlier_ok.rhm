#lang rhombus/hol

// A local named function may call an *earlier* local function in the same
// body -- only self- and forward-reference through local-function sugar are
// restricted.

export: Nat zero succ outer

datatype Nat
| zero()
| succ(pred :: Nat)

function outer(n :: Nat) :: Nat:
  function step(k :: Nat) :: Nat:
    succ(k)
  function twice(k :: Nat) :: Nat:
    step(step(k))
  twice(n)
