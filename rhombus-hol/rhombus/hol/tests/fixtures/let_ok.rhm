#lang rhombus/hol

// Local `let` bindings in a function body, at the surface (PLAN.md section
// 10, review item 8's first step, continued: the reflected subset admits
// `cond` and now local `let`). A multi-statement body must start with
// `let name = expr`; each `let` extends the elaboration environment for
// everything that follows, including a further nested `match`.

export:
  Nat
  zero
  succ
  bump
  two

type Nat
| zero()
| succ(pred :: Nat)

function bump(n :: Nat) :: Nat:
  match n
  | zero():
      let one = succ(zero())
      one
  | succ(k):
      let two = succ(succ(zero()))
      two

def two = succ(succ(zero()))

// Proved while this module compiles: `let`'s desugaring is a pure
// elaborator-level environment extension (no new HOL construct), so the
// bound name is just an ordinary already-elaborated term everywhere after.
theorem bump_zero:
  bump(zero()) === succ(zero())

theorem bump_succ:
  forall (k :: Nat): bump(succ(k)) === succ(succ(zero()))
