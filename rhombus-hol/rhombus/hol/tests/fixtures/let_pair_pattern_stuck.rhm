#lang rhombus/hol

// A `let` binder is not limited to a bare variable: `let Pair(a, b) = p`
// destructures through an irrefutable constructor pattern, matching the
// generalized-binder design used throughout logical binders. Reaches the
// correctly-elaborated stuck goal (only the separate, already-documented
// beta-reduction/generalization gap remains).

export: Nat zero succ add unwrap

datatype Nat
| zero()
| succ(pred :: Nat)

function add(x :: Nat, y :: Nat) :: Nat:
  match x
  | zero(): y
  | succ(k): succ(add(k, y))

function unwrap(p :: Pair.of(Nat, Nat)) :: Nat:
  let Pair(a, b) = p
  add(a, b)

theorem unwrap_zero:
  unwrap(Pair(zero(), zero())) === zero()
