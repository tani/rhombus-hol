#lang rhombus/hol

// The only recursive call is in a `let` initializer the body never reads.
//
// A `let` is substituted rather than bound, so that call vanishes from the
// logical reading -- the equation would be `!n. bad(n) = zero` and the
// termination check would see no recursion -- while the emitted Rhombus
// still evaluates it, and diverges.  Refused rather than elaborated.

export: Nat zero succ bad

type Nat
| zero()
| succ(pred :: Nat)

function bad(n :: Nat) :: Nat:
  let unused = bad(n)
  zero()
