#lang rhombus/hol

// The only recursive call is in a `let` initializer the body never reads,
// and it does not terminate.
//
// A `let` is substituted rather than bound, so the call is absent from the
// logical reading -- the equation is `!n. bad(n) = zero`.  It is present in
// the *evaluation* reading, which is the one termination is about
// (`core.rhm`), so the checker sees `bad(n)` recursing on `n` unchanged and
// refuses the declaration.

export: Nat zero succ bad

type Nat
| zero()
| succ(pred :: Nat)

function bad(n :: Nat) :: Nat:
  let unused = bad(n)
  zero()
