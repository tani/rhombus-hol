#lang rhombus/hol

// The same shape, but the body *uses* the initializer, so the recursive call
// survives into the equation and the termination check sees it.  This is the
// case the refusal above must not catch.

export: Nat zero succ dbl

type Nat
| zero()
| succ(pred :: Nat)

function dbl(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k):
      let rest = dbl(k)
      succ(succ(rest))
