#lang rhombus/hol

// The same shape, and the body uses the initializer, so the call is in both
// readings.

export: Nat zero succ dbl unread

type Nat
| zero()
| succ(pred :: Nat)

function dbl(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k):
      let rest = dbl(k)
      succ(succ(rest))

// And one the body does *not* use.  The call still descends, so it is
// checked and accepted: the rule is that the initializer's evaluation is an
// obligation, not that a recursive initializer is forbidden.
function unread(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k):
      let ignored = unread(k)
      succ(zero())
