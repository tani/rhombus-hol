#lang rhombus/hol
export: Nat zero succ g

type Nat
| zero()
| succ(pred :: Nat)

// Genuinely lexicographic: the first call shrinks the first argument while
// growing the second; the second leaves the first alone and shrinks the
// second.  No single column descends at every call.
function g(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): zero()
  | succ(p):
      match n
      | zero(): g(p, succ(succ(zero())))
      | succ(q): g(succ(p), q)
