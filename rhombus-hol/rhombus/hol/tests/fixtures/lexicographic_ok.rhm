#lang rhombus/hol

// Nested `match` flattens to a pattern matrix, and the matrix descends
// lexicographically.  Neither is possible with a single matched column and a
// single descending argument.

export:
  Nat
  zero
  succ
  ack
  merge
  List
  Nil
  Cons
  one
  two

type Nat
| zero()
| succ(pred :: Nat)

type List(~a)
| Nil()
| Cons(head :: ~a, tail :: List(~a))

// Ackermann: the inner call shrinks the second argument while leaving the
// first alone, and the outer calls shrink the first.  No single argument
// decreases at every call.
function ack(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): succ(n)
  | succ(p):
      match n
      | zero(): ack(p, succ(zero()))
      | succ(q): ack(p, ack(succ(p), q))

// Descends on whichever list it takes from -- neither argument alone.
function merge(xs :: List(Nat), ys :: List(Nat)) :: List(Nat):
  match xs
  | Nil(): ys
  | Cons(x, xr):
      match ys
      | Nil(): Cons(x, xr)
      | Cons(y, yr): Cons(x, Cons(y, merge(xr, yr)))

def one = succ(zero())
def two = succ(one)
