#lang rhombus/hol

type Nat
| zero()
| succ(pred :: Nat)

// `[zero, succ]` is missing: matching two columns means covering the product.
function f(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero():
      match n
      | zero(): zero()
  | succ(p):
      match n
      | zero(): zero()
      | succ(q): zero()
