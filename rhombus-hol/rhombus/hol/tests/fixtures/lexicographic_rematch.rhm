#lang rhombus/hol

export:
  Nat
  zero
  succ
  f

type Nat
| zero()
| succ(pred :: Nat)

// The inner `match n` names the field bound by `succ(n)`, not the parameter
// -- genuine nested matching, now supported.  `f` distinguishes 0, exactly
// 1, and 2-or-more, all collapsing to `zero()`.
function f(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(n):
      match n
      | zero(): zero()
      | succ(q): zero()
