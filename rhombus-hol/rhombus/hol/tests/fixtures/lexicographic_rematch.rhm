#lang rhombus/hol

type Nat
| zero()
| succ(pred :: Nat)

// The inner `match n` names the field bound by `succ(n)`, not the parameter.
// Matching that column again would silently discard the outer pattern.
function f(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(n):
      match n
      | zero(): zero()
      | succ(q): zero()
