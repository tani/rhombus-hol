#lang rhombus/hol

type Nat
| zero()
| succ(pred :: Nat)

// Matching `n` again in the `zero()` branch is a genuine re-match of the
// exact same, already-consumed position -- `zero()` binds no field to
// rename `n` to, so this is still refused, nested matching or not.
function f(n :: Nat) :: Nat:
  match n
  | zero():
      match n
      | zero(): zero()
      | succ(q): zero()
  | succ(p): p
