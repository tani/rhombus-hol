#lang rhombus/hol

// A `List.of(?a)` element type must be the same across every branch of a
// conditional. Here one branch builds a `List.of(Nat)` and the other a
// `List.of(MyBool)` -- both consistent with the *declared* result type
// `List.of(Nat)` only by accident of literal shape, but genuinely
// different runtime types. This must be rejected, not silently accepted
// by whichever branch happens to run.

datatype Nat
| zero()
| succ(pred :: Nat)

datatype MyBool
| mytrue()
| myfalse()

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

function pick(b :: Boolean) :: List.of(Nat):
  if b
  | cons(zero(), nil())
  | cons(mytrue(), nil())
