#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Weird
| w()

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

// A `[...]` list expression's element types still have to agree with the
// `if`'s other branch: checking the list structurally does not let an
// element escape ordinary unification.
function mismatched_list_expr_branch(b :: Boolean) :: List.of(Nat):
  if b
  | [w(), zero()]
  | [zero(), succ(zero())]
