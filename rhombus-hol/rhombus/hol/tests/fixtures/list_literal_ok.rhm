#lang rhombus/hol

// `[e, ...]` and `[e, ..., & tail]` are surface sugar for nested `cons`/`nil`
// application over whatever datatype provides them -- ordinary desugaring
// (`AGENTS.md` 1.2), not a builtin list type.

export: Nat zero succ List nil cons

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

theorem list_literal_multiple:
  [zero(), succ(zero())] === cons(zero(), cons(succ(zero()), nil()))

theorem list_literal_vars:
  forall (x :: Nat, y :: Nat):
    [x, y] === cons(x, cons(y, nil()))

theorem list_literal_empty:
  ([] :: List.of(Nat)) === nil()

theorem list_literal_tail_splice:
  forall (x :: Nat, rest :: List.of(Nat)):
    [x, & rest] === cons(x, rest)
