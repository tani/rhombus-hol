#lang rhombus/hol

// A local function (`g`) nested inside another local function (`f`),
// itself nested inside the top-level `outer`. Proves outright, confirming arbitrarily deep
// non-recursive local-function nesting elaborates soundly.

export: Nat zero succ nested_test

datatype Nat
| zero()
| succ(pred :: Nat)

function nested_test(x :: Nat) :: Nat:
  function f(y :: Nat) :: Nat:
    function g(z :: Nat) :: Nat:
      succ(z)
    g(g(y))
  f(x)

theorem nested_zero:
  nested_test(zero()) === succ(succ(zero()))
