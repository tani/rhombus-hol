#lang rhombus/hol

// `g`, declared after `f`, may call `f` (earlier local-function
// references are visible; see `local_mutual_recursion_bad.rhm` and
// `let_local_forward_bad.rhm` for the rejected converse). Proves outright.

export: Nat zero succ earlier_ref

datatype Nat
| zero()
| succ(pred :: Nat)

function earlier_ref(x :: Nat) :: Nat:
  function f(y :: Nat) :: Nat: succ(y)
  function g(y :: Nat) :: Nat: f(f(y))
  g(x)

theorem earlier_ref_zero:
  earlier_ref(zero()) === succ(succ(zero()))
