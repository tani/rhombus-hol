#lang rhombus/hol

// `outer`'s own top-level recursion (calling itself in tail position,
// outside of any local function) keeps working normally even though the
// same match branch also declares an unrelated named local function.
// Only a call *into* the currently-being-defined enclosing function *from
// inside* a local/anonymous function body is rejected (see
// `local_calls_enclosing_bad.rhm`); calls to `outer` alongside a local
// function, but not routed through it, are ordinary recursion -- verified
// by the theorem below proving outright.

export: Nat zero succ outer

datatype Nat
| zero()
| succ(pred :: Nat)

function outer(x :: Nat) :: Nat:
  match x
  | zero(): zero()
  | succ(k):
      function double(n :: Nat) :: Nat:
        succ(succ(n))
      double(outer(k))

theorem outer_one:
  outer(succ(zero())) === succ(succ(zero()))
