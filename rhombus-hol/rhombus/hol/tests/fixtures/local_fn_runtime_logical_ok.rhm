#lang rhombus/hol

// A local named function's *executable* Rhombus code and its *logical*
// HOL term are compiled from the same declaration, so the runtime and
// logical readings must agree: the runtime `fun` closure computes the
// same value the logical term equation asserts. This runs `outer` as an
// ordinary Rhombus function (see `local_fn_runtime_logical.rhm`) and
// separately proves the same equation logically:
// `(fun (x): succ(succ(x)))(succ(succ(zero)))
//  === succ(succ(succ(succ(zero))))`.

export: outer zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

function add(x :: Nat, y :: Nat) :: Nat:
  match x
  | zero(): y
  | succ(k): succ(add(k, y))

function outer(x :: Nat) :: Nat:
  function add_x(y :: Nat) :: Nat:
    add(x, y)
  add_x(x)

theorem outer_matches_double:
  outer(succ(succ(zero()))) === succ(succ(succ(succ(zero()))))
