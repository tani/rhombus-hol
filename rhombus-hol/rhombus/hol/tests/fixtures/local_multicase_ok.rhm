#lang rhombus/hol

// `function name | (pat1): body1 | (pat2): body2 ...` -- the case-clause
// form that omits an explicit parameter list and result type -- works for
// a named *local* function exactly as it does at the top level: each
// case's own patterns supply the parameters, and the (already-verified)
// omitted-type inference fills in both the parameter and result types.
// Verified by the lowered decision tree reducing to the stated value.

export: Nat zero succ outer

datatype Nat
| zero()
| succ(pred :: Nat)

function apply1(f :: Nat -> Nat, n :: Nat) :: Nat:
  f(n)

function outer(x :: Nat) :: Nat:
  function named_multicase
  | (zero()): zero()
  | (succ(k)): k
  apply1(named_multicase, x)

theorem named_multicase_zero:
  outer(zero()) === zero()
