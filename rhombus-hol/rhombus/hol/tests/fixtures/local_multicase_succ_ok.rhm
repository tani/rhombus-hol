#lang rhombus/hol

// Same as `local_multicase_ok.rhm`, exercising the successor case.

export: Nat zero succ outer

datatype Nat
| zero()
| succ(pred :: Nat)

function apply1(f :: Nat -> Nat, n :: Nat) :: Nat:
  f(n)

function outer(x :: Nat) :: Nat:
  function named_multicase
  | (zero()): zero()
  | (succ(k)): k
  apply1(named_multicase, x)

theorem named_multicase_succ:
  outer(succ(succ(zero()))) === succ(zero())
