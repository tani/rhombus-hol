#lang rhombus/hol

// Two local functions that call each other (`f` calls `g`, `g` calls `f`)
// are rejected. Local functions are processed in strict source order with
// no predeclaration, so this is caught by the same forward-reference rule
// as an ordinary unrelated forward reference: `f`'s initializer runs
// before `g` exists in scope.

datatype Nat
| zero()
| succ(pred :: Nat)

function outer(x :: Nat) :: Nat:
  function f(y :: Nat) :: Nat:
    g(y)
  function g(y :: Nat) :: Nat:
    f(y)
  f(x)
