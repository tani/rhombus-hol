#lang rhombus/hol

import:
  rhombus/meta open

export:
  Generated
  generated
  keep_generated
  sample

// HOL declarations produced by a user macro must participate in the same
// executable bindings and logical state as declarations written directly.
decl.macro 'declare_generated $type_name $constructor_name
                              $function_name $theorem_name':
  '«
     datatype $type_name:
     | $constructor_name()

     function $function_name(x :: $type_name) :: $type_name:
       x

     theorem $theorem_name:
       forall (x :: $type_name): $function_name(x) === x
   »'

declare_generated Generated generated keep_generated keep_generated_refl

// A directly written theorem observes all state changes made by the generated
// declarations, rather than seeing a separate expansion-time state.
theorem generated_state_is_visible:
  keep_generated(generated()) === generated()

def sample = keep_generated(generated())
