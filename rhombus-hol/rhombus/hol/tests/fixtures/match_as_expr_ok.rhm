#lang rhombus/hol

// A `match` used directly as a general expression value (compared with
// `===` in a theorem statement, not confined to a function body's tail
// position).
//
// This exercises `elaborate_match_expr_effect`'s "wanted" expected-type
// path, reached here through a metavariable generated by `===`'s
// bidirectional argument elaboration -- fixed to `resolve_type` the
// metavariable before checking clause bodies against it, matching the
// already-correct `CoreFunctionExpr` case. It proves outright because
// `prove_impl` beta-normalizes the goal before the waterfall runs, so
// the lambda the match compiles to is applied to its scrutinee first.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

theorem bare_match:
  (match zero()
   | zero(): succ(zero())
   | succ(_): zero()) === succ(zero())
