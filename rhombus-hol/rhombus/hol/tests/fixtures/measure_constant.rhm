#lang rhombus/hol

type Nat
| zero()
| succ(pred :: Nat)

function pred_of(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): k

// A measure that does not depend on the arguments cannot decrease.
function count(n :: Nat) :: Nat ~measure(zero()):
  match n
  | zero(): zero()
  | succ(k): succ(count(pred_of(succ(k))))
