#lang rhombus/hol

type Nat
| zero()
| succ(pred :: Nat)

function pred_of(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): k

// Same definition as `count` in `measure_ok.rhm`, without the measure.
function count(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): succ(count(pred_of(succ(k))))
