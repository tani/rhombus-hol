#lang rhombus/hol

// No column descends -- `red()` is not a constructor subterm of `green()` --
// so the definition rests on its `~measure`.  `Colour` is a datatype declared
// here, and it does not recurse, so it has no subterm relation for a measure
// to decrease in.  Refused, and not with an undeclared `Colour_lt`.
export: Colour red green Nat zero succ f
type Colour
| red()
| green()
type Nat
| zero()
| succ(pred :: Nat)
function f(c :: Colour, n :: Nat) :: Nat ~measure(c):
  match c
  | red(): zero()
  | green(): f(red(), n)
