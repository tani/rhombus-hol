#lang rhombus/hol

type Nat
| zero()
| succ(pred :: Nat)

function nul(n :: Nat) :: Boolean:
  match n
  | zero(): #true
  | succ(k): #false

function pred_of(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): k

// `Boolean` is not a declared datatype, so it has no subterm relation and
// nothing to descend in.
function count(n :: Nat) :: Nat ~measure(nul(n)):
  match n
  | zero(): zero()
  | succ(k): succ(count(pred_of(succ(k))))
