#lang rhombus/hol

export:
  Nat
  zero
  succ
  pred_of
  nul
  count
  down
  two

type Nat
| zero()
| succ(pred :: Nat)

function pred_of(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): k

function nul(n :: Nat) :: Boolean:
  match n
  | zero(): #true
  | succ(k): #false

// The recursion is on a *computed* argument, so no argument position is a
// constructor subterm of its pattern and the structural check cannot see it.
// The measure can: `pred_of(succ(k))` reduces to `k`, which is below `succ(k)`
// in `Nat_lt`.
function count(n :: Nat) :: Nat ~measure(n):
  match n
  | zero(): zero()
  | succ(k): succ(count(pred_of(succ(k))))

// Guarded recursion: the measure only decreases down the branch the guard
// admits, so the obligation is stated under the guard.  In the `zero` case the
// guard is contradictory and the obligation holds vacuously.
function down(n :: Nat) :: Nat ~measure(n):
  if nul(n) | zero() | succ(down(pred_of(n)))

def two = succ(succ(zero()))
