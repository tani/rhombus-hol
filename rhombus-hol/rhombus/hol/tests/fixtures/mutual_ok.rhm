#lang rhombus/hol

// A mutually recursive datatype family, two mutually recursive function
// families over it: the grouping forms in one module, proved and run while
// it compiles.

export:
  Expr
  Args
  lit
  app
  anil
  acons
  e_size
  a_size
  a_count
  even
  odd
  e_flat
  Nat
  zero
  succ
  plus
  peel
  family_zero
  Tone
  cold
  warm
  hot
  tone_value
  literal_value

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Tone
| cold()
| warm()
| hot()

function plus(m :: Nat, n :: Nat) :: Nat
| (zero(), n): n
| (succ(k), n): succ(plus(k, n))

// A field of either member may be at the other member: that is what makes
// the family mutually recursive.
datatype.together:
  datatype Expr
  | lit(value :: Nat)
  | app(args :: Args)
  datatype Args
  | anil()
  | acons(head :: Expr, tail :: Args)

// Mutually recursive with one result type. No member supplies a measure: the
// family descends structurally, one argument column per member, in the order
// its datatype family shares.
function.together:
  function e_size(e :: Expr) :: Nat
  | (lit(n)): succ(zero())
  | (app(a)): succ(a_size(a))
  function a_size(a :: Args) :: Nat
  | (anil()): zero()
  | (acons(e, r)): plus(e_size(e), a_size(r))

// Mutually recursive with *different* result types, which the family tags
// internally and the derived equations hide again.
function.together:
  function a_count(a :: Args) :: Nat
  | (anil()): zero()
  | (acons(e, r)):
      if e_flat(e)
      | a_count(r)
      | succ(a_count(r))
  function e_flat(e :: Expr) :: Boolean
  | (lit(n)): #false
  | (app(a)): a_count(a) == zero()

// Every member supplies its own measure, so the family descends in the
// measure's type instead of in an argument column.
function.together:
  function even(n :: Nat) :: Boolean
  | (zero()): #true
  | (succ(m)): odd(m)
  proof:
    ~measure: n
  function odd(n :: Nat) :: Boolean
  | (zero()): #false
  | (succ(m)): even(m)
  proof:
    ~measure: n

// An inactive zero-argument member needs no termination-order column. The
// recursive member still descends structurally in `Nat`.
function.together:
  function peel(n :: Nat) :: Nat
  | (zero()): zero()
  | (succ(k)): peel(k)
  function family_zero() :: Nat: zero()

// A one-member explicit family still preserves every refined leaf of an
// ordered catch-all: the second row owns both `warm` and `hot`.
function.together:
  function tone_value(tone :: Tone) :: Nat
  | (cold()): zero()
  | (_): succ(zero())

// A literal default leaf carries a guard through member-equation derivation.
function.together:
  function literal_value(n :: Nat) :: Nat
  | (0): zero()
  | (_): succ(zero())

// Each member's own clausal equations are what a proof sees.
theorem size_nil:
  a_size(anil()) === zero()

theorem size_lit:
  forall (n :: Nat): e_size(lit(n)) === succ(zero())

theorem flat_of_lit:
  forall (n :: Nat): not e_flat(lit(n))

theorem count_of_lit:
  forall (r :: Args): a_count(acons(lit(zero()), r)) === succ(a_count(r))

theorem even_two:
  even(succ(succ(zero())))

theorem peel_one:
  peel(succ(zero())) === zero()

theorem family_zero_eq:
  family_zero() === zero()

theorem tone_cold:
  tone_value(cold()) === zero()

theorem tone_warm:
  tone_value(warm()) === succ(zero())

theorem tone_hot:
  tone_value(hot()) === succ(zero())

theorem literal_zero:
  literal_value(zero()) === zero()

theorem literal_one:
  literal_value(succ(zero())) === succ(zero())

// A member of the family is an ordinary datatype: its constructors are
// injective and distinct, and every value is built by one of them.
theorem app_injective:
  forall (a :: Args, b :: Args): (app(a) === app(b)) <=> (a === b)

theorem lit_is_not_app:
  forall (n :: Nat, a :: Args): not (lit(n) === app(a))

theorem expr_exhaustive:
  forall (e :: Expr): is_lit(e) or is_app(e)

definition empty_args :: Args: anil()

definition zero_expr :: Expr: lit(zero())

def marker = "compiled"
