#lang rhombus/hol

// A logical body may not reach a constant through an import alias: the
// elaborator resolves bare identifiers only, so `a.Nat` is not a type it
// can read, and the declaration is refused rather than quietly given a
// meaning the runtime does not share.

import: "name_shadow_ok.rhm" as a

function viaAlias(n :: a.Nat) :: a.Nat:
  a.twice(n)
