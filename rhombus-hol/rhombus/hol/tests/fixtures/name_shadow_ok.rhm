#lang rhombus/hol

// A local binding whose name is also a logical constant's.  The elaborator
// resolves names against its own environment of binders first, so this must
// mean the local `twice`, and the equation registered for `trap` must be
// `trap(x) = x` -- not something about the constant `twice`.

export: Nat zero succ twice trap

type Nat
| zero()
| succ(pred :: Nat)

function twice(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): succ(succ(twice(k)))

function trap(n :: Nat) :: Nat:
  let twice = n
  twice
