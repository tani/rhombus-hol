#lang rhombus/hol

// Nested constructor patterns genuinely support matching further into a field
// already destructured by an enclosing pattern, not just matching multiple
// arguments one level deep.

export:
  Nat
  zero
  succ
  List
  Nil
  Cons
  classify
  sample0
  sample1
  sample2

type Nat
| zero()
| succ(pred :: Nat)

type List(?a)
| Nil()
| Cons(head :: ?a, tail :: List(?a))

// A single argument, three clauses, the last two nested one level into the
// tail `Cons(x, tail)` already bound: distinguishes length 0, exactly 1, and
// 2-or-more.
function classify(xs :: List(?a)) :: Nat:
  match xs
  | Nil(): zero()
  | Cons(x, Nil()): succ(zero())
  | Cons(x, Cons(y, rest)): succ(succ(zero()))

def sample0 = Nil()
def sample1 = Cons(1, Nil())
def sample2 = Cons(1, Cons(2, Nil()))

expect [Nat, Nat_lt, List, List_lt, classify]
