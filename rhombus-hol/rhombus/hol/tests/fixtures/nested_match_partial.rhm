#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| Nil()
| Cons(head :: ?a, tail :: List.of(?a))

// Missing the 2-or-more-element case: `Cons(x, Cons(y, rest))` is never
// covered.
function classify(xs :: List.of(?a)) :: Nat:
  match xs
  | Nil(): zero()
  | Cons(x, Nil()): succ(zero())
