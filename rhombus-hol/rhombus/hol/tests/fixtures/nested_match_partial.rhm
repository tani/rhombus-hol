#lang rhombus/hol

type Nat
| zero()
| succ(pred :: Nat)

type List(~a)
| Nil()
| Cons(head :: ~a, tail :: List(~a))

// Missing the 2-or-more-element case: `Cons(x, Cons(y, rest))` is never
// covered.
function classify(xs :: List(~a)) :: Nat:
  match xs
  | Nil(): zero()
  | Cons(x, Nil()): succ(zero())
