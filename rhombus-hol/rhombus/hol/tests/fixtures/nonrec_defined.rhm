#lang rhombus/hol
export: Colour red green Pair MkPair swap idc classify

type Colour
| red()
| green()

type Pair
| MkPair(fst :: Colour, snd :: Colour)

// no patterns at all
function idc(c :: Colour) :: Colour:
  c

// one clause, constructor pattern
function swap(p :: Pair) :: Pair:
  match p
  | MkPair(a, b): MkPair(b, a)

// several clauses over a nested pattern, with a catch-all
function classify(p :: Pair) :: Colour:
  match p
  | MkPair(red(), b): b
  | MkPair(a, _): a
