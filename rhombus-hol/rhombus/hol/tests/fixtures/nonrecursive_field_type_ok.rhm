#lang rhombus/hol

// A non-recursive, field-carrying `type` -- unlike every other fixture's
// `Nat`/`List`/`Tree` (all self-recursive), `driver.rhm`'s `add_type` routes
// this one through `build_nonrecursive_datatype_thms` (`datatype_gen.rhm`).
// A real `#lang rhombus/hol` module cannot distinguish its derived theorem
// bundle from the contract checked against the test-only oracle.
// `swap_twice` uses the derived `injectivity`/`elim_rules`.

export:
  Pair
  MkPair
  swap

type Pair
| MkPair(fst :: Boolean, snd :: Boolean)

function swap(p :: Pair) :: Pair:
  match p
  | MkPair(a, b): MkPair(b, a)

theorem ~rewrite_rule swap_twice:
  forall (p :: Pair): swap(swap(p)) === p

// The derived `injectivity` theorem itself, stated the way a user would
// write it, proved by default automation rewriting through it.
theorem mkpair_injective:
  forall (a :: Boolean, b :: Boolean, c :: Boolean, d :: Boolean):
    MkPair(a, b) === MkPair(c, d) <=> (a === c and b === d)
