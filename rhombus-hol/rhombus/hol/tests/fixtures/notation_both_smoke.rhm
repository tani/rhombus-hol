#lang rhombus/hol

export: both <+>

notation (x <+> y):
  ~runtime: x && y
  ~logic: conj(x, y)
  ~order: hol_conjunction

function both(x :: Boolean, y :: Boolean) :: Boolean:
  x <+> y

theorem both_true:
  both(true, true) === true

theorem both_false:
  both(true, false) === false

expect [both, both_true, both_false]
