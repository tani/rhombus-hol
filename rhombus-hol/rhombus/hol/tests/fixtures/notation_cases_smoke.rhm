#lang rhombus/hol

export: postfix_function

notation <~>:
  ~order: hol_conjunction
| <~> value:
    neg
| left <~> right:
    conj

theorem prefix_operator_case:
  <~> false

theorem infix_operator_case:
  true <~> true

notation
| <%> value:
    ~order: hol_negation
    neg
| left <%> right:
    ~order: hol_conjunction
    conj

theorem immediate_prefix_operator_case:
  <%> false

theorem immediate_infix_operator_case:
  true <%> true

function keep(value :: Boolean) :: Boolean:
  value

notation value <!>:
  ~order: hol_negation
  keep


function postfix_function(value :: Boolean) :: Boolean:
  value <!>

theorem postfix_operator_case:
  postfix_function(true) === true
