#lang rhombus/hol

import:
  "notation_both_smoke.rhm" open

export: imported runtime_value

def runtime_value = #true <+> #false

function imported(x :: Boolean, y :: Boolean) :: Boolean:
  x <+> y

theorem imported_true:
  imported(true, true) === true

expect [both, both_true, both_false, imported, imported_true]
