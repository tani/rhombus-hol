#lang rhombus/hol

// Two datatypes both admit a zero-numeral reading (`zero()`/`pos(zero())`),
// so a bare `0` with no type ascription and no other constraint is
// genuinely ambiguous and must be rejected, not silently defaulted to
// whichever datatype happened to be declared first.

datatype Nat
| zero()
| succ(pred :: Nat)

datatype MyInt
| pos(n :: Nat)
| negative(n :: Nat)

theorem ambiguous_numeral:
  0 === 0
