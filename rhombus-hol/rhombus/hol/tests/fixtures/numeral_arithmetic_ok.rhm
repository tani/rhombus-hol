#lang rhombus/hol

// Closed arithmetic on numeral literals. Every theorem here is about numbers
// far too large to reach by unfolding `succ` one at a time: what proves them
// is the digit arithmetic in `number/`, which the module gets simply by
// declaring Peano addition.

export: Nat zero succ nat_add nat_mul nat_le nat_lt

datatype Nat
| zero()
| succ(predecessor :: Nat)

function nat_add(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(nat_add(k, n))

function nat_mul(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): zero()
  | succ(k): nat_add(n, nat_mul(k, n))

function nat_le(m :: Nat, n :: Nat) :: Boolean:
  match m
  | zero(): #true
  | succ(a):
      match n
      | zero(): #false
      | succ(b): nat_le(a, b)

function nat_lt(m :: Nat, n :: Nat) :: Boolean:
  nat_le(succ(m), n)

// -- addition ---------------------------------------------------------------

theorem add_small:
  nat_add(2, 3) === (5 :: Nat)

theorem add_zero_literal:
  nat_add(0, 41) === (41 :: Nat)

theorem add_literal_zero:
  nat_add(41, 0) === (41 :: Nat)

theorem add_carries:
  nat_add(511, 1) === (512 :: Nat)

theorem add_big:
  nat_add(123456, 654321) === (777777 :: Nat)

// -- multiplication ---------------------------------------------------------

theorem mul_small:
  nat_mul(6, 7) === (42 :: Nat)

theorem mul_by_zero:
  nat_mul(123456, 0) === (0 :: Nat)

theorem mul_by_one:
  nat_mul(1, 123456) === (123456 :: Nat)

theorem mul_big:
  nat_mul(123456, 654321) === (80779853376 :: Nat)

// -- equality ---------------------------------------------------------------

theorem equal_big:
  (80779853376 :: Nat) === 80779853376

theorem not_equal_big:
  not ((123456 :: Nat) === 654321)

theorem not_equal_adjacent:
  not ((123456 :: Nat) === 123457)

theorem not_equal_zero:
  not ((0 :: Nat) === 1)

// -- comparison -------------------------------------------------------------

theorem le_true:
  nat_le(123456, 654321)

theorem le_equal:
  nat_le(999, 999)

theorem le_false:
  not nat_le(654321, 123456)

theorem lt_true:
  nat_lt(123456, 123457)

theorem lt_false:
  not nat_lt(123457, 123456)

theorem lt_irreflexive_at_literal:
  not nat_lt(123456, 123456)

// -- arithmetic inside a larger statement -----------------------------------

theorem nested:
  nat_add(nat_mul(111, 111), 1) === (12322 :: Nat)

theorem conditional:
  (if nat_le(2, 3) | nat_add(2, 3) | 0) === (5 :: Nat)
