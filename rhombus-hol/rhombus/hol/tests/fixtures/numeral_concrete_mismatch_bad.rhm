#lang rhombus/hol

// A numeral whose type is already decided, and decided as a type with
// no numeral representation at all -- neither `Nat`, `Integer`, nor
// `Rational`. Distinct from the ambiguous case
// (`numeral_ambiguous_bad.rhm`), where nothing decides the type: here
// the type is known, so the diagnostic names it rather than asking for
// an ascription.

datatype Nat
| zero()
| succ(pred :: Nat)

function numeral_at_boolean(x :: Boolean) :: Boolean:
  if x
  | 1
  | #false
