#lang rhombus/hol

// A numeral whose expected type is already resolved to a concrete type
// that has no numeral representation at all -- neither `Nat`, `Integer`,
// nor `Rational`. This is distinct from the ambiguous case
// (`numeral_ambiguous_bad.rhm`): nothing here is undetermined, so the
// diagnostic names the offending type rather than asking for an
// ascription.
//
// `check_expr` (checked_core.rhm) deliberately defers exactly this one
// numeral rejection to its `fallback`, because the message formats the
// type through the type constructor registry -- a capability that
// Theory-free shared pass does not have. The other two numeral
// rejections report directly through its `~error` capability.

datatype Nat
| zero()
| succ(pred :: Nat)

function numeral_at_boolean(x :: Boolean) :: Boolean:
  if x
  | 1
  | #false
