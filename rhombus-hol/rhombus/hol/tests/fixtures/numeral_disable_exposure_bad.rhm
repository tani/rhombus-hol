#lang rhombus/hol

// Constructor exposure for a compact literal must not consult a definition
// that the active proof scope disabled.

datatype Nat
| zero()
| succ(pred :: Nat)

function double(n :: Nat) :: Nat
| (zero()): zero()
| (succ(k)): succ(succ(double(k)))

theorem disabled_literal_exposure:
  double(3) === (6 :: Nat)
proof:
  ~disable: [double]
