#lang rhombus/hol

// A module that declares Peano naturals but no addition. It has nothing to
// define the digit constants from, so its literals stay `succ` chains -- the
// representation the language had before -- and everything about them still
// works, just at unary cost.

export: Nat zero succ classify

datatype Nat
| zero()
| succ(pred :: Nat)

function classify(n :: Nat) :: Nat:
  match n
  | 0: zero()
  | 1: succ(zero())
  | _: succ(succ(zero()))

theorem small_literal:
  (3 :: Nat) === succ(succ(succ(zero())))

theorem classify_one:
  classify(1) === (1 :: Nat)
