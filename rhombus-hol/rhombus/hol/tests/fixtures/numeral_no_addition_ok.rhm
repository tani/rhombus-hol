#lang rhombus/hol

// A module that declares Peano naturals and nothing else. Its literals are
// still compact native NatLit terms, and equality between them is still
// decided from the native datatype evidence.
//
// What such a module does not get is arithmetic: there is no addition here to
// compute with.

export: Nat zero succ classify

datatype Nat
| zero()
| succ(pred :: Nat)

function classify(n :: Nat) :: Nat:
  match n
  | 0: zero()
  | 1: succ(zero())
  | _: succ(succ(zero()))

theorem small_literal:
  (3 :: Nat) === succ(succ(succ(zero())))

theorem classify_one:
  classify(1) === (1 :: Nat)

// Numbers far past what a `succ` chain could reach, with no arithmetic in the
// module at all.
theorem big_literal_reflexive:
  (123456 :: Nat) === 123456

theorem big_literals_differ:
  not ((123456 :: Nat) === 654321)

theorem adjacent_literals_differ:
  not ((800 :: Nat) === 799)

theorem successor_of_literal:
  succ(799) === (800 :: Nat)
