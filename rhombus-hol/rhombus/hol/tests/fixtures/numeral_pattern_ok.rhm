#lang rhombus/hol

// Numeral patterns remain atomic through decision-tree compilation and use
// checked literal-equality guards. They participate in exhaustiveness and
// recursive congruence proofs like constructor patterns.

export: Nat zero succ classify List Nil Cons strip_literals

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a):
| Nil
| Cons(head :: ?a, tail :: List.of(?a))

function classify(n :: Nat) :: Nat:
  match n
  | 0: zero()
  | 1: succ(zero())
  | _: succ(succ(zero()))

theorem classify_zero:
  classify(zero()) === zero()
theorem classify_one:
  classify(succ(zero())) === succ(zero())
theorem classify_two:
  classify(succ(succ(zero()))) === succ(succ(zero()))

function strip_literals(xs :: List.of(Nat)) :: Nat
| (Nil()): 0
| (Cons(0, tail)): succ(strip_literals(tail))
| (Cons(1, tail)): strip_literals(tail)
| (Cons(_, tail)): strip_literals(tail)

theorem strip_literal_branches:
  strip_literals(Cons((0 :: Nat), Cons((1 :: Nat), Nil()))) === (1 :: Nat)
