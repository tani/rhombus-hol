#lang rhombus/hol

// A numeral pattern (`0`, `1`, ...) is type-directed sugar for the matched
// constructor chain -- `0` for `zero()`, `1` for `succ(zero())`, and so on
// over whatever datatype the scrutinee's type names -- checked for totality
// exactly like any other constructor pattern.

export: Nat zero succ classify

datatype Nat
| zero()
| succ(pred :: Nat)

function classify(n :: Nat) :: Nat:
  match n
  | 0: zero()
  | 1: succ(zero())
  | _: succ(succ(zero()))

theorem classify_zero:
  classify(zero()) === zero()
theorem classify_one:
  classify(succ(zero())) === succ(zero())
theorem classify_two:
  classify(succ(succ(zero()))) === succ(succ(zero()))
