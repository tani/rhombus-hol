#lang rhombus/hol

// A user-defined Rhombus operator has no logical interpretation, so it may
// not appear in a `function` body.  Refusing it is the whole safety property
// behind review item 10: an operator the elaborator cannot read must not be
// given some default meaning, because the emitted Rhombus would compute
// something else.

export: Nat zero succ f

type Nat
| zero()
| succ(pred :: Nat)

operator (x <+> y):
  x

function f(n :: Nat) :: Nat:
  n <+> n
