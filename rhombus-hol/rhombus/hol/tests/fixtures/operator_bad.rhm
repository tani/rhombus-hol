#lang rhombus/hol

// A Rhombus runtime operator has no logical interpretation, so it may not
// appear in a `function` body. The elaborator must not invent a default
// meaning, because the emitted Rhombus would compute something else.

export: Nat zero succ f

type Nat
| zero()
| succ(pred :: Nat)

operator (x <+> y):
  x

function f(n :: Nat) :: Nat:
  n <+> n
