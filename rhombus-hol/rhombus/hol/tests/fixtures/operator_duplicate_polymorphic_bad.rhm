#lang rhombus/hol

type Box.of(?element):
| box(value :: ?element)

function box_append(x :: Box.of(?element),
                    _y :: Box.of(?element)) :: Box.of(?element):
  x

dispatch append(Box.of(?left), Box.of(?left)) = box_append

dispatch append(Box.of(?right), Box.of(?right)) = box_append
