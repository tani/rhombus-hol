#lang rhombus/hol

export:
  custom_runtime_add
  custom_runtime_member
  custom_runtime_add_alias
  custom_runtime_negate
  custom_runtime_reversed

import: "operator_runtime_ok.rhm" open

notation CustomAdd (left <+> right):
  syntax (left <++> right)
  ~order: hol_addition
  ~associativity: ~left

notation CustomNegate (!! value):
  ~order: hol_prefix_arithmetic

notation CustomCompare (left <*> right):
  ~order: hol_relation
  ~associativity: ~none

dispatch CustomAdd(Tiny, Tiny) = tiny_add

function custom_runtime_add(a :: Tiny, b :: Tiny) :: Tiny:
  a <+> b

function custom_runtime_add_alias(a :: Tiny, b :: Tiny) :: Tiny:
  a <++> b

function tiny_negate(x :: Tiny) :: Tiny:
  x

dispatch CustomNegate(Tiny) = tiny_negate

function custom_runtime_negate(x :: Tiny) :: Tiny:
  !! x

function tiny_first_is_zero(x :: Tiny, y :: Tiny) :: Boolean
| (tiny_zero(), y): #true
| (tiny_succ(previous), y): #false

dispatch CustomCompare(left :: Tiny, right :: Tiny):
  tiny_first_is_zero(right, left)

function custom_runtime_reversed(left :: Tiny, right :: Tiny) :: Boolean:
  left <*> right

function tiny_set_member(s :: Tiny -> Boolean, x :: Tiny) :: Boolean:
  s(x)

dispatch Membership(
  element :: Tiny,
  collection :: Tiny -> Boolean
):
  tiny_set_member(collection, element)

function custom_runtime_member(x :: Tiny,
                               s :: Tiny -> Boolean) :: Boolean:
  x in s

theorem custom_operator_resolves:
  forall (a :: Tiny, b :: Tiny): a <+> b === tiny_add(a, b)

theorem custom_operator_alias_resolves:
  forall (a :: Tiny, b :: Tiny): a <++> b === tiny_add(a, b)

theorem custom_prefix_operator_resolves:
  forall (x :: Tiny): !! x === tiny_negate(x)

theorem custom_reversed_provider_resolves:
  forall (left :: Tiny, right :: Tiny):
    (left <*> right) <=> tiny_first_is_zero(right, left)

theorem custom_membership_permutation:
  forall (x :: Tiny, s :: Tiny -> Boolean):
    (x in s) <=> tiny_set_member(s, x)
