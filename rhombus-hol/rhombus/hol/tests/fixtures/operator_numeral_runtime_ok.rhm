#lang rhombus/hol

export:
  Nat
  zero
  succ
  nat_add
  runtime_two
  runtime_choose
  runtime_sum
  runtime_equal_two

datatype Nat:
| zero
| succ(previous :: Nat)

function nat_add(x :: Nat, y :: Nat) :: Nat
| (zero(), y): y
| (succ(previous), y): succ(nat_add(previous, y))

overload add(Nat, Nat) = nat_add

function runtime_two() :: Nat:
  2

function runtime_choose(p :: Boolean) :: Nat:
  if p | 1 | 2

function runtime_sum() :: Nat:
  1 + 2

function runtime_equal_two(n :: Nat) :: Boolean:
  n + 1 == 2
