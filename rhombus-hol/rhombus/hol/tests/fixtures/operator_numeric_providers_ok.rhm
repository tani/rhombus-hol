#lang rhombus/hol

export:
  Integer
  int_from_nat
  int_add
  int_negate
  runtime_negative_one

import: "operator_numeral_runtime_ok.rhm" open

type Integer:
| int_from_nat(magnitude :: Nat)

function int_add(x :: Integer, _y :: Integer) :: Integer:
  x

function int_negate(x :: Integer) :: Integer:
  x

operator Add for Integer:
  int_add

operator Negate for Integer:
  int_negate

function runtime_negative_one() :: Integer:
  -1
