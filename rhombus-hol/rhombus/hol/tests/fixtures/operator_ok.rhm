#lang rhombus/hol

// Rhombus's runtime `operator` remains available beside logical definitions.
// The HOL declaration planner leaves it untouched.

export: Nat zero succ g dbl

datatype Nat
| zero()
| succ(pred :: Nat)

operator (x <+> y):
  x

fun g(n): n <+> n

function dbl(n :: Nat) :: Nat
| zero(): zero()
| succ(k): succ(succ(dbl(k)))
