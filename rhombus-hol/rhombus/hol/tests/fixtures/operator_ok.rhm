#lang rhombus/hol

// Runtime-only notation remains available beside logical definitions. The
// logical parser rejects it only when a `function` body tries to use it.

export: Nat zero succ g dbl

type Nat
| zero()
| succ(pred :: Nat)

notation (x <+> y):
  ~runtime: x
  ~order: hol_addition

fun g(n): n <+> n

function dbl(n :: Nat) :: Nat
| zero(): zero()
| succ(k): succ(succ(dbl(k)))
