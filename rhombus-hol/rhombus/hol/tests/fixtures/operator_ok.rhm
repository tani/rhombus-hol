#lang rhombus/hol

// The same operator, in the same module, outside a `function`: ordinary
// Rhombus is untouched.  `#lang rhombus/hol` restricts what a *logical*
// definition may say, not what the module may contain.

export: Nat zero succ g dbl

type Nat
| zero()
| succ(pred :: Nat)

operator (x <+> y):
  x

fun g(n): n <+> n

function dbl(n :: Nat) :: Nat
| zero(): zero()
| succ(k): succ(succ(dbl(k)))
