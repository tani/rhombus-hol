#lang rhombus/hol

export:
  Tiny
  tiny_zero
  tiny_succ
  tiny_add
  add_one

type Tiny:
| tiny_zero
| tiny_succ(previous :: Tiny)

function tiny_add(x :: Tiny, y :: Tiny) :: Tiny
| (tiny_zero(), y): y
| (tiny_succ(previous), y): tiny_succ(tiny_add(previous, y))

notation Add for Tiny:
  tiny_add

function add_one(x :: Tiny) :: Tiny:
  x + tiny_succ(tiny_zero())

theorem add_one_lowering:
  forall (x :: Tiny): add_one(x) === tiny_add(x, tiny_succ(tiny_zero()))
