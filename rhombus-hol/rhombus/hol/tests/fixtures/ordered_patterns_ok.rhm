#lang rhombus/hol

// Wildcards and ordered clauses.
export:
  Nat zero succ List Nil Cons is_singleton nul first_two

type Nat
| zero()
| succ(pred :: Nat)
type List(?a)
| Nil()
| Cons(head :: ?a, tail :: List(?a))

// `_` inside a constructor pattern: the position is matched but not named.
function is_singleton(xs :: List(?a)) :: Nat:
  match xs
  | Nil(): zero()
  | Cons(x, Nil()): succ(zero())
  | Cons(x, Cons(y, _)): zero()

// A catch-all clause head after a specific case: first match wins, so the
// `_` clause stands for `succ(k)` alone.
function nul(n :: Nat) :: Nat:
  match n
  | zero(): succ(zero())
  | _: zero()

// Both at once, on a nested position.
function first_two(xs :: List(Nat)) :: Nat:
  match xs
  | Cons(x, Cons(y, _)): succ(succ(zero()))
  | _: zero()
