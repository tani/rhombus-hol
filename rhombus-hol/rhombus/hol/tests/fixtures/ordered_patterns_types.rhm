#lang rhombus/hol

// The same two datatypes as `ordered_patterns_ok.rhm` and nothing else, so
// that the axiom counts of the two can be compared: the difference is what
// the three functions cost, which is nothing.
export:
  Nat zero succ List Nil Cons

type Nat
| zero()
| succ(pred :: Nat)
type List(?a)
| Nil()
| Cons(head :: ?a, tail :: List(?a))
