#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Weird
| w()

// A `Pair` expression's element types still have to agree with the `if`'s
// other branch: checking the pair structurally does not let its elements
// escape ordinary unification.
function mismatched_pair_branch(b :: Boolean) :: Pair.of(Nat, Nat):
  if b
  | Pair(w(), zero())
  | Pair(zero(), succ(zero()))
