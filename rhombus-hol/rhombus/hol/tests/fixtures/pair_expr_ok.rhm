#lang rhombus/hol

// `Pair(a, b)` must elaborate correctly even when nothing outside it
// supplies an expected type -- `elaborate_pair_effect`'s own inferred type
// is the only information available at `===`, whose two sides are each
// elaborated independently.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

theorem pair_expr_no_external_context:
  Pair(zero(), succ(zero())) === Pair(zero(), succ(zero()))
