#lang rhombus/hol

// `quickcheck` drawing from datatypes declared in the same module.

export:
  plus
  nat_is_zero
  length
  Nat
  zero
  succ
  List
  Nil
  Cons

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| Nil()
| Cons(head :: ?a, tail :: List.of(?a))

function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))

function nat_is_zero(n :: Nat) :: Boolean:
  match n
  | zero(): #true
  | succ(k): #false

function length(xs :: List.of(?a)) :: Nat:
  match xs
  | Nil(): zero()
  | Cons(x, rest): succ(length(rest))

overload add(Nat, Nat) = plus

// The property uses exactly the HOL proposition later accepted by `theorem`.
quickcheck plus_commutative(~samples: 150):
  forall (m :: Nat, n :: Nat):
    m + n === n + m

quickcheck excluded_middle(~samples: 120):
  forall (n :: Nat):
    nat_is_zero(n) or not nat_is_zero(n)

quickcheck implication_property(~samples: 120):
  forall (n :: Nat):
    nat_is_zero(n) ==> n === zero()
