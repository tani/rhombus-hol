#lang rhombus/hol

// `check_property` drawing from datatypes declared in the same module, and a
// property whose counterexample needs shrinking.

export:
  plus_comm_holds
  plus_wrong
  big_wrong
  Nat
  zero
  succ
  List
  Nil
  Cons

type Nat
| zero()
| succ(pred :: Nat)

type List(~a)
| Nil()
| Cons(head :: ~a, tail :: List(~a))

function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))

function length(xs :: List(~a)) :: Nat:
  match xs
  | Nil(): zero()
  | Cons(x, rest): succ(length(rest))

// true, but not provable by rewriting alone -- random checking is cheap
check_property plus_comm_holds(~samples: 150):
  forall (m :: Nat, n :: Nat):
    plus(m, n) === plus(n, m)

// false: `plus(m, n)` is not `m`
check_property plus_wrong(~samples: 200):
  forall (m :: Nat, n :: Nat):
    plus(m, n) === m

// false, and the first counterexample found is large: shrinking has work to do
check_property big_wrong(~samples: 200, ~size: 8):
  forall (xs :: List(Nat)):
    length(xs) === zero()
