#lang rhombus/hol

// `quickcheck` runs the executable reading of a HOL proposition, so the
// proposition itself (not just the functions it calls) may use ordinary
// executable constructs: `if` guarding a match-defined function's
// result, and `block: let ... ; ...` binding an intermediate value.

export: Nat zero succ classify

datatype Nat
| zero()
| succ(pred :: Nat)

function classify(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(_): succ(zero())

quickcheck classify_range(~samples: 50):
  forall (n :: Nat):
    if classify(n) === zero() | n === zero() | classify(n) === succ(zero())

quickcheck let_in_property(~samples: 50):
  forall (n :: Nat):
    block:
      let doubled = succ(succ(n))
      doubled === succ(succ(n))
