#lang rhombus/hol

// Two self-recursive datatypes in one module.  Both are *derived* now
// (`datatype_rec.rhm`, wired from `driver.rhm`), so what the module's theory
// still assumes is only the shared infinity axiom and each type's subterm
// relation -- not the characterisations.

export: Nat zero succ List Nil Cons

type Nat
| zero()
| succ(pred :: Nat)

type List(~a)
| Nil()
| Cons(head :: ~a, tail :: List(~a))
