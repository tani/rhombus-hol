#lang rhombus/hol

// Proof-local `use` installs a named theorem only for that proof.
//
// `twice` needs `plus_zero_r` as a rewrite and is forbidden from inducting.
// It therefore succeeds only when `use` adds the theorem to its temporary
// RuleDB; `plus_zero_r` was not registered globally.

export: Nat zero succ plus
type Nat
| zero()
| succ(pred :: Nat)
function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))
theorem plus_zero_r: forall (n :: Nat): plus(n, zero()) === n
proof:
  ~induct: n
theorem twice: forall (n :: Nat): plus(plus(n, zero()), zero()) === n
proof:
  ~use: [plus_zero_r]
  ~skip: [induct]
