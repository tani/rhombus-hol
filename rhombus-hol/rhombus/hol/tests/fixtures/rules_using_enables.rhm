#lang rhombus/hol

// `disable_rules` and `~using`.
//
// Two things this pins.  `disable_rules` is a declaration form the grammar
// accepts and the docs describe, and it used to fail to expand at all --
// `rule_step` returned two values where the emitter wants three, and nothing
// in the suite used the form.  And `~using` is documented as overriding a
// module-level `disable_rules`, which it did not do: registering the theorem
// left it disabled.
//
// `twice` needs `plus_zero_r` as a rewrite and is forbidden from inducting,
// so it goes through only if the override is real.

export: Nat zero succ plus
type Nat
| zero()
| succ(pred :: Nat)
function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))
theorem plus_zero_r: forall (n :: Nat): plus(n, zero()) === n
proof: auto ~induct: n
disable_rules [plus_zero_r]
// Needs `plus_zero_r` as a rewrite, and induction is forbidden, so the proof
// goes through only if `~using` really re-enabled the disabled rule.
theorem twice: forall (n :: Nat): plus(plus(n, zero()), zero()) === n
proof: auto(~using: [plus_zero_r], ~do_not: [induct])
