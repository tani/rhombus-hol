#lang rhombus/hol
export: Nat zero succ plus

type Nat
| zero()
| succ(pred :: Nat)

function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))

// Raising the ceiling.  This proof does not need it; what the fixture shows
// is that asking for more is accepted and does not change the outcome.
theorem plus_zero_l: forall (n :: Nat): plus(zero(), n) === n
proof: auto(~search_steps: 500000)
