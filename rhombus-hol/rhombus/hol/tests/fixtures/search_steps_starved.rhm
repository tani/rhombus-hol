#lang rhombus/hol
export: Nat zero succ plus

type Nat
| zero()
| succ(pred :: Nat)

function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))

// Three steps is not enough for anything, and running out is a resource
// error at this declaration rather than a proof that quietly fails.
theorem starved: forall (n :: Nat): plus(n, zero()) === n
proof: auto(~search_steps: 3)
