#lang rhombus/hol

// Same restriction as `exists1_in_function_bad.rhm`: `select` (choice) is
// a logical construct with no executable witness-producing procedure, so
// it is rejected inside a `function` body.

datatype Nat
| zero()
| succ(pred :: Nat)

function pick_equal(n :: Nat) :: Nat:
  select (x :: Nat): x === n
