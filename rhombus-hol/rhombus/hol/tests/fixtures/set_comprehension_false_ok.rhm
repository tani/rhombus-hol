#lang rhombus/hol

// The non-membership (negated) side of `set_comprehension_ok.rhm`'s
// comprehension. Goal-level beta normalization reduces the application to
// the predicate's body, leaving `not (succ(zero) === zero)`, and the
// datatype's distinctness fact now reaches that phrase in either
// orientation, so the whole statement proves.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

theorem comprehension_membership_false:
  Set{x :: Nat | x === zero()}(succ(zero())) === #false
