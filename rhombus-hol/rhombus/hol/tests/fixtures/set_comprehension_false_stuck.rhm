#lang rhombus/hol

// The non-membership (negated) side of `set_comprehension_ok.rhm`'s
// comprehension. The comprehension itself reduces: goal-level beta
// normalization turns the application into the predicate's body, leaving
// exactly `not (succ(zero) === zero)`.
//
// That residual is a *separate*, pre-existing automation gap -- ground
// constructor distinctness is not discharged by the waterfall, as
// `not (succ(zero()) === zero())` stated on its own is equally stuck --
// so this fixture pins the boundary: everything the comprehension
// contributes is gone, and only the distinctness fact remains.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

theorem comprehension_membership_false:
  Set{x :: Nat | x === zero()}(succ(zero())) === #false
