#lang rhombus/hol

// `Set{x :: T | pred}` desugars to `CoreFunctionExpr([x :: T], Boolean,
// pred)`, an ordinary predicate value applied directly like any other
// `?a -> Boolean` function. Membership proves outright: the application
// is a beta redex, and `prove_impl` normalizes the goal before the
// waterfall runs.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

theorem comprehension_membership_true:
  Set{x :: Nat | x === zero()}(zero()) === #true
