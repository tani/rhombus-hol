#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Weird
| w()

// A `Set{...}` expression's element types still have to agree with the
// `if`'s other branch: checking the set structurally does not let an
// element escape ordinary unification.
function mismatched_set_branch(b :: Boolean) :: Nat -> Boolean:
  if b
  | Set{w(), zero()}
  | Set{zero()}
