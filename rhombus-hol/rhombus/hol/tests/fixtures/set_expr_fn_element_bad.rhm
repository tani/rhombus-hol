#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

// A set of function-typed elements has no sound executable equality:
// `check_expr`'s own `CoreSetExpr` case defers this rejection to
// `fallback` (routing back to `runtime_set_expr`'s identical check)
// rather than silently emitting an unsound `==` comparison.
function bad_fn_set_branch(b :: Boolean) :: (Nat -> Nat) -> Boolean:
  if b
  | Set{function (n :: Nat): n}
  | Set{}
