#lang rhombus/hol

// A HOL `Set` is a predicate value (`?a -> Boolean`), so
// `~extensionality` proves set equality by the same `EXT` rule: two sets
// with different literal descriptions but the same members are equal.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

theorem sets_equal:
  (Set{zero()} :: Nat -> Boolean) === Set{x :: Nat | x === zero()}
proof:
  ~extensionality: x
