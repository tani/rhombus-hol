#lang rhombus/hol

// `Set{e1, e2, ...}` (multiple elements, extending `set_literal_ok.rhm`'s
// canonical empty case) elaborates to the ordinary extensional predicate
// `λx. x === e1 or x === e2 or ...`, and membership proves outright.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

theorem set_membership:
  Set{zero(), succ(zero())}(zero()) === #true
