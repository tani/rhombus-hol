#lang rhombus/hol

// `Set{}` and `Set{e, ...}` normalize to ordinary `?a -> Boolean`
// predicates. The populated form is extensionally a disjunction of
// equalities.

export: Nat zero succ empty_of_nat

datatype Nat
| zero()
| succ(pred :: Nat)

function empty_of_nat() :: Nat -> Boolean:
  Set{}

theorem empty_of_nat_type_checks:
  forall (n :: Nat): empty_of_nat()(n) === empty_of_nat()(n)

theorem set_membership:
  Set{zero(), succ(zero())}(zero()) === #true
