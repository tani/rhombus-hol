#lang rhombus/hol

// `Set{}` (canonical empty set) and `Set{e, ...}` both elaborate to an
// ordinary `?a -> Boolean` predicate (`elab.rhm`'s `elaborate_set_effect`),
// usable wherever such a value is expected -- not a builtin set type. The
// multi-element case (extending the canonical empty case) elaborates to the
// extensional predicate `λx. x === e1 or x === e2 or ...`.

export: Nat zero succ empty_of_nat

datatype Nat
| zero()
| succ(pred :: Nat)

function empty_of_nat() :: Nat -> Boolean:
  Set{}

theorem empty_of_nat_type_checks:
  forall (n :: Nat): empty_of_nat()(n) === empty_of_nat()(n)

theorem set_membership:
  Set{zero(), succ(zero())}(zero()) === #true
