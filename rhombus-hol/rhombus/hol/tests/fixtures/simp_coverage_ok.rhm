#lang rhombus/hol

// Three facts the simplifier used to leave open, each for its own reason.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

// A distinctness fact is derived in one orientation only, and a rewrite
// rule is indexed by its left-hand side, so the other phrase had no rule.
// Both orientations now reach the rule database.
theorem distinct_forward:
  not (zero() === succ(zero()))

theorem distinct_backward:
  not (succ(zero()) === zero())

theorem distinct_quantified:
  forall (n :: Nat): not (succ(n) === zero())

// `fst`/`snd` are defined in the algebra base theory every session
// extends, but their equations were only used to build datatypes and were
// never registered as rules.
theorem projection_first:
  fst(Pair(zero(), succ(zero()))) === zero()

theorem projection_second:
  forall (x :: ?a, y :: ?b): snd(Pair(x, y)) === y

// An extensional set literal compared against a comprehension with no
// ascription anywhere: the literal's binder has to be built from the
// element type the comparison decides, not from the metavariable it
// arrived as.
theorem set_literal_equals_comprehension:
  Set{zero()} === Set{x :: Nat | x === zero()}
