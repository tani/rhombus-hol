#lang rhombus/hol

// A compact theory exercises the complete standard provider matrix without
// inheriting unrelated proof obligations from the full standard library.
datatype Nat:
| zero
| succ(previous :: Nat)

function nat_add(a :: Nat, _b :: Nat) :: Nat: a
function nat_sub(a :: Nat, _b :: Nat) :: Nat: a
function nat_mul(a :: Nat, _b :: Nat) :: Nat: a
function nat_pow(a :: Nat, _b :: Nat) :: Nat: a
function nat_lt(_a :: Nat, _b :: Nat) :: Boolean: #true
function nat_le(_a :: Nat, _b :: Nat) :: Boolean: #true
function nat_gt(_a :: Nat, _b :: Nat) :: Boolean: #true
function nat_ge(_a :: Nat, _b :: Nat) :: Boolean: #true

overload add(Nat, Nat) = nat_add
overload subtract(Nat, Nat) = nat_sub
overload multiply(Nat, Nat) = nat_mul
overload power(Nat, Nat) = nat_pow
overload less(Nat, Nat) = nat_lt
overload less_equal(Nat, Nat) = nat_le
overload greater(Nat, Nat) = nat_gt
overload greater_equal(Nat, Nat) = nat_ge

datatype Integer:
| int_from_nat(magnitude :: Nat)

function int_add(a :: Integer, _b :: Integer) :: Integer: a
function int_subtract(a :: Integer, _b :: Integer) :: Integer: a
function int_multiply(a :: Integer, _b :: Integer) :: Integer: a
function int_negate(a :: Integer) :: Integer: a
function int_lt(_a :: Integer, _b :: Integer) :: Boolean: #true
function int_le(_a :: Integer, _b :: Integer) :: Boolean: #true

overload add(Integer, Integer) = int_add
overload subtract(Integer, Integer) = int_subtract
overload multiply(Integer, Integer) = int_multiply
overload negate(Integer) = int_negate
overload less(Integer, Integer) = int_lt
overload less_equal(Integer, Integer) = int_le
overload greater(left :: Integer, right :: Integer) = int_lt(right, left)
overload greater_equal(left :: Integer, right :: Integer) = int_le(right, left)

datatype Rational:
| rational_from_integer(value :: Integer)

function rational_add(a :: Rational, _b :: Rational) :: Rational: a
function rational_subtract(a :: Rational, _b :: Rational) :: Rational: a
function rational_multiply(a :: Rational, _b :: Rational) :: Rational: a
function rational_negate(a :: Rational) :: Rational: a
function rational_lt(_a :: Rational, _b :: Rational) :: Boolean: #true
function rational_le(_a :: Rational, _b :: Rational) :: Boolean: #true

overload add(Rational, Rational) = rational_add
overload subtract(Rational, Rational) = rational_subtract
overload multiply(Rational, Rational) = rational_multiply
overload negate(Rational) = rational_negate
overload less(Rational, Rational) = rational_lt
overload less_equal(Rational, Rational) = rational_le
overload greater(left :: Rational, right :: Rational) = rational_lt(right, left)
overload greater_equal(left :: Rational, right :: Rational) = rational_le(right, left)

datatype List.of(?a):
| nil
| cons(first :: ?a, rest :: List.of(?a))

function list_append(xs :: List.of(?a), _ys :: List.of(?a)) :: List.of(?a): xs

overload append(List.of(?a), List.of(?a)) = list_append

datatype String:
| text

function string_append(x :: String, _y :: String) :: String: x

overload append(String, String) = string_append

function set_member(s :: ?a -> Boolean, x :: ?a) :: Boolean: s(x)
function set_union(a :: ?a -> Boolean,
                   _b :: ?a -> Boolean,
                   x :: ?a) :: Boolean: a(x)
function set_intersection(a :: ?a -> Boolean,
                          _b :: ?a -> Boolean,
                          x :: ?a) :: Boolean: a(x)

overload member(
  element :: ?a,
  collection :: ?a -> Boolean
) = set_member(collection, element)
overload union(
  ?a -> Boolean,
  ?a -> Boolean
) = set_union
overload intersection(
  ?a -> Boolean,
  ?a -> Boolean
) = set_intersection

function relation_union(r :: ?a -> ?a -> Boolean,
                        _s :: ?a -> ?a -> Boolean,
                        x :: ?a,
                        y :: ?a) :: Boolean: r(x)(y)
function relation_intersection(r :: ?a -> ?a -> Boolean,
                               _s :: ?a -> ?a -> Boolean,
                               x :: ?a,
                               y :: ?a) :: Boolean: r(x)(y)

overload union(
  ?a -> ?a -> Boolean,
  ?a -> ?a -> Boolean
) = relation_union
overload intersection(
  ?a -> ?a -> Boolean,
  ?a -> ?a -> Boolean
) = relation_intersection

theorem nat_add_operator:
  forall (a :: Nat, b :: Nat): a + b === nat_add(a, b)

theorem nat_subtract_operator:
  forall (a :: Nat, b :: Nat): a - b === nat_sub(a, b)

theorem nat_multiply_operator:
  forall (a :: Nat, b :: Nat): a * b === nat_mul(a, b)

theorem nat_power_operator:
  forall (a :: Nat, b :: Nat): a ** b === nat_pow(a, b)

theorem nat_less_operator:
  forall (a :: Nat, b :: Nat): (a < b) <=> nat_lt(a, b)

theorem nat_less_equal_operator:
  forall (a :: Nat, b :: Nat): (a <= b) <=> nat_le(a, b)

theorem nat_greater_operator:
  forall (a :: Nat, b :: Nat): (a > b) <=> nat_gt(a, b)

theorem nat_greater_equal_operator:
  forall (a :: Nat, b :: Nat): (a >= b) <=> nat_ge(a, b)

theorem integer_add_operator:
  forall (a :: Integer, b :: Integer): a + b === int_add(a, b)

theorem integer_subtract_operator:
  forall (a :: Integer, b :: Integer): a - b === int_subtract(a, b)

theorem integer_multiply_operator:
  forall (a :: Integer, b :: Integer): a * b === int_multiply(a, b)

theorem integer_negate_operator:
  forall (a :: Integer): -a === int_negate(a)

theorem integer_greater_operator:
  forall (a :: Integer, b :: Integer): (a > b) <=> int_lt(b, a)

theorem integer_less_operator:
  forall (a :: Integer, b :: Integer): (a < b) <=> int_lt(a, b)

theorem integer_less_equal_operator:
  forall (a :: Integer, b :: Integer): (a <= b) <=> int_le(a, b)

theorem integer_greater_equal_operator:
  forall (a :: Integer, b :: Integer): (a >= b) <=> int_le(b, a)

theorem rational_add_operator:
  forall (a :: Rational, b :: Rational): a + b === rational_add(a, b)

theorem rational_subtract_operator:
  forall (a :: Rational, b :: Rational): a - b === rational_subtract(a, b)

theorem rational_multiply_operator:
  forall (a :: Rational, b :: Rational): a * b === rational_multiply(a, b)

theorem rational_negate_operator:
  forall (a :: Rational): -a === rational_negate(a)

theorem rational_greater_equal_operator:
  forall (a :: Rational, b :: Rational): (a >= b) <=> rational_le(b, a)

theorem rational_less_operator:
  forall (a :: Rational, b :: Rational): (a < b) <=> rational_lt(a, b)

theorem rational_less_equal_operator:
  forall (a :: Rational, b :: Rational): (a <= b) <=> rational_le(a, b)

theorem rational_greater_operator:
  forall (a :: Rational, b :: Rational): (a > b) <=> rational_lt(b, a)

theorem list_append_operator:
  forall (xs :: List.of(?a), ys :: List.of(?a)): xs ++ ys === list_append(xs, ys)

theorem string_append_operator:
  forall (x :: String, y :: String): x ++ y === string_append(x, y)

theorem set_union_membership_operator:
  forall (x :: ?a,
          a :: ?a -> Boolean,
          b :: ?a -> Boolean):
    (x in (a union b)) <=> set_member(set_union(a, b), x)

theorem set_intersection_membership_operator:
  forall (x :: ?a,
          a :: ?a -> Boolean,
          b :: ?a -> Boolean):
    (x in (a intersect b)) <=> set_member(set_intersection(a, b), x)

theorem relation_union_operator:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean):
    r union s === relation_union(r, s)

theorem relation_intersection_operator:
  forall (r :: ?a -> ?a -> Boolean,
          s :: ?a -> ?a -> Boolean):
    r intersect s === relation_intersection(r, s)

theorem nat_numeral_operator:
  forall (n :: Nat): n + 2 === nat_add(n, succ(succ(zero())))

theorem integer_numeral_operator:
  forall (z :: Integer): z + 1 === int_add(z, int_from_nat(succ(zero())))

theorem rational_numeral_operator:
  forall (q :: Rational):
    q + 1 === rational_add(
      q, rational_from_integer(int_from_nat(succ(zero()))))

theorem expected_nat_numeral:
  1 === succ(zero())

theorem expected_integer_numeral:
  1 === int_from_nat(succ(zero()))

theorem expected_rational_numeral:
  1 === rational_from_integer(int_from_nat(succ(zero())))

theorem expected_nat_zero:
  0 === zero()

theorem expected_integer_zero:
  0 === int_from_nat(zero())

theorem expected_rational_zero:
  0 === rational_from_integer(int_from_nat(zero()))

theorem expected_negative_integer_numeral:
  -1 === int_negate(int_from_nat(succ(zero())))

theorem expected_operator_numerals:
  1 + 2 === nat_add(succ(zero()), succ(succ(zero())))

theorem multiplication_precedes_addition:
  forall (a :: Nat, b :: Nat, c :: Nat):
    a + b * c === nat_add(a, nat_mul(b, c))

theorem subtraction_associates_left:
  forall (a :: Nat, b :: Nat, c :: Nat):
    a - b - c === nat_sub(nat_sub(a, b), c)

theorem power_associates_right:
  forall (a :: Nat, b :: Nat, c :: Nat):
    a ** b ** c === nat_pow(a, nat_pow(b, c))

theorem append_associates_right:
  forall (xs :: List.of(?a), ys :: List.of(?a), zs :: List.of(?a)):
    xs ++ ys ++ zs === list_append(xs, list_append(ys, zs))

theorem intersection_precedes_union:
  forall (a :: ?a -> Boolean,
          b :: ?a -> Boolean,
          c :: ?a -> Boolean):
    a union b intersect c === set_union(a, set_intersection(b, c))

theorem numeral_uses_function_domain:
  nat_add(1, 2) === nat_add(succ(zero()), succ(succ(zero())))

theorem negation_precedes_multiplication:
  forall (a :: Integer, b :: Integer):
    -a * b === int_multiply(int_negate(a), b)

theorem arithmetic_precedes_comparison:
  forall (a :: Nat, b :: Nat, c :: Nat, d :: Nat):
    (a + b < c * d) <=> nat_lt(nat_add(a, b), nat_mul(c, d))
