#lang rhombus/hol

// These are deliberately the same logical names as `state_a.rhm`. Compiling
// both modules in one process would report duplicate declarations if their
// theory state leaked across module boundaries.

export: marker

datatype Local
| local()

function keep(x :: Local) :: Local:
  x

theorem keep_refl:
  forall (x :: Local): keep(x) === x

def marker = "b"
