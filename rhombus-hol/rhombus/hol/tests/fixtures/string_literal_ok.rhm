#lang rhombus/hol

// A string literal desugars to `text(cons(code, cons(code, ... nil())))`
// over whatever datatype provides `Nat`, `List.of(?a)`, and a `text`
// constructor wrapping a `List.of(Nat)` (`elab.rhm`'s
// `elaborate_string_effect`) -- not a builtin string type, the same
// sugar-over-user-datatype design as list literals. The reader decodes
// Unicode escapes (`\u00e9`) and control escapes (`\n`, `\t`) before this
// ever runs, so the two spellings of the same character compare equal.

export: Nat zero succ List nil cons String text

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

datatype String
| text(codes :: List.of(Nat))

theorem string_literal_equal:
  "hello" === "hello"

theorem string_literal_unicode_escape:
  "héllo\u00e9" === "h\u00e9llo\u00e9"

theorem string_literal_control_escape:
  "a\nb\tc" === "a\nb\tc"
