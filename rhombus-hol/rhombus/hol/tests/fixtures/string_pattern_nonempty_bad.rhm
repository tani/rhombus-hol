#lang rhombus/hol

// A non-empty string literal pattern is refused outright: a codepoint is a
// unary numeral, so `"a"` is a 97-level constructor chain whose decision
// tree exhausts the proof-search budget. The diagnostic names the
// workaround instead of letting the search run for minutes.

export: String text Nat zero succ List nil cons

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

datatype String
| text(string_codes :: List.of(Nat))

function is_a(s :: String) :: Boolean:
  match s
  | "a": #true
  | _: #false
