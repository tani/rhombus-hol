#lang rhombus/hol

// The empty string as a pattern. A string literal is `text` applied to the
// list of its codepoints, so `""` is `text(nil())` -- an ordinary two-level
// constructor pattern over the declared `String` and `List` datatypes,
// checked for totality like any other. A non-empty literal pattern is
// refused: a pattern is a constructor term, and a codepoint's constructor
// term is its unary reading.

export: String text Nat zero succ List nil cons is_empty_text

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

datatype String
| text(string_codes :: List.of(Nat))

function is_empty_text(s :: String) :: Boolean:
  match s
  | "": #true
  | _: #false

theorem empty_is_empty:
  is_empty_text("") === #true
