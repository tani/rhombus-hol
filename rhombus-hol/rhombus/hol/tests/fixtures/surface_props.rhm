#lang rhombus/hol

theorem named_application:
  neg(false)

theorem equality:
  true === true

theorem conjunction_precedence:
  true or false and false

theorem negation_precedence:
  not false and true

theorem implication_right_associative:
  false ==> false ==> false

theorem equivalence_weakest:
  true <=> false ==> true

theorem universal:
  forall (x :: Boolean, y :: Boolean): x === x and y === y

theorem existential:
  (exists (x :: Boolean): x === x)
    === (exists (x :: Boolean): x === x)

theorem conditional:
  if true | true | false

theorem conditional_rows:
  cond
  | false: false
  | ~else: true

expect [named_application,
        equality,
        conjunction_precedence,
        negation_precedence,
        implication_right_associative,
        equivalence_weakest,
        universal,
        existential,
        conditional,
        conditional_rows]
