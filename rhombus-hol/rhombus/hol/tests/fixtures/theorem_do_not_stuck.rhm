#lang rhombus/hol

// `~do_not: [induct]` turns off the one stage this proof genuinely needs.

type List(?a)
| Nil()
| Cons(head :: ?a, tail :: List(?a))

function app(xs :: List(?a), ys :: List(?a)) :: List(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

theorem app_nil_r_no_induct:
  forall (xs :: List(?a)):
    app(xs, Nil()) === xs
proof:
  auto(~do_not: [induct])
