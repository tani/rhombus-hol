#lang rhombus/hol

// `~in_theory:` is scoped to the one proof it appears on.  `first` disables
// `app` (irrelevant to its own goal, so it still succeeds); `second`, which
// comes after it with no hint at all, needs `app`'s own equations to
// simplify and must still succeed -- if the disable in `first` leaked
// forward into the module's shared rule database, `second` would get stuck.

type List(?a)
| Nil()
| Cons(head :: ?a, tail :: List(?a))

function app(xs :: List(?a), ys :: List(?a)) :: List(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

theorem first:
  forall (xs :: List(?a)):
    xs === xs
proof:
  auto(~in_theory: [app])

theorem second:
  forall (ys :: List(?a)):
    app(Nil(), ys) === ys
proof:
  auto
