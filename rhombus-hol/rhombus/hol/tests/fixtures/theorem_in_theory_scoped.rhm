#lang rhombus/hol

// `disable_rules [app]` is scoped to the one proof it appears on. `first` disables
// `app` (irrelevant to its own goal, so it still succeeds); `second`, which
// comes after it with no hint at all, needs `app`'s own equations to
// simplify and must still succeed -- if the disable in `first` leaked
// forward into the module's shared rule database, `second` would get stuck.

type List.of(?a)
| Nil()
| Cons(head :: ?a, tail :: List.of(?a))

function app(xs :: List.of(?a), ys :: List.of(?a)) :: List.of(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

theorem first:
  forall (xs :: List.of(?a)):
    xs === xs
proof:
  ~disable: [app]

theorem second:
  forall (ys :: List.of(?a)):
    app(Nil(), ys) === ys
