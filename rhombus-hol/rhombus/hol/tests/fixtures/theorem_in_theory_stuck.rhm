#lang rhombus/hol

// `~disable: [app]` removes the one rule this proof needs: app's own defining
// equation.

datatype List.of(?a)
| Nil()
| Cons(head :: ?a, tail :: List.of(?a))

function app(xs :: List.of(?a), ys :: List.of(?a)) :: List.of(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

theorem app_nil_l_blocked:
  forall (ys :: List.of(?a)):
    app(Nil(), ys) === ys
proof:
  ~disable: [app]
