#lang rhombus/hol

// `disable_rules [app]` removes the one rule this proof needs, on top of
// whatever the module itself left enabled -- app's own defining equation is
// not disabled by anything at the module level here.

type List.of(?a)
| Nil()
| Cons(head :: ?a, tail :: List.of(?a))

function app(xs :: List.of(?a), ys :: List.of(?a)) :: List.of(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

theorem app_nil_l_blocked:
  forall (ys :: List.of(?a)):
    app(Nil(), ys) === ys
proof:
  disable([app])
