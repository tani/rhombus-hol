#lang rhombus/hol

// `~in_theory: [app]` disables the one rule this proof needs, on top of
// whatever the module itself left enabled -- app's own defining equation is
// not disabled by anything at the module level here.

type List(?a)
| Nil()
| Cons(head :: ?a, tail :: List(?a))

function app(xs :: List(?a), ys :: List(?a)) :: List(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

theorem app_nil_l_blocked:
  forall (ys :: List(?a)):
    app(Nil(), ys) === ys
proof:
  auto(~in_theory: [app])
