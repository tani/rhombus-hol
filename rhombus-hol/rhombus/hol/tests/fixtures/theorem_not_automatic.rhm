#lang rhombus/hol

// A proved theorem is not available to later automation unless selected by
// `use`. Induction is disabled so this theorem cannot succeed independently.

type Nat
| zero()
| succ(pred :: Nat)

function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))

theorem plus_zero_r:
  forall (n :: Nat): plus(n, zero()) === n
proof:
  induct(n)

theorem twice_without_use:
  forall (n :: Nat): plus(plus(n, zero()), zero()) === n
proof:
  skip([induct])
