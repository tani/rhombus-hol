#lang rhombus/hol

// `theorem` with and without a `proof:` clause, attributes, and rule control.

export:
  List
  Nil
  Cons
  app

type List(~a)
| Nil()
| Cons(head :: ~a, tail :: List(~a))

function app(xs :: List(~a), ys :: List(~a)) :: List(~a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

// No `proof:` clause at all: the default is `auto`, and the induction
// variable is chosen without a hint.
theorem ~rewrite_rule app_nil_r:
  forall (xs :: List(~a)):
    app(xs, Nil()) === xs

// An explicit hint, for the same effect.
theorem ~rewrite_rule app_assoc:
  forall (xs :: List(~a), ys :: List(~a), zs :: List(~a)):
    app(app(xs, ys), zs) === app(xs, app(ys, zs))
proof:
  auto ~induct: xs

// Two theorems in a row: the second must not be mistaken for the first's
// proof clause.
theorem app_nil_l:
  forall (ys :: List(~a)):
    app(Nil(), ys) === ys

theorem app_nil_both:
  app(Nil(), Nil()) === Nil()

expect [List, app, app_nil_r, app_assoc, app_nil_l, app_nil_both]
