#lang rhombus/hol

// The specification's own counterexample: `rev` does not distribute over
// `app` without swapping the arguments.  The proof must fail, at this line,
// with the residue that shows where it ran out.

type List(?a)
| Nil()
| Cons(head :: ?a, tail :: List(?a))

function app(xs :: List(?a), ys :: List(?a)) :: List(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

function rev(xs :: List(?a)) :: List(?a):
  match xs
  | Nil(): Nil()
  | Cons(x, rest): app(rev(rest), Cons(x, Nil()))

theorem rev_app_wrong:
  forall (xs :: List(?a), ys :: List(?a)):
    rev(app(xs, ys)) === app(rev(xs), rev(ys))
proof:
  auto ~induct: xs
