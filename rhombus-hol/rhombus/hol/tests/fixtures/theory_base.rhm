#lang rhombus/hol

export:
  List
  Nil
  Cons
  app

type List(?a)
| Nil()
| Cons(head :: ?a, tail :: List(?a))

function app(xs :: List(?a), ys :: List(?a)) :: List(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

theorem app_nil_r:
  forall (xs :: List(?a)):
    app(xs, Nil()) === xs
