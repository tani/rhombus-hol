#lang rhombus/hol

export:
  List
  Nil
  Cons
  app

datatype List.of(?a)
| Nil()
| Cons(head :: ?a, tail :: List.of(?a))

function app(xs :: List.of(?a), ys :: List.of(?a)) :: List.of(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

theorem app_nil_r:
  forall (xs :: List.of(?a)):
    app(xs, Nil()) === xs
