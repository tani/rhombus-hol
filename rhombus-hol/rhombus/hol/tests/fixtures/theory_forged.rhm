#lang rhombus

// A module that publishes valid-looking surface metadata and then tries to
// pass data off as its logical theory. Surface metadata is intentionally
// ordinary data; the `HolState` still cannot be forged because `Thm` is opaque.
module hol_theory ~lang rhombus:
  export: theory
  def theory = "a theory, honestly"

module hol_surface ~lang rhombus:
  import:
    rhombus/hol/frontend/surface_state open
  export: state
  def state = make_surface_state([], [], [], [])
