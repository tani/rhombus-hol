#lang rhombus

// A module that tries to pass itself off as a theory.
//
// The submodule name and the export are right; the value is not a `HolState`
// and cannot be made into one without going through the kernel, which is what
// makes `Thm` opaque.  Anything this module can build here is data.
module hol_theory ~lang rhombus:
  export: theory
  def theory = "a theory, honestly"
