#lang rhombus/hol

// One `import` naming both an ordinary module and a theory.  The ordinary one
// passes through untouched; the theory is adopted.

export:
  loud
  twice_over
  List
  Nil
  Cons
  app

import:
  "plain_helper.rhm" open
  "theory_base.rhm" open

function twice_over(xs :: List(~a)) :: List(~a):
  match xs
  | Nil(): Nil()
  | Cons(x, rest): Cons(x, Cons(x, twice_over(rest)))

// Needs `app_nil_r` from the adopted theory.
theorem needs_the_adopted_lemma:
  forall (xs :: List(~a), ys :: List(~a)):
    app(app(xs, Nil()), ys) === app(xs, ys)

def loud = shout("hello")
