#lang rhombus/hol

// Only `theory_mid` is named, yet `List`, `app` and `app_nil_r` -- all from
// `theory_base` -- are in scope, because the adopted state already contains
// whatever its own imports contributed.

export:
  result

import: "theory_mid.rhm" open

theorem needs_the_grandparent:
  forall (xs :: List.of(?a), ys :: List.of(?a)):
    app(app(xs, Nil()), ys) === app(xs, ys)

def result = twice(Cons(1, Nil()))
