#lang rhombus/hol

// The imported theory brings three things: the datatype, the function's
// defining equations, and `app_nil_r` as a rewrite rule.  The theorem below
// cannot be proved without the last of those, so if the manifest did not
// cross, this module would not compile.

export:
  twice
  sample
  // re-exported from the imported theory
  List
  Nil
  Cons
  app

import: "theory_base.rhm" open

function twice(xs :: List.of(?a)) :: List.of(?a):
  match xs
  | Nil(): Nil()
  | Cons(x, rest): Cons(x, Cons(x, twice(rest)))

theorem needs_imported_lemma:
  forall (xs :: List.of(?a), ys :: List.of(?a)):
    app(app(xs, Nil()), ys) === app(xs, ys)

def sample = twice(Cons(1, Nil()))
