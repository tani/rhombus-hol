#lang rhombus/hol

// A top-level recursive `function`'s *parameter* type may be omitted and
// inferred from how the parameter is used in the body (here, matched
// against `Nat`'s constructors) -- unlike its *result* type, which
// `function_no_result_type.rhm` confirms remains mandatory by deliberate
// design (§11.2 of the design: explicit result-type signatures, no result
// inference).

export: Nat zero succ double

datatype Nat
| zero()
| succ(pred :: Nat)

function double(n) :: Nat:
  match n
  | zero(): zero()
  | succ(k): succ(succ(double(k)))

theorem double_zero:
  double(zero()) === zero()
