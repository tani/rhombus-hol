#lang rhombus/hol

// Two non-recursive datatypes in one module.  Both go through
// `build_nonrecursive_datatype_thms` (`datatype_gen.rhm`), which needs
// `unit`/`prod`/`sum` -- so this is the regression test for the algebra
// bootstrap being shared rather than rebuilt per declaration: rebuilding
// it would try to declare the type constructor `unit` a second time and
// die with "type constructor is already declared".

export:
  Colour
  Red
  Blue
  Direction
  Left
  Right
  Boxed
  MkBoxed
  turn
  boxed_colour

type Colour
| Red()
| Blue()

type Direction
| Left()
| Right()

// A third one, with fields, so the `prod` half of the bootstrap is
// exercised twice too and not only `unit`/`sum`.
type Boxed
| MkBoxed(hue :: Colour, way :: Direction)

function turn(d :: Direction) :: Direction:
  match d
  | Left(): Right()
  | Right(): Left()

function boxed_colour(b :: Boxed) :: Colour:
  match b
  | MkBoxed(hue, way): hue

// The derived injectivity is a real theorem about the third type, proved
// from `prod`'s own injectivity -- and it is provable here only because
// both earlier declarations left the shared algebra intact.
theorem boxed_injective:
  forall (c1 :: Colour, d1 :: Direction, c2 :: Colour, d2 :: Direction):
    MkBoxed(c1, d1) === MkBoxed(c2, d2) <=> c1 === c2 and d1 === d2
proof: auto()

theorem turn_turn:
  forall (d :: Direction): turn(turn(d)) === d
proof: auto()
