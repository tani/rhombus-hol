#lang rhombus/hol

// A nested occurrence: `Rose` appears as an *argument* of `List`, not as the
// type itself.  That is sound in principle, but the one-constructor-deep
// induction scheme this version derives would not mention the elements of the
// list -- so admitting it would produce a wrong scheme rather than an unsound
// one, and the checker refuses it instead.

type List.of(?a)
| Nil()
| Cons(head :: ?a, tail :: List.of(?a))

type Rose
| leaf()
| node(kids :: List.of(Rose))
