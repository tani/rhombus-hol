#lang rhombus/hol

// `type` emits executable classes and registers the datatype logically.

export:
  Nil
  Cons
  List
  zero
  succ
  Nat
  sample

type List(?a)
| Nil()
| Cons(head :: ?a, tail :: List(?a))

type Nat
| zero()
| succ(pred :: Nat)

type Tree(?a)
| leaf()
| node(value :: ?a, left :: Tree(?a), right :: Tree(?a))

// the logical side saw all three, in order
expect [List, List_lt, Nat, Nat_lt, Tree, Tree_lt]

def sample = Cons(1, Cons(2, Nil()))
