#lang rhombus/hol

// A module combining local functions with lexical capture, an
// extensionality proof, and Set literals must extend the base theory's
// *constant/definition* set only -- never its axiom set. `add_function`
// and `add_datatype` already call `require_no_new_axioms` on every
// declaration; this fixture is used directly (see
// `zero_new_axioms.rhm`) to compare `axioms_of` before and after
// loading it.

export: Nat zero succ outer

datatype Nat
| zero()
| succ(pred :: Nat)

function add(x :: Nat, y :: Nat) :: Nat:
  match x
  | zero(): y
  | succ(k): succ(add(k, y))

function outer(x :: Nat) :: Nat:
  function add_x(y :: Nat) :: Nat:
    add(x, y)
  add_x(x)

theorem uses_extensionality:
  (Set{zero()} :: Nat -> Boolean) === Set{zero()}
proof:
  ~extensionality: q
