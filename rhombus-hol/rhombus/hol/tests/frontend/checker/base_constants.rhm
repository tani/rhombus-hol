#lang rhombus/static

// The frontend checks declarations against its own table of the base
// theory's constants (`base_constants`); the backend lowers the result into
// the driver's initial theory. Each table entry must name a constant of that
// theory at exactly the tabled type, or checking and lowering would disagree.

import:
  rhombus/hol/kernel open
  rhombus/hol/backend/proof/driver open
  rhombus/hol/frontend/checker/state open

def thy = (initial_state() :~ HolState).ctx.thy

check:
  for List ((name, ty) in base_constants):
    [name, const_type(thy, name) == ty]
  ~is for List ((name, _) in base_constants): [name, #true]
