#lang rhombus/static

// The checker types the constants syntax elaborates to from its own table
// (`builtin_constants`); the backend lowers them into the driver's initial
// theory. Each entry must name a constant of that theory at exactly the
// tabled type, or checking and lowering would disagree. The source namespace
// admits only the Boolean literals among them.

import:
  rhombus/hol/kernel open
  rhombus/hol/backend/proof/driver open
  rhombus/hol/frontend/checker/checked open
  rhombus/hol/frontend/checker/state open

def thy = (initial_state() :~ HolState).ctx.thy

check:
  for List ((name, ty) in builtin_constants):
    [name, const_type(thy, name) == ty]
  ~is for List ((name, _) in builtin_constants): [name, #true]

check base_constants.keys().sort() ~is [#'false, #'true]
