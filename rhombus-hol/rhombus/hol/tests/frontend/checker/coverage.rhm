#lang rhombus/static

// The structural rules the frontend checks while a module expands
// (`frontend/checker/coverage.rhm`, `frontend/checker/state.rhm`): each
// fixture fails without its theory being built.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open
  lib("rhombus/hol/tests/frontend/checker/fixtures/coverage_ok.rhm") as ok

fun message(mp :: ModulePath) :: String:
  try:
    block:
      expand_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

check:
  message(ModulePath'lib("rhombus/hol/tests/frontend/checker/fixtures/coverage_inexhaustive_bad.rhm")')
    .contains("not exhaustive; it does not cover cons(_, cons(_, _))")
  ~is #true
check:
  message(ModulePath'lib("rhombus/hol/tests/frontend/checker/fixtures/coverage_unreachable_bad.rhm")')
    .contains("this clause can never match")
  ~is #true
check:
  message(ModulePath'lib("rhombus/hol/tests/frontend/checker/fixtures/coverage_literal_bad.rhm")')
    .contains("it does not cover succ(succ(_))")
  ~is #true
check:
  message(ModulePath'lib("rhombus/hol/tests/frontend/checker/fixtures/coverage_family_bad.rhm")')
    .contains("must use the same type variables")
  ~is #true
check:
  message(ModulePath'lib("rhombus/hol/tests/frontend/checker/fixtures/coverage_reserved_bad.rhm")')
    .contains("constant is already declared: conj")
  ~is #true
check:
  message(ModulePath'lib("rhombus/hol/tests/frontend/checker/fixtures/coverage_duplicate_bad.rhm")')
    .contains("constant is already declared: is_zero")
  ~is #true

// What the rules admit, in both readings.
check ok.rematch(ok.zero()) ~is ok.zero()
check ok.rematch(ok.succ(ok.succ(ok.zero()))) ~is ok.succ(ok.zero())
check ok.let_match(ok.nil()) ~is ok.succ(ok.zero())
check ok.outer_match(ok.zero(), ok.nil()) ~is ok.zero()
check:
  ok.outer_match(ok.zero(), ok.cons(ok.succ(ok.zero()), ok.nil()))
  ~is ok.succ(ok.zero())
check ok.small(ok.succ(ok.zero())) ~is #true
check ok.small(ok.succ(ok.succ(ok.zero()))) ~is #false
check:
  make_hol_fixture_loader()(
    ModulePath'lib("rhombus/hol/tests/frontend/checker/fixtures/coverage_ok.rhm")')
  ~completes
