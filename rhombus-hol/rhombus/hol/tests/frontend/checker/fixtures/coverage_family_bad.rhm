#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

// Family members share one type-variable scope.
function.together:
  function f(x :: ?a, n :: Nat) :: Nat
  | (x, zero()): zero()
  | (x, succ(k)): g(k, k)
  function g(y :: ?b, n :: Nat) :: Nat
  | (y, zero()): zero()
  | (y, succ(k)): f(zero(), k)
