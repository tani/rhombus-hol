#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

export:
  zero
  succ
  nil
  cons
  rematch
  let_match
  outer_match
  swap
  small

// A second `match` on an argument already matched matches its value there.
function rematch(n :: Nat) :: Nat:
  match n
  | zero():
      match n
      | zero(): zero()
      | succ(q): q
  | succ(p): p

// A `match` on a `let`-bound value is an ordinary match.
function let_match(xs :: List.of(Nat)) :: Nat:
  let ys = cons(zero(), xs)
  match ys
  | nil(): zero()
  | cons(y, _): succ(y)

// Inside a `match` on a computed value, the function's own argument can
// still be matched.
function outer_match(n :: Nat, xs :: List.of(Nat)) :: Nat:
  match succ(n)
  | zero(): zero()
  | succ(_):
      match xs
      | nil(): n
      | cons(x, _): x

// Pair components that are variables are fine in a clause.
function swap(p :: Pair.of(Nat, Nat)) :: Pair.of(Nat, Nat):
  match p
  | Pair(a, b): Pair(b, a)

// Numerals and a catch-all cover every Nat.
function small(n :: Nat) :: Boolean:
  match n
  | 0: #true
  | 1: #true
  | _: #false
