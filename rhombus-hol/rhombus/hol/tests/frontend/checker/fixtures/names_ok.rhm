#lang rhombus/hol

// Names the prover uses for its own constructions -- the product's `fst`,
// the unit's `one`, the sum type, a datatype's `abs_`/`rep_` bijection, a
// recursive function's `_rel` -- are free for declarations: the prover's own
// carry a trailing `'` no identifier can spell.

export:
  zero
  succ
  one
  fst
  inl
  size
  size_rel
  abs_Nat

datatype Nat
| zero()
| succ(pred :: Nat)

datatype sum
| inl(value :: Nat)
| inr(other :: Nat)

function one() :: Nat:
  succ(zero())

function fst(p :: Pair.of(Nat, Nat)) :: Nat:
  match p
  | Pair(a, _): a

function size(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): succ(size(k))

function size_rel(n :: Nat) :: Nat:
  size(n)

function abs_Nat(n :: Nat) :: Nat:
  n

theorem one_is_succ_zero:
  one() === succ(zero())
