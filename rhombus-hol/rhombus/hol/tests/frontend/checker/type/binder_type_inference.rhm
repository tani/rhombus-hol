#lang rhombus/static

// A binder's `:: T` annotation is optional (`declared_function_type`
// defaults to a fresh metavariable). Verified here: a body constraint
// resolves it to the concrete type used, and no constraint leaves it a
// genuinely generalized schematic variable -- not defaulted to something
// arbitrary.

import:
  rhombus/hol/kernel open
  rhombus/hol/backend/proof/logic/bool open
  rhombus/hol/backend/proof/driver open
  lib("rhombus/hol/tests/frontend/checker/type/fixtures/binder_type_inference_ok.rhm")!hol_theory as m

def st :~ HolState = m.theory

check:
  let (vs, body) = strip_forall(concl_of(st.thms[#'infer_binder_type_from_usage]))
  match [vs, dest_eq(body)]
  | [[v], [lhs, rhs]]:
      let (head, args) = strip_comb(lhs)
      [type_of(v), head is_a Const && (head :~ Const).name == #'id_nat,
       args == [v], rhs == v]
  | ~else: #false
  ~is [mk_tyapp(#'Nat, []), #true, #true, #true]

check:
  let (vs, body) = strip_forall(concl_of(st.thms[#'generalize_unconstrained_binder]))
  match [vs, dest_eq(body)]
  | [[v], [lhs, rhs]]:
      [type_of(v) is_a TyVar, lhs == v, rhs == v]
  | ~else: #false
  ~is [#true, #true, #true]
