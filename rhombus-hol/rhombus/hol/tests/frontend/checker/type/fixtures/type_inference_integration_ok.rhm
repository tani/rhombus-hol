#lang rhombus/hol

// Bidirectional expected-type propagation threads an outer function's
// declared parameter type through arbitrarily nested literal
// constructors with zero explicit annotations, generating and resolving
// fresh type metavariables along the way; overload resolution
// participates in the same inference, selecting by an argument's
// *inferred* type rather than requiring it be syntactically apparent.
// Each theorem below asserts the resulting value, so inference having
// landed on the right types is what makes the proof go through.

export: Nat zero succ List nil cons first_or_zero first_of_pair_list Maybe none some

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

// A call site with zero explicit type annotations anywhere
// (`Pair([zero(), succ(zero())], zero())`) elaborates correctly by
// propagating the outer function's declared parameter type
// (`Pair.of(List.of(Nat), Nat)`) bidirectionally through two levels of
// nesting: first into the `Pair` literal's two positions, then from
// there into the `List` literal's element type. It proves outright: the
// product projections' equations are in the base rule database, so the
// `let Pair(xs, _) = p` destructuring reduces along with everything else.
function first_or_zero(xs :: List.of(Nat)) :: Nat:
  match xs
  | []: zero()
  | [x, & _]: x

function first_of_pair_list(
    p :: Pair.of(List.of(Nat), Nat)) :: Nat:
  let Pair(xs, _) = p
  first_or_zero(xs)

theorem deep_propagation:
  first_of_pair_list(Pair([zero(), succ(zero())], zero())) === zero()

// `map`'s overload between `List.of(?a)` and `Maybe.of(?a)` resolves by
// the argument's *inferred* type: `make_one(zero())`'s return type
// (`List.of(Nat)`), not a syntactically visible `List.of`/`Maybe.of`
// literal at the call site. The theorem below proves, which is possible
// only if the `list_len_is_one` branch (not `maybe_apply`) was genuinely
// selected.

datatype Maybe.of(?a)
| none()
| some(value :: ?a)

function list_len_is_one(f :: ?a -> ?b, xs :: List.of(?a)) :: List.of(?b):
  match xs
  | []: nil()
  | cons(h, t): cons(f(h), list_len_is_one(f, t))

function maybe_apply(f :: ?a -> ?b, m :: Maybe.of(?a)) :: Maybe.of(?b):
  match m
  | none(): none()
  | some(v): some(f(v))

overload map(?a -> ?b, List.of(?a)) = list_len_is_one
overload map(?a -> ?b, Maybe.of(?a)) = maybe_apply

function make_one(x :: Nat) :: List.of(Nat):
  [x]

theorem overload_selected_by_inferred_type:
  map(function (n :: Nat) :: Nat: succ(n), make_one(zero())) === [succ(zero())]
