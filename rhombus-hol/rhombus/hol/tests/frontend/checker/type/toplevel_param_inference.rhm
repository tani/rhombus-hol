#lang rhombus/static

// A top-level recursive function's parameter type, when omitted, is
// inferred from body usage -- concretely `Nat`, not left as an
// unresolved metavariable -- while its result type remains mandatory
// (unaffected, per `function_no_result_type.rhm`).

import:
  rhombus/hol/kernel open
  rhombus/hol/backend/proof/driver open
  rhombus/hol/frontend/checker/type/registry open
  rhombus/hol/frontend/checker/state open
  lib("rhombus/hol/tests/frontend/checker/type/fixtures/toplevel_param_infer_ok.rhm")!hol_theory as m
  lib("rhombus/hol/tests/frontend/checker/type/fixtures/toplevel_param_infer_ok.rhm")!hol_surface as s

def st :~ HolState = m.theory
def surface :~ SurfaceState = s.state

check:
  type_to_surface_string(
    surface.type_constructors, const_type(st.ctx.thy, #'double))
  ~is "Nat -> Nat"
