#lang rhombus/hol

// A quickcheck property resolves names exactly as a theorem does: the
// product constructor is reached through `Pair(...)`, not a name.

datatype Nat
| zero()
| succ(pred :: Nat)

quickcheck pair_by_name(~samples: 5, ~seed: 1):
  forall (n :: Nat):
    pair(n, n) === pair(n, n)
