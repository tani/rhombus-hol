#lang rhombus/hol

import:
  lib("rhombus/hol/tests/frontend/parser/notation/fixtures/notation_export_smoke.rhm") open

export: imported imported_pattern


function imported(left :: Boolean, right :: Boolean) :: Boolean:
  left <+> right

function imported_pattern(left :: Boolean, right :: Boolean) :: Boolean:
  left <|+> right

theorem imported_true:
  imported(false, true) === true

theorem imported_false:
  imported(true, true) === false

theorem imported_pattern_true:
  imported_pattern(false, true) === true
