#lang rhombus/hol

notation (left <+> right):
  ~order hol_addition
  left

notation (left <++> right):
  ~stronger_than hol_addition
  left

notation (left <*> right):
  ~weaker_than: hol_addition
  left

notation (left <**> right):
  ~same_as: hol_addition
  left

notation (left <%> right):
  ~same_on_left_as: +
  left

notation (left <!> right):
  ~same_on_right_as: +
  left

notation (left <?> right):
  ~order hol_addition
  ~associativity ~left
  left
