#lang rhombus/hol

export:
  Choice
  none
  some
  prefix_runtime
  infix_runtime
  postfix_runtime
  case_result_runtime
  typed_runtime
  ordered_runtime


datatype Choice
| none()
| some(value :: Boolean)

// Prefix and infix cases share one spelling, result type, and precedence
// declaration. Each fixity is independently exhaustive and ordered.
notation <?> :: Boolean:
  ~order: hol_relation
  ~associativity: ~none
| (<?> (none())): #true
| (<?> (some(value))): neg(value)
| ((none()) <?> _): #false
| ((some(value)) <?> right): conj(value, right)

function prefix_runtime(value :: Choice) :: Boolean:
  <?> value

function infix_runtime(left :: Choice, right :: Boolean) :: Boolean:
  left <?> right

// Case-local result annotations are static HOL constraints, not converters.
notation
| ((none()) <|?> _) :: Boolean:
    ~order: hol_relation
    #false
| ((some(value)) <|?> right) :: Boolean:
    conj(value, right)

function case_result_runtime(left :: Choice, right :: Boolean) :: Boolean:
  left <|?> right

notation ((left :: Boolean) <*> (right :: Boolean)) :: Boolean:
  ~order: hol_conjunction
  conj(left, right)

function typed_runtime(left :: Boolean, right :: Boolean) :: Boolean:
  left <*> right

notation <^> :: Boolean:
  ~order: hol_relation
| ((some(value)) <^> _):
    value
| (_ <^> right):
    right

function ordered_runtime(left :: Choice, right :: Boolean) :: Boolean:
  left <^> right

notation
| ((none()) <!>):
    ~order: hol_negation
    #true
| ((some(value)) <!>):
    neg(value)

function postfix_runtime(value :: Choice) :: Boolean:
  value <!>


theorem prefix_none:
  <?> none()

theorem prefix_some:
  (<?> some(false)) === true

theorem infix_none:
  (none() <?> true) === false

theorem infix_some:
  (some(true) <?> true) === true

theorem case_result_annotation:
  (some(true) <|?> true) === true

theorem typed_operand_and_result_annotations:
  (true <*> true) === true

theorem ordered_specific_case_wins:
  (some(false) <^> true) === false

theorem ordered_fallback_remains_reachable:
  (none() <^> true) === true

theorem postfix_none:
  none() <!>

theorem postfix_some:
  (some(false) <!>) === true
