#lang rhombus/hol

datatype Choice
| none()
| some(value :: Boolean)

notation <?> :: Boolean:
  ~order: hol_relation
| ((none()) <?> _): #false

// A notation pattern matrix denotes a total HOL function. Using this partial
// matrix must fail instead of acquiring Rhombus's runtime no-match behavior.
theorem rejected_partial_notation:
  (none() <?> true) === false
