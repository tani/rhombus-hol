#lang rhombus/static

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open
  lib("rhombus/hol/tests/frontend/parser/notation/fixtures/operator_runtime_ok.rhm") as runtime

def load_positive = make_hol_fixture_loader()
check:
  runtime.add_one(runtime.tiny_zero())
  ~is runtime.tiny_succ(runtime.tiny_zero())

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/frontend/parser/notation/fixtures/operator_runtime_ok.rhm")')
  ~completes

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/frontend/parser/notation/fixtures/operator_numeral_runtime_ok.rhm")')
  ~completes

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/frontend/parser/notation/fixtures/operator_extension_ok.rhm")')
  ~completes

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/frontend/parser/notation/fixtures/operator_extension_import_ok.rhm")')
  ~completes

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/frontend/parser/notation/fixtures/overload_function_ok.rhm")')
  ~completes

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/frontend/parser/notation/fixtures/notation_associativity_bad.rhm")')
  ~throws "`~left`, `~right`, or `~none`"

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/frontend/parser/notation/fixtures/operator_equality_chain_bad.rhm")')
  ~throws "associative"

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/frontend/parser/notation/fixtures/operator_comparison_chain_bad.rhm")')
  ~throws "associative"

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/frontend/parser/notation/fixtures/standard_operators_ok.rhm")')
  ~completes
