#lang rhombus/static

// Test-only installer for specifications whose equations are intentionally
// postulated. Production declarations use the proof-producing installers.

import:
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/datatype open
  rhombus/hol/terminate open
  rhombus/hol/recdef open

export:
  axiomatic_define

fun axiomatic_define(thy :: Theory,
                     spec :: FunSpec,
                     dts :: Map.of(Symbol, DatatypeSpec),
                     ~discharge: discharge :: maybe(Function.of_arity(1)) = #false)
     :: values(Theory, FunInfo):
  let measure:
    match spec.measure
    | #false: #false
    | m:
        unless discharge
        | error(~who: #'function,
                "a measure needs a prover to discharge its obligations",
                error.val(~label: "name", spec.name))
        Measure(m :~ Term, discharge :~ Function)
  let prepared = prepare_function(thy, spec, dts, ~measure: measure)
  install_axiomatic_function(thy, prepared, dts)
