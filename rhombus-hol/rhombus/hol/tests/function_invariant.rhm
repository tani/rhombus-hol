#lang rhombus/static

// `function` never adds an axiom.
//
// Whether a declaration was derived used to depend on which recursion scheme
// this version happened to handle, and a scheme it did not handle was
// postulated silently.  Now the ordinary form refuses and says what is wrong,
// and `axiomatic_function` is the word for "assume these equations".

import:
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/driver open
  rhombus/meta open
  "fixtures/axiomatic_ok.rhm"!hol_theory as axiomatic
  "fixtures/derived_twin.rhm"!hol_theory as derived

fun load(mp :: ModulePath):
  let e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }: Evaluator.instantiate(mp)

// -- the same declaration, two words -----------------------------------------
//
// Identical equations, and that is the point: the two forms differ in what
// they assume, not in what they mean.

def ax :~ HolState = axiomatic.theory
def dv :~ HolState = derived.theory

check:
  ax.funs[#'dbl].equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is dv.funs[#'dbl].equations.map(fun (t :: Thm): show(concl_of(t)))

// Two leaves, two axioms; the derived twin pays nothing beyond the base
// logic's four.
check axioms_of(ax.thy).length() ~is 4 + 2
check axioms_of(dv.thy).length() ~is 4

// -- and a refusal names its real cause --------------------------------------
//
// `fixtures/function_unsupported.rhm` rests on a `~measure` landing in a
// non-recursive datatype.  The message says that, rather than reporting an
// undeclared `Colour_lt` -- true, and no use to the author -- or blaming
// something that stopped being a reason to refuse.

check:
  try:
    block:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/function_unsupported.rhm")')
      "compiled"
    ~catch e :: Exn.Fail:
      cond
      | e.message.contains("must land in a declared datatype that recurses")
          && e.message.contains("Colour"): "refused, naming the measure"
      | ~else: "refused: " ++ e.message
  ~is "refused, naming the measure"
