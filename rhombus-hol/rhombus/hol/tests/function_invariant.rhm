#lang rhombus/static

// `function` never adds an axiom (PLAN.md section 9.33).
//
// Whether a declaration is derived used to depend on which recursion scheme
// this version happens to handle, and a scheme it did not handle was
// postulated silently.  Now the ordinary form refuses, naming what it could
// not do, and `axiomatic_function` is the word for "assume these equations".

import:
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/driver open
  rhombus/meta open
  "fixtures/axiomatic_ok.rhm"!hol_theory as axiomatic

// -- the ordinary form refuses, and says why ---------------------------------

check:
  try:
    block:
      let e = Evaluator.make_rhombus()
      parameterize { Evaluator.current: e }:
        Evaluator.instantiate(
          ModulePath'lib("rhombus/hol/tests/fixtures/function_unsupported.rhm")')
      "compiled"
    ~catch e :: Exn.Fail:
      cond
      | e.message.contains("no proof-producing definition compiler")
          && e.message.contains("axiomatic_function"): "refused, with advice"
      | ~else: "refused: " ++ e.message
  ~is "refused, with advice"

// -- and the explicit form still postulates ----------------------------------
//
// Same declaration, different word.  Two leaves, two axioms above the base
// logic's four -- which is exactly the cost the ordinary form now declines
// to pay on your behalf.

def st :~ HolState = axiomatic.theory

check axioms_of(st.thy).length() ~is 4 + 2

check:
  st.funs[#'f].equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["forall (x :: Colour): f(x, zero) === zero",
       "forall (x :: Colour, y :: Nat): f(x, succ(y)) === f(x, y)"]
