#lang rhombus/static

// `match`, `block:`, and `block: let ...` all work as general expressions
// usable anywhere an ordinary expression is expected (function arguments,
// theorem statements), not only in a function's tail position -- and the
// theorems stating their values prove outright.
//
// Regression for a real bug: `elaborate_match_expr_effect` used the raw,
// possibly-still-unbound expected-type metavariable (generated whenever
// `===`'s bidirectional argument elaboration checks a match/block against
// an inferred type) to validate each clause's body type via a naive `==`
// comparison, instead of resolving it through the substitution built up
// while elaborating the clauses -- exactly as `CoreFunctionExpr`
// elaboration already did. This rejected every match/block value used
// outside a function body with "a local function body has a different
// type from its result type", even when every branch was correctly and
// identically typed.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
  "compiled"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/match_as_expr_ok.rhm")')
  ~is "compiled"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/block_with_match_ok.rhm")')
  ~is "compiled"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/eager_let_expr_ok.rhm")')
  ~is "compiled"
