#lang rhombus/static

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel open
  rhombus/hol/hol_light/bool as b
  rhombus/hol/hol_light/drule as d
  rhombus/hol/hol_light/tactics as t
  rhombus/hol/hol_light/simp as s
  rhombus/hol/hol_light/parser as p
  rhombus/hol/hol_light/preterm as pt
  rhombus/hol/hol_light/printer as pr

def thy = b.base_theory()
def q = mk_var(#'q, b.bool)

check b.is_iff(mk_eq(q, q)) ~is #true
check:
  let th = b.TRUTH(thy)
  concl_of(th)
  ~is b.tm_true

check:
  let g = t.Goal([], mk_eq(q, q))
  let step = (t.REFL_TAC(thy)(g) :~ t.Step)
  concl_of(step.justify([]))
  ~is mk_eq(q, q)

check:
  let th = REFL(thy, q)
  let conv = s.REWRITE_CONV(thy, [th])
  conv(thy, q)
  ~is #false

check pr.string_of_term(q) ~is "q"
