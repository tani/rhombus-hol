#lang rhombus/static

import:
  rhombus/hol/htype open

def a = mk_tyvar(#'a)
def b = mk_tyvar(#'b)
def num = mk_tyapp(#'num, [])
def lista = mk_tyapp(#'list, [a])
def listnum = mk_tyapp(#'list, [num])

// -- construction goes through `mk_tyvar`/`mk_tyapp` ------------------------
//
// `TyVar` and `TyApp` are closed off the way `term.rhm` closes `FVar` and
// friends: there is one way to build a type, so there is one thing to audit.
// Unlike a term there is no invariant to check here -- a type constructor's
// arity lives in the theory, and `check_type` enforces it on everything that
// reaches a theorem -- so this buys uniformity, not soundness, and there is
// no `unsafe` back door to go with it.
def htype_eval:
  def e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }:
    Evaluator.import(ModulePath'rhombus/hol/htype')
  e

check:
  ~eval: htype_eval
  TyVar(#'a)
  ~throws "TyVar: undefined"
check:
  ~eval: htype_eval
  TyApp(#'num, [])
  ~throws "TyApp: undefined"

// but both are still annotations and binding patterns, which is what the
// rest of this file and every `match` on a type relies on
check a is_a TyVar ~is #true
check (match lista | TyApp(n, [arg]): [n, arg == (a :~ HType)]) ~is [#'list, #true]

// -- structural equality ---------------------------------------------------

check mk_tyvar(#'a) ~is a
check mk_tyapp(#'list, [mk_tyvar(#'a)]) ~is lista
check lista == listnum ~is #false

// -- constructors ----------------------------------------------------------

check bool_ty ~is mk_tyapp(#'bool, [])
check mk_fun(a, b) ~is mk_tyapp(#'fun, [a, b])
check is_fun(mk_fun(a, b)) ~is #true
check is_fun(num) ~is #false
check:
  let (d, r) = dest_fun(mk_fun(a, num))
  [d, r]
  ~is [a, num]
check dest_fun(num) ~throws "not a function type"

// -- type_vars: left-to-right, deduplicated --------------------------------

check type_vars(num) ~is []
check type_vars(mk_fun(a, mk_fun(b, a))) ~is [#'a, #'b]
check type_vars(mk_fun(b, a)) ~is [#'b, #'a]

// -- substitution ----------------------------------------------------------

check type_subst({}, lista) ~is lista
check type_subst({#'a: num}, lista) ~is listnum
check type_subst({#'a: num}, b) ~is b
check type_subst({#'a: num}, mk_fun(a, a)) ~is mk_fun(num, num)
// unchanged subterms are preserved by identity, not just by equality
check type_subst({#'b: num}, lista) ~is_now lista

// -- matching --------------------------------------------------------------

check type_match(a, num, {}) ~is {#'a: num}
check type_match(lista, listnum, {}) ~is {#'a: num}
check type_match(mk_fun(a, a), mk_fun(num, num), {}) ~is {#'a: num}
// a repeated pattern variable must be matched consistently
check type_match(mk_fun(a, a), mk_fun(num, bool_ty), {}) ~is #false
check type_match(num, a, {}) ~is #false
check type_match(mk_tyapp(#'list, [a]), mk_tyapp(#'set, [num]), {}) ~is #false
// matching is one-way: the result substitutes the pattern into the target
check:
  let s = type_match(mk_fun(a, lista), mk_fun(num, listnum), {})
  type_subst(s, mk_fun(a, lista))
  ~is mk_fun(num, listnum)

// -- occurs check ------------------------------------------------------------
//
// `type_unify` itself now lives in `rhombus-hol-prover/.../tyunify.rhm` -- see
// `tests/tyunify.rhm` -- since the kernel never unifies, only checks and
// matches (`check_type` / `type_match`).  `type_occurs` stays here: it is a
// small, general predicate on types, and `type_match`'s callers in the kernel
// have no need for it, but it is not unification-specific.

check type_occurs(#'a, lista) ~is #true
check type_occurs(#'b, lista) ~is #false

// -- total order -----------------------------------------------------------

check type_ord(a, a) ~is 0
check type_ord(a, b) ~is -1
check type_ord(b, a) ~is 1
// TyVar sorts before TyApp
check type_ord(a, num) ~is -1
check type_ord(num, a) ~is 1
check type_ord(num, bool_ty) ~is 1
check type_ord(lista, mk_tyapp(#'list, [b])) ~is -1
check type_ord(mk_tyapp(#'list, []), lista) ~is -1

// antisymmetry and reflexivity over a sample
check:
  let ts = [a, b, num, bool_ty, lista, listnum, mk_fun(a, b), mk_fun(num, num)]
  for all (x in ts, y in ts):
    type_ord(x, y) == -type_ord(y, x)
  ~is #true
check:
  let ts = [a, b, num, bool_ty, lista, listnum, mk_fun(a, b)]
  for all (x in ts, y in ts):
    (type_ord(x, y) == 0) == (x == y)
  ~is #true

// -- printing --------------------------------------------------------------

check type_to_string(a) ~is "?a"
check type_to_string(num) ~is "num"
check type_to_string(lista) ~is "list(?a)"
check type_to_string(mk_fun(a, b)) ~is "?a -> ?b"
// `->` is right-associative, so a function domain needs parentheses
check type_to_string(mk_fun(mk_fun(a, b), num)) ~is "(?a -> ?b) -> num"
check type_to_string(mk_fun(a, mk_fun(b, num))) ~is "?a -> ?b -> num"
