#lang rhombus/static

// Benchmark: what would it cost to route the kernel through Idris?
//
// Not a test -- it asserts nothing about correctness.  It exists to answer
// the one question that decides whether `kernel.rhm` can become glue over
// `idris-hol-kernel/`: how much does a rule application cost when it has to
// cross the codec (encode + call + decode), versus running natively?
//
// Conclusion: the Idris rules themselves run faster than the native ones,
// but the codec cost at the boundary dominates and is what made an earlier
// runtime integration a measurable regression.
//
// Run with:  racket -l racket/base -e '(require (file "..."))'  -- or just
//   raco test rhombus-hol/rhombus/hol/tests/idris_bench.rhm

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  lib("racket/base.rkt") as rb
  "idris_bridge.rhm" open

def bl = mk_tyapp(ty_bool, [])
def num = mk_tyapp(#'num, [])

def rthy0 = initial_theory()
def rthy1 = new_type(rthy0, #'num, 0)
def rthy2 = new_constant(rthy1, #'s, mk_fun(num, num))
def rthy = new_constant(rthy2, #'p, mk_fun(num, bl))

def ithy0 = ik.#{Kernel-initialTheory}(0)
def ithy1 = idr_run(ik.#{Kernel-newType}(ithy0, 1, idr_name(#'num), 0))[1]
def ithy2 = idr_run(ik.#{Kernel-newConstant}(ithy1, 2, idr_name(#'s), idr_htype(mk_fun(num, num))))[1]
def ithy = idr_run(ik.#{Kernel-newConstant}(ithy2, 3, idr_name(#'p), idr_htype(mk_fun(num, bl))))[1]

// `s (s (s ... zero))`, a spine of the shape rewriting actually walks.
def sc = mk_const(#'s, mk_fun(num, num))
fun spine(n :: Int) :: Term:
  if n == 0 | mk_var(#'x, num) | mk_comb(sc, spine(n - 1))

def small = spine(3)
def medium = spine(10)
def large = spine(30)

fun bench(label :: String, iters :: Int, thunk) :: List:
  thunk()  // warm up
  let t0 = rb.#{current-inexact-milliseconds}()
  for (_ in 0..iters): thunk()
  let t1 = rb.#{current-inexact-milliseconds}()
  [label, (t1 - t0) * 1000.0 / iters]  // microseconds per call

fun report(rows :: List) :: Void:
  for (r :: List in rows):
    println(to_string(r[0]) ++ ": " ++ to_string(r[1]) ++ " us/call")

def iters = 20000

println("== REFL, native vs via Idris (encode + call + decode) ==")
report([bench("native  small", iters, fun (): REFL(rthy, small)),
        bench("idris   small", iters,
              fun (): rhombus_term(ik.#{Kernel-conclOf}(
                        idr_run(ik.#{Kernel-reflR}(ithy, idr_term(small)))[1]))),
        bench("native  medium", iters, fun (): REFL(rthy, medium)),
        bench("idris   medium", iters,
              fun (): rhombus_term(ik.#{Kernel-conclOf}(
                        idr_run(ik.#{Kernel-reflR}(ithy, idr_term(medium)))[1]))),
        bench("native  large", iters div 4, fun (): REFL(rthy, large)),
        bench("idris   large", iters div 4,
              fun (): rhombus_term(ik.#{Kernel-conclOf}(
                        idr_run(ik.#{Kernel-reflR}(ithy, idr_term(large)))[1])))])

println("")
println("== where the Idris time goes (medium) ==")
def enc_medium = idr_term(medium)
def refl_medium = idr_run(ik.#{Kernel-reflR}(ithy, enc_medium))[1]
report([bench("encode only", iters, fun (): idr_term(medium)),
        bench("call only (pre-encoded)", iters,
              fun (): ik.#{Kernel-reflR}(ithy, enc_medium)),
        bench("decode only", iters,
              fun (): rhombus_term(ik.#{Kernel-conclOf}(refl_medium)))])

println("")
println("== MK_COMB and INST, the hot-path rules ==")
def rf = REFL(rthy, sc)
def rx = REFL(rthy, medium)
def if_ = idr_run(ik.#{Kernel-reflR}(ithy, idr_term(sc)))[1]
def ix = idr_run(ik.#{Kernel-reflR}(ithy, idr_term(medium)))[1]
def theta = [[mk_const(#'s, mk_fun(num, num)), mk_var(#'f, mk_fun(num, num))]]
def itheta = idr_theta(theta)

report([bench("native  MK_COMB", iters, fun (): MK_COMB(rf, rx)),
        bench("idris   MK_COMB (thms already on the Idris side)", iters,
              fun (): ik.#{Kernel-mkCombR}(if_, ix)),
        bench("native  INST", iters, fun (): INST(rthy, theta, rx)),
        bench("idris   INST (thm already on the Idris side)", iters,
              fun (): ik.#{Kernel-instR}(ithy, itheta, ix))])

println("")
println("== memoised codec: does caching kill the boundary cost? ==")

// Rewriting rebuilds spines but shares subterms, so a cache keyed on term
// identity should make encoding cost proportional to the *new* nodes rather
// than the whole term.  `hasheq` because Rhombus terms are immutable and
// structurally shared; identity is the cheap key.
def enc_cache = rb.#{make-weak-hasheq}()
def dec_cache = rb.#{make-weak-hasheq}()

fun menc(t :: Term) :: Any:
  let hit = rb.#{hash-ref}(enc_cache, t, #false)
  cond
  | hit: hit
  | ~else:
      let v:
        match t
        | FVar(n, ty): rb.#{vector}(0, idr_name(n), menc_ty(ty))
        | BVar(i, ty): rb.#{vector}(1, i, menc_ty(ty))
        | Const(n, ty): rb.#{vector}(2, idr_name(n), menc_ty(ty))
        | Comb(f, x): rb.#{vector}(3, menc(f), menc(x))
        | Abs(aty, b): rb.#{vector}(4, menc_ty(aty), menc(b))
      rb.#{hash-set!}(enc_cache, t, v)
      rb.#{hash-set!}(dec_cache, v, t)
      v

fun menc_ty(ty :: HType) :: Any:
  let hit = rb.#{hash-ref}(enc_cache, ty, #false)
  cond
  | hit: hit
  | ~else:
      let v = idr_htype(ty)
      rb.#{hash-set!}(enc_cache, ty, v)
      v

fun mdec(v :: Any) :: Term:
  let hit = rb.#{hash-ref}(dec_cache, v, #false)
  cond
  | hit: hit
  | ~else:
      let tag = rb.#{vector-ref}(v, 0)
      let t:
        cond
        | tag == 3: unsafe.raw_comb(mdec(rb.#{vector-ref}(v, 1)), mdec(rb.#{vector-ref}(v, 2)))
        | tag == 4: unsafe.raw_abs(rhombus_htype(rb.#{vector-ref}(v, 1)), mdec(rb.#{vector-ref}(v, 2)))
        | ~else: rhombus_term(v)
      rb.#{hash-set!}(dec_cache, v, t)
      t

// Prime the cache the way a rewriting pass would: the spine's subterms have
// all been seen, and each step builds one new node on top.
def _prime = menc(medium)
def grown = mk_comb(sc, medium)

report([bench("encode, cold each time (baseline)", iters, fun (): idr_term(grown)),
        bench("encode, memoised, one new node", iters, fun (): menc(grown)),
        bench("decode, cold each time (baseline)", iters,
              fun (): rhombus_term(ik.#{Kernel-conclOf}(refl_medium))),
        bench("decode, memoised", iters,
              fun (): mdec(ik.#{Kernel-conclOf}(refl_medium)))])

println("")
println("== full REFL round trip with a memoised codec ==")
report([bench("native  REFL medium", iters, fun (): REFL(rthy, medium)),
        bench("idris   REFL medium, memoised codec", iters,
              fun (): mdec(ik.#{Kernel-conclOf}(
                        idr_run(ik.#{Kernel-reflR}(ithy, menc(medium)))[1])))])
