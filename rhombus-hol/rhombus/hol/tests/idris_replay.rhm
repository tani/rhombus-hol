#lang rhombus/static

// Replay a real derivation through the Idris2 kernel.
//
// `idris_differential.rhm` compares the two kernels on synthetic input.
// This does the other half: it takes a derivation the *library itself*
// performs -- `bool.rhm`'s construction of the base theory, which is every
// logical constant Rhombus/HOL has plus its three axioms -- records the
// primitive steps it takes, and re-derives the whole thing with the Idris
// kernel, checking each resulting sequent.
//
// This is the shape of integration the proofs in `idris-kernel/` actually
// support.  Those proofs say the ten rules, *as the Idris kernel implements
// them*, produce well-formed theorems from theorems that kernel built.  A
// wiring that hands the Idris kernel a theorem manufactured elsewhere gets
// nothing from them -- the earlier, reverted runtime integration did just
// that, passing in a shared placeholder stamp so the lineage checks would
// trivially succeed.  Here the Idris kernel is handed no theorems at all:
// it is given a script of rule applications and builds every theorem
// itself, from its own `initialTheory`, which is exactly the situation the
// proofs are about.
//
// Which side is normative: the Idris kernel.  It is machine-checked --
// `%default total`, no `believe_me`, no holes, and all ten rules proved to
// produce well-formed theorems -- so a disagreement reported here is far
// more likely to be a bug in `kernel.rhm` than in `Kernel.idr`, and the fix
// belongs on the Rhombus side.  Revising the Idris kernel to match Rhombus
// would throw away the only independently verified artifact in the project.
// The exception is a discrepancy showing the Idris *statement* is the wrong
// specification (a rule HOL does not have, say); that is worth fixing there,
// and worth saying so explicitly.
//
// It also costs nothing at compile time.  Replay happens here, in a test,
// once -- not on `kernel.rhm`'s phase-1 hot path, which is what made the
// earlier integration a measurable regression for every downstream user.

import:
  rhombus/hol/private/htype open
  rhombus/hol/private/term open
  rhombus/hol/private/kernel open
  rhombus/hol/private/bool as bl
  lib("racket/base.rkt") as rb
  "idris_bridge.rhm" open

// -- recording -------------------------------------------------------------

// `build_base_theory` runs the whole base construction against a fresh
// theory, so recording it here is independent of the `base` the rest of the
// library is using.
//
// The construction itself only uses the extension principles, so a small
// derivation is run on top of it to reach the ten rules -- one application
// of each, over the base theory's own logical constants.
//
// It uses the primitives directly rather than `drule.rhm`'s derived rules,
// and not for convenience: those are built from theorems stamped in the
// library's own `base` lineage, which a freshly built base is deliberately
// incomparable with.  Passing one a fresh theory raises "theorems come from
// different theories" -- the lineage check doing exactly its job, and the
// same property `siblingsIncomparable` states in Kernel.idr.
//
// Recording construction and derivation in one trace keeps everything
// rooted at a single `initial_theory`, so the replay has one lineage to
// follow.
fun record_base() :: List:
  trace_start()
  let thy = bl.build_base_theory()
  let p = mk_var(#'p, bl.bool)
  let x = mk_var(#'x, bl.bool)
  let r_p = REFL(thy, p)
  let asm = ASSUME(thy, p)
  let idf = mk_abs(x, x)
  TRANS(r_p, r_p)
  MK_COMB(REFL(thy, idf), r_p)
  BETA(thy, mk_comb(idf, p))
  ABS(thy, x, REFL(thy, x))
  EQ_MP(r_p, asm)
  DEDUCT_ANTISYM_RULE(asm, asm)
  INST(thy, [[bl.tm_true, p]], asm)
  INST_TYPE(thy, {}, asm)
  trace_stop()

def steps :: List = record_base()

// The construction really is being captured -- a silently empty trace would
// make everything below pass for no reason.

// Every rule the base construction exercises, so a future change that starts
// using a rule the replayer does not implement fails here rather than being
// skipped.
def rules_used :: List:
  for values(acc :~ List = []) (s :: TraceStep in steps):
    if acc.contains(s.rule) | acc | acc ++ [s.rule]

// A silently empty or truncated trace would make everything below pass for
// no reason, and the rule list pins down that the derivation really does
// reach every primitive.
check steps.length() ~is 27
check rules_used.length() ~is 14

// -- replay ----------------------------------------------------------------

// Idris cannot mint identities, so the host supplies a fresh token per
// extension -- the precondition `siblingsIncomparable` in Kernel.idr takes.
def token :: Box = Box(0)
fun next_token() :: Any:
  let t = token.value
  token.value := t + 1
  t

// `thys` maps a recorded theory's stamp identity to the Idris theory the
// replay built for it; `thms` maps a recorded theorem's key to the Idris
// theorem.  Both are threaded rather than mutated so a failure cannot leave
// half-updated state behind.
class RState(thys :: Map, thms :: Map, bad :: List)

fun note_bad(st :: RState, what :: List) :: RState:
  if st.bad == [] | RState(st.thys, st.thms, [what]) | st

// A replayed theorem must have the sequent the Rhombus kernel recorded.
// This is the actual check: everything else is plumbing to reach it.
//
// Hypotheses are compared as a set: both kernels keep them sorted and
// deduplicated, but by different orders, and neither order is part of the
// contract -- see the note on `same_hyps` in `idris_differential.rhm`.
fun same_hyps(a :: List, b :: List) :: Boolean:
  a.length() == b.length() && (for all (h in a): b.contains(h))

fun register_thm(st :: RState, key :: List, v :: Any) :: RState:
  let ip = idr_parts(v)
  cond
  | same_hyps(ip[0], key[1] :~ List) && ip[1] == key[2]:
      RState(st.thys, st.thms ++ {key: v}, st.bad)
  | ~else:
      note_bad(st, ["sequent mismatch", key[2], ip[1]])

fun lookup_thy(st :: RState, id) :: Any:
  st.thys.get(id, #false)

fun lookup_thm(st :: RState, key :: List) :: Any:
  st.thms.get(key, #false)

// Idris tuples compile to Racket pairs, so `(Theory, Thm)` is one `cons` and
// `(Theory, Thm, Thm)` is a nested one.
fun fst(v :: Any) :: Any: rb.#{car}(v)
fun snd(v :: Any) :: Any: rb.#{cdr}(v)

// Apply one recorded step with the Idris kernel and check what comes back.
fun replay_step(st :: RState, s :: TraceStep) :: RState:
  cond
  | st.bad != []: st
  | ~else:
      let thy = if s.thy | lookup_thy(st, s.thy) | #false
      let args = s.thms.map(fun (k :: List): lookup_thm(st, k))
      cond
      | s.thy && !thy: note_bad(st, ["unknown theory", s.rule])
      | args.contains(#false): note_bad(st, ["unknown theorem", s.rule])
      | ~else:
          let out = run_rule(st, s, thy, args)
          cond
          | out[0] == "err": note_bad(st, ["idris rejected", s.rule])
          | ~else: absorb(st, s, out[1])

// The dispatch table: one line per primitive, mirroring `kernel.rhm`'s
// exports.  A rule with no case here is a hole in the replay, which is why
// `rules_used` is checked against this list below.
fun run_rule(st :: RState, s :: TraceStep, thy :: Any, args :: List) :: List:
  match s.rule
  | #'initial_theory: ["ok", ik.#{Kernel-initialTheory}(next_token())]
  | #'new_type:
      idr_run(ik.#{Kernel-newType}(thy, next_token(),
                                   idr_name(s.data[0] :~ Symbol),
                                   s.data[1]))
  | #'new_constant:
      idr_run(ik.#{Kernel-newConstant}(thy, next_token(),
                                       idr_name(s.data[0] :~ Symbol),
                                       idr_htype(s.data[1] :~ HType)))
  | #'new_axiom:
      idr_run(ik.#{Kernel-newAxiom}(thy, next_token(), idr_term(s.data[0] :~ Term)))
  | #'new_basic_definition:
      idr_run(ik.#{Kernel-newBasicDefinition}(thy, next_token(),
                                              idr_term(s.data[0] :~ Term)))
  | #'new_basic_type_definition:
      idr_run(ik.#{Kernel-newBasicTypeDefinition}(
                thy, next_token(),
                idr_name(s.data[0] :~ Symbol),
                idr_name(s.data[1] :~ Symbol),
                idr_name(s.data[2] :~ Symbol),
                args[0]))
  | #'REFL: idr_run(ik.#{Kernel-reflR}(thy, idr_term(s.data[0] :~ Term)))
  | #'ASSUME: idr_run(ik.#{Kernel-assumeR}(thy, idr_term(s.data[0] :~ Term)))
  | #'BETA: idr_run(ik.#{Kernel-betaR}(thy, idr_term(s.data[0] :~ Term)))
  | #'ABS:
      idr_run(ik.#{Kernel-absR}(thy, idr_term(s.data[0] :~ Term), args[0]))
  | #'TRANS: idr_run(ik.#{Kernel-transR}(args[0], args[1]))
  | #'MK_COMB: idr_run(ik.#{Kernel-mkCombR}(args[0], args[1]))
  | #'EQ_MP: idr_run(ik.#{Kernel-eqMpR}(args[0], args[1]))
  | #'DEDUCT_ANTISYM_RULE:
      idr_run(ik.#{Kernel-deductAntisymRule}(args[0], args[1]))
  | #'INST:
      idr_run(ik.#{Kernel-instR}(thy, idr_theta(s.data[0] :~ List), args[0]))
  | #'INST_TYPE:
      idr_run(ik.#{Kernel-instTypeR}(thy, idr_type_theta(s.data[0] :~ Map), args[0]))
  | ~else: ["err", #false]

// Register whatever the step produced, in the same slots the recording says
// it filled.
fun absorb(st :: RState, s :: TraceStep, v :: Any) :: RState:
  cond
  | s.out_thy && s.out_thms == []:
      RState(st.thys ++ {s.out_thy: v}, st.thms, st.bad)
  | s.out_thy && s.out_thms.length() == 1:
      let st2 = RState(st.thys ++ {s.out_thy: fst(v)}, st.thms, st.bad)
      register_thm(st2, s.out_thms[0], snd(v))
  | s.out_thy && s.out_thms.length() == 2:
      let st2 = RState(st.thys ++ {s.out_thy: fst(v)}, st.thms, st.bad)
      let st3 = register_thm(st2, s.out_thms[0], fst(snd(v)))
      register_thm(st3, s.out_thms[1], snd(snd(v)))
  | s.out_thms.length() == 1: register_thm(st, s.out_thms[0], v)
  | ~else: note_bad(st, ["unexpected step shape", s.rule])

def final :: RState:
  for values(st :~ RState = RState({}, {}, [])) (s :: TraceStep in steps):
    replay_step(st, s)

// -- what the replay establishes ------------------------------------------

// The Idris kernel re-derived every step, and every theorem it built has the
// sequent the Rhombus kernel recorded.
check final.bad ~is []

// Every rule the base construction used is one the dispatch above actually
// implements.  Without this, a rule falling through to the `~else` case
// would look like a rejection, and a rule the recording never captured
// would look like success.
def implemented :: List:
  [#'initial_theory, #'new_type, #'new_constant, #'new_axiom,
   #'new_basic_definition, #'new_basic_type_definition,
   #'REFL, #'ASSUME, #'BETA, #'ABS, #'TRANS, #'MK_COMB, #'EQ_MP,
   #'DEDUCT_ANTISYM_RULE, #'INST, #'INST_TYPE]

check (for values(bad :~ List = []) (r :: Symbol in rules_used):
         if implemented.contains(r) | bad | bad ++ [r]) ~is []

// Every distinct theorem the recording produced was rebuilt and registered
// by the Idris kernel -- nothing was skipped.  Distinct, because a
// derivation naturally reproves things: `TRANS(r_p, r_p)` and `INST` on an
// assumption both land on sequents already recorded, and those share a key
// by design (see `thm_key` in kernel.rhm -- theorems agreeing on stamp and
// sequent are interchangeable for replay).
def recorded_keys :: List:
  for values(acc :~ List = []) (s :: TraceStep in steps):
    for values(a :~ List = acc) (k :: List in s.out_thms):
      if a.contains(k) | a | a ++ [k]

check final.thms.length() ~is recorded_keys.length()

// -- the recorder does not disturb the kernel -----------------------------

// Tracing is off by default and leaves no trace of itself: the same
// derivation run without recording gives the same theorems.
check bl.build_base_theory().axioms.length() ~is bl.build_base_theory().axioms.length()
check trace_stop() ~is []
