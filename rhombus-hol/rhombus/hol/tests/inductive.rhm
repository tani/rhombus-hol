#lang rhombus/static

// `inductive/define.rhm`: the least predicate closed under a rule set, and
// the introduction, induction and inversion theorems derived from it.
//
// The predicate used here is `q` over booleans, with rules
//
//   q(true)            and     !x. q(x) ==> q(not x)
//
// which exercises both a rule with no premises and a rule whose premise is a
// recursive occurrence -- the case the derivation has to transport through
// monotonicity.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/logic/drule open
  rhombus/hol/inductive/define open

def thy0 = base_theory()
def pred_ty = mk_fun(bool, bool)
def pv = mk_var(#'P, pred_ty)
def x = mk_var(#'x, bool)

def base_rule = mk_comb(pv, tm_true)
def step_rule = mk_forall(x, mk_imp(mk_comb(pv, x),
                                    mk_comb(pv, mk_neg(x))))

def (thy1, thms) = define_inductive(thy0, #'q, pv, [base_rule, step_rule])
def q = mk_const(#'q, pred_ty)

// -- a definitional extension, and nothing more ------------------------------

check descends(thy0.stamp, thy1.stamp) ~is #true
check axioms_of(thy1).length() ~is axioms_of(thy0).length()
check:
  for any (th in thms.introductions ++ [thms.induction, thms.cases]):
    hyps_of(th :~ Thm).length() != 0
  ~is #false
// -- introduction: `q` is closed under both rules ----------------------------

check concl_of(thms.introductions[0]) ~is mk_comb(q, tm_true)
check:
  concl_of(thms.introductions[1])
  ~is mk_forall(x, mk_imp(mk_comb(q, x), mk_comb(q, mk_neg(x))))

// -- induction: any rule-closed predicate contains `q` -----------------------

check:
  concl_of(thms.induction)
  ~is mk_forall(pv,
                mk_imp(base_rule,
                       mk_imp(step_rule,
                              mk_forall(x, mk_imp(mk_comb(q, x),
                                                  mk_comb(pv, x))))))

// -- cases: membership came from one of the rules ----------------------------
//
// The inversion theorem is the converse of closure, and it is the part that
// an encoding alone does not give: it holds because `q` is the *least* such
// predicate, and the derivation proves it by induction at the strengthened
// predicate.

def y = mk_var(#'x0, bool)
check:
  concl_of(thms.cases)
  ~is mk_forall(y,
                mk_imp(mk_comb(q, y),
                       mk_disj(mk_eq(y, tm_true),
                               mk_exists(x, mk_conj(mk_comb(q, x),
                                                    mk_eq(y, mk_neg(x)))))))

// -- the theorems compose ----------------------------------------------------
//
// `q(not true)` needs the step rule applied to the base rule, and inverting
// that membership hands back the premise it was built from.

def not_true = MP(thy1, SPEC(thy1, tm_true, thms.introductions[1]),
                  thms.introductions[0])
check concl_of(not_true) ~is mk_comb(q, mk_neg(tm_true))
check:
  concl_of(MP(thy1, SPEC(thy1, mk_neg(tm_true), thms.cases), not_true))
  ~is mk_disj(mk_eq(mk_neg(tm_true), tm_true),
              mk_exists(x, mk_conj(mk_comb(q, x),
                                   mk_eq(mk_neg(tm_true), mk_neg(x)))))
