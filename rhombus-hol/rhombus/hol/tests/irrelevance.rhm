#lang rhombus/static

// Elimination of irrelevance.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/bool open
  rhombus/hol/goal open
  rhombus/hol/irrelevance open
  "spec_prelude.rhm" open

def P = prelude
def thy = P.thy

def x = v(#'x, nat_ty)
def y = v(#'y, nat_ty)
def z = v(#'z, nat_ty)
def w = v(#'w, nat_ty)
fun succ_(a): ap1(P.succ, a)

// -- when the stage applies --------------------------------------------------

check:
  // `mk_eq(y, z)` shares no variable with the conclusion at all
  let g = mk_goal([mk_eq(x, succ_(x)), mk_eq(y, z)], mk_eq(x, x))
  relevant_hyps(g)
  ~is [mk_eq(x, succ_(x))]
check:
  // nothing to drop: every hypothesis is already relevant
  let g = mk_goal([mk_eq(x, succ_(x))], mk_eq(x, x))
  eliminate_irrelevance_goal(g)
  ~is #false
check:
  // transitivity: `w === z` shares nothing with the conclusion directly, but
  // `y === w` ties it to a hypothesis that does -- both are kept.
  // (`relevant_hyps` returns them in discovery order, not source order --
  // `eliminate_irrelevance_goal` re-sorts to source order for the subgoal.)
  let g = mk_goal([mk_eq(y, x), mk_eq(w, z), mk_eq(y, w)], mk_eq(x, x))
  relevant_hyps(g)
  ~is [mk_eq(y, x), mk_eq(y, w), mk_eq(w, z)]

// -- what it produces, and that it really proves the original ---------------

check:
  let g = mk_goal([mk_eq(x, x), mk_eq(y, z)], mk_eq(x, x))
  let st = eliminate_irrelevance_goal(g) :~ Step
  (st.subgoals[0] :~ Goal).asms
  ~is [mk_eq(x, x)]
def refl_x = REFL(thy, x)
check:
  let g = mk_goal([mk_eq(x, x), mk_eq(y, z)], mk_eq(x, x))
  let st = eliminate_irrelevance_goal(g) :~ Step
  st.justify([refl_x])
  ~is refl_x
