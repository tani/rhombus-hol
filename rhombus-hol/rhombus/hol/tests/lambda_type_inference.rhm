#lang rhombus/static

// An anonymous function's parameter/result types, when omitted, are
// inferred from an enclosing expected function type. Each fixture states
// the applied lambda's value as a theorem, so a successful proof is the
// evidence: an unresolved or wrongly-inferred type would fail to
// elaborate, and a correctly-inferred one reduces to the stated value.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
  "compiled"

// Parameter type inferred from the expected function type.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/lambda_type_inference_ok.rhm")')
  ~is "compiled"

// Result type inferred the same way.
check:
  load(
    ModulePath'lib("rhombus/hol/tests/fixtures/lambda_result_type_inference_ok.rhm")')
  ~is "compiled"
