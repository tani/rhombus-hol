#lang rhombus

// M0: the pieces the language layer is built out of must be usable directly.
//
//  * the kernel is an ordinary phase-0 module, so it imports and tests plainly
//    -- this is the payoff of writing it with no `meta:` blocks;
//  * a `#lang rhombus/hol` module is importable from plain `#lang rhombus`
//    (spec 4.3, in embryo);
//  * `rhombus/hol` can be imported into an evaluator.  That is how the rest of
//    the suite will drive HOL forms, and their compile-time errors, from a
//    plain `#lang rhombus` test file.

import:
  rhombus/hol/private/kernel as kernel
  "lang_export.rhm" as m

check kernel.hol_version ~is "0.1"
check m.double(21) ~is 42

check Evaluator.module_is_declared(ModulePath'rhombus/hol', ~load: #true) ~is #true

def hol_eval:
  def e = Evaluator.make_rhombus_empty()
  parameterize { Evaluator.current: e }:
    Evaluator.import(ModulePath'rhombus/hol')
  e

check:
  ~eval: hol_eval
  [1, 2, 3].map(fun (x): x * 2)
  ~is [2, 4, 6]
