#lang rhombus/static

// R1a: logical state threads through a `#lang rhombus/hol` module body and is
// private to each module.
//
// Both fixtures declare the same logical names. Each also proves a theorem
// using the function and type declared immediately before it. Compiling them
// in one evaluator therefore proves both properties: the state advances
// within a module, while no declaration leaks into the next module.

import:
  "fixtures/state_a.rhm" as a
  "fixtures/state_b.rhm" as b
  "fixtures/macro_declarations_ok.rhm" as generated

check a.marker ~is "a"
check b.marker ~is "b"
check generated.sample ~is generated.generated()

check:
  let e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }:
    Evaluator.instantiate(ModulePath'lib("rhombus/hol/tests/fixtures/state_a.rhm")')
    Evaluator.instantiate(ModulePath'lib("rhombus/hol/tests/fixtures/state_b.rhm")')
  #true
  ~is #true
