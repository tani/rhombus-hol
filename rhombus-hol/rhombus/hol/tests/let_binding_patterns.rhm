#lang rhombus/static

// A `let` binder can destructure through any irrefutable pattern (not
// just a bare variable), e.g. a constructor pattern for a
// single-constructor datatype like `Pair`. A refutable pattern (a
// constructor that is not the sole constructor of its datatype) is
// rejected, since nothing checks it against every possible shape at
// binding time.

import:
  "fixture_load.rhm" open

fun stuck_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

def refutable_message:
  stuck_message(ModulePath'lib("rhombus/hol/tests/fixtures/let_refutable_pattern_bad.rhm")')

check:
  block:
    instantiate_hol_fixture(
      ModulePath'lib("rhombus/hol/tests/fixtures/let_pair_pattern_ok.rhm")')
    "compiled"
  ~is "compiled"
check refutable_message.contains("a binder accepts only irrefutable patterns") ~is #true
check refutable_message.contains("`cons` is not the sole constructor") ~is #true
