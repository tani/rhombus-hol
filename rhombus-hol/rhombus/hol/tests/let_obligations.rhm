#lang rhombus/static

// A `let` initializer's evaluation is an obligation, even when its value is
// not used (PLAN.md section 9.26).
//
// `let` is substituted rather than bound, so an initializer only reaches the
// equations where the variable is read.  The compiled Rhombus evaluates it
// regardless.  Left alone, that lets a function be *proved* about while its
// compiled form diverges:
//
//   function bad(n :: Nat) :: Nat:
//     let unused = bad(n)
//     zero()
//
// elaborated to `!n. bad(n) = zero`, derived with no axioms, termination
// method `none` -- and `bad(zero())` never returns.  The theorem is not false
// in HOL, where functions are total; what it is not is a statement about the
// program that was compiled.
//
// The clause now carries its evaluation obligations beside its right-hand
// side (`core.rhm`), and the termination checker reads both.  So the call is
// *seen*: `bad` is refused because it does not terminate, and a recursive
// initializer that does terminate is accepted.

import:
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/driver open
  "fixtures/let_recursive_ok.rhm" as ok
  "fixtures/let_recursive_ok.rhm"!hol_theory as okm

fun load(mp :: ModulePath):
  let e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }: Evaluator.instantiate(mp)

// -- the dropped call is seen, and judged on its merits ----------------------
//
// Refused for non-termination -- naming the call the logical reading does
// not contain -- rather than for the syntactic shape of the declaration.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/let_recursive_bad.rhm")')
  ~throws "cannot see that the definition terminates"

// -- and a terminating one is accepted ---------------------------------------
def st :~ HolState = okm.theory

check st.funs[#'dbl].recinfo.method ~is #'structural
check:
  st.funs[#'dbl].equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["dbl(zero) === zero",
       "forall (x :: Nat): dbl(succ(x)) === succ(succ(dbl(x)))"]

// and it runs, which is the half the logic cannot see
check ok.dbl(ok.succ(ok.zero())) ~is ok.succ(ok.succ(ok.zero()))

// `unread`'s initializer recurses and its body never reads it.  The call
// descends, so it is fine -- and the equation says nothing about it, which
// is correct: the equation is about the value.
check st.funs[#'unread].recinfo.method ~is #'structural
check:
  st.funs[#'unread].equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["unread(zero) === zero",
       "forall (x :: Nat): unread(succ(x)) === succ(zero)"]

check ok.unread(ok.succ(ok.zero())) ~is ok.succ(ok.zero())
