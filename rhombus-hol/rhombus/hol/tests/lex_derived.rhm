#lang rhombus/static

// Lexicographic descent, derived rather than postulated
// through the well-founded recursion construction.
//
// `g` shrinks its first argument at one call while growing the second, and
// leaves the first alone while shrinking the second at the other.  No single
// column descends everywhere, so this is the case that needs `LEX`.

import:
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/driver open
  "fixtures/lex_derived.rhm"!hol_theory as m
  "fixtures/lexicographic_ok.rhm"!hol_theory as lexicographic

def st :~ HolState = m.theory

// -- no axiom -----------------------------------------------------------------
//
// One recursive datatype and one lexicographically recursive function over
// it: the base logic's three plus infinity, and nothing else.  Before `LEX`
// this function's three leaves were postulated.

check axioms_of(st.thy).length() ~is 4

// -- and the equations are the clauses ----------------------------------------

check:
  st.funs[#'g].equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["forall (x :: Nat): g(zero, x) === zero",
       "forall (x :: Nat): g(succ(x), zero) === g(x, succ(succ(zero)))",
       "forall (x :: Nat, y :: Nat): g(succ(x), succ(y)) === g(succ(x), y)"]

check:
  for values(hs :~ List = []) (t in st.funs[#'g].equations):
    hs ++ hyps_of(t :~ Thm)
  ~is []

// -- it is a definition, not a constant with axioms about it -------------------

check definition_of(st.thy, #'g) != #false ~is #true

// -- Ackermann, and a lexicographic definition at a concrete instance ---------
//
// `ack`'s third clause has a recursive call inside another recursive call's
// arguments; `merge` takes `List(Nat)` rather than the declaration's own
// `List(~a)`.  Both used to be postulated, for reasons that had nothing to
// do with the order they recurse in.

check axioms_of((lexicographic.theory :~ HolState).thy).length() ~is 4

check:
  (lexicographic.theory :~ HolState).funs[#'ack].equations
    .map(fun (t :: Thm): show(concl_of(t)))
  ~is ["forall (x :: Nat): ack(zero, x) === succ(x)",
       "forall (x :: Nat): ack(succ(x), zero) === ack(x, succ(zero))",
       "forall (x :: Nat, y :: Nat): "
         ++ "ack(succ(x), succ(y)) === ack(x, ack(succ(x), y))"]

check:
  (lexicographic.theory :~ HolState).funs[#'merge].equations
    .map(fun (t :: Thm): show(concl_of(t)))
  ~is ["forall (x :: List(Nat)): merge(Nil, x) === x",
       "forall (x :: Nat, y :: List(Nat)): merge(Cons(x, y), Nil) === Cons(x, y)",
       "forall (x :: Nat, y :: List(Nat), z :: Nat, u :: List(Nat)): "
         ++ "merge(Cons(x, y), Cons(z, u)) === Cons(x, Cons(z, merge(y, u)))"]
