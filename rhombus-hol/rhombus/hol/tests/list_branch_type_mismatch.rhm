#lang rhombus/static

// Every branch of a conditional building a `List.of(?a)` value must agree
// on the concrete element type `?a`, not just on the outer declared result
// type. Two branches building lists of genuinely different element types
// must be rejected even though both are literally `List.of(...)`.

import:
  "fixture_load.rhm" open

fun bad_message() :: String:
  try:
    block:
      instantiate_hol_fixture(
        ModulePath'lib("rhombus/hol/tests/fixtures/list_branch_type_mismatch_bad.rhm")')
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

check bad_message().contains("unexpected type") ~is #true
