#lang rhombus/static

// `[e, ...]` bracket list literals desugar to nested `cons`/`nil`
// application (`elab.rhm`'s `elaborate_list_at_type`) over whatever
// datatype provides those names -- not a builtin list type. Untested
// until now: the fixture's own theorems double as the proof that every
// shape (multiple elements, bound variables, the empty list, and `&`
// tail splicing) elaborates to the equation it claims.

import:
  "fixture_load.rhm" open

check:
  instantiate_hol_fixture(ModulePath'lib("rhombus/hol/tests/fixtures/list_literal_ok.rhm")')
  ~completes
