#lang rhombus/static

// Bracket lists normalize to globally resolved `cons`/`nil` calls over the
// datatype that provides those names. The fixture proves multiple elements,
// variables, the empty list, and tail splicing through the ordinary call path.

import:
  "fixture_load.rhm" open

def load_positive = make_hol_fixture_loader()

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/fixtures/list_literal_ok.rhm")')
  ~completes
