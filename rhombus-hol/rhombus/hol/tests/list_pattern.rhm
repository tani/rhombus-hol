#lang rhombus/static

// Bracket list patterns work in `match`, normalizing to nested cons/nil
// constructor patterns: empty, single-element, and multi-element with
// tail-splice all prove outright.

import:
  "fixture_load.rhm" open

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/fixtures/list_pattern_ok.rhm")')
  "compiled"
  ~is "compiled"
