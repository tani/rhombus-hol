#lang rhombus/static

// `exists`, `exists1`, `select`, and a Set comprehension applied as a
// predicate all elaborate together correctly inside one theorem's
// conjunction, confirming the logical binders compose rather than being
// mutually exclusive surface forms.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

fun stuck_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

def message:
  stuck_message(ModulePath'lib("rhombus/hol/tests/logic/fixtures/composed_binders_stuck.rhm")')

check message.contains("could not prove") ~is #true
