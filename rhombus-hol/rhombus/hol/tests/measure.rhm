#lang rhombus/static

// R2: termination by a measure, at the surface.
//
// The structural check is syntactic and generates nothing to prove.  A measure
// is a claim, one obligation per recursive call, and each one goes through the
// waterfall while the module compiles -- so an unprovable measure is a compile
// error, not a runtime surprise.

import:
  "fixture_load.rhm" open
  "fixtures/measure_ok.rhm" as m

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

fun bad(which :: Symbol):
  match which
  | #'missing:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/measure_missing.rhm")')
  | #'constant:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/measure_constant.rhm")')
  | #'not_datatype:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/measure_not_datatype.rhm")')
  | #'nonrecursive_measure:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/measure_nonrecursive.rhm")')
fun bad_message(which :: Symbol) :: String:
  try:
    block:
      bad(which)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

// -- the executable half still computes --------------------------------------

check m.count(m.two) ~is m.two
check m.count(m.zero()) ~is m.zero()
check m.down(m.two) ~is m.two
check m.down(m.zero()) ~is m.zero()

// -- without the measure, the same definition is refused ---------------------
//
// This is what makes the fixture above a real test of the measure: the
// structural checker genuinely cannot see it.

def missing_message = bad_message(#'missing)
def constant_message = bad_message(#'constant)
def not_datatype_message = bad_message(#'not_datatype)
def nonrecursive_measure_message = bad_message(#'nonrecursive_measure)

check missing_message.contains("cannot see that the definition terminates") ~is #true
check missing_message.contains("count(pred_of(succ(k)))") ~is #true

// -- a measure that does not decrease is refused, with the obligation --------

// The message carries the obligation and the leftover goal, because "the
// measure did not decrease" on its own gives the author nothing to act on.
check constant_message.contains("cannot see that the measure decreases") ~is #true
check constant_message.contains("Nat_lt(zero, zero)") ~is #true
check constant_message.contains("could not prove") ~is #true

// -- the measure has to land somewhere well-founded --------------------------

// "Declared" is not enough: the type needs a subterm relation to decrease
// in, and only a recursive datatype has one.  `bool` fails the first half,
// a non-recursive datatype the second, and both say so the same way.
check not_datatype_message.contains("must land in a declared datatype that recurses") ~is #true
check nonrecursive_measure_message.contains("no subterm relation") ~is #true
