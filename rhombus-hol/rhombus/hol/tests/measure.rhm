#lang rhombus/static

// R2: termination by a measure, at the surface.
//
// The structural check is syntactic and generates nothing to prove.  A measure
// is a claim, one obligation per recursive call, and each one goes through the
// waterfall while the module compiles -- so an unprovable measure is a compile
// error, not a runtime surprise.

import:
  "fixtures/measure_ok.rhm" as m

fun load(mp :: ModulePath):
  let e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }: Evaluator.instantiate(mp)

fun bad(which :: Symbol):
  match which
  | #'missing:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/measure_missing.rhm")')
  | #'constant:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/measure_constant.rhm")')
  | #'not_datatype:
      load(ModulePath'lib("rhombus/hol/tests/fixtures/measure_not_datatype.rhm")')

// -- the executable half still computes --------------------------------------

check m.count(m.two) ~is m.two
check m.count(m.zero()) ~is m.zero()
check m.down(m.two) ~is m.two
check m.down(m.zero()) ~is m.zero()

// -- without the measure, the same definition is refused ---------------------
//
// This is what makes the fixture above a real test of the measure: the
// structural checker genuinely cannot see it.

check bad(#'missing) ~throws "cannot see that the definition terminates"
check bad(#'missing) ~throws "count(pred_of(succ(k)))"

// -- a measure that does not decrease is refused, with the obligation --------
//
// The message carries the obligation and the leftover goal, because "the
// measure did not decrease" on its own gives the author nothing to act on.

check bad(#'constant) ~throws "cannot see that the measure decreases"
check bad(#'constant) ~throws "Nat_lt(zero, zero)"
check bad(#'constant) ~throws "could not prove"

// -- the measure has to land somewhere well-founded --------------------------

check bad(#'not_datatype) ~throws "must land in a declared datatype"
