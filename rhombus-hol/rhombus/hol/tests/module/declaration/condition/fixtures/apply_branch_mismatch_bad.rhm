#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Weird
| w()

function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))

// An operand still has to match the applied function's own domain: the
// general apply case's unconditional unify against a fresh function
// shape does not let a wrong-typed argument escape.
function mismatched_apply_branch(x :: Boolean) :: Nat:
  if x
  | plus(w(), zero())
  | zero()
