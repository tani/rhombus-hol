#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

function inc(n :: Nat) :: Nat: succ(n)

// `inc` takes exactly one argument: applying it to two is a genuine
// "the applied expression is not a function" shape, caught here by an
// unconditional unify against a fresh function type (not a retry
// through the un-migrated path) once the result type is consumed and
// found not to be a function while an argument still remains.
function bad_overapply_branch(x :: Boolean) :: Nat:
  if x
  | inc(zero(), zero())
  | zero()
