#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

// A `conj`/`disj`/`imp`/`neg` operand still has to be `Boolean`: the
// special-cased rendering does not let a non-Boolean argument escape
// ordinary unification just because there is no function-type
// consultation.
function bad_conj_branch(x :: Boolean) :: Boolean:
  if x
  | zero() && #true
  | #false
