#lang rhombus/hol

// Each connective has a HOL spelling and a Rhombus spelling for one constant,
// and both spellings have both readings.

export:
  hol_spelling

// HOL spellings in an executable function.
function hol_spelling(a :: Boolean, b :: Boolean) :: Boolean:
  a and not b or a === b

// Rhombus spellings in a theorem.
theorem rhombus_spelling:
  forall (a :: Boolean, b :: Boolean): (a && !a) == false || (b || !b)
