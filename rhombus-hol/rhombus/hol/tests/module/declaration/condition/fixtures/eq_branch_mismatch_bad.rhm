#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Weird
| w()

// Neither operand needs an expected type here (both are self-sufficient
// constructor applications), so `eq`'s own `~else` branch checks each
// independently and unifies their types directly -- this still has to
// reject a genuine mismatch, not silently accept it because there was
// no destructuring step to fail.
function mismatched_eq_branch(x :: Boolean) :: Boolean:
  if x
  | zero() == w()
  | #false
