#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

datatype Codepoint
| codepoint(codepoint_value :: Nat)

datatype String
| text(codepoints :: List.of(Codepoint))

// A string literal's checked type is unconditionally `String`: it still
// has to agree with the `if`'s other branch (here `Nat`), not escape
// ordinary unification just because there is no destructuring step.
function mismatched_string_branch(b :: Boolean) :: Nat:
  if b
  | "hi"
  | zero()
