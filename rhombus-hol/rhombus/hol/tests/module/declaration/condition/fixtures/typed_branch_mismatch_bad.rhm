#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Weird
| w()

// A type-ascribed `if` branch must still agree with the other branch's
// type: the ascription pins `inner`'s own type, but does not let it
// escape the surrounding `if`'s ordinary type unification.
function mismatched_branch(b :: Boolean) :: Nat:
  if b
  | (w() :: Weird)
  | succ(zero())
