#lang rhombus/hol

// `datatype` emits executable classes and registers the datatype logically.

export:
  Nil
  Cons
  List
  zero
  succ
  Nat
  sample

datatype List.of(?a)
| Nil()
| Cons(head :: ?a, tail :: List.of(?a))

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Tree.of(?a)
| leaf()
| node(value :: ?a, left :: Tree.of(?a), right :: Tree.of(?a))

def sample = Cons(1, Cons(2, Nil()))
