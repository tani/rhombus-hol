#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

// `select` has no executable interpretation. A definition must still admit it
// as an ordinary HOL term and make its equation available to later definitions.
definition choose_zero :: Nat:
  select (n :: Nat): n === zero()

// Parameters are lambda-bound only in logic. The declared type is
// polymorphic, and the basic definition's applied equation is a rewrite rule.
definition logical_identity(value :: ?a) :: ?a:
  value

theorem logical_identity_zero:
  logical_identity(zero()) === zero()

definition choice_is_self_equal :: Boolean:
  choose_zero === choose_zero

theorem choice_is_self_equal_holds:
  choice_is_self_equal
