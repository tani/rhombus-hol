#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

// `a` reaches for `b` before `b`'s own `let` has been reached -- a forward
// local-function reference, not supported for the same reason self-recursion
// through local-function sugar is not: it would need a mutual-recursion
// justification this sugar does not provide.
function outer(n :: Nat) :: Nat:
  function a(k :: Nat) :: Nat:
    b(k)
  function b(k :: Nat) :: Nat:
    k
  a(n)
