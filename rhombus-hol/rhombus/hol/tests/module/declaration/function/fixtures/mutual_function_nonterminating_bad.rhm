#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

// The calls between the members never reach a strict subterm, so no column
// carries a descent order for the family and no measure was supplied. The
// declaration is refused rather than assumed.
function.together:
  function ping(n :: Nat) :: Nat
  | (zero()): zero()
  | (succ(k)): pong(succ(k))
  function pong(n :: Nat) :: Nat
  | (zero()): zero()
  | (succ(k)): ping(succ(k))

def marker = "compiled"
