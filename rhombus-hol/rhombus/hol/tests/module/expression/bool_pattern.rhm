#lang rhombus/static

// `#true`/`#false` as patterns. `bool` is a primitive kernel type rather
// than a declaration, so `initial_context` installs a `DatatypeThms` for
// it derived from `BOOL_CASES_AX` (`bool_datatype.rhm`); from the pattern
// compiler's point of view it is then an ordinary two-nullary-constructor
// datatype, totality check included.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

def load_positive = make_hol_fixture_loader()

fun load(mp :: ModulePath):
  load_positive(mp)
  "compiled"

fun error_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

// Both literals as patterns, nested matches on them, and the derived
// equations reducing -- including `negate(negate(b)) === b` for a
// *variable* `b`, which needs the cases/induction theorem, not just the
// two ground equations.
check:
  load(ModulePath'lib("rhombus/hol/tests/module/expression/fixtures/bool_pattern_ok.rhm")')
  ~is "compiled"

// `#false` is a constructor of `bool`, so omitting it is a missing case.
check:
  error_message(
    ModulePath'lib("rhombus/hol/tests/module/expression/fixtures/bool_pattern_partial_bad.rhm")')
    .contains("not exhaustive")
  ~is #true
