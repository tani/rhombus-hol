#lang rhombus/hol

// Core anonymous/local function scenarios from the "First-Class Local
// Functions" design: anonymous functions as first-class values, returned
// as higher-order results, capturing enclosing lexical variables, local
// functions referencing earlier local functions, and arbitrarily deep
// non-recursive nesting. Each proves outright; see
// `local_mutual_recursion_bad.rhm` for the rejected mutual-recursion case.

export: Nat zero succ apply1 anon_as_value make_succ capture_test nested_test earlier_ref

datatype Nat
| zero()
| succ(pred :: Nat)

function apply1(f :: Nat -> Nat, n :: Nat) :: Nat:
  f(n)

// An anonymous function used as an ordinary first-class value bound by
// `let`, then applied.
function anon_as_value(n :: Nat) :: Nat:
  let id_fn = function (x :: Nat) :: Nat: x
  id_fn(n)

theorem anon_value_zero:
  anon_as_value(zero()) === zero()

// A function returning a higher-order function value (`Nat -> Nat`),
// applied at the call site.
function make_succ() :: Nat -> Nat:
  function (x :: Nat) :: Nat: succ(x)

theorem higher_order_result:
  apply1(make_succ(), zero()) === succ(zero())

// Lexical capture: an anonymous function's body is free in `x`, bound by
// the enclosing function, not by the anonymous function's own parameter.
function capture_test(x :: Nat) :: Nat:
  apply1(function (y :: Nat) :: Nat: succ(x), zero())

theorem capture_zero:
  capture_test(zero()) === succ(zero())

// A local function (`g`) nested inside another local function (`f`),
// itself nested inside the top-level function. Confirms arbitrarily deep
// non-recursive local-function nesting elaborates soundly.
function nested_test(x :: Nat) :: Nat:
  function f(y :: Nat) :: Nat:
    function g(z :: Nat) :: Nat:
      succ(z)
    g(g(y))
  f(x)

theorem nested_zero:
  nested_test(zero()) === succ(succ(zero()))

// `g`, declared after `f`, may call `f` (earlier local-function
// references are visible; see `local_mutual_recursion_bad.rhm` for the
// rejected converse).
function earlier_ref(x :: Nat) :: Nat:
  function f(y :: Nat) :: Nat: succ(y)
  function g(y :: Nat) :: Nat: f(f(y))
  g(x)

theorem earlier_ref_zero:
  earlier_ref(zero()) === succ(succ(zero()))
