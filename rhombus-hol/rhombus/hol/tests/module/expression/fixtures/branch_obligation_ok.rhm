#lang rhombus/hol

// The termination checker tracks each recursive call's descent
// obligation under the specific match-branch condition that reaches it,
// not globally: `halve`'s deepest branch (`succ(succ(k))`) recurses on
// `k`, two constructors smaller than `n`; the `succ(zero())` branch has
// no recursive call at all. Both must be recognized as sound
// independently for the whole definition to be accepted.

export: Nat zero succ halve

datatype Nat
| zero()
| succ(pred :: Nat)

function halve(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(zero()): zero()
  | succ(succ(k)): succ(halve(k))

theorem halve_zero:
  halve(zero()) === zero()

theorem halve_one:
  halve(succ(zero())) === zero()

theorem halve_two:
  halve(succ(succ(zero()))) === succ(zero())
