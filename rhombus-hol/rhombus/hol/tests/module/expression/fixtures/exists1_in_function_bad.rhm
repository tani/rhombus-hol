#lang rhombus/hol

// `exists1` is a logical (prop) construct, not an executable one: it
// asserts unique existence without computing a witness. A `function`
// body must be admits only the executable subset of expressions, so
// `exists1` inside one is rejected, not silently accepted as if it
// somehow compiled to a decision procedure.

datatype Nat
| zero()
| succ(pred :: Nat)

function has_unique_zero(n :: Nat) :: Boolean:
  exists1 (x :: Nat): x === n
