#lang rhombus/hol

// `exists1 (x :: T): P(x)` and `select (x :: T): P(x)` desugar to `exists1(fun
// (x :: T): P(x))` / `select(fun (x :: T): P(x))`
// (`frontend/parser/space.rhm`'s single-binder productions) -- a well-typed
// goal the waterfall can *state*, whether or not it can discharge it
// automatically. The default waterfall does not yet unfold `exists1`/ `select`
// on its own (no rewrite rule or dedicated tactic recognizes a call to either
// as existential), so both theorems are expected to reach a genuine stuck goal
// rather than fail to parse or elaborate.

datatype Nat
| zero()
| succ(pred :: Nat)

theorem exists1_zero:
  exists1 (x :: Nat): x === zero()

theorem select_zero:
  (select (x :: Nat): x === zero()) === zero()
