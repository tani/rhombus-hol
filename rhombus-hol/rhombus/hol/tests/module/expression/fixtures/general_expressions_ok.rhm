#lang rhombus/hol

// `match`, `block:`, and `block: let ...` all work as general expressions
// usable anywhere an ordinary expression is expected (function arguments,
// theorem statements), not only in a function's tail position -- and the
// theorems stating their values prove outright.
//
// An expected type can start as an unresolved metavariable while a `match` or
// `block` in an equality operand constrains it. Clause result types must be
// compared after applying the accumulated substitution; the examples below
// exercise that bidirectional path.

export: Nat zero succ apply1

datatype Nat
| zero()
| succ(pred :: Nat)

// A `match` used directly as a general expression value (compared with
// `===` in a theorem statement, not confined to a function body's tail
// position). It proves outright because `prove_impl` beta-normalizes the
// goal before the waterfall runs, so the lambda the match compiles to is
// applied to its scrutinee first.
theorem bare_match:
  (match zero()
   | zero(): succ(zero())
   | succ(_): zero()) === succ(zero())

// A `block:` wrapping a `match`, used directly as a general expression
// value.
theorem block_with_match:
  (block:
     match zero()
     | zero(): succ(zero())
     | succ(_): zero()) === succ(zero())

// `block: let x = e1; e2` is the general-expression form of an eager
// `let`: it is usable anywhere an ordinary expression is expected,
// including as a function argument, not only in a function's own tail
// position. It proves outright, since the lambda it desugars to is
// beta-normalized with the goal before the waterfall runs.
function apply1(f :: Nat -> Nat, n :: Nat) :: Nat:
  f(n)

theorem let_as_arg:
  apply1(
    function (x :: Nat) :: Nat:
      let y = succ(x)
      y,
    block:
      let w = succ(zero())
      w) === succ(succ(zero()))
