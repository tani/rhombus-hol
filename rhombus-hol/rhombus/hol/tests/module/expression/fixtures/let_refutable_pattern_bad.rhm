#lang rhombus/hol

// A `let` binder accepts only irrefutable patterns: `cons(h, _)` is not
// the sole constructor of `List` (there is also `nil()`), so it must be
// rejected, not silently accepted as if it always matched.

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

function head_or_zero(xs :: List.of(Nat)) :: Nat:
  let cons(h, _) = xs
  h
