#lang rhombus/hol

// A named local function calling the currently-being-defined enclosing
// function (`outer` calling itself indirectly through `inner`) is
// rejected. Local `function` sugar is non-recursive lambda binding: it
// does not get to participate in `outer`'s own recursion, only ordinary
// lexical capture of already-bound names.

datatype Nat
| zero()
| succ(pred :: Nat)

function outer(x :: Nat) :: Nat:
  function inner(y :: Nat) :: Nat:
    outer(y)
  inner(x)
