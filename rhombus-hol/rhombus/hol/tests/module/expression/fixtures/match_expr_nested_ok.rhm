#lang rhombus/hol

// `match`'s scrutinee is an ordinary expression, not restricted to a bound
// variable, and a branch's body may itself be a `match` expression over a
// different scrutinee -- these are expression-level match nesting and
// scrutinee generality, distinct from nested *patterns* within one clause
// (see `nested_match_ok.rhm`).

export: Nat zero succ pred_of double_pred classify

datatype Nat
| zero()
| succ(pred :: Nat)

function pred_of(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): k

// scrutinee is a compound call expression, not a bare variable
function double_pred(n :: Nat) :: Nat:
  match succ(pred_of(n))
  | zero(): zero()
  | succ(k): succ(succ(k))

// a `match` expression nested inside another `match`'s branch
function classify(a :: Nat, b :: Nat) :: Nat:
  match a
  | zero():
      match b
      | zero(): zero()
      | succ(_): succ(zero())
  | succ(_): succ(succ(zero()))
