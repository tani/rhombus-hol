#lang rhombus/hol

// `Pair(a, b)` must infer its product type when equality elaborates each side
// independently, with no expected type supplied from outside the pair.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

theorem pair_expr_no_external_context:
  Pair(zero(), succ(zero())) === Pair(zero(), succ(zero()))
