#lang rhombus/hol

// `Set{x :: T | pred}` desugars to `CoreFunctionExpr([x :: T], Boolean,
// pred)`, an ordinary predicate value applied directly like any other
// `?a -> Boolean` function. Membership, non-membership, and
// omitted-type inference (`Set{x | pred}`, inferred from usage inside
// `pred`) all prove: each application is a beta redex, and `prove_impl`
// normalizes the goal before the waterfall runs.

export: Nat zero succ

datatype Nat
| zero()
| succ(pred :: Nat)

theorem comprehension_membership_true:
  Set{x :: Nat | x === zero()}(zero()) === #true

// Non-membership: the comprehension reduces and the constructor
// distinctness fact discharges what is left.
theorem comprehension_membership_false:
  Set{x :: Nat | x === zero()}(succ(zero())) === #false

// The comprehension's binder type is optional (`Set{x | pred}`), inferred
// from usage inside `pred` -- here from `x === zero()`, concretely `Nat`.
theorem comprehension_type_inferred:
  Set{x | x === zero()}(zero()) === #true
