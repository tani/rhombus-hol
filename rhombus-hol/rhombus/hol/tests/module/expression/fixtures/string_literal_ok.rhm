#lang rhombus/hol

// A string literal normalizes to
// `text(cons(codepoint(code), cons(codepoint(code), ... nil())))` over the
// declarations that provide `Nat`, `Codepoint`, `List.of(?a)`, and `String`.
// The reader decodes Unicode and control escapes before normalization. Each
// decoded scalar remains a compact native Nat literal inside `codepoint`.

export: Nat zero succ Codepoint codepoint List nil cons String text

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Codepoint
| codepoint(codepoint_value :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

datatype String
| text(codepoints :: List.of(Codepoint))

theorem string_literal_empty_representation:
  "" === text(nil())

theorem string_literal_ascii_representation:
  "hello"
    === text(
          cons(codepoint(104),
               cons(codepoint(101),
                    cons(codepoint(108),
                         cons(codepoint(108),
                              cons(codepoint(111), nil()))))))

theorem string_literal_unicode_escape_representation:
  "h\u00e9llo\u00e9"
    === text(
          cons(codepoint(104),
               cons(codepoint(233),
                    cons(codepoint(108),
                         cons(codepoint(108),
                              cons(codepoint(111),
                                   cons(codepoint(233), nil())))))))

theorem string_literal_cjk_representation:
  "日本語"
    === text(
          cons(codepoint(26085),
               cons(codepoint(26412),
                    cons(codepoint(35486), nil()))))

theorem string_literal_control_escape_representation:
  "a\nb\tc"
    === text(
          cons(codepoint(97),
               cons(codepoint(10),
                    cons(codepoint(98),
                         cons(codepoint(9),
                              cons(codepoint(99), nil()))))))
