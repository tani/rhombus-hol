#lang rhombus/static

// `match`, `block:`, and `block: let ...` all work as general expressions
// usable anywhere an ordinary expression is expected (function arguments,
// theorem statements), not only in a function's tail position -- and the
// theorems stating their values prove outright.
//
// Regression: an expected type can start as an unresolved metavariable while
// a `match` or `block` in an equality operand constrains it. Clause result
// types must be compared after applying the accumulated substitution, or a
// correctly typed general expression is spuriously rejected.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

def load_positive = make_hol_fixture_loader()

fun load(mp :: ModulePath):
  load_positive(mp)
  "compiled"

check:
  load(ModulePath'lib("rhombus/hol/tests/module/expression/fixtures/general_expressions_ok.rhm")')
  ~is "compiled"
