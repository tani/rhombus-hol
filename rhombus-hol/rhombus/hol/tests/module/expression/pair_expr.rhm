#lang rhombus/static

// Pair syntax normalizes to the ordinary product constructor. Its component
// types must still infer correctly when no surrounding expression supplies
// an expected product type.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

def load_positive = make_hol_fixture_loader()

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/module/expression/fixtures/pair_expr_ok.rhm")')
  ~completes
