#lang rhombus/static

// Set syntax normalizes to an ordinary predicate lambda: the empty set is
// `λ_. #false`, and a populated set is a disjunction of equalities.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

def load_positive = make_hol_fixture_loader()

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/module/expression/fixtures/set_literal_ok.rhm")')
  ~completes
