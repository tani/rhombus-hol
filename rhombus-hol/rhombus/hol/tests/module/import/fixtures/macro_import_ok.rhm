#lang rhombus/hol

import:
  rhombus/meta open

export: forwarded

// The theory-aware `import` binding remains an ordinary declaration macro, so
// an enclosing user macro can produce it without bypassing theory adoption.
// The result name comes from the call site; imported names follow ordinary
// macro hygiene and are consumed within the same expansion.
decl.macro 'use_theory $result_name':
  '«
     import: lib("rhombus/hol/tests/module/import/fixtures/theory_base.rhm") open

     // This lemma needs the theorem database imported above.
     theorem generated_import_state_is_visible:
       forall (xs :: List.of(?a), ys :: List.of(?a)):
         app(app(xs, Nil()), ys) === app(xs, ys)

     def $result_name = app(Cons(1, Nil()), Nil())
   »'

use_theory forwarded
