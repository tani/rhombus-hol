#lang rhombus/hol

// M0: `#lang rhombus/hol` must behave exactly like `#lang rhombus` for every
// program that uses no HOL form.

fun fact(n :: NonnegInt) :: PosInt:
  if n == 0 | 1 | n * fact(n-1)

check fact(5) ~is 120
check [1, 2, 3].map(fun (x): x * 2) ~is [2, 4, 6]

check:
  match [1, 2]
  | [x, y]: x + y
  | ~else: 0
  ~is 3
