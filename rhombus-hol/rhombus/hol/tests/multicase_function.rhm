#lang rhombus/static

// `function | (pat): body | ...` -- the case-clause form that supplies
// parameters via patterns instead of an explicit signature -- is
// supported both as a fully anonymous function value and as named local
// sugar, for every case (not just the first), correctly lowering to a
// decision tree over the declared datatype that reduces to the expected
// value.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
  "compiled"

// Named local sugar, both the `zero()` and the `succ(_)` case.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/local_multicase_ok.rhm")')
  ~is "compiled"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/local_multicase_succ_ok.rhm")')
  ~is "compiled"

// The same clause form as a fully anonymous function value.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/anon_multicase_ok.rhm")')
  ~is "compiled"
