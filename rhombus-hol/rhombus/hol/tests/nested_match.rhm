#lang rhombus/static

// Nested constructor patterns at the surface:
// `match` may refine a variable an *enclosing* pattern in the same clause
// already bound, not only a top-level parameter. The coverage checker
// (`recdef.rhm`) is now a genuine decision tree over
// arbitrarily deep patterns, `terminate.rhm`'s `descends_at` follows the
// same chain for termination, and the parser (`elab.rhm`) locates a
// `match`'s target by which pattern variable is still live, not by column
// index.

import:
  "fixture_load.rhm" open
  "fixtures/nested_match_ok.rhm" as f

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

// -- the emitted code computes, exactly like any other `function` -----------
//
// `module_block.rhm` emits `function` bodies verbatim, and ordinary Rhombus
// `match` has always supported nested patterns -- so the executable half
// needed no change at all; only the logical elaborator did.
check f.classify(f.sample0) ~is f.zero()
check f.classify(f.sample1) ~is f.succ(f.zero())
check f.classify(f.sample2) ~is f.succ(f.succ(f.zero()))
check f.classify(f.Cons(1, f.Cons(2, f.Cons(3, f.Nil())))) ~is f.succ(f.succ(f.zero()))

// -- a nested pattern that leaves a case uncovered is still caught ----------

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/nested_match_partial.rhm")')
  ~throws "not exhaustive"
