#lang rhombus/static

// A `function` that does not recurse is defined, never postulated, using a
// direct closed definition.
//
// Its decision tree is already a closed term once the tests are written with
// the datatype's discriminators and the variables read out with its
// selectors, so there is nothing to justify and nothing to assume.  The
// clausal equations come back by unfolding and reducing.

import:
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/driver open
  "fixtures/nonrec_defined.rhm"!hol_theory as m

def st :~ HolState = m.theory

fun eqs_of(n :: Symbol) :~ List:
  st.funs[n].equations.map(fun (t :: Thm): show(concl_of(t)))

// -- three functions, no axioms ----------------------------------------------
//
// Two non-recursive datatypes and three functions over them: the theory
// assumes exactly the base logic's four and nothing more.  Before this the
// three functions cost four axioms between them.

check axioms_of(st.thy).length() ~is 4

// -- and the equations are the ones that were declared -----------------------

check:
  eqs_of(#'idc)
  ~is ["forall (x :: Colour): idc(x) === x"]

check:
  eqs_of(#'swap)
  ~is ["forall (x :: Colour, y :: Colour): swap(MkPair(x, y)) === MkPair(y, x)"]

// Ordered clauses resolve per leaf: the catch-all holds only where the
// specific clause does not win, which is why `red` gets its own equation.
check:
  eqs_of(#'classify)
  ~is ["forall (x :: Colour): classify(MkPair(red, x)) === x",
       "forall (x :: Colour): classify(MkPair(green, x)) === green"]

// -- they are definitions, and they compute ----------------------------------

check definition_of(st.thy, #'swap) != #false ~is #true
check definition_of(st.thy, #'classify) != #false ~is #true

check:
  for values(hs :~ List = []) (n in [#'idc, #'swap, #'classify]):
    for values(acc :~ List = hs) (t in st.funs[n].equations):
      acc ++ hyps_of(t :~ Thm)
  ~is []
