#lang rhombus/static

// A bare numeral (`0`, `1`, ...) desugars to a constructor chain on
// *some* datatype via overload resolution. When two or more datatypes
// admit a zero-numeral reading and nothing disambiguates which one is
// meant, the numeral must be rejected rather than silently defaulted to
// an arbitrary datatype. An explicit type ascription resolves the same
// otherwise-ambiguous numeral.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

fun message_of(mp :: ModulePath) :: String:
  try:
    block:
      load(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

def ambiguous_message:
  message_of(
    ModulePath'lib("rhombus/hol/tests/fixtures/numeral_ambiguous_bad.rhm")')

check ambiguous_message.contains("a numeral needs a type ascription or an unambiguous numeric context") ~is #true

// The other rejection: an expected type that is already concrete and
// simply has no numeral representation. Nothing is ambiguous, so the
// diagnostic names the offending type instead of asking for an
// ascription -- and naming it needs the type constructor registry,
// which is why `check_expr` defers this one numeral case (alone) to
// its `fallback` rather than reporting it directly.
def concrete_mismatch_message:
  message_of(
    ModulePath'lib("rhombus/hol/tests/fixtures/numeral_concrete_mismatch_bad.rhm")')

check concrete_mismatch_message.contains("a numeral has no representation at type Boolean") ~is #true

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/numeral_disambiguated_ok.rhm")')
  "compiled"
  ~is "compiled"
