#lang rhombus/static

// Numeral literals are compact digit chains, and closed arithmetic on them is
// decided directly rather than by unfolding Peano definitions.
//
// The fixture's theorems are the real test: at these magnitudes a `succ`
// chain cannot even be built, so the fixture compiling at all is the claim
// that the digit representation and its conversions work end to end. What is
// checked here is the part that is not visible from the surface: the codec's
// canonical form, and that the whole thing rests on definitions rather than
// on new axioms.

import:
  "fixture_load.rhm" open
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/number/literal open

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/fixtures/numeral_arithmetic_ok.rhm")')
  ~completes

// A module with no addition has no digit constants and keeps unary literals.
check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/fixtures/numeral_no_addition_ok.rhm")')
  ~completes

// Integers and rationals compute through the same Nat arithmetic: their own
// definitions reduce to it.
check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/fixtures/numeral_int_rat_ok.rhm")')
  ~completes

// -- the codec --------------------------------------------------------------

// A shape standing for a theory's numeral vocabulary. The codec never looks
// anything up, so the constants need only exist as terms.
def nat_ty :: HType = mk_tyapp(#'Nat, [])
def unary_ty :: HType = mk_fun(nat_ty, nat_ty)
def shape:
  NumeralShape(nat_ty, #'zero, #'succ,
               mk_const(#'zero, nat_ty), mk_const(#'succ, unary_ty),
               mk_const(#'nat_bit0, unary_ty), mk_const(#'nat_bit1, unary_ty))

fun round_trip(n :: NonnegInt) :: maybe(NonnegInt):
  dest_numeral(shape, encode_numeral(shape, n))

check round_trip(0) ~is 0
check round_trip(1) ~is 1
check round_trip(2) ~is 2
check round_trip(255) ~is 255
check round_trip(123456) ~is 123456
check round_trip(80779853376) ~is 80779853376

// Zero is `zero()`, and no chain ends in `nat_bit0(zero())`: that is what
// makes two equal literals the same term, which is what lets the equality
// conversion answer by comparing structure.
check encode_numeral(shape, 0) ~is mk_const(#'zero, nat_ty)
check:
  encode_numeral(shape, 1)
  ~is mk_comb(mk_const(#'nat_bit1, unary_ty), mk_const(#'zero, nat_ty))
check:
  encode_numeral(shape, 2)
  ~is mk_comb(mk_const(#'nat_bit0, unary_ty), encode_numeral(shape, 1))

// The size of a literal is the number of bits in it, not the number itself.
fun node_count(t :: Term) :: NonnegInt:
  match t
  | Comb(f, x): 1 + node_count(f :~ Term) + node_count(x :~ Term)
  | ~else: 1
check node_count(encode_numeral(shape, 123456)) ~is 35

// A `succ` chain and a digit chain of the same value both decode, but only
// the digit chain is canonical: a conversion must rewrite the term it was
// given, so it asks for the canonical form and lets the traversal normalize
// the rest.
check dest_numeral(shape, unary_numeral(shape, 3)) ~is 3
check canonical_numeral(shape, unary_numeral(shape, 3)) ~is #false
check canonical_numeral(shape, encode_numeral(shape, 3)) ~is 3

// -- no new axioms ----------------------------------------------------------

// The digit constants are definitions, so a module full of numeral arithmetic
// rests on exactly the axioms the base theory already had.
import:
  rhombus/hol/frontend/driver open
  lib("rhombus/hol/tests/fixtures/numeral_arithmetic_ok.rhm")!hol_theory as arithmetic

def base :~ HolState = initial_state()
def final :~ HolState = arithmetic.theory

check axioms_of(final.ctx.thy).length() ~is axioms_of(base.ctx.thy).length()

// And the digit constants really are there, defined, in that module's theory.
check definition_of(final.ctx.thy, #'nat_bit0) is_a Thm ~is #true
check definition_of(final.ctx.thy, #'nat_bit1) is_a Thm ~is #true

// -- the conversions against native arithmetic ------------------------------

// The evaluator that is not trusted, checked against the theorems that are.
//
// For each pair, the conversion is asked what the sum, product, difference or
// comparison is, and the theorem it returns is read back: its left-hand side
// must be the term that was asked about, and its right-hand side must decode
// to what Racket's own arithmetic says. A conversion that computed the wrong
// answer could not produce a theorem at all -- the kernel would reject the
// step -- so what this really pins down is that it produces one at all, for
// every shape of carry and borrow these cases reach.
import:
  rhombus/hol/number/nat open
  rhombus/hol/number/conv open
  rhombus/hol/logic/bool open
  rhombus/hol/logic/conv open

def arith :~ NatArith:
  match nat_arith(final.ctx)
  | #false: error("the arithmetic fixture has no numeral arithmetic")
  | derived :: NatArith: derived

def thy = final.ctx.thy
def nat_shape :~ NumeralShape = arith.shape

fun literal(n :: NonnegInt) :: Term: encode_numeral(nat_shape, n)

// The right-hand side of `conv(op(a, b))`, as a number.
fun computed(op :: Term, a :: NonnegInt, b :: NonnegInt) :: maybe(NonnegInt):
  let t = mk_comb(mk_comb(op, literal(a)), literal(b))
  match nat_literal_conv(arith, final.ctx, thy, t)
  | #false: #false
  | th :: Thm:
      cond
      | lhs_of(th) != t: #false
      | ~else: dest_numeral(nat_shape, rhs_of(th))

def samples :~ List:
  [[0, 0], [0, 1], [1, 0], [1, 1], [2, 3], [7, 8], [15, 1], [16, 16],
   [255, 1], [256, 255], [1023, 1025], [123456, 654321], [654321, 123456],
   [99999, 99999], [1, 1048576]]

check:
  for all (pair in samples):
    let [a, b] = pair
    computed(arith.add_term, a, b) == a + b
  ~is #true

check:
  for all (pair in samples):
    let [a, b] = pair
    match arith.mul
    | #false: #true
    | mul :: NatMul: computed(mul.mul_term, a, b) == a * b
  ~is #true

check:
  for all (pair in samples):
    let [a, b] = pair
    match arith.sub
    | #false: #true
    | sub :: NatSub:
        computed(sub.sub_term, a, b) == math.max(0, a - b)
  ~is #true

// A comparison answers with a truth value rather than a number, so it is read
// back from the theorem's right-hand side directly.
check:
  for all (pair in samples):
    let [a, b] = pair
    match arith.order
    | #false: #true
    | order :: NatOrder:
        let t = mk_comb(mk_comb(order.le_term, literal(a)), literal(b))
        match nat_literal_conv(arith, final.ctx, thy, t)
        | #false: #false
        | th :: Thm:
            lhs_of(th) == t
              && rhs_of(th) == (if a <= b | tm_true | tm_false)
  ~is #true

// Equality and disequality, both orientations.
check:
  for all (pair in samples):
    let [a, b] = pair
    let t = mk_eq(literal(a), literal(b))
    match nat_literal_conv(arith, final.ctx, thy, t)
    | #false: #false
    | th :: Thm:
        lhs_of(th) == t
          && rhs_of(th) == (if a == b | tm_true | tm_false)
  ~is #true
