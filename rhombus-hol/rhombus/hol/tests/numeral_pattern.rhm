#lang rhombus/static

// Numeral patterns remain atomic through decision-tree compilation and use
// checked literal-equality guards. They participate in exhaustiveness and
// recursive congruence proofs like constructor patterns.

import:
  "fixture_load.rhm" open

check:
  instantiate_hol_fixture(ModulePath'lib("rhombus/hol/tests/fixtures/numeral_pattern_ok.rhm")')
  ~completes

check:
  instantiate_hol_fixture(ModulePath'lib("rhombus/hol/tests/fixtures/numeral_pattern_partial.rhm")')
  ~throws "definition is not exhaustive"
