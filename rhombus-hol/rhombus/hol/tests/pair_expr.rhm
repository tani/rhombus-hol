#lang rhombus/static

// Pair syntax normalizes to the ordinary product constructor. Its component
// types must still infer correctly when no surrounding expression supplies
// an expected product type.

import:
  "fixture_load.rhm" open

check:
  instantiate_hol_fixture(ModulePath'lib("rhombus/hol/tests/fixtures/pair_expr_ok.rhm")')
  ~completes
