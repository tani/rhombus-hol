#lang rhombus/static

// `Pair(a, b)` elaborated with no external expected type (`elab.rhm`'s
// `elaborate_pair_effect`'s `#false` branch) previously crashed: the branch
// order tried to resolve the *absence* of an expected type as an `HType`
// before checking for it, the same bug fixed alongside it in
// `elaborate_list_effect` and `elaborate_set_effect`.

import:
  "fixture_load.rhm" open

check:
  instantiate_hol_fixture(ModulePath'lib("rhombus/hol/tests/fixtures/pair_expr_ok.rhm")')
  ~completes
