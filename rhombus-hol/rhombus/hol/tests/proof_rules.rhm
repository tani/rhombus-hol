#lang rhombus/static

// Proof-local rule-database control through `~use`.

import:
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/frontend/driver open
  "fixtures/proof_use_ok.rhm"!hol_theory as m

def st :~ HolState = m.theory

// The fixture compiled, which is the claim: `~use: [plus_zero_r]` enabled that
// theorem only while proving `twice`, so the proof succeeded without
// induction.
check st.thms.get(#'plus_zero_r, #false) is_a Thm ~is #true
check st.thms.get(#'twice, #false) is_a Thm ~is #true

check:
  show(concl_of(st.thms[#'twice]))
  ~is "forall (x :: Nat): plus(plus(x, zero), zero) === x"
check hyps_of(st.thms[#'twice]) ~is []
