#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Integer
| int_nonnegative(nonnegative_value :: Nat)
| int_negative(negative_predecessor :: Nat)

function int_from_nat(n :: Nat) :: Integer:
  int_nonnegative(n)

theorem integer_literal_cannot_be_ascribed_nat:
  (+10 :: Nat) === 10
