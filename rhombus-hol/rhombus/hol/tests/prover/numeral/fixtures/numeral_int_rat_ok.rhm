#lang rhombus/hol

// Integers and rationals built on Peano naturals, as in the stdlib. Their
// definitions reduce closed expressions to Nat operations. Checked native
// Nat conversions make these large examples practical while every result
// remains a kernel theorem.

export: Nat zero succ Integer int_nonnegative int_negative Rational rational

datatype Nat
| zero()
| succ(pred :: Nat)

function nat_add(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(nat_add(k, n))

function nat_mul(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): zero()
  | succ(k): nat_add(n, nat_mul(k, n))

function nat_sub(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): zero()
  | succ(a):
      match n
      | zero(): succ(a)
      | succ(b): nat_sub(a, b)

function nat_le(m :: Nat, n :: Nat) :: Boolean:
  match m
  | zero(): #true
  | succ(a):
      match n
      | zero(): #false
      | succ(b): nat_le(a, b)

function nat_pred(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): k

datatype Integer
| int_nonnegative(nonnegative_value :: Nat)
| int_negative(negative_predecessor :: Nat)


function int_negative_nat(n :: Nat) :: Integer:
  match n
  | zero(): int_nonnegative(zero())
  | succ(k): int_negative(k)

function int_from_difference(a :: Nat, b :: Nat) :: Integer:
  if nat_le(b, a)
  | int_nonnegative(nat_sub(a, b))
  | int_negative(nat_pred(nat_sub(b, a)))

function int_add(x :: Integer, y :: Integer) :: Integer:
  match x
  | int_nonnegative(a):
      match y
      | int_nonnegative(b): int_nonnegative(nat_add(a, b))
      | int_negative(b): int_from_difference(a, succ(b))
  | int_negative(a):
      match y
      | int_nonnegative(b): int_from_difference(b, succ(a))
      | int_negative(b): int_negative(succ(nat_add(a, b)))

function int_multiply(x :: Integer, y :: Integer) :: Integer:
  match x
  | int_nonnegative(a):
      match y
      | int_nonnegative(b): int_nonnegative(nat_mul(a, b))
      | int_negative(b): int_negative_nat(nat_mul(a, succ(b)))
  | int_negative(a):
      match y
      | int_nonnegative(b): int_negative_nat(nat_mul(succ(a), b))
      | int_negative(b): int_nonnegative(nat_mul(succ(a), succ(b)))

datatype Rational
| rational(rational_numerator :: Integer, rational_denominator_pred :: Nat)

function rational_add(x :: Rational, y :: Rational) :: Rational:
  match x
  | rational(a, b):
      match y
      | rational(c, d):
          rational(
            int_add(
              int_multiply(a, int_nonnegative(succ(d))),
              int_multiply(c, int_nonnegative(succ(b)))),
            nat_pred(nat_mul(succ(b), succ(d))))

function rational_multiply(x :: Rational, y :: Rational) :: Rational:
  match x
  | rational(a, b):
      match y
      | rational(c, d):
          rational(int_multiply(a, c), nat_pred(nat_mul(succ(b), succ(d))))

function rational_equivalent(x :: Rational, y :: Rational) :: Boolean:
  match x
  | rational(a, b):
      match y
      | rational(c, d):
          int_multiply(a, int_nonnegative(succ(d)))
            == int_multiply(c, int_nonnegative(succ(b)))

// 2/3 + 5/7 = 29/21
theorem sum_of_fractions:
  rational_add(rational(int_nonnegative(2), 2),
               rational(int_nonnegative(5), 6))
    === rational(int_nonnegative(29), 20)

// Large multiplication still reduces through native Nat arithmetic.
theorem large_product:
  rational_multiply(rational(int_nonnegative(123456), 788),
                    rational(int_nonnegative(789), 123455))
    === rational(int_nonnegative(97406784), 97406783)

// Rational equivalence cross-multiplies both sides.
theorem equivalent_fractions:
  rational_equivalent(rational(int_nonnegative(2), 2),
                      rational(int_nonnegative(4), 5))

// (-2/3) * (4/5) = -8/15
theorem negative_product:
  rational_multiply(rational(int_negative(1), 2),
                    rational(int_nonnegative(4), 4))
    === rational(int_negative(7), 14)

// -- integers ---------------------------------------------------------------

theorem int_sum_positive:
  int_add(int_nonnegative(123456), int_nonnegative(654321))
    === int_nonnegative(777777)

// -123456 + 654321 = 530865
theorem int_sum_mixed:
  int_add(int_negative(123455), int_nonnegative(654321))
    === int_nonnegative(530865)

// -12345 * -6789 = 83810205
theorem int_product_negative:
  int_multiply(int_negative(12344), int_negative(6788))
    === int_nonnegative(83810205)

theorem int_product_mixed:
  int_multiply(int_negative(12344), int_nonnegative(6789))
    === int_negative(83810204)
