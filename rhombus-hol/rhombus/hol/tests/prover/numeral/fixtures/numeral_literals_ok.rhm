#lang rhombus/hol

export:
  Nat
  zero
  succ
  Integer
  int_nonnegative
  int_negative
  runtime_nat_literal
  runtime_positive_integer
  runtime_negative_integer
  runtime_integer_add_literal

datatype Nat
| zero()
| succ(pred :: Nat)

function nat_add(_x :: Nat, y :: Nat) :: Nat:
  y

datatype Integer
| int_nonnegative(nonnegative_value :: Nat)
| int_negative(negative_predecessor :: Nat)

function int_from_nat(n :: Nat) :: Integer:
  int_nonnegative(n)

function int_negate(z :: Integer) :: Integer:
  match z
  | int_nonnegative(zero()): int_nonnegative(zero())
  | int_nonnegative(succ(n)): int_negative(n)
  | int_negative(n): int_nonnegative(succ(n))

function int_add(_x :: Integer, y :: Integer) :: Integer:
  y

overload add(Nat, Nat) = nat_add
overload add(Integer, Integer) = int_add
overload negate(Integer) = int_negate

// A bare numeral has type Nat without help from an expected type.
theorem uncontextualized_nat_literal:
  10 === 10

// Explicit signs are part of an Integer literal, including zero.
theorem positive_integer_literal:
  +10 === int_from_nat(10)

theorem negative_integer_literal:
  -10 === int_negative(9)

theorem positive_integer_zero:
  +0 === int_from_nat(0)

theorem negative_integer_zero:
  -0 === int_from_nat(0)

// Literal types select overloaded arithmetic directly.
theorem nat_overload_selection:
  1 + 10 === nat_add(1, 10)

theorem integer_overload_selection:
  forall (a :: Integer): a + +10 === int_add(a, int_from_nat(10))

// Negating an expression remains the overloadable operator; it is distinct
// from the lexical negative-literal form above.
theorem unary_negation_of_expression:
  forall (a :: Integer): -a === int_negate(a)

function runtime_nat_literal() :: Nat:
  10

function runtime_positive_integer() :: Integer:
  +10

function runtime_negative_integer() :: Integer:
  -10

function runtime_integer_add_literal(a :: Integer) :: Integer:
  a + +10
