#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Integer
| int_nonnegative(nonnegative_value :: Nat)
| int_negative(negative_predecessor :: Nat)

function int_from_nat(n :: Nat) :: Integer:
  int_nonnegative(n)

function accept_integer(z :: Integer) :: Integer:
  z

theorem nat_literal_is_not_an_integer_argument:
  accept_integer(10) === int_from_nat(10)
