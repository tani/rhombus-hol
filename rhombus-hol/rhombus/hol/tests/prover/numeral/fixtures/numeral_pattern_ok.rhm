#lang rhombus/hol

// Numeral patterns remain atomic through decision-tree compilation and use
// checked literal-equality guards. They participate in exhaustiveness and
// recursive congruence proofs like constructor patterns.

export: Nat zero succ classify List Nil Cons strip_literals

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a):
| Nil
| Cons(head :: ?a, tail :: List.of(?a))

function classify(n :: Nat) :: Nat:
  match n
  | 0: zero()
  | 1: succ(zero())
  | _: succ(succ(zero()))

theorem classify_zero:
  classify(zero()) === zero()
theorem classify_one:
  classify(succ(zero())) === succ(zero())
theorem classify_two:
  classify(succ(succ(zero()))) === succ(succ(zero()))

function strip_literals(xs :: List.of(Nat)) :: Nat
| (Nil()): 0
| (Cons(0, tail)): succ(strip_literals(tail))
| (Cons(1, tail)): strip_literals(tail)
| (Cons(_, tail)): strip_literals(tail)

theorem strip_literal_branches:
  strip_literals(Cons((0 :: Nat), Cons((1 :: Nat), Nil()))) === (1 :: Nat)

// Runtime constructor patterns decompose the compact integer representation.
// The nested case observes two predecessor steps, including at a value that
// was supplied directly as a host integer.
function drop_two(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(zero()): zero()
  | succ(succ(rest)): rest

function drain(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(rest): drain(rest)

function apply_nat_constructor(f :: Nat -> Nat, n :: Nat) :: Nat:
  f(n)

check classify(0) ~is 0
check classify(1) ~is 1
check classify(2) ~is 2
check drop_two(0) ~is 0
check drop_two(1) ~is 0
check drop_two(42) ~is 40
check drain(64) ~is 0
check apply_nat_constructor(succ, 41) ~is 42
