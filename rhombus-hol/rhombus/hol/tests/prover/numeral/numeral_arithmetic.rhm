#lang rhombus/static

// Surface fixtures exercise compact native literals through equality,
// ordering, addition, multiplication, subtraction, and exponentiation.
// Their large closed theorems cannot succeed by successor unfolding.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open
  rhombus/hol/kernel open
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/backend/proof/driver open
  lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_arithmetic_ok.rhm")!hol_theory as arithmetic

def load_positive = make_hol_fixture_loader()

check:
  load_positive(
    ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_arithmetic_ok.rhm")')
  ~completes

// Equality and literal-pattern discrimination need only the native Nat
// datatype evidence; arithmetic declarations are not a prerequisite.
check:
  load_positive(
    ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_no_addition_ok.rhm")')
  ~completes

// Integer and rational computation reduces through the same checked native
// Nat conversions.
check:
  load_positive(
    ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_int_rat_ok.rhm")')
  ~completes

// Proof-local disabling governs native arithmetic and the one-layer
// constructor exposure used to connect NatLit values with ordinary rules.
check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_disable_arithmetic_bad.rhm")')
  ~throws "could not prove"
check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_disable_exposure_bad.rhm")')
  ~throws "could not prove"

def base :~ HolState = initial_state()
def final :~ HolState = arithmetic.theory

// Native conversions extend no axioms.
check axioms_of(final.ctx.thy).length() ~is axioms_of(base.ctx.thy).length()
// A large literal remains one atomic kernel node.
def large = mk_nat_lit(final.ctx.thy, 80779853376)
check type_of(large) ~is mk_tyapp(#'Nat, [])
check term_to_string(large) ~is "80779853376"
