#lang rhombus/static

// Surface numeral forms have fixed types before any surrounding expression
// is checked. The positive fixture covers both logical and executable
// readings; the negative fixtures prohibit implicit numeric conversion.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open
  lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_literals_ok.rhm") as literals

def load_positive = make_hol_fixture_loader()

check:
  load_positive(
    ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_literals_ok.rhm")')
  ~completes

check literals.runtime_nat_literal() ~is 10
check literals.runtime_positive_integer() ~is literals.int_nonnegative(10)
check literals.runtime_negative_integer() ~is literals.int_negative(9)
check:
  literals.runtime_integer_add_literal(literals.int_negative(0))
  ~is literals.int_nonnegative(10)

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_nat_as_integer_bad.rhm")')
  ~throws "expression has an unexpected type"

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_int_as_nat_bad.rhm")')
  ~throws "expression has an unexpected type"

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_nat_to_integer_bad.rhm")')
  ~throws "expression has an unexpected type"
