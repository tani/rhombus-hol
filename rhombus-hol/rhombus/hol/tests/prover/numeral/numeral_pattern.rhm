#lang rhombus/static

// Natural numeral patterns remain atomic through decision-tree compilation
// and use checked literal-equality guards. They participate in exhaustiveness
// and recursive congruence proofs like constructor patterns.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

def load_positive = make_hol_fixture_loader()

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_pattern_ok.rhm")')
  ~completes

check:
  instantiate_hol_fixture(ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_pattern_partial.rhm")')
  ~throws "definition is not exhaustive"

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_positive_pattern_bad.rhm")')
  ~throws "signed integer patterns are not supported"

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/prover/numeral/fixtures/numeral_negative_pattern_bad.rhm")')
  ~throws "signed integer patterns are not supported"
