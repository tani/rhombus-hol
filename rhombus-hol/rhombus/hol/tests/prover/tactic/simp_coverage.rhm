#lang rhombus/static

// Facts the simplifier reached no rule for, each a separate cause:
// constructor distinctness stated in only one orientation, the product
// projections' equations never registered as rules, and a set literal's
// binder built from an unresolved element metavariable.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

def load_positive = make_hol_fixture_loader()

check:
  block:
    load_positive(
      ModulePath'lib("rhombus/hol/tests/prover/tactic/fixtures/simp_coverage_ok.rhm")')
    "compiled"
  ~is "compiled"
