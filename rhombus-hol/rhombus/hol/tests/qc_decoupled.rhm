#lang rhombus

// R4's generators and shrinkers live in a run-time registry
// (`qc.rhm`'s `register_gen`/`lookup_gen` and their `_shrink` counterparts),
// keyed by the type's own name, rather than in an identifier `check_property`
// has to guess and the declaring module has to export under a fixed
// convention.  This removes two couplings at once:
//
//  * `check_property` no longer needs to import the module that declared the
//    type it draws from -- being reachable transitively, through some other
//    import, is enough, since registration is an ordinary run-time effect of
//    instantiating whatever pulls the declaring module in.
//  * `check_property` no longer needs a `#lang rhombus/hol` module to live
//    in at all: it is an ordinary bound macro, importable into plain
//    `#lang rhombus` like any other.

import:
  rhombus/hol.check_property
  rhombus/hol/qc open
  // Deliberately not "fixtures/qc_registry_provider.rhm", which declares
  // `Nat` -- only the module that re-exports it without using it itself.
  "fixtures/qc_registry_middle.rhm" open

check_property double_grows_by_two:
  forall (n :: Nat): double(succ(n)) == succ(succ(double(n)))

check double_grows_by_two ~matches QCPassed(100)
