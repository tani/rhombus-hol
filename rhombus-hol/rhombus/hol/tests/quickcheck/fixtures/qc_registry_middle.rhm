#lang rhombus/hol

// Imports `Nat` and re-exports it, but does not itself use `quickcheck`.

export:
  Nat
  zero
  succ
  double

import: lib("rhombus/hol/tests/quickcheck/fixtures/qc_registry_provider.rhm") open

function double(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): succ(succ(double(k)))
