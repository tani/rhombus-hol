#lang rhombus/hol

import: lib("rhombus/hol/tests/quickcheck/fixtures/qc_local.rhm") open

// `==>` in a quickcheck property body: a false antecedent must still be
// treated as vacuously true, so this property is falsified only by an input
// where the antecedent holds and the consequent does not.
quickcheck implication_wrong(~samples: 200, ~seed: 12345):
  forall (n :: Nat):
    nat_is_zero(n) ==> n === succ(zero())
