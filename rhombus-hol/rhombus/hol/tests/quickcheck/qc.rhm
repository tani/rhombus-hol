#lang rhombus/static

// `quickcheck` runs the executable reading of a HOL proposition at module
// initialization. Successful declarations produce no binding; a falsified
// property fails immediately with its reproducible seed and shrunk inputs.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open
  rhombus/hol/quickcheck open
  lib("rhombus/hol/tests/quickcheck/fixtures/qc_local.rhm") as q

fun load_variable_type():
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/quickcheck/fixtures/qc_variable_type.rhm")')
fun load_wrong():
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/quickcheck/fixtures/quickcheck_wrong.rhm")')
fun load_shrink_wrong():
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/quickcheck/fixtures/quickcheck_shrink_wrong.rhm")')
fun load_implication_wrong():
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/quickcheck/fixtures/quickcheck_implication_wrong.rhm")')

// Importing the fixture executes all three successful quickchecks.
check q.plus(q.zero(), q.zero()) ~is q.zero()

check:
  load_variable_type()
  ~throws "a quickcheck input type must be concrete"

check:
  load_wrong()
  ~throws "counterexample found"

check:
  load_wrong()
  ~throws "seed: 12345"

check:
  load_shrink_wrong()
  ~throws "shrinks:"

// `==>` reaches the executable reading only via a quickcheck property (a
// `function`/`definition` body cannot use it, `core_allowed` restricts it to
// proposition context) -- this is the one path that exercises it, and a
// false antecedent must not be treated as automatically falsifying.
check:
  load_implication_wrong()
  ~throws "counterexample found"

// The generator primitive still chooses only base constructors at size zero.
check:
  pick(0, [fun (): "base"], [fun (): "base", fun (): "recursive"])
  ~is "base"
