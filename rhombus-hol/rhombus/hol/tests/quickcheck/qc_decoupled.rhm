#lang rhombus/hol

// Generators and shrinkers are found through the run-time registry even when
// the datatype is available only through a transitive import.

import:
  lib("rhombus/hol/tests/quickcheck/fixtures/qc_registry_middle.rhm") open

quickcheck double_grows_by_two:
  forall (n :: Nat):
    double(succ(n)) === succ(succ(double(n)))
