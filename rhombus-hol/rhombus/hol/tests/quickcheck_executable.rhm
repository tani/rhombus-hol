#lang rhombus/static

// A `quickcheck` property statement itself may use ordinary executable
// constructs (`if`, `block: let ...`), not just `forall` plus equality,
// since it is sampled by running the executable reading directly.

import:
  "fixture_load.rhm" open

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/fixtures/quickcheck_executable_ok.rhm")')
  "compiled"
  ~is "compiled"
