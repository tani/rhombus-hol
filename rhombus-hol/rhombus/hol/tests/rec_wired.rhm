#lang rhombus/static

// A self-recursive `type` declaration, derived.
//
// The point of this file is the axiom count of a real module, because that
// is the only number a reader can check without following the construction:
// declare two self-recursive datatypes and count what the module's theory
// assumes.

import:
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/datatype open
  rhombus/hol/driver open
  "fixtures/rec_derived.rhm" as f
  "fixtures/rec_derived.rhm"!hol_theory as m

def st :~ HolState = m.theory

// -- what a module with two recursive datatypes assumes -----------------------
//
// Four: the three of the base logic and the one axiom of infinity -- shared,
// not per datatype.  Nothing about either datatype is among them: not the
// constructors' properties, nor the equations of the
// subterm relation either, which are now proved from `TC` of a non-recursive
// child predicate.  Declaring a third recursive datatype would not move this
// number.
check axioms_of(st.ctx.thy).length() ~is 4

check:
  axioms_of(st.ctx.thy).map(fun (t :: Thm): show(concl_of(t)))
  ~is ["exists (x :: ind -> ind): (forall (y :: ind, z :: ind): x(y) === x(z) ==> y === z) and exists (y :: ind): forall (z :: ind): not (x(z) === y)",
       "forall (x :: bool): (x <=> true) or (x <=> false)",
       "forall (x :: ?a -> bool, y :: ?a): x(y) ==> x(select(x))",
       "forall (x :: ?a -> ?b): (fun (y :: ?a): x(y)) === x"]

// -- the subterm relation is still there, as theorems -------------------------
//
// Same statements as before, on the other side of the line.
check:
  st.ctx.funs[#'List_lt].equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["forall (x :: List(?a)): List_lt(x, Nil) <=> false",
       "forall (x :: List(?a), y :: ?a, z :: List(?a)): List_lt(x, Cons(y, z)) <=> x === z or List_lt(x, z)"]

check:
  for values(hs :~ List = []) (t in st.ctx.funs[#'List_lt].equations):
    hs ++ hyps_of(t :~ Thm)
  ~is []

// -- and the properties really are there, as theorems -------------------------
def dt :~ DatatypeThms = st.ctx.dts[#'List]

check hyps_of(dt.induction) ~is []
check hyps_of(dt.cases) ~is []
check hyps_of(dt.injectivity[#'Cons]) ~is []

check:
  show(concl_of(dt.injectivity[#'Cons]))
  ~is "forall (x :: ?a, y :: List(?a), z :: ?a, u :: List(?a)): Cons(x, y) === Cons(z, u) <=> x === z and y === u"
check:
  show(concl_of(dt.induction))
  ~is "forall (x :: List(?a) -> bool): x(Nil) and (forall (y :: ?a, z :: List(?a)): x(z) ==> x(Cons(y, z))) ==> forall (y :: List(?a)): x(y)"

// the executable half is untouched: a derived datatype still emits classes
check f.Cons(1, f.Nil()) ~is f.Cons(1, f.Nil())
check f.succ(f.zero()) ~is f.succ(f.zero())
