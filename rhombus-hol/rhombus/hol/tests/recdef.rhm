#lang rhombus/static

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/bool open
  rhombus/hol/datatype open
  rhombus/hol/terminate open
  rhombus/hol/recdef open
  "spec_prelude.rhm" open

def P = prelude
def thy = P.thy

fun eqs_of(n :: Symbol) :: List:
  (P.funs[n] :~ FunInfo).equations.map(fun (t :: Thm): show(concl_of(t)))

// -- the equations the specification's functions get -----------------------

check:
  eqs_of(#'app)
  ~is ["forall (x :: List(?a)): app(nil, x) === x",
       "forall (x :: ?a, y :: List(?a), z :: List(?a)): "
         ++ "app(cons(x, y), z) === cons(x, app(y, z))"]
check:
  eqs_of(#'rev)
  ~is ["rev(nil) === nil",
       "forall (x :: ?a, y :: List(?a)): "
         ++ "rev(cons(x, y)) === app(rev(y), cons(x, nil))"]
check:
  eqs_of(#'length)
  ~is ["length(nil) === zero",
       "forall (x :: ?a, y :: List(?a)): length(cons(x, y)) === succ(length(y))"]
check:
  eqs_of(#'plus)
  ~is ["forall (x :: Nat): plus(zero, x) === x",
       "forall (x :: Nat, y :: Nat): plus(succ(x), y) === succ(plus(x, y))"]
check:
  eqs_of(#'flatten)
  ~is ["flatten(leaf) === nil",
       "forall (x :: ?a, y :: Tree(?a), z :: Tree(?a)): "
         ++ "flatten(node(x, y, z)) === app(flatten(y), cons(x, flatten(z)))"]
check:
  eqs_of(#'size)
  ~is ["size(leaf) === zero",
       "forall (x :: ?a, y :: Tree(?a), z :: Tree(?a)): "
         ++ "size(node(x, y, z)) === succ(plus(size(y), size(z)))"]

// every equation is hypothesis-free and well-formed in the theory
check:
  let all_eqs = for values(acc :~ List = []) ((_, fi) in P.funs):
                  acc ++ (fi :~ FunInfo).equations
  for all (t in all_eqs): hyps_of(t) == []
  ~is #true

// the constants are declared at the types the definitions gave them
check:
  const_type(thy, #'app)
  ~is mk_fun(list_ty(A), mk_fun(list_ty(A), list_ty(A)))
check const_type(thy, #'flatten) ~is mk_fun(tree_ty(A), list_ty(A))
check const_type(thy, #'plus) ~is mk_fun(nat_ty, mk_fun(nat_ty, nat_ty))

// -- the recursion information -----------------------------------------------
//
// This is also the induction-scheme generator's input, so it has to name the
// argument the prover should induct on.

check (P.funs[#'app] :~ FunInfo).recursion ~matches StructuralRecursion([0], [0], _)
check (P.funs[#'rev] :~ FunInfo).recursion ~matches StructuralRecursion([0], [0], _)
check (P.funs[#'plus] :~ FunInfo).recursion ~matches StructuralRecursion([0], [0], _)
check (P.funs[#'length] :~ FunInfo).recursion ~matches StructuralRecursion([0], [0], _)
// `size` and `flatten` recurse on both subtrees, so both calls must descend.
check (P.funs[#'size] :~ FunInfo).recursion ~matches StructuralRecursion([0], [0], _)
check:
  match (P.funs[#'size] :~ FunInfo).recursion
  | StructuralRecursion(_, _, sites): sites.length()
  ~is 2
check:
  match (P.funs[#'flatten] :~ FunInfo).recursion
  | StructuralRecursion(_, _, sites): sites.length()
  ~is 2

check:
  // A non-recursive definition carries no structural order.
  let n = v(#'n, nat_ty)
  let spec = FunSpec(#'twice, [nat_ty], nat_ty,
                     [DefClause([n], ap2(P.plus, n, n))])
  let (_, info) = install_function(thy, spec, P.dts)
  match info.recursion
  | NoRecursion(): #true
  ~is #true

// -- descends_at -----------------------------------------------------------

check:
  descends_at(ap2(P.cons, v(#'x, A), v(#'r, list_ty(A))), v(#'r, list_ty(A)))
  ~is #true
// the head field is not of the recursive type, so it is not a descent
check:
  descends_at(ap2(P.cons, v(#'x, A), v(#'r, list_ty(A))), v(#'x, A))
  ~is #false
check descends_at(v(#'xs, list_ty(A)), v(#'xs, list_ty(A))) ~is #false
check descends_at(P.nil, P.nil) ~is #false

// ==========================================================================
// Rejections
// ==========================================================================

def n = v(#'n, nat_ty)
def m = v(#'m, nat_ty)
def xs = v(#'xs, list_ty(A))
def ys = v(#'ys, list_ty(A))
def hd = v(#'x, A)
def tl = v(#'r, list_ty(A))

// -- non-termination -------------------------------------------------------

check:
  // `loop(n) = loop(n)` -- the argument does not shrink
  let loop_c = mk_const(#'loopy, mk_fun(nat_ty, nat_ty))
  install_function(thy, FunSpec(#'loopy, [nat_ty], nat_ty,
                                [DefClause([n], ap1(loop_c, n))]),
                   P.dts)
  ~throws "cannot see that the definition terminates"
check:
  // recursing on the successor rather than the predecessor
  let up = mk_const(#'up, mk_fun(nat_ty, nat_ty))
  install_function(thy, FunSpec(#'up, [nat_ty], nat_ty,
                                [DefClause([P.zero], P.zero),
                                 DefClause([ap1(P.succ, m)],
                                           ap1(up, ap1(P.succ, ap1(P.succ, m))))]),
                   P.dts)
  ~throws "cannot see that the definition terminates"

// -- nothing is added to the theory when a check fails ---------------------

check:
  let loop_c = mk_const(#'loopy2, mk_fun(nat_ty, nat_ty))
  try:
    install_function(thy, FunSpec(#'loopy2, [nat_ty], nat_ty,
                                  [DefClause([n], ap1(loop_c, n))]),
                     P.dts)
    ~catch _: #void
  const_type(thy, #'loopy2)
  ~is #false

// -- exhaustiveness and overlap --------------------------------------------

check:
  // missing the `cons` case
  let f = mk_const(#'partial, mk_fun(list_ty(A), nat_ty))
  install_function(thy, FunSpec(#'partial, [list_ty(A)], nat_ty,
                                [DefClause([P.nil], P.zero)]),
                   P.dts)
  ~throws "not exhaustive"
check:
  // The same pattern twice, in an otherwise exhaustive matrix: the repeat
  // wins nowhere, which is a mistake however clauses are ordered.
  let f = mk_const(#'dup, mk_fun(list_ty(A), nat_ty))
  install_function(thy, FunSpec(#'dup, [list_ty(A)], nat_ty,
                                [DefClause([P.nil], P.zero),
                                 DefClause([ap2(P.cons, hd, tl)], P.zero),
                                 DefClause([P.nil], P.zero)]),
                   P.dts)
  ~throws "this clause can never match"
check:
  // A bare variable *after* a specific constructor pattern is a catch-all,
  // not an overlap: clauses are ordered, so `Nil` takes the first and
  // everything else falls to the second.  Two equations come out, the
  // second for `Cons` -- the shape the catch-all is left holding.
  let (_, info) = install_function(
    thy, FunSpec(#'mixed, [list_ty(A)], nat_ty,
                 [DefClause([P.nil], P.zero),
                  DefClause([xs], ap1(P.succ, P.zero))]),
    P.dts)
  (info :~ FunInfo).equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["mixed(nil) === zero",
       "forall (x :: ?a, y :: List(?a)): mixed(cons(x, y)) === succ(zero)"]
check:
  // The other order: the catch-all first makes the specific clause
  // unreachable.
  let f = mk_const(#'mixed2, mk_fun(list_ty(A), nat_ty))
  install_function(thy, FunSpec(#'mixed2, [list_ty(A)], nat_ty,
                                [DefClause([xs], P.zero),
                                 DefClause([P.nil], P.zero)]),
                   P.dts)
  ~throws "this clause can never match"

// -- pattern shape ---------------------------------------------------------

check:
  // Nested constructor patterns -- matching further into a field an
  // enclosing pattern already destructured -- are genuinely supported:
  // `Cons(hd, Nil())`, `Cons(hd, Cons(hd2, tl))`, and `Nil()` exhaustively
  // cover every list, distinguishing length 0, exactly 1, and 2-or-more.
  let hd2 = v(#'y, A)
  let one_elem = ap2(P.cons, hd, P.nil)
  let two_or_more = ap2(P.cons, hd, ap2(P.cons, hd2, tl))
  let (_, info) = install_function(
    thy, FunSpec(#'by_length, [list_ty(A)], nat_ty,
                 [DefClause([P.nil], P.zero),
                  DefClause([one_elem], ap1(P.succ, P.zero)),
                  DefClause([two_or_more],
                            ap1(P.succ, ap1(P.succ, P.zero)))]),
    P.dts)
  (info :~ FunInfo).equations.length()
  ~is 3
check:
  // The same shape missing the 2-or-more-element case: still caught as not
  // exhaustive, one nesting level deeper than a flat coverage check would
  // reach.
  let one_elem = ap2(P.cons, hd, P.nil)
  install_function(
    thy, FunSpec(#'by_length2, [list_ty(A)], nat_ty,
                 [DefClause([P.nil], P.zero),
                  DefClause([one_elem], ap1(P.succ, P.zero))]),
    P.dts)
  ~throws "not exhaustive"
check:
  // Reusing one variable at two different nested positions is still
  // rejected as a repeated pattern variable, whether the two positions are
  // at the same depth or not.
  let f = mk_const(#'nested_reused, mk_fun(list_ty(A), nat_ty))
  let deep = ap2(P.cons, hd, ap2(P.cons, hd, tl))
  install_function(thy, FunSpec(#'nested_reused, [list_ty(A)], nat_ty,
                                [DefClause([P.nil], P.zero),
                                 DefClause([deep], P.zero)]),
                   P.dts)
  ~throws "pattern variable is repeated"
check:
  let f = mk_const(#'rep, mk_fun(list_ty(A), list_ty(A)))
  let same = ap2(P.cons, hd, tl)
  install_function(thy, FunSpec(#'rep, [list_ty(A), list_ty(A)], list_ty(A),
                                [DefClause([P.nil, ys], ys),
                                 DefClause([same, tl], ys)]),
                   P.dts)
  ~throws "repeated"

// -- typing and scope ------------------------------------------------------

check:
  let f = mk_const(#'wrongty, mk_fun(list_ty(A), nat_ty))
  install_function(thy, FunSpec(#'wrongty, [list_ty(A)], nat_ty,
                                [DefClause([P.nil], P.nil),
                                 DefClause([ap2(P.cons, hd, tl)], P.zero)]),
                   P.dts)
  ~throws "clause result has the wrong type"
check:
  // `m` is not bound by any pattern
  let f = mk_const(#'openvar, mk_fun(list_ty(A), nat_ty))
  install_function(thy, FunSpec(#'openvar, [list_ty(A)], nat_ty,
                                [DefClause([P.nil], m),
                                 DefClause([ap2(P.cons, hd, tl)], P.zero)]),
                   P.dts)
  ~throws "unbound variable"
check:
  install_function(thy, FunSpec(#'app, [list_ty(A)], nat_ty,
                                [DefClause([xs], P.zero)]),
                   P.dts)
  ~throws "already declared"
check:
  install_function(thy, FunSpec(#'empty, [nat_ty], nat_ty, []), P.dts)
  ~throws "at least one clause"

// -- matching on more than one argument ------------------------------------
//
// The pattern matrix is checked as the decision tree it came from: split on a
// column, require every constructor of that type, recur into each branch.  So
// a two-column definition is admitted, but only when the *product* is covered.

check:
  let (_, info) = install_function(
    thy, FunSpec(#'two, [nat_ty, nat_ty], nat_ty,
                 [DefClause([P.zero, n], P.zero),
                  DefClause([ap1(P.succ, m), P.zero], P.zero),
                  DefClause([ap1(P.succ, m), ap1(P.succ, n)], P.zero)]),
    P.dts)
  (info :~ FunInfo).equations.length()
  ~is 3

check:
  // `[zero, succ]` and `[succ, zero]` are missing.
  install_function(thy, FunSpec(#'two, [nat_ty, nat_ty], nat_ty,
                                [DefClause([P.zero, P.zero], P.zero),
                                 DefClause([ap1(P.succ, m), ap1(P.succ, n)],
                                           P.zero)]),
                   P.dts)
  ~throws "not exhaustive"

