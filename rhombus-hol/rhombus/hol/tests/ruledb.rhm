#lang rhombus/static

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/bool open
  rhombus/hol/conv open
  rhombus/hol/drule open
  rhombus/hol/order open
  rhombus/hol/tmatch open
  rhombus/hol/ruledb open
  rhombus/hol/datatype open
  rhombus/hol/recdef open
  rhombus/hol/goal open
  rhombus/hol/simp open
  rhombus/hol/general open
  "spec_prelude.rhm" open

def P = prelude
def thy = P.thy
def LN = list_ty(nat_ty)

// the prelude's list functions, at `List(Nat)`
def appN = at(P.app, nat_ty)
def revN = at(P.rev, nat_ty)
def lenN = at(P.length, nat_ty)
def consN = at(P.cons, nat_ty)
def nil_n = at(P.nil, nat_ty)

def xs = v(#'xs, LN)
def ys = v(#'ys, LN)
def zs = v(#'zs, LN)
def n = v(#'n, nat_ty)
def m = v(#'m, nat_ty)

fun app_(a, b): ap2(appN, a, b)
fun cons_(a, b): ap2(consN, a, b)
fun rev_(a): ap1(revN, a)
fun len_(a): ap1(lenN, a)
fun plus_(a, b): ap2(P.plus, a, b)

// The definitional equations of everything in the prelude.
def defs :: RuleDB:
  for values(d :~ RuleDB = empty_db) ((nm, fi) in P.funs):
    add_thms(thy, d, nm, (fi :~ FunInfo).equations)

// ==========================================================================
// matching
// ==========================================================================

check:
  // a polymorphic pattern matches a monomorphic term, producing both a type
  // and a term instantiation
  let pv = v(#'ys, list_ty(A))
  let pat = ap2(P.app, mk_const(#'nil, list_ty(A)), pv)
  let m = term_match([pv], pat, app_(nil_n, xs)) :~ MatchResult
  [m.tyin, m.theta.length()]
  ~is [{#'a: nat_ty}, 1]
check:
  let pv = v(#'ys, list_ty(A))
  let pat = ap2(P.app, mk_const(#'nil, list_ty(A)), pv)
  term_match([pv], pat, app_(xs, ys))
  ~is #false
check:
  // a repeated pattern variable has to match consistently
  let pv = v(#'q, LN)
  let pat = app_(pv, pv)
  [term_match([pv], pat, app_(xs, xs)) != #false,
   term_match([pv], pat, app_(xs, ys)) != #false]
  ~is [#true, #false]
check:
  // a non-pattern variable must appear literally
  term_match([], app_(xs, ys), app_(xs, zs))
  ~is #false

// ==========================================================================
// orienting theorems into rules
// ==========================================================================

// every clause of every definition is one rule, and they share the function's
// name so that `disable` can switch a whole definition off
check rule_names(defs).length() ~is 12
check Set(& rule_names(defs)).length() ~is 6
check rules_of(defs, #'app).length() ~is 2
check rules_of(defs, #'nope) ~is []

check:
  // a variable left-hand side would rewrite everything
  let th = ASSUME(thy, mk_eq(xs, nil_n))
  mk_rule(thy, #'bad, th)
  ~is #false
check:
  // A *quantified* right-hand side variable the left side does not determine
  // cannot be a rule: matching would leave it uninstantiated.
  let (t2, th) = new_axiom(thy, mk_forall_list([xs, n], mk_eq(len_(xs), n)))
  mk_rule(t2, #'bad, th)
  ~is #false
check:
  // The same statement as an *assumption* is fine, and means something else:
  // its variables are particular, not schematic, so it rewrites exactly the
  // term `length(xs)` and nothing else.
  let r = mk_rule(thy, #'asm, ASSUME(thy, mk_eq(len_(xs), n))) :~ RewriteRule
  [show(r.lhs), show(r.rhs), r.vars]
  ~is ["length(xs)", "n", []]
check:
  // and so it does not match a different list
  let d = add_thm(thy, empty_db, #'asm, ASSUME(thy, mk_eq(len_(xs), n)))
  [db_conv(d)(thy, len_(xs)) != #false, db_conv(d)(thy, len_(ys)) != #false]
  ~is [#true, #false]
check:
  let th = REFL(thy, len_(xs))
  mk_rule(thy, #'bad, th)
  ~is #false
check:
  // a non-equation becomes `p === true`
  let r = mk_rule(thy, #'fact, ASSUME(thy, mk_eq(len_(xs), n)
                                        |> mk_neg(_))) :~ RewriteRule
  [show(r.lhs), show(r.rhs)]
  ~is ["length(xs) === n", "false"]
check:
  let dt = P.thms[#'List] :~ DatatypeThms
  let r = mk_rule(thy, #'distinct, dt.distinctness[0]) :~ RewriteRule
  [show(r.lhs), show(r.rhs), r.head]
  ~is ["nil === cons(x, y)", "false", #'eq]

// ==========================================================================
// rewriting
// ==========================================================================

// `TOP_DEPTH_CONV` never fails -- it returns a reflexive theorem when nothing
// applied -- so "no change" is a reflexive result, not a `#false`.
fun norm_with(d :: RuleDB, t :: Term) :~ String:
  match simp_conv(d)(thy, t)
  | #false: "<no change>"
  | th :~ Thm: (if is_refl_thm(th) | "<no change>" | show(rhs_of(th)))

fun norm(t :: Term) :~ String: norm_with(defs, t)

check norm(app_(nil_n, xs)) ~is "xs"
check norm(app_(cons_(n, nil_n), xs)) ~is "cons(n, xs)"
check norm(rev_(cons_(n, nil_n))) ~is "cons(n, nil)"
check norm(rev_(cons_(n, cons_(m, nil_n)))) ~is "cons(m, cons(n, nil))"
check norm(len_(cons_(n, cons_(m, nil_n)))) ~is "succ(succ(zero))"
check:
  norm(plus_(ap1(P.succ, P.zero), ap1(P.succ, P.zero)))
  ~is "succ(succ(zero))"
// rewriting is congruent: it works under any context
check norm(len_(app_(cons_(n, nil_n), cons_(m, nil_n)))) ~is "succ(succ(zero))"
// nothing to do
check norm(app_(xs, ys)) ~is "<no change>"

// every rewrite is justified by a theorem, and the theorem says what the
// rewrite claims
check:
  let th = simp_conv(defs)(thy, rev_(cons_(n, nil_n))) :~ Thm
  [show(concl_of(th)), hyps_of(th)]
  ~is ["rev(cons(n, nil)) === cons(n, nil)", []]

// -- reflexivity closes an equation ----------------------------------------

check norm(mk_eq(app_(nil_n, xs), xs)) ~is "true"
check norm(mk_eq(xs, ys)) ~is "<no change>"

// -- disabling -------------------------------------------------------------

check norm(app_(nil_n, xs)) ~is "xs"
check norm_with(disable(defs, [#'app]), app_(nil_n, xs)) ~is "<no change>"
check norm_with(enable(disable(defs, [#'app]), [#'app]), app_(nil_n, xs)) ~is "xs"

// ==========================================================================
// permutative rules cannot oscillate
// ==========================================================================

check:
  // `plus(m, n) === plus(n, m)` is a variant of itself, so it is permutative
  let comm = mk_forall_list([m, n], mk_eq(plus_(m, n), plus_(n, m)))
  let (t2, th) = new_axiom(thy, comm)
  let r = mk_rule(t2, #'plus_comm, th) :~ RewriteRule
  r.permutative
  ~is #true
check:
  // it fires in the direction that decreases the term, and only that one
  let comm = mk_forall_list([m, n], mk_eq(plus_(m, n), plus_(n, m)))
  let (t2, th) = new_axiom(thy, comm)
  let d = add_thm(t2, empty_db, #'plus_comm, th)
  let down = db_conv(d)(t2, plus_(n, m))
  let up = db_conv(d)(t2, plus_(m, n))
  [down != #false, up != #false]
  ~is [#true, #false]
check:
  // so normalising terminates rather than looping between the two orientations
  let comm = mk_forall_list([m, n], mk_eq(plus_(m, n), plus_(n, m)))
  let (t2, th) = new_axiom(thy, comm)
  let d = add_thm(t2, empty_db, #'plus_comm, th)
  let r = simp_conv(d)(t2, plus_(n, m)) :~ Thm
  show(rhs_of(r))
  ~is "plus(m, n)"

// ==========================================================================
// the first real theorem, by simplification alone
// ==========================================================================

check:
  let g = mk_goal([], mk_eq(app_(nil_n, ys), ys))
  let st = simplify_goal(thy, defs, g) :~ Step
  let th = st.justify([])
  [show(concl_of(th)), hyps_of(th), st.subgoals.length()]
  ~is ["app(nil, ys) === ys", [], 0]
check:
  // and it really is a kernel theorem in the prelude's theory
  let g = mk_goal([], mk_eq(app_(nil_n, ys), ys))
  let th = (simplify_goal(thy, defs, g) :~ Step).justify([])
  descends(stamp_of(th), thy.stamp)
  ~is #true
check:
  let g = mk_goal([], mk_eq(len_(cons_(n, nil_n)), ap1(P.succ, P.zero)))
  let th = (simplify_goal(thy, defs, g) :~ Step).justify([])
  show(concl_of(th))
  ~is "length(cons(n, nil)) === succ(zero)"

// an assumption is available to the simplifier as a rewrite rule -- this is
// how an induction hypothesis does its work
check:
  let ih = mk_eq(app_(xs, nil_n), xs)
  let g = mk_goal([ih], mk_eq(cons_(n, app_(xs, nil_n)), cons_(n, xs)))
  let st = simplify_goal(thy, defs, g) :~ Step
  let th = st.justify([])
  [show(concl_of(th)), st.subgoals.length(), hyps_of(th).length()]
  ~is ["cons(n, app(xs, nil)) === cons(n, xs)", 0, 1]

// a goal that only partly simplifies leaves a smaller goal behind
check:
  let g = mk_goal([], mk_eq(app_(cons_(n, nil_n), ys), ys))
  let st = simplify_goal(thy, defs, g) :~ Step
  [st.subgoals.length(), show((st.subgoals[0] :~ Goal).concl)]
  ~is [1, "cons(n, ys) === ys"]
check:
  let g = mk_goal([], mk_eq(app_(xs, ys), app_(xs, ys)))
  simplify_goal(thy, defs, mk_goal([], mk_eq(xs, ys)))
  ~is #false

// ==========================================================================
// rule classes: type-prescription facts
// ==========================================================================
//
// `Q := \n. #true`, so `|- forall xs. Q(length(xs))` is provable with no new
// axiom -- `Q(length(xs))` unfolds to `true` and `EQT_INTRO` closes it -- but
// registering it as a rule keeps the term as written, `Q(length(xs))`,
// exactly the shape a type-prescription fact about `length` has.

def (thy_q2, def_q) = new_basic_definition(thy, mk_eq(mk_var(#'Q, mk_fun(nat_ty, bool)), mk_abs(n, tm_true)))
def qc = mk_const(#'Q, mk_fun(nat_ty, bool))

def q_len_fact:
  let unf = TRANS(AP_THM(thy_q2, def_q, ap1(lenN, xs)),
                  (match BETA_CONV(thy_q2, mk_comb(mk_abs(n, tm_true), ap1(lenN, xs)))
                   | th :~ Thm: th))
  GEN(thy_q2, xs, EQT_ELIM(thy_q2, unf))

check show(concl_of(q_len_fact)) ~is "forall (x :: List(Nat)): Q(length(x))"

def db_with_q = add_thm(thy_q2, defs, #'q_len_fact, q_len_fact)

// classified as a type-prescription about `length`, keyed by its head symbol
check:
  type_facts_of(db_with_q, #'length).length()
  ~is 1
// and *also* still an ordinary rewrite rule -- the two classifications are
// not exclusive, and every existing rewrite behavior is unaffected
check:
  simp_conv(db_with_q)(thy_q2, mk_comb(qc, ap1(lenN, nil_n)))
  ~is_a Thm

// generalizing `length(xs)` in a goal now carries `Q(g)` along as a fresh
// hypothesis about the generalized variable -- exactly what a proof that
// needs to know something about what `length` produces would otherwise
// lose by hiding it behind a bare variable.
check:
  let ctors = Set(#'zero, #'succ, #'nil, #'cons)
  let g = mk_goal([], mk_eq(ap1(lenN, xs), ap1(lenN, xs)))
  let st = generalize_goal(thy_q2, db_with_q, ctors, g) :~ Step
  let sub :~ Goal = st.subgoals[0]
  [sub.asms.length(), show(sub.asms[0])]
  ~is [1, "Q(g)"]
// and the reconstructed proof is a real theorem, not a shortcut: closing
// the generalized subgoal (trivially, `g === g`) under the extra hypothesis
// still comes back as a proof of the *original*, ungeneralized goal, with
// no leftover hypotheses -- `Q(g)` was discharged by `q_len_fact`, not
// smuggled through.
check:
  let ctors = Set(#'zero, #'succ, #'nil, #'cons)
  let g = mk_goal([], mk_eq(ap1(lenN, xs), ap1(lenN, xs)))
  let st = generalize_goal(thy_q2, db_with_q, ctors, g) :~ Step
  let sub :~ Goal = st.subgoals[0]
  let sub_proof = (match dest_eq(sub.concl) | [l, _]: REFL(thy_q2, l))
  let final = st.justify([sub_proof])
  [show(concl_of(final)), hyps_of(final).length()]
  ~is ["length(xs) === length(xs)", 0]

// ==========================================================================
// conditional rewriting
// ==========================================================================
//
// `c === zero ==> plus(c, m) === m`, for a fresh constant `c` defined (not
// postulated) to be `zero`: true because `plus`'s own base clause says
// exactly this for the literal `zero`, but as *stated* the left side is
// `plus(c, m)`, which does not match either of `plus`'s own two clauses --
// their left sides are `plus(zero, _)` and `plus(succ(_), _)`, and `c` is a
// different constant, not the literal `zero`, even though it equals it.

def plus_zero_eq = (P.funs.get(#'plus, #false) :~ FunInfo).equations[0]
check show(concl_of(plus_zero_eq)) ~is "forall (x :: Nat): plus(zero, x) === x"

def (thy_c, def_c) = new_basic_definition(thy, mk_eq(mk_var(#'c, nat_ty), P.zero))
def cc = mk_const(#'c, nat_ty)

def cond_plus_thm:
  let h = ASSUME(thy_c, mk_eq(cc, P.zero))
  let cong = AP_THM(thy_c, AP_TERM(thy_c, P.plus, h), m)
  let base = SPEC(thy_c, m, plus_zero_eq)
  GENL(thy_c, [m], DISCH(thy_c, mk_eq(cc, P.zero), TRANS(cong, base)))

check show(concl_of(cond_plus_thm)) ~is "forall (x :: Nat): c === zero ==> plus(c, x) === x"

def cond_rule = mk_rule(thy_c, #'cond_plus, cond_plus_thm) :~ RewriteRule
check cond_rule.conds.length() ~is 1
check [show(cond_rule.lhs), show(cond_rule.rhs)] ~is ["plus(c, x)", "x"]

// `c`'s own definition, registered as an ordinary (unconditional) rule --
// `c` is a bare constant, not a pattern variable, so `mk_rule` accepts it
// exactly the way it accepts any other left-hand side headed by a declared
// symbol.
def db_c_only = add_thm(thy_c, empty_db, #'def_c, def_c)
def db_cond = add_rule(db_c_only, cond_rule)

fun norm_c(d :: RuleDB, t :: Term) :~ String:
  match simp_conv(d)(thy_c, t)
  | #false: "<no change>"
  | th :~ Thm: (if is_refl_thm(th) | "<no change>" | show(rhs_of(th)))

// The conditional rule alone (its condition undischargeable -- nothing here
// says `c === zero`) does not fire; `plus`'s own two clauses are
// deliberately *not* in this database, so there is no other route either.
check norm_c(add_rule(empty_db, cond_rule), plus_(cc, m)) ~is "<no change>"
// knowing `c === zero` but only that -- still no unconditional rule for
// `plus` is in this database -- gets no further than rewriting the `c`
// inside it (ordinary congruence rewriting, not the conditional rule): it
// does not reach `m`, because that needs `plus`'s own zero-clause, which is
// deliberately absent here too.
check norm_c(db_c_only, plus_(cc, m)) ~is "plus(zero, m)"
// with both registered, the condition discharges (`c` rewrites to `zero`
// via its own definition, closing `c === zero` by reflexivity) and the
// conditional rule fires directly on `plus(c, m)` -- `plus`'s own clauses
// are still absent from this database, so reaching `m` is the conditional
// rule's doing alone, not a `c`-then-zero-clause chain.
check norm_c(db_cond, plus_(cc, m)) ~is "m"
