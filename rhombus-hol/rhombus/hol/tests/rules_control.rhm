#lang rhombus/static

// Rule-database control from the surface: `disable_rules` and `~using`
// (PLAN.md section 9.27).

import:
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/driver open
  "fixtures/rules_using_enables.rhm"!hol_theory as m

def st :~ HolState = m.theory

// The fixture compiled, which is the claim: `disable_rules` expands, and
// `~using` re-enabled the rule it disabled, so `twice` was provable without
// induction.
check st.thms.get(#'plus_zero_r, #false) is_a Thm ~is #true
check st.thms.get(#'twice, #false) is_a Thm ~is #true

check:
  show(concl_of(st.thms[#'twice]))
  ~is "forall (x :: Nat): plus(plus(x, zero), zero) === x"
check hyps_of(st.thms[#'twice]) ~is []
