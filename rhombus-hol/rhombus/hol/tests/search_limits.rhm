#lang rhombus/static

// Proof search is bounded, and running out is an error.
//
// Rewriting had no limit at all.  A rule that neither terminates nor fails --
// not permutative, right-hand side not smaller -- looped, and since
// simplification runs while a module compiles, the loop hung `raco make`
// rather than failing it.

import:
  "fixture_load.rhm" open
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/logic/conv open
  rhombus/hol/logic/ruledb open
  rhombus/hol/prover/search/limits open
  rhombus/meta open
  rhombus/hol/effect/core open
  rhombus/hol/effect/syntax open


def nt = mk_tyapp(#'n, [])
def thy:
  let t0 = new_type(base_theory(), #'n, 0)
  let t1 = new_constant(t0, #'a, nt)
  let t2 = new_constant(t1, #'b, nt)
  new_constant(t2, #'h, mk_fun(nt, nt))
def a = mk_const(#'a, nt)
def b = mk_const(#'b, nt)
def h = mk_const(#'h, mk_fun(nt, nt))

fun outcome(db :: RuleDB, t :: Term) :: String:
  try:
    block:
      match simp_conv(db)(thy, t)
      | #false: "no rewrite"
      | _ :: Thm: "rewritten"
    ~catch e :: Exn.Fail: "raised: " ++ e.message.split("\n")[0]

// -- a cycle is reported as a cycle, at the position it occurs ---------------
//
// Detection is per rewrite position, not global: the same term may legitimately
// be rewritten at two places in one traversal.
check:
  let db = add_thm(thy, add_thm(thy, empty_db, #'ab, ASSUME(thy, mk_eq(a, b))),
                   #'ba, ASSUME(thy, mk_eq(b, a)))
  outcome(db, a)
  ~is "raised: simplify: rewrite cycle detected"

// -- an explicit limit applies to an effectful simplifier invocation ---------
check:
  let db = add_thm(thy, empty_db, #'grow,
                   ASSUME(thy, mk_eq(a, mk_comb(h, a))))
  let run:
    fun ():
      try:
        block:
          let result = SearchBudget.run(
                         SearchLimits(32),
                         simp_conv_effect(db)(thy, a))
          (if result | "rewritten" | "no rewrite")
        ~catch e :: Exn.Fail: "raised"
  run()
  ~is "raised"

// -- and an ordinary rewrite is unaffected -----------------------------------
check:
  let db = add_thm(thy, empty_db, #'ab, ASSUME(thy, mk_eq(a, b)))
  let th = simp_conv(db)(thy, mk_comb(h, a)) :~ Thm
  concl_of(th)
  ~is mk_eq(mk_comb(h, a), mk_comb(h, b))

// -- nested computations share one immutable handler state ------------------
//
// Composing computations must not install a new allowance. Eleven spends
// across two nested calls therefore exhaust a ten-step budget.
fun spend_steps(count :: NonnegInt) :: Computation:
  recur loop (remaining :: NonnegInt = count):
    cond
    | remaining == 0: return count
    | ~else:
        effect:
          let _ <- SearchBudget.spend(#'test)
          loop(remaining - 1)

def nested_budget_subject:
  effect:
    let _ <- spend_steps(4)
    spend_steps(7)

check:
  SearchBudget.run(SearchLimits(10), spend_steps(10))
  ~is 10
check:
  SearchBudget.run(SearchLimits(10), nested_budget_subject)
  ~throws "proof-search step limit exceeded"

// -- conditional rewriting spends from that same budget ---------------------
//
// `db_conv` itself requests no step. A zero allowance therefore reaches the
// conditional rule, but discharging its reflexive premise must request budget
// through the nested simplifier and fail.
check:
  let premise = mk_eq(a, a)
  let target = mk_comb(h, a)
  let (thy2, conditional) = new_axiom(
                              thy, mk_imp(premise, mk_eq(target, b)))
  let db = add_thm(thy2, empty_db, #'conditional, conditional)
  SearchBudget.run(SearchLimits(0), db_conv(db)(thy2, target))
  ~throws "proof-search step limit exceeded"

// -- the budget is a proof option --------------------------------------------
//
// The ceiling used to be a constant in the library.  A proof that needs more
// than the default should be able to ask, and a reader should be able to see
// that it did.

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/search_steps_ok.rhm")')
  #true
  ~is #true

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/search_steps_starved.rhm")')
  ~throws "proof-search step limit exceeded"
