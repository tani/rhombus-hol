#lang rhombus/static

// `Set{x :: T | pred}` (and, with the type omitted, `Set{x | pred}`)
// builds an ordinary `?a -> Boolean` predicate value from a binder and a
// body, executable exactly like `Set{e1, e2, ...}`'s extensional form by
// direct application. Membership, non-membership, and omitted-type
// inference all reduce. Membership and inference prove outright; the
// non-membership side reduces all the way to a bare ground constructor
// distinctness fact, which a separate, pre-existing automation gap
// leaves open (`not (succ(zero()) === zero())` is equally stuck stated
// on its own).

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
  "compiled"

fun stuck_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/set_comprehension_ok.rhm")')
  ~is "compiled"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/set_comprehension_infer_ok.rhm")')
  ~is "compiled"

// The comprehension is fully reduced away; only distinctness is left.
check:
  stuck_message(
    ModulePath'lib("rhombus/hol/tests/fixtures/set_comprehension_false_stuck.rhm")')
    .contains("not (succ(zero) === zero)")
  ~is #true
