#lang rhombus/static

// `Set{x :: T | pred}` (and, with the type omitted, `Set{x | pred}`)
// builds an ordinary `?a -> Boolean` predicate value from a binder and a
// body, executable exactly like `Set{e1, e2, ...}`'s extensional form by
// direct application. Membership, non-membership, and omitted-type
// inference all prove.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
  "compiled"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/set_comprehension_ok.rhm")')
  ~is "compiled"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/set_comprehension_infer_ok.rhm")')
  ~is "compiled"

// Non-membership: the comprehension reduces and the constructor
// distinctness fact discharges what is left.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/set_comprehension_false_ok.rhm")')
  ~is "compiled"
