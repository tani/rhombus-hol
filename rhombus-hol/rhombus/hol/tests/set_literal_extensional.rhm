#lang rhombus/static

// `Set{e1, e2, ...}` with multiple elements elaborates to the extensional
// disjunction-of-equalities predicate, exactly as the canonical empty
// `Set{}` case elaborates to `λ_. #false` (`set_literal_ok.rhm`), and
// membership in it proves outright.

import:
  "fixture_load.rhm" open

check:
  instantiate_hol_fixture(
    ModulePath'lib("rhombus/hol/tests/fixtures/set_literal_extensional_ok.rhm")')
  "compiled"
  ~is "compiled"
