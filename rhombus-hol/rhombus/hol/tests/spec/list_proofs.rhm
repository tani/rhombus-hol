#lang rhombus/hol

// Specification section 4.1, in the specification's own source syntax.
//
// Two spellings differ from the document, both forced by shrubbery: a type
// variable is `~a` rather than `'a`, because `'` opens a syntax literal; and
// the rewrite-rule attribute is the keyword `theorem ~rewrite_rule name:`
// rather than `@rewrite_rule`, because `@` is at-notation and vanishes.
//
// `proof: auto` is omitted wherever it carries no hint.

export:
  List
  Nil
  Cons
  app
  rev

// --------------------------------------------------
// 1. Data types and functions
// --------------------------------------------------

type List(~a)
| Nil()
| Cons(head :: ~a, tail :: List(~a))

function app(xs :: List(~a), ys :: List(~a)) :: List(~a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

function rev(xs :: List(~a)) :: List(~a):
  match xs
  | Nil(): Nil()
  | Cons(x, rest): app(rev(rest), Cons(x, Nil()))

// --------------------------------------------------
// 2. Accumulating the lemmas
// --------------------------------------------------

theorem ~rewrite_rule app_nil_r:
  forall (xs :: List(~a)):
    app(xs, Nil()) === xs

theorem ~rewrite_rule app_assoc:
  forall (xs :: List(~a), ys :: List(~a), zs :: List(~a)):
    app(app(xs, ys), zs) === app(xs, app(ys, zs))
proof:
  auto ~induct: xs

theorem ~rewrite_rule rev_app_distr:
  forall (xs :: List(~a), ys :: List(~a)):
    rev(app(xs, ys)) === app(rev(ys), rev(xs))
proof:
  auto ~induct: xs

// --------------------------------------------------
// 3. The main theorem
// --------------------------------------------------
//
// One induction, using the rules accumulated above.

theorem rev_involutive:
  forall (xs :: List(~a)):
    rev(rev(xs)) === xs
proof:
  auto ~induct: xs
