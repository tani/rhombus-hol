#lang rhombus/hol

// Specification section 4.1 in the current surface syntax.
// Theorems are never installed as global rewrite rules; dependencies needed
// by a proof are selected explicitly with `use`.
//
// Omitted `proof:` clauses use default automation whenever no hint is needed.

export:
  List
  Nil
  Cons
  app
  rev

// --------------------------------------------------
// 1. Data types and functions
// --------------------------------------------------

datatype List.of(?a)
| Nil()
| Cons(head :: ?a, tail :: List.of(?a))

function app(xs :: List.of(?a), ys :: List.of(?a)) :: List.of(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

function rev(xs :: List.of(?a)) :: List.of(?a):
  match xs
  | Nil(): Nil()
  | Cons(x, rest): app(rev(rest), Cons(x, Nil()))

// --------------------------------------------------
// 2. Accumulating the lemmas
// --------------------------------------------------

theorem app_nil_r:
  forall (xs :: List.of(?a)):
    app(xs, Nil()) === xs

theorem app_assoc:
  forall (xs :: List.of(?a), ys :: List.of(?a), zs :: List.of(?a)):
    app(app(xs, ys), zs) === app(xs, app(ys, zs))
proof:
  ~induct: [xs]

theorem rev_app_distr:
  forall (xs :: List.of(?a), ys :: List.of(?a)):
    rev(app(xs, ys)) === app(rev(ys), rev(xs))
proof:
  ~induct: [xs]
  ~use: [app_nil_r, app_assoc]

// --------------------------------------------------
// 3. The main theorem
// --------------------------------------------------
//
// One induction, using the rules accumulated above.

theorem rev_involutive:
  forall (xs :: List.of(?a)):
    rev(rev(xs)) === xs
proof:
  ~induct: [xs]
  ~use: [rev_app_distr]
