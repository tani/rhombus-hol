#lang rhombus/hol

// Specification section 4.3, second half: searching for a counterexample
// before trying to prove something.
//
// The document writes `check_property` in the plain `#lang rhombus` test file.
// Here it lives in a `#lang rhombus/hol` module, because the generators are
// emitted alongside each `type` declaration and are named hygienically -- a
// property can only draw from datatypes declared in its own module.  Lifting
// that would mean exporting the generators under stable names.
//
// A `check_property` declaration *is* a definition: its value is the outcome,
// so a test can assert on it rather than reading printed output.

export:
  rev_involutive_holds
  rev_app_wrong

import: "list_proofs.rhm" open

type Nat
| zero()
| succ(pred :: Nat)

check_property rev_involutive_holds(~samples: 200):
  forall (xs :: List(Nat)):
    rev(rev(xs)) === xs

// The document's own wrong property: `rev` does not distribute over `app`
// without swapping the arguments.
check_property rev_app_wrong(~samples: 200):
  forall (xs :: List(Nat), ys :: List(Nat)):
    rev(app(xs, ys)) === app(rev(xs), rev(ys))
