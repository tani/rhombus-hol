#lang rhombus/static

// Acceptance test for specification section 4.1: list reversal and the
// associativity of append.
//
// This lower-level test builds its RuleDB explicitly. Surface `theorem`
// declarations do not perform that registration; their proofs select earlier
// theorems explicitly with `use`.

import:
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel/names open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/definition/datatype/define open
  rhombus/hol/definition/function/spec open
  rhombus/hol/prover/rules open
  rhombus/hol/prover/proof/node open
  rhombus/hol/prover/tactic/induction open
  rhombus/hol/prover/waterfall open
  lib("rhombus/hol/tests/spec/spec_prelude.rhm") open

def P = prelude
def thy = P.thy

def defs :: RuleDB:
  for values(d :~ RuleDB = empty_db) ((nm, fi) in P.funs):
    add_thms(thy, d, nm, (fi :~ FunInfo).equations)

fun ctx_with(db :: RuleDB) :: Context:
  mk_context(thy, ~rules: db, ~datatypes: P.thms, ~functions: P.funs)

def xs = v(#'xs, list_ty(A))
def ys = v(#'ys, list_ty(A))
def zs = v(#'zs, list_ty(A))
fun candidate_vars_of(g :: Goal) :: List.of(Symbol):
  candidate_vars(P.funs, P.thms, g).map(fun (u :: FVar): u.name)

fun app_(a, b): ap2(P.app, a, b)
fun rev_(a): ap1(P.rev, a)

// A proved theorem, plus the database with it registered as a rewrite rule.
fun prove_rule(db :: RuleDB, name :: Symbol, stmt :: Term,
               ~names: names :: List.of(Symbol) = [],
               ~induct: hints :: List.of(Symbol) = [])
     :: values(Thm, RuleDB):
  let (th, residues) = prove(ctx_with(db), stmt, ~names: names, ~induct: hints)
  match th
  | #false: error(~who: name, residue_message(name, residues))
  | t :~ Thm: values(t, add_thm(thy, db, name, t))

// ==========================================================================
// theorem app_nil_r: forall (xs): app(xs, nil) === xs
// ==========================================================================

def (app_nil_r, db1):
  prove_rule(defs, #'app_nil_r,
             mk_forall(xs, mk_eq(app_(xs, P.nil), xs)),
             ~names: [#'xs], ~induct: [#'xs])

check concl_of(app_nil_r) ~is mk_forall(xs, mk_eq(app_(xs, P.nil), xs))
check hyps_of(app_nil_r) ~is []
check descends(stamp_of(app_nil_r), thy.stamp) ~is #true

// ==========================================================================
// theorem app_assoc: forall (xs, ys, zs):
//   app(app(xs, ys), zs) === app(xs, app(ys, zs))
// ==========================================================================

def (app_assoc, db2):
  prove_rule(db1, #'app_assoc,
             mk_forall_list([xs, ys, zs],
                            mk_eq(app_(app_(xs, ys), zs),
                                  app_(xs, app_(ys, zs)))),
             ~names: [#'xs, #'ys, #'zs], ~induct: [#'xs])

check:
  concl_of(app_assoc)
  ~is mk_forall_list([xs, ys, zs],
                     mk_eq(app_(app_(xs, ys), zs),
                           app_(xs, app_(ys, zs))))
check hyps_of(app_assoc) ~is []

// ==========================================================================
// theorem rev_app_distr: forall (xs, ys):
//   rev(app(xs, ys)) === app(rev(ys), rev(xs))
// ==========================================================================

def (rev_app_distr, db3):
  prove_rule(db2, #'rev_app_distr,
             mk_forall_list([xs, ys],
                            mk_eq(rev_(app_(xs, ys)),
                                  app_(rev_(ys), rev_(xs)))),
             ~names: [#'xs, #'ys], ~induct: [#'xs])

check:
  concl_of(rev_app_distr)
  ~is mk_forall_list([xs, ys],
                     mk_eq(rev_(app_(xs, ys)),
                           app_(rev_(ys), rev_(xs))))
check hyps_of(rev_app_distr) ~is []

// ==========================================================================
// theorem rev_involutive: forall (xs): rev(rev(xs)) === xs
//
// The specification's remark that the accumulated rewrite rules let this go
// through "in one induction" is the point of the test: nothing below mentions
// the earlier lemmas, they are simply in the database.
// ==========================================================================

def (rev_involutive, db4):
  prove_rule(db3, #'rev_involutive,
             mk_forall(xs, mk_eq(rev_(rev_(xs)), xs)),
             ~names: [#'xs], ~induct: [#'xs])

check concl_of(rev_involutive) ~is mk_forall(xs, mk_eq(rev_(rev_(xs)), xs))
check hyps_of(rev_involutive) ~is []

// ==========================================================================
// the choice of induction variable is found without a hint
// ==========================================================================

check:
  // `rev` recurses on its only argument, so `xs` is the obvious candidate
  let g = mk_goal([], mk_eq(rev_(rev_(xs)), xs))
  candidate_vars_of(g)
  ~is [#'xs]
check:
  // `app` recurses on its first argument, so `xs` outscores `ys`
  let g = mk_goal([], mk_eq(app_(app_(xs, ys), zs), app_(xs, app_(ys, zs))))
  candidate_vars_of(g)
  ~is [#'xs, #'ys, #'zs]
check:
  let (th, _) = prove(ctx_with(db3), mk_forall(xs, mk_eq(rev_(rev_(xs)), xs)),
                      ~names: [#'xs])
  th != #false
  ~is #true

// ==========================================================================
// a false conjecture is not proved, and says why it is stuck
// ==========================================================================

// The specification's own counterexample: `rev` does not distribute over
// `app` without swapping the arguments.
def bad_stmt = mk_forall_list([xs, ys],
                              mk_eq(rev_(app_(xs, ys)),
                                    app_(rev_(xs), rev_(ys))))

check:
  let (th, _) = prove(ctx_with(db4), bad_stmt, ~names: [#'xs, #'ys], ~induct: [#'xs])
  th
  ~is #false
check:
  let (_, residues) = prove(ctx_with(db4), bad_stmt, ~names: [#'xs, #'ys], ~induct: [#'xs])
  residues.length() > 0
  ~is #true
check:
  let (_, residues) = prove(ctx_with(db4), bad_stmt, ~names: [#'xs, #'ys], ~induct: [#'xs])
  residue_message(#'rev_app_wrong, residues) is_a String
  ~is #true
check:
  // the residue names the stages it went through, so the user can see where
  // the proof ran out
  let (_, residues) = prove(ctx_with(db4), bad_stmt, ~names: [#'xs, #'ys], ~induct: [#'xs])
  let residue = residues[0] :~ Residue
  residue.trace.length() > 0
  ~is #true

// ==========================================================================
// nothing above bypassed the kernel
// ==========================================================================

check:
  // every acceptance theorem is stamped in the prelude's theory
  let all_thms = [app_nil_r, app_assoc, rev_app_distr, rev_involutive]
  for all (t in all_thms): descends(stamp_of(t), thy.stamp)
  ~is #true
check:
  let all_thms = [app_nil_r, app_assoc, rev_app_distr, rev_involutive]
  for all (t in all_thms): hyps_of(t) == []
  ~is #true
