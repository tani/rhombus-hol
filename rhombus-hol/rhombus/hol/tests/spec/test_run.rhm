#lang rhombus

// Specification section 4.3: the proved code runs.
//
// This is an ordinary `#lang rhombus` module, and now the document's own:
// `check_property` is a genuine macro exported from `rhombus/hol`, so it can
// be imported and used here directly, the way the specification writes it,
// rather than needing a `#lang rhombus/hol` module of its own to hold it.
//
// `type` and `fun` emitted real Rhombus classes and functions, and the HOL
// declarations they also produced occupy no space a plain Rhombus module ever
// looks at. `check_property`'s generators and shrinkers reach it the same
// way: through a run-time registry in `qc.rhm`, keyed by the type's name, not
// through an identifier this module would have to import from wherever the
// type happened to be declared.

import:
  "list_proofs.rhm" open
  "tree_proofs.rhm" open
  rhombus/hol.check_property
  rhombus/hol/private/qc open

def my_list = Cons(1, Cons(2, Cons(3, Nil())))

check rev(my_list) ~is Cons(3, Cons(2, Cons(1, Nil())))
check app(my_list, Cons(4, Nil())) ~is Cons(1, Cons(2, Cons(3, Cons(4, Nil()))))
check rev(rev(my_list)) ~is my_list
check rev(Nil()) ~is Nil()

// the same functions at a different element type -- the type parameter was
// erased, and the logic had already checked the types
check rev(Cons("a", Cons("b", Nil()))) ~is Cons("b", Cons("a", Nil()))

// -- searching for a counterexample before proving ---------------------------

check_property rev_involutive_holds(~samples: 200):
  forall (xs :: List(Nat)):
    rev(rev(xs)) === xs

check rev_involutive_holds ~matches QCPassed(200)

// the document's own wrong property: `rev` does not distribute over `app`
// without swapping the arguments, with the counterexample it predicts -- two
// one-element lists
check_property rev_app_wrong(~samples: 200):
  forall (xs :: List(Nat), ys :: List(Nat)):
    rev(app(xs, ys)) === app(rev(xs), rev(ys))

check rev_app_wrong ~matches QCFailed(_, _, _)
check:
  match rev_app_wrong
  | QCFailed(inputs, _, _): inputs.length()
  | ~else: -1
  ~is 2
check:
  report(#'rev_app_wrong, rev_app_wrong) is_a String
  ~is #true
