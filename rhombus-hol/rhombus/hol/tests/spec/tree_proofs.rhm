#lang rhombus/hol

// Specification section 4.2: flattening a tree preserves its size.
//
// Two deviations from the document.  It writes `size` and `length` into `Int`
// and uses `1 + ...`; this version has no arithmetic in the logic -- `Int` is a
// Rhombus runtime type, not a HOL one -- so `Nat` is an ordinary datatype and
// `plus` an ordinary function.  The import is the document's own: a plain
// Rhombus `import` does both halves, bringing the functions so they can be
// called and the theory so `app_nil_r` and `app_assoc` are available to the
// prover.

export:
  Tree
  leaf
  node
  size
  flatten
  length
  Nat
  zero
  succ

import: "list_proofs.rhm" open

type Nat
| zero()
| succ(pred :: Nat)

type Tree(~a)
| leaf()
| node(value :: ~a, left :: Tree(~a), right :: Tree(~a))

function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))

function length(xs :: List(~a)) :: Nat:
  match xs
  | Nil(): zero()
  | Cons(x, rest): succ(length(rest))

function size(t :: Tree(~a)) :: Nat:
  match t
  | leaf(): zero()
  | node(v, l, r): succ(plus(size(l), size(r)))

function flatten(t :: Tree(~a)) :: List(~a):
  match t
  | leaf(): Nil()
  | node(v, l, r): app(flatten(l), Cons(v, flatten(r)))

// The lemma the document's `Int` arithmetic hides: `plus` computes on its
// first argument, so it cannot see a `succ` in the second one.
theorem ~rewrite_rule plus_succ:
  forall (m :: Nat, n :: Nat):
    plus(m, succ(n)) === succ(plus(m, n))
proof:
  auto ~induct: m

theorem ~rewrite_rule length_app:
  forall (xs :: List(~a), ys :: List(~a)):
    length(app(xs, ys)) === plus(length(xs), length(ys))
proof:
  auto ~induct: xs

theorem flatten_preserves_size:
  forall (t :: Tree(~a)):
    length(flatten(t)) === size(t)
proof:
  auto ~induct: t
