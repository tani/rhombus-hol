#lang rhombus/static

import:
  "fixture_load.rhm" open
  "fixtures/operator_runtime_ok.rhm" as runtime

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
check:
  runtime.add_one(runtime.tiny_zero())
  ~is runtime.tiny_succ(runtime.tiny_zero())

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_runtime_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_numeral_runtime_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_extension_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_extension_import_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/dispatch_function_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_mixed_bad.rhm")')
  ~throws "`+` has no applicable dispatch"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_append_bad.rhm")')
  ~throws "`++` has no applicable dispatch"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_power_bad.rhm")')
  ~throws "`**` has no applicable dispatch"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_negate_bad.rhm")')
  ~throws "`-` has no applicable dispatch"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_duplicate_provider_bad.rhm")')
  ~throws "dispatch method overlaps an existing method"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_duplicate_polymorphic_bad.rhm")')
  ~throws "dispatch method overlaps an existing method"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_numeral_ambiguous_bad.rhm")')
  ~throws "`+` has ambiguous dispatch"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_permutation_bad.rhm")')
  ~throws "implementation template must use every dispatch argument exactly once"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_carrier_bad.rhm")')
  ~throws "dispatch signature does not match the implementation constant"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_associativity_bad.rhm")')
  ~throws "`~left`, `~right`, or `~none`"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_equality_chain_bad.rhm")')
  ~throws "associative"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_comparison_chain_bad.rhm")')
  ~throws "associative"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/standard_operators_ok.rhm")')
  ~completes
