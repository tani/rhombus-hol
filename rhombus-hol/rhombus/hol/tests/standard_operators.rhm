#lang rhombus/static

import:
  "fixture_load.rhm" open
  "fixtures/operator_runtime_ok.rhm" as runtime

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
check:
  runtime.add_one(runtime.tiny_zero())
  ~is runtime.tiny_succ(runtime.tiny_zero())

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_runtime_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_numeral_runtime_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_extension_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_extension_import_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/overload_function_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_associativity_bad.rhm")')
  ~throws "`~left`, `~right`, or `~none`"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_equality_chain_bad.rhm")')
  ~throws "associative"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_comparison_chain_bad.rhm")')
  ~throws "associative"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/standard_operators_ok.rhm")')
  ~completes
