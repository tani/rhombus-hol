#lang rhombus/hol

// Exercise automata exclusively through the public standard-library boundary.
import rhombus/hol/stdlib open

function toggle_state(state :: Boolean, _symbol :: Boolean) :: Boolean:
  !state

function odd_state(state :: Boolean) :: Boolean:
  state

function make_parity_dfa() :: DFA.of(Boolean, Boolean):
  dfa(#false, toggle_state, odd_state)

def parity_dfa = make_parity_dfa()
def one_symbol = cons(#true, nil())
def two_symbols = cons(#true, one_symbol)

check dfa_initial(parity_dfa) ~is #false
check dfa_transition(parity_dfa, #false, #true) ~is #true
check dfa_run(parity_dfa, nil()) ~is #false
check dfa_run(parity_dfa, one_symbol) ~is #true
check dfa_run(parity_dfa, two_symbols) ~is #false
check dfa_accepts(parity_dfa, one_symbol) ~is #true
check dfa_accepts(parity_dfa, two_symbols) ~is #false

function boolean_state_equal(x :: Boolean) :: Boolean -> Boolean:
  function (y :: Boolean) :: Boolean: x == y

def boolean_states:
  fset_from_list(
    boolean_state_equal,
    cons(#false, cons(#true, nil())))
def false_initial:
  fset_insert(boolean_state_equal, #false, fset_empty())
def false_symbol = cons(#false, nil())

function finite_nfa_transition(source :: Boolean) :: Boolean -> Boolean -> Boolean:
  function (symbol :: Boolean) :: Boolean -> Boolean:
    function (destination :: Boolean) :: Boolean:
      match symbol
      | #false: #false
      | #true:
          match source
          | #false: #true
          | #true: destination

function true_final(state :: Boolean) :: Boolean:
  state

def finite_nfa:
  nfa(
    boolean_state_equal,
    boolean_states,
    false_initial,
    finite_nfa_transition,
    true_final)

check nfa_run(finite_nfa, one_symbol) ~is boolean_states
check fset_is_empty(nfa_run(finite_nfa, false_symbol)) ~is #true
check nfa_accepts(finite_nfa, one_symbol) ~is #true
check nfa_accepts(finite_nfa, false_symbol) ~is #false

def finite_nfa_dfa = nfa_determinize(finite_nfa)
check dfa_run(finite_nfa_dfa, one_symbol) ~is boolean_states
check dfa_accepts(finite_nfa_dfa, one_symbol) ~is #true
check dfa_accepts(finite_nfa_dfa, false_symbol) ~is #false
check dfa_accepts(finite_nfa_dfa, one_symbol) == nfa_accepts(finite_nfa, one_symbol) ~is #true
check dfa_accepts(finite_nfa_dfa, false_symbol) == nfa_accepts(finite_nfa, false_symbol) ~is #true

function finite_epsilon(source :: Boolean) :: Boolean -> Boolean:
  function (destination :: Boolean) :: Boolean: !source && destination

function finite_epsilon_transition(source :: Boolean) :: Boolean -> Boolean -> Boolean:
  function (symbol :: Boolean) :: Boolean -> Boolean:
    function (destination :: Boolean) :: Boolean:
      source && symbol && !destination

def finite_epsilon_nfa:
  epsilon_nfa(
    boolean_state_equal,
    boolean_states,
    false_initial,
    finite_epsilon,
    finite_epsilon_transition,
    true_final)

def initial_epsilon_closure:
  epsilon_nfa_closure(finite_epsilon_nfa, false_initial)
check fset_cardinality(initial_epsilon_closure) ~is nat_two()
check fset_member(boolean_state_equal, #false, initial_epsilon_closure) ~is #true
check fset_member(boolean_state_equal, #true, initial_epsilon_closure) ~is #true

def epsilon_one_run:
  epsilon_nfa_run(finite_epsilon_nfa, one_symbol)
check fset_cardinality(epsilon_one_run) ~is nat_two()
check fset_member(boolean_state_equal, #false, epsilon_one_run) ~is #true
check fset_member(boolean_state_equal, #true, epsilon_one_run) ~is #true
check fset_is_empty(
        epsilon_nfa_run(finite_epsilon_nfa, false_symbol)) ~is #true
check epsilon_nfa_accepts(finite_epsilon_nfa, nil()) ~is #true
check epsilon_nfa_accepts(finite_epsilon_nfa, one_symbol) ~is #true
check epsilon_nfa_accepts(finite_epsilon_nfa, false_symbol) ~is #false

def finite_epsilon_free:
  epsilon_nfa_eliminate(finite_epsilon_nfa)
def finite_epsilon_free_run:
  nfa_run(finite_epsilon_free, one_symbol)
check fset_cardinality(finite_epsilon_free_run) ~is nat_two()
check fset_member(boolean_state_equal, #false, finite_epsilon_free_run) ~is #true
check fset_member(boolean_state_equal, #true, finite_epsilon_free_run) ~is #true
check nfa_accepts(finite_epsilon_free, nil()) ~is #true
check nfa_accepts(finite_epsilon_free, one_symbol) ~is #true
check nfa_accepts(finite_epsilon_free, false_symbol) ~is #false

def finite_epsilon_dfa:
  epsilon_nfa_determinize(finite_epsilon_nfa)
check dfa_accepts(finite_epsilon_dfa, nil()) ~is #true
check dfa_accepts(finite_epsilon_dfa, one_symbol) ~is #true
check dfa_accepts(finite_epsilon_dfa, false_symbol) ~is #false
check dfa_accepts(finite_epsilon_dfa, one_symbol) == epsilon_nfa_accepts(finite_epsilon_nfa, one_symbol) ~is #true
check dfa_accepts(finite_epsilon_dfa, false_symbol) == epsilon_nfa_accepts(finite_epsilon_nfa, false_symbol) ~is #true


theorem public_nfa_determinize_accepts:
  forall (m :: NFA.of(?q, ?a), word :: List.of(?a)):
    nfa_accepts(m, word) <=> dfa_accepts(nfa_determinize(m), word)
proof:
  ~use: [nfa_determinize_accepts_iff]
  ~skip: [induct]

theorem public_nfa_determinize_language:
  forall (m :: NFA.of(?q, ?a)):
    nfa_accepts(m) === dfa_accepts(nfa_determinize(m))
proof:
  ~use: [nfa_determinize_language]
  ~skip: [induct]

theorem public_epsilon_nfa_determinize_accepts:
  forall (m :: EpsilonNFA.of(?q, ?a), word :: List.of(?a)):
    epsilon_nfa_accepts(m, word)
      <=> dfa_accepts(epsilon_nfa_determinize(m), word)
proof:
  ~use: [epsilon_nfa_determinize_accepts_iff]
  ~skip: [induct]

theorem public_epsilon_nfa_determinize_language:
  forall (m :: EpsilonNFA.of(?q, ?a)):
    epsilon_nfa_accepts(m)
      === dfa_accepts(epsilon_nfa_determinize(m))
proof:
  ~use: [epsilon_nfa_determinize_language]
  ~skip: [induct]

theorem public_epsilon_nfa_eliminate_accepts:
  forall (m :: EpsilonNFA.of(?q, ?a), word :: List.of(?a)):
    epsilon_nfa_well_formed(m)
      ==> (epsilon_nfa_accepts(m, word)
             <=> nfa_accepts(epsilon_nfa_eliminate(m), word))
proof:
  ~use: [epsilon_nfa_eliminate_accepts_iff]
  ~skip: [induct]

theorem public_epsilon_nfa_eliminate_language:
  forall (m :: EpsilonNFA.of(?q, ?a)):
    epsilon_nfa_well_formed(m)
      ==> (epsilon_nfa_accepts(m)
             === nfa_accepts(epsilon_nfa_eliminate(m)))
proof:
  ~use: [epsilon_nfa_eliminate_language]
  ~skip: [induct]
