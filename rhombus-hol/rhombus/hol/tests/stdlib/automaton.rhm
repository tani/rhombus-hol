#lang rhombus/hol

// Exercise automata exclusively through the public standard-library boundary.
import rhombus/hol/stdlib open

function toggle_state(state :: Boolean, _symbol :: Boolean) :: Boolean:
  !state

function odd_state(state :: Boolean) :: Boolean:
  state

function make_parity_dfa() :: DFA.of(Boolean, Boolean):
  dfa(#false, toggle_state, odd_state)

def parity_dfa = make_parity_dfa()
def one_symbol = cons(#true, nil())
def two_symbols = cons(#true, one_symbol)

check dfa_initial(parity_dfa) ~is #false
check dfa_transition(parity_dfa, #false, #true) ~is #true
check dfa_run(parity_dfa, nil()) ~is #false
check dfa_run(parity_dfa, one_symbol) ~is #true
check dfa_run(parity_dfa, two_symbols) ~is #false
check dfa_accepts(parity_dfa, one_symbol) ~is #true
check dfa_accepts(parity_dfa, two_symbols) ~is #false

// The preservation interface is usable without reaching into the leaf module.
theorem public_epsilon_eliminate_accepts:
  forall (m :: EpsilonNFA.of(?q, ?a), word :: List.of(?a)):
    epsilon_nfa_accepts(m, word) <=> nfa_accepts(epsilon_eliminate(m), word)
proof:
  ~use: [epsilon_eliminate_accepts_iff]
  ~skip: [induct]

theorem public_epsilon_eliminate_language:
  forall (m :: EpsilonNFA.of(?q, ?a)):
    epsilon_nfa_accepts(m) === nfa_accepts(epsilon_eliminate(m))
proof:
  ~use: [epsilon_eliminate_language]
  ~skip: [induct]

theorem public_nfa_determinize_accepts:
  forall (m :: NFA.of(?q, ?a), word :: List.of(?a)):
    nfa_accepts(m, word) <=> dfa_accepts(nfa_determinize(m), word)
proof:
  ~use: [nfa_determinize_accepts_iff]
  ~skip: [induct]

theorem public_nfa_determinize_language:
  forall (m :: NFA.of(?q, ?a)):
    nfa_accepts(m) === dfa_accepts(nfa_determinize(m))
proof:
  ~use: [nfa_determinize_language]
  ~skip: [induct]

theorem public_nfa_add_epsilon_accepts:
  forall (m :: NFA.of(?q, ?a), word :: List.of(?a)):
    nfa_accepts(m, word) <=> epsilon_nfa_accepts(nfa_add_epsilon(m), word)
proof:
  ~use: [nfa_add_epsilon_accepts_iff]
  ~skip: [induct]

theorem public_nfa_add_epsilon_language:
  forall (m :: NFA.of(?q, ?a)):
    nfa_accepts(m) === epsilon_nfa_accepts(nfa_add_epsilon(m))
proof:
  ~use: [nfa_add_epsilon_language]
  ~skip: [induct]

theorem public_dfa_to_nfa_accepts:
  forall (m :: DFA.of(?q, ?a), word :: List.of(?a)):
    dfa_accepts(m, word) <=> nfa_accepts(dfa_to_nfa(m), word)
proof:
  ~use: [dfa_to_nfa_accepts_iff]
  ~skip: [induct]

theorem public_dfa_to_nfa_language:
  forall (m :: DFA.of(?q, ?a)):
    dfa_accepts(m) === nfa_accepts(dfa_to_nfa(m))
proof:
  ~use: [dfa_to_nfa_language]
  ~skip: [induct]

theorem public_epsilon_nfa_determinize_accepts:
  forall (m :: EpsilonNFA.of(?q, ?a), word :: List.of(?a)):
    epsilon_nfa_accepts(m, word) <=> dfa_accepts(epsilon_nfa_determinize(m), word)
proof:
  ~use: [epsilon_nfa_determinize_accepts_iff]
  ~skip: [induct]

theorem public_epsilon_nfa_determinize_language:
  forall (m :: EpsilonNFA.of(?q, ?a)):
    epsilon_nfa_accepts(m) === dfa_accepts(epsilon_nfa_determinize(m))
proof:
  ~use: [epsilon_nfa_determinize_language]
  ~skip: [induct]
