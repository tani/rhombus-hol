#lang rhombus/static

// Every declaration that claims to be derived is checked to have added no
// axiom.
//
// The claim used to rest on the reader following the construction.  It now
// costs a length comparison at each declaration, and the fallback's removal
// is something the compiler enforces rather than something a comment says.

import:
  rhombus/hol/kernel open
  rhombus/hol/surface/driver open
  lib("rhombus/hol/tests/definition/function/fixtures/rec_derived.rhm")!hol_theory as recursive
  lib("rhombus/hol/tests/definition/datatype/fixtures/nonrec_defined.rhm")!hol_theory as nonrecursive
  lib("rhombus/hol/tests/definition/function/fixtures/lex_derived.rhm")!hol_theory as lexicographic
  lib("rhombus/hol/tests/definition/function/fixtures/measure_ok.rhm")!hol_theory as measured

// Four modules exercising four derived paths -- two recursive datatypes with
// their subterm relations, functions defined from their decision trees,
// lexicographic recursion, and a `~measure`.  Each assumes the base logic's
// three and infinity, and nothing of its own.
//
// A module that is *allowed* to postulate is not in this list; the point of
// the guard is that these four cannot start doing so unnoticed.

fun base_count(st :: HolState) :: Int:
  axioms_of(st.ctx.thy).length()

check base_count(recursive.theory) ~is 4
check base_count(nonrecursive.theory) ~is 4
check base_count(lexicographic.theory) ~is 4
check base_count(measured.theory) ~is 4
