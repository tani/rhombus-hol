#lang rhombus/static

// The base theory's axiom count is unchanged after loading a module
// that exercises local functions with lexical capture, an anonymous
// function's desugared extensionality proof, and Set literals: every
// one of those surface features lowers to plain lambda/definition/proof
// machinery already covered by `require_no_new_axioms` (called on every
// `add_datatype`/`add_function`), never to `new_axiom`.

import:
  rhombus/hol/kernel open
  rhombus/hol/surface/driver open
  lib("rhombus/hol/tests/stdlib/fixtures/zero_new_axioms_ok.rhm")!hol_theory as m

def base :~ HolState = initial_state()
def final :~ HolState = m.theory

check axioms_of(final.ctx.thy).length() ~is axioms_of(base.ctx.thy).length()
