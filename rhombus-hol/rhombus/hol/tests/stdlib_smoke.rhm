def smoke_predicate_xor = predicate_xor
def smoke_iso_left_inverse_at = iso_left_inverse_at
def smoke_iso_right_inverse_at = iso_right_inverse_at


// Generic overloaded calls remain available through the public aggregator.
// These programs compose several overloads so both logical elaboration and
// emitted runtime code have to select the same implementations.

function overload_nat_step(n :: Nat) :: Nat:
  succ(n)

function overload_nat_equal(x :: Nat, y :: Nat) :: Boolean:
  x == y

function overloaded_list_program() :: List.of(Nat):
  map(overload_nat_step, cons(zero(), empty()))

function overloaded_option_program() :: Option.of(Nat):
  map(overload_nat_step, empty())

function overloaded_tree_program() :: List.of(Nat):
  reverse(
    flatten(
      map(overload_nat_step,
          branch(leaf(zero()), leaf(nat_one())))))

function overloaded_nonempty_program() :: List.of(Nat):
  to_list(singleton_nonempty(zero()) ++ singleton_nonempty(nat_one()))

function overloaded_string_program() :: Nat:
  size(reverse(map(overload_nat_step, string_singleton(zero()))))

function overloaded_nat_order_program() :: Ordering:
  compare(minimum(nat_one(), nat_two()),
          maximum(nat_one(), nat_two()))

function overloaded_integer_program() :: Integer:
  maximum(int_negative(zero()), minimum(int_zero(), int_one()))

function overloaded_rational_program() :: Ordering:
  compare(minimum(rational_zero(), rational_one()),
          maximum(rational_zero(), rational_one()))

function overloaded_contains_program(xs :: List.of(Nat)) :: Boolean:
  contains(overload_nat_equal, nat_one(), xs)

function overloaded_fset_program() :: Nat:
  size(
    delete(
      overload_nat_equal,
      zero(),
      fset_from_list(
        overload_nat_equal,
        cons(zero(), cons(nat_one(), nil())))))

function overloaded_empty_map_program() :: FiniteMap.of(Nat, Nat):
  empty()

function overloaded_map_program() :: Nat:
  size(
    map(
      overload_nat_step,
      map_insert(
        overload_nat_equal,
        zero(),
        zero(),
        overloaded_empty_map_program())))

function overloaded_set_difference_program(x :: Nat) :: Boolean:
  (set_universal - set_singleton(zero()))(x)

check overloaded_list_program() ~is cons(nat_one(), nil())
check overloaded_option_program() ~is none()
check:
  overloaded_tree_program()
  ~is cons(nat_two(), cons(nat_one(), nil()))
check:
  overloaded_nonempty_program()
  ~is cons(zero(), cons(nat_one(), nil()))
check overloaded_string_program() ~is nat_one()
check overloaded_nat_order_program() ~is less()
check overloaded_integer_program() ~is int_zero()
check overloaded_rational_program() ~is less()
check:
  overloaded_contains_program(cons(zero(), cons(nat_one(), nil())))
  ~is #true
check overloaded_fset_program() ~is nat_one()
check overloaded_map_program() ~is nat_one()
check overloaded_set_difference_program(zero()) ~is #false
check overloaded_set_difference_program(nat_one()) ~is #true
