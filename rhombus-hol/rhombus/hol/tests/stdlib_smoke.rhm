#lang rhombus/hol

// The consumer imports only the public aggregator. Binding every API value
// forces its runtime export and declaration to resolve through that boundary.
import rhombus/hol/stdlib open

def smoke_boolean_xor = boolean_xor
def smoke_boolean_nand = boolean_nand
def smoke_boolean_nor = boolean_nor
def smoke_ordering_reverse = ordering_reverse
def smoke_nat_ge = nat_ge
def smoke_nat_gt = nat_gt
def smoke_nat_double = nat_double
def smoke_nat_square = nat_square
def smoke_list_singleton = list_singleton
def smoke_list_null = list_null
def smoke_list_snoc = list_snoc
def smoke_list_equal = list_equal
def smoke_relation_difference = relation_difference
def smoke_relation_complement = relation_complement
def smoke_relation_symmetric_difference = relation_symmetric_difference
def smoke_relation_equal_at = relation_equal_at
def smoke_set_symmetric_difference = set_symmetric_difference
def smoke_set_equal_at = set_equal_at
def smoke_rose_map = rose_map
def smoke_rose_flatten = rose_flatten
def smoke_rose_member = rose_member
def smoke_rose_height = rose_height
def smoke_int_zero = int_zero
def smoke_int_one = int_one
def smoke_int_compare = int_compare
def smoke_int_min = int_min
def smoke_int_max = int_max
def smoke_fset_from_list = fset_from_list
def smoke_fset_is_empty = fset_is_empty
def smoke_map_size = map_size
def smoke_map_to_list = map_to_list
def smoke_rational_zero = rational_zero
def smoke_rational_one = rational_one
def smoke_rational_compare = rational_compare
def smoke_rational_min = rational_min
def smoke_rational_max = rational_max
def smoke_nat_fibonacci = nat_fibonacci
def smoke_magma_associative_at = magma_associative_at
def smoke_magma_commutative_at = magma_commutative_at
def smoke_magma_idempotent_at = magma_idempotent_at
def smoke_pointed_left_identity_at = pointed_left_identity_at
def smoke_pointed_right_identity_at = pointed_right_identity_at
def smoke_ordered_reflexive_at = ordered_reflexive_at
def smoke_ordered_antisymmetric_at = ordered_antisymmetric_at
def smoke_ordered_transitive_at = ordered_transitive_at
def smoke_ordered_total_at = ordered_total_at
def smoke_quotient_reflexive_at = quotient_reflexive_at
def smoke_quotient_symmetric_at = quotient_symmetric_at
def smoke_quotient_transitive_at = quotient_transitive_at
