#lang rhombus/static

// `stepfn.rhm`: deriving a recursive function's clausal equations via
// `WFREC` instead of postulating them with `new_axiom` (PLAN.md section
// 9.1.2, wiring item 5 -- the `H` step-function decision-tree compiler).
//
// Scope: a single-argument, un-measured `function` whose termination check
// finds plain structural descent into a *known* datatype.  `length` (over
// the polymorphic `List(~a)`) and `double` (over the monomorphic `Nat`)
// each exercise a different datatype shape; both are installed with zero
// new axioms, unlike `install_function`'s postulating fallback.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/bool open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/datatype open
  rhombus/hol/recdef open
  rhombus/hol/subterm open
  rhombus/hol/terminate open
  rhombus/hol/wfrec open
  rhombus/hol/stepfn open
  rhombus/hol/dtree open
  rhombus/hol/algebra open

def tya = TyVar(#'a)
def nat_ty = TyApp(#'Nat, [])
def list_ty = TyApp(#'List, [tya])

def nat_spec:
  DatatypeSpec(#'Nat, [],
               [Ctor(#'zero, []),
                Ctor(#'succ, [Field(#'pred, nat_ty)])])
def list_spec:
  DatatypeSpec(#'List, [#'a],
               [Ctor(#'Nil, []),
                Ctor(#'Cons, [Field(#'head, tya), Field(#'tail, list_ty)])])

// The datatype's own axioms, its subterm relation (installed the ordinary
// way, `subterm.rhm`), and `wfrec_rel`'s definition, all in one theory --
// exactly what `driver.rhm`'s `add_type`/`initial_state` hand
// `install_structural_function` in the real pipeline.
fun setup(base :: Theory, spec :: DatatypeSpec) :: values(Theory, DatatypeThms, List.of(Thm), Thm):
  let (thy0, thms) = datatype_axioms(base, spec)
  let (thy1, tlt_info) = install_function(thy0, subterm_spec(spec) :~ FunSpec,
                                          {spec.name: spec})
  let (thy2, wr_def) = build_wfrec_rel(thy1)
  values(thy2, thms, (tlt_info :~ FunInfo).equations, wr_def)

// `length`'s result type is `Nat`, so its theory needs both datatypes --
// `Nat` declared first (plain, no subterm relation needed by `length`
// itself), then `List` (with its own subterm relation and `wfrec_rel`).
def alg = algebra_base_thms()
def (nat_base, nat_base_thms) = datatype_axioms(algebra_base_theory(), nat_spec)

// -- length(xs :: List(~a)) :: Nat -------------------------------------------

def (thy_l, list_thms, list_tlt_eqs, list_wr_def) = setup(nat_base, list_spec)
def x_var = mk_var(#'x, tya)
def rest_var = mk_var(#'rest, list_ty)
def length_ph = mk_const(#'length, mk_fun(list_ty, nat_ty))
def nil_ctor = mk_const(#'Nil, list_ty)
def cons_ctor = mk_const(#'Cons, mk_fun(tya, mk_fun(list_ty, list_ty)))
def zero_ctor = mk_const(#'zero, nat_ty)
def succ_ctor = mk_const(#'succ, mk_fun(nat_ty, nat_ty))

// What `driver.rhm` threads in: every declared datatype's theorems, and
// the same map keyed by spec for the pattern compiler.
def all_thms = {#'Nat: nat_base_thms, #'List: list_thms}
def all_specs = {#'Nat: nat_spec, #'List: list_spec}

fun tree_of(spec :: FunSpec) :: DecisionTree:
  function_decision_tree(#'function, spec, all_specs)

def length_spec:
  FunSpec(#'length, [list_ty], nat_ty,
          [DefClause([nil_ctor], zero_ctor),
           DefClause([list_mk_comb(cons_ctor, [x_var, rest_var])],
                     mk_comb(succ_ctor, mk_comb(length_ph, rest_var)))])
def length_recinfo:
  check_termination(#'function, #'length, 1,
                    length_spec.clauses.map(fun (cl :: DefClause): [cl.pats, cl.rhs]),
                    length_ph)

check length_recinfo.method ~is #'structural
check can_derive_structurally(length_spec, length_recinfo,
                              tree_of(length_spec), all_thms) ~is #true

def axioms_before_length = axioms_of(thy_l).length()
def (thy_length, length_info):
  install_structural_function(thy_l, list_wr_def, length_spec, list_thms,
                              all_thms, tree_of(length_spec),
                              list_tlt_eqs, length_recinfo, alg)

// No `new_axiom` anywhere in the derivation: same axiom count as the
// datatype + its subterm relation alone.
check axioms_of(thy_length).length() ~is axioms_before_length

check:
  (length_info :~ FunInfo).equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["length(Nil) === zero",
       "forall (x :: 'a, y :: List('a)): length(Cons(x, y)) === succ(length(y))"]
// Every equation is a closed theorem: derived, not assumed.
check:
  (length_info :~ FunInfo).equations.map(fun (t :: Thm): hyps_of(t))
  ~is [[], []]

// -- count_pairs: the recursive call two constructors deep -------------------
//
// The case the old shallow-pattern guard sent to `install_function`'s
// `new_axiom` fallback.  The decision tree splits the tail as well as the
// argument, so the congruence proof splits twice and the derivation goes
// through with zero axioms -- and `Cons(x, ys)`'s clause contributes one
// equation per branch of the split its sibling forced, because `H` cannot
// reduce past a test whose scrutinee is still a variable.

def y_var = mk_var(#'y, tya)
def cp_ph = mk_const(#'count_pairs, mk_fun(list_ty, nat_ty))
def cp_spec:
  FunSpec(#'count_pairs, [list_ty], nat_ty,
          [DefClause([nil_ctor], zero_ctor),
           DefClause([list_mk_comb(cons_ctor, [x_var, nil_ctor])], zero_ctor),
           DefClause([list_mk_comb(cons_ctor,
                                   [x_var,
                                    list_mk_comb(cons_ctor, [y_var, rest_var])])],
                     mk_comb(succ_ctor, mk_comb(cp_ph, rest_var)))])
def cp_recinfo:
  check_termination(#'function, #'count_pairs, 1,
                    cp_spec.clauses.map(fun (cl :: DefClause): [cl.pats, cl.rhs]),
                    cp_ph)

check cp_recinfo.method ~is #'structural
check:
  can_derive_structurally(cp_spec, cp_recinfo, tree_of(cp_spec), all_thms)
  ~is #true

def axioms_before_cp = axioms_of(thy_l).length()
def (thy_cp, cp_info):
  install_structural_function(thy_l, list_wr_def, cp_spec, list_thms,
                              all_thms, tree_of(cp_spec),
                              list_tlt_eqs, cp_recinfo, alg)

check axioms_of(thy_cp).length() ~is axioms_before_cp
check:
  (cp_info :~ FunInfo).equations.map(fun (t :: Thm): hyps_of(t))
  ~is [[], [], []]
check:
  (cp_info :~ FunInfo).equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["count_pairs(Nil) === zero",
       "forall (x :: 'a): count_pairs(Cons(x, Nil)) === zero",
       "forall (x :: 'a, y :: 'a, z :: List('a)): "
         ++ "count_pairs(Cons(x, Cons(y, z))) === succ(count_pairs(z))"]

// -- double(n :: Nat) :: Nat --------------------------------------------------

def (thy_n, nat_thms, nat_tlt_eqs, nat_wr_def) = setup(algebra_base_theory(), nat_spec)
def k_var = mk_var(#'k, nat_ty)
def double_ph = mk_const(#'double, mk_fun(nat_ty, nat_ty))
def nat_only_thms = {#'Nat: nat_thms}
def double_spec:
  FunSpec(#'double, [nat_ty], nat_ty,
          [DefClause([zero_ctor], zero_ctor),
           DefClause([mk_comb(succ_ctor, k_var)],
                     mk_comb(succ_ctor, mk_comb(succ_ctor, mk_comb(double_ph, k_var))))])
def double_recinfo:
  check_termination(#'function, #'double, 1,
                    double_spec.clauses.map(fun (cl :: DefClause): [cl.pats, cl.rhs]),
                    double_ph)
def double_tree:
  function_decision_tree(#'function, double_spec, {#'Nat: nat_spec})

check double_recinfo.method ~is #'structural
check can_derive_structurally(double_spec, double_recinfo, double_tree,
                              nat_only_thms) ~is #true

def axioms_before_double = axioms_of(thy_n).length()
def (thy_double, double_info):
  install_structural_function(thy_n, nat_wr_def, double_spec, nat_thms,
                              nat_only_thms, double_tree,
                              nat_tlt_eqs, double_recinfo, alg)

check axioms_of(thy_double).length() ~is axioms_before_double

check:
  (double_info :~ FunInfo).equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["double(zero) === zero",
       "forall (x :: Nat): double(succ(x)) === succ(succ(double(x)))"]

// -- app(xs :: List(~a), ys :: List(~a)) :: List(~a) -------------------------
//
// Two arguments, so the recursion runs over their product and the relation
// is `List_lt` pulled back along the first projection.  The equations come
// back curried, exactly as if they had been postulated.

def ys_var = mk_var(#'ys, list_ty)
def app_ph = mk_const(#'app, mk_fun(list_ty, mk_fun(list_ty, list_ty)))
def app_spec:
  FunSpec(#'app, [list_ty, list_ty], list_ty,
          [DefClause([nil_ctor, ys_var], ys_var),
           DefClause([list_mk_comb(cons_ctor, [x_var, rest_var]), ys_var],
                     list_mk_comb(cons_ctor,
                                  [x_var,
                                   list_mk_comb(app_ph, [rest_var, ys_var])]))])
def app_recinfo:
  check_termination(#'function, #'app, 2,
                    app_spec.clauses.map(fun (cl :: DefClause): [cl.pats, cl.rhs]),
                    app_ph)

check app_recinfo.method ~is #'structural
// The first column shrinks at the one recursive call; the second does not.
check descent_column(app_spec, app_ph) ~is 0
check:
  can_derive_structurally(app_spec, app_recinfo, tree_of(app_spec), all_thms)
  ~is #true

def axioms_before_app = axioms_of(thy_l).length()
def (thy_app, app_info):
  install_structural_function(thy_l, list_wr_def, app_spec, list_thms,
                              all_thms, tree_of(app_spec),
                              list_tlt_eqs, app_recinfo, alg)

check axioms_of(thy_app).length() ~is axioms_before_app
check (app_info :~ FunInfo).equations.map(fun (t :: Thm): hyps_of(t)) ~is [[], []]
check:
  (app_info :~ FunInfo).equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["forall (x :: List('a)): app(Nil, x) === x",
       "forall (x :: 'a, y :: List('a), z :: List('a)): "
         ++ "app(Cons(x, y), z) === Cons(x, app(y, z))"]

// -- drop: descending in one argument, matching on another's type ------------
//
// The recursion descends in `Nat`, but the second clause splits a `List`.
// The reduction database therefore needs *both* datatypes' discriminators
// and selectors; with only the descending column's, `is_Nil(Nil)` never
// resolves and `H` is left with a stuck `cond`.

def n_var = mk_var(#'n, nat_ty)
def drop_ph = mk_const(#'drop, mk_fun(nat_ty, mk_fun(list_ty, list_ty)))
def drop_spec:
  FunSpec(#'drop, [nat_ty, list_ty], list_ty,
          [DefClause([zero_ctor, ys_var], ys_var),
           DefClause([mk_comb(succ_ctor, k_var), nil_ctor], nil_ctor),
           DefClause([mk_comb(succ_ctor, k_var),
                      list_mk_comb(cons_ctor, [x_var, rest_var])],
                     list_mk_comb(drop_ph, [k_var, rest_var]))])
def drop_recinfo:
  check_termination(#'function, #'drop, 2,
                    drop_spec.clauses.map(fun (cl :: DefClause): [cl.pats, cl.rhs]),
                    drop_ph)
def drop_tree:
  function_decision_tree(#'function, drop_spec, all_specs)
// `thy_l` has `List_lt` but not `Nat_lt`, and `drop` descends in `Nat`.
def (thy_nl, nat_tlt_info):
  install_function(thy_l, subterm_spec(nat_spec) :~ FunSpec, {#'Nat: nat_spec})
def nat_tlt_eqs_for_drop = (nat_tlt_info :~ FunInfo).equations

check descent_column(drop_spec, drop_ph) ~is 0
def axioms_before_drop = axioms_of(thy_nl).length()
def (thy_drop, drop_info):
  install_structural_function(thy_nl, list_wr_def, drop_spec, nat_base_thms,
                              all_thms, drop_tree,
                              nat_tlt_eqs_for_drop, drop_recinfo, alg)

check axioms_of(thy_drop).length() ~is axioms_before_drop
check:
  (drop_info :~ FunInfo).equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["forall (x :: List('a)): drop(zero, x) === x",
       "forall (x :: Nat): drop(succ(x), Nil) === Nil",
       "forall (x :: Nat, y :: 'a, z :: List('a)): "
         ++ "drop(succ(x), Cons(y, z)) === drop(x, z)"]

// -- a definition that does not recurse at all -------------------------------
//
// `RecursionInfo.method` is `#'none`, not `#'structural`.  Nothing about
// the derivation cares: `WFREC` still wants a well-founded relation, but
// the congruence proof has no call to bridge.  Excluding these was costing
// every non-recursive `function` one postulated equation.

def head_or_ph = mk_const(#'head_or, mk_fun(list_ty, nat_ty))
def head_or_spec:
  FunSpec(#'head_or, [list_ty], nat_ty,
          [DefClause([nil_ctor], zero_ctor),
           DefClause([list_mk_comb(cons_ctor, [x_var, rest_var])],
                     mk_comb(succ_ctor, zero_ctor))])
def head_or_recinfo:
  check_termination(#'function, #'head_or, 1,
                    head_or_spec.clauses.map(fun (cl :: DefClause): [cl.pats, cl.rhs]),
                    head_or_ph)

check head_or_recinfo.method ~is #'none
check:
  can_derive_structurally(head_or_spec, head_or_recinfo,
                          tree_of(head_or_spec), all_thms)
  ~is #true

def axioms_before_head_or = axioms_of(thy_l).length()
def (thy_head_or, head_or_info):
  install_structural_function(thy_l, list_wr_def, head_or_spec, list_thms,
                              all_thms, tree_of(head_or_spec),
                              list_tlt_eqs, head_or_recinfo, alg)
check axioms_of(thy_head_or).length() ~is axioms_before_head_or
check:
  (head_or_info :~ FunInfo).equations.map(fun (t :: Thm): show(concl_of(t)))
  ~is ["head_or(Nil) === zero",
       "forall (x :: 'a, y :: List('a)): head_or(Cons(x, y)) === succ(zero)"]

// -- what is still out of this module's scope --------------------------------

// Lexicographic descent: no single column shrinks at every call, so there
// is no projection to pull `T_lt` back along.  (`f(succ(m), zero)` recurses
// on `(m, k)` -- first column down, second up -- and `f(m, succ(k))` on
// `(m, k)` too, but from a clause whose first column is a bare variable.)
def lex_ph = mk_const(#'ack, mk_fun(nat_ty, mk_fun(nat_ty, nat_ty)))
def m_var = mk_var(#'m, nat_ty)
def lex_spec:
  FunSpec(#'ack, [nat_ty, nat_ty], nat_ty,
          [DefClause([zero_ctor, k_var], mk_comb(succ_ctor, k_var)),
           DefClause([mk_comb(succ_ctor, m_var), zero_ctor],
                     list_mk_comb(lex_ph, [m_var, mk_comb(succ_ctor, zero_ctor)])),
           DefClause([mk_comb(succ_ctor, m_var), mk_comb(succ_ctor, k_var)],
                     list_mk_comb(lex_ph,
                                  [m_var,
                                   list_mk_comb(lex_ph,
                                                [mk_comb(succ_ctor, m_var), k_var])]))])
check descent_column(lex_spec, lex_ph) ~is #false
check:
  can_derive_structurally(lex_spec,
                          RecursionInfo([0, 1], #'structural, [], []),
                          DTLeaf(0, []), nat_only_thms)
  ~is #false

// -- a `~measure` definition ------------------------------------------------
//
// Termination settled by a discharged obligation rather than by
// `descends_at`, so there is no descending column at all: the order is the
// measure's *result* type's subterm relation, pulled back along the
// measure.  `pred_of(succ(k))` is not a constructor subterm of `succ(k)`,
// which is exactly why this definition needs a measure.

def pred_of_c = mk_const(#'pred_of, mk_fun(nat_ty, nat_ty))
def cnt_ph = mk_const(#'cnt, mk_fun(nat_ty, nat_ty))
def cnt_spec:
  FunSpec(#'cnt, [nat_ty], nat_ty,
          [DefClause([zero_ctor], zero_ctor),
           DefClause([mk_comb(succ_ctor, k_var)],
                     mk_comb(succ_ctor,
                             mk_comb(cnt_ph,
                                     mk_comb(pred_of_c,
                                             mk_comb(succ_ctor, k_var)))))],
          mk_abs(mk_var(#'n, nat_ty), mk_var(#'n, nat_ty)))

// The measure lands in `Nat`, which is declared, so the derivation applies.
check measure_result_type(cnt_spec) ~is nat_ty
check descent_column(cnt_spec, cnt_ph) ~is #false
check:
  can_derive_structurally(cnt_spec,
                          RecursionInfo([0], #'measure, [], []),
                          function_decision_tree(#'function, cnt_spec, {#'Nat: nat_spec}),
                          nat_only_thms)
  ~is #true

// A measure landing somewhere no datatype declares has no relation to pull
// back, so it stays on the postulating seam.
check:
  let bool_measure = mk_abs(mk_var(#'n, nat_ty), tm_true)
  can_derive_structurally(FunSpec(#'cntb, [nat_ty], nat_ty,
                                  cnt_spec.clauses, bool_measure),
                          RecursionInfo([0], #'measure, [], []),
                          function_decision_tree(#'function, cnt_spec, {#'Nat: nat_spec}),
                          nat_only_thms)
  ~is #false
