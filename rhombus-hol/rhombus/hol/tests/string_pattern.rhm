#lang rhombus/static

// A string literal pattern. A string is `text` applied to the list of its
// codepoints and a codepoint is a unary numeral, so `""` is a two-level
// constructor pattern and works, while a one-character literal is a
// 97-level one whose decision tree exhausts the proof-search budget --
// refused at elaboration with the workaround named, rather than after
// minutes of search.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
  "compiled"

fun error_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/string_pattern_ok.rhm")')
  ~is "compiled"

check:
  error_message(
    ModulePath'lib("rhombus/hol/tests/fixtures/string_pattern_nonempty_bad.rhm")')
    .contains("a non-empty string literal pattern is not supported")
  ~is #true
