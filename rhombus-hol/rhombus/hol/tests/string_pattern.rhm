#lang rhombus/static

// Empty, ASCII, and non-ASCII string literal patterns compile through the
// ordinary String/List constructors and atomic native Nat discrimination.

import:
  "fixture_load.rhm" open
  "fixtures/string_pattern_ok.rhm" as s

def load_positive = make_hol_fixture_loader()

fun load(mp :: ModulePath):
  load_positive(mp)
  "compiled"

check s.runtime_empty() ~is #true
check s.runtime_a() ~is #true
check s.runtime_b() ~is #false
check s.runtime_cjk() ~is #true
check s.runtime_short_cjk() ~is #false


check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/string_pattern_ok.rhm")')
  ~is "compiled"
