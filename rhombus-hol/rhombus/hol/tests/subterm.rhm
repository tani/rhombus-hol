#lang rhombus/static

// The structural subterm relation generated for each datatype: the order a
// `~measure` decreases in.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/bool open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/datatype open
  rhombus/hol/recdef open
  rhombus/hol/terminate open
  rhombus/hol/subterm open

def tya = mk_tyvar(#'a)

def nat:
  DatatypeSpec(#'Nat, [],
               [Ctor(#'zero, []),
                Ctor(#'succ, [Field(#'pred, mk_tyapp(#'Nat, []))])])
def lst:
  DatatypeSpec(#'List, [#'a],
               [Ctor(#'Nil, []),
                Ctor(#'Cons, [Field(#'head, tya),
                              Field(#'tail, mk_tyapp(#'List, [tya]))])])
def tree:
  let t = mk_tyapp(#'Tree, [tya])
  DatatypeSpec(#'Tree, [#'a],
               [Ctor(#'Leaf, []),
                Ctor(#'Node, [Field(#'l, t), Field(#'v, tya), Field(#'r, t)])])
// No recursive field, so no order to speak of.
def color:
  DatatypeSpec(#'Color, [], [Ctor(#'red, []), Ctor(#'blue, [])])

fun install(spec :: DatatypeSpec) :: FunInfo:
  let (thy, _) = datatype_axioms(base_theory(), spec)
  let (_, info) = install_function(thy, subterm_spec(spec) :~ FunSpec,
                                   {spec.name: spec})
  info

fun equations(spec :: DatatypeSpec) :: List.of(String):
  install(spec).equations.map(fun (t :: Thm): show(concl_of(t)))

// `WF(T_lt)`, fully derived from `spec`'s own induction axiom -- no fresh
// axiom, and no hypotheses left over (checked below alongside the
// conclusion, since a hypothesis-laden "theorem" would be free to prove
// anything a caller's own context happened to assume).
fun wf_t_lt(spec :: DatatypeSpec) :: Thm:
  let (thy, thms) = datatype_axioms(base_theory(), spec)
  let (thy2, info) = install_function(thy, subterm_spec(spec) :~ FunSpec, {spec.name: spec})
  prove_wf_t_lt(thy2, spec, (info :~ FunInfo).equations, thms.induction)

// -- a datatype with no recursion has no subterm relation --------------------

check subterm_spec(color) ~is #false
check subterm_name(nat) ~is #'Nat_lt

// -- `Nat_lt` is `<` ---------------------------------------------------------

check:
  equations(nat)
  ~is ["forall (x :: Nat): Nat_lt(x, zero) <=> false",
       "forall (x :: Nat, y :: Nat): Nat_lt(x, succ(y)) <=> x === y or Nat_lt(x, y)"]

// A non-recursive field contributes nothing: `Cons`'s head is not smaller
// than the list, it is not even the same type.

check:
  equations(lst)
  ~is ["forall (x :: List(?a)): List_lt(x, Nil) <=> false",
       "forall (x :: List(?a), y :: ?a, z :: List(?a)):"
         ++ " List_lt(x, Cons(y, z)) <=> x === z or List_lt(x, z)"]

// Both children of a `Node`, and the relation is generated for a datatype
// that branches, not just for a linear one.

check:
  equations(tree)[1]
  ~is "forall (x :: Tree(?a), y :: Tree(?a), z :: ?a, u :: Tree(?a)):"
        ++ " Tree_lt(x, Node(y, z, u))"
        ++ " <=> x === y or (Tree_lt(x, y) or (x === u or Tree_lt(x, u)))"

// -- it is an ordinary definition, so it descends structurally ---------------
//
// This is what makes the relation admissible without any new postulate: it
// goes through `install_function` like any user definition, and its own
// termination is the plain structural one.

check install(nat).recursion ~matches StructuralRecursion([1], [1], _)
check install(tree).recursion ~matches StructuralRecursion([1], [1], _)

// -- `WF(T_lt)` is a genuine derivation, not a postulate ---------------------
//
// The datatype-induction-to-generic-WF
// bridge.  Every shape below exercises a different part of `prove_q_case`'s
// case analysis: `nat` (single self-recursive field), `lst` (a recursive
// field alongside a non-recursive one), and `tree` (two recursive fields
// either side of a non-recursive one, in one constructor).

check show(concl_of(wf_t_lt(nat))) ~is "wf(Nat_lt)"
check hyps_of(wf_t_lt(nat)) ~is []

check show(concl_of(wf_t_lt(lst))) ~is "wf(List_lt)"
check hyps_of(wf_t_lt(lst)) ~is []

check show(concl_of(wf_t_lt(tree))) ~is "wf(Tree_lt)"
check hyps_of(wf_t_lt(tree)) ~is []
