#lang rhombus/static

// `definition` admits logical terms with no executable interpretation. The
// fixture's `select` definition and theorem are checked by `hol_theory`.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

def load_positive = make_hol_fixture_loader()

check:
  load_positive(ModulePath'lib("rhombus/hol/tests/surface/declaration/definition/fixtures/definition_ok.rhm")')
  ~completes

// A `definition` introduces no recursion, so its own name is not in scope
// in its body.
fun bad_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

def self_message:
  bad_message(
    ModulePath'lib("rhombus/hol/tests/surface/declaration/definition/fixtures/definition_self_bad.rhm")')

check:
  self_message.contains("cannot refer to the constant it introduces")
  ~is #true
