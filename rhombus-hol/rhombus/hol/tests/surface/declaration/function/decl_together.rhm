#lang rhombus/static

// The `.together:` declaration families: `datatype`, `function` and
// `inductive` all group the same way, and a group is what makes its members
// mutually recursive.
//
// What a family owes its user is that each member ends up indistinguishable
// from an ordinary declaration -- the same theorems, in the same shapes, and
// the same executable reading -- plus the one theorem no single member can
// state, the family's joint induction. The checks below are about those
// statements, not about the union type and tag datatypes they are derived
// from.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/surface/driver open
  rhombus/hol/definition/datatype/define open
  rhombus/hol/definition/function/spec open
  rhombus/hol/prover/context open
  lib("rhombus/hol/tests/surface/declaration/function/fixtures/mutual_ok.rhm") as rt
  lib("rhombus/hol/tests/surface/declaration/function/fixtures/mutual_ok.rhm")!hol_theory as m

def st :~ HolState = m.theory

def nat = mk_tyapp(#'Nat, [])
def expr = mk_tyapp(#'Expr, [])
def args = mk_tyapp(#'Args, [])

// -- the family's members are ordinary datatypes -----------------------------

check st.ctx.dts.has_key(#'Expr) ~is #true
check st.ctx.dts.has_key(#'Args) ~is #true

// Each member's induction hypothesis is about its own recursive fields, the
// shape everything downstream consumes: `Args` recurses in `acons`'s tail,
// and `Expr` has no field at itself at all.
def args_induction = (st.ctx.dts[#'Args] :~ DatatypeThms).induction
def p_args = mk_var(#'P, mk_fun(args, bool))
def anil = mk_const(#'anil, args)
def acons = mk_const(#'acons, mk_fun(expr, mk_fun(args, args)))
def v0 = mk_var(#'v0, expr)
def v1 = mk_var(#'v1, args)

check:
  concl_of(args_induction)
  ~is mk_forall(
        p_args,
        mk_imp(mk_conj(mk_comb(p_args, anil),
                       mk_forall_list(
                         [v0, v1],
                         mk_imp(mk_comb(p_args, v1 :~ Term),
                                mk_comb(p_args,
                                        list_mk_comb(acons, [v0 :~ Term,
                                                             v1 :~ Term]))))),
               mk_forall(v1, mk_comb(p_args, v1 :~ Term))))

// -- the joint induction, which no member can state on its own ---------------

def joint = st.thms[#'Expr_Args_union_induct]
def p_expr = mk_var(#'P0, mk_fun(expr, bool))
def q_args = mk_var(#'P1, mk_fun(args, bool))

// Its hypotheses may be about either member: `app`'s field is an `Args`, and
// `acons`'s fields are one of each.
check is_forall(concl_of(joint)) ~is #true
check hyps_of(joint).length() ~is 0
check:
  free_vars(concl_of(joint)).length()
  ~is 0

// -- no axiom, anywhere ------------------------------------------------------

check:
  axioms_of(st.ctx.thy).length()
  ~is axioms_of(initial_state().ctx.thy).length()

// -- the mutual functions' own equations -------------------------------------
//
// The members are what a proof sees; the tagged function they are derived
// from never appears in their statements, whether or not the family needed a
// result tag.

def a_size = mk_const(#'a_size, mk_fun(args, nat))
def e_size = mk_const(#'e_size, mk_fun(expr, nat))
def a_count = mk_const(#'a_count, mk_fun(args, nat))
def e_flat = mk_const(#'e_flat, mk_fun(expr, bool))
def zero = mk_const(#'zero, nat)
def succ = mk_const(#'succ, mk_fun(nat, nat))
def lit = mk_const(#'lit, mk_fun(nat, expr))

check:
  for all (name in [#'a_size, #'e_size, #'a_count, #'e_flat,
                    #'peel, #'family_zero, #'tone_value, #'literal_value]):
    st.ctx.funs.has_key(name :~ Symbol)
  ~is #true

// An explicit family can contain an inert member. Its durable metadata records
// only the member's own recursive behavior, not the combined implementation's.
check:
  (st.ctx.funs[#'peel] :~ FunInfo).induction
  ~matches RecursiveInduction(_)
check:
  (st.ctx.funs[#'family_zero] :~ FunInfo).induction
  ~matches NonRecursiveInduction()

check:
  concl_of((st.ctx.funs[#'a_size] :~ FunInfo).equations[0])
  ~is mk_eq(mk_comb(a_size, anil), zero)

def n = mk_var(#'n, nat)
check:
  concl_of((st.ctx.funs[#'e_size] :~ FunInfo).equations[0])
  ~is mk_forall(n, mk_eq(mk_comb(e_size, mk_comb(lit, n :~ Term)),
                         mk_comb(succ, zero)))

// The family with two result types states its Boolean member's equation as
// an equation on `Boolean`, with no trace of the tagging.
check:
  concl_of((st.ctx.funs[#'e_flat] :~ FunInfo).equations[0])
  ~is mk_forall(n, mk_eq(mk_comb(e_flat, mk_comb(lit, n :~ Term)),
                         tm_false))

// The ordered catch-all in the one-member explicit family owns two refined
// leaves, and both survive as rewrite equations.
check (st.ctx.funs[#'tone_value] :~ FunInfo).equations.length() ~is 3
check (st.ctx.funs[#'literal_value] :~ FunInfo).equations.length() ~is 2

// Every equation is closed and came from this theory: a derived equation
// with an assumption left over would rewrite on something never proved.
check:
  for any (name in [#'a_size, #'e_size, #'a_count, #'e_flat,
                    #'tone_value, #'literal_value]):
    for any (th in (st.ctx.funs[name :~ Symbol] :~ FunInfo).equations):
      hyps_of(th :~ Thm).length() != 0
  ~is #false

// The theorems in the fixture were proved while it compiled, which is the
// real check that the equations reached the rewriter.
check:
  for all (name in [#'size_nil, #'size_lit, #'flat_of_lit, #'count_of_lit,
                    #'even_two, #'peel_one, #'family_zero_eq,
                    #'tone_cold, #'tone_warm, #'tone_hot,
                    #'literal_zero, #'literal_one,
                    #'app_injective, #'lit_is_not_app, #'expr_exhaustive]):
    st.thms.has_key(name :~ Symbol)
  ~is #true

// A family whose members each supply a `~measure:` descends in the measure's
// type; its members' equations are stated the same way.
def even = mk_const(#'even, mk_fun(nat, bool))
check:
  concl_of((st.ctx.funs[#'even] :~ FunInfo).equations[0])
  ~is mk_eq(mk_comb(even, zero), tm_true)

// -- and the executable reading agrees ---------------------------------------

check rt.a_size(rt.anil()) ~is rt.zero()
check rt.e_size(rt.lit(rt.zero())) ~is rt.succ(rt.zero())
check:
  rt.e_size(rt.app(rt.acons(rt.lit(rt.zero()),
                            rt.acons(rt.lit(rt.zero()), rt.anil()))))
  ~is rt.succ(rt.succ(rt.succ(rt.zero())))

// `a_count` counts the elements that are not flat, and an `app` is flat
// exactly when its own arguments count zero -- so the two members really do
// call each other.
check rt.e_flat(rt.lit(rt.zero())) ~is #false
check rt.e_flat(rt.app(rt.anil())) ~is #true
check rt.e_flat(rt.app(rt.acons(rt.lit(rt.zero()), rt.anil()))) ~is #false
check rt.a_count(rt.acons(rt.lit(rt.zero()), rt.anil())) ~is rt.succ(rt.zero())
check rt.a_count(rt.acons(rt.app(rt.anil()), rt.anil())) ~is rt.zero()
check rt.even(rt.succ(rt.succ(rt.zero()))) ~is #true
check rt.odd(rt.succ(rt.succ(rt.zero()))) ~is #false
check rt.peel(rt.succ(rt.zero())) ~is rt.zero()
check rt.family_zero() ~is rt.zero()
check rt.tone_value(rt.cold()) ~is rt.zero()
check rt.tone_value(rt.warm()) ~is rt.succ(rt.zero())
check rt.tone_value(rt.hot()) ~is rt.succ(rt.zero())
check rt.literal_value(rt.zero()) ~is rt.zero()
check rt.literal_value(rt.succ(rt.zero())) ~is rt.succ(rt.zero())

// -- what the families refuse ------------------------------------------------

fun bad_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

def empty_message:
  bad_message(
    ModulePath'lib("rhombus/hol/tests/surface/declaration/function/fixtures/mutual_datatype_empty_bad.rhm")')
def nonterminating_message:
  bad_message(
    ModulePath'lib("rhombus/hol/tests/surface/declaration/function/fixtures/mutual_function_nonterminating_bad.rhm")')
def measure_types_message:
  bad_message(
    ModulePath'lib("rhombus/hol/tests/surface/declaration/function/fixtures/mutual_measure_types_bad.rhm")')

check empty_message.contains("no value of this type can be built") ~is #true
check nonterminating_message.contains("cannot see that this family terminates") ~is #true
check:
  measure_types_message.contains("must measure into the same type")
  ~is #true
