#lang rhombus/hol

// `fun` emits executable Rhombus with the annotations erased, and from the
// same source registers the clausal equations with the kernel.

export:
  Nil
  Cons
  List
  zero
  succ
  Nat
  app
  rev
  length
  plus
  double
  sample
  first_of
  deferred_numeral_probe

datatype List.of(?a)
| Nil()
| Cons(head :: ?a, tail :: List.of(?a))

datatype Nat
| zero()
| succ(pred :: Nat)

function app(xs :: List.of(?a), ys :: List.of(?a)) :: List.of(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

function rev(xs :: List.of(?a)) :: List.of(?a):
  match xs
  | Nil(): Nil()
  | Cons(x, rest): app(rev(rest), Cons(x, Nil()))

function length(xs :: List.of(?a)) :: Nat:
  match xs
  | Nil(): zero()
  | Cons(x, rest): succ(length(rest))

function plus(m :: Nat, n :: Nat) :: Nat:
  match m
  | zero(): n
  | succ(k): succ(plus(k, n))

// A polymorphic argument's own type may come from a *later* argument, not
// the one syntactically first: `first_of(3, succ(zero()))` only knows `3`
// means `Nat` once the second argument pins `?a`. The general application
// case has to defer eagerly-ambiguous arguments (a bare numeral) exactly
// the way logical elaboration already does, or this fails to compile as
// a `function` body even though the identical call elaborates fine as a
// `theorem`.
function first_of(a :: ?a, b :: ?a) :: ?a:
  block:
    let _ = b
    a

function deferred_numeral_probe() :: Nat:
  first_of(3, succ(zero()))

// The subterm relation of each recursive datatype is declared alongside it:
// that is where a `~measure` into `Nat` or `List` finds its order.

// An ordinary Rhombus `fun` is never intercepted: only `function` declares a
// logical definition, so this needs no annotations and gains no axioms.
fun double(n): n * 2

def sample = Cons(1, Cons(2, Cons(3, Nil())))
