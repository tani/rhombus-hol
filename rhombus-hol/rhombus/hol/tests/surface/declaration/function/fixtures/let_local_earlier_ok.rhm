#lang rhombus/hol

// A local named function may call an *earlier* local function in the same
// body -- only self- and forward-reference through local-function sugar
// are restricted. It also closes over its enclosing function's
// parameters, exactly as an ordinary nested lambda would.

export: Nat zero succ outer add_offset

datatype Nat
| zero()
| succ(pred :: Nat)

function outer(n :: Nat) :: Nat:
  function step(k :: Nat) :: Nat:
    succ(k)
  function twice(k :: Nat) :: Nat:
    step(step(k))
  twice(n)

// `bump`'s body is free in `offset`, bound by `add_offset`, not by `bump`
// itself.
function add_offset(offset :: Nat) :: Nat:
  function bump(k :: Nat) :: Nat:
    succ(offset)
  bump(offset)
