#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

// A local named function referencing its own name is self-recursion through
// local-function sugar, which is not supported: nothing here proves it
// terminates, and nothing checks that it would.
function outer(n :: Nat) :: Nat:
  function inner(k :: Nat) :: Nat:
    inner(k)
  inner(n)
