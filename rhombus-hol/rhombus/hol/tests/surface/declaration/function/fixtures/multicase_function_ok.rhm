#lang rhombus/hol

// `function | (pat): body | ...` -- the case-clause form that supplies
// parameters via patterns instead of an explicit signature -- works both
// as named local sugar (every case, not just the first) and as a fully
// anonymous function value, correctly lowering to a decision tree over
// the declared datatype that reduces to the expected value.

export: Nat zero succ apply1 outer

datatype Nat
| zero()
| succ(pred :: Nat)

function apply1(f :: Nat -> Nat, n :: Nat) :: Nat:
  f(n)

// Named local sugar: the (already-verified) omitted-type inference fills
// in both the parameter and result types from each case's own patterns.
function outer(x :: Nat) :: Nat:
  function named_multicase
  | (zero()): zero()
  | (succ(k)): k
  apply1(named_multicase, x)

theorem named_multicase_zero:
  outer(zero()) === zero()

theorem named_multicase_succ:
  outer(succ(succ(zero()))) === succ(zero())

// The same clause form as a fully anonymous higher-order function value,
// passed directly as an argument.
theorem anon_multicase_zero:
  apply1(
    function
    | (zero()): zero()
    | (succ(k)): k,
    zero()) === zero()
