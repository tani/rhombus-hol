#lang rhombus/hol

// Neither member can be built without the other, so no value of the family
// exists. HOL types are inhabited by assumption, so this is an
// inconsistency rather than an empty type, and the declaration is refused.
datatype.together:
  datatype Ping
  | ping(other :: Pong)
  datatype Pong
  | pong(other :: Ping)

def marker = "compiled"
