#lang rhombus/hol

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Lst
| nil()
| cns(head :: Nat, tail :: Lst)

// The members' measures are read as one measure over the family's tag, so
// they have to compare in one order. These measure into different types, so
// there is no order for the family to descend in and the declaration is
// refused -- rather than failing while the combined measure is built.
function.together:
  function p1(n :: Nat) :: Nat
  | (zero()): zero()
  | (succ(k)): p2(nil())
  proof:
    ~measure: n
  function p2(l :: Lst) :: Nat
  | (nil()): zero()
  | (cns(h, t)): p1(h)
  proof:
    ~measure: l

def marker = "compiled"
