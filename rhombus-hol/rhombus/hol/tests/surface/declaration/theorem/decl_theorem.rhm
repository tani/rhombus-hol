#lang rhombus/static

// `theorem`, the optional `proof:` clause, attributes, and the residue
// a failed proof reports.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open
  rhombus/hol/kernel/type open
  rhombus/hol/kernel/term open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/surface/elaborate open
  rhombus/hol/surface/declaration/theorem open
  rhombus/hol/surface/overload open
  rhombus/hol/surface/type/registry open
  rhombus/hol/surface/core open
  rhombus/hol/surface/driver open
  rhombus/hol/definition/function/spec open
  rhombus/hol/prover/proof/node open
  rhombus/hol/prover/tactic/induction open
  rhombus/hol/prover/waterfall open
  lib("rhombus/hol/tests/surface/declaration/theorem/fixtures/theorem_ok.rhm") as t
  lib("rhombus/hol/tests/surface/declaration/theorem/fixtures/theorem_ok.rhm")!hol_theory as logical_t

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

def load_positive = make_hol_fixture_loader()

fun bad(which :: Symbol):
  match which
  | #'stuck: load(ModulePath'lib("rhombus/hol/tests/surface/declaration/theorem/fixtures/theorem_stuck.rhm")')
  | #'do_not_stuck:
      load(ModulePath'lib("rhombus/hol/tests/surface/declaration/theorem/fixtures/theorem_do_not_stuck.rhm")')
  | #'do_not_bad_name:
      load(ModulePath'lib("rhombus/hol/tests/surface/declaration/theorem/fixtures/theorem_do_not_bad_name.rhm")')
  | #'in_theory_stuck:
      load(ModulePath'lib("rhombus/hol/tests/surface/declaration/theorem/fixtures/theorem_in_theory_stuck.rhm")')
  | #'not_automatic:
      load(ModulePath'lib("rhombus/hol/tests/surface/declaration/theorem/fixtures/theorem_not_automatic.rhm")')
fun bad_message(which :: Symbol) :: String:
  try:
    block:
      bad(which)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

// -- the module compiled, so every theorem in it was proved ------------------
//
// The fixture contains adjacent theorems with and without explicit proof
// clauses. Compilation and the executable assertion below confirm that none
// swallowed the declaration after it.

check t.app(t.Cons(1, t.Nil()), t.Nil()) ~is t.Cons(1, t.Nil())

// ==========================================================================
// the proposition parser
// ==========================================================================

def thy:
  let x = new_type(base_theory(), #'Nat, 0)
  let n = mk_tyapp(#'Nat, [])
  let x = new_constant(x, #'zero, n)
  let x = new_constant(x, #'succ, mk_fun(n, n))
  let x = new_constant(x, #'p, mk_fun(n, bool))
  new_constant(x, #'q, mk_fun(n, bool))
def type_constructors:
  add_declared_type_constructor(
    standard_type_constructor_registry(), #'Nat, 0)

// Core proposition elaboration builds the expected logical term at every
// connective and binder boundary.
def at = 'core_expression'
fun cref(n :: Symbol): CoreRef(n, at)
fun ccall(n :: Symbol, args :: List.of(CoreExpr)):
  CoreCall(cref(n), args, at)
fun parsed(e :: CoreExpr) :: Term:
  parse_core_prop(
    thy, [], {}, e, ~type_constructors: type_constructors)

def nat_ty = mk_tyapp(#'Nat, [])
def zero_t = mk_const(#'zero, nat_ty)
def succ_t = mk_const(#'succ, mk_fun(nat_ty, nat_ty))
def p_t = mk_const(#'p, mk_fun(nat_ty, bool))
def q_t = mk_const(#'q, mk_fun(nat_ty, bool))
def zero_c = cref(#'zero)
def pz = ccall(#'p, [zero_c])
def qz = ccall(#'q, [zero_c])
def p_zero = mk_comb(p_t, zero_t)
def q_zero = mk_comb(q_t, zero_t)
check:
  run_elaboration(
    ElabEnv(thy, [], {}, #'prop, #false, #false,
            standard_overload_registry(), type_constructors),
    pz)
  ~is p_zero
check:
  run_type_elaboration(
    ElabEnv(thy, [#'a], {}, #'prop, #false, #false,
            standard_overload_registry(), type_constructors),
    '? a')
  ~is mk_tyvar(#'a)
check:
  run_checked_elaboration(
    ElabEnv(thy, [], {}, #'prop, #false, #false,
            standard_overload_registry(), type_constructors),
    pz, bool)
  ~is p_zero
fun binary(n :: Symbol, left :: CoreExpr, right :: CoreExpr):
  ccall(n, [left, right])
fun binder(n :: Symbol): CoreBinder(CorePatVar(n, at), 'Nat', at)

check parsed(binary(#'conj, pz, qz)) ~is mk_conj(p_zero, q_zero)
check:
  parsed(binary(#'disj, binary(#'conj, pz, qz), pz))
  ~is mk_disj(mk_conj(p_zero, q_zero), p_zero)
check:
  parsed(binary(#'disj, pz, binary(#'conj, qz, pz)))
  ~is mk_disj(p_zero, mk_conj(q_zero, p_zero))
check:
  parsed(binary(#'conj, ccall(#'neg, [pz]), qz))
  ~is mk_conj(mk_neg(p_zero), q_zero)
check:
  parsed(ccall(#'neg, [binary(#'conj, pz, qz)]))
  ~is mk_neg(mk_conj(p_zero, q_zero))
check:
  parsed(binary(#'eq, zero_c, ccall(#'succ, [zero_c])))
  ~is mk_eq(zero_t, mk_comb(succ_t, zero_t))
check:
  parsed(binary(#'conj,
                binary(#'eq, zero_c, ccall(#'succ, [zero_c])),
                pz))
  ~is mk_conj(mk_eq(zero_t, mk_comb(succ_t, zero_t)), p_zero)
check:
  parsed(binary(#'imp, pz, binary(#'imp, qz, pz)))
  ~is mk_imp(p_zero, mk_imp(q_zero, p_zero))
check:
  parsed(binary(#'imp, binary(#'imp, pz, qz), pz))
  ~is mk_imp(mk_imp(p_zero, q_zero), p_zero)
check:
  parsed(binary(#'imp, binary(#'conj, pz, qz), pz))
  ~is mk_imp(mk_conj(p_zero, q_zero), p_zero)
check:
  parsed(binary(#'eq, pz, binary(#'imp, qz, pz)))
  ~is mk_eq(p_zero, mk_imp(q_zero, p_zero))

def nref = cref(#'n)
def mref = cref(#'m)
def n_t = mk_var(#'n, nat_ty)
def m_t = mk_var(#'m, nat_ty)
check:
  parsed(CoreForall([binder(#'n)], ccall(#'p, [nref]), at))
  ~is mk_forall(n_t, mk_comb(p_t, n_t))
check:
  parsed(CoreForall([binder(#'n), binder(#'m)],
                    binary(#'imp, ccall(#'p, [nref]), ccall(#'q, [mref])),
                    at))
  ~is mk_forall(n_t,
                mk_forall(m_t,
                          mk_imp(mk_comb(p_t, n_t), mk_comb(q_t, m_t))))
check:
  parsed(CoreExists([binder(#'n)],
                    binary(#'conj, ccall(#'p, [nref]), ccall(#'q, [nref])),
                    at))
  ~is mk_exists(n_t, mk_conj(mk_comb(p_t, n_t), mk_comb(q_t, n_t)))

check:
  let statement = CoreForall([binder(#'xs), binder(#'ys)],
                             binary(#'eq, cref(#'xs), cref(#'ys)),
                             at)
  let (_, names) = elaborate_theorem_statement(
                     thy, statement,
                     ~type_constructors: type_constructors)
  names
  ~is [#'xs, #'ys]

// ==========================================================================
// the proof-option parser
// ==========================================================================

def default_tactic_options = {#'induct: [],
                              #'use: [],
                              #'skip: [],
                              #'disable: [],
                              #'split: [],
                              #'choose: [],
                              #'limit: #false,
                              #'extensionality: []}
check parse_tactic(#false) ~is default_tactic_options
check:
  parse_tactic(
    '«
       ~induct: [xs, ys]
       ~extensionality: [x, y]
       ~use: [a, b]
       ~skip: [fertilize, generalize]
       ~disable: [foo, bar]
     »')
  ~is default_tactic_options
        ++ {#'induct: [#'xs, #'ys],
            #'extensionality: [#'x, #'y],
            #'use: [#'a, #'b],
            #'skip: [#'fertilize, #'generalize],
            #'disable: [#'foo, #'bar]}
check:
  let parsed = parse_tactic('~split: [p(x), q(y, z)]')
  let cases = parsed[#'split] :~ List
  let first:
    match cases[0] :~ Syntax
    | 'p(x)': #'first
    | ~else: #'other
  let second:
    match cases[1] :~ Syntax
    | 'q(y, z)': #'second
    | ~else: #'other
  [first, second]
  ~is [#'first, #'second]
check:
  let parsed = parse_tactic('~choose: [x, f(y)]')
  let witnesses = parsed[#'choose] :~ List
  let second:
    match witnesses[1] :~ Syntax
    | 'f(y)': #'application
    | ~else: #'other
  [Syntax.unwrap(witnesses[0] :~ Syntax), second]
  ~is [#'x, #'application]

// A second occurrence is always an error; lists never accumulate across
// option groups.
check:
  parse_tactic(
    '«
       ~induct: [xs]
       ~induct: [ys]
     »')
  ~throws "duplicate `~induct` option"
check:
  parse_tactic(
    '«
       ~extensionality: [x]
       ~extensionality: [y]
     »')
  ~throws "duplicate `~extensionality` option"
check:
  parse_tactic(
    '«
       ~use: [a]
       ~use: [b]
     »')
  ~throws "duplicate `~use` option"
check:
  parse_tactic(
    '«
       ~skip: [fertilize]
       ~skip: [generalize]
     »')
  ~throws "duplicate `~skip` option"
check:
  parse_tactic(
    '«
       ~disable: [foo]
       ~disable: [bar]
     »')
  ~throws "duplicate `~disable` option"
check:
  parse_tactic(
    '«
       ~split: [p]
       ~split: [q]
     »')
  ~throws "duplicate `~split` option"
check:
  parse_tactic(
    '«
       ~choose: [x]
       ~choose: [y]
     »')
  ~throws "duplicate `~choose` option"

// Every list-valued option rejects both scalar and empty-list spellings with
// its own diagnostic.
check:
  parse_tactic('~induct: xs')
  ~throws "`~induct` expects one nonempty bracketed list of identifiers"
check:
  parse_tactic('~extensionality: x')
  ~throws "`~extensionality` expects one nonempty bracketed list of identifiers"
check:
  parse_tactic('~use: a')
  ~throws "`~use` expects one nonempty bracketed list of theorem names"
check:
  parse_tactic('~skip: simplify')
  ~throws "`~skip` expects one nonempty bracketed list of stage names"
check:
  parse_tactic('~disable: foo')
  ~throws "`~disable` expects one nonempty bracketed list of rule names"
check:
  parse_tactic('~split: p(x)')
  ~throws "`~split` expects one nonempty bracketed list of propositions"
check:
  parse_tactic('~choose: x')
  ~throws "`~choose` expects one nonempty bracketed list of expressions"
check:
  parse_tactic('~induct: []')
  ~throws "`~induct` expects one nonempty bracketed list of identifiers"
check:
  parse_tactic('~extensionality: []')
  ~throws "`~extensionality` expects one nonempty bracketed list of identifiers"
check:
  parse_tactic('~use: []')
  ~throws "`~use` expects one nonempty bracketed list of theorem names"
check:
  parse_tactic('~skip: []')
  ~throws "`~skip` expects one nonempty bracketed list of stage names"
check:
  parse_tactic('~disable: []')
  ~throws "`~disable` expects one nonempty bracketed list of rule names"
check:
  parse_tactic('~split: []')
  ~throws "`~split` expects one nonempty bracketed list of propositions"
check:
  parse_tactic('~choose: []')
  ~throws "`~choose` expects one nonempty bracketed list of expressions"

// `~limit` remains the only scalar option and retains its singleton checks.
check:
  parse_tactic('~limit: 500000')
  ~is default_tactic_options ++ {#'limit: 500000}
check:
  parse_tactic(
    '«
       ~limit: 1
       ~limit: 2
     »')
  ~throws "duplicate `~limit` option"
check parse_tactic('~limit: -1') ~throws "search steps cannot be negative"
check parse_tactic('induct(xs)') ~throws "unknown proof option"
check parse_tactic('qed') ~throws "unknown proof option"
check parse_tactic('auto') ~throws "unknown proof option"

// Ordered nested hints survive the strengthening that generalizes a recursive
// companion. The first induction's logical subgoals are unchanged, while each
// branch records the freshly reopened variable that the second hint must use.
def nested_state :~ HolState = logical_t.theory
def nested_app_info :~ FunInfo = nested_state.ctx.funs[#'app]
def nested_list_type = nested_app_info.spec.arg_types[0]
def nested_xs = mk_var(#'xs, nested_list_type)
def nested_ys = mk_var(#'ys, nested_list_type)
def nested_app_xy = mk_comb(
                      mk_comb(nested_app_info.fn, nested_xs),
                      nested_ys)
def nested_goal = Goal([], mk_eq(nested_app_xy, nested_app_xy))
def ordinary_first = induction_attempt(
                       nested_state.ctx.thy, nested_state.ctx.funs,
                       nested_state.ctx.dts, nested_state.ctx.schemes,
                       nested_xs, nested_goal) :~ Step
def ordered_first = induction_attempt_with_remap(
                      nested_state.ctx.thy, nested_state.ctx.funs,
                      nested_state.ctx.dts, nested_state.ctx.schemes,
                      nested_xs, nested_goal) :~ InductionAttempt
check:
  ordinary_first.subgoals.map(fun (g :: Goal): g.concl)
  ~is ordered_first.step.subgoals.map(fun (g :: Goal): g.concl)
check:
  for any (subgoal in ordered_first.step.subgoals,
           remap in ordered_first.remaps):
    match (remap :~ Map).get(nested_ys, #false)
    | #false: #true
    | reopened:
        induction_attempt(
          nested_state.ctx.thy, nested_state.ctx.funs,
          nested_state.ctx.dts, nested_state.ctx.schemes,
          reopened :~ FVar, subgoal :~ Goal) == #false
  ~is #false

// Every explicit extensionality name is consumed before ordinary proof search.
// An overlong list therefore fails at the first non-function equality instead
// of silently ignoring its tail.
def nested_function = mk_var(
                        #'f, mk_fun(bool, mk_fun(bool, bool)))
def nested_function_equality = mk_forall(
                                 nested_function,
                                 mk_eq(nested_function, nested_function))
check:
  let (proved, _) = prove(
                      nested_state.ctx, nested_function_equality,
                      ~names: [#'f],
                      ~extensionality: [#'x, #'y])
  proved != #false
  ~is #true
check:
  prove(nested_state.ctx, nested_function_equality,
        ~names: [#'f],
        ~extensionality: [#'x, #'y, #'z])
  ~throws "`~extensionality` requires an equality between functions"

// ==========================================================================
// a failed proof is a compile error with the residue and a location
// ==========================================================================

def stuck_message = bad_message(#'stuck)
def do_not_stuck_message = bad_message(#'do_not_stuck)
def do_not_bad_name_message = bad_message(#'do_not_bad_name)
def in_theory_stuck_message = bad_message(#'in_theory_stuck)
def not_automatic_message = bad_message(#'not_automatic)

check stuck_message.contains("could not prove") ~is #true
check stuck_message.contains("theorem_stuck.rhm:21") ~is #true
// The trail says how the prover got where it stopped -- the specific
// heuristic path (which stages fire, which variable induction picks) is not
// the thing under test and shifts as the waterfall gains stages; only that
// the trail names real tactics is.
check stuck_message.contains("induction on") ~is #true
check stuck_message.contains("simplification") ~is #true

// -- `skip` omits named waterfall stages for one proof -----------------------

// turning off the one stage a proof genuinely needs leaves it stuck, same as
// any other under-powered proof -- `skip` cannot make a proof succeed
// that would not otherwise, only decline to try something that would have
check do_not_stuck_message.contains("could not prove") ~is #true

// an unrecognised stage name is rejected up front, not silently ignored
check do_not_bad_name_message.contains("no such waterfall stage to skip") ~is #true

// -- `disable` removes named rules for one proof -----------------------------

// disabling the one rule a proof genuinely needs leaves it stuck, same as
// `skip` -- `disable` cannot make a proof succeed that would not
// otherwise, only decline to use a rule that would have
check in_theory_stuck_message.contains("could not prove") ~is #true

// A theorem does not enter the shared RuleDB merely because it was proved.
check not_automatic_message.contains("could not prove") ~is #true

// the disable does not leak into a later theorem in the same module that
// needs the same rule and gives no hint of its own
check:
  load_positive(ModulePath'lib("rhombus/hol/tests/surface/declaration/theorem/fixtures/theorem_in_theory_scoped.rhm")')
  ~completes
