#lang rhombus/hol

// `theorem` with and without a `proof:` clause, attributes, and rule control.

export:
  List
  Nil
  Cons
  app

datatype List.of(?a)
| Nil()
| Cons(head :: ?a, tail :: List.of(?a))

function app(xs :: List.of(?a), ys :: List.of(?a)) :: List.of(?a):
  match xs
  | Nil(): ys
  | Cons(x, rest): Cons(x, app(rest, ys))

// No `proof:` clause at all: default automation chooses the induction
// variable without a hint.
theorem app_nil_r:
  forall (xs :: List.of(?a)):
    app(xs, Nil()) === xs

// An explicit hint, for the same effect.
theorem app_assoc:
  forall (xs :: List.of(?a), ys :: List.of(?a), zs :: List.of(?a)):
    app(app(xs, ys), zs) === app(xs, app(ys, zs))
proof:
  ~induct: [xs]

// Two theorems in a row: the second must not be mistaken for the first's
// proof clause.
theorem app_nil_l:
  forall (ys :: List.of(?a)):
    app(Nil(), ys) === ys

theorem app_nil_both:
  app(Nil(), Nil()) === Nil()

// `skip` omits named waterfall stages for this proof only. Plain
// structural induction proves this one without ever reaching fertilization,
// generalization or irrelevance elimination, so turning all three off still
// succeeds -- the hint changes what the prover tries, never what a finished
// proof is allowed to conclude.
theorem app_assoc_no_fertilize:
  forall (xs :: List.of(?a), ys :: List.of(?a), zs :: List.of(?a)):
    app(app(xs, ys), zs) === app(xs, app(ys, zs))
proof:
  ~induct: [xs]
  ~skip: [fertilize, generalize, irrelevance]
