#lang rhombus/static

// `exists1` and `select` are logical (prop) constructs, not executable
// ones: they assert unique existence / pick a witness without computing
// one. Both are rejected inside an ordinary `function` body, which
// admits only the executable expression subset.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

fun bad_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

def exists1_message:
  bad_message(ModulePath'lib("rhombus/hol/tests/surface/expression/fixtures/exists1_in_function_bad.rhm")')
def select_message:
  bad_message(ModulePath'lib("rhombus/hol/tests/surface/expression/fixtures/select_in_function_bad.rhm")')

def restriction_text = "a logical function body admits only variables, constructors"

check exists1_message.contains(restriction_text) ~is #true
check select_message.contains(restriction_text) ~is #true
