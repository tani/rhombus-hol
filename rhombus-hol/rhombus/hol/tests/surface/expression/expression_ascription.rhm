#lang rhombus/static

// `expr :: Type` works as a general expected-type annotation: it
// disambiguates an otherwise-ambiguous numeral or nullary overload, and
// constrains a polymorphic call's instantiation. Every case here proves
// outright (not merely a correctly-typed stuck goal), since ascription
// only affects elaboration/type inference, not proof search.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

def load_positive = make_hol_fixture_loader()

check:
  load_positive(
    ModulePath'lib("rhombus/hol/tests/surface/expression/fixtures/expr_ascription_ok.rhm")')
  "compiled"
  ~is "compiled"
