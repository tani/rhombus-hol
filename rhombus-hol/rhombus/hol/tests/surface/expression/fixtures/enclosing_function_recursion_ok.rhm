#lang rhombus/hol

// A recursive top-level function's own self-recursion (calling itself in
// tail position, outside of any local function) keeps working normally
// alongside a coexisting local/anonymous function declared in the same
// body -- as long as the recursive call is not routed *through* that
// local/anonymous function. Only a call from *inside* a local/anonymous
// function body back into the currently-being-defined enclosing function
// is rejected (see `local_calls_enclosing_bad.rhm`,
// `anon_calls_enclosing_bad.rhm`); calls to the enclosing function
// alongside a coexisting local/anonymous function, but not routed
// through it, are ordinary recursion -- verified by both theorems below
// proving outright.

export: Nat zero succ outer_beside_local outer_beside_anon

datatype Nat
| zero()
| succ(pred :: Nat)

// The coexisting function is named local sugar.
function outer_beside_local(x :: Nat) :: Nat:
  match x
  | zero(): zero()
  | succ(k):
      function double(n :: Nat) :: Nat:
        succ(succ(n))
      double(outer_beside_local(k))

theorem outer_beside_local_one:
  outer_beside_local(succ(zero())) === succ(succ(zero()))

// Same as `outer_beside_local`, but the coexisting function is a
// first-class anonymous `CoreFunctionExpr` value passed as a
// higher-order argument, not named local sugar.
function apply_twice(f :: Nat -> Nat, n :: Nat) :: Nat:
  f(f(n))

function outer_beside_anon(x :: Nat) :: Nat:
  match x
  | zero(): zero()
  | succ(k):
      apply_twice(function (n): succ(n), outer_beside_anon(k))

theorem outer_beside_anon_one:
  outer_beside_anon(succ(zero())) === succ(succ(zero()))
