#lang rhombus/hol

// `expr :: Type` ascribes an explicit expected type onto an arbitrary
// expression: it disambiguates an otherwise-ambiguous numeral or nullary
// overload, and it also constrains a polymorphic call's instantiation.

export: Nat zero succ id_generic Seq seq_nil Maybe none

datatype Nat
| zero()
| succ(pred :: Nat)

function id_generic(x :: ?a) :: ?a:
  x

theorem ascription_disambiguates_numeral:
  (0 :: Nat) === zero()

theorem ascription_constrains_polymorphic_call:
  (id_generic(zero()) :: Nat) === zero()

// A nullary overload (`empty()`, ambiguous between `Seq.of(?a)` and
// `Maybe.of(?a)` with no arguments to disambiguate by) is resolved by an
// explicit `expr :: Type` ascription, exactly like an ambiguous numeral.

datatype Seq.of(?a)
| seq_nil()
| seq_cons(first :: ?a, rest :: Seq.of(?a))

datatype Maybe.of(?a)
| none()
| some(value :: ?a)

function seq_empty() :: Seq.of(?a):
  seq_nil()

function maybe_empty() :: Maybe.of(?a):
  none()

overload empty() = seq_empty
overload empty() = maybe_empty

theorem ascribed_empty_is_seq:
  (empty() :: Seq.of(Nat)) === seq_nil()

theorem ascribed_empty_is_maybe:
  (empty() :: Maybe.of(Nat)) === none()
