#lang rhombus/hol

// `~extensionality` applies only to an equality between functions (sets
// included, since they are predicates): requesting it against an
// ordinary `Nat` equality is rejected, not silently ignored or treated
// as a no-op.

datatype Nat
| zero()
| succ(pred :: Nat)

theorem not_a_function_equality:
  zero() === zero()
proof:
  ~extensionality: [x]
