#lang rhombus/hol

// `~extensionality: x` reduces an equality goal to a pointwise goal for a
// fresh variable `x`, justified by the derived `EXT` rule (no new axiom).
// The remaining pointwise goal is then found automatically by the
// ordinary waterfall. It applies identically to ordinary functions
// (here, two syntactically different `Nat -> Nat` functions proved equal
// by induction on the pointwise goal) and to `Set` values, since a HOL
// `Set` is itself a predicate value (`?a -> Boolean`): two sets with
// different literal descriptions but the same members are equal by the
// same rule.

export: Nat zero succ double add_self

datatype Nat
| zero()
| succ(pred :: Nat)

function double(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): succ(succ(double(k)))

function add_self(n :: Nat) :: Nat:
  match n
  | zero(): zero()
  | succ(k): succ(succ(add_self(k)))

theorem funs_equal:
  double === add_self
proof:
  ~extensionality: x

theorem sets_equal:
  (Set{zero()} :: Nat -> Boolean) === Set{x :: Nat | x === zero()}
proof:
  ~extensionality: x
