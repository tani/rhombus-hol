#lang rhombus/hol

// Bracket list patterns (`[]`, `[x]`, `[x, y, & rest]`) desugar to nested
// `cons`/`nil` constructor patterns, matching how list literal
// expressions normalize, and participate in exhaustiveness/totality
// checking exactly like any other constructor pattern.

export: Nat zero succ List nil cons classify

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

function classify(xs :: List.of(Nat)) :: Nat:
  match xs
  | []: zero()
  | [x]: succ(zero())
  | [x, y, & rest]: succ(succ(zero()))

theorem classify_empty:
  classify([]) === zero()

theorem classify_one:
  classify([zero()]) === succ(zero())

theorem classify_two:
  classify([zero(), succ(zero())]) === succ(succ(zero()))
