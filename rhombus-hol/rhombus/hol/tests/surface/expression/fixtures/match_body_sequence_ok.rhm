#lang rhombus/hol

// A match clause's body is an ordinary function-body sequence, not a
// single bare expression: `let` and even a nested local `function`
// followed by a tail expression, exactly as in a top-level function's
// own body. The zero branch (no sequence) proves outright; the successor
// branch (a `let` + local function + call) reaches the correctly-
// elaborated goal proving outright.

export: Nat zero succ double_or_one

datatype Nat
| zero()
| succ(pred :: Nat)

function double_or_one(x :: Nat) :: Nat:
  match x
  | zero(): succ(zero())
  | succ(k):
      let doubled = succ(succ(k))
      function helper(n :: Nat) :: Nat:
        succ(n)
      helper(doubled)

theorem double_or_one_zero:
  double_or_one(zero()) === succ(zero())

theorem double_or_one_succ:
  double_or_one(succ(zero())) === succ(succ(succ(zero())))
