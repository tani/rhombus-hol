#lang rhombus/hol

// A string literal normalizes to `text(cons(code, cons(code, ... nil())))`
// over the declarations that provide `Nat`, `List.of(?a)`, and `String`.
// The reader decodes Unicode and control escapes before normalization, so
// equivalent character spellings produce equal constructor terms.

export: Nat zero succ List nil cons String text

datatype Nat
| zero()
| succ(pred :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

datatype String
| text(codes :: List.of(Nat))

theorem string_literal_equal:
  "hello" === "hello"

theorem string_literal_unicode_escape:
  "h\u00e9llo\u00e9" === "h\u00e9llo\u00e9"

theorem string_literal_cjk:
  "日本語" === "日本語"

theorem string_literal_control_escape:
  "a\nb\tc" === "a\nb\tc"
