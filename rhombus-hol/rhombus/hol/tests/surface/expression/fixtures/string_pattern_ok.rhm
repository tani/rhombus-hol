#lang rhombus/hol

// String literal patterns are ordinary
// `text(cons(codepoint(code), ... nil()))` constructor patterns. Each decoded
// scalar is a compact native Nat literal nested inside a `codepoint`
// constructor pattern, including non-ASCII scalars and escapes.

export:
  String text Codepoint codepoint Nat zero succ List nil cons
  is_empty_text is_a is_cjk is_escaped_e_acute
  runtime_empty runtime_a runtime_b runtime_cjk runtime_short_cjk
  runtime_escaped_e_acute runtime_plain_e

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Codepoint
| codepoint(codepoint_value :: Nat)

datatype List.of(?a)
| nil()
| cons(head :: ?a, tail :: List.of(?a))

datatype String
| text(string_codepoints :: List.of(Codepoint))

function is_empty_text(s :: String) :: Boolean:
  match s
  | "": #true
  | _: #false

function is_a(s :: String) :: Boolean:
  match s
  | "a": #true
  | _: #false

function is_cjk(s :: String) :: Boolean:
  match s
  | "日本語": #true
  | _: #false

function is_escaped_e_acute(s :: String) :: Boolean:
  match s
  | "\u00e9": #true
  | _: #false

// Executable witnesses keep the runtime lowering on the same source literals
// as the logical theorems below.
function runtime_empty() :: Boolean:
  is_empty_text("")

function runtime_a() :: Boolean:
  is_a("a")

function runtime_b() :: Boolean:
  is_a("b")

function runtime_cjk() :: Boolean:
  is_cjk("日本語")

function runtime_short_cjk() :: Boolean:
  is_cjk("日本")

function runtime_escaped_e_acute() :: Boolean:
  is_escaped_e_acute("é")

function runtime_plain_e() :: Boolean:
  is_escaped_e_acute("e")

theorem empty_is_empty:
  is_empty_text("") === #true

theorem a_is_a:
  is_a("a") === #true

theorem b_is_not_a:
  is_a("b") === #false

theorem cjk_matches:
  is_cjk("日本語") === #true

theorem other_cjk_does_not_match:
  is_cjk("日本") === #false

theorem escaped_e_acute_matches:
  is_escaped_e_acute("é") === #true

theorem plain_e_does_not_match:
  is_escaped_e_acute("e") === #false
