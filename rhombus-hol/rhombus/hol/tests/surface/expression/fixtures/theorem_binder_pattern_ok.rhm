#lang rhombus/hol

// A theorem's binder pattern-matches against a single-constructor
// datatype -- irrefutable, so allowed -- but `elaborate_theorem_statement`
// never threaded the declared datatypes through to the elaborator, so
// `single_constructor` always saw an empty datatype map and rejected every
// such pattern, real or not, as if it were refutable.

export: Nat zero succ Wrap wrap

datatype Nat
| zero()
| succ(pred :: Nat)

datatype Wrap
| wrap(value :: Nat)

theorem wrap_binder_pattern:
  forall (w :: Wrap):
    exists (wrap(n) :: Wrap): n === n
proof:
  ~choose: [wrap(zero())]
