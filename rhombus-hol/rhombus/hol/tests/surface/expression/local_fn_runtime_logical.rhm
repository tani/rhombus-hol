#lang rhombus/static

// The executable Rhombus reading of a local named function (an
// ordinary Rhombus closure computed at runtime) and its logical HOL
// term reading (the equation the theorem asserts) agree: both compute
// `outer(2) = 4`, confirming the same source declaration lowers
// consistently to both semantics -- not just independently well-typed,
// but observationally equal.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open
  lib("rhombus/hol/tests/surface/expression/fixtures/local_fn_runtime_logical_ok.rhm") as m

def load_positive = make_hol_fixture_loader()

// Runtime: the ordinary Rhombus closure actually computes 4.
check m.outer(m.succ(m.succ(m.zero()))) ~is m.succ(m.succ(m.succ(m.succ(m.zero()))))

// Logical: the same equation is stated as a theorem in the fixture and
// proves, so instantiating the module is the check.
check:
  block:
    load_positive(
      ModulePath'lib("rhombus/hol/tests/surface/expression/fixtures/local_fn_runtime_logical_ok.rhm")')
    "compiled"
  ~is "compiled"
