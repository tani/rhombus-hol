#lang rhombus/static

// A match clause's body can be an arbitrary function-body sequence (let
// bindings, nested local functions, then a tail expression), not just a
// bare single expression, exactly like a top-level function's own body.
// Both the bare-expression branch and the full-sequence branch reduce to
// their stated values, so the sequence's own `let`/local-function
// bindings demonstrably resolved.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open

def load_positive = make_hol_fixture_loader()

check:
  block:
    load_positive(
      ModulePath'lib("rhombus/hol/tests/surface/expression/fixtures/match_body_sequence_ok.rhm")')
    "compiled"
  ~is "compiled"
