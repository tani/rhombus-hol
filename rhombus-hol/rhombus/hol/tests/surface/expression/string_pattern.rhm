#lang rhombus/static

// Empty, ASCII, non-ASCII, and escaped string literal patterns compile through
// String/List/Codepoint constructors with atomic native Nat leaves.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open
  lib("rhombus/hol/tests/surface/expression/fixtures/string_pattern_ok.rhm") as s

def load_positive = make_hol_fixture_loader()

fun load(mp :: ModulePath):
  load_positive(mp)
  "compiled"

check s.runtime_empty() ~is #true
check s.runtime_a() ~is #true
check s.runtime_b() ~is #false
check s.runtime_cjk() ~is #true
check s.runtime_short_cjk() ~is #false
check s.runtime_escaped_e_acute() ~is #true
check s.runtime_plain_e() ~is #false


check:
  load(ModulePath'lib("rhombus/hol/tests/surface/expression/fixtures/string_pattern_ok.rhm")')
  ~is "compiled"
