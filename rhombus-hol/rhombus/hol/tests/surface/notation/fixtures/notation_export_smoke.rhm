#lang rhombus/hol

export:
  patterned
  only_space hol_expr:
    <+>
    <|+>

notation (left <+> right):
  ~order: hol_conjunction
  let left = neg(left)
  conj(right, left)

notation <|+> :: Boolean:
  ~order: hol_conjunction
| (#false <|+> right):
    right
| (#true <|+> _):
    #false

function patterned(left :: Boolean, right :: Boolean) :: Boolean:
  left <|+> right

function both(left :: Boolean, right :: Boolean) :: Boolean:
  left <+> right

theorem body_reorders_operands:
  both(false, true) === true

theorem nested_binding_shadows_operand:
  both(true, true) === false

theorem exported_pattern_cases:
  patterned(false, true) === true
