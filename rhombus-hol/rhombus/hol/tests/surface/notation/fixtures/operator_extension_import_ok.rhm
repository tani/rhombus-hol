#lang rhombus/hol

import: lib("rhombus/hol/tests/surface/notation/fixtures/operator_extension_ok.rhm") open

notation left <+> right:
  ~order: hol_addition
  custom_add(left, right)

notation left <++> right:
  ~order: hol_addition
  custom_add(left, right)

theorem imported_custom_provider:
  forall (a :: Tiny, b :: Tiny): a <+> b === tiny_add(a, b)
