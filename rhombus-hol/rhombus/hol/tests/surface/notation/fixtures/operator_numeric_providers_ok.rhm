#lang rhombus/hol

export:
  Integer
  int_from_nat
  int_add
  int_negate
  runtime_negative_one

import: lib("rhombus/hol/tests/surface/notation/fixtures/operator_numeral_runtime_ok.rhm") open

datatype Integer:
| int_from_nat(magnitude :: Nat)

function int_add(x :: Integer, _y :: Integer) :: Integer:
  x

function int_negate(x :: Integer) :: Integer:
  x

overload add(Integer, Integer) = int_add
overload negate(Integer) = int_negate

function runtime_negative_one() :: Integer:
  -1
