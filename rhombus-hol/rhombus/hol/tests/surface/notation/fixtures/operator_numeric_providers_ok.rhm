#lang rhombus/hol

export:
  Integer
  int_nonnegative
  int_negative
  int_add
  int_negate
  runtime_negative_one
  runtime_negated_expression

import: lib("rhombus/hol/tests/surface/notation/fixtures/operator_numeral_runtime_ok.rhm") open

datatype Integer:
| int_nonnegative(magnitude :: Nat)
| int_negative(predecessor_magnitude :: Nat)

function int_add(x :: Integer, _y :: Integer) :: Integer:
  x

// Deliberately observable: unary negation of an expression calls this
// provider, while a lexical negative literal does not.
function int_negate(x :: Integer) :: Integer:
  x

overload add(Integer, Integer) = int_add
overload negate(Integer) = int_negate

function runtime_negative_one() :: Integer:
  -1

function runtime_negated_expression(x :: Integer) :: Integer:
  -x
