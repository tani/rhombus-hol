#lang rhombus/static

// Where the logical reading of a name and its Rhombus binding could drift
// apart.
//
// A `#lang rhombus/hol` function is enforested once into a Core tree.
// `surface/elaborate.rhm` builds HOL terms from that tree, and `surface/module.rhm` lowers the
// same tree to executable Rhombus. Core references use bare `Symbol` names,
// while generated Rhombus references must still resolve to the intended
// lexical binding.
//
// This file checks the observable cases where those answers could diverge:
//
//   local shadow    the elaborator's binder environment wins, so both
//                   readings pick the local
//   module shadow   Rhombus itself refuses the module
//   alias           the elaborator refuses the declaration
//
// A rename or alias that cannot be represented consistently is rejected
// rather than giving one source two meanings.

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open
  rhombus/hol/kernel open
  rhombus/hol/surface/driver open
  lib("rhombus/hol/tests/surface/notation/fixtures/name_shadow_ok.rhm") as s
  lib("rhombus/hol/tests/surface/notation/fixtures/operator_ok.rhm") as op
  lib("rhombus/hol/tests/surface/notation/fixtures/name_shadow_ok.rhm")!hol_theory as m

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

// -- a local binding shadowing a constant --------------------------------
//
// `trap`'s body is `let twice = n; twice`, and `twice` is also a function
// constant in the same theory. The equation that got registered is about
// the local, so the logical reading agrees with what the emitted Rhombus
// computes.
def st :~ HolState = m.theory

check st.ctx.funs[#'trap].equations.length() ~is 1

// and the constant it shadowed is untouched -- the shadow is local, not a
// redefinition
check st.ctx.funs[#'twice].equations.length() ~is 2

// the two readings agree at run time as well
check s.trap(s.succ(s.zero())) ~is s.succ(s.zero())
check s.twice(s.succ(s.zero())) ~is s.succ(s.succ(s.zero()))

// -- reaching a constant through an import alias -------------------------
//
// Refused, rather than elaborated to something the runtime would not match.
check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/name_alias_bad.rhm")')
  ~throws "not a type"

// -- an operator with no logical interpretation --------------------------
//
// Without a matching `notation` declaration, the elaborator refuses a
// Rhombus operator inside a `function` instead of inventing a logical meaning
// that the emitted Rhombus would not share.
check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/operator_bad.rhm")')
  ~throws "unbound HOL expression operator"

// The same runtime operator works in ordinary Rhombus beside a logical
// definition; only its use inside `function` is restricted.
check op.g(op.zero()) ~is op.zero()
check op.dbl(op.succ(op.zero())) ~is op.succ(op.succ(op.zero()))
