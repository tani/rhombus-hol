#lang rhombus/static

import:
  lib("rhombus/hol/tests/surface/notation/fixtures/operator_runtime_ok.rhm") as runtime
  lib("rhombus/hol/tests/surface/notation/fixtures/operator_extension_ok.rhm") as custom
  lib("rhombus/hol/tests/surface/notation/fixtures/operator_numeral_runtime_ok.rhm") as nat
  lib("rhombus/hol/tests/surface/notation/fixtures/operator_numeric_providers_ok.rhm") as numeric
  lib("rhombus/hol/tests/surface/notation/fixtures/overload_function_ok.rhm") as overload

fun all_tiny(_x :: runtime.Tiny) :: Boolean:
  #true

check:
  runtime.add_one(runtime.tiny_zero())
  ~is runtime.tiny_succ(runtime.tiny_zero())

check:
  custom.custom_runtime_add(runtime.tiny_zero(),
                            runtime.tiny_succ(runtime.tiny_zero()))
  ~is runtime.tiny_succ(runtime.tiny_zero())

check:
  custom.custom_runtime_add_alias(runtime.tiny_zero(),
                                  runtime.tiny_succ(runtime.tiny_zero()))
  ~is runtime.tiny_succ(runtime.tiny_zero())

check:
  custom.custom_runtime_negate(runtime.tiny_succ(runtime.tiny_zero()))
  ~is runtime.tiny_succ(runtime.tiny_zero())

check:
  custom.custom_runtime_reversed(
    runtime.tiny_succ(runtime.tiny_zero()),
    runtime.tiny_zero())
  ~is #true

check:
  custom.custom_runtime_member(runtime.tiny_zero(), all_tiny)
  ~is #true

check:
  numeric.runtime_negative_one()
  ~is numeric.int_negative(nat.zero())

// The same spelling on a nonliteral operand is the overloadable operator.
check:
  numeric.runtime_negated_expression(
    numeric.int_nonnegative(nat.succ(nat.zero())))
  ~is numeric.int_nonnegative(nat.succ(nat.zero()))

check:
  nat.runtime_two()
  ~is nat.succ(nat.succ(nat.zero()))

check:
  nat.runtime_choose(#true)
  ~is nat.succ(nat.zero())

check:
  nat.runtime_choose(#false)
  ~is nat.succ(nat.succ(nat.zero()))

check:
  nat.runtime_equal_two(nat.succ(nat.zero()))
  ~is #true

check:
  nat.runtime_equal_two(nat.zero())
  ~is #false


check:
  nat.runtime_sum()
  ~is nat.succ(nat.succ(nat.succ(nat.zero())))

check:
  overload.mapped_empty_seq()
  ~is overload.seq_nil()

check:
  overload.mapped_some_zero()
  ~is overload.some(overload.zero())

check:
  overload.selected_left()
  ~is overload.succ(overload.zero())

check:
  overload.selected_right()
  ~is overload.succ(overload.zero())
