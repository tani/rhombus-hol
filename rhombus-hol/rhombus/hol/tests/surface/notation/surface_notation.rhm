#lang rhombus/static

import:
  lib("rhombus/hol/tests/fixture_load.rhm") open
  lib("rhombus/hol/tests/surface/notation/fixtures/notation_import.rhm") as r
  lib("rhombus/hol/tests/surface/notation/fixtures/operator_plain_smoke.rhm") as ro
  lib("rhombus/hol/tests/surface/notation/fixtures/notation_cases_smoke.rhm") as cases
  lib("rhombus/hol/tests/surface/notation/fixtures/notation_pattern_cases_ok.rhm") as patterns

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

check r.imported(#false, #true) ~is #true
check r.imported(#true, #true) ~is #false
check r.imported_pattern(#false, #true) ~is #true
check ro.runtime_only_value ~is #false
check cases.postfix_function(#true) ~is #true
check patterns.prefix_runtime(patterns.none()) ~is #true
check patterns.prefix_runtime(patterns.some(#false)) ~is #true
check patterns.infix_runtime(patterns.none(), #true) ~is #false
check patterns.infix_runtime(patterns.some(#true), #true) ~is #true
check patterns.postfix_runtime(patterns.some(#false)) ~is #true
check patterns.case_result_runtime(patterns.some(#true), #true) ~is #true
check patterns.typed_runtime(#true, #true) ~is #true
check patterns.ordered_runtime(patterns.some(#false), #true) ~is #false
check patterns.ordered_runtime(patterns.none(), #true) ~is #true

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_smoke.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/surface_props.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_options_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_pattern_cases_ok.rhm")')
  ~completes

// HOL notation can be compiled in a logical function when its implementation
// expression has an executable meaning.
check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_function_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_runtime_bad.rhm")')
  ~throws "<&>: unbound expression operator"

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/operator_plain_logic_bad.rhm")')
  ~throws "<*>: unbound"

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_empty_bad.rhm")')
  ~throws "a notation case needs a HOL body"

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_duplicate_operand_bad.rhm")')
  ~throws "notation operand names must be distinct"


check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_implementation_bad.rhm")')
  ~throws "precedence options must precede a notation implementation"

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_pattern_partial_bad.rhm")')
  ~throws "not exhaustive"

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_pattern_unreachable_bad.rhm")')
  ~throws "this clause can never match"

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_infix_postfix_bad.rhm")')
  ~throws "infix and postfix"


check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_result_type_bad.rhm")')
  ~throws "expression has an unexpected type"
check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_unsafe_bad.rhm")')
  ~throws "`~unsafe` is not supported"

check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_late_case_option_bad.rhm")')
  ~throws "allowed only on the first infix case"


check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/notation_static_result_bad.rhm")')
  ~throws "`:~` is not supported"
check:
  load(ModulePath'lib("rhombus/hol/tests/surface/notation/fixtures/operator_bad.rhm")')
  ~throws "unbound HOL expression operator"
