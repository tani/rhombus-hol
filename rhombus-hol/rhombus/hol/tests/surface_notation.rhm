#lang rhombus/static

import:
  "fixtures/notation_import.rhm" as r
  "fixtures/operator_plain_smoke.rhm" as ro
  "fixtures/notation_cases_smoke.rhm" as cases

fun load(mp :: ModulePath):
  let e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }: Evaluator.instantiate(mp)

check r.imported(#true, #true) ~is #true
check r.imported(#true, #false) ~is #false
check ro.runtime_only_value ~is #false
check cases.postfix_function(#true) ~is #true

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_smoke.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/surface_props.rhm")')
  ~completes

// HOL notation can be compiled in a logical function when its target function
// has an executable meaning.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_function_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_runtime_bad.rhm")')
  ~throws "<&>: unbound expression operator"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_plain_logic_bad.rhm")')
  ~throws "<*>: unbound"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_empty_bad.rhm")')
  ~throws "a notation case needs a final function implementation"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_implementation_bad.rhm")')
  ~throws "a notation implementation must be final"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_bad.rhm")')
  ~throws "unexpected text after an expression"
