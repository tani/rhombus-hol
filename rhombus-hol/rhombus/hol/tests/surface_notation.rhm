#lang rhombus/static

import:
  "fixtures/notation_import.rhm" as r
  "fixtures/notation_runtime_smoke.rhm" as ro

fun load(mp :: ModulePath):
  let e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }: Evaluator.instantiate(mp)

check r.runtime_value ~is #false
check r.imported(#true, #true) ~is #true
check r.imported(#true, #false) ~is #false
check ro.runtime_only_value ~is #false

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_logic_smoke.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/surface_props.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_logic_function_bad.rhm")')
  ~throws "logic-only notation cannot appear in a function body"
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_logic_function_bad.rhm")')
  ~throws "notation_logic_function_bad.rhm:7"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_logic_runtime_bad.rhm")')
  ~throws "<&>: unbound expression operator"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_runtime_logic_bad.rhm")')
  ~throws "<*>: unbound"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/notation_empty_bad.rhm")')
  ~throws "`notation` requires at least one of `~logic` or `~runtime`"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_bad.rhm")')
  ~throws "unexpected text after an expression"
