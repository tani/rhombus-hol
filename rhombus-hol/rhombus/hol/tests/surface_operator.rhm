#lang rhombus/static

import:
  "fixtures/operator_import.rhm" as r
  "fixtures/operator_plain_smoke.rhm" as ro
  "fixtures/operator_cases_smoke.rhm" as cases

fun load(mp :: ModulePath):
  let e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }: Evaluator.instantiate(mp)

check r.runtime_value ~is #false
check r.imported(#true, #true) ~is #true
check r.imported(#true, #false) ~is #false
check ro.runtime_only_value ~is #false
check cases.postfix_runtime ~is #true

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_logic_smoke.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/surface_props.rhm")')
  ~completes

// A HOL-space operator can be compiled in a logical function when its target
// function has an executable meaning.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_logic_function_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_logic_runtime_bad.rhm")')
  ~throws "<&>: unbound expression operator"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_plain_logic_bad.rhm")')
  ~throws "<*>: unbound"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_logic_empty_bad.rhm")')
  ~throws "an operator case needs a final function implementation"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_logic_implementation_bad.rhm")')
  ~throws "an operator implementation must be final"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_bad.rhm")')
  ~throws "unexpected text after an expression"
