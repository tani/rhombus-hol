#lang rhombus/static

import:
  "fixtures/reflected_operator_import.rhm" as r

fun load(mp :: ModulePath):
  let e = Evaluator.make_rhombus()
  parameterize { Evaluator.current: e }: Evaluator.instantiate(mp)

check r.runtime_value ~is #false
check r.imported(#true, #true) ~is #true
check r.imported(#true, #false) ~is #false

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/logical_operator_smoke.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/surface_props.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/logical_operator_function_bad.rhm")')
  ~throws "logical-only operator cannot appear in a function body"
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/logical_operator_function_bad.rhm")')
  ~throws "logical_operator_function_bad.rhm:7"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/logical_operator_runtime_bad.rhm")')
  ~throws "<&>: unbound expression operator"

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/operator_bad.rhm")')
  ~throws "unexpected text after an expression"
