#lang rhombus/static

// The derived cleanup rules: propositional simplification, and the two
// conditional rules that make `if` usable by the rewriter.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/bool open
  rhombus/hol/taut open

def thy = base_theory()

fun stmts(ths :: List.of(Thm)) :: List.of(String):
  ths.map(fun (t :: Thm): show(concl_of(t)))

// -- nothing here is assumed -------------------------------------------------
//
// These are derived rules, so a hypothesis sneaking in would be invisible in
// the statement but fatal to the trust argument.  The base theory's axiom
// count is checked alongside, since deriving these must not have needed a new
// one: ETA, SELECT and BOOL_CASES are the whole assumed basis.

check axioms_of(thy).length() ~is 3
check:
  for all (t in tautologies(thy) ++ conditionals(thy)): hyps_of(t) == []
  ~is #true

// -- the conditional ---------------------------------------------------------

check show(concl_of(NOT_TRUE_EQ_FALSE(thy))) ~is "not (true <=> false)"

check:
  stmts(conditionals(thy))
  ~is ["forall (x :: 'a, y :: 'a): (if true | x | y) === x",
       "forall (x :: 'a, y :: 'a): (if false | x | y) === y"]

// -- the propositional set is complete for both literals in both positions ---

check tautologies(thy).length() ~is 13
