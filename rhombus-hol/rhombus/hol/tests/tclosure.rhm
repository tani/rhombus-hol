#lang rhombus/static

// The transitive closure, and the subterm relation derived from it
// (PLAN.md section 9.29).
//
// A datatype's subterm relation used to arrive as a clausal definition whose
// two equations per datatype were postulated -- the last `new_axiom` on the
// `type` declaration path.  It is now `TC child`, with `child` a
// non-recursive predicate over the discriminators and selectors, and the
// equations are proved.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/bool open
  rhombus/hol/datatype open
  rhombus/hol/infinity open
  rhombus/hol/datatype_rec open
  rhombus/hol/tclosure open
  rhombus/hol/subterm open

def tcb :~ TCThms = tc_base_thms()

// -- the closure costs nothing -----------------------------------------------
//
// It is a definition, so the induction principle is a specialisation rather
// than something to assume.  If any of these grew a hypothesis or an axiom,
// the derivations below would be resting on it.

// three: the base logic's, and not infinity -- the closure sits below it
check axioms_of(tc_base_theory()).length() ~is 3

check:
  [show(concl_of(tcb.inc)), hyps_of(tcb.inc)]
  ~is ["forall (x :: 'a -> 'a -> bool, y :: 'a, z :: 'a): x(y, z) ==> TC(x, y, z)",
       []]

check:
  [show(concl_of(tcb.trans)), hyps_of(tcb.trans)]
  ~is ["forall (x :: 'a -> 'a -> bool, y :: 'a, z :: 'a, u :: 'a): "
         ++ "TC(x, y, z) and TC(x, z, u) ==> TC(x, y, u)",
       []]

// The one that does the work: a chain has a last step, and that is what turns
// `TC child x (C a1 ... ak)` into a statement about the children of `C`.
check:
  [show(concl_of(tcb.unfold)), hyps_of(tcb.unfold)]
  ~is ["forall (x :: 'a -> 'a -> bool, y :: 'a, z :: 'a): "
         ++ "TC(x, y, z) ==> exists (u :: 'a): x(u, z) and (y === u or TC(x, y, u))",
       []]

// -- and neither does a datatype's subterm relation --------------------------

def thy0 = infinity_base_theory()
def ind :~ IndThms = infinity_base_ind()
def tv = mk_tyvar(#'a)

fun derive(spec :: DatatypeSpec) :~ List:
  let (thy, dt0) = build_recursive_datatype_thms(thy0, spec, ind)
  let dt :~ DatatypeThms = dt0
  let (thy2, eqs) = derive_subterm_relation(thy, spec, dt)
  let wf = prove_wf_t_lt(thy2, spec, eqs, dt.induction)
  [axioms_of(thy2).length() - axioms_of(thy).length(),
   eqs.map(fun (t :: Thm): show(concl_of(t))),
   for values(hs :~ List = []) (t in eqs): hs ++ hyps_of(t :~ Thm),
   show(concl_of(wf)), hyps_of(wf)]

def lst = DatatypeSpec(#'MyList, [#'a],
                       [Ctor(#'MyNil, []),
                        Ctor(#'MyCons, [Field(#'hd, tv),
                                        Field(#'tl, mk_tyapp(#'MyList, [tv]))])])

// One recursive field: the equations are the ones `subterm_clause` describes.
check:
  derive(lst)
  ~is [0,
       ["forall (x :: MyList('a)): MyList_lt(x, MyNil) <=> false",
        "forall (x :: MyList('a), y :: 'a, z :: MyList('a)): "
          ++ "MyList_lt(x, MyCons(y, z)) <=> x === z or MyList_lt(x, z)"],
       [],
       "wf(MyList_lt)", []]

// Two recursive fields in one constructor, and a constructor with none: the
// disjunction has to cover every child and no others.
check:
  derive(DatatypeSpec(#'MyTree, [#'a],
                      [Ctor(#'MyLeaf, [Field(#'v, tv)]),
                       Ctor(#'MyNode,
                            [Field(#'l, mk_tyapp(#'MyTree, [tv])),
                             Field(#'r, mk_tyapp(#'MyTree, [tv]))])]))
  ~is [0,
       ["forall (x :: MyTree('a), y :: 'a): MyTree_lt(x, MyLeaf(y)) <=> false",
        "forall (x :: MyTree('a), y :: MyTree('a), z :: MyTree('a)): "
          ++ "MyTree_lt(x, MyNode(y, z)) <=> "
          ++ "x === y or (MyTree_lt(x, y) or (x === z or MyTree_lt(x, z)))"],
       [],
       "wf(MyTree_lt)", []]
