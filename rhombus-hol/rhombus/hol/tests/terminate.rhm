#lang rhombus/static

// The lexicographic search, on its own.
//
// Driving it through `install_function` only ever shows whether a definition
// was accepted; this shows which order was found, which is what the prover
// later reads to pick an induction variable.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/bool open
  rhombus/hol/terminate open

def nat = mk_tyapp(#'Nat, [])
def zero = mk_const(#'zero, nat)
def succ_c = mk_const(#'succ, mk_fun(nat, nat))
fun succ(t :: Term) :: Term: mk_comb(succ_c, t)

def m = mk_var(#'m, nat)
def n = mk_var(#'n, nat)
def p = mk_var(#'p, nat)
def q = mk_var(#'q, nat)

def f = mk_const(#'f, mk_fun(nat, mk_fun(nat, nat)))

// `[patterns, terms]` pairs, as `install_function` passes them: `terms` is
// every term the clause evaluates (`core.rhm`), which for a body with no
// `let` is the one term the equation states.  These tests write the body and
// this wraps it.
fun info(clauses :: List) :: RecursionInfo:
  check_termination(#'test, #'f, 2,
                    clauses.map(fun ([pats, rhs]): [pats, [rhs]]),
                    f)

fun call(args :: List.of(Term)) :: Term: list_mk_comb(f, args)

// -- a single descending argument ---------------------------------------------

check:
  info([[[succ(p), n], call([p, n])]])
  ~matches RecursionInfo([0], #'structural, _, [])

// A column that descends at every site is reported even when the first one
// already settles every call, because the prover uses it as a hint.

check:
  info([[[succ(p), succ(q)], call([p, q])]])
  ~matches RecursionInfo([0, 1], #'structural, _, [])

// -- neither argument descends everywhere -------------------------------------
//
// The Ackermann shape: one call shrinks `m`, another holds `m` and shrinks
// `n`.  Order [0, 1] works; no single column does.

check:
  info([[[succ(p), zero], call([p, succ(zero)])],
        [[succ(p), succ(q)], call([succ(p), q])]])
  ~matches RecursionInfo([0, 1], #'structural, _, [])

// Order matters: with the roles swapped the search has to pick column 1
// first.

check:
  info([[[zero, succ(q)], call([succ(zero), q])],
        [[succ(p), succ(q)], call([p, succ(q)])]])
  ~matches RecursionInfo([1, 0], #'structural, _, [])

// One call holding a column while the other shrinks it is fine -- that is
// what lexicographic order is for.  Here `m` is held and `n` shrinks, then
// `m` shrinks; order [0, 1] settles both.

check:
  info([[[succ(p), succ(q)], call([succ(p), q])],
        [[succ(p), succ(q)], call([p, succ(q)])]])
  ~matches RecursionInfo([0, 1], #'structural, _, [])

// -- no order at all ----------------------------------------------------------
//
// Each call *grows* the column the other shrinks, so whichever is tried
// first, some call increases it.  No lexicographic order exists and none is
// invented.

check:
  info([[[succ(p), succ(q)], call([succ(succ(p)), q])],
        [[succ(p), succ(q)], call([p, succ(succ(q))])]])
  ~throws "cannot see that the definition terminates"

// -- not recursive at all -----------------------------------------------------

check info([[[m, n], zero]]) ~matches RecursionInfo([], #'none, [], [])

// -- a measure retains the actual discharge proof, one per call site --------
//
// `check_measure` used to only check success/failure of `discharge` and
// throw the proof away; `RecursionInfo.decrease_proofs` now keeps it, since
// a `WFREC`-based derivation needs the real theorem for its congruence
// obligation, not just a yes/no verdict.

def thy_m = new_constant(new_constant(new_constant(new_type(base_theory(), #'Nat, 0), #'zero, nat), #'succ, mk_fun(nat, nat)), #'Nat_lt, mk_fun(nat, mk_fun(nat, bool)))

// A discharge callback that actually proves the obligation it is handed
// (via `ASSUME`, standing in for the waterfall) and hands the real `Thm`
// back, so the test can check its shape rather than just that it exists.
fun fake_discharge(obligation :: Term) :: values(maybe(Thm), maybe(String)):
  values(ASSUME(thy_m, obligation), #false)

def measure_id = mk_abs(m, mk_abs(n, m))
def measure_spec = Measure(measure_id, fake_discharge)

check:
  let ri = check_termination(#'test, #'f, 2, [[[succ(p), n], [call([m, n])]]], f, ~measure: measure_spec)
  let ri :~ RecursionInfo = ri
  [ri.method, ri.decrease_proofs.length()]
  ~is [#'measure, 1]

check:
  let ri = check_termination(#'test, #'f, 2, [[[succ(p), n], [call([m, n])]]], f, ~measure: measure_spec)
  let ri :~ RecursionInfo = ri
  // The retained proof's conclusion is exactly the obligation this call
  // site was asked to discharge: `Nat_lt(measure(m,n), measure(succ(p),n))`,
  // universally closed over the clause's free variables.
  show(concl_of(ri.decrease_proofs[0]))
  ~is "forall (x :: Nat, y :: Nat): Nat_lt(x, succ(y))"

// Structural descent still needs no proof at all -- it is a syntactic fact,
// not a kernel theorem -- and a measure that fails discharges nothing.

check:
  info([[[succ(p), n], call([p, n])]])
  ~matches RecursionInfo(_, #'structural, _, [])

fun always_fails(obligation :: Term) :: values(maybe(Thm), maybe(String)):
  values(#false, "no proof")

check:
  check_termination(#'test, #'f, 2, [[[succ(p), n], [call([m, n])]]], f, ~measure: Measure(measure_id, always_fails))
  ~throws "cannot see that the measure decreases"
