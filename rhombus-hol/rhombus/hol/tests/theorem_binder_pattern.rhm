#lang rhombus/static

// `elaborate_theorem_statement` never threaded a theory's declared
// datatypes through to the elaborator (unlike `elaborate_function_decl`),
// so `single_constructor` always saw an empty datatype map inside a
// theorem: every constructor-pattern binder was rejected as refutable,
// correct single-constructor ones included.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/theorem_binder_pattern_ok.rhm")')
  ~completes

check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/theorem_binder_pattern_bad.rhm")')
  ~throws "a binder accepts only irrefutable patterns"
