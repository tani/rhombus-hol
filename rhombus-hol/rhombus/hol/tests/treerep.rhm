#lang rhombus/static

// The representation recursive datatypes get carved out of, and the one fact
// the carving rests on.
//
// A tree is indexed by paths -- `num -> num` digit sequences, `0` ending the
// path and `d > 0` descending into child `d - 1` -- so that descending needs
// only `pre_num(suc n) = n` and `suc n /= 0`. What has to be true for any of
// the rest to work is that building a node is injective in both its label
// and its children; if it were not, two different values would have the same
// representation and the carved type would collapse.

import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/kernel open
  rhombus/hol/printer open
  rhombus/hol/bool open
  rhombus/hol/algebra open
  rhombus/hol/infinity open
  rhombus/hol/conv open
  rhombus/hol/drule open
  rhombus/hol/treerep open

def base = algebra_base_theory()
def (thy, ind) = build_ind(base)
def alg :~ AlgebraThms = algebra_base_thms()

def lty :: HType = mk_tyvar(#'l)
def uty = mk_tyapp(#'unit, [])
def oty = sum_ty(lty, uty)
def inl = mk_const(#'inl, mk_fun(lty, oty))
def inl_inj = INST_TYPE(thy, {#'a: lty, #'b: uty}, (alg.sum :~ SumThms).inl_inj)

def node_inj = prove_node_injective(thy, ind, inl :~ Term, inl_inj)

// -- the shapes are what the encoding says -----------------------------------
check type_to_string(path_ty()) ~is "num -> num"
check type_to_string(rep_ty(oty)) ~is "(num -> num) -> sum(?l, unit)"

// -- injective in both arguments, with nothing assumed -----------------------
//
// Stated as an equivalence: the converse is congruence, and having both means
// the carving can rewrite in either direction.
check hyps_of(node_inj) ~is []
check:
  show(concl_of(node_inj))
  ~is "forall (x :: ?l, y :: num -> (num -> num) -> sum(?l, unit), z :: ?l, u :: num -> (num -> num) -> sum(?l, unit)): (fun (v :: num -> num): if v(zero_num) === zero_num | inl(x) | y(pre_num(v(zero_num)), fun (w :: num): v(suc_num(w)))) === (fun (v :: num -> num): if v(zero_num) === zero_num | inl(z) | u(pre_num(v(zero_num)), fun (w :: num): v(suc_num(w)))) <=> x === z and y === u"

// -- and it costs nothing beyond the one axiom for infinity ------------------
//
// The encoding uses no arithmetic and no pairing function, so the theory it
// is proved in is the one `build_ind` produced and nothing more.
check axioms_of(thy).length() - axioms_of(base).length() ~is 1

// -- packing a constructor's children ----------------------------------------
//
// `node` takes children as a function, but a constructor has a fixed finite
// number of them, so they are packed into one with junk past the arity.
// Nothing ever reads the junk slots, and injectivity only claims the slots
// that are read -- which is the whole reason the arity bound never has to
// appear in the encoding.
def rty = rep_ty(oty)
def junk = mk_var(#'bot, rty)
def ts = [mk_var(#'t0, rty) :~ Term, mk_var(#'t1, rty), mk_var(#'t2, rty)]
def us = [mk_var(#'u0, rty) :~ Term, mk_var(#'u1, rty), mk_var(#'u2, rty)]

check show(num_lit(2)) ~is "suc_num(suc_num(zero_num))"

// index literals are decidably distinct, which is what selects a slot
check:
  show(concl_of(prove_lit_distinct(thy, ind, 0, 2)))
  ~is "zero_num === suc_num(suc_num(zero_num)) <=> false"
check:
  show(concl_of(prove_lit_distinct(thy, ind, 2, 1)))
  ~is "suc_num(suc_num(zero_num)) === suc_num(zero_num) <=> false"

// every used slot is recovered, and none of it is conditional
check:
  for List (m in [0, 1, 2]):
    let th = prove_kids_injective(thy, ind, junk :~ Term, ts, us, m)
    let concl = (match dest_imp(concl_of(th)) | [_, c]: c | ~else: concl_of(th))
    [hyps_of(th).length(), show(concl)]
  ~is [[0, "t0 === u0"], [0, "t1 === u1"], [0, "t2 === u2"]]

// -- carving a genuinely self-recursive datatype -----------------------------
//
// The whole point, on the smallest shape that is actually recursive: a list,
// `Nil` with no fields and no children and `Cons` with one field and one
// child.  Its representation is the least set of trees closed under those
// two, and `new_basic_type_definition` cuts the type out of that set.
//
// Recursive datatypes in a module still postulate -- the general construction
// on top of this is not written -- but the type below is carved, not
// assumed, and it costs no axiom.
def a_ty :: HType = mk_tyvar(#'a)
def lab_ty = sum_ty(uty, a_ty)               // which constructor, and its fields
def opt_ty = sum_ty(lab_ty, uty)             // a node, or nothing here
def tree_ty = rep_ty(opt_ty)
def node_inl = mk_const(#'inl, mk_fun(lab_ty, opt_ty))
def ctors = [CtorRep(mk_const(#'inl, mk_fun(uty, lab_ty)), 0),
             CtorRep(mk_const(#'inr, mk_fun(a_ty, lab_ty)), 1)]

// the junk that fills unused child slots: the empty tree, which is a real
// term but never a value of the datatype
def (bthy, def_bot):
  new_basic_definition(thy,
                       mk_eq(mk_var(#'BOT, tree_ty),
                             mk_abs(mk_var(#'p, path_ty()),
                                    mk_comb(mk_const(#'inr, mk_fun(uty, opt_ty)),
                                            mk_const(#'one, uty)))))
def bot = mk_const(#'BOT, tree_ty)

def (rthy, def_rep):
  new_basic_definition(bthy,
                       mk_eq(mk_var(#'LREP, mk_fun(tree_ty, bool)),
                             mk_rep_pred(node_inl :~ Term, bot, ctors)))
def lrep = mk_const(#'LREP, mk_fun(tree_ty, bool))
fun lrep_at(t :: Term) :: Thm: unfold_def(rthy, def_rep, [t])

fun closed(i :: Int) :: Thm:
  prove_rep_closed(rthy, node_inl :~ Term, bot, ctors, lrep, lrep_at, i)

// closed under both constructors, unconditionally
check hyps_of(closed(0)) ~is []
check hyps_of(closed(1)) ~is []

// `Nil`'s clause has no premise; `Cons`'s says: if the tail is in the set,
// so is the node built from it.  That second one is what "self-recursive"
// means here.
check is_forall(concl_of(closed(0))) ~is #true
check:
  match dest_forall(concl_of(closed(1)))
  | [_, b]: (match dest_forall(b) | [_, b2]: is_imp(b2) | ~else: #false)
  | ~else: #false
  ~is #true

// -- and the type comes out of it --------------------------------------------
def witness = SPEC(rthy, mk_const(#'one, uty), closed(0))
def (lthy, abs_rep, rep_pred):
  new_basic_type_definition(rthy, #'Lst, #'abs_Lst, #'rep_Lst, witness)

check type_arity(lthy, #'Lst) ~is 1
check show(concl_of(abs_rep)) ~is "abs_Lst(rep_Lst(a)) === a"
check show(concl_of(rep_pred)) ~is "LREP(r) <=> rep_Lst(abs_Lst(r)) === r"
check hyps_of(abs_rep) ~is []
check hyps_of(rep_pred) ~is []

// zero axioms for the datatype: the only one in the theory is infinity's
check axioms_of(lthy).length() - axioms_of(base).length() ~is 1

// -- the datatype's own constructors -----------------------------------------
//
// `Cons(h, t) = abs(node(inr h, kids [rep t]))`, and its injectivity derived
// rather than postulated -- which is the first of the four theorems a `type`
// declaration currently assumes about a self-recursive datatype.
def cv = Carved(mk_tyapp(#'Lst, [a_ty]),
                mk_const(#'abs_Lst, mk_fun(tree_ty, mk_tyapp(#'Lst, [a_ty]))),
                mk_const(#'rep_Lst, mk_fun(mk_tyapp(#'Lst, [a_ty]), tree_ty)),
                lrep, abs_rep, rep_pred)

def sum_thms :~ SumThms = alg.sum
def node_inj_l:
  prove_node_injective(lthy, ind, node_inl :~ Term,
                       INST_TYPE(lthy, {#'a: lab_ty, #'b: uty},
                                 sum_thms.inl_inj))
def cons_inj:
  prove_ctor_injective(lthy, node_inl :~ Term, bot, ctors, cv,
                       prove_rep_closed(lthy, node_inl :~ Term, bot, ctors,
                                        lrep, lrep_at, 1),
                       node_inj_l,
                       INST_TYPE(lthy, {#'a: uty, #'b: a_ty},
                                 sum_thms.inr_inj),
                       fun (ts :: List, us :: List, k :: Int):
                         prove_kids_injective(lthy, ind, bot, ts, us, k),
                       1)

// every value of the type came out of the set it was carved from
check hyps_of(prove_rep_in_set(lthy, cv, mk_var(#'z, cv.ty) :~ Term)) ~is []
check:
  show(concl_of(prove_rep_in_set(lthy, cv, mk_var(#'z, cv.ty) :~ Term)))
  ~is "LREP(rep_Lst(z))"

// `Cons` is injective in its field and in its tail, with nothing assumed
check hyps_of(cons_inj) ~is []
check:
  let (_, body) = strip_forall(concl_of(cons_inj))
  match dest_imp(body)
  | [_, c]: show(c)
  | ~else: "?"
  ~is "x === z and y === u"

// -- and distinctness --------------------------------------------------------
//
// The second of the four.  If `Nil` and a `Cons` were equal then, both being
// in the carved set, their trees would be, and `node`'s injectivity would
// equate their labels -- which the tag sum forbids.
def nil_cons_distinct:
  prove_ctor_distinct(lthy, node_inl :~ Term, bot, ctors, cv,
                      prove_rep_closed(lthy, node_inl :~ Term, bot, ctors,
                                       lrep, lrep_at, 0),
                      prove_rep_closed(lthy, node_inl :~ Term, bot, ctors,
                                       lrep, lrep_at, 1),
                      node_inj_l,
                      INST_TYPE(lthy, {#'a: uty, #'b: a_ty},
                                sum_thms.distinct),
                      0, 1)

check hyps_of(nil_cons_distinct) ~is []
check:
  let (vs, body) = strip_forall(concl_of(nil_cons_distinct))
  [vs.length(), is_neg(body)]
  ~is [3, #true]

// -- and induction -----------------------------------------------------------
//
// The third, and the one the carving was set up for: `REP` was defined as the
// *least* set closed under the constructors, and this is that minimality read
// through the bijection.
// `LREP`'s defining equation re-read in the theory that has `Lst`: the one
// above was closed over the theory before the type existed.
fun lrep_at_l(t :: Term) :: Thm: unfold_def(lthy, def_rep, [t])
def closed_l0 = prove_rep_closed(lthy, node_inl :~ Term, bot, ctors,
                                 lrep, lrep_at_l, 0)
def closed_l1 = prove_rep_closed(lthy, node_inl :~ Term, bot, ctors,
                                 lrep, lrep_at_l, 1)
def lst_induction:
  prove_datatype_induction(lthy, node_inl :~ Term, bot, ctors, cv,
                           [closed_l0, closed_l1], node_inj_l, lrep_at_l)

check hyps_of(lst_induction) ~is []
// exactly the induction principle for a list: one case per constructor, the
// `Cons` case with the tail's hypothesis
check:
  let (vs, body) = strip_forall(concl_of(lst_induction))
  match dest_imp(body)
  | [prem, _]:
      match dest_conj(prem)
      | [nil_case, cons_case]:
          [vs.length(), is_forall(nil_case),
           (match strip_forall(cons_case) | (bvs, b): [bvs.length(), is_imp(b)])]
      | ~else: #false
  | ~else: #false
  ~is [1, #true, [2, #true]]

// -- and cases ---------------------------------------------------------------
//
// The fourth.  From induction, taking the predicate to be the disjunction
// itself: each constructor discharges its own disjunct with the arguments in
// hand, so the case hypotheses go unused -- exhaustiveness does not depend on
// anything holding of the children.
def lst_cases:
  prove_datatype_cases(lthy, node_inl :~ Term, bot, ctors, cv, lst_induction)

check hyps_of(lst_cases) ~is []
check:
  let (vs, body) = strip_forall(concl_of(lst_cases))
  match dest_disj(body)
  | [d0, d1]: [vs.length(), is_exists(d0), is_exists(d1)]
  | ~else: #false
  ~is [1, #true, #true]

// -- the ledger --------------------------------------------------------------
//
// All four of the theorems a self-recursive `type` declaration currently
// postulates, derived for a carved list, with no hypotheses anywhere -- and
// the theory's only axiom is still infinity's.
check:
  [cons_inj, nil_cons_distinct, lst_induction, lst_cases]
    .map(fun (t :: Thm): hyps_of(t).length())
  ~is [0, 0, 0, 0]
check axioms_of(lthy).length() - axioms_of(base).length() ~is 1
