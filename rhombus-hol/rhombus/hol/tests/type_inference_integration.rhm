#lang rhombus/static

// Bidirectional expected-type propagation threads an outer function's
// declared parameter type through arbitrarily nested literal
// constructors with zero explicit annotations, generating and resolving
// fresh type metavariables along the way; overload resolution
// participates in the same inference, selecting by an argument's
// *inferred* type rather than requiring it be syntactically apparent.

import:
  "fixture_load.rhm" open

fun load(mp :: ModulePath):
  instantiate_hol_fixture(mp)
  "compiled"

fun stuck_message(mp :: ModulePath) :: String:
  try:
    block:
      instantiate_hol_fixture(mp)
      "fixture compiled"
    ~catch e :: Exn.Fail: e.message

// Deep propagation: everything the literals contribute reduces away,
// leaving only a stdlib `Pair` accessor with no rewrite rule -- a
// separate, pre-existing gap. The residual names the fully elaborated
// literal at the propagated element type, which is the evidence here.
check:
  stuck_message(
    ModulePath'lib("rhombus/hol/tests/fixtures/bidirectional_propagation_stuck.rhm")')
    .contains("fst(pair(cons(zero, cons(succ(zero), nil)), zero))")
  ~is #true

// Overload selected by inferred type: the fixture's theorem proves,
// which is possible only with the correct branch chosen.
check:
  load(ModulePath'lib("rhombus/hol/tests/fixtures/overload_inference_ok.rhm")')
  ~is "compiled"
