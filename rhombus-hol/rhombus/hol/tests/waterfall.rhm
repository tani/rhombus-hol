#lang rhombus/static

// The waterfall driver itself: `prove`/`prove_goal` against a hand-built
// `Context`, below the surface `#lang rhombus/hol` syntax. Case splitting is
// tested here rather than through a `#lang rhombus/hol` fixture because a
// genuine witness needs a Boolean-valued constant whose truth value the
// ordinary stages (destructor elimination, induction) cannot resolve by
// themselves. In the user language this is written with the `cases`
// directive; a fixture could instead grow defining equations that eventually
// reveal its value, which would let the proof go through some other way and
// prove nothing about case splitting specifically.
import:
  rhombus/hol/htype open
  rhombus/hol/term open
  rhombus/hol/names open
  rhombus/hol/kernel open
  rhombus/hol/logic/bool open
  rhombus/hol/logic/drule open
  rhombus/hol/prover/waterfall open
  rhombus/hol/frontend/driver open
  rhombus/hol/prover/goal open
  rhombus/hol/prover/proof/executor open
  rhombus/hol/prover/trace open
  rhombus/hol/prover/proof/run open

def st0 = initial_state()
def nat = mk_tyapp(#'Nat, [])
def thy1 = new_constant(st0.ctx.thy, #'p, mk_fun(nat, bool))
def thy = new_constant(thy1, #'k, nat)
def ctx = context_with_theory(st0.ctx, thy)

def n = mk_var(#'n, nat)
def px = mk_comb(mk_const(#'p, mk_fun(nat, bool)), n)
def kk = mk_const(#'k, nat)
// Stage selection remains policy-only: the ordinary waterfall closes a
// reflexive goal, omitting simplification leaves it open, and skipping
// unrelated stages does not change the result.
def reflexive_goal = mk_goal([], mk_eq(kk, kk))
check is_closed(prove_goal(ctx, reflexive_goal)) ~is #true
check:
  is_closed(prove_goal(ctx, reflexive_goal,
                       ~skipped_stages: Set(#'simplify)))
  ~is #false
check:
  is_closed(prove_goal(ctx, reflexive_goal,
                       ~skipped_stages: Set(#'eliminate, #'fertilize)))
  ~is #true
check:
  prove_goal(ctx, reflexive_goal,
             ~skipped_stages: Set(#'not_a_stage))
  ~throws "no such waterfall stage to skip"

// A proof-local rule scope is derived from, never written back to, durable
// module state.
check:
  let (_proved, _node) = prove(
                            ctx, mk_eq(kk, kk),
                            ~scope: RuleScope([], [#'propositional]))
  ctx.db.disabled
  ~is Set()


// Executor choice is installed at the public orchestration boundary. An
// executor can decline execution without changing the closed proof tree.
check:
  let refusing = ProofExecutor(fun (_ :: ProofNode): #false)
  let (result, node) = prove(ctx, mk_eq(kk, kk), ~executor: refusing)
  [result, is_closed(node)]
  ~is [#false, #true]
check:
  let left = mk_goal([], mk_eq(kk, kk))
  let right = mk_goal([], px)
  let left_event = CaseSplit(px, #true)
  let right_event = CaseSplit(px, #false)
  let node = Derived(
               Step([left, right], fun (_): REFL(thy, kk),
                    [left_event, right_event]),
               [Open(Residue(left, [left_event])),
                Open(Residue(right, [right_event]))])
  collect_residues(node).map(
    fun (residue :: Residue): residue.goal.concl)
  ~is [mk_eq(kk, kk), px]

// `if p(n) | k | k === k`: both branches of the conditional are identical,
// but nothing simplifies `if p(n) | k | k` without first knowing whether
// `p(n)` is true or false -- `cond_rule` only fires on the literal
// constants, and `p` is an uninterpreted constant with no equations to
// destructure `n` against. Left to the ordinary waterfall, this is stuck.
def goal_stmt = mk_eq(mk_cond(px, kk, kk), kk)

check:
  let (th, _) = prove(ctx, goal_stmt, ~names: [#'n])
  th
  ~is #false

// A `cases [p(n)]` directive splits into a branch where `p(n)` holds and one
// where it does not; in each, the hypothesis orients into a rewrite rule for
// `p(n)` (see `simp.rhm`'s `with_assumptions`), and `cond_rule` discharges the
// conditional. The resulting theorem still concludes the original statement.
check:
  let (th, _) = prove(ctx, goal_stmt, ~names: [#'n], ~cases: [px])
  match th
  | #false: #false
  | proved :~ Thm: [hyps_of(proved), concl_of(proved)]
  ~is [[], goal_stmt]

// A case term irrelevant to the goal still lets a proof that did not need
// it go through -- case splitting only ever adds hypotheses, never removes the
// goal's own provability by some other route.
check:
  let unrelated = mk_comb(mk_const(#'p, mk_fun(nat, bool)), kk)
  let (th, _) = prove(ctx, mk_eq(kk, kk), ~cases: [unrelated])
  match th
  | #false: #false
  | proved :~ Thm: hyps_of(proved)
  ~is []
