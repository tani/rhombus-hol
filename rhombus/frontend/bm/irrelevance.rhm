#lang rhombus
// Extended Boyer-Moore prover: started from tools/ml2rhm's translation of
// the pinned HOL Light Boyer_Moore/irrelevance.ml (rhombus/hol/Boyer_Moore/ keeps the
// literal translation). Edited freely for the frontend; not a literal port.

// ****************************************************************************
// FILE          : irrelevance.ml
// DESCRIPTION   : Eliminating irrelevance.
//
// READS FILES   : <none>
// WRITES FILES  : <none>
//
// AUTHOR        : R.J.Boulton
// DATE          : 25th June 1991
//
// LAST MODIFIED : R.J.Boulton
// DATE          : 12th October 1992
//
// LAST MODIFIED : P. Papapanagiotou (University of Edinburgh)
// DATE          : 2008
// ****************************************************************************

import:
  "../../hol/lib.rhm" open:
    only:
      intersect
      o
      map
      flat
      mapfilter
      setify
      exists
      forall
      partition
      itlist
      tl
      hd
      last
      butlast
      funpow
      length
      rev
  "../../hol/fusion.rhm" open:
    only:
      concl
      freesl
      is_const
      dest_const
      rand
      is_var
  "../../hol/basics.rhm" open:
    only:
      dest_disj
      dest_imp
      find_terms
      is_neg
      strip_comb
  "../../hol/equal.rhm" open:
    only:
      CONV_RULE
      RATOR_CONV
      RAND_CONV
  "../../hol/bool.rhm" open:
    only:
      MP
      SPECL
      UNDISCH
      DISCH
      mk_neg
      DISJ2
      DISJ1
      list_mk_disj
  "../../hol/simp.rhm" open:
    only:
      REWR_CONV
  "../../hol/class.rhm" open:
    only:
      TAUT
  "support.rhm" open:
    only:
      sort_on_snd
      distinct
      number_list
      disj_list
  "environment.rhm" open:
    only:
      get_def
  "clausal_form.rhm" open:
    only:
      NOT_NOT_NORM
  "waterfall.rhm" open:
    only:
      proof_print_string_l
      apply_fproof
  "../../hol/private/ocaml.rhm" open:
    only:
      Failure
      failwith
      fst
      append
      snd
  "../../hol/private/hol_quote.rhm" open

export:
  DISJ_IMP
  IMP_ELIM
  partition_literals
  contains_recursive_fun
  is_singleton_rec_app
  merge_numbered_lists
  find_irrelevant_literals
  DISJ_UNDISCH
  DISJ_DISCH
  BUILD_DISJ
  irrelevance_heuristic

def DISJ_IMP:
  let pth = TAUT(@hol|{!t1 t2. t1 \/ t2 ==> ~t1 ==> t2}|)
  fun(th):
    try:
      let [a, b] = dest_disj(concl(th))
      MP(SPECL(PairList [a, b])(pth))(th)
      ~catch Failure(_): failwith("DISJ_IMP")

def IMP_ELIM:
  let pth = TAUT(@hol|{!t1 t2. (t1 ==> t2) ==> ~t1 \/ t2}|)
  fun(th):
    try:
      let [a, b] = dest_imp(concl(th))
      MP(SPECL(PairList [a, b])(pth))(th)
      ~catch Failure(_): failwith("IMP_ELIM")

fun partition_literals(tmnl):
  fun merge_partitions(partition):
    fun(partitions):
      if partitions == PairList []
      | failwith("merge_partitions")
      | let PairList [h, & t] = partitions
        if intersect(o(freesl)(map(fst))(partition))(o(freesl)(map(fst))(h)) == PairList []
        | PairList.cons(h, merge_partitions(partition)(t))
        | PairList.cons(append(partition)(h), t)
  fun repeated_merge(partitions):
    if partitions == PairList []
    | PairList []
    | let PairList [h, & t] = partitions
      try:
        repeated_merge(merge_partitions(h)(t))
        ~catch Failure(_): PairList.cons(h, repeated_merge(t))
  map(sort_on_snd)(repeated_merge(map(fun(tmn): PairList [tmn])(tmnl)))

fun contains_recursive_fun(tml):
  let consts = flat(mapfilter(find_terms(is_const))(tml))
  let names = setify(map(o(fst)(dest_const))(consts))
  exists(fun(name):
           !(try:
               o(fst)(get_def)(name) == 0
               ~catch Failure(_): #true))(names)

fun is_singleton_rec_app(tml):
  try:
    match tml
    | PairList [tm]:
        let tm_prime = (if is_neg(tm) | rand(tm) | tm)
        let [f, args] = strip_comb(tm_prime)
        let name = fst(dest_const(f))
        !(o(fst)(get_def)(name) == 0) && forall(is_var)(args) && distinct(args)
    | _: #false
    ~catch Failure(_): #false

fun merge_numbered_lists(xnl1):
  fun(xnl2):
    if xnl1 == PairList []
    | xnl2
    | if xnl2 == PairList []
      | xnl1
      | let PairList [[x1, n1], & t1] = xnl1
        let PairList [[x2, n2], & t2] = xnl2
        if n1 < n2
        | PairList.cons([x1, n1], merge_numbered_lists(t1)(xnl2))
        | PairList.cons([x2, n2], merge_numbered_lists(xnl1)(t2))

fun find_irrelevant_literals(tm):
  let can_be_falsified:
    fun(tmnl):
      let tml = map(fst)(tmnl)
      !contains_recursive_fun(tml) || is_singleton_rec_app(tml)
  let tmnll = partition_literals(number_list(disj_list(tm)))
  let [irrels, rels] = partition(can_be_falsified)(tmnll)
  [itlist(merge_numbered_lists)(irrels)(PairList []),
   itlist(merge_numbered_lists)(rels)(PairList [])]

fun DISJ_UNDISCH(th):
  try:
    UNDISCH(DISJ_IMP(th))
    ~catch Failure(_): failwith("DISJ_UNDISCH")

fun DISJ_DISCH(tm):
  fun(th):
    try:
      CONV_RULE(RATOR_CONV(RAND_CONV(REWR_CONV(NOT_NOT_NORM))))(IMP_ELIM(DISCH(mk_neg(tm))(th)))
      ~catch Failure(_): failwith("DISJ_DISCH")

fun BUILD_DISJ([outs, ins]):
  fun(inth):
    try:
      fun rebuild(rev_outs):
        fun(rev_ins):
          fun(th):
            if rev_ins == PairList []
            | if rev_outs == PairList []
              | th
              | rebuild(tl(rev_outs))(rev_ins)(DISJ2(fst(hd(rev_outs)))(th))
            | if rev_outs == PairList []
              | rebuild(rev_outs)(tl(rev_ins))(DISJ_DISCH(fst(hd(rev_ins)))(th))
              | let PairList [inh, & int] = rev_ins
                let PairList [outh, & outt] = rev_outs
                if snd(inh) > snd(outh)
                | rebuild(rev_outs)(int)(DISJ_DISCH(fst(inh))(th))
                | rebuild(outt)(rev_ins)(DISJ2(fst(outh))(th))
      let last_in = snd(last(ins))
      let [under_outs, over_outs] = partition(fun([_, n]): n > last_in)(outs)
      let over_ins = butlast(ins)
      let th1 = funpow(length(over_ins))(DISJ_UNDISCH)(inth)
      let th2:
        try:
          DISJ1(th1)(list_mk_disj(map(fst)(under_outs)))
          ~catch Failure(_): th1
      rebuild(rev(over_outs))(rev(over_ins))(th2)
      ~catch Failure(_): failwith("BUILD_DISJ")

fun irrelevance_heuristic([tm, ind]):
  let [outs, ins] = find_irrelevant_literals(tm)
  if ins == PairList []
  | failwith("cannot prove")
  | if outs == PairList []
    | failwith("irrelevance_heuristic")
    | let tm_prime = list_mk_disj(map(fst)(ins))
      let proof = BUILD_DISJ([outs, ins])
      proof_print_string_l("-> Irrelevance Heuristic")(#void)
      [PairList [[tm_prime, ind]],
       apply_fproof("irrelevance_heuristic")(o(proof)(hd))(PairList [tm_prime])]
