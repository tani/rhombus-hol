      alpha
      subst
      strip_comb
      list_mk_comb
      dest_neg
      strip_forall
      conjuncts
      dest_imp
      dest_forall
      dest_conj
  "../../hol/equal.rhm" open:
    only:
      lhs
      CONV_RULE
      ALPHA
      ONCE_DEPTH_CONV
      AP_TERM
      or_conv
      then_conv
      ALL_CONV
  "../../hol/bool.rhm" open:
    only:
      GEN_ALL
      SPEC_ALL
      mk_neg
      mk_forall
      list_mk_conj
      list_mk_forall
      CONJUNCTS
      SPEC
      SPECL
      EQT_INTRO
      mk_conj
