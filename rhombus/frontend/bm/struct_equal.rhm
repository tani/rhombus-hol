      unzip
      filter
      C
      hd
      zip
      o
      tl
      rev
      check
      can
      assoc
      flat
      length
      el
      I
      splitlist
      end_itlist
      curry
  "../../hol/fusion.rhm" open:
    only:
      aconv
      is_comb
      dest_comb
      mk_comb
      is_abs
      dest_abs
      type_of
      vsubst
      mk_abs
      concl
      dest_const
      is_var
      dest_eq
      dest_type
      rand
      mk_eq
      ASSUME
      EQ_MP
      INST
      REFL
      TRANS
      MK_COMB
  "../../hol/basics.rhm" open:
    only:
