#lang rhombus
// The checker: `racket rhombus/frontend/check.rhm FILE.rhm ...` instantiates
// each module, which records its datatypes, functions and theorems, then
// makes them HOL definitions and proves the theorems (logic.rhm). Exits
// with status 1 when anything fails.
import:
  lib("racket/base.rkt") as Rkt
  "runtime.rhm" as rt
  "logic.rhm" open

export:
  check_declarations

fun check_declarations(decls :: List) :: List:
  let c = Checker()
  for List:
    each d in decls
    each o in c.run(d)
    println(o.kind +& " " +& o.name +& ": " +& o.status)
    println("  " +& o.detail)
    o

module main:
  def files = Rkt.#{current-command-line-arguments}()
  for (f in files):
    Rkt.#{dynamic-require}(Rkt.#{string->path}(f), #false)
  let outcomes = check_declarations(rt.declarations())
  let failed = for List (o in outcomes): keep_when o.status != "ok"; o
  println(to_string(outcomes.length() - failed.length()) +& "/" +& outcomes.length() +& " checked")
  if failed == [] | #void | Rkt.exit(1)
