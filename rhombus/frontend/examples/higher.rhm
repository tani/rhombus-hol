#lang rhombus
// Function types and anonymous functions.
import:
  "../main.rhm" open
  "list.rhm" open

fun map(f :: ?a -> ?b, xs :: List(?a)) :: List(?b):
  match xs
  | Nil: Nil
  | Cons(x, rest): Cons(f(x), map(f, rest))

fun foldr(f :: (?a, ?b) -> ?b, z :: ?b, xs :: List(?a)) :: ?b:
  match xs
  | Nil: z
  | Cons(x, rest): f(x, foldr(f, z, rest))

fun compose(f :: ?b -> ?c, g :: ?a -> ?b) :: ?a -> ?c:
  fun(x :: ?a): f(g(x))

fun twice(f :: ?a -> ?a) :: ?a -> ?a:
  compose(f, f)

fun total(xs :: List(Nat)) :: Nat:
  foldr(fun(x :: Nat, acc :: Nat): x + acc, 0, xs)

fun incr_all(xs :: List(Nat)) :: List(Nat):
  map(fun(x): x + 1, xs)

theorem len_map(f :: ?a -> ?b, xs :: List(?a)):
  len(map(f, xs)) == len(xs)

theorem map_append(f :: ?a -> ?b, xs :: List(?a), ys :: List(?a)):
  map(f, append(xs, ys)) == append(map(f, xs), map(f, ys))

theorem map_map(f :: ?b -> ?c, g :: ?a -> ?b, xs :: List(?a)):
  map(f, map(g, xs)) == map(compose(f, g), xs)

theorem total_append(xs :: List(Nat), ys :: List(Nat)):
  total(append(xs, ys)) == total(xs) + total(ys)

theorem total_incr_all(xs :: List(Nat)):
  total(incr_all(xs)) == total(xs) + len(xs)

module test:
  def l = Cons(1, Cons(2, Cons(3, Nil)))
  check total(l) ~is 6
  check total(incr_all(l)) ~is 9
  check twice(fun(n): n * 2)(5) ~is 20
  check map(compose(fun(n): n + 1, fun(n): n * 10), l) ~is Cons(11, Cons(21, Cons(31, Nil)))
  // An untyped `fun` is plain Rhombus.
  fun helper(x): x
  check helper(3) ~is 3
