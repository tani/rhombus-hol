#lang rhombus
// Lists: the classic Boyer-Moore theorems about append and reverse.
import:
  "../main.rhm" open

export:
  Nil
  Cons
  append
  len

datatype List(?a)
| Nil
| Cons(head :: ?a, tail :: List(?a))

function append(xs :: List(?a), ys :: List(?a)) :: List(?a):
  match xs
  | Nil: ys
  | Cons(x, rest): Cons(x, append(rest, ys))

function len(xs :: List(?a)) :: Nat:
  match xs
  | Nil: 0
  | Cons(_, rest): len(rest) + 1

function rev(xs :: List(?a)) :: List(?a):
  match xs
  | Nil: Nil
  | Cons(x, rest): append(rev(rest), Cons(x, Nil))

theorem append_nil(xs :: List(?a)):
  append(xs, Nil) == xs

theorem append_assoc(xs :: List(?a), ys :: List(?a), zs :: List(?a)):
  append(append(xs, ys), zs) == append(xs, append(ys, zs))

theorem len_append(xs :: List(?a), ys :: List(?a)):
  len(append(xs, ys)) == len(xs) + len(ys)

theorem rev_append(xs :: List(?a), ys :: List(?a)):
  rev(append(xs, ys)) == append(rev(ys), rev(xs))

theorem rev_rev(xs :: List(?a)):
  rev(rev(xs)) == xs

module test:
  def l = Cons(1, Cons(2, Cons(3, Nil)))
  check len(append(l, l)) ~is 6
  check rev(l) ~is Cons(3, Cons(2, Cons(1, Nil)))
  check rev(rev(l)) == l ~is #true
