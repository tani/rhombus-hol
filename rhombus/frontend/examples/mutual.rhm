#lang rhombus
// Mutually recursive and nested datatypes and functions.
import:
  "../main.rhm" open
  "list.rhm" open

// Terms whose applications take a list of arguments of their own type.
datatype Tm
| Var(index :: Nat)
| App(fn :: Tm, args :: Args)
and Args
| NoArgs
| More(arg :: Tm, rest :: Args)

function tsize(t :: Tm) :: Nat:
  match t
  | Var(_): 1
  | App(f, a): tsize(f) + asize(a)
and asize(a :: Args) :: Nat:
  match a
  | NoArgs: 0
  | More(t, rest): tsize(t) + asize(rest)

// A rose tree: a label and a List of subtrees.
datatype Rose(?a)
| Node(label :: ?a, kids :: List(Rose(?a)))

function rsize(t :: Rose(?a)) :: Nat:
  match t
  | Node(_, kids): ksize(kids) + 1
and ksize(ts :: List(Rose(?a))) :: Nat:
  match ts
  | Nil: 0
  | Cons(t, rest): rsize(t) + ksize(rest)

module test:
  check tsize(App(Var(0), More(Var(1), More(Var(2), NoArgs)))) ~is 3
  check rsize(Node(1, Cons(Node(2, Nil), Cons(Node(3, Nil), Nil)))) ~is 3
