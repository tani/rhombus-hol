#lang rhombus
import:
  "../main.rhm" open

datatype Tree(?a)
| Leaf
| Node(left :: Tree(?a), value :: ?a, right :: Tree(?a))

function mirror(t :: Tree(?a)) :: Tree(?a):
  match t
  | Leaf: Leaf
  | Node(l, x, r): Node(mirror(r), x, mirror(l))

function size(t :: Tree(?a)) :: Nat:
  match t
  | Leaf: 0
  | Node(l, _, r): size(l) + 1 + size(r)

function double(n :: Nat) :: Nat:
  match n
  | 0: 0
  | m + 1: double(m) + 2

theorem mirror_mirror(t :: Tree(?a)):
  mirror(mirror(t)) == t
proof:
  induct: t

theorem size_mirror(t :: Tree(?a)):
  size(mirror(t)) == size(t)

theorem double_half(n :: Nat):
  double(n) == n + n

module test:
  def t = Node(Node(Leaf, 1, Leaf), 2, Leaf)
  check size(mirror(t)) ~is 2
  check mirror(t).left ~is Leaf
  check double(5) ~is 10
  check declarations().length() ~is 7
  check mirror(mirror(t)) == t ~is #true
