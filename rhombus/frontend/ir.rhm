#lang rhombus
// The frontend's intermediate representation. A `datatype`, `function` or
// `theorem` form is parsed into these values at expansion time (parse.rhm);
// the executable code is generated from them (emit.rhm), and the same values,
// recorded at run time in the registry, are turned into HOL types, terms,
// definitions and proofs by the checker (logic.rhm). Names are strings.
export:
  TNat
  TBool
  TVar
  TCon
  EVar
  ENat
  EBool
  ECall
  EOp
  EIf
  EMatch
  Case
  ELet
  PVar
  PWild
  PCon
  PNat
  PSucc
  Field
  Ctor
  TypeDef
  Datatype
  Param
  Function
  Hints
  Theorem

// Types: Nat, Bool, type variables (`?a`, named "?a") and datatypes.
class TNat()
class TBool()
class TVar(name)
class TCon(name, args)

// Expressions. ECall applies a function or a constructor; EOp is one of
// + - * div mod == != < <= > >= && || ! ==>.
class EVar(name)
class ENat(n)
class EBool(b)
class ECall(name, args)
class EOp(op, args)
class EIf(test, then, els)
class EMatch(scrut, cases)
class Case(pat, body)
class ELet(name, rhs, body)

// Patterns: variables, `_`, constructors, Nat literals and `p + 1`.
class PVar(name)
class PWild()
class PCon(name, args)
class PNat(n)
class PSucc(pat)

// Declarations. A Datatype holds one or more mutually recursive types.
class Field(name, ty)
class Ctor(name, fields)
class TypeDef(name, params, ctors)
class Datatype(types)
class Param(name, ty)
class Function(name, params, result, body)
// The hints of a `proof:` block: names of theorems or definitions to use as
// rewrite rules, names whose rules to leave out, a variable to induct on.
class Hints(use, disable, induct)
class Theorem(name, params, stmt, hints)
