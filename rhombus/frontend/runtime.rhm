#lang rhombus
// What the code a frontend form expands to uses at run time: the registry of
// declarations the checker reads, the values of datatypes, and the Nat
// operations with HOL's meaning.
import:
  "ir.rhm" open

export:
  declare
  declarations
  DataValue
  ctor_of
  field
  monus
  nat_div
  nat_mod
  implies
  no_match

// Every datatype, function and theorem, in the order the modules declaring
// them are instantiated: the order the checker processes them in.
def registry = Box([])
fun declare(d): registry.value := registry.value.add(d)
fun declarations(): registry.value

// A value of a datatype: its constructor's name and its fields.
interface DataValue:
  method ctor_name()
  method fields()

fun ctor_of(v :: DataValue): v.ctor_name()
fun field(v :: DataValue, i): v.fields()[i]

// Nat: `-` is truncated (HOL's SUB); x div 0 = 0 and x mod 0 = x, as
// HOL Light's DIV_ZERO and MOD_ZERO.
fun monus(a, b): if a > b | a - b | 0
fun nat_div(a, b): if b == 0 | 0 | a div b
fun nat_mod(a, b): if b == 0 | a | a mod b
fun implies(a, b): !a || b

fun no_match(name): error(name, "no pattern matches")
