#lang rhombus
// Direct translation of the pinned HOL Light Boyer_Moore/boyer-moore.ml:
// loads the modules of the Boyer-Moore prover in order. A Rhombus module
// re-exports them instead of loading files from the path; as in OCaml,
// terms_and_clauses.ml's SUBST_CONV shadows support.ml's.

// ****************************************************************************
// LAST MODIFIED : P. Papapanagiotou (University of Edinburgh)
// DATE          : July 2009
// ****************************************************************************

import:
  "support.rhm" open:
    except:
      SUBST_CONV
  "struct_equal.rhm" open
  "shells.rhm" open
  "environment.rhm" open
  "clausal_form.rhm" open
  "waterfall.rhm" open
  "rewrite_rules.rhm" open
  "definitions.rhm" open
  "terms_and_clauses.rhm" open
  "equalities.rhm" open
  "induction.rhm" open
  "counterexample.rhm" open
  "generalize.rhm" open
  "irrelevance.rhm" open
  "main.rhm" open

export:
  all_from("support.rhm")
  all_from("struct_equal.rhm")
  all_from("shells.rhm")
  all_from("environment.rhm")
  all_from("clausal_form.rhm")
  all_from("waterfall.rhm")
  all_from("rewrite_rules.rhm")
  all_from("definitions.rhm")
  all_from("terms_and_clauses.rhm")
  all_from("equalities.rhm")
  all_from("induction.rhm")
  all_from("counterexample.rhm")
  all_from("generalize.rhm")
  all_from("irrelevance.rhm")
  all_from("main.rhm")
