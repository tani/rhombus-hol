#lang rhombus
// Direct translation of the pinned HOL Light Boyer_Moore/clausal_form.ml.

// ****************************************************************************
// FILE          : clausal_form.ml
// DESCRIPTION   : Functions for putting a formula into clausal form.
//
// READS FILES   : <none>
// WRITES FILES  : <none>
//
// AUTHOR        : R.J.Boulton
// DATE          : 13th May 1991
//
// LAST MODIFIED : R.J.Boulton
// DATE          : 12th October 1992
//
// LAST MODIFIED : P. Papapanagiotou (University of Edinburgh)
// DATE          : 2008
// ****************************************************************************

import:
  "../private/hol_quote.rhm" open
  "../private/proof_syntax.rhm" open
  "../private/ocaml.rhm" open:
    only:
      Failure
      failwith
      snd
  "../lib.rhm" open:
    only:
      map
      subtract
      setify
  "../fusion.rhm" open:
    only:
      is_eq
      rand
      rator
      concl
      TRANS
      type_of
      is_var
      is_const
  "../basics.rhm" open:
    only:
      dest_neg
      dest_conj
      dest_disj
      is_neg
      is_imp
      is_conj
      is_disj
      strip_comb
  "../equal.rhm" open:
    only:
      SYM
      ALL_CONV
      RAND_CONV
      RATOR_CONV
      TRY_CONV
      rhs
  "../bool.rhm" open:
    only:
      SPEC
      CONJUNCT1
      CONJUNCT2
      CONJUNCTS
      GEN_ALL
      SPEC_ALL
  "../tactics.rhm" open:
    only:
      prove
  "../simp.rhm" open:
    only:
      REWRITE_TAC
      REWR_CONV
  "../theorems.rhm" open:
    only:
      CONJ_ASSOC
      DISJ_ASSOC
      AND_CLAUSES
      OR_CLAUSES
  "../class.rhm" open:
    only:
      TAUT
      BOOL_CASES_TAC
      NOT_CLAUSES
      DE_MORGAN_THM
      is_cond
  "support.rhm" open:
    only:
      is_T
      is_F

export:
  IMP_DISJ_THM
  RIGHT_OR_OVER_AND
  LEFT_OR_OVER_AND
  EQ_EXPAND
  IMP_EXPAND
  COND_EXPAND
  NOT_NOT_NORM
  NOT_CONJ_NORM
  NOT_DISJ_NORM
  LEFT_DIST_NORM
  RIGHT_DIST_NORM
  CONJ_ASSOC_NORM
  DISJ_ASSOC_NORM
  COND_EXPAND_CONV
  CONJ_ASSOC_NORM_CONV
  DISJ_ASSOC_NORM_CONV
  EQ_EXPAND_CONV
  IMP_EXPAND_CONV
  LEFT_DIST_NORM_CONV
  NOT_CONJ_NORM_CONV
  NOT_DISJ_NORM_CONV
  NOT_NOT_NORM_CONV
  RIGHT_DIST_NORM_CONV
  NOT_CONV
  AND_CONV
  OR_CONV
  EQ_IMP_COND_ELIM_CONV
  MOVE_NOT_DOWN_CONV
  CONJ_LINEAR_CONV
  CONJ_NORM_FORM_CONV
  has_boolean_args_and_result
  CLAUSAL_FORM_CONV

def IMP_DISJ_THM = TAUT(@hol|{!t1 t2. t1 ==> t2 <=> ~t1 \/ t2}|)
def RIGHT_OR_OVER_AND = TAUT(@hol|{!t1 t2 t3. t2 /\ t3 \/ t1 <=> (t2 \/ t1) /\ (t3 \/ t1)}|)
def LEFT_OR_OVER_AND = TAUT(@hol|{!t1 t2 t3. t1 \/ t2 /\ t3 <=> (t1 \/ t2) /\ (t1 \/ t3)}|)

// ============================================================================
// Theorems for normalizing Boolean terms
// ============================================================================

// ----------------------------------------------------------------------------
// EQ_EXPAND = |- (x = y) = ((~x \/ y) /\ (~y \/ x))
// ----------------------------------------------------------------------------

def EQ_EXPAND:
  prove([@hol|{(x = y) = ((~x \/ y) /\ (~y \/ x))}|,
         BOOL_CASES_TAC(@hol|{x:bool}|) then_tac \
           BOOL_CASES_TAC(@hol|{y:bool}|) then_tac \
           REWRITE_TAC(PairList [])])

// ----------------------------------------------------------------------------
// IMP_EXPAND = |- (x ==> y) = (~x \/ y)
// ----------------------------------------------------------------------------

def IMP_EXPAND = SPEC(@hol|{y:bool}|)(SPEC(@hol|{x:bool}|)(IMP_DISJ_THM))

// ----------------------------------------------------------------------------
// COND_EXPAND = |- (x => y | z) = ((~x \/ y) /\ (x \/ z))
// ----------------------------------------------------------------------------

def COND_EXPAND:
  prove([@hol|{(if x then y else z) = ((~x \/ y) /\ (x \/ z))}|,
         BOOL_CASES_TAC(@hol|{x:bool}|) then_tac \
           BOOL_CASES_TAC(@hol|{y:bool}|) then_tac \
           BOOL_CASES_TAC(@hol|{z:bool}|) then_tac \
           REWRITE_TAC(PairList [])])

// ----------------------------------------------------------------------------
// NOT_NOT_NORM = |- ~~x = x
// ----------------------------------------------------------------------------

def NOT_NOT_NORM = SPEC(@hol|{x:bool}|)(CONJUNCT1(NOT_CLAUSES))

// ----------------------------------------------------------------------------
// NOT_CONJ_NORM = |- ~(x /\ y) = (~x \/ ~y)
// ----------------------------------------------------------------------------

def NOT_CONJ_NORM = CONJUNCT1(SPEC(@hol|{y:bool}|)(SPEC(@hol|{x:bool}|)(DE_MORGAN_THM)))

// ----------------------------------------------------------------------------
// NOT_DISJ_NORM = |- ~(x \/ y) = (~x /\ ~y)
// ----------------------------------------------------------------------------

def NOT_DISJ_NORM = CONJUNCT2(SPEC(@hol|{y:bool}|)(SPEC(@hol|{x:bool}|)(DE_MORGAN_THM)))

// ----------------------------------------------------------------------------
// LEFT_DIST_NORM = |- x \/ (y /\ z) = (x \/ y) /\ (x \/ z)
// ----------------------------------------------------------------------------

def LEFT_DIST_NORM:
  SPEC(@hol|{z:bool}|)(SPEC(@hol|{y:bool}|)(SPEC(@hol|{x:bool}|)(LEFT_OR_OVER_AND)))

// ----------------------------------------------------------------------------
// RIGHT_DIST_NORM = |- (x /\ y) \/ z = (x \/ z) /\ (y \/ z)
// ----------------------------------------------------------------------------

def RIGHT_DIST_NORM:
  SPEC(@hol|{y:bool}|)(SPEC(@hol|{x:bool}|)(SPEC(@hol|{z:bool}|)(RIGHT_OR_OVER_AND)))

// ----------------------------------------------------------------------------
// CONJ_ASSOC_NORM = |- (x /\ y) /\ z = x /\ (y /\ z)
// ----------------------------------------------------------------------------

def CONJ_ASSOC_NORM:
  SYM(SPEC(@hol|{z:bool}|)(SPEC(@hol|{y:bool}|)(SPEC(@hol|{x:bool}|)(CONJ_ASSOC))))

// ----------------------------------------------------------------------------
// DISJ_ASSOC_NORM = |- (x \/ y) \/ z = x \/ (y \/ z)
// ----------------------------------------------------------------------------

def DISJ_ASSOC_NORM:
  SYM(SPEC(@hol|{z:bool}|)(SPEC(@hol|{y:bool}|)(SPEC(@hol|{x:bool}|)(DISJ_ASSOC))))

// ============================================================================
// Conversions for rewriting Boolean terms
// ============================================================================

def COND_EXPAND_CONV = REWR_CONV(COND_EXPAND)
def CONJ_ASSOC_NORM_CONV = REWR_CONV(CONJ_ASSOC_NORM)
def DISJ_ASSOC_NORM_CONV = REWR_CONV(DISJ_ASSOC_NORM)
def EQ_EXPAND_CONV = REWR_CONV(EQ_EXPAND)
def IMP_EXPAND_CONV = REWR_CONV(IMP_EXPAND)
def LEFT_DIST_NORM_CONV = REWR_CONV(LEFT_DIST_NORM)
def NOT_CONJ_NORM_CONV = REWR_CONV(NOT_CONJ_NORM)
def NOT_DISJ_NORM_CONV = REWR_CONV(NOT_DISJ_NORM)
def NOT_NOT_NORM_CONV = REWR_CONV(NOT_NOT_NORM)
def RIGHT_DIST_NORM_CONV = REWR_CONV(RIGHT_DIST_NORM)

// ----------------------------------------------------------------------------
// NOT_CONV : conv
//
//    |- !t. ~~t = t
//    |- ~T = F
//    |- ~F = T
// ----------------------------------------------------------------------------

def NOT_CONV:
  try:
    let PairList [th1, th2, th3] = CONJUNCTS(NOT_CLAUSES)
    fun(tm):
      let arg = dest_neg(tm)
      if is_T(arg)
      | th2
      | if is_F(arg)
        | th3
        | SPEC(dest_neg(arg))(th1)
    ~catch Failure(_): failwith("NOT_CONV")

// ----------------------------------------------------------------------------
// AND_CONV : conv
//
//    |- T /\ t = t
//    |- t /\ T = t
//    |- F /\ t = F
//    |- t /\ F = F
//    |- t /\ t = t
// ----------------------------------------------------------------------------

def AND_CONV:
  try:
    let PairList [th1, th2, th3, th4, th5] = map(GEN_ALL)(CONJUNCTS(SPEC_ALL(AND_CLAUSES)))
    fun(tm):
      let [arg1, arg2] = dest_conj(tm)
      if is_T(arg1)
      | SPEC(arg2)(th1)
      | if is_T(arg2)
        | SPEC(arg1)(th2)
        | if is_F(arg1)
          | SPEC(arg2)(th3)
          | if is_F(arg2)
            | SPEC(arg1)(th4)
            | if arg1 == arg2
              | SPEC(arg1)(th5)
              | failwith("")
    ~catch Failure(_): failwith("AND_CONV")

// ----------------------------------------------------------------------------
// OR_CONV : conv
//
//    |- T \/ t = T
//    |- t \/ T = T
//    |- F \/ t = t
//    |- t \/ F = t
//    |- t \/ t = t
// ----------------------------------------------------------------------------

def OR_CONV:
  try:
    let PairList [th1, th2, th3, th4, th5] = map(GEN_ALL)(CONJUNCTS(SPEC_ALL(OR_CLAUSES)))
    fun(tm):
      let [arg1, arg2] = dest_disj(tm)
      if is_T(arg1)
      | SPEC(arg2)(th1)
      | if is_T(arg2)
        | SPEC(arg1)(th2)
        | if is_F(arg1)
          | SPEC(arg2)(th3)
          | if is_F(arg2)
            | SPEC(arg1)(th4)
            | if arg1 == arg2
              | SPEC(arg1)(th5)
              | failwith("")
    ~catch Failure(_): failwith("OR_CONV")

// ============================================================================
// Conversions for obtaining `clausal' form
// ============================================================================

// ----------------------------------------------------------------------------
// EQ_IMP_COND_ELIM_CONV : (term -> bool) -> conv
//
// Eliminates Boolean equalities, Boolean conditionals, and implications from
// terms consisting of =,==>,COND,/\,\/,~ and atoms. The atoms are specified
// by the predicate that the conversion takes as its first argument.
// ----------------------------------------------------------------------------

fun EQ_IMP_COND_ELIM_CONV(is_atom):
  fun(tm):
    try:
      if is_atom(tm)
      | ALL_CONV(tm)
      | if is_neg(tm)
        | (RAND_CONV(EQ_IMP_COND_ELIM_CONV(is_atom)))(tm)
        | if is_eq(tm)
          | ((RATOR_CONV(RAND_CONV(EQ_IMP_COND_ELIM_CONV(is_atom)))) then_conv \
               (RAND_CONV(EQ_IMP_COND_ELIM_CONV(is_atom))) then_conv \
               EQ_EXPAND_CONV)(tm)
          | if is_imp(tm)
            | ((RATOR_CONV(RAND_CONV(EQ_IMP_COND_ELIM_CONV(is_atom)))) then_conv \
                 (RAND_CONV(EQ_IMP_COND_ELIM_CONV(is_atom))) then_conv \
                 IMP_EXPAND_CONV)(tm)
            | if is_cond(tm)
              | ((RATOR_CONV(
                    RATOR_CONV(RAND_CONV(EQ_IMP_COND_ELIM_CONV(is_atom))))) then_conv \
                   (RATOR_CONV(RAND_CONV(EQ_IMP_COND_ELIM_CONV(is_atom)))) then_conv \
                   (RAND_CONV(EQ_IMP_COND_ELIM_CONV(is_atom))) then_conv \
                   COND_EXPAND_CONV)(tm)
              | ((RATOR_CONV(RAND_CONV(EQ_IMP_COND_ELIM_CONV(is_atom)))) then_conv \
                   (RAND_CONV(EQ_IMP_COND_ELIM_CONV(is_atom))))(tm)
      ~catch Failure(_): failwith("EQ_IMP_COND_ELIM_CONV")

// ----------------------------------------------------------------------------
// MOVE_NOT_DOWN_CONV : (term -> bool) -> conv -> conv
//
// Moves negations down through a term consisting of /\,\/,~ and atoms. The
// atoms are specified by a predicate (first argument). When a negation has
// reached an atom, the conversion `conv' (second argument) is applied to the
// negation of the atom. `conv' is also applied to any non-negated atoms
// encountered. T and F are eliminated.
// ----------------------------------------------------------------------------

fun MOVE_NOT_DOWN_CONV(is_atom):
  fun(conv):
    fun(tm):
      try:
        if is_atom(tm)
        | conv(tm)
        | if is_neg(tm)
          | (block:
               let tm_prime = rand(tm)
               if is_atom(tm_prime)
               | (conv then_conv (TRY_CONV(NOT_CONV)))(tm)
               | if is_neg(tm_prime)
                 | (NOT_NOT_NORM_CONV then_conv \
                      (MOVE_NOT_DOWN_CONV(is_atom)(conv)))(tm)
                 | if is_conj(tm_prime)
                   | (NOT_CONJ_NORM_CONV then_conv \
                        (RATOR_CONV(RAND_CONV(MOVE_NOT_DOWN_CONV(is_atom)(conv)))) then_conv \
                        (RAND_CONV(MOVE_NOT_DOWN_CONV(is_atom)(conv))) then_conv \
                        (TRY_CONV(AND_CONV)))(tm)
                   | if is_disj(tm_prime)
                     | (NOT_DISJ_NORM_CONV then_conv \
                          (RATOR_CONV(RAND_CONV(MOVE_NOT_DOWN_CONV(is_atom)(conv)))) then_conv \
                          (RAND_CONV(MOVE_NOT_DOWN_CONV(is_atom)(conv))) then_conv \
                          (TRY_CONV(OR_CONV)))(tm)
                     | failwith(""))
          | if is_conj(tm)
            | ((RATOR_CONV(RAND_CONV(MOVE_NOT_DOWN_CONV(is_atom)(conv)))) then_conv \
                 (RAND_CONV(MOVE_NOT_DOWN_CONV(is_atom)(conv))) then_conv \
                 (TRY_CONV(AND_CONV)))(tm)
            | if is_disj(tm)
              | ((RATOR_CONV(RAND_CONV(MOVE_NOT_DOWN_CONV(is_atom)(conv)))) then_conv \
                   (RAND_CONV(MOVE_NOT_DOWN_CONV(is_atom)(conv))) then_conv \
                   (TRY_CONV(OR_CONV)))(tm)
              | failwith("")
        ~catch Failure(_): failwith("MOVE_NOT_DOWN_CONV")

// ----------------------------------------------------------------------------
// CONJ_LINEAR_CONV : conv
//
// Linearizes conjuncts using the following conversion applied recursively:
//
//    "(x /\ y) /\ z"
//    ================================
//    |- (x /\ y) /\ z = x /\ (y /\ z)
// ----------------------------------------------------------------------------

fun CONJ_LINEAR_CONV(tm):
  try:
    if is_conj(tm) && is_conj(rand(rator(tm)))
    | (CONJ_ASSOC_NORM_CONV then_conv \
         (RAND_CONV(TRY_CONV(CONJ_LINEAR_CONV))) then_conv \
         (TRY_CONV(CONJ_LINEAR_CONV)))(tm)
    | failwith("")
    ~catch Failure(_): failwith("CONJ_LINEAR_CONV")

// ----------------------------------------------------------------------------
// CONJ_NORM_FORM_CONV : conv
//
// Puts a term involving /\ and \/ into conjunctive normal form. Anything
// other than /\ and \/ is taken to be an atom and is not processed.
//
// The conjunction returned is linear, i.e. the conjunctions are associated
// to the right. Each conjunct is a linear disjunction.
// ----------------------------------------------------------------------------

fun CONJ_NORM_FORM_CONV(tm):
  try:
    if is_disj(tm)
    | if is_conj(rand(rator(tm)))
      | ((RATOR_CONV(
            RAND_CONV((RATOR_CONV(RAND_CONV(CONJ_NORM_FORM_CONV))) then_conv \
                        (RAND_CONV(CONJ_NORM_FORM_CONV))))) then_conv \
           (RAND_CONV(CONJ_NORM_FORM_CONV)) then_conv \
           RIGHT_DIST_NORM_CONV then_conv \
           (RATOR_CONV(RAND_CONV(CONJ_NORM_FORM_CONV))) then_conv \
           (RAND_CONV(CONJ_NORM_FORM_CONV)) then_conv \
           (TRY_CONV(CONJ_LINEAR_CONV)))(tm)
      | if is_conj(rand(tm))
        | ((RATOR_CONV(RAND_CONV(CONJ_NORM_FORM_CONV))) then_conv \
             (RAND_CONV((RATOR_CONV(RAND_CONV(CONJ_NORM_FORM_CONV))) then_conv \
                          (RAND_CONV(CONJ_NORM_FORM_CONV)))) then_conv \
             LEFT_DIST_NORM_CONV then_conv \
             (RATOR_CONV(RAND_CONV(CONJ_NORM_FORM_CONV))) then_conv \
             (RAND_CONV(CONJ_NORM_FORM_CONV)) then_conv \
             (TRY_CONV(CONJ_LINEAR_CONV)))(tm)
        | if is_disj(rand(rator(tm)))
          | (DISJ_ASSOC_NORM_CONV then_conv CONJ_NORM_FORM_CONV)(tm)
          | let th = RAND_CONV(CONJ_NORM_FORM_CONV)(tm)
            let tm_prime = rhs(concl(th))
            if is_conj(rand(tm_prime))
            | TRANS(th)(CONJ_NORM_FORM_CONV(tm_prime))
            | th
    | if is_conj(tm)
      | ((RATOR_CONV(RAND_CONV(CONJ_NORM_FORM_CONV))) then_conv \
           (RAND_CONV(CONJ_NORM_FORM_CONV)) then_conv \
           (TRY_CONV(CONJ_LINEAR_CONV)))(tm)
      | ALL_CONV(tm)
    ~catch Failure(_): failwith("CONJ_NORM_FORM_CONV")

// ----------------------------------------------------------------------------
// has_boolean_args_and_result : term -> bool
//
// Yields true if and only if the term is of type ":bool", and if it is a
// function application, all the arguments are of type ":bool".
// ----------------------------------------------------------------------------

fun has_boolean_args_and_result(tm):
  try:
    let args = snd(strip_comb(tm))
    let types = PairList.cons(type_of(tm), map(type_of)(args))
    subtract(setify(types))(PairList [@hol|{:bool}|]) == PairList []
    ~catch Failure(_): type_of(tm) == @hol|{:bool}|

// ----------------------------------------------------------------------------
// CLAUSAL_FORM_CONV : conv
//
// Puts into clausal form terms consisting of =,==>,COND,/\,\/,~ and atoms.
// ----------------------------------------------------------------------------

fun CLAUSAL_FORM_CONV(tm):
  try:
    let is_atom:
      fun(tm):
        (!has_boolean_args_and_result(tm)) || is_var(tm) || is_const(tm)
    ((EQ_IMP_COND_ELIM_CONV(is_atom)) then_conv \
       (MOVE_NOT_DOWN_CONV(is_atom)(ALL_CONV)) then_conv \
       CONJ_NORM_FORM_CONV)(tm)
    ~catch Failure(_): failwith("CLAUSAL_FORM_CONV")
