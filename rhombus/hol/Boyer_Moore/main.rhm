// DATE          : July 2009
// ****************************************************************************

import:
  "../private/hol_quote.rhm" open
  "../private/ocaml.rhm" open:
    only:
      Failure
      failwith
      snd
      fst
  "../lib.rhm" open:
    only:
      map
      o
      butlast
      last
      itlist
      funpow
      length
  "../fusion.rhm" open:
    only:
      concl
      rand
      ASSUME
  "../basics.rhm" open:
    only:
      is_neg
  "../equal.rhm" open:
    only:
      CONV_RULE
  "../bool.rhm" open:
    only:
      EQT_INTRO
      mk_neg
      DISCH
      UNDISCH
  "../tactics.rhm" open:
    only:
      null_meta
  "../simp.rhm" open:
    only:
      REWR_CONV
  "support.rhm" open:
    only:
      list_mk_imp
      disj_list
      lcombinep
  "environment.rhm" open:
    only:
      my_gen_terms
      bm_steps
  "clausal_form.rhm" open:
    only:
      IMP_DISJ_THM
  "waterfall.rhm" open:
    only:
      proof_print_depth
      proof_print_newline
      FILTERED_WATERFALL
      taut_heuristic
      clausal_form_heuristic
      setify_heuristic
      meson_heuristic
      WATERFALL
      filtered_waterfall
      fringe_of_clause_tree
      fprove_clause_tree
  "terms_and_clauses.rhm" open:
    only:
      subst_heuristic
      HL_simplify_heuristic
      simplify_heuristic
  "equalities.rhm" open:
    only:
      use_equality_heuristic
  "induction.rhm" open:
    only:
      induction_heuristic
  "counterexample.rhm" open:
    only:
      counterexamples
  "generalize.rhm" open:
    only:
      generalize_heuristic_ext
      generalize_heuristic_aderhold
      generalize_heuristic
  "irrelevance.rhm" open:
    only:
      irrelevance_heuristic
      DISJ_DISCH

export:
  BOYER_MOORE_FINAL
  BOYER_MOORE_MESON
  BOYER_MOORE_GEN
  BOYER_MOORE_EXT
  BOYER_MOORE_RE
  BOYER_MOORE
  BOYER_MOORE_CONV
  HEURISTIC_TAC
  BOYER_MOORE_TAC
  BM_SAFE_TAC
  BMG_TAC
  BMF_TAC
  BMF_NOEQ_TAC
  BM_SIMPLIFY_TAC
  BM_INDUCT_TAC

// ----------------------------------------------------------------------------
// BOYER_MOORE : conv
//
// Boyer-Moore-style automatic theorem prover.
// Given a term "tm", attempts to prove |- tm.
// ----------------------------------------------------------------------------

fun BOYER_MOORE_FINAL(l):
  fun(tm):
    my_gen_terms.value := PairList []
    counterexamples.value := 0
    proof_print_depth.value := 0
    bm_steps.value := [0, 0]
    try:
      proof_print_newline(
        FILTERED_WATERFALL(
          PairList [taut_heuristic,
                    clausal_form_heuristic,
                    setify_heuristic,
                    subst_heuristic,
                    HL_simplify_heuristic(l),
                    use_equality_heuristic,
                    generalize_heuristic_ext,
                    irrelevance_heuristic])(
          induction_heuristic)(PairList [])(
          [tm, #false]))
      ~catch Failure(_): failwith("BOYER_MOORE")

