          PairList [taut_heuristic,
                    clausal_form_heuristic,
                    setify_heuristic,
                    subst_heuristic,
                    HL_simplify_heuristic(l),
                    meson_heuristic(l),
                    use_equality_heuristic,
                    generalize_heuristic_aderhold,
                    irrelevance_heuristic])(
          induction_heuristic)(PairList [])(
          [tm, #false]))
      ~catch Failure(_): failwith("BOYER_MOORE")

