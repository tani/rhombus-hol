#lang rhombus
// Direct translation of the pinned HOL Light Boyer_Moore/testset/arith.ml:
// the arithmetic conjectures from HOL Light's arith.ml used in the evaluation.

// The conjectures are parsed when this module is instantiated, as the
// upstream file is read after hol.ml: arith.rhm is imported to load its theory.
import:
  "../../private/hol_quote.rhm" open
  "../../arith.rhm"

export:
  mytheory

def mytheory = Box(PairList [
  @hol|{m + 0 = m}|,
  @hol|{m + (SUC n) = SUC(m + n)}|,
  @hol|{m + n = n + m}|,
  @hol|{m + (n + p) = (m + n) + p}|,
  @hol|{(m + n) + p = m + (n + p)}|,
  @hol|{(m + n = 0) <=> (m = 0) /\ (n = 0)}|,
  @hol|{(m + n = m + p) <=> (n = p)}|,
  @hol|{(m + p = n + p) <=> (m = n)}|,
  @hol|{(m + n = m) <=> (n = 0)}|,
  @hol|{(m + n = n) <=> (m = 0)}|,
  @hol|{SUC m = m + SUC(0)}|,
  @hol|{m * 0 = 0}|,
  @hol|{m * (SUC n) = m + (m * n)}|,
  @hol|{(0 * n = 0) /\ (m * 0 = 0) /\ (1 * n = n) /\ (m * 1 = m) /\ ((SUC m) * n = (m * n) + n) /\ (m * (SUC n) = m + (m * n))}|,
  @hol|{m * n = n * m}|,
  @hol|{m * (n + p) = (m * n) + (m * p)}|,
  @hol|{(m + n) * p = (m * p) + (n * p)}|,
  @hol|{m * (n * p) = (m * n) * p}|,
  @hol|{(m * n = 0) <=> (m = 0) \/ (n = 0)}|,
  @hol|{(m * n = m * p) <=> (m = 0) \/ (n = p)}|,
  @hol|{(m * p = n * p) <=> (m = n) \/ (p = 0)}|,
  @hol|{SUC(SUC(0)) * n = n + n}|,
  @hol|{(m * n = SUC(0)) <=> (m = SUC(0)) /\ (n = SUC(0))}|,
  @hol|{(m EXP n = 0) <=> (m = 0) /\ ~(n = 0)}|,
  @hol|{m EXP (n + p) = (m EXP n) * (m EXP p)}|,
  @hol|{SUC(0) EXP n = SUC(0)}|,
  @hol|{n EXP SUC(0) = n}|,
  @hol|{n EXP SUC(SUC(0)) = n * n}|,
  @hol|{(m * n) EXP p = m EXP p * n EXP p}|,
  @hol|{m EXP (n * p) = (m EXP n) EXP p}|,
  @hol|{(SUC m <= n) <=> (m < n)}|,
  @hol|{(m < SUC n) <=> (m <= n)}|,
  @hol|{(SUC m <= SUC n) <=> (m <= n)}|,
  @hol|{(SUC m < SUC n) <=> (m < n)}|,
  @hol|{0 <= n}|,
  @hol|{0 < SUC n}|,
  @hol|{n <= n}|,
  @hol|{~(n < n)}|,
  @hol|{(m <= n /\ n <= m) <=> (m = n)}|,
  @hol|{~(m < n /\ n < m)}|,
  @hol|{~(m <= n /\ n < m)}|,
  @hol|{~(m < n /\ n <= m)}|,
  @hol|{m <= n /\ n <= p ==> m <= p}|,
  @hol|{m < n /\ n < p ==> m < p}|,
  @hol|{m <= n /\ n < p ==> m < p}|,
  @hol|{m < n /\ n <= p ==> m < p}|,
  @hol|{m <= n \/ n <= m}|,
  @hol|{(m < n) \/ (n < m) \/ (m = n)}|,
  @hol|{m <= n \/ n < m}|,
  @hol|{m < n \/ n <= m}|,
  @hol|{0 < n <=> ~(n = 0)}|,
  @hol|{(m <= n) <=> (m < n) \/ (m = n)}|,
  @hol|{(m < n) <=> (m <= n) /\ ~(m = n)}|,
  @hol|{~(m <= n) <=> (n < m)}|,
  @hol|{~(m < n) <=> n <= m}|,
  @hol|{m < n ==> m <= n}|,
  @hol|{(m = n) ==> m <= n}|,
  @hol|{m <= m + n}|,
  @hol|{n <= m + n}|,
  @hol|{(m < m + n) <=> (0 < n)}|,
  @hol|{(n < m + n) <=> (0 < m)}|,
  @hol|{(m + n) <= (m + p) <=> n <= p}|,
  @hol|{(m + p) <= (n + p) <=> (m <= n)}|,
  @hol|{(m + n) < (m + p) <=> n < p}|,
  @hol|{(m + p) < (n + p) <=> (m < n)}|,
  @hol|{m <= p /\ n <= q ==> m + n <= p + q}|,
  @hol|{m <= p /\ n < q ==> m + n < p + q}|,
  @hol|{m < p /\ n <= q ==> m + n < p + q}|,
  @hol|{m < p /\ n < q ==> m + n < p + q}|,
  @hol|{(0 < m * n) <=> (0 < m) /\ (0 < n)}|,
  @hol|{m <= n /\ p <= q ==> m * p <= n * q}|,
  @hol|{~(m = 0) /\ n < p ==> m * n < m * p}|,
  @hol|{(m * n) <= (m * p) <=> (m = 0) \/ n <= p}|,
  @hol|{(m * p) <= (n * p) <=> (m <= n) \/ (p = 0)}|,
  @hol|{(m * n) < (m * p) <=> ~(m = 0) /\ n < p}|,
  @hol|{(m * p) < (n * p) <=> (m < n) /\ ~(p = 0)}|,
  @hol|{(SUC m = SUC n) <=> (m = n)}|,
  @hol|{m < n /\ p < q ==> m * p < n * q}|,
  @hol|{n <= n * n}|,
  @hol|{(P m n <=> P n m) /\ (m <= n ==> P m n) ==> P m n}|,
  @hol|{(P m m) /\ (P m n <=> P n m) /\ (m < n ==> P m n) ==> P m y}|,
  @hol|{((m < n ==> P m) ==> P n) ==> P n}|,
  @hol|{~(EVEN n) <=> ODD n}|,
  @hol|{~(ODD n) <=> EVEN n}|,
  @hol|{EVEN n \/ ODD n}|,
  @hol|{~(EVEN n /\ ODD n)}|,
  @hol|{EVEN(m + n) <=> (EVEN m <=> EVEN n)}|,
  @hol|{EVEN(m * n) <=> EVEN(m) \/ EVEN(n)}|,
  @hol|{EVEN(m EXP n) <=> EVEN(m) /\ ~(n = 0)}|,
  @hol|{ODD(m + n) <=> ~(ODD m <=> ODD n)}|,
  @hol|{ODD(m * n) <=> ODD(m) /\ ODD(n)}|,
  @hol|{ODD(m EXP n) <=> ODD(m) \/ (n = 0)}|,
  @hol|{EVEN(SUC(SUC(0)) * n)}|,
  @hol|{ODD(SUC(SUC(SUC(0)) * n))}|,
  @hol|{(0 - m = 0) /\ (m - 0 = m)}|,
  @hol|{PRE(SUC m - n) = m - n}|,
  @hol|{SUC m - SUC n = m - n}|,
  @hol|{n - n = 0}|,
  @hol|{(m + n) - n = m}|,
  @hol|{(m + n) - m = n}|,
  @hol|{(m - n = 0) <=> m <= n}|,
  @hol|{m - (m + n) = 0}|,
  @hol|{n - (m + n) = 0}|,
  @hol|{n <= m ==> ((m - n) + n = m)}|,
  @hol|{(m + n) - (m + p) = n - p}|,
  @hol|{(m + p) - (n + p) = m - n}|,
  @hol|{m * (n - p) = m * n - m * p}|,
  @hol|{(m - n) * p = m * p - n * p}|,
  @hol|{!n. SUC n - SUC(0) = n}|,
  @hol|{EVEN(m - n) <=> m <= n \/ (EVEN(m) <=> EVEN(n))}|,
  @hol|{ODD(m - n) <=> n < m /\ ~(ODD m <=> ODD n)}|,
  @hol|{0 < FACT n}|,
  @hol|{1 <= FACT n}|,
  @hol|{m <= n ==> FACT m <= FACT n}|,
  @hol|{0 < x EXP n <=> ~(x = 0) \/ (n = 0)}|,
  @hol|{x EXP m < x EXP n <=> SUC(SUC(0)) <= x /\ m < n \/ (x = 0) /\ ~(m = 0) /\ (n = 0)}|,
  @hol|{x EXP m <= x EXP n <=> if x = 0 then (m = 0) ==> (n = 0) else (x = 1) \/ m <= n}|,
  @hol|{~(p = 0) /\ m <= n ==> m DIV p <= n DIV p}|,
  @hol|{P(PRE n) <=> n = SUC m \/ m = 0 /\ n = 0 ==> P m}|
])
