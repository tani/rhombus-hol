#lang rhombus
// Direct translation of the pinned HOL Light Boyer_Moore/testset/list.ml:
// the list conjectures from HOL Light's list.ml used in the evaluation.

// The conjectures are parsed when this module is instantiated, as the
// upstream file is read after hol.ml: lists.rhm is imported to load its theory.
import:
  "../../private/hol_quote.rhm" open
  "../../lists.rhm"

export:
  mytheory2

def mytheory2 = Box(PairList [
  @hol|{(ZIP [] [] = []) /\ (ZIP (CONS h1 t1) (CONS h2 t2) = CONS (h1,h2) (ZIP t1 t2))}|,
  @hol|{~(CONS h t = [])}|,
  @hol|{(LAST [h:A] = h) /\ (LAST (CONS h (CONS k t)) = LAST (CONS k t))}|,
  @hol|{APPEND (l:A list) [] = l}|,
  @hol|{APPEND (l:A list) (APPEND m n) = APPEND (APPEND l m) n}|,
  @hol|{REVERSE (APPEND (l:A list) m) = APPEND (REVERSE m) (REVERSE l)}|,
  @hol|{REVERSE(REVERSE (l:A list)) = l}|,
  @hol|{(CONS h1 t1 = CONS h2 t2) <=> (h1 = h2) /\ (t1 = t2)}|,
  @hol|{LENGTH(APPEND (l:A list) (m:A list)) = LENGTH l + LENGTH m}|,
  @hol|{MAP (f:A->B) (APPEND l1 l2) = APPEND (MAP f l1) (MAP f l2)}|,
  @hol|{LENGTH (MAP (f:A->B) l) = LENGTH l}|,
  @hol|{(LENGTH (l:A list) = 0) <=> (l = [])}|,
  @hol|{(LENGTH l = SUC n) /\ (l = CONS h t) ==> (LENGTH t = n)}|,
  @hol|{ALL (\x. f x = g x) l ==> (MAP f l = MAP g l)}|,
  @hol|{(MEM x l /\ P x ==> Q x) /\ ALL P l ==> ALL Q l}|,
  @hol|{~(EX P l) <=> ALL (\x. ~(P x)) l}|,
  @hol|{~(ALL P l) <=> EX (\x. ~(P x)) l}|,
  @hol|{ALL P (MAP f l) <=> ALL (P o f) l}|,
  @hol|{ALL (\x. T) l}|,
  @hol|{ALL2 (\x y. f x = f y) l m ==> (MAP f l = MAP f m)}|,
  @hol|{ALL2 P (MAP f l) l <=> ALL (\a. P (f a) a) l}|,
  @hol|{ALL (\x. f(x) = x) l ==> (MAP f l = l)}|,
  @hol|{ALL2 (\x y. P x /\ Q x y) l m <=> ALL P l /\ ALL2 Q l m}|,
  @hol|{ITLIST f (APPEND l1 l2) a = ITLIST f l1 (ITLIST f l2 a)}|,
  @hol|{ITLIST f (APPEND l [a]) b = ITLIST f l (f a b)}|,
  @hol|{ALL (\x. P x ==> Q x) l /\ ALL P l ==> ALL Q l}|,
  @hol|{ALL P l /\ ALL Q l <=> ALL (\x. P x /\ Q x) l}|,
  @hol|{(MEM x l /\ P x ==> Q x) /\ EX P l ==> EX Q l}|,
  @hol|{(MEM x l ==> P x) <=> ALL P l}|,
  @hol|{LENGTH(REPLICATE n x) = n}|,
  @hol|{EX P (MAP f l) <=> EX (P o f) l}|,
  @hol|{(ALL (P x) l) <=> ALL (\s. P x s) l}|,
  @hol|{MEM x (APPEND l1 l2) <=> MEM x l1 \/ MEM x l2}|,
  @hol|{FILTER P (APPEND l1 l2) = APPEND (FILTER P l1) (FILTER P l2)}|,
  @hol|{FILTER P (MAP f l) = MAP f (FILTER (P o f) l)}|,
  @hol|{MEM x (FILTER P l) <=> P x /\ MEM x l}|,
  @hol|{(LENGTH l1 = LENGTH l2) ==> (MAP FST (ZIP l1 l2) = l1)}|,
  @hol|{(LENGTH l1 = LENGTH l2) ==> (MAP SND (ZIP l1 l2) = l2)}|,
  @hol|{MEM (x,ASSOC x l) l <=> MEM x (MAP FST l)}|,
  @hol|{ALL P (APPEND l1 l2) <=> ALL P l1 /\ ALL P l2}|,
  @hol|{n < LENGTH l ==> MEM (EL n l) l}|,
  @hol|{ALL2 P (MAP f l) (MAP g m) = ALL2 (\x y. P (f x) (g y)) l m}|,
  @hol|{ALL2 P l m /\ ALL2 Q l m <=> ALL2 (\x y. P x y /\ Q x y) l m}|,
  @hol|{ALL2 P l l <=> ALL (\x. P x x) l}|,
  @hol|{(APPEND l m = []) <=> (l = []) /\ (m = [])}|,
  @hol|{(LENGTH l = LENGTH m) ==> (LENGTH(MAP2 f l m) = LENGTH m)}|,
  @hol|{(P x ==> Q x) ==> ALL P l ==> ALL Q l}|,
  @hol|{((P:A->B->bool) x y ==> Q x y) ==> ALL2 P l l' ==> ALL2 Q l l'}|
])
