// ============================================================================
// Some auxiliary functions
// ============================================================================


// ----------------------------------------------------------------------------
// proves : thm -> term -> bool
//
// Returns true if and only if the theorem proves the term without making any
// assumptions.
// ----------------------------------------------------------------------------

fun proves(th):
  fun(tm):
    let [hyp, concl] = dest_thm(th)
    (hyp == PairList []) && (concl == tm)


// ----------------------------------------------------------------------------
// fproves : thm -> term -> bool
//
// Returns true if and only if the theorem proves the term without making any
// assumptions except _FALSITY_.
// This alternative is used for the HOL Light tactic validation.
// ----------------------------------------------------------------------------

fun fproves(th):
  fun(tm):
    let [hyp, concl] = dest_thm(th)
    (subtract(hyp)(PairList [@hol|{_FALSITY_}|]) == PairList []) && (concl == tm)


// ----------------------------------------------------------------------------
// apply_proof : proof -> term list -> proof
//
// Converts a proof into a new proof that checks that the theorems it is
// given have no hypotheses and have conclusions equal to the specified
// terms. Used to make a proof robust.
// ----------------------------------------------------------------------------

fun apply_proof(f):
  fun(tms):
    fun(ths):
      try:
        if itlist(fun([tm, th]): fun(b): fproves(th)(tm) && b)(OCamlList.combine(tms)(ths))(#true)
        | f(ths)
        | failwith("")
        ~catch Failure(_): failwith("apply_proof")


// ----------------------------------------------------------------------------
// apply_fproof : proof -> term list -> proof
//
// Converts a proof into a new proof that checks that the theorems it is
// given have no hypotheses and have conclusions equal to the specified
// terms. Used to make a proof robust.
// Ignores _FALSITY_ assumptions so as to be used in the validation of the
// HOL Light tactics.
// ----------------------------------------------------------------------------

fun apply_fproof(s):
  fun(f):
    fun(tms):
      fun(ths):
        try:
          if itlist(fun([tm, th]): fun(b): fproves(th)(tm) && b)(OCamlList.combine(tms)(ths))(#true)
          | f(ths)
          | failwith("")
          ~catch Failure(_): failwith("apply_fproof: " +& s)


// ============================================================================
// The `waterfall' for heuristics
// ============================================================================

// ----------------------------------------------------------------------------
// proof_printing : bool
//
// Assignable variable. If true, clauses are printed as they are `poured'
// over the waterfall.
// ----------------------------------------------------------------------------

def proof_printing = Box(#false)

// ----------------------------------------------------------------------------
// proof_printer : bool -> bool
//
// Function for setting the flag that controls the printing of clauses as
// are `poured' over the waterfall.
// ----------------------------------------------------------------------------

fun proof_printer(state):
  let old_state = proof_printing.value
  proof_printing.value := state
  old_state

// ----------------------------------------------------------------------------
// proof_print_depth : int
//
// Assignable variable. A number indicating the `depth' of the proof and more
// practically the number of spaces printed before a term.
// ----------------------------------------------------------------------------

def proof_print_depth = Box(0)

// ----------------------------------------------------------------------------
// inc_print_depth : * -> *
//
// Identity function that has the side-effect of incrementing the
// print_proof_depth.
// ----------------------------------------------------------------------------

fun inc_print_depth(x):
  proof_print_depth.value := proof_print_depth.value + 1
  x

// ----------------------------------------------------------------------------
// dec_print_depth : * -> *
//
// Identity function that has the side-effect of decrementing the
// print_proof_depth.
// ----------------------------------------------------------------------------

fun dec_print_depth(x):
  if proof_print_depth.value < 1
  | proof_print_depth.value := 0
    x
  | proof_print_depth.value := proof_print_depth.value - 1
    x

// ----------------------------------------------------------------------------
// proof_print_term : term -> term
//
// Identity function on terms that has the side effect of printing the term
// if the `proof_printing' flag is set to true.
// ----------------------------------------------------------------------------

fun proof_print_term(tm):
  if proof_printing.value
  | print_string(implode(replicate(" ")(proof_print_depth.value)))
    print_term(tm)
    print_newline(#void)
    tm
  | tm

fun proof_print_thm(thm):
  when proof_printing.value
  | print_thm(thm)
    print_newline(#void)
    print_newline(#void)

fun proof_print_tmi([tm, i]):
  if proof_printing.value
  | proof_print_term(tm)
    print_string(" (")
    print_bool(i)
    print_string(")")
    [tm, i]
  | [tm, i]


// let proof_print_clause cl =
//    if !proof_printing
//    then (
//          match cl with
//          | Clause_proved thm -> (print_thm thm; print_newline (); cl)
//          | _ -> cl
//         )
//    else cl;;

// ----------------------------------------------------------------------------
// proof_print_newline : * -> *
//
// Identity function that has the side effect of printing a newline if the
// `proof_printing' flag is set to true.
// ----------------------------------------------------------------------------

fun proof_print_newline(x):
  if proof_printing.value
  | print_newline(#void)
    x
  | x

fun proof_print_string(s):
  fun(x):
    if proof_printing.value
    | print_string(s)
      x
    | x

fun proof_print_string_l(s):
  fun(x):
    if proof_printing.value
    | print_string(s)
      print_newline(#void)
      x
    | x

// ----------------------------------------------------------------------------
// Recursive type for holding partly processed clauses.
//
// A clause is either still to be proved, has been proved, or can be proved
// once sub-clauses have been. A clause that is still to be proved carries a
// flag indicating whether or not it is an induction step.
// ----------------------------------------------------------------------------

variant clause_tree:
  Clause(tmi)
  Clause_proved(thm)
  Clause_split(trees, proof)

fun proof_print_clausetree(cl):
  when proof_printing.value
  | proof_print_string_l("Clause tree:")(#void)
    match cl
    | Clause([tm, bool]):
        print_term(tm)
        print_newline(#void)
    | Clause_proved(thm):
        print_thm(thm)
        print_newline(#void)
    | Clause_split(tlist, proof):
        print_string("Split -> ")
        print_int(length(tlist))
        print_newline(#void)
        let void = map(proof_print_clausetree)(tlist)
        #void

// ----------------------------------------------------------------------------
// waterfall : ((term # bool) -> ((term # bool) list # proof)) list ->
//             (term # bool) ->
//             clause_tree
//
// `Waterfall' of heuristics. Takes a list of heuristics and a term as
// arguments. Each heuristic should fail if it can do nothing with its input.
// Otherwise the heuristic should return a list of new clauses to be proved
// together with a proof of the original clause from these new clauses.
//
// Clauses that are not processed by any of the heuristics are placed in a
// leaf node of the tree, to be proved later. The heuristics are attempted in
// turn. If a heuristic returns an empty list of new clauses, the proof is
// applied to an empty list, and the resultant theorem is placed in the tree
// as a leaf node. Otherwise, the tree is split, and each of the new clauses
// is passed to ALL of the heuristics.
// ----------------------------------------------------------------------------

fun nth_tail(n):
  fun(l):
    if n > length(l)
    | PairList []
    | fun repeattl(l):
        fun(i):
          if i == 0
          | l
          | tl(repeattl(l)(i - 1))
      repeattl(l)(n)


fun waterfall(heuristics):
  fun(tmi):
    bm_steps.value := hashI(fun(k): 1 + k)(bm_steps.value)
    fun flow_on_down(rest_of_heuristics):
      fun(tmi):
        if is_F(fst(tmi))
        | failwith("cannot prove")
        | if rest_of_heuristics == PairList []
          | Clause(tmi)
          | try:
              let [tms, f] = hd(rest_of_heuristics)(tmi)
              if tms == PairList []
              | proof_print_string("Proven:")(#void)
                proof_print_thm(f(PairList []))
                Clause_proved(f(PairList []))
              | if tl(tms) == PairList []
                | Clause_split(PairList [waterfall(heuristics)(hd(tms))], f)
                | Clause_split(
                    o(o(dec_print_depth)(
                        map(o(waterfall(heuristics))(proof_print_newline))))(
                      inc_print_depth)(tms),
                    f)
              ~catch Failure(s):
                if s == "cannot prove"
                | failwith(s)
                | flow_on_down(tl(rest_of_heuristics))(tmi)
    flow_on_down(heuristics)(proof_print_tmi(tmi))


fun filtered_waterfall(heuristics):
  fun(warehouse):
    fun(tmi):
      bm_steps.value := hashI(fun(k): 1 + k)(bm_steps.value)
      if max_var_depth(fst(tmi)) > 12
      | warn(#true)("Reached maximum depth!")
        Clause(tmi)  // failwith "cannot prove"
      | let heurn:
          try:
            assoc(fst(tmi))(warehouse)
            ~catch Failure(_): 0
        let warehouse:
          if heurn > 0
          | proof_print_string("Warehouse kicking in! Skipping " +& string_of_int(heurn) +& " heuristic(s)")(#void)
            proof_print_newline(#void)
            OCamlList.remove_assoc(fst(tmi))(warehouse)
          | warehouse
        fun flow_on_down(rest_of_heuristics):
          fun(tmi):
            fun(it):
              if is_F(fst(tmi))
              | failwith("cannot prove")
              | let rest_of_heuristics = nth_tail(heurn)(rest_of_heuristics)
                if rest_of_heuristics == PairList []
                | Clause(tmi)
                | try:
                    let [tms, f] = hd(rest_of_heuristics)(tmi)
                    if tms == PairList []
                    | proof_print_string("Proven:")(#void)
                      proof_print_thm(f(PairList []))
                      Clause_proved(f(PairList []))
                    | if tl(tms) == PairList []
                      | Clause_split(PairList [filtered_waterfall(heuristics)(PairList.cons([fst(tmi), it], warehouse))(hd(tms))], f)
                      | proof_print_string(string_of_int(length(tms)) +& " new clauses")(#void)
                        proof_print_newline(#void)
                        Clause_split(
                          o(o(dec_print_depth)(
                              map(o(filtered_waterfall(heuristics)(PairList.cons([fst(tmi), it], warehouse)))(
                                    proof_print_newline))))(
                            inc_print_depth)(tms),
                          f)
                    ~catch Failure(s):
                      if s == "cannot prove"
                      | failwith(s)
                      | flow_on_down(tl(rest_of_heuristics))(tmi)(it + 1)
        flow_on_down(heuristics)(hashI(proof_print_term)(tmi))(1)

// in
//                  let fringe = fringe_of_clause_tree restree in
//                  if (fringe = []) then restree
//                  else ( waterfall_warehouse := ((fst tmi),it)::(!waterfall_warehouse) ; restree )


// ----------------------------------------------------------------------------
// fringe_of_clause_tree : clause_tree -> (term # bool) list
//
// Computes the fringe of a clause_tree, including in the resultant list only
// those clauses that remain to be proved.
// ----------------------------------------------------------------------------

fun fringe_of_clause_tree(tree):
  match tree
  | Clause(tmi): PairList [tmi]
  | Clause_proved(_): PairList []
  | Clause_split(trees, _): flat(map(fringe_of_clause_tree)(trees))

// ----------------------------------------------------------------------------
// prove_clause_tree : clause_tree -> proof
//
// Given a clause_tree, returns a proof that if given theorems for the
// unproved clauses in the tree, returns a theorem for the clause at the root
// of the tree. The list of theorems must be in the same order as the clauses
// appear in the fringe of the tree.
// ----------------------------------------------------------------------------

fun prove_clause_tree(tree):
  fun(ths):
    try:
      fun prove_clause_trees(trees):
        fun(ths):
          if trees == PairList []
          | [PairList [], ths]
          | let [th, ths_prime] = prove_clause_tree_prime(hd(trees))(ths)
            let [thl, ths_prime_prime] = prove_clause_trees(tl(trees))(ths_prime)
            [PairList.cons(th, thl), ths_prime_prime]
      fun prove_clause_tree_prime(tree):
        fun(ths):
          match tree
          | Clause([tm, _]):
              let th = hd(ths)
              if fproves(th)(tm)
              | [th, tl(ths)]
              | failwith("prove_clause_tree")
          | Clause_proved(th): [th, ths]
          | Clause_split(trees, f):
              let [thl, ths_prime] = prove_clause_trees(trees)(ths)
              [f(thl), ths_prime]
      let [th, PairList []] = prove_clause_tree_prime(tree)(ths)
      th
      ~catch Failure(_): failwith("prove_clause_tree")


fun fprove_clause_tree(tree):
  fun(ths):
    try:
      fun prove_clause_trees(trees):
        fun(ths):
          if trees == PairList []
          | [PairList [], ths]
          | let [th, ths_prime] = prove_clause_tree_prime(hd(trees))(ths)
            let [thl, ths_prime_prime] = prove_clause_trees(tl(trees))(ths_prime)
            [PairList.cons(th, thl), ths_prime_prime]
      fun prove_clause_tree_prime(tree):
        fun(ths):
          match tree
          | Clause([tm, _]):
              let th = hd(ths)
              if fproves(th)(tm)
              | [th, tl(ths)]
              | failwith("fprove_clause_tree")
          | Clause_proved(th): [th, ths]
          | Clause_split(trees, f):
              let [thl, ths_prime] = prove_clause_trees(trees)(ths)
              [f(thl), ths_prime]
      let [th, PairList []] = prove_clause_tree_prime(tree)(ths)
      th
      ~catch Failure(s): failwith("fprove_clause_tree: " +& s)

// ============================================================================
// Eliminating instances in the `pool' of clauses remaining to be proved
//
// Constructing partial orderings is probably overkill. It may only be
// necessary to split the clauses into two sets, one of most general clauses
// and the rest. This would still be computationally intensive, but it would
// avoid comparing two clauses that are both instances of some other clause.
// ============================================================================

// ----------------------------------------------------------------------------
// inst_of : term -> term -> thm -> thm
//
// Takes two terms and computes whether the first is an instance of the
// second. If this is the case, a proof of the first term from the second
// (assuming they are formulae) is returned. Otherwise the function fails.
// ----------------------------------------------------------------------------

fun inst_of(tm):
  fun(patt):
    try:
      let [_, tm_bind, ty_bind] = term_match(PairList [])(patt)(tm)
      let [insts, vars] = OCamlList.split(tm_bind)
      let f = o(o(SPECL(insts))(GENL(vars)))(INST_TYPE(ty_bind))
      fun(th): apply_fproof("inst_of")(o(f)(hd))(PairList [patt])(PairList [th])
      ~catch Failure(_): failwith("inst_of")

// ----------------------------------------------------------------------------
// Recursive datatype for a partial ordering of terms using the
// `is an instance of' relation.
//
// The leaf nodes of the tree are terms that have no instances. The other
// nodes have a list of instance trees and proofs of each instance from the
// term at that node.
//
// Each term carries a number along with it. This is used to keep track of
// where the term came from in a list. The idea is to take the fringe of a
// clause tree, number the elements, then form partial orderings so that
// only the most general theorems have to be proved.
// ----------------------------------------------------------------------------

variant inst_tree:
  No_insts(tm, n)
  Insts(tm, n, insts)

// ----------------------------------------------------------------------------
// insert_into_inst_tree : (term # int) -> inst_tree -> inst_tree
// insert_into_inst_trees : (term # int # (thm -> thm)) ->
//                          (inst_tree # (thm -> thm)) list ->
//                          (inst_tree # (thm -> thm)) list
//
// Mutually recursive functions for constructing partial orderings, ordered
// by `is an instance of' relation. The algorithm is grossly inefficient.
// Structures are repeatedly destroyed and rebuilt. Reference variables
// should be used for efficiency.
//
// Inserting into a single tree:
//
// If tm' is an instance of tm, tm is put in the root node, with the old tree
// as its single child. If tm is not an instance of tm', the function fails.
// Assume now that tm is an instance of tm'. If the tree is a leaf, it is
// made into a branch and tm is inserted as the one and only child. If the
// tree is a branch, an attempt is made to insert tm in the list of
// sub-trees. If this fails, tm is added as a leaf to the list of instances.
// Note that if tm is not an instance of tm', then it cannot be an instance
// of the instances of tm'.
//
// Inserting into a list of trees:
//
// The list of trees carry proofs with them. The list is split into those
// whose root is an instance of tm, and those whose root is not. The proof
// associated with a tree that is an instance is replaced by a proof of the
// term from tm. If the list of trees that are instances is non-empty, they
// are made children of a node containing tm, and this new tree is added to
// the list of trees that are n't instances. If tm has instances in the list,
// it cannot be the case that tm is an instance of one of the other trees in
// the list, for the trees in a list must be unrelated.
//
// If there are no instances of tm in the list of trees, an attempt is made
// to insert tm into the list. If it is unrelated to all of the trees, this
// attempt fails, in which case tm is made into a leaf and added to the list.
// ----------------------------------------------------------------------------

fun insert_into_inst_tree([tm, n]):
  fun(tree):
    match tree
    | No_insts(tm_prime, n_prime):
        try:
          let f = inst_of(tm_prime)(tm)
          Insts(tm, n, PairList [[No_insts(tm_prime, n_prime), f]])
          ~catch Failure(_):
            try:
              let f = inst_of(tm)(tm_prime)
              Insts(tm_prime, n_prime, PairList [[No_insts(tm, n), f]])
              ~catch Failure(_): failwith("insert_into_inst_tree")
    | Insts(tm_prime, n_prime, insts):
        try:
          let f = inst_of(tm_prime)(tm)
          Insts(tm, n, PairList [[Insts(tm_prime, n_prime, insts), f]])
          ~catch Failure(_):
            try:
              let f = inst_of(tm)(tm_prime)
              try:
                Insts(tm_prime, n_prime, insert_into_inst_trees([tm, n, f])(insts))
                ~catch Failure(_): Insts(tm_prime, n_prime, PairList.cons([No_insts(tm, n), f], insts))
              ~catch Failure(_): failwith("insert_into_inst_tree")
fun insert_into_inst_trees([tm, n, f]):
  fun(insts):
    fun instances([tm, n]):
      fun(insts):
        if insts == PairList []
        | [PairList [], PairList []]
        | let [not_instl, instl] = instances([tm, n])(tl(insts))
          let [h, f] = hd(insts)
          let [tm_prime, n_prime]:
            match h
            | No_insts(tm_prime, n_prime): [tm_prime, n_prime]
            | Insts(tm_prime, n_prime, _): [tm_prime, n_prime]
          try:
            let f_prime = inst_of(tm_prime)(tm)
            [not_instl, PairList.cons([h, f_prime], instl)]
            ~catch Failure(_): [PairList.cons([h, f], not_instl), instl]
    fun insert_into_inst_trees_prime([tm, n]):
      fun(trees):
        if trees == PairList []
        | failwith("insert_into_inst_trees'")
        | try:
            PairList.cons(insert_into_inst_tree([tm, n])(hd(trees)), tl(trees))
            ~catch Failure(_): PairList.cons(hd(trees), insert_into_inst_trees_prime([tm, n])(tl(trees)))
    let [not_instl, instl] = instances([tm, n])(insts)
    if instl == PairList []
    | try:
        o(lcombinep)(hashI(insert_into_inst_trees_prime([tm, n])))(OCamlList.split(insts))
        ~catch Failure(_): PairList.cons([No_insts(tm, n), f], insts)
    | PairList.cons([Insts(tm, n, instl), f], not_instl)

// ----------------------------------------------------------------------------
// mk_inst_trees : (term # int) list -> inst_tree list
//
// Constructs a partial ordering of terms under the `is an instance of'
// relation from a list of numbered terms.
//
// A dummy proof is passed to the call of insert_into_inst_trees. The result
// of the call has a proof associated with the root of each tree. These
// proofs are dummies and so are discarded before the final result is
// returned.
// ----------------------------------------------------------------------------

fun mk_inst_trees(tmnl):
  fun mk_inst_trees_prime(insts):
    fun(tmnl):
      if tmnl == PairList []
      | insts
      | let [tm, n] = hd(tmnl)
        mk_inst_trees_prime(insert_into_inst_trees([tm, n, I])(insts))(tl(tmnl))
  map(fst)(mk_inst_trees_prime(PairList [])(tmnl))

// ----------------------------------------------------------------------------
// roots_of_inst_trees : inst_tree list -> term list
//
// Computes the terms at the roots of a list of partial orderings.
// ----------------------------------------------------------------------------

fun roots_of_inst_trees(trees):
  if trees == PairList []
  | PairList []
  | let tm:
      match hd(trees)
      | No_insts(tm, _): tm
      | Insts(tm, _, _): tm
    PairList.cons(tm, roots_of_inst_trees(tl(trees)))

// ----------------------------------------------------------------------------
// prove_inst_tree : inst_tree -> thm -> (thm # int) list
//
// Given a partial ordering of terms and a theorem for its root, returns a
// list of theorems for the terms in the tree.
// ----------------------------------------------------------------------------

fun prove_inst_tree(tree):
  fun(th):
    match tree
    | No_insts(tm, n):
        if fproves(th)(tm) | PairList [[th, n]] | failwith("prove_inst_tree")
    | Insts(tm, n, insts):
        if fproves(th)(tm)
        | PairList.cons([th, n], flat(map(fun([tr, f]): prove_inst_tree(tr)(f(th)))(insts)))
        | failwith("prove_inst_tree")

// ----------------------------------------------------------------------------
// prove_inst_trees : inst_tree list -> thm list -> thm list
//
// Given a list of partial orderings of terms and a list of theorems for
// their roots, returns a sorted list of theorems for the terms in the trees.
// The sorting is done based on the integer labels attached to each term in
// the trees.
// ----------------------------------------------------------------------------

fun prove_inst_trees(trees):
  fun(ths):
    try:
      map(fst)(
        sort_on_snd(flat(map(uncurry(prove_inst_tree))(lcombinep([trees, ths])))))
      ~catch Failure(_): failwith("prove_inst_trees")

// ----------------------------------------------------------------------------
// prove_pool : conv -> term list -> thm list
//
// Attempts to prove the pool of clauses left over from the waterfall, by
// applying the conversion, conv, to the most general clauses.
// ----------------------------------------------------------------------------

fun prove_pool(conv):
  fun(tml):
    let tmnl = number_list(tml)
    let trees = mk_inst_trees(tmnl)
    let most_gen_terms = roots_of_inst_trees(trees)
    let ths = map(conv)(most_gen_terms)
    prove_inst_trees(trees)(ths)

// ============================================================================
// Boyer-Moore prover
// ============================================================================

// ----------------------------------------------------------------------------
// WATERFALL : ((term # bool) -> ((term # bool) list # proof)) list ->
//             ((term # bool) -> ((term # bool) list # proof)) ->
//             (term # bool) ->
//             thm
//
// Boyer-Moore style automatic proof procedure. Takes a list of heuristics,
// and a single heuristic that does induction, as arguments. The result is a
// function that, given a term and a Boolean, attempts to prove the term. The
// Boolean is used to indicate whether the term is the step of an induction.
// It will normally be set to false for an external call.
// ----------------------------------------------------------------------------

fun WATERFALL(heuristics):
  fun(induction):
    fun([tm, ind]):
      let conv:
        fun(tm):
          proof_print_string("Doing induction on:")(#void)
          bm_steps.value := hash(fun(k): 1 + k)(fun(k): 1 + k)(bm_steps.value)
          let void:
            proof_print_term(tm)
            proof_print_newline(#void)
          let [tmil, proof] = induction([tm, #false])
          dec_print_depth(
            proof(
              map(WATERFALL(heuristics)(induction))(inc_print_depth(tmil))))
      let void = proof_print_newline(#void)
      let tree = waterfall(heuristics)([tm, ind])
      let tmil = fringe_of_clause_tree(tree)
      let thl = prove_pool(conv)(map(fst)(tmil))
      prove_clause_tree(tree)(thl)


fun FILTERED_WATERFALL(heuristics):
  fun(induction):
    fun(warehouse):
      fun([tm, ind]):
        let conv:
          fun(tm):
            // let constr_check = ind && not((find_bm_terms (fun t -> count_constructors t > 5) tm) = []) in
            let constr_check = max_var_depth(tm) > 12
            if constr_check
            | let void = warn(#true)("Reached maximum depth!")
              failwith("cannot prove")
            | let heurn:
                try:
                  assoc(tm)(warehouse)
                  ~catch Failure(_): 0
              let warehouse:
                if heurn > 0 | OCamlList.remove_assoc(tm)(warehouse) | warehouse
              if heurn > length(heuristics)
              | warn(#true)("Induction loop detected.")
                failwith("cannot prove")
              | proof_print_string("Doing induction on:")(#void)
              bm_steps.value := hash(fun(k): 1 + k)(fun(k): 1 + k)(bm_steps.value)
              let void:
                proof_print_term(tm)
                proof_print_newline(#void)
              let [tmil, proof] = induction([tm, #false])
              dec_print_depth(
                proof(
                  map(FILTERED_WATERFALL(heuristics)(induction)(
                        PairList.cons([tm, length(heuristics) + 1], warehouse)))(
                    inc_print_depth(tmil))))
        let void = proof_print_newline(#void)
        let tree = filtered_waterfall(heuristics)(PairList [])([tm, ind])
        //   in  let void = proof_print_clausetree tree
        let tmil = fringe_of_clause_tree(tree)
        let thl = prove_pool(conv)(map(fst)(tmil))
        prove_clause_tree(tree)(thl)

// ============================================================================
// Some sample heuristics
// ============================================================================

// ----------------------------------------------------------------------------
// conjuncts_heuristic : (term # bool) -> ((term # bool) list # proof)
//
// `Heuristic' for splitting a conjunction into a list of conjuncts.
// Right conjuncts are split recursively.
// Fails if the argument term is not a conjunction.
// ----------------------------------------------------------------------------

fun conjuncts_heuristic([tm, i]):
  let tms = conj_list(tm)
  if length(tms) == 1
  | failwith("conjuncts_heuristic")
  | [map(fun(tm): [tm, i])(tms), apply_fproof("conjuncts_heuristic")(LIST_CONJ)(tms)]

// ----------------------------------------------------------------------------
// refl_heuristic : (term # bool) -> ((term # bool) list # proof)
//
// `Heuristic' for proving that terms of the form "x = x" are true. Fails if
// the argument term is not of this form. Otherwise it returns an empty list
// of new clauses, and a proof of the original term.
// ----------------------------------------------------------------------------

fun refl_heuristic([tm, i]):
  try:
    if lhs(tm) == rhs(tm)
    | [PairList [], apply_fproof("refl_heuristic")(fun(ths): REFL(lhs(tm)))(PairList [])]
    | failwith("")
    ~catch Failure(_): failwith("refl_heuristic")

// ----------------------------------------------------------------------------
// clausal_form_heuristic : (term # bool) -> ((term # bool) list # proof)
//
// `Heuristic' that tests a term to see if it is in clausal form, and if not
// converts it to clausal form and returns the resulting clauses as new
// `goals'. It is critical for efficiency that the normalization is only done
// if the term is not in clausal form. Note that the functions `conjuncts'
// and `disjuncts' are not used for the testing because they split trees of
// conjuncts (disjuncts) rather than simply `linear' con(dis)junctions.
// If the term is in clausal form, but is not a single clause, it is split
// into single clauses. If the term is in clausal form but contains Boolean
// constants, the normalizer is applied to it. A single new goal will be
// produced in this case unless the result of the normalization was true.
// ----------------------------------------------------------------------------

fun clausal_form_heuristic([tm, i]):
  try:
    let is_atom:
      fun(tm):
        (!has_boolean_args_and_result(tm)) || is_var(tm) || is_const(tm)
    let is_literal:
      fun(tm):
        is_atom(tm) || (is_neg(tm) && (try:
                                         is_atom(rand(tm))
                                         ~catch Failure(_): #false))
    let is_clause = fun(tm): forall(is_literal)(disj_list(tm))
    let result_string:
      fun(tms):
        let s = length(tms)
        let plural = if s == 1 | "" | "s"
        "-> Clausal Form Heuristic (" +& string_of_int(s) +& " clause" +& plural +& ")"
    if forall(is_clause)(conj_list(tm)) && \
         (!free_in(@hol|{T}|)(tm)) && (!free_in(@hol|{F}|)(tm))
    | if is_conj(tm)
      | let tms = conj_list(tm)
        proof_print_string_l(result_string(tms))(#void)
        [map(fun(tm): [tm, i])(tms), apply_fproof("clausal_form_heuristic")(LIST_CONJ)(tms)]
      | failwith("")
    | let th = CLAUSAL_FORM_CONV(tm)
      let tm_prime = rhs(concl(th))
      if is_T(tm_prime)
      | proof_print_string_l("-> Clausal Form Heuristic")(#void)
        [PairList [], apply_fproof("clausal_form_heuristic")(fun(_): EQT_ELIM(th))(PairList [])]
      | let tms = conj_list(tm_prime)
        proof_print_string_l(result_string(tms))(#void)
        [map(fun(tm): [tm, i])(tms),
         apply_fproof("clausal_form_heuristic")(o(EQ_MP(SYM(th)))(LIST_CONJ))(tms)]
    ~catch Failure(_): failwith("clausal_form_heuristic")

fun meson_heuristic(l):
  fun([tm, i]):
    try:
      let meth = MESON(append(l)(rewrite_rules(#void)))(tm)
      [PairList [], apply_fproof("meson_heuristic")(fun(ths): meth)(PairList [])]
      ~catch Failure(_): failwith("meson_heuristic")

fun taut_heuristic([tm, i]):
  try:
    let tautthm = TAUT(tm)
    proof_print_string_l("-> Tautology Heuristic")(#void)
    [PairList [], apply_fproof("taut_heuristic")(fun(ths): tautthm)(PairList [])]
    ~catch Failure(_): failwith("taut_heuristic")

fun setify_heuristic([tm, i]):
  try:
    if !is_disj(tm)
    | failwith("")
    | let tms = disj_list(tm)
      let tms_prime = setify(tms)
      let tm_prime = list_mk_disj(tms_prime)
      if length(tms) == length(tms_prime)
      | failwith("")
      | let th = TAUT(mk_imp([tm_prime, tm]))
        proof_print_string_l("-> Setify Heuristic")(#void)
        [PairList [[tm_prime, i]], apply_fproof("setify_heuristic")(o(MP(th))(hd))(PairList [tm_prime])]
    ~catch Failure(_): failwith("setify_heuristic")
