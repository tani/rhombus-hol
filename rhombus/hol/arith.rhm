              [App(Const("+", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])]
            )
          )
        )
      )),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD]))
    ]
  )

def ADD_CLAUSES:
  prove(
    [
      Host.hol_term(And(
        Forall(
          "n",
          Num,
          Eq(
            Num,
            App(
              Const("+", Fun(Num, Fun(Num, Num))),
              [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]), Ref("n")]
            ),
            Ref("n")
          )
        ),
        And(
          Forall(
            "m",
            Num,
            Eq(
              Num,
              App(
                Const("+", Fun(Num, Fun(Num, Num))),
                [Ref("m"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              ),
              Ref("m")
            )
          ),
          And(
            Forall(
              "m",
              Num,
              Forall(
                "n",
                Num,
                Eq(
                  Num,
                  App(
                    Const("+", Fun(Num, Fun(Num, Num))),
                    [App(Const("SUC", Fun(Num, Num)), [Ref("m")]), Ref("n")]
                  ),
                  App(
                    Const("SUC", Fun(Num, Num)),
                    [App(Const("+", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])]
                  )
                )
              )
            ),
            Forall(
              "m",
              Num,
              Forall(
                "n",
                Num,
                Eq(
                  Num,
                  App(
                    Const("+", Fun(Num, Fun(Num, Num))),
                    [Ref("m"), App(Const("SUC", Fun(Num, Num)), [Ref("n")])]
                  ),
                  App(
                    Const("SUC", Fun(Num, Num)),
                    [App(Const("+", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])]
                  )
                )
              )
            )
          )
        )
      )),
      REWRITE_TAC(PairList [ADD, ADD_0, ADD_SUC])
    ]
  )

