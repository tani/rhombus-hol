,[\"Tyapp\",\"num\",[]]]]]],[\"Comb\",[\"Const\",\"SUC\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"+\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]],[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]]]]]]]]]"),Simp.REWRITE_TAC(PairList.cons(ADD,PairList.cons(ADD_0,PairList.cons(ADD_SUC,PairList []))))))
