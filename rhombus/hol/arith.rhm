              Var("<=", Fun(Num, Fun(Num, Bool))),
              [Ref("m"), App(Const("SUC", Fun(Num, Num)), [Ref("n")])]
            ),
            Or(
              Eq(Num, Ref("m"), App(Const("SUC", Fun(Num, Num)), [Ref("n")])),
              App(Var("<=", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")])
            )
          )
        )
      )
    ))
  )

