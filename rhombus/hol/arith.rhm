              ASM_SIMP_TAC(PairList [EXP_ADD, MOD_MOD, MULT_EQ_0, EXP_EQ_0])
            ]
          )
        ]
      )
    ]
  )

def [arith_DIV_EXP_v2, MOD_EXP]:
  o(CONJ_PAIR)(prove)(
    [
      (hol:
         const DIV :: num -> num -> num
         const EXP :: num -> num -> num
         const MOD :: num -> num -> num
         (forall (m :: num, n :: num, p :: num):
            m != (0 :: num)
              ==> (DIV(EXP(m, n), EXP(m, p))
                     == (if p <= n | EXP(m, n - p) | (if m == (1 :: num) | (1 :: num) | (0 :: num)))))
           && (forall (m :: num, n :: num, p :: num):
                 m != (0 :: num)
                   ==> (MOD(EXP(m, n), EXP(m, p))
                          == (if p <= n || m == (1 :: num) | (0 :: num) | EXP(m, n))))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (REWRITE_TAC(PairList [AND_FORALL_THM]) then_tac REPEAT(GEN_TAC)) then_tac \
                        ASM_CASES_TAC(
                          (hol:
                             var m :: num
                             m == (0 :: num))
                        )
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_tac \
                    MATCH_MP_TAC(DIVMOD_UNIQ)
                  ) then_tac \
                  ASM_CASES_TAC(hol:
                                  var p :: num
                                  var n :: num
                                  p <= n)
                ) then_tac \
                ASM_SIMP_TAC(PairList [GSYM(EXP_ADD), EXP_LT_0, SUB_ADD, ADD_CLAUSES])
              ) then_tac \
              ASM_CASES_TAC(
                (hol:
                   var m :: num
                   m == (1 :: num))
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [EXP_ONE, ADD_CLAUSES, MULT_CLAUSES, LT_EXP])
          ) then_tac \
          REWRITE_TAC(PairList [LT, GSYM(NOT_LT), ONE, TWO])
        ) then_tac \
        ASM_REWRITE_TAC(PairList [SYM(ONE), GSYM(NOT_LE)])
      )
    ]
  )

