  new_definition(
    Host.hol_term(Eq(
      Num,
      App(Var("minimal", Fun(Fun(Num, Bool), Num)), [Var("P", Fun(Num, Bool))]),
      App(
        Const("@", Fun(Fun(Num, Bool), Num)),
        [
          Lambda(
            "n",
            Num,
            And(
              App(Var("P", Fun(Num, Bool)), [Ref("n")]),
              Forall(
                "m",
                Num,
                Implies(
                  App(Const("<", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")]),
                  Not(App(Var("P", Fun(Num, Bool)), [Ref("m")]))
                )
              )
            )
          )
        ]
      )
    ))
  )

def MINIMAL:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Num, Bool),
        Iff(
          Exists("n", Num, App(Ref("P"), [Ref("n")])),
          And(
            App(Ref("P"), [App(Const("minimal", Fun(Fun(Num, Bool), Num)), [Ref("P")])]),
            Forall(
              "m",
              Num,
              Implies(
                App(
