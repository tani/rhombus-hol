def PRE:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var PRE :: num -> num
       const SUC :: num -> num
       PRE((0 :: num)) == (0 :: num) && (forall n :: num: PRE(SUC(n)) == n))
  )

def ADD:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var #{+} :: num -> num -> num
       const SUC :: num -> num
       (forall n :: num: var.#{+}((0 :: num), n) == n)
         && (forall (m :: num, n :: num): var.#{+}(SUC(m), n) == SUC(var.#{+}(m, n))))
  )

def ADD_0:
  prove(
    [
      (hol:
         forall m :: num: m + (0 :: num) == m),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD]))
    ]
  )

def ADD_SUC:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall (m :: num, n :: num): m + SUC(n) == SUC(m + n)),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD]))
    ]
  )

def ADD_CLAUSES:
  prove(
    [
      (hol:
         const SUC :: num -> num
         (forall n :: num: (0 :: num) + n == n)
           && ((forall m :: num: m + (0 :: num) == m)
                 && ((forall (m :: num, n :: num): SUC(m) + n == SUC(m + n))
                       && (forall (m :: num, n :: num): m + SUC(n) == SUC(m + n))))),
      REWRITE_TAC(PairList [ADD, ADD_0, ADD_SUC])
    ]
  )

def ADD_SYM:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m + n == n + m),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES]))
    ]
  )

def ADD_ASSOC:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m + (n + p) == m + n + p),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES]))
    ]
  )

def ADD_AC:
  prove(
    [
      (hol:
         var m :: num
         var n :: num
         var p :: num
         m + n == n + m && (m + n + p == m + (n + p) && m + (n + p) == n + (m + p))),
      MESON_TAC(PairList [ADD_ASSOC, ADD_SYM])
    ]
  )

def ADD_EQ_0:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m + n == (0 :: num) <=> m == (0 :: num) && n == (0 :: num)),
      (REPEAT(INDUCT_TAC) then_tac REWRITE_TAC(PairList [ADD_CLAUSES, NOT_SUC]))
    ]
  )

def EQ_ADD_LCANCEL:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m + n == m + p <=> n == p),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES, SUC_INJ]))
    ]
  )

def EQ_ADD_RCANCEL:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m + p == n + p <=> m == n),
      (ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(EQ_ADD_LCANCEL))
    ]
  )

def EQ_ADD_LCANCEL_0:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m + n == m <=> n == (0 :: num)),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES, SUC_INJ]))
    ]
  )

def EQ_ADD_RCANCEL_0:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m + n == n <=> m == (0 :: num)),
      (ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(EQ_ADD_LCANCEL_0))
    ]
  )

def BIT0:
  prove(
    [
      (hol:
         const BIT0 :: num -> num
         forall n :: num: BIT0(n) == n + n),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [BIT0_DEF, ADD_CLAUSES]))
    ]
  )

def BIT1:
  prove(
    [
      (hol:
         const BIT1 :: num -> num
         const SUC :: num -> num
         forall n :: num: BIT1(n) == SUC(n + n)),
      REWRITE_TAC(PairList [BIT1_DEF, BIT0])
    ]
  )

def BIT0_THM:
  prove(
    [
      (hol:
         const NUMERAL :: num -> num
         const BIT0 :: num -> num
         forall n :: num: NUMERAL(BIT0(n)) == NUMERAL(n) + NUMERAL(n)),
      REWRITE_TAC(PairList [NUMERAL, BIT0])
    ]
  )

def BIT1_THM:
  prove(
    [
      (hol:
         const NUMERAL :: num -> num
         const BIT1 :: num -> num
         const SUC :: num -> num
         forall n :: num: NUMERAL(BIT1(n)) == SUC(NUMERAL(n) + NUMERAL(n))),
      REWRITE_TAC(PairList [NUMERAL, BIT1])
    ]
  )

def ONE:
  prove(
    [
      (hol:
         const SUC :: num -> num
         (1 :: num) == SUC((0 :: num))),
      REWRITE_TAC(PairList [BIT1, REWRITE_RULE(PairList [NUMERAL])(ADD_CLAUSES), NUMERAL])
    ]
  )

def TWO:
  prove(
    [
      (hol:
         const SUC :: num -> num
         (2 :: num) == SUC((1 :: num))),
      REWRITE_TAC(PairList [BIT0, BIT1, REWRITE_RULE(PairList [NUMERAL])(ADD_CLAUSES), NUMERAL])
    ]
  )

def ADD1:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall m :: num: SUC(m) == m + (1 :: num)),
      REWRITE_TAC(PairList [BIT1_THM, ADD_CLAUSES])
    ]
  )

def MULT:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var #{*} :: num -> num -> num
       const SUC :: num -> num
       (forall n :: num: var.#{*}((0 :: num), n) == (0 :: num))
         && (forall (m :: num, n :: num): var.#{*}(SUC(m), n) == var.#{*}(m, n) + n))
  )

def MULT_0:
  prove(
    [
      (hol:
         forall m :: num: m * (0 :: num) == (0 :: num)),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MULT, ADD_CLAUSES]))
    ]
  )

def MULT_SUC:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall (m :: num, n :: num): m * SUC(n) == m + m * n),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MULT, ADD_CLAUSES, ADD_ASSOC]))
    ]
  )

def MULT_CLAUSES:
  prove(
    [
      (hol:
         const SUC :: num -> num
         (forall n :: num: (0 :: num) * n == (0 :: num))
           && ((forall m :: num: m * (0 :: num) == (0 :: num))
                 && ((forall n :: num: (1 :: num) * n == n)
                       && ((forall m :: num: m * (1 :: num) == m)
                             && ((forall (m :: num, n :: num): SUC(m) * n == m * n + n)
                                   && (forall (m :: num, n :: num): m * SUC(n) == m + m * n)))))),
      REWRITE_TAC(PairList [BIT1_THM, MULT, MULT_0, MULT_SUC, ADD_CLAUSES])
    ]
  )

def MULT_SYM:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m * n == n * m),
      (
        INDUCT_TAC then_tac \
        ASM_REWRITE_TAC(PairList [MULT_CLAUSES, EQT_INTRO(SPEC_ALL(ADD_SYM))])
      )
    ]
  )

def LEFT_ADD_DISTRIB:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m * (n + p) == m * n + m * p),
      (
        (GEN_TAC then_tac INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [ADD, MULT_CLAUSES, ADD_ASSOC])
      )
    ]
  )

def RIGHT_ADD_DISTRIB:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): (m + n) * p == m * p + n * p),
      (ONCE_REWRITE_TAC(PairList [MULT_SYM]) then_tac MATCH_ACCEPT_TAC(LEFT_ADD_DISTRIB))
    ]
  )

def MULT_ASSOC:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m * (n * p) == m * n * p),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MULT_CLAUSES, RIGHT_ADD_DISTRIB]))
    ]
  )

def MULT_AC:
  prove(
    [
      (hol:
         var m :: num
         var n :: num
         var p :: num
         m * n == n * m && (m * n * p == m * (n * p) && m * (n * p) == n * (m * p))),
      MESON_TAC(PairList [MULT_ASSOC, MULT_SYM])
    ]
  )

def MULT_EQ_0:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m * n == (0 :: num) <=> m == (0 :: num) || n == (0 :: num)),
      (
        REPEAT(INDUCT_TAC) then_tac \
        REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, NOT_SUC])
      )
    ]
  )

def EQ_MULT_LCANCEL:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m * n == m * p <=> m == (0 :: num) || n == p),
      (
        (
          (
            (INDUCT_TAC then_tac REWRITE_TAC(PairList [MULT_CLAUSES, NOT_SUC])) then_tac \
            REPEAT(INDUCT_TAC)
          ) then_tac \
          ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, GSYM(NOT_SUC), NOT_SUC])
        ) then_tac \
        ASM_REWRITE_TAC(PairList [SUC_INJ, GSYM(ADD_ASSOC), EQ_ADD_LCANCEL])
      )
    ]
  )

def EQ_MULT_RCANCEL:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m * p == n * p <=> m == n || p == (0 :: num)),
      (
        ONCE_REWRITE_TAC(PairList [MULT_SYM, DISJ_SYM]) then_tac \
        MATCH_ACCEPT_TAC(EQ_MULT_LCANCEL)
      )
    ]
  )

def MULT_2:
  prove(
    [
      (hol:
         forall n :: num: (2 :: num) * n == n + n),
      (GEN_TAC then_tac REWRITE_TAC(PairList [BIT0_THM, MULT_CLAUSES, RIGHT_ADD_DISTRIB]))
    ]
  )

def MULT_EQ_1:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m * n == (1 :: num) <=> m == (1 :: num) && n == (1 :: num)),
      (
        (
          (
            (INDUCT_TAC then_tac INDUCT_TAC) then_tac \
            REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, BIT0_THM, BIT1_THM, GSYM(NOT_SUC)])
          ) then_tac \
          REWRITE_TAC(PairList [SUC_INJ, ADD_EQ_0, MULT_EQ_0])
        ) then_tac \
        CONV_TAC(TAUT)
      )
    ]
  )

def EXP:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var EXP :: num -> num -> num
       const SUC :: num -> num
       (forall m :: num: EXP(m, (0 :: num)) == (1 :: num))
         && (forall (m :: num, n :: num): EXP(m, SUC(n)) == m * EXP(m, n)))
  )

def EXP_EQ_0:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall (m :: num, n :: num): EXP(m, n) == (0 :: num) <=> m == (0 :: num) && n != (0 :: num)),
      (
        REPEAT(INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [BIT1_THM, NOT_SUC, NOT_SUC, EXP, MULT_CLAUSES, ADD_CLAUSES, ADD_EQ_0])
      )
    ]
  )

def EXP_EQ_1:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall (x :: num, n :: num): EXP(x, n) == (1 :: num) <=> x == (1 :: num) || n == (0 :: num)),
      (
        (
          (GEN_TAC then_tac INDUCT_TAC) then_tac \
          ASM_REWRITE_TAC(PairList [EXP, MULT_EQ_1, NOT_SUC])
        ) then_tac \
        CONV_TAC(TAUT)
      )
    ]
  )

def EXP_ZERO:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall n :: num: EXP((0 :: num), n) == (if n == (0 :: num) | (1 :: num) | (0 :: num))),
      (
        (GEN_TAC then_tac COND_CASES_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [EXP_EQ_0, EXP_EQ_1])
      )
    ]
  )

def EXP_ADD:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall (m :: num, n :: num, p :: num): EXP(m, n + p) == EXP(m, n) * EXP(m, p)),
      (
        ((GEN_TAC then_tac GEN_TAC) then_tac INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [EXP, ADD_CLAUSES, MULT_CLAUSES, MULT_AC])
      )
    ]
  )

def EXP_ONE:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall n :: num: EXP((1 :: num), n) == (1 :: num)),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EXP, MULT_CLAUSES]))
    ]
  )

def EXP_1:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall n :: num: EXP(n, (1 :: num)) == n),
      REWRITE_TAC(PairList [ONE, EXP, MULT_CLAUSES, ADD_CLAUSES])
    ]
  )

def EXP_2:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall n :: num: EXP(n, (2 :: num)) == n * n),
      REWRITE_TAC(PairList [BIT0_THM, BIT1_THM, EXP, EXP_ADD, MULT_CLAUSES, ADD_CLAUSES])
    ]
  )

def MULT_EXP:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall (p :: num, m :: num, n :: num): EXP(m * n, p) == EXP(m, p) * EXP(n, p)),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EXP, MULT_CLAUSES, MULT_AC]))
    ]
  )

def EXP_MULT:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall (m :: num, n :: num, p :: num): EXP(m, n * p) == EXP(EXP(m, n), p)),
      (
        (
          (GEN_TAC then_tac INDUCT_TAC) then_tac \
          ASM_REWRITE_TAC(PairList [EXP_ADD, EXP, MULT_CLAUSES])
        ) then_list \
        PairList [
          (
            (CONV_TAC(ONCE_DEPTH_CONV(SYM_CONV)) then_tac INDUCT_TAC) then_tac \
            ASM_REWRITE_TAC(PairList [EXP, MULT_CLAUSES])
          ),
          (REWRITE_TAC(PairList [MULT_EXP]) then_tac MATCH_ACCEPT_TAC(MULT_SYM))
        ]
      )
    ]
  )

def EXP_EXP:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall (x :: num, m :: num, n :: num): EXP(EXP(x, m), n) == EXP(x, m * n)),
      REWRITE_TAC(PairList [EXP_MULT])
    ]
  )

def LE:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var #{<=} :: num -> num -> bool
       const SUC :: num -> num
       (forall m :: num: var.#{<=}(m, (0 :: num)) <=> m == (0 :: num))
         && (forall (m :: num, n :: num): var.#{<=}(m, SUC(n)) <=> m == SUC(n) || var.#{<=}(m, n)))
  )

def LT:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var #{<} :: num -> num -> bool
       const SUC :: num -> num
       (forall m :: num: var.#{<}(m, (0 :: num)) <=> #false)
         && (forall (m :: num, n :: num): var.#{<}(m, SUC(n)) <=> m == n || var.#{<}(m, n)))
  )

def GE:
  new_definition(
    (hol:
       var #{>=} :: num -> num -> bool
       var m :: num
       var n :: num
       var.#{>=}(m, n) <=> n <= m)
  )

def GT:
  new_definition(
    (hol:
       var #{>} :: num -> num -> bool
       var m :: num
       var n :: num
       var.#{>}(m, n) <=> n < m)
  )

def MAX:
  new_definition(
    (hol:
       var MAX :: num -> num -> num
       forall (m :: num, n :: num): MAX(m, n) == (if m <= n | n | m))
  )

def MIN:
  new_definition(
    (hol:
       var MIN :: num -> num -> num
       forall (m :: num, n :: num): MIN(m, n) == (if m <= n | m | n))
  )

def LE_SUC_LT:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall (m :: num, n :: num): SUC(m) <= n <=> m < n),
      (
        (GEN_TAC then_tac INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [LE, LT, NOT_SUC, SUC_INJ])
      )
    ]
  )

def LT_SUC_LE:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall (m :: num, n :: num): m < SUC(n) <=> m <= n),
      (
        (
          ((GEN_TAC then_tac INDUCT_TAC) then_tac ONCE_REWRITE_TAC(PairList [LT, LE])) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        REWRITE_TAC(PairList [LT])
      )
    ]
  )

def LE_SUC:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall (m :: num, n :: num): SUC(m) <= SUC(n) <=> m <= n),
      REWRITE_TAC(PairList [LE_SUC_LT, LT_SUC_LE])
    ]
  )

def LT_SUC:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall (m :: num, n :: num): SUC(m) < SUC(n) <=> m < n),
      REWRITE_TAC(PairList [LT_SUC_LE, LE_SUC_LT])
    ]
  )

def LE_0:
  prove(
    [
      (hol:
         forall n :: num: (0 :: num) <= n),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [LE]))
    ]
  )

def LT_0:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall n :: num: (0 :: num) < SUC(n)),
      REWRITE_TAC(PairList [LT_SUC_LE, LE_0])
    ]
  )

def LE_REFL:
  prove(
    [
      (hol:
         forall n :: num: n <= n),
      (INDUCT_TAC then_tac REWRITE_TAC(PairList [LE]))
    ]
  )

def LT_REFL:
  prove(
    [
      (hol:
         forall n :: num: !(n < n)),
      (
        (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [LT_SUC])) then_tac \
        REWRITE_TAC(PairList [LT])
      )
    ]
  )

def LT_IMP_NE:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m < n ==> m != n),
      MESON_TAC(PairList [LT_REFL])
    ]
  )

def LE_ANTISYM:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m <= n && n <= m <=> m == n),
      (
        (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, SUC_INJ])) then_tac \
        REWRITE_TAC(PairList [LE, NOT_SUC, GSYM(NOT_SUC)])
      )
    ]
  )

def LT_ANTISYM:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): !(m < n && n < m)),
      (
        (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LT_SUC])) then_tac \
        REWRITE_TAC(PairList [LT])
      )
    ]
  )

def LET_ANTISYM:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): !(m <= n && n < m)),
      (
        (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC])) then_tac \
        REWRITE_TAC(PairList [LE, LT, NOT_SUC])
      )
    ]
  )

def LTE_ANTISYM:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): !(m < n && n <= m)),
      (
        ONCE_REWRITE_TAC(PairList [CONJ_SYM]) then_tac \
        REWRITE_TAC(PairList [LET_ANTISYM])
      )
    ]
  )

def LE_TRANS:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m <= n && n <= p ==> m <= p),
      (
        (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LE_0])) then_tac \
        REWRITE_TAC(PairList [LE, NOT_SUC])
      )
    ]
  )

def LT_TRANS:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m < n && n < p ==> m < p),
      (
        (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LT_SUC, LT_0])) then_tac \
        REWRITE_TAC(PairList [LT, NOT_SUC])
      )
    ]
  )

def LET_TRANS:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m <= n && n < p ==> m < p),
      (
        (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC, LT_0])) then_tac \
        REWRITE_TAC(PairList [LT, LE, NOT_SUC])
      )
    ]
  )

def LTE_TRANS:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m < n && n <= p ==> m < p),
      (
        (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC, LT_0])) then_tac \
        REWRITE_TAC(PairList [LT, LE, NOT_SUC])
      )
    ]
  )

def LE_CASES:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m <= n || n <= m),
      (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_0, LE_SUC]))
    ]
  )

def LT_CASES:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m < n || (n < m || m == n)),
      (
        (
          (
            (
              (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LT_SUC, SUC_INJ])) then_tac \
              REWRITE_TAC(PairList [LT, NOT_SUC, GSYM(NOT_SUC)])
            ) then_tac \
            W(o(o(o(W(curry(SPEC_TAC)))(hd))(frees))(snd))
          ) then_tac \
          INDUCT_TAC
        ) then_tac \
        REWRITE_TAC(PairList [LT_0])
      )
    ]
  )

def LET_CASES:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m <= n || n < m),
      (
        REPEAT(INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [LE_SUC_LT, LT_SUC_LE, LE_0])
      )
    ]
  )

def LTE_CASES:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m < n || n <= m),
      (ONCE_REWRITE_TAC(PairList [DISJ_SYM]) then_tac MATCH_ACCEPT_TAC(LET_CASES))
    ]
  )

def LE_LT:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m <= n <=> m < n || m == n),
      (
        (
          REPEAT(INDUCT_TAC) then_tac \
          ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC, SUC_INJ, LE_0, LT_0])
        ) then_tac \
        REWRITE_TAC(PairList [LE, LT])
      )
    ]
  )

def LT_LE:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m < n <=> m <= n && m != n),
      (
        (
          (REWRITE_TAC(PairList [LE_LT]) then_tac REPEAT(GEN_TAC)) then_tac \
          EQ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (DISCH_TAC then_tac ASM_REWRITE_TAC(PairList [])) then_tac \
                DISCH_THEN(SUBST_ALL_TAC)
              ) then_tac \
              POP_ASSUM(MP_TAC)
            ) then_tac \
            REWRITE_TAC(PairList [LT_REFL])
          ),
          (
            DISCH_THEN(CONJUNCTS_THEN2(STRIP_ASSUME_TAC)(MP_TAC)) then_tac \
            ASM_REWRITE_TAC(PairList [])
          )
        ]
      )
    ]
  )

def NOT_LE:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): !(m <= n) <=> n < m),
      (
        (
          (
            (
              (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC])) then_tac \
              REWRITE_TAC(PairList [LE, LT, NOT_SUC, GSYM(NOT_SUC), LE_0])
            ) then_tac \
            W(o(o(o(W(curry(SPEC_TAC)))(hd))(frees))(snd))
          ) then_tac \
          INDUCT_TAC
        ) then_tac \
        REWRITE_TAC(PairList [LT_0])
      )
    ]
  )

def NOT_LT:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): !(m < n) <=> n <= m),
      (
        (
          (
            (
              (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC])) then_tac \
              REWRITE_TAC(PairList [LE, LT, NOT_SUC, GSYM(NOT_SUC), LE_0])
            ) then_tac \
            W(o(o(o(W(curry(SPEC_TAC)))(hd))(frees))(snd))
          ) then_tac \
          INDUCT_TAC
        ) then_tac \
        REWRITE_TAC(PairList [LT_0])
      )
    ]
  )

def LT_IMP_LE:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m < n ==> m <= n),
      (
        (REWRITE_TAC(PairList [LT_LE]) then_tac REPEAT(STRIP_TAC)) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def EQ_IMP_LE:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m == n ==> m <= n),
      (REPEAT(STRIP_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_REFL]))
    ]
  )

def LT_NZ:
  prove(
    [
      (hol:
         forall n :: num: (0 :: num) < n <=> n != (0 :: num)),
      (
        (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [NOT_SUC, LT, EQ_SYM_EQ])) then_tac \
        CONV_TAC(TAUT)
      )
    ]
  )

def LE_1:
  prove(
    [
      (hol:
         (forall n :: num: n != (0 :: num) ==> (0 :: num) < n)
           && ((forall n :: num: n != (0 :: num) ==> (1 :: num) <= n)
                 && ((forall n :: num: (0 :: num) < n ==> n != (0 :: num))
                       && ((forall n :: num: (0 :: num) < n ==> (1 :: num) <= n)
                             && ((forall n :: num: (1 :: num) <= n ==> (0 :: num) < n)
                                   && (forall n :: num: (1 :: num) <= n ==> n != (0 :: num))))))),
      REWRITE_TAC(PairList [LT_NZ, GSYM(NOT_LT), ONE, LT])
    ]
  )

def LE_EXISTS:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m <= n <=> (exists d :: num: n == m + d)),
      (
        ((GEN_TAC then_tac INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE])) then_list \
        PairList [
          (
            REWRITE_TAC(PairList [CONV_RULE(LAND_CONV(SYM_CONV))(SPEC_ALL(ADD_EQ_0))]) then_tac \
            REWRITE_TAC(PairList [RIGHT_EXISTS_AND_THM, EXISTS_REFL])
          ),
          (
            EQ_TAC then_list \
            PairList [
              (
                DISCH_THEN(DISJ_CASES_THEN2(SUBST1_TAC)(MP_TAC)) then_list \
                PairList [
                  (
                    EXISTS_TAC(hol:
                                 (0 :: num)) then_tac \
                    REWRITE_TAC(PairList [ADD_CLAUSES])
                  ),
                  (
                    (
                      DISCH_THEN(X_CHOOSE_THEN(hol: var d :: num; d)(SUBST1_TAC)) then_tac \
                      EXISTS_TAC(hol:
                                   var d :: num
                                   const SUC :: num -> num
                                   SUC(d))
                    ) then_tac \
                    REWRITE_TAC(PairList [ADD_CLAUSES])
                  )
                ]
              ),
              (
                (
                  (
                    (
                      (
                        (ONCE_REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac INDUCT_TAC) then_tac \
                        REWRITE_TAC(PairList [ADD_CLAUSES, SUC_INJ])
                      ) then_tac \
                      DISCH_THEN(SUBST1_TAC)
                    ) then_tac \
                    REWRITE_TAC(PairList [])
                  ) then_tac \
                  DISJ2_TAC
                ) then_tac \
                REWRITE_TAC(PairList [EQ_ADD_LCANCEL, GSYM(EXISTS_REFL)])
              )
            ]
          )
        ]
      )
    ]
  )

def LT_EXISTS:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall (m :: num, n :: num): m < n <=> (exists d :: num: n == m + SUC(d))),
      (
        (
          (
            (
              (GEN_TAC then_tac INDUCT_TAC) then_tac \
              REWRITE_TAC(PairList [LT, ADD_CLAUSES, GSYM(NOT_SUC)])
            ) then_tac \
            ASM_REWRITE_TAC(PairList [SUC_INJ])
          ) then_tac \
          EQ_TAC
        ) then_list \
        PairList [
          (
            DISCH_THEN(DISJ_CASES_THEN2(SUBST1_TAC)(MP_TAC)) then_list \
            PairList [
              (
                EXISTS_TAC(hol:
                             (0 :: num)) then_tac \
                REWRITE_TAC(PairList [ADD_CLAUSES])
              ),
              (
                (
                  DISCH_THEN(X_CHOOSE_THEN(hol: var d :: num; d)(SUBST1_TAC)) then_tac \
                  EXISTS_TAC(hol:
                               var d :: num
                               const SUC :: num -> num
                               SUC(d))
                ) then_tac \
                REWRITE_TAC(PairList [ADD_CLAUSES])
              )
            ]
          ),
          (
            (
              (
                (
                  (
                    (ONCE_REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac INDUCT_TAC) then_tac \
                    REWRITE_TAC(PairList [ADD_CLAUSES, SUC_INJ])
                  ) then_tac \
                  DISCH_THEN(SUBST1_TAC)
                ) then_tac \
                REWRITE_TAC(PairList [])
              ) then_tac \
              DISJ2_TAC
            ) then_tac \
            REWRITE_TAC(PairList [SUC_INJ, EQ_ADD_LCANCEL, GSYM(EXISTS_REFL)])
          )
        ]
      )
    ]
  )

def LE_ADD:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m <= m + n),
      (
        (GEN_TAC then_tac INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [LE, ADD_CLAUSES, LE_REFL])
      )
    ]
  )

def LE_ADDR:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): n <= m + n),
      (ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(LE_ADD))
    ]
  )

def LT_ADD:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m < m + n <=> (0 :: num) < n),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES, LT_SUC]))
    ]
  )

def LT_ADDR:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): n < m + n <=> (0 :: num) < m),
      (ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(LT_ADD))
    ]
  )

def LE_ADD_LCANCEL:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m + n <= m + p <=> n <= p),
      REWRITE_TAC(PairList [LE_EXISTS, GSYM(ADD_ASSOC), EQ_ADD_LCANCEL])
    ]
  )

def LE_ADD_RCANCEL:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m + p <= n + p <=> m <= n),
      (ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(LE_ADD_LCANCEL))
    ]
  )

def LT_ADD_LCANCEL:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m + n < m + p <=> n < p),
      REWRITE_TAC(PairList [LT_EXISTS, GSYM(ADD_ASSOC), EQ_ADD_LCANCEL, SUC_INJ])
    ]
  )

