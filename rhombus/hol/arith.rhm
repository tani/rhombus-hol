def DIV_MONO2:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall (m :: num, n :: num, p :: num): p != (0 :: num) && p <= m ==> DIV(n, m) <= DIV(n, p)),
      (
        (
          (
            (
              (
                (
                  (REPEAT(STRIP_TAC) then_tac ASM_SIMP_TAC(PairList [LE_RDIV_EQ])) then_tac \
