def MOD_EXISTS:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         forall (m :: num, n :: num):
           (exists q :: num: m == n * q)
             <=> (if n == (0 :: num) | m == (0 :: num) | MOD(m, n) == (0 :: num))),
      (
        (
          (
            (
              (
                (
                  (
                    (REPEAT(GEN_TAC) then_tac COND_CASES_TAC) then_tac \
                    ASM_REWRITE_TAC(PairList [MULT_CLAUSES])
                  ) then_tac \
                  EQ_TAC
                ) then_tac \
                STRIP_TAC
              ) then_tac \
              ASM_SIMP_TAC(PairList [MOD_MULT])
            ) then_tac \
            EXISTS_TAC(hol:
                         var m :: num
                         var n :: num
                         const DIV :: num -> num -> num
                         DIV(m, n))
          ) then_tac \
          SUBGOAL_THEN(
            (hol:
               var m :: num
               var n :: num
               const DIV :: num -> num -> num
               const MOD :: num -> num -> num
               m == DIV(m, n) * n + MOD(m, n))
          )((fun(th): GEN_REWRITE_TAC(LAND_CONV)(PairList [th])))
        ) then_list \
        PairList [
          ASM_MESON_TAC(PairList [DIVISION]),
          ASM_REWRITE_TAC(PairList [ADD_CLAUSES, MULT_AC])
        ]
      )
    ]
  )

def LE_RDIV_EQ:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall (a :: num, b :: num, n :: num): a != (0 :: num) ==> (n <= DIV(b, a) <=> a * n <= b)),
      (
        ((REPEAT(STRIP_TAC) then_tac EQ_TAC) then_tac DISCH_TAC) then_list \
        PairList [
          (
            (
              MATCH_MP_TAC(LE_TRANS) then_tac \
              EXISTS_TAC(
                (hol:
                   var a :: num
                   var b :: num
                   const DIV :: num -> num -> num
                   a * DIV(b, a))
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [DIV_MUL_LE, LE_MULT_LCANCEL])
          ),
          (
            SUBGOAL_THEN(
              (hol:
                 var a :: num
                 var n :: num
                 var b :: num
                 const DIV :: num -> num -> num
                 a * n < a * (DIV(b, a) + (1 :: num)))
            )(MP_TAC) then_list \
            PairList [
              (
                (
                  (
                    (
                      (
                        MATCH_MP_TAC(LET_TRANS) then_tac \
                        EXISTS_TAC(
                          (hol:
                             var b :: num
                             var a :: num
                             const DIV :: num -> num -> num
                             const MOD :: num -> num -> num
                             DIV(b, a) * a + MOD(b, a))
                        )
                      ) then_tac \
                      CONJ_TAC
                    ) then_list \
                    PairList [ASM_MESON_TAC(PairList [DIVISION]), ALL_TAC]
                  ) then_tac \
                  SIMP_TAC(PairList [LEFT_ADD_DISTRIB, MULT_SYM, MULT_CLAUSES, LT_ADD_LCANCEL])
                ) then_tac \
                ASM_MESON_TAC(PairList [DIVISION])
              ),
              ASM_REWRITE_TAC(PairList [LT_MULT_LCANCEL, GSYM(ADD1), LT_SUC_LE])
            ]
          )
        ]
      )
    ]
  )

def RDIV_LT_EQ:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall (a :: num, b :: num, n :: num): a != (0 :: num) ==> (DIV(b, a) < n <=> b < a * n)),
      SIMP_TAC(PairList [GSYM(NOT_LE), LE_RDIV_EQ])
    ]
  )

def LE_LDIV_EQ:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall (a :: num, b :: num, n :: num):
           a != (0 :: num) ==> (DIV(b, a) <= n <=> b < a * (n + (1 :: num)))),
      (
        (
          (
            (REPEAT(STRIP_TAC) then_tac ONCE_REWRITE_TAC(PairList [GSYM(NOT_LT)])) then_tac \
            GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [GSYM(LE_SUC_LT)])
          ) then_tac \
          ASM_SIMP_TAC(PairList [LE_RDIV_EQ])
        ) then_tac \
        REWRITE_TAC(PairList [NOT_LT, NOT_LE, ADD1])
      )
    ]
  )

def LDIV_LT_EQ:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall (a :: num, b :: num, n :: num):
           a != (0 :: num) ==> (n < DIV(b, a) <=> a * (n + (1 :: num)) <= b)),
      SIMP_TAC(PairList [GSYM(NOT_LE), LE_LDIV_EQ])
    ]
  )

def LE_LDIV:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall (a :: num, b :: num, n :: num): a != (0 :: num) && b <= a * n ==> DIV(b, a) <= n),
