def BITS_ELIM_CONV:
  let NUMERAL_pth_2:
    prove(
      [
        Host.hol_term(Iff(
          Eq(Num, Var("m", Num), Var("n", Num)),
          Eq(Num, App(Const("NUMERAL", Fun(Num, Num)), [Var("m", Num)]), Var("n", Num))
        )),
        REWRITE_TAC(PairList [NUMERAL])
      ]
    )
  let ZERO_pth_2:
    GSYM(
      REWRITE_CONV(PairList [NUMERAL])(Host.hol_term(App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])))
    )
  let [BIT0_pth_2, BIT1_pth_2]:
    CONJ_PAIR(
      prove(
        [
          Host.hol_term(And(
            Iff(
              Eq(Num, Var("m", Num), Var("n", Num)),
              Eq(
                Num,
                App(Const("BIT0", Fun(Num, Num)), [Var("m", Num)]),
                App(
                  Const("*", Fun(Num, Fun(Num, Num))),
                  [
                    App(
                      Const("NUMERAL", Fun(Num, Num)),
                      [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                    ),
                    Var("n", Num)
                  ]
                )
              )
            ),
            Iff(
              Eq(Num, Var("m", Num), Var("n", Num)),
              Eq(
                Num,
                App(Const("BIT1", Fun(Num, Num)), [Var("m", Num)]),
                App(
                  Const("+", Fun(Num, Fun(Num, Num))),
                  [
                    App(
                      Const("*", Fun(Num, Fun(Num, Num))),
                      [
                        App(
                          Const("NUMERAL", Fun(Num, Num)),
                          [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                        ),
                        Var("n", Num)
                      ]
                    ),
                    App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                  ]
                )
              )
            )
          )),
          (
            (
              (
                (
                  CONJ_TAC then_tac \
                  GEN_REWRITE_TAC(o(RAND_CONV)(LAND_CONV))(PairList [BIT0, BIT1])
                ) then_tac \
                REWRITE_TAC(PairList [ADD1, EQ_ADD_RCANCEL, GSYM(MULT_2)])
              ) then_tac \
              REWRITE_TAC(PairList [EQ_MULT_LCANCEL])
            ) then_tac \
            REWRITE_TAC(PairList [TWO, NOT_SUC])
          )
        ]
      )
    )
  let [mvar_2, nvar_2] = [Host.hol_term(Var("m", Num)), Host.hol_term(Var("n", Num))]
  fun BITS_ELIM_CONV(tm):
    match tm
    | Const("_0",_): ZERO_pth_2
    | Var(_,_): REFL(tm)
    | Const(_,_): REFL(tm)
    | Comb(Const("NUMERAL",_),mtm):
        if is_numeral(tm)
        | REFL(tm)
        | let th = BITS_ELIM_CONV(mtm)
          EQ_MP(INST(PairList [[mtm, mvar_2], [rand(concl(th)), nvar_2]])(NUMERAL_pth_2))(th)
    | Comb(Const("BIT0",_),mtm):
        let th = BITS_ELIM_CONV(mtm)
        EQ_MP(INST(PairList [[mtm, mvar_2], [rand(concl(th)), nvar_2]])(BIT0_pth_2))(th)
    | Comb(Const("BIT1",_),mtm):
        let th = BITS_ELIM_CONV(mtm)
        EQ_MP(INST(PairList [[mtm, mvar_2], [rand(concl(th)), nvar_2]])(BIT1_pth_2))(th)
    | Comb(_,_): COMB_CONV(BITS_ELIM_CONV)(tm)
    | Abs(_,_): ABS_CONV(BITS_ELIM_CONV)(tm)
  BITS_ELIM_CONV

