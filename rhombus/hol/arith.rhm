          Eq(
            Num,
            App(
              Const("+", Fun(Num, Fun(Num, Num))),
              [Var("m", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("n", Num), Var("p", Num)])]
            ),
            App(
              Const("+", Fun(Num, Fun(Num, Num))),
              [Var("n", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("p", Num)])]
            )
          )
        )
      )),
      MESON_TAC(PairList [ADD_ASSOC, ADD_SYM])
    ]
  )

def ADD_EQ_0:
  prove(
    [
      Host.hol_term(Forall(
        "m",
        Num,
        Forall(
          "n",
          Num,
          Iff(
            Eq(
              Num,
              App(Const("+", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")]),
              App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])
            ),
            And(
              Eq(Num, Ref("m"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])),
              Eq(Num, Ref("n"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]))
            )
          )
        )
      )),
      (REPEAT(INDUCT_TAC) then_tac REWRITE_TAC(PairList [ADD_CLAUSES, NOT_SUC]))
    ]
  )

