                      )
                    ) then_tac \
                    X_GEN_TAC(hol: var k :: num; k)
                  ) then_tac \
                  MATCH_MP_TAC(EQ_TRANS)
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     var k :: num
                     var p :: num
                     var m :: num
                     var n :: num
                     const DIV :: num -> num -> num
                     k + p * DIV(DIV(m, n), p) <= DIV(m, n))
                )
              ) then_tac \
              CONJ_TAC
            ) then_list \
            PairList [
              (
                MP_TAC(
                  SPECL(
                    PairList [
                      (hol:
                         var m :: num
                         var n :: num
                         const DIV :: num -> num -> num
                         DIV(m, n)),
                      (hol: var p :: num; p)
                    ])(
                    DIVISION
                  )
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ),
              (
                MP_TAC(
                  SPECL(
                    PairList [
                      (hol: var m :: num; m),
                      (hol:
                         var n :: num
                         var p :: num
                         n * p)
                    ])(
                    DIVISION
                  )
                ) then_tac \
                ASM_SIMP_TAC(PairList [LE_RDIV_EQ, MULT_EQ_0, DIV_DIV, LEFT_ADD_DISTRIB])
              )
            ]
          ) then_tac \
          REWRITE_TAC(PairList [MULT_AC])
        ) then_tac \
        MESON_TAC(PairList [ADD_SYM, MULT_SYM, LE_ADD_RCANCEL])
      )
    ]
  )

def MOD_MULT_MOD:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         const DIV :: num -> num -> num
         forall (m :: num, n :: num, p :: num): MOD(m, n * p) == n * MOD(DIV(m, n), p) + MOD(m, n)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(GEN_TAC) then_tac \
                          ASM_CASES_TAC(
                            (hol:
                               var n :: num
                               n == (0 :: num))
                          )
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [MULT_CLAUSES, MOD_ZERO, ADD_CLAUSES])
                      ) then_tac \
                      ASM_CASES_TAC(
                        (hol:
                           var p :: num
                           p == (0 :: num))
                      )
                    ) then_list \
                    PairList [
                      (
                        ASM_REWRITE_TAC(PairList [MULT_CLAUSES, MOD_ZERO]) then_tac \
                        ASM_METIS_TAC(PairList [DIVISION, MULT_SYM])
                      ),
                      ALL_TAC
                    ]
                  ) then_tac \
                  MATCH_MP_TAC(
                    MESON(
                      PairList [EQ_ADD_LCANCEL])(
                      (hol:
                         var x :: num
                         var y :: num
                         (exists a :: num: a + x == a + y) ==> x == y)
                    )
                  )
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     var m :: num
                     var n :: num
                     var p :: num
                     const DIV :: num -> num -> num
                     DIV(DIV(m, n), p) * (n * p))
                )
              ) then_tac \
              REWRITE_TAC(PairList [DIVISION_SIMP, DIV_DIV])
            ) then_tac \
            REWRITE_TAC(
              PairList [
                AC(MULT_AC)(
                  (hol:
                     var d :: num
                     var n :: num
                     var p :: num
                     d * (n * p) == n * (d * p))
                )
              ]
            )
          ) then_tac \
          REWRITE_TAC(PairList [GSYM(LEFT_ADD_DISTRIB), ADD_ASSOC, GSYM(DIV_DIV)])
        ) then_tac \
        REWRITE_TAC(PairList [DIVISION_SIMP])
      )
    ]
  )

def MOD_MOD_EXP_MIN:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         const EXP :: num -> num -> num
         const MIN :: num -> num -> num
         forall (x :: num, p :: num, m :: num, n :: num):
           MOD(MOD(x, EXP(p, m)), EXP(p, n)) == MOD(x, EXP(p, MIN(m, n)))),
      (
        (
          (
            (
              (
                REPEAT(STRIP_TAC) then_tac \
                ASM_CASES_TAC(
                  (hol:
                     var p :: num
                     p == (0 :: num))
                )
              ) then_list \
              PairList [
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              ASM_REWRITE_TAC(PairList [EXP_ZERO, MIN]) then_tac \
                              ASM_CASES_TAC(
                                (hol:
                                   var m :: num
                                   m == (0 :: num))
                              )
                            ) then_tac \
                            ASM_REWRITE_TAC(PairList [MOD_ZERO, MOD_1, MOD_0, LE_0])
                          ) then_tac \
                          ASM_CASES_TAC(hol:
                                          var m :: num
                                          var n :: num
                                          m <= n)
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [])
                      ) then_tac \
                      COND_CASES_TAC
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_tac \
                  ASM_MESON_TAC(PairList [LE])
                ),
                REWRITE_TAC(PairList [MIN])
              ]
            ) then_tac \
            ASM_CASES_TAC(hol:
                            var m :: num
                            var n :: num
                            m <= n)
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_list \
        PairList [
          (
            (
              (
                (
                  FIRST_X_ASSUM(o(CHOOSE_THEN(SUBST1_TAC))(GEN_REWRITE_RULE(I)(PairList [LE_EXISTS]))) then_tac \
                  MATCH_MP_TAC(MOD_LT)
                ) then_tac \
                MATCH_MP_TAC(LTE_TRANS)
              ) then_tac \
              EXISTS_TAC(hol:
                           var p :: num
                           var m :: num
                           const EXP :: num -> num -> num
                           EXP(p, m))
