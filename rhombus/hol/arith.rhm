def DIVMOD_EXIST:
  prove(
    [
      (hol:
         forall (m :: num, n :: num):
           n != (0 :: num) ==> (exists (q :: num, r :: num): m == q * n + r && r < n)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            REPEAT(STRIP_TAC) then_tac \
                                            MP_TAC(
                                              SPEC(
                                                (hol:
                                                   var m :: num
                                                   var n :: num
                                                   fun (r :: num): exists q :: num: m == q * n + r)
                                              )(num_WOP)
                                            )
                                          ) then_tac \
                                          BETA_TAC
                                        ) then_tac \
                                        DISCH_THEN(o(o(MP_TAC)(fst))(EQ_IMP_RULE))
                                      ) then_tac \
                                      REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM])
                                    ) then_tac \
                                    DISCH_THEN(
                                      o(MP_TAC)(
                                        SPECL(
                                          PairList [
                                            (hol: var m :: num; m),
                                            (hol:
                                               (0 :: num))
                                          ]
                                        )
                                      )
                                    )
                                  ) then_tac \
                                  REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES])
                                ) then_tac \
                                DISCH_THEN(X_CHOOSE_THEN(hol: var r :: num; r)(MP_TAC))
                              ) then_tac \
                              DISCH_THEN(CONJUNCTS_THEN2(X_CHOOSE_TAC(hol: var q :: num; q))(MP_TAC))
                            ) then_tac \
                            DISCH_THEN(
                              fun(th):
                                (
                                  MAP_EVERY(EXISTS_TAC)(PairList [(hol: var q :: num; q), (hol: var r :: num; r)]) then_tac \
                                  MP_TAC(th)
                                )
                            )
                          ) then_tac \
                          CONV_TAC(CONTRAPOS_CONV)
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [NOT_LT])
                      ) then_tac \
                      DISCH_THEN(
                        o(X_CHOOSE_THEN(hol: var d :: num; d)(SUBST_ALL_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))
                      )
                    ) then_tac \
                    REWRITE_TAC(PairList [NOT_FORALL_THM])
                  ) then_tac \
                  EXISTS_TAC(hol: var d :: num; d)
                ) then_tac \
                REWRITE_TAC(PairList [NOT_IMP, RIGHT_AND_EXISTS_THM])
              ) then_tac \
              EXISTS_TAC(
                (hol:
                   var q :: num
                   q + (1 :: num))
              )
            ) then_tac \
            REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB])
          ) then_tac \
          REWRITE_TAC(PairList [MULT_CLAUSES, ADD_ASSOC, LT_ADDR])
        ) then_tac \
        ASM_REWRITE_TAC(PairList [GSYM(NOT_LE), LE])
      )
    ]
  )

