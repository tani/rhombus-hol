def DIVISION:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         const MOD :: num -> num -> num
         forall (m :: num, n :: num):
           n != (0 :: num) ==> m == DIV(m, n) * n + MOD(m, n) && MOD(m, n) < n),
      MESON_TAC(PairList [DIVISION_0])
    ]
  )

def DIV_ZERO:
  prove(
    [
      (hol:
