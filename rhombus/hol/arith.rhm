  )

def EQ_EXP:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall (x :: num, m :: num, n :: num):
           EXP(x, m) == EXP(x, n)
             <=> (if x == (0 :: num) | m == (0 :: num) <=> n == (0 :: num) | x == (1 :: num) || m == n)),
