def arith_ADD_SYM:«
  Up_tactics.prove((block:«
    let port_tmp_13 = (block:«
      let port_tmp_14 = Up_simp.ASM_REWRITE_TAC(PairList.cons(arith_ADD_CLAUSES,PairList []));
      let port_tmp_15 = Up_nums.INDUCT_TAC;
      let port_tmp_16 = Up_tactics.THEN;
