def EVEN_MOD:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         const MOD :: num -> num -> num
         forall n :: num: EVEN(n) <=> MOD(n, (2 :: num)) == (0 :: num)),
      (REWRITE_TAC(PairList [EVEN_EXISTS, MOD_EQ_0]) then_tac MESON_TAC(PairList [MULT_SYM]))
    ]
  )

def ODD_MOD:
  prove(
    [
      (hol:
         const ODD :: num -> bool
         const MOD :: num -> num -> num
         forall n :: num: ODD(n) <=> MOD(n, (2 :: num)) == (1 :: num)),
      (
        (
          (
            (
              (
                (GEN_TAC then_tac REWRITE_TAC(PairList [GSYM(NOT_EVEN), EVEN_MOD])) then_tac \
                SUBGOAL_THEN(
                  (hol:
                     var n :: num
                     const MOD :: num -> num -> num
                     MOD(n, (2 :: num)) < (2 :: num))
                )(MP_TAC)
              ) then_list \
              PairList [SIMP_TAC(PairList [DIVISION, TWO, NOT_SUC]), ALL_TAC]
            ) then_tac \
            SPEC_TAC(
              [
                (hol:
                   var n :: num
                   const MOD :: num -> num -> num
                   MOD(n, (2 :: num))),
                (hol: var n :: num; n)
              ]
            )
          ) then_tac \
          REWRITE_TAC(PairList [TWO, ONE, LT])
        ) then_tac \
        MESON_TAC(PairList [NOT_SUC])
      )
    ]
  )

def MOD_2_CASES:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         const EVEN :: num -> bool
         forall n :: num: MOD(n, (2 :: num)) == (if EVEN(n) | (0 :: num) | (1 :: num))),
      MESON_TAC(PairList [EVEN_MOD, ODD_MOD, NOT_ODD])
    ]
  )

def EVEN_MOD_EVEN:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         const MOD :: num -> num -> num
         forall (m :: num, n :: num): EVEN(n) ==> (EVEN(MOD(m, n)) <=> EVEN(m))),
      (
        (REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [EVEN_MOD])) then_tac \
        ASM_SIMP_TAC(PairList [MOD_EVEN_2])
      )
    ]
  )

def ODD_MOD_EVEN:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         const ODD :: num -> bool
         const MOD :: num -> num -> num
         forall (m :: num, n :: num): EVEN(n) ==> (ODD(MOD(m, n)) <=> ODD(m))),
      SIMP_TAC(PairList [GSYM(NOT_EVEN), EVEN_MOD_EVEN])
    ]
  )

def HALF_DOUBLE:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         (forall n :: num: DIV((2 :: num) * n, (2 :: num)) == n)
           && (forall n :: num: DIV(n * (2 :: num), (2 :: num)) == n)),
      (
        GEN_REWRITE_TAC(o(RAND_CONV)(ONCE_DEPTH_CONV))(PairList [MULT_SYM]) then_tac \
        SIMP_TAC(PairList [arith_DIV_MULT_v2, TWO, NOT_SUC])
      )
    ]
  )

def DOUBLE_HALF:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         const DIV :: num -> num -> num
         (forall n :: num: EVEN(n) ==> (2 :: num) * DIV(n, (2 :: num)) == n)
           && (forall n :: num: EVEN(n) ==> DIV(n, (2 :: num)) * (2 :: num) == n)),
      (
        SIMP_TAC(PairList [EVEN_EXISTS, LEFT_IMP_EXISTS_THM, HALF_DOUBLE]) then_tac \
        REWRITE_TAC(PairList [MULT_SYM])
      )
    ]
  )

def MOD_MULT_RMOD:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         forall (m :: num, n :: num, p :: num): MOD(m * MOD(p, n), n) == MOD(m * p, n)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(GEN_TAC) then_tac \
                          ASM_CASES_TAC(
                            (hol:
                               var n :: num
                               n == (0 :: num))
                          )
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [MOD_ZERO])
                      ) then_tac \
                      CONV_TAC(SYM_CONV)
                    ) then_tac \
                    MATCH_MP_TAC(MOD_EQ)
                  ) then_tac \
                  EXISTS_TAC(
                    (hol:
                       var m :: num
                       var p :: num
                       var n :: num
                       const DIV :: num -> num -> num
                       m * DIV(p, n))
                  )
                ) then_tac \
                REWRITE_TAC(PairList [GSYM(MULT_ASSOC), GSYM(LEFT_ADD_DISTRIB)])
              ) then_tac \
              REWRITE_TAC(PairList [EQ_MULT_LCANCEL])
            ) then_tac \
            DISJ2_TAC
          ) then_tac \
          ONCE_REWRITE_TAC(PairList [ADD_SYM])
        ) then_tac \
        ASM_SIMP_TAC(PairList [DIVISION])
      )
    ]
  )

def MOD_MULT_LMOD:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         forall (m :: num, n :: num, p :: num): MOD(MOD(m, n) * p, n) == MOD(m * p, n)),
