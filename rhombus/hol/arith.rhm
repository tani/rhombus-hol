def MOD_DOWN_CONV:
  let MOD_SUC_MOD:
    METIS(
      PairList [ADD1, MOD_ADD_MOD, MOD_MOD_REFL])(
      (hol:
         var m :: num
         var n :: num
         const MOD :: num -> num -> num
         const SUC :: num -> num
         MOD(SUC(MOD(m, n)), n) == MOD(SUC(m), n))
    )
  let addmul_conv_2:
    GEN_REWRITE_CONV(I)(
      PairList [
        GSYM(MOD_SUC_MOD),
        GSYM(MOD_ADD_MOD),
        GSYM(MOD_MULT_MOD2),
        GSYM(MOD_EXP_MOD)
      ]
    )
  let mod_conv_2 = GEN_REWRITE_CONV(I)(PairList [MOD_MOD_REFL])
  fun downconv_2(tm):
    (
      ((addmul_conv_2 then_conv LAND_CONV(downconv_2)) or_conv (mod_conv_2 then_conv downconv_2)) or_conv \
      SUB_CONV(downconv_2)
    )(tm)
  let upconv_2:
    GEN_REWRITE_CONV(
      DEPTH_CONV)(
      PairList [MOD_SUC_MOD, MOD_ADD_MOD, MOD_MULT_MOD2, MOD_EXP_MOD, MOD_MOD_REFL]
    )
  (downconv_2 then_conv upconv_2)

def NUM_CANCEL_CONV:
  // Recursive cancellation needs the local definition before its first use.
  fun minter(i):
    fun(l1_prime):
      fun(l2_prime):
        fun(l1):
          fun(l2):
            if (l1 == (PairList []))
            | [i, l1_prime, append(l2_prime)(l2)]
            | if (l2 == (PairList []))
              | [i, append(l1)(l1_prime), l2_prime]
              | let h1_2 = hd(l1)
                let h2_2 = hd(l2)
                if (h1_2 == h2_2)
                | minter(PairList [h1_2, & i])(l1_prime)(l2_prime)(tl(l1))(tl(l2))
                | (if (h1_2 < h2_2) | minter(i)(PairList [h1_2, & l1_prime])(l2_prime)(tl(l1))(l2) | minter(i)(l1_prime)(PairList [h2_2, & l2_prime])(l1)(tl(l2)))
  let add_tm_2 = hol: const #{+} :: num -> num -> num; const.#{+}
  let eq_tm_2 = hol: const #{=} :: num -> num -> bool; #{=}
  let EQ_ADD_LCANCEL_0_prime = GEN_REWRITE_RULE(o(funpow(2)(BINDER_CONV))(LAND_CONV))(PairList [EQ_SYM_EQ])(EQ_ADD_LCANCEL_0)
  let AC_RULE = AC(ADD_AC)
  fun(tm):
    let [l, r] = dest_eq(tm)
    let lats_2 = sort(fun (x): fun (y): x <= y)(binops(hol: const #{+} :: num -> num -> num; const.#{+})(l))
    let rats_2 = sort(fun (x): fun (y): x <= y)(binops(hol: const #{+} :: num -> num -> num; const.#{+})(r))
    let [i, lats_prime, rats_prime] = minter(PairList [])(PairList [])(PairList [])(lats_2)(rats_2)
    let l_prime_2 = list_mk_binop(add_tm_2)(append(i)(lats_prime))
    let r_prime_2 = list_mk_binop(add_tm_2)(append(i)(rats_prime))
    let lth_2 = AC_RULE(mk_eq([l, l_prime_2]))
    let rth_2 = AC_RULE(mk_eq([r, r_prime_2]))
    let eth = MK_COMB([AP_TERM(eq_tm_2)(lth_2), rth_2])
    GEN_REWRITE_RULE(
      o(RAND_CONV)(REPEATC))(
      PairList [EQ_ADD_LCANCEL, EQ_ADD_LCANCEL_0, EQ_ADD_LCANCEL_0_prime]
    )(eth)

def LE_IMP:
  let pth = PURE_ONCE_REWRITE_RULE(PairList [IMP_CONJ])(LE_TRANS)
  (fun(th): GEN_ALL(MATCH_MP(pth)(SPEC_ALL(th))))

Host.parse_as_binder("minimal")

def minimal:
  new_definition(
    (hol:
       var minimal :: (num -> bool) -> num
       var P :: num -> bool
       const #{@} :: (num -> bool) -> num
       minimal(P) == #{@}(fun (n :: num): P(n) && (forall m :: num: m < n ==> !P(m))))
  )

def MINIMAL:
  prove(
    [
      (hol:
         const minimal :: (num -> bool) -> num
         forall P :: num -> bool:
           (exists n :: num: P(n)) <=> P(minimal(P)) && (forall m :: num: m < minimal(P) ==> !P(m))),
      (
        (
          (GEN_TAC then_tac REWRITE_TAC(PairList [minimal])) then_tac \
          CONV_TAC(RAND_CONV(SELECT_CONV))
        ) then_tac \
        REWRITE_TAC(PairList [GSYM(num_WOP)])
      )
    ]
  )

def MINIMAL_UNIQUE:
  prove(
    [
      (hol:
         const minimal :: (num -> bool) -> num
         forall (P :: num -> bool, n :: num):
           P(n) && (forall m :: num: m < n ==> !P(m)) ==> minimal(P) == n),
      (
        (
          (REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [minimal])) then_tac \
          MATCH_MP_TAC(SELECT_UNIQUE)
        ) then_tac \
        ASM_MESON_TAC(PairList [LT_CASES])
      )
    ]
  )

def LE_MINIMAL:
  prove(
    [
      (hol:
         const minimal :: (num -> bool) -> num
         forall (P :: num -> bool, n :: num):
           (exists r :: num: P(r)) ==> (n <= minimal(P) <=> (forall i :: num: P(i) ==> n <= i))),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          GEN_REWRITE_TAC(LAND_CONV)(PairList [MINIMAL])
        ) then_tac \
        MESON_TAC(PairList [NOT_LE, LE_TRANS])
      )
    ]
  )

def MINIMAL_LE:
  prove(
    [
      (hol:
         const minimal :: (num -> bool) -> num
         forall (P :: num -> bool, n :: num):
           (exists r :: num: P(r)) ==> (minimal(P) <= n <=> (exists i :: num: i <= n && P(i)))),
      (
        (
          (
            REWRITE_TAC(PairList [GSYM(NOT_LT)]) then_tac \
            REWRITE_TAC(PairList [GSYM(LE_SUC_LT)])
          ) then_tac \
          SIMP_TAC(PairList [LE_MINIMAL])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def MINIMAL_UBOUND:
  prove(
    [
      (hol:
         const minimal :: (num -> bool) -> num
         forall (P :: num -> bool, n :: num): P(n) ==> minimal(P) <= n),
      MESON_TAC(PairList [MINIMAL, NOT_LT])
    ]
  )

def MINIMAL_LBOUND:
  prove(
    [
      (hol:
         const minimal :: (num -> bool) -> num
         forall (P :: num -> bool, n :: num):
           (exists r :: num: P(r)) && (forall m :: num: m < n ==> !P(m)) ==> n <= minimal(P)),
      (SIMP_TAC(PairList [LE_MINIMAL]) then_tac MESON_TAC(PairList [NOT_LT]))
    ]
  )

def MINIMAL_MONO:
  prove(
    [
      (hol:
         const minimal :: (num -> bool) -> num
         forall (P :: num -> bool, Q :: num -> bool):
           (exists n :: num: P(n)) && (forall n :: num: P(n) ==> Q(n)) ==> minimal(Q) <= minimal(P)),
      (
        (
          (
            (
              (
                REPEAT(GEN_TAC) then_tac \
                DISCH_THEN(CONJUNCTS_THEN(ASSUME_TAC))
              ) then_tac \
              SUBGOAL_THEN(hol:
                             var Q :: num -> bool
                             exists n :: num: Q(n))(ASSUME_TAC)
            ) then_list \
            PairList [ASM_MESON_TAC(PairList []), ALL_TAC]
          ) then_tac \
          MATCH_MP_TAC(
            MESON(
              PairList [LE_TRANS, LE_REFL])(
              (hol:
                 var m :: num
                 var n :: num
                 (forall p :: num: p <= m ==> p <= n) ==> m <= n)
            )
          )
        ) then_tac \
        ASM_SIMP_TAC(PairList [LE_MINIMAL])
      )
    ]
  )

def TRANSITIVE_STEPWISE_LT_EQ:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall R :: num -> num -> bool:
           (forall (x :: num, y :: num, z :: num): R(x, y) && R(y, z) ==> R(x, z))
             ==> ((forall (m :: num, n :: num): m < n ==> R(m, n)) <=> (forall n :: num: R(n, SUC(n))))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (REPEAT(STRIP_TAC) then_tac EQ_TAC) then_tac \
                        ASM_SIMP_TAC(PairList [LT])
                      ) then_tac \
                      DISCH_TAC
                    ) then_tac \
                    SIMP_TAC(PairList [LT_EXISTS, LEFT_IMP_EXISTS_THM])
                  ) then_tac \
                  GEN_TAC
                ) then_tac \
                ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM])
              ) then_tac \
              REWRITE_TAC(PairList [LEFT_FORALL_IMP_THM, EXISTS_REFL, ADD_CLAUSES])
            ) then_tac \
            INDUCT_TAC
          ) then_tac \
          REWRITE_TAC(PairList [ADD_CLAUSES])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def TRANSITIVE_STEPWISE_LT:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall R :: num -> num -> bool:
           ((forall (x :: num, y :: num, z :: num): R(x, y) && R(y, z) ==> R(x, z))
              && (forall n :: num: R(n, SUC(n))))
             ==> (forall (m :: num, n :: num): m < n ==> R(m, n))),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          MATCH_MP_TAC(
            TAUT(
              (hol:
                 var a :: bool
                 var c :: bool
                 var b :: bool
                 (a ==> (c <=> b)) ==> a && b ==> c)
            )
          )
        ) then_tac \
        MATCH_ACCEPT_TAC(TRANSITIVE_STEPWISE_LT_EQ)
      )
    ]
  )

def TRANSITIVE_STEPWISE_LE_EQ:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall R :: num -> num -> bool:
           ((forall x :: num: R(x, x))
              && (forall (x :: num, y :: num, z :: num): R(x, y) && R(y, z) ==> R(x, z)))
             ==> ((forall (m :: num, n :: num): m <= n ==> R(m, n)) <=> (forall n :: num: R(n, SUC(n))))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (REPEAT(STRIP_TAC) then_tac EQ_TAC) then_tac \
                        ASM_SIMP_TAC(PairList [LE, LE_REFL])
                      ) then_tac \
                      DISCH_TAC
                    ) then_tac \
                    SIMP_TAC(PairList [LE_EXISTS, LEFT_IMP_EXISTS_THM])
                  ) then_tac \
                  GEN_TAC
                ) then_tac \
                ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM])
              ) then_tac \
              REWRITE_TAC(PairList [LEFT_FORALL_IMP_THM, EXISTS_REFL, ADD_CLAUSES])
            ) then_tac \
            INDUCT_TAC
          ) then_tac \
          REWRITE_TAC(PairList [ADD_CLAUSES])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def TRANSITIVE_STEPWISE_LE:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall R :: num -> num -> bool:
           ((forall x :: num: R(x, x))
              && ((forall (x :: num, y :: num, z :: num): R(x, y) && R(y, z) ==> R(x, z))
                    && (forall n :: num: R(n, SUC(n)))))
             ==> (forall (m :: num, n :: num): m <= n ==> R(m, n))),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          MATCH_MP_TAC(
            TAUT(
              (hol:
                 var a :: bool
                 var #{|a'|} :: bool
                 var c :: bool
                 var b :: bool
                 (a && #{|a'|} ==> (c <=> b)) ==> a && (#{|a'|} && b) ==> c)
            )
          )
        ) then_tac \
        MATCH_ACCEPT_TAC(TRANSITIVE_STEPWISE_LE_EQ)
      )
    ]
  )

def DEPENDENT_CHOICE_FIXED:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall (P :: num -> A -> bool, R :: num -> A -> A -> bool, a :: A):
           (P((0 :: num), a)
              && (forall (n :: num, x :: A): P(n, x) ==> (exists y :: A: P(SUC(n), y) && R(n, x, y))))
             ==> (exists f :: num -> A:
                    f((0 :: num)) == a
                      && ((forall n :: num: P(n, f(n))) && (forall n :: num: R(n, f(n), f(SUC(n))))))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REPEAT(STRIP_TAC) then_tac \
                        o(MP_TAC)(prove_recursive_functions_exist(num_RECURSION))(
                          (hol:
                             var f :: num -> A
                             var a :: A
                             var P :: num -> A -> bool
                             var R :: num -> A -> A -> bool
                             const SUC :: num -> num
                             const #{@} :: (A -> bool) -> A
                             f((0 :: num)) == a
                               && (forall n :: num: f(SUC(n)) == #{@}(fun (y :: A): P(SUC(n), y) && R(n, f(n), y))))
                        )
                      ) then_tac \
                      MATCH_MP_TAC(MONO_EXISTS)
                    ) then_tac \
                    GEN_TAC
                  ) then_tac \
                  STRIP_TAC
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              GEN_REWRITE_TAC(LAND_CONV)(
                PairList [
                  MESON(
                    PairList [num_CASES])(
                    (hol:
                       var P :: num -> bool
                       const SUC :: num -> num
                       (forall n :: num: P(n)) <=> P((0 :: num)) && (forall n :: num: P(SUC(n))))
                  )
                ]
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [AND_FORALL_THM])
          ) then_tac \
          INDUCT_TAC
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def DEPENDENT_CHOICE:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall (P :: num -> A -> bool, R :: num -> A -> A -> bool):
           ((exists a :: A: P((0 :: num), a))
              && (forall (n :: num, x :: A): P(n, x) ==> (exists y :: A: P(SUC(n), y) && R(n, x, y))))
             ==> (exists f :: num -> A:
                    (forall n :: num: P(n, f(n))) && (forall n :: num: R(n, f(n), f(SUC(n)))))),
      MESON_TAC(PairList [DEPENDENT_CHOICE_FIXED])
    ]
  )

def BITS_ELIM_CONV:
  let NUMERAL_pth_2:
    prove(
      [
        (hol:
           var m :: num
           var n :: num
           const NUMERAL :: num -> num
           m == n <=> NUMERAL(m) == n),
        REWRITE_TAC(PairList [NUMERAL])
      ]
    )
  let ZERO_pth_2:
    GSYM(
      REWRITE_CONV(PairList [NUMERAL])(hol:
                                         (0 :: num))
    )
  let [BIT0_pth_2, BIT1_pth_2]:
    CONJ_PAIR(
      prove(
        [
          (hol:
             var m :: num
             var n :: num
             const BIT0 :: num -> num
             const BIT1 :: num -> num
             (m == n <=> BIT0(m) == (2 :: num) * n) && (m == n <=> BIT1(m) == (2 :: num) * n + (1 :: num))),
          (
            (
              (
                (
                  CONJ_TAC then_tac \
                  GEN_REWRITE_TAC(o(RAND_CONV)(LAND_CONV))(PairList [BIT0, BIT1])
                ) then_tac \
                REWRITE_TAC(PairList [ADD1, EQ_ADD_RCANCEL, GSYM(MULT_2)])
              ) then_tac \
              REWRITE_TAC(PairList [EQ_MULT_LCANCEL])
            ) then_tac \
            REWRITE_TAC(PairList [TWO, NOT_SUC])
          )
        ]
      )
    )
  let [mvar_2, nvar_2] = [(hol: var m :: num; m), (hol: var n :: num; n)]
  fun BITS_ELIM_CONV(tm):
    match tm
    | Const("_0",_): ZERO_pth_2
    | Var(_,_): REFL(tm)
    | Const(_,_): REFL(tm)
    | Comb(Const("NUMERAL",_),mtm):
        if is_numeral(tm)
        | REFL(tm)
        | let th = BITS_ELIM_CONV(mtm)
          EQ_MP(INST(PairList [[mtm, mvar_2], [rand(concl(th)), nvar_2]])(NUMERAL_pth_2))(th)
    | Comb(Const("BIT0",_),mtm):
        let th = BITS_ELIM_CONV(mtm)
        EQ_MP(INST(PairList [[mtm, mvar_2], [rand(concl(th)), nvar_2]])(BIT0_pth_2))(th)
    | Comb(Const("BIT1",_),mtm):
        let th = BITS_ELIM_CONV(mtm)
        EQ_MP(INST(PairList [[mtm, mvar_2], [rand(concl(th)), nvar_2]])(BIT1_pth_2))(th)
    | Comb(_,_): COMB_CONV(BITS_ELIM_CONV)(tm)
    | Abs(_,_): ABS_CONV(BITS_ELIM_CONV)(tm)
  BITS_ELIM_CONV

