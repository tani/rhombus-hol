def PRE:
  new_recursive_definition(num_RECURSION)(
    @hol|{(PRE 0 = 0) /\
       (!n. PRE (SUC n) = n)}|
  )

def ADD:
  new_recursive_definition(num_RECURSION)(
    @hol|{(!n. 0 + n = n) /\
       (!m n. (SUC m) + n = SUC(m + n))}|
  )

def ADD_0:
  prove(
    [
      @hol|{!m. m + 0 = m}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD])
    ]
  )

def ADD_SUC:
  prove(
    [
      @hol|{!m n. m + (SUC n) = SUC(m + n)}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD])
    ]
  )

def ADD_CLAUSES:
  prove(
    [
      @hol|{(!n. 0 + n = n) /\
         (!m. m + 0 = m) /\
         (!m n. (SUC m) + n = SUC(m + n)) /\
         (!m n. m + (SUC n) = SUC(m + n))}|,
      REWRITE_TAC(PairList [ADD, ADD_0, ADD_SUC])
    ]
  )

def ADD_SYM:
  prove(
    [
      @hol|{!m n. m + n = n + m}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES])
    ]
  )

def ADD_ASSOC:
  prove(
    [
      @hol|{!m n p. m + (n + p) = (m + n) + p}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES])
    ]
  )

def ADD_AC:
  prove(
    [
      @hol|{(m + n = n + m) /\
         ((m + n) + p = m + (n + p)) /\
         (m + (n + p) = n + (m + p))}|,
      MESON_TAC(PairList [ADD_ASSOC, ADD_SYM])
    ]
  )

def ADD_EQ_0:
  prove(
    [
      @hol|{!m n. (m + n = 0) <=> (m = 0) /\ (n = 0)}|,
      REPEAT(INDUCT_TAC) then_tac REWRITE_TAC(PairList [ADD_CLAUSES, NOT_SUC])
    ]
  )

def EQ_ADD_LCANCEL:
  prove(
    [
      @hol|{!m n p. (m + n = m + p) <=> (n = p)}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES, SUC_INJ])
    ]
  )

def EQ_ADD_RCANCEL:
  prove(
    [
      @hol|{!m n p. (m + p = n + p) <=> (m = n)}|,
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(EQ_ADD_LCANCEL)
    ]
  )

def EQ_ADD_LCANCEL_0:
  prove(
    [
      @hol|{!m n. (m + n = m) <=> (n = 0)}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES, SUC_INJ])
    ]
  )

def EQ_ADD_RCANCEL_0:
  prove(
    [
      @hol|{!m n. (m + n = n) <=> (m = 0)}|,
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(EQ_ADD_LCANCEL_0)
    ]
  )

def BIT0:
  prove(
    [
      @hol|{!n. BIT0 n = n + n}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [BIT0_DEF, ADD_CLAUSES])
    ]
  )

def BIT1:
  prove(
    [
      @hol|{!n. BIT1 n = SUC(n + n)}|,
      REWRITE_TAC(PairList [BIT1_DEF, BIT0])
    ]
  )

def BIT0_THM:
  prove(
    [
      @hol|{!n. NUMERAL (BIT0 n) = NUMERAL n + NUMERAL n}|,
      REWRITE_TAC(PairList [NUMERAL, BIT0])
    ]
  )

def BIT1_THM:
  prove(
    [
      @hol|{!n. NUMERAL (BIT1 n) = SUC(NUMERAL n + NUMERAL n)}|,
      REWRITE_TAC(PairList [NUMERAL, BIT1])
    ]
  )

def ONE:
  prove(
    [
      @hol|{1 = SUC 0}|,
      REWRITE_TAC(PairList [BIT1, REWRITE_RULE(PairList [NUMERAL])(ADD_CLAUSES), NUMERAL])
    ]
  )

def TWO:
  prove(
    [
      @hol|{2 = SUC 1}|,
      REWRITE_TAC(PairList [BIT0, BIT1, REWRITE_RULE(PairList [NUMERAL])(ADD_CLAUSES), NUMERAL])
    ]
  )

def ADD1:
  prove(
    [
      @hol|{!m. SUC m = m + 1}|,
      REWRITE_TAC(PairList [BIT1_THM, ADD_CLAUSES])
    ]
  )

def MULT:
  new_recursive_definition(num_RECURSION)(
    @hol|{(!n. 0 * n = 0) /\
       (!m n. (SUC m) * n = (m * n) + n)}|
  )

def MULT_0:
  prove(
    [
      @hol|{!m. m * 0 = 0}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MULT, ADD_CLAUSES])
    ]
  )

def MULT_SUC:
  prove(
    [
      @hol|{!m n. m * (SUC n) = m + (m * n)}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MULT, ADD_CLAUSES, ADD_ASSOC])
    ]
  )

def MULT_CLAUSES:
  prove(
    [
      @hol|{(!n. 0 * n = 0) /\
         (!m. m * 0 = 0) /\
         (!n. 1 * n = n) /\
         (!m. m * 1 = m) /\
         (!m n. (SUC m) * n = (m * n) + n) /\
         (!m n. m * (SUC n) = m + (m * n))}|,
      REWRITE_TAC(PairList [BIT1_THM, MULT, MULT_0, MULT_SUC, ADD_CLAUSES])
    ]
  )

def MULT_SYM:
  prove(
    [
      @hol|{!m n. m * n = n * m}|,
      INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, EQT_INTRO(SPEC_ALL(ADD_SYM))])
    ]
  )

def LEFT_ADD_DISTRIB:
  prove(
    [
      @hol|{!m n p. m * (n + p) = (m * n) + (m * p)}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ADD, MULT_CLAUSES, ADD_ASSOC])
    ]
  )

def RIGHT_ADD_DISTRIB:
  prove(
    [
      @hol|{!m n p. (m + n) * p = (m * p) + (n * p)}|,
      ONCE_REWRITE_TAC(PairList [MULT_SYM]) then_tac MATCH_ACCEPT_TAC(LEFT_ADD_DISTRIB)
    ]
  )

def MULT_ASSOC:
  prove(
    [
      @hol|{!m n p. m * (n * p) = (m * n) * p}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MULT_CLAUSES, RIGHT_ADD_DISTRIB])
    ]
  )

def MULT_AC:
  prove(
    [
      @hol|{(m * n = n * m) /\
         ((m * n) * p = m * (n * p)) /\
         (m * (n * p) = n * (m * p))}|,
      MESON_TAC(PairList [MULT_ASSOC, MULT_SYM])
    ]
  )

def MULT_EQ_0:
  prove(
    [
      @hol|{!m n. (m * n = 0) <=> (m = 0) \/ (n = 0)}|,
      REPEAT(INDUCT_TAC) then_tac \
      REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, NOT_SUC])
    ]
  )

def EQ_MULT_LCANCEL:
  prove(
    [
      @hol|{!m n p. (m * n = m * p) <=> (m = 0) \/ (n = p)}|,
      INDUCT_TAC then_tac REWRITE_TAC(PairList [MULT_CLAUSES, NOT_SUC]) then_tac \
      REPEAT(INDUCT_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, GSYM(NOT_SUC), NOT_SUC]) then_tac \
      ASM_REWRITE_TAC(PairList [SUC_INJ, GSYM(ADD_ASSOC), EQ_ADD_LCANCEL])
    ]
  )

def EQ_MULT_RCANCEL:
  prove(
    [
      @hol|{!m n p. (m * p = n * p) <=> (m = n) \/ (p = 0)}|,
      ONCE_REWRITE_TAC(PairList [MULT_SYM, DISJ_SYM]) then_tac \
      MATCH_ACCEPT_TAC(EQ_MULT_LCANCEL)
    ]
  )

def MULT_2:
  prove(
    [
      @hol|{!n. 2 * n = n + n}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [BIT0_THM, MULT_CLAUSES, RIGHT_ADD_DISTRIB])
    ]
  )

def MULT_EQ_1:
  prove(
    [
      @hol|{!m n. (m * n = 1) <=> (m = 1) /\ (n = 1)}|,
      INDUCT_TAC then_tac INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, BIT0_THM, BIT1_THM, GSYM(NOT_SUC)]) then_tac \
      REWRITE_TAC(PairList [SUC_INJ, ADD_EQ_0, MULT_EQ_0]) then_tac \
      CONV_TAC(TAUT)
    ]
  )

def EXP:
  new_recursive_definition(num_RECURSION)(
    @hol|{(!m. m EXP 0 = 1) /\
       (!m n. m EXP (SUC n) = m * (m EXP n))}|
  )

def EXP_EQ_0:
  prove(
    [
      @hol|{!m n. (m EXP n = 0) <=> (m = 0) /\ ~(n = 0)}|,
      REPEAT(INDUCT_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [BIT1_THM, NOT_SUC, NOT_SUC, EXP, MULT_CLAUSES, ADD_CLAUSES, ADD_EQ_0])
    ]
  )

def EXP_EQ_1:
  prove(
    [
      @hol|{!x n. x EXP n = 1 <=> x = 1 \/ n = 0}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [EXP, MULT_EQ_1, NOT_SUC]) then_tac \
      CONV_TAC(TAUT)
    ]
  )

def EXP_ZERO:
  prove(
    [
      @hol|{!n. 0 EXP n = if n = 0 then 1 else 0}|,
      GEN_TAC then_tac COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [EXP_EQ_0, EXP_EQ_1])
    ]
  )

def EXP_ADD:
  prove(
    [
      @hol|{!m n p. m EXP (n + p) = (m EXP n) * (m EXP p)}|,
      GEN_TAC then_tac GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [EXP, ADD_CLAUSES, MULT_CLAUSES, MULT_AC])
    ]
  )

def EXP_ONE:
  prove(
    [
      @hol|{!n. 1 EXP n = 1}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EXP, MULT_CLAUSES])
    ]
  )

def EXP_1:
  prove(
    [
      @hol|{!n. n EXP 1 = n}|,
      REWRITE_TAC(PairList [ONE, EXP, MULT_CLAUSES, ADD_CLAUSES])
    ]
  )

def EXP_2:
  prove(
    [
      @hol|{!n. n EXP 2 = n * n}|,
      REWRITE_TAC(PairList [BIT0_THM, BIT1_THM, EXP, EXP_ADD, MULT_CLAUSES, ADD_CLAUSES])
    ]
  )

def MULT_EXP:
  prove(
    [
      @hol|{!p m n. (m * n) EXP p = m EXP p * n EXP p}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EXP, MULT_CLAUSES, MULT_AC])
    ]
  )

def EXP_MULT:
  prove(
    [
      @hol|{!m n p. m EXP (n * p) = (m EXP n) EXP p}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [EXP_ADD, EXP, MULT_CLAUSES]) then_list \
      PairList [
        CONV_TAC(ONCE_DEPTH_CONV(SYM_CONV)) then_tac INDUCT_TAC then_tac \
        ASM_REWRITE_TAC(PairList [EXP, MULT_CLAUSES]),
        REWRITE_TAC(PairList [MULT_EXP]) then_tac MATCH_ACCEPT_TAC(MULT_SYM)
      ]
    ]
  )

def EXP_EXP:
  prove(
    [
      @hol|{!x m n. (x EXP m) EXP n = x EXP (m * n)}|,
      REWRITE_TAC(PairList [EXP_MULT])
    ]
  )

def LE:
  new_recursive_definition(num_RECURSION)(
    @hol|{(!m. (m <= 0) <=> (m = 0)) /\
       (!m n. (m <= SUC n) <=> (m = SUC n) \/ (m <= n))}|
  )

def LT:
  new_recursive_definition(num_RECURSION)(
    @hol|{(!m. (m < 0) <=> F) /\
       (!m n. (m < SUC n) <=> (m = n) \/ (m < n))}|
  )

def GE:
  new_definition(
    @hol|{m >= n <=> n <= m}|
  )

def GT:
  new_definition(
    @hol|{m > n <=> n < m}|
  )

def MAX:
  new_definition(
    @hol|{!m n. MAX m n = if m <= n then n else m}|
  )

def MIN:
  new_definition(
    @hol|{!m n. MIN m n = if m <= n then m else n}|
  )

def LE_SUC_LT:
  prove(
    [
      @hol|{!m n. (SUC m <= n) <=> (m < n)}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [LE, LT, NOT_SUC, SUC_INJ])
    ]
  )

def LT_SUC_LE:
  prove(
    [
      @hol|{!m n. (m < SUC n) <=> (m <= n)}|,
      GEN_TAC then_tac INDUCT_TAC then_tac ONCE_REWRITE_TAC(PairList [LT, LE]) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REWRITE_TAC(PairList [LT])
    ]
  )

def LE_SUC:
  prove(
    [
      @hol|{!m n. (SUC m <= SUC n) <=> (m <= n)}|,
      REWRITE_TAC(PairList [LE_SUC_LT, LT_SUC_LE])
    ]
  )

def LT_SUC:
  prove(
    [
      @hol|{!m n. (SUC m < SUC n) <=> (m < n)}|,
      REWRITE_TAC(PairList [LT_SUC_LE, LE_SUC_LT])
    ]
  )

def LE_0:
  prove(
    [
      @hol|{!n. 0 <= n}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [LE])
    ]
  )

def LT_0:
  prove(
    [
      @hol|{!n. 0 < SUC n}|,
      REWRITE_TAC(PairList [LT_SUC_LE, LE_0])
    ]
  )

def LE_REFL:
  prove(
    [
      @hol|{!n. n <= n}|,
      INDUCT_TAC then_tac REWRITE_TAC(PairList [LE])
    ]
  )

def LT_REFL:
  prove(
    [
      @hol|{!n. ~(n < n)}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [LT_SUC]) then_tac \
      REWRITE_TAC(PairList [LT])
    ]
  )

def LT_IMP_NE:
  prove(
    [
      @hol|{!m n:num. m < n ==> ~(m = n)}|,
      MESON_TAC(PairList [LT_REFL])
    ]
  )

def LE_ANTISYM:
  prove(
    [
      @hol|{!m n. (m <= n /\ n <= m) <=> (m = n)}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, SUC_INJ]) then_tac \
      REWRITE_TAC(PairList [LE, NOT_SUC, GSYM(NOT_SUC)])
    ]
  )

def LT_ANTISYM:
  prove(
    [
      @hol|{!m n. ~(m < n /\ n < m)}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LT_SUC]) then_tac \
      REWRITE_TAC(PairList [LT])
    ]
  )

def LET_ANTISYM:
  prove(
    [
      @hol|{!m n. ~(m <= n /\ n < m)}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC]) then_tac \
      REWRITE_TAC(PairList [LE, LT, NOT_SUC])
    ]
  )

def LTE_ANTISYM:
  prove(
    [
      @hol|{!m n. ~(m < n /\ n <= m)}|,
      ONCE_REWRITE_TAC(PairList [CONJ_SYM]) then_tac \
      REWRITE_TAC(PairList [LET_ANTISYM])
    ]
  )

def LE_TRANS:
  prove(
    [
      @hol|{!m n p. m <= n /\ n <= p ==> m <= p}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LE_0]) then_tac \
      REWRITE_TAC(PairList [LE, NOT_SUC])
    ]
  )

def LT_TRANS:
  prove(
    [
      @hol|{!m n p. m < n /\ n < p ==> m < p}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LT_SUC, LT_0]) then_tac \
      REWRITE_TAC(PairList [LT, NOT_SUC])
    ]
  )

def LET_TRANS:
  prove(
    [
      @hol|{!m n p. m <= n /\ n < p ==> m < p}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC, LT_0]) then_tac \
      REWRITE_TAC(PairList [LT, LE, NOT_SUC])
    ]
  )

def LTE_TRANS:
  prove(
    [
      @hol|{!m n p. m < n /\ n <= p ==> m < p}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC, LT_0]) then_tac \
      REWRITE_TAC(PairList [LT, LE, NOT_SUC])
    ]
  )

def LE_CASES:
  prove(
    [
      @hol|{!m n. m <= n \/ n <= m}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_0, LE_SUC])
    ]
  )

def LT_CASES:
  prove(
    [
      @hol|{!m n. (m < n) \/ (n < m) \/ (m = n)}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LT_SUC, SUC_INJ]) then_tac \
      REWRITE_TAC(PairList [LT, NOT_SUC, GSYM(NOT_SUC)]) then_tac \
      W(o(o(o(W(curry(SPEC_TAC)))(hd))(frees))(snd)) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [LT_0])
    ]
  )

def LET_CASES:
  prove(
    [
      @hol|{!m n. m <= n \/ n < m}|,
      REPEAT(INDUCT_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [LE_SUC_LT, LT_SUC_LE, LE_0])
    ]
  )

def LTE_CASES:
  prove(
    [
      @hol|{!m n. m < n \/ n <= m}|,
      ONCE_REWRITE_TAC(PairList [DISJ_SYM]) then_tac MATCH_ACCEPT_TAC(LET_CASES)
    ]
  )

def LE_LT:
  prove(
    [
      @hol|{!m n. (m <= n) <=> (m < n) \/ (m = n)}|,
      REPEAT(INDUCT_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC, SUC_INJ, LE_0, LT_0]) then_tac \
      REWRITE_TAC(PairList [LE, LT])
    ]
  )

def LT_LE:
  prove(
    [
      @hol|{!m n. (m < n) <=> (m <= n) /\ ~(m = n)}|,
      REWRITE_TAC(PairList [LE_LT]) then_tac REPEAT(GEN_TAC) then_tac \
      EQ_TAC then_list \
      PairList [
        DISCH_TAC then_tac ASM_REWRITE_TAC(PairList []) then_tac \
        DISCH_THEN(SUBST_ALL_TAC) then_tac \
        POP_ASSUM(MP_TAC) then_tac \
        REWRITE_TAC(PairList [LT_REFL]),
        DISCH_THEN(CONJUNCTS_THEN2(STRIP_ASSUME_TAC)(MP_TAC)) then_tac \
        ASM_REWRITE_TAC(PairList [])
      ]
    ]
  )

def NOT_LE:
  prove(
    [
      @hol|{!m n. ~(m <= n) <=> (n < m)}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC]) then_tac \
      REWRITE_TAC(PairList [LE, LT, NOT_SUC, GSYM(NOT_SUC), LE_0]) then_tac \
      W(o(o(o(W(curry(SPEC_TAC)))(hd))(frees))(snd)) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [LT_0])
    ]
  )

def NOT_LT:
  prove(
    [
      @hol|{!m n. ~(m < n) <=> n <= m}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_SUC, LT_SUC]) then_tac \
      REWRITE_TAC(PairList [LE, LT, NOT_SUC, GSYM(NOT_SUC), LE_0]) then_tac \
      W(o(o(o(W(curry(SPEC_TAC)))(hd))(frees))(snd)) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [LT_0])
    ]
  )

def LT_IMP_LE:
  prove(
    [
      @hol|{!m n. m < n ==> m <= n}|,
      REWRITE_TAC(PairList [LT_LE]) then_tac REPEAT(STRIP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def EQ_IMP_LE:
  prove(
    [
      @hol|{!m n. (m = n) ==> m <= n}|,
      REPEAT(STRIP_TAC) then_tac ASM_REWRITE_TAC(PairList [LE_REFL])
    ]
  )

def LT_NZ:
  prove(
    [
      @hol|{!n. 0 < n <=> ~(n = 0)}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [NOT_SUC, LT, EQ_SYM_EQ]) then_tac \
      CONV_TAC(TAUT)
    ]
  )

def LE_1:
  prove(
    [
      @hol|{(!n. ~(n = 0) ==> 0 < n) /\
         (!n. ~(n = 0) ==> 1 <= n) /\
         (!n. 0 < n ==> ~(n = 0)) /\
         (!n. 0 < n ==> 1 <= n) /\
         (!n. 1 <= n ==> 0 < n) /\
         (!n. 1 <= n ==> ~(n = 0))}|,
      REWRITE_TAC(PairList [LT_NZ, GSYM(NOT_LT), ONE, LT])
    ]
  )

def LE_EXISTS:
  prove(
    [
      @hol|{!m n. (m <= n) <=> (?d. n = m + d)}|,
      GEN_TAC then_tac INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [LE]) then_list \
      PairList [
        REWRITE_TAC(PairList [CONV_RULE(LAND_CONV(SYM_CONV))(SPEC_ALL(ADD_EQ_0))]) then_tac \
        REWRITE_TAC(PairList [RIGHT_EXISTS_AND_THM, EXISTS_REFL]),
        EQ_TAC then_list \
        PairList [
          DISCH_THEN(DISJ_CASES_THEN2(SUBST1_TAC)(MP_TAC)) then_list \
          PairList [
            EXISTS_TAC(@hol|{0}|) then_tac \
            REWRITE_TAC(PairList [ADD_CLAUSES]),
            DISCH_THEN(X_CHOOSE_THEN(@hol|{d:num}|)(SUBST1_TAC)) then_tac \
            EXISTS_TAC(@hol|{SUC d}|) then_tac \
            REWRITE_TAC(PairList [ADD_CLAUSES])
          ],
          ONCE_REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac INDUCT_TAC then_tac \
          REWRITE_TAC(PairList [ADD_CLAUSES, SUC_INJ]) then_tac \
          DISCH_THEN(SUBST1_TAC) then_tac \
          REWRITE_TAC(PairList []) then_tac \
          DISJ2_TAC then_tac \
          REWRITE_TAC(PairList [EQ_ADD_LCANCEL, GSYM(EXISTS_REFL)])
        ]
      ]
    ]
  )

def LT_EXISTS:
  prove(
    [
      @hol|{!m n. (m < n) <=> (?d. n = m + SUC d)}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [LT, ADD_CLAUSES, GSYM(NOT_SUC)]) then_tac \
      ASM_REWRITE_TAC(PairList [SUC_INJ]) then_tac \
      EQ_TAC then_list \
      PairList [
        DISCH_THEN(DISJ_CASES_THEN2(SUBST1_TAC)(MP_TAC)) then_list \
        PairList [
          EXISTS_TAC(@hol|{0}|) then_tac \
          REWRITE_TAC(PairList [ADD_CLAUSES]),
          DISCH_THEN(X_CHOOSE_THEN(@hol|{d:num}|)(SUBST1_TAC)) then_tac \
          EXISTS_TAC(@hol|{SUC d}|) then_tac \
          REWRITE_TAC(PairList [ADD_CLAUSES])
        ],
        ONCE_REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac INDUCT_TAC then_tac \
        REWRITE_TAC(PairList [ADD_CLAUSES, SUC_INJ]) then_tac \
        DISCH_THEN(SUBST1_TAC) then_tac \
        REWRITE_TAC(PairList []) then_tac \
        DISJ2_TAC then_tac \
        REWRITE_TAC(PairList [SUC_INJ, EQ_ADD_LCANCEL, GSYM(EXISTS_REFL)])
      ]
    ]
  )

def LE_ADD:
  prove(
    [
      @hol|{!m n. m <= m + n}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [LE, ADD_CLAUSES, LE_REFL])
    ]
  )

def LE_ADDR:
  prove(
    [
      @hol|{!m n. n <= m + n}|,
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(LE_ADD)
    ]
  )

def LT_ADD:
  prove(
    [
      @hol|{!m n. (m < m + n) <=> (0 < n)}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES, LT_SUC])
    ]
  )

def LT_ADDR:
  prove(
    [
      @hol|{!m n. (n < m + n) <=> (0 < m)}|,
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(LT_ADD)
    ]
  )

def LE_ADD_LCANCEL:
  prove(
    [
      @hol|{!m n p. (m + n) <= (m + p) <=> n <= p}|,
      REWRITE_TAC(PairList [LE_EXISTS, GSYM(ADD_ASSOC), EQ_ADD_LCANCEL])
    ]
  )

def LE_ADD_RCANCEL:
  prove(
    [
      @hol|{!m n p. (m + p) <= (n + p) <=> (m <= n)}|,
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(LE_ADD_LCANCEL)
    ]
  )

def LT_ADD_LCANCEL:
  prove(
    [
      @hol|{!m n p. (m + n) < (m + p) <=> n < p}|,
      REWRITE_TAC(PairList [LT_EXISTS, GSYM(ADD_ASSOC), EQ_ADD_LCANCEL, SUC_INJ])
    ]
  )

def LT_ADD_RCANCEL:
  prove(
    [
      @hol|{!m n p. (m + p) < (n + p) <=> (m < n)}|,
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(LT_ADD_LCANCEL)
    ]
  )

def LE_ADD2:
  prove(
    [
      @hol|{!m n p q. m <= p /\ n <= q ==> m + n <= p + q}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [LE_EXISTS]) then_tac \
      DISCH_THEN(
        CONJUNCTS_THEN2(X_CHOOSE_TAC(@hol|{a:num}|))(X_CHOOSE_TAC(@hol|{b:num}|))
      ) then_tac \
      EXISTS_TAC(@hol|{a + b}|) then_tac \
      ASM_REWRITE_TAC(PairList [ADD_AC])
    ]
  )

def LET_ADD2:
  prove(
    [
      @hol|{!m n p q. m <= p /\ n < q ==> m + n < p + q}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [LE_EXISTS, LT_EXISTS]) then_tac \
      DISCH_THEN(
        CONJUNCTS_THEN2(X_CHOOSE_TAC(@hol|{a:num}|))(X_CHOOSE_TAC(@hol|{b:num}|))
      ) then_tac \
      EXISTS_TAC(@hol|{a + b}|) then_tac \
      ASM_REWRITE_TAC(PairList [SUC_INJ, ADD_CLAUSES, ADD_AC])
    ]
  )

def LTE_ADD2:
  prove(
    [
      @hol|{!m n p q. m < p /\ n <= q ==> m + n < p + q}|,
      ONCE_REWRITE_TAC(PairList [ADD_SYM, CONJ_SYM]) then_tac \
      MATCH_ACCEPT_TAC(LET_ADD2)
    ]
  )

def LT_ADD2:
  prove(
    [
      @hol|{!m n p q. m < p /\ n < q ==> m + n < p + q}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(LTE_ADD2) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      MATCH_MP_TAC(LT_IMP_LE) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def LT_MULT:
  prove(
    [
      @hol|{!m n. (0 < m * n) <=> (0 < m) /\ (0 < n)}|,
      REPEAT(INDUCT_TAC) then_tac \
      REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, LT_0])
    ]
  )

def LE_MULT2:
  prove(
    [
      @hol|{!m n p q. m <= n /\ p <= q ==> m * p <= n * q}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [LE_EXISTS]) then_tac \
      DISCH_THEN(
        CONJUNCTS_THEN2(X_CHOOSE_TAC(@hol|{a:num}|))(X_CHOOSE_TAC(@hol|{b:num}|))
      ) then_tac \
      EXISTS_TAC(
        @hol|{a * p + m * b + a * b}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [LEFT_ADD_DISTRIB]) then_tac \
      REWRITE_TAC(PairList [LEFT_ADD_DISTRIB, RIGHT_ADD_DISTRIB, ADD_ASSOC])
    ]
  )

def LT_LMULT:
  prove(
    [
      @hol|{!m n p. ~(m = 0) /\ n < p ==> m * n < m * p}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [LT_LE]) then_tac \
      STRIP_TAC then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(LE_MULT2) then_tac ASM_REWRITE_TAC(PairList [LE_REFL]),
        ASM_REWRITE_TAC(PairList [EQ_MULT_LCANCEL])
      ]
    ]
  )

def LE_MULT_LCANCEL:
  prove(
    [
      @hol|{!m n p. (m * n) <= (m * p) <=> (m = 0) \/ n <= p}|,
      REPEAT(INDUCT_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, LE_REFL, LE_0, NOT_SUC]) then_tac \
      REWRITE_TAC(PairList [LE_SUC]) then_tac \
      REWRITE_TAC(PairList [LE, LE_ADD_LCANCEL, GSYM(ADD_ASSOC)]) then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(el(4)(CONJUNCTS(MULT_CLAUSES))), NOT_SUC])
    ]
  )

def LE_MULT_RCANCEL:
  prove(
    [
      @hol|{!m n p. (m * p) <= (n * p) <=> (m <= n) \/ (p = 0)}|,
      ONCE_REWRITE_TAC(PairList [MULT_SYM, DISJ_SYM]) then_tac \
      MATCH_ACCEPT_TAC(LE_MULT_LCANCEL)
    ]
  )

def LT_MULT_LCANCEL:
  prove(
    [
      @hol|{!m n p. (m * n) < (m * p) <=> ~(m = 0) /\ n < p}|,
      REPEAT(INDUCT_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, LT_REFL, LT_0, NOT_SUC]) then_tac \
      REWRITE_TAC(PairList [LT_SUC]) then_tac \
      REWRITE_TAC(PairList [LT, LT_ADD_LCANCEL, GSYM(ADD_ASSOC)]) then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(el(4)(CONJUNCTS(MULT_CLAUSES))), NOT_SUC])
    ]
  )

def LT_MULT_RCANCEL:
  prove(
    [
      @hol|{!m n p. (m * p) < (n * p) <=> (m < n) /\ ~(p = 0)}|,
      ONCE_REWRITE_TAC(PairList [MULT_SYM, CONJ_SYM]) then_tac \
      MATCH_ACCEPT_TAC(LT_MULT_LCANCEL)
    ]
  )

def LT_MULT2:
  prove(
    [
      @hol|{!m n p q. m < n /\ p < q ==> m * p < n * q}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(LET_TRANS) then_tac \
      EXISTS_TAC(@hol|{n * p}|) then_tac \
      ASM_SIMP_TAC(PairList [LE_MULT_RCANCEL, LT_IMP_LE, LT_MULT_LCANCEL]) then_tac \
      UNDISCH_TAC(@hol|{m < n}|) then_tac \
      CONV_TAC(CONTRAPOS_CONV) then_tac \
      SIMP_TAC(PairList [LT])
    ]
  )

def LE_SQUARE_REFL:
  prove(
    [
      @hol|{!n. n <= n * n}|,
      INDUCT_TAC then_tac REWRITE_TAC(PairList [MULT_CLAUSES, LE_0, LE_ADDR])
    ]
  )

def LT_POW2_REFL:
  prove(
    [
      @hol|{!n. n < 2 EXP n}|,
      INDUCT_TAC then_tac REWRITE_TAC(PairList [EXP]) then_tac \
      REWRITE_TAC(PairList [MULT_2, ADD1]) then_tac \
      REWRITE_TAC(PairList [ONE, LT]) then_tac \
      MATCH_MP_TAC(LTE_ADD2) then_tac \
      ASM_REWRITE_TAC(PairList [LE_SUC_LT, TWO]) then_tac \
      MESON_TAC(PairList [EXP_EQ_0, LE_1, NOT_SUC])
    ]
  )

def WLOG_LE:
  prove(
    [
      @hol|{(!m n. P m n <=> P n m) /\ (!m n. m <= n ==> P m n) ==> !m n. P m n}|,
      MESON_TAC(PairList [LE_CASES])
    ]
  )

def WLOG_LT:
  prove(
    [
      @hol|{(!m. P m m) /\ (!m n. P m n <=> P n m) /\ (!m n. m < n ==> P m n)
         ==> !m y. P m y}|,
      MESON_TAC(PairList [LT_CASES])
    ]
  )

def WLOG_LE_3:
  prove(
    [
      @hol|{!P. (!x y z. P x y z ==> P y x z /\ P x z y) /\
         (!x y z. x <= y /\ y <= z ==> P x y z)
         ==> !x y z. P x y z}|,
      MESON_TAC(PairList [LE_CASES])
    ]
  )

def num_WF:
  prove(
    [
      @hol|{!P. (!n. (!m. m < n ==> P m) ==> P n) ==> !n. P n}|,
      GEN_TAC then_tac \
      MP_TAC(
        SPEC(
          @hol|{\n. !m. m < n ==> P m}|
        )(num_INDUCTION)
      ) then_tac \
      REWRITE_TAC(PairList [LT, BETA_THM]) then_tac \
      MESON_TAC(PairList [LT])
    ]
  )

def num_WOP:
  prove(
    [
      @hol|{!P. (?n. P n) <=> (?n. P(n) /\ !m. m < n ==> ~P(m))}|,
      GEN_TAC then_tac EQ_TAC then_list \
      PairList [ALL_TAC, MESON_TAC(PairList [])] then_tac \
      CONV_TAC(CONTRAPOS_CONV) then_tac \
      REWRITE_TAC(PairList [NOT_EXISTS_THM]) then_tac \
      DISCH_TAC then_tac \
      MATCH_MP_TAC(num_WF) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def num_MAX:
  prove(
    [
      @hol|{!P. (?x. P x) /\ (?M. !x. P x ==> x <= M) <=>
         ?m. P m /\ (!x. P x ==> x <= m)}|,
      GEN_TAC then_tac EQ_TAC then_list \
      PairList [
        DISCH_THEN(CONJUNCTS_THEN2(X_CHOOSE_TAC(@hol|{a:num}|))(MP_TAC)) then_tac \
        DISCH_THEN(
          o(X_CHOOSE_THEN(@hol|{m:num}|)(MP_TAC))(ONCE_REWRITE_RULE(PairList [num_WOP]))
        ) then_tac \
        DISCH_THEN((fun(th): (EXISTS_TAC(@hol|{m:num}|) then_tac MP_TAC(th)))) then_tac \
        REWRITE_TAC(
          PairList [
            TAUT(
              @hol|{(a /\ b ==> c /\ a) <=> (a /\ b ==> c)}|
            )
          ]
        ) then_tac \
        SPEC_TAC([@hol|{m:num}|, @hol|{m:num}|]) then_tac \
        INDUCT_TAC then_list \
        PairList [
          REWRITE_TAC(PairList [LE, LT]) then_tac \
          DISCH_THEN(IMP_RES_THEN(SUBST_ALL_TAC)) then_tac \
          POP_ASSUM(ACCEPT_TAC),
          DISCH_THEN(
            CONJUNCTS_THEN2(ASSUME_TAC)(o(MP_TAC)(SPEC(@hol|{m:num}|)))
          ) then_tac \
          REWRITE_TAC(PairList [LT]) then_tac \
          CONV_TAC(CONTRAPOS_CONV) then_tac \
          DISCH_TAC then_tac \
          REWRITE_TAC(PairList []) then_tac \
          X_GEN_TAC(@hol|{p:num}|) then_tac \
          FIRST_ASSUM(o(MP_TAC)(SPEC(@hol|{p:num}|))) then_tac \
          REWRITE_TAC(PairList [LE]) then_tac \
          ASM_CASES_TAC(@hol|{p = SUC m}|) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ],
        REPEAT(STRIP_TAC) then_tac EXISTS_TAC(@hol|{m:num}|) then_tac \
        ASM_REWRITE_TAC(PairList [])
      ]
    ]
  )

def LE_INDUCT:
  prove(
    [
      @hol|{!P. (!m:num. P m m) /\
         (!m n. m <= n /\ P m n ==> P m (SUC n))
         ==> (!m n. m <= n ==> P m n)}|,
      GEN_TAC then_tac \
      REWRITE_TAC(
        PairList [
          IMP_CONJ,
          MESON(
            PairList [LE_EXISTS])(
            @hol|{(!m n:num. m <= n ==> R m n) <=> (!m d. R m (m + d))}|
          )
        ]
      ) then_tac \
      REPEAT(DISCH_TAC) then_tac \
      GEN_TAC then_tac \
      INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [ADD_CLAUSES])
    ]
  )

def num_INDUCTION_DOWN:
  prove(
    [
      @hol|{!(P:num->bool) m.
         (!n. m <= n ==> P n) /\
         (!n. n < m /\ P(n + 1) ==> P n)
         ==> !n. P n}|,
      REWRITE_TAC(PairList [GSYM(ADD1)]) then_tac REPEAT(GEN_TAC) then_tac \
      STRIP_TAC then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(!x. P x) <=> ~(?x. ~P x)}|
          )
        ]
      ) then_tac \
      W(
        o(o(o(MP_TAC)(PART_MATCH(o(lhand)(lhand))(num_MAX)))(rand))(snd)
      ) then_tac \
      MATCH_MP_TAC(
        TAUT(
          @hol|{q /\ ~r ==> (p /\ q <=> r) ==> ~p}|
        )
      ) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{~p ==> q <=> ~q ==> p}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          NOT_EXISTS_THM,
          TAUT(
            @hol|{~(~p /\ q) <=> q ==> p}|
          ),
          NOT_LE
        ]
      ) then_tac \
      ASM_MESON_TAC(PairList [LTE_CASES, LT, LT_IMP_LE])
    ]
  )

def EVEN:
  new_recursive_definition(num_RECURSION)(
    @hol|{(EVEN 0 <=> T) /\
       (!n. EVEN (SUC n) <=> ~(EVEN n))}|
  )

def ODD:
  new_recursive_definition(num_RECURSION)(
    @hol|{(ODD 0 <=> F) /\
       (!n. ODD (SUC n) <=> ~(ODD n))}|
  )

def NOT_EVEN:
  prove(
    [
      @hol|{!n. ~(EVEN n) <=> ODD n}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EVEN, ODD])
    ]
  )

def NOT_ODD:
  prove(
    [
      @hol|{!n. ~(ODD n) <=> EVEN n}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EVEN, ODD])
    ]
  )

def EVEN_OR_ODD:
  prove(
    [
      @hol|{!n. EVEN n \/ ODD n}|,
      INDUCT_TAC then_tac REWRITE_TAC(PairList [EVEN, ODD, NOT_EVEN, NOT_ODD]) then_tac \
      ONCE_REWRITE_TAC(PairList [DISJ_SYM]) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def EVEN_AND_ODD:
  prove(
    [
      @hol|{!n. ~(EVEN n /\ ODD n)}|,
      REWRITE_TAC(
        PairList [
          GSYM(NOT_EVEN),
          ITAUT(@hol|{~(p /\ ~p)}|)
        ]
      )
    ]
  )

def EVEN_ADD:
  prove(
    [
      @hol|{!m n. EVEN(m + n) <=> (EVEN m <=> EVEN n)}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EVEN, ADD_CLAUSES]) then_tac \
      X_GEN_TAC(@hol|{p:num}|) then_tac \
      DISJ_CASES_THEN(MP_TAC)(SPEC(@hol|{n:num}|)(EVEN_OR_ODD)) then_tac \
      DISJ_CASES_THEN(MP_TAC)(SPEC(@hol|{p:num}|)(EVEN_OR_ODD)) then_tac \
      REWRITE_TAC(PairList [GSYM(NOT_EVEN)]) then_tac \
      DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def EVEN_MULT:
  prove(
    [
      @hol|{!m n. EVEN(m * n) <=> EVEN(m) \/ EVEN(n)}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MULT_CLAUSES, EVEN_ADD, EVEN]) then_tac \
      X_GEN_TAC(@hol|{p:num}|) then_tac \
      DISJ_CASES_THEN(MP_TAC)(SPEC(@hol|{n:num}|)(EVEN_OR_ODD)) then_tac \
      DISJ_CASES_THEN(MP_TAC)(SPEC(@hol|{p:num}|)(EVEN_OR_ODD)) then_tac \
      REWRITE_TAC(PairList [GSYM(NOT_EVEN)]) then_tac \
      DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def EVEN_EXP:
  prove(
    [
      @hol|{!m n. EVEN(m EXP n) <=> EVEN(m) /\ ~(n = 0)}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [EVEN, EXP, ONE, EVEN_MULT, NOT_SUC]) then_tac \
      CONV_TAC(ITAUT)
    ]
  )

def ODD_ADD:
  prove(
    [
      @hol|{!m n. ODD(m + n) <=> ~(ODD m <=> ODD n)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [GSYM(NOT_EVEN), EVEN_ADD]) then_tac \
      CONV_TAC(ITAUT)
    ]
  )

def ODD_MULT:
  prove(
    [
      @hol|{!m n. ODD(m * n) <=> ODD(m) /\ ODD(n)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [GSYM(NOT_EVEN), EVEN_MULT]) then_tac \
      CONV_TAC(ITAUT)
    ]
  )

def ODD_EXP:
  prove(
    [
      @hol|{!m n. ODD(m EXP n) <=> ODD(m) \/ (n = 0)}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ODD, EXP, ONE, ODD_MULT, NOT_SUC]) then_tac \
      CONV_TAC(ITAUT)
    ]
  )

def EVEN_DOUBLE:
  prove(
    [
      @hol|{!n. EVEN(2 * n)}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [EVEN_MULT]) then_tac DISJ1_TAC then_tac \
      PURE_REWRITE_TAC(PairList [BIT0_THM, BIT1_THM]) then_tac \
      REWRITE_TAC(PairList [EVEN, EVEN_ADD])
    ]
  )

def ODD_DOUBLE:
  prove(
    [
      @hol|{!n. ODD(SUC(2 * n))}|,
      REWRITE_TAC(PairList [ODD]) then_tac REWRITE_TAC(PairList [NOT_ODD, EVEN_DOUBLE])
    ]
  )

def EVEN_EXISTS_LEMMA:
  prove(
    [
      @hol|{!n. (EVEN n ==> ?m. n = 2 * m) /\
         (~EVEN n ==> ?m. n = SUC(2 * m))}|,
      INDUCT_TAC then_tac REWRITE_TAC(PairList [EVEN]) then_list \
      PairList [
        EXISTS_TAC(@hol|{0}|) then_tac \
        REWRITE_TAC(PairList [MULT_CLAUSES]),
        POP_ASSUM(STRIP_ASSUME_TAC) then_tac CONJ_TAC then_tac \
        DISCH_THEN(ANTE_RES_THEN(X_CHOOSE_TAC(@hol|{m:num}|))) then_list \
        PairList [
          EXISTS_TAC(@hol|{SUC m}|) then_tac \
          ASM_REWRITE_TAC(PairList []) then_tac \
          REWRITE_TAC(PairList [MULT_2]) then_tac \
          REWRITE_TAC(PairList [ADD_CLAUSES]),
          EXISTS_TAC(@hol|{m:num}|) then_tac ASM_REWRITE_TAC(PairList [])
        ]
      ]
    ]
  )

def EVEN_EXISTS:
  prove(
    [
      @hol|{!n. EVEN n <=> ?m. n = 2 * m}|,
      GEN_TAC then_tac EQ_TAC then_tac DISCH_TAC then_list \
      PairList [
        MATCH_MP_TAC(CONJUNCT1(SPEC_ALL(EVEN_EXISTS_LEMMA))) then_tac \
        ASM_REWRITE_TAC(PairList []),
        POP_ASSUM(CHOOSE_THEN(SUBST1_TAC)) then_tac \
        REWRITE_TAC(PairList [EVEN_DOUBLE])
      ]
    ]
  )

def ODD_EXISTS:
  prove(
    [
      @hol|{!n. ODD n <=> ?m. n = SUC(2 * m)}|,
      GEN_TAC then_tac EQ_TAC then_tac DISCH_TAC then_list \
      PairList [
        MATCH_MP_TAC(CONJUNCT2(SPEC_ALL(EVEN_EXISTS_LEMMA))) then_tac \
        ASM_REWRITE_TAC(PairList [NOT_EVEN]),
        POP_ASSUM(CHOOSE_THEN(SUBST1_TAC)) then_tac \
        REWRITE_TAC(PairList [ODD_DOUBLE])
      ]
    ]
  )

def EVEN_ODD_DECOMPOSITION:
  prove(
    [
      @hol|{!n. (?k m. ODD m /\ (n = 2 EXP k * m)) <=> ~(n = 0)}|,
      MATCH_MP_TAC(num_WF) then_tac X_GEN_TAC(@hol|{n:num}|) then_tac \
      DISCH_TAC then_tac \
      DISJ_CASES_TAC(SPEC(@hol|{n:num}|)(EVEN_OR_ODD)) then_list \
      PairList [ALL_TAC, ASM_MESON_TAC(PairList [ODD, EXP, MULT_CLAUSES])] then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [EVEN_EXISTS]))) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{m:num}|)(SUBST_ALL_TAC)) then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(SPEC(@hol|{m:num}|))) then_tac \
      ASM_CASES_TAC(
        @hol|{m = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_EQ_0]) then_list \
      PairList [
        REWRITE_TAC(PairList [MULT_CLAUSES, LT]) then_tac \
        CONV_TAC(ONCE_DEPTH_CONV(SYM_CONV)) then_tac \
        REWRITE_TAC(PairList [EXP_EQ_0, MULT_EQ_0, TWO, NOT_SUC]) then_tac \
        MESON_TAC(PairList [ODD]),
        ALL_TAC
      ] then_tac \
      ANTS_TAC then_list \
      PairList [
        GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(el(2)(CONJUNCTS(MULT_CLAUSES)))]) then_tac \
        ASM_REWRITE_TAC(PairList [LT_MULT_RCANCEL, TWO, LT]),
        ALL_TAC
      ] then_tac \
      REWRITE_TAC(PairList [TWO, NOT_SUC]) then_tac \
      REWRITE_TAC(PairList [GSYM(TWO)]) then_tac \
      ONCE_REWRITE_TAC(PairList [SWAP_EXISTS_THM]) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      X_GEN_TAC(@hol|{p:num}|) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{k:num}|)(STRIP_ASSUME_TAC)) then_tac \
      EXISTS_TAC(@hol|{SUC k}|) then_tac \
      ASM_REWRITE_TAC(PairList [EXP, MULT_ASSOC])
    ]
  )

def SUB:
  new_recursive_definition(num_RECURSION)(
    @hol|{(!m. m - 0 = m) /\
       (!m n. m - (SUC n) = PRE(m - n))}|
  )

def SUB_0:
  prove(
    [
      @hol|{!m. (0 - m = 0) /\ (m - 0 = m)}|,
      REWRITE_TAC(PairList [SUB]) then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [SUB, PRE])
    ]
  )

def SUB_PRESUC:
  prove(
    [
      @hol|{!m n. PRE(SUC m - n) = m - n}|,
      GEN_TAC then_tac INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [SUB, PRE])
    ]
  )

def SUB_SUC:
  prove(
    [
      @hol|{!m n. SUC m - SUC n = m - n}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [SUB, PRE, SUB_PRESUC])
    ]
  )

def SUB_REFL:
  prove(
    [
      @hol|{!n. n - n = 0}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [SUB_SUC, SUB_0])
    ]
  )

def ADD_SUB:
  prove(
    [
      @hol|{!m n. (m + n) - n = m}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ADD_CLAUSES, SUB_SUC, SUB_0])
    ]
  )

def ADD_SUB2:
  prove(
    [
      @hol|{!m n. (m + n) - m = n}|,
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(ADD_SUB)
    ]
  )

def SUB_EQ_0:
  prove(
    [
      @hol|{!m n. (m - n = 0) <=> m <= n}|,
      REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [SUB_SUC, LE_SUC, SUB_0]) then_tac \
      REWRITE_TAC(PairList [LE, LE_0])
    ]
  )

def ADD_SUBR2:
  prove(
    [
      @hol|{!m n. m - (m + n) = 0}|,
      REWRITE_TAC(PairList [SUB_EQ_0, LE_ADD])
    ]
  )

def ADD_SUBR:
  prove(
    [
      @hol|{!m n. n - (m + n) = 0}|,
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(ADD_SUBR2)
    ]
  )

def SUB_ADD:
  prove(
    [
      @hol|{!m n. n <= m ==> ((m - n) + n = m)}|,
      REWRITE_TAC(PairList [LE_EXISTS]) then_tac REPEAT(STRIP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [ONCE_REWRITE_RULE(PairList [ADD_SYM])(ADD_SUB)]) then_tac \
      MATCH_ACCEPT_TAC(ADD_SYM)
    ]
  )

def SUB_ADD_LCANCEL:
  prove(
    [
      @hol|{!m n p. (m + n) - (m + p) = n - p}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES, SUB_0, SUB_SUC])
    ]
  )

def SUB_ADD_RCANCEL:
  prove(
    [
      @hol|{!m n p. (m + p) - (n + p) = m - n}|,
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(SUB_ADD_LCANCEL)
    ]
  )

def LEFT_SUB_DISTRIB:
  prove(
    [
      @hol|{!m n p. m * (n - p) = m * n - m * p}|,
      REPEAT(GEN_TAC) then_tac CONV_TAC(SYM_CONV) then_tac \
      DISJ_CASES_TAC(SPECL(PairList [@hol|{n:num}|, @hol|{p:num}|])(LE_CASES)) then_list \
      PairList [
        FIRST_ASSUM((fun(th): REWRITE_TAC(PairList [REWRITE_RULE(PairList [GSYM(SUB_EQ_0)])(th)]))) then_tac \
        ASM_REWRITE_TAC(PairList [MULT_CLAUSES, SUB_EQ_0, LE_MULT_LCANCEL]),
        POP_ASSUM(o(CHOOSE_THEN(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))) then_tac \
        REWRITE_TAC(PairList [LEFT_ADD_DISTRIB]) then_tac \
        REWRITE_TAC(PairList [ONCE_REWRITE_RULE(PairList [ADD_SYM])(ADD_SUB)])
      ]
    ]
  )

def RIGHT_SUB_DISTRIB:
  prove(
    [
      @hol|{!m n p. (m - n) * p = m * p - n * p}|,
      ONCE_REWRITE_TAC(PairList [MULT_SYM]) then_tac MATCH_ACCEPT_TAC(LEFT_SUB_DISTRIB)
    ]
  )

def SUC_SUB1:
  prove(
    [
      @hol|{!n. SUC n - 1 = n}|,
      REWRITE_TAC(PairList [ONE, SUB_SUC, SUB_0])
    ]
  )

def EVEN_SUB:
  prove(
    [
      @hol|{!m n. EVEN(m - n) <=> m <= n \/ (EVEN(m) <=> EVEN(n))}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(@hol|{m <= n:num}|) then_list \
      PairList [ASM_MESON_TAC(PairList [SUB_EQ_0, EVEN]), ALL_TAC] then_tac \
      DISJ_CASES_TAC(SPECL(PairList [@hol|{m:num}|, @hol|{n:num}|])(LE_CASES)) then_tac \
      ASM_SIMP_TAC(PairList []) then_tac \
      FIRST_ASSUM(
        o(o(MP_TAC)(AP_TERM(@hol|{EVEN}|)))(MATCH_MP(SUB_ADD))
      ) then_tac \
      ASM_MESON_TAC(PairList [EVEN_ADD])
    ]
  )

def ODD_SUB:
  prove(
    [
      @hol|{!m n. ODD(m - n) <=> n < m /\ ~(ODD m <=> ODD n)}|,
      REWRITE_TAC(PairList [GSYM(NOT_EVEN), EVEN_SUB, DE_MORGAN_THM, NOT_LE]) then_tac \
      CONV_TAC(TAUT)
    ]
  )

def FACT:
  new_recursive_definition(num_RECURSION)(
    @hol|{(FACT 0 = 1) /\
       (!n. FACT (SUC n) = (SUC n) * FACT(n))}|
  )

def FACT_LT:
  prove(
    [
      @hol|{!n. 0 < FACT n}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [FACT, LT_MULT]) then_tac \
      REWRITE_TAC(PairList [ONE, LT_0])
    ]
  )

def FACT_LE:
  prove(
    [
      @hol|{!n. 1 <= FACT n}|,
      REWRITE_TAC(PairList [ONE, LE_SUC_LT, FACT_LT])
    ]
  )

def FACT_NZ:
  prove(
    [
      @hol|{!n. ~(FACT n = 0)}|,
      REWRITE_TAC(PairList [GSYM(LT_NZ), FACT_LT])
    ]
  )

def FACT_MONO:
  prove(
    [
      @hol|{!m n. m <= n ==> FACT m <= FACT n}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN(
        o(X_CHOOSE_THEN(@hol|{d:num}|)(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))
      ) then_tac \
      SPEC_TAC([@hol|{d:num}|, @hol|{d:num}|]) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [ADD_CLAUSES, LE_REFL]) then_tac \
      REWRITE_TAC(PairList [FACT]) then_tac \
      MATCH_MP_TAC(LE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{FACT(m + d)}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(el(2)(CONJUNCTS(MULT_CLAUSES)))]) then_tac \
      REWRITE_TAC(PairList [LE_MULT_RCANCEL]) then_tac \
      REWRITE_TAC(PairList [ONE, LE_SUC, LE_0])
    ]
  )

def EXP_LT_0:
  prove(
    [
      @hol|{!n x. 0 < x EXP n <=> ~(x = 0) \/ (n = 0)}|,
      REWRITE_TAC(PairList [GSYM(NOT_LE), LE, EXP_EQ_0, DE_MORGAN_THM])
    ]
  )

def LT_EXP:
  prove(
    [
      @hol|{!x m n. x EXP m < x EXP n <=> 2 <= x /\ m < n \/
         (x = 0) /\ ~(m = 0) /\ (n = 0)}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{x = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_list \
      PairList [
        REWRITE_TAC(PairList [GSYM(NOT_LT), TWO, ONE, LT]) then_tac \
        SPEC_TAC([@hol|{n:num}|, @hol|{n:num}|]) then_tac \
        INDUCT_TAC then_tac \
        REWRITE_TAC(PairList [EXP, NOT_SUC, MULT_CLAUSES, LT]) then_tac \
        SPEC_TAC([@hol|{m:num}|, @hol|{m:num}|]) then_tac \
        INDUCT_TAC then_tac \
        REWRITE_TAC(PairList [EXP, MULT_CLAUSES, NOT_SUC, LT_REFL, LT]) then_tac \
        REWRITE_TAC(PairList [ONE, LT_0]),
        ALL_TAC
      ] then_tac \
      EQ_TAC then_list \
      PairList [
        CONV_TAC(CONTRAPOS_CONV) then_tac \
        REWRITE_TAC(PairList [NOT_LT, DE_MORGAN_THM, NOT_LE]) then_tac \
        REWRITE_TAC(PairList [TWO, ONE, LT]) then_tac \
        ASM_REWRITE_TAC(PairList [SYM(ONE)]) then_tac \
        STRIP_TAC then_tac \
        ASM_REWRITE_TAC(PairList [EXP_ONE, LE_REFL]) then_tac \
        FIRST_ASSUM(
          o(X_CHOOSE_THEN(@hol|{d:num}|)(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))
        ) then_tac \
        SPEC_TAC([@hol|{d:num}|, @hol|{d:num}|]) then_tac \
        INDUCT_TAC then_tac \
        REWRITE_TAC(PairList [ADD_CLAUSES, EXP, LE_REFL]) then_tac \
        MATCH_MP_TAC(LE_TRANS) then_tac \
        EXISTS_TAC(
          @hol|{1 * x EXP (n + d)}|
        ) then_tac \
        CONJ_TAC then_list \
        PairList [
          ASM_REWRITE_TAC(PairList [MULT_CLAUSES]),
          REWRITE_TAC(PairList [LE_MULT_RCANCEL]) then_tac DISJ1_TAC then_tac \
          UNDISCH_TAC(
            @hol|{~(x = 0)}|
          ) then_tac \
          CONV_TAC(CONTRAPOS_CONV) then_tac \
          REWRITE_TAC(PairList [NOT_LE]) then_tac \
          REWRITE_TAC(PairList [ONE, LT])
        ],
        STRIP_TAC then_tac \
        FIRST_ASSUM(
          o(X_CHOOSE_THEN(@hol|{d:num}|)(SUBST1_TAC))(REWRITE_RULE(PairList [LT_EXISTS]))
        ) then_tac \
        SPEC_TAC([@hol|{d:num}|, @hol|{d:num}|]) then_tac \
        INDUCT_TAC then_tac \
        REWRITE_TAC(PairList [ADD_CLAUSES, EXP]) then_list \
        PairList [
          MATCH_MP_TAC(LTE_TRANS) then_tac \
          EXISTS_TAC(
            @hol|{2 * x EXP m}|
          ) then_tac \
          CONJ_TAC then_list \
          PairList [
            ASM_REWRITE_TAC(PairList [MULT_2, LT_ADD, EXP_LT_0]),
            ASM_REWRITE_TAC(PairList [LE_MULT_RCANCEL])
          ],
          MATCH_MP_TAC(LTE_TRANS) then_tac \
          EXISTS_TAC(
            @hol|{x EXP (m + SUC d)}|
          ) then_tac \
          ASM_REWRITE_TAC(PairList []) then_tac \
          REWRITE_TAC(PairList [ADD_CLAUSES, EXP, MULT_ASSOC, LE_MULT_RCANCEL]) then_tac \
          DISJ1_TAC then_tac \
          MATCH_MP_TAC(LE_TRANS) then_tac \
          EXISTS_TAC(
            @hol|{x * 1}|
          ) then_tac \
          CONJ_TAC then_list \
          PairList [
            REWRITE_TAC(PairList [MULT_CLAUSES, LE_REFL]),
            REWRITE_TAC(PairList [LE_MULT_LCANCEL]) then_tac DISJ2_TAC then_tac \
            UNDISCH_TAC(
              @hol|{~(x = 0)}|
            ) then_tac \
            CONV_TAC(CONTRAPOS_CONV) then_tac \
            REWRITE_TAC(PairList [NOT_LE]) then_tac \
            REWRITE_TAC(PairList [ONE, LT])
          ]
        ]
      ]
    ]
  )

def LE_EXP:
  prove(
    [
      @hol|{!x m n. x EXP m <= x EXP n <=>
         if x = 0 then (m = 0) ==> (n = 0)
         else (x = 1) \/ m <= n}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [GSYM(NOT_LT), LT_EXP, DE_MORGAN_THM]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [TWO, LT, ONE]) then_tac \
      CONV_TAC(o(EQT_INTRO)(TAUT))
    ]
  )

def EQ_EXP:
  prove(
    [
      @hol|{!x m n. x EXP m = x EXP n <=>
         if x = 0 then (m = 0 <=> n = 0)
         else (x = 1) \/ m = n}|,
      REPEAT(GEN_TAC) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(LE_ANTISYM), LE_EXP]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [LE_EXP]) then_tac \
      REWRITE_TAC(PairList [GSYM(LE_ANTISYM)]) then_tac \
      CONV_TAC(TAUT)
    ]
  )

def EXP_MONO_LE_IMP:
  prove(
    [
      @hol|{!x y n. x <= y ==> x EXP n <= y EXP n}|,
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      DISCH_TAC then_tac \
      INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [LE_MULT2, EXP, LE_REFL])
    ]
  )

def EXP_MONO_LT_IMP:
  prove(
    [
      @hol|{!x y n. x < y /\ ~(n = 0) ==> x EXP n < y EXP n}|,
      GEN_TAC then_tac GEN_TAC then_tac INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [NOT_SUC, EXP]) then_tac \
      DISCH_TAC then_tac \
      MATCH_MP_TAC(LET_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{x * y EXP n}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [LT_IMP_LE, LE_MULT_LCANCEL, LT_MULT_RCANCEL, EXP_MONO_LE_IMP, EXP_EQ_0]) then_tac \
      ASM_MESON_TAC(PairList [CONJUNCT1(LT)])
    ]
  )

def EXP_MONO_LE:
  prove(
    [
      @hol|{!x y n. x EXP n <= y EXP n <=> x <= y \/ n = 0}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac STRIP_TAC then_tac \
      ASM_SIMP_TAC(PairList [EXP, LE_REFL, EXP_MONO_LE_IMP]) then_tac \
      ASM_MESON_TAC(PairList [NOT_LE, EXP_MONO_LT_IMP])
    ]
  )

def EXP_MONO_LT:
  prove(
    [
      @hol|{!x y n. x EXP n < y EXP n <=> x < y /\ ~(n = 0)}|,
      REWRITE_TAC(PairList [GSYM(NOT_LE), EXP_MONO_LE, DE_MORGAN_THM])
    ]
  )

def EXP_MONO_EQ:
  prove(
    [
      @hol|{!x y n. x EXP n = y EXP n <=> x = y \/ n = 0}|,
      REWRITE_TAC(PairList [GSYM(LE_ANTISYM), EXP_MONO_LE]) then_tac \
      CONV_TAC(TAUT)
    ]
  )

def DIVMOD_EXIST:
  prove(
    [
      @hol|{!m n. ~(n = 0) ==> ?q r. (m = q * n + r) /\ r < n}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        SPEC(
          @hol|{\r. ?q. m = q * n + r}|
        )(num_WOP)
      ) then_tac \
      BETA_TAC then_tac \
      DISCH_THEN(o(o(MP_TAC)(fst))(EQ_IMP_RULE)) then_tac \
      REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac \
      DISCH_THEN(
        o(MP_TAC)(
          SPECL(
            PairList [
              @hol|{m:num}|,
              @hol|{0}|
            ]
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES]) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{r:num}|)(MP_TAC)) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(X_CHOOSE_TAC(@hol|{q:num}|))(MP_TAC)) then_tac \
      DISCH_THEN(
        fun(th):
          (
            MAP_EVERY(EXISTS_TAC)(PairList [@hol|{q:num}|, @hol|{r:num}|]) then_tac \
            MP_TAC(th)
          )
      ) then_tac \
      CONV_TAC(CONTRAPOS_CONV) then_tac \
      ASM_REWRITE_TAC(PairList [NOT_LT]) then_tac \
      DISCH_THEN(
        o(X_CHOOSE_THEN(@hol|{d:num}|)(SUBST_ALL_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))
      ) then_tac \
      REWRITE_TAC(PairList [NOT_FORALL_THM]) then_tac \
      EXISTS_TAC(@hol|{d:num}|) then_tac \
      REWRITE_TAC(PairList [NOT_IMP, RIGHT_AND_EXISTS_THM]) then_tac \
      EXISTS_TAC(
        @hol|{q + 1}|
      ) then_tac \
      REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB]) then_tac \
      REWRITE_TAC(PairList [MULT_CLAUSES, ADD_ASSOC, LT_ADDR]) then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(NOT_LE), LE])
    ]
  )

def DIVMOD_EXIST_0:
  prove(
    [
      @hol|{!m n. ?q r. if n = 0 then q = 0 /\ r = m
         else m = q * n + r /\ r < n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [DIVMOD_EXIST, RIGHT_EXISTS_AND_THM, EXISTS_REFL])
    ]
  )

def DIVISION_0 = new_specification(PairList ["DIV", "MOD"])(REWRITE_RULE(PairList [SKOLEM_THM])(DIVMOD_EXIST_0))

def DIVISION:
  prove(
    [
      @hol|{!m n. ~(n = 0) ==> (m = m DIV n * n + m MOD n) /\ m MOD n < n}|,
      MESON_TAC(PairList [DIVISION_0])
    ]
  )

def DIV_ZERO:
  prove(
    [
      @hol|{!n. n DIV 0 = 0}|,
      MESON_TAC(PairList [DIVISION_0])
    ]
  )

def MOD_ZERO:
  prove(
    [
      @hol|{!n. n MOD 0 = n}|,
      MESON_TAC(PairList [DIVISION_0])
    ]
  )

def DIVISION_SIMP:
  prove(
    [
      @hol|{(!m n. m DIV n * n + m MOD n = m) /\
         (!m n. n * m DIV n + m MOD n = m)}|,
      REPEAT(STRIP_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [DIV_ZERO, MOD_ZERO, MULT_CLAUSES, ADD_CLAUSES]) then_tac \
      ASM_MESON_TAC(PairList [DIVISION, MULT_SYM])
    ]
  )

def EQ_DIVMOD:
  prove(
    [
      @hol|{!p m n. m DIV p = n DIV p /\ m MOD p = n MOD p <=> m = n}|,
      MESON_TAC(PairList [DIVISION_SIMP])
    ]
  )

def MOD_LT_EQ:
  prove(
    [
      @hol|{!m n. m MOD n < n <=> ~(n = 0)}|,
      MESON_TAC(PairList [DIVISION, LE_1, CONJUNCT1(LT)])
    ]
  )

def MOD_LT_EQ_LT:
  prove(
    [
      @hol|{!m n. m MOD n < n <=> 0 < n}|,
      MESON_TAC(PairList [DIVISION, LE_1, CONJUNCT1(LT)])
    ]
  )

def DIVMOD_UNIQ_LEMMA:
  prove(
    [
      @hol|{!m n q1 r1 q2 r2. ((m = q1 * n + r1) /\ r1 < n) /\
         ((m = q2 * n + r2) /\ r2 < n)
         ==> (q1 = q2) /\ (r1 = r2)}|,
      REPEAT(GEN_TAC) then_tac STRIP_TAC then_tac \
      SUBGOAL_THEN(@hol|{r1:num = r2}|)(MP_TAC) then_list \
      PairList [
        UNDISCH_TAC(
          @hol|{m = q2 * n + r2}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        DISJ_CASES_THEN(MP_TAC)(SPECL(PairList [@hol|{q1:num}|, @hol|{q2:num}|])(LE_CASES)) then_tac \
        DISCH_THEN(
          o(X_CHOOSE_THEN(@hol|{d:num}|)(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))
        ) then_tac \
        REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, GSYM(ADD_ASSOC), EQ_ADD_LCANCEL]) then_list \
        PairList [
          DISCH_TAC then_tac \
          UNDISCH_TAC(@hol|{r1 < n}|),
          DISCH_THEN(o(ASSUME_TAC)(SYM)) then_tac \
          UNDISCH_TAC(@hol|{r2 < n}|)
        ] then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        ONCE_REWRITE_TAC(PairList [MULT_SYM]) then_tac \
        SPEC_TAC([@hol|{d:num}|, @hol|{d:num}|]) then_tac \
        INDUCT_TAC then_tac \
        REWRITE_TAC(PairList [ADD_CLAUSES, MULT_CLAUSES, GSYM(NOT_LE), LE_ADD, GSYM(ADD_ASSOC)]),
        DISCH_THEN(SUBST_ALL_TAC) then_tac REWRITE_TAC(PairList []) then_tac \
        CONV_TAC(SYM_CONV) then_tac \
        UNDISCH_TAC(
          @hol|{m = q1 * n + r2}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList [EQ_ADD_RCANCEL, EQ_MULT_RCANCEL]) then_tac \
        REPEAT(
          UNDISCH_TAC(@hol|{r2 < n}|)
        ) then_tac \
        ASM_CASES_TAC(
          @hol|{n = 0}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList [GSYM(NOT_LE), LE_0])
      ]
    ]
  )

def DIVMOD_UNIQ:
  prove(
    [
      @hol|{!m n q r. (m = q * n + r) /\ r < n ==> (m DIV n = q) /\ (m MOD n = r)}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN(o(CONJUNCTS_THEN(ASSUME_TAC))(GSYM)) then_tac \
      MATCH_MP_TAC(DIVMOD_UNIQ_LEMMA) then_tac \
      MAP_EVERY(EXISTS_TAC)(PairList [@hol|{m:num}|, @hol|{n:num}|]) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      MATCH_MP_TAC(DIVISION) then_tac \
      DISCH_TAC then_tac \
      UNDISCH_TAC(@hol|{r < n}|) then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(NOT_LE), LE_0])
    ]
  )

def MOD_UNIQ:
  prove(
    [
      @hol|{!m n q r. (m = q * n + r) /\ r < n ==> (m MOD n = r)}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN((fun(th): REWRITE_TAC(PairList [MATCH_MP(DIVMOD_UNIQ)(th)])))
    ]
  )

def DIV_UNIQ:
  prove(
    [
      @hol|{!m n q r. (m = q * n + r) /\ r < n ==> (m DIV n = q)}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN((fun(th): REWRITE_TAC(PairList [MATCH_MP(DIVMOD_UNIQ)(th)])))
    ]
  )

def [arith_DIV_0_v2, MOD_0]:
  o(CONJ_PAIR)(prove)(
    [
      @hol|{(!n. 0 DIV n = 0) /\ (!n. 0 MOD n = 0)}|,
      REWRITE_TAC(PairList [AND_FORALL_THM]) then_tac GEN_TAC then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [DIV_ZERO, MOD_ZERO]) then_tac \
      MATCH_MP_TAC(DIVMOD_UNIQ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, LT_NZ])
    ]
  )

def [arith_DIV_MULT_v2, MOD_MULT]:
  o(CONJ_PAIR)(prove)(
    [
      @hol|{(!m n. ~(m = 0) ==> (m * n) DIV m = n) /\
         (!m n. (m * n) MOD m = 0)}|,
      REWRITE_TAC(PairList [AND_FORALL_THM]) then_tac REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{m = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, MOD_0]) then_tac \
      MATCH_MP_TAC(DIVMOD_UNIQ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, MULT_AC, LT_NZ])
    ]
  )

def MOD_LT:
  prove(
    [
      @hol|{!m n. m < n ==> m MOD n = m}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(MOD_UNIQ) then_tac \
      EXISTS_TAC(@hol|{0}|) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES])
    ]
  )

def MOD_EQ_SELF:
  prove(
    [
      @hol|{!m n. m MOD n = m <=> n = 0 \/ m < n}|,
      MESON_TAC(PairList [MOD_ZERO, MOD_LT, DIVISION, LE_1])
    ]
  )

def MOD_CASES:
  prove(
    [
      @hol|{!n p. n < 2 * p ==> n MOD p = if n < p then n else n - p}|,
      REPEAT(STRIP_TAC) then_tac COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList [MOD_LT]) then_tac \
      MATCH_MP_TAC(MOD_UNIQ) then_tac \
      EXISTS_TAC(
        @hol|{1}|
      ) then_tac \
      RULE_ASSUM_TAC(REWRITE_RULE(PairList [NOT_LT])) then_tac \
      CONJ_TAC then_list \
      PairList [
        REWRITE_TAC(PairList [MULT_CLAUSES]) then_tac \
        ASM_MESON_TAC(PairList [SUB_ADD, ADD_SYM]),
        ASM_MESON_TAC(PairList [LT_ADD_RCANCEL, SUB_ADD, MULT_2, LT_ADD2])
      ]
    ]
  )

def MOD_ADD_CASES:
  prove(
    [
      @hol|{!m n p.
         m < p /\ n < p
         ==> (m + n) MOD p = if m + n < p then m + n else (m + n) - p}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(MOD_CASES) then_tac \
      REWRITE_TAC(PairList [MULT_2]) then_tac \
      ASM_MESON_TAC(PairList [LT_ADD2])
    ]
  )

def MOD_EQ:
  prove(
    [
      @hol|{!m n p q. m = n + q * p ==> m MOD p = n MOD p}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{p = 0}|
      ) then_list \
      PairList [
        ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES]) then_tac \
        DISCH_THEN(SUBST1_TAC) then_tac \
        REFL_TAC,
        DISCH_THEN(SUBST1_TAC) then_tac MATCH_MP_TAC(MOD_UNIQ) then_tac \
        EXISTS_TAC(
          @hol|{q + n DIV p}|
        ) then_tac \
        POP_ASSUM(o(MP_TAC)(MATCH_MP(DIVISION))) then_tac \
        DISCH_THEN(o(o(STRIP_ASSUME_TAC)(GSYM))(SPEC(@hol|{n:num}|))) then_tac \
        ASM_REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, GSYM(ADD_ASSOC)]) then_tac \
        MATCH_ACCEPT_TAC(ADD_SYM)
      ]
    ]
  )

def DIV_LE:
  prove(
    [
      @hol|{!m n. m DIV n <= m}|,
      REPEAT(STRIP_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [DIV_ZERO, LE_0]) then_tac \
      FIRST_ASSUM((fun(th): GEN_REWRITE_TAC(RAND_CONV)(PairList [MATCH_MP(DIVISION)(th)]))) then_tac \
      UNDISCH_TAC(
        @hol|{~(n = 0)}|
      ) then_tac \
      SPEC_TAC([@hol|{n:num}|, @hol|{n:num}|]) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [MULT_CLAUSES, GSYM(ADD_ASSOC), LE_ADD])
    ]
  )

def DIV_MUL_LE:
  prove(
    [
      @hol|{!m n. n * (m DIV n) <= m}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, LE_0]) then_tac \
      POP_ASSUM(o(o(MP_TAC)(SPEC(@hol|{m:num}|)))(MATCH_MP(DIVISION))) then_tac \
      DISCH_THEN((fun(th): GEN_REWRITE_TAC(RAND_CONV)(PairList [CONJUNCT1(th)]))) then_tac \
      REWRITE_TAC(PairList [LE_ADD, MULT_AC])
    ]
  )

def MOD_LE_TWICE:
  prove(
    [
      @hol|{!m n. 0 < m /\ m <= n ==> 2 * n MOD m <= n}|,
      REPEAT(STRIP_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{2 * m <= n}|
      ) then_list \
      PairList [
        TRANS_TAC(LE_TRANS)(
          @hol|{2 * m}|
        ) then_tac \
        ASM_SIMP_TAC(PairList [LE_MULT_LCANCEL, DIVISION, LT_IMP_LE, LE_1]),
        RULE_ASSUM_TAC(REWRITE_RULE(PairList [NOT_LE]))
      ] then_tac \
      TRANS_TAC(LE_TRANS)(
        @hol|{m + n MOD m}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [MULT_2, LE_ADD_RCANCEL, DIVISION, LT_IMP_LE, LE_1]) then_tac \
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac \
      SUBGOAL_THEN(
        @hol|{n MOD m = n - m}|
      )((fun(th): ASM_SIMP_TAC(PairList [LE_REFL, SUB_ADD, th]))) then_tac \
      MATCH_MP_TAC(MOD_UNIQ) then_tac \
      EXISTS_TAC(
        @hol|{1}|
      ) then_tac \
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac \
      ASM_SIMP_TAC(PairList [MULT_CLAUSES, SUB_ADD]) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          MESON(
            PairList [LT_ADD_RCANCEL])(
            @hol|{n - m:num < m <=> (n - m) + m < m + m}|
          )
        ]
      ) then_tac \
      ASM_SIMP_TAC(PairList [GSYM(MULT_2), SUB_ADD])
    ]
  )

def [arith_DIV_1_v2, MOD_1]:
  o(CONJ_PAIR)(prove)(
    [
      @hol|{(!n. n DIV 1 = n) /\ (!n. n MOD 1 = 0)}|,
      SIMP_TAC(PairList [AND_FORALL_THM]) then_tac GEN_TAC then_tac \
      MATCH_MP_TAC(DIVMOD_UNIQ) then_tac \
      REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES]) then_tac \
      REWRITE_TAC(PairList [ONE, LT])
    ]
  )

def DIV_LT:
  prove(
    [
      @hol|{!m n. m < n ==> m DIV n = 0}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(DIV_UNIQ) then_tac \
      EXISTS_TAC(@hol|{m:num}|) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES])
    ]
  )

def MOD_MOD:
  prove(
    [
      @hol|{!m n p. (m MOD (n * p)) MOD n = m MOD n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{p = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_ZERO, MULT_CLAUSES]) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_ZERO, MULT_CLAUSES]) then_tac \
      CONV_TAC(SYM_CONV) then_tac \
      MATCH_MP_TAC(MOD_EQ) then_tac \
      EXISTS_TAC(
        @hol|{m DIV (n * p) * p}|
      ) then_tac \
      MP_TAC(
        SPECL(
          PairList [
            @hol|{m:num}|,
            @hol|{n * p:num}|
          ])(
          DIVISION
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_EQ_0, MULT_AC, ADD_AC]) then_tac \
      DISCH_THEN((fun(th): REWRITE_TAC(PairList [GSYM(th)])))
    ]
  )

def MOD_MOD_REFL:
  prove(
    [
      @hol|{!m n. (m MOD n) MOD n = m MOD n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_ZERO]) then_tac \
      MP_TAC(
        SPECL(
          PairList [
            @hol|{m:num}|,
            @hol|{n:num}|,
            @hol|{1}|
          ])(
          MOD_MOD
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, MULT_EQ_0]) then_tac \
      REWRITE_TAC(PairList [ONE, NOT_SUC])
    ]
  )

def MOD_MOD_LE:
  prove(
    [
      @hol|{!m n p. ~(n = 0) /\ n <= p ==> (m MOD n) MOD p = m MOD n}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(MOD_LT) then_tac \
      ASM_MESON_TAC(PairList [DIVISION, LTE_TRANS])
    ]
  )

def MOD_EVEN_2:
  prove(
    [
      @hol|{!m n. EVEN n ==> m MOD n MOD 2 = m MOD 2}|,
      SIMP_TAC(PairList [EVEN_EXISTS, LEFT_IMP_EXISTS_THM, MOD_MOD])
    ]
  )

def DIV_MULT2:
  prove(
    [
      @hol|{!m n p. ~(m = 0) ==> ((m * n) DIV (m * p) = n DIV p)}|,
      REPEAT(STRIP_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{p = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [DIV_ZERO, MULT_CLAUSES]) then_tac \
      MATCH_MP_TAC(DIV_UNIQ) then_tac \
      EXISTS_TAC(
        @hol|{m * (n MOD p)}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [LT_MULT_LCANCEL, DIVISION]) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          AC(MULT_AC)(
            @hol|{a * b * c:num = b * a * c}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(LEFT_ADD_DISTRIB), EQ_MULT_LCANCEL]) then_tac \
      ASM_SIMP_TAC(PairList [GSYM(DIVISION)])
    ]
  )

def MOD_MULT2:
  prove(
    [
      @hol|{!m n p. (m * n) MOD (m * p) = m * n MOD p}|,
      REPEAT(STRIP_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{p = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_ZERO, MULT_CLAUSES]) then_tac \
      ASM_CASES_TAC(
        @hol|{m = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_ZERO, MULT_CLAUSES]) then_tac \
      MATCH_MP_TAC(MOD_UNIQ) then_tac \
      EXISTS_TAC(@hol|{n DIV p}|) then_tac \
      ASM_SIMP_TAC(PairList [LT_MULT_LCANCEL, DIVISION]) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          AC(MULT_AC)(
            @hol|{a * b * c:num = b * a * c}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(LEFT_ADD_DISTRIB), EQ_MULT_LCANCEL]) then_tac \
      ASM_SIMP_TAC(PairList [GSYM(DIVISION)])
    ]
  )

def MOD_EXISTS:
  prove(
    [
      @hol|{!m n. (?q. m = n * q) <=> if n = 0 then (m = 0) else (m MOD n = 0)}|,
      REPEAT(GEN_TAC) then_tac COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES]) then_tac \
      EQ_TAC then_tac \
      STRIP_TAC then_tac \
      ASM_SIMP_TAC(PairList [MOD_MULT]) then_tac \
      EXISTS_TAC(@hol|{m DIV n}|) then_tac \
      SUBGOAL_THEN(
        @hol|{m = (m DIV n) * n + m MOD n}|
      )((fun(th): GEN_REWRITE_TAC(LAND_CONV)(PairList [th]))) then_list \
      PairList [
        ASM_MESON_TAC(PairList [DIVISION]),
        ASM_REWRITE_TAC(PairList [ADD_CLAUSES, MULT_AC])
      ]
    ]
  )

def LE_RDIV_EQ:
  prove(
    [
      @hol|{!a b n. ~(a = 0) ==> (n <= b DIV a <=> a * n <= b)}|,
      REPEAT(STRIP_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_list \
      PairList [
        MATCH_MP_TAC(LE_TRANS) then_tac \
        EXISTS_TAC(
          @hol|{a * (b DIV a)}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList [DIV_MUL_LE, LE_MULT_LCANCEL]),
        SUBGOAL_THEN(
          @hol|{a * n < a * (b DIV a + 1)}|
        )(MP_TAC) then_list \
        PairList [
          MATCH_MP_TAC(LET_TRANS) then_tac \
          EXISTS_TAC(
            @hol|{(b DIV a) * a + b MOD a}|
          ) then_tac \
          CONJ_TAC then_list \
          PairList [ASM_MESON_TAC(PairList [DIVISION]), ALL_TAC] then_tac \
          SIMP_TAC(PairList [LEFT_ADD_DISTRIB, MULT_SYM, MULT_CLAUSES, LT_ADD_LCANCEL]) then_tac \
          ASM_MESON_TAC(PairList [DIVISION]),
          ASM_REWRITE_TAC(PairList [LT_MULT_LCANCEL, GSYM(ADD1), LT_SUC_LE])
        ]
      ]
    ]
  )

def RDIV_LT_EQ:
  prove(
    [
      @hol|{!a b n. ~(a = 0) ==> (b DIV a < n <=> b < a * n)}|,
      SIMP_TAC(PairList [GSYM(NOT_LE), LE_RDIV_EQ])
    ]
  )

def LE_LDIV_EQ:
  prove(
    [
      @hol|{!a b n. ~(a = 0) ==> (b DIV a <= n <=> b < a * (n + 1))}|,
      REPEAT(STRIP_TAC) then_tac ONCE_REWRITE_TAC(PairList [GSYM(NOT_LT)]) then_tac \
      GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [GSYM(LE_SUC_LT)]) then_tac \
      ASM_SIMP_TAC(PairList [LE_RDIV_EQ]) then_tac \
      REWRITE_TAC(PairList [NOT_LT, NOT_LE, ADD1])
    ]
  )

def LDIV_LT_EQ:
  prove(
    [
      @hol|{!a b n. ~(a = 0) ==> (n < b DIV a <=> a * (n + 1) <= b)}|,
      SIMP_TAC(PairList [GSYM(NOT_LE), LE_LDIV_EQ])
    ]
  )

def LE_LDIV:
  prove(
    [
      @hol|{!a b n. ~(a = 0) /\ b <= a * n ==> b DIV a <= n}|,
      SIMP_TAC(PairList [LE_LDIV_EQ, LEFT_ADD_DISTRIB, MULT_CLAUSES]) then_tac \
      MESON_TAC(PairList [LT_ADD, LT_NZ, LET_TRANS])
    ]
  )

def DIV_MONO:
  prove(
    [
      @hol|{!m n p. m <= n ==> m DIV p <= n DIV p}|,
      REPEAT(STRIP_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{p = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [DIV_ZERO, LE_REFL]) then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [LE_REFL])(
          @hol|{(!k:num. k <= a ==> k <= b) ==> a <= b}|
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [LE_RDIV_EQ]) then_tac \
      ASM_MESON_TAC(PairList [LE_TRANS])
    ]
  )

def DIV_MONO_LT:
  prove(
    [
      @hol|{!m n p. ~(p = 0) /\ m + p <= n ==> m DIV p < n DIV p}|,
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [ADD1, LE_SUC_LT, LE_REFL])(
          @hol|{(!k:num. k <= a ==> k + 1 <= b) ==> a < b}|
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [LE_RDIV_EQ, LEFT_ADD_DISTRIB, MULT_CLAUSES]) then_tac \
      ASM_MESON_TAC(PairList [LE_REFL, LE_TRANS, LE_ADD2, ADD_SYM])
    ]
  )

def DIV_EQ_0:
  prove(
    [
      @hol|{!m n. ~(n = 0) ==> ((m DIV n = 0) <=> m < n)}|,
      REPEAT(STRIP_TAC or_tac EQ_TAC) then_list \
      PairList [
        FIRST_ASSUM(
          o(o(o(SUBST1_TAC)(CONJUNCT1))(SPEC(@hol|{m:num}|)))(MATCH_MP(DIVISION))
        ) then_tac \
        ASM_SIMP_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, DIVISION]),
        MATCH_MP_TAC(DIV_UNIQ) then_tac EXISTS_TAC(@hol|{m:num}|) then_tac \
        ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES])
      ]
    ]
  )

def MOD_DIV_EQ_0:
  prove(
    [
      @hol|{!m n. ~(n = 0) ==> (m MOD n) DIV n = 0}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN((fun(th): IMP_REWRITE_TAC(PairList [th, DIV_EQ_0, MOD_LT_EQ])))
    ]
  )

def MOD_EQ_0:
  prove(
    [
      @hol|{!m n. (m MOD n = 0) <=> ?q. m = q * n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, MOD_ZERO]) then_tac \
      REPEAT(STRIP_TAC or_tac EQ_TAC) then_list \
      PairList [
        FIRST_ASSUM(
          o(o(o(SUBST1_TAC)(CONJUNCT1))(SPEC(@hol|{m:num}|)))(MATCH_MP(DIVISION))
        ) then_tac \
        ASM_SIMP_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, DIVISION]) then_tac \
        MESON_TAC(PairList []),
        MATCH_MP_TAC(MOD_UNIQ) then_tac ASM_SIMP_TAC(PairList [ADD_CLAUSES, MULT_AC]) then_tac \
        ASM_MESON_TAC(PairList [NOT_LE, CONJUNCT1(LE)])
      ]
    ]
  )

def DIV_EQ_SELF:
  prove(
    [
      @hol|{!m n. m DIV n = m <=> m = 0 \/ n = 1}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{m = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [arith_DIV_0_v2]) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 1}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [arith_DIV_1_v2]) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [DIV_ZERO]) then_tac \
      MATCH_MP_TAC(LT_IMP_NE) then_tac \
      ASM_SIMP_TAC(PairList [RDIV_LT_EQ]) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(el(2)(CONJUNCTS(MULT_CLAUSES)))]) then_tac \
      ASM_REWRITE_TAC(PairList [LT_MULT_RCANCEL]) then_tac \
      REWRITE_TAC(PairList [GSYM(NOT_LE), ONE, LE]) then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(ONE)])
    ]
  )

def MOD_REFL:
  prove(
    [
      @hol|{!n. n MOD n = 0}|,
      SIMP_TAC(PairList [MOD_EQ_0]) then_tac MESON_TAC(PairList [MULT_CLAUSES])
    ]
  )

def EVEN_MOD:
  prove(
    [
      @hol|{!n. EVEN(n) <=> n MOD 2 = 0}|,
      REWRITE_TAC(PairList [EVEN_EXISTS, MOD_EQ_0]) then_tac MESON_TAC(PairList [MULT_SYM])
    ]
  )

def ODD_MOD:
  prove(
    [
      @hol|{!n. ODD(n) <=> n MOD 2 = 1}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [GSYM(NOT_EVEN), EVEN_MOD]) then_tac \
      SUBGOAL_THEN(
        @hol|{n MOD 2 < 2}|
      )(MP_TAC) then_list \
      PairList [SIMP_TAC(PairList [DIVISION, TWO, NOT_SUC]), ALL_TAC] then_tac \
      SPEC_TAC(
        [
          @hol|{n MOD 2}|,
          @hol|{n:num}|
        ]
      ) then_tac \
      REWRITE_TAC(PairList [TWO, ONE, LT]) then_tac \
      MESON_TAC(PairList [NOT_SUC])
    ]
  )

def MOD_2_CASES:
  prove(
    [
      @hol|{!n. n MOD 2 = if EVEN n then 0 else 1}|,
      MESON_TAC(PairList [EVEN_MOD, ODD_MOD, NOT_ODD])
    ]
  )

def EVEN_MOD_EVEN:
  prove(
    [
      @hol|{!m n. EVEN n ==> (EVEN(m MOD n) <=> EVEN m)}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [EVEN_MOD]) then_tac \
      ASM_SIMP_TAC(PairList [MOD_EVEN_2])
    ]
  )

def ODD_MOD_EVEN:
  prove(
    [
      @hol|{!m n. EVEN n ==> (ODD(m MOD n) <=> ODD m)}|,
      SIMP_TAC(PairList [GSYM(NOT_EVEN), EVEN_MOD_EVEN])
    ]
  )

def HALF_DOUBLE:
  prove(
    [
      @hol|{(!n. (2 * n) DIV 2 = n) /\ (!n. (n * 2) DIV 2 = n)}|,
      GEN_REWRITE_TAC(o(RAND_CONV)(ONCE_DEPTH_CONV))(PairList [MULT_SYM]) then_tac \
      SIMP_TAC(PairList [arith_DIV_MULT_v2, TWO, NOT_SUC])
    ]
  )

def DOUBLE_HALF:
  prove(
    [
      @hol|{(!n. EVEN n ==> 2 * n DIV 2 = n) /\
         (!n. EVEN n ==> n DIV 2 * 2 = n)}|,
      SIMP_TAC(PairList [EVEN_EXISTS, LEFT_IMP_EXISTS_THM, HALF_DOUBLE]) then_tac \
      REWRITE_TAC(PairList [MULT_SYM])
    ]
  )

def MOD_MULT_RMOD:
  prove(
    [
      @hol|{!m n p. (m * (p MOD n)) MOD n = (m * p) MOD n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_ZERO]) then_tac \
      CONV_TAC(SYM_CONV) then_tac \
      MATCH_MP_TAC(MOD_EQ) then_tac \
      EXISTS_TAC(
        @hol|{m * p DIV n}|
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(MULT_ASSOC), GSYM(LEFT_ADD_DISTRIB)]) then_tac \
      REWRITE_TAC(PairList [EQ_MULT_LCANCEL]) then_tac \
      DISJ2_TAC then_tac \
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac \
      ASM_SIMP_TAC(PairList [DIVISION])
    ]
  )

def MOD_MULT_LMOD:
  prove(
    [
      @hol|{!m n p. ((m MOD n) * p) MOD n = (m * p) MOD n}|,
      ONCE_REWRITE_TAC(PairList [MULT_SYM]) then_tac SIMP_TAC(PairList [MOD_MULT_RMOD])
    ]
  )

def MOD_MULT_MOD2:
  prove(
    [
      @hol|{!m n p. ((m MOD n) * (p MOD n)) MOD n = (m * p) MOD n}|,
      SIMP_TAC(PairList [MOD_MULT_RMOD, MOD_MULT_LMOD])
    ]
  )

def MOD_EXP_MOD:
  prove(
    [
      @hol|{!m n p. ((m MOD n) EXP p) MOD n = (m EXP p) MOD n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_ZERO]) then_tac \
      SPEC_TAC([@hol|{p:num}|, @hol|{p:num}|]) then_tac \
      INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [EXP]) then_tac \
      ASM_SIMP_TAC(PairList [MOD_MULT_LMOD]) then_tac \
      MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{(m * ((m MOD n) EXP p) MOD n) MOD n}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [ALL_TAC, ASM_REWRITE_TAC(PairList [])] then_tac \
      ASM_SIMP_TAC(PairList [MOD_MULT_RMOD])
    ]
  )

def MOD_MULT_ADD:
  prove(
    [
      @hol|{(!m n p. (m * n + p) MOD n = p MOD n) /\
         (!m n p. (n * m + p) MOD n = p MOD n) /\
         (!m n p. (p + m * n) MOD n = p MOD n) /\
         (!m n p. (p + n * m) MOD n = p MOD n)}|,
      MATCH_MP_TAC(
        TAUT(
          @hol|{(p ==> q) /\ p ==> p /\ q}|
        )
      ) then_tac \
      CONJ_TAC then_list \
      PairList [SIMP_TAC(PairList [MULT_AC, ADD_AC]), REPEAT(GEN_TAC)] then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES]) then_tac \
      MATCH_MP_TAC(MOD_UNIQ) then_tac \
      EXISTS_TAC(
        @hol|{m + p DIV n}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [RIGHT_ADD_DISTRIB, GSYM(ADD_ASSOC), EQ_ADD_LCANCEL, DIVISION])
    ]
  )

def DIV_MULT_ADD:
  prove(
    [
      @hol|{(!a b n. ~(n = 0) ==> (a * n + b) DIV n = a + b DIV n) /\
         (!a b n. ~(n = 0) ==> (n * a + b) DIV n = a + b DIV n) /\
         (!a b n. ~(n = 0) ==> (b + a * n) DIV n = b DIV n + a) /\
         (!a b n. ~(n = 0) ==> (b + n * a) DIV n = b DIV n + a)}|,
      MATCH_MP_TAC(
        TAUT(
          @hol|{(p ==> q) /\ p ==> p /\ q}|
        )
      ) then_tac \
      CONJ_TAC then_list \
      PairList [SIMP_TAC(PairList [MULT_AC, ADD_AC]), REPEAT(STRIP_TAC)] then_tac \
      MATCH_MP_TAC(DIV_UNIQ) then_tac \
      EXISTS_TAC(@hol|{b MOD n}|) then_tac \
      REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, GSYM(ADD_ASSOC)]) then_tac \
      ASM_MESON_TAC(PairList [DIVISION])
    ]
  )

def MOD_ADD_MOD:
  prove(
    [
      @hol|{!a b n. (a MOD n + b MOD n) MOD n = (a + b) MOD n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_ZERO]) then_tac \
      CONV_TAC(SYM_CONV) then_tac \
      MATCH_MP_TAC(MOD_EQ) then_tac \
      EXISTS_TAC(
        @hol|{a DIV n + b DIV n}|
      ) then_tac \
      REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB]) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          AC(ADD_AC)(
            @hol|{(a + b) + (c + d) = (c + a) + (d + b)}|
          )
        ]
      ) then_tac \
      BINOP_TAC then_tac \
      ASM_SIMP_TAC(PairList [DIVISION])
    ]
  )

def DIV_ADD_MOD:
  prove(
    [
      @hol|{!a b n. ~(n = 0)
         ==> (((a + b) MOD n = a MOD n + b MOD n) <=>
              ((a + b) DIV n = a DIV n + b DIV n))}|,
      REPEAT(STRIP_TAC) then_tac \
      FIRST_ASSUM(o(MP_TAC)(MATCH_MP(DIVISION))) then_tac \
      DISCH_THEN(
        fun(th):
          MAP_EVERY(o(o(MP_TAC)(CONJUNCT1))(C(SPEC)(th)))(
            PairList [
              @hol|{a + b:num}|,
              @hol|{a:num}|,
              @hol|{b:num}|
            ]
          )
      ) then_tac \
      DISCH_THEN(
        fun(th1):
          DISCH_THEN(
            (fun(th2): MP_TAC(MK_COMB([AP_TERM(@hol|{(+)}|)(th2), th1])))
          )
      ) then_tac \
      DISCH_THEN((fun(th): GEN_REWRITE_TAC(funpow(2)(LAND_CONV))(PairList [th]))) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          AC(ADD_AC)(
            @hol|{(a + b) + c + d = (a + c) + (b + d)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(RIGHT_ADD_DISTRIB)]) then_tac \
      DISCH_THEN((fun(th): (EQ_TAC then_tac DISCH_TAC then_tac MP_TAC(th)))) then_tac \
      ASM_REWRITE_TAC(PairList [EQ_ADD_RCANCEL, EQ_ADD_LCANCEL, EQ_MULT_RCANCEL]) then_tac \
      REWRITE_TAC(PairList [EQ_SYM_EQ])
    ]
  )

def MOD_ADD_EQ_EQ:
  prove(
    [
      @hol|{!n x y. (x + y) MOD n = x MOD n + y MOD n <=>
         n = 0 \/ x MOD n + y MOD n < n}|,
      MESON_TAC(PairList [MOD_ZERO, MOD_EQ_SELF, MOD_ADD_MOD])
    ]
  )

def DIV_ADD_EQ_EQ:
  prove(
    [
      @hol|{!n x y. (x + y) DIV n = x DIV n + y DIV n <=>
         n = 0 \/ x MOD n + y MOD n < n}|,
      METIS_TAC(PairList [DIV_ZERO, ADD_CLAUSES, DIV_ADD_MOD, MOD_ADD_EQ_EQ])
    ]
  )

def DIV_ADD_EQ:
  prove(
    [
      @hol|{!n x y. x MOD n + y MOD n < n ==> (x + y) DIV n = x DIV n + y DIV n}|,
      SIMP_TAC(PairList [DIV_ADD_EQ_EQ])
    ]
  )

def MOD_ADD_EQ:
  prove(
    [
      @hol|{!n x y. x MOD n + y MOD n < n ==> (x + y) MOD n = x MOD n + y MOD n}|,
      SIMP_TAC(PairList [MOD_ADD_EQ_EQ])
    ]
  )

def DIV_REFL:
  prove(
    [
      @hol|{!n. ~(n = 0) ==> (n DIV n = 1)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(DIV_UNIQ) then_tac \
      EXISTS_TAC(@hol|{0}|) then_tac \
      REWRITE_TAC(PairList [ADD_CLAUSES, MULT_CLAUSES]) then_tac \
      POP_ASSUM(MP_TAC) then_tac \
      SPEC_TAC([@hol|{n:num}|, @hol|{n:num}|]) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [LT_0])
    ]
  )

def MOD_LE:
  prove(
    [
      @hol|{!m n. m MOD n <= m}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_ZERO, LE_REFL]) then_tac \
      FIRST_ASSUM((fun(th): GEN_REWRITE_TAC(RAND_CONV)(PairList [MATCH_MP(DIVISION)(th)]))) then_tac \
      ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac \
      REWRITE_TAC(PairList [LE_ADD])
    ]
  )

def DIV_MONO2:
  prove(
    [
      @hol|{!m n p. ~(p = 0) /\ p <= m ==> n DIV m <= n DIV p}|,
      REPEAT(STRIP_TAC) then_tac ASM_SIMP_TAC(PairList [LE_RDIV_EQ]) then_tac \
      MATCH_MP_TAC(LE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{m * n DIV m}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [LE_MULT_RCANCEL]) then_tac \
      ONCE_REWRITE_TAC(PairList [MULT_SYM]) then_tac \
      MP_TAC(SPECL(PairList [@hol|{n:num}|, @hol|{m:num}|])(DIVISION)) then_tac \
      ASM_MESON_TAC(PairList [LE_ADD, LE])
    ]
  )

def DIV_LE_EXCLUSION:
  prove(
    [
      @hol|{!a b c d. ~(b = 0) /\ b * c < (a + 1) * d ==> c DIV d <= a DIV b}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{d = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, LT]) then_tac \
      STRIP_TAC then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [LE_REFL])(
          @hol|{(!k:num. k <= a ==> k <= b) ==> a <= b}|
        )
      ) then_tac \
      X_GEN_TAC(@hol|{k:num}|) then_tac \
      SUBGOAL_THEN(
        @hol|{b * d * k <= b * c ==> (b * k) * d < (a + 1) * d}|
      )(MP_TAC) then_list \
      PairList [ASM_MESON_TAC(PairList [LET_TRANS, MULT_AC]), ALL_TAC] then_tac \
      MATCH_MP_TAC(MONO_IMP) then_tac \
      ASM_SIMP_TAC(PairList [LE_MULT_LCANCEL, LT_MULT_RCANCEL, LE_RDIV_EQ]) then_tac \
      REWRITE_TAC(PairList [GSYM(ADD1), LT_SUC_LE])
    ]
  )

def DIV_EQ_EXCLUSION:
  prove(
    [
      @hol|{!a b c d.
         b * c < (a + 1) * d /\ a * d < (c + 1) * b ==> (a DIV b = c DIV d)}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{b = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, LT]) then_tac \
      ASM_CASES_TAC(
        @hol|{d = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, LT]) then_tac \
      ASM_MESON_TAC(PairList [MULT_SYM, LE_ANTISYM, DIV_LE_EXCLUSION])
    ]
  )

def MULT_DIV_LE:
  prove(
    [
      @hol|{!m n p. m * (n DIV p) <= (m * n) DIV p}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{p = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [LE_REFL, DIV_ZERO, MULT_CLAUSES]) then_tac \
      ASM_SIMP_TAC(PairList [LE_RDIV_EQ]) then_tac \
      FIRST_ASSUM(o(o(MP_TAC)(SPEC(@hol|{n:num}|)))(MATCH_MP(DIVISION))) then_tac \
      DISCH_THEN(
        (fun(th): GEN_REWRITE_TAC(o(RAND_CONV)(RAND_CONV))(PairList [CONJUNCT1(th)]))
      ) then_tac \
      REWRITE_TAC(PairList [LEFT_ADD_DISTRIB]) then_tac \
      REWRITE_TAC(PairList [MULT_AC, LE_ADD])
    ]
  )

def DIV_DIV:
  prove(
    [
      @hol|{!m n p. (m DIV n) DIV p = m DIV (n * p)}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{p = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, DIV_ZERO]) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [arith_DIV_0_v2, MULT_CLAUSES, DIV_ZERO]) then_tac \
      REWRITE_TAC(PairList [MULT_EQ_0, DE_MORGAN_THM]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [LE_ANTISYM])(
          @hol|{(!k. k <= m <=> k <= n) ==> m = n}|
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [LE_RDIV_EQ, MULT_EQ_0, MULT_ASSOC])
    ]
  )

def DIV_MOD:
  prove(
    [
      @hol|{!m n p. (m DIV n) MOD p = (m MOD (n * p)) DIV n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{p = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_ZERO, MULT_CLAUSES]) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_0, MULT_CLAUSES, DIV_ZERO]) then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [LE_ANTISYM])(
          @hol|{(!k. k <= m <=> k <= n) ==> m = n}|
        )
      ) then_tac \
      X_GEN_TAC(@hol|{k:num}|) then_tac \
      MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{k + p * ((m DIV n) DIV p) <= (m DIV n)}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MP_TAC(
          SPECL(
            PairList [
              @hol|{m DIV n}|,
              @hol|{p:num}|
            ])(
            DIVISION
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList []),
        MP_TAC(
          SPECL(
            PairList [
              @hol|{m:num}|,
              @hol|{n * p:num}|
            ])(
            DIVISION
          )
        ) then_tac \
        ASM_SIMP_TAC(PairList [LE_RDIV_EQ, MULT_EQ_0, DIV_DIV, LEFT_ADD_DISTRIB])
      ] then_tac \
      REWRITE_TAC(PairList [MULT_AC]) then_tac \
      MESON_TAC(PairList [ADD_SYM, MULT_SYM, LE_ADD_RCANCEL])
    ]
  )

def MOD_MULT_MOD:
  prove(
    [
      @hol|{!m n p. m MOD (n * p) = n * (m DIV n) MOD p + m MOD n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, MOD_ZERO, ADD_CLAUSES]) then_tac \
      ASM_CASES_TAC(
        @hol|{p = 0}|
      ) then_list \
      PairList [
        ASM_REWRITE_TAC(PairList [MULT_CLAUSES, MOD_ZERO]) then_tac \
        ASM_METIS_TAC(PairList [DIVISION, MULT_SYM]),
        ALL_TAC
      ] then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [EQ_ADD_LCANCEL])(
          @hol|{(?a. a + x = a + y) ==> x = y}|
        )
      ) then_tac \
      EXISTS_TAC(
        @hol|{m DIV n DIV p * n * p}|
      ) then_tac \
      REWRITE_TAC(PairList [DIVISION_SIMP, DIV_DIV]) then_tac \
      REWRITE_TAC(
        PairList [
          AC(MULT_AC)(
            @hol|{d * n * p = n * (d * p)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(LEFT_ADD_DISTRIB), ADD_ASSOC, GSYM(DIV_DIV)]) then_tac \
      REWRITE_TAC(PairList [DIVISION_SIMP])
    ]
  )

def MOD_MOD_EXP_MIN:
  prove(
    [
      @hol|{!x p m n. x MOD (p EXP m) MOD (p EXP n) = x MOD (p EXP (MIN m n))}|,
      REPEAT(STRIP_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{p = 0}|
      ) then_list \
      PairList [
        ASM_REWRITE_TAC(PairList [EXP_ZERO, MIN]) then_tac \
        ASM_CASES_TAC(
          @hol|{m = 0}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList [MOD_ZERO, MOD_1, MOD_0, LE_0]) then_tac \
        ASM_CASES_TAC(@hol|{m:num <= n}|) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        COND_CASES_TAC then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        ASM_MESON_TAC(PairList [LE]),
        REWRITE_TAC(PairList [MIN])
      ] then_tac \
      ASM_CASES_TAC(@hol|{m:num <= n}|) then_tac \
      ASM_REWRITE_TAC(PairList []) then_list \
      PairList [
        FIRST_X_ASSUM(o(CHOOSE_THEN(SUBST1_TAC))(GEN_REWRITE_RULE(I)(PairList [LE_EXISTS]))) then_tac \
        MATCH_MP_TAC(MOD_LT) then_tac \
        MATCH_MP_TAC(LTE_TRANS) then_tac \
        EXISTS_TAC(@hol|{p EXP m}|) then_tac \
        ASM_SIMP_TAC(PairList [DIVISION, EXP_EQ_0, LE_EXP, LE_ADD]),
        SUBGOAL_THEN(
          @hol|{?d. m = n + d}|
        )(CHOOSE_THEN(SUBST1_TAC)) then_list \
        PairList [
          ASM_MESON_TAC(PairList [LE_CASES, LE_EXISTS]),
          ASM_SIMP_TAC(PairList [EXP_ADD, MOD_MOD, MULT_EQ_0, EXP_EQ_0])
        ]
      ]
    ]
  )

def [arith_DIV_EXP_v2, MOD_EXP]:
  o(CONJ_PAIR)(prove)(
    [
      @hol|{(!m n p. ~(m = 0)
                  ==> (m EXP n) DIV (m EXP p) =
                      if p <= n then m EXP (n - p)
                      else if m = 1 then 1 else 0) /\
         (!m n p. ~(m = 0)
                  ==> (m EXP n) MOD (m EXP p) =
                      if p <= n \/ m = 1 then 0 else m EXP n)}|,
      REWRITE_TAC(PairList [AND_FORALL_THM]) then_tac REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{m = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      MATCH_MP_TAC(DIVMOD_UNIQ) then_tac \
      ASM_CASES_TAC(@hol|{p:num <= n}|) then_tac \
      ASM_SIMP_TAC(PairList [GSYM(EXP_ADD), EXP_LT_0, SUB_ADD, ADD_CLAUSES]) then_tac \
      ASM_CASES_TAC(
        @hol|{m = 1}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [EXP_ONE, ADD_CLAUSES, MULT_CLAUSES, LT_EXP]) then_tac \
      REWRITE_TAC(PairList [LT, GSYM(NOT_LT), ONE, TWO]) then_tac \
      ASM_REWRITE_TAC(PairList [SYM(ONE), GSYM(NOT_LE)])
    ]
  )

def FORALL_LT_MOD_THM:
  prove(
    [
      @hol|{!P n. (!a. a < n ==> P a) <=> n = 0 \/ !a. P(a MOD n)}|,
      MESON_TAC(PairList [LT, MOD_EQ_SELF, MOD_LT_EQ])
    ]
  )

def FORALL_MOD_THM:
  prove(
    [
      @hol|{!P n. ~(n = 0) ==> ((!a. P(a MOD n)) <=> (!a. a < n ==> P a))}|,
      SIMP_TAC(PairList [FORALL_LT_MOD_THM])
    ]
  )

def EXISTS_LT_MOD_THM:
  prove(
    [
      @hol|{!P n. (?a. a < n /\ P a) <=> ~(n = 0) /\ ?a. P(a MOD n)}|,
      MESON_TAC(PairList [LT, MOD_EQ_SELF, MOD_LT_EQ])
    ]
  )

def EXISTS_MOD_THM:
  prove(
    [
      @hol|{!P n. ~(n = 0) ==> ((?a. P(a MOD n)) <=> (?a. a < n /\ P a))}|,
      SIMP_TAC(PairList [EXISTS_LT_MOD_THM])
    ]
  )

def PRE_ELIM_THM:
  prove(
    [
      @hol|{P(PRE n) <=> !m. n = SUC m \/ m = 0 /\ n = 0 ==> P m}|,
      SPEC_TAC([@hol|{n:num}|, @hol|{n:num}|]) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [NOT_SUC, SUC_INJ, PRE]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def arith_PRE_ELIM_THM_prime:
  prove(
    [
      @hol|{P(PRE n) <=> ?m. (n = SUC m \/ m = 0 /\ n = 0) /\ P m}|,
      MP_TAC(
        INST(
          PairList [
            [
              @hol|{\x:num. ~P x}|,
              @hol|{P:num->bool}|
            ]
          ]
        )(PRE_ELIM_THM)
      ) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def SUB_ELIM_THM:
  prove(
    [
      @hol|{P(a - b) <=> !d. a = b + d \/ a < b /\ d = 0 ==> P d}|,
      DISJ_CASES_TAC(SPECL(PairList [@hol|{a:num}|, @hol|{b:num}|])(LTE_CASES)) then_list \
      PairList [ASM_MESON_TAC(PairList [NOT_LT, SUB_EQ_0, LT_IMP_LE, LE_ADD]), ALL_TAC] then_tac \
      FIRST_ASSUM(
        o(X_CHOOSE_THEN(@hol|{e:num}|)(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))
      ) then_tac \
      SIMP_TAC(PairList [ADD_SUB2, GSYM(NOT_LE), LE_ADD, EQ_ADD_LCANCEL]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def arith_SUB_ELIM_THM_prime:
  prove(
    [
      @hol|{P(a - b) <=> ?d. (a = b + d \/ a < b /\ d = 0) /\ P d}|,
      MP_TAC(
        INST(
          PairList [
            [
              @hol|{\x:num. ~P x}|,
              @hol|{P:num->bool}|
            ]
          ]
        )(SUB_ELIM_THM)
      ) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def DIVMOD_ELIM_THM:
  prove(
    [
      @hol|{P (m DIV n) (m MOD n) <=>
         !q r. n = 0 /\ q = 0 /\ r = m \/ m = q * n + r /\ r < n ==> P q r}|,
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_list \
      PairList [
        ASM_MESON_TAC(PairList [DIVISION_0, LT]),
        FIRST_ASSUM(o(MP_TAC)(MATCH_MP(DIVISION))) then_tac \
        MESON_TAC(PairList [DIVMOD_UNIQ])
      ]
    ]
  )

def arith_DIVMOD_ELIM_THM_prime:
  prove(
    [
      @hol|{P (m DIV n) (m MOD n) <=>
         ?q r. (n = 0 /\ q = 0 /\ r = m \/ m = q * n + r /\ r < n) /\ P q r}|,
      MP_TAC(
        INST(
          PairList [
            [
              @hol|{\x:num y:num. ~P x y}|,
              @hol|{P:num->num->bool}|
            ]
          ]
        )(DIVMOD_ELIM_THM)
      ) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def MOD_DOWN_CONV:
  let MOD_SUC_MOD:
    METIS(
      PairList [ADD1, MOD_ADD_MOD, MOD_MOD_REFL])(
      @hol|{(SUC(m MOD n)) MOD n = SUC m MOD n}|
    )
  let addmul_conv:
    GEN_REWRITE_CONV(I)(
      PairList [
        GSYM(MOD_SUC_MOD),
        GSYM(MOD_ADD_MOD),
        GSYM(MOD_MULT_MOD2),
        GSYM(MOD_EXP_MOD)
      ]
    )
  let mod_conv = GEN_REWRITE_CONV(I)(PairList [MOD_MOD_REFL])
  fun downconv(tm):
    (
      addmul_conv then_conv LAND_CONV(downconv) or_conv (mod_conv then_conv downconv) or_conv \
      SUB_CONV(downconv)
    )(tm)
  let upconv:
    GEN_REWRITE_CONV(
      DEPTH_CONV)(
      PairList [MOD_SUC_MOD, MOD_ADD_MOD, MOD_MULT_MOD2, MOD_EXP_MOD, MOD_MOD_REFL]
    )
  (downconv then_conv upconv)

def NUM_CANCEL_CONV:
  // Recursive cancellation needs the local definition before its first use.
  fun minter(i):
    fun(l1_prime):
      fun(l2_prime):
        fun(l1):
          fun(l2):
            if (l1 == (PairList []))
            | [i, l1_prime, append(l2_prime)(l2)]
            | if (l2 == (PairList []))
              | [i, append(l1)(l1_prime), l2_prime]
              | let h1 = hd(l1)
                let h2 = hd(l2)
                if (h1 == h2)
                | minter(PairList [h1, & i])(l1_prime)(l2_prime)(tl(l1))(tl(l2))
                | (if (h1 < h2) | minter(i)(PairList [h1, & l1_prime])(l2_prime)(tl(l1))(l2) | minter(i)(l1_prime)(PairList [h2, & l2_prime])(l1)(tl(l2)))
  let add_tm = @hol|{(+)}|
  let eq_tm = @hol|{(=) :num->num->bool}|
  let EQ_ADD_LCANCEL_0_prime = GEN_REWRITE_RULE(o(funpow(2)(BINDER_CONV))(LAND_CONV))(PairList [EQ_SYM_EQ])(EQ_ADD_LCANCEL_0)
  let AC_RULE = AC(ADD_AC)
  fun(tm):
    let [l, r] = dest_eq(tm)
    let lats = sort(fun (x): fun (y): x <= y)(binops(@hol|{(+)}|)(l))
    let rats = sort(fun (x): fun (y): x <= y)(binops(@hol|{(+)}|)(r))
    let [i, lats_prime, rats_prime] = minter(PairList [])(PairList [])(PairList [])(lats)(rats)
    let l_prime = list_mk_binop(add_tm)(append(i)(lats_prime))
    let r_prime = list_mk_binop(add_tm)(append(i)(rats_prime))
    let lth = AC_RULE(mk_eq([l, l_prime]))
    let rth = AC_RULE(mk_eq([r, r_prime]))
    let eth = MK_COMB([AP_TERM(eq_tm)(lth), rth])
    GEN_REWRITE_RULE(
      o(RAND_CONV)(REPEATC))(
      PairList [EQ_ADD_LCANCEL, EQ_ADD_LCANCEL_0, EQ_ADD_LCANCEL_0_prime]
    )(eth)

def LE_IMP:
  let pth = PURE_ONCE_REWRITE_RULE(PairList [IMP_CONJ])(LE_TRANS)
  (fun(th): GEN_ALL(MATCH_MP(pth)(SPEC_ALL(th))))

Host.parse_as_binder("minimal")

def minimal:
  new_definition(
    @hol|{(minimal) (P:num->bool) = @n. P n /\ !m. m < n ==> ~(P m)}|
  )

def MINIMAL:
  prove(
    [
      @hol|{!P. (?n. P n) <=> P((minimal) P) /\ (!m. m < (minimal) P ==> ~(P m))}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [minimal]) then_tac \
      CONV_TAC(RAND_CONV(SELECT_CONV)) then_tac \
      REWRITE_TAC(PairList [GSYM(num_WOP)])
    ]
  )

def MINIMAL_UNIQUE:
  prove(
    [
      @hol|{!P n. P n /\ (!m. m < n ==> ~P m) ==> (minimal) P = n}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [minimal]) then_tac \
      MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      ASM_MESON_TAC(PairList [LT_CASES])
    ]
  )

def LE_MINIMAL:
  prove(
    [
      @hol|{!P n.
         (?r. P r) ==> (n <= (minimal) P <=> !i. P i ==> n <= i)}|,
      REPEAT(GEN_TAC) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [MINIMAL]) then_tac \
      MESON_TAC(PairList [NOT_LE, LE_TRANS])
    ]
  )

def MINIMAL_LE:
  prove(
    [
      @hol|{!P n. (?r. P r) ==> ((minimal) P <= n <=> ?i. i <= n /\ P i)}|,
      REWRITE_TAC(PairList [GSYM(NOT_LT)]) then_tac \
      REWRITE_TAC(PairList [GSYM(LE_SUC_LT)]) then_tac \
      SIMP_TAC(PairList [LE_MINIMAL]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def MINIMAL_UBOUND:
  prove(
    [
      @hol|{!P n. P n ==> (minimal) P <= n}|,
      MESON_TAC(PairList [MINIMAL, NOT_LT])
    ]
  )

def MINIMAL_LBOUND:
  prove(
    [
      @hol|{!P n. (?r. P r) /\ (!m. m < n ==> ~P m) ==> n <= (minimal) P}|,
      SIMP_TAC(PairList [LE_MINIMAL]) then_tac MESON_TAC(PairList [NOT_LT])
    ]
  )

def MINIMAL_MONO:
  prove(
    [
      @hol|{!P Q. (?n. P n) /\ (!n. P n ==> Q n) ==> (minimal) Q <= (minimal) P}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN(CONJUNCTS_THEN(ASSUME_TAC)) then_tac \
      SUBGOAL_THEN(@hol|{?n:num. Q n}|)(ASSUME_TAC) then_list \
      PairList [ASM_MESON_TAC(PairList []), ALL_TAC] then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [LE_TRANS, LE_REFL])(
          @hol|{(!p:num. p <= m ==> p <= n) ==> m <= n}|
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [LE_MINIMAL])
    ]
  )

def TRANSITIVE_STEPWISE_LT_EQ:
  prove(
    [
      @hol|{!R. (!x y z. R x y /\ R y z ==> R x z)
         ==> ((!m n. m < n ==> R m n) <=> (!n. R n (SUC n)))}|,
      REPEAT(STRIP_TAC) then_tac EQ_TAC then_tac \
      ASM_SIMP_TAC(PairList [LT]) then_tac \
      DISCH_TAC then_tac \
      SIMP_TAC(PairList [LT_EXISTS, LEFT_IMP_EXISTS_THM]) then_tac \
      GEN_TAC then_tac \
      ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
      REWRITE_TAC(PairList [LEFT_FORALL_IMP_THM, EXISTS_REFL, ADD_CLAUSES]) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [ADD_CLAUSES]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def TRANSITIVE_STEPWISE_LT:
  prove(
    [
      @hol|{!R. (!x y z. R x y /\ R y z ==> R x z) /\ (!n. R n (SUC n))
         ==> !m n. m < n ==> R m n}|,
      REPEAT(GEN_TAC) then_tac \
      MATCH_MP_TAC(
        TAUT(
          @hol|{(a ==> (c <=> b)) ==> a /\ b ==> c}|
        )
      ) then_tac \
      MATCH_ACCEPT_TAC(TRANSITIVE_STEPWISE_LT_EQ)
    ]
  )

def TRANSITIVE_STEPWISE_LE_EQ:
  prove(
    [
      @hol|{!R. (!x. R x x) /\ (!x y z. R x y /\ R y z ==> R x z)
         ==> ((!m n. m <= n ==> R m n) <=> (!n. R n (SUC n)))}|,
      REPEAT(STRIP_TAC) then_tac EQ_TAC then_tac \
      ASM_SIMP_TAC(PairList [LE, LE_REFL]) then_tac \
      DISCH_TAC then_tac \
      SIMP_TAC(PairList [LE_EXISTS, LEFT_IMP_EXISTS_THM]) then_tac \
      GEN_TAC then_tac \
      ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
      REWRITE_TAC(PairList [LEFT_FORALL_IMP_THM, EXISTS_REFL, ADD_CLAUSES]) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [ADD_CLAUSES]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def TRANSITIVE_STEPWISE_LE:
  prove(
    [
      @hol|{!R. (!x. R x x) /\ (!x y z. R x y /\ R y z ==> R x z) /\
         (!n. R n (SUC n))
         ==> !m n. m <= n ==> R m n}|,
      REPEAT(GEN_TAC) then_tac \
      MATCH_MP_TAC(
        TAUT(
          @hol|{(a /\ a' ==> (c <=> b)) ==> a /\ a' /\ b ==> c}|
        )
      ) then_tac \
      MATCH_ACCEPT_TAC(TRANSITIVE_STEPWISE_LE_EQ)
    ]
  )

def DEPENDENT_CHOICE_FIXED:
  prove(
    [
      @hol|{!P R a:A.
         P 0 a /\ (!n x. P n x ==> ?y. P (SUC n) y /\ R n x y)
         ==> ?f. f 0 = a /\ (!n. P n (f n)) /\ (!n. R n (f n) (f(SUC n)))}|,
      REPEAT(STRIP_TAC) then_tac \
      o(MP_TAC)(prove_recursive_functions_exist(num_RECURSION))(
        @hol|{f 0 = (a:A) /\ (!n. f(SUC n) = @y. P (SUC n) y /\ R n (f n) y)}|
      ) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      GEN_TAC then_tac \
      STRIP_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(
        PairList [
          MESON(
            PairList [num_CASES])(
            @hol|{(!n. P n) <=> P 0 /\ !n. P(SUC n)}|
          )
        ]
      ) then_tac \
      ASM_REWRITE_TAC(PairList [AND_FORALL_THM]) then_tac \
      INDUCT_TAC then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def DEPENDENT_CHOICE:
  prove(
    [
      @hol|{!P R:num->A->A->bool.
         (?a. P 0 a) /\ (!n x. P n x ==> ?y. P (SUC n) y /\ R n x y)
         ==> ?f. (!n. P n (f n)) /\ (!n. R n (f n) (f(SUC n)))}|,
      MESON_TAC(PairList [DEPENDENT_CHOICE_FIXED])
    ]
  )

def BITS_ELIM_CONV:
  let NUMERAL_pth:
    prove(
      [
        @hol|{m = n <=> NUMERAL m = n}|,
        REWRITE_TAC(PairList [NUMERAL])
      ]
    )
  let ZERO_pth:
    GSYM(
      REWRITE_CONV(PairList [NUMERAL])(@hol|{0}|)
    )
  let [BIT0_pth, BIT1_pth]:
    CONJ_PAIR(
      prove(
        [
          @hol|{(m = n <=> BIT0 m = 2 * n) /\
             (m = n <=> BIT1 m = 2 * n + 1)}|,
          CONJ_TAC then_tac \
          GEN_REWRITE_TAC(o(RAND_CONV)(LAND_CONV))(PairList [BIT0, BIT1]) then_tac \
          REWRITE_TAC(PairList [ADD1, EQ_ADD_RCANCEL, GSYM(MULT_2)]) then_tac \
          REWRITE_TAC(PairList [EQ_MULT_LCANCEL]) then_tac \
          REWRITE_TAC(PairList [TWO, NOT_SUC])
        ]
      )
    )
  let [mvar, nvar] = [@hol|{m:num}|, @hol|{n:num}|]
  fun BITS_ELIM_CONV(tm):
    match tm
    | Const("_0",_): ZERO_pth
    | Var(_,_): REFL(tm)
    | Const(_,_): REFL(tm)
    | Comb(Const("NUMERAL",_),mtm):
        if is_numeral(tm)
        | REFL(tm)
        | let th = BITS_ELIM_CONV(mtm)
          EQ_MP(INST(PairList [[mtm, mvar], [rand(concl(th)), nvar]])(NUMERAL_pth))(th)
    | Comb(Const("BIT0",_),mtm):
        let th = BITS_ELIM_CONV(mtm)
        EQ_MP(INST(PairList [[mtm, mvar], [rand(concl(th)), nvar]])(BIT0_pth))(th)
    | Comb(Const("BIT1",_),mtm):
        let th = BITS_ELIM_CONV(mtm)
        EQ_MP(INST(PairList [[mtm, mvar], [rand(concl(th)), nvar]])(BIT1_pth))(th)
    | Comb(_,_): COMB_CONV(BITS_ELIM_CONV)(tm)
    | Abs(_,_): ABS_CONV(BITS_ELIM_CONV)(tm)
  BITS_ELIM_CONV

def DIV_0 = arith_DIV_0_v2

def DIV_MULT = arith_DIV_MULT_v2

def DIV_1 = arith_DIV_1_v2

def DIV_EXP = arith_DIV_EXP_v2

def PRE_ELIM_THM_prime = arith_PRE_ELIM_THM_prime

def SUB_ELIM_THM_prime = arith_SUB_ELIM_THM_prime

def DIVMOD_ELIM_THM_prime = arith_DIVMOD_ELIM_THM_prime
