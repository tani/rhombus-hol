def EVEN_DOUBLE:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         forall n :: num: EVEN((2 :: num) * n)),
      (
        (
          ((GEN_TAC then_tac REWRITE_TAC(PairList [EVEN_MULT])) then_tac DISJ1_TAC) then_tac \
          PURE_REWRITE_TAC(PairList [BIT0_THM, BIT1_THM])
        ) then_tac \
        REWRITE_TAC(PairList [EVEN, EVEN_ADD])
      )
    ]
  )

def ODD_DOUBLE:
  prove(
    [
      (hol:
         const ODD :: num -> bool
         const SUC :: num -> num
         forall n :: num: ODD(SUC((2 :: num) * n))),
      (REWRITE_TAC(PairList [ODD]) then_tac REWRITE_TAC(PairList [NOT_ODD, EVEN_DOUBLE]))
    ]
  )

def EVEN_EXISTS_LEMMA:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         const SUC :: num -> num
         forall n :: num:
           (EVEN(n) ==> (exists m :: num: n == (2 :: num) * m))
             && (!EVEN(n) ==> (exists m :: num: n == SUC((2 :: num) * m)))),
      (
        (INDUCT_TAC then_tac REWRITE_TAC(PairList [EVEN])) then_list \
        PairList [
          (
            EXISTS_TAC(hol:
                         (0 :: num)) then_tac \
            REWRITE_TAC(PairList [MULT_CLAUSES])
          ),
          (
            (
              (POP_ASSUM(STRIP_ASSUME_TAC) then_tac CONJ_TAC) then_tac \
              DISCH_THEN(ANTE_RES_THEN(X_CHOOSE_TAC(hol: var m :: num; m)))
            ) then_list \
            PairList [
              (
                (
                  (
                    EXISTS_TAC(hol:
                                 var m :: num
                                 const SUC :: num -> num
                                 SUC(m)) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_tac \
                  REWRITE_TAC(PairList [MULT_2])
                ) then_tac \
                REWRITE_TAC(PairList [ADD_CLAUSES])
              ),
              (EXISTS_TAC(hol: var m :: num; m) then_tac ASM_REWRITE_TAC(PairList []))
            ]
          )
        ]
      )
    ]
  )

def EVEN_EXISTS:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         forall n :: num: EVEN(n) <=> (exists m :: num: n == (2 :: num) * m)),
      (
        ((GEN_TAC then_tac EQ_TAC) then_tac DISCH_TAC) then_list \
        PairList [
          (
            MATCH_MP_TAC(CONJUNCT1(SPEC_ALL(EVEN_EXISTS_LEMMA))) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ),
          (
            POP_ASSUM(CHOOSE_THEN(SUBST1_TAC)) then_tac \
            REWRITE_TAC(PairList [EVEN_DOUBLE])
          )
        ]
      )
    ]
  )

def ODD_EXISTS:
  prove(
    [
      (hol:
         const ODD :: num -> bool
         const SUC :: num -> num
         forall n :: num: ODD(n) <=> (exists m :: num: n == SUC((2 :: num) * m))),
      (
        ((GEN_TAC then_tac EQ_TAC) then_tac DISCH_TAC) then_list \
        PairList [
          (
            MATCH_MP_TAC(CONJUNCT2(SPEC_ALL(EVEN_EXISTS_LEMMA))) then_tac \
            ASM_REWRITE_TAC(PairList [NOT_EVEN])
          ),
          (
            POP_ASSUM(CHOOSE_THEN(SUBST1_TAC)) then_tac \
            REWRITE_TAC(PairList [ODD_DOUBLE])
          )
        ]
      )
    ]
  )

def EVEN_ODD_DECOMPOSITION:
  prove(
    [
      (hol:
         const ODD :: num -> bool
         const EXP :: num -> num -> num
         forall n :: num:
           (exists (k :: num, m :: num): ODD(m) && n == EXP((2 :: num), k) * m) <=> n != (0 :: num)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            (MATCH_MP_TAC(num_WF) then_tac X_GEN_TAC(hol: var n :: num; n)) then_tac \
                                            DISCH_TAC
                                          ) then_tac \
                                          DISJ_CASES_TAC(SPEC(hol: var n :: num; n)(EVEN_OR_ODD))
                                        ) then_list \
                                        PairList [ALL_TAC, ASM_MESON_TAC(PairList [ODD, EXP, MULT_CLAUSES])]
                                      ) then_tac \
                                      FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [EVEN_EXISTS])))
                                    ) then_tac \
                                    DISCH_THEN(X_CHOOSE_THEN(hol: var m :: num; m)(SUBST_ALL_TAC))
                                  ) then_tac \
                                  FIRST_X_ASSUM(o(MP_TAC)(SPEC(hol: var m :: num; m)))
                                ) then_tac \
                                ASM_CASES_TAC(
                                  (hol:
                                     var m :: num
                                     m == (0 :: num))
                                )
                              ) then_tac \
                              ASM_REWRITE_TAC(PairList [MULT_EQ_0])
                            ) then_list \
                            PairList [
                              (
                                (
                                  (
                                    REWRITE_TAC(PairList [MULT_CLAUSES, LT]) then_tac \
                                    CONV_TAC(ONCE_DEPTH_CONV(SYM_CONV))
                                  ) then_tac \
                                  REWRITE_TAC(PairList [EXP_EQ_0, MULT_EQ_0, TWO, NOT_SUC])
                                ) then_tac \
                                MESON_TAC(PairList [ODD])
                              ),
                              ALL_TAC
                            ]
                          ) then_tac \
                          ANTS_TAC
                        ) then_list \
                        PairList [
                          (
                            GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(el(2)(CONJUNCTS(MULT_CLAUSES)))]) then_tac \
                            ASM_REWRITE_TAC(PairList [LT_MULT_RCANCEL, TWO, LT])
                          ),
                          ALL_TAC
                        ]
                      ) then_tac \
                      REWRITE_TAC(PairList [TWO, NOT_SUC])
                    ) then_tac \
                    REWRITE_TAC(PairList [GSYM(TWO)])
                  ) then_tac \
                  ONCE_REWRITE_TAC(PairList [SWAP_EXISTS_THM])
                ) then_tac \
                MATCH_MP_TAC(MONO_EXISTS)
              ) then_tac \
              X_GEN_TAC(hol: var p :: num; p)
            ) then_tac \
            DISCH_THEN(X_CHOOSE_THEN(hol: var k :: num; k)(STRIP_ASSUME_TAC))
          ) then_tac \
          EXISTS_TAC(hol:
                       var k :: num
                       const SUC :: num -> num
                       SUC(k))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [EXP, MULT_ASSOC])
      )
    ]
  )

def SUB:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var #{-} :: num -> num -> num
       const SUC :: num -> num
       const PRE :: num -> num
       (forall m :: num: var.#{-}(m, (0 :: num)) == m)
         && (forall (m :: num, n :: num): var.#{-}(m, SUC(n)) == PRE(var.#{-}(m, n))))
  )

def SUB_0:
  prove(
    [
      (hol:
         forall m :: num: (0 :: num) - m == (0 :: num) && m - (0 :: num) == m),
      (
        (REWRITE_TAC(PairList [SUB]) then_tac INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [SUB, PRE])
      )
    ]
  )

def SUB_PRESUC:
  prove(
    [
      (hol:
         const PRE :: num -> num
         const SUC :: num -> num
         forall (m :: num, n :: num): PRE(SUC(m) - n) == m - n),
      ((GEN_TAC then_tac INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [SUB, PRE]))
    ]
  )

def SUB_SUC:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall (m :: num, n :: num): SUC(m) - SUC(n) == m - n),
      (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [SUB, PRE, SUB_PRESUC]))
    ]
  )

def SUB_REFL:
  prove(
    [
      (hol:
         forall n :: num: n - n == (0 :: num)),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [SUB_SUC, SUB_0]))
    ]
  )

def ADD_SUB:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m + n - n == m),
      (
        (GEN_TAC then_tac INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [ADD_CLAUSES, SUB_SUC, SUB_0])
      )
    ]
  )

def ADD_SUB2:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m + n - m == n),
      (ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(ADD_SUB))
    ]
  )

def SUB_EQ_0:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m - n == (0 :: num) <=> m <= n),
      (
        (REPEAT(INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [SUB_SUC, LE_SUC, SUB_0])) then_tac \
        REWRITE_TAC(PairList [LE, LE_0])
      )
    ]
  )

def ADD_SUBR2:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): m - (m + n) == (0 :: num)),
      REWRITE_TAC(PairList [SUB_EQ_0, LE_ADD])
    ]
  )

def ADD_SUBR:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): n - (m + n) == (0 :: num)),
      (ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(ADD_SUBR2))
    ]
  )

def SUB_ADD:
  prove(
    [
      (hol:
         forall (m :: num, n :: num): n <= m ==> m - n + n == m),
      (
        (
          (REWRITE_TAC(PairList [LE_EXISTS]) then_tac REPEAT(STRIP_TAC)) then_tac \
          ASM_REWRITE_TAC(PairList [ONCE_REWRITE_RULE(PairList [ADD_SYM])(ADD_SUB)])
        ) then_tac \
        MATCH_ACCEPT_TAC(ADD_SYM)
      )
    ]
  )

def SUB_ADD_LCANCEL:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m + n - (m + p) == n - p),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD_CLAUSES, SUB_0, SUB_SUC]))
    ]
  )

def SUB_ADD_RCANCEL:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m + p - (n + p) == m - n),
      (ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_ACCEPT_TAC(SUB_ADD_LCANCEL))
    ]
  )

def LEFT_SUB_DISTRIB:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): m * (n - p) == m * n - m * p),
      (
        (
          (REPEAT(GEN_TAC) then_tac CONV_TAC(SYM_CONV)) then_tac \
          DISJ_CASES_TAC(SPECL(PairList [(hol: var n :: num; n), (hol: var p :: num; p)])(LE_CASES))
        ) then_list \
        PairList [
          (
            FIRST_ASSUM((fun(th): REWRITE_TAC(PairList [REWRITE_RULE(PairList [GSYM(SUB_EQ_0)])(th)]))) then_tac \
            ASM_REWRITE_TAC(PairList [MULT_CLAUSES, SUB_EQ_0, LE_MULT_LCANCEL])
          ),
          (
            (
              POP_ASSUM(o(CHOOSE_THEN(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))) then_tac \
              REWRITE_TAC(PairList [LEFT_ADD_DISTRIB])
            ) then_tac \
            REWRITE_TAC(PairList [ONCE_REWRITE_RULE(PairList [ADD_SYM])(ADD_SUB)])
          )
        ]
      )
    ]
  )

def RIGHT_SUB_DISTRIB:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, p :: num): (m - n) * p == m * p - n * p),
      (ONCE_REWRITE_TAC(PairList [MULT_SYM]) then_tac MATCH_ACCEPT_TAC(LEFT_SUB_DISTRIB))
    ]
  )

def SUC_SUB1:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall n :: num: SUC(n) - (1 :: num) == n),
      REWRITE_TAC(PairList [ONE, SUB_SUC, SUB_0])
    ]
  )

def EVEN_SUB:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         forall (m :: num, n :: num): EVEN(m - n) <=> m <= n || (EVEN(m) <=> EVEN(n))),
      (
        (
          (
            (
              (
                (
                  REPEAT(GEN_TAC) then_tac \
                  ASM_CASES_TAC(hol:
                                  var m :: num
                                  var n :: num
                                  m <= n)
                ) then_list \
                PairList [ASM_MESON_TAC(PairList [SUB_EQ_0, EVEN]), ALL_TAC]
              ) then_tac \
              DISJ_CASES_TAC(SPECL(PairList [(hol: var m :: num; m), (hol: var n :: num; n)])(LE_CASES))
            ) then_tac \
            ASM_SIMP_TAC(PairList [])
          ) then_tac \
          FIRST_ASSUM(
            o(o(MP_TAC)(AP_TERM(hol: const EVEN :: num -> bool; EVEN)))(MATCH_MP(SUB_ADD))
          )
        ) then_tac \
        ASM_MESON_TAC(PairList [EVEN_ADD])
      )
    ]
  )

def ODD_SUB:
  prove(
    [
      (hol:
         const ODD :: num -> bool
         forall (m :: num, n :: num): ODD(m - n) <=> n < m && ODD(m) != ODD(n)),
      (
        REWRITE_TAC(PairList [GSYM(NOT_EVEN), EVEN_SUB, DE_MORGAN_THM, NOT_LE]) then_tac \
        CONV_TAC(TAUT)
      )
    ]
  )

def FACT:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var FACT :: num -> num
       const SUC :: num -> num
       FACT((0 :: num)) == (1 :: num) && (forall n :: num: FACT(SUC(n)) == SUC(n) * FACT(n)))
  )

def FACT_LT:
  prove(
    [
      (hol:
         const FACT :: num -> num
         forall n :: num: (0 :: num) < FACT(n)),
      (
        (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [FACT, LT_MULT])) then_tac \
        REWRITE_TAC(PairList [ONE, LT_0])
      )
    ]
  )

def FACT_LE:
  prove(
    [
      (hol:
         const FACT :: num -> num
         forall n :: num: (1 :: num) <= FACT(n)),
      REWRITE_TAC(PairList [ONE, LE_SUC_LT, FACT_LT])
    ]
  )

def FACT_NZ:
  prove(
    [
      (hol:
         const FACT :: num -> num
         forall n :: num: FACT(n) != (0 :: num)),
      REWRITE_TAC(PairList [GSYM(LT_NZ), FACT_LT])
    ]
  )

def FACT_MONO:
  prove(
    [
      (hol:
         const FACT :: num -> num
         forall (m :: num, n :: num): m <= n ==> FACT(m) <= FACT(n)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REPEAT(GEN_TAC) then_tac \
                            DISCH_THEN(
                              o(X_CHOOSE_THEN(hol: var d :: num; d)(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))
                            )
                          ) then_tac \
                          SPEC_TAC([(hol: var d :: num; d), (hol: var d :: num; d)])
                        ) then_tac \
                        INDUCT_TAC
                      ) then_tac \
                      REWRITE_TAC(PairList [ADD_CLAUSES, LE_REFL])
                    ) then_tac \
                    REWRITE_TAC(PairList [FACT])
                  ) then_tac \
                  MATCH_MP_TAC(LE_TRANS)
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     var m :: num
                     var d :: num
                     const FACT :: num -> num
                     FACT(m + d))
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(el(2)(CONJUNCTS(MULT_CLAUSES)))])
          ) then_tac \
          REWRITE_TAC(PairList [LE_MULT_RCANCEL])
        ) then_tac \
        REWRITE_TAC(PairList [ONE, LE_SUC, LE_0])
      )
    ]
  )

def EXP_LT_0:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall (n :: num, x :: num): (0 :: num) < EXP(x, n) <=> x != (0 :: num) || n == (0 :: num)),
      REWRITE_TAC(PairList [GSYM(NOT_LE), LE, EXP_EQ_0, DE_MORGAN_THM])
    ]
  )

def LT_EXP:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall (x :: num, m :: num, n :: num):
           EXP(x, m) < EXP(x, n)
             <=> (2 :: num) <= x && m < n || x == (0 :: num) && (m != (0 :: num) && n == (0 :: num))),
      (
        (
          (
            (
              (
                REPEAT(GEN_TAC) then_tac \
                ASM_CASES_TAC(
                  (hol:
                     var x :: num
                     x == (0 :: num))
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_list \
            PairList [
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REWRITE_TAC(PairList [GSYM(NOT_LT), TWO, ONE, LT]) then_tac \
                            SPEC_TAC([(hol: var n :: num; n), (hol: var n :: num; n)])
                          ) then_tac \
                          INDUCT_TAC
                        ) then_tac \
                        REWRITE_TAC(PairList [EXP, NOT_SUC, MULT_CLAUSES, LT])
                      ) then_tac \
                      SPEC_TAC([(hol: var m :: num; m), (hol: var m :: num; m)])
                    ) then_tac \
                    INDUCT_TAC
                  ) then_tac \
                  REWRITE_TAC(PairList [EXP, MULT_CLAUSES, NOT_SUC, LT_REFL, LT])
                ) then_tac \
                REWRITE_TAC(PairList [ONE, LT_0])
              ),
              ALL_TAC
            ]
          ) then_tac \
          EQ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    CONV_TAC(CONTRAPOS_CONV) then_tac \
                                    REWRITE_TAC(PairList [NOT_LT, DE_MORGAN_THM, NOT_LE])
                                  ) then_tac \
                                  REWRITE_TAC(PairList [TWO, ONE, LT])
                                ) then_tac \
                                ASM_REWRITE_TAC(PairList [SYM(ONE)])
                              ) then_tac \
                              STRIP_TAC
                            ) then_tac \
                            ASM_REWRITE_TAC(PairList [EXP_ONE, LE_REFL])
                          ) then_tac \
                          FIRST_ASSUM(
                            o(X_CHOOSE_THEN(hol: var d :: num; d)(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))
                          )
                        ) then_tac \
                        SPEC_TAC([(hol: var d :: num; d), (hol: var d :: num; d)])
                      ) then_tac \
                      INDUCT_TAC
                    ) then_tac \
                    REWRITE_TAC(PairList [ADD_CLAUSES, EXP, LE_REFL])
                  ) then_tac \
                  MATCH_MP_TAC(LE_TRANS)
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     var x :: num
                     var n :: num
                     var d :: num
                     const EXP :: num -> num -> num
                     (1 :: num) * EXP(x, n + d))
                )
              ) then_tac \
              CONJ_TAC
            ) then_list \
            PairList [
              ASM_REWRITE_TAC(PairList [MULT_CLAUSES]),
              (
                (
                  (
                    (
                      (REWRITE_TAC(PairList [LE_MULT_RCANCEL]) then_tac DISJ1_TAC) then_tac \
                      UNDISCH_TAC(
                        (hol:
                           var x :: num
                           x != (0 :: num))
                      )
                    ) then_tac \
                    CONV_TAC(CONTRAPOS_CONV)
                  ) then_tac \
                  REWRITE_TAC(PairList [NOT_LE])
                ) then_tac \
                REWRITE_TAC(PairList [ONE, LT])
              )
            ]
          ),
          (
            (
              (
                (
                  (
                    STRIP_TAC then_tac \
                    FIRST_ASSUM(
                      o(X_CHOOSE_THEN(hol: var d :: num; d)(SUBST1_TAC))(REWRITE_RULE(PairList [LT_EXISTS]))
                    )
                  ) then_tac \
                  SPEC_TAC([(hol: var d :: num; d), (hol: var d :: num; d)])
                ) then_tac \
                INDUCT_TAC
              ) then_tac \
              REWRITE_TAC(PairList [ADD_CLAUSES, EXP])
            ) then_list \
            PairList [
              (
                (
                  (
                    MATCH_MP_TAC(LTE_TRANS) then_tac \
                    EXISTS_TAC(
                      (hol:
                         var x :: num
                         var m :: num
                         const EXP :: num -> num -> num
                         (2 :: num) * EXP(x, m))
                    )
                  ) then_tac \
                  CONJ_TAC
                ) then_list \
                PairList [
                  ASM_REWRITE_TAC(PairList [MULT_2, LT_ADD, EXP_LT_0]),
                  ASM_REWRITE_TAC(PairList [LE_MULT_RCANCEL])
                ]
              ),
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              MATCH_MP_TAC(LTE_TRANS) then_tac \
                              EXISTS_TAC(
                                (hol:
                                   var x :: num
                                   var m :: num
                                   var d :: num
                                   const EXP :: num -> num -> num
                                   const SUC :: num -> num
                                   EXP(x, m + SUC(d)))
                              )
                            ) then_tac \
                            ASM_REWRITE_TAC(PairList [])
                          ) then_tac \
                          REWRITE_TAC(PairList [ADD_CLAUSES, EXP, MULT_ASSOC, LE_MULT_RCANCEL])
                        ) then_tac \
                        DISJ1_TAC
                      ) then_tac \
                      MATCH_MP_TAC(LE_TRANS)
                    ) then_tac \
                    EXISTS_TAC(
                      (hol:
                         var x :: num
                         x * (1 :: num))
                    )
                  ) then_tac \
                  CONJ_TAC
                ) then_list \
                PairList [
                  REWRITE_TAC(PairList [MULT_CLAUSES, LE_REFL]),
                  (
                    (
                      (
                        (
                          (REWRITE_TAC(PairList [LE_MULT_LCANCEL]) then_tac DISJ2_TAC) then_tac \
                          UNDISCH_TAC(
                            (hol:
                               var x :: num
                               x != (0 :: num))
                          )
                        ) then_tac \
                        CONV_TAC(CONTRAPOS_CONV)
                      ) then_tac \
                      REWRITE_TAC(PairList [NOT_LE])
                    ) then_tac \
                    REWRITE_TAC(PairList [ONE, LT])
                  )
                ]
              )
            ]
          )
        ]
      )
    ]
  )

def LE_EXP:
  prove(
    [
      (hol:
         const EXP :: num -> num -> num
         forall (x :: num, m :: num, n :: num):
           EXP(x, m) <= EXP(x, n)
             <=> (if x == (0 :: num) | m == (0 :: num) ==> n == (0 :: num) | x == (1 :: num) || m <= n)),
      (
        (
          (
            (
              REPEAT(GEN_TAC) then_tac \
              REWRITE_TAC(PairList [GSYM(NOT_LT), LT_EXP, DE_MORGAN_THM])
            ) then_tac \
            COND_CASES_TAC
          ) then_tac \
          ASM_REWRITE_TAC(PairList [TWO, LT, ONE])
