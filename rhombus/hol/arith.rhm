                    ASM_REWRITE_TAC(PairList [MULT_CLAUSES])
                  ) then_tac \
                  EQ_TAC
                ) then_tac \
                STRIP_TAC
              ) then_tac \
              ASM_SIMP_TAC(PairList [MOD_MULT])
            ) then_tac \
            EXISTS_TAC(Host.hol_term(App(Const("DIV", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)])))
          ) then_tac \
          SUBGOAL_THEN(
            Host.hol_term(Eq(
              Num,
              Var("m", Num),
              App(
                Const("+", Fun(Num, Fun(Num, Num))),
                [
                  App(
                    Const("*", Fun(Num, Fun(Num, Num))),
                    [App(Const("DIV", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)]), Var("n", Num)]
                  ),
                  App(Const("MOD", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)])
                ]
              )
            ))
          )((fun(th): GEN_REWRITE_TAC(LAND_CONV)(PairList [th])))
        ) then_list \
        PairList [
          ASM_MESON_TAC(PairList [DIVISION]),
          ASM_REWRITE_TAC(PairList [ADD_CLAUSES, MULT_AC])
