def MOD_EXP_MOD:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         const EXP :: num -> num -> num
         forall (m :: num, n :: num, p :: num): MOD(EXP(MOD(m, n), p), n) == MOD(EXP(m, p), n)),
