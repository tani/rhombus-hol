def PRE:
  new_recursive_definition(num_RECURSION)(
    Host.hol_term(And(
      Eq(
        Num,
        App(Var("PRE", Fun(Num, Num)), [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]),
        App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])
      ),
      Forall(
        "n",
        Num,
        Eq(
          Num,
          App(Var("PRE", Fun(Num, Num)), [App(Const("SUC", Fun(Num, Num)), [Ref("n")])]),
          Ref("n")
        )
      )
    ))
  )

def ADD:
  new_recursive_definition(num_RECURSION)(
    Host.hol_term(And(
      Forall(
        "n",
        Num,
        Eq(
          Num,
          App(
            Var("+", Fun(Num, Fun(Num, Num))),
            [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]), Ref("n")]
          ),
          Ref("n")
        )
      ),
      Forall(
        "m",
        Num,
        Forall(
          "n",
          Num,
          Eq(
            Num,
            App(Var("+", Fun(Num, Fun(Num, Num))), [App(Const("SUC", Fun(Num, Num)), [Ref("m")]), Ref("n")]),
            App(Const("SUC", Fun(Num, Num)), [App(Var("+", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])])
          )
        )
      )
    ))
  )

def ADD_0:
  prove(
    [
      Host.hol_term(Forall(
        "m",
        Num,
        Eq(
          Num,
          App(
            Const("+", Fun(Num, Fun(Num, Num))),
            [Ref("m"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
          ),
          Ref("m")
        )
      )),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ADD]))
    ]
  )

