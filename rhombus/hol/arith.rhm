  )

def DIV_MONO:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall (m :: num, n :: num, p :: num): m <= n ==> DIV(m, p) <= DIV(n, p)),
      (
        (
          (
            (
              (
                REPEAT(STRIP_TAC) then_tac \
                ASM_CASES_TAC(
                  (hol:
                     var p :: num
                     p == (0 :: num))
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [DIV_ZERO, LE_REFL])
            ) then_tac \
            MATCH_MP_TAC(
              MESON(
                PairList [LE_REFL])(
                (hol:
                   var a :: num
                   var b :: num
                   (forall k :: num: k <= a ==> k <= b) ==> a <= b)
              )
            )
          ) then_tac \
          ASM_SIMP_TAC(PairList [LE_RDIV_EQ])
        ) then_tac \
        ASM_MESON_TAC(PairList [LE_TRANS])
      )
    ]
  )

def DIV_MONO_LT:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall (m :: num, n :: num, p :: num): p != (0 :: num) && m + p <= n ==> DIV(m, p) < DIV(n, p)),
      (
        (
