def MOD_MULT_ADD:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         (forall (m :: num, n :: num, p :: num): MOD(m * n + p, n) == MOD(p, n))
           && ((forall (m :: num, n :: num, p :: num): MOD(n * m + p, n) == MOD(p, n))
                 && ((forall (m :: num, n :: num, p :: num): MOD(p + m * n, n) == MOD(p, n))
                       && (forall (m :: num, n :: num, p :: num): MOD(p + n * m, n) == MOD(p, n))))),
      (
        (
          (
            (
              (
                (
                  (
                    MATCH_MP_TAC(
                      TAUT(
                        (hol:
                           var p :: bool
                           var q :: bool
                           (p ==> q) && p ==> p && q)
                      )
                    ) then_tac \
                    CONJ_TAC
                  ) then_list \
                  PairList [SIMP_TAC(PairList [MULT_AC, ADD_AC]), REPEAT(GEN_TAC)]
                ) then_tac \
                ASM_CASES_TAC(
                  (hol:
                     var n :: num
                     n == (0 :: num))
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES])
            ) then_tac \
            MATCH_MP_TAC(MOD_UNIQ)
          ) then_tac \
          EXISTS_TAC(
            (hol:
               var m :: num
               var p :: num
               var n :: num
               const DIV :: num -> num -> num
               m + DIV(p, n))
          )
        ) then_tac \
        ASM_SIMP_TAC(PairList [RIGHT_ADD_DISTRIB, GSYM(ADD_ASSOC), EQ_ADD_LCANCEL, DIVISION])
      )
    ]
  )

def DIV_MULT_ADD:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         (forall (a :: num, b :: num, n :: num):
            n != (0 :: num) ==> DIV(a * n + b, n) == a + DIV(b, n))
           && ((forall (a :: num, b :: num, n :: num):
                  n != (0 :: num) ==> DIV(n * a + b, n) == a + DIV(b, n))
                 && ((forall (a :: num, b :: num, n :: num):
                        n != (0 :: num) ==> DIV(b + a * n, n) == DIV(b, n) + a)
                       && (forall (a :: num, b :: num, n :: num):
                             n != (0 :: num) ==> DIV(b + n * a, n) == DIV(b, n) + a)))),
      (
        (
          (
            (
              (
                (
                  MATCH_MP_TAC(
                    TAUT(
                      (hol:
                         var p :: bool
                         var q :: bool
                         (p ==> q) && p ==> p && q)
                    )
                  ) then_tac \
                  CONJ_TAC
                ) then_list \
                PairList [SIMP_TAC(PairList [MULT_AC, ADD_AC]), REPEAT(STRIP_TAC)]
              ) then_tac \
              MATCH_MP_TAC(DIV_UNIQ)
            ) then_tac \
            EXISTS_TAC(hol:
                         var b :: num
                         var n :: num
                         const MOD :: num -> num -> num
                         MOD(b, n))
          ) then_tac \
          REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, GSYM(ADD_ASSOC)])
        ) then_tac \
        ASM_MESON_TAC(PairList [DIVISION])
      )
    ]
  )

def MOD_ADD_MOD:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         forall (a :: num, b :: num, n :: num): MOD(MOD(a, n) + MOD(b, n), n) == MOD(a + b, n)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REPEAT(GEN_TAC) then_tac \
                        ASM_CASES_TAC(
                          (hol:
                             var n :: num
                             n == (0 :: num))
                        )
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [MOD_ZERO])
                    ) then_tac \
                    CONV_TAC(SYM_CONV)
                  ) then_tac \
                  MATCH_MP_TAC(MOD_EQ)
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     var a :: num
                     var n :: num
                     var b :: num
                     const DIV :: num -> num -> num
                     DIV(a, n) + DIV(b, n))
                )
              ) then_tac \
              REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB])
            ) then_tac \
            ONCE_REWRITE_TAC(
              PairList [
                AC(ADD_AC)(
                  (hol:
                     var a :: num
                     var b :: num
                     var c :: num
                     var d :: num
                     a + b + (c + d) == c + a + (d + b))
                )
              ]
            )
          ) then_tac \
          BINOP_TAC
        ) then_tac \
        ASM_SIMP_TAC(PairList [DIVISION])
      )
    ]
  )

def DIV_ADD_MOD:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         const DIV :: num -> num -> num
         forall (a :: num, b :: num, n :: num):
           n != (0 :: num)
             ==> (MOD(a + b, n) == MOD(a, n) + MOD(b, n) <=> DIV(a + b, n) == DIV(a, n) + DIV(b, n))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REPEAT(STRIP_TAC) then_tac \
                        FIRST_ASSUM(o(MP_TAC)(MATCH_MP(DIVISION)))
                      ) then_tac \
                      DISCH_THEN(
                        fun(th):
                          MAP_EVERY(o(o(MP_TAC)(CONJUNCT1))(C(SPEC)(th)))(
                            PairList [
                              (hol:
                                 var a :: num
                                 var b :: num
                                 a + b),
                              (hol: var a :: num; a),
                              (hol: var b :: num; b)
                            ]
                          )
                      )
                    ) then_tac \
                    DISCH_THEN(
                      fun(th1):
                        DISCH_THEN(
                          (fun(th2): MP_TAC(MK_COMB([AP_TERM(hol: const #{+} :: num -> num -> num; const.#{+})(th2), th1])))
                        )
                    )
                  ) then_tac \
                  DISCH_THEN((fun(th): GEN_REWRITE_TAC(funpow(2)(LAND_CONV))(PairList [th])))
                ) then_tac \
                ONCE_REWRITE_TAC(
                  PairList [
                    AC(ADD_AC)(
                      (hol:
                         var a :: num
                         var b :: num
                         var c :: num
                         var d :: num
                         a + b + (c + d) == a + c + (b + d))
                    )
                  ]
                )
              ) then_tac \
              REWRITE_TAC(PairList [GSYM(RIGHT_ADD_DISTRIB)])
            ) then_tac \
            DISCH_THEN((fun(th): ((EQ_TAC then_tac DISCH_TAC) then_tac MP_TAC(th))))
          ) then_tac \
          ASM_REWRITE_TAC(PairList [EQ_ADD_RCANCEL, EQ_ADD_LCANCEL, EQ_MULT_RCANCEL])
        ) then_tac \
        REWRITE_TAC(PairList [EQ_SYM_EQ])
      )
    ]
  )

def MOD_ADD_EQ_EQ:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         forall (n :: num, x :: num, y :: num):
           MOD(x + y, n) == MOD(x, n) + MOD(y, n) <=> n == (0 :: num) || MOD(x, n) + MOD(y, n) < n),
      MESON_TAC(PairList [MOD_ZERO, MOD_EQ_SELF, MOD_ADD_MOD])
    ]
  )

def DIV_ADD_EQ_EQ:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         const MOD :: num -> num -> num
         forall (n :: num, x :: num, y :: num):
           DIV(x + y, n) == DIV(x, n) + DIV(y, n) <=> n == (0 :: num) || MOD(x, n) + MOD(y, n) < n),
      METIS_TAC(PairList [DIV_ZERO, ADD_CLAUSES, DIV_ADD_MOD, MOD_ADD_EQ_EQ])
    ]
  )

def DIV_ADD_EQ:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         const DIV :: num -> num -> num
         forall (n :: num, x :: num, y :: num):
           MOD(x, n) + MOD(y, n) < n ==> DIV(x + y, n) == DIV(x, n) + DIV(y, n)),
      SIMP_TAC(PairList [DIV_ADD_EQ_EQ])
    ]
  )

def MOD_ADD_EQ:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         forall (n :: num, x :: num, y :: num):
           MOD(x, n) + MOD(y, n) < n ==> MOD(x + y, n) == MOD(x, n) + MOD(y, n)),
      SIMP_TAC(PairList [MOD_ADD_EQ_EQ])
    ]
  )

def DIV_REFL:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall n :: num: n != (0 :: num) ==> DIV(n, n) == (1 :: num)),
      (
        (
          (
            (
              (
                (
                  (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(DIV_UNIQ)) then_tac \
                  EXISTS_TAC(hol:
                               (0 :: num))
                ) then_tac \
                REWRITE_TAC(PairList [ADD_CLAUSES, MULT_CLAUSES])
              ) then_tac \
              POP_ASSUM(MP_TAC)
            ) then_tac \
            SPEC_TAC([(hol: var n :: num; n), (hol: var n :: num; n)])
          ) then_tac \
          INDUCT_TAC
        ) then_tac \
        REWRITE_TAC(PairList [LT_0])
      )
    ]
  )

def MOD_LE:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         forall (m :: num, n :: num): MOD(m, n) <= m),
      (
        (
          (
            (
              (
                REPEAT(GEN_TAC) then_tac \
