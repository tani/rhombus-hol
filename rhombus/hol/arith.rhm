        let th = BITS_ELIM_CONV(mtm)
        Fusion.EQ_MP(Fusion.INST(PairList.cons([mtm, mvar_2], PairList.cons([Fusion.rand(Fusion.concl(th)), nvar_2], PairList [])))(BIT1_pth_2))(th)
    | Fusion.Comb(_,_): Equal.COMB_CONV(BITS_ELIM_CONV)(tm)
    | Fusion.Abs(_,_): Equal.ABS_CONV(BITS_ELIM_CONV)(tm)
  BITS_ELIM_CONV

def PRE_ELIM_THM_prime = arith_PRE_ELIM_THM_prime

def SUB_ELIM_THM_prime = arith_SUB_ELIM_THM_prime

def DIVMOD_ELIM_THM_prime = arith_DIVMOD_ELIM_THM_prime
