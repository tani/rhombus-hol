def DEPENDENT_CHOICE_FIXED:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Num, Fun(Tvar("A"), Bool)),
        Forall(
          "R",
          Fun(Num, Fun(Tvar("A"), Fun(Tvar("A"), Bool))),
          Forall(
            "a",
            Tvar("A"),
            Implies(
              And(
                App(Ref("P"), [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]), Ref("a")]),
                Forall(
                  "n",
                  Num,
                  Forall(
                    "x",
                    Tvar("A"),
                    Implies(
                      App(Ref("P"), [Ref("n"), Ref("x")]),
                      Exists(
                        "y",
                        Tvar("A"),
                        And(
                          App(Ref("P"), [App(Const("SUC", Fun(Num, Num)), [Ref("n")]), Ref("y")]),
                          App(Ref("R"), [Ref("n"), Ref("x"), Ref("y")])
                        )
                      )
                    )
                  )
                )
              ),
              Exists(
                "f",
                Fun(Num, Tvar("A")),
                And(
                  Eq(
                    Tvar("A"),
                    App(Ref("f"), [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]),
                    Ref("a")
                  ),
                  And(
                    Forall("n", Num, App(Ref("P"), [Ref("n"), App(Ref("f"), [Ref("n")])])),
                    Forall(
                      "n",
                      Num,
                      App(
                        Ref("R"),
                        [
                          Ref("n"),
                          App(Ref("f"), [Ref("n")]),
                          App(Ref("f"), [App(Const("SUC", Fun(Num, Num)), [Ref("n")])])
                        ]
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REPEAT(STRIP_TAC) then_tac \
                        o(MP_TAC)(prove_recursive_functions_exist(num_RECURSION))(
                          Host.hol_term(And(
                            Eq(
                              Tvar("A"),
                              App(Var("f", Fun(Num, Tvar("A"))), [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]),
                              Var("a", Tvar("A"))
                            ),
                            Forall(
                              "n",
                              Num,
                              Eq(
                                Tvar("A"),
                                App(Var("f", Fun(Num, Tvar("A"))), [App(Const("SUC", Fun(Num, Num)), [Ref("n")])]),
                                App(
                                  Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))),
                                  [
                                    Lambda(
                                      "y",
                                      Tvar("A"),
                                      And(
                                        App(
                                          Var("P", Fun(Num, Fun(Tvar("A"), Bool))),
                                          [App(Const("SUC", Fun(Num, Num)), [Ref("n")]), Ref("y")]
                                        ),
                                        App(
                                          Var("R", Fun(Num, Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                                          [Ref("n"), App(Var("f", Fun(Num, Tvar("A"))), [Ref("n")]), Ref("y")]
                                        )
                                      )
                                    )
                                  ]
                                )
                              )
                            )
                          ))
                        )
                      ) then_tac \
                      MATCH_MP_TAC(MONO_EXISTS)
                    ) then_tac \
                    GEN_TAC
                  ) then_tac \
                  STRIP_TAC
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              GEN_REWRITE_TAC(LAND_CONV)(
                PairList [
                  MESON(
                    PairList [num_CASES])(
                    Host.hol_term(Iff(
                      Forall("n", Num, App(Var("P", Fun(Num, Bool)), [Ref("n")])),
                      And(
                        App(Var("P", Fun(Num, Bool)), [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]),
                        Forall("n", Num, App(Var("P", Fun(Num, Bool)), [App(Const("SUC", Fun(Num, Num)), [Ref("n")])]))
                      )
                    ))
                  )
                ]
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [AND_FORALL_THM])
          ) then_tac \
          INDUCT_TAC
        ) then_tac \
        ASM_MESON_TAC(PairList [])
