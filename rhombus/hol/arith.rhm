      )
    ]
  )

def DIV_LE_EXCLUSION:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall (a :: num, b :: num, c :: num, d :: num):
           b != (0 :: num) && b * c < (a + (1 :: num)) * d ==> DIV(c, d) <= DIV(a, b)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(GEN_TAC) then_tac \
                          ASM_CASES_TAC(
                            (hol:
                               var d :: num
                               d == (0 :: num))
                          )
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [MULT_CLAUSES, LT])
                      ) then_tac \
                      STRIP_TAC
                    ) then_tac \
                    MATCH_MP_TAC(
                      MESON(
                        PairList [LE_REFL])(
                        (hol:
                           var a :: num
                           var b :: num
                           (forall k :: num: k <= a ==> k <= b) ==> a <= b)
                      )
                    )
                  ) then_tac \
                  X_GEN_TAC(hol: var k :: num; k)
                ) then_tac \
                SUBGOAL_THEN(
                  (hol:
                     var b :: num
                     var d :: num
                     var k :: num
                     var c :: num
                     var a :: num
                     b * (d * k) <= b * c ==> b * k * d < (a + (1 :: num)) * d)
                )(MP_TAC)
              ) then_list \
              PairList [ASM_MESON_TAC(PairList [LET_TRANS, MULT_AC]), ALL_TAC]
            ) then_tac \
            MATCH_MP_TAC(MONO_IMP)
          ) then_tac \
          ASM_SIMP_TAC(PairList [LE_MULT_LCANCEL, LT_MULT_RCANCEL, LE_RDIV_EQ])
        ) then_tac \
        REWRITE_TAC(PairList [GSYM(ADD1), LT_SUC_LE])
      )
    ]
  )

def DIV_EQ_EXCLUSION:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall (a :: num, b :: num, c :: num, d :: num):
           b * c < (a + (1 :: num)) * d && a * d < (c + (1 :: num)) * b ==> DIV(a, b) == DIV(c, d)),
      (
        (
          (
            (
              (
                REPEAT(GEN_TAC) then_tac \
                ASM_CASES_TAC(
                  (hol:
                     var b :: num
