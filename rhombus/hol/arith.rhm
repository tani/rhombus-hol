            FIRST_ASSUM((fun(th): GEN_REWRITE_TAC(RAND_CONV)(PairList [MATCH_MP(DIVISION)(th)])))
          ) then_tac \
          ONCE_REWRITE_TAC(PairList [ADD_SYM])
