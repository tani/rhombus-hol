def arith_ADD_0:«
  Up_tactics.prove((block:«
    let port_tmp_1 = (block:«
      let port_tmp_2 = Up_simp.ASM_REWRITE_TAC(PairList.cons(arith_ADD,PairList []));
      let port_tmp_3 = Up_nums.INDUCT_TAC;
      let port_tmp_4 = Up_tactics.THEN;
      port_tmp_4(port_tmp_3)(port_tmp_2)
    »);
    let port_tmp_5 = Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"+\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]],[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]]],[\"Comb\",[\"Const\",\"NUMERAL\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Const\",\"_0\",[\"Tyapp\",\"num\",[]]]]]],[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]]]]]");
    Pair(port_tmp_5,port_tmp_1)
  »))
»

