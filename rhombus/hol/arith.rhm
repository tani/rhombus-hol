def DIVMOD_UNIQ_LEMMA:
  prove(
    [
      (hol:
         forall (m :: num, n :: num, q1 :: num, r1 :: num, q2 :: num, r2 :: num):
           m == q1 * n + r1 && r1 < n && (m == q2 * n + r2 && r2 < n) ==> q1 == q2 && r1 == r2),
      (
        (
          (REPEAT(GEN_TAC) then_tac STRIP_TAC) then_tac \
          SUBGOAL_THEN(hol:
                         var r1 :: num
                         var r2 :: num
                         r1 == r2)(MP_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              UNDISCH_TAC(
                                (hol:
                                   var m :: num
                                   var q2 :: num
                                   var n :: num
                                   var r2 :: num
                                   m == q2 * n + r2)
                              ) then_tac \
                              ASM_REWRITE_TAC(PairList [])
                            ) then_tac \
                            DISJ_CASES_THEN(MP_TAC)(SPECL(PairList [(hol: var q1 :: num; q1), (hol: var q2 :: num; q2)])(LE_CASES))
                          ) then_tac \
                          DISCH_THEN(
                            o(X_CHOOSE_THEN(hol: var d :: num; d)(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))
                          )
                        ) then_tac \
                        REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, GSYM(ADD_ASSOC), EQ_ADD_LCANCEL])
                      ) then_list \
                      PairList [
                        (
                          DISCH_TAC then_tac \
                          UNDISCH_TAC(hol:
                                        var r1 :: num
                                        var n :: num
                                        r1 < n)
                        ),
                        (
                          DISCH_THEN(o(ASSUME_TAC)(SYM)) then_tac \
                          UNDISCH_TAC(hol:
                                        var r2 :: num
                                        var n :: num
                                        r2 < n)
                        )
                      ]
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_tac \
                  ONCE_REWRITE_TAC(PairList [MULT_SYM])
                ) then_tac \
                SPEC_TAC([(hol: var d :: num; d), (hol: var d :: num; d)])
              ) then_tac \
              INDUCT_TAC
            ) then_tac \
            REWRITE_TAC(PairList [ADD_CLAUSES, MULT_CLAUSES, GSYM(NOT_LE), LE_ADD, GSYM(ADD_ASSOC)])
          ),
          (
            (
              (
                (
                  (
                    (
                      (DISCH_THEN(SUBST_ALL_TAC) then_tac REWRITE_TAC(PairList [])) then_tac \
                      CONV_TAC(SYM_CONV)
                    ) then_tac \
                    UNDISCH_TAC(
                      (hol:
                         var m :: num
                         var q1 :: num
                         var n :: num
                         var r2 :: num
                         m == q1 * n + r2)
                    )
                  ) then_tac \
                  ASM_REWRITE_TAC(PairList [EQ_ADD_RCANCEL, EQ_MULT_RCANCEL])
                ) then_tac \
                REPEAT(
                  UNDISCH_TAC(hol:
                                var r2 :: num
                                var n :: num
                                r2 < n)
                )
              ) then_tac \
              ASM_CASES_TAC(
                (hol:
                   var n :: num
                   n == (0 :: num))
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [GSYM(NOT_LE), LE_0])
          )
        ]
      )
    ]
  )

