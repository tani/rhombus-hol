    [
      (hol:
         const DIV :: num -> num -> num
         const MOD :: num -> num -> num
         (forall (m :: num, n :: num): DIV(m, n) * n + MOD(m, n) == m)
           && (forall (m :: num, n :: num): n * DIV(m, n) + MOD(m, n) == m)),
      (
        (
          (
            REPEAT(STRIP_TAC) then_tac \
