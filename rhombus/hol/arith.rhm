              ASM_REWRITE_TAC(PairList [MULT_CLAUSES, LT])
            ) then_tac \
            ASM_CASES_TAC(
              (hol:
                 var d :: num
                 d == (0 :: num))
            )
          ) then_tac \
          ASM_REWRITE_TAC(PairList [MULT_CLAUSES, LT])
        ) then_tac \
        ASM_MESON_TAC(PairList [MULT_SYM, LE_ANTISYM, DIV_LE_EXCLUSION])
      )
    ]
  )

