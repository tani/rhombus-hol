                              (hol:
                                 var n :: num
                                 n == (0 :: num))
                            )
                          ) then_tac \
                          ASM_REWRITE_TAC(PairList [MOD_ZERO])
                        ) then_tac \
                        SPEC_TAC([(hol: var p :: num; p), (hol: var p :: num; p)])
                      ) then_tac \
                      INDUCT_TAC
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [EXP])
                  ) then_tac \
