def WLOG_LE:
  prove(
    [
      (hol:
         var P :: num -> num -> bool
         ((forall (m :: num, n :: num): P(m, n) <=> P(n, m))
            && (forall (m :: num, n :: num): m <= n ==> P(m, n)))
           ==> (forall (m :: num, n :: num): P(m, n))),
      MESON_TAC(PairList [LE_CASES])
    ]
  )

def WLOG_LT:
  prove(
    [
      (hol:
         var P :: num -> num -> bool
         ((forall m :: num: P(m, m))
            && ((forall (m :: num, n :: num): P(m, n) <=> P(n, m))
                  && (forall (m :: num, n :: num): m < n ==> P(m, n))))
           ==> (forall (m :: num, y :: num): P(m, y))),
      MESON_TAC(PairList [LT_CASES])
    ]
  )

def WLOG_LE_3:
  prove(
    [
      (hol:
         forall P :: num -> num -> num -> bool:
           ((forall (x :: num, y :: num, z :: num): P(x, y, z) ==> P(y, x, z) && P(x, z, y))
              && (forall (x :: num, y :: num, z :: num): x <= y && y <= z ==> P(x, y, z)))
             ==> (forall (x :: num, y :: num, z :: num): P(x, y, z))),
      MESON_TAC(PairList [LE_CASES])
    ]
  )

def num_WF:
  prove(
    [
      (hol:
         forall P :: num -> bool:
           (forall n :: num: (forall m :: num: m < n ==> P(m)) ==> P(n)) ==> (forall n :: num: P(n))),
      (
        (
          (
            GEN_TAC then_tac \
            MP_TAC(
              SPEC(
                (hol:
                   var P :: num -> bool
                   fun (n :: num): forall m :: num: m < n ==> P(m))
              )(num_INDUCTION)
            )
          ) then_tac \
          REWRITE_TAC(PairList [LT, BETA_THM])
        ) then_tac \
        MESON_TAC(PairList [LT])
      )
    ]
  )

def num_WOP:
  prove(
    [
      (hol:
         forall P :: num -> bool:
           (exists n :: num: P(n)) <=> (exists n :: num: P(n) && (forall m :: num: m < n ==> !P(m)))),
      (
        (
          (
            (
              (
                (
                  (GEN_TAC then_tac EQ_TAC) then_list \
                  PairList [ALL_TAC, MESON_TAC(PairList [])]
                ) then_tac \
                CONV_TAC(CONTRAPOS_CONV)
              ) then_tac \
              REWRITE_TAC(PairList [NOT_EXISTS_THM])
            ) then_tac \
            DISCH_TAC
          ) then_tac \
          MATCH_MP_TAC(num_WF)
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def num_MAX:
  prove(
    [
      (hol:
         forall P :: num -> bool:
           (exists x :: num: P(x)) && (exists M :: num: forall x :: num: P(x) ==> x <= M)
             <=> (exists m :: num: P(m) && (forall x :: num: P(x) ==> x <= m))),
      (
        (GEN_TAC then_tac EQ_TAC) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      DISCH_THEN(CONJUNCTS_THEN2(X_CHOOSE_TAC(hol: var a :: num; a))(MP_TAC)) then_tac \
                      DISCH_THEN(
                        o(X_CHOOSE_THEN(hol: var m :: num; m)(MP_TAC))(ONCE_REWRITE_RULE(PairList [num_WOP]))
                      )
                    ) then_tac \
                    DISCH_THEN((fun(th): (EXISTS_TAC(hol: var m :: num; m) then_tac MP_TAC(th))))
                  ) then_tac \
                  REWRITE_TAC(
                    PairList [
                      TAUT(
                        (hol:
                           var a :: bool
                           var b :: bool
                           var c :: bool
                           a && b ==> c && a <=> a && b ==> c)
                      )
                    ]
                  )
                ) then_tac \
                SPEC_TAC([(hol: var m :: num; m), (hol: var m :: num; m)])
              ) then_tac \
              INDUCT_TAC
            ) then_list \
            PairList [
              (
                (
                  REWRITE_TAC(PairList [LE, LT]) then_tac \
                  DISCH_THEN(IMP_RES_THEN(SUBST_ALL_TAC))
                ) then_tac \
                POP_ASSUM(ACCEPT_TAC)
              ),
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                DISCH_THEN(
                                  CONJUNCTS_THEN2(ASSUME_TAC)(o(MP_TAC)(SPEC(hol: var m :: num; m)))
                                ) then_tac \
                                REWRITE_TAC(PairList [LT])
                              ) then_tac \
                              CONV_TAC(CONTRAPOS_CONV)
                            ) then_tac \
                            DISCH_TAC
                          ) then_tac \
                          REWRITE_TAC(PairList [])
                        ) then_tac \
                        X_GEN_TAC(hol: var p :: num; p)
                      ) then_tac \
                      FIRST_ASSUM(o(MP_TAC)(SPEC(hol: var p :: num; p)))
                    ) then_tac \
                    REWRITE_TAC(PairList [LE])
                  ) then_tac \
                  ASM_CASES_TAC(hol:
                                  var p :: num
                                  var m :: num
                                  const SUC :: num -> num
                                  p == SUC(m))
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              )
            ]
          ),
          (
            (REPEAT(STRIP_TAC) then_tac EXISTS_TAC(hol: var m :: num; m)) then_tac \
            ASM_REWRITE_TAC(PairList [])
          )
        ]
      )
    ]
  )

def LE_INDUCT:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall P :: num -> num -> bool:
           ((forall m :: num: P(m, m))
              && (forall (m :: num, n :: num): m <= n && P(m, n) ==> P(m, SUC(n))))
             ==> (forall (m :: num, n :: num): m <= n ==> P(m, n))),
      (
        (
          (
            (
              (
                GEN_TAC then_tac \
                REWRITE_TAC(
                  PairList [
                    IMP_CONJ,
                    MESON(
                      PairList [LE_EXISTS])(
                      (hol:
                         var R :: num -> num -> bool
                         (forall (m :: num, n :: num): m <= n ==> R(m, n))
                           <=> (forall (m :: num, d :: num): R(m, m + d)))
                    )
                  ]
                )
              ) then_tac \
              REPEAT(DISCH_TAC)
            ) then_tac \
            GEN_TAC
          ) then_tac \
          INDUCT_TAC
        ) then_tac \
        ASM_SIMP_TAC(PairList [ADD_CLAUSES])
      )
    ]
  )

def num_INDUCTION_DOWN:
  prove(
    [
      (hol:
         forall (P :: num -> bool, m :: num):
           ((forall n :: num: m <= n ==> P(n))
              && (forall n :: num: n < m && P(n + (1 :: num)) ==> P(n)))
             ==> (forall n :: num: P(n))),
      (
        (
          (
            (
              (
                (
                  (
                    (REWRITE_TAC(PairList [GSYM(ADD1)]) then_tac REPEAT(GEN_TAC)) then_tac \
                    STRIP_TAC
                  ) then_tac \
                  ONCE_REWRITE_TAC(
                    PairList [
                      MESON(
                        PairList [])(
                        (hol:
                           var P :: #{?9244} -> bool
                           (forall x :: #{?9244}: P(x)) <=> !(exists x :: #{?9244}: !P(x)))
                      )
                    ]
                  )
                ) then_tac \
                W(
                  o(o(o(MP_TAC)(PART_MATCH(o(lhand)(lhand))(num_MAX)))(rand))(snd)
                )
              ) then_tac \
              MATCH_MP_TAC(
                TAUT(
                  (hol:
                     var q :: bool
                     var r :: bool
                     var p :: bool
                     q && !r ==> (p && q <=> r) ==> !p)
                )
              )
            ) then_tac \
            ONCE_REWRITE_TAC(
              PairList [
                TAUT(
                  (hol:
                     var p :: bool
                     var q :: bool
                     !p ==> q <=> !q ==> p)
                )
              ]
            )
          ) then_tac \
          REWRITE_TAC(
            PairList [
              NOT_EXISTS_THM,
              TAUT(
                (hol:
                   var p :: bool
                   var q :: bool
                   !(!p && q) <=> q ==> p)
              ),
              NOT_LE
            ]
          )
        ) then_tac \
        ASM_MESON_TAC(PairList [LTE_CASES, LT, LT_IMP_LE])
      )
    ]
  )

def EVEN:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var EVEN :: num -> bool
       const SUC :: num -> num
       (EVEN((0 :: num)) <=> #true) && (forall n :: num: EVEN(SUC(n)) <=> !EVEN(n)))
  )

def ODD:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var ODD :: num -> bool
       const SUC :: num -> num
       (ODD((0 :: num)) <=> #false) && (forall n :: num: ODD(SUC(n)) <=> !ODD(n)))
  )

def NOT_EVEN:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         const ODD :: num -> bool
         forall n :: num: !EVEN(n) <=> ODD(n)),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EVEN, ODD]))
    ]
  )

def NOT_ODD:
  prove(
    [
      (hol:
         const ODD :: num -> bool
         const EVEN :: num -> bool
         forall n :: num: !ODD(n) <=> EVEN(n)),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EVEN, ODD]))
    ]
  )

def EVEN_OR_ODD:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         const ODD :: num -> bool
         forall n :: num: EVEN(n) || ODD(n)),
      (
        (
          (INDUCT_TAC then_tac REWRITE_TAC(PairList [EVEN, ODD, NOT_EVEN, NOT_ODD])) then_tac \
          ONCE_REWRITE_TAC(PairList [DISJ_SYM])
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def EVEN_AND_ODD:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         const ODD :: num -> bool
         forall n :: num: !(EVEN(n) && ODD(n))),
      REWRITE_TAC(
        PairList [
          GSYM(NOT_EVEN),
          ITAUT(hol:
                  var p :: bool
                  !(p && !p))
        ]
      )
    ]
  )

def EVEN_ADD:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         forall (m :: num, n :: num): EVEN(m + n) <=> (EVEN(m) <=> EVEN(n))),
      (
        (
          (
            (
              (
                (
                  (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EVEN, ADD_CLAUSES])) then_tac \
                  X_GEN_TAC(hol: var p :: num; p)
                ) then_tac \
                DISJ_CASES_THEN(MP_TAC)(SPEC(hol: var n :: num; n)(EVEN_OR_ODD))
              ) then_tac \
              DISJ_CASES_THEN(MP_TAC)(SPEC(hol: var p :: num; p)(EVEN_OR_ODD))
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(NOT_EVEN)])
          ) then_tac \
          DISCH_TAC
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def EVEN_MULT:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         forall (m :: num, n :: num): EVEN(m * n) <=> EVEN(m) || EVEN(n)),
      (
        (
          (
            (
              (
                (
                  (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MULT_CLAUSES, EVEN_ADD, EVEN])) then_tac \
                  X_GEN_TAC(hol: var p :: num; p)
                ) then_tac \
                DISJ_CASES_THEN(MP_TAC)(SPEC(hol: var n :: num; n)(EVEN_OR_ODD))
              ) then_tac \
              DISJ_CASES_THEN(MP_TAC)(SPEC(hol: var p :: num; p)(EVEN_OR_ODD))
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(NOT_EVEN)])
          ) then_tac \
          DISCH_TAC
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def EVEN_EXP:
  prove(
    [
      (hol:
         const EVEN :: num -> bool
         const EXP :: num -> num -> num
         forall (m :: num, n :: num): EVEN(EXP(m, n)) <=> EVEN(m) && n != (0 :: num)),
