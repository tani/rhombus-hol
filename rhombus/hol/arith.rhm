          DISCH_THEN((fun(th): GEN_REWRITE_TAC(RAND_CONV)(PairList [CONJUNCT1(th)])))
        ) then_tac \
        REWRITE_TAC(PairList [LE_ADD, MULT_AC])
      )
    ]
  )

def MOD_LE_TWICE:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         forall (m :: num, n :: num): (0 :: num) < m && m <= n ==> (2 :: num) * MOD(n, m) <= n),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              REPEAT(STRIP_TAC) then_tac \
                              ASM_CASES_TAC(
                                (hol:
                                   var m :: num
                                   var n :: num
                                   (2 :: num) * m <= n)
                              )
                            ) then_list \
                            PairList [
                              (
                                TRANS_TAC(LE_TRANS)(
                                  (hol:
                                     var m :: num
                                     (2 :: num) * m)
                                ) then_tac \
                                ASM_SIMP_TAC(PairList [LE_MULT_LCANCEL, DIVISION, LT_IMP_LE, LE_1])
                              ),
                              RULE_ASSUM_TAC(REWRITE_RULE(PairList [NOT_LE]))
                            ]
                          ) then_tac \
                          TRANS_TAC(LE_TRANS)(
                            (hol:
                               var m :: num
                               var n :: num
                               const MOD :: num -> num -> num
                               m + MOD(n, m))
                          )
                        ) then_tac \
                        ASM_SIMP_TAC(PairList [MULT_2, LE_ADD_RCANCEL, DIVISION, LT_IMP_LE, LE_1])
                      ) then_tac \
                      ONCE_REWRITE_TAC(PairList [ADD_SYM])
                    ) then_tac \
                    SUBGOAL_THEN(
                      (hol:
                         var n :: num
                         var m :: num
                         const MOD :: num -> num -> num
                         MOD(n, m) == n - m)
                    )((fun(th): ASM_SIMP_TAC(PairList [LE_REFL, SUB_ADD, th])))
                  ) then_tac \
                  MATCH_MP_TAC(MOD_UNIQ)
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     (1 :: num))
                )
              ) then_tac \
              ONCE_REWRITE_TAC(PairList [ADD_SYM])
            ) then_tac \
            ASM_SIMP_TAC(PairList [MULT_CLAUSES, SUB_ADD])
          ) then_tac \
          ONCE_REWRITE_TAC(
            PairList [
              MESON(
                PairList [LT_ADD_RCANCEL])(
                (hol:
                   var n :: num
                   var m :: num
                   n - m < m <=> n - m + m < m + m)
              )
            ]
          )
        ) then_tac \
        ASM_SIMP_TAC(PairList [GSYM(MULT_2), SUB_ADD])
      )
    ]
  )

def [arith_DIV_1_v2, MOD_1]:
  o(CONJ_PAIR)(prove)(
    [
      (hol:
         const DIV :: num -> num -> num
         const MOD :: num -> num -> num
         (forall n :: num: DIV(n, (1 :: num)) == n)
           && (forall n :: num: MOD(n, (1 :: num)) == (0 :: num))),
      (
        (
          (
            (SIMP_TAC(PairList [AND_FORALL_THM]) then_tac GEN_TAC) then_tac \
            MATCH_MP_TAC(DIVMOD_UNIQ)
          ) then_tac \
          REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES])
        ) then_tac \
        REWRITE_TAC(PairList [ONE, LT])
      )
    ]
  )

def DIV_LT:
  prove(
    [
      (hol:
         const DIV :: num -> num -> num
         forall (m :: num, n :: num): m < n ==> DIV(m, n) == (0 :: num)),
      (
        (
          (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(DIV_UNIQ)) then_tac \
          EXISTS_TAC(hol: var m :: num; m)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES])
      )
    ]
  )

def MOD_MOD:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         forall (m :: num, n :: num, p :: num): MOD(MOD(m, n * p), n) == MOD(m, n)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(GEN_TAC) then_tac \
                          ASM_CASES_TAC(
                            (hol:
                               var p :: num
                               p == (0 :: num))
                          )
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [MOD_ZERO, MULT_CLAUSES])
                      ) then_tac \
                      ASM_CASES_TAC(
                        (hol:
                           var n :: num
                           n == (0 :: num))
                      )
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [MOD_ZERO, MULT_CLAUSES])
                  ) then_tac \
                  CONV_TAC(SYM_CONV)
                ) then_tac \
                MATCH_MP_TAC(MOD_EQ)
              ) then_tac \
              EXISTS_TAC(
                (hol:
                   var m :: num
                   var n :: num
                   var p :: num
                   const DIV :: num -> num -> num
                   DIV(m, n * p) * p)
              )
            ) then_tac \
            MP_TAC(
              SPECL(
                PairList [
                  (hol: var m :: num; m),
                  (hol:
                     var n :: num
                     var p :: num
                     n * p)
                ])(
                DIVISION
              )
            )
          ) then_tac \
          ASM_REWRITE_TAC(PairList [MULT_EQ_0, MULT_AC, ADD_AC])
        ) then_tac \
        DISCH_THEN((fun(th): REWRITE_TAC(PairList [GSYM(th)])))
      )
    ]
  )

def MOD_MOD_REFL:
  prove(
    [
      (hol:
         const MOD :: num -> num -> num
         forall (m :: num, n :: num): MOD(MOD(m, n), n) == MOD(m, n)),
      (
        (
          (
            (
              (
                REPEAT(GEN_TAC) then_tac \
                ASM_CASES_TAC(
                  (hol:
                     var n :: num
                     n == (0 :: num))
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [MOD_ZERO])
            ) then_tac \
            MP_TAC(
              SPECL(
                PairList [
                  (hol: var m :: num; m),
                  (hol: var n :: num; n),
                  (hol:
                     (1 :: num))
                ])(
                MOD_MOD
              )
            )
          ) then_tac \
          ASM_REWRITE_TAC(PairList [MULT_CLAUSES, MULT_EQ_0])
        ) then_tac \
        REWRITE_TAC(PairList [ONE, NOT_SUC])
      )
    ]
  )

def MOD_MOD_LE:
  prove(
    [
