def MOD_DOWN_CONV:
  let MOD_SUC_MOD:
    METIS(
      PairList [ADD1, MOD_ADD_MOD, MOD_MOD_REFL])(
      Host.hol_term(Eq(
        Num,
        App(
          Const("MOD", Fun(Num, Fun(Num, Num))),
          [
            App(
              Const("SUC", Fun(Num, Num)),
              [App(Const("MOD", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)])]
            ),
            Var("n", Num)
          ]
        ),
        App(
          Const("MOD", Fun(Num, Fun(Num, Num))),
          [App(Const("SUC", Fun(Num, Num)), [Var("m", Num)]), Var("n", Num)]
        )
      ))
    )
  let addmul_conv_2:
    GEN_REWRITE_CONV(I)(
      PairList [
        GSYM(MOD_SUC_MOD),
        GSYM(MOD_ADD_MOD),
        GSYM(MOD_MULT_MOD2),
        GSYM(MOD_EXP_MOD)
      ]
    )
  let mod_conv_2 = GEN_REWRITE_CONV(I)(PairList [MOD_MOD_REFL])
  fun downconv_2(tm):
    (
      ((addmul_conv_2 then_conv LAND_CONV(downconv_2)) or_conv (mod_conv_2 then_conv downconv_2)) or_conv \
      SUB_CONV(downconv_2)
    )(tm)
  let upconv_2:
    GEN_REWRITE_CONV(
      DEPTH_CONV)(
      PairList [MOD_SUC_MOD, MOD_ADD_MOD, MOD_MULT_MOD2, MOD_EXP_MOD, MOD_MOD_REFL]
    )
  (downconv_2 then_conv upconv_2)

def NUM_CANCEL_CONV:
  // Recursive cancellation needs the local definition before its first use.
  fun minter(i):
    fun(l1_prime):
      fun(l2_prime):
        fun(l1):
          fun(l2):
            if (l1 == (PairList []))
            | [i, l1_prime, append(l2_prime)(l2)]
            | if (l2 == (PairList []))
              | [i, append(l1)(l1_prime), l2_prime]
              | let h1_2 = hd(l1)
                let h2_2 = hd(l2)
                if (h1_2 == h2_2)
                | minter(PairList [h1_2, & i])(l1_prime)(l2_prime)(tl(l1))(tl(l2))
                | (if Host.hol_lt(h1_2)(h2_2) | minter(i)(PairList [h1_2, & l1_prime])(l2_prime)(tl(l1))(l2) | minter(i)(l1_prime)(PairList [h2_2, & l2_prime])(l1)(tl(l2)))
  let add_tm_2 = Host.hol_term(Const("+", Fun(Num, Fun(Num, Num))))
  let eq_tm_2 = Host.hol_term(Const("=", Fun(Num, Fun(Num, Bool))))
  let EQ_ADD_LCANCEL_0_prime = GEN_REWRITE_RULE(o(Host.funpow(2)(BINDER_CONV))(LAND_CONV))(PairList [EQ_SYM_EQ])(EQ_ADD_LCANCEL_0)
  let AC_RULE = AC(ADD_AC)
  fun(tm):
    let [l, r] = dest_eq(tm)
    let lats_2 = sort(Host.hol_le)(binops(Host.hol_term(Const("+", Fun(Num, Fun(Num, Num)))))(l))
    let rats_2 = sort(Host.hol_le)(binops(Host.hol_term(Const("+", Fun(Num, Fun(Num, Num)))))(r))
    let [i, lats_prime, rats_prime] = minter(PairList [])(PairList [])(PairList [])(lats_2)(rats_2)
    let l_prime_2 = list_mk_binop(add_tm_2)(append(i)(lats_prime))
    let r_prime_2 = list_mk_binop(add_tm_2)(append(i)(rats_prime))
    let lth_2 = AC_RULE(mk_eq([l, l_prime_2]))
    let rth_2 = AC_RULE(mk_eq([r, r_prime_2]))
    let eth = MK_COMB([AP_TERM(eq_tm_2)(lth_2), rth_2])
    GEN_REWRITE_RULE(
      o(RAND_CONV)(REPEATC))(
      PairList [EQ_ADD_LCANCEL, EQ_ADD_LCANCEL_0, EQ_ADD_LCANCEL_0_prime]
    )(eth)

def LE_IMP:
  let pth = PURE_ONCE_REWRITE_RULE(PairList [IMP_CONJ])(LE_TRANS)
  (fun(th): GEN_ALL(MATCH_MP(pth)(SPEC_ALL(th))))

