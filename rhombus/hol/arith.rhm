def ADD_AC:
  prove(
    [
      Host.hol_term(And(
        Eq(
          Num,
          App(Const("+", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)]),
          App(Const("+", Fun(Num, Fun(Num, Num))), [Var("n", Num), Var("m", Num)])
        ),
        And(
          Eq(
            Num,
            App(
              Const("+", Fun(Num, Fun(Num, Num))),
              [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)]), Var("p", Num)]
            ),
            App(
              Const("+", Fun(Num, Fun(Num, Num))),
              [Var("m", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("n", Num), Var("p", Num)])]
            )
