import:
  "lib.rhm" open
  "private/ocaml.rhm" open
import: "fusion.rhm" open
import:
  lib("racket/base.rkt") open:
    only:
      quotient
      modulo
export:
  genvar
  dest_fun_ty
  occurs_in
  tysubst
  bndvar
  body
  list_mk_comb
  list_mk_abs
  strip_comb
  strip_abs
  is_binary
  dest_binary
  mk_binary
  variants
  variables
  subst
  alpha
  type_match
  mk_mconst
  mk_icomb
  list_mk_icomb
  thm_frees
  free_in
  find_term
  find_terms
  is_binder
  dest_binder
  mk_binder
  is_binop
  dest_binop
  mk_binop
  list_mk_binop
  binops
  is_conj
  dest_conj
  conjuncts
  is_imp
  dest_imp
  is_forall
  dest_forall
  strip_forall
  is_exists
  dest_exists
  strip_exists
  is_disj
  dest_disj
  disjuncts
  is_neg
  dest_neg
  is_uexists
  dest_uexists
