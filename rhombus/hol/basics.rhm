def mutable gcounter = 0
fun genvar(ty):
  def count = gcounter
  gcounter := count+1
  mk_var(Pair("_" +& to_string(count),ty))
fun dest_fun_ty(ty):
  match ty
  | Tyapp("fun",PairList [t1,t2]): Pair(t1,t2)
  | _: failwith("dest_fun_ty")
fun occurs_in(ty):
  fun(bigty): bigty == ty || (is_type(bigty) && exists(occurs_in(ty))(snd(dest_type(bigty))))
fun tysubst(alist):
  fun(ty):
    try:
      rev_assoc(ty)(alist)
      ~catch Failure(_):
        if is_vartype(ty)
        | ty
        | block:
            def Pair(con,vars) = dest_type(ty)
            mk_type(Pair(con,map(tysubst(alist))(vars)))
fun bndvar(tm):
  try:
    fst(dest_abs(tm))
    ~catch Failure(_): failwith("bndvar: Not an abstraction")
fun body(tm):
  try:
    snd(dest_abs(tm))
    ~catch Failure(_): failwith("body: Not an abstraction")
fun list_mk_comb(Pair(h,t)): rev_itlist(C(curry(mk_comb)))(t)(h)
fun list_mk_abs(Pair(vs,bod)): itlist(curry(mk_abs))(vs)(bod)
def strip_comb = rev_splitlist(dest_comb)
def strip_abs = splitlist(dest_abs)
fun is_binary(s):
  fun(tm):
    match tm
    | Comb(Comb(Const(s1,_),_),_): s1 == s
    | _: #false
fun dest_binary(s):
  fun(tm):
    match tm
    | Comb(Comb(Const(s1,_),l),r): (if s1 == s | Pair(l,r) | failwith("dest_binary"))
    | _: failwith("dest_binary")
fun mk_binary(s):
  def c = mk_const(Pair(s,PairList []))
  fun(Pair(l,r)):
    try:
      mk_comb(Pair(mk_comb(Pair(c,l)),r))
      ~catch Failure(_): failwith("mk_binary")
fun variants(av):
  fun(vs):
    if vs == PairList []
    | PairList []
    | block:
        def vh = variant(av)(hd(vs))
        PairList.cons(vh,variants(PairList.cons(vh,av))(tl(vs)))
fun variables(tm):
  fun vars(acc,tm):
    cond
    | is_var(tm): insert(tm)(acc)
    | is_const(tm): acc
    | is_abs(tm):
        def Pair(v,bod) = dest_abs(tm)
        vars(insert(v)(acc),bod)
    | ~else:
        def Pair(l,r) = dest_comb(tm)
        vars(vars(acc,l),r)
  vars(PairList [],tm)
fun subst(ilist):
  fun ssubst(ilist,tm):
    if ilist == PairList []
    | tm
    | try:
        fst(find(o(aconv(tm))(snd))(ilist))
        ~catch Failure(_):
          match tm
          | Comb(f,x):
              def f1 = ssubst(ilist,f)
              def x1 = ssubst(ilist,x)
              if f1 === f && x1 === x | tm | mk_comb(Pair(f1,x1))
          | Abs(v,bod):
              def ilist1 = filter(fun(p): !vfree_in(v)(snd(p)))(ilist)
              mk_abs(Pair(v,ssubst(ilist1,bod)))
          | _: tm
  def theta = filter(fun(Pair(s,t)): compare(s)(t) != 0)(ilist)
  if theta == PairList []
  | I
  | block:
      def Pair(ts,xs) = unzip(theta)
      fun(tm):
        def gs = variants(variables(tm))(map(o(genvar)(type_of))(xs))
        def tm1 = ssubst(zip(gs)(xs),tm)
        if tm1 === tm | tm | vsubst(zip(ts)(gs))(tm1)
fun alpha(v):
  fun(tm):
    def Pair(v0,bod):
      try:
        dest_abs(tm)
        ~catch Failure(_): failwith("alpha: Not an abstraction")
    cond
    | v == v0: tm
    | type_of(v) == type_of(v0) && !vfree_in(v)(bod): mk_abs(Pair(v,vsubst(PairList [Pair(v,v0)])(bod)))
    | ~else: failwith("alpha: Invalid new variable")
fun type_match(vty):
  fun(cty):
    fun(sofar):
      if is_vartype(vty)
      | try:
          if rev_assoc(vty)(sofar) == cty | sofar | failwith("type_match")
          ~catch Failure("find"): PairList.cons(Pair(cty,vty),sofar)
      | block:
          def Pair(vop,vargs) = dest_type(vty)
          def Pair(cop,cargs) = dest_type(cty)
          if vop == cop | itlist2(type_match)(vargs)(cargs)(sofar) | failwith("type_match")
fun mk_mconst(Pair(c,ty)):
  try:
    def uty = get_const_type(c)
    def mat = type_match(uty)(ty)(PairList [])
    def con = mk_const(Pair(c,mat))
    if type_of(con) == ty | con | fail()
    ~catch Failure(_): failwith("mk_const: generic type cannot be instantiated")
fun mk_icomb(Pair(t1,t2)):
  def Pair("fun",PairList [ty,_]) = dest_type(type_of(t1))
  def ti = type_match(ty)(type_of(t2))(PairList [])
  mk_comb(Pair(inst(ti)(t1),t2))
fun list_mk_icomb(cname):
  fun(args):
    def Pair(atys,_) = nsplit(dest_fun_ty)(args)(get_const_type(cname))
    def ti = itlist2(fun(g): fun(a): type_match(g)(type_of(a)))(atys)(args)(PairList [])
    list_mk_comb(Pair(mk_const(Pair(cname,ti)),args))
fun thm_frees(th):
  def Pair(asl,c) = dest_thm(th)
  itlist(o(union)(frees))(asl)(frees(c))
fun free_in(t1):
  fun(t2):
    cond
    | aconv(t1)(t2): #true
    | is_comb(t2):
        def Pair(l,r) = dest_comb(t2)
        free_in(t1)(l) || free_in(t1)(r)
    | is_abs(t2):
        def Pair(v,bod) = dest_abs(t2)
        !vfree_in(v)(t1) && free_in(t1)(bod)
    | ~else: #false
fun find_term(p):
  fun(tm):
    cond
    | p(tm): tm
    | is_abs(tm): find_term(p)(body(tm))
    | is_comb(tm):
        def Pair(l,r) = dest_comb(tm)
        try:
          find_term(p)(l)
          ~catch Failure(_): find_term(p)(r)
    | ~else: failwith("find_term")
fun find_terms(p):
  fun accum(tl,p,tm):
    def tl1 = if p(tm) | insert(tm)(tl) | tl
    cond
    | is_abs(tm): accum(tl1,p,body(tm))
    | is_comb(tm): accum(accum(tl1,p,rator(tm)),p,rand(tm))
    | ~else: tl1
  fun(tm): accum(PairList [],p,tm)
fun is_binder(s):
  fun(tm):
    match tm
    | Comb(Const(s1,_),Abs(_,_)): s1 == s
    | _: #false
fun dest_binder(s):
  fun(tm):
    match tm
    | Comb(Const(s1,_),Abs(x,t)): (if s1 == s | Pair(x,t) | failwith("dest_binder"))
    | _: failwith("dest_binder")
fun mk_binder(op):
  def c = mk_const(Pair(op,PairList []))
  fun(Pair(v,tm)): mk_comb(Pair(inst(PairList [Pair(type_of(v),aty)])(c),mk_abs(Pair(v,tm))))
fun is_binop(op):
  fun(tm):
    match tm
    | Comb(Comb(op1,_),_): op1 == op
    | _: #false
fun dest_binop(op):
  fun(tm):
    match tm
    | Comb(Comb(op1,l),r): (if op1 == op | Pair(l,r) | failwith("dest_binop"))
    | _: failwith("dest_binop")
fun mk_binop(op):
  fun(tm1):
    def f = mk_comb(Pair(op,tm1))
    fun(tm2): mk_comb(Pair(f,tm2))
fun list_mk_binop(op): end_itlist(mk_binop(op))
fun binops(op): striplist(dest_binop(op))
def is_conj = is_binary("/\\")
def dest_conj = dest_binary("/\\")
def conjuncts = striplist(dest_conj)
def is_imp = is_binary("==>")
def dest_imp = dest_binary("==>")
def is_forall = is_binder("!")
def dest_forall = dest_binder("!")
def strip_forall = splitlist(dest_forall)
def is_exists = is_binder("?")
def dest_exists = dest_binder("?")
def strip_exists = splitlist(dest_exists)
def is_disj = is_binary("\\/")
def dest_disj = dest_binary("\\/")
def disjuncts = striplist(dest_disj)
fun is_neg(tm):
  try:
    fst(dest_const(rator(tm))) == "~"
    ~catch Failure(_): #false
fun dest_neg(tm):
  try:
    def Pair(n,p) = dest_comb(tm)
    if fst(dest_const(n)) == "~" | p | fail()
    ~catch Failure(_): failwith("dest_neg")
def is_uexists = is_binder("?!")
def dest_uexists = dest_binder("?!")
def dest_cons = dest_binary("CONS")
def is_cons = is_binary("CONS")
fun dest_list(tm):
  try:
    def Pair(tms,nil) = splitlist(dest_cons)(tm)
    if fst(dest_const(nil)) == "NIL" | tms | fail()
    ~catch Failure(_): failwith("dest_list")
def is_list = can(dest_list)
fun dest_numeral(tm):
  fun dest_num(tm):
    def zero:
      try:
        fst(dest_const(tm)) == "_0"
        ~catch Failure(_): #false
    if zero
    | 0
    | block:
        def Pair(l,r) = dest_comb(tm)
        def n = 2*dest_num(r)
        def cn = fst(dest_const(l))
        cond
        | cn == "BIT0": n
        | cn == "BIT1": n+1
        | ~else: fail()
  try:
    def Pair(l,r) = dest_comb(tm)
    if fst(dest_const(l)) == "NUMERAL" | dest_num(r) | fail()
    ~catch Failure(_): failwith("dest_numeral")
fun dest_gabs(tm):
  def dest_geq = dest_binary("GEQ")
  try:
    if is_abs(tm)
    | dest_abs(tm)
    | block:
        def Pair(l,r) = dest_comb(tm)
        if fst(dest_const(l)) != "GABS"
        | fail()
        | block:
            def Pair(ltm,rtm) = dest_geq(snd(strip_forall(body(r))))
            Pair(rand(ltm),rtm)
    ~catch Failure(_): failwith("dest_gabs: Not a generalized abstraction")
def is_gabs = can(dest_gabs)
fun mk_gabs(Pair(t1,t2)):
  fun mk_forall(Pair(v,t)):
    def c = mk_const(Pair("!",PairList [Pair(type_of(v),aty)]))
    mk_comb(Pair(c,mk_abs(Pair(v,t))))
  fun mk_geq(Pair(x,y)):
    def p = mk_const(Pair("GEQ",PairList [Pair(type_of(x),aty)]))
    mk_comb(Pair(mk_comb(Pair(p,x)),y))
  if is_var(t1)
  | mk_abs(Pair(t1,t2))
  | block:
      def fvs = frees(t1)
      def fty = mk_fun_ty(type_of(t1))(type_of(t2))
      def f = variant(append(frees(t1))(frees(t2)))(mk_var(Pair("f",fty)))
      def bod = mk_abs(Pair(f,itlist(curry(mk_forall))(fvs)(mk_geq(Pair(mk_comb(Pair(f,t1)),t2)))))
      mk_comb(Pair(mk_const(Pair("GABS",PairList [Pair(fty,aty)])),bod))
fun list_mk_gabs(Pair(vs,bod)): itlist(curry(mk_gabs))(vs)(bod)
def strip_gabs = splitlist(dest_gabs)
fun dest_let(tm):
  try:
    def Pair(l,aargs) = strip_comb(tm)
    if fst(dest_const(l)) != "LET"
    | fail()
    | block:
        def Pair(vars,lebod) = strip_gabs(hd(aargs))
        def eqs = zip(vars)(tl(aargs))
        def Pair(le,bod) = dest_comb(lebod)
        if fst(dest_const(le)) == "LET_END" | Pair(eqs,bod) | fail()
    ~catch Failure(_): failwith("dest_let: not a let-term")
def is_let = can(dest_let)
fun mk_let(Pair(assigs,bod)):
  def Pair(lefts,rights) = unzip(assigs)
  def lend = mk_comb(Pair(mk_const(Pair("LET_END",PairList [Pair(type_of(bod),aty)])),bod))
  def lbod = list_mk_gabs(Pair(lefts,lend))
  def Pair(t1,t2) = dest_fun_ty(type_of(lbod))
  def ltm = mk_const(Pair("LET",PairList [Pair(t1,aty),Pair(t2,bty)]))
  list_mk_comb(Pair(ltm,PairList.cons(lbod,rights)))
fun mk_finty(n):
  fun finty(n):
    if n == 1
    | mk_type(Pair("1",PairList []))
    | mk_type(Pair((if modulo(n,2) == 0 | "tybit0" | "tybit1"),PairList [finty(quotient(n,2))]))
  if !(n is_a Int) || n < 1 | failwith("mk_finty") | finty(n)
fun dest_finty(ty):
  match ty
  | Tyapp("1",_): 1
  | Tyapp("tybit0",PairList [ty]): dest_finty(ty)*2
  | Tyapp("tybit1",PairList [ty]): dest_finty(ty)*2+1
  | _: failwith("dest_finty")
fun make_args(s):
  fun(avoid):
    fun(tys):
      fun margs(n,s,avoid,tys):
        if tys == PairList []
        | PairList []
        | block:
            def v = variant(avoid)(mk_var(Pair(s +& to_string(n),hd(tys))))
            PairList.cons(v,margs(n+1,s,PairList.cons(v,avoid),tl(tys)))
      if length(tys) == 1 | PairList [variant(avoid)(mk_var(Pair(s,hd(tys))))] | margs(0,s,avoid,tys)
fun find_path(p):
  fun(tm):
    fun fp(p,tm):
      cond
      | p(tm): PairList []
      | is_abs(tm): PairList.cons("b",fp(p,body(tm)))
      | ~else:
          try:
            PairList.cons("r",fp(p,rand(tm)))
            ~catch Failure(_): PairList.cons("l",fp(p,rator(tm)))
    implode(fp(p,tm))
fun follow_path(s):
  fun(tm):
    fun fp(s,tm):
      match s
      | PairList []: tm
      | PairList ["l", & t]: fp(t,rator(tm))
      | PairList ["r", & t]: fp(t,rand(tm))
      | PairList [_, & t]: fp(t,body(tm))
    fp(explode(s),tm)
// atoms is supplied below, after the Patricia-map and OCaml hashing compatibility layer.

fun atoms(tm):
  fun accum(acc,tm):
    match tm
    | Comb(Comb(Const("/\\",_),l),r): accum(accum(acc,l),r)
    | Comb(Comb(Const("\\/",_),l),r): accum(accum(acc,l),r)
    | Comb(Comb(Const("==>",_),l),r): accum(accum(acc,l),r)
    | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",PairList []),_])),l),r): accum(accum(acc,l),r)
    | Comb(Const("~",_),l): accum(acc,l)
    | _: fpf_define(tm)(#void)(acc)
  if type_of(tm) != bool_ty
  | failwith("atoms: not Boolean")
  | foldl(fun(a): fun(x): fun(y): PairList.cons(x,a))(PairList [])(accum(undefined,tm))