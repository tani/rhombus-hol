import: "private/compat.rhm" open
import: "fusion.rhm" open
import: "private/atoms_map.rhm" open
import:
  lib("racket/base.rkt") open:
    only:
      quotient
      modulo
export:
  genvar
  dest_fun_ty
  occurs_in
  tysubst
  bndvar
  body
  list_mk_comb
  list_mk_abs
  strip_comb
  strip_abs
  is_binary
  dest_binary
  mk_binary
  variants
  variables
  subst
  alpha
  type_match
  mk_mconst
  mk_icomb
  list_mk_icomb
