def mutable gcounter = 0
fun genvar(ty):
  let count = gcounter
  gcounter := count+1
  mk_var(["_" +& to_string(count), ty])
fun dest_fun_ty(ty):
  match ty
  | Tyapp("fun",PairList [t1,t2]): [t1, t2]
  | _: failwith("dest_fun_ty")
fun occurs_in(ty):
  fun(bigty): bigty == ty || (is_type(bigty) && exists(occurs_in(ty))(snd(dest_type(bigty))))
fun tysubst(alist):
  fun(ty):
    try:
      rev_assoc(ty)(alist)
      ~catch Failure(_):
        if is_vartype(ty)
        | ty
        | let [con, vars] = dest_type(ty)
          mk_type([con, map(tysubst(alist))(vars)])
fun bndvar(tm):
  try:
    fst(dest_abs(tm))
    ~catch Failure(_): failwith("bndvar: Not an abstraction")
fun body(tm):
  try:
    snd(dest_abs(tm))
    ~catch Failure(_): failwith("body: Not an abstraction")
fun list_mk_comb([h, t]): rev_itlist(C(curry(mk_comb)))(t)(h)
fun list_mk_abs([vs, bod]): itlist(curry(mk_abs))(vs)(bod)
def strip_comb = rev_splitlist(dest_comb)
def strip_abs = splitlist(dest_abs)
fun is_binary(s):
  fun(tm):
    match tm
    | Comb(Comb(Const(s1,_),_),_): s1 == s
    | _: #false
fun dest_binary(s):
  fun(tm):
    match tm
    | Comb(Comb(Const(s1,_),l),r): (if s1 == s | [l, r] | failwith("dest_binary"))
    | _: failwith("dest_binary")
fun mk_binary(s):
  let c = mk_const([s, PairList []])
  fun([l, r]):
    try:
      mk_comb([mk_comb([c, l]), r])
      ~catch Failure(_): failwith("mk_binary")
fun variants(av):
  fun(vs):
    if vs == PairList []
    | PairList []
    | let vh = variant(av)(hd(vs))
      PairList.cons(vh,variants(PairList.cons(vh,av))(tl(vs)))
fun variables(tm):
  fun vars(acc,tm):
    cond
    | is_var(tm): insert(tm)(acc)
    | is_const(tm): acc
    | is_abs(tm):
        let [v, bod] = dest_abs(tm)
        vars(insert(v)(acc),bod)
    | ~else:
        let [l, r] = dest_comb(tm)
        vars(vars(acc,l),r)
  vars(PairList [],tm)
fun subst(ilist):
  fun ssubst(ilist,tm):
    if ilist == PairList []
    | tm
    | try:
        fst(find(o(aconv(tm))(snd))(ilist))
        ~catch Failure(_):
          match tm
          | Comb(f,x):
              let f1 = ssubst(ilist,f)
              let x1 = ssubst(ilist,x)
              if f1 === f && x1 === x | tm | mk_comb([f1, x1])
          | Abs(v,bod):
              let ilist1 = filter(fun(p): !vfree_in(v)(snd(p)))(ilist)
              mk_abs([v, ssubst(ilist1,bod)])
          | _: tm
  let theta = filter(fun([s, t]): compare(s)(t) != 0)(ilist)
  if theta == PairList []
  | I
  | let [ts, xs] = unzip(theta)
    fun(tm):
      let gs = variants(variables(tm))(map(o(genvar)(type_of))(xs))
      let tm1 = ssubst(zip(gs)(xs),tm)
      if tm1 === tm | tm | vsubst(zip(ts)(gs))(tm1)
fun alpha(v):
  fun(tm):
    let [v0, bod]:
      try:
        dest_abs(tm)
        ~catch Failure(_): failwith("alpha: Not an abstraction")
    cond
    | v == v0: tm
    | type_of(v) == type_of(v0) && !vfree_in(v)(bod): mk_abs([v, vsubst(PairList [[v, v0]])(bod)])
    | ~else: failwith("alpha: Invalid new variable")
fun type_match(vty):
  fun(cty):
    fun(sofar):
      if is_vartype(vty)
      | try:
          if rev_assoc(vty)(sofar) == cty | sofar | failwith("type_match")
          ~catch Failure("find"): PairList.cons([cty, vty],sofar)
      | let [vop, vargs] = dest_type(vty)
        let [cop, cargs] = dest_type(cty)
        if vop == cop | itlist2(type_match)(vargs)(cargs)(sofar) | failwith("type_match")
fun mk_mconst([c, ty]):
  try:
    let uty = get_const_type(c)
    let mat = type_match(uty)(ty)(PairList [])
    let con = mk_const([c, mat])
    if type_of(con) == ty | con | fail()
    ~catch Failure(_): failwith("mk_const: generic type cannot be instantiated")
fun mk_icomb([t1, t2]):
  let ["fun", PairList [ty,_]] = dest_type(type_of(t1))
  let ti = type_match(ty)(type_of(t2))(PairList [])
  mk_comb([inst(ti)(t1), t2])
fun list_mk_icomb(cname):
  fun(args):
    let [atys, _] = nsplit(dest_fun_ty)(args)(get_const_type(cname))
    let ti = itlist2(fun(g): fun(a): type_match(g)(type_of(a)))(atys)(args)(PairList [])
    list_mk_comb([mk_const([cname, ti]), args])
fun thm_frees(th):
  let [asl, c] = dest_thm(th)
  itlist(o(union)(frees))(asl)(frees(c))
fun free_in(t1):
  fun(t2):
    cond
    | aconv(t1)(t2): #true
    | is_comb(t2):
        let [l, r] = dest_comb(t2)
        free_in(t1)(l) || free_in(t1)(r)
    | is_abs(t2):
        let [v, bod] = dest_abs(t2)
        !vfree_in(v)(t1) && free_in(t1)(bod)
    | ~else: #false
fun find_term(p):
  fun(tm):
    cond
    | p(tm): tm
    | is_abs(tm): find_term(p)(body(tm))
    | is_comb(tm):
        let [l, r] = dest_comb(tm)
        try:
          find_term(p)(l)
          ~catch Failure(_): find_term(p)(r)
    | ~else: failwith("find_term")
fun find_terms(p):
  fun accum(tl,p,tm):
    let tl1 = if p(tm) | insert(tm)(tl) | tl
    cond
    | is_abs(tm): accum(tl1,p,body(tm))
    | is_comb(tm): accum(accum(tl1,p,rator(tm)),p,rand(tm))
    | ~else: tl1
  fun(tm): accum(PairList [],p,tm)
fun is_binder(s):
  fun(tm):
    match tm
    | Comb(Const(s1,_),Abs(_,_)): s1 == s
    | _: #false
fun dest_binder(s):
  fun(tm):
    match tm
    | Comb(Const(s1,_),Abs(x,t)): (if s1 == s | [x, t] | failwith("dest_binder"))
    | _: failwith("dest_binder")
fun mk_binder(op):
  let c = mk_const([op, PairList []])
  fun([v, tm]): mk_comb([inst(PairList [[type_of(v), aty]])(c), mk_abs([v, tm])])
fun is_binop(op):
  fun(tm):
    match tm
    | Comb(Comb(op1,_),_): op1 == op
    | _: #false
fun dest_binop(op):
  fun(tm):
    match tm
    | Comb(Comb(op1,l),r): (if op1 == op | [l, r] | failwith("dest_binop"))
    | _: failwith("dest_binop")
fun mk_binop(op):
  fun(tm1):
    let f = mk_comb([op, tm1])
    fun(tm2): mk_comb([f, tm2])
fun list_mk_binop(op): end_itlist(mk_binop(op))
fun binops(op): striplist(dest_binop(op))
def is_conj = is_binary("/\\")
def dest_conj = dest_binary("/\\")
def conjuncts = striplist(dest_conj)
def is_imp = is_binary("==>")
def dest_imp = dest_binary("==>")
def is_forall = is_binder("!")
def dest_forall = dest_binder("!")
def strip_forall = splitlist(dest_forall)
def is_exists = is_binder("?")
def dest_exists = dest_binder("?")
def strip_exists = splitlist(dest_exists)
def is_disj = is_binary("\\/")
def dest_disj = dest_binary("\\/")
def disjuncts = striplist(dest_disj)
fun is_neg(tm):
  try:
    fst(dest_const(rator(tm))) == "~"
    ~catch Failure(_): #false
fun dest_neg(tm):
  try:
    let [n, p] = dest_comb(tm)
    if fst(dest_const(n)) == "~" | p | fail()
    ~catch Failure(_): failwith("dest_neg")
def is_uexists = is_binder("?!")
def dest_uexists = dest_binder("?!")
def dest_cons = dest_binary("CONS")
def is_cons = is_binary("CONS")
fun dest_list(tm):
  try:
    let [tms, nil] = splitlist(dest_cons)(tm)
    if fst(dest_const(nil)) == "NIL" | tms | fail()
    ~catch Failure(_): failwith("dest_list")
def is_list = can(dest_list)
fun dest_numeral(tm):
  fun dest_num(tm):
    let zero:
      try:
        fst(dest_const(tm)) == "_0"
        ~catch Failure(_): #false
    if zero
    | 0
    | let [l, r] = dest_comb(tm)
      let n = 2*dest_num(r)
      let cn = fst(dest_const(l))
      cond
      | cn == "BIT0": n
      | cn == "BIT1": n+1
      | ~else: fail()
  try:
    let [l, r] = dest_comb(tm)
    if fst(dest_const(l)) == "NUMERAL" | dest_num(r) | fail()
    ~catch Failure(_): failwith("dest_numeral")
fun dest_gabs(tm):
  let dest_geq = dest_binary("GEQ")
  try:
    if is_abs(tm)
    | dest_abs(tm)
    | let [l, r] = dest_comb(tm)
      if fst(dest_const(l)) != "GABS"
      | fail()
      | let [ltm, rtm] = dest_geq(snd(strip_forall(body(r))))
        [rand(ltm), rtm]
    ~catch Failure(_): failwith("dest_gabs: Not a generalized abstraction")
def is_gabs = can(dest_gabs)
fun mk_gabs([t1, t2]):
  fun mk_forall([v, t]):
    let c = mk_const(["!", PairList [[type_of(v), aty]]])
    mk_comb([c, mk_abs([v, t])])
  fun mk_geq([x, y]):
    let p = mk_const(["GEQ", PairList [[type_of(x), aty]]])
    mk_comb([mk_comb([p, x]), y])
  if is_var(t1)
  | mk_abs([t1, t2])
  | let fvs = frees(t1)
    let fty = mk_fun_ty(type_of(t1))(type_of(t2))
    let f = variant(append(frees(t1))(frees(t2)))(mk_var(["f", fty]))
    let bod = mk_abs([f, itlist(curry(mk_forall))(fvs)(mk_geq([mk_comb([f, t1]), t2]))])
    mk_comb([mk_const(["GABS", PairList [[fty, aty]]]), bod])
fun list_mk_gabs([vs, bod]): itlist(curry(mk_gabs))(vs)(bod)
def strip_gabs = splitlist(dest_gabs)
fun dest_let(tm):
  try:
    let [l, aargs] = strip_comb(tm)
    if fst(dest_const(l)) != "LET"
    | fail()
    | let [vars, lebod] = strip_gabs(hd(aargs))
      let eqs = zip(vars)(tl(aargs))
      let [le, bod] = dest_comb(lebod)
      if fst(dest_const(le)) == "LET_END" | [eqs, bod] | fail()
    ~catch Failure(_): failwith("dest_let: not a let-term")
def is_let = can(dest_let)
fun mk_let([assigs, bod]):
  let [lefts, rights] = unzip(assigs)
  let lend = mk_comb([mk_const(["LET_END", PairList [[type_of(bod), aty]]]), bod])
  let lbod = list_mk_gabs([lefts, lend])
  let [t1, t2] = dest_fun_ty(type_of(lbod))
  let ltm = mk_const(["LET", PairList [[t1, aty],[t2, bty]]])
  list_mk_comb([ltm, PairList.cons(lbod,rights)])
fun mk_finty(n):
  fun finty(n):
    if n == 1
    | mk_type(["1", PairList []])
    | mk_type([(if modulo(n,2) == 0 | "tybit0" | "tybit1"), PairList [finty(quotient(n,2))]])
  if !(n is_a Int) || n < 1 | failwith("mk_finty") | finty(n)
fun dest_finty(ty):
  match ty
  | Tyapp("1",_): 1
  | Tyapp("tybit0",PairList [ty]): dest_finty(ty)*2
  | Tyapp("tybit1",PairList [ty]): dest_finty(ty)*2+1
  | _: failwith("dest_finty")
fun make_args(s):
  fun(avoid):
    fun(tys):
      fun margs(n,s,avoid,tys):
        if tys == PairList []
        | PairList []
        | let v = variant(avoid)(mk_var([s +& to_string(n), hd(tys)]))
          PairList.cons(v,margs(n+1,s,PairList.cons(v,avoid),tl(tys)))
      if length(tys) == 1 | PairList [variant(avoid)(mk_var([s, hd(tys)]))] | margs(0,s,avoid,tys)
fun find_path(p):
  fun(tm):
    fun fp(p,tm):
      cond
      | p(tm): PairList []
      | is_abs(tm): PairList.cons("b",fp(p,body(tm)))
      | ~else:
          try:
            PairList.cons("r",fp(p,rand(tm)))
            ~catch Failure(_): PairList.cons("l",fp(p,rator(tm)))
    implode(fp(p,tm))
fun follow_path(s):
  fun(tm):
    fun fp(s,tm):
      match s
      | PairList []: tm
      | PairList ["l", & t]: fp(t,rator(tm))
      | PairList ["r", & t]: fp(t,rand(tm))
      | PairList [_, & t]: fp(t,body(tm))
    fp(explode(s),tm)
fun atoms(tm):
  fun accum(acc,tm):
    match tm
    | Comb(Comb(Const("/\\",_),l),r): accum(accum(acc,l),r)
    | Comb(Comb(Const("\\/",_),l),r): accum(accum(acc,l),r)
    | Comb(Comb(Const("==>",_),l),r): accum(accum(acc,l),r)
    | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",PairList []),_])),l),r): accum(accum(acc,l),r)
    | Comb(Const("~",_),l): accum(acc,l)
    | _: fpf_define(tm)(#void)(acc)
  if type_of(tm) != bool_ty
  | failwith("atoms: not Boolean")
  | foldl(fun(a): fun(x): fun(y): PairList.cons(x,a))(PairList [])(accum(undefined,tm))