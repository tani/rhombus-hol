  | Fusion.Comb(Fusion.Comb(Fusion.Const("=",Fusion.Tyapp("fun",PairList [Fusion.Tyapp("bool",PairList []), & PairList [_, & PairList []]])),l),r): #true
  | _: #false

fun dest_iff(tm):
