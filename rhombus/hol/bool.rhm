def MP:«
  (block:«
    let port_tmp_48_p:«
      Host.expand_quote("[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]")
    »;
    let port_tmp_49_q:«
      Host.expand_quote("[\"Var\",\"q\",[\"Tyapp\",\"bool\",[]]]")
    »;
    (block:«
      let port_tmp_50_pth:«
        (block:«
          let port_tmp_51_th1:«
            Equal.BETA_RULE(Equal.AP_THM(Equal.AP_THM(IMP_DEF)(port_tmp_48_p))(port_tmp_49_q))
          »;
          let port_tmp_52_th2:«
            (block:«
              let port_tmp_53 = Fusion.ASSUME(port_tmp_49_q);
              let port_tmp_54 = Fusion.ASSUME(port_tmp_48_p);
              CONJ(port_tmp_54)(port_tmp_53)
            »)
          »;
          let port_tmp_55_th3:«
            CONJUNCT1(Fusion.ASSUME(mk_conj(Pair(port_tmp_48_p,port_tmp_49_q))))
          »;
          (block:«
            let port_tmp_56 = Fusion.DEDUCT_ANTISYM_RULE(port_tmp_52_th2)(port_tmp_55_th3);
            let port_tmp_57 = Equal.SYM(port_tmp_51_th1);
            Fusion.EQ_MP(port_tmp_57)(port_tmp_56)
          »)
        »)
      »;
      let port_tmp_58_qth:«
        (block:«
          let th1:«
            Equal.BETA_RULE(Equal.AP_THM(Equal.AP_THM(IMP_DEF)(port_tmp_48_p))(port_tmp_49_q))
          »;
          (block:«
            let th2:«
              Fusion.EQ_MP(th1)(Fusion.ASSUME(mk_imp(Pair(port_tmp_48_p,port_tmp_49_q))))
            »;
            CONJUNCT2((block:«
              let port_tmp_59 = Fusion.ASSUME(port_tmp_48_p);
              let port_tmp_60 = Equal.SYM(th2);
              Fusion.EQ_MP(port_tmp_60)(port_tmp_59)
            »))
          »)
        »)
      »;
      (block:«
        let rth:«
          Fusion.DEDUCT_ANTISYM_RULE(port_tmp_50_pth)(port_tmp_58_qth)
        »;
        (fun(ith):«
          (fun(th):«
            (block:«
              let Pair(ant,con):«
                Basics.dest_imp(Fusion.concl(ith))
              »;
              (block:«
                if Fusion.aconv(ant)(Fusion.concl(th))
                | Fusion.EQ_MP(Fusion.EQ_MP(Fusion.DEDUCT_ANTISYM_RULE(th)(Fusion.INST(PairList.cons(Pair(ant,port_tmp_48_p),PairList.cons(Pair(con,port_tmp_49_q),PairList [])))(rth)))(th))(ith)
                | failwith("MP: theorems do not agree")
              »)
            »)
          »)
        »)
      »)
    »)
  »)
»

