def mk_imp = Basics.mk_binary("==>")

def MP:
  let p_3 = Host.expand_quote("[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]")
  let q_3 = Host.expand_quote("[\"Var\",\"q\",[\"Tyapp\",\"bool\",[]]]")
  let th1_2 = Equal.BETA_RULE(Equal.AP_THM(Equal.AP_THM(IMP_DEF)(p_3))(q_3))
  let th2_2 = CONJ(Fusion.ASSUME(p_3))(Fusion.ASSUME(q_3))
  let th3_2 = CONJUNCT1(Fusion.ASSUME(mk_conj([p_3, q_3])))
  let pth_3 = Fusion.EQ_MP(Equal.SYM(th1_2))(Fusion.DEDUCT_ANTISYM_RULE(th2_2)(th3_2))
  let th1 = Equal.BETA_RULE(Equal.AP_THM(Equal.AP_THM(IMP_DEF)(p_3))(q_3))
  let th2 = Fusion.EQ_MP(th1)(Fusion.ASSUME(mk_imp([p_3, q_3])))
  let qth_3 = CONJUNCT2(Fusion.EQ_MP(Equal.SYM(th2))(Fusion.ASSUME(p_3)))
  let rth = Fusion.DEDUCT_ANTISYM_RULE(pth_3)(qth_3)
  fun(ith):
    fun(th):
      let [ant, con] = Basics.dest_imp(Fusion.concl(ith))
      (if Fusion.aconv(ant)(Fusion.concl(th)) | Fusion.EQ_MP(Fusion.EQ_MP(Fusion.DEDUCT_ANTISYM_RULE(th)(Fusion.INST(PairList.cons([ant, p_3], PairList.cons([con, q_3], PairList [])))(rth)))(th))(ith) | failwith("MP: theorems do not agree"))

def DISCH:
  let p_4 = Host.expand_quote("[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]")
  let q_4 = Host.expand_quote("[\"Var\",\"q\",[\"Tyapp\",\"bool\",[]]]")
  let pth = Equal.SYM(Equal.BETA_RULE(Equal.AP_THM(Equal.AP_THM(IMP_DEF)(p_4))(q_4)))
  fun(a):
    fun(th):
      let th1 = CONJ(Fusion.ASSUME(a))(th)
      let th2 = CONJUNCT1(Fusion.ASSUME(Fusion.concl(th1)))
      let th3 = Fusion.DEDUCT_ANTISYM_RULE(th1)(th2)
      let th4 = Fusion.INST(PairList.cons([a, p_4], PairList.cons([Fusion.concl(th), q_4], PairList [])))(pth)
      Fusion.EQ_MP(th4)(th3)

fun DISCH_ALL(th):
  try:
    DISCH_ALL(DISCH(hd(Fusion.hyp(th)))(th))
    ~catch exn:
      match exn
      | Failure(_): th
      | exn: Host.hol_raise(exn)

fun UNDISCH(th):
  try:
    MP(th)(Fusion.ASSUME(Fusion.rand(Fusion.rator(Fusion.concl(th)))))
    ~catch exn:
