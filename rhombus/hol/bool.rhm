fun SPEC_VAR(th):
  let bv = Fusion.variant(Basics.thm_frees(th))(Basics.bndvar(Fusion.rand(Fusion.concl(th))))
  [bv, SPEC(bv)(th)]

fun SPEC_ALL(th): (if Basics.is_forall(Fusion.concl(th)) | SPEC_ALL(snd(SPEC_VAR(th))) | th)

fun ISPEC(t):
  fun(th):
    let [x, _]:
      try:
        Basics.dest_forall(Fusion.concl(th))
        ~catch exn:
          match exn
          | Failure(_): failwith("ISPEC: input theorem not universally quantified")
          | exn: Host.hol_raise(exn)
    let tyins:
      try:
        Basics.type_match(snd(Fusion.dest_var(x)))(Fusion.type_of(t))(PairList [])
        ~catch exn:
          match exn
          | Failure(_): failwith("ISPEC can't type-instantiate input theorem")
          | exn: Host.hol_raise(exn)
    try:
      SPEC(t)(Fusion.INST_TYPE(tyins)(th))
      ~catch exn:
        match exn
        | Failure(_): failwith("ISPEC: type variable(s) free in assumptions")
        | exn: Host.hol_raise(exn)

fun ISPECL(tms):
  fun(th):
    try:
      if Host.hol_equal(tms)(PairList [])
      | th
      | let avs = fst(Host.chop_list(length(tms))(fst(Basics.strip_forall(Fusion.concl(th)))))
        let tyins = itlist2(Basics.type_match)(map(o(snd)(Fusion.dest_var))(avs))(map(Fusion.type_of)(tms))(PairList [])
        SPECL(tms)(Fusion.INST_TYPE(tyins)(th))
      ~catch exn:
        match exn
        | Failure(_): failwith("ISPECL")
        | exn: Host.hol_raise(exn)

