      (if Host.hol_unequal(y_2)(y_prime_2) | failwith("IMP_TRANS") | MP(MP(Fusion.INST(PairList.cons([x_2, p_6], PairList.cons([y_2, q_6], PairList.cons([z_2, r_2], PairList []))))(pth))(th1))(th2))

