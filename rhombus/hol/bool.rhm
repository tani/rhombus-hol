  unset_verbose_symbols

Host.parse_as_prefix("~")

Host.parse_as_binder("\\")

Host.parse_as_binder("!")

Host.parse_as_binder("?")

Host.parse_as_binder("?!")

Host.parse_as_infix(["==>", [4, "right"]])

Host.parse_as_infix(["\\/", [6, "right"]])

Host.parse_as_infix(["/\\", [8, "right"]])

Host.parse_as_infix(["<=>", [2, "right"]])

TypeInference.override_interface(["<=>", @hol|{(=):bool->bool->bool}|])

Host.parse_as_infix(["=", [12, "right"]])

fun is_iff(tm):
  match tm
  | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",PairList []), & PairList [_, & PairList []]])),l),r): #true
  | _: #false

fun dest_iff(tm):
  match tm
  | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",PairList []), & PairList [_, & PairList []]])),l),r): [l, r]
  | _: failwith("dest_iff")

def mk_iff:
  let eq_tm = @hol|{(<=>)}|
  (fun([l, r]): mk_comb([mk_comb([eq_tm, l]), r]))

fun PINST(tyin):
  fun(tmin):
    fun(th):
      let iterm_fn = INST(map(F_F(I)(inst(tyin)))(tmin))
      let itype_fn = INST_TYPE(tyin)
      try:
        iterm_fn(itype_fn(th))
        ~catch exn:
          match exn
          | Failure(_): failwith("PINST")
          | exn: (throw exn)

fun PROVE_HYP(ath): fun(bth): (if exists(aconv(concl(ath)))(hyp(bth)) | EQ_MP(DEDUCT_ANTISYM_RULE(ath)(bth))(ath) | bth)

def T_DEF:
  new_basic_definition(
    @hol|{T = ((\p:bool. p) = (\p:bool. p))}|
  )

def TRUTH = EQ_MP(SYM(T_DEF))(REFL(@hol|{\p:bool. p}|))

fun EQT_ELIM(th):
  try:
    EQ_MP(SYM(th))(TRUTH)
    ~catch exn:
      match exn
      | Failure(_): failwith("EQT_ELIM")
      | exn: (throw exn)

def EQT_INTRO:
  let t = @hol|{t:bool}|
  let th1 = DEDUCT_ANTISYM_RULE(ASSUME(t))(TRUTH)
  let th2 = EQT_ELIM(ASSUME(concl(th1)))
  let pth = DEDUCT_ANTISYM_RULE(th2)(th1)
  (fun(th): EQ_MP(INST(PairList [[concl(th), t]])(pth))(th))

def AND_DEF:
  new_basic_definition(
    @hol|{(/\) = \p q. (\f:bool->bool->bool. f p q) = (\f. f T T)}|
  )

def mk_conj = mk_binary("/\\")

def list_mk_conj = end_itlist(curry(mk_conj))

def CONJ:
  let f = @hol|{f:bool->bool->bool}|
  let p = @hol|{p:bool}|
  let q = @hol|{q:bool}|
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(AND_DEF)(p))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(q))
  let th3 = EQ_MP(th2)(ASSUME(mk_conj([p, q])))
  let pth1:
    EQT_ELIM(
      BETA_RULE(AP_THM(th3)(@hol|{\(p:bool) (q:bool). q}|))
    )
  let pth_2 = ASSUME(p)
  let qth = ASSUME(q)
  let th1 = MK_COMB([AP_TERM(f)(EQT_INTRO(pth_2)), EQT_INTRO(qth)])
  let th2 = ABS(f)(th1)
  let th3 = BETA_RULE(AP_THM(AP_THM(AND_DEF)(p))(q))
  let pth2 = EQ_MP(SYM(th3))(th2)
  let pth = DEDUCT_ANTISYM_RULE(pth1)(pth2)
  fun(th1):
    fun(th2):
      let th = INST(PairList [[concl(th1), p], [concl(th2), q]])(pth)
      EQ_MP(EQ_MP(DEDUCT_ANTISYM_RULE(th1)(th))(th1))(th2)

def CONJUNCT1:
  let P = @hol|{P:bool}|
  let Q = @hol|{Q:bool}|
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(AND_DEF)(P))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(Q))
  let th3 = EQ_MP(th2)(ASSUME(mk_conj([P, Q])))
  let pth:
    EQT_ELIM(
      BETA_RULE(AP_THM(th3)(@hol|{\(p:bool) (q:bool). p}|))
    )
  fun(th):
    try:
      let [l, r] = dest_conj(concl(th))
      EQ_MP(DEDUCT_ANTISYM_RULE(th)(INST(PairList [[l, P], [r, Q]])(pth)))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("CONJUNCT1")
        | exn: (throw exn)

def CONJUNCT2:
  let P = @hol|{P:bool}|
  let Q = @hol|{Q:bool}|
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(AND_DEF)(P))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(Q))
  let th3 = EQ_MP(th2)(ASSUME(mk_conj([P, Q])))
  let pth:
    EQT_ELIM(
      BETA_RULE(AP_THM(th3)(@hol|{\(p:bool) (q:bool). q}|))
    )
  fun(th):
    try:
      let [l, r] = dest_conj(concl(th))
      EQ_MP(DEDUCT_ANTISYM_RULE(th)(INST(PairList [[l, P], [r, Q]])(pth)))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("CONJUNCT2")
        | exn: (throw exn)

fun CONJ_PAIR(th):
  try:
    [CONJUNCT1(th), CONJUNCT2(th)]
    ~catch exn:
      match exn
      | Failure(_): failwith("CONJ_PAIR: Not a conjunction")
      | exn: (throw exn)

def CONJUNCTS = striplist(CONJ_PAIR)

def IMP_DEF:
  new_basic_definition(
    @hol|{(==>) = \p q. p /\ q <=> p}|
  )

def mk_imp = mk_binary("==>")

def MP:
  let p = @hol|{p:bool}|
  let q = @hol|{q:bool}|
  let th1_2 = BETA_RULE(AP_THM(AP_THM(IMP_DEF)(p))(q))
  let th2_2 = CONJ(ASSUME(p))(ASSUME(q))
  let th3 = CONJUNCT1(ASSUME(mk_conj([p, q])))
  let pth = EQ_MP(SYM(th1_2))(DEDUCT_ANTISYM_RULE(th2_2)(th3))
  let th1 = BETA_RULE(AP_THM(AP_THM(IMP_DEF)(p))(q))
  let th2 = EQ_MP(th1)(ASSUME(mk_imp([p, q])))
  let qth = CONJUNCT2(EQ_MP(SYM(th2))(ASSUME(p)))
  let rth = DEDUCT_ANTISYM_RULE(pth)(qth)
  fun(ith):
    fun(th):
      let [ant, con] = dest_imp(concl(ith))
      if aconv(ant)(concl(th))
      | EQ_MP(
          EQ_MP(DEDUCT_ANTISYM_RULE(th)(INST(PairList [[ant, p], [con, q]])(rth)))(th)
        )(ith)
      | failwith("MP: theorems do not agree")

def DISCH:
  let p = @hol|{p:bool}|
  let q = @hol|{q:bool}|
  let pth = SYM(BETA_RULE(AP_THM(AP_THM(IMP_DEF)(p))(q)))
  fun(a):
    fun(th):
      let th1 = CONJ(ASSUME(a))(th)
      let th2 = CONJUNCT1(ASSUME(concl(th1)))
      let th3 = DEDUCT_ANTISYM_RULE(th1)(th2)
      let th4 = INST(PairList [[a, p], [concl(th), q]])(pth)
      EQ_MP(th4)(th3)

fun DISCH_ALL(th):
  try:
    DISCH_ALL(DISCH(hd(hyp(th)))(th))
    ~catch exn:
      match exn
      | Failure(_): th
      | exn: (throw exn)

fun UNDISCH(th):
  try:
    MP(th)(ASSUME(rand(rator(concl(th)))))
    ~catch exn:
      match exn
      | Failure(_): failwith("UNDISCH")
      | exn: (throw exn)

fun UNDISCH_ALL(th): (if is_imp(concl(th)) | UNDISCH_ALL(UNDISCH(th)) | th)

def IMP_ANTISYM_RULE:
  let p = @hol|{p:bool}|
  let q = @hol|{q:bool}|
  let imp_tm = @hol|{(==>)}|
  let pq = mk_imp([p, q])
  let qp = mk_imp([q, p])
  let [pth1, pth2] = CONJ_PAIR(ASSUME(mk_conj([pq, qp])))
  let pth3 = DEDUCT_ANTISYM_RULE(UNDISCH(pth2))(UNDISCH(pth1))
  let pth4 = DISCH_ALL(ASSUME(q))
  let pth5 = ASSUME(mk_eq([p, q]))
  let pth6 = CONJ(EQ_MP(SYM(AP_THM(AP_TERM(imp_tm)(pth5))(q)))(pth4))(EQ_MP(SYM(AP_TERM(mk_comb([imp_tm, q]))(pth5)))(pth4))
  let pth = DEDUCT_ANTISYM_RULE(pth6)(pth3)
  fun(th1):
    fun(th2):
      let [p1, q1] = dest_imp(concl(th1))
      EQ_MP(INST(PairList [[p1, p], [q1, q]])(pth))(CONJ(th1)(th2))

fun ADD_ASSUM(tm): fun(th): MP(DISCH(tm)(th))(ASSUME(tm))

def EQ_IMP_RULE:
  let peq = @hol|{p <=> q}|
  let [p, q] = dest_iff(peq)
  let pth1 = DISCH(peq)(DISCH(p)(EQ_MP(ASSUME(peq))(ASSUME(p))))
  let pth2 = DISCH(peq)(DISCH(q)(EQ_MP(SYM(ASSUME(peq)))(ASSUME(q))))
  fun(th):
    let [l, r] = dest_iff(concl(th))
    [
      MP(INST(PairList [[l, p], [r, q]])(pth1))(th),
      MP(INST(PairList [[l, p], [r, q]])(pth2))(th)
    ]

def IMP_TRANS:
  let pq = @hol|{p ==> q}|
  let qr = @hol|{q ==> r}|
  let [p, q] = dest_imp(pq)
  let r = rand(qr)
  let pth = itlist(DISCH)(PairList [pq, qr, p])(MP(ASSUME(qr))(MP(ASSUME(pq))(ASSUME(p))))
  fun(th1):
    fun(th2):
      let [x, y] = dest_imp(concl(th1))
      let [y_prime, z] = dest_imp(concl(th2))
      (if (y != y_prime) | failwith("IMP_TRANS") | MP(MP(INST(PairList [[x, p], [y, q], [z, r]])(pth))(th1))(th2))

def FORALL_DEF:
  new_basic_definition(
    @hol|{(!) = \P:A->bool. P = \x. T}|
  )

def mk_forall = mk_binder("!")

fun list_mk_forall([vs, bod]): itlist(curry(mk_forall))(vs)(bod)

def SPEC:
  let P = @hol|{P:A->bool}|
  let x = @hol|{x:A}|
  let th1:
    EQ_MP(AP_THM(FORALL_DEF)(@hol|{P:A->bool}|))(
      ASSUME(
        @hol|{(!)(P:A->bool)}|
      )
    )
  let th2 = AP_THM(CONV_RULE(BETA_CONV)(th1))(@hol|{x:A}|)
  let th3 = CONV_RULE(RAND_CONV(BETA_CONV))(th2)
  let pth = DISCH_ALL(EQT_ELIM(th3))
  fun(tm):
    fun(th):
      try:
        let abs = rand(concl(th))
        CONV_RULE(BETA_CONV)(
          MP(
            PINST(
              PairList [[snd(dest_var(bndvar(abs))), aty]])(
              PairList [[abs, P], [tm, x]]
            )(pth)
          )(th)
        )
        ~catch exn:
          match exn
          | Failure(_): failwith("SPEC")
          | exn: (throw exn)

fun SPECL(tms):
  fun(th):
    try:
      rev_itlist(SPEC)(tms)(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("SPECL")
        | exn: (throw exn)

fun SPEC_VAR(th):
  let bv = variant(thm_frees(th))(bndvar(rand(concl(th))))
  [bv, SPEC(bv)(th)]

fun SPEC_ALL(th): (if is_forall(concl(th)) | SPEC_ALL(snd(SPEC_VAR(th))) | th)

fun ISPEC(t):
  fun(th):
    let [x, _]:
      try:
        dest_forall(concl(th))
        ~catch exn:
          match exn
          | Failure(_): failwith("ISPEC: input theorem not universally quantified")
          | exn: (throw exn)
    let tyins:
      try:
        type_match(snd(dest_var(x)))(type_of(t))(PairList [])
        ~catch exn:
          match exn
          | Failure(_): failwith("ISPEC can't type-instantiate input theorem")
          | exn: (throw exn)
    try:
      SPEC(t)(INST_TYPE(tyins)(th))
      ~catch exn:
        match exn
        | Failure(_): failwith("ISPEC: type variable(s) free in assumptions")
        | exn: (throw exn)

fun ISPECL(tms):
  fun(th):
    try:
      if (tms == (PairList []))
      | th
      | let avs = fst(chop_list(length(tms))(fst(strip_forall(concl(th)))))
        let tyins = itlist2(type_match)(map(o(snd)(dest_var))(avs))(map(type_of)(tms))(PairList [])
        SPECL(tms)(INST_TYPE(tyins)(th))
      ~catch exn:
        match exn
        | Failure(_): failwith("ISPECL")
        | exn: (throw exn)

def GEN:
  let pth:
    SYM(
      CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(FORALL_DEF)(@hol|{P:A->bool}|))
    )
  fun(x):
    fun(th):
      let qth = INST_TYPE(PairList [[snd(dest_var(x)), aty]])(pth)
      let ptm = rand(rand(concl(qth)))
      let th_prime = ABS(x)(EQT_INTRO(th))
      let phi = lhand(concl(th_prime))
      let rth = INST(PairList [[phi, ptm]])(qth)
      EQ_MP(rth)(th_prime)

def GENL = itlist(GEN)

fun GEN_ALL(th):
  let [asl, c] = dest_thm(th)
  let vars = subtract(frees(c))(freesl(asl))
  GENL(vars)(th)

def EXISTS_DEF:
  new_basic_definition(
    @hol|{(?) = \P:A->bool. !q. (!x. P x ==> q) ==> q}|
  )

def mk_exists = mk_binder("?")

fun list_mk_exists([vs, bod]): itlist(curry(mk_exists))(vs)(bod)

def EXISTS:
  let P = @hol|{P:A->bool}|
  let x = @hol|{x:A}|
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(EXISTS_DEF)(P))
  let th2:
    SPEC(@hol|{x:A}|)(
      ASSUME(
        @hol|{!x:A. P x ==> Q}|
      )
    )
  let th3:
    DISCH(
      @hol|{!x:A. P x ==> Q}|
    )(
      MP(th2)(ASSUME(@hol|{(P:A->bool) x}|))
    )
  let pth = EQ_MP(SYM(th1))(GEN(@hol|{Q:bool}|)(th3))
  fun([etm, stm]):
    fun(th):
      try:
        let [qf, abs] = dest_comb(etm)
        let bth = BETA_CONV(mk_comb([abs, stm]))
        let cth = PINST(PairList [[type_of(stm), aty]])(PairList [[abs, P], [stm, x]])(pth)
        PROVE_HYP(EQ_MP(SYM(bth))(th))(cth)
        ~catch exn:
          match exn
          | Failure(_): failwith("EXISTS")
          | exn: (throw exn)

fun SIMPLE_EXISTS(v): fun(th): EXISTS([mk_exists([v, concl(th)]), v])(th)

def CHOOSE:
  let P = @hol|{P:A->bool}|
  let Q = @hol|{Q:bool}|
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(EXISTS_DEF)(P))
  let th2 = SPEC(@hol|{Q:bool}|)(UNDISCH(fst(EQ_IMP_RULE(th1))))
  let pth:
    DISCH_ALL(
      DISCH(
        @hol|{(?) (P:A->bool)}|
      )(UNDISCH(th2))
    )
  fun([v, th1]):
    fun(th2):
      try:
        let abs = rand(concl(th1))
        let [bv, bod] = dest_abs(abs)
        let cmb = mk_comb([abs, v])
        let pat = vsubst(PairList [[v, bv]])(bod)
        let th3 = CONV_RULE(BETA_CONV)(ASSUME(cmb))
        let th4 = GEN(v)(DISCH(cmb)(MP(DISCH(pat)(th2))(th3)))
        let th5 = PINST(PairList [[snd(dest_var(v)), aty]])(PairList [[abs, P], [concl(th2), Q]])(pth)
        MP(MP(th5)(th4))(th1)
        ~catch exn:
          match exn
          | Failure(_): failwith("CHOOSE")
          | exn: (throw exn)

fun SIMPLE_CHOOSE(v): fun(th): CHOOSE([v, ASSUME(mk_exists([v, hd(hyp(th))]))])(th)

def OR_DEF:
  new_basic_definition(
    @hol|{(\/) = \p q. !r. (p ==> r) ==> (q ==> r) ==> r}|
  )

def mk_disj = mk_binary("\\/")

def list_mk_disj = end_itlist(curry(mk_disj))

def DISJ1:
  let P = @hol|{P:bool}|
  let Q = @hol|{Q:bool}|
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(OR_DEF)(@hol|{P:bool}|))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(@hol|{Q:bool}|))
  let th3 = MP(ASSUME(@hol|{P ==> t}|))(ASSUME(@hol|{P:bool}|))
  let th4:
    GEN(@hol|{t:bool}|)(
      DISCH(@hol|{P ==> t}|)(DISCH(@hol|{Q ==> t}|)(th3))
    )
  let pth = EQ_MP(SYM(th2))(th4)
  fun(th):
    fun(tm):
      try:
        EQ_MP(
          DEDUCT_ANTISYM_RULE(th)(INST(PairList [[concl(th), P], [tm, Q]])(pth))
        )(th)
        ~catch exn:
          match exn
          | Failure(_): failwith("DISJ1")
          | exn: (throw exn)

def DISJ2:
  let P = @hol|{P:bool}|
  let Q = @hol|{Q:bool}|
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(OR_DEF)(@hol|{P:bool}|))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(@hol|{Q:bool}|))
  let th3 = MP(ASSUME(@hol|{Q ==> t}|))(ASSUME(@hol|{Q:bool}|))
  let th4:
    GEN(@hol|{t:bool}|)(
      DISCH(@hol|{P ==> t}|)(DISCH(@hol|{Q ==> t}|)(th3))
    )
  let pth = EQ_MP(SYM(th2))(th4)
  fun(tm):
    fun(th):
      try:
        EQ_MP(
          DEDUCT_ANTISYM_RULE(th)(INST(PairList [[tm, P], [concl(th), Q]])(pth))
        )(th)
        ~catch exn:
          match exn
          | Failure(_): failwith("DISJ2")
          | exn: (throw exn)

def DISJ_CASES:
  let P = @hol|{P:bool}|
  let Q = @hol|{Q:bool}|
  let R = @hol|{R:bool}|
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(OR_DEF)(@hol|{P:bool}|))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(@hol|{Q:bool}|))
  let th3 = SPEC(@hol|{R:bool}|)(EQ_MP(th2)(ASSUME(@hol|{P \/ Q}|)))
  let pth = UNDISCH(UNDISCH(th3))
  fun(th0):
    fun(th1):
      fun(th2):
        try:
          let c1 = concl(th1)
          let c2 = concl(th2)
          if !aconv(c1)(c2)
          | failwith("DISJ_CASES")
          | let [l, r] = dest_disj(concl(th0))
            let th = INST(PairList [[l, P], [r, Q], [c1, R]])(pth)
            PROVE_HYP(DISCH(r)(th2))(PROVE_HYP(DISCH(l)(th1))(EQ_MP(DEDUCT_ANTISYM_RULE(th0)(th))(th0)))
          ~catch exn:
            match exn
            | Failure(_): failwith("DISJ_CASES")
            | exn: (throw exn)

fun SIMPLE_DISJ_CASES(th1): fun(th2): DISJ_CASES(ASSUME(mk_disj([hd(hyp(th1)), hd(hyp(th2))])))(th1)(th2)

def F_DEF = new_basic_definition(@hol|{F = !p:bool. p}|)

def NOT_DEF:
  new_basic_definition(
    @hol|{(~) = \p. p ==> F}|
  )

def mk_neg:
  let neg_tm = @hol|{(~)}|
  fun(tm):
    try:
      mk_comb([neg_tm, tm])
      ~catch exn:
        match exn
        | Failure(_): failwith("mk_neg")
        | exn: (throw exn)

def NOT_ELIM:
  let P = @hol|{P:bool}|
  let pth = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(NOT_DEF)(P))
  fun(th):
    try:
      EQ_MP(INST(PairList [[rand(concl(th)), P]])(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("NOT_ELIM")
        | exn: (throw exn)

def NOT_INTRO:
  let P = @hol|{P:bool}|
  let pth = SYM(CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(NOT_DEF)(P)))
  fun(th):
    try:
      EQ_MP(INST(PairList [[rand(rator(concl(th))), P]])(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("NOT_INTRO")
        | exn: (throw exn)

def EQF_INTRO:
  let P = @hol|{P:bool}|
  let th1 = NOT_ELIM(ASSUME(@hol|{~ P}|))
  let th2 = DISCH(@hol|{F}|)(SPEC(P)(EQ_MP(F_DEF)(ASSUME(@hol|{F}|))))
  let pth = DISCH_ALL(IMP_ANTISYM_RULE(th1)(th2))
  fun(th):
    try:
      MP(INST(PairList [[rand(concl(th)), P]])(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("EQF_INTRO")
        | exn: (throw exn)

def EQF_ELIM:
  let P = @hol|{P:bool}|
  let th1 = EQ_MP(ASSUME(@hol|{P = F}|))(ASSUME(@hol|{P:bool}|))
  let th2 = DISCH(P)(SPEC(@hol|{F}|)(EQ_MP(F_DEF)(th1)))
  let pth = DISCH_ALL(NOT_INTRO(th2))
  fun(th):
    try:
      MP(INST(PairList [[rand(rator(concl(th))), P]])(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("EQF_ELIM")
        | exn: (throw exn)

def CONTR:
  let P = @hol|{P:bool}|
  let f_tm = @hol|{F}|
  let pth = SPEC(P)(EQ_MP(F_DEF)(ASSUME(@hol|{F}|)))
  fun(tm): fun(th): (if (concl(th) != f_tm) | failwith("CONTR") | EQ_MP(DEDUCT_ANTISYM_RULE(th)(INST(PairList [[tm, P]])(pth)))(th))

def EXISTS_UNIQUE_DEF:
  new_basic_definition(
    @hol|{(?!) = \P:A->bool. ((?) P) /\ (!x y. P x /\ P y ==> x = y)}|
  )

def mk_uexists = mk_binder("?!")

def EXISTENCE:
  let P = @hol|{P:A->bool}|
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(EXISTS_UNIQUE_DEF)(P))
  let th2 = UNDISCH(fst(EQ_IMP_RULE(th1)))
  let pth = DISCH_ALL(CONJUNCT1(th2))
  fun(th):
    try:
      let abs = rand(concl(th))
      let ty = snd(dest_var(bndvar(abs)))
      MP(PINST(PairList [[ty, aty]])(PairList [[abs, P]])(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("EXISTENCE")
        | exn: (throw exn)

fun set_verbose_symbols(_):
  do_list(Host.parse_as_binder)(PairList ["forall", "exists", "existsunique"])
  TypeInference.override_interface(["true", @hol|{T}|])
  TypeInference.override_interface(["false", @hol|{F}|])
  TypeInference.override_interface(["forall", @hol|{(!):(A->bool)->bool}|])
  TypeInference.override_interface(["exists", @hol|{(?):(A->bool)->bool}|])
  TypeInference.override_interface(["existsunique", @hol|{(?!):(A->bool)->bool}|])

fun unset_verbose_symbols(_):
  do_list(Host.unparse_as_binder)(PairList ["forall", "exists", "existsunique"])
  do_list(TypeInference.remove_interface)(PairList ["true", "false", "forall", "exists", "existsunique"])

set_verbose_symbols(#void)
