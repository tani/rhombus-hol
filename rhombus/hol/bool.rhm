      Comb
  "lib.rhm" open
  "private/ocaml.rhm" open
  "private/hol_quote.rhm" open
  "printer.rhm" as Host
  "preterm.rhm" as TypeInference
  "private/declarations.rhm" open
  "fusion.rhm" as Fusion
  "basics.rhm" as Basics
  "equal.rhm" as Equal

export:
  is_iff
  dest_iff
  mk_iff
  PINST
  PROVE_HYP
  T_DEF
  TRUTH
