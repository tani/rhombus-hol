  let pth1_3 = DISCH(peq)(DISCH(p)(Fusion.EQ_MP(Fusion.ASSUME(peq))(Fusion.ASSUME(p))))
  let pth2_3 = DISCH(peq)(DISCH(q)(Fusion.EQ_MP(Equal.SYM(Fusion.ASSUME(peq)))(Fusion.ASSUME(q))))
  fun(th):
    let [l, r] = dest_iff(Fusion.concl(th))
    [MP(Fusion.INST(PairList.cons([l, p], PairList.cons([r, q], PairList [])))(pth1_3))(th), MP(Fusion.INST(PairList.cons([l, p], PairList.cons([r, q], PairList [])))(pth2_3))(th)]

