  | Fusion.Comb(Fusion.Comb(Fusion.Const("=",Fusion.Tyapp("fun",PairList [Fusion.Tyapp("bool",PairList []), & PairList [_, & PairList []]])),l),r): [l, r]
  | _: failwith("dest_iff")

