  let q_5 = Host.expand_quote("[\"Var\",\"q\",[\"Tyapp\",\"bool\",[]]]")
  let imp_tm_2 = Host.expand_quote("[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]]")
