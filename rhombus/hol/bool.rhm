        »
      »
    »
  »)
»

def EQT_INTRO:«
  (block:«
    let t:«
      Host.expand_quote("[\"Var\",\"t\",[\"Tyapp\",\"bool\",[]]]")
    »;
    (block:«
      let pth:«
        (block:«
          let th1:«
            Fusion.DEDUCT_ANTISYM_RULE(Fusion.ASSUME(t))(TRUTH)
          »;
          (block:«
            let th2:«
              EQT_ELIM(Fusion.ASSUME(Fusion.concl(th1)))
            »;
            Fusion.DEDUCT_ANTISYM_RULE(th2)(th1)
          »)
        »)
      »;
      (fun(th):«
        Fusion.EQ_MP(Fusion.INST(PairList.cons(Pair(Fusion.concl(th),t),PairList []))(pth))(th)
      »)
    »)
  »)
»

