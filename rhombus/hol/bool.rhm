»

fun EQT_ELIM(th):«
  (block:«
    try:«
      Fusion.EQ_MP(Equal.SYM(th))(TRUTH);
      ~catch port_tmp_11:«
        let port_tmp_12 = port_tmp_11;
        match port_tmp_12
        | Failure(_):«
            failwith("EQT_ELIM")
        »
