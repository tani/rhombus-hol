Host.parse_as_prefix("~")

Host.parse_as_binder("\\")

Host.parse_as_binder("!")

Host.parse_as_binder("?")

Host.parse_as_binder("?!")

Host.parse_as_infix(["==>", [4, "right"]])

Host.parse_as_infix(["\\/", [6, "right"]])

Host.parse_as_infix(["/\\", [8, "right"]])

Host.parse_as_infix(["<=>", [2, "right"]])

Host.override_interface(["<=>", (hol: const #{=} :: bool -> bool -> bool; #{=})])

Host.parse_as_infix(["=", [12, "right"]])

fun is_iff(tm):
  match tm
  | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",PairList []), & PairList [_, & PairList []]])),l),r): #true
  | _: #false

fun dest_iff(tm):
  match tm
  | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",PairList []), & PairList [_, & PairList []]])),l),r): [l, r]
  | _: failwith("dest_iff")

def mk_iff:
  let eq_tm = hol: const #{=} :: bool -> bool -> bool; #{=}
  (fun([l, r]): mk_comb([mk_comb([eq_tm, l]), r]))

fun PINST(tyin):
  fun(tmin):
    fun(th):
      let iterm_fn_2 = INST(map(F_F(I)(inst(tyin)))(tmin))
      let itype_fn_2 = INST_TYPE(tyin)
      try:
        iterm_fn_2(itype_fn_2(th))
        ~catch exn:
          match exn
          | Failure(_): failwith("PINST")
          | exn: (throw exn)

fun PROVE_HYP(ath): fun(bth): (if exists(aconv(concl(ath)))(hyp(bth)) | EQ_MP(DEDUCT_ANTISYM_RULE(ath)(bth))(ath) | bth)

def T_DEF:
  new_basic_definition(
    (hol:
       var T :: bool
       T <=> (fun (p :: bool): p) == (fun (p :: bool): p))
  )

def TRUTH = EQ_MP(SYM(T_DEF))(REFL(hol:
                                     fun (p :: bool): p))

fun EQT_ELIM(th):
  try:
    EQ_MP(SYM(th))(TRUTH)
    ~catch exn:
      match exn
      | Failure(_): failwith("EQT_ELIM")
      | exn: (throw exn)

def EQT_INTRO:
  let t = hol: var t :: bool; t
  let th1 = DEDUCT_ANTISYM_RULE(ASSUME(t))(TRUTH)
  let th2 = EQT_ELIM(ASSUME(concl(th1)))
  let pth = DEDUCT_ANTISYM_RULE(th2)(th1)
  (fun(th): EQ_MP(INST(PairList [[concl(th), t]])(pth))(th))

def AND_DEF:
  new_basic_definition(
    (hol:
       var #{|/\|} :: bool -> bool -> bool
       #{|/\|}
         == (fun (p :: bool, q :: bool):
               (fun (f :: bool -> bool -> bool): f(p, q))
                 == (fun (f :: bool -> bool -> bool): f(#true, #true))))
  )

def mk_conj = mk_binary("/\\")

def list_mk_conj = end_itlist(curry(mk_conj))

def CONJ:
  let f_2 = hol: var f :: bool -> bool -> bool; f
  let p_2 = hol: var p :: bool; p
  let q_2 = hol: var q :: bool; q
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(AND_DEF)(p_2))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(q_2))
  let th3 = EQ_MP(th2)(ASSUME(mk_conj([p_2, q_2])))
  let pth1_2:
    EQT_ELIM(
      BETA_RULE(AP_THM(th3)(hol:
                              fun (p :: bool, q :: bool): q))
    )
  let pth_2 = ASSUME(p_2)
  let qth_2 = ASSUME(q_2)
  let th1 = MK_COMB([AP_TERM(f_2)(EQT_INTRO(pth_2)), EQT_INTRO(qth_2)])
  let th2 = ABS(f_2)(th1)
  let th3 = BETA_RULE(AP_THM(AP_THM(AND_DEF)(p_2))(q_2))
  let pth2_2 = EQ_MP(SYM(th3))(th2)
  let pth = DEDUCT_ANTISYM_RULE(pth1_2)(pth2_2)
  fun(th1):
    fun(th2):
      let th = INST(PairList [[concl(th1), p_2], [concl(th2), q_2]])(pth)
      EQ_MP(EQ_MP(DEDUCT_ANTISYM_RULE(th1)(th))(th1))(th2)

def CONJUNCT1:
  let P_2 = hol: var P :: bool; P
  let Q_2 = hol: var Q :: bool; Q
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(AND_DEF)(P_2))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(Q_2))
  let th3 = EQ_MP(th2)(ASSUME(mk_conj([P_2, Q_2])))
  let pth:
    EQT_ELIM(
      BETA_RULE(AP_THM(th3)(hol:
                              fun (p :: bool, q :: bool): p))
    )
  fun(th):
    try:
      let [l, r] = dest_conj(concl(th))
      EQ_MP(DEDUCT_ANTISYM_RULE(th)(INST(PairList [[l, P_2], [r, Q_2]])(pth)))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("CONJUNCT1")
        | exn: (throw exn)

def CONJUNCT2:
  let P_3 = hol: var P :: bool; P
  let Q_3 = hol: var Q :: bool; Q
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(AND_DEF)(P_3))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(Q_3))
  let th3 = EQ_MP(th2)(ASSUME(mk_conj([P_3, Q_3])))
  let pth:
    EQT_ELIM(
      BETA_RULE(AP_THM(th3)(hol:
                              fun (p :: bool, q :: bool): q))
    )
  fun(th):
    try:
      let [l, r] = dest_conj(concl(th))
      EQ_MP(DEDUCT_ANTISYM_RULE(th)(INST(PairList [[l, P_3], [r, Q_3]])(pth)))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("CONJUNCT2")
        | exn: (throw exn)

fun CONJ_PAIR(th):
  try:
    [CONJUNCT1(th), CONJUNCT2(th)]
    ~catch exn:
      match exn
      | Failure(_): failwith("CONJ_PAIR: Not a conjunction")
      | exn: (throw exn)

def CONJUNCTS = striplist(CONJ_PAIR)

def IMP_DEF:
  new_basic_definition(
    (hol:
       var #{==>} :: bool -> bool -> bool
       var.#{==>} == (fun (p :: bool, q :: bool): p && q <=> p))
  )

def mk_imp = mk_binary("==>")

def MP:
  let p_3 = hol: var p :: bool; p
  let q_3 = hol: var q :: bool; q
  let th1_2 = BETA_RULE(AP_THM(AP_THM(IMP_DEF)(p_3))(q_3))
  let th2_2 = CONJ(ASSUME(p_3))(ASSUME(q_3))
  let th3_2 = CONJUNCT1(ASSUME(mk_conj([p_3, q_3])))
  let pth_3 = EQ_MP(SYM(th1_2))(DEDUCT_ANTISYM_RULE(th2_2)(th3_2))
  let th1 = BETA_RULE(AP_THM(AP_THM(IMP_DEF)(p_3))(q_3))
  let th2 = EQ_MP(th1)(ASSUME(mk_imp([p_3, q_3])))
  let qth_3 = CONJUNCT2(EQ_MP(SYM(th2))(ASSUME(p_3)))
  let rth = DEDUCT_ANTISYM_RULE(pth_3)(qth_3)
  fun(ith):
    fun(th):
      let [ant, con] = dest_imp(concl(ith))
      if aconv(ant)(concl(th))
      | EQ_MP(
          EQ_MP(DEDUCT_ANTISYM_RULE(th)(INST(PairList [[ant, p_3], [con, q_3]])(rth)))(th)
        )(ith)
      | failwith("MP: theorems do not agree")

def DISCH:
  let p_4 = hol: var p :: bool; p
  let q_4 = hol: var q :: bool; q
  let pth = SYM(BETA_RULE(AP_THM(AP_THM(IMP_DEF)(p_4))(q_4)))
  fun(a):
    fun(th):
      let th1 = CONJ(ASSUME(a))(th)
      let th2 = CONJUNCT1(ASSUME(concl(th1)))
      let th3 = DEDUCT_ANTISYM_RULE(th1)(th2)
      let th4 = INST(PairList [[a, p_4], [concl(th), q_4]])(pth)
      EQ_MP(th4)(th3)

fun DISCH_ALL(th):
  try:
    DISCH_ALL(DISCH(hd(hyp(th)))(th))
    ~catch exn:
      match exn
      | Failure(_): th
      | exn: (throw exn)

fun UNDISCH(th):
  try:
    MP(th)(ASSUME(rand(rator(concl(th)))))
    ~catch exn:
      match exn
      | Failure(_): failwith("UNDISCH")
      | exn: (throw exn)

fun UNDISCH_ALL(th): (if is_imp(concl(th)) | UNDISCH_ALL(UNDISCH(th)) | th)

def IMP_ANTISYM_RULE:
  let p_5 = hol: var p :: bool; p
  let q_5 = hol: var q :: bool; q
  let imp_tm_2 = hol: const #{==>} :: bool -> bool -> bool; const.#{==>}
  let pq_2 = mk_imp([p_5, q_5])
  let qp_2 = mk_imp([q_5, p_5])
  let [pth1, pth2] = CONJ_PAIR(ASSUME(mk_conj([pq_2, qp_2])))
  let pth3 = DEDUCT_ANTISYM_RULE(UNDISCH(pth2))(UNDISCH(pth1))
  let pth4_2 = DISCH_ALL(ASSUME(q_5))
  let pth5_2 = ASSUME(mk_eq([p_5, q_5]))
  let pth6 = CONJ(EQ_MP(SYM(AP_THM(AP_TERM(imp_tm_2)(pth5_2))(q_5)))(pth4_2))(EQ_MP(SYM(AP_TERM(mk_comb([imp_tm_2, q_5]))(pth5_2)))(pth4_2))
  let pth = DEDUCT_ANTISYM_RULE(pth6)(pth3)
  fun(th1):
    fun(th2):
      let [p1, q1] = dest_imp(concl(th1))
      EQ_MP(INST(PairList [[p1, p_5], [q1, q_5]])(pth))(CONJ(th1)(th2))

fun ADD_ASSUM(tm): fun(th): MP(DISCH(tm)(th))(ASSUME(tm))

def EQ_IMP_RULE:
  let peq = hol:
    var p :: bool
    var q :: bool
    p <=> q
  let [p, q] = dest_iff(peq)
  let pth1_3 = DISCH(peq)(DISCH(p)(EQ_MP(ASSUME(peq))(ASSUME(p))))
  let pth2_3 = DISCH(peq)(DISCH(q)(EQ_MP(SYM(ASSUME(peq)))(ASSUME(q))))
  fun(th):
    let [l, r] = dest_iff(concl(th))
    [
      MP(INST(PairList [[l, p], [r, q]])(pth1_3))(th),
      MP(INST(PairList [[l, p], [r, q]])(pth2_3))(th)
    ]

def IMP_TRANS:
  let pq_3 = hol:
    var p :: bool
    var q :: bool
    p ==> q
  let qr_2 = hol:
    var q :: bool
    var r :: bool
    q ==> r
  let [p_6, q_6] = dest_imp(pq_3)
  let r_2 = rand(qr_2)
  let pth = itlist(DISCH)(PairList [pq_3, qr_2, p_6])(MP(ASSUME(qr_2))(MP(ASSUME(pq_3))(ASSUME(p_6))))
  fun(th1):
    fun(th2):
      let [x_2, y_2] = dest_imp(concl(th1))
      let [y_prime_2, z_2] = dest_imp(concl(th2))
      (if (y_2 != y_prime_2) | failwith("IMP_TRANS") | MP(MP(INST(PairList [[x_2, p_6], [y_2, q_6], [z_2, r_2]])(pth))(th1))(th2))

def FORALL_DEF:
  new_basic_definition(
    (hol:
       var #{!} :: (A -> bool) -> bool
       var.#{!} == (fun (P :: A -> bool): P == (fun (x :: A): #true)))
  )

def mk_forall = mk_binder("!")

fun list_mk_forall([vs, bod]): itlist(curry(mk_forall))(vs)(bod)

def SPEC:
  let P_4 = hol: var P :: A -> bool; P
  let x_3 = hol: var x :: A; x
  let th1:
    EQ_MP(AP_THM(FORALL_DEF)(hol: var P :: A -> bool; P))(
      ASSUME(
        (hol:
           var P :: A -> bool
           const #{!} :: (A -> bool) -> bool
           const.#{!}(P))
      )
    )
  let th2 = AP_THM(CONV_RULE(BETA_CONV)(th1))(hol: var x :: A; x)
  let th3 = CONV_RULE(RAND_CONV(BETA_CONV))(th2)
  let pth = DISCH_ALL(EQT_ELIM(th3))
  fun(tm):
    fun(th):
      try:
        let abs_2 = rand(concl(th))
        CONV_RULE(BETA_CONV)(
          MP(
            PINST(
              PairList [[snd(dest_var(bndvar(abs_2))), aty]])(
              PairList [[abs_2, P_4], [tm, x_3]]
            )(pth)
          )(th)
        )
        ~catch exn:
          match exn
          | Failure(_): failwith("SPEC")
          | exn: (throw exn)

fun SPECL(tms):
  fun(th):
    try:
      rev_itlist(SPEC)(tms)(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("SPECL")
        | exn: (throw exn)

fun SPEC_VAR(th):
  let bv = variant(thm_frees(th))(bndvar(rand(concl(th))))
  [bv, SPEC(bv)(th)]

fun SPEC_ALL(th): (if is_forall(concl(th)) | SPEC_ALL(snd(SPEC_VAR(th))) | th)

fun ISPEC(t):
  fun(th):
    let [x, _]:
      try:
        dest_forall(concl(th))
        ~catch exn:
          match exn
          | Failure(_): failwith("ISPEC: input theorem not universally quantified")
          | exn: (throw exn)
    let tyins:
      try:
        type_match(snd(dest_var(x)))(type_of(t))(PairList [])
        ~catch exn:
          match exn
          | Failure(_): failwith("ISPEC can't type-instantiate input theorem")
          | exn: (throw exn)
    try:
      SPEC(t)(INST_TYPE(tyins)(th))
      ~catch exn:
        match exn
        | Failure(_): failwith("ISPEC: type variable(s) free in assumptions")
        | exn: (throw exn)

fun ISPECL(tms):
  fun(th):
    try:
      if (tms == (PairList []))
      | th
      | let avs = fst(chop_list(length(tms))(fst(strip_forall(concl(th)))))
        let tyins = itlist2(type_match)(map(o(snd)(dest_var))(avs))(map(type_of)(tms))(PairList [])
        SPECL(tms)(INST_TYPE(tyins)(th))
      ~catch exn:
        match exn
        | Failure(_): failwith("ISPECL")
        | exn: (throw exn)

def GEN:
  let pth:
    SYM(
      CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(FORALL_DEF)(hol: var P :: A -> bool; P))
    )
  fun(x):
    fun(th):
      let qth = INST_TYPE(PairList [[snd(dest_var(x)), aty]])(pth)
      let ptm = rand(rand(concl(qth)))
      let th_prime = ABS(x)(EQT_INTRO(th))
      let phi = lhand(concl(th_prime))
      let rth = INST(PairList [[phi, ptm]])(qth)
      EQ_MP(rth)(th_prime)

def GENL = itlist(GEN)

fun GEN_ALL(th):
  let [asl, c] = dest_thm(th)
  let vars = subtract(frees(c))(freesl(asl))
  GENL(vars)(th)

def EXISTS_DEF:
  new_basic_definition(
    (hol:
       var #{?} :: (A -> bool) -> bool
       #{?} == (fun (P :: A -> bool): forall q :: bool: (forall x :: A: P(x) ==> q) ==> q))
  )

def mk_exists = mk_binder("?")

fun list_mk_exists([vs, bod]): itlist(curry(mk_exists))(vs)(bod)

def EXISTS:
  let P_5 = hol: var P :: A -> bool; P
  let x_4 = hol: var x :: A; x
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(EXISTS_DEF)(P_5))
  let th2:
    SPEC(hol: var x :: A; x)(
      ASSUME(
        (hol:
           var P :: A -> bool
           var Q :: bool
           forall x :: A: P(x) ==> Q)
      )
    )
  let th3:
    DISCH(
      (hol:
         var P :: A -> bool
         var Q :: bool
         forall x :: A: P(x) ==> Q)
    )(
      MP(th2)(ASSUME(hol:
                       var P :: A -> bool
                       var x :: A
                       P(x)))
    )
  let pth = EQ_MP(SYM(th1))(GEN(hol: var Q :: bool; Q)(th3))
  fun([etm, stm]):
    fun(th):
      try:
        let [qf, abs_3] = dest_comb(etm)
        let bth = BETA_CONV(mk_comb([abs_3, stm]))
        let cth = PINST(PairList [[type_of(stm), aty]])(PairList [[abs_3, P_5], [stm, x_4]])(pth)
        PROVE_HYP(EQ_MP(SYM(bth))(th))(cth)
        ~catch exn:
          match exn
          | Failure(_): failwith("EXISTS")
          | exn: (throw exn)

fun SIMPLE_EXISTS(v): fun(th): EXISTS([mk_exists([v, concl(th)]), v])(th)

def CHOOSE:
  let P_6 = hol: var P :: A -> bool; P
  let Q_4 = hol: var Q :: bool; Q
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(EXISTS_DEF)(P_6))
  let th2 = SPEC(hol: var Q :: bool; Q)(UNDISCH(fst(EQ_IMP_RULE(th1))))
  let pth:
    DISCH_ALL(
      DISCH(
        (hol:
           var P :: A -> bool
           const #{?} :: (A -> bool) -> bool
           #{?}(P))
      )(UNDISCH(th2))
    )
  fun([v, th1]):
    fun(th2):
      try:
        let abs_4 = rand(concl(th1))
        let [bv, bod] = dest_abs(abs_4)
        let cmb = mk_comb([abs_4, v])
        let pat = vsubst(PairList [[v, bv]])(bod)
        let th3 = CONV_RULE(BETA_CONV)(ASSUME(cmb))
        let th4 = GEN(v)(DISCH(cmb)(MP(DISCH(pat)(th2))(th3)))
        let th5 = PINST(PairList [[snd(dest_var(v)), aty]])(PairList [[abs_4, P_6], [concl(th2), Q_4]])(pth)
        MP(MP(th5)(th4))(th1)
        ~catch exn:
          match exn
          | Failure(_): failwith("CHOOSE")
          | exn: (throw exn)

fun SIMPLE_CHOOSE(v): fun(th): CHOOSE([v, ASSUME(mk_exists([v, hd(hyp(th))]))])(th)

def OR_DEF:
  new_basic_definition(
    (hol:
       var #{|\/|} :: bool -> bool -> bool
       #{|\/|} == (fun (p :: bool, q :: bool): forall r :: bool: (p ==> r) ==> (q ==> r) ==> r))
  )

def mk_disj = mk_binary("\\/")

def list_mk_disj = end_itlist(curry(mk_disj))

def DISJ1:
  let P_7 = hol: var P :: bool; P
  let Q_5 = hol: var Q :: bool; Q
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(OR_DEF)(hol: var P :: bool; P))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(hol: var Q :: bool; Q))
  let th3 = MP(ASSUME(hol:
                        var P :: bool
                        var t :: bool
                        P ==> t))(ASSUME(hol: var P :: bool; P))
  let th4:
    GEN(hol: var t :: bool; t)(
      DISCH(hol:
              var P :: bool
              var t :: bool
              P ==> t)(DISCH(hol:
                                                                       var Q :: bool
                                                                       var t :: bool
                                                                       Q ==> t)(th3))
    )
  let pth = EQ_MP(SYM(th2))(th4)
  fun(th):
    fun(tm):
      try:
        EQ_MP(
          DEDUCT_ANTISYM_RULE(th)(INST(PairList [[concl(th), P_7], [tm, Q_5]])(pth))
        )(th)
        ~catch exn:
          match exn
          | Failure(_): failwith("DISJ1")
          | exn: (throw exn)

def DISJ2:
  let P_8 = hol: var P :: bool; P
  let Q_6 = hol: var Q :: bool; Q
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(OR_DEF)(hol: var P :: bool; P))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(hol: var Q :: bool; Q))
  let th3 = MP(ASSUME(hol:
                        var Q :: bool
                        var t :: bool
                        Q ==> t))(ASSUME(hol: var Q :: bool; Q))
  let th4:
    GEN(hol: var t :: bool; t)(
      DISCH(hol:
              var P :: bool
              var t :: bool
              P ==> t)(DISCH(hol:
                                                                       var Q :: bool
                                                                       var t :: bool
                                                                       Q ==> t)(th3))
    )
  let pth = EQ_MP(SYM(th2))(th4)
  fun(tm):
    fun(th):
      try:
        EQ_MP(
          DEDUCT_ANTISYM_RULE(th)(INST(PairList [[tm, P_8], [concl(th), Q_6]])(pth))
        )(th)
        ~catch exn:
          match exn
          | Failure(_): failwith("DISJ2")
          | exn: (throw exn)

def DISJ_CASES:
  let P_9 = hol: var P :: bool; P
  let Q_7 = hol: var Q :: bool; Q
  let R_2 = hol: var R :: bool; R
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(OR_DEF)(hol: var P :: bool; P))
  let th2 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th1)(hol: var Q :: bool; Q))
  let th3 = SPEC(hol: var R :: bool; R)(EQ_MP(th2)(ASSUME(hol:
                                                            var P :: bool
                                                            var Q :: bool
                                                            P || Q)))
  let pth = UNDISCH(UNDISCH(th3))
  fun(th0):
    fun(th1):
      fun(th2):
        try:
          let c1_2 = concl(th1)
          let c2_2 = concl(th2)
          if !aconv(c1_2)(c2_2)
          | failwith("DISJ_CASES")
          | let [l, r] = dest_disj(concl(th0))
            let th = INST(PairList [[l, P_9], [r, Q_7], [c1_2, R_2]])(pth)
            PROVE_HYP(DISCH(r)(th2))(PROVE_HYP(DISCH(l)(th1))(EQ_MP(DEDUCT_ANTISYM_RULE(th0)(th))(th0)))
          ~catch exn:
            match exn
            | Failure(_): failwith("DISJ_CASES")
            | exn: (throw exn)

fun SIMPLE_DISJ_CASES(th1): fun(th2): DISJ_CASES(ASSUME(mk_disj([hd(hyp(th1)), hd(hyp(th2))])))(th1)(th2)

def F_DEF = new_basic_definition(hol:
                                   var F :: bool
                                   F <=> (forall p :: bool: p))

def NOT_DEF:
  new_basic_definition(
    (hol:
       var #{~} :: bool -> bool
       #{~} == (fun (p :: bool): p ==> #false))
  )

def mk_neg:
  let neg_tm = hol: const #{~} :: bool -> bool; #{~}
  fun(tm):
    try:
      mk_comb([neg_tm, tm])
      ~catch exn:
        match exn
        | Failure(_): failwith("mk_neg")
        | exn: (throw exn)

def NOT_ELIM:
  let P = hol: var P :: bool; P
  let pth = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(NOT_DEF)(P))
  fun(th):
    try:
      EQ_MP(INST(PairList [[rand(concl(th)), P]])(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("NOT_ELIM")
        | exn: (throw exn)

def NOT_INTRO:
  let P = hol: var P :: bool; P
  let pth = SYM(CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(NOT_DEF)(P)))
  fun(th):
    try:
      EQ_MP(INST(PairList [[rand(rator(concl(th))), P]])(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("NOT_INTRO")
        | exn: (throw exn)

def EQF_INTRO:
  let P = hol: var P :: bool; P
  let th1_3 = NOT_ELIM(ASSUME(hol:
                                var P :: bool
                                !P))
  let th2_3 = DISCH(hol:
                      #false)(SPEC(P)(EQ_MP(F_DEF)(ASSUME(hol:
                                                                   #false))))
  let pth = DISCH_ALL(IMP_ANTISYM_RULE(th1_3)(th2_3))
  fun(th):
    try:
      MP(INST(PairList [[rand(concl(th)), P]])(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("EQF_INTRO")
        | exn: (throw exn)

def EQF_ELIM:
  let P = hol: var P :: bool; P
  let th1 = EQ_MP(ASSUME(hol:
                           var P :: bool
                           P <=> #false))(ASSUME(hol: var P :: bool; P))
  let th2 = DISCH(P)(SPEC(hol:
                            #false)(EQ_MP(F_DEF)(th1)))
  let pth = DISCH_ALL(NOT_INTRO(th2))
  fun(th):
    try:
      MP(INST(PairList [[rand(rator(concl(th))), P]])(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("EQF_ELIM")
        | exn: (throw exn)

def CONTR:
  let P_10 = hol: var P :: bool; P
  let f_tm_2 = hol:
    #false
  let pth = SPEC(P_10)(EQ_MP(F_DEF)(ASSUME(hol:
                                             #false)))
  fun(tm): fun(th): (if (concl(th) != f_tm_2) | failwith("CONTR") | EQ_MP(DEDUCT_ANTISYM_RULE(th)(INST(PairList [[tm, P_10]])(pth)))(th))

def EXISTS_UNIQUE_DEF:
  new_basic_definition(
    (hol:
       var #{?!} :: (A -> bool) -> bool
       const #{?} :: (A -> bool) -> bool
       #{?!}
         == (fun (P :: A -> bool): #{?}(P) && (forall (x :: A, y :: A): P(x) && P(y) ==> x == y)))
  )

def mk_uexists = mk_binder("?!")

def EXISTENCE:
  let P = hol: var P :: A -> bool; P
  let th1 = CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(EXISTS_UNIQUE_DEF)(P))
  let th2 = UNDISCH(fst(EQ_IMP_RULE(th1)))
  let pth = DISCH_ALL(CONJUNCT1(th2))
  fun(th):
    try:
      let abs_5 = rand(concl(th))
      let ty = snd(dest_var(bndvar(abs_5)))
      MP(PINST(PairList [[ty, aty]])(PairList [[abs_5, P]])(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("EXISTENCE")
        | exn: (throw exn)

fun set_verbose_symbols(_):
  do_list(Host.parse_as_binder)(PairList ["forall", "exists", "existsunique"])
  Host.override_interface(["true", (hol:
                                      #true)])
  Host.override_interface(["false", (hol:
                                       #false)])
  Host.override_interface(["forall", (hol: const #{!} :: (A -> bool) -> bool; const.#{!})])
  Host.override_interface(["exists", (hol: const #{?} :: (A -> bool) -> bool; #{?})])
  Host.override_interface(["existsunique", (hol: const #{?!} :: (A -> bool) -> bool; #{?!})])

fun unset_verbose_symbols(_):
  do_list(Host.unparse_as_binder)(PairList ["forall", "exists", "existsunique"])
  do_list(Host.remove_interface)(PairList ["true", "false", "forall", "exists", "existsunique"])

set_verbose_symbols(#void)
