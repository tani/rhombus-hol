  let pth3 = Fusion.DEDUCT_ANTISYM_RULE(UNDISCH(pth2))(UNDISCH(pth1))
  let pth4_2 = DISCH_ALL(Fusion.ASSUME(q_5))
  let pth5_2 = Fusion.ASSUME(Fusion.mk_eq([p_5, q_5]))
  let pth6 = CONJ(Fusion.EQ_MP(Equal.SYM(Equal.AP_THM(Equal.AP_TERM(imp_tm_2)(pth5_2))(q_5)))(pth4_2))(Fusion.EQ_MP(Equal.SYM(Equal.AP_TERM(Fusion.mk_comb([imp_tm_2, q_5]))(pth5_2)))(pth4_2))
  let pth = Fusion.DEDUCT_ANTISYM_RULE(pth6)(pth3)
