fun is_iff(tm):«
  (block:«
    let port_tmp_1 = tm;
    match port_tmp_1
    | Fusion.Comb(Fusion.Comb(Fusion.Const("=",Fusion.Tyapp("fun",PairList [Fusion.Tyapp("bool",PairList []), & PairList [_, & PairList []]])),l),r):«
        #true
    »
    | _:«
        #false
    »
  »)
»

fun dest_iff(tm):«
  (block:«
    let port_tmp_2 = tm;
    match port_tmp_2
    | Fusion.Comb(Fusion.Comb(Fusion.Const("=",Fusion.Tyapp("fun",PairList [Fusion.Tyapp("bool",PairList []), & PairList [_, & PairList []]])),l),r):«
        Pair(l,r)
    »
    | _:«
        failwith("dest_iff")
    »
  »)
»

def mk_iff:«
  (block:«
    let eq_tm:«
      Host.expand_quote("[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]]")
    »;
    (fun(Pair(l,r)):«
      Fusion.mk_comb(Pair(Fusion.mk_comb(Pair(eq_tm,l)),r))
    »)
  »)
»

fun PINST(tyin):«
  (fun(tmin):«
    (block:«
      let port_tmp_3_iterm_fn:«
        Fusion.INST(map(Host.F_F(I)(Fusion.inst(tyin)))(tmin))
      »;
      let port_tmp_4_itype_fn:«
        Fusion.INST_TYPE(tyin)
      »;
      (fun(th):«
        (block:«
          try:«
            port_tmp_3_iterm_fn(port_tmp_4_itype_fn(th));
            ~catch port_tmp_5:«
              let port_tmp_6 = port_tmp_5;
              match port_tmp_6
              | Failure(_):«
                  failwith("PINST")
              »
              | port_tmp_5:«
                  Host.hol_raise(port_tmp_5)
              »
            »
          »
        »)
      »)
    »)
  »)
»

fun PROVE_HYP(ath):«
  (fun(bth):«
    (block:«
      if (block:«
        let port_tmp_7 = Fusion.hyp(bth);
        let port_tmp_8 = Fusion.aconv(Fusion.concl(ath));
        exists(port_tmp_8)(port_tmp_7)
      »)
      | Fusion.EQ_MP(Fusion.DEDUCT_ANTISYM_RULE(ath)(bth))(ath)
      | bth
    »)
  »)
»

