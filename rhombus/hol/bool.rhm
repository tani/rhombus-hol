def EQ_IMP_RULE:
  let peq = Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"q\",[\"Tyapp\",\"bool\",[]]]]")
