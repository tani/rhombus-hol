def EQF_INTRO:
  let P = Host.expand_quote("[\"Var\",\"P\",[\"Tyapp\",\"bool\",[]]]")
  let th1_3 = NOT_ELIM(Fusion.ASSUME(Host.expand_quote("[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"P\",[\"Tyapp\",\"bool\",[]]]]")))
  let th2_3 = DISCH(Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]"))(SPEC(P)(Fusion.EQ_MP(F_DEF)(Fusion.ASSUME(Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]")))))
  let pth = DISCH_ALL(IMP_ANTISYM_RULE(th1_3)(th2_3))
  fun(th):
    try:
      MP(Fusion.INST(PairList.cons([Fusion.rand(Fusion.concl(th)), P], PairList []))(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("EQF_INTRO")
        | exn: Host.hol_raise(exn)

def EQF_ELIM:
  let P = Host.expand_quote("[\"Var\",\"P\",[\"Tyapp\",\"bool\",[]]]")
  let th1 = Fusion.EQ_MP(Fusion.ASSUME(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"P\",[\"Tyapp\",\"bool\",[]]]],[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]]")))(Fusion.ASSUME(Host.expand_quote("[\"Var\",\"P\",[\"Tyapp\",\"bool\",[]]]")))
  let th2 = DISCH(P)(SPEC(Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]"))(Fusion.EQ_MP(F_DEF)(th1)))
  let pth = DISCH_ALL(NOT_INTRO(th2))
  fun(th):
    try:
      MP(Fusion.INST(PairList.cons([Fusion.rand(Fusion.rator(Fusion.concl(th))), P], PairList []))(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("EQF_ELIM")
        | exn: Host.hol_raise(exn)

def CONTR:
  let P_10 = Host.expand_quote("[\"Var\",\"P\",[\"Tyapp\",\"bool\",[]]]")
  let f_tm_2 = Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]")
  let pth = SPEC(P_10)(Fusion.EQ_MP(F_DEF)(Fusion.ASSUME(Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]"))))
  (fun(tm): (fun(th): (if Host.hol_unequal(Fusion.concl(th))(f_tm_2) | failwith("CONTR") | Fusion.EQ_MP(Fusion.DEDUCT_ANTISYM_RULE(th)(Fusion.INST(PairList.cons([tm, P_10], PairList []))(pth)))(th))))

def EXISTS_UNIQUE_DEF = Fusion.new_basic_definition(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"?!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]]],[\"Abs\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"y\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]]]]]]]]]"))

def mk_uexists = Basics.mk_binder("?!")

def EXISTENCE:
  let P = Host.expand_quote("[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]")
  let th1 = Equal.CONV_RULE(Equal.RAND_CONV(Equal.BETA_CONV))(Equal.AP_THM(EXISTS_UNIQUE_DEF)(P))
  let th2 = UNDISCH(fst(EQ_IMP_RULE(th1)))
  let pth = DISCH_ALL(CONJUNCT1(th2))
  fun(th):
    try:
      let abs_5 = Fusion.rand(Fusion.concl(th))
      let ty = snd(Fusion.dest_var(Basics.bndvar(abs_5)))
      MP(PINST(PairList.cons([ty, Fusion.aty], PairList []))(PairList.cons([abs_5, P], PairList []))(pth))(th)
      ~catch exn:
        match exn
        | Failure(_): failwith("EXISTENCE")
        | exn: Host.hol_raise(exn)

fun set_verbose_symbols(_):
  Host.do_list(Host.parse_as_binder)(PairList.cons("forall", PairList.cons("exists", PairList.cons("existsunique", PairList []))))
  Host.override_interface(["true", Host.expand_quote("[\"Const\",\"T\",[\"Tyapp\",\"bool\",[]]]")])
  Host.override_interface(["false", Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]")])
  Host.override_interface(["forall", Host.expand_quote("[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]]")])
  Host.override_interface(["exists", Host.expand_quote("[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]]")])
  Host.override_interface(["existsunique", Host.expand_quote("[\"Const\",\"?!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]]")])

fun unset_verbose_symbols(_):
  Host.do_list(Host.unparse_as_binder)(PairList.cons("forall", PairList.cons("exists", PairList.cons("existsunique", PairList []))))
  Host.do_list(Host.remove_interface)(PairList.cons("true", PairList.cons("false", PairList.cons("forall", PairList.cons("exists", PairList.cons("existsunique", PairList []))))))

Host.hol_apply_unit(set_verbose_symbols)
