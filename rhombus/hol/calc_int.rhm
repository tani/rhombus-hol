fun is_realintconst(tm):
  match tm
  | Comb(Const("real_of_num",_),n): is_numeral(n)
  | Comb(Const("real_neg",_),Comb(Const("real_of_num",_),n)): (is_numeral(n) && !(dest_numeral(n) == num_0))
  | _: #false

fun dest_realintconst(tm):
  match tm
  | Comb(Const("real_of_num",_),n): dest_numeral(n)
  | Comb(Const("real_neg",_),Comb(Const("real_of_num",_),n)):
      let nn = dest_numeral(n)
      (if (nn != num_0) | minus_num(dest_numeral(n)) | failwith("dest_realintconst"))
  | _: failwith("dest_realintconst")

def mk_realintconst:
  let cast_tm = @hol|{real_of_num}|
  let neg_tm = @hol|{(--)}|
  let mk_numconst = (fun(n): mk_comb([cast_tm, mk_numeral(n)]))
  (fun(x): (if (x < num_0) | mk_comb([neg_tm, mk_numconst(minus_num(x))]) | mk_numconst(x)))

fun is_ratconst(tm):
  match tm
  | Comb(Comb(Const("real_div",_),p),q):
      if is_realintconst(p)
      | if is_realintconst(q)
        | let m = dest_realintconst(p)
          let n = dest_realintconst(q)
          ((n > num_1) && (gcd_num(m)(n) == num_1))
        | #false
      | #false
  | _: is_realintconst(tm)

fun rat_of_term(tm):
  match tm
  | Comb(Comb(Const("real_div",_),p),q):
      let m = dest_realintconst(p)
      let n = dest_realintconst(q)
      (if ((n > num_1) && (gcd_num(m)(n) == num_1)) | (m / n) | failwith("rat_of_term"))
  | _: dest_realintconst(tm)

def term_of_rat:
  let div_tm = @hol|{(/)}|
  fun(x):
    let [p, q] = numdom(x)
    let ptm = mk_realintconst(p)
    (if (q == num_1) | ptm | mk_comb([mk_comb([div_tm, ptm]), mk_realintconst(q)]))

def REAL_ADD_AC:
  prove(
    [
      @hol|{(m + n = n + m) /\
         ((m + n) + p = m + (n + p)) /\
         (m + (n + p) = n + (m + p))}|,
      MESON_TAC(PairList [REAL_ADD_ASSOC, REAL_ADD_SYM])
    ]
  )

def REAL_ADD_RINV:
  prove(
    [
      @hol|{!x. x + --x = &0}|,
      MESON_TAC(PairList [REAL_ADD_SYM, REAL_ADD_LINV])
    ]
  )

def REAL_EQ_ADD_LCANCEL:
  prove(
    [
      @hol|{!x y z. (x + y = x + z) <=> (y = z)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      POP_ASSUM(
        o(MP_TAC)(
          AP_TERM(
            @hol|{(+) (--x)}|
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList [REAL_ADD_ASSOC, REAL_ADD_LINV, REAL_ADD_LID])
    ]
  )

def REAL_EQ_ADD_RCANCEL:
  prove(
    [
      @hol|{!x y z. (x + z = y + z) <=> (x = y)}|,
      MESON_TAC(PairList [REAL_ADD_SYM, REAL_EQ_ADD_LCANCEL])
    ]
  )

def REAL_MUL_RZERO:
  prove(
    [
      @hol|{!x. x * &0 = &0}|,
      MESON_TAC(PairList [REAL_EQ_ADD_RCANCEL, REAL_ADD_LDISTRIB, REAL_ADD_LID])
    ]
  )

def REAL_MUL_LZERO:
  prove(
    [
      @hol|{!x. &0 * x = &0}|,
      MESON_TAC(PairList [REAL_MUL_SYM, REAL_MUL_RZERO])
    ]
  )

def REAL_NEG_NEG:
  prove(
    [
      @hol|{!x. --(--x) = x}|,
      MESON_TAC(
        PairList [REAL_EQ_ADD_RCANCEL, REAL_ADD_LINV, REAL_ADD_SYM, REAL_ADD_LINV]
      )
    ]
  )

def REAL_MUL_RNEG:
  prove(
    [
      @hol|{!x y. x * (--y) = -- (x * y)}|,
      MESON_TAC(PairList [REAL_EQ_ADD_RCANCEL, REAL_ADD_LDISTRIB, REAL_ADD_LINV, REAL_MUL_RZERO])
    ]
  )

def REAL_MUL_LNEG:
  prove(
    [
      @hol|{!x y. (--x) * y = -- (x * y)}|,
      MESON_TAC(PairList [REAL_MUL_SYM, REAL_MUL_RNEG])
    ]
  )

def REAL_NEG_ADD:
  prove(
    [
      @hol|{!x y. --(x + y) = --x + --y}|,
      REPEAT(GEN_TAC) then_tac \
      MATCH_MP_TAC(GEN_ALL(fst(EQ_IMP_RULE(SPEC_ALL(REAL_EQ_ADD_RCANCEL))))) then_tac \
      EXISTS_TAC(
        @hol|{x + y}|
      ) then_tac \
      REWRITE_TAC(PairList [REAL_ADD_LINV]) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          AC(REAL_ADD_AC)(
            @hol|{(a + b) + (c + d) = (a + c) + (b + d)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REAL_ADD_LINV, REAL_ADD_LID])
    ]
  )

def REAL_ADD_RID:
  prove(
    [
      @hol|{!x. x + &0 = x}|,
      MESON_TAC(PairList [REAL_ADD_SYM, REAL_ADD_LID])
    ]
  )

def REAL_NEG_0:
  prove(
    [
      @hol|{--(&0) = &0}|,
      MESON_TAC(PairList [REAL_ADD_LINV, REAL_ADD_RID])
    ]
  )

def REAL_LE_LNEG:
  prove(
    [
      @hol|{!x y. --x <= y <=> &0 <= x + y}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(REAL_LE_LADD_IMP))) then_list \
      PairList [
        DISCH_THEN(o(MP_TAC)(SPEC(@hol|{x:real}|))) then_tac \
        REWRITE_TAC(PairList [ONCE_REWRITE_RULE(PairList [REAL_ADD_SYM])(REAL_ADD_LINV)]),
        DISCH_THEN(
          o(MP_TAC)(SPEC(@hol|{--x}|))
        ) then_tac \
        REWRITE_TAC(
          PairList [
            REAL_ADD_LINV,
            REAL_ADD_ASSOC,
            REAL_ADD_LID,
            ONCE_REWRITE_RULE(PairList [REAL_ADD_SYM])(REAL_ADD_LID)
          ]
        )
      ]
    ]
  )

def REAL_LE_NEG2:
  prove(
    [
      @hol|{!x y. --x <= --y <=> y <= x}|,
      REPEAT(GEN_TAC) then_tac \
      GEN_REWRITE_TAC(o(RAND_CONV)(LAND_CONV))(PairList [GSYM(REAL_NEG_NEG)]) then_tac \
      REWRITE_TAC(PairList [REAL_LE_LNEG]) then_tac \
      AP_TERM_TAC then_tac \
      MATCH_ACCEPT_TAC(REAL_ADD_SYM)
    ]
  )

def REAL_LE_RNEG:
  prove(
    [
      @hol|{!x y. x <= --y <=> x + y <= &0}|,
      REPEAT(GEN_TAC) then_tac \
      GEN_REWRITE_TAC(o(LAND_CONV)(LAND_CONV))(PairList [GSYM(REAL_NEG_NEG)]) then_tac \
      REWRITE_TAC(PairList [REAL_LE_LNEG, GSYM(REAL_NEG_ADD)]) then_tac \
      GEN_REWRITE_TAC(RAND_CONV)(PairList [GSYM(REAL_LE_NEG2)]) then_tac \
      AP_THM_TAC then_tac \
      AP_TERM_TAC then_tac \
      REWRITE_TAC(PairList [GSYM(REAL_ADD_LINV)]) then_tac \
      REWRITE_TAC(PairList [REAL_NEG_ADD, REAL_NEG_NEG]) then_tac \
      MATCH_ACCEPT_TAC(REAL_ADD_SYM)
    ]
  )

def REAL_OF_NUM_POW:
  prove(
    [
      @hol|{!x n. (&x) pow n = &(x EXP n)}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [real_pow, EXP, REAL_OF_NUM_MUL])
    ]
  )

def REAL_POW_NEG:
  prove(
    [
      @hol|{!x n. (--x) pow n = if EVEN n then x pow n else --(x pow n)}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [real_pow, EVEN]) then_tac \
      ASM_CASES_TAC(@hol|{EVEN n}|) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_MUL_RNEG, REAL_MUL_LNEG, REAL_NEG_NEG])
    ]
  )

def REAL_ABS_NUM:
  prove(
    [
      @hol|{!n. abs(&n) = &n}|,
      REWRITE_TAC(PairList [real_abs, REAL_OF_NUM_LE, LE_0])
    ]
  )

def REAL_ABS_NEG:
  prove(
    [
      @hol|{!x. abs(--x) = abs x}|,
      REWRITE_TAC(PairList [real_abs, REAL_LE_RNEG, REAL_NEG_NEG, REAL_ADD_LID]) then_tac \
      MESON_TAC(PairList [REAL_LE_TOTAL, REAL_LE_ANTISYM, REAL_NEG_0])
    ]
  )

def [calc_int_REAL_INT_LE_CONV_v2, calc_int_REAL_INT_LT_CONV_v2, calc_int_REAL_INT_GE_CONV_v2, calc_int_REAL_INT_GT_CONV_v2, REAL_INT_EQ_CONV]:
  let tth:
    TAUT(
      @hol|{(F /\ F <=> F) /\ (F /\ T <=> F) /\
         (T /\ F <=> F) /\ (T /\ T <=> T)}|
    )
  let nth = TAUT(@hol|{(~T <=> F) /\ (~F <=> T)}|)
  let NUM2_EQ_CONV = (BINOP_CONV(NUM_EQ_CONV) then_conv GEN_REWRITE_CONV(I)(PairList [tth]))
  let NUM2_NE_CONV = (RAND_CONV(NUM2_EQ_CONV) then_conv GEN_REWRITE_CONV(I)(PairList [nth]))
  let PairList [pth_le1, & PairList [pth_le2a, & PairList [pth_le2b, & PairList [pth_le3, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{(--(&m) <= &n <=> T) /\
           (&m <= &n <=> m <= n) /\
           (--(&m) <= --(&n) <=> n <= m) /\
           (&m <= --(&n) <=> (m = 0) /\ (n = 0))}|,
        REWRITE_TAC(PairList [REAL_LE_NEG2]) then_tac \
        REWRITE_TAC(PairList [REAL_LE_LNEG, REAL_LE_RNEG]) then_tac \
        REWRITE_TAC(PairList [REAL_OF_NUM_ADD, REAL_OF_NUM_LE, LE_0]) then_tac \
        REWRITE_TAC(PairList [LE, ADD_EQ_0])
      ]
    )
  let REAL_INT_LE_CONV:
    FIRST_CONV(
      PairList [
        GEN_REWRITE_CONV(I)(PairList [pth_le1]),
        GEN_REWRITE_CONV(I)(PairList [pth_le2a, pth_le2b]) then_conv NUM_LE_CONV,
        GEN_REWRITE_CONV(I)(PairList [pth_le3]) then_conv NUM2_EQ_CONV
      ]
    )
  let PairList [pth_lt1, & PairList [pth_lt2a, & PairList [pth_lt2b, & PairList [pth_lt3, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{(&m < --(&n) <=> F) /\
           (&m < &n <=> m < n) /\
           (--(&m) < --(&n) <=> n < m) /\
           (--(&m) < &n <=> ~((m = 0) /\ (n = 0)))}|,
        REWRITE_TAC(PairList [pth_le1, pth_le2a, pth_le2b, pth_le3, GSYM(NOT_LE), real_lt]) then_tac \
        CONV_TAC(TAUT)
      ]
    )
  let REAL_INT_LT_CONV:
    FIRST_CONV(
      PairList [
        GEN_REWRITE_CONV(I)(PairList [pth_lt1]),
        GEN_REWRITE_CONV(I)(PairList [pth_lt2a, pth_lt2b]) then_conv NUM_LT_CONV,
        GEN_REWRITE_CONV(I)(PairList [pth_lt3]) then_conv NUM2_NE_CONV
      ]
    )
  let PairList [pth_ge1, & PairList [pth_ge2a, & PairList [pth_ge2b, & PairList [pth_ge3, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{(&m >= --(&n) <=> T) /\
           (&m >= &n <=> n <= m) /\
           (--(&m) >= --(&n) <=> m <= n) /\
           (--(&m) >= &n <=> (m = 0) /\ (n = 0))}|,
        REWRITE_TAC(PairList [pth_le1, pth_le2a, pth_le2b, pth_le3, real_ge]) then_tac \
        CONV_TAC(TAUT)
      ]
    )
  let REAL_INT_GE_CONV:
    FIRST_CONV(
      PairList [
        GEN_REWRITE_CONV(I)(PairList [pth_ge1]),
        GEN_REWRITE_CONV(I)(PairList [pth_ge2a, pth_ge2b]) then_conv NUM_LE_CONV,
        GEN_REWRITE_CONV(I)(PairList [pth_ge3]) then_conv NUM2_EQ_CONV
      ]
    )
  let PairList [pth_gt1, & PairList [pth_gt2a, & PairList [pth_gt2b, & PairList [pth_gt3, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{(--(&m) > &n <=> F) /\
           (&m > &n <=> n < m) /\
           (--(&m) > --(&n) <=> m < n) /\
           (&m > --(&n) <=> ~((m = 0) /\ (n = 0)))}|,
        REWRITE_TAC(PairList [pth_lt1, pth_lt2a, pth_lt2b, pth_lt3, real_gt]) then_tac \
        CONV_TAC(TAUT)
      ]
    )
  let REAL_INT_GT_CONV:
    FIRST_CONV(
      PairList [
        GEN_REWRITE_CONV(I)(PairList [pth_gt1]),
        GEN_REWRITE_CONV(I)(PairList [pth_gt2a, pth_gt2b]) then_conv NUM_LT_CONV,
        GEN_REWRITE_CONV(I)(PairList [pth_gt3]) then_conv NUM2_NE_CONV
      ]
    )
  let PairList [pth_eq1a, & PairList [pth_eq1b, & PairList [pth_eq2a, & PairList [pth_eq2b, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{((&m = &n) <=> (m = n)) /\
           ((--(&m) = --(&n)) <=> (m = n)) /\
           ((--(&m) = &n) <=> (m = 0) /\ (n = 0)) /\
           ((&m = --(&n)) <=> (m = 0) /\ (n = 0))}|,
        REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM), GSYM(LE_ANTISYM)]) then_tac \
        REWRITE_TAC(PairList [pth_le1, pth_le2a, pth_le2b, pth_le3, LE, LE_0]) then_tac \
        CONV_TAC(TAUT)
      ]
    )
  let REAL_INT_EQ_CONV:
    FIRST_CONV(
      PairList [
        GEN_REWRITE_CONV(I)(PairList [pth_eq1a, pth_eq1b]) then_conv NUM_EQ_CONV,
        GEN_REWRITE_CONV(I)(PairList [pth_eq2a, pth_eq2b]) then_conv NUM2_EQ_CONV
      ]
    )
  [REAL_INT_LE_CONV, REAL_INT_LT_CONV, REAL_INT_GE_CONV, REAL_INT_GT_CONV, REAL_INT_EQ_CONV]

def REAL_INT_NEG_CONV:
  let pth:
    prove(
      [
        @hol|{(--(&0) = &0) /\
           (--(--(&x)) = &x)}|,
        REWRITE_TAC(PairList [REAL_NEG_NEG, REAL_NEG_0])
      ]
    )
  GEN_REWRITE_CONV(I)(PairList [pth])

def REAL_INT_MUL_CONV:
  let pth0:
    prove(
      [
        @hol|{(&0 * &x = &0) /\
           (&0 * --(&x) = &0) /\
           (&x * &0 = &0) /\
           (--(&x) * &0 = &0)}|,
        REWRITE_TAC(PairList [REAL_MUL_LZERO, REAL_MUL_RZERO])
      ]
    )
  let [pth1, pth2]:
    o(CONJ_PAIR)(prove)(
      [
        @hol|{((&m * &n = &(m * n)) /\
            (--(&m) * --(&n) = &(m * n))) /\
           ((--(&m) * &n = --(&(m * n))) /\
            (&m * --(&n) = --(&(m * n))))}|,
        REWRITE_TAC(PairList [REAL_MUL_LNEG, REAL_MUL_RNEG, REAL_NEG_NEG]) then_tac \
        REWRITE_TAC(PairList [REAL_OF_NUM_MUL])
      ]
    )
  FIRST_CONV(
    PairList [
      GEN_REWRITE_CONV(I)(PairList [pth0]),
      GEN_REWRITE_CONV(I)(PairList [pth1]) then_conv RAND_CONV(NUM_MULT_CONV),
      GEN_REWRITE_CONV(I)(PairList [pth2]) then_conv \
      RAND_CONV(RAND_CONV(NUM_MULT_CONV))
    ]
  )

def REAL_INT_ADD_CONV:
  let neg_tm = @hol|{(--)}|
  let amp_tm = @hol|{&}|
  let add_tm = @hol|{(+)}|
  let dest = dest_binop(@hol|{(+)}|)
  let m_tm = @hol|{m:num}|
  let n_tm = @hol|{n:num}|
  let pth0:
    prove(
      [
        @hol|{(--(&m) + &m = &0) /\
           (&m + --(&m) = &0)}|,
        REWRITE_TAC(PairList [REAL_ADD_LINV, REAL_ADD_RINV])
      ]
    )
  let PairList [pth1, & PairList [pth2, & PairList [pth3, & PairList [pth4, & PairList [pth5, & PairList [pth6, & PairList []]]]]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{(--(&m) + --(&n) = --(&(m + n))) /\
           (--(&m) + &(m + n) = &n) /\
           (--(&(m + n)) + &m = --(&n)) /\
           (&(m + n) + --(&m) = &n) /\
           (&m + --(&(m + n)) = --(&n)) /\
           (&m + &n = &(m + n))}|,
        REWRITE_TAC(PairList [GSYM(REAL_OF_NUM_ADD), REAL_NEG_ADD]) then_tac \
        REWRITE_TAC(PairList [REAL_ADD_ASSOC, REAL_ADD_LINV, REAL_ADD_LID]) then_tac \
        REWRITE_TAC(PairList [REAL_ADD_RINV, REAL_ADD_LID]) then_tac \
        ONCE_REWRITE_TAC(PairList [REAL_ADD_SYM]) then_tac \
        REWRITE_TAC(PairList [REAL_ADD_ASSOC, REAL_ADD_LINV, REAL_ADD_LID]) then_tac \
        REWRITE_TAC(PairList [REAL_ADD_RINV, REAL_ADD_LID])
      ]
    )
  (
    GEN_REWRITE_CONV(I)(PairList [pth0]) or_conv \
    (
      fun(tm):
        try:
          let [l, r] = dest(tm)
          if (!is_realintconst(l) || !is_realintconst(r))
          | failwith("")
          | if (rator(l) == neg_tm)
            | if (rator(r) == neg_tm)
              | let th1 = INST(PairList [[rand(rand(l)), m_tm], [rand(rand(r)), n_tm]])(pth1)
                let tm1 = rand(rand(rand(concl(th1))))
                let th2 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(NUM_ADD_CONV(tm1)))
                TRANS(th1)(th2)
              | let m = rand(rand(l))
                let n = rand(r)
                let m_prime = dest_numeral(m)
                let n_prime = dest_numeral(n)
                if (m_prime <= n_prime)
                | let p = mk_numeral((n_prime - m_prime))
                  let th1 = INST(PairList [[m, m_tm], [p, n_tm]])(pth2)
                  let th2 = NUM_ADD_CONV(rand(rand(lhand(concl(th1)))))
                  let th3 = AP_TERM(rator(tm))(AP_TERM(amp_tm)(SYM(th2)))
                  TRANS(th3)(th1)
                | let p = mk_numeral((m_prime - n_prime))
                  let th1 = INST(PairList [[n, m_tm], [p, n_tm]])(pth3)
                  let th2 = NUM_ADD_CONV(rand(rand(lhand(lhand(concl(th1))))))
                  let th3 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_THM(AP_TERM(add_tm)(th3))(rand(tm))
                  TRANS(th4)(th1)
            | if (rator(r) == neg_tm)
              | let m = rand(l)
                let n = rand(rand(r))
                let m_prime = dest_numeral(m)
                let n_prime = dest_numeral(n)
                if (n_prime <= m_prime)
                | let p = mk_numeral((m_prime - n_prime))
                  let th1 = INST(PairList [[n, m_tm], [p, n_tm]])(pth4)
                  let th2 = NUM_ADD_CONV(rand(lhand(lhand(concl(th1)))))
                  let th3 = AP_TERM(add_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_THM(th3)(rand(tm))
                  TRANS(th4)(th1)
                | let p = mk_numeral((n_prime - m_prime))
                  let th1 = INST(PairList [[m, m_tm], [p, n_tm]])(pth5)
                  let th2 = NUM_ADD_CONV(rand(rand(rand(lhand(concl(th1))))))
                  let th3 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_TERM(rator(tm))(th3)
                  TRANS(th4)(th1)
              | let th1 = INST(PairList [[rand(l), m_tm], [rand(r), n_tm]])(pth6)
                let tm1 = rand(rand(concl(th1)))
                let th2 = AP_TERM(amp_tm)(NUM_ADD_CONV(tm1))
                TRANS(th1)(th2)
          ~catch exn:
            match exn
            | Failure(_): failwith("REAL_INT_ADD_CONV")
            | exn: (throw exn)
    )
  )

def REAL_INT_SUB_CONV:
  (
    GEN_REWRITE_CONV(I)(PairList [real_sub]) then_conv \
    TRY_CONV(RAND_CONV(REAL_INT_NEG_CONV)) then_conv \
    REAL_INT_ADD_CONV
  )

def REAL_INT_POW_CONV:
  let [pth1, pth2]:
    o(CONJ_PAIR)(prove)(
      [
        @hol|{(&x pow n = &(x EXP n)) /\
           ((--(&x)) pow n = if EVEN n then &(x EXP n) else --(&(x EXP n)))}|,
        REWRITE_TAC(PairList [REAL_OF_NUM_POW, REAL_POW_NEG])
      ]
    )
  let tth:
    prove(
      [
        @hol|{((if T then x:real else y) = x) /\ ((if F then x:real else y) = y)}|,
        REWRITE_TAC(PairList [])
      ]
    )
  let neg_tm = @hol|{(--)}|
  (
    GEN_REWRITE_CONV(I)(PairList [pth1]) then_conv RAND_CONV(NUM_EXP_CONV) or_conv \
    (
      GEN_REWRITE_CONV(I)(PairList [pth2]) then_conv \
      RATOR_CONV(RATOR_CONV(RAND_CONV(NUM_EVEN_CONV))) then_conv \
      GEN_REWRITE_CONV(I)(PairList [tth]) then_conv \
      (fun(tm): (if (rator(tm) == neg_tm) | RAND_CONV(RAND_CONV(NUM_EXP_CONV))(tm) | RAND_CONV(NUM_EXP_CONV)(tm)))
    )
  )

def REAL_INT_ABS_CONV:
  let pth:
    prove(
      [
        @hol|{(abs(--(&x)) = &x) /\
           (abs(&x) = &x)}|,
        REWRITE_TAC(PairList [REAL_ABS_NEG, REAL_ABS_NUM])
      ]
    )
  GEN_REWRITE_CONV(I)(PairList [pth])

def real_int_red_conv_list:
  PairList [
    [
      @hol|{x <= y}|,
      calc_int_REAL_INT_LE_CONV_v2
    ],
    [
      @hol|{x < y}|,
      calc_int_REAL_INT_LT_CONV_v2
    ],
    [
      @hol|{x >= y}|,
      calc_int_REAL_INT_GE_CONV_v2
    ],
    [
      @hol|{x > y}|,
      calc_int_REAL_INT_GT_CONV_v2
    ],
    [@hol|{x:real = y}|, REAL_INT_EQ_CONV],
    [
      @hol|{--x}|,
      CHANGED_CONV(REAL_INT_NEG_CONV)
    ],
    [@hol|{abs(x)}|, REAL_INT_ABS_CONV],
    [
      @hol|{x + y}|,
      REAL_INT_ADD_CONV
    ],
    [
      @hol|{x - y}|,
      REAL_INT_SUB_CONV
    ],
    [
      @hol|{x * y}|,
      REAL_INT_MUL_CONV
    ],
    [
      @hol|{x pow n}|,
      REAL_INT_POW_CONV
    ]
  ]

def REAL_INT_RED_CONV:
  let gconv_net = itlist(uncurry(net_of_conv))(real_int_red_conv_list)(basic_net(#void))
  REWRITES_CONV(gconv_net)

def REAL_INT_REDUCE_CONV = DEPTH_CONV(REAL_INT_RED_CONV)

def real_int_compute_add_convs:
  let convlist:
    map(
      fun([pat, the_conv]):
        let [c, args] = strip_comb(pat)
        [c, length(args), the_conv]
    )(real_int_red_conv_list)
  (fun(compset): itlist(fun(newc): fun(_): Compute.Compute.add_conv(newc)(compset))(convlist)(#void))

def REAL_INT_COMPUTE_CONV:
  let cs = Compute.Compute.bool_compset(#void)
  Compute.Compute.set_skip(cs)(@hol|{COND: bool -> A -> A -> A}|)(Some(1))
  real_int_compute_add_convs(cs)
  Compute.Compute.WEAK_CBV_CONV(cs)

def REAL_INT_LE_CONV = calc_int_REAL_INT_LE_CONV_v2

def REAL_INT_LT_CONV = calc_int_REAL_INT_LT_CONV_v2

def REAL_INT_GE_CONV = calc_int_REAL_INT_GE_CONV_v2

def REAL_INT_GT_CONV = calc_int_REAL_INT_GT_CONV_v2
