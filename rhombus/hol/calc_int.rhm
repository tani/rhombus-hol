fun calc_int_is_realintconst(tm):«
  (block:«
    let port_tmp_1 = tm;
    match port_tmp_1
    | Up_fusion.Comb(Up_fusion.Const("real_of_num",_),n):«
        Up_nums.is_numeral(n)
    »
    | Up_fusion.Comb(Up_fusion.Const("real_neg",_),Up_fusion.Comb(Up_fusion.Const("real_of_num",_),n)):«
        (Up_nums.is_numeral(n) && Host.hol_not(Host.hol_equal(Up_basics.dest_numeral(n))(Host.num_0)))
    »
    | _:«
        #false
    »
  »)
»

fun calc_int_dest_realintconst(tm):«
  (block:«
    let port_tmp_2 = tm;
    match port_tmp_2
    | Up_fusion.Comb(Up_fusion.Const("real_of_num",_),n):«
        Up_basics.dest_numeral(n)
    »
    | Up_fusion.Comb(Up_fusion.Const("real_neg",_),Up_fusion.Comb(Up_fusion.Const("real_of_num",_),n)):«
        (block:«
          let nn:«
            Up_basics.dest_numeral(n)
          »;
          (block:«
            if Host.hol_unequal(nn)(Host.num_0)
            | Host.minus_num(Up_basics.dest_numeral(n))
            | failwith("dest_realintconst")
          »)
        »)
    »
    | _:«
        failwith("dest_realintconst")
    »
  »)
»

def calc_int_mk_realintconst:«
  (block:«
    let port_tmp_3_cast_tm:«
      Host.expand_quote("[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]]")
    »;
    let port_tmp_4_neg_tm:«
      Host.expand_quote("[\"Const\",\"real_neg\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]]")
    »;
    (block:«
      let mk_numconst:«
        (fun(n):«
          Up_fusion.mk_comb(Pair(port_tmp_3_cast_tm,Up_nums.mk_numeral(n)))
        »)
      »;
      (fun(x):«
        (block:«
          if Host.hol_lt(x)(Host.num_0)
          | Up_fusion.mk_comb(Pair(port_tmp_4_neg_tm,mk_numconst(Host.minus_num(x))))
          | mk_numconst(x)
        »)
      »)
    »)
  »)
»

fun calc_int_is_ratconst(tm):«
  (block:«
    let port_tmp_5 = tm;
    match port_tmp_5
    | Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("real_div",_),p),q):«
        (calc_int_is_realintconst(p) && (calc_int_is_realintconst(q) && (block:«
          let port_tmp_6_m:«
            calc_int_dest_realintconst(p)
          »;
          let port_tmp_7_n:«
            calc_int_dest_realintconst(q)
          »;
          (Host.hol_gt(port_tmp_7_n)(Host.num_1) && Host.hol_equal(Host.gcd_num(port_tmp_6_m)(port_tmp_7_n))(Host.num_1))
        »)))
    »
    | _:«
        calc_int_is_realintconst(tm)
    »
  »)
»

fun calc_int_rat_of_term(tm):«
  (block:«
    let port_tmp_8 = tm;
    match port_tmp_8
    | Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("real_div",_),p),q):«
        (block:«
          let port_tmp_9_m:«
            calc_int_dest_realintconst(p)
          »;
          let port_tmp_10_n:«
            calc_int_dest_realintconst(q)
          »;
          (block:«
            if (Host.hol_gt(port_tmp_10_n)(Host.num_1) && Host.hol_equal(Host.gcd_num(port_tmp_9_m)(port_tmp_10_n))(Host.num_1))
            | Host.hol_rat_div(port_tmp_9_m)(port_tmp_10_n)
            | failwith("rat_of_term")
          »)
        »)
    »
    | _:«
        calc_int_dest_realintconst(tm)
    »
  »)
»

def calc_int_term_of_rat:«
  (block:«
    let div_tm:«
      Host.expand_quote("[\"Const\",\"real_div\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]]]]")
    »;
    (fun(x):«
      (block:«
        let Pair(p,q):«
          Host.numdom(x)
        »;
        (block:«
          let ptm:«
            calc_int_mk_realintconst(p)
          »;
          (block:«
            if Host.hol_equal(q)(Host.num_1)
            | ptm
            | Up_fusion.mk_comb((block:«
              let port_tmp_11 = calc_int_mk_realintconst(q);
              let port_tmp_12 = Up_fusion.mk_comb(Pair(div_tm,ptm));
              Pair(port_tmp_12,port_tmp_11)
            »))
          »)
        »)
      »)
    »)
  »)
»

