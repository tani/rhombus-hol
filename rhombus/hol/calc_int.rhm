fun is_realintconst(tm):
  match tm
  | Comb(Const("real_of_num",_),n): is_numeral(n)
  | Comb(Const("real_neg",_),Comb(Const("real_of_num",_),n)): (is_numeral(n) && Host.hol_not(Host.hol_equal(dest_numeral(n))(Host.num_0)))
  | _: #false

fun dest_realintconst(tm):
  match tm
  | Comb(Const("real_of_num",_),n): dest_numeral(n)
  | Comb(Const("real_neg",_),Comb(Const("real_of_num",_),n)):
      let nn = dest_numeral(n)
      (if Host.hol_unequal(nn)(Host.num_0) | Host.minus_num(dest_numeral(n)) | failwith("dest_realintconst"))
  | _: failwith("dest_realintconst")

def mk_realintconst:
  let cast_tm_2 = Host.hol_term(Const("real_of_num", Fun(Num, Real)))
  let neg_tm_2 = Host.hol_term(Const("real_neg", Fun(Real, Real)))
  let mk_numconst = (fun(n): mk_comb([cast_tm_2, mk_numeral(n)]))
  (fun(x): (if Host.hol_lt(x)(Host.num_0) | mk_comb([neg_tm_2, mk_numconst(Host.minus_num(x))]) | mk_numconst(x)))

fun is_ratconst(tm):
  match tm
  | Comb(Comb(Const("real_div",_),p),q):
      if is_realintconst(p)
      | if is_realintconst(q)
        | let m_2 = dest_realintconst(p)
          let n_2 = dest_realintconst(q)
          (Host.hol_gt(n_2)(Host.num_1) && Host.hol_equal(Host.gcd_num(m_2)(n_2))(Host.num_1))
        | #false
      | #false
  | _: is_realintconst(tm)

fun rat_of_term(tm):
  match tm
  | Comb(Comb(Const("real_div",_),p),q):
      let m_3 = dest_realintconst(p)
      let n_3 = dest_realintconst(q)
      (if (Host.hol_gt(n_3)(Host.num_1) && Host.hol_equal(Host.gcd_num(m_3)(n_3))(Host.num_1)) | Host.hol_rat_div(m_3)(n_3) | failwith("rat_of_term"))
  | _: dest_realintconst(tm)

def term_of_rat:
  let div_tm = Host.hol_term(Const("real_div", Fun(Real, Fun(Real, Real))))
  fun(x):
    let [p, q] = Host.numdom(x)
    let ptm = mk_realintconst(p)
    (if Host.hol_equal(q)(Host.num_1) | ptm | mk_comb([mk_comb([div_tm, ptm]), mk_realintconst(q)]))

def REAL_ADD_AC:
  prove(
    [
      Host.hol_term(And(
        Eq(
          Real,
          App(Const("real_add", Fun(Real, Fun(Real, Real))), [Var("m", Real), Var("n", Real)]),
          App(Const("real_add", Fun(Real, Fun(Real, Real))), [Var("n", Real), Var("m", Real)])
        ),
        And(
          Eq(
            Real,
            App(
              Const("real_add", Fun(Real, Fun(Real, Real))),
              [
                App(Const("real_add", Fun(Real, Fun(Real, Real))), [Var("m", Real), Var("n", Real)]),
                Var("p", Real)
              ]
            ),
            App(
              Const("real_add", Fun(Real, Fun(Real, Real))),
              [
                Var("m", Real),
                App(Const("real_add", Fun(Real, Fun(Real, Real))), [Var("n", Real), Var("p", Real)])
              ]
            )
          ),
          Eq(
            Real,
            App(
              Const("real_add", Fun(Real, Fun(Real, Real))),
              [
                Var("m", Real),
                App(Const("real_add", Fun(Real, Fun(Real, Real))), [Var("n", Real), Var("p", Real)])
              ]
            ),
            App(
              Const("real_add", Fun(Real, Fun(Real, Real))),
              [
                Var("n", Real),
                App(Const("real_add", Fun(Real, Fun(Real, Real))), [Var("m", Real), Var("p", Real)])
              ]
            )
          )
        )
      )),
      MESON_TAC(PairList [REAL_ADD_ASSOC, REAL_ADD_SYM])
    ]
  )

