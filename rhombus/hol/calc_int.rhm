fun calc_int_is_realintconst(tm):«
  (block:«
    let port_tmp_1 = tm;
    match port_tmp_1
    | Up_fusion.Comb(Up_fusion.Const("real_of_num",_),n):«
        Up_nums.is_numeral(n)
    »
    | Up_fusion.Comb(Up_fusion.Const("real_neg",_),Up_fusion.Comb(Up_fusion.Const("real_of_num",_),n)):«
        (Up_nums.is_numeral(n) && Host.hol_not((block:«
          let port_tmp_2 = Host.num_0;
          let port_tmp_3 = Up_basics.dest_numeral(n);
          let port_tmp_4 = Host.hol_equal;
          port_tmp_4(port_tmp_3)(port_tmp_2)
        »)))
    »
    | _:«
        #false
    »
  »)
»

fun calc_int_dest_realintconst(tm):«
  (block:«
    let port_tmp_5 = tm;
    match port_tmp_5
    | Up_fusion.Comb(Up_fusion.Const("real_of_num",_),n):«
        Up_basics.dest_numeral(n)
    »
    | Up_fusion.Comb(Up_fusion.Const("real_neg",_),Up_fusion.Comb(Up_fusion.Const("real_of_num",_),n)):«
        (block:«
          let port_tmp_6_nn:«
            Up_basics.dest_numeral(n)
          »;
          (block:«
            if Host.hol_unequal(port_tmp_6_nn)(Host.num_0)
            | Host.minus_num(Up_basics.dest_numeral(n))
            | failwith("dest_realintconst")
          »)
        »)
    »
    | _:«
        failwith("dest_realintconst")
    »
  »)
»

def calc_int_mk_realintconst:«
  (block:«
    let port_tmp_7_cast_tm:«
      Host.expand_quote("[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]]")
