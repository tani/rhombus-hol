def real_int_red_conv_list:
  PairList [
    [
      Host.hol_term(App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)])),
      calc_int_REAL_INT_LE_CONV_v2
    ],
    [
      Host.hol_term(App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)])),
      calc_int_REAL_INT_LT_CONV_v2
    ],
    [
      Host.hol_term(App(Const("real_ge", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)])),
      calc_int_REAL_INT_GE_CONV_v2
    ],
    [
      Host.hol_term(App(Const("real_gt", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)])),
      calc_int_REAL_INT_GT_CONV_v2
    ],
    [Host.hol_term(Eq(Real, Var("x", Real), Var("y", Real))), REAL_INT_EQ_CONV],
    [
      Host.hol_term(App(Const("real_neg", Fun(Real, Real)), [Var("x", Real)])),
      CHANGED_CONV(REAL_INT_NEG_CONV)
    ],
    [Host.hol_term(App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])), REAL_INT_ABS_CONV],
    [
      Host.hol_term(App(Const("real_add", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)])),
      REAL_INT_ADD_CONV
    ],
    [
      Host.hol_term(App(Const("real_sub", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)])),
      REAL_INT_SUB_CONV
    ],
    [
      Host.hol_term(App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)])),
      REAL_INT_MUL_CONV
    ],
    [
      Host.hol_term(App(Const("real_pow", Fun(Real, Fun(Num, Real))), [Var("x", Real), Var("n", Num)])),
      REAL_INT_POW_CONV
    ]
  ]

def REAL_INT_RED_CONV:
  let gconv_net = itlist(uncurry(net_of_conv))(real_int_red_conv_list)(Host.hol_apply_unit(basic_net))
  REWRITES_CONV(gconv_net)

def REAL_INT_REDUCE_CONV = DEPTH_CONV(REAL_INT_RED_CONV)

def real_int_compute_add_convs:
  let convlist:
    map(
      fun([pat, the_conv]):
        let [c, args] = strip_comb(pat)
        [c, length(args), the_conv]
    )(real_int_red_conv_list)
  (fun(compset): Host.hol_apply_unit(itlist(fun(newc): fun(_): Compute.Compute.add_conv(newc)(compset))(convlist)))

def REAL_INT_COMPUTE_CONV:
  let cs = Host.hol_apply_unit(Compute.Compute.bool_compset)
  Compute.Compute.set_skip(cs)(Host.hol_term(Const("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))))))(Host.Some(1))
  real_int_compute_add_convs(cs)
  Compute.Compute.WEAK_CBV_CONV(cs)

def REAL_INT_LE_CONV = calc_int_REAL_INT_LE_CONV_v2

def REAL_INT_LT_CONV = calc_int_REAL_INT_LT_CONV_v2

def REAL_INT_GE_CONV = calc_int_REAL_INT_GE_CONV_v2

def REAL_INT_GT_CONV = calc_int_REAL_INT_GT_CONV_v2
