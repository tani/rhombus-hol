      Host.expand_quote("[\"Const\",\"real_neg\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]]")
    »;
    (block:«
      let port_tmp_9_mk_numconst:«
        (fun(n):«
          Up_fusion.mk_comb((block:«
            let port_tmp_10 = Up_nums.mk_numeral(n);
            let port_tmp_11 = port_tmp_7_cast_tm;
            Pair(port_tmp_11,port_tmp_10)
          »))
        »)
      »;
      (fun(x):«
        (block:«
          if Host.hol_lt(x)(Host.num_0)
          | Up_fusion.mk_comb((block:«
            let port_tmp_12 = port_tmp_9_mk_numconst(Host.minus_num(x));
            let port_tmp_13 = port_tmp_8_neg_tm;
            Pair(port_tmp_13,port_tmp_12)
          »))
          | port_tmp_9_mk_numconst(x)
        »)
      »)
    »)
  »)
»

fun calc_int_is_ratconst(tm):«
  (block:«
    let port_tmp_14 = tm;
    match port_tmp_14
    | Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("real_div",_),p),q):«
        (calc_int_is_realintconst(p) && (calc_int_is_realintconst(q) && (block:«
          let port_tmp_15_m:«
            calc_int_dest_realintconst(p)
          »;
          let port_tmp_16_n:«
            calc_int_dest_realintconst(q)
          »;
          (Host.hol_gt(port_tmp_16_n)(Host.num_1) && (block:«
            let port_tmp_17 = Host.num_1;
            let port_tmp_18 = Host.gcd_num(port_tmp_15_m)(port_tmp_16_n);
            let port_tmp_19 = Host.hol_equal;
            port_tmp_19(port_tmp_18)(port_tmp_17)
          »))
        »)))
    »
    | _:«
        calc_int_is_realintconst(tm)
    »
  »)
»

fun calc_int_rat_of_term(tm):«
  (block:«
    let port_tmp_20 = tm;
    match port_tmp_20
    | Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("real_div",_),p),q):«
        (block:«
          let port_tmp_21_m:«
            calc_int_dest_realintconst(p)
          »;
          let port_tmp_22_n:«
            calc_int_dest_realintconst(q)
          »;
          (block:«
            if (Host.hol_gt(port_tmp_22_n)(Host.num_1) && (block:«
              let port_tmp_23 = Host.num_1;
              let port_tmp_24 = Host.gcd_num(port_tmp_21_m)(port_tmp_22_n);
              let port_tmp_25 = Host.hol_equal;
              port_tmp_25(port_tmp_24)(port_tmp_23)
            »))
            | Host.hol_rat_div(port_tmp_21_m)(port_tmp_22_n)
            | failwith("rat_of_term")
          »)
        »)
    »
    | _:«
        calc_int_dest_realintconst(tm)
    »
  »)
»

