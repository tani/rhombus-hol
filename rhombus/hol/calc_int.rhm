            REWRITE_TAC(PairList [ONCE_REWRITE_RULE(PairList [REAL_ADD_SYM])(REAL_ADD_LINV)])
          ),
          (
            DISCH_THEN(
              o(MP_TAC)(SPEC(Host.hol_term(App(Const("real_neg", Fun(Real, Real)), [Var("x", Real)]))))
