                Const("real_neg", Fun(Real, Real)),
                [
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("*", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)])]
                  )
                ]
              )
            ),
            Eq(
              Real,
              App(
                Const("real_mul", Fun(Real, Fun(Real, Real))),
                [
                  App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)]),
                  App(
                    Const("real_neg", Fun(Real, Real)),
                    [App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])]
                  )
                ]
              ),
              App(
                Const("real_neg", Fun(Real, Real)),
                [
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("*", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)])]
                  )
                ]
              )
            )
          )
        )),
        (
          REWRITE_TAC(PairList [REAL_MUL_LNEG, REAL_MUL_RNEG, REAL_NEG_NEG]) then_tac \
          REWRITE_TAC(PairList [REAL_OF_NUM_MUL])
        )
      ]
    )
  FIRST_CONV(
    PairList [
      GEN_REWRITE_CONV(I)(PairList [pth0_2]),
      (GEN_REWRITE_CONV(I)(PairList [pth1_2]) then_conv RAND_CONV(NUM_MULT_CONV)),
      (
        GEN_REWRITE_CONV(I)(PairList [pth2_2]) then_conv \
        RAND_CONV(RAND_CONV(NUM_MULT_CONV))
      )
    ]
  )

def REAL_INT_ADD_CONV:
  let neg_tm = Host.hol_term(Const("real_neg", Fun(Real, Real)))
  let amp_tm = Host.hol_term(Const("real_of_num", Fun(Num, Real)))
  let add_tm = Host.hol_term(Const("real_add", Fun(Real, Fun(Real, Real))))
  let dest = dest_binop(Host.hol_term(Const("real_add", Fun(Real, Fun(Real, Real)))))
  let m_tm_2 = Host.hol_term(Var("m", Num))
  let n_tm_2 = Host.hol_term(Var("n", Num))
  let pth0:
    prove(
      [
        Host.hol_term(And(
          Eq(
            Real,
            App(
              Const("real_add", Fun(Real, Fun(Real, Real))),
              [
                App(
                  Const("real_neg", Fun(Real, Real)),
                  [App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)])]
                ),
                App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)])
              ]
            ),
            App(
              Const("real_of_num", Fun(Num, Real)),
              [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
            )
          ),
          Eq(
            Real,
            App(
              Const("real_add", Fun(Real, Fun(Real, Real))),
              [
                App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)]),
                App(
                  Const("real_neg", Fun(Real, Real)),
                  [App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)])]
                )
              ]
            ),
            App(
              Const("real_of_num", Fun(Num, Real)),
              [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
            )
          )
        )),
        REWRITE_TAC(PairList [REAL_ADD_LINV, REAL_ADD_RINV])
      ]
    )
  let PairList [pth1, & PairList [pth2, & PairList [pth3, & PairList [pth4, & PairList [pth5, & PairList [pth6, & PairList []]]]]]]:
    o(CONJUNCTS)(prove)(
      [
        Host.hol_term(And(
          Eq(
            Real,
            App(
              Const("real_add", Fun(Real, Fun(Real, Real))),
              [
                App(
                  Const("real_neg", Fun(Real, Real)),
                  [App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)])]
                ),
                App(
                  Const("real_neg", Fun(Real, Real)),
                  [App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])]
                )
              ]
            ),
            App(
              Const("real_neg", Fun(Real, Real)),
              [
                App(
                  Const("real_of_num", Fun(Num, Real)),
                  [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)])]
                )
              ]
            )
          ),
          And(
            Eq(
              Real,
              App(
                Const("real_add", Fun(Real, Fun(Real, Real))),
                [
                  App(
                    Const("real_neg", Fun(Real, Real)),
                    [App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)])]
                  ),
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)])]
                  )
                ]
              ),
              App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])
            ),
            And(
              Eq(
                Real,
                App(
                  Const("real_add", Fun(Real, Fun(Real, Real))),
                  [
                    App(
                      Const("real_neg", Fun(Real, Real)),
                      [
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)])]
                        )
                      ]
                    ),
                    App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)])
                  ]
                ),
                App(
                  Const("real_neg", Fun(Real, Real)),
                  [App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])]
                )
              ),
              And(
                Eq(
                  Real,
                  App(
                    Const("real_add", Fun(Real, Fun(Real, Real))),
                    [
                      App(
                        Const("real_of_num", Fun(Num, Real)),
                        [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)])]
                      ),
                      App(
                        Const("real_neg", Fun(Real, Real)),
                        [App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)])]
                      )
                    ]
                  ),
                  App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])
                ),
                And(
                  Eq(
                    Real,
                    App(
                      Const("real_add", Fun(Real, Fun(Real, Real))),
                      [
                        App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)]),
                        App(
                          Const("real_neg", Fun(Real, Real)),
                          [
                            App(
                              Const("real_of_num", Fun(Num, Real)),
                              [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)])]
                            )
                          ]
                        )
                      ]
                    ),
                    App(
                      Const("real_neg", Fun(Real, Real)),
                      [App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])]
                    )
                  ),
                  Eq(
                    Real,
                    App(
                      Const("real_add", Fun(Real, Fun(Real, Real))),
                      [
                        App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)]),
                        App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])
                      ]
                    ),
                    App(
                      Const("real_of_num", Fun(Num, Real)),
                      [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)])]
                    )
                  )
                )
              )
            )
          )
        )),
        (
          (
            (
              (
                (
                  REWRITE_TAC(PairList [GSYM(REAL_OF_NUM_ADD), REAL_NEG_ADD]) then_tac \
                  REWRITE_TAC(PairList [REAL_ADD_ASSOC, REAL_ADD_LINV, REAL_ADD_LID])
                ) then_tac \
                REWRITE_TAC(PairList [REAL_ADD_RINV, REAL_ADD_LID])
              ) then_tac \
              ONCE_REWRITE_TAC(PairList [REAL_ADD_SYM])
            ) then_tac \
            REWRITE_TAC(PairList [REAL_ADD_ASSOC, REAL_ADD_LINV, REAL_ADD_LID])
          ) then_tac \
          REWRITE_TAC(PairList [REAL_ADD_RINV, REAL_ADD_LID])
        )
      ]
    )
  (
    GEN_REWRITE_CONV(I)(PairList [pth0]) or_conv \
    (
      fun(tm):
        try:
          let [l, r] = dest(tm)
          if (Host.hol_not(is_realintconst(l)) || Host.hol_not(is_realintconst(r)))
          | failwith("")
          | if Host.hol_equal(rator(l))(neg_tm)
            | if Host.hol_equal(rator(r))(neg_tm)
              | let th1 = INST(PairList [[rand(rand(l)), m_tm_2], [rand(rand(r)), n_tm_2]])(pth1)
                let tm1 = rand(rand(rand(concl(th1))))
                let th2 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(NUM_ADD_CONV(tm1)))
                TRANS(th1)(th2)
              | let m_4 = rand(rand(l))
                let n_4 = rand(r)
                let m_prime_2 = dest_numeral(m_4)
                let n_prime_2 = dest_numeral(n_4)
                if Host.hol_le(m_prime_2)(n_prime_2)
                | let p = mk_numeral(Host.hol_sub(n_prime_2)(m_prime_2))
                  let th1 = INST(PairList [[m_4, m_tm_2], [p, n_tm_2]])(pth2)
                  let th2 = NUM_ADD_CONV(rand(rand(lhand(concl(th1)))))
                  let th3 = AP_TERM(rator(tm))(AP_TERM(amp_tm)(SYM(th2)))
                  TRANS(th3)(th1)
                | let p = mk_numeral(Host.hol_sub(m_prime_2)(n_prime_2))
                  let th1 = INST(PairList [[n_4, m_tm_2], [p, n_tm_2]])(pth3)
                  let th2 = NUM_ADD_CONV(rand(rand(lhand(lhand(concl(th1))))))
                  let th3 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_THM(AP_TERM(add_tm)(th3))(rand(tm))
                  TRANS(th4)(th1)
            | if Host.hol_equal(rator(r))(neg_tm)
              | let m_5 = rand(l)
                let n_5 = rand(rand(r))
                let m_prime_3 = dest_numeral(m_5)
                let n_prime_3 = dest_numeral(n_5)
                if Host.hol_le(n_prime_3)(m_prime_3)
                | let p = mk_numeral(Host.hol_sub(m_prime_3)(n_prime_3))
                  let th1 = INST(PairList [[n_5, m_tm_2], [p, n_tm_2]])(pth4)
                  let th2 = NUM_ADD_CONV(rand(lhand(lhand(concl(th1)))))
                  let th3 = AP_TERM(add_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_THM(th3)(rand(tm))
                  TRANS(th4)(th1)
                | let p = mk_numeral(Host.hol_sub(n_prime_3)(m_prime_3))
                  let th1 = INST(PairList [[m_5, m_tm_2], [p, n_tm_2]])(pth5)
                  let th2 = NUM_ADD_CONV(rand(rand(rand(lhand(concl(th1))))))
                  let th3 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_TERM(rator(tm))(th3)
                  TRANS(th4)(th1)
              | let th1 = INST(PairList [[rand(l), m_tm_2], [rand(r), n_tm_2]])(pth6)
                let tm1 = rand(rand(concl(th1)))
                let th2 = AP_TERM(amp_tm)(NUM_ADD_CONV(tm1))
                TRANS(th1)(th2)
          ~catch exn:
            match exn
            | Failure(_): failwith("REAL_INT_ADD_CONV")
            | exn: Host.hol_raise(exn)
    )
  )

def REAL_INT_SUB_CONV:
  (
    (
      GEN_REWRITE_CONV(I)(PairList [real_sub]) then_conv \
      TRY_CONV(RAND_CONV(REAL_INT_NEG_CONV))
    ) then_conv \
    REAL_INT_ADD_CONV
  )

def REAL_INT_POW_CONV:
  let [pth1, pth2]:
    o(CONJ_PAIR)(prove)(
      [
        Host.hol_term(And(
          Eq(
            Real,
            App(
              Const("real_pow", Fun(Real, Fun(Num, Real))),
              [App(Const("real_of_num", Fun(Num, Real)), [Var("x", Num)]), Var("n", Num)]
            ),
            App(
              Const("real_of_num", Fun(Num, Real)),
              [App(Const("EXP", Fun(Num, Fun(Num, Num))), [Var("x", Num), Var("n", Num)])]
            )
          ),
          Eq(
            Real,
            App(
              Const("real_pow", Fun(Real, Fun(Num, Real))),
              [
                App(
                  Const("real_neg", Fun(Real, Real)),
                  [App(Const("real_of_num", Fun(Num, Real)), [Var("x", Num)])]
                ),
                Var("n", Num)
              ]
            ),
            App(
              Const("COND", Fun(Bool, Fun(Real, Fun(Real, Real)))),
              [
                App(Const("EVEN", Fun(Num, Bool)), [Var("n", Num)]),
                App(
                  Const("real_of_num", Fun(Num, Real)),
                  [App(Const("EXP", Fun(Num, Fun(Num, Num))), [Var("x", Num), Var("n", Num)])]
                ),
                App(
                  Const("real_neg", Fun(Real, Real)),
                  [
                    App(
                      Const("real_of_num", Fun(Num, Real)),
                      [App(Const("EXP", Fun(Num, Fun(Num, Num))), [Var("x", Num), Var("n", Num)])]
                    )
                  ]
                )
              ]
            )
          )
        )),
        REWRITE_TAC(PairList [REAL_OF_NUM_POW, REAL_POW_NEG])
      ]
    )
  let tth:
    prove(
      [
        Host.hol_term(And(
          Eq(
            Real,
            App(
              Const("COND", Fun(Bool, Fun(Real, Fun(Real, Real)))),
              [True, Var("x", Real), Var("y", Real)]
            ),
            Var("x", Real)
          ),
          Eq(
            Real,
            App(
              Const("COND", Fun(Bool, Fun(Real, Fun(Real, Real)))),
              [False, Var("x", Real), Var("y", Real)]
            ),
            Var("y", Real)
          )
        )),
        REWRITE_TAC(PairList [])
      ]
    )
  let neg_tm = Host.hol_term(Const("real_neg", Fun(Real, Real)))
  (
    (GEN_REWRITE_CONV(I)(PairList [pth1]) then_conv RAND_CONV(NUM_EXP_CONV)) or_conv \
    (
      (
        (
          GEN_REWRITE_CONV(I)(PairList [pth2]) then_conv \
          RATOR_CONV(RATOR_CONV(RAND_CONV(NUM_EVEN_CONV)))
        ) then_conv \
        GEN_REWRITE_CONV(I)(PairList [tth])
      ) then_conv \
      (fun(tm): (if Host.hol_equal(rator(tm))(neg_tm) | RAND_CONV(RAND_CONV(NUM_EXP_CONV))(tm) | RAND_CONV(NUM_EXP_CONV)(tm)))
    )
  )

