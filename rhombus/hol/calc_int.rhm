def REAL_INT_REDUCE_CONV = Equal.DEPTH_CONV(REAL_INT_RED_CONV)

def real_int_compute_add_convs:
  let convlist:
    map(
      fun([pat, the_conv]):
        let [c, args] = Basics.strip_comb(pat)
        [c, length(args), the_conv])(real_int_red_conv_list)
  (fun(compset): Host.hol_apply_unit(itlist((fun(newc): (fun(_): Compute.Compute.add_conv(newc)(compset))))(convlist)))

def REAL_INT_COMPUTE_CONV:
  let cs = Host.hol_apply_unit(Compute.Compute.bool_compset)
  Compute.Compute.set_skip(cs)(Host.expand_quote("[\"Const\",\"COND\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"A\"]]]]]]]]"))(Host.Some(1))
  real_int_compute_add_convs(cs)
  Compute.Compute.WEAK_CBV_CONV(cs)
