  prove(
    [
      Host.hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Forall(
            "z",
            Real,
            Iff(
              Eq(
                Real,
                App(Const("real_add", Fun(Real, Fun(Real, Real))), [Ref("x"), Ref("y")]),
                App(Const("real_add", Fun(Real, Fun(Real, Real))), [Ref("x"), Ref("z")])
              ),
              Eq(Real, Ref("y"), Ref("z"))
            )
          )
        )
      )),
      (
        (
          (
            ((REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac DISCH_TAC) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          POP_ASSUM(
            o(MP_TAC)(
              AP_TERM(
                Host.hol_term(App(
                  Const("real_add", Fun(Real, Fun(Real, Real))),
                  [App(Const("real_neg", Fun(Real, Real)), [Var("x", Real)])]
                ))
              )
            )
          )
        ) then_tac \
        REWRITE_TAC(PairList [REAL_ADD_ASSOC, REAL_ADD_LINV, REAL_ADD_LID])
      )
    ]
  )

