fun is_realintconst(tm):
  match tm
  | Fusion.Comb(Fusion.Const("real_of_num",_),n): Nums.is_numeral(n)
  | Fusion.Comb(Fusion.Const("real_neg",_),Fusion.Comb(Fusion.Const("real_of_num",_),n)): (Nums.is_numeral(n) && Host.hol_not(Host.hol_equal(Basics.dest_numeral(n))(Host.num_0)))
  | _: #false

fun dest_realintconst(tm):
  match tm
  | Fusion.Comb(Fusion.Const("real_of_num",_),n): Basics.dest_numeral(n)
  | Fusion.Comb(Fusion.Const("real_neg",_),Fusion.Comb(Fusion.Const("real_of_num",_),n)):
      let nn = Basics.dest_numeral(n)
      (if Host.hol_unequal(nn)(Host.num_0) | Host.minus_num(Basics.dest_numeral(n)) | failwith("dest_realintconst"))
  | _: failwith("dest_realintconst")

def mk_realintconst:
  let cast_tm_2 = Host.expand_quote("[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]]")
  let neg_tm_2 = Host.expand_quote("[\"Const\",\"real_neg\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]]")
  let mk_numconst = (fun(n): Fusion.mk_comb([cast_tm_2, Nums.mk_numeral(n)]))
  (fun(x): (if Host.hol_lt(x)(Host.num_0) | Fusion.mk_comb([neg_tm_2, mk_numconst(Host.minus_num(x))]) | mk_numconst(x)))

fun is_ratconst(tm):
  match tm
  | Fusion.Comb(Fusion.Comb(Fusion.Const("real_div",_),p),q):
      if is_realintconst(p)
      | if is_realintconst(q)
        | let m_2 = dest_realintconst(p)
          let n_2 = dest_realintconst(q)
          (Host.hol_gt(n_2)(Host.num_1) && Host.hol_equal(Host.gcd_num(m_2)(n_2))(Host.num_1))
        | #false
      | #false
  | _: is_realintconst(tm)

fun rat_of_term(tm):
  match tm
  | Fusion.Comb(Fusion.Comb(Fusion.Const("real_div",_),p),q):
      let m_3 = dest_realintconst(p)
      let n_3 = dest_realintconst(q)
      (if (Host.hol_gt(n_3)(Host.num_1) && Host.hol_equal(Host.gcd_num(m_3)(n_3))(Host.num_1)) | Host.hol_rat_div(m_3)(n_3) | failwith("rat_of_term"))
  | _: dest_realintconst(tm)

def term_of_rat:
  let div_tm = Host.expand_quote("[\"Const\",\"real_div\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]]]]")
  fun(x):
    let [p, q] = Host.numdom(x)
    let ptm = mk_realintconst(p)
    (if Host.hol_equal(q)(Host.num_1) | ptm | Fusion.mk_comb([Fusion.mk_comb([div_tm, ptm]), mk_realintconst(q)]))

