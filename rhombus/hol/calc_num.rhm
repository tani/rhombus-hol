                  let Comb(Comb(_,ltm),Comb(Comb(_,ptm),Comb(Comb(_,mtm),Comb(Comb(_,_),htm)))) = rand(concl(th0))
                  let th1_5 = NUM_SQUARE_RULE_2(htm)
