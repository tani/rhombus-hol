  // Recursive multiplication needs the local definition before its first use.
  fun NUM_MUL_RULE_2(k):
    fun(l):
      fun(tm):
        fun(tm_prime):
          match [tm, tm_prime]
          | [Const("_0",_), _]: INST(PairList [[tm_prime, n_tm]])(pth_0l)
          | [_, Const("_0",_)]: INST(PairList [[tm, m_tm]])(pth_0r)
          | [Comb(Const("BIT1",_),Const("_0",_)), _]: INST(PairList [[tm_prime, n_tm]])(pth_1l)
