  let NUM_UNSHIFT2_CONV = (RAND_CONV(RAND_CONV(NUM_UNSHIFT_CONV)) then_conv NUM_UNSHIFT_CONV)
  let NUM_UNSHIFT3_CONV = (RAND_CONV(RAND_CONV(NUM_UNSHIFT2_CONV)) then_conv NUM_UNSHIFT_CONV)
  let NUM_UNSHIFT4_CONV = (RAND_CONV(RAND_CONV(NUM_UNSHIFT3_CONV)) then_conv NUM_UNSHIFT_CONV)
  let BINOP2_CONV = (fun(conv1): (fun(conv2): COMB2_CONV(RAND_CONV(conv1))(conv2)))
  let TOOM3_CONV = BINOP2_CONV(LAND_CONV(NUM_UNSHIFT2_CONV))(NUM_UNSHIFT4_CONV)
  fun GEN_NUM_SQUARE_RULE_2(w):
    fun(z):
      fun(tm):
        match tm
        | Const("_0",_): pth_0_4
        | Comb(Const("BIT0",_),mtm):
            match mtm
            | Comb(Const("BIT0",_),Comb(Const("BIT0",_),ptm)):
                let th1 = GEN_NUM_SQUARE_RULE_2(w)(Host.hol_sub(z)(3))(ptm)
                let ntm = rand(concl(th1))
                EQ_MP(INST(PairList [[ptm, m_tm_2], [ntm, n_tm_2]])(pth_even3_2))(th1)
            | _:
                let th1 = GEN_NUM_SQUARE_RULE_2(w)(Host.hol_sub(z)(1))(mtm)
                let ntm = rand(concl(th1))
                EQ_MP(INST(PairList [[mtm, m_tm_2], [ntm, n_tm_2]])(pth_even_2))(th1)
        | Comb(Const("BIT1",_),mtm):
            if Host.hol_equal(mtm)(zero_tm_2)
            | pth_1_4
            | if ((Host.hol_lt(w)(100) || Host.hol_lt(z)(20)) && Host.hol_lt(Host.hol_add(w)(z))(150))
              | match mtm
                | Comb(Const("BIT1",_),Comb(Const("BIT1",_),ntm)):
                    let th1 = NUM_ADD_RULE(ntm)(one_tm_2)
                    let mtm = rand(concl(th1))
                    let th2 = NUM_SQUARE_RULE_2(mtm)
                    let ptm = rand(concl(th2))
                    let atm = subbn_2(mk_comb([BIT0_tm_2, mk_comb([BIT0_tm_2, ptm])]))(mtm)
                    let th3 = NUM_ADD_RULE(mtm)(atm)
                    let th4 = INST(PairList [[atm, a_tm_2], [mtm, m_tm_2], [ntm, n_tm_2], [ptm, p_tm_2]])(pth_qstep_2)
                    QUICK_PROVE_HYP_2(CONJ(th1)(CONJ(th2)(th3)))(th4)
                | _:
                    let th1 = GEN_NUM_SQUARE_RULE_2(Host.hol_sub(w)(1))(z)(mtm)
                    let ntm = rand(concl(th1))
                    let th2 = EQ_MP(INST(PairList [[mtm, m_tm_2], [ntm, n_tm_2]])(pth_odd_2))(th1)
                    match concl(th2)
                    | Comb(_,Comb(_,Comb(_,Comb(Comb(_,ptm),qtm)))):
                        let th3 = NUM_ADD_RULE(ptm)(qtm)
                        TRANS(th2)(AP_BIT1_2(AP_BIT0_2(th3)))
