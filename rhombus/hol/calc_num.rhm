                  Const("EXP", Fun(Num, Fun(Num, Num))),
                  [App(Const("BIT0", Fun(Num, Num)), [Ref("m")]), Const("_0", Num)]
                ),
                App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])
              )
            ),
            And(
              Forall(
                "m",
                Num,
                Eq(
                  Num,
                  App(
                    Const("EXP", Fun(Num, Fun(Num, Num))),
                    [App(Const("BIT1", Fun(Num, Num)), [Ref("m")]), Const("_0", Num)]
                  ),
                  App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])
                )
              ),
              And(
                Forall(
                  "n",
                  Num,
                  Eq(
                    Num,
                    App(
                      Const("EXP", Fun(Num, Fun(Num, Num))),
                      [Const("_0", Num), App(Const("BIT0", Fun(Num, Num)), [Ref("n")])]
                    ),
                    App(
                      Const("*", Fun(Num, Fun(Num, Num))),
                      [
                        App(Const("EXP", Fun(Num, Fun(Num, Num))), [Const("_0", Num), Ref("n")]),
                        App(Const("EXP", Fun(Num, Fun(Num, Num))), [Const("_0", Num), Ref("n")])
                      ]
                    )
                  )
                ),
                And(
                  Forall(
                    "m",
                    Num,
                    Forall(
                      "n",
                      Num,
                      Eq(
                        Num,
                        App(
                          Const("EXP", Fun(Num, Fun(Num, Num))),
                          [App(Const("BIT0", Fun(Num, Num)), [Ref("m")]), App(Const("BIT0", Fun(Num, Num)), [Ref("n")])]
                        ),
                        App(
                          Const("*", Fun(Num, Fun(Num, Num))),
                          [
                            App(
                              Const("EXP", Fun(Num, Fun(Num, Num))),
                              [App(Const("BIT0", Fun(Num, Num)), [Ref("m")]), Ref("n")]
                            ),
                            App(
                              Const("EXP", Fun(Num, Fun(Num, Num))),
                              [App(Const("BIT0", Fun(Num, Num)), [Ref("m")]), Ref("n")]
                            )
                          ]
                        )
                      )
                    )
                  ),
                  And(
                    Forall(
                      "m",
                      Num,
                      Forall(
                        "n",
                        Num,
                        Eq(
                          Num,
                          App(
                            Const("EXP", Fun(Num, Fun(Num, Num))),
                            [App(Const("BIT1", Fun(Num, Num)), [Ref("m")]), App(Const("BIT0", Fun(Num, Num)), [Ref("n")])]
                          ),
                          App(
                            Const("*", Fun(Num, Fun(Num, Num))),
                            [
                              App(
                                Const("EXP", Fun(Num, Fun(Num, Num))),
                                [App(Const("BIT1", Fun(Num, Num)), [Ref("m")]), Ref("n")]
                              ),
                              App(
                                Const("EXP", Fun(Num, Fun(Num, Num))),
                                [App(Const("BIT1", Fun(Num, Num)), [Ref("m")]), Ref("n")]
                              )
                            ]
                          )
                        )
                      )
                    ),
                    And(
                      Forall(
                        "n",
                        Num,
                        Eq(
                          Num,
                          App(
                            Const("EXP", Fun(Num, Fun(Num, Num))),
                            [Const("_0", Num), App(Const("BIT1", Fun(Num, Num)), [Ref("n")])]
                          ),
                          Const("_0", Num)
                        )
                      ),
                      And(
                        Forall(
                          "m",
                          Num,
                          Forall(
                            "n",
                            Num,
                            Eq(
                              Num,
                              App(
                                Const("EXP", Fun(Num, Fun(Num, Num))),
                                [App(Const("BIT0", Fun(Num, Num)), [Ref("m")]), App(Const("BIT1", Fun(Num, Num)), [Ref("n")])]
                              ),
                              App(
                                Const("*", Fun(Num, Fun(Num, Num))),
                                [
                                  App(Const("BIT0", Fun(Num, Num)), [Ref("m")]),
                                  App(
                                    Const("*", Fun(Num, Fun(Num, Num))),
                                    [
                                      App(
                                        Const("EXP", Fun(Num, Fun(Num, Num))),
                                        [App(Const("BIT0", Fun(Num, Num)), [Ref("m")]), Ref("n")]
                                      ),
                                      App(
                                        Const("EXP", Fun(Num, Fun(Num, Num))),
                                        [App(Const("BIT0", Fun(Num, Num)), [Ref("m")]), Ref("n")]
                                      )
                                    ]
                                  )
                                ]
                              )
                            )
                          )
                        ),
                        Forall(
                          "m",
                          Num,
                          Forall(
                            "n",
                            Num,
                            Eq(
                              Num,
                              App(
                                Const("EXP", Fun(Num, Fun(Num, Num))),
                                [App(Const("BIT1", Fun(Num, Num)), [Ref("m")]), App(Const("BIT1", Fun(Num, Num)), [Ref("n")])]
                              ),
                              App(
                                Const("*", Fun(Num, Fun(Num, Num))),
                                [
                                  App(Const("BIT1", Fun(Num, Num)), [Ref("m")]),
                                  App(
                                    Const("*", Fun(Num, Fun(Num, Num))),
                                    [
                                      App(
                                        Const("EXP", Fun(Num, Fun(Num, Num))),
                                        [App(Const("BIT1", Fun(Num, Num)), [Ref("m")]), Ref("n")]
                                      ),
                                      App(
                                        Const("EXP", Fun(Num, Fun(Num, Num))),
                                        [App(Const("BIT1", Fun(Num, Num)), [Ref("m")]), Ref("n")]
                                      )
                                    ]
                                  )
                                ]
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (REWRITE_TAC(PairList [NUMERAL]) then_tac REPEAT(STRIP_TAC)) then_tac \
          TRY(GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV), PairList [BIT0, BIT1]))
        ) then_tac \
        REWRITE_TAC(PairList [DENUMERAL(EXP), DENUMERAL(MULT_CLAUSES), EXP_ADD])
      )
    ]
  )

def ARITH_EVEN:
  prove(
    [
      Host.hol_term(And(
        Forall(
          "n",
          Num,
          Iff(
            App(Const("EVEN", Fun(Num, Bool)), [App(Const("NUMERAL", Fun(Num, Num)), [Ref("n")])]),
            App(Const("EVEN", Fun(Num, Bool)), [Ref("n")])
          )
        ),
        And(
          Iff(App(Const("EVEN", Fun(Num, Bool)), [Const("_0", Num)]), True),
          And(
            Forall(
              "n",
              Num,
              Iff(App(Const("EVEN", Fun(Num, Bool)), [App(Const("BIT0", Fun(Num, Num)), [Ref("n")])]), True)
            ),
            Forall(
              "n",
              Num,
              Iff(App(Const("EVEN", Fun(Num, Bool)), [App(Const("BIT1", Fun(Num, Num)), [Ref("n")])]), False)
            )
          )
        )
      )),
      REWRITE_TAC(PairList [NUMERAL, BIT1, BIT0, DENUMERAL(EVEN), EVEN_ADD])
    ]
  )

