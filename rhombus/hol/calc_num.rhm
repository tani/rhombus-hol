def DENUMERAL = GEN_REWRITE_RULE(DEPTH_CONV)(PairList [NUMERAL])

def ARITH_ZERO:
  prove(
    [
      @hol|{(NUMERAL 0 = 0) /\
         (BIT0 _0 = _0)}|,
      REWRITE_TAC(PairList [NUMERAL, BIT0, DENUMERAL(ADD_CLAUSES)])
    ]
  )

def BIT0_0:
  prove(
    [
      @hol|{BIT0 0 = 0}|,
      REWRITE_TAC(PairList [NUMERAL, ARITH_ZERO])
    ]
  )

def BIT1_0:
  prove(
    [
      @hol|{BIT1 0 = 1}|,
      REWRITE_TAC(PairList [NUMERAL])
    ]
  )

def ARITH_SUC:
  prove(
    [
      @hol|{(!n. SUC(NUMERAL n) = NUMERAL(SUC n)) /\
         (SUC _0 = BIT1 _0) /\
         (!n. SUC (BIT0 n) = BIT1 n) /\
         (!n. SUC (BIT1 n) = BIT0 (SUC n))}|,
      REWRITE_TAC(PairList [NUMERAL, BIT0, BIT1, DENUMERAL(ADD_CLAUSES)])
    ]
  )

def ARITH_PRE:
  prove(
    [
      @hol|{(!n. PRE(NUMERAL n) = NUMERAL(PRE n)) /\
         (PRE _0 = _0) /\
         (!n. PRE(BIT0 n) = if n = _0 then _0 else BIT1 (PRE n)) /\
         (!n. PRE(BIT1 n) = BIT0 n)}|,
      REWRITE_TAC(PairList [NUMERAL, BIT1, BIT0, DENUMERAL(PRE)]) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(
        PairList [
          NUMERAL,
          DENUMERAL(PRE),
          DENUMERAL(ADD_CLAUSES),
          DENUMERAL(NOT_SUC),
          ARITH_ZERO
        ]
      )
    ]
  )

def ARITH_ADD:
  prove(
    [
      @hol|{(!m n. NUMERAL(m) + NUMERAL(n) = NUMERAL(m + n)) /\
         (_0 + _0 = _0) /\
         (!n. _0 + BIT0 n = BIT0 n) /\
         (!n.        _0 + BIT1 n = BIT1 n) /\
         (!n.   BIT0 n + _0 = BIT0 n) /\
         (!n.   BIT1 n + _0 = BIT1 n) /\
         (!m n. BIT0 m + BIT0 n = BIT0 (m + n)) /\
         (!m n. BIT0 m + BIT1 n = BIT1 (m + n)) /\
         (!m n. BIT1 m + BIT0 n = BIT1 (m + n)) /\
         (!m n. BIT1 m + BIT1 n = BIT0 (SUC(m + n)))}|,
      PURE_REWRITE_TAC(PairList [NUMERAL, BIT0, BIT1, DENUMERAL(ADD_CLAUSES), SUC_INJ]) then_tac \
      REWRITE_TAC(PairList [ADD_AC])
    ]
  )

def ARITH_MULT:
  prove(
    [
      @hol|{(!m n. NUMERAL(m) * NUMERAL(n) = NUMERAL(m * n)) /\
         (_0 * _0 = _0) /\
         (!n. _0 * BIT0 n = _0) /\
         (!n. _0 * BIT1 n = _0) /\
         (!n. BIT0 n * _0 = _0) /\
         (!n. BIT1 n * _0 = _0) /\
         (!m n. BIT0 m * BIT0 n = BIT0 (BIT0 (m * n))) /\
         (!m n. BIT0 m * BIT1 n = BIT0 m + BIT0 (BIT0 (m * n))) /\
         (!m n. BIT1 m * BIT0 n = BIT0 n + BIT0 (BIT0 (m * n))) /\
         (!m n. BIT1 m * BIT1 n = BIT1 m + BIT0 n + BIT0 (BIT0 (m * n)))}|,
      PURE_REWRITE_TAC(
        PairList [
          NUMERAL,
          BIT0,
          BIT1,
          DENUMERAL(MULT_CLAUSES),
          DENUMERAL(ADD_CLAUSES),
          SUC_INJ
        ]
      ) then_tac \
      REWRITE_TAC(PairList [LEFT_ADD_DISTRIB, RIGHT_ADD_DISTRIB, ADD_AC])
    ]
  )

def ARITH_EXP:
  prove(
    [
      @hol|{(!m n. (NUMERAL m) EXP (NUMERAL n) = NUMERAL(m EXP n)) /\
         (_0 EXP _0 = BIT1 _0) /\
         (!m. (BIT0 m) EXP _0 = BIT1 _0) /\
         (!m. (BIT1 m) EXP _0 = BIT1 _0) /\
         (!n. _0 EXP (BIT0 n) = (_0 EXP n) * (_0 EXP n)) /\
         (!m n. (BIT0 m) EXP (BIT0 n) = ((BIT0 m) EXP n) * ((BIT0 m) EXP n)) /\
         (!m n. (BIT1 m) EXP (BIT0 n) = ((BIT1 m) EXP n) * ((BIT1 m) EXP n)) /\
         (!n. _0 EXP (BIT1 n) = _0) /\
         (!m n. (BIT0 m) EXP (BIT1 n) =
              BIT0 m * ((BIT0 m) EXP n) * ((BIT0 m) EXP n)) /\
         (!m n. (BIT1 m) EXP (BIT1 n) =
              BIT1 m * ((BIT1 m) EXP n) * ((BIT1 m) EXP n))}|,
      REWRITE_TAC(PairList [NUMERAL]) then_tac REPEAT(STRIP_TAC) then_tac \
      TRY(GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [BIT0, BIT1])) then_tac \
      REWRITE_TAC(PairList [DENUMERAL(EXP), DENUMERAL(MULT_CLAUSES), EXP_ADD])
    ]
  )

def ARITH_EVEN:
  prove(
    [
      @hol|{(!n. EVEN(NUMERAL n) <=> EVEN n) /\
         (EVEN _0 <=> T) /\
         (!n. EVEN(BIT0 n) <=> T) /\
         (!n. EVEN(BIT1 n) <=> F)}|,
      REWRITE_TAC(PairList [NUMERAL, BIT1, BIT0, DENUMERAL(EVEN), EVEN_ADD])
    ]
  )

def ARITH_ODD:
  prove(
    [
      @hol|{(!n. ODD(NUMERAL n) <=> ODD n) /\
         (ODD _0 <=> F) /\
         (!n. ODD(BIT0 n) <=> F) /\
         (!n. ODD(BIT1 n) <=> T)}|,
      REWRITE_TAC(PairList [NUMERAL, BIT1, BIT0, DENUMERAL(ODD), ODD_ADD])
    ]
  )

def ARITH_LE:
  prove(
    [
      @hol|{(!m n. NUMERAL m <= NUMERAL n <=> m <= n) /\
         ((_0 <= _0) <=> T) /\
         (!n. (BIT0 n <= _0) <=> n <= _0) /\
         (!n. (BIT1 n <= _0) <=> F) /\
         (!n. (_0 <= BIT0 n) <=> T) /\
         (!n. (_0 <= BIT1 n) <=> T) /\
         (!m n. (BIT0 m <= BIT0 n) <=> m <= n) /\
         (!m n. (BIT0 m <= BIT1 n) <=> m <= n) /\
         (!m n. (BIT1 m <= BIT0 n) <=> m < n) /\
         (!m n. (BIT1 m <= BIT1 n) <=> m <= n)}|,
      REWRITE_TAC(
        PairList [
          NUMERAL,
          BIT1,
          BIT0,
          DENUMERAL(NOT_SUC),
          DENUMERAL(GSYM(NOT_SUC)),
          SUC_INJ
        ]
      ) then_tac \
      REWRITE_TAC(PairList [DENUMERAL(LE_0)]) then_tac \
      REWRITE_TAC(PairList [DENUMERAL(LE), GSYM(MULT_2)]) then_tac \
      REWRITE_TAC(
        PairList [
          LE_MULT_LCANCEL,
          SUC_INJ,
          DENUMERAL(MULT_EQ_0),
          DENUMERAL(NOT_SUC)
        ]
      ) then_tac \
      REWRITE_TAC(PairList [DENUMERAL(NOT_SUC)]) then_tac \
      REWRITE_TAC(PairList [LE_SUC_LT]) then_tac \
      REWRITE_TAC(PairList [LT_MULT_LCANCEL]) then_tac \
      SUBGOAL_THEN(
        @hol|{2 = SUC 1}|
      )((fun(th): REWRITE_TAC(PairList [th]))) then_list \
      PairList [
        REWRITE_TAC(PairList [NUMERAL, BIT0, BIT1, DENUMERAL(ADD_CLAUSES)]),
        REWRITE_TAC(PairList [DENUMERAL(NOT_SUC), NOT_SUC, EQ_MULT_LCANCEL]) then_tac \
        REWRITE_TAC(PairList [ONCE_REWRITE_RULE(PairList [DISJ_SYM])(LE_LT)]) then_tac \
        MAP_EVERY(X_GEN_TAC)(PairList [@hol|{m:num}|, @hol|{n:num}|]) then_tac \
        SUBGOAL_THEN(
          @hol|{~(SUC 1 * m = SUC (SUC 1 * n))}|
        )((fun(th): REWRITE_TAC(PairList [th]))) then_tac \
        DISCH_THEN(o(MP_TAC)(AP_TERM(@hol|{EVEN}|))) then_tac \
        REWRITE_TAC(PairList [EVEN_MULT, EVEN_ADD, NUMERAL, BIT1, EVEN])
      ]
    ]
  )

def ARITH_LT:
  prove(
    [
      @hol|{(!m n. NUMERAL m < NUMERAL n <=> m < n) /\
         ((_0 < _0) <=> F) /\
         (!n. (BIT0 n < _0) <=> F) /\
         (!n. (BIT1 n < _0) <=> F) /\
         (!n. (_0 < BIT0 n) <=> _0 < n) /\
         (!n. (_0 < BIT1 n) <=> T) /\
         (!m n. (BIT0 m < BIT0 n) <=> m < n) /\
         (!m n. (BIT0 m < BIT1 n) <=> m <= n) /\
         (!m n. (BIT1 m < BIT0 n) <=> m < n) /\
         (!m n. (BIT1 m < BIT1 n) <=> m < n)}|,
      REWRITE_TAC(PairList [NUMERAL, GSYM(NOT_LE), ARITH_LE]) then_tac \
      REWRITE_TAC(PairList [DENUMERAL(LE)])
    ]
  )

def ARITH_GE = REWRITE_RULE(PairList [GSYM(GE), GSYM(GT)])(ARITH_LE)

def ARITH_GT = REWRITE_RULE(PairList [GSYM(GE), GSYM(GT)])(ARITH_LT)

def ARITH_EQ:
  prove(
    [
      @hol|{(!m n. (NUMERAL m = NUMERAL n) <=> (m = n)) /\
         ((_0 = _0) <=> T) /\
         (!n. (BIT0 n = _0) <=> (n = _0)) /\
         (!n. (BIT1 n = _0) <=> F) /\
         (!n. (_0 = BIT0 n) <=> (_0 = n)) /\
         (!n. (_0 = BIT1 n) <=> F) /\
         (!m n. (BIT0 m = BIT0 n) <=> (m = n)) /\
         (!m n. (BIT0 m = BIT1 n) <=> F) /\
         (!m n. (BIT1 m = BIT0 n) <=> F) /\
         (!m n. (BIT1 m = BIT1 n) <=> (m = n))}|,
      REWRITE_TAC(PairList [NUMERAL, GSYM(LE_ANTISYM), ARITH_LE]) then_tac \
      REWRITE_TAC(PairList [LET_ANTISYM, LTE_ANTISYM, DENUMERAL(LE_0)])
    ]
  )

def ARITH_SUB:
  prove(
    [
      @hol|{(!m n. NUMERAL m - NUMERAL n = NUMERAL(m - n)) /\
         (_0 - _0 = _0) /\
         (!n. _0 - BIT0 n = _0) /\
         (!n. _0 - BIT1 n = _0) /\
         (!n. BIT0 n - _0 = BIT0 n) /\
         (!n. BIT1 n - _0 = BIT1 n) /\
         (!m n. BIT0 m - BIT0 n = BIT0 (m - n)) /\
         (!m n. BIT0 m - BIT1 n = PRE(BIT0 (m - n))) /\
         (!m n. BIT1 m - BIT0 n = if n <= m then BIT1 (m - n) else _0) /\
         (!m n. BIT1 m - BIT1 n = BIT0 (m - n))}|,
      REWRITE_TAC(PairList [NUMERAL, DENUMERAL(SUB_0)]) then_tac \
      PURE_REWRITE_TAC(PairList [BIT0, BIT1]) then_tac \
      REWRITE_TAC(PairList [GSYM(MULT_2), SUB_SUC, LEFT_SUB_DISTRIB]) then_tac \
      REWRITE_TAC(PairList [SUB]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      COND_CASES_TAC then_tac \
      REWRITE_TAC(PairList [DENUMERAL(SUB_EQ_0)]) then_tac \
      RULE_ASSUM_TAC(REWRITE_RULE(PairList [NOT_LE])) then_tac \
      ASM_REWRITE_TAC(PairList [LE_SUC_LT, LT_MULT_LCANCEL, ARITH_EQ]) then_tac \
      POP_ASSUM(o(CHOOSE_THEN(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))) then_tac \
      REWRITE_TAC(PairList [ADD1, LEFT_ADD_DISTRIB]) then_tac \
      REWRITE_TAC(PairList [ADD_SUB2, GSYM(ADD_ASSOC)])
    ]
  )

def ARITH:
  end_itlist(CONJ)(
    PairList [
      ARITH_ZERO,
      ARITH_SUC,
      ARITH_PRE,
      ARITH_ADD,
      ARITH_MULT,
      ARITH_EXP,
      ARITH_EVEN,
      ARITH_ODD,
      ARITH_EQ,
      ARITH_LE,
      ARITH_LT,
      ARITH_GE,
      ARITH_GT,
      ARITH_SUB
    ]
  )

def EXP_2_NE_0:
  prove(
    [
      @hol|{!n. ~(2 EXP n = 0)}|,
      REWRITE_TAC(PairList [EXP_EQ_0, ARITH_EQ])
    ]
  )

def NUM_EVEN_CONV:
  let [tth, rths] = CONJ_PAIR(ARITH_EVEN)
  (GEN_REWRITE_CONV(I)(PairList [tth]) then_conv GEN_REWRITE_CONV(I)(PairList [rths]))

def NUM_ODD_CONV:
  let [tth, rths] = CONJ_PAIR(ARITH_ODD)
  (GEN_REWRITE_CONV(I)(PairList [tth]) then_conv GEN_REWRITE_CONV(I)(PairList [rths]))

def [calc_num_NUM_SUC_CONV_v2, calc_num_NUM_ADD_CONV_v2, calc_num_NUM_MULT_CONV_v2, calc_num_NUM_EXP_CONV_v2, calc_num_NUM_LT_CONV_v2, calc_num_NUM_LE_CONV_v2, NUM_EQ_CONV]:
  let num_ty = type_of(lhand(concl(ZERO_DEF)))
  let Comb(NUMERAL_tm,Comb(BIT0_tm,Comb(BIT1_tm,zero_tm))) = mk_small_numeral(2)
  let suc_tm = rator(rand(concl(TWO)))
  let one_tm = rand(mk_small_numeral(1))
  let add_tm = rator(rator(lhand(snd(strip_forall(concl(ADD_0))))))
  let mul_tm = rator(rator(rand(snd(strip_forall(concl(EXP_2))))))
  let exp_tm = rator(rator(lhand(snd(strip_forall(concl(EXP_2))))))
  let eq_tm = rator(rator(concl(TWO)))
  let num_0 = 0
  let num_1 = 1
  let num_2 = 2
  let a_tm = mk_var(["a", num_ty])
  let b_tm = mk_var(["b", num_ty])
  let c_tm = mk_var(["c", num_ty])
  let d_tm = mk_var(["d", num_ty])
  let e_tm = mk_var(["e", num_ty])
  let h_tm = mk_var(["h", num_ty])
  let l_tm = mk_var(["l", num_ty])
  let m_tm = mk_var(["m", num_ty])
  let n_tm = mk_var(["n", num_ty])
  let p_tm = mk_var(["p", num_ty])
  let ilist:
    PairList [
      [BIT0_tm, BIT0_tm],
      [BIT1_tm, BIT1_tm],
      [zero_tm, zero_tm],
      [suc_tm, suc_tm],
      [add_tm, add_tm],
      [mul_tm, mul_tm],
      [exp_tm, exp_tm],
      [eq_tm, eq_tm],
      [NUMERAL_tm, NUMERAL_tm],
      [a_tm, a_tm],
      [b_tm, b_tm],
      [c_tm, c_tm],
      [d_tm, d_tm],
      [e_tm, e_tm],
      [h_tm, h_tm],
      [l_tm, l_tm],
      [m_tm, m_tm],
      [n_tm, n_tm],
      [p_tm, p_tm]
    ]
  fun replace(tm):
    match tm
    | Var(_,_): rev_assocd(tm)(ilist)(tm)
    | Const(_,_): rev_assocd(tm)(ilist)(tm)
    | Comb(s,t): mk_comb([replace(s), replace(t)])
    | Abs(_,_): failwith("replace")
  let STANDARDIZE:
    fun(th):
      let tm_prime = replace(concl(th))
      EQ_MP(REFL(tm_prime))(th)
  let REFL_bit0 = STANDARDIZE(REFL(BIT0_tm))
  let REFL_bit1 = STANDARDIZE(REFL(BIT1_tm))
  let AP_BIT0 = (fun(th): MK_COMB([REFL_bit0, th]))
  let AP_BIT1 = (fun(th): MK_COMB([REFL_bit1, th]))
  let QUICK_PROVE_HYP_2 = fun(ath): fun(bth): EQ_MP(DEDUCT_ANTISYM_RULE(ath)(bth))(ath)
  fun dest_raw_numeral(tm):
    match tm
    | Comb(Const("BIT1",_),t): ((num_2 * dest_raw_numeral(t)) + num_1)
    | Comb(Const("BIT0",_),t): (num_2 * dest_raw_numeral(t))
    | Const("_0",_): num_0
  // Recursive bit counting needs the local definition before its first use.
  fun bctr(w):
    fun(z):
