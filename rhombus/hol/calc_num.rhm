          Implies(
            Eq(Num, App(Const("FACT", Fun(Num, Num)), [Var("x", Num)]), Var("w", Num)),
            Implies(
              Eq(Num, App(Const("*", Fun(Num, Fun(Num, Num))), [Var("y", Num), Var("w", Num)]), Var("z", Num)),
              Eq(Num, App(Const("FACT", Fun(Num, Num)), [Var("y", Num)]), Var("z", Num))
            )
          )
        )),
        (
          REPEAT(DISCH_THEN(o(SUBST1_TAC)(SYM))) then_tac \
          REWRITE_TAC(PairList [FACT])
        )
      ]
    )
  let w_2 = Host.hol_term(Var("w", Num))
  let x_2 = Host.hol_term(Var("x", Num))
  let y_2 = Host.hol_term(Var("y", Num))
  let z_2 = Host.hol_term(Var("z", Num))
  let mksuc:
    fun(n):
      let n_prime = Host.hol_sub(n)(Host.num(1))
      calc_num_NUM_SUC_CONV_v2(mk_comb([suc_2, mk_numeral(n_prime)]))
  fun NUM_FACT_CONV(n):
    if Host.hol_equal(n)(Host.num(0))
    | pth_0_5
    | let th0 = mksuc(n)
      let tmx = rand(lhand(concl(th0)))
      let tm0 = rand(concl(th0))
      let th1 = NUM_FACT_CONV(Host.hol_sub(n)(Host.num(1)))
      let tm1 = rand(concl(th1))
      let th2 = calc_num_NUM_MULT_CONV_v2(mk_binop(mul_2)(tm0)(tm1))
      let tm2 = rand(concl(th2))
      let pth = INST(PairList [[tmx, x_2], [tm0, y_2], [tm1, w_2], [tm2, z_2]])(pth_suc_2)
      MP(MP(MP(pth)(th0))(th1))(th2)
  fun(tm):
    try:
      let [l, r] = dest_comb(tm)
      (if Host.hol_equal(fst(dest_const(l)))("FACT") | NUM_FACT_CONV(dest_numeral(r)) | Host.hol_apply_unit(fail))
      ~catch exn:
        match exn
        | Failure(_): failwith("NUM_FACT_CONV")
        | exn: Host.hol_raise(exn)

