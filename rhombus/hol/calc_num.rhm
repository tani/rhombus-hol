                        [
                          App(
                            Const("EXP", Fun(Num, Fun(Num, Num))),
                            [Var("a", Num), App(Const("NUMERAL", Fun(Num, Num)), [Var("k", Num)])]
                          ),
                          Var("n", Num)
                        ]
                      ),
                      App(
                        Const("NUMERAL", Fun(Num, Num)),
                        [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                      )
                    ]
                  ),
                  Var("n", Num)
                ]
              )
            ),
            Eq(
              Num,
              App(
                Const("MOD", Fun(Num, Fun(Num, Num))),
                [
                  App(
                    Const("EXP", Fun(Num, Fun(Num, Num))),
                    [
                      Var("a", Num),
                      App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Var("k", Num)])])
                    ]
                  ),
                  Var("n", Num)
                ]
              ),
              App(
                Const("MOD", Fun(Num, Fun(Num, Num))),
                [
                  App(
                    Const("*", Fun(Num, Fun(Num, Num))),
                    [
                      Var("a", Num),
                      App(
                        Const("MOD", Fun(Num, Fun(Num, Num))),
                        [
                          App(
                            Const("EXP", Fun(Num, Fun(Num, Num))),
                            [
                              App(
                                Const("MOD", Fun(Num, Fun(Num, Num))),
                                [
                                  App(
                                    Const("EXP", Fun(Num, Fun(Num, Num))),
                                    [Var("a", Num), App(Const("NUMERAL", Fun(Num, Num)), [Var("k", Num)])]
                                  ),
                                  Var("n", Num)
                                ]
                              ),
                              App(
                                Const("NUMERAL", Fun(Num, Num)),
                                [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                              )
                            ]
                          ),
                          Var("n", Num)
                        ]
                      )
                    ]
                  ),
                  Var("n", Num)
                ]
              )
            )
          )
        )),
        (
          (
            (
              (
                REWRITE_TAC(PairList [EXP, EXP_2]) then_tac \
                REWRITE_TAC(PairList [BIT0, BIT1, NUMERAL])
              ) then_tac \
              REWRITE_TAC(PairList [EXP, EXP_ADD])
            ) then_tac \
            CONV_TAC(MOD_DOWN_CONV)
          ) then_tac \
          REWRITE_TAC(PairList [])
        )
      ]
    )
  let conv_zero_2 = GEN_REWRITE_CONV(I, PairList [MOD_ZERO])
  let conv_0_2 = GEN_REWRITE_CONV(I, PairList [pth_0])
  let conv_even_2 = GEN_REWRITE_CONV(I, PairList [pth_even])
  let conv_odd_2 = GEN_REWRITE_CONV(I, PairList [pth_odd])
  fun conv_2(tm):
    (
      (
        (conv_0_2 then_conv NUM_MOD_CONV) or_conv \
        (
          (
            conv_even_2 then_conv \
            LAND_CONV((LAND_CONV(conv_2) then_conv calc_num_NUM_EXP_CONV_v2))
          ) then_conv \
          NUM_MOD_CONV
        )
      ) or_conv \
      (
        (
          conv_odd_2 then_conv \
          LAND_CONV(
            (
              RAND_CONV(
                (
                  LAND_CONV((LAND_CONV(conv_2) then_conv calc_num_NUM_EXP_CONV_v2)) then_conv \
                  NUM_MOD_CONV
                )
              ) then_conv \
              calc_num_NUM_MULT_CONV_v2
            )
          )
        ) then_conv \
        NUM_MOD_CONV
      )
    )(tm)
  let fullconv = ((conv_zero_2 then_conv calc_num_NUM_EXP_CONV_v2) or_conv conv_2)
  fun(tm):
    match tm
    | Comb(Comb(Const("MOD",_),Comb(Comb(Const("EXP",_),m),k)),n):
        if (is_numeral(m) && (is_numeral(k) && is_numeral(n)))
        | fullconv(tm)
        | match tm
          | _: failwith("EXP_MOD_CONV")
    | _: failwith("EXP_MOD_CONV")

def NUM_SUC_CONV = calc_num_NUM_SUC_CONV_v2

def NUM_ADD_CONV = calc_num_NUM_ADD_CONV_v2

def NUM_MULT_CONV = calc_num_NUM_MULT_CONV_v2

def NUM_EXP_CONV = calc_num_NUM_EXP_CONV_v2

def NUM_LT_CONV = calc_num_NUM_LT_CONV_v2

def NUM_LE_CONV = calc_num_NUM_LE_CONV_v2

def NUM_DIV_CONV = calc_num_NUM_DIV_CONV_v2
