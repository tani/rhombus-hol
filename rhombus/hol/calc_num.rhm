def NUM_FACT_CONV:
  let suc_2 = Host.hol_term(Const("SUC", Fun(Num, Num)))
  let mul_2 = Host.hol_term(Const("*", Fun(Num, Fun(Num, Num))))
  let pth_0_5:
    prove(
