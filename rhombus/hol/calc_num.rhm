                      let tm1 = lhand(rand(concl(th1)))
                      TRANS(th1)(NUM_ADD_RULE(tm1)(tm_prime))
                    | let th0 = NUM_MUL_RULE_2(k)((l - 1))(tm)(ntm)
                      let ptm = rand(concl(th0))
                      let th1 = EQ_MP(INST(PairList [[tm, m_tm], [ntm, n_tm], [ptm, p_tm]])(pth_oddr))(th0)
                      let tm1 = lhand(rand(concl(th1)))
                      TRANS(th1)(NUM_ADD_RULE(tm1)(tm))
              | let mval = dest_raw_numeral(mtm)
                let nval = dest_raw_numeral(ntm)
                if (nval <= mval)
                | let ptm = rand(mk_numeral((mval - nval)))
