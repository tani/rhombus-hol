          | let th1 = NUM_SQUARE_RULE(mtm)
            let ptm = rand(concl(th1))
            EQ_MP(INST(PairList [[mtm, m_tm], [ptm, p_tm]])(pth_refl_2))(th1)
          | let [w1, z1] = bitcounts(mtm)
            let [w2, z2] = bitcounts(ntm)
            let th1 = NUM_MUL_RULE((w1 + z1))((w2 + z2))(mtm)(ntm)
            let ptm = rand(concl(th1))
            let th2 = INST(PairList [[mtm, m_tm], [ntm, n_tm], [ptm, p_tm]])(topthm_mul)
            EQ_MP(th2)(th1)
      | _: failwith("NUM_MULT_CONV")
  let pth0:
    o(STANDARDIZE)(prove)(
      [
        @hol|{(m EXP n = p) ==> (p * p = a) ==> (m EXP (BIT0 n) = a)}|,
        REPEAT(DISCH_THEN(o(SUBST1_TAC)(SYM))) then_tac \
        REWRITE_TAC(PairList [BIT0, EXP_ADD])
      ]
    )
  let pth1:
    o(STANDARDIZE)(prove)(
      [
        @hol|{(m EXP n = p) ==> (p * p = b) ==> (m * b = a) ==> (m EXP (BIT1 n) = a)}|,
        REPEAT(DISCH_THEN(o(SUBST1_TAC)(SYM))) then_tac \
        REWRITE_TAC(PairList [BIT1, EXP_ADD, EXP])
      ]
    )
  let pth_2:
    o(STANDARDIZE)(prove)(
      [
        @hol|{m EXP _0 = BIT1 _0}|,
        MP_TAC(CONJUNCT1(EXP)) then_tac \
        REWRITE_TAC(PairList [NUMERAL, BIT1]) then_tac \
        DISCH_THEN(MATCH_ACCEPT_TAC)
      ]
    )
  let tth:
    o(STANDARDIZE)(prove)(
      [
        @hol|{(NUMERAL m) EXP (NUMERAL n) = m EXP n}|,
        REWRITE_TAC(PairList [NUMERAL])
      ]
    )
  let fth:
    o(STANDARDIZE)(prove)(
      [
        @hol|{m = NUMERAL m}|,
        REWRITE_TAC(PairList [NUMERAL])
      ]
    )
  let tconv = GEN_REWRITE_CONV(I)(PairList [tth])
  // Recursive exponentiation needs the local definition before its first use.
  fun NUM_EXP_CONV_2(l):
    fun(r):
      if (r == zero_tm)
      | INST(PairList [[l, m_tm]])(pth_2)
      | let [b, r_prime] = dest_comb(r)
        if (b == BIT0_tm)
        | let th1 = NUM_EXP_CONV_2(l)(r_prime)
          let tm1 = rand(concl(th1))
          let th2 = NUM_MULT_CONV_prime(mk_binop(mul_tm)(tm1)(tm1))
          let tm2 = rand(concl(th2))
          MP(
            MP(INST(PairList [[l, m_tm], [r_prime, n_tm], [tm1, p_tm], [tm2, a_tm]])(pth0))(th1)
          )(th2)
        | let th1 = NUM_EXP_CONV_2(l)(r_prime)
          let tm1 = rand(concl(th1))
          let th2 = NUM_MULT_CONV_prime(mk_binop(mul_tm)(tm1)(tm1))
          let tm2 = rand(concl(th2))
          let th3 = NUM_MULT_CONV_prime(mk_binop(mul_tm)(l)(tm2))
          let tm3 = rand(concl(th3))
          MP(
            MP(
              MP(
                INST(PairList [[l, m_tm], [r_prime, n_tm], [tm1, p_tm], [tm2, b_tm], [tm3, a_tm]])(pth1)
              )(th1)
            )(th2)
          )(th3)
  let NUM_EXP_CONV:
    fun(tm):
      try:
        let th = tconv(tm)
        let [lop, r] = dest_comb(rand(concl(th)))
        let [_, l] = dest_comb(lop)
        if !(wellformed(l) && wellformed(r))
        | failwith("")
        | let th_prime = NUM_EXP_CONV_2(l)(r)
          let tm_prime = rand(concl(th_prime))
          TRANS(TRANS(th)(th_prime))(INST(PairList [[tm_prime, m_tm]])(fth))
        ~catch exn:
          match exn
          | Failure(_): failwith("NUM_EXP_CONV")
          | exn: (throw exn)
  let pth_3:
    o(o(UNDISCH)(STANDARDIZE))(prove)(
      [
        @hol|{SUC(m + n) = p ==> ((NUMERAL n < NUMERAL p) <=> T)}|,
        REWRITE_TAC(PairList [NUMERAL, LT_EXISTS, ADD_CLAUSES]) then_tac \
        MESON_TAC(PairList [ADD_SYM])
      ]
    )
  let qth:
    o(o(UNDISCH)(STANDARDIZE))(prove)(
      [
        @hol|{m + p = n ==> (NUMERAL n < NUMERAL p <=> F)}|,
        DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
        REWRITE_TAC(PairList [NOT_LT, NUMERAL]) then_tac \
        MESON_TAC(PairList [LE_ADD, ADD_SYM])
      ]
    )
  let rth:
    o(STANDARDIZE)(prove)(
      [
        @hol|{NUMERAL n < NUMERAL n <=> F}|,
        MESON_TAC(PairList [LT_REFL])
      ]
    )
  let NUM_LT_CONV_2:
    fun(tm):
      match tm
      | Comb(Comb(Const("<",_),Comb(Const("NUMERAL",_),mtm)),Comb(Const("NUMERAL",_),ntm)):
          let rel = orderrelation(mtm)(ntm)
          if (rel == 0)
          | INST(PairList [[ntm, n_tm]])(rth)
          | if (rel < 0)
            | let dtm = sbcbn(ntm)(mtm)
              let th = NUM_ADC_RULE(dtm)(mtm)
              QUICK_PROVE_HYP_2(th)(INST(PairList [[dtm, m_tm], [mtm, n_tm], [ntm, p_tm]])(pth_3))
            | let dtm = subbn(mtm)(ntm)
              let th = NUM_ADD_RULE(dtm)(ntm)
              QUICK_PROVE_HYP_2(th)(INST(PairList [[dtm, m_tm], [mtm, n_tm], [ntm, p_tm]])(qth))
      | _: failwith("NUM_LT_CONV")
  let pth_4:
    o(o(UNDISCH)(STANDARDIZE))(prove)(
      [
        @hol|{m + n = p ==> ((NUMERAL n <= NUMERAL p) <=> T)}|,
        DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
        REWRITE_TAC(PairList [NUMERAL]) then_tac \
        MESON_TAC(PairList [LE_ADD, ADD_SYM])
      ]
    )
  let qth:
    o(o(UNDISCH)(STANDARDIZE))(prove)(
      [
        @hol|{SUC(m + p) = n ==> (NUMERAL n <= NUMERAL p <=> F)}|,
        DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
        REWRITE_TAC(PairList [NUMERAL, NOT_LE, ADD_CLAUSES, LT_EXISTS]) then_tac \
        MESON_TAC(PairList [ADD_SYM])
      ]
    )
  let rth:
    o(STANDARDIZE)(prove)(
      [
        @hol|{NUMERAL n <= NUMERAL n <=> T}|,
        REWRITE_TAC(PairList [LE_REFL])
      ]
    )
  let NUM_LE_CONV_2:
    fun(tm):
      match tm
      | Comb(Comb(Const("<=",_),Comb(Const("NUMERAL",_),mtm)),Comb(Const("NUMERAL",_),ntm)):
          let rel = orderrelation(mtm)(ntm)
          if (rel == 0)
          | INST(PairList [[ntm, n_tm]])(rth)
          | if (rel < 0)
            | let dtm = subbn(ntm)(mtm)
              let th = NUM_ADD_RULE(dtm)(mtm)
              QUICK_PROVE_HYP_2(th)(INST(PairList [[dtm, m_tm], [mtm, n_tm], [ntm, p_tm]])(pth_4))
            | let dtm = sbcbn(mtm)(ntm)
              let th = NUM_ADC_RULE(dtm)(ntm)
              QUICK_PROVE_HYP_2(th)(INST(PairList [[dtm, m_tm], [mtm, n_tm], [ntm, p_tm]])(qth))
      | _: failwith("NUM_LE_CONV")
  let pth_5:
    o(o(UNDISCH)(STANDARDIZE))(prove)(
      [
        @hol|{SUC(m + n) = p ==> ((NUMERAL n = NUMERAL p) <=> F)}|,
        DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
        REWRITE_TAC(PairList [NUMERAL, GSYM(LE_ANTISYM), DE_MORGAN_THM]) then_tac \
        REWRITE_TAC(PairList [NOT_LE, LT_EXISTS, ADD_CLAUSES]) then_tac \
        MESON_TAC(PairList [ADD_SYM])
      ]
    )
  let qth:
    o(o(UNDISCH)(STANDARDIZE))(prove)(
      [
        @hol|{SUC(m + p) = n ==> ((NUMERAL n = NUMERAL p) <=> F)}|,
        DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
        REWRITE_TAC(PairList [NUMERAL, GSYM(LE_ANTISYM), DE_MORGAN_THM]) then_tac \
        REWRITE_TAC(PairList [NOT_LE, LT_EXISTS, ADD_CLAUSES]) then_tac \
        MESON_TAC(PairList [ADD_SYM])
      ]
    )
  let rth:
    o(STANDARDIZE)(prove)(
      [
        @hol|{(NUMERAL n = NUMERAL n) <=> T}|,
        REWRITE_TAC(PairList [])
      ]
    )
  let NUM_EQ_CONV_2:
    fun(tm):
      match tm
      | Comb(Comb(Const("=",_),Comb(Const("NUMERAL",_),mtm)),Comb(Const("NUMERAL",_),ntm)):
          let rel = orderrelation(mtm)(ntm)
          if (rel == 0)
          | INST(PairList [[ntm, n_tm]])(rth)
          | if (rel < 0)
            | let dtm = sbcbn(ntm)(mtm)
              let th = NUM_ADC_RULE(dtm)(mtm)
              QUICK_PROVE_HYP_2(th)(INST(PairList [[dtm, m_tm], [mtm, n_tm], [ntm, p_tm]])(pth_5))
            | let dtm = sbcbn(mtm)(ntm)
              let th = NUM_ADC_RULE(dtm)(ntm)
              QUICK_PROVE_HYP_2(th)(INST(PairList [[dtm, m_tm], [mtm, n_tm], [ntm, p_tm]])(qth))
      | _: failwith("NUM_EQ_CONV")
  [
    NUM_SUC_CONV,
    NUM_ADD_CONV,
    NUM_MULT_CONV,
    NUM_EXP_CONV,
    NUM_LT_CONV_2,
    NUM_LE_CONV_2,
    NUM_EQ_CONV_2
  ]

def NUM_GT_CONV = (GEN_REWRITE_CONV(I)(PairList [GT]) then_conv calc_num_NUM_LT_CONV_v2)

def NUM_GE_CONV = (GEN_REWRITE_CONV(I)(PairList [GE]) then_conv calc_num_NUM_LE_CONV_v2)

def NUM_PRE_CONV:
  let tth:
    prove(
      [
        @hol|{PRE 0 = 0}|,
        REWRITE_TAC(PairList [PRE])
      ]
    )
  let pth:
    prove(
      [
        @hol|{(SUC m = n) ==> (PRE n = m)}|,
        DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
        REWRITE_TAC(PairList [PRE])
      ]
    )
  let m = @hol|{m:num}|
  let n = @hol|{n:num}|
  let suc = @hol|{SUC}|
  let pre = @hol|{PRE}|
  fun(tm):
    try:
      let [l, r] = dest_comb(tm)
      if !(l == pre)
      | fail()
      | let x = dest_numeral(r)
        if (x == 0)
        | tth
        | let tm_prime = mk_numeral((x - 1))
          let th1 = calc_num_NUM_SUC_CONV_v2(mk_comb([suc, tm_prime]))
          MP(INST(PairList [[tm_prime, m], [r, n]])(pth))(th1)
      ~catch exn:
        match exn
        | Failure(_): failwith("NUM_PRE_CONV")
        | exn: (throw exn)

def NUM_SUB_CONV:
  let pth0:
    prove(
      [
        @hol|{p <= n ==> (p - n = 0)}|,
        REWRITE_TAC(PairList [SUB_EQ_0])
      ]
    )
  let pth1:
    prove(
      [
        @hol|{(m + n = p) ==> (p - n = m)}|,
        DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
        REWRITE_TAC(PairList [ADD_SUB])
      ]
    )
  let m = @hol|{m:num}|
  let n = @hol|{n:num}|
  let p = @hol|{p:num}|
  let minus = @hol|{(-)}|
  let plus = @hol|{(+)}|
  let le = @hol|{(<=)}|
  fun(tm):
    try:
      let [l, r] = dest_binop(minus)(tm)
      let ln = dest_numeral(l)
      let rn = dest_numeral(r)
      if (ln <= rn)
      | let pth = INST(PairList [[l, p], [r, n]])(pth0)
        let th0 = EQT_ELIM(calc_num_NUM_LE_CONV_v2(mk_binop(le)(l)(r)))
        MP(pth)(th0)
      | let kn = (ln - rn)
        let k = mk_numeral(kn)
        let pth = INST(PairList [[k, m], [l, p], [r, n]])(pth1)
        let th0 = calc_num_NUM_ADD_CONV_v2(mk_binop(plus)(k)(r))
        MP(pth)(th0)
      ~catch exn:
        match exn
        | Failure(_): failwith("NUM_SUB_CONV")
        | exn: (throw exn)

def [calc_num_NUM_DIV_CONV_v2, NUM_MOD_CONV]:
  let pth:
    prove(
      [
        @hol|{q * n + r = m ==> r < n ==> m DIV n = q /\ m MOD n = r}|,
        MESON_TAC(PairList [DIVMOD_UNIQ])
      ]
    )
  let pth0:
    prove(
      [
        @hol|{!m. m DIV 0 = 0 /\ m MOD 0 = m}|,
        REWRITE_TAC(PairList [DIV_ZERO, MOD_ZERO])
      ]
    )
  let m = @hol|{m:num}|
  let n = @hol|{n:num}|
  let q = @hol|{q:num}|
  let r = @hol|{r:num}|
  let dtm = @hol|{(DIV)}|
  let mtm = @hol|{(MOD)}|
  let NUM_DIVMOD_CONV:
    fun(x):
      fun(y):
        if (y == num_0)
        | SPEC(mk_numeral(x))(pth0)
        | let k = quo_num(x)(y)
          let l = mod_num(x)(y)
          let th0:
            INST(
              PairList [
                [mk_numeral(x), m],
                [mk_numeral(y), n],
                [mk_numeral(k), q],
                [mk_numeral(l), r]
              ]
            )(pth)
          let tm0 = lhand(lhand(concl(th0)))
          let th1 = (LAND_CONV(calc_num_NUM_MULT_CONV_v2) then_conv calc_num_NUM_ADD_CONV_v2)(tm0)
          let th2 = MP(th0)(th1)
          let tm2 = lhand(concl(th2))
          MP(th2)(EQT_ELIM(calc_num_NUM_LT_CONV_v2(tm2)))
  [
    fun(tm):
      try:
        let [xt, yt] = dest_binop(dtm)(tm)
        CONJUNCT1(NUM_DIVMOD_CONV(dest_numeral(xt))(dest_numeral(yt)))
        ~catch exn:
          match exn
          | Failure(_): failwith("NUM_DIV_CONV")
          | exn: (throw exn),
    fun(tm):
      try:
        let [xt, yt] = dest_binop(mtm)(tm)
        CONJUNCT2(NUM_DIVMOD_CONV(dest_numeral(xt))(dest_numeral(yt)))
        ~catch exn:
          match exn
          | Failure(_): failwith("NUM_MOD_CONV")
          | exn: (throw exn)
  ]

def NUM_FACT_CONV:
  let suc = @hol|{SUC}|
  let mul = @hol|{(*)}|
  let pth_0:
    prove(
      [
        @hol|{FACT 0 = 1}|,
        REWRITE_TAC(PairList [FACT])
      ]
    )
  let pth_suc:
    prove(
      [
        @hol|{(SUC x = y) ==> (FACT x = w) ==> (y * w = z) ==> (FACT y = z)}|,
        REPEAT(DISCH_THEN(o(SUBST1_TAC)(SYM))) then_tac \
        REWRITE_TAC(PairList [FACT])
      ]
    )
  let w = @hol|{w:num}|
  let x = @hol|{x:num}|
  let y = @hol|{y:num}|
  let z = @hol|{z:num}|
  let mksuc:
    fun(n):
      let n_prime = (n - 1)
      calc_num_NUM_SUC_CONV_v2(mk_comb([suc, mk_numeral(n_prime)]))
  fun NUM_FACT_CONV(n):
    if (n == 0)
    | pth_0
    | let th0 = mksuc(n)
      let tmx = rand(lhand(concl(th0)))
      let tm0 = rand(concl(th0))
      let th1 = NUM_FACT_CONV((n - 1))
      let tm1 = rand(concl(th1))
      let th2 = calc_num_NUM_MULT_CONV_v2(mk_binop(mul)(tm0)(tm1))
      let tm2 = rand(concl(th2))
      let pth = INST(PairList [[tmx, x], [tm0, y], [tm1, w], [tm2, z]])(pth_suc)
      MP(MP(MP(pth)(th0))(th1))(th2)
  fun(tm):
    try:
      let [l, r] = dest_comb(tm)
      (if (fst(dest_const(l)) == "FACT") | NUM_FACT_CONV(dest_numeral(r)) | fail())
      ~catch exn:
        match exn
        | Failure(_): failwith("NUM_FACT_CONV")
        | exn: (throw exn)

def NUM_MAX_CONV:
  (
    REWR_CONV(MAX) then_conv \
    RATOR_CONV(RATOR_CONV(RAND_CONV(calc_num_NUM_LE_CONV_v2))) then_conv \
    GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES])
  )

def NUM_MIN_CONV:
  (
    REWR_CONV(MIN) then_conv \
    RATOR_CONV(RATOR_CONV(RAND_CONV(calc_num_NUM_LE_CONV_v2))) then_conv \
    GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES])
  )

def NUM_REL_CONV:
  let gconv_net:
    itlist(uncurry(net_of_conv))(
      PairList [
        [
          @hol|{NUMERAL m < NUMERAL n}|,
          calc_num_NUM_LT_CONV_v2
        ],
        [
          @hol|{NUMERAL m <= NUMERAL n}|,
          calc_num_NUM_LE_CONV_v2
        ],
        [
          @hol|{NUMERAL m > NUMERAL n}|,
          NUM_GT_CONV
        ],
        [
          @hol|{NUMERAL m >= NUMERAL n}|,
          NUM_GE_CONV
        ],
        [
          @hol|{NUMERAL m = NUMERAL n}|,
          NUM_EQ_CONV
        ]
      ]
    )(basic_net(#void))
  REWRITES_CONV(gconv_net)

def num_red_conv_list:
  PairList [
    [
      @hol|{SUC(NUMERAL n)}|,
      calc_num_NUM_SUC_CONV_v2
    ],
    [
      @hol|{PRE(NUMERAL n)}|,
      NUM_PRE_CONV
    ],
    [
      @hol|{FACT(NUMERAL n)}|,
      NUM_FACT_CONV
    ],
    [
      @hol|{NUMERAL m < NUMERAL n}|,
      calc_num_NUM_LT_CONV_v2
    ],
    [
      @hol|{NUMERAL m <= NUMERAL n}|,
      calc_num_NUM_LE_CONV_v2
    ],
    [
      @hol|{NUMERAL m > NUMERAL n}|,
      NUM_GT_CONV
    ],
    [
      @hol|{NUMERAL m >= NUMERAL n}|,
      NUM_GE_CONV
    ],
    [
      @hol|{NUMERAL m = NUMERAL n}|,
      NUM_EQ_CONV
    ],
    [
      @hol|{EVEN(NUMERAL n)}|,
      NUM_EVEN_CONV
    ],
    [
      @hol|{ODD(NUMERAL n)}|,
      NUM_ODD_CONV
    ],
    [
      @hol|{NUMERAL m + NUMERAL n}|,
      calc_num_NUM_ADD_CONV_v2
    ],
    [
      @hol|{NUMERAL m - NUMERAL n}|,
      NUM_SUB_CONV
    ],
    [
      @hol|{NUMERAL m * NUMERAL n}|,
      calc_num_NUM_MULT_CONV_v2
    ],
    [
      @hol|{(NUMERAL m) EXP (NUMERAL n)}|,
      calc_num_NUM_EXP_CONV_v2
    ],
    [
      @hol|{(NUMERAL m) DIV (NUMERAL n)}|,
      calc_num_NUM_DIV_CONV_v2
    ],
    [
      @hol|{(NUMERAL m) MOD (NUMERAL n)}|,
      NUM_MOD_CONV
    ],
    [
      @hol|{MAX (NUMERAL m) (NUMERAL n)}|,
      NUM_MAX_CONV
    ],
    [
      @hol|{MIN (NUMERAL m) (NUMERAL n)}|,
      NUM_MIN_CONV
    ]
  ]

def NUM_RED_CONV:
  let gconv_net = itlist(uncurry(net_of_conv))(num_red_conv_list)(basic_net(#void))
  REWRITES_CONV(gconv_net)

def NUM_REDUCE_CONV = DEPTH_CONV(NUM_RED_CONV)

def num_compute_add_convs:
  let convlist:
    map(
      fun([pat, the_conv]):
        let [c, args] = strip_comb(pat)
        [c, length(args), the_conv]
    )(num_red_conv_list)
  (fun(compset): itlist(fun(newc): fun(_): Compute.Compute.add_conv(newc)(compset))(convlist)(#void))

def NUM_COMPUTE_CONV:
  let cs = Compute.Compute.bool_compset(#void)
  Compute.Compute.set_skip(cs)(@hol|{COND: bool -> A -> A -> A}|)(Some(1))
  num_compute_add_convs(cs)
  Compute.Compute.WEAK_CBV_CONV(cs)

def NUM_REDUCE_TAC = CONV_TAC(NUM_REDUCE_CONV)

def num_CONV:
  let SUC_tm = @hol|{SUC}|
  fun(tm):
    let n = (dest_numeral(tm) - 1)
    if (n < 0)
    | failwith("num_CONV")
    | let tm_prime = mk_numeral(n)
      SYM(calc_num_NUM_SUC_CONV_v2(mk_comb([SUC_tm, tm_prime])))

def EXPAND_CASES_CONV:
  let pth_base:
    prove(
      [
        @hol|{(!n. n < 0 ==> P n) <=> T}|,
        REWRITE_TAC(PairList [LT])
      ]
    )
  let pth_step:
    prove(
      [
        @hol|{(!n. n < SUC k ==> P n) <=> (!n. n < k ==> P n) /\ P k}|,
        REWRITE_TAC(PairList [LT]) then_tac MESON_TAC(PairList [])
      ]
    )
  let base_CONV = GEN_REWRITE_CONV(I)(PairList [pth_base])
  let step_CONV:
    (
      BINDER_CONV(LAND_CONV(RAND_CONV(num_CONV))) then_conv \
      GEN_REWRITE_CONV(I)(PairList [pth_step])
    )
  fun conv(tm): (base_CONV or_conv (step_CONV then_conv LAND_CONV(conv)))(tm)
  (conv then_conv REWRITE_CONV(PairList [GSYM(CONJ_ASSOC)]))

def EXP_MOD_CONV:
  let PairList [pth_0, & PairList [pth_even, & PairList [pth_odd, & PairList []]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{(a EXP 0) MOD n = 1 MOD n /\
           (a EXP (NUMERAL(BIT0 k))) MOD n =
           ((a EXP (NUMERAL k) MOD n) EXP 2) MOD n /\
           (a EXP (NUMERAL(BIT1 k))) MOD n =
           (a * ((a EXP (NUMERAL k) MOD n) EXP 2) MOD n) MOD n}|,
        REWRITE_TAC(PairList [EXP, EXP_2]) then_tac \
        REWRITE_TAC(PairList [BIT0, BIT1, NUMERAL]) then_tac \
        REWRITE_TAC(PairList [EXP, EXP_ADD]) then_tac \
        CONV_TAC(MOD_DOWN_CONV) then_tac \
        REWRITE_TAC(PairList [])
      ]
    )
  let conv_zero = GEN_REWRITE_CONV(I)(PairList [MOD_ZERO])
  let conv_0 = GEN_REWRITE_CONV(I)(PairList [pth_0])
  let conv_even = GEN_REWRITE_CONV(I)(PairList [pth_even])
  let conv_odd = GEN_REWRITE_CONV(I)(PairList [pth_odd])
  fun conv(tm):
    (
      conv_0 then_conv NUM_MOD_CONV or_conv \
      (
        conv_even then_conv \
        LAND_CONV(LAND_CONV(conv) then_conv calc_num_NUM_EXP_CONV_v2) then_conv \
        NUM_MOD_CONV
      ) or_conv \
      (
        conv_odd then_conv \
        LAND_CONV(
          RAND_CONV(
            LAND_CONV(LAND_CONV(conv) then_conv calc_num_NUM_EXP_CONV_v2) then_conv \
            NUM_MOD_CONV
          ) then_conv \
          calc_num_NUM_MULT_CONV_v2
        ) then_conv \
        NUM_MOD_CONV
      )
    )(tm)
  let fullconv = (conv_zero then_conv calc_num_NUM_EXP_CONV_v2 or_conv conv)
  fun(tm):
    match tm
    | Comb(Comb(Const("MOD",_),Comb(Comb(Const("EXP",_),m),k)),n):
        if (is_numeral(m) && (is_numeral(k) && is_numeral(n)))
        | fullconv(tm)
        | match tm
          | _: failwith("EXP_MOD_CONV")
    | _: failwith("EXP_MOD_CONV")

def NUM_SUC_CONV = calc_num_NUM_SUC_CONV_v2

def NUM_ADD_CONV = calc_num_NUM_ADD_CONV_v2

def NUM_MULT_CONV = calc_num_NUM_MULT_CONV_v2

def NUM_EXP_CONV = calc_num_NUM_EXP_CONV_v2

def NUM_LT_CONV = calc_num_NUM_LT_CONV_v2

def NUM_LE_CONV = calc_num_NUM_LE_CONV_v2

def NUM_DIV_CONV = calc_num_NUM_DIV_CONV_v2
