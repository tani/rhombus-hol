def ARITH_GE = REWRITE_RULE(PairList [GSYM(GE), GSYM(GT)])(ARITH_LE)

def ARITH_GT = REWRITE_RULE(PairList [GSYM(GE), GSYM(GT)])(ARITH_LT)

def ARITH_EQ:
  prove(
    [
      Host.hol_term(And(
        Forall(
          "m",
          Num,
          Forall(
            "n",
            Num,
            Iff(
              Eq(
                Num,
                App(Const("NUMERAL", Fun(Num, Num)), [Ref("m")]),
                App(Const("NUMERAL", Fun(Num, Num)), [Ref("n")])
              ),
              Eq(Num, Ref("m"), Ref("n"))
            )
          )
        ),
        And(
          Iff(Eq(Num, Const("_0", Num), Const("_0", Num)), True),
          And(
            Forall(
              "n",
              Num,
              Iff(
                Eq(Num, App(Const("BIT0", Fun(Num, Num)), [Ref("n")]), Const("_0", Num)),
                Eq(Num, Ref("n"), Const("_0", Num))
              )
            ),
            And(
              Forall(
                "n",
                Num,
                Iff(Eq(Num, App(Const("BIT1", Fun(Num, Num)), [Ref("n")]), Const("_0", Num)), False)
              ),
              And(
                Forall(
                  "n",
                  Num,
                  Iff(
                    Eq(Num, Const("_0", Num), App(Const("BIT0", Fun(Num, Num)), [Ref("n")])),
                    Eq(Num, Const("_0", Num), Ref("n"))
                  )
                ),
                And(
                  Forall(
                    "n",
                    Num,
                    Iff(Eq(Num, Const("_0", Num), App(Const("BIT1", Fun(Num, Num)), [Ref("n")])), False)
                  ),
                  And(
                    Forall(
                      "m",
                      Num,
                      Forall(
                        "n",
                        Num,
                        Iff(
                          Eq(
                            Num,
                            App(Const("BIT0", Fun(Num, Num)), [Ref("m")]),
                            App(Const("BIT0", Fun(Num, Num)), [Ref("n")])
                          ),
                          Eq(Num, Ref("m"), Ref("n"))
                        )
                      )
                    ),
                    And(
                      Forall(
                        "m",
                        Num,
                        Forall(
                          "n",
                          Num,
                          Iff(
                            Eq(
                              Num,
                              App(Const("BIT0", Fun(Num, Num)), [Ref("m")]),
                              App(Const("BIT1", Fun(Num, Num)), [Ref("n")])
                            ),
                            False
                          )
                        )
                      ),
                      And(
                        Forall(
                          "m",
                          Num,
                          Forall(
                            "n",
                            Num,
                            Iff(
                              Eq(
                                Num,
                                App(Const("BIT1", Fun(Num, Num)), [Ref("m")]),
                                App(Const("BIT0", Fun(Num, Num)), [Ref("n")])
                              ),
                              False
                            )
                          )
                        ),
                        Forall(
                          "m",
                          Num,
                          Forall(
                            "n",
                            Num,
                            Iff(
                              Eq(
                                Num,
                                App(Const("BIT1", Fun(Num, Num)), [Ref("m")]),
                                App(Const("BIT1", Fun(Num, Num)), [Ref("n")])
                              ),
                              Eq(Num, Ref("m"), Ref("n"))
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        REWRITE_TAC(PairList [NUMERAL, GSYM(LE_ANTISYM), ARITH_LE]) then_tac \
        REWRITE_TAC(PairList [LET_ANTISYM, LTE_ANTISYM, DENUMERAL(LE_0)])
      )
    ]
  )

def ARITH_SUB:
  prove(
    [
      Host.hol_term(And(
        Forall(
          "m",
          Num,
          Forall(
            "n",
            Num,
            Eq(
              Num,
              App(
                Const("-", Fun(Num, Fun(Num, Num))),
                [
                  App(Const("NUMERAL", Fun(Num, Num)), [Ref("m")]),
                  App(Const("NUMERAL", Fun(Num, Num)), [Ref("n")])
                ]
              ),
              App(
                Const("NUMERAL", Fun(Num, Num)),
                [App(Const("-", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])]
              )
            )
          )
        ),
        And(
          Eq(
            Num,
            App(Const("-", Fun(Num, Fun(Num, Num))), [Const("_0", Num), Const("_0", Num)]),
            Const("_0", Num)
          ),
          And(
            Forall(
              "n",
              Num,
              Eq(
                Num,
                App(
                  Const("-", Fun(Num, Fun(Num, Num))),
                  [Const("_0", Num), App(Const("BIT0", Fun(Num, Num)), [Ref("n")])]
                ),
                Const("_0", Num)
              )
            ),
            And(
              Forall(
                "n",
                Num,
                Eq(
                  Num,
                  App(
                    Const("-", Fun(Num, Fun(Num, Num))),
                    [Const("_0", Num), App(Const("BIT1", Fun(Num, Num)), [Ref("n")])]
                  ),
                  Const("_0", Num)
                )
              ),
              And(
                Forall(
                  "n",
                  Num,
                  Eq(
                    Num,
                    App(
                      Const("-", Fun(Num, Fun(Num, Num))),
                      [App(Const("BIT0", Fun(Num, Num)), [Ref("n")]), Const("_0", Num)]
                    ),
                    App(Const("BIT0", Fun(Num, Num)), [Ref("n")])
                  )
                ),
                And(
                  Forall(
                    "n",
                    Num,
                    Eq(
                      Num,
                      App(
                        Const("-", Fun(Num, Fun(Num, Num))),
                        [App(Const("BIT1", Fun(Num, Num)), [Ref("n")]), Const("_0", Num)]
                      ),
                      App(Const("BIT1", Fun(Num, Num)), [Ref("n")])
                    )
                  ),
                  And(
                    Forall(
                      "m",
                      Num,
                      Forall(
                        "n",
                        Num,
                        Eq(
                          Num,
                          App(
                            Const("-", Fun(Num, Fun(Num, Num))),
                            [App(Const("BIT0", Fun(Num, Num)), [Ref("m")]), App(Const("BIT0", Fun(Num, Num)), [Ref("n")])]
                          ),
                          App(
                            Const("BIT0", Fun(Num, Num)),
                            [App(Const("-", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])]
                          )
                        )
                      )
                    ),
                    And(
                      Forall(
                        "m",
                        Num,
                        Forall(
                          "n",
                          Num,
                          Eq(
                            Num,
                            App(
                              Const("-", Fun(Num, Fun(Num, Num))),
                              [App(Const("BIT0", Fun(Num, Num)), [Ref("m")]), App(Const("BIT1", Fun(Num, Num)), [Ref("n")])]
                            ),
                            App(
                              Const("PRE", Fun(Num, Num)),
                              [
                                App(
                                  Const("BIT0", Fun(Num, Num)),
                                  [App(Const("-", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])]
                                )
                              ]
                            )
                          )
                        )
                      ),
                      And(
                        Forall(
                          "m",
                          Num,
                          Forall(
                            "n",
                            Num,
                            Eq(
                              Num,
                              App(
                                Const("-", Fun(Num, Fun(Num, Num))),
                                [App(Const("BIT1", Fun(Num, Num)), [Ref("m")]), App(Const("BIT0", Fun(Num, Num)), [Ref("n")])]
                              ),
                              App(
                                Const("COND", Fun(Bool, Fun(Num, Fun(Num, Num)))),
                                [
                                  App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("n"), Ref("m")]),
                                  App(
                                    Const("BIT1", Fun(Num, Num)),
                                    [App(Const("-", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])]
                                  ),
                                  Const("_0", Num)
                                ]
                              )
                            )
                          )
                        ),
                        Forall(
                          "m",
                          Num,
                          Forall(
                            "n",
                            Num,
                            Eq(
                              Num,
                              App(
                                Const("-", Fun(Num, Fun(Num, Num))),
                                [App(Const("BIT1", Fun(Num, Num)), [Ref("m")]), App(Const("BIT1", Fun(Num, Num)), [Ref("n")])]
                              ),
                              App(
                                Const("BIT0", Fun(Num, Num)),
                                [App(Const("-", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])]
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REWRITE_TAC(PairList [NUMERAL, DENUMERAL(SUB_0)]) then_tac \
                            PURE_REWRITE_TAC(PairList [BIT0, BIT1])
                          ) then_tac \
                          REWRITE_TAC(PairList [GSYM(MULT_2), SUB_SUC, LEFT_SUB_DISTRIB])
                        ) then_tac \
                        REWRITE_TAC(PairList [SUB])
                      ) then_tac \
                      REPEAT(GEN_TAC)
                    ) then_tac \
                    COND_CASES_TAC
                  ) then_tac \
                  REWRITE_TAC(PairList [DENUMERAL(SUB_EQ_0)])
                ) then_tac \
                RULE_ASSUM_TAC(REWRITE_RULE(PairList [NOT_LE]))
              ) then_tac \
              ASM_REWRITE_TAC(PairList [LE_SUC_LT, LT_MULT_LCANCEL, ARITH_EQ])
            ) then_tac \
            POP_ASSUM(o(CHOOSE_THEN(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS])))
          ) then_tac \
          REWRITE_TAC(PairList [ADD1, LEFT_ADD_DISTRIB])
        ) then_tac \
        REWRITE_TAC(PairList [ADD_SUB2, GSYM(ADD_ASSOC)])
      )
    ]
  )

def ARITH:
  end_itlist(CONJ)(
    PairList [
      ARITH_ZERO,
      ARITH_SUC,
      ARITH_PRE,
      ARITH_ADD,
      ARITH_MULT,
      ARITH_EXP,
      ARITH_EVEN,
      ARITH_ODD,
      ARITH_EQ,
      ARITH_LE,
      ARITH_LT,
      ARITH_GE,
      ARITH_GT,
      ARITH_SUB
    ]
  )

def EXP_2_NE_0:
  prove(
    [
      Host.hol_term(Forall(
        "n",
        Num,
        Not(
          Eq(
            Num,
            App(
              Const("EXP", Fun(Num, Fun(Num, Num))),
              [
                App(
                  Const("NUMERAL", Fun(Num, Num)),
                  [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                ),
                Ref("n")
              ]
            ),
            App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])
          )
        )
      )),
      REWRITE_TAC(PairList [EXP_EQ_0, ARITH_EQ])
    ]
  )

def NUM_EVEN_CONV:
  let [tth, rths] = CONJ_PAIR(ARITH_EVEN)
  (GEN_REWRITE_CONV(I, PairList [tth]) then_conv GEN_REWRITE_CONV(I, PairList [rths]))

def NUM_ODD_CONV:
  let [tth, rths] = CONJ_PAIR(ARITH_ODD)
  (GEN_REWRITE_CONV(I, PairList [tth]) then_conv GEN_REWRITE_CONV(I, PairList [rths]))

def [calc_num_NUM_SUC_CONV_v2, calc_num_NUM_ADD_CONV_v2, calc_num_NUM_MULT_CONV_v2, calc_num_NUM_EXP_CONV_v2, calc_num_NUM_LT_CONV_v2, calc_num_NUM_LE_CONV_v2, NUM_EQ_CONV]:
  let num_ty = type_of(lhand(concl(ZERO_DEF)))
  let Comb(NUMERAL_tm_2,Comb(BIT0_tm_2,Comb(BIT1_tm_2,zero_tm_2))) = mk_small_numeral(2)
  let suc_tm_2 = rator(rand(concl(TWO)))
  let one_tm_2 = rand(mk_small_numeral(1))
  let add_tm_2 = rator(rator(lhand(snd(strip_forall(concl(ADD_0))))))
  let mul_tm_2 = rator(rator(rand(snd(strip_forall(concl(EXP_2))))))
  let exp_tm_2 = rator(rator(lhand(snd(strip_forall(concl(EXP_2))))))
  let eq_tm_2 = rator(rator(concl(TWO)))
  let num_0_2 = Host.num(0)
  let num_1_2 = Host.num(1)
  let num_2_2 = Host.num(2)
  let a_tm_2 = mk_var(["a", num_ty])
  let b_tm_2 = mk_var(["b", num_ty])
  let c_tm_2 = mk_var(["c", num_ty])
  let d_tm_2 = mk_var(["d", num_ty])
  let e_tm_2 = mk_var(["e", num_ty])
  let h_tm_2 = mk_var(["h", num_ty])
  let l_tm_2 = mk_var(["l", num_ty])
  let m_tm_2 = mk_var(["m", num_ty])
  let n_tm_2 = mk_var(["n", num_ty])
  let p_tm_2 = mk_var(["p", num_ty])
  let ilist:
    PairList [
      [BIT0_tm_2, BIT0_tm_2],
      [BIT1_tm_2, BIT1_tm_2],
      [zero_tm_2, zero_tm_2],
      [suc_tm_2, suc_tm_2],
      [add_tm_2, add_tm_2],
      [mul_tm_2, mul_tm_2],
      [exp_tm_2, exp_tm_2],
      [eq_tm_2, eq_tm_2],
      [NUMERAL_tm_2, NUMERAL_tm_2],
      [a_tm_2, a_tm_2],
      [b_tm_2, b_tm_2],
      [c_tm_2, c_tm_2],
      [d_tm_2, d_tm_2],
      [e_tm_2, e_tm_2],
      [h_tm_2, h_tm_2],
      [l_tm_2, l_tm_2],
      [m_tm_2, m_tm_2],
      [n_tm_2, n_tm_2],
      [p_tm_2, p_tm_2]
    ]
  fun replace(tm):
    match tm
    | Var(_,_): rev_assocd(tm)(ilist)(tm)
    | Const(_,_): rev_assocd(tm)(ilist)(tm)
    | Comb(s,t): mk_comb([replace(s), replace(t)])
    | Abs(_,_): failwith("replace")
  let STANDARDIZE:
    fun(th):
      let tm_prime = replace(concl(th))
      EQ_MP(REFL(tm_prime))(th)
  let REFL_bit0_2 = STANDARDIZE(REFL(BIT0_tm_2))
  let REFL_bit1_2 = STANDARDIZE(REFL(BIT1_tm_2))
  let AP_BIT0_2 = (fun(th): MK_COMB([REFL_bit0_2, th]))
  let AP_BIT1_2 = (fun(th): MK_COMB([REFL_bit1_2, th]))
  let QUICK_PROVE_HYP_2 = (fun(ath): (fun(bth): EQ_MP(DEDUCT_ANTISYM_RULE(ath)(bth))(ath)))
  fun dest_raw_numeral(tm):
    match tm
    | Comb(Const("BIT1",_),t): Host.hol_add(Host.hol_mul(num_2_2)(dest_raw_numeral(t)))(num_1_2)
    | Comb(Const("BIT0",_),t): Host.hol_mul(num_2_2)(dest_raw_numeral(t))
    | Const("_0",_): num_0_2
  fun bctr(w):
    fun(z):
      fun(tm):
        match tm
        | Const("_0",_): [w, z]
        | Comb(Const("BIT0",_),t): bctr(w)(Host.hol_add(z)(1))(t)
        | Comb(Const("BIT1",_),t): bctr(Host.hol_add(w)(1))(z)(t)
        | _: failwith("malformed numeral")
  let bitcounts = bctr(0)(0)
  fun wellformed(tm):
    match tm
    | Const("_0",_): #true
    | Comb(Const("BIT0",_),t): wellformed(t)
    | Comb(Const("BIT1",_),t): wellformed(t)
    | _: #false
  fun orderrelation(mtm):
    fun(ntm):
      if Host.hol_physical_equal(mtm)(ntm)
      | (if wellformed(mtm) | 0 | failwith("orderrelation"))
      | match [mtm, ntm]
        | [Const("_0",_), Const("_0",_)]: 0
        | [Const("_0",_), _]: (if wellformed(ntm) | -1 | failwith("orderrelation"))
        | [_, Const("_0",_)]: (if wellformed(ntm) | 1 | failwith("orderrelation"))
        | [Comb(Const("BIT0",_),mt), Comb(Const("BIT0",_),nt)]: orderrelation(mt)(nt)
        | [Comb(Const("BIT1",_),mt), Comb(Const("BIT1",_),nt)]: orderrelation(mt)(nt)
        | [Comb(Const("BIT0",_),mt), Comb(Const("BIT1",_),nt)]: (if Host.hol_gt(orderrelation(mt)(nt))(0) | 1 | -1)
        | [Comb(Const("BIT1",_),mt), Comb(Const("BIT0",_),nt)]: (if Host.hol_lt(orderrelation(mt)(nt))(0) | -1 | 1)
  let doublebn = (fun(tm): (if Host.hol_equal(tm)(zero_tm_2) | tm | mk_comb([BIT0_tm_2, tm])))
  fun subbn_2(mtm):
    fun(ntm):
      match [mtm, ntm]
      | [_, Const("_0",_)]: mtm
      | [Comb(Const("BIT0",_),mt), Comb(Const("BIT0",_),nt)]: doublebn(subbn_2(mt)(nt))
      | [Comb(Const("BIT1",_),mt), Comb(Const("BIT1",_),nt)]: doublebn(subbn_2(mt)(nt))
      | [Comb(Const("BIT1",_),mt), Comb(Const("BIT0",_),nt)]: mk_comb([BIT1_tm_2, subbn_2(mt)(nt)])
      | [Comb(Const("BIT0",_),mt), Comb(Const("BIT1",_),nt)]: mk_comb([BIT1_tm_2, sbcbn_2(mt)(nt)])
      | _: failwith("malformed numeral or wrong relation")
  fun sbcbn_2(mtm):
    fun(ntm):
      match [mtm, ntm]
      | [Comb(Const("BIT0",_),mt), Const("_0",_)]: mk_comb([BIT1_tm_2, sbcbn_2(mt)(ntm)])
      | [Comb(Const("BIT1",_),mt), Const("_0",_)]: doublebn(mt)
      | [Comb(Const("BIT0",_),mt), Comb(Const("BIT0",_),nt)]: mk_comb([BIT1_tm_2, sbcbn_2(mt)(nt)])
      | [Comb(Const("BIT1",_),mt), Comb(Const("BIT1",_),nt)]: mk_comb([BIT1_tm_2, sbcbn_2(mt)(nt)])
      | [Comb(Const("BIT1",_),mt), Comb(Const("BIT0",_),nt)]: doublebn(subbn_2(mt)(nt))
      | [Comb(Const("BIT0",_),mt), Comb(Const("BIT1",_),nt)]: doublebn(sbcbn_2(mt)(nt))
      | _: failwith("malformed numeral or wrong relation")
  let topsplit:
    fun(tm):
      match tm
      | Const("_0",_): [0, zero_tm_2]
      | Comb(Const("BIT1",_),Const("_0",_)): [1, zero_tm_2]
      | Comb(Const("BIT0",_),Comb(Const("BIT1",_),Const("_0",_))): [2, zero_tm_2]
      | Comb(Const("BIT1",_),Comb(Const("BIT1",_),Const("_0",_))): [3, zero_tm_2]
      | Comb(Const("BIT0",_),Comb(Const("BIT0",_),Comb(Const("BIT1",_),Const("_0",_)))): [4, zero_tm_2]
      | Comb(Const("BIT1",_),Comb(Const("BIT0",_),Comb(Const("BIT1",_),Const("_0",_)))): [5, zero_tm_2]
      | Comb(Const("BIT0",_),Comb(Const("BIT1",_),Comb(Const("BIT1",_),Const("_0",_)))): [6, zero_tm_2]
      | Comb(Const("BIT1",_),Comb(Const("BIT1",_),Comb(Const("BIT1",_),Const("_0",_)))): [7, zero_tm_2]
      | Comb(Const("BIT0",_),Comb(Const("BIT0",_),Comb(Const("BIT0",_),Comb(Const("BIT0",_),n)))): [0, n]
      | Comb(Const("BIT1",_),Comb(Const("BIT0",_),Comb(Const("BIT0",_),Comb(Const("BIT0",_),n)))): [1, n]
      | Comb(Const("BIT0",_),Comb(Const("BIT1",_),Comb(Const("BIT0",_),Comb(Const("BIT0",_),n)))): [2, n]
      | Comb(Const("BIT1",_),Comb(Const("BIT1",_),Comb(Const("BIT0",_),Comb(Const("BIT0",_),n)))): [3, n]
      | Comb(Const("BIT0",_),Comb(Const("BIT0",_),Comb(Const("BIT1",_),Comb(Const("BIT0",_),n)))): [4, n]
      | Comb(Const("BIT1",_),Comb(Const("BIT0",_),Comb(Const("BIT1",_),Comb(Const("BIT0",_),n)))): [5, n]
      | Comb(Const("BIT0",_),Comb(Const("BIT1",_),Comb(Const("BIT1",_),Comb(Const("BIT0",_),n)))): [6, n]
      | Comb(Const("BIT1",_),Comb(Const("BIT1",_),Comb(Const("BIT1",_),Comb(Const("BIT0",_),n)))): [7, n]
      | Comb(Const("BIT0",_),Comb(Const("BIT0",_),Comb(Const("BIT0",_),Comb(Const("BIT1",_),n)))): [8, n]
      | Comb(Const("BIT1",_),Comb(Const("BIT0",_),Comb(Const("BIT0",_),Comb(Const("BIT1",_),n)))): [9, n]
      | Comb(Const("BIT0",_),Comb(Const("BIT1",_),Comb(Const("BIT0",_),Comb(Const("BIT1",_),n)))): [10, n]
      | Comb(Const("BIT1",_),Comb(Const("BIT1",_),Comb(Const("BIT0",_),Comb(Const("BIT1",_),n)))): [11, n]
      | Comb(Const("BIT0",_),Comb(Const("BIT0",_),Comb(Const("BIT1",_),Comb(Const("BIT1",_),n)))): [12, n]
      | Comb(Const("BIT1",_),Comb(Const("BIT0",_),Comb(Const("BIT1",_),Comb(Const("BIT1",_),n)))): [13, n]
      | Comb(Const("BIT0",_),Comb(Const("BIT1",_),Comb(Const("BIT1",_),Comb(Const("BIT1",_),n)))): [14, n]
      | Comb(Const("BIT1",_),Comb(Const("BIT1",_),Comb(Const("BIT1",_),Comb(Const("BIT1",_),n)))): [15, n]
      | _: failwith("malformed numeral")
  fun mk_compnumeral(k):
    fun(base):
      if Host.hol_equal(k)(0)
      | base
      | let t = mk_compnumeral(Host.hol_div(k)(2))(base)
        (if Host.hol_equal(Host.hol_mod(k)(2))(1) | mk_comb([BIT1_tm_2, t]) | mk_comb([BIT0_tm_2, t]))
  let bases:
    fun(v):
      let part2 = map((fun(k): mk_compnumeral(k)(v)))(Host.hol_range(8)(15))
      let part1_2 = map(subst(PairList [[mk_comb([BIT0_tm_2, v]), mk_comb([BIT1_tm_2, v])]]))(part2)
      let part0_2 = map((fun(k): mk_compnumeral(k)(zero_tm_2)))(Host.hol_range(0)(15))
      append(part0_2)(append(part1_2)(part2))
  let starts = Host.allpairs((fun(mtm): (fun(ntm): mk_comb([mk_comb([add_tm_2, mtm]), ntm]))))(bases(m_tm_2))(bases(n_tm_2))
  let BITS_INJ:
    o(STANDARDIZE)(prove)(
      [
        Host.hol_term(And(
          Iff(
            Eq(
              Num,
              App(Const("BIT0", Fun(Num, Num)), [Var("m", Num)]),
              App(Const("BIT0", Fun(Num, Num)), [Var("n", Num)])
            ),
            Eq(Num, Var("m", Num), Var("n", Num))
          ),
          Iff(
            Eq(
              Num,
              App(Const("BIT1", Fun(Num, Num)), [Var("m", Num)]),
              App(Const("BIT1", Fun(Num, Num)), [Var("n", Num)])
            ),
            Eq(Num, Var("m", Num), Var("n", Num))
          )
        )),
        (
          (
            REWRITE_TAC(PairList [BIT0, BIT1]) then_tac \
            REWRITE_TAC(PairList [GSYM(MULT_2)])
          ) then_tac \
          REWRITE_TAC(PairList [SUC_INJ, EQ_MULT_LCANCEL, ARITH_EQ])
        )
      ]
    )
  let ARITH_0:
    o(STANDARDIZE)(MESON(PairList [NUMERAL, ADD_CLAUSES]))(
      Host.hol_term(And(
        Eq(
          Num,
          App(Const("+", Fun(Num, Fun(Num, Num))), [Var("m", Num), Const("_0", Num)]),
          Var("m", Num)
        ),
        Eq(
          Num,
          App(Const("+", Fun(Num, Fun(Num, Num))), [Const("_0", Num), Var("n", Num)]),
          Var("n", Num)
        )
      ))
    )
  let patadj:
    subst(
      PairList [
        [
          Host.hol_term(App(
            Const("SUC", Fun(Num, Num)),
            [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("m", Num), Const("_0", Num)])]
          )),
          Host.hol_term(App(Const("SUC", Fun(Num, Num)), [Var("m", Num)]))
        ],
        [
          Host.hol_term(App(
            Const("SUC", Fun(Num, Num)),
            [App(Const("+", Fun(Num, Fun(Num, Num))), [Const("_0", Num), Var("n", Num)])]
          )),
          Host.hol_term(App(Const("SUC", Fun(Num, Num)), [Var("n", Num)]))
        ]
      ]
    )
  let mkclauses:
    fun(sucflag):
      fun(t):
        let tm = (if sucflag | mk_comb([suc_tm_2, t]) | t)
        let th1 = PURE_REWRITE_CONV(PairList [ARITH_ADD, ARITH_SUC, ARITH_0])(tm)
        let tm1 = patadj(rand(concl(th1)))
        if Host.hol_not(free_in(add_tm_2)(tm1))
        | [th1, (if free_in(m_tm_2)(tm1) | 0 | 1)]
        | let ptm = rand(rand(rand(rand(tm1))))
          let tmc = mk_eq([mk_eq([ptm, p_tm_2]), mk_eq([tm, subst(PairList [[p_tm_2, ptm]])(tm1)])])
          [
            EQT_ELIM(REWRITE_CONV(PairList [ARITH_ADD, ARITH_SUC, ARITH_0, BITS_INJ])(tmc)),
            (if free_in(suc_tm_2)(tm1) | 3 | 2)
          ]
  let [l1, l2] = unzip(map(mkclauses(#false))(starts))
  let [add_clauses, add_flags] = [Host.hol_array_of_list(map(STANDARDIZE)(l1)), Host.hol_array_of_list(l2)]
  let [l1, l2] = unzip(map(mkclauses(#true))(starts))
  let [adc_clauses, adc_flags] = [Host.hol_array_of_list(map(STANDARDIZE)(l1)), Host.hol_array_of_list(l2)]
  fun NUM_ADD_RULE_2(mtm):
    fun(ntm):
      let [m_lo_2, m_hi_2] = topsplit(mtm)
      let [n_lo_2, n_hi_2] = topsplit(ntm)
      let m_ind_2 = (if Host.hol_equal(m_hi_2)(zero_tm_2) | m_lo_2 | Host.hol_add(m_lo_2)(16))
      let n_ind_2 = (if Host.hol_equal(n_hi_2)(zero_tm_2) | n_lo_2 | Host.hol_add(n_lo_2)(16))
      let ind = Host.hol_add(Host.hol_mul(32)(m_ind_2))(n_ind_2)
      let th1_2 = Host.hol_array_get(add_clauses)(ind)
      let fl_2 = Host.hol_array_get(add_flags)(ind)
      match fl_2
      | 0: INST(PairList [[m_hi_2, m_tm_2]])(th1_2)
      | 1: INST(PairList [[n_hi_2, n_tm_2]])(th1_2)
      | 2:
          let th2 = NUM_ADD_RULE_2(m_hi_2)(n_hi_2)
          match concl(th2)
          | Comb(_,ptm):
              let th3 = INST(PairList [[m_hi_2, m_tm_2], [n_hi_2, n_tm_2], [ptm, p_tm_2]])(th1_2)
              EQ_MP(th3)(th2)
      | 3:
          let th2 = NUM_ADC_RULE_2(m_hi_2)(n_hi_2)
          match concl(th2)
          | Comb(_,ptm):
              let th3 = INST(PairList [[m_hi_2, m_tm_2], [n_hi_2, n_tm_2], [ptm, p_tm_2]])(th1_2)
              EQ_MP(th3)(th2)
  fun NUM_ADC_RULE_2(mtm):
    fun(ntm):
      let [m_lo_3, m_hi_3] = topsplit(mtm)
      let [n_lo_3, n_hi_3] = topsplit(ntm)
      let m_ind_3 = (if Host.hol_equal(m_hi_3)(zero_tm_2) | m_lo_3 | Host.hol_add(m_lo_3)(16))
