  fun NUM_UNSHIFT_CONV_2(tm):
    match tm
    | Comb(Comb(Const("+",_),atm),Comb(Comb(Const("*",_),ptm),btm)):
        match [atm, ptm, btm]
        | [_, _, Const("_0",_)]: INST(PairList [[atm, a_tm], [ptm, p_tm]])(pth_triv)
        | [_, Comb(Const("BIT1",_),Const("_0",_)), _]:
            let th1 = INST(PairList [[atm, a_tm], [btm, b_tm]])(pth_base)
            let Comb(_,Comb(Comb(_,mtm),ntm)) = concl(th1)
            TRANS(th1)(NUM_ADD_RULE(mtm)(ntm))
        | [Comb(_,Comb(_,Comb(_,Comb(_,atm_prime)))), Comb(_,Comb(_,Comb(_,Comb(_,Comb(_,_) as ptm_prime)))), _]:
            let [i, _] = topsplit(atm)
            match [atm_prime, ptm_prime]
            | [Comb(_,Comb(_,Comb(_,Comb(_,atm_prime_prime)))), Comb(_,Comb(_,Comb(_,Comb(_,Comb(_,_) as ptm_prime_prime))))]:
                let [j, _] = topsplit(atm_prime)
                let tm_prime:
                  mk_comb(
                    [
                      mk_comb([add_tm, atm_prime_prime]),
                      mk_comb([mk_comb([mul_tm, ptm_prime_prime]), btm])
                    ]
                  )
                let th1 = NUM_UNSHIFT_CONV_2(tm_prime)
                let th2:
                  INST(
                    PairList [
                      [atm_prime_prime, a_tm],
                      [ptm_prime_prime, p_tm],
                      [btm, b_tm],
                      [rand(concl(th1)), n_tm]
                    ]
                  )(puths_2[((16 * j) + i)])
                EQ_MP(th2)(th1)
            | _:
                let tm_prime:
                  mk_comb(
                    [
                      mk_comb([add_tm, atm_prime]),
                      mk_comb([mk_comb([mul_tm, ptm_prime]), btm])
                    ]
                  )
                let th1 = NUM_UNSHIFT_CONV_2(tm_prime)
                let th2:
                  INST(
                    PairList [
                      [atm_prime, a_tm],
                      [ptm_prime, p_tm],
                      [btm, b_tm],
                      [rand(concl(th1)), n_tm]
                    ]
                  )(puths_1[i])
                EQ_MP(th2)(th1)
        | [Const("_0",_), Comb(Const("BIT0",_),qtm), _]:
            let th1 = INST(PairList [[btm, b_tm], [qtm, p_tm]])(pth_z)
            CONV_RULE(RAND_CONV(RAND_CONV(NUM_UNSHIFT_CONV_2)))(th1)
        | [Comb(Const("BIT0",_),ctm), Comb(Const("BIT0",_),qtm), _]:
            let th1 = INST(PairList [[ctm, a_tm], [btm, b_tm], [qtm, p_tm]])(pth_0)
            CONV_RULE(RAND_CONV(RAND_CONV(NUM_UNSHIFT_CONV_2)))(th1)
        | [Comb(Const("BIT1",_),ctm), Comb(Const("BIT0",_),qtm), _]:
            let th1 = INST(PairList [[ctm, a_tm], [btm, b_tm], [qtm, p_tm]])(pth_1)
            CONV_RULE(RAND_CONV(RAND_CONV(NUM_UNSHIFT_CONV_2)))(th1)
        | _: failwith("malformed numeral")
    | _: failwith("malformed numeral")
