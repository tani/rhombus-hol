  fun NUM_SHIFT_CONV_2(k):
    fun(tm):
      if Host.hol_le(k)(0)
      | INST(PairList [[tm, n_tm_2]])(pth_base_2)
      | match tm
        | Comb(_,Comb(_,Comb(_,Comb(_,_)))):
            if Host.hol_ge(k)(4)
            | let [i, ntm] = topsplit(tm)
              let th1 = NUM_SHIFT_CONV_2(Host.hol_sub(k)(4))(ntm)
              match concl(th1)
              | Comb(_,Comb(Comb(_,Const("_0",_)),Comb(Comb(_,ptm),btm))):
                  let th2 = Host.hol_array_get(pths_0_2)(i)
                  let th3 = INST(PairList [[ntm, n_tm_2], [btm, b_tm_2], [ptm, p_tm_2]])(th2)
                  EQ_MP(th3)(th1)
              | Comb(_,Comb(Comb(_,atm),Comb(Comb(_,ptm),btm))):
                  let th2 = Host.hol_array_get(pths_1_2)(i)
                  let th3 = INST(PairList [[ntm, n_tm_2], [atm, a_tm_2], [btm, b_tm_2], [ptm, p_tm_2]])(th2)
                  EQ_MP(th3)(th1)
            | match tm
              | Comb(Const("BIT0",_),ntm):
                  let th1 = NUM_SHIFT_CONV_2(Host.hol_sub(k)(1))(ntm)
                  match concl(th1)
                  | Comb(_,Comb(Comb(_,Const("_0",_)),Comb(Comb(_,ptm),btm))): EQ_MP(INST(PairList [[ntm, n_tm_2], [btm, b_tm_2], [ptm, p_tm_2]])(pth_z_2))(th1)
                  | Comb(_,Comb(Comb(_,atm),Comb(Comb(_,ptm),btm))): EQ_MP(INST(PairList [[ntm, n_tm_2], [atm, a_tm_2], [btm, b_tm_2], [ptm, p_tm_2]])(pth_0_2))(th1)
              | Comb(Const("BIT1",_),ntm):
                  let th1 = NUM_SHIFT_CONV_2(Host.hol_sub(k)(1))(ntm)
                  match concl(th1)
                  | Comb(_,Comb(Comb(_,atm),Comb(Comb(_,ptm),btm))): EQ_MP(INST(PairList [[ntm, n_tm_2], [atm, a_tm_2], [btm, b_tm_2], [ptm, p_tm_2]])(pth_1_2))(th1)
              | Const("_0",_):
                  let th1 = NUM_SHIFT_CONV_2(Host.hol_sub(k)(1))(tm)
                  match concl(th1)
                  | Comb(_,Comb(Comb(_,atm),Comb(Comb(_,ptm),btm))): EQ_MP(INST(PairList [[atm, a_tm_2], [btm, b_tm_2], [ptm, p_tm_2]])(pth_triv_2))(th1)
              | _: failwith("malformed numeral")
        | Comb(Const("BIT0",_),ntm):
            let th1 = NUM_SHIFT_CONV_2(Host.hol_sub(k)(1))(ntm)
            match concl(th1)
            | Comb(_,Comb(Comb(_,Const("_0",_)),Comb(Comb(_,ptm),btm))): EQ_MP(INST(PairList [[ntm, n_tm_2], [btm, b_tm_2], [ptm, p_tm_2]])(pth_z_2))(th1)
            | Comb(_,Comb(Comb(_,atm),Comb(Comb(_,ptm),btm))): EQ_MP(INST(PairList [[ntm, n_tm_2], [atm, a_tm_2], [btm, b_tm_2], [ptm, p_tm_2]])(pth_0_2))(th1)
        | Comb(Const("BIT1",_),ntm):
            let th1 = NUM_SHIFT_CONV_2(Host.hol_sub(k)(1))(ntm)
            match concl(th1)
            | Comb(_,Comb(Comb(_,atm),Comb(Comb(_,ptm),btm))): EQ_MP(INST(PairList [[ntm, n_tm_2], [atm, a_tm_2], [btm, b_tm_2], [ptm, p_tm_2]])(pth_1_2))(th1)
        | Const("_0",_):
            let th1 = NUM_SHIFT_CONV_2(Host.hol_sub(k)(1))(tm)
            match concl(th1)
            | Comb(_,Comb(Comb(_,atm),Comb(Comb(_,ptm),btm))): EQ_MP(INST(PairList [[atm, a_tm_2], [btm, b_tm_2], [ptm, p_tm_2]])(pth_triv_2))(th1)
        | _: failwith("malformed numeral")
