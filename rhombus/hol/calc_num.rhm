def ARITH_LE:
  prove(
    [
      Host.hol_term(And(
        Forall(
          "m",
          Num,
          Forall(
            "n",
            Num,
            Iff(
              App(
                Const("<=", Fun(Num, Fun(Num, Bool))),
                [
                  App(Const("NUMERAL", Fun(Num, Num)), [Ref("m")]),
                  App(Const("NUMERAL", Fun(Num, Num)), [Ref("n")])
                ]
              ),
              App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")])
            )
          )
        ),
        And(
          Iff(App(Const("<=", Fun(Num, Fun(Num, Bool))), [Const("_0", Num), Const("_0", Num)]), True),
          And(
            Forall(
              "n",
              Num,
              Iff(
                App(
                  Const("<=", Fun(Num, Fun(Num, Bool))),
                  [App(Const("BIT0", Fun(Num, Num)), [Ref("n")]), Const("_0", Num)]
                ),
                App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("n"), Const("_0", Num)])
              )
            ),
            And(
              Forall(
                "n",
                Num,
                Iff(
                  App(
                    Const("<=", Fun(Num, Fun(Num, Bool))),
                    [App(Const("BIT1", Fun(Num, Num)), [Ref("n")]), Const("_0", Num)]
                  ),
                  False
                )
              ),
              And(
                Forall(
                  "n",
                  Num,
                  Iff(
                    App(
                      Const("<=", Fun(Num, Fun(Num, Bool))),
                      [Const("_0", Num), App(Const("BIT0", Fun(Num, Num)), [Ref("n")])]
                    ),
                    True
                  )
                ),
                And(
                  Forall(
                    "n",
                    Num,
                    Iff(
                      App(
                        Const("<=", Fun(Num, Fun(Num, Bool))),
                        [Const("_0", Num), App(Const("BIT1", Fun(Num, Num)), [Ref("n")])]
                      ),
                      True
                    )
                  ),
                  And(
                    Forall(
                      "m",
                      Num,
                      Forall(
                        "n",
                        Num,
                        Iff(
                          App(
                            Const("<=", Fun(Num, Fun(Num, Bool))),
                            [App(Const("BIT0", Fun(Num, Num)), [Ref("m")]), App(Const("BIT0", Fun(Num, Num)), [Ref("n")])]
                          ),
                          App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")])
                        )
                      )
                    ),
                    And(
                      Forall(
                        "m",
                        Num,
                        Forall(
                          "n",
                          Num,
                          Iff(
                            App(
                              Const("<=", Fun(Num, Fun(Num, Bool))),
                              [App(Const("BIT0", Fun(Num, Num)), [Ref("m")]), App(Const("BIT1", Fun(Num, Num)), [Ref("n")])]
                            ),
                            App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")])
                          )
                        )
                      ),
                      And(
                        Forall(
                          "m",
                          Num,
                          Forall(
                            "n",
                            Num,
                            Iff(
                              App(
                                Const("<=", Fun(Num, Fun(Num, Bool))),
                                [App(Const("BIT1", Fun(Num, Num)), [Ref("m")]), App(Const("BIT0", Fun(Num, Num)), [Ref("n")])]
                              ),
                              App(Const("<", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")])
                            )
                          )
                        ),
                        Forall(
                          "m",
                          Num,
                          Forall(
                            "n",
                            Num,
                            Iff(
                              App(
                                Const("<=", Fun(Num, Fun(Num, Bool))),
                                [App(Const("BIT1", Fun(Num, Num)), [Ref("m")]), App(Const("BIT1", Fun(Num, Num)), [Ref("n")])]
                              ),
                              App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")])
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      REWRITE_TAC(
                        PairList [
                          NUMERAL,
                          BIT1,
                          BIT0,
                          DENUMERAL(NOT_SUC),
                          DENUMERAL(GSYM(NOT_SUC)),
                          SUC_INJ
                        ]
                      ) then_tac \
                      REWRITE_TAC(PairList [DENUMERAL(LE_0)])
                    ) then_tac \
                    REWRITE_TAC(PairList [DENUMERAL(LE), GSYM(MULT_2)])
                  ) then_tac \
                  REWRITE_TAC(
                    PairList [
                      LE_MULT_LCANCEL,
                      SUC_INJ,
                      DENUMERAL(MULT_EQ_0),
                      DENUMERAL(NOT_SUC)
                    ]
                  )
                ) then_tac \
                REWRITE_TAC(PairList [DENUMERAL(NOT_SUC)])
              ) then_tac \
              REWRITE_TAC(PairList [LE_SUC_LT])
            ) then_tac \
            REWRITE_TAC(PairList [LT_MULT_LCANCEL])
          ) then_tac \
          SUBGOAL_THEN(
            Host.hol_term(Eq(
              Num,
              App(
                Const("NUMERAL", Fun(Num, Num)),
                [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
              ),
              App(
                Const("SUC", Fun(Num, Num)),
                [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
              )
            ))
          )((fun(th): REWRITE_TAC(PairList [th])))
        ) then_list \
        PairList [
          REWRITE_TAC(PairList [NUMERAL, BIT0, BIT1, DENUMERAL(ADD_CLAUSES)]),
          (
            (
              (
                (
                  (
                    REWRITE_TAC(PairList [DENUMERAL(NOT_SUC), NOT_SUC, EQ_MULT_LCANCEL]) then_tac \
                    REWRITE_TAC(PairList [ONCE_REWRITE_RULE(PairList [DISJ_SYM])(LE_LT)])
                  ) then_tac \
                  MAP_EVERY(X_GEN_TAC)(PairList [Host.hol_term(Var("m", Num)), Host.hol_term(Var("n", Num))])
                ) then_tac \
                SUBGOAL_THEN(
                  Host.hol_term(Not(
                    Eq(
                      Num,
                      App(
                        Const("*", Fun(Num, Fun(Num, Num))),
                        [
                          App(
                            Const("SUC", Fun(Num, Num)),
                            [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                          ),
                          Var("m", Num)
                        ]
                      ),
                      App(
                        Const("SUC", Fun(Num, Num)),
                        [
                          App(
                            Const("*", Fun(Num, Fun(Num, Num))),
                            [
                              App(
                                Const("SUC", Fun(Num, Num)),
                                [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                              ),
                              Var("n", Num)
                            ]
                          )
                        ]
                      )
                    )
                  ))
                )((fun(th): REWRITE_TAC(PairList [th])))
              ) then_tac \
              DISCH_THEN(o(MP_TAC)(AP_TERM(Host.hol_term(Const("EVEN", Fun(Num, Bool))))))
            ) then_tac \
            REWRITE_TAC(PairList [EVEN_MULT, EVEN_ADD, NUMERAL, BIT1, EVEN])
          )
        ]
      )
    ]
  )

