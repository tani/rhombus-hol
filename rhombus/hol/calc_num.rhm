  let puths_2:
    Host.hol_array_of_list(
      map(
        fun(i):
          let th1_4 = Host.hol_array_get(puths_1_2)(Host.hol_mod(i)(16))
          let th2_2 = Host.hol_array_get(puths_1_2)(Host.hol_div(i)(16))
          let th3 = GEN_REWRITE_RULE(RAND_CONV, PairList [th1_4])(th2_2)
          STANDARDIZE(th3)
      )(Host.hol_range(0)(255))
    )
  fun NUM_UNSHIFT_CONV_2(tm):
    match tm
    | Comb(Comb(Const("+",_),atm),Comb(Comb(Const("*",_),ptm),btm)):
        match [atm, ptm, btm]
        | [_, _, Const("_0",_)]: INST(PairList [[atm, a_tm_2], [ptm, p_tm_2]])(pth_triv_3)
        | [_, Comb(Const("BIT1",_),Const("_0",_)), _]:
            let th1 = INST(PairList [[atm, a_tm_2], [btm, b_tm_2]])(pth_base_3)
            let Comb(_,Comb(Comb(_,mtm),ntm)) = concl(th1)
            TRANS(th1)(NUM_ADD_RULE(mtm)(ntm))
        | [Comb(_,Comb(_,Comb(_,Comb(_,atm_prime)))), Comb(_,Comb(_,Comb(_,Comb(_,Comb(_,_) as ptm_prime)))), _]:
            let [i, _] = topsplit(atm)
            match [atm_prime, ptm_prime]
