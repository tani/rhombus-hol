                  let th2 = NUM_ADD_RULE(htm)(ltm)
                  let mtm = rand(concl(th2))
                  let th3_2 = NUM_SQUARE_RULE_2(htm)
                  let th4_2 = NUM_SQUARE_RULE_2(ltm)
                  let th5_2 = NUM_SQUARE_RULE_2(mtm)
                  let atm_2 = rand(concl(th3_2))
                  let ctm_2 = rand(concl(th4_2))
                  let dtm_2 = rand(concl(th5_2))
                  let th6 = NUM_ADD_RULE(atm_2)(ctm_2)
                  let etm = rand(concl(th6))
                  let btm = subbn(dtm_2)(etm)
                  let th7 = NUM_ADD_RULE(etm)(btm)
                  let dtm = rand(concl(th7))
                  let th8:
                    INST(
                      PairList [
                        [atm_2, a_tm],
                        [btm, b_tm],
                        [ctm_2, c_tm],
                        [dtm, d_tm],
                        [etm, e_tm],
                        [htm, h_tm],
                        [ltm, l_tm],
                        [mtm, m_tm],
                        [tm, n_tm],
                        [ptm, p_tm]
