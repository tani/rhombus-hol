def REAL_SHRINK_LE:
  prove(
    [
      hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Iff(
            App(
              Const("real_le", Fun(Real, Fun(Real, Bool))),
              [
                App(
                  Const("real_div", Fun(Real, Fun(Real, Real))),
                  [
                    Ref("x"),
                    App(
                      Const("real_add", Fun(Real, Fun(Real, Real))),
                      [
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                        ),
                        App(Const("real_abs", Fun(Real, Real)), [Ref("x")])
                      ]
                    )
                  ]
                ),
                App(
                  Const("real_div", Fun(Real, Fun(Real, Real))),
                  [
                    Ref("y"),
                    App(
                      Const("real_add", Fun(Real, Fun(Real, Real))),
                      [
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                        ),
                        App(Const("real_abs", Fun(Real, Real)), [Ref("y")])
                      ]
                    )
                  ]
                )
              ]
            ),
            App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("y")])
          )
        )
      )),
      REWRITE_TAC(PairList [GSYM(REAL_NOT_LT), REAL_SHRINK_LT])
    ]
  )

