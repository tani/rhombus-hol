                  | (if (Host.hol_equal(op)(min_tm_2) || Host.hol_equal(op)(max_tm_2)) | Fusion.MK_COMB([Equal.AP_TERM(op)(REAL_POLY_CONV(l)), REAL_POLY_CONV(r)]) | Fusion.REFL(tm))
