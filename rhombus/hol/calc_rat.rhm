def REAL_ARITH:
  let port_tmp_322_init = Simp.GEN_REWRITE_CONV(Equal.ONCE_DEPTH_CONV)(PairList.cons(DECIMAL,PairList []))
  let port_tmp_323_pure = GEN_REAL_ARITH(Realarith.REAL_LINEAR_PROVER)
