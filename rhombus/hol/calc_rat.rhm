                                        Var("x'", Real)
                                      ]
                                    ),
                                    App(
                                      Const("real_lt", Fun(Real, Fun(Real, Bool))),
                                      [
                                        App(
                                          Const("real_of_num", Fun(Num, Real)),
                                          [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                                        ),
                                        Var("x", Real)
                                      ]
                                    )
                                  ),
                                  And(
                                    Iff(
                                      App(
                                        Const("real_lt", Fun(Real, Fun(Real, Bool))),
                                        [
                                          App(
                                            Const("real_of_num", Fun(Num, Real)),
                                            [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                                          ),
                                          Var("y'", Real)
                                        ]
                                      ),
                                      App(
                                        Const("real_lt", Fun(Real, Fun(Real, Bool))),
                                        [
                                          App(
                                            Const("real_of_num", Fun(Num, Real)),
                                            [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                                          ),
                                          Var("y", Real)
                                        ]
                                      )
                                    ),
                                    And(
                                      Iff(
                                        App(
                                          Const("real_lt", Fun(Real, Fun(Real, Bool))),
                                          [
                                            App(Const("real_abs", Fun(Real, Real)), [Var("x'", Real)]),
                                            App(Const("real_abs", Fun(Real, Real)), [Var("y'", Real)])
                                          ]
                                        ),
                                        App(
                                          Const("real_lt", Fun(Real, Fun(Real, Bool))),
                                          [
                                            App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)]),
                                            App(Const("real_abs", Fun(Real, Real)), [Var("y", Real)])
                                          ]
                                        )
                                      ),
                                      Iff(
                                        App(
                                          Const("real_lt", Fun(Real, Fun(Real, Bool))),
                                          [
                                            App(Const("real_abs", Fun(Real, Real)), [Var("y'", Real)]),
                                            App(Const("real_abs", Fun(Real, Real)), [Var("x'", Real)])
                                          ]
                                        ),
                                        App(
