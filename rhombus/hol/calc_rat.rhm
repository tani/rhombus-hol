def DECIMAL:
  new_definition(
    hol_term(Eq(
      Real,
      App(Var("DECIMAL", Fun(Num, Fun(Num, Real))), [Var("x", Num), Var("y", Num)]),
      App(
        Const("real_div", Fun(Real, Fun(Real, Real))),
        [
          App(Const("real_of_num", Fun(Num, Real)), [Var("x", Num)]),
          App(Const("real_of_num", Fun(Num, Real)), [Var("y", Num)])
        ]
      )
    ))
  )

def RAT_LEMMA1:
  prove(
    [
      hol_term(Implies(
        And(
          Not(
            Eq(
              Real,
              Var("y1", Real),
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              )
            )
          ),
          Not(
            Eq(
              Real,
              Var("y2", Real),
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              )
            )
          )
        ),
        Eq(
          Real,
          App(
            Const("real_add", Fun(Real, Fun(Real, Real))),
            [
              App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x1", Real), Var("y1", Real)]),
              App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x2", Real), Var("y2", Real)])
            ]
          ),
          App(
            Const("real_mul", Fun(Real, Fun(Real, Real))),
            [
              App(
                Const("real_add", Fun(Real, Fun(Real, Real))),
                [
                  App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x1", Real), Var("y2", Real)]),
                  App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x2", Real), Var("y1", Real)])
                ]
              ),
              App(
                Const("real_mul", Fun(Real, Fun(Real, Real))),
                [
                  App(Const("real_inv", Fun(Real, Real)), [Var("y1", Real)]),
                  App(Const("real_inv", Fun(Real, Real)), [Var("y2", Real)])
                ]
              )
            ]
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (STRIP_TAC then_tac REWRITE_TAC(PairList [real_div, REAL_ADD_RDISTRIB])) then_tac \
                        BINOP_TAC
                      ) then_list \
                      PairList [
                        (
                          (REWRITE_TAC(PairList [GSYM(REAL_MUL_ASSOC)]) then_tac AP_TERM_TAC) then_tac \
                          ONCE_REWRITE_TAC(
                            PairList [
                              AC(REAL_MUL_AC)(
                                hol_term(Eq(
                                  Real,
                                  App(
                                    Const("real_mul", Fun(Real, Fun(Real, Real))),
                                    [
                                      Var("a", Real),
                                      App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("b", Real), Var("c", Real)])
                                    ]
                                  ),
                                  App(
                                    Const("real_mul", Fun(Real, Fun(Real, Real))),
                                    [
                                      App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("b", Real), Var("a", Real)]),
                                      Var("c", Real)
                                    ]
                                  )
                                ))
                              )
                            ]
                          )
                        ),
                        (
                          (REWRITE_TAC(PairList [REAL_MUL_ASSOC]) then_tac AP_THM_TAC) then_tac \
                          AP_TERM_TAC
                        )
                      ]
                    ) then_tac \
                    GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_MUL_RID)])
                  ) then_tac \
                  REWRITE_TAC(PairList [GSYM(REAL_MUL_ASSOC)])
                ) then_tac \
                REWRITE_TAC(PairList [REAL_EQ_MUL_LCANCEL])
              ) then_tac \
              DISJ2_TAC
            ) then_tac \
            CONV_TAC(SYM_CONV)
          ) then_tac \
          MATCH_MP_TAC(REAL_MUL_RINV)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def RAT_LEMMA2:
  prove(
    [
      hol_term(Implies(
        And(
          App(
            Const("real_lt", Fun(Real, Fun(Real, Bool))),
            [
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              ),
              Var("y1", Real)
            ]
          ),
          App(
            Const("real_lt", Fun(Real, Fun(Real, Bool))),
            [
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              ),
              Var("y2", Real)
            ]
          )
        ),
        Eq(
          Real,
          App(
            Const("real_add", Fun(Real, Fun(Real, Real))),
            [
              App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x1", Real), Var("y1", Real)]),
              App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x2", Real), Var("y2", Real)])
            ]
          ),
          App(
            Const("real_mul", Fun(Real, Fun(Real, Real))),
            [
              App(
                Const("real_add", Fun(Real, Fun(Real, Real))),
                [
                  App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x1", Real), Var("y2", Real)]),
                  App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x2", Real), Var("y1", Real)])
                ]
              ),
              App(
                Const("real_mul", Fun(Real, Fun(Real, Real))),
                [
                  App(Const("real_inv", Fun(Real, Real)), [Var("y1", Real)]),
                  App(Const("real_inv", Fun(Real, Real)), [Var("y2", Real)])
                ]
              )
            ]
          )
        )
      )),
      (
        (
          (
            (
              (
                (DISCH_TAC then_tac MATCH_MP_TAC(RAT_LEMMA1)) then_tac \
                POP_ASSUM(MP_TAC)
              ) then_tac \
              ONCE_REWRITE_TAC(PairList [GSYM(CONTRAPOS_THM)])
            ) then_tac \
            REWRITE_TAC(PairList [DE_MORGAN_THM])
          ) then_tac \
          STRIP_TAC
        ) then_tac \
        ASM_REWRITE_TAC(PairList [REAL_LT_REFL])
