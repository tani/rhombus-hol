                            Realarith.REAL_ARITH(
                              hol_term(Iff(
                                App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Var("a", Real), Var("b", Real)]),
                                App(
                                  Const("real_le", Fun(Real, Fun(Real, Bool))),
                                  [
                                    App(
                                      Const("real_of_num", Fun(Num, Real)),
                                      [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                                    ),
                                    App(Const("real_sub", Fun(Real, Fun(Real, Real))), [Var("b", Real), Var("a", Real)])
                                  ]
                                )
                              ))
                            )
                          ]
                        )
                      ) then_tac \
                      FIRST_ASSUM((fun(th): REWRITE_TAC(PairList [MATCH_MP(RAT_LEMMA3)(th)])))
                    ) then_tac \
                    MATCH_MP_TAC(EQ_TRANS)
                  ) then_tac \
                  EXISTS_TAC(
                    hol_term(App(
                      Const("real_le", Fun(Real, Fun(Real, Bool))),
                      [
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                        ),
                        App(
                          Const("real_mul", Fun(Real, Fun(Real, Real))),
                          [
                            App(
                              Const("real_sub", Fun(Real, Fun(Real, Real))),
                              [
                                App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x2", Real), Var("y1", Real)]),
                                App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x1", Real), Var("y2", Real)])
                              ]
                            ),
                            App(Const("real_inv", Fun(Real, Real)), [Var("y2", Real)])
                          ]
                        )
                      ]
                    ))
                  )
                ) then_tac \
                REWRITE_TAC(PairList [REAL_MUL_ASSOC])
              ) then_tac \
              CONJ_TAC
            ) then_tac \
            MATCH_MP_TAC(lemma)
          ) then_tac \
          MATCH_MP_TAC(REAL_LT_INV)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def RAT_LEMMA5:
  prove(
    [
      hol_term(Implies(
        And(
          App(
            Const("real_lt", Fun(Real, Fun(Real, Bool))),
            [
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              ),
              Var("y1", Real)
            ]
          ),
          App(
            Const("real_lt", Fun(Real, Fun(Real, Bool))),
            [
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              ),
              Var("y2", Real)
            ]
          )
        ),
        Iff(
          Eq(
            Real,
            App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x1", Real), Var("y1", Real)]),
            App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x2", Real), Var("y2", Real)])
          ),
          Eq(
            Real,
            App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x1", Real), Var("y2", Real)]),
            App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x2", Real), Var("y1", Real)])
          )
        )
      )),
      (
        (
          (
            (
              (
                REPEAT(DISCH_TAC) then_tac \
                REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM)])
              ) then_tac \
              MATCH_MP_TAC(
                TAUT(
                  hol_term(Implies(
                    And(Iff(Var("a", Bool), Var("a'", Bool)), Iff(Var("b", Bool), Var("b'", Bool))),
                    Iff(And(Var("a", Bool), Var("b", Bool)), And(Var("a'", Bool), Var("b'", Bool)))
                  ))
                )
              )
            ) then_tac \
            CONJ_TAC
          ) then_tac \
          MATCH_MP_TAC(RAT_LEMMA4)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def REAL_INT_RAT_CONV:
  let pth:
    prove(
      [
        hol_term(And(
          Eq(
            Real,
            App(Const("real_of_num", Fun(Num, Real)), [Var("x", Num)]),
            App(
              Const("real_div", Fun(Real, Fun(Real, Real))),
              [
                App(Const("real_of_num", Fun(Num, Real)), [Var("x", Num)]),
                App(
                  Const("real_of_num", Fun(Num, Real)),
                  [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                )
              ]
            )
          ),
          And(
            Eq(
              Real,
              App(
                Const("real_neg", Fun(Real, Real)),
                [App(Const("real_of_num", Fun(Num, Real)), [Var("x", Num)])]
              ),
              App(
                Const("real_div", Fun(Real, Fun(Real, Real))),
                [
                  App(
                    Const("real_neg", Fun(Real, Real)),
                    [App(Const("real_of_num", Fun(Num, Real)), [Var("x", Num)])]
                  ),
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                  )
                ]
              )
            ),
            And(
              Eq(
                Real,
                App(Const("DECIMAL", Fun(Num, Fun(Num, Real))), [Var("x", Num), Var("y", Num)]),
                App(
                  Const("real_div", Fun(Real, Fun(Real, Real))),
                  [
                    App(Const("real_of_num", Fun(Num, Real)), [Var("x", Num)]),
                    App(Const("real_of_num", Fun(Num, Real)), [Var("y", Num)])
                  ]
                )
              ),
              Eq(
                Real,
                App(
                  Const("real_neg", Fun(Real, Real)),
                  [App(Const("DECIMAL", Fun(Num, Fun(Num, Real))), [Var("x", Num), Var("y", Num)])]
                ),
                App(
                  Const("real_div", Fun(Real, Fun(Real, Real))),
                  [
                    App(
                      Const("real_neg", Fun(Real, Real)),
                      [App(Const("real_of_num", Fun(Num, Real)), [Var("x", Num)])]
                    ),
                    App(Const("real_of_num", Fun(Num, Real)), [Var("y", Num)])
                  ]
                )
              )
            )
          )
        )),
        (
          REWRITE_TAC(PairList [REAL_DIV_1, DECIMAL]) then_tac \
          REWRITE_TAC(PairList [real_div, REAL_MUL_LNEG])
        )
      ]
    )
  TRY_CONV(GEN_REWRITE_CONV(I)(PairList [pth]))

def REAL_RAT_LE_CONV:
  let pth_2:
    prove(
      [
        hol_term(Implies(
          App(
            Const("real_lt", Fun(Real, Fun(Real, Bool))),
            [
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              ),
              Var("y1", Real)
            ]
          ),
          Implies(
            App(
              Const("real_lt", Fun(Real, Fun(Real, Bool))),
              [
                App(
                  Const("real_of_num", Fun(Num, Real)),
                  [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                ),
                Var("y2", Real)
              ]
            ),
            Iff(
              App(
                Const("real_le", Fun(Real, Fun(Real, Bool))),
                [
                  App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x1", Real), Var("y1", Real)]),
                  App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x2", Real), Var("y2", Real)])
                ]
              ),
              App(
                Const("real_le", Fun(Real, Fun(Real, Bool))),
                [
                  App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x1", Real), Var("y2", Real)]),
                  App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x2", Real), Var("y1", Real)])
                ]
              )
            )
          )
        )),
        REWRITE_TAC(PairList [IMP_IMP, RAT_LEMMA4])
      ]
    )
  let x1_2 = hol_term(Var("x1", Real))
  let x2_2 = hol_term(Var("x2", Real))
  let y1_2 = hol_term(Var("y1", Real))
  let y2_2 = hol_term(Var("y2", Real))
  let dest_le_2 = dest_binop(hol_term(Const("real_le", Fun(Real, Fun(Real, Bool)))))
  let dest_div_2 = dest_binop(hol_term(Const("real_div", Fun(Real, Fun(Real, Real)))))
  let RAW_REAL_RAT_LE_CONV:
    fun(tm):
      let [l, r] = dest_le_2(tm)
      let [lx_2, ly_2] = dest_div_2(l)
      let [rx_2, ry_2] = dest_div_2(r)
      let th0 = INST(PairList [[lx_2, x1_2], [ly_2, y1_2], [rx_2, x2_2], [ry_2, y2_2]])(pth_2)
      let th1 = funpow(2)(MP_CONV(REAL_INT_LT_CONV))(th0)
      let th2 = (BINOP_CONV(REAL_INT_MUL_CONV) then_conv REAL_INT_LE_CONV)(rand(concl(th1)))
      TRANS(th1)(th2)
  (BINOP_CONV(REAL_INT_RAT_CONV) then_conv RAW_REAL_RAT_LE_CONV)

