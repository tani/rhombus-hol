              Const("real_neg", Fun(Real, Real)),
              [
                App(
                  Const("real_of_num", Fun(Num, Real)),
                  [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                )
              ]
            ),
            App(
              Const("real_of_num", Fun(Num, Real)),
              [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
            )
          ),
          And(
            Eq(
              Real,
              App(
                Const("real_neg", Fun(Real, Real)),
                [
                  App(
                    Const("real_neg", Fun(Real, Real)),
                    [App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])]
                  )
                ]
              ),
              App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])
            ),
            And(
              Eq(
                Real,
                App(
                  Const("real_neg", Fun(Real, Real)),
                  [
                    App(
                      Const("real_div", Fun(Real, Fun(Real, Real))),
                      [
                        App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)]),
                        App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])
                      ]
                    )
                  ]
                ),
                App(
                  Const("real_div", Fun(Real, Fun(Real, Real))),
                  [
                    App(
                      Const("real_neg", Fun(Real, Real)),
                      [App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)])]
                    ),
                    App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])
                  ]
                )
              ),
              And(
                Eq(
                  Real,
                  App(
                    Const("real_neg", Fun(Real, Real)),
                    [
                      App(
                        Const("real_div", Fun(Real, Fun(Real, Real))),
                        [
                          App(
                            Const("real_neg", Fun(Real, Real)),
                            [App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)])]
                          ),
                          App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])
                        ]
                      )
                    ]
                  ),
                  App(
                    Const("real_div", Fun(Real, Fun(Real, Real))),
                    [
                      App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)]),
                      App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])
                    ]
                  )
                ),
                Eq(
                  Real,
                  App(
                    Const("real_neg", Fun(Real, Real)),
                    [App(Const("DECIMAL", Fun(Num, Fun(Num, Real))), [Var("m", Num), Var("n", Num)])]
                  ),
                  App(
                    Const("real_div", Fun(Real, Fun(Real, Real))),
                    [
                      App(
                        Const("real_neg", Fun(Real, Real)),
                        [App(Const("real_of_num", Fun(Num, Real)), [Var("m", Num)])]
                      ),
                      App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])
                    ]
                  )
                )
              )
            )
          )
        )),
        REWRITE_TAC(
          PairList [
            real_div,
            REAL_INV_NEG,
            REAL_MUL_LNEG,
            REAL_NEG_NEG,
            REAL_NEG_0,
            DECIMAL
          ]
        )
      ]
    )
  let ptm_2 = hol_term(Const("real_neg", Fun(Real, Real)))
  let conv1 = GEN_REWRITE_CONV(I)(PairList [pth_5])
  fun(tm):
    try:
      conv1(tm)
      ~catch exn:
        match exn
        | Failure(_):
            try:
              let [l, r] = dest_comb(tm)
              (if ((l == ptm_2) && (is_realintconst(r) && (dest_realintconst(r) > num_0))) | REFL(tm) | fail())
              ~catch exn:
                match exn
                | Failure(_): failwith("REAL_RAT_NEG_CONV")
                | exn: (throw exn)
        | exn: (throw exn)

