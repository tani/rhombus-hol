                            ),
                            Forall(
                              "x",
                              Tvar("?65469"),
                              Forall(
                                "y",
                                Tvar("?65469"),
                                App(Var("P", Fun(Tvar("?65469"), Fun(Tvar("?65469"), Bool))), [Ref("x"), Ref("y")])
                              )
                            )
                          ))
                        )
                      ]
                    )
                  ) then_tac \
                  REPEAT(GEN_TAC)
                ) then_tac \
                REWRITE_TAC(
                  PairList [
                    REAL_ABS_DIV,
                    REAL_ARITH(
                      hol_term(Eq(
                        Real,
                        App(
                          Const("real_abs", Fun(Real, Real)),
                          [
                            App(
                              Const("real_add", Fun(Real, Fun(Real, Real))),
                              [
                                App(
                                  Const("real_of_num", Fun(Num, Real)),
                                  [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                                ),
                                App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])
                              ]
                            )
                          ]
                        ),
                        App(
                          Const("real_add", Fun(Real, Fun(Real, Real))),
                          [
                            App(
                              Const("real_of_num", Fun(Num, Real)),
                              [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                            ),
                            App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])
                          ]
                        )
                      ))
                    )
                  ]
                )
              ) then_tac \
              SIMP_TAC(
                PairList [
                  REAL_LT_RDIV_EQ,
                  REAL_ARITH(
                    hol_term(App(
                      Const("real_lt", Fun(Real, Fun(Real, Bool))),
                      [
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                        ),
                        App(
                          Const("real_add", Fun(Real, Fun(Real, Real))),
                          [
                            App(
                              Const("real_of_num", Fun(Num, Real)),
                              [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                            ),
                            App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])
                          ]
                        )
                      ]
                    ))
                  )
                ]
              )
            ) then_tac \
            ONCE_REWRITE_TAC(
              PairList [
                REAL_ARITH(
                  hol_term(Eq(
                    Real,
                    App(
                      Const("real_mul", Fun(Real, Fun(Real, Real))),
                      [
                        App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("a", Real), Var("b", Real)]),
                        Var("c", Real)
                      ]
                    ),
                    App(
                      Const("real_div", Fun(Real, Fun(Real, Real))),
                      [
                        App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("a", Real), Var("c", Real)]),
                        Var("b", Real)
                      ]
