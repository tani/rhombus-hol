def REAL_SHRINK_GALOIS:
  prove(
    [
      hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Iff(
            Eq(
              Real,
              App(
                Const("real_div", Fun(Real, Fun(Real, Real))),
                [
                  Ref("x"),
                  App(
                    Const("real_add", Fun(Real, Fun(Real, Real))),
                    [
                      App(
                        Const("real_of_num", Fun(Num, Real)),
                        [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                      ),
                      App(Const("real_abs", Fun(Real, Real)), [Ref("x")])
                    ]
                  )
                ]
              ),
              Ref("y")
            ),
            And(
              App(
                Const("real_lt", Fun(Real, Fun(Real, Bool))),
                [
                  App(Const("real_abs", Fun(Real, Real)), [Ref("y")]),
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                  )
                ]
              ),
              Eq(
                Real,
                App(
                  Const("real_div", Fun(Real, Fun(Real, Real))),
                  [
                    Ref("y"),
                    App(
                      Const("real_sub", Fun(Real, Fun(Real, Real))),
                      [
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                        ),
                        App(Const("real_abs", Fun(Real, Real)), [Ref("y")])
                      ]
                    )
                  ]
                ),
                Ref("x")
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      ((REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac STRIP_TAC) then_tac \
                      FIRST_X_ASSUM(o(SUBST1_TAC)(SYM))
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [REAL_SHRINK_RANGE])
                  ) then_tac \
                  ASM_SIMP_TAC(
                    PairList [
                      REAL_ABS_DIV,
                      REAL_ARITH(
                        hol_term(Eq(
                          Real,
                          App(
                            Const("real_abs", Fun(Real, Real)),
                            [
                              App(
                                Const("real_add", Fun(Real, Fun(Real, Real))),
                                [
                                  App(
                                    Const("real_of_num", Fun(Num, Real)),
                                    [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                                  ),
                                  App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])
                                ]
                              )
                            ]
                          ),
                          App(
                            Const("real_add", Fun(Real, Fun(Real, Real))),
                            [
                              App(
                                Const("real_of_num", Fun(Num, Real)),
                                [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                              ),
                              App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])
                            ]
                          )
                        ))
                      ),
                      REAL_ARITH(
                        hol_term(Implies(
                          App(
                            Const("real_lt", Fun(Real, Fun(Real, Bool))),
                            [
                              App(Const("real_abs", Fun(Real, Real)), [Var("y", Real)]),
                              App(
                                Const("real_of_num", Fun(Num, Real)),
                                [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                              )
                            ]
                          ),
                          Eq(
                            Real,
                            App(
                              Const("real_abs", Fun(Real, Real)),
                              [
                                App(
                                  Const("real_sub", Fun(Real, Fun(Real, Real))),
                                  [
                                    App(
                                      Const("real_of_num", Fun(Num, Real)),
                                      [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                                    ),
                                    App(Const("real_abs", Fun(Real, Real)), [Var("y", Real)])
                                  ]
                                )
                              ]
                            ),
                            App(
                              Const("real_sub", Fun(Real, Fun(Real, Real))),
                              [
                                App(
                                  Const("real_of_num", Fun(Num, Real)),
                                  [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                                ),
                                App(Const("real_abs", Fun(Real, Real)), [Var("y", Real)])
                              ]
                            )
                          )
                        ))
                      )
                    ]
                  )
                ) then_tac \
                MATCH_MP_TAC(
                  REAL_ARITH(
                    hol_term(Implies(
                      Eq(
                        Real,
                        App(
                          Const("real_mul", Fun(Real, Fun(Real, Real))),
                          [
                            Var("x", Real),
                            App(
                              Const("real_mul", Fun(Real, Fun(Real, Real))),
                              [
                                App(Const("real_inv", Fun(Real, Real)), [Var("y", Real)]),
                                App(Const("real_inv", Fun(Real, Real)), [Var("z", Real)])
                              ]
                            )
                          ]
                        ),
                        App(
                          Const("real_mul", Fun(Real, Fun(Real, Real))),
                          [
                            Var("x", Real),
                            App(
                              Const("real_of_num", Fun(Num, Real)),
                              [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                            )
                          ]
                        )
                      ),
                      Eq(
                        Real,
                        App(
                          Const("real_div", Fun(Real, Fun(Real, Real))),
                          [
                            App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)]),
                            Var("z", Real)
                          ]
                        ),
                        Var("x", Real)
                      )
                    ))
                  )
                )
              ) then_tac \
              AP_TERM_TAC
            ) then_tac \
            MATCH_MP_TAC(
              REAL_FIELD(
                hol_term(Implies(
                  Eq(
                    Real,
                    App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)]),
                    App(
                      Const("real_of_num", Fun(Num, Real)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                    )
                  ),
                  Eq(
                    Real,
                    App(
                      Const("real_mul", Fun(Real, Fun(Real, Real))),
                      [
                        App(Const("real_inv", Fun(Real, Real)), [Var("x", Real)]),
                        App(Const("real_inv", Fun(Real, Real)), [Var("y", Real)])
                      ]
                    ),
                    App(
                      Const("real_of_num", Fun(Num, Real)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                    )
                  )
                ))
              )
            )
          ) then_tac \
          REPEAT(POP_ASSUM(MP_TAC))
        ) then_tac \
        CONV_TAC(REAL_FIELD)
      )
    ]
  )

def REAL_GROW_SHRINK:
  prove(
    [
      hol_term(Forall(
        "x",
        Real,
        Eq(
          Real,
          App(
            Const("real_div", Fun(Real, Fun(Real, Real))),
            [
              App(
                Const("real_div", Fun(Real, Fun(Real, Real))),
                [
                  Ref("x"),
                  App(
                    Const("real_add", Fun(Real, Fun(Real, Real))),
                    [
                      App(
                        Const("real_of_num", Fun(Num, Real)),
                        [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                      ),
                      App(Const("real_abs", Fun(Real, Real)), [Ref("x")])
                    ]
                  )
                ]
              ),
              App(
                Const("real_sub", Fun(Real, Fun(Real, Real))),
                [
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                  ),
                  App(
                    Const("real_abs", Fun(Real, Real)),
                    [
                      App(
                        Const("real_div", Fun(Real, Fun(Real, Real))),
                        [
                          Ref("x"),
                          App(
                            Const("real_add", Fun(Real, Fun(Real, Real))),
                            [
                              App(
                                Const("real_of_num", Fun(Num, Real)),
                                [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                              ),
                              App(Const("real_abs", Fun(Real, Real)), [Ref("x")])
                            ]
                          )
                        ]
                      )
                    ]
                  )
                ]
              )
            ]
          ),
          Ref("x")
        )
      )),
      MESON_TAC(PairList [REAL_SHRINK_GALOIS, REAL_SHRINK_RANGE])
    ]
  )

def REAL_SHRINK_GROW_EQ:
