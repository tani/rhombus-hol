def DECIMAL:
  new_definition(
    (hol:
       var DECIMAL :: num -> num -> real
       var x :: num
       var y :: num
       const real_of_num :: num -> real
       DECIMAL(x, y) == real_of_num(x) / real_of_num(y))
  )

def RAT_LEMMA1:
  prove(
    [
      (hol:
         var y1 :: real
         var y2 :: real
         var x1 :: real
         var x2 :: real
         const real_inv :: real -> real
         y1 != (0 :: real) && y2 != (0 :: real)
           ==> x1 / y1 + x2 / y2 == (x1 * y2 + x2 * y1) * (real_inv(y1) * real_inv(y2))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (STRIP_TAC then_tac REWRITE_TAC(PairList [real_div, REAL_ADD_RDISTRIB])) then_tac \
                        BINOP_TAC
                      ) then_list \
                      PairList [
                        (
                          (REWRITE_TAC(PairList [GSYM(REAL_MUL_ASSOC)]) then_tac AP_TERM_TAC) then_tac \
                          ONCE_REWRITE_TAC(
                            PairList [
                              AC(REAL_MUL_AC)(
                                (hol:
                                   var a :: real
                                   var b :: real
                                   var c :: real
                                   a * (b * c) == b * a * c)
                              )
                            ]
                          )
                        ),
                        (
                          (REWRITE_TAC(PairList [REAL_MUL_ASSOC]) then_tac AP_THM_TAC) then_tac \
                          AP_TERM_TAC
                        )
                      ]
                    ) then_tac \
                    GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_MUL_RID)])
                  ) then_tac \
                  REWRITE_TAC(PairList [GSYM(REAL_MUL_ASSOC)])
                ) then_tac \
                REWRITE_TAC(PairList [REAL_EQ_MUL_LCANCEL])
              ) then_tac \
              DISJ2_TAC
            ) then_tac \
            CONV_TAC(SYM_CONV)
          ) then_tac \
          MATCH_MP_TAC(REAL_MUL_RINV)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def RAT_LEMMA2:
  prove(
    [
      (hol:
         var y1 :: real
         var y2 :: real
         var x1 :: real
         var x2 :: real
         const real_inv :: real -> real
         (0 :: real) < y1 && (0 :: real) < y2
           ==> x1 / y1 + x2 / y2 == (x1 * y2 + x2 * y1) * (real_inv(y1) * real_inv(y2))),
      (
        (
          (
            (
              (
                (DISCH_TAC then_tac MATCH_MP_TAC(RAT_LEMMA1)) then_tac \
                POP_ASSUM(MP_TAC)
              ) then_tac \
              ONCE_REWRITE_TAC(PairList [GSYM(CONTRAPOS_THM)])
            ) then_tac \
            REWRITE_TAC(PairList [DE_MORGAN_THM])
          ) then_tac \
          STRIP_TAC
        ) then_tac \
        ASM_REWRITE_TAC(PairList [REAL_LT_REFL])
      )
    ]
  )

def RAT_LEMMA3:
  prove(
    [
      (hol:
         var y1 :: real
         var y2 :: real
         var x1 :: real
         var x2 :: real
         const real_inv :: real -> real
         (0 :: real) < y1 && (0 :: real) < y2
           ==> x1 / y1 - x2 / y2 == (x1 * y2 - x2 * y1) * (real_inv(y1) * real_inv(y2))),
      (
        (
          (
            DISCH_THEN(o(o(MP_TAC)(GEN_ALL))(MATCH_MP(RAT_LEMMA2))) then_tac \
            REWRITE_TAC(PairList [real_div])
          ) then_tac \
          DISCH_TAC
        ) then_tac \
        ASM_REWRITE_TAC(PairList [real_sub, GSYM(REAL_MUL_LNEG)])
      )
    ]
  )

def RAT_LEMMA4:
  let lemma:
    prove(
      [
        (hol:
           var y :: real
           var x :: real
           (0 :: real) < y ==> ((0 :: real) <= x * y <=> (0 :: real) <= x)),
        (
          ((DISCH_TAC then_tac EQ_TAC) then_tac DISCH_TAC) then_list \
          PairList [
            (
              SUBGOAL_THEN(
                (hol:
                   var x :: real
                   var y :: real
                   const real_inv :: real -> real
                   (0 :: real) <= x * (y * real_inv(y)))
              )(MP_TAC) then_list \
              PairList [
                (
                  (
                    (
                      (
                        (
                          REWRITE_TAC(PairList [REAL_MUL_ASSOC]) then_tac \
                          MATCH_MP_TAC(REAL_LE_MUL)
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [])
                      ) then_tac \
                      MATCH_MP_TAC(REAL_LE_INV)
                    ) then_tac \
                    MATCH_MP_TAC(REAL_LT_IMP_LE)
                  ) then_tac \
                  ASM_REWRITE_TAC(PairList [])
                ),
                (
                  (
                    (
                      SUBGOAL_THEN(
                        (hol:
                           var y :: real
                           const real_inv :: real -> real
                           y * real_inv(y) == (1 :: real))
                      )((fun(th): REWRITE_TAC(PairList [th, REAL_MUL_RID]))) then_tac \
                      MATCH_MP_TAC(REAL_MUL_RINV)
                    ) then_tac \
                    UNDISCH_TAC(
                      (hol:
                         var y :: real
                         (0 :: real) < y)
                    )
                  ) then_tac \
                  Real.REAL_ARITH_TAC
                )
              ]
            ),
            (
              (
                (MATCH_MP_TAC(REAL_LE_MUL) then_tac ASM_REWRITE_TAC(PairList [])) then_tac \
                MATCH_MP_TAC(REAL_LT_IMP_LE)
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            )
          ]
        )
      ]
    )
  prove(
    [
      (hol:
         var y1 :: real
         var y2 :: real
         var x1 :: real
         var x2 :: real
         (0 :: real) < y1 && (0 :: real) < y2 ==> (x1 / y1 <= x2 / y2 <=> x1 * y2 <= x2 * y1)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (ONCE_REWRITE_TAC(PairList [CONJ_SYM]) then_tac DISCH_TAC) then_tac \
                        ONCE_REWRITE_TAC(
                          PairList [
                            Realarith.REAL_ARITH(
                              (hol:
                                 var a :: real
                                 var b :: real
                                 a <= b <=> (0 :: real) <= b - a)
                            )
                          ]
                        )
                      ) then_tac \
                      FIRST_ASSUM((fun(th): REWRITE_TAC(PairList [MATCH_MP(RAT_LEMMA3)(th)])))
                    ) then_tac \
                    MATCH_MP_TAC(EQ_TRANS)
                  ) then_tac \
                  EXISTS_TAC(
                    (hol:
                       var x2 :: real
                       var y1 :: real
                       var x1 :: real
                       var y2 :: real
                       const real_inv :: real -> real
                       (0 :: real) <= (x2 * y1 - x1 * y2) * real_inv(y2))
                  )
                ) then_tac \
                REWRITE_TAC(PairList [REAL_MUL_ASSOC])
              ) then_tac \
              CONJ_TAC
            ) then_tac \
            MATCH_MP_TAC(lemma)
          ) then_tac \
          MATCH_MP_TAC(REAL_LT_INV)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def RAT_LEMMA5:
  prove(
    [
      (hol:
         var y1 :: real
         var y2 :: real
         var x1 :: real
         var x2 :: real
         (0 :: real) < y1 && (0 :: real) < y2 ==> (x1 / y1 == x2 / y2 <=> x1 * y2 == x2 * y1)),
      (
        (
          (
            (
              (
                REPEAT(DISCH_TAC) then_tac \
                REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM)])
              ) then_tac \
              MATCH_MP_TAC(
                TAUT(
                  (hol:
                     var a :: bool
                     var #{|a'|} :: bool
                     var b :: bool
                     var #{|b'|} :: bool
                     (a <=> var.#{|a'|}) && (b <=> var.#{|b'|}) ==> (a && b <=> var.#{|a'|} && var.#{|b'|}))
                )
              )
            ) then_tac \
            CONJ_TAC
          ) then_tac \
          MATCH_MP_TAC(RAT_LEMMA4)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def REAL_INT_RAT_CONV:
  let pth:
    prove(
      [
        (hol:
           var x :: num
           var y :: num
           const real_of_num :: num -> real
           const DECIMAL :: num -> num -> real
           real_of_num(x) == real_of_num(x) / (1 :: real)
             && (-real_of_num(x) == (-real_of_num(x)) / (1 :: real)
                   && (DECIMAL(x, y) == real_of_num(x) / real_of_num(y)
                         && -DECIMAL(x, y) == (-real_of_num(x)) / real_of_num(y)))),
        (
          REWRITE_TAC(PairList [REAL_DIV_1, DECIMAL]) then_tac \
          REWRITE_TAC(PairList [real_div, REAL_MUL_LNEG])
        )
      ]
    )
  TRY_CONV(GEN_REWRITE_CONV(I)(PairList [pth]))

def REAL_RAT_LE_CONV:
  let pth_2:
    prove(
      [
        (hol:
           var y1 :: real
           var y2 :: real
           var x1 :: real
           var x2 :: real
           (0 :: real) < y1 ==> (0 :: real) < y2 ==> (x1 / y1 <= x2 / y2 <=> x1 * y2 <= x2 * y1)),
        REWRITE_TAC(PairList [IMP_IMP, RAT_LEMMA4])
      ]
    )
  let x1_2 = hol: var x1 :: real; x1
  let x2_2 = hol: var x2 :: real; x2
  let y1_2 = hol: var y1 :: real; y1
  let y2_2 = hol: var y2 :: real; y2
  let dest_le_2 = dest_binop(hol: const real_le :: real -> real -> bool; real_le)
  let dest_div_2 = dest_binop(hol: const real_div :: real -> real -> real; real_div)
  let RAW_REAL_RAT_LE_CONV:
    fun(tm):
      let [l, r] = dest_le_2(tm)
      let [lx_2, ly_2] = dest_div_2(l)
      let [rx_2, ry_2] = dest_div_2(r)
      let th0 = INST(PairList [[lx_2, x1_2], [ly_2, y1_2], [rx_2, x2_2], [ry_2, y2_2]])(pth_2)
      let th1 = funpow(2)(MP_CONV(REAL_INT_LT_CONV))(th0)
      let th2 = (BINOP_CONV(REAL_INT_MUL_CONV) then_conv REAL_INT_LE_CONV)(rand(concl(th1)))
      TRANS(th1)(th2)
  (BINOP_CONV(REAL_INT_RAT_CONV) then_conv RAW_REAL_RAT_LE_CONV)

def REAL_RAT_LT_CONV:
  let pth_3:
    prove(
      [
        (hol:
           var y1 :: real
           var y2 :: real
           var x1 :: real
           var x2 :: real
           (0 :: real) < y1 ==> (0 :: real) < y2 ==> (x1 / y1 < x2 / y2 <=> x1 * y2 < x2 * y1)),
        (
          (
            REWRITE_TAC(PairList [IMP_IMP]) then_tac \
            GEN_REWRITE_TAC(o(RAND_CONV)(ONCE_DEPTH_CONV))(PairList [GSYM(REAL_NOT_LE)])
          ) then_tac \
          SIMP_TAC(
            PairList [
              TAUT(
                (hol:
                   var a :: bool
                   var b :: bool
                   (!a <=> !b) <=> (a <=> b))
              ),
              RAT_LEMMA4
            ]
          )
        )
      ]
    )
  let x1_3 = hol: var x1 :: real; x1
  let x2_3 = hol: var x2 :: real; x2
  let y1_3 = hol: var y1 :: real; y1
  let y2_3 = hol: var y2 :: real; y2
  let dest_lt_2 = dest_binop(hol: const real_lt :: real -> real -> bool; real_lt)
  let dest_div_3 = dest_binop(hol: const real_div :: real -> real -> real; real_div)
  let RAW_REAL_RAT_LT_CONV:
    fun(tm):
      let [l, r] = dest_lt_2(tm)
      let [lx_3, ly_3] = dest_div_3(l)
      let [rx_3, ry_3] = dest_div_3(r)
      let th0 = INST(PairList [[lx_3, x1_3], [ly_3, y1_3], [rx_3, x2_3], [ry_3, y2_3]])(pth_3)
      let th1 = funpow(2)(MP_CONV(REAL_INT_LT_CONV))(th0)
      let th2 = (BINOP_CONV(REAL_INT_MUL_CONV) then_conv REAL_INT_LT_CONV)(rand(concl(th1)))
      TRANS(th1)(th2)
  (BINOP_CONV(REAL_INT_RAT_CONV) then_conv RAW_REAL_RAT_LT_CONV)

def REAL_RAT_GE_CONV = (GEN_REWRITE_CONV(I)(PairList [real_ge]) then_conv REAL_RAT_LE_CONV)

def REAL_RAT_GT_CONV = (GEN_REWRITE_CONV(I)(PairList [real_gt]) then_conv REAL_RAT_LT_CONV)

def REAL_RAT_EQ_CONV:
  let pth_4:
    prove(
      [
        (hol:
           var y1 :: real
           var y2 :: real
           var x1 :: real
           var x2 :: real
           (0 :: real) < y1 ==> (0 :: real) < y2 ==> (x1 / y1 == x2 / y2 <=> x1 * y2 == x2 * y1)),
        REWRITE_TAC(PairList [IMP_IMP, RAT_LEMMA5])
      ]
    )
  let x1_4 = hol: var x1 :: real; x1
  let x2_4 = hol: var x2 :: real; x2
  let y1_4 = hol: var y1 :: real; y1
  let y2_4 = hol: var y2 :: real; y2
  let dest_eq_2 = dest_binop(hol: const #{=} :: A -> A -> bool; const.#{=})
  let dest_div_4 = dest_binop(hol: const real_div :: real -> real -> real; real_div)
  let RAW_REAL_RAT_EQ_CONV:
    fun(tm):
      let [l, r] = dest_eq_2(tm)
      let [lx_4, ly_4] = dest_div_4(l)
      let [rx_4, ry_4] = dest_div_4(r)
      let th0 = INST(PairList [[lx_4, x1_4], [ly_4, y1_4], [rx_4, x2_4], [ry_4, y2_4]])(pth_4)
      let th1 = funpow(2)(MP_CONV(REAL_INT_LT_CONV))(th0)
      let th2 = (BINOP_CONV(REAL_INT_MUL_CONV) then_conv REAL_INT_EQ_CONV)(rand(concl(th1)))
      TRANS(th1)(th2)
  (BINOP_CONV(REAL_INT_RAT_CONV) then_conv RAW_REAL_RAT_EQ_CONV)

def REAL_RAT_SGN_CONV:
  (
    (
      GEN_REWRITE_CONV(I)(PairList [real_sgn]) then_conv \
      RATOR_CONV(LAND_CONV(REAL_RAT_LT_CONV))
    ) then_conv \
    (
      GEN_REWRITE_CONV(I)(PairList [CONJUNCT1(SPEC_ALL(COND_CLAUSES))]) or_conv \
      (
        (
          GEN_REWRITE_CONV(I)(PairList [CONJUNCT2(SPEC_ALL(COND_CLAUSES))]) then_conv \
          RATOR_CONV(LAND_CONV(REAL_RAT_LT_CONV))
        ) then_conv \
        GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES])
      )
    )
  )

def REAL_RAT_NEG_CONV:
  let pth_5:
    prove(
      [
        (hol:
           var n :: num
           var m :: num
           const real_of_num :: num -> real
           const DECIMAL :: num -> num -> real
           -(0 :: real) == (0 :: real)
             && (-(-real_of_num(n)) == real_of_num(n)
                   && (-(real_of_num(m) / real_of_num(n)) == (-real_of_num(m)) / real_of_num(n)
                         && (-((-real_of_num(m)) / real_of_num(n)) == real_of_num(m) / real_of_num(n)
                               && -DECIMAL(m, n) == (-real_of_num(m)) / real_of_num(n))))),
        REWRITE_TAC(
          PairList [
            real_div,
            REAL_INV_NEG,
            REAL_MUL_LNEG,
            REAL_NEG_NEG,
            REAL_NEG_0,
            DECIMAL
          ]
        )
      ]
    )
  let ptm_2 = hol: const real_neg :: real -> real; real_neg
  let conv1 = GEN_REWRITE_CONV(I)(PairList [pth_5])
  fun(tm):
    try:
      conv1(tm)
      ~catch exn:
        match exn
        | Failure(_):
            try:
              let [l, r] = dest_comb(tm)
              (if ((l == ptm_2) && (is_realintconst(r) && (dest_realintconst(r) > num_0))) | REFL(tm) | fail())
              ~catch exn:
                match exn
                | Failure(_): failwith("REAL_RAT_NEG_CONV")
                | exn: (throw exn)
        | exn: (throw exn)

def REAL_RAT_ABS_CONV:
  let pth:
    prove(
      [
        (hol:
           var n :: num
           var m :: num
           const real_abs :: real -> real
           const real_of_num :: num -> real
           const DECIMAL :: num -> num -> real
           real_abs(real_of_num(n)) == real_of_num(n)
             && (real_abs(-real_of_num(n)) == real_of_num(n)
                   && (real_abs(real_of_num(m) / real_of_num(n)) == real_of_num(m) / real_of_num(n)
                         && ((real_abs((-real_of_num(m)) / real_of_num(n))
                                == real_of_num(m) / real_of_num(n))
                               && (real_abs(DECIMAL(m, n)) == real_of_num(m) / real_of_num(n)
                                     && real_abs(-DECIMAL(m, n)) == real_of_num(m) / real_of_num(n)))))),
        REWRITE_TAC(PairList [DECIMAL, REAL_ABS_DIV, REAL_ABS_NEG, REAL_ABS_NUM])
      ]
    )
  GEN_REWRITE_CONV(I)(PairList [pth])

def REAL_RAT_INV_CONV:
  let pth1_2:
    prove(
      [
        (hol:
           var n :: num
           const real_inv :: real -> real
           const real_of_num :: num -> real
           real_inv((0 :: real)) == (0 :: real)
             && (real_inv((1 :: real)) == (1 :: real)
                   && (real_inv(-(1 :: real)) == -(1 :: real)
                         && (real_inv((1 :: real) / real_of_num(n)) == real_of_num(n)
                               && real_inv((-(1 :: real)) / real_of_num(n)) == -real_of_num(n))))),
        (
          REWRITE_TAC(
            PairList [
              REAL_INV_0,
              REAL_INV_1,
              REAL_INV_NEG,
              REAL_INV_DIV,
              REAL_DIV_1
            ]
          ) then_tac \
          REWRITE_TAC(
            PairList [
              real_div,
              REAL_INV_NEG,
              REAL_MUL_RNEG,
              REAL_INV_1,
              REAL_MUL_RID
            ]
          )
        )
      ]
    )
  let pth2_2:
    prove(
      [
        (hol:
           var n :: num
           var m :: num
           const real_inv :: real -> real
           const real_of_num :: num -> real
           const DECIMAL :: num -> num -> real
           real_inv(real_of_num(n)) == (1 :: real) / real_of_num(n)
             && (real_inv(-real_of_num(n)) == (-(1 :: real)) / real_of_num(n)
                   && (real_inv(real_of_num(m) / real_of_num(n)) == real_of_num(n) / real_of_num(m)
                         && ((real_inv((-real_of_num(m)) / real_of_num(n))
                                == (-real_of_num(n)) / real_of_num(m))
                               && (real_inv(DECIMAL(m, n)) == real_of_num(n) / real_of_num(m)
                                     && real_inv(-DECIMAL(m, n)) == (-real_of_num(n)) / real_of_num(m)))))),
        (
          REWRITE_TAC(PairList [DECIMAL, REAL_INV_DIV]) then_tac \
          REWRITE_TAC(
            PairList [
              REAL_INV_NEG,
              real_div,
              REAL_MUL_RNEG,
              REAL_MUL_AC,
              REAL_MUL_LID,
              REAL_MUL_LNEG,
              REAL_INV_MUL,
              REAL_INV_INV
            ]
          )
        )
      ]
    )
  (GEN_REWRITE_CONV(I)(PairList [pth1_2]) or_conv GEN_REWRITE_CONV(I)(PairList [pth2_2]))

def REAL_RAT_ADD_CONV:
  let pth_6:
    prove(
      [
        (hol:
           var y1 :: real
           var y2 :: real
           var y3 :: real
           var x1 :: real
           var x2 :: real
           var x3 :: real
           (0 :: real) < y1
             ==> (0 :: real) < y2
             ==> (0 :: real) < y3
             ==> (x1 * y2 + x2 * y1) * y3 == x3 * (y1 * y2)
             ==> x1 / y1 + x2 / y2 == x3 / y3),
        (
          (
            (
              (
                (
                  (REPEAT(DISCH_TAC) then_tac MP_TAC(RAT_LEMMA2)) then_tac \
                  ASM_REWRITE_TAC(PairList [])
                ) then_tac \
                DISCH_THEN(SUBST1_TAC)
              ) then_tac \
              REWRITE_TAC(PairList [GSYM(REAL_INV_MUL), GSYM(real_div)])
            ) then_tac \
            SUBGOAL_THEN(
              (hol:
                 var y1 :: real
                 var y2 :: real
                 var y3 :: real
                 (0 :: real) < y1 * y2 && (0 :: real) < y3)
            )(MP_TAC)
          ) then_list \
          PairList [
            (
              (ASM_REWRITE_TAC(PairList []) then_tac MATCH_MP_TAC(REAL_LT_MUL)) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ),
            DISCH_THEN((fun(th): ASM_REWRITE_TAC(PairList [MATCH_MP(RAT_LEMMA5)(th)])))
          ]
        )
      ]
    )
  let dest_divop_2 = dest_binop(hol: const real_div :: real -> real -> real; real_div)
  let dest_addop_2 = dest_binop(hol: const real_add :: real -> real -> real; real_add)
  let x1_5 = hol: var x1 :: real; x1
  let x2_5 = hol: var x2 :: real; x2
  let x3_2 = hol: var x3 :: real; x3
  let y1_5 = hol: var y1 :: real; y1
  let y2_5 = hol: var y2 :: real; y2
  let y3_2 = hol: var y3 :: real; y3
  let RAW_REAL_RAT_ADD_CONV:
    fun(tm):
      let [r1, r2] = dest_addop_2(tm)
      let [x1_prime_2, y1_prime_2] = dest_divop_2(r1)
      let [x2_prime_2, y2_prime_2] = dest_divop_2(r2)
      let x1n_2 = dest_realintconst(x1_prime_2)
      let y1n_2 = dest_realintconst(y1_prime_2)
      let x2n_2 = dest_realintconst(x2_prime_2)
      let y2n_2 = dest_realintconst(y2_prime_2)
      let x3n_2 = ((x1n_2 * y2n_2) + (x2n_2 * y1n_2))
      let y3n_2 = (y1n_2 * y2n_2)
      let d = gcd_num(x3n_2)(y3n_2)
      let x3n_prime_2 = quo_num(x3n_2)(d)
      let y3n_prime_2 = quo_num(y3n_2)(d)
      let [x3n_prime_prime, y3n_prime_prime] = (if (y3n_prime_2 > 0) | [x3n_prime_2, y3n_prime_2] | [minus_num(x3n_prime_2), minus_num(y3n_prime_2)])
      let x3_prime_2 = mk_realintconst(x3n_prime_prime)
      let y3_prime_2 = mk_realintconst(y3n_prime_prime)
      let th0:
        INST(
          PairList [
            [x1_prime_2, x1_5],
            [y1_prime_2, y1_5],
            [x2_prime_2, x2_5],
            [y2_prime_2, y2_5],
            [x3_prime_2, x3_2],
            [y3_prime_2, y3_2]
          ]
        )(pth_6)
      let th1 = funpow(3)(MP_CONV(REAL_INT_LT_CONV))(th0)
      let [tm2, tm3] = Fusion.dest_eq(fst(dest_imp(concl(th1))))
      let th2_2:
        (
          LAND_CONV((BINOP_CONV(REAL_INT_MUL_CONV) then_conv REAL_INT_ADD_CONV)) then_conv \
          REAL_INT_MUL_CONV
        )(tm2)
      let th3_2 = (RAND_CONV(REAL_INT_MUL_CONV) then_conv REAL_INT_MUL_CONV)(tm3)
      MP(th1)(TRANS(th2_2)(SYM(th3_2)))
  (
    (BINOP_CONV(REAL_INT_RAT_CONV) then_conv RAW_REAL_RAT_ADD_CONV) then_conv \
    TRY_CONV(GEN_REWRITE_CONV(I)(PairList [REAL_DIV_1]))
  )

def REAL_RAT_SUB_CONV:
  let pth:
    prove(
      [
        (hol:
           var x :: real
           var y :: real
           x - y == x + -y),
        REWRITE_TAC(PairList [real_sub])
      ]
    )
  (
    (GEN_REWRITE_CONV(I)(PairList [pth]) then_conv RAND_CONV(REAL_RAT_NEG_CONV)) then_conv \
    REAL_RAT_ADD_CONV
  )

def REAL_RAT_MUL_CONV:
  let pth_nocancel_2:
    prove(
      [
        (hol:
           var x1 :: real
           var y1 :: real
           var x2 :: real
           var y2 :: real
           x1 / y1 * (x2 / y2) == x1 * x2 / (y1 * y2)),
        REWRITE_TAC(PairList [real_div, REAL_INV_MUL, REAL_MUL_AC])
      ]
    )
  let pth_cancel_2:
    prove(
      [
        (hol:
           var d1 :: real
           var d2 :: real
           var u1 :: real
           var x1 :: real
           var u2 :: real
           var x2 :: real
           var v1 :: real
           var y1 :: real
           var v2 :: real
           var y2 :: real
           (d1 != (0 :: real)
              && (d2 != (0 :: real)
                    && (d1 * u1 == x1 && (d2 * u2 == x2 && (d2 * v1 == y1 && d1 * v2 == y2)))))
             ==> x1 / y1 * (x2 / y2) == u1 * u2 / (v1 * v2)),
        (
          (
            (
              (
                (
                  DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC)) then_tac \
                  DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC))
                ) then_tac \
                DISCH_THEN(REPEAT_TCL(CONJUNCTS_THEN)(o(SUBST1_TAC)(SYM)))
              ) then_tac \
              ASM_REWRITE_TAC(PairList [real_div, REAL_INV_MUL])
            ) then_tac \
            ONCE_REWRITE_TAC(
              PairList [
                AC(REAL_MUL_AC)(
                  (hol:
                     var d1 :: real
                     var u1 :: real
                     var id2 :: real
                     var iv1 :: real
                     var d2 :: real
                     var u2 :: real
                     var id1 :: real
                     var iv2 :: real
                     d1 * u1 * (id2 * iv1) * (d2 * u2 * (id1 * iv2))
                       == u1 * u2 * (iv1 * iv2 * (id2 * d2 * (id1 * d1))))
                )
              ]
            )
          ) then_tac \
          ASM_SIMP_TAC(PairList [REAL_MUL_LINV, REAL_MUL_RID])
        )
      ]
    )
  let dest_divop_3 = dest_binop(hol: const real_div :: real -> real -> real; real_div)
  let dest_mulop_2 = dest_binop(hol: const real_mul :: real -> real -> real; real_mul)
  let x1_6 = hol: var x1 :: real; x1
  let x2_6 = hol: var x2 :: real; x2
  let y1_6 = hol: var y1 :: real; y1
  let y2_6 = hol: var y2 :: real; y2
  let u1_2 = hol: var u1 :: real; u1
  let u2_2 = hol: var u2 :: real; u2
  let v1_2 = hol: var v1 :: real; v1
  let v2_2 = hol: var v2 :: real; v2
  let d1_2 = hol: var d1 :: real; d1
  let d2_2 = hol: var d2 :: real; d2
  let RAW_REAL_RAT_MUL_CONV:
    fun(tm):
      let [r1, r2] = dest_mulop_2(tm)
      let [x1_prime_3, y1_prime_3] = dest_divop_3(r1)
      let [x2_prime_3, y2_prime_3] = dest_divop_3(r2)
      let x1n_3 = dest_realintconst(x1_prime_3)
      let y1n_3 = dest_realintconst(y1_prime_3)
      let x2n_3 = dest_realintconst(x2_prime_3)
      let y2n_3 = dest_realintconst(y2_prime_3)
      let d1n_2 = gcd_num(x1n_3)(y2n_3)
      let d2n_2 = gcd_num(x2n_3)(y1n_3)
      if ((d1n_2 == num_1) && (d2n_2 == num_1))
      | let th0 = INST(PairList [[x1_prime_3, x1_6], [y1_prime_3, y1_6], [x2_prime_3, x2_6], [y2_prime_3, y2_6]])(pth_nocancel_2)
        let th1 = BINOP_CONV(REAL_INT_MUL_CONV)(rand(concl(th0)))
        TRANS(th0)(th1)
      | let u1n_2 = quo_num(x1n_3)(d1n_2)
        let u2n_2 = quo_num(x2n_3)(d2n_2)
        let v1n_2 = quo_num(y1n_3)(d2n_2)
        let v2n_2 = quo_num(y2n_3)(d1n_2)
        let u1_prime_2 = mk_realintconst(u1n_2)
        let u2_prime_2 = mk_realintconst(u2n_2)
        let v1_prime_2 = mk_realintconst(v1n_2)
        let v2_prime_2 = mk_realintconst(v2n_2)
        let d1_prime_2 = mk_realintconst(d1n_2)
        let d2_prime_2 = mk_realintconst(d2n_2)
        let th0:
          INST(
            PairList [
              [x1_prime_3, x1_6],
              [y1_prime_3, y1_6],
              [x2_prime_3, x2_6],
              [y2_prime_3, y2_6],
              [u1_prime_2, u1_2],
              [v1_prime_2, v1_2],
              [u2_prime_2, u2_2],
              [v2_prime_2, v2_2],
              [d1_prime_2, d1_2],
              [d2_prime_2, d2_2]
            ]
          )(pth_cancel_2)
        let th1 = EQT_ELIM(REAL_INT_REDUCE_CONV(lhand(concl(th0))))
        let th2 = MP(th0)(th1)
        let th3 = BINOP_CONV(REAL_INT_MUL_CONV)(rand(concl(th2)))
        TRANS(th2)(th3)
  (
    (BINOP_CONV(REAL_INT_RAT_CONV) then_conv RAW_REAL_RAT_MUL_CONV) then_conv \
    TRY_CONV(GEN_REWRITE_CONV(I)(PairList [REAL_DIV_1]))
  )

def REAL_RAT_DIV_CONV:
  let pth:
    prove(
      [
        (hol:
           var x :: real
           var y :: real
           const real_inv :: real -> real
           x / y == x * real_inv(y)),
        REWRITE_TAC(PairList [real_div])
      ]
    )
  (
    (GEN_REWRITE_CONV(I)(PairList [pth]) then_conv RAND_CONV(REAL_RAT_INV_CONV)) then_conv \
    REAL_RAT_MUL_CONV
  )

def REAL_RAT_POW_CONV:
  let pth:
    prove(
      [
        (hol:
           var x :: real
           var y :: real
           var n :: num
           const real_pow :: real -> num -> real
           real_pow(x / y, n) == real_pow(x, n) / real_pow(y, n)),
        REWRITE_TAC(PairList [REAL_POW_DIV])
      ]
    )
  (
    REAL_INT_POW_CONV or_conv \
    (
      (LAND_CONV(REAL_INT_RAT_CONV) then_conv GEN_REWRITE_CONV(I)(PairList [pth])) then_conv \
      BINOP_CONV(REAL_INT_POW_CONV)
    )
  )

def REAL_RAT_MAX_CONV:
  (
    (
      REWR_CONV(real_max) then_conv \
      RATOR_CONV(RATOR_CONV(RAND_CONV(REAL_RAT_LE_CONV)))
    ) then_conv \
    GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES])
  )

def REAL_RAT_MIN_CONV:
  (
    (
      REWR_CONV(real_min) then_conv \
      RATOR_CONV(RATOR_CONV(RAND_CONV(REAL_RAT_LE_CONV)))
    ) then_conv \
    GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES])
  )

def real_rat_red_conv_list:
  PairList [
    [
      (hol:
         var x :: real
         var y :: real
         x <= y),
      REAL_RAT_LE_CONV
    ],
    [
      (hol:
         var x :: real
         var y :: real
         x < y),
      REAL_RAT_LT_CONV
    ],
    [
      (hol:
         var x :: real
         var y :: real
         x >= y),
      REAL_RAT_GE_CONV
    ],
    [
      (hol:
         var x :: real
         var y :: real
         x > y),
      REAL_RAT_GT_CONV
    ],
    [(hol:
        var x :: real
        var y :: real
        x == y), REAL_RAT_EQ_CONV],
    [
      (hol:
         var x :: real
         -x),
      CHANGED_CONV(REAL_RAT_NEG_CONV)
    ],
    [(hol:
        var x :: real
        const real_sgn :: real -> real
        real_sgn(x)), REAL_RAT_SGN_CONV],
    [(hol:
        var x :: real
        const real_abs :: real -> real
        real_abs(x)), REAL_RAT_ABS_CONV],
    [(hol:
        var x :: real
        const real_inv :: real -> real
        real_inv(x)), REAL_RAT_INV_CONV],
    [
      (hol:
         var x :: real
         var y :: real
         x + y),
      REAL_RAT_ADD_CONV
    ],
    [
      (hol:
         var x :: real
         var y :: real
         x - y),
      REAL_RAT_SUB_CONV
    ],
    [
      (hol:
         var x :: real
         var y :: real
         x * y),
      REAL_RAT_MUL_CONV
    ],
    [
      (hol:
         var x :: real
         var y :: real
         x / y),
      CHANGED_CONV(REAL_RAT_DIV_CONV)
    ],
    [
      (hol:
         var x :: real
         var n :: num
         const real_pow :: real -> num -> real
         real_pow(x, n)),
      REAL_RAT_POW_CONV
    ],
    [
      (hol:
         var x :: real
         var y :: real
         const real_max :: real -> real -> real
         real_max(x, y)),
      REAL_RAT_MAX_CONV
    ],
    [
      (hol:
         var x :: real
         var y :: real
         const real_min :: real -> real -> real
         real_min(x, y)),
      REAL_RAT_MIN_CONV
    ]
  ]

def REAL_RAT_RED_CONV:
  let gconv_net = itlist(uncurry(net_of_conv))(real_rat_red_conv_list)(basic_net(#void))
  REWRITES_CONV(gconv_net)

def REAL_RAT_REDUCE_CONV = DEPTH_CONV(REAL_RAT_RED_CONV)

def real_rat_compute_add_convs:
  let convlist:
    map(
      fun([pat, the_conv]):
        let [c, args] = strip_comb(pat)
        [c, length(args), the_conv]
    )(real_rat_red_conv_list)
  (fun(compset): itlist(fun(newc): fun(_): Compute.Compute.add_conv(newc)(compset))(convlist)(#void))

def REAL_RAT_COMPUTE_CONV:
  let cs = Compute.Compute.bool_compset(#void)
  Compute.Compute.set_skip(cs)(hol: const COND :: bool -> A -> A -> A; COND)(Some(1))
  real_rat_compute_add_convs(cs)
  Compute.Compute.WEAK_CBV_CONV(cs)

def [calc_rat_REAL_POLY_NEG_CONV_v2, calc_rat_REAL_POLY_ADD_CONV_v2, calc_rat_REAL_POLY_SUB_CONV_v2, calc_rat_REAL_POLY_MUL_CONV_v2, calc_rat_REAL_POLY_POW_CONV_v2, calc_rat_REAL_POLY_CONV] = SEMIRING_NORMALIZERS_CONV(REAL_POLY_CLAUSES)(REAL_POLY_NEG_CLAUSES)([is_ratconst, REAL_RAT_ADD_CONV, REAL_RAT_MUL_CONV, REAL_RAT_POW_CONV])(fun (x): fun (y): x < y)

def calc_rat_REAL_POLY_CONV_v2:
  let neg_tm_2 = hol: const real_neg :: real -> real; real_neg
  let inv_tm_2 = hol: const real_inv :: real -> real; real_inv
  let add_tm_2 = hol: const real_add :: real -> real -> real; real_add
  let sub_tm_2 = hol: const real_sub :: real -> real -> real; real_sub
  let mul_tm_2 = hol: const real_mul :: real -> real -> real; real_mul
  let div_tm_2 = hol: const real_div :: real -> real -> real; real_div
  let pow_tm_2 = hol: const real_pow :: real -> num -> real; real_pow
  let abs_tm_2 = hol: const real_abs :: real -> real; real_abs
  let max_tm_2 = hol: const real_max :: real -> real -> real; real_max
  let min_tm_2 = hol: const real_min :: real -> real -> real; real_min
  let div_conv_2 = REWR_CONV(real_div)
  fun REAL_POLY_CONV(tm):
    if (!is_comb(tm) || is_ratconst(tm))
    | REFL(tm)
    | let [lop, r] = dest_comb(tm)
      if (lop == neg_tm_2)
      | let th1 = AP_TERM(lop)(REAL_POLY_CONV(r))
        TRANS(th1)(calc_rat_REAL_POLY_NEG_CONV_v2(rand(concl(th1))))
      | if (lop == inv_tm_2)
        | let th1 = AP_TERM(lop)(REAL_POLY_CONV(r))
          TRANS(th1)(TRY_CONV(REAL_RAT_INV_CONV)(rand(concl(th1))))
        | if (lop == abs_tm_2)
          | AP_TERM(lop)(REAL_POLY_CONV(r))
          | if !is_comb(lop)
            | REFL(tm)
            | let [op, l] = dest_comb(lop)
              if (op == pow_tm_2)
              | let th1 = AP_THM(AP_TERM(op)(REAL_POLY_CONV(l)))(r)
                TRANS(th1)(TRY_CONV(calc_rat_REAL_POLY_POW_CONV_v2)(rand(concl(th1))))
              | if ((op == add_tm_2) || ((op == mul_tm_2) || (op == sub_tm_2)))
                | let th1 = MK_COMB([AP_TERM(op)(REAL_POLY_CONV(l)), REAL_POLY_CONV(r)])
                  let fn:
                    if (op == add_tm_2)
                    | calc_rat_REAL_POLY_ADD_CONV_v2
                    | (if (op == mul_tm_2) | calc_rat_REAL_POLY_MUL_CONV_v2 | calc_rat_REAL_POLY_SUB_CONV_v2)
                  TRANS(th1)(fn(rand(concl(th1))))
                | if (op == div_tm_2)
                  | let th1 = div_conv_2(tm)
                    TRANS(th1)(REAL_POLY_CONV(rand(concl(th1))))
                  | (if ((op == min_tm_2) || (op == max_tm_2)) | MK_COMB([AP_TERM(op)(REAL_POLY_CONV(l)), REAL_POLY_CONV(r)]) | REFL(tm))
  REAL_POLY_CONV

def [calc_rat_REAL_RING_v2, real_ideal_cofactors]:
  let REAL_INTEGRAL_2:
    prove(
      [
        (hol:
           (forall x :: real: (0 :: real) * x == (0 :: real))
             && ((forall (x :: real, y :: real, z :: real): x + y == x + z <=> y == z)
                   && (forall (w :: real, x :: real, y :: real, z :: real):
                         w * y + x * z == w * z + x * y <=> w == x || y == z))),
        (
          (
            (
              (
                REWRITE_TAC(PairList [MULT_CLAUSES, EQ_ADD_LCANCEL]) then_tac \
                REWRITE_TAC(
                  PairList [
                    GSYM(REAL_OF_NUM_EQ),
                    GSYM(REAL_OF_NUM_ADD),
                    GSYM(REAL_OF_NUM_MUL)
                  ]
                )
              ) then_tac \
              ONCE_REWRITE_TAC(PairList [GSYM(REAL_SUB_0)])
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(REAL_ENTIRE)])
          ) then_tac \
          Real.REAL_ARITH_TAC
        )
      ]
    )
  let REAL_RABINOWITSCH_2:
    prove(
      [
        (hol:
           forall (x :: real, y :: real): x != y <=> (exists z :: real: (x - y) * z == (1 :: real))),
        (
          (
            REPEAT(GEN_TAC) then_tac \
            GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [GSYM(REAL_SUB_0)])
          ) then_tac \
          MESON_TAC(
            PairList [
              REAL_MUL_RINV,
              REAL_MUL_LZERO,
              Realarith.REAL_ARITH(
                (hol:
                   (1 :: real) != (0 :: real))
              )
            ]
          )
        )
      ]
    )
  let init_2 = GEN_REWRITE_CONV(ONCE_DEPTH_CONV)(PairList [DECIMAL])
  let real_ty_2 = hol_type: real
  let [pure, ideal]:
    RING_AND_IDEAL_CONV(
      [
        rat_of_term,
        term_of_rat,
        REAL_RAT_EQ_CONV,
        (hol: const real_neg :: real -> real; real_neg),
        (hol: const real_add :: real -> real -> real; real_add),
        (hol: const real_sub :: real -> real -> real; real_sub),
        (hol: const real_inv :: real -> real; real_inv),
        (hol: const real_mul :: real -> real -> real; real_mul),
        (hol: const real_div :: real -> real -> real; real_div),
        (hol: const real_pow :: real -> num -> real; real_pow),
        REAL_INTEGRAL_2,
        REAL_RABINOWITSCH_2,
        calc_rat_REAL_POLY_CONV_v2
      ]
    )
  [
    fun(tm):
      let th = init_2(tm)
      EQ_MP(SYM(th))(pure(rand(concl(th)))),
    fun(tms): fun(tm): (if forall((fun(t): (type_of(t) == real_ty_2)))(PairList [tm, & tms]) | ideal(tms)(tm) | failwith("real_ideal_cofactors: not all terms have type :real"))
  ]

def REAL_IDEAL_CONV:
  let mk_add_2 = mk_binop(hol: const real_add :: real -> real -> real; real_add)
  let mk_mul_2 = mk_binop(hol: const real_mul :: real -> real -> real; real_mul)
  fun(tms):
    fun(tm):
      let cfs = real_ideal_cofactors(tms)(tm)
      let tm_prime = end_itlist(mk_add_2)(map2(mk_mul_2)(cfs)(tms))
      let th_2 = calc_rat_REAL_POLY_CONV_v2(tm)
      let th_prime_2 = calc_rat_REAL_POLY_CONV_v2(tm_prime)
      TRANS(th_2)(SYM(th_prime_2))

fun GEN_REAL_ARITH(PROVER):
  Realarith.GEN_REAL_ARITH(
    [
      term_of_rat,
      REAL_RAT_EQ_CONV,
      REAL_RAT_GE_CONV,
      REAL_RAT_GT_CONV,
      calc_rat_REAL_POLY_CONV_v2,
      calc_rat_REAL_POLY_NEG_CONV_v2,
      calc_rat_REAL_POLY_ADD_CONV_v2,
      calc_rat_REAL_POLY_MUL_CONV_v2,
      PROVER
    ]
  )

def REAL_ARITH:
  let init_3 = GEN_REWRITE_CONV(ONCE_DEPTH_CONV)(PairList [DECIMAL])
  let pure_2 = GEN_REAL_ARITH(REAL_LINEAR_PROVER)
  fun(tm):
    try:
      let th = init_3(tm)
      EQ_MP(SYM(th))(pure_2(rand(concl(th))))
      ~catch exn:
        match exn
        | Failure(m):
            failwith(
              ("REAL_ARITH `" +& (Host.string_of_term(tm) +& ("`: " +& m)))
            )
        | exn: (throw exn)

def REAL_ARITH_TAC = CONV_TAC(REAL_ARITH)

def ASM_REAL_ARITH_TAC:
  (
    REPEAT(
      FIRST_X_ASSUM(o(MP_TAC)(check(o(o((fun (x): !x))(is_forall))(concl))))
    ) then_tac \
    REAL_ARITH_TAC
  )

def REAL_LE_TRANS_LE:
  prove(
    [
      (hol:
         forall (x :: real, y :: real): x <= y <=> (forall z :: real: y <= z ==> x <= z)),
      MESON_TAC(PairList [REAL_LE_TRANS, REAL_LE_REFL])
    ]
  )

def REAL_LE_TRANS_LTE:
  prove(
    [
      (hol:
         forall (x :: real, y :: real): x <= y <=> (forall z :: real: y < z ==> x <= z)),
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
            PairList [REAL_ARITH_TAC, ALL_TAC]
          ) then_tac \
          DISCH_THEN(
            o(MP_TAC)(
              SPEC(
                (hol:
                   var y :: real
                   var x :: real
                   y + (x - y) / (2 :: real))
              )
            )
          )
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def REAL_LE_TRANS_LT:
  prove(
    [
      (hol:
         forall (x :: real, y :: real): x <= y <=> (forall z :: real: y < z ==> x < z)),
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
            PairList [REAL_ARITH_TAC, ALL_TAC]
          ) then_tac \
          DISCH_THEN(
            o(MP_TAC)(
              SPEC(
                (hol:
                   var y :: real
                   var x :: real
                   y + (x - y) / (2 :: real))
              )
            )
          )
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def REAL_FIELD:
  let norm_net_2:
    itlist(o(net_of_thm(#false))(SPEC_ALL))(
      PairList [
        FORALL_SIMP,
        EXISTS_SIMP,
        real_div,
        REAL_INV_INV,
        REAL_INV_MUL,
        REAL_POW_ADD
      ]
    )(
      net_of_conv(
        (hol:
           var x :: real
           var n :: num
           const real_inv :: real -> real
           const real_pow :: real -> num -> real
           real_inv(real_pow(x, n)))
      )(
        o(REWR_CONV(GSYM(REAL_POW_INV)))(check(o(o(is_numeral)(rand))(rand)))
      )(empty_net)
    )
  let easy_nz_conv_2:
    (
      LAND_CONV(
        GEN_REWRITE_CONV(TRY_CONV)(
          PairList [
            MESON(
              PairList [REAL_POW_EQ_0, REAL_OF_NUM_EQ])(
              (hol:
                 var x :: real
                 var n :: num
                 const real_pow :: real -> num -> real
                 const real_of_num :: num -> real
                 real_pow(x, n) != (0 :: real)
                   <=> x != (0 :: real) || (real_of_num(n) == (0 :: real) || real_pow(x, n) != (0 :: real)))
            )
          ]
        )
      ) then_conv \
      TRY_CONV(
        (
          LAND_CONV(REAL_RAT_REDUCE_CONV) then_conv \
          GEN_REWRITE_CONV(I)(PairList [TAUT(hol:
                                               var p :: bool
                                               #true ==> p <=> p)])
        )
      )
    )
  let prenex_conv_2:
    (
      (
        (
          (
            (
              (TOP_DEPTH_CONV(BETA_CONV) then_conv NUM_REDUCE_CONV) then_conv \
              TOP_DEPTH_CONV(REWRITES_CONV(norm_net_2))
            ) then_conv \
            NNFC_CONV
          ) then_conv \
          DEPTH_BINOP_CONV(hol: const #{|/\|} :: bool -> bool -> bool; const.#{|/\|})(CONDS_CELIM_CONV)
        ) then_conv \
        PRENEX_CONV
      ) then_conv \
      ONCE_REWRITE_CONV(
        PairList [
          REAL_ARITH(
            (hol:
               var x :: real
               var y :: real
               x < y <=> x < y && x != y)
          )
        ]
      )
    )
  let setup_conv_2 = ((NNF_CONV then_conv WEAK_CNF_CONV) then_conv CONJ_CANON_CONV)
  let core_rule_2:
    fun(t):
      try:
        calc_rat_REAL_RING_v2(t)
        ~catch exn:
          match exn
          | Failure(_): REAL_ARITH(t)
          | exn: (throw exn)
  let inv_tm_3 = hol: const real_inv :: real -> real; real_inv
  let is_div_2 = is_binop(hol: const real_div :: real -> real -> real; real_div)
  let is_inv_2 = (fun(tm): ((is_div_2(tm) || (is_comb(tm) && (rator(tm) == inv_tm_3))) && !is_ratconst(rand(tm))))
  let BASIC_REAL_FIELD:
    fun(tm):
      let is_freeinv = (fun(t): (is_inv_2(t) && free_in(t)(tm)))
      let itms = setify(map(rand)(find_terms(is_freeinv)(tm)))
      let hyps = map((fun(t): CONV_RULE(easy_nz_conv_2)(SPEC(t)(REAL_MUL_RINV))))(itms)
      let tm_prime = itlist(fun(th): fun(t): mk_imp([concl(th), t]))(hyps)(tm)
      let th1 = setup_conv_2(tm_prime)
      let cjs = conjuncts(rand(concl(th1)))
      let ths = map(core_rule_2)(cjs)
      let th2 = EQ_MP(SYM(th1))(end_itlist(CONJ)(ths))
      rev_itlist(C(MP))(hyps)(th2)
  fun(tm):
    let th0 = prenex_conv_2(tm)
    let tm0 = rand(concl(th0))
    let [avs, bod] = strip_forall(tm0)
    let th1 = setup_conv_2(bod)
    let ths = map(BASIC_REAL_FIELD)(conjuncts(rand(concl(th1))))
    EQ_MP(SYM(th0))(GENL(avs)(EQ_MP(SYM(th1))(end_itlist(CONJ)(ths))))

def REAL_SHRINK_RANGE:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         forall x :: real: real_abs(x / ((1 :: real) + real_abs(x))) < (1 :: real)),
      (
        (
          (
            GEN_TAC then_tac \
            REWRITE_TAC(
              PairList [
                REAL_ABS_DIV,
                REAL_ARITH(
                  (hol:
                     var x :: real
                     const real_abs :: real -> real
                     real_abs((1 :: real) + real_abs(x)) == (1 :: real) + real_abs(x))
                )
              ]
            )
          ) then_tac \
          SIMP_TAC(
            PairList [
              REAL_LT_LDIV_EQ,
              REAL_ARITH(
                (hol:
                   var x :: real
                   const real_abs :: real -> real
                   (0 :: real) < (1 :: real) + real_abs(x))
              )
            ]
          )
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def REAL_SHRINK_LT:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         forall (x :: real, y :: real):
           x / ((1 :: real) + real_abs(x)) < y / ((1 :: real) + real_abs(y)) <=> x < y),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(GEN_TAC) then_tac \
                          MATCH_MP_TAC(
                            REAL_ARITH(
                              (hol:
                                 var #{|x'|} :: real
                                 var x :: real
                                 var #{|y'|} :: real
                                 var y :: real
                                 const real_abs :: real -> real
                                 (((0 :: real) < var.#{|x'|} <=> (0 :: real) < x)
                                    && (((0 :: real) < var.#{|y'|} <=> (0 :: real) < y)
                                          && ((real_abs(var.#{|x'|}) < real_abs(var.#{|y'|}) <=> real_abs(x) < real_abs(y))
                                                && (real_abs(var.#{|y'|}) < real_abs(var.#{|x'|}) <=> real_abs(y) < real_abs(x)))))
                                   ==> (var.#{|x'|} < var.#{|y'|} <=> x < y))
                            )
                          )
                        ) then_tac \
                        SIMP_TAC(
                          PairList [
                            REAL_LT_RDIV_EQ,
                            REAL_ARITH(
                              (hol:
                                 var x :: real
                                 const real_abs :: real -> real
                                 (0 :: real) < (1 :: real) + real_abs(x))
                            ),
                            REAL_MUL_LZERO
                          ]
                        )
                      ) then_tac \
                      MAP_EVERY((fun(t): SPEC_TAC([t, t])))(PairList [(hol: var y :: real; y), (hol: var x :: real; x)])
                    ) then_tac \
                    REWRITE_TAC(
                      PairList [
                        MESON(
                          PairList [])(
                          (hol:
                             var P :: #{?65469} -> #{?65469} -> bool
                             (forall (x :: #{?65469}, y :: #{?65469}): P(x, y) && P(y, x))
                               <=> (forall (x :: #{?65469}, y :: #{?65469}): P(x, y)))
                        )
                      ]
                    )
                  ) then_tac \
                  REPEAT(GEN_TAC)
                ) then_tac \
                REWRITE_TAC(
                  PairList [
                    REAL_ABS_DIV,
                    REAL_ARITH(
                      (hol:
                         var x :: real
                         const real_abs :: real -> real
                         real_abs((1 :: real) + real_abs(x)) == (1 :: real) + real_abs(x))
                    )
                  ]
                )
              ) then_tac \
              SIMP_TAC(
                PairList [
                  REAL_LT_RDIV_EQ,
                  REAL_ARITH(
                    (hol:
                       var x :: real
                       const real_abs :: real -> real
                       (0 :: real) < (1 :: real) + real_abs(x))
                  )
                ]
              )
            ) then_tac \
            ONCE_REWRITE_TAC(
              PairList [
                REAL_ARITH(
                  (hol:
                     var a :: real
                     var b :: real
                     var c :: real
                     a / b * c == a * c / b)
                )
              ]
            )
          ) then_tac \
          SIMP_TAC(
            PairList [
              REAL_LT_LDIV_EQ,
              REAL_ARITH(
                (hol:
                   var x :: real
                   const real_abs :: real -> real
                   (0 :: real) < (1 :: real) + real_abs(x))
              )
            ]
          )
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def REAL_SHRINK_LE:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         forall (x :: real, y :: real):
           x / ((1 :: real) + real_abs(x)) <= y / ((1 :: real) + real_abs(y)) <=> x <= y),
      REWRITE_TAC(PairList [GSYM(REAL_NOT_LT), REAL_SHRINK_LT])
    ]
  )

def REAL_SHRINK_EQ:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         forall (x :: real, y :: real):
           x / ((1 :: real) + real_abs(x)) == y / ((1 :: real) + real_abs(y)) <=> x == y),
      REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM), REAL_SHRINK_LE])
    ]
  )

def REAL_SHRINK_GALOIS:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         forall (x :: real, y :: real):
           x / ((1 :: real) + real_abs(x)) == y
             <=> real_abs(y) < (1 :: real) && y / ((1 :: real) - real_abs(y)) == x),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      ((REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac STRIP_TAC) then_tac \
                      FIRST_X_ASSUM(o(SUBST1_TAC)(SYM))
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [REAL_SHRINK_RANGE])
                  ) then_tac \
                  ASM_SIMP_TAC(
                    PairList [
                      REAL_ABS_DIV,
                      REAL_ARITH(
                        (hol:
                           var x :: real
                           const real_abs :: real -> real
                           real_abs((1 :: real) + real_abs(x)) == (1 :: real) + real_abs(x))
                      ),
                      REAL_ARITH(
                        (hol:
                           var y :: real
                           const real_abs :: real -> real
                           real_abs(y) < (1 :: real) ==> real_abs((1 :: real) - real_abs(y)) == (1 :: real) - real_abs(y))
                      )
                    ]
                  )
                ) then_tac \
                MATCH_MP_TAC(
                  REAL_ARITH(
                    (hol:
                       var x :: real
                       var y :: real
                       var z :: real
                       const real_inv :: real -> real
                       x * (real_inv(y) * real_inv(z)) == x * (1 :: real) ==> x / y / z == x)
                  )
                )
              ) then_tac \
              AP_TERM_TAC
            ) then_tac \
            MATCH_MP_TAC(
              REAL_FIELD(
                (hol:
                   var x :: real
                   var y :: real
                   const real_inv :: real -> real
                   x * y == (1 :: real) ==> real_inv(x) * real_inv(y) == (1 :: real))
              )
            )
          ) then_tac \
          REPEAT(POP_ASSUM(MP_TAC))
        ) then_tac \
        CONV_TAC(REAL_FIELD)
      )
    ]
  )

def REAL_GROW_SHRINK:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         forall x :: real:
           (x
              / ((1 :: real) + real_abs(x))
              / ((1 :: real) - real_abs(x / ((1 :: real) + real_abs(x)))))
             == x),
      MESON_TAC(PairList [REAL_SHRINK_GALOIS, REAL_SHRINK_RANGE])
    ]
  )

def REAL_SHRINK_GROW_EQ:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         forall x :: real:
           ((x
               / ((1 :: real) - real_abs(x))
               / ((1 :: real) + real_abs(x / ((1 :: real) - real_abs(x)))))
              == x)
             <=> real_abs(x) < (1 :: real)),
      MESON_TAC(PairList [REAL_SHRINK_GALOIS, REAL_SHRINK_RANGE])
    ]
  )

def REAL_SHRINK_GROW:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         forall x :: real:
           real_abs(x) < (1 :: real)
             ==> ((x
                     / ((1 :: real) - real_abs(x))
                     / ((1 :: real) + real_abs(x / ((1 :: real) - real_abs(x)))))
                    == x)),
      REWRITE_TAC(PairList [REAL_SHRINK_GROW_EQ])
    ]
  )

def REAL_POLY_NEG_CONV = calc_rat_REAL_POLY_NEG_CONV_v2

def REAL_POLY_ADD_CONV = calc_rat_REAL_POLY_ADD_CONV_v2

def REAL_POLY_SUB_CONV = calc_rat_REAL_POLY_SUB_CONV_v2

def REAL_POLY_MUL_CONV = calc_rat_REAL_POLY_MUL_CONV_v2

def REAL_POLY_POW_CONV = calc_rat_REAL_POLY_POW_CONV_v2

def REAL_POLY_CONV = calc_rat_REAL_POLY_CONV_v2

def REAL_RING = calc_rat_REAL_RING_v2
