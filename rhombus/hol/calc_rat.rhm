def REAL_FIELD:
  let norm_net_2:
    itlist(o(net_of_thm(#false))(SPEC_ALL))(
      PairList [
        FORALL_SIMP,
        EXISTS_SIMP,
        real_div,
        REAL_INV_INV,
        REAL_INV_MUL,
        REAL_POW_ADD
      ]
    )(
      net_of_conv(
        hol_term(App(
          Const("real_inv", Fun(Real, Real)),
          [App(Const("real_pow", Fun(Real, Fun(Num, Real))), [Var("x", Real), Var("n", Num)])]
        ))
      )(
        o(REWR_CONV(GSYM(REAL_POW_INV)))(check(o(o(is_numeral)(rand))(rand)))
      )(empty_net)
    )
  let easy_nz_conv_2:
    (
      LAND_CONV(
        GEN_REWRITE_CONV(TRY_CONV)(
          PairList [
            MESON(
              PairList [REAL_POW_EQ_0, REAL_OF_NUM_EQ])(
              hol_term(Iff(
                Not(
                  Eq(
                    Real,
                    App(Const("real_pow", Fun(Real, Fun(Num, Real))), [Var("x", Real), Var("n", Num)]),
                    App(
                      Const("real_of_num", Fun(Num, Real)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                    )
                  )
                ),
                Or(
                  Not(
                    Eq(
                      Real,
                      Var("x", Real),
                      App(
                        Const("real_of_num", Fun(Num, Real)),
                        [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                      )
                    )
                  ),
                  Or(
                    Eq(
                      Real,
                      App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)]),
                      App(
                        Const("real_of_num", Fun(Num, Real)),
                        [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                      )
                    ),
                    Not(
                      Eq(
                        Real,
                        App(Const("real_pow", Fun(Real, Fun(Num, Real))), [Var("x", Real), Var("n", Num)]),
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                        )
                      )
                    )
                  )
                )
              ))
            )
          ]
        )
      ) then_conv \
      TRY_CONV(
        (
          LAND_CONV(REAL_RAT_REDUCE_CONV) then_conv \
          GEN_REWRITE_CONV(I)(PairList [TAUT(hol_term(Iff(Implies(True, Var("p", Bool)), Var("p", Bool))))])
        )
      )
    )
  let prenex_conv_2:
    (
      (
        (
          (
            (
              (TOP_DEPTH_CONV(BETA_CONV) then_conv NUM_REDUCE_CONV) then_conv \
              TOP_DEPTH_CONV(REWRITES_CONV(norm_net_2))
            ) then_conv \
            NNFC_CONV
          ) then_conv \
          DEPTH_BINOP_CONV(hol_term(Const("/\\", Fun(Bool, Fun(Bool, Bool)))))(CONDS_CELIM_CONV)
        ) then_conv \
        PRENEX_CONV
      ) then_conv \
      ONCE_REWRITE_CONV(
        PairList [
          REAL_ARITH(
            hol_term(Iff(
              App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)]),
              And(
                App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)]),
                Not(Eq(Real, Var("x", Real), Var("y", Real)))
              )
            ))
          )
        ]
      )
    )
  let setup_conv_2 = ((NNF_CONV then_conv WEAK_CNF_CONV) then_conv CONJ_CANON_CONV)
  let core_rule_2:
    fun(t):
      try:
        calc_rat_REAL_RING_v2(t)
        ~catch exn:
          match exn
          | Failure(_): REAL_ARITH(t)
          | exn: (throw exn)
  let inv_tm_3 = hol_term(Const("real_inv", Fun(Real, Real)))
  let is_div_2 = is_binop(hol_term(Const("real_div", Fun(Real, Fun(Real, Real)))))
  let is_inv_2 = (fun(tm): ((is_div_2(tm) || (is_comb(tm) && (rator(tm) == inv_tm_3))) && !is_ratconst(rand(tm))))
  let BASIC_REAL_FIELD:
    fun(tm):
      let is_freeinv = (fun(t): (is_inv_2(t) && free_in(t)(tm)))
      let itms = setify(map(rand)(find_terms(is_freeinv)(tm)))
      let hyps = map((fun(t): CONV_RULE(easy_nz_conv_2)(SPEC(t)(REAL_MUL_RINV))))(itms)
      let tm_prime = itlist(fun(th): fun(t): mk_imp([concl(th), t]))(hyps)(tm)
      let th1 = setup_conv_2(tm_prime)
      let cjs = conjuncts(rand(concl(th1)))
      let ths = map(core_rule_2)(cjs)
      let th2 = EQ_MP(SYM(th1))(end_itlist(CONJ)(ths))
      rev_itlist(C(MP))(hyps)(th2)
  fun(tm):
    let th0 = prenex_conv_2(tm)
    let tm0 = rand(concl(th0))
    let [avs, bod] = strip_forall(tm0)
    let th1 = setup_conv_2(bod)
    let ths = map(BASIC_REAL_FIELD)(conjuncts(rand(concl(th1))))
    EQ_MP(SYM(th0))(GENL(avs)(EQ_MP(SYM(th1))(end_itlist(CONJ)(ths))))

def REAL_SHRINK_RANGE:
  prove(
    [
      hol_term(Forall(
        "x",
        Real,
        App(
          Const("real_lt", Fun(Real, Fun(Real, Bool))),
          [
            App(
              Const("real_abs", Fun(Real, Real)),
              [
                App(
                  Const("real_div", Fun(Real, Fun(Real, Real))),
                  [
                    Ref("x"),
                    App(
                      Const("real_add", Fun(Real, Fun(Real, Real))),
                      [
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                        ),
                        App(Const("real_abs", Fun(Real, Real)), [Ref("x")])
                      ]
                    )
                  ]
                )
              ]
            ),
            App(
              Const("real_of_num", Fun(Num, Real)),
              [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
            )
          ]
        )
      )),
      (
        (
          (
            GEN_TAC then_tac \
            REWRITE_TAC(
              PairList [
                REAL_ABS_DIV,
                REAL_ARITH(
                  hol_term(Eq(
                    Real,
                    App(
                      Const("real_abs", Fun(Real, Real)),
                      [
                        App(
                          Const("real_add", Fun(Real, Fun(Real, Real))),
                          [
                            App(
                              Const("real_of_num", Fun(Num, Real)),
                              [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                            ),
                            App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])
                          ]
                        )
                      ]
                    ),
                    App(
                      Const("real_add", Fun(Real, Fun(Real, Real))),
                      [
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                        ),
                        App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])
                      ]
                    )
                  ))
                )
              ]
            )
          ) then_tac \
          SIMP_TAC(
            PairList [
              REAL_LT_LDIV_EQ,
              REAL_ARITH(
                hol_term(App(
                  Const("real_lt", Fun(Real, Fun(Real, Bool))),
                  [
                    App(
                      Const("real_of_num", Fun(Num, Real)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                    ),
                    App(
                      Const("real_add", Fun(Real, Fun(Real, Real))),
                      [
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                        ),
                        App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])
                      ]
                    )
                  ]
                ))
              )
            ]
          )
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def REAL_SHRINK_LT:
