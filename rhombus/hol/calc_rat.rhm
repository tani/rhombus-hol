def REAL_RAT_ADD_CONV:
  let pth_6:
    prove(
      [
        hol_term(Implies(
          App(
            Const("real_lt", Fun(Real, Fun(Real, Bool))),
            [
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              ),
              Var("y1", Real)
            ]
          ),
          Implies(
            App(
              Const("real_lt", Fun(Real, Fun(Real, Bool))),
              [
                App(
                  Const("real_of_num", Fun(Num, Real)),
                  [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                ),
                Var("y2", Real)
              ]
            ),
            Implies(
              App(
                Const("real_lt", Fun(Real, Fun(Real, Bool))),
                [
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  ),
                  Var("y3", Real)
                ]
              ),
              Implies(
                Eq(
                  Real,
                  App(
                    Const("real_mul", Fun(Real, Fun(Real, Real))),
                    [
                      App(
                        Const("real_add", Fun(Real, Fun(Real, Real))),
                        [
                          App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x1", Real), Var("y2", Real)]),
                          App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x2", Real), Var("y1", Real)])
                        ]
                      ),
                      Var("y3", Real)
                    ]
                  ),
                  App(
                    Const("real_mul", Fun(Real, Fun(Real, Real))),
                    [
                      Var("x3", Real),
                      App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("y1", Real), Var("y2", Real)])
                    ]
                  )
                ),
                Eq(
                  Real,
                  App(
                    Const("real_add", Fun(Real, Fun(Real, Real))),
                    [
                      App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x1", Real), Var("y1", Real)]),
                      App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x2", Real), Var("y2", Real)])
                    ]
                  ),
                  App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x3", Real), Var("y3", Real)])
                )
              )
            )
          )
        )),
        (
          (
            (
              (
                (
                  (REPEAT(DISCH_TAC) then_tac MP_TAC(RAT_LEMMA2)) then_tac \
                  ASM_REWRITE_TAC(PairList [])
                ) then_tac \
                DISCH_THEN(SUBST1_TAC)
              ) then_tac \
              REWRITE_TAC(PairList [GSYM(REAL_INV_MUL), GSYM(real_div)])
            ) then_tac \
            SUBGOAL_THEN(
              hol_term(And(
                App(
                  Const("real_lt", Fun(Real, Fun(Real, Bool))),
                  [
                    App(
                      Const("real_of_num", Fun(Num, Real)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                    ),
                    App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("y1", Real), Var("y2", Real)])
                  ]
                ),
                App(
                  Const("real_lt", Fun(Real, Fun(Real, Bool))),
                  [
                    App(
                      Const("real_of_num", Fun(Num, Real)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                    ),
                    Var("y3", Real)
                  ]
                )
              ))
            )(MP_TAC)
          ) then_list \
          PairList [
            (
              (ASM_REWRITE_TAC(PairList []) then_tac MATCH_MP_TAC(REAL_LT_MUL)) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ),
            DISCH_THEN((fun(th): ASM_REWRITE_TAC(PairList [MATCH_MP(RAT_LEMMA5)(th)])))
          ]
        )
      ]
    )
  let dest_divop_2 = dest_binop(hol_term(Const("real_div", Fun(Real, Fun(Real, Real)))))
  let dest_addop_2 = dest_binop(hol_term(Const("real_add", Fun(Real, Fun(Real, Real)))))
  let x1_5 = hol_term(Var("x1", Real))
  let x2_5 = hol_term(Var("x2", Real))
  let x3_2 = hol_term(Var("x3", Real))
  let y1_5 = hol_term(Var("y1", Real))
  let y2_5 = hol_term(Var("y2", Real))
  let y3_2 = hol_term(Var("y3", Real))
  let RAW_REAL_RAT_ADD_CONV:
    fun(tm):
      let [r1, r2] = dest_addop_2(tm)
      let [x1_prime_2, y1_prime_2] = dest_divop_2(r1)
      let [x2_prime_2, y2_prime_2] = dest_divop_2(r2)
      let x1n_2 = dest_realintconst(x1_prime_2)
      let y1n_2 = dest_realintconst(y1_prime_2)
      let x2n_2 = dest_realintconst(x2_prime_2)
      let y2n_2 = dest_realintconst(y2_prime_2)
      let x3n_2 = ((x1n_2 * y2n_2) + (x2n_2 * y1n_2))
      let y3n_2 = (y1n_2 * y2n_2)
      let d = Host.gcd_num(x3n_2)(y3n_2)
      let x3n_prime_2 = Host.quo_num(x3n_2)(d)
      let y3n_prime_2 = Host.quo_num(y3n_2)(d)
      let [x3n_prime_prime, y3n_prime_prime] = (if (y3n_prime_2 > Host.num(0)) | [x3n_prime_2, y3n_prime_2] | [Host.minus_num(x3n_prime_2), Host.minus_num(y3n_prime_2)])
      let x3_prime_2 = mk_realintconst(x3n_prime_prime)
      let y3_prime_2 = mk_realintconst(y3n_prime_prime)
      let th0:
        INST(
          PairList [
            [x1_prime_2, x1_5],
            [y1_prime_2, y1_5],
            [x2_prime_2, x2_5],
            [y2_prime_2, y2_5],
            [x3_prime_2, x3_2],
            [y3_prime_2, y3_2]
          ]
        )(pth_6)
      let th1 = funpow(3)(MP_CONV(REAL_INT_LT_CONV))(th0)
      let [tm2, tm3] = Fusion.dest_eq(fst(dest_imp(concl(th1))))
      let th2_2:
        (
          LAND_CONV((BINOP_CONV(REAL_INT_MUL_CONV) then_conv REAL_INT_ADD_CONV)) then_conv \
          REAL_INT_MUL_CONV
        )(tm2)
      let th3_2 = (RAND_CONV(REAL_INT_MUL_CONV) then_conv REAL_INT_MUL_CONV)(tm3)
      MP(th1)(TRANS(th2_2)(SYM(th3_2)))
  (
    (BINOP_CONV(REAL_INT_RAT_CONV) then_conv RAW_REAL_RAT_ADD_CONV) then_conv \
    TRY_CONV(GEN_REWRITE_CONV(I)(PairList [REAL_DIV_1]))
  )

