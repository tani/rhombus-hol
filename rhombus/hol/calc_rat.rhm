def REAL_IDEAL_CONV:
  let mk_add_2 = Basics.mk_binop(Host.expand_quote("[\"Const\",\"real_add\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]]]]"))
  let mk_mul_2 = Basics.mk_binop(Host.expand_quote("[\"Const\",\"real_mul\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]]]]"))
  fun(tms):
    fun(tm):
      let cfs = real_ideal_cofactors(tms)(tm)
      let tm_prime = end_itlist(mk_add_2)(Host.map2(mk_mul_2)(cfs)(tms))
      let th_2 = calc_rat_REAL_POLY_CONV_v2(tm)
      let th_prime_2 = calc_rat_REAL_POLY_CONV_v2(tm_prime)
      Fusion.TRANS(th_2)(Equal.SYM(th_prime_2))

fun GEN_REAL_ARITH(PROVER): Realarith.GEN_REAL_ARITH([CalcInt.term_of_rat, REAL_RAT_EQ_CONV, REAL_RAT_GE_CONV, REAL_RAT_GT_CONV, calc_rat_REAL_POLY_CONV_v2, REAL_POLY_NEG_CONV, REAL_POLY_ADD_CONV, REAL_POLY_MUL_CONV, PROVER])

def REAL_ARITH:
  let init_3 = Simp.GEN_REWRITE_CONV(Equal.ONCE_DEPTH_CONV)(PairList.cons(DECIMAL, PairList []))
  let pure_2 = GEN_REAL_ARITH(Realarith.REAL_LINEAR_PROVER)
  fun(tm):
    try:
      let th = init_3(tm)
      Fusion.EQ_MP(Equal.SYM(th))(pure_2(Fusion.rand(Fusion.concl(th))))
      ~catch exn:
        match exn
        | Failure(m): failwith(Host.hol_concat("REAL_ARITH `")(Host.hol_concat(Host.string_of_term(tm))(Host.hol_concat("`: ")(m))))
        | exn: Host.hol_raise(exn)

