      let d2n_2 = Host.gcd_num(x2n_3)(y1n_3)
      if ((d1n_2 == num_1) && (d2n_2 == num_1))
      | let th0 = INST(PairList [[x1_prime_3, x1_6], [y1_prime_3, y1_6], [x2_prime_3, x2_6], [y2_prime_3, y2_6]])(pth_nocancel_2)
        let th1 = BINOP_CONV(REAL_INT_MUL_CONV)(rand(concl(th0)))
        TRANS(th0)(th1)
      | let u1n_2 = Host.quo_num(x1n_3)(d1n_2)
        let u2n_2 = Host.quo_num(x2n_3)(d2n_2)
        let v1n_2 = Host.quo_num(y1n_3)(d2n_2)
        let v2n_2 = Host.quo_num(y2n_3)(d1n_2)
        let u1_prime_2 = mk_realintconst(u1n_2)
        let u2_prime_2 = mk_realintconst(u2n_2)
        let v1_prime_2 = mk_realintconst(v1n_2)
        let v2_prime_2 = mk_realintconst(v2n_2)
        let d1_prime_2 = mk_realintconst(d1n_2)
        let d2_prime_2 = mk_realintconst(d2n_2)
        let th0:
          INST(
            PairList [
              [x1_prime_3, x1_6],
              [y1_prime_3, y1_6],
              [x2_prime_3, x2_6],
              [y2_prime_3, y2_6],
              [u1_prime_2, u1_2],
              [v1_prime_2, v1_2],
              [u2_prime_2, u2_2],
              [v2_prime_2, v2_2],
              [d1_prime_2, d1_2],
              [d2_prime_2, d2_2]
            ]
          )(pth_cancel_2)
        let th1 = EQT_ELIM(REAL_INT_REDUCE_CONV(lhand(concl(th0))))
        let th2 = MP(th0)(th1)
        let th3 = BINOP_CONV(REAL_INT_MUL_CONV)(rand(concl(th2)))
        TRANS(th2)(th3)
  (
    (BINOP_CONV(REAL_INT_RAT_CONV) then_conv RAW_REAL_RAT_MUL_CONV) then_conv \
    TRY_CONV(GEN_REWRITE_CONV(I)(PairList [REAL_DIV_1]))
  )

def REAL_RAT_DIV_CONV:
  let pth:
    prove(
      [
        hol_term(Eq(
          Real,
          App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)]),
          App(
            Const("real_mul", Fun(Real, Fun(Real, Real))),
            [Var("x", Real), App(Const("real_inv", Fun(Real, Real)), [Var("y", Real)])]
          )
        )),
        REWRITE_TAC(PairList [real_div])
      ]
    )
  (
    (GEN_REWRITE_CONV(I)(PairList [pth]) then_conv RAND_CONV(REAL_RAT_INV_CONV)) then_conv \
    REAL_RAT_MUL_CONV
  )

def REAL_RAT_POW_CONV:
  let pth:
    prove(
      [
        hol_term(Eq(
          Real,
          App(
            Const("real_pow", Fun(Real, Fun(Num, Real))),
            [
              App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)]),
              Var("n", Num)
            ]
          ),
          App(
            Const("real_div", Fun(Real, Fun(Real, Real))),
            [
              App(Const("real_pow", Fun(Real, Fun(Num, Real))), [Var("x", Real), Var("n", Num)]),
              App(Const("real_pow", Fun(Real, Fun(Num, Real))), [Var("y", Real), Var("n", Num)])
            ]
          )
        )),
        REWRITE_TAC(PairList [REAL_POW_DIV])
      ]
    )
  (
    REAL_INT_POW_CONV or_conv \
    (
      (LAND_CONV(REAL_INT_RAT_CONV) then_conv GEN_REWRITE_CONV(I)(PairList [pth])) then_conv \
      BINOP_CONV(REAL_INT_POW_CONV)
    )
  )

def REAL_RAT_MAX_CONV:
  (
    (
      REWR_CONV(real_max) then_conv \
      RATOR_CONV(RATOR_CONV(RAND_CONV(REAL_RAT_LE_CONV)))
    ) then_conv \
    GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES])
  )

def REAL_RAT_MIN_CONV:
  (
    (
      REWR_CONV(real_min) then_conv \
      RATOR_CONV(RATOR_CONV(RAND_CONV(REAL_RAT_LE_CONV)))
    ) then_conv \
    GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES])
  )

def real_rat_red_conv_list:
  PairList [
    [
      hol_term(App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)])),
      REAL_RAT_LE_CONV
    ],
    [
      hol_term(App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)])),
      REAL_RAT_LT_CONV
    ],
    [
      hol_term(App(Const("real_ge", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)])),
      REAL_RAT_GE_CONV
    ],
    [
      hol_term(App(Const("real_gt", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)])),
      REAL_RAT_GT_CONV
    ],
    [hol_term(Eq(Real, Var("x", Real), Var("y", Real))), REAL_RAT_EQ_CONV],
    [
      hol_term(App(Const("real_neg", Fun(Real, Real)), [Var("x", Real)])),
      CHANGED_CONV(REAL_RAT_NEG_CONV)
    ],
    [hol_term(App(Const("real_sgn", Fun(Real, Real)), [Var("x", Real)])), REAL_RAT_SGN_CONV],
    [hol_term(App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])), REAL_RAT_ABS_CONV],
    [hol_term(App(Const("real_inv", Fun(Real, Real)), [Var("x", Real)])), REAL_RAT_INV_CONV],
    [
      hol_term(App(Const("real_add", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)])),
      REAL_RAT_ADD_CONV
    ],
    [
      hol_term(App(Const("real_sub", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)])),
      REAL_RAT_SUB_CONV
    ],
    [
      hol_term(App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)])),
      REAL_RAT_MUL_CONV
    ],
    [
      hol_term(App(Const("real_div", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)])),
      CHANGED_CONV(REAL_RAT_DIV_CONV)
    ],
    [
      hol_term(App(Const("real_pow", Fun(Real, Fun(Num, Real))), [Var("x", Real), Var("n", Num)])),
      REAL_RAT_POW_CONV
    ],
    [
      hol_term(App(Const("real_max", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)])),
      REAL_RAT_MAX_CONV
    ],
    [
      hol_term(App(Const("real_min", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)])),
      REAL_RAT_MIN_CONV
    ]
  ]

def REAL_RAT_RED_CONV:
  let gconv_net = itlist(uncurry(net_of_conv))(real_rat_red_conv_list)(basic_net(#void))
  REWRITES_CONV(gconv_net)

def REAL_RAT_REDUCE_CONV = DEPTH_CONV(REAL_RAT_RED_CONV)

def real_rat_compute_add_convs:
  let convlist:
    map(
      fun([pat, the_conv]):
        let [c, args] = strip_comb(pat)
        [c, length(args), the_conv]
    )(real_rat_red_conv_list)
  (fun(compset): itlist(fun(newc): fun(_): Compute.Compute.add_conv(newc)(compset))(convlist)(#void))

def REAL_RAT_COMPUTE_CONV:
  let cs = Compute.Compute.bool_compset(#void)
  Compute.Compute.set_skip(cs)(hol_term(Const("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))))))(Some(1))
  real_rat_compute_add_convs(cs)
  Compute.Compute.WEAK_CBV_CONV(cs)

def [calc_rat_REAL_POLY_NEG_CONV_v2, calc_rat_REAL_POLY_ADD_CONV_v2, calc_rat_REAL_POLY_SUB_CONV_v2, calc_rat_REAL_POLY_MUL_CONV_v2, calc_rat_REAL_POLY_POW_CONV_v2, calc_rat_REAL_POLY_CONV] = SEMIRING_NORMALIZERS_CONV(REAL_POLY_CLAUSES)(REAL_POLY_NEG_CLAUSES)([is_ratconst, REAL_RAT_ADD_CONV, REAL_RAT_MUL_CONV, REAL_RAT_POW_CONV])(fun (x): fun (y): x < y)

def calc_rat_REAL_POLY_CONV_v2:
  let neg_tm_2 = hol_term(Const("real_neg", Fun(Real, Real)))
  let inv_tm_2 = hol_term(Const("real_inv", Fun(Real, Real)))
  let add_tm_2 = hol_term(Const("real_add", Fun(Real, Fun(Real, Real))))
  let sub_tm_2 = hol_term(Const("real_sub", Fun(Real, Fun(Real, Real))))
  let mul_tm_2 = hol_term(Const("real_mul", Fun(Real, Fun(Real, Real))))
  let div_tm_2 = hol_term(Const("real_div", Fun(Real, Fun(Real, Real))))
  let pow_tm_2 = hol_term(Const("real_pow", Fun(Real, Fun(Num, Real))))
  let abs_tm_2 = hol_term(Const("real_abs", Fun(Real, Real)))
  let max_tm_2 = hol_term(Const("real_max", Fun(Real, Fun(Real, Real))))
  let min_tm_2 = hol_term(Const("real_min", Fun(Real, Fun(Real, Real))))
  let div_conv_2 = REWR_CONV(real_div)
  fun REAL_POLY_CONV(tm):
    if (!is_comb(tm) || is_ratconst(tm))
    | REFL(tm)
    | let [lop, r] = dest_comb(tm)
      if (lop == neg_tm_2)
      | let th1 = AP_TERM(lop)(REAL_POLY_CONV(r))
        TRANS(th1)(calc_rat_REAL_POLY_NEG_CONV_v2(rand(concl(th1))))
      | if (lop == inv_tm_2)
        | let th1 = AP_TERM(lop)(REAL_POLY_CONV(r))
          TRANS(th1)(TRY_CONV(REAL_RAT_INV_CONV)(rand(concl(th1))))
        | if (lop == abs_tm_2)
          | AP_TERM(lop)(REAL_POLY_CONV(r))
          | if !is_comb(lop)
            | REFL(tm)
            | let [op, l] = dest_comb(lop)
              if (op == pow_tm_2)
              | let th1 = AP_THM(AP_TERM(op)(REAL_POLY_CONV(l)))(r)
                TRANS(th1)(TRY_CONV(calc_rat_REAL_POLY_POW_CONV_v2)(rand(concl(th1))))
              | if ((op == add_tm_2) || ((op == mul_tm_2) || (op == sub_tm_2)))
                | let th1 = MK_COMB([AP_TERM(op)(REAL_POLY_CONV(l)), REAL_POLY_CONV(r)])
                  let fn:
                    if (op == add_tm_2)
                    | calc_rat_REAL_POLY_ADD_CONV_v2
                    | (if (op == mul_tm_2) | calc_rat_REAL_POLY_MUL_CONV_v2 | calc_rat_REAL_POLY_SUB_CONV_v2)
                  TRANS(th1)(fn(rand(concl(th1))))
                | if (op == div_tm_2)
                  | let th1 = div_conv_2(tm)
                    TRANS(th1)(REAL_POLY_CONV(rand(concl(th1))))
                  | (if ((op == min_tm_2) || (op == max_tm_2)) | MK_COMB([AP_TERM(op)(REAL_POLY_CONV(l)), REAL_POLY_CONV(r)]) | REFL(tm))
  REAL_POLY_CONV

def [calc_rat_REAL_RING_v2, real_ideal_cofactors]:
  let REAL_INTEGRAL_2:
    prove(
      [
        hol_term(And(
          Forall(
            "x",
            Real,
            Eq(
              Real,
              App(
                Const("real_mul", Fun(Real, Fun(Real, Real))),
                [
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  ),
                  Ref("x")
                ]
              ),
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              )
            )
          ),
          And(
            Forall(
              "x",
              Real,
              Forall(
                "y",
                Real,
                Forall(
                  "z",
                  Real,
                  Iff(
                    Eq(
                      Real,
                      App(Const("real_add", Fun(Real, Fun(Real, Real))), [Ref("x"), Ref("y")]),
                      App(Const("real_add", Fun(Real, Fun(Real, Real))), [Ref("x"), Ref("z")])
                    ),
                    Eq(Real, Ref("y"), Ref("z"))
                  )
                )
              )
            ),
            Forall(
              "w",
              Real,
              Forall(
                "x",
                Real,
                Forall(
                  "y",
                  Real,
                  Forall(
                    "z",
                    Real,
                    Iff(
                      Eq(
                        Real,
                        App(
                          Const("real_add", Fun(Real, Fun(Real, Real))),
                          [
                            App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Ref("w"), Ref("y")]),
                            App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Ref("x"), Ref("z")])
                          ]
                        ),
                        App(
                          Const("real_add", Fun(Real, Fun(Real, Real))),
                          [
                            App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Ref("w"), Ref("z")]),
                            App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Ref("x"), Ref("y")])
                          ]
                        )
                      ),
                      Or(Eq(Real, Ref("w"), Ref("x")), Eq(Real, Ref("y"), Ref("z")))
                    )
                  )
                )
              )
            )
          )
        )),
        (
          (
            (
              (
                REWRITE_TAC(PairList [MULT_CLAUSES, EQ_ADD_LCANCEL]) then_tac \
                REWRITE_TAC(
                  PairList [
                    GSYM(REAL_OF_NUM_EQ),
                    GSYM(REAL_OF_NUM_ADD),
                    GSYM(REAL_OF_NUM_MUL)
                  ]
                )
              ) then_tac \
              ONCE_REWRITE_TAC(PairList [GSYM(REAL_SUB_0)])
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(REAL_ENTIRE)])
          ) then_tac \
          Real.REAL_ARITH_TAC
        )
      ]
    )
  let REAL_RABINOWITSCH_2:
    prove(
      [
        hol_term(Forall(
          "x",
          Real,
          Forall(
            "y",
            Real,
            Iff(
              Not(Eq(Real, Ref("x"), Ref("y"))),
              Exists(
                "z",
                Real,
                Eq(
                  Real,
                  App(
                    Const("real_mul", Fun(Real, Fun(Real, Real))),
                    [App(Const("real_sub", Fun(Real, Fun(Real, Real))), [Ref("x"), Ref("y")]), Ref("z")]
                  ),
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                  )
                )
              )
            )
          )
        )),
        (
          (
            REPEAT(GEN_TAC) then_tac \
            GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [GSYM(REAL_SUB_0)])
          ) then_tac \
          MESON_TAC(
            PairList [
              REAL_MUL_RINV,
              REAL_MUL_LZERO,
              Realarith.REAL_ARITH(
                hol_term(Not(
                  Eq(
                    Real,
                    App(
                      Const("real_of_num", Fun(Num, Real)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                    ),
                    App(
                      Const("real_of_num", Fun(Num, Real)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                    )
                  )
                ))
              )
            ]
          )
        )
      ]
    )
  let init_2 = GEN_REWRITE_CONV(ONCE_DEPTH_CONV)(PairList [DECIMAL])
  let real_ty_2 = hol_term(Real)
  let [pure, ideal]:
    RING_AND_IDEAL_CONV(
      [
        rat_of_term,
        term_of_rat,
        REAL_RAT_EQ_CONV,
        hol_term(Const("real_neg", Fun(Real, Real))),
        hol_term(Const("real_add", Fun(Real, Fun(Real, Real)))),
        hol_term(Const("real_sub", Fun(Real, Fun(Real, Real)))),
        hol_term(Const("real_inv", Fun(Real, Real))),
        hol_term(Const("real_mul", Fun(Real, Fun(Real, Real)))),
        hol_term(Const("real_div", Fun(Real, Fun(Real, Real)))),
        hol_term(Const("real_pow", Fun(Real, Fun(Num, Real)))),
        REAL_INTEGRAL_2,
        REAL_RABINOWITSCH_2,
        calc_rat_REAL_POLY_CONV_v2
      ]
    )
  [
    fun(tm):
      let th = init_2(tm)
      EQ_MP(SYM(th))(pure(rand(concl(th)))),
    fun(tms): fun(tm): (if forall((fun(t): (type_of(t) == real_ty_2)))(PairList [tm, & tms]) | ideal(tms)(tm) | failwith("real_ideal_cofactors: not all terms have type :real"))
  ]

def REAL_IDEAL_CONV:
  let mk_add_2 = mk_binop(hol_term(Const("real_add", Fun(Real, Fun(Real, Real)))))
  let mk_mul_2 = mk_binop(hol_term(Const("real_mul", Fun(Real, Fun(Real, Real)))))
  fun(tms):
    fun(tm):
      let cfs = real_ideal_cofactors(tms)(tm)
      let tm_prime = end_itlist(mk_add_2)(map2(mk_mul_2)(cfs)(tms))
      let th_2 = calc_rat_REAL_POLY_CONV_v2(tm)
      let th_prime_2 = calc_rat_REAL_POLY_CONV_v2(tm_prime)
      TRANS(th_2)(SYM(th_prime_2))

fun GEN_REAL_ARITH(PROVER):
  Realarith.GEN_REAL_ARITH(
    [
      term_of_rat,
      REAL_RAT_EQ_CONV,
      REAL_RAT_GE_CONV,
      REAL_RAT_GT_CONV,
      calc_rat_REAL_POLY_CONV_v2,
      calc_rat_REAL_POLY_NEG_CONV_v2,
      calc_rat_REAL_POLY_ADD_CONV_v2,
      calc_rat_REAL_POLY_MUL_CONV_v2,
      PROVER
    ]
  )

def REAL_ARITH:
  let init_3 = GEN_REWRITE_CONV(ONCE_DEPTH_CONV)(PairList [DECIMAL])
  let pure_2 = GEN_REAL_ARITH(REAL_LINEAR_PROVER)
  fun(tm):
    try:
      let th = init_3(tm)
      EQ_MP(SYM(th))(pure_2(rand(concl(th))))
      ~catch exn:
        match exn
        | Failure(m):
            failwith(
              ("REAL_ARITH `" +& (Host.string_of_term(tm) +& ("`: " +& m)))
            )
        | exn: (throw exn)

def REAL_ARITH_TAC = CONV_TAC(REAL_ARITH)

def ASM_REAL_ARITH_TAC:
  (
    REPEAT(
      FIRST_X_ASSUM(o(MP_TAC)(check(o(o((fun (x): !x))(is_forall))(concl))))
    ) then_tac \
    REAL_ARITH_TAC
  )

def REAL_LE_TRANS_LE:
  prove(
    [
      hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Iff(
            App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("y")]),
            Forall(
              "z",
              Real,
              Implies(
                App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("y"), Ref("z")]),
                App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("z")])
              )
            )
          )
        )
      )),
      MESON_TAC(PairList [REAL_LE_TRANS, REAL_LE_REFL])
    ]
  )

def REAL_LE_TRANS_LTE:
  prove(
    [
      hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Iff(
            App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("y")]),
            Forall(
              "z",
              Real,
              Implies(
                App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Ref("y"), Ref("z")]),
                App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("z")])
              )
            )
          )
        )
      )),
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
            PairList [REAL_ARITH_TAC, ALL_TAC]
          ) then_tac \
          DISCH_THEN(
            o(MP_TAC)(
              SPEC(
                hol_term(App(
                  Const("real_add", Fun(Real, Fun(Real, Real))),
                  [
                    Var("y", Real),
                    App(
                      Const("real_div", Fun(Real, Fun(Real, Real))),
                      [
                        App(Const("real_sub", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)]),
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [
                            App(
                              Const("NUMERAL", Fun(Num, Num)),
                              [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                            )
                          ]
                        )
                      ]
                    )
                  ]
                ))
              )
            )
          )
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def REAL_LE_TRANS_LT:
  prove(
    [
      hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Iff(
            App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("y")]),
