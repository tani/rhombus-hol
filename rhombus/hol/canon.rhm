              Host.hol_sub(port_tmp_362)(port_tmp_361)
              ~catch port_tmp_360:
                match port_tmp_360
                | Failure(_): 0
                | port_tmp_360: Host.hol_raise(port_tmp_360)
          (if Host.hol_equal(n)(0) | th | Fusion.TRANS(th)(APP_N_CONV(n)(tm_prime)))
    port_tmp_363
  fun port_tmp_365([cheads, vheads]):
    let hddata:
      if Host.hol_equal(vheads)(PairList [])
      | let hops = Host.setify(map(fst)(cheads))
        fun port_tmp_364(h):
          let ns = mapfilter((fun([k, n]): (if Host.hol_equal(k)(h) | n | Host.hol_apply_unit(fail))))(cheads)
          (if Host.hol_lt(length(ns))(2) | Host.hol_apply_unit(fail) | [h, end_itlist(Host.hol_min)(ns)])
        let getmin = port_tmp_364
        mapfilter(getmin)(hops)
      | map((fun(t): (if (Fusion.is_const(t) && Host.hol_equal(fst(Fusion.dest_const(t)))("=")) | [t, 2] | [t, 0])))(Host.setify(map(fst)(append(vheads)(cheads))))
    FOL_CONV(hddata)
  let GEN_FOL_CONV = port_tmp_365
  fun port_tmp_366([asl, w] as gl):
    let headsp = itlist(o(get_thm_heads)(snd))(asl)([PairList [], PairList []])
    Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(GEN_FOL_CONV(headsp)))(gl)
  port_tmp_366

fun PROP_ATOM_CONV(conv):
  fun port_tmp_367(tm):
    match tm
    | Fusion.Comb(Fusion.Const("!",_),Fusion.Abs(_,_)): Equal.BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Const("?",_),Fusion.Abs(_,_)): Equal.BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Const("?!",_),Fusion.Abs(_,_)): Equal.BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("/\\",_),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("\\/",_),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("==>",_),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("=",Fusion.Tyapp("fun",PairList [Fusion.Tyapp("bool",PairList []), & PairList [_, & PairList []]])),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Const("~",_),_): Equal.RAND_CONV(PROP_ATOM_CONV(conv))(tm)
    | _: Equal.TRY_CONV(conv)(tm)
  port_tmp_367
