    | Comb(Const("!",_),Abs(_,_)): BINDER_CONV(strongcnf_2)(tm)
    | Comb(Const("?",_),Abs(_,_)): BINDER_CONV(strongcnf_2)(tm)
    | Comb(Comb(Const("/\\",_),_),_): BINOP_CONV(substrongcnf_2)(tm)
    | Comb(Comb(Const("\\/",_) as op,l),r):
        let th = MK_COMB([AP_TERM(op)(substrongcnf_2(l)), substrongcnf_2(r)])
        TRANS(th)(distribute_2(rand(concl(th))))
    | _: REFL(tm)
  fun strongcnf_2(tm):
    let th = substrongcnf_2(tm)
    TRANS(th)(strengthen(rand(concl(th))))
  [weakcnf_2, strongcnf_2]

fun ASSOC_CONV(th):
  let th_prime = SYM(SPEC_ALL(th))
  let [opx, yopz] = dest_comb(rhs(concl(th_prime)))
  let [op, x] = dest_comb(opx)
  let y_5 = lhand(yopz)
  let z_2 = rand(yopz)
  fun distrib(tm):
    match tm
    | Comb(Comb(op_prime,Comb(Comb(op_prime_prime,p),q)),r):
        if ((op_prime == op) && (op_prime_prime == op))
        | let th1 = INST(PairList [[p, x], [q, y_5], [r, z_2]])(th_prime)
          let [l, r_prime] = dest_comb(rand(concl(th1)))
          let th2 = AP_TERM(l)(distrib(r_prime))
          let th3 = distrib(rand(concl(th2)))
          TRANS(th1)(TRANS(th2)(th3))
        | match tm
          | _: REFL(tm)
    | _: REFL(tm)
  fun assoc_2(tm):
    match tm
    | Comb(Comb(op_prime,p) as l,q):
        if (op_prime == op)
        | let th = AP_TERM(l)(assoc_2(q))
          TRANS(th)(distrib(rand(concl(th))))
        | match tm
          | _: REFL(tm)
    | _: REFL(tm)
  assoc_2

def SELECT_ELIM_TAC:
  let pth_3:
    prove(
      [
        @hol|{(P:A->bool)((@) P) <=> (?) P}|,
        REWRITE_TAC(PairList [EXISTS_THM]) then_tac BETA_TAC then_tac \
        REFL_TAC
      ]
    )
  let ptm_2 = @hol|{P:A->bool}|
  let SELECT_ELIM_THM:
    fun(tm):
      let [stm, atm] = dest_comb(tm)
      if (is_const(stm) && (fst(dest_const(stm)) == "@"))
      | CONV_RULE(LAND_CONV(BETA_CONV))(
          PINST(PairList [[type_of(bndvar(atm)), aty]])(PairList [[atm, ptm_2]])(pth_3)
        )
      | failwith("SELECT_ELIM_THM: not a select-term")
  let SELECT_ELIM_CONV = (fun(tm): PURE_REWRITE_CONV(map(SELECT_ELIM_THM)(find_terms(is_select)(tm)))(tm))
  let pth_4 = ISPEC(@hol|{P:A->bool}|)(SELECT_AX)
  let ptm_3 = @hol|{P:A->bool}|
  let SELECT_AX_THM:
    fun(tm):
      let [stm, atm] = dest_comb(tm)
      if (is_const(stm) && (fst(dest_const(stm)) == "@"))
      | let fvs = frees(atm)
        let th1 = PINST(PairList [[type_of(bndvar(atm)), aty]])(PairList [[atm, ptm_3]])(pth_4)
        let th2 = CONV_RULE(BINDER_CONV(BINOP_CONV(BETA_CONV)))(th1)
        GENL(fvs)(th2)
      | failwith("SELECT_AX_THM: not a select-term")
  let SELECT_ELIM_ICONV:
    fun(tm):
      let t = find_term(is_select)(tm)
      let th1 = SELECT_AX_THM(t)
      let itm = mk_imp([concl(th1), tm])
      let th2 = DISCH_ALL(MP(ASSUME(itm))(th1))
      let fvs = frees(t)
      let fty = itlist(o(mk_fun_ty)(type_of))(fvs)(type_of(t))
      let fn_2 = genvar(fty)
      let atm_2 = list_mk_abs([fvs, t])
      let rawdef = mk_eq([fn_2, atm_2])
      let hol_def_2 = GENL(fvs)(SYM(RIGHT_BETAS(fvs)(ASSUME(rawdef))))
      let th3 = PURE_REWRITE_CONV(PairList [hol_def_2])(lhand(concl(th2)))
      let gtm = mk_forall([fn_2, rand(concl(th3))])
      let th4 = EQ_MP(SYM(th3))(SPEC(fn_2)(ASSUME(gtm)))
      let th5 = IMP_TRANS(DISCH(gtm)(th4))(th2)
      MP(INST(PairList [[atm_2, fn_2]])(DISCH(rawdef)(th5)))(REFL(atm_2))
  fun SELECT_ELIMS_ICONV(tm):
    try:
      let th = SELECT_ELIM_ICONV(tm)
      let tm_prime = lhand(concl(th))
      IMP_TRANS(SELECT_ELIMS_ICONV(tm_prime))(th)
      ~catch exn:
        match exn
        | Failure(_): DISCH(tm)(ASSUME(tm))
        | exn: (throw exn)
  let SELECT_ELIM_ICONV = SELECT_ELIMS_ICONV
  (
    CONV_TAC(SELECT_ELIM_CONV) then_tac \
    W(o(o(MATCH_MP_TAC)(SELECT_ELIM_ICONV))(snd))
  )

def LAMBDA_ELIM_CONV:
  let pth:
    prove(
      [
        @hol|{(s = \x. t x) <=> (!x. s x = t x)}|,
        REWRITE_TAC(PairList [FUN_EQ_THM])
      ]
    )
  // Recursive conversion needs the local definition before its first use.
  fun conv(vs): fun(tm): (if (vs == (PairList [])) | REFL(tm) | (GEN_REWRITE_CONV(I)(PairList [pth]) then_conv BINDER_CONV(conv(tl(vs))))(tm))
  let HALF_MK_ABS_CONV = conv
  fun find_lambda(tm):
    if is_abs(tm)
    | tm
    | if (is_var(tm) || is_const(tm))
      | failwith("find_lambda")
      | if is_abs(tm)
        | tm
        | if (is_forall(tm) || (is_exists(tm) || is_uexists(tm)))
          | find_lambda(body(rand(tm)))
          | let [l, r] = dest_comb(tm)
            try:
              find_lambda(l)
              ~catch exn:
                match exn
                | Failure(_): find_lambda(r)
                | exn: (throw exn)
  // Recursive lambda elimination needs the local definition before its first use.
  fun ELIM_LAMBDA(conv):
    fun(tm):
      try:
        conv(tm)
        ~catch exn:
          match exn
          | Failure(_):
              if is_abs(tm)
              | ABS_CONV(ELIM_LAMBDA(conv))(tm)
              | if (is_var(tm) || is_const(tm))
                | REFL(tm)
                | (if (is_forall(tm) || (is_exists(tm) || is_uexists(tm))) | BINDER_CONV(ELIM_LAMBDA(conv))(tm) | COMB_CONV(ELIM_LAMBDA(conv))(tm))
          | exn: (throw exn)
  let pth:
    prove(
      [
        @hol|{(!a. (a = c) ==> (P = Q a)) ==> (P <=> !a. (a = c) ==> Q a)}|,
        SIMP_TAC(PairList [LEFT_FORALL_IMP_THM, EXISTS_REFL])
      ]
    )
  let APPLY_PTH = MATCH_MP(pth)
  let LAMB1_CONV:
    fun(tm):
      let atm = find_lambda(tm)
      let [v, bod] = dest_abs(atm)
      let vs = frees(atm)
      let vs_prime = append(vs)(PairList [v])
      let aatm = list_mk_abs([vs, atm])
      let f = genvar(type_of(aatm))
      let eq = mk_eq([f, aatm])
      let th1 = SYM(RIGHT_BETAS(vs)(ASSUME(eq)))
      let th2 = ELIM_LAMBDA(GEN_REWRITE_CONV(I)(PairList [th1]))(tm)
      let th3 = APPLY_PTH(GEN(f)(DISCH_ALL(th2)))
      CONV_RULE(RAND_CONV(BINDER_CONV(LAND_CONV(HALF_MK_ABS_CONV(vs_prime)))))(th3)
  fun conv_2(tm):
    try:
      (LAMB1_CONV then_conv conv_2)(tm)
      ~catch exn:
        match exn
        | Failure(_): REFL(tm)
        | exn: (throw exn)
  conv_2

def [canon_CONDS_ELIM_CONV_v2, CONDS_CELIM_CONV]:
  let th_cond_2:
    prove(
      [
        @hol|{((b <=> F) ==> x = x0) /\ ((b <=> T) ==> x = x1)
           ==> x = (b /\ x1 \/ ~b /\ x0)}|,
        BOOL_CASES_TAC(@hol|{b:bool}|) then_tac ASM_REWRITE_TAC(PairList [])
      ]
    )
  let th_cond_prime_2:
    prove(
      [
        @hol|{((b <=> F) ==> x = x0) /\ ((b <=> T) ==> x = x1)
           ==> x = ((~b \/ x1) /\ (b \/ x0))}|,
        BOOL_CASES_TAC(@hol|{b:bool}|) then_tac ASM_REWRITE_TAC(PairList [])
      ]
    )
  let propsimps_2 = basic_net(#void)
  let false_tm_2 = @hol|{F}|
  let true_tm_2 = @hol|{T}|
  let match_th_2 = MATCH_MP(th_cond_2)
  let match_th_prime_2 = MATCH_MP(th_cond_prime_2)
  let propsimp_conv_2 = DEPTH_CONV(REWRITES_CONV(propsimps_2))
  let cnv = TRY_CONV(REWRITES_CONV(propsimps_2))
  let proptsimp_conv_2 = (BINOP_CONV(cnv) then_conv cnv)
  // Recursive conditional search needs the local definition before its first use.
  fun find_conditional(fvs):
    fun(tm):
      match tm
      | Comb(s,t):
          if (is_cond(tm) && (intersect(frees(lhand(s)))(fvs) == (PairList [])))
          | tm
          | try:
              find_conditional(fvs)(s)
              ~catch exn:
                match exn
                | Failure(_): find_conditional(fvs)(t)
                | exn: (throw exn)
      | Abs(x,t): find_conditional(PairList [x, & fvs])(t)
      | _: failwith("find_conditional")
  // Recursive conversion needs the local definition before its first use.
  fun CONDS_ELIM_CONV(dfl):
    fun(tm):
      try:
        let t = find_conditional(PairList [])(tm)
        let p = lhand(rator(t))
        let th_new:
          if ((p == false_tm_2) || (p == true_tm_2))
          | propsimp_conv_2(tm)
          | let asm_0_2 = mk_eq([p, false_tm_2])
            let asm_1_2 = mk_eq([p, true_tm_2])
            let simp_0_2 = net_of_thm(#false)(ASSUME(asm_0_2))(propsimps_2)
            let simp_1_2 = net_of_thm(#false)(ASSUME(asm_1_2))(propsimps_2)
            let th_0_2 = DISCH(asm_0_2)(DEPTH_CONV(REWRITES_CONV(simp_0_2))(tm))
            let th_1_2 = DISCH(asm_1_2)(DEPTH_CONV(REWRITES_CONV(simp_1_2))(tm))
            let th_2 = CONJ(th_0_2)(th_1_2)
            let th_3 = (if dfl | match_th_2(th_2) | match_th_prime_2(th_2))
            TRANS(th_3)(proptsimp_conv_2(rand(concl(th_3))))
        CONV_RULE(RAND_CONV(CONDS_ELIM_CONV(dfl)))(th_new)
        ~catch exn:
          match exn
          | Failure(_):
              if is_neg(tm)
              | RAND_CONV(CONDS_ELIM_CONV(!dfl))(tm)
              | if (is_conj(tm) || is_disj(tm))
                | BINOP_CONV(CONDS_ELIM_CONV(dfl))(tm)
                | if (is_imp(tm) || is_iff(tm))
                  | COMB2_CONV(RAND_CONV(CONDS_ELIM_CONV(!dfl)))(CONDS_ELIM_CONV(dfl))(tm)
                  | if is_forall(tm)
                    | BINDER_CONV(CONDS_ELIM_CONV(#false))(tm)
                    | (if (is_exists(tm) || is_uexists(tm)) | BINDER_CONV(CONDS_ELIM_CONV(#true))(tm) | REFL(tm))
          | exn: (throw exn)
  [CONDS_ELIM_CONV(#true), CONDS_ELIM_CONV(#false)]

def ASM_FOL_TAC:
  // Recursive head collection needs the local definition before its first use.
  fun get_heads(lconsts):
    fun(tm):
      fun([cheads, vheads] as sofar):
        try:
          let [v, bod] = dest_forall(tm)
          get_heads(subtract(lconsts)(PairList [v]))(bod)(sofar)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  let [l, r]:
                    try:
                      dest_conj(tm)
                      ~catch exn:
                        match exn
                        | Failure(_): dest_disj(tm)
                        | exn: (throw exn)
                  get_heads(lconsts)(l)(get_heads(lconsts)(r)(sofar))
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let tm_prime = dest_neg(tm)
                          get_heads(lconsts)(tm_prime)(sofar)
                          ~catch exn:
                            match exn
                            | Failure(_):
                                let [hop, args] = strip_comb(tm)
                                let len = length(args)
                                let newheads:
                                  if (is_const(hop) || mem(hop)(lconsts))
                                  | [insert([hop, len])(cheads), vheads]
                                  | (if (len > 0) | [cheads, insert([hop, len])(vheads)] | sofar)
                                itlist(get_heads(lconsts))(args)(newheads)
                            | exn: (throw exn)
                    | exn: (throw exn)
            | exn: (throw exn)
  let get_thm_heads = fun(th): fun(sofar): get_heads(freesl(hyp(th)))(concl(th))(sofar)
  let th:
    prove(
      [
        @hol|{!(f:A->B) x. f x = I f x}|,
        REWRITE_TAC(PairList [I_THM])
      ]
    )
  let APP_CONV = REWR_CONV(th)
  // Recursive application conversion needs the local definition before its first use.
  fun APP_N_CONV(n): fun(tm): (if (n == 1) | APP_CONV(tm) | (RATOR_CONV(APP_N_CONV((n - 1))) then_conv APP_CONV)(tm))
  // Recursive formula conversion needs the local definition before its first use.
  fun FOL_CONV(hddata):
    fun(tm):
      if is_forall(tm)
      | BINDER_CONV(FOL_CONV(hddata))(tm)
      | if (is_conj(tm) || is_disj(tm))
        | BINOP_CONV(FOL_CONV(hddata))(tm)
        | let [op, args] = strip_comb(tm)
          let th = rev_itlist(C(curry(MK_COMB)))(map(FOL_CONV(hddata))(args))(REFL(op))
          let tm_prime = rand(concl(th))
          let n:
            try:
              (length(args) - assoc(op)(hddata))
              ~catch exn:
                match exn
                | Failure(_): 0
                | exn: (throw exn)
          (if (n == 0) | th | TRANS(th)(APP_N_CONV(n)(tm_prime)))
  let GEN_FOL_CONV:
    fun([cheads, vheads]):
      let hddata:
        if (vheads == (PairList []))
        | let hops = setify(map(fst)(cheads))
          let getmin:
            fun(h):
              let ns = mapfilter((fun([k, n]): (if (k == h) | n | fail())))(cheads)
              (if (length(ns) < 2) | fail() | [h, end_itlist(hol_min)(ns)])
          mapfilter(getmin)(hops)
        | map(
            (fun(t): (if (is_const(t) && (fst(dest_const(t)) == "=")) | [t, 2] | [t, 0]))
          )(setify(map(fst)(append(vheads)(cheads))))
      FOL_CONV(hddata)
  fun([asl, w] as gl):
    let headsp = itlist(o(get_thm_heads)(snd))(asl)([PairList [], PairList []])
    RULE_ASSUM_TAC(CONV_RULE(GEN_FOL_CONV(headsp)))(gl)

fun PROP_ATOM_CONV(conv):
  fun(tm):
    match tm
    | Comb(Const("!",_),Abs(_,_)): BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Const("?",_),Abs(_,_)): BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Const("?!",_),Abs(_,_)): BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Comb(Const("/\\",_),_),_): BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Comb(Const("\\/",_),_),_): BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Comb(Const("==>",_),_),_): BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",PairList []), & PairList [_, & PairList []]])),_),_): BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Const("~",_),_): RAND_CONV(PROP_ATOM_CONV(conv))(tm)
    | _: TRY_CONV(conv)(tm)

def WEAK_DNF_CONV = canon_WEAK_DNF_CONV_v2

def WEAK_CNF_CONV = canon_WEAK_CNF_CONV_v2

def CONDS_ELIM_CONV = canon_CONDS_ELIM_CONV_v2
