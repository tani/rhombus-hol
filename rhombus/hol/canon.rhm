fun CONJ_CANON_CONV(tm):
  let tm_prime = Bool.list_mk_conj(Host.setify(Basics.conjuncts(tm)))
  CONJ_ACI_RULE(Fusion.mk_eq([tm, tm_prime]))

fun DISJ_CANON_CONV(tm):
  let tm_prime = Bool.list_mk_disj(Host.setify(Basics.disjuncts(tm)))
  DISJ_ACI_RULE(Fusion.mk_eq([tm, tm_prime]))

