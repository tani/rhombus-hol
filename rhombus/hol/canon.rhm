def PRESIMP_CONV:
  GEN_REWRITE_CONV(
    TOP_DEPTH_CONV)(
    PairList [
      NOT_CLAUSES,
      AND_CLAUSES,
      OR_CLAUSES,
      IMP_CLAUSES,
      EQ_CLAUSES,
      FORALL_SIMP,
      EXISTS_SIMP,
      EXISTS_OR_THM,
      FORALL_AND_THM,
      LEFT_EXISTS_AND_THM,
      RIGHT_EXISTS_AND_THM,
      LEFT_FORALL_OR_THM,
      RIGHT_FORALL_OR_THM
    ]
  )

def CONJ_ACI_RULE:
  // Recursive conjunction indexing needs the local definition before its first use.
  fun mk_fun(th):
    fun(fn):
      let tm = concl(th)
      if is_conj(tm)
      | let [th1, th2] = CONJ_PAIR(th)
        mk_fun(th1)(mk_fun(th2)(fn))
      | fpf_define(tm)(th)(fn)
  // Recursive conjunction rebuilding needs the local definition before its first use.
  fun use_fun(fn):
    fun(tm):
      if is_conj(tm)
      | let [l, r] = dest_conj(tm)
        CONJ(use_fun(fn)(l))(use_fun(fn)(r))
      | apply(fn)(tm)
  fun(fm):
    let [p, p_prime] = dest_eq(fm)
    if p == p_prime
    | REFL(p)
    | let th = use_fun(mk_fun(ASSUME(p))(undefined))(p_prime)
      let th_prime = use_fun(mk_fun(ASSUME(p_prime))(undefined))(p)
      IMP_ANTISYM_RULE(DISCH_ALL(th))(DISCH_ALL(th_prime))

def DISJ_ACI_RULE:
  let pth_left:
    UNDISCH(
      TAUT(@hol|{~(a \/ b) ==> ~a}|)
    )
  let pth_right:
    UNDISCH(
      TAUT(@hol|{~(a \/ b) ==> ~b}|)
    )
  let pth:
    repeat(UNDISCH)(
      TAUT(
        @hol|{~a ==> ~b ==> ~(a \/ b)}|
      )
    )
  let pth_neg:
    UNDISCH(
      TAUT(
        @hol|{(~a <=> ~b) ==> (a <=> b)}|
      )
    )
  let a_tm = @hol|{a:bool}|
  let b_tm = @hol|{b:bool}|
  let NOT_DISJ_PAIR:
    fun(th):
      let [p, q] = dest_disj(rand(concl(th)))
      let ilist = PairList [[p, a_tm], [q, b_tm]]
      [
        PROVE_HYP(th)(INST(ilist)(pth_left)),
        PROVE_HYP(th)(INST(ilist)(pth_right))
      ]
  let NOT_DISJ:
    fun(th1):
      fun(th2):
        let th3 = INST(PairList [[rand(concl(th1)), a_tm], [rand(concl(th2)), b_tm]])(pth)
        PROVE_HYP(th1)(PROVE_HYP(th2)(th3))
  // Recursive disjunction indexing needs the local definition before its first use.
  fun mk_fun(th):
    fun(fn):
      let tm = rand(concl(th))
      if is_disj(tm)
      | let [th1, th2] = NOT_DISJ_PAIR(th)
        mk_fun(th1)(mk_fun(th2)(fn))
      | fpf_define(tm)(th)(fn)
  // Recursive disjunction rebuilding needs the local definition before its first use.
  fun use_fun(fn):
    fun(tm):
      if is_disj(tm)
      | let [l, r] = dest_disj(tm)
        NOT_DISJ(use_fun(fn)(l))(use_fun(fn)(r))
      | apply(fn)(tm)
  fun(fm):
    let [p, p_prime] = dest_eq(fm)
    if (p == p_prime)
    | REFL(p)
    | let th_3 = use_fun(mk_fun(ASSUME(mk_neg(p)))(undefined))(p_prime)
      let th_prime = use_fun(mk_fun(ASSUME(mk_neg(p_prime)))(undefined))(p)
      let th1 = IMP_ANTISYM_RULE(DISCH_ALL(th_3))(DISCH_ALL(th_prime))
      PROVE_HYP(th1)(INST(PairList [[p, a_tm], [p_prime, b_tm]])(pth_neg))

fun CONJ_CANON_CONV(tm):
  let tm_prime = list_mk_conj(setify(conjuncts(tm)))
  CONJ_ACI_RULE(mk_eq([tm, tm_prime]))

fun DISJ_CANON_CONV(tm):
  let tm_prime = list_mk_disj(setify(disjuncts(tm)))
  DISJ_ACI_RULE(mk_eq([tm, tm_prime]))

def GEN_NNF_CONV:
  let and_tm = @hol|{(/\)}|
  let or_tm = @hol|{(\/)}|
  let not_tm = @hol|{(~)}|
  let pth_not_not = TAUT(@hol|{~ ~ p = p}|)
  let pth_not_and:
    TAUT(
      @hol|{~(p /\ q) <=> ~p \/ ~q}|
    )
  let pth_not_or:
    TAUT(
      @hol|{~(p \/ q) <=> ~p /\ ~q}|
    )
  let pth_imp:
    TAUT(
      @hol|{p ==> q <=> ~p \/ q}|
    )
  let pth_not_imp:
    TAUT(
      @hol|{~(p ==> q) <=> p /\ ~q}|
    )
  let pth_eq:
    TAUT(
      @hol|{(p <=> q) <=> p /\ q \/ ~p /\ ~q}|
    )
  let pth_not_eq:
    TAUT(
      @hol|{~(p <=> q) <=> p /\ ~q \/ ~p /\ q}|
    )
  let pth_eq_prime:
    TAUT(
      @hol|{(p <=> q) <=> (p \/ ~q) /\ (~p \/ q)}|
    )
  let pth_not_eq_prime:
    TAUT(
      @hol|{~(p <=> q) <=> (p \/ q) /\ (~p \/ ~q)}|
    )
  let PairList [pth_not_forall, & PairList [pth_not_exists, & PairList [pth_not_exu, & PairList []]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{(~((!) P) <=> ?x:A. ~(P x)) /\
           (~((?) P) <=> !x:A. ~(P x)) /\
           (~((?!) P) <=> (!x:A. ~(P x)) \/ ?x y. P x /\ P y /\ ~(y = x))}|,
        REPEAT(CONJ_TAC) then_tac \
        GEN_REWRITE_TAC(o(LAND_CONV)(funpow(2)(RAND_CONV)))(PairList [GSYM(ETA_AX)]) then_tac \
        REWRITE_TAC(
          PairList [
            NOT_EXISTS_THM,
            NOT_FORALL_THM,
            EXISTS_UNIQUE_DEF,
            DE_MORGAN_THM,
            NOT_IMP
          ]
        ) then_tac \
        REWRITE_TAC(PairList [CONJ_ASSOC, EQ_SYM_EQ])
      ]
    )
  let pth_exu:
    prove(
      [
        @hol|{((?!) P) <=> (?x:A. P x) /\ !x y. ~(P x) \/ ~(P y) \/ (y = x)}|,
        GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [GSYM(ETA_AX)]) then_tac \
        REWRITE_TAC(
          PairList [
            EXISTS_UNIQUE_DEF,
            TAUT(
              @hol|{a /\ b ==> c <=> ~a \/ ~b \/ c}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [EQ_SYM_EQ])
      ]
    )
  let p_tm = @hol|{p:bool}|
  let q_tm = @hol|{q:bool}|
  // Recursive normalization needs the local definition before its first use.
  fun NNF_DCONV(cf):
    fun(baseconvs):
      fun(tm):
        match tm
        | Comb(Comb(Const("/\\",_),l),r):
            let [th_lp, th_ln] = NNF_DCONV(cf)(baseconvs)(l)
            let [th_rp, th_rn] = NNF_DCONV(cf)(baseconvs)(r)
            [
              MK_COMB([AP_TERM(and_tm)(th_lp), th_rp]),
              TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_not_and))(MK_COMB([AP_TERM(or_tm)(th_ln), th_rn]))
            ]
        | Comb(Comb(Const("\\/",_),l),r):
            let [th_lp, th_ln] = NNF_DCONV(cf)(baseconvs)(l)
            let [th_rp, th_rn] = NNF_DCONV(cf)(baseconvs)(r)
            [
              MK_COMB([AP_TERM(or_tm)(th_lp), th_rp]),
              TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_not_or))(MK_COMB([AP_TERM(and_tm)(th_ln), th_rn]))
            ]
        | Comb(Comb(Const("==>",_),l),r):
            let [th_lp, th_ln] = NNF_DCONV(cf)(baseconvs)(l)
            let [th_rp, th_rn] = NNF_DCONV(cf)(baseconvs)(r)
            [
              TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_imp))(MK_COMB([AP_TERM(or_tm)(th_ln), th_rp])),
              TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_not_imp))(MK_COMB([AP_TERM(and_tm)(th_lp), th_rn]))
            ]
        | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",_), & _])),l),r):
            let [th_lp, th_ln] = NNF_DCONV(cf)(baseconvs)(l)
            let [th_rp, th_rn] = NNF_DCONV(cf)(baseconvs)(r)
            if cf
            | [
                TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_eq_prime))(
                  MK_COMB(
                    [
                      AP_TERM(and_tm)(MK_COMB([AP_TERM(or_tm)(th_lp), th_rn])),
                      MK_COMB([AP_TERM(or_tm)(th_ln), th_rp])
                    ]
                  )
                ),
                TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_not_eq_prime))(
                  MK_COMB(
                    [
                      AP_TERM(and_tm)(MK_COMB([AP_TERM(or_tm)(th_lp), th_rp])),
                      MK_COMB([AP_TERM(or_tm)(th_ln), th_rn])
                    ]
                  )
                )
              ]
            | [
                TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_eq))(
                  MK_COMB(
                    [
                      AP_TERM(or_tm)(MK_COMB([AP_TERM(and_tm)(th_lp), th_rp])),
                      MK_COMB([AP_TERM(and_tm)(th_ln), th_rn])
                    ]
                  )
                ),
                TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_not_eq))(
                  MK_COMB(
                    [
                      AP_TERM(or_tm)(MK_COMB([AP_TERM(and_tm)(th_lp), th_rn])),
                      MK_COMB([AP_TERM(and_tm)(th_ln), th_rp])
                    ]
                  )
                )
              ]
        | Comb(Const("!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])) as q,Abs(x,t) as bod):
            let [th_p, th_n] = NNF_DCONV(#true)(baseconvs)(t)
            let th1 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_forall))
            let th2 = TRANS(AP_TERM(not_tm)(BETA(mk_comb([bod, x]))))(th_n)
            [AP_TERM(q)(ABS(x)(th_p)), TRANS(th1)(MK_EXISTS(x)(th2))]
        | Comb(Const("?",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])) as q,Abs(x,t) as bod):
            let [th_p, th_n] = NNF_DCONV(cf)(baseconvs)(t)
            let th1 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_exists))
            let th2 = TRANS(AP_TERM(not_tm)(BETA(mk_comb([bod, x]))))(th_n)
            [AP_TERM(q)(ABS(x)(th_p)), TRANS(th1)(MK_FORALL(x)(th2))]
        | Comb(Const("?!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])),Abs(x,t) as bod):
            let y = variant(PairList [x, & frees(t)])(x)
            let [th_p, th_n] = NNF_DCONV(cf)(baseconvs)(t)
            let eq = mk_eq([y, x])
            let [eth_p, eth_n] = baseconvs(eq)
            let bth = BETA(mk_comb([bod, x]))
            let bth_prime = BETA_CONV(mk_comb([bod, y]))
            let th_p_prime = INST(PairList [[y, x]])(th_p)
            let th_n_prime = INST(PairList [[y, x]])(th_n)
            let th1 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_exu))
            let th1_prime = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_exu))
            let th2:
              MK_COMB(
                [
                  AP_TERM(and_tm)(MK_EXISTS(x)(TRANS(bth)(th_p))),
                  MK_FORALL(x)(
                    MK_FORALL(y)(
                      MK_COMB(
                        [
                          AP_TERM(or_tm)(TRANS(AP_TERM(not_tm)(bth))(th_n)),
                          MK_COMB(
                            [
                              AP_TERM(or_tm)(TRANS(AP_TERM(not_tm)(bth_prime))(th_n_prime)),
                              eth_p
                            ]
                          )
                        ]
                      )
                    )
                  )
                ]
              )
            let th2_prime:
              MK_COMB(
                [
                  AP_TERM(or_tm)(MK_FORALL(x)(TRANS(AP_TERM(not_tm)(bth))(th_n))),
                  MK_EXISTS(x)(
                    MK_EXISTS(y)(
                      MK_COMB(
                        [
                          AP_TERM(and_tm)(TRANS(bth)(th_p)),
                          MK_COMB([AP_TERM(and_tm)(TRANS(bth_prime)(th_p_prime)), eth_n])
                        ]
                      )
                    )
                  )
                ]
              )
            [TRANS(th1)(th2), TRANS(th1_prime)(th2_prime)]
        | Comb(Const("~",_),t):
            let [th1, th2] = NNF_DCONV(cf)(baseconvs)(t)
            [th2, TRANS(INST(PairList [[t, p_tm]])(pth_not_not))(th1)]
        | _:
            try:
              baseconvs(tm)
              ~catch exn:
                match exn
                | Failure(_): [REFL(tm), REFL(mk_neg(tm))]
                | exn: (throw exn)
  // Mutually recursive normalization needs local definitions for forward references.
  fun NNF_CONV(cf):
    fun([base1, base2] as baseconvs):
      fun(tm):
        match tm
        | Comb(Comb(Const("/\\",_),l),r):
            let th_lp = NNF_CONV(cf)(baseconvs)(l)
            let th_rp = NNF_CONV(cf)(baseconvs)(r)
            MK_COMB([AP_TERM(and_tm)(th_lp), th_rp])
        | Comb(Comb(Const("\\/",_),l),r):
            let th_lp = NNF_CONV(cf)(baseconvs)(l)
            let th_rp = NNF_CONV(cf)(baseconvs)(r)
            MK_COMB([AP_TERM(or_tm)(th_lp), th_rp])
        | Comb(Comb(Const("==>",_),l),r):
            let th_ln = NNF_CONV_prime(cf)(baseconvs)(l)
            let th_rp = NNF_CONV(cf)(baseconvs)(r)
            TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_imp))(MK_COMB([AP_TERM(or_tm)(th_ln), th_rp]))
        | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",_), & _])),l),r):
            let [th_lp, th_ln] = NNF_DCONV(cf)(base2)(l)
            let [th_rp, th_rn] = NNF_DCONV(cf)(base2)(r)
            if cf
            | TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_eq_prime))(
                MK_COMB(
                  [
                    AP_TERM(and_tm)(MK_COMB([AP_TERM(or_tm)(th_lp), th_rn])),
                    MK_COMB([AP_TERM(or_tm)(th_ln), th_rp])
                  ]
                )
              )
            | TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_eq))(
                MK_COMB(
                  [
                    AP_TERM(or_tm)(MK_COMB([AP_TERM(and_tm)(th_lp), th_rp])),
                    MK_COMB([AP_TERM(and_tm)(th_ln), th_rn])
                  ]
                )
              )
        | Comb(Const("!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])) as q,Abs(x,t)):
            let th_p = NNF_CONV(#true)(baseconvs)(t)
            AP_TERM(q)(ABS(x)(th_p))
        | Comb(Const("?",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])) as q,Abs(x,t)):
            let th_p = NNF_CONV(cf)(baseconvs)(t)
            AP_TERM(q)(ABS(x)(th_p))
        | Comb(Const("?!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])),Abs(x,t) as bod):
            let y = variant(PairList [x, & frees(t)])(x)
            let [th_p, th_n] = NNF_DCONV(cf)(base2)(t)
            let eq = mk_eq([y, x])
            let [eth_p, eth_n] = base2(eq)
            let bth = BETA(mk_comb([bod, x]))
            let bth_prime = BETA_CONV(mk_comb([bod, y]))
            let th_n_prime = INST(PairList [[y, x]])(th_n)
            let th1 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_exu))
            let th2:
              MK_COMB(
                [
                  AP_TERM(and_tm)(MK_EXISTS(x)(TRANS(bth)(th_p))),
                  MK_FORALL(x)(
                    MK_FORALL(y)(
                      MK_COMB(
                        [
                          AP_TERM(or_tm)(TRANS(AP_TERM(not_tm)(bth))(th_n)),
                          MK_COMB(
                            [
                              AP_TERM(or_tm)(TRANS(AP_TERM(not_tm)(bth_prime))(th_n_prime)),
                              eth_p
                            ]
                          )
                        ]
                      )
                    )
                  )
                ]
              )
            TRANS(th1)(th2)
        | Comb(Const("~",_),t): NNF_CONV_prime(cf)(baseconvs)(t)
        | _:
            try:
              base1(tm)
              ~catch exn:
                match exn
                | Failure(_): REFL(tm)
                | exn: (throw exn)
  // Mutually recursive normalization needs both local definitions before use.
  fun NNF_CONV_prime(cf):
    fun([base1, base2] as baseconvs):
      fun(tm):
        match tm
        | Comb(Comb(Const("/\\",_),l),r):
            let th_ln = NNF_CONV_prime(cf)(baseconvs)(l)
            let th_rn = NNF_CONV_prime(cf)(baseconvs)(r)
            TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_not_and))(MK_COMB([AP_TERM(or_tm)(th_ln), th_rn]))
        | Comb(Comb(Const("\\/",_),l),r):
            let th_ln = NNF_CONV_prime(cf)(baseconvs)(l)
            let th_rn = NNF_CONV_prime(cf)(baseconvs)(r)
            TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_not_or))(MK_COMB([AP_TERM(and_tm)(th_ln), th_rn]))
        | Comb(Comb(Const("==>",_),l),r):
            let th_lp = NNF_CONV(cf)(baseconvs)(l)
            let th_rn = NNF_CONV_prime(cf)(baseconvs)(r)
            TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_not_imp))(MK_COMB([AP_TERM(and_tm)(th_lp), th_rn]))
        | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",_), & _])),l),r):
            let [th_lp, th_ln] = NNF_DCONV(cf)(base2)(l)
            let [th_rp, th_rn] = NNF_DCONV(cf)(base2)(r)
            if cf
            | TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_not_eq_prime))(
                MK_COMB(
                  [
                    AP_TERM(and_tm)(MK_COMB([AP_TERM(or_tm)(th_lp), th_rp])),
                    MK_COMB([AP_TERM(or_tm)(th_ln), th_rn])
                  ]
                )
              )
            | TRANS(INST(PairList [[l, p_tm], [r, q_tm]])(pth_not_eq))(
                MK_COMB(
                  [
                    AP_TERM(or_tm)(MK_COMB([AP_TERM(and_tm)(th_lp), th_rn])),
                    MK_COMB([AP_TERM(and_tm)(th_ln), th_rp])
                  ]
                )
              )
        | Comb(Const("!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])),Abs(x,t) as bod):
            let th_n = NNF_CONV_prime(cf)(baseconvs)(t)
            let th1 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_forall))
            let th2 = TRANS(AP_TERM(not_tm)(BETA(mk_comb([bod, x]))))(th_n)
            TRANS(th1)(MK_EXISTS(x)(th2))
        | Comb(Const("?",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])),Abs(x,t) as bod):
            let th_n = NNF_CONV_prime(#true)(baseconvs)(t)
            let th1 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_exists))
            let th2 = TRANS(AP_TERM(not_tm)(BETA(mk_comb([bod, x]))))(th_n)
            TRANS(th1)(MK_FORALL(x)(th2))
        | Comb(Const("?!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])),Abs(x,t) as bod):
            let y = variant(PairList [x, & frees(t)])(x)
            let [th_p, th_n] = NNF_DCONV(cf)(base2)(t)
            let eq = mk_eq([y, x])
            let [eth_p, eth_n] = base2(eq)
            let bth = BETA(mk_comb([bod, x]))
            let bth_prime = BETA_CONV(mk_comb([bod, y]))
            let th_p_prime = INST(PairList [[y, x]])(th_p)
            let th1_prime = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_exu))
            let th2_prime:
              MK_COMB(
                [
                  AP_TERM(or_tm)(MK_FORALL(x)(TRANS(AP_TERM(not_tm)(bth))(th_n))),
                  MK_EXISTS(x)(
                    MK_EXISTS(y)(
                      MK_COMB(
                        [
                          AP_TERM(and_tm)(TRANS(bth)(th_p)),
                          MK_COMB([AP_TERM(and_tm)(TRANS(bth_prime)(th_p_prime)), eth_n])
                        ]
                      )
                    )
                  )
                ]
              )
            TRANS(th1_prime)(th2_prime)
        | Comb(Const("~",_),t):
            let th1 = NNF_CONV(cf)(baseconvs)(t)
            TRANS(INST(PairList [[t, p_tm]])(pth_not_not))(th1)
        | _:
            let tm_prime = mk_neg(tm)
            try:
              base1(tm_prime)
              ~catch exn:
                match exn
                | Failure(_): REFL(tm_prime)
                | exn: (throw exn)
  NNF_CONV

def NNF_CONV = GEN_NNF_CONV(#false)([ALL_CONV, (fun(t): [REFL(t), REFL(mk_neg(t))])])

def NNFC_CONV = GEN_NNF_CONV(#true)([ALL_CONV, (fun(t): [REFL(t), REFL(mk_neg(t))])])

def SKOLEM_CONV:
  (
    GEN_REWRITE_CONV(
      TOP_DEPTH_CONV)(
      PairList [
        EXISTS_OR_THM,
        LEFT_EXISTS_AND_THM,
        RIGHT_EXISTS_AND_THM,
        FORALL_AND_THM,
        LEFT_FORALL_OR_THM,
        RIGHT_FORALL_OR_THM,
        FORALL_SIMP,
        EXISTS_SIMP
      ]
    ) then_conv \
    GEN_REWRITE_CONV(
      REDEPTH_CONV)(
      PairList [
        RIGHT_AND_EXISTS_THM,
        LEFT_AND_EXISTS_THM,
        OR_EXISTS_THM,
        RIGHT_OR_EXISTS_THM,
        LEFT_OR_EXISTS_THM,
        SKOLEM_THM
      ]
    )
  )

def PRENEX_CONV:
  GEN_REWRITE_CONV(
    REDEPTH_CONV)(
    PairList [
      AND_FORALL_THM,
      LEFT_AND_FORALL_THM,
      RIGHT_AND_FORALL_THM,
      LEFT_OR_FORALL_THM,
      RIGHT_OR_FORALL_THM,
      OR_EXISTS_THM,
      LEFT_OR_EXISTS_THM,
      RIGHT_OR_EXISTS_THM,
      LEFT_AND_EXISTS_THM,
      RIGHT_AND_EXISTS_THM
    ]
  )

def [canon_WEAK_DNF_CONV_v2, DNF_CONV]:
  let pth1:
    TAUT(
      @hol|{a /\ (b \/ c) <=> a /\ b \/ a /\ c}|
    )
  let pth2:
    TAUT(
      @hol|{(a \/ b) /\ c <=> a /\ c \/ b /\ c}|
    )
  let a_tm = @hol|{a:bool}|
  let b_tm = @hol|{b:bool}|
  let c_tm = @hol|{c:bool}|
  fun distribute(tm):
    match tm
    | Comb(Comb(Const("/\\",_),a),Comb(Comb(Const("\\/",_),b),c)):
        let th = INST(PairList [[a, a_tm], [b, b_tm], [c, c_tm]])(pth1)
        TRANS(th)(BINOP_CONV(distribute)(rand(concl(th))))
    | Comb(Comb(Const("/\\",_),Comb(Comb(Const("\\/",_),a),b)),c):
        let th = INST(PairList [[a, a_tm], [b, b_tm], [c, c_tm]])(pth2)
        TRANS(th)(BINOP_CONV(distribute)(rand(concl(th))))
    | _: REFL(tm)
  let strengthen:
    (
      DEPTH_BINOP_CONV(@hol|{(\/)}|)(CONJ_CANON_CONV) then_conv \
      DISJ_CANON_CONV
    )
  fun weakdnf(tm):
    match tm
    | Comb(Const("!",_),Abs(_,_)): BINDER_CONV(weakdnf)(tm)
    | Comb(Const("?",_),Abs(_,_)): BINDER_CONV(weakdnf)(tm)
    | Comb(Comb(Const("\\/",_),_),_): BINOP_CONV(weakdnf)(tm)
    | Comb(Comb(Const("/\\",_) as op,l),r):
        let th = MK_COMB([AP_TERM(op)(weakdnf(l)), weakdnf(r)])
        TRANS(th)(distribute(rand(concl(th))))
    | _: REFL(tm)
  fun substrongdnf(tm):
    match tm
    | Comb(Const("!",_),Abs(_,_)): BINDER_CONV(strongdnf)(tm)
    | Comb(Const("?",_),Abs(_,_)): BINDER_CONV(strongdnf)(tm)
    | Comb(Comb(Const("\\/",_),_),_): BINOP_CONV(substrongdnf)(tm)
    | Comb(Comb(Const("/\\",_) as op,l),r):
        let th = MK_COMB([AP_TERM(op)(substrongdnf(l)), substrongdnf(r)])
        TRANS(th)(distribute(rand(concl(th))))
    | _: REFL(tm)
  fun strongdnf(tm):
    let th = substrongdnf(tm)
    TRANS(th)(strengthen(rand(concl(th))))
  [weakdnf, strongdnf]

def [canon_WEAK_CNF_CONV_v2, CNF_CONV]:
  let pth1:
    TAUT(
      @hol|{a \/ (b /\ c) <=> (a \/ b) /\ (a \/ c)}|
    )
  let pth2:
    TAUT(
      @hol|{(a /\ b) \/ c <=> (a \/ c) /\ (b \/ c)}|
    )
  let a_tm = @hol|{a:bool}|
  let b_tm = @hol|{b:bool}|
  let c_tm = @hol|{c:bool}|
  fun distribute(tm):
    match tm
    | Comb(Comb(Const("\\/",_),a),Comb(Comb(Const("/\\",_),b),c)):
        let th = INST(PairList [[a, a_tm], [b, b_tm], [c, c_tm]])(pth1)
        TRANS(th)(BINOP_CONV(distribute)(rand(concl(th))))
    | Comb(Comb(Const("\\/",_),Comb(Comb(Const("/\\",_),a),b)),c):
        let th = INST(PairList [[a, a_tm], [b, b_tm], [c, c_tm]])(pth2)
        TRANS(th)(BINOP_CONV(distribute)(rand(concl(th))))
    | _: REFL(tm)
  let strengthen:
    (
      DEPTH_BINOP_CONV(@hol|{(/\)}|)(DISJ_CANON_CONV) then_conv \
      CONJ_CANON_CONV
    )
  fun weakcnf(tm):
    match tm
    | Comb(Const("!",_),Abs(_,_)): BINDER_CONV(weakcnf)(tm)
    | Comb(Const("?",_),Abs(_,_)): BINDER_CONV(weakcnf)(tm)
    | Comb(Comb(Const("/\\",_),_),_): BINOP_CONV(weakcnf)(tm)
    | Comb(Comb(Const("\\/",_) as op,l),r):
        let th = MK_COMB([AP_TERM(op)(weakcnf(l)), weakcnf(r)])
        TRANS(th)(distribute(rand(concl(th))))
    | _: REFL(tm)
  fun substrongcnf(tm):
    match tm
    | Comb(Const("!",_),Abs(_,_)): BINDER_CONV(strongcnf)(tm)
    | Comb(Const("?",_),Abs(_,_)): BINDER_CONV(strongcnf)(tm)
    | Comb(Comb(Const("/\\",_),_),_): BINOP_CONV(substrongcnf)(tm)
    | Comb(Comb(Const("\\/",_) as op,l),r):
        let th = MK_COMB([AP_TERM(op)(substrongcnf(l)), substrongcnf(r)])
        TRANS(th)(distribute(rand(concl(th))))
    | _: REFL(tm)
  fun strongcnf(tm):
    let th = substrongcnf(tm)
    TRANS(th)(strengthen(rand(concl(th))))
  [weakcnf, strongcnf]

fun ASSOC_CONV(th):
  let th_prime = SYM(SPEC_ALL(th))
  let [opx, yopz] = dest_comb(rhs(concl(th_prime)))
  let [op, x] = dest_comb(opx)
  let y = lhand(yopz)
  let z = rand(yopz)
  fun distrib(tm):
    match tm
    | Comb(Comb(op_prime,Comb(Comb(op_prime_prime,p),q)),r):
        if ((op_prime == op) && (op_prime_prime == op))
        | let th1 = INST(PairList [[p, x], [q, y], [r, z]])(th_prime)
          let [l, r_prime] = dest_comb(rand(concl(th1)))
          let th2 = AP_TERM(l)(distrib(r_prime))
          let th3 = distrib(rand(concl(th2)))
          TRANS(th1)(TRANS(th2)(th3))
        | match tm
          | _: REFL(tm)
    | _: REFL(tm)
  fun assoc(tm):
    match tm
    | Comb(Comb(op_prime,p) as l,q):
        if (op_prime == op)
        | let th = AP_TERM(l)(assoc(q))
          TRANS(th)(distrib(rand(concl(th))))
        | match tm
          | _: REFL(tm)
    | _: REFL(tm)
  assoc

def SELECT_ELIM_TAC:
  let pth:
    prove(
      [
        @hol|{(P:A->bool)((@) P) <=> (?) P}|,
        REWRITE_TAC(PairList [EXISTS_THM]) then_tac BETA_TAC then_tac \
        REFL_TAC
      ]
    )
  let ptm = @hol|{P:A->bool}|
  let SELECT_ELIM_THM:
    fun(tm):
      let [stm, atm] = dest_comb(tm)
      if (is_const(stm) && (fst(dest_const(stm)) == "@"))
      | CONV_RULE(LAND_CONV(BETA_CONV))(
          PINST(PairList [[type_of(bndvar(atm)), aty]])(PairList [[atm, ptm]])(pth)
        )
      | failwith("SELECT_ELIM_THM: not a select-term")
  let SELECT_ELIM_CONV = (fun(tm): PURE_REWRITE_CONV(map(SELECT_ELIM_THM)(find_terms(is_select)(tm)))(tm))
  let pth = ISPEC(@hol|{P:A->bool}|)(SELECT_AX)
  let ptm = @hol|{P:A->bool}|
  let SELECT_AX_THM:
    fun(tm):
      let [stm, atm] = dest_comb(tm)
      if (is_const(stm) && (fst(dest_const(stm)) == "@"))
      | let fvs = frees(atm)
        let th1 = PINST(PairList [[type_of(bndvar(atm)), aty]])(PairList [[atm, ptm]])(pth)
        let th2 = CONV_RULE(BINDER_CONV(BINOP_CONV(BETA_CONV)))(th1)
        GENL(fvs)(th2)
      | failwith("SELECT_AX_THM: not a select-term")
  let SELECT_ELIM_ICONV:
    fun(tm):
      let t = find_term(is_select)(tm)
      let th1 = SELECT_AX_THM(t)
      let itm = mk_imp([concl(th1), tm])
      let th2 = DISCH_ALL(MP(ASSUME(itm))(th1))
      let fvs = frees(t)
      let fty = itlist(o(mk_fun_ty)(type_of))(fvs)(type_of(t))
      let fn = genvar(fty)
      let atm = list_mk_abs([fvs, t])
      let rawdef = mk_eq([fn, atm])
      let hol_def_2 = GENL(fvs)(SYM(RIGHT_BETAS(fvs)(ASSUME(rawdef))))
      let th3 = PURE_REWRITE_CONV(PairList [hol_def_2])(lhand(concl(th2)))
      let gtm = mk_forall([fn, rand(concl(th3))])
      let th4 = EQ_MP(SYM(th3))(SPEC(fn)(ASSUME(gtm)))
      let th5 = IMP_TRANS(DISCH(gtm)(th4))(th2)
      MP(INST(PairList [[atm, fn]])(DISCH(rawdef)(th5)))(REFL(atm))
  fun SELECT_ELIMS_ICONV(tm):
    try:
      let th = SELECT_ELIM_ICONV(tm)
      let tm_prime = lhand(concl(th))
      IMP_TRANS(SELECT_ELIMS_ICONV(tm_prime))(th)
      ~catch exn:
        match exn
        | Failure(_): DISCH(tm)(ASSUME(tm))
        | exn: (throw exn)
  let SELECT_ELIM_ICONV = SELECT_ELIMS_ICONV
  (
    CONV_TAC(SELECT_ELIM_CONV) then_tac \
    W(o(o(MATCH_MP_TAC)(SELECT_ELIM_ICONV))(snd))
  )

def LAMBDA_ELIM_CONV:
  let HALF_MK_ABS_CONV:
    let pth:
      prove([@hol|{(s = \x. t x) <=> (!x. s x = t x)}|,
             REWRITE_TAC(PairList [FUN_EQ_THM])])
    fun conv(vs):
      fun(tm):
        if vs == PairList []
        | REFL(tm)
        | (GEN_REWRITE_CONV(I)(PairList [pth]) then_conv BINDER_CONV(conv(tl(vs))))(tm)
    conv
  fun find_lambda(tm):
    if is_abs(tm)
    | tm
    | if (is_var(tm) || is_const(tm))
      | failwith("find_lambda")
      | if is_abs(tm)
        | tm
        | if (is_forall(tm) || (is_exists(tm) || is_uexists(tm)))
          | find_lambda(body(rand(tm)))
          | let [l, r] = dest_comb(tm)
            try:
              find_lambda(l)
              ~catch exn:
                match exn
                | Failure(_): find_lambda(r)
                | exn: (throw exn)
  // Recursive lambda elimination needs the local definition before its first use.
  fun ELIM_LAMBDA(conv):
    fun(tm):
      try:
        conv(tm)
        ~catch exn:
          match exn
          | Failure(_):
              if is_abs(tm)
              | ABS_CONV(ELIM_LAMBDA(conv))(tm)
              | if (is_var(tm) || is_const(tm))
                | REFL(tm)
                | (if (is_forall(tm) || (is_exists(tm) || is_uexists(tm))) | BINDER_CONV(ELIM_LAMBDA(conv))(tm) | COMB_CONV(ELIM_LAMBDA(conv))(tm))
          | exn: (throw exn)
  let pth:
    prove(
      [
        @hol|{(!a. (a = c) ==> (P = Q a)) ==> (P <=> !a. (a = c) ==> Q a)}|,
        SIMP_TAC(PairList [LEFT_FORALL_IMP_THM, EXISTS_REFL])
      ]
    )
  let APPLY_PTH = MATCH_MP(pth)
  let LAMB1_CONV:
    fun(tm):
      let atm = find_lambda(tm)
      let [v, bod] = dest_abs(atm)
      let vs = frees(atm)
      let vs_prime = append(vs)(PairList [v])
      let aatm = list_mk_abs([vs, atm])
      let f = genvar(type_of(aatm))
      let eq = mk_eq([f, aatm])
      let th1 = SYM(RIGHT_BETAS(vs)(ASSUME(eq)))
      let th2 = ELIM_LAMBDA(GEN_REWRITE_CONV(I)(PairList [th1]))(tm)
      let th3 = APPLY_PTH(GEN(f)(DISCH_ALL(th2)))
      CONV_RULE(RAND_CONV(BINDER_CONV(LAND_CONV(HALF_MK_ABS_CONV(vs_prime)))))(th3)
  fun conv(tm):
    try:
      (LAMB1_CONV then_conv conv)(tm)
      ~catch exn:
        match exn
        | Failure(_): REFL(tm)
        | exn: (throw exn)
  conv

def [canon_CONDS_ELIM_CONV_v2, CONDS_CELIM_CONV]:
  let th_cond:
    prove(
      [
        @hol|{((b <=> F) ==> x = x0) /\ ((b <=> T) ==> x = x1)
           ==> x = (b /\ x1 \/ ~b /\ x0)}|,
        BOOL_CASES_TAC(@hol|{b:bool}|) then_tac ASM_REWRITE_TAC(PairList [])
      ]
    )
  let th_cond_prime:
    prove(
      [
        @hol|{((b <=> F) ==> x = x0) /\ ((b <=> T) ==> x = x1)
           ==> x = ((~b \/ x1) /\ (b \/ x0))}|,
        BOOL_CASES_TAC(@hol|{b:bool}|) then_tac ASM_REWRITE_TAC(PairList [])
      ]
    )
  let propsimps = basic_net(#void)
  let false_tm = @hol|{F}|
  let true_tm = @hol|{T}|
  let match_th = MATCH_MP(th_cond)
  let match_th_prime = MATCH_MP(th_cond_prime)
  let propsimp_conv = DEPTH_CONV(REWRITES_CONV(propsimps))
  let cnv = TRY_CONV(REWRITES_CONV(propsimps))
  let proptsimp_conv = (BINOP_CONV(cnv) then_conv cnv)
  // Recursive conditional search needs the local definition before its first use.
  fun find_conditional(fvs):
    fun(tm):
      match tm
      | Comb(s,t):
          if (is_cond(tm) && (intersect(frees(lhand(s)))(fvs) == (PairList [])))
          | tm
          | try:
              find_conditional(fvs)(s)
              ~catch exn:
                match exn
                | Failure(_): find_conditional(fvs)(t)
                | exn: (throw exn)
      | Abs(x,t): find_conditional(PairList [x, & fvs])(t)
      | _: failwith("find_conditional")
  // Recursive conversion needs the local definition before its first use.
  fun CONDS_ELIM_CONV(dfl):
    fun(tm):
      try:
        let t = find_conditional(PairList [])(tm)
        let p = lhand(rator(t))
        let th_new:
          if ((p == false_tm) || (p == true_tm))
          | propsimp_conv(tm)
          | let asm_0 = mk_eq([p, false_tm])
            let asm_1 = mk_eq([p, true_tm])
            let simp_0 = net_of_thm(#false)(ASSUME(asm_0))(propsimps)
            let simp_1 = net_of_thm(#false)(ASSUME(asm_1))(propsimps)
            let th_0 = DISCH(asm_0)(DEPTH_CONV(REWRITES_CONV(simp_0))(tm))
            let th_1 = DISCH(asm_1)(DEPTH_CONV(REWRITES_CONV(simp_1))(tm))
            let th_2 = CONJ(th_0)(th_1)
            let th_3 = (if dfl | match_th(th_2) | match_th_prime(th_2))
            TRANS(th_3)(proptsimp_conv(rand(concl(th_3))))
        CONV_RULE(RAND_CONV(CONDS_ELIM_CONV(dfl)))(th_new)
        ~catch exn:
          match exn
          | Failure(_):
              if is_neg(tm)
              | RAND_CONV(CONDS_ELIM_CONV(!dfl))(tm)
              | if (is_conj(tm) || is_disj(tm))
                | BINOP_CONV(CONDS_ELIM_CONV(dfl))(tm)
                | if (is_imp(tm) || is_iff(tm))
                  | COMB2_CONV(RAND_CONV(CONDS_ELIM_CONV(!dfl)))(CONDS_ELIM_CONV(dfl))(tm)
                  | if is_forall(tm)
                    | BINDER_CONV(CONDS_ELIM_CONV(#false))(tm)
                    | (if (is_exists(tm) || is_uexists(tm)) | BINDER_CONV(CONDS_ELIM_CONV(#true))(tm) | REFL(tm))
          | exn: (throw exn)
  [CONDS_ELIM_CONV(#true), CONDS_ELIM_CONV(#false)]

def ASM_FOL_TAC:
  // Recursive head collection needs the local definition before its first use.
  fun get_heads(lconsts):
    fun(tm):
      fun([cheads, vheads] as sofar):
        try:
          let [v, bod] = dest_forall(tm)
          get_heads(subtract(lconsts)(PairList [v]))(bod)(sofar)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  let [l, r]:
                    try:
                      dest_conj(tm)
                      ~catch exn:
                        match exn
                        | Failure(_): dest_disj(tm)
                        | exn: (throw exn)
                  get_heads(lconsts)(l)(get_heads(lconsts)(r)(sofar))
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let tm_prime = dest_neg(tm)
                          get_heads(lconsts)(tm_prime)(sofar)
                          ~catch exn:
                            match exn
                            | Failure(_):
                                let [hop, args] = strip_comb(tm)
                                let len = length(args)
                                let newheads:
                                  if (is_const(hop) || mem(hop)(lconsts))
                                  | [insert([hop, len])(cheads), vheads]
                                  | (if (len > 0) | [cheads, insert([hop, len])(vheads)] | sofar)
                                itlist(get_heads(lconsts))(args)(newheads)
                            | exn: (throw exn)
                    | exn: (throw exn)
            | exn: (throw exn)
  let get_thm_heads = fun(th): fun(sofar): get_heads(freesl(hyp(th)))(concl(th))(sofar)
  let th:
    prove(
      [
        @hol|{!(f:A->B) x. f x = I f x}|,
        REWRITE_TAC(PairList [I_THM])
      ]
    )
  let APP_CONV = REWR_CONV(th)
  // Recursive application conversion needs the local definition before its first use.
  fun APP_N_CONV(n): fun(tm): (if (n == 1) | APP_CONV(tm) | (RATOR_CONV(APP_N_CONV((n - 1))) then_conv APP_CONV)(tm))
  // Recursive formula conversion needs the local definition before its first use.
  fun FOL_CONV(hddata):
    fun(tm):
      if is_forall(tm)
      | BINDER_CONV(FOL_CONV(hddata))(tm)
      | if (is_conj(tm) || is_disj(tm))
        | BINOP_CONV(FOL_CONV(hddata))(tm)
        | let [op, args] = strip_comb(tm)
          let th = rev_itlist(C(curry(MK_COMB)))(map(FOL_CONV(hddata))(args))(REFL(op))
          let tm_prime = rand(concl(th))
          let n:
            try:
              (length(args) - assoc(op)(hddata))
              ~catch exn:
                match exn
                | Failure(_): 0
                | exn: (throw exn)
          (if (n == 0) | th | TRANS(th)(APP_N_CONV(n)(tm_prime)))
  let GEN_FOL_CONV:
    fun([cheads, vheads]):
      let hddata:
        if (vheads == (PairList []))
        | let hops = setify(map(fst)(cheads))
          let getmin:
            fun(h):
              let ns = mapfilter((fun([k, n]): (if (k == h) | n | fail(#void))))(cheads)
              (if (length(ns) < 2) | fail(#void) | [h, end_itlist(hol_min)(ns)])
          mapfilter(getmin)(hops)
        | map(
            (fun(t): (if (is_const(t) && (fst(dest_const(t)) == "=")) | [t, 2] | [t, 0]))
          )(setify(map(fst)(append(vheads)(cheads))))
      FOL_CONV(hddata)
  fun([asl, w] as gl):
    let headsp = itlist(o(get_thm_heads)(snd))(asl)([PairList [], PairList []])
    RULE_ASSUM_TAC(CONV_RULE(GEN_FOL_CONV(headsp)))(gl)

fun PROP_ATOM_CONV(conv):
  fun(tm):
    match tm
    | Comb(Const("!",_),Abs(_,_)): BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Const("?",_),Abs(_,_)): BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Const("?!",_),Abs(_,_)): BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Comb(Const("/\\",_),_),_): BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Comb(Const("\\/",_),_),_): BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Comb(Const("==>",_),_),_): BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",PairList []), & PairList [_, & PairList []]])),_),_): BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Comb(Const("~",_),_): RAND_CONV(PROP_ATOM_CONV(conv))(tm)
    | _: TRY_CONV(conv)(tm)

def WEAK_DNF_CONV = canon_WEAK_DNF_CONV_v2

def WEAK_CNF_CONV = canon_WEAK_CNF_CONV_v2

def CONDS_ELIM_CONV = canon_CONDS_ELIM_CONV_v2
