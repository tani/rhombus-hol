fun ASSOC_CONV(th):
  let th_prime = Equal.SYM(Bool.SPEC_ALL(th))
  let [opx, yopz] = Fusion.dest_comb(Equal.rhs(Fusion.concl(th_prime)))
  let [op, x] = Fusion.dest_comb(opx)
  let y_5 = Equal.lhand(yopz)
  let z_2 = Fusion.rand(yopz)
  fun distrib(tm):
    match tm
    | Fusion.Comb(Fusion.Comb(op_prime,Fusion.Comb(Fusion.Comb(op_prime_prime,p),q)),r):
        if (Host.hol_equal(op_prime)(op) && Host.hol_equal(op_prime_prime)(op))
        | let th1 = Fusion.INST(PairList.cons([p, x], PairList.cons([q, y_5], PairList.cons([r, z_2], PairList []))))(th_prime)
          let [l, r_prime] = Fusion.dest_comb(Fusion.rand(Fusion.concl(th1)))
          let th2 = Equal.AP_TERM(l)(distrib(r_prime))
          let th3 = distrib(Fusion.rand(Fusion.concl(th2)))
          Fusion.TRANS(th1)(Fusion.TRANS(th2)(th3))
        | match tm
          | _: Fusion.REFL(tm)
    | _: Fusion.REFL(tm)
  fun assoc_2(tm):
    match tm
    | Fusion.Comb(Fusion.Comb(op_prime,p) as l,q):
        if Host.hol_equal(op_prime)(op)
        | let th = Equal.AP_TERM(l)(assoc_2(q))
          Fusion.TRANS(th)(distrib(Fusion.rand(Fusion.concl(th))))
        | match tm
          | _: Fusion.REFL(tm)
    | _: Fusion.REFL(tm)
  assoc_2

def SELECT_ELIM_TAC:
  let pth_3 = Tactics.prove([Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Var("P", Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])])), Comb(Const("@", Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]), Tyvar("A")])), Var("P", Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]))))), Comb(Const("?", Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]), Tyapp("bool", [])])), Var("P", Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]))))), Tactics.THEN(Tactics.THEN(Simp.REWRITE_TAC(PairList.cons(Class.EXISTS_THM, PairList [])))(Tactics.BETA_TAC))(Tactics.REFL_TAC)])
  let ptm_2 = Host.hol_term(Var("P", Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])])))
  let SELECT_ELIM_THM:
    fun(tm):
      let [stm, atm] = Fusion.dest_comb(tm)
      (if (Fusion.is_const(stm) && Host.hol_equal(fst(Fusion.dest_const(stm)))("@")) | Equal.CONV_RULE(Equal.LAND_CONV(Equal.BETA_CONV))(Bool.PINST(PairList.cons([Fusion.type_of(Basics.bndvar(atm)), Fusion.aty], PairList []))(PairList.cons([atm, ptm_2], PairList []))(pth_3)) | failwith("SELECT_ELIM_THM: not a select-term"))
  let SELECT_ELIM_CONV = (fun(tm): Simp.PURE_REWRITE_CONV(map(SELECT_ELIM_THM)(Basics.find_terms(Class.is_select)(tm)))(tm))
  let pth_4 = Bool.ISPEC(Host.hol_term(Var("P", Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]))))(Class.SELECT_AX)
  let ptm_3 = Host.hol_term(Var("P", Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])])))
  let SELECT_AX_THM:
    fun(tm):
      let [stm, atm] = Fusion.dest_comb(tm)
      if (Fusion.is_const(stm) && Host.hol_equal(fst(Fusion.dest_const(stm)))("@"))
      | let fvs = Fusion.frees(atm)
        let th1 = Bool.PINST(PairList.cons([Fusion.type_of(Basics.bndvar(atm)), Fusion.aty], PairList []))(PairList.cons([atm, ptm_3], PairList []))(pth_4)
        let th2 = Equal.CONV_RULE(Equal.BINDER_CONV(Equal.BINOP_CONV(Equal.BETA_CONV)))(th1)
        Bool.GENL(fvs)(th2)
      | failwith("SELECT_AX_THM: not a select-term")
  let SELECT_ELIM_ICONV:
    fun(tm):
      let t = Basics.find_term(Class.is_select)(tm)
      let th1 = SELECT_AX_THM(t)
      let itm = Bool.mk_imp([Fusion.concl(th1), tm])
      let th2 = Bool.DISCH_ALL(Bool.MP(Fusion.ASSUME(itm))(th1))
      let fvs = Fusion.frees(t)
      let fty = itlist(o(Fusion.mk_fun_ty)(Fusion.type_of))(fvs)(Fusion.type_of(t))
      let fn_2 = Basics.genvar(fty)
      let atm_2 = Basics.list_mk_abs([fvs, t])
      let rawdef = Fusion.mk_eq([fn_2, atm_2])
      let hol_def_2 = Bool.GENL(fvs)(Equal.SYM(IndDefs.RIGHT_BETAS(fvs)(Fusion.ASSUME(rawdef))))
      let th3 = Simp.PURE_REWRITE_CONV(PairList.cons(hol_def_2, PairList []))(Equal.lhand(Fusion.concl(th2)))
      let gtm = Bool.mk_forall([fn_2, Fusion.rand(Fusion.concl(th3))])
      let th4 = Fusion.EQ_MP(Equal.SYM(th3))(Bool.SPEC(fn_2)(Fusion.ASSUME(gtm)))
      let th5 = Bool.IMP_TRANS(Bool.DISCH(gtm)(th4))(th2)
      Bool.MP(Fusion.INST(PairList.cons([atm_2, fn_2], PairList []))(Bool.DISCH(rawdef)(th5)))(Fusion.REFL(atm_2))
  fun SELECT_ELIMS_ICONV(tm):
    try:
      let th = SELECT_ELIM_ICONV(tm)
      let tm_prime = Equal.lhand(Fusion.concl(th))
      Bool.IMP_TRANS(SELECT_ELIMS_ICONV(tm_prime))(th)
      ~catch exn:
        match exn
        | Failure(_): Bool.DISCH(tm)(Fusion.ASSUME(tm))
        | exn: Host.hol_raise(exn)
  let SELECT_ELIM_ICONV = SELECT_ELIMS_ICONV
  Tactics.THEN(Tactics.CONV_TAC(SELECT_ELIM_CONV))(W(o(o(Tactics.MATCH_MP_TAC)(SELECT_ELIM_ICONV))(snd)))

def LAMBDA_ELIM_CONV:
  let pth = Tactics.prove([Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("fun", [Tyvar("?3698"), Tyvar("?3694")]), Tyapp("fun", [Tyapp("fun", [Tyvar("?3698"), Tyvar("?3694")]), Tyapp("bool", [])])])), Var("s", Tyapp("fun", [Tyvar("?3698"), Tyvar("?3694")]))), Abs(Var("x", Tyvar("?3698")), Comb(Var("t", Tyapp("fun", [Tyvar("?3698"), Tyvar("?3694")])), Var("x", Tyvar("?3698")))))), Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyvar("?3698"), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("x", Tyvar("?3698")), Comb(Comb(Const("=", Tyapp("fun", [Tyvar("?3694"), Tyapp("fun", [Tyvar("?3694"), Tyapp("bool", [])])])), Comb(Var("s", Tyapp("fun", [Tyvar("?3698"), Tyvar("?3694")])), Var("x", Tyvar("?3698")))), Comb(Var("t", Tyapp("fun", [Tyvar("?3698"), Tyvar("?3694")])), Var("x", Tyvar("?3698")))))))), Simp.REWRITE_TAC(PairList.cons(Class.FUN_EQ_THM, PairList []))])
  fun conv(vs): (fun(tm): (if Host.hol_equal(vs)(PairList []) | Fusion.REFL(tm) | Equal.THENC(Simp.GEN_REWRITE_CONV(I)(PairList.cons(pth, PairList [])))(Equal.BINDER_CONV(conv(tl(vs))))(tm)))
  let HALF_MK_ABS_CONV = conv
  fun find_lambda(tm):
    if Fusion.is_abs(tm)
    | tm
    | if (Fusion.is_var(tm) || Fusion.is_const(tm))
      | failwith("find_lambda")
      | if Fusion.is_abs(tm)
        | tm
        | if (Basics.is_forall(tm) || (Basics.is_exists(tm) || Basics.is_uexists(tm)))
          | find_lambda(Basics.body(Fusion.rand(tm)))
          | let [l, r] = Fusion.dest_comb(tm)
            try:
              find_lambda(l)
              ~catch exn:
                match exn
                | Failure(_): find_lambda(r)
                | exn: Host.hol_raise(exn)
  fun ELIM_LAMBDA(conv):
    fun(tm):
      try:
        conv(tm)
        ~catch exn:
          match exn
          | Failure(_):
              if Fusion.is_abs(tm)
              | Equal.ABS_CONV(ELIM_LAMBDA(conv))(tm)
              | if (Fusion.is_var(tm) || Fusion.is_const(tm))
                | Fusion.REFL(tm)
                | (if (Basics.is_forall(tm) || (Basics.is_exists(tm) || Basics.is_uexists(tm))) | Equal.BINDER_CONV(ELIM_LAMBDA(conv))(tm) | Equal.COMB_CONV(ELIM_LAMBDA(conv))(tm))
          | exn: Host.hol_raise(exn)
  let pth = Tactics.prove([Host.hol_term(Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyvar("?3726"), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("a", Tyvar("?3726")), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyvar("?3726"), Tyapp("fun", [Tyvar("?3726"), Tyapp("bool", [])])])), Var("a", Tyvar("?3726"))), Var("c", Tyvar("?3726")))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("P", Tyapp("bool", []))), Comb(Var("Q", Tyapp("fun", [Tyvar("?3726"), Tyapp("bool", [])])), Var("a", Tyvar("?3726")))))))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("P", Tyapp("bool", []))), Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyvar("?3726"), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("a", Tyvar("?3726")), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyvar("?3726"), Tyapp("fun", [Tyvar("?3726"), Tyapp("bool", [])])])), Var("a", Tyvar("?3726"))), Var("c", Tyvar("?3726")))), Comb(Var("Q", Tyapp("fun", [Tyvar("?3726"), Tyapp("bool", [])])), Var("a", Tyvar("?3726"))))))))), Simp.SIMP_TAC(PairList.cons(Theorems.LEFT_FORALL_IMP_THM, PairList.cons(Theorems.EXISTS_REFL, PairList [])))])
  let APPLY_PTH = Drule.MATCH_MP(pth)
  let LAMB1_CONV:
    fun(tm):
      let atm = find_lambda(tm)
      let [v, bod] = Fusion.dest_abs(atm)
      let vs = Fusion.frees(atm)
      let vs_prime = append(vs)(PairList.cons(v, PairList []))
      let aatm = Basics.list_mk_abs([vs, atm])
      let f = Basics.genvar(Fusion.type_of(aatm))
      let eq = Fusion.mk_eq([f, aatm])
      let th1 = Equal.SYM(IndDefs.RIGHT_BETAS(vs)(Fusion.ASSUME(eq)))
      let th2 = ELIM_LAMBDA(Simp.GEN_REWRITE_CONV(I)(PairList.cons(th1, PairList [])))(tm)
      let th3 = APPLY_PTH(Bool.GEN(f)(Bool.DISCH_ALL(th2)))
      Equal.CONV_RULE(Equal.RAND_CONV(Equal.BINDER_CONV(Equal.LAND_CONV(HALF_MK_ABS_CONV(vs_prime)))))(th3)
  fun conv_2(tm):
    try:
      Equal.THENC(LAMB1_CONV)(conv_2)(tm)
      ~catch exn:
        match exn
        | Failure(_): Fusion.REFL(tm)
        | exn: Host.hol_raise(exn)
  conv_2

def [CONDS_ELIM_CONV, CONDS_CELIM_CONV]:
  let th_cond_2 = Tactics.prove([Host.hol_term(Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("b", Tyapp("bool", []))), Const("F", Tyapp("bool", [])))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("x", Tyapp("bool", []))), Var("x0", Tyapp("bool", []))))), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("b", Tyapp("bool", []))), Const("T", Tyapp("bool", [])))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("x", Tyapp("bool", []))), Var("x1", Tyapp("bool", [])))))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("x", Tyapp("bool", []))), Comb(Comb(Const("\\/", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("b", Tyapp("bool", []))), Var("x1", Tyapp("bool", [])))), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("~", Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])), Var("b", Tyapp("bool", [])))), Var("x0", Tyapp("bool", []))))))), Tactics.THEN(Class.BOOL_CASES_TAC(Host.hol_term(Var("b", Tyapp("bool", [])))))(Simp.ASM_REWRITE_TAC(PairList []))])
  let th_cond_prime_2 = Tactics.prove([Host.hol_term(Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("b", Tyapp("bool", []))), Const("F", Tyapp("bool", [])))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("x", Tyapp("bool", []))), Var("x0", Tyapp("bool", []))))), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("b", Tyapp("bool", []))), Const("T", Tyapp("bool", [])))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("x", Tyapp("bool", []))), Var("x1", Tyapp("bool", [])))))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("x", Tyapp("bool", []))), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("\\/", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("~", Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])), Var("b", Tyapp("bool", [])))), Var("x1", Tyapp("bool", [])))), Comb(Comb(Const("\\/", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("b", Tyapp("bool", []))), Var("x0", Tyapp("bool", []))))))), Tactics.THEN(Class.BOOL_CASES_TAC(Host.hol_term(Var("b", Tyapp("bool", [])))))(Simp.ASM_REWRITE_TAC(PairList []))])
  let propsimps_2 = Host.hol_apply_unit(Simp.basic_net)
  let false_tm_2 = Host.hol_term(Const("F", Tyapp("bool", [])))
  let true_tm_2 = Host.hol_term(Const("T", Tyapp("bool", [])))
  let match_th_2 = Drule.MATCH_MP(th_cond_2)
  let match_th_prime_2 = Drule.MATCH_MP(th_cond_prime_2)
  let propsimp_conv_2 = Equal.DEPTH_CONV(Simp.REWRITES_CONV(propsimps_2))
  let cnv = Equal.TRY_CONV(Simp.REWRITES_CONV(propsimps_2))
  let proptsimp_conv_2 = Equal.THENC(Equal.BINOP_CONV(cnv))(cnv)
  fun find_conditional(fvs):
    fun(tm):
      match tm
      | Fusion.Comb(s,t):
          if (Class.is_cond(tm) && Host.hol_equal(Host.intersect(Fusion.frees(Equal.lhand(s)))(fvs))(PairList []))
          | tm
          | try:
              find_conditional(fvs)(s)
              ~catch exn:
                match exn
                | Failure(_): find_conditional(fvs)(t)
                | exn: Host.hol_raise(exn)
      | Fusion.Abs(x,t): find_conditional(PairList.cons(x, fvs))(t)
      | _: failwith("find_conditional")
  fun CONDS_ELIM_CONV(dfl):
    fun(tm):
      try:
        let t = find_conditional(PairList [])(tm)
        let p = Equal.lhand(Fusion.rator(t))
        let th_new:
          if (Host.hol_equal(p)(false_tm_2) || Host.hol_equal(p)(true_tm_2))
          | propsimp_conv_2(tm)
          | let asm_0_2 = Fusion.mk_eq([p, false_tm_2])
            let asm_1_2 = Fusion.mk_eq([p, true_tm_2])
            let simp_0_2 = Simp.net_of_thm(#false)(Fusion.ASSUME(asm_0_2))(propsimps_2)
            let simp_1_2 = Simp.net_of_thm(#false)(Fusion.ASSUME(asm_1_2))(propsimps_2)
            let th_0_2 = Bool.DISCH(asm_0_2)(Equal.DEPTH_CONV(Simp.REWRITES_CONV(simp_0_2))(tm))
            let th_1_2 = Bool.DISCH(asm_1_2)(Equal.DEPTH_CONV(Simp.REWRITES_CONV(simp_1_2))(tm))
            let th_2 = Bool.CONJ(th_0_2)(th_1_2)
            let th_3 = (if dfl | match_th_2(th_2) | match_th_prime_2(th_2))
            Fusion.TRANS(th_3)(proptsimp_conv_2(Fusion.rand(Fusion.concl(th_3))))
        Equal.CONV_RULE(Equal.RAND_CONV(CONDS_ELIM_CONV(dfl)))(th_new)
        ~catch exn:
          match exn
          | Failure(_):
              if Basics.is_neg(tm)
              | Equal.RAND_CONV(CONDS_ELIM_CONV(Host.hol_not(dfl)))(tm)
              | if (Basics.is_conj(tm) || Basics.is_disj(tm))
                | Equal.BINOP_CONV(CONDS_ELIM_CONV(dfl))(tm)
                | if (Basics.is_imp(tm) || Bool.is_iff(tm))
                  | Equal.COMB2_CONV(Equal.RAND_CONV(CONDS_ELIM_CONV(Host.hol_not(dfl))))(CONDS_ELIM_CONV(dfl))(tm)
                  | if Basics.is_forall(tm)
                    | Equal.BINDER_CONV(CONDS_ELIM_CONV(#false))(tm)
                    | (if (Basics.is_exists(tm) || Basics.is_uexists(tm)) | Equal.BINDER_CONV(CONDS_ELIM_CONV(#true))(tm) | Fusion.REFL(tm))
          | exn: Host.hol_raise(exn)
  [CONDS_ELIM_CONV(#true), CONDS_ELIM_CONV(#false)]

def ASM_FOL_TAC:
  fun get_heads(lconsts):
    fun(tm):
      fun([cheads, vheads] as sofar):
        try:
          let [v, bod] = Basics.dest_forall(tm)
          get_heads(subtract(lconsts)(PairList.cons(v, PairList [])))(bod)(sofar)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  let [l, r]:
                    try:
                      Basics.dest_conj(tm)
                      ~catch exn:
                        match exn
                        | Failure(_): Basics.dest_disj(tm)
                        | exn: Host.hol_raise(exn)
                  get_heads(lconsts)(l)(get_heads(lconsts)(r)(sofar))
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let tm_prime = Basics.dest_neg(tm)
                          get_heads(lconsts)(tm_prime)(sofar)
                          ~catch exn:
                            match exn
                            | Failure(_):
                                let [hop, args] = Basics.strip_comb(tm)
                                let len = length(args)
                                let newheads:
                                  if (Fusion.is_const(hop) || mem(hop)(lconsts))
                                  | [insert([hop, len])(cheads), vheads]
                                  | (if Host.hol_gt(len)(0) | [cheads, insert([hop, len])(vheads)] | sofar)
                                itlist(get_heads(lconsts))(args)(newheads)
                            | exn: Host.hol_raise(exn)
                    | exn: Host.hol_raise(exn)
            | exn: Host.hol_raise(exn)
  let get_thm_heads = (fun(th): (fun(sofar): get_heads(Fusion.freesl(Fusion.hyp(th)))(Fusion.concl(th))(sofar)))
  let th = Tactics.prove([Host.hol_term(Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyvar("B")]), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("f", Tyapp("fun", [Tyvar("A"), Tyvar("B")])), Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("x", Tyvar("A")), Comb(Comb(Const("=", Tyapp("fun", [Tyvar("B"), Tyapp("fun", [Tyvar("B"), Tyapp("bool", [])])])), Comb(Var("f", Tyapp("fun", [Tyvar("A"), Tyvar("B")])), Var("x", Tyvar("A")))), Comb(Comb(Const("I", Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyvar("B")]), Tyapp("fun", [Tyvar("A"), Tyvar("B")])])), Var("f", Tyapp("fun", [Tyvar("A"), Tyvar("B")]))), Var("x", Tyvar("A"))))))))), Simp.REWRITE_TAC(PairList.cons(Trivia.I_THM, PairList []))])
  let APP_CONV = Simp.REWR_CONV(th)
  fun APP_N_CONV(n): (fun(tm): (if Host.hol_equal(n)(1) | APP_CONV(tm) | Equal.THENC(Equal.RATOR_CONV(APP_N_CONV(Host.hol_sub(n)(1))))(APP_CONV)(tm)))
  fun FOL_CONV(hddata):
    fun(tm):
      if Basics.is_forall(tm)
      | Equal.BINDER_CONV(FOL_CONV(hddata))(tm)
      | if (Basics.is_conj(tm) || Basics.is_disj(tm))
        | Equal.BINOP_CONV(FOL_CONV(hddata))(tm)
        | let [op, args] = Basics.strip_comb(tm)
          let th = rev_itlist(C(curry(Fusion.MK_COMB)))(map(FOL_CONV(hddata))(args))(Fusion.REFL(op))
          let tm_prime = Fusion.rand(Fusion.concl(th))
          let n:
            try:
              Host.hol_sub(length(args))(assoc(op)(hddata))
              ~catch exn:
                match exn
                | Failure(_): 0
                | exn: Host.hol_raise(exn)
          (if Host.hol_equal(n)(0) | th | Fusion.TRANS(th)(APP_N_CONV(n)(tm_prime)))
  let GEN_FOL_CONV:
    fun([cheads, vheads]):
      let hddata:
        if Host.hol_equal(vheads)(PairList [])
        | let hops = Host.setify(map(fst)(cheads))
          let getmin:
            fun(h):
              let ns = mapfilter((fun([k, n]): (if Host.hol_equal(k)(h) | n | Host.hol_apply_unit(fail))))(cheads)
              (if Host.hol_lt(length(ns))(2) | Host.hol_apply_unit(fail) | [h, end_itlist(Host.hol_min)(ns)])
          mapfilter(getmin)(hops)
        | map((fun(t): (if (Fusion.is_const(t) && Host.hol_equal(fst(Fusion.dest_const(t)))("=")) | [t, 2] | [t, 0])))(Host.setify(map(fst)(append(vheads)(cheads))))
      FOL_CONV(hddata)
  fun([asl, w] as gl):
    let headsp = itlist(o(get_thm_heads)(snd))(asl)([PairList [], PairList []])
    Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(GEN_FOL_CONV(headsp)))(gl)

fun PROP_ATOM_CONV(conv):
  fun(tm):
    match tm
    | Fusion.Comb(Fusion.Const("!",_),Fusion.Abs(_,_)): Equal.BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Const("?",_),Fusion.Abs(_,_)): Equal.BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Const("?!",_),Fusion.Abs(_,_)): Equal.BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("/\\",_),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("\\/",_),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("==>",_),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("=",Fusion.Tyapp("fun",PairList [Fusion.Tyapp("bool",PairList []), & PairList [_, & PairList []]])),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Const("~",_),_): Equal.RAND_CONV(PROP_ATOM_CONV(conv))(tm)
    | _: Equal.TRY_CONV(conv)(tm)
