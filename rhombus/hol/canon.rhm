def PRESIMP_CONV:
  GEN_REWRITE_CONV(
    TOP_DEPTH_CONV)(
    PairList [
      NOT_CLAUSES,
      AND_CLAUSES,
      OR_CLAUSES,
      IMP_CLAUSES,
      EQ_CLAUSES,
      FORALL_SIMP,
      EXISTS_SIMP,
      EXISTS_OR_THM,
      FORALL_AND_THM,
      LEFT_EXISTS_AND_THM,
      RIGHT_EXISTS_AND_THM,
      LEFT_FORALL_OR_THM,
      RIGHT_FORALL_OR_THM
    ]
  )

def CONJ_ACI_RULE:
  // Recursive conjunction indexing needs the local definition before its first use.
  fun mk_fun_2(th):
    fun(fn):
      let tm = concl(th)
      if is_conj(tm)
      | let [th1, th2] = CONJ_PAIR(th)
        mk_fun_2(th1)(mk_fun_2(th2)(fn))
      | fpf_define(tm)(th)(fn)
  // Recursive conjunction rebuilding needs the local definition before its first use.
  fun use_fun_2(fn):
    fun(tm):
      if is_conj(tm)
      | let [l, r] = dest_conj(tm)
        CONJ(use_fun_2(fn)(l))(use_fun_2(fn)(r))
      | apply(fn)(tm)
  fun(fm):
    let [p, p_prime] = dest_eq(fm)
    if (p == p_prime)
    | REFL(p)
    | let th_2 = use_fun_2(mk_fun_2(ASSUME(p))(undefined))(p_prime)
      let th_prime_2 = use_fun_2(mk_fun_2(ASSUME(p_prime))(undefined))(p)
      IMP_ANTISYM_RULE(DISCH_ALL(th_2))(DISCH_ALL(th_prime_2))

def DISJ_ACI_RULE:
  let pth_left_2:
    UNDISCH(
      TAUT(@hol|{~(a \/ b) ==> ~a}|)
    )
  let pth_right_2:
    UNDISCH(
      TAUT(@hol|{~(a \/ b) ==> ~b}|)
    )
  let pth_2:
    repeat(UNDISCH)(
      TAUT(
        @hol|{~a ==> ~b ==> ~(a \/ b)}|
      )
    )
  let pth_neg_2:
    UNDISCH(
      TAUT(
        @hol|{(~a <=> ~b) ==> (a <=> b)}|
      )
    )
  let a_tm_2 = @hol|{a:bool}|
  let b_tm_2 = @hol|{b:bool}|
  let NOT_DISJ_PAIR_2:
    fun(th):
      let [p, q] = dest_disj(rand(concl(th)))
      let ilist = PairList [[p, a_tm_2], [q, b_tm_2]]
      [
        PROVE_HYP(th)(INST(ilist)(pth_left_2)),
        PROVE_HYP(th)(INST(ilist)(pth_right_2))
      ]
  let NOT_DISJ_2:
    fun(th1):
      fun(th2):
        let th3 = INST(PairList [[rand(concl(th1)), a_tm_2], [rand(concl(th2)), b_tm_2]])(pth_2)
        PROVE_HYP(th1)(PROVE_HYP(th2)(th3))
  // Recursive disjunction indexing needs the local definition before its first use.
  fun mk_fun_3(th):
    fun(fn):
      let tm = rand(concl(th))
      if is_disj(tm)
      | let [th1, th2] = NOT_DISJ_PAIR_2(th)
        mk_fun_3(th1)(mk_fun_3(th2)(fn))
      | fpf_define(tm)(th)(fn)
  // Recursive disjunction rebuilding needs the local definition before its first use.
  fun use_fun_3(fn):
    fun(tm):
      if is_disj(tm)
      | let [l, r] = dest_disj(tm)
        NOT_DISJ_2(use_fun_3(fn)(l))(use_fun_3(fn)(r))
      | apply(fn)(tm)
  fun(fm):
    let [p, p_prime] = dest_eq(fm)
    if (p == p_prime)
    | REFL(p)
    | let th_3 = use_fun_3(mk_fun_3(ASSUME(mk_neg(p)))(undefined))(p_prime)
      let th_prime_3 = use_fun_3(mk_fun_3(ASSUME(mk_neg(p_prime)))(undefined))(p)
      let th1 = IMP_ANTISYM_RULE(DISCH_ALL(th_3))(DISCH_ALL(th_prime_3))
      PROVE_HYP(th1)(INST(PairList [[p, a_tm_2], [p_prime, b_tm_2]])(pth_neg_2))

fun CONJ_CANON_CONV(tm):
  let tm_prime = list_mk_conj(setify(conjuncts(tm)))
  CONJ_ACI_RULE(mk_eq([tm, tm_prime]))

fun DISJ_CANON_CONV(tm):
  let tm_prime = list_mk_disj(setify(disjuncts(tm)))
  DISJ_ACI_RULE(mk_eq([tm, tm_prime]))

def GEN_NNF_CONV:
  let and_tm_2 = @hol|{(/\)}|
  let or_tm_2 = @hol|{(\/)}|
  let not_tm_2 = @hol|{(~)}|
  let pth_not_not_2 = TAUT(@hol|{~ ~ p = p}|)
  let pth_not_and_2:
    TAUT(
      @hol|{~(p /\ q) <=> ~p \/ ~q}|
    )
  let pth_not_or_2:
    TAUT(
      @hol|{~(p \/ q) <=> ~p /\ ~q}|
    )
  let pth_imp_2:
    TAUT(
      @hol|{p ==> q <=> ~p \/ q}|
    )
  let pth_not_imp_2:
    TAUT(
      @hol|{~(p ==> q) <=> p /\ ~q}|
    )
  let pth_eq_2:
    TAUT(
      @hol|{(p <=> q) <=> p /\ q \/ ~p /\ ~q}|
    )
  let pth_not_eq_2:
    TAUT(
      @hol|{~(p <=> q) <=> p /\ ~q \/ ~p /\ q}|
    )
  let pth_eq_prime_2:
    TAUT(
      @hol|{(p <=> q) <=> (p \/ ~q) /\ (~p \/ q)}|
    )
  let pth_not_eq_prime_2:
    TAUT(
      @hol|{~(p <=> q) <=> (p \/ q) /\ (~p \/ ~q)}|
    )
  let PairList [pth_not_forall_2, & PairList [pth_not_exists_2, & PairList [pth_not_exu_2, & PairList []]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{(~((!) P) <=> ?x:A. ~(P x)) /\
           (~((?) P) <=> !x:A. ~(P x)) /\
           (~((?!) P) <=> (!x:A. ~(P x)) \/ ?x y. P x /\ P y /\ ~(y = x))}|,
        REPEAT(CONJ_TAC) then_tac \
        GEN_REWRITE_TAC(o(LAND_CONV)(funpow(2)(RAND_CONV)))(PairList [GSYM(ETA_AX)]) then_tac \
        REWRITE_TAC(
          PairList [
            NOT_EXISTS_THM,
            NOT_FORALL_THM,
            EXISTS_UNIQUE_DEF,
            DE_MORGAN_THM,
            NOT_IMP
          ]
        ) then_tac \
        REWRITE_TAC(PairList [CONJ_ASSOC, EQ_SYM_EQ])
      ]
    )
  let pth_exu_2:
    prove(
      [
        @hol|{((?!) P) <=> (?x:A. P x) /\ !x y. ~(P x) \/ ~(P y) \/ (y = x)}|,
        GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [GSYM(ETA_AX)]) then_tac \
        REWRITE_TAC(
          PairList [
            EXISTS_UNIQUE_DEF,
            TAUT(
              @hol|{a /\ b ==> c <=> ~a \/ ~b \/ c}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [EQ_SYM_EQ])
      ]
    )
  let p_tm_2 = @hol|{p:bool}|
  let q_tm_2 = @hol|{q:bool}|
  // Recursive normalization needs the local definition before its first use.
  fun NNF_DCONV(cf):
    fun(baseconvs):
      fun(tm):
        match tm
        | Comb(Comb(Const("/\\",_),l),r):
            let [th_lp_2, th_ln_2] = NNF_DCONV(cf)(baseconvs)(l)
            let [th_rp_2, th_rn_2] = NNF_DCONV(cf)(baseconvs)(r)
            [
              MK_COMB([AP_TERM(and_tm_2)(th_lp_2), th_rp_2]),
              TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_not_and_2))(MK_COMB([AP_TERM(or_tm_2)(th_ln_2), th_rn_2]))
            ]
        | Comb(Comb(Const("\\/",_),l),r):
            let [th_lp_3, th_ln_3] = NNF_DCONV(cf)(baseconvs)(l)
            let [th_rp_3, th_rn_3] = NNF_DCONV(cf)(baseconvs)(r)
            [
              MK_COMB([AP_TERM(or_tm_2)(th_lp_3), th_rp_3]),
              TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_not_or_2))(MK_COMB([AP_TERM(and_tm_2)(th_ln_3), th_rn_3]))
            ]
        | Comb(Comb(Const("==>",_),l),r):
            let [th_lp_4, th_ln_4] = NNF_DCONV(cf)(baseconvs)(l)
            let [th_rp_4, th_rn_4] = NNF_DCONV(cf)(baseconvs)(r)
            [
              TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_imp_2))(MK_COMB([AP_TERM(or_tm_2)(th_ln_4), th_rp_4])),
              TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_not_imp_2))(MK_COMB([AP_TERM(and_tm_2)(th_lp_4), th_rn_4]))
            ]
        | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",_), & _])),l),r):
            let [th_lp_5, th_ln_5] = NNF_DCONV(cf)(baseconvs)(l)
            let [th_rp_5, th_rn_5] = NNF_DCONV(cf)(baseconvs)(r)
            if cf
            | [
                TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_eq_prime_2))(
                  MK_COMB(
                    [
                      AP_TERM(and_tm_2)(MK_COMB([AP_TERM(or_tm_2)(th_lp_5), th_rn_5])),
                      MK_COMB([AP_TERM(or_tm_2)(th_ln_5), th_rp_5])
                    ]
                  )
                ),
                TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_not_eq_prime_2))(
                  MK_COMB(
                    [
                      AP_TERM(and_tm_2)(MK_COMB([AP_TERM(or_tm_2)(th_lp_5), th_rp_5])),
                      MK_COMB([AP_TERM(or_tm_2)(th_ln_5), th_rn_5])
                    ]
                  )
                )
              ]
            | [
                TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_eq_2))(
                  MK_COMB(
                    [
                      AP_TERM(or_tm_2)(MK_COMB([AP_TERM(and_tm_2)(th_lp_5), th_rp_5])),
                      MK_COMB([AP_TERM(and_tm_2)(th_ln_5), th_rn_5])
                    ]
                  )
                ),
                TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_not_eq_2))(
                  MK_COMB(
                    [
                      AP_TERM(or_tm_2)(MK_COMB([AP_TERM(and_tm_2)(th_lp_5), th_rn_5])),
                      MK_COMB([AP_TERM(and_tm_2)(th_ln_5), th_rp_5])
                    ]
                  )
                )
              ]
        | Comb(Const("!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])) as q,Abs(x,t) as bod):
            let [th_p, th_n] = NNF_DCONV(#true)(baseconvs)(t)
            let th1_2 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_forall_2))
            let th2_2 = TRANS(AP_TERM(not_tm_2)(BETA(mk_comb([bod, x]))))(th_n)
            [AP_TERM(q)(ABS(x)(th_p)), TRANS(th1_2)(MK_EXISTS(x)(th2_2))]
        | Comb(Const("?",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])) as q,Abs(x,t) as bod):
            let [th_p, th_n] = NNF_DCONV(cf)(baseconvs)(t)
            let th1_3 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_exists_2))
            let th2_3 = TRANS(AP_TERM(not_tm_2)(BETA(mk_comb([bod, x]))))(th_n)
            [AP_TERM(q)(ABS(x)(th_p)), TRANS(th1_3)(MK_FORALL(x)(th2_3))]
        | Comb(Const("?!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])),Abs(x,t) as bod):
            let y_2 = variant(PairList [x, & frees(t)])(x)
            let [th_p_2, th_n_2] = NNF_DCONV(cf)(baseconvs)(t)
            let eq = mk_eq([y_2, x])
            let [eth_p_2, eth_n_2] = baseconvs(eq)
            let bth_2 = BETA(mk_comb([bod, x]))
            let bth_prime_2 = BETA_CONV(mk_comb([bod, y_2]))
            let th_p_prime_2 = INST(PairList [[y_2, x]])(th_p_2)
            let th_n_prime_2 = INST(PairList [[y_2, x]])(th_n_2)
            let th1_4 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_exu_2))
            let th1_prime_2 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_exu_2))
            let th2_4:
              MK_COMB(
                [
                  AP_TERM(and_tm_2)(MK_EXISTS(x)(TRANS(bth_2)(th_p_2))),
                  MK_FORALL(x)(
                    MK_FORALL(y_2)(
                      MK_COMB(
                        [
                          AP_TERM(or_tm_2)(TRANS(AP_TERM(not_tm_2)(bth_2))(th_n_2)),
                          MK_COMB(
                            [
                              AP_TERM(or_tm_2)(TRANS(AP_TERM(not_tm_2)(bth_prime_2))(th_n_prime_2)),
                              eth_p_2
                            ]
                          )
                        ]
                      )
                    )
                  )
                ]
              )
            let th2_prime_2:
              MK_COMB(
                [
                  AP_TERM(or_tm_2)(MK_FORALL(x)(TRANS(AP_TERM(not_tm_2)(bth_2))(th_n_2))),
                  MK_EXISTS(x)(
                    MK_EXISTS(y_2)(
                      MK_COMB(
                        [
                          AP_TERM(and_tm_2)(TRANS(bth_2)(th_p_2)),
                          MK_COMB([AP_TERM(and_tm_2)(TRANS(bth_prime_2)(th_p_prime_2)), eth_n_2])
                        ]
                      )
                    )
                  )
                ]
              )
            [TRANS(th1_4)(th2_4), TRANS(th1_prime_2)(th2_prime_2)]
        | Comb(Const("~",_),t):
            let [th1, th2] = NNF_DCONV(cf)(baseconvs)(t)
            [th2, TRANS(INST(PairList [[t, p_tm_2]])(pth_not_not_2))(th1)]
        | _:
            try:
              baseconvs(tm)
              ~catch exn:
                match exn
                | Failure(_): [REFL(tm), REFL(mk_neg(tm))]
                | exn: (throw exn)
  // Mutually recursive normalization needs local definitions for forward references.
  fun NNF_CONV_2(cf):
    fun([base1, base2] as baseconvs):
      fun(tm):
        match tm
        | Comb(Comb(Const("/\\",_),l),r):
            let th_lp_6 = NNF_CONV_2(cf)(baseconvs)(l)
            let th_rp_6 = NNF_CONV_2(cf)(baseconvs)(r)
            MK_COMB([AP_TERM(and_tm_2)(th_lp_6), th_rp_6])
        | Comb(Comb(Const("\\/",_),l),r):
            let th_lp_7 = NNF_CONV_2(cf)(baseconvs)(l)
            let th_rp_7 = NNF_CONV_2(cf)(baseconvs)(r)
            MK_COMB([AP_TERM(or_tm_2)(th_lp_7), th_rp_7])
        | Comb(Comb(Const("==>",_),l),r):
            let th_ln_6 = NNF_CONV_prime_2(cf)(baseconvs)(l)
            let th_rp_8 = NNF_CONV_2(cf)(baseconvs)(r)
            TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_imp_2))(MK_COMB([AP_TERM(or_tm_2)(th_ln_6), th_rp_8]))
        | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",_), & _])),l),r):
            let [th_lp_8, th_ln_7] = NNF_DCONV(cf)(base2)(l)
            let [th_rp_9, th_rn_6] = NNF_DCONV(cf)(base2)(r)
            if cf
            | TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_eq_prime_2))(
                MK_COMB(
                  [
                    AP_TERM(and_tm_2)(MK_COMB([AP_TERM(or_tm_2)(th_lp_8), th_rn_6])),
                    MK_COMB([AP_TERM(or_tm_2)(th_ln_7), th_rp_9])
                  ]
                )
              )
            | TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_eq_2))(
                MK_COMB(
                  [
                    AP_TERM(or_tm_2)(MK_COMB([AP_TERM(and_tm_2)(th_lp_8), th_rp_9])),
                    MK_COMB([AP_TERM(and_tm_2)(th_ln_7), th_rn_6])
                  ]
                )
              )
        | Comb(Const("!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])) as q,Abs(x,t)):
            let th_p = NNF_CONV_2(#true)(baseconvs)(t)
            AP_TERM(q)(ABS(x)(th_p))
        | Comb(Const("?",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])) as q,Abs(x,t)):
            let th_p = NNF_CONV_2(cf)(baseconvs)(t)
            AP_TERM(q)(ABS(x)(th_p))
        | Comb(Const("?!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])),Abs(x,t) as bod):
            let y_3 = variant(PairList [x, & frees(t)])(x)
            let [th_p_3, th_n_3] = NNF_DCONV(cf)(base2)(t)
            let eq = mk_eq([y_3, x])
            let [eth_p_3, eth_n_3] = base2(eq)
            let bth_3 = BETA(mk_comb([bod, x]))
            let bth_prime_3 = BETA_CONV(mk_comb([bod, y_3]))
            let th_n_prime = INST(PairList [[y_3, x]])(th_n_3)
            let th1_5 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_exu_2))
            let th2_5:
              MK_COMB(
                [
                  AP_TERM(and_tm_2)(MK_EXISTS(x)(TRANS(bth_3)(th_p_3))),
                  MK_FORALL(x)(
                    MK_FORALL(y_3)(
                      MK_COMB(
                        [
                          AP_TERM(or_tm_2)(TRANS(AP_TERM(not_tm_2)(bth_3))(th_n_3)),
                          MK_COMB(
                            [
                              AP_TERM(or_tm_2)(TRANS(AP_TERM(not_tm_2)(bth_prime_3))(th_n_prime)),
                              eth_p_3
                            ]
                          )
                        ]
                      )
                    )
                  )
                ]
              )
            TRANS(th1_5)(th2_5)
        | Comb(Const("~",_),t): NNF_CONV_prime_2(cf)(baseconvs)(t)
        | _:
            try:
              base1(tm)
              ~catch exn:
                match exn
                | Failure(_): REFL(tm)
                | exn: (throw exn)
  // Mutually recursive normalization needs both local definitions before use.
  fun NNF_CONV_prime_2(cf):
    fun([base1, base2] as baseconvs):
      fun(tm):
        match tm
        | Comb(Comb(Const("/\\",_),l),r):
            let th_ln_8 = NNF_CONV_prime_2(cf)(baseconvs)(l)
            let th_rn_7 = NNF_CONV_prime_2(cf)(baseconvs)(r)
            TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_not_and_2))(MK_COMB([AP_TERM(or_tm_2)(th_ln_8), th_rn_7]))
        | Comb(Comb(Const("\\/",_),l),r):
            let th_ln_9 = NNF_CONV_prime_2(cf)(baseconvs)(l)
            let th_rn_8 = NNF_CONV_prime_2(cf)(baseconvs)(r)
            TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_not_or_2))(MK_COMB([AP_TERM(and_tm_2)(th_ln_9), th_rn_8]))
        | Comb(Comb(Const("==>",_),l),r):
            let th_lp_9 = NNF_CONV_2(cf)(baseconvs)(l)
            let th_rn_9 = NNF_CONV_prime_2(cf)(baseconvs)(r)
            TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_not_imp_2))(MK_COMB([AP_TERM(and_tm_2)(th_lp_9), th_rn_9]))
        | Comb(Comb(Const("=",Tyapp("fun",PairList [Tyapp("bool",_), & _])),l),r):
            let [th_lp_10, th_ln_10] = NNF_DCONV(cf)(base2)(l)
            let [th_rp_10, th_rn_10] = NNF_DCONV(cf)(base2)(r)
            if cf
            | TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_not_eq_prime_2))(
                MK_COMB(
                  [
                    AP_TERM(and_tm_2)(MK_COMB([AP_TERM(or_tm_2)(th_lp_10), th_rp_10])),
                    MK_COMB([AP_TERM(or_tm_2)(th_ln_10), th_rn_10])
                  ]
                )
              )
            | TRANS(INST(PairList [[l, p_tm_2], [r, q_tm_2]])(pth_not_eq_2))(
                MK_COMB(
                  [
                    AP_TERM(or_tm_2)(MK_COMB([AP_TERM(and_tm_2)(th_lp_10), th_rn_10])),
                    MK_COMB([AP_TERM(and_tm_2)(th_ln_10), th_rp_10])
                  ]
                )
              )
        | Comb(Const("!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])),Abs(x,t) as bod):
            let th_n = NNF_CONV_prime_2(cf)(baseconvs)(t)
            let th1_6 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_forall_2))
            let th2_6 = TRANS(AP_TERM(not_tm_2)(BETA(mk_comb([bod, x]))))(th_n)
            TRANS(th1_6)(MK_EXISTS(x)(th2_6))
        | Comb(Const("?",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])),Abs(x,t) as bod):
            let th_n = NNF_CONV_prime_2(#true)(baseconvs)(t)
            let th1_7 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_exists_2))
            let th2_7 = TRANS(AP_TERM(not_tm_2)(BETA(mk_comb([bod, x]))))(th_n)
            TRANS(th1_7)(MK_FORALL(x)(th2_7))
        | Comb(Const("?!",Tyapp("fun",PairList [Tyapp("fun",PairList [ty, & _]), & _])),Abs(x,t) as bod):
            let y_4 = variant(PairList [x, & frees(t)])(x)
            let [th_p_4, th_n_4] = NNF_DCONV(cf)(base2)(t)
            let eq = mk_eq([y_4, x])
            let [eth_p_4, eth_n_4] = base2(eq)
            let bth_4 = BETA(mk_comb([bod, x]))
            let bth_prime_4 = BETA_CONV(mk_comb([bod, y_4]))
            let th_p_prime = INST(PairList [[y_4, x]])(th_p_4)
            let th1_prime_3 = INST(PairList [[bod, mk_var(["P", mk_fun_ty(ty)(bool_ty)])]])(INST_TYPE(PairList [[ty, aty]])(pth_not_exu_2))
            let th2_prime_3:
              MK_COMB(
                [
                  AP_TERM(or_tm_2)(MK_FORALL(x)(TRANS(AP_TERM(not_tm_2)(bth_4))(th_n_4))),
                  MK_EXISTS(x)(
                    MK_EXISTS(y_4)(
                      MK_COMB(
                        [
                          AP_TERM(and_tm_2)(TRANS(bth_4)(th_p_4)),
                          MK_COMB([AP_TERM(and_tm_2)(TRANS(bth_prime_4)(th_p_prime)), eth_n_4])
                        ]
                      )
                    )
                  )
                ]
              )
            TRANS(th1_prime_3)(th2_prime_3)
        | Comb(Const("~",_),t):
            let th1 = NNF_CONV_2(cf)(baseconvs)(t)
            TRANS(INST(PairList [[t, p_tm_2]])(pth_not_not_2))(th1)
        | _:
            let tm_prime = mk_neg(tm)
            try:
              base1(tm_prime)
              ~catch exn:
                match exn
                | Failure(_): REFL(tm_prime)
                | exn: (throw exn)
  NNF_CONV_2

def NNF_CONV = GEN_NNF_CONV(#false)([ALL_CONV, (fun(t): [REFL(t), REFL(mk_neg(t))])])

def NNFC_CONV = GEN_NNF_CONV(#true)([ALL_CONV, (fun(t): [REFL(t), REFL(mk_neg(t))])])

def SKOLEM_CONV:
  (
    GEN_REWRITE_CONV(
      TOP_DEPTH_CONV)(
      PairList [
        EXISTS_OR_THM,
        LEFT_EXISTS_AND_THM,
        RIGHT_EXISTS_AND_THM,
        FORALL_AND_THM,
        LEFT_FORALL_OR_THM,
        RIGHT_FORALL_OR_THM,
        FORALL_SIMP,
        EXISTS_SIMP
      ]
    ) then_conv \
    GEN_REWRITE_CONV(
      REDEPTH_CONV)(
      PairList [
        RIGHT_AND_EXISTS_THM,
        LEFT_AND_EXISTS_THM,
        OR_EXISTS_THM,
        RIGHT_OR_EXISTS_THM,
        LEFT_OR_EXISTS_THM,
        SKOLEM_THM
      ]
    )
  )

def PRENEX_CONV:
  GEN_REWRITE_CONV(
    REDEPTH_CONV)(
    PairList [
      AND_FORALL_THM,
      LEFT_AND_FORALL_THM,
      RIGHT_AND_FORALL_THM,
      LEFT_OR_FORALL_THM,
      RIGHT_OR_FORALL_THM,
      OR_EXISTS_THM,
      LEFT_OR_EXISTS_THM,
      RIGHT_OR_EXISTS_THM,
      LEFT_AND_EXISTS_THM,
      RIGHT_AND_EXISTS_THM
    ]
  )

def [canon_WEAK_DNF_CONV_v2, DNF_CONV]:
  let pth1_2:
    TAUT(
      @hol|{a /\ (b \/ c) <=> a /\ b \/ a /\ c}|
    )
  let pth2_2:
    TAUT(
      @hol|{(a \/ b) /\ c <=> a /\ c \/ b /\ c}|
    )
  let a_tm_3 = @hol|{a:bool}|
  let b_tm_3 = @hol|{b:bool}|
  let c_tm_2 = @hol|{c:bool}|
  fun distribute(tm):
    match tm
    | Comb(Comb(Const("/\\",_),a),Comb(Comb(Const("\\/",_),b),c)):
        let th = INST(PairList [[a, a_tm_3], [b, b_tm_3], [c, c_tm_2]])(pth1_2)
        TRANS(th)(BINOP_CONV(distribute)(rand(concl(th))))
    | Comb(Comb(Const("/\\",_),Comb(Comb(Const("\\/",_),a),b)),c):
        let th = INST(PairList [[a, a_tm_3], [b, b_tm_3], [c, c_tm_2]])(pth2_2)
        TRANS(th)(BINOP_CONV(distribute)(rand(concl(th))))
    | _: REFL(tm)
  let strengthen:
    (
      DEPTH_BINOP_CONV(@hol|{(\/)}|)(CONJ_CANON_CONV) then_conv \
      DISJ_CANON_CONV
    )
  fun weakdnf_2(tm):
    match tm
    | Comb(Const("!",_),Abs(_,_)): BINDER_CONV(weakdnf_2)(tm)
    | Comb(Const("?",_),Abs(_,_)): BINDER_CONV(weakdnf_2)(tm)
    | Comb(Comb(Const("\\/",_),_),_): BINOP_CONV(weakdnf_2)(tm)
    | Comb(Comb(Const("/\\",_) as op,l),r):
        let th = MK_COMB([AP_TERM(op)(weakdnf_2(l)), weakdnf_2(r)])
        TRANS(th)(distribute(rand(concl(th))))
    | _: REFL(tm)
  fun substrongdnf_2(tm):
    match tm
    | Comb(Const("!",_),Abs(_,_)): BINDER_CONV(strongdnf_2)(tm)
    | Comb(Const("?",_),Abs(_,_)): BINDER_CONV(strongdnf_2)(tm)
    | Comb(Comb(Const("\\/",_),_),_): BINOP_CONV(substrongdnf_2)(tm)
    | Comb(Comb(Const("/\\",_) as op,l),r):
        let th = MK_COMB([AP_TERM(op)(substrongdnf_2(l)), substrongdnf_2(r)])
        TRANS(th)(distribute(rand(concl(th))))
    | _: REFL(tm)
  fun strongdnf_2(tm):
    let th = substrongdnf_2(tm)
    TRANS(th)(strengthen(rand(concl(th))))
  [weakdnf_2, strongdnf_2]

def [canon_WEAK_CNF_CONV_v2, CNF_CONV]:
  let pth1_3:
    TAUT(
      @hol|{a \/ (b /\ c) <=> (a \/ b) /\ (a \/ c)}|
    )
  let pth2_3:
    TAUT(
      @hol|{(a /\ b) \/ c <=> (a \/ c) /\ (b \/ c)}|
    )
  let a_tm_4 = @hol|{a:bool}|
  let b_tm_4 = @hol|{b:bool}|
  let c_tm_3 = @hol|{c:bool}|
  fun distribute_2(tm):
    match tm
    | Comb(Comb(Const("\\/",_),a),Comb(Comb(Const("/\\",_),b),c)):
        let th = INST(PairList [[a, a_tm_4], [b, b_tm_4], [c, c_tm_3]])(pth1_3)
        TRANS(th)(BINOP_CONV(distribute_2)(rand(concl(th))))
    | Comb(Comb(Const("\\/",_),Comb(Comb(Const("/\\",_),a),b)),c):
        let th = INST(PairList [[a, a_tm_4], [b, b_tm_4], [c, c_tm_3]])(pth2_3)
        TRANS(th)(BINOP_CONV(distribute_2)(rand(concl(th))))
    | _: REFL(tm)
  let strengthen:
    (
      DEPTH_BINOP_CONV(@hol|{(/\)}|)(DISJ_CANON_CONV) then_conv \
      CONJ_CANON_CONV
    )
  fun weakcnf_2(tm):
    match tm
    | Comb(Const("!",_),Abs(_,_)): BINDER_CONV(weakcnf_2)(tm)
    | Comb(Const("?",_),Abs(_,_)): BINDER_CONV(weakcnf_2)(tm)
    | Comb(Comb(Const("/\\",_),_),_): BINOP_CONV(weakcnf_2)(tm)
    | Comb(Comb(Const("\\/",_) as op,l),r):
        let th = MK_COMB([AP_TERM(op)(weakcnf_2(l)), weakcnf_2(r)])
