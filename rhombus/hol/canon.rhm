def canon_CONJ_ACI_RULE:«
  (block:«
    fun port_tmp_1_mk_fun(th):«
      (fun(fn):«
        (block:«
          let tm:«
            Up_fusion.concl(th)
          »;
          (block:«
            if Up_basics.is_conj(tm)
            | (block:«
              let Pair(th1,th2):«
                Up_bool.CONJ_PAIR(th)
              »;
              port_tmp_1_mk_fun(th1)(port_tmp_1_mk_fun(th2)(fn))
            »)
            | Host.fpf_define(tm)(th)(fn)
          »)
        »)
      »)
    »;
    fun port_tmp_2_use_fun(fn):«
      (fun(tm):«
        (block:«
          if Up_basics.is_conj(tm)
          | (block:«
            let Pair(l,r):«
              Up_basics.dest_conj(tm)
            »;
            (block:«
              let port_tmp_3 = port_tmp_2_use_fun(fn)(r);
              let port_tmp_4 = port_tmp_2_use_fun(fn)(l);
              Up_bool.CONJ(port_tmp_4)(port_tmp_3)
            »)
          »)
          | Host.apply(fn)(tm)
        »)
      »)
    »;
    (fun(fm):«
      (block:«
        let Pair(p,p_prime):«
          Up_fusion.dest_eq(fm)
        »;
        (block:«
          if Host.hol_equal(p)(p_prime)
          | Up_fusion.REFL(p)
          | (block:«
            let port_tmp_5_th:«
              port_tmp_2_use_fun(port_tmp_1_mk_fun(Up_fusion.ASSUME(p))(Host.undefined))(p_prime)
            »;
            let port_tmp_6_th_prime:«
              port_tmp_2_use_fun(port_tmp_1_mk_fun(Up_fusion.ASSUME(p_prime))(Host.undefined))(p)
            »;
            (block:«
              let port_tmp_7 = Up_bool.DISCH_ALL(port_tmp_6_th_prime);
              let port_tmp_8 = Up_bool.DISCH_ALL(port_tmp_5_th);
              Up_bool.IMP_ANTISYM_RULE(port_tmp_8)(port_tmp_7)
            »)
