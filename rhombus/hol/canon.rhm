                  »;
                  Up_tactics.RULE_ASSUM_TAC(Up_equal.CONV_RULE(GEN_FOL_CONV(headsp)))(gl)
                »)
              »)
            »)
          »)
        »)
      »)
    »)
  »)
»

fun canon_PROP_ATOM_CONV(conv):«
  (fun(tm):«
    (block:«
      let port_tmp_360 = tm;
      match port_tmp_360
      | Up_fusion.Comb(Up_fusion.Const("!",_),Up_fusion.Abs(_,_)):«
          Up_equal.BINDER_CONV(canon_PROP_ATOM_CONV(conv))(tm)
      »
      | Up_fusion.Comb(Up_fusion.Const("?",_),Up_fusion.Abs(_,_)):«
          Up_equal.BINDER_CONV(canon_PROP_ATOM_CONV(conv))(tm)
      »
      | Up_fusion.Comb(Up_fusion.Const("?!",_),Up_fusion.Abs(_,_)):«
          Up_equal.BINDER_CONV(canon_PROP_ATOM_CONV(conv))(tm)
      »
      | Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("/\\",_),_),_):«
          Up_equal.BINOP_CONV(canon_PROP_ATOM_CONV(conv))(tm)
      »
      | Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("\\/",_),_),_):«
          Up_equal.BINOP_CONV(canon_PROP_ATOM_CONV(conv))(tm)
      »
      | Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("==>",_),_),_):«
          Up_equal.BINOP_CONV(canon_PROP_ATOM_CONV(conv))(tm)
      »
      | Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("=",Up_fusion.Tyapp("fun",PairList [Up_fusion.Tyapp("bool",PairList []), & PairList [_, & PairList []]])),_),_):«
          Up_equal.BINOP_CONV(canon_PROP_ATOM_CONV(conv))(tm)
      »
      | Up_fusion.Comb(Up_fusion.Const("~",_),_):«
          Up_equal.RAND_CONV(canon_PROP_ATOM_CONV(conv))(tm)
      »
      | _:«
          Up_equal.TRY_CONV(conv)(tm)
      »
    »)
  »)
»

