                    if Basics.is_neg(tm)
                    | Equal.RAND_CONV(CONDS_ELIM_CONV(Host.hol_not(dfl)))(tm)
                    | (block:«
                      if (Basics.is_conj(tm) || Basics.is_disj(tm))
                      | Equal.BINOP_CONV(CONDS_ELIM_CONV(dfl))(tm)
                      | (block:«
                        if (Basics.is_imp(tm) || Bool.is_iff(tm))
                        | (block:«
                          let port_tmp_316 = CONDS_ELIM_CONV(dfl);
                          let port_tmp_317 = Equal.RAND_CONV(CONDS_ELIM_CONV(Host.hol_not(dfl)));
                          Equal.COMB2_CONV(port_tmp_317)(port_tmp_316)(tm)
                        »)
                        | (block:«
                          if Basics.is_forall(tm)
                          | Equal.BINDER_CONV(CONDS_ELIM_CONV(#false))(tm)
                          | (block:«
                            if (Basics.is_exists(tm) || Basics.is_uexists(tm))
                            | Equal.BINDER_CONV(CONDS_ELIM_CONV(#true))(tm)
                            | Fusion.REFL(tm)
                          »)
                        »)
                      »)
                    »)
                »
                | port_tmp_315: Host.hol_raise(port_tmp_315)
              »
            »
          »)
        »;
        (block:«
          let port_tmp_318 = CONDS_ELIM_CONV(#false);
          let port_tmp_319 = CONDS_ELIM_CONV(#true);
          [port_tmp_319, port_tmp_318]
        »)
      »)
    »)
  »)
»

def ASM_FOL_TAC:«
  fun get_heads(lconsts):«
    (fun(tm):«
      (fun([cheads, vheads] as sofar):«
        try:«
          (block:«
            let [v, bod] = Basics.dest_forall(tm);
            get_heads(subtract(lconsts)(PairList.cons(v,PairList [])))(bod)(sofar)
          »);
          ~catch port_tmp_320:«
            match port_tmp_320
            | Failure(_):«
                try:«
                  (block:«
                    let [l, r]:«
                      try:«
                        Basics.dest_conj(tm);
                        ~catch port_tmp_321:«
                          match port_tmp_321
                          | Failure(_): Basics.dest_disj(tm)
                          | port_tmp_321: Host.hol_raise(port_tmp_321)
                        »
                      »
                    »;
                    get_heads(lconsts)(l)(get_heads(lconsts)(r)(sofar))
                  »);
                  ~catch port_tmp_322:«
                    match port_tmp_322
                    | Failure(_):«
                        try:«
                          (block:«
                            let tm_prime = Basics.dest_neg(tm);
                            get_heads(lconsts)(tm_prime)(sofar)
                          »);
                          ~catch port_tmp_323:«
                            match port_tmp_323
                            | Failure(_):«
                                let [hop, args] = Basics.strip_comb(tm);
                                (block:«
                                  let len = length(args);
                                  (block:«
                                    let newheads:«
                                      if (Fusion.is_const(hop) || mem(hop)(lconsts))
                                      | [insert([hop, len])(cheads), vheads]
                                      | (block:«
                                        if Host.hol_gt(len)(0)
                                        | [cheads, insert([hop, len])(vheads)]
                                        | sofar
                                      »)
                                    »;
                                    itlist(get_heads(lconsts))(args)(newheads)
                                  »)
                                »)
                            »
                            | port_tmp_323: Host.hol_raise(port_tmp_323)
                          »
                        »
                    »
                    | port_tmp_322: Host.hol_raise(port_tmp_322)
                  »
                »
            »
            | port_tmp_320: Host.hol_raise(port_tmp_320)
          »
        »
      »)
    »)
  »;
  (block:«
    let get_thm_heads:«
      (fun(th):«
        (fun(sofar):«
          let port_tmp_324 = Fusion.concl(th);
          let port_tmp_325 = Fusion.freesl(Fusion.hyp(th));
          get_heads(port_tmp_325)(port_tmp_324)(sofar)
        »)
      »)
    »;
    (block:«
      let APP_CONV:«
        let th = Tactics.prove([Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"f\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"f\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Comb\",[\"Const\",\"I\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]]]]],[\"Var\",\"f\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]]]]]]"), Simp.REWRITE_TAC(PairList.cons(Trivia.I_THM,PairList []))]);
        Simp.REWR_CONV(th)
      »;
      (block:«
        fun APP_N_CONV(n):«
          (fun(tm):«
            if Host.hol_equal(n)(1)
            | APP_CONV(tm)
            | Equal.THENC(Equal.RATOR_CONV(APP_N_CONV(Host.hol_sub(n)(1))))(APP_CONV)(tm)
          »)
        »;
        (block:«
          fun FOL_CONV(hddata):«
            (fun(tm):«
              if Basics.is_forall(tm)
              | Equal.BINDER_CONV(FOL_CONV(hddata))(tm)
              | (block:«
                if (Basics.is_conj(tm) || Basics.is_disj(tm))
                | Equal.BINOP_CONV(FOL_CONV(hddata))(tm)
                | (block:«
                  let [op, args] = Basics.strip_comb(tm);
                  (block:«
                    let th:«
                      let port_tmp_326 = Fusion.REFL(op);
                      let port_tmp_327 = map(FOL_CONV(hddata))(args);
                      let port_tmp_328 = C(curry(Fusion.MK_COMB));
                      rev_itlist(port_tmp_328)(port_tmp_327)(port_tmp_326)
                    »;
                    (block:«
                      let tm_prime = Fusion.rand(Fusion.concl(th));
                      (block:«
                        let n:«
                          try:«
                            (block:«
                              let port_tmp_329 = assoc(op)(hddata);
                              let port_tmp_330 = length(args);
                              Host.hol_sub(port_tmp_330)(port_tmp_329)
                            »);
                            ~catch port_tmp_331:«
                              match port_tmp_331
                              | Failure(_): 0
                              | port_tmp_331: Host.hol_raise(port_tmp_331)
                            »
                          »
                        »;
                        (block:«
                          if Host.hol_equal(n)(0)
                          | th
                          | Fusion.TRANS(th)(APP_N_CONV(n)(tm_prime))
                        »)
                      »)
                    »)
                  »)
                »)
              »)
            »)
          »;
          (block:«
            let GEN_FOL_CONV:«
              (fun([cheads, vheads]):«
                let hddata:«
                  if Host.hol_equal(vheads)(PairList [])
                  | (block:«
                    let hops = Host.setify(map(fst)(cheads));
                    (block:«
                      let getmin:«
                        (fun(h):«
                          let ns:«
                            mapfilter((fun([k, n]):«
                              if Host.hol_equal(k)(h)
                              | n
                              | Host.hol_apply_unit(fail)
                            »))(cheads)
                          »;
                          (block:«
                            if Host.hol_lt(length(ns))(2)
                            | Host.hol_apply_unit(fail)
                            | [h, end_itlist(Host.hol_min)(ns)]
                          »)
                        »)
                      »;
                      mapfilter(getmin)(hops)
                    »)
                  »)
                  | map((fun(t):«
                    if (Fusion.is_const(t) && Host.hol_equal(fst(Fusion.dest_const(t)))("="))
                    | [t, 2]
                    | [t, 0]
                  »))(Host.setify(map(fst)(append(vheads)(cheads))))
                »;
                FOL_CONV(hddata)
              »)
            »;
            (fun([asl, w] as gl):«
              let headsp = itlist(o(get_thm_heads)(snd))(asl)([PairList [], PairList []]);
              Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(GEN_FOL_CONV(headsp)))(gl)
            »)
          »)
        »)
      »)
    »)
  »)
»

fun PROP_ATOM_CONV(conv):«
  (fun(tm):«
    match tm
    | Fusion.Comb(Fusion.Const("!",_),Fusion.Abs(_,_)): Equal.BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Const("?",_),Fusion.Abs(_,_)): Equal.BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Const("?!",_),Fusion.Abs(_,_)): Equal.BINDER_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("/\\",_),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("\\/",_),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("==>",_),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Comb(Fusion.Const("=",Fusion.Tyapp("fun",PairList [Fusion.Tyapp("bool",PairList []), & PairList [_, & PairList []]])),_),_): Equal.BINOP_CONV(PROP_ATOM_CONV(conv))(tm)
    | Fusion.Comb(Fusion.Const("~",_),_): Equal.RAND_CONV(PROP_ATOM_CONV(conv))(tm)
    | _: Equal.TRY_CONV(conv)(tm)
  »)
»
