def FINITE_CLAUSES:
  prove(
    [
      (hol:
         const FINITE :: (1 -> bool) -> bool
         const UNIV :: 1 -> bool
         const FINITE_2 as FINITE :: (tybit0(A) -> bool) -> bool
         const UNIV_2 as UNIV :: tybit0(A) -> bool
         const FINITE_3 as FINITE :: (tybit1(A) -> bool) -> bool
         const UNIV_3 as UNIV :: tybit1(A) -> bool
         FINITE(UNIV) && (FINITE_2(UNIV_2) && FINITE_3(UNIV_3))),
      REWRITE_TAC(PairList [FINITE_1, FINITE_TYBIT0, FINITE_TYBIT1])
    ]
  )

def DIMINDEX_CONV:
  let PairList [pth_num, & PairList [pth0, & PairList [pth1, & PairList [pth_one, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        (hol:
           var n :: num
           var s :: A -> bool
           const dimindex :: (A -> bool) -> num
           const UNIV :: A -> bool
           const NUMERAL :: num -> num
           const dimindex_2 as dimindex :: (tybit0(A) -> bool) -> num
           const UNIV_2 as UNIV :: tybit0(A) -> bool
           const BIT0 :: num -> num
           const dimindex_3 as dimindex :: (tybit1(A) -> bool) -> num
           const UNIV_3 as UNIV :: tybit1(A) -> bool
           const BIT1 :: num -> num
           const dimindex_4 as dimindex :: (1 -> bool) -> num
           const UNIV_4 as UNIV :: 1 -> bool
           const _0 :: num
           (dimindex(UNIV) == n <=> dimindex(s) == NUMERAL(n))
             && ((dimindex(UNIV) == n <=> dimindex_2(UNIV_2) == BIT0(n))
                   && ((dimindex(UNIV) == n <=> dimindex_3(UNIV_3) == BIT1(n))
                         && dimindex_4(UNIV_4) == BIT1(_0)))),
        (
          (
            (
              (
                CONJ_TAC then_list \
                PairList [REWRITE_TAC(PairList [NUMERAL, dimindex]), ALL_TAC]
              ) then_tac \
              REWRITE_TAC(PairList [DIMINDEX_CLAUSES])
            ) then_tac \
            CONV_TAC(BITS_ELIM_CONV)
          ) then_tac \
          ARITH_TAC
        )
      ]
    )
  let nvar = hol: var n :: num; n
  fun calc_dimindex(ty):
    match ty
    | Tyapp("1",_): pth_one
    | Tyapp("tybit0",PairList [ty_prime, & _]):
        let th = calc_dimindex(ty_prime)
        let n = rand(concl(th))
        EQ_MP(INST(PairList [[n, nvar]])(INST_TYPE(PairList [[ty_prime, aty]])(pth0)))(th)
    | Tyapp("tybit1",PairList [ty_prime, & _]):
        let th = calc_dimindex(ty_prime)
        let n = rand(concl(th))
        EQ_MP(INST(PairList [[n, nvar]])(INST_TYPE(PairList [[ty_prime, aty]])(pth1)))(th)
    | _: fail()
  fun
  | (Comb(Const("dimindex",_),tm)):
      let uty = type_of(tm)
      let [_, PairList [sty, & _]] = dest_type(uty)
      let th = calc_dimindex(sty)
      let svar_2 = mk_var(["s", uty])
      let ntm_2 = rand(concl(th))
      let pth = INST(PairList [[tm, svar_2], [ntm_2, nvar]])(INST_TYPE(PairList [[sty, aty]])(pth_num))
      EQ_MP(pth)(th)
  | (_): failwith("DIMINDEX_CONV")

def HAS_SIZE_DIMINDEX_RULE:
  let pth:
    prove(
      [
        (hol:
           var n :: num
           const HAS_SIZE :: (A -> bool) -> num -> bool
           const UNIV :: A -> bool
           const FINITE :: (A -> bool) -> bool
           const dimindex :: (A -> bool) -> num
           HAS_SIZE(UNIV, n) <=> FINITE(UNIV) && dimindex(UNIV) == n),
        MESON_TAC(PairList [UNIV_HAS_SIZE_DIMINDEX, HAS_SIZE])
      ]
    )
  let htm_2:
    (hol:
       const HAS_SIZE :: (A -> bool) -> num -> bool
       const UNIV :: A -> bool
       HAS_SIZE(UNIV))
  let conv_2 = GEN_REWRITE_CONV(I)(PairList [pth])
  let rule_2 = o(EQT_ELIM)(GEN_REWRITE_CONV(I)(PairList [FINITE_CLAUSES]))
  fun(nty):
    let tm = mk_comb([inst(PairList [[nty, aty]])(htm_2), mk_numeral(dest_finty(nty))])
    let th1 = conv_2(tm)
    EQ_MP(SYM(th1))(
      CONJ(rule_2(lhand(rand(concl(th1)))))(DIMINDEX_CONV(lhand(rand(rand(concl(th1))))))
    )

def DIMINDEX_TAC = CONV_TAC(ONCE_DEPTH_CONV(DIMINDEX_CONV))

def DIMINDEX_2:
  prove(
    [
      (hol:
         const dimindex :: (tybit0(1) -> bool) -> num
         const UNIV :: tybit0(1) -> bool
         dimindex(UNIV) == (2 :: num)),
      (DIMINDEX_TAC then_tac REFL_TAC)
    ]
  )

def DIMINDEX_3:
  prove(
    [
      (hol:
         const dimindex :: (tybit1(1) -> bool) -> num
         const UNIV :: tybit1(1) -> bool
         dimindex(UNIV) == (3 :: num)),
      (DIMINDEX_TAC then_tac REFL_TAC)
    ]
  )

def DIMINDEX_4:
  prove(
    [
      (hol:
         const dimindex :: (tybit0(tybit0(1)) -> bool) -> num
         const UNIV :: tybit0(tybit0(1)) -> bool
         dimindex(UNIV) == (4 :: num)),
      (DIMINDEX_TAC then_tac REFL_TAC)
    ]
  )

def HAS_SIZE_2 = HAS_SIZE_DIMINDEX_RULE(hol_type: tybit0(1))

def HAS_SIZE_3 = HAS_SIZE_DIMINDEX_RULE(hol_type: tybit1(1))

def HAS_SIZE_4 = HAS_SIZE_DIMINDEX_RULE(hol_type: tybit0(tybit0(1)))

def FINITE_CART:
  prove(
    [
      (hol:
         const dimindex :: (N -> bool) -> num
         const UNIV :: N -> bool
         const FINITE :: (A -> bool) -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const FINITE_2 as FINITE :: (cart(A, N) -> bool) -> bool
         const GSPEC_2 as GSPEC :: (cart(A, N) -> bool) -> cart(A, N) -> bool
         const SETSPEC_2 as SETSPEC :: cart(A, N) -> bool -> cart(A, N) -> bool
         const dollar as "$" :: cart(A, N) -> num -> A
         forall P :: num -> A -> bool:
           (forall i :: num:
              (1 :: num) <= i && i <= dimindex(UNIV)
                ==> FINITE(
                      GSPEC(
                        fun (gen_pvar_360 as "GEN%PVAR%360" :: A):
                          exists x :: A: SETSPEC(gen_pvar_360, P(i, x), x)
                      )
                    ))
             ==> FINITE_2(
                   GSPEC_2(
                     fun (gen_pvar_361 as "GEN%PVAR%361" :: cart(A, N)):
                       exists v :: cart(A, N):
                         SETSPEC_2(
                           gen_pvar_361,
                           forall i :: num:
                             (1 :: num) <= i && i <= dimindex(UNIV) ==> P(i, dollar(v, i)),
                           v
                         )
                   )
                 )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (GEN_TAC then_tac DISCH_TAC) then_tac \
                                        SUBGOAL_THEN(
                                          (hol:
                                             var P :: num -> A -> bool
                                             const dimindex :: (N -> bool) -> num
                                             const UNIV :: N -> bool
                                             const FINITE :: (cart(A, N) -> bool) -> bool
                                             const GSPEC :: (cart(A, N) -> bool) -> cart(A, N) -> bool
                                             const SETSPEC :: cart(A, N) -> bool -> cart(A, N) -> bool
                                             const dollar as "$" :: cart(A, N) -> num -> A
                                             const select as "@" :: (A -> bool) -> A
                                             forall n :: num:
                                               n <= dimindex(UNIV)
                                                 ==> FINITE(
                                                       GSPEC(
                                                         fun (gen_pvar_359 as "GEN%PVAR%359" :: cart(A, N)):
                                                           exists v :: cart(A, N):
                                                             SETSPEC(
                                                               gen_pvar_359,
                                                               (forall i :: num:
                                                                  (1 :: num) <= i && (i <= dimindex(UNIV) && i <= n)
                                                                    ==> P(i, dollar(v, i)))
                                                                 && (forall i :: num:
                                                                       (1 :: num) <= i && (i <= dimindex(UNIV) && n < i)
                                                                         ==> dollar(v, i) == select(fun (x :: A): #false)),
                                                               v
                                                             )
                                                       )
                                                     ))
                                        )(
                                          o(MP_TAC)(
                                            SPEC(
                                              (hol:
                                                 const dimindex :: (N -> bool) -> num
                                                 const UNIV :: N -> bool
                                                 dimindex(UNIV))
                                            )
                                          )
                                        )
                                      ) then_tac \
                                      REWRITE_TAC(PairList [LE_REFL, LET_ANTISYM])
                                    ) then_tac \
                                    INDUCT_TAC
                                  ) then_list \
                                  PairList [
                                    (
                                      (
                                        (
                                          REWRITE_TAC(
                                            PairList [
                                              ARITH_RULE(
                                                (hol:
                                                   var i :: num
                                                   var n :: num
                                                   (1 :: num) <= i && (i <= n && i <= (0 :: num)) <=> #false)
                                              )
                                            ]
                                          ) then_tac \
                                          SIMP_TAC(
                                            PairList [
                                              ARITH_RULE(
                                                (hol:
                                                   var i :: num
                                                   var n :: num
                                                   (1 :: num) <= i && (i <= n && (0 :: num) < i) <=> (1 :: num) <= i && i <= n)
                                              )
                                            ]
                                          )
                                        ) then_tac \
                                        SUBGOAL_THEN(
                                          (hol:
                                             const GSPEC :: (cart(A, N) -> bool) -> cart(A, N) -> bool
                                             const SETSPEC :: cart(A, N) -> bool -> cart(A, N) -> bool
                                             const dimindex :: (N -> bool) -> num
                                             const UNIV :: N -> bool
                                             const dollar as "$" :: cart(A, N) -> num -> A
                                             const select as "@" :: (A -> bool) -> A
                                             const INSERT :: cart(A, N) -> (cart(A, N) -> bool) -> cart(A, N) -> bool
                                             const lambda :: (num -> A) -> cart(A, N)
                                             const EMPTY :: cart(A, N) -> bool
                                             GSPEC(
                                               fun (gen_pvar_358 as "GEN%PVAR%358" :: cart(A, N)):
                                                 exists v :: cart(A, N):
                                                   SETSPEC(
                                                     gen_pvar_358,
                                                     forall i :: num:
                                                       (1 :: num) <= i && i <= dimindex(UNIV)
                                                         ==> dollar(v, i) == select(fun (x :: A): #false),
                                                     v
                                                   )
                                             )
                                               == INSERT(lambda(fun (i :: num): select(fun (x :: A): #false)), EMPTY))
                                        )((fun(th): SIMP_TAC(PairList [FINITE_RULES, th])))
                                      ) then_tac \
                                      SIMP_TAC(PairList [EXTENSION, IN_SING, IN_ELIM_THM, CART_EQ, LAMBDA_BETA])
                                    ),
                                    ALL_TAC
                                  ]
                                ) then_tac \
                                DISCH_TAC
                              ) then_tac \
                              MATCH_MP_TAC(FINITE_SUBSET)
                            ) then_tac \
                            EXISTS_TAC(
                              (hol:
                                 var n :: num
                                 var P :: num -> A -> bool
                                 const IMAGE :: (pair(A, cart(A, N)) -> cart(A, N)) -> (pair(A, cart(A, N)) -> bool) -> cart(A, N) -> bool
                                 const GABS :: ((pair(A, cart(A, N)) -> cart(A, N)) -> bool) -> pair(A, cart(A, N)) -> cart(A, N)
                                 const GEQ :: cart(A, N) -> cart(A, N) -> bool
                                 const comma as "," :: A -> cart(A, N) -> pair(A, cart(A, N))
                                 const lambda :: (num -> A) -> cart(A, N)
                                 const SUC :: num -> num
                                 const dollar as "$" :: cart(A, N) -> num -> A
                                 const GSPEC :: (pair(A, cart(A, N)) -> bool) -> pair(A, cart(A, N)) -> bool
                                 const SETSPEC :: pair(A, cart(A, N)) -> bool -> pair(A, cart(A, N)) -> bool
                                 const IN :: A -> (A -> bool) -> bool
                                 const GSPEC_2 as GSPEC :: (A -> bool) -> A -> bool
                                 const SETSPEC_2 as SETSPEC :: A -> bool -> A -> bool
                                 const IN_2 as IN :: cart(A, N) -> (cart(A, N) -> bool) -> bool
                                 const GSPEC_3 as GSPEC :: (cart(A, N) -> bool) -> cart(A, N) -> bool
                                 const SETSPEC_3 as SETSPEC :: cart(A, N) -> bool -> cart(A, N) -> bool
                                 const dimindex :: (N -> bool) -> num
                                 const UNIV :: N -> bool
                                 const select as "@" :: (A -> bool) -> A
                                 IMAGE(
                                   GABS(
                                     fun (f :: pair(A, cart(A, N)) -> cart(A, N)):
                                       forall (x :: A, v :: cart(A, N)):
                                         GEQ(f(comma(x, v)), lambda(fun (i :: num): if i == SUC(n) | x | dollar(v, i)))
                                   ),
                                   GSPEC(
                                     fun (gen_pvar_357 as "GEN%PVAR%357" :: pair(A, cart(A, N))):
                                       exists (x :: A, v :: cart(A, N)):
                                         SETSPEC(
                                           gen_pvar_357,
                                           IN(
                                             x,
                                             GSPEC_2(
                                               fun (gen_pvar_355 as "GEN%PVAR%355" :: A):
                                                 exists x :: A: SETSPEC_2(gen_pvar_355, P(SUC(n), x), x)
                                             )
                                           )
                                             && IN_2(
                                                  v,
                                                  GSPEC_3(
                                                    fun (gen_pvar_356 as "GEN%PVAR%356" :: cart(A, N)):
                                                      exists v :: cart(A, N):
                                                        SETSPEC_3(
                                                          gen_pvar_356,
                                                          (forall i :: num:
                                                             (1 :: num) <= i && (i <= dimindex(UNIV) && i <= n)
                                                               ==> P(i, dollar(v, i)))
                                                            && (forall i :: num:
                                                                  (1 :: num) <= i && (i <= dimindex(UNIV) && n < i)
                                                                    ==> dollar(v, i) == select(fun (x :: A): #false)),
                                                          v
                                                        )
                                                  )
                                                ),
                                           comma(x, v)
                                         )
                                   )
                                 ))
                            )
                          ) then_tac \
                          CONJ_TAC
                        ) then_list \
                        PairList [
                          (
                            MATCH_MP_TAC(FINITE_IMAGE) then_tac \
                            ASM_SIMP_TAC(
                              PairList [
                                FINITE_PRODUCT,
                                ARITH_RULE(
                                  (hol:
                                     var n :: num
                                     const SUC :: num -> num
                                     (1 :: num) <= SUC(n))
                                ),
                                ARITH_RULE(
                                  (hol:
                                     var n :: num
                                     var m :: num
                                     const SUC :: num -> num
                                     SUC(n) <= m ==> n <= m)
                                )
                              ]
                            )
                          ),
                          ALL_TAC
                        ]
                      ) then_tac \
                      REWRITE_TAC(PairList [SUBSET, IN_IMAGE, IN_ELIM_PAIR_THM, EXISTS_PAIR_THM])
                    ) then_tac \
                    X_GEN_TAC(hol: var v :: cart(A, N); v)
                  ) then_tac \
                  REWRITE_TAC(PairList [IN_ELIM_THM])
                ) then_tac \
                STRIP_TAC
              ) then_tac \
              EXISTS_TAC(
                (hol:
                   var v :: cart(A, N)
                   var n :: num
                   const dollar as "$" :: cart(A, N) -> num -> A
                   const SUC :: num -> num
                   dollar(v, SUC(n)))
              )
            ) then_tac \
            EXISTS_TAC(
              (hol:
                 var n :: num
                 var v :: cart(A, N)
                 const lambda :: (num -> A) -> cart(A, N)
                 const SUC :: num -> num
                 const select as "@" :: (A -> bool) -> A
                 const dollar as "$" :: cart(A, N) -> num -> A
                 lambda(fun (i :: num): if i == SUC(n) | select(fun (x :: A): #false) | dollar(v, i)))
            )
          ) then_tac \
          SIMP_TAC(
            PairList [
              CART_EQ,
              LAMBDA_BETA,
              ARITH_RULE(
                (hol:
                   var i :: num
                   var n :: num
                   const SUC :: num -> num
                   i <= n ==> i != SUC(n))
              )
            ]
          )
        ) then_tac \
        ASM_MESON_TAC(
          PairList [
            LE,
            ARITH_RULE(
              (hol:
                 var n :: num
                 const SUC :: num -> num
                 (1 :: num) <= SUC(n))
            ),
            ARITH_RULE(
              (hol:
                 var n :: num
                 var i :: num
                 const SUC :: num -> num
                 n < i && i != SUC(n) ==> SUC(n) < i)
            )
          ]
        )
      )
    ]
  )

def HAS_SIZE_CART_UNIV:
  prove(
    [
      (hol:
         const HAS_SIZE :: (A -> bool) -> num -> bool
         const UNIV :: A -> bool
         const HAS_SIZE_2 as HAS_SIZE :: (cart(A, N) -> bool) -> num -> bool
         const UNIV_2 as UNIV :: cart(A, N) -> bool
         const EXP :: num -> num -> num
         const dimindex :: (N -> bool) -> num
         const UNIV_3 as UNIV :: N -> bool
         forall m :: num: HAS_SIZE(UNIV, m) ==> HAS_SIZE_2(UNIV_2, EXP(m, dimindex(UNIV_3)))),
      (
        (
          REPEAT(STRIP_TAC) then_tac \
          SUBGOAL_THEN(
            (hol:
               var m :: num
               const HAS_SIZE :: ((finite_image(N) -> A) -> bool) -> num -> bool
               const UNIV :: (finite_image(N) -> A) -> bool
               const EXP :: num -> num -> num
               const dimindex :: (N -> bool) -> num
               const UNIV_2 as UNIV :: N -> bool
               HAS_SIZE(UNIV, EXP(m, dimindex(UNIV_2))))
          )(MP_TAC)
        ) then_list \
        PairList [
          ASM_SIMP_TAC(PairList [HAS_SIZE_FUNSPACE_UNIV, HAS_SIZE_FINITE_IMAGE]),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          DISCH_THEN(
                            o(
                              o(MP_TAC)(
                                ISPEC(
                                  (hol: const mk_cart :: (finite_image(N) -> A) -> cart(A, N); mk_cart)
                                )
                              )
                            )(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ_ALT])(HAS_SIZE_IMAGE_INJ)))
                          ) then_tac \
                          REWRITE_TAC(PairList [IN_UNIV])
                        ) then_tac \
                        ANTS_TAC
                      ) then_list \
                      PairList [MESON_TAC(PairList [cart_tybij]), MATCH_MP_TAC(EQ_IMP)]
                    ) then_tac \
                    AP_THM_TAC
                  ) then_tac \
                  AP_TERM_TAC
                ) then_tac \
                MATCH_MP_TAC(SURJECTIVE_IMAGE_EQ)
              ) then_tac \
              REWRITE_TAC(PairList [IN_UNIV])
            ) then_tac \
            MESON_TAC(PairList [cart_tybij])
          )
        ]
      )
    ]
  )

def CARD_CART_UNIV:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const UNIV :: A -> bool
         const CARD :: (cart(A, N) -> bool) -> num
         const UNIV_2 as UNIV :: cart(A, N) -> bool
         const EXP :: num -> num -> num
         const CARD_2 as CARD :: (A -> bool) -> num
         const dimindex :: (N -> bool) -> num
         const UNIV_3 as UNIV :: N -> bool
         FINITE(UNIV) ==> CARD(UNIV_2) == EXP(CARD_2(UNIV), dimindex(UNIV_3))),
      MESON_TAC(PairList [HAS_SIZE_CART_UNIV, HAS_SIZE])
    ]
  )

def FINITE_CART_UNIV:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const UNIV :: A -> bool
         const FINITE_2 as FINITE :: (cart(A, N) -> bool) -> bool
         const UNIV_2 as UNIV :: cart(A, N) -> bool
         FINITE(UNIV) ==> FINITE_2(UNIV_2)),
      MESON_TAC(PairList [HAS_SIZE_CART_UNIV, HAS_SIZE])
    ]
  )

def vector:
  new_definition(
    (hol:
       var vector :: list(A) -> cart(A, N)
       var l :: list(A)
       const lambda :: (num -> A) -> cart(A, N)
       const EL :: num -> list(A) -> A
       vector(l) == lambda(fun (i :: num): EL(i - (1 :: num), l)))
  )

def IN_ELIM_PASTECART_THM:
  prove(
    [
      (hol:
         const IN :: cart(A, finite_sum(M, N)) -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         const GSPEC :: (cart(A, finite_sum(M, N)) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const SETSPEC :: cart(A, finite_sum(M, N)) -> bool -> cart(A, finite_sum(M, N)) -> bool
         forall (P :: cart(A, M) -> cart(A, N) -> bool, a :: cart(A, M), b :: cart(A, N)):
           IN(
             pastecart(a, b),
             GSPEC(
               fun (gen_pvar_362 as "GEN%PVAR%362" :: cart(A, finite_sum(M, N))):
                 exists (x :: cart(A, M), y :: cart(A, N)):
                   SETSPEC(gen_pvar_362, P(x, y), pastecart(x, y))
             )
           )
             <=> P(a, b)),
      (
        REWRITE_TAC(PairList [IN_ELIM_THM, PASTECART_EQ, FSTCART_PASTECART, SNDCART_PASTECART]) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

Host.parse_as_infix(["PCROSS", [22, "right"]])

def PCROSS:
  new_definition(
    (hol:
       var PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
       var s :: cart(A, M) -> bool
       var t :: cart(A, N) -> bool
       const GSPEC :: (cart(A, finite_sum(M, N)) -> bool) -> cart(A, finite_sum(M, N)) -> bool
       const SETSPEC :: cart(A, finite_sum(M, N)) -> bool -> cart(A, finite_sum(M, N)) -> bool
       const IN :: cart(A, M) -> (cart(A, M) -> bool) -> bool
       const IN_2 as IN :: cart(A, N) -> (cart(A, N) -> bool) -> bool
       const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
       PCROSS(s, t)
         == GSPEC(
              fun (gen_pvar_363 as "GEN%PVAR%363" :: cart(A, finite_sum(M, N))):
                exists (x :: cart(A, M), y :: cart(A, N)):
                  SETSPEC(gen_pvar_363, IN(x, s) && IN_2(y, t), pastecart(x, y))
            ))
  )

def FORALL_IN_PCROSS:
  prove(
    [
      (hol:
         var s :: cart(A, M) -> bool
         var t :: cart(A, N) -> bool
         var P :: cart(A, finite_sum(M, N)) -> bool
         const IN :: cart(A, finite_sum(M, N)) -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const IN_2 as IN :: cart(A, M) -> (cart(A, M) -> bool) -> bool
         const IN_3 as IN :: cart(A, N) -> (cart(A, N) -> bool) -> bool
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         (forall z :: cart(A, finite_sum(M, N)): IN(z, PCROSS(s, t)) ==> P(z))
           <=> (forall (x :: cart(A, M), y :: cart(A, N)):
                  IN_2(x, s) && IN_3(y, t) ==> P(pastecart(x, y)))),
      REWRITE_TAC(PairList [PCROSS, FORALL_IN_GSPEC])
    ]
  )

def EXISTS_IN_PCROSS:
  prove(
    [
      (hol:
         var s :: cart(A, M) -> bool
         var t :: cart(A, N) -> bool
         var P :: cart(A, finite_sum(M, N)) -> bool
         const IN :: cart(A, finite_sum(M, N)) -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const IN_2 as IN :: cart(A, M) -> (cart(A, M) -> bool) -> bool
         const IN_3 as IN :: cart(A, N) -> (cart(A, N) -> bool) -> bool
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         (exists z :: cart(A, finite_sum(M, N)): IN(z, PCROSS(s, t)) && P(z))
           <=> (exists (x :: cart(A, M), y :: cart(A, N)):
                  IN_2(x, s) && (IN_3(y, t) && P(pastecart(x, y))))),
      REWRITE_TAC(PairList [PCROSS, EXISTS_IN_GSPEC, CONJ_ASSOC])
    ]
  )

def PASTECART_IN_PCROSS:
  prove(
    [
      (hol:
         const IN :: cart(A, finite_sum(M, N)) -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const IN_2 as IN :: cart(A, M) -> (cart(A, M) -> bool) -> bool
         const IN_3 as IN :: cart(A, N) -> (cart(A, N) -> bool) -> bool
         forall (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool, x :: cart(A, M), y :: cart(A, N)):
           IN(pastecart(x, y), PCROSS(s, t)) <=> IN_2(x, s) && IN_3(y, t)),
      REWRITE_TAC(PairList [PCROSS, IN_ELIM_PASTECART_THM])
    ]
  )

def PCROSS_EQ_EMPTY:
  prove(
    [
      (hol:
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const EMPTY :: cart(A, finite_sum(M, N)) -> bool
         const EMPTY_2 as EMPTY :: cart(A, M) -> bool
         const EMPTY_3 as EMPTY :: cart(A, N) -> bool
         forall (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool):
           PCROSS(s, t) == EMPTY <=> s == EMPTY_2 || t == EMPTY_3),
      (REWRITE_TAC(PairList [PCROSS]) then_tac SET_TAC(PairList []))
    ]
  )

def PCROSS_EMPTY:
  prove(
    [
      (hol:
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const EMPTY :: cart(A, N) -> bool
         const EMPTY_2 as EMPTY :: cart(A, finite_sum(M, N)) -> bool
         const EMPTY_3 as EMPTY :: cart(A, M) -> bool
         (forall s :: cart(A, M) -> bool: PCROSS(s, EMPTY) == EMPTY_2)
           && (forall t :: cart(A, N) -> bool: PCROSS(EMPTY_3, t) == EMPTY_2)),
      REWRITE_TAC(PairList [PCROSS_EQ_EMPTY])
    ]
  )

def PCROSS_SING:
  prove(
    [
      (hol:
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const INSERT :: cart(A, M) -> (cart(A, M) -> bool) -> cart(A, M) -> bool
         const EMPTY :: cart(A, M) -> bool
         const INSERT_2 as INSERT :: cart(A, N) -> (cart(A, N) -> bool) -> cart(A, N) -> bool
         const EMPTY_2 as EMPTY :: cart(A, N) -> bool
         const INSERT_3 as INSERT :: cart(A, finite_sum(M, N)) -> (cart(A, finite_sum(M, N)) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         const EMPTY_3 as EMPTY :: cart(A, finite_sum(M, N)) -> bool
         forall (x :: cart(A, M), y :: cart(A, N)):
           PCROSS(INSERT(x, EMPTY), INSERT_2(y, EMPTY_2)) == INSERT_3(pastecart(x, y), EMPTY_3)),
      REWRITE_TAC(PairList [EXTENSION, FORALL_PASTECART, IN_SING, PASTECART_IN_PCROSS, PASTECART_INJ])
    ]
  )

def SUBSET_PCROSS:
  prove(
    [
      (hol:
         const SUBSET :: (cart(A, finite_sum(M, N)) -> bool) -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const EMPTY :: cart(A, M) -> bool
         const EMPTY_2 as EMPTY :: cart(A, N) -> bool
         const SUBSET_2 as SUBSET :: (cart(A, M) -> bool) -> (cart(A, M) -> bool) -> bool
         const SUBSET_3 as SUBSET :: (cart(A, N) -> bool) -> (cart(A, N) -> bool) -> bool
         forall (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool, s_prime as "s'" :: cart(A, M) -> bool, t_prime as "t'" :: cart(A, N) -> bool):
           SUBSET(PCROSS(s, t), PCROSS(s_prime, t_prime))
             <=> s == EMPTY || (t == EMPTY_2 || SUBSET_2(s, s_prime) && SUBSET_3(t, t_prime))),
      (
        SIMP_TAC(
          PairList [
            PCROSS,
            EXTENSION,
            IN_ELIM_PASTECART_THM,
            SUBSET,
            FORALL_PASTECART,
            PASTECART_IN_PCROSS,
            NOT_IN_EMPTY
          ]
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def PCROSS_MONO:
  prove(
    [
      (hol:
         const SUBSET :: (cart(A, M) -> bool) -> (cart(A, M) -> bool) -> bool
         const SUBSET_2 as SUBSET :: (cart(A, N) -> bool) -> (cart(A, N) -> bool) -> bool
         const SUBSET_3 as SUBSET :: (cart(A, finite_sum(M, N)) -> bool) -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         forall (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool, s_prime as "s'" :: cart(A, M) -> bool, t_prime as "t'" :: cart(A, N) -> bool):
           SUBSET(s, s_prime) && SUBSET_2(t, t_prime)
             ==> SUBSET_3(PCROSS(s, t), PCROSS(s_prime, t_prime))),
      SIMP_TAC(PairList [SUBSET_PCROSS])
    ]
  )

def PCROSS_EQ:
  prove(
    [
      (hol:
         const PCROSS :: (cart(real, M) -> bool) -> (cart(real, N) -> bool) -> cart(real, finite_sum(M, N)) -> bool
         const EMPTY :: cart(real, M) -> bool
         const EMPTY_2 as EMPTY :: cart(real, N) -> bool
         forall (s :: cart(real, M) -> bool, s_prime as "s'" :: cart(real, M) -> bool, t :: cart(real, N) -> bool, t_prime as "t'" :: cart(real, N) -> bool):
           PCROSS(s, t) == PCROSS(s_prime, t_prime)
             <=> ((s == EMPTY || t == EMPTY_2) && (s_prime == EMPTY || t_prime == EMPTY_2)
                    || s == s_prime && t == t_prime)),
      (
        REWRITE_TAC(PairList [GSYM(SUBSET_ANTISYM_EQ), SUBSET_PCROSS]) then_tac \
        SET_TAC(PairList [])
      )
