def HAS_SIZE_CART_UNIV:
  prove(
    [
      hol_term(Forall(
        "m",
        Num,
        Implies(
          App(
            Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
            [Const("UNIV", Fun(Tvar("A"), Bool)), Ref("m")]
          ),
          App(
            Const("HAS_SIZE", Fun(Fun(Tyapp("cart", [Tvar("A"), Tvar("N")]), Bool), Fun(Num, Bool))),
            [
              Const("UNIV", Fun(Tyapp("cart", [Tvar("A"), Tvar("N")]), Bool)),
              App(
                Const("EXP", Fun(Num, Fun(Num, Num))),
                [
                  Ref("m"),
                  App(Const("dimindex", Fun(Fun(Tvar("N"), Bool), Num)), [Const("UNIV", Fun(Tvar("N"), Bool))])
                ]
              )
            ]
          )
        )
      )),
      (
        (
          REPEAT(STRIP_TAC) then_tac \
          SUBGOAL_THEN(
            hol_term(App(
              Const(
                "HAS_SIZE",
                Fun(Fun(Fun(Tyapp("finite_image", [Tvar("N")]), Tvar("A")), Bool), Fun(Num, Bool))
              ),
              [
                Const("UNIV", Fun(Fun(Tyapp("finite_image", [Tvar("N")]), Tvar("A")), Bool)),
                App(
                  Const("EXP", Fun(Num, Fun(Num, Num))),
                  [
                    Var("m", Num),
                    App(Const("dimindex", Fun(Fun(Tvar("N"), Bool), Num)), [Const("UNIV", Fun(Tvar("N"), Bool))])
                  ]
                )
              ]
            ))
          )(MP_TAC)
        ) then_list \
        PairList [
          ASM_SIMP_TAC(PairList [HAS_SIZE_FUNSPACE_UNIV, HAS_SIZE_FINITE_IMAGE]),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          DISCH_THEN(
                            o(
                              o(MP_TAC)(
                                ISPEC(
                                  hol_term(Const(
                                    "mk_cart",
                                    Fun(Fun(Tyapp("finite_image", [Tvar("N")]), Tvar("A")), Tyapp("cart", [Tvar("A"), Tvar("N")]))
                                  ))
                                )
                              )
                            )(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ_ALT])(HAS_SIZE_IMAGE_INJ)))
                          ) then_tac \
                          REWRITE_TAC(PairList [IN_UNIV])
                        ) then_tac \
                        ANTS_TAC
                      ) then_list \
                      PairList [MESON_TAC(PairList [cart_tybij]), MATCH_MP_TAC(EQ_IMP)]
                    ) then_tac \
                    AP_THM_TAC
                  ) then_tac \
                  AP_TERM_TAC
                ) then_tac \
                MATCH_MP_TAC(SURJECTIVE_IMAGE_EQ)
              ) then_tac \
              REWRITE_TAC(PairList [IN_UNIV])
            ) then_tac \
            MESON_TAC(PairList [cart_tybij])
          )
        ]
      )
    ]
  )

