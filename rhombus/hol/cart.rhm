def [cart_PCROSS_UNIONS_UNIONS_v2, PCROSS_UNIONS]:
  o(CONJ_PAIR)(prove)(
    [
      (hol:
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const UNIONS :: ((cart(A, M) -> bool) -> bool) -> cart(A, M) -> bool
         const UNIONS_2 as UNIONS :: ((cart(A, N) -> bool) -> bool) -> cart(A, N) -> bool
         const UNIONS_3 as UNIONS :: ((cart(A, finite_sum(M, N)) -> bool) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const GSPEC :: ((cart(A, finite_sum(M, N)) -> bool) -> bool) -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const SETSPEC :: (cart(A, finite_sum(M, N)) -> bool) -> bool -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const IN :: (cart(A, M) -> bool) -> ((cart(A, M) -> bool) -> bool) -> bool
         const IN_2 as IN :: (cart(A, N) -> bool) -> ((cart(A, N) -> bool) -> bool) -> bool
         (forall (f :: (cart(A, M) -> bool) -> bool, g :: (cart(A, N) -> bool) -> bool):
            PCROSS(UNIONS(f), UNIONS_2(g))
              == UNIONS_3(
                   GSPEC(
                     fun (gen_pvar_364 as "GEN%PVAR%364" :: cart(A, finite_sum(M, N)) -> bool):
                       exists (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool):
                         SETSPEC(gen_pvar_364, IN(s, f) && IN_2(t, g), PCROSS(s, t))
                   )
                 ))
           && ((forall (s :: cart(A, M) -> bool, f :: (cart(A, N) -> bool) -> bool):
                  PCROSS(s, UNIONS_2(f))
                    == UNIONS_3(
                         GSPEC(
                           fun (gen_pvar_365 as "GEN%PVAR%365" :: cart(A, finite_sum(M, N)) -> bool):
                             exists t :: cart(A, N) -> bool:
                               SETSPEC(gen_pvar_365, IN_2(t, f), PCROSS(s, t))
                         )
                       ))
                 && (forall (f :: (cart(A, M) -> bool) -> bool, t :: cart(A, N) -> bool):
                       PCROSS(UNIONS(f), t)
                         == UNIONS_3(
                              GSPEC(
                                fun (gen_pvar_366 as "GEN%PVAR%366" :: cart(A, finite_sum(M, N)) -> bool):
                                  exists s :: cart(A, M) -> bool:
                                    SETSPEC(gen_pvar_366, IN(s, f), PCROSS(s, t))
                              )
                            )))),
      (
        REWRITE_TAC(
          PairList [
            UNIONS_GSPEC,
            EXTENSION,
            FORALL_PASTECART,
            IN_ELIM_THM,
            PASTECART_IN_PCROSS
          ]
        ) then_tac \
        SET_TAC(PairList [])
      )
    ]
  )

def [cart_PCROSS_INTERS_INTERS_v2, PCROSS_INTERS]:
  o(CONJ_PAIR)(prove)(
    [
      (hol:
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const INTERS :: ((cart(A, M) -> bool) -> bool) -> cart(A, M) -> bool
         const INTERS_2 as INTERS :: ((cart(A, N) -> bool) -> bool) -> cart(A, N) -> bool
         const EMPTY :: (cart(A, M) -> bool) -> bool
         const INTERS_3 as INTERS :: ((cart(A, finite_sum(M, N)) -> bool) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const GSPEC :: ((cart(A, finite_sum(M, N)) -> bool) -> bool) -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const SETSPEC :: (cart(A, finite_sum(M, N)) -> bool) -> bool -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const IN :: (cart(A, N) -> bool) -> ((cart(A, N) -> bool) -> bool) -> bool
         const UNIV :: cart(A, M) -> bool
         const EMPTY_2 as EMPTY :: (cart(A, N) -> bool) -> bool
         const IN_2 as IN :: (cart(A, M) -> bool) -> ((cart(A, M) -> bool) -> bool) -> bool
         const UNIV_2 as UNIV :: cart(A, N) -> bool
         (forall (f :: (cart(A, M) -> bool) -> bool, g :: (cart(A, N) -> bool) -> bool):
            PCROSS(INTERS(f), INTERS_2(g))
              == (if f == EMPTY
                  | INTERS_3(
                      GSPEC(
                        fun (gen_pvar_367 as "GEN%PVAR%367" :: cart(A, finite_sum(M, N)) -> bool):
                          exists t :: cart(A, N) -> bool:
                            SETSPEC(gen_pvar_367, IN(t, g), PCROSS(UNIV, t))
                      )
                    )
                  | if g == EMPTY_2
                    | INTERS_3(
                        GSPEC(
                          fun (gen_pvar_368 as "GEN%PVAR%368" :: cart(A, finite_sum(M, N)) -> bool):
                            exists s :: cart(A, M) -> bool:
                              SETSPEC(gen_pvar_368, IN_2(s, f), PCROSS(s, UNIV_2))
                        )
                      )
                    | INTERS_3(
                        GSPEC(
                          fun (gen_pvar_369 as "GEN%PVAR%369" :: cart(A, finite_sum(M, N)) -> bool):
                            exists (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool):
                              SETSPEC(gen_pvar_369, IN_2(s, f) && IN(t, g), PCROSS(s, t))
                        )
                      )))
           && ((forall (s :: cart(A, M) -> bool, f :: (cart(A, N) -> bool) -> bool):
                  PCROSS(s, INTERS_2(f))
                    == (if f == EMPTY_2
                        | PCROSS(s, UNIV_2)
                        | INTERS_3(
                            GSPEC(
                              fun (gen_pvar_370 as "GEN%PVAR%370" :: cart(A, finite_sum(M, N)) -> bool):
                                exists t :: cart(A, N) -> bool:
                                  SETSPEC(gen_pvar_370, IN(t, f), PCROSS(s, t))
                            )
                          )))
                 && (forall (f :: (cart(A, M) -> bool) -> bool, t :: cart(A, N) -> bool):
                       PCROSS(INTERS(f), t)
                         == (if f == EMPTY
                             | PCROSS(UNIV, t)
                             | INTERS_3(
                                 GSPEC(
                                   fun (gen_pvar_371 as "GEN%PVAR%371" :: cart(A, finite_sum(M, N)) -> bool):
                                     exists s :: cart(A, M) -> bool:
                                       SETSPEC(gen_pvar_371, IN_2(s, f), PCROSS(s, t))
                                 )
                               ))))),
      (
        (
          (
            REPEAT(STRIP_TAC) then_tac \
            REPEAT((COND_CASES_TAC then_tac REWRITE_TAC(PairList [])))
          ) then_tac \
          ASM_REWRITE_TAC(
            PairList [
              INTERS_GSPEC,
              EXTENSION,
              FORALL_PASTECART,
              IN_ELIM_THM,
              PASTECART_IN_PCROSS,
              NOT_IN_EMPTY
            ]
          )
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

