def finite_sum_tybij:
  let th:
    prove(
      [
        hol_term(Exists(
          "x",
          Num,
          App(
            Const("IN", Fun(Num, Fun(Fun(Num, Bool), Bool))),
            [
              Ref("x"),
              App(
                Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                [
                  App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                  App(
                    Const("+", Fun(Num, Fun(Num, Num))),
                    [
                      App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Const("UNIV", Fun(Tvar("A"), Bool))]),
                      App(Const("dimindex", Fun(Fun(Tvar("B"), Bool), Num)), [Const("UNIV", Fun(Tvar("B"), Bool))])
                    ]
                  )
                ]
              )
            ]
          )
        )),
        (
          EXISTS_TAC(
            hol_term(App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]))
          ) then_tac \
          SIMP_TAC(
            PairList [
              IN_NUMSEG,
              LE_REFL,
              DIMINDEX_GE_1,
              ARITH_RULE(
                hol_term(Implies(
                  App(
                    Const("<=", Fun(Num, Fun(Num, Bool))),
                    [
                      App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                      Var("a", Num)
                    ]
                  ),
                  App(
                    Const("<=", Fun(Num, Fun(Num, Bool))),
                    [
                      App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                      App(Const("+", Fun(Num, Fun(Num, Num))), [Var("a", Num), Var("b", Num)])
                    ]
                  )
                ))
              )
            ]
          )
        )
      ]
    )
  new_type_definition("finite_sum")(["mk_finite_sum", "dest_finite_sum"])(th)

