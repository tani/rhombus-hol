def HAS_SIZE_PCROSS:
  prove(
    [
      (hol:
         const HAS_SIZE :: (cart(A, M) -> bool) -> num -> bool
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         forall (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool, m :: num, n :: num):
           HAS_SIZE(s, m) && (HAS_SIZE :: (cart(A, N) -> bool) -> num -> bool)(t, n) ==> (HAS_SIZE :: (cart(A, finite_sum(M, N)) -> bool) -> num -> bool)(PCROSS(s, t), m * n)),
      (
