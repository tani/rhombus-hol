def CART_EQ_FULL:
  prove(
    [
      (hol:
         const #{$} :: cart(A, N) -> num -> A
         forall (x :: cart(A, N), y :: cart(A, N)):
           x == y <=> (forall i :: num: #{$}(x, i) == #{$}(y, i))),
      (
        ((REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac SIMP_TAC(PairList [])) then_tac \
        SIMP_TAC(PairList [CART_EQ])
      )
    ]
  )

def finite_sum_tybij:
  let th:
    prove(
      [
        (hol:
           const IN :: num -> (num -> bool) -> bool
           const #{..} :: num -> num -> num -> bool
           const dimindex :: (A -> bool) -> num
           const UNIV :: A -> bool
           exists x :: num: IN(x, #{..}((1 :: num), dimindex(UNIV) + (dimindex :: (B -> bool) -> num)((UNIV :: B -> bool))))),
        (
          EXISTS_TAC(
            (hol:
               (1 :: num))
          ) then_tac \
          SIMP_TAC(
            PairList [
              IN_NUMSEG,
              LE_REFL,
              DIMINDEX_GE_1,
              ARITH_RULE(
                (hol:
                   var a :: num
                   var b :: num
                   (1 :: num) <= a ==> (1 :: num) <= a + b)
              )
            ]
          )
        )
      ]
    )
  new_type_definition("finite_sum")(["mk_finite_sum", "dest_finite_sum"])(th)

def pastecart:
  new_definition(
    (hol:
       var pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
       var f :: cart(A, M)
       var g :: cart(A, N)
       const lambda :: (num -> A) -> cart(A, finite_sum(M, N))
       const dimindex :: (M -> bool) -> num
       const UNIV :: M -> bool
       const #{$} :: cart(A, M) -> num -> A
       pastecart(f, g)
         == lambda(
              fun (i :: num): if i <= dimindex(UNIV) | #{$}(f, i) | (#{$} :: cart(A, N) -> num -> A)(g, i - dimindex(UNIV))
            ))
  )

def fstcart:
  new_definition(
    (hol:
       var fstcart :: cart(A, finite_sum(M, N)) -> cart(A, M)
       var f :: cart(A, finite_sum(M, N))
       const lambda :: (num -> A) -> cart(A, M)
       const #{$} :: cart(A, finite_sum(M, N)) -> num -> A
       fstcart(f) == lambda(fun (i :: num): #{$}(f, i)))
  )

def sndcart:
  new_definition(
    (hol:
       var sndcart :: cart(A, finite_sum(M, N)) -> cart(A, N)
       var f :: cart(A, finite_sum(M, N))
       const lambda :: (num -> A) -> cart(A, N)
       const #{$} :: cart(A, finite_sum(M, N)) -> num -> A
       const dimindex :: (M -> bool) -> num
       const UNIV :: M -> bool
       sndcart(f) == lambda(fun (i :: num): #{$}(f, i + dimindex(UNIV))))
  )

def FINITE_SUM_IMAGE:
  prove(
    [
      (hol:
         const UNIV :: finite_sum(A, B) -> bool
         const IMAGE :: (num -> finite_sum(A, B)) -> (num -> bool) -> finite_sum(A, B) -> bool
         const mk_finite_sum :: num -> finite_sum(A, B)
         const #{..} :: num -> num -> num -> bool
         const dimindex :: (A -> bool) -> num
         UNIV == IMAGE(mk_finite_sum, #{..}((1 :: num), dimindex((UNIV :: A -> bool)) + (dimindex :: (B -> bool) -> num)((UNIV :: B -> bool))))),
      (
        REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_IMAGE]) then_tac \
        MESON_TAC(PairList [finite_sum_tybij])
      )
    ]
  )

def DIMINDEX_HAS_SIZE_FINITE_SUM:
  prove(
    [
      (hol:
         const HAS_SIZE :: (finite_sum(M, N) -> bool) -> num -> bool
         const UNIV :: finite_sum(M, N) -> bool
         const dimindex :: (M -> bool) -> num
         HAS_SIZE(UNIV, dimindex((UNIV :: M -> bool)) + (dimindex :: (N -> bool) -> num)((UNIV :: N -> bool)))),
      (
        (
          (
            (
              SIMP_TAC(PairList [FINITE_SUM_IMAGE]) then_tac \
              MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ)
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [DIMINDEX_UNIV])
          ) then_tac \
          REWRITE_TAC(PairList [HAS_SIZE_NUMSEG_1])
        ) then_tac \
        MESON_TAC(PairList [finite_sum_tybij])
      )
    ]
  )

def DIMINDEX_FINITE_SUM:
  prove(
    [
      (hol:
         const dimindex :: (finite_sum(M, N) -> bool) -> num
         const UNIV :: finite_sum(M, N) -> bool
         dimindex(UNIV) == (dimindex :: (M -> bool) -> num)((UNIV :: M -> bool)) + (dimindex :: (N -> bool) -> num)((UNIV :: N -> bool))),
      (
        GEN_REWRITE_TAC(LAND_CONV)(PairList [dimindex]) then_tac \
        REWRITE_TAC(PairList [REWRITE_RULE(PairList [HAS_SIZE])(DIMINDEX_HAS_SIZE_FINITE_SUM)])
      )
    ]
  )

def FSTCART_PASTECART:
  prove(
    [
      (hol:
         const fstcart :: cart(A, finite_sum(M, N)) -> cart(A, M)
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         forall (x :: cart(A, M), y :: cart(A, N)): fstcart(pastecart(x, y)) == x),
      SIMP_TAC(
        PairList [
          pastecart,
          fstcart,
          CART_EQ,
          LAMBDA_BETA,
          DIMINDEX_FINITE_SUM,
          ARITH_RULE(
            (hol:
               var a :: num
               var b :: num
               var c :: num
               a <= b ==> a <= b + c)
          )
        ]
      )
    ]
  )

def SNDCART_PASTECART:
  prove(
    [
      (hol:
         const sndcart :: cart(A, finite_sum(M, N)) -> cart(A, N)
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         forall (x :: cart(A, M), y :: cart(A, N)): sndcart(pastecart(x, y)) == y),
      (
        (
          (
            (
              SIMP_TAC(PairList [pastecart, sndcart, CART_EQ, LAMBDA_BETA]) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            W(
              (fun([_, w]): MP_TAC(PART_MATCH(o(lhs)(rand))(LAMBDA_BETA)(lhand(w))))
            )
          ) then_tac \
          ANTS_TAC
        ) then_list \
        PairList [
          (
            (
              REWRITE_TAC(PairList [DIMINDEX_FINITE_SUM]) then_tac \
              MATCH_MP_TAC(
                ARITH_RULE(
                  (hol:
                     var i :: num
                     var b :: num
                     var a :: num
                     (1 :: num) <= i && i <= b ==> (1 :: num) <= i + a && i + a <= a + b)
                )
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ),
          (
            (DISCH_THEN(SUBST1_TAC) then_tac REWRITE_TAC(PairList [])) then_tac \
            ASM_SIMP_TAC(
              PairList [
                ADD_SUB,
                ARITH_RULE(
                  (hol:
                     var i :: num
                     var a :: num
                     (1 :: num) <= i ==> !(i + a <= a))
                )
              ]
            )
          )
        ]
      )
    ]
  )

def PASTECART_FST_SND:
  prove(
    [
      (hol:
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         const fstcart :: cart(A, finite_sum(M, N)) -> cart(A, M)
         const sndcart :: cart(A, finite_sum(M, N)) -> cart(A, N)
         forall z :: cart(A, finite_sum(M, N)): pastecart(fstcart(z), sndcart(z)) == z),
      (
        (
          (
            (
              SIMP_TAC(PairList [pastecart, fstcart, sndcart, CART_EQ, LAMBDA_BETA]) then_tac \
              REPEAT(GEN_TAC)
            ) then_tac \
            COND_CASES_TAC
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            DIMINDEX_FINITE_SUM,
            LAMBDA_BETA,
            ARITH_RULE(
              (hol:
                 var i :: num
                 var a :: num
                 var b :: num
                 i <= a + b ==> i - a <= b)
            ),
            ARITH_RULE(
              (hol:
                 var i :: num
                 var a :: num
                 !(i <= a) ==> (1 :: num) <= i - a)
            ),
            ARITH_RULE(
              (hol:
                 var i :: num
                 var a :: num
                 !(i <= a) ==> i - a + a == i)
            )
          ]
        )
      )
    ]
  )

def PASTECART_EQ:
  prove(
    [
      (hol:
         const fstcart :: cart(A, finite_sum(M, N)) -> cart(A, M)
         const sndcart :: cart(A, finite_sum(M, N)) -> cart(A, N)
         forall (x :: cart(A, finite_sum(M, N)), y :: cart(A, finite_sum(M, N))):
           x == y <=> fstcart(x) == fstcart(y) && sndcart(x) == sndcart(y)),
      MESON_TAC(PairList [PASTECART_FST_SND])
    ]
  )

def FORALL_PASTECART:
  prove(
    [
      (hol:
         var P :: cart(A, finite_sum(M, N)) -> bool
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         (forall p :: cart(A, finite_sum(M, N)): P(p))
           <=> (forall (x :: cart(A, M), y :: cart(A, N)): P(pastecart(x, y)))),
      MESON_TAC(PairList [PASTECART_FST_SND, FSTCART_PASTECART, SNDCART_PASTECART])
    ]
  )

def EXISTS_PASTECART:
  prove(
    [
      (hol:
         var P :: cart(A, finite_sum(M, N)) -> bool
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         (exists p :: cart(A, finite_sum(M, N)): P(p))
           <=> (exists (x :: cart(A, M), y :: cart(A, N)): P(pastecart(x, y)))),
      MESON_TAC(PairList [PASTECART_FST_SND, FSTCART_PASTECART, SNDCART_PASTECART])
    ]
  )

def PASTECART_INJ:
  prove(
    [
      (hol:
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         forall (x :: cart(A, M), y :: cart(A, N), w :: cart(A, M), z :: cart(A, N)):
           pastecart(x, y) == pastecart(w, z) <=> x == w && y == z),
      REWRITE_TAC(PairList [PASTECART_EQ, FSTCART_PASTECART, SNDCART_PASTECART])
    ]
  )

def FSTCART_COMPONENT:
  prove(
    [
      (hol:
         const dimindex :: (M -> bool) -> num
         const UNIV :: M -> bool
         const #{$} :: cart(A, M) -> num -> A
         const fstcart :: cart(A, finite_sum(M, N)) -> cart(A, M)
         forall (x :: cart(A, finite_sum(M, N)), i :: num):
           (1 :: num) <= i && i <= dimindex(UNIV) ==> #{$}(fstcart(x), i) == (#{$} :: cart(A, finite_sum(M, N)) -> num -> A)(x, i)),
      SIMP_TAC(PairList [fstcart, LAMBDA_BETA])
    ]
  )

def SNDCART_COMPONENT:
  prove(
    [
      (hol:
         const dimindex :: (N -> bool) -> num
         const UNIV :: N -> bool
         const #{$} :: cart(A, N) -> num -> A
         const sndcart :: cart(A, finite_sum(M, N)) -> cart(A, N)
         forall (x :: cart(A, finite_sum(M, N)), i :: num):
           (1 :: num) <= i && i <= dimindex(UNIV)
             ==> #{$}(sndcart(x), i) == (#{$} :: cart(A, finite_sum(M, N)) -> num -> A)(x, i + (dimindex :: (M -> bool) -> num)((UNIV :: M -> bool)))),
      SIMP_TAC(PairList [sndcart, LAMBDA_BETA])
    ]
  )

def PASTECART_COMPONENT:
  prove(
    [
      (hol:
         const dimindex :: (M -> bool) -> num
         const UNIV :: M -> bool
         const #{$} :: cart(A, finite_sum(M, N)) -> num -> A
         const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
         (forall (u :: cart(A, M), v :: cart(A, N), i :: num):
            (1 :: num) <= i && i <= dimindex(UNIV) ==> #{$}(pastecart(u, v), i) == (#{$} :: cart(A, M) -> num -> A)(u, i))
           && (forall (u :: cart(A, M), v :: cart(A, N), i :: num):
                 dimindex(UNIV) + (1 :: num) <= i && i <= dimindex(UNIV) + (dimindex :: (N -> bool) -> num)((UNIV :: N -> bool))
                   ==> #{$}(pastecart(u, v), i) == (#{$} :: cart(A, N) -> num -> A)(v, i - dimindex(UNIV)))),
      (
        (
          (
            (REWRITE_TAC(PairList [pastecart]) then_tac CONJ_TAC) then_tac \
            REPEAT(GEN_TAC)
          ) then_tac \
          STRIP_TAC
        ) then_list \
        PairList [
          (
            (
              SUBGOAL_THEN(
                (hol:
                   var i :: num
                   const dimindex :: (finite_sum(M, N) -> bool) -> num
                   const UNIV :: finite_sum(M, N) -> bool
                   i <= dimindex(UNIV))
              )((fun(th): ASM_SIMP_TAC(PairList [LAMBDA_BETA, th]))) then_tac \
              REWRITE_TAC(PairList [DIMINDEX_FINITE_SUM])
            ) then_tac \
            ASM_ARITH_TAC
          ),
          (
            (
              (
                ASM_SIMP_TAC(
                  PairList [
                    LAMBDA_BETA,
                    DIMINDEX_FINITE_SUM,
                    ARITH_RULE(
                      (hol:
                         var i :: num
                         const dimindex :: (M -> bool) -> num
                         const UNIV :: M -> bool
                         dimindex(UNIV) + (1 :: num) <= i ==> (1 :: num) <= i)
                    )
                  ]
                ) then_tac \
                COND_CASES_TAC
              ) then_tac \
              REWRITE_TAC(PairList [])
            ) then_tac \
            ASM_ARITH_TAC
          )
        ]
      )
    ]
  )

def finite_diff_tybij:
  let th:
    prove(
      [
        (hol:
           const IN :: num -> (num -> bool) -> bool
           const #{..} :: num -> num -> num -> bool
           const dimindex :: (B -> bool) -> num
           const UNIV :: B -> bool
           exists x :: num:
             IN(
               x,
               #{..}(
                 (1 :: num),
                 if dimindex(UNIV) < (dimindex :: (A -> bool) -> num)((UNIV :: A -> bool))
                 | (dimindex :: (A -> bool) -> num)((UNIV :: A -> bool)) - dimindex(UNIV)
                 | (1 :: num)
               )
             )),
        (
          (
            EXISTS_TAC(
              (hol:
                 (1 :: num))
            ) then_tac \
            REWRITE_TAC(PairList [IN_NUMSEG])
          ) then_tac \
          ARITH_TAC
        )
      ]
    )
  new_type_definition("finite_diff")(["mk_finite_diff", "dest_finite_diff"])(th)

def FINITE_DIFF_IMAGE:
  prove(
    [
      (hol:
         const UNIV :: finite_diff(A, B) -> bool
         const IMAGE :: (num -> finite_diff(A, B)) -> (num -> bool) -> finite_diff(A, B) -> bool
         const mk_finite_diff :: num -> finite_diff(A, B)
         const #{..} :: num -> num -> num -> bool
         const dimindex :: (B -> bool) -> num
         UNIV
           == IMAGE(
                mk_finite_diff,
                #{..}(
                  (1 :: num),
                  if dimindex((UNIV :: B -> bool)) < (dimindex :: (A -> bool) -> num)((UNIV :: A -> bool))
                  | (dimindex :: (A -> bool) -> num)((UNIV :: A -> bool)) - dimindex((UNIV :: B -> bool))
                  | (1 :: num)
                )
              )),
      (
        REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_IMAGE]) then_tac \
        MESON_TAC(PairList [finite_diff_tybij])
      )
    ]
  )

