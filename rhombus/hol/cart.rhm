  prove(
    [
      (hol:
         const dimindex :: (B -> bool) -> num
         const UNIV :: B -> bool
         const dollar as "$" :: cart(A, B) -> num -> A
         const lambda :: (num -> A) -> cart(A, B)
         forall (f :: cart(A, B), g :: num -> A):
