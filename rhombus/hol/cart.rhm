def LAMBDA_BETA:
  prove(
    [
      hol_term(Forall(
        "i",
        Num,
        Implies(
          And(
            App(
              Const("<=", Fun(Num, Fun(Num, Bool))),
              [
                App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                Ref("i")
              ]
            ),
            App(
              Const("<=", Fun(Num, Fun(Num, Bool))),
              [
                Ref("i"),
                App(Const("dimindex", Fun(Fun(Tvar("B"), Bool), Num)), [Const("UNIV", Fun(Tvar("B"), Bool))])
              ]
            )
          ),
          Eq(
            Tvar("A"),
            App(
              Const("$", Fun(Tyapp("cart", [Tvar("A"), Tvar("B")]), Fun(Num, Tvar("A")))),
              [
                App(
                  Const("lambda", Fun(Fun(Num, Tvar("A")), Tyapp("cart", [Tvar("A"), Tvar("B")]))),
                  [Var("g", Fun(Num, Tvar("A")))]
                ),
                Ref("i")
              ]
            ),
            App(Var("g", Fun(Num, Tvar("A"))), [Ref("i")])
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (REWRITE_TAC(PairList [lambda]) then_tac CONV_TAC(SELECT_CONV)) then_tac \
                      EXISTS_TAC(
                        hol_term(App(
                          Const(
                            "mk_cart",
                            Fun(Fun(Tyapp("finite_image", [Tvar("B")]), Tvar("A")), Tyapp("cart", [Tvar("A"), Tvar("B")]))
                          ),
                          [
                            Lambda(
                              "k",
                              Tyapp("finite_image", [Tvar("B")]),
                              App(
                                Var("g", Fun(Num, Tvar("A"))),
                                [
                                  App(
                                    Const("@", Fun(Fun(Num, Bool), Num)),
                                    [
                                      Lambda(
                                        "i",
                                        Num,
                                        And(
                                          App(
                                            Const("<=", Fun(Num, Fun(Num, Bool))),
                                            [
                                              App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                                              Ref("i")
                                            ]
                                          ),
                                          And(
                                            App(
                                              Const("<=", Fun(Num, Fun(Num, Bool))),
                                              [
                                                Ref("i"),
                                                App(Const("dimindex", Fun(Fun(Tvar("B"), Bool), Num)), [Const("UNIV", Fun(Tvar("B"), Bool))])
                                              ]
                                            ),
                                            Eq(
                                              Tyapp("finite_image", [Tvar("B")]),
                                              App(Const("finite_index", Fun(Num, Tyapp("finite_image", [Tvar("B")]))), [Ref("i")]),
                                              Ref("k")
                                            )
                                          )
                                        )
                                      )
                                    ]
                                  )
                                ]
                              )
                            )
                          ]
                        ))
                      )
                    ) then_tac \
                    REWRITE_TAC(PairList [finite_index, REWRITE_RULE(PairList [])(cart_tybij)])
                  ) then_tac \
                  REPEAT(STRIP_TAC)
                ) then_tac \
                AP_TERM_TAC
              ) then_tac \
              MATCH_MP_TAC(SELECT_UNIQUE)
            ) then_tac \
            GEN_TAC
          ) then_tac \
          REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_MESON_TAC(PairList [FINITE_INDEX_INJ, DIMINDEX_FINITE_IMAGE])
      )
    ]
  )

