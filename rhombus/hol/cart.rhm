      @hol|{UNIV:(A,B)finite_prod->bool =
         IMAGE mk_finite_prod (1..(dimindex(:A)*dimindex(:B)))}|,
      (
        REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_IMAGE]) then_tac \
        MESON_TAC(PairList [finite_prod_tybij])
      )
    ]
  )

def DIMINDEX_HAS_SIZE_FINITE_PROD:
  prove(
    [
      @hol|{(UNIV:(M,N)finite_prod->bool) HAS_SIZE (dimindex(:M) * dimindex(:N))}|,
      (
        (
