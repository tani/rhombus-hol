def [cart_PCROSS_INTERS_INTERS_v2, PCROSS_INTERS]:
  o(CONJ_PAIR)(prove)(
    [
      (hol:
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const INTERS :: ((cart(A, M) -> bool) -> bool) -> cart(A, M) -> bool
         const EMPTY :: (cart(A, M) -> bool) -> bool
         const GSPEC :: ((cart(A, finite_sum(M, N)) -> bool) -> bool) -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const SETSPEC :: (cart(A, finite_sum(M, N)) -> bool) -> bool -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const IN :: (cart(A, N) -> bool) -> ((cart(A, N) -> bool) -> bool) -> bool
         const UNIV :: cart(A, M) -> bool
         (forall (f :: (cart(A, M) -> bool) -> bool, g :: (cart(A, N) -> bool) -> bool):
            PCROSS(INTERS(f), (INTERS :: ((cart(A, N) -> bool) -> bool) -> cart(A, N) -> bool)(g))
              == (if f == EMPTY
                  | (INTERS :: ((cart(A, finite_sum(M, N)) -> bool) -> bool) -> cart(A, finite_sum(M, N)) -> bool)(
                      GSPEC(
                        fun (#{|GEN%PVAR%367|} :: cart(A, finite_sum(M, N)) -> bool):
                          exists t :: cart(A, N) -> bool:
                            SETSPEC(#{|GEN%PVAR%367|}, IN(t, g), PCROSS(UNIV, t))
                      )
                    )
                  | if g == (EMPTY :: (cart(A, N) -> bool) -> bool)
                    | (INTERS :: ((cart(A, finite_sum(M, N)) -> bool) -> bool) -> cart(A, finite_sum(M, N)) -> bool)(
                        GSPEC(
                          fun (#{|GEN%PVAR%368|} :: cart(A, finite_sum(M, N)) -> bool):
                            exists s :: cart(A, M) -> bool:
                              SETSPEC(#{|GEN%PVAR%368|}, (IN :: (cart(A, M) -> bool) -> ((cart(A, M) -> bool) -> bool) -> bool)(s, f), PCROSS(s, (UNIV :: cart(A, N) -> bool)))
                        )
                      )
                    | (INTERS :: ((cart(A, finite_sum(M, N)) -> bool) -> bool) -> cart(A, finite_sum(M, N)) -> bool)(
                        GSPEC(
                          fun (#{|GEN%PVAR%369|} :: cart(A, finite_sum(M, N)) -> bool):
                            exists (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool):
                              SETSPEC(#{|GEN%PVAR%369|}, (IN :: (cart(A, M) -> bool) -> ((cart(A, M) -> bool) -> bool) -> bool)(s, f) && IN(t, g), PCROSS(s, t))
                        )
                      )))
           && ((forall (s :: cart(A, M) -> bool, f :: (cart(A, N) -> bool) -> bool):
                  PCROSS(s, (INTERS :: ((cart(A, N) -> bool) -> bool) -> cart(A, N) -> bool)(f))
                    == (if f == (EMPTY :: (cart(A, N) -> bool) -> bool)
                        | PCROSS(s, (UNIV :: cart(A, N) -> bool))
                        | (INTERS :: ((cart(A, finite_sum(M, N)) -> bool) -> bool) -> cart(A, finite_sum(M, N)) -> bool)(
                            GSPEC(
                              fun (#{|GEN%PVAR%370|} :: cart(A, finite_sum(M, N)) -> bool):
                                exists t :: cart(A, N) -> bool:
                                  SETSPEC(#{|GEN%PVAR%370|}, IN(t, f), PCROSS(s, t))
                            )
                          )))
                 && (forall (f :: (cart(A, M) -> bool) -> bool, t :: cart(A, N) -> bool):
                       PCROSS(INTERS(f), t)
                         == (if f == EMPTY
                             | PCROSS(UNIV, t)
                             | (INTERS :: ((cart(A, finite_sum(M, N)) -> bool) -> bool) -> cart(A, finite_sum(M, N)) -> bool)(
                                 GSPEC(
                                   fun (#{|GEN%PVAR%371|} :: cart(A, finite_sum(M, N)) -> bool):
                                     exists s :: cart(A, M) -> bool:
                                       SETSPEC(#{|GEN%PVAR%371|}, (IN :: (cart(A, M) -> bool) -> ((cart(A, M) -> bool) -> bool) -> bool)(s, f), PCROSS(s, t))
                                 )
                               ))))),
      (
        (
          (
            REPEAT(STRIP_TAC) then_tac \
            REPEAT((COND_CASES_TAC then_tac REWRITE_TAC(PairList [])))
          ) then_tac \
          ASM_REWRITE_TAC(
            PairList [
              INTERS_GSPEC,
              EXTENSION,
              FORALL_PASTECART,
              IN_ELIM_THM,
              PASTECART_IN_PCROSS,
              NOT_IN_EMPTY
            ]
          )
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

def DISJOINT_PCROSS:
  prove(
    [
      (hol:
         const DISJOINT :: (cart(A, finite_sum(M, N)) -> bool) -> (cart(A, finite_sum(M, N)) -> bool) -> bool
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         forall (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool, #{|s'|} :: cart(A, M) -> bool, #{|t'|} :: cart(A, N) -> bool):
           DISJOINT(PCROSS(s, t), PCROSS(#{|s'|}, #{|t'|}))
             <=> (DISJOINT :: (cart(A, M) -> bool) -> (cart(A, M) -> bool) -> bool)(s, #{|s'|}) || (DISJOINT :: (cart(A, N) -> bool) -> (cart(A, N) -> bool) -> bool)(t, #{|t'|})),
      REWRITE_TAC(PairList [DISJOINT, INTER_PCROSS, PCROSS_EQ_EMPTY])
    ]
  )

