                                          Fun(Tyapp("cart", [Tvar("A"), Tvar("M")]), Bool),
                                          Fun(Fun(Fun(Tyapp("cart", [Tvar("A"), Tvar("M")]), Bool), Bool), Bool)
                                        )
                                      ),
                                      [Ref("s"), Ref("f")]
                                    ),
                                    App(
                                      Const(
                                        "PCROSS",
                                        Fun(
                                          Fun(Tyapp("cart", [Tvar("A"), Tvar("M")]), Bool),
                                          Fun(
                                            Fun(Tyapp("cart", [Tvar("A"), Tvar("N")]), Bool),
                                            Fun(Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]), Bool)
                                          )
                                        )
                                      ),
                                      [Ref("s"), Ref("t")]
                                    )
                                  ]
                                )
                              )
                            )
                          ]
                        )
                      ]
                    )
                  ]
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            REPEAT(STRIP_TAC) then_tac \
            REPEAT((COND_CASES_TAC then_tac REWRITE_TAC(PairList [])))
          ) then_tac \
          ASM_REWRITE_TAC(
            PairList [
              INTERS_GSPEC,
              EXTENSION,
              FORALL_PASTECART,
              IN_ELIM_THM,
              PASTECART_IN_PCROSS,
              NOT_IN_EMPTY
            ]
          )
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

def DISJOINT_PCROSS:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tyapp("cart", [Tvar("A"), Tvar("M")]), Bool),
        Forall(
          "t",
          Fun(Tyapp("cart", [Tvar("A"), Tvar("N")]), Bool),
          Forall(
            "s'",
            Fun(Tyapp("cart", [Tvar("A"), Tvar("M")]), Bool),
            Forall(
              "t'",
              Fun(Tyapp("cart", [Tvar("A"), Tvar("N")]), Bool),
              Iff(
                App(
                  Const(
                    "DISJOINT",
                    Fun(
                      Fun(Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]), Bool),
                      Fun(Fun(Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]), Bool), Bool)
                    )
                  ),
                  [
                    App(
                      Const(
                        "PCROSS",
                        Fun(
                          Fun(Tyapp("cart", [Tvar("A"), Tvar("M")]), Bool),
                          Fun(
                            Fun(Tyapp("cart", [Tvar("A"), Tvar("N")]), Bool),
                            Fun(Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]), Bool)
                          )
                        )
                      ),
                      [Ref("s"), Ref("t")]
                    ),
                    App(
                      Const(
                        "PCROSS",
                        Fun(
                          Fun(Tyapp("cart", [Tvar("A"), Tvar("M")]), Bool),
                          Fun(
                            Fun(Tyapp("cart", [Tvar("A"), Tvar("N")]), Bool),
                            Fun(Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]), Bool)
                          )
                        )
                      ),
                      [Ref("s'"), Ref("t'")]
                    )
                  ]
                ),
                Or(
                  App(
                    Const(
                      "DISJOINT",
                      Fun(
                        Fun(Tyapp("cart", [Tvar("A"), Tvar("M")]), Bool),
                        Fun(Fun(Tyapp("cart", [Tvar("A"), Tvar("M")]), Bool), Bool)
                      )
                    ),
                    [Ref("s"), Ref("s'")]
                  ),
                  App(
                    Const(
                      "DISJOINT",
                      Fun(
                        Fun(Tyapp("cart", [Tvar("A"), Tvar("N")]), Bool),
                        Fun(Fun(Tyapp("cart", [Tvar("A"), Tvar("N")]), Bool), Bool)
                      )
                    ),
                    [Ref("t"), Ref("t'")]
                  )
                )
              )
            )
          )
        )
      )),
      REWRITE_TAC(PairList [DISJOINT, INTER_PCROSS, PCROSS_EQ_EMPTY])
    ]
  )

