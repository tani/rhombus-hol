def DIMINDEX_HAS_SIZE_FINITE_SUM:
  prove(
    [
      hol_term(App(
        Const("HAS_SIZE", Fun(Fun(Tyapp("finite_sum", [Tvar("M"), Tvar("N")]), Bool), Fun(Num, Bool))),
        [
          Const("UNIV", Fun(Tyapp("finite_sum", [Tvar("M"), Tvar("N")]), Bool)),
          App(
            Const("+", Fun(Num, Fun(Num, Num))),
            [
              App(Const("dimindex", Fun(Fun(Tvar("M"), Bool), Num)), [Const("UNIV", Fun(Tvar("M"), Bool))]),
              App(Const("dimindex", Fun(Fun(Tvar("N"), Bool), Num)), [Const("UNIV", Fun(Tvar("N"), Bool))])
            ]
          )
        ]
      )),
      (
        (
          (
            (
              SIMP_TAC(PairList [FINITE_SUM_IMAGE]) then_tac \
              MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ)
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [DIMINDEX_UNIV])
          ) then_tac \
          REWRITE_TAC(PairList [HAS_SIZE_NUMSEG_1])
        ) then_tac \
        MESON_TAC(PairList [finite_sum_tybij])
      )
    ]
  )

