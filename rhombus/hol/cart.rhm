         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         forall (s :: cart(A, M) -> bool, #{|s'|} :: cart(A, M) -> bool, t :: cart(A, N) -> bool, #{|t'|} :: cart(A, N) -> bool):
           INTER(PCROSS(s, t), PCROSS(#{|s'|}, #{|t'|}))
             == PCROSS((INTER :: (cart(A, M) -> bool) -> (cart(A, M) -> bool) -> cart(A, M) -> bool)(s, #{|s'|}), (INTER :: (cart(A, N) -> bool) -> (cart(A, N) -> bool) -> cart(A, N) -> bool)(t, #{|t'|}))),
      (
        REWRITE_TAC(PairList [EXTENSION, IN_INTER, FORALL_PASTECART, PASTECART_IN_PCROSS]) then_tac \
        CONV_TAC(TAUT)
      )
    ]
  )

