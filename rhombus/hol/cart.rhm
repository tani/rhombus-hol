def finite_image_tybij:
  new_type_definition("finite_image")(["finite_index", "dest_finite_image"])(
    prove(
      [
        hol_term(Exists(
          "x",
          Num,
          App(
            Const("IN", Fun(Num, Fun(Fun(Num, Bool), Bool))),
            [
              Ref("x"),
              App(
                Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                [
                  App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                  App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Const("UNIV", Fun(Tvar("A"), Bool))])
                ]
              )
            ]
          )
        )),
        (
          EXISTS_TAC(
            hol_term(App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]))
          ) then_tac \
          REWRITE_TAC(PairList [IN_NUMSEG, LE_REFL, DIMINDEX_GE_1])
        )
      ]
    )
  )

