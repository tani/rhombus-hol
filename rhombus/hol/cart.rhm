def FINITE_INDEX_INJ:
  prove(
    [
      (hol:
         const dimindex :: (A -> bool) -> num
         const UNIV :: A -> bool
         const finite_index :: num -> finite_image(A)
         forall (i :: num, j :: num):
           (1 :: num) <= i && (i <= dimindex(UNIV) && ((1 :: num) <= j && j <= dimindex(UNIV)))
             ==> (finite_index(i) == finite_index(j) <=> i == j)),
      MESON_TAC(PairList [FINITE_INDEX_WORKS])
