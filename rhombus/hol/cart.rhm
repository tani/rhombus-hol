def lambda:
  new_definition(
    (hol:
       var lambda :: (num -> A) -> cart(A, B)
       var g :: num -> A
       const select as "@" :: (cart(A, B) -> bool) -> cart(A, B)
       const dimindex :: (B -> bool) -> num
       const UNIV :: B -> bool
       const dollar as "$" :: cart(A, B) -> num -> A
       lambda(g)
         == select(
              fun (f :: cart(A, B)):
                forall i :: num: (1 :: num) <= i && i <= dimindex(UNIV) ==> dollar(f, i) == g(i)
            ))
  )

