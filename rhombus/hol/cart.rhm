                  (hol:
                     var s :: cart(A, M) -> bool
                     var t :: cart(A, N) -> bool
                     const IMAGE :: (cart(A, finite_sum(M, N)) -> cart(A, M)) -> (cart(A, finite_sum(M, N)) -> bool) -> cart(A, M) -> bool
                     const fstcart :: cart(A, finite_sum(M, N)) -> cart(A, M)
                     const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
                     IMAGE(fstcart, PCROSS(s, t)))
