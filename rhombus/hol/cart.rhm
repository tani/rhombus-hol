def [cart_tybit0_INDUCT_v2, tybit0_RECURSION] = define_type("tybit0 = mktybit0((A,A)finite_sum)")

def [cart_tybit1_INDUCT_v2, tybit1_RECURSION] = define_type("tybit1 = mktybit1(((A,A)finite_sum,1)finite_sum)")

def HAS_SIZE_TYBIT0:
  prove(
    [
      (hol:
         const HAS_SIZE :: (tybit0(A) -> bool) -> num -> bool
         const UNIV :: tybit0(A) -> bool
         const dimindex :: (A -> bool) -> num
         HAS_SIZE(UNIV, (2 :: num) * dimindex((UNIV :: A -> bool)))),
      (
        SUBGOAL_THEN(
          (hol:
             const UNIV :: tybit0(A) -> bool
             const IMAGE :: (finite_sum(A, A) -> tybit0(A)) -> (finite_sum(A, A) -> bool) -> tybit0(A) -> bool
             const mktybit0 :: finite_sum(A, A) -> tybit0(A)
             UNIV == IMAGE(mktybit0, (UNIV :: finite_sum(A, A) -> bool)))
        )(SUBST1_TAC) then_list \
        PairList [
          (
            (
              (CONV_TAC(SYM_CONV) then_tac MATCH_MP_TAC(SURJECTIVE_IMAGE_EQ)) then_tac \
              REWRITE_TAC(PairList [IN_UNIV])
            ) then_tac \
            MESON_TAC(PairList [cases("tybit0")])
          ),
          (
            (
              (
                MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ) then_tac \
                REWRITE_TAC(PairList [IN_UNIV, injectivity("tybit0")])
              ) then_tac \
              W(
                o(o(o(MP_TAC)(PART_MATCH(lhand)(DIMINDEX_HAS_SIZE_FINITE_SUM)))(lhand))(snd)
              )
            ) then_tac \
            REWRITE_TAC(PairList [DIMINDEX_FINITE_SUM, GSYM(MULT_2)])
          )
        ]
      )
    ]
  )

def HAS_SIZE_TYBIT1:
  prove(
    [
      (hol:
         const HAS_SIZE :: (tybit1(A) -> bool) -> num -> bool
         const UNIV :: tybit1(A) -> bool
         const dimindex :: (A -> bool) -> num
         HAS_SIZE(UNIV, (2 :: num) * dimindex((UNIV :: A -> bool)) + (1 :: num))),
      (
        SUBGOAL_THEN(
          (hol:
             const UNIV :: tybit1(A) -> bool
             const IMAGE :: (finite_sum(finite_sum(A, A), 1) -> tybit1(A)) -> (finite_sum(finite_sum(A, A), 1) -> bool) -> tybit1(A) -> bool
             const mktybit1 :: finite_sum(finite_sum(A, A), 1) -> tybit1(A)
             UNIV == IMAGE(mktybit1, (UNIV :: finite_sum(finite_sum(A, A), 1) -> bool)))
        )(SUBST1_TAC) then_list \
        PairList [
          (
            (
              (CONV_TAC(SYM_CONV) then_tac MATCH_MP_TAC(SURJECTIVE_IMAGE_EQ)) then_tac \
              REWRITE_TAC(PairList [IN_UNIV])
            ) then_tac \
            MESON_TAC(PairList [cases("tybit1")])
          ),
          (
            (
              (
                MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ) then_tac \
                REWRITE_TAC(PairList [IN_UNIV, injectivity("tybit1")])
              ) then_tac \
              W(
                o(o(o(MP_TAC)(PART_MATCH(lhand)(DIMINDEX_HAS_SIZE_FINITE_SUM)))(lhand))(snd)
              )
            ) then_tac \
            REWRITE_TAC(PairList [DIMINDEX_FINITE_SUM, DIMINDEX_1, GSYM(MULT_2)])
          )
        ]
      )
    ]
  )

def DIMINDEX_TYBIT0:
  prove(
    [
      (hol:
         const dimindex :: (tybit0(A) -> bool) -> num
         const UNIV :: tybit0(A) -> bool
         dimindex(UNIV) == (2 :: num) * (dimindex :: (A -> bool) -> num)((UNIV :: A -> bool))),
      (MATCH_MP_TAC(DIMINDEX_UNIQUE) then_tac MATCH_ACCEPT_TAC(HAS_SIZE_TYBIT0))
    ]
  )

def DIMINDEX_TYBIT1:
  prove(
    [
      (hol:
         const dimindex :: (tybit1(A) -> bool) -> num
         const UNIV :: tybit1(A) -> bool
         dimindex(UNIV) == (2 :: num) * (dimindex :: (A -> bool) -> num)((UNIV :: A -> bool)) + (1 :: num)),
      (MATCH_MP_TAC(DIMINDEX_UNIQUE) then_tac MATCH_ACCEPT_TAC(HAS_SIZE_TYBIT1))
    ]
  )

def DIMINDEX_CLAUSES:
  prove(
    [
      (hol:
         const dimindex :: (1 -> bool) -> num
         const UNIV :: 1 -> bool
         dimindex(UNIV) == (1 :: num)
           && ((dimindex :: (tybit0(A) -> bool) -> num)((UNIV :: tybit0(A) -> bool)) == (2 :: num) * (dimindex :: (A -> bool) -> num)((UNIV :: A -> bool))
                 && (dimindex :: (tybit1(A) -> bool) -> num)((UNIV :: tybit1(A) -> bool)) == (2 :: num) * (dimindex :: (A -> bool) -> num)((UNIV :: A -> bool)) + (1 :: num))),
      (
        (
          (REWRITE_TAC(PairList [DIMINDEX_1]) then_tac CONJ_TAC) then_tac \
          MATCH_MP_TAC(DIMINDEX_UNIQUE)
        ) then_tac \
        REWRITE_TAC(PairList [HAS_SIZE_TYBIT0, HAS_SIZE_TYBIT1])
      )
    ]
  )

def FINITE_1:
  prove(
    [
      (hol:
         const FINITE :: (1 -> bool) -> bool
         const UNIV :: 1 -> bool
         FINITE(UNIV)),
      MESON_TAC(PairList [HAS_SIZE_1, HAS_SIZE])
    ]
  )

def FINITE_TYBIT0:
