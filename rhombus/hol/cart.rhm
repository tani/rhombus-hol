def dimindex:
  new_definition(
    (hol:
       var dimindex :: (A -> bool) -> num
       var s :: A -> bool
       const FINITE :: (A -> bool) -> bool
       const UNIV :: A -> bool
       const CARD :: (A -> bool) -> num
       dimindex(s) == (if FINITE(UNIV) | CARD(UNIV) | (1 :: num)))
  )

def DIMINDEX_NONZERO:
  prove(
    [
      (hol:
         const dimindex :: (A -> bool) -> num
         forall s :: A -> bool: dimindex(s) != (0 :: num)),
      (
        (
          ((GEN_TAC then_tac REWRITE_TAC(PairList [dimindex])) then_tac COND_CASES_TAC) then_tac \
          ASM_SIMP_TAC(PairList [CARD_EQ_0, ARITH])
        ) then_tac \
        SET_TAC(PairList [])
      )
    ]
  )

def DIMINDEX_GE_1:
  prove(
    [
      (hol:
         const dimindex :: (A -> bool) -> num
         forall s :: A -> bool: (1 :: num) <= dimindex(s)),
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            (hol:
               var x :: num
               (1 :: num) <= x <=> x != (0 :: num))
          ),
          DIMINDEX_NONZERO
        ]
      )
    ]
  )

def DIMINDEX_UNIV:
  prove(
    [
      (hol:
         const dimindex :: (A -> bool) -> num
         const UNIV :: A -> bool
         forall s :: A -> bool: dimindex(s) == dimindex(UNIV)),
      REWRITE_TAC(PairList [dimindex])
    ]
  )

def DIMINDEX_UNIQUE:
  prove(
    [
      (hol:
         var n :: num
         const HAS_SIZE :: (A -> bool) -> num -> bool
         const UNIV :: A -> bool
         const dimindex :: (A -> bool) -> num
         HAS_SIZE(UNIV, n) ==> dimindex(UNIV) == n),
      MESON_TAC(PairList [dimindex, HAS_SIZE])
    ]
  )

def UNIV_HAS_SIZE_DIMINDEX:
  prove(
    [
      (hol:
         const HAS_SIZE :: (N -> bool) -> num -> bool
         const UNIV :: N -> bool
         const dimindex :: (N -> bool) -> num
         const FINITE :: (N -> bool) -> bool
         HAS_SIZE(UNIV, dimindex(UNIV)) <=> FINITE(UNIV)),
      MESON_TAC(PairList [HAS_SIZE, dimindex])
    ]
  )

def HAS_SIZE_1:
  prove(
    [
      (hol:
         const HAS_SIZE :: (1 -> bool) -> num -> bool
         const UNIV :: 1 -> bool
         HAS_SIZE(UNIV, (1 :: num))),
      (
        SUBGOAL_THEN(
          (hol:
             const UNIV :: 1 -> bool
             const INSERT :: 1 -> (1 -> bool) -> 1 -> bool
             const one :: 1
             const EMPTY :: 1 -> bool
             UNIV == INSERT(one, EMPTY))
        )(SUBST1_TAC) then_list \
        PairList [
          (
            REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_SING]) then_tac \
            MESON_TAC(PairList [one])
          ),
          SIMP_TAC(
            PairList [NOT_IN_EMPTY, HAS_SIZE, FINITE_RULES, CARD_CLAUSES, ARITH]
          )
        ]
      )
    ]
  )

def NUMSEG_LT_DIMINDEX:
  prove(
    [
      (hol:
         const GSPEC :: (num -> bool) -> num -> bool
         const SETSPEC :: num -> bool -> num -> bool
         const dimindex :: (N -> bool) -> num
         const UNIV :: N -> bool
         const #{..} :: num -> num -> num -> bool
         GSPEC(
           fun (#{|GEN%PVAR%354|} :: num):
             exists i :: num: SETSPEC(#{|GEN%PVAR%354|}, i < dimindex(UNIV), i)
         )
           == #{..}((0 :: num), dimindex(UNIV) - (1 :: num))),
      REWRITE_TAC(PairList [NUMSEG_LT, DIMINDEX_NONZERO])
    ]
  )

def DIMINDEX_1 = MATCH_MP(DIMINDEX_UNIQUE)(HAS_SIZE_1)

def finite_image_tybij:
  new_type_definition("finite_image")(["finite_index", "dest_finite_image"])(
    prove(
      [
        (hol:
           const IN :: num -> (num -> bool) -> bool
           const #{..} :: num -> num -> num -> bool
           const dimindex :: (A -> bool) -> num
           const UNIV :: A -> bool
           exists x :: num: IN(x, #{..}((1 :: num), dimindex(UNIV)))),
        (
          EXISTS_TAC(
            (hol:
               (1 :: num))
          ) then_tac \
          REWRITE_TAC(PairList [IN_NUMSEG, LE_REFL, DIMINDEX_GE_1])
        )
      ]
    )
  )

def FINITE_IMAGE_IMAGE:
  prove(
    [
      (hol:
         const UNIV :: finite_image(A) -> bool
         const IMAGE :: (num -> finite_image(A)) -> (num -> bool) -> finite_image(A) -> bool
         const finite_index :: num -> finite_image(A)
         const #{..} :: num -> num -> num -> bool
         const dimindex :: (A -> bool) -> num
         UNIV == IMAGE(finite_index, #{..}((1 :: num), dimindex((UNIV :: A -> bool))))),
      (
        REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_IMAGE]) then_tac \
        MESON_TAC(PairList [finite_image_tybij])
      )
    ]
  )

def HAS_SIZE_FINITE_IMAGE:
  prove(
    [
      (hol:
         const HAS_SIZE :: (finite_image(A) -> bool) -> num -> bool
         const UNIV :: finite_image(A) -> bool
         const dimindex :: (A -> bool) -> num
         forall s :: A -> bool: HAS_SIZE(UNIV, dimindex(s))),
      (
        (
          (
            (
              (GEN_TAC then_tac SIMP_TAC(PairList [FINITE_IMAGE_IMAGE])) then_tac \
              MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ)
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [DIMINDEX_UNIV])
          ) then_tac \
          REWRITE_TAC(PairList [HAS_SIZE_NUMSEG_1])
        ) then_tac \
        MESON_TAC(PairList [finite_image_tybij])
      )
    ]
  )

def CARD_FINITE_IMAGE:
  prove(
    [
      (hol:
         const CARD :: (finite_image(A) -> bool) -> num
         const UNIV :: finite_image(A) -> bool
         const dimindex :: (A -> bool) -> num
         forall s :: A -> bool: CARD(UNIV) == dimindex(s)),
      MESON_TAC(PairList [HAS_SIZE_FINITE_IMAGE, HAS_SIZE])
