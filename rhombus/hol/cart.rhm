def SNDCART_PASTECART:
  prove(
    [
      hol_term(Forall(
        "x",
        Tyapp("cart", [Tvar("A"), Tvar("M")]),
        Forall(
          "y",
          Tyapp("cart", [Tvar("A"), Tvar("N")]),
          Eq(
            Tyapp("cart", [Tvar("A"), Tvar("N")]),
            App(
              Const(
                "sndcart",
                Fun(
                  Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]),
                  Tyapp("cart", [Tvar("A"), Tvar("N")])
                )
              ),
              [
                App(
                  Const(
                    "pastecart",
                    Fun(
                      Tyapp("cart", [Tvar("A"), Tvar("M")]),
                      Fun(
                        Tyapp("cart", [Tvar("A"), Tvar("N")]),
                        Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])])
                      )
                    )
                  ),
                  [Ref("x"), Ref("y")]
                )
              ]
            ),
            Ref("y")
          )
        )
      )),
      (
        (
          (
            (
              SIMP_TAC(PairList [pastecart, sndcart, CART_EQ, LAMBDA_BETA]) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            W(
              (fun([_, w]): MP_TAC(PART_MATCH(o(lhs)(rand))(LAMBDA_BETA)(lhand(w))))
            )
          ) then_tac \
          ANTS_TAC
        ) then_list \
        PairList [
          (
            (
              REWRITE_TAC(PairList [DIMINDEX_FINITE_SUM]) then_tac \
              MATCH_MP_TAC(
                ARITH_RULE(
                  hol_term(Implies(
                    And(
                      App(
                        Const("<=", Fun(Num, Fun(Num, Bool))),
                        [
                          App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                          Var("i", Num)
                        ]
                      ),
                      App(Const("<=", Fun(Num, Fun(Num, Bool))), [Var("i", Num), Var("b", Num)])
                    ),
                    And(
                      App(
                        Const("<=", Fun(Num, Fun(Num, Bool))),
                        [
                          App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                          App(Const("+", Fun(Num, Fun(Num, Num))), [Var("i", Num), Var("a", Num)])
                        ]
                      ),
                      App(
                        Const("<=", Fun(Num, Fun(Num, Bool))),
                        [
                          App(Const("+", Fun(Num, Fun(Num, Num))), [Var("i", Num), Var("a", Num)]),
                          App(Const("+", Fun(Num, Fun(Num, Num))), [Var("a", Num), Var("b", Num)])
                        ]
                      )
                    )
                  ))
                )
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ),
          (
            (DISCH_THEN(SUBST1_TAC) then_tac REWRITE_TAC(PairList [])) then_tac \
            ASM_SIMP_TAC(
              PairList [
                ADD_SUB,
                ARITH_RULE(
                  hol_term(Implies(
                    App(
                      Const("<=", Fun(Num, Fun(Num, Bool))),
                      [
                        App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                        Var("i", Num)
                      ]
                    ),
                    Not(
                      App(
                        Const("<=", Fun(Num, Fun(Num, Bool))),
                        [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("i", Num), Var("a", Num)]), Var("a", Num)]
                      )
                    )
                  ))
                )
              ]
            )
          )
        ]
      )
    ]
  )

def PASTECART_FST_SND:
  prove(
    [
      hol_term(Forall(
        "z",
        Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]),
        Eq(
          Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]),
          App(
            Const(
              "pastecart",
              Fun(
                Tyapp("cart", [Tvar("A"), Tvar("M")]),
                Fun(
                  Tyapp("cart", [Tvar("A"), Tvar("N")]),
                  Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])])
                )
              )
            ),
            [
              App(
                Const(
                  "fstcart",
                  Fun(
                    Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]),
                    Tyapp("cart", [Tvar("A"), Tvar("M")])
                  )
                ),
                [Ref("z")]
              ),
              App(
                Const(
                  "sndcart",
                  Fun(
                    Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]),
                    Tyapp("cart", [Tvar("A"), Tvar("N")])
                  )
                ),
                [Ref("z")]
              )
            ]
          ),
          Ref("z")
        )
      )),
      (
        (
          (
            (
              SIMP_TAC(PairList [pastecart, fstcart, sndcart, CART_EQ, LAMBDA_BETA]) then_tac \
              REPEAT(GEN_TAC)
            ) then_tac \
            COND_CASES_TAC
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            DIMINDEX_FINITE_SUM,
            LAMBDA_BETA,
            ARITH_RULE(
              hol_term(Implies(
                App(
                  Const("<=", Fun(Num, Fun(Num, Bool))),
                  [Var("i", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("a", Num), Var("b", Num)])]
                ),
                App(
                  Const("<=", Fun(Num, Fun(Num, Bool))),
                  [App(Const("-", Fun(Num, Fun(Num, Num))), [Var("i", Num), Var("a", Num)]), Var("b", Num)]
                )
              ))
            ),
            ARITH_RULE(
              hol_term(Implies(
                Not(App(Const("<=", Fun(Num, Fun(Num, Bool))), [Var("i", Num), Var("a", Num)])),
                App(
                  Const("<=", Fun(Num, Fun(Num, Bool))),
                  [
                    App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                    App(Const("-", Fun(Num, Fun(Num, Num))), [Var("i", Num), Var("a", Num)])
                  ]
                )
              ))
            ),
            ARITH_RULE(
              hol_term(Implies(
                Not(App(Const("<=", Fun(Num, Fun(Num, Bool))), [Var("i", Num), Var("a", Num)])),
                Eq(
                  Num,
                  App(
                    Const("+", Fun(Num, Fun(Num, Num))),
                    [App(Const("-", Fun(Num, Fun(Num, Num))), [Var("i", Num), Var("a", Num)]), Var("a", Num)]
                  ),
                  Var("i", Num)
                )
              ))
            )
          ]
        )
      )
    ]
  )

