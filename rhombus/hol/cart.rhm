            )
          )
        )
      )),
      (
        (
          (
            (REWRITE_TAC(PairList [pastecart]) then_tac CONJ_TAC) then_tac \
            REPEAT(GEN_TAC)
          ) then_tac \
          STRIP_TAC
        ) then_list \
        PairList [
          (
            (
              SUBGOAL_THEN(
                hol_term(App(
                  Const("<=", Fun(Num, Fun(Num, Bool))),
                  [
                    Var("i", Num),
                    App(
                      Const("dimindex", Fun(Fun(Tyapp("finite_sum", [Tvar("M"), Tvar("N")]), Bool), Num)),
                      [Const("UNIV", Fun(Tyapp("finite_sum", [Tvar("M"), Tvar("N")]), Bool))]
                    )
                  ]
                ))
              )((fun(th): ASM_SIMP_TAC(PairList [LAMBDA_BETA, th]))) then_tac \
              REWRITE_TAC(PairList [DIMINDEX_FINITE_SUM])
            ) then_tac \
            ASM_ARITH_TAC
          ),
          (
            (
              (
                ASM_SIMP_TAC(
                  PairList [
                    LAMBDA_BETA,
                    DIMINDEX_FINITE_SUM,
                    ARITH_RULE(
                      hol_term(Implies(
                        App(
                          Const("<=", Fun(Num, Fun(Num, Bool))),
                          [
                            App(
                              Const("+", Fun(Num, Fun(Num, Num))),
                              [
                                App(Const("dimindex", Fun(Fun(Tvar("M"), Bool), Num)), [Const("UNIV", Fun(Tvar("M"), Bool))]),
                                App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                              ]
                            ),
                            Var("i", Num)
                          ]
                        ),
                        App(
                          Const("<=", Fun(Num, Fun(Num, Bool))),
                          [
                            App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                            Var("i", Num)
                          ]
                        )
                      ))
                    )
                  ]
                ) then_tac \
                COND_CASES_TAC
              ) then_tac \
              REWRITE_TAC(PairList [])
            ) then_tac \
            ASM_ARITH_TAC
          )
        ]
      )
    ]
  )

