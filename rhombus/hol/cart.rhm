def dimindex:
  new_definition(
    @hol|{dimindex(s:A->bool) = if FINITE(:A) then CARD(:A) else 1}|
  )

def DIMINDEX_NONZERO:
  prove(
    [
      @hol|{!s:A->bool. ~(dimindex(s) = 0)}|,
      (
        (
          ((GEN_TAC then_tac REWRITE_TAC(PairList [dimindex])) then_tac COND_CASES_TAC) then_tac \
          ASM_SIMP_TAC(PairList [CARD_EQ_0, ARITH])
        ) then_tac \
        SET_TAC(PairList [])
      )
    ]
  )

def DIMINDEX_GE_1:
  prove(
    [
      @hol|{!s:A->bool. 1 <= dimindex(s)}|,
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            @hol|{1 <= x <=> ~(x = 0)}|
          ),
          DIMINDEX_NONZERO
        ]
      )
    ]
  )

def DIMINDEX_UNIV:
  prove(
    [
      @hol|{!s. dimindex(s:A->bool) = dimindex(:A)}|,
      REWRITE_TAC(PairList [dimindex])
    ]
  )

def DIMINDEX_UNIQUE:
  prove(
    [
      @hol|{(:A) HAS_SIZE n ==> dimindex(:A) = n}|,
      MESON_TAC(PairList [dimindex, HAS_SIZE])
    ]
  )

def UNIV_HAS_SIZE_DIMINDEX:
  prove(
    [
      @hol|{(:N) HAS_SIZE dimindex (:N) <=> FINITE(:N)}|,
      MESON_TAC(PairList [HAS_SIZE, dimindex])
    ]
  )

def HAS_SIZE_1:
  prove(
    [
      @hol|{(:1) HAS_SIZE 1}|,
      (
        SUBGOAL_THEN(
          @hol|{(:1) = {one}}|
        )(SUBST1_TAC) then_list \
        PairList [
          (
            REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_SING]) then_tac \
            MESON_TAC(PairList [one])
          ),
          SIMP_TAC(
            PairList [NOT_IN_EMPTY, HAS_SIZE, FINITE_RULES, CARD_CLAUSES, ARITH]
          )
        ]
      )
    ]
  )

def NUMSEG_LT_DIMINDEX:
  prove(
    [
      @hol|{{i | i < dimindex(:N)} = 0..dimindex(:N)-1}|,
      REWRITE_TAC(PairList [NUMSEG_LT, DIMINDEX_NONZERO])
    ]
  )

def DIMINDEX_1 = MATCH_MP(DIMINDEX_UNIQUE)(HAS_SIZE_1)

def finite_image_tybij:
  new_type_definition("finite_image")(["finite_index", "dest_finite_image"])(
    prove(
      [
        @hol|{?x. x IN 1..dimindex(:A)}|,
        (
          EXISTS_TAC(
            @hol|{1}|
          ) then_tac \
          REWRITE_TAC(PairList [IN_NUMSEG, LE_REFL, DIMINDEX_GE_1])
        )
      ]
    )
  )

def FINITE_IMAGE_IMAGE:
  prove(
    [
      @hol|{UNIV:(A)finite_image->bool = IMAGE finite_index (1..dimindex(:A))}|,
      (
        REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_IMAGE]) then_tac \
        MESON_TAC(PairList [finite_image_tybij])
      )
    ]
  )

def HAS_SIZE_FINITE_IMAGE:
  prove(
    [
      @hol|{!s. (UNIV:(A)finite_image->bool) HAS_SIZE dimindex(s:A->bool)}|,
      (
        (
          (
            (
              (GEN_TAC then_tac SIMP_TAC(PairList [FINITE_IMAGE_IMAGE])) then_tac \
              MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ)
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [DIMINDEX_UNIV])
          ) then_tac \
          REWRITE_TAC(PairList [HAS_SIZE_NUMSEG_1])
        ) then_tac \
        MESON_TAC(PairList [finite_image_tybij])
      )
    ]
  )

def CARD_FINITE_IMAGE:
  prove(
    [
      @hol|{!s. CARD(UNIV:(A)finite_image->bool) = dimindex(s:A->bool)}|,
      MESON_TAC(PairList [HAS_SIZE_FINITE_IMAGE, HAS_SIZE])
    ]
  )

def FINITE_FINITE_IMAGE:
  prove(
    [
      @hol|{FINITE(UNIV:(A)finite_image->bool)}|,
      MESON_TAC(PairList [HAS_SIZE_FINITE_IMAGE, HAS_SIZE])
    ]
  )

def DIMINDEX_FINITE_IMAGE:
  prove(
    [
      @hol|{!s t. dimindex(s:(A)finite_image->bool) = dimindex(t:A->bool)}|,
      (
        (
          (
            REPEAT(GEN_TAC) then_tac \
            GEN_REWRITE_TAC(LAND_CONV)(PairList [dimindex])
          ) then_tac \
          MP_TAC(ISPEC(@hol|{t:A->bool}|)(HAS_SIZE_FINITE_IMAGE))
        ) then_tac \
        SIMP_TAC(PairList [FINITE_FINITE_IMAGE, HAS_SIZE])
      )
    ]
  )

def FINITE_INDEX_WORKS:
  prove(
    [
      @hol|{!i:(A)finite_image.
         ?!n. 1 <= n /\ n <= dimindex(:A) /\ (finite_index n = i)}|,
      (
        REWRITE_TAC(PairList [CONJ_ASSOC, GSYM(IN_NUMSEG)]) then_tac \
        MESON_TAC(PairList [finite_image_tybij])
      )
    ]
  )

def FINITE_INDEX_INJ:
  prove(
    [
      @hol|{!i j. 1 <= i /\ i <= dimindex(:A) /\
         1 <= j /\ j <= dimindex(:A)
         ==> ((finite_index i :A finite_image = finite_index j) <=>
              (i = j))}|,
      MESON_TAC(PairList [FINITE_INDEX_WORKS])
    ]
  )

def FORALL_FINITE_INDEX:
  prove(
    [
      @hol|{(!k:(N)finite_image. P k) =
         (!i. 1 <= i /\ i <= dimindex(:N) ==> P(finite_index i))}|,
      MESON_TAC(PairList [FINITE_INDEX_WORKS])
    ]
  )

def cart_tybij:
  new_type_definition("cart")(["mk_cart", "dest_cart"])(
    prove(
      [
        @hol|{?f:(B)finite_image->A. T}|,
        REWRITE_TAC(PairList [])
      ]
    )
  )

Host.parse_as_infix(["$", [25, "left"]])

def finite_index:
  new_definition(
    @hol|{(x:A^N)$i = dest_cart x (finite_index i)}|
  )

def CART_EQ:
  prove(
    [
      @hol|{!x:A^B y.
         (x = y) <=> !i. 1 <= i /\ i <= dimindex(:B) ==> (x$i = y$i)}|,
      (
        (
          (
            REPEAT(GEN_TAC) then_tac \
            REWRITE_TAC(PairList [finite_index, GSYM(FORALL_FINITE_INDEX)])
          ) then_tac \
          REWRITE_TAC(PairList [GSYM(FUN_EQ_THM), ETA_AX])
        ) then_tac \
        MESON_TAC(PairList [cart_tybij])
      )
    ]
  )

Host.parse_as_binder("lambda")

def lambda:
  new_definition(
    @hol|{(lambda) g =
       @f:A^B. !i. 1 <= i /\ i <= dimindex(:B) ==> (f$i = g i)}|
  )

def LAMBDA_BETA:
  prove(
    [
      @hol|{!i. 1 <= i /\ i <= dimindex(:B)
         ==> (((lambda) g:A^B) $i = g i)}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (REWRITE_TAC(PairList [lambda]) then_tac CONV_TAC(SELECT_CONV)) then_tac \
                      EXISTS_TAC(
                        @hol|{mk_cart(\k. g(@i. 1 <= i /\  i <= dimindex(:B) /\
                           (finite_index i = k))):A^B}|
                      )
                    ) then_tac \
                    REWRITE_TAC(PairList [finite_index, REWRITE_RULE(PairList [])(cart_tybij)])
                  ) then_tac \
                  REPEAT(STRIP_TAC)
                ) then_tac \
                AP_TERM_TAC
              ) then_tac \
              MATCH_MP_TAC(SELECT_UNIQUE)
            ) then_tac \
            GEN_TAC
          ) then_tac \
          REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_MESON_TAC(PairList [FINITE_INDEX_INJ, DIMINDEX_FINITE_IMAGE])
      )
    ]
  )

def LAMBDA_UNIQUE:
  prove(
    [
      @hol|{!f:A^B g.
         (!i. 1 <= i /\ i <= dimindex(:B) ==> (f$i = g i)) <=>
         ((lambda) g = f)}|,
      (SIMP_TAC(PairList [CART_EQ, LAMBDA_BETA]) then_tac MESON_TAC(PairList []))
    ]
  )

def LAMBDA_ETA:
  prove(
    [
      @hol|{!g. (lambda i. g$i):A^B = g}|,
      REWRITE_TAC(PairList [CART_EQ, LAMBDA_BETA])
    ]
  )

def FINITE_INDEX_INRANGE:
  prove(
    [
      @hol|{!i. ?k. 1 <= k /\ k <= dimindex(:N) /\ !x:A^N. x$i = x$k}|,
      (
        REWRITE_TAC(PairList [finite_index]) then_tac \
        MESON_TAC(PairList [FINITE_INDEX_WORKS])
      )
    ]
  )

def FINITE_INDEX_INRANGE_2:
  prove(
    [
      @hol|{!i. ?k. 1 <= k /\ k <= dimindex(:N) /\
         (!x:A^N. x$i = x$k) /\ (!y:B^N. y$i = y$k)}|,
      (
        REWRITE_TAC(PairList [finite_index]) then_tac \
        MESON_TAC(PairList [FINITE_INDEX_WORKS])
      )
    ]
  )

def CART_EQ_FULL:
  prove(
    [
      @hol|{!x y:A^N. x = y <=> !i. x$i = y$i}|,
      (
        ((REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac SIMP_TAC(PairList [])) then_tac \
        SIMP_TAC(PairList [CART_EQ])
      )
    ]
  )

def finite_sum_tybij:
  let th:
    prove(
      [
        @hol|{?x. x IN 1..(dimindex(:A) + dimindex(:B))}|,
        (
          EXISTS_TAC(
            @hol|{1}|
          ) then_tac \
          SIMP_TAC(
            PairList [
              IN_NUMSEG,
              LE_REFL,
              DIMINDEX_GE_1,
              ARITH_RULE(
                @hol|{1 <= a ==> 1 <= a + b}|
              )
            ]
          )
        )
      ]
    )
  new_type_definition("finite_sum")(["mk_finite_sum", "dest_finite_sum"])(th)

def pastecart:
  new_definition(
    @hol|{(pastecart:A^M->A^N->A^(M,N)finite_sum) f g =
       lambda i. if i <= dimindex(:M) then f$i
                 else g$(i - dimindex(:M))}|
  )

def fstcart:
  new_definition(
    @hol|{(fstcart:A^(M,N)finite_sum->A^M) f = lambda i. f$i}|
  )

def sndcart:
  new_definition(
    @hol|{(sndcart:A^(M,N)finite_sum->A^N) f =
       lambda i. f$(i + dimindex(:M))}|
  )

def FINITE_SUM_IMAGE:
  prove(
    [
      @hol|{UNIV:(A,B)finite_sum->bool =
         IMAGE mk_finite_sum (1..(dimindex(:A)+dimindex(:B)))}|,
      (
        REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_IMAGE]) then_tac \
        MESON_TAC(PairList [finite_sum_tybij])
      )
    ]
  )

def DIMINDEX_HAS_SIZE_FINITE_SUM:
  prove(
    [
      @hol|{(UNIV:(M,N)finite_sum->bool) HAS_SIZE (dimindex(:M) + dimindex(:N))}|,
      (
        (
          (
            (
              SIMP_TAC(PairList [FINITE_SUM_IMAGE]) then_tac \
              MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ)
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [DIMINDEX_UNIV])
          ) then_tac \
          REWRITE_TAC(PairList [HAS_SIZE_NUMSEG_1])
        ) then_tac \
        MESON_TAC(PairList [finite_sum_tybij])
      )
    ]
  )

def DIMINDEX_FINITE_SUM:
  prove(
    [
      @hol|{dimindex(:(M,N)finite_sum) = dimindex(:M) + dimindex(:N)}|,
      (
        GEN_REWRITE_TAC(LAND_CONV)(PairList [dimindex]) then_tac \
        REWRITE_TAC(PairList [REWRITE_RULE(PairList [HAS_SIZE])(DIMINDEX_HAS_SIZE_FINITE_SUM)])
      )
    ]
  )

def FSTCART_PASTECART:
  prove(
    [
      @hol|{!x y. fstcart(pastecart (x:A^M) (y:A^N)) = x}|,
      SIMP_TAC(
        PairList [
          pastecart,
          fstcart,
          CART_EQ,
          LAMBDA_BETA,
          DIMINDEX_FINITE_SUM,
          ARITH_RULE(
            @hol|{a <= b ==> a <= b + c}|
          )
        ]
      )
    ]
  )

def SNDCART_PASTECART:
  prove(
    [
      @hol|{!x y. sndcart(pastecart (x:A^M) (y:A^N)) = y}|,
      (
        (
          (
            (
              SIMP_TAC(PairList [pastecart, sndcart, CART_EQ, LAMBDA_BETA]) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            W(
              (fun([_, w]): MP_TAC(PART_MATCH(o(lhs)(rand))(LAMBDA_BETA)(lhand(w))))
            )
          ) then_tac \
          ANTS_TAC
        ) then_list \
        PairList [
          (
            (
              REWRITE_TAC(PairList [DIMINDEX_FINITE_SUM]) then_tac \
              MATCH_MP_TAC(
                ARITH_RULE(
                  @hol|{1 <= i /\ i <= b ==> 1 <= i + a /\ i + a <= a + b}|
                )
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ),
          (
            (DISCH_THEN(SUBST1_TAC) then_tac REWRITE_TAC(PairList [])) then_tac \
            ASM_SIMP_TAC(
              PairList [
                ADD_SUB,
                ARITH_RULE(
                  @hol|{1 <= i ==> ~(i + a <= a)}|
                )
              ]
            )
          )
        ]
      )
    ]
  )

def PASTECART_FST_SND:
  prove(
    [
      @hol|{!z. pastecart (fstcart z) (sndcart z):A^(M,N)finite_sum = z}|,
      (
        (
          (
            (
              SIMP_TAC(PairList [pastecart, fstcart, sndcart, CART_EQ, LAMBDA_BETA]) then_tac \
              REPEAT(GEN_TAC)
            ) then_tac \
            COND_CASES_TAC
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            DIMINDEX_FINITE_SUM,
            LAMBDA_BETA,
            ARITH_RULE(
              @hol|{i <= a + b ==> i - a <= b}|
            ),
            ARITH_RULE(
              @hol|{~(i <= a) ==> 1 <= i - a}|
            ),
            ARITH_RULE(
              @hol|{~(i <= a) ==> ((i - a) + a = i)}|
            )
          ]
        )
      )
    ]
  )

def PASTECART_EQ:
  prove(
    [
      @hol|{!x y:A^(M,N)finite_sum.
         x = y <=> fstcart x = fstcart y /\ sndcart x = sndcart y}|,
      MESON_TAC(PairList [PASTECART_FST_SND])
    ]
  )

def FORALL_PASTECART:
  prove(
    [
      @hol|{(!p:A^(M,N)finite_sum. P p) <=> !x y. P (pastecart x y)}|,
      MESON_TAC(PairList [PASTECART_FST_SND, FSTCART_PASTECART, SNDCART_PASTECART])
    ]
  )

def EXISTS_PASTECART:
  prove(
    [
      @hol|{(?p:A^(M,N)finite_sum. P p) <=> ?x y. P (pastecart x y)}|,
      MESON_TAC(PairList [PASTECART_FST_SND, FSTCART_PASTECART, SNDCART_PASTECART])
    ]
  )

def PASTECART_INJ:
  prove(
    [
      @hol|{!x:A^M y:A^N w z. pastecart x y = pastecart w z <=> x = w /\ y = z}|,
      REWRITE_TAC(PairList [PASTECART_EQ, FSTCART_PASTECART, SNDCART_PASTECART])
    ]
  )

def FSTCART_COMPONENT:
  prove(
    [
      @hol|{!x:A^(M,N)finite_sum i. 1 <= i /\ i <= dimindex(:M)
         ==> fstcart x$i = x$i}|,
      SIMP_TAC(PairList [fstcart, LAMBDA_BETA])
    ]
  )

def SNDCART_COMPONENT:
  prove(
    [
      @hol|{!x:A^(M,N)finite_sum i. 1 <= i /\ i <= dimindex(:N)
         ==> sndcart x$i = x$(i + dimindex(:M))}|,
      SIMP_TAC(PairList [sndcart, LAMBDA_BETA])
    ]
  )

def PASTECART_COMPONENT:
  prove(
    [
      @hol|{(!u:A^M v:A^N i. 1 <= i /\ i <= dimindex(:M) ==> pastecart u v$i = u$i) /\
         (!u:A^M v:A^N i. dimindex(:M) + 1 <= i /\ i <= dimindex(:M) + dimindex(:N)
                          ==> pastecart u v$i = v$(i - dimindex(:M)))}|,
      (
        (
          (
            (REWRITE_TAC(PairList [pastecart]) then_tac CONJ_TAC) then_tac \
            REPEAT(GEN_TAC)
          ) then_tac \
          STRIP_TAC
        ) then_list \
        PairList [
          (
            (
              SUBGOAL_THEN(
                @hol|{i <= dimindex(:(M,N)finite_sum)}|
              )((fun(th): ASM_SIMP_TAC(PairList [LAMBDA_BETA, th]))) then_tac \
              REWRITE_TAC(PairList [DIMINDEX_FINITE_SUM])
            ) then_tac \
            ASM_ARITH_TAC
          ),
          (
            (
              (
                ASM_SIMP_TAC(
                  PairList [
                    LAMBDA_BETA,
                    DIMINDEX_FINITE_SUM,
                    ARITH_RULE(
                      @hol|{dimindex(:M) + 1 <= i ==> 1 <= i}|
                    )
                  ]
                ) then_tac \
                COND_CASES_TAC
              ) then_tac \
              REWRITE_TAC(PairList [])
            ) then_tac \
            ASM_ARITH_TAC
          )
        ]
      )
    ]
  )

def finite_diff_tybij:
  let th:
    prove(
      [
        @hol|{?x. x IN 1..(if dimindex(:B) < dimindex(:A)
           then dimindex(:A) - dimindex(:B) else 1)}|,
        (
          (
            EXISTS_TAC(
              @hol|{1}|
            ) then_tac \
            REWRITE_TAC(PairList [IN_NUMSEG])
          ) then_tac \
          ARITH_TAC
        )
      ]
    )
  new_type_definition("finite_diff")(["mk_finite_diff", "dest_finite_diff"])(th)

def FINITE_DIFF_IMAGE:
  prove(
    [
      @hol|{UNIV:(A,B)finite_diff->bool =
         IMAGE mk_finite_diff
         (1..(if dimindex(:B) < dimindex(:A)
                    then dimindex(:A) - dimindex(:B) else 1))}|,
      (
        REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_IMAGE]) then_tac \
        MESON_TAC(PairList [finite_diff_tybij])
      )
    ]
  )

def DIMINDEX_HAS_SIZE_FINITE_DIFF:
  prove(
    [
      @hol|{(UNIV:(M,N)finite_diff->bool) HAS_SIZE
         (if dimindex(:N) < dimindex(:M) then dimindex(:M) - dimindex(:N) else 1)}|,
      (
        (
          (
            (
              SIMP_TAC(PairList [FINITE_DIFF_IMAGE]) then_tac \
              MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ)
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [DIMINDEX_UNIV])
          ) then_tac \
          REWRITE_TAC(PairList [HAS_SIZE_NUMSEG_1])
        ) then_tac \
        MESON_TAC(PairList [finite_diff_tybij])
      )
    ]
  )

def DIMINDEX_FINITE_DIFF:
  prove(
    [
      @hol|{dimindex(:(M,N)finite_diff) =
         if dimindex(:N) < dimindex(:M) then dimindex(:M) - dimindex(:N) else 1}|,
      (
        GEN_REWRITE_TAC(LAND_CONV)(PairList [dimindex]) then_tac \
        REWRITE_TAC(PairList [REWRITE_RULE(PairList [HAS_SIZE])(DIMINDEX_HAS_SIZE_FINITE_DIFF)])
      )
    ]
  )

def finite_prod_tybij:
  let th:
    prove(
      [
        @hol|{?x. x IN 1..(dimindex(:A) * dimindex(:B))}|,
        (
          (
            EXISTS_TAC(
              @hol|{1}|
            ) then_tac \
            REWRITE_TAC(PairList [IN_NUMSEG, LE_REFL])
          ) then_tac \
          MESON_TAC(PairList [LE_1, DIMINDEX_GE_1, MULT_EQ_0])
        )
      ]
    )
  new_type_definition("finite_prod")(["mk_finite_prod", "dest_finite_prod"])(th)

def FINITE_PROD_IMAGE:
