      )
    ]
  )

def PCROSS_INTER:
  prove(
    [
      (hol:
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const INTER :: (cart(A, N) -> bool) -> (cart(A, N) -> bool) -> cart(A, N) -> bool
         const INTER_2 as INTER :: (cart(A, finite_sum(M, N)) -> bool) -> (cart(A, finite_sum(M, N)) -> bool) -> cart(A, finite_sum(M, N)) -> bool
