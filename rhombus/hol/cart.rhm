        ) then_tac \
        MESON_TAC(PairList [finite_prod_tybij])
      )
    ]
  )

def DIMINDEX_FINITE_PROD:
  prove(
    [
      @hol|{dimindex(:(M,N)finite_prod) = dimindex(:M) * dimindex(:N)}|,
      (
        GEN_REWRITE_TAC(LAND_CONV)(PairList [dimindex]) then_tac \
        REWRITE_TAC(PairList [REWRITE_RULE(PairList [HAS_SIZE])(DIMINDEX_HAS_SIZE_FINITE_PROD)])
      )
    ]
  )

def [cart_tybit0_INDUCT_v2, tybit0_RECURSION] = define_type("tybit0 = mktybit0((A,A)finite_sum)")

def [cart_tybit1_INDUCT_v2, tybit1_RECURSION] = define_type("tybit1 = mktybit1(((A,A)finite_sum,1)finite_sum)")

def HAS_SIZE_TYBIT0:
  prove(
    [
      @hol|{(:(A)tybit0) HAS_SIZE 2 * dimindex(:A)}|,
      (
        SUBGOAL_THEN(
          @hol|{(:(A)tybit0) = IMAGE mktybit0 (:(A,A)finite_sum)}|
        )(SUBST1_TAC) then_list \
        PairList [
          (
            (
              (CONV_TAC(SYM_CONV) then_tac MATCH_MP_TAC(SURJECTIVE_IMAGE_EQ)) then_tac \
              REWRITE_TAC(PairList [IN_UNIV])
            ) then_tac \
            MESON_TAC(PairList [cases("tybit0")])
          ),
          (
            (
              (
                MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ) then_tac \
                REWRITE_TAC(PairList [IN_UNIV, injectivity("tybit0")])
              ) then_tac \
              W(
                o(o(o(MP_TAC)(PART_MATCH(lhand)(DIMINDEX_HAS_SIZE_FINITE_SUM)))(lhand))(snd)
              )
            ) then_tac \
            REWRITE_TAC(PairList [DIMINDEX_FINITE_SUM, GSYM(MULT_2)])
          )
        ]
      )
    ]
  )

def HAS_SIZE_TYBIT1:
  prove(
    [
      @hol|{(:(A)tybit1) HAS_SIZE 2 * dimindex(:A) + 1}|,
      (
        SUBGOAL_THEN(
          @hol|{(:(A)tybit1) = IMAGE mktybit1 (:((A,A)finite_sum,1)finite_sum)}|
        )(SUBST1_TAC) then_list \
        PairList [
          (
            (
              (CONV_TAC(SYM_CONV) then_tac MATCH_MP_TAC(SURJECTIVE_IMAGE_EQ)) then_tac \
              REWRITE_TAC(PairList [IN_UNIV])
            ) then_tac \
            MESON_TAC(PairList [cases("tybit1")])
          ),
          (
            (
              (
                MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ) then_tac \
                REWRITE_TAC(PairList [IN_UNIV, injectivity("tybit1")])
              ) then_tac \
              W(
                o(o(o(MP_TAC)(PART_MATCH(lhand)(DIMINDEX_HAS_SIZE_FINITE_SUM)))(lhand))(snd)
              )
            ) then_tac \
            REWRITE_TAC(PairList [DIMINDEX_FINITE_SUM, DIMINDEX_1, GSYM(MULT_2)])
          )
        ]
      )
    ]
  )

def DIMINDEX_TYBIT0:
  prove(
    [
      @hol|{dimindex(:(A)tybit0) = 2 * dimindex(:A)}|,
      (MATCH_MP_TAC(DIMINDEX_UNIQUE) then_tac MATCH_ACCEPT_TAC(HAS_SIZE_TYBIT0))
    ]
  )

def DIMINDEX_TYBIT1:
  prove(
    [
      @hol|{dimindex(:(A)tybit1) = 2 * dimindex(:A) + 1}|,
      (MATCH_MP_TAC(DIMINDEX_UNIQUE) then_tac MATCH_ACCEPT_TAC(HAS_SIZE_TYBIT1))
    ]
  )

def DIMINDEX_CLAUSES:
  prove(
    [
      @hol|{dimindex(:1) = 1 /\
         dimindex(:(A)tybit0) = 2 * dimindex(:A) /\
         dimindex(:(A)tybit1) = 2 * dimindex(:A) + 1}|,
      (
        (
          (REWRITE_TAC(PairList [DIMINDEX_1]) then_tac CONJ_TAC) then_tac \
          MATCH_MP_TAC(DIMINDEX_UNIQUE)
        ) then_tac \
        REWRITE_TAC(PairList [HAS_SIZE_TYBIT0, HAS_SIZE_TYBIT1])
      )
    ]
  )

def FINITE_1:
  prove(
    [
      @hol|{FINITE (:1)}|,
      MESON_TAC(PairList [HAS_SIZE_1, HAS_SIZE])
    ]
  )

def FINITE_TYBIT0:
  prove(
    [
      @hol|{FINITE (:A tybit0)}|,
      MESON_TAC(PairList [HAS_SIZE_TYBIT0, HAS_SIZE])
    ]
  )

def FINITE_TYBIT1:
  prove(
    [
      @hol|{FINITE (:A tybit1)}|,
      MESON_TAC(PairList [HAS_SIZE_TYBIT1, HAS_SIZE])
    ]
  )

def FINITE_CLAUSES:
  prove(
    [
      @hol|{FINITE(:1) /\ FINITE(:A tybit0) /\ FINITE(:A tybit1)}|,
      REWRITE_TAC(PairList [FINITE_1, FINITE_TYBIT0, FINITE_TYBIT1])
    ]
  )

def DIMINDEX_CONV:
  let PairList [pth_num, & PairList [pth0, & PairList [pth1, & PairList [pth_one, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{(dimindex(:A) = n <=> dimindex(s:A->bool) = NUMERAL n) /\
           (dimindex(:A) = n <=> dimindex(:A tybit0) = BIT0 n) /\
           (dimindex(:A) = n <=> dimindex(:A tybit1) = BIT1 n) /\
           dimindex(:1) = BIT1 _0}|,
        (
          (
            (
              (
                CONJ_TAC then_list \
                PairList [REWRITE_TAC(PairList [NUMERAL, dimindex]), ALL_TAC]
              ) then_tac \
              REWRITE_TAC(PairList [DIMINDEX_CLAUSES])
            ) then_tac \
            CONV_TAC(BITS_ELIM_CONV)
          ) then_tac \
          ARITH_TAC
        )
      ]
    )
  let nvar = @hol|{n:num}|
  fun calc_dimindex(ty):
    match ty
    | Tyapp("1",_): pth_one
    | Tyapp("tybit0",PairList [ty_prime, & _]):
        let th = calc_dimindex(ty_prime)
        let n = rand(concl(th))
        EQ_MP(INST(PairList [[n, nvar]])(INST_TYPE(PairList [[ty_prime, aty]])(pth0)))(th)
    | Tyapp("tybit1",PairList [ty_prime, & _]):
        let th = calc_dimindex(ty_prime)
        let n = rand(concl(th))
        EQ_MP(INST(PairList [[n, nvar]])(INST_TYPE(PairList [[ty_prime, aty]])(pth1)))(th)
    | _: fail()
  fun
  | (Comb(Const("dimindex",_),tm)):
      let uty = type_of(tm)
      let [_, PairList [sty, & _]] = dest_type(uty)
      let th = calc_dimindex(sty)
      let svar_2 = mk_var(["s", uty])
      let ntm_2 = rand(concl(th))
      let pth = INST(PairList [[tm, svar_2], [ntm_2, nvar]])(INST_TYPE(PairList [[sty, aty]])(pth_num))
      EQ_MP(pth)(th)
  | (_): failwith("DIMINDEX_CONV")

def HAS_SIZE_DIMINDEX_RULE:
  let pth:
    prove(
      [
        @hol|{(:A) HAS_SIZE n <=> FINITE(:A) /\ dimindex(:A) = n}|,
        MESON_TAC(PairList [UNIV_HAS_SIZE_DIMINDEX, HAS_SIZE])
      ]
    )
  let htm_2:
    @hol|{(HAS_SIZE) (:A)}|
  let conv_2 = GEN_REWRITE_CONV(I)(PairList [pth])
  let rule_2 = o(EQT_ELIM)(GEN_REWRITE_CONV(I)(PairList [FINITE_CLAUSES]))
  fun(nty):
    let tm = mk_comb([inst(PairList [[nty, aty]])(htm_2), mk_numeral(dest_finty(nty))])
    let th1 = conv_2(tm)
    EQ_MP(SYM(th1))(
      CONJ(rule_2(lhand(rand(concl(th1)))))(DIMINDEX_CONV(lhand(rand(rand(concl(th1))))))
    )

def DIMINDEX_TAC = CONV_TAC(ONCE_DEPTH_CONV(DIMINDEX_CONV))

def DIMINDEX_2:
  prove(
    [
      @hol|{dimindex (:2) = 2}|,
      (DIMINDEX_TAC then_tac REFL_TAC)
    ]
  )

def DIMINDEX_3:
  prove(
    [
      @hol|{dimindex (:3) = 3}|,
      (DIMINDEX_TAC then_tac REFL_TAC)
    ]
  )

def DIMINDEX_4:
  prove(
    [
      @hol|{dimindex (:4) = 4}|,
      (DIMINDEX_TAC then_tac REFL_TAC)
    ]
  )

def HAS_SIZE_2 = HAS_SIZE_DIMINDEX_RULE(@hol|{:2}|)

def HAS_SIZE_3 = HAS_SIZE_DIMINDEX_RULE(@hol|{:3}|)

def HAS_SIZE_4 = HAS_SIZE_DIMINDEX_RULE(@hol|{:4}|)

def FINITE_CART:
  prove(
    [
      @hol|{!P. (!i. 1 <= i /\ i <= dimindex(:N) ==> FINITE {x | P i x})
         ==> FINITE {v:A^N | !i. 1 <= i /\ i <= dimindex(:N) ==> P i (v$i)}}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (GEN_TAC then_tac DISCH_TAC) then_tac \
                                        SUBGOAL_THEN(
                                          @hol|{!n. n <= dimindex(:N)
                                             ==> FINITE {v:A^N | (!i. 1 <= i /\ i <= dimindex(:N) /\ i <= n
                                                                      ==> P i (v$i)) /\
                                                                 (!i. 1 <= i /\ i <= dimindex(:N) /\ n < i
                                                                      ==> v$i = @x. F)}}|
                                        )(
                                          o(MP_TAC)(
                                            SPEC(
                                              @hol|{dimindex(:N)}|
                                            )
                                          )
                                        )
                                      ) then_tac \
                                      REWRITE_TAC(PairList [LE_REFL, LET_ANTISYM])
                                    ) then_tac \
                                    INDUCT_TAC
                                  ) then_list \
                                  PairList [
                                    (
                                      (
                                        (
                                          REWRITE_TAC(
                                            PairList [
                                              ARITH_RULE(
                                                @hol|{1 <= i /\ i <= n /\ i <= 0 <=> F}|
                                              )
                                            ]
                                          ) then_tac \
                                          SIMP_TAC(
                                            PairList [
                                              ARITH_RULE(
                                                @hol|{1 <= i /\ i <= n /\ 0 < i <=> 1 <= i /\ i <= n}|
                                              )
                                            ]
                                          )
                                        ) then_tac \
                                        SUBGOAL_THEN(
                                          @hol|{{v | !i. 1 <= i /\ i <= dimindex (:N) ==> v$i = (@x. F)} =
                                             {(lambda i. @x. F):A^N}}|
                                        )((fun(th): SIMP_TAC(PairList [FINITE_RULES, th])))
                                      ) then_tac \
                                      SIMP_TAC(PairList [EXTENSION, IN_SING, IN_ELIM_THM, CART_EQ, LAMBDA_BETA])
                                    ),
                                    ALL_TAC
                                  ]
                                ) then_tac \
                                DISCH_TAC
                              ) then_tac \
                              MATCH_MP_TAC(FINITE_SUBSET)
                            ) then_tac \
                            EXISTS_TAC(
                              @hol|{IMAGE (\(x:A,v:A^N). (lambda i. if i = SUC n then x else v$i):A^N)
                                 {x,v | x IN {x:A | P (SUC n) x} /\
                                        v IN {v:A^N | (!i. 1 <= i /\ i <= dimindex(:N) /\ i <= n
                                                       ==> P i (v$i)) /\
                                                  (!i. 1 <= i /\ i <= dimindex (:N) /\ n < i
                                                       ==> v$i = (@x. F))}}}|
                            )
                          ) then_tac \
                          CONJ_TAC
                        ) then_list \
                        PairList [
                          (
                            MATCH_MP_TAC(FINITE_IMAGE) then_tac \
                            ASM_SIMP_TAC(
                              PairList [
                                FINITE_PRODUCT,
                                ARITH_RULE(
                                  @hol|{1 <= SUC n}|
                                ),
                                ARITH_RULE(
                                  @hol|{SUC n <= m ==> n <= m}|
                                )
                              ]
                            )
                          ),
                          ALL_TAC
                        ]
                      ) then_tac \
                      REWRITE_TAC(PairList [SUBSET, IN_IMAGE, IN_ELIM_PAIR_THM, EXISTS_PAIR_THM])
                    ) then_tac \
                    X_GEN_TAC(@hol|{v:A^N}|)
                  ) then_tac \
                  REWRITE_TAC(PairList [IN_ELIM_THM])
                ) then_tac \
                STRIP_TAC
              ) then_tac \
              EXISTS_TAC(
                @hol|{(v:A^N)$(SUC n)}|
              )
            ) then_tac \
            EXISTS_TAC(
              @hol|{(lambda i. if i = SUC n then @x. F else (v:A^N)$i):A^N}|
            )
          ) then_tac \
          SIMP_TAC(
            PairList [
              CART_EQ,
              LAMBDA_BETA,
              ARITH_RULE(
                @hol|{i <= n ==> ~(i = SUC n)}|
              )
            ]
          )
        ) then_tac \
        ASM_MESON_TAC(
          PairList [
            LE,
            ARITH_RULE(
              @hol|{1 <= SUC n}|
            ),
            ARITH_RULE(
              @hol|{n < i /\ ~(i = SUC n) ==> SUC n < i}|
            )
          ]
        )
      )
    ]
  )

def HAS_SIZE_CART_UNIV:
  prove(
    [
      @hol|{!m. (:A) HAS_SIZE m ==> (:A^N) HAS_SIZE m EXP (dimindex(:N))}|,
      (
        (
          REPEAT(STRIP_TAC) then_tac \
          SUBGOAL_THEN(
            @hol|{(:(N)finite_image->A) HAS_SIZE m EXP (dimindex(:N))}|
          )(MP_TAC)
        ) then_list \
        PairList [
          ASM_SIMP_TAC(PairList [HAS_SIZE_FUNSPACE_UNIV, HAS_SIZE_FINITE_IMAGE]),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          DISCH_THEN(
                            o(
                              o(MP_TAC)(
                                ISPEC(
                                  @hol|{mk_cart:((N)finite_image->A)->A^N}|
                                )
                              )
                            )(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ_ALT])(HAS_SIZE_IMAGE_INJ)))
                          ) then_tac \
                          REWRITE_TAC(PairList [IN_UNIV])
                        ) then_tac \
                        ANTS_TAC
                      ) then_list \
                      PairList [MESON_TAC(PairList [cart_tybij]), MATCH_MP_TAC(EQ_IMP)]
                    ) then_tac \
                    AP_THM_TAC
                  ) then_tac \
                  AP_TERM_TAC
                ) then_tac \
                MATCH_MP_TAC(SURJECTIVE_IMAGE_EQ)
              ) then_tac \
              REWRITE_TAC(PairList [IN_UNIV])
            ) then_tac \
            MESON_TAC(PairList [cart_tybij])
          )
        ]
      )
    ]
  )

def CARD_CART_UNIV:
  prove(
    [
      @hol|{FINITE(:A) ==> CARD(:A^N) = CARD(:A) EXP dimindex(:N)}|,
      MESON_TAC(PairList [HAS_SIZE_CART_UNIV, HAS_SIZE])
    ]
  )

def FINITE_CART_UNIV:
  prove(
    [
      @hol|{FINITE(:A) ==> FINITE(:A^N)}|,
      MESON_TAC(PairList [HAS_SIZE_CART_UNIV, HAS_SIZE])
    ]
  )

def vector:
  new_definition(
    @hol|{(vector l):A^N = lambda i. EL (i - 1) l}|
  )

def IN_ELIM_PASTECART_THM:
  prove(
    [
      @hol|{!P (a:A^M) (b:A^N). pastecart a b IN {pastecart x y | P x y} <=> P a b}|,
      (
        REWRITE_TAC(PairList [IN_ELIM_THM, PASTECART_EQ, FSTCART_PASTECART, SNDCART_PASTECART]) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

Host.parse_as_infix(["PCROSS", [22, "right"]])

def PCROSS:
  new_definition(
    @hol|{s PCROSS t = {pastecart (x:A^M) (y:A^N) | x IN s /\ y IN t}}|
  )

def FORALL_IN_PCROSS:
  prove(
    [
      @hol|{(!z:A^(M,N)finite_sum. z IN s PCROSS t ==> P z) <=>
         (!x y. x IN s /\ y IN t ==> P(pastecart x y))}|,
      REWRITE_TAC(PairList [PCROSS, FORALL_IN_GSPEC])
    ]
  )

def EXISTS_IN_PCROSS:
  prove(
    [
      @hol|{(?z:A^(M,N)finite_sum. z IN s PCROSS t /\ P z) <=>
         (?x y. x IN s /\ y IN t /\ P(pastecart x y))}|,
      REWRITE_TAC(PairList [PCROSS, EXISTS_IN_GSPEC, CONJ_ASSOC])
    ]
  )

def PASTECART_IN_PCROSS:
  prove(
    [
      @hol|{!s t (x:A^M) (y:A^N). (pastecart x y) IN (s PCROSS t) <=> x IN s /\ y IN t}|,
      REWRITE_TAC(PairList [PCROSS, IN_ELIM_PASTECART_THM])
    ]
  )

def PCROSS_EQ_EMPTY:
  prove(
    [
      @hol|{!(s:A^M->bool) (t:A^N->bool). s PCROSS t = {} <=> s = {} \/ t = {}}|,
      (REWRITE_TAC(PairList [PCROSS]) then_tac SET_TAC(PairList []))
    ]
  )

def PCROSS_EMPTY:
  prove(
    [
      @hol|{(!s. (s PCROSS {}) :A^(M,N)finite_sum->bool = {}) /\
         (!t. ({} PCROSS t) :A^(M,N)finite_sum->bool = {})}|,
      REWRITE_TAC(PairList [PCROSS_EQ_EMPTY])
    ]
  )

def PCROSS_SING:
  prove(
    [
      @hol|{!(x:A^M) (y:A^N). {x} PCROSS {y} = {pastecart x y}}|,
      REWRITE_TAC(PairList [EXTENSION, FORALL_PASTECART, IN_SING, PASTECART_IN_PCROSS, PASTECART_INJ])
    ]
  )

def SUBSET_PCROSS:
  prove(
    [
      @hol|{!(s:A^M->bool) (t:A^N->bool) s' t'.
         s PCROSS t SUBSET s' PCROSS t' <=>
         s = {} \/ t = {} \/ s SUBSET s' /\ t SUBSET t'}|,
      (
        SIMP_TAC(
          PairList [
            PCROSS,
            EXTENSION,
            IN_ELIM_PASTECART_THM,
            SUBSET,
            FORALL_PASTECART,
            PASTECART_IN_PCROSS,
            NOT_IN_EMPTY
          ]
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def PCROSS_MONO:
  prove(
    [
      @hol|{!(s:A^M->bool) (t:A^N->bool) s' t'.
         s SUBSET s' /\ t SUBSET t' ==> s PCROSS t SUBSET s' PCROSS t'}|,
      SIMP_TAC(PairList [SUBSET_PCROSS])
    ]
  )

def PCROSS_EQ:
  prove(
    [
      @hol|{!s s':real^M->bool t t':real^N->bool.
         s PCROSS t = s' PCROSS t' <=>
         (s = {} \/ t = {}) /\ (s' = {} \/ t' = {}) \/ s = s' /\ t = t'}|,
      (
        REWRITE_TAC(PairList [GSYM(SUBSET_ANTISYM_EQ), SUBSET_PCROSS]) then_tac \
        SET_TAC(PairList [])
      )
    ]
  )

def UNIV_PCROSS_UNIV:
  prove(
    [
      @hol|{(:A^M) PCROSS (:A^N) = (:A^(M,N)finite_sum)}|,
      REWRITE_TAC(PairList [EXTENSION, FORALL_PASTECART, PASTECART_IN_PCROSS, IN_UNIV])
    ]
  )

def HAS_SIZE_PCROSS:
  prove(
    [
      @hol|{!(s:A^M->bool) (t:A^N->bool) m n.
         s HAS_SIZE m /\ t HAS_SIZE n ==> (s PCROSS t) HAS_SIZE (m * n)}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (REPEAT(GEN_TAC) then_tac DISCH_TAC) then_tac \
                        FIRST_ASSUM(o(MP_TAC)(MATCH_MP(HAS_SIZE_PRODUCT)))
                      ) then_tac \
                      MATCH_MP_TAC(EQ_IMP)
                    ) then_tac \
                    SPEC_TAC(
                      [
                        @hol|{m * n:num}|,
                        @hol|{k:num}|
                      ]
                    )
                  ) then_tac \
                  MATCH_MP_TAC(BIJECTIONS_HAS_SIZE_EQ)
                ) then_tac \
                EXISTS_TAC(
                  @hol|{\(x:A^M,y:A^N). pastecart x y}|
                )
              ) then_tac \
              EXISTS_TAC(
                @hol|{\z:A^(M,N)finite_sum. fstcart z,sndcart z}|
              )
            ) then_tac \
            REWRITE_TAC(PairList [FORALL_IN_GSPEC, PASTECART_IN_PCROSS])
          ) then_tac \
          REWRITE_TAC(PairList [IN_ELIM_PAIR_THM, PASTECART_FST_SND])
        ) then_tac \
        REWRITE_TAC(PairList [FORALL_IN_PCROSS, FSTCART_PASTECART, SNDCART_PASTECART])
      )
    ]
  )

def FINITE_PCROSS:
  prove(
    [
      @hol|{!(s:A^M->bool) (t:A^N->bool).
         FINITE s /\ FINITE t ==> FINITE(s PCROSS t)}|,
      MESON_TAC(PairList [REWRITE_RULE(PairList [HAS_SIZE])(HAS_SIZE_PCROSS)])
    ]
  )

def FINITE_PCROSS_EQ:
  prove(
    [
      @hol|{!(s:A^M->bool) (t:A^N->bool).
         FINITE(s PCROSS t) <=> s = {} \/ t = {} \/ FINITE s /\ FINITE t}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(GEN_TAC) then_tac \
                          MAP_EVERY(ASM_CASES_TAC)(
                            PairList [
                              @hol|{s:A^M->bool = {}}|,
                              @hol|{t:A^N->bool = {}}|
                            ]
                          )
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [PCROSS_EMPTY, FINITE_EMPTY])
                      ) then_tac \
                      EQ_TAC
                    ) then_tac \
                    SIMP_TAC(PairList [FINITE_PCROSS])
                  ) then_tac \
                  REPEAT(STRIP_TAC)
                ) then_tac \
                MATCH_MP_TAC(FINITE_SUBSET)
              ) then_list \
              PairList [
                EXISTS_TAC(
                  @hol|{IMAGE fstcart ((s PCROSS t):A^(M,N)finite_sum->bool)}|
                ),
                EXISTS_TAC(
                  @hol|{IMAGE sndcart ((s PCROSS t):A^(M,N)finite_sum->bool)}|
                )
              ]
            ) then_tac \
            ASM_SIMP_TAC(PairList [FINITE_IMAGE, SUBSET, IN_IMAGE, EXISTS_PASTECART])
          ) then_tac \
          REWRITE_TAC(PairList [PASTECART_IN_PCROSS, FSTCART_PASTECART, SNDCART_PASTECART])
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

def IMAGE_FSTCART_PCROSS:
  prove(
    [
      @hol|{!s:real^M->bool t:real^N->bool.
         IMAGE fstcart (s PCROSS t) = if t = {} then {} else s}|,
      (
        (
          (
            (
              (
                (REPEAT(GEN_TAC) then_tac COND_CASES_TAC) then_tac \
                ASM_REWRITE_TAC(PairList [PCROSS_EMPTY, IMAGE_CLAUSES])
              ) then_tac \
              REWRITE_TAC(PairList [EXTENSION, IN_IMAGE])
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [CONJ_SYM])
          ) then_tac \
          REWRITE_TAC(PairList [EXISTS_IN_PCROSS, FSTCART_PASTECART])
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

def IMAGE_SNDCART_PCROSS:
  prove(
    [
      @hol|{!s:real^M->bool t:real^N->bool.
         IMAGE sndcart (s PCROSS t) = if s = {} then {} else t}|,
      (
        (
          (
            (
              (
                (REPEAT(GEN_TAC) then_tac COND_CASES_TAC) then_tac \
                ASM_REWRITE_TAC(PairList [PCROSS_EMPTY, IMAGE_CLAUSES])
              ) then_tac \
              REWRITE_TAC(PairList [EXTENSION, IN_IMAGE])
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [CONJ_SYM])
          ) then_tac \
          REWRITE_TAC(PairList [EXISTS_IN_PCROSS, SNDCART_PASTECART])
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

def PCROSS_INTER:
  prove(
    [
      @hol|{(!(s:A^M->bool) (t:A^N->bool) u.
              s PCROSS (t INTER u) = (s PCROSS t) INTER (s PCROSS u)) /\
         (!(s:A^M->bool) t (u:A^N->bool).
              (s INTER t) PCROSS u = (s PCROSS u) INTER (t PCROSS u))}|,
      (
        (
          REWRITE_TAC(PairList [EXTENSION, FORALL_PASTECART, IN_INTER, PASTECART_IN_PCROSS]) then_tac \
          REPEAT(STRIP_TAC)
        ) then_tac \
        CONV_TAC(TAUT)
      )
    ]
  )

def PCROSS_UNION:
  prove(
    [
      @hol|{(!(s:A^M->bool) (t:A^N->bool) u.
              s PCROSS (t UNION u) = (s PCROSS t) UNION (s PCROSS u)) /\
         (!(s:A^M->bool) t (u:A^N->bool).
              (s UNION t) PCROSS u = (s PCROSS u) UNION (t PCROSS u))}|,
      (
        (
          REWRITE_TAC(PairList [EXTENSION, FORALL_PASTECART, IN_UNION, PASTECART_IN_PCROSS]) then_tac \
          REPEAT(STRIP_TAC)
        ) then_tac \
        CONV_TAC(TAUT)
      )
    ]
  )

def PCROSS_DIFF:
  prove(
    [
      @hol|{(!(s:A^M->bool) (t:A^N->bool) u.
              s PCROSS (t DIFF u) = (s PCROSS t) DIFF (s PCROSS u)) /\
         (!(s:A^M->bool) t (u:A^N->bool).
              (s DIFF t) PCROSS u = (s PCROSS u) DIFF (t PCROSS u))}|,
      (
        (
          REWRITE_TAC(PairList [EXTENSION, FORALL_PASTECART, IN_DIFF, PASTECART_IN_PCROSS]) then_tac \
          REPEAT(STRIP_TAC)
        ) then_tac \
        CONV_TAC(TAUT)
      )
    ]
  )

def INTER_PCROSS:
  prove(
    [
      @hol|{!(s:A^M->bool) s' (t:A^N->bool) t'.
         (s PCROSS t) INTER (s' PCROSS t') = (s INTER s') PCROSS (t INTER t')}|,
      (
        REWRITE_TAC(PairList [EXTENSION, IN_INTER, FORALL_PASTECART, PASTECART_IN_PCROSS]) then_tac \
        CONV_TAC(TAUT)
      )
    ]
  )

def [cart_PCROSS_UNIONS_UNIONS_v2, PCROSS_UNIONS]:
  o(CONJ_PAIR)(prove)(
    [
      @hol|{(!f g. ((UNIONS f) PCROSS (UNIONS g)) :A^(M,N)finite_sum->bool =
                UNIONS {s PCROSS t | s IN f /\ t IN g}) /\
         (!s f. (s PCROSS (UNIONS f)) :A^(M,N)finite_sum->bool =
                UNIONS {s PCROSS t | t IN f}) /\
         (!f t. ((UNIONS f) PCROSS t) :A^(M,N)finite_sum->bool =
                UNIONS {s PCROSS t | s IN f})}|,
      (
        REWRITE_TAC(
          PairList [
            UNIONS_GSPEC,
            EXTENSION,
            FORALL_PASTECART,
            IN_ELIM_THM,
            PASTECART_IN_PCROSS
          ]
        ) then_tac \
        SET_TAC(PairList [])
      )
    ]
  )

def [cart_PCROSS_INTERS_INTERS_v2, PCROSS_INTERS]:
  o(CONJ_PAIR)(prove)(
    [
      @hol|{(!f g. ((INTERS f) PCROSS (INTERS g)) :A^(M,N)finite_sum->bool =
                if f = {} then INTERS {UNIV PCROSS t | t IN g}
                else if g = {} then INTERS {s PCROSS UNIV | s IN f}
                else INTERS {s PCROSS t | s IN f /\ t IN g}) /\
         (!s f. (s PCROSS (INTERS f)) :A^(M,N)finite_sum->bool =
                if f = {} then s PCROSS UNIV else INTERS {s PCROSS t | t IN f}) /\
         (!f t. ((INTERS f) PCROSS t) :A^(M,N)finite_sum->bool =
                if f = {} then UNIV PCROSS t else INTERS {s PCROSS t | s IN f})}|,
      (
        (
          (
            REPEAT(STRIP_TAC) then_tac \
            REPEAT((COND_CASES_TAC then_tac REWRITE_TAC(PairList [])))
          ) then_tac \
          ASM_REWRITE_TAC(
            PairList [
              INTERS_GSPEC,
              EXTENSION,
              FORALL_PASTECART,
              IN_ELIM_THM,
              PASTECART_IN_PCROSS,
              NOT_IN_EMPTY
            ]
          )
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

def DISJOINT_PCROSS:
  prove(
    [
      @hol|{!s:A^M->bool t:A^N->bool s' t'.
         DISJOINT (s PCROSS t) (s' PCROSS t') <=>
         DISJOINT s s' \/ DISJOINT t t'}|,
      REWRITE_TAC(PairList [DISJOINT, INTER_PCROSS, PCROSS_EQ_EMPTY])
    ]
  )

def tybit0_INDUCT = cart_tybit0_INDUCT_v2

def tybit1_INDUCT = cart_tybit1_INDUCT_v2

def PCROSS_UNIONS_UNIONS = cart_PCROSS_UNIONS_UNIONS_v2

def PCROSS_INTERS_INTERS = cart_PCROSS_INTERS_INTERS_v2
