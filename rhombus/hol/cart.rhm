def [cart_tybit0_INDUCT_v2, tybit0_RECURSION] = define_type("tybit0 = mktybit0((A,A)finite_sum)")

def [cart_tybit1_INDUCT_v2, tybit1_RECURSION] = define_type("tybit1 = mktybit1(((A,A)finite_sum,1)finite_sum)")

def HAS_SIZE_TYBIT0:
  prove(
    [
      hol_term(App(
        Const("HAS_SIZE", Fun(Fun(Tyapp("tybit0", [Tvar("A")]), Bool), Fun(Num, Bool))),
        [
          Const("UNIV", Fun(Tyapp("tybit0", [Tvar("A")]), Bool)),
          App(
            Const("*", Fun(Num, Fun(Num, Num))),
            [
              App(
                Const("NUMERAL", Fun(Num, Num)),
                [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
              ),
              App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Const("UNIV", Fun(Tvar("A"), Bool))])
            ]
          )
        ]
      )),
      (
        SUBGOAL_THEN(
          hol_term(Eq(
            Fun(Tyapp("tybit0", [Tvar("A")]), Bool),
            Const("UNIV", Fun(Tyapp("tybit0", [Tvar("A")]), Bool)),
            App(
              Const(
                "IMAGE",
                Fun(
                  Fun(Tyapp("finite_sum", [Tvar("A"), Tvar("A")]), Tyapp("tybit0", [Tvar("A")])),
                  Fun(
                    Fun(Tyapp("finite_sum", [Tvar("A"), Tvar("A")]), Bool),
                    Fun(Tyapp("tybit0", [Tvar("A")]), Bool)
                  )
                )
              ),
              [
                Const(
                  "mktybit0",
                  Fun(Tyapp("finite_sum", [Tvar("A"), Tvar("A")]), Tyapp("tybit0", [Tvar("A")]))
                ),
                Const("UNIV", Fun(Tyapp("finite_sum", [Tvar("A"), Tvar("A")]), Bool))
              ]
            )
          ))
        )(SUBST1_TAC) then_list \
        PairList [
          (
            (
              (CONV_TAC(SYM_CONV) then_tac MATCH_MP_TAC(SURJECTIVE_IMAGE_EQ)) then_tac \
              REWRITE_TAC(PairList [IN_UNIV])
            ) then_tac \
            MESON_TAC(PairList [cases("tybit0")])
          ),
          (
            (
              (
                MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ) then_tac \
                REWRITE_TAC(PairList [IN_UNIV, injectivity("tybit0")])
              ) then_tac \
              W(
                o(o(o(MP_TAC)(PART_MATCH(lhand)(DIMINDEX_HAS_SIZE_FINITE_SUM)))(lhand))(snd)
              )
            ) then_tac \
            REWRITE_TAC(PairList [DIMINDEX_FINITE_SUM, GSYM(MULT_2)])
          )
        ]
      )
    ]
  )

