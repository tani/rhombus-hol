         const UNIV :: finite_diff(M, N) -> bool
         const dimindex :: (N -> bool) -> num
         HAS_SIZE(
           UNIV,
           if dimindex((UNIV :: N -> bool)) < (dimindex :: (M -> bool) -> num)((UNIV :: M -> bool))
