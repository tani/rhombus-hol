  )

def UNIV_PCROSS_UNIV:
  prove(
    [
      (hol:
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const UNIV :: cart(A, M) -> bool
         const UNIV_2 as UNIV :: cart(A, N) -> bool
         const UNIV_3 as UNIV :: cart(A, finite_sum(M, N)) -> bool
         PCROSS(UNIV, UNIV_2) == UNIV_3),
      REWRITE_TAC(PairList [EXTENSION, FORALL_PASTECART, PASTECART_IN_PCROSS, IN_UNIV])
    ]
  )

def HAS_SIZE_PCROSS:
  prove(
    [
      (hol:
         const HAS_SIZE :: (cart(A, M) -> bool) -> num -> bool
         const HAS_SIZE_2 as HAS_SIZE :: (cart(A, N) -> bool) -> num -> bool
         const HAS_SIZE_3 as HAS_SIZE :: (cart(A, finite_sum(M, N)) -> bool) -> num -> bool
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         forall (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool, m :: num, n :: num):
           HAS_SIZE(s, m) && HAS_SIZE_2(t, n) ==> HAS_SIZE_3(PCROSS(s, t), m * n)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (REPEAT(GEN_TAC) then_tac DISCH_TAC) then_tac \
                        FIRST_ASSUM(o(MP_TAC)(MATCH_MP(HAS_SIZE_PRODUCT)))
                      ) then_tac \
                      MATCH_MP_TAC(EQ_IMP)
                    ) then_tac \
                    SPEC_TAC(
                      [
                        (hol:
                           var m :: num
                           var n :: num
                           m * n),
                        (hol: var k :: num; k)
                      ]
                    )
                  ) then_tac \
                  MATCH_MP_TAC(BIJECTIONS_HAS_SIZE_EQ)
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     const GABS :: ((pair(cart(A, M), cart(A, N)) -> cart(A, finite_sum(M, N))) -> bool) -> pair(cart(A, M), cart(A, N)) -> cart(A, finite_sum(M, N))
                     const GEQ :: cart(A, finite_sum(M, N)) -> cart(A, finite_sum(M, N)) -> bool
                     const comma as "," :: cart(A, M) -> cart(A, N) -> pair(cart(A, M), cart(A, N))
                     const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
                     GABS(
                       fun (f :: pair(cart(A, M), cart(A, N)) -> cart(A, finite_sum(M, N))):
                         forall (x :: cart(A, M), y :: cart(A, N)): GEQ(f(comma(x, y)), pastecart(x, y))
                     ))
                )
              ) then_tac \
              EXISTS_TAC(
                (hol:
                   const comma as "," :: cart(A, M) -> cart(A, N) -> pair(cart(A, M), cart(A, N))
                   const fstcart :: cart(A, finite_sum(M, N)) -> cart(A, M)
                   const sndcart :: cart(A, finite_sum(M, N)) -> cart(A, N)
                   fun (z :: cart(A, finite_sum(M, N))): comma(fstcart(z), sndcart(z)))
              )
            ) then_tac \
            REWRITE_TAC(PairList [FORALL_IN_GSPEC, PASTECART_IN_PCROSS])
          ) then_tac \
          REWRITE_TAC(PairList [IN_ELIM_PAIR_THM, PASTECART_FST_SND])
        ) then_tac \
        REWRITE_TAC(PairList [FORALL_IN_PCROSS, FSTCART_PASTECART, SNDCART_PASTECART])
      )
    ]
  )

def FINITE_PCROSS:
  prove(
    [
      (hol:
         const FINITE :: (cart(A, M) -> bool) -> bool
         const FINITE_2 as FINITE :: (cart(A, N) -> bool) -> bool
         const FINITE_3 as FINITE :: (cart(A, finite_sum(M, N)) -> bool) -> bool
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         forall (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool):
           FINITE(s) && FINITE_2(t) ==> FINITE_3(PCROSS(s, t))),
      MESON_TAC(PairList [REWRITE_RULE(PairList [HAS_SIZE])(HAS_SIZE_PCROSS)])
    ]
  )

def FINITE_PCROSS_EQ:
  prove(
    [
      (hol:
         const FINITE :: (cart(A, finite_sum(M, N)) -> bool) -> bool
         const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
         const EMPTY :: cart(A, M) -> bool
         const EMPTY_2 as EMPTY :: cart(A, N) -> bool
         const FINITE_2 as FINITE :: (cart(A, M) -> bool) -> bool
         const FINITE_3 as FINITE :: (cart(A, N) -> bool) -> bool
         forall (s :: cart(A, M) -> bool, t :: cart(A, N) -> bool):
           FINITE(PCROSS(s, t)) <=> s == EMPTY || (t == EMPTY_2 || FINITE_2(s) && FINITE_3(t))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(GEN_TAC) then_tac \
                          MAP_EVERY(ASM_CASES_TAC)(
                            PairList [
                              (hol:
                                 var s :: cart(A, M) -> bool
                                 const EMPTY :: cart(A, M) -> bool
                                 s == EMPTY),
                              (hol:
                                 var t :: cart(A, N) -> bool
                                 const EMPTY :: cart(A, N) -> bool
                                 t == EMPTY)
                            ]
                          )
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [PCROSS_EMPTY, FINITE_EMPTY])
                      ) then_tac \
                      EQ_TAC
                    ) then_tac \
                    SIMP_TAC(PairList [FINITE_PCROSS])
                  ) then_tac \
                  REPEAT(STRIP_TAC)
                ) then_tac \
                MATCH_MP_TAC(FINITE_SUBSET)
              ) then_list \
              PairList [
                EXISTS_TAC(
                  (hol:
                     var s :: cart(A, M) -> bool
                     var t :: cart(A, N) -> bool
                     const IMAGE :: (cart(A, finite_sum(M, N)) -> cart(A, M)) -> (cart(A, finite_sum(M, N)) -> bool) -> cart(A, M) -> bool
                     const fstcart :: cart(A, finite_sum(M, N)) -> cart(A, M)
                     const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
                     IMAGE(fstcart, PCROSS(s, t)))
                ),
                EXISTS_TAC(
                  (hol:
                     var s :: cart(A, M) -> bool
                     var t :: cart(A, N) -> bool
                     const IMAGE :: (cart(A, finite_sum(M, N)) -> cart(A, N)) -> (cart(A, finite_sum(M, N)) -> bool) -> cart(A, N) -> bool
                     const sndcart :: cart(A, finite_sum(M, N)) -> cart(A, N)
                     const PCROSS :: (cart(A, M) -> bool) -> (cart(A, N) -> bool) -> cart(A, finite_sum(M, N)) -> bool
                     IMAGE(sndcart, PCROSS(s, t)))
                )
              ]
            ) then_tac \
            ASM_SIMP_TAC(PairList [FINITE_IMAGE, SUBSET, IN_IMAGE, EXISTS_PASTECART])
          ) then_tac \
          REWRITE_TAC(PairList [PASTECART_IN_PCROSS, FSTCART_PASTECART, SNDCART_PASTECART])
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

def IMAGE_FSTCART_PCROSS:
  prove(
    [
      (hol:
         const IMAGE :: (cart(real, finite_sum(M, N)) -> cart(real, M)) -> (cart(real, finite_sum(M, N)) -> bool) -> cart(real, M) -> bool
         const fstcart :: cart(real, finite_sum(M, N)) -> cart(real, M)
         const PCROSS :: (cart(real, M) -> bool) -> (cart(real, N) -> bool) -> cart(real, finite_sum(M, N)) -> bool
         const EMPTY :: cart(real, N) -> bool
         const EMPTY_2 as EMPTY :: cart(real, M) -> bool
         forall (s :: cart(real, M) -> bool, t :: cart(real, N) -> bool):
           IMAGE(fstcart, PCROSS(s, t)) == (if t == EMPTY | EMPTY_2 | s)),
      (
        (
          (
            (
              (
                (REPEAT(GEN_TAC) then_tac COND_CASES_TAC) then_tac \
                ASM_REWRITE_TAC(PairList [PCROSS_EMPTY, IMAGE_CLAUSES])
              ) then_tac \
              REWRITE_TAC(PairList [EXTENSION, IN_IMAGE])
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [CONJ_SYM])
          ) then_tac \
          REWRITE_TAC(PairList [EXISTS_IN_PCROSS, FSTCART_PASTECART])
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

def IMAGE_SNDCART_PCROSS:
  prove(
    [
      (hol:
         const IMAGE :: (cart(real, finite_sum(M, N)) -> cart(real, N)) -> (cart(real, finite_sum(M, N)) -> bool) -> cart(real, N) -> bool
         const sndcart :: cart(real, finite_sum(M, N)) -> cart(real, N)
