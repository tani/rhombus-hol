    [
      (hol:
         const dimindex :: (finite_diff(M, N) -> bool) -> num
         const UNIV :: finite_diff(M, N) -> bool
         dimindex(UNIV)
           == (if (dimindex :: (N -> bool) -> num)((UNIV :: N -> bool)) < (dimindex :: (M -> bool) -> num)((UNIV :: M -> bool))
               | (dimindex :: (M -> bool) -> num)((UNIV :: M -> bool)) - (dimindex :: (N -> bool) -> num)((UNIV :: N -> bool))
               | (1 :: num))),
      (
        GEN_REWRITE_TAC(LAND_CONV)(PairList [dimindex]) then_tac \
        REWRITE_TAC(PairList [REWRITE_RULE(PairList [HAS_SIZE])(DIMINDEX_HAS_SIZE_FINITE_DIFF)])
      )
    ]
  )

