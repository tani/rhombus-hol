def CART_EQ:
  prove(
    [
      hol_term(Forall(
        "x",
        Tyapp("cart", [Tvar("A"), Tvar("B")]),
        Forall(
          "y",
          Tyapp("cart", [Tvar("A"), Tvar("B")]),
          Iff(
            Eq(Tyapp("cart", [Tvar("A"), Tvar("B")]), Ref("x"), Ref("y")),
            Forall(
              "i",
              Num,
              Implies(
                And(
                  App(
                    Const("<=", Fun(Num, Fun(Num, Bool))),
                    [
                      App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                      Ref("i")
                    ]
                  ),
                  App(
                    Const("<=", Fun(Num, Fun(Num, Bool))),
                    [
                      Ref("i"),
                      App(Const("dimindex", Fun(Fun(Tvar("B"), Bool), Num)), [Const("UNIV", Fun(Tvar("B"), Bool))])
                    ]
                  )
                ),
                Eq(
                  Tvar("A"),
                  App(
                    Const("$", Fun(Tyapp("cart", [Tvar("A"), Tvar("B")]), Fun(Num, Tvar("A")))),
                    [Ref("x"), Ref("i")]
                  ),
                  App(
                    Const("$", Fun(Tyapp("cart", [Tvar("A"), Tvar("B")]), Fun(Num, Tvar("A")))),
                    [Ref("y"), Ref("i")]
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            REPEAT(GEN_TAC) then_tac \
            REWRITE_TAC(PairList [finite_index, GSYM(FORALL_FINITE_INDEX)])
          ) then_tac \
          REWRITE_TAC(PairList [GSYM(FUN_EQ_THM), ETA_AX])
        ) then_tac \
        MESON_TAC(PairList [cart_tybij])
      )
    ]
  )

