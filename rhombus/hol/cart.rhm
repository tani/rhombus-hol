def HAS_SIZE_1:
  prove(
    [
      hol_term(App(
        Const("HAS_SIZE", Fun(Fun(Tyapp("1", []), Bool), Fun(Num, Bool))),
        [
          Const("UNIV", Fun(Tyapp("1", []), Bool)),
          App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
        ]
      )),
      (
        SUBGOAL_THEN(
          hol_term(Eq(
            Fun(Tyapp("1", []), Bool),
            Const("UNIV", Fun(Tyapp("1", []), Bool)),
            App(
              Const("INSERT", Fun(Tyapp("1", []), Fun(Fun(Tyapp("1", []), Bool), Fun(Tyapp("1", []), Bool)))),
              [Const("one", Tyapp("1", [])), Const("EMPTY", Fun(Tyapp("1", []), Bool))]
            )
          ))
        )(SUBST1_TAC) then_list \
        PairList [
          (
            REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_SING]) then_tac \
            MESON_TAC(PairList [one])
          ),
          SIMP_TAC(
            PairList [NOT_IN_EMPTY, HAS_SIZE, FINITE_RULES, CARD_CLAUSES, ARITH]
          )
        ]
      )
    ]
  )

def NUMSEG_LT_DIMINDEX:
  prove(
    [
      hol_term(Eq(
        Fun(Num, Bool),
        App(
          Const("GSPEC", Fun(Fun(Num, Bool), Fun(Num, Bool))),
          [
            Lambda(
              "GEN%PVAR%354",
              Num,
              Exists(
                "i",
                Num,
                App(
                  Const("SETSPEC", Fun(Num, Fun(Bool, Fun(Num, Bool)))),
                  [
                    Ref("GEN%PVAR%354"),
                    App(
                      Const("<", Fun(Num, Fun(Num, Bool))),
                      [
                        Ref("i"),
                        App(Const("dimindex", Fun(Fun(Tvar("N"), Bool), Num)), [Const("UNIV", Fun(Tvar("N"), Bool))])
                      ]
                    ),
                    Ref("i")
                  ]
                )
              )
            )
          ]
        ),
        App(
          Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
          [
            App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]),
            App(
              Const("-", Fun(Num, Fun(Num, Num))),
              [
                App(Const("dimindex", Fun(Fun(Tvar("N"), Bool), Num)), [Const("UNIV", Fun(Tvar("N"), Bool))]),
                App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
              ]
            )
          ]
        )
      )),
      REWRITE_TAC(PairList [NUMSEG_LT, DIMINDEX_NONZERO])
    ]
  )

