def DIMINDEX_UNIQUE:
  prove(
    [
      hol_term(Implies(
        App(
          Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
          [Const("UNIV", Fun(Tvar("A"), Bool)), Var("n", Num)]
