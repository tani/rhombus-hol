           && (forall (s :: cart(A, M) -> bool, t :: cart(A, M) -> bool, u :: cart(A, N) -> bool):
                 PCROSS(INTER_3(s, t), u) == INTER_2(PCROSS(s, u), PCROSS(t, u)))),
