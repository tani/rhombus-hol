  )

def FINITE_INDEX_INJ:
  prove(
    [
      hol_term(Forall(
        "i",
        Num,
        Forall(
          "j",
          Num,
          Implies(
            And(
              App(
                Const("<=", Fun(Num, Fun(Num, Bool))),
                [
                  App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                  Ref("i")
                ]
              ),
              And(
                App(
                  Const("<=", Fun(Num, Fun(Num, Bool))),
                  [
                    Ref("i"),
                    App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Const("UNIV", Fun(Tvar("A"), Bool))])
                  ]
                ),
                And(
                  App(
                    Const("<=", Fun(Num, Fun(Num, Bool))),
                    [
                      App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                      Ref("j")
                    ]
                  ),
                  App(
                    Const("<=", Fun(Num, Fun(Num, Bool))),
                    [
                      Ref("j"),
                      App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Const("UNIV", Fun(Tvar("A"), Bool))])
                    ]
                  )
                )
              )
            ),
            Iff(
              Eq(
                Tyapp("finite_image", [Tvar("A")]),
                App(Const("finite_index", Fun(Num, Tyapp("finite_image", [Tvar("A")]))), [Ref("i")]),
                App(Const("finite_index", Fun(Num, Tyapp("finite_image", [Tvar("A")]))), [Ref("j")])
              ),
              Eq(Num, Ref("i"), Ref("j"))
            )
          )
        )
      )),
      MESON_TAC(PairList [FINITE_INDEX_WORKS])
    ]
  )

def FORALL_FINITE_INDEX:
  prove(
    [
      hol_term(Iff(
        Forall(
          "k",
          Tyapp("finite_image", [Tvar("N")]),
          App(Var("P", Fun(Tyapp("finite_image", [Tvar("N")]), Bool)), [Ref("k")])
        ),
        Forall(
          "i",
          Num,
          Implies(
            And(
              App(
                Const("<=", Fun(Num, Fun(Num, Bool))),
                [
                  App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                  Ref("i")
                ]
              ),
              App(
                Const("<=", Fun(Num, Fun(Num, Bool))),
                [
                  Ref("i"),
                  App(Const("dimindex", Fun(Fun(Tvar("N"), Bool), Num)), [Const("UNIV", Fun(Tvar("N"), Bool))])
                ]
              )
            ),
            App(
              Var("P", Fun(Tyapp("finite_image", [Tvar("N")]), Bool)),
              [App(Const("finite_index", Fun(Num, Tyapp("finite_image", [Tvar("N")]))), [Ref("i")])]
            )
          )
        )
      )),
      MESON_TAC(PairList [FINITE_INDEX_WORKS])
    ]
  )

def cart_tybij:
  new_type_definition("cart")(["mk_cart", "dest_cart"])(
    prove(
      [
        hol_term(Exists("f", Fun(Tyapp("finite_image", [Tvar("B")]), Tvar("A")), True)),
        REWRITE_TAC(PairList [])
      ]
    )
  )

