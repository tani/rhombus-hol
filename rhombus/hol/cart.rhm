          "n",
          Num,
          And(
            App(
              Const("<=", Fun(Num, Fun(Num, Bool))),
              [
                App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                Ref("n")
