def DIMINDEX_CONV:
  let PairList [pth_num, & PairList [pth0, & PairList [pth1, & PairList [pth_one, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        hol_term(And(
          Iff(
            Eq(
              Num,
              App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Const("UNIV", Fun(Tvar("A"), Bool))]),
              Var("n", Num)
            ),
            Eq(
              Num,
              App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Var("s", Fun(Tvar("A"), Bool))]),
              App(Const("NUMERAL", Fun(Num, Num)), [Var("n", Num)])
            )
          ),
          And(
            Iff(
              Eq(
                Num,
                App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Const("UNIV", Fun(Tvar("A"), Bool))]),
                Var("n", Num)
              ),
              Eq(
                Num,
                App(
                  Const("dimindex", Fun(Fun(Tyapp("tybit0", [Tvar("A")]), Bool), Num)),
                  [Const("UNIV", Fun(Tyapp("tybit0", [Tvar("A")]), Bool))]
                ),
                App(Const("BIT0", Fun(Num, Num)), [Var("n", Num)])
              )
            ),
            And(
              Iff(
                Eq(
                  Num,
                  App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Const("UNIV", Fun(Tvar("A"), Bool))]),
                  Var("n", Num)
                ),
                Eq(
                  Num,
                  App(
                    Const("dimindex", Fun(Fun(Tyapp("tybit1", [Tvar("A")]), Bool), Num)),
                    [Const("UNIV", Fun(Tyapp("tybit1", [Tvar("A")]), Bool))]
                  ),
                  App(Const("BIT1", Fun(Num, Num)), [Var("n", Num)])
                )
              ),
              Eq(
                Num,
                App(
                  Const("dimindex", Fun(Fun(Tyapp("1", []), Bool), Num)),
                  [Const("UNIV", Fun(Tyapp("1", []), Bool))]
                ),
                App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])
              )
            )
          )
        )),
        (
          (
            (
              (
                CONJ_TAC then_list \
                PairList [REWRITE_TAC(PairList [NUMERAL, dimindex]), ALL_TAC]
              ) then_tac \
              REWRITE_TAC(PairList [DIMINDEX_CLAUSES])
            ) then_tac \
            CONV_TAC(BITS_ELIM_CONV)
          ) then_tac \
          ARITH_TAC
        )
      ]
    )
  let nvar = hol_term(Var("n", Num))
  fun calc_dimindex(ty):
    match ty
    | Tyapp("1",_): pth_one
    | Tyapp("tybit0",PairList [ty_prime, & _]):
        let th = calc_dimindex(ty_prime)
        let n = rand(concl(th))
        EQ_MP(INST(PairList [[n, nvar]])(INST_TYPE(PairList [[ty_prime, aty]])(pth0)))(th)
    | Tyapp("tybit1",PairList [ty_prime, & _]):
        let th = calc_dimindex(ty_prime)
        let n = rand(concl(th))
        EQ_MP(INST(PairList [[n, nvar]])(INST_TYPE(PairList [[ty_prime, aty]])(pth1)))(th)
    | _: fail()
  fun
  | (Comb(Const("dimindex",_),tm)):
      let uty = type_of(tm)
      let [_, PairList [sty, & _]] = dest_type(uty)
      let th = calc_dimindex(sty)
      let svar_2 = mk_var(["s", uty])
      let ntm_2 = rand(concl(th))
      let pth = INST(PairList [[tm, svar_2], [ntm_2, nvar]])(INST_TYPE(PairList [[sty, aty]])(pth_num))
      EQ_MP(pth)(th)
  | (_): failwith("DIMINDEX_CONV")

def HAS_SIZE_DIMINDEX_RULE:
  let pth:
    prove(
      [
        hol_term(Iff(
          App(
            Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
            [Const("UNIV", Fun(Tvar("A"), Bool)), Var("n", Num)]
          ),
          And(
            App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Const("UNIV", Fun(Tvar("A"), Bool))]),
            Eq(
              Num,
              App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Const("UNIV", Fun(Tvar("A"), Bool))]),
              Var("n", Num)
            )
          )
        )),
        MESON_TAC(PairList [UNIV_HAS_SIZE_DIMINDEX, HAS_SIZE])
      ]
    )
  let htm_2:
    hol_term(App(
      Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
      [Const("UNIV", Fun(Tvar("A"), Bool))]
    ))
  let conv_2 = GEN_REWRITE_CONV(I)(PairList [pth])
  let rule_2 = o(EQT_ELIM)(GEN_REWRITE_CONV(I)(PairList [FINITE_CLAUSES]))
  fun(nty):
    let tm = mk_comb([inst(PairList [[nty, aty]])(htm_2), mk_numeral(dest_finty(nty))])
    let th1 = conv_2(tm)
    EQ_MP(SYM(th1))(
      CONJ(rule_2(lhand(rand(concl(th1)))))(DIMINDEX_CONV(lhand(rand(rand(concl(th1))))))
    )

def DIMINDEX_TAC = CONV_TAC(ONCE_DEPTH_CONV(DIMINDEX_CONV))

