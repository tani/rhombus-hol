          let port_tmp_6 = Up_class.COND_CASES_TAC;
          let port_tmp_7 = (block:«
            let port_tmp_8 = Up_simp.REWRITE_TAC(PairList.cons(cart_dimindex,PairList []));
            let port_tmp_9 = Up_tactics.GEN_TAC;
            let port_tmp_10 = Up_tactics.THEN;
            port_tmp_10(port_tmp_9)(port_tmp_8)
          »);
          let port_tmp_11 = Up_tactics.THEN;
          port_tmp_11(port_tmp_7)(port_tmp_6)
        »);
        let port_tmp_12 = Up_tactics.THEN;
        port_tmp_12(port_tmp_5)(port_tmp_4)
      »);
      let port_tmp_13 = Up_tactics.THEN;
