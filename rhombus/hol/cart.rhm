  )

def FINITE_FINITE_IMAGE:
  prove(
    [
      (hol:
         const FINITE :: (finite_image(A) -> bool) -> bool
         const UNIV :: finite_image(A) -> bool
         FINITE(UNIV)),
      MESON_TAC(PairList [HAS_SIZE_FINITE_IMAGE, HAS_SIZE])
    ]
  )

def DIMINDEX_FINITE_IMAGE:
  prove(
    [
      (hol:
         const dimindex :: (finite_image(A) -> bool) -> num
         forall (s :: finite_image(A) -> bool, t :: A -> bool): dimindex(s) == (dimindex :: (A -> bool) -> num)(t)),
      (
        (
          (
            REPEAT(GEN_TAC) then_tac \
            GEN_REWRITE_TAC(LAND_CONV)(PairList [dimindex])
          ) then_tac \
          MP_TAC(ISPEC(hol: var t :: A -> bool; t)(HAS_SIZE_FINITE_IMAGE))
        ) then_tac \
        SIMP_TAC(PairList [FINITE_FINITE_IMAGE, HAS_SIZE])
      )
    ]
  )

def FINITE_INDEX_WORKS:
  prove(
    [
      (hol:
         const dimindex :: (A -> bool) -> num
         const UNIV :: A -> bool
         const finite_index :: num -> finite_image(A)
         forall i :: finite_image(A):
           exists1 n :: num: (1 :: num) <= n && (n <= dimindex(UNIV) && finite_index(n) == i)),
      (
        REWRITE_TAC(PairList [CONJ_ASSOC, GSYM(IN_NUMSEG)]) then_tac \
        MESON_TAC(PairList [finite_image_tybij])
      )
    ]
  )

def FINITE_INDEX_INJ:
  prove(
    [
      (hol:
         const dimindex :: (A -> bool) -> num
         const UNIV :: A -> bool
         const finite_index :: num -> finite_image(A)
         forall (i :: num, j :: num):
           (1 :: num) <= i && (i <= dimindex(UNIV) && ((1 :: num) <= j && j <= dimindex(UNIV)))
             ==> (finite_index(i) == finite_index(j) <=> i == j)),
      MESON_TAC(PairList [FINITE_INDEX_WORKS])
    ]
  )

def FORALL_FINITE_INDEX:
  prove(
    [
      (hol:
         var P :: finite_image(N) -> bool
         const dimindex :: (N -> bool) -> num
         const UNIV :: N -> bool
         const finite_index :: num -> finite_image(N)
         (forall k :: finite_image(N): P(k))
           <=> (forall i :: num: (1 :: num) <= i && i <= dimindex(UNIV) ==> P(finite_index(i)))),
      MESON_TAC(PairList [FINITE_INDEX_WORKS])
    ]
  )

def cart_tybij:
  new_type_definition("cart")(["mk_cart", "dest_cart"])(
    prove(
      [
        (hol:
           exists f :: finite_image(B) -> A: #true),
        REWRITE_TAC(PairList [])
      ]
    )
  )

Host.parse_as_infix(["$", [25, "left"]])

def finite_index:
  new_definition(
    (hol:
       var #{$} :: cart(A, N) -> num -> A
       var x :: cart(A, N)
       var i :: num
       const dest_cart :: cart(A, N) -> finite_image(N) -> A
       const finite_index :: num -> finite_image(N)
       #{$}(x, i) == dest_cart(x, finite_index(i)))
  )

def CART_EQ:
  prove(
    [
      (hol:
         const dimindex :: (B -> bool) -> num
         const UNIV :: B -> bool
         const #{$} :: cart(A, B) -> num -> A
         forall (x :: cart(A, B), y :: cart(A, B)):
           x == y
             <=> (forall i :: num:
                    (1 :: num) <= i && i <= dimindex(UNIV) ==> #{$}(x, i) == #{$}(y, i))),
      (
        (
          (
            REPEAT(GEN_TAC) then_tac \
            REWRITE_TAC(PairList [finite_index, GSYM(FORALL_FINITE_INDEX)])
          ) then_tac \
          REWRITE_TAC(PairList [GSYM(FUN_EQ_THM), ETA_AX])
        ) then_tac \
        MESON_TAC(PairList [cart_tybij])
      )
    ]
  )

Host.parse_as_binder("lambda")

def lambda:
  new_definition(
    (hol:
       var lambda :: (num -> A) -> cart(A, B)
       var g :: num -> A
       const #{@} :: (cart(A, B) -> bool) -> cart(A, B)
       const dimindex :: (B -> bool) -> num
       const UNIV :: B -> bool
       const #{$} :: cart(A, B) -> num -> A
       lambda(g)
         == #{@}(
              fun (f :: cart(A, B)):
                forall i :: num: (1 :: num) <= i && i <= dimindex(UNIV) ==> #{$}(f, i) == g(i)
            ))
  )

def LAMBDA_BETA:
  prove(
    [
      (hol:
         var g :: num -> A
         const dimindex :: (B -> bool) -> num
         const UNIV :: B -> bool
         const #{$} :: cart(A, B) -> num -> A
         const lambda :: (num -> A) -> cart(A, B)
         forall i :: num: (1 :: num) <= i && i <= dimindex(UNIV) ==> #{$}(lambda(g), i) == g(i)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (REWRITE_TAC(PairList [lambda]) then_tac CONV_TAC(SELECT_CONV)) then_tac \
                      EXISTS_TAC(
                        (hol:
                           var g :: num -> A
                           const mk_cart :: (finite_image(B) -> A) -> cart(A, B)
                           const #{@} :: (num -> bool) -> num
                           const dimindex :: (B -> bool) -> num
                           const UNIV :: B -> bool
                           const finite_index :: num -> finite_image(B)
                           mk_cart(
                             fun (k :: finite_image(B)):
                               g(
                                 #{@}(fun (i :: num): (1 :: num) <= i && (i <= dimindex(UNIV) && finite_index(i) == k))
                               )
                           ))
                      )
                    ) then_tac \
                    REWRITE_TAC(PairList [finite_index, REWRITE_RULE(PairList [])(cart_tybij)])
                  ) then_tac \
                  REPEAT(STRIP_TAC)
                ) then_tac \
                AP_TERM_TAC
              ) then_tac \
              MATCH_MP_TAC(SELECT_UNIQUE)
            ) then_tac \
            GEN_TAC
          ) then_tac \
          REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_MESON_TAC(PairList [FINITE_INDEX_INJ, DIMINDEX_FINITE_IMAGE])
      )
    ]
  )

def LAMBDA_UNIQUE:
  prove(
    [
      (hol:
         const dimindex :: (B -> bool) -> num
         const UNIV :: B -> bool
         const #{$} :: cart(A, B) -> num -> A
         const lambda :: (num -> A) -> cart(A, B)
         forall (f :: cart(A, B), g :: num -> A):
           (forall i :: num: (1 :: num) <= i && i <= dimindex(UNIV) ==> #{$}(f, i) == g(i))
             <=> lambda(g) == f),
      (SIMP_TAC(PairList [CART_EQ, LAMBDA_BETA]) then_tac MESON_TAC(PairList []))
    ]
  )

def LAMBDA_ETA:
  prove(
