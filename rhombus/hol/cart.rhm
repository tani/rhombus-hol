                    (
                      (REWRITE_TAC(PairList [lambda]) then_tac CONV_TAC(SELECT_CONV)) then_tac \
                      EXISTS_TAC(
                        (hol:
                           var g :: num -> A
                           const mk_cart :: (finite_image(B) -> A) -> cart(A, B)
                           const select as "@" :: (num -> bool) -> num
                           const dimindex :: (B -> bool) -> num
                           const UNIV :: B -> bool
                           const finite_index :: num -> finite_image(B)
                           mk_cart(
                             fun (k :: finite_image(B)):
