def HAS_SIZE_DIMINDEX_RULE:
  let pth = Tactics.prove([Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("HAS_SIZE", Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Const("UNIV", Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]))), Var("n", Tyapp("num", [])))), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("FINITE", Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]), Tyapp("bool", [])])), Const("UNIV", Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])])))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Comb(Const("dimindex", Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]), Tyapp("num", [])])), Const("UNIV", Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])])))), Var("n", Tyapp("num", [])))))), Meson.MESON_TAC(PairList.cons(UNIV_HAS_SIZE_DIMINDEX, PairList.cons(Sets.HAS_SIZE, PairList [])))])
  let htm_2 = Host.hol_term(Comb(Const("HAS_SIZE", Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Const("UNIV", Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]))))
  let conv_2 = Simp.GEN_REWRITE_CONV(I)(PairList.cons(pth, PairList []))
  let rule_2 = o(Bool.EQT_ELIM)(Simp.GEN_REWRITE_CONV(I)(PairList.cons(FINITE_CLAUSES, PairList [])))
  fun(nty):
    let tm = Fusion.mk_comb([Fusion.inst(PairList.cons([nty, Fusion.aty], PairList []))(htm_2), Nums.mk_numeral(Basics.dest_finty(nty))])
    let th1 = conv_2(tm)
