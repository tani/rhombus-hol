def dimindex:
  new_definition(
    hol_term(Eq(
      Num,
      App(Var("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Var("s", Fun(Tvar("A"), Bool))]),
      App(
        Const("COND", Fun(Bool, Fun(Num, Fun(Num, Num)))),
        [
          App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Const("UNIV", Fun(Tvar("A"), Bool))]),
          App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Const("UNIV", Fun(Tvar("A"), Bool))]),
          App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
        ]
      )
    ))
  )

def DIMINDEX_NONZERO:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Not(
          Eq(
            Num,
            App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")]),
            App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])
          )
        )
      )),
      (
        (
          ((GEN_TAC then_tac REWRITE_TAC(PairList [dimindex])) then_tac COND_CASES_TAC) then_tac \
          ASM_SIMP_TAC(PairList [CARD_EQ_0, ARITH])
        ) then_tac \
        SET_TAC(PairList [])
      )
    ]
  )

def DIMINDEX_GE_1:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        App(
          Const("<=", Fun(Num, Fun(Num, Bool))),
          [
            App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
            App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")])
          ]
        )
      )),
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            hol_term(Iff(
              App(
                Const("<=", Fun(Num, Fun(Num, Bool))),
                [
                  App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                  Var("x", Num)
                ]
              ),
              Not(Eq(Num, Var("x", Num), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])))
            ))
          ),
          DIMINDEX_NONZERO
        ]
      )
    ]
  )

