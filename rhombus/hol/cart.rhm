              ]
            )
          )
        ]
      )
    ))
  )

def IN_ELIM_PASTECART_THM:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Tyapp("cart", [Tvar("A"), Tvar("M")]), Fun(Tyapp("cart", [Tvar("A"), Tvar("N")]), Bool)),
        Forall(
          "a",
          Tyapp("cart", [Tvar("A"), Tvar("M")]),
          Forall(
            "b",
            Tyapp("cart", [Tvar("A"), Tvar("N")]),
            Iff(
              App(
                Const(
                  "IN",
                  Fun(
                    Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]),
                    Fun(Fun(Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]), Bool), Bool)
                  )
                ),
                [
                  App(
                    Const(
                      "pastecart",
                      Fun(
                        Tyapp("cart", [Tvar("A"), Tvar("M")]),
                        Fun(
                          Tyapp("cart", [Tvar("A"), Tvar("N")]),
                          Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])])
                        )
                      )
                    ),
                    [Ref("a"), Ref("b")]
                  ),
                  App(
                    Const(
                      "GSPEC",
                      Fun(
                        Fun(Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]), Bool),
                        Fun(Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]), Bool)
                      )
                    ),
                    [
                      Lambda(
                        "GEN%PVAR%362",
                        Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]),
                        Exists(
                          "x",
                          Tyapp("cart", [Tvar("A"), Tvar("M")]),
                          Exists(
                            "y",
                            Tyapp("cart", [Tvar("A"), Tvar("N")]),
                            App(
                              Const(
                                "SETSPEC",
                                Fun(
                                  Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]),
                                  Fun(Bool, Fun(Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])]), Bool))
                                )
                              ),
                              [
                                Ref("GEN%PVAR%362"),
                                App(Ref("P"), [Ref("x"), Ref("y")]),
                                App(
                                  Const(
                                    "pastecart",
                                    Fun(
                                      Tyapp("cart", [Tvar("A"), Tvar("M")]),
                                      Fun(
                                        Tyapp("cart", [Tvar("A"), Tvar("N")]),
                                        Tyapp("cart", [Tvar("A"), Tyapp("finite_sum", [Tvar("M"), Tvar("N")])])
                                      )
                                    )
                                  ),
                                  [Ref("x"), Ref("y")]
                                )
                              ]
                            )
                          )
                        )
                      )
                    ]
                  )
                ]
              ),
              App(Ref("P"), [Ref("a"), Ref("b")])
            )
          )
        )
      )),
      (
        REWRITE_TAC(PairList [IN_ELIM_THM, PASTECART_EQ, FSTCART_PASTECART, SNDCART_PASTECART]) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

