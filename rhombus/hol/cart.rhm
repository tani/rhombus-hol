                  (hol:
                     var s :: cart(A, M) -> bool
                     var t :: cart(A, N) -> bool
                     const IMAGE :: (cart(A, finite_sum(M, N)) -> cart(A, N)) -> (cart(A, finite_sum(M, N)) -> bool) -> cart(A, N) -> bool
                     const sndcart :: cart(A, finite_sum(M, N)) -> cart(A, N)
