def NUMSEG_LT_DIMINDEX:
  prove(
    [
      (hol:
         const GSPEC :: (num -> bool) -> num -> bool
         const SETSPEC :: num -> bool -> num -> bool
         const dimindex :: (N -> bool) -> num
         const UNIV :: N -> bool
         const dotdot as ".." :: num -> num -> num -> bool
         GSPEC(
           fun (gen_pvar_354 as "GEN%PVAR%354" :: num):
             exists i :: num: SETSPEC(gen_pvar_354, i < dimindex(UNIV), i)
         )
           == dotdot((0 :: num), dimindex(UNIV) - (1 :: num))),
      REWRITE_TAC(PairList [NUMSEG_LT, DIMINDEX_NONZERO])
    ]
  )

