            ),
            And(
              App(
                Const("<=", Fun(Num, Fun(Num, Bool))),
                [
                  Ref("n"),
                  App(Const("dimindex", Fun(Fun(Tvar("A"), Bool), Num)), [Const("UNIV", Fun(Tvar("A"), Bool))])
                ]
              ),
              Eq(
                Tyapp("finite_image", [Tvar("A")]),
                App(Const("finite_index", Fun(Num, Tyapp("finite_image", [Tvar("A")]))), [Ref("n")]),
                Ref("i")
              )
            )
          )
        )
      )),
      (
        REWRITE_TAC(PairList [CONJ_ASSOC, GSYM(IN_NUMSEG)]) then_tac \
        MESON_TAC(PairList [finite_image_tybij])
      )
