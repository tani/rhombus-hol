                        FIRST_ASSUM(o(MP_TAC)(MATCH_MP(HAS_SIZE_PRODUCT)))
                      ) then_tac \
                      MATCH_MP_TAC(EQ_IMP)
                    ) then_tac \
                    SPEC_TAC(
                      [
                        (hol:
                           var m :: num
                           var n :: num
                           m * n),
                        (hol: var k :: num; k)
                      ]
                    )
                  ) then_tac \
                  MATCH_MP_TAC(BIJECTIONS_HAS_SIZE_EQ)
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     const GABS :: ((pair(cart(A, M), cart(A, N)) -> cart(A, finite_sum(M, N))) -> bool) -> pair(cart(A, M), cart(A, N)) -> cart(A, finite_sum(M, N))
                     const GEQ :: cart(A, finite_sum(M, N)) -> cart(A, finite_sum(M, N)) -> bool
                     const #{|,|} :: cart(A, M) -> cart(A, N) -> pair(cart(A, M), cart(A, N))
                     const pastecart :: cart(A, M) -> cart(A, N) -> cart(A, finite_sum(M, N))
                     GABS(
                       fun (f :: pair(cart(A, M), cart(A, N)) -> cart(A, finite_sum(M, N))):
                         forall (x :: cart(A, M), y :: cart(A, N)): GEQ(f(#{|,|}(x, y)), pastecart(x, y))
                     ))
                )
              ) then_tac \
              EXISTS_TAC(
                (hol:
                   const #{|,|} :: cart(A, M) -> cart(A, N) -> pair(cart(A, M), cart(A, N))
                   const fstcart :: cart(A, finite_sum(M, N)) -> cart(A, M)
                   const sndcart :: cart(A, finite_sum(M, N)) -> cart(A, N)
                   fun (z :: cart(A, finite_sum(M, N))): #{|,|}(fstcart(z), sndcart(z)))
              )
