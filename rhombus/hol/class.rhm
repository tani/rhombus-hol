              Tvar("A"),
              App(
                Const("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))))),
                [True, Ref("t1"), Ref("t2")]
              ),
              Ref("t1")
            ),
            Eq(
              Tvar("A"),
              App(
                Const("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))))),
                [False, Ref("t1"), Ref("t2")]
              ),
              Ref("t2")
            )
          )
        )
      )),
      REWRITE_TAC(PairList [COND_DEF])
    ]
  )

fun is_cond(tm):
  try:
    (fst(dest_const(rator(rator(rator(tm))))) == "COND")
    ~catch exn:
      match exn
      | Failure(_): #false
      | exn: (throw exn)

fun mk_cond([b, x, y]):
  try:
    let c = mk_const(["COND", PairList [[type_of(x), aty]]])
    mk_comb([mk_comb([mk_comb([c, b]), x]), y])
    ~catch exn:
      match exn
      | Failure(_): failwith("mk_cond")
      | exn: (throw exn)

fun dest_cond(tm):
  try:
    let [tm1, y] = dest_comb(tm)
    let [tm2, x] = dest_comb(tm1)
    let [c, b] = dest_comb(tm2)
    (if (fst(dest_const(c)) == "COND") | [b, [x, y]] | fail())
    ~catch exn:
      match exn
      | Failure(_): failwith("dest_cond")
      | exn: (throw exn)

