fun is_cond(tm):
  try:
    Host.hol_equal(fst(Fusion.dest_const(Fusion.rator(Fusion.rator(Fusion.rator(tm))))))("COND")
    ~catch exn:
      match exn
      | Failure(_): #false
      | exn: Host.hol_raise(exn)

fun mk_cond([b, x, y]):
  try:
    let c = Fusion.mk_const(["COND", PairList.cons([Fusion.type_of(x), Fusion.aty], PairList [])])
    Fusion.mk_comb([Fusion.mk_comb([Fusion.mk_comb([c, b]), x]), y])
    ~catch exn:
      match exn
      | Failure(_): failwith("mk_cond")
      | exn: Host.hol_raise(exn)

fun dest_cond(tm):
  try:
    let [tm1, y] = Fusion.dest_comb(tm)
    let [tm2, x] = Fusion.dest_comb(tm1)
    let [c, b] = Fusion.dest_comb(tm2)
    (if Host.hol_equal(fst(Fusion.dest_const(c)))("COND") | [b, [x, y]] | Host.hol_apply_unit(fail))
    ~catch exn:
      match exn
      | Failure(_): failwith("dest_cond")
      | exn: Host.hol_raise(exn)

Simp.extend_basic_rewrites(PairList.cons(COND_CLAUSES, PairList []))

