def UNIQUE_SKOLEM_THM:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
        Iff(
          Forall("x", Tvar("A"), ExistsUnique("y", Tvar("B"), App(Ref("P"), [Ref("x"), Ref("y")]))),
          ExistsUnique(
            "f",
            Fun(Tvar("A"), Tvar("B")),
            Forall("x", Tvar("A"), App(Ref("P"), [Ref("x"), App(Ref("f"), [Ref("x")])]))
          )
        )
      )),
      (
        (
          (
            (
              (
                GEN_TAC then_tac \
                REWRITE_TAC(PairList [EXISTS_UNIQUE_THM, SKOLEM_THM, FORALL_AND_THM])
              ) then_tac \
              EQ_TAC
            ) then_tac \
            DISCH_THEN(CONJUNCTS_THEN(ASSUME_TAC))
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (REPEAT(STRIP_TAC) then_tac ONCE_REWRITE_TAC(PairList [FUN_EQ_THM])) then_tac \
                  X_GEN_TAC(hol_term(Var("x", Tvar("A"))))
                ) then_tac \
                FIRST_ASSUM(MATCH_MP_TAC)
              ) then_tac \
              EXISTS_TAC(hol_term(Var("x", Tvar("A"))))
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ),
          (
            (
              (
                (
                  MAP_EVERY(X_GEN_TAC)(
                    PairList [
                      hol_term(Var("x", Tvar("A"))),
                      hol_term(Var("y1", Tvar("B"))),
                      hol_term(Var("y2", Tvar("B")))
                    ]
                  ) then_tac \
                  STRIP_TAC
                ) then_tac \
                FIRST_ASSUM(X_CHOOSE_TAC(hol_term(Var("f", Fun(Tvar("A"), Tvar("B"))))))
              ) then_tac \
              SUBGOAL_THEN(
                hol_term(Eq(
                  Fun(Tvar("A"), Tvar("B")),
                  Lambda(
                    "z",
                    Tvar("A"),
                    App(
                      Const("COND", Fun(Bool, Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))))),
                      [
                        Eq(Tvar("A"), Ref("z"), Var("x", Tvar("A"))),
                        Var("y1", Tvar("B")),
                        App(Var("f", Fun(Tvar("A"), Tvar("B"))), [Ref("z")])
                      ]
                    )
                  ),
                  Lambda(
                    "z",
                    Tvar("A"),
                    App(
                      Const("COND", Fun(Bool, Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))))),
                      [
                        Eq(Tvar("A"), Ref("z"), Var("x", Tvar("A"))),
                        Var("y2", Tvar("B")),
                        App(Var("f", Fun(Tvar("A"), Tvar("B"))), [Ref("z")])
                      ]
                    )
                  )
                ))
              )(MP_TAC)
            ) then_list \
            PairList [
              (
                (
                  (
                    (FIRST_ASSUM(MATCH_MP_TAC) then_tac REPEAT(STRIP_TAC)) then_tac \
                    BETA_TAC
                  ) then_tac \
                  COND_CASES_TAC
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ),
              (
                DISCH_THEN(o(MP_TAC)(C(AP_THM)(hol_term(Var("x", Tvar("A")))))) then_tac \
                REWRITE_TAC(PairList [])
              )
            ]
          )
        ]
      )
    ]
  )

def COND_CONG:
  class_TAUT_v2(
    hol_term(Implies(
      Iff(Var("g", Bool), Var("g'", Bool)),
      Implies(
        Implies(Var("g'", Bool), Eq(Tvar("?3075"), Var("t", Tvar("?3075")), Var("t'", Tvar("?3075")))),
        Implies(
          Implies(
            Not(Var("g'", Bool)),
            Eq(Tvar("?3075"), Var("e", Tvar("?3075")), Var("e'", Tvar("?3075")))
          ),
          Eq(
            Tvar("?3075"),
            App(
              Const("COND", Fun(Bool, Fun(Tvar("?3075"), Fun(Tvar("?3075"), Tvar("?3075"))))),
              [Var("g", Bool), Var("t", Tvar("?3075")), Var("e", Tvar("?3075"))]
            ),
            App(
              Const("COND", Fun(Bool, Fun(Tvar("?3075"), Fun(Tvar("?3075"), Tvar("?3075"))))),
              [Var("g'", Bool), Var("t'", Tvar("?3075")), Var("e'", Tvar("?3075"))]
            )
          )
        )
      )
    ))
  )

def initialization_1:
  extend_basic_congs(PairList [COND_CONG])

def COND_EQ_CLAUSE:
  prove(
    [
      hol_term(Eq(
        Tvar("?3087"),
        App(
          Const("COND", Fun(Bool, Fun(Tvar("?3087"), Fun(Tvar("?3087"), Tvar("?3087"))))),
          [
            Eq(Tvar("?3094"), Var("x", Tvar("?3094")), Var("x", Tvar("?3094"))),
            Var("y", Tvar("?3087")),
            Var("z", Tvar("?3087"))
          ]
        ),
        Var("y", Tvar("?3087"))
      )),
      REWRITE_TAC(PairList [])
    ]
  )

def initialization_2:
  extend_basic_rewrites(PairList [COND_EQ_CLAUSE])

def bool_INDUCT:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Bool, Bool),
        Implies(
          And(App(Ref("P"), [False]), App(Ref("P"), [True])),
          Forall("x", Bool, App(Ref("P"), [Ref("x")]))
        )
      )),
      (
        (
          REPEAT(STRIP_TAC) then_tac \
          DISJ_CASES_TAC(SPEC(hol_term(Var("x", Bool)))(BOOL_CASES_AX))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def bool_RECURSION:
  prove(
    [
      hol_term(Forall(
        "a",
        Tvar("A"),
        Forall(
          "b",
          Tvar("A"),
          Exists(
            "f",
            Fun(Bool, Tvar("A")),
            And(
              Eq(Tvar("A"), App(Ref("f"), [False]), Ref("a")),
              Eq(Tvar("A"), App(Ref("f"), [True]), Ref("b"))
            )
          )
        )
      )),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          EXISTS_TAC(
            hol_term(Lambda(
              "x",
              Bool,
              App(
                Const("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))))),
                [Ref("x"), Var("b", Tvar("A")), Var("a", Tvar("A"))]
              )
            ))
          )
        ) then_tac \
        REWRITE_TAC(PairList [])
      )
    ]
  )

def inductive_type_store = Box(PairList [["bool", [2, bool_INDUCT, bool_RECURSION]]])

def TAUT = class_TAUT_v2
