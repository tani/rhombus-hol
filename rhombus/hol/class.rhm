def class_TAUT_v2:
  let PROP_REWRITE_TAC = Simp.REWRITE_TAC(PairList [])
  let RTAUT_TAC:
    fun([asl, w]):
      let ok = (fun(t): (Host.hol_equal(Fusion.type_of(t))(Fusion.bool_ty) && (can(Basics.find_term(Fusion.is_var))(t) && Basics.free_in(t)(w))))
      Tactics.THEN(PROP_REWRITE_TAC)(W(o(o(o(o(o(((fun(t1): (fun(t2): Tactics.THEN(t1)(t2))))(Simp.REWRITE_TAC(PairList [])))(BOOL_CASES_TAC))(hd))(sort(Basics.free_in)))(Basics.find_terms(ok)))(snd)))([asl, w])
  let TAUT_TAC = Tactics.THEN(Tactics.REPEAT(Tactics.ORELSE(Tactics.GEN_TAC)(Tactics.CONJ_TAC)))(Tactics.REPEAT(RTAUT_TAC))
  fun(tm):
    try:
      Tactics.prove([tm, TAUT_TAC])
      ~catch exn:
        match exn
        | Failure(_): failwith(Host.hol_concat("TAUT `")(Host.hol_concat(Host.string_of_term(tm))("`: cannot solve")))
        | exn: Host.hol_raise(exn)

