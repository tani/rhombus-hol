def the_type_definitions = Box(PairList [])

fun new_type_definition(tyname):
  fun([absname, repname]):
    fun(th):
      try:
        let [th_prime, tth_prime] = assoc([tyname, absname, repname])(Host.ref_get(the_type_definitions))
        if Host.hol_unequal(Fusion.concl(th_prime))(Fusion.concl(th))
        | failwith("")
        | Host.warn(#true)("Benign redefinition of type")
          tth_prime
        ~catch exn:
          match exn
          | Failure(_):
              let th0 = Equal.CONV_RULE(Equal.THENC(Equal.RATOR_CONV(Simp.REWR_CONV(EXISTS_THM)))(Equal.BETA_CONV))(th)
              let [th1, th2] = Fusion.new_basic_type_definition(tyname)([absname, repname])(th0)
              let tth = Bool.CONJ(Bool.GEN_ALL(th1))(Bool.GEN_ALL(Equal.CONV_RULE(Equal.LAND_CONV(Equal.TRY_CONV(Equal.BETA_CONV)))(th2)))
              Host.ref_set(the_type_definitions)(PairList.cons([[tyname, absname, repname], [th, tth]], Host.ref_get(the_type_definitions)))
              tth
          | exn: Host.hol_raise(exn)

