def COND_DEF:
  new_definition(
    hol_term(Eq(
      Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))),
      Var("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))))),
      Lambda(
        "t",
        Bool,
        Lambda(
          "t1",
          Tvar("A"),
          Lambda(
            "t2",
            Tvar("A"),
            App(
              Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))),
              [
                Lambda(
                  "x",
                  Tvar("A"),
                  And(
                    Implies(Iff(Ref("t"), True), Eq(Tvar("A"), Ref("x"), Ref("t1"))),
                    Implies(Iff(Ref("t"), False), Eq(Tvar("A"), Ref("x"), Ref("t2")))
                  )
                )
              ]
            )
          )
        )
      )
    ))
  )

