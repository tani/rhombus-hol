def COND_ELIM_CONV = HIGHER_REWRITE_CONV(PairList [COND_ELIM_THM])(#true)

def COND_CASES_TAC:
  let DENEG_RULE = GEN_REWRITE_RULE(I)(PairList [class_TAUT_v2(hol_term(Iff(Not(Not(Var("p", Bool))), Var("p", Bool))))])
  (
    (CONV_TAC(COND_ELIM_CONV) then_tac CONJ_TAC) then_list \
    PairList [
      DISCH_THEN((fun(th): (ASSUME_TAC(th) then_tac SUBST1_TAC(EQT_INTRO(th))))),
      DISCH_THEN(
        fun(th):
          try:
            let th_prime = DENEG_RULE(th)
            (ASSUME_TAC(th_prime) then_tac SUBST1_TAC(EQT_INTRO(th_prime)))
            ~catch exn:
              match exn
              | Failure(_): (ASSUME_TAC(th) then_tac SUBST1_TAC(EQF_INTRO(th)))
              | exn: (throw exn)
      )
    ]
  )

def SKOLEM_THM:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
        Iff(
          Forall("x", Tvar("A"), Exists("y", Tvar("B"), App(Ref("P"), [Ref("x"), Ref("y")]))),
          Exists(
            "y",
            Fun(Tvar("A"), Tvar("B")),
            Forall("x", Tvar("A"), App(Ref("P"), [Ref("x"), App(Ref("y"), [Ref("x")])]))
          )
        )
      )),
      (
        (
          REPEAT((STRIP_TAC or_tac EQ_TAC)) then_list \
          PairList [
            (
              (
                (
                  EXISTS_TAC(
                    hol_term(Lambda(
                      "x",
                      Tvar("A"),
                      App(
                        Const("@", Fun(Fun(Tvar("B"), Bool), Tvar("B"))),
                        [
                          Lambda(
                            "y",
                            Tvar("B"),
                            App(Var("P", Fun(Tvar("A"), Fun(Tvar("B"), Bool))), [Ref("x"), Ref("y")])
                          )
                        ]
                      )
                    ))
                  ) then_tac \
                  GEN_TAC
                ) then_tac \
                BETA_TAC
              ) then_tac \
              CONV_TAC(SELECT_CONV)
            ),
            EXISTS_TAC(hol_term(App(Var("y", Fun(Tvar("A"), Tvar("B"))), [Var("x", Tvar("A"))])))
          ]
        ) then_tac \
        POP_ASSUM(MATCH_ACCEPT_TAC)
      )
    ]
  )

