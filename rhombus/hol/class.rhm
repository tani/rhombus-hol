            )
          ]
        ),
        And(
          Implies(Var("c", Bool), App(Var("P", Fun(Tvar("A"), Bool)), [Var("x", Tvar("A"))])),
          Implies(Not(Var("c", Bool)), App(Var("P", Fun(Tvar("A"), Bool)), [Var("y", Tvar("A"))]))
        )
