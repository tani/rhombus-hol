def class_TAUT_v2:
  let PROP_REWRITE_TAC = REWRITE_TAC(PairList [])
  let RTAUT_TAC:
    fun([asl, w]):
      let ok = (fun(t): ((type_of(t) == bool_ty) && (can(find_term(is_var))(t) && free_in(t)(w))))
      (
        PROP_REWRITE_TAC then_tac \
        W(
          o(
            o(
              o(
                o(o((fun(t1): fun(t2): (t1 then_tac t2))(REWRITE_TAC(PairList [])))(BOOL_CASES_TAC))(hd)
              )(sort(free_in))
            )(find_terms(ok))
          )(snd)
        )
      )([asl, w])
  let TAUT_TAC = (REPEAT((GEN_TAC or_tac CONJ_TAC)) then_tac REPEAT(RTAUT_TAC))
  fun(tm):
    try:
      prove([tm, TAUT_TAC])
      ~catch exn:
        match exn
        | Failure(_): failwith(("TAUT `" +& (Host.string_of_term(tm) +& "`: cannot solve")))
        | exn: (throw exn)

