def CCONTR:
  let P = Host.hol_term(Var("P", Tyapp("bool", [])))
  let pth = class_TAUT(Host.hol_term(Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("~", Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])), Var("P", Tyapp("bool", [])))), Const("F", Tyapp("bool", [])))), Var("P", Tyapp("bool", [])))))
  fun(tm):
    fun(th):
      try:
        let tm_prime = Bool.mk_neg(tm)
        Bool.MP(Fusion.INST(PairList.cons([tm, P], PairList []))(pth))(Bool.DISCH(tm_prime)(th))
        ~catch exn:
          match exn
          | Failure(_): failwith("CCONTR")
          | exn: Host.hol_raise(exn)

def CONTRAPOS_CONV:
  let a_2 = Host.hol_term(Var("a", Tyapp("bool", [])))
  let b_2 = Host.hol_term(Var("b", Tyapp("bool", [])))
  let pth = class_TAUT(Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("a", Tyapp("bool", []))), Var("b", Tyapp("bool", [])))), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("~", Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])), Var("b", Tyapp("bool", [])))), Comb(Const("~", Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])), Var("a", Tyapp("bool", [])))))))
  fun(tm):
    try:
      let [P, Q] = Basics.dest_imp(tm)
      Fusion.INST(PairList.cons([P, a_2], PairList.cons([Q, b_2], PairList [])))(pth)
      ~catch exn:
        match exn
        | Failure(_): failwith("CONTRAPOS_CONV")
        | exn: Host.hol_raise(exn)

def REFUTE_THEN:
  let f_tm_2 = Host.hol_term(Const("F", Tyapp("bool", [])))
  let conv_2 = Simp.REWR_CONV(class_TAUT(Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("p", Tyapp("bool", []))), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("~", Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])), Var("p", Tyapp("bool", [])))), Const("F", Tyapp("bool", [])))))))
  fun(ttac):
