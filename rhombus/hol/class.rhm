            [Var("b", Bool), Var("A", Bool), Var("C", Bool)]
          ),
          App(
            Const("COND", Fun(Bool, Fun(Bool, Fun(Bool, Bool)))),
            [Var("b", Bool), Var("B", Bool), Var("D", Bool)]
          )
        )
      )),
      (
        (STRIP_TAC then_tac BOOL_CASES_TAC(hol_term(Var("b", Bool)))) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

