      if Host.hol_equal(w)(f_tm_2)
      | Tactics.ALL_TAC(gl)
      | (if Basics.is_neg(w) | Tactics.DISCH_THEN(ttac)(gl) | Tactics.THEN(Tactics.CONV_TAC(conv_2))(Tactics.DISCH_THEN(ttac))(gl))

