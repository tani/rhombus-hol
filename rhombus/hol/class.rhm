def ETA_AX:
  new_axiom(
    hol_term(Forall(
      "t",
      Fun(Tvar("A"), Tvar("B")),
      Eq(Fun(Tvar("A"), Tvar("B")), Lambda("x", Tvar("A"), App(Ref("t"), [Ref("x")])), Ref("t"))
    ))
  )

def ETA_CONV:
  let t = hol_term(Var("t", Fun(Tvar("A"), Tvar("B"))))
  let pth:
    prove(
      [
        hol_term(Eq(
          Fun(Tvar("A"), Tvar("B")),
          Lambda("x", Tvar("A"), App(Var("t", Fun(Tvar("A"), Tvar("B"))), [Ref("x")])),
          Var("t", Fun(Tvar("A"), Tvar("B")))
        )),
        MATCH_ACCEPT_TAC(ETA_AX)
      ]
    )
  fun(tm):
    try:
      let [bv, bod] = dest_abs(tm)
      let [l, r] = dest_comb(bod)
      if ((r == bv) && !vfree_in(bv)(l))
      | TRANS(REFL(tm))(
          PINST(
            PairList [[type_of(bv), aty], [type_of(bod), bty]])(
            PairList [[l, t]]
          )(pth)
        )
      | fail()
      ~catch exn:
        match exn
        | Failure(_): failwith("ETA_CONV")
        | exn: (throw exn)

def EQ_EXT:
  prove(
    [
      hol_term(Forall(
        "f",
        Fun(Tvar("A"), Tvar("B")),
        Forall(
          "g",
          Fun(Tvar("A"), Tvar("B")),
          Implies(
            Forall("x", Tvar("A"), Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("g"), [Ref("x")]))),
            Eq(Fun(Tvar("A"), Tvar("B")), Ref("f"), Ref("g"))
          )
        )
      )),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          DISCH_THEN(
            o(o(MP_TAC)(ABS(hol_term(Var("x", Tvar("A"))))))(SPEC(hol_term(Var("x", Tvar("A")))))
          )
        ) then_tac \
        REWRITE_TAC(PairList [ETA_AX])
      )
    ]
  )

def FUN_EQ_THM:
  prove(
    [
      hol_term(Forall(
        "f",
        Fun(Tvar("A"), Tvar("B")),
        Forall(
          "g",
          Fun(Tvar("A"), Tvar("B")),
          Iff(
            Eq(Fun(Tvar("A"), Tvar("B")), Ref("f"), Ref("g")),
            Forall("x", Tvar("A"), Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("g"), [Ref("x")])))
          )
        )
      )),
      (
        (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
        PairList [
          ((DISCH_THEN(SUBST1_TAC) then_tac GEN_TAC) then_tac REFL_TAC),
          MATCH_ACCEPT_TAC(EQ_EXT)
        ]
      )
    ]
  )

new_constant(["@", hol_term(Fun(Fun(Tvar("A"), Bool), Tvar("A")))])

Host.parse_as_binder("@")

def is_select = is_binder("@")

def dest_select = dest_binder("@")

def mk_select = mk_binder("@")

def SELECT_AX:
  new_axiom(
    hol_term(Forall(
      "P",
      Fun(Tvar("A"), Bool),
      Forall(
        "x",
        Tvar("A"),
        Implies(
          App(Ref("P"), [Ref("x")]),
          App(Ref("P"), [App(Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))), [Ref("P")])])
        )
      )
    ))
  )

def EXISTS_THM:
  prove(
    [
      hol_term(Eq(
        Fun(Fun(Tvar("A"), Bool), Bool),
        Const("?", Fun(Fun(Tvar("A"), Bool), Bool)),
        Lambda(
          "P",
          Fun(Tvar("A"), Bool),
          App(Ref("P"), [App(Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))), [Ref("P")])])
        )
      )),
      (
        (
          (
            (
              (MATCH_MP_TAC(EQ_EXT) then_tac BETA_TAC) then_tac \
              X_GEN_TAC(hol_term(Var("P", Fun(Tvar("A"), Bool))))
            ) then_tac \
            GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [GSYM(ETA_AX)])
          ) then_tac \
          EQ_TAC
        ) then_list \
        PairList [
          (
            DISCH_THEN(CHOOSE_THEN(MP_TAC)) then_tac \
            MATCH_ACCEPT_TAC(SELECT_AX)
          ),
          (
            (
              DISCH_TAC then_tac \
              EXISTS_TAC(
                hol_term(App(Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))), [Var("P", Fun(Tvar("A"), Bool))]))
              )
            ) then_tac \
            POP_ASSUM(ACCEPT_TAC)
          )
        ]
      )
    ]
  )

def SELECT_RULE:
  let P = hol_term(Var("P", Fun(Tvar("A"), Bool)))
  let pth:
    prove(
      [
        hol_term(Implies(
          App(Const("?", Fun(Fun(Tvar("A"), Bool), Bool)), [Var("P", Fun(Tvar("A"), Bool))]),
          App(
            Var("P", Fun(Tvar("A"), Bool)),
            [App(Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))), [Var("P", Fun(Tvar("A"), Bool))])]
          )
        )),
        SIMP_TAC(PairList [SELECT_AX, ETA_AX])
      ]
    )
  fun(th):
    try:
      let abs_2 = rand(concl(th))
      let ty = type_of(bndvar(abs_2))
      CONV_RULE(BETA_CONV)(MP(PINST(PairList [[ty, aty]])(PairList [[abs_2, P]])(pth))(th))
      ~catch exn:
        match exn
        | Failure(_): failwith("SELECT_RULE")
        | exn: (throw exn)

def SELECT_CONV:
  let P = hol_term(Var("P", Fun(Tvar("A"), Bool)))
  let pth:
    prove(
      [
        hol_term(Iff(
          App(
            Var("P", Fun(Tvar("A"), Bool)),
            [App(Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))), [Var("P", Fun(Tvar("A"), Bool))])]
          ),
          App(Const("?", Fun(Fun(Tvar("A"), Bool), Bool)), [Var("P", Fun(Tvar("A"), Bool))])
        )),
        ((REWRITE_TAC(PairList [EXISTS_THM]) then_tac BETA_TAC) then_tac REFL_TAC)
      ]
    )
  fun(tm):
    try:
      let is_epsok:
        fun(t):
          if is_select(t)
          | let [bv, bod] = dest_select(t)
            aconv(tm)(vsubst(PairList [[t, bv]])(bod))
          | #false
      let pickeps = find_term(is_epsok)(tm)
      let abs_3 = rand(pickeps)
      let ty = type_of(bndvar(abs_3))
      CONV_RULE(LAND_CONV(BETA_CONV))(PINST(PairList [[ty, aty]])(PairList [[abs_3, P]])(pth))
      ~catch exn:
        match exn
        | Failure(_): failwith("SELECT_CONV")
        | exn: (throw exn)

def SELECT_REFL:
  prove(
    [
      hol_term(Forall(
        "x",
        Tvar("A"),
        Eq(
          Tvar("A"),
          App(
            Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))),
            [Lambda("y", Tvar("A"), Eq(Tvar("A"), Ref("y"), Ref("x")))]
          ),
          Ref("x")
        )
      )),
      (
        (
          (GEN_TAC then_tac CONV_TAC(SELECT_CONV)) then_tac \
          EXISTS_TAC(hol_term(Var("x", Tvar("A"))))
        ) then_tac \
        REFL_TAC
      )
    ]
  )

def SELECT_UNIQUE:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Forall(
          "x",
          Tvar("A"),
          Implies(
            Forall("y", Tvar("A"), Iff(App(Ref("P"), [Ref("y")]), Eq(Tvar("A"), Ref("y"), Ref("x")))),
            Eq(Tvar("A"), App(Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))), [Ref("P")]), Ref("x"))
          )
        )
      )),
      (
        (
          REPEAT(STRIP_TAC) then_tac \
          GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [GSYM(ETA_AX)])
        ) then_tac \
        ASM_REWRITE_TAC(PairList [SELECT_REFL])
      )
    ]
  )

extend_basic_rewrites(PairList [SELECT_REFL])

def the_type_definitions = Box(PairList [])

fun new_type_definition(tyname):
  fun([absname, repname]):
    fun(th):
      try:
        let [th_prime, tth_prime] = assoc([tyname, absname, repname])(the_type_definitions.value)
        if (concl(th_prime) != concl(th))
        | failwith("")
        | warn(#true)("Benign redefinition of type")
          tth_prime
        ~catch exn:
          match exn
          | Failure(_):
              let th0 = CONV_RULE((RATOR_CONV(REWR_CONV(EXISTS_THM)) then_conv BETA_CONV))(th)
              let [th1, th2] = new_basic_type_definition(tyname)([absname, repname])(th0)
              let tth = CONJ(GEN_ALL(th1))(GEN_ALL(CONV_RULE(LAND_CONV(TRY_CONV(BETA_CONV)))(th2)))
              the_type_definitions.value := PairList [[[tyname, absname, repname], [th, tth]], & the_type_definitions.value]
              tth
          | exn: (throw exn)

def EXCLUDED_MIDDLE:
  prove(
    [
      hol_term(Forall("t", Bool, Or(Ref("t"), Not(Ref("t"))))),
      (
        (
          GEN_TAC then_tac \
          SUBGOAL_THEN(
            hol_term(And(
              Or(
                Iff(
                  App(
                    Const("@", Fun(Fun(Bool, Bool), Bool)),
                    [Lambda("x", Bool, Or(Iff(Ref("x"), False), Var("t", Bool)))]
                  ),
                  False
                ),
                Var("t", Bool)
              ),
              Or(
                Iff(
                  App(
                    Const("@", Fun(Fun(Bool, Bool), Bool)),
                    [Lambda("x", Bool, Or(Iff(Ref("x"), True), Var("t", Bool)))]
                  ),
                  True
                ),
                Var("t", Bool)
              )
            ))
          )(MP_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                (CONJ_TAC then_tac CONV_TAC(SELECT_CONV)) then_list \
                PairList [EXISTS_TAC(hol_term(False)), EXISTS_TAC(hol_term(True))]
              ) then_tac \
              DISJ1_TAC
            ) then_tac \
            REFL_TAC
          ),
          (
            (
              (
                (
                  (
                    (
                      DISCH_THEN(o(STRIP_ASSUME_TAC)(GSYM)) then_tac \
                      TRY((DISJ1_TAC then_tac FIRST_ASSUM(ACCEPT_TAC)))
                    ) then_tac \
                    DISJ2_TAC
                  ) then_tac \
                  DISCH_TAC
                ) then_tac \
                MP_TAC(ITAUT(hol_term(Not(Iff(True, False)))))
              ) then_tac \
              PURE_ONCE_ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            ASM_REWRITE_TAC(PairList [ITAUT(hol_term(Iff(Or(Var("p", Bool), True), True)))])
          )
        ]
      )
    ]
  )

def BOOL_CASES_AX:
  prove(
    [
      hol_term(Forall("t", Bool, Or(Iff(Ref("t"), True), Iff(Ref("t"), False)))),
      (
        (
          GEN_TAC then_tac \
          DISJ_CASES_TAC(SPEC(hol_term(Var("t", Bool)))(EXCLUDED_MIDDLE))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

fun BOOL_CASES_TAC(p): fun(gl): STRUCT_CASES_TAC(SPEC(p)(BOOL_CASES_AX))(gl)

fun ASM_CASES_TAC(t): fun(gl): DISJ_CASES_TAC(SPEC(t)(EXCLUDED_MIDDLE))(gl)

def class_TAUT:
  let PROP_REWRITE_TAC = REWRITE_TAC(PairList [])
  let RTAUT_TAC:
    fun([asl, w]):
      let ok = (fun(t): ((type_of(t) == bool_ty) && (can(find_term(is_var))(t) && free_in(t)(w))))
      (
        PROP_REWRITE_TAC then_tac \
        W(
          o(
            o(
              o(
                o(o((fun(t1): fun(t2): (t1 then_tac t2))(REWRITE_TAC(PairList [])))(BOOL_CASES_TAC))(hd)
              )(sort(free_in))
            )(find_terms(ok))
          )(snd)
        )
      )([asl, w])
  let TAUT_TAC = (REPEAT((GEN_TAC or_tac CONJ_TAC)) then_tac REPEAT(RTAUT_TAC))
  (fun(tm): prove([tm, TAUT_TAC]))

def DE_MORGAN_THM:
  class_TAUT(
    hol_term(Forall(
      "t1",
      Bool,
      Forall(
        "t2",
        Bool,
        And(
          Iff(Not(And(Ref("t1"), Ref("t2"))), Or(Not(Ref("t1")), Not(Ref("t2")))),
          Iff(Not(Or(Ref("t1"), Ref("t2"))), And(Not(Ref("t1")), Not(Ref("t2"))))
        )
      )
    ))
  )

def NOT_CLAUSES:
  class_TAUT(
    hol_term(And(
      Forall("t", Bool, Iff(Not(Not(Ref("t"))), Ref("t"))),
      And(Iff(Not(True), False), Iff(Not(False), True))
    ))
  )

def NOT_IMP:
  class_TAUT(
    hol_term(Forall(
      "t1",
      Bool,
      Forall("t2", Bool, Iff(Not(Implies(Ref("t1"), Ref("t2"))), And(Ref("t1"), Not(Ref("t2")))))
    ))
  )

def CONTRAPOS_THM:
  class_TAUT(
    hol_term(Forall(
      "t1",
      Bool,
      Forall("t2", Bool, Iff(Implies(Not(Ref("t1")), Not(Ref("t2"))), Implies(Ref("t2"), Ref("t1"))))
    ))
  )

extend_basic_rewrites(PairList [CONJUNCT1(NOT_CLAUSES)])

def CCONTR:
  let P = hol_term(Var("P", Bool))
  let pth = class_TAUT(hol_term(Implies(Implies(Not(Var("P", Bool)), False), Var("P", Bool))))
  fun(tm):
    fun(th):
      try:
        let tm_prime = mk_neg(tm)
        MP(INST(PairList [[tm, P]])(pth))(DISCH(tm_prime)(th))
        ~catch exn:
          match exn
          | Failure(_): failwith("CCONTR")
          | exn: (throw exn)

def CONTRAPOS_CONV:
  let a_2 = hol_term(Var("a", Bool))
  let b_2 = hol_term(Var("b", Bool))
  let pth:
    class_TAUT(
      hol_term(Iff(Implies(Var("a", Bool), Var("b", Bool)), Implies(Not(Var("b", Bool)), Not(Var("a", Bool)))))
    )
  fun(tm):
    try:
      let [P, Q] = dest_imp(tm)
      INST(PairList [[P, a_2], [Q, b_2]])(pth)
      ~catch exn:
        match exn
        | Failure(_): failwith("CONTRAPOS_CONV")
        | exn: (throw exn)

def REFUTE_THEN:
  let f_tm_2 = hol_term(False)
  let conv_2 = REWR_CONV(class_TAUT(hol_term(Iff(Var("p", Bool), Implies(Not(Var("p", Bool)), False)))))
  fun(ttac):
    fun([asl, w] as gl):
      if (w == f_tm_2)
      | ALL_TAC(gl)
      | (if is_neg(w) | DISCH_THEN(ttac)(gl) | (CONV_TAC(conv_2) then_tac DISCH_THEN(ttac))(gl))

def NOT_EXISTS_THM:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Iff(
          Not(Exists("x", Tvar("A"), App(Ref("P"), [Ref("x")]))),
          Forall("x", Tvar("A"), Not(App(Ref("P"), [Ref("x")])))
        )
      )),
      (
        ((GEN_TAC then_tac EQ_TAC) then_tac DISCH_TAC) then_list \
        PairList [
          (
            (
              (
                (
                  (GEN_TAC then_tac DISCH_TAC) then_tac \
                  UNDISCH_TAC(hol_term(Not(Exists("x", Tvar("A"), App(Var("P", Fun(Tvar("A"), Bool)), [Ref("x")])))))
                ) then_tac \
                REWRITE_TAC(PairList [])
              ) then_tac \
              EXISTS_TAC(hol_term(Var("x", Tvar("A"))))
            ) then_tac \
            POP_ASSUM(ACCEPT_TAC)
          ),
          (
            DISCH_THEN(CHOOSE_THEN(MP_TAC)) then_tac \
            ASM_REWRITE_TAC(PairList [])
          )
        ]
      )
    ]
  )

def EXISTS_NOT_THM:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Iff(
          Exists("x", Tvar("A"), Not(App(Ref("P"), [Ref("x")]))),
          Not(Forall("x", Tvar("A"), App(Ref("P"), [Ref("x")])))
        )
      )),
      (
        ONCE_REWRITE_TAC(
          PairList [
            class_TAUT(
              hol_term(Iff(Iff(Var("a", Bool), Not(Var("b", Bool))), Iff(Not(Var("a", Bool)), Var("b", Bool))))
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [NOT_EXISTS_THM])
      )
    ]
  )

def NOT_FORALL_THM:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Iff(
          Not(Forall("x", Tvar("A"), App(Ref("P"), [Ref("x")]))),
          Exists("x", Tvar("A"), Not(App(Ref("P"), [Ref("x")])))
        )
      )),
      MATCH_ACCEPT_TAC(GSYM(EXISTS_NOT_THM))
    ]
  )

def FORALL_NOT_THM:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Iff(
          Forall("x", Tvar("A"), Not(App(Ref("P"), [Ref("x")]))),
          Not(Exists("x", Tvar("A"), App(Ref("P"), [Ref("x")])))
        )
      )),
      MATCH_ACCEPT_TAC(GSYM(NOT_EXISTS_THM))
    ]
  )

