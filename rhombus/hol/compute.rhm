                  [free, compute_Compute_ctor_Pvar(Host.hol_sub(Host.hol_sub(newi)(Host.index(t)(free)))(1))]
                  ~catch exn:
                    match exn
                    | _: [PairList.cons(t, free), compute_Compute_ctor_Pvar(newi)]
                    | exn: Host.hol_raise(exn)
              | failwith(Host.hol_concat("check_arg_form: ")(Host.hol_concat(fst(Fusion.dest_var(t)))(" occurs as a variable on lhs")))
            | (if Fusion.is_const(t) | [free, compute_Compute_ctor_Papp(t, Host.OCamlList.rev(stk))] | failwith(Host.hol_concat("check_arg_form: lambda abstraction not allowed on lhs: `")(Host.hol_concat(Host.string_of_term(trm))("`"))))
    match chk(trm)(PairList [])(PairList [])
    | [fv, compute_Compute_ctor_Papp(head,args)]: [Host.OCamlList.rev(fv), head, args]
    | _: failwith("check_arg_form: ill-formed lhs")

