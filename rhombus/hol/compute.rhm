  fun compute_Compute_UNFUNIFY(thm):
    try:
      let [lhs, rhs] = Fusion.dest_eq(Fusion.concl(thm))
      let x = Fusion.variant(Fusion.frees(lhs))(fst(Fusion.dest_abs(rhs)))
      Equal.CONV_RULE(Equal.RAND_CONV(Equal.BETA_CONV))(Equal.AP_THM(thm)(x))
      ~catch exn:
        match exn
        | _: failwith("UNFUNIFY")
        | exn: Host.hol_raise(exn)

