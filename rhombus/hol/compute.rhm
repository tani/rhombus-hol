  fun compute_Compute_check_arg_form(trm):
    fun chk(t):
      fun(stk):
        fun(free):
          if Fusion.is_comb(t)
          | let [rator, rand] = Fusion.dest_comb(t)
            let [free_prime, pat1] = chk(rand)(PairList [])(free)
            chk(rator)(PairList.cons(pat1, stk))(free_prime)
          | if Fusion.is_var(t)
            | if Host.hol_equal(stk)(PairList [])
              | let newi = Host.OCamlList.length(free)
