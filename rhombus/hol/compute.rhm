  fun compute_Compute_check_arg_form(trm):«
    (block:«
      fun chk(t):«
        (fun(stk):«
          (fun(free):«
            (block:«
              if Up_fusion.is_comb(t)
              | (block:«
                let Pair(rator,rand):«
                  Up_fusion.dest_comb(t)
                »;
                (block:«
                  let Pair(free_prime,pat1):«
                    chk(rand)(PairList [])(free)
                  »;
                  chk(rator)(PairList.cons(pat1,stk))(free_prime)
                »)
              »)
              | (block:«
                if Up_fusion.is_var(t)
                | (block:«
                  if Host.hol_equal(stk)(PairList [])
                  | (block:«
                    let newi:«
                      Host.OCamlList.length(free)
                    »;
                    (block:«
                      try:«
                        Pair(free,compute_Compute_ctor_Pvar(Host.hol_sub(Host.hol_sub(newi)(Host.index(t)(free)))(1)));
                        ~catch port_tmp_27:«
                          let port_tmp_28 = port_tmp_27;
                          match port_tmp_28
                          | _:«
                              Pair(PairList.cons(t,free),compute_Compute_ctor_Pvar(newi))
                          »
                          | port_tmp_27:«
                              Host.hol_raise(port_tmp_27)
                          »
                        »
                      »
                    »)
                  »)
                  | failwith(Host.hol_concat("check_arg_form: ")(Host.hol_concat(fst(Up_fusion.dest_var(t)))(" occurs as a variable on lhs")))
                »)
                | (block:«
                  if Up_fusion.is_const(t)
                  | Pair(free,compute_Compute_ctor_Papp(t,Host.OCamlList.rev(stk)))
                  | failwith(Host.hol_concat("check_arg_form: lambda abstraction not allowed on lhs: `")(Host.hol_concat(Host.string_of_term(trm))("`")))
                »)
              »)
            »)
          »)
        »)
      »;
      (block:«
        let port_tmp_29 = chk(trm)(PairList [])(PairList []);
        match port_tmp_29
        | Pair(fv,compute_Compute_ctor_Papp(head,args)):«
            Interop.triple3(Host.OCamlList.rev(fv),head,args)
        »
        | _:«
            failwith("check_arg_form: ill-formed lhs")
        »
      »)
    »)
  »;
