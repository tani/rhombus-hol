    RESTR_EVAL_RULE

  fun with_flag([flag, b]):
    fun(f):
      fun(x):
        let fval = flag.value
        let #void = (flag.value := b)
        let res:
          try:
            f(x)
            ~catch exn:
              match exn
              | e:
                  flag.value := fval
                  (throw e)
              | exn: (throw exn)
        flag.value := fval
        res

  fun RIGHT_BETA(th):
    try:
      TRANS(th)(BETA_CONV(Equal.rhs(concl(th))))
      ~catch exn:
        match exn
        | _: failwith("RIGHT_BETA")
        | exn: (throw exn)

  fun RIGHT_ETA(thm):
    try:
      TRANS(thm)(ETA_CONV(Equal.rhs(concl(thm))))
      ~catch exn:
        match exn
        | _: failwith("RIGHT_ETA")
        | exn: (throw exn)

  fun MK_comb(th):
    let [rator, rand] = dest_comb(Equal.rhs(concl(th)))
    let mka = fun(th1): fun(th2): TRANS(th)(MK_COMB([th1, th2]))
    [REFL(rator), REFL(rand), mka]

  fun MK_abs(th):
    let [bvar, body] = dest_abs(Equal.rhs(concl(th)))
    [bvar, REFL(body), (fun(th1): TRANS(th)(ABS(bvar)(th1)))]

  fun BODY_CONJUNCTS(th):
    if is_forall(concl(th))
    | BODY_CONJUNCTS(SPEC_ALL(th))
    | (if is_conj(concl(th)) | append(BODY_CONJUNCTS(CONJUNCT1(th)))(BODY_CONJUNCTS(CONJUNCT2(th))) | PairList [th])

  variant stack:
    Ztop()
    Zrator(operand, stack)
    Zrand(operator, stack)
    Zabs(variable, stack)

  class Dead_code(message)

  def rhs_concl = o(Fusion.rand)(concl)

  def refl_thm = REFL

  def trans_thm = TRANS

  def beta_thm = RIGHT_BETA

  fun evaluate(th): th

  fun try_eta(thm):
    try:
      RIGHT_ETA(thm)
      ~catch exn:
        match exn
        | _: thm
        | exn: (throw exn)

  fun push_in_stk(f):
    fun(arg):
      fun([th, stk]):
        let [tha, thb, mka] = MK_comb(th)
        [tha, Zrator([mka, [thb, f(arg)]], stk)]

  fun push_skip_stk(f):
    fun(arg):
      fun([th, stk]):
        let [tha, thb, mka] = MK_comb(th)
        [tha, Zrand([C(mka), #true, [thb, f(arg)]], stk)]

  fun push_lam_in_stk([th, stk]):
    let [_, thb, mkl] = MK_abs(th)
    [thb, Zabs(o(try_eta)(mkl), stk)]

  fun FUNIFY(thm):
    try:
      let x = Fusion.rand(Equal.lhs(concl(thm)))
      CONV_RULE(
        RATOR_CONV(RAND_CONV(CHANGED_CONV(PURE_REWRITE_CONV(PairList [ETA_AX]))))
      )(ABS(x)(thm))
      ~catch exn:
        match exn
        | _: failwith("FUNIFY")
        | exn: (throw exn)

  fun UNFUNIFY(thm):
    try:
      let [lhs, rhs] = dest_eq(concl(thm))
      let x = variant(frees(lhs))(fst(dest_abs(rhs)))
      CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(thm)(x))
      ~catch exn:
        match exn
        | _: failwith("UNFUNIFY")
        | exn: (throw exn)

  fun repeat_on_conj(f):
    fun(thm):
      fun iter(th):
        try:
          iter(f(th))
          ~catch exn:
            match exn
            | _: th
            | exn: (throw exn)
      end_itlist(CONJ)(Host.OCamlList.map(iter)(BODY_CONJUNCTS(thm)))

  def lazyfy_thm = repeat_on_conj(FUNIFY)

  def strictify_thm = repeat_on_conj(UNFUNIFY)

  fun eq_intro(thm):
    if is_eq(concl(thm))
    | thm
    | (if is_neg(concl(thm)) | EQF_INTRO(thm) | EQT_INTRO(thm))

  variant pattern:
    Pvar(index)
    Papp(head, arguments)

  fun check_arg_form(trm):
    // Recursive argument checking needs the local definition before its first use.
    fun chk(t):
      fun(stk):
        fun(free):
          if is_comb(t)
          | let [rator, rand] = dest_comb(t)
            let [free_prime, pat1] = chk(rand)(PairList [])(free)
            chk(rator)(PairList [pat1, & stk])(free_prime)
          | if is_var(t)
            | if (stk == (PairList []))
              | let newi = Host.OCamlList.length(free)
                try:
                  [free, Pvar(((newi - index(t)(free)) - 1))]
                  ~catch exn:
                    match exn
                    | _: [PairList [t, & free], Pvar(newi)]
                    | exn: (throw exn)
              | failwith(
                  ("check_arg_form: " +& (fst(dest_var(t)) +& " occurs as a variable on lhs"))
                )
            | if is_const(t)
              | [free, Papp(t, Host.OCamlList.rev(stk))]
              | failwith(
                  ("check_arg_form: lambda abstraction not allowed on lhs: `" +& (Host.string_of_term(trm) +& "`"))
                )
    match chk(trm)(PairList [])(PairList [])
    | [fv, Papp(head,args)]: [Host.OCamlList.rev(fv), head, args]
    | _: failwith("check_arg_form: ill-formed lhs")

  record CstRec(head, args, rws, skip)

  record ClosRec(env, term)

  variant fterm:
    Const(constant)
    Neutr()
    Clos(closure)

  variant dterm:
    Bv(index)
    Fv()
    Cst(constant, rewrites)
    App(operator, arguments)
    Abs(body)

  fun appl
  | appl([App(a,l1), arg]): App(a, PairList [arg, & l1])
  | appl([t, arg]): App(t, PairList [arg])

  fun inst_type_dterm
  | inst_type_dterm([PairList [], v]): v
  | inst_type_dterm([tysub, v]):
      fun tyi_dt
      | tyi_dt(Cst(c,dbsk)): Cst(inst(tysub)(c), dbsk)
      | tyi_dt(App(h,l)): App(tyi_dt(h), map(tyi_dt)(l))
      | tyi_dt(Abs(v)): Abs(tyi_dt(v))
      | tyi_dt(v): v
      tyi_dt(v)

  variant action:
    Rewrite(rules)
    Conv(conversion)

  record TryRec(hcst, rws, tail)

  variant db:
    End_db()
    Try(entry)
    Need_arg(database)

  record RewriteRec(cst, lhs, npv, rhs, thm)

  variant rewrite:
    Rw(rule)

  fun add_in_db
  | add_in_db([n, cst, act, End_db()]): funpow(n)((fun(a): Need_arg(a)))(Try(TryRec(cst, act, End_db())))
  | add_in_db([0, cst, Rewrite(nrws) as act, Try(TryRec(hcst,Rewrite(rws) as rw,tail))]): (if (cst == hcst) | Try(TryRec(hcst, Rewrite(append(nrws)(rws)), tail)) | Try(TryRec(hcst, rw, add_in_db([0, cst, act, tail]))))
  | add_in_db([n, cst, act, Try(TryRec(hcst,rws,tail))]): Try(TryRec(hcst, rws, add_in_db([n, cst, act, tail])))
  | add_in_db([0, cst, act, db]): Try(TryRec(cst, act, db))
  | add_in_db([n, cst, act, Need_arg(tail)]): Need_arg(add_in_db([(n - 1), cst, act, tail]))

  fun key_of(Rw(RewriteRec(cst,lhs,_,_,_))):
    let [name, _] = dest_const(cst)
    [name, length(lhs), cst]

  fun is_skip
  | is_skip([_, Const(CstRec(_,args,_,Host.Some(n)))]): (n <= Host.OCamlList.length(args))
  | is_skip(_): #false

  fun partition_skip(skip):
    fun(args):
      match skip
      | Host.Some(n):
          let len = Host.OCamlList.length(args)
          (if (n <= len) | chop_list((len - n))(args) | [PairList [], args])
      | Host.None(): [PairList [], args]

  variant compset:
    Rws(database)

  fun empty_rws(_): Rws(Host.Hashtbl.create(100))

  fun assoc_clause(Rws(rws)):
    fun(cst):
      try:
        Host.Hashtbl.find(rws)(cst)
        ~catch exn:
          match exn
          | Not_found():
              let mt = Box([End_db(), Host.None()])
              Host.Hashtbl.add(rws)(cst)(mt)
              mt
          | exn: (throw exn)

  fun add_in_db_upd(rws):
    fun([name, arity, hcst]):
      fun(act):
        let Box([db, sk]) as rl = assoc_clause(rws)(name)
        rl.value := [add_in_db([arity, hcst, act, db]), sk]

  fun set_skip_name(Rws(htbl) as rws):
    fun(p):
      fun(sk):
        let Box([db, _]) as rl = assoc_clause(rws)(p)
        rl.value := [db, sk]

  fun scrub_const(Rws(htbl)):
    fun(c):
      let [name, _] = dest_const(c)
      Host.Hashtbl.remove(htbl)(name)

  fun from_term([rws, env, t]):
    fun down_2([env, t, c]):
      match t
      | Var(_,_):
          up_2(
            [
              try:
                Bv(index(t)(env))
                ~catch exn:
                  match exn
                  | _: Fv()
                  | exn: (throw exn),
              c
            ]
          )
      | Fusion.Const(name,_): up_2([Cst(t, assoc_clause(rws)(name)), c])
      | Comb(rator,rand): down_2([env, rator, Zrator([env, rand], c)])
      | Fusion.Abs(bvar,body): down_2([PairList [bvar, & env], body, Zabs(#void, c)])
    fun up_2
    | up_2([dt, Ztop()]): dt
    | up_2([dt, Zrator([env, arg],c)]): down_2([env, arg, Zrand(dt, c)])
    | up_2([dt, Zrand(dr,c)]): up_2([appl([dr, dt]), c])
    | up_2([dt, Zabs(_,c)]): up_2([Abs(dt), c])
    down_2([env, t, Ztop()])

  fun mk_rewrite(rws):
    fun(eq_thm):
      let [lhs, rhs] = dest_eq(concl(eq_thm))
      let [fv, cst, pats] = check_arg_form(lhs)
      let gen_thm = itlist(GEN)(fv)(eq_thm)
      let rhsc = from_term([rws, rev(fv), rhs])
      Rw(RewriteRec(cst, pats, length(fv), rhsc, gen_thm))

  fun unsuitable(th):
    let [l, r] = dest_eq(concl(th))
    can(term_match(PairList [])(l))(r)

  fun enter_thm(rws):
    fun(thm0):
      let thm = eq_intro(thm0)
      if unsuitable(thm)
      | #void
      | let rw = mk_rewrite(rws)(thm)
        add_in_db_upd(rws)(key_of(rw))(Rewrite(PairList [rw]))

  fun add_thms(lthm): fun(rws): Host.OCamlList.iter(o(Host.OCamlList.iter(enter_thm(rws)))(BODY_CONJUNCTS))(lthm)

  fun add_extern([cst, arity, fconv]):
    fun(rws):
      let [name, _] = dest_const(cst)
      add_in_db_upd(rws)([name, arity, cst])(Conv(fconv))

  fun new_rws(_):
    let rws = empty_rws(#void)
    add_thms(PairList [REFL_CLAUSE])(rws)
    rws

  fun from_list(lthm):
    let rws = new_rws(#void)
    add_thms(lthm)(rws)
    rws

  fun scrub_thms(lthm):
    fun(rws):
      let tmlist = map(o(o(concl)(hd))(BODY_CONJUNCTS))(lthm)
      let clist = map(o(o(o(o(fst)(strip_comb))(Equal.lhs))(snd))(strip_forall))(tmlist)
      Host.OCamlList.iter(scrub_const(rws))(clist)

  fun rws_of(Rws(htbl)):
    let dblist = Host.Hashtbl.fold(fun(_): fun(Box([db, _])): fun(r): PairList [db, & r])(htbl)(PairList [])
    fun get_actions(db):
      match db
      | End_db(): PairList []
      | Need_arg(db_prime): get_actions(db_prime)
      | Try(TryRec(hcst,rws,tail)): PairList [[hcst, rws], & get_actions(tail)]
    let actionlist = Host.OCamlList.concat(Host.OCamlList.map(get_actions)(dblist))
    let dest = (fun(Rw(RewriteRec(_,_,_,_,thm))): thm)
    let dest_action:
      fun
      | ([hcst, Rewrite(rws)]): [hcst, map(dest)(rws)]
      | ([hcst, Conv(_)]): [hcst, PairList []]
    let rwlist = Host.OCamlList.map(dest_action)(actionlist)
    rwlist

  variant transform:
    Conversion(conversion)
    Rrules(theorems)

  fun deplist(Rws(htbl)):
    let dblist = Host.Hashtbl.fold(fun(s): fun(Box([db, _])): fun(r): PairList [[s, db], & r])(htbl)(PairList [])
    fun get_actions_2(db):
      match db
      | End_db(): PairList []
      | Need_arg(db_prime): get_actions_2(db_prime)
      | Try(TryRec(hcst,rws,tail)): PairList [rws, & get_actions_2(tail)]
    let actionlist = Host.OCamlList.map((fun([s, db]): [s, get_actions_2(db)]))(dblist)
    let dest = (fun(Rw(RewriteRec(_,_,_,_,thm))): thm)
    let dest_action:
      fun
      | (Rewrite(rws)): Rrules(map(dest)(rws))
      | (Conv(ecnv)): Conversion(ecnv)
    let rwlist = Host.OCamlList.map((fun([s, act]): [s, map(dest_action)(act)]))(actionlist)
    rwlist

  class No_match()

  fun match_const([bds, tbds]):
    fun(pc):
      fun(c):
        let [name, ty] = dest_const(pc)
        let [name_prime, ty_prime] = dest_const(c)
        if (name == name_prime)
        | try:
            [bds, type_match(ty)(ty_prime)(tbds)]
            ~catch exn:
              match exn
              | _: (throw No_match())
              | exn: (throw exn)
        | (throw No_match())

  fun match_var([bds, tbds]):
    fun(var):
      fun(arg):
        let _:
          match Host.hol_array_get(bds)(var)
          | Host.Some([tm, _]): (if aconv(tm)(fst(arg)) | #void | (throw No_match()))
          | Host.None(): Host.hol_array_set(bds)(var)(Host.Some(arg))
        [bds, tbds]

  fun match_list(bds):
    fun(pats):
      fun(args):
        match [pats, args]
        | [PairList [pat, & pats], PairList [arg, & args]]: match_list(match_solve(bds)(pat)(arg))(pats)(args)
        | [PairList [], PairList []]: bds
        | _: (throw Dead_code("match_list"))

  fun match_solve(bds):
    fun(pat):
      fun(arg):
        match [pat, arg]
        | [Pvar(var), arg]: match_var(bds)(var)(arg)
        | [Papp(phead,pargs), [_, Const(CstRec(head,args,_,_))]]: (if (length(pargs) == length(args)) | match_list(match_const(bds)(phead)(head))(pargs)(args) | (throw No_match()))
        | _: (throw No_match())

  record RuleInst(rule, inst)

  fun try_rwn(ibds):
    fun(lt):
      fun try_rec
      | try_rec(PairList []): (throw No_match())
      | try_rec(PairList [Rw(RewriteRec(_,lhs,npv,_,_)) as rw, & rwn]):
          let env = Host.hol_array_make(npv)(Host.None())
          try:
            RuleInst(rw, match_list([env, ibds])(lhs)(lt))
            ~catch exn:
              match exn
              | No_match(): try_rec(rwn)
              | exn: (throw exn)
      try_rec

  fun comb_ct(cst):
    fun(arg):
      match cst
      | CstRec(head,args,Need_arg(tail),skip): Const(CstRec(head, PairList [arg, & args], tail, skip))
      | CstRec(head,args,End_db(),skip): Const(CstRec(head, PairList [arg, & args], End_db(), skip))
      | TryRec(_,Try(_),_): (throw Dead_code("comb_ct: yet rules to try"))

  fun mk_clos([env, t]):
    match t
    | Cst(hc,Box([db, b])): Const(CstRec(hc, PairList [], db, b))
    | Bv(i): Host.OCamlList.nth(env)(i)
    | Fv(): Neutr()
    | _: Clos(ClosRec(env, t))

  fun inst_one_var([thm, lv]):
    fun(arg):
      match arg
      | Host.Some([tm, v]): [SPEC(tm)(thm), PairList [v, & lv]]
      | Host.None(): (throw Dead_code("inst_rw"))

  fun inst_rw([th, monitoring, RuleInst(Rw(RewriteRec(_,_,_,rhs,thm)),[bds, tysub])]):
    let tirhs = inst_type_dterm([tysub, rhs])
    let tithm = INST_TYPE(tysub)(thm)
    let [spec_thm, venv] = Host.hol_array_fold_left(inst_one_var)([tithm, PairList []])(bds)
    let #void = (if monitoring | Host.print_term(concl(spec_thm)) | #void)
    [trans_thm(th)(spec_thm), mk_clos([venv, tirhs])]

  def monitoring = Box(Host.None())

  def stoppers = Box(Host.None())

  fun reduce_cst
  | reduce_cst([th, CstRec(head,args,Try(TryRec(hcst,Rewrite(rls),tail)),skip)]):
      try:
        let #void:
          match stoppers.value
          | Host.None(): #void
          | Host.Some(p): (if p(head) | (throw No_match()) | #void)
        let [_, _, tytheta]:
          try:
            term_match(PairList [])(hcst)(head)
            ~catch exn:
              match exn
              | _: (throw No_match())
              | exn: (throw exn)
        let rule_inst = try_rwn(tytheta)(args)(rls)
        let mon:
          match monitoring.value
          | Host.None(): #false
          | Host.Some(f): f(head)
        let insted = inst_rw([th, mon, rule_inst])
        [#true, insted]
        ~catch exn:
          match exn
          | No_match(): reduce_cst([th, CstRec(head, args, tail, skip)])
          | exn: (throw exn)
  | reduce_cst([th, CstRec(head,args,Try(TryRec(hcst,Conv(fconv),tail)),skip)]):
      try:
        let [thm, ft] = fconv(rhs_concl(th))
        [#true, [trans_thm(th)(thm), ft]]
        ~catch exn:
          match exn
          | _: reduce_cst([th, CstRec(head, args, tail, skip)])
          | exn: (throw exn)
  | reduce_cst([th, cst]): [#false, [th, Const(cst)]]

  def auto_import_definitions = Box(#true)

  def new_compset = from_list

  def listItems = deplist

  fun stack_out
  | stack_out([th, Ztop()]): th
  | stack_out([th, Zrator([mka, [thb, _]],ctx)]): stack_out([mka(th)(thb), ctx])
  | stack_out([th, Zrand([mka, _, [tha, _]],ctx)]): stack_out([mka(tha)(th), ctx])
  | stack_out([th, Zabs(mkl,ctx)]): stack_out([mkl(th), ctx])

  fun initial_state(rws): fun(t): [[refl_thm(t), mk_clos([PairList [], from_term([rws, PairList [], t])])], Ztop()]

  fun cbv_wk
  | cbv_wk([[th, Clos(ClosRec(env,App(a,args)))], stk]):
      let [tha, stka] = rev_itlist(push_in_stk(curry(mk_clos)(env)))(args)([th, stk])
      cbv_wk([[tha, mk_clos([env, a])], stka])
  | cbv_wk([[th, Clos(ClosRec(env,Abs(body)))], Zrator([mka, [thb, cl]],s_prime)]): cbv_wk([[beta_thm(mka(th)(thb)), mk_clos([PairList [cl, & env], body])], s_prime])
  | cbv_wk([[th, Const(cargs)], stk]):
      let [reduced, clos] = reduce_cst([th, cargs])
      (if reduced | cbv_wk([clos, stk]) | cbv_up([clos, stk]))
  | cbv_wk([clos, stk]): cbv_up([clos, stk])

  fun cbv_up
  | cbv_up([hcl, Zrator([mka, clos],ctx)]):
      let new_state = [clos, Zrand([mka, #false, hcl], ctx)]
      (if is_skip(hcl) | cbv_up(new_state) | cbv_wk(new_state))
  | cbv_up([[thb, v], Zrand([mka, #false, [th, Const(cargs)]],stk)]): cbv_wk([[mka(th)(thb), comb_ct(cargs)([rhs_concl(thb), v])], stk])
  | cbv_up([[thb, Neutr()], Zrand([mka, #false, [th, Neutr()]],stk)]): cbv_up([[mka(th)(thb), Neutr()], stk])
  | cbv_up([clos, stk]): [clos, stk]

  fun strong
  | strong([[th, Clos(ClosRec(env,Abs(t)))], stk]):
      let [thb, stk_prime] = push_lam_in_stk([th, stk])
      strong(cbv_wk([[thb, mk_clos([PairList [Neutr(), & env], t])], stk_prime]))
  | strong([[_, Clos(_)], stk]): (throw Dead_code("strong"))
  | strong([[th, Const(CstRec(_,args,_,skip))], stk]):
      let [argssk, argsrd] = partition_skip(skip)(args)
      let [th_prime, stk_prime] = rev_itlist(push_skip_stk(snd))(argssk)([th, stk])
      let [th_prime_prime, stk_prime_prime] = rev_itlist(push_in_stk(snd))(argsrd)([th_prime, stk_prime])
      strong_up([th_prime_prime, stk_prime_prime])
  | strong([[th, Neutr()], stk]): strong_up([th, stk])

  fun strong_up
  | strong_up([th, Ztop()]): th
  | strong_up([th, Zrand([mka, #false, [tha, Neutr()]],ctx)]): strong(cbv_wk([[mka(tha)(th), Neutr()], ctx]))
  | strong_up([th, Zrand([mka, #false, clos],ctx)]): (throw Dead_code("strong_up"))
  | strong_up([th, Zrator([mka, clos],ctx)]): strong(cbv_wk([clos, Zrand([mka, #true, [th, Neutr()]], ctx)]))
  | strong_up([th, Zrand([mka, #true, [tha, _]],ctx)]): strong_up([mka(tha)(th), ctx])
  | strong_up([th, Zabs(mkl,ctx)]): strong_up([mkl(th), ctx])

  fun CBV_CONV(rws): fun(tm): o(o(o(evaluate)(strong))(cbv_wk))(initial_state(rws))(tm)

  fun WEAK_CBV_CONV(rws): fun(tm): o(o(o(evaluate)((fun([[th, _], stk]): stack_out([th, stk]))))(cbv_wk))(initial_state(rws))(tm)

  fun extern_of_conv(rws):
    fun(conv):
      fun(tm):
        let thm = conv(tm)
        [thm, mk_clos([PairList [], from_term([rws, PairList [], Equal.rhs(concl(thm))])])]

  fun add_conv([cst, arity, conv]): fun(rws): add_extern([cst, arity, extern_of_conv(rws)(conv)])(rws)

  fun set_skip(compset):
    fun(c):
      fun(opt):
        try:
          let [name, _] = dest_const(c)
          set_skip_name(compset)(name)(opt)
          ~catch exn:
            match exn
            | _: failwith("set_skip")
            | exn: (throw exn)

  def bool_redns:
    PairList [
      strictify_thm(LET_DEF),
      & (
        Host.OCamlList.map(lazyfy_thm)(
          PairList [
            COND_CLAUSES,
            COND_ID,
            NOT_CLAUSES,
            AND_CLAUSES,
            OR_CLAUSES,
            IMP_CLAUSES,
            EQ_CLAUSES
          ]
        )
      )
    ]

  fun bool_compset(_):
    let base = from_list(bool_redns)
    let #void:
      set_skip(base)(Host.hol_term(Const("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))))))(Host.None())
    base

  fun basic_compset(_):
    let basic_rws0 = basic_rewrites(#void)
    let lhs_lambda_rules = map(SPEC_ALL)(PairList [SELECT_REFL, FORALL_SIMP, EXISTS_SIMP])
    let basic_rws = Host.OCamlList.filter((fun(th): !mem(th)(lhs_lambda_rules)))(basic_rws0)
    let cs = new_compset(Host.OCamlList.map(lazyfy_thm)(basic_rws))
    Host.OCamlList.iter(
      fun([_, [pat, the_conv]]):
        let [cst, args] = strip_comb(pat)
        add_conv([cst, length(args), the_conv])(cs)
    )(basic_convs(#void))
    add_conv(
      [
        Host.hol_term(Const("LET", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Tvar("A"), Tvar("B"))))),
        2,
        let_CONV
      ])(
      cs
    )
    set_skip(cs)(Host.hol_term(Const("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))))))(Host.None())
    cs

  def the_compset = bool_compset(#void)

  def add_funs = C(add_thms)(the_compset)

  def add_convs = Host.OCamlList.iter(C(add_conv)(the_compset))

  def del_consts = Host.OCamlList.iter(scrub_const(the_compset))

  def del_funs = C(scrub_thms)(the_compset)

  def EVAL_CONV = CBV_CONV(the_compset)

  def EVAL_RULE = CONV_RULE(EVAL_CONV)

  def EVAL_TAC = CONV_TAC(EVAL_CONV)

  fun same_const(c1): fun(c2): (fst(dest_const(c1)) == fst(dest_const(c2)))

  fun OR(xs):
    fun(x):
      match xs
      | PairList []: #false
      | PairList [h, & t]: same_const(h)(x) || OR(t)(x)

  fun RESTR_EVAL_CONV(clist): fun(tm): with_flag([stoppers, Host.Some(OR(clist))])(EVAL_CONV)(tm)

  def RESTR_EVAL_TAC = o(CONV_TAC)(RESTR_EVAL_CONV)

  def RESTR_EVAL_RULE = o(CONV_RULE)(RESTR_EVAL_CONV)
