  fun compute_Compute_with_flag(Pair(flag,b)):«
    (fun(f):«
      (fun(x):«
        (block:«
          let fval:«
            Host.ref_get(flag)
          »;
          (block:«
            let #void:«
              Host.ref_set(flag)(b)
            »;
            (block:«
              let res:«
                (block:«
                  try:«
                    f(x);
                    ~catch port_tmp_1:«
                      let port_tmp_2 = port_tmp_1;
                      match port_tmp_2
                      | e:«
                          (block:«
                            Host.ref_set(flag)(fval);
                            Host.hol_raise(e)
                          »)
                      »
                      | port_tmp_1:«
                          Host.hol_raise(port_tmp_1)
                      »
                    »
                  »
                »)
              »;
              (block:«
                Host.ref_set(flag)(fval);
                res
              »)
            »)
          »)
        »)
      »)
    »)
  »;
