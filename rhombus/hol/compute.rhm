  fun compute_Compute_with_flag([flag, b]):
    fun(f):
      fun(x):
        let fval = Host.ref_get(flag)
        let #void = Host.ref_set(flag)(b)
        let res:
          try:
            f(x)
            ~catch exn:
              match exn
              | e:
                  Host.ref_set(flag)(fval)
                  Host.hol_raise(e)
              | exn: Host.hol_raise(exn)
        Host.ref_set(flag)(fval)
        res

  fun compute_Compute_RIGHT_BETA(th):
    try:
      Fusion.TRANS(th)(Equal.BETA_CONV(Equal.rhs(Fusion.concl(th))))
      ~catch exn:
        match exn
        | _: failwith("RIGHT_BETA")
        | exn: Host.hol_raise(exn)

  fun compute_Compute_RIGHT_ETA(thm):
    try:
      Fusion.TRANS(thm)(Class.ETA_CONV(Equal.rhs(Fusion.concl(thm))))
      ~catch exn:
        match exn
        | _: failwith("RIGHT_ETA")
        | exn: Host.hol_raise(exn)

  fun compute_Compute_MK_comb(th):
    let [rator, rand] = Fusion.dest_comb(Equal.rhs(Fusion.concl(th)))
    let mka = (fun(th1): (fun(th2): Fusion.TRANS(th)(Fusion.MK_COMB([th1, th2]))))
    [Fusion.REFL(rator), Fusion.REFL(rand), mka]

  fun compute_Compute_MK_abs(th):
    let [bvar, body] = Fusion.dest_abs(Equal.rhs(Fusion.concl(th)))
    [bvar, Fusion.REFL(body), (fun(th1): Fusion.TRANS(th)(Fusion.ABS(bvar)(th1)))]

  fun compute_Compute_BODY_CONJUNCTS(th):
    if Basics.is_forall(Fusion.concl(th))
    | compute_Compute_BODY_CONJUNCTS(Bool.SPEC_ALL(th))
    | (if Basics.is_conj(Fusion.concl(th)) | append(compute_Compute_BODY_CONJUNCTS(Bool.CONJUNCT1(th)))(compute_Compute_BODY_CONJUNCTS(Bool.CONJUNCT2(th))) | PairList.cons(th, PairList []))

