export:
  Compute

namespace Compute:
  export:
    with_flag
    RIGHT_BETA
    RIGHT_ETA
    MK_comb
    MK_abs
    BODY_CONJUNCTS
    Ztop
    Zrator
    Zrand
    Zabs
    Dead_code
    rhs_concl
    refl_thm
    trans_thm
    beta_thm
    evaluate
    try_eta
    push_in_stk
    push_skip_stk
    push_lam_in_stk
    FUNIFY
