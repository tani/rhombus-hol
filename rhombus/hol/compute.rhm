  fun compute_Compute_assoc_clause(compute_Compute_ctor_Rws(rws)):
    fun(cst):
      try:
        Host.Hashtbl.find(rws)(cst)
        ~catch exn:
          match exn
          | Host.Not_found():
              let mt = Box([compute_Compute_ctor_End_db(), Host.None()])
              Host.Hashtbl.add(rws)(cst)(mt)
              mt
          | exn: Host.hol_raise(exn)

  fun compute_Compute_add_in_db_upd(rws):
    fun([name, arity, hcst]):
      fun(act):
        let Box([db, sk]) as rl = compute_Compute_assoc_clause(rws)(name)
        Host.ref_set(rl)([compute_Compute_add_in_db([arity, hcst, act, db]), sk])

