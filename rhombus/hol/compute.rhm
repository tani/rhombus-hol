  fun compute_Compute_add_extern([cst, arity, fconv]):
    fun(rws):
      let [name, _] = Fusion.dest_const(cst)
      compute_Compute_add_in_db_upd(rws)([name, arity, cst])(compute_Compute_ctor_Conv(fconv))

  fun compute_Compute_new_rws(_):
