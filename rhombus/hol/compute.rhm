  fun compute_Compute_scrub_const(compute_Compute_ctor_Rws(htbl)):
    fun(c):
      let [name, _] = Fusion.dest_const(c)
      Host.Hashtbl.remove(htbl)(name)

  fun compute_Compute_from_term([rws, env, t]):
    fun down_2([env, t, c]):
      match t
      | Fusion.Var(_,_):
          up_2(
            [
              try:
                compute_Compute_ctor_Bv(Host.index(t)(env))
                ~catch exn:
                  match exn
                  | _: compute_Compute_ctor_Fv()
                  | exn: Host.hol_raise(exn),
              c])
      | Fusion.Const(name,_): up_2([compute_Compute_ctor_Cst(t, compute_Compute_assoc_clause(rws)(name)), c])
      | Fusion.Comb(rator,rand): down_2([env, rator, compute_Compute_ctor_Zrator([env, rand], c)])
      | Fusion.Abs(bvar,body): down_2([PairList.cons(bvar, env), body, compute_Compute_ctor_Zabs(#void, c)])
    fun up_2
    | up_2([dt, compute_Compute_ctor_Ztop()]): dt
    | up_2([dt, compute_Compute_ctor_Zrator([env, arg],c)]): down_2([env, arg, compute_Compute_ctor_Zrand(dt, c)])
    | up_2([dt, compute_Compute_ctor_Zrand(dr,c)]): up_2([compute_Compute_appl([dr, dt]), c])
    | up_2([dt, compute_Compute_ctor_Zabs(_,c)]): up_2([compute_Compute_ctor_Abs(dt), c])
    down_2([env, t, compute_Compute_ctor_Ztop()])

  fun compute_Compute_mk_rewrite(rws):
    fun(eq_thm):
      let [lhs, rhs] = Fusion.dest_eq(Fusion.concl(eq_thm))
      let [fv, cst, pats] = compute_Compute_check_arg_form(lhs)
      let gen_thm = itlist(Bool.GEN)(fv)(eq_thm)
      let rhsc = compute_Compute_from_term([rws, Host.rev(fv), rhs])
      compute_Compute_ctor_Rw(compute_Compute_rec_rewrite_rec(cst, pats, length(fv), rhsc, gen_thm))

  fun compute_Compute_unsuitable(th):
    let [l, r] = Fusion.dest_eq(Fusion.concl(th))
    can(Drule.term_match(PairList [])(l))(r)

  fun compute_Compute_enter_thm(rws):
    fun(thm0):
      let thm = compute_Compute_eq_intro(thm0)
      if compute_Compute_unsuitable(thm)
      | #void
      | let rw = compute_Compute_mk_rewrite(rws)(thm)
        compute_Compute_add_in_db_upd(rws)(compute_Compute_key_of(rw))(compute_Compute_ctor_Rewrite(PairList.cons(rw, PairList [])))

