  fun compute_Compute_FUNIFY(thm):
    try:
      let x = Fusion.rand(Equal.lhs(Fusion.concl(thm)))
      Equal.CONV_RULE(Equal.RATOR_CONV(Equal.RAND_CONV(Equal.CHANGED_CONV(Simp.PURE_REWRITE_CONV(PairList.cons(Class.ETA_AX, PairList []))))))(Fusion.ABS(x)(thm))
