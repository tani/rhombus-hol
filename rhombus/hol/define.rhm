def define_WF_REC_CASES_prime:
  prove(
    [
      (hol:
         const WF :: (A -> A -> bool) -> bool
         const ALL :: (A -> bool) -> list(A) -> bool
         const GABS :: (A -> bool) -> A
         const GEQ :: A -> A -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         const tailadmissible :: (A -> A -> bool) -> ((A -> B) -> P -> bool) -> (P -> A) -> ((A -> B) -> P -> B) -> bool
         const CASEWISE :: list(pair(#{?138308} -> #{?138312}, #{?138313} -> #{?138308} -> #{?138272})) -> #{?138313} -> #{?138312} -> #{?138272}
         forall (ll :: A -> A -> bool, clauses :: list(pair(#{?141801} -> A, (A -> B) -> #{?141801} -> B))):
           (WF(ll)
              && ALL(
                   GABS(
                     fun (f :: pair(#{?141801} -> A, (A -> B) -> #{?141801} -> B) -> bool):
                       forall (s :: #{?141801} -> A, t :: (A -> B) -> #{?141801} -> B):
                         GEQ(
                           f(#{|,|}(s, t)),
                           tailadmissible(ll, fun (f :: A -> B, a :: #{?141801}): #true, s, t)
                         )
                   ),
                   clauses
                 ))
             ==> (exists f :: A -> B: forall x :: A: f(x) == CASEWISE(clauses, f, x))),
      REWRITE_TAC(PairList [WF_REC_CASES, tailadmissible])
    ]
  )

def RECURSION_CASEWISE:
  prove(
    [
      (hol:
         const WF :: (A -> A -> bool) -> bool
         const ALL :: (A -> bool) -> list(A) -> bool
         const GABS :: (A -> bool) -> A
         const GEQ :: A -> A -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         const tailadmissible :: (A -> A -> bool) -> ((A -> B) -> P -> bool) -> (P -> A) -> ((A -> B) -> P -> B) -> bool
         const MEM :: A -> list(A) -> bool
         forall clauses :: list(pair(P -> A, (A -> B) -> P -> B)):
           ((exists ll :: A -> A -> bool:
               WF(ll)
                 && ALL(
                      GABS(
                        fun (f :: pair(P -> A, (A -> B) -> P -> B) -> bool):
                          forall (s :: P -> A, t :: (A -> B) -> P -> B):
                            GEQ(
                              f(#{|,|}(s, t)),
                              tailadmissible(ll, fun (f :: A -> B, a :: P): #true, s, t)
                            )
                      ),
                      clauses
                    ))
              && (forall (s :: P -> A, t :: (A -> B) -> P -> B, s_prime :: P -> A, t_prime :: (A -> B) -> P -> B, f :: A -> B, x :: P, y :: P):
                    MEM(#{|,|}(s, t), clauses) && MEM(#{|,|}(s_prime, t_prime), clauses)
                      ==> s(x) == s_prime(y)
                      ==> t(f, x) == t_prime(f, y)))
             ==> (exists f :: A -> B:
                    ALL(
                      GABS(
                        fun (f_2 :: pair(P -> A, (A -> B) -> P -> B) -> bool):
                          forall (s :: P -> A, t :: (A -> B) -> P -> B):
                            GEQ(f_2(#{|,|}(s, t)), forall x :: P: f(s(x)) == t(f, x))
                      ),
                      clauses
                    ))),
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(GEN_TAC) then_tac \
                    REWRITE_TAC(PairList [IMP_IMP, CONJ_ASSOC])
                  ) then_tac \
                  DISCH_THEN(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC))
                ) then_tac \
                DISCH_THEN(CHOOSE_THEN(o(MP_TAC)(MATCH_MP(define_WF_REC_CASES_prime))))
              ) then_tac \
              MATCH_MP_TAC(MONO_EXISTS)
            ) then_tac \
            REPEAT(STRIP_TAC)
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_MESON_TAC(PairList [CASEWISE_WORKS])
      )
    ]
  )

