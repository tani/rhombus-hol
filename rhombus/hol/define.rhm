def CASEWISE_WORKS:
  prove(
    [
      (hol:
         const MEM :: A -> list(A) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         const ALL :: (A -> bool) -> list(A) -> bool
         const GABS :: (A -> bool) -> A
         const GEQ :: A -> A -> bool
         const CASEWISE :: list(pair(#{?138308} -> #{?138312}, #{?138313} -> #{?138308} -> #{?138272})) -> #{?138313} -> #{?138312} -> #{?138272}
         forall (clauses :: list(pair(P -> A, C -> P -> B)), c :: C):
           (forall (s :: P -> A, t :: C -> P -> B, s_prime :: P -> A, t_prime :: C -> P -> B, x :: P, y :: P):
              (MEM(#{|,|}(s, t), clauses)
                 && (MEM(#{|,|}(s_prime, t_prime), clauses) && s(x) == s_prime(y)))
                ==> t(c, x) == t_prime(c, y))
             ==> ALL(
                   GABS(
                     fun (f :: pair(P -> A, C -> P -> B) -> bool):
                       forall (s :: P -> A, t :: C -> P -> B):
                         GEQ(f(#{|,|}(s, t)), forall x :: P: CASEWISE(clauses, c, s(x)) == t(c, x))
                   ),
                   clauses
                 )),
      (
        REWRITE_TAC(PairList [GSYM(ALL_MEM), FORALL_PAIR_THM]) then_tac \
        MESON_TAC(PairList [CASEWISE_CASES])
      )
    ]
  )

def admissible:
  new_definition(
    (hol:
       var admissible :: (#{?138635} -> #{?138628} -> bool) -> ((#{?138635} -> #{?138631}) -> #{?138641} -> bool) -> (#{?138641} -> #{?138628}) -> ((#{?138635} -> #{?138631}) -> #{?138641} -> #{?138636}) -> bool
       var ll :: #{?138635} -> #{?138628} -> bool
       var p :: (#{?138635} -> #{?138631}) -> #{?138641} -> bool
       var s :: #{?138641} -> #{?138628}
       var t :: (#{?138635} -> #{?138631}) -> #{?138641} -> #{?138636}
       admissible(ll, p, s, t)
         <=> (forall (f :: #{?138635} -> #{?138631}, g :: #{?138635} -> #{?138631}, a :: #{?138641}):
                p(f, a) && (p(g, a) && (forall z :: #{?138635}: ll(z, s(a)) ==> f(z) == g(z)))
                  ==> t(f, a) == t(g, a)))
  )

def tailadmissible:
  new_definition(
    (hol:
       var tailadmissible :: (A -> A -> bool) -> ((A -> B) -> P -> bool) -> (P -> A) -> ((A -> B) -> P -> B) -> bool
       var ll :: A -> A -> bool
       var p :: (A -> B) -> P -> bool
       var s :: P -> A
       var t :: (A -> B) -> P -> B
       tailadmissible(ll, p, s, t)
         <=> (exists (P :: (A -> B) -> P -> bool, G :: (A -> B) -> P -> A, H :: (A -> B) -> P -> B):
                (forall (f :: A -> B, a :: P, y :: A): P(f, a) && ll(y, G(f, a)) ==> ll(y, s(a)))
                  && ((forall (f :: A -> B, g :: A -> B, a :: P):
                         (forall z :: A: ll(z, s(a)) ==> f(z) == g(z))
                           ==> (P(f, a) <=> P(g, a)) && (G(f, a) == G(g, a) && H(f, a) == H(g, a)))
                        && (forall (f :: A -> B, a :: P):
                              p(f, a) ==> t(f, a) == (if P(f, a) | f(G(f, a)) | H(f, a))))))
  )

