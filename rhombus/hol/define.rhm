def SUPERADMISSIBLE_MATCH_UNGUARDED_PATTERN:
  prove(
    [
      hol_term(Forall(
        "<<",
        Fun(Tvar("A"), Fun(Tvar("A"), Bool)),
        Forall(
          "p",
          Fun(Fun(Tvar("A"), Tvar("B")), Fun(Tvar("P"), Bool)),
          Forall(
            "s",
            Fun(Tvar("P"), Tvar("A")),
            Forall(
              "e",
              Fun(Tvar("P"), Tvar("D")),
              Forall(
                "pat",
                Fun(Tvar("Q"), Tvar("D")),
                Forall(
                  "arg",
                  Fun(Tvar("P"), Fun(Tvar("Q"), Tvar("A"))),
                  Implies(
                    And(
                      Forall(
                        "f",
                        Fun(Tvar("A"), Tvar("B")),
                        Forall(
                          "a",
                          Tvar("P"),
                          Forall(
                            "t",
                            Tvar("Q"),
                            Forall(
                              "u",
                              Tvar("Q"),
                              Implies(
                                And(
                                  App(Ref("p"), [Ref("f"), Ref("a")]),
                                  And(
                                    Eq(Tvar("D"), App(Ref("pat"), [Ref("t")]), App(Ref("e"), [Ref("a")])),
                                    Eq(Tvar("D"), App(Ref("pat"), [Ref("u")]), App(Ref("e"), [Ref("a")]))
                                  )
                                ),
                                Eq(Tvar("A"), App(Ref("arg"), [Ref("a"), Ref("t")]), App(Ref("arg"), [Ref("a"), Ref("u")]))
                              )
                            )
                          )
                        )
                      ),
                      Forall(
                        "f",
                        Fun(Tvar("A"), Tvar("B")),
                        Forall(
                          "a",
                          Tvar("P"),
                          Forall(
                            "t",
                            Tvar("Q"),
                            Implies(
                              And(
                                App(Ref("p"), [Ref("f"), Ref("a")]),
                                Eq(Tvar("D"), App(Ref("pat"), [Ref("t")]), App(Ref("e"), [Ref("a")]))
                              ),
                              Forall(
                                "y",
                                Tvar("A"),
                                Implies(
                                  App(Ref("<<"), [Ref("y"), App(Ref("arg"), [Ref("a"), Ref("t")])]),
                                  App(Ref("<<"), [Ref("y"), App(Ref("s"), [Ref("a")])])
                                )
                              )
                            )
                          )
                        )
                      )
                    ),
                    App(
                      Const(
                        "superadmissible",
                        Fun(
                          Fun(Tvar("A"), Fun(Tvar("A"), Bool)),
                          Fun(
                            Fun(Fun(Tvar("A"), Tvar("B")), Fun(Tvar("P"), Bool)),
                            Fun(
                              Fun(Tvar("P"), Tvar("A")),
                              Fun(Fun(Fun(Tvar("A"), Tvar("B")), Fun(Tvar("P"), Tvar("B"))), Bool)
                            )
                          )
                        )
                      ),
                      [
                        Ref("<<"),
                        Ref("p"),
                        Ref("s"),
                        Lambda(
                          "f",
                          Fun(Tvar("A"), Tvar("B")),
                          Lambda(
                            "x",
                            Tvar("P"),
                            App(
                              Const("_MATCH", Fun(Tvar("D"), Fun(Fun(Tvar("D"), Fun(Tvar("B"), Bool)), Tvar("B")))),
                              [
                                App(Ref("e"), [Ref("x")]),
                                Lambda(
                                  "u",
                                  Tvar("D"),
                                  Lambda(
                                    "v",
                                    Tvar("B"),
                                    Exists(
                                      "t",
                                      Tvar("Q"),
                                      App(
                                        Const("_UNGUARDED_PATTERN", Fun(Bool, Fun(Bool, Bool))),
                                        [
                                          App(Const("GEQ", Fun(Tvar("D"), Fun(Tvar("D"), Bool))), [App(Ref("pat"), [Ref("t")]), Ref("u")]),
                                          App(
                                            Const("GEQ", Fun(Tvar("B"), Fun(Tvar("B"), Bool))),
                                            [App(Ref("f"), [App(Ref("arg"), [Ref("x"), Ref("t")])]), Ref("v")]
                                          )
                                        ]
                                      )
                                    )
                                  )
                                )
                              ]
                            )
                          )
                        )
                      ]
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (REPEAT(GEN_TAC) then_tac STRIP_TAC) then_tac \
                          REWRITE_TAC(PairList [superadmissible])
                        ) then_tac \
                        DISCH_TAC
                      ) then_tac \
                      REWRITE_TAC(PairList [_UNGUARDED_PATTERN, GEQ_DEF, _MATCH])
                    ) then_tac \
                    REWRITE_TAC(PairList [tailadmissible])
                  ) then_tac \
                  SUBGOAL_THEN(
                    hol_term(Forall(
                      "f",
                      Fun(Tvar("A"), Tvar("B")),
                      Forall(
                        "x",
                        Tvar("P"),
                        Implies(
                          App(Var("p", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Tvar("P"), Bool))), [Ref("f"), Ref("x")]),
                          Iff(
                            ExistsUnique(
                              "v",
                              Tvar("B"),
                              Exists(
                                "t",
                                Tvar("Q"),
                                And(
                                  Eq(
                                    Tvar("D"),
                                    App(Var("pat", Fun(Tvar("Q"), Tvar("D"))), [Ref("t")]),
                                    App(Var("e", Fun(Tvar("P"), Tvar("D"))), [Ref("x")])
                                  ),
                                  Eq(
                                    Tvar("B"),
                                    App(
                                      Ref("f"),
                                      [App(Var("arg", Fun(Tvar("P"), Fun(Tvar("Q"), Tvar("A")))), [Ref("x"), Ref("t")])]
                                    ),
                                    Ref("v")
                                  )
                                )
                              )
                            ),
                            Exists(
                              "t",
                              Tvar("Q"),
                              Eq(
                                Tvar("D"),
                                App(Var("pat", Fun(Tvar("Q"), Tvar("D"))), [Ref("t")]),
                                App(Var("e", Fun(Tvar("P"), Tvar("D"))), [Ref("x")])
                              )
                            )
                          )
                        )
                      )
                    ))
                  )((fun(th): SIMP_TAC(PairList [th])))
                ) then_list \
                PairList [ASM_MESON_TAC(PairList []), ALL_TAC]
              ) then_tac \
              MAP_EVERY(EXISTS_TAC)(
                PairList [
                  hol_term(Lambda(
                    "f",
                    Fun(Tvar("A"), Tvar("B")),
                    Lambda(
                      "x",
                      Tvar("P"),
                      And(
                        App(Var("p", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Tvar("P"), Bool))), [Ref("f"), Ref("x")]),
                        Exists(
                          "t",
                          Tvar("Q"),
                          Eq(
                            Tvar("D"),
                            App(Var("pat", Fun(Tvar("Q"), Tvar("D"))), [Ref("t")]),
                            App(Var("e", Fun(Tvar("P"), Tvar("D"))), [Ref("x")])
                          )
                        )
                      )
                    )
                  )),
                  hol_term(Lambda(
                    "f",
                    Fun(Tvar("A"), Tvar("B")),
                    Lambda(
                      "x",
                      Tvar("P"),
                      App(
                        Var("arg", Fun(Tvar("P"), Fun(Tvar("Q"), Tvar("A")))),
                        [
                          Ref("x"),
                          App(
                            Const("@", Fun(Fun(Tvar("Q"), Bool), Tvar("Q"))),
                            [
                              Lambda(
                                "t",
                                Tvar("Q"),
                                Eq(
                                  Tvar("D"),
                                  App(Var("pat", Fun(Tvar("Q"), Tvar("D"))), [Ref("t")]),
                                  App(Var("e", Fun(Tvar("P"), Tvar("D"))), [Ref("x")])
                                )
                              )
                            ]
                          )
                        ]
                      )
                    )
                  )),
                  hol_term(Lambda(
                    "f",
                    Fun(Tvar("A"), Tvar("B")),
                    Lambda(
                      "x",
                      Tvar("P"),
                      App(Const("@", Fun(Fun(Tvar("B"), Bool), Tvar("B"))), [Lambda("z", Tvar("B"), False)])
                    )
                  ))
                ]
              )
            ) then_tac \
            RULE_ASSUM_TAC(REWRITE_RULE(PairList [admissible]))
          ) then_tac \
          SIMP_TAC(PairList [])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

