def ADMISSIBLE_IMP_SUPERADMISSIBLE:
  prove(
    [
      (hol:
         const admissible :: (#{?138610} -> #{?138603} -> bool) -> ((#{?138610} -> #{?138606}) -> #{?138616} -> bool) -> (#{?138616} -> #{?138603}) -> ((#{?138610} -> #{?138606}) -> #{?138616} -> #{?138611}) -> bool
         const superadmissible :: (#{?138760} -> #{?138760} -> bool) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> bool) -> (#{?138768} -> #{?138760}) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> #{?138762}) -> bool
         forall (ll :: A -> A -> bool, p :: (A -> B) -> P -> bool, s :: P -> A, t :: (A -> B) -> P -> B):
           admissible(ll, p, s, t) ==> superadmissible(ll, p, s, t)),
      (
        (
          (
            (
              REWRITE_TAC(PairList [admissible, superadmissible, tailadmissible]) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            MAP_EVERY(EXISTS_TAC)(
              PairList [
                (hol:
                   fun (f :: A -> B, x :: P): #false),
                (hol:
                   var anything :: P -> A
                   fun (f :: A -> B): anything),
                (hol:
                   var p :: (A -> B) -> P -> bool
                   var t :: (A -> B) -> P -> B
                   var fixed :: B
                   fun (f :: A -> B, a :: P): if p(f, a) | t(f, a) | fixed)
              ]
            )
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

