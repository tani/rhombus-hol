                                                | APPLY_PROFORMA_TAC(ADMISSIBLE_COMB)(gl)
                                                | match subject
                                                  | _: failwith("MAIN_ADMISS_TAC")
                                            | _: failwith("MAIN_ADMISS_TAC")
                                      | ["admissible", _]:
