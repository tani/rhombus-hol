                Fun(
                  Fun(Tvar("?142194"), Tvar("?142188")),
                  Fun(Fun(Fun(Tvar("?142188"), Tvar("?142190")), Fun(Tvar("?142194"), Tvar("?142190"))), Bool)
                )
              )
            )
          ),
          [
            Var("<<", Fun(Tvar("?142188"), Fun(Tvar("?142188"), Bool))),
            Lambda("f", Fun(Tvar("?142188"), Tvar("?142190")), Lambda("x", Tvar("?142194"), True)),
            Var("s", Fun(Tvar("?142194"), Tvar("?142188"))),
            Var("t", Fun(Fun(Tvar("?142188"), Tvar("?142190")), Fun(Tvar("?142194"), Tvar("?142190"))))
          ]
        ),
        App(
          Const(
            "tailadmissible",
