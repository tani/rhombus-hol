           const GABS :: (A -> bool) -> A
           const GEQ :: A -> A -> bool
           const #{|,|} :: A -> B -> pair(A, B)
           const CONS :: A -> list(A) -> list(A)
           const NIL :: list(A)
           (ALL(
              GABS(
                fun (f :: pair(#{?142746}, #{?142745}) -> bool):
                  forall (s :: #{?142746}, t :: #{?142745}): GEQ(f(#{|,|}(s, t)), P(s, t))
