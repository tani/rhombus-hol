def SUPERADMISSIBLE_TAIL:
  prove(
    [
      (hol:
         const admissible :: (#{?138610} -> #{?138603} -> bool) -> ((#{?138610} -> #{?138606}) -> #{?138616} -> bool) -> (#{?138616} -> #{?138603}) -> ((#{?138610} -> #{?138606}) -> #{?138616} -> #{?138611}) -> bool
         const superadmissible :: (#{?138760} -> #{?138760} -> bool) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> bool) -> (#{?138768} -> #{?138760}) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> #{?138762}) -> bool
         forall (ll :: A -> A -> bool, p :: (A -> B) -> P -> bool, s :: P -> A, t :: (A -> B) -> P -> A):
           (admissible(ll, p, s, t)
              && (forall (f :: A -> B, a :: P):
                    p(f, a) ==> (forall y :: A: ll(y, t(f, a)) ==> ll(y, s(a)))))
             ==> superadmissible(ll, p, s, fun (f :: A -> B, x :: P): f(t(f, x)))),
      (
        (
          (
            (
              REWRITE_TAC(PairList [admissible, superadmissible, tailadmissible]) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            MAP_EVERY(EXISTS_TAC)(
              PairList [
                (hol:
                   fun (f :: A -> B, x :: P): #true),
                (hol:
                   var p :: (A -> B) -> P -> bool
                   var t :: (A -> B) -> P -> A
                   var s :: P -> A
                   fun (f :: A -> B, a :: P): if p(f, a) | t(f, a) | s(a)),
                (hol:
                   var anything :: P -> B
                   fun (f :: A -> B): anything)
              ]
            )
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def SUPERADMISSIBLE_COND:
  prove(
    [
      (hol:
         const admissible :: (#{?138610} -> #{?138603} -> bool) -> ((#{?138610} -> #{?138606}) -> #{?138616} -> bool) -> (#{?138616} -> #{?138603}) -> ((#{?138610} -> #{?138606}) -> #{?138616} -> #{?138611}) -> bool
         const superadmissible :: (#{?138760} -> #{?138760} -> bool) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> bool) -> (#{?138768} -> #{?138760}) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> #{?138762}) -> bool
         forall (ll :: A -> A -> bool, p :: (A -> B) -> P -> bool, P :: (A -> B) -> P -> bool, s :: P -> A, h :: (A -> B) -> P -> B, k :: (A -> B) -> P -> B):
           (admissible(ll, p, s, P)
              && (superadmissible(ll, fun (f :: A -> B, x :: P): p(f, x) && P(f, x), s, h)
                    && superadmissible(ll, fun (f :: A -> B, x :: P): p(f, x) && !P(f, x), s, k)))
             ==> superadmissible(ll, p, s, fun (f :: A -> B, x :: P): if P(f, x) | h(f, x) | k(f, x))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            REWRITE_TAC(PairList [superadmissible, admissible]) then_tac \
                                            REPEAT(GEN_TAC)
                                          ) then_tac \
                                          DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC))
                                        ) then_tac \
                                        DISCH_THEN((fun(th): (DISCH_TAC then_tac CONJUNCTS_THEN(MP_TAC)(th))))
                                      ) then_tac \
                                      ANTS_TAC
                                    ) then_list \
                                    PairList [ASM_MESON_TAC(PairList []), ALL_TAC]
                                  ) then_tac \
                                  DISCH_THEN(
                                    (fun(th): (ANTS_TAC then_list PairList [ASM_MESON_TAC(PairList []), MP_TAC(th)]))
                                  )
                                ) then_tac \
                                REWRITE_TAC(PairList [tailadmissible])
                              ) then_tac \
                              REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM])
                            ) then_tac \
                            MAP_EVERY(X_GEN_TAC)(
                              PairList [
                                (hol: var P1 :: (A -> B) -> P -> bool; P1),
                                (hol: var G1 :: (A -> B) -> P -> A; G1),
                                (hol: var H1 :: (A -> B) -> P -> B; H1),
                                (hol: var P2 :: (A -> B) -> P -> bool; P2),
                                (hol: var G2 :: (A -> B) -> P -> A; G2),
                                (hol: var H2 :: (A -> B) -> P -> B; H2)
                              ]
                            )
                          ) then_tac \
                          REWRITE_TAC(
                            PairList [
                              TAUT(
                                (hol:
                                   var a1 :: bool
                                   var b1 :: bool
                                   var c1 :: bool
                                   var a2 :: bool
                                   var b2 :: bool
                                   var c2 :: bool
                                   var x :: bool
                                   a1 && (b1 && c1) ==> a2 && (b2 && c2) ==> x <=> a1 && a2 && (b1 && b2 && (c1 && c2)) ==> x)
                              )
                            ]
                          )
                        ) then_tac \
                        DISCH_THEN(
                          fun(th):
                            (
                              MAP_EVERY(EXISTS_TAC)(
                                PairList [
                                  (hol:
                                     var p :: (A -> B) -> P -> bool
                                     var P :: (A -> B) -> P -> bool
                                     var P2 :: (A -> B) -> P -> bool
                                     var P1 :: (A -> B) -> P -> bool
                                     fun (f :: A -> B, a :: P): if p(f, a) | (if P(f, a) | P2(f, a) | P1(f, a)) | #false),
                                  (hol:
                                     var p :: (A -> B) -> P -> bool
                                     var P :: (A -> B) -> P -> bool
                                     var G2 :: (A -> B) -> P -> A
                                     var G1 :: (A -> B) -> P -> A
                                     var z :: A
                                     fun (f :: A -> B, a :: P): if p(f, a) | (if P(f, a) | G2(f, a) | G1(f, a)) | z),
                                  (hol:
                                     var p :: (A -> B) -> P -> bool
                                     var P :: (A -> B) -> P -> bool
                                     var H2 :: (A -> B) -> P -> B
                                     var H1 :: (A -> B) -> P -> B
                                     var w :: B
                                     fun (f :: A -> B, a :: P): if p(f, a) | (if P(f, a) | H2(f, a) | H1(f, a)) | w)
                                ]
                              ) then_tac \
                              MP_TAC(th)
                            )
                        )
                      ) then_tac \
                      REWRITE_TAC(PairList [])
                    ) then_tac \
                    REPEAT((MATCH_MP_TAC(MONO_AND) then_tac CONJ_TAC))
                  ) then_list \
                  PairList [
                    ASM_MESON_TAC(PairList []),
                    POP_ASSUM_LIST(o(MP_TAC)(end_itlist(CONJ))),
                    ALL_TAC
                  ]
                ) then_tac \
                REWRITE_TAC(PairList [IMP_IMP, AND_FORALL_THM])
              ) then_tac \
              REPEAT((MATCH_MP_TAC(MONO_FORALL) then_tac GEN_TAC))
            ) then_tac \
            DISCH_THEN((fun(th): (DISCH_TAC then_tac MP_TAC(th))))
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def SUPERADMISSIBLE_MATCH_SEQPATTERN:
  prove(
    [
      (hol:
         const admissible :: (#{?138610} -> #{?138603} -> bool) -> ((#{?138610} -> #{?138606}) -> #{?138616} -> bool) -> (#{?138616} -> #{?138603}) -> ((#{?138610} -> #{?138606}) -> #{?138616} -> #{?138611}) -> bool
         const superadmissible :: (#{?138760} -> #{?138760} -> bool) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> bool) -> (#{?138768} -> #{?138760}) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> #{?138762}) -> bool
         const _MATCH :: A -> (A -> B -> bool) -> B
         const _SEQPATTERN :: (A -> B -> bool) -> (A -> B -> bool) -> A -> B -> bool
         forall (ll :: #{?140719} -> #{?140719} -> bool, p :: (#{?140719} -> #{?140835}) -> P -> bool, s :: P -> #{?140719}, c1 :: (#{?140719} -> #{?140835}) -> P -> #{?140834} -> #{?140835} -> bool, c2 :: (#{?140719} -> #{?140835}) -> P -> #{?140834} -> #{?140835} -> bool, e :: (#{?140719} -> #{?140835}) -> P -> #{?140834}):
           (admissible(
              ll,
              p,
              s,
              fun (f :: #{?140719} -> #{?140835}, x :: P):
                exists y :: #{?140835}: c1(f, x, e(f, x), y)
            )
              && (superadmissible(
                    ll,
                    fun (f :: #{?140719} -> #{?140835}, x :: P):
                      p(f, x) && (exists y :: #{?140835}: c1(f, x, e(f, x), y)),
                    s,
                    fun (f :: #{?140719} -> #{?140835}, x :: P): _MATCH(e(f, x), c1(f, x))
                  )
                    && superadmissible(
                         ll,
                         fun (f :: #{?140719} -> #{?140835}, x :: P):
                           p(f, x) && !(exists y :: #{?140835}: c1(f, x, e(f, x), y)),
                         s,
                         fun (f :: #{?140719} -> #{?140835}, x :: P): _MATCH(e(f, x), c2(f, x))
                       )))
             ==> superadmissible(
                   ll,
                   p,
                   s,
                   fun (f :: #{?140719} -> #{?140835}, x :: P):
                     _MATCH(e(f, x), _SEQPATTERN(c1(f, x), c2(f, x)))
                 )),
      REWRITE_TAC(PairList [MATCH_SEQPATTERN, SUPERADMISSIBLE_COND])
    ]
  )

def SUPERADMISSIBLE_MATCH_UNGUARDED_PATTERN:
  prove(
    [
      (hol:
         const superadmissible :: (#{?138760} -> #{?138760} -> bool) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> bool) -> (#{?138768} -> #{?138760}) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> #{?138762}) -> bool
         const _MATCH :: A -> (A -> B -> bool) -> B
         const _UNGUARDED_PATTERN :: bool -> bool -> bool
         const GEQ :: A -> A -> bool
         forall (ll :: A -> A -> bool, p :: (A -> B) -> P -> bool, s :: P -> A, e :: P -> D, pat :: Q -> D, arg :: P -> Q -> A):
           ((forall (f :: A -> B, a :: P, t :: Q, u :: Q):
               p(f, a) && (pat(t) == e(a) && pat(u) == e(a)) ==> arg(a, t) == arg(a, u))
              && (forall (f :: A -> B, a :: P, t :: Q):
                    p(f, a) && pat(t) == e(a) ==> (forall y :: A: ll(y, arg(a, t)) ==> ll(y, s(a)))))
             ==> superadmissible(
                   ll,
                   p,
                   s,
                   fun (f :: A -> B, x :: P):
                     _MATCH(
                       e(x),
                       fun (u :: D, v :: B):
                         exists t :: Q: _UNGUARDED_PATTERN(GEQ(pat(t), u), GEQ(f(arg(x, t)), v))
                     )
                 )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (REPEAT(GEN_TAC) then_tac STRIP_TAC) then_tac \
                          REWRITE_TAC(PairList [superadmissible])
                        ) then_tac \
                        DISCH_TAC
                      ) then_tac \
                      REWRITE_TAC(PairList [_UNGUARDED_PATTERN, GEQ_DEF, _MATCH])
                    ) then_tac \
                    REWRITE_TAC(PairList [tailadmissible])
                  ) then_tac \
                  SUBGOAL_THEN(
                    (hol:
                       var p :: (A -> B) -> P -> bool
                       var pat :: Q -> D
                       var e :: P -> D
                       var arg :: P -> Q -> A
                       forall (f :: A -> B, x :: P):
                         p(f, x)
                           ==> ((exists1 v :: B: exists t :: Q: pat(t) == e(x) && f(arg(x, t)) == v)
                                  <=> (exists t :: Q: pat(t) == e(x))))
                  )((fun(th): SIMP_TAC(PairList [th])))
                ) then_list \
                PairList [ASM_MESON_TAC(PairList []), ALL_TAC]
              ) then_tac \
              MAP_EVERY(EXISTS_TAC)(
                PairList [
                  (hol:
                     var p :: (A -> B) -> P -> bool
                     var pat :: Q -> D
                     var e :: P -> D
                     fun (f :: A -> B, x :: P): p(f, x) && (exists t :: Q: pat(t) == e(x))),
                  (hol:
                     var arg :: P -> Q -> A
                     var pat :: Q -> D
                     var e :: P -> D
                     const #{@} :: (A -> bool) -> A
                     fun (f :: A -> B, x :: P): arg(x, #{@}(fun (t :: Q): pat(t) == e(x)))),
                  (hol:
                     const #{@} :: (A -> bool) -> A
                     fun (f :: A -> B, x :: P): #{@}(fun (z :: B): #false))
                ]
              )
            ) then_tac \
            RULE_ASSUM_TAC(REWRITE_RULE(PairList [admissible]))
          ) then_tac \
          SIMP_TAC(PairList [])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def SUPERADMISSIBLE_MATCH_GUARDED_PATTERN:
  prove(
    [
      (hol:
         const superadmissible :: (#{?138760} -> #{?138760} -> bool) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> bool) -> (#{?138768} -> #{?138760}) -> ((#{?138760} -> #{?138762}) -> #{?138768} -> #{?138762}) -> bool
         const _MATCH :: A -> (A -> B -> bool) -> B
         const _GUARDED_PATTERN :: bool -> bool -> bool -> bool
         const GEQ :: A -> A -> bool
         forall (ll :: A -> A -> bool, p :: (A -> B) -> P -> bool, s :: P -> A, e :: P -> D, pat :: Q -> D, q :: P -> Q -> bool, arg :: P -> Q -> A):
           ((forall (f :: A -> B, a :: P, t :: Q, u :: Q):
               p(f, a) && (pat(t) == e(a) && (q(a, t) && (pat(u) == e(a) && q(a, u))))
                 ==> arg(a, t) == arg(a, u))
              && (forall (f :: A -> B, a :: P, t :: Q):
                    p(f, a) && (q(a, t) && pat(t) == e(a))
                      ==> (forall y :: A: ll(y, arg(a, t)) ==> ll(y, s(a)))))
             ==> superadmissible(
                   ll,
                   p,
                   s,
                   fun (f :: A -> B, x :: P):
                     _MATCH(
                       e(x),
                       fun (u :: D, v :: B):
                         exists t :: Q:
                           _GUARDED_PATTERN(GEQ(pat(t), u), q(x, t), GEQ(f(arg(x, t)), v))
                     )
                 )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (REPEAT(GEN_TAC) then_tac STRIP_TAC) then_tac \
                          REWRITE_TAC(PairList [superadmissible])
                        ) then_tac \
                        DISCH_TAC
                      ) then_tac \
                      REWRITE_TAC(PairList [_GUARDED_PATTERN, GEQ_DEF, _MATCH])
                    ) then_tac \
                    REWRITE_TAC(PairList [tailadmissible])
                  ) then_tac \
                  SUBGOAL_THEN(
                    (hol:
                       var p :: (A -> B) -> P -> bool
                       var pat :: Q -> D
                       var e :: P -> D
                       var q :: P -> Q -> bool
                       var arg :: P -> Q -> A
                       forall (f :: A -> B, x :: P):
                         p(f, x)
                           ==> ((exists1 v :: B: exists t :: Q: pat(t) == e(x) && (q(x, t) && f(arg(x, t)) == v))
                                  <=> (exists t :: Q: pat(t) == e(x) && q(x, t))))
                  )((fun(th): SIMP_TAC(PairList [th])))
                ) then_list \
                PairList [ASM_MESON_TAC(PairList []), ALL_TAC]
              ) then_tac \
              MAP_EVERY(EXISTS_TAC)(
                PairList [
                  (hol:
                     var p :: (A -> B) -> P -> bool
                     var pat :: Q -> D
                     var e :: P -> D
                     var q :: P -> Q -> bool
                     fun (f :: A -> B, x :: P): p(f, x) && (exists t :: Q: pat(t) == e(x) && q(x, t))),
                  (hol:
                     var arg :: P -> Q -> A
                     var pat :: Q -> D
                     var e :: P -> D
                     var q :: P -> Q -> bool
                     const #{@} :: (A -> bool) -> A
                     fun (f :: A -> B, x :: P): arg(x, #{@}(fun (t :: Q): pat(t) == e(x) && q(x, t)))),
                  (hol:
                     const #{@} :: (A -> bool) -> A
                     fun (f :: A -> B, x :: P): #{@}(fun (z :: B): #false))
                ]
              )
            ) then_tac \
            RULE_ASSUM_TAC(REWRITE_RULE(PairList [admissible]))
          ) then_tac \
          SIMP_TAC(PairList [])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

// Use the same relation variable as WF_REC_CASES; MATCH_MP_TAC leaves it free.
def define_WF_REC_TAIL_GENERAL_prime:
  prove(
    [
      (hol:
         var ll :: #{?141472} -> #{?141472} -> bool
         const WF :: (A -> A -> bool) -> bool
         forall (P :: (#{?141472} -> #{?141469}) -> #{?141472} -> bool, G :: (#{?141472} -> #{?141469}) -> #{?141472} -> #{?141472}, H :: (#{?141472} -> #{?141469}) -> #{?141472} -> #{?141469}, H_prime :: (#{?141472} -> #{?141469}) -> #{?141472} -> #{?141469}):
           (WF(ll)
              && ((forall (f :: #{?141472} -> #{?141469}, g :: #{?141472} -> #{?141469}, x :: #{?141472}):
                     (forall z :: #{?141472}: ll(z, x) ==> f(z) == g(z))
                       ==> ((P(f, x) <=> P(g, x))
                              && (G(f, x) == G(g, x) && H_prime(f, x) == H_prime(g, x))))
                    && ((forall (f :: #{?141472} -> #{?141469}, x :: #{?141472}, y :: #{?141472}):
                           P(f, x) && ll(y, G(f, x)) ==> ll(y, x))
                          && (forall (f :: #{?141472} -> #{?141469}, x :: #{?141472}):
                                H(f, x) == (if P(f, x) | f(G(f, x)) | H_prime(f, x))))))
             ==> (exists f :: #{?141472} -> #{?141469}: forall x :: #{?141472}: f(x) == H(f, x))),
      (
        (
          (REPEAT(STRIP_TAC) then_tac ASM_REWRITE_TAC(PairList [])) then_tac \
          MATCH_MP_TAC(WF_REC_TAIL_GENERAL)
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def WF_REC_CASES:
  prove(
    [
      (hol:
         const WF :: (A -> A -> bool) -> bool
         const ALL :: (A -> bool) -> list(A) -> bool
         const GABS :: (A -> bool) -> A
         const GEQ :: A -> A -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         const CASEWISE :: list(pair(#{?138308} -> #{?138312}, #{?138313} -> #{?138308} -> #{?138272})) -> #{?138313} -> #{?138312} -> #{?138272}
         forall (ll :: A -> A -> bool, clauses :: list(pair(P -> A, (A -> B) -> P -> B))):
           (WF(ll)
              && ALL(
                   GABS(
                     fun (f :: pair(P -> A, (A -> B) -> P -> B) -> bool):
                       forall (s :: P -> A, t :: (A -> B) -> P -> B):
                         GEQ(
                           f(#{|,|}(s, t)),
                           exists (P :: (A -> B) -> P -> bool, G :: (A -> B) -> P -> A, H :: (A -> B) -> P -> B):
                             (forall (f :: A -> B, a :: P, y :: A):
                                P(f, a) && ll(y, G(f, a)) ==> ll(y, s(a)))
                               && ((forall (f :: A -> B, g :: A -> B, a :: P):
                                      (forall z :: A: ll(z, s(a)) ==> f(z) == g(z))
                                        ==> ((P(f, a) <=> P(g, a))
                                               && (G(f, a) == G(g, a) && H(f, a) == H(g, a))))
                                     && (forall (f :: A -> B, a :: P):
                                           t(f, a) == (if P(f, a) | f(G(f, a)) | H(f, a))))
                         )
                   ),
                   clauses
                 ))
             ==> (exists f :: A -> B: forall x :: A: f(x) == CASEWISE(clauses, f, x))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            (
                                              (
                                                (
                                                  REPEAT(STRIP_TAC) then_tac \
                                                  MATCH_MP_TAC(define_WF_REC_TAIL_GENERAL_prime)
                                                ) then_tac \
                                                FIRST_X_ASSUM(o(MP_TAC)(check(o(is_binary("ALL"))(concl))))
                                              ) then_tac \
                                              SPEC_TAC(
                                                [
                                                  (hol: var clauses :: list(pair(P -> A, (A -> B) -> P -> B)); clauses),
                                                  (hol: var clauses :: list(pair(P -> A, (A -> B) -> P -> B)); clauses)
                                                ]
                                              )
                                            ) then_tac \
                                            ASM_REWRITE_TAC(PairList [])
                                          ) then_tac \
                                          POP_ASSUM(K(ALL_TAC))
                                        ) then_tac \
                                        MATCH_MP_TAC(list_INDUCT)
                                      ) then_tac \
                                      REWRITE_TAC(PairList [ALL, CASEWISE, FORALL_PAIR_THM])
                                    ) then_tac \
                                    CONJ_TAC
                                  ) then_list \
                                  PairList [
                                    (
                                      MAP_EVERY(EXISTS_TAC)(
                                        PairList [
                                          (hol:
                                             fun (f :: A -> B, x :: A): #false),
                                          (hol:
                                             var anything :: A -> A
                                             fun (f :: A -> B): anything),
                                          (hol:
                                             const #{@} :: (A -> bool) -> A
                                             fun (f :: A -> B, x :: A): #{@}(fun (y :: B): #true))
                                        ]
                                      ) then_tac \
                                      REWRITE_TAC(PairList [])
                                    ),
                                    ALL_TAC
                                  ]
                                ) then_tac \
                                MAP_EVERY(X_GEN_TAC)(
                                  PairList [
                                    (hol: var s :: P -> A; s),
                                    (hol: var t :: (A -> B) -> P -> B; t),
                                    (hol: var clauses :: list(pair(P -> A, (A -> B) -> P -> B)); clauses)
                                  ]
                                )
                              ) then_tac \
                              DISCH_THEN(
                                fun(th):
                                  (
                                    DISCH_THEN(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC)) then_tac \
                                    MP_TAC(th)
                                  )
                              )
                            ) then_tac \
                            ASM_REWRITE_TAC(PairList [])
                          ) then_tac \
                          POP_ASSUM_LIST(K(ALL_TAC))
                        ) then_tac \
                        REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM])
                      ) then_tac \
                      REWRITE_TAC(PairList [RIGHT_IMP_FORALL_THM])
                    ) then_tac \
                    MAP_EVERY(X_GEN_TAC)(
                      PairList [
