def CASEWISE_DEF:
  new_recursive_definition(list_RECURSION)(
    @hol|{(CASEWISE [] f x = @y. T) /\
       (CASEWISE (CONS h t) f x =
             if ?y. FST h y = x then SND h f (@y. FST h y = x)
             else CASEWISE t f x)}|
  )

def CASEWISE:
  prove(
    [
      @hol|{(CASEWISE [] f x = @y. T) /\
         (CASEWISE (CONS (s,t) clauses) f x =
              if ?y. s y = x then t f (@y. s y = x) else CASEWISE clauses f x)}|,
      REWRITE_TAC(PairList [CASEWISE_DEF])
    ]
  )

def CASEWISE_CASES:
  prove(
    [
      @hol|{!clauses c x.
         (?s t a. MEM (s,t) clauses /\ (s a = x) /\
                  (CASEWISE clauses c x = t c a)) \/
         ~(?s t a. MEM (s,t) clauses /\ (s a = x)) /\
         (CASEWISE clauses c x = @y. T)}|,
      MATCH_MP_TAC(list_INDUCT) then_tac \
      REWRITE_TAC(PairList [MEM, CASEWISE, FORALL_PAIR_THM, PAIR_EQ]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      COND_CASES_TAC then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def CASEWISE_WORKS:
  prove(
    [
      @hol|{!clauses c:C.
         (!s t s' t' x y. MEM (s,t) clauses /\ MEM (s',t') clauses /\ (s x = s' y)
                          ==> (t c x = t' c y))
         ==> ALL (\(s:P->A,t). !x. CASEWISE clauses c (s x) :B = t c x) clauses}|,
      REWRITE_TAC(PairList [GSYM(ALL_MEM), FORALL_PAIR_THM]) then_tac \
      MESON_TAC(PairList [CASEWISE_CASES])
    ]
  )

def admissible:
  new_definition(
    @hol|{admissible(<<) p s t <=>
       !f g a. p f a /\ p g a /\ (!z. z << s(a) ==> (f z = g z))
               ==> (t f a = t g a)}|
  )

def tailadmissible:
  new_definition(
    @hol|{tailadmissible(<<) p s t <=>
       ?P G H. (!f a y. P f a /\ y << G f a ==> y << s a) /\
               (!f g a. (!z. z << s(a) ==> (f z = g z))
                        ==> (P f a = P g a) /\
                            (G f a = G g a) /\ (H f a = H g a)) /\
               (!f a:P. p f a ==> (t (f:A->B) a =
                                   if P f a then f(G f a) else H f a))}|
  )

def superadmissible:
  new_definition(
    @hol|{superadmissible(<<) p s t <=>
       admissible(<<) (\f a. T) s p ==> tailadmissible(<<) p s t}|
  )

def MATCH_SEQPATTERN:
  prove(
    [
      @hol|{_MATCH x (_SEQPATTERN r s) =
         if ?y. r x y then _MATCH x r else _MATCH x s}|,
      REWRITE_TAC(PairList [_MATCH, _SEQPATTERN]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_CONST:
  prove(
    [
      @hol|{!p s c. admissible(<<) p s (\f. c)}|,
      REWRITE_TAC(PairList [admissible])
    ]
  )

def ADMISSIBLE_BASE:
  prove(
    [
      @hol|{!(<<) p s t.
         (!f a. p f a ==> t a << s a)
         ==> admissible((<<):A->A->bool) p s (\f:A->B x:P. f(t x))}|,
      REWRITE_TAC(PairList [admissible]) then_tac MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_COMB:
  prove(
    [
      @hol|{!(<<) p s:P->A g:(A->B)->P->C->D y:(A->B)->P->C.
         admissible(<<) p s g /\ admissible(<<) p s y
         ==> admissible(<<) p s (\f x. (g f x) (y f x))}|,
      SIMP_TAC(PairList [admissible]) then_tac MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_RAND:
  prove(
    [
      @hol|{!(<<) p s:P->A g:P->C->D y:(A->B)->P->C.
         admissible(<<) p s y
         ==> admissible(<<) p s (\f x. (g x) (y f x))}|,
      SIMP_TAC(PairList [admissible]) then_tac MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_LAMBDA:
  prove(
    [
      @hol|{!(<<) p s:P->A t:(A->B)->C->P->bool.
         admissible(<<) (\f (u,x). p f x) (\(u,x). s x) (\f (u,x). t f u x)
         ==> admissible(<<) p s (\f x. \u. t f u x)}|,
      REWRITE_TAC(PairList [admissible, FUN_EQ_THM, FORALL_PAIR_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_NEST:
  prove(
    [
      @hol|{!(<<) p s t.
         admissible(<<) p s t /\
         (!f a. p f a ==> t f a << s a)
         ==> admissible((<<):A->A->bool) p s (\f:A->B x:P. f(t f x))}|,
      REWRITE_TAC(PairList [admissible]) then_tac MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_COND:
  prove(
    [
      @hol|{!(<<) p P s h k.
         admissible(<<) p s P /\
         admissible(<<) (\f x. p f x /\ P f x) s h /\
         admissible(<<) (\f x. p f x /\ ~P f x) s k
         ==> admissible(<<) p s (\f x:P. if P f x then h f x else k f x)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [admissible, AND_FORALL_THM]) then_tac \
      REPEAT(MATCH_MP_TAC(MONO_FORALL) then_tac GEN_TAC) then_tac \
      DISCH_THEN((fun(th): (STRIP_TAC then_tac MP_TAC(th)))) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_MATCH:
  prove(
    [
      @hol|{!(<<) p s e c.
         admissible(<<) p s e /\ admissible(<<) p s (\f x. c f x (e f x))
         ==> admissible(<<) p s (\f x:P. _MATCH (e f x) (c f x))}|,
      REWRITE_TAC(PairList [admissible, _MATCH]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      REPEAT(COND_CASES_TAC) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_SEQPATTERN:
  prove(
    [
      @hol|{!(<<) p s c1 c2 e.
         admissible(<<) p s (\f x:P. ?y. c1 f x (e f x) y) /\
         admissible(<<) (\f x. p f x /\ ?y. c1 f x (e f x) y) s
                        (\f x. c1 f x (e f x)) /\
         admissible(<<) (\f x. p f x /\ ~(?y. c1 f x (e f x) y)) s
                        (\f x. c2 f x (e f x))
         ==> admissible(<<) p s (\f x. _SEQPATTERN (c1 f x) (c2 f x) (e f x))}|,
      REWRITE_TAC(PairList [_SEQPATTERN, admissible]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_UNGUARDED_PATTERN:
  prove(
    [
      @hol|{!(<<) p s pat e t y.
         admissible (<<) p s pat /\
         admissible (<<) p s e /\
         admissible (<<) (\f x. p f x /\ pat f x = e f x) s t /\
         admissible (<<) (\f x. p f x /\ pat f x = e f x) s y
           ==> admissible(<<) p s
                (\f x:P. _UNGUARDED_PATTERN (GEQ (pat f x) (e f x))
                                            (GEQ (t f x) (y f x)))}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [admissible, FORALL_PAIR_THM, _UNGUARDED_PATTERN]) then_tac \
      REWRITE_TAC(PairList [GEQ_DEF]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(
        TAUT(
          @hol|{(a <=> a') /\ (a /\ a' ==> (b <=> b'))
             ==> (a /\ b <=> a' /\ b')}|
        )
      ) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_GUARDED_PATTERN:
  prove(
    [
      @hol|{!(<<) p s pat q e t y.
         admissible (<<) p s pat /\
         admissible (<<) p s e /\
         admissible (<<) (\f x. p f x /\ pat f x = e f x /\ q f x) s t /\
         admissible (<<) (\f x. p f x /\ pat f x = e f x) s q /\
         admissible (<<) (\f x. p f x /\ pat f x = e f x /\ q f x) s y
           ==> admissible(<<) p s
                (\f x:P. _GUARDED_PATTERN (GEQ (pat f x) (e f x))
                                          (q f x)
                                          (GEQ (t f x) (y f x)))}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [admissible, FORALL_PAIR_THM, _GUARDED_PATTERN]) then_tac \
      REWRITE_TAC(PairList [GEQ_DEF]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      REPEAT(
        MATCH_MP_TAC(
          TAUT(
            @hol|{(a <=> a') /\ (a /\ a' ==> (b <=> b'))
               ==> (a /\ b <=> a' /\ b')}|
          )
        ) then_tac \
        REPEAT(STRIP_TAC)
      ) then_tac \
      TRY(
        MATCH_MP_TAC(
          MESON(
            PairList [])(
            @hol|{x = x' /\ y = y' ==> (x = y <=> x' = y')}|
          )
        )
      ) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_NSUM:
  prove(
    [
      @hol|{!(<<) p:(B->C)->P->bool s:P->A h a b.
              admissible(<<) (\f (k,x). a(x) <= k /\ k <= b(x) /\ p f x)
                             (\(k,x). s x) (\f (k,x). h f x k)
         ==> admissible(<<) p s (\f x. nsum(a(x)..b(x)) (h f x))}|,
      REWRITE_TAC(PairList [admissible, FORALL_PAIR_THM]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(NSUM_EQ_NUMSEG) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_SUM:
  prove(
    [
      @hol|{!(<<) p:(B->C)->P->bool s:P->A h a b.
              admissible(<<) (\f (k,x). a(x) <= k /\ k <= b(x) /\ p f x)
                             (\(k,x). s x) (\f (k,x). h f x k)
         ==> admissible(<<) p s (\f x. sum(a(x)..b(x)) (h f x))}|,
      REWRITE_TAC(PairList [admissible, FORALL_PAIR_THM]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(SUM_EQ_NUMSEG) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_MAP:
  prove(
    [
      @hol|{!(<<) p s h l.
              admissible(<<) p s l /\
              admissible (<<) (\f (y,x). p f x /\ MEM y (l f x))
                              (\(y,x). s x) (\f (y,x). h f x y)
         ==> admissible (<<) p s (\f:A->B x:P. MAP (h f x) (l f x))}|,
      REWRITE_TAC(PairList [admissible, FORALL_PAIR_THM]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [])(
          @hol|{x = y /\ MAP f x = MAP g x ==> MAP f x = MAP g y}|
        )
      ) then_tac \
      CONJ_TAC then_list \
      PairList [ASM_MESON_TAC(PairList []), ALL_TAC] then_tac \
      MATCH_MP_TAC(MAP_EQ) then_tac \
      REWRITE_TAC(PairList [GSYM(ALL_MEM)]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [FORALL_PAIR_THM]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ADMISSIBLE_MATCH_SEQPATTERN:
  prove(
    [
      @hol|{!(<<) p s c1 c2 e.
         admissible(<<) p s (\f x. ?y. c1 f x (e f x) y) /\
         admissible(<<) (\f x. p f x /\ ?y. c1 f x (e f x) y) s
                        (\f x. _MATCH (e f x) (c1 f x)) /\
         admissible(<<) (\f x. p f x /\ ~(?y. c1 f x (e f x) y)) s
                        (\f x. _MATCH (e f x) (c2 f x))
         ==> admissible(<<) p s
               (\f x:P. _MATCH (e f x) (_SEQPATTERN (c1 f x) (c2 f x)))}|,
      REWRITE_TAC(PairList [MATCH_SEQPATTERN, ADMISSIBLE_COND])
    ]
  )

def ADMISSIBLE_IMP_SUPERADMISSIBLE:
  prove(
    [
      @hol|{!(<<) p s t:(A->B)->P->B.
         admissible(<<) p s t ==> superadmissible(<<) p s t}|,
      REWRITE_TAC(PairList [admissible, superadmissible, tailadmissible]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MAP_EVERY(EXISTS_TAC)(
        PairList [
          @hol|{\f:A->B x:P. F}|,
          @hol|{\f:A->B. (anything:P->A)}|,
          @hol|{\f:A->B a:P. if p f a then t f a :B else fixed}|
        ]
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def SUPERADMISSIBLE_CONST:
  prove(
    [
      @hol|{!p s c. superadmissible(<<) p s (\f. c)}|,
      REPEAT(GEN_TAC) then_tac MATCH_MP_TAC(ADMISSIBLE_IMP_SUPERADMISSIBLE) then_tac \
      REWRITE_TAC(PairList [ADMISSIBLE_CONST])
    ]
  )

def SUPERADMISSIBLE_TAIL:
  prove(
    [
      @hol|{!(<<) p s t:(A->B)->P->A.
         admissible(<<) p s t /\
         (!f a. p f a ==> !y. y << t f a ==> y << s a)
         ==> superadmissible(<<) p s (\f x. f(t f x))}|,
      REWRITE_TAC(PairList [admissible, superadmissible, tailadmissible]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MAP_EVERY(EXISTS_TAC)(
        PairList [
          @hol|{\f:A->B x:P. T}|,
          @hol|{\f:A->B a:P. if p f a then t f a :A else s a}|,
          @hol|{\f:A->B. anything:P->B}|
        ]
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def SUPERADMISSIBLE_COND:
  prove(
    [
      @hol|{!(<<) p P s h k:(A->B)->P->B.
         admissible(<<) p s P /\
         superadmissible(<<) (\f x. p f x /\ P f x) s h /\
         superadmissible(<<) (\f x. p f x /\ ~P f x) s k
         ==> superadmissible(<<) p s (\f x. if P f x then h f x else k f x)}|,
      REWRITE_TAC(PairList [superadmissible, admissible]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC)) then_tac \
      DISCH_THEN((fun(th): (DISCH_TAC then_tac CONJUNCTS_THEN(MP_TAC)(th)))) then_tac \
      ANTS_TAC then_list \
      PairList [ASM_MESON_TAC(PairList []), ALL_TAC] then_tac \
      DISCH_THEN(
        (fun(th): (ANTS_TAC then_list PairList [ASM_MESON_TAC(PairList []), MP_TAC(th)]))
      ) then_tac \
      REWRITE_TAC(PairList [tailadmissible]) then_tac \
      REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM, RIGHT_IMP_FORALL_THM]) then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{P1:(A->B)->P->bool}|,
          @hol|{G1:(A->B)->P->A}|,
          @hol|{H1:(A->B)->P->B}|,
          @hol|{P2:(A->B)->P->bool}|,
          @hol|{G2:(A->B)->P->A}|,
          @hol|{H2:(A->B)->P->B}|
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{(a1 /\ b1 /\ c1 ==> a2 /\ b2 /\ c2 ==> x) <=>
               (a1 /\ a2) /\ (b1 /\ b2) /\ (c1 /\ c2) ==> x}|
          )
        ]
      ) then_tac \
      DISCH_THEN(
        fun(th):
          (
            MAP_EVERY(EXISTS_TAC)(
              PairList [
                @hol|{\f:A->B a:P. if p f a then if P f a then P2 f a else P1 f a else F}|,
                @hol|{\f:A->B a:P. if p f a then if P f a then G2 f a else G1 f a else z:A}|,
                @hol|{\f:A->B a:P. if p f a then if P f a then H2 f a else H1 f a else w:B}|
              ]
            ) then_tac \
            MP_TAC(th)
          )
      ) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      REPEAT(MATCH_MP_TAC(MONO_AND) then_tac CONJ_TAC) then_list \
      PairList [
        ASM_MESON_TAC(PairList []),
        POP_ASSUM_LIST(o(MP_TAC)(end_itlist(CONJ))),
        ALL_TAC
      ] then_tac \
      REWRITE_TAC(PairList [IMP_IMP, AND_FORALL_THM]) then_tac \
      REPEAT(MATCH_MP_TAC(MONO_FORALL) then_tac GEN_TAC) then_tac \
      DISCH_THEN((fun(th): (DISCH_TAC then_tac MP_TAC(th)))) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def SUPERADMISSIBLE_MATCH_SEQPATTERN:
  prove(
    [
      @hol|{!(<<) p s c1 c2 e.
         admissible(<<) p s (\f x. ?y. c1 f x (e f x) y) /\
         superadmissible(<<) (\f x. p f x /\ ?y. c1 f x (e f x) y) s
                             (\f x. _MATCH (e f x) (c1 f x)) /\
         superadmissible(<<) (\f x. p f x /\ ~(?y. c1 f x (e f x) y)) s
                             (\f x. _MATCH (e f x) (c2 f x))
         ==> superadmissible(<<) p s
               (\f x:P. _MATCH (e f x) (_SEQPATTERN (c1 f x) (c2 f x)))}|,
      REWRITE_TAC(PairList [MATCH_SEQPATTERN, SUPERADMISSIBLE_COND])
    ]
  )

def SUPERADMISSIBLE_MATCH_UNGUARDED_PATTERN:
  prove(
    [
      @hol|{!(<<) p s e:P->D pat:Q->D arg.
         (!f a t u. p f a /\ pat t = e a /\ pat u = e a ==> arg a t = arg a u) /\
         (!f a t. p f a /\ pat t = e a ==> !y. y << arg a t ==> y << s a)
         ==> superadmissible(<<) p s
              (\f:A->B x. _MATCH (e x)
                       (\u v. ?t. _UNGUARDED_PATTERN (GEQ (pat t) u)
                                                     (GEQ (f(arg x t)) v)))}|,
      REPEAT(GEN_TAC) then_tac STRIP_TAC then_tac \
      REWRITE_TAC(PairList [superadmissible]) then_tac \
      DISCH_TAC then_tac \
      REWRITE_TAC(PairList [_UNGUARDED_PATTERN, GEQ_DEF, _MATCH]) then_tac \
      REWRITE_TAC(PairList [tailadmissible]) then_tac \
      SUBGOAL_THEN(
        @hol|{!f:A->B x:P.
           p f x ==> ((?!v. ?t:Q. pat t:D = e x /\ f(arg x t) = v) <=>
                      ?t. pat t = e x)}|
      )((fun(th): SIMP_TAC(PairList [th]))) then_list \
      PairList [ASM_MESON_TAC(PairList []), ALL_TAC] then_tac \
      MAP_EVERY(EXISTS_TAC)(
        PairList [
          @hol|{\(f:A->B) x:P. p f x /\ ?t:Q. pat t:D = e x}|,
          @hol|{\f:A->B x:P. arg x (@t. (pat:Q->D) t = e x):A}|,
          @hol|{\(f:A->B) x:P. (@z:B. F)}|
        ]
      ) then_tac \
      RULE_ASSUM_TAC(REWRITE_RULE(PairList [admissible])) then_tac \
      SIMP_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def SUPERADMISSIBLE_MATCH_GUARDED_PATTERN:
  prove(
    [
      @hol|{!(<<) p s e:P->D pat:Q->D q arg.
         (!f a t u. p f a /\ pat t = e a /\ q a t /\ pat u = e a /\ q a u
                    ==> arg a t = arg a u) /\
         (!f a t. p f a /\ q a t /\ pat t = e a ==> !y. y << arg a t ==> y << s a)
         ==> superadmissible(<<) p s
              (\f:A->B x. _MATCH (e x)
                       (\u v. ?t. _GUARDED_PATTERN (GEQ (pat t) u)
                                                   (q x t)
                                                   (GEQ (f(arg x t)) v)))}|,
      REPEAT(GEN_TAC) then_tac STRIP_TAC then_tac \
      REWRITE_TAC(PairList [superadmissible]) then_tac \
      DISCH_TAC then_tac \
      REWRITE_TAC(PairList [_GUARDED_PATTERN, GEQ_DEF, _MATCH]) then_tac \
      REWRITE_TAC(PairList [tailadmissible]) then_tac \
      SUBGOAL_THEN(
        @hol|{!f:A->B x:P.
           p f x ==> ((?!v. ?t:Q. pat t:D = e x /\ q x t /\ f(arg x t) = v) <=>
                      ?t. pat t = e x /\ q x t)}|
      )((fun(th): SIMP_TAC(PairList [th]))) then_list \
      PairList [ASM_MESON_TAC(PairList []), ALL_TAC] then_tac \
      MAP_EVERY(EXISTS_TAC)(
        PairList [
          @hol|{\(f:A->B) x:P. p f x /\ ?t:Q. pat t:D = e x /\ q x t}|,
          @hol|{\f:A->B x:P. arg x (@t. (pat:Q->D) t = e x /\ q x t):A}|,
          @hol|{\(f:A->B) x:P. (@z:B. F)}|
        ]
      ) then_tac \
      RULE_ASSUM_TAC(REWRITE_RULE(PairList [admissible])) then_tac \
      SIMP_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def define_WF_REC_TAIL_GENERAL_prime:
  prove(
    [
      @hol|{!P G H H'.
         WF (<<) /\
         (!f g x. (!z. z << x ==> (f z = g z))
                  ==> (P f x <=> P g x) /\
                      (G f x = G g x) /\ (H' f x = H' g x)) /\
         (!f x y. P f x /\ y << G f x ==> y << x) /\
         (!f x. H f x = if P f x then f(G f x) else H' f x)
         ==> ?f. !x. f x = H f x}|,
      REPEAT(STRIP_TAC) then_tac ASM_REWRITE_TAC(PairList []) then_tac \
      MATCH_MP_TAC(WF_REC_TAIL_GENERAL) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def WF_REC_CASES:
  prove(
    [
      @hol|{!(<<) clauses.
         WF((<<):A->A->bool) /\
         ALL (\(s,t). ?P G H.
                      (!f a y. P f a /\ y << G f a ==> y << s a) /\
                      (!f g a. (!z. z << s(a) ==> (f z = g z))
                               ==> (P f a = P g a) /\
                                   (G f a = G g a) /\ (H f a = H g a)) /\
                      (!f a:P. t f a = if P f a then f(G f a) else H f a))
             clauses
         ==> ?f:A->B. !x. f x = CASEWISE clauses f x}|,
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(define_WF_REC_TAIL_GENERAL_prime) then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(check(o(is_binary("ALL"))(concl)))) then_tac \
      SPEC_TAC(
        [
          @hol|{clauses:((P->A)#((A->B)->P->B))list}|,
          @hol|{clauses:((P->A)#((A->B)->P->B))list}|
        ]
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      POP_ASSUM(K(ALL_TAC)) then_tac \
      MATCH_MP_TAC(list_INDUCT) then_tac \
      REWRITE_TAC(PairList [ALL, CASEWISE, FORALL_PAIR_THM]) then_tac \
      CONJ_TAC then_list \
      PairList [
        MAP_EVERY(EXISTS_TAC)(
          PairList [
            @hol|{\f:A->B x:A. F}|,
            @hol|{\f:A->B. anything:A->A}|,
            @hol|{\f:A->B x:A. @y:B. T}|
          ]
        ) then_tac \
        REWRITE_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{s:P->A}|,
          @hol|{t:(A->B)->P->B}|,
          @hol|{clauses:((P->A)#((A->B)->P->B))list}|
        ]
      ) then_tac \
      DISCH_THEN(
        fun(th):
          (
            DISCH_THEN(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC)) then_tac \
            MP_TAC(th)
          )
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      POP_ASSUM_LIST(K(ALL_TAC)) then_tac \
      REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac \
      REWRITE_TAC(PairList [RIGHT_IMP_FORALL_THM]) then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{P1:(A->B)->A->bool}|,
          @hol|{G1:(A->B)->A->A}|,
          @hol|{H1:(A->B)->A->B}|,
          @hol|{P2:(A->B)->P->bool}|,
          @hol|{G2:(A->B)->P->A}|,
          @hol|{H2:(A->B)->P->B}|
        ]
      ) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      EXISTS_TAC(
        @hol|{\f:A->B x:A. if ?y:P. s y = x then P2 f (@y. s y = x) else P1 f x:bool}|
      ) then_tac \
      EXISTS_TAC(
        @hol|{\f:A->B x:A.
           if ?y:P. s y = x then G2 f (@y. s y = x) else G1 f x:A}|
      ) then_tac \
      EXISTS_TAC(
        @hol|{\f:A->B x:A. if ?y:P. s y = x
           then H2 f (@y. s y = x) else H1 f x:B}|
      ) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def define_WF_REC_CASES_prime:
  prove(
    [
      @hol|{!(<<) clauses.
         WF((<<):A->A->bool) /\
         ALL (\(s,t). tailadmissible(<<) (\f a. T) s t) clauses
         ==> ?f:A->B. !x. f x = CASEWISE clauses f x}|,
      REWRITE_TAC(PairList [WF_REC_CASES, tailadmissible])
    ]
  )

def RECURSION_CASEWISE:
  prove(
    [
      @hol|{!clauses.
         (?(<<). WF(<<) /\
                 ALL (\(s:P->A,t). tailadmissible(<<) (\f a. T) s t) clauses) /\
         (!s t s' t' f x y. MEM (s,t) clauses /\ MEM (s',t') clauses
                            ==> (s x = s' y) ==> (t f x = t' f y))
         ==> ?f:A->B. ALL (\(s,t). !x. f (s x) = t f x) clauses}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [IMP_IMP, CONJ_ASSOC]) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC)) then_tac \
      DISCH_THEN(CHOOSE_THEN(o(MP_TAC)(MATCH_MP(define_WF_REC_CASES_prime)))) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [CASEWISE_WORKS])
    ]
  )

def RECURSION_CASEWISE_PAIRWISE:
  let lemma:
    prove(
      [
        @hol|{!P. (!x y. P x y ==> P y x)
           ==> !l. (!x y. MEM x l /\ MEM y l ==> P x y) <=>
                   ALL (\x. P x x) l /\ PAIRWISE P l}|,
        REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM, GSYM(ALL_MEM)]) then_tac \
        REPEAT(GEN_TAC) then_tac \
        DISCH_TAC then_tac \
        LIST_INDUCT_TAC then_tac \
        REWRITE_TAC(PairList [PAIRWISE, MEM, GSYM(ALL_MEM)]) then_tac \
        ASM_MESON_TAC(PairList [])
      ]
    )
  let paired_lambda:
    prove(
      [
        @hol|{(\x. P x) = (\(a,b). P (a,b))}|,
        REWRITE_TAC(PairList [FUN_EQ_THM, FORALL_PAIR_THM])
      ]
    )
  let pth:
    REWRITE_RULE(PairList [FORALL_PAIR_THM, paired_lambda])(
      ISPEC(
        @hol|{\(s,t) (s',t'). !c x:A y:A. (s x = s' y) ==> (t c x = t' c y)}|)(
        lemma
      )
    )
  let cth = prove([lhand(concl(pth)), MESON_TAC(PairList [])])
  prove(
    [
      @hol|{!clauses.
         (?(<<). WF (<<) /\
                 ALL (\(s,t). tailadmissible(<<) (\f a. T) s t) clauses) /\
         ALL (\(s,t). !f x y. (s x = s y) ==> (t f x = t f y)) clauses /\
         PAIRWISE (\(s,t) (s',t'). !f x y. (s x = s' y) ==> (t f x = t' f y))
                  clauses
         ==> (?f. ALL (\(s,t). !x. f (s x) = t f x) clauses)}|,
      REWRITE_TAC(PairList [GSYM(MATCH_MP(pth)(cth)), RIGHT_IMP_FORALL_THM]) then_tac \
      REWRITE_TAC(PairList [RECURSION_CASEWISE])
    ]
  )

def SUPERADMISSIBLE_T:
  prove(
    [
      @hol|{superadmissible(<<) (\f x. T) s t <=> tailadmissible(<<) (\f x. T) s t}|,
      REWRITE_TAC(PairList [superadmissible, admissible])
    ]
  )

def RECURSION_SUPERADMISSIBLE = REWRITE_RULE(PairList [GSYM(SUPERADMISSIBLE_T)])(RECURSION_CASEWISE_PAIRWISE)

def [define_instantiate_casewise_recursion_v2, define_pure_prove_recursive_function_exists_v2, prove_general_recursive_function_exists]:
  let LSYM = o(o(GEN_ALL)(CONV_RULE(LAND_CONV(ONCE_DEPTH_CONV(SYM_CONV)))))(SPEC_ALL)
  let evensimps:
    prove(
      [
        @hol|{((2 * m + 2 = 2 * n + 1) <=> F) /\
           ((2 * m + 1 = 2 * n + 2) <=> F) /\
           ((2 * m = 2 * n + 1) <=> F) /\
           ((2 * m + 1 = 2 * n) <=> F) /\
           ((2 * m = SUC(2 * n)) <=> F) /\
           ((SUC(2 * m) = 2 * n) <=> F)}|,
        REWRITE_TAC(PairList []) then_tac REPEAT(CONJ_TAC) then_tac \
        DISCH_THEN(o(MP_TAC)(AP_TERM(@hol|{EVEN}|))) then_tac \
        REWRITE_TAC(PairList [EVEN_MULT, EVEN_ADD, ARITH, EVEN])
      ]
    )
  let allsimps:
    itlist(mk_rewrites(#false))(
      PairList [
        EQ_ADD_RCANCEL,
        EQ_ADD_LCANCEL,
        EQ_ADD_RCANCEL_0,
        EQ_ADD_LCANCEL_0,
        LSYM(EQ_ADD_RCANCEL_0),
        LSYM(EQ_ADD_LCANCEL_0),
        EQ_MULT_RCANCEL,
        EQ_MULT_LCANCEL,
        EQT_INTRO(SPEC_ALL(EQ_REFL)),
        ADD_EQ_0,
        LSYM(ADD_EQ_0),
        MULT_EQ_0,
        LSYM(MULT_EQ_0),
        MULT_EQ_1,
        LSYM(MULT_EQ_1),
        ARITH_RULE(
          @hol|{(m + n = 1) <=> (m = 1) /\ (n = 0) \/ (m = 0) /\ (n = 1)}|
        ),
        ARITH_RULE(
          @hol|{(1 = m + n) <=> (m = 1) /\ (n = 0) \/ (m = 0) /\ (n = 1)}|
        ),
        evensimps,
        ARITH_EQ
      ]
    )(PairList [])
  let PairList [simp1, & PairList [simp2, & PairList [simp3, & PairList []]]]:
    map(MATCH_MP)(
      CONJUNCTS(
        TAUT(
          @hol|{((a <=> F) /\ (b <=> b) ==> ((a ==> b) <=> T)) /\
             ((a <=> a') /\ (a' ==> (b <=> T)) ==> ((a ==> b) <=> T)) /\
             ((a <=> a') /\ (a' ==> (b <=> b')) ==> ((a ==> b) <=> (a' ==> b')))}|
        )
      )
    )
  let false_tm_2 = @hol|{F}|
  let and_tm = @hol|{(/\)}|
  let eq_refl = EQT_INTRO(SPEC_ALL(EQ_REFL))
  let SIMPLIFY_WELLDEFINEDNESS_CONV:
    fun(tm):
      let net = itlist(net_of_thm(#false))(allsimps)(basic_rectype_net.value)
      let RECTYPE_ARITH_EQ_CONV:
        (
          TOP_SWEEP_CONV(REWRITES_CONV(net)) then_conv \
          GEN_REWRITE_CONV(DEPTH_CONV)(PairList [AND_CLAUSES, OR_CLAUSES])
        )
      let SIMPLIFY_CASE_DISTINCTNESS_CLAUSE:
        fun(tm):
          let [avs, bod] = strip_forall(tm)
          let [ant, cons] = dest_imp(bod)
          let ath = RECTYPE_ARITH_EQ_CONV(ant)
          let atm = rand(concl(ath))
          let bth:
            CONJ(ath)(
              (if (atm == false_tm_2) | REFL(cons) | DISCH(atm)(PURE_REWRITE_CONV(PairList [eq_refl, ASSUME(atm)])(cons)))
            )
          let cth:
            try:
              simp1(bth)
              ~catch exn:
                match exn
                | Failure(_):
                    try:
                      simp2(bth)
                      ~catch exn:
                        match exn
                        | Failure(_): simp3(bth)
                        | exn: (throw exn)
                | exn: (throw exn)
          itlist(MK_FORALL)(avs)(cth)
      (
        DEPTH_BINOP_CONV(and_tm)(SIMPLIFY_CASE_DISTINCTNESS_CLAUSE) then_conv \
        GEN_REWRITE_CONV(DEPTH_CONV)(PairList [FORALL_SIMP, AND_CLAUSES])
      )(tm)
  let pth:
    prove(
      [
        @hol|{((?y. _UNGUARDED_PATTERN (GEQ s t) (GEQ z y)) <=> s = t) /\
           ((?y. _GUARDED_PATTERN (GEQ s t) g (GEQ z y)) <=> g /\ s = t)}|,
        REWRITE_TAC(PairList [_UNGUARDED_PATTERN, _GUARDED_PATTERN, GEQ_DEF]) then_tac \
        MESON_TAC(PairList [])
      ]
    )
  let basecnv = GEN_REWRITE_CONV(I)(PairList [pth])
  let pushcnv = GEN_REWRITE_CONV(I)(PairList [SWAP_EXISTS_THM])
  fun EXISTS_PAT_CONV_2(tm): (pushcnv then_conv BINDER_CONV(EXISTS_PAT_CONV_2) or_conv basecnv)(tm)
  let EXISTS_PAT_CONV = (fun(tm): (if is_exists(tm) | EXISTS_PAT_CONV_2(tm) | failwith("EXISTS_PAT_CONV")))
  let elemma0:
    prove(
      [
        @hol|{((!z. GEQ (f z) (g z)) <=> (!x y. GEQ (f(x,y)) (g(x,y)))) /\
           ((\p. P p) = (\(x,y). P(x,y)))}|,
        REWRITE_TAC(PairList [FUN_EQ_THM, FORALL_PAIR_THM])
      ]
    )
  let elemma1:
    prove(
      [
        @hol|{(!P. (!t:A->B->C#D->E. P t) <=> (!t. P (\a b (c,d). t a b d c))) /\
           (!P. (!t:B->C#D->E. P t) <=> (!t. P (\b (c,d). t b d c))) /\
           (!P. (!t:C#D->E. P t) <=> (!t. P (\(c,d). t d c)))}|,
        REPEAT(STRIP_TAC) then_tac EQ_TAC then_tac \
        REPEAT(STRIP_TAC) then_tac \
        ASM_REWRITE_TAC(PairList []) then_list \
        PairList [
          FIRST_X_ASSUM(
            o(MP_TAC)(
              SPEC(
                @hol|{\a b d c. (t:A->B->C#D->E) a b (c,d)}|
              )
            )
          ),
          FIRST_X_ASSUM(
            o(MP_TAC)(
              SPEC(
                @hol|{\b d c. (t:B->C#D->E) b (c,d)}|
              )
            )
          ),
          FIRST_X_ASSUM(
            o(MP_TAC)(
              SPEC(
                @hol|{\d c. (t:C#D->E) (c,d)}|
              )
            )
          )
        ] then_tac \
        MATCH_MP_TAC(EQ_IMP) then_tac \
        AP_TERM_TAC then_tac \
        REWRITE_TAC(PairList [FUN_EQ_THM, FORALL_PAIR_THM])
      ]
    )
  let HACK_PROFORMA_2:
    fun(n):
      fun(th):
        if (n <= 1)
        | th
        | let mkname = (fun(i): ("_P" +& to_string(i)))
          let ty = end_itlist(fun(s): fun(t): mk_type(["prod", PairList [s, t]]))(map(o(mk_vartype)(mkname))(range(1)(n)))
          let conv:
            fun(i):
              fun(tm):
                let name = ("x" +& to_string(i))
                let cnv = ALPHA_CONV(mk_var([name, mk_vartype(mkname(i))]))
                (if (is_abs(tm) && (Host.name_of(bndvar(tm)) != name)) | cnv(tm) | failwith("conv"))
          let convs = FIRST_CONV(map(conv)(range(1)(n)))
          let th1 = INST_TYPE(PairList [[ty, @hol|{:P}|]])(th)
          let th2 = REWRITE_RULE(PairList [FORALL_PAIR_THM])(th1)
          let th3 = REWRITE_RULE(PairList [elemma0, elemma1])(th2)
          CONV_RULE(REDEPTH_CONV(convs))(th3)
  let EACK_PROFORMA_2:
    fun(n):
      fun(th):
        if (n <= 1)
        | th
        | let mkname = (fun(i): ("_Q" +& to_string(i)))
          let ty = end_itlist(fun(s): fun(t): mk_type(["prod", PairList [s, t]]))(map(o(mk_vartype)(mkname))(range(1)(n)))
          let conv:
            fun(i):
              fun(tm):
                let name = ("t" +& to_string(i))
                let cnv = ALPHA_CONV(mk_var([name, mk_vartype(mkname(i))]))
                (if (is_abs(tm) && (Host.name_of(bndvar(tm)) != name)) | cnv(tm) | failwith("conv"))
          let convs = FIRST_CONV(map(conv)(range(1)(n)))
          let th1 = INST_TYPE(PairList [[ty, @hol|{:Q}|]])(th)
          let th2 = REWRITE_RULE(PairList [EXISTS_PAIR_THM])(th1)
          let th3 = REWRITE_RULE(PairList [elemma1])(th2)
          let th4 = REWRITE_RULE(PairList [FORALL_PAIR_THM])(th3)
          CONV_RULE(REDEPTH_CONV(convs))(th4)
  let [HACK_PROFORMA, EACK_PROFORMA] = [HACK_PROFORMA_2, EACK_PROFORMA_2]
  let APPLY_PROFORMA_TAC:
    fun(th):
      fun([asl, w] as gl):
        let vs = fst(dest_gabs(body(rand(w))))
        let n = (1 + length(fst(splitlist(dest_pair)(vs))))
        (MATCH_MP_TAC(HACK_PROFORMA(n)(th)) then_tac BETA_TAC)(gl)
  let is_pattern:
    fun(p):
      fun(n):
        fun(tm):
          try:
            let [f, args] = strip_comb(snd(strip_exists(body(body(tm)))))
            (is_const(f) && ((Host.name_of(f) == p) && (length(args) == n)))
            ~catch exn:
              match exn
              | Failure(_): #false
              | exn: (throw exn)
  let pth0_2:
    MESON(
      PairList [])(
      @hol|{(a /\ x = k ==> x = y ==> d) ==> (a /\ x = k /\ y = k ==> d)}|
    )
  let pth1_2:
    MESON(
      PairList [])(
      @hol|{(a /\ b /\ c /\ x = k ==> x = y ==> d)
         ==> (a /\ x = k /\ b /\ y = k /\ c ==> d)}|
    )
  let SIMPLIFY_MATCH_WELLDEFINED_TAC:
    (
      REPEAT(GEN_TAC) then_tac \
      (MATCH_MP_TAC(pth1_2) or_tac MATCH_MP_TAC(pth0_2)) then_tac \
      CONV_TAC(RAND_CONV(SIMPLIFY_WELLDEFINEDNESS_CONV)) then_tac \
      PURE_REWRITE_TAC(
        PairList [
          AND_CLAUSES,
          IMP_CLAUSES,
          OR_CLAUSES,
          EQ_CLAUSES,
          NOT_CLAUSES
        ]
      )
    )
  // Recursive traversal needs the local definition before its first use.
  fun headonly(f):
    fun(tm):
      match tm
      | Comb(s,t): (headonly(f)(s) && (headonly(f)(t) && !(t == f)))
      | Abs(x,t): headonly(f)(t)
      | _: #true
  let MAIN_ADMISS_TAC:
    fun([asl, w] as gl):
      let [had, args] = strip_comb(w)
      if !is_const(had)
      | failwith("ADMISS_TAC")
      | let [f, fbod] = dest_abs(last(args))
        let [xtup, bod] = dest_gabs(fbod)
        let [hop, args] = strip_comb(bod)
        let subject = [Host.name_of(had), Host.name_of(hop)]
        match subject
        | ["superadmissible", "COND"]: APPLY_PROFORMA_TAC(SUPERADMISSIBLE_COND)(gl)
        | ["superadmissible", "_MATCH"]:
            if (Host.name_of(repeat(rator)(last(args))) == "_SEQPATTERN")
            | (
                APPLY_PROFORMA_TAC(SUPERADMISSIBLE_MATCH_SEQPATTERN) then_tac \
                CONV_TAC(ONCE_DEPTH_CONV(EXISTS_PAT_CONV))
              )(gl)
            | match subject
              | ["superadmissible", "_MATCH"]:
                  if is_pattern("_UNGUARDED_PATTERN")(2)(last(args))
                  | let n = length(fst(strip_exists(body(body(last(args))))))
                    let th = EACK_PROFORMA(n)(SUPERADMISSIBLE_MATCH_UNGUARDED_PATTERN)
                    (
                      APPLY_PROFORMA_TAC(th) then_tac CONJ_TAC then_list \
                      PairList [SIMPLIFY_MATCH_WELLDEFINED_TAC, ALL_TAC]
                    )(gl)
                  | match subject
                    | ["superadmissible", "_MATCH"]:
                        if is_pattern("_GUARDED_PATTERN")(3)(last(args))
                        | let n = length(fst(strip_exists(body(body(last(args))))))
                          let th = EACK_PROFORMA(n)(SUPERADMISSIBLE_MATCH_GUARDED_PATTERN)
                          (
                            APPLY_PROFORMA_TAC(th) then_tac CONJ_TAC then_list \
                            PairList [SIMPLIFY_MATCH_WELLDEFINED_TAC, ALL_TAC]
                          )(gl)
                        | match subject
                          | ["superadmissible", _]:
                              if (is_comb(bod) && (rator(bod) == f))
                              | APPLY_PROFORMA_TAC(SUPERADMISSIBLE_TAIL)(gl)
                              | match subject
                                | ["admissible", "sum"]: APPLY_PROFORMA_TAC(ADMISSIBLE_SUM)(gl)
                                | ["admissible", "nsum"]: APPLY_PROFORMA_TAC(ADMISSIBLE_NSUM)(gl)
                                | ["admissible", "MAP"]: APPLY_PROFORMA_TAC(ADMISSIBLE_MAP)(gl)
                                | ["admissible", "_MATCH"]:
                                    if (Host.name_of(repeat(rator)(last(args))) == "_SEQPATTERN")
                                    | (
                                        APPLY_PROFORMA_TAC(ADMISSIBLE_MATCH_SEQPATTERN) then_tac \
                                        CONV_TAC(ONCE_DEPTH_CONV(EXISTS_PAT_CONV))
                                      )(gl)
                                    | match subject
                                      | ["admissible", "_MATCH"]: APPLY_PROFORMA_TAC(ADMISSIBLE_MATCH)(gl)
                                      | ["admissible", "_UNGUARDED_PATTERN"]: APPLY_PROFORMA_TAC(ADMISSIBLE_UNGUARDED_PATTERN)(gl)
                                      | ["admissible", "_GUARDED_PATTERN"]: APPLY_PROFORMA_TAC(ADMISSIBLE_GUARDED_PATTERN)(gl)
                                      | ["admissible", _]:
                                          if is_abs(bod)
                                          | APPLY_PROFORMA_TAC(ADMISSIBLE_LAMBDA)(gl)
                                          | match subject
                                            | ["admissible", _]:
                                                if (is_comb(bod) && (rator(bod) == f))
                                                | (if free_in(f)(rand(bod)) | APPLY_PROFORMA_TAC(ADMISSIBLE_NEST)(gl) | APPLY_PROFORMA_TAC(ADMISSIBLE_BASE)(gl))
                                                | match subject
                                                  | ["admissible", _]:
                                                      if (is_comb(bod) && headonly(f)(bod))
                                                      | APPLY_PROFORMA_TAC(ADMISSIBLE_COMB)(gl)
                                                      | match subject
                                                        | _: failwith("MAIN_ADMISS_TAC")
                                                  | _: failwith("MAIN_ADMISS_TAC")
                                            | ["admissible", _]:
                                                if (is_comb(bod) && headonly(f)(bod))
                                                | APPLY_PROFORMA_TAC(ADMISSIBLE_COMB)(gl)
                                                | match subject
                                                  | _: failwith("MAIN_ADMISS_TAC")
                                            | _: failwith("MAIN_ADMISS_TAC")
                                      | ["admissible", _]:
                                          if (is_comb(bod) && (rator(bod) == f))
                                          | (if free_in(f)(rand(bod)) | APPLY_PROFORMA_TAC(ADMISSIBLE_NEST)(gl) | APPLY_PROFORMA_TAC(ADMISSIBLE_BASE)(gl))
                                          | match subject
