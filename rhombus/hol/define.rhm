      fun(parms):
        let p = mk_var(["P", mk_fun_ty(type_of(parm))(bool_ty)])
        let tm = list_mk_forall([parms, mk_comb([p, parm])])
        GEN(p)(SYM(depair(parms)(tm)))
  let ELIM_LISTOPS_CONV:
    (
      PURE_REWRITE_CONV(PairList [PAIRWISE, ALL, GSYM(CONJ_ASSOC), AND_CLAUSES]) then_conv \
      TOP_DEPTH_CONV(GEN_BETA_CONV)
    )
  let tuple_function_existence:
    fun(tm):
      let [f, hol_def_2] = dest_exists(tm)
      let [domtys0, ranty0] = splitlist(dest_fun_ty)(type_of(f))
      let nargs:
        itlist(
          o(o(o(o(o(o(hol_max)(length))(snd))(strip_comb))(lhs))(snd))(strip_forall)
        )(conjuncts(snd(strip_forall(hol_def_2))))(0)
      let [domtys, midtys] = chop_list(nargs)(domtys0)
      let ranty = itlist(mk_fun_ty)(midtys)(ranty0)
      if (length(domtys) <= 1)
      | ASSUME(tm)
      | let dty = end_itlist(fun(ty1): fun(ty2): mk_type(["prod", PairList [ty1, ty2]]))(domtys)
        let f_prime = variant(frees(tm))(mk_var([fst(dest_var(f)), mk_fun_ty(dty)(ranty)]))
        let gvs = map(genvar)(domtys)
        let f_prime_prime = list_mk_abs([gvs, mk_comb([f_prime, end_itlist(curry(mk_pair))(gvs)])])
        let def_prime = subst(PairList [[f_prime_prime, f]])(hol_def_2)
        let th1_3 = EXISTS([tm, f_prime_prime])(ASSUME(def_prime))
        let bth_2 = BETAS_CONV(list_mk_comb([f_prime_prime, gvs]))
        let th2 = GEN_REWRITE_CONV(TOP_DEPTH_CONV)(PairList [bth_2])(hd(hyp(th1_3)))
        SIMPLE_CHOOSE(f_prime)(PROVE_HYP(UNDISCH(snd(EQ_IMP_RULE(th2))))(th1_3))
  let pinstantiate_casewise_recursion:
    fun(hol_def):
      try:
        PART_MATCH(I)(EXISTS_REFL)(hol_def)
        ~catch exn:
          match exn
          | Failure(_):
              let [f, bod] = dest_exists(hol_def)
              let cjs = conjuncts(bod)
              let eqs = map(o(snd)(strip_forall))(cjs)
              let [lefts, rights] = unzip(map(dest_eq)(eqs))
              let arglists = map(o(snd)(strip_comb))(lefts)
              let parms0 = freesl(unions(arglists))
              let parms = (if (parms0 != (PairList [])) | parms0 | PairList [genvar(aty)])
              let parm = end_itlist(curry(mk_pair))(parms)
              let ss_2 = map((fun(a): mk_gabs([parm, end_itlist(curry(mk_pair))(a)])))(arglists)
              let ts_2 = map((fun(a): mk_abs([f, mk_gabs([parm, a])])))(rights)
              let clauses = mk_flist(map2(curry(mk_pair))(ss_2)(ts_2))
              let pth = ISPEC(clauses)(RECURSION_SUPERADMISSIBLE)
              let FIDDLE_CONV:
                o(
                  o(
                    o(
                      o(
                        o(o(o(o(LAND_CONV)(LAND_CONV))(BINDER_CONV))(RAND_CONV))(LAND_CONV)
                      )(GABS_CONV)
                    )(RATOR_CONV)
                  )(LAND_CONV)
                )(ABS_CONV)
              let th0 = UNDISCH(CONV_RULE(FIDDLE_CONV(LAMBDA_PAIR_CONV_2(parms)))(pth))
              let th1 = EQ_MP(GEN_ALPHA_CONV(f)(concl(th0)))(th0)
              let rewr_forall_th = REWR_CONV(FORALL_PAIR_CONV_2(parm)(parms))
              let th2:
                CONV_RULE(
                  BINDER_CONV((LAND_CONV(GABS_CONV(rewr_forall_th)) then_conv EXPAND_PAIRED_ALL_CONV_2))
                )(th1)
              let [f2, bod2] = dest_exists(concl(th2))
              let ths3:
                map(
                  o(
                    CONV_RULE(
                      COMB2_CONV(funpow(2)(RAND_CONV)(GEN_BETA_CONV))((RATOR_CONV(BETA_CONV) then_conv GEN_BETA_CONV))
                    )
                  )(SPEC_ALL)
                )(CONJUNCTS(ASSUME(bod2)))
              let ths4:
                map2(
                  fun(th):
                    fun(t):
                      let [avs, tbod] = strip_forall(t)
                      itlist(GEN)(avs)(PART_MATCH(I)(th)(tbod))
                )(ths3)(cjs)
              let th5 = SIMPLE_EXISTS(f)(end_itlist(CONJ)(ths4))
              let th6 = PROVE_HYP(th2)(SIMPLE_CHOOSE(f)(th5))
              let th7:
                (
                  RAND_CONV(
                    COMB2_CONV(
                      RAND_CONV(
                        LAND_CONV(
                          GABS_CONV(BINDER_CONV((BINDER_CONV(rewr_forall_th) then_conv rewr_forall_th)))
                        )
                      )
                    )(
                      LAND_CONV(
                        funpow(2)(GABS_CONV)(BINDER_CONV((BINDER_CONV(rewr_forall_th) then_conv rewr_forall_th)))
                      )
                    )
                  ) then_conv \
                  ELIM_LISTOPS_CONV
                )(hd(hyp(th6)))
              let th8 = PROVE_HYP(UNDISCH(snd(EQ_IMP_RULE(th7))))(th6)
              let [wfasm, cdasm] = dest_conj(hd(hyp(th8)))
              let th9 = PROVE_HYP(CONJ(ASSUME(wfasm))(ASSUME(cdasm)))(th8)
              let th10 = SIMPLIFY_WELLDEFINEDNESS_CONV(cdasm)
              let th11 = PROVE_HYP(UNDISCH(snd(EQ_IMP_RULE(th10))))(th9)
              PROVE_HYP(TRUTH)(th11)
          | exn: (throw exn)
  let instantiate_casewise_recursion:
    fun(etm):
      let eth = tuple_function_existence(etm)
      let dtm = hd(hyp(eth))
      let dth = pinstantiate_casewise_recursion(dtm)
      PROVE_HYP(dth)(eth)
  let break_down_admissibility:
    fun(th1):
      if (hyp(th1) == (PairList []))
      | th1
      | let hol_def_3 = concl(th1)
        let [f, bod] = dest_exists(hol_def_3)
        let cjs = conjuncts(bod)
        let eqs = map(o(snd)(strip_forall))(cjs)
        let [lefts, rights] = unzip(map(dest_eq)(eqs))
        let arglists = map(o(snd)(strip_comb))(lefts)
        let parms0 = freesl(unions(arglists))
        let parms = (if (parms0 != (PairList [])) | parms0 | PairList [genvar(aty)])
        let wfasm = find(is_exists)(hyp(th1))
        let [ord, bod] = dest_exists(wfasm)
        let SIMP_ADMISS_TAC:
          (
            (
              (
                (
                  (
                    REWRITE_TAC(PairList [LET_DEF, LET_END_DEF]) then_tac \
                    REPEAT(ADMISS_TAC)
                  ) then_tac \
                  TRY(
                    W(
                      fun([asl, w]):
                        let v = fst(dest_forall(w))
                        (
                          (
                            (
                              X_GEN_TAC(v) then_tac \
                              MAP_EVERY(
                                fun(v):
                                  (
                                    TRY(GEN_REWRITE_TAC(I)(PairList [FORALL_PAIR_THM])) then_tac \
                                    X_GEN_TAC(v)
                                  )
                              )(parms)
                            ) then_tac \
                            CONV_TAC(TOP_DEPTH_CONV(GEN_BETA_CONV))
                          ) then_tac \
                          MAP_EVERY((fun(v): SPEC_TAC([v, v])))(append(rev(parms))(PairList [v]))
                        )
                    )
                  )
                ) then_tac \
                PURE_REWRITE_TAC(PairList [FORALL_SIMP])
              ) then_tac \
              W(
                (fun([asl, w]): MAP_EVERY((fun(t): SPEC_TAC([t, t])))(subtract(frees(w))(PairList [ord])))
              )
            ) then_tac \
            W((fun([asl, w]): ACCEPT_TAC(ASSUME(w))))
          )
        let th2 = TAC_PROOF([[PairList [], bod], SIMP_ADMISS_TAC])
        let th3 = SIMPLE_EXISTS(ord)(th2)
        let allasms_2 = hyp(th3)
        let wfasm_2 = lhand(concl(th2))
        let th4 = ASSUME(list_mk_conj(PairList [wfasm_2, & subtract(allasms_2)(PairList [wfasm_2])]))
        let th5 = SIMPLE_CHOOSE(ord)(itlist(PROVE_HYP)(CONJUNCTS(th4))(th3))
        PROVE_HYP(th5)(th1)
  let pure_prove_recursive_function_exists:
    fun(dtm):
      let th = break_down_admissibility(instantiate_casewise_recursion(dtm))
      (if (concl(th) == dtm) | th | failwith("prove_general_recursive_function_exists: sanity"))
  let num_ty = hol_type: num
  let prove_depth_measure_exists:
    fun(tyname):
      let [_, _, sth] = assoc(tyname)(inductive_type_store.value)
      let [ty, zty] = dest_fun_ty(type_of(fst(dest_exists(snd(strip_forall(concl(sth)))))))
      let rth = INST_TYPE(PairList [[num_ty, zty]])(sth)
      let [avs, bod] = strip_forall(concl(rth))
      let [ev, cbod] = dest_exists(bod)
      let process_clause:
        fun(k):
          fun(t):
            let [avs, eq] = strip_forall(t)
            let [l, r] = dest_eq(eq)
            let [fn, cargs] = dest_comb(l)
            let [con, args] = strip_comb(cargs)
            let bargs = filter((fun(t): (type_of(t) == ty)))(args)
            let r_prime = list_mk_binop(hol: const #{+} :: num -> num -> num; const.#{+})(PairList [mk_small_numeral(k), & map(curry(mk_comb)(fn))(bargs)])
            list_mk_forall([avs, mk_eq([l, r_prime])])
      let cjs = conjuncts(cbod)
      let hol_def_4 = map2(process_clause)(range(1)(length(cjs)))(cjs)
      prove_recursive_functions_exist(sth)(list_mk_conj(hol_def_4))
  let INDUCTIVE_MEASURE_THEN:
    fun(tac):
      fun([asl, w]):
        let [ev, bod] = dest_exists(w)
        let ty = fst(dest_type(fst(dest_fun_ty(type_of(ev)))))
        let th = prove_depth_measure_exists(ty)
        let [ev_prime, bod_prime] = dest_exists(concl(th))
        let th_prime = INST_TYPE(type_match(type_of(ev_prime))(type_of(ev))(PairList []))(th)
        (
          (
            (
              (MP_TAC(th_prime) then_tac MATCH_MP_TAC(MONO_EXISTS)) then_tac \
              GEN_TAC
            ) then_tac \
            DISCH_THEN((fun(th): REWRITE_TAC(PairList [th])))
          ) then_tac \
          tac
        )([asl, w])
  let one_tm = hol:
    (1 :: num)
  let CONSTANT_MEASURE_THEN:
    fun(tac):
      fun([asl, w]):
        let [ev, bod] = dest_exists(w)
        let ty = fst(dest_fun_ty(type_of(ev)))
        (EXISTS_TAC(mk_abs([genvar(ty), one_tm])) then_tac tac)([asl, w])
  let GUESS_MEASURE_THEN:
    fun(tac):
      (
        (
          (
            EXISTS_TAC(
              (hol:
                 fun (n :: num): n + (1 :: num))
            ) then_tac \
            tac
          ) or_tac \
          INDUCTIVE_MEASURE_THEN(tac)
        ) or_tac \
        CONSTANT_MEASURE_THEN(tac)
      )
  let pth_lexleft:
    prove(
      [
        (hol:
           var P :: (pair(A, B) -> pair(A, B) -> bool) -> bool
           const WF :: (A -> A -> bool) -> bool
           const GABS :: (A -> bool) -> A
           const GEQ :: A -> A -> bool
           const #{|,|} :: A -> B -> pair(A, B)
           (exists r :: A -> A -> bool:
              WF(r)
                && (exists s :: B -> B -> bool:
                      WF(s)
                        && P(
                             GABS(
                               fun (f :: pair(A, B) -> pair(A, B) -> bool):
                                 forall (x1 :: A, y1 :: B):
                                   GEQ(
                                     f(#{|,|}(x1, y1)),
                                     GABS(
                                       fun (f :: pair(A, B) -> bool):
                                         forall (x2 :: A, y2 :: B):
                                           GEQ(f(#{|,|}(x2, y2)), r(x1, x2) || x1 == x2 && s(y1, y2))
                                     )
                                   )
                             )
                           )))
             ==> (exists t :: pair(A, B) -> pair(A, B) -> bool: WF(t) && P(t))),
        (
          (
            REPEAT(STRIP_TAC) then_tac \
            EXISTS_TAC(
              (hol:
                 var r :: A -> A -> bool
                 var s :: B -> B -> bool
                 const GABS :: (A -> bool) -> A
                 const GEQ :: A -> A -> bool
                 const #{|,|} :: A -> B -> pair(A, B)
                 GABS(
                   fun (f :: pair(A, B) -> pair(A, B) -> bool):
                     forall (x1 :: A, y1 :: B):
                       GEQ(
                         f(#{|,|}(x1, y1)),
                         GABS(
                           fun (f :: pair(A, B) -> bool):
                             forall (x2 :: A, y2 :: B):
                               GEQ(f(#{|,|}(x2, y2)), r(x1, x2) || x1 == x2 && s(y1, y2))
                         )
                       )
                 ))
            )
          ) then_tac \
          ASM_SIMP_TAC(PairList [WF_LEX])
        )
      ]
    )
  let pth_lexright:
    prove(
      [
        (hol:
           var P :: (pair(A, B) -> pair(A, B) -> bool) -> bool
           const WF :: (A -> A -> bool) -> bool
           const GABS :: (A -> bool) -> A
           const GEQ :: A -> A -> bool
           const #{|,|} :: A -> B -> pair(A, B)
           (exists r :: B -> B -> bool:
              WF(r)
                && (exists s :: A -> A -> bool:
                      WF(s)
                        && P(
                             GABS(
                               fun (f :: pair(A, B) -> pair(A, B) -> bool):
                                 forall (x1 :: A, y1 :: B):
                                   GEQ(
                                     f(#{|,|}(x1, y1)),
                                     GABS(
                                       fun (f :: pair(A, B) -> bool):
                                         forall (x2 :: A, y2 :: B):
                                           GEQ(f(#{|,|}(x2, y2)), r(y1, y2) || y1 == y2 && s(x1, x2))
                                     )
                                   )
                             )
                           )))
             ==> (exists t :: pair(A, B) -> pair(A, B) -> bool: WF(t) && P(t))),
        (
          (
            (
              (
                REPEAT(STRIP_TAC) then_tac \
                EXISTS_TAC(
                  (hol:
                     var r :: B -> B -> bool
                     var s :: A -> A -> bool
                     const GABS :: (A -> bool) -> A
                     const GEQ :: A -> A -> bool
                     const #{|,|} :: A -> B -> pair(A, B)
                     fun (u :: pair(A, B), v :: pair(A, B)):
                       GABS(
                         fun (f :: pair(B, A) -> pair(B, A) -> bool):
                           forall (x1 :: B, y1 :: A):
                             GEQ(
                               f(#{|,|}(x1, y1)),
                               GABS(
                                 fun (f :: pair(B, A) -> bool):
                                   forall (x2 :: B, y2 :: A):
                                     GEQ(f(#{|,|}(x2, y2)), r(x1, x2) || x1 == x2 && s(y1, y2))
                               )
                             ),
                         GABS(
                           fun (f :: pair(A, B) -> pair(B, A)):
                             forall (a :: A, b :: B): GEQ(f(#{|,|}(a, b)), #{|,|}(b, a)),
                           u
                         ),
                         GABS(
                           fun (f :: pair(A, B) -> pair(B, A)):
                             forall (a :: A, b :: B): GEQ(f(#{|,|}(a, b)), #{|,|}(b, a)),
                           v
                         )
                       ))
                )
              ) then_tac \
              ASM_SIMP_TAC(
                PairList [
                  WF_LEX,
                  ETA_AX,
                  ISPECL(
                    PairList [
                      (hol: var R :: pair(A, B) -> pair(A, B) -> bool; R),
                      (hol:
                         const GABS :: (A -> bool) -> A
                         const GEQ :: A -> A -> bool
                         const #{|,|} :: A -> B -> pair(A, B)
                         GABS(
                           fun (f :: pair(B, A) -> pair(A, B)):
                             forall (b :: B, a :: A): GEQ(f(#{|,|}(b, a)), #{|,|}(a, b))
                         ))
                    ])(
                    WF_MEASURE_GEN
                  )
                ]
              )
            ) then_tac \
            FIRST_X_ASSUM(
              (fun(th): ((MP_TAC(th) then_tac MATCH_MP_TAC(EQ_IMP)) then_tac AP_TERM_TAC))
            )
          ) then_tac \
          REWRITE_TAC(PairList [FUN_EQ_THM, FORALL_PAIR_THM])
        )
      ]
    )
  let pth_measure:
    prove(
      [
        (hol:
           var P :: (A -> A -> bool) -> bool
           const MEASURE :: (A -> num) -> A -> A -> bool
           const WF :: (A -> A -> bool) -> bool
           (exists m :: A -> num: P(MEASURE(m))) ==> (exists r :: A -> A -> bool: WF(r) && P(r))),
        MESON_TAC(PairList [WF_MEASURE])
      ]
    )
  // Recursive tactic construction needs the local definition before its first use.
  fun GUESS_WF_THEN(tac):
    fun([asl, w]):
      (
        (
          (MATCH_MP_TAC(pth_lexleft) then_tac GUESS_WF_THEN(GUESS_WF_THEN(tac))) or_tac \
          (MATCH_MP_TAC(pth_lexright) then_tac GUESS_WF_THEN(GUESS_WF_THEN(tac)))
        ) or_tac \
        (
          (
            (
              MATCH_MP_TAC(pth_measure) then_tac \
              REWRITE_TAC(PairList [MEASURE, MEASURE_LE])
            ) then_tac \
            REWRITE_TAC(PairList [FORALL_PAIR_THM])
          ) then_tac \
          GUESS_MEASURE_THEN(tac)
        )
      )([asl, w])
  let PRE_GUESS_TAC:
    CONV_TAC(
      BINDER_CONV(
        DEPTH_BINOP_CONV(hol: const #{|/\|} :: bool -> bool -> bool; #{|/\|})(
          (
            TRY_CONV(SIMPLIFY_WELLDEFINEDNESS_CONV) then_conv \
            TRY_CONV(FORALL_UNWIND_CONV)
          )
        )
      )
    )
  let false_tm = hol:
    fun (x :: A, y :: A): #false
  let GUESS_ORDERING_TAC:
    (
      W(
        fun([asl, w]):
          let ty = fst(dest_fun_ty(type_of(fst(dest_exists(w)))))
          (
            (
              EXISTS_TAC(inst(PairList [[ty, aty]])(false_tm)) then_tac \
              REWRITE_TAC(PairList [WF_FALSE])
            ) then_tac \
            NO_TAC
          )
      ) or_tac \
      GUESS_WF_THEN((REWRITE_TAC(PairList [FORALL_PAIR_THM]) then_tac ARITH_TAC))
    )
  let prove_general_recursive_function_exists:
    fun(etm):
      let th = pure_prove_recursive_function_exists(etm)
      try:
        let wtm = find(is_exists)(hyp(th))
        let wth = prove([wtm, (PRE_GUESS_TAC then_tac GUESS_ORDERING_TAC)])
        PROVE_HYP(wth)(th)
        ~catch exn:
          match exn
          | Failure(_): th
          | exn: (throw exn)
  [
    instantiate_casewise_recursion,
    pure_prove_recursive_function_exists,
    prove_general_recursive_function_exists
  ]

def define:
  let close_definition_clauses:
    fun(tm):
      let [avs, bod] = strip_forall(tm)
      let cjs = conjuncts(bod)
      let fs:
        try:
          map(o(o(o(repeat(rator))(lhs))(snd))(strip_forall))(cjs)
          ~catch exn:
            match exn
            | Failure(_): failwith("close_definition_clauses: non-equation")
            | exn: (throw exn)
      if (length(setify(fs)) != 1)
      | failwith("close_definition_clauses: defining multiple functions")
      | let f = hd(fs)
        if mem(f)(avs)
        | failwith("close_definition_clauses: fn quantified")
        | let do_clause:
            fun(t):
              let [lvs, bod] = strip_forall(t)
              let fvs = subtract(frees(lhs(bod)))(PairList [f, & lvs])
              SPECL(fvs)(ASSUME(list_mk_forall([fvs, t])))
          let ths = map(do_clause)(cjs)
          let ajs = map(o(hd)(hyp))(ths)
          let th = ASSUME(list_mk_conj(ajs))
          [
            f,
            itlist(GEN)(avs)(itlist(PROVE_HYP)(CONJUNCTS(th))(end_itlist(CONJ)(ths)))
          ]
  let type_instantiate_defining_const:
    fun(t):
      let cjs = conjuncts(t)
      let fs = map(o(o(o(repeat(rator))(lhs))(snd))(strip_forall))(cjs)
      let f = hd(fs)
      if !is_const(f)
      | t
      | let fname = Host.name_of(f)
        let f_occurs:
          find_terms(
            (fun(t_prime): (is_const(t_prime) && ((Host.name_of(t_prime) == fname) && (t_prime != f))))
          )(t)
        itlist(
          fun(f_prime): fun(t_updated): instantiate(term_match(PairList [])(f_prime)(f))(t_updated)
        )(f_occurs)(t)
  fun(tm):
    let tm_prime = snd(strip_forall(tm))
    try:
      let tm_prime = type_instantiate_defining_const(tm_prime)
      let [th, th_prime] = tryfind((fun(th): [th, PART_MATCH(I)(th)(tm_prime)]))(the_definitions.value)
      if can(PART_MATCH(I)(th_prime))(concl(th))
      | warn(#true)("Benign redefinition")
        th_prime
      | failwith("")
      ~catch exn:
        match exn
        | Failure(_):
            let [f, th] = close_definition_clauses(tm)
            if !is_var(f)
            | failwith(("define: '" +& (Host.string_of_term(f) +& "' is already defined")))
            | let etm = mk_exists([f, hd(hyp(th))])
              let th1 = prove_general_recursive_function_exists(etm)
              let th2 = new_specification(PairList [fst(dest_var(f))])(th1)
              let g = mk_mconst(dest_var(f))
              let th3 = PROVE_HYP(th2)(INST(PairList [[g, f]])(th))
              the_definitions.value := PairList [th3, & the_definitions.value]
              th3
        | exn: (throw exn)

def WF_REC_TAIL_GENERAL_prime = define_WF_REC_TAIL_GENERAL_prime

def WF_REC_CASES_prime = define_WF_REC_CASES_prime

def instantiate_casewise_recursion = define_instantiate_casewise_recursion_v2

def pure_prove_recursive_function_exists = define_pure_prove_recursive_function_exists_v2
