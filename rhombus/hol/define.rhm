    (hol:
       var CASEWISE :: list(pair(#{?138333} -> #{?138337}, #{?138338} -> #{?138333} -> #{?138297})) -> #{?138338} -> #{?138337} -> #{?138297}
       var f :: #{?138338}
       var x :: #{?138337}
       var h :: pair(#{?138333} -> #{?138337}, #{?138338} -> #{?138333} -> #{?138297})
       var t :: list(pair(#{?138333} -> #{?138337}, #{?138338} -> #{?138333} -> #{?138297}))
       const NIL :: list(A)
       const #{@} :: (A -> bool) -> A
       const CONS :: A -> list(A) -> list(A)
       const FST :: pair(A, B) -> A
       const SND :: pair(A, B) -> B
       CASEWISE(NIL, f, x) == #{@}(fun (y :: #{?138297}): #true)
         && (CASEWISE(CONS(h, t), f, x)
               == (if (exists y :: #{?138333}: FST(h, y) == x)
                   | SND(h, f, #{@}(fun (y :: #{?138333}): FST(h, y) == x))
                   | CASEWISE(t, f, x))))
  )

