          match exn
          | Failure(_): th
          | exn: Host.hol_raise(exn)
  [instantiate_casewise_recursion, pure_prove_recursive_function_exists, prove_general_recursive_function_exists]

def define:
  let close_definition_clauses:
    fun(tm):
      let [avs, bod] = Basics.strip_forall(tm)
      let cjs = Basics.conjuncts(bod)
      let fs:
        try:
          map(o(o(o(Host.repeat(Fusion.rator))(Equal.lhs))(snd))(Basics.strip_forall))(cjs)
          ~catch exn:
            match exn
            | Failure(_): failwith("close_definition_clauses: non-equation")
            | exn: Host.hol_raise(exn)
      if Host.hol_unequal(length(Host.setify(fs)))(1)
      | failwith("close_definition_clauses: defining multiple functions")
      | let f = hd(fs)
        if mem(f)(avs)
        | failwith("close_definition_clauses: fn quantified")
        | let do_clause:
            fun(t):
              let [lvs, bod] = Basics.strip_forall(t)
              let fvs = subtract(Fusion.frees(Equal.lhs(bod)))(PairList.cons(f, lvs))
              Bool.SPECL(fvs)(Fusion.ASSUME(Bool.list_mk_forall([fvs, t])))
          let ths = map(do_clause)(cjs)
          let ajs = map(o(hd)(Fusion.hyp))(ths)
          let th = Fusion.ASSUME(Bool.list_mk_conj(ajs))
          [f, itlist(Bool.GEN)(avs)(itlist(Bool.PROVE_HYP)(Bool.CONJUNCTS(th))(end_itlist(Bool.CONJ)(ths)))]
  let type_instantiate_defining_const:
    fun(t):
      let cjs = Basics.conjuncts(t)
      let fs = map(o(o(o(Host.repeat(Fusion.rator))(Equal.lhs))(snd))(Basics.strip_forall))(cjs)
      let f = hd(fs)
      if Host.hol_not(Fusion.is_const(f))
      | t
      | let fname = Host.name_of(f)
        let f_occurs = Basics.find_terms((fun(t_prime): (Fusion.is_const(t_prime) && (Host.hol_equal(Host.name_of(t_prime))(fname) && Host.hol_unequal(t_prime)(f)))))(t)
        itlist((fun(f_prime): (fun(t_updated): Drule.instantiate(Drule.term_match(PairList [])(f_prime)(f))(t_updated))))(f_occurs)(t)
  fun(tm):
    let tm_prime = snd(Basics.strip_forall(tm))
    try:
      let tm_prime = type_instantiate_defining_const(tm_prime)
      let [th, th_prime] = tryfind((fun(th): [th, Drule.PART_MATCH(I)(th)(tm_prime)]))(Host.ref_get(HolPair.the_definitions))
      if can(Drule.PART_MATCH(I)(th_prime))(Fusion.concl(th))
      | Host.warn(#true)("Benign redefinition")
        th_prime
      | failwith("")
      ~catch exn:
        match exn
        | Failure(_):
            let [f, th] = close_definition_clauses(tm)
            if Host.hol_not(Fusion.is_var(f))
            | failwith(Host.hol_concat("define: '")(Host.hol_concat(Host.string_of_term(f))("' is already defined")))
            | let etm = Bool.mk_exists([f, hd(Fusion.hyp(th))])
              let th1 = prove_general_recursive_function_exists(etm)
              let th2 = Nums.new_specification(PairList.cons(fst(Fusion.dest_var(f)), PairList []))(th1)
              let g = Basics.mk_mconst(Fusion.dest_var(f))
              let th3 = Bool.PROVE_HYP(th2)(Fusion.INST(PairList.cons([g, f], PairList []))(th))
              Host.ref_set(HolPair.the_definitions)(PairList.cons(th3, Host.ref_get(HolPair.the_definitions)))
              th3
        | exn: Host.hol_raise(exn)

def WF_REC_TAIL_GENERAL_prime = define_WF_REC_TAIL_GENERAL_prime

def WF_REC_CASES_prime = define_WF_REC_CASES_prime
