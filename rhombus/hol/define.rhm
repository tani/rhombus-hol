         var clauses :: list(pair(#{?138400} -> #{?138397}, #{?138398} -> #{?138400} -> #{?138358}))
         const CASEWISE :: list(pair(#{?138308} -> #{?138312}, #{?138313} -> #{?138308} -> #{?138272})) -> #{?138313} -> #{?138312} -> #{?138272}
         const NIL :: list(A)
         const #{@} :: (A -> bool) -> A
         const CONS :: A -> list(A) -> list(A)
         const #{|,|} :: A -> B -> pair(A, B)
         CASEWISE(NIL, f, x) == #{@}(fun (y :: #{?138357}): #true)
           && (CASEWISE(CONS(#{|,|}(s, t), clauses), f, x)
                 == (if (exists y :: #{?138400}: s(y) == x)
                     | t(f, #{@}(fun (y :: #{?138400}): s(y) == x))
                     | CASEWISE(clauses, f, x)))),
      REWRITE_TAC(PairList [CASEWISE_DEF])
    ]
  )

