  let APPLY_PROFORMA_TAC:
    fun(th):
      fun([asl, w] as gl):
        let vs = fst(dest_gabs(body(rand(w))))
        let n = (1 + length(fst(splitlist(dest_pair)(vs))))
        (MATCH_MP_TAC(HACK_PROFORMA(n)(th)) then_tac BETA_TAC)(gl)
