        »)
      »;
      (fun(tm):«
        (block:«
          let tm_prime:«
            snd(Up_basics.strip_forall(tm))
          »;
          (block:«
            try:«
              (block:«
                let tm_prime:«
                  type_instantiate_defining_const(tm_prime)
                »;
                (block:«
                  let Pair(th,th_prime):«
                    tryfind((fun(th):«
                      Pair(th,Up_drule.PART_MATCH(I)(th)(tm_prime))
                    »))(Host.ref_get(Up_pair.the_definitions))
                  »;
                  (block:«
                    if (block:«
                      let port_tmp_758 = Up_fusion.concl(th);
                      let port_tmp_759 = Up_drule.PART_MATCH(I)(th_prime);
                      can(port_tmp_759)(port_tmp_758)
                    »)
                    | (block:«
                      Host.warn(#true)("Benign redefinition");
                      th_prime
                    »)
                    | failwith("")
                  »)
                »)
              »);
              ~catch port_tmp_760:«
                let port_tmp_761 = port_tmp_760;
                match port_tmp_761
                | Failure(_):«
                    (block:«
                      let Pair(f,th):«
                        close_definition_clauses(tm)
                      »;
                      (block:«
                        if Host.hol_not(Up_fusion.is_var(f))
                        | failwith(Host.hol_concat("define: '")(Host.hol_concat(Host.string_of_term(f))("' is already defined")))
                        | (block:«
                          let etm:«
                            Up_bool.mk_exists(Pair(f,hd(Up_fusion.hyp(th))))
                          »;
                          (block:«
                            let th1:«
                              define_prove_general_recursive_function_exists(etm)
                            »;
                            (block:«
                              let th2:«
                                Up_nums.new_specification(PairList.cons(fst(Up_fusion.dest_var(f)),PairList []))(th1)
                              »;
                              (block:«
                                let g:«
                                  Up_basics.mk_mconst(Up_fusion.dest_var(f))
                                »;
                                (block:«
                                  let th3:«
                                    Up_bool.PROVE_HYP(th2)(Up_fusion.INST(PairList.cons(Pair(g,f),PairList []))(th))
                                  »;
                                  (block:«
                                    Host.ref_set(Up_pair.the_definitions)(PairList.cons(th3,Host.ref_get(Up_pair.the_definitions)));
                                    th3
                                  »)
                                »)
                              »)
                            »)
                          »)
                        »)
                      »)
                    »)
                »
                | port_tmp_760:«
                    Host.hol_raise(port_tmp_760)
                »
              »
            »
          »)
        »)
      »)
    »)
  »)
»

