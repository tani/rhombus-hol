import:
  "lib.rhm" open
  "private/ocaml.rhm" open
  "private/hol_quote.rhm" open
  "printer.rhm" open:
    only:
      name_of
  "fusion.rhm" open
  "basics.rhm" open
  "equal.rhm" open
  "bool.rhm" open
  "nets.rhm" open

export:
  mk_thm
  MK_CONJ
  MK_DISJ
  MK_FORALL
  MK_EXISTS
  MP_CONV
  BETAS_CONV
  instantiate
  INSTANTIATE
  INSTANTIATE_ALL
  term_match
  term_unify
  type_unify
  term_type_unify
  deep_alpha
  PART_MATCH
  GEN_PART_MATCH
  MATCH_MP
  HIGHER_REWRITE_CONV
  new_definition

// -------------------------------------------------------------------------
// The last recourse when all else fails!
// -------------------------------------------------------------------------

fun mk_thm([asl, c]):
  let ax = new_axiom(itlist(curry(mk_imp))(rev(asl))(c))
  rev_itlist(fun(t): fun(th): MP(th)(ASSUME(t)))(rev(asl))(ax)

// -------------------------------------------------------------------------
// Derived congruence rules; very useful things!
// -------------------------------------------------------------------------

def MK_CONJ:
  let andtm = @hol|{(/\)}|
  fun(eq1): fun(eq2): MK_COMB([AP_TERM(andtm)(eq1), eq2])

def MK_DISJ:
  let ortm = @hol|{(\/)}|
  fun(eq1): fun(eq2): MK_COMB([AP_TERM(ortm)(eq1), eq2])

def MK_FORALL:
  let atm = mk_const(["!", PairList []])
  fun(v): fun(th): AP_TERM(inst(PairList [[type_of(v), aty]])(atm))(ABS(v)(th))

def MK_EXISTS:
  let atm = mk_const(["?", PairList []])
  fun(v): fun(th): AP_TERM(inst(PairList [[type_of(v), aty]])(atm))(ABS(v)(th))

// -------------------------------------------------------------------------
// Eliminate the antecedent of a theorem using a conversion/proof rule.
// -------------------------------------------------------------------------

fun MP_CONV(cnv):
  fun(th):
    let [l, r] = dest_imp(concl(th))
    let ath = cnv(l)
    try:
      MP(th)(EQT_ELIM(ath))
      ~catch Failure(_): MP(th)(ath)

// -------------------------------------------------------------------------
// Multiple beta-reduction (we use a slight variant below).
// -------------------------------------------------------------------------

fun BETAS_CONV(tm):
  match tm
  | Comb(Abs(_, _), _): BETA_CONV(tm)
  | Comb(Comb(_, _), _): (RATOR_CONV(BETAS_CONV) then_conv BETA_CONV)(tm)
  | _: failwith("BETAS_CONV")

// -------------------------------------------------------------------------
// Instantiators.
// -------------------------------------------------------------------------

def instantiate:
  let betas:
    fun(n):
      fun(tm):
        let [args, lam] = funpow(n)(fun([l, t]): [PairList.cons(rand(t), l), rator(t)])([PairList [], tm])
        rev_itlist(fun(a):
                     fun(l):
                       let [v, b] = dest_abs(l)
                       vsubst(PairList [[a, v]])(b))(args)(lam)
  fun ho_betas(bcs):
    fun(pat):
      fun(tm):
        if is_var(pat) || is_const(pat)
        | fail(#void)
        | try:
            let [bv, bod] = dest_abs(tm)
            mk_abs([bv, ho_betas(bcs)(body(pat))(bod)])
            ~catch Failure(_):
              let [hop, args] = strip_comb(pat)
              try:
                let n = rev_assoc(hop)(bcs)
                if length(args) == n | betas(n)(tm) | fail(#void)
                ~catch Failure(_):
                  let [lpat, rpat] = dest_comb(pat)
                  let [ltm, rtm] = dest_comb(tm)
                  try:
                    let lth = ho_betas(bcs)(lpat)(ltm)
                    try:
                      let rth = ho_betas(bcs)(rpat)(rtm)
                      mk_comb([lth, rth])
                      ~catch Failure(_):
                        mk_comb([lth, rtm])
                    ~catch Failure(_):
                      let rth = ho_betas(bcs)(rpat)(rtm)
                      mk_comb([ltm, rth])
  fun([bcs, tmin, tyin]):
    fun(tm):
      let itm = if tyin == PairList [] | tm | inst(tyin)(tm)
      if tmin == PairList []
      | itm
      | let ttm = vsubst(tmin)(itm)
        if bcs == PairList []
        | ttm
        | try:
            ho_betas(bcs)(itm)(ttm)
            ~catch Failure(_): ttm

def INSTANTIATE:
  fun BETAS_CONV(n):
    fun(tm):
      if n == 1
      | TRY_CONV(BETA_CONV)(tm)
      | (RATOR_CONV(BETAS_CONV(n - 1)) then_conv TRY_CONV(BETA_CONV))(tm)
  fun HO_BETAS(bcs):
    fun(pat):
      fun(tm):
        if is_var(pat) || is_const(pat)
        | fail(#void)
        | try:
            let [bv, bod] = dest_abs(tm)
            ABS(bv)(HO_BETAS(bcs)(body(pat))(bod))
            ~catch Failure(_):
              let [hop, args] = strip_comb(pat)
              try:
                let n = rev_assoc(hop)(bcs)
                if length(args) == n | BETAS_CONV(n)(tm) | fail(#void)
                ~catch Failure(_):
                  let [lpat, rpat] = dest_comb(pat)
                  let [ltm, rtm] = dest_comb(tm)
                  try:
                    let lth = HO_BETAS(bcs)(lpat)(ltm)
                    try:
                      let rth = HO_BETAS(bcs)(rpat)(rtm)
                      MK_COMB([lth, rth])
                      ~catch Failure(_):
                        AP_THM(lth)(rtm)
                    ~catch Failure(_):
                      let rth = HO_BETAS(bcs)(rpat)(rtm)
                      AP_TERM(ltm)(rth)
  fun([bcs, tmin, tyin]):
    fun(th):
      let ith = if tyin == PairList [] | th | INST_TYPE(tyin)(th)
      if tmin == PairList []
      | ith
      | let tth = INST(tmin)(ith)
        if hyp(tth) == hyp(th)
        | if bcs == PairList []
          | tth
          | try:
              let eth = HO_BETAS(bcs)(concl(ith))(concl(tth))
              EQ_MP(eth)(tth)
              ~catch Failure(_): tth
        | failwith("INSTANTIATE: term or type var free in assumptions")

fun INSTANTIATE_ALL([_, tmin, tyin] && i):
  fun(th):
    if tmin == PairList [] && tyin == PairList []
    | th
    | let hyps = hyp(th)
      if hyps == PairList []
      | INSTANTIATE(i)(th)
      | let [tyrel, tyiirel]:
          if tyin == PairList []
          | [PairList [], hyps]
          | let tvs = itlist(o(o(union)(tyvars))(snd))(tyin)(PairList [])
            partition(fun(tm):
                        let tvs_prime = type_vars_in_term(tm)
                        !(intersect(tvs)(tvs_prime) == PairList []))(hyps)
        let [tmrel, tmirrel]:
          if tmin == PairList []
          | [PairList [], tyiirel]
          | let vs = itlist(o(o(union)(frees))(snd))(tmin)(PairList [])
            partition(fun(tm):
                        let vs_prime = frees(tm)
                        !(intersect(vs)(vs_prime) == PairList []))(tyiirel)
        let rhyps = union(tyrel)(tmrel)
        let th1 = rev_itlist(DISCH)(rhyps)(th)
        let th2 = INSTANTIATE(i)(th1)
        funpow(length(rhyps))(UNDISCH)(th2)

// -------------------------------------------------------------------------
// Higher order matching of terms.
//
// Note: in the event of spillover patterns, this may return false results;
// but there's usually an implicit check outside that the match worked
// anyway. A test could be put in (see if any "env" variables are left in
// the term after abstracting out the pattern instances) but it'd be slower.
// -------------------------------------------------------------------------

def term_match:
  let safe_inserta:
    fun([y, x] && n):
      fun(l):
        try:
          let z = rev_assoc(x)(l)
          if aconv(y)(z) | l | failwith("safe_inserta")
          ~catch Failure("find"): PairList.cons(n, l)

  let safe_insert:
    fun([y, x] && n):
      fun(l):
        try:
          let z = rev_assoc(x)(l)
          if compare(y)(z) == 0 | l | failwith("safe_insert")
          ~catch Failure("find"): PairList.cons(n, l)

  let mk_dummy:
    let name = fst(dest_var(genvar(aty)))
    fun(ty): mk_var([name, ty])

  fun term_pmatch(lconsts):
    fun(env):
      fun(vtm):
        fun(ctm):
          fun([insts, homs] && sofar):
            match [vtm, ctm]
            | [Var(_, _), _]:
                try:
                  let ctm_prime = rev_assoc(vtm)(env)
                  if compare(ctm_prime)(ctm) == 0
                  | sofar
                  | failwith("term_pmatch")
                  ~catch Failure("find"):
                    if mem(vtm)(lconsts)
                    | if compare(ctm)(vtm) == 0
                      | sofar
                      | failwith("term_pmatch: can't instantiate local constant")
                    | [safe_inserta([ctm, vtm])(insts), homs]
            | [Const(vname, vty), Const(cname, cty)]:
                if compare(vname)(cname) == 0
                | if compare(vty)(cty) == 0
                  | sofar
                  | [safe_insert([mk_dummy(cty), mk_dummy(vty)])(insts), homs]
                | failwith("term_pmatch")
            | [Abs(vv, vbod), Abs(cv, cbod)]:
                let sofar_prime:
                  [safe_insert([mk_dummy(snd(dest_var(cv))), mk_dummy(snd(dest_var(vv)))])(insts),
                   homs]
                term_pmatch(lconsts)(PairList.cons([cv, vv], env))(vbod)(cbod)(sofar_prime)
            | _:
                let vhop = repeat(rator)(vtm)
                if is_var(vhop) && !mem(vhop)(lconsts)
                     && !can(rev_assoc(vhop))(env)
                | let vty = type_of(vtm)
                  let cty = type_of(ctm)
                  let insts_prime:
                    if compare(vty)(cty) == 0
                    | insts
                    | safe_insert([mk_dummy(cty), mk_dummy(vty)])(insts)
                  [insts_prime, PairList.cons([env, ctm, vtm], homs)]
                | let [lv, rv] = dest_comb(vtm)
                  let [lc, rc] = dest_comb(ctm)
                  let sofar_prime = term_pmatch(lconsts)(env)(lv)(lc)(sofar)
                  term_pmatch(lconsts)(env)(rv)(rc)(sofar_prime)

  let get_type_insts:
    fun(insts):
      itlist(fun([t, x]): type_match(snd(dest_var(x)))(type_of(t)))(insts)

  let separate_insts:
    fun(insts):
      let [realinsts, patterns] = partition(o(is_var)(snd))(insts)
      let betacounts:
        if patterns == PairList []
        | PairList []
        | itlist(fun([_, p]):
                   fun(sof):
                     let [hop, args] = strip_comb(p)
                     try:
                       safe_insert([length(args), hop])(sof)
                       ~catch Failure(_):
                         warn(#true)("Inconsistent patterning in higher order match")
                         sof)(patterns)(PairList [])
      let tyins = get_type_insts(realinsts)(PairList [])
      [betacounts,
       mapfilter(fun([t, x]):
                   let x_prime:
                     let [xn, xty] = dest_var(x)
                     mk_var([xn, type_subst(tyins)(xty)])
                   if compare(t)(x_prime) == 0 | fail(#void) | [t, x_prime])(realinsts),
       tyins]

  fun term_homatch(lconsts):
    fun(tyins):
      fun([insts, homs]):
        if homs == PairList []
        | insts
        | let [env, ctm, vtm] = hd(homs)
          if is_var(vtm)
          | if compare(ctm)(vtm) == 0
            | term_homatch(lconsts)(tyins)([insts, tl(homs)])
            | let newtyins = safe_insert([type_of(ctm), snd(dest_var(vtm))])(tyins)
              let newinsts = PairList.cons([ctm, vtm], insts)
              term_homatch(lconsts)(newtyins)([newinsts, tl(homs)])
          | let [vhop, vargs] = strip_comb(vtm)
            let afvs = freesl(vargs)
            let inst_fn = inst(tyins)
            try:
              let tmins:
                map(fun(a):
                      [try:
                         rev_assoc(a)(env)
                         ~catch Failure(_):
                           try:
                             rev_assoc(a)(insts)
                             ~catch Failure(_):
                               if mem(a)(lconsts) | a | fail(#void),
                       inst_fn(a)])(afvs)
              let pats0 = map(inst_fn)(vargs)
              let pats = map(vsubst(tmins))(pats0)
              let vhop_prime = inst_fn(vhop)
              let ni:
                let [chop, cargs] = strip_comb(ctm)
                if compare(cargs)(pats) == 0
                | if compare(chop)(vhop) == 0
                  | insts
                  | safe_inserta([chop, vhop])(insts)
                | let ginsts:
                    map(fun(p): [if is_var(p) | p | genvar(type_of(p)), p])(pats)
                  let ctm_prime = subst(ginsts)(ctm)
                  let gvs = map(fst)(ginsts)
                  let abstm = list_mk_abs([gvs, ctm_prime])
                  let vinsts = safe_inserta([abstm, vhop])(insts)
                  let icpair = [ctm_prime, list_mk_comb([vhop_prime, gvs])]
                  PairList.cons(icpair, vinsts)
              term_homatch(lconsts)(tyins)([ni, tl(homs)])
              ~catch Failure(_):
                let [lc, rc] = dest_comb(ctm)
                let [lv, rv] = dest_comb(vtm)
                let pinsts_homs_prime:
                  term_pmatch(lconsts)(env)(rv)(rc)([insts, PairList.cons([env, lc, lv], tl(homs))])
                let tyins_prime = get_type_insts(fst(pinsts_homs_prime))(PairList [])
                term_homatch(lconsts)(tyins_prime)(pinsts_homs_prime)

  fun(lconsts):
    fun(vtm):
      fun(ctm):
        let pinsts_homs = term_pmatch(lconsts)(PairList [])(vtm)(ctm)([PairList [], PairList []])
        let tyins = get_type_insts(fst(pinsts_homs))(PairList [])
        let insts = term_homatch(lconsts)(tyins)(pinsts_homs)
        separate_insts(insts)

// -------------------------------------------------------------------------
// First order unification of terms of the same type.
// -------------------------------------------------------------------------

def term_unify:
  let augment1:
    fun(sofar):
      fun([s, x]):
        let s_prime = subst(sofar)(s)
        if vfree_in(x)(s_prime) && !(s == x)
        | failwith("term_unify: augment1")
        | [s_prime, x]
  let raw_augment_insts:
    fun(p): fun(insts): PairList.cons(p, map(augment1(PairList [p]))(insts))
  let augment_insts:
    fun([t, v]):
      fun(insts):
        let t_prime = vsubst(insts)(t)
        if t_prime == v
        | insts
        | if vfree_in(v)(t_prime)
          | failwith("augment_insts")
          | raw_augment_insts([t_prime, v])(insts)
  fun unify(vars):
    fun(tm1):
      fun(tm2):
        fun(sofar):
          if tm1 == tm2
          | sofar
          | if is_var(tm1) && mem(tm1)(vars)
            | try:
                let tm1_prime = rev_assoc(tm1)(sofar)
                unify(vars)(tm1_prime)(tm2)(sofar)
                ~catch Failure("find"):
                  augment_insts([tm2, tm1])(sofar)
            | if is_var(tm2) && mem(tm2)(vars)
              | try:
                  let tm2_prime = rev_assoc(tm2)(sofar)
                  unify(vars)(tm1)(tm2_prime)(sofar)
                  ~catch Failure("find"):
                    augment_insts([tm1, tm2])(sofar)
              | if is_abs(tm1)
                | let tm1_prime = body(tm1)
                  let tm2_prime = subst(PairList [[bndvar(tm1), bndvar(tm2)]])(body(tm2))
                  unify(vars)(tm1_prime)(tm2_prime)(sofar)
                | let [l1, r1] = dest_comb(tm1)
                  let [l2, r2] = dest_comb(tm2)
                  unify(vars)(l1)(l2)(unify(vars)(r1)(r2)(sofar))
  fun(vars): fun(tm1): fun(tm2): [PairList [], unify(vars)(tm1)(tm2)(PairList []), PairList []]

// -------------------------------------------------------------------------
// Unification of types.
// -------------------------------------------------------------------------

def type_unify:
  let augment1:
    fun(sofar):
      fun([s, x]):
        let s_prime = type_subst(sofar)(s)
        if occurs_in(x)(s_prime) && !(s == x)
        | failwith("type_unify: augment1")
        | [s_prime, x]
  let raw_augment_insts:
    fun(p): fun(insts): PairList.cons(p, map(augment1(PairList [p]))(insts))
  let augment_insts:
    fun([ty, v]):
      fun(insts):
        let ty_prime = type_subst(insts)(ty)
        if ty_prime == v
        | insts
        | if occurs_in(v)(ty_prime)
          | failwith("type_unify: augment_insts")
          | raw_augment_insts([ty_prime, v])(insts)
  fun unify(ty1):
    fun(ty2):
      fun(sofar):
        if ty1 == ty2
        | sofar
        | if is_vartype(ty1)
          | try:
              let ty1_prime = rev_assoc(ty1)(sofar)
              unify(ty1_prime)(ty2)(sofar)
              ~catch Failure("find"):
                augment_insts([ty2, ty1])(sofar)
          | if is_vartype(ty2)
            | try:
                let ty2_prime = rev_assoc(ty2)(sofar)
                unify(ty1)(ty2_prime)(sofar)
                ~catch Failure("find"):
                  augment_insts([ty1, ty2])(sofar)
            | let [l1, r1] = dest_type(ty1)
              let [l2, r2] = dest_type(ty2)
              if l1 == l2 | itlist2(unify)(r1)(r2)(sofar) | failwith("unify_type")
  unify

// -------------------------------------------------------------------------
// Unification of terms and their types together.
// -------------------------------------------------------------------------

def term_type_unify:
  let augment_tyinsts:
    fun([s, t]):
      fun(tyinsts):
        let sty = type_of(inst(tyinsts)(s))
        let tty = type_of(inst(tyinsts)(t))
        let tyinsts_prime = type_unify(sty)(tty)(PairList [])
        append(tyinsts_prime)(map(fun([ty, v]): [type_subst(tyinsts_prime)(ty), v])(tyinsts))
  let augment1:
    fun(sofar):
      fun([s, x]):
        let s_prime = subst(sofar)(s)
        if vfree_in(x)(s_prime) && !(s == x)
        | failwith("term_unify: augment1")
        | [s_prime, x]
  let raw_augment_insts:
    fun(p):
      fun([tminsts, tyinsts]):
        [PairList.cons(p, map(augment1(PairList [p]))(tminsts)), tyinsts]
  let augment_insts:
    fun([t, v]):
      fun([tminsts, tyinsts]):
        let tminsts_prime = map(fun([t, v]): [inst(tyinsts)(t), inst(tyinsts)(v)])(tminsts)
        let t_prime = inst(tyinsts)(vsubst(tminsts_prime)(t))
        let v_prime = inst(tyinsts)(v)
        let sofar_prime = [tminsts_prime, tyinsts]
        if t_prime == v_prime
        | sofar_prime
        | if vfree_in(v_prime)(t_prime)
          | failwith("term_unify: augment_insts")
          | raw_augment_insts([t_prime, v_prime])(sofar_prime)
  fun unify(tm1):
    fun(tm2):
      fun([tminsts, tyinsts] && sofar):
        if tm1 == tm2
        | sofar
        | if is_var(tm1)
          | try:
              let tm1_prime = rev_assoc(tm1)(tminsts)
              unify(tm1_prime)(tm2)(sofar)
              ~catch Failure("find"):
                augment_insts([tm2, tm1])([tminsts, augment_tyinsts([tm1, tm2])(tyinsts)])
          | if is_var(tm2)
            | try:
                let tm2_prime = rev_assoc(tm2)(tminsts)
                unify(tm1)(tm2_prime)(sofar)
                ~catch Failure("find"):
                  augment_insts([tm1, tm2])([tminsts, augment_tyinsts([tm1, tm2])(tyinsts)])
            | if is_abs(tm1)
              | let tm1_prime = body(tm1)
                let tm2_prime = subst(PairList [[bndvar(tm1), bndvar(tm2)]])(body(tm2))
                unify(tm1_prime)(tm2_prime)(sofar)
              | if is_const(tm1)
                | if name_of(tm1) != name_of(tm2)
                  | failwith("term_unify")
                  | [tminsts, augment_tyinsts([tm1, tm2])(tyinsts)]
                | let [l1, r1] = dest_comb(tm1)
                  let [l2, r2] = dest_comb(tm2)
                  unify(l1)(l2)(unify(r1)(r2)(sofar))
  fun(tm1):
    fun(tm2):
      fun([it, tminsts, tyinsts]):
        let [tminsts_prime, tyinsts_prime] = unify(tm1)(tm2)([tminsts, tyinsts])
        [it, tminsts_prime, tyinsts_prime]

// -------------------------------------------------------------------------
// Modify bound variable names at depth. (Not very efficient...)
// -------------------------------------------------------------------------

def deep_alpha:
  let tryalpha:
    fun(v):
      fun(tm):
        try:
          alpha(v)(tm)
          ~catch Failure(_):
            try:
              let v_prime = variant(frees(tm))(v)
              alpha(v_prime)(tm)
              ~catch Failure(_): tm
  fun deep_alpha(env):
    fun(tm):
      if env == PairList []
      | tm
      | try:
          let [v, bod] = dest_abs(tm)
          let [vn, vty] = dest_var(v)
          try:
            let [[vn_prime, _], newenv] = remove(fun([_, x]): x == vn)(env)
            let v_prime = mk_var([vn_prime, vty])
            let tm_prime = tryalpha(v_prime)(tm)
            let [iv, ib] = dest_abs(tm_prime)
            mk_abs([iv, deep_alpha(newenv)(ib)])
            ~catch Failure(_): mk_abs([v, deep_alpha(env)(bod)])
          ~catch Failure(_):
            try:
              let [l, r] = dest_comb(tm)
              mk_comb([deep_alpha(env)(l), deep_alpha(env)(r)])
              ~catch Failure(_): tm
  deep_alpha

// -------------------------------------------------------------------------
// Instantiate theorem by matching part of it to a term.
// The GEN_PART_MATCH version renames free vars to avoid clashes.
// -------------------------------------------------------------------------

def [PART_MATCH, GEN_PART_MATCH]:
  fun match_bvs(t1):
    fun(t2):
      fun(acc):
        try:
          let [v1, b1] = dest_abs(t1)
          let [v2, b2] = dest_abs(t2)
          let n1 = fst(dest_var(v1))
          let n2 = fst(dest_var(v2))
          let newacc = if n1 == n2 | acc | insert([n1, n2])(acc)
          match_bvs(b1)(b2)(newacc)
          ~catch Failure(_):
            try:
              let [l1, r1] = dest_comb(t1)
              let [l2, r2] = dest_comb(t2)
              match_bvs(l1)(l2)(match_bvs(r1)(r2)(acc))
              ~catch Failure(_): acc
  let PART_MATCH:
    fun(partfn):
      fun(th):
        let sth = SPEC_ALL(th)
        let bod = concl(sth)
        let pbod = partfn(bod)
        let lconsts = intersect(frees(concl(th)))(freesl(hyp(th)))
        fun(tm):
          let bvms = match_bvs(tm)(pbod)(PairList [])
          let abod = deep_alpha(bvms)(bod)
          let ath = EQ_MP(ALPHA(bod)(abod))(sth)
          let insts = term_match(lconsts)(partfn(abod))(tm)
          let fth = INSTANTIATE(insts)(ath)
          if hyp(fth) != hyp(ath)
          | failwith("PART_MATCH: instantiated hyps")
          | let tm_prime = partfn(concl(fth))
            if compare(tm_prime)(tm) == 0
            | fth
            | try:
                SUBS(PairList [ALPHA(tm_prime)(tm)])(fth)
                ~catch Failure(_): failwith("PART_MATCH: Sanity check failure")
  let GEN_PART_MATCH:
    fun(partfn):
      fun(th):
        let sth = SPEC_ALL(th)
        let bod = concl(sth)
        let pbod = partfn(bod)
        let lconsts = intersect(frees(concl(th)))(freesl(hyp(th)))
        let fvs = subtract(subtract(frees(bod))(frees(pbod)))(lconsts)
        fun(tm):
          let bvms = match_bvs(tm)(pbod)(PairList [])
          let abod = deep_alpha(bvms)(bod)
          let ath = EQ_MP(ALPHA(bod)(abod))(sth)
          let insts = term_match(lconsts)(partfn(abod))(tm)
          let eth = INSTANTIATE(insts)(GENL(fvs)(ath))
          let fth = itlist(fun(v): fun(th): snd(SPEC_VAR(th)))(fvs)(eth)
          if hyp(fth) != hyp(ath)
          | failwith("PART_MATCH: instantiated hyps")
          | let tm_prime = partfn(concl(fth))
            if compare(tm_prime)(tm) == 0
            | fth
            | try:
                SUBS(PairList [ALPHA(tm_prime)(tm)])(fth)
                ~catch Failure(_): failwith("PART_MATCH: Sanity check failure")
  [PART_MATCH, GEN_PART_MATCH]

// -------------------------------------------------------------------------
// Matching modus ponens.
// -------------------------------------------------------------------------

fun MATCH_MP(ith):
  let sth:
    try:
      let tm = concl(ith)
      let [avs, bod] = strip_forall(tm)
      let [ant, con] = dest_imp(bod)
      let [svs, pvs] = partition(C(vfree_in)(ant))(avs)
      if pvs == PairList []
      | ith
      | let th1 = SPECL(avs)(ASSUME(tm))
        let th2 = GENL(svs)(DISCH(ant)(GENL(pvs)(UNDISCH(th1))))
        MP(DISCH(tm)(th2))(ith)
      ~catch Failure(_): failwith("MATCH_MP: Not an implication")
  let match_fun = PART_MATCH(o(fst)(dest_imp))(sth)
  fun(th):
    try:
      MP(match_fun(concl(th)))(th)
      ~catch Failure(_): failwith("MATCH_MP: No match")

// -------------------------------------------------------------------------
// Useful instance of more general higher order matching.
// -------------------------------------------------------------------------

def HIGHER_REWRITE_CONV:
  let BETA_VAR:
    fun BETA_CONVS(n):
      if n == 1
      | TRY_CONV(BETA_CONV)
      | RATOR_CONV(BETA_CONVS(n - 1)) then_conv TRY_CONV(BETA_CONV)
    fun free_beta(v):
      fun(tm):
        if is_abs(tm)
        | let [bv, bod] = dest_abs(tm)
          if v == bv
          | failwith("unchanged")
          | ABS_CONV(free_beta(v)(bod))
        | let [op, args] = strip_comb(tm)
          if args == PairList []
          | failwith("unchanged")
          | if op == v
            | BETA_CONVS(length(args))
            | let [l, r] = dest_comb(tm)
              try:
                let lconv = free_beta(v)(l)
                try:
                  let rconv = free_beta(v)(r)
                  COMB2_CONV(lconv)(rconv)
                  ~catch Failure(_): RATOR_CONV(lconv)
                ~catch Failure(_): RAND_CONV(free_beta(v)(r))
    free_beta
  let GINST:
    fun(th):
      let fvs = subtract(frees(concl(th)))(freesl(hyp(th)))
      let gvs = map(o(genvar)(type_of))(fvs)
      INST(zip(gvs)(fvs))(th)
  fun(ths):
    let thl = map(o(GINST)(SPEC_ALL))(ths)
    let concs = map(concl)(thl)
    let lefts = map(lhs)(concs)
    let [preds, pats] = unzip(map(dest_comb)(lefts))
    let beta_fns = map2(BETA_VAR)(preds)(concs)
    let ass_list = zip(pats)(zip(preds)(zip(thl)(beta_fns)))
    let mnet = itlist(fun(p): fun(n): enter(PairList [])([p, p])(n))(pats)(empty_net)
    let look_fn:
      fun(t):
        mapfilter(fun(p): if can(term_match(PairList [])(p))(t) | p | fail(#void))(
          lookup(t)(mnet))
    fun(top):
      fun(tm):
        let pred = fun(t): !(look_fn(t) == PairList []) && free_in(t)(tm)
        let stm:
          if top
          | find_term(pred)(tm)
          | hd(sort(free_in)(find_terms(pred)(tm)))
        let pat = hd(look_fn(stm))
        let [_, tmin, tyin] = term_match(PairList [])(pat)(stm)
        let [pred_prime, [th, beta_fn]] = assoc(pat)(ass_list)
        let gv = genvar(type_of(stm))
        let abs = mk_abs([gv, subst(PairList [[gv, stm]])(tm)])
        let [_, tmin0, tyin0] = term_match(PairList [])(pred_prime)(abs)
        CONV_RULE(beta_fn)(INST(tmin)(INST(tmin0)(INST_TYPE(tyin0)(th))))

// -------------------------------------------------------------------------
// Derived principle of definition justifying |- c x1 .. xn = t[x1,..,xn]
// -------------------------------------------------------------------------

fun new_definition(tm):
  let [avs, bod] = strip_forall(tm)
  let [l, r]:
    try:
      dest_eq(bod)
      ~catch Failure(_): failwith("new_definition: Not an equation")
  let [lv, largs] = strip_comb(l)
  let rtm:
    try:
      list_mk_abs([largs, r])
      ~catch Failure(_): failwith("new_definition: Non-variable in LHS pattern")
  let def_ = mk_eq([lv, rtm])
  let th1 = new_basic_definition(def_)
  let th2:
    rev_itlist(fun(tm):
                 fun(th):
                   let ith = AP_THM(th)(tm)
                   TRANS(ith)(BETA_CONV(rand(concl(ith)))))(largs)(th1)
  let rvs = filter(fun(v): !C(mem)(avs)(v))(largs)
  itlist(GEN)(rvs)(itlist(GEN)(avs)(th2))
