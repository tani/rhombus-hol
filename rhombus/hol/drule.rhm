import: "private/compat.rhm" open
import: "fusion.rhm" open
import: "basics.rhm" open
import: "equal.rhm" open
import: "bool.rhm" open
import: "nets.rhm" open

export:
  mk_thm
  MK_CONJ
  MK_DISJ
  MK_FORALL
  MK_EXISTS
  MP_CONV
  BETAS_CONV
  instantiate
  INSTANTIATE
  INSTANTIATE_ALL
  term_match
  term_unify
  type_unify
  term_type_unify
  deep_alpha
  PART_MATCH
  GEN_PART_MATCH
  MATCH_MP
  HIGHER_REWRITE_CONV
  new_definition

fun plist_rev(l):
  rev_itlist(fun(x): fun(acc): PairList.cons(x,acc))(l)(PairList [])

fun intersect(l1):
  fun(l2): filter(fun(x): mem(x)(l2))(l1)
fun repeat(f):
  fun(x):
    try:
      repeat(f)(f(x))
      ~catch Failure(_): x

fun funpow(n):
  fun(f):
    fun(x):
      if n <= 0 | x | funpow(n-1)(f)(f(x))

fun map2(f):
  fun(l1):
    fun(l2):
      match [l1, l2]
      | [PairList [], PairList []]: PairList []
      | [PairList [h1, & t1], PairList [h2, & t2]]:
          PairList.cons(f(h1)(h2),map2(f)(t1)(t2))
      | _: failwith("map2")

fun remove_first(p):
  fun(l):
    match l
    | PairList []: failwith("remove")
    | PairList [h, & t]:
        if p(h)
        | [h, t]
        | let [found, rest] = remove_first(p)(t)
          [found, PairList.cons(h,rest)]

fun name_of(tm):
  try:
    fst(dest_var(tm))
    ~catch Failure(_): fst(dest_const(tm))

// Last recourse, exactly as HOL Light: create an implication axiom and
// immediately discharge it back to the requested sequent.
fun mk_thm([asl, c]):
  let ax = new_axiom(itlist(curry(mk_imp))(plist_rev(asl))(c))
  rev_itlist(fun(t): fun(th): MP(th)(ASSUME(t)))(plist_rev(asl))(ax)

def andtm = mk_const(["/\\", PairList []])
fun MK_CONJ(eq1): fun(eq2): MK_COMB([AP_TERM(andtm)(eq1), eq2])

def ortm = mk_const(["\\/", PairList []])
fun MK_DISJ(eq1): fun(eq2): MK_COMB([AP_TERM(ortm)(eq1), eq2])

def forall_tm = mk_const(["!", PairList []])
fun MK_FORALL(v):
  fun(th): AP_TERM(inst(PairList [[type_of(v), aty]])(forall_tm))(ABS(v)(th))
def exists_tm = mk_const(["?", PairList []])
fun MK_EXISTS(v):
  fun(th): AP_TERM(inst(PairList [[type_of(v), aty]])(exists_tm))(ABS(v)(th))
fun MP_CONV(cnv):
  fun(th):
    let [l, _] = dest_imp(concl(th))
    let ath = cnv(l)
    try:
      MP(th)(EQT_ELIM(ath))
      ~catch Failure(_): MP(th)(ath)

fun BETAS_CONV(tm):
  match tm
  | Comb(Abs(_,_),_): BETA_CONV(tm)
  | Comb(Comb(_,_),_): THENC(RATOR_CONV(BETAS_CONV))(BETA_CONV)(tm)
  | _: failwith("BETAS_CONV")

fun beta_n(n):
  fun(tm):
    if n == 1
    | TRY_CONV(BETA_CONV)(tm)
    | THENC(RATOR_CONV(beta_n(n-1)))(TRY_CONV(BETA_CONV))(tm)

fun term_beta_n(n,tm):
  fun peel(k,args,t):
    if k == 0 | [args, t] | peel(k-1,PairList.cons(rand(t),args),rator(t))
  let [args, lam] = peel(n,PairList [],tm)
  rev_itlist(
    fun(a):
      fun(l):
        let [v, b] = dest_abs(l)
        vsubst(PairList [[a, v]])(b)
  )(args)(lam)

fun ho_betas_term(bcs):
  fun(pat):
    fun(tm):
      if is_var(pat) || is_const(pat)
      | fail()
      | try:
          let [bv, bod] = dest_abs(tm)
          mk_abs([bv, ho_betas_term(bcs)(body(pat))(bod)])
          ~catch Failure(_):
            let [hop, args] = strip_comb(pat)
            try:
              let n = rev_assoc(hop)(bcs)
              if length(args) == n | term_beta_n(n,tm) | fail()
              ~catch Failure(_):
                let [lpat, rpat] = dest_comb(pat)
                let [ltm, rtm] = dest_comb(tm)
                try:
                  let lth = ho_betas_term(bcs)(lpat)(ltm)
                  try:
                    mk_comb([lth, ho_betas_term(bcs)(rpat)(rtm)])
                    ~catch Failure(_): mk_comb([lth, rtm])
                  ~catch Failure(_):
                    mk_comb([ltm, ho_betas_term(bcs)(rpat)(rtm)])

fun instantiate([bcs, tmin, tyin]):
  fun(tm):
    let itm = if tyin == PairList [] | tm | inst(tyin)(tm)
    if tmin == PairList []
    | itm
    | let ttm = vsubst(tmin)(itm)
      if bcs == PairList []
      | ttm
      | try:
          ho_betas_term(bcs)(itm)(ttm)
          ~catch Failure(_): ttm

fun HO_BETAS(bcs):
  fun(pat):
    fun(tm):
      if is_var(pat) || is_const(pat)
      | fail()
      | try:
          let [bv, bod] = dest_abs(tm)
          ABS(bv)(HO_BETAS(bcs)(body(pat))(bod))
          ~catch Failure(_):
            let [hop, args] = strip_comb(pat)
            try:
              let n = rev_assoc(hop)(bcs)
              if length(args) == n | beta_n(n)(tm) | fail()
              ~catch Failure(_):
                let [lpat, rpat] = dest_comb(pat)
                let [ltm, rtm] = dest_comb(tm)
                try:
                  let lth = HO_BETAS(bcs)(lpat)(ltm)
                  try:
                    MK_COMB([lth, HO_BETAS(bcs)(rpat)(rtm)])
                    ~catch Failure(_): AP_THM(lth)(rtm)
                  ~catch Failure(_):
                    AP_TERM(ltm)(HO_BETAS(bcs)(rpat)(rtm))

fun INSTANTIATE([bcs, tmin, tyin]):
  fun(th):
    let ith = if tyin == PairList [] | th | INST_TYPE(tyin)(th)
    if tmin == PairList []
    | ith
    | let tth = INST(tmin)(ith)
      if hyp(tth) != hyp(th)
      | failwith("INSTANTIATE: term or type var free in assumptions")
      | if bcs == PairList []
        | tth
        | try:
            EQ_MP(HO_BETAS(bcs)(concl(ith))(concl(tth)))(tth)
            ~catch Failure(_): tth

fun INSTANTIATE_ALL([bcs, tmin, tyin] as i):
  fun(th):
    if tmin == PairList [] && tyin == PairList []
    | th
    | let hs = hyp(th)
      if hs == PairList []
      | INSTANTIATE(i)(th)
      | let [tyrel, tyirrel]:
          if tyin == PairList []
          | [PairList [], hs]
          | let tvs = itlist(fun([_, v]): fun(acc): union(tyvars(v))(acc))(tyin)(PairList [])
            partition(fun(tm): intersect(tvs)(type_vars_in_term(tm)) != PairList [])(hs)
        let [tmrel, _]:
          if tmin == PairList []
          | [PairList [], tyirrel]
          | let vs = itlist(fun([_, v]): fun(acc): union(frees(v))(acc))(tmin)(PairList [])
            partition(fun(tm): intersect(vs)(frees(tm)) != PairList [])(tyirrel)
        let rhyps = union(tyrel)(tmrel)
        funpow(length(rhyps))(UNDISCH)(
          INSTANTIATE(i)(rev_itlist(DISCH)(rhyps)(th)))

fun safe_inserta([y, x] :: List):
  fun(l):
    try:
      let z = rev_assoc(x)(l)
      if aconv(y)(z) | l | failwith("safe_inserta")
      ~catch Failure("find"): PairList.cons([y, x],l)

fun safe_insert([y, x] :: List):
  fun(l):
    try:
      let z = rev_assoc(x)(l)
      if compare(y)(z) == 0 | l | failwith("safe_insert")
      ~catch Failure("find"): PairList.cons([y, x],l)

def dummy_name = fst(dest_var(genvar(aty)))
fun mk_dummy(ty): mk_var([dummy_name, ty])

class HOM(env,ctm,vtm)

fun term_pmatch(lconsts):
  fun(env):
    fun(vtm):
      fun(ctm):
        fun([insts, homs]):
          match [vtm, ctm]
          | [Var(_,_), _]:
              try:
                let ctm1 = rev_assoc(vtm)(env)
                if compare(ctm1)(ctm) == 0
                | [insts, homs]
                | failwith("term_pmatch")
                ~catch Failure("find"):
                  if mem(vtm)(lconsts)
                  | if compare(ctm)(vtm) == 0
                    | [insts, homs]
                    | failwith("term_pmatch: can't instantiate local constant")
                  | [safe_inserta([ctm, vtm])(insts), homs]
          | [Const(vname,vty), Const(cname,cty)]:
              if vname != cname
              | failwith("term_pmatch")
              | if vty == cty
                | [insts, homs]
                | [safe_insert([mk_dummy(cty), mk_dummy(vty)])(insts), homs]
          | [Abs(vv,vbod), Abs(cv,cbod)]:
              let insts1 = safe_insert(
                [mk_dummy(snd(dest_var(cv))), mk_dummy(snd(dest_var(vv)))])(insts)
              term_pmatch(lconsts)(PairList.cons([cv, vv],env))(vbod)(cbod)([insts1, homs])
          | _:
              let vhop = repeat(rator)(vtm)
              if is_var(vhop) && !mem(vhop)(lconsts) && !can(rev_assoc(vhop))(env)
              | let vty = type_of(vtm)
                let cty = type_of(ctm)
                let insts1 = if vty == cty | insts | safe_insert([mk_dummy(cty), mk_dummy(vty)])(insts)
                [insts1, PairList.cons(HOM(env,ctm,vtm),homs)]
              | let [lv, rv] = dest_comb(vtm)
                let [lc, rc] = dest_comb(ctm)
                let sofar = term_pmatch(lconsts)(env)(lv)(lc)([insts, homs])
                term_pmatch(lconsts)(env)(rv)(rc)(sofar)

fun get_type_insts(insts):
  itlist(
    fun([t, x]):
      fun(acc):
        type_match(snd(dest_var(x)))(type_of(t))(acc)
  )(insts)(PairList [])

fun separate_insts(insts):
  let [realinsts, patterns] = partition(o(is_var)(snd))(insts)
  let betacounts:
    itlist(
      fun([_, p]):
        fun(acc):
          let [hop, args] = strip_comb(p)
          try:
            safe_insert([length(args), hop])(acc)
            ~catch Failure(_): acc
    )(patterns)(PairList [])
  let tyins = get_type_insts(realinsts)
  let tmins:
    mapfilter(
      fun([t, x]):
        let [xn, xty] = dest_var(x)
        let x1 = mk_var([xn, type_subst(tyins)(xty)])
        if compare(t)(x1) == 0 | fail() | [t, x1]
    )(realinsts)
  [betacounts, tmins, tyins]

fun term_homatch(lconsts):
  fun(tyins):
    fun([insts, homs]):
      match homs
      | PairList []: insts
      | PairList [HOM(env,ctm,vtm), & rest]:
          if is_var(vtm)
          | if compare(ctm)(vtm) == 0
            | term_homatch(lconsts)(tyins)([insts, rest])
            | let newtyins = safe_insert([type_of(ctm), snd(dest_var(vtm))])(tyins)
              term_homatch(lconsts)(newtyins)([PairList.cons([ctm, vtm],insts), rest])
          | let [vhop, vargs] = strip_comb(vtm)
            let afvs = freesl(vargs)
            let inst_fn = inst(tyins)
            try:
              let tmins:
                map(
                  fun(a):
                    [
                      try:
                        rev_assoc(a)(env)
                        ~catch Failure(_):
                          try:
                            rev_assoc(a)(insts)
                            ~catch Failure(_): if mem(a)(lconsts) | a | fail(),inst_fn(a)]
                )(afvs)
              let pats0 = map(inst_fn)(vargs)
              let pats = map(vsubst(tmins))(pats0)
              let vhop1 = inst_fn(vhop)
              let ni:
                let [chop, cargs] = strip_comb(ctm)
                if cargs == pats
                | (if compare(chop)(vhop) == 0 | insts | safe_inserta([chop, vhop])(insts))
                | let ginsts = map(fun(p): [(if is_var(p) | p | genvar(type_of(p))), p])(pats)
                  let ctm1 = subst(ginsts)(ctm)
                  let gvs = map(fst)(ginsts)
                  let abstm = list_mk_abs([gvs, ctm1])
                  let vinsts = safe_inserta([abstm, vhop])(insts)
                  PairList.cons([ctm1, list_mk_comb([vhop1, gvs])],vinsts)
              term_homatch(lconsts)(tyins)([ni, rest])
              ~catch Failure(_):
                let [lc, rc] = dest_comb(ctm)
                let [lv, rv] = dest_comb(vtm)
                let pm = term_pmatch(lconsts)(env)(rv)(rc)(
                           [insts, PairList.cons(HOM(env,lc,lv),rest)])
                term_homatch(lconsts)(get_type_insts(fst(pm)))(pm)

fun term_match(lconsts):
  fun(vtm):
    fun(ctm):
      let pm = term_pmatch(lconsts)(PairList [])(vtm)(ctm)([PairList [], PairList []])
      let tyins = get_type_insts(fst(pm))
      separate_insts(term_homatch(lconsts)(tyins)(pm))

fun augment1_terms(sofar):
  fun([s, x]):
    let s1 = subst(sofar)(s)
    if vfree_in(x)(s1) && s1 != x | failwith("term_unify: augment1") | [s1, x]

fun raw_augment_insts(p):
  fun(insts): PairList.cons(p,map(augment1_terms(PairList [p]))(insts))
fun augment_insts([t, v]):
  fun(insts):
    let t1 = vsubst(insts)(t)
    if t1 == v
    | insts
    | (if vfree_in(v)(t1) | failwith("augment_insts") | raw_augment_insts([t1, v])(insts))

fun term_unify(vars):
  fun(tm1):
    fun(tm2):
      fun unify(a,b,sofar):
        if a == b
        | sofar
        | if is_var(a) && mem(a)(vars)
          | try:
              unify(rev_assoc(a)(sofar),b,sofar)
              ~catch Failure("find"): augment_insts([b, a])(sofar)
          | if is_var(b) && mem(b)(vars)
            | try:
                unify(a,rev_assoc(b)(sofar),sofar)
                ~catch Failure("find"): augment_insts([a, b])(sofar)
            | if is_abs(a)
              | let [va, ba] = dest_abs(a)
                let [vb, bb] = dest_abs(b)
                unify(ba,subst(PairList [[va, vb]])(bb),sofar)
              | let [l1, r1] = dest_comb(a)
                let [l2, r2] = dest_comb(b)
                unify(l1,l2,unify(r1,r2,sofar))
      [PairList [], unify(tm1,tm2,PairList []), PairList []]

fun augment1_types(sofar):
  fun([s, x]):
    let s1 = type_subst(sofar)(s)
    if occurs_in(x)(s1) && s1 != x | failwith("type_unify: augment1") | [s1, x]

fun raw_augment_tyinsts(p):
  fun(insts): PairList.cons(p,map(augment1_types(PairList [p]))(insts))
fun augment_ty([ty, v]):
  fun(insts):
    let ty1 = type_subst(insts)(ty)
    if ty1 == v
    | insts
    | (if occurs_in(v)(ty1) | failwith("type_unify: augment_insts") | raw_augment_tyinsts([ty1, v])(insts))

fun type_unify(ty1):
  fun(ty2):
    fun(sofar):
      if ty1 == ty2
      | sofar
      | if is_vartype(ty1)
        | try:
            type_unify(rev_assoc(ty1)(sofar))(ty2)(sofar)
            ~catch Failure("find"): augment_ty([ty2, ty1])(sofar)
        | if is_vartype(ty2)
          | try:
              type_unify(ty1)(rev_assoc(ty2)(sofar))(sofar)
              ~catch Failure("find"): augment_ty([ty1, ty2])(sofar)
          | let [l1, r1] = dest_type(ty1)
            let [l2, r2] = dest_type(ty2)
            if l1 == l2 | itlist2(type_unify)(r1)(r2)(sofar) | failwith("unify_type")

fun term_type_unify(tm1):
  fun(tm2):
    fun([bcs, tmin, tyin]):
      fun augment_types([s, t],tyinsts):
        let sty = type_of(inst(tyinsts)(s))
        let tty = type_of(inst(tyinsts)(t))
        let new = type_unify(sty)(tty)(PairList [])
        append(new)(map(fun([ty, v]): [type_subst(new)(ty), v])(tyinsts))
      let augment1 = fun(sofar):
        fun([s, x]):
          let s_prime = subst(sofar)(s)
          if vfree_in(x)(s_prime) && s != x
          | failwith("term_unify: augment1")
          | [s_prime, x]
      fun raw_augment(p,[tmins, tyins]):
        [PairList.cons(p,map(augment1(PairList [p]))(tmins)), tyins]
      fun augment([t, v],[tmins, tyins]):
        let tmins_prime = map(fun([t, v]): [inst(tyins)(t), inst(tyins)(v)])(tmins)
        let t_prime = inst(tyins)(vsubst(tmins_prime)(t))
        let v_prime = inst(tyins)(v)
        let sofar_prime = [tmins_prime, tyins]
        cond
        | t_prime == v_prime: sofar_prime
        | vfree_in(v_prime)(t_prime): failwith("term_unify: augment_insts")
        | ~else: raw_augment([t_prime, v_prime],sofar_prime)
      fun unify(a,b,tmins,tyins):
        if a == b
        | [tmins, tyins]
        | if is_var(a)
          | try:
              unify(rev_assoc(a)(tmins),b,tmins,tyins)
              ~catch Failure("find"):
                augment([b, a],[tmins, augment_types([a, b],tyins)])
          | if is_var(b)
            | try:
                unify(a,rev_assoc(b)(tmins),tmins,tyins)
                ~catch Failure("find"):
                  augment([a, b],[tmins, augment_types([a, b],tyins)])
            | if is_abs(a)
              | let [va, ba] = dest_abs(a)
                let [vb, bb] = dest_abs(b)
                unify(ba,subst(PairList [[va, vb]])(bb),tmins,tyins)
              | if is_const(a)
                | if name_of(a) != name_of(b)
                  | failwith("term_unify")
                  | [tmins, augment_types([a, b],tyins)]
                | let [l1, r1] = dest_comb(a)
                  let [l2, r2] = dest_comb(b)
                  let [ts1, ys1] = unify(r1,r2,tmins,tyins)
                  unify(l1,l2,ts1,ys1)
      let [tmins, tyins] = unify(tm1,tm2,tmin,tyin)
      [bcs, tmins, tyins]

fun deep_alpha(env):
  fun(tm):
    if env == PairList []
    | tm
    | try:
        let [v, bod] = dest_abs(tm)
        let [vn, vty] = dest_var(v)
        try:
          let [[vn1, _], newenv] = remove_first(fun([_, x]): x == vn)(env)
          let v1 = mk_var([vn1, vty])
          let tm1:
            try:
              alpha(v1)(tm)
              ~catch Failure(_):
                try:
                  let vv = variant(frees(tm))(v1)
                  alpha(vv)(tm)
                  ~catch Failure(_): tm
          let [iv, ib] = dest_abs(tm1)
          mk_abs([iv, deep_alpha(newenv)(ib)])
          ~catch Failure(_): mk_abs([v, deep_alpha(env)(bod)])
        ~catch Failure(_):
          try:
            let [l, r] = dest_comb(tm)
            mk_comb([deep_alpha(env)(l), deep_alpha(env)(r)])
            ~catch Failure(_): tm

fun match_bvs(t1):
  fun(t2):
    fun(acc):
      try:
        let [v1, b1] = dest_abs(t1)
        let [v2, b2] = dest_abs(t2)
        let n1 = fst(dest_var(v1))
        let n2 = fst(dest_var(v2))
        match_bvs(b1)(b2)(if n1 == n2 | acc | insert([n1, n2])(acc))
        ~catch Failure(_):
          try:
            let [l1, r1] = dest_comb(t1)
            let [l2, r2] = dest_comb(t2)
            match_bvs(l1)(l2)(match_bvs(r1)(r2)(acc))
            ~catch Failure(_): acc

fun PART_MATCH(partfn):
  fun(th):
    let sth = SPEC_ALL(th)
    let bod = concl(sth)
    let pbod = partfn(bod)
    let lconsts = intersect(frees(concl(th)))(freesl(hyp(th)))
    fun(tm):
      let bvms = match_bvs(tm)(pbod)(PairList [])
      let abod = deep_alpha(bvms)(bod)
      let ath = EQ_MP(ALPHA(bod)(abod))(sth)
      let insts = term_match(lconsts)(partfn(abod))(tm)
      let fth = INSTANTIATE(insts)(ath)
      if hyp(fth) != hyp(ath)
      | failwith("PART_MATCH: instantiated hyps")
      | let tm1 = partfn(concl(fth))
        if compare(tm1)(tm) == 0
        | fth
        | try:
            SUBS(PairList [ALPHA(tm1)(tm)])(fth)
            ~catch Failure(_): failwith("PART_MATCH: Sanity check failure")
fun GEN_PART_MATCH(partfn):
  fun(th):
    let sth = SPEC_ALL(th)
    let bod = concl(sth)
    let pbod = partfn(bod)
    let lconsts = intersect(frees(concl(th)))(freesl(hyp(th)))
    let fvs = subtract(subtract(frees(bod))(frees(pbod)))(lconsts)
    fun(tm):
      let bvms = match_bvs(tm)(pbod)(PairList [])
      let abod = deep_alpha(bvms)(bod)
      let ath = EQ_MP(ALPHA(bod)(abod))(sth)
      let insts = term_match(lconsts)(partfn(abod))(tm)
      let eth = INSTANTIATE(insts)(GENL(fvs)(ath))
      let fth = itlist(fun(v): fun(x): snd(SPEC_VAR(x)))(fvs)(eth)
      if hyp(fth) != hyp(ath)
      | failwith("PART_MATCH: instantiated hyps")
      | let tm1 = partfn(concl(fth))
        if compare(tm1)(tm) == 0
        | fth
        | try:
            SUBS(PairList [ALPHA(tm1)(tm)])(fth)
            ~catch Failure(_): failwith("PART_MATCH: Sanity check failure")
fun MATCH_MP(ith):
  let sth:
    try:
      let tm = concl(ith)
      let [avs, bod] = strip_forall(tm)
      let [ant, _] = dest_imp(bod)
      let [svs, pvs] = partition(fun(v): vfree_in(v)(ant))(avs)
      if pvs == PairList []
      | ith
      | let th1 = SPECL(avs)(ASSUME(tm))
        let th2 = GENL(svs)(DISCH(ant)(GENL(pvs)(UNDISCH(th1))))
        MP(DISCH(tm)(th2))(ith)
      ~catch Failure(_): failwith("MATCH_MP: Not an implication")
  let match_fun = PART_MATCH(o(fst)(dest_imp))(sth)
  fun(th):
    try:
      MP(match_fun(concl(th)))(th)
      ~catch Failure(_): failwith("MATCH_MP: No match")
fun BETA_CONVS(n):
  if n == 1
  | TRY_CONV(BETA_CONV)
  | THENC(RATOR_CONV(BETA_CONVS(n-1)))(TRY_CONV(BETA_CONV))
fun BETA_VAR(v):
  fun(tm):
    if is_abs(tm)
    | let [bv, bod] = dest_abs(tm)
      if v == bv | failwith("unchanged") | ABS_CONV(BETA_VAR(v)(bod))
    | let [op, args] = strip_comb(tm)
      if args == PairList []
      | failwith("unchanged")
      | if op == v
        | BETA_CONVS(length(args))
        | let [l, r] = dest_comb(tm)
          try:
            let lc = BETA_VAR(v)(l)
            try:
              COMB2_CONV(lc)(BETA_VAR(v)(r))
              ~catch Failure(_): RATOR_CONV(lc)
            ~catch Failure(_): RAND_CONV(BETA_VAR(v)(r))

fun GINST(th):
  let fvs = subtract(frees(concl(th)))(freesl(hyp(th)))
  let gvs = map(o(genvar)(type_of))(fvs)
  INST(zip(gvs)(fvs))(th)

fun HIGHER_REWRITE_CONV(ths):
  let thl = map(o(GINST)(SPEC_ALL))(ths)
  let concs = map(concl)(thl)
  let lefts = map(lhs)(concs)
  let pairs = map(dest_comb)(lefts)
  let [preds, pats] = unzip(pairs)
  let beta_fns = map2(BETA_VAR)(preds)(concs)
  let ass_list = zip(pats)(zip(preds)(zip(thl)(beta_fns)))
  let mnet = itlist(fun(p): fun(n): enter(PairList [])([p, p])(n))(pats)(empty_net)
  fun(top):
    fun(tm):
      fun look_fn(t):
        mapfilter(fun(p): if can(term_match(PairList [])(p))(t) | p | fail())(lookup(t)(mnet))
      fun pred(t): look_fn(t) != PairList [] && free_in(t)(tm)
      let stm:
        if top
        | find_term(pred)(tm)
        | hd(sort(free_in)(find_terms(pred)(tm)))
      let pat = hd(look_fn(stm))
      let [_, mi_tmin, _] = term_match(PairList [])(pat)(stm)
      let [predtm, [th, beta_fn]] = assoc(pat)(ass_list)
      let gv = genvar(type_of(stm))
      let abs = mk_abs([gv, subst(PairList [[gv, stm]])(tm)])
      let [_, mi0_tmin, mi0_tyin] = term_match(PairList [])(predtm)(abs)
      CONV_RULE(beta_fn)(
        INST(mi_tmin)(INST(mi0_tmin)(INST_TYPE(mi0_tyin)(th))))
fun new_definition(tm):
  let [avs, bod] = strip_forall(tm)
  let [l, r]:
    try:
      dest_eq(bod)
      ~catch Failure(_): failwith("new_definition: Not an equation")
  let [lv, largs] = strip_comb(l)
  let rtm:
    try:
      list_mk_abs([largs, r])
      ~catch Failure(_): failwith("new_definition: Non-variable in LHS pattern")
  let defn = mk_eq([lv, rtm])
  let th1 = new_basic_definition(defn)
  let th2:
    rev_itlist(
      fun(arg):
        fun(th):
          let ith = AP_THM(th)(arg)
          TRANS(ith)(BETA_CONV(rand(concl(ith))))
    )(largs)(th1)
  let rvs = filter(fun(v): !mem(v)(avs))(largs)
  itlist(GEN)(rvs)(itlist(GEN)(avs)(th2))
