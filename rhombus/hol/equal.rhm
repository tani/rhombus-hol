#lang rhombus
// (c) University of Cambridge 1998; John Harrison 1998-2007. See ../LICENSE.
// Algorithm-preserving translation of equal.ml's proof/conversion API.
// PRINT_TERM_CONV is excluded pending the printer.ml port.
import: "private/compat.rhm" open
import: "fusion.rhm" open
import: "basics.rhm" open
import: "nets.rhm" open
export:
  lhand
  lhs
  rhs
  mk_primed_var
  BETA_CONV
  AP_TERM
  AP_THM
  SYM
  ALPHA
  ALPHA_CONV
  GEN_ALPHA_CONV
  MK_BINOP
  NO_CONV
  ALL_CONV
  THENC
  ORELSEC
  FIRST_CONV
  EVERY_CONV
  REPEATC
  CHANGED_CONV
  TRY_CONV
  RATOR_CONV
  RAND_CONV
  LAND_CONV
  COMB2_CONV
  COMB_CONV
  ABS_CONV
  BINDER_CONV
  SUB_CONV
  BINOP_CONV
  BINOP2_CONV
  ONCE_DEPTH_CONV
  DEPTH_CONV
  REDEPTH_CONV
  TOP_DEPTH_CONV
  TOP_SWEEP_CONV
  DEPTH_BINOP_CONV
  PATH_CONV
  PAT_CONV
  SYM_CONV
  CONV_RULE
  SUBS_CONV
  BETA_RULE
  GSYM
  SUBS
  CACHE_CONV
def lhand = o(rand)(rator)
def lhs = o(fst)(dest_eq)
def rhs = o(snd)(dest_eq)
fun mk_primed_var(avoid):
  fun svariant(avoid,s):
    if mem(s)(avoid) || can(get_const_type)(s)
    | svariant(avoid,s +& "'")
    | s
  fun(v):
    let [s, ty] = dest_var(v)
    let s1 = svariant(mapfilter(o(fst)(dest_var))(avoid),s)
    mk_var([s1, ty])
fun BETA_CONV(tm):
  try:
    BETA(tm)
    ~catch Failure(_):
      try:
        let [f, arg] = dest_comb(tm)
        let v = bndvar(f)
        INST(PairList [[arg, v]])(BETA(mk_comb([f, v])))
        ~catch Failure(_): failwith("BETA_CONV: Not a beta-redex")
fun AP_TERM(tm):
  let rth = REFL(tm)
  fun(th):
    try:
      MK_COMB([rth, th])
      ~catch Failure(_): failwith("AP_TERM")
fun AP_THM(th):
  fun(tm):
    try:
      MK_COMB([th, REFL(tm)])
      ~catch Failure(_): failwith("AP_THM")
fun SYM(th):
  let tm = concl(th)
  let [l, r] = dest_eq(tm)
  let lth = REFL(l)
  EQ_MP(MK_COMB([AP_TERM(rator(rator(tm)))(th), lth]))(lth)
fun ALPHA(tm1):
  fun(tm2):
    try:
      TRANS(REFL(tm1))(REFL(tm2))
      ~catch Failure(_): failwith("ALPHA")
fun ALPHA_CONV(v): fun(tm): ALPHA(tm)(alpha(v)(tm))
fun GEN_ALPHA_CONV(v):
  fun(tm):
    if is_abs(tm)
    | ALPHA_CONV(v)(tm)
    | block:
        let [b, abs] = dest_comb(tm)
        AP_TERM(b)(ALPHA_CONV(v)(abs))
fun MK_BINOP(op):
  let afn = AP_TERM(op)
  fun([lth, rth]): MK_COMB([afn(lth), rth])
fun NO_CONV(tm): failwith("NO_CONV")
def ALL_CONV = REFL
fun THENC(conv1):
  fun(conv2):
    fun(t):
      let th1 = conv1(t)
      let th2 = conv2(rand(concl(th1)))
      TRANS(th1)(th2)
fun ORELSEC(conv1):
  fun(conv2):
    fun(t):
      try:
        conv1(t)
        ~catch Failure(_): conv2(t)
def FIRST_CONV = end_itlist(ORELSEC)
fun EVERY_CONV(l): itlist(THENC)(l)(ALL_CONV)
fun REPEATC(conv): fun(t): ORELSEC(THENC(conv)(REPEATC(conv)))(ALL_CONV)(t)
fun CHANGED_CONV(conv):
  fun(tm):
    let th = conv(tm)
    let [l, r] = dest_eq(concl(th))
    if aconv(l)(r) | failwith("CHANGED_CONV") | th
fun TRY_CONV(conv): ORELSEC(conv)(ALL_CONV)
fun RATOR_CONV(conv):
  fun(tm):
    match tm
    | Comb(l,r): AP_THM(conv(l))(r)
    | _: failwith("RATOR_CONV: Not a combination")
fun RAND_CONV(conv):
  fun(tm):
    match tm
    | Comb(l,r): MK_COMB([REFL(l), conv(r)])
    | _: failwith("RAND_CONV: Not a combination")
def LAND_CONV = o(RATOR_CONV)(RAND_CONV)
fun COMB2_CONV(lconv):
  fun(rconv):
    fun(tm):
      match tm
      | Comb(l,r):
          // OCaml 4.14.1 evaluates tuple arguments right-to-left.
          let rth = rconv(r)
          let lth = lconv(l)
          MK_COMB([lth, rth])
      | _: failwith("COMB2_CONV: Not a combination")
def COMB_CONV = W(COMB2_CONV)
fun ABS_CONV(conv):
  fun(tm):
    let [v, bod] = dest_abs(tm)
    let th = conv(bod)
    try:
      ABS(v)(th)
      ~catch Failure(_):
        let gv = genvar(type_of(v))
        let gbod = vsubst(PairList [[gv, v]])(bod)
        let gth = ABS(gv)(conv(gbod))
        let gtm = concl(gth)
        let [l, r] = dest_eq(gtm)
        let v1 = variant(frees(gtm))(v)
        let l1 = alpha(v1)(l)
        let r1 = alpha(v1)(r)
        EQ_MP(ALPHA(gtm)(mk_eq([l1, r1])))(gth)
fun BINDER_CONV(conv):
  fun(tm): if is_abs(tm) | ABS_CONV(conv)(tm) | RAND_CONV(ABS_CONV(conv))(tm)
fun SUB_CONV(conv):
  fun(tm):
    match tm
    | Comb(_,_): COMB_CONV(conv)(tm)
    | Abs(_,_): ABS_CONV(conv)(tm)
    | _: REFL(tm)
fun BINOP_CONV(conv):
  fun(tm):
    let [lop, r] = dest_comb(tm)
    let [op, l] = dest_comb(lop)
    let rth = conv(r)
    let lth = AP_TERM(op)(conv(l))
    MK_COMB([lth, rth])
fun BINOP2_CONV(conv1):
  fun(conv2):
    fun(tm):
      let [lop, r] = dest_comb(tm)
      let [op, l] = dest_comb(lop)
      let rth = conv2(r)
      let lth = AP_TERM(op)(conv1(l))
      MK_COMB([lth, rth])
fun THENQC(conv1):
  fun(conv2):
    fun(tm):
      try:
        let th1 = conv1(tm)
        try:
          let th2 = conv2(rand(concl(th1)))
          TRANS(th1)(th2)
          ~catch Failure(_): th1
        ~catch Failure(_): conv2(tm)
fun THENCQC(conv1):
  fun(conv2):
    fun(tm):
      let th1 = conv1(tm)
      try:
        let th2 = conv2(rand(concl(th1)))
        TRANS(th1)(th2)
        ~catch Failure(_): th1
fun COMB_QCONV(conv):
  fun(tm):
    match tm
    | Comb(l,r):
        try:
          let th1 = conv(l)
          try:
            let th2 = conv(r)
            MK_COMB([th1, th2])
            ~catch Failure(_): AP_THM(th1)(r)
          ~catch Failure(_): AP_TERM(l)(conv(r))
    | _: failwith("COMB_QCONV: Not a combination")
fun REPEATQC(conv): fun(tm): THENCQC(conv)(REPEATQC(conv))(tm)
fun SUB_QCONV(conv):
  fun(tm):
    match tm
    | Abs(_,_): ABS_CONV(conv)(tm)
    | _: COMB_QCONV(conv)(tm)
fun ONCE_DEPTH_QCONV(conv): fun(tm): ORELSEC(conv)(SUB_QCONV(ONCE_DEPTH_QCONV(conv)))(tm)
fun DEPTH_QCONV(conv): fun(tm): THENQC(SUB_QCONV(DEPTH_QCONV(conv)))(REPEATQC(conv))(tm)
fun REDEPTH_QCONV(conv): fun(tm): THENQC(SUB_QCONV(REDEPTH_QCONV(conv)))(THENCQC(conv)(REDEPTH_QCONV(conv)))(tm)
fun TOP_DEPTH_QCONV(conv): fun(tm): THENQC(REPEATQC(conv))(THENCQC(SUB_QCONV(TOP_DEPTH_QCONV(conv)))(THENCQC(conv)(TOP_DEPTH_QCONV(conv))))(tm)
fun TOP_SWEEP_QCONV(conv): fun(tm): THENQC(REPEATQC(conv))(SUB_QCONV(TOP_SWEEP_QCONV(conv)))(tm)
fun ONCE_DEPTH_CONV(c): TRY_CONV(ONCE_DEPTH_QCONV(c))
fun DEPTH_CONV(c): TRY_CONV(DEPTH_QCONV(c))
fun REDEPTH_CONV(c): TRY_CONV(REDEPTH_QCONV(c))
fun TOP_DEPTH_CONV(c): TRY_CONV(TOP_DEPTH_QCONV(c))
fun TOP_SWEEP_CONV(c): TRY_CONV(TOP_SWEEP_QCONV(c))
fun DEPTH_BINOP_CONV(op):
  fun(conv):
    fun(tm):
      match tm
      | Comb(Comb(op1,l),r):
          if compare(op1)(op) == 0
          | block:
              let [l, r] = dest_binop(op)(tm)
              let lth = DEPTH_BINOP_CONV(op)(conv)(l)
              let rth = DEPTH_BINOP_CONV(op)(conv)(r)
              MK_COMB([AP_TERM(op1)(lth), rth])
          | conv(tm)
      | _: conv(tm)
fun PATH_CONV(s):
  fun path_conv(s,cnv):
    match s
    | PairList []: cnv
    | PairList ["l", & t]: RATOR_CONV(path_conv(t,cnv))
    | PairList ["r", & t]: RAND_CONV(path_conv(t,cnv))
    | PairList [_, & t]: ABS_CONV(path_conv(t,cnv))
  fun(cnv): path_conv(explode(s),cnv)
fun PAT_CONV(pat):
  fun PCONV(xs,pat,conv):
    cond
    | mem(pat)(xs): conv
    | !exists(fun(x): free_in(x)(pat))(xs): ALL_CONV
    | is_comb(pat): COMB2_CONV(PCONV(xs,rator(pat),conv))(PCONV(xs,rand(pat),conv))
    | ~else: ABS_CONV(PCONV(xs,body(pat),conv))
  let [xs, pbod] = strip_abs(pat)
  fun(conv): PCONV(xs,pbod,conv)
fun SYM_CONV(tm):
  try:
    let th1 = SYM(ASSUME(tm))
    let tm1 = concl(th1)
    let th2 = SYM(ASSUME(tm1))
    DEDUCT_ANTISYM_RULE(th2)(th1)
    ~catch Failure(_): failwith("SYM_CONV")
fun CONV_RULE(conv): fun(th): EQ_MP(conv(concl(th)))(th)
fun SUBS_CONV(ths):
  fun(tm):
    try:
      if ths == PairList []
      | REFL(tm)
      | block:
          let lefts = map(o(lhand)(concl))(ths)
          let gvs = map(o(genvar)(type_of))(lefts)
          let pat = subst(zip(gvs)(lefts))(tm)
          let abs = list_mk_abs([gvs, pat])
          let th = rev_itlist(fun(y): fun(x): CONV_RULE(THENC(RAND_CONV(BETA_CONV))(LAND_CONV(BETA_CONV)))(MK_COMB([x, y])))(ths)(REFL(abs))
          if rand(concl(th)) == tm | REFL(tm) | th
      ~catch Failure(_): failwith("SUBS_CONV")
def BETA_RULE = CONV_RULE(REDEPTH_CONV(BETA_CONV))
def GSYM = CONV_RULE(ONCE_DEPTH_CONV(SYM_CONV))
fun SUBS(ths): CONV_RULE(SUBS_CONV(ths))
fun CACHE_CONV(conv):
  fun ALPHA_HACK(th):
    let tm1 = lhand(concl(th))
    fun(tm): if tm1 == tm | th | TRANS(ALPHA(tm)(tm1))(th)
  let mutable net = empty_net
  fun(tm):
    try:
      tryfind(fun(f): f(tm))(lookup(tm)(net))
      ~catch Failure(_):
        let th = conv(tm)
        net := enter(PairList [])([tm, ALPHA_HACK(th)])(net)
        th