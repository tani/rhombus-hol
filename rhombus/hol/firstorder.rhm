    def stdlib_map = Host.OCamlList.map

    def stdlib_rev = Host.OCamlList.rev

    def stdlib_length = Host.OCamlList.length

    def stdlib_concat = Host.OCamlList.concat

    def stdlib_exists = Host.OCamlList.exists

    def stdlib_filter = Host.OCamlList.filter

    def stdlib_find = Host.OCamlList.find

    def stdlib_fold_left = Host.OCamlList.fold_left

    def stdlib_fold_right = Host.OCamlList.fold_right

    def stdlib_for_all = Host.OCamlList.for_all

    def stdlib_hd = Host.OCamlList.hd

    def stdlib_iter = Host.OCamlList.iter

    def stdlib_mem = Host.OCamlList.mem

    def stdlib_mem_assoc = Host.OCamlList.mem_assoc

    def stdlib_nth = Host.OCamlList.nth

    def stdlib_partition = Host.OCamlList.partition

    def stdlib_rev_append = Host.OCamlList.rev_append

    def stdlib_sort = Host.OCamlList.sort

    def stdlib_map2 = Host.OCamlList.map2

    def stdlib_assoc = Host.OCamlList.assoc

    def stdlib_concat_map = Host.OCamlList.concat_map

    def stdlib_filter_map = Host.OCamlList.filter_map

    def stdlib_fold_left2 = Host.OCamlList.fold_left2

    def stdlib_fold_right2 = Host.OCamlList.fold_right2

    def stdlib_mapi = Host.OCamlList.mapi

    def stdlib_rev_map = Host.OCamlList.rev_map

    def stdlib_for_all2 = Host.OCamlList.for_all2

    fun cons(x): fun(l): PairList [x, & l]

    fun list_rest(l):
      // Recursive list decomposition needs the local definition before its first use.
      fun go(acc):
        fun(arg):
          match arg
          | PairList [x, & xs]: PairList [[x, [acc, xs]], & go(PairList [x, & acc])(xs)]
          | PairList []: PairList []
      go(PairList [])(l)

    fun nth_rest(n):
      // Recursive indexing needs the local definition before its first use.
      fun go_2(acc):
        fun(i):
          fun(arg_2):
            match arg_2
            | PairList [x, & xs]:
                if (i > 0)
                | go_2(PairList [x, & acc])((i - 1))(xs)
                | match arg_2
                  | PairList [x, & xs]:
                      if (i == 0)
                      | [x, [PairList.reverse(acc), xs]]
                      | match arg_2
                        | _: failwith("nth_rest")
                  | _: failwith("nth_rest")
            | PairList [x, & xs]:
                if (i == 0)
                | [x, [PairList.reverse(acc), xs]]
                | match arg_2
                  | _: failwith("nth_rest")
            | _: failwith("nth_rest")
      go_2(PairList [])(n)

    fun insert_at(i):
      fun(elem):
        fun(l):
          // Recursive insertion needs the local definition before its first use.
          fun go_3(acc):
            fun(arg):
              match arg
              | [0, xs]: Host.OCamlList.rev_append(acc)(PairList [elem, & xs])
              | [n, PairList []]: failwith("insert_at")
              | [n, PairList [x, & xs]]: go_3(PairList [x, & acc])([(n - 1), xs])
          go_3(PairList [])([i, l])

    fun take_drop(n):
      // Recursive splitting needs the local definition before its first use.
      fun go_4(acc):
        fun(i):
          fun(arg_3):
            match arg_3
            | PairList []:
                if (i > 0)
                | failwith("take_drop")
                | match arg_3
                  | PairList [x, & xs]:
                      if (i > 0)
                      | go_4(PairList [x, & acc])((i - 1))(xs)
                      | match arg_3
                        | xs: [PairList.reverse(acc), xs]
                  | xs: [PairList.reverse(acc), xs]
            | PairList [x, & xs]:
                if (i > 0)
                | go_4(PairList [x, & acc])((i - 1))(xs)
                | match arg_3
                  | xs: [PairList.reverse(acc), xs]
            | xs: [PairList.reverse(acc), xs]
      go_4(PairList [])(n)

    fun take(n): fun(l): fst(take_drop(n)(l))

    fun findi(p):
      fun(l):
        // Recursive search needs the local definition before its first use.
        fun loop(n):
          fun(arg):
            match arg
            | PairList []: (throw Not_found())
            | PairList [h, & t]: (if p(n)(h) | [n, h] | loop((n + 1))(t))
        loop(0)(l)

    fun concat_map(f): fun(l): Host.OCamlList.concat(PairList.map(l, f))

    def fsum = Host.OCamlList.fold_left((fun (x): fun (y): x + y))(0.0)

    fun last_impl
    | last_impl(PairList []): failwith("last")
    | last_impl(PairList [h, & PairList []]): h
    | last_impl(PairList [h, & t]): last_impl(t)

    fun union1(x):
      fun(y):
        match x
        | PairList []: y
        | PairList [h, & t]: (if Host.OCamlList.mem(h)(y) | union1(t)(y) | PairList [h, & union1(t)(y)])

    fun union2(x):
      fun(y):
        match x
        | PairList []: y
        | PairList [h, & t]: (if Host.OCamlList.mem(h)(y) | union1(t)(y) | union2(t)(PairList [h, & y]))

    // Recursive namespace declaration needs a binding for self-reference.
    fun fold_right1(f):
      fun(arg):
        match arg
        | PairList [x, & PairList []]: x
        | PairList [x, & xs]: f(x)(fold_right1(f)(xs))
        | PairList []: failwith("fold_right1")

    fun fold_left_map(f):
      fun(acc):
        fun(xs):
          Host.OCamlList.fold_left(
            fun([acc, ys]):
              fun(x):
                let [acc_prime, y] = f(acc)(x)
                [acc_prime, PairList [y, & ys]]
          )([acc, PairList []])(xs)

    fun fold_right_map(f):
      fun(acc):
        fun(xs):
          Host.OCamlList.fold_right(
            fun(x):
              fun([acc, ys]):
                let [acc_prime, y] = f(acc)(x)
                [acc_prime, PairList [y, & ys]]
          )(xs)([acc, PairList []])

    fun fold_map(f):
      fun(sf):
        fun(l):
          let [sf, rev_2] = fold_left_map(f)(sf)(l)
          [sf, PairList.reverse(rev_2)]

    // Recursive namespace declaration needs a binding for self-reference.
    fun filter_map(f):
      fun(arg):
        match arg
        | PairList []: PairList []
        | PairList [x, & xs]:
            match f(x)
            | None(): filter_map(f)(xs)
            | Some(y): PairList [y, & filter_map(f)(xs)]

    fun exists_unique(p):
      fun(l):
        // Recursive uniqueness search needs the local definition before its first use.
        fun go_5(acc):
          fun(arg):
            match arg
            | PairList []: acc
            | PairList [x, & xs]:
                if p(x)
                | (if acc | #false | go_5(#true)(xs))
                | go_5(acc)(xs)
        go_5(#false)(l)

namespace Mapping:
  export:
    rename reset_vars_v2 as reset_vars
    rename fol_of_var_v2 as fol_of_var
    hol_of_var
    rename reset_consts_v2 as reset_consts
    rename fol_of_const_v2 as fol_of_const
    hol_of_const
    fol_of_term
    fol_of_atom
    fol_of_literal
    fol_of_form
    hol_of_term
    hol_of_atom
    hol_of_literal
    fol_of_hol_clauses

  def [reset_vars_v2, fol_of_var_v2, hol_of_var]:
    let vstore_2 = Box(PairList [])
    let gstore_2 = Box(PairList [])
    let vcounter_2 = Box(0)
    let inc_vcounter:
      fun(_):
        let n = vcounter_2.value
        let m = (n + 1)
        vcounter_2.value := m
        n
    let reset_vars:
      fun(_):
        vstore_2.value := PairList []
        gstore_2.value := PairList []
        vcounter_2.value := 0
    let fol_of_var:
      fun(v):
        try:
          assoc(v)(vstore_2.value)
          ~catch exn:
            match exn
            | Failure(_):
                let n = inc_vcounter(#void)
                (if copverb.value | Host.hol_printf("fol_of_var: %s (ty = %s) <- %d\n%!")(Host.string_of_term(v))(Host.string_of_type(type_of(v)))(n) | #void)
                vstore_2.value := PairList [[v, n], & vstore_2.value]
                n
            | exn: (throw exn)
    let hol_of_var:
      fun(v):
        fun(ty):
          try:
            rev_assoc(v)(gstore_2.value)
            ~catch exn:
              match exn
              | Failure(_):
                  let gv = genvar(ty)
                  gstore_2.value := PairList [[gv, v], & gstore_2.value]
                  gv
              | exn: (throw exn)
    [reset_vars, fol_of_var, hol_of_var]

  def [reset_consts_v2, fol_of_const_v2, hol_of_const] = [Meson.Meson.reset_consts, Meson.Meson.fol_of_const, Meson.Meson.hol_of_const]

  fun fol_of_term(env):
    fun(consts):
      fun(tm):
        if (is_var(tm) && !mem(tm)(consts))
        | Fvar(fol_of_var_v2(tm))
        | let [f, args] = strip_comb(tm)
          if mem(f)(env)
          | failwith("fol_of_term: higher order")
          | let ff = fol_of_const_v2(f)
            Fnapp(ff, map(fol_of_term(env)(consts))(args))

  fun fol_of_atom(env):
    fun(consts):
      fun(tm):
        let [f, args] = strip_comb(tm)
        if mem(f)(env)
        | failwith("fol_of_atom: higher order")
        | let ff = fol_of_const_v2(f)
          [ff, map(fol_of_term(env)(consts))(args)]

  fun fol_of_literal(env):
    fun(consts):
      fun(tm):
        try:
          let tm_prime = dest_neg(tm)
          let [p, a_2] = fol_of_atom(env)(consts)(tm_prime)
          [(-p), a_2]
          ~catch exn:
            match exn
            | Failure(_): fol_of_atom(env)(consts)(tm)
            | exn: (throw exn)

  fun fol_of_form(env):
    fun(consts):
      fun(tm):
        try:
          let [v, bod] = dest_forall(tm)
          let fv = fol_of_var_v2(v)
          let fbod = fol_of_form(PairList [v, & env])(subtract(consts)(PairList [v]))(bod)
          Forallq(fv, fbod)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  let [l, r] = dest_conj(tm)
                  let fl_2 = fol_of_form(env)(consts)(l)
                  let fr_2 = fol_of_form(env)(consts)(r)
                  Conj(fl_2, fr_2)
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let [l, r] = dest_disj(tm)
                          let fl_3 = fol_of_form(env)(consts)(l)
                          let fr_3 = fol_of_form(env)(consts)(r)
                          Disj(fl_3, fr_3)
                          ~catch exn:
                            match exn
                            | Failure(_): Atom(fol_of_literal(env)(consts)(tm))
                            | exn: (throw exn)
                    | exn: (throw exn)
            | exn: (throw exn)

  fun hol_of_term(ty):
    fun(tm):
      match tm
      | Fvar(v): hol_of_var(v)(ty)
      | Fnapp(f,args): hol_of_atom([f, args])

  fun hol_of_atom([f, args]):
    let f_prime = hol_of_const(f)
    let tys = fst(splitlist(dest_fun_ty)(type_of(f_prime)))
    (if (PairList.length(args) <= PairList.length(tys)) | #void | failwith("Assertion failed"))
    let tys_prime = Utils.List.take(PairList.length(args))(tys)
    list_mk_comb([f_prime, Host.OCamlList.map2(hol_of_term)(tys_prime)(args)])

  fun hol_of_literal([p, args]): (if (p < 0) | mk_neg(hol_of_atom([(-p), args])) | hol_of_atom([p, args]))

  def fol_of_hol_clauses:
    let eqt = fun([a1, [b1, c1]]): fun([a2, [b2, c2]]): ((a1 == a2) && ((b1 == b2) && equals_thm(c1)(c2)))
    // Recursive contrapositive construction needs the local definition before its first use.
    fun mk_contraposes(n):
      fun(th):
        fun(used):
          fun(unused):
            fun(sofar):
              match unused
              | PairList []: sofar
              | PairList [h, & t]:
                  let nw = [[map(Meson.Meson.mk_negated)(append(used)(t)), h], [n, th]]
                  mk_contraposes((n + 1))(th)(append(used)(PairList [h]))(t)(PairList [nw, & sofar])
    let fol_of_hol_clause:
      fun(th):
        let lconsts = freesl(hyp(th))
        let tm = concl(th)
        let hlits = disjuncts(tm)
        let flits = map(fol_of_literal(PairList [])(lconsts))(hlits)
        let basics = mk_contraposes(0)(th)(PairList [])(flits)(PairList [])
        (if forall((fun([p, _]): (p < 0)))(flits) | PairList [[[map(Meson.Meson.mk_negated)(flits), [1, PairList []]], [-1, th]], & basics] | basics)
    fun(thms):
      let rawrules = itlist(o(union_prime(eqt))(fol_of_hol_clause))(thms)(PairList [])
      let prs = setify(map(o(o(fst)(snd))(fst))(rawrules))
      let prules = map((fun(t): [t, filter(o(o(o((fun (y): t == y))(fst))(snd))(fst))(rawrules)]))(prs)
      let srules = sort(fun([p, _]): fun([q, _]): (math.abs(p) <= math.abs(q)))(prules)
      srules
