      filter_map
      rename stdlib_fold_left2 as fold_left2
      rename stdlib_fold_right2 as fold_right2
      rename stdlib_mapi as mapi
      rename stdlib_rev_map as rev_map
      rename stdlib_for_all2 as for_all2
