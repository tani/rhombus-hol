def copverb = Box(#false)

namespace Utils:
  export:
    rename _op25__op3e__impl as _op25__op3e_
    rename _op25__impl as _op25_
    const
    rename _op3e__op3e__op3d__impl as _op3e__op3e__op3d_
    Pair
    List

  fun _op25__op3e__impl(f): fun(g): fun(x): g(f(x))

  fun _op25__impl(f): fun(g): fun(x): f(g(x))

  fun const(x): fun(_): x

  fun _op3e__op3e__op3d__impl(x):
    fun(f):
      match x
      | None(): None()
      | Some(y): f(y)

  namespace Pair:
    export:
      mapn

    fun mapn(f): fun([x, y]): [f(x), f(y)]

  namespace List:
    export:
      rename stdlib_map as map
      rename stdlib_rev as rev
      rename stdlib_length as length
      rename stdlib_concat as concat
      rename stdlib_exists as exists
      rename stdlib_filter as filter
      rename stdlib_find as find
      rename stdlib_fold_left as fold_left
      rename stdlib_fold_right as fold_right
      rename stdlib_for_all as for_all
      rename stdlib_hd as hd
