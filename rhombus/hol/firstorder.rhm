  def [firstorder_Mapping_reset_vars, firstorder_Mapping_fol_of_var, firstorder_Mapping_hol_of_var]:
    let vstore_2 = Box(PairList [])
    let gstore_2 = Box(PairList [])
    let vcounter_2 = Box(0)
    let inc_vcounter:
      fun(_):
        let n = Host.ref_get(vcounter_2)
        let m = Host.hol_add(n)(1)
        Host.ref_set(vcounter_2)(m)
        n
    let reset_vars:
      fun(_):
        Host.ref_set(vstore_2)(PairList [])
        Host.ref_set(gstore_2)(PairList [])
        Host.ref_set(vcounter_2)(0)
    let fol_of_var:
      fun(v):
        try:
          assoc(v)(Host.ref_get(vstore_2))
          ~catch exn:
            match exn
            | Failure(_):
                let n = Host.hol_apply_unit(inc_vcounter)
                (if Host.ref_get(copverb) | Host.hol_printf("fol_of_var: %s (ty = %s) <- %d\n%!")(Host.string_of_term(v))(Host.string_of_type(Fusion.type_of(v)))(n) | #void)
                Host.ref_set(vstore_2)(PairList.cons([v, n], Host.ref_get(vstore_2)))
                n
            | exn: Host.hol_raise(exn)
    let hol_of_var:
      fun(v):
        fun(ty):
          try:
            rev_assoc(v)(Host.ref_get(gstore_2))
            ~catch exn:
              match exn
              | Failure(_):
                  let gv = Basics.genvar(ty)
                  Host.ref_set(gstore_2)(PairList.cons([gv, v], Host.ref_get(gstore_2)))
                  gv
              | exn: Host.hol_raise(exn)
    [reset_vars, fol_of_var, hol_of_var]

  def [firstorder_Mapping_reset_consts, firstorder_Mapping_fol_of_const, firstorder_Mapping_hol_of_const] = [Meson.Meson.reset_consts, Meson.Meson.fol_of_const, Meson.Meson.hol_of_const]

  fun firstorder_Mapping_fol_of_term(env):
    fun(consts):
      fun(tm):
        if (Fusion.is_var(tm) && Host.hol_not(mem(tm)(consts)))
        | Meson.Fvar(firstorder_Mapping_fol_of_var(tm))
        | let [f, args] = Basics.strip_comb(tm)
          if mem(f)(env)
          | failwith("fol_of_term: higher order")
          | let ff = firstorder_Mapping_fol_of_const(f)
            Meson.Fnapp(ff, map(firstorder_Mapping_fol_of_term(env)(consts))(args))

  fun firstorder_Mapping_fol_of_atom(env):
    fun(consts):
      fun(tm):
        let [f, args] = Basics.strip_comb(tm)
        if mem(f)(env)
        | failwith("fol_of_atom: higher order")
        | let ff = firstorder_Mapping_fol_of_const(f)
          [ff, map(firstorder_Mapping_fol_of_term(env)(consts))(args)]

  fun firstorder_Mapping_fol_of_literal(env):
    fun(consts):
      fun(tm):
        try:
          let tm_prime = Basics.dest_neg(tm)
          let [p, a_2] = firstorder_Mapping_fol_of_atom(env)(consts)(tm_prime)
          [Host.hol_neg(p), a_2]
          ~catch exn:
            match exn
            | Failure(_): firstorder_Mapping_fol_of_atom(env)(consts)(tm)
            | exn: Host.hol_raise(exn)

  fun firstorder_Mapping_fol_of_form(env):
    fun(consts):
      fun(tm):
        try:
          let [v, bod] = Basics.dest_forall(tm)
          let fv = firstorder_Mapping_fol_of_var(v)
          let fbod = firstorder_Mapping_fol_of_form(PairList.cons(v, env))(subtract(consts)(PairList.cons(v, PairList [])))(bod)
          Meson.Forallq(fv, fbod)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  let [l, r] = Basics.dest_conj(tm)
                  let fl_2 = firstorder_Mapping_fol_of_form(env)(consts)(l)
                  let fr_2 = firstorder_Mapping_fol_of_form(env)(consts)(r)
                  Meson.Conj(fl_2, fr_2)
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let [l, r] = Basics.dest_disj(tm)
                          let fl_3 = firstorder_Mapping_fol_of_form(env)(consts)(l)
                          let fr_3 = firstorder_Mapping_fol_of_form(env)(consts)(r)
                          Meson.Disj(fl_3, fr_3)
                          ~catch exn:
                            match exn
                            | Failure(_): Meson.Atom(firstorder_Mapping_fol_of_literal(env)(consts)(tm))
                            | exn: Host.hol_raise(exn)
                    | exn: Host.hol_raise(exn)
            | exn: Host.hol_raise(exn)

  fun firstorder_Mapping_hol_of_term(ty):
    fun(tm):
      match tm
      | Meson.Fvar(v): firstorder_Mapping_hol_of_var(v)(ty)
      | Meson.Fnapp(f,args): firstorder_Mapping_hol_of_atom([f, args])

  fun firstorder_Mapping_hol_of_atom([f, args]):
    let f_prime = firstorder_Mapping_hol_of_const(f)
    let tys = fst(splitlist(Basics.dest_fun_ty)(Fusion.type_of(f_prime)))
    (if Host.hol_le(Host.OCamlList.length(args))(Host.OCamlList.length(tys)) | #void | failwith("Assertion failed"))
    let tys_prime = Utils.List.take(Host.OCamlList.length(args))(tys)
    Basics.list_mk_comb([f_prime, Host.OCamlList.map2(firstorder_Mapping_hol_of_term)(tys_prime)(args)])

  fun firstorder_Mapping_hol_of_literal([p, args]): (if Host.hol_lt(p)(0) | Bool.mk_neg(firstorder_Mapping_hol_of_atom([Host.hol_neg(p), args])) | firstorder_Mapping_hol_of_atom([p, args]))

  def firstorder_Mapping_fol_of_hol_clauses:
    let eqt = (fun([a1, [b1, c1]]): (fun([a2, [b2, c2]]): (Host.hol_equal(a1)(a2) && (Host.hol_equal(b1)(b2) && Fusion.equals_thm(c1)(c2)))))
    fun mk_contraposes(n):
      fun(th):
        fun(used):
          fun(unused):
            fun(sofar):
              match unused
              | PairList []: sofar
              | PairList [h, & t]:
                  let nw = [[map(Meson.Meson.mk_negated)(append(used)(t)), h], [n, th]]
                  mk_contraposes(Host.hol_add(n)(1))(th)(append(used)(PairList.cons(h, PairList [])))(t)(PairList.cons(nw, sofar))
    let fol_of_hol_clause:
      fun(th):
        let lconsts = Fusion.freesl(Fusion.hyp(th))
        let tm = Fusion.concl(th)
        let hlits = Basics.disjuncts(tm)
        let flits = map(firstorder_Mapping_fol_of_literal(PairList [])(lconsts))(hlits)
        let basics = mk_contraposes(0)(th)(PairList [])(flits)(PairList [])
        (if forall((fun([p, _]): Host.hol_lt(p)(0)))(flits) | PairList.cons([[map(Meson.Meson.mk_negated)(flits), [1, PairList []]], [-1, th]], basics) | basics)
    fun(thms):
      let rawrules = itlist(o(Host.union_prime(eqt))(fol_of_hol_clause))(thms)(PairList [])
      let prs = Host.setify(map(o(o(fst)(snd))(fst))(rawrules))
      let prules = map((fun(t): [t, filter(o(o(o(Host.hol_equal(t))(fst))(snd))(fst))(rawrules)]))(prs)
      let srules = sort((fun([p, _]): (fun([q, _]): Host.hol_le(Host.abs(p))(Host.abs(q)))))(prules)
      srules

