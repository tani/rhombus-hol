//
// Start of a direct Rhombus port of HOL Light fusion.ml.
//
// This file deliberately has no dependency on the previous Rhombus/HOL
// implementation.  It begins with HOL types and terms; primitive inference
// rules are added here in the same order as fusion.ml.

export:
  HolType
  TyVar
  TyApp
  Term
  Var
  Const
  Comb
  Abs
  mk_vartype
  mk_type
  mk_fun_ty
  dest_fun_ty
  is_fun_ty
  type_of
  mk_var
  mk_const
  mk_comb
  mk_abs
  dest_var
  dest_const
  dest_comb
  dest_abs

class HolType():
  nonfinal

class TyVar(name :: Symbol):
  extends HolType

class TyApp(name :: Symbol, args :: List):
  extends HolType

fun mk_vartype(name :: Symbol) :: HolType:
  TyVar(name)

fun mk_type(name :: Symbol, args :: List) :: HolType:
  TyApp(name, args)

fun mk_fun_ty(domain :: HolType, range :: HolType) :: HolType:
  TyApp(#'fun, [domain, range])

fun dest_fun_ty(ty :: HolType) :: values(HolType, HolType):
  match ty
  | TyApp(#'fun, [domain, range]):
      values(domain :~ HolType, range :~ HolType)
  | ~else:
      error(~who: #'dest_fun_ty, "not a function type")

fun is_fun_ty(ty :: HolType) :: Boolean:
  match ty
  | TyApp(#'fun, [_, _]): #true
  | ~else: #false

class Term():
  nonfinal

class Var(name :: Symbol, ty :: HolType):
  extends Term

class Const(name :: Symbol, ty :: HolType):
  extends Term

class Comb(func :: Term, arg :: Term):
  extends Term

class Abs(var :: Var, body :: Term):
  extends Term

fun type_of(tm :: Term) :: HolType:
  match tm
  | Var(_, ty): ty
  | Const(_, ty): ty
  | Comb(func, _):
      let (_, range) = dest_fun_ty(type_of(func))
      range
  | Abs(var, body):
      mk_fun_ty(var.ty, type_of(body))

fun mk_var(name :: Symbol, ty :: HolType) :: Term:
  Var(name, ty)

fun mk_const(name :: Symbol, ty :: HolType) :: Term:
  Const(name, ty)

fun mk_comb(func :: Term, arg :: Term) :: Term:
  let (domain, _) = dest_fun_ty(type_of(func))
  unless domain == type_of(arg)
  | error(~who: #'mk_comb, "function domain and argument type differ")
  Comb(func, arg)

fun mk_abs(var :: Var, body :: Term) :: Term:
  Abs(var, body)

fun dest_var(tm :: Term) :: values(Symbol, HolType):
  match tm
  | Var(name, ty): values(name, ty)
  | ~else: error(~who: #'dest_var, "not a variable")

fun dest_const(tm :: Term) :: values(Symbol, HolType):
  match tm
  | Const(name, ty): values(name, ty)
  | ~else: error(~who: #'dest_const, "not a constant")

fun dest_comb(tm :: Term) :: values(Term, Term):
  match tm
  | Comb(func, arg): values(func, arg)
  | ~else: error(~who: #'dest_comb, "not a combination")

fun dest_abs(tm :: Term) :: values(Var, Term):
  match tm
  | Abs(var, body): values(var, body)
  | ~else: error(~who: #'dest_abs, "not an abstraction")
