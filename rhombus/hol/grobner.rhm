                        let th2 = Equal.CONV_RULE(Equal.COMB2_CONV(Equal.RAND_CONV(Equal.BETA_CONV))(Equal.BINDER_CONV(Equal.RAND_CONV(Equal.BETA_CONV))))(th1)
                        Equal.CONV_RULE(Equal.RAND_CONV(NUM_MULTIPLY_CONV(pos)))(th2)
                        ~catch exn:
                          match exn
                          | Failure(_):
                              try:
                                let t = Basics.find_term((fun(t): (is_divmod_2(t) && Basics.free_in(t)(tm))))(tm)
                                let x_2 = Equal.lhand(t)
                                let y_2 = Fusion.rand(t)
                                let dtm_2 = Fusion.mk_comb([Fusion.mk_comb([div_tm_2, x_2]), y_2])
                                let mtm_2 = Fusion.mk_comb([Fusion.mk_comb([mod_tm_2, x_2]), y_2])
                                let vd_2 = Basics.genvar(Fusion.type_of(dtm_2))
                                let vm_2 = Basics.genvar(Fusion.type_of(mtm_2))
                                let p = Basics.list_mk_abs([PairList.cons(vd_2, PairList.cons(vm_2, PairList [])), Basics.subst(PairList.cons([vd_2, dtm_2], PairList.cons([vm_2, mtm_2], PairList [])))(tm)])
                                let th0 = (if pos | DIVMOD_ELIM_THM_prime_prime_2 | Arith.DIVMOD_ELIM_THM_prime)
