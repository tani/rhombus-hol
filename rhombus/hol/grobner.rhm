class grobner_ctor_Start(field0):
  extends Host.HolVariant
  override port_view(): [1, [0, PairList [this.field0]]]

class grobner_ctor_Mmul(field0, field1):
  extends Host.HolVariant
  override port_view(): [1, [1, PairList [this.field0, this.field1]]]

class grobner_ctor_Add(field0, field1):
  extends Host.HolVariant
  override port_view(): [1, [2, PairList [this.field0, this.field1]]]

def RING_AND_IDEAL_CONV:
  fun lexorder(l1):
    fun(l2):
      match [l1, l2]
      | [PairList [], PairList []]: #false
      | [PairList [x1, & o1], PairList [x2, & o2]]: (Host.hol_gt(x1)(x2) || (Host.hol_equal(x1)(x2) && lexorder(o1)(o2)))
      | _: failwith("morder: inconsistent monomial lengths")
  let morder_lt:
    fun(m1):
      fun(m2):
        let n1_2 = itlist(Host.hol_add)(m1)(0)
        let n2_2 = itlist(Host.hol_add)(m2)(0)
        (Host.hol_lt(n1_2)(n2_2) || (Host.hol_equal(n1_2)(n2_2) && lexorder(m1)(m2)))
  let grob_neg = map((fun([c, m]): [Host.minus_num(c), m]))
  fun grob_add(l1):
    fun(l2):
      match [l1, l2]
      | [PairList [], l2]: l2
      | [l1, PairList []]: l1
      | [PairList [[c1, m1], & o1], PairList [[c2, m2], & o2]]:
