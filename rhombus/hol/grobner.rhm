                  fun(prf):
                    fun(x):
                      Host.ref_set(execache)(PairList.cons([prf, x], Host.ref_get(execache)))
                      x
                fun run_scaled_proof(vars):
                  fun(prf):
                    try:
                      assoceq(prf)(Host.ref_get(execache))
                      ~catch exn:
                        match exn
                        | Failure(_):
                            match prf
                            | grobner_ctor_Start(m): [Host.num_1, Host.el(m)(initpols)]
                            | grobner_ctor_Add(p1,p2):
                                let [d1_2, th1_2] = run_scaled_proof(vars)(p1)
                                let [d2_2, th2_2] = run_scaled_proof(vars)(p2)
                                let d = Host.lcm_num(d1_2)(d2_2)
                                memoize(prf)([d, ADD_RULE_2(MUL_RULE_2(vars)([Host.hol_rat_div(d)(d1_2), km])(th1_2))(MUL_RULE_2(vars)([Host.hol_rat_div(d)(d2_2), km])(th2_2))])
                            | grobner_ctor_Mmul([c, xs],p2):
                                let e = Host.denominator(c)
                                let [d, th] = run_scaled_proof(vars)(p2)
                                memoize(prf)([Host.hol_mul(d)(e), MUL_RULE_2(vars)([Host.hol_mul(c)(e), xs])(th)])
                        | exn: Host.hol_raise(exn)
                fun(vars):
                  fun(prf):
                    let [_, ans] = run_scaled_proof(vars)(prf)
                    Host.ref_set(execache)(PairList [])
                    ans
            let th = run_proof(vars)(prf)
            Equal.CONV_RULE(RING_EQ_CONV)(th)
    let REFUTE:
      fun(tm):
        if Host.hol_equal(tm)(false_tm_2)
        | Fusion.ASSUME(tm)
        | let [nths0, eths0] = partition(o(Basics.is_neg)(Fusion.concl))(Bool.CONJUNCTS(Fusion.ASSUME(tm)))
          let nths_2 = filter(o(o(Fusion.is_eq)(Fusion.rand))(Fusion.concl))(nths0)
          let eths_2 = filter(o(Fusion.is_eq)(Fusion.concl))(eths0)
          if Host.hol_equal(eths_2)(PairList [])
          | let th1 = end_itlist((fun(th1): (fun(th2): IDOM_RULE(Bool.CONJ(th1)(th2)))))(nths_2)
            let th2 = Equal.CONV_RULE(Equal.RAND_CONV(Equal.BINOP_CONV(RING_NORMALIZE_CONV)))(th1)
            let [l, r] = Fusion.dest_eq(Fusion.rand(Fusion.concl(th2)))
            Fusion.EQ_MP(Bool.EQF_INTRO(th2))(Fusion.REFL(l))
          | if (Host.hol_equal(nths_2)(PairList []) && Host.hol_not(Fusion.is_var(ring_neg_tm)))
            | let [vars, pols] = grobify_equations(Bool.list_mk_conj(map(Fusion.concl)(eths_2)))
              execute_proof(vars)(eths_2)(grobner_refute(pols))
            | let [vars, l, cert, noteqth]:
                if Host.hol_equal(nths_2)(PairList [])
                | let [vars, pols] = grobify_equations(Bool.list_mk_conj(map(Fusion.concl)(eths_2)))
                  let [l, cert] = grobner_weak(vars)(pols)
                  [vars, l, cert, NOT_EQ_01_2]
                | let nth = end_itlist((fun(th1): (fun(th2): IDOM_RULE(Bool.CONJ(th1)(th2)))))(nths_2)
                  let [vars, PairList [pol, & pols]] = grobify_equations(Bool.list_mk_conj(PairList.cons(Fusion.rand(Fusion.concl(nth)), map(Fusion.concl)(eths_2))))
                  let [deg, l, cert] = grobner_strong(vars)(pols)(pol)
                  let th1 = Equal.CONV_RULE(Equal.RAND_CONV(Equal.BINOP_CONV(RING_NORMALIZE_CONV)))(nth)
                  let th2 = Host.funpow(deg)(o(IDOM_RULE)(Bool.CONJ(th1)))(NOT_EQ_01_2)
                  [vars, l, cert, th2]
              Host.hol_print_string("Translating certificate to HOL inferences")
              Host.hol_apply_unit(Host.hol_print_newline)
              let cert_pos_2 = map((fun([i, p]): [i, filter((fun([c, m]): Host.hol_gt(c)(Host.num_0)))(p)]))(cert)
              let cert_neg_2 = map((fun([i, p]): [i, map((fun([c, m]): [Host.minus_num(c), m]))(filter((fun([c, m]): Host.hol_lt(c)(Host.num_0)))(p))]))(cert)
              let herts_pos_2 = map((fun([i, p]): [i, holify_polynomial(vars)(p)]))(cert_pos_2)
              let herts_neg_2 = map((fun([i, p]): [i, holify_polynomial(vars)(p)]))(cert_neg_2)
              let thm_fn = (fun(pols): (if Host.hol_equal(pols)(PairList []) | Fusion.REFL(ring_mk_const(Host.num_0)) | end_itlist(MK_ADD_2)(map((fun([i, p]): Equal.AP_TERM(Fusion.mk_comb([ring_mul_tm, p]))(Host.el(i)(eths_2))))(pols))))
              let th1_3 = thm_fn(herts_pos_2)
              let th2_3 = thm_fn(herts_neg_2)
              let th3 = Bool.CONJ(MK_ADD_2(Equal.SYM(th1_3))(th2_3))(noteqth)
              let th4 = Equal.CONV_RULE(Equal.RAND_CONV(Equal.BINOP_CONV(RING_NORMALIZE_CONV)))(INE_RULE_2(l)(th3))
              let [l, r] = Fusion.dest_eq(Fusion.rand(Fusion.concl(th4)))
              Fusion.EQ_MP(Bool.EQF_INTRO(th4))(Fusion.REFL(l))
    let ring_ty = snd(Basics.dest_fun_ty(snd(Basics.dest_fun_ty(Fusion.type_of(ring_add_tm)))))
    let RING_2:
      fun(tm):
        let avs = filter(o(Host.hol_equal(ring_ty))(Fusion.type_of))(Fusion.frees(tm))
        let tm_prime = Bool.list_mk_forall([avs, tm])
        let th1 = INITIAL_CONV(Bool.mk_neg(tm_prime))
        let [evs, bod] = Basics.strip_exists(Fusion.rand(Fusion.concl(th1)))
        if Basics.is_forall(bod)
        | failwith("RING: non-universal formula")
        | let th1a = Canon.WEAK_DNF_CONV(bod)
          let boda = Fusion.rand(Fusion.concl(th1a))
          let th2a = refute_disj(REFUTE)(boda)
          let th2b = Fusion.TRANS(th1a)(Bool.EQF_INTRO(Bool.NOT_INTRO(Bool.DISCH(boda)(th2a))))
          let th2 = Bool.UNDISCH(Bool.NOT_ELIM(Bool.EQF_ELIM(th2b)))
          fun CHOOSES(evs):
            fun([etm, th]):
              match evs
              | PairList []: [etm, th]
              | PairList [ev, & oevs]:
                  let [etm_prime, th_prime] = CHOOSES(oevs)([etm, th])
                  [Bool.mk_exists([ev, etm_prime]), Bool.CHOOSE([ev, Fusion.ASSUME(Bool.mk_exists([ev, etm_prime]))])(th_prime)]
          let [finbod, th3] = CHOOSES(evs)([bod, th2])
          Bool.SPECL(avs)(Drule.MATCH_MP(FINAL_RULE_2(Bool.DISCH(finbod)(th3)))(th1))
    let ideal_2:
      fun(tms):
        fun(tm):
          let rawvars = itlist(grobvars)(PairList.cons(tm, tms))(PairList [])
          let vars = sort((fun(x): (fun(y): Host.hol_lt(x)(y))))(Host.setify(rawvars))
          let pols_2 = map(grobify_term(vars))(tms)
          let pol_2 = grobify_term(vars)(tm)
          let cert = grobner_ideal(vars)(pols_2)(pol_2)
          map(
            fun(n):
              let p = Host.assocd(n)(cert)(PairList [])
              holify_polynomial(vars)(p))(Host.hol_range(0)(Host.hol_sub(length(pols_2))(1)))
    [RING_2, ideal_2]

fun RING(parms): fst(RING_AND_IDEAL_CONV(parms))

fun ideal_cofactors(parms): snd(RING_AND_IDEAL_CONV(parms))

