          | (if Host.hol_equal(c)(Host.num_0) | failwith("grob_inv: division by zero") | PairList.cons([Host.hol_rat_div(Host.num_1)(c), vs], PairList []))
          | match l
            | _: failwith("grob_inv: non-constant divisor polynomial")
      | _: failwith("grob_inv: non-constant divisor polynomial")
  let grob_div:
    fun(l1):
      fun(l2):
        match l2
        | PairList [[c, l], & PairList []]:
            if forall((fun(x): Host.hol_equal(x)(0)))(l)
            | (if Host.hol_equal(c)(Host.num_0) | failwith("grob_div: division by zero") | grob_cmul([Host.hol_rat_div(Host.num_1)(c), l])(l1))
            | match l2
              | _: failwith("grob_div: non-constant divisor polynomial")
        | _: failwith("grob_div: non-constant divisor polynomial")
