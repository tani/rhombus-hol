                                let th2 = Equal.CONV_RULE(Equal.COMB2_CONV(Equal.RAND_CONV(BETA2_CONV_2))(Host.funpow(2)(Equal.BINDER_CONV)(Equal.RAND_CONV(BETA2_CONV_2))))(th1)
                                Equal.CONV_RULE(Equal.RAND_CONV(NUM_MULTIPLY_CONV(pos)))(th2)
                                ~catch exn:
                                  match exn
