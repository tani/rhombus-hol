  let mdiv = (fun([c1, m1]): (fun([c2, m2]): [Host.hol_rat_div(c1)(c2), Host.map2((fun(n1): (fun(n2): (if Host.hol_lt(n1)(n2) | failwith("mdiv") | Host.hol_sub(n1)(n2)))))(m1)(m2)]))
  let mlcm = (fun([c1, m1]): (fun([c2, m2]): [Host.num_1, Host.map2(Host.hol_max)(m1)(m2)]))
