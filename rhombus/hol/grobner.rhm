  Mmul(monomial, history)
  Add(left, right)

def RING_AND_IDEAL_CONV:
  // Recursive ordering needs the local definition before its first use.
  fun lexorder(l1):
    fun(l2):
      match [l1, l2]
      | [PairList [], PairList []]: #false
      | [PairList [x1, & o1], PairList [x2, & o2]]: ((x1 > x2) || ((x1 == x2) && lexorder(o1)(o2)))
      | _: failwith("morder: inconsistent monomial lengths")
  let morder_lt:
    fun(m1):
      fun(m2):
        let n1_2 = itlist((fun (x): fun (y): x + y))(m1)(0)
        let n2_2 = itlist((fun (x): fun (y): x + y))(m2)(0)
        ((n1_2 < n2_2) || ((n1_2 == n2_2) && lexorder(m1)(m2)))
  let grob_neg = map((fun([c, m]): [minus_num(c), m]))
  // Recursive addition needs the local definition before its first use.
  fun grob_add(l1):
    fun(l2):
      match [l1, l2]
      | [PairList [], l2]: l2
      | [l1, PairList []]: l1
      | [PairList [[c1, m1], & o1], PairList [[c2, m2], & o2]]:
          if (m1 == m2)
          | let c_2 = (c1 + c2)
            let rest_2 = grob_add(o1)(o2)
            (if (c_2 == num_0) | rest_2 | PairList [[c_2, m1], & rest_2])
          | (if morder_lt(m2)(m1) | PairList [[c1, m1], & grob_add(o1)(l2)] | PairList [[c2, m2], & grob_add(l1)(o2)])
  let grob_sub = fun(l1): fun(l2): grob_add(l1)(grob_neg(l2))
  let grob_mmul = fun([c1, m1]): fun([c2, m2]): [(c1 * c2), map2((fun (x): fun (y): x + y))(m1)(m2)]
  let grob_cmul = fun(cm): fun(pol): map(grob_mmul(cm))(pol)
  // Recursive multiplication needs the local definition before its first use.
  fun grob_mul(l1):
    fun(l2):
      match l1
      | PairList []: PairList []
      | PairList [h1, & t1]: grob_add(grob_cmul(h1)(l2))(grob_mul(t1)(l2))
  let grob_inv:
    fun(l):
      match l
      | PairList [[c, vs], & PairList []]:
          if forall((fun(x): (x == 0)))(vs)
          | (if (c == num_0) | failwith("grob_inv: division by zero") | PairList [[(num_1 / c), vs]])
          | match l
            | _: failwith("grob_inv: non-constant divisor polynomial")
      | _: failwith("grob_inv: non-constant divisor polynomial")
  let grob_div:
    fun(l1):
      fun(l2):
        match l2
        | PairList [[c, l], & PairList []]:
            if forall((fun(x): (x == 0)))(l)
            | (if (c == num_0) | failwith("grob_div: division by zero") | grob_cmul([(num_1 / c), l])(l1))
            | match l2
              | _: failwith("grob_div: non-constant divisor polynomial")
        | _: failwith("grob_div: non-constant divisor polynomial")
  // Recursive exponentiation needs the local definition before its first use.
  fun grob_pow(vars):
    fun(l):
      fun(n):
        if (n < 0)
        | failwith("grob_pow: negative power")
        | (if (n == 0) | PairList [[num_1, map((fun(v): 0))(vars)]] | grob_mul(l)(grob_pow(vars)(l)((n - 1))))
  let mdiv:
    fun([c1, m1]):
      fun([c2, m2]):
        [
          (c1 / c2),
          map2(fun(n1): fun(n2): (if (n1 < n2) | failwith("mdiv") | (n1 - n2)))(m1)(m2)
        ]
  let mlcm = fun([c1, m1]): fun([c2, m2]): [num_1, map2(hol_max)(m1)(m2)]
  let reduce1:
    fun(cm):
      fun([pol, hpol]):
        match pol
        | PairList []: failwith("reduce1")
        | PairList [cm1, & cms]:
            try:
              let [c, m] = mdiv(cm)(cm1)
              [grob_cmul([minus_num(c), m])(cms), Mmul([minus_num(c), m], hpol)]
              ~catch exn:
                match exn
                | Failure(_): failwith("reduce1")
                | exn: (throw exn)
  let reduceb = fun(cm): fun(basis): tryfind((fun(p): reduce1(cm)(p)))(basis)
  // Recursive reduction needs the local definition before its first use.
  fun reduce(basis):
    fun([pol, hist]):
      match pol
      | PairList []: [pol, hist]
      | PairList [cm, & ptl]:
          try:
            let [q, hnew] = reduceb(cm)(basis)
            reduce(basis)([grob_add(q)(ptl), Add(hnew, hist)])
            ~catch exn:
              match exn
              | Failure(_):
                  let [q, hist_prime] = reduce(basis)([ptl, hist])
                  [PairList [cm, & q], hist_prime]
              | exn: (throw exn)
  let orthogonal = fun(l): fun(p1): fun(p2): (snd(l) == snd(grob_mmul(hd(p1))(hd(p2))))
  let spoly:
    fun(cm):
      fun(ph1):
        fun(ph2):
          match [ph1, ph2]
          | [[PairList [], h], p]: [PairList [], h]
          | [p, [PairList [], h]]: [PairList [], h]
          | [[PairList [cm1, & ptl1], his1], [PairList [cm2, & ptl2], his2]]:
              [
                grob_sub(grob_cmul(mdiv(cm)(cm1))(ptl1))(grob_cmul(mdiv(cm)(cm2))(ptl2)),
                Add(Mmul(mdiv(cm)(cm1), his1), Mmul(mdiv([minus_num(fst(cm)), snd(cm)])(cm2), his2))
              ]
  let monic:
    fun([pol, hist]):
      if (pol == (PairList []))
      | [pol, hist]
      | let [c_prime, m_prime] = hd(pol)
        [
          map((fun([c, m]): [(c / c_prime), m]))(pol),
          Mmul([(num_1 / c_prime), map(K(0))(m_prime)], hist)
        ]
  let forder = fun([[c1, m1], _]): fun([[c2, m2], _]): morder_lt(m1)(m2)
  // Recursive ordering needs the local definition before its first use.
  fun poly_lt(p):
    fun(q):
      match [p, q]
      | [p, PairList []]: #false
      | [PairList [], q]: #true
      | [PairList [[c1, m1], & o1], PairList [[c2, m2], & o2]]: ((c1 < c2) || ((c1 == c2) && (polymorphic_lt(m1)(m2) || ((m1 == m2) && poly_lt(o1)(o2)))))
  let align = (fun([[p, hp], [q, hq]]): (if poly_lt(p)(q) | [[p, hp], [q, hq]] | [[q, hq], [p, hp]]))
  let poly_eq = fun(p1): fun(p2): forall2(fun([c1, m1]): fun([c2, m2]): ((c1 == c2) && (m1 == m2)))(p1)(p2)
  let memx = fun([[p1, h1], [p2, h2]]): fun(ppairs): !exists((fun([[q1, _], [q2, _]]): (poly_eq(p1)(q1) && poly_eq(p2)(q2))))(ppairs)
  let criterion2:
    fun(basis):
      fun([lcm, [[p1, h1], [p2, h2]]]):
        fun(opairs):
          exists(
            (fun(g): (!poly_eq(fst(g))(p1) && (!poly_eq(fst(g))(p2) && (can(mdiv(lcm))(hd(fst(g))) && (!memx(align([g, [p1, h1]]))(map(snd)(opairs)) && !memx(align([g, [p2, h2]]))(map(snd)(opairs)))))))
          )(basis)
  let constant_poly = (fun(p): ((length(p) == 1) && forall((fun (y): 0 == y))(snd(hd(p)))))
  // Recursive basis construction needs the local definition before its first use.
  fun grobner_basis(basis):
    fun(pairs):
      print((to_string(length(basis)) +& (" basis elements and " +& (to_string(length(pairs)) +& " critical pairs"))))
      println("")
      match pairs
      | PairList []: basis
      | PairList [[l, [p1, p2]], & opairs]:
          let [sp, hist] as sph = monic(reduce(basis)(spoly(l)(p1)(p2)))
          if ((sp == (PairList [])) || criterion2(basis)([l, [p1, p2]])(opairs))
          | grobner_basis(basis)(opairs)
          | if constant_poly(sp)
            | grobner_basis(PairList [sph, & basis])(PairList [])
            | let rawcps = map((fun(p): [mlcm(hd(fst(p)))(hd(sp)), align([p, sph])]))(basis)
              let newcps = filter((fun([l, [p, q]]): !orthogonal(l)(fst(p))(fst(q))))(rawcps)
              grobner_basis(PairList [sph, & basis])(merge(forder)(opairs)(mergesort(forder)(newcps)))
  // Recursive basis reduction needs the local definition before its first use.
  fun grobner_interreduce(rpols):
    fun(ipols):
      match ipols
      | PairList []: map(monic)(rev(rpols))
      | PairList [p, & ps]:
          let p_prime = reduce(append(rpols)(ps))(p)
          (if (fst(p_prime) == (PairList [])) | grobner_interreduce(rpols)(ps) | grobner_interreduce(PairList [p_prime, & rpols])(ps))
  let grobner:
    fun(pols):
      let npols = map2(fun(p): fun(n): [p, Start(n)])(pols)(range(0)((length(pols) - 1)))
      let phists = filter((fun([p, _]): (p != (PairList []))))(npols)
      let bas = grobner_interreduce(PairList [])(map(monic)(phists))
      let prs0 = allpairs(fun(x): fun(y): [x, y])(bas)(bas)
      let prs1 = filter((fun([[x, _], [y, _]]): poly_lt(x)(y)))(prs0)
      let prs2 = map((fun([p, q]): [mlcm(hd(fst(p)))(hd(fst(q))), [p, q]]))(prs1)
      let prs3 = filter((fun([l, [p, q]]): !orthogonal(l)(fst(p))(fst(q))))(prs2)
      grobner_basis(bas)(mergesort(forder)(prs3))
  let grobner_refute:
    fun(pols):
      let gb = grobner(pols)
      snd(
        find((fun([p, h]): ((length(p) == 1) && forall((fun (y): 0 == y))(snd(hd(p))))))(gb)
      )
  // Recursive proof resolution needs the local definition before its first use.
  fun resolve_proof(vars):
    fun(prf):
      match prf
      | Start(-1): PairList []
      | Start(m): PairList [[m, PairList [[num_1, map(K(0))(vars)]]]]
      | Mmul(pol,lin):
          let lis = resolve_proof(vars)(lin)
          map((fun([n, p]): [n, grob_cmul(pol)(p)]))(lis)
      | Add(lin1,lin2):
          let lis1_2 = resolve_proof(vars)(lin1)
          let lis2_2 = resolve_proof(vars)(lin2)
          let dom_2 = setify(union(map(fst)(lis1_2))(map(fst)(lis2_2)))
          map(
            fun(n):
              let a_2:
                try:
                  assoc(n)(lis1_2)
                  ~catch exn:
                    match exn
                    | Failure(_): PairList []
                    | exn: (throw exn)
              let b_2:
                try:
                  assoc(n)(lis2_2)
                  ~catch exn:
                    match exn
                    | Failure(_): PairList []
                    | exn: (throw exn)
              [n, grob_add(a_2)(b_2)]
          )(dom_2)
  let grobner_weak:
    fun(vars):
      fun(pols):
        let cert = resolve_proof(vars)(grobner_refute(pols))
        let l = itlist(o(itlist(o(o(lcm_num)(denominator))(fst)))(snd))(cert)(num_1)
        [l, map((fun([i, p]): [i, map((fun([d, m]): [(l * d), m]))(p)]))(cert)]
  let grobner_ideal:
    fun(vars):
      fun(pols):
        fun(pol):
          let [pol_prime, h] = reduce(grobner(pols))([grob_neg(pol), Start(-1)])
          (if (pol_prime != (PairList [])) | failwith("grobner_ideal: not in the ideal") | resolve_proof(vars)(h))
  let grobner_strong:
    fun(vars):
      fun(pols):
        fun(pol):
          if (pol == (PairList []))
          | [1, num_1, PairList []]
          | let vars_prime = PairList [concl(TRUTH), & vars]
            let grob_z_2 = PairList [[num_1, PairList [1, & map((fun(x): 0))(vars)]]]
            let grob_1_2 = PairList [[num_1, map((fun(x): 0))(vars_prime)]]
            let augment_2 = map((fun([c, m]): [c, PairList [0, & m]]))
            let pols_prime_2 = map(augment_2)(pols)
            let pol_prime_2 = augment_2(pol)
            let allpols = PairList [grob_sub(grob_mul(grob_z_2)(pol_prime_2))(grob_1_2), & pols_prime_2]
            let [l, cert] = grobner_weak(vars_prime)(allpols)
            let d = itlist(o(itlist(o(o(hol_max)(hd))(snd)))(snd))(cert)(0)
            let transform_monomial = (fun([c, m]): grob_cmul([c, tl(m)])(grob_pow(vars)(pol)((d - hd(m)))))
            let transform_polynomial = (fun(q): itlist(o(grob_add)(transform_monomial))(q)(PairList []))
            let cert_prime = map((fun([c, q]): [(c - 1), transform_polynomial(q)]))(filter((fun([k, _]): (k != 0)))(cert))
            [d, l, cert_prime]
  let pth_step_2:
    prove(
      [
        @hol|{!(add:A->A->A) (mul:A->A->A) (n0:A).
           (!x. mul n0 x = n0) /\
           (!x y z. (add x y = add x z) <=> (y = z)) /\
           (!w x y z. (add (mul w y) (mul x z) = add (mul w z) (mul x y)) <=>
                      (w = x) \/ (y = z))
           ==> (!a b c d. ~(a = b) /\ ~(c = d) <=>
                          ~(add (mul a c) (mul b d) =
                            add (mul a d) (mul b c))) /\
               (!n a b c d. ~(n = n0)
                            ==> (a = b) /\ ~(c = d)
                                ==> ~(add a (mul n c) = add b (mul n d)))}|,
        REPEAT(GEN_TAC) then_tac STRIP_TAC then_tac \
        ASM_REWRITE_TAC(PairList [GSYM(DE_MORGAN_THM)]) then_tac \
        REPEAT(GEN_TAC) then_tac \
        DISCH_TAC then_tac \
        STRIP_TAC then_tac \
        FIRST_X_ASSUM(
          o(MP_TAC)(
            SPECL(
              PairList [
                @hol|{n0:A}|,
                @hol|{n:A}|,
                @hol|{d:A}|,
                @hol|{c:A}|
              ]
            )
          )
        ) then_tac \
        ONCE_REWRITE_TAC(PairList [GSYM(CONTRAPOS_THM)]) then_tac \
        ASM_SIMP_TAC(PairList [])
      ]
    )
  let FINAL_RULE_2:
    MATCH_MP(
      TAUT(
        @hol|{(p ==> F) ==> (~q = p) ==> q}|
      )
    )
  let false_tm_2 = @hol|{F}|
  // Recursive refutation needs the local definition before its first use.
  fun refute_disj(rfn):
    fun(tm):
      match tm
      | Comb(Comb(Const("\\/",_),l),r): DISJ_CASES(ASSUME(tm))(refute_disj(rfn)(l))(refute_disj(rfn)(r))
      | _: rfn(tm)
  fun([ring_dest_const, ring_mk_const, RING_EQ_CONV, ring_neg_tm, ring_add_tm, ring_sub_tm, ring_inv_tm, ring_mul_tm, ring_div_tm, ring_pow_tm, RING_INTEGRAL, RABINOWITSCH_THM, RING_NORMALIZE_CONV]):
    let INITIAL_CONV:
      (
        TOP_DEPTH_CONV(BETA_CONV) then_conv PRESIMP_CONV then_conv \
        CONDS_ELIM_CONV then_conv \
        NNF_CONV then_conv \
        (if is_iff(snd(strip_forall(concl(RABINOWITSCH_THM)))) | GEN_REWRITE_CONV(ONCE_DEPTH_CONV)(PairList [RABINOWITSCH_THM]) | ALL_CONV) then_conv \
        GEN_REWRITE_CONV(
          REDEPTH_CONV)(
          PairList [
            AND_FORALL_THM,
            LEFT_AND_FORALL_THM,
            RIGHT_AND_FORALL_THM,
            LEFT_OR_FORALL_THM,
            RIGHT_OR_FORALL_THM,
            OR_EXISTS_THM,
            LEFT_OR_EXISTS_THM,
            RIGHT_OR_EXISTS_THM,
            LEFT_AND_EXISTS_THM,
            RIGHT_AND_EXISTS_THM
          ]
        )
      )
    let ring_dest_neg_2:
      fun(t):
        let [l, r] = dest_comb(t)
        (if (l == ring_neg_tm) | r | failwith("ring_dest_neg"))
    let ring_dest_inv_2:
      fun(t):
        let [l, r] = dest_comb(t)
        (if (l == ring_inv_tm) | r | failwith("ring_dest_inv"))
    let ring_dest_add_2 = dest_binop(ring_add_tm)
    let ring_mk_add_2 = mk_binop(ring_add_tm)
    let ring_dest_sub_2 = dest_binop(ring_sub_tm)
    let ring_dest_mul_2 = dest_binop(ring_mul_tm)
    let ring_mk_mul_2 = mk_binop(ring_mul_tm)
    let ring_dest_div_2 = dest_binop(ring_div_tm)
    let ring_dest_pow_2 = dest_binop(ring_pow_tm)
    let ring_mk_pow_2 = mk_binop(ring_pow_tm)
    // Recursive variable collection needs the local definition before its first use.
    fun grobvars(tm):
      fun(acc):
        if can(ring_dest_const)(tm)
        | acc
        | if can(ring_dest_neg_2)(tm)
          | grobvars(rand(tm))(acc)
          | if (can(ring_dest_pow_2)(tm) && is_numeral(rand(tm)))
            | grobvars(lhand(tm))(acc)
            | if (can(ring_dest_add_2)(tm) || (can(ring_dest_sub_2)(tm) || can(ring_dest_mul_2)(tm)))
              | grobvars(lhand(tm))(grobvars(rand(tm))(acc))
              | if can(ring_dest_inv_2)(tm)
                | let gvs = grobvars(rand(tm))(PairList [])
                  (if (gvs == (PairList [])) | acc | PairList [tm, & acc])
                | if can(ring_dest_div_2)(tm)
                  | let lvs_2 = grobvars(lhand(tm))(acc)
                    let gvs_2 = grobvars(rand(tm))(PairList [])
                    (if (gvs_2 == (PairList [])) | lvs_2 | PairList [tm, & acc])
                  | PairList [tm, & acc]
    // Recursive polynomial translation needs the local definition before its first use.
    fun grobify_term(vars):
      fun(tm):
        try:
          if !mem(tm)(vars)
          | failwith("")
          | PairList [[num_1, map((fun(i): (if (i == tm) | 1 | 0)))(vars)]]
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  let x = ring_dest_const(tm)
                  (if (x == num_0) | PairList [] | PairList [[x, map((fun(v): 0))(vars)]])
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          grob_neg(grobify_term(vars)(ring_dest_neg_2(tm)))
                          ~catch exn:
                            match exn
                            | Failure(_):
                                try:
                                  grob_inv(grobify_term(vars)(ring_dest_inv_2(tm)))
                                  ~catch exn:
                                    match exn
                                    | Failure(_):
                                        try:
                                          let [l, r] = ring_dest_add_2(tm)
                                          grob_add(grobify_term(vars)(l))(grobify_term(vars)(r))
                                          ~catch exn:
                                            match exn
                                            | Failure(_):
                                                try:
                                                  let [l, r] = ring_dest_sub_2(tm)
                                                  grob_sub(grobify_term(vars)(l))(grobify_term(vars)(r))
                                                  ~catch exn:
                                                    match exn
                                                    | Failure(_):
                                                        try:
                                                          let [l, r] = ring_dest_mul_2(tm)
                                                          grob_mul(grobify_term(vars)(l))(grobify_term(vars)(r))
                                                          ~catch exn:
                                                            match exn
                                                            | Failure(_):
                                                                try:
                                                                  let [l, r] = ring_dest_div_2(tm)
                                                                  grob_div(grobify_term(vars)(l))(grobify_term(vars)(r))
                                                                  ~catch exn:
                                                                    match exn
                                                                    | Failure(_):
                                                                        try:
                                                                          let [l, r] = ring_dest_pow_2(tm)
                                                                          grob_pow(vars)(grobify_term(vars)(l))(dest_small_numeral(r))
                                                                          ~catch exn:
                                                                            match exn
                                                                            | Failure(_): failwith("grobify_term: unknown or invalid term")
                                                                            | exn: (throw exn)
                                                                    | exn: (throw exn)
                                                            | exn: (throw exn)
                                                    | exn: (throw exn)
                                            | exn: (throw exn)
                                    | exn: (throw exn)
                            | exn: (throw exn)
                    | exn: (throw exn)
            | exn: (throw exn)
    let grobify_equation:
      fun(vars):
        fun(tm):
          let [l, r] = dest_eq(tm)
          grob_sub(grobify_term(vars)(l))(grobify_term(vars)(r))
    let grobify_equations:
      fun(tm):
        let cjs = conjuncts(tm)
        let rawvars = itlist(fun(eq): fun(a): grobvars(lhand(eq))(grobvars(rand(eq))(a)))(cjs)(PairList [])
        let vars = sort(fun(x): fun(y): (x < y))(setify(rawvars))
        [vars, map(grobify_equation(vars))(cjs)]
    let holify_varpow = (fun([v, n]): (if (n == 1) | v | ring_mk_pow_2(v)(mk_small_numeral(n))))
    let holify_monomial:
      fun(vars):
        fun([c, m]):
          let xps = map(holify_varpow)(filter((fun([_, n]): (n != 0)))(zip(vars)(m)))
          end_itlist(ring_mk_mul_2)(PairList [ring_mk_const(c), & xps])
    let holify_polynomial = fun(vars): fun(p): (if (p == (PairList [])) | ring_mk_const(num_0) | end_itlist(ring_mk_add_2)(map(holify_monomial(vars))(p)))
    let holify_polynomial = holify_polynomial
    let [pth_idom, pth_ine] = CONJ_PAIR(MATCH_MP(pth_step_2)(RING_INTEGRAL))
    let IDOM_RULE = CONV_RULE(REWR_CONV(pth_idom))
    let PROVE_NZ = (fun(n): EQF_ELIM(RING_EQ_CONV(mk_eq([ring_mk_const(n), ring_mk_const(num_0)]))))
    let NOT_EQ_01_2 = PROVE_NZ(num_1)
    let INE_RULE_2 = (fun(n): MATCH_MP(MATCH_MP(pth_ine)(PROVE_NZ(n))))
    let MK_ADD_2 = fun(th1): fun(th2): MK_COMB([AP_TERM(ring_add_tm)(th1), th2])
    let execute_proof:
      fun(vars):
        fun(eths):
          fun(prf):
            let [x, th1] = SPEC_VAR(CONJUNCT1(CONJUNCT2(RING_INTEGRAL)))
            let [y, th2] = SPEC_VAR(th1)
            let [z, th3] = SPEC_VAR(th2)
            let SUB_EQ_RULE = GEN_REWRITE_RULE(I)(PairList [SYM(INST(PairList [[mk_comb([ring_neg_tm, z]), x]])(th3))])
            let initpols = map(o(CONV_RULE(BINOP_CONV(RING_NORMALIZE_CONV)))(SUB_EQ_RULE))(eths)
            let ADD_RULE_2 = fun(th1): fun(th2): CONV_RULE(BINOP_CONV(RING_NORMALIZE_CONV))(MK_COMB([AP_TERM(ring_add_tm)(th1), th2]))
            let MUL_RULE_2 = fun(vars): fun(m): fun(th): CONV_RULE(BINOP_CONV(RING_NORMALIZE_CONV))(AP_TERM(mk_comb([ring_mul_tm, holify_polynomial(vars)(PairList [m])]))(th))
            // Recursive lookup needs the local definition before its first use.
            fun assoceq(a):
              fun(l):
                match l
                | PairList []: failwith("assoceq")
                | PairList [[x, y], & t]: (if (x === a) | y | assoceq(a)(t))
            let run_proof:
              if is_iff(snd(strip_forall(concl(RABINOWITSCH_THM))))
              | print("Generating HOL version of proof")
                println("")
                let execache = Box(PairList [])
                let memoize:
                  fun(prf):
                    fun(x):
                      execache.value := PairList [[prf, x], & execache.value]
                      x
                // Recursive proof execution needs the local definition before its first use.
                fun run_proof_2(vars):
                  fun(prf):
                    try:
                      assoceq(prf)(execache.value)
                      ~catch exn:
                        match exn
                        | Failure(_):
                            match prf
                            | Start(m): el(m)(initpols)
                            | Add(p1,p2): memoize(prf)(ADD_RULE_2(run_proof_2(vars)(p1))(run_proof_2(vars)(p2)))
                            | Mmul(m,p2): memoize(prf)(MUL_RULE_2(vars)(m)(run_proof_2(vars)(p2)))
                        | exn: (throw exn)
                fun(vars):
                  fun(prf):
                    let ans = run_proof_2(vars)(prf)
                    execache.value := PairList []
                    ans
              | print("Generating HOL version of scaled proof")
                println("")
                let km = map((fun(x): 0))(vars)
                let execache = Box(PairList [])
                let memoize:
                  fun(prf):
                    fun(x):
                      execache.value := PairList [[prf, x], & execache.value]
                      x
                // Recursive scaled proof execution needs the local definition before its first use.
                fun run_scaled_proof(vars):
                  fun(prf):
                    try:
                      assoceq(prf)(execache.value)
                      ~catch exn:
                        match exn
                        | Failure(_):
                            match prf
                            | Start(m): [num_1, el(m)(initpols)]
                            | Add(p1,p2):
                                let [d1_2, th1_2] = run_scaled_proof(vars)(p1)
                                let [d2_2, th2_2] = run_scaled_proof(vars)(p2)
                                let d = lcm_num(d1_2)(d2_2)
                                memoize(prf)(
                                  [
                                    d,
                                    ADD_RULE_2(MUL_RULE_2(vars)([(d / d1_2), km])(th1_2))(MUL_RULE_2(vars)([(d / d2_2), km])(th2_2))
                                  ]
                                )
                            | Mmul([c, xs],p2):
                                let e = denominator(c)
                                let [d, th] = run_scaled_proof(vars)(p2)
                                memoize(prf)([(d * e), MUL_RULE_2(vars)([(c * e), xs])(th)])
                        | exn: (throw exn)
                fun(vars):
                  fun(prf):
                    let [_, ans] = run_scaled_proof(vars)(prf)
                    execache.value := PairList []
                    ans
            let th = run_proof(vars)(prf)
            CONV_RULE(RING_EQ_CONV)(th)
    let REFUTE:
      fun(tm):
        if (tm == false_tm_2)
        | ASSUME(tm)
        | let [nths0, eths0] = partition(o(is_neg)(concl))(CONJUNCTS(ASSUME(tm)))
          let nths_2 = filter(o(o(is_eq)(rand))(concl))(nths0)
          let eths_2 = filter(o(is_eq)(concl))(eths0)
          if (eths_2 == (PairList []))
          | let th1 = end_itlist(fun(th1): fun(th2): IDOM_RULE(CONJ(th1)(th2)))(nths_2)
            let th2 = CONV_RULE(RAND_CONV(BINOP_CONV(RING_NORMALIZE_CONV)))(th1)
            let [l, r] = dest_eq(rand(concl(th2)))
            EQ_MP(EQF_INTRO(th2))(REFL(l))
          | if ((nths_2 == (PairList [])) && !is_var(ring_neg_tm))
            | let [vars, pols] = grobify_equations(list_mk_conj(map(concl)(eths_2)))
              execute_proof(vars)(eths_2)(grobner_refute(pols))
            | let [vars, l, cert, noteqth]:
                if (nths_2 == (PairList []))
                | let [vars, pols] = grobify_equations(list_mk_conj(map(concl)(eths_2)))
                  let [l, cert] = grobner_weak(vars)(pols)
                  [vars, l, cert, NOT_EQ_01_2]
                | let nth = end_itlist(fun(th1): fun(th2): IDOM_RULE(CONJ(th1)(th2)))(nths_2)
                  let [vars, PairList [pol, & pols]] = grobify_equations(list_mk_conj(PairList [rand(concl(nth)), & map(concl)(eths_2)]))
                  let [deg, l, cert] = grobner_strong(vars)(pols)(pol)
                  let th1 = CONV_RULE(RAND_CONV(BINOP_CONV(RING_NORMALIZE_CONV)))(nth)
                  let th2 = funpow(deg)(o(IDOM_RULE)(CONJ(th1)))(NOT_EQ_01_2)
                  [vars, l, cert, th2]
              print("Translating certificate to HOL inferences")
              println("")
              let cert_pos_2 = map((fun([i, p]): [i, filter((fun([c, m]): (c > num_0)))(p)]))(cert)
              let cert_neg_2:
                map(
                  fun([i, p]):
                    [
                      i,
                      map((fun([c, m]): [minus_num(c), m]))(filter((fun([c, m]): (c < num_0)))(p))
                    ]
                )(cert)
              let herts_pos_2 = map((fun([i, p]): [i, holify_polynomial(vars)(p)]))(cert_pos_2)
              let herts_neg_2 = map((fun([i, p]): [i, holify_polynomial(vars)(p)]))(cert_neg_2)
              let thm_fn = (fun(pols): (if (pols == (PairList [])) | REFL(ring_mk_const(num_0)) | end_itlist(MK_ADD_2)(map((fun([i, p]): AP_TERM(mk_comb([ring_mul_tm, p]))(el(i)(eths_2))))(pols))))
              let th1_3 = thm_fn(herts_pos_2)
              let th2_3 = thm_fn(herts_neg_2)
              let th3 = CONJ(MK_ADD_2(SYM(th1_3))(th2_3))(noteqth)
              let th4 = CONV_RULE(RAND_CONV(BINOP_CONV(RING_NORMALIZE_CONV)))(INE_RULE_2(l)(th3))
              let [l, r] = dest_eq(rand(concl(th4)))
              EQ_MP(EQF_INTRO(th4))(REFL(l))
    let ring_ty = snd(dest_fun_ty(snd(dest_fun_ty(type_of(ring_add_tm)))))
    let RING_2:
      fun(tm):
        let avs = filter(o((fun (y): ring_ty == y))(type_of))(frees(tm))
        let tm_prime = list_mk_forall([avs, tm])
        let th1 = INITIAL_CONV(mk_neg(tm_prime))
        let [evs, bod] = strip_exists(rand(concl(th1)))
        if is_forall(bod)
        | failwith("RING: non-universal formula")
        | let th1a = WEAK_DNF_CONV(bod)
          let boda = rand(concl(th1a))
          let th2a = refute_disj(REFUTE)(boda)
          let th2b = TRANS(th1a)(EQF_INTRO(NOT_INTRO(DISCH(boda)(th2a))))
          let th2 = UNDISCH(NOT_ELIM(EQF_ELIM(th2b)))
          // Recursive selection needs the local definition before its first use.
          fun CHOOSES(evs):
            fun([etm, th]):
              match evs
              | PairList []: [etm, th]
              | PairList [ev, & oevs]:
                  let [etm_prime, th_prime] = CHOOSES(oevs)([etm, th])
                  [
                    mk_exists([ev, etm_prime]),
                    CHOOSE([ev, ASSUME(mk_exists([ev, etm_prime]))])(th_prime)
                  ]
          let [finbod, th3] = CHOOSES(evs)([bod, th2])
          SPECL(avs)(MATCH_MP(FINAL_RULE_2(DISCH(finbod)(th3)))(th1))
    let ideal_2:
      fun(tms):
        fun(tm):
          let rawvars = itlist(grobvars)(PairList [tm, & tms])(PairList [])
          let vars = sort(fun(x): fun(y): (x < y))(setify(rawvars))
          let pols_2 = map(grobify_term(vars))(tms)
          let pol_2 = grobify_term(vars)(tm)
          let cert = grobner_ideal(vars)(pols_2)(pol_2)
          map(
            fun(n):
              let p = assocd(n)(cert)(PairList [])
              holify_polynomial(vars)(p)
          )(range(0)((length(pols_2) - 1)))
    [RING_2, ideal_2]

fun RING(parms): fst(RING_AND_IDEAL_CONV(parms))

fun ideal_cofactors(parms): snd(RING_AND_IDEAL_CONV(parms))

def NUM_SIMPLIFY_CONV:
  let pre_tm_2 = @hol|{PRE}|
  let div_tm_2 = @hol|{(DIV):num->num->num}|
  let mod_tm_2 = @hol|{(MOD):num->num->num}|
  let p_tm_2 = @hol|{P:num->bool}|
  let n_tm_2 = @hol|{n:num}|
  let m_tm_2 = @hol|{m:num}|
  let q_tm_2 = @hol|{P:num->num->bool}|
  let a_tm_2 = @hol|{a:num}|
  let b_tm_2 = @hol|{b:num}|
  let is_pre_2 = (fun(tm): (is_comb(tm) && (rator(tm) == pre_tm_2)))
  let is_sub_2 = is_binop(@hol|{(-):num->num->num}|)
  let is_div_2 = is_binop(div_tm_2)
  let is_mod_2 = is_binop(mod_tm_2)
  let is_divmod_2 = (fun(tm): (is_div_2(tm) || is_mod_2(tm)))
  let contains_quantifier_2:
    can(
      find_term((fun(t): (is_forall(t) || (is_exists(t) || is_uexists(t)))))
    )
  let BETA2_CONV_2 = (RATOR_CONV(BETA_CONV) then_conv BETA_CONV)
  let PRE_ELIM_THM_prime_prime_2 = CONV_RULE(RAND_CONV(NNF_CONV))(PRE_ELIM_THM)
  let SUB_ELIM_THM_prime_prime_2 = CONV_RULE(RAND_CONV(NNF_CONV))(SUB_ELIM_THM)
  let DIVMOD_ELIM_THM_prime_prime_2 = CONV_RULE(RAND_CONV(NNF_CONV))(DIVMOD_ELIM_THM)
  let pth_evenodd_2:
    prove(
      [
        @hol|{(EVEN(x) <=> (!y. ~(x = SUC(2 * y)))) /\
           (ODD(x) <=> (!y. ~(x = 2 * y))) /\
           (~EVEN(x) <=> (!y. ~(x = 2 * y))) /\
           (~ODD(x) <=> (!y. ~(x = SUC(2 * y))))}|,
        REWRITE_TAC(
          PairList [
            GSYM(NOT_EXISTS_THM),
            GSYM(EVEN_EXISTS),
            GSYM(ODD_EXISTS)
          ]
        ) then_tac \
        REWRITE_TAC(PairList [NOT_EVEN, NOT_ODD])
      ]
    )
  // Recursive conversion needs the local definition before its first use.
  fun NUM_MULTIPLY_CONV(pos):
    fun(tm):
      if (is_forall(tm) || (is_exists(tm) || is_uexists(tm)))
      | BINDER_CONV(NUM_MULTIPLY_CONV(pos))(tm)
      | if (is_imp(tm) && contains_quantifier_2(tm))
        | COMB2_CONV(RAND_CONV(NUM_MULTIPLY_CONV(!pos)))(NUM_MULTIPLY_CONV(pos))(tm)
        | if ((is_conj(tm) || (is_disj(tm) || is_iff(tm))) && contains_quantifier_2(tm))
          | BINOP_CONV(NUM_MULTIPLY_CONV(pos))(tm)
          | if (is_neg(tm) && (!pos && contains_quantifier_2(tm)))
            | RAND_CONV(NUM_MULTIPLY_CONV(!pos))(tm)
            | try:
                let t = find_term((fun(t): (is_pre_2(t) && free_in(t)(tm))))(tm)
                let ty = type_of(t)
                let v = genvar(ty)
                let p = mk_abs([v, subst(PairList [[v, t]])(tm)])
                let th0 = (if pos | PRE_ELIM_THM_prime_prime_2 | PRE_ELIM_THM_prime)
                let th1 = INST(PairList [[p, p_tm_2], [rand(t), n_tm_2]])(th0)
                let th2:
                  CONV_RULE(
                    COMB2_CONV(RAND_CONV(BETA_CONV))(BINDER_CONV(RAND_CONV(BETA_CONV)))
                  )(th1)
                CONV_RULE(RAND_CONV(NUM_MULTIPLY_CONV(pos)))(th2)
                ~catch exn:
                  match exn
                  | Failure(_):
                      try:
                        let t = find_term((fun(t): (is_sub_2(t) && free_in(t)(tm))))(tm)
                        let ty = type_of(t)
                        let v = genvar(ty)
                        let p = mk_abs([v, subst(PairList [[v, t]])(tm)])
                        let th0 = (if pos | SUB_ELIM_THM_prime_prime_2 | SUB_ELIM_THM_prime)
                        let th1 = INST(PairList [[p, p_tm_2], [lhand(t), a_tm_2], [rand(t), b_tm_2]])(th0)
                        let th2:
                          CONV_RULE(
                            COMB2_CONV(RAND_CONV(BETA_CONV))(BINDER_CONV(RAND_CONV(BETA_CONV)))
                          )(th1)
                        CONV_RULE(RAND_CONV(NUM_MULTIPLY_CONV(pos)))(th2)
                        ~catch exn:
                          match exn
                          | Failure(_):
                              try:
                                let t = find_term((fun(t): (is_divmod_2(t) && free_in(t)(tm))))(tm)
                                let x_2 = lhand(t)
                                let y_2 = rand(t)
                                let dtm_2 = mk_comb([mk_comb([div_tm_2, x_2]), y_2])
                                let mtm_2 = mk_comb([mk_comb([mod_tm_2, x_2]), y_2])
                                let vd_2 = genvar(type_of(dtm_2))
                                let vm_2 = genvar(type_of(mtm_2))
                                let p = list_mk_abs([PairList [vd_2, vm_2], subst(PairList [[vd_2, dtm_2], [vm_2, mtm_2]])(tm)])
                                let th0 = (if pos | DIVMOD_ELIM_THM_prime_prime_2 | DIVMOD_ELIM_THM_prime)
                                let th1 = INST(PairList [[p, q_tm_2], [x_2, m_tm_2], [y_2, n_tm_2]])(th0)
                                let th2:
                                  CONV_RULE(
                                    COMB2_CONV(RAND_CONV(BETA2_CONV_2))(funpow(2)(BINDER_CONV)(RAND_CONV(BETA2_CONV_2)))
                                  )(th1)
                                CONV_RULE(RAND_CONV(NUM_MULTIPLY_CONV(pos)))(th2)
                                ~catch exn:
                                  match exn
                                  | Failure(_): REFL(tm)
                                  | exn: (throw exn)
                          | exn: (throw exn)
                  | exn: (throw exn)
  (
    NUM_REDUCE_CONV then_conv CONDS_CELIM_CONV then_conv NNF_CONV then_conv \
    NUM_MULTIPLY_CONV(#true) then_conv \
    NUM_REDUCE_CONV then_conv \
    GEN_REWRITE_CONV(ONCE_DEPTH_CONV)(PairList [pth_evenodd_2])
  )

def NUM_RING:
  let NUM_INTEGRAL_LEMMA:
    prove(
      [
        @hol|{(w = x + d) /\ (y = z + e)
           ==> ((w * y + x * z = w * z + x * y) <=> (w = x) \/ (y = z))}|,
        DISCH_THEN((fun(th): REWRITE_TAC(PairList [th]))) then_tac \
        REWRITE_TAC(PairList [LEFT_ADD_DISTRIB, RIGHT_ADD_DISTRIB, GSYM(ADD_ASSOC)]) then_tac \
        ONCE_REWRITE_TAC(
          PairList [
            AC(ADD_AC)(
              @hol|{a + b + c + d + e = a + c + e + b + d}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [EQ_ADD_LCANCEL, EQ_ADD_LCANCEL_0, MULT_EQ_0])
      ]
    )
  let NUM_INTEGRAL:
    prove(
      [
        @hol|{(!x. 0 * x = 0) /\
           (!x y z. (x + y = x + z) <=> (y = z)) /\
           (!w x y z. (w * y + x * z = w * z + x * y) <=> (w = x) \/ (y = z))}|,
        REWRITE_TAC(PairList [MULT_CLAUSES, EQ_ADD_LCANCEL]) then_tac \
        REPEAT(GEN_TAC) then_tac \
        DISJ_CASES_TAC(
          SPECL(PairList [@hol|{w:num}|, @hol|{x:num}|])(LE_CASES)
        ) then_tac \
        DISJ_CASES_TAC(
          SPECL(PairList [@hol|{y:num}|, @hol|{z:num}|])(LE_CASES)
        ) then_tac \
        REPEAT(
          FIRST_X_ASSUM(o(CHOOSE_THEN(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS])))
        ) then_tac \
        ASM_MESON_TAC(PairList [NUM_INTEGRAL_LEMMA, ADD_SYM, MULT_SYM])
      ]
    )
  let rawring:
    RING(
      [
        dest_numeral,
        mk_numeral,
        NUM_EQ_CONV,
        genvar(bool_ty),
        @hol|{(+):num->num->num}|,
        genvar(bool_ty),
        genvar(bool_ty),
        @hol|{(*):num->num->num}|,
        genvar(bool_ty),
        @hol|{(EXP):num->num->num}|,
        NUM_INTEGRAL,
        TRUTH,
        NUM_NORMALIZE_CONV
      ]
    )
  let initconv_2 = (NUM_SIMPLIFY_CONV then_conv GEN_REWRITE_CONV(DEPTH_CONV)(PairList [ADD1]))
  let t_tm_2 = @hol|{T}|
  fun(tm):
    let th = initconv_2(tm)
    (if (rand(concl(th)) == t_tm_2) | th | EQ_MP(SYM(th))(rawring(rand(concl(th)))))
