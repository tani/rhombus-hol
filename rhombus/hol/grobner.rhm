            let rest_2 = grob_add(o1)(o2)
            (if Host.hol_equal(c_2)(Host.num_0) | rest_2 | PairList.cons([c_2, m1], rest_2))
          | (if morder_lt(m2)(m1) | PairList.cons([c1, m1], grob_add(o1)(l2)) | PairList.cons([c2, m2], grob_add(l1)(o2)))
  let grob_sub = (fun(l1): (fun(l2): grob_add(l1)(grob_neg(l2))))
  let grob_mmul = (fun([c1, m1]): (fun([c2, m2]): [Host.hol_mul(c1)(c2), Host.map2(Host.hol_add)(m1)(m2)]))
  fun grob_cmul(cm): (fun(pol): map(grob_mmul(cm))(pol))
  fun grob_mul(l1):
    fun(l2):
      match l1
      | PairList []: PairList []
      | PairList [h1, & t1]: grob_add(grob_cmul(h1)(l2))(grob_mul(t1)(l2))
  let grob_inv:
    fun(l):
      match l
