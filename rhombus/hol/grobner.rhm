                  | exn: Host.hol_raise(exn)
  Equal.THENC(Equal.THENC(Equal.THENC(Equal.THENC(Equal.THENC(CalcNum.NUM_REDUCE_CONV)(Canon.CONDS_CELIM_CONV))(Canon.NNF_CONV))(NUM_MULTIPLY_CONV(#true)))(CalcNum.NUM_REDUCE_CONV))(Simp.GEN_REWRITE_CONV(Equal.ONCE_DEPTH_CONV)(PairList.cons(pth_evenodd_2, PairList [])))

