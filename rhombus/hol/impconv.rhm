          let ath_2 = EQ_MP(ALPHA(bod_2)(abod_2))(sth_2)
          let [insts_2, tyinsts_2] = fo_term_match_2(lcs_2)(partfn(abod_2))(tm)
          let eth_2 = INSTANTIATE_ALL([PairList [], insts_2, tyinsts_2])(GENL(fvs_2)(ath_2))
          let fth_2 = itlist(fun(v): fun(th): snd(SPEC_VAR(th)))(fvs_2)(eth_2)
          let tm_prime_2 = partfn(concl(fth_2))
          if (compare(tm_prime_2)(tm) == 0)
          | fth_2
          | try:
              SUBS(PairList [ALPHA(tm_prime_2)(tm)])(fth_2)
              ~catch exn:
                match exn
                | Failure(_): failwith("PART_MATCH: Sanity check failure")
                | exn: (throw exn)
  namespace Fo_nets:
    export:
      Vnet
      Lcnet
      Cnet
      Lnet
      Netnode
      empty_net
      enter
      lookup
      rename filter_impl as filter

    variant term_label:
      Vnet(index)
      Lcnet(name, arity)
      Cnet(name, arity)
      Lnet(arity)

    variant t:
      Netnode(edges, tips)

    def empty_net = Netnode(PairList [], PairList [])

    def enter:
      let label_to_store:
        fun(lcs):
          fun(t):
            let [op, args] = strip_comb(t)
            let nargs = length(args)
            match op
            | Const(n,_): [Cnet(n, nargs), args]
            | Abs(v,b):
                let b_prime = (if mem(v)(lcs) | vsubst(PairList [[genvar(Fusion.type_of(v)), v]])(b) | b)
                [Lnet(nargs), PairList [b_prime, & args]]
            | Var(n,_):
                if mem(op)(lcs)
                | [Lcnet(n, nargs), args]
                | match op
                  | Var(_,_): [Vnet(nargs), args]
                  | _: (if #false | #void | failwith("Assertion failed"))
            | Var(_,_): [Vnet(nargs), args]
            | _: (if #false | #void | failwith("Assertion failed"))
      // Recursive net insertion needs the local definition before its first use.
      fun net_update(lcs):
        fun(elem):
          fun(Netnode(edges,tips)):
            fun(arg):
              match arg
              | PairList []: Netnode(edges, PairList [elem, & tips])
              | PairList [t, & rts]:
                  let [label, nts] = label_to_store(lcs)(t)
                  let [child, others]:
                    try:
                      F_F(snd)(I_2)(remove((fun([x, y]): (x == label)))(edges))
                      ~catch exn:
                        match exn
                        | Failure(_): [empty_net, edges]
                        | exn: (throw exn)
                  let new_child = net_update(lcs)(elem)(child)(append(nts)(rts))
                  Netnode(PairList [[label, new_child], & others], tips)
      fun(lcs): fun([t, elem]): fun(net): net_update(lcs)(elem)(net)(PairList [t])

    def lookup:
      let label_for_lookup:
        fun(t):
          let [op, args] = strip_comb(t)
          let nargs = length(args)
          match op
          | Const(n,_): [Cnet(n, nargs), args]
          | Abs(_,b): [Lnet(nargs), PairList [b, & args]]
          | Var(n,_): [Lcnet(n, nargs), args]
          | Comb(_,_): (if #false | #void | failwith("Assertion failed"))
      // Recursive lookup needs the local definition before its first use.
      fun follow(Netnode(edges,tips)):
        fun(arg):
          match arg
          | PairList []: tips
          | PairList [t, & rts]:
              let [label, nts] = label_for_lookup(t)
              let collection:
                try:
                  follow(assoc(label)(edges))(append(nts)(rts))
                  ~catch exn:
                    match exn
                    | Failure(_): PairList []
                    | exn: (throw exn)
              fun support
              | support(PairList []): PairList [[0, rts]]
              | support(PairList [t, & ts]):
                  let PairList [[k, nts_prime], & res_prime] as res = support(ts)
                  PairList [[(k + 1), PairList [t, & nts_prime]], & res]
              let f:
                fun([k, nts]):
                  try:
                    follow(assoc(Vnet(k))(edges))(nts)
                    ~catch exn:
                      match exn
                      | Failure(_): PairList []
                      | exn: (throw exn)
              let follows = map(f)(support(nts))
              append(collection)(flat(follows))
      fun(t): fun(net): follow(net)(PairList [t])

    fun filter_impl(p):
      fun(Netnode(edges,tips)):
        Netnode(
          PairList.map(edges, (fun([l, n]): [l, filter_impl(p)(n)])),
          PairList.filter(tips, ~keep: p)
        )
