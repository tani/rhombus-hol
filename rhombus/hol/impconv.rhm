                  | [Var(n,ty) as v, t]:
                      try:
                        (if Type_annoted_term.equal(t)(rev_assoc(v)(bnds)) | env | fail_2(#void))
                        ~catch exn:
                          match exn
                          | Failure(_):
                              if mem(v)(lcs)
                              | match t
                                | Type_annoted_term.Var_(n_prime,ty_prime):
                                    if ((n_prime == n) && (ty_prime == ty))
                                    | env
                                    | match t
                                      | _: fail_2(#void)
                                | _: fail_2(#void)
                              | let tyenv_prime_4 = type_match(ty)(Type_annoted_term.type_of(t))(tyenv)
                                let t_prime_2:
                                  try:
                                    Some(rev_assoc(v)(tenv))
                                    ~catch exn:
