            | Fusion.Comb(Fusion.Comb(Fusion.Const("=",_),l),_): [l, th]
            | Fusion.Comb(Fusion.Const("~",_),l): [l, GEN_MAP_CONCLUSION_2(Bool.EQF_INTRO)(th)]
            | l: [c, GEN_MAP_CONCLUSION_2(Bool.EQT_INTRO)(th)]
          [pat, C(impconv_Impconv_IMPREWR_CONV)(th_prime)]
      | Fusion.Comb(Fusion.Const("~",_),l): [l, C(impconv_Impconv_REWR_ANNOTCONV)(Bool.EQF_INTRO(th))]
      | Fusion.Const("T",bool_ty): failwith("target_pat_cnv_of_thm")
