          | Variance.Co(): IMP_TRANS(c(v)(t1))(th)
          | Variance.Contra(): IMP_TRANS(th)(c(v)(t2))

    fun THEN_IMPCONV(c1): fun(c2): fun(v): fun(t): bind_impconv(c2)(v)(c1(v)(t))

    fun MATCH_MP_IMPCONV(th):
      fun(arg):
        match arg
        | Variance.Co(): GEN_PART_MATCH(rand)(th)
        | Variance.Contra(): GEN_PART_MATCH(lhand)(th)

    fun IMPCONV_RULE(c):
      fun(th):
        let t = concl(th)
        MATCH_MP(c(Variance.Contra())(t))(th)

    fun IMPCONV_TAC(cnv): fun([_, c] as g): (MATCH_MP_TAC(cnv(Variance.Co())(c)) then_tac TRY(ACCEPT_TAC(TRUTH)))(g)

    variant with_context:
      With_context(value, augment, diminish)

    fun apply_impl(With_context(c,_,_)): c

    fun augment(With_context(_,a,_)): a

    fun diminish(With_context(_,_,d)): d

    fun apply_with_context(c): fun(ctx): fun(v): fun(t): DISCH_CONJ_2(ctx)(apply_impl(augment(c)(Tset.strip_conj(ctx)))(v)(t))

    def imp_conv_of_ctx_imp_conv = apply_impl

    fun CONJ_CTXIMPCONV(c):
      With_context(
        fun(v):
          fun(t):
            let [t1, t2] = dest_conj(t)
            match v
            | Variance.Co():
                try:
                  let th1 = apply_impl(c)(Variance.Co())(t1)
                  try:
                    let t1_prime = imp_conv_outcome(th1)(Variance.Co())
                    MKIMP_CONJ_CO_CTXT(th1)(apply_with_context(c)(t1_prime)(Variance.Co())(t2))
                    ~catch exn:
                      match exn
                      | Failure(_): MKIMPL_CONJ_CO_CTXT(th1)(t2)
                      | exn: (throw exn)
                  ~catch exn:
                    match exn
                    | Failure(_): MKIMPR_CONJ_CO_CTXT(apply_with_context(c)(t1)(Variance.Co())(t2))
                    | exn: (throw exn)
            | Variance.Contra():
                try:
                  let t2s = Tset.remove(Tset.strip_conj(t2))(t1)
                  let th1 = apply_impl(augment(c)(t2s))(Variance.Contra())(t1)
                  try:
                    let t1_prime = imp_conv_outcome(th1)(Variance.Contra())
                    let t1s_2 = Tset.strip_conj(t1)
                    let t1s_prime_2 = Tset.strip_conj(t1_prime)
                    let t1s_prime_prime = Tset.union(t1s_2)(t1s_prime_2)
                    let th2 = apply_impl(augment(c)(t1s_prime_prime))(Variance.Contra())(t2)
                    let th2_prime = DISCH_CONJ_2(t1)(DISCH_CONJ_2(t1_prime)(th2))
                    MKIMP_CONJ_CONTRA_CTXT(DISCH_CONJ_2(t2)(th1))(th2_prime)
                    ~catch exn:
                      match exn
                      | Failure(_): MKIMPL_CONJ_CONTRA_CTXT(DISCH_CONJ_2(t2)(th1))
                      | exn: (throw exn)
                  ~catch exn:
                    match exn
                    | Failure(_): MKIMPR_CONJ_CONTRA_CTXT(apply_with_context(c)(t1)(Variance.Contra())(t2))
                    | exn: (throw exn),
        o(CONJ_CTXIMPCONV)(augment(c)),
        o(CONJ_CTXIMPCONV)(diminish(c))
      )

    fun DISJ_CTXIMPCONV(c):
      With_context(
        fun(v):
          fun(t):
            let [t1, t2] = dest_disj(t)
            try:
              let th1 = apply_impl(c)(v)(t1)
              try:
                MKIMP_DISJ(th1)(apply_impl(c)(v)(t2))
                ~catch exn:
                  match exn
                  | Failure(_): MKIMPL_DISJ(th1)(t2)
                  | exn: (throw exn)
              ~catch exn:
                match exn
                | Failure(_): MKIMPR_DISJ(t1)(apply_impl(c)(v)(t2))
                | exn: (throw exn),
        o(DISJ_CTXIMPCONV)(augment(c)),
        o(DISJ_CTXIMPCONV)(diminish(c))
      )

    fun IMP_CTXIMPCONV(c):
      With_context(
        fun(v):
          fun(t):
            let [t1, t2] = dest_imp(t)
            try:
              let v_prime = Variance.neg(v)
              let th1 = apply_impl(c)(v_prime)(t1)
              let t1_prime = imp_conv_outcome(th1)(v_prime)
              let t1s = Tset.union(Tset.strip_conj(t1))(Tset.strip_conj(t1_prime))
              let c_prime = augment(c)(t1s)
              let mk:
                match v
                | Variance.Co(): MKIMP_IMP_CO_CTXT
                | Variance.Contra(): MKIMP_IMP_CONTRA_CTXT
              try:
                mk(th1)(DISCH_CONJ_2(t1)(DISCH_CONJ_2(t1_prime)(apply_impl(c_prime)(v)(t2))))
                ~catch exn:
                  match exn
                  | Failure(_): MKIMPL_IMP(th1)(t2)
                  | exn: (throw exn)
              ~catch exn:
                match exn
                | Failure(_): MKIMPR_IMP_CTXT(apply_with_context(c)(t1)(v)(t2))
                | exn: (throw exn),
        o(IMP_CTXIMPCONV)(augment(c)),
        o(IMP_CTXIMPCONV)(diminish(c))
      )

    fun IFF_CTXIMPCONV_impl(c):
      With_context(
        fun(v):
          fun(t):
            let [t1, t2] = dest_iff(t)
            let [lr, l, r]:
              match v
              | Variance.Co(): [MKIMP_CO_IFF, MKIMPL_CO_IFF, MKIMPR_CO_IFF]
              | Variance.Contra(): [MKIMP_CONTRA_IFF, MKIMPL_CONTRA_IFF, MKIMPR_CONTRA_IFF]
            try:
              let th1 = apply_impl(c)(v)(mk_imp([t1, t2]))
              try:
                let th2 = apply_impl(c)(v)(mk_imp([t2, t1]))
                try:
                  MKIMP_IFF(th1)(th2)
                  ~catch exn:
                    match exn
                    | Failure(_): lr(th1)(th2)
                    | exn: (throw exn)
                ~catch exn:
                  match exn
                  | Failure(_): l(th1)
                  | exn: (throw exn)
              ~catch exn:
                match exn
                | Failure(_): r(apply_impl(c)(v)(mk_imp([t2, t1])))
                | exn: (throw exn),
        o(IFF_CTXIMPCONV_impl)(augment(c)),
        o(IFF_CTXIMPCONV_impl)(diminish(c))
      )

    fun NOT_CTXIMPCONV(c):
      With_context(
        (fun(v): fun(t): MKIMP_NOT(apply_impl(c)(Variance.neg(v))(dest_neg(t)))),
        o(NOT_CTXIMPCONV)(augment(c)),
        o(NOT_CTXIMPCONV)(diminish(c))
      )

    fun QUANT_CTXIMPCONV(mkimp):
      fun(sel):
        fun(c):
          With_context(
            fun(v):
              fun(t):
                let [x, b] = sel(t)
                let c_prime = diminish(c)(x)
                mkimp(x)(apply_impl(c_prime)(v)(b)),
            o(QUANT_CTXIMPCONV(mkimp)(sel))(augment(c)),
            o(QUANT_CTXIMPCONV(mkimp)(sel))(diminish(c))
          )

    def FORALL_CTXIMPCONV = QUANT_CTXIMPCONV(MKIMP_FORALL)(dest_forall)

    def EXISTS_CTXIMPCONV_impl = QUANT_CTXIMPCONV(MKIMP_EXISTS)(dest_exists)

    def SUB_CTXIMPCONV:
      let iff_ty = hol_type: bool -> bool -> bool
      fun(c):
        With_context(
          fun(v):
            fun(t):
              let [n, ty] = dest_const(fst(strip_comb(t)))
              apply_impl(
                (
                  match n
                  | "==>": IMP_CTXIMPCONV
                  | "/\\": CONJ_CTXIMPCONV
                  | "\\/": DISJ_CTXIMPCONV
                  | "=":
                      if (ty == iff_ty)
                      | IFF_CTXIMPCONV_impl
                      | match n
                        | "!": FORALL_CTXIMPCONV
                        | "?": EXISTS_CTXIMPCONV_impl
                        | "~": NOT_CTXIMPCONV
                        | _: failwith("SUB_CTXIMPCONV")
                  | "!": FORALL_CTXIMPCONV
                  | "?": EXISTS_CTXIMPCONV_impl
                  | "~": NOT_CTXIMPCONV
                  | _: failwith("SUB_CTXIMPCONV")
                )(c)
              )(v)(t),
          o(SUB_CTXIMPCONV)(augment(c)),
          o(SUB_CTXIMPCONV)(diminish(c))
        )

    fun bind_ctximpconv(c):
      fun(v):
        fun(th):
          let [t1, t2] = dest_imp(concl(th))
          match v
          | Variance.Co(): IMP_TRANS(apply_impl(c)(v)(t1))(th)
          | Variance.Contra(): IMP_TRANS(th)(apply_impl(c)(v)(t2))

    fun BIND_CTXIMPCONV(c):
      With_context(
        (fun(v): fun(th): bind_ctximpconv(c)(v)(th)),
        o(BIND_CTXIMPCONV)(augment(c)),
        o(BIND_CTXIMPCONV)(diminish(c))
      )

    fun THEN_CTXIMPCONV(c1):
      fun(c2):
        With_context(
          (fun(v): fun(t): bind_ctximpconv(c2)(v)(apply_impl(c1)(v)(t))),
          (fun(x): THEN_CTXIMPCONV(augment(c1)(x))(augment(c2)(x))),
          (fun(x): THEN_CTXIMPCONV(diminish(c1)(x))(diminish(c2)(x)))
        )

    fun TRY_CTXIMPCONV(c):
      With_context(
        fun(v):
          fun(t):
            try:
              apply_impl(c)(v)(t)
              ~catch exn:
                match exn
                | Failure(_): ALL_IMPCONV(v)(t)
                | Unchanged(): ALL_IMPCONV(v)(t)
                | exn: (throw exn),
        o(TRY_CTXIMPCONV)(augment(c)),
        o(TRY_CTXIMPCONV)(diminish(c))
      )

    fun ORELSE_CTXIMPCONV(c1):
      fun(c2):
        With_context(
          fun(v):
            fun(t):
              try:
                apply_impl(c1)(v)(t)
                ~catch exn:
                  match exn
                  | Failure(_): apply_impl(c2)(v)(t)
                  | exn: (throw exn),
          (fun(x): ORELSE_CTXIMPCONV(augment(c1)(x))(augment(c2)(x))),
          (fun(x): ORELSE_CTXIMPCONV(diminish(c1)(x))(diminish(c2)(x)))
        )

    fun CHANGED_CTXIMPCONV(c):
      With_context(
        fun(v):
          fun(t):
            let th = apply_impl(c)(v)(t)
            let [l, r] = dest_imp(concl(th))
            (if aconv(l)(r) | failwith("CHANGED_CTXIMPCONV") | th),
        o(CHANGED_CTXIMPCONV)(augment(c)),
        o(CHANGED_CTXIMPCONV)(diminish(c))
      )

    fun UNCHANGED_OF_FAIL_CTXIMPCONV(c):
      With_context(
        fun(v):
          fun(t):
            try:
              apply_impl(c)(v)(t)
              ~catch exn:
                match exn
                | Failure(_): (throw Unchanged())
                | exn: (throw exn),
        o(UNCHANGED_OF_FAIL_CTXIMPCONV)(augment(c)),
        o(UNCHANGED_OF_FAIL_CTXIMPCONV)(diminish(c))
      )

    def REPEAT_UNCHANGED_CTXIMPCONV:
      // Recursive context mapping needs the local definition before its first use.
      fun map_all(f):
        fun(xs):
          fun(x):
            match xs
            | PairList []: PairList []
            | PairList [y, & ys]: PairList [f(y)(x), & map_all(f)(ys)(x)]
      fun(cs):
        With_context(
          fun(v):
            fun(t):
              // Recursive conversion loop needs the local definition before its first use.
              fun loop(changed):
                fun(acc):
                  fun(arg_2):
                    match arg_2
                    | PairList []:
                        if changed
                        | loop(#false)(acc)(cs)
                        | match arg_2
                          | PairList []: acc
                          | PairList [c, & cs_prime]:
                              try:
                                let acc_prime = bind_ctximpconv(c)(v)(acc)
                                loop(#true)(acc_prime)(cs_prime)
                                ~catch exn:
                                  match exn
                                  | Unchanged(): loop(changed)(acc)(cs_prime)
                                  | exn: (throw exn)
                    | PairList []: acc
                    | PairList [c, & cs_prime]:
                        try:
                          let acc_prime = bind_ctximpconv(c)(v)(acc)
                          loop(#true)(acc_prime)(cs_prime)
                          ~catch exn:
                            match exn
                            | Unchanged(): loop(changed)(acc)(cs_prime)
                            | exn: (throw exn)
              loop(#false)(IMP_REFL_2(t))(cs),
          o(REPEAT_UNCHANGED_CTXIMPCONV)(map_all(augment)(cs)),
          o(REPEAT_UNCHANGED_CTXIMPCONV)(map_all(diminish)(cs))
        )

    variant atomic:
      Atomic()
      Non_atomic()

    def DEPTH_CTXIMPCONV:
      let bind:
        fun(c):
          fun(na):
            fun(v):
              fun(th):
                let [t1, t2] = dest_imp(concl(th))
                match v
                | Variance.Co(): IMP_TRANS(apply_impl(c)(na)(v)(t1))(th)
                | Variance.Contra(): IMP_TRANS(th)(apply_impl(c)(na)(v)(t2))
      fun self(c):
        With_context(
          fun(v):
            fun(t):
              try:
                let th1 = apply_impl(SUB_CTXIMPCONV(self(c)))(v)(t)
                try:
                  bind(c)(Non_atomic())(v)(th1)
                  ~catch exn:
                    match exn
                    | Failure(_): th1
                    | exn: (throw exn)
                ~catch exn:
                  match exn
                  | Failure("SUB_CTXIMPCONV"):
                      let th1 = apply_impl(c)(Atomic())(v)(t)
                      try:
                        bind_ctximpconv(self(c))(v)(th1)
                        ~catch exn:
                          match exn
                          | Failure(_): th1
                          | exn: (throw exn)
                  | Failure(_): apply_impl(c)(Non_atomic())(v)(t)
                  | exn: (throw exn),
          o(self)(augment(c)),
          o(self)(diminish(c))
        )
      o(UNCHANGED_OF_FAIL_CTXIMPCONV)(self)

    def TOP_DEPTH_CTXIMPCONV:
      fun self_2(c):
        With_context(
          fun(v):
            fun(t):
              try:
                let th = apply_impl(c)(v)(t)
                try:
                  bind_ctximpconv(self_2(c))(v)(th)
                  ~catch exn:
