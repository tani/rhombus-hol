                  | exn: (throw exn),
          o(self_2)(augment(c)),
          o(self_2)(diminish(c))
        )
      o(UNCHANGED_OF_FAIL_CTXIMPCONV)(self_2)

    def ONCE_DEPTH_CTXIMPCONV:
      fun self_3(c):
