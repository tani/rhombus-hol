            OCamlList.rev_map((fun([t, v]): [Type_annoted_term.to_term(t), inst_2(v)]))(tenv_2),
            tyenv_2
          ]
  // Recursive variable matching needs the local definition before its first use.
  fun match_bvs_2(t1):
    fun(t2):
      fun(acc):
        try:
          let [v1_2, b1_2] = dest_abs(t1)
          let [v2_2, b2_2] = dest_abs(t2)
          let n1_2 = fst(dest_var(v1_2))
          let n2_2 = fst(dest_var(v2_2))
          let newacc_2 = (if (n1_2 == n2_2) | acc | insert([n1_2, n2_2])(acc))
          match_bvs_2(b1_2)(b2_2)(newacc_2)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  let [l1_2, r1_2] = dest_comb(t1)
                  let [l2_2, r2_2] = dest_comb(t2)
                  match_bvs_2(l1_2)(l2_2)(match_bvs_2(r1_2)(r2_2)(acc))
                  ~catch exn:
                    match exn
                    | Failure(_): acc
                    | exn: (throw exn)
            | exn: (throw exn)
  let GEN_PART_MATCH_ALL_2:
    fun(partfn):
      fun(th):
        fun(tm):
          let sth_2 = SPEC_ALL(th)
          let bod_2 = concl(sth_2)
          let pbod_2 = partfn(bod_2)
          let lcs_2 = intersect(Fusion.frees(concl(th)))(Fusion.freesl(hyp(th)))
          let fvs_2 = subtract(subtract(Fusion.frees(bod_2))(Fusion.frees(pbod_2)))(lcs_2)
          let bvms_2 = match_bvs_2(tm)(pbod_2)(PairList [])
