    def impconv_Impconv_REWR_IMPCONV_OF_CONV:
      let IMP_SYM = REWR_RULE_2(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"A\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"B\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"C\",[\"Tyapp\",\"bool\",[]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"B\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"A\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"C\",[\"Tyapp\",\"bool\",[]]]]]]")))
      let IMP_EXIST = Equal.GSYM(Theorems.LEFT_IMP_EXISTS_THM)
      let TRY_GEN:
        fun(v):
          fun(th):
            try:
              Bool.GEN(v)(th)
              ~catch exn:
                match exn
                | Failure(_): th
                | exn: Host.hol_raise(exn)
