    class impconv_Fo_nets_ctor_Vnet(field0):
      extends Host.HolVariant
      override port_view(): [1, [0, PairList [this.field0]]]

    class impconv_Fo_nets_ctor_Lcnet(field0, field1):
      extends Host.HolVariant
      override port_view(): [1, [1, PairList [this.field0, this.field1]]]

    class impconv_Fo_nets_ctor_Cnet(field0, field1):
      extends Host.HolVariant
      override port_view(): [1, [2, PairList [this.field0, this.field1]]]

    class impconv_Fo_nets_ctor_Lnet(field0):
      extends Host.HolVariant
      override port_view(): [1, [3, PairList [this.field0]]]

    class impconv_Fo_nets_ctor_Netnode(field0, field1):
      extends Host.HolVariant
      override port_view(): [1, [0, PairList [this.field0, this.field1]]]

    def impconv_Fo_nets_empty_net = impconv_Fo_nets_ctor_Netnode(PairList [], PairList [])

    def impconv_Fo_nets_enter:
      let label_to_store:
        fun(lcs):
          fun(t):
            let [op, args] = Basics.strip_comb(t)
            let nargs = length(args)
            match op
            | Fusion.Const(n,_): [impconv_Fo_nets_ctor_Cnet(n, nargs), args]
            | Fusion.Abs(v,b):
                let b_prime = (if mem(v)(lcs) | Fusion.vsubst(PairList.cons([Basics.genvar(Fusion.type_of(v)), v], PairList []))(b) | b)
                [impconv_Fo_nets_ctor_Lnet(nargs), PairList.cons(b_prime, args)]
            | Fusion.Var(n,_):
                if mem(op)(lcs)
                | [impconv_Fo_nets_ctor_Lcnet(n, nargs), args]
                | match op
                  | Fusion.Var(_,_): [impconv_Fo_nets_ctor_Vnet(nargs), args]
                  | _: (if #false | #void | failwith("Assertion failed"))
            | Fusion.Var(_,_): [impconv_Fo_nets_ctor_Vnet(nargs), args]
            | _: (if #false | #void | failwith("Assertion failed"))
      fun net_update(lcs):
        fun(elem):
          fun(impconv_Fo_nets_ctor_Netnode(edges,tips)):
            fun
            | (PairList []): impconv_Fo_nets_ctor_Netnode(edges, PairList.cons(elem, tips))
            | (PairList [t, & rts]):
                let [label, nts] = label_to_store(lcs)(t)
                let [child, others]:
                  try:
                    Host.F_F(snd)(I_2)(Host.remove((fun([x, y]): Host.hol_equal(x)(label)))(edges))
                    ~catch exn:
                      match exn
                      | Failure(_): [impconv_Fo_nets_empty_net, edges]
                      | exn: Host.hol_raise(exn)
                let new_child = net_update(lcs)(elem)(child)(append(nts)(rts))
                impconv_Fo_nets_ctor_Netnode(PairList.cons([label, new_child], others), tips)
      (fun(lcs): (fun([t, elem]): (fun(net): net_update(lcs)(elem)(net)(PairList.cons(t, PairList [])))))

    def impconv_Fo_nets_lookup:
      let label_for_lookup:
        fun(t):
          let [op, args] = Basics.strip_comb(t)
          let nargs = length(args)
          match op
          | Fusion.Const(n,_): [impconv_Fo_nets_ctor_Cnet(n, nargs), args]
          | Fusion.Abs(_,b): [impconv_Fo_nets_ctor_Lnet(nargs), PairList.cons(b, args)]
          | Fusion.Var(n,_): [impconv_Fo_nets_ctor_Lcnet(n, nargs), args]
          | Fusion.Comb(_,_): (if #false | #void | failwith("Assertion failed"))
      fun follow(impconv_Fo_nets_ctor_Netnode(edges,tips)):
        fun
        | (PairList []): tips
        | (PairList [t, & rts]):
            let [label, nts] = label_for_lookup(t)
            let collection:
              try:
                follow(assoc(label)(edges))(append(nts)(rts))
                ~catch exn:
                  match exn
                  | Failure(_): PairList []
                  | exn: Host.hol_raise(exn)
            fun support
            | support(PairList []): PairList.cons([0, rts], PairList [])
            | support(PairList [t, & ts]):
                let PairList [[k, nts_prime], & res_prime] as res = support(ts)
                PairList.cons([Host.hol_add(k)(1), PairList.cons(t, nts_prime)], res)
            let f:
              fun([k, nts]):
                try:
                  follow(assoc(impconv_Fo_nets_ctor_Vnet(k))(edges))(nts)
                  ~catch exn:
                    match exn
                    | Failure(_): PairList []
                    | exn: Host.hol_raise(exn)
            let follows = map(f)(support(nts))
            append(collection)(Host.flat(follows))
      (fun(t): (fun(net): follow(net)(PairList.cons(t, PairList []))))

    fun impconv_Fo_nets_filter(p): (fun(impconv_Fo_nets_ctor_Netnode(edges,tips)): impconv_Fo_nets_ctor_Netnode(Host.OCamlList.map((fun([l, n]): [l, impconv_Fo_nets_filter(p)(n)]))(edges), Host.OCamlList.filter(p)(tips)))

    def empty_net = impconv_Fo_nets_empty_net

    def enter = impconv_Fo_nets_enter

    def lookup = impconv_Fo_nets_lookup

    def filter = impconv_Fo_nets_filter
