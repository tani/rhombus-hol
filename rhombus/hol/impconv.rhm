  namespace Tset:
    export:
      cmp
      lt
      lift
      of_list
      rename insert_impl as insert
      rename remove_impl as remove
      strip_conj
      rename union_impl as union
      rename mem_impl as mem
      rename subtract_impl as subtract
      empty
      flat_revmap
      flat_map
      rename frees_v2 as frees
      freesl

    fun cmp(x): fun(y): compare(x)(y)

    fun lt(x): fun(y): (compare(x)(y) < 0)

    fun lift(f): fun(xs): o(OCamlList.sort(cmp))(f)(xs)

    def of_list = lift(I_2)

    fun insert_impl(ts):
      fun(t):
        fun self(arg_2):
          match arg_2
          | PairList []: PairList [t]
          | PairList [x, & xs]:
              if lt(x)(t)
              | PairList [x, & self(xs)]
              | match arg_2
                | PairList [x, & _] as xs:
                    if (x == t)
                    | xs
                    | match arg_2
                      | xs: PairList [t, & xs]
                | xs: PairList [t, & xs]
          | PairList [x, & _] as xs:
              if (x == t)
              | xs
              | match arg_2
                | xs: PairList [t, & xs]
          | xs: PairList [t, & xs]
        (if (t == T__2) | ts | self(ts))

    fun remove_impl(ts):
      fun(t):
        fun self_2(arg_3):
          match arg_3
          | PairList []: PairList []
          | PairList [x, & xs]:
              if lt(x)(t)
              | PairList [x, & self_2(xs)]
              | match arg_3
                | PairList [x, & xs]:
                    if (x == t)
                    | xs
                    | match arg_3
                      | PairList [_, & _] as xs: xs
                | PairList [_, & _] as xs: xs
          | PairList [x, & xs]:
              if (x == t)
              | xs
              | match arg_3
                | PairList [_, & _] as xs: xs
          | PairList [_, & _] as xs: xs
        self_2(ts)

    def strip_conj:
      // Recursive conjunction stripping needs the local definition before its first use.
      fun self_3(acc):
        fun(t):
          try:
            let [t1, t2] = dest_conj(t)
            self_3(self_3(acc)(t1))(t2)
            ~catch exn:
              match exn
              | Failure(_): insert_impl(acc)(t)
              | exn: (throw exn)
      self_3(PairList [])

    fun union_impl(l1):
      fun(l2):
        match l1
        | PairList []: l2
        | PairList [h1, & t1]:
            match l2
            | PairList []: l1
            | PairList [h2, & t2]:
                if lt(h1)(h2)
                | PairList [h1, & union_impl(t1)(l2)]
                | match l2
                  | PairList [h2, & t2]:
                      if (h1 == h2)
                      | PairList [h1, & union_impl(t1)(t2)]
                      | match l2
                        | PairList [h2, & t2]: PairList [h2, & union_impl(l1)(t2)]
                  | PairList [h2, & t2]: PairList [h2, & union_impl(l1)(t2)]
            | PairList [h2, & t2]:
                if (h1 == h2)
                | PairList [h1, & union_impl(t1)(t2)]
                | match l2
                  | PairList [h2, & t2]: PairList [h2, & union_impl(l1)(t2)]
            | PairList [h2, & t2]: PairList [h2, & union_impl(l1)(t2)]

    // Recursive membership needs the local definition before its first use.
    fun mem_impl(x):
      fun(arg_4):
        match arg_4
        | PairList [x_prime, & xs]:
            if (x_prime == x)
            | #true
            | match arg_4
              | PairList [x_prime, & xs]:
                  if lt(x_prime)(x)
                  | mem_impl(x)(xs)
                  | match arg_4
                    | _: #false
              | _: #false
        | PairList [x_prime, & xs]:
            if lt(x_prime)(x)
            | mem_impl(x)(xs)
            | match arg_4
              | _: #false
        | _: #false

    fun subtract_impl(l1): fun(l2): filter((fun(x): !mem_impl(x)(l2)))(l1)

    def empty = PairList []

    fun flat_revmap(f):
      fun(xs):
        // Recursive set traversal needs the local definition before its first use.
        fun self_4(acc):
          fun(arg):
            match arg
            | PairList []: acc
            | PairList [x, & xs]: self_4(union_impl(f(x))(acc))(xs)
        self_4(PairList [])(xs)

    fun flat_map(f): fun(xs): o(flat_revmap(f))(rev)(xs)

    // Recursive namespace declaration needs a binding for self-reference.
    fun frees_impl(acc):
      fun(arg):
        match arg
        | Var(_,_) as t: insert_impl(acc)(t)
        | Const(_,_): acc
        | Abs(v,b): remove_impl(frees_impl(acc)(b))(v)
        | Comb(u,v): frees_impl(frees_impl(acc)(u))(v)

    fun freesl(ts): itlist(C(frees_impl))(ts)(empty)

    def frees_v2 = frees_impl(empty)
  namespace Type_annoted_term:
    export:
      Var_
      Const_
      Comb_
      Abs_
      type_of
      of_term
      equal
      to_term
      dummy
      find_term

    variant t:
      Var_(name, type)
      Const_(name, type, term)
      Comb_(operator, operand, type)
      Abs_(variable, body, type)

    fun type_of
    | type_of(Var_(_,ty)): ty
    | type_of(Const_(_,ty,_)): ty
    | type_of(Comb_(_,_,ty)): ty
    | type_of(Abs_(_,_,ty)): ty

    fun of_term
    | of_term(Var(s,ty)): Var_(s, ty)
    | of_term(Const(s,ty) as t): Const_(s, ty, t)
    | of_term(Comb(u,v)):
        let u_prime_2 = of_term(u)
        let v_prime_2 = of_term(v)
        Comb_(u_prime_2, v_prime_2, snd(dest_fun_ty(type_of(u_prime_2))))
    | of_term(Abs(x,b)):
        let x_prime_2 = of_term(x)
        let b_prime_2 = of_term(b)
        Abs_(x_prime_2, b_prime_2, mk_fun_ty(type_of(x_prime_2))(type_of(b_prime_2)))

    fun equal(t1):
      fun(t2):
        match [t1, t2]
        | [Var_(s1,ty1), Var_(s2,ty2)]: ((s1 == s2) && (ty1 == ty2))
        | [Const_(s1,ty1,_), Const_(s2,ty2,_)]: ((s1 == s2) && (ty1 == ty2))
        | [Comb_(u1,v1,_), Comb_(u2,v2,_)]: (equal(u1)(u2) && equal(v1)(v2))
        | [Abs_(v1,b1,_), Abs_(v2,b2,_)]: (equal(v1)(v2) && equal(b1)(b2))
        | _: #false

    fun to_term
    | to_term(Var_(s,ty)): mk_var([s, ty])
    | to_term(Const_(_,_,t)): t
    | to_term(Comb_(u,v,_)): mk_comb([to_term(u), to_term(v)])
    | to_term(Abs_(v,b,_)): mk_abs([to_term(v), to_term(b)])

    def dummy = Var_("", aty)

    fun find_term(p):
      fun(t):
        if p(t)
        | t
        | match t
          | Abs_(_,b,_): find_term(p)(b)
          | Comb_(u,v,_):
              try:
                find_term(p)(u)
                ~catch exn:
                  match exn
                  | Failure(_): find_term(p)(v)
                  | _: failwith("Annot.find_term")
                  | exn: (throw exn)
  let fo_term_match_2:
    fun(lcs):
      fun(p):
        fun(t):
          let fail_2 = (fun(_): failwith("fo_term_match"))
          // Recursive term matching needs the local definition before its first use.
          fun self_5(bnds):
            fun([tenv, tyenv] as env):
              fun(p):
                fun(t):
                  match [p, t]
                  | [Comb(p1,p2), Type_annoted_term.Comb_(t1,t2,_)]: self_5(bnds)(self_5(bnds)(env)(p1)(t1))(p2)(t2)
                  | [Abs(v,p), Type_annoted_term.Abs_(v_prime,t,_)]:
                      let tyenv_prime_2 = type_match(Fusion.type_of(v))(Type_annoted_term.type_of(v_prime))(tyenv)
                      self_5(PairList [[v_prime, v], & bnds])([tenv, tyenv_prime_2])(p)(t)
                  | [Const(n,ty), Type_annoted_term.Const_(n_prime,ty_prime,_)]:
                      if (n != n_prime)
                      | fail_2(#void)
                      | let tyenv_prime_3 = type_match(ty)(ty_prime)(tyenv)
