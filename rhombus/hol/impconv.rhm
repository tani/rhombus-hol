        fun(t):
          let th_prime = pmatch_prime(t)
          VARIANT_RULE_2(avs)(Bool.GENL(impconv_Impconv_indep_vars(th_prime))(th_prime))

    fun impconv_Impconv_IMPREWR_CONV(avs):
