    fun CTXIMPCONV_RULE(c): fun(th): MATCH_MP(apply_impl(c)(Variance.Contra())(concl(th)))(th)

    fun CTXIMPCONV_TAC(cnv):
      fun([asms, c] as g):
        let cnv_prime = augment(cnv)(map(o(concl)(snd))(asms))
        (
          MATCH_MP_TAC(apply_impl(cnv_prime)(Variance.Co())(c)) then_tac \
          TRY(ACCEPT_TAC(TRUTH))
        )(g)

    fun indep_vars(th):
      let [hs, c] = dest_thm(SPEC_ALL(th))
      let [p, c] = dest_imp(c)
      let all_vars = union(Fusion.frees(p))(Fusion.frees(rhs(c)))
      let dep_vars = union(Fusion.frees(lhs(c)))(Fusion.freesl(hs))
      subtract(all_vars)(dep_vars)

    fun GEN_IMPREWR_CONV(avs):
      fun(th):
        fun(t):
          let sel = o(o(o(o(lhs)(snd))(strip_forall))(snd))(dest_imp)
          let pmatch = GEN_PART_MATCH_ALL_2(sel)
          let pmatch_prime = pmatch(th)
          let th_prime = pmatch_prime(t)
          VARIANT_RULE_2(avs)(GENL(indep_vars(th_prime))(th_prime))

    fun IMPREWR_CONV(avs):
      fun(th):
        fun(t):
          let f = (fun(t): SPEC_VARS_2(GEN_IMPREWR_CONV(avs)(th)(t)))
          let [vs, uh] = f(t)
          let u = fst(dest_imp(concl(uh)))
          [UNDISCH(uh), Some(u), Tset.of_list(vs)]

    fun REWR_ANNOTCONV(avs):
      fun(th):
        fun(t):
          let th_prime = PART_MATCH(lhs)(th)(t)
          let [_, t_prime] = dest_binary_blind_2(concl(th_prime))
          let new_vars = Tset.frees(t_prime)
          let old_vars = Tset.union(Tset.frees(t))(Tset.freesl(hyp(th_prime)))
          [th_prime, None(), Tset.subtract(new_vars)(old_vars)]

    fun ORDER_ANNOTCONV(cnv):
      fun(t):
        let [th, _, _] as res = cnv(t)
        let [l, r] = dest_binary_blind_2(concl(th))
        (if term_order(l)(r) | res | failwith("ORDER_ANNOTCONV"))

    fun pat_cnv_of_thm(th):
      let th = SPEC_ALL(th)
      let lconsts_2 = Fusion.freesl(hyp(th))
      let c_7 = concl(th)
      match c_7
      | Comb(Comb(Const("=",_),l),r) as t:
          let matches = C(o(can)(term_match(lconsts_2)))
          (if (free_in(l)(r) || (matches(l)(r) && matches(r)(l))) | [t, C(REWR_ANNOTCONV)(MAP_FORALL_BODY_2(EQT_INTRO)(th))] | [l, C(REWR_ANNOTCONV)(th)])
      | Comb(Comb(Const("==>",_),p),c) as t:
          let matches = C(o(can)(fo_term_match_2(lconsts_2)))
          let imprewr_concl = (fun(f): C(IMPREWR_CONV)(GEN_MAP_CONCLUSION_2(f)(th)))
          match c
          | Comb(Comb(Const("=",_),l),r):
              if (free_in(l)(r) || ((matches(l)(r) && matches(r)(l)) || is_var(l)))
              | (if matches(p)(c) | [t, C(REWR_ANNOTCONV)(EQT_INTRO(th))] | [c, imprewr_concl(EQT_INTRO)])
              | [l, C(IMPREWR_CONV)(th)]
          | Comb(Const("~",_),l): [l, imprewr_concl(EQF_INTRO)]
          | l: [l, imprewr_concl(EQT_INTRO)]
      | Comb(Const("~",_),l): [l, C(REWR_ANNOTCONV)(EQF_INTRO(th))]
      | Const("T",bool_ty): failwith("pat_cnv_of_thm")
      | l: [l, C(REWR_ANNOTCONV)(EQT_INTRO(th))]

    fun impconv_net_of_thm(th):
      try:
        let [p, c] = pat_cnv_of_thm(th)
        let vs = Tset.freesl(hyp(th))
        Fo_nets.enter(vs)([p, [c, vs, th]])
        ~catch exn:
          match exn
          | Failure(_): I_2
          | exn: (throw exn)

    def patterns_of_thm = o(fst)(pat_cnv_of_thm)

    fun REWRITES_IMPCONV(net): fun(avs): fun(t): tryfind((fun([c, _, _]): c(avs)(t)))(Fo_nets.lookup(t)(net))

    def extra_basic_rewrites = itlist(mk_rewrites(#false))(PairList [NOT_FORALL_THM, NOT_IMP])(PairList [])

    def IMPREWR_CTXCONV:
      // Recursive depth conversion needs the local definition before its first use.
      fun top_depth(c):
        fun(avs):
          fun(t):
            let _op2b__op2b__2 = fun(c1):
              fun(c2):
                fun(avs):
                  fun(t):
                    match c1(avs)(t)
                    | [_, Some(_), _] as c1t: c1t
                    | [th1, None(), vs1] as c1t:
                        try:
                          let [th2, ho2, vs2] = c2(Tset.union(vs1)(avs))(rand(concl(th1)))
                          [TRANS(th1)(th2), ho2, Tset.union(vs1)(vs2)]
                          ~catch exn:
                            match exn
                            | Failure(_): c1t
                            | exn: (throw exn)
            let _op2b__2 = fun(c1):
              fun(c2):
                fun(avs):
                  fun(t):
                    try:
                      _op2b__op2b__2(c1)(c2)(avs)(t)
                      ~catch exn:
                        match exn
                        | Failure(_): c2(avs)(t)
                        | exn: (throw exn)
            let COMB_QCONV_2 = fun(c):
              fun(avs):
                fun(l):
                  fun(r):
                    try:
                      match c(avs)(l)
                      | [th, Some(_) as ho, vs]: [AP_THM(th)(r), ho, vs]
                      | [th1, None(), vs1]:
                          try:
                            let [th2, ho2, vs2] = c(Tset.union(vs1)(avs))(r)
                            [MK_COMB([th1, th2]), ho2, Tset.union(vs1)(vs2)]
                            ~catch exn:
                              match exn
                              | Failure(_): [AP_THM(th1)(r), None(), vs1]
                              | exn: (throw exn)
                      ~catch exn:
                        match exn
                        | Failure(_):
                            let [th2, ho2, vs2] = c(avs)(r)
                            [AP_TERM(l)(th2), ho2, vs2]
                        | exn: (throw exn)
            let SUB_QCONV:
              fun(c):
                fun(avs):
                  fun(t):
                    match t
                    | Comb(l,r): COMB_QCONV_2(c)(avs)(l)(r)
                    | Abs(v,_):
