        let [l, r] = dest_binary_blind_2(Fusion.concl(th))
        (if Simp.term_order(l)(r) | res | failwith("ORDER_ANNOTCONV"))

    fun impconv_Impconv_pat_cnv_of_thm(th):
      let th = Bool.SPEC_ALL(th)
      let lconsts_2 = Fusion.freesl(Fusion.hyp(th))
      let c_7 = Fusion.concl(th)
      match c_7
      | Fusion.Comb(Fusion.Comb(Fusion.Const("=",_),l),r) as t:
          let matches = C(o(can)(Drule.term_match(lconsts_2)))
          (if (Basics.free_in(l)(r) || (matches(l)(r) && matches(r)(l))) | [t, C(impconv_Impconv_REWR_ANNOTCONV)(MAP_FORALL_BODY_2(Bool.EQT_INTRO)(th))] | [l, C(impconv_Impconv_REWR_ANNOTCONV)(th)])
      | Fusion.Comb(Fusion.Comb(Fusion.Const("==>",_),p),c) as t:
          let matches = C(o(can)(fo_term_match_2(lconsts_2)))
          let imprewr_concl = (fun(f): C(impconv_Impconv_IMPREWR_CONV)(GEN_MAP_CONCLUSION_2(f)(th)))
          match c
          | Fusion.Comb(Fusion.Comb(Fusion.Const("=",_),l),r):
              if (Basics.free_in(l)(r) || ((matches(l)(r) && matches(r)(l)) || Fusion.is_var(l)))
              | (if matches(p)(c) | [t, C(impconv_Impconv_REWR_ANNOTCONV)(Bool.EQT_INTRO(th))] | [c, imprewr_concl(Bool.EQT_INTRO)])
              | [l, C(impconv_Impconv_IMPREWR_CONV)(th)]
          | Fusion.Comb(Fusion.Const("~",_),l): [l, imprewr_concl(Bool.EQF_INTRO)]
          | l: [l, imprewr_concl(Bool.EQT_INTRO)]
      | Fusion.Comb(Fusion.Const("~",_),l): [l, C(impconv_Impconv_REWR_ANNOTCONV)(Bool.EQF_INTRO(th))]
      | Fusion.Const("T",bool_ty): failwith("pat_cnv_of_thm")
      | l: [l, C(impconv_Impconv_REWR_ANNOTCONV)(Bool.EQT_INTRO(th))]

    fun impconv_Impconv_impconv_net_of_thm(th):
      try:
        let [p, c] = impconv_Impconv_pat_cnv_of_thm(th)
        let vs = Tset.freesl(Fusion.hyp(th))
        Fo_nets.enter(vs)([p, [c, vs, th]])
        ~catch exn:
          match exn
          | Failure(_): I_2
          | exn: Host.hol_raise(exn)

    def impconv_Impconv_patterns_of_thm = o(fst)(impconv_Impconv_pat_cnv_of_thm)

