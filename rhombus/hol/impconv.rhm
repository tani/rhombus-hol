                                      | Failure(_): None()
                                      | exn: (throw exn)
                                match t_prime_2
                                | Some(t_prime): (if (t == t_prime) | [tenv, tyenv_prime_4] | fail_2(#void))
                                | None(): [PairList [[t, v], & tenv], tyenv_prime_4]
                          | exn: (throw exn)
