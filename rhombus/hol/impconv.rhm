    def impconv_Impconv_DEEP_IMP_REWR_MCONV:
      let map_fst = (fun(f): (fun([x, y, z]): [f(x), y, z]))
      let COMB_MCONV_2 = (fun(c): (fun(l): (fun(r): append(map(map_fst(C(Equal.AP_THM)(r)))(c(l)))(map(map_fst(Equal.AP_TERM(l)))(c(r))))))
      let ABS_MCONV_2:
        fun(c):
          fun(v):
            fun(b):
              let ths = c(b)
              try:
                map(map_fst(Fusion.ABS(v)))(ths)
                ~catch exn:
                  match exn
                  | Failure(_):
                      let gv = Basics.genvar(Fusion.type_of(v))
                      let f:
                        fun([gth, ho, vs]):
                          let gtm = Fusion.concl(gth)
                          let [l, r] = Fusion.dest_eq(gtm)
                          let v_prime = Fusion.variant(Fusion.frees(gtm))(v)
                          let l_prime_2 = Basics.alpha(v_prime)(l)
                          let r_prime_2 = Basics.alpha(v_prime)(r)
                          [Fusion.EQ_MP(Equal.ALPHA(gtm)(Fusion.mk_eq([l_prime_2, r_prime_2])))(gth), ho, vs]
                      let b_prime = Fusion.vsubst(PairList.cons([gv, v], PairList []))(b)
                      map(f)(map(map_fst(Fusion.ABS(gv)))(c(b_prime)))
                  | exn: Host.hol_raise(exn)
      let SUB_MCONV:
        fun(c):
          fun
          | (Fusion.Comb(l,r)): COMB_MCONV_2(c)(l)(r)
          | (Fusion.Abs(v,b)): ABS_MCONV_2(c)(v)(b)
          | (Fusion.Const(_,_)): PairList []
          | (Fusion.Var(_,_)): PairList []
      fun top_depth_2(c): (fun(t): append(SUB_MCONV(top_depth_2(c))(t))(c(t)))
      let REWRITES_IMPCONV = (fun(net): (fun(avs): (fun(t): mapfilter((fun([c, _, _]): c(avs)(t)))(Fo_nets.lookup(t)(net)))))
      fun self_5(net):
        fun(ths):
          let avs = Tset.flat_revmap(o(Tset.freesl)(Fusion.hyp))(ths)
          impconv_Impconv_ctor_With_context(
            fun(a):
              fun(t):
                let avs_prime = Tset.union(Tset.frees(t))(avs)
                let cnv = (fun(t): REWRITES_IMPCONV(net)(avs_prime)(t))
                let f:
                  match a
                  | impconv_Impconv_ctor_Atomic(): top_depth_2
                  | impconv_Impconv_ctor_Non_atomic(): (fun(cnv): (fun(avs): cnv(avs)))
                f(cnv)(t),
            (fun(_): self_5(net)(ths)),
            fun(v):
              let ths = Box(PairList [])
              let f:
                fun([_, vs, th]):
                  if Host.hol_not(Tset.mem(v)(vs))
                  | Host.ref_set(ths)(PairList.cons(th, Host.ref_get(ths)))
