                            ho_2.value := ho_prime
                            vs_2.value := vs_prime
                            th
                        let res = ABS_CONV(c_prime)(t)
                        [res, ho_2.value, vs_2.value]
                    | _: failwith("SUB_QCONV")
            // Recursive conversion needs the local definition before its first use.
            fun _op21_(c): fun(avs): fun(t): _op2b__op2b__2(c)(_op21_(c))(avs)(t)
            _op2b__2(_op21_(c))(_op2b__op2b__2(SUB_QCONV(top_depth(c)))(top_depth(c)))(avs)(t)
      let bigger_net = (fun(_): itlist(net_of_thm(#false))(extra_basic_rewrites)(basic_net(#void)))
      let basic_cnv = (fun(t): [REWRITES_CONV(bigger_net(#void))(t), None(), PairList []])
      // Recursive rewrite context needs the local definition before its first use.
      fun self_4(net):
        fun(ths):
          let avs = Tset.flat_revmap(o(Tset.freesl)(hyp))(ths)
          let cnv:
            fun(avs):
              fun(t):
                try:
                  REWRITES_IMPCONV(net)(avs)(t)
                  ~catch exn:
                    match exn
                    | Failure(_): basic_cnv(t)
                    | exn: (throw exn)
          With_context(
            fun(a):
              fun(t):
                let f:
                  match a
                  | Atomic(): top_depth
                  | Non_atomic(): I_2
                f(cnv)(Tset.union(Tset.frees(t))(avs))(t),
            fun(ts):
              let ths_prime = map(ASSUME)(ts)
              let ths_prime_prime = append(MP_CLOSURE_2(ths_prime)(ths_prime))(append(ths_prime)(MP_CLOSURE_2(ths)(ths_prime)))
              self_4(itlist(impconv_net_of_thm)(ths_prime_prime)(net))(append(ths_prime_prime)(ths)),
            fun(v):
              let ths = Box(PairList [])
              let f:
                fun([_, vs, th]):
                  if !Tset.mem(v)(vs)
                  | ths.value := PairList [th, & ths.value]
                    #true
                  | #false
              let net_prime = Fo_nets.filter(f)(net)
              self_4(net_prime)(ths.value)
          )
      (fun(ths): self_4(itlist(impconv_net_of_thm)(ths)(Fo_nets.empty_net))(ths))

    def REWR_IMPCONV_OF_CONV:
      let IMP_SYM:
        REWR_RULE_2(
          TAUT(
            (hol:
               var A :: bool
               var B :: bool
               var C :: bool
               A ==> B ==> C <=> B ==> A ==> C)
          )
        )
      let IMP_EXIST = GSYM(LEFT_IMP_EXISTS_THM)
      let TRY_GEN:
        fun(v):
          fun(th):
            try:
              GEN(v)(th)
              ~catch exn:
                match exn
                | Failure(_): th
                | exn: (throw exn)
      fun(c):
        With_context(
          fun(a):
            fun(v):
              fun(t):
                let [th, ho, new_vars] = apply_impl(c)(a)(t)
                let [th1, th2] = EQ_IMP_RULE(th)
                let res:
                  match v
                  | Variance.Co():
                      let [p, th2_prime] = UNDISCH_TERM_2(th2)
                      fun exists_intro
                      | exists_intro(PairList []): DISCH_IMP_IMP_2(PairList [p, & list_of_option_2(ho)])(th2_prime)
                      | exists_intro(PairList [v, & vs]):
                          let th = exists_intro(vs)
                          try:
                            REWR_RULE_2(IMP_EXIST)(GEN(v)(th))
                            ~catch exn:
                              match exn
                              | Failure(_): th
                              | exn: (throw exn)
                      exists_intro(new_vars)
                  | Variance.Contra():
                      let th1_prime:
                        match ho
                        | None(): th1
                        | Some(h): IMP_SYM(DISCH(h)(th1))
                      match new_vars
                      | PairList []: th1_prime
                      | PairList [_, & _]: MAP_CONCLUSION_2(itlist(TRY_GEN)(new_vars))(th1_prime)
                let [t1, t2] = dest_imp(concl(res))
                (if (t1 == t2) | (throw Unchanged()) | res),
          o(REWR_IMPCONV_OF_CONV)(augment(c)),
          o(REWR_IMPCONV_OF_CONV)(diminish(c))
        )

    def REWRITE_CTXIMPCONV = o(o(DEPTH_CTXIMPCONV)(REWR_IMPCONV_OF_CONV))(IMPREWR_CTXCONV)

    def preprocess = o(CONJUNCTS)(IMPLY_AND_2)

    fun IMP_REWRITE_TAC(ths): fun(gl): fail_if_unchanged_2(CTXIMPCONV_TAC(REWRITE_CTXIMPCONV(flat(map(preprocess)(ths)))))(gl)

    fun SEQ_IMP_REWRITE_TAC(ths):
      fun(gl):
        let cnv:
          match ths
          | PairList []: REWRITE_CTXIMPCONV(PairList [TRUTH])
          | PairList [th, & PairList []]: REWRITE_CTXIMPCONV(preprocess(th))
          | PairList [_, & _]:
              let fcnv = o(REWRITE_CTXIMPCONV)(preprocess)
              REPEAT_UNCHANGED_CTXIMPCONV(map(fcnv)(ths))
        fail_if_unchanged_2(CTXIMPCONV_TAC(cnv))(gl)

    def ASM_IMP_REWRITE_TAC = ASM(IMP_REWRITE_TAC)

    def CASE_REWR_IMPCONV_OF_CONV:
      let MP_TAUT = (fun(th): MATCH_MP(TAUT(th)))
      let MP_LEM1:
        MP_TAUT(
          (hol:
             var P :: bool
             var Q :: bool
             var R :: bool
             (!P ==> (Q <=> R)) ==> (Q <=> (!P ==> R) && (P ==> Q)))
        )
      let MP_LEM2:
        MP_TAUT(
          (hol:
             var P :: bool
             var Q :: bool
             var R :: bool
             (P ==> (Q <=> R)) ==> (Q <=> (P ==> R) && (!P ==> Q)))
        )
      fun(c):
        With_context(
          fun(a):
            fun(v):
              fun(t):
                match apply_impl(c)(a)(t)
                | [_, None(), _]: failwith("CASE_REWR_IMPCONV_OF_CONV")
                | [th, Some(h), _]:
                    let th_prime = DISCH(h)(th)
                    let th_prime_prime:
                      try:
                        MP_LEM1(th_prime)
                        ~catch exn:
                          match exn
                          | Failure(_): MP_LEM2(th_prime)
                          | exn: (throw exn)
                    imp_conv_of_conv(REWR_CONV(th_prime_prime))(v)(t),
          o(CASE_REWR_IMPCONV_OF_CONV)(augment(c)),
          o(CASE_REWR_IMPCONV_OF_CONV)(diminish(c))
        )

    def CASE_REWRITE_CTXIMPCONV = o(o(ONCE_DEPTH_CTXIMPCONV)(CASE_REWR_IMPCONV_OF_CONV))(IMPREWR_CTXCONV)

    def CASE_REWRITE_TAC = fail_if_unchanged_2(o(o(CTXIMPCONV_TAC)(CASE_REWRITE_CTXIMPCONV))(preprocess))

    fun mapply_with_context(c): fun(ctx): fun(v): fun(t): map(DISCH_CONJ_2(ctx))(apply_impl(augment(c)(Tset.strip_conj(ctx)))(v)(t))

    fun CONJ_CTXIMPMCONV(c):
      With_context(
        fun(v):
          fun(t):
            let [t1, t2] = dest_conj(t)
            let [left, right]:
              match v
              | Variance.Co(): [MKIMPL_CONJ_CO2_CTXT, MKIMPR_CONJ_CO_CTXT]
              | Variance.Contra(): [MKIMPL_CONJ_CONTRA_CTXT, MKIMPR_CONJ_CONTRA_CTXT]
            let th1s = map(left)(mapply_with_context(c)(t2)(v)(t1))
            let th2s = map(right)(mapply_with_context(c)(t1)(v)(t2))
            append(th1s)(th2s),
        o(CONJ_CTXIMPMCONV)(augment(c)),
        o(CONJ_CTXIMPMCONV)(diminish(c))
      )

    fun DISJ_CTXIMPMCONV(c):
      With_context(
        fun(v):
          fun(t):
            let [t1, t2] = dest_disj(t)
            let th1s = map(C(MKIMPL_DISJ)(t2))(apply_impl(c)(v)(t1))
            let th2s = map(MKIMPR_DISJ(t1))(apply_impl(c)(v)(t2))
            append(th1s)(th2s),
        o(DISJ_CTXIMPMCONV)(augment(c)),
        o(DISJ_CTXIMPMCONV)(diminish(c))
      )

    fun IMP_CTXIMPMCONV(c):
      With_context(
        fun(v):
          fun(t):
            let [t1, t2] = dest_imp(t)
            let th1s = map(C(MKIMPL_IMP)(t2))(apply_impl(c)(Variance.neg(v))(t1))
            let th2s = map(MKIMPR_IMP_CTXT)(mapply_with_context(c)(t1)(v)(t2))
            append(th1s)(th2s),
        o(CONJ_CTXIMPMCONV)(augment(c)),
        o(CONJ_CTXIMPMCONV)(diminish(c))
      )

    fun IFF_CTXIMPCONV_v2(c):
      With_context(
        fun(v):
          fun(t):
            let [t1, t2] = dest_iff(t)
            let [left, right]:
              match v
              | Variance.Co(): [MKIMPL_CO_IFF, MKIMPR_CO_IFF]
              | Variance.Contra(): [MKIMPL_CONTRA_IFF, MKIMPR_CONTRA_IFF]
            let th1s = map(left)(apply_impl(c)(v)(mk_imp([t1, t2])))
            let th2s = map(right)(apply_impl(c)(v)(mk_imp([t2, t1])))
            append(th1s)(th2s),
        o(IFF_CTXIMPCONV_v2)(augment(c)),
        o(IFF_CTXIMPCONV_v2)(diminish(c))
      )

    fun NOT_CTXIMPMCONV(c):
      With_context(
        (fun(v): fun(t): map(MKIMP_NOT)(try_list_2(apply_impl(c)(Variance.neg(v)))(dest_neg(t)))),
        o(NOT_CTXIMPMCONV)(augment(c)),
        o(NOT_CTXIMPMCONV)(diminish(c))
      )

    fun QUANT_CTXIMPMCONV(mkimp):
      fun(sel):
        fun(c):
          With_context(
            fun(v):
              fun(t):
                let [x, b] = sel(t)
                let c_prime = diminish(c)(x)
                map(mkimp(x))(try_list_2(apply_impl(c_prime)(v))(b)),
            o(QUANT_CTXIMPMCONV(mkimp)(sel))(augment(c)),
            o(QUANT_CTXIMPMCONV(mkimp)(sel))(diminish(c))
          )

    def FORALL_CTXIMPMCONV = QUANT_CTXIMPMCONV(MKIMP_FORALL)(dest_forall)

    def EXISTS_CTXIMPMCONV = QUANT_CTXIMPMCONV(MKIMP_EXISTS)(dest_exists)

    def SUB_CTXIMPMCONV:
      let iff_ty = hol_type: bool -> bool -> bool
      fun(c):
        With_context(
          fun(v):
            fun(t):
              let [n, ty] = dest_const(fst(strip_comb(t)))
              apply_impl(
                (
                  match n
                  | "==>": IMP_CTXIMPMCONV
                  | "/\\": CONJ_CTXIMPMCONV
                  | "\\/": DISJ_CTXIMPMCONV
                  | "!": FORALL_CTXIMPMCONV
                  | "?": EXISTS_CTXIMPMCONV
                  | "~": NOT_CTXIMPMCONV
                  | "=":
                      if (ty == iff_ty)
                      | IFF_CTXIMPCONV_v2
                      | match n
                        | _: failwith("SUB_CTXIMPMCONV")
                  | _: failwith("SUB_CTXIMPMCONV")
                )(c)
              )(v)(t),
          o(SUB_CTXIMPMCONV)(augment(c)),
          o(SUB_CTXIMPMCONV)(diminish(c))
        )

    fun DEPTH_CTXIMPMCONV(c):
      With_context(
        fun(v):
          fun(t):
            try:
              let ths = apply_impl(SUB_CTXIMPMCONV(DEPTH_CTXIMPMCONV(c)))(v)(t)
              append(apply_impl(c)(Non_atomic())(v)(t))(ths)
              ~catch exn:
                match exn
                | Failure("SUB_CTXIMPMCONV"): apply_impl(c)(Atomic())(v)(t)
                | exn: (throw exn),
        o(DEPTH_CTXIMPMCONV)(augment(c)),
        o(DEPTH_CTXIMPMCONV)(diminish(c))
      )

    fun target_pat_cnv_of_thm(th):
      let th = SPEC_ALL(th)
      match concl(th)
      | Comb(Comb(Const("=",_),l),_): [l, C(REWR_ANNOTCONV)(th)]
      | Comb(Comb(Const("==>",_),_),c):
          let [pat, th_prime]:
            match c
            | Comb(Comb(Const("=",_),l),_): [l, th]
            | Comb(Const("~",_),l): [l, GEN_MAP_CONCLUSION_2(EQF_INTRO)(th)]
            | l: [c, GEN_MAP_CONCLUSION_2(EQT_INTRO)(th)]
          [pat, C(IMPREWR_CONV)(th_prime)]
      | Comb(Const("~",_),l): [l, C(REWR_ANNOTCONV)(EQF_INTRO(th))]
      | Const("T",bool_ty): failwith("target_pat_cnv_of_thm")
      | l: [l, C(REWR_ANNOTCONV)(EQT_INTRO(th))]

    fun target_impconv_net_of_thm(th):
      try:
        let [p, c] = target_pat_cnv_of_thm(th)
        let vs = Tset.freesl(hyp(th))
        Fo_nets.enter(vs)([p, [c, vs, th]])
        ~catch exn:
          match exn
          | Failure(_): I_2
          | exn: (throw exn)

    def target_patterns_of_thm = o(fst)(target_pat_cnv_of_thm)

    def DEEP_IMP_REWR_MCONV:
      let map_fst = fun(f): fun([x, y, z]): [f(x), y, z]
      let COMB_MCONV_2 = fun(c): fun(l): fun(r): append(map(map_fst(C(AP_THM)(r)))(c(l)))(map(map_fst(AP_TERM(l)))(c(r)))
      let ABS_MCONV_2:
        fun(c):
          fun(v):
            fun(b):
              let ths = c(b)
              try:
                map(map_fst(ABS(v)))(ths)
                ~catch exn:
                  match exn
                  | Failure(_):
                      let gv = genvar(Fusion.type_of(v))
                      let f:
                        fun([gth, ho, vs]):
                          let gtm = concl(gth)
                          let [l, r] = dest_eq(gtm)
                          let v_prime = variant(Fusion.frees(gtm))(v)
                          let l_prime_2 = alpha(v_prime)(l)
                          let r_prime_2 = alpha(v_prime)(r)
                          [EQ_MP(ALPHA(gtm)(mk_eq([l_prime_2, r_prime_2])))(gth), ho, vs]
                      let b_prime = vsubst(PairList [[gv, v]])(b)
                      map(f)(map(map_fst(ABS(gv)))(c(b_prime)))
                  | exn: (throw exn)
      let SUB_MCONV:
        fun(c):
          fun
          | (Comb(l,r)): COMB_MCONV_2(c)(l)(r)
          | (Abs(v,b)): ABS_MCONV_2(c)(v)(b)
          | (Const(_,_)): PairList []
          | (Var(_,_)): PairList []
      // Recursive conversion needs the local definition before its first use.
      fun top_depth_2(c): fun(t): append(SUB_MCONV(top_depth_2(c))(t))(c(t))
      let REWRITES_IMPCONV = fun(net): fun(avs): fun(t): mapfilter((fun([c, _, _]): c(avs)(t)))(Fo_nets.lookup(t)(net))
      // Recursive rewrite context needs the local definition before its first use.
      fun self_5(net):
        fun(ths):
          let avs = Tset.flat_revmap(o(Tset.freesl)(hyp))(ths)
          With_context(
            fun(a):
              fun(t):
                let avs_prime = Tset.union(Tset.frees(t))(avs)
                let cnv = (fun(t): REWRITES_IMPCONV(net)(avs_prime)(t))
                let f:
                  match a
                  | Atomic(): top_depth_2
                  | Non_atomic(): fun(cnv): fun(avs): cnv(avs)
                f(cnv)(t),
            (fun(_): self_5(net)(ths)),
            fun(v):
              let ths = Box(PairList [])
              let f:
                fun([_, vs, th]):
                  if !Tset.mem(v)(vs)
                  | ths.value := PairList [th, & ths.value]
                    #true
                  | #false
              let net_prime = Fo_nets.filter(f)(net)
              self_5(net_prime)(ths.value)
          )
      (fun(ths): self_5(itlist(target_impconv_net_of_thm)(ths)(Fo_nets.empty_net))(ths))

    def REWR_IMPMCONV_OF_MCONV:
      let IMP_SYM:
        REWR_RULE_2(
          TAUT(
            (hol:
               var A :: bool
               var B :: bool
               var C :: bool
               A ==> B ==> C <=> B ==> A ==> C)
          )
        )
      let IMP_EXIST = GSYM(LEFT_IMP_EXISTS_THM)
      let TRY_GEN:
        fun(v):
          fun(th):
            try:
              GEN(v)(th)
              ~catch exn:
                match exn
                | Failure(_): th
                | exn: (throw exn)
      fun(c):
        With_context(
          fun(a):
            fun(v):
              fun(t):
                let f:
                  fun([th, ho, new_vars]):
                    let [th1, th2] = EQ_IMP_RULE(th)
                    match v
                    | Variance.Co():
                        let [p, th2_prime] = UNDISCH_TERM_2(th2)
                        fun exists_intro_2
                        | exists_intro_2(PairList []): DISCH_IMP_IMP_2(PairList [p, & list_of_option_2(ho)])(th2_prime)
                        | exists_intro_2(PairList [v, & vs]):
                            let th = exists_intro_2(vs)
                            try:
                              REWR_RULE_2(IMP_EXIST)(GEN(v)(th))
                              ~catch exn:
                                match exn
                                | Failure(_): th
                                | exn: (throw exn)
                        exists_intro_2(new_vars)
                    | Variance.Contra():
                        let th1_prime:
                          match ho
                          | None(): th1
                          | Some(h): IMP_SYM(DISCH(h)(th1))
                        match new_vars
                        | PairList []: th1_prime
                        | PairList [_, & _]: MAP_CONCLUSION_2(itlist(TRY_GEN)(new_vars))(th1_prime)
                map(f)(apply_impl(c)(a)(t)),
          o(REWR_IMPMCONV_OF_MCONV)(augment(c)),
          o(REWR_IMPMCONV_OF_MCONV)(diminish(c))
        )

    def EXISTS_CTXIMPCONV_v2:
      let EXISTSs:
        fun(i):
          fun(p):
            let [codom, dom_2] = unzip(i)
            let f = fun(i): fun(ps): PairList [vsubst(PairList [i])(snd(dest_exists(hd(ps)))), & ps]
            let PairList [h, & ps] = rev_itlist(f)(i)(PairList [list_mk_exists([dom_2, p])])
            rev_itlist(EXISTS)(zip(ps)(rev(codom)))(ASSUME(h))
      let LEFT_FORALL_IMP = REWR_RULE_2(LEFT_FORALL_IMP_THM)
      fun self_6(ts):
        With_context(
          fun(v):
            fun(t):
              match [v, t]
              | [Variance.Co(), Comb(Const("?",_),_)]:
                  let [vs, b] = strip_exists(t)
                  let bs = strip_conj_2(b)
                  let hmatch:
                    fun([n, b]):
                      match partition(C(mem)(vs))(variables(b))
                      | [PairList [], _]: failwith("EXISTS_CTXIMPCONV")
                      | [PairList [_, & _] as lvs, lcs]:
                          fun(h):
                            let subject = term_match(lcs)(b)(h)
                            match subject
                            | [_, i, j]:
                                if (filter(uncurry((fun (x): fun (y): x != y)))(j) == (PairList []))
                                | [(if (i == (PairList [])) | zip(lvs)(lvs) | i), n]
                                | match subject
                                  | _: failwith("EXISTS_CTXIMPCONV")
                            | _: failwith("EXISTS_CTXIMPCONV")
                  let [s, n] = tryfind_fun_2(mapfilteri_2(curry(o(tryfind)(hmatch)))(bs))(ts)
                  let th = EXISTSs(map((fun(v): [rev_assocd(v)(s)(v), v]))(vs))(b)
                  let th_prime = DISCH_HD_2(th)
                  let h = fst(dest_imp(concl(th_prime)))
                  match strip_conj_2(h)
                  | PairList []: (if #false | #void | failwith("Assertion failed"))
                  | PairList [h, & PairList []]: DISCH(T__2)(th)
                  | PairList [_, & _] as hs:
                      let [hs1, PairList [h_prime, & hs2]] = chop_list(n)(hs)
                      let hs_th = CONJ_ACI_RULE(mk_eq([h, list_mk_conj(PairList [h_prime, & append(hs1)(hs2)])]))
                      let th1 = CONV_RULE(LAND_CONV(REWR_CONV(hs_th)))(th_prime)
                      let th2 = UNDISCH(CONV_RULE(REWR_CONV(IMP_CONJ))(th1))
                      let vs_prime = subtract(vs)(map(snd)(s))
                      let f:
                        fun(v):
                          fun(th):
                            try:
                              LEFT_FORALL_IMP(GEN(v)(th))
                              ~catch exn:
                                match exn
                                | Failure(_): th
                                | exn: (throw exn)
                      itlist(f)(vs_prime)(th2)
              | _: failwith("EXISTS_CTXIMPCONV"),
          (fun(ts_prime): self_6(Tset.union(ts_prime)(ts))),
          (fun(_): self_6(ts))
        )
      self_6(PairList [])

    fun bind_impmconv(c):
      fun(v):
        fun(th):
          let [t1, t2] = dest_imp(concl(th))
          match v
          | Variance.Co(): map(C(IMP_TRANS)(th))(c(v)(t1))
          | Variance.Contra(): map(IMP_TRANS(th))(c(v)(t2))

    def TARGET_REWRITE_IMPCONV:
      let PRE = apply_impl(TRY_CTXIMPCONV(REWRITE_CTXIMPCONV(PairList [])))
      let POST = TRY_CTXIMPCONV(TOP_DEPTH_CTXIMPCONV(EXISTS_CTXIMPCONV_v2))
      fun(sths):
        let one_step_sths:
          fun(v):
            fun(uh):
              let pre:
                fun(v):
                  fun(th):
                    try:
                      bind_impconv(PRE)(v)(th)
                      ~catch exn:
                        match exn
                        | Unchanged(): th
                        | exn: (throw exn)
              let post = (fun(v): bind_ctximpconv(POST)(v))
              let f = o(o(DEPTH_CTXIMPMCONV)(REWR_IMPMCONV_OF_MCONV))(DEEP_IMP_REWR_MCONV)
              map(post(v))(bind_impmconv(apply_impl(f(sths)))(v)(pre(v)(uh)))
        let flat_2 = (fun(l): uniq(itlist(merge(thm_lt_2))(l)(PairList [])))
        fun(ts):
          fun(v):
            fun(t):
              fun self_7(ths):
                let pool = flat_2(map(o(mergesort(thm_lt_2))(one_step_sths(v)))(ths))
                let sel = (fun(th): imp_conv_outcome(th)(v))
                let is_one_sol = (fun(g): o(o(o(o(can)(Basics.find_term))(can))(fo_term_match_2(PairList []))(g))(sel))
                let is_sol = (fun(th): tryfind(is_one_sol)(ts)(th))
                try:
                  bind_ctximpconv(POST)(v)(find(is_sol)(pool))
                  ~catch exn:
                    match exn
                    | _:
                        match pool
                        | PairList []: failwith("TARGET_REWRITE_IMPCONV: no path found")
                        | PairList [_, & _]: self_7(map(bind_ctximpconv(POST)(v))(pool))
                    | exn: (throw exn)
              self_7(PairList [IMP_REFL_2(t)])

    fun TARGET_REWRITE_TAC(sths):
      fun(th):
        let sths_prime = flat(map(preprocess)(sths))
        let ths_2 = preprocess(th)
        let _op2b__3 = THEN_IMPCONV
        fail_if_unchanged_2(
          IMPCONV_TAC(
            _op2b__3(TARGET_REWRITE_IMPCONV(sths_prime)(map(patterns_of_thm)(ths_2)))(imp_conv_of_ctx_imp_conv(REWRITE_CTXIMPCONV(ths_2)))
          )
        )

    def HINT_EXISTS_TAC = fail_if_unchanged_2(CTXIMPCONV_TAC(TOP_DEPTH_CTXIMPCONV(EXISTS_CTXIMPCONV_v2)))
  [
    Impconv.IMP_REWRITE_TAC,
    Impconv.TARGET_REWRITE_TAC,
    Impconv.HINT_EXISTS_TAC,
    Impconv.SEQ_IMP_REWRITE_TAC,
    Impconv.CASE_REWRITE_TAC
  ]

def IMP_REWRITE_TAC = impconv_IMP_REWRITE_TAC_v2

def TARGET_REWRITE_TAC = impconv_TARGET_REWRITE_TAC_v2

def HINT_EXISTS_TAC = impconv_HINT_EXISTS_TAC_v2

def SEQ_IMP_REWRITE_TAC = impconv_SEQ_IMP_REWRITE_TAC_v2
