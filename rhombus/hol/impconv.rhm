    fun impconv_Impconv_indep_vars(th):
      let [hs, c] = Fusion.dest_thm(Bool.SPEC_ALL(th))
      let [p, c] = Basics.dest_imp(c)
      let all_vars = union(Fusion.frees(p))(Fusion.frees(Equal.rhs(c)))
      let dep_vars = union(Fusion.frees(Equal.lhs(c)))(Fusion.freesl(hs))
      subtract(all_vars)(dep_vars)

    fun impconv_Impconv_GEN_IMPREWR_CONV(avs):
      let sel = o(o(o(o(Equal.lhs)(snd))(Basics.strip_forall))(snd))(Basics.dest_imp)
      let pmatch = GEN_PART_MATCH_ALL_2(sel)
      fun(th):
