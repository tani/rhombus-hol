          [Bool.UNDISCH(uh), Host.Some(u), Tset.of_list(vs)]

    fun impconv_Impconv_REWR_ANNOTCONV(avs):
      fun(th):
        fun(t):
          let th_prime = Drule.PART_MATCH(Equal.lhs)(th)(t)
          let [_, t_prime] = dest_binary_blind_2(Fusion.concl(th_prime))
          let new_vars = Tset.frees(t_prime)
          let old_vars = Tset.union(Tset.frees(t))(Tset.freesl(Fusion.hyp(th_prime)))
          [th_prime, Host.None(), Tset.subtract(new_vars)(old_vars)]

    fun impconv_Impconv_ORDER_ANNOTCONV(cnv):
      fun(t):
