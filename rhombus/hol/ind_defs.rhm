def strip_ncomb:
  fun strip([n, tm, acc]):
    if Host.hol_lt(n)(1)
    | [tm, acc]
    | let [l, r] = Fusion.dest_comb(tm)
      strip([Host.hol_sub(n)(1), l, PairList.cons(r, acc)])
  (fun(n): (fun(tm): strip([n, tm, PairList []])))

def RIGHT_BETAS = rev_itlist((fun(a): o(Equal.CONV_RULE(Equal.RAND_CONV(Equal.BETA_CONV)))(C(Equal.AP_THM)(a))))

def EXISTS_EQUATION:
  let pth = Tactics.prove([Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"t\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"t\",[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]]]]]]"), Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Simp.REWRITE_TAC(PairList.cons(Bool.EXISTS_DEF, PairList [])))(Tactics.BETA_TAC))(Tactics.REPEAT(Tactics.STRIP_TAC)))(Tactics.FIRST_ASSUM(Tactics.MATCH_MP_TAC)))(Tactics.EXISTS_TAC(Host.expand_quote("[\"Var\",\"t\",[\"Tyvar\",\"A\"]]"))))(Tactics.FIRST_ASSUM(Tactics.MATCH_MP_TAC)))(Tactics.REFL_TAC)])
  fun(tm):
    fun(th):
      let [l, r] = Fusion.dest_eq(tm)
      let P = Fusion.mk_abs([l, Fusion.concl(th)])
      let th1 = Equal.BETA_CONV(Fusion.mk_comb([P, l]))
      let th2 = Bool.ISPECL(PairList.cons(P, PairList.cons(r, PairList [])))(pth)
      let th3 = Fusion.EQ_MP(Equal.SYM(th1))(th)
      let th4 = Bool.GEN(l)(Bool.DISCH(tm)(th3))
      Bool.MP(th2)(th4)

def derive_nonschematic_inductive_relations:
  let getconcl_2:
    fun(tm):
      let bod = Host.repeat(o(snd)(Basics.dest_forall))(tm)
      try:
        snd(Basics.dest_imp(bod))
        ~catch exn:
          match exn
          | Failure(_): bod
          | exn: Host.hol_raise(exn)
  let CONJ_ACI_RULE_2 = Theorems.AC(Theorems.CONJ_ACI)
  let SIMPLE_DISJ_PAIR_2:
    fun(th):
      let [l, r] = Basics.dest_disj(hd(Fusion.hyp(th)))
      [Bool.PROVE_HYP(Bool.DISJ1(Fusion.ASSUME(l))(r))(th), Bool.PROVE_HYP(Bool.DISJ2(l)(Fusion.ASSUME(r)))(th)]
  let HALF_BETA_EXPAND_2 = (fun(args): (fun(th): Bool.GENL(args)(RIGHT_BETAS(args)(th))))
  let AND_IMPS_CONV:
    fun(tm):
      let ths = Bool.CONJUNCTS(Fusion.ASSUME(tm))
      let avs = fst(Basics.strip_forall(Fusion.concl(hd(ths))))
      let thl = map(o(o(Bool.DISCH(tm))(Bool.UNDISCH))(Bool.SPEC_ALL))(ths)
      let th1 = end_itlist(Bool.SIMPLE_DISJ_CASES)(thl)
      let tm1 = hd(Fusion.hyp(th1))
      let th2 = Bool.GENL(avs)(Bool.DISCH(tm1)(Bool.UNDISCH(th1)))
      let tm2 = Fusion.concl(th2)
      let th3 = Bool.DISCH(tm2)(Bool.UNDISCH(Bool.SPEC_ALL(Fusion.ASSUME(tm2))))
      let [thts, tht] = nsplit(SIMPLE_DISJ_PAIR_2)(tl(ths))(th3)
      let proc_fn:
        fun(th):
          let t = hd(Fusion.hyp(th))
          Bool.GENL(avs)(Bool.DISCH(t)(Bool.UNDISCH(th)))
      let th4 = itlist(o(Bool.CONJ)(proc_fn))(thts)(proc_fn(tht))
      Bool.IMP_ANTISYM_RULE(Bool.DISCH_ALL(th2))(Bool.DISCH_ALL(th4))
  let t_tm = Host.expand_quote("[\"Const\",\"T\",[\"Tyapp\",\"bool\",[]]]")
  fun getequs([avs, plis]):
    if Host.hol_equal(plis)(PairList [])
    | PairList []
    | let PairList [h, & t] = plis
      let r = snd(h)
      (if mem(r)(avs) | PairList.cons(h, getequs([avs, filter(o(Host.hol_unequal(r))(snd))(t)])) | getequs([avs, t]))
  let calculate_simp_sequence_2:
    fun(avs):
      fun(plis):
        let oks = getequs([avs, plis])
        [oks, subtract(plis)(oks)]
  let FORALL_IMPS_CONV_2:
    fun(tm):
      let [avs, bod] = Basics.strip_forall(tm)
      let th1 = Bool.DISCH(tm)(Bool.UNDISCH(Bool.SPEC_ALL(Fusion.ASSUME(tm))))
      let th2 = itlist(Bool.SIMPLE_CHOOSE)(avs)(th1)
      let tm2 = hd(Fusion.hyp(th2))
      let th3 = Bool.DISCH(tm2)(Bool.UNDISCH(th2))
      let th4 = Fusion.ASSUME(Fusion.concl(th3))
      let ant = Equal.lhand(bod)
      let th5 = itlist(Bool.SIMPLE_EXISTS)(avs)(Fusion.ASSUME(ant))
      let th6 = Bool.GENL(avs)(Bool.DISCH(ant)(Bool.MP(th4)(th5)))
      Bool.IMP_ANTISYM_RULE(Bool.DISCH_ALL(th3))(Bool.DISCH_ALL(th6))
  let canonicalize_clause:
    fun(cls):
      fun(args):
        let [avs, bimp] = Basics.strip_forall(cls)
        let [ant, con]:
          try:
            Basics.dest_imp(bimp)
            ~catch exn:
              match exn
              | Failure(_): [t_tm, bimp]
              | exn: Host.hol_raise(exn)
        let [rel, xargs] = Basics.strip_comb(con)
        let plis = zip(args)(xargs)
        let [yes, no] = calculate_simp_sequence_2(avs)(plis)
        let nvs = filter(o(Host.hol_not)(C(mem)(map(snd)(yes))))(avs)
        let eth:
          if Basics.is_imp(bimp)
          | let atm = itlist(o(curry(Bool.mk_conj))(Fusion.mk_eq))(append(yes)(no))(ant)
            let [ths, tth] = nsplit(Bool.CONJ_PAIR)(plis)(Fusion.ASSUME(atm))
            let thl = map((fun(t): find((fun(th): Host.hol_equal(Equal.lhs(Fusion.concl(th)))(t)))(ths)))(args)
            let th0 = Bool.MP(Bool.SPECL(avs)(Fusion.ASSUME(cls)))(tth)
            let th1 = rev_itlist(C(curry(Fusion.MK_COMB)))(thl)(Fusion.REFL(rel))
            let th2 = Fusion.EQ_MP(Equal.SYM(th1))(th0)
            let th3 = Fusion.INST(yes)(Bool.DISCH(atm)(th2))
            let tm4 = Host.funpow(length(yes))(Fusion.rand)(Equal.lhand(Fusion.concl(th3)))
            let th4 = itlist(o(o(Bool.CONJ)(Fusion.REFL))(fst))(yes)(Fusion.ASSUME(tm4))
            let th5 = Bool.GENL(args)(Bool.GENL(nvs)(Bool.DISCH(tm4)(Bool.MP(th3)(th4))))
            let th6 = Bool.SPECL(nvs)(Bool.SPECL(map(snd)(plis))(Fusion.ASSUME(Fusion.concl(th5))))
            let th7 = itlist(o(o(Bool.CONJ)(Fusion.REFL))(snd))(no)(Fusion.ASSUME(ant))
            let th8 = Bool.GENL(avs)(Bool.DISCH(ant)(Bool.MP(th6)(th7)))
            Bool.IMP_ANTISYM_RULE(Bool.DISCH_ALL(th5))(Bool.DISCH_ALL(th8))
          | let atm = Bool.list_mk_conj(map(Fusion.mk_eq)(append(yes)(no)))
            let ths = Bool.CONJUNCTS(Fusion.ASSUME(atm))
            let thl = map((fun(t): find((fun(th): Host.hol_equal(Equal.lhs(Fusion.concl(th)))(t)))(ths)))(args)
            let th0 = Bool.SPECL(avs)(Fusion.ASSUME(cls))
            let th1 = rev_itlist(C(curry(Fusion.MK_COMB)))(thl)(Fusion.REFL(rel))
            let th2 = Fusion.EQ_MP(Equal.SYM(th1))(th0)
            let th3 = Fusion.INST(yes)(Bool.DISCH(atm)(th2))
            let tm4 = Host.funpow(length(yes))(Fusion.rand)(Equal.lhand(Fusion.concl(th3)))
            let th4 = itlist(o(o(Bool.CONJ)(Fusion.REFL))(fst))(yes)(Fusion.ASSUME(tm4))
            let th5 = Bool.GENL(args)(Bool.GENL(nvs)(Bool.DISCH(tm4)(Bool.MP(th3)(th4))))
            let th6 = Bool.SPECL(nvs)(Bool.SPECL(map(snd)(plis))(Fusion.ASSUME(Fusion.concl(th5))))
            let th7 = end_itlist(Bool.CONJ)(map(o(Fusion.REFL)(snd))(no))
            let th8 = Bool.GENL(avs)(Bool.MP(th6)(th7))
            Bool.IMP_ANTISYM_RULE(Bool.DISCH_ALL(th5))(Bool.DISCH_ALL(th8))
        let ftm = Host.funpow(length(args))(o(Basics.body)(Fusion.rand))(Fusion.rand(Fusion.concl(eth)))
        Fusion.TRANS(eth)(itlist(Drule.MK_FORALL)(args)(FORALL_IMPS_CONV_2(ftm)))
  let canonicalize_clauses_2:
    fun(clauses):
      let concls = map(getconcl_2)(clauses)
      let uncs = map(Basics.strip_comb)(concls)
      let rels = itlist(o(insert)(fst))(uncs)(PairList [])
      let xargs = map(C(assoc)(uncs))(rels)
      let closed = Bool.list_mk_conj(clauses)
      let avoids = Basics.variables(closed)
      let flargs = Basics.make_args("a")(avoids)(map(Fusion.type_of)(end_itlist(append)(xargs)))
      let zargs = zip(rels)(Host.shareout(xargs)(flargs))
      let cargs = map((fun([r, a]): assoc(r)(zargs)))(uncs)
      let cthms = Host.map2(canonicalize_clause)(clauses)(cargs)
      let pclauses = map(o(Fusion.rand)(Fusion.concl))(cthms)
      let collectclauses = (fun(tm): mapfilter((fun(t): (if Host.hol_equal(fst(t))(tm) | snd(t) | Host.hol_apply_unit(fail))))(zip(map(fst)(uncs))(pclauses)))
      let clausell = map(collectclauses)(rels)
      let cclausel = map(Bool.list_mk_conj)(clausell)
      let cclauses_2 = Bool.list_mk_conj(cclausel)
      let oclauses_2 = Bool.list_mk_conj(pclauses)
      let eth = CONJ_ACI_RULE_2(Fusion.mk_eq([oclauses_2, cclauses_2]))
      let pth = Fusion.TRANS(end_itlist(Drule.MK_CONJ)(cthms))(eth)
      Fusion.TRANS(pth)(end_itlist(Drule.MK_CONJ)(map(AND_IMPS_CONV)(cclausel)))
  let derive_canon_inductive_relations_2:
    fun(clauses):
      let closed = Bool.list_mk_conj(clauses)
      let clauses = Basics.conjuncts(closed)
      let [vargs, bodies] = unzip(map(Basics.strip_forall)(clauses))
      let [ants, concs] = unzip(map(Basics.dest_imp)(bodies))
      let rels = map(Host.repeat(Fusion.rator))(concs)
      let avoids = Basics.variables(closed)
      let rels_prime = Basics.variants(avoids)(rels)
      let crels = zip(rels_prime)(rels)
      let prime_fn = Basics.subst(crels)
      let closed_prime = prime_fn(closed)
      let mk_def = (fun(arg): (fun(con): Fusion.mk_eq([Host.repeat(Fusion.rator)(con), Basics.list_mk_abs([arg, Bool.list_mk_forall([rels_prime, Bool.mk_imp([closed_prime, prime_fn(con)])])])])))
      let deftms = Host.map2(mk_def)(vargs)(concs)
      let defthms = Host.map2(HALF_BETA_EXPAND_2)(vargs)(map(Fusion.ASSUME)(deftms))
      let mk_ind:
        fun(args):
          fun(th):
            let th1 = fst(Bool.EQ_IMP_RULE(Bool.SPEC_ALL(th)))
            let ant = Equal.lhand(Fusion.concl(th1))
            let th2 = Bool.SPECL(rels_prime)(Bool.UNDISCH(th1))
            Bool.GENL(args)(Bool.DISCH(ant)(Bool.UNDISCH(th2)))
      let indthms = Host.map2(mk_ind)(vargs)(defthms)
      let indthmr = end_itlist(Bool.CONJ)(indthms)
      let indthm = Bool.GENL(rels_prime)(Bool.DISCH(closed_prime)(indthmr))
      let mconcs = Host.map2((fun(a): (fun(t): Bool.list_mk_forall([a, Bool.mk_imp([t, prime_fn(t)])]))))(vargs)(ants)
      let monotm = Bool.mk_imp([Fusion.concl(indthmr), Bool.list_mk_conj(mconcs)])
      let monothm = Fusion.ASSUME(Bool.list_mk_forall([rels, Bool.list_mk_forall([rels_prime, monotm])]))
      let closthm = Fusion.ASSUME(closed_prime)
      let monothms = Bool.CONJUNCTS(Bool.MP(Bool.SPEC_ALL(monothm))(Bool.MP(Bool.SPECL(rels_prime)(indthm))(closthm)))
      let closthms = Bool.CONJUNCTS(closthm)
      let prove_rule:
        fun(mth):
          fun([cth, dth]):
            let [avs, bod] = Basics.strip_forall(Fusion.concl(mth))
            let th1 = Bool.IMP_TRANS(Bool.SPECL(avs)(mth))(Bool.SPECL(avs)(cth))
            let th2 = Bool.GENL(rels_prime)(Bool.DISCH(closed_prime)(Bool.UNDISCH(th1)))
            let th3 = Fusion.EQ_MP(Equal.SYM(Bool.SPECL(avs)(dth)))(th2)
            Bool.GENL(avs)(Bool.DISCH(Equal.lhand(bod))(th3))
      let rulethms = Host.map2(prove_rule)(monothms)(zip(closthms)(defthms))
      let rulethm = end_itlist(Bool.CONJ)(rulethms)
      let dtms = Host.map2(curry(Basics.list_mk_abs))(vargs)(ants)
      let double_fn = Basics.subst(zip(dtms)(rels))
      let mk_unbetas:
        fun(tm):
          fun(dtm):
            let [avs, bod] = Basics.strip_forall(tm)
            let [il, r] = Fusion.dest_comb(bod)
            let [i, l] = Fusion.dest_comb(il)
            let bth = RIGHT_BETAS(avs)(Fusion.REFL(dtm))
            let munb = Equal.AP_THM(Equal.AP_TERM(i)(bth))(r)
            let iunb = Equal.AP_TERM(Fusion.mk_comb([i, double_fn(l)]))(bth)
            let junb = Equal.AP_TERM(Fusion.mk_comb([i, r]))(bth)
            let quantify = itlist(Drule.MK_FORALL)(avs)
            [quantify(munb), [quantify(iunb), quantify(junb)]]
      let unths = Host.map2(mk_unbetas)(clauses)(dtms)
      let irthm = Fusion.EQ_MP(Equal.SYM(end_itlist(Drule.MK_CONJ)(map(fst)(unths))))(rulethm)
      let mrthm = Bool.MP(Bool.SPECL(rels)(Bool.SPECL(dtms)(monothm)))(irthm)
      let imrth = Fusion.EQ_MP(Equal.SYM(end_itlist(Drule.MK_CONJ)(map(o(fst)(snd))(unths))))(mrthm)
      let ifthm = Bool.MP(Bool.SPECL(dtms)(indthm))(imrth)
      let fthm = Fusion.EQ_MP(end_itlist(Drule.MK_CONJ)(map(o(snd)(snd))(unths)))(ifthm)
      let mk_case:
        fun(th1):
          fun(th2):
            let avs = fst(Basics.strip_forall(Fusion.concl(th1)))
            Bool.GENL(avs)(Bool.IMP_ANTISYM_RULE(Bool.SPEC_ALL(th1))(Bool.SPEC_ALL(th2)))
      let casethm = end_itlist(Bool.CONJ)(Host.map2(mk_case)(Bool.CONJUNCTS(fthm))(Bool.CONJUNCTS(rulethm)))
      Bool.CONJ(rulethm)(Bool.CONJ(indthm)(casethm))
  fun(tm):
    let clauses = Basics.conjuncts(tm)
    let canonthm = canonicalize_clauses_2(clauses)
    let canonthm_prime = Equal.SYM(canonthm)
    let pclosed = Fusion.rand(Fusion.concl(canonthm))
    let pclauses = Basics.conjuncts(pclosed)
    let rawthm = derive_canon_inductive_relations_2(pclauses)
    let [rulethm, otherthms] = Bool.CONJ_PAIR(rawthm)
    let [indthm, casethm] = Bool.CONJ_PAIR(otherthms)
    let rulethm_prime_2 = Fusion.EQ_MP(canonthm_prime)(rulethm)
    let indthm_prime_2 = Equal.CONV_RULE(Equal.ONCE_DEPTH_CONV(Simp.REWR_CONV(canonthm_prime)))(indthm)
    Bool.CONJ(rulethm_prime_2)(Bool.CONJ(indthm_prime_2)(casethm))

def monotonicity_theorems = Box(PairList.cons(Theorems.MONO_AND, PairList.cons(Theorems.MONO_OR, PairList.cons(Theorems.MONO_IMP, PairList.cons(Theorems.MONO_NOT, PairList.cons(Theorems.MONO_EXISTS, PairList.cons(Theorems.MONO_FORALL, PairList [])))))))

def MONO_TAC:
  let imp_2 = Host.expand_quote("[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]]")
  let IMP_REFL_2 = Itab.ITAUT(Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]]]]"))
  let BACKCHAIN_TAC_2:
    fun(th):
      let match_fn = Drule.PART_MATCH(o(snd)(Basics.dest_imp))(th)
      fun([asl, w]):
        let th1 = match_fn(w)
        let [ant, con] = Basics.dest_imp(Fusion.concl(th1))
        [Tactics.null_meta, PairList.cons([asl, ant], PairList []), (fun(i): (fun(PairList [t, & PairList []]): Drule.MATCH_MP(Drule.INSTANTIATE(i)(th1))(t)))]
  let MONO_ABS_TAC_2:
    fun([asl, w]):
      let [ant, con] = Basics.dest_imp(w)
      let vars = snd(Basics.strip_comb(con))
      let rnum = Host.hol_sub(length(vars))(1)
      let [hd1_2, args1_2] = strip_ncomb(rnum)(ant)
      let [hd2_2, args2_2] = strip_ncomb(rnum)(con)
      let th1_2 = rev_itlist(C(Equal.AP_THM))(args1_2)(Equal.BETA_CONV(hd1_2))
      let th2_2 = rev_itlist(C(Equal.AP_THM))(args1_2)(Equal.BETA_CONV(hd2_2))
      let th3 = Fusion.MK_COMB([Equal.AP_TERM(imp_2)(th1_2), th2_2])
      Tactics.CONV_TAC(Simp.REWR_CONV(th3))([asl, w])
  let APPLY_MONOTAC_2:
    fun(tacs):
      fun([asl, w]):
        let [a_2, c] = Basics.dest_imp(w)
        if Fusion.aconv(a_2)(c)
        | Tactics.ACCEPT_TAC(Bool.SPEC(a_2)(IMP_REFL_2))([asl, w])
        | let cn:
            try:
              fst(Fusion.dest_const(Host.repeat(Fusion.rator)(c)))
              ~catch exn:
                match exn
                | Failure(_): ""
                | exn: Host.hol_raise(exn)
          tryfind((fun([k, t]): (if Host.hol_equal(k)(cn) | t([asl, w]) | Host.hol_apply_unit(fail))))(tacs)
  fun(gl):
    let tacs:
      itlist(
        fun(th):
          fun(l):
            let ft = Host.repeat(Fusion.rator)(Host.funpow(2)(Fusion.rand)(Fusion.concl(th)))
            let c:
              try:
                fst(Fusion.dest_const(ft))
                ~catch exn:
                  match exn
                  | Failure(_): ""
                  | exn: Host.hol_raise(exn)
            PairList.cons([c, Tactics.THEN(BACKCHAIN_TAC_2(th))(Tactics.REPEAT(Tactics.CONJ_TAC))], l))(Host.ref_get(monotonicity_theorems))(PairList.cons(["", MONO_ABS_TAC_2], PairList []))
    let MONO_STEP_TAC = Tactics.THEN(Tactics.REPEAT(Tactics.GEN_TAC))(APPLY_MONOTAC_2(tacs))
    Tactics.THEN(Tactics.REPEAT(MONO_STEP_TAC))(Simp.ASM_REWRITE_TAC(PairList []))(gl)

def prove_monotonicity_hyps:
  let tac = Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.REPEAT(Tactics.GEN_TAC))(Tactics.DISCH_THEN(Tactics.REPEAT_TCL(Tactics.CONJUNCTS_THEN)(Tactics.ASSUME_TAC))))(Tactics.REPEAT(Tactics.CONJ_TAC)))(MONO_TAC)
  let prove_mth = (fun(t): Tactics.prove([t, tac]))
  fun(th):
    let mths = mapfilter(prove_mth)(filter(o(Host.hol_not)(Fusion.is_eq))(Fusion.hyp(th)))
    itlist(Bool.PROVE_HYP)(mths)(th)

def the_inductive_definitions = Box(PairList [])

def [prove_inductive_relations_exist, new_inductive_definition]:
  fun pare_comb(qvs): (fun(tm): (if (Host.hol_equal(Host.intersect(Fusion.frees(tm))(qvs))(PairList []) && forall(Fusion.is_var)(snd(Basics.strip_comb(tm)))) | tm | pare_comb(qvs)(Fusion.rator(tm))))
  let generalize_schematic_variables_2:
    fun(gflag):
      fun(vs):
        let generalize_def:
          fun(tm):
            fun(th):
              let [l, r] = Fusion.dest_eq(tm)
              let [lname, lty] = Fusion.dest_var(l)
              let l_prime = Fusion.mk_var([lname, itlist(o(Fusion.mk_fun_ty)(Fusion.type_of))(vs)(lty)])
              let r_prime = Basics.list_mk_abs([vs, r])
              let tm_prime = Fusion.mk_eq([l_prime, r_prime])
              let th0 = RIGHT_BETAS(vs)(Fusion.ASSUME(tm_prime))
              let th1 = Fusion.INST(PairList.cons([Equal.lhs(Fusion.concl(th0)), l], PairList []))(Bool.DISCH(tm)(th))
              Bool.MP(th1)(th0)
        fun(th):
          let [defs, others] = partition(Fusion.is_eq)(Fusion.hyp(th))
          let th1 = itlist(generalize_def)(defs)(th)
          if gflag
          | let others_prime:
              map(
                fun(t):
                  let fvs = Fusion.frees(t)
                  Bool.SPECL(fvs)(Fusion.ASSUME(Bool.list_mk_forall([fvs, t]))))(others)
            Bool.GENL(vs)(itlist(Bool.PROVE_HYP)(others_prime)(th1))
          | th1
  let derive_existence_2:
    fun(th):
      let defs = filter(Fusion.is_eq)(Fusion.hyp(th))
      itlist(EXISTS_EQUATION)(defs)(th)
  let make_definitions_2:
    fun(th):
      let defs = filter(Fusion.is_eq)(Fusion.hyp(th))
      let dths = map(Drule.new_definition)(defs)
      let insts = zip(map(o(Equal.lhs)(Fusion.concl))(dths))(map(Equal.lhs)(defs))
      rev_itlist(C(Bool.MP))(dths)(Fusion.INST(insts)(itlist(Bool.DISCH)(defs)(th)))
  let unschematize_clauses_2:
    fun(clauses):
      let schem:
        map(
          fun(cls):
            let [avs, bod] = Basics.strip_forall(cls)
            pare_comb(avs)(
              try:
                snd(Basics.dest_imp(bod))
                ~catch exn:
                  match exn
                  | Failure(_): bod
                  | exn: Host.hol_raise(exn)))(clauses)
      let schems = Host.setify(schem)
      if Fusion.is_var(hd(schem))
      | [clauses, PairList []]
      | if Host.hol_not(Host.hol_equal(length(Host.setify(map(o(snd)(Basics.strip_comb))(schems))))(1))
        | failwith("Schematic variables not used consistently")
        | let avoids = Basics.variables(Bool.list_mk_conj(clauses))
          let hack_fn = (fun(tm): Fusion.mk_var([fst(Fusion.dest_var(Host.repeat(Fusion.rator)(tm))), Fusion.type_of(tm)]))
          let grels = Basics.variants(avoids)(map(hack_fn)(schems))
          let crels = zip(grels)(schems)
          let clauses_prime = map(Basics.subst(crels))(clauses)
          [clauses_prime, snd(Basics.strip_comb(hd(schems)))]
  let find_redefinition = (fun(tm): (fun([rth, ith, cth] as trip): [trip, Drule.PART_MATCH(I)(rth)(tm)]))
  let prove_inductive_properties:
    fun(tm):
      let clauses = Basics.conjuncts(tm)
      let [clauses_prime, fvs] = unschematize_clauses_2(clauses)
      let th = derive_nonschematic_inductive_relations(Bool.list_mk_conj(clauses_prime))
      [fvs, prove_monotonicity_hyps(th)]
  let prove_inductive_relations_exist_2:
    fun(tm):
      let [fvs, th1] = prove_inductive_properties(tm)
      let th2 = generalize_schematic_variables_2(#true)(fvs)(th1)
      derive_existence_2(th2)
  let new_inductive_definition_2:
    fun(tm):
      try:
        let tm_prime = snd(Basics.strip_forall(tm))
        let [th, _] = tryfind(find_redefinition(tm_prime))(Host.ref_get(the_inductive_definitions))
        Host.warn(#true)("Benign redefinition of inductive predicate")
        th
        ~catch exn:
          match exn
          | Failure(_):
              let [fvs, th1] = prove_inductive_properties(tm)
              let th2 = generalize_schematic_variables_2(#true)(fvs)(th1)
              let th3 = make_definitions_2(th2)
              let avs = fst(Basics.strip_forall(Fusion.concl(th3)))
              let [r, ic] = Bool.CONJ_PAIR(Bool.SPECL(avs)(th3))
              let [i, c] = Bool.CONJ_PAIR(ic)
              let thtr = [Bool.GENL(avs)(r), Bool.GENL(avs)(i), Bool.GENL(avs)(c)]
              Host.ref_set(the_inductive_definitions)(PairList.cons(thtr, Host.ref_get(the_inductive_definitions)))
              thtr
          | exn: Host.hol_raise(exn)
  [prove_inductive_relations_exist_2, new_inductive_definition_2]

def derive_strong_induction:
  let dest_ibod:
    fun(tm):
      let [avs, ibod] = Basics.strip_forall(tm)
      let n = length(avs)
      let prator = Host.funpow(n)(Fusion.rator)
      let [ant, con] = Basics.dest_imp(ibod)
      [n, [prator(ant), prator(con)]]
  fun prove_triv(tm):
    if Basics.is_conj(tm)
    | Bool.CONJ(prove_triv(Equal.lhand(tm)))(prove_triv(Fusion.rand(tm)))
    | let [avs, bod] = Basics.strip_forall(tm)
      let [a_3, c] = Basics.dest_imp(bod)
      let ths = Bool.CONJUNCTS(Fusion.ASSUME(a_3))
      let th = find(o(Fusion.aconv(c))(Fusion.concl))(ths)
      Bool.GENL(avs)(Bool.DISCH(a_3)(th))
  fun weaken_triv(th):
    if Basics.is_conj(Fusion.concl(th))
    | Bool.CONJ(weaken_triv(Bool.CONJUNCT1(th)))(weaken_triv(Bool.CONJUNCT2(th)))
    | let [avs, bod] = Basics.strip_forall(Fusion.concl(th))
      let th1 = Bool.SPECL(avs)(th)
      let a_4 = fst(Basics.dest_imp(Fusion.concl(th1)))
      Bool.GENL(avs)(Bool.DISCH(a_4)(Bool.CONJUNCT2(Bool.UNDISCH(th1))))
  let MATCH_IMPS = Drule.MATCH_MP(Theorems.MONO_AND)
  fun([rth, ith]):
    let [ovs, ibod] = Basics.strip_forall(Fusion.concl(ith))
    let [iant, icon] = Basics.dest_imp(ibod)
    let [ns, prrs] = unzip(map(dest_ibod)(Basics.conjuncts(icon)))
    let [rs, ps] = unzip(prrs)
    let gs = Basics.variants(Basics.variables(ibod))(ps)
    let [svs, tvs] = Host.chop_list(Host.hol_sub(length(ovs))(length(ns)))(ovs)
    let sth_2 = Bool.SPECL(svs)(rth)
    let jth_2 = Bool.SPECL(svs)(ith)
    let gimps = Basics.subst(zip(gs)(rs))(icon)
    let prs:
      Host.map2(
        fun(n):
          fun([r, p]):
            let [tys, ty] = nsplit(Basics.dest_fun_ty)(Host.hol_range(1)(n))(Fusion.type_of(r))
            let gvs = map(Basics.genvar)(tys)
            Basics.list_mk_abs([gvs, Bool.mk_conj([Basics.list_mk_comb([r, gvs]), Basics.list_mk_comb([p, gvs])])]))(ns)(prrs)
    let modify_rule:
      fun(rcl):
        fun(itm):
          let [avs, bod] = Basics.strip_forall(itm)
          if Basics.is_imp(bod)
          | let [a_5, c] = Basics.dest_imp(bod)
            let mgoal = Bool.mk_imp([gimps, Bool.mk_imp([Fusion.vsubst(zip(gs)(ps))(a_5), a_5])])
            let mth = Fusion.ASSUME(Bool.list_mk_forall([append(gs)(append(ps)(avs)), mgoal]))
            let ith_r = Equal.BETA_RULE(Bool.SPECL(append(prs)(append(rs)(avs)))(mth))
            let jth_r = Bool.MP(ith_r)(prove_triv(Equal.lhand(Fusion.concl(ith_r))))
            let t = Equal.lhand(Fusion.concl(jth_r))
            let kth_r = Bool.UNDISCH(jth_r)
            let ntm = Bool.list_mk_forall([avs, Bool.mk_imp([t, c])])
            let lth_r_2 = Bool.MP(Bool.SPECL(avs)(rcl))(kth_r)
            let lth_p_2 = Bool.UNDISCH(Bool.SPECL(avs)(Fusion.ASSUME(ntm)))
            Bool.DISCH(ntm)(Bool.GENL(avs)(Bool.DISCH(t)(Bool.CONJ(lth_r_2)(lth_p_2))))
          | Bool.DISCH(itm)(Bool.GENL(avs)(Bool.CONJ(Bool.SPECL(avs)(rcl))(Bool.SPECL(avs)(Fusion.ASSUME(itm)))))
    let mimps = Host.map2(modify_rule)(Bool.CONJUNCTS(sth_2))(Basics.conjuncts(iant))
    let th1 = end_itlist((fun(th): (fun(th_prime): MATCH_IMPS(Bool.CONJ(th)(th_prime)))))(mimps)
    let th2 = Equal.BETA_RULE(Bool.SPECL(prs)(jth_2))
    let th3 = Bool.IMP_TRANS(th1)(th2)
    let nasm = Equal.lhand(Fusion.concl(th3))
    let th4 = Bool.GENL(ps)(Bool.DISCH(nasm)(weaken_triv(Bool.UNDISCH(th3))))
    Bool.GENL(svs)(prove_monotonicity_hyps(th4))
