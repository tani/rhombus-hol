def ind_defs_strip_ncomb:«
  (block:«
    fun strip(Interop.Triple3(n,tm,acc)):«
      (block:«
        if Host.hol_lt(n)(1)
        | Pair(tm,acc)
        | (block:«
          let Pair(l,r):«
            Up_fusion.dest_comb(tm)
          »;
          strip(Interop.triple3(Host.hol_sub(n)(1),l,PairList.cons(r,acc)))
        »)
      »)
    »;
    (fun(n):«
      (fun(tm):«
        strip(Interop.triple3(n,tm,PairList []))
      »)
    »)
  »)
»

