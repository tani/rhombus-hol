  let port_tmp_102_IMP_REFL = Itab.ITAUT(Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]]]]"))
  fun port_tmp_105(th):
    let match_fn = Drule.PART_MATCH(o(snd)(Basics.dest_imp))(th)
    fun port_tmp_104([asl, w]):
      let th1 = match_fn(w)
      let [ant, con] = Basics.dest_imp(Fusion.concl(th1))
      [Tactics.null_meta, PairList.cons([asl, ant],PairList []), (fun(i): (fun(PairList [t, & PairList []]): Drule.MATCH_MP(Drule.INSTANTIATE(i)(th1))(t)))]
    port_tmp_104
  let port_tmp_103_BACKCHAIN_TAC = port_tmp_105
  fun port_tmp_117([asl, w]):
    let [ant, con] = Basics.dest_imp(w)
    let vars = snd(Basics.strip_comb(con))
    let rnum = Host.hol_sub(length(vars))(1)
    let [port_tmp_107_hd1, port_tmp_108_args1] = strip_ncomb(rnum)(ant)
    let [port_tmp_109_hd2, port_tmp_110_args2] = strip_ncomb(rnum)(con)
    let port_tmp_112 = Equal.BETA_CONV(port_tmp_107_hd1)
    let port_tmp_113 = C(Equal.AP_THM)
    let port_tmp_111_th1 = rev_itlist(port_tmp_113)(port_tmp_108_args1)(port_tmp_112)
    let port_tmp_115 = Equal.BETA_CONV(port_tmp_109_hd2)
    let port_tmp_116 = C(Equal.AP_THM)
    let port_tmp_114_th2 = rev_itlist(port_tmp_116)(port_tmp_108_args1)(port_tmp_115)
    let th3 = Fusion.MK_COMB([Equal.AP_TERM(port_tmp_101_imp)(port_tmp_111_th1), port_tmp_114_th2])
    Tactics.CONV_TAC(Simp.REWR_CONV(th3))([asl, w])
  let port_tmp_106_MONO_ABS_TAC = port_tmp_117
  fun port_tmp_122(tacs):
    fun port_tmp_121([asl, w]):
      let [port_tmp_119_a, c] = Basics.dest_imp(w)
      if Fusion.aconv(port_tmp_119_a)(c)
      | Tactics.ACCEPT_TAC(Bool.SPEC(port_tmp_119_a)(port_tmp_102_IMP_REFL))([asl, w])
      | let cn:
          try:
            fst(Fusion.dest_const(Host.repeat(Fusion.rator)(c)))
            ~catch port_tmp_120:
              match port_tmp_120
              | Failure(_): ""
              | port_tmp_120: Host.hol_raise(port_tmp_120)
        tryfind((fun([k, t]): (if Host.hol_equal(k)(cn) | t([asl, w]) | Host.hol_apply_unit(fail))))(tacs)
    port_tmp_121
  let port_tmp_118_APPLY_MONOTAC = port_tmp_122
  fun port_tmp_132(gl):
    fun port_tmp_127(th):
      fun port_tmp_126(l):
        let ft = Host.repeat(Fusion.rator)(Host.funpow(2)(Fusion.rand)(Fusion.concl(th)))
        let c:
          try:
            fst(Fusion.dest_const(ft))
            ~catch port_tmp_123:
              match port_tmp_123
              | Failure(_): ""
              | port_tmp_123: Host.hol_raise(port_tmp_123)
        let port_tmp_124 = Tactics.REPEAT(Tactics.CONJ_TAC)
        let port_tmp_125 = port_tmp_103_BACKCHAIN_TAC(th)
        PairList.cons([c, Tactics.THEN(port_tmp_125)(port_tmp_124)],l)
      port_tmp_126
    let tacs = itlist(port_tmp_127)(Host.ref_get(monotonicity_theorems))(PairList.cons(["", port_tmp_106_MONO_ABS_TAC],PairList []))
    let port_tmp_128 = port_tmp_118_APPLY_MONOTAC(tacs)
    let port_tmp_129 = Tactics.REPEAT(Tactics.GEN_TAC)
    let MONO_STEP_TAC = Tactics.THEN(port_tmp_129)(port_tmp_128)
    let port_tmp_130 = Simp.ASM_REWRITE_TAC(PairList [])
    let port_tmp_131 = Tactics.REPEAT(MONO_STEP_TAC)
    Tactics.THEN(port_tmp_131)(port_tmp_130)(gl)
  port_tmp_132

def prove_monotonicity_hyps:
  let port_tmp_135 = Tactics.REPEAT(Tactics.CONJ_TAC)
  let port_tmp_133 = Tactics.DISCH_THEN(Tactics.REPEAT_TCL(Tactics.CONJUNCTS_THEN)(Tactics.ASSUME_TAC))
  let port_tmp_134 = Tactics.REPEAT(Tactics.GEN_TAC)
  let port_tmp_136 = Tactics.THEN(port_tmp_134)(port_tmp_133)
  let tac = Tactics.THEN(Tactics.THEN(port_tmp_136)(port_tmp_135))(MONO_TAC)
  let prove_mth = (fun(t): Tactics.prove([t, tac]))
  fun port_tmp_139(th):
    let port_tmp_137 = Fusion.hyp(th)
    let port_tmp_138 = o(Host.hol_not)(Fusion.is_eq)
    let mths = mapfilter(prove_mth)(filter(port_tmp_138)(port_tmp_137))
    itlist(Bool.PROVE_HYP)(mths)(th)
  port_tmp_139

def the_inductive_definitions = Box(PairList [])

def [prove_inductive_relations_exist, new_inductive_definition]:
  fun pare_comb(qvs): (fun(tm): (if (Host.hol_equal(Host.intersect(Fusion.frees(tm))(qvs))(PairList []) && forall(Fusion.is_var)(snd(Basics.strip_comb(tm)))) | tm | pare_comb(qvs)(Fusion.rator(tm))))
  fun port_tmp_148(gflag):
    fun port_tmp_147(vs):
      fun port_tmp_144(tm):
        fun port_tmp_143(th):
          let [l, r] = Fusion.dest_eq(tm)
          let [lname, lty] = Fusion.dest_var(l)
          let l_prime = Fusion.mk_var([lname, itlist(o(Fusion.mk_fun_ty)(Fusion.type_of))(vs)(lty)])
          let r_prime = Basics.list_mk_abs([vs, r])
          let tm_prime = Fusion.mk_eq([l_prime, r_prime])
          let th0 = RIGHT_BETAS(vs)(Fusion.ASSUME(tm_prime))
          let port_tmp_141 = Bool.DISCH(tm)(th)
          let port_tmp_142 = PairList.cons([Equal.lhs(Fusion.concl(th0)), l],PairList [])
          let th1 = Fusion.INST(port_tmp_142)(port_tmp_141)
          Bool.MP(th1)(th0)
        port_tmp_143
      let generalize_def = port_tmp_144
      fun port_tmp_146(th):
        let [defs, others] = partition(Fusion.is_eq)(Fusion.hyp(th))
        let th1 = itlist(generalize_def)(defs)(th)
        if gflag
        | fun port_tmp_145(t):
            let fvs = Fusion.frees(t)
            Bool.SPECL(fvs)(Fusion.ASSUME(Bool.list_mk_forall([fvs, t])))
          let others_prime = map(port_tmp_145)(others)
          Bool.GENL(vs)(itlist(Bool.PROVE_HYP)(others_prime)(th1))
        | th1
      port_tmp_146
    port_tmp_147
  let port_tmp_140_generalize_schematic_variables = port_tmp_148
  fun port_tmp_150(th):
    let defs = filter(Fusion.is_eq)(Fusion.hyp(th))
    itlist(EXISTS_EQUATION)(defs)(th)
  let port_tmp_149_derive_existence = port_tmp_150
  fun port_tmp_156(th):
    let defs = filter(Fusion.is_eq)(Fusion.hyp(th))
    let dths = map(Drule.new_definition)(defs)
    let port_tmp_152 = map(Equal.lhs)(defs)
    let port_tmp_153 = map(o(Equal.lhs)(Fusion.concl))(dths)
    let insts = zip(port_tmp_153)(port_tmp_152)
    let port_tmp_154 = Fusion.INST(insts)(itlist(Bool.DISCH)(defs)(th))
    let port_tmp_155 = C(Bool.MP)
    rev_itlist(port_tmp_155)(dths)(port_tmp_154)
  let port_tmp_151_make_definitions = port_tmp_156
  fun port_tmp_164(clauses):
    fun port_tmp_160(cls):
      let [avs, bod] = Basics.strip_forall(cls)
      let port_tmp_159:
        try:
          snd(Basics.dest_imp(bod))
          ~catch port_tmp_158:
            match port_tmp_158
            | Failure(_): bod
            | port_tmp_158: Host.hol_raise(port_tmp_158)
      pare_comb(avs)(port_tmp_159)
    let schem = map(port_tmp_160)(clauses)
    let schems = Host.setify(schem)
    if Fusion.is_var(hd(schem))
    | [clauses, PairList []]
    | if Host.hol_not(Host.hol_equal(length(Host.setify(map(o(snd)(Basics.strip_comb))(schems))))(1))
      | failwith("Schematic variables not used consistently")
      | let avoids = Basics.variables(Bool.list_mk_conj(clauses))
        fun port_tmp_163(tm):
          let port_tmp_161 = Fusion.type_of(tm)
          let port_tmp_162 = fst(Fusion.dest_var(Host.repeat(Fusion.rator)(tm)))
          Fusion.mk_var([port_tmp_162, port_tmp_161])
        let hack_fn = port_tmp_163
        let grels = Basics.variants(avoids)(map(hack_fn)(schems))
        let crels = zip(grels)(schems)
        let clauses_prime = map(Basics.subst(crels))(clauses)
        [clauses_prime, snd(Basics.strip_comb(hd(schems)))]
  let port_tmp_157_unschematize_clauses = port_tmp_164
  let find_redefinition = (fun(tm): (fun([rth, ith, cth] as trip): [trip, Drule.PART_MATCH(I)(rth)(tm)]))
  fun port_tmp_165(tm):
    let clauses = Basics.conjuncts(tm)
    let [clauses_prime, fvs] = port_tmp_157_unschematize_clauses(clauses)
    let th = derive_nonschematic_inductive_relations(Bool.list_mk_conj(clauses_prime))
    [fvs, prove_monotonicity_hyps(th)]
  let prove_inductive_properties = port_tmp_165
  fun port_tmp_167(tm):
    let [fvs, th1] = prove_inductive_properties(tm)
    let th2 = port_tmp_140_generalize_schematic_variables(#true)(fvs)(th1)
    port_tmp_149_derive_existence(th2)
  let port_tmp_166_prove_inductive_relations_exist = port_tmp_167
  fun port_tmp_175(tm):
    try:
      let tm_prime = snd(Basics.strip_forall(tm))
      let port_tmp_170 = Host.ref_get(the_inductive_definitions)
      let port_tmp_171 = find_redefinition(tm_prime)
      let [th, _] = tryfind(port_tmp_171)(port_tmp_170)
      Host.warn(#true)("Benign redefinition of inductive predicate")
      th
      ~catch port_tmp_169:
        match port_tmp_169
        | Failure(_):
            let [fvs, th1] = prove_inductive_properties(tm)
            let th2 = port_tmp_140_generalize_schematic_variables(#true)(fvs)(th1)
            let th3 = port_tmp_151_make_definitions(th2)
            let avs = fst(Basics.strip_forall(Fusion.concl(th3)))
            let [r, ic] = Bool.CONJ_PAIR(Bool.SPECL(avs)(th3))
            let [i, c] = Bool.CONJ_PAIR(ic)
            let port_tmp_172 = Bool.GENL(avs)(c)
            let port_tmp_173 = Bool.GENL(avs)(i)
            let port_tmp_174 = Bool.GENL(avs)(r)
            let thtr = [port_tmp_174, port_tmp_173, port_tmp_172]
            Host.ref_set(the_inductive_definitions)(PairList.cons(thtr,Host.ref_get(the_inductive_definitions)))
            thtr
        | port_tmp_169: Host.hol_raise(port_tmp_169)
  let port_tmp_168_new_inductive_definition = port_tmp_175
  [port_tmp_166_prove_inductive_relations_exist, port_tmp_168_new_inductive_definition]

def derive_strong_induction:
  fun port_tmp_178(tm):
    let [avs, ibod] = Basics.strip_forall(tm)
    let n = length(avs)
    let prator = Host.funpow(n)(Fusion.rator)
    let [ant, con] = Basics.dest_imp(ibod)
    let port_tmp_176 = prator(con)
    let port_tmp_177 = prator(ant)
    [n, [port_tmp_177, port_tmp_176]]
  let dest_ibod = port_tmp_178
  fun prove_triv(tm):
    if Basics.is_conj(tm)
    | let port_tmp_179 = prove_triv(Fusion.rand(tm))
      let port_tmp_180 = prove_triv(Equal.lhand(tm))
      Bool.CONJ(port_tmp_180)(port_tmp_179)
    | let [avs, bod] = Basics.strip_forall(tm)
      let [port_tmp_181_a, c] = Basics.dest_imp(bod)
      let ths = Bool.CONJUNCTS(Fusion.ASSUME(port_tmp_181_a))
      let th = find(o(Fusion.aconv(c))(Fusion.concl))(ths)
      Bool.GENL(avs)(Bool.DISCH(port_tmp_181_a)(th))
  fun weaken_triv(th):
    if Basics.is_conj(Fusion.concl(th))
    | let port_tmp_182 = weaken_triv(Bool.CONJUNCT2(th))
      let port_tmp_183 = weaken_triv(Bool.CONJUNCT1(th))
      Bool.CONJ(port_tmp_183)(port_tmp_182)
    | let [avs, bod] = Basics.strip_forall(Fusion.concl(th))
      let th1 = Bool.SPECL(avs)(th)
      let port_tmp_184_a = fst(Basics.dest_imp(Fusion.concl(th1)))
      Bool.GENL(avs)(Bool.DISCH(port_tmp_184_a)(Bool.CONJUNCT2(Bool.UNDISCH(th1))))
  let MATCH_IMPS = Drule.MATCH_MP(Theorems.MONO_AND)
  fun port_tmp_204([rth, ith]):
    let [ovs, ibod] = Basics.strip_forall(Fusion.concl(ith))
    let [iant, icon] = Basics.dest_imp(ibod)
    let [ns, prrs] = unzip(map(dest_ibod)(Basics.conjuncts(icon)))
    let [rs, ps] = unzip(prrs)
    let gs = Basics.variants(Basics.variables(ibod))(ps)
    let port_tmp_185 = length(ns)
    let port_tmp_186 = length(ovs)
    let [svs, tvs] = Host.chop_list(Host.hol_sub(port_tmp_186)(port_tmp_185))(ovs)
    let port_tmp_187_sth = Bool.SPECL(svs)(rth)
    let port_tmp_188_jth = Bool.SPECL(svs)(ith)
    let gimps = Basics.subst(zip(gs)(rs))(icon)
    fun port_tmp_194(n):
      fun port_tmp_193([r, p]):
        let port_tmp_189 = Fusion.type_of(r)
        let port_tmp_190 = Host.hol_range(1)(n)
        let [tys, ty] = nsplit(Basics.dest_fun_ty)(port_tmp_190)(port_tmp_189)
        let gvs = map(Basics.genvar)(tys)
        let port_tmp_191 = Basics.list_mk_comb([p, gvs])
        let port_tmp_192 = Basics.list_mk_comb([r, gvs])
        Basics.list_mk_abs([gvs, Bool.mk_conj([port_tmp_192, port_tmp_191])])
      port_tmp_193
    let prs = Host.map2(port_tmp_194)(ns)(prrs)
    fun port_tmp_201(rcl):
      fun port_tmp_200(itm):
        let [avs, bod] = Basics.strip_forall(itm)
        if Basics.is_imp(bod)
        | let [port_tmp_195_a, c] = Basics.dest_imp(bod)
          let mgoal = Bool.mk_imp([gimps, Bool.mk_imp([Fusion.vsubst(zip(gs)(ps))(port_tmp_195_a), port_tmp_195_a])])
          let mth = Fusion.ASSUME(Bool.list_mk_forall([append(gs)(append(ps)(avs)), mgoal]))
          let ith_r = Equal.BETA_RULE(Bool.SPECL(append(prs)(append(rs)(avs)))(mth))
          let jth_r = Bool.MP(ith_r)(prove_triv(Equal.lhand(Fusion.concl(ith_r))))
          let t = Equal.lhand(Fusion.concl(jth_r))
          let kth_r = Bool.UNDISCH(jth_r)
          let ntm = Bool.list_mk_forall([avs, Bool.mk_imp([t, c])])
          let port_tmp_196_lth_r = Bool.MP(Bool.SPECL(avs)(rcl))(kth_r)
          let port_tmp_197_lth_p = Bool.UNDISCH(Bool.SPECL(avs)(Fusion.ASSUME(ntm)))
          Bool.DISCH(ntm)(Bool.GENL(avs)(Bool.DISCH(t)(Bool.CONJ(port_tmp_196_lth_r)(port_tmp_197_lth_p))))
        | let port_tmp_198 = Bool.SPECL(avs)(Fusion.ASSUME(itm))
          let port_tmp_199 = Bool.SPECL(avs)(rcl)
          Bool.DISCH(itm)(Bool.GENL(avs)(Bool.CONJ(port_tmp_199)(port_tmp_198)))
      port_tmp_200
    let modify_rule = port_tmp_201
    let port_tmp_202 = Basics.conjuncts(iant)
    let port_tmp_203 = Bool.CONJUNCTS(port_tmp_187_sth)
    let mimps = Host.map2(modify_rule)(port_tmp_203)(port_tmp_202)
    let th1 = end_itlist((fun(th): (fun(th_prime): MATCH_IMPS(Bool.CONJ(th)(th_prime)))))(mimps)
    let th2 = Equal.BETA_RULE(Bool.SPECL(prs)(port_tmp_188_jth))
    let th3 = Bool.IMP_TRANS(th1)(th2)
    let nasm = Equal.lhand(Fusion.concl(th3))
    let th4 = Bool.GENL(ps)(Bool.DISCH(nasm)(weaken_triv(Bool.UNDISCH(th3))))
    Bool.GENL(svs)(prove_monotonicity_hyps(th4))
  port_tmp_204
