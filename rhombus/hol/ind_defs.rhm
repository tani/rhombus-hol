def strip_ncomb:
  fun strip([n, tm, acc]):
    if (n < 1)
    | [tm, acc]
    | let [l, r] = dest_comb(tm)
      strip([(n - 1), l, PairList [r, & acc]])
  fun(n): fun(tm): strip([n, tm, PairList []])

def RIGHT_BETAS = rev_itlist((fun(a): o(CONV_RULE(RAND_CONV(BETA_CONV)))(C(AP_THM)(a))))

def EXISTS_EQUATION:
  let pth:
    prove(
      [
        (hol:
           const #{?} :: (A -> bool) -> bool
           forall (P :: A -> bool, t :: A): (forall x :: A: x == t ==> P(x)) ==> #{?}(P)),
        (
          (
            (
              (
                (
                  (REWRITE_TAC(PairList [EXISTS_DEF]) then_tac BETA_TAC) then_tac \
                  REPEAT(STRIP_TAC)
                ) then_tac \
                FIRST_ASSUM(MATCH_MP_TAC)
              ) then_tac \
              EXISTS_TAC(hol: var t :: A; t)
            ) then_tac \
            FIRST_ASSUM(MATCH_MP_TAC)
          ) then_tac \
          REFL_TAC
        )
      ]
    )
  fun(tm):
    fun(th):
      let [l, r] = dest_eq(tm)
      let P = mk_abs([l, concl(th)])
      let th1 = BETA_CONV(mk_comb([P, l]))
      let th2 = ISPECL(PairList [P, r])(pth)
      let th3 = EQ_MP(SYM(th1))(th)
      let th4 = GEN(l)(DISCH(tm)(th3))
      MP(th2)(th4)

def derive_nonschematic_inductive_relations:
  let getconcl_2:
    fun(tm):
      let bod = repeat(o(snd)(dest_forall))(tm)
      try:
        snd(dest_imp(bod))
        ~catch exn:
          match exn
          | Failure(_): bod
          | exn: (throw exn)
  let CONJ_ACI_RULE_2 = AC(CONJ_ACI)
  let SIMPLE_DISJ_PAIR_2:
    fun(th):
      let [l, r] = dest_disj(hd(hyp(th)))
      [
        PROVE_HYP(DISJ1(ASSUME(l))(r))(th),
        PROVE_HYP(DISJ2(l)(ASSUME(r)))(th)
      ]
  let HALF_BETA_EXPAND_2 = fun(args): fun(th): GENL(args)(RIGHT_BETAS(args)(th))
  let AND_IMPS_CONV:
    fun(tm):
      let ths = CONJUNCTS(ASSUME(tm))
      let avs = fst(strip_forall(concl(hd(ths))))
      let thl = map(o(o(DISCH(tm))(UNDISCH))(SPEC_ALL))(ths)
      let th1 = end_itlist(SIMPLE_DISJ_CASES)(thl)
      let tm1 = hd(hyp(th1))
      let th2 = GENL(avs)(DISCH(tm1)(UNDISCH(th1)))
      let tm2 = concl(th2)
      let th3 = DISCH(tm2)(UNDISCH(SPEC_ALL(ASSUME(tm2))))
      let [thts, tht] = nsplit(SIMPLE_DISJ_PAIR_2)(tl(ths))(th3)
      let proc_fn:
        fun(th):
          let t = hd(hyp(th))
          GENL(avs)(DISCH(t)(UNDISCH(th)))
      let th4 = itlist(o(CONJ)(proc_fn))(thts)(proc_fn(tht))
      IMP_ANTISYM_RULE(DISCH_ALL(th2))(DISCH_ALL(th4))
  let t_tm = hol:
    #true
  fun getequs([avs, plis]):
    if (plis == (PairList []))
    | PairList []
    | let PairList [h, & t] = plis
      let r = snd(h)
      (if mem(r)(avs) | PairList [h, & getequs([avs, filter(o((fun (y): r != y))(snd))(t)])] | getequs([avs, t]))
  let calculate_simp_sequence_2:
    fun(avs):
      fun(plis):
        let oks = getequs([avs, plis])
        [oks, subtract(plis)(oks)]
  let FORALL_IMPS_CONV_2:
    fun(tm):
      let [avs, bod] = strip_forall(tm)
      let th1 = DISCH(tm)(UNDISCH(SPEC_ALL(ASSUME(tm))))
      let th2 = itlist(SIMPLE_CHOOSE)(avs)(th1)
      let tm2 = hd(hyp(th2))
      let th3 = DISCH(tm2)(UNDISCH(th2))
      let th4 = ASSUME(concl(th3))
      let ant = lhand(bod)
      let th5 = itlist(SIMPLE_EXISTS)(avs)(ASSUME(ant))
      let th6 = GENL(avs)(DISCH(ant)(MP(th4)(th5)))
      IMP_ANTISYM_RULE(DISCH_ALL(th3))(DISCH_ALL(th6))
  let canonicalize_clause:
    fun(cls):
      fun(args):
        let [avs, bimp] = strip_forall(cls)
        let [ant, con]:
          try:
            dest_imp(bimp)
            ~catch exn:
              match exn
              | Failure(_): [t_tm, bimp]
              | exn: (throw exn)
        let [rel, xargs] = strip_comb(con)
        let plis = zip(args)(xargs)
        let [yes, no] = calculate_simp_sequence_2(avs)(plis)
        let nvs = filter(o((fun (x): !x))(C(mem)(map(snd)(yes))))(avs)
        let eth:
          if is_imp(bimp)
          | let atm = itlist(o(curry(mk_conj))(mk_eq))(append(yes)(no))(ant)
            let [ths, tth] = nsplit(CONJ_PAIR)(plis)(ASSUME(atm))
            let thl = map((fun(t): find((fun(th): (lhs(concl(th)) == t)))(ths)))(args)
            let th0 = MP(SPECL(avs)(ASSUME(cls)))(tth)
            let th1 = rev_itlist(C(curry(MK_COMB)))(thl)(REFL(rel))
            let th2 = EQ_MP(SYM(th1))(th0)
            let th3 = INST(yes)(DISCH(atm)(th2))
            let tm4 = funpow(length(yes))(rand)(lhand(concl(th3)))
            let th4 = itlist(o(o(CONJ)(REFL))(fst))(yes)(ASSUME(tm4))
            let th5 = GENL(args)(GENL(nvs)(DISCH(tm4)(MP(th3)(th4))))
            let th6 = SPECL(nvs)(SPECL(map(snd)(plis))(ASSUME(concl(th5))))
            let th7 = itlist(o(o(CONJ)(REFL))(snd))(no)(ASSUME(ant))
            let th8 = GENL(avs)(DISCH(ant)(MP(th6)(th7)))
            IMP_ANTISYM_RULE(DISCH_ALL(th5))(DISCH_ALL(th8))
          | let atm = list_mk_conj(map(mk_eq)(append(yes)(no)))
            let ths = CONJUNCTS(ASSUME(atm))
            let thl = map((fun(t): find((fun(th): (lhs(concl(th)) == t)))(ths)))(args)
            let th0 = SPECL(avs)(ASSUME(cls))
            let th1 = rev_itlist(C(curry(MK_COMB)))(thl)(REFL(rel))
            let th2 = EQ_MP(SYM(th1))(th0)
            let th3 = INST(yes)(DISCH(atm)(th2))
            let tm4 = funpow(length(yes))(rand)(lhand(concl(th3)))
            let th4 = itlist(o(o(CONJ)(REFL))(fst))(yes)(ASSUME(tm4))
            let th5 = GENL(args)(GENL(nvs)(DISCH(tm4)(MP(th3)(th4))))
            let th6 = SPECL(nvs)(SPECL(map(snd)(plis))(ASSUME(concl(th5))))
            let th7 = end_itlist(CONJ)(map(o(REFL)(snd))(no))
            let th8 = GENL(avs)(MP(th6)(th7))
            IMP_ANTISYM_RULE(DISCH_ALL(th5))(DISCH_ALL(th8))
        let ftm = funpow(length(args))(o(body)(rand))(rand(concl(eth)))
        TRANS(eth)(itlist(MK_FORALL)(args)(FORALL_IMPS_CONV_2(ftm)))
  let canonicalize_clauses_2:
    fun(clauses):
      let concls = map(getconcl_2)(clauses)
      let uncs = map(strip_comb)(concls)
      let rels = itlist(o(insert)(fst))(uncs)(PairList [])
      let xargs = map(C(assoc)(uncs))(rels)
      let closed = list_mk_conj(clauses)
      let avoids = variables(closed)
      let flargs = make_args("a")(avoids)(map(type_of)(end_itlist(append)(xargs)))
      let zargs = zip(rels)(shareout(xargs)(flargs))
      let cargs = map((fun([r, a]): assoc(r)(zargs)))(uncs)
      let cthms = map2(canonicalize_clause)(clauses)(cargs)
      let pclauses = map(o(rand)(concl))(cthms)
      let collectclauses = (fun(tm): mapfilter((fun(t): (if (fst(t) == tm) | snd(t) | fail())))(zip(map(fst)(uncs))(pclauses)))
      let clausell = map(collectclauses)(rels)
      let cclausel = map(list_mk_conj)(clausell)
      let cclauses_2 = list_mk_conj(cclausel)
      let oclauses_2 = list_mk_conj(pclauses)
      let eth = CONJ_ACI_RULE_2(mk_eq([oclauses_2, cclauses_2]))
      let pth = TRANS(end_itlist(MK_CONJ)(cthms))(eth)
      TRANS(pth)(end_itlist(MK_CONJ)(map(AND_IMPS_CONV)(cclausel)))
  let derive_canon_inductive_relations_2:
    fun(clauses):
      let closed = list_mk_conj(clauses)
      let clauses = conjuncts(closed)
      let [vargs, bodies] = unzip(map(strip_forall)(clauses))
      let [ants, concs] = unzip(map(dest_imp)(bodies))
      let rels = map(repeat(rator))(concs)
      let avoids = variables(closed)
      let rels_prime = variants(avoids)(rels)
      let crels = zip(rels_prime)(rels)
      let prime_fn = subst(crels)
      let closed_prime = prime_fn(closed)
      let mk_def:
        fun(arg):
          fun(con):
            mk_eq(
              [
                repeat(rator)(con),
                list_mk_abs([arg, list_mk_forall([rels_prime, mk_imp([closed_prime, prime_fn(con)])])])
              ]
            )
      let deftms = map2(mk_def)(vargs)(concs)
      let defthms = map2(HALF_BETA_EXPAND_2)(vargs)(map(ASSUME)(deftms))
      let mk_ind:
        fun(args):
          fun(th):
            let th1 = fst(EQ_IMP_RULE(SPEC_ALL(th)))
            let ant = lhand(concl(th1))
            let th2 = SPECL(rels_prime)(UNDISCH(th1))
            GENL(args)(DISCH(ant)(UNDISCH(th2)))
      let indthms = map2(mk_ind)(vargs)(defthms)
      let indthmr = end_itlist(CONJ)(indthms)
      let indthm = GENL(rels_prime)(DISCH(closed_prime)(indthmr))
      let mconcs = map2(fun(a): fun(t): list_mk_forall([a, mk_imp([t, prime_fn(t)])]))(vargs)(ants)
      let monotm = mk_imp([concl(indthmr), list_mk_conj(mconcs)])
      let monothm = ASSUME(list_mk_forall([rels, list_mk_forall([rels_prime, monotm])]))
      let closthm = ASSUME(closed_prime)
      let monothms = CONJUNCTS(MP(SPEC_ALL(monothm))(MP(SPECL(rels_prime)(indthm))(closthm)))
      let closthms = CONJUNCTS(closthm)
      let prove_rule:
        fun(mth):
          fun([cth, dth]):
            let [avs, bod] = strip_forall(concl(mth))
            let th1 = IMP_TRANS(SPECL(avs)(mth))(SPECL(avs)(cth))
            let th2 = GENL(rels_prime)(DISCH(closed_prime)(UNDISCH(th1)))
            let th3 = EQ_MP(SYM(SPECL(avs)(dth)))(th2)
            GENL(avs)(DISCH(lhand(bod))(th3))
      let rulethms = map2(prove_rule)(monothms)(zip(closthms)(defthms))
      let rulethm = end_itlist(CONJ)(rulethms)
      let dtms = map2(curry(list_mk_abs))(vargs)(ants)
      let double_fn = subst(zip(dtms)(rels))
      let mk_unbetas:
        fun(tm):
          fun(dtm):
            let [avs, bod] = strip_forall(tm)
            let [il, r] = dest_comb(bod)
            let [i, l] = dest_comb(il)
            let bth = RIGHT_BETAS(avs)(REFL(dtm))
            let munb = AP_THM(AP_TERM(i)(bth))(r)
            let iunb = AP_TERM(mk_comb([i, double_fn(l)]))(bth)
            let junb = AP_TERM(mk_comb([i, r]))(bth)
            let quantify = itlist(MK_FORALL)(avs)
            [quantify(munb), [quantify(iunb), quantify(junb)]]
      let unths = map2(mk_unbetas)(clauses)(dtms)
      let irthm = EQ_MP(SYM(end_itlist(MK_CONJ)(map(fst)(unths))))(rulethm)
      let mrthm = MP(SPECL(rels)(SPECL(dtms)(monothm)))(irthm)
      let imrth = EQ_MP(SYM(end_itlist(MK_CONJ)(map(o(fst)(snd))(unths))))(mrthm)
      let ifthm = MP(SPECL(dtms)(indthm))(imrth)
      let fthm = EQ_MP(end_itlist(MK_CONJ)(map(o(snd)(snd))(unths)))(ifthm)
      let mk_case:
        fun(th1):
          fun(th2):
            let avs = fst(strip_forall(concl(th1)))
            GENL(avs)(IMP_ANTISYM_RULE(SPEC_ALL(th1))(SPEC_ALL(th2)))
      let casethm = end_itlist(CONJ)(map2(mk_case)(CONJUNCTS(fthm))(CONJUNCTS(rulethm)))
      CONJ(rulethm)(CONJ(indthm)(casethm))
  fun(tm):
    let clauses = conjuncts(tm)
    let canonthm = canonicalize_clauses_2(clauses)
    let canonthm_prime = SYM(canonthm)
    let pclosed = rand(concl(canonthm))
    let pclauses = conjuncts(pclosed)
    let rawthm = derive_canon_inductive_relations_2(pclauses)
    let [rulethm, otherthms] = CONJ_PAIR(rawthm)
    let [indthm, casethm] = CONJ_PAIR(otherthms)
    let rulethm_prime_2 = EQ_MP(canonthm_prime)(rulethm)
    let indthm_prime_2 = CONV_RULE(ONCE_DEPTH_CONV(REWR_CONV(canonthm_prime)))(indthm)
    CONJ(rulethm_prime_2)(CONJ(indthm_prime_2)(casethm))

def monotonicity_theorems:
  Box(
    PairList [
      MONO_AND,
      MONO_OR,
      MONO_IMP,
      MONO_NOT,
      MONO_EXISTS,
      MONO_FORALL
    ]
  )

def MONO_TAC:
  let imp_2 = hol: const #{==>} :: bool -> bool -> bool; const.#{==>}
  let IMP_REFL_2 = ITAUT(hol:
                           forall p :: bool: p ==> p)
  let BACKCHAIN_TAC_2:
    fun(th):
      fun([asl, w]):
        let match_fn = PART_MATCH(o(snd)(dest_imp))(th)
        let th1 = match_fn(w)
        let [ant, con] = dest_imp(concl(th1))
        [
          null_meta,
          PairList [[asl, ant]],
          fun(i): fun(PairList [t, & PairList []]): MATCH_MP(INSTANTIATE(i)(th1))(t)
        ]

  let MONO_ABS_TAC_2:
    fun([asl, w]):
      let [ant, con] = dest_imp(w)
      let vars = snd(strip_comb(con))
      let rnum = (length(vars) - 1)
      let [hd1_2, args1_2] = strip_ncomb(rnum)(ant)
      let [hd2_2, args2_2] = strip_ncomb(rnum)(con)
      let th1_2 = rev_itlist(C(AP_THM))(args1_2)(BETA_CONV(hd1_2))
      let th2_2 = rev_itlist(C(AP_THM))(args1_2)(BETA_CONV(hd2_2))
      let th3 = MK_COMB([AP_TERM(imp_2)(th1_2), th2_2])
      CONV_TAC(REWR_CONV(th3))([asl, w])
  let APPLY_MONOTAC_2:
    fun(tacs):
      fun([asl, w]):
        let [a_2, c] = dest_imp(w)
        if aconv(a_2)(c)
        | ACCEPT_TAC(SPEC(a_2)(IMP_REFL_2))([asl, w])
        | let cn:
            try:
              fst(dest_const(repeat(rator)(c)))
              ~catch exn:
                match exn
                | Failure(_): ""
                | exn: (throw exn)
          tryfind((fun([k, t]): (if (k == cn) | t([asl, w]) | fail())))(tacs)
  fun(gl):
    let tacs:
      itlist(
        fun(th):
          fun(l):
            let ft = repeat(rator)(funpow(2)(rand)(concl(th)))
            let c:
              try:
                fst(dest_const(ft))
                ~catch exn:
                  match exn
                  | Failure(_): ""
                  | exn: (throw exn)
            PairList [[c, (BACKCHAIN_TAC_2(th) then_tac REPEAT(CONJ_TAC))], & l]
      )(monotonicity_theorems.value)(PairList [["", MONO_ABS_TAC_2]])
    let MONO_STEP_TAC = (REPEAT(GEN_TAC) then_tac APPLY_MONOTAC_2(tacs))
    (REPEAT(MONO_STEP_TAC) then_tac ASM_REWRITE_TAC(PairList []))(gl)

def prove_monotonicity_hyps:
  let tac:
    (
      (
        (
          REPEAT(GEN_TAC) then_tac \
          DISCH_THEN(REPEAT_TCL(CONJUNCTS_THEN)(ASSUME_TAC))
        ) then_tac \
        REPEAT(CONJ_TAC)
      ) then_tac \
      MONO_TAC
    )
  let prove_mth = (fun(t): prove([t, tac]))
  fun(th):
    let mths = mapfilter(prove_mth)(filter(o((fun (x): !x))(is_eq))(hyp(th)))
    itlist(PROVE_HYP)(mths)(th)

def the_inductive_definitions = Box(PairList [])

def [ind_defs_prove_inductive_relations_exist_v2, new_inductive_definition]:
  // Recursive decomposition needs the local definition before its first use.
  fun pare_comb(qvs): fun(tm): (if ((intersect(frees(tm))(qvs) == (PairList [])) && forall(is_var)(snd(strip_comb(tm)))) | tm | pare_comb(qvs)(rator(tm)))
  let generalize_schematic_variables_2:
    fun(gflag):
      fun(vs):
        fun(th):
          let generalize_def:
            fun(tm):
              fun(th):
                let [l, r] = dest_eq(tm)
                let [lname, lty] = dest_var(l)
                let l_prime = mk_var([lname, itlist(o(mk_fun_ty)(type_of))(vs)(lty)])
                let r_prime = list_mk_abs([vs, r])
                let tm_prime = mk_eq([l_prime, r_prime])
                let th0 = RIGHT_BETAS(vs)(ASSUME(tm_prime))
                let th1 = INST(PairList [[lhs(concl(th0)), l]])(DISCH(tm)(th))
                MP(th1)(th0)
          let [defs, others] = partition(is_eq)(hyp(th))
          let th1 = itlist(generalize_def)(defs)(th)
          if gflag
          | let others_prime:
              map(
                fun(t):
                  let fvs = frees(t)
                  SPECL(fvs)(ASSUME(list_mk_forall([fvs, t])))
              )(others)
            GENL(vs)(itlist(PROVE_HYP)(others_prime)(th1))
          | th1

  let derive_existence_2:
    fun(th):
      let defs = filter(is_eq)(hyp(th))
      itlist(EXISTS_EQUATION)(defs)(th)
  let make_definitions_2:
    fun(th):
      let defs = filter(is_eq)(hyp(th))
      let dths = map(new_definition)(defs)
      let insts = zip(map(o(lhs)(concl))(dths))(map(lhs)(defs))
      rev_itlist(C(MP))(dths)(INST(insts)(itlist(DISCH)(defs)(th)))
  let unschematize_clauses_2:
    fun(clauses):
      let schem:
        map(
          fun(cls):
            let [avs, bod] = strip_forall(cls)
            pare_comb(avs)(
              try:
                snd(dest_imp(bod))
                ~catch exn:
                  match exn
                  | Failure(_): bod
                  | exn: (throw exn)
            )
        )(clauses)
      let schems = setify(schem)
      if is_var(hd(schem))
      | [clauses, PairList []]
      | if !(length(setify(map(o(snd)(strip_comb))(schems))) == 1)
        | failwith("Schematic variables not used consistently")
        | let avoids = variables(list_mk_conj(clauses))
          let hack_fn = (fun(tm): mk_var([fst(dest_var(repeat(rator)(tm))), type_of(tm)]))
          let grels = variants(avoids)(map(hack_fn)(schems))
          let crels = zip(grels)(schems)
          let clauses_prime = map(subst(crels))(clauses)
          [clauses_prime, snd(strip_comb(hd(schems)))]
  let find_redefinition = fun(tm): fun([rth, ith, cth] as trip): [trip, PART_MATCH(I)(rth)(tm)]
  let prove_inductive_properties:
    fun(tm):
      let clauses = conjuncts(tm)
      let [clauses_prime, fvs] = unschematize_clauses_2(clauses)
      let th = derive_nonschematic_inductive_relations(list_mk_conj(clauses_prime))
      [fvs, prove_monotonicity_hyps(th)]
  let prove_inductive_relations_exist_2:
    fun(tm):
      let [fvs, th1] = prove_inductive_properties(tm)
      let th2 = generalize_schematic_variables_2(#true)(fvs)(th1)
      derive_existence_2(th2)
  let new_inductive_definition_2:
    fun(tm):
      try:
        let tm_prime = snd(strip_forall(tm))
        let [th, _] = tryfind(find_redefinition(tm_prime))(the_inductive_definitions.value)
        warn(#true)("Benign redefinition of inductive predicate")
        th
        ~catch exn:
          match exn
          | Failure(_):
              let [fvs, th1] = prove_inductive_properties(tm)
              let th2 = generalize_schematic_variables_2(#true)(fvs)(th1)
              let th3 = make_definitions_2(th2)
              let avs = fst(strip_forall(concl(th3)))
              let [r, ic] = CONJ_PAIR(SPECL(avs)(th3))
              let [i, c] = CONJ_PAIR(ic)
              let thtr = [GENL(avs)(r), GENL(avs)(i), GENL(avs)(c)]
              the_inductive_definitions.value := PairList [thtr, & the_inductive_definitions.value]
              thtr
          | exn: (throw exn)
  [prove_inductive_relations_exist_2, new_inductive_definition_2]

def derive_strong_induction:
  let dest_ibod:
    fun(tm):
      let [avs, ibod] = strip_forall(tm)
      let n = length(avs)
      let prator = funpow(n)(rator)
      let [ant, con] = dest_imp(ibod)
      [n, [prator(ant), prator(con)]]
  fun prove_triv(tm):
    if is_conj(tm)
    | CONJ(prove_triv(lhand(tm)))(prove_triv(rand(tm)))
    | let [avs, bod] = strip_forall(tm)
      let [a_3, c] = dest_imp(bod)
      let ths = CONJUNCTS(ASSUME(a_3))
      let th = find(o(aconv(c))(concl))(ths)
      GENL(avs)(DISCH(a_3)(th))
  fun weaken_triv(th):
    if is_conj(concl(th))
    | CONJ(weaken_triv(CONJUNCT1(th)))(weaken_triv(CONJUNCT2(th)))
    | let [avs, bod] = strip_forall(concl(th))
      let th1 = SPECL(avs)(th)
      let a_4 = fst(dest_imp(concl(th1)))
      GENL(avs)(DISCH(a_4)(CONJUNCT2(UNDISCH(th1))))
  let MATCH_IMPS = MATCH_MP(MONO_AND)
  fun([rth, ith]):
    let [ovs, ibod] = strip_forall(concl(ith))
    let [iant, icon] = dest_imp(ibod)
    let [ns, prrs] = unzip(map(dest_ibod)(conjuncts(icon)))
    let [rs, ps] = unzip(prrs)
    let gs = variants(variables(ibod))(ps)
    let [svs, tvs] = chop_list((length(ovs) - length(ns)))(ovs)
    let sth_2 = SPECL(svs)(rth)
    let jth_2 = SPECL(svs)(ith)
    let gimps = subst(zip(gs)(rs))(icon)
    let prs:
      map2(
        fun(n):
          fun([r, p]):
            let [tys, ty] = nsplit(dest_fun_ty)(range(1)(n))(type_of(r))
            let gvs = map(genvar)(tys)
            list_mk_abs([gvs, mk_conj([list_mk_comb([r, gvs]), list_mk_comb([p, gvs])])])
      )(ns)(prrs)
    let modify_rule:
      fun(rcl):
        fun(itm):
          let [avs, bod] = strip_forall(itm)
          if is_imp(bod)
          | let [a_5, c] = dest_imp(bod)
            let mgoal = mk_imp([gimps, mk_imp([vsubst(zip(gs)(ps))(a_5), a_5])])
            let mth = ASSUME(list_mk_forall([append(gs)(append(ps)(avs)), mgoal]))
            let ith_r = BETA_RULE(SPECL(append(prs)(append(rs)(avs)))(mth))
            let jth_r = MP(ith_r)(prove_triv(lhand(concl(ith_r))))
            let t = lhand(concl(jth_r))
            let kth_r = UNDISCH(jth_r)
            let ntm = list_mk_forall([avs, mk_imp([t, c])])
            let lth_r_2 = MP(SPECL(avs)(rcl))(kth_r)
            let lth_p_2 = UNDISCH(SPECL(avs)(ASSUME(ntm)))
            DISCH(ntm)(GENL(avs)(DISCH(t)(CONJ(lth_r_2)(lth_p_2))))
          | DISCH(itm)(GENL(avs)(CONJ(SPECL(avs)(rcl))(SPECL(avs)(ASSUME(itm)))))
    let mimps = map2(modify_rule)(CONJUNCTS(sth_2))(conjuncts(iant))
    let th1 = end_itlist(fun(th): fun(th_prime): MATCH_IMPS(CONJ(th)(th_prime)))(mimps)
    let th2 = BETA_RULE(SPECL(prs)(jth_2))
    let th3 = IMP_TRANS(th1)(th2)
    let nasm = lhand(concl(th3))
    let th4 = GENL(ps)(DISCH(nasm)(weaken_triv(UNDISCH(th3))))
    GENL(svs)(prove_monotonicity_hyps(th4))

def prove_inductive_relations_exist = ind_defs_prove_inductive_relations_exist_v2
