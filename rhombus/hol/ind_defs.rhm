def strip_ncomb:
  fun strip([n, tm, acc]):
    if Host.hol_lt(n)(1)
    | [tm, acc]
    | let [l, r] = Fusion.dest_comb(tm)
      strip([Host.hol_sub(n)(1), l, PairList.cons(r,acc)])
  (fun(n): (fun(tm): strip([n, tm, PairList []])))

