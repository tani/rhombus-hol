  fun FORALL_UNWIND_CONV(tm):
    try:
      let [avs, bod] = Basics.strip_forall(tm)
      let [ant, con] = Basics.dest_imp(bod)
      let eqs = Basics.conjuncts(ant)
      let eq:
        find(
          fun(tm):
            if Fusion.is_eq(tm)
            | let [l, r] = Fusion.dest_eq(tm)
              ((mem(l)(avs) && Host.hol_not(Basics.free_in(l)(r))) || (mem(r)(avs) && Host.hol_not(Basics.free_in(r)(l))))
            | #false)(eqs)
      let [l, r] = Fusion.dest_eq(eq)
      let v = (if (mem(l)(avs) && Host.hol_not(Basics.free_in(l)(r))) | l | r)
      let cjs_prime = PairList.cons(eq, subtract(eqs)(PairList.cons(eq, PairList [])))
      let n = Host.hol_sub(length(avs))(Host.hol_add(1)(Host.index(v)(Host.rev(avs))))
      let th1 = Canon.CONJ_ACI_RULE(Fusion.mk_eq([ant, Bool.list_mk_conj(cjs_prime)]))
      let th2 = Equal.AP_THM(Equal.AP_TERM(Fusion.rator(Fusion.rator(bod)))(th1))(con)
      let th3 = itlist(Drule.MK_FORALL)(avs)(th2)
      let th4 = Host.funpow(n)(Equal.BINDER_CONV)(PUSH_FORALL_CONV(baseconv))(Fusion.rand(Fusion.concl(th3)))
      Equal.CONV_RULE(Equal.RAND_CONV(FORALL_UNWIND_CONV))(Fusion.TRANS(th3)(th4))
      ~catch exn:
        match exn
        | Failure(_): Fusion.REFL(tm)
        | exn: Host.hol_raise(exn)
  FORALL_UNWIND_CONV

