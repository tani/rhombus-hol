def parse_inductive_type_specification:
  fun port_tmp_438(src):
    let [pty, rst] = NativeTypes.parse_pretype(src)
    [TypeInference.type_of_pretype(pty), rst]
  let parse_type_loc = port_tmp_438
  fun port_tmp_439(src):
    let [cn, sps]:
      match src
      | PairList [Host.Ident(cn), & sps]: [cn, sps]
      | _: Host.hol_apply_unit(fail)
    let [tys, rst] = Host.many(parse_type_loc)(sps)
    [[cn, tys], rst]
  let parse_type_conapp = port_tmp_439
  fun port_tmp_442(src):
    let [tn, sps]:
      match src
      | PairList [Host.Ident(tn), & sps]: [tn, sps]
      | _: Host.hol_apply_unit(fail)
    let port_tmp_440 = Host.listof(parse_type_conapp)(Host.a(Host.Resword("|")))("type definition clauses")
    let port_tmp_441 = Host.a(Host.Ident("="))
    let [tys, rst] = Host.parser_map(Host.parser_sequence(port_tmp_441)(port_tmp_440))(snd)(sps)
    [[Fusion.mk_vartype(tn), tys], rst]
  let parse_type_clause = port_tmp_442
  let parse_type_definition = Host.listof(parse_type_clause)(Host.a(Host.Resword(";")))("type definition")
  fun port_tmp_443(s):
    let [spec, rst] = o(o(parse_type_definition)(Host.lex))(explode)(s)
    (if Host.hol_equal(rst)(PairList []) | spec | failwith("parse_inductive_type_specification: junk after def"))
  port_tmp_443

