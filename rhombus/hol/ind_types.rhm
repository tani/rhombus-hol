def ind_types_define_type_raw_v3:
  let TRIV_IMP_CONV:
    fun(tm):
      let [avs, bod] = Basics.strip_forall(tm)
      let bth:
        if Fusion.is_eq(bod)
        | Fusion.REFL(Fusion.rand(bod))
        | let [ant, con] = Basics.dest_imp(bod)
          let ith = Equal.SUBS_CONV(Bool.CONJUNCTS(Fusion.ASSUME(ant)))(Equal.lhs(con))
          Bool.DISCH(ant)(ith)
      Bool.GENL(avs)(bth)
  let TRIV_ANTE_RULE:
    fun(th):
      let tm = Fusion.concl(th)
      if Basics.is_imp(tm)
      | let [ant, con] = Basics.dest_imp(Fusion.concl(th))
        let cjs = Basics.conjuncts(ant)
        let cths = map(TRIV_IMP_CONV)(cjs)
        Bool.MP(th)(end_itlist(Bool.CONJ)(cths))
      | th
  let ISO_EXPAND_CONV = Simp.PURE_ONCE_REWRITE_CONV(PairList.cons(ISO, PairList []))
  fun lift_type_bijections(iths):
    fun(cty):
      let itys = map(o(o(o(o(o(hd)(snd))(Fusion.dest_type))(Fusion.type_of))(Equal.lhand))(Fusion.concl))(iths)
      try:
        assoc(cty)(zip(itys)(iths))
        ~catch exn:
          match exn
          | Failure(_):
              if Host.hol_not(exists(C(Basics.occurs_in)(cty))(itys))
              | Fusion.INST_TYPE(PairList.cons([cty, Fusion.aty], PairList []))(ISO_REFL)
              | let [tycon, isotys] = Fusion.dest_type(cty)
                (if Host.hol_equal(tycon)("fun") | Drule.MATCH_MP(ISO_FUN)(end_itlist(Bool.CONJ)(map(lift_type_bijections(iths))(isotys))) | failwith(Host.hol_concat("lift_type_bijections: Unexpected type operator \"")(Host.hol_concat(tycon)("\""))))
          | exn: Host.hol_raise(exn)
  let pth = Tactics.prove([Host.hol_term(Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("?", Tyapp("fun", [Tyapp("fun", [Tyvar("?33607"), Tyapp("bool", [])]), Tyapp("bool", [])])), Var("P", Tyapp("fun", [Tyvar("?33607"), Tyapp("bool", [])])))), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyvar("?33607"), Tyapp("fun", [Tyvar("?33607"), Tyapp("bool", [])])])), Var("c", Tyvar("?33607"))), Comb(Const("@", Tyapp("fun", [Tyapp("fun", [Tyvar("?33607"), Tyapp("bool", [])]), Tyvar("?33607")])), Var("P", Tyapp("fun", [Tyvar("?33607"), Tyapp("bool", [])]))))), Comb(Var("P", Tyapp("fun", [Tyvar("?33607"), Tyapp("bool", [])])), Var("c", Tyvar("?33607")))))), Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Simp.GEN_REWRITE_TAC(o(Equal.LAND_CONV)(Equal.RAND_CONV))(PairList.cons(Equal.GSYM(Class.ETA_AX), PairList [])))(Tactics.DISCH_TAC))(Tactics.DISCH_THEN(Tactics.SUBST1_TAC)))(Tactics.MATCH_MP_TAC(Class.SELECT_AX)))(Tactics.POP_ASSUM(Tactics.ACCEPT_TAC))])
  let USE_PTH = Drule.MATCH_MP(pth)
  fun DE_EXISTENTIALIZE_RULE_2(th):
    if Host.hol_not(Basics.is_exists(Fusion.concl(th)))
    | [PairList [], th]
    | let th1 = USE_PTH(th)
      let v1 = Fusion.rand(Fusion.rand(Fusion.concl(th1)))
      let gv = Basics.genvar(Fusion.type_of(v1))
      let th2 = Equal.CONV_RULE(Equal.BETA_CONV)(Bool.UNDISCH(Fusion.INST(PairList.cons([gv, v1], PairList []))(th1)))
      let [vs, th3] = DE_EXISTENTIALIZE_RULE_2(th2)
      [PairList.cons(gv, vs), th3]
  let DE_EXISTENTIALIZE_RULE = DE_EXISTENTIALIZE_RULE_2
  let grab_type = o(o(o(o(Fusion.type_of)(Fusion.rand))(Equal.lhand))(snd))(Basics.strip_forall)
  let clause_corresponds:
    fun(cl0):
      let [f0, ctm0] = Fusion.dest_comb(Equal.lhs(cl0))
      let c0 = fst(Fusion.dest_const(fst(Basics.strip_comb(ctm0))))
      let [dty0, rty0] = Basics.dest_fun_ty(Fusion.type_of(f0))
      fun(cl1):
        let [f1, ctm1] = Fusion.dest_comb(Equal.lhs(cl1))
        let c1 = fst(Fusion.dest_const(fst(Basics.strip_comb(ctm1))))
        let [dty1, rty1] = Basics.dest_fun_ty(Fusion.type_of(f1))
        (Host.hol_equal(c0)(c1) && (Host.hol_equal(dty0)(rty1) && Host.hol_equal(rty0)(dty1)))
  let prove_inductive_types_isomorphic:
    fun(n):
      fun(k):
        fun([ith0, rth0]):
          fun([ith1, rth1]):
            let sth0_2 = Bool.SPEC_ALL(rth0)
            let sth1_2 = Bool.SPEC_ALL(rth1)
            let t_tm_3 = Fusion.concl(Bool.TRUTH)
            let [pevs0_2, pbod0_2] = Basics.strip_exists(Fusion.concl(sth0_2))
            let [pevs1_2, pbod1_2] = Basics.strip_exists(Fusion.concl(sth1_2))
            let [pcjs0_2, qcjs0_2] = Host.chop_list(k)(Basics.conjuncts(pbod0_2))
            let [pcjs1_2, qcjs1_2] = Host.chop_list(k)(snd(Host.chop_list(n)(Basics.conjuncts(pbod1_2))))
            let tyal0 = Host.setify(zip(map(grab_type)(pcjs1_2))(map(grab_type)(pcjs0_2)))
            let tyal1 = map((fun([a, b]): [b, a]))(tyal0)
            let tyins0_2:
              map(
                fun(f):
                  let [domty, ranty] = Basics.dest_fun_ty(Fusion.type_of(f))
                  [Basics.tysubst(tyal0)(domty), ranty])(pevs0_2)
            let tyins1_2:
              map(
                fun(f):
                  let [domty, ranty] = Basics.dest_fun_ty(Fusion.type_of(f))
                  [Basics.tysubst(tyal1)(domty), ranty])(pevs1_2)
            let tth0_2 = Fusion.INST_TYPE(tyins0_2)(sth0_2)
            let tth1_2 = Fusion.INST_TYPE(tyins1_2)(sth1_2)
            let [evs0_2, bod0_2] = Basics.strip_exists(Fusion.concl(tth0_2))
            let [evs1_2, bod1_2] = Basics.strip_exists(Fusion.concl(tth1_2))
            let [lcjs0_2, rcjs0_2] = Host.chop_list(k)(map(o(snd)(Basics.strip_forall))(Basics.conjuncts(bod0_2)))
            let [lcjs1_2, rcjsx_2] = Host.chop_list(k)(map(o(snd)(Basics.strip_forall))(snd(Host.chop_list(n)(Basics.conjuncts(bod1_2)))))
            let rcjs1 = map((fun(t): find(clause_corresponds(t))(rcjsx_2)))(rcjs0_2)
            let proc_clause:
              fun(tm0):
                fun(tm1):
                  let [l0_2, r0_2] = Fusion.dest_eq(tm0)
                  let [l1_2, r1_2] = Fusion.dest_eq(tm1)
                  let [vc0, wargs0] = Basics.strip_comb(r0_2)
                  let [con0, vargs0] = Basics.strip_comb(Fusion.rand(l0_2))
                  let gargs0 = map(o(Basics.genvar)(Fusion.type_of))(wargs0)
                  let nestf0 = map((fun(a): can(find((fun(t): (Fusion.is_comb(t) && Host.hol_equal(Fusion.rand(t))(a)))))(wargs0)))(vargs0)
                  let targs0 = Host.map2((fun(a): (fun(f): (if f | find((fun(t): (Fusion.is_comb(t) && Host.hol_equal(Fusion.rand(t))(a))))(wargs0) | a))))(vargs0)(nestf0)
                  let gvlist0 = zip(wargs0)(gargs0)
                  let xargs = map((fun(v): assoc(v)(gvlist0)))(targs0)
                  let inst0 = [Basics.list_mk_abs([gargs0, Basics.list_mk_comb([fst(Basics.strip_comb(Fusion.rand(l1_2))), xargs])]), vc0]
                  let [vc1, wargs1] = Basics.strip_comb(r1_2)
                  let [con1, vargs1] = Basics.strip_comb(Fusion.rand(l1_2))
                  let gargs1 = map(o(Basics.genvar)(Fusion.type_of))(wargs1)
                  let targs1 = Host.map2((fun(a): (fun(f): (if f | find((fun(t): (Fusion.is_comb(t) && Host.hol_equal(Fusion.rand(t))(a))))(wargs1) | a))))(vargs1)(nestf0)
                  let gvlist1 = zip(wargs1)(gargs1)
                  let xargs = map((fun(v): assoc(v)(gvlist1)))(targs1)
                  let inst1 = [Basics.list_mk_abs([gargs1, Basics.list_mk_comb([fst(Basics.strip_comb(Fusion.rand(l0_2))), xargs])]), vc1]
                  [inst0, inst1]
            let [insts0, insts1] = unzip(Host.map2(proc_clause)(append(lcjs0_2)(rcjs0_2))(append(lcjs1_2)(rcjs1)))
            let uth0_2 = Equal.BETA_RULE(Fusion.INST(insts0)(tth0_2))
            let uth1_2 = Equal.BETA_RULE(Fusion.INST(insts1)(tth1_2))
            let [efvs0_2, sth0_3] = DE_EXISTENTIALIZE_RULE(uth0_2)
            let [efvs1_2, sth1_3] = DE_EXISTENTIALIZE_RULE(uth1_2)
            let efvs2 = map((fun(t1): find((fun(t2): Host.hol_equal(hd(tl(snd(Fusion.dest_type(Fusion.type_of(t1))))))(hd(snd(Fusion.dest_type(Fusion.type_of(t2)))))))(efvs1_2)))(efvs0_2)
            let isotms = Host.map2((fun(ff): (fun(gg): Basics.list_mk_icomb("ISO")(PairList.cons(ff, PairList.cons(gg, PairList []))))))(efvs0_2)(efvs2)
            let ctm = Bool.list_mk_conj(isotms)
            let cth1 = ISO_EXPAND_CONV(ctm)
            let ctm1 = Fusion.rand(Fusion.concl(cth1))
            let cjs = Basics.conjuncts(ctm1)
            let eee = map((fun(n): Host.hol_equal(Host.hol_mod(n)(2))(0)))(Host.hol_range(0)(Host.hol_sub(length(cjs))(1)))
            let [cjs1, cjs2] = partition(fst)(zip(eee)(cjs))
            let ctm2 = Bool.mk_conj([Bool.list_mk_conj(map(snd)(cjs1)), Bool.list_mk_conj(map(snd)(cjs2))])
            let DETRIV_RULE = o(TRIV_ANTE_RULE)(Simp.REWRITE_RULE(PairList.cons(sth0_3, PairList.cons(sth1_3, PairList []))))
            let itha = Bool.SPEC_ALL(ith0)
            let icjs = Basics.conjuncts(Fusion.rand(Fusion.concl(itha)))
            let cinsts = map((fun(tm): tryfind((fun(vtm): Drule.term_match(PairList [])(vtm)(tm)))(icjs)))(Basics.conjuncts(Fusion.rand(ctm2)))
            let tvs = subtract(fst(Basics.strip_forall(Fusion.concl(ith0))))(itlist((fun([_, x, _]): union(map(snd)(x))))(cinsts)(PairList []))
            let ctvs:
              map(
                fun(p):
                  let x = Fusion.mk_var(["x", hd(snd(Fusion.dest_type(Fusion.type_of(p))))])
                  [Fusion.mk_abs([x, t_tm_3]), p])(tvs)
            let jth0_2 = DETRIV_RULE(Fusion.INST(ctvs)(itlist(Drule.INSTANTIATE)(cinsts)(itha)))
            let itha = Bool.SPEC_ALL(ith1)
            let icjs = Basics.conjuncts(Fusion.rand(Fusion.concl(itha)))
            let cinsts = map((fun(tm): tryfind((fun(vtm): Drule.term_match(PairList [])(vtm)(tm)))(icjs)))(Basics.conjuncts(Equal.lhand(ctm2)))
            let tvs = subtract(fst(Basics.strip_forall(Fusion.concl(ith1))))(itlist((fun([_, x, _]): union(map(snd)(x))))(cinsts)(PairList []))
            let ctvs:
              map(
                fun(p):
                  let x = Fusion.mk_var(["x", hd(snd(Fusion.dest_type(Fusion.type_of(p))))])
                  [Fusion.mk_abs([x, t_tm_3]), p])(tvs)
            let jth1_2 = DETRIV_RULE(Fusion.INST(ctvs)(itlist(Drule.INSTANTIATE)(cinsts)(itha)))
            let cths4 = Host.map2(Bool.CONJ)(Bool.CONJUNCTS(jth0_2))(Bool.CONJUNCTS(jth1_2))
            let cths5 = map(Simp.PURE_ONCE_REWRITE_RULE(PairList.cons(Equal.GSYM(ISO), PairList [])))(cths4)
            let cth6 = end_itlist(Bool.CONJ)(cths5)
            [cth6, Bool.CONJ(sth0_3)(sth1_3)]
  let SCRUB_ASSUMPTION:
    fun(th):
      let hyps = Fusion.hyp(th)
      let eqn:
        find(
          fun(t):
            let x = Equal.lhs(t)
            forall((fun(u): Host.hol_not(Basics.free_in(x)(Fusion.rand(u)))))(hyps))(hyps)
      let [l, r] = Fusion.dest_eq(eqn)
      Bool.MP(Fusion.INST(PairList.cons([r, l], PairList []))(Bool.DISCH(eqn)(th)))(Fusion.REFL(r))
  let define_type_basecase:
    fun(hol_def):
      let add_id = (fun(s): fst(Fusion.dest_var(Basics.genvar(Fusion.bool_ty))))
      let def_prime = map(Host.F_F(I)(map(Host.F_F(add_id)(I))))(hol_def)
      ind_types_define_type_raw_v2(def_prime)
  let SIMPLE_BETA_RULE = o(Equal.GSYM)(Simp.PURE_REWRITE_RULE(PairList.cons(Theorems.BETA_THM, PairList.cons(Class.FUN_EQ_THM, PairList []))))
  let ISO_USAGE_RULE = Drule.MATCH_MP(ISO_USAGE)
  let SIMPLE_ISO_EXPAND_RULE = Equal.CONV_RULE(Simp.REWR_CONV(ISO))
  let ths = itlist(Simp.mk_rewrites(#false))(PairList.cons(Class.FUN_EQ_THM, PairList []))(PairList [])
  let net = itlist(Simp.net_of_thm(#false))(ths)(Host.hol_apply_unit(Simp.basic_net))
  let REWRITE_FUN_EQ_RULE = o(Equal.CONV_RULE)(Simp.GENERAL_REWRITE_CONV(#true)(Equal.TOP_DEPTH_CONV)(net))
  let is_nested = (fun(vs): (fun(ty): (Host.hol_not(Fusion.is_vartype(ty)) && Host.hol_not(Host.hol_equal(Host.intersect(Fusion.tyvars(ty))(vs))(PairList [])))))
  fun modify_type(alist):
    fun(ty):
      try:
        rev_assoc(ty)(alist)
        ~catch exn:
          match exn
          | Failure(_):
              try:
                let [tycon, tyargs] = Fusion.dest_type(ty)
                Fusion.mk_type([tycon, map(modify_type(alist))(tyargs)])
                ~catch exn:
                  match exn
                  | Failure(_): ty
                  | exn: Host.hol_raise(exn)
          | exn: Host.hol_raise(exn)
  let modify_item = (fun(alist): (fun([s, l]): [s, map(modify_type(alist))(l)]))
  let modify_clause = (fun(alist): (fun([l, lis]): [l, map(modify_item(alist))(lis)]))
  let recover_clause:
    fun(id):
      fun(tm):
        let [con, args] = Basics.strip_comb(tm)
        [Host.hol_concat(fst(Fusion.dest_const(con)))(id), map(Fusion.type_of)(args)]
  fun create_auxiliary_clauses(nty):
    let id = fst(Fusion.dest_var(Basics.genvar(Fusion.bool_ty)))
    let [tycon, tyargs] = Fusion.dest_type(nty)
    let [k, ith, rth]:
      try:
        assoc(tycon)(Host.ref_get(Class.inductive_type_store))
        ~catch exn:
          match exn
          | Failure(_): failwith(Host.hol_concat("Can't find definition for nested type: ")(tycon))
          | exn: Host.hol_raise(exn)
    let [evs, bod] = Basics.strip_exists(snd(Basics.strip_forall(Fusion.concl(rth))))
    let cjs = map(o(o(Equal.lhand)(snd))(Basics.strip_forall))(Basics.conjuncts(bod))
    let rtys = map(o(o(o(hd)(snd))(Fusion.dest_type))(Fusion.type_of))(evs)
    let tyins = tryfind((fun(vty): Basics.type_match(vty)(nty)(PairList [])))(rtys)
    let cjs_prime = map(o(Fusion.inst(tyins))(Fusion.rand))(fst(Host.chop_list(k)(cjs)))
    let mtys = itlist(o(insert)(Fusion.type_of))(cjs_prime)(PairList [])
    let pcons = map((fun(ty): filter((fun(t): Host.hol_equal(Fusion.type_of(t))(ty)))(cjs_prime)))(mtys)
    let cls_prime = zip(mtys)(map(map(recover_clause(id)))(pcons))
    let tyal = map((fun(ty): [Fusion.mk_vartype(Host.hol_concat(fst(Fusion.dest_type(ty)))(id)), ty]))(mtys)
    let cls_prime_prime = map(Host.F_F(modify_type(tyal))(map(modify_item(tyal))))(cls_prime)
    [k, tyal, cls_prime_prime, Fusion.INST_TYPE(tyins)(ith), Fusion.INST_TYPE(tyins)(rth)]
  fun define_type_nested(hol_def):
    let n = length(itlist(append)(map(o(map(fst))(snd))(hol_def))(PairList []))
    let newtys = map(fst)(hol_def)
    let utys = Host.unions(itlist(o(o(union)(map(snd)))(snd))(hol_def)(PairList []))
    let rectys = filter(is_nested(newtys))(utys)
    if Host.hol_equal(rectys)(PairList [])
    | let [th1, th2] = define_type_basecase(hol_def)
      [n, th1, th2]
    | let nty = hd(sort((fun(t1): (fun(t2): Basics.occurs_in(t2)(t1))))(rectys))
      let [k, tyal, ncls, ith, rth] = create_auxiliary_clauses(nty)
      let cls = append(map(modify_clause(tyal))(hol_def))(ncls)
      let [_, ith1, rth1] = define_type_nested(cls)
      let xnewtys = map(o(o(o(hd)(snd))(Fusion.dest_type))(Fusion.type_of))(fst(Basics.strip_exists(snd(Basics.strip_forall(Fusion.concl(rth1))))))
      let xtyal:
        map(
          fun(ty):
            let s = Fusion.dest_vartype(ty)
            [find((fun(t): Host.hol_equal(fst(Fusion.dest_type(t)))(s)))(xnewtys), ty])(map(fst)(cls))
      let ith0_2 = Fusion.INST_TYPE(xtyal)(ith)
      let rth0_2 = Fusion.INST_TYPE(xtyal)(rth)
      let [isoth, rclauses] = prove_inductive_types_isomorphic(n)(k)([ith0_2, rth0_2])([ith1, rth1])
      let irth3 = Bool.CONJ(ith1)(rth1)
      let vtylist = itlist(o(insert)(Fusion.type_of))(Basics.variables(Fusion.concl(irth3)))(PairList [])
      let isoths = Bool.CONJUNCTS(isoth)
      let isotys = map(o(o(o(o(o(hd)(snd))(Fusion.dest_type))(Fusion.type_of))(Equal.lhand))(Fusion.concl))(isoths)
      let ctylist = filter((fun(ty): exists((fun(t): Basics.occurs_in(t)(ty)))(isotys)))(vtylist)
      let atylist = itlist(o(union)(striplist(Basics.dest_fun_ty)))(ctylist)(PairList [])
      let isoths_prime = map(lift_type_bijections(isoths))(filter((fun(ty): exists((fun(t): Basics.occurs_in(t)(ty)))(isotys)))(atylist))
      let cisoths = map(o(Equal.BETA_RULE)(lift_type_bijections(isoths_prime)))(ctylist)
      let uisoths = map(ISO_USAGE_RULE)(cisoths)
      let visoths = map(o(Fusion.ASSUME)(Fusion.concl))(uisoths)
      let irth4 = itlist(Bool.PROVE_HYP)(uisoths)(REWRITE_FUN_EQ_RULE(visoths)(irth3))
      let irth5 = Simp.REWRITE_RULE(PairList.cons(rclauses, map(SIMPLE_ISO_EXPAND_RULE)(isoths_prime)))(irth4)
      let irth6 = Host.repeat(SCRUB_ASSUMPTION)(irth5)
      let ncjs = filter((fun(t): exists((fun(v): Host.hol_not(Fusion.is_var(v))))(snd(Basics.strip_comb(Fusion.rand(Equal.lhs(snd(Basics.strip_forall(t)))))))))(Basics.conjuncts(snd(Basics.strip_exists(snd(Basics.strip_forall(Fusion.rand(Fusion.concl(irth6))))))))
      let mk_newcon:
        fun(tm):
          let [vs, bod] = Basics.strip_forall(tm)
          let rdeb = Fusion.rand(Equal.lhs(bod))
          let rdef = Basics.list_mk_abs([vs, rdeb])
          let newname = fst(Fusion.dest_var(Basics.genvar(Fusion.bool_ty)))
          let hol_def_2 = Fusion.mk_eq([Fusion.mk_var([newname, Fusion.type_of(rdef)]), rdef])
          let dth = HolPair.new_definition(hol_def_2)
          SIMPLE_BETA_RULE(dth)
      let dths = map(mk_newcon)(ncjs)
      let [ith6, rth6] = Bool.CONJ_PAIR(Simp.PURE_REWRITE_RULE(dths)(irth6))
      [n, ith6, rth6]
  fun(hol_def):
    let newtys = map(fst)(hol_def)
    let truecons = itlist(append)(map(o(map(fst))(snd))(hol_def))(PairList [])
    let [p, ith0, rth0] = define_type_nested(hol_def)
    let [avs, etm] = Basics.strip_forall(Fusion.concl(rth0))
    let allcls = Basics.conjuncts(snd(Basics.strip_exists(etm)))
    let relcls = fst(Host.chop_list(length(truecons))(allcls))
    let gencons = map(o(o(o(o(Host.repeat(Fusion.rator))(Fusion.rand))(Equal.lhand))(snd))(Basics.strip_forall))(relcls)
    let cdefs = Host.map2((fun(s): (fun(r): Equal.SYM(HolPair.new_definition(Fusion.mk_eq([Fusion.mk_var([s, Fusion.type_of(r)]), r]))))))(truecons)(gencons)
    let tavs = Basics.make_args("f")(PairList [])(map(Fusion.type_of)(avs))
    let ith1_2 = Equal.SUBS(cdefs)(ith0)
    let rth1_2 = Bool.GENL(tavs)(Equal.SUBS(cdefs)(Bool.SPECL(tavs)(rth0)))
    let retval = [p, ith1_2, rth1_2]
    let newentries = map((fun(s): [Fusion.dest_vartype(s), retval]))(newtys)
    Host.ref_set(Class.inductive_type_store)(append(newentries)(Host.ref_get(Class.inductive_type_store)))
    Host.do_list(extend_rectype_net)(newentries)
    [ith1_2, rth1_2]

def the_inductive_types = Box(PairList.cons(["list = NIL | CONS A list", [list_INDUCT, list_RECURSION]], PairList.cons(["option = NONE | SOME A", [option_INDUCT, option_RECURSION]], PairList.cons(["sum = INL A | INR B", [sum_INDUCT, sum_RECURSION]], PairList []))))

fun define_type(s):
  try:
    let retval = assoc(s)(Host.ref_get(the_inductive_types))
    Host.warn(#true)("Benign redefinition of inductive type")
    retval
    ~catch exn:
      match exn
      | Failure(_):
          let defspec = parse_inductive_type_specification(s)
          let newtypes_2 = map(fst)(defspec)
          let constructors_2 = itlist(o(append)(map(fst)))(map(snd)(defspec))(PairList [])
          if Host.hol_not(Host.hol_equal(length(Host.setify(newtypes_2)))(length(newtypes_2)))
          | failwith("define_type: multiple definitions of a type")
          | if Host.hol_not(Host.hol_equal(length(Host.setify(constructors_2)))(length(constructors_2)))
            | failwith("define_type: multiple instances of a constructor")
            | if exists(o(can(Fusion.get_type_arity))(Fusion.dest_vartype))(newtypes_2)
              | let t = find(can(Fusion.get_type_arity))(map(Fusion.dest_vartype)(newtypes_2))
                failwith(Host.hol_concat("define_type: type :")(Host.hol_concat(t)(" already defined")))
              | if exists(can(Fusion.get_const_type))(constructors_2)
                | let t = find(can(Fusion.get_const_type))(constructors_2)
                  failwith(Host.hol_concat("define_type: constant ")(Host.hol_concat(t)(" already defined")))
                | let retval = ind_types_define_type_raw_v3(defspec)
                  Host.ref_set(the_inductive_types)(PairList.cons([s, retval], Host.ref_get(the_inductive_types)))
                  retval
      | exn: Host.hol_raise(exn)

