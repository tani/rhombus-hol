  fun INSIDE_EXISTS_CONV(conv): (fun(tm): (if Basics.is_exists(tm) | Equal.BINDER_CONV(INSIDE_EXISTS_CONV(conv))(tm) | conv(tm)))
  let econv = Simp.REWR_CONV(Theorems.SWAP_EXISTS_THM)
  fun conv(bc):
    fun(tm):
      try:
        Equal.THENC(econv)(Equal.BINDER_CONV(conv(bc)))(tm)
        ~catch exn:
          match exn
          | Failure(_): bc(tm)
          | exn: Host.hol_raise(exn)
