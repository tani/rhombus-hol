        let [args, bod] = Basics.strip_abs(Fusion.rand(hd(Fusion.hyp(cth))))
        let [ccitm, rtm] = Fusion.dest_comb(bod)
        let [cctm, itm] = Fusion.dest_comb(ccitm)
        let [rargs, iargs] = partition(C(Basics.free_in)(rtm))(args)
        let xths = map(extract_arg(itm))(iargs)
        let cargs_prime = map(o(o(Basics.subst(PairList.cons([i_2, itm], PairList [])))(Equal.lhand))(Fusion.concl))(xths)
        let indices = map(sucivate)(Host.hol_range(0)(Host.hol_sub(length(rargs))(1)))
        let rindexed = map(curry(Fusion.mk_comb)(r_2))(indices)
        let rargs_prime = Host.map2((fun(a): (fun(rx): Fusion.mk_comb([assoc(a)(mkindex), rx]))))(artys)(rindexed)
        let sargs_prime = map(curry(Fusion.mk_comb)(s))(indices)
        let allargs = append(cargs_prime)(append(rargs_prime)(sargs_prime))
        let funty = itlist(o(Fusion.mk_fun_ty)(Fusion.type_of))(allargs)(zty)
        let funname = Host.hol_concat(fst(Fusion.dest_const(Host.repeat(Fusion.rator)(Equal.lhand(Fusion.concl(cth))))))("'")
        let funarg = Fusion.mk_var([funname, funty])
        Basics.list_mk_abs([PairList.cons(i_2, PairList.cons(r_2, PairList.cons(s, PairList []))), Basics.list_mk_comb([funarg, allargs])])
  let CCONV = Host.funpow(3)(Equal.RATOR_CONV)(Equal.REPEATC(Simp.GEN_REWRITE_CONV(I)(PairList.cons(FCONS, PairList []))))
  let derive_recursion_theorem:
    fun(tybijpairs):
      fun(consindex):
        fun(conthms):
          fun(rath):
            let isocons = map(create_recursion_iso_constructor(consindex))(conthms)
            let ty = Fusion.type_of(hd(isocons))
            let fcons_2 = Fusion.mk_const(["FCONS", PairList.cons([ty, Fusion.aty], PairList [])])
            let fnil_2 = Fusion.mk_const(["FNIL", PairList.cons([ty, Fusion.aty], PairList [])])
            let bigfun = itlist(Basics.mk_binop(fcons_2))(isocons)(fnil_2)
            let eth = Bool.ISPEC(bigfun)(CONSTR_REC)
            let fn = Fusion.rator(Fusion.rand(hd(Basics.conjuncts(Fusion.concl(rath)))))
            let [v, bod] = Fusion.dest_abs(Fusion.rand(Fusion.concl(eth)))
            let betm = Fusion.vsubst(PairList.cons([fn, v], PairList []))(bod)
            let LCONV = Simp.REWR_CONV(Fusion.ASSUME(betm))
            let fnths = map((fun(t): IndDefs.RIGHT_BETAS(PairList.cons(Basics.bndvar(Fusion.rand(t)), PairList []))(Fusion.ASSUME(t))))(Fusion.hyp(rath))
            let SIMPER = Simp.PURE_REWRITE_RULE(append(map(Equal.SYM)(fnths))(append(map(fst)(tybijpairs))(PairList.cons(HolPair.FST, PairList.cons(HolPair.SND, PairList.cons(FCONS, PairList.cons(Theorems.BETA_THM, PairList [])))))))
            let hackdown_rath:
              fun(th):
                let [ltm, rtm] = Fusion.dest_eq(Fusion.concl(th))
                let wargs = snd(Basics.strip_comb(Fusion.rand(ltm)))
                let th1 = Fusion.TRANS(th)(LCONV(rtm))
                let th2 = Fusion.TRANS(th1)(CCONV(Fusion.rand(Fusion.concl(th1))))
                let th3 = Fusion.TRANS(th2)(Host.funpow(2)(Equal.RATOR_CONV)(Equal.BETA_CONV)(Fusion.rand(Fusion.concl(th2))))
                let th4 = Fusion.TRANS(th3)(Equal.RATOR_CONV(Equal.BETA_CONV)(Fusion.rand(Fusion.concl(th3))))
                let th5 = Fusion.TRANS(th4)(Equal.BETA_CONV(Fusion.rand(Fusion.concl(th4))))
                Bool.GENL(wargs)(SIMPER(th5))
            let rthm = end_itlist(Bool.CONJ)(map(hackdown_rath)(Bool.CONJUNCTS(rath)))
            let unseqs = filter(Fusion.is_eq)(Fusion.hyp(rthm))
            let tys = map(o(o(o(o(o(hd)(snd))(Fusion.dest_type))(Fusion.type_of))(snd))(snd))(consindex)
            let seqs = map((fun(ty): find((fun(t): Host.hol_equal(hd(snd(Fusion.dest_type(Fusion.type_of(Equal.lhand(t))))))(ty)))(unseqs)))(tys)
            let rethm = itlist(IndDefs.EXISTS_EQUATION)(seqs)(rthm)
            let fethm = Bool.CHOOSE([fn, eth])(rethm)
            let pcons = map(o(o(Host.repeat(Fusion.rator))(Fusion.rand))(Host.repeat(o(snd)(Basics.dest_forall))))(Basics.conjuncts(Fusion.concl(rthm)))
            Bool.GENL(pcons)(fethm)
  fun(hol_def):
    let [defs, rth, ith] = justify_inductive_type_model(hol_def)
    let neths = prove_model_inhabitation(rth)
    let tybijpairs = map(define_inductive_type(defs))(neths)
    let preds = map(o(Host.repeat(Fusion.rator))(Fusion.concl))(neths)
    let mkdests:
      map(
        fun([th, _]):
          let tm = Equal.lhand(Fusion.concl(th))
          [Fusion.rator(tm), Fusion.rator(Fusion.rand(tm))])(tybijpairs)
    let consindex = zip(preds)(mkdests)
    let condefs = map(define_inductive_type_constructor(defs)(consindex))(Bool.CONJUNCTS(rth))
    let conthms:
      map(
        fun(th):
          let args = fst(Basics.strip_abs(Fusion.rand(Fusion.concl(th))))
          IndDefs.RIGHT_BETAS(args)(th))(condefs)
    let iith = instantiate_induction_theorem(consindex)(ith)
    let fth = derive_induction_theorem(consindex)(tybijpairs)(conthms)(iith)(rth)
    let rath = create_recursive_functions(tybijpairs)(consindex)(conthms)(rth)
    let kth = derive_recursion_theorem(tybijpairs)(consindex)(conthms)(rath)
    [fth, kth]

def parse_inductive_type_specification:
  let parse_type_loc:
    fun(src):
      let [pty, rst] = NativeTypes.parse_pretype(src)
      [TypeInference.type_of_pretype(pty), rst]
  let parse_type_conapp:
    fun(src):
      let [cn, sps]:
        match src
        | PairList [Host.Ident(cn), & sps]: [cn, sps]
        | _: Host.hol_apply_unit(fail)
      let [tys, rst] = Host.many(parse_type_loc)(sps)
      [[cn, tys], rst]
  let parse_type_clause:
    fun(src):
      let [tn, sps]:
        match src
        | PairList [Host.Ident(tn), & sps]: [tn, sps]
        | _: Host.hol_apply_unit(fail)
      let [tys, rst] = Host.parser_map(Host.parser_sequence(Host.a(Host.Ident("=")))(Host.listof(parse_type_conapp)(Host.a(Host.Resword("|")))("type definition clauses")))(snd)(sps)
      [[Fusion.mk_vartype(tn), tys], rst]
  let parse_type_definition = Host.listof(parse_type_clause)(Host.a(Host.Resword(";")))("type definition")
  fun(s):
    let [spec, rst] = o(o(parse_type_definition)(Host.lex))(explode)(s)
    (if Host.hol_equal(rst)(PairList []) | spec | failwith("parse_inductive_type_specification: junk after def"))

def [sum_INDUCT, sum_RECURSION] = ind_types_define_type_raw(parse_inductive_type_specification("sum = INL A | INR B"))

def OUTL = Recursion.new_recursive_definition(sum_RECURSION)(Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyvar("A"), Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])])])), Comb(Var("OUTL", Tyapp("fun", [Tyapp("sum", [Tyvar("A"), Tyvar("B")]), Tyvar("A")])), Comb(Const("INL", Tyapp("fun", [Tyvar("A"), Tyapp("sum", [Tyvar("A"), Tyvar("B")])])), Var("x", Tyvar("A"))))), Var("x", Tyvar("A")))))

def OUTR = Recursion.new_recursive_definition(sum_RECURSION)(Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyvar("B"), Tyapp("fun", [Tyvar("B"), Tyapp("bool", [])])])), Comb(Var("OUTR", Tyapp("fun", [Tyapp("sum", [Tyvar("A"), Tyvar("B")]), Tyvar("B")])), Comb(Const("INR", Tyapp("fun", [Tyvar("B"), Tyapp("sum", [Tyvar("A"), Tyvar("B")])])), Var("y", Tyvar("B"))))), Var("y", Tyvar("B")))))

def ind_types_define_type_raw_v2:
  let ELIM_OUTCOMBS = Simp.GEN_REWRITE_RULE(Equal.TOP_DEPTH_CONV)(PairList.cons(OUTL, PairList.cons(OUTR, PairList [])))
  fun mk_sum(tys):
    let k = length(tys)
    if Host.hol_equal(k)(1)
    | hd(tys)
    | let [tys1, tys2] = Host.chop_list(Host.hol_div(k)(2))(tys)
      Fusion.mk_type(["sum", PairList.cons(mk_sum(tys1), PairList.cons(mk_sum(tys2), PairList []))])
  fun mk_inls_2(ty):
    if Fusion.is_vartype(ty)
    | PairList.cons(Fusion.mk_var(["x", ty]), PairList [])
    | let [_, PairList [ty1, & PairList [ty2, & PairList []]]] = Fusion.dest_type(ty)
      let inls1_2 = mk_inls_2(ty1)
      let inls2_2 = mk_inls_2(ty2)
      let inl_2 = Fusion.mk_const(["INL", PairList.cons([ty1, Fusion.aty], PairList.cons([ty2, Fusion.bty], PairList []))])
      let inr_2 = Fusion.mk_const(["INR", PairList.cons([ty1, Fusion.aty], PairList.cons([ty2, Fusion.bty], PairList []))])
      append(map(curry(Fusion.mk_comb)(inl_2))(inls1_2))(map(curry(Fusion.mk_comb)(inr_2))(inls2_2))
  let mk_inls:
    fun(ty):
      let bods = mk_inls_2(ty)
      map((fun(t): Fusion.mk_abs([Basics.find_term(Fusion.is_var)(t), t])))(bods)
  fun mk_inls_3(sof):
    fun(ty):
      if Fusion.is_vartype(ty)
      | PairList.cons(sof, PairList [])
      | let [_, PairList [ty1, & PairList [ty2, & PairList []]]] = Fusion.dest_type(ty)
        let outl_2 = Fusion.mk_const(["OUTL", PairList.cons([ty1, Fusion.aty], PairList.cons([ty2, Fusion.bty], PairList []))])
        let outr_2 = Fusion.mk_const(["OUTR", PairList.cons([ty1, Fusion.aty], PairList.cons([ty2, Fusion.bty], PairList []))])
        append(mk_inls_3(Fusion.mk_comb([outl_2, sof]))(ty1))(mk_inls_3(Fusion.mk_comb([outr_2, sof]))(ty2))
  let mk_outls:
    fun(ty):
      let x = Fusion.mk_var(["x", ty])
      map(curry(Fusion.mk_abs)(x))(mk_inls_3(x)(ty))
  let mk_newfun:
    fun(fn):
      fun(outl):
        let [s, ty] = Fusion.dest_var(fn)
        let dty = hd(snd(Fusion.dest_type(ty)))
        let x = Fusion.mk_var(["x", dty])
        let [y, bod] = Fusion.dest_abs(outl)
        let r = Fusion.mk_abs([x, Fusion.vsubst(PairList.cons([Fusion.mk_comb([fn, x]), y], PairList []))(bod)])
        let l = Fusion.mk_var([s, Fusion.type_of(r)])
        let th1 = Fusion.ASSUME(Fusion.mk_eq([l, r]))
        IndDefs.RIGHT_BETAS(PairList.cons(x, PairList []))(th1)
  let generalize_recursion_theorem:
    fun(th):
      let [avs, ebod] = Basics.strip_forall(Fusion.concl(th))
      let [evs, bod] = Basics.strip_exists(ebod)
      let n = length(evs)
      if Host.hol_equal(n)(1)
      | th
      | let tys = map((fun(i): Fusion.mk_vartype(Host.hol_concat("Z")(Host.hol_string_of_int(i)))))(Host.hol_range(0)(Host.hol_sub(n)(1)))
        let sty = mk_sum(tys)
        let inls_2 = mk_inls(sty)
        let outls_2 = mk_outls(sty)
        let zty = Fusion.type_of(Fusion.rand(snd(Basics.strip_forall(hd(Basics.conjuncts(bod))))))
        let ith = Fusion.INST_TYPE(PairList.cons([sty, zty], PairList []))(th)
        let [avs, ebod] = Basics.strip_forall(Fusion.concl(ith))
        let [evs, bod] = Basics.strip_exists(ebod)
        let fns_prime = Host.map2(mk_newfun)(evs)(outls_2)
        let fnalist_2 = zip(evs)(map(o(o(Fusion.rator)(Equal.lhs))(Fusion.concl))(fns_prime))
        let inlalist_2 = zip(evs)(inls_2)
        let outlalist_2 = zip(evs)(outls_2)
        let hack_clause:
          fun(tm):
            let [avs, bod] = Basics.strip_forall(tm)
            let [l, r] = Fusion.dest_eq(bod)
            let [fn, args] = Basics.strip_comb(r)
            let pargs:
              map(
                fun(a):
                  let g = Basics.genvar(Fusion.type_of(a))
                  if Fusion.is_var(a)
                  | [g, g]
                  | let outl = assoc(Fusion.rator(a))(outlalist_2)
                    [Fusion.mk_comb([outl, g]), g])(args)
            let [args_prime, args_prime_prime] = unzip(pargs)
            let inl = assoc(Fusion.rator(l))(inlalist_2)
            let rty = hd(snd(Fusion.dest_type(Fusion.type_of(inl))))
            let nty = itlist(o(Fusion.mk_fun_ty)(Fusion.type_of))(args_prime)(rty)
            let fn_prime = Fusion.mk_var([fst(Fusion.dest_var(fn)), nty])
            let r_prime = Basics.list_mk_abs([args_prime_prime, Fusion.mk_comb([inl, Basics.list_mk_comb([fn_prime, args_prime])])])
            [r_prime, fn]
        let defs = map(hack_clause)(Basics.conjuncts(bod))
        let jth = Equal.BETA_RULE(Bool.SPECL(map(fst)(defs))(ith))
        let bth = Fusion.ASSUME(snd(Basics.strip_exists(Fusion.concl(jth))))
        let finish_clause:
          fun(th):
            let [avs, bod] = Basics.strip_forall(Fusion.concl(th))
            let outl = assoc(Fusion.rator(Equal.lhand(bod)))(outlalist_2)
            Bool.GENL(avs)(Equal.BETA_RULE(Equal.AP_TERM(outl)(Bool.SPECL(avs)(th))))
        let cth = end_itlist(Bool.CONJ)(map(finish_clause)(Bool.CONJUNCTS(bth)))
        let dth = ELIM_OUTCOMBS(cth)
        let eth = Simp.GEN_REWRITE_RULE(Equal.ONCE_DEPTH_CONV)(map(Equal.SYM)(fns_prime))(dth)
        let fth = itlist(Bool.SIMPLE_EXISTS)(map(snd)(fnalist_2))(eth)
        let dtms = map(o(hd)(Fusion.hyp))(fns_prime)
        let gth:
          itlist(
            fun(e):
              fun(th):
                let [l, r] = Fusion.dest_eq(e)
                Bool.MP(Fusion.INST(PairList.cons([r, l], PairList []))(Bool.DISCH(e)(th)))(Fusion.REFL(r)))(dtms)(fth)
        let hth = Bool.PROVE_HYP(jth)(itlist(Bool.SIMPLE_CHOOSE)(evs)(gth))
        let xvs = map(o(o(o(o(fst)(Basics.strip_comb))(Fusion.rand))(snd))(Basics.strip_forall))(Basics.conjuncts(Fusion.concl(eth)))
        Bool.GENL(xvs)(hth)
  fun(hol_def):
    let [ith, rth] = ind_types_define_type_raw(hol_def)
    [ith, generalize_recursion_theorem(rth)]

def [option_INDUCT, option_RECURSION] = ind_types_define_type_raw_v2(parse_inductive_type_specification("option = NONE | SOME A"))

def [list_INDUCT, list_RECURSION] = ind_types_define_type_raw_v2(parse_inductive_type_specification("list = NIL | CONS A list"))

def FORALL_OPTION_THM = Tactics.prove([Host.hol_term(Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])]), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("P", Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("x", Tyapp("option", [Tyvar("A")])), Comb(Var("P", Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])])), Var("x", Tyapp("option", [Tyvar("A")])))))), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Var("P", Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])])), Const("NONE", Tyapp("option", [Tyvar("A")])))), Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("a", Tyvar("A")), Comb(Var("P", Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])])), Comb(Const("SOME", Tyapp("fun", [Tyvar("A"), Tyapp("option", [Tyvar("A")])])), Var("a", Tyvar("A"))))))))))), Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.GEN_TAC)(Tactics.EQ_TAC))(Simp.REWRITE_TAC(PairList.cons(option_INDUCT, PairList []))))(Simp.SIMP_TAC(PairList []))])

def EXISTS_OPTION_THM = Tactics.prove([Host.hol_term(Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])]), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("P", Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("?", Tyapp("fun", [Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("x", Tyapp("option", [Tyvar("A")])), Comb(Var("P", Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])])), Var("x", Tyapp("option", [Tyvar("A")])))))), Comb(Comb(Const("\\/", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Var("P", Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])])), Const("NONE", Tyapp("option", [Tyvar("A")])))), Comb(Const("?", Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("a", Tyvar("A")), Comb(Var("P", Tyapp("fun", [Tyapp("option", [Tyvar("A")]), Tyapp("bool", [])])), Comb(Const("SOME", Tyapp("fun", [Tyvar("A"), Tyapp("option", [Tyvar("A")])])), Var("a", Tyvar("A"))))))))))), Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.GEN_TAC)(Simp.REWRITE_TAC(PairList.cons(Meson.MESON(PairList [])(Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("?", Tyapp("fun", [Tyapp("fun", [Tyvar("?33399"), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("x", Tyvar("?33399")), Comb(Var("P", Tyapp("fun", [Tyvar("?33399"), Tyapp("bool", [])])), Var("x", Tyvar("?33399")))))), Comb(Const("~", Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])), Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyvar("?33399"), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("x", Tyvar("?33399")), Comb(Const("~", Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])), Comb(Var("P", Tyapp("fun", [Tyvar("?33399"), Tyapp("bool", [])])), Var("x", Tyvar("?33399")))))))))), PairList []))))(Simp.REWRITE_TAC(PairList.cons(FORALL_OPTION_THM, PairList []))))(Meson.MESON_TAC(PairList []))])

def prove_constructors_injective:
  let DEPAIR = Simp.GEN_REWRITE_RULE(Equal.TOP_SWEEP_CONV)(PairList.cons(HolPair.PAIR_EQ, PairList []))
  let prove_distinctness:
    fun(ax):
      fun(pat):
        let [f, args] = Basics.strip_comb(pat)
        let rt = end_itlist(curry(HolPair.mk_pair))(args)
        let ty = Fusion.mk_fun_ty(Fusion.type_of(pat))(Fusion.type_of(rt))
        let fn = Basics.genvar(ty)
        let dtm = Fusion.mk_eq([Fusion.mk_comb([fn, pat]), rt])
        let eth = Recursion.prove_recursive_functions_exist(ax)(Bool.list_mk_forall([args, dtm]))
        let args_prime = Basics.variants(args)(args)
        let atm = Fusion.mk_eq([pat, Basics.list_mk_comb([f, args_prime])])
        let ath = Fusion.ASSUME(atm)
        let bth = Equal.AP_TERM(fn)(ath)
        let cth1 = Bool.SPECL(args)(Fusion.ASSUME(snd(Basics.dest_exists(Fusion.concl(eth)))))
        let cth2 = Fusion.INST(zip(args_prime)(args))(cth1)
        let pth = Fusion.TRANS(Fusion.TRANS(Equal.SYM(cth1))(bth))(cth2)
        let qth = DEPAIR(pth)
        let qtm = Fusion.concl(qth)
        let rth = rev_itlist(C(curry(Fusion.MK_COMB)))(Bool.CONJUNCTS(Fusion.ASSUME(qtm)))(Fusion.REFL(f))
        let tth = Bool.IMP_ANTISYM_RULE(Bool.DISCH(atm)(qth))(Bool.DISCH(qtm)(rth))
        let uth = Bool.GENL(args)(Bool.GENL(args_prime)(tth))
        Bool.PROVE_HYP(eth)(Bool.SIMPLE_CHOOSE(fn)(uth))
  fun(ax):
    let cls = Basics.conjuncts(snd(Basics.strip_exists(snd(Basics.strip_forall(Fusion.concl(ax))))))
    let pats = map(o(o(o(Fusion.rand)(Equal.lhand))(snd))(Basics.strip_forall))(cls)
    end_itlist(Bool.CONJ)(mapfilter(prove_distinctness(ax))(pats))

def prove_constructors_distinct:
  let num_ty = Host.hol_term(Tyapp("num", []))
  fun allopairs(f): (fun(l): (fun(m): (if Host.hol_equal(l)(PairList []) | PairList [] | append(map(f(hd(l)))(tl(m)))(allopairs(f)(tl(l))(tl(m))))))
  let NEGATE = o(Bool.GEN_ALL)(Equal.CONV_RULE(Simp.REWR_CONV(Class.TAUT(Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("a", Tyapp("bool", []))), Const("F", Tyapp("bool", [])))), Comb(Const("~", Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])), Var("a", Tyapp("bool", [])))))))))
  let prove_distinct:
    fun(ax):
      fun(pat):
        let nums = map(Nums.mk_small_numeral)(Host.hol_range(0)(Host.hol_sub(length(pat))(1)))
        let fn = Basics.genvar(Fusion.mk_type(["fun", PairList.cons(Fusion.type_of(hd(pat)), PairList.cons(num_ty, PairList []))]))
        let ls = map(curry(Fusion.mk_comb)(fn))(pat)
        let defs = Host.map2((fun(l): (fun(r): Bool.list_mk_forall([Fusion.frees(Fusion.rand(l)), Fusion.mk_eq([l, r])]))))(ls)(nums)
        let eth = Recursion.prove_recursive_functions_exist(ax)(Bool.list_mk_conj(defs))
        let [ev, bod] = Basics.dest_exists(Fusion.concl(eth))
        let REWRITE = Simp.GEN_REWRITE_RULE(Equal.ONCE_DEPTH_CONV)(Bool.CONJUNCTS(Fusion.ASSUME(bod)))
        let pat_prime:
          map(
            fun(t):
              let [f, args] = (if Nums.is_numeral(t) | [t, PairList []] | Basics.strip_comb(t))
              Basics.list_mk_comb([f, Basics.variants(args)(args)]))(pat)
        let pairs = allopairs(curry(Fusion.mk_eq))(pat)(pat_prime)
        let nths = map(o(o(REWRITE)(Equal.AP_TERM(fn)))(Fusion.ASSUME))(pairs)
        let fths = Host.map2((fun(t): (fun(th): NEGATE(Bool.DISCH(t)(Equal.CONV_RULE(CalcNum.NUM_EQ_CONV)(th))))))(pairs)(nths)
        Bool.CONJUNCTS(Bool.PROVE_HYP(eth)(Bool.SIMPLE_CHOOSE(ev)(end_itlist(Bool.CONJ)(fths))))
  fun(ax):
    let cls = Basics.conjuncts(snd(Basics.strip_exists(snd(Basics.strip_forall(Fusion.concl(ax))))))
    let lefts = map(o(o(o(Fusion.dest_comb)(Equal.lhand))(snd))(Basics.strip_forall))(cls)
    let fns = itlist(o(insert)(fst))(lefts)(PairList [])
    let pats = map((fun(f): map(snd)(filter(o(Host.hol_equal(f))(fst))(lefts))))(fns)
    end_itlist(Bool.CONJ)(end_itlist(append)(mapfilter(prove_distinct(ax))(pats)))

def prove_cases_thm:
  let mk_exclauses:
    fun(x):
      fun(rpats):
        let xts = map((fun(t): Bool.list_mk_exists([Fusion.frees(t), Fusion.mk_eq([x, t])])))(rpats)
        Fusion.mk_abs([x, Bool.list_mk_disj(xts)])
  let prove_triv:
    fun(tm):
      let [evs, bod] = Basics.strip_exists(tm)
      let [l, r] = Fusion.dest_eq(bod)
      if Host.hol_equal(l)(r)
      | Fusion.REFL(l)
      | let [lf_2, largs_2] = Basics.strip_comb(l)
        let [rf_2, rargs_2] = Basics.strip_comb(r)
        if Host.hol_equal(lf_2)(rf_2)
        | let ths = map(o(Fusion.ASSUME)(Fusion.mk_eq))(zip(rargs_2)(largs_2))
          let th1 = rev_itlist(C(curry(Fusion.MK_COMB)))(ths)(Fusion.REFL(lf_2))
          itlist(IndDefs.EXISTS_EQUATION)(map(Fusion.concl)(ths))(Equal.SYM(th1))
        | failwith("prove_triv")
  fun prove_disj(tm):
    if Basics.is_disj(tm)
    | let [l, r] = Basics.dest_disj(tm)
      try:
        Bool.DISJ1(prove_triv(l))(r)
        ~catch exn:
          match exn
          | Failure(_): Bool.DISJ2(l)(prove_disj(r))
          | exn: Host.hol_raise(exn)
    | prove_triv(tm)
  let prove_eclause:
    fun(tm):
      let [avs, bod] = Basics.strip_forall(tm)
      let ctm = (if Basics.is_imp(bod) | Fusion.rand(bod) | bod)
      let cth = prove_disj(ctm)
      let dth = (if Basics.is_imp(bod) | Bool.DISCH(Equal.lhand(bod))(cth) | cth)
      Bool.GENL(avs)(dth)
  fun(th):
    let [avs, bod] = Basics.strip_forall(Fusion.concl(th))
    let cls = map(o(snd)(Basics.strip_forall))(Basics.conjuncts(Equal.lhand(bod)))
    let pats = map((fun(t): (if Basics.is_imp(t) | Fusion.rand(t) | t)))(cls)
    let spats = map(Fusion.dest_comb)(pats)
    let preds = itlist(o(insert)(fst))(spats)(PairList [])
    let rpatlist = map((fun(pr): map(snd)(filter((fun([p, x]): Host.hol_equal(p)(pr)))(spats))))(preds)
    let xs = Basics.make_args("x")(Fusion.freesl(pats))(map(o(Fusion.type_of)(hd))(rpatlist))
    let xpreds = Host.map2(mk_exclauses)(xs)(rpatlist)
    let ith = Equal.BETA_RULE(Fusion.INST(zip(xpreds)(preds))(Bool.SPEC_ALL(th)))
    let eclauses = Basics.conjuncts(fst(Basics.dest_imp(Fusion.concl(ith))))
    Bool.MP(ith)(end_itlist(Bool.CONJ)(map(prove_eclause)(eclauses)))

Host.ref_set(Class.inductive_type_store)(append(PairList.cons(["list", [2, list_INDUCT, list_RECURSION]], PairList.cons(["option", [2, option_INDUCT, option_RECURSION]], PairList.cons(["sum", [2, sum_INDUCT, sum_RECURSION]], PairList []))))(Host.ref_get(Class.inductive_type_store)))

def basic_rectype_net = Box(Nets.empty_net)

def distinctness_store = Box(PairList.cons(["bool", Class.TAUT(Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Const("T", Tyapp("bool", []))), Const("F", Tyapp("bool", [])))), Const("F", Tyapp("bool", [])))))], PairList []))

def injectivity_store = Box(PairList [])

fun extend_rectype_net([tyname, [_, _, rth]]):
  let ths1_2:
    try:
      PairList.cons(prove_constructors_distinct(rth), PairList [])
      ~catch exn:
        match exn
        | Failure(_): PairList []
        | exn: Host.hol_raise(exn)
  let ths2_2:
    try:
      PairList.cons(prove_constructors_injective(rth), PairList [])
      ~catch exn:
        match exn
        | Failure(_): PairList []
        | exn: Host.hol_raise(exn)
  let canon_thl = itlist(Simp.mk_rewrites(#false))(append(ths1_2)(ths2_2))(PairList [])
  Host.ref_set(distinctness_store)(append(map((fun(th): [tyname, th]))(ths1_2))(Host.ref_get(distinctness_store)))
  Host.ref_set(injectivity_store)(append(map((fun(th): [tyname, th]))(ths2_2))(Host.ref_get(injectivity_store)))
  Host.ref_set(basic_rectype_net)(itlist(Simp.net_of_thm(#true))(canon_thl)(Host.ref_get(basic_rectype_net)))

Host.do_list(extend_rectype_net)(Host.ref_get(Class.inductive_type_store))

fun distinctness(ty): assoc(ty)(Host.ref_get(distinctness_store))

fun injectivity(ty): assoc(ty)(Host.ref_get(injectivity_store))

fun cases(ty):
  if Host.hol_equal(ty)("num")
  | Nums.num_CASES
  | let [_, ith, _] = assoc(ty)(Host.ref_get(Class.inductive_type_store))
    prove_cases_thm(ith)

