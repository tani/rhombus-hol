            | Failure(_): PairList.cons(h1_2, munion(s1_prime_2)(s2))
            | exn: Host.hol_raise(exn)
  let justify_inductive_type_model:
    fun(hol_def):
      let [newtys, rights] = unzip(hol_def)
      let tyargls = itlist(o(append)(map(snd)))(rights)(PairList [])
      let alltys = itlist(o(munion)(C(subtract)(newtys)))(tyargls)(PairList [])
      let epstms = map((fun(ty): Class.mk_select([Fusion.mk_var(["v", ty]), t_tm_2])))(alltys)
      let pty:
        try:
          end_itlist((fun(ty1): (fun(ty2): Fusion.mk_type(["prod", PairList.cons(ty1, PairList.cons(ty2, PairList []))]))))(alltys)
          ~catch exn:
            match exn
            | Failure(_): Fusion.bool_ty
            | exn: Host.hol_raise(exn)
      let recty = Fusion.mk_type(["recspace", PairList.cons(pty, PairList [])])
      let constr = Fusion.mk_const(["CONSTR", PairList.cons([pty, Fusion.aty], PairList [])])
      let fcons = Fusion.mk_const(["FCONS", PairList.cons([recty, Fusion.aty], PairList [])])
      let bot = Fusion.mk_const(["BOTTOM", PairList.cons([pty, Fusion.aty], PairList [])])
      let bottail = Fusion.mk_abs([n_tm_2, bot])
      let mk_constructor:
        fun(n):
          fun([cname, cargs]):
            let ttys = map((fun(ty): (if mem(ty)(newtys) | recty | ty)))(cargs)
            let args = Basics.make_args("a")(PairList [])(ttys)
            let [rargs, iargs] = partition((fun(t): Host.hol_equal(Fusion.type_of(t))(recty)))(args)
            fun mk_injector(epstms):
              fun(alltys):
                fun(iargs):
                  if Host.hol_equal(alltys)(PairList [])
                  | PairList []
                  | let ty = hd(alltys)
                    try:
                      let [a_2, iargs_prime] = Host.remove((fun(t): Host.hol_equal(Fusion.type_of(t))(ty)))(iargs)
                      PairList.cons(a_2, mk_injector(tl(epstms))(tl(alltys))(iargs_prime))
                      ~catch exn:
                        match exn
                        | Failure(_): PairList.cons(hd(epstms), mk_injector(tl(epstms))(tl(alltys))(iargs))
                        | exn: Host.hol_raise(exn)
            let iarg:
              try:
                end_itlist(curry(HolPair.mk_pair))(mk_injector(epstms)(alltys)(iargs))
                ~catch exn:
                  match exn
                  | Failure(_): beps_tm_2
                  | exn: Host.hol_raise(exn)
            let rarg = itlist(Basics.mk_binop(fcons))(rargs)(bottail)
            let conty = itlist(Fusion.mk_fun_ty)(map(Fusion.type_of)(args))(recty)
            let condef = Basics.list_mk_comb([constr, PairList.cons(sucivate(n), PairList.cons(iarg, PairList.cons(rarg, PairList [])))])
            Fusion.mk_eq([Fusion.mk_var([cname, conty]), Basics.list_mk_abs([args, condef])])
      fun mk_constructors(n): (fun(rights): (if Host.hol_equal(rights)(PairList []) | PairList [] | PairList.cons(mk_constructor(n)(hd(rights)), mk_constructors(Host.hol_add(n)(1))(tl(rights)))))
      let condefs = mk_constructors(0)(itlist(append)(rights)(PairList []))
      let conths = map(Fusion.ASSUME)(condefs)
      let predty = Fusion.mk_fun_ty(recty)(Fusion.bool_ty)
      let edefs = itlist((fun([x, l]): (fun(acc): append(map((fun(t): [x, t]))(l))(acc))))(hol_def)(PairList [])
      let idefs = Host.map2((fun([r, [_, atys]]): (fun(hol_def): [[r, atys], hol_def])))(edefs)(condefs)
      let mk_rule:
        fun([[r, a], condef]):
          let [left, right] = Fusion.dest_eq(condef)
          let [args, bod] = Basics.strip_abs(right)
          let lapp = Basics.list_mk_comb([left, args])
          let conds = itlist2((fun(arg): (fun(argty): (fun(sofar): (if mem(argty)(newtys) | PairList.cons(Fusion.mk_comb([Fusion.mk_var([Fusion.dest_vartype(argty), predty]), arg]), sofar) | sofar)))))(args)(a)(PairList [])
          let conc = Fusion.mk_comb([Fusion.mk_var([Fusion.dest_vartype(r), predty]), lapp])
          let rule = (if Host.hol_equal(conds)(PairList []) | conc | Bool.mk_imp([Bool.list_mk_conj(conds), conc]))
          Bool.list_mk_forall([args, rule])
      let rules = Bool.list_mk_conj(map(mk_rule)(idefs))
      let th0 = IndDefs.derive_nonschematic_inductive_relations(rules)
      let th1 = IndDefs.prove_monotonicity_hyps(th0)
      let [th2a, th2bc] = Bool.CONJ_PAIR(th1)
      let th2b = Bool.CONJUNCT1(th2bc)
      [conths, th2a, th2b]
  let prove_model_inhabitation:
    fun(rth):
      let srules = map(Bool.SPEC_ALL)(Bool.CONJUNCTS(rth))
      let [imps, bases] = partition(o(Basics.is_imp)(Fusion.concl))(srules)
      let concs = append(map(Fusion.concl)(bases))(map(o(Fusion.rand)(Fusion.concl))(imps))
      let preds = Host.setify(map(Host.repeat(Fusion.rator))(concs))
      fun exhaust_inhabitations(ths):
        fun(sofar):
          let dunnit = Host.setify(map(o(o(fst)(Basics.strip_comb))(Fusion.concl))(sofar))
          let useful = filter((fun(th): Host.hol_not(mem(fst(Basics.strip_comb(Fusion.rand(Fusion.concl(th)))))(dunnit))))(ths)
          if Host.hol_equal(useful)(PairList [])
          | sofar
          | let follow_horn:
              fun(thm):
                let preds = map(o(fst)(Basics.strip_comb))(Basics.conjuncts(Equal.lhand(Fusion.concl(thm))))
                let asms = map((fun(p): find((fun(th): Host.hol_equal(fst(Basics.strip_comb(Fusion.concl(th))))(p)))(sofar)))(preds)
                Drule.MATCH_MP(thm)(end_itlist(Bool.CONJ)(asms))
            let newth = tryfind(follow_horn)(useful)
            exhaust_inhabitations(ths)(PairList.cons(newth, sofar))
      let ithms = exhaust_inhabitations(imps)(bases)
      let exths = map((fun(p): find((fun(th): Host.hol_equal(fst(Basics.strip_comb(Fusion.concl(th))))(p)))(ithms)))(preds)
      exths
