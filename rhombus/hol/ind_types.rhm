  let t_tm_2 = Host.hol_term(Const("T", Tyapp("bool", [])))
  let n_tm_2 = Host.hol_term(Var("n", Tyapp("num", [])))
  let beps_tm_2 = Host.hol_term(Comb(Const("@", Tyapp("fun", [Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("x", Tyapp("bool", [])), Const("T", Tyapp("bool", [])))))
  fun munion(s1):
    fun(s2):
      if Host.hol_equal(s1)(PairList [])
      | s2
      | let h1_2 = hd(s1)
