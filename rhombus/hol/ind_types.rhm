      Equal.THENC(conv1)(conv2)(tm)
  let baseconv = Simp.GEN_REWRITE_CONV(I)(PairList.cons(Theorems.UNWIND_THM1, PairList.cons(Theorems.UNWIND_THM2, PairList.cons(Bool.EQT_INTRO(Bool.SPEC_ALL(Theorems.EXISTS_REFL)), PairList.cons(Bool.EQT_INTRO(Equal.GSYM(Bool.SPEC_ALL(Theorems.EXISTS_REFL))), PairList [])))))
  fun UNWIND_CONV_2(tm):
    let [evs, bod] = Basics.strip_exists(tm)
    let eqs = Basics.conjuncts(bod)
    try:
      let eq:
        find(
          fun(tm):
            if Fusion.is_eq(tm)
            | let [l, r] = Fusion.dest_eq(tm)
              ((mem(l)(evs) && Host.hol_not(Basics.free_in(l)(r))) || (mem(r)(evs) && Host.hol_not(Basics.free_in(r)(l))))
            | #false)(eqs)
      let [l, r] = Fusion.dest_eq(eq)
      let v = (if (mem(l)(evs) && Host.hol_not(Basics.free_in(l)(r))) | l | r)
      let cjs_prime = PairList.cons(eq, subtract(eqs)(PairList.cons(eq, PairList [])))
      let n = Host.hol_sub(length(evs))(Host.hol_add(1)(Host.index(v)(Host.rev(evs))))
      let th1 = Canon.CONJ_ACI_RULE(Fusion.mk_eq([bod, Bool.list_mk_conj(cjs_prime)]))
      let th2 = itlist(Drule.MK_EXISTS)(evs)(th1)
      let th3 = Host.funpow(n)(Equal.BINDER_CONV)(PUSH_EXISTS_CONV(baseconv))(Fusion.rand(Fusion.concl(th2)))
      Equal.CONV_RULE(Equal.RAND_CONV(UNWIND_CONV_2))(Fusion.TRANS(th2)(th3))
      ~catch exn:
        match exn
        | Failure(_): Fusion.REFL(tm)
        | exn: Host.hol_raise(exn)
