  let pullback_induction_clause:
    fun(tybijpairs):
      fun(conthms):
        let PRERULE = Simp.GEN_REWRITE_RULE(Host.funpow(3)(Equal.RAND_CONV))(map(Equal.SYM)(conthms))
        let IPRULE = o(Equal.SYM)(Simp.GEN_REWRITE_RULE(I)(map(snd)(tybijpairs)))
        fun(rthm):
          fun(tm):
            let [avs, bimp] = Basics.strip_forall(tm)
            if Basics.is_imp(bimp)
