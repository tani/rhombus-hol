              let conth3 = PRERULE(conth2)
              let asmgen = Fusion.rand(Fusion.rand(Fusion.concl(conth3)))
              let asmquant = Bool.list_mk_forall([snd(Basics.strip_comb(Fusion.rand(asmgen))), asmgen])
              let th2 = Bool.SPEC_ALL(Fusion.ASSUME(asmquant))
              let th3 = Fusion.EQ_MP(Equal.SYM(conth3))(Bool.CONJ(tth)(th2))
              Bool.DISCH(asmquant)(Bool.GENL(avs)(th3))
