      let th2 = Equal.THENC(Equal.THENC(Equal.THENC(INSIDE_EXISTS_CONV(Equal.THENC(Simp.GEN_REWRITE_CONV(I)(PairList.cons(pth_4_2, PairList [])))(Equal.RAND_CONV(BREAK_CONS_CONV))))(UNWIND_CONV))(Simp.GEN_REWRITE_CONV(Equal.DEPTH_CONV)(PairList.cons(Bool.EQT_INTRO(Bool.SPEC_ALL(Theorems.EQ_REFL)), PairList.cons(Theorems.AND_CLAUSES, PairList [])))))(Simp.GEN_REWRITE_CONV(Equal.DEPTH_CONV)(PairList.cons(Theorems.EXISTS_SIMP, PairList [])))(tm_prime)
      let conv_2 = (fun(tm): (if Host.hol_equal(tm)(Equal.lhand(Fusion.concl(th2))) | th2 | Host.hol_apply_unit(fail)))
      Equal.CONV_RULE(Equal.RAND_CONV(Equal.RATOR_CONV(Equal.COMB2_CONV(Equal.RAND_CONV(Equal.BINDER_CONV(conv_2)))(Equal.BINDER_CONV(conv_2)))))(th1)
