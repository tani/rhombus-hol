def INJ_INVERSE2:
  prove(
    [
      @hol|{!P:A->B->C.
         (!x1 y1 x2 y2. (P x1 y1 = P x2 y2) <=> (x1 = x2) /\ (y1 = y2))
         ==> ?X Y. !x y. (X(P x y) = x) /\ (Y(P x y) = y)}|,
      GEN_TAC then_tac DISCH_TAC then_tac \
      EXISTS_TAC(
        @hol|{\z:C. @x:A. ?y:B. P x y = z}|
      ) then_tac \
      EXISTS_TAC(
        @hol|{\z:C. @y:B. ?x:A. P x y = z}|
      ) then_tac \
      REPEAT(GEN_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [BETA_THM]) then_tac \
      CONJ_TAC then_tac \
      MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      GEN_TAC then_tac \
      BETA_TAC then_tac \
      EQ_TAC then_tac \
      STRIP_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      W(o(o(o(o(EXISTS_TAC)(rand))(snd))(dest_exists))(snd)) then_tac \
      REFL_TAC
    ]
  )

def NUMPAIR:
  new_definition(
    @hol|{NUMPAIR x y = (2 EXP x) * (2 * y + 1)}|
  )

def NUMPAIR_INJ_LEMMA:
  prove(
    [
      @hol|{!x1 y1 x2 y2. (NUMPAIR x1 y1 = NUMPAIR x2 y2) ==> (x1 = x2)}|,
      REWRITE_TAC(PairList [NUMPAIR]) then_tac \
      REPEAT(INDUCT_TAC then_tac GEN_TAC) then_tac \
      ASM_REWRITE_TAC(
        PairList [
          EXP,
          GSYM(MULT_ASSOC),
          ARITH,
          EQ_MULT_LCANCEL,
          NOT_SUC,
          GSYM(NOT_SUC),
          SUC_INJ
        ]
      ) then_tac \
      DISCH_THEN(o(MP_TAC)(AP_TERM(@hol|{EVEN}|))) then_tac \
      REWRITE_TAC(PairList [EVEN_MULT, EVEN_ADD, ARITH])
    ]
  )

def NUMPAIR_INJ:
  prove(
    [
      @hol|{!x1 y1 x2 y2. (NUMPAIR x1 y1 = NUMPAIR x2 y2) <=> (x1 = x2) /\ (y1 = y2)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      FIRST_ASSUM(o(SUBST_ALL_TAC)(MATCH_MP(NUMPAIR_INJ_LEMMA))) then_tac \
      POP_ASSUM(MP_TAC) then_tac \
      REWRITE_TAC(PairList [NUMPAIR]) then_tac \
      REWRITE_TAC(PairList [EQ_MULT_LCANCEL, EQ_ADD_RCANCEL, EXP_EQ_0, ARITH])
    ]
  )

def NUMPAIR_DEST = new_specification(PairList ["NUMFST", "NUMSND"])(MATCH_MP(INJ_INVERSE2)(NUMPAIR_INJ))

def NUMSUM:
  new_definition(
    @hol|{NUMSUM b x = if b then SUC(2 * x) else 2 * x}|
  )

def NUMSUM_INJ:
  prove(
    [
      @hol|{!b1 x1 b2 x2. (NUMSUM b1 x1 = NUMSUM b2 x2) <=> (b1 = b2) /\ (x1 = x2)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      POP_ASSUM(o(MP_TAC)(REWRITE_RULE(PairList [NUMSUM]))) then_tac \
      DISCH_THEN(
        fun(th):
          (
            MP_TAC(th) then_tac \
            MP_TAC(AP_TERM(@hol|{EVEN}|)(th))
          )
      ) then_tac \
      REPEAT(COND_CASES_TAC) then_tac \
      REWRITE_TAC(PairList [EVEN, EVEN_DOUBLE]) then_tac \
      REWRITE_TAC(PairList [SUC_INJ, EQ_MULT_LCANCEL, ARITH])
    ]
  )

def NUMSUM_DEST = new_specification(PairList ["NUMLEFT", "NUMRIGHT"])(MATCH_MP(INJ_INVERSE2)(NUMSUM_INJ))

def INJN:
  new_definition(
    @hol|{INJN (m:num) = \(n:num) (a:A). n = m}|
  )

def INJN_INJ:
  prove(
    [
      @hol|{!n1 n2. (INJN n1 :num->A->bool = INJN n2) <=> (n1 = n2)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      POP_ASSUM(
        o(o(MP_TAC)(C(AP_THM)(@hol|{n1:num}|)))(REWRITE_RULE(PairList [INJN]))
      ) then_tac \
      DISCH_THEN(o(MP_TAC)(C(AP_THM)(@hol|{a:A}|))) then_tac \
      REWRITE_TAC(PairList [BETA_THM])
    ]
  )

def INJA:
  new_definition(
    @hol|{INJA (a:A) = \(n:num) b. b = a}|
  )

def INJA_INJ:
  prove(
    [
      @hol|{!a1 a2. (INJA a1 = INJA a2) <=> (a1:A = a2)}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [INJA, FUN_EQ_THM]) then_tac \
      EQ_TAC then_list \
      PairList [
        DISCH_THEN(o(MP_TAC)(SPEC(@hol|{a1:A}|))) then_tac \
        REWRITE_TAC(PairList []),
        DISCH_THEN(SUBST1_TAC) then_tac REWRITE_TAC(PairList [])
      ]
    ]
  )

def INJF:
  new_definition(
    @hol|{INJF (f:num->(num->A->bool)) = \n. f (NUMFST n) (NUMSND n)}|
  )

def INJF_INJ:
  prove(
    [
      @hol|{!f1 f2. (INJF f1 :num->A->bool = INJF f2) <=> (f1 = f2)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{n:num}|,
          @hol|{m:num}|,
          @hol|{a:A}|
        ]
      ) then_tac \
      POP_ASSUM(o(MP_TAC)(REWRITE_RULE(PairList [INJF]))) then_tac \
      DISCH_THEN(
        o(o(MP_TAC)(C(AP_THM)(@hol|{a:A}|)))(
          C(AP_THM)(@hol|{NUMPAIR n m}|)
        )
      ) then_tac \
      REWRITE_TAC(PairList [NUMPAIR_DEST])
    ]
  )

def INJP:
  new_definition(
    @hol|{INJP f1 f2:num->A->bool =
       \n a. if NUMLEFT n then f1 (NUMRIGHT n) a else f2 (NUMRIGHT n) a}|
  )

def INJP_INJ:
  prove(
    [
      @hol|{!(f1:num->A->bool) f1' f2 f2'.
         (INJP f1 f2 = INJP f1' f2') <=> (f1 = f1') /\ (f2 = f2')}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ONCE_REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
      REWRITE_TAC(PairList [AND_FORALL_THM]) then_tac \
      X_GEN_TAC(@hol|{n:num}|) then_tac \
      POP_ASSUM(o(MP_TAC)(REWRITE_RULE(PairList [INJP]))) then_tac \
      DISCH_THEN(
        o(o(MP_TAC)(GEN(@hol|{b:bool}|)))(
          C(AP_THM)(@hol|{NUMSUM b n}|)
        )
      ) then_tac \
      DISCH_THEN(
        fun(th):
          (
            MP_TAC(SPEC(@hol|{T}|)(th)) then_tac \
            MP_TAC(SPEC(@hol|{F}|)(th))
          )
      ) then_tac \
      ASM_SIMP_TAC(PairList [NUMSUM_DEST, ETA_AX])
    ]
  )

def ZCONSTR:
  new_definition(
    @hol|{ZCONSTR c i r :num->A->bool
       = INJP (INJN (SUC c)) (INJP (INJA i) (INJF r))}|
  )

def ZBOT:
  new_definition(
    @hol|{ZBOT = INJP (INJN 0) (@z:num->A->bool. T)}|
  )

def ZCONSTR_ZBOT:
  prove(
    [
      @hol|{!c i r. ~(ZCONSTR c i r :num->A->bool = ZBOT)}|,
      REWRITE_TAC(PairList [ZCONSTR, ZBOT, INJP_INJ, INJN_INJ, NOT_SUC])
    ]
  )

def [ind_types_ZRECSPACE_RULES_v2, ind_types_ZRECSPACE_INDUCT_v2, ZRECSPACE_CASES]:
  new_inductive_definition(
    @hol|{ZRECSPACE (ZBOT:num->A->bool) /\
       (!c i r. (!n. ZRECSPACE (r n)) ==> ZRECSPACE (ZCONSTR c i r))}|
  )

def recspace_tydef = new_basic_type_definition("recspace")(["_mk_rec", "_dest_rec"])(CONJUNCT1(ind_types_ZRECSPACE_RULES_v2))

def BOTTOM:
  new_definition(
    @hol|{BOTTOM = _mk_rec (ZBOT:num->A->bool)}|
  )

def CONSTR:
  new_definition(
    @hol|{CONSTR c i r :(A)recspace
       = _mk_rec (ZCONSTR c i (\n. _dest_rec(r n)))}|
  )

def MK_REC_INJ:
  prove(
    [
      @hol|{!x y. (_mk_rec x :(A)recspace = _mk_rec y)
         ==> (ZRECSPACE x /\ ZRECSPACE y ==> (x = y))}|,
      REPEAT(GEN_TAC) then_tac DISCH_TAC then_tac \
      REWRITE_TAC(PairList [snd(recspace_tydef)]) then_tac \
      DISCH_THEN((fun(th): ONCE_REWRITE_TAC(PairList [GSYM(th)]))) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def DEST_REC_INJ:
  prove(
    [
      @hol|{!x y. (_dest_rec x = _dest_rec y) <=> (x:(A)recspace = y)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      POP_ASSUM(
        o(MP_TAC)(
          AP_TERM(
            @hol|{_mk_rec:(num->A->bool)->(A)recspace}|
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList [fst(recspace_tydef)])
    ]
  )

def CONSTR_BOT:
  prove(
    [
      @hol|{!c i r. ~(CONSTR c i r :(A)recspace = BOTTOM)}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [CONSTR, BOTTOM]) then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(MK_REC_INJ))) then_tac \
      REWRITE_TAC(PairList [ZCONSTR_ZBOT, ind_types_ZRECSPACE_RULES_v2]) then_tac \
      MATCH_MP_TAC(CONJUNCT2(ind_types_ZRECSPACE_RULES_v2)) then_tac \
      REWRITE_TAC(PairList [fst(recspace_tydef), snd(recspace_tydef)])
    ]
  )

def CONSTR_INJ:
  prove(
    [
      @hol|{!c1 i1 r1 c2 i2 r2. (CONSTR c1 i1 r1 :(A)recspace = CONSTR c2 i2 r2) <=>
         (c1 = c2) /\ (i1 = i2) /\ (r1 = r2)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      POP_ASSUM(o(MP_TAC)(REWRITE_RULE(PairList [CONSTR]))) then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(MK_REC_INJ))) then_tac \
      W(o(o(C(SUBGOAL_THEN)(ASSUME_TAC))(funpow(2)(lhand)))(snd)) then_list \
      PairList [
        CONJ_TAC then_tac MATCH_MP_TAC(CONJUNCT2(ind_types_ZRECSPACE_RULES_v2)) then_tac \
        REWRITE_TAC(PairList [fst(recspace_tydef), snd(recspace_tydef)]),
        ASM_REWRITE_TAC(PairList []) then_tac REWRITE_TAC(PairList [ZCONSTR]) then_tac \
        REWRITE_TAC(PairList [INJP_INJ, INJN_INJ, INJF_INJ, INJA_INJ]) then_tac \
        ONCE_REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
        BETA_TAC then_tac \
        REWRITE_TAC(PairList [SUC_INJ, DEST_REC_INJ])
      ]
    ]
  )

def CONSTR_IND:
  prove(
    [
      @hol|{!P. P(BOTTOM) /\
         (!c i r. (!n. P(r n)) ==> P(CONSTR c i r))
         ==> !x:(A)recspace. P(x)}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        SPEC(
          @hol|{\z:num->A->bool. ZRECSPACE(z) /\ P(_mk_rec z)}|
        )(ind_types_ZRECSPACE_INDUCT_v2)
      ) then_tac \
      BETA_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ind_types_ZRECSPACE_RULES_v2, GSYM(BOTTOM)]) then_tac \
      W(o(o(C(SUBGOAL_THEN)(ASSUME_TAC))(funpow(2)(lhand)))(snd)) then_list \
      PairList [
        REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [FORALL_AND_THM]) then_tac \
        REPEAT(STRIP_TAC) then_list \
        PairList [
          MATCH_MP_TAC(CONJUNCT2(ind_types_ZRECSPACE_RULES_v2)) then_tac \
          ASM_REWRITE_TAC(PairList []),
          FIRST_ASSUM(ANTE_RES_THEN(MP_TAC)) then_tac \
          REWRITE_TAC(PairList [CONSTR]) then_tac \
          RULE_ASSUM_TAC(REWRITE_RULE(PairList [snd(recspace_tydef)])) then_tac \
          ASM_SIMP_TAC(PairList [ETA_AX])
        ],
        ASM_REWRITE_TAC(PairList []) then_tac \
        DISCH_THEN(
          o(MP_TAC)(
            SPEC(
              @hol|{_dest_rec (x:(A)recspace)}|
            )
          )
        ) then_tac \
        REWRITE_TAC(PairList [fst(recspace_tydef)]) then_tac \
        REWRITE_TAC(
          PairList [
            ITAUT(
              @hol|{(a ==> a /\ b) <=> (a ==> b)}|
            )
          ]
        ) then_tac \
        DISCH_THEN(MATCH_MP_TAC) then_tac \
        REWRITE_TAC(PairList [fst(recspace_tydef), snd(recspace_tydef)])
      ]
    ]
  )

def CONSTR_REC:
  prove(
    [
      @hol|{!Fn:num->A->(num->(A)recspace)->(num->B)->B.
         ?f. (!c i r. f (CONSTR c i r) = Fn c i r (\n. f (r n)))}|,
      REPEAT(STRIP_TAC) then_tac \
      o(MP_TAC)(prove_inductive_relations_exist)(
        @hol|{(Z:(A)recspace->B->bool) BOTTOM b /\
           (!c i r y. (!n. Z (r n) (y n)) ==> Z (CONSTR c i r) (Fn c i r y))}|
      ) then_tac \
      DISCH_THEN(CHOOSE_THEN(CONJUNCTS_THEN2(STRIP_ASSUME_TAC)(MP_TAC))) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(o(ASSUME_TAC)(GSYM))) then_tac \
      SUBGOAL_THEN(
        @hol|{!x. ?!y. (Z:(A)recspace->B->bool) x y}|
      )(MP_TAC) then_list \
      PairList [
        W(o(o(MP_TAC)(PART_MATCH(rand)(CONSTR_IND)))(snd)) then_tac \
        DISCH_THEN(MATCH_MP_TAC) then_tac \
        CONJ_TAC then_tac \
        REPEAT(GEN_TAC) then_list \
        PairList [
          FIRST_ASSUM((fun(t): GEN_REWRITE_TAC(BINDER_CONV)(PairList [GSYM(t)]))) then_tac \
          REWRITE_TAC(PairList [GSYM(CONSTR_BOT), EXISTS_UNIQUE_REFL]),
          DISCH_THEN(
            o(MP_TAC)(REWRITE_RULE(PairList [EXISTS_UNIQUE_THM, FORALL_AND_THM]))
          ) then_tac \
          DISCH_THEN(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC)) then_tac \
          DISCH_THEN(o(MP_TAC)(REWRITE_RULE(PairList [SKOLEM_THM]))) then_tac \
          DISCH_THEN(X_CHOOSE_THEN(@hol|{y:num->B}|)(ASSUME_TAC)) then_tac \
          REWRITE_TAC(PairList [EXISTS_UNIQUE_THM]) then_tac \
          FIRST_ASSUM((fun(th): CHANGED_TAC(ONCE_REWRITE_TAC(PairList [GSYM(th)])))) then_tac \
          CONJ_TAC then_list \
          PairList [
            EXISTS_TAC(
              @hol|{(Fn:num->A->(num->(A)recspace)->(num->B)->B) c i r y}|
            ) then_tac \
            REWRITE_TAC(PairList [CONSTR_BOT, CONSTR_INJ, GSYM(CONJ_ASSOC)]) then_tac \
            REWRITE_TAC(PairList [UNWIND_THM1, RIGHT_EXISTS_AND_THM]) then_tac \
            EXISTS_TAC(@hol|{y:num->B}|) then_tac \
            ASM_REWRITE_TAC(PairList []),
            REWRITE_TAC(PairList [CONSTR_BOT, CONSTR_INJ, GSYM(CONJ_ASSOC)]) then_tac \
            REWRITE_TAC(PairList [UNWIND_THM1, RIGHT_EXISTS_AND_THM]) then_tac \
            REPEAT(STRIP_TAC) then_tac \
            ASM_REWRITE_TAC(PairList []) then_tac \
            REPEAT(AP_TERM_TAC) then_tac \
            ONCE_REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
            X_GEN_TAC(@hol|{w:num}|) then_tac \
            FIRST_ASSUM(MATCH_MP_TAC) then_tac \
            EXISTS_TAC(@hol|{w:num}|) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ]
        ],
        REWRITE_TAC(PairList [UNIQUE_SKOLEM_ALT]) then_tac \
        DISCH_THEN(
          X_CHOOSE_THEN(@hol|{fn:(A)recspace->B}|)(o(ASSUME_TAC)(GSYM))
        ) then_tac \
        EXISTS_TAC(@hol|{fn:(A)recspace->B}|) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        REPEAT(GEN_TAC) then_tac \
        FIRST_ASSUM(MATCH_MP_TAC) then_tac \
        GEN_TAC then_tac \
        FIRST_ASSUM((fun(th): GEN_REWRITE_TAC(I)(PairList [GSYM(th)]))) then_tac \
        REWRITE_TAC(PairList [BETA_THM])
      ]
    ]
  )

def FCONS:
  new_recursive_definition(num_RECURSION)(
    @hol|{(!a f. FCONS (a:A) f 0 = a) /\
       (!a f n. FCONS (a:A) f (SUC n) = f n)}|
  )

def FCONS_UNDO:
  prove(
    [
      @hol|{!f:num->A. f = FCONS (f 0) (f o SUC)}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [FCONS, o_THM])
    ]
  )

def FNIL:
  new_definition(
    @hol|{FNIL (n:num) = @x:A. T}|
  )

def ind_types_define_type_raw:
  let zero_2 = @hol|{0}|
  let suc_2 = @hol|{SUC}|
  let sucivate = (fun(n): funpow(n)(curry(mk_comb)(suc_2))(zero_2))
  let SCRUB_EQUATION:
    fun(eq):
      fun([th, insts]):
        let eq_prime = itlist(subst)(map((fun(t): PairList [t]))(insts))(eq)
        let [l, r] = dest_eq(eq_prime)
        [
          MP(INST(PairList [[r, l]])(DISCH(eq_prime)(th)))(REFL(r)),
          PairList [[r, l], & insts]
        ]
  let t_tm_2 = @hol|{T}|
  let n_tm_2 = @hol|{n:num}|
  let beps_tm_2 = @hol|{@x:bool. T}|
  // Recursive union needs the local definition before its first use.
  fun munion(s1):
    fun(s2):
      if (s1 == (PairList []))
      | s2
      | let h1_2 = hd(s1)
        let s1_prime_2 = tl(s1)
        try:
          let [_, s2_prime] = remove((fun(h2): (h2 == h1_2)))(s2)
          PairList [h1_2, & munion(s1_prime_2)(s2_prime)]
          ~catch exn:
            match exn
            | Failure(_): PairList [h1_2, & munion(s1_prime_2)(s2)]
            | exn: (throw exn)
  let justify_inductive_type_model:
    fun(hol_def):
      let [newtys, rights] = unzip(hol_def)
      let tyargls = itlist(o(append)(map(snd)))(rights)(PairList [])
      let alltys = itlist(o(munion)(C(subtract)(newtys)))(tyargls)(PairList [])
      let epstms = map((fun(ty): mk_select([mk_var(["v", ty]), t_tm_2])))(alltys)
      let pty:
        try:
          end_itlist(fun(ty1): fun(ty2): mk_type(["prod", PairList [ty1, ty2]]))(alltys)
          ~catch exn:
            match exn
            | Failure(_): bool_ty
            | exn: (throw exn)
      let recty = mk_type(["recspace", PairList [pty]])
      let constr = mk_const(["CONSTR", PairList [[pty, aty]]])
      let fcons = mk_const(["FCONS", PairList [[recty, aty]]])
      let bot = mk_const(["BOTTOM", PairList [[pty, aty]]])
      let bottail = mk_abs([n_tm_2, bot])
      let mk_constructor:
        fun(n):
          fun([cname, cargs]):
            let ttys = map((fun(ty): (if mem(ty)(newtys) | recty | ty)))(cargs)
            let args = make_args("a")(PairList [])(ttys)
            let [rargs, iargs] = partition((fun(t): (type_of(t) == recty)))(args)
            // Recursive injector construction needs the local definition before its first use.
            fun mk_injector(epstms):
              fun(alltys):
                fun(iargs):
                  if (alltys == (PairList []))
                  | PairList []
                  | let ty = hd(alltys)
                    try:
                      let [a_2, iargs_prime] = remove((fun(t): (type_of(t) == ty)))(iargs)
                      PairList [a_2, & mk_injector(tl(epstms))(tl(alltys))(iargs_prime)]
                      ~catch exn:
                        match exn
                        | Failure(_): PairList [hd(epstms), & mk_injector(tl(epstms))(tl(alltys))(iargs)]
                        | exn: (throw exn)
            let iarg:
              try:
                end_itlist(curry(mk_pair))(mk_injector(epstms)(alltys)(iargs))
                ~catch exn:
                  match exn
                  | Failure(_): beps_tm_2
                  | exn: (throw exn)
            let rarg = itlist(mk_binop(fcons))(rargs)(bottail)
            let conty = itlist(mk_fun_ty)(map(type_of)(args))(recty)
            let condef = list_mk_comb([constr, PairList [sucivate(n), iarg, rarg]])
            mk_eq([mk_var([cname, conty]), list_mk_abs([args, condef])])
      // Recursive constructor construction needs the local definition before its first use.
      fun mk_constructors(n): fun(rights): (if (rights == (PairList [])) | PairList [] | PairList [mk_constructor(n)(hd(rights)), & mk_constructors((n + 1))(tl(rights))])
      let condefs = mk_constructors(0)(itlist(append)(rights)(PairList []))
      let conths = map(ASSUME)(condefs)
      let predty = mk_fun_ty(recty)(bool_ty)
      let edefs = itlist(fun([x, l]): fun(acc): append(map((fun(t): [x, t]))(l))(acc))(hol_def)(PairList [])
      let idefs = map2(fun([r, [_, atys]]): fun(hol_def): [[r, atys], hol_def])(edefs)(condefs)
      let mk_rule:
        fun([[r, a], condef]):
          let [left, right] = dest_eq(condef)
          let [args, bod] = strip_abs(right)
          let lapp = list_mk_comb([left, args])
          let conds:
            itlist2(
              fun(arg): fun(argty): fun(sofar): (if mem(argty)(newtys) | PairList [mk_comb([mk_var([dest_vartype(argty), predty]), arg]), & sofar] | sofar)
            )(args)(a)(PairList [])
          let conc = mk_comb([mk_var([dest_vartype(r), predty]), lapp])
          let rule = (if (conds == (PairList [])) | conc | mk_imp([list_mk_conj(conds), conc]))
          list_mk_forall([args, rule])
      let rules = list_mk_conj(map(mk_rule)(idefs))
      let th0 = derive_nonschematic_inductive_relations(rules)
      let th1 = prove_monotonicity_hyps(th0)
      let [th2a, th2bc] = CONJ_PAIR(th1)
      let th2b = CONJUNCT1(th2bc)
      [conths, th2a, th2b]
  let prove_model_inhabitation:
    fun(rth):
      let srules = map(SPEC_ALL)(CONJUNCTS(rth))
      let [imps, bases] = partition(o(is_imp)(concl))(srules)
      let concs = append(map(concl)(bases))(map(o(rand)(concl))(imps))
      let preds = setify(map(repeat(rator))(concs))
      // Recursive inhabitation search needs the local definition before its first use.
      fun exhaust_inhabitations(ths):
        fun(sofar):
          let dunnit = setify(map(o(o(fst)(strip_comb))(concl))(sofar))
          let useful = filter((fun(th): !mem(fst(strip_comb(rand(concl(th)))))(dunnit)))(ths)
          if (useful == (PairList []))
          | sofar
          | let follow_horn:
              fun(thm):
                let preds = map(o(fst)(strip_comb))(conjuncts(lhand(concl(thm))))
                let asms = map((fun(p): find((fun(th): (fst(strip_comb(concl(th))) == p)))(sofar)))(preds)
                MATCH_MP(thm)(end_itlist(CONJ)(asms))
            let newth = tryfind(follow_horn)(useful)
            exhaust_inhabitations(ths)(PairList [newth, & sofar])
      let ithms = exhaust_inhabitations(imps)(bases)
      let exths = map((fun(p): find((fun(th): (fst(strip_comb(concl(th))) == p)))(ithms)))(preds)
      exths
  let define_inductive_type:
    fun(cdefs):
      fun(exth):
        let extm = concl(exth)
        let epred = fst(strip_comb(extm))
        let ename = fst(dest_var(epred))
        let th1 = ASSUME(find((fun(eq): (lhand(eq) == epred)))(hyp(exth)))
        let th2 = TRANS(th1)(SUBS_CONV(cdefs)(rand(concl(th1))))
        let th3 = EQ_MP(AP_THM(th2)(rand(extm)))(exth)
        let [th4, _] = itlist(SCRUB_EQUATION)(hyp(th3))([th3, PairList []])
        let mkname_2 = ("_mk_" +& ename)
        let destname_2 = ("_dest_" +& ename)
        let [bij1, bij2] = new_basic_type_definition(ename)([mkname_2, destname_2])(th4)
        let bij2a = AP_THM(th2)(rand(rand(concl(bij2))))
        let bij2b = TRANS(bij2a)(bij2)
        [bij1, bij2b]
  let define_inductive_type_constructor:
    fun(defs):
      fun(consindex):
        fun(th):
          let [avs, bod] = strip_forall(concl(th))
          let [asms, conc] = (if is_imp(bod) | [conjuncts(lhand(bod)), rand(bod)] | [PairList [], bod])
          let asmlist = map(dest_comb)(asms)
          let [cpred, cterm] = dest_comb(conc)
          let [oldcon, oldargs] = strip_comb(cterm)
          let modify_arg:
            fun(v):
              try:
                let dest = snd(assoc(rev_assoc(v)(asmlist))(consindex))
                let ty_prime = hd(snd(dest_type(type_of(dest))))
                let v_prime = mk_var([fst(dest_var(v)), ty_prime])
                [mk_comb([dest, v_prime]), v_prime]
                ~catch exn:
                  match exn
                  | Failure(_): [v, v]
                  | exn: (throw exn)
          let [newrights, newargs] = unzip(map(modify_arg)(oldargs))
          let retmk = fst(assoc(cpred)(consindex))
          let defbod = mk_comb([retmk, list_mk_comb([oldcon, newrights])])
          let defrt = list_mk_abs([newargs, defbod])
          let expth = find((fun(th): (lhand(concl(th)) == oldcon)))(defs)
          let rexpth = SUBS_CONV(PairList [expth])(defrt)
          let deflf = mk_var([fst(dest_var(oldcon)), type_of(defrt)])
          let defth = new_definition(mk_eq([deflf, rand(concl(rexpth))]))
          TRANS(defth)(SYM(rexpth))
  let instantiate_induction_theorem:
    fun(consindex):
      fun(ith):
        let [avs, bod] = strip_forall(concl(ith))
        let corlist:
          map(
            o(
              o(o(F_F(repeat(rator))(repeat(rator)))(dest_imp))(body)
            )(rand)
          )(conjuncts(rand(bod)))
        let consindex_prime:
          map(
            fun(v):
              let w = rev_assoc(v)(corlist)
              [w, assoc(w)(consindex)]
          )(avs)
        let recty = o(o(o(o(o(o(hd)(snd))(dest_type))(type_of))(fst))(snd))(hd)(consindex)
        let newtys = map(o(o(o(o(o(hd)(snd))(dest_type))(type_of))(snd))(snd))(consindex_prime)
        let ptypes = map(C(mk_fun_ty)(bool_ty))(newtys)
        let preds = make_args("P")(PairList [])(ptypes)
        let args = make_args("x")(PairList [])(map(K(recty))(preds))
        let lambs:
          map2(
            fun([r, [m, d]]): fun([p, a]): mk_abs([a, mk_conj([mk_comb([r, a]), mk_comb([p, mk_comb([m, a])])])])
          )(consindex_prime)(zip(preds)(args))
        SPECL(lambs)(ith)
  let pullback_induction_clause:
    fun(tybijpairs):
      fun(conthms):
        fun(rthm):
          fun(tm):
            let PRERULE = GEN_REWRITE_RULE(funpow(3)(RAND_CONV))(map(SYM)(conthms))
            let IPRULE = o(SYM)(GEN_REWRITE_RULE(I)(map(snd)(tybijpairs)))
            let [avs, bimp] = strip_forall(tm)
            if is_imp(bimp)
            | let [ant, con] = dest_imp(bimp)
              let ths = map(CONV_RULE(BETA_CONV))(CONJUNCTS(ASSUME(ant)))
              let [tths, pths] = unzip(map(CONJ_PAIR)(ths))
              let tth = MATCH_MP(SPEC_ALL(rthm))(end_itlist(CONJ)(tths))
              let mths = map(IPRULE)(PairList [tth, & tths])
              let conth1 = BETA_CONV(con)
              let contm1 = rand(concl(conth1))
              let conth2 = TRANS(conth1)(AP_TERM(rator(contm1))(SUBS_CONV(tl(mths))(rand(contm1))))
              let conth3 = PRERULE(conth2)
              let lctms = map(concl)(pths)
              let asmin = mk_imp([list_mk_conj(lctms), rand(rand(concl(conth3)))])
              let argsin = map(rand)(conjuncts(lhand(asmin)))
              let argsgen = map((fun(tm): mk_var([fst(dest_var(rand(tm))), type_of(tm)])))(argsin)
              let asmgen = subst(zip(argsgen)(argsin))(asmin)
              let asmquant = list_mk_forall([snd(strip_comb(rand(rand(asmgen)))), asmgen])
              let th1 = INST(zip(argsin)(argsgen))(SPEC_ALL(ASSUME(asmquant)))
              let th2 = MP(th1)(end_itlist(CONJ)(pths))
              let th3 = EQ_MP(SYM(conth3))(CONJ(tth)(th2))
              DISCH(asmquant)(GENL(avs)(DISCH(ant)(th3)))
            | let con = bimp
              let conth2 = BETA_CONV(con)
              let tth = PART_MATCH(I)(rthm)(lhand(rand(concl(conth2))))
              let conth3 = PRERULE(conth2)
              let asmgen = rand(rand(concl(conth3)))
              let asmquant = list_mk_forall([snd(strip_comb(rand(asmgen))), asmgen])
              let th2 = SPEC_ALL(ASSUME(asmquant))
              let th3 = EQ_MP(SYM(conth3))(CONJ(tth)(th2))
              DISCH(asmquant)(GENL(avs)(th3))
  let finish_induction_conclusion:
    fun(consindex):
      fun(tybijpairs):
        fun(th):
          let [tybij1, tybij2] = unzip(tybijpairs)
          let PRERULE_2 = o(GEN_REWRITE_RULE(o(o(LAND_CONV)(LAND_CONV))(RAND_CONV))(tybij1))(GEN_REWRITE_RULE(LAND_CONV)(tybij2))
          let FINRULE_2 = GEN_REWRITE_RULE(RAND_CONV)(tybij1)
          let [av, bimp] = dest_forall(concl(th))
          let pv = lhand(body(rator(rand(bimp))))
          let [p, v] = dest_comb(pv)
          let [mk, dest] = assoc(p)(consindex)
          let ty = hd(snd(dest_type(type_of(dest))))
          let v_prime = mk_var([fst(dest_var(v)), ty])
          let dv = mk_comb([dest, v_prime])
          let th1 = PRERULE_2(SPEC(dv)(th))
          let th2 = MP(th1)(REFL(rand(lhand(concl(th1)))))
          let th3 = CONV_RULE(BETA_CONV)(th2)
          GEN(v_prime)(FINRULE_2(CONJUNCT2(th3)))

  let derive_induction_theorem:
    fun(consindex):
      fun(tybijpairs):
        fun(conthms):
          fun(iith):
            fun(rth):
              let bths = map2(pullback_induction_clause(tybijpairs)(conthms))(CONJUNCTS(rth))(conjuncts(lhand(concl(iith))))
              let asm = list_mk_conj(map(o(lhand)(concl))(bths))
              let ths = map2(MP)(bths)(CONJUNCTS(ASSUME(asm)))
              let th1 = MP(iith)(end_itlist(CONJ)(ths))
              let th2 = end_itlist(CONJ)(map(finish_induction_conclusion(consindex)(tybijpairs))(CONJUNCTS(th1)))
              let th3 = DISCH(asm)(th2)
              let preds = map(o(o(rator)(body))(rand))(conjuncts(rand(concl(th3))))
              let th4 = GENL(preds)(th3)
              let pasms = filter(o(C(mem)(map(fst)(consindex)))(lhand))(hyp(th4))
              let th5 = itlist(DISCH)(pasms)(th4)
              let [th6, _] = itlist(SCRUB_EQUATION)(hyp(th5))([th5, PairList []])
              let th7 = UNDISCH_ALL(th6)
              fst(itlist(SCRUB_EQUATION)(hyp(th7))([th7, PairList []]))
  let create_recursive_functions:
    fun(tybijpairs):
      fun(consindex):
        fun(conthms):
          fun(rth):
            let domtys = map(o(o(o(o(o(hd)(snd))(dest_type))(type_of))(snd))(snd))(consindex)
            let recty = o(o(o(o(o(o(hd)(snd))(dest_type))(type_of))(fst))(snd))(hd)(consindex)
            let ranty = mk_vartype("Z")
            let fn_2 = mk_var(["fn", mk_fun_ty(recty)(ranty)])
            let fns_2 = make_args("fn")(PairList [])(map(C(mk_fun_ty)(ranty))(domtys))
            let args = make_args("a")(PairList [])(domtys)
            let rights:
              map2(
                fun([_, [_, d]]): fun(a): mk_abs([a, mk_comb([fn_2, mk_comb([d, a])])])
              )(consindex)(args)
            let eqs = map2(curry(mk_eq))(fns_2)(rights)
            let fdefs = map(ASSUME)(eqs)
            let fxths1 = map((fun(th1): tryfind((fun(th2): MK_COMB([th2, th1])))(fdefs)))(conthms)
            let fxths2 = map((fun(th): TRANS(th)(BETA_CONV(rand(concl(th))))))(fxths1)
            let mk_tybijcons:
              fun([th1, th2]):
                let th3:
                  INST(
                    PairList [
                      [rand(lhand(concl(th1))), rand(lhand(concl(th2)))]
                    ]
                  )(th2)
                let th4 = AP_TERM(rator(lhand(rand(concl(th2)))))(th1)
                EQ_MP(SYM(th3))(th4)
            let SCONV_2 = GEN_REWRITE_CONV(I)(map(mk_tybijcons)(tybijpairs))
            let ERULE_2 = GEN_REWRITE_RULE(I)(map(snd)(tybijpairs))
            let simplify_fxthm:
              fun(rthm):
                fun(fxth):
                  let pat = funpow(4)(rand)(concl(fxth))
                  if is_imp(repeat(o(snd)(dest_forall))(concl(rthm)))
                  | let th1 = PART_MATCH(o(rand)(rand))(rthm)(pat)
                    let tms1 = conjuncts(lhand(concl(th1)))
                    let ths2 = map((fun(t): EQ_MP(SYM(SCONV_2(t)))(TRUTH)))(tms1)
                    ERULE_2(MP(th1)(end_itlist(CONJ)(ths2)))
                  | ERULE_2(PART_MATCH(rand)(rthm)(pat))
            let fxths3 = map2(simplify_fxthm)(CONJUNCTS(rth))(fxths2)
            let fxths4 = map2((fun(th1): o(TRANS(th1))(AP_TERM(fn_2))))(fxths2)(fxths3)
            let cleanup_fxthm:
              fun(cth):
                fun(fxth):
                  let tms = snd(strip_comb(rand(rand(concl(fxth)))))
                  let kth = RIGHT_BETAS(tms)(ASSUME(hd(hyp(cth))))
                  TRANS(fxth)(AP_TERM(fn_2)(kth))
            let fxth5 = end_itlist(CONJ)(map2(cleanup_fxthm)(conthms)(fxths4))
            let pasms = filter(o(C(mem)(map(fst)(consindex)))(lhand))(hyp(fxth5))
            let fxth6 = itlist(DISCH)(pasms)(fxth5)
            let [fxth7, _] = itlist(SCRUB_EQUATION)(itlist(o(union)(hyp))(conthms)(PairList []))([fxth6, PairList []])
            let fxth8 = UNDISCH_ALL(fxth7)
            fst(itlist(SCRUB_EQUATION)(subtract(hyp(fxth8))(eqs))([fxth8, PairList []]))
  let s = @hol|{s:num->Z}|
  let zty = @hol|{:Z}|
  let numty = @hol|{:num}|
  // Recursive argument extraction needs the local definition before its first use.
  fun extract_arg(tup):
    fun(v):
      if (v == tup)
      | REFL(tup)
      | let [t1, t2] = dest_pair(tup)
        let PAIR_th = ISPECL(PairList [t1, t2])((if free_in(v)(t1) | FST | SND))
        let tup_prime = rand(concl(PAIR_th))
        if (tup_prime == v)
        | PAIR_th
        | let th = extract_arg(rand(concl(PAIR_th)))(v)
          SUBS(PairList [SYM(PAIR_th)])(th)
  let create_recursion_iso_constructor:
    fun(consindex):
      fun(cth):
        let recty = hd(snd(dest_type(type_of(fst(hd(consindex))))))
        let domty = hd(snd(dest_type(recty)))
        let i_2 = mk_var(["i", domty])
        let r_2 = mk_var(["r", mk_fun_ty(numty)(recty)])
        let mks = map(o(fst)(snd))(consindex)
        let mkindex = map((fun(t): [hd(tl(snd(dest_type(type_of(t))))), t]))(mks)
        let artms = snd(strip_comb(rand(rand(concl(cth)))))
        let artys = mapfilter(o(type_of)(rand))(artms)
        let [args, bod] = strip_abs(rand(hd(hyp(cth))))
        let [ccitm, rtm] = dest_comb(bod)
        let [cctm, itm] = dest_comb(ccitm)
        let [rargs, iargs] = partition(C(free_in)(rtm))(args)
        let xths = map(extract_arg(itm))(iargs)
        let cargs_prime = map(o(o(subst(PairList [[i_2, itm]]))(lhand))(concl))(xths)
        let indices = map(sucivate)(range(0)((length(rargs) - 1)))
        let rindexed = map(curry(mk_comb)(r_2))(indices)
        let rargs_prime = map2(fun(a): fun(rx): mk_comb([assoc(a)(mkindex), rx]))(artys)(rindexed)
        let sargs_prime = map(curry(mk_comb)(s))(indices)
        let allargs = append(cargs_prime)(append(rargs_prime)(sargs_prime))
        let funty = itlist(o(mk_fun_ty)(type_of))(allargs)(zty)
        let funname = (fst(dest_const(repeat(rator)(lhand(concl(cth))))) +& "'")
        let funarg = mk_var([funname, funty])
        list_mk_abs([PairList [i_2, r_2, s], list_mk_comb([funarg, allargs])])
  let CCONV = funpow(3)(RATOR_CONV)(REPEATC(GEN_REWRITE_CONV(I)(PairList [FCONS])))
  let derive_recursion_theorem:
    fun(tybijpairs):
      fun(consindex):
        fun(conthms):
          fun(rath):
            let isocons = map(create_recursion_iso_constructor(consindex))(conthms)
            let ty = type_of(hd(isocons))
            let fcons_2 = mk_const(["FCONS", PairList [[ty, aty]]])
            let fnil_2 = mk_const(["FNIL", PairList [[ty, aty]]])
            let bigfun = itlist(mk_binop(fcons_2))(isocons)(fnil_2)
            let eth = ISPEC(bigfun)(CONSTR_REC)
            let fn = rator(rand(hd(conjuncts(concl(rath)))))
            let [v, bod] = dest_abs(rand(concl(eth)))
            let betm = vsubst(PairList [[fn, v]])(bod)
            let LCONV = REWR_CONV(ASSUME(betm))
            let fnths = map((fun(t): RIGHT_BETAS(PairList [bndvar(rand(t))])(ASSUME(t))))(hyp(rath))
            let SIMPER:
              PURE_REWRITE_RULE(
                append(map(SYM)(fnths))(append(map(fst)(tybijpairs))(PairList [FST, SND, FCONS, BETA_THM]))
              )
            let hackdown_rath:
              fun(th):
                let [ltm, rtm] = dest_eq(concl(th))
                let wargs = snd(strip_comb(rand(ltm)))
                let th1 = TRANS(th)(LCONV(rtm))
                let th2 = TRANS(th1)(CCONV(rand(concl(th1))))
                let th3 = TRANS(th2)(funpow(2)(RATOR_CONV)(BETA_CONV)(rand(concl(th2))))
                let th4 = TRANS(th3)(RATOR_CONV(BETA_CONV)(rand(concl(th3))))
                let th5 = TRANS(th4)(BETA_CONV(rand(concl(th4))))
                GENL(wargs)(SIMPER(th5))
            let rthm = end_itlist(CONJ)(map(hackdown_rath)(CONJUNCTS(rath)))
            let unseqs = filter(is_eq)(hyp(rthm))
            let tys = map(o(o(o(o(o(hd)(snd))(dest_type))(type_of))(snd))(snd))(consindex)
            let seqs:
              map(
                (fun(ty): find((fun(t): (hd(snd(dest_type(type_of(lhand(t))))) == ty)))(unseqs))
              )(tys)
            let rethm = itlist(EXISTS_EQUATION)(seqs)(rthm)
            let fethm = CHOOSE([fn, eth])(rethm)
            let pcons = map(o(o(repeat(rator))(rand))(repeat(o(snd)(dest_forall))))(conjuncts(concl(rthm)))
            GENL(pcons)(fethm)
  fun(hol_def):
    let [defs, rth, ith] = justify_inductive_type_model(hol_def)
    let neths = prove_model_inhabitation(rth)
    let tybijpairs = map(define_inductive_type(defs))(neths)
    let preds = map(o(repeat(rator))(concl))(neths)
    let mkdests:
      map(
        fun([th, _]):
          let tm = lhand(concl(th))
          [rator(tm), rator(rand(tm))]
      )(tybijpairs)
    let consindex = zip(preds)(mkdests)
    let condefs = map(define_inductive_type_constructor(defs)(consindex))(CONJUNCTS(rth))
    let conthms:
      map(
        fun(th):
          let args = fst(strip_abs(rand(concl(th))))
          RIGHT_BETAS(args)(th)
      )(condefs)
    let iith = instantiate_induction_theorem(consindex)(ith)
    let fth = derive_induction_theorem(consindex)(tybijpairs)(conthms)(iith)(rth)
    let rath = create_recursive_functions(tybijpairs)(consindex)(conthms)(rth)
    let kth = derive_recursion_theorem(tybijpairs)(consindex)(conthms)(rath)
    [fth, kth]

def parse_inductive_type_specification:
  let parse_type_loc:
    fun(src):
      let [pty, rst] = parse_pretype(src)
      [TypeInference.type_of_pretype(pty), rst]
  let parse_type_conapp:
    fun(src):
      let [cn, sps]:
        match src
        | PairList [Ident(cn), & sps]: [cn, sps]
        | _: fail()
      let [tys, rst] = many(parse_type_loc)(sps)
      [[cn, tys], rst]
  let parse_type_clause:
    fun(src):
      let [tn, sps]:
        match src
        | PairList [Ident(tn), & sps]: [tn, sps]
        | _: fail()
      let [tys, rst]:
        (a(Ident("=")) ++ listof(parse_type_conapp)(a(Resword("|")))(
                                   "type definition clauses")
           >> snd)(sps)
      [[mk_vartype(tn), tys], rst]
  let parse_type_definition:
    listof(parse_type_clause)(a(Resword(";")))("type definition")
  fun(s):
    let [spec, rst] = o(o(parse_type_definition)(lex))(explode)(s)
    if rst == PairList [] | spec | failwith("parse_inductive_type_specification: junk after def")

def [ind_types_sum_INDUCT_v2, sum_RECURSION] = ind_types_define_type_raw(parse_inductive_type_specification("sum = INL A | INR B"))

def OUTL:
  new_recursive_definition(sum_RECURSION)(
    @hol|{OUTL (INL x :A+B) = x}|
  )

def OUTR:
  new_recursive_definition(sum_RECURSION)(
    @hol|{OUTR (INR y :A+B) = y}|
  )

def ind_types_define_type_raw_v2:
  let ELIM_OUTCOMBS = GEN_REWRITE_RULE(TOP_DEPTH_CONV)(PairList [OUTL, OUTR])
  fun mk_sum(tys):
    let k = length(tys)
    if (k == 1)
    | hd(tys)
    | let [tys1, tys2] = chop_list((k div 2))(tys)
      mk_type(["sum", PairList [mk_sum(tys1), mk_sum(tys2)]])
  fun mk_inls_2(ty):
    if is_vartype(ty)
    | PairList [mk_var(["x", ty])]
    | let [_, PairList [ty1, & PairList [ty2, & PairList []]]] = dest_type(ty)
      let inls1_2 = mk_inls_2(ty1)
      let inls2_2 = mk_inls_2(ty2)
      let inl_2 = mk_const(["INL", PairList [[ty1, aty], [ty2, bty]]])
      let inr_2 = mk_const(["INR", PairList [[ty1, aty], [ty2, bty]]])
      append(map(curry(mk_comb)(inl_2))(inls1_2))(map(curry(mk_comb)(inr_2))(inls2_2))
  let mk_inls:
    fun(ty):
      let bods = mk_inls_2(ty)
      map((fun(t): mk_abs([find_term(is_var)(t), t])))(bods)
  // Recursive injection construction needs the local definition before its first use.
  fun mk_inls_3(sof):
    fun(ty):
      if is_vartype(ty)
      | PairList [sof]
      | let [_, PairList [ty1, & PairList [ty2, & PairList []]]] = dest_type(ty)
        let outl_2 = mk_const(["OUTL", PairList [[ty1, aty], [ty2, bty]]])
        let outr_2 = mk_const(["OUTR", PairList [[ty1, aty], [ty2, bty]]])
        append(mk_inls_3(mk_comb([outl_2, sof]))(ty1))(mk_inls_3(mk_comb([outr_2, sof]))(ty2))
  let mk_outls:
    fun(ty):
      let x = mk_var(["x", ty])
      map(curry(mk_abs)(x))(mk_inls_3(x)(ty))
  let mk_newfun:
    fun(fn):
      fun(outl):
        let [s, ty] = dest_var(fn)
        let dty = hd(snd(dest_type(ty)))
        let x = mk_var(["x", dty])
        let [y, bod] = dest_abs(outl)
        let r = mk_abs([x, vsubst(PairList [[mk_comb([fn, x]), y]])(bod)])
        let l = mk_var([s, type_of(r)])
        let th1 = ASSUME(mk_eq([l, r]))
        RIGHT_BETAS(PairList [x])(th1)
  let generalize_recursion_theorem:
    fun(th):
      let [avs, ebod] = strip_forall(concl(th))
      let [evs, bod] = strip_exists(ebod)
      let n = length(evs)
      if (n == 1)
      | th
      | let tys = map((fun(i): mk_vartype(("Z" +& to_string(i)))))(range(0)((n - 1)))
        let sty = mk_sum(tys)
        let inls_2 = mk_inls(sty)
        let outls_2 = mk_outls(sty)
        let zty = type_of(rand(snd(strip_forall(hd(conjuncts(bod))))))
        let ith = INST_TYPE(PairList [[sty, zty]])(th)
        let [avs, ebod] = strip_forall(concl(ith))
        let [evs, bod] = strip_exists(ebod)
        let fns_prime = map2(mk_newfun)(evs)(outls_2)
        let fnalist_2 = zip(evs)(map(o(o(rator)(lhs))(concl))(fns_prime))
        let inlalist_2 = zip(evs)(inls_2)
        let outlalist_2 = zip(evs)(outls_2)
        let hack_clause:
          fun(tm):
            let [avs, bod] = strip_forall(tm)
            let [l, r] = dest_eq(bod)
            let [fn, args] = strip_comb(r)
            let pargs:
              map(
                fun(a):
                  let g = genvar(type_of(a))
                  if is_var(a)
                  | [g, g]
                  | let outl = assoc(rator(a))(outlalist_2)
                    [mk_comb([outl, g]), g]
              )(args)
            let [args_prime, args_prime_prime] = unzip(pargs)
            let inl = assoc(rator(l))(inlalist_2)
            let rty = hd(snd(dest_type(type_of(inl))))
            let nty = itlist(o(mk_fun_ty)(type_of))(args_prime)(rty)
            let fn_prime = mk_var([fst(dest_var(fn)), nty])
            let r_prime = list_mk_abs([args_prime_prime, mk_comb([inl, list_mk_comb([fn_prime, args_prime])])])
            [r_prime, fn]
        let defs = map(hack_clause)(conjuncts(bod))
        let jth = BETA_RULE(SPECL(map(fst)(defs))(ith))
        let bth = ASSUME(snd(strip_exists(concl(jth))))
        let finish_clause:
          fun(th):
            let [avs, bod] = strip_forall(concl(th))
            let outl = assoc(rator(lhand(bod)))(outlalist_2)
            GENL(avs)(BETA_RULE(AP_TERM(outl)(SPECL(avs)(th))))
        let cth = end_itlist(CONJ)(map(finish_clause)(CONJUNCTS(bth)))
        let dth = ELIM_OUTCOMBS(cth)
        let eth = GEN_REWRITE_RULE(ONCE_DEPTH_CONV)(map(SYM)(fns_prime))(dth)
        let fth = itlist(SIMPLE_EXISTS)(map(snd)(fnalist_2))(eth)
        let dtms = map(o(hd)(hyp))(fns_prime)
        let gth:
          itlist(
            fun(e):
              fun(th):
                let [l, r] = dest_eq(e)
                MP(INST(PairList [[r, l]])(DISCH(e)(th)))(REFL(r))
          )(dtms)(fth)
        let hth = PROVE_HYP(jth)(itlist(SIMPLE_CHOOSE)(evs)(gth))
        let xvs = map(o(o(o(o(fst)(strip_comb))(rand))(snd))(strip_forall))(conjuncts(concl(eth)))
        GENL(xvs)(hth)
  fun(hol_def):
    let [ith, rth] = ind_types_define_type_raw(hol_def)
    [ith, generalize_recursion_theorem(rth)]

def [ind_types_option_INDUCT_v2, option_RECURSION] = ind_types_define_type_raw_v2(parse_inductive_type_specification("option = NONE | SOME A"))

def [ind_types_list_INDUCT_v2, list_RECURSION] = ind_types_define_type_raw_v2(parse_inductive_type_specification("list = NIL | CONS A list"))

def FORALL_OPTION_THM:
  prove(
    [
      @hol|{!P:A option->bool. (!x. P x) <=> P NONE /\ !a. P(SOME a)}|,
      GEN_TAC then_tac EQ_TAC then_tac \
      REWRITE_TAC(PairList [ind_types_option_INDUCT_v2]) then_tac \
      SIMP_TAC(PairList [])
    ]
  )

def EXISTS_OPTION_THM:
  prove(
    [
      @hol|{!P:A option->bool. (?x. P x) <=> P NONE \/ ?a. P(SOME a)}|,
      GEN_TAC then_tac \
      REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(?x. P x) <=> ~(!x. ~P x)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [FORALL_OPTION_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def prove_constructors_injective:
  let DEPAIR = GEN_REWRITE_RULE(TOP_SWEEP_CONV)(PairList [PAIR_EQ])
  let prove_distinctness:
    fun(ax):
      fun(pat):
        let [f, args] = strip_comb(pat)
        let rt = end_itlist(curry(mk_pair))(args)
        let ty = mk_fun_ty(type_of(pat))(type_of(rt))
        let fn = genvar(ty)
        let dtm = mk_eq([mk_comb([fn, pat]), rt])
        let eth = prove_recursive_functions_exist(ax)(list_mk_forall([args, dtm]))
        let args_prime = variants(args)(args)
        let atm = mk_eq([pat, list_mk_comb([f, args_prime])])
        let ath = ASSUME(atm)
        let bth = AP_TERM(fn)(ath)
        let cth1 = SPECL(args)(ASSUME(snd(dest_exists(concl(eth)))))
        let cth2 = INST(zip(args_prime)(args))(cth1)
        let pth = TRANS(TRANS(SYM(cth1))(bth))(cth2)
        let qth = DEPAIR(pth)
        let qtm = concl(qth)
        let rth = rev_itlist(C(curry(MK_COMB)))(CONJUNCTS(ASSUME(qtm)))(REFL(f))
        let tth = IMP_ANTISYM_RULE(DISCH(atm)(qth))(DISCH(qtm)(rth))
        let uth = GENL(args)(GENL(args_prime)(tth))
        PROVE_HYP(eth)(SIMPLE_CHOOSE(fn)(uth))
  fun(ax):
    let cls = conjuncts(snd(strip_exists(snd(strip_forall(concl(ax))))))
    let pats = map(o(o(o(rand)(lhand))(snd))(strip_forall))(cls)
    end_itlist(CONJ)(mapfilter(prove_distinctness(ax))(pats))

def prove_constructors_distinct:
  let num_ty = @hol|{:num}|
  // Recursive pair enumeration needs the local definition before its first use.
  fun allopairs(f): fun(l): fun(m): (if (l == (PairList [])) | PairList [] | append(map(f(hd(l)))(tl(m)))(allopairs(f)(tl(l))(tl(m))))
  let NEGATE:
    o(GEN_ALL)(
      CONV_RULE(
        REWR_CONV(TAUT(@hol|{a ==> F <=> ~a}|))
      )
    )
  let prove_distinct:
    fun(ax):
      fun(pat):
        let nums = map(mk_small_numeral)(range(0)((length(pat) - 1)))
        let fn = genvar(mk_type(["fun", PairList [type_of(hd(pat)), num_ty]]))
        let ls = map(curry(mk_comb)(fn))(pat)
        let defs = map2(fun(l): fun(r): list_mk_forall([frees(rand(l)), mk_eq([l, r])]))(ls)(nums)
        let eth = prove_recursive_functions_exist(ax)(list_mk_conj(defs))
        let [ev, bod] = dest_exists(concl(eth))
        let REWRITE = GEN_REWRITE_RULE(ONCE_DEPTH_CONV)(CONJUNCTS(ASSUME(bod)))
        let pat_prime:
          map(
            fun(t):
              let [f, args] = (if is_numeral(t) | [t, PairList []] | strip_comb(t))
              list_mk_comb([f, variants(args)(args)])
          )(pat)
        let pairs = allopairs(curry(mk_eq))(pat)(pat_prime)
        let nths = map(o(o(REWRITE)(AP_TERM(fn)))(ASSUME))(pairs)
        let fths = map2(fun(t): fun(th): NEGATE(DISCH(t)(CONV_RULE(NUM_EQ_CONV)(th))))(pairs)(nths)
        CONJUNCTS(PROVE_HYP(eth)(SIMPLE_CHOOSE(ev)(end_itlist(CONJ)(fths))))
  fun(ax):
    let cls = conjuncts(snd(strip_exists(snd(strip_forall(concl(ax))))))
    let lefts = map(o(o(o(dest_comb)(lhand))(snd))(strip_forall))(cls)
    let fns = itlist(o(insert)(fst))(lefts)(PairList [])
    let pats = map((fun(f): map(snd)(filter(o((fun (y): f == y))(fst))(lefts))))(fns)
    end_itlist(CONJ)(end_itlist(append)(mapfilter(prove_distinct(ax))(pats)))

def prove_cases_thm:
  let mk_exclauses:
    fun(x):
      fun(rpats):
        let xts = map((fun(t): list_mk_exists([frees(t), mk_eq([x, t])])))(rpats)
        mk_abs([x, list_mk_disj(xts)])
  let prove_triv:
    fun(tm):
      let [evs, bod] = strip_exists(tm)
      let [l, r] = dest_eq(bod)
      if (l == r)
      | REFL(l)
      | let [lf_2, largs_2] = strip_comb(l)
        let [rf_2, rargs_2] = strip_comb(r)
        if (lf_2 == rf_2)
        | let ths = map(o(ASSUME)(mk_eq))(zip(rargs_2)(largs_2))
          let th1 = rev_itlist(C(curry(MK_COMB)))(ths)(REFL(lf_2))
          itlist(EXISTS_EQUATION)(map(concl)(ths))(SYM(th1))
        | failwith("prove_triv")
  fun prove_disj(tm):
    if is_disj(tm)
    | let [l, r] = dest_disj(tm)
      try:
        DISJ1(prove_triv(l))(r)
        ~catch exn:
          match exn
          | Failure(_): DISJ2(l)(prove_disj(r))
          | exn: (throw exn)
    | prove_triv(tm)
  let prove_eclause:
    fun(tm):
      let [avs, bod] = strip_forall(tm)
      let ctm = (if is_imp(bod) | rand(bod) | bod)
      let cth = prove_disj(ctm)
      let dth = (if is_imp(bod) | DISCH(lhand(bod))(cth) | cth)
      GENL(avs)(dth)
  fun(th):
    let [avs, bod] = strip_forall(concl(th))
    let cls = map(o(snd)(strip_forall))(conjuncts(lhand(bod)))
    let pats = map((fun(t): (if is_imp(t) | rand(t) | t)))(cls)
    let spats = map(dest_comb)(pats)
    let preds = itlist(o(insert)(fst))(spats)(PairList [])
    let rpatlist = map((fun(pr): map(snd)(filter((fun([p, x]): (p == pr)))(spats))))(preds)
    let xs = make_args("x")(freesl(pats))(map(o(type_of)(hd))(rpatlist))
    let xpreds = map2(mk_exclauses)(xs)(rpatlist)
    let ith = BETA_RULE(INST(zip(xpreds)(preds))(SPEC_ALL(th)))
    let eclauses = conjuncts(fst(dest_imp(concl(ith))))
    MP(ith)(end_itlist(CONJ)(map(prove_eclause)(eclauses)))

def initialization_1:
  (inductive_type_store.value := append(
      PairList [
        ["list", [2, ind_types_list_INDUCT_v2, list_RECURSION]],
        ["option", [2, ind_types_option_INDUCT_v2, option_RECURSION]],
        ["sum", [2, ind_types_sum_INDUCT_v2, sum_RECURSION]]
      ]
    )(inductive_type_store.value))

def basic_rectype_net = Box(empty_net)

def distinctness_store = Box(PairList [["bool", TAUT(@hol|{(T <=> F) <=> F}|)]])

def injectivity_store = Box(PairList [])

fun extend_rectype_net([tyname, [_, _, rth]]):
  let ths1_2:
    try:
      PairList [prove_constructors_distinct(rth)]
      ~catch exn:
        match exn
        | Failure(_): PairList []
        | exn: (throw exn)
  let ths2_2:
    try:
      PairList [prove_constructors_injective(rth)]
      ~catch exn:
        match exn
        | Failure(_): PairList []
        | exn: (throw exn)
  let canon_thl = itlist(mk_rewrites(#false))(append(ths1_2)(ths2_2))(PairList [])
  distinctness_store.value := append(map((fun(th): [tyname, th]))(ths1_2))(distinctness_store.value)
  injectivity_store.value := append(map((fun(th): [tyname, th]))(ths2_2))(injectivity_store.value)
  basic_rectype_net.value := itlist(net_of_thm(#true))(canon_thl)(basic_rectype_net.value)

do_list(extend_rectype_net)(inductive_type_store.value)

fun distinctness(ty): assoc(ty)(distinctness_store.value)

fun injectivity(ty): assoc(ty)(injectivity_store.value)

fun cases(ty):
  if (ty == "num")
  | num_CASES
  | let [_, ith, _] = assoc(ty)(inductive_type_store.value)
    prove_cases_thm(ith)

def option_DISTINCT:
  prove(
    [
      @hol|{!a:A. ~(SOME a = NONE)}|,
      REWRITE_TAC(PairList [distinctness("option")])
    ]
  )

def option_INJ:
  prove(
    [
      @hol|{!a b:A. SOME a = SOME b <=> a = b}|,
      REWRITE_TAC(PairList [injectivity("option")])
    ]
  )

def ISO:
  new_definition(
    @hol|{ISO (f:A->B) (g:B->A) <=> (!x. f(g x) = x) /\ (!y. g(f y) = y)}|
  )

def ISO_REFL:
  prove(
    [
      @hol|{ISO (\x:A. x) (\x. x)}|,
      REWRITE_TAC(PairList [ISO])
    ]
  )

def ISO_FUN:
  prove(
    [
      @hol|{ISO (f:A->A') f' /\ ISO (g:B->B') g'
         ==> ISO (\h a'. g(h(f' a'))) (\h a. g'(h(f a)))}|,
      REWRITE_TAC(PairList [ISO, FUN_EQ_THM]) then_tac MESON_TAC(PairList [])
    ]
  )

def ISO_USAGE:
  prove(
    [
      @hol|{ISO f g
         ==> (!P. (!x. P x) <=> (!x. P(g x))) /\
             (!P. (?x. P x) <=> (?x. P(g x))) /\
             (!(a:A) (b:B). (a = g b) <=> (f a = b))}|,
      REWRITE_TAC(PairList [ISO, FUN_EQ_THM]) then_tac MESON_TAC(PairList [])
    ]
  )

def ind_types_define_type_raw_v3:
  let TRIV_IMP_CONV:
    fun(tm):
      let [avs, bod] = strip_forall(tm)
      let bth:
        if is_eq(bod)
        | REFL(rand(bod))
        | let [ant, con] = dest_imp(bod)
          let ith = SUBS_CONV(CONJUNCTS(ASSUME(ant)))(lhs(con))
          DISCH(ant)(ith)
      GENL(avs)(bth)
  let TRIV_ANTE_RULE:
    fun(th):
      let tm = concl(th)
      if is_imp(tm)
      | let [ant, con] = dest_imp(concl(th))
        let cjs = conjuncts(ant)
        let cths = map(TRIV_IMP_CONV)(cjs)
        MP(th)(end_itlist(CONJ)(cths))
      | th
  let ISO_EXPAND_CONV = PURE_ONCE_REWRITE_CONV(PairList [ISO])
  // Recursive type lifting needs the local definition before its first use.
  fun lift_type_bijections(iths):
    fun(cty):
      let itys = map(o(o(o(o(o(hd)(snd))(dest_type))(type_of))(lhand))(concl))(iths)
      try:
        assoc(cty)(zip(itys)(iths))
        ~catch exn:
          match exn
          | Failure(_):
              if !exists(C(occurs_in)(cty))(itys)
              | INST_TYPE(PairList [[cty, aty]])(ISO_REFL)
              | let [tycon, isotys] = dest_type(cty)
                if (tycon == "fun")
                | MATCH_MP(ISO_FUN)(end_itlist(CONJ)(map(lift_type_bijections(iths))(isotys)))
                | failwith(
                    ("lift_type_bijections: Unexpected type operator \"" +& (tycon +& "\""))
                  )
          | exn: (throw exn)
  let pth:
    prove(
      [
        @hol|{(?) P ==> (c = (@)P) ==> P c}|,
        GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [GSYM(ETA_AX)]) then_tac \
        DISCH_TAC then_tac \
        DISCH_THEN(SUBST1_TAC) then_tac \
        MATCH_MP_TAC(SELECT_AX) then_tac \
        POP_ASSUM(ACCEPT_TAC)
      ]
    )
  let USE_PTH = MATCH_MP(pth)
  fun DE_EXISTENTIALIZE_RULE_2(th):
    if !is_exists(concl(th))
    | [PairList [], th]
    | let th1 = USE_PTH(th)
      let v1 = rand(rand(concl(th1)))
      let gv = genvar(type_of(v1))
      let th2 = CONV_RULE(BETA_CONV)(UNDISCH(INST(PairList [[gv, v1]])(th1)))
      let [vs, th3] = DE_EXISTENTIALIZE_RULE_2(th2)
      [PairList [gv, & vs], th3]
  let DE_EXISTENTIALIZE_RULE = DE_EXISTENTIALIZE_RULE_2
  let grab_type = o(o(o(o(type_of)(rand))(lhand))(snd))(strip_forall)
  let clause_corresponds:
    fun(cl0):
      let [f0, ctm0] = dest_comb(lhs(cl0))
      let c0 = fst(dest_const(fst(strip_comb(ctm0))))
      let [dty0, rty0] = dest_fun_ty(type_of(f0))
      fun(cl1):
        let [f1, ctm1] = dest_comb(lhs(cl1))
        let c1 = fst(dest_const(fst(strip_comb(ctm1))))
        let [dty1, rty1] = dest_fun_ty(type_of(f1))
        ((c0 == c1) && ((dty0 == rty1) && (rty0 == dty1)))
  let prove_inductive_types_isomorphic:
    fun(n):
      fun(k):
        fun([ith0, rth0]):
          fun([ith1, rth1]):
            let sth0_2 = SPEC_ALL(rth0)
            let sth1_2 = SPEC_ALL(rth1)
            let t_tm_3 = concl(TRUTH)
            let [pevs0_2, pbod0_2] = strip_exists(concl(sth0_2))
            let [pevs1_2, pbod1_2] = strip_exists(concl(sth1_2))
            let [pcjs0_2, qcjs0_2] = chop_list(k)(conjuncts(pbod0_2))
            let [pcjs1_2, qcjs1_2] = chop_list(k)(snd(chop_list(n)(conjuncts(pbod1_2))))
            let tyal0 = setify(zip(map(grab_type)(pcjs1_2))(map(grab_type)(pcjs0_2)))
            let tyal1 = map((fun([a, b]): [b, a]))(tyal0)
            let tyins0_2:
              map(
                fun(f):
                  let [domty, ranty] = dest_fun_ty(type_of(f))
                  [tysubst(tyal0)(domty), ranty]
              )(pevs0_2)
            let tyins1_2:
              map(
                fun(f):
                  let [domty, ranty] = dest_fun_ty(type_of(f))
                  [tysubst(tyal1)(domty), ranty]
              )(pevs1_2)
            let tth0_2 = INST_TYPE(tyins0_2)(sth0_2)
            let tth1_2 = INST_TYPE(tyins1_2)(sth1_2)
            let [evs0_2, bod0_2] = strip_exists(concl(tth0_2))
            let [evs1_2, bod1_2] = strip_exists(concl(tth1_2))
            let [lcjs0_2, rcjs0_2] = chop_list(k)(map(o(snd)(strip_forall))(conjuncts(bod0_2)))
            let [lcjs1_2, rcjsx_2] = chop_list(k)(map(o(snd)(strip_forall))(snd(chop_list(n)(conjuncts(bod1_2)))))
            let rcjs1 = map((fun(t): find(clause_corresponds(t))(rcjsx_2)))(rcjs0_2)
            let proc_clause:
              fun(tm0):
                fun(tm1):
                  let [l0_2, r0_2] = dest_eq(tm0)
                  let [l1_2, r1_2] = dest_eq(tm1)
                  let [vc0, wargs0] = strip_comb(r0_2)
                  let [con0, vargs0] = strip_comb(rand(l0_2))
                  let gargs0 = map(o(genvar)(type_of))(wargs0)
                  let nestf0:
                    map(
                      (fun(a): can(find((fun(t): (is_comb(t) && (rand(t) == a)))))(wargs0))
                    )(vargs0)
                  let targs0:
                    map2(
                      fun(a): fun(f): (if f | find((fun(t): (is_comb(t) && (rand(t) == a))))(wargs0) | a)
                    )(vargs0)(nestf0)
                  let gvlist0 = zip(wargs0)(gargs0)
                  let xargs = map((fun(v): assoc(v)(gvlist0)))(targs0)
                  let inst0:
                    [
                      list_mk_abs([gargs0, list_mk_comb([fst(strip_comb(rand(l1_2))), xargs])]),
                      vc0
                    ]
                  let [vc1, wargs1] = strip_comb(r1_2)
                  let [con1, vargs1] = strip_comb(rand(l1_2))
                  let gargs1 = map(o(genvar)(type_of))(wargs1)
                  let targs1:
                    map2(
                      fun(a): fun(f): (if f | find((fun(t): (is_comb(t) && (rand(t) == a))))(wargs1) | a)
                    )(vargs1)(nestf0)
                  let gvlist1 = zip(wargs1)(gargs1)
                  let xargs = map((fun(v): assoc(v)(gvlist1)))(targs1)
                  let inst1:
                    [
                      list_mk_abs([gargs1, list_mk_comb([fst(strip_comb(rand(l0_2))), xargs])]),
                      vc1
                    ]
                  [inst0, inst1]
            let [insts0, insts1] = unzip(map2(proc_clause)(append(lcjs0_2)(rcjs0_2))(append(lcjs1_2)(rcjs1)))
            let uth0_2 = BETA_RULE(INST(insts0)(tth0_2))
            let uth1_2 = BETA_RULE(INST(insts1)(tth1_2))
            let [efvs0_2, sth0_3] = DE_EXISTENTIALIZE_RULE(uth0_2)
            let [efvs1_2, sth1_3] = DE_EXISTENTIALIZE_RULE(uth1_2)
            let efvs2:
              map(
                fun(t1):
                  find(
                    (fun(t2): (hd(tl(snd(dest_type(type_of(t1))))) == hd(snd(dest_type(type_of(t2))))))
                  )(efvs1_2)
              )(efvs0_2)
            let isotms = map2(fun(ff): fun(gg): list_mk_icomb("ISO")(PairList [ff, gg]))(efvs0_2)(efvs2)
            let ctm = list_mk_conj(isotms)
            let cth1 = ISO_EXPAND_CONV(ctm)
            let ctm1 = rand(concl(cth1))
            let cjs = conjuncts(ctm1)
            let eee = map((fun(n): ((n rem 2) == 0)))(range(0)((length(cjs) - 1)))
            let [cjs1, cjs2] = partition(fst)(zip(eee)(cjs))
            let ctm2 = mk_conj([list_mk_conj(map(snd)(cjs1)), list_mk_conj(map(snd)(cjs2))])
            let DETRIV_RULE = o(TRIV_ANTE_RULE)(REWRITE_RULE(PairList [sth0_3, sth1_3]))
            let itha = SPEC_ALL(ith0)
            let icjs = conjuncts(rand(concl(itha)))
            let cinsts = map((fun(tm): tryfind((fun(vtm): term_match(PairList [])(vtm)(tm)))(icjs)))(conjuncts(rand(ctm2)))
            let tvs = subtract(fst(strip_forall(concl(ith0))))(itlist((fun([_, x, _]): union(map(snd)(x))))(cinsts)(PairList []))
            let ctvs:
              map(
                fun(p):
                  let x = mk_var(["x", hd(snd(dest_type(type_of(p))))])
                  [mk_abs([x, t_tm_3]), p]
              )(tvs)
            let jth0_2 = DETRIV_RULE(INST(ctvs)(itlist(INSTANTIATE)(cinsts)(itha)))
            let itha = SPEC_ALL(ith1)
            let icjs = conjuncts(rand(concl(itha)))
            let cinsts = map((fun(tm): tryfind((fun(vtm): term_match(PairList [])(vtm)(tm)))(icjs)))(conjuncts(lhand(ctm2)))
            let tvs = subtract(fst(strip_forall(concl(ith1))))(itlist((fun([_, x, _]): union(map(snd)(x))))(cinsts)(PairList []))
            let ctvs:
              map(
                fun(p):
                  let x = mk_var(["x", hd(snd(dest_type(type_of(p))))])
                  [mk_abs([x, t_tm_3]), p]
              )(tvs)
            let jth1_2 = DETRIV_RULE(INST(ctvs)(itlist(INSTANTIATE)(cinsts)(itha)))
            let cths4 = map2(CONJ)(CONJUNCTS(jth0_2))(CONJUNCTS(jth1_2))
            let cths5 = map(PURE_ONCE_REWRITE_RULE(PairList [GSYM(ISO)]))(cths4)
            let cth6 = end_itlist(CONJ)(cths5)
            [cth6, CONJ(sth0_3)(sth1_3)]
  let SCRUB_ASSUMPTION:
    fun(th):
      let hyps = hyp(th)
      let eqn:
        find(
          fun(t):
            let x = lhs(t)
            forall((fun(u): !free_in(x)(rand(u))))(hyps)
        )(hyps)
      let [l, r] = dest_eq(eqn)
      MP(INST(PairList [[r, l]])(DISCH(eqn)(th)))(REFL(r))
  let define_type_basecase:
    fun(hol_def):
      let add_id = (fun(s): fst(dest_var(genvar(bool_ty))))
      let def_prime = map(F_F(I)(map(F_F(add_id)(I))))(hol_def)
      ind_types_define_type_raw_v2(def_prime)
  let SIMPLE_BETA_RULE = o(GSYM)(PURE_REWRITE_RULE(PairList [BETA_THM, FUN_EQ_THM]))
  let ISO_USAGE_RULE = MATCH_MP(ISO_USAGE)
  let SIMPLE_ISO_EXPAND_RULE = CONV_RULE(REWR_CONV(ISO))
  let ths = itlist(mk_rewrites(#false))(PairList [FUN_EQ_THM])(PairList [])
  let net = itlist(net_of_thm(#false))(ths)(basic_net(#void))
  let REWRITE_FUN_EQ_RULE = o(CONV_RULE)(GENERAL_REWRITE_CONV(#true)(TOP_DEPTH_CONV)(net))
  let is_nested = fun(vs): fun(ty): (!is_vartype(ty) && !(intersect(tyvars(ty))(vs) == (PairList [])))
  // Recursive type rewriting needs the local definition before its first use.
  fun modify_type(alist):
    fun(ty):
      try:
        rev_assoc(ty)(alist)
        ~catch exn:
          match exn
          | Failure(_):
              try:
                let [tycon, tyargs] = dest_type(ty)
                mk_type([tycon, map(modify_type(alist))(tyargs)])
                ~catch exn:
                  match exn
                  | Failure(_): ty
                  | exn: (throw exn)
          | exn: (throw exn)
  let modify_item = fun(alist): fun([s, l]): [s, map(modify_type(alist))(l)]
  let modify_clause = fun(alist): fun([l, lis]): [l, map(modify_item(alist))(lis)]
  let recover_clause:
    fun(id):
      fun(tm):
        let [con, args] = strip_comb(tm)
        [(fst(dest_const(con)) +& id), map(type_of)(args)]
  fun create_auxiliary_clauses(nty):
    let id = fst(dest_var(genvar(bool_ty)))
    let [tycon, tyargs] = dest_type(nty)
    let [k, ith, rth]:
      try:
        assoc(tycon)(inductive_type_store.value)
        ~catch exn:
          match exn
          | Failure(_): failwith(("Can't find definition for nested type: " +& tycon))
          | exn: (throw exn)
    let [evs, bod] = strip_exists(snd(strip_forall(concl(rth))))
    let cjs = map(o(o(lhand)(snd))(strip_forall))(conjuncts(bod))
    let rtys = map(o(o(o(hd)(snd))(dest_type))(type_of))(evs)
    let tyins = tryfind((fun(vty): type_match(vty)(nty)(PairList [])))(rtys)
    let cjs_prime = map(o(inst(tyins))(rand))(fst(chop_list(k)(cjs)))
    let mtys = itlist(o(insert)(type_of))(cjs_prime)(PairList [])
    let pcons = map((fun(ty): filter((fun(t): (type_of(t) == ty)))(cjs_prime)))(mtys)
    let cls_prime = zip(mtys)(map(map(recover_clause(id)))(pcons))
    let tyal = map((fun(ty): [mk_vartype((fst(dest_type(ty)) +& id)), ty]))(mtys)
    let cls_prime_prime = map(F_F(modify_type(tyal))(map(modify_item(tyal))))(cls_prime)
    [k, tyal, cls_prime_prime, INST_TYPE(tyins)(ith), INST_TYPE(tyins)(rth)]
  fun define_type_nested(hol_def):
    let n = length(itlist(append)(map(o(map(fst))(snd))(hol_def))(PairList []))
    let newtys = map(fst)(hol_def)
    let utys = unions(itlist(o(o(union)(map(snd)))(snd))(hol_def)(PairList []))
    let rectys = filter(is_nested(newtys))(utys)
    if (rectys == (PairList []))
    | let [th1, th2] = define_type_basecase(hol_def)
      [n, th1, th2]
    | let nty = hd(sort(fun(t1): fun(t2): occurs_in(t2)(t1))(rectys))
      let [k, tyal, ncls, ith, rth] = create_auxiliary_clauses(nty)
      let cls = append(map(modify_clause(tyal))(hol_def))(ncls)
      let [_, ith1, rth1] = define_type_nested(cls)
      let xnewtys = map(o(o(o(hd)(snd))(dest_type))(type_of))(fst(strip_exists(snd(strip_forall(concl(rth1))))))
      let xtyal:
        map(
          fun(ty):
            let s = dest_vartype(ty)
            [find((fun(t): (fst(dest_type(t)) == s)))(xnewtys), ty]
        )(map(fst)(cls))
      let ith0_2 = INST_TYPE(xtyal)(ith)
      let rth0_2 = INST_TYPE(xtyal)(rth)
      let [isoth, rclauses] = prove_inductive_types_isomorphic(n)(k)([ith0_2, rth0_2])([ith1, rth1])
      let irth3 = CONJ(ith1)(rth1)
      let vtylist = itlist(o(insert)(type_of))(variables(concl(irth3)))(PairList [])
      let isoths = CONJUNCTS(isoth)
      let isotys = map(o(o(o(o(o(hd)(snd))(dest_type))(type_of))(lhand))(concl))(isoths)
      let ctylist = filter((fun(ty): exists((fun(t): occurs_in(t)(ty)))(isotys)))(vtylist)
      let atylist = itlist(o(union)(striplist(dest_fun_ty)))(ctylist)(PairList [])
      let isoths_prime = map(lift_type_bijections(isoths))(filter((fun(ty): exists((fun(t): occurs_in(t)(ty)))(isotys)))(atylist))
      let cisoths = map(o(BETA_RULE)(lift_type_bijections(isoths_prime)))(ctylist)
      let uisoths = map(ISO_USAGE_RULE)(cisoths)
      let visoths = map(o(ASSUME)(concl))(uisoths)
      let irth4 = itlist(PROVE_HYP)(uisoths)(REWRITE_FUN_EQ_RULE(visoths)(irth3))
      let irth5 = REWRITE_RULE(PairList [rclauses, & map(SIMPLE_ISO_EXPAND_RULE)(isoths_prime)])(irth4)
      let irth6 = repeat(SCRUB_ASSUMPTION)(irth5)
      let ncjs:
        filter(
          (fun(t): exists((fun(v): !is_var(v)))(snd(strip_comb(rand(lhs(snd(strip_forall(t))))))))
        )(
          conjuncts(snd(strip_exists(snd(strip_forall(rand(concl(irth6)))))))
        )
      let mk_newcon:
        fun(tm):
          let [vs, bod] = strip_forall(tm)
          let rdeb = rand(lhs(bod))
          let rdef = list_mk_abs([vs, rdeb])
          let newname = fst(dest_var(genvar(bool_ty)))
          let hol_def_2 = mk_eq([mk_var([newname, type_of(rdef)]), rdef])
          let dth = new_definition(hol_def_2)
          SIMPLE_BETA_RULE(dth)
      let dths = map(mk_newcon)(ncjs)
      let [ith6, rth6] = CONJ_PAIR(PURE_REWRITE_RULE(dths)(irth6))
      [n, ith6, rth6]
  fun(hol_def):
    let newtys = map(fst)(hol_def)
    let truecons = itlist(append)(map(o(map(fst))(snd))(hol_def))(PairList [])
    let [p, ith0, rth0] = define_type_nested(hol_def)
    let [avs, etm] = strip_forall(concl(rth0))
    let allcls = conjuncts(snd(strip_exists(etm)))
    let relcls = fst(chop_list(length(truecons))(allcls))
    let gencons = map(o(o(o(o(repeat(rator))(rand))(lhand))(snd))(strip_forall))(relcls)
    let cdefs:
      map2(
        fun(s): fun(r): SYM(new_definition(mk_eq([mk_var([s, type_of(r)]), r])))
      )(truecons)(gencons)
    let tavs = make_args("f")(PairList [])(map(type_of)(avs))
    let ith1_2 = SUBS(cdefs)(ith0)
    let rth1_2 = GENL(tavs)(SUBS(cdefs)(SPECL(tavs)(rth0)))
    let retval = [p, ith1_2, rth1_2]
    let newentries = map((fun(s): [dest_vartype(s), retval]))(newtys)
    inductive_type_store.value := append(newentries)(inductive_type_store.value)
    do_list(extend_rectype_net)(newentries)
    [ith1_2, rth1_2]

def the_inductive_types:
  Box(
    PairList [
      ["list = NIL | CONS A list", [ind_types_list_INDUCT_v2, list_RECURSION]],
      ["option = NONE | SOME A", [ind_types_option_INDUCT_v2, option_RECURSION]],
      ["sum = INL A | INR B", [ind_types_sum_INDUCT_v2, sum_RECURSION]]
    ]
  )

fun define_type(s):
  try:
    let retval = assoc(s)(the_inductive_types.value)
    warn(#true)("Benign redefinition of inductive type")
    retval
    ~catch exn:
      match exn
      | Failure(_):
          let defspec = parse_inductive_type_specification(s)
          let newtypes_2 = map(fst)(defspec)
          let constructors_2 = itlist(o(append)(map(fst)))(map(snd)(defspec))(PairList [])
          if !(length(setify(newtypes_2)) == length(newtypes_2))
          | failwith("define_type: multiple definitions of a type")
          | if !(length(setify(constructors_2)) == length(constructors_2))
            | failwith("define_type: multiple instances of a constructor")
            | if exists(o(can(get_type_arity))(dest_vartype))(newtypes_2)
              | let t = find(can(get_type_arity))(map(dest_vartype)(newtypes_2))
                failwith(("define_type: type :" +& (t +& " already defined")))
              | if exists(can(get_const_type))(constructors_2)
                | let t = find(can(get_const_type))(constructors_2)
                  failwith(("define_type: constant " +& (t +& " already defined")))
                | let retval = ind_types_define_type_raw_v3(defspec)
                  the_inductive_types.value := PairList [[s, retval], & the_inductive_types.value]
                  retval
      | exn: (throw exn)

def [ind_types_UNWIND_CONV_v2, MATCH_CONV]:
  let pth_0_2:
    prove(
      [
        @hol|{(if ?!x. x = a /\ p then @x. x = a /\ p else @x. F) =
           (if p then a else @x. F)}|,
        BOOL_CASES_TAC(@hol|{p:bool}|) then_tac \
        ASM_REWRITE_TAC(PairList [COND_ID]) then_tac \
        MESON_TAC(PairList [])
      ]
    )
  let pth_1_2:
    prove(
      [
        @hol|{_MATCH x (_SEQPATTERN r s) =
            (if ?y. r x y then _MATCH x r else _MATCH x s) /\
           _FUNCTION (_SEQPATTERN r s) x =
            (if ?y. r x y then _FUNCTION r x else _FUNCTION s x)}|,
        REWRITE_TAC(PairList [_MATCH, _SEQPATTERN, _FUNCTION]) then_tac \
        MESON_TAC(PairList [])
      ]
    )
  let pth_2_2:
    prove(
      [
        @hol|{((?y. _UNGUARDED_PATTERN (GEQ s t) (GEQ u y)) <=> s = t) /\
           ((?y. _GUARDED_PATTERN (GEQ s t) p (GEQ u y)) <=> s = t /\ p)}|,
        REWRITE_TAC(PairList [_UNGUARDED_PATTERN, _GUARDED_PATTERN, GEQ_DEF]) then_tac \
        MESON_TAC(PairList [])
      ]
    )
  let pth_3_2:
    prove(
      [
        @hol|{(_MATCH x (\y z. P y z) = if ?!z. P x z then @z. P x z else @x. F) /\
           (_FUNCTION (\y z. P y z) x = if ?!z. P x z then @z. P x z else @x. F)}|,
        REWRITE_TAC(PairList [_MATCH, _FUNCTION])
      ]
    )
  let pth_4_2:
    prove(
      [
        @hol|{(_UNGUARDED_PATTERN (GEQ s t) (GEQ u y) <=> y = u /\ s = t) /\
           (_GUARDED_PATTERN (GEQ s t) p (GEQ u y) <=> y = u /\ s = t /\ p)}|,
        REWRITE_TAC(PairList [_UNGUARDED_PATTERN, _GUARDED_PATTERN, GEQ_DEF]) then_tac \
        MESON_TAC(PairList [])
      ]
    )
  let pth_5_2:
    prove(
      [
        @hol|{(if ?!z. z = k then @z. z = k else @x. F) = k}|,
        MESON_TAC(PairList [])
      ]
    )
  // Recursive conversion needs the local definition before its first use.
  fun INSIDE_EXISTS_CONV(conv): fun(tm): (if is_exists(tm) | BINDER_CONV(INSIDE_EXISTS_CONV(conv))(tm) | conv(tm))
  let econv = REWR_CONV(SWAP_EXISTS_THM)
  // Recursive conversion needs the local definition before its first use.
  fun conv(bc):
    fun(tm):
      try:
        (econv then_conv BINDER_CONV(conv(bc)))(tm)
        ~catch exn:
          match exn
          | Failure(_): bc(tm)
          | exn: (throw exn)
  let PUSH_EXISTS_CONV = conv
  let conv2:
    (
      GEN_REWRITE_CONV(DEPTH_CONV)(PairList [AND_CLAUSES, OR_CLAUSES]) then_conv \
      ASSOC_CONV(CONJ_ASSOC)
    )
  let BREAK_CONS_CONV:
    fun(tm):
      let conv0 = TOP_SWEEP_CONV(REWRITES_CONV(basic_rectype_net.value))
      let conv1 = (if is_conj(tm) | LAND_CONV(conv0) | conv0)
      (conv1 then_conv conv2)(tm)
  let baseconv:
    GEN_REWRITE_CONV(I)(
      PairList [
        UNWIND_THM1,
        UNWIND_THM2,
        EQT_INTRO(SPEC_ALL(EXISTS_REFL)),
        EQT_INTRO(GSYM(SPEC_ALL(EXISTS_REFL)))
      ]
    )
  fun UNWIND_CONV_2(tm):
    let [evs, bod] = strip_exists(tm)
    let eqs = conjuncts(bod)
    try:
      let eq:
        find(
          fun(tm):
            if is_eq(tm)
            | let [l, r] = dest_eq(tm)
              ((mem(l)(evs) && !free_in(l)(r)) || (mem(r)(evs) && !free_in(r)(l)))
            | #false
        )(eqs)
      let [l, r] = dest_eq(eq)
      let v = (if (mem(l)(evs) && !free_in(l)(r)) | l | r)
      let cjs_prime = PairList [eq, & subtract(eqs)(PairList [eq])]
      let n = (length(evs) - (1 + index(v)(rev(evs))))
      let th1 = CONJ_ACI_RULE(mk_eq([bod, list_mk_conj(cjs_prime)]))
      let th2 = itlist(MK_EXISTS)(evs)(th1)
      let th3 = funpow(n)(BINDER_CONV)(PUSH_EXISTS_CONV(baseconv))(rand(concl(th2)))
      CONV_RULE(RAND_CONV(UNWIND_CONV_2))(TRANS(th2)(th3))
      ~catch exn:
        match exn
        | Failure(_): REFL(tm)
        | exn: (throw exn)
  let UNWIND_CONV = UNWIND_CONV_2
  let MATCH_SEQPATTERN_CONV_2:
    (
      GEN_REWRITE_CONV(I)(PairList [pth_1_2]) then_conv \
      RATOR_CONV(
        LAND_CONV(
          BINDER_CONV(RATOR_CONV(BETA_CONV) then_conv BETA_CONV) then_conv \
          PUSH_EXISTS_CONV(GEN_REWRITE_CONV(I)(PairList [pth_2_2]) then_conv BREAK_CONS_CONV) then_conv \
          UNWIND_CONV then_conv \
          GEN_REWRITE_CONV(DEPTH_CONV)(PairList [EQT_INTRO(SPEC_ALL(EQ_REFL)), AND_CLAUSES]) then_conv \
          GEN_REWRITE_CONV(DEPTH_CONV)(PairList [EXISTS_SIMP])
        )
      )
    )
  let MATCH_ONEPATTERN_CONV_2:
    fun(tm):
      let th1 = GEN_REWRITE_CONV(I)(PairList [pth_3_2])(tm)
      let tm_prime = body(rand(lhand(rand(concl(th1)))))
      let th2:
        (
          INSIDE_EXISTS_CONV(GEN_REWRITE_CONV(I)(PairList [pth_4_2]) then_conv RAND_CONV(BREAK_CONS_CONV)) then_conv \
          UNWIND_CONV then_conv \
          GEN_REWRITE_CONV(DEPTH_CONV)(PairList [EQT_INTRO(SPEC_ALL(EQ_REFL)), AND_CLAUSES]) then_conv \
          GEN_REWRITE_CONV(DEPTH_CONV)(PairList [EXISTS_SIMP])
        )(tm_prime)
      let conv_2 = (fun(tm): (if (tm == lhand(concl(th2))) | th2 | fail()))
      CONV_RULE(
        RAND_CONV(
          RATOR_CONV(COMB2_CONV(RAND_CONV(BINDER_CONV(conv_2)))(BINDER_CONV(conv_2)))
        )
      )(th1)
  let MATCH_SEQPATTERN_CONV_TRIV_2 = (MATCH_SEQPATTERN_CONV_2 then_conv GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES]))
  let MATCH_SEQPATTERN_CONV_GEN_2:
    (
      MATCH_SEQPATTERN_CONV_2 then_conv \
      GEN_REWRITE_CONV(TRY_CONV)(PairList [COND_CLAUSES])
    )
  let MATCH_ONEPATTERN_CONV_TRIV_2 = (MATCH_ONEPATTERN_CONV_2 then_conv GEN_REWRITE_CONV(I)(PairList [pth_5_2]))
  let MATCH_ONEPATTERN_CONV_GEN_2:
    (
      MATCH_ONEPATTERN_CONV_2 then_conv \
      GEN_REWRITE_CONV(TRY_CONV)(PairList [pth_0_2, pth_5_2])
    )
  do_list(extend_basic_convs)(
    PairList [
      [
        "MATCH_SEQPATTERN_CONV",
        [
          @hol|{_MATCH x (_SEQPATTERN r s)}|,
          MATCH_SEQPATTERN_CONV_TRIV_2
        ]
      ],
      [
        "FUN_SEQPATTERN_CONV",
        [
          @hol|{_FUNCTION (_SEQPATTERN r s) x}|,
          MATCH_SEQPATTERN_CONV_TRIV_2
        ]
      ],
      [
        "MATCH_ONEPATTERN_CONV",
        [
          @hol|{_MATCH x (\y z. P y z)}|,
          MATCH_ONEPATTERN_CONV_TRIV_2
        ]
      ],
      [
        "FUN_ONEPATTERN_CONV",
        [
          @hol|{_FUNCTION (\y z. P y z) x}|,
          MATCH_ONEPATTERN_CONV_TRIV_2
        ]
      ]
    ]
  )
  [
    CHANGED_CONV(UNWIND_CONV),
    MATCH_SEQPATTERN_CONV_GEN_2 or_conv MATCH_ONEPATTERN_CONV_GEN_2
  ]

def FORALL_UNWIND_CONV:
  let econv = REWR_CONV(SWAP_FORALL_THM)
  // Recursive conversion needs the local definition before its first use.
  fun conv_3(bc):
    fun(tm):
      try:
        (econv then_conv BINDER_CONV(conv_3(bc)))(tm)
        ~catch exn:
          match exn
          | Failure(_): bc(tm)
          | exn: (throw exn)
  let PUSH_FORALL_CONV = conv_3
  let baseconv:
    GEN_REWRITE_CONV(I)(
      PairList [
        MESON(
          PairList [])(
          @hol|{(!x. x = a /\ p x ==> q x) <=> (p a ==> q a)}|
        ),
        MESON(
          PairList [])(
          @hol|{(!x. a = x /\ p x ==> q x) <=> (p a ==> q a)}|
        ),
        MESON(
          PairList [])(
          @hol|{(!x. x = a ==> q x) <=> q a}|
        ),
        MESON(
          PairList [])(
          @hol|{(!x. a = x ==> q x) <=> q a}|
        )
      ]
    )
  fun FORALL_UNWIND_CONV(tm):
    try:
      let [avs, bod] = strip_forall(tm)
      let [ant, con] = dest_imp(bod)
      let eqs = conjuncts(ant)
      let eq:
        find(
          fun(tm):
            if is_eq(tm)
            | let [l, r] = dest_eq(tm)
              ((mem(l)(avs) && !free_in(l)(r)) || (mem(r)(avs) && !free_in(r)(l)))
            | #false
        )(eqs)
      let [l, r] = dest_eq(eq)
      let v = (if (mem(l)(avs) && !free_in(l)(r)) | l | r)
      let cjs_prime = PairList [eq, & subtract(eqs)(PairList [eq])]
      let n = (length(avs) - (1 + index(v)(rev(avs))))
      let th1 = CONJ_ACI_RULE(mk_eq([ant, list_mk_conj(cjs_prime)]))
      let th2 = AP_THM(AP_TERM(rator(rator(bod)))(th1))(con)
      let th3 = itlist(MK_FORALL)(avs)(th2)
      let th4 = funpow(n)(BINDER_CONV)(PUSH_FORALL_CONV(baseconv))(rand(concl(th3)))
      CONV_RULE(RAND_CONV(FORALL_UNWIND_CONV))(TRANS(th3)(th4))
      ~catch exn:
        match exn
        | Failure(_): REFL(tm)
        | exn: (throw exn)
  FORALL_UNWIND_CONV

