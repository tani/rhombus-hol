def INT_POW:
  prove(
    [
      Host.hol_term(And(
        Eq(
          Int,
          App(
            Const("int_pow", Fun(Int, Fun(Num, Int))),
            [Var("x", Int), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
          ),
          App(
            Const("int_of_num", Fun(Num, Int)),
            [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
          )
        ),
        Forall(
          "n",
          Num,
          Eq(
            Int,
            App(
              Const("int_pow", Fun(Int, Fun(Num, Int))),
              [Var("x", Int), App(Const("SUC", Fun(Num, Num)), [Ref("n")])]
            ),
            App(
              Const("int_mul", Fun(Int, Fun(Int, Int))),
              [Var("x", Int), App(Const("int_pow", Fun(Int, Fun(Num, Int))), [Var("x", Int), Ref("n")])]
            )
          )
        )
      )),
      REWRITE_TAC(map(INT_OF_REAL_THM)(CONJUNCTS(real_pow)))
    ]
  )

def INT_ABS:
  prove(
    [
      Host.hol_term(Forall(
        "x",
