          | if (rator(l) == neg_tm)
            | if (rator(r) == neg_tm)
              | let th1 = INST(PairList [[rand(rand(l)), m_tm_2], [rand(rand(r)), n_tm_2]])(pth1)
                let tm1 = rand(rand(rand(concl(th1))))
                let th2 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(NUM_ADD_CONV(tm1)))
                TRANS(th1)(th2)
              | let m_2 = rand(rand(l))
                let n_2 = rand(r)
                let m_prime_2 = dest_numeral(m_2)
                let n_prime_2 = dest_numeral(n_2)
                if (m_prime_2 <= n_prime_2)
                | let p = mk_numeral((n_prime_2 - m_prime_2))
                  let th1 = INST(PairList [[m_2, m_tm_2], [p, n_tm_2]])(pth2)
                  let th2 = NUM_ADD_CONV(rand(rand(lhand(concl(th1)))))
                  let th3 = AP_TERM(rator(tm))(AP_TERM(amp_tm)(SYM(th2)))
                  TRANS(th3)(th1)
                | let p = mk_numeral((m_prime_2 - n_prime_2))
                  let th1 = INST(PairList [[n_2, m_tm_2], [p, n_tm_2]])(pth3)
                  let th2 = NUM_ADD_CONV(rand(rand(lhand(lhand(concl(th1))))))
                  let th3 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_THM(AP_TERM(add_tm)(th3))(rand(tm))
                  TRANS(th4)(th1)
            | if (rator(r) == neg_tm)
              | let m_3 = rand(l)
                let n_3 = rand(rand(r))
                let m_prime_3 = dest_numeral(m_3)
                let n_prime_3 = dest_numeral(n_3)
                if (n_prime_3 <= m_prime_3)
                | let p = mk_numeral((m_prime_3 - n_prime_3))
                  let th1 = INST(PairList [[n_3, m_tm_2], [p, n_tm_2]])(pth4)
                  let th2 = NUM_ADD_CONV(rand(lhand(lhand(concl(th1)))))
                  let th3 = AP_TERM(add_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_THM(th3)(rand(tm))
                  TRANS(th4)(th1)
                | let p = mk_numeral((n_prime_3 - m_prime_3))
                  let th1 = INST(PairList [[m_3, m_tm_2], [p, n_tm_2]])(pth5)
                  let th2 = NUM_ADD_CONV(rand(rand(rand(lhand(concl(th1))))))
                  let th3 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_TERM(rator(tm))(th3)
                  TRANS(th4)(th1)
              | let th1 = INST(PairList [[rand(l), m_tm_2], [rand(r), n_tm_2]])(pth6)
                let tm1 = rand(rand(concl(th1)))
                let th2 = AP_TERM(amp_tm)(NUM_ADD_CONV(tm1))
                TRANS(th1)(th2)
          ~catch exn:
            match exn
            | Failure(_): failwith("INT_ADD_CONV")
            | exn: (throw exn)
    )
  )

