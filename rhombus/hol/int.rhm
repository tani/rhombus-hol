                        ) then_tac \
                        FIRST_X_ASSUM(
                          o(MP_TAC)(SPECL(PairList [Host.hol_term(Var("a", Num)), Host.hol_term(Var("b", Num))]))
                        )
                      ) then_tac \
                      FIRST_X_ASSUM(o(SUBST_ALL_TAC)(SYM))
                    ) then_tac \
                    RULE_ASSUM_TAC(REWRITE_RULE(PairList [MULT_EQ_0, MULT_EQ_1, DE_MORGAN_THM]))
                  ) then_tac \
                  REWRITE_TAC(
                    PairList [
