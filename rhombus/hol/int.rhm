            Num,
            Implies(
              Or(
                Eq(Num, Ref("p"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])),
                Or(
                  Eq(
                    Num,
                    Ref("p"),
                    App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                  ),
                  App(Const("prime", Fun(Num, Bool)), [Ref("p")])
                )
              ),
              Iff(
                App(
                  Const("num_divides", Fun(Num, Fun(Num, Bool))),
                  [Ref("p"), App(Const("*", Fun(Num, Fun(Num, Num))), [Ref("a"), Ref("b")])]
                ),
                Or(
                  App(Const("num_divides", Fun(Num, Fun(Num, Bool))), [Ref("p"), Ref("a")]),
                  App(Const("num_divides", Fun(Num, Fun(Num, Bool))), [Ref("p"), Ref("b")])
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                REPEAT(STRIP_TAC) then_tac \
                ASM_REWRITE_TAC(
                  PairList [
                    NUMBER_RULE(
                      Host.hol_term(App(
                        Const("num_divides", Fun(Num, Fun(Num, Bool))),
                        [
                          App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                          Var("n", Num)
                        ]
                      ))
                    )
                  ]
                )
              ) then_tac \
              ASM_REWRITE_TAC(
                PairList [
                  NUMBER_RULE(
                    Host.hol_term(Iff(
                      App(
                        Const("num_divides", Fun(Num, Fun(Num, Bool))),
                        [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]), Var("n", Num)]
                      ),
                      Eq(Num, Var("n", Num), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]))
                    ))
                  ),
                  MULT_EQ_0
