def INT_CONG_DIV2:
  prove(
    [
      (hol:
         const #{==} :: A -> A -> (A -> A -> bool) -> bool
         const int_mod :: int -> int -> int -> bool
         const div :: int -> int -> int
         forall (a :: int, b :: int, m :: int, n :: int):
           const.#{==}(a, b, int_mod(m * n)) ==> const.#{==}(div(a, m), div(b, m), int_mod(n))),
      (
        (
          GEN_REWRITE_TAC(funpow(2)(BINDER_CONV))(PairList [FORALL_INT_CASES]) then_tac \
          REWRITE_TAC(
            PairList [
              int_INT_DIV_RNEG_v2,
              INT_MUL_LNEG,
              int_INTEGER_RULE(
                (hol:
                   var a :: int
                   var b :: int
                   var n :: int
                   const #{==} :: A -> A -> (A -> A -> bool) -> bool
                   const int_mod :: int -> int -> int -> bool
                   const.#{==}(-a, -b, int_mod(n)) <=> const.#{==}(a, b, int_mod(n)))
              ),
              int_INTEGER_RULE(
                (hol:
                   var a :: int
                   var b :: int
                   var n :: int
                   const #{==} :: A -> A -> (A -> A -> bool) -> bool
                   const int_mod :: int -> int -> int -> bool
                   const.#{==}(a, b, int_mod(-n)) <=> const.#{==}(a, b, int_mod(n)))
              )
            ]
          )
        ) then_tac \
        SIMP_TAC(PairList [GSYM(INT_REM_EQ), INT_DIV_REM, INT_POS])
      )
    ]
  )

