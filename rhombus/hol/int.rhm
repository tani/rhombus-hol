def INT_REM_UNIQ:
  prove(
    [
      Host.hol_term(Forall(
        "m",
        Int,
        Forall(
          "n",
          Int,
          Forall(
            "q",
            Int,
            Forall(
              "r",
              Int,
              Implies(
                And(
                  Eq(
                    Int,
                    Ref("m"),
                    App(
