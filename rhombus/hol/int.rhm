    )
  let PairList [pth_lt1, & PairList [pth_lt2a, & PairList [pth_lt2b, & PairList [pth_lt3, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        Host.hol_term(And(
          Iff(
            App(
              Const("int_lt", Fun(Int, Fun(Int, Bool))),
              [
                App(Const("int_of_num", Fun(Num, Int)), [Var("m", Num)]),
                App(Const("int_neg", Fun(Int, Int)), [App(Const("int_of_num", Fun(Num, Int)), [Var("n", Num)])])
              ]
