def [int_INT_LE_CONV_v2, int_INT_LT_CONV_v2, int_INT_GE_CONV_v2, int_INT_GT_CONV_v2, INT_EQ_CONV]:
  let tth:
    TAUT(
      Host.hol_term(And(
        Iff(And(False, False), False),
        And(Iff(And(False, True), False), And(Iff(And(True, False), False), Iff(And(True, True), True)))
      ))
    )
  let nth = TAUT(Host.hol_term(And(Iff(Not(True), False), Iff(Not(False), True))))
  let NUM2_EQ_CONV = (BINOP_CONV(NUM_EQ_CONV) then_conv GEN_REWRITE_CONV(I)(PairList [tth]))
  let NUM2_NE_CONV = (RAND_CONV(NUM2_EQ_CONV) then_conv GEN_REWRITE_CONV(I)(PairList [nth]))
  let PairList [pth_le1, & PairList [pth_le2a, & PairList [pth_le2b, & PairList [pth_le3, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        Host.hol_term(And(
          Iff(
            App(
              Const("int_le", Fun(Int, Fun(Int, Bool))),
              [
                App(Const("int_neg", Fun(Int, Int)), [App(Const("int_of_num", Fun(Num, Int)), [Var("m", Num)])]),
                App(Const("int_of_num", Fun(Num, Int)), [Var("n", Num)])
              ]
            ),
            True
          ),
          And(
            Iff(
              App(
                Const("int_le", Fun(Int, Fun(Int, Bool))),
                [
                  App(Const("int_of_num", Fun(Num, Int)), [Var("m", Num)]),
                  App(Const("int_of_num", Fun(Num, Int)), [Var("n", Num)])
                ]
              ),
              App(Const("<=", Fun(Num, Fun(Num, Bool))), [Var("m", Num), Var("n", Num)])
            ),
            And(
              Iff(
                App(
                  Const("int_le", Fun(Int, Fun(Int, Bool))),
                  [
                    App(Const("int_neg", Fun(Int, Int)), [App(Const("int_of_num", Fun(Num, Int)), [Var("m", Num)])]),
                    App(Const("int_neg", Fun(Int, Int)), [App(Const("int_of_num", Fun(Num, Int)), [Var("n", Num)])])
                  ]
                ),
                App(Const("<=", Fun(Num, Fun(Num, Bool))), [Var("n", Num), Var("m", Num)])
              ),
              Iff(
                App(
                  Const("int_le", Fun(Int, Fun(Int, Bool))),
                  [
                    App(Const("int_of_num", Fun(Num, Int)), [Var("m", Num)]),
                    App(Const("int_neg", Fun(Int, Int)), [App(Const("int_of_num", Fun(Num, Int)), [Var("n", Num)])])
                  ]
                ),
                And(
                  Eq(Num, Var("m", Num), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])),
                  Eq(Num, Var("n", Num), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]))
                )
              )
            )
          )
        )),
        (
          (
            (
              REWRITE_TAC(PairList [INT_LE_NEG2]) then_tac \
              REWRITE_TAC(PairList [INT_LE_LNEG, INT_LE_RNEG])
            ) then_tac \
            REWRITE_TAC(PairList [INT_OF_NUM_ADD, INT_OF_NUM_LE, LE_0])
          ) then_tac \
          REWRITE_TAC(PairList [LE, ADD_EQ_0])
        )
