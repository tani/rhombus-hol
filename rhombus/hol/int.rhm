def INT_WLOG_LE:
  prove(
    [
      (hol:
         var P :: int -> int -> bool
         ((forall (x :: int, y :: int): P(x, y) <=> P(y, x))
            && (forall (x :: int, y :: int): x <= y ==> P(x, y)))
           ==> (forall (x :: int, y :: int): P(x, y))),
      MESON_TAC(PairList [INT_LE_TOTAL])
    ]
  )

def INT_WLOG_LT:
  prove(
    [
      (hol:
         var P :: int -> int -> bool
         ((forall x :: int: P(x, x))
            && ((forall (x :: int, y :: int): P(x, y) <=> P(y, x))
                  && (forall (x :: int, y :: int): x < y ==> P(x, y))))
           ==> (forall (x :: int, y :: int): P(x, y))),
      MESON_TAC(PairList [INT_LT_TOTAL])
    ]
  )

def INT_WLOG_LE_3:
  prove(
    [
      (hol:
         forall P :: int -> int -> int -> bool:
           ((forall (x :: int, y :: int, z :: int): P(x, y, z) ==> P(y, x, z) && P(x, z, y))
              && (forall (x :: int, y :: int, z :: int): x <= y && y <= z ==> P(x, y, z)))
             ==> (forall (x :: int, y :: int, z :: int): P(x, y, z))),
      MESON_TAC(PairList [INT_LE_TOTAL])
    ]
  )

def INT_FORALL_POS:
  prove(
    [
      (hol:
         const int_of_num :: num -> int
         forall P :: int -> bool:
           (forall n :: num: P(int_of_num(n))) <=> (forall i :: int: (0 :: int) <= i ==> P(i))),
      (
        (((GEN_TAC then_tac EQ_TAC) then_tac DISCH_TAC) then_tac GEN_TAC) then_list \
        PairList [
          (
            (
              (
                DISJ_CASES_THEN(CHOOSE_THEN(SUBST1_TAC))(SPEC(hol: var i :: int; i)(INT_IMAGE)) then_tac \
                ASM_REWRITE_TAC(PairList [INT_LE_RNEG, INT_ADD_LID, INT_OF_NUM_LE, LE])
              ) then_tac \
              DISCH_THEN(SUBST1_TAC)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [INT_NEG_0])
          ),
          (
            FIRST_ASSUM(MATCH_MP_TAC) then_tac \
            REWRITE_TAC(PairList [INT_OF_NUM_LE, LE_0])
          )
        ]
      )
    ]
  )

def INT_EXISTS_POS:
  prove(
    [
      (hol:
         const int_of_num :: num -> int
         forall P :: int -> bool:
           (exists n :: num: P(int_of_num(n))) <=> (exists i :: int: (0 :: int) <= i && P(i))),
      (
        (
          (
            GEN_TAC then_tac \
            GEN_REWRITE_TAC(I)(
              PairList [
                TAUT(
                  (hol:
                     var p :: bool
                     var q :: bool
                     (p <=> q) <=> (!p <=> !q))
                )
              ]
            )
          ) then_tac \
          REWRITE_TAC(PairList [NOT_EXISTS_THM, INT_FORALL_POS])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def INT_FORALL_ABS:
  prove(
    [
      (hol:
         const int_of_num :: num -> int
         const int_abs :: int -> int
         forall P :: int -> bool:
           (forall n :: num: P(int_of_num(n))) <=> (forall x :: int: P(int_abs(x)))),
      (
        REWRITE_TAC(PairList [INT_FORALL_POS]) then_tac \
        MESON_TAC(PairList [INT_ABS_POS, INT_ABS_REFL])
      )
    ]
  )

def INT_EXISTS_ABS:
  prove(
    [
      (hol:
         const int_of_num :: num -> int
         const int_abs :: int -> int
         forall P :: int -> bool:
           (exists n :: num: P(int_of_num(n))) <=> (exists x :: int: P(int_abs(x)))),
      (
        (
          (
            GEN_TAC then_tac \
            GEN_REWRITE_TAC(I)(
              PairList [
                TAUT(
                  (hol:
                     var p :: bool
                     var q :: bool
                     (p <=> q) <=> (!p <=> !q))
                )
              ]
            )
          ) then_tac \
          REWRITE_TAC(PairList [NOT_EXISTS_THM, INT_FORALL_ABS])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def INT_POW:
  prove(
    [
      (hol:
         var x :: int
         const int_pow :: int -> num -> int
         const SUC :: num -> num
         int_pow(x, (0 :: num)) == (1 :: int)
           && (forall n :: num: int_pow(x, SUC(n)) == x * int_pow(x, n))),
      REWRITE_TAC(map(INT_OF_REAL_THM)(CONJUNCTS(real_pow)))
    ]
  )

def INT_ABS:
  prove(
    [
      (hol:
         const int_abs :: int -> int
         forall x :: int: int_abs(x) == (if (0 :: int) <= x | x | -x)),
      (
        (
          (
            GEN_TAC then_tac \
            MP_TAC(INT_OF_REAL_THM(SPEC(hol: var x :: real; x)(real_abs)))
          ) then_tac \
          COND_CASES_TAC
        ) then_tac \
        REWRITE_TAC(PairList [int_eq])
      )
    ]
  )

def INT_GE:
  prove(
    [
      (hol:
         forall (x :: int, y :: int): x >= y <=> y <= x),
      REWRITE_TAC(PairList [int_ge, int_le, real_ge])
    ]
  )

def INT_GT:
  prove(
    [
      (hol:
         forall (x :: int, y :: int): x > y <=> y < x),
      REWRITE_TAC(PairList [int_gt, int_lt, real_gt])
    ]
  )

def INT_LT:
  prove(
    [
      (hol:
         forall (x :: int, y :: int): x < y <=> !(y <= x)),
      REWRITE_TAC(PairList [int_lt, int_le, real_lt])
    ]
  )

def int_INT_ARITH:
  let pth:
    prove(
      [
        (hol:
           var x :: int
           var y :: int
           (!(x <= y) <=> y + (1 :: int) <= x)
             && ((!(x < y) <=> y <= x)
                   && ((x != y <=> x + (1 :: int) <= y || y + (1 :: int) <= x)
                         && (x < y <=> x + (1 :: int) <= y)))),
        REWRITE_TAC(PairList [INT_NOT_LE, INT_NOT_LT, INT_NOT_EQ, INT_LT_DISCRETE])
      ]
    )
  let atom_CONV_2 = GEN_REWRITE_CONV(I)(PairList [pth])
  let bub_CONV_2:
    GEN_REWRITE_CONV(
      TOP_SWEEP_CONV)(
      PairList [
        int_eq,
        int_le,
        int_lt,
        int_ge,
        int_gt,
        int_of_num_th,
        int_neg_th,
        int_add_th,
        int_mul_th,
        int_sub_th,
        int_pow_th,
        int_abs_th,
        int_max_th,
        int_min_th
      ]
    )
  let base_CONV = (TRY_CONV(atom_CONV_2) then_conv bub_CONV_2)
  let NNF_NORM_CONV = GEN_NNF_CONV(#false)([base_CONV, (fun(t): [base_CONV(t), base_CONV(mk_neg(t))])])
  let init_CONV:
    (
      (
        (
          (
            (TOP_DEPTH_CONV(BETA_CONV) then_conv PRESIMP_CONV) then_conv \
