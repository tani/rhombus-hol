def int_INTEGER_TAC_v2:
  let gcd_tm = Host.hol_term(Const("int_gcd", Fun(Tyapp("prod", [Int, Int]), Int)))
  let dest_gcd:
    fun(tm):
      let [l, r] = dest_comb(tm)
      (if (l == gcd_tm) | dest_pair(r) | failwith("dest_gcd"))
  let GCD_ELIM_TAC:
    (
      REPEAT(GEN_TAC) then_tac \
      W(
        fun([asl, w]):
          let gts = find_terms(can(dest_gcd))(w)
          let ths:
            map(
              fun(tm):
                let [a_2, b] = dest_gcd(tm)
                SPECL(PairList [a_2, b])(int_gcd)
            )(gts)
          (
            MAP_EVERY(MP_TAC)(ths) then_tac \
            MAP_EVERY(SPEC_TAC)(zip(gts)(map(o(genvar)(type_of))(gts)))
          )
      )
    )
  let pth:
    prove(
      [
        Host.hol_term(Forall(
          "d",
          Int,
          Forall(
            "a",
            Int,
            Forall(
              "b",
              Int,
              Iff(
                App(
                  Const("int_divides", Fun(Int, Fun(Int, Bool))),
                  [
                    Ref("d"),
                    App(
                      Const("int_gcd", Fun(Tyapp("prod", [Int, Int]), Int)),
                      [App(Const(",", Fun(Int, Fun(Int, Tyapp("prod", [Int, Int])))), [Ref("a"), Ref("b")])]
                    )
                  ]
                ),
                And(
                  App(Const("int_divides", Fun(Int, Fun(Int, Bool))), [Ref("d"), Ref("a")]),
                  App(Const("int_divides", Fun(Int, Fun(Int, Bool))), [Ref("d"), Ref("b")])
                )
              )
            )
          )
        )),
        (GCD_ELIM_TAC then_tac int_INTEGER_TAC)
      ]
    )
  (
    (
      (
        GEN_REWRITE_TAC(TOP_DEPTH_CONV)(PairList [pth, INT_DIVIDES_ABS, INT_DIVIDES_LCM_GCD, INT_LCM_DIVIDES]) then_tac \
        REPEAT((GEN_TAC or_tac CONJ_TAC))
      ) then_tac \
      GCD_ELIM_TAC
    ) then_tac \
    int_INTEGER_TAC
  )

fun int_INTEGER_RULE_v2(tm): prove([tm, int_INTEGER_TAC_v2])

