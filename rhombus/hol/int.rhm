def integer = HolPair.new_definition(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"integer\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"real_abs\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]]]]"))

def is_int = Tactics.prove([Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"integer\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]],[\"Comb\",[\"Const\",\"real_neg\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]]]]]]"), Tactics.THEN(Tactics.THEN(Tactics.THEN(Simp.REWRITE_TAC(PairList.cons(integer,PairList [])))(Tactics.AP_TERM_TAC))(Tactics.ABS_TAC))(CalcRat.REAL_ARITH_TAC)])

def int_tybij:
  let port_tmp_1 = Simp.REWRITE_TAC(PairList.cons(is_int,PairList.cons(Realax.REAL_OF_NUM_EQ,PairList.cons(Theorems.EXISTS_OR_THM,PairList.cons(Equal.GSYM(Theorems.EXISTS_REFL),PairList [])))))
  let port_tmp_2 = Tactics.EXISTS_TAC(Host.expand_quote("[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"NUMERAL\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Const\",\"_0\",[\"Tyapp\",\"num\",[]]]]]"))
  Class.new_type_definition("int")(["int_of_real", "real_of_int"])(Tactics.prove([Host.expand_quote("[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]],[\"Comb\",[\"Const\",\"integer\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]]]"), Tactics.THEN(port_tmp_2)(port_tmp_1)]))

def [int_abstr, int_rep]:
  let port_tmp_3 = Bool.SPEC_ALL(Bool.CONJUNCT2(int_tybij))
