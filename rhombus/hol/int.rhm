def REAL_ZPOW_EQ_0:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall (x :: real, n :: int):
           real_zpow(x, n) == (0 :: real) <=> x == (0 :: real) && n != (0 :: int)),
      (
        REWRITE_TAC(PairList [FORALL_INT_CASES, REAL_ZPOW_POW, REAL_INV_EQ_0]) then_tac \
        REWRITE_TAC(PairList [INT_NEG_EQ_0, REAL_POW_EQ_0, INT_OF_NUM_EQ])
      )
    ]
  )

def REAL_ABS_ZPOW:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         const real_zpow :: real -> int -> real
         forall (x :: real, n :: int): real_abs(real_zpow(x, n)) == real_zpow(real_abs(x), n)),
