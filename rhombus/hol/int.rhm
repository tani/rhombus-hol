                  DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
                  ASM_SIMP_TAC(PairList [INT_DIVISION])
                ) then_tac \
                REWRITE_TAC(PairList [GSYM(INT_REM_EQ), INT_REM_REM])
