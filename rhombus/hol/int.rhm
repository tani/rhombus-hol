def INT_POW_CONV:
  let [pth1, pth2]:
    o(CONJ_PAIR)(prove)(
      [
        Host.hol_term(And(
          Eq(
            Int,
            App(
              Const("int_pow", Fun(Int, Fun(Num, Int))),
              [App(Const("int_of_num", Fun(Num, Int)), [Var("x", Num)]), Var("n", Num)]
            ),
            App(
              Const("int_of_num", Fun(Num, Int)),
              [App(Const("EXP", Fun(Num, Fun(Num, Num))), [Var("x", Num), Var("n", Num)])]
            )
          ),
          Eq(
            Int,
            App(
              Const("int_pow", Fun(Int, Fun(Num, Int))),
              [
                App(Const("int_neg", Fun(Int, Int)), [App(Const("int_of_num", Fun(Num, Int)), [Var("x", Num)])]),
                Var("n", Num)
              ]
            ),
            App(
              Const("COND", Fun(Bool, Fun(Int, Fun(Int, Int)))),
              [
                App(Const("EVEN", Fun(Num, Bool)), [Var("n", Num)]),
                App(
                  Const("int_of_num", Fun(Num, Int)),
                  [App(Const("EXP", Fun(Num, Fun(Num, Num))), [Var("x", Num), Var("n", Num)])]
                ),
                App(
                  Const("int_neg", Fun(Int, Int)),
                  [
                    App(
                      Const("int_of_num", Fun(Num, Int)),
                      [App(Const("EXP", Fun(Num, Fun(Num, Num))), [Var("x", Num), Var("n", Num)])]
                    )
                  ]
                )
              ]
            )
          )
        )),
        REWRITE_TAC(PairList [INT_OF_NUM_POW, INT_POW_NEG])
      ]
    )
  let tth:
    prove(
      [
        Host.hol_term(And(
          Eq(
            Int,
            App(Const("COND", Fun(Bool, Fun(Int, Fun(Int, Int)))), [True, Var("x", Int), Var("y", Int)]),
            Var("x", Int)
          ),
          Eq(
            Int,
            App(Const("COND", Fun(Bool, Fun(Int, Fun(Int, Int)))), [False, Var("x", Int), Var("y", Int)]),
            Var("y", Int)
          )
        )),
        REWRITE_TAC(PairList [])
      ]
    )
  let neg_tm = Host.hol_term(Const("int_neg", Fun(Int, Int)))
  (
    (GEN_REWRITE_CONV(I)(PairList [pth1]) then_conv RAND_CONV(NUM_EXP_CONV)) or_conv \
    (
      (
        (
          GEN_REWRITE_CONV(I)(PairList [pth2]) then_conv \
          RATOR_CONV(RATOR_CONV(RAND_CONV(NUM_EVEN_CONV)))
        ) then_conv \
        GEN_REWRITE_CONV(I)(PairList [tth])
      ) then_conv \
      (fun(tm): (if (rator(tm) == neg_tm) | RAND_CONV(RAND_CONV(NUM_EXP_CONV))(tm) | RAND_CONV(NUM_EXP_CONV)(tm)))
    )
  )

