    )
  let INT_LE_CONV:
    FIRST_CONV(
      PairList [
        GEN_REWRITE_CONV(I)(PairList [pth_le1]),
        (GEN_REWRITE_CONV(I)(PairList [pth_le2a, pth_le2b]) then_conv NUM_LE_CONV),
        (GEN_REWRITE_CONV(I)(PairList [pth_le3]) then_conv NUM2_EQ_CONV)
