        PairList [
          REWRITE_TAC(PairList [GSYM(int_of_num), int_of_num_th]),
          (
            POP_ASSUM(o(SUBST1_TAC)(SYM)) then_tac \
            ASM_REWRITE_TAC(PairList [GSYM(int_mul), int_mul_th])
          )
