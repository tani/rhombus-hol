def ARITH_RULE:
  let init_conv_2 = Equal.THENC(Equal.THENC(Equal.THENC(Equal.THENC(Grobner.NUM_SIMPLIFY_CONV)(Simp.GEN_REWRITE_CONV(Equal.DEPTH_CONV)(PairList.cons(Arith.ADD1, PairList []))))(Canon.PROP_ATOM_CONV(Equal.BINOP_CONV(Normalizer.NUM_NORMALIZE_CONV))))(Canon.PRENEX_CONV))(o(Simp.GEN_REWRITE_CONV(Equal.TOP_SWEEP_CONV))(map(Equal.GSYM))(PairList.cons(INT_OF_NUM_EQ, PairList.cons(INT_OF_NUM_LE, PairList.cons(INT_OF_NUM_LT, PairList.cons(INT_OF_NUM_GE, PairList.cons(INT_OF_NUM_GT, PairList.cons(INT_OF_NUM_ADD, PairList.cons(Bool.SPEC(Host.hol_term(Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Var("k", Tyapp("num", [])))))(INT_OF_NUM_MUL), PairList.cons(INT_OF_NUM_MAX, PairList.cons(INT_OF_NUM_MIN, PairList [])))))))))))
  let is_numimage_2:
    fun(t):
      match t
      | Fusion.Comb(Fusion.Const("int_of_num",_),n):
          if Host.hol_not(Nums.is_numeral(n))
          | #true
          | match t
            | _: #false
      | _: #false
  fun(tm):
    try:
      let th1 = init_conv_2(tm)
      let tm1 = Fusion.rand(Fusion.concl(th1))
      let [avs, bod] = Basics.strip_forall(tm1)
      let nim = Host.setify(Basics.find_terms(is_numimage_2)(bod))
      let gvs = map(o(Basics.genvar)(Fusion.type_of))(nim)
      let pths = map((fun(v): Bool.SPEC(Fusion.rand(v))(INT_POS)))(nim)
      let ibod = itlist(o(curry(Bool.mk_imp))(Fusion.concl))(pths)(bod)
      let gbod = Basics.subst(zip(gvs)(nim))(ibod)
      let th2 = Fusion.INST(zip(nim)(gvs))(int_INT_ARITH(gbod))
      let th3 = Bool.GENL(avs)(rev_itlist(C(Bool.MP))(pths)(th2))
      Fusion.EQ_MP(Equal.SYM(th1))(th3)
      ~catch exn:
        match exn
        | Failure(msg): failwith(Host.hol_concat("ARITH_RULE `")(Host.hol_concat(Host.string_of_term(tm))(Host.hol_concat("`: ")(msg))))
        | exn: Host.hol_raise(exn)

def ARITH_TAC = Tactics.CONV_TAC(o(Bool.EQT_INTRO)(ARITH_RULE))

def ASM_ARITH_TAC = Tactics.THEN(Tactics.REPEAT(Tactics.FIRST_X_ASSUM(o(Tactics.MP_TAC)(Host.check(o(o(Host.hol_not)(Basics.is_forall))(Fusion.concl))))))(ARITH_TAC)

