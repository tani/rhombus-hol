      MESON_TAC(PairList [INT_LT_TOTAL])
    ]
  )

def INT_WLOG_LE_3:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Int, Fun(Int, Fun(Int, Bool))),
        Implies(
          And(
            Forall(
              "x",
              Int,
              Forall(
                "y",
                Int,
                Forall(
                  "z",
                  Int,
                  Implies(
                    App(Ref("P"), [Ref("x"), Ref("y"), Ref("z")]),
                    And(
                      App(Ref("P"), [Ref("y"), Ref("x"), Ref("z")]),
                      App(Ref("P"), [Ref("x"), Ref("z"), Ref("y")])
                    )
                  )
                )
              )
            ),
            Forall(
              "x",
              Int,
              Forall(
                "y",
                Int,
                Forall(
                  "z",
                  Int,
                  Implies(
                    And(
                      App(Const("int_le", Fun(Int, Fun(Int, Bool))), [Ref("x"), Ref("y")]),
                      App(Const("int_le", Fun(Int, Fun(Int, Bool))), [Ref("y"), Ref("z")])
                    ),
                    App(Ref("P"), [Ref("x"), Ref("y"), Ref("z")])
                  )
                )
              )
            )
          ),
          Forall(
            "x",
            Int,
            Forall("y", Int, Forall("z", Int, App(Ref("P"), [Ref("x"), Ref("y"), Ref("z")])))
          )
        )
      )),
      MESON_TAC(PairList [INT_LE_TOTAL])
    ]
  )

def INT_FORALL_POS:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Int, Bool),
        Iff(
          Forall("n", Num, App(Ref("P"), [App(Const("int_of_num", Fun(Num, Int)), [Ref("n")])])),
          Forall(
            "i",
            Int,
            Implies(
              App(
                Const("int_le", Fun(Int, Fun(Int, Bool))),
                [
                  App(
                    Const("int_of_num", Fun(Num, Int)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  ),
                  Ref("i")
                ]
              ),
              App(Ref("P"), [Ref("i")])
            )
          )
        )
      )),
      (
        (((GEN_TAC then_tac EQ_TAC) then_tac DISCH_TAC) then_tac GEN_TAC) then_list \
        PairList [
          (
            (
              (
                DISJ_CASES_THEN(CHOOSE_THEN(SUBST1_TAC))(SPEC(Host.hol_term(Var("i", Int)))(INT_IMAGE)) then_tac \
                ASM_REWRITE_TAC(PairList [INT_LE_RNEG, INT_ADD_LID, INT_OF_NUM_LE, LE])
              ) then_tac \
              DISCH_THEN(SUBST1_TAC)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [INT_NEG_0])
          ),
          (
            FIRST_ASSUM(MATCH_MP_TAC) then_tac \
            REWRITE_TAC(PairList [INT_OF_NUM_LE, LE_0])
          )
        ]
      )
    ]
  )

def INT_EXISTS_POS:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Int, Bool),
        Iff(
          Exists("n", Num, App(Ref("P"), [App(Const("int_of_num", Fun(Num, Int)), [Ref("n")])])),
          Exists(
            "i",
            Int,
            And(
              App(
                Const("int_le", Fun(Int, Fun(Int, Bool))),
                [
                  App(
                    Const("int_of_num", Fun(Num, Int)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  ),
                  Ref("i")
                ]
              ),
              App(Ref("P"), [Ref("i")])
            )
          )
        )
      )),
      (
        (
          (
            GEN_TAC then_tac \
            GEN_REWRITE_TAC(I)(
              PairList [
                TAUT(
                  Host.hol_term(Iff(Iff(Var("p", Bool), Var("q", Bool)), Iff(Not(Var("p", Bool)), Not(Var("q", Bool)))))
                )
              ]
            )
          ) then_tac \
          REWRITE_TAC(PairList [NOT_EXISTS_THM, INT_FORALL_POS])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

