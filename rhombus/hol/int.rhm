          Int,
          Iff(
            App(Const("int_lt", Fun(Int, Fun(Int, Bool))), [Ref("x"), Ref("y")]),
            App(
              Const("int_le", Fun(Int, Fun(Int, Bool))),
              [
                App(
                  Const("int_add", Fun(Int, Fun(Int, Int))),
                  [
                    Ref("x"),
                    App(
                      Const("int_of_num", Fun(Num, Int)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                    )
                  ]
                ),
                Ref("y")
              ]
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [int_le, int_lt, int_add_th])) then_tac \
                              DISJ_CASES_THEN(X_CHOOSE_THEN(Host.hol_term(Var("m", Num)))(SUBST1_TAC))(SPEC(Host.hol_term(Var("x", Int)))(INT_IMAGE))
                            ) then_tac \
                            DISJ_CASES_THEN(X_CHOOSE_THEN(Host.hol_term(Var("n", Num)))(SUBST1_TAC))(SPEC(Host.hol_term(Var("y", Int)))(INT_IMAGE))
                          ) then_tac \
                          REWRITE_TAC(PairList [int_neg_th, int_of_num_th])
                        ) then_tac \
                        REWRITE_TAC(PairList [REAL_LE_NEG2, REAL_LT_NEG2])
                      ) then_tac \
                      REWRITE_TAC(PairList [REAL_LE_LNEG, REAL_LT_LNEG, REAL_LE_RNEG, REAL_LT_RNEG])
                    ) then_tac \
                    REWRITE_TAC(PairList [GSYM(REAL_ADD_ASSOC)])
                  ) then_tac \
                  ONCE_REWRITE_TAC(PairList [REAL_ADD_SYM])
                ) then_tac \
                REWRITE_TAC(PairList [GSYM(real_sub), REAL_LE_SUB_RADD])
              ) then_tac \
              REWRITE_TAC(PairList [REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_ADD])
            ) then_tac \
            REWRITE_TAC(
              PairList [
                GSYM(ADD1),
                ONCE_REWRITE_RULE(PairList [ADD_SYM])(GSYM(ADD1))
              ]
            )
          ) then_tac \
          REWRITE_TAC(
            PairList [
              SYM(
                REWRITE_CONV(PairList [ARITH_SUC])(
                  Host.hol_term(App(Const("SUC", Fun(Num, Num)), [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]))
                )
              )
            ]
          )
        ) then_tac \
        REWRITE_TAC(PairList [ADD_CLAUSES, LE_SUC_LT, LT_SUC_LE])
      )
    ]
  )

def INT_GT_DISCRETE:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Int,
        Forall(
          "y",
          Int,
          Iff(
            App(Const("int_gt", Fun(Int, Fun(Int, Bool))), [Ref("x"), Ref("y")]),
            App(
              Const("int_ge", Fun(Int, Fun(Int, Bool))),
              [
                Ref("x"),
                App(
                  Const("int_add", Fun(Int, Fun(Int, Int))),
                  [
                    Ref("y"),
                    App(
                      Const("int_of_num", Fun(Num, Int)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                    )
                  ]
                )
              ]
            )
          )
        )
      )),
      (
        REWRITE_TAC(
          PairList [
            int_gt,
            int_ge,
            real_ge,
            real_gt,
            GSYM(int_le),
            GSYM(int_lt)
          ]
        ) then_tac \
        MATCH_ACCEPT_TAC(INT_LT_DISCRETE)
      )
    ]
  )

fun is_intconst(tm):
  match tm
  | Comb(Const("int_of_num",_),n): is_numeral(n)
  | Comb(Const("int_neg",_),Comb(Const("int_of_num",_),n)): (is_numeral(n) && !(dest_numeral(n) == Host.num_0))
  | _: #false

fun dest_intconst(tm):
  match tm
  | Comb(Const("int_of_num",_),n): dest_numeral(n)
  | Comb(Const("int_neg",_),Comb(Const("int_of_num",_),n)):
      let nn = dest_numeral(n)
      (if (nn != Host.num_0) | Host.minus_num(dest_numeral(n)) | failwith("dest_intconst"))
  | _: failwith("dest_intconst")

def mk_intconst:
  let cast_tm_2 = Host.hol_term(Const("int_of_num", Fun(Num, Int)))
  let neg_tm_2 = Host.hol_term(Const("int_neg", Fun(Int, Int)))
  let mk_numconst = (fun(n): mk_comb([cast_tm_2, mk_numeral(n)]))
  (fun(x): (if (x < Host.num_0) | mk_comb([neg_tm_2, mk_numconst(Host.minus_num(x))]) | mk_numconst(x)))

def INT_OF_REAL_THM:
  let dest_2 = Host.hol_term(Const("real_of_int", Fun(Int, Real)))
  let real_ty_2 = Host.hol_term(Real)
  let int_ty_2 = Host.hol_term(Int)
  let cond_th_2:
    prove(
      [
        Host.hol_term(Eq(
          Real,
          App(
            Const("real_of_int", Fun(Int, Real)),
            [
              App(
                Const("COND", Fun(Bool, Fun(Int, Fun(Int, Int)))),
                [Var("b", Bool), Var("x", Int), Var("y", Int)]
              )
            ]
          ),
          App(
            Const("COND", Fun(Bool, Fun(Real, Fun(Real, Real)))),
            [
              Var("b", Bool),
              App(Const("real_of_int", Fun(Int, Real)), [Var("x", Int)]),
              App(Const("real_of_int", Fun(Int, Real)), [Var("y", Int)])
            ]
          )
        )),
        (COND_CASES_TAC then_tac REWRITE_TAC(PairList []))
      ]
    )
  let thlist:
    map(GSYM)(
      PairList [
        int_eq,
        int_le,
        int_lt,
        int_ge,
        int_gt,
        int_of_num_th,
        int_neg_th,
        int_add_th,
        int_mul_th,
        int_sgn_th,
        int_sub_th,
        int_abs_th,
        int_max_th,
        int_min_th,
        int_pow_th,
        cond_th_2
      ]
    )
  let REW_RULE = GEN_REWRITE_RULE(DEPTH_CONV)(thlist)
  let int_tm_of_real_var:
    fun(v):
      let [s, ty] = dest_var(v)
      (if (ty == real_ty_2) | mk_comb([dest_2, mk_var([s, int_ty_2])]) | v)
  let int_of_real_var:
    fun(v):
      let [s, ty] = dest_var(v)
      (if (ty == real_ty_2) | mk_var([s, int_ty_2]) | v)
  let INT_OF_REAL_THM1:
    fun(th):
      let newavs = subtract(frees(concl(th)))(freesl(hyp(th)))
      let [avs, bod] = strip_forall(concl(th))
      let allavs = append(newavs)(avs)
      let avs_prime = map(int_tm_of_real_var)(allavs)
      let avs_prime_prime = map(int_of_real_var)(avs)
      GENL(avs_prime_prime)(REW_RULE(SPECL(avs_prime)(GENL(newavs)(th))))
  fun INT_OF_REAL_THM(th): (if is_conj(concl(th)) | CONJ(INT_OF_REAL_THM(CONJUNCT1(th)))(INT_OF_REAL_THM(CONJUNCT2(th))) | INT_OF_REAL_THM1(th))
  INT_OF_REAL_THM

