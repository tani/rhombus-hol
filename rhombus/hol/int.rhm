def INT_WLOG_LE:
  prove(
    [
      Host.hol_term(Implies(
        And(
          Forall(
            "x",
            Int,
            Forall(
              "y",
              Int,
              Iff(
                App(Var("P", Fun(Int, Fun(Int, Bool))), [Ref("x"), Ref("y")]),
                App(Var("P", Fun(Int, Fun(Int, Bool))), [Ref("y"), Ref("x")])
              )
            )
          ),
          Forall(
            "x",
            Int,
            Forall(
              "y",
              Int,
              Implies(
                App(Const("int_le", Fun(Int, Fun(Int, Bool))), [Ref("x"), Ref("y")]),
                App(Var("P", Fun(Int, Fun(Int, Bool))), [Ref("x"), Ref("y")])
              )
            )
          )
        ),
        Forall(
          "x",
          Int,
          Forall("y", Int, App(Var("P", Fun(Int, Fun(Int, Bool))), [Ref("x"), Ref("y")]))
        )
      )),
      MESON_TAC(PairList [INT_LE_TOTAL])
    ]
  )

