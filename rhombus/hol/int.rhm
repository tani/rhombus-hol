          (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [int_max, real_max])) then_tac \
          COND_CASES_TAC
        ) then_tac \
        REWRITE_TAC(PairList [int_int_abstr_v2])
      )
    ]
  )

