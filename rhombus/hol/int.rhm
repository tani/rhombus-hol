  let BETA2_CONV_2 = (RATOR_CONV(BETA_CONV) then_conv BETA_CONV)
  let div_tm_2 = Host.hol_term(Const("div", Fun(Int, Fun(Int, Int))))
  let rem_tm_2 = Host.hol_term(Const("rem", Fun(Int, Fun(Int, Int))))
  let p_tm_3 = Host.hol_term(Var("P", Fun(Int, Fun(Int, Bool))))
  let m_tm_3 = Host.hol_term(Var("m", Int))
  let n_tm_4 = Host.hol_term(Var("n", Int))
  let is_div_2 = is_binop(div_tm_2)
  let is_rem_2 = is_binop(rem_tm_2)
  let is_divrem = (fun(tm): (is_div_2(tm) || is_rem_2(tm)))
  fun conv_2(tm):
    try:
      let t = hd(sort(free_in)(find_terms((fun(t): (is_divrem(t) && free_in(t)(tm))))(tm)))
      let x_2 = lhand(t)
      let y_2 = rand(t)
      let dtm_3 = mk_comb([mk_comb([div_tm_2, x_2]), y_2])
      let rtm_2 = mk_comb([mk_comb([rem_tm_2, x_2]), y_2])
      let vd_2 = genvar(type_of(dtm_3))
      let vr_2 = genvar(type_of(rtm_2))
      let p = list_mk_abs([PairList [vd_2, vr_2], subst(PairList [[vd_2, dtm_3], [vr_2, rtm_2]])(tm)])
      let th0 = INST(PairList [[p, p_tm_3], [x_2, m_tm_3], [y_2, n_tm_4]])(DIVREM_ELIM_THM_POS_2)
      let th1:
        try:
          let [ltm, rtm] = dest_conj(lhand(concl(th0)))
          MP(th0)(CONJ(INT_POS_RULE(rand(ltm)))(INT_POS_RULE(rand(rtm))))
          ~catch exn:
            match exn
            | Failure(_): INST(PairList [[p, p_tm_3], [x_2, m_tm_3], [y_2, n_tm_4]])(DIVREM_ELIM_THM_2)
            | exn: (throw exn)
      let th2:
        CONV_RULE(
          COMB2_CONV(RAND_CONV(BETA2_CONV_2))(Host.funpow(2)(BINDER_CONV)(RAND_CONV(BETA2_CONV_2)))
        )(th1)
      let th3 = CONV_RULE(RAND_CONV(Host.funpow(2)(BINDER_CONV)(INT_REDUCE_CONV)))(th2)
      CONV_RULE(RAND_CONV(BINDER_CONV(BINDER_CONV(RAND_CONV(conv_2)))))(th3)
      ~catch exn:
        match exn
        | Failure(_): REFL(tm)
        | exn: (throw exn)
  fun topconv(tm): (if (is_forall(tm) || is_exists(tm)) | BINDER_CONV(topconv)(tm) | conv_2(tm))
  let INT_DIVREM_ELIM_CONV = topconv
  let init_CONV:
    (
      (
        (
          (
            (
              (
                (TOP_DEPTH_CONV(BETA_CONV) then_conv PRESIMP_CONV) then_conv \
                GEN_REWRITE_CONV(DEPTH_CONV)(PairList [INT_GT, INT_GE])
              ) then_conv \
              NNF_CONV
            ) then_conv \
            DEPTH_BINOP_CONV(Host.hol_term(Const("\\/", Fun(Bool, Fun(Bool, Bool)))))(CONDS_ELIM_CONV)
          ) then_conv \
          INT_REDUCE_CONV
        ) then_conv \
        INT_DIVREM_ELIM_CONV
      ) then_conv \
      NNF_NORM_CONV
    )
  let p_tm_4 = Host.hol_term(Var("p", Bool))
  let not_tm_3 = Host.hol_term(Const("~", Fun(Bool, Bool)))
  let pth = TAUT(mk_eq([mk_neg(mk_neg(p_tm_4)), p_tm_4]))
  fun(tm):
    try:
      let th0_3 = INST(PairList [[tm, p_tm_4]])(pth)
      let th1_3 = init_CONV(mk_neg(tm))
      let th2 = REAL_ARITH(mk_neg(rand(concl(th1_3))))
      EQ_MP(th0_3)(EQ_MP(AP_TERM(not_tm_3)(SYM(th1_3)))(th2))
      ~catch exn:
        match exn
        | Failure(m):
            failwith(
              ("INT_ARITH `" +& (Host.string_of_term(tm) +& ("`: " +& m)))
            )
        | exn: (throw exn)

def int_INT_ARITH_TAC_v2 = CONV_TAC(o(EQT_INTRO)(int_INT_ARITH_v2))

def int_ASM_INT_ARITH_TAC_v2:
  (
    REPEAT(
      FIRST_X_ASSUM(o(MP_TAC)(Host.check(o(o((fun (x): !x))(is_forall))(concl))))
    ) then_tac \
    int_INT_ARITH_TAC_v2
  )

