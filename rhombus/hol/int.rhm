      (
        (
          (
            (
              (
                MATCH_MP_TAC(
                  TAUT(
                    Host.hol_term(Implies(
                      And(Implies(Var("a", Bool), Var("b", Bool)), Var("a", Bool)),
                      And(Var("a", Bool), Var("b", Bool))
                    ))
                  )
                ) then_tac \
                CONJ_TAC
              ) then_list \
              PairList [
                MESON_TAC(PairList [MULT_SYM]),
                SIMP_TAC(PairList [divides, LEFT_IMP_EXISTS_THM])
              ]
            ) then_tac \
            REPEAT(GEN_TAC)
          ) then_tac \
          ASM_CASES_TAC(
            Host.hol_term(Eq(Num, Var("p", Num), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])))
          )
        ) then_tac \
        ASM_SIMP_TAC(PairList [MULT_CLAUSES, DIV_0, GSYM(MULT_ASSOC), DIV_MULT])
      )
    ]
  )

def NUMBER_TAC:
  let conva = GEN_REWRITE_CONV(TRY_CONV)(PairList [GSYM(DIVIDES_ANTISYM)])
  fun antisym_conv(tm):
    if (is_forall(tm) || is_exists(tm))
    | BINDER_CONV(antisym_conv)(tm)
    | if (is_conj(tm) || is_disj(tm))
      | BINOP_CONV(antisym_conv)(tm)
      | (if is_imp(tm) | RAND_CONV(antisym_conv)(tm) | conva(tm))
  let pth_relativize:
    prove(
      [
        Host.hol_term(And(
          Iff(
            Forall(
              "n",
              Num,
              App(Var("P", Fun(Int, Bool)), [App(Const("int_of_num", Fun(Num, Int)), [Ref("n")])])
            ),
            Forall(
              "i",
              Int,
              Implies(
                App(
                  Const("int_le", Fun(Int, Fun(Int, Bool))),
                  [
                    App(
                      Const("int_of_num", Fun(Num, Int)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                    ),
                    Ref("i")
                  ]
                ),
                App(Var("P", Fun(Int, Bool)), [Ref("i")])
              )
            )
          ),
          Iff(
            Exists(
              "n",
              Num,
              App(Var("P", Fun(Int, Bool)), [App(Const("int_of_num", Fun(Num, Int)), [Ref("n")])])
            ),
            Exists(
              "i",
              Int,
              And(
                App(
                  Const("int_le", Fun(Int, Fun(Int, Bool))),
                  [
                    App(
                      Const("int_of_num", Fun(Num, Int)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                    ),
                    Ref("i")
                  ]
                ),
                App(Var("P", Fun(Int, Bool)), [Ref("i")])
              )
            )
          )
        )),
        (
          (
            GEN_REWRITE_TAC(RAND_CONV)(
              PairList [
                TAUT(
                  Host.hol_term(Iff(Iff(Var("a", Bool), Var("b", Bool)), Iff(Not(Var("a", Bool)), Not(Var("b", Bool)))))
                )
              ]
            ) then_tac \
            REWRITE_TAC(PairList [NOT_EXISTS_THM, INT_FORALL_POS])
          ) then_tac \
          MESON_TAC(PairList [])
        )
      ]
    )
  let relation_conv_3:
    GEN_REWRITE_CONV(TOP_SWEEP_CONV)(
      PairList [
        num_divides,
        num_congruent,
        num_coprime,
        NUM_GCD,
        NUM_LCM,
        & (
          map(GSYM)(
            PairList [
              INT_OF_NUM_EQ,
              INT_OF_NUM_LE,
              INT_OF_NUM_LT,
              INT_OF_NUM_GE,
              INT_OF_NUM_GT,
              INT_OF_NUM_SUC,
              INT_OF_NUM_ADD,
              INT_OF_NUM_MUL,
              INT_OF_NUM_POW
            ]
          )
        )
      ]
    )
  let quantifier_conv_3 = GEN_REWRITE_CONV(DEPTH_CONV)(PairList [pth_relativize])
  (
    (
      (
        (
          (
            (
              REPEAT(((CONJ_TAC or_tac GEN_TAC) or_tac EQ_TAC)) then_tac \
              CONV_TAC(antisym_conv)
            ) then_tac \
            W((fun([_, w]): MAP_EVERY((fun(v): SPEC_TAC([v, v])))(frees(w))))
          ) then_tac \
          CONV_TAC((relation_conv_3 then_conv quantifier_conv_3))
        ) then_tac \
        REWRITE_TAC(PairList [RIGHT_IMP_FORALL_THM])
      ) then_tac \
      REPEAT(GEN_TAC)
    ) then_tac \
    int_INTEGER_TAC_v2
  )

fun NUMBER_RULE(tm): prove([tm, NUMBER_TAC])

