                Implies(
                  App(Const("int_lt", Fun(Int, Fun(Int, Bool))), [Ref("x"), Ref("y")]),
                  App(Var("P", Fun(Int, Fun(Int, Bool))), [Ref("x"), Ref("y")])
                )
              )
            )
          )
        ),
        Forall(
          "x",
