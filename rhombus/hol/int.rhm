                    App(
                      Const("<=", Fun(Num, Fun(Num, Bool))),
                      [App(Const("*", Fun(Num, Fun(Num, Num))), [Var("a", Num), Var("b", Num)]), Var("b", Num)]
                    ),
                    App(
                      Const("<=", Fun(Num, Fun(Num, Bool))),
                      [
