def int_integer:«
  Up_pair.new_definition(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"integer\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"real_abs\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]]]]"))
»

def int_is_int:«
  Up_tactics.prove(Pair(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"integer\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]],[\"Comb\",[\"Const\",\"real_neg\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]]]]]]"),Up_tactics.THEN(Up_tactics.THEN(Up_tactics.THEN(Up_simp.REWRITE_TAC(PairList.cons(int_integer,PairList [])))(Up_tactics.AP_TERM_TAC))(Up_tactics.ABS_TAC))(Up_calc_rat.REAL_ARITH_TAC)))
»

def int_int_tybij:«
  Up_class.new_type_definition("int")(Pair("int_of_real","real_of_int"))(Up_tactics.prove(Pair(Host.expand_quote("[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]],[\"Comb\",[\"Const\",\"integer\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]]]"),(block:«
    let port_tmp_1 = Up_simp.REWRITE_TAC(PairList.cons(int_is_int,PairList.cons(Up_realax.REAL_OF_NUM_EQ,PairList.cons(Up_theorems.EXISTS_OR_THM,PairList.cons(Up_equal.GSYM(Up_theorems.EXISTS_REFL),PairList [])))));
    let port_tmp_2 = Up_tactics.EXISTS_TAC(Host.expand_quote("[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"NUMERAL\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Const\",\"_0\",[\"Tyapp\",\"num\",[]]]]]"));
    Up_tactics.THEN(port_tmp_2)(port_tmp_1)
  »))))
»

def Pair(int_int_abstr,int_int_rep):«
  (block:«
    let port_tmp_3 = Up_bool.SPEC_ALL(Up_bool.CONJUNCT2(int_int_tybij));
    let port_tmp_4 = Up_bool.SPEC_ALL(Up_bool.CONJUNCT1(int_int_tybij));
    Pair(port_tmp_4,port_tmp_3)
  »)
