        Eq(
          Int,
          App(Const("int_abs", Fun(Int, Int)), [Ref("x")]),
          App(
            Const("COND", Fun(Bool, Fun(Int, Fun(Int, Int)))),
            [
              App(
                Const("int_le", Fun(Int, Fun(Int, Bool))),
                [
                  App(
                    Const("int_of_num", Fun(Num, Int)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  ),
                  Ref("x")
                ]
              ),
              Ref("x"),
              App(Const("int_neg", Fun(Int, Int)), [Ref("x")])
            ]
          )
        )
      )),
      (
        (
          (
            GEN_TAC then_tac \
            MP_TAC(INT_OF_REAL_THM(SPEC(Host.hol_term(Var("x", Real)))(real_abs)))
          ) then_tac \
          COND_CASES_TAC
        ) then_tac \
        REWRITE_TAC(PairList [int_eq])
      )
    ]
  )

