              App(Const("real_zpow", Fun(Real, Fun(Int, Real))), [Ref("x"), Ref("n")]),
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              )
            ),
            And(
              Eq(
                Real,
                Ref("x"),
                App(
                  Const("real_of_num", Fun(Num, Real)),
                  [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                )
