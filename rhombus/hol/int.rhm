                    [
                      App(
                        Const("MOD", Fun(Num, Fun(Num, Num))),
                        [App(Const("EXP", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("k", Num)]), Var("n", Num)]
                      )
                    ]
                  ),
                  App(
                    Const("rem", Fun(Int, Fun(Int, Int))),
                    [
                      App(
                        Const("int_neg", Fun(Int, Int)),
                        [
                          App(
                            Const("int_of_num", Fun(Num, Int)),
                            [
                              App(
                                Const("MOD", Fun(Num, Fun(Num, Num))),
                                [App(Const("EXP", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("k", Num)]), Var("n", Num)]
                              )
                            ]
                          )
                        ]
                      ),
                      App(Const("int_of_num", Fun(Num, Int)), [Var("n", Num)])
                    ]
                  )
                ]
              )
            ),
            Eq(
              Int,
              App(
                Const("rem", Fun(Int, Fun(Int, Int))),
                [
                  App(
                    Const("int_pow", Fun(Int, Fun(Num, Int))),
                    [
                      App(Const("int_neg", Fun(Int, Int)), [App(Const("int_of_num", Fun(Num, Int)), [Var("m", Num)])]),
                      Var("k", Num)
                    ]
                  ),
                  App(Const("int_neg", Fun(Int, Int)), [App(Const("int_of_num", Fun(Num, Int)), [Var("n", Num)])])
                ]
              ),
              App(
                Const("COND", Fun(Bool, Fun(Int, Fun(Int, Int)))),
                [
                  App(Const("EVEN", Fun(Num, Bool)), [Var("k", Num)]),
                  App(
                    Const("int_of_num", Fun(Num, Int)),
                    [
                      App(
                        Const("MOD", Fun(Num, Fun(Num, Num))),
                        [App(Const("EXP", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("k", Num)]), Var("n", Num)]
                      )
                    ]
                  ),
                  App(
                    Const("rem", Fun(Int, Fun(Int, Int))),
                    [
                      App(
                        Const("int_neg", Fun(Int, Int)),
                        [
                          App(
                            Const("int_of_num", Fun(Num, Int)),
                            [
                              App(
                                Const("MOD", Fun(Num, Fun(Num, Num))),
                                [App(Const("EXP", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("k", Num)]), Var("n", Num)]
                              )
                            ]
                          )
                        ]
                      ),
                      App(Const("int_of_num", Fun(Num, Int)), [Var("n", Num)])
                    ]
                  )
                ]
              )
            )
          )
        )),
        (
          (
            (
              (REWRITE_TAC(PairList [INT_REM_RNEG, INT_POW_NEG]) then_tac COND_CASES_TAC) then_tac \
              ASM_REWRITE_TAC(PairList [GSYM(INT_OF_NUM_CLAUSES), GSYM(INT_OF_NUM_REM)])
            ) then_tac \
            CONV_TAC(INT_REM_DOWN_CONV)
          ) then_tac \
          REFL_TAC
        )
      ]
    )
  let conv:
    (
      (GEN_REWRITE_CONV(I)(PairList [pth_0]) then_conv RAND_CONV(EXP_MOD_CONV)) or_conv \
      (
        (
          (
            GEN_REWRITE_CONV(I)(PairList [pth_1]) then_conv \
            RATOR_CONV(LAND_CONV(NUM_EVEN_CONV))
          ) then_conv \
          GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES])
        ) then_conv \
        (
          RAND_CONV(EXP_MOD_CONV) or_conv \
          (
            LAND_CONV(
              RAND_CONV((RAND_CONV(EXP_MOD_CONV) then_conv TRY_CONV(INT_NEG_CONV)))
            ) then_conv \
            INT_REM_CONV
          )
        )
      )
    )
  fun(tm):
    match tm
    | Comb(Comb(Const("rem",_),Comb(Comb(Const("int_pow",_),m),k)),n):
        if (is_intconst(m) && (is_numeral(k) && is_intconst(n)))
        | conv(tm)
        | match tm
          | _: failwith("INT_POW_REM_CONV")
    | _: failwith("INT_POW_REM_CONV")

def WF_INT_MEASURE:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Forall(
          "m",
          Fun(Tvar("A"), Int),
          Implies(
            And(
              Forall(
                "x",
                Tvar("A"),
                App(
                  Const("int_le", Fun(Int, Fun(Int, Bool))),
                  [
                    App(
                      Const("int_of_num", Fun(Num, Int)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                    ),
                    App(Ref("m"), [Ref("x")])
                  ]
                )
              ),
              Forall(
                "x",
                Tvar("A"),
                Implies(
                  Forall(
                    "y",
                    Tvar("A"),
                    Implies(
                      App(
                        Const("int_lt", Fun(Int, Fun(Int, Bool))),
                        [App(Ref("m"), [Ref("y")]), App(Ref("m"), [Ref("x")])]
                      ),
                      App(Ref("P"), [Ref("y")])
                    )
                  ),
                  App(Ref("P"), [Ref("x")])
                )
              )
            ),
            Forall("x", Tvar("A"), App(Ref("P"), [Ref("x")]))
          )
        )
      )),
      (
        (
          (
            (
              REPEAT(STRIP_TAC) then_tac \
              SUBGOAL_THEN(
                Host.hol_term(Forall(
                  "n",
                  Num,
                  Forall(
                    "x",
                    Tvar("A"),
                    Implies(
                      Eq(
                        Int,
                        App(Var("m", Fun(Tvar("A"), Int)), [Ref("x")]),
                        App(Const("int_of_num", Fun(Num, Int)), [Ref("n")])
                      ),
                      App(Var("P", Fun(Tvar("A"), Bool)), [Ref("x")])
                    )
                  )
                ))
              )(MP_TAC)
            ) then_list \
            PairList [MATCH_MP_TAC(num_WF), ALL_TAC]
          ) then_tac \
          REWRITE_TAC(PairList [GSYM(INT_OF_NUM_LT), INT_FORALL_POS])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def WF_INT_MEASURE_2:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
        Forall(
          "m",
          Fun(Tvar("A"), Fun(Tvar("B"), Int)),
          Implies(
            And(
              Forall(
                "x",
                Tvar("A"),
                Forall(
                  "y",
                  Tvar("B"),
                  App(
                    Const("int_le", Fun(Int, Fun(Int, Bool))),
                    [
                      App(
                        Const("int_of_num", Fun(Num, Int)),
                        [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                      ),
                      App(Ref("m"), [Ref("x"), Ref("y")])
                    ]
                  )
                )
              ),
              Forall(
                "x",
                Tvar("A"),
                Forall(
                  "y",
                  Tvar("B"),
                  Implies(
                    Forall(
                      "x'",
                      Tvar("A"),
                      Forall(
                        "y'",
                        Tvar("B"),
                        Implies(
                          App(
                            Const("int_lt", Fun(Int, Fun(Int, Bool))),
                            [App(Ref("m"), [Ref("x'"), Ref("y'")]), App(Ref("m"), [Ref("x"), Ref("y")])]
                          ),
                          App(Ref("P"), [Ref("x'"), Ref("y'")])
                        )
                      )
                    ),
                    App(Ref("P"), [Ref("x"), Ref("y")])
                  )
                )
              )
            ),
            Forall("x", Tvar("A"), Forall("y", Tvar("B"), App(Ref("P"), [Ref("x"), Ref("y")])))
          )
        )
      )),
      REWRITE_TAC(PairList [FORALL_UNCURRY, GSYM(FORALL_PAIR_THM), WF_INT_MEASURE])
    ]
  )

def INT_GCD_EXISTS:
  let INT_GCD_EXISTS_CASES:
    int_INT_ARITH(
      Host.hol_term(Or(
        Or(
          Eq(
            Int,
            Var("a", Int),
            App(
              Const("int_of_num", Fun(Num, Int)),
              [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
            )
          ),
          Eq(
            Int,
            Var("b", Int),
            App(
              Const("int_of_num", Fun(Num, Int)),
              [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
            )
          )
        ),
        Or(
          App(
            Const("int_lt", Fun(Int, Fun(Int, Bool))),
            [
              App(
                Const("int_add", Fun(Int, Fun(Int, Int))),
                [
                  App(
                    Const("int_abs", Fun(Int, Int)),
                    [App(Const("int_sub", Fun(Int, Fun(Int, Int))), [Var("a", Int), Var("b", Int)])]
                  ),
                  App(Const("int_abs", Fun(Int, Int)), [Var("b", Int)])
                ]
              ),
              App(
                Const("int_add", Fun(Int, Fun(Int, Int))),
                [
                  App(Const("int_abs", Fun(Int, Int)), [Var("a", Int)]),
                  App(Const("int_abs", Fun(Int, Int)), [Var("b", Int)])
                ]
              )
            ]
          ),
          Or(
            App(
              Const("int_lt", Fun(Int, Fun(Int, Bool))),
              [
                App(
                  Const("int_add", Fun(Int, Fun(Int, Int))),
                  [
                    App(
                      Const("int_abs", Fun(Int, Int)),
                      [App(Const("int_add", Fun(Int, Fun(Int, Int))), [Var("a", Int), Var("b", Int)])]
                    ),
                    App(Const("int_abs", Fun(Int, Int)), [Var("b", Int)])
                  ]
                ),
                App(
                  Const("int_add", Fun(Int, Fun(Int, Int))),
                  [
                    App(Const("int_abs", Fun(Int, Int)), [Var("a", Int)]),
                    App(Const("int_abs", Fun(Int, Int)), [Var("b", Int)])
                  ]
                )
              ]
            ),
            Or(
              App(
                Const("int_lt", Fun(Int, Fun(Int, Bool))),
                [
                  App(
                    Const("int_add", Fun(Int, Fun(Int, Int))),
                    [
                      App(Const("int_abs", Fun(Int, Int)), [Var("a", Int)]),
                      App(
                        Const("int_abs", Fun(Int, Int)),
                        [App(Const("int_sub", Fun(Int, Fun(Int, Int))), [Var("b", Int), Var("a", Int)])]
                      )
                    ]
                  ),
                  App(
                    Const("int_add", Fun(Int, Fun(Int, Int))),
                    [
                      App(Const("int_abs", Fun(Int, Int)), [Var("a", Int)]),
                      App(Const("int_abs", Fun(Int, Int)), [Var("b", Int)])
                    ]
                  )
                ]
              ),
              App(
                Const("int_lt", Fun(Int, Fun(Int, Bool))),
                [
                  App(
                    Const("int_add", Fun(Int, Fun(Int, Int))),
                    [
                      App(Const("int_abs", Fun(Int, Int)), [Var("a", Int)]),
                      App(
                        Const("int_abs", Fun(Int, Int)),
                        [App(Const("int_add", Fun(Int, Fun(Int, Int))), [Var("b", Int), Var("a", Int)])]
                      )
                    ]
                  ),
                  App(
                    Const("int_add", Fun(Int, Fun(Int, Int))),
                    [
                      App(Const("int_abs", Fun(Int, Int)), [Var("a", Int)]),
                      App(Const("int_abs", Fun(Int, Int)), [Var("b", Int)])
                    ]
                  )
                ]
              )
            )
          )
        )
      ))
    )
  prove(
    [
      Host.hol_term(Forall(
        "a",
        Int,
        Forall(
          "b",
          Int,
          Exists(
            "d",
            Int,
            And(
              App(Const("int_divides", Fun(Int, Fun(Int, Bool))), [Ref("d"), Ref("a")]),
              And(
                App(Const("int_divides", Fun(Int, Fun(Int, Bool))), [Ref("d"), Ref("b")]),
                Exists(
                  "x",
                  Int,
                  Exists(
                    "y",
                    Int,
                    Eq(
                      Int,
                      Ref("d"),
                      App(
                        Const("int_add", Fun(Int, Fun(Int, Int))),
                        [
                          App(Const("int_mul", Fun(Int, Fun(Int, Int))), [Ref("a"), Ref("x")]),
                          App(Const("int_mul", Fun(Int, Fun(Int, Int))), [Ref("b"), Ref("y")])
                        ]
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  MATCH_MP_TAC(WF_INT_MEASURE_2) then_tac \
                  EXISTS_TAC(
                    Host.hol_term(Lambda(
                      "x",
                      Int,
                      Lambda(
                        "y",
                        Int,
                        App(
                          Const("int_add", Fun(Int, Fun(Int, Int))),
                          [
                            App(Const("int_abs", Fun(Int, Int)), [Ref("x")]),
                            App(Const("int_abs", Fun(Int, Int)), [Ref("y")])
                          ]
                        )
                      )
                    ))
                  )
                ) then_tac \
                REWRITE_TAC(PairList [])
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_list \
            PairList [int_INT_ARITH_TAC, ALL_TAC]
          ) then_tac \
          DISJ_CASES_THEN(MP_TAC)(INT_GCD_EXISTS_CASES)
        ) then_list \
        PairList [
          (
            (
              (
                STRIP_TAC then_tac \
                ASM_REWRITE_TAC(
                  PairList [
                    int_INTEGER_RULE(
                      Host.hol_term(App(
                        Const("int_divides", Fun(Int, Fun(Int, Bool))),
                        [
                          Var("d", Int),
                          App(
                            Const("int_of_num", Fun(Num, Int)),
                            [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                          )
                        ]
                      ))
                    )
                  ]
                )
              ) then_tac \
              REWRITE_TAC(PairList [INT_MUL_LZERO, INT_ADD_LID, INT_ADD_RID])
            ) then_tac \
            MESON_TAC(
              PairList [
                int_INTEGER_RULE(
                  Host.hol_term(App(Const("int_divides", Fun(Int, Fun(Int, Bool))), [Var("d", Int), Var("d", Int)]))
                ),
                INT_MUL_RID
              ]
            )
          ),
          (
            (
              DISCH_THEN(REPEAT_TCL(DISJ_CASES_THEN)(ANTE_RES_THEN(MP_TAC))) then_tac \
              MATCH_MP_TAC(MONO_EXISTS)
            ) then_tac \
            int_INTEGER_TAC
          )
        ]
      )
    ]
  )

