                          Const("real_of_int", Fun(Int, Real)),
                          [App(Const("int_max", Fun(Int, Fun(Int, Int))), [Ref("x"), Ref("y")])]
                        )
                      )
                    )
                  ),
                  And(
                    Forall(
                      "x",
                      Int,
                      Forall(
                        "y",
                        Int,
                        Eq(
                          Real,
                          App(
                            Const("real_min", Fun(Real, Fun(Real, Real))),
                            [
                              App(Const("real_of_int", Fun(Int, Real)), [Ref("x")]),
                              App(Const("real_of_int", Fun(Int, Real)), [Ref("y")])
                            ]
                          ),
                          App(
                            Const("real_of_int", Fun(Int, Real)),
                            [App(Const("int_min", Fun(Int, Fun(Int, Int))), [Ref("x"), Ref("y")])]
                          )
