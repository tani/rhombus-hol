          And(
            Forall(
              "x",
              Int,
              Forall(
                "y",
                Int,
                Iff(
                  App(Var("P", Fun(Int, Fun(Int, Bool))), [Ref("x"), Ref("y")]),
                  App(Var("P", Fun(Int, Fun(Int, Bool))), [Ref("y"), Ref("x")])
