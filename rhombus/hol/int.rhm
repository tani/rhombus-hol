fun is_intconst(tm):
  match tm
  | Fusion.Comb(Fusion.Const("int_of_num",_),n): Nums.is_numeral(n)
  | Fusion.Comb(Fusion.Const("int_neg",_),Fusion.Comb(Fusion.Const("int_of_num",_),n)): (Nums.is_numeral(n) && Host.hol_not(Host.hol_equal(Basics.dest_numeral(n))(Host.num_0)))
  | _: #false

fun dest_intconst(tm):
  match tm
  | Fusion.Comb(Fusion.Const("int_of_num",_),n): Basics.dest_numeral(n)
  | Fusion.Comb(Fusion.Const("int_neg",_),Fusion.Comb(Fusion.Const("int_of_num",_),n)):
      let nn = Basics.dest_numeral(n)
      (if Host.hol_unequal(nn)(Host.num_0) | Host.minus_num(Basics.dest_numeral(n)) | failwith("dest_intconst"))
  | _: failwith("dest_intconst")

def mk_intconst:
  let cast_tm_2 = Host.hol_term(Const("int_of_num", Tyapp("fun", [Tyapp("num", []), Tyapp("int", [])])))
  let neg_tm_2 = Host.hol_term(Const("int_neg", Tyapp("fun", [Tyapp("int", []), Tyapp("int", [])])))
  let mk_numconst = (fun(n): Fusion.mk_comb([cast_tm_2, Nums.mk_numeral(n)]))
  (fun(x): (if Host.hol_lt(x)(Host.num_0) | Fusion.mk_comb([neg_tm_2, mk_numconst(Host.minus_num(x))]) | mk_numconst(x)))

def INT_OF_REAL_THM:
  let dest_2 = Host.hol_term(Const("real_of_int", Tyapp("fun", [Tyapp("int", []), Tyapp("real", [])])))
  let real_ty_2 = Host.hol_term(Tyapp("real", []))
  let int_ty_2 = Host.hol_term(Tyapp("int", []))
  let cond_th_2 = Tactics.prove([Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("real", []), Tyapp("fun", [Tyapp("real", []), Tyapp("bool", [])])])), Comb(Const("real_of_int", Tyapp("fun", [Tyapp("int", []), Tyapp("real", [])])), Comb(Comb(Comb(Const("COND", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("int", []), Tyapp("fun", [Tyapp("int", []), Tyapp("int", [])])])])), Var("b", Tyapp("bool", []))), Var("x", Tyapp("int", []))), Var("y", Tyapp("int", []))))), Comb(Comb(Comb(Const("COND", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("real", []), Tyapp("fun", [Tyapp("real", []), Tyapp("real", [])])])])), Var("b", Tyapp("bool", []))), Comb(Const("real_of_int", Tyapp("fun", [Tyapp("int", []), Tyapp("real", [])])), Var("x", Tyapp("int", [])))), Comb(Const("real_of_int", Tyapp("fun", [Tyapp("int", []), Tyapp("real", [])])), Var("y", Tyapp("int", [])))))), Tactics.THEN(Class.COND_CASES_TAC)(Simp.REWRITE_TAC(PairList []))])
  let thlist = map(Equal.GSYM)(PairList.cons(int_eq, PairList.cons(int_le, PairList.cons(int_lt, PairList.cons(int_ge, PairList.cons(int_gt, PairList.cons(int_of_num_th, PairList.cons(int_neg_th, PairList.cons(int_add_th, PairList.cons(int_mul_th, PairList.cons(int_sgn_th, PairList.cons(int_sub_th, PairList.cons(int_abs_th, PairList.cons(int_max_th, PairList.cons(int_min_th, PairList.cons(int_pow_th, PairList.cons(cond_th_2, PairList [])))))))))))))))))
  let REW_RULE = Simp.GEN_REWRITE_RULE(Equal.DEPTH_CONV)(thlist)
  let int_tm_of_real_var:
    fun(v):
      let [s, ty] = Fusion.dest_var(v)
      (if Host.hol_equal(ty)(real_ty_2) | Fusion.mk_comb([dest_2, Fusion.mk_var([s, int_ty_2])]) | v)
  let int_of_real_var:
    fun(v):
      let [s, ty] = Fusion.dest_var(v)
      (if Host.hol_equal(ty)(real_ty_2) | Fusion.mk_var([s, int_ty_2]) | v)
  let INT_OF_REAL_THM1:
    fun(th):
      let newavs = subtract(Fusion.frees(Fusion.concl(th)))(Fusion.freesl(Fusion.hyp(th)))
      let [avs, bod] = Basics.strip_forall(Fusion.concl(th))
      let allavs = append(newavs)(avs)
      let avs_prime = map(int_tm_of_real_var)(allavs)
      let avs_prime_prime = map(int_of_real_var)(avs)
      Bool.GENL(avs_prime_prime)(REW_RULE(Bool.SPECL(avs_prime)(Bool.GENL(newavs)(th))))
  fun INT_OF_REAL_THM(th): (if Basics.is_conj(Fusion.concl(th)) | Bool.CONJ(INT_OF_REAL_THM(Bool.CONJUNCT1(th)))(INT_OF_REAL_THM(Bool.CONJUNCT2(th))) | INT_OF_REAL_THM1(th))
  INT_OF_REAL_THM

