def int_INT_ARITH:
  let pth:
    prove(
      [
        Host.hol_term(And(
          Iff(
            Not(App(Const("int_le", Fun(Int, Fun(Int, Bool))), [Var("x", Int), Var("y", Int)])),
            App(
              Const("int_le", Fun(Int, Fun(Int, Bool))),
              [
                App(
                  Const("int_add", Fun(Int, Fun(Int, Int))),
                  [
                    Var("y", Int),
                    App(
                      Const("int_of_num", Fun(Num, Int)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                    )
                  ]
                ),
                Var("x", Int)
              ]
            )
          ),
          And(
            Iff(
              Not(App(Const("int_lt", Fun(Int, Fun(Int, Bool))), [Var("x", Int), Var("y", Int)])),
              App(Const("int_le", Fun(Int, Fun(Int, Bool))), [Var("y", Int), Var("x", Int)])
            ),
            And(
              Iff(
                Not(Eq(Int, Var("x", Int), Var("y", Int))),
                Or(
                  App(
                    Const("int_le", Fun(Int, Fun(Int, Bool))),
                    [
                      App(
                        Const("int_add", Fun(Int, Fun(Int, Int))),
                        [
                          Var("x", Int),
                          App(
                            Const("int_of_num", Fun(Num, Int)),
                            [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                          )
                        ]
                      ),
                      Var("y", Int)
                    ]
                  ),
                  App(
                    Const("int_le", Fun(Int, Fun(Int, Bool))),
                    [
                      App(
                        Const("int_add", Fun(Int, Fun(Int, Int))),
                        [
                          Var("y", Int),
                          App(
                            Const("int_of_num", Fun(Num, Int)),
                            [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                          )
                        ]
                      ),
                      Var("x", Int)
                    ]
                  )
                )
              ),
              Iff(
                App(Const("int_lt", Fun(Int, Fun(Int, Bool))), [Var("x", Int), Var("y", Int)]),
                App(
                  Const("int_le", Fun(Int, Fun(Int, Bool))),
                  [
                    App(
                      Const("int_add", Fun(Int, Fun(Int, Int))),
                      [
                        Var("x", Int),
                        App(
                          Const("int_of_num", Fun(Num, Int)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                        )
                      ]
                    ),
                    Var("y", Int)
                  ]
                )
              )
            )
          )
        )),
        REWRITE_TAC(PairList [INT_NOT_LE, INT_NOT_LT, INT_NOT_EQ, INT_LT_DISCRETE])
      ]
    )
  let atom_CONV_2 = GEN_REWRITE_CONV(I)(PairList [pth])
  let bub_CONV_2:
    GEN_REWRITE_CONV(
      TOP_SWEEP_CONV)(
      PairList [
        int_eq,
        int_le,
        int_lt,
        int_ge,
        int_gt,
        int_of_num_th,
        int_neg_th,
        int_add_th,
        int_mul_th,
        int_sub_th,
        int_pow_th,
        int_abs_th,
        int_max_th,
        int_min_th
      ]
    )
  let base_CONV = (TRY_CONV(atom_CONV_2) then_conv bub_CONV_2)
  let NNF_NORM_CONV = GEN_NNF_CONV(#false)([base_CONV, (fun(t): [base_CONV(t), base_CONV(mk_neg(t))])])
  let init_CONV:
    (
      (
        (
          (
            (TOP_DEPTH_CONV(BETA_CONV) then_conv PRESIMP_CONV) then_conv \
            GEN_REWRITE_CONV(DEPTH_CONV)(PairList [INT_GT, INT_GE])
          ) then_conv \
          NNF_CONV
        ) then_conv \
        DEPTH_BINOP_CONV(Host.hol_term(Const("\\/", Fun(Bool, Fun(Bool, Bool)))))(CONDS_ELIM_CONV)
      ) then_conv \
      NNF_NORM_CONV
    )
  let p_tm_2 = Host.hol_term(Var("p", Bool))
  let not_tm_2 = Host.hol_term(Const("~", Fun(Bool, Bool)))
  let pth = TAUT(mk_eq([mk_neg(mk_neg(p_tm_2)), p_tm_2]))
  fun(tm):
    let th0_2 = INST(PairList [[tm, p_tm_2]])(pth)
    let th1_2 = init_CONV(mk_neg(tm))
    let th2 = REAL_ARITH(mk_neg(rand(concl(th1_2))))
    EQ_MP(th0_2)(EQ_MP(AP_TERM(not_tm_2)(SYM(th1_2)))(th2))

