  let PairList [pth_gt1, & PairList [pth_gt2a, & PairList [pth_gt2b, & PairList [pth_gt3, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        (hol:
           var m :: num
           var n :: num
           const int_of_num :: num -> int
           (-int_of_num(m) > int_of_num(n) <=> #false)
             && ((int_of_num(m) > int_of_num(n) <=> n < m)
                   && ((-int_of_num(m) > -int_of_num(n) <=> m < n)
                         && (int_of_num(m) > -int_of_num(n) <=> !(m == (0 :: num) && n == (0 :: num)))))),
        (
          REWRITE_TAC(PairList [pth_lt1, pth_lt2a, pth_lt2b, pth_lt3, INT_GT]) then_tac \
          CONV_TAC(TAUT)
        )
      ]
    )
  let INT_GT_CONV:
    FIRST_CONV(
      PairList [
        GEN_REWRITE_CONV(I)(PairList [pth_gt1]),
        (GEN_REWRITE_CONV(I)(PairList [pth_gt2a, pth_gt2b]) then_conv NUM_LT_CONV),
        (GEN_REWRITE_CONV(I)(PairList [pth_gt3]) then_conv NUM2_NE_CONV)
      ]
    )
  let PairList [pth_eq1a, & PairList [pth_eq1b, & PairList [pth_eq2a, & PairList [pth_eq2b, & PairList []]]]]:
    o(CONJUNCTS)(prove)(
      [
        (hol:
           var m :: num
           var n :: num
           const int_of_num :: num -> int
           (int_of_num(m) == int_of_num(n) <=> m == n)
             && ((-int_of_num(m) == -int_of_num(n) <=> m == n)
                   && ((-int_of_num(m) == int_of_num(n) <=> m == (0 :: num) && n == (0 :: num))
                         && (int_of_num(m) == -int_of_num(n) <=> m == (0 :: num) && n == (0 :: num))))),
        (
          (
            REWRITE_TAC(PairList [GSYM(INT_LE_ANTISYM), GSYM(LE_ANTISYM)]) then_tac \
            REWRITE_TAC(PairList [pth_le1, pth_le2a, pth_le2b, pth_le3, LE, LE_0])
          ) then_tac \
          CONV_TAC(TAUT)
        )
      ]
    )
  let INT_EQ_CONV:
    FIRST_CONV(
      PairList [
        (GEN_REWRITE_CONV(I)(PairList [pth_eq1a, pth_eq1b]) then_conv NUM_EQ_CONV),
        (GEN_REWRITE_CONV(I)(PairList [pth_eq2a, pth_eq2b]) then_conv NUM2_EQ_CONV)
      ]
    )
  [INT_LE_CONV, INT_LT_CONV, INT_GE_CONV, INT_GT_CONV, INT_EQ_CONV]

def INT_NEG_CONV:
  let pth:
    prove(
      [
        (hol:
           var x :: num
           const int_of_num :: num -> int
           -(0 :: int) == (0 :: int) && -(-int_of_num(x)) == int_of_num(x)),
        REWRITE_TAC(PairList [INT_NEG_NEG, INT_NEG_0])
      ]
    )
  GEN_REWRITE_CONV(I)(PairList [pth])

def INT_MUL_CONV:
  let pth0_2:
    prove(
      [
        (hol:
           var x :: num
           const int_of_num :: num -> int
           (0 :: int) * int_of_num(x) == (0 :: int)
             && ((0 :: int) * (-int_of_num(x)) == (0 :: int)
                   && (int_of_num(x) * (0 :: int) == (0 :: int)
                         && (-int_of_num(x)) * (0 :: int) == (0 :: int)))),
        REWRITE_TAC(PairList [INT_MUL_LZERO, INT_MUL_RZERO])
      ]
    )
  let [pth1_2, pth2_2]:
    o(CONJ_PAIR)(prove)(
      [
        (hol:
           var m :: num
           var n :: num
           const int_of_num :: num -> int
           int_of_num(m) * int_of_num(n) == int_of_num(m * n)
             && (-int_of_num(m)) * (-int_of_num(n)) == int_of_num(m * n)
             && ((-int_of_num(m)) * int_of_num(n) == -int_of_num(m * n)
                   && int_of_num(m) * (-int_of_num(n)) == -int_of_num(m * n))),
        (
          REWRITE_TAC(PairList [INT_MUL_LNEG, INT_MUL_RNEG, INT_NEG_NEG]) then_tac \
          REWRITE_TAC(PairList [INT_OF_NUM_MUL])
        )
      ]
    )
  FIRST_CONV(
    PairList [
      GEN_REWRITE_CONV(I)(PairList [pth0_2]),
      (GEN_REWRITE_CONV(I)(PairList [pth1_2]) then_conv RAND_CONV(NUM_MULT_CONV)),
      (
        GEN_REWRITE_CONV(I)(PairList [pth2_2]) then_conv \
        RAND_CONV(RAND_CONV(NUM_MULT_CONV))
      )
    ]
  )

def INT_ADD_CONV:
  let neg_tm = hol: const int_neg :: int -> int; int_neg
  let amp_tm = hol: const int_of_num :: num -> int; int_of_num
  let add_tm = hol: const int_add :: int -> int -> int; int_add
  let dest = dest_binop(hol: const int_add :: int -> int -> int; int_add)
  let m_tm_2 = hol: var m :: num; m
  let n_tm_2 = hol: var n :: num; n
  let pth0:
    prove(
      [
        (hol:
           var m :: num
           const int_of_num :: num -> int
           -int_of_num(m) + int_of_num(m) == (0 :: int) && int_of_num(m) + -int_of_num(m) == (0 :: int)),
        REWRITE_TAC(PairList [INT_ADD_LINV, INT_ADD_RINV])
      ]
    )
  let PairList [pth1, & PairList [pth2, & PairList [pth3, & PairList [pth4, & PairList [pth5, & PairList [pth6, & PairList []]]]]]]:
    o(CONJUNCTS)(prove)(
      [
        (hol:
           var m :: num
           var n :: num
           const int_of_num :: num -> int
           -int_of_num(m) + -int_of_num(n) == -int_of_num(m + n)
             && (-int_of_num(m) + int_of_num(m + n) == int_of_num(n)
                   && (-int_of_num(m + n) + int_of_num(m) == -int_of_num(n)
                         && (int_of_num(m + n) + -int_of_num(m) == int_of_num(n)
                               && (int_of_num(m) + -int_of_num(m + n) == -int_of_num(n)
                                     && int_of_num(m) + int_of_num(n) == int_of_num(m + n)))))),
        (
          (
            (
              (
                (
                  REWRITE_TAC(PairList [GSYM(INT_OF_NUM_ADD), INT_NEG_ADD]) then_tac \
                  REWRITE_TAC(PairList [INT_ADD_ASSOC, INT_ADD_LINV, INT_ADD_LID])
                ) then_tac \
                REWRITE_TAC(PairList [INT_ADD_RINV, INT_ADD_LID])
              ) then_tac \
              ONCE_REWRITE_TAC(PairList [INT_ADD_SYM])
            ) then_tac \
            REWRITE_TAC(PairList [INT_ADD_ASSOC, INT_ADD_LINV, INT_ADD_LID])
          ) then_tac \
          REWRITE_TAC(PairList [INT_ADD_RINV, INT_ADD_LID])
        )
      ]
    )
  (
    GEN_REWRITE_CONV(I)(PairList [pth0]) or_conv \
    (
      fun(tm):
        try:
          let [l, r] = dest(tm)
          if (!is_intconst(l) || !is_intconst(r))
          | failwith("")
          | if (rator(l) == neg_tm)
            | if (rator(r) == neg_tm)
              | let th1 = INST(PairList [[rand(rand(l)), m_tm_2], [rand(rand(r)), n_tm_2]])(pth1)
                let tm1 = rand(rand(rand(concl(th1))))
                let th2 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(NUM_ADD_CONV(tm1)))
                TRANS(th1)(th2)
              | let m_2 = rand(rand(l))
                let n_2 = rand(r)
                let m_prime_2 = dest_numeral(m_2)
                let n_prime_2 = dest_numeral(n_2)
                if (m_prime_2 <= n_prime_2)
                | let p = mk_numeral((n_prime_2 - m_prime_2))
                  let th1 = INST(PairList [[m_2, m_tm_2], [p, n_tm_2]])(pth2)
                  let th2 = NUM_ADD_CONV(rand(rand(lhand(concl(th1)))))
                  let th3 = AP_TERM(rator(tm))(AP_TERM(amp_tm)(SYM(th2)))
                  TRANS(th3)(th1)
                | let p = mk_numeral((m_prime_2 - n_prime_2))
                  let th1 = INST(PairList [[n_2, m_tm_2], [p, n_tm_2]])(pth3)
                  let th2 = NUM_ADD_CONV(rand(rand(lhand(lhand(concl(th1))))))
                  let th3 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_THM(AP_TERM(add_tm)(th3))(rand(tm))
                  TRANS(th4)(th1)
            | if (rator(r) == neg_tm)
              | let m_3 = rand(l)
                let n_3 = rand(rand(r))
                let m_prime_3 = dest_numeral(m_3)
                let n_prime_3 = dest_numeral(n_3)
                if (n_prime_3 <= m_prime_3)
                | let p = mk_numeral((m_prime_3 - n_prime_3))
                  let th1 = INST(PairList [[n_3, m_tm_2], [p, n_tm_2]])(pth4)
                  let th2 = NUM_ADD_CONV(rand(lhand(lhand(concl(th1)))))
                  let th3 = AP_TERM(add_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_THM(th3)(rand(tm))
                  TRANS(th4)(th1)
                | let p = mk_numeral((n_prime_3 - m_prime_3))
                  let th1 = INST(PairList [[m_3, m_tm_2], [p, n_tm_2]])(pth5)
                  let th2 = NUM_ADD_CONV(rand(rand(rand(lhand(concl(th1))))))
                  let th3 = AP_TERM(neg_tm)(AP_TERM(amp_tm)(SYM(th2)))
                  let th4 = AP_TERM(rator(tm))(th3)
                  TRANS(th4)(th1)
              | let th1 = INST(PairList [[rand(l), m_tm_2], [rand(r), n_tm_2]])(pth6)
                let tm1 = rand(rand(concl(th1)))
                let th2 = AP_TERM(amp_tm)(NUM_ADD_CONV(tm1))
                TRANS(th1)(th2)
          ~catch exn:
            match exn
            | Failure(_): failwith("INT_ADD_CONV")
            | exn: (throw exn)
    )
  )

def INT_SUB_CONV:
  (
    (
      GEN_REWRITE_CONV(I)(PairList [INT_SUB]) then_conv \
      TRY_CONV(RAND_CONV(INT_NEG_CONV))
    ) then_conv \
    INT_ADD_CONV
  )

def INT_POW_CONV:
  let [pth1, pth2]:
    o(CONJ_PAIR)(prove)(
      [
        (hol:
           var x :: num
           var n :: num
           const int_pow :: int -> num -> int
           const int_of_num :: num -> int
           const EXP :: num -> num -> num
           const EVEN :: num -> bool
           int_pow(int_of_num(x), n) == int_of_num(EXP(x, n))
             && (int_pow(-int_of_num(x), n)
                   == (if EVEN(n) | int_of_num(EXP(x, n)) | -int_of_num(EXP(x, n))))),
        REWRITE_TAC(PairList [INT_OF_NUM_POW, INT_POW_NEG])
      ]
    )
  let tth:
    prove(
      [
        (hol:
           var x :: int
           var y :: int
           (if #true | x | y) == x && (if #false | x | y) == y),
        REWRITE_TAC(PairList [])
      ]
    )
  let neg_tm = hol: const int_neg :: int -> int; int_neg
  (
    (GEN_REWRITE_CONV(I)(PairList [pth1]) then_conv RAND_CONV(NUM_EXP_CONV)) or_conv \
    (
      (
        (
          GEN_REWRITE_CONV(I)(PairList [pth2]) then_conv \
          RATOR_CONV(RATOR_CONV(RAND_CONV(NUM_EVEN_CONV)))
        ) then_conv \
        GEN_REWRITE_CONV(I)(PairList [tth])
      ) then_conv \
      (fun(tm): (if (rator(tm) == neg_tm) | RAND_CONV(RAND_CONV(NUM_EXP_CONV))(tm) | RAND_CONV(NUM_EXP_CONV)(tm)))
    )
  )

def INT_ABS_CONV:
  let pth:
    prove(
      [
        (hol:
           var x :: num
           const int_abs :: int -> int
           const int_of_num :: num -> int
           int_abs(-int_of_num(x)) == int_of_num(x) && int_abs(int_of_num(x)) == int_of_num(x)),
        REWRITE_TAC(PairList [INT_ABS_NEG, INT_ABS_NUM])
      ]
    )
  GEN_REWRITE_CONV(I)(PairList [pth])

def INT_MAX_CONV:
  (
    (
      REWR_CONV(INT_MAX) then_conv \
      RATOR_CONV(RATOR_CONV(RAND_CONV(int_INT_LE_CONV_v2)))
    ) then_conv \
    GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES])
  )

def INT_MIN_CONV:
  (
    (
      REWR_CONV(INT_MIN) then_conv \
      RATOR_CONV(RATOR_CONV(RAND_CONV(int_INT_LE_CONV_v2)))
    ) then_conv \
