  let atom_CONV_3 = GEN_REWRITE_CONV(I)(PairList [pth])
  let bub_CONV_3:
    GEN_REWRITE_CONV(
      TOP_SWEEP_CONV)(
      PairList [
        int_eq,
        int_le,
        int_lt,
        int_ge,
