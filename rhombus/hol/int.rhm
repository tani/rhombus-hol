    ]
  )

def INT_LCM:
  prove(
    [
      (hol:
         const int_divides :: int -> int -> bool
         const int_lcm :: pair(int, int) -> int
         const #{|,|} :: A -> B -> pair(A, B)
         forall (m :: int, n :: int):
           int_divides(m, int_lcm(const.#{|,|}(m, n)))
             && (int_divides(n, int_lcm(const.#{|,|}(m, n)))
                   && (forall d :: int:
                         int_divides(m, d) && int_divides(n, d) ==> int_divides(int_lcm(const.#{|,|}(m, n)), d)))),
      (
        (
          (
            REWRITE_TAC(PairList [INT_LCM_DIVIDES, INT_DIVIDES_LCM_GCD]) then_tac \
            REPEAT(GEN_TAC)
          ) then_tac \
          MP_TAC(SPECL(PairList [(hol: var m :: int; m), (hol: var n :: int; n)])(int_gcd))
        ) then_tac \
        int_INTEGER_TAC
      )
    ]
  )

def int_INTEGER_TAC_v2:
  let gcd_tm = hol: const int_gcd :: pair(int, int) -> int; int_gcd
  let dest_gcd:
    fun(tm):
      let [l, r] = dest_comb(tm)
      (if (l == gcd_tm) | dest_pair(r) | failwith("dest_gcd"))
  let GCD_ELIM_TAC:
    (
      REPEAT(GEN_TAC) then_tac \
      W(
        fun([asl, w]):
          let gts = find_terms(can(dest_gcd))(w)
          let ths:
            map(
              fun(tm):
                let [a_2, b] = dest_gcd(tm)
                SPECL(PairList [a_2, b])(int_gcd)
            )(gts)
          (
            MAP_EVERY(MP_TAC)(ths) then_tac \
            MAP_EVERY(SPEC_TAC)(zip(gts)(map(o(genvar)(type_of))(gts)))
          )
      )
    )
  let pth:
    prove(
      [
        (hol:
           const int_divides :: int -> int -> bool
           const int_gcd :: pair(int, int) -> int
           const #{|,|} :: A -> B -> pair(A, B)
           forall (d :: int, a :: int, b :: int):
             int_divides(d, int_gcd(const.#{|,|}(a, b))) <=> int_divides(d, a) && int_divides(d, b)),
        (GCD_ELIM_TAC then_tac int_INTEGER_TAC)
      ]
    )
  (
    (
      (
        GEN_REWRITE_TAC(TOP_DEPTH_CONV)(PairList [pth, INT_DIVIDES_ABS, INT_DIVIDES_LCM_GCD, INT_LCM_DIVIDES]) then_tac \
        REPEAT((GEN_TAC or_tac CONJ_TAC))
      ) then_tac \
      GCD_ELIM_TAC
    ) then_tac \
    int_INTEGER_TAC
  )

fun int_INTEGER_RULE_v2(tm): prove([tm, int_INTEGER_TAC_v2])

def num_of_int:
  new_definition(
    (hol:
       var num_of_int :: int -> num
       var x :: int
       const #{@} :: (A -> bool) -> A
       const int_of_num :: num -> int
       num_of_int(x) == const.#{@}(fun (n :: num): int_of_num(n) == x))
  )

def NUM_OF_INT_OF_NUM:
  prove(
    [
      (hol:
         const num_of_int :: int -> num
         const int_of_num :: num -> int
         forall n :: num: num_of_int(int_of_num(n)) == n),
      REWRITE_TAC(PairList [num_of_int, INT_OF_NUM_EQ, SELECT_UNIQUE])
    ]
  )

def INT_OF_NUM_OF_INT:
  prove(
    [
      (hol:
         const int_of_num :: num -> int
         const num_of_int :: int -> num
         forall x :: int: (0 :: int) <= x ==> int_of_num(num_of_int(x)) == x),
      (
        (
          (REWRITE_TAC(PairList [GSYM(INT_FORALL_POS), num_of_int]) then_tac GEN_TAC) then_tac \
          CONV_TAC(SELECT_CONV)
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def NUM_OF_INT:
  prove(
    [
      (hol:
         const int_of_num :: num -> int
         const num_of_int :: int -> num
         forall x :: int: (0 :: int) <= x <=> int_of_num(num_of_int(x)) == x),
      MESON_TAC(PairList [INT_OF_NUM_OF_INT, INT_POS])
    ]
  )

def NUM_OF_INT_ADD:
  prove(
    [
      (hol:
         const num_of_int :: int -> num
         forall (x :: int, y :: int):
           (0 :: int) <= x && (0 :: int) <= y ==> num_of_int(x + y) == num_of_int(x) + num_of_int(y)),
      (
        REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM, IMP_CONJ]) then_tac \
        REWRITE_TAC(PairList [GSYM(INT_FORALL_POS), INT_OF_NUM_ADD, NUM_OF_INT_OF_NUM])
      )
    ]
  )

def NUM_OF_INT_MUL:
  prove(
    [
      (hol:
         const num_of_int :: int -> num
         forall (x :: int, y :: int):
           (0 :: int) <= x && (0 :: int) <= y ==> num_of_int(x * y) == num_of_int(x) * num_of_int(y)),
      (
        REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM, IMP_CONJ]) then_tac \
        REWRITE_TAC(PairList [GSYM(INT_FORALL_POS), INT_OF_NUM_MUL, NUM_OF_INT_OF_NUM])
      )
    ]
  )

def NUM_OF_INT_POW:
  prove(
    [
      (hol:
         const num_of_int :: int -> num
         const int_pow :: int -> num -> int
         const EXP :: num -> num -> num
         forall (x :: int, n :: num):
           (0 :: int) <= x ==> num_of_int(int_pow(x, n)) == EXP(num_of_int(x), n)),
      (
        GEN_REWRITE_TAC(I)(PairList [SWAP_FORALL_THM]) then_tac \
        REWRITE_TAC(PairList [GSYM(INT_FORALL_POS), INT_OF_NUM_POW, NUM_OF_INT_OF_NUM])
      )
    ]
  )

TypeInference.overload_interface(["divides", (hol: var num_divides :: num -> num -> bool; num_divides)])

TypeInference.overload_interface(["mod", (hol: var num_mod :: num -> num -> num -> bool; num_mod)])

