def int_of_num:
  new_definition(
    Host.hol_term(Eq(
      Int,
      App(Var("int_of_num", Fun(Num, Int)), [Var("n", Num)]),
      App(
        Const("int_of_real", Fun(Real, Int)),
        [App(Const("real_of_num", Fun(Num, Real)), [Var("n", Num)])]
      )
    ))
  )

def int_of_num_th:
  prove(
    [
      Host.hol_term(Forall(
        "n",
        Num,
        Eq(
          Real,
          App(Const("real_of_int", Fun(Int, Real)), [App(Const("int_of_num", Fun(Num, Int)), [Ref("n")])]),
          App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])
        )
      )),
      (
        REWRITE_TAC(PairList [int_of_num, GSYM(int_rep), is_int]) then_tac \
        REWRITE_TAC(PairList [REAL_OF_NUM_EQ, EXISTS_OR_THM, GSYM(EXISTS_REFL)])
      )
    ]
  )

def int_neg:
  new_definition(
    Host.hol_term(Eq(
      Int,
      App(Var("int_neg", Fun(Int, Int)), [Var("i", Int)]),
      App(
        Const("int_of_real", Fun(Real, Int)),
        [
          App(
            Const("real_neg", Fun(Real, Real)),
            [App(Const("real_of_int", Fun(Int, Real)), [Var("i", Int)])]
          )
        ]
      )
    ))
  )

def int_neg_th:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Int,
        Eq(
          Real,
          App(Const("real_of_int", Fun(Int, Real)), [App(Const("int_neg", Fun(Int, Int)), [Ref("x")])]),
          App(Const("real_neg", Fun(Real, Real)), [App(Const("real_of_int", Fun(Int, Real)), [Ref("x")])])
        )
      )),
      (
        (
          (REWRITE_TAC(PairList [int_neg, GSYM(int_rep), is_int]) then_tac GEN_TAC) then_tac \
          STRIP_ASSUME_TAC(SPEC(Host.hol_term(Var("x", Int)))(dest_int_rep))
        ) then_tac \
        ASM_REWRITE_TAC(
          PairList [
            REAL_NEG_NEG,
            EXISTS_OR_THM,
            REAL_EQ_NEG2,
            REAL_OF_NUM_EQ,
            GSYM(EXISTS_REFL)
          ]
        )
      )
    ]
  )

def int_add:
  new_definition(
    Host.hol_term(Eq(
      Int,
      App(Var("int_add", Fun(Int, Fun(Int, Int))), [Var("x", Int), Var("y", Int)]),
      App(
        Const("int_of_real", Fun(Real, Int)),
        [
          App(
            Const("real_add", Fun(Real, Fun(Real, Real))),
            [
              App(Const("real_of_int", Fun(Int, Real)), [Var("x", Int)]),
              App(Const("real_of_int", Fun(Int, Real)), [Var("y", Int)])
            ]
          )
        ]
      )
    ))
  )

def int_add_th:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Int,
        Forall(
          "y",
          Int,
          Eq(
            Real,
            App(
              Const("real_of_int", Fun(Int, Real)),
              [App(Const("int_add", Fun(Int, Fun(Int, Int))), [Ref("x"), Ref("y")])]
            ),
            App(
              Const("real_add", Fun(Real, Fun(Real, Real))),
              [
                App(Const("real_of_int", Fun(Int, Real)), [Ref("x")]),
                App(Const("real_of_int", Fun(Int, Real)), [Ref("y")])
              ]
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REWRITE_TAC(PairList [int_add, GSYM(int_rep), is_int]) then_tac \
                            REPEAT(GEN_TAC)
                          ) then_tac \
                          X_CHOOSE_THEN(Host.hol_term(Var("m", Num)))(DISJ_CASES_TAC)(SPEC(Host.hol_term(Var("x", Int)))(dest_int_rep))
                        ) then_tac \
                        X_CHOOSE_THEN(Host.hol_term(Var("n", Num)))(DISJ_CASES_TAC)(SPEC(Host.hol_term(Var("y", Int)))(dest_int_rep))
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, EXISTS_OR_THM])
                    ) then_tac \
                    REWRITE_TAC(PairList [GSYM(EXISTS_REFL)])
                  ) then_tac \
                  DISJ_CASES_THEN(MP_TAC)(
                    SPECL(PairList [Host.hol_term(Var("m", Num)), Host.hol_term(Var("n", Num))])(LE_CASES)
                  )
                ) then_tac \
                REWRITE_TAC(PairList [LE_EXISTS])
              ) then_tac \
              DISCH_THEN(X_CHOOSE_THEN(Host.hol_term(Var("d", Num)))(SUBST1_TAC))
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(REAL_OF_NUM_ADD), OR_EXISTS_THM, REAL_NEG_ADD])
          ) then_tac \
          TRY((EXISTS_TAC(Host.hol_term(Var("d", Num))) then_tac REAL_ARITH_TAC))
        ) then_tac \
        REWRITE_TAC(
          PairList [
            EXISTS_OR_THM,
            GSYM(REAL_NEG_ADD),
            REAL_EQ_NEG2,
            REAL_OF_NUM_ADD,
            REAL_OF_NUM_EQ,
            GSYM(EXISTS_REFL)
          ]
        )
      )
    ]
  )

def int_sub:
  new_definition(
    Host.hol_term(Eq(
      Int,
      App(Var("int_sub", Fun(Int, Fun(Int, Int))), [Var("x", Int), Var("y", Int)]),
      App(
        Const("int_of_real", Fun(Real, Int)),
        [
          App(
            Const("real_sub", Fun(Real, Fun(Real, Real))),
            [
