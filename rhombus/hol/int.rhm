TypeInference.overload_interface(["zpow", Host.hol_term(Var("real_zpow", Fun(Real, Fun(Int, Real))))])

def real_zpow:
  new_definition(
    Host.hol_term(Eq(
      Real,
      App(Var("real_zpow", Fun(Real, Fun(Int, Real))), [Var("z", Real), Var("i", Int)]),
      App(
        Const("COND", Fun(Bool, Fun(Real, Fun(Real, Real)))),
        [
          App(
            Const("int_le", Fun(Int, Fun(Int, Bool))),
            [
              App(
                Const("int_of_num", Fun(Num, Int)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              ),
              Var("i", Int)
            ]
          ),
          App(
            Const("real_pow", Fun(Real, Fun(Num, Real))),
            [Var("z", Real), App(Const("num_of_int", Fun(Int, Num)), [Var("i", Int)])]
          ),
          App(
            Const("real_inv", Fun(Real, Real)),
            [
              App(
                Const("real_pow", Fun(Real, Fun(Num, Real))),
                [
                  Var("z", Real),
                  App(Const("num_of_int", Fun(Int, Num)), [App(Const("int_neg", Fun(Int, Int)), [Var("i", Int)])])
                ]
              )
            ]
          )
        ]
      )
    ))
  )

