  let q_2 = Host.hol_term(Var("q", Tyapp("int", [])))
  let r_2 = Host.hol_term(Var("r", Tyapp("int", [])))
  let dtm_2 = Host.hol_term(Const("div", Tyapp("fun", [Tyapp("int", []), Tyapp("fun", [Tyapp("int", []), Tyapp("int", [])])])))
  let mtm_2 = Host.hol_term(Const("rem", Tyapp("fun", [Tyapp("int", []), Tyapp("fun", [Tyapp("int", []), Tyapp("int", [])])])))
  let emod_num:
    fun(x):
      fun(y):
        let r = Host.mod_num(x)(y)
        (if Host.hol_lt(r)(Host.num(0)) | Host.hol_add(r)(Host.abs_num(y)) | r)
  let equo_num = (fun(x): (fun(y): Host.quo_num(Host.hol_sub(x)(emod_num(x)(y)))(y)))
  let INT_DIVMOD_CONV:
    fun(x):
      fun(y):
        let k_2 = equo_num(x)(y)
        let l_2 = emod_num(x)(y)
        let th0 = Fusion.INST(PairList.cons([mk_intconst(x), m_4], PairList.cons([mk_intconst(y), n_4], PairList.cons([mk_intconst(k_2), q_2], PairList.cons([mk_intconst(l_2), r_2], PairList [])))))(pth_2)
        let tm0 = Equal.lhand(Equal.lhand(Fusion.concl(th0)))
        let th1 = Equal.THENC(Equal.LAND_CONV(INT_MUL_CONV))(INT_ADD_CONV)(tm0)
        let th2 = Bool.MP(th0)(th1)
        let tm2 = Equal.lhand(Fusion.concl(th2))
        let th3 = Bool.MP(th2)(Bool.EQT_ELIM(INT_LE_CONV(tm2)))
        let tm3 = Equal.lhand(Fusion.concl(th3))
        Bool.MP(th3)(Bool.EQT_ELIM(Equal.THENC(Equal.RAND_CONV(INT_ABS_CONV))(INT_LT_CONV)(tm3)))
  [
    fun(tm):
      try:
        let [l, r] = Basics.dest_binop(dtm_2)(tm)
        Bool.CONJUNCT1(INT_DIVMOD_CONV(dest_intconst(l))(dest_intconst(r)))
        ~catch exn:
          match exn
          | Failure(_): failwith("INT_DIV_CONV")
          | exn: Host.hol_raise(exn),
    fun(tm):
      try:
        let [l, r] = Basics.dest_binop(mtm_2)(tm)
        Bool.CONJUNCT2(INT_DIVMOD_CONV(dest_intconst(l))(dest_intconst(r)))
        ~catch exn:
          match exn
          | Failure(_): failwith("INT_MOD_CONV")
          | exn: Host.hol_raise(exn)]

