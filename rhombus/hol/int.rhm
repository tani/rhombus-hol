def MULT_DIV:
  prove(
    [
      (hol:
         const num_divides :: num -> num -> bool
         const DIV :: num -> num -> num
         (forall (m :: num, n :: num, p :: num): num_divides(p, m) ==> DIV(m * n, p) == DIV(m, p) * n)
           && (forall (m :: num, n :: num, p :: num):
                 num_divides(p, n) ==> DIV(m * n, p) == m * DIV(n, p))),
      (
        (
          (
            (
              (
                MATCH_MP_TAC(
                  TAUT(
                    (hol:
                       var a :: bool
                       var b :: bool
                       (a ==> b) && a ==> a && b)
                  )
                ) then_tac \
                CONJ_TAC
              ) then_list \
              PairList [
                MESON_TAC(PairList [MULT_SYM]),
                SIMP_TAC(PairList [divides, LEFT_IMP_EXISTS_THM])
              ]
            ) then_tac \
            REPEAT(GEN_TAC)
          ) then_tac \
          ASM_CASES_TAC(
            (hol:
               var p :: num
               p == (0 :: num))
          )
        ) then_tac \
        ASM_SIMP_TAC(PairList [MULT_CLAUSES, DIV_0, GSYM(MULT_ASSOC), DIV_MULT])
      )
    ]
  )

def NUMBER_TAC:
  let conva = GEN_REWRITE_CONV(TRY_CONV)(PairList [GSYM(DIVIDES_ANTISYM)])
  fun antisym_conv(tm):
    if (is_forall(tm) || is_exists(tm))
    | BINDER_CONV(antisym_conv)(tm)
    | if (is_conj(tm) || is_disj(tm))
      | BINOP_CONV(antisym_conv)(tm)
      | (if is_imp(tm) | RAND_CONV(antisym_conv)(tm) | conva(tm))
  let pth_relativize:
    prove(
      [
        (hol:
           var P :: int -> bool
           const int_of_num :: num -> int
           ((forall n :: num: P(int_of_num(n))) <=> (forall i :: int: (0 :: int) <= i ==> P(i)))
             && ((exists n :: num: P(int_of_num(n))) <=> (exists i :: int: (0 :: int) <= i && P(i)))),
        (
          (
            GEN_REWRITE_TAC(RAND_CONV)(
              PairList [
                TAUT(
                  (hol:
                     var a :: bool
                     var b :: bool
                     (a <=> b) <=> (!a <=> !b))
                )
              ]
            ) then_tac \
            REWRITE_TAC(PairList [NOT_EXISTS_THM, INT_FORALL_POS])
          ) then_tac \
          MESON_TAC(PairList [])
        )
      ]
    )
  let relation_conv_3:
    GEN_REWRITE_CONV(TOP_SWEEP_CONV)(
      PairList [
        num_divides,
        num_congruent,
        num_coprime,
        NUM_GCD,
        NUM_LCM,
        & (
          map(GSYM)(
            PairList [
              INT_OF_NUM_EQ,
              INT_OF_NUM_LE,
              INT_OF_NUM_LT,
              INT_OF_NUM_GE,
              INT_OF_NUM_GT,
              INT_OF_NUM_SUC,
              INT_OF_NUM_ADD,
              INT_OF_NUM_MUL,
              INT_OF_NUM_POW
            ]
          )
        )
      ]
    )
  let quantifier_conv_3 = GEN_REWRITE_CONV(DEPTH_CONV)(PairList [pth_relativize])
  (
    (
      (
        (
          (
            (
              REPEAT(((CONJ_TAC or_tac GEN_TAC) or_tac EQ_TAC)) then_tac \
              CONV_TAC(antisym_conv)
            ) then_tac \
            W((fun([_, w]): MAP_EVERY((fun(v): SPEC_TAC([v, v])))(frees(w))))
          ) then_tac \
          CONV_TAC((relation_conv_3 then_conv quantifier_conv_3))
        ) then_tac \
        REWRITE_TAC(PairList [RIGHT_IMP_FORALL_THM])
      ) then_tac \
      REPEAT(GEN_TAC)
    ) then_tac \
    int_INTEGER_TAC_v2
  )

fun NUMBER_RULE(tm): prove([tm, NUMBER_TAC])

def COPRIME_LMOD:
  prove(
    [
      (hol:
         const num_coprime :: pair(num, num) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         const MOD :: num -> num -> num
         forall (a :: num, n :: num): num_coprime(const.#{|,|}(MOD(a, n), n)) <=> num_coprime(const.#{|,|}(a, n))),
      MESON_TAC(
        PairList [
          CONG_LMOD,
          NUMBER_RULE(
            (hol:
               var x :: num
               var n :: num
               const #{==} :: A -> A -> (A -> A -> bool) -> bool
               const num_mod :: num -> num -> num -> bool
               const.#{==}(x, x, num_mod(n)))
          ),
          NUMBER_RULE(
            (hol:
               var a :: num
               var b :: num
               var n :: num
               const #{==} :: A -> A -> (A -> A -> bool) -> bool
               const num_mod :: num -> num -> num -> bool
               const num_coprime :: pair(num, num) -> bool
               const #{|,|} :: A -> B -> pair(A, B)
               const.#{==}(a, b, num_mod(n)) && num_coprime(const.#{|,|}(a, n)) ==> num_coprime(const.#{|,|}(b, n)))
          )
        ]
      )
    ]
  )

def COPRIME_RMOD:
  prove(
    [
      (hol:
         const num_coprime :: pair(num, num) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         const MOD :: num -> num -> num
         forall (a :: num, n :: num): num_coprime(const.#{|,|}(n, MOD(a, n))) <=> num_coprime(const.#{|,|}(n, a))),
      (
        ONCE_REWRITE_TAC(
          PairList [
            NUMBER_RULE(
              (hol:
                 var a :: num
                 var b :: num
                 const num_coprime :: pair(num, num) -> bool
                 const #{|,|} :: A -> B -> pair(A, B)
                 num_coprime(const.#{|,|}(a, b)) <=> num_coprime(const.#{|,|}(b, a)))
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [COPRIME_LMOD])
      )
    ]
  )

def INT_CONG_NUM_EXISTS:
  prove(
    [
      (hol:
         const #{==} :: A -> A -> (A -> A -> bool) -> bool
         const int_of_num :: num -> int
         const int_mod :: int -> int -> int -> bool
         forall (x :: int, y :: int):
           (y == (0 :: int) ==> (0 :: int) <= x)
             ==> (exists n :: num: const.#{==}(int_of_num(n), x, int_mod(y)))),
      (
        (
          (
            (
              REPEAT(STRIP_TAC) then_tac \
              EXISTS_TAC(
                (hol:
                   var x :: int
                   var y :: int
                   const num_of_int :: int -> num
                   const int_abs :: int -> int
                   num_of_int(x + int_abs(x * y)))
              )
            ) then_tac \
            W(
              o(
                o(
                  o(o(MP_TAC)(PART_MATCH(o(lhand)(rand))(INT_OF_NUM_OF_INT)))(lhand)
                )(rator)
              )(snd)
            )
          ) then_tac \
          ANTS_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        POP_ASSUM(MP_TAC) then_tac \
                        ASM_CASES_TAC(
                          (hol:
                             var y :: int
                             y == (0 :: int))
                        )
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_list \
                    PairList [ASM_ARITH_TAC, ALL_TAC]
                  ) then_tac \
                  MATCH_MP_TAC(
                    int_INT_ARITH_v2(
                      (hol:
                         var x :: int
                         var y :: int
                         const int_abs :: int -> int
                         int_abs(x) * (1 :: int) <= y ==> (0 :: int) <= x + y)
                    )
                  )
                ) then_tac \
                REWRITE_TAC(PairList [INT_ABS_MUL])
              ) then_tac \
              MATCH_MP_TAC(INT_LE_LMUL)
            ) then_tac \
            int_ASM_INT_ARITH_TAC_v2
          ),
          (
            (
              (
                (
                  DISCH_THEN(SUBST1_TAC) then_tac \
                  REWRITE_TAC(
                    PairList [
                      int_INTEGER_RULE_v2(
                        (hol:
                           var x :: int
                           var a :: int
                           var n :: int
                           const #{==} :: A -> A -> (A -> A -> bool) -> bool
                           const int_mod :: int -> int -> int -> bool
                           const int_divides :: int -> int -> bool
                           const.#{==}(x + a, x, int_mod(n)) <=> int_divides(n, a))
                      )
                    ]
                  )
                ) then_tac \
                REWRITE_TAC(PairList [INT_ABS])
              ) then_tac \
              COND_CASES_TAC
            ) then_tac \
            CONV_TAC(int_INTEGER_RULE_v2)
          )
        ]
      )
    ]
  )

def GCD:
  prove(
    [
      (hol:
         const num_divides :: num -> num -> bool
         const num_gcd :: pair(num, num) -> num
         const #{|,|} :: A -> B -> pair(A, B)
         forall (a :: num, b :: num):
           num_divides(num_gcd(const.#{|,|}(a, b)), a)
             && num_divides(num_gcd(const.#{|,|}(a, b)), b)
             && (forall e :: num:
                   num_divides(e, a) && num_divides(e, b) ==> num_divides(e, num_gcd(const.#{|,|}(a, b))))),
      NUMBER_TAC
    ]
  )

def coprime:
  prove(
    [
      (hol:
         var a :: num
         var b :: num
         const num_coprime :: pair(num, num) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         const num_divides :: num -> num -> bool
         num_coprime(const.#{|,|}(a, b))
           <=> (forall d :: num: num_divides(d, a) && num_divides(d, b) ==> d == (1 :: num))),
      (
        (
          (
            (EQ_TAC then_list PairList [CONV_TAC(NUMBER_RULE), ALL_TAC]) then_tac \
            DISCH_THEN(
              o(MP_TAC)(
                SPEC(
                  (hol:
                     var a :: num
                     var b :: num
                     const num_gcd :: pair(num, num) -> num
                     const #{|,|} :: A -> B -> pair(A, B)
                     num_gcd(const.#{|,|}(a, b)))
                )
              )
            )
          ) then_tac \
          REWRITE_TAC(PairList [GCD])
        ) then_tac \
        NUMBER_TAC
      )
    ]
  )

def prime:
  new_definition(
    (hol:
       var prime :: num -> bool
       var p :: num
       const num_divides :: num -> num -> bool
       prime(p)
         <=> p != (1 :: num) && (forall x :: num: num_divides(x, p) ==> x == (1 :: num) || x == p))
  )

def ONE_OR_PRIME:
  prove(
    [
      (hol:
         const prime :: num -> bool
         const num_divides :: num -> num -> bool
         forall p :: num:
           p == (1 :: num) || prime(p)
             <=> (forall n :: num: num_divides(n, p) ==> n == (1 :: num) || n == p)),
      (
        (
          (GEN_TAC then_tac REWRITE_TAC(PairList [prime])) then_tac \
          ASM_CASES_TAC(
            (hol:
               var p :: num
               p == (1 :: num))
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList [DIVIDES_ONE])
      )
    ]
  )

def ONE_OR_PRIME_DIVIDES_OR_COPRIME:
  prove(
    [
      (hol:
         const prime :: num -> bool
         const num_divides :: num -> num -> bool
         const num_coprime :: pair(num, num) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         forall p :: num:
           p == (1 :: num) || prime(p)
             <=> (forall n :: num: num_divides(p, n) || num_coprime(const.#{|,|}(p, n)))),
      (
        ((GEN_TAC then_tac EQ_TAC) then_tac STRIP_TAC) then_list \
        PairList [
          (
            ((ASM_REWRITE_TAC(PairList []) then_tac GEN_TAC) then_tac DISJ1_TAC) then_tac \
            CONV_TAC(NUMBER_RULE)
          ),
          ASM_MESON_TAC(PairList [prime, coprime]),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REWRITE_TAC(PairList [ONE_OR_PRIME]) then_tac \
                          X_GEN_TAC(hol: var n :: num; n)
                        ) then_tac \
                        DISCH_TAC
                      ) then_tac \
                      ONCE_REWRITE_TAC(PairList [DISJ_SYM])
                    ) then_tac \
                    FIRST_X_ASSUM(o(MP_TAC)(SPEC(hol: var n :: num; n)))
                  ) then_tac \
                  MATCH_MP_TAC(MONO_OR)
                ) then_tac \
                CONJ_TAC
              ) then_tac \
              POP_ASSUM(MP_TAC)
            ) then_tac \
            CONV_TAC(NUMBER_RULE)
          )
        ]
      )
    ]
  )

def PRIME_COPRIME_EQ_NONDIVISIBLE:
  prove(
    [
      (hol:
         const prime :: num -> bool
         const num_coprime :: pair(num, num) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         const num_divides :: num -> num -> bool
         forall p :: num:
           prime(p) <=> (forall n :: num: num_coprime(const.#{|,|}(p, n)) <=> !num_divides(p, n))),
      (
        (
          (
            X_GEN_TAC(hol: var p :: num; p) then_tac \
            ASM_CASES_TAC(
              (hol:
                 var p :: num
                 p == (1 :: num))
            )
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_list \
        PairList [
          (
            (
              (
                ASM_REWRITE_TAC(PairList [prime]) then_tac \
                DISCH_THEN(
                  o(MP_TAC)(
                    SPEC(
                      (hol:
                         (1 :: num))
                    )
                  )
                )
              ) then_tac \
              MATCH_MP_TAC(
                TAUT(
                  (hol:
                     var p :: bool
                     var q :: bool
                     p && q ==> (p <=> !q) ==> #false)
                )
              )
            ) then_tac \
            CONV_TAC(NUMBER_RULE)
          ),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              MP_TAC(SPEC(hol: var p :: num; p)(ONE_OR_PRIME_DIVIDES_OR_COPRIME)) then_tac \
                              ASM_REWRITE_TAC(PairList [])
                            ) then_tac \
                            DISCH_THEN(SUBST1_TAC)
                          ) then_tac \
                          EQ_TAC
                        ) then_tac \
                        MATCH_MP_TAC(MONO_FORALL)
                      ) then_tac \
                      SIMP_TAC(PairList [TAUT(hol:
                                                var p :: bool
                                                p || !p)])
                    ) then_tac \
                    GEN_TAC
                  ) then_tac \
                  MATCH_MP_TAC(
                    TAUT(
                      (hol:
                         var p :: bool
                         var q :: bool
                         !(p && q) ==> q || p ==> (p <=> !q))
                    )
                  )
                ) then_tac \
                POP_ASSUM(MP_TAC)
              ) then_tac \
              REWRITE_TAC(PairList [CONTRAPOS_THM])
            ) then_tac \
            CONV_TAC(NUMBER_RULE)
          )
        ]
      )
    ]
  )

def ZERO_ONE_OR_PRIME_DIVPROD:
  prove(
    [
      (hol:
         const prime :: num -> bool
         const num_divides :: num -> num -> bool
         forall (p :: num, a :: num, b :: num):
           p == (0 :: num) || (p == (1 :: num) || prime(p))
             ==> (num_divides(p, a * b) <=> num_divides(p, a) || num_divides(p, b))),
      (
        (
          (
            (
              (
                REPEAT(STRIP_TAC) then_tac \
                ASM_REWRITE_TAC(
                  PairList [
                    NUMBER_RULE(
                      (hol:
                         var n :: num
                         const num_divides :: num -> num -> bool
                         num_divides((1 :: num), n))
                    )
                  ]
                )
              ) then_tac \
              ASM_REWRITE_TAC(
                PairList [
                  NUMBER_RULE(
                    (hol:
                       var n :: num
                       const num_divides :: num -> num -> bool
                       num_divides((0 :: num), n) <=> n == (0 :: num))
                  ),
                  MULT_EQ_0
                ]
              )
            ) then_tac \
            EQ_TAC
          ) then_list \
          PairList [ALL_TAC, CONV_TAC(NUMBER_RULE)]
        ) then_tac \
        ASM_MESON_TAC(
          PairList [
            prime,
            coprime,
            NUMBER_RULE(
              (hol:
                 const num_divides :: num -> num -> bool
                 const num_coprime :: pair(num, num) -> bool
                 const #{|,|} :: A -> B -> pair(A, B)
                 forall (d :: num, a :: num, b :: num):
                   num_divides(d, a * b) && num_coprime(const.#{|,|}(d, a)) ==> num_divides(d, b))
            )
          ]
        )
      )
    ]
  )

def ZERO_ONE_OR_PRIME:
  prove(
    [
      (hol:
         const prime :: num -> bool
         const num_divides :: num -> num -> bool
         forall p :: num:
           p == (0 :: num) || (p == (1 :: num) || prime(p))
             <=> (forall (a :: num, b :: num):
                    num_divides(p, a * b) ==> num_divides(p, a) || num_divides(p, b))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (GEN_TAC then_tac EQ_TAC) then_tac \
                                      SIMP_TAC(PairList [ZERO_ONE_OR_PRIME_DIVPROD])
                                    ) then_tac \
                                    DISCH_TAC
                                  ) then_tac \
                                  REWRITE_TAC(
                                    PairList [
                                      TAUT(
                                        (hol:
                                           var p :: bool
                                           var q :: bool
                                           p || q <=> !p ==> q)
                                      )
                                    ]
                                  )
                                ) then_tac \
                                REPEAT(STRIP_TAC)
                              ) then_tac \
                              ASM_REWRITE_TAC(PairList [prime, divides, LEFT_IMP_EXISTS_THM])
                            ) then_tac \
                            MAP_EVERY(X_GEN_TAC)(PairList [(hol: var a :: num; a), (hol: var b :: num; b)])
                          ) then_tac \
                          DISCH_THEN(o(ASSUME_TAC)(SYM))
                        ) then_tac \
                        FIRST_X_ASSUM(
                          o(MP_TAC)(SPECL(PairList [(hol: var a :: num; a), (hol: var b :: num; b)]))
                        )
                      ) then_tac \
                      FIRST_X_ASSUM(o(SUBST_ALL_TAC)(SYM))
                    ) then_tac \
                    RULE_ASSUM_TAC(REWRITE_RULE(PairList [MULT_EQ_0, MULT_EQ_1, DE_MORGAN_THM]))
                  ) then_tac \
                  REWRITE_TAC(
                    PairList [
                      NUMBER_RULE(
                        (hol:
                           var n :: num
                           const num_divides :: num -> num -> bool
                           num_divides(n, n))
                      )
                    ]
                  )
                ) then_tac \
                STRIP_TAC
              ) then_tac \
              FIRST_X_ASSUM(o(MP_TAC)(MATCH_MP(DIVIDES_LE_STRONG)))
            ) then_tac \
            ONCE_REWRITE_TAC(
              PairList [
                ARITH_RULE(
                  (hol:
                     var a :: num
                     var b :: num
                     a * b <= a <=> a * b <= a * (1 :: num))
                ),
                ARITH_RULE(
                  (hol:
                     var a :: num
                     var b :: num
                     a * b <= b <=> a * b <= (1 :: num) * b)
                )
              ]
            )
          ) then_tac \
          REWRITE_TAC(PairList [LE_MULT_LCANCEL, LE_MULT_RCANCEL])
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            MULT_CLAUSES,
            ARITH_RULE(
              (hol:
                 var n :: num
                 n <= (1 :: num) <=> n == (0 :: num) || n == (1 :: num))
            )
          ]
        )
      )
    ]
  )

TypeInference.make_overloadable("zpow")(hol_type: A -> int -> A)

Host.parse_as_infix(["zpow", [24, "left"]])

TypeInference.overload_interface(["zpow", (hol: var real_zpow :: real -> int -> real; real_zpow)])

def real_zpow:
  new_definition(
    (hol:
       var real_zpow :: real -> int -> real
       var z :: real
       var i :: int
       const real_pow :: real -> num -> real
       const num_of_int :: int -> num
       const real_inv :: real -> real
       real_zpow(z, i)
         == (if (0 :: int) <= i | real_pow(z, num_of_int(i)) | real_inv(real_pow(z, num_of_int(-i)))))
  )

def REAL_POW_ZPOW:
  prove(
    [
      (hol:
         const real_pow :: real -> num -> real
         const real_zpow :: real -> int -> real
         const int_of_num :: num -> int
         forall (x :: real, n :: num): real_pow(x, n) == real_zpow(x, int_of_num(n))),
      REWRITE_TAC(PairList [real_zpow, INT_POS, NUM_OF_INT_OF_NUM])
    ]
  )

def REAL_ZPOW_NUM:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         const int_of_num :: num -> int
         const real_pow :: real -> num -> real
         forall (x :: real, n :: num): real_zpow(x, int_of_num(n)) == real_pow(x, n)),
      REWRITE_TAC(PairList [real_zpow, INT_POS, NUM_OF_INT_OF_NUM])
    ]
  )

def REAL_ZPOW_0:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall x :: real: real_zpow(x, (0 :: int)) == (1 :: real)),
      REWRITE_TAC(PairList [REAL_ZPOW_NUM, real_pow])
    ]
  )

def REAL_ZPOW_1:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall x :: real: real_zpow(x, (1 :: int)) == x),
      REWRITE_TAC(PairList [REAL_ZPOW_NUM, REAL_POW_1])
    ]
  )

def REAL_ZPOW_2:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall x :: real: real_zpow(x, (2 :: int)) == x * x),
      REWRITE_TAC(PairList [REAL_ZPOW_NUM, REAL_POW_2])
    ]
  )

def REAL_ZPOW_ONE:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall n :: int: real_zpow((1 :: real), n) == (1 :: real)),
      REWRITE_TAC(PairList [real_zpow, REAL_POW_ONE, REAL_INV_1, COND_ID])
    ]
  )

def REAL_ZPOW_NEG:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         const real_inv :: real -> real
         forall (x :: real, n :: int): real_zpow(x, -n) == real_inv(real_zpow(x, n))),
      (
        (
          (
            (
              REPEAT(GEN_TAC) then_tac \
              ASM_CASES_TAC(
                (hol:
                   var n :: int
                   n == (0 :: int))
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [INT_NEG_0, REAL_ZPOW_0, REAL_INV_1])
          ) then_tac \
          ASM_SIMP_TAC(
            PairList [
              real_zpow,
              COND_SWAP,
              INT_NEG_NEG,
              int_INT_ARITH_v2(
                (hol:
                   var n :: int
                   n != (0 :: int) ==> ((0 :: int) <= -n <=> !((0 :: int) <= n)))
              )
            ]
          )
        ) then_tac \
        MESON_TAC(PairList [REAL_INV_INV])
      )
    ]
  )

def REAL_ZPOW_MINUS1:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         const real_inv :: real -> real
         forall x :: real: real_zpow(x, -(1 :: int)) == real_inv(x)),
      REWRITE_TAC(PairList [REAL_ZPOW_NEG, REAL_ZPOW_1])
    ]
  )

def REAL_ZPOW_ZERO:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall n :: int: real_zpow((0 :: real), n) == (if n == (0 :: int) | (1 :: real) | (0 :: real))),
      (
        (
          REWRITE_TAC(PairList [FORALL_INT_CASES, REAL_ZPOW_NEG, REAL_ZPOW_NUM]) then_tac \
          REWRITE_TAC(PairList [REAL_POW_ZERO, INT_NEG_EQ_0, INT_OF_NUM_EQ])
        ) then_tac \
        MESON_TAC(PairList [REAL_INV_0, REAL_INV_1])
      )
    ]
  )

def REAL_ZPOW_POW:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         const int_of_num :: num -> int
         const real_pow :: real -> num -> real
         const real_inv :: real -> real
         (forall (x :: real, n :: num): real_zpow(x, int_of_num(n)) == real_pow(x, n))
           && (forall (x :: real, n :: num): real_zpow(x, -int_of_num(n)) == real_inv(real_pow(x, n)))),
      REWRITE_TAC(PairList [REAL_ZPOW_NEG, REAL_ZPOW_NUM])
    ]
  )

def REAL_INV_ZPOW:
  prove(
    [
      (hol:
         const real_inv :: real -> real
         const real_zpow :: real -> int -> real
         forall (x :: real, n :: int): real_inv(real_zpow(x, n)) == real_zpow(real_inv(x), n)),
      (
        REWRITE_TAC(PairList [FORALL_INT_CASES, REAL_ZPOW_POW]) then_tac \
        REWRITE_TAC(PairList [REAL_INV_POW, REAL_INV_INV])
      )
    ]
  )

def REAL_ZPOW_INV:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         const real_inv :: real -> real
         forall (x :: real, n :: int): real_zpow(real_inv(x), n) == real_inv(real_zpow(x, n))),
      REWRITE_TAC(PairList [REAL_INV_ZPOW])
    ]
  )

def REAL_ZPOW_ZPOW:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall (x :: real, m :: int, n :: int): real_zpow(real_zpow(x, m), n) == real_zpow(x, m * n)),
      (
        (
          REWRITE_TAC(PairList [FORALL_INT_CASES, INT_MUL_LNEG, INT_MUL_RNEG, INT_NEG_NEG]) then_tac \
          REWRITE_TAC(PairList [REAL_ZPOW_POW, REAL_INV_POW, INT_OF_NUM_MUL, REAL_INV_INV])
        ) then_tac \
        REWRITE_TAC(PairList [REAL_POW_POW])
      )
    ]
  )

def REAL_ZPOW_MUL:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall (x :: real, y :: real, n :: int):
           real_zpow(x * y, n) == real_zpow(x, n) * real_zpow(y, n)),
      REWRITE_TAC(PairList [FORALL_INT_CASES, REAL_ZPOW_POW, REAL_POW_MUL, REAL_INV_MUL])
    ]
  )

def REAL_ZPOW_DIV:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall (x :: real, y :: real, n :: int):
           real_zpow(x / y, n) == real_zpow(x, n) / real_zpow(y, n)),
      REWRITE_TAC(PairList [real_div, REAL_INV_ZPOW, REAL_ZPOW_MUL])
    ]
  )

def REAL_ZPOW_ADD:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall (x :: real, m :: int, n :: int):
           x != (0 :: real) ==> real_zpow(x, m + n) == real_zpow(x, m) * real_zpow(x, n)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REWRITE_TAC(PairList [FORALL_INT_CASES, GSYM(INT_NEG_ADD), INT_OF_NUM_ADD]) then_tac \
                        REWRITE_TAC(PairList [REAL_ZPOW_POW, REAL_POW_ADD, REAL_INV_MUL])
                      ) then_tac \
                      X_GEN_TAC(hol: var x :: real; x)
                    ) then_tac \
                    GEN_REWRITE_TAC(LAND_CONV)(PairList [SWAP_FORALL_THM])
                  ) then_tac \
                  GEN_REWRITE_TAC(o(LAND_CONV)(ONCE_DEPTH_CONV))(PairList [REAL_MUL_SYM, INT_ADD_SYM])
                ) then_tac \
                REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM])
              ) then_tac \
              DISCH_TAC
            ) then_tac \
            MATCH_MP_TAC(WLOG_LE)
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (
                  REPEAT(GEN_TAC) then_tac \
                  GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_EQ_INV2)])
                ) then_tac \
                REWRITE_TAC(PairList [REAL_INV_MUL, REAL_INV_INV, GSYM(REAL_ZPOW_NEG)])
              ) then_tac \
              REWRITE_TAC(
                PairList [
                  int_INT_ARITH_v2(
                    (hol:
                       var x :: int
                       var y :: int
                       -(-x + y) == -y + x)
                  )
                ]
              )
            ) then_tac \
            REWRITE_TAC(PairList [REAL_MUL_AC])
          ),
          (
            (
              (
                (
                  MAP_EVERY(X_GEN_TAC)(PairList [(hol: var n :: num; n), (hol: var p :: num; p)]) then_tac \
                  REWRITE_TAC(PairList [LE_EXISTS, LEFT_IMP_EXISTS_THM])
                ) then_tac \
                SIMP_TAC(
                  PairList [
                    GSYM(INT_OF_NUM_ADD),
                    ARITH_RULE(
                      (hol:
                         var n :: int
                         var m :: int
                         -n + (n + m) == m)
                    )
                  ]
                )
              ) then_tac \
              REWRITE_TAC(PairList [REAL_POW_ADD, REAL_ZPOW_NUM, REAL_MUL_ASSOC])
            ) then_tac \
            ASM_SIMP_TAC(PairList [REAL_MUL_LINV, REAL_POW_EQ_0, REAL_MUL_LID])
          )
        ]
      )
    ]
  )

def REAL_ZPOW_SUB:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall (x :: real, m :: int, n :: int):
           x != (0 :: real) ==> real_zpow(x, m - n) == real_zpow(x, m) / real_zpow(x, n)),
      SIMP_TAC(PairList [INT_SUB, REAL_ZPOW_ADD, REAL_ZPOW_NEG, real_div])
    ]
  )

def REAL_ZPOW_LE:
  prove(
    [
      (hol:
         const real_zpow :: real -> int -> real
         forall (x :: real, n :: int): (0 :: real) <= x ==> (0 :: real) <= real_zpow(x, n)),
      SIMP_TAC(PairList [FORALL_INT_CASES, REAL_ZPOW_POW, REAL_LE_INV_EQ, REAL_POW_LE])
