def integer:
  new_definition(
    (hol:
       var integer :: real -> bool
       var x :: real
       const real_abs :: real -> real
       const real_of_num :: num -> real
       integer(x) <=> (exists n :: num: real_abs(x) == real_of_num(n)))
  )

def is_int:
  prove(
    [
      (hol:
         var x :: real
         const integer :: real -> bool
         const real_of_num :: num -> real
         integer(x) <=> (exists n :: num: x == real_of_num(n) || x == -real_of_num(n))),
      (
        ((REWRITE_TAC(PairList [integer]) then_tac AP_TERM_TAC) then_tac ABS_TAC) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def int_tybij:
  new_type_definition("int")(["int_of_real", "real_of_int"])(
    prove(
      [
        (hol:
           const integer :: real -> bool
           exists x :: real: integer(x)),
        (
          EXISTS_TAC(
            (hol:
               (0 :: real))
          ) then_tac \
          REWRITE_TAC(
            PairList [
              is_int,
              REAL_OF_NUM_EQ,
              EXISTS_OR_THM,
              GSYM(EXISTS_REFL)
            ]
          )
        )
      ]
    )
  )

def [int_int_abstr_v2, int_rep] = [SPEC_ALL(CONJUNCT1(int_tybij)), SPEC_ALL(CONJUNCT2(int_tybij))]

def dest_int_rep:
  prove(
    [
      (hol:
         const real_of_int :: int -> real
         const real_of_num :: num -> real
         forall i :: int:
           exists n :: num: real_of_int(i) == real_of_num(n) || real_of_int(i) == -real_of_num(n)),
      REWRITE_TAC(PairList [GSYM(is_int), int_rep, int_int_abstr_v2])
    ]
  )

def INTEGER_REAL_OF_INT:
  prove(
    [
      (hol:
         const integer :: real -> bool
         const real_of_int :: int -> real
         forall x :: int: integer(real_of_int(x))),
      MESON_TAC(PairList [int_tybij])
    ]
  )

def int_eq:
  prove(
    [
      (hol:
         const real_of_int :: int -> real
         forall (x :: int, y :: int): x == y <=> real_of_int(x) == real_of_int(y)),
      (
        (
          (
            ((REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac DISCH_TAC) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          POP_ASSUM(o(MP_TAC)(AP_TERM(hol: const int_of_real :: real -> int; int_of_real)))
        ) then_tac \
        REWRITE_TAC(PairList [int_int_abstr_v2])
      )
    ]
  )

def initialization_1:
  do_list(TypeInference.overload_interface)(
    PairList [
      ["+", (hol: var int_add :: int -> int -> int; int_add)],
      ["-", (hol: var int_sub :: int -> int -> int; int_sub)],
      ["*", (hol: var int_mul :: int -> int -> int; int_mul)],
      ["<", (hol: var int_lt :: int -> int -> bool; int_lt)],
      ["<=", (hol: var int_le :: int -> int -> bool; int_le)],
      [">", (hol: var int_gt :: int -> int -> bool; int_gt)],
      [">=", (hol: var int_ge :: int -> int -> bool; int_ge)],
      ["--", (hol: var int_neg :: int -> int; int_neg)],
      ["pow", (hol: var int_pow :: int -> num -> int; int_pow)],
      ["abs", (hol: var int_abs :: int -> int; int_abs)],
      ["max", (hol: var int_max :: int -> int -> int; int_max)],
      ["min", (hol: var int_min :: int -> int -> int; int_min)],
      ["&", (hol: var int_of_num :: num -> int; int_of_num)]
    ]
  )

fun prioritize_int(_): TypeInference.prioritize_overload(mk_type(["int", PairList []]))

def int_le:
  new_definition(
    (hol:
       var int_le :: int -> int -> bool
       var x :: int
       var y :: int
       const real_of_int :: int -> real
       int_le(x, y) <=> real_of_int(x) <= real_of_int(y))
  )

def int_lt:
  new_definition(
    (hol:
       var int_lt :: int -> int -> bool
       var x :: int
       var y :: int
       const real_of_int :: int -> real
       int_lt(x, y) <=> real_of_int(x) < real_of_int(y))
  )

def int_ge:
  new_definition(
    (hol:
       var int_ge :: int -> int -> bool
       var x :: int
       var y :: int
       const real_of_int :: int -> real
       int_ge(x, y) <=> real_of_int(x) >= real_of_int(y))
  )

def int_gt:
  new_definition(
    (hol:
       var int_gt :: int -> int -> bool
       var x :: int
       var y :: int
       const real_of_int :: int -> real
       int_gt(x, y) <=> real_of_int(x) > real_of_int(y))
  )

def int_of_num:
  new_definition(
    (hol:
       var int_of_num :: num -> int
       var n :: num
       const int_of_real :: real -> int
       const real_of_num :: num -> real
       int_of_num(n) == int_of_real(real_of_num(n)))
  )

def int_of_num_th:
  prove(
    [
      (hol:
         const real_of_int :: int -> real
         const int_of_num :: num -> int
         const real_of_num :: num -> real
         forall n :: num: real_of_int(int_of_num(n)) == real_of_num(n)),
      (
        REWRITE_TAC(PairList [int_of_num, GSYM(int_rep), is_int]) then_tac \
        REWRITE_TAC(PairList [REAL_OF_NUM_EQ, EXISTS_OR_THM, GSYM(EXISTS_REFL)])
      )
    ]
  )

def int_neg:
  new_definition(
    (hol:
       var int_neg :: int -> int
       var i :: int
       const int_of_real :: real -> int
       const real_of_int :: int -> real
       int_neg(i) == int_of_real(-real_of_int(i)))
  )

def int_neg_th:
  prove(
    [
      (hol:
         const real_of_int :: int -> real
         forall x :: int: real_of_int(-x) == -real_of_int(x)),
      (
        (
          (REWRITE_TAC(PairList [int_neg, GSYM(int_rep), is_int]) then_tac GEN_TAC) then_tac \
          STRIP_ASSUME_TAC(SPEC(hol: var x :: int; x)(dest_int_rep))
        ) then_tac \
        ASM_REWRITE_TAC(
          PairList [
            REAL_NEG_NEG,
            EXISTS_OR_THM,
            REAL_EQ_NEG2,
            REAL_OF_NUM_EQ,
            GSYM(EXISTS_REFL)
          ]
        )
      )
    ]
  )

def int_add:
  new_definition(
    (hol:
       var int_add :: int -> int -> int
       var x :: int
       var y :: int
       const int_of_real :: real -> int
       const real_of_int :: int -> real
       int_add(x, y) == int_of_real(real_of_int(x) + real_of_int(y)))
  )

def int_add_th:
  prove(
    [
      (hol:
         const real_of_int :: int -> real
         forall (x :: int, y :: int): real_of_int(x + y) == real_of_int(x) + real_of_int(y)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REWRITE_TAC(PairList [int_add, GSYM(int_rep), is_int]) then_tac \
                            REPEAT(GEN_TAC)
                          ) then_tac \
                          X_CHOOSE_THEN(hol: var m :: num; m)(DISJ_CASES_TAC)(SPEC(hol: var x :: int; x)(dest_int_rep))
                        ) then_tac \
                        X_CHOOSE_THEN(hol: var n :: num; n)(DISJ_CASES_TAC)(SPEC(hol: var y :: int; y)(dest_int_rep))
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, EXISTS_OR_THM])
                    ) then_tac \
                    REWRITE_TAC(PairList [GSYM(EXISTS_REFL)])
                  ) then_tac \
                  DISJ_CASES_THEN(MP_TAC)(
                    SPECL(PairList [(hol: var m :: num; m), (hol: var n :: num; n)])(LE_CASES)
                  )
                ) then_tac \
                REWRITE_TAC(PairList [LE_EXISTS])
              ) then_tac \
              DISCH_THEN(X_CHOOSE_THEN(hol: var d :: num; d)(SUBST1_TAC))
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(REAL_OF_NUM_ADD), OR_EXISTS_THM, REAL_NEG_ADD])
          ) then_tac \
          TRY((EXISTS_TAC(hol: var d :: num; d) then_tac REAL_ARITH_TAC))
        ) then_tac \
        REWRITE_TAC(
          PairList [
            EXISTS_OR_THM,
            GSYM(REAL_NEG_ADD),
            REAL_EQ_NEG2,
            REAL_OF_NUM_ADD,
            REAL_OF_NUM_EQ,
            GSYM(EXISTS_REFL)
          ]
        )
      )
    ]
  )

def int_sub:
  new_definition(
    (hol:
       var int_sub :: int -> int -> int
       var x :: int
       var y :: int
       const int_of_real :: real -> int
       const real_of_int :: int -> real
       int_sub(x, y) == int_of_real(real_of_int(x) - real_of_int(y)))
  )

def int_sub_th:
  prove(
    [
      (hol:
         const real_of_int :: int -> real
         forall (x :: int, y :: int): real_of_int(x - y) == real_of_int(x) - real_of_int(y)),
      (
        REWRITE_TAC(PairList [int_sub, real_sub, GSYM(int_neg_th), GSYM(int_add_th)]) then_tac \
        REWRITE_TAC(PairList [int_int_abstr_v2])
      )
    ]
  )

def int_mul:
  new_definition(
    (hol:
       var int_mul :: int -> int -> int
       var x :: int
       var y :: int
       const int_of_real :: real -> int
       const real_of_int :: int -> real
       int_mul(x, y) == int_of_real(real_of_int(x) * real_of_int(y)))
  )

def int_mul_th:
  prove(
    [
      (hol:
         const real_of_int :: int -> real
         forall (x :: int, y :: int): real_of_int(x * y) == real_of_int(x) * real_of_int(y)),
      (
        (
          (
            (
              (
                (
                  REPEAT(GEN_TAC) then_tac \
                  REWRITE_TAC(PairList [int_mul, GSYM(int_rep), is_int])
                ) then_tac \
                X_CHOOSE_THEN(hol: var m :: num; m)(DISJ_CASES_TAC)(SPEC(hol: var x :: int; x)(dest_int_rep))
              ) then_tac \
              X_CHOOSE_THEN(hol: var n :: num; n)(DISJ_CASES_TAC)(SPEC(hol: var y :: int; y)(dest_int_rep))
            ) then_tac \
            ASM_REWRITE_TAC(PairList [REAL_OF_NUM_ADD, REAL_OF_NUM_EQ, EXISTS_OR_THM])
          ) then_tac \
          REWRITE_TAC(
            PairList [
              REAL_MUL_LNEG,
              REAL_MUL_RNEG,
              REAL_NEG_NEG,
              REAL_OF_NUM_MUL
            ]
          )
        ) then_tac \
        REWRITE_TAC(PairList [REAL_EQ_NEG2, REAL_OF_NUM_EQ, GSYM(EXISTS_REFL)])
      )
    ]
  )

def int_abs:
  new_definition(
    (hol:
       var int_abs :: int -> int
       var x :: int
       const int_of_real :: real -> int
       const real_abs :: real -> real
       const real_of_int :: int -> real
       int_abs(x) == int_of_real(real_abs(real_of_int(x))))
  )

def int_abs_th:
  prove(
    [
      (hol:
         const real_of_int :: int -> real
         const int_abs :: int -> int
         const real_abs :: real -> real
         forall x :: int: real_of_int(int_abs(x)) == real_abs(real_of_int(x))),
      (
        (
          (GEN_TAC then_tac REWRITE_TAC(PairList [int_abs, real_abs])) then_tac \
          COND_CASES_TAC
        ) then_tac \
        REWRITE_TAC(PairList [GSYM(int_neg), int_neg_th, int_int_abstr_v2])
      )
    ]
  )

def int_sgn:
  new_definition(
    (hol:
       var int_sgn :: int -> int
       var x :: int
       const int_of_real :: real -> int
       const real_sgn :: real -> real
       const real_of_int :: int -> real
       int_sgn(x) == int_of_real(real_sgn(real_of_int(x))))
  )

def int_sgn_th:
  prove(
    [
      (hol:
         const real_of_int :: int -> real
         const int_sgn :: int -> int
         const real_sgn :: real -> real
         forall x :: int: real_of_int(int_sgn(x)) == real_sgn(real_of_int(x))),
      (
        (
          (
            GEN_TAC then_tac \
            REWRITE_TAC(PairList [int_sgn, real_sgn, GSYM(int_rep)])
          ) then_tac \
          REPEAT((COND_CASES_TAC then_tac ASM_REWRITE_TAC(PairList [])))
        ) then_tac \
        MESON_TAC(PairList [is_int])
      )
    ]
  )

def int_max:
  new_definition(
    (hol:
       var int_max :: int -> int -> int
       var x :: int
       var y :: int
       const int_of_real :: real -> int
       const real_max :: real -> real -> real
       const real_of_int :: int -> real
       int_max(x, y) == int_of_real(real_max(real_of_int(x), real_of_int(y))))
  )

def int_max_th:
  prove(
    [
      (hol:
         const real_of_int :: int -> real
         const int_max :: int -> int -> int
         const real_max :: real -> real -> real
         forall (x :: int, y :: int):
           real_of_int(int_max(x, y)) == real_max(real_of_int(x), real_of_int(y))),
