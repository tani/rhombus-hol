def int_tybij:«
  Class.new_type_definition("int")(Pair("int_of_real","real_of_int"))(Tactics.prove(Pair(Host.expand_quote("[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]],[\"Comb\",[\"Const\",\"integer\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]]]"),(block:«
    let port_tmp_1 = Simp.REWRITE_TAC(PairList.cons(is_int,PairList.cons(Realax.REAL_OF_NUM_EQ,PairList.cons(Theorems.EXISTS_OR_THM,PairList.cons(Equal.GSYM(Theorems.EXISTS_REFL),PairList [])))));
    let port_tmp_2 = Tactics.EXISTS_TAC(Host.expand_quote("[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"NUMERAL\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Const\",\"_0\",[\"Tyapp\",\"num\",[]]]]]"));
    Tactics.THEN(port_tmp_2)(port_tmp_1)
  »))))
»

def Pair(int_abstr,int_rep):«
  (block:«
    let port_tmp_3 = Bool.SPEC_ALL(Bool.CONJUNCT2(int_tybij));
    let port_tmp_4 = Bool.SPEC_ALL(Bool.CONJUNCT1(int_tybij));
    Pair(port_tmp_4,port_tmp_3)
  »)
