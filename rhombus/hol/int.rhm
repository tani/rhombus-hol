def num_divides:
  new_definition(
    (hol:
       var num_divides :: num -> num -> bool
       var a :: num
       var b :: num
       const int_divides :: int -> int -> bool
       const int_of_num :: num -> int
       num_divides(a, b) <=> int_divides(int_of_num(a), int_of_num(b)))
  )

def num_mod:
  new_definition(
    (hol:
       var num_mod :: num -> num -> num -> bool
       var n :: num
       var x :: num
       var y :: num
       const int_mod :: int -> int -> int -> bool
       const int_of_num :: num -> int
       num_mod(n, x, y) <=> int_mod(int_of_num(n), int_of_num(x), int_of_num(y)))
  )

def num_congruent:
  prove(
    [
      (hol:
         const #{==} :: A -> A -> (A -> A -> bool) -> bool
         const num_mod :: num -> num -> num -> bool
         const int_of_num :: num -> int
         const int_mod :: int -> int -> int -> bool
         forall (x :: num, y :: num, n :: num):
           const.#{==}(x, y, num_mod(n)) <=> const.#{==}(int_of_num(x), int_of_num(y), int_mod(int_of_num(n)))),
      REWRITE_TAC(PairList [cong, num_mod])
    ]
  )

def num_coprime:
  new_definition(
    (hol:
       var num_coprime :: pair(num, num) -> bool
       var a :: num
       var b :: num
       const #{|,|} :: A -> B -> pair(A, B)
       const int_coprime :: pair(int, int) -> bool
       const int_of_num :: num -> int
       num_coprime(const.#{|,|}(a, b)) <=> int_coprime(const.#{|,|}(int_of_num(a), int_of_num(b))))
  )

def num_gcd:
  new_definition(
    (hol:
       var num_gcd :: pair(num, num) -> num
       var a :: num
       var b :: num
       const #{|,|} :: A -> B -> pair(A, B)
       const num_of_int :: int -> num
       const int_gcd :: pair(int, int) -> int
       const int_of_num :: num -> int
       num_gcd(const.#{|,|}(a, b)) == num_of_int(int_gcd(const.#{|,|}(int_of_num(a), int_of_num(b)))))
  )

def num_lcm:
  new_definition(
    (hol:
       var num_lcm :: pair(num, num) -> num
       var a :: num
       var b :: num
       const #{|,|} :: A -> B -> pair(A, B)
       const num_of_int :: int -> num
       const int_lcm :: pair(int, int) -> int
       const int_of_num :: num -> int
       num_lcm(const.#{|,|}(a, b)) == num_of_int(int_lcm(const.#{|,|}(int_of_num(a), int_of_num(b)))))
  )

def NUM_TO_INT_CONV:
  let pth_relativize:
    prove(
      [
        (hol:
           var P :: int -> bool
           const int_of_num :: num -> int
           ((forall n :: num: P(int_of_num(n))) <=> (forall i :: int: !((0 :: int) <= i) || P(i)))
             && ((exists n :: num: P(int_of_num(n))) <=> (exists i :: int: (0 :: int) <= i && P(i)))),
        (
          REWRITE_TAC(PairList [INT_EXISTS_POS, INT_FORALL_POS]) then_tac \
          MESON_TAC(PairList [])
        )
      ]
    )
  let relation_conv_2:
    o(GEN_REWRITE_CONV(TOP_SWEEP_CONV))(map(GSYM))(
      PairList [
        INT_OF_NUM_EQ,
        INT_OF_NUM_LE,
        INT_OF_NUM_LT,
        INT_OF_NUM_GE,
        INT_OF_NUM_GT,
        INT_OF_NUM_SUC,
        INT_OF_NUM_ADD,
        INT_OF_NUM_MUL,
        INT_OF_NUM_POW
      ]
    )
  let quantifier_conv_2 = GEN_REWRITE_CONV(DEPTH_CONV)(PairList [pth_relativize])
  ((NUM_SIMPLIFY_CONV then_conv relation_conv_2) then_conv quantifier_conv_2)

def ARITH_RULE:
  let init_conv_2:
    (
      (
        (
          (
            NUM_SIMPLIFY_CONV then_conv \
            GEN_REWRITE_CONV(DEPTH_CONV)(PairList [ADD1])
          ) then_conv \
          PROP_ATOM_CONV(BINOP_CONV(NUM_NORMALIZE_CONV))
        ) then_conv \
        PRENEX_CONV
      ) then_conv \
      o(GEN_REWRITE_CONV(TOP_SWEEP_CONV))(map(GSYM))(
        PairList [
          INT_OF_NUM_EQ,
          INT_OF_NUM_LE,
          INT_OF_NUM_LT,
          INT_OF_NUM_GE,
          INT_OF_NUM_GT,
          INT_OF_NUM_ADD,
          SPEC(hol:
                 var k :: num
                 const NUMERAL :: num -> num
                 NUMERAL(k))(INT_OF_NUM_MUL),
          INT_OF_NUM_MAX,
          INT_OF_NUM_MIN
        ]
      )
    )
  let is_numimage_2:
    fun(t):
      match t
      | Comb(Const("int_of_num",_),n):
          if !is_numeral(n)
          | #true
          | match t
            | _: #false
      | _: #false
  fun(tm):
    try:
      let th1 = init_conv_2(tm)
      let tm1 = rand(concl(th1))
      let [avs, bod] = strip_forall(tm1)
      let nim = setify(find_terms(is_numimage_2)(bod))
      let gvs = map(o(genvar)(type_of))(nim)
      let pths = map((fun(v): SPEC(rand(v))(INT_POS)))(nim)
      let ibod = itlist(o(curry(mk_imp))(concl))(pths)(bod)
      let gbod = subst(zip(gvs)(nim))(ibod)
      let th2 = INST(zip(nim)(gvs))(int_INT_ARITH(gbod))
      let th3 = GENL(avs)(rev_itlist(C(MP))(pths)(th2))
      EQ_MP(SYM(th1))(th3)
      ~catch exn:
        match exn
        | Failure(msg):
            failwith(
              ("ARITH_RULE `" +& (Host.string_of_term(tm) +& ("`: " +& msg)))
            )
        | exn: (throw exn)

def ARITH_TAC = CONV_TAC(o(EQT_INTRO)(ARITH_RULE))

def ASM_ARITH_TAC:
  (
    REPEAT(
      FIRST_X_ASSUM(o(MP_TAC)(check(o(o((fun (x): !x))(is_forall))(concl))))
    ) then_tac \
    ARITH_TAC
  )

def int_INT_ARITH_v2:
  let pth:
    prove(
      [
        (hol:
           var x :: int
           var y :: int
           (!(x <= y) <=> y + (1 :: int) <= x)
             && ((!(x < y) <=> y <= x)
                   && ((x != y <=> x + (1 :: int) <= y || y + (1 :: int) <= x)
                         && (x < y <=> x + (1 :: int) <= y)))),
        REWRITE_TAC(PairList [INT_NOT_LE, INT_NOT_LT, INT_NOT_EQ, INT_LT_DISCRETE])
      ]
    )
  let atom_CONV_3 = GEN_REWRITE_CONV(I)(PairList [pth])
  let bub_CONV_3:
    GEN_REWRITE_CONV(
      TOP_SWEEP_CONV)(
      PairList [
        int_eq,
        int_le,
        int_lt,
        int_ge,
        int_gt,
        int_of_num_th,
        int_neg_th,
        int_add_th,
        int_mul_th,
        int_sub_th,
        int_pow_th,
        int_abs_th,
        int_max_th,
        int_min_th
      ]
    )
  let base_CONV = (TRY_CONV(atom_CONV_3) then_conv bub_CONV_3)
  let NNF_NORM_CONV = GEN_NNF_CONV(#false)([base_CONV, (fun(t): [base_CONV(t), base_CONV(mk_neg(t))])])
  let x_tm_2 = hol: var x :: int; x
  let y_tm_2 = hol: var y :: int; y
  let n_tm_3 = hol: var n :: num; n
  let pth_pos_2 = SPEC(n_tm_3)(INT_POS)
  let pth_add_2 = SPECL(PairList [x_tm_2, y_tm_2])(INT_LE_ADD)
  let pth_mul_2 = SPECL(PairList [x_tm_2, y_tm_2])(INT_LE_MUL)
  let pth_pow_2 = SPECL(PairList [x_tm_2, n_tm_3])(INT_POW_LE)
  fun rule(tm):
    match tm
    | Comb(Const("int_of_num",_),rtm): INST(PairList [[rtm, n_tm_3]])(pth_pos_2)
    | Comb(Comb(Const("int_add",_),ltm),rtm):
        let lth_2 = rule(ltm)
        let rth_3 = rule(rtm)
        MP(INST(PairList [[ltm, x_tm_2], [rtm, y_tm_2]])(pth_add_2))(CONJ(lth_2)(rth_3))
    | Comb(Comb(Const("int_mul",_),ltm),rtm):
        let lth_3 = rule(ltm)
        let rth_4 = rule(rtm)
        MP(INST(PairList [[ltm, x_tm_2], [rtm, y_tm_2]])(pth_mul_2))(CONJ(lth_3)(rth_4))
    | Comb(Comb(Const("int_pow",_),ltm),rtm):
        let lth = rule(ltm)
        MP(INST(PairList [[ltm, x_tm_2], [rtm, n_tm_3]])(pth_pow_2))(lth)
    | _: failwith("INT_POS_RULE")
  let INT_POS_RULE = rule
  let tac:
    (
      (
        (
          REWRITE_TAC(PairList [GSYM(INT_LT_DISCRETE)]) then_tac \
          ASM_CASES_TAC(
            (hol:
               var n :: int
               n == (0 :: int))
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      ) then_list \
      PairList [
        (
          (
            ASM_REWRITE_TAC(PairList [INT_ABS_NUM, INT_LET_ANTISYM]) then_tac \
            REWRITE_TAC(
              PairList [UNWIND_THM2, GSYM(CONJ_ASSOC), RIGHT_EXISTS_AND_THM]
            )
          ) then_tac \
          REWRITE_TAC(PairList [INT_DIV_0, INT_REM_0])
        ),
        (
          (EQ_TAC then_tac STRIP_TAC) then_list \
          PairList [
            (
              MAP_EVERY(EXISTS_TAC)(
                PairList [
                  (hol:
                     var m :: int
                     var n :: int
                     const div :: int -> int -> int
                     div(m, n)),
                  (hol:
                     var m :: int
                     var n :: int
                     const rem :: int -> int -> int
                     rem(m, n))
                ]
              ) then_tac \
              ASM_SIMP_TAC(PairList [INT_DIVISION, INT_LE_DIV])
            ),
            ASM_METIS_TAC(PairList [INT_DIVMOD_UNIQ])
          ]
        )
      ]
    )
  let DIVREM_ELIM_THM_2:
    prove(
      [
        (hol:
           var P :: int -> int -> bool
           var m :: int
           var n :: int
           const div :: int -> int -> int
           const rem :: int -> int -> int
           const int_abs :: int -> int
           P(div(m, n), rem(m, n))
             <=> (exists (q :: int, r :: int):
                    (n == (0 :: int) && (q == (0 :: int) && r == m)
                       || m == q * n + r && ((0 :: int) <= r && r + (1 :: int) <= int_abs(n)))
                      && P(q, r))),
        tac
      ]
    )
  let DIVREM_ELIM_THM_prime_2:
    prove(
      [
        (hol:
           var P :: int -> int -> bool
           var m :: int
           var n :: int
           const div :: int -> int -> int
           const rem :: int -> int -> int
           const int_abs :: int -> int
           P(div(m, n), rem(m, n))
             <=> (exists (q :: int, r :: int):
                    (n == (0 :: int) && (q == (0 :: int) && r == m)
                       || (m == q * n + r
                             && (((0 :: int) <= m && (0 :: int) <= n ==> (0 :: int) <= q)
                                   && ((0 :: int) <= r && r + (1 :: int) <= int_abs(n)))))
                      && P(q, r))),
        tac
      ]
    )
  let DIVREM_ELIM_THM_POS_2:
    prove(
      [
        (hol:
           var m :: int
           var n :: int
           var P :: int -> int -> bool
           const div :: int -> int -> int
           const rem :: int -> int -> int
           (0 :: int) <= m && (0 :: int) <= n
             ==> (P(div(m, n), rem(m, n))
                    <=> (exists (q :: int, r :: int):
                           (n == (0 :: int) && (q == (0 :: int) && r == m)
                              || (m == q * n + r
                                    && ((0 :: int) <= q && ((0 :: int) <= r && r + (1 :: int) <= n))))
                             && P(q, r)))),
        SIMP_TAC(PairList [DIVREM_ELIM_THM_prime_2, INT_ABS])
      ]
    )
  let BETA2_CONV_2 = (RATOR_CONV(BETA_CONV) then_conv BETA_CONV)
  let div_tm_2 = hol: const div :: int -> int -> int; div
  let rem_tm_2 = hol: const rem :: int -> int -> int; rem
  let p_tm_3 = hol: var P :: int -> int -> bool; P
  let m_tm_3 = hol: var m :: int; m
  let n_tm_4 = hol: var n :: int; n
  let is_div_2 = is_binop(div_tm_2)
  let is_rem_2 = is_binop(rem_tm_2)
  let is_divrem = (fun(tm): (is_div_2(tm) || is_rem_2(tm)))
  fun conv_2(tm):
    try:
      let t = hd(sort(free_in)(find_terms((fun(t): (is_divrem(t) && free_in(t)(tm))))(tm)))
      let x_2 = lhand(t)
      let y_2 = rand(t)
      let dtm_3 = mk_comb([mk_comb([div_tm_2, x_2]), y_2])
      let rtm_2 = mk_comb([mk_comb([rem_tm_2, x_2]), y_2])
      let vd_2 = genvar(type_of(dtm_3))
      let vr_2 = genvar(type_of(rtm_2))
      let p = list_mk_abs([PairList [vd_2, vr_2], subst(PairList [[vd_2, dtm_3], [vr_2, rtm_2]])(tm)])
      let th0 = INST(PairList [[p, p_tm_3], [x_2, m_tm_3], [y_2, n_tm_4]])(DIVREM_ELIM_THM_POS_2)
      let th1:
        try:
          let [ltm, rtm] = dest_conj(lhand(concl(th0)))
          MP(th0)(CONJ(INT_POS_RULE(rand(ltm)))(INT_POS_RULE(rand(rtm))))
          ~catch exn:
            match exn
            | Failure(_): INST(PairList [[p, p_tm_3], [x_2, m_tm_3], [y_2, n_tm_4]])(DIVREM_ELIM_THM_2)
            | exn: (throw exn)
      let th2:
        CONV_RULE(
          COMB2_CONV(RAND_CONV(BETA2_CONV_2))(funpow(2)(BINDER_CONV)(RAND_CONV(BETA2_CONV_2)))
        )(th1)
      let th3 = CONV_RULE(RAND_CONV(funpow(2)(BINDER_CONV)(INT_REDUCE_CONV)))(th2)
      CONV_RULE(RAND_CONV(BINDER_CONV(BINDER_CONV(RAND_CONV(conv_2)))))(th3)
      ~catch exn:
        match exn
        | Failure(_): REFL(tm)
        | exn: (throw exn)
  fun topconv(tm): (if (is_forall(tm) || is_exists(tm)) | BINDER_CONV(topconv)(tm) | conv_2(tm))
  let INT_DIVREM_ELIM_CONV = topconv
  let init_CONV:
    (
      (
        (
          (
            (
              (
                (TOP_DEPTH_CONV(BETA_CONV) then_conv PRESIMP_CONV) then_conv \
                GEN_REWRITE_CONV(DEPTH_CONV)(PairList [INT_GT, INT_GE])
              ) then_conv \
              NNF_CONV
            ) then_conv \
            DEPTH_BINOP_CONV(hol: const #{|\/|} :: bool -> bool -> bool; const.#{|\/|})(CONDS_ELIM_CONV)
          ) then_conv \
          INT_REDUCE_CONV
        ) then_conv \
        INT_DIVREM_ELIM_CONV
      ) then_conv \
      NNF_NORM_CONV
    )
  let p_tm_4 = hol: var p :: bool; p
  let not_tm_3 = hol: const #{~} :: bool -> bool; const.#{~}
  let pth = TAUT(mk_eq([mk_neg(mk_neg(p_tm_4)), p_tm_4]))
  fun(tm):
    try:
      let th0_3 = INST(PairList [[tm, p_tm_4]])(pth)
      let th1_3 = init_CONV(mk_neg(tm))
      let th2 = REAL_ARITH(mk_neg(rand(concl(th1_3))))
      EQ_MP(th0_3)(EQ_MP(AP_TERM(not_tm_3)(SYM(th1_3)))(th2))
      ~catch exn:
        match exn
        | Failure(m):
            failwith(
              ("INT_ARITH `" +& (Host.string_of_term(tm) +& ("`: " +& m)))
            )
        | exn: (throw exn)

def int_INT_ARITH_TAC_v2 = CONV_TAC(o(EQT_INTRO)(int_INT_ARITH_v2))

def int_ASM_INT_ARITH_TAC_v2:
  (
    REPEAT(
      FIRST_X_ASSUM(o(MP_TAC)(check(o(o((fun (x): !x))(is_forall))(concl))))
    ) then_tac \
    int_INT_ARITH_TAC_v2
  )

def BINARY_INDUCT:
  prove(
    [
      (hol:
         forall P :: num -> bool:
           (P((0 :: num))
              && (forall n :: num: P(n) ==> P((2 :: num) * n) && P((2 :: num) * n + (1 :: num))))
             ==> (forall n :: num: P(n))),
      (
        (
          (
            ((GEN_TAC then_tac STRIP_TAC) then_tac MATCH_MP_TAC(num_WF)) then_tac \
            GEN_TAC
          ) then_tac \
          STRIP_ASSUME_TAC(
            ARITH_RULE(
              (hol:
                 var n :: num
                 const DIV :: num -> num -> num
                 n == (0 :: num)
                   || (DIV(n, (2 :: num)) < n
                         && (n == (2 :: num) * DIV(n, (2 :: num))
                               || n == (2 :: num) * DIV(n, (2 :: num)) + (1 :: num))))
            )
          )
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def NUM_CASES_BINARY:
  prove(
    [
      (hol:
         forall P :: num -> bool:
           (forall n :: num: P(n))
             <=> ((forall n :: num: P((2 :: num) * n))
                    && (forall n :: num: P((2 :: num) * n + (1 :: num))))),
      MESON_TAC(
        PairList [
          ARITH_RULE(
            (hol:
               var n :: num
               const DIV :: num -> num -> num
               n == (2 :: num) * DIV(n, (2 :: num)) || n == (2 :: num) * DIV(n, (2 :: num)) + (1 :: num))
          )
        ]
      )
    ]
  )

def num_WF_DOWN:
  prove(
    [
      (hol:
         forall (P :: num -> bool, m :: num):
           ((forall n :: num: m <= n ==> P(n))
              && (forall n :: num: n < m && (forall p :: num: n < p ==> P(p)) ==> P(n)))
             ==> (forall n :: num: P(n))),
      (
        (
          (
            (
              (REPEAT(GEN_TAC) then_tac STRIP_TAC) then_tac \
              ASM_CASES_TAC(
                (hol:
                   var m :: num
                   m == (0 :: num))
              )
            ) then_list \
            PairList [ASM_MESON_TAC(PairList [LE_0]), ALL_TAC]
          ) then_tac \
          SUBGOAL_THEN(
            (hol:
               var P :: num -> bool
               var m :: num
               forall i :: num: P(m - (1 :: num) - i))
          )(MP_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (MATCH_MP_TAC(num_WF) then_tac GEN_TAC) then_tac \
                              DISCH_THEN((fun(th): (FIRST_X_ASSUM(MATCH_MP_TAC) then_tac ASSUME_TAC(th))))
                            ) then_tac \
                            CONJ_TAC
                          ) then_list \
                          PairList [ASM_ARITH_TAC, X_GEN_TAC(hol: var p :: num; p)]
                        ) then_tac \
                        ASM_CASES_TAC(hol:
                                        var m :: num
                                        var p :: num
                                        m <= p)
                      ) then_tac \
                      ASM_SIMP_TAC(PairList [])
                    ) then_tac \
                    STRIP_TAC
                  ) then_tac \
                  FIRST_X_ASSUM(
                    o(MP_TAC)(
                      SPEC(
                        (hol:
                           var m :: num
                           var p :: num
                           m - (1 :: num) - p)
                      )
                    )
                  )
                ) then_tac \
                ASM_SIMP_TAC(
                  PairList [
                    ARITH_RULE(
                      (hol:
                         var m :: num
                         var p :: num
                         !(m <= p) ==> m - (1 :: num) - (m - (1 :: num) - p) == p)
                    )
                  ]
                )
              ) then_tac \
              DISCH_THEN(MATCH_MP_TAC)
            ) then_tac \
            ASM_ARITH_TAC
          ),
          ASM_MESON_TAC(
            PairList [
              ARITH_RULE(
                (hol:
                   var m :: num
                   var n :: num
                   !(m <= n) ==> n == m - (1 :: num) - (m - (1 :: num) - n))
              )
            ]
          )
        ]
      )
    ]
  )

def INT_REM_REM_POW_MIN:
  prove(
    [
      (hol:
         const rem :: int -> int -> int
         const int_pow :: int -> num -> int
         const MIN :: num -> num -> num
         forall (x :: int, p :: int, m :: num, n :: num):
           rem(rem(x, int_pow(p, m)), int_pow(p, n)) == rem(x, int_pow(p, MIN(m, n)))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              REPEAT(GEN_TAC) then_tac \
                              ASM_CASES_TAC(
                                (hol:
                                   var x :: int
                                   x == (0 :: int))
                              )
                            ) then_tac \
                            ASM_REWRITE_TAC(PairList [INT_REM_ZERO])
                          ) then_tac \
                          ASM_CASES_TAC(
                            (hol:
                               var p :: int
                               p == (0 :: int))
                          )
                        ) then_list \
                        PairList [
                          (
                            (
                              ASM_REWRITE_TAC(
                                PairList [
                                  INT_POW_ZERO,
                                  ARITH_RULE(
                                    (hol:
                                       var a :: num
                                       var b :: num
                                       const MIN :: num -> num -> num
                                       MIN(a, b) == (0 :: num) <=> a == (0 :: num) || b == (0 :: num))
                                  )
                                ]
                              ) then_tac \
                              MAP_EVERY(ASM_CASES_TAC)(
                                PairList [
                                  (hol:
                                     var m :: num
                                     m == (0 :: num)),
                                  (hol:
                                     var n :: num
                                     n == (0 :: num))
                                ]
                              )
                            ) then_tac \
                            ASM_REWRITE_TAC(PairList [INT_REM_0, INT_REM_1])
                          ),
                          REWRITE_TAC(
                            PairList [
                              ARITH_RULE(
                                (hol:
                                   var m :: num
                                   var n :: num
                                   const MIN :: num -> num -> num
                                   MIN(m, n) == (if n <= m | n | m))
                              )
                            ]
                          )
                        ]
                      ) then_tac \
                      COND_CASES_TAC
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_list \
                  PairList [
                    (
                      FIRST_X_ASSUM(
                        o(CHOOSE_THEN(SUBST1_TAC))(GEN_REWRITE_RULE(I)(PairList [LE_EXISTS]))
                      ) then_tac \
                      REWRITE_TAC(PairList [INT_POW_ADD, INT_REM_REM_MUL])
                    ),
                    RULE_ASSUM_TAC(REWRITE_RULE(PairList [NOT_LE]))
                  ]
                ) then_tac \
                MATCH_MP_TAC(INT_REM_REM_LE)
              ) then_tac \
              ASM_REWRITE_TAC(PairList [INT_POW_EQ_0, INT_ABS_POW])
            ) then_tac \
            MATCH_MP_TAC(INT_POW_MONO)
          ) then_tac \
          ASM_SIMP_TAC(PairList [LT_IMP_LE])
        ) then_tac \
        int_ASM_INT_ARITH_TAC_v2
      )
    ]
  )

def NUM_GCD:
  prove(
    [
      (hol:
         const int_of_num :: num -> int
         const num_gcd :: pair(num, num) -> num
         const #{|,|} :: A -> B -> pair(A, B)
         const int_gcd :: pair(int, int) -> int
         forall (a :: num, b :: num):
           int_of_num(num_gcd(const.#{|,|}(a, b))) == int_gcd(const.#{|,|}(int_of_num(a), int_of_num(b)))),
      REWRITE_TAC(PairList [num_gcd, GSYM(NUM_OF_INT), int_gcd])
    ]
  )

