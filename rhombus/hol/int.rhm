def [int_INT_DIV_CONV_v2, INT_REM_CONV]:
  let pth_2:
    prove(
      [
        (hol:
           var q :: int
           var n :: int
           var r :: int
           var m :: int
           const int_abs :: int -> int
           const div :: int -> int -> int
           const rem :: int -> int -> int
           q * n + r == m ==> (0 :: int) <= r ==> r < int_abs(n) ==> div(m, n) == q && rem(m, n) == r),
        MESON_TAC(PairList [INT_DIVMOD_UNIQ])
      ]
    )
  let m_4 = hol: var m :: int; m
  let n_4 = hol: var n :: int; n
  let q_2 = hol: var q :: int; q
  let r_2 = hol: var r :: int; r
  let dtm_2 = hol: const div :: int -> int -> int; div
  let mtm_2 = hol: const rem :: int -> int -> int; rem
  let emod_num:
    fun(x):
      fun(y):
        let r = mod_num(x)(y)
        (if (r < 0) | (r + abs_num(y)) | r)
  let equo_num = fun(x): fun(y): quo_num((x - emod_num(x)(y)))(y)
  let INT_DIVMOD_CONV:
    fun(x):
      fun(y):
        let k_2 = equo_num(x)(y)
        let l_2 = emod_num(x)(y)
        let th0:
          INST(
            PairList [
              [mk_intconst(x), m_4],
              [mk_intconst(y), n_4],
              [mk_intconst(k_2), q_2],
              [mk_intconst(l_2), r_2]
            ]
          )(pth_2)
        let tm0 = lhand(lhand(concl(th0)))
        let th1 = (LAND_CONV(INT_MUL_CONV) then_conv INT_ADD_CONV)(tm0)
        let th2 = MP(th0)(th1)
        let tm2 = lhand(concl(th2))
        let th3 = MP(th2)(EQT_ELIM(int_INT_LE_CONV_v2(tm2)))
        let tm3 = lhand(concl(th3))
        MP(th3)(EQT_ELIM((RAND_CONV(INT_ABS_CONV) then_conv int_INT_LT_CONV_v2)(tm3)))
  [
    fun(tm):
      try:
        let [l, r] = dest_binop(dtm_2)(tm)
        CONJUNCT1(INT_DIVMOD_CONV(dest_intconst(l))(dest_intconst(r)))
        ~catch exn:
          match exn
          | Failure(_): failwith("INT_DIV_CONV")
          | exn: (throw exn),
    fun(tm):
      try:
        let [l, r] = dest_binop(mtm_2)(tm)
        CONJUNCT2(INT_DIVMOD_CONV(dest_intconst(l))(dest_intconst(r)))
        ~catch exn:
          match exn
          | Failure(_): failwith("INT_MOD_CONV")
          | exn: (throw exn)
  ]

def int_red_conv_list:
  PairList [
    [
      (hol:
         var x :: int
         var y :: int
         x <= y),
      int_INT_LE_CONV_v2
    ],
    [
      (hol:
         var x :: int
         var y :: int
         x < y),
      int_INT_LT_CONV_v2
    ],
    [
      (hol:
         var x :: int
         var y :: int
         x >= y),
      int_INT_GE_CONV_v2
    ],
    [
      (hol:
         var x :: int
         var y :: int
         x > y),
      int_INT_GT_CONV_v2
    ],
    [(hol:
        var x :: int
        var y :: int
        x == y), INT_EQ_CONV],
    [
      (hol:
         var x :: int
         -x),
      CHANGED_CONV(INT_NEG_CONV)
    ],
    [(hol:
        var x :: int
        const int_sgn :: int -> int
        int_sgn(x)), INT_SGN_CONV],
    [(hol:
        var x :: int
        const int_abs :: int -> int
        int_abs(x)), INT_ABS_CONV],
    [
      (hol:
         var x :: int
         var y :: int
         x + y),
      INT_ADD_CONV
    ],
    [
      (hol:
         var x :: int
         var y :: int
         x - y),
      INT_SUB_CONV
    ],
    [
      (hol:
         var x :: int
         var y :: int
         x * y),
      INT_MUL_CONV
    ],
    [
      (hol:
         var x :: int
         var y :: int
         const div :: int -> int -> int
         div(x, y)),
      int_INT_DIV_CONV_v2
    ],
    [
      (hol:
         var x :: int
         var y :: int
         const rem :: int -> int -> int
         rem(x, y)),
      INT_REM_CONV
    ],
    [
      (hol:
         var x :: int
         var n :: num
         const int_pow :: int -> num -> int
         int_pow(x, n)),
      INT_POW_CONV
    ],
    [
      (hol:
         var x :: int
         var y :: int
         const int_max :: int -> int -> int
         int_max(x, y)),
      INT_MAX_CONV
    ],
    [
      (hol:
         var x :: int
         var y :: int
         const int_min :: int -> int -> int
         int_min(x, y)),
      INT_MIN_CONV
    ]
  ]

def INT_RED_CONV:
  let gconv_net = itlist(uncurry(net_of_conv))(int_red_conv_list)(basic_net(#void))
  REWRITES_CONV(gconv_net)

def INT_REDUCE_CONV = DEPTH_CONV(INT_RED_CONV)

def int_compute_add_convs:
  let convlist:
    map(
      fun([pat, the_conv]):
        let [c, args] = strip_comb(pat)
        [c, length(args), the_conv]
    )(int_red_conv_list)
  (fun(compset): itlist(fun(newc): fun(_): Compute.Compute.add_conv(newc)(compset))(convlist)(#void))

def INT_COMPUTE_CONV:
  let cs = Compute.Compute.bool_compset(#void)
  Compute.Compute.set_skip(cs)(hol: const COND :: bool -> A -> A -> A; COND)(Some(1))
  int_compute_add_convs(cs)
  Compute.Compute.WEAK_CBV_CONV(cs)

def INT_2_DIVIDES_ADD:
  prove(
    [
      (hol:
         const int_divides :: int -> int -> bool
         forall (m :: int, n :: int):
           int_divides((2 :: int), m + n)
             <=> (int_divides((2 :: int), m) <=> int_divides((2 :: int), n))),
      (
        (
          (
            (
              (
                (
                  REPEAT(GEN_TAC) then_tac \
                  REWRITE_TAC(PairList [GSYM(INT_REM_2_DIVIDES)])
                ) then_tac \
                ONCE_REWRITE_TAC(PairList [GSYM(INT_ADD_REM)])
              ) then_tac \
              DISJ_CASES_TAC(SPEC(hol: var m :: int; m)(INT_REM_2_CASES))
            ) then_tac \
            DISJ_CASES_TAC(SPEC(hol: var n :: int; n)(INT_REM_2_CASES))
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        CONV_TAC(INT_REDUCE_CONV)
      )
    ]
  )

