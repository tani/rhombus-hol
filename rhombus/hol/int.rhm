def [int_INT_DIV_CONV_v2, INT_REM_CONV]:
  let pth_2:
    prove(
      [
        Host.hol_term(Implies(
          Eq(
            Int,
            App(
              Const("int_add", Fun(Int, Fun(Int, Int))),
              [App(Const("int_mul", Fun(Int, Fun(Int, Int))), [Var("q", Int), Var("n", Int)]), Var("r", Int)]
            ),
            Var("m", Int)
          ),
          Implies(
            App(
              Const("int_le", Fun(Int, Fun(Int, Bool))),
              [
                App(
                  Const("int_of_num", Fun(Num, Int)),
                  [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                ),
                Var("r", Int)
              ]
            ),
            Implies(
              App(
                Const("int_lt", Fun(Int, Fun(Int, Bool))),
                [Var("r", Int), App(Const("int_abs", Fun(Int, Int)), [Var("n", Int)])]
              ),
              And(
                Eq(
                  Int,
                  App(Const("div", Fun(Int, Fun(Int, Int))), [Var("m", Int), Var("n", Int)]),
                  Var("q", Int)
                ),
                Eq(
                  Int,
                  App(Const("rem", Fun(Int, Fun(Int, Int))), [Var("m", Int), Var("n", Int)]),
                  Var("r", Int)
                )
              )
            )
          )
        )),
        MESON_TAC(PairList [INT_DIVMOD_UNIQ])
      ]
    )
  let m_4 = Host.hol_term(Var("m", Int))
  let n_4 = Host.hol_term(Var("n", Int))
  let q_2 = Host.hol_term(Var("q", Int))
  let r_2 = Host.hol_term(Var("r", Int))
  let dtm_2 = Host.hol_term(Const("div", Fun(Int, Fun(Int, Int))))
  let mtm_2 = Host.hol_term(Const("rem", Fun(Int, Fun(Int, Int))))
  let emod_num:
    fun(x):
      fun(y):
        let r = Host.mod_num(x)(y)
        (if (r < Host.num(0)) | (r + Host.abs_num(y)) | r)
  let equo_num = fun(x): fun(y): Host.quo_num((x - emod_num(x)(y)))(y)
  let INT_DIVMOD_CONV:
    fun(x):
      fun(y):
        let k_2 = equo_num(x)(y)
        let l_2 = emod_num(x)(y)
        let th0:
          INST(
            PairList [
              [mk_intconst(x), m_4],
              [mk_intconst(y), n_4],
              [mk_intconst(k_2), q_2],
              [mk_intconst(l_2), r_2]
            ]
          )(pth_2)
        let tm0 = lhand(lhand(concl(th0)))
        let th1 = (LAND_CONV(INT_MUL_CONV) then_conv INT_ADD_CONV)(tm0)
        let th2 = MP(th0)(th1)
        let tm2 = lhand(concl(th2))
        let th3 = MP(th2)(EQT_ELIM(int_INT_LE_CONV_v2(tm2)))
        let tm3 = lhand(concl(th3))
        MP(th3)(EQT_ELIM((RAND_CONV(INT_ABS_CONV) then_conv int_INT_LT_CONV_v2)(tm3)))
  [
    fun(tm):
      try:
        let [l, r] = dest_binop(dtm_2)(tm)
        CONJUNCT1(INT_DIVMOD_CONV(dest_intconst(l))(dest_intconst(r)))
        ~catch exn:
          match exn
          | Failure(_): failwith("INT_DIV_CONV")
          | exn: (throw exn),
    fun(tm):
      try:
        let [l, r] = dest_binop(mtm_2)(tm)
        CONJUNCT2(INT_DIVMOD_CONV(dest_intconst(l))(dest_intconst(r)))
        ~catch exn:
          match exn
          | Failure(_): failwith("INT_MOD_CONV")
          | exn: (throw exn)
  ]

def int_red_conv_list:
  PairList [
    [
      Host.hol_term(App(Const("int_le", Fun(Int, Fun(Int, Bool))), [Var("x", Int), Var("y", Int)])),
      int_INT_LE_CONV_v2
    ],
    [
      Host.hol_term(App(Const("int_lt", Fun(Int, Fun(Int, Bool))), [Var("x", Int), Var("y", Int)])),
      int_INT_LT_CONV_v2
    ],
    [
      Host.hol_term(App(Const("int_ge", Fun(Int, Fun(Int, Bool))), [Var("x", Int), Var("y", Int)])),
      int_INT_GE_CONV_v2
    ],
    [
      Host.hol_term(App(Const("int_gt", Fun(Int, Fun(Int, Bool))), [Var("x", Int), Var("y", Int)])),
      int_INT_GT_CONV_v2
    ],
    [Host.hol_term(Eq(Int, Var("x", Int), Var("y", Int))), INT_EQ_CONV],
    [
      Host.hol_term(App(Const("int_neg", Fun(Int, Int)), [Var("x", Int)])),
      CHANGED_CONV(INT_NEG_CONV)
    ],
    [Host.hol_term(App(Const("int_sgn", Fun(Int, Int)), [Var("x", Int)])), INT_SGN_CONV],
    [Host.hol_term(App(Const("int_abs", Fun(Int, Int)), [Var("x", Int)])), INT_ABS_CONV],
    [
      Host.hol_term(App(Const("int_add", Fun(Int, Fun(Int, Int))), [Var("x", Int), Var("y", Int)])),
      INT_ADD_CONV
    ],
    [
      Host.hol_term(App(Const("int_sub", Fun(Int, Fun(Int, Int))), [Var("x", Int), Var("y", Int)])),
      INT_SUB_CONV
    ],
    [
      Host.hol_term(App(Const("int_mul", Fun(Int, Fun(Int, Int))), [Var("x", Int), Var("y", Int)])),
      INT_MUL_CONV
    ],
    [
      Host.hol_term(App(Const("div", Fun(Int, Fun(Int, Int))), [Var("x", Int), Var("y", Int)])),
      int_INT_DIV_CONV_v2
    ],
    [
      Host.hol_term(App(Const("rem", Fun(Int, Fun(Int, Int))), [Var("x", Int), Var("y", Int)])),
      INT_REM_CONV
    ],
    [
      Host.hol_term(App(Const("int_pow", Fun(Int, Fun(Num, Int))), [Var("x", Int), Var("n", Num)])),
      INT_POW_CONV
    ],
    [
      Host.hol_term(App(Const("int_max", Fun(Int, Fun(Int, Int))), [Var("x", Int), Var("y", Int)])),
      INT_MAX_CONV
    ],
    [
      Host.hol_term(App(Const("int_min", Fun(Int, Fun(Int, Int))), [Var("x", Int), Var("y", Int)])),
      INT_MIN_CONV
    ]
  ]

def INT_RED_CONV:
  let gconv_net = itlist(uncurry(net_of_conv))(int_red_conv_list)(Host.hol_apply_unit(basic_net))
  REWRITES_CONV(gconv_net)

def INT_REDUCE_CONV = DEPTH_CONV(INT_RED_CONV)

def int_compute_add_convs:
  let convlist:
    map(
      fun([pat, the_conv]):
        let [c, args] = strip_comb(pat)
        [c, length(args), the_conv]
    )(int_red_conv_list)
  (fun(compset): Host.hol_apply_unit(itlist(fun(newc): fun(_): Compute.Compute.add_conv(newc)(compset))(convlist)))

def INT_COMPUTE_CONV:
  let cs = Host.hol_apply_unit(Compute.Compute.bool_compset)
  Compute.Compute.set_skip(cs)(Host.hol_term(Const("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))))))(Host.Some(1))
  int_compute_add_convs(cs)
  Compute.Compute.WEAK_CBV_CONV(cs)

