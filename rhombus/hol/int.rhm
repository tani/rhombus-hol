  )

def INT_SGN_CONV:
  (
    (
      GEN_REWRITE_CONV(I)(PairList [INT_SGN]) then_conv \
      RATOR_CONV(LAND_CONV(int_INT_LT_CONV_v2))
    ) then_conv \
    (
      GEN_REWRITE_CONV(I)(PairList [CONJUNCT1(SPEC_ALL(COND_CLAUSES))]) or_conv \
      (
        (
          GEN_REWRITE_CONV(I)(PairList [CONJUNCT2(SPEC_ALL(COND_CLAUSES))]) then_conv \
          RATOR_CONV(LAND_CONV(int_INT_LT_CONV_v2))
        ) then_conv \
        GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES])
      )
    )
  )

def INT_POLY_CONV:
  let sth_2:
    prove(
      [
        (hol:
           const int_pow :: int -> num -> int
           const SUC :: num -> num
           (forall (x :: int, y :: int, z :: int): x + (y + z) == x + y + z)
             && ((forall (x :: int, y :: int): x + y == y + x)
                   && ((forall x :: int: (0 :: int) + x == x)
                         && ((forall (x :: int, y :: int, z :: int): x * (y * z) == x * y * z)
                               && ((forall (x :: int, y :: int): x * y == y * x)
                                     && ((forall x :: int: (1 :: int) * x == x)
                                           && ((forall x :: int: (0 :: int) * x == (0 :: int))
                                                 && ((forall (x :: int, y :: int, z :: int):
                                                        x * (y + z) == x * y + x * z)
                                                       && ((forall x :: int:
                                                              int_pow(x, (0 :: num)) == (1 :: int))
                                                             && (forall (x :: int, n :: num):
                                                                   int_pow(x, SUC(n)) == x * int_pow(x, n))))))))))),
        (REWRITE_TAC(PairList [INT_POW]) then_tac int_INT_ARITH_TAC)
      ]
    )
  let rth_2:
    prove(
      [
        (hol:
           (forall x :: int: -x == (-(1 :: int)) * x)
             && (forall (x :: int, y :: int): x - y == x + (-(1 :: int)) * y)),
        int_INT_ARITH_TAC
      ]
    )
  let is_semiring_constant_2 = is_intconst
  let SEMIRING_ADD_CONV_2 = INT_ADD_CONV
  let SEMIRING_MUL_CONV_2 = INT_MUL_CONV
  let SEMIRING_POW_CONV_2 = INT_POW_CONV
  let [_, _, _, _, _, INT_POLY_CONV] = SEMIRING_NORMALIZERS_CONV(sth_2)(rth_2)([is_semiring_constant_2, SEMIRING_ADD_CONV_2, SEMIRING_MUL_CONV_2, SEMIRING_POW_CONV_2])(fun (x): fun (y): x < y)
  INT_POLY_CONV

def [int_INT_RING_v2, int_ideal_cofactors]:
  let INT_INTEGRAL_2:
    prove(
      [
        (hol:
           (forall x :: int: (0 :: int) * x == (0 :: int))
             && ((forall (x :: int, y :: int, z :: int): x + y == x + z <=> y == z)
                   && (forall (w :: int, x :: int, y :: int, z :: int):
                         w * y + x * z == w * z + x * y <=> w == x || y == z))),
        (
          (
            (
              (
                REWRITE_TAC(PairList [MULT_CLAUSES, EQ_ADD_LCANCEL]) then_tac \
                REWRITE_TAC(PairList [GSYM(INT_OF_NUM_EQ), GSYM(INT_OF_NUM_ADD), GSYM(INT_OF_NUM_MUL)])
              ) then_tac \
              ONCE_REWRITE_TAC(PairList [GSYM(INT_SUB_0)])
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(INT_ENTIRE)])
          ) then_tac \
          int_INT_ARITH_TAC
        )
      ]
    )
  let int_ty_3 = hol_type: int
  let [pure, ideal]:
    RING_AND_IDEAL_CONV(
      [
        dest_intconst,
        mk_intconst,
        INT_EQ_CONV,
        (hol: const int_neg :: int -> int; int_neg),
        (hol: const int_add :: int -> int -> int; int_add),
        (hol: const int_sub :: int -> int -> int; int_sub),
        genvar(bool_ty),
        (hol: const int_mul :: int -> int -> int; int_mul),
        genvar(bool_ty),
        (hol: const int_pow :: int -> num -> int; int_pow),
        INT_INTEGRAL_2,
        TRUTH,
        INT_POLY_CONV
      ]
    )
  [
    pure,
    fun(tms): fun(tm): (if forall((fun(t): (type_of(t) == int_ty_3)))(PairList [tm, & tms]) | ideal(tms)(tm) | failwith("int_ideal_cofactors: not all terms have type :int"))
  ]

TypeInference.make_overloadable("divides")(hol_type: A -> A -> bool)

TypeInference.make_overloadable("mod")(hol_type: A -> A -> A -> bool)

TypeInference.make_overloadable("coprime")(hol_type: pair(A, A) -> bool)

TypeInference.make_overloadable("gcd")(hol_type: pair(A, A) -> A)

TypeInference.make_overloadable("lcm")(hol_type: pair(A, A) -> A)

Host.parse_as_infix(["==", [10, "right"]])

def cong:
  new_definition(
    (hol:
       var #{==} :: A -> A -> (A -> A -> bool) -> bool
       var x :: A
       var y :: A
       var rel :: A -> A -> bool
       var.#{==}(x, y, rel) <=> rel(x, y))
  )

def real_mod:
  new_definition(
    (hol:
       var real_mod :: real -> real -> real -> bool
       var n :: real
       var x :: real
       var y :: real
       const integer :: real -> bool
       real_mod(n, x, y) <=> (exists q :: real: integer(q) && x - y == q * n))
  )

TypeInference.overload_interface(["mod", (hol: const real_mod :: real -> real -> real -> bool; real_mod)])

Host.parse_as_infix(["divides", [12, "right"]])

TypeInference.overload_interface(["divides", (hol: var int_divides :: int -> int -> bool; int_divides)])

def int_divides:
  new_definition(
    (hol:
       var int_divides :: int -> int -> bool
       var a :: int
       var b :: int
       int_divides(a, b) <=> (exists x :: int: b == a * x))
  )

def INT_DIVIDES_LE:
  prove(
    [
      (hol:
         const int_divides :: int -> int -> bool
         const int_abs :: int -> int
         forall (x :: int, y :: int): int_divides(x, y) ==> int_abs(x) <= int_abs(y) || y == (0 :: int)),
      (
        (
          (
            (
              (
                SIMP_TAC(PairList [int_divides, LEFT_IMP_EXISTS_THM, INT_ABS_MUL, INT_ENTIRE]) then_tac \
                REWRITE_TAC(
                  PairList [
                    TAUT(
                      (hol:
                         var p :: bool
                         var q :: bool
                         var r :: bool
                         p || (q || r) <=> !q && !r ==> p)
                    )
                  ]
                )
              ) then_tac \
              REWRITE_TAC(
                PairList [
                  int_INT_ARITH(
                    (hol:
                       var x :: int
                       var y :: int
                       x <= x * y <=> (0 :: int) <= x * (y - (1 :: int)))
                  )
                ]
              )
            ) then_tac \
            REPEAT(STRIP_TAC)
          ) then_tac \
          MATCH_MP_TAC(INT_LE_MUL)
        ) then_tac \
        int_ASM_INT_ARITH_TAC
      )
    ]
  )

Host.parse_as_prefix("mod")

TypeInference.overload_interface(["mod", (hol: var int_mod :: int -> int -> int -> bool; int_mod)])

def int_mod:
  new_definition(
    (hol:
       var int_mod :: int -> int -> int -> bool
       var n :: int
       var x :: int
       var y :: int
       const int_divides :: int -> int -> bool
       int_mod(n, x, y) <=> int_divides(n, x - y))
  )

def int_congruent:
  prove(
    [
      (hol:
         const #{==} :: A -> A -> (A -> A -> bool) -> bool
         const int_mod :: int -> int -> int -> bool
         forall (x :: int, y :: int, n :: int):
           const.#{==}(x, y, int_mod(n)) <=> (exists d :: int: x - y == n * d)),
      REWRITE_TAC(PairList [int_mod, cong, int_divides])
    ]
  )

def INT_CONG_IMP_EQ:
  prove(
    [
      (hol:
         const int_abs :: int -> int
         const #{==} :: A -> A -> (A -> A -> bool) -> bool
         const int_mod :: int -> int -> int -> bool
         forall (x :: int, y :: int, n :: int): int_abs(x - y) < n && const.#{==}(x, y, int_mod(n)) ==> x == y),
      (
        (
          (
            REWRITE_TAC(PairList [int_congruent, GSYM(int_divides)]) then_tac \
            REPEAT(STRIP_TAC)
          ) then_tac \
          FIRST_ASSUM(o(MP_TAC)(MATCH_MP(INT_DIVIDES_LE)))
        ) then_tac \
        int_ASM_INT_ARITH_TAC
      )
    ]
  )

TypeInference.overload_interface(["coprime", (hol: var int_coprime :: pair(int, int) -> bool; int_coprime)])

def int_coprime:
  new_definition(
    (hol:
       var int_coprime :: pair(int, int) -> bool
       const #{|,|} :: A -> B -> pair(A, B)
       forall (a :: int, b :: int):
         int_coprime(const.#{|,|}(a, b)) <=> (exists (x :: int, y :: int): a * x + b * y == (1 :: int)))
  )

def int_INTEGER_TAC:
  let int_ty = hol_type: int
  let INT_POLYEQ_CONV:
    (
      GEN_REWRITE_CONV(I)(PairList [GSYM(INT_SUB_0)]) then_conv \
      LAND_CONV(INT_POLY_CONV)
    )
  let pth:
    int_INT_ARITH(
      (hol:
         forall (a :: int, x :: int): a == (0 :: int) <=> x == x + a)
    )
  let is_defined:
    fun(v):
      fun(t):
        let mons = striplist(dest_binary("int_add"))(t)
        (mem(v)(mons) && forall((fun(m): ((v == m) || !free_in(v)(m))))(mons))
  let ISOLATE_VARIABLE:
    fun(vars):
      fun(tm):
        let th_2 = INT_POLYEQ_CONV(tm)
        let th_prime_2 = (SYM_CONV then_conv INT_POLYEQ_CONV)(tm)
        let [v, th1]:
          try:
            [find((fun(v): is_defined(v)(lhand(rand(concl(th_2))))))(vars), th_prime_2]
            ~catch exn:
              match exn
              | Failure(_): [find((fun(v): is_defined(v)(lhand(rand(concl(th_prime_2))))))(vars), th_2]
              | exn: (throw exn)
        let th2 = TRANS(th1)(SPECL(PairList [lhs(rand(concl(th1))), v])(pth))
        CONV_RULE(RAND_CONV(RAND_CONV(INT_POLY_CONV)))(th2)
  let UNWIND_POLYS_CONV:
    fun(tm):
      let [vars, bod] = strip_exists(tm)
      let cjs = conjuncts(bod)
      let th1 = tryfind(ISOLATE_VARIABLE(vars))(cjs)
      let eq = lhand(concl(th1))
      let bod_prime = list_mk_conj(PairList [eq, & subtract(cjs)(PairList [eq])])
      let th2 = CONJ_ACI_RULE(mk_eq([bod, bod_prime]))
      let th3 = TRANS(th2)(MK_CONJ(th1)(REFL(rand(rand(concl(th2))))))
      let v = lhs(lhand(rand(concl(th3))))
      let vars_prime = append(subtract(vars)(PairList [v]))(PairList [v])
      let th4 = CONV_RULE(RAND_CONV(REWR_CONV(UNWIND_THM2)))(MK_EXISTS(v)(th3))
      let IMP_RULE = fun(v): fun(v_prime): DISCH_ALL(itlist(SIMPLE_CHOOSE)(v)(itlist(SIMPLE_EXISTS)(v_prime)(ASSUME(bod))))
      let th5 = IMP_ANTISYM_RULE(IMP_RULE(vars)(vars_prime))(IMP_RULE(vars_prime)(vars))
      TRANS(th5)(itlist(MK_EXISTS)(subtract(vars)(PairList [v]))(th4))
  let zero_tm_2:
    (hol:
       (0 :: int))
  let one_tm_2:
    (hol:
       (1 :: int))
  let mul_tm_2 = hol: const int_mul :: int -> int -> int; int_mul
  let add_tm_2 = hol: const int_add :: int -> int -> int; int_add
  let neg_tm_3 = hol: const int_neg :: int -> int; int_neg
  let dest_mul_2 = dest_binop(mul_tm_2)
  let dest_add_2 = dest_binop(add_tm_2)
  let mk_mul_2 = mk_binop(mul_tm_2)
  let mk_add_2 = mk_binop(add_tm_2)
  let scrub_var:
    fun(v):
      fun(m):
        let ps = striplist(dest_mul_2)(m)
        let ps_prime = subtract(ps)(PairList [v])
        (if (ps_prime == (PairList [])) | one_tm_2 | end_itlist(mk_mul_2)(ps_prime))
  let find_multipliers:
    fun(v):
      fun(mons):
        let mons1 = filter((fun(m): free_in(v)(m)))(mons)
        let mons2 = map(scrub_var(v))(mons1)
        (if (mons2 == (PairList [])) | zero_tm_2 | end_itlist(mk_add_2)(mons2))
  let isolate_monomials:
    fun(vars):
      fun(tm):
        let [cmons, vmons] = partition((fun(m): (intersect(frees(m))(vars) == (PairList []))))(striplist(dest_add_2)(tm))
        let cofactors_2 = map((fun(v): find_multipliers(v)(vmons)))(vars)
        let cnc_2 = (if (cmons == (PairList [])) | zero_tm_2 | mk_comb([neg_tm_3, end_itlist(mk_add_2)(cmons)]))
        [cofactors_2, cnc_2]
  let isolate_variables:
    fun(evs):
      fun(ps):
        fun(eq):
          let vars = filter((fun(v): vfree_in(v)(eq)))(evs)
          let [qs, p] = isolate_monomials(vars)(eq)
          let rs = filter((fun(t): (type_of(t) == int_ty)))(append(qs)(ps))
          let rs = int_ideal_cofactors(rs)(p)
          [eq, zip(fst(chop_list(length(qs))(rs)))(vars)]
  let subst_in_poly = fun(i): fun(p): rhs(concl(INT_POLY_CONV(vsubst(i)(p))))
  // Recursive elimination needs the local definition before its first use.
  fun solve_idealism(evs):
    fun(ps):
      fun(eqs):
        if (evs == (PairList []))
        | PairList []
        | let [eq, cfs] = tryfind(isolate_variables(evs)(ps))(eqs)
          let evs_prime_2 = subtract(evs)(map(snd)(cfs))
          let eqs_prime_2 = map(subst_in_poly(cfs))(subtract(eqs)(PairList [eq]))
          append(cfs)(solve_idealism(evs_prime_2)(ps)(eqs_prime_2))
  fun GENVAR_EXISTS_CONV(tm):
    if !is_exists(tm)
    | REFL(tm)
    | let [ev, bod] = dest_exists(tm)
      let gv = genvar(type_of(ev))
      (GEN_ALPHA_CONV(gv) then_conv BINDER_CONV(GENVAR_EXISTS_CONV))(tm)
  let EXISTS_POLY_TAC:
    fun([asl, w] as gl):
      let [evs_2, bod_2] = strip_exists(w)
      let ps_2:
        mapfilter(
          o(o(o(check((fun(t): (type_of(t) == int_ty))))(lhs))(concl))(snd)
        )(asl)
      let cfs = solve_idealism(evs_2)(ps_2)(map(lhs)(conjuncts(bod_2)))
      (
        (
          MAP_EVERY(EXISTS_TAC)(map((fun(v): rev_assocd(v)(cfs)(zero_tm_2)))(evs_2)) then_tac \
          REPEAT(POP_ASSUM(MP_TAC))
        ) then_tac \
        CONV_TAC(int_INT_RING_v2)
      )(gl)
  let SCRUB_NEQ_TAC:
    o(MATCH_MP_TAC)(
      MATCH_MP(
        MESON(
          PairList [])(
          (hol:
             var x :: #{?69672}
             var y :: #{?69672}
             var p :: bool
             x != y ==> x == y || p ==> p)
        )
      )
    )
  (
    (
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REWRITE_TAC(PairList [int_coprime, int_congruent, int_divides]) then_tac \
                            REPEAT((STRIP_TAC or_tac EQ_TAC))
                          ) then_tac \
                          REWRITE_TAC(
                            PairList [
                              LEFT_AND_EXISTS_THM,
                              RIGHT_AND_EXISTS_THM,
                              LEFT_OR_EXISTS_THM,
                              RIGHT_OR_EXISTS_THM
                            ]
                          )
                        ) then_tac \
                        CONV_TAC(REPEATC(UNWIND_POLYS_CONV))
                      ) then_tac \
                      REPEAT(FIRST_X_ASSUM(SCRUB_NEQ_TAC))
                    ) then_tac \
                    REWRITE_TAC(
                      PairList [
                        LEFT_AND_EXISTS_THM,
                        RIGHT_AND_EXISTS_THM,
                        LEFT_OR_EXISTS_THM,
                        RIGHT_OR_EXISTS_THM
                      ]
                    )
                  ) then_tac \
                  REPEAT(FIRST_X_ASSUM(o(MP_TAC)(SYM)))
                ) then_tac \
                CONV_TAC(ONCE_DEPTH_CONV(INT_POLYEQ_CONV))
              ) then_tac \
              REWRITE_TAC(
                PairList [
                  GSYM(INT_ENTIRE),
                  TAUT(
                    (hol:
                       var a :: bool
                       var b :: bool
                       var c :: bool
                       a || b && c <=> (a || b) && (a || c))
                  )
                ]
              )
            ) then_tac \
            POP_ASSUM_LIST(K(ALL_TAC))
          ) then_tac \
          REPEAT(DISCH_TAC)
        ) then_tac \
        CONV_TAC(GENVAR_EXISTS_CONV)
      ) then_tac \
      CONV_TAC(ONCE_DEPTH_CONV(INT_POLYEQ_CONV))
    ) then_tac \
    EXISTS_POLY_TAC
  )

fun int_INTEGER_RULE(tm): prove([tm, int_INTEGER_TAC])

def INT_DIVMOD_UNIQ:
  prove(
    [
      (hol:
         const int_abs :: int -> int
         const div :: int -> int -> int
         const rem :: int -> int -> int
         forall (m :: int, n :: int, q :: int, r :: int):
           m == q * n + r && ((0 :: int) <= r && r < int_abs(n)) ==> div(m, n) == q && rem(m, n) == r),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (REPEAT(GEN_TAC) then_tac STRIP_TAC) then_tac \
                          SUBGOAL_THEN(
                            (hol:
                               var n :: int
                               n != (0 :: int))
                          )(MP_TAC)
                        ) then_list \
                        PairList [int_ASM_INT_ARITH_TAC, ALL_TAC]
                      ) then_tac \
                      DISCH_THEN(
                        o(o(STRIP_ASSUME_TAC)(SPEC(hol: var m :: int; m)))(MATCH_MP(INT_DIVISION))
                      )
                    ) then_tac \
                    ASM_CASES_TAC(
                      (hol:
                         var m :: int
                         var n :: int
                         var q :: int
                         const div :: int -> int -> int
                         div(m, n) == q)
                    )
                  ) then_list \
                  PairList [
                    (REPEAT(POP_ASSUM(MP_TAC)) then_tac CONV_TAC(int_INT_RING_v2)),
                    ALL_TAC
                  ]
                ) then_tac \
                SUBGOAL_THEN(
                  (hol:
                     var m :: int
                     var n :: int
                     var r :: int
                     const int_abs :: int -> int
                     const rem :: int -> int -> int
                     int_abs(rem(m, n) - r) < int_abs(n))
                )(MP_TAC)
              ) then_list \
              PairList [
                int_ASM_INT_ARITH_TAC,
                MATCH_MP_TAC(
                  TAUT(hol:
                         var p :: bool
                         var q :: bool
                         !p ==> p ==> q)
                )
              ]
            ) then_tac \
            MATCH_MP_TAC(
              int_INT_ARITH(
                (hol:
                   var n :: int
                   var q :: int
                   var m :: int
                   var r :: int
                   const int_abs :: int -> int
                   const div :: int -> int -> int
                   const rem :: int -> int -> int
                   ((1 :: int) * int_abs(n) <= int_abs(q - div(m, n)) * int_abs(n)
                      && int_abs(rem(m, n) - r) == int_abs((q - div(m, n)) * n))
                     ==> !(int_abs(rem(m, n) - r) < int_abs(n)))
              )
            )
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (MATCH_MP_TAC(INT_LE_RMUL) then_tac int_ASM_INT_ARITH_TAC),
          (
            (AP_TERM_TAC then_tac REPEAT(POP_ASSUM(MP_TAC))) then_tac \
            CONV_TAC(int_INT_RING_v2)
          )
        ]
      )
    ]
  )

def INT_DIV_UNIQ:
  prove(
    [
      (hol:
         const int_abs :: int -> int
         const div :: int -> int -> int
         forall (m :: int, n :: int, q :: int, r :: int):
