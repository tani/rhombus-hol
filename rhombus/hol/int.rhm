def int_integer:«
  Up_pair.new_definition(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"integer\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"real_abs\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]]]]"))
»

def int_is_int:«
  Up_tactics.prove((block:«
    let port_tmp_1 = (block:«
      let port_tmp_2 = Up_calc_rat.REAL_ARITH_TAC;
      let port_tmp_3 = (block:«
        let port_tmp_4 = Up_tactics.ABS_TAC;
        let port_tmp_5 = (block:«
          let port_tmp_6 = Up_tactics.AP_TERM_TAC;
          let port_tmp_7 = Up_simp.REWRITE_TAC(PairList.cons(int_integer,PairList []));
          let port_tmp_8 = Up_tactics.THEN;
          port_tmp_8(port_tmp_7)(port_tmp_6)
        »);
        let port_tmp_9 = Up_tactics.THEN;
        port_tmp_9(port_tmp_5)(port_tmp_4)
      »);
      let port_tmp_10 = Up_tactics.THEN;
      port_tmp_10(port_tmp_3)(port_tmp_2)
    »);
    let port_tmp_11 = Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"integer\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]],[\"Comb\",[\"Const\",\"real_neg\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]]]]]]");
    Pair(port_tmp_11,port_tmp_1)
  »))
»

def int_int_tybij:«
  (block:«
    let port_tmp_12 = Up_tactics.prove((block:«
      let port_tmp_13 = (block:«
        let port_tmp_14 = Up_simp.REWRITE_TAC((block:«
          let port_tmp_15 = (block:«
            let port_tmp_16 = (block:«
              let port_tmp_17 = (block:«
                let port_tmp_18 = PairList [];
                let port_tmp_19 = Up_equal.GSYM(Up_theorems.EXISTS_REFL);
                PairList.cons(port_tmp_19,port_tmp_18)
              »);
              let port_tmp_20 = Up_theorems.EXISTS_OR_THM;
              PairList.cons(port_tmp_20,port_tmp_17)
            »);
            let port_tmp_21 = Up_realax.REAL_OF_NUM_EQ;
            PairList.cons(port_tmp_21,port_tmp_16)
          »);
          let port_tmp_22 = int_is_int;
          PairList.cons(port_tmp_22,port_tmp_15)
        »));
        let port_tmp_23 = Up_tactics.EXISTS_TAC(Host.expand_quote("[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"NUMERAL\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Const\",\"_0\",[\"Tyapp\",\"num\",[]]]]]"));
        let port_tmp_24 = Up_tactics.THEN;
