def DIV_ADD:
  prove(
    [
      (hol:
         const num_divides :: num -> num -> bool
         const DIV :: num -> num -> num
         forall (d :: num, a :: num, b :: num):
           num_divides(d, a) || num_divides(d, b) ==> DIV(a + b, d) == DIV(a, d) + DIV(b, d)),
      (
        (
          (
            (
              (
                REPEAT(GEN_TAC) then_tac \
                ASM_CASES_TAC(
                  (hol:
                     var d :: num
