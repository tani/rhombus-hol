def [int_INT_RING_v2, int_ideal_cofactors]:
  let INT_INTEGRAL_2:
    prove(
      [
        Host.hol_term(And(
          Forall(
            "x",
            Int,
            Eq(
              Int,
              App(
                Const("int_mul", Fun(Int, Fun(Int, Int))),
                [
                  App(
                    Const("int_of_num", Fun(Num, Int)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  ),
                  Ref("x")
                ]
              ),
              App(
                Const("int_of_num", Fun(Num, Int)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              )
            )
          ),
          And(
            Forall(
              "x",
              Int,
              Forall(
                "y",
                Int,
                Forall(
                  "z",
                  Int,
                  Iff(
                    Eq(
                      Int,
                      App(Const("int_add", Fun(Int, Fun(Int, Int))), [Ref("x"), Ref("y")]),
                      App(Const("int_add", Fun(Int, Fun(Int, Int))), [Ref("x"), Ref("z")])
                    ),
                    Eq(Int, Ref("y"), Ref("z"))
                  )
                )
              )
            ),
            Forall(
              "w",
              Int,
              Forall(
                "x",
                Int,
                Forall(
                  "y",
                  Int,
                  Forall(
                    "z",
                    Int,
                    Iff(
                      Eq(
                        Int,
                        App(
                          Const("int_add", Fun(Int, Fun(Int, Int))),
                          [
                            App(Const("int_mul", Fun(Int, Fun(Int, Int))), [Ref("w"), Ref("y")]),
                            App(Const("int_mul", Fun(Int, Fun(Int, Int))), [Ref("x"), Ref("z")])
                          ]
                        ),
                        App(
                          Const("int_add", Fun(Int, Fun(Int, Int))),
                          [
                            App(Const("int_mul", Fun(Int, Fun(Int, Int))), [Ref("w"), Ref("z")]),
                            App(Const("int_mul", Fun(Int, Fun(Int, Int))), [Ref("x"), Ref("y")])
                          ]
                        )
                      ),
                      Or(Eq(Int, Ref("w"), Ref("x")), Eq(Int, Ref("y"), Ref("z")))
                    )
                  )
                )
              )
            )
          )
        )),
        (
          (
            (
              (
                REWRITE_TAC(PairList [MULT_CLAUSES, EQ_ADD_LCANCEL]) then_tac \
                REWRITE_TAC(PairList [GSYM(INT_OF_NUM_EQ), GSYM(INT_OF_NUM_ADD), GSYM(INT_OF_NUM_MUL)])
              ) then_tac \
              ONCE_REWRITE_TAC(PairList [GSYM(INT_SUB_0)])
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(INT_ENTIRE)])
          ) then_tac \
          int_INT_ARITH_TAC
        )
      ]
    )
  let int_ty_3 = Host.hol_term(Int)
  let [pure, ideal]:
    RING_AND_IDEAL_CONV(
      [
        dest_intconst,
        mk_intconst,
        INT_EQ_CONV,
        Host.hol_term(Const("int_neg", Fun(Int, Int))),
        Host.hol_term(Const("int_add", Fun(Int, Fun(Int, Int)))),
        Host.hol_term(Const("int_sub", Fun(Int, Fun(Int, Int)))),
        genvar(bool_ty),
        Host.hol_term(Const("int_mul", Fun(Int, Fun(Int, Int)))),
        genvar(bool_ty),
        Host.hol_term(Const("int_pow", Fun(Int, Fun(Num, Int)))),
        INT_INTEGRAL_2,
        TRUTH,
        INT_POLY_CONV
      ]
    )
  [
    pure,
    fun(tms): fun(tm): (if forall((fun(t): (type_of(t) == int_ty_3)))(PairList [tm, & tms]) | ideal(tms)(tm) | failwith("int_ideal_cofactors: not all terms have type :int"))
  ]

