def CONG:
  prove(
    [
      (hol:
         const #{==} :: A -> A -> (A -> A -> bool) -> bool
         const num_mod :: num -> num -> num -> bool
         const MOD :: num -> num -> num
         forall (x :: num, y :: num, n :: num): const.#{==}(x, y, num_mod(n)) <=> MOD(x, n) == MOD(y, n)),
      REWRITE_TAC(PairList [num_congruent, GSYM(INT_REM_EQ), INT_OF_NUM_REM, INT_OF_NUM_EQ])
    ]
  )

def CONG_LMOD:
  prove(
    [
      (hol:
         const #{==} :: A -> A -> (A -> A -> bool) -> bool
         const MOD :: num -> num -> num
         const num_mod :: num -> num -> num -> bool
         forall (x :: num, y :: num, n :: num):
           const.#{==}(MOD(x, n), y, num_mod(n)) <=> const.#{==}(x, y, num_mod(n))),
      REWRITE_TAC(PairList [CONG, MOD_MOD_REFL])
    ]
  )

def CONG_RMOD:
  prove(
    [
      (hol:
         const #{==} :: A -> A -> (A -> A -> bool) -> bool
         const MOD :: num -> num -> num
         const num_mod :: num -> num -> num -> bool
         forall (x :: num, y :: num, n :: num):
           const.#{==}(x, MOD(y, n), num_mod(n)) <=> const.#{==}(x, y, num_mod(n))),
      REWRITE_TAC(PairList [CONG, MOD_MOD_REFL])
    ]
  )

def CONG_DIV2:
  prove(
    [
      (hol:
         const #{==} :: A -> A -> (A -> A -> bool) -> bool
         const num_mod :: num -> num -> num -> bool
         const DIV :: num -> num -> num
         forall (a :: num, b :: num, m :: num, n :: num):
           const.#{==}(a, b, num_mod(m * n)) ==> const.#{==}(DIV(a, m), DIV(b, m), num_mod(n))),
      SIMP_TAC(PairList [CONG, DIV_MOD])
    ]
  )

def divides:
  prove(
    [
      (hol:
         var a :: num
         var b :: num
         const num_divides :: num -> num -> bool
         num_divides(a, b) <=> (exists x :: num: b == a * x)),
      (
        (
          (
            (
              (
                (
                  (REWRITE_TAC(PairList [num_divides, int_divides]) then_tac EQ_TAC) then_list \
                  PairList [ALL_TAC, MESON_TAC(PairList [INT_OF_NUM_MUL, INT_OF_NUM_EQ])]
                ) then_tac \
                DISCH_THEN(X_CHOOSE_TAC(hol: var x :: int; x))
              ) then_tac \
              EXISTS_TAC(
                (hol:
                   var x :: int
                   const num_of_int :: int -> num
                   const int_abs :: int -> int
                   num_of_int(int_abs(x)))
              )
            ) then_tac \
            SIMP_TAC(
              PairList [
                GSYM(INT_OF_NUM_EQ),
                int_INT_ARITH_v2(
                  (hol:
                     var m :: num
                     var n :: num
                     const int_of_num :: num -> int
                     const int_abs :: int -> int
                     int_of_num(m) == int_of_num(n) <=> int_abs(int_of_num(m)) == int_abs(int_of_num(n)))
                )
              ]
            )
          ) then_tac \
          ASM_REWRITE_TAC(PairList [GSYM(INT_OF_NUM_MUL), INT_ABS_MUL])
        ) then_tac \
        SIMP_TAC(PairList [INT_OF_NUM_OF_INT, INT_ABS_POS, INT_ABS_ABS])
      )
    ]
  )

def DIVIDES_LE:
  prove(
    [
      (hol:
         const num_divides :: num -> num -> bool
         forall (m :: num, n :: num): num_divides(m, n) ==> m <= n || n == (0 :: num)),
      (
        (
          SUBGOAL_THEN(
            (hol:
               forall (m :: num, n :: num): m <= m * n || m * n == (0 :: num))
          )((fun(th): MESON_TAC(PairList [divides, th]))) then_tac \
          REWRITE_TAC(
            PairList [
              LE_MULT_LCANCEL,
              MULT_EQ_0,
              ARITH_RULE(
                (hol:
                   var m :: num
                   var n :: num
                   m <= m * n <=> m * (1 :: num) <= m * n)
              )
            ]
          )
        ) then_tac \
        ASM_ARITH_TAC
      )
    ]
  )

def DIVIDES_LE_STRONG:
  prove(
    [
      (hol:
         const num_divides :: num -> num -> bool
         forall (m :: num, n :: num):
           num_divides(m, n) ==> (1 :: num) <= m && m <= n || n == (0 :: num)),
      (
        (
          (
            (
              REPEAT(GEN_TAC) then_tac \
              ASM_CASES_TAC(
                (hol:
                   var m :: num
                   m == (0 :: num))
              )
            ) then_tac \
            ASM_SIMP_TAC(PairList [DIVIDES_LE, LE_1, LE_0])
          ) then_tac \
          REWRITE_TAC(PairList [divides])
        ) then_tac \
        MESON_TAC(PairList [MULT_CLAUSES])
      )
    ]
  )

def DIVIDES_LE_IMP:
  prove(
    [
      (hol:
         const num_divides :: num -> num -> bool
         forall (m :: num, n :: num):
           num_divides(m, n) && (n == (0 :: num) ==> m == (0 :: num)) ==> m <= n),
      MESON_TAC(PairList [DIVIDES_LE, LE_REFL])
    ]
  )

def PROPERLY_DIVIDES_LE_IMP:
  prove(
    [
      (hol:
         const num_divides :: num -> num -> bool
         forall (m :: num, n :: num):
           num_divides(m, n) && (n != (0 :: num) && m != n) ==> (2 :: num) * m <= n),
      (
        (
          (
            (
              (REPEAT(GEN_TAC) then_tac ONCE_REWRITE_TAC(PairList [MULT_SYM])) then_tac \
              SIMP_TAC(PairList [IMP_CONJ, divides, LEFT_IMP_EXISTS_THM])
            ) then_tac \
            REWRITE_TAC(
              PairList [
                NUM_RING(
                  (hol:
                     var m :: num
                     var d :: num
                     m != m * d <=> m != (0 :: num) && d != (1 :: num))
                )
              ]
            )
          ) then_tac \
          SIMP_TAC(PairList [LE_MULT_LCANCEL, MULT_EQ_0])
        ) then_tac \
        ARITH_TAC
      )
    ]
  )

def DIVIDES_ANTISYM:
  prove(
    [
      (hol:
         const num_divides :: num -> num -> bool
         forall (m :: num, n :: num): num_divides(m, n) && num_divides(n, m) <=> m == n),
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
            PairList [
              ALL_TAC,
              (REWRITE_TAC(PairList [divides]) then_tac MESON_TAC(PairList [MULT_CLAUSES]))
            ]
          ) then_tac \
          DISCH_THEN(CONJUNCTS_THEN(o(MP_TAC)(MATCH_MP(DIVIDES_LE_STRONG))))
        ) then_tac \
        ARITH_TAC
      )
    ]
  )

def DIVIDES_ONE:
  prove(
    [
      (hol:
         const num_divides :: num -> num -> bool
