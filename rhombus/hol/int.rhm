                    [App(Const("*", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")]), Ref("p")]
                  ),
                  App(
                    Const("*", Fun(Num, Fun(Num, Num))),
                    [App(Const("DIV", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("p")]), Ref("n")]
                  )
                )
              )
            )
          )
        ),
        Forall(
          "m",
          Num,
          Forall(
            "n",
            Num,
            Forall(
              "p",
              Num,
              Implies(
                App(Const("num_divides", Fun(Num, Fun(Num, Bool))), [Ref("p"), Ref("n")]),
                Eq(
                  Num,
