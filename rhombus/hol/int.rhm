         const #{==} :: A -> A -> (A -> A -> bool) -> bool
         const int_mod :: int -> int -> int -> bool
         forall (m :: int, n :: int, p :: int):
           rem(m, n) == p
             <=> ((n == (0 :: int) && m == p || (0 :: int) <= p && p < int_abs(n))
                    && const.#{==}(m, p, int_mod(n)))),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          ASM_CASES_TAC(
            (hol:
               var n :: int
               n == (0 :: int))
