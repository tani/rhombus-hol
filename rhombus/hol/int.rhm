  let base_CONV = (TRY_CONV(atom_CONV_3) then_conv bub_CONV_3)
  let NNF_NORM_CONV = GEN_NNF_CONV(#false)([base_CONV, (fun(t): [base_CONV(t), base_CONV(mk_neg(t))])])
  let x_tm_2 = Host.hol_term(Var("x", Int))
  let y_tm_2 = Host.hol_term(Var("y", Int))
