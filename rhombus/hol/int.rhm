            Const("int_lcm", Fun(Tyapp("prod", [Int, Int]), Int)),
            [
              App(
                Const(",", Fun(Int, Fun(Int, Tyapp("prod", [Int, Int])))),
                [
                  App(Const("int_of_num", Fun(Num, Int)), [Var("a", Num)]),
                  App(Const("int_of_num", Fun(Num, Int)), [Var("b", Num)])
                ]
              )
            ]
          )
        ]
      )
    ))
  )

def NUM_TO_INT_CONV:
  let pth_relativize:
    prove(
      [
        Host.hol_term(And(
          Iff(
            Forall(
              "n",
              Num,
              App(Var("P", Fun(Int, Bool)), [App(Const("int_of_num", Fun(Num, Int)), [Ref("n")])])
            ),
            Forall(
              "i",
              Int,
              Or(
                Not(
                  App(
                    Const("int_le", Fun(Int, Fun(Int, Bool))),
                    [
                      App(
                        Const("int_of_num", Fun(Num, Int)),
                        [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                      ),
                      Ref("i")
                    ]
                  )
                ),
                App(Var("P", Fun(Int, Bool)), [Ref("i")])
              )
            )
          ),
          Iff(
            Exists(
              "n",
              Num,
              App(Var("P", Fun(Int, Bool)), [App(Const("int_of_num", Fun(Num, Int)), [Ref("n")])])
            ),
            Exists(
              "i",
              Int,
              And(
                App(
                  Const("int_le", Fun(Int, Fun(Int, Bool))),
                  [
                    App(
                      Const("int_of_num", Fun(Num, Int)),
                      [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                    ),
                    Ref("i")
                  ]
                ),
                App(Var("P", Fun(Int, Bool)), [Ref("i")])
              )
            )
          )
        )),
        (
          REWRITE_TAC(PairList [INT_EXISTS_POS, INT_FORALL_POS]) then_tac \
          MESON_TAC(PairList [])
        )
      ]
    )
  let relation_conv_2:
    o(GEN_REWRITE_CONV(TOP_SWEEP_CONV))(map(GSYM))(
      PairList [
        INT_OF_NUM_EQ,
        INT_OF_NUM_LE,
        INT_OF_NUM_LT,
        INT_OF_NUM_GE,
        INT_OF_NUM_GT,
        INT_OF_NUM_SUC,
        INT_OF_NUM_ADD,
        INT_OF_NUM_MUL,
        INT_OF_NUM_POW
      ]
    )
  let quantifier_conv_2 = GEN_REWRITE_CONV(DEPTH_CONV)(PairList [pth_relativize])
  ((NUM_SIMPLIFY_CONV then_conv relation_conv_2) then_conv quantifier_conv_2)

def ARITH_RULE:
  let init_conv_2:
    (
      (
        (
          (
            NUM_SIMPLIFY_CONV then_conv \
            GEN_REWRITE_CONV(DEPTH_CONV)(PairList [ADD1])
          ) then_conv \
          PROP_ATOM_CONV(BINOP_CONV(NUM_NORMALIZE_CONV))
        ) then_conv \
        PRENEX_CONV
      ) then_conv \
      o(GEN_REWRITE_CONV(TOP_SWEEP_CONV))(map(GSYM))(
        PairList [
          INT_OF_NUM_EQ,
          INT_OF_NUM_LE,
          INT_OF_NUM_LT,
          INT_OF_NUM_GE,
          INT_OF_NUM_GT,
          INT_OF_NUM_ADD,
          SPEC(Host.hol_term(App(Const("NUMERAL", Fun(Num, Num)), [Var("k", Num)])))(INT_OF_NUM_MUL),
          INT_OF_NUM_MAX,
          INT_OF_NUM_MIN
        ]
      )
    )
  let is_numimage_2:
    fun(t):
      match t
      | Comb(Const("int_of_num",_),n):
          if !is_numeral(n)
          | #true
          | match t
            | _: #false
      | _: #false
  fun(tm):
    try:
      let th1 = init_conv_2(tm)
      let tm1 = rand(concl(th1))
      let [avs, bod] = strip_forall(tm1)
      let nim = Host.setify(find_terms(is_numimage_2)(bod))
      let gvs = map(o(genvar)(type_of))(nim)
      let pths = map((fun(v): SPEC(rand(v))(INT_POS)))(nim)
      let ibod = itlist(o(curry(mk_imp))(concl))(pths)(bod)
      let gbod = subst(zip(gvs)(nim))(ibod)
      let th2 = INST(zip(nim)(gvs))(int_INT_ARITH(gbod))
      let th3 = GENL(avs)(rev_itlist(C(MP))(pths)(th2))
      EQ_MP(SYM(th1))(th3)
      ~catch exn:
        match exn
        | Failure(msg):
            failwith(
              ("ARITH_RULE `" +& (Host.string_of_term(tm) +& ("`: " +& msg)))
            )
        | exn: (throw exn)

def ARITH_TAC = CONV_TAC(o(EQT_INTRO)(ARITH_RULE))

def ASM_ARITH_TAC:
  (
    REPEAT(
      FIRST_X_ASSUM(o(MP_TAC)(Host.check(o(o((fun (x): !x))(is_forall))(concl))))
    ) then_tac \
    ARITH_TAC
  )

def int_INT_ARITH_v2:
  let pth:
