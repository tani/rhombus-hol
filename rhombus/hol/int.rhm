def INT_DIVIDES_LE:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Int,
        Forall(
          "y",
          Int,
          Implies(
            App(Const("int_divides", Fun(Int, Fun(Int, Bool))), [Ref("x"), Ref("y")]),
            Or(
              App(
                Const("int_le", Fun(Int, Fun(Int, Bool))),
                [
                  App(Const("int_abs", Fun(Int, Int)), [Ref("x")]),
                  App(Const("int_abs", Fun(Int, Int)), [Ref("y")])
                ]
              ),
              Eq(
                Int,
                Ref("y"),
                App(
                  Const("int_of_num", Fun(Num, Int)),
                  [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                SIMP_TAC(PairList [int_divides, LEFT_IMP_EXISTS_THM, INT_ABS_MUL, INT_ENTIRE]) then_tac \
                REWRITE_TAC(
                  PairList [
                    TAUT(
                      Host.hol_term(Iff(
                        Or(Var("p", Bool), Or(Var("q", Bool), Var("r", Bool))),
