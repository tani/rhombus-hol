def integer:
  new_definition(
    Host.hol_term(Iff(
      App(Var("integer", Fun(Real, Bool)), [Var("x", Real)]),
      Exists(
        "n",
        Num,
        Eq(
          Real,
          App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)]),
          App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])
        )
      )
    ))
  )

def is_int:
  prove(
    [
      Host.hol_term(Iff(
        App(Const("integer", Fun(Real, Bool)), [Var("x", Real)]),
        Exists(
          "n",
          Num,
          Or(
            Eq(Real, Var("x", Real), App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])),
            Eq(
              Real,
              Var("x", Real),
              App(Const("real_neg", Fun(Real, Real)), [App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])])
            )
          )
        )
      )),
      (
        ((REWRITE_TAC(PairList [integer]) then_tac AP_TERM_TAC) then_tac ABS_TAC) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def int_tybij:
  new_type_definition("int")(["int_of_real", "real_of_int"])(
    prove(
      [
        Host.hol_term(Exists("x", Real, App(Const("integer", Fun(Real, Bool)), [Ref("x")]))),
        (
          EXISTS_TAC(
            Host.hol_term(App(
              Const("real_of_num", Fun(Num, Real)),
              [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
            ))
          ) then_tac \
          REWRITE_TAC(
            PairList [
              is_int,
              REAL_OF_NUM_EQ,
              EXISTS_OR_THM,
              GSYM(EXISTS_REFL)
            ]
          )
        )
      ]
    )
  )

def [int_int_abstr_v2, int_rep] = [SPEC_ALL(CONJUNCT1(int_tybij)), SPEC_ALL(CONJUNCT2(int_tybij))]

def dest_int_rep:
  prove(
    [
      Host.hol_term(Forall(
        "i",
        Int,
        Exists(
          "n",
          Num,
          Or(
            Eq(
              Real,
              App(Const("real_of_int", Fun(Int, Real)), [Ref("i")]),
              App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])
            ),
            Eq(
              Real,
              App(Const("real_of_int", Fun(Int, Real)), [Ref("i")]),
              App(Const("real_neg", Fun(Real, Real)), [App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])])
            )
          )
        )
      )),
      REWRITE_TAC(PairList [GSYM(is_int), int_rep, int_int_abstr_v2])
    ]
  )

def INTEGER_REAL_OF_INT:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Int,
        App(Const("integer", Fun(Real, Bool)), [App(Const("real_of_int", Fun(Int, Real)), [Ref("x")])])
      )),
      MESON_TAC(PairList [int_tybij])
    ]
  )

def int_eq:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Int,
        Forall(
          "y",
          Int,
          Iff(
            Eq(Int, Ref("x"), Ref("y")),
            Eq(
              Real,
              App(Const("real_of_int", Fun(Int, Real)), [Ref("x")]),
              App(Const("real_of_int", Fun(Int, Real)), [Ref("y")])
            )
          )
        )
      )),
      (
        (
          (
            ((REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac DISCH_TAC) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          POP_ASSUM(o(MP_TAC)(AP_TERM(Host.hol_term(Const("int_of_real", Fun(Real, Int))))))
        ) then_tac \
        REWRITE_TAC(PairList [int_int_abstr_v2])
      )
    ]
  )

def initialization_1:
  Host.do_list(TypeInference.overload_interface)(
    PairList [
      ["+", Host.hol_term(Var("int_add", Fun(Int, Fun(Int, Int))))],
      ["-", Host.hol_term(Var("int_sub", Fun(Int, Fun(Int, Int))))],
      ["*", Host.hol_term(Var("int_mul", Fun(Int, Fun(Int, Int))))],
      ["<", Host.hol_term(Var("int_lt", Fun(Int, Fun(Int, Bool))))],
      ["<=", Host.hol_term(Var("int_le", Fun(Int, Fun(Int, Bool))))],
      [">", Host.hol_term(Var("int_gt", Fun(Int, Fun(Int, Bool))))],
      [">=", Host.hol_term(Var("int_ge", Fun(Int, Fun(Int, Bool))))],
      ["--", Host.hol_term(Var("int_neg", Fun(Int, Int)))],
      ["pow", Host.hol_term(Var("int_pow", Fun(Int, Fun(Num, Int))))],
      ["abs", Host.hol_term(Var("int_abs", Fun(Int, Int)))],
      ["max", Host.hol_term(Var("int_max", Fun(Int, Fun(Int, Int))))],
      ["min", Host.hol_term(Var("int_min", Fun(Int, Fun(Int, Int))))],
      ["&", Host.hol_term(Var("int_of_num", Fun(Num, Int)))]
    ]
  )

fun prioritize_int(_): TypeInference.prioritize_overload(mk_type(["int", PairList []]))

