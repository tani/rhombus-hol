                ) then_tac \
                STRIP_TAC
              ) then_tac \
              FIRST_X_ASSUM(o(MP_TAC)(MATCH_MP(DIVIDES_LE_STRONG)))
            ) then_tac \
            ONCE_REWRITE_TAC(
              PairList [
                ARITH_RULE(
                  Host.hol_term(Iff(
                    App(
                      Const("<=", Fun(Num, Fun(Num, Bool))),
                      [App(Const("*", Fun(Num, Fun(Num, Num))), [Var("a", Num), Var("b", Num)]), Var("a", Num)]
                    ),
                    App(
                      Const("<=", Fun(Num, Fun(Num, Bool))),
                      [
                        App(Const("*", Fun(Num, Fun(Num, Num))), [Var("a", Num), Var("b", Num)]),
                        App(
