def int_INTEGER_TAC:
  let int_ty = Host.hol_term(Tyapp("int", []))
  let INT_POLYEQ_CONV = Equal.THENC(Simp.GEN_REWRITE_CONV(I)(PairList.cons(Equal.GSYM(INT_SUB_0), PairList [])))(Equal.LAND_CONV(INT_POLY_CONV))
  let pth = int_INT_ARITH(Host.hol_term(Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyapp("int", []), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("a", Tyapp("int", [])), Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyapp("int", []), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("x", Tyapp("int", [])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("int", []), Tyapp("fun", [Tyapp("int", []), Tyapp("bool", [])])])), Var("a", Tyapp("int", []))), Comb(Const("int_of_num", Tyapp("fun", [Tyapp("num", []), Tyapp("int", [])])), Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Const("_0", Tyapp("num", [])))))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("int", []), Tyapp("fun", [Tyapp("int", []), Tyapp("bool", [])])])), Var("x", Tyapp("int", []))), Comb(Comb(Const("int_add", Tyapp("fun", [Tyapp("int", []), Tyapp("fun", [Tyapp("int", []), Tyapp("int", [])])])), Var("x", Tyapp("int", []))), Var("a", Tyapp("int", [])))))))))))
  let is_defined:
    fun(v):
      fun(t):
        let mons = striplist(Basics.dest_binary("int_add"))(t)
        (mem(v)(mons) && forall((fun(m): (Host.hol_equal(v)(m) || Host.hol_not(Basics.free_in(v)(m)))))(mons))
  let ISOLATE_VARIABLE:
    fun(vars):
      fun(tm):
        let th_2 = INT_POLYEQ_CONV(tm)
        let th_prime_2 = Equal.THENC(Equal.SYM_CONV)(INT_POLYEQ_CONV)(tm)
        let [v, th1]:
          try:
            [find((fun(v): is_defined(v)(Equal.lhand(Fusion.rand(Fusion.concl(th_2))))))(vars), th_prime_2]
            ~catch exn:
              match exn
              | Failure(_): [find((fun(v): is_defined(v)(Equal.lhand(Fusion.rand(Fusion.concl(th_prime_2))))))(vars), th_2]
              | exn: Host.hol_raise(exn)
        let th2 = Fusion.TRANS(th1)(Bool.SPECL(PairList.cons(Equal.lhs(Fusion.rand(Fusion.concl(th1))), PairList.cons(v, PairList [])))(pth))
        Equal.CONV_RULE(Equal.RAND_CONV(Equal.RAND_CONV(INT_POLY_CONV)))(th2)
  let UNWIND_POLYS_CONV:
    fun(tm):
      let [vars, bod] = Basics.strip_exists(tm)
      let cjs = Basics.conjuncts(bod)
      let th1 = tryfind(ISOLATE_VARIABLE(vars))(cjs)
      let eq = Equal.lhand(Fusion.concl(th1))
      let bod_prime = Bool.list_mk_conj(PairList.cons(eq, subtract(cjs)(PairList.cons(eq, PairList []))))
      let th2 = Canon.CONJ_ACI_RULE(Fusion.mk_eq([bod, bod_prime]))
      let th3 = Fusion.TRANS(th2)(Drule.MK_CONJ(th1)(Fusion.REFL(Fusion.rand(Fusion.rand(Fusion.concl(th2))))))
      let v = Equal.lhs(Equal.lhand(Fusion.rand(Fusion.concl(th3))))
      let vars_prime = append(subtract(vars)(PairList.cons(v, PairList [])))(PairList.cons(v, PairList []))
      let th4 = Equal.CONV_RULE(Equal.RAND_CONV(Simp.REWR_CONV(Theorems.UNWIND_THM2)))(Drule.MK_EXISTS(v)(th3))
      let IMP_RULE = (fun(v): (fun(v_prime): Bool.DISCH_ALL(itlist(Bool.SIMPLE_CHOOSE)(v)(itlist(Bool.SIMPLE_EXISTS)(v_prime)(Fusion.ASSUME(bod))))))
      let th5 = Bool.IMP_ANTISYM_RULE(IMP_RULE(vars)(vars_prime))(IMP_RULE(vars_prime)(vars))
      Fusion.TRANS(th5)(itlist(Drule.MK_EXISTS)(subtract(vars)(PairList.cons(v, PairList [])))(th4))
  let zero_tm_2 = Host.hol_term(Comb(Const("int_of_num", Tyapp("fun", [Tyapp("num", []), Tyapp("int", [])])), Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Const("_0", Tyapp("num", [])))))
  let one_tm_2 = Host.hol_term(Comb(Const("int_of_num", Tyapp("fun", [Tyapp("num", []), Tyapp("int", [])])), Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Comb(Const("BIT1", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Const("_0", Tyapp("num", []))))))
  let mul_tm_2 = Host.hol_term(Const("int_mul", Tyapp("fun", [Tyapp("int", []), Tyapp("fun", [Tyapp("int", []), Tyapp("int", [])])])))
  let add_tm_2 = Host.hol_term(Const("int_add", Tyapp("fun", [Tyapp("int", []), Tyapp("fun", [Tyapp("int", []), Tyapp("int", [])])])))
  let neg_tm_3 = Host.hol_term(Const("int_neg", Tyapp("fun", [Tyapp("int", []), Tyapp("int", [])])))
  let dest_mul_2 = Basics.dest_binop(mul_tm_2)
  let dest_add_2 = Basics.dest_binop(add_tm_2)
  let mk_mul_2 = Basics.mk_binop(mul_tm_2)
  let mk_add_2 = Basics.mk_binop(add_tm_2)
  let scrub_var:
    fun(v):
      fun(m):
        let ps = striplist(dest_mul_2)(m)
        let ps_prime = subtract(ps)(PairList.cons(v, PairList []))
        (if Host.hol_equal(ps_prime)(PairList []) | one_tm_2 | end_itlist(mk_mul_2)(ps_prime))
  let find_multipliers:
    fun(v):
      fun(mons):
        let mons1 = filter((fun(m): Basics.free_in(v)(m)))(mons)
        let mons2 = map(scrub_var(v))(mons1)
        (if Host.hol_equal(mons2)(PairList []) | zero_tm_2 | end_itlist(mk_add_2)(mons2))
  let isolate_monomials:
    fun(vars):
      fun(tm):
        let [cmons, vmons] = partition((fun(m): Host.hol_equal(Host.intersect(Fusion.frees(m))(vars))(PairList [])))(striplist(dest_add_2)(tm))
        let cofactors_2 = map((fun(v): find_multipliers(v)(vmons)))(vars)
        let cnc_2 = (if Host.hol_equal(cmons)(PairList []) | zero_tm_2 | Fusion.mk_comb([neg_tm_3, end_itlist(mk_add_2)(cmons)]))
        [cofactors_2, cnc_2]
  let isolate_variables:
    fun(evs):
      fun(ps):
        fun(eq):
          let vars = filter((fun(v): Fusion.vfree_in(v)(eq)))(evs)
          let [qs, p] = isolate_monomials(vars)(eq)
          let rs = filter((fun(t): Host.hol_equal(Fusion.type_of(t))(int_ty)))(append(qs)(ps))
          let rs = int_ideal_cofactors(rs)(p)
          [eq, zip(fst(Host.chop_list(length(qs))(rs)))(vars)]
  let subst_in_poly = (fun(i): (fun(p): Equal.rhs(Fusion.concl(INT_POLY_CONV(Fusion.vsubst(i)(p))))))
  fun solve_idealism(evs):
    fun(ps):
      fun(eqs):
