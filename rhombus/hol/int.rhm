def REAL_OF_INT_CLAUSES:
  prove(
    [
      (hol:
         const real_of_int :: int -> real
         const real_max :: real -> real -> real
         const int_max :: int -> int -> int
         const real_min :: real -> real -> real
         const int_min :: int -> int -> int
         const real_of_num :: num -> real
         const int_of_num :: num -> int
         const real_abs :: real -> real
         const int_abs :: int -> int
         const real_sgn :: real -> real
         const int_sgn :: int -> int
         const real_pow :: real -> num -> real
         const int_pow :: int -> num -> int
         (forall (x :: int, y :: int): real_of_int(x) == real_of_int(y) <=> x == y)
           && ((forall (x :: int, y :: int): real_of_int(x) >= real_of_int(y) <=> x >= y)
                 && ((forall (x :: int, y :: int): real_of_int(x) > real_of_int(y) <=> x > y)
                       && ((forall (x :: int, y :: int): real_of_int(x) <= real_of_int(y) <=> x <= y)
                             && ((forall (x :: int, y :: int): real_of_int(x) < real_of_int(y) <=> x < y)
                                   && ((forall (x :: int, y :: int):
                                          real_max(real_of_int(x), real_of_int(y))
                                            == real_of_int(int_max(x, y)))
                                         && ((forall (x :: int, y :: int):
                                                real_min(real_of_int(x), real_of_int(y))
                                                  == real_of_int(int_min(x, y)))
                                               && ((forall n :: num:
                                                      real_of_num(n) == real_of_int(int_of_num(n)))
                                                     && ((forall x :: int: -real_of_int(x) == real_of_int(-x))
                                                           && ((forall x :: int:
                                                                  real_abs(real_of_int(x))
                                                                    == real_of_int(int_abs(x)))
                                                                 && ((forall (x :: int, y :: int):
                                                                        real_max(
                                                                          real_of_int(x),
                                                                          real_of_int(y)
                                                                        )
                                                                          == real_of_int(int_max(x, y)))
                                                                       && ((forall (x :: int, y :: int):
                                                                              real_min(
                                                                                real_of_int(x),
                                                                                real_of_int(y)
                                                                              )
                                                                                == real_of_int(int_min(x, y)))
                                                                             && ((forall x :: int:
                                                                                    real_sgn(real_of_int(x))
                                                                                      == real_of_int(int_sgn(x)))
                                                                                   && ((forall (x :: int, y :: int):
                                                                                          (real_of_int(x)
                                                                                             + real_of_int(y))
                                                                                            == real_of_int(x + y))
                                                                                         && ((forall (x :: int, y :: int):
                                                                                                (real_of_int(x)
                                                                                                   - real_of_int(y))
                                                                                                  == real_of_int(
                                                                                                       x - y
                                                                                                     ))
                                                                                               && ((forall (x :: int, y :: int):
                                                                                                      (real_of_int(
                                                                                                         x
                                                                                                       )
                                                                                                         * real_of_int(
                                                                                                             y
                                                                                                           ))
                                                                                                        == real_of_int(
                                                                                                             x * y
                                                                                                           ))
                                                                                                     && (forall (x :: int, n :: num):
                                                                                                           real_pow(
                                                                                                             real_of_int(
                                                                                                               x
                                                                                                             ),
                                                                                                             n
                                                                                                           )
                                                                                                             == real_of_int(
                                                                                                                  int_pow(
                                                                                                                    x,
                                                                                                                    n
                                                                                                                  )
                                                                                                                )))))))))))))))))),
      REWRITE_TAC(
        PairList [
          int_eq,
          int_ge,
          int_gt,
          int_le,
          int_lt,
          int_max_th,
          int_min_th,
          int_of_num_th,
          int_neg_th,
          int_abs_th,
          int_max_th,
          int_min_th,
          int_sgn_th,
          int_add_th,
          int_sub_th,
          int_mul_th,
          int_pow_th
        ]
      )
    ]
  )

def INT_IMAGE:
  prove(
    [
      (hol:
         const int_of_num :: num -> int
         forall x :: int:
           (exists n :: num: x == int_of_num(n)) || (exists n :: num: x == -int_of_num(n))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        GEN_TAC then_tac \
                        X_CHOOSE_THEN(hol: var n :: num; n)(DISJ_CASES_TAC)(SPEC(hol: var x :: int; x)(dest_int_rep))
                      ) then_tac \
                      POP_ASSUM(o(MP_TAC)(AP_TERM(hol: const int_of_real :: real -> int; int_of_real)))
                    ) then_tac \
                    REWRITE_TAC(PairList [int_int_abstr_v2])
                  ) then_tac \
                  DISCH_THEN(SUBST1_TAC)
                ) then_tac \
                REWRITE_TAC(PairList [int_of_num, int_neg])
              ) then_list \
              PairList [DISJ1_TAC, DISJ2_TAC]
            ) then_tac \
            EXISTS_TAC(hol: var n :: num; n)
          ) then_tac \
          REWRITE_TAC(PairList [int_int_abstr_v2])
        ) then_tac \
        REWRITE_TAC(PairList [GSYM(int_of_num), int_of_num_th])
      )
    ]
  )

def FORALL_INT_CASES:
  prove(
    [
      (hol:
         const int_of_num :: num -> int
         forall P :: int -> bool:
           (forall x :: int: P(x))
             <=> (forall n :: num: P(int_of_num(n))) && (forall n :: num: P(-int_of_num(n)))),
      MESON_TAC(PairList [INT_IMAGE])
    ]
  )

def EXISTS_INT_CASES:
  prove(
    [
      (hol:
         const int_of_num :: num -> int
         forall P :: int -> bool:
           (exists x :: int: P(x))
             <=> (exists n :: num: P(int_of_num(n))) || (exists n :: num: P(-int_of_num(n)))),
      MESON_TAC(PairList [INT_IMAGE])
    ]
  )

def INT_LT_DISCRETE:
  prove(
    [
      (hol:
         forall (x :: int, y :: int): x < y <=> x + (1 :: int) <= y),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [int_le, int_lt, int_add_th])) then_tac \
                              DISJ_CASES_THEN(X_CHOOSE_THEN(hol: var m :: num; m)(SUBST1_TAC))(SPEC(hol: var x :: int; x)(INT_IMAGE))
                            ) then_tac \
                            DISJ_CASES_THEN(X_CHOOSE_THEN(hol: var n :: num; n)(SUBST1_TAC))(SPEC(hol: var y :: int; y)(INT_IMAGE))
                          ) then_tac \
                          REWRITE_TAC(PairList [int_neg_th, int_of_num_th])
                        ) then_tac \
                        REWRITE_TAC(PairList [REAL_LE_NEG2, REAL_LT_NEG2])
                      ) then_tac \
                      REWRITE_TAC(PairList [REAL_LE_LNEG, REAL_LT_LNEG, REAL_LE_RNEG, REAL_LT_RNEG])
                    ) then_tac \
                    REWRITE_TAC(PairList [GSYM(REAL_ADD_ASSOC)])
                  ) then_tac \
                  ONCE_REWRITE_TAC(PairList [REAL_ADD_SYM])
                ) then_tac \
                REWRITE_TAC(PairList [GSYM(real_sub), REAL_LE_SUB_RADD])
              ) then_tac \
              REWRITE_TAC(PairList [REAL_OF_NUM_LE, REAL_OF_NUM_LT, REAL_OF_NUM_ADD])
            ) then_tac \
            REWRITE_TAC(
              PairList [
                GSYM(ADD1),
                ONCE_REWRITE_RULE(PairList [ADD_SYM])(GSYM(ADD1))
              ]
            )
          ) then_tac \
          REWRITE_TAC(
            PairList [
              SYM(
                REWRITE_CONV(PairList [ARITH_SUC])(
                  (hol:
                     const SUC :: num -> num
                     SUC((0 :: num)))
                )
              )
            ]
          )
        ) then_tac \
        REWRITE_TAC(PairList [ADD_CLAUSES, LE_SUC_LT, LT_SUC_LE])
      )
    ]
  )

def INT_GT_DISCRETE:
  prove(
    [
      (hol:
         forall (x :: int, y :: int): x > y <=> x >= y + (1 :: int)),
      (
        REWRITE_TAC(
          PairList [
            int_gt,
            int_ge,
            real_ge,
            real_gt,
            GSYM(int_le),
            GSYM(int_lt)
          ]
        ) then_tac \
        MATCH_ACCEPT_TAC(INT_LT_DISCRETE)
      )
    ]
  )

fun is_intconst(tm):
  match tm
  | Comb(Const("int_of_num",_),n): is_numeral(n)
  | Comb(Const("int_neg",_),Comb(Const("int_of_num",_),n)): (is_numeral(n) && !(dest_numeral(n) == num_0))
  | _: #false

fun dest_intconst(tm):
  match tm
  | Comb(Const("int_of_num",_),n): dest_numeral(n)
  | Comb(Const("int_neg",_),Comb(Const("int_of_num",_),n)):
      let nn = dest_numeral(n)
      (if (nn != num_0) | minus_num(dest_numeral(n)) | failwith("dest_intconst"))
  | _: failwith("dest_intconst")

def mk_intconst:
  let cast_tm_2 = hol: const int_of_num :: num -> int; int_of_num
  let neg_tm_2 = hol: const int_neg :: int -> int; int_neg
  let mk_numconst = (fun(n): mk_comb([cast_tm_2, mk_numeral(n)]))
  (fun(x): (if (x < num_0) | mk_comb([neg_tm_2, mk_numconst(minus_num(x))]) | mk_numconst(x)))

def INT_OF_REAL_THM:
  let dest_2 = hol: const real_of_int :: int -> real; real_of_int
  let real_ty_2 = hol_type: real
  let int_ty_2 = hol_type: int
  let cond_th_2:
    prove(
      [
        (hol:
           var b :: bool
           var x :: int
           var y :: int
           const real_of_int :: int -> real
           real_of_int(if b | x | y) == (if b | real_of_int(x) | real_of_int(y))),
        (COND_CASES_TAC then_tac REWRITE_TAC(PairList []))
      ]
    )
  let thlist:
    map(GSYM)(
      PairList [
        int_eq,
        int_le,
        int_lt,
        int_ge,
        int_gt,
        int_of_num_th,
        int_neg_th,
        int_add_th,
        int_mul_th,
        int_sgn_th,
        int_sub_th,
        int_abs_th,
        int_max_th,
        int_min_th,
        int_pow_th,
        cond_th_2
      ]
    )
  let REW_RULE = GEN_REWRITE_RULE(DEPTH_CONV)(thlist)
  let int_tm_of_real_var:
    fun(v):
      let [s, ty] = dest_var(v)
      (if (ty == real_ty_2) | mk_comb([dest_2, mk_var([s, int_ty_2])]) | v)
  let int_of_real_var:
    fun(v):
      let [s, ty] = dest_var(v)
      (if (ty == real_ty_2) | mk_var([s, int_ty_2]) | v)
  let INT_OF_REAL_THM1:
    fun(th):
      let newavs = subtract(frees(concl(th)))(freesl(hyp(th)))
      let [avs, bod] = strip_forall(concl(th))
      let allavs = append(newavs)(avs)
      let avs_prime = map(int_tm_of_real_var)(allavs)
      let avs_prime_prime = map(int_of_real_var)(avs)
      GENL(avs_prime_prime)(REW_RULE(SPECL(avs_prime)(GENL(newavs)(th))))
  fun INT_OF_REAL_THM(th): (if is_conj(concl(th)) | CONJ(INT_OF_REAL_THM(CONJUNCT1(th)))(INT_OF_REAL_THM(CONJUNCT2(th))) | INT_OF_REAL_THM1(th))
  INT_OF_REAL_THM

