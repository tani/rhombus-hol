              )
            ) then_tac \
            EQ_TAC
          ) then_list \
          PairList [ALL_TAC, CONV_TAC(NUMBER_RULE)]
        ) then_tac \
        ASM_MESON_TAC(
          PairList [
            prime,
            coprime,
            NUMBER_RULE(
              Host.hol_term(Forall(
                "d",
                Num,
                Forall(
                  "a",
                  Num,
                  Forall(
                    "b",
                    Num,
                    Implies(
                      And(
                        App(
                          Const("num_divides", Fun(Num, Fun(Num, Bool))),
                          [Ref("d"), App(Const("*", Fun(Num, Fun(Num, Num))), [Ref("a"), Ref("b")])]
                        ),
                        App(
                          Const("num_coprime", Fun(Tyapp("prod", [Num, Num]), Bool)),
                          [App(Const(",", Fun(Num, Fun(Num, Tyapp("prod", [Num, Num])))), [Ref("d"), Ref("a")])]
                        )
                      ),
                      App(Const("num_divides", Fun(Num, Fun(Num, Bool))), [Ref("d"), Ref("b")])
                    )
                  )
                )
              ))
            )
          ]
        )
      )
    ]
  )

def ZERO_ONE_OR_PRIME:
  prove(
    [
      Host.hol_term(Forall(
        "p",
        Num,
        Iff(
          Or(
            Eq(Num, Ref("p"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])),
