def int_INTEGER_TAC_v2:
  let gcd_tm = Host.hol_term(Const("int_gcd", Tyapp("fun", [Tyapp("prod", [Tyapp("int", []), Tyapp("int", [])]), Tyapp("int", [])])))
  let dest_gcd:
    fun(tm):
      let [l, r] = Fusion.dest_comb(tm)
      (if Host.hol_equal(l)(gcd_tm) | HolPair.dest_pair(r) | failwith("dest_gcd"))
  let GCD_ELIM_TAC:
    Tactics.THEN(Tactics.REPEAT(Tactics.GEN_TAC))(
      W(
        fun([asl, w]):
          let gts = Basics.find_terms(can(dest_gcd))(w)
          let ths:
            map(
              fun(tm):
                let [a_2, b] = dest_gcd(tm)
                Bool.SPECL(PairList.cons(a_2, PairList.cons(b, PairList [])))(int_gcd))(gts)
