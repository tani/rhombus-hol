def INT_REM_DOWN_CONV:
  let addmul_conv_2:
    GEN_REWRITE_CONV(I)(
      PairList [
        GSYM(INT_NEG_REM),
        GSYM(INT_ADD_REM),
        GSYM(INT_SUB_REM),
        GSYM(INT_MUL_REM),
        GSYM(INT_POW_REM)
      ]
    )
  let mod_conv_2 = GEN_REWRITE_CONV(I)(PairList [INT_REM_REM])
  fun downconv_2(tm):
    (
      ((addmul_conv_2 then_conv LAND_CONV(downconv_2)) or_conv (mod_conv_2 then_conv downconv_2)) or_conv \
      SUB_CONV(downconv_2)
    )(tm)
  let upconv_2:
    GEN_REWRITE_CONV(
      DEPTH_CONV)(
      PairList [INT_NEG_REM, INT_ADD_REM, INT_SUB_REM, INT_MUL_REM, INT_POW_REM, INT_REM_REM]
    )
  (downconv_2 then_conv upconv_2)

def INT_POW_REM_CONV:
  let [pth_0, pth_1]:
    o(CONJ_PAIR)(prove)(
      [
        (hol:
           var m :: num
           var k :: num
           var n :: num
           const rem :: int -> int -> int
           const int_pow :: int -> num -> int
           const int_of_num :: num -> int
           const MOD :: num -> num -> num
           const EXP :: num -> num -> num
           const EVEN :: num -> bool
           rem(int_pow(int_of_num(m), k), int_of_num(n)) == int_of_num(MOD(EXP(m, k), n))
             && rem(int_pow(int_of_num(m), k), -int_of_num(n)) == int_of_num(MOD(EXP(m, k), n))
             && ((rem(int_pow(-int_of_num(m), k), int_of_num(n))
                    == (if EVEN(k)
                        | int_of_num(MOD(EXP(m, k), n))
                        | rem(-int_of_num(MOD(EXP(m, k), n)), int_of_num(n))))
                   && (rem(int_pow(-int_of_num(m), k), -int_of_num(n))
                         == (if EVEN(k)
                             | int_of_num(MOD(EXP(m, k), n))
                             | rem(-int_of_num(MOD(EXP(m, k), n)), int_of_num(n)))))),
        (
          (
            (
              (REWRITE_TAC(PairList [INT_REM_RNEG, INT_POW_NEG]) then_tac COND_CASES_TAC) then_tac \
              ASM_REWRITE_TAC(PairList [GSYM(INT_OF_NUM_CLAUSES), GSYM(INT_OF_NUM_REM)])
            ) then_tac \
            CONV_TAC(INT_REM_DOWN_CONV)
          ) then_tac \
          REFL_TAC
        )
      ]
    )
  let conv:
    (
      (GEN_REWRITE_CONV(I)(PairList [pth_0]) then_conv RAND_CONV(EXP_MOD_CONV)) or_conv \
      (
        (
          (
            GEN_REWRITE_CONV(I)(PairList [pth_1]) then_conv \
            RATOR_CONV(LAND_CONV(NUM_EVEN_CONV))
          ) then_conv \
          GEN_REWRITE_CONV(I)(PairList [COND_CLAUSES])
        ) then_conv \
        (
          RAND_CONV(EXP_MOD_CONV) or_conv \
          (
            LAND_CONV(
              RAND_CONV((RAND_CONV(EXP_MOD_CONV) then_conv TRY_CONV(INT_NEG_CONV)))
            ) then_conv \
            INT_REM_CONV
          )
        )
      )
    )
  fun(tm):
    match tm
    | Comb(Comb(Const("rem",_),Comb(Comb(Const("int_pow",_),m),k)),n):
        if (is_intconst(m) && (is_numeral(k) && is_intconst(n)))
        | conv(tm)
        | match tm
          | _: failwith("INT_POW_REM_CONV")
    | _: failwith("INT_POW_REM_CONV")

def WF_INT_MEASURE:
  prove(
    [
      (hol:
         forall (P :: A -> bool, m :: A -> int):
           ((forall x :: A: (0 :: int) <= m(x))
              && (forall x :: A: (forall y :: A: m(y) < m(x) ==> P(y)) ==> P(x)))
             ==> (forall x :: A: P(x))),
      (
        (
          (
            (
              REPEAT(STRIP_TAC) then_tac \
              SUBGOAL_THEN(
                (hol:
                   var m :: A -> int
                   var P :: A -> bool
                   const int_of_num :: num -> int
                   forall (n :: num, x :: A): m(x) == int_of_num(n) ==> P(x))
              )(MP_TAC)
            ) then_list \
            PairList [MATCH_MP_TAC(num_WF), ALL_TAC]
          ) then_tac \
          REWRITE_TAC(PairList [GSYM(INT_OF_NUM_LT), INT_FORALL_POS])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def WF_INT_MEASURE_2:
  prove(
    [
      (hol:
         forall (P :: A -> B -> bool, m :: A -> B -> int):
           ((forall (x :: A, y :: B): (0 :: int) <= m(x, y))
              && (forall (x :: A, y :: B):
                    (forall (x_prime :: A, y_prime :: B):
                       m(x_prime, y_prime) < m(x, y) ==> P(x_prime, y_prime))
                      ==> P(x, y)))
             ==> (forall (x :: A, y :: B): P(x, y))),
      REWRITE_TAC(PairList [FORALL_UNCURRY, GSYM(FORALL_PAIR_THM), WF_INT_MEASURE])
    ]
  )

def INT_GCD_EXISTS:
  let INT_GCD_EXISTS_CASES:
    int_INT_ARITH(
      (hol:
         var a :: int
         var b :: int
         const int_abs :: int -> int
         a == (0 :: int)
           || b == (0 :: int)
           || (int_abs(a - b) + int_abs(b) < int_abs(a) + int_abs(b)
                 || (int_abs(a + b) + int_abs(b) < int_abs(a) + int_abs(b)
                       || (int_abs(a) + int_abs(b - a) < int_abs(a) + int_abs(b)
                             || int_abs(a) + int_abs(b + a) < int_abs(a) + int_abs(b)))))
    )
  prove(
    [
      (hol:
         const int_divides :: int -> int -> bool
         forall (a :: int, b :: int):
           exists d :: int:
             int_divides(d, a)
               && (int_divides(d, b) && (exists (x :: int, y :: int): d == a * x + b * y))),
      (
        (
          (
            (
              (
                (
                  MATCH_MP_TAC(WF_INT_MEASURE_2) then_tac \
                  EXISTS_TAC(
                    (hol:
                       const int_abs :: int -> int
                       fun (x :: int, y :: int): int_abs(x) + int_abs(y))
                  )
                ) then_tac \
                REWRITE_TAC(PairList [])
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_list \
            PairList [int_INT_ARITH_TAC, ALL_TAC]
          ) then_tac \
          DISJ_CASES_THEN(MP_TAC)(INT_GCD_EXISTS_CASES)
        ) then_list \
        PairList [
          (
            (
              (
                STRIP_TAC then_tac \
                ASM_REWRITE_TAC(
                  PairList [
                    int_INTEGER_RULE(
                      (hol:
                         var d :: int
                         const int_divides :: int -> int -> bool
                         int_divides(d, (0 :: int)))
                    )
                  ]
                )
              ) then_tac \
              REWRITE_TAC(PairList [INT_MUL_LZERO, INT_ADD_LID, INT_ADD_RID])
            ) then_tac \
            MESON_TAC(
              PairList [
                int_INTEGER_RULE(
                  (hol:
                     var d :: int
                     const int_divides :: int -> int -> bool
                     int_divides(d, d))
                ),
                INT_MUL_RID
              ]
            )
          ),
          (
            (
              DISCH_THEN(REPEAT_TCL(DISJ_CASES_THEN)(ANTE_RES_THEN(MP_TAC))) then_tac \
              MATCH_MP_TAC(MONO_EXISTS)
            ) then_tac \
            int_INTEGER_TAC
          )
        ]
      )
    ]
  )

def INT_GCD_EXISTS_POS:
  prove(
    [
      (hol:
         const int_divides :: int -> int -> bool
         forall (a :: int, b :: int):
           exists d :: int:
             (0 :: int) <= d
               && (int_divides(d, a)
                     && (int_divides(d, b) && (exists (x :: int, y :: int): d == a * x + b * y)))),
      (
        (
          (
            REPEAT(GEN_TAC) then_tac \
            X_CHOOSE_TAC(hol: var d :: int; d)(
              SPECL(PairList [(hol: var a :: int; a), (hol: var b :: int; b)])(INT_GCD_EXISTS)
            )
          ) then_tac \
          DISJ_CASES_TAC(SPEC(hol: var d :: int; d)(INT_LE_NEGTOTAL))
        ) then_tac \
        ASM_MESON_TAC(
          PairList [
            int_INTEGER_RULE(
              (hol:
                 var d :: int
                 var x :: int
                 const int_divides :: int -> int -> bool
                 int_divides(-d, x) <=> int_divides(d, x))
            ),
            int_INT_ARITH(
              (hol:
                 var a :: int
                 var x :: int
                 var b :: int
                 var y :: int
                 a * (-x) + b * (-y) == -(a * x + b * y))
            )
          ]
        )
      )
    ]
  )

TypeInference.overload_interface(["gcd", (hol: var int_gcd :: pair(int, int) -> int; int_gcd)])

TypeInference.overload_interface(["lcm", (hol: var int_lcm :: pair(int, int) -> int; int_lcm)])

def int_gcd = new_specification(PairList ["int_gcd"])(REWRITE_RULE(PairList [EXISTS_UNCURRY, SKOLEM_THM])(INT_GCD_EXISTS_POS))

def int_lcm:
  new_definition(
    (hol:
       var int_lcm :: pair(int, int) -> int
       var m :: int
       var n :: int
       const #{|,|} :: A -> B -> pair(A, B)
       const div :: int -> int -> int
       const int_abs :: int -> int
       const int_gcd :: pair(int, int) -> int
       int_lcm(const.#{|,|}(m, n))
         == (if m * n == (0 :: int) | (0 :: int) | div(int_abs(m * n), int_gcd(const.#{|,|}(m, n)))))
  )

