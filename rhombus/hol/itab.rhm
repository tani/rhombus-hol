import: "private/compat.rhm" open
import: "fusion.rhm" open
import: "basics.rhm" open
import: "equal.rhm" open
import: "bool.rhm" open
import: "drule.rhm" open
import: "tactics.rhm" open

export:
  UNIFY_ACCEPT_TAC
  UNIFY_REFL_TAC
  ITAUT_TAC
  ITAUT

fun UNIFY_ACCEPT_TAC(mvs):
  fun(th):
    fun([_asl, w]):
      let insts = term_unify(mvs)(concl(th))(w)
      let th1 = INSTANTIATE(insts)(th)
      [[PairList [], insts],PairList [], fun(i): fun(PairList []): INSTANTIATE(i)(th1)]

fun UNIFY_REFL_TAC([asl, w] as g):
  let [wl, wr] = dest_eq(w)
  if is_var(wr)
  | if vfree_in(wr)(wl)
    | failwith("UNIFY_REFL_TAC: occurs check")
    | UNIFY_ACCEPT_TAC(PairList [wr])(REFL(wl))(g)
  | let [constr, rargs] = strip_comb(wr)
    if !is_var(constr)
    | failwith("UNIFY_REFL_TAC: not variable")
    | if vfree_in(constr)(wl)
      | failwith("UNIFY_REFL_TAC: occurs check")
      | let rargs_vars = map(fun(v): if is_var(v) | v | genvar(type_of(v)))(rargs)
        let f = list_mk_abs([rargs_vars, wl])
        let the_goal = mk_eq([wl, list_mk_comb([f, rargs])])
        let th = prove([the_goal, THEN(CONV_TAC(RAND_CONV(DEPTH_CONV(BETA_CONV))))(REFL_TAC)])
        UNIFY_ACCEPT_TAC(PairList [constr])(th)(g)

fun CONJUNCTS_THEN_PRIME(ttac):
  fun(cth): THEN(ttac(CONJUNCT1(cth)))(ttac(CONJUNCT2(cth)))
fun IMPLICATE(t):
  let th1 = AP_THM(NOT_DEF)(dest_neg(t))
  CONV_RULE(RAND_CONV(BETA_CONV))(th1)

def RIGHT_REVERSIBLE_TAC = FIRST(PairList [CONJ_TAC,GEN_TAC,DISCH_TAC,EQ_TAC])

fun LEFT_REVERSIBLE_TAC(th):
  fun(gl):
    tryfind(
      fun(ttac): ttac(th)(gl)
    )(PairList [
      CONJUNCTS_THEN_PRIME(ASSUME_TAC),
      DISJ_CASES_TAC,
      CHOOSE_TAC,
      fun(x): ASSUME_TAC(EQ_MP(IMPLICATE(concl(x)))(x)),
      fun(x):
        let [a, b] = EQ_IMP_RULE(x)
        CONJUNCTS_THEN_PRIME(MP_TAC)(CONJ(a)(b))
    ])

fun ITAUT_CORE(mvs):
  fun(n):
    fun(gl):
      if n <= 0
      | failwith("ITAUT_TAC: Too deep")
      | ORELSE(
          FIRST_ASSUM(UNIFY_ACCEPT_TAC(mvs)))(
        ORELSE(
          ACCEPT_TAC(TRUTH))(
        ORELSE(
          FIRST_ASSUM(CONTR_TAC))(
        ORELSE(
          THEN(RIGHT_REVERSIBLE_TAC)(TRY(ITAUT_CORE(mvs)(n))))(
        ORELSE(
          THEN(FIRST_X_ASSUM(LEFT_REVERSIBLE_TAC))(TRY(ITAUT_CORE(mvs)(n))))(
        ORELSE(
          FIRST_X_ASSUM(
            fun(th):
              THEN(ASSUME_TAC(th))(
                fun(g):
                  let gv = genvar(type_of(fst(dest_forall(concl(th)))))
                  THEN(META_SPEC_TAC(gv)(th))(
                    THEN(ITAUT_CORE(PairList.cons(gv,mvs))(n-2))(NO_TAC))(g))))(
        ORELSE(
          THEN(DISJ1_TAC)(THEN(ITAUT_CORE(mvs)(n))(NO_TAC)))(
        ORELSE(
          THEN(DISJ2_TAC)(THEN(ITAUT_CORE(mvs)(n))(NO_TAC)))(
        ORELSE(
          fun([_, w] as g):
            let gv = genvar(type_of(fst(dest_exists(w))))
            THEN(X_META_EXISTS_TAC(gv))(
              THEN(ITAUT_CORE(PairList.cons(gv,mvs))(n-2))(NO_TAC))(g))(
          FIRST_ASSUM(
            fun(th):
              let ant = fst(dest_imp(concl(th)))
              THEN(SUBGOAL_THEN(ant)(fun(ath): ASSUME_TAC(MP(th)(ath))))(
                THEN(ITAUT_CORE(mvs)(n-1))(NO_TAC))))))))))))(gl)

fun ITAUT_ITERDEEP_TAC(n):
  fun(gl):
    ORELSE(THEN(ITAUT_CORE(PairList [])(n))(NO_TAC))(
      ITAUT_ITERDEEP_TAC(n+1))(gl)

def ITAUT_TAC = ITAUT_ITERDEEP_TAC(0)
fun ITAUT(tm): prove([tm, ITAUT_TAC])
