import:
  "lib.rhm" open
  "private/ocaml.rhm" open
  "fusion.rhm" open
  "basics.rhm" open
  "equal.rhm" open
  "bool.rhm" open
  "drule.rhm" open
  "tactics.rhm" open
  "private/theory_support.rhm" open:
    only:
      string_of_term

export:
  UNIFY_ACCEPT_TAC
  UNIFY_REFL_TAC
  ITAUT_TAC
  ITAUT

// -------------------------------------------------------------------------
// Accept a theorem modulo unification.
// -------------------------------------------------------------------------

fun UNIFY_ACCEPT_TAC(mvs):
  fun(th):
    fun([asl, w]):
      let insts = term_unify(mvs)(concl(th))(w)
      [[PairList [], insts], PairList [],
       block:
         let th_prime = INSTANTIATE(insts)(th)
         fun(i): fun(PairList []): INSTANTIATE(i)(th_prime)]

// REFL version of UNIFY_ACCEPT_TAC.
// The conclusion ust be `expr = x` where x is a meta variable.
// It can be `expr = f x y z` where f is a meta variable as well.
// (string_of_term is the port's diagnostic stub, not HOL Light's printer.)
fun UNIFY_REFL_TAC([asl, w]):
  let [w_lhs, w_rhs] = dest_eq(w)
  if is_var(w_rhs)
  | if vfree_in(w_rhs)(w_lhs)
    | failwith("UNIFY_REFL_TAC: failed: `" +& string_of_term(w) +& "`")
    | UNIFY_ACCEPT_TAC(PairList [w_rhs])(REFL(w_lhs))([asl, w])
  | let [constr, rargs] = strip_comb(w_rhs)
    if !is_var(constr)
    | failwith("UNIFY_REFL_TAC: not variable")
    | if vfree_in(constr)(w_lhs)
      | failwith("UNIFY_REFL_TAC: failed: `" +& string_of_term(w) +& "`")
      | // replace non-variable arguments of the RHS function with temporary
        // variables.
        let rargs_vars:
          map(fun(v):
                if is_var(v)
                | v
                | print("UNIFY_REFL_TAC: warning: this isn't var: " +& string_of_term(v) +& "\n")
                  genvar(type_of(v)))(rargs)
        let f = list_mk_abs([rargs_vars, w_lhs])
        let the_goal = mk_eq([w_lhs, list_mk_comb([f, rargs])])
        let th:
          prove([the_goal,
                 CONV_TAC(RAND_CONV(DEPTH_CONV(BETA_CONV))) then_tac \
                 REFL_TAC])
        UNIFY_ACCEPT_TAC(PairList [constr])(th)([asl, w])

// -------------------------------------------------------------------------
// The actual prover, as a tactic.
// -------------------------------------------------------------------------

def ITAUT_TAC:
  let CONJUNCTS_THEN_prime:
    fun(ttac):
      fun(cth):
        ttac(CONJUNCT1(cth)) then_tac ttac(CONJUNCT2(cth))
  let IMPLICATE:
    fun(t):
      let th1 = AP_THM(NOT_DEF)(dest_neg(t))
      CONV_RULE(RAND_CONV(BETA_CONV))(th1)
  let RIGHT_REVERSIBLE_TAC:
    FIRST(PairList [CONJ_TAC,           // and
                    GEN_TAC,            // forall
                    DISCH_TAC,          // implies; not
                    EQ_TAC])            // iff
  let LEFT_REVERSIBLE_TAC:
    fun(th):
      fun(gl):
        tryfind(fun(ttac): ttac(th)(gl))(
          PairList [CONJUNCTS_THEN_prime(ASSUME_TAC),                          // and
                    DISJ_CASES_TAC,                                           // or
                    CHOOSE_TAC,                                               // exists
                    fun(th): ASSUME_TAC(EQ_MP(IMPLICATE(concl(th)))(th)),     // not
                    o(o(CONJUNCTS_THEN_prime(MP_TAC))(uncurry(CONJ)))(EQ_IMP_RULE)]) // iff
  fun ITAUT_TAC(mvs):
    fun(n):
      fun(gl):
        if n <= 0
        | failwith("ITAUT_TAC: Too deep")
        | ((FIRST_ASSUM(UNIFY_ACCEPT_TAC(mvs))) or_tac \
             (ACCEPT_TAC(TRUTH)) or_tac \
             (FIRST_ASSUM(CONTR_TAC)) or_tac \
             (RIGHT_REVERSIBLE_TAC then_tac TRY(ITAUT_TAC(mvs)(n))) or_tac \
             (FIRST_X_ASSUM(LEFT_REVERSIBLE_TAC) then_tac TRY(ITAUT_TAC(mvs)(n))) or_tac \
             (FIRST_X_ASSUM(fun(th):
                              ASSUME_TAC(th) then_tac \
                                (block:
                                   let gv = genvar(type_of(fst(dest_forall(concl(th)))))
                                   META_SPEC_TAC(gv)(th) then_tac \
                                     ITAUT_TAC(PairList.cons(gv, mvs))(n - 2) then_tac NO_TAC))) or_tac \
             (DISJ1_TAC then_tac ITAUT_TAC(mvs)(n) then_tac NO_TAC) or_tac \
             (DISJ2_TAC then_tac ITAUT_TAC(mvs)(n) then_tac NO_TAC) or_tac \
             (fun(gl):
                let gv = genvar(type_of(fst(dest_exists(snd(gl)))))
                (X_META_EXISTS_TAC(gv) then_tac \
                   ITAUT_TAC(PairList.cons(gv, mvs))(n - 2) then_tac NO_TAC)(gl)) or_tac \
             (FIRST_ASSUM(fun(th):
                            SUBGOAL_THEN(fst(dest_imp(concl(th))))(
                              fun(ath): ASSUME_TAC(MP(th)(ath))) then_tac \
                              ITAUT_TAC(mvs)(n - 1) then_tac NO_TAC)))(gl)
  fun ITAUT_ITERDEEP_TAC(n):
    fun(gl):
      remark("Searching with limit " +& string_of_int(n))
      ((ITAUT_TAC(PairList [])(n) then_tac NO_TAC) or_tac ITAUT_ITERDEEP_TAC(n + 1))(gl)
  ITAUT_ITERDEEP_TAC(0)

// -------------------------------------------------------------------------
// Alternative interface.
// -------------------------------------------------------------------------

fun ITAUT(tm): prove([tm, ITAUT_TAC])
