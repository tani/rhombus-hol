                        DISCH_THEN((fun(th): (STRIP_TAC then_tac MP_TAC(th))))
                      ) then_tac \
                      ONCE_REWRITE_TAC(PairList [IMP_CONJ])
                    ) then_tac \
                    ASM_SIMP_TAC(PairList [NSUM_CLAUSES])
                  ) then_tac \
                  ANTS_TAC
                ) then_list \
                PairList [
                  ASM_MESON_TAC(PairList []),
                  DISCH_THEN(o(SUBST_ALL_TAC)(SYM))
                ]
              ) then_tac \
              STRIP_TAC
            ) then_tac \
            MATCH_MP_TAC(NSUM_UNION_NONZERO)
          ) then_tac \
          ASM_SIMP_TAC(PairList [FINITE_UNIONS, IN_INTER, IN_UNIONS])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

