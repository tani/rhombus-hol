                SET_TAC(PairList [])
              ),
              ALL_TAC
            ]
          ) then_tac \
          ASM_SIMP_TAC(PairList [NSUM_CLAUSES, FINITE_DELETE, IN_DELETE])
        ) then_tac \
        ASM_SIMP_TAC(PairList [LTE_ADD2, NSUM_LE, IN_DELETE, FINITE_DELETE])
      )
    ]
  )

