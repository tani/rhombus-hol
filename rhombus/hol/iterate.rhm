              ),
              SET_RULE(
                (hol:
                   var s :: #{?115998} -> bool
                   var #{|s'|} :: #{?115998} -> bool
                   const DISJOINT :: (A -> bool) -> (A -> bool) -> bool
                   const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                   const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
