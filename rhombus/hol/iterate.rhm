def FINITE_INDEX_NUMSEG:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const #{..} :: num -> num -> num -> bool
         const CARD :: (A -> bool) -> num
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         forall s :: A -> bool:
           FINITE(s)
             <=> (exists f :: num -> A:
                    (forall (i :: num, j :: num):
                       (IN(i, #{..}((1 :: num), CARD(s)))
                          && (IN(j, #{..}((1 :: num), CARD(s))) && f(i) == f(j)))
                         ==> i == j)
                      && s == IMAGE(f, #{..}((1 :: num), CARD(s))))),
      (
        (
          (
            (
              (
                (GEN_TAC then_tac EQ_TAC) then_list \
                PairList [DISCH_TAC, MESON_TAC(PairList [FINITE_IMAGE, FINITE_NUMSEG])]
              ) then_tac \
              MP_TAC(
                ISPECL(
                  PairList [
                    (hol:
                       var s :: A -> bool
                       const #{..} :: num -> num -> num -> bool
                       const CARD :: (A -> bool) -> num
                       #{..}((1 :: num), CARD(s))),
                    (hol: var s :: A -> bool; s)
                  ])(
                  CARD_EQ_BIJECTIONS
                )
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [FINITE_NUMSEG, CARD_NUMSEG_1])
          ) then_tac \
          MATCH_MP_TAC(MONO_EXISTS)
        ) then_tac \
        SET_TAC(PairList [])
      )
    ]
  )

