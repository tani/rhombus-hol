        ) then_tac \
        ASM_ARITH_TAC
      )
    ]
  )

def iterato:
  o(new_specification(PairList ["iterato"]))(prove)(
    [
      Host.hol_term(Exists(
        "itty",
        Fun(
          Fun(Tvar("A"), Bool),
          Fun(
            Tvar("A"),
            Fun(
              Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))),
              Fun(
                Fun(Tvar("K"), Fun(Tvar("K"), Bool)),
                Fun(Fun(Tvar("K"), Bool), Fun(Fun(Tvar("K"), Tvar("A")), Tvar("A")))
              )
            )
          )
        ),
        Forall(
          "dom",
          Fun(Tvar("A"), Bool),
          Forall(
            "neut",
            Tvar("A"),
            Forall(
              "op",
              Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))),
              Forall(
                "<<=",
                Fun(Tvar("K"), Fun(Tvar("K"), Bool)),
                Forall(
                  "k",
                  Fun(Tvar("K"), Bool),
                  Forall(
                    "f",
                    Fun(Tvar("K"), Tvar("A")),
                    Eq(
                      Tvar("A"),
