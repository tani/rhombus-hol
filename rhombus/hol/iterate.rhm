      let port_tmp_3 = Simp.REWRITE_TAC(PairList.cons(Sets.FINITE_NUMSEG_LE,PairList []));
      let port_tmp_4 = (block:«
        let port_tmp_5 = Tactics.EXISTS_TAC(Host.expand_quote("[\"Comb\",[\"Const\",\"GSPEC\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Abs\",[\"Var\",\"GEN%PVAR%232\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Comb\",[\"Const\",\"SETSPEC\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]]]]]]],[\"Var\",\"GEN%PVAR%232\",[\"Tyapp\",\"num\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"<=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"num\",[]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]],[\"Var\",\"x\",[\"Tyapp\",\"num\",[]]]]]]]]"));
        let port_tmp_6 = (block:«
          let port_tmp_7 = Tactics.MATCH_MP_TAC(Sets.FINITE_SUBSET);
          let port_tmp_8 = Tactics.REPEAT(Tactics.GEN_TAC);
          Tactics.THEN(port_tmp_8)(port_tmp_7)
        »);
