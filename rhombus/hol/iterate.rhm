def NUMSEG_CONV:
  let pth_0_2:
    MESON(
      PairList [NUMSEG_EMPTY])(
      Host.hol_term(Implies(
        App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("n", Num), Var("m", Num)]),
        Eq(
          Fun(Num, Bool),
          App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Var("m", Num), Var("n", Num)]),
          Const("EMPTY", Fun(Num, Bool))
        )
      ))
    )
  let pth_1_2:
    MESON(
      PairList [NUMSEG_SING])(
      Host.hol_term(Eq(
        Fun(Num, Bool),
        App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Var("m", Num), Var("m", Num)]),
        App(
          Const("INSERT", Fun(Num, Fun(Fun(Num, Bool), Fun(Num, Bool)))),
          [Var("m", Num), Const("EMPTY", Fun(Num, Bool))]
        )
      ))
    )
  let pth_2_2:
    MESON(
      PairList [NUMSEG_LREC, ADD1])(
      Host.hol_term(Implies(
        App(Const("<=", Fun(Num, Fun(Num, Bool))), [Var("m", Num), Var("n", Num)]),
        Eq(
          Fun(Num, Bool),
          App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Var("m", Num), Var("n", Num)]),
          App(
            Const("INSERT", Fun(Num, Fun(Fun(Num, Bool), Fun(Num, Bool)))),
            [
              Var("m", Num),
              App(
                Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                [App(Const("SUC", Fun(Num, Num)), [Var("m", Num)]), Var("n", Num)]
              )
            ]
          )
        )
      ))
    )
  let ns_tm_2 = Host.hol_term(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))))
  let m_tm_2 = Host.hol_term(Var("m", Num))
  let n_tm_2 = Host.hol_term(Var("n", Num))
  fun NUMSEG_CONV(tm):
    let [nstm, nt] = dest_comb(tm)
    let [nst, mt] = dest_comb(nstm)
    if (nst != ns_tm_2)
    | failwith("NUMSEG_CONV")
    | let m_2 = dest_numeral(mt)
      let n_2 = dest_numeral(nt)
      if (n_2 < m_2)
      | MP_CONV(NUM_LT_CONV)(INST(PairList [[mt, m_tm_2], [nt, n_tm_2]])(pth_0_2))
      | if (n_2 == m_2)
        | INST(PairList [[mt, m_tm_2]])(pth_1_2)
        | let th = MP_CONV(NUM_LE_CONV)(INST(PairList [[mt, m_tm_2], [nt, n_tm_2]])(pth_2_2))
          CONV_RULE(Host.funpow(2)(RAND_CONV)((LAND_CONV(NUM_SUC_CONV) then_conv NUMSEG_CONV)))(th)
  NUMSEG_CONV

