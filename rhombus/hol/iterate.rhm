                      And(
                        App(
                          Const("IN", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Fun(Tvar("A"), Bool), Bool), Bool))),
                          [Ref("u"), Ref("s")]
                        ),
                        Not(Eq(Fun(Tvar("A"), Bool), Ref("t"), Ref("u")))
                      )
                    ),
                    Eq(
                      Fun(Tvar("A"), Bool),
                      App(
                        Const("INTER", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                        [Ref("t"), Ref("u")]
                      ),
                      Const("EMPTY", Fun(Tvar("A"), Bool))
                    )
                  )
                )
              )
            )
          ),
          Eq(
            Num,
            App(
              Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)),
              [App(Const("UNIONS", Fun(Fun(Fun(Tvar("A"), Bool), Bool), Fun(Tvar("A"), Bool))), [Ref("s")])]
            ),
            App(
              Const("nsum", Fun(Fun(Fun(Tvar("A"), Bool), Bool), Fun(Fun(Fun(Tvar("A"), Bool), Num), Num))),
              [Ref("s"), Const("CARD", Fun(Fun(Tvar("A"), Bool), Num))]
            )
          )
        )
      )),
      (
        MP_TAC(ISPEC(Host.hol_term(Lambda("x", Fun(Tvar("A"), Bool), Ref("x"))))(CARD_UNIONS_IMAGE)) then_tac \
        REWRITE_TAC(PairList [IMAGE_ID, ETA_AX])
      )
    ]
  )

def EXPAND_NSUM_CONV:
  let PairList [pth_0_3, & PairList [pth_1_3, & PairList [pth_2_3, & PairList []]]]:
    o(CONJUNCTS)(prove)(
      [
        Host.hol_term(And(
          Implies(
            App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("n", Num), Var("m", Num)]),
            Eq(
              Num,
              App(
                Const("nsum", Fun(Fun(Num, Bool), Fun(Fun(Num, Num), Num))),
                [
                  App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Var("m", Num), Var("n", Num)]),
                  Var("f", Fun(Num, Num))
                ]
              ),
              App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])
            )
          ),
          And(
            Eq(
              Num,
              App(
                Const("nsum", Fun(Fun(Num, Bool), Fun(Fun(Num, Num), Num))),
                [
                  App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Var("m", Num), Var("m", Num)]),
                  Var("f", Fun(Num, Num))
                ]
              ),
              App(Var("f", Fun(Num, Num)), [Var("m", Num)])
            ),
            Implies(
              App(Const("<=", Fun(Num, Fun(Num, Bool))), [Var("m", Num), Var("n", Num)]),
              Eq(
                Num,
                App(
                  Const("nsum", Fun(Fun(Num, Bool), Fun(Fun(Num, Num), Num))),
                  [
                    App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Var("m", Num), Var("n", Num)]),
                    Var("f", Fun(Num, Num))
                  ]
                ),
                App(
                  Const("+", Fun(Num, Fun(Num, Num))),
                  [
                    App(Var("f", Fun(Num, Num)), [Var("m", Num)]),
                    App(
                      Const("nsum", Fun(Fun(Num, Bool), Fun(Fun(Num, Num), Num))),
                      [
                        App(
                          Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                          [
                            App(
                              Const("+", Fun(Num, Fun(Num, Num))),
                              [
                                Var("m", Num),
                                App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                              ]
                            ),
                            Var("n", Num)
                          ]
                        ),
                        Var("f", Fun(Num, Num))
                      ]
                    )
                  ]
                )
              )
            )
          )
        )),
        REWRITE_TAC(PairList [NSUM_CLAUSES_LEFT, NSUM_SING_NUMSEG, NSUM_TRIV_NUMSEG])
      ]
    )
  let ns_tm_3 = Host.hol_term(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))))
  let f_tm_2 = Host.hol_term(Var("f", Fun(Num, Num)))
  let m_tm_3 = Host.hol_term(Var("m", Num))
  let n_tm_3 = Host.hol_term(Var("n", Num))
  fun conv(tm):
    let [smn, ftm] = dest_comb(tm)
    let [s, mn] = dest_comb(smn)
    if !(is_const(s) && (fst(dest_const(s)) == "nsum"))
    | failwith("EXPAND_NSUM_CONV")
    | let [mtm, ntm] = dest_binop(ns_tm_3)(mn)
      let m_3 = dest_numeral(mtm)
      let n_3 = dest_numeral(ntm)
      if (n_3 < m_3)
      | let th1 = INST(PairList [[ftm, f_tm_2], [mtm, m_tm_3], [ntm, n_tm_3]])(pth_0_3)
        MP(th1)(EQT_ELIM(NUM_LT_CONV(lhand(concl(th1)))))
      | if (n_3 == m_3)
        | CONV_RULE(RAND_CONV(TRY_CONV(BETA_CONV)))(INST(PairList [[ftm, f_tm_2], [mtm, m_tm_3]])(pth_1_3))
        | let th1 = INST(PairList [[ftm, f_tm_2], [mtm, m_tm_3], [ntm, n_tm_3]])(pth_2_3)
          let th2 = MP(th1)(EQT_ELIM(NUM_LE_CONV(lhand(concl(th1)))))
          CONV_RULE(
            RAND_CONV(
              COMB2_CONV(RAND_CONV(TRY_CONV(BETA_CONV)))((LAND_CONV(LAND_CONV(NUM_ADD_CONV)) then_conv conv))
            )
          )(th2)
  conv

Host.hol_apply_unit(prioritize_real)

