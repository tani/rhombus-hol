                ) then_tac \
                UNDISCH_TAC(
                  (hol:
                     var f :: A -> num
                     var s :: A -> bool
                     const FINITE :: (A -> bool) -> bool
                     const support :: (B -> B -> B) -> (A -> B) -> (A -> bool) -> A -> bool
                     const #{+} :: num -> num -> num
