                                    [Ref("GEN%PVAR%342"), App(Ref("p"), [Ref("y")]), Ref("y")]
                                  )
                                )
                              )
                            ]
                          ),
                          Lambda("i", Tvar("?132910"), App(Ref("f"), [Ref("i")]))
                        ]
                      ),
                      App(
                        Const("sum", Fun(Fun(Tvar("?132910"), Bool), Fun(Fun(Tvar("?132910"), Real), Real))),
                        [
                          App(
                            Const("GSPEC", Fun(Fun(Tvar("?132910"), Bool), Fun(Tvar("?132910"), Bool))),
                            [
                              Lambda(
                                "GEN%PVAR%343",
                                Tvar("?132910"),
                                Exists(
                                  "y",
                                  Tvar("?132910"),
                                  App(
                                    Const("SETSPEC", Fun(Tvar("?132910"), Fun(Bool, Fun(Tvar("?132910"), Bool)))),
                                    [Ref("GEN%PVAR%343"), App(Ref("p"), [Ref("y")]), Ref("y")]
                                  )
                                )
                              )
                            ]
                          ),
                          Ref("g")
