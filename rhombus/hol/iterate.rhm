                              PairList [
                                (hol:
                                   var t :: B -> bool
                                   var R :: A -> B -> bool
                                   const #{@} :: (A -> bool) -> A
                                   const IN :: A -> (A -> bool) -> bool
                                   fun (x :: A): #{@}(fun (y :: B): IN(y, t) && R(x, y))),
                                (hol: var g :: A -> real; g),
                                (hol: var s :: A -> bool; s),
