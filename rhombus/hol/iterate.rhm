    [
      (hol:
         const sum :: (A -> bool) -> (A -> real) -> real
         const #{..} :: num -> num -> num -> bool
         forall (f :: num -> real, g :: num -> real, m :: num, n :: num):
           sum(#{..}(m, n), fun (k :: num): f(k) * (g(k + (1 :: num)) - g(k)))
             == (if m <= n
                 | f(n + (1 :: num)) * g(n + (1 :: num))
                     - f(m) * g(m)
                     - sum(#{..}(m, n), fun (k :: num): g(k + (1 :: num)) * (f(k + (1 :: num)) - f(k)))
                 | (0 :: real))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (((GEN_TAC then_tac GEN_TAC) then_tac GEN_TAC) then_tac INDUCT_TAC) then_tac \
                        COND_CASES_TAC
                      ) then_tac \
                      ASM_SIMP_TAC(PairList [SUM_TRIV_NUMSEG, GSYM(NOT_LE)])
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [SUM_CLAUSES_NUMSEG])
                  ) then_list \
                  PairList [
                    (
                      (COND_CASES_TAC then_tac ASM_SIMP_TAC(PairList [])) then_list \
                      PairList [REAL_ARITH_TAC, ASM_ARITH_TAC]
                    ),
                    ALL_TAC
