          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (GEN_TAC then_tac ONCE_REWRITE_TAC(PairList [IMP_CONJ])) then_tac \
                              MATCH_MP_TAC(FINITE_INDUCT_STRONG)
                            ) then_tac \
                            REWRITE_TAC(PairList [UNIONS_0, UNIONS_INSERT, NSUM_CLAUSES, IN_INSERT])
                          ) then_tac \
                          MAP_EVERY(X_GEN_TAC)(
                            PairList [
                              (hol: var t :: A -> bool; t),
                              (hol: var s :: (A -> bool) -> bool; s)
                            ]
                          )
