def ITERATO_CLAUSES_NUMSEG_LEFT:
  prove(
    [
      (hol:
         const iterato :: (A -> bool) -> A -> (A -> A -> A) -> (K -> K -> bool) -> (K -> bool) -> (K -> A) -> A
         const #{<=} :: num -> num -> bool
         const #{..} :: num -> num -> num -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (dom :: A -> bool, neut :: A, op :: A -> A -> A, f :: num -> A, m :: num, n :: num):
           iterato(dom, neut, op, const.#{<=}, #{..}(m, n), f)
             == (if m <= n
                 | if IN(f(m), dom) ==> f(m) == neut
                   | iterato(dom, neut, op, const.#{<=}, #{..}(m + (1 :: num), n), f)
                   | op(f(m), iterato(dom, neut, op, const.#{<=}, #{..}(m + (1 :: num), n), f))
                 | neut)),
      (
        (
          (
            (
              (
                (
                  REPEAT(GEN_TAC) then_tac \
                  MP_TAC(
                    ISPECL(
                      PairList [
                        (hol: var dom :: A -> bool; dom),
                        (hol: var neut :: A; neut),
                        (hol: var op :: A -> A -> A; op),
                        (hol: const #{<=} :: num -> num -> bool; const.#{<=}),
                        (hol: var f :: num -> A; f)
                      ])(
                      ITERATO_CLAUSES_GEN
                    )
                  )
                ) then_tac \
                COND_CASES_TAC
              ) then_list \
              PairList [
                DISCH_THEN((fun(th): (ASM_SIMP_TAC(PairList [GSYM(NUMSEG_LREC)]) then_tac MP_TAC(th)))),
                (
                  DISCH_THEN(o(MP_TAC)(CONJUNCT1)) then_tac \
                  ASM_MESON_TAC(PairList [NUMSEG_EMPTY, NOT_LE])
                )
              ]
            ) then_tac \
            DISCH_THEN(
              o(
                o(MP_TAC)(
                  SPECL(
                    PairList [
                      (hol: var m :: num; m),
                      (hol:
                         var m :: num
                         var n :: num
                         const #{..} :: num -> num -> num -> bool
                         #{..}(m + (1 :: num), n))
                    ]
                  )
                )
              )(CONJUNCT2)
            )
          ) then_tac \
          ANTS_TAC
        ) then_list \
        PairList [
          (
            SIMP_TAC(PairList [FINITE_RESTRICT, FINITE_NUMSEG, IN_NUMSEG]) then_tac \
            ARITH_TAC
          ),
          REWRITE_TAC(
            PairList [
              IN_NUMSEG,
              ARITH_RULE(
                (hol:
                   var m :: num
                   !(m + (1 :: num) <= m))
              )
            ]
          )
        ]
      )
    ]
  )

