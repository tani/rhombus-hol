                   const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
                   const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                   const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
                   DISJOINT(UNION(DIFF(s, #{|s'|}), DIFF(#{|s'|}, s)), INTER(s, #{|s'|})))
              ),
              SET_RULE(
                (hol:
                   var s :: #{?116008} -> bool
                   var #{|s'|} :: #{?116008} -> bool
                   const DISJOINT :: (A -> bool) -> (A -> bool) -> bool
                   const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
