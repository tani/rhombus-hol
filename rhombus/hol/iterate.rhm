                ) then_tac \
                FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [LE])))
              ) then_tac \
              DISCH_THEN(DISJ_CASES_THEN2(SUBST_ALL_TAC)(ASSUME_TAC))
            ) then_tac \
            ASM_SIMP_TAC(
              PairList [
                GSYM(NOT_LT),
                SUM_TRIV_NUMSEG,
                ARITH_RULE(
                  (hol:
                     var n :: num
                     const SUC :: num -> num
                     n < SUC(n))
