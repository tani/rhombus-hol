def NSUM_IMAGE_NONZERO:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const nsum :: (A -> bool) -> (A -> num) -> num
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const o :: (B -> C) -> (A -> B) -> A -> C
         forall (d :: B -> num, i :: A -> B, s :: A -> bool):
           (FINITE(s)
              && (forall (x :: A, y :: A):
                    IN(x, s) && (IN(y, s) && (x != y && i(x) == i(y))) ==> d(i(x)) == (0 :: num)))
             ==> nsum(IMAGE(i, s), d) == nsum(s, o(d, i))),
