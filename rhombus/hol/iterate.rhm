        Implies(
          App(Const("monoidal", Fun(Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))), Bool)), [Ref("op")]),
          And(
            Forall(
              "m",
              Num,
              Eq(
                Tvar("A"),
                App(
                  Const(
                    "iterate",
                    Fun(
                      Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))),
                      Fun(Fun(Num, Bool), Fun(Fun(Num, Tvar("A")), Tvar("A")))
                    )
                  ),
                  [
                    Ref("op"),
                    App(
                      Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                      [Ref("m"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                    ),
                    Var("f", Fun(Num, Tvar("A")))
