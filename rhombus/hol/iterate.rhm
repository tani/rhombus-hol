def ITERATE_PAIR:
  prove(
    [
      (hol:
         const monoidal :: (A -> A -> A) -> bool
         const iterate :: (B -> B -> B) -> (A -> bool) -> (A -> B) -> B
         const #{..} :: num -> num -> num -> bool
         forall op :: A -> A -> A:
           monoidal(op)
             ==> (forall (f :: num -> A, m :: num, n :: num):
                    iterate(op, #{..}((2 :: num) * m, (2 :: num) * n + (1 :: num)), f)
                      == iterate(
                           op,
                           #{..}(m, n),
