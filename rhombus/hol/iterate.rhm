def ITERATE_CLAUSES:
  prove(
    [
      (hol:
         const monoidal :: (A -> A -> A) -> bool
         const iterate :: (B -> B -> B) -> (A -> bool) -> (A -> B) -> B
         const EMPTY :: A -> bool
         const neutral :: (A -> A -> A) -> A
         const FINITE :: (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         forall op :: C -> C -> C:
           monoidal(op)
             ==> ((forall f :: A -> C: iterate(op, EMPTY, f) == neutral(op))
                    && (forall (f :: B -> C, x :: B, s :: B -> bool):
                          FINITE(s)
                            ==> (iterate(op, INSERT(x, s), f)
                                   == (if IN(x, s) | iterate(op, s, f) | op(f(x), iterate(op, s, f))))))),
      SIMP_TAC(PairList [ITERATE_CLAUSES_GEN, FINITE_SUPPORT])
    ]
