def NSUM_BIJECTION:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const nsum :: (A -> bool) -> (A -> num) -> num
         const o :: (B -> C) -> (A -> B) -> A -> C
         forall (f :: A -> num, p :: A -> A, s :: A -> bool):
           ((forall x :: A: IN(x, s) ==> IN(p(x), s))
