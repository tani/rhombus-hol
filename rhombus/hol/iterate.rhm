             ==> (forall (s :: A -> bool, t :: A -> bool, f :: A -> B):
                    FINITE(s) && FINITE(t)
                      ==> (op(iterate(op, s, f), iterate(op, t, f))
                             == op(iterate(op, UNION(s, t), f), iterate(op, INTER(s, t), f))))),
