          ASM_SIMP_TAC(PairList [IN_ELIM_THM, IN_NUMSEG])
        )
      ]
    )
  extend_basic_congs(map(SPEC_ALL)(CONJUNCTS(th)))

def EXPAND_SUM_CONV:
  let PairList [pth_0_4, & PairList [pth_1_4, & PairList [pth_2_4, & PairList []]]]:
    o(CONJUNCTS)(prove)(
      [
        Host.hol_term(And(
          Implies(
            App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("n", Num), Var("m", Num)]),
            Eq(
              Real,
              App(
                Const("sum", Fun(Fun(Num, Bool), Fun(Fun(Num, Real), Real))),
                [
                  App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Var("m", Num), Var("n", Num)]),
                  Var("f", Fun(Num, Real))
                ]
              ),
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              )
            )
          ),
          And(
            Eq(
              Real,
              App(
                Const("sum", Fun(Fun(Num, Bool), Fun(Fun(Num, Real), Real))),
                [
                  App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Var("m", Num), Var("m", Num)]),
                  Var("f", Fun(Num, Real))
                ]
              ),
              App(Var("f", Fun(Num, Real)), [Var("m", Num)])
            ),
            Implies(
              App(Const("<=", Fun(Num, Fun(Num, Bool))), [Var("m", Num), Var("n", Num)]),
              Eq(
                Real,
                App(
                  Const("sum", Fun(Fun(Num, Bool), Fun(Fun(Num, Real), Real))),
                  [
                    App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Var("m", Num), Var("n", Num)]),
                    Var("f", Fun(Num, Real))
                  ]
                ),
                App(
                  Const("real_add", Fun(Real, Fun(Real, Real))),
                  [
                    App(Var("f", Fun(Num, Real)), [Var("m", Num)]),
                    App(
                      Const("sum", Fun(Fun(Num, Bool), Fun(Fun(Num, Real), Real))),
                      [
                        App(
                          Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                          [
                            App(
                              Const("+", Fun(Num, Fun(Num, Num))),
                              [
                                Var("m", Num),
                                App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                              ]
                            ),
                            Var("n", Num)
                          ]
                        ),
                        Var("f", Fun(Num, Real))
                      ]
                    )
                  ]
                )
              )
            )
          )
        )),
        REWRITE_TAC(PairList [SUM_CLAUSES_LEFT, SUM_SING_NUMSEG, SUM_TRIV_NUMSEG])
      ]
    )
  let ns_tm_4 = Host.hol_term(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))))
  let f_tm_3 = Host.hol_term(Var("f", Fun(Num, Real)))
  let m_tm_4 = Host.hol_term(Var("m", Num))
  let n_tm_4 = Host.hol_term(Var("n", Num))
  fun conv_2(tm):
    let [smn, ftm] = dest_comb(tm)
    let [s, mn] = dest_comb(smn)
    if !(is_const(s) && (fst(dest_const(s)) == "sum"))
    | failwith("EXPAND_SUM_CONV")
    | let [mtm, ntm] = dest_binop(ns_tm_4)(mn)
      let m_4 = dest_numeral(mtm)
      let n_4 = dest_numeral(ntm)
      if (n_4 < m_4)
      | let th1 = INST(PairList [[ftm, f_tm_3], [mtm, m_tm_4], [ntm, n_tm_4]])(pth_0_4)
        MP(th1)(EQT_ELIM(NUM_LT_CONV(lhand(concl(th1)))))
      | if (n_4 == m_4)
        | CONV_RULE(RAND_CONV(TRY_CONV(BETA_CONV)))(INST(PairList [[ftm, f_tm_3], [mtm, m_tm_4]])(pth_1_4))
        | let th1 = INST(PairList [[ftm, f_tm_3], [mtm, m_tm_4], [ntm, n_tm_4]])(pth_2_4)
          let th2 = MP(th1)(EQT_ELIM(NUM_LE_CONV(lhand(concl(th1)))))
          CONV_RULE(
            RAND_CONV(
              COMB2_CONV(RAND_CONV(TRY_CONV(BETA_CONV)))((LAND_CONV(LAND_CONV(NUM_ADD_CONV)) then_conv conv_2))
            )
          )(th2)
  conv_2

