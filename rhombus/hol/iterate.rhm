def CARD_UNIONS_IMAGE:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         const CARD :: (A -> bool) -> num
         const UNIONS :: ((A -> bool) -> bool) -> A -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const nsum :: (A -> bool) -> (A -> num) -> num
         forall (f :: K -> A -> bool, s :: K -> bool):
           (FINITE(s)
              && ((forall t :: K: IN(t, s) ==> FINITE(f(t)))
                    && (forall (t :: K, u :: K):
                          IN(t, s) && (IN(u, s) && t != u) ==> INTER(f(t), f(u)) == EMPTY)))
             ==> CARD(UNIONS(IMAGE(f, s))) == nsum(s, fun (i :: K): CARD(f(i)))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (GEN_TAC then_tac ONCE_REWRITE_TAC(PairList [IMP_CONJ])) then_tac \
                              MATCH_MP_TAC(FINITE_INDUCT_STRONG)
                            ) then_tac \
                            REWRITE_TAC(PairList [IMAGE_CLAUSES])
                          ) then_tac \
                          REWRITE_TAC(PairList [UNIONS_0, UNIONS_INSERT, NOT_IN_EMPTY, IN_INSERT])
                        ) then_tac \
                        REWRITE_TAC(PairList [CARD_CLAUSES, NSUM_CLAUSES])
                      ) then_tac \
                      REPEAT(GEN_TAC)
                    ) then_tac \
                    DISCH_THEN((fun(th): (STRIP_TAC then_tac MP_TAC(th))))
                  ) then_tac \
                  ASM_SIMP_TAC(PairList [NSUM_CLAUSES])
                ) then_tac \
                DISCH_THEN(CONJUNCTS_THEN2(o(SUBST1_TAC)(SYM))(STRIP_ASSUME_TAC))
              ) then_tac \
              CONV_TAC(SYM_CONV)
            ) then_tac \
            MATCH_MP_TAC(CARD_UNION_EQ)
          ) then_tac \
          ASM_SIMP_TAC(PairList [FINITE_IMAGE, FINITE_UNIONS, FINITE_UNION, INTER_UNIONS])
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

def CARD_UNIONS:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         const CARD :: (A -> bool) -> num
         const UNIONS :: ((A -> bool) -> bool) -> A -> bool
         const nsum :: (A -> bool) -> (A -> num) -> num
         forall s :: (A -> bool) -> bool:
           (FINITE(s)
              && ((forall t :: A -> bool: IN(t, s) ==> FINITE(t))
                    && (forall (t :: A -> bool, u :: A -> bool):
                          IN(t, s) && (IN(u, s) && t != u) ==> INTER(t, u) == EMPTY)))
             ==> CARD(UNIONS(s)) == nsum(s, CARD)),
      (
        MP_TAC(ISPEC(hol:
                       fun (x :: A -> bool): x)(CARD_UNIONS_IMAGE)) then_tac \
        REWRITE_TAC(PairList [IMAGE_ID, ETA_AX])
      )
    ]
  )

def EXPAND_NSUM_CONV:
  let PairList [pth_0_3, & PairList [pth_1_3, & PairList [pth_2_3, & PairList []]]]:
    o(CONJUNCTS)(prove)(
      [
        (hol:
           var n :: num
           var m :: num
           var f :: num -> num
           const nsum :: (A -> bool) -> (A -> num) -> num
           const #{..} :: num -> num -> num -> bool
           (n < m ==> nsum(#{..}(m, n), f) == (0 :: num))
             && (nsum(#{..}(m, m), f) == f(m)
                   && (m <= n ==> nsum(#{..}(m, n), f) == f(m) + nsum(#{..}(m + (1 :: num), n), f)))),
        REWRITE_TAC(PairList [NSUM_CLAUSES_LEFT, NSUM_SING_NUMSEG, NSUM_TRIV_NUMSEG])
      ]
    )
  let ns_tm_3 = hol: const #{..} :: num -> num -> num -> bool; #{..}
  let f_tm_2 = hol: var f :: num -> num; f
  let m_tm_3 = hol: var m :: num; m
  let n_tm_3 = hol: var n :: num; n
  fun conv(tm):
    let [smn, ftm] = dest_comb(tm)
    let [s, mn] = dest_comb(smn)
    if !(is_const(s) && (fst(dest_const(s)) == "nsum"))
    | failwith("EXPAND_NSUM_CONV")
    | let [mtm, ntm] = dest_binop(ns_tm_3)(mn)
      let m_3 = dest_numeral(mtm)
      let n_3 = dest_numeral(ntm)
      if (n_3 < m_3)
      | let th1 = INST(PairList [[ftm, f_tm_2], [mtm, m_tm_3], [ntm, n_tm_3]])(pth_0_3)
        MP(th1)(EQT_ELIM(NUM_LT_CONV(lhand(concl(th1)))))
      | if (n_3 == m_3)
        | CONV_RULE(RAND_CONV(TRY_CONV(BETA_CONV)))(INST(PairList [[ftm, f_tm_2], [mtm, m_tm_3]])(pth_1_3))
        | let th1 = INST(PairList [[ftm, f_tm_2], [mtm, m_tm_3], [ntm, n_tm_3]])(pth_2_3)
          let th2 = MP(th1)(EQT_ELIM(NUM_LE_CONV(lhand(concl(th1)))))
          CONV_RULE(
            RAND_CONV(
              COMB2_CONV(RAND_CONV(TRY_CONV(BETA_CONV)))((LAND_CONV(LAND_CONV(NUM_ADD_CONV)) then_conv conv))
            )
          )(th2)
  conv

prioritize_real(#void)

