def ITERATE_EQ:
  prove(
    [
      Host.hol_term(Forall(
        "op",
        Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))),
        Implies(
          App(Const("monoidal", Fun(Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))), Bool)), [Ref("op")]),
          Forall(
            "f",
            Fun(Tvar("A"), Tvar("B")),
            Forall(
              "g",
              Fun(Tvar("A"), Tvar("B")),
              Forall(
                "s",
                Fun(Tvar("A"), Bool),
                Implies(
                  Forall(
                    "x",
                    Tvar("A"),
                    Implies(
                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                      Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("g"), [Ref("x")]))
                    )
                  ),
                  Eq(
                    Tvar("B"),
                    App(
                      Const(
                        "iterate",
                        Fun(
                          Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))),
                          Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Tvar("B")))
                        )
                      ),
                      [Ref("op"), Ref("s"), Ref("f")]
                    ),
                    App(
                      Const(
                        "iterate",
                        Fun(
                          Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))),
                          Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Tvar("B")))
                        )
                      ),
                      [Ref("op"), Ref("s"), Ref("g")]
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
