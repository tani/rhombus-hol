                App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("u")]),
                And(
                  App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("v")]),
                  Forall(
                    "x",
                    Tvar("A"),
                    Implies(
                      App(
                        Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                        [
                          Ref("x"),
                          App(
                            Const("DIFF", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                            [Ref("u"), Ref("v")]
                          )
                        ]
                      ),
                      Eq(Num, App(Ref("f"), [Ref("x")]), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]))
                    )
                  )
                )
              ),
              App(
                Const("<=", Fun(Num, Fun(Num, Bool))),
                [
                  App(
                    Const("nsum", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Num), Num))),
                    [Ref("u"), Ref("f")]
                  ),
                  App(
                    Const("nsum", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Num), Num))),
                    [Ref("v"), Ref("f")]
                  )
                ]
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(STRIP_TAC) then_tac \
                    MP_TAC(
                      ISPECL(
                        PairList [
                          Host.hol_term(Var("f", Fun(Tvar("A"), Num))),
                          Host.hol_term(App(
                            Const("INTER", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                            [Var("u", Fun(Tvar("A"), Bool)), Var("v", Fun(Tvar("A"), Bool))]
                          ))
                        ])(
                        NSUM_UNION
                      )
                    )
                  ) then_tac \
                  DISCH_THEN(
                    fun(th):
                      (
                        MP_TAC(
                          SPEC(
                            Host.hol_term(App(
                              Const("DIFF", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                              [Var("v", Fun(Tvar("A"), Bool)), Var("u", Fun(Tvar("A"), Bool))]
                            ))
                          )(th)
                        ) then_tac \
                        MP_TAC(
