def ITERATE_EXPAND_CASES:
  prove(
    [
      (hol:
         const iterate :: (B -> B -> B) -> (A -> bool) -> (A -> B) -> B
         const FINITE :: (A -> bool) -> bool
         const support :: (B -> B -> B) -> (A -> B) -> (A -> bool) -> A -> bool
         const neutral :: (A -> A -> A) -> A
         forall (op :: B -> B -> B, f :: A -> B, s :: A -> bool):
           iterate(op, s, f)
             == (if FINITE(support(op, f, s)) | iterate(op, support(op, f, s), f) | neutral(op))),
