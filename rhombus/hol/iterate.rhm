def initialization_2:
  let th:
    prove(
      [
        (hol:
           const IN :: A -> (A -> bool) -> bool
           const sum :: (A -> bool) -> (A -> real) -> real
           const #{..} :: num -> num -> num -> bool
           const GSPEC :: (A -> bool) -> A -> bool
           const SETSPEC :: A -> bool -> A -> bool
           (forall (f :: A -> real, g :: A -> real, s :: A -> bool):
              (forall x :: A: IN(x, s) ==> f(x) == g(x)) ==> sum(s, fun (i :: A): f(i)) == sum(s, g))
             && ((forall (f :: num -> real, g :: num -> real, a :: num, b :: num):
                    (forall i :: num: a <= i && i <= b ==> f(i) == g(i))
                      ==> sum(#{..}(a, b), fun (i :: num): f(i)) == sum(#{..}(a, b), g))
                   && (forall (f :: #{?132910} -> real, g :: #{?132910} -> real, p :: #{?132910} -> bool):
                         (forall x :: #{?132910}: p(x) ==> f(x) == g(x))
                           ==> (sum(
                                  GSPEC(
                                    fun (gen_pvar_342 :: #{?132910}):
                                      exists y :: #{?132910}: SETSPEC(gen_pvar_342, p(y), y)
                                  ),
                                  fun (i :: #{?132910}): f(i)
                                )
                                  == sum(
                                       GSPEC(
                                         fun (gen_pvar_343 :: #{?132910}):
                                           exists y :: #{?132910}: SETSPEC(gen_pvar_343, p(y), y)
                                       ),
                                       g
                                     ))))),
        (
          (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(SUM_EQ)) then_tac \
          ASM_SIMP_TAC(PairList [IN_ELIM_THM, IN_NUMSEG])
