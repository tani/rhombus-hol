                App(
                  Const("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))))),
                  [
                    Eq(Num, Ref("m"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])),
                    App(Var("f", Fun(Num, Tvar("A"))), [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]),
                    App(Const("neutral", Fun(Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))), Tvar("A"))), [Ref("op")])
                  ]
                )
              )
            ),
            Forall(
              "m",
              Num,
              Forall(
                "n",
                Num,
                Eq(
                  Tvar("A"),
                  App(
                    Const(
                      "iterate",
                      Fun(
                        Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))),
                        Fun(Fun(Num, Bool), Fun(Fun(Num, Tvar("A")), Tvar("A")))
                      )
                    ),
                    [
                      Ref("op"),
                      App(
                        Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                        [Ref("m"), App(Const("SUC", Fun(Num, Num)), [Ref("n")])]
                      ),
                      Var("f", Fun(Num, Tvar("A")))
