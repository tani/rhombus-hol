def NUMSEG_CONV:
  let pth_0_2:
    MESON(
      PairList [NUMSEG_EMPTY])(
      (hol:
         var n :: num
         var m :: num
         const #{..} :: num -> num -> num -> bool
         const EMPTY :: A -> bool
         n < m ==> #{..}(m, n) == EMPTY)
    )
  let pth_1_2:
    MESON(
      PairList [NUMSEG_SING])(
      (hol:
         var m :: num
         const #{..} :: num -> num -> num -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         #{..}(m, m) == INSERT(m, EMPTY))
    )
  let pth_2_2:
    MESON(
      PairList [NUMSEG_LREC, ADD1])(
      (hol:
         var m :: num
         var n :: num
         const #{..} :: num -> num -> num -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const SUC :: num -> num
         m <= n ==> #{..}(m, n) == INSERT(m, #{..}(SUC(m), n)))
    )
  let ns_tm_2 = hol: const #{..} :: num -> num -> num -> bool; #{..}
  let m_tm_2 = hol: var m :: num; m
  let n_tm_2 = hol: var n :: num; n
  fun NUMSEG_CONV(tm):
    let [nstm, nt] = dest_comb(tm)
    let [nst, mt] = dest_comb(nstm)
    if (nst != ns_tm_2)
    | failwith("NUMSEG_CONV")
    | let m_2 = dest_numeral(mt)
      let n_2 = dest_numeral(nt)
      if (n_2 < m_2)
      | MP_CONV(NUM_LT_CONV)(INST(PairList [[mt, m_tm_2], [nt, n_tm_2]])(pth_0_2))
      | if (n_2 == m_2)
        | INST(PairList [[mt, m_tm_2]])(pth_1_2)
        | let th = MP_CONV(NUM_LE_CONV)(INST(PairList [[mt, m_tm_2], [nt, n_tm_2]])(pth_2_2))
          CONV_RULE(funpow(2)(RAND_CONV)((LAND_CONV(NUM_SUC_CONV) then_conv NUMSEG_CONV)))(th)
  NUMSEG_CONV

def TOPOLOGICAL_SORT:
  prove(
    [
      (hol:
         const HAS_SIZE :: (A -> bool) -> num -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const #{..} :: num -> num -> num -> bool
         const IN :: A -> (A -> bool) -> bool
         forall #{<<} :: A -> A -> bool:
           ((forall (x :: A, y :: A): #{<<}(x, y) && #{<<}(y, x) ==> x == y)
              && (forall (x :: A, y :: A, z :: A): #{<<}(x, y) && #{<<}(y, z) ==> #{<<}(x, z)))
             ==> (forall (n :: num, s :: A -> bool):
                    HAS_SIZE(s, n)
                      ==> (exists f :: num -> A:
                             s == IMAGE(f, #{..}((1 :: num), n))
                               && (forall (j :: num, k :: num):
                                     (IN(j, #{..}((1 :: num), n))
                                        && (IN(k, #{..}((1 :: num), n)) && j < k))
                                       ==> !#{<<}(f(k), f(j)))))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            (
                                              (GEN_TAC then_tac DISCH_TAC) then_tac \
                                              SUBGOAL_THEN(
                                                (hol:
                                                   var #{<<} :: A -> A -> bool
                                                   const HAS_SIZE :: (A -> bool) -> num -> bool
                                                   const EMPTY :: A -> bool
                                                   const IN :: A -> (A -> bool) -> bool
                                                   const DELETE :: (A -> bool) -> A -> A -> bool
                                                   forall (n :: num, s :: A -> bool):
                                                     HAS_SIZE(s, n) && s != EMPTY
                                                       ==> (exists a :: A: IN(a, s) && (forall b :: A: IN(b, DELETE(s, a)) ==> !#{<<}(b, a))))
                                              )(ASSUME_TAC)
                                            ) then_list \
                                            PairList [
                                              (
                                                (
                                                  (
                                                    (
                                                      (
                                                        (
                                                          (
                                                            (
                                                              (
                                                                (
                                                                  (
                                                                    (
                                                                      (
                                                                        (
                                                                          (
                                                                            (
                                                                              (
                                                                                INDUCT_TAC then_tac \
                                                                                REWRITE_TAC(
                                                                                  PairList [
                                                                                    HAS_SIZE_0,
                                                                                    HAS_SIZE_SUC,
                                                                                    TAUT(hol:
                                                                                           var a :: bool
                                                                                           !(a && !a))
                                                                                  ]
                                                                                )
                                                                              ) then_tac \
                                                                              X_GEN_TAC(hol: var s :: A -> bool; s)
                                                                            ) then_tac \
                                                                            STRIP_TAC
                                                                          ) then_tac \
                                                                          FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [GSYM(MEMBER_NOT_EMPTY)])))
                                                                        ) then_tac \
                                                                        DISCH_THEN(X_CHOOSE_TAC(hol: var a :: A; a))
                                                                      ) then_tac \
                                                                      FIRST_X_ASSUM(o(MP_TAC)(SPEC(hol: var a :: A; a)))
                                                                    ) then_tac \
                                                                    ASM_REWRITE_TAC(PairList [])
                                                                  ) then_tac \
                                                                  DISCH_TAC
                                                                ) then_tac \
                                                                FIRST_X_ASSUM(
                                                                  o(MP_TAC)(
                                                                    SPEC(
                                                                      (hol:
                                                                         var s :: A -> bool
                                                                         var a :: A
                                                                         const DELETE :: (A -> bool) -> A -> A -> bool
                                                                         DELETE(s, a))
                                                                    )
                                                                  )
                                                                )
                                                              ) then_tac \
                                                              ASM_SIMP_TAC(
                                                                PairList [
                                                                  SET_RULE(
                                                                    (hol:
                                                                       var a :: #{?114304}
                                                                       var s :: #{?114304} -> bool
                                                                       const IN :: A -> (A -> bool) -> bool
                                                                       const DELETE :: (A -> bool) -> A -> A -> bool
                                                                       const EMPTY :: A -> bool
                                                                       const INSERT :: A -> (A -> bool) -> A -> bool
                                                                       IN(a, s) ==> (DELETE(s, a) == EMPTY <=> s == INSERT(a, EMPTY)))
                                                                  )
                                                                ]
                                                              )
                                                            ) then_tac \
                                                            ASM_CASES_TAC(
                                                              (hol:
                                                                 var s :: A -> bool
                                                                 var a :: A
                                                                 const INSERT :: A -> (A -> bool) -> A -> bool
                                                                 const EMPTY :: A -> bool
                                                                 s == INSERT(a, EMPTY))
                                                            )
                                                          ) then_tac \
                                                          ASM_REWRITE_TAC(PairList [])
                                                        ) then_list \
                                                        PairList [
                                                          (EXISTS_TAC(hol: var a :: A; a) then_tac SET_TAC(PairList [])),
                                                          ALL_TAC
                                                        ]
                                                      ) then_tac \
                                                      DISCH_THEN(X_CHOOSE_THEN(hol: var b :: A; b)(STRIP_ASSUME_TAC))
