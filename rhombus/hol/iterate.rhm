                  ),
                  App(
                    Const("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))))),
                    [
                      App(
                        Const("<=", Fun(Num, Fun(Num, Bool))),
                        [Ref("m"), App(Const("SUC", Fun(Num, Num)), [Ref("n")])]
                      ),
                      App(
                        Ref("op"),
                        [
                          App(
                            Const(
                              "iterate",
                              Fun(
                                Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))),
                                Fun(Fun(Num, Bool), Fun(Fun(Num, Tvar("A")), Tvar("A")))
                              )
                            ),
                            [
                              Ref("op"),
                              App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Ref("m"), Ref("n")]),
                              Var("f", Fun(Num, Tvar("A")))
                            ]
                          ),
                          App(Var("f", Fun(Num, Tvar("A"))), [App(Const("SUC", Fun(Num, Num)), [Ref("n")])])
                        ]
                      ),
                      App(
                        Const(
                          "iterate",
                          Fun(
                            Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))),
                            Fun(Fun(Num, Bool), Fun(Fun(Num, Tvar("A")), Tvar("A")))
                          )
                        ),
                        [
                          Ref("op"),
                          App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Ref("m"), Ref("n")]),
                          Var("f", Fun(Num, Tvar("A")))
                        ]
                      )
                    ]
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (REWRITE_TAC(PairList [NUMSEG_CLAUSES]) then_tac REPEAT(STRIP_TAC)) then_tac \
              COND_CASES_TAC
