          ) then_tac \
          REWRITE_TAC(PairList [support, IN_ELIM_THM, SUBSET, IN_UNION])
        ) then_tac \
        ASM_MESON_TAC(PairList [monoidal])
      )
    ]
  )

def ITERATE_CLAUSES_NUMSEG:
  prove(
    [
      (hol:
         var f :: num -> A
         const monoidal :: (A -> A -> A) -> bool
         const iterate :: (B -> B -> B) -> (A -> bool) -> (A -> B) -> B
         const #{..} :: num -> num -> num -> bool
         const neutral :: (A -> A -> A) -> A
         const SUC :: num -> num
         forall op :: A -> A -> A:
           monoidal(op)
             ==> ((forall m :: num:
                     iterate(op, #{..}(m, (0 :: num)), f)
                       == (if m == (0 :: num) | f((0 :: num)) | neutral(op)))
                    && (forall (m :: num, n :: num):
                          iterate(op, #{..}(m, SUC(n)), f)
                            == (if m <= SUC(n)
                                | op(iterate(op, #{..}(m, n), f), f(SUC(n)))
                                | iterate(op, #{..}(m, n), f))))),
      (
        (
          (
            (
              (REWRITE_TAC(PairList [NUMSEG_CLAUSES]) then_tac REPEAT(STRIP_TAC)) then_tac \
              COND_CASES_TAC
            ) then_tac \
            ASM_SIMP_TAC(PairList [ITERATE_CLAUSES, FINITE_NUMSEG, IN_NUMSEG, FINITE_EMPTY])
          ) then_tac \
          REWRITE_TAC(
            PairList [
              ARITH_RULE(
                (hol:
                   var n :: num
                   const SUC :: num -> num
                   !(SUC(n) <= n))
              ),
              NOT_IN_EMPTY
            ]
          )
        ) then_tac \
        ASM_MESON_TAC(PairList [monoidal])
      )
    ]
  )

