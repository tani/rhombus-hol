                 const GSPEC :: (A -> bool) -> A -> bool
                 const SETSPEC :: A -> bool -> A -> bool
                 const IN :: A -> (A -> bool) -> bool
                 nsum(
                   s,
                   fun (i :: A):
                     nsum(
                       GSPEC(
                         fun (gen_pvar_292 :: B):
                           exists j :: B: SETSPEC(gen_pvar_292, IN(j, t) && R(i, j), j)
                       ),
                       fun (j :: B): (1 :: num)
                     )
                 ))
            )
          ) then_tac \
          CONJ_TAC
        ) then_list \
