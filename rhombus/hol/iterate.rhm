def ITERATE_UNION:
  let lemma:
    prove(
      [
        (hol:
           var s :: #{?115696} -> bool
           var x :: #{?115696}
           var t :: #{?115696} -> bool
           const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
           const INSERT :: A -> (A -> bool) -> A -> bool
           const DISJOINT :: (A -> bool) -> (A -> bool) -> bool
           const IN :: A -> (A -> bool) -> bool
           UNION(s, INSERT(x, t)) == INSERT(x, UNION(s, t))
             && (DISJOINT(s, INSERT(x, t)) <=> !IN(x, s) && DISJOINT(s, t))),
        SET_TAC(PairList [])
      ]
    )
  prove(
    [
      (hol:
         const monoidal :: (A -> A -> A) -> bool
         const FINITE :: (A -> bool) -> bool
         const DISJOINT :: (A -> bool) -> (A -> bool) -> bool
         const iterate :: (B -> B -> B) -> (A -> bool) -> (A -> B) -> B
