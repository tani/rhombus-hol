def SUM_DELETE_CASES:
  prove(
    [
      Host.hol_term(Forall(
        "f",
        Fun(Tvar("A"), Real),
        Forall(
          "s",
          Fun(Tvar("A"), Bool),
          Forall(
            "a",
            Tvar("A"),
            Implies(
              App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
              Eq(
                Real,
                App(
                  Const("sum", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Real), Real))),
                  [
                    App(
                      Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                      [Ref("s"), Ref("a")]
                    ),
                    Ref("f")
                  ]
                ),
                App(
                  Const("COND", Fun(Bool, Fun(Real, Fun(Real, Real)))),
                  [
                    App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("a"), Ref("s")]),
                    App(
                      Const("real_sub", Fun(Real, Fun(Real, Real))),
                      [
                        App(
                          Const("sum", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Real), Real))),
                          [Ref("s"), Ref("f")]
                        ),
                        App(Ref("f"), [Ref("a")])
                      ]
                    ),
                    App(
                      Const("sum", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Real), Real))),
                      [Ref("s"), Ref("f")]
                    )
                  ]
                )
              )
            )
          )
        )
      )),
      (
        (REPEAT(STRIP_TAC) then_tac COND_CASES_TAC) then_tac \
        ASM_SIMP_TAC(
          PairList [
            SET_RULE(
              Host.hol_term(Implies(
                Not(
                  App(
                    Const("IN", Fun(Tvar("?128145"), Fun(Fun(Tvar("?128145"), Bool), Bool))),
                    [Var("a", Tvar("?128145")), Var("s", Fun(Tvar("?128145"), Bool))]
                  )
                ),
                Eq(
                  Fun(Tvar("?128145"), Bool),
                  App(
                    Const(
                      "DELETE",
                      Fun(Fun(Tvar("?128145"), Bool), Fun(Tvar("?128145"), Fun(Tvar("?128145"), Bool)))
                    ),
                    [Var("s", Fun(Tvar("?128145"), Bool)), Var("a", Tvar("?128145"))]
                  ),
                  Var("s", Fun(Tvar("?128145"), Bool))
                )
              ))
            ),
            SUM_DELETE
          ]
        )
      )
    ]
  )

