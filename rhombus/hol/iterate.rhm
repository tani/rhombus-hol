                                    [App(Ref("f"), [Ref("i")]), Ref("dom")]
                                  ),
                                  Not(Eq(Tvar("A"), App(Ref("f"), [Ref("i")]), Ref("neut")))
                                )
                              ),
                              App(Ref("P"), [App(Ref("f"), [Ref("i")])])
                            )
                          )
                        )
                      ),
                      App(
                        Ref("P"),
                        [
                          App(
                            Const(
                              "iterato",
