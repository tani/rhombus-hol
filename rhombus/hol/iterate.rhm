def NSUM_SUBSET:
  prove(
    [
      Host.hol_term(Forall(
        "u",
        Fun(Tvar("A"), Bool),
        Forall(
          "v",
          Fun(Tvar("A"), Bool),
          Forall(
            "f",
            Fun(Tvar("A"), Num),
            Implies(
