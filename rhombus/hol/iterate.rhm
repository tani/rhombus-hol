def ITERATE_REFLECT:
  prove(
    [
      Host.hol_term(Forall(
        "op",
        Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))),
        Implies(
          App(Const("monoidal", Fun(Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))), Bool)), [Ref("op")]),
          Forall(
            "x",
            Fun(Num, Tvar("A")),
            Forall(
              "m",
              Num,
              Forall(
                "n",
                Num,
                Eq(
                  Tvar("A"),
                  App(
                    Const(
                      "iterate",
                      Fun(
                        Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))),
                        Fun(Fun(Num, Bool), Fun(Fun(Num, Tvar("A")), Tvar("A")))
                      )
                    ),
                    [
                      Ref("op"),
                      App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Ref("m"), Ref("n")]),
                      Ref("x")
                    ]
                  ),
                  App(
                    Const("COND", Fun(Bool, Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))))),
                    [
                      App(Const("<", Fun(Num, Fun(Num, Bool))), [Ref("n"), Ref("m")]),
                      App(Const("neutral", Fun(Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))), Tvar("A"))), [Ref("op")]),
                      App(
                        Const(
                          "iterate",
                          Fun(
                            Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))),
                            Fun(Fun(Num, Bool), Fun(Fun(Num, Tvar("A")), Tvar("A")))
                          )
                        ),
                        [
                          Ref("op"),
                          App(
                            Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                            [
                              App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]),
                              App(Const("-", Fun(Num, Fun(Num, Num))), [Ref("n"), Ref("m")])
                            ]
                          ),
                          Lambda(
                            "i",
                            Num,
                            App(Ref("x"), [App(Const("-", Fun(Num, Fun(Num, Num))), [Ref("n"), Ref("i")])])
                          )
                        ]
                      )
                    ]
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (REWRITE_TAC(PairList [GSYM(NUMSEG_EMPTY)]) then_tac REPEAT(STRIP_TAC)) then_tac \
                            COND_CASES_TAC
                          ) then_list \
                          PairList [
                            ASM_MESON_TAC(PairList [ITERATE_CLAUSES]),
                            RULE_ASSUM_TAC(REWRITE_RULE(PairList [NUMSEG_EMPTY, NOT_LT]))
                          ]
                        ) then_tac \
                        FIRST_ASSUM(
                          o(
                            o(MP_TAC)(
                              ISPECL(
                                PairList [
                                  Host.hol_term(Lambda("i", Num, App(Const("-", Fun(Num, Fun(Num, Num))), [Var("n", Num), Ref("i")]))),
                                  Host.hol_term(Var("x", Fun(Num, Tvar("A")))),
                                  Host.hol_term(App(
                                    Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                                    [
                                      App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]),
                                      App(Const("-", Fun(Num, Fun(Num, Num))), [Var("n", Num), Var("m", Num)])
                                    ]
                                  ))
                                ]
                              )
                            )
                          )(
                            MATCH_MP(
                              INST_TYPE(PairList [[Host.hol_term(Tvar("X")), Host.hol_term(Tvar("A"))]])(ITERATE_IMAGE)
                            )
                          )
                        )
                      ) then_tac \
                      REWRITE_TAC(PairList [o_DEF, IN_NUMSEG])
                    ) then_tac \
                    ANTS_TAC
                  ) then_list \
                  PairList [ARITH_TAC, DISCH_THEN(o(SUBST1_TAC)(SYM))]
                ) then_tac \
                AP_THM_TAC
              ) then_tac \
              AP_TERM_TAC
            ) then_tac \
            REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, IN_NUMSEG])
          ) then_tac \
          REWRITE_TAC(
            PairList [
              UNWIND_THM2,
              ARITH_RULE(
                Host.hol_term(Iff(
                  And(
                    Eq(Num, Var("x", Num), App(Const("-", Fun(Num, Fun(Num, Num))), [Var("n", Num), Var("y", Num)])),
                    And(
                      App(
                        Const("<=", Fun(Num, Fun(Num, Bool))),
                        [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]), Var("y", Num)]
                      ),
                      App(
                        Const("<=", Fun(Num, Fun(Num, Bool))),
                        [Var("y", Num), App(Const("-", Fun(Num, Fun(Num, Num))), [Var("n", Num), Var("m", Num)])]
                      )
                    )
                  ),
                  And(
                    Eq(Num, Var("y", Num), App(Const("-", Fun(Num, Fun(Num, Num))), [Var("n", Num), Var("x", Num)])),
                    And(
                      App(Const("<=", Fun(Num, Fun(Num, Bool))), [Var("x", Num), Var("n", Num)]),
                      App(
                        Const("<=", Fun(Num, Fun(Num, Bool))),
                        [Var("y", Num), App(Const("-", Fun(Num, Fun(Num, Num))), [Var("n", Num), Var("m", Num)])]
                      )
                    )
                  )
                ))
              )
            ]
