                      ONCE_REWRITE_TAC(PairList [GSYM(ITERATE_SUPPORT)])
                    ) then_tac \
                    MATCH_MP_TAC(EQ_TRANS)
                  ) then_tac \
                  EXISTS_TAC(
                    Host.hol_term(App(
                      Const(
                        "iterate",
                        Fun(
                          Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))),
                          Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Tvar("B")))
