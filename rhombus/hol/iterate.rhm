                  Const("sum", Fun(Fun(Tvar("B"), Bool), Fun(Fun(Tvar("B"), Real), Real))),
                  [
                    App(
                      Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                      [Ref("f"), Ref("s")]
                    ),
                    Ref("g")
                  ]
                ),
                App(
                  Const("sum", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Real), Real))),
                  [
                    Ref("s"),
                    App(
                      Const("o", Fun(Fun(Tvar("B"), Real), Fun(Fun(Tvar("A"), Tvar("B")), Fun(Tvar("A"), Real)))),
                      [Ref("g"), Ref("f")]
                    )
