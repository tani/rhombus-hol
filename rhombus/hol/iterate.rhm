                                 const int_of_num :: num -> int
                                 const #{..} :: num -> num -> num -> bool
                                 const num_of_int :: int -> num
                                 IMAGE(fun (n :: num): l + int_of_num(n), #{..}((0 :: num), num_of_int(r - l))))
                            )
                          ) then_tac \
