Host.hol_apply_unit(prioritize_num)

Host.parse_as_infix(["..", [15, "right"]])

def numseg:
  new_definition(
    Host.hol_term(Eq(
      Fun(Num, Bool),
      App(Var("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Var("m", Num), Var("n", Num)]),
      App(
        Const("GSPEC", Fun(Fun(Num, Bool), Fun(Num, Bool))),
        [
          Lambda(
            "GEN%PVAR%231",
            Num,
            Exists(
              "x",
              Num,
              App(
                Const("SETSPEC", Fun(Num, Fun(Bool, Fun(Num, Bool)))),
                [
                  Ref("GEN%PVAR%231"),
                  And(
                    App(Const("<=", Fun(Num, Fun(Num, Bool))), [Var("m", Num), Ref("x")]),
                    App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("x"), Var("n", Num)])
                  ),
                  Ref("x")
                ]
              )
            )
          )
        ]
      )
    ))
  )

def FINITE_NUMSEG:
  prove(
    [
      Host.hol_term(Forall(
        "m",
        Num,
        Forall(
          "n",
          Num,
          App(
            Const("FINITE", Fun(Fun(Num, Bool), Bool)),
            [App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Ref("m"), Ref("n")])]
          )
        )
      )),
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac MATCH_MP_TAC(FINITE_SUBSET)) then_tac \
            EXISTS_TAC(
              Host.hol_term(App(
                Const("GSPEC", Fun(Fun(Num, Bool), Fun(Num, Bool))),
                [
                  Lambda(
                    "GEN%PVAR%232",
                    Num,
                    Exists(
                      "x",
                      Num,
                      App(
                        Const("SETSPEC", Fun(Num, Fun(Bool, Fun(Num, Bool)))),
                        [
                          Ref("GEN%PVAR%232"),
                          App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("x"), Var("n", Num)]),
                          Ref("x")
                        ]
                      )
                    )
                  )
                ]
              ))
            )
          ) then_tac \
          REWRITE_TAC(PairList [FINITE_NUMSEG_LE])
        ) then_tac \
        SIMP_TAC(PairList [SUBSET, IN_ELIM_THM, numseg])
      )
    ]
  )

def NUMSEG_COMBINE_R:
  prove(
    [
      Host.hol_term(Forall(
        "m",
        Num,
        Forall(
          "p",
          Num,
          Forall(
            "n",
            Num,
            Implies(
              And(
                App(
                  Const("<=", Fun(Num, Fun(Num, Bool))),
                  [
                    Ref("m"),
                    App(
                      Const("+", Fun(Num, Fun(Num, Num))),
                      [
                        Ref("p"),
                        App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                      ]
                    )
                  ]
                ),
                App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("p"), Ref("n")])
              ),
              Eq(
                Fun(Num, Bool),
                App(
                  Const("UNION", Fun(Fun(Num, Bool), Fun(Fun(Num, Bool), Fun(Num, Bool)))),
                  [
                    App(Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))), [Ref("m"), Ref("p")]),
                    App(
                      Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                      [
                        App(
                          Const("+", Fun(Num, Fun(Num, Num))),
                          [
                            Ref("p"),
