         forall (R :: A -> B -> bool, g :: A -> real, s :: A -> bool, t :: B -> bool):
           FINITE(s) && (forall x :: A: IN(x, s) ==> (exists1 y :: B: IN(y, t) && R(x, y)))
             ==> (sum(
                    t,
