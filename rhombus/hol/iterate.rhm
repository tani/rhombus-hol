         forall (n :: num, f :: A -> num, g :: A -> num, s :: A -> bool):
           FINITE(s) && (forall x :: A: IN(x, s) ==> const.#{==}(f(x), g(x), num_mod(n)))
             ==> const.#{==}(nsum(s, f), nsum(s, g), num_mod(n))),
