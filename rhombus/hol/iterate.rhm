               const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
               const o :: (B -> C) -> (A -> B) -> A -> C
               forall s :: A -> bool:
                 FINITE(s) && (forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> x == y)
                   ==> iterate(op, IMAGE(f, s), g) == iterate(op, s, o(g, f)))
