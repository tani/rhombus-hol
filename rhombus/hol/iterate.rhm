           (P(neut)
              && ((forall (x :: A, y :: A): P(x) && P(y) ==> P(op(x, y)))
                    && (forall i :: K: IN(i, k) && (IN(f(i), dom) && f(i) != neut) ==> P(f(i)))))
             ==> P(iterato(dom, neut, op, #{<<=}, k, f))),
