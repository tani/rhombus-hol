Host.parse_as_infix(["..", [15, "right"]])

def numseg:
  new_definition(
    (hol:
       var #{..} :: num -> num -> num -> bool
       var m :: num
       var n :: num
       const GSPEC :: (A -> bool) -> A -> bool
       const SETSPEC :: A -> bool -> A -> bool
       #{..}(m, n)
         == GSPEC(
              fun (gen_pvar_231 :: num):
                exists x :: num: SETSPEC(gen_pvar_231, m <= x && x <= n, x)
            ))
  )

def FINITE_NUMSEG:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const #{..} :: num -> num -> num -> bool
         forall (m :: num, n :: num): FINITE(#{..}(m, n))),
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac MATCH_MP_TAC(FINITE_SUBSET)) then_tac \
            EXISTS_TAC(
              (hol:
                 var n :: num
                 const GSPEC :: (A -> bool) -> A -> bool
                 const SETSPEC :: A -> bool -> A -> bool
                 GSPEC(
                   fun (gen_pvar_232 :: num):
                     exists x :: num: SETSPEC(gen_pvar_232, x <= n, x)
                 ))
            )
          ) then_tac \
          REWRITE_TAC(PairList [FINITE_NUMSEG_LE])
        ) then_tac \
        SIMP_TAC(PairList [SUBSET, IN_ELIM_THM, numseg])
      )
    ]
  )

def NUMSEG_COMBINE_R:
  prove(
    [
      (hol:
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         const #{..} :: num -> num -> num -> bool
         forall (m :: num, p :: num, n :: num):
           m <= p + (1 :: num) && p <= n
             ==> UNION(#{..}(m, p), #{..}(p + (1 :: num), n)) == #{..}(m, n)),
      (
        REWRITE_TAC(PairList [EXTENSION, IN_UNION, numseg, IN_ELIM_THM]) then_tac \
        ARITH_TAC
      )
    ]
  )

def NUMSEG_COMBINE_L:
  prove(
    [
      (hol:
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         const #{..} :: num -> num -> num -> bool
         forall (m :: num, p :: num, n :: num):
           m <= p && p <= n + (1 :: num)
             ==> UNION(#{..}(m, p - (1 :: num)), #{..}(p, n)) == #{..}(m, n)),
      (
        REWRITE_TAC(PairList [EXTENSION, IN_UNION, numseg, IN_ELIM_THM]) then_tac \
        ARITH_TAC
      )
    ]
  )

def NUMSEG_LREC:
  prove(
    [
      (hol:
         const INSERT :: A -> (A -> bool) -> A -> bool
         const #{..} :: num -> num -> num -> bool
         forall (m :: num, n :: num): m <= n ==> INSERT(m, #{..}(m + (1 :: num), n)) == #{..}(m, n)),
      (
        REWRITE_TAC(PairList [EXTENSION, IN_INSERT, numseg, IN_ELIM_THM]) then_tac \
        ARITH_TAC
      )
    ]
  )

def NUMSEG_RREC:
  prove(
    [
      (hol:
         const INSERT :: A -> (A -> bool) -> A -> bool
         const #{..} :: num -> num -> num -> bool
         forall (m :: num, n :: num): m <= n ==> INSERT(n, #{..}(m, n - (1 :: num))) == #{..}(m, n)),
      (
