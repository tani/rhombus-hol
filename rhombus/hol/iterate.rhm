def neutral:
  new_definition(
    (hol:
       var neutral :: (A -> A -> A) -> A
       var op :: A -> A -> A
       const #{@} :: (A -> bool) -> A
       neutral(op) == #{@}(fun (x :: A): forall y :: A: op(x, y) == y && op(y, x) == y))
  )

def monoidal:
  new_definition(
    (hol:
       var monoidal :: (A -> A -> A) -> bool
       var op :: A -> A -> A
       const neutral :: (A -> A -> A) -> A
       monoidal(op)
         <=> ((forall (x :: A, y :: A): op(x, y) == op(y, x))
                && ((forall (x :: A, y :: A, z :: A): op(x, op(y, z)) == op(op(x, y), z))
                      && (forall x :: A: op(neutral(op), x) == x))))
  )

def MONOIDAL_AC:
  prove(
    [
      (hol:
         const monoidal :: (A -> A -> A) -> bool
         const neutral :: (A -> A -> A) -> A
         forall op :: A -> A -> A:
           monoidal(op)
             ==> ((forall a :: A: op(neutral(op), a) == a)
                    && ((forall a :: A: op(a, neutral(op)) == a)
                          && ((forall (a :: A, b :: A): op(a, b) == op(b, a))
                                && ((forall (a :: A, b :: A, c :: A): op(op(a, b), c) == op(a, op(b, c)))
                                      && (forall (a :: A, b :: A, c :: A):
                                            op(a, op(b, c)) == op(b, op(a, c)))))))),
      (REWRITE_TAC(PairList [monoidal]) then_tac MESON_TAC(PairList []))
    ]
  )

def support:
  new_definition(
    (hol:
       var support :: (B -> B -> B) -> (A -> B) -> (A -> bool) -> A -> bool
       var op :: B -> B -> B
       var f :: A -> B
       var s :: A -> bool
       const GSPEC :: (A -> bool) -> A -> bool
       const SETSPEC :: A -> bool -> A -> bool
       const IN :: A -> (A -> bool) -> bool
       const neutral :: (A -> A -> A) -> A
       support(op, f, s)
         == GSPEC(
              fun (gen_pvar_239 :: A):
                exists x :: A: SETSPEC(gen_pvar_239, IN(x, s) && f(x) != neutral(op), x)
            ))
  )

def iterate:
  new_definition(
    (hol:
       var iterate :: (B -> B -> B) -> (A -> bool) -> (A -> B) -> B
       var op :: B -> B -> B
       var s :: A -> bool
       var f :: A -> B
       const FINITE :: (A -> bool) -> bool
       const support :: (B -> B -> B) -> (A -> B) -> (A -> bool) -> A -> bool
       const ITSET :: (A -> B -> B) -> (A -> bool) -> B -> B
       const neutral :: (A -> A -> A) -> A
       iterate(op, s, f)
         == (if FINITE(support(op, f, s))
             | ITSET(fun (x :: A, a :: B): op(f(x), a), support(op, f, s), neutral(op))
             | neutral(op)))
  )

def IN_SUPPORT:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const support :: (B -> B -> B) -> (A -> B) -> (A -> bool) -> A -> bool
         const neutral :: (A -> A -> A) -> A
         forall (op :: B -> B -> B, f :: A -> B, x :: A, s :: A -> bool):
           IN(x, support(op, f, s)) <=> IN(x, s) && f(x) != neutral(op)),
      REWRITE_TAC(PairList [support, IN_ELIM_THM])
    ]
  )

def SUPPORT_SUPPORT:
