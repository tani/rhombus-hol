      )
    ]
  )

def SUM_SUBSET:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
         const sum :: (A -> bool) -> (A -> real) -> real
         forall (u :: A -> bool, v :: A -> bool, f :: A -> real):
           (FINITE(u)
              && (FINITE(v)
                    && ((forall x :: A: IN(x, DIFF(u, v)) ==> f(x) <= (0 :: real))
                          && (forall x :: A: IN(x, DIFF(v, u)) ==> (0 :: real) <= f(x)))))
             ==> sum(u, f) <= sum(v, f)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(STRIP_TAC) then_tac \
                          MP_TAC(
                            ISPECL(
                              PairList [
                                (hol: var f :: A -> real; f),
                                (hol:
                                   var u :: A -> bool
                                   var v :: A -> bool
                                   const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
                                   INTER(u, v))
                              ])(
                              SUM_UNION
                            )
                          )
                        ) then_tac \
                        DISCH_THEN(
                          fun(th):
                            (
                              MP_TAC(
                                SPEC(
                                  (hol:
                                     var v :: A -> bool
                                     var u :: A -> bool
                                     const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                                     DIFF(v, u))
                                )(th)
                              ) then_tac \
                              MP_TAC(
                                SPEC(
                                  (hol:
                                     var u :: A -> bool
                                     var v :: A -> bool
                                     const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                                     DIFF(u, v))
                                )(th)
                              )
                            )
                        )
                      ) then_tac \
                      REWRITE_TAC(
                        PairList [
                          SET_RULE(
                            (hol:
                               var u :: #{?129729} -> bool
                               var v :: #{?129729} -> bool
                               const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
                               const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
                               const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                               UNION(INTER(u, v), DIFF(u, v)) == u)
                          ),
                          SET_RULE(
                            (hol:
                               var u :: #{?129716} -> bool
                               var v :: #{?129716} -> bool
                               const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
                               const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
                               const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                               UNION(INTER(u, v), DIFF(v, u)) == v)
                          )
                        ]
                      )
                    ) then_tac \
                    ASM_SIMP_TAC(PairList [FINITE_DIFF, FINITE_INTER])
                  ) then_tac \
                  REPEAT(
                    (
                      ANTS_TAC then_list \
                      PairList [SET_TAC(PairList []), DISCH_THEN(SUBST1_TAC)]
                    )
                  )
                ) then_tac \
                MATCH_MP_TAC(
                  REAL_ARITH(
                    (hol:
                       var x :: real
                       var y :: real
                       var a :: real
                       (0 :: real) <= -x && (0 :: real) <= y ==> a + x <= a + y)
                  )
                )
              ) then_tac \
              ASM_SIMP_TAC(PairList [GSYM(SUM_NEG), FINITE_DIFF])
            ) then_tac \
            CONJ_TAC
          ) then_tac \
