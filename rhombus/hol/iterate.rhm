def FINITE_INDEX_NUMSEG:
  prove(
    [
      Host.hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Iff(
          App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
          Exists(
            "f",
            Fun(Num, Tvar("A")),
            And(
              Forall(
                "i",
                Num,
                Forall(
                  "j",
                  Num,
                  Implies(
                    And(
                      App(
                        Const("IN", Fun(Num, Fun(Fun(Num, Bool), Bool))),
                        [
                          Ref("i"),
                          App(
                            Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                            [
                              App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                              App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")])
                            ]
                          )
                        ]
                      ),
                      And(
                        App(
                          Const("IN", Fun(Num, Fun(Fun(Num, Bool), Bool))),
                          [
                            Ref("j"),
                            App(
                              Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                              [
                                App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                                App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")])
                              ]
                            )
                          ]
                        ),
                        Eq(Tvar("A"), App(Ref("f"), [Ref("i")]), App(Ref("f"), [Ref("j")]))
                      )
                    ),
                    Eq(Num, Ref("i"), Ref("j"))
                  )
                )
              ),
              Eq(
                Fun(Tvar("A"), Bool),
                Ref("s"),
                App(
                  Const("IMAGE", Fun(Fun(Num, Tvar("A")), Fun(Fun(Num, Bool), Fun(Tvar("A"), Bool)))),
                  [
                    Ref("f"),
                    App(
                      Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                      [
                        App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                        App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")])
                      ]
                    )
                  ]
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (GEN_TAC then_tac EQ_TAC) then_list \
                PairList [DISCH_TAC, MESON_TAC(PairList [FINITE_IMAGE, FINITE_NUMSEG])]
              ) then_tac \
              MP_TAC(
                ISPECL(
                  PairList [
                    Host.hol_term(App(
                      Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                      [
                        App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                        App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Var("s", Fun(Tvar("A"), Bool))])
                      ]
