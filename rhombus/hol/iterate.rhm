def SUM_EQ_SUPERSET:
  prove(
    [
      (hol:
         var g :: A -> real
         const FINITE :: (A -> bool) -> bool
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const sum :: (A -> bool) -> (A -> real) -> real
         forall (f :: A -> real, s :: A -> bool, t :: A -> bool):
           (FINITE(t)
              && (SUBSET(t, s)
                    && ((forall x :: A: IN(x, t) ==> f(x) == g(x))
                          && (forall x :: A: IN(x, s) && !IN(x, t) ==> f(x) == (0 :: real)))))
             ==> sum(s, f) == sum(t, g)),
      MESON_TAC(PairList [SUM_SUPERSET, SUM_EQ])
    ]
  )

