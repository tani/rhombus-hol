def ITERATE_CLOSED:
  prove(
    [
      Host.hol_term(Forall(
        "op",
        Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))),
        Implies(
          App(Const("monoidal", Fun(Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))), Bool)), [Ref("op")]),
          Forall(
            "P",
            Fun(Tvar("B"), Bool),
            Implies(
              And(
                App(
                  Ref("P"),
                  [App(Const("neutral", Fun(Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))), Tvar("B"))), [Ref("op")])]
                ),
                Forall(
                  "x",
                  Tvar("B"),
                  Forall(
                    "y",
                    Tvar("B"),
                    Implies(
                      And(App(Ref("P"), [Ref("x")]), App(Ref("P"), [Ref("y")])),
                      App(Ref("P"), [App(Ref("op"), [Ref("x"), Ref("y")])])
                    )
                  )
                )
              ),
              Forall(
                "f",
                Fun(Tvar("A"), Tvar("B")),
                Forall(
                  "s",
                  Fun(Tvar("A"), Bool),
                  Implies(
                    Forall(
                      "x",
                      Tvar("A"),
                      Implies(
                        And(
                          App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                          Not(
                            Eq(
                              Tvar("B"),
                              App(Ref("f"), [Ref("x")]),
                              App(Const("neutral", Fun(Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))), Tvar("B"))), [Ref("op")])
                            )
                          )
                        ),
                        App(Ref("P"), [App(Ref("f"), [Ref("x")])])
                      )
                    ),
                    App(
                      Ref("P"),
                      [
                        App(
                          Const(
                            "iterate",
                            Fun(
                              Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))),
                              Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Tvar("B")))
                            )
                          ),
                          [Ref("op"), Ref("s"), Ref("f")]
                        )
                      ]
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REPEAT(STRIP_TAC) then_tac \
                        ONCE_REWRITE_TAC(PairList [ITERATE_EXPAND_CASES])
                      ) then_tac \
                      REPEAT(POP_ASSUM(MP_TAC))
                    ) then_tac \
                    REWRITE_TAC(PairList [GSYM(IN_SUPPORT)])
                  ) then_tac \
                  COND_CASES_TAC
                ) then_tac \
                ASM_SIMP_TAC(PairList [])
              ) then_tac \
              POP_ASSUM(MP_TAC)
            ) then_tac \
            SPEC_TAC(
              [
                Host.hol_term(App(
                  Const(
                    "support",
                    Fun(
                      Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))),
                      Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))
                    )
                  ),
                  [
                    Var("op", Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B")))),
                    Var("f", Fun(Tvar("A"), Tvar("B"))),
                    Var("s", Fun(Tvar("A"), Bool))
                  ]
                )),
                Host.hol_term(Var("s", Fun(Tvar("A"), Bool)))
              ]
            )
          ) then_tac \
          MATCH_MP_TAC(FINITE_INDUCT_STRONG)
        ) then_tac \
        ASM_SIMP_TAC(PairList [ITERATE_CLAUSES, FINITE_INSERT, IN_INSERT])
      )
    ]
  )

