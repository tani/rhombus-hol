                                                    EXISTS_TAC(hol: var a :: A; a),
                                                    EXISTS_TAC(hol: var b :: A; b)
                                                  ]
                                                ) then_tac \
                                                ASM(SET_TAC)(PairList [])
                                              ),
                                              ALL_TAC
                                            ]
                                          ) then_tac \
                                          INDUCT_TAC
                                        ) then_list \
                                        PairList [
                                          SIMP_TAC(
                                            PairList [HAS_SIZE_0, NUMSEG_CLAUSES, ARITH, IMAGE_CLAUSES, NOT_IN_EMPTY]
                                          ),
                                          ALL_TAC
                                        ]
                                      ) then_tac \
                                      REWRITE_TAC(PairList [HAS_SIZE_SUC])
                                    ) then_tac \
                                    X_GEN_TAC(hol: var s :: A -> bool; s)
                                  ) then_tac \
                                  STRIP_TAC
                                ) then_tac \
                                FIRST_X_ASSUM(
                                  o(MP_TAC)(
                                    SPECL(
                                      PairList [
                                        (hol:
                                           var n :: num
                                           const SUC :: num -> num
                                           SUC(n)),
                                        (hol: var s :: A -> bool; s)
                                      ]
                                    )
                                  )
                                )
                              ) then_tac \
                              ASM_REWRITE_TAC(PairList [HAS_SIZE_SUC])
                            ) then_tac \
                            DISCH_THEN(X_CHOOSE_THEN(hol: var a :: A; a)(MP_TAC))
                          ) then_tac \
                          STRIP_TAC
                        ) then_tac \
                        FIRST_X_ASSUM(
                          o(MP_TAC)(
                            SPEC(
                              (hol:
                                 var s :: A -> bool
                                 var a :: A
                                 const DELETE :: (A -> bool) -> A -> A -> bool
                                 DELETE(s, a))
                            )
