def REAL_OF_NUM_SUM_GEN:
  prove(
    [
      Host.hol_term(Forall(
        "f",
        Fun(Tvar("A"), Num),
        Forall(
          "s",
          Fun(Tvar("A"), Bool),
          Implies(
            App(
              Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)),
              [
                App(
                  Const("GSPEC", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool))),
                  [
                    Lambda(
                      "GEN%PVAR%335",
                      Tvar("A"),
                      Exists(
                        "i",
                        Tvar("A"),
                        App(
                          Const("SETSPEC", Fun(Tvar("A"), Fun(Bool, Fun(Tvar("A"), Bool)))),
                          [
                            Ref("GEN%PVAR%335"),
                            And(
                              App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("i"), Ref("s")]),
                              Not(
                                Eq(Num, App(Ref("f"), [Ref("i")]), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]))
                              )
                            ),
                            Ref("i")
                          ]
                        )
                      )
                    )
                  ]
                )
              ]
            ),
            Eq(
              Real,
              App(
                Const("real_of_num", Fun(Num, Real)),
                [
                  App(
                    Const("nsum", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Num), Num))),
                    [Ref("s"), Ref("f")]
                  )
                ]
              ),
              App(
                Const("sum", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Real), Real))),
                [
                  Ref("s"),
                  Lambda("x", Tvar("A"), App(Const("real_of_num", Fun(Num, Real)), [App(Ref("f"), [Ref("x")])]))
                ]
              )
            )
          )
        )
      )),
      (
        (
          (
            REPEAT(STRIP_TAC) then_tac \
            ONCE_REWRITE_TAC(PairList [GSYM(SUM_SUPPORT), GSYM(NSUM_SUPPORT)])
          ) then_tac \
          REWRITE_TAC(PairList [support, NEUTRAL_ADD, NEUTRAL_REAL_ADD, REAL_OF_NUM_EQ])
        ) then_tac \
        ASM_SIMP_TAC(PairList [REAL_OF_NUM_SUM])
      )
    ]
  )

