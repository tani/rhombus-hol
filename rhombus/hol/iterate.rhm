            (
              (
                (
                  (
                    (
                      REWRITE_TAC(
                        PairList [
                          ARITH_RULE(
                            (hol:
                               var n :: num
                               const SUC :: num -> num
                               (2 :: num) * SUC(n) + (1 :: num) == SUC(SUC((2 :: num) * n + (1 :: num))))
                          )
                        ]
                      ) then_tac \
                      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES_NUMSEG])
                    ) then_tac \
                    REWRITE_TAC(
                      PairList [
                        ARITH_RULE(
                          (hol:
                             var m :: num
                             var n :: num
                             const SUC :: num -> num
                             (2 :: num) * m <= SUC(SUC((2 :: num) * n + (1 :: num))) <=> m <= SUC(n))
                        ),
                        ARITH_RULE(
                          (hol:
                             var m :: num
                             var n :: num
                             const SUC :: num -> num
                             (2 :: num) * m <= SUC((2 :: num) * n + (1 :: num)) <=> m <= SUC(n))
                        )
                      ]
