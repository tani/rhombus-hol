             && ((forall (f :: num -> num, g :: num -> num, a :: num, b :: num):
                    (forall i :: num: a <= i && i <= b ==> f(i) == g(i))
                      ==> nsum(#{..}(a, b), fun (i :: num): f(i)) == nsum(#{..}(a, b), g))
                   && (forall (f :: #{?126371} -> num, g :: #{?126371} -> num, p :: #{?126371} -> bool):
                         (forall x :: #{?126371}: p(x) ==> f(x) == g(x))
