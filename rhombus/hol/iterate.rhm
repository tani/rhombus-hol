                  EXISTS_TAC(
                    (hol:
                       var op :: B -> B -> B
                       var f :: A -> B
                       var s :: A -> bool
                       var g :: A -> B
                       const iterate :: (B -> B -> B) -> (A -> bool) -> (A -> B) -> B
                       const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
                       const support :: (B -> B -> B) -> (A -> B) -> (A -> bool) -> A -> bool
                       iterate(op, UNION(support(op, f, s), support(op, g, s)), fun (x :: A): op(f(x), g(x))))
                  )
                ) then_tac \
                CONJ_TAC
              ) then_list \
              PairList [
                CONV_TAC(SYM_CONV),
                (ASM_SIMP_TAC(PairList [ITERATE_OP, FINITE_UNION]) then_tac BINOP_TAC)
              ]
            ) then_tac \
