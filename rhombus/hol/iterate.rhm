         const EMPTY :: A -> bool
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         const sum :: (A -> bool) -> (A -> real) -> real
         forall (s :: A -> bool, t :: A -> bool, u :: A -> bool):
           FINITE(u) && (INTER(s, t) == EMPTY && UNION(s, t) == u)
             ==> sum(s, f) + sum(t, f) == sum(u, f)),
