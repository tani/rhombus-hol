def EXPAND_SUM_CONV:
  let PairList [pth_0_4, & PairList [pth_1_4, & PairList [pth_2_4, & PairList []]]]:
    o(CONJUNCTS)(prove)(
      [
        (hol:
           var n :: num
           var m :: num
           var f :: num -> real
           const sum :: (A -> bool) -> (A -> real) -> real
           const #{..} :: num -> num -> num -> bool
           (n < m ==> sum(#{..}(m, n), f) == (0 :: real))
             && (sum(#{..}(m, m), f) == f(m)
                   && (m <= n ==> sum(#{..}(m, n), f) == f(m) + sum(#{..}(m + (1 :: num), n), f)))),
        REWRITE_TAC(PairList [SUM_CLAUSES_LEFT, SUM_SING_NUMSEG, SUM_TRIV_NUMSEG])
      ]
    )
  let ns_tm_4 = hol: const #{..} :: num -> num -> num -> bool; #{..}
  let f_tm_3 = hol: var f :: num -> real; f
  let m_tm_4 = hol: var m :: num; m
  let n_tm_4 = hol: var n :: num; n
  fun conv_2(tm):
    let [smn, ftm] = dest_comb(tm)
    let [s, mn] = dest_comb(smn)
    if !(is_const(s) && (fst(dest_const(s)) == "sum"))
    | failwith("EXPAND_SUM_CONV")
    | let [mtm, ntm] = dest_binop(ns_tm_4)(mn)
      let m_4 = dest_numeral(mtm)
      let n_4 = dest_numeral(ntm)
      if (n_4 < m_4)
      | let th1 = INST(PairList [[ftm, f_tm_3], [mtm, m_tm_4], [ntm, n_tm_4]])(pth_0_4)
        MP(th1)(EQT_ELIM(NUM_LT_CONV(lhand(concl(th1)))))
      | if (n_4 == m_4)
        | CONV_RULE(RAND_CONV(TRY_CONV(BETA_CONV)))(INST(PairList [[ftm, f_tm_3], [mtm, m_tm_4]])(pth_1_4))
        | let th1 = INST(PairList [[ftm, f_tm_3], [mtm, m_tm_4], [ntm, n_tm_4]])(pth_2_4)
          let th2 = MP(th1)(EQT_ELIM(NUM_LE_CONV(lhand(concl(th1)))))
          CONV_RULE(
            RAND_CONV(
              COMB2_CONV(RAND_CONV(TRY_CONV(BETA_CONV)))((LAND_CONV(LAND_CONV(NUM_ADD_CONV)) then_conv conv_2))
            )
          )(th2)
  conv_2

def REAL_SUB_POW:
  prove(
    [
      (hol:
         const real_pow :: real -> num -> real
         const sum :: (A -> bool) -> (A -> real) -> real
         const #{..} :: num -> num -> num -> bool
         forall (x :: real, y :: real, n :: num):
           (1 :: num) <= n
             ==> (real_pow(x, n) - real_pow(y, n)
                    == ((x - y)
                          * sum(
                              #{..}((0 :: num), n - (1 :: num)),
                              fun (i :: num): real_pow(x, i) * real_pow(y, n - (1 :: num) - i)
                            )))),
      (
        (
          (
            (
              REWRITE_TAC(PairList [GSYM(SUM_LMUL)]) then_tac \
              REWRITE_TAC(
                PairList [
                  REAL_ARITH(
                    (hol:
                       var x :: real
                       var y :: real
                       var a :: real
                       var b :: real
                       (x - y) * (a * b) == x * a * b - a * (y * b))
                  )
                ]
              )
            ) then_tac \
            SIMP_TAC(
              PairList [
                GSYM(real_pow),
                ADD1,
                ARITH_RULE(
                  (hol:
                     var n :: num
                     var x :: num
                     const SUC :: num -> num
                     (1 :: num) <= n && x <= n - (1 :: num)
                       ==> n - (1 :: num) - x == n - (x + (1 :: num)) && SUC(n - (1 :: num) - x) == n - x)
                )
              ]
            )
          ) then_tac \
          REWRITE_TAC(PairList [SUM_DIFFS_ALT, LE_0])
        ) then_tac \
        SIMP_TAC(
          PairList [
            SUB_0,
            SUB_ADD,
            SUB_REFL,
            real_pow,
            REAL_MUL_LID,
            REAL_MUL_RID
          ]
        )
      )
    ]
  )

