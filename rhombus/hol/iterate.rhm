Host.parse_as_infix(["..", [15, "right"]])

def numseg:
  new_definition(
    @hol|{m..n = {x:num | m <= x /\ x <= n}}|
  )

def FINITE_NUMSEG:
  prove(
    [
      @hol|{!m n. FINITE(m..n)}|,
      REPEAT(GEN_TAC) then_tac MATCH_MP_TAC(FINITE_SUBSET) then_tac \
      EXISTS_TAC(
        @hol|{{x:num | x <= n}}|
      ) then_tac \
      REWRITE_TAC(PairList [FINITE_NUMSEG_LE]) then_tac \
      SIMP_TAC(PairList [SUBSET, IN_ELIM_THM, numseg])
    ]
  )

def NUMSEG_COMBINE_R:
  prove(
    [
      @hol|{!m p n. m <= p + 1 /\ p <= n ==> ((m..p) UNION ((p+1)..n) = m..n)}|,
      REWRITE_TAC(PairList [EXTENSION, IN_UNION, numseg, IN_ELIM_THM]) then_tac \
      ARITH_TAC
    ]
  )

def NUMSEG_COMBINE_L:
  prove(
    [
      @hol|{!m p n. m <= p /\ p <= n + 1 ==> ((m..(p-1)) UNION (p..n) = m..n)}|,
      REWRITE_TAC(PairList [EXTENSION, IN_UNION, numseg, IN_ELIM_THM]) then_tac \
      ARITH_TAC
    ]
  )

def NUMSEG_LREC:
  prove(
    [
      @hol|{!m n. m <= n ==> (m INSERT ((m+1)..n) = m..n)}|,
      REWRITE_TAC(PairList [EXTENSION, IN_INSERT, numseg, IN_ELIM_THM]) then_tac \
      ARITH_TAC
    ]
  )

def NUMSEG_RREC:
  prove(
    [
      @hol|{!m n. m <= n ==> (n INSERT (m..(n-1)) = m..n)}|,
      REWRITE_TAC(PairList [EXTENSION, IN_INSERT, numseg, IN_ELIM_THM]) then_tac \
      ARITH_TAC
    ]
  )

def NUMSEG_REC:
  prove(
    [
      @hol|{!m n. m <= SUC n ==> (m..SUC n = (SUC n) INSERT (m..n))}|,
      SIMP_TAC(PairList [GSYM(NUMSEG_RREC), SUC_SUB1])
    ]
  )

def IN_NUMSEG:
  prove(
    [
      @hol|{!m n p. p IN (m..n) <=> m <= p /\ p <= n}|,
      REWRITE_TAC(PairList [numseg, IN_ELIM_THM])
    ]
  )

def IN_NUMSEG_0:
  prove(
    [
      @hol|{!m n. m IN (0..n) <=> m <= n}|,
      REWRITE_TAC(PairList [IN_NUMSEG, LE_0])
    ]
  )

def NUMSEG_SING:
  prove(
    [
      @hol|{!n. n..n = {n}}|,
      REWRITE_TAC(PairList [EXTENSION, IN_SING, IN_NUMSEG]) then_tac ARITH_TAC
    ]
  )

def NUMSEG_EMPTY:
  prove(
    [
      @hol|{!m n. (m..n = {}) <=> n < m}|,
      REWRITE_TAC(PairList [EXTENSION, NOT_IN_EMPTY, IN_NUMSEG]) then_tac \
      MESON_TAC(PairList [NOT_LE, LE_TRANS, LE_REFL])
    ]
  )

def EMPTY_NUMSEG:
  prove(
    [
      @hol|{!m n. n < m ==> m..n = {}}|,
      REWRITE_TAC(PairList [NUMSEG_EMPTY])
    ]
  )

def FINITE_SUBSET_NUMSEG:
  prove(
    [
      @hol|{!s:num->bool. FINITE s <=> ?n. s SUBSET 0..n}|,
      GEN_TAC then_tac EQ_TAC then_list \
      PairList [
        REWRITE_TAC(PairList [SUBSET, IN_NUMSEG, LE_0]) then_tac \
        SPEC_TAC([@hol|{s:num->bool}|, @hol|{s:num->bool}|]) then_tac \
        MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
        REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY]) then_tac \
        MESON_TAC(PairList [LE_CASES, LE_REFL, LE_TRANS]),
        MESON_TAC(PairList [FINITE_SUBSET, FINITE_NUMSEG])
      ]
    ]
  )

def CARD_NUMSEG_LEMMA:
  prove(
    [
      @hol|{!m d. CARD(m..(m+d)) = d + 1}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_SIMP_TAC(
        PairList [
          ADD_CLAUSES,
          NUMSEG_REC,
          NUMSEG_SING,
          FINITE_RULES,
          ARITH_RULE(
            @hol|{m <= SUC(m + d)}|
          ),
          CARD_CLAUSES,
          FINITE_NUMSEG,
          NOT_IN_EMPTY,
          ARITH,
          IN_NUMSEG,
          ARITH_RULE(
            @hol|{~(SUC n <= n)}|
          )
        ]
      )
    ]
  )

def CARD_NUMSEG:
  prove(
    [
      @hol|{!m n. CARD(m..n) = (n + 1) - m}|,
      REPEAT(GEN_TAC) then_tac \
      DISJ_CASES_THEN(MP_TAC)(
        ARITH_RULE(
          @hol|{n:num < m \/ m <= n}|
        )
      ) then_list \
      PairList [
        ASM_MESON_TAC(
          PairList [
            NUMSEG_EMPTY,
            CARD_CLAUSES,
            ARITH_RULE(
              @hol|{n < m ==> ((n + 1) - m = 0)}|
            )
          ]
        ),
        SIMP_TAC(PairList [LE_EXISTS, LEFT_IMP_EXISTS_THM, CARD_NUMSEG_LEMMA]) then_tac \
        REPEAT(STRIP_TAC) then_tac \
        ARITH_TAC
      ]
    ]
  )

def HAS_SIZE_NUMSEG:
  prove(
    [
      @hol|{!m n. (m..n) HAS_SIZE ((n + 1) - m)}|,
      REWRITE_TAC(PairList [HAS_SIZE, FINITE_NUMSEG, CARD_NUMSEG])
    ]
  )

def CARD_NUMSEG_1:
  prove(
    [
      @hol|{!n. CARD(1..n) = n}|,
      REWRITE_TAC(PairList [CARD_NUMSEG]) then_tac ARITH_TAC
    ]
  )

def HAS_SIZE_NUMSEG_1:
  prove(
    [
      @hol|{!n. (1..n) HAS_SIZE n}|,
      REWRITE_TAC(PairList [CARD_NUMSEG, HAS_SIZE, FINITE_NUMSEG]) then_tac ARITH_TAC
    ]
  )

def NUMSEG_CLAUSES:
  prove(
    [
      @hol|{(!m. m..0 = if m = 0 then {0} else {}) /\
         (!m n. m..SUC n = if m <= SUC n then (SUC n) INSERT (m..n) else m..n)}|,
      REPEAT(STRIP_TAC) then_tac COND_CASES_TAC then_tac \
      GEN_REWRITE_TAC(I)(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [IN_NUMSEG, NOT_IN_EMPTY, IN_INSERT]) then_tac \
      POP_ASSUM(MP_TAC) then_tac \
      ARITH_TAC
    ]
  )

def FINITE_INDEX_NUMSEG:
  prove(
    [
      @hol|{!s:A->bool.
         FINITE s <=>
         ?f. (!i j. i IN 1..CARD s /\ j IN 1..CARD s /\ f i = f j ==> i = j) /\
             s = IMAGE f (1..CARD s)}|,
      GEN_TAC then_tac EQ_TAC then_list \
      PairList [DISCH_TAC, MESON_TAC(PairList [FINITE_IMAGE, FINITE_NUMSEG])] then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{1..CARD(s:A->bool)}|,
            @hol|{s:A->bool}|
          ])(
          CARD_EQ_BIJECTIONS
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [FINITE_NUMSEG, CARD_NUMSEG_1]) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      SET_TAC(PairList [])
    ]
  )

def FINITE_INDEX_NUMBERS:
  prove(
    [
      @hol|{!s:A->bool.
         FINITE s <=>
         ?k:num->bool f. (!i j. i IN k /\ j IN k /\ f i = f j ==> i = j) /\
                         FINITE k /\ s = IMAGE f k}|,
      MESON_TAC(PairList [FINITE_INDEX_NUMSEG, FINITE_NUMSEG, FINITE_IMAGE])
    ]
  )

def INTER_NUMSEG:
  prove(
    [
      @hol|{!m n p q. (m..n) INTER (p..q) = (MAX m p)..(MIN n q)}|,
      REWRITE_TAC(PairList [EXTENSION, IN_INTER, IN_NUMSEG]) then_tac ARITH_TAC
    ]
  )

def DISJOINT_NUMSEG:
  prove(
    [
      @hol|{!m n p q. DISJOINT (m..n) (p..q) <=> n < p \/ q < m \/ n < m \/ q < p}|,
      REWRITE_TAC(PairList [DISJOINT, NUMSEG_EMPTY, INTER_NUMSEG]) then_tac ARITH_TAC
    ]
  )

def NUMSEG_ADD_SPLIT:
  prove(
    [
      @hol|{!m n p. m <= n + 1 ==> (m..(n+p) = (m..n) UNION (n+1..n+p))}|,
      REWRITE_TAC(PairList [EXTENSION, IN_UNION, IN_NUMSEG]) then_tac ARITH_TAC
    ]
  )

def NUMSEG_OFFSET_IMAGE:
  prove(
    [
      @hol|{!m n p. (m+p..n+p) = IMAGE (\i. i + p) (m..n)}|,
      REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, IN_NUMSEG]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      EQ_TAC then_list \
      PairList [
        DISCH_THEN(
          fun(th):
            (
              EXISTS_TAC(@hol|{x - p:num}|) then_tac \
              MP_TAC(th)
            )
        ),
        ALL_TAC
      ] then_tac \
      ARITH_TAC
    ]
  )

def SUBSET_NUMSEG:
  prove(
    [
      @hol|{!m n p q. (m..n) SUBSET (p..q) <=> n < m \/ p <= m /\ n <= q}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [SUBSET, IN_NUMSEG]) then_tac \
      EQ_TAC then_list \
      PairList [
        MESON_TAC(PairList [LE_TRANS, NOT_LE, LE_REFL]),
        ARITH_TAC
      ]
    ]
  )

def NUMSEG_LE:
  prove(
    [
      @hol|{!n. {x | x <= n} = 0..n}|,
      REWRITE_TAC(PairList [EXTENSION, IN_NUMSEG, IN_ELIM_THM]) then_tac \
      ARITH_TAC
    ]
  )

def NUMSEG_LT:
  prove(
    [
      @hol|{!n. {x | x < n} = if n = 0 then {} else 0..(n-1)}|,
      GEN_TAC then_tac COND_CASES_TAC then_tac \
      REWRITE_TAC(PairList [EXTENSION, IN_NUMSEG, IN_ELIM_THM, NOT_IN_EMPTY]) then_tac \
      ASM_ARITH_TAC
    ]
  )

def NUMSEG_CONV:
  let pth_0:
    MESON(
      PairList [NUMSEG_EMPTY])(
      @hol|{n < m ==> m..n = {}}|
    )
  let pth_1:
    MESON(
      PairList [NUMSEG_SING])(
      @hol|{m..m = {m}}|
    )
  let pth_2:
    MESON(
      PairList [NUMSEG_LREC, ADD1])(
      @hol|{m <= n ==> m..n = m INSERT (SUC m..n)}|
    )
  let ns_tm = @hol|{(..)}|
  let m_tm = @hol|{m:num}|
  let n_tm = @hol|{n:num}|
  fun NUMSEG_CONV(tm):
    let [nstm, nt] = dest_comb(tm)
    let [nst, mt] = dest_comb(nstm)
    if (nst != ns_tm)
    | failwith("NUMSEG_CONV")
    | let m = dest_numeral(mt)
      let n = dest_numeral(nt)
      if (n < m)
      | MP_CONV(NUM_LT_CONV)(INST(PairList [[mt, m_tm], [nt, n_tm]])(pth_0))
      | if (n == m)
        | INST(PairList [[mt, m_tm]])(pth_1)
        | let th = MP_CONV(NUM_LE_CONV)(INST(PairList [[mt, m_tm], [nt, n_tm]])(pth_2))
          CONV_RULE(funpow(2)(RAND_CONV)(LAND_CONV(NUM_SUC_CONV) then_conv NUMSEG_CONV))(th)
  NUMSEG_CONV

def TOPOLOGICAL_SORT:
  prove(
    [
      @hol|{!(<<). (!x y:A. x << y /\ y << x ==> x = y) /\
         (!x y z. x << y /\ y << z ==> x << z)
         ==> !n s. s HAS_SIZE n
                   ==> ?f. s = IMAGE f (1..n) /\
                           (!j k. j IN 1..n /\ k IN 1..n /\ j < k
                                  ==> ~(f k << f j))}|,
      GEN_TAC then_tac DISCH_TAC then_tac \
      SUBGOAL_THEN(
        @hol|{!n s. s HAS_SIZE n /\ ~(s = {})
           ==> ?a:A. a IN s /\ !b. b IN (s DELETE a) ==> ~(b << a)}|
      )(ASSUME_TAC) then_list \
      PairList [
        INDUCT_TAC then_tac \
        REWRITE_TAC(
          PairList [
            HAS_SIZE_0,
            HAS_SIZE_SUC,
            TAUT(@hol|{~(a /\ ~a)}|)
          ]
        ) then_tac \
        X_GEN_TAC(@hol|{s:A->bool}|) then_tac \
        STRIP_TAC then_tac \
        FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [GSYM(MEMBER_NOT_EMPTY)]))) then_tac \
        DISCH_THEN(X_CHOOSE_TAC(@hol|{a:A}|)) then_tac \
        FIRST_X_ASSUM(o(MP_TAC)(SPEC(@hol|{a:A}|))) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        DISCH_TAC then_tac \
        FIRST_X_ASSUM(
          o(MP_TAC)(
            SPEC(
              @hol|{s DELETE (a:A)}|
            )
          )
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            SET_RULE(
              @hol|{a IN s ==> (s DELETE a = {} <=> s = {a})}|
            )
          ]
        ) then_tac \
        ASM_CASES_TAC(
          @hol|{s = {a:A}}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList []) then_list \
        PairList [
          EXISTS_TAC(@hol|{a:A}|) then_tac SET_TAC(PairList []),
          ALL_TAC
        ] then_tac \
        DISCH_THEN(X_CHOOSE_THEN(@hol|{b:A}|)(STRIP_ASSUME_TAC)) then_tac \
        ASM_CASES_TAC(
          @hol|{((a:A) << (b:A)) :bool}|
        ) then_list \
        PairList [
          EXISTS_TAC(@hol|{a:A}|),
          EXISTS_TAC(@hol|{b:A}|)
        ] then_tac \
        ASM(SET_TAC)(PairList []),
        ALL_TAC
      ] then_tac \
      INDUCT_TAC then_list \
      PairList [
        SIMP_TAC(
          PairList [HAS_SIZE_0, NUMSEG_CLAUSES, ARITH, IMAGE_CLAUSES, NOT_IN_EMPTY]
        ),
        ALL_TAC
      ] then_tac \
      REWRITE_TAC(PairList [HAS_SIZE_SUC]) then_tac \
      X_GEN_TAC(@hol|{s:A->bool}|) then_tac \
      STRIP_TAC then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPECL(
            PairList [
              @hol|{SUC n}|,
              @hol|{s:A->bool}|
            ]
          )
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [HAS_SIZE_SUC]) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{a:A}|)(MP_TAC)) then_tac \
      STRIP_TAC then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPEC(
            @hol|{s DELETE (a:A)}|
          )
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList []) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{f:num->A}|)(STRIP_ASSUME_TAC)) then_tac \
      EXISTS_TAC(
        @hol|{\k. if k = 1 then a:A else f(k - 1)}|
      ) then_tac \
      SIMP_TAC(
        PairList [
          ARITH_RULE(
            @hol|{1 <= k ==> ~(SUC k = 1)}|
          ),
          SUC_SUB1
        ]
      ) then_tac \
      SUBGOAL_THEN(
        @hol|{!i. i IN 1..SUC n <=> i = 1 \/ 1 < i /\ (i - 1) IN 1..n}|
      )((fun(th): REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, th]))) then_list \
      PairList [REWRITE_TAC(PairList [IN_NUMSEG]) then_tac ARITH_TAC, ALL_TAC] then_tac \
      CONJ_TAC then_list \
      PairList [
        X_GEN_TAC(@hol|{b:A}|) then_tac \
        ASM_CASES_TAC(@hol|{b:A = a}|) then_list \
        PairList [ASM_MESON_TAC(PairList []), ALL_TAC] then_tac \
        FIRST_ASSUM(
          fun(th):
            ONCE_REWRITE_TAC(
              PairList [
                MATCH_MP(
                  SET_RULE(
                    @hol|{~(b = a) ==> (b IN s <=> b IN (s DELETE a))}|
                  )
                )(th)
              ]
            )
        ) then_tac \
        ONCE_REWRITE_TAC(PairList [COND_RAND]) then_tac \
        ASM_REWRITE_TAC(PairList [IN_IMAGE, IN_NUMSEG]) then_tac \
        EQ_TAC then_list \
        PairList [ALL_TAC, MESON_TAC(PairList [])] then_tac \
        DISCH_THEN(X_CHOOSE_TAC(@hol|{i:num}|)) then_tac \
        EXISTS_TAC(
          @hol|{i + 1}|
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            ARITH_RULE(
              @hol|{1 <= x ==> 1 < x + 1 /\ ~(x + 1 = 1)}|
            ),
            ADD_SUB
          ]
        ),
        MAP_EVERY(X_GEN_TAC)(PairList [@hol|{j:num}|, @hol|{k:num}|]) then_tac \
        MAP_EVERY(ASM_CASES_TAC)(
          PairList [
            @hol|{j = 1}|,
            @hol|{k = 1}|
          ]
        ) then_tac \
        ASM_REWRITE_TAC(PairList [LT_REFL]) then_list \
        PairList [
          STRIP_TAC then_tac FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
          ASM(SET_TAC)(PairList []),
          ARITH_TAC,
          STRIP_TAC then_tac FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
          ASM_REWRITE_TAC(PairList []) then_tac \
          ASM_ARITH_TAC
        ]
      ]
    ]
  )

def FINITE_INT_SEG:
  prove(
    [
      @hol|{(!l r. FINITE {x:int | l <= x /\ x <= r}) /\
         (!l r. FINITE {x:int | l <= x /\ x < r}) /\
         (!l r. FINITE {x:int | l < x /\ x <= r}) /\
         (!l r. FINITE {x:int | l < x /\ x < r})}|,
      MATCH_MP_TAC(
        TAUT(
          @hol|{(a ==> b) /\ a ==> a /\ b}|
        )
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        DISCH_TAC then_tac REPEAT(CONJ_TAC) then_tac \
        POP_ASSUM(MP_TAC) then_tac \
        REPEAT(MATCH_MP_TAC(MONO_FORALL) then_tac GEN_TAC) then_tac \
        MATCH_MP_TAC(REWRITE_RULE(PairList [IMP_CONJ_ALT])(FINITE_SUBSET)) then_tac \
        REWRITE_TAC(PairList [SUBSET, IN_ELIM_THM]) then_tac \
        INT_ARITH_TAC,
        REPEAT(GEN_TAC) then_tac \
        ASM_CASES_TAC(
          @hol|{&0:int <= r - l}|
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            INT_ARITH(
              @hol|{~(&0 <= r - l:int) ==> ~(l <= x /\ x <= r)}|
            )
          ]
        ) then_tac \
        ASM_SIMP_TAC(PairList [EMPTY_GSPEC, FINITE_EMPTY]) then_tac \
        MATCH_MP_TAC(FINITE_SUBSET) then_tac \
        EXISTS_TAC(
          @hol|{IMAGE (\n. l + &n) (0..num_of_int(r - l))}|
        ) then_tac \
        ASM_SIMP_TAC(PairList [FINITE_IMAGE, FINITE_NUMSEG]) then_tac \
        REWRITE_TAC(PairList [SUBSET, IN_IMAGE, IN_ELIM_THM]) then_tac \
        REWRITE_TAC(PairList [GSYM(INT_OF_NUM_LE), IN_NUMSEG]) then_tac \
        X_GEN_TAC(@hol|{x:int}|) then_tac \
        STRIP_TAC then_tac \
        EXISTS_TAC(
          @hol|{num_of_int(x - l)}|
        ) then_tac \
        ASM_SIMP_TAC(PairList [INT_OF_NUM_OF_INT, INT_SUB_LE]) then_tac \
        ASM_INT_ARITH_TAC
      ]
    ]
  )

def neutral:
  new_definition(
    @hol|{neutral op = @x:A. !y. (op x y = y) /\ (op y x = y)}|
  )

def monoidal:
  new_definition(
    @hol|{monoidal op <=> (!x y. op x y = op y x) /\
       (!x y z. op x (op y z) = op (op x y) z) /\
       (!x:A. op (neutral op) x = x)}|
  )

def MONOIDAL_AC:
  prove(
    [
      @hol|{!op. monoidal op
         ==> (!a:A. op (neutral op) a = a) /\
             (!a. op a (neutral op) = a) /\
             (!a b. op a b = op b a) /\
             (!a b c. op (op a b) c = op a (op b c)) /\
             (!a b c. op a (op b c) = op b (op a c))}|,
      REWRITE_TAC(PairList [monoidal]) then_tac MESON_TAC(PairList [])
    ]
  )

def support:
  new_definition(
    @hol|{support op (f:A->B) s = {x | x IN s /\ ~(f x = neutral op)}}|
  )

def iterate:
  new_definition(
    @hol|{iterate op s (f:A->B) =
       if FINITE(support op f s)
       then ITSET (\x a. op (f x) a) (support op f s) (neutral op)
       else neutral op}|
  )

def IN_SUPPORT:
  prove(
    [
      @hol|{!op (f:A->B) x s. x IN (support op f s) <=> x IN s /\ ~(f x = neutral op)}|,
      REWRITE_TAC(PairList [support, IN_ELIM_THM])
    ]
  )

def SUPPORT_SUPPORT:
  prove(
    [
      @hol|{!op (f:A->B) s. support op f (support op f s) = support op f s}|,
      REWRITE_TAC(PairList [support, IN_ELIM_THM, EXTENSION]) then_tac \
      REWRITE_TAC(PairList [CONJ_ACI])
    ]
  )

def SUPPORT_EMPTY:
  prove(
    [
      @hol|{!op (f:A->B) s. (!x. x IN s ==> f(x) = neutral op) <=> support op f s = {}}|,
      REWRITE_TAC(PairList [IN_SUPPORT, EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def SUPPORT_SUBSET:
  prove(
    [
      @hol|{!op (f:A->B) s. (support op f s) SUBSET s}|,
      SIMP_TAC(PairList [SUBSET, IN_SUPPORT])
    ]
  )

def FINITE_SUPPORT:
  prove(
    [
      @hol|{!op (f:A->B) s. FINITE s ==> FINITE(support op f s)}|,
      MESON_TAC(PairList [SUPPORT_SUBSET, FINITE_SUBSET])
    ]
  )

def SUPPORT_CLAUSES:
  prove(
    [
      @hol|{(!(f:A->C). support op f {} = {}) /\
         (!(f:A->C) x s. support op f (x INSERT s) =
              if f(x) = neutral op then support op f s
              else x INSERT (support op f s)) /\
         (!(f:A->C) x s. support op f (s DELETE x) = (support op f s) DELETE x) /\
         (!(f:A->C) s t. support op f (s UNION t) =
                         (support op f s) UNION (support op f t)) /\
         (!(f:A->C) s t. support op f (s INTER t) =
                         (support op f s) INTER (support op f t)) /\
         (!(f:A->C) s t. support op f (s DIFF t) =
                         (support op f s) DIFF (support op f t)) /\
         (!(f:A->B) (g:B->C) s.
                         support op g (IMAGE f s) = IMAGE f (support op (g o f) s))}|,
      REWRITE_TAC(
        PairList [
          support,
          EXTENSION,
          IN_ELIM_THM,
          IN_INSERT,
          IN_DELETE,
          o_THM,
          IN_IMAGE,
          NOT_IN_EMPTY,
          IN_UNION,
          IN_INTER,
          IN_DIFF,
          COND_RAND
        ]
      ) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      TRY(COND_CASES_TAC) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def SUPPORT_DELTA:
  prove(
    [
      @hol|{!op s (f:A->B) a.
         support op (\x. if x = a then f(x) else neutral op) s =
         if a IN s then support op f {a} else {}}|,
      REWRITE_TAC(PairList [EXTENSION, support, IN_ELIM_THM, IN_SING]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      REPEAT(COND_CASES_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [IN_ELIM_THM, NOT_IN_EMPTY])
    ]
  )

def FINITE_SUPPORT_DELTA:
  prove(
    [
      @hol|{!op (f:A->B) a.
         FINITE(support op (\x. if x = a then f(x) else neutral op) s)}|,
      REWRITE_TAC(PairList [SUPPORT_DELTA]) then_tac REPEAT(GEN_TAC) then_tac \
      COND_CASES_TAC then_tac \
      SIMP_TAC(PairList [FINITE_RULES, FINITE_SUPPORT])
    ]
  )

def ITERATE_SUPPORT:
  prove(
    [
      @hol|{!op (f:A->B) s. iterate op (support op f s) f = iterate op s f}|,
      SIMP_TAC(PairList [iterate, SUPPORT_SUPPORT])
    ]
  )

def ITERATE_EXPAND_CASES:
  prove(
    [
      @hol|{!op (f:A->B) s.
         iterate op s f =
         if FINITE(support op f s) then iterate op (support op f s) f
         else neutral op}|,
      SIMP_TAC(PairList [iterate, SUPPORT_SUPPORT])
    ]
  )

def ITERATE_CLAUSES_GEN:
  prove(
    [
      @hol|{!op. monoidal op
         ==> (!(f:A->B). iterate op {} f = neutral op) /\
             (!f x s. FINITE(support op (f:A->B) s)
                      ==> (iterate op (x INSERT s) f =
                                 if x IN s then iterate op s f
                                 else op (f x) (iterate op s f)))}|,
      GEN_TAC then_tac STRIP_TAC then_tac \
      ONCE_REWRITE_TAC(PairList [AND_FORALL_THM]) then_tac \
      GEN_TAC then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{\x a. (op:B->B->B) ((f:A->B)(x)) a}|,
            @hol|{neutral op :B}|
          ])(
          FINITE_RECURSION
        )
      ) then_tac \
      ANTS_TAC then_list \
      PairList [ASM_MESON_TAC(PairList [monoidal]), ALL_TAC] then_tac \
      REPEAT(STRIP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [iterate, SUPPORT_CLAUSES, FINITE_RULES]) then_tac \
      GEN_REWRITE_TAC(o(o(LAND_CONV)(RATOR_CONV))(LAND_CONV))(PairList [COND_RAND]) then_tac \
      ASM_REWRITE_TAC(PairList [SUPPORT_CLAUSES, FINITE_INSERT, COND_ID]) then_tac \
      ASM_CASES_TAC(
        @hol|{(f:A->B) x = neutral op}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [IN_SUPPORT]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_MESON_TAC(PairList [monoidal])
    ]
  )

def ITERATE_CLAUSES:
  prove(
    [
      @hol|{!op. monoidal op
         ==> (!(f:A->C). iterate op {} f = neutral op) /\
             (!(f:B->C) x s.
                 FINITE(s)
                 ==> (iterate op (x INSERT s) f =
                      if x IN s then iterate op s f
                      else op (f x) (iterate op s f)))}|,
      SIMP_TAC(PairList [ITERATE_CLAUSES_GEN, FINITE_SUPPORT])
    ]
  )

def ITERATE_UNION:
  let lemma:
    prove(
      [
        @hol|{(s UNION (x INSERT t) = x INSERT (s UNION t)) /\
           (DISJOINT s (x INSERT t) <=> ~(x IN s) /\ DISJOINT s t)}|,
        SET_TAC(PairList [])
      ]
    )
  prove(
    [
      @hol|{!op. monoidal op
         ==> !(f:A->B) s t.
                 FINITE s /\ FINITE t /\ DISJOINT s t
                 ==> (iterate op (s UNION t) f =
                      op (iterate op s f) (iterate op t f))}|,
      GEN_TAC then_tac DISCH_TAC then_tac GEN_TAC then_tac GEN_TAC then_tac \
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      REPEAT(DISCH_TAC) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      ASM_SIMP_TAC(
        PairList [
          ITERATE_CLAUSES,
          IN_UNION,
          UNION_EMPTY,
          REAL_ADD_RID,
          lemma,
          FINITE_UNION
        ]
      ) then_tac \
      ASM_MESON_TAC(PairList [monoidal])
    ]
  )

def ITERATE_UNION_GEN:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !(f:A->B) s t. FINITE(support op f s) /\ FINITE(support op f t) /\
                            DISJOINT (support op f s) (support op f t)
                            ==> (iterate op (s UNION t) f =
                                 op (iterate op s f) (iterate op t f))}|,
      ONCE_REWRITE_TAC(PairList [GSYM(ITERATE_SUPPORT)]) then_tac \
      SIMP_TAC(PairList [SUPPORT_CLAUSES, ITERATE_UNION])
    ]
  )

def ITERATE_DIFF:
  let lemma:
    prove(
      [
        @hol|{t SUBSET s ==> (s = (s DIFF t) UNION t) /\ DISJOINT (s DIFF t) t}|,
        SET_TAC(PairList [])
      ]
    )
  prove(
    [
      @hol|{!op. monoidal op
         ==> !(f:A->B) s t.
                 FINITE s /\ t SUBSET s
                 ==> (op (iterate op (s DIFF t) f) (iterate op t f) =
                      iterate op s f)}|,
      MESON_TAC(PairList [lemma, ITERATE_UNION, FINITE_UNION, FINITE_SUBSET, SUBSET_DIFF])
    ]
  )

def ITERATE_DIFF_GEN:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f:A->B s t. FINITE (support op f s) /\
                          (support op f t) SUBSET (support op f s)
                          ==> (op (iterate op (s DIFF t) f) (iterate op t f) =
                               iterate op s f)}|,
      ONCE_REWRITE_TAC(PairList [GSYM(ITERATE_SUPPORT)]) then_tac \
      SIMP_TAC(PairList [SUPPORT_CLAUSES, ITERATE_DIFF])
    ]
  )

def ITERATE_INCL_EXCL:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !s t (f:A->B).
                 FINITE s /\ FINITE t
                 ==> op (iterate op s f) (iterate op t f) =
                     op (iterate op (s UNION t) f)
                        (iterate op (s INTER t) f)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{a UNION b = ((a DIFF b) UNION (b DIFF a)) UNION (a INTER b)}|
          )
        ]
      ) then_tac \
      GEN_REWRITE_TAC(o(o(LAND_CONV)(LAND_CONV))(ONCE_DEPTH_CONV))(
        PairList [
          SET_RULE(
            @hol|{s:A->bool = s DIFF t UNION s INTER t}|
          )
        ]
      ) then_tac \
      GEN_REWRITE_TAC(o(o(LAND_CONV)(RAND_CONV))(ONCE_DEPTH_CONV))(
        PairList [
          SET_RULE(
            @hol|{t:A->bool = t DIFF s UNION s INTER t}|
          )
        ]
      ) then_tac \
      ASM_SIMP_TAC(
        PairList [
          ITERATE_UNION,
          FINITE_UNION,
          FINITE_DIFF,
          FINITE_INTER,
          SET_RULE(
            @hol|{DISJOINT (s DIFF s' UNION s' DIFF s) (s INTER s')}|
          ),
          SET_RULE(
            @hol|{DISJOINT (s DIFF s') (s' DIFF s)}|
          ),
          SET_RULE(
            @hol|{DISJOINT (s DIFF s') (s' INTER s)}|
          ),
          SET_RULE(
            @hol|{DISJOINT (s DIFF s') (s INTER s')}|
          )
        ]
      ) then_tac \
      FIRST_X_ASSUM((fun(th): REWRITE_TAC(PairList [MATCH_MP(MONOIDAL_AC)(th)])))
    ]
  )

def ITERATE_CLOSED:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !P. P(neutral op) /\ (!x y. P x /\ P y ==> P (op x y))
                 ==> !f:A->B s. (!x. x IN s /\ ~(f x = neutral op) ==> P(f x))
                                ==> P(iterate op s f)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [ITERATE_EXPAND_CASES]) then_tac \
      REPEAT(POP_ASSUM(MP_TAC)) then_tac \
      REWRITE_TAC(PairList [GSYM(IN_SUPPORT)]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList []) then_tac \
      POP_ASSUM(MP_TAC) then_tac \
      SPEC_TAC(
        [
          @hol|{support op (f:A->B) s}|,
          @hol|{s:A->bool}|
        ]
      ) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES, FINITE_INSERT, IN_INSERT])
    ]
  )

def ITERATE_RELATED:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !R. R (neutral op) (neutral op) /\
                 (!x1 y1 x2 y2. R x1 x2 /\ R y1 y2 ==> R (op x1 y1) (op x2 y2))
                 ==> !f:A->B g s.
                       FINITE s /\
                       (!x. x IN s ==> R (f x) (g x))
                       ==> R (iterate op s f) (iterate op s g)}|,
      GEN_TAC then_tac DISCH_TAC then_tac GEN_TAC then_tac \
      STRIP_TAC then_tac \
      GEN_TAC then_tac \
      GEN_TAC then_tac \
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES, FINITE_INSERT, IN_INSERT])
    ]
  )

def ITERATE_EQ_NEUTRAL:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f:A->B s. (!x. x IN s ==> (f(x) = neutral op))
                        ==> (iterate op s f = neutral op)}|,
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{support op (f:A->B) s = {}}|
      )(ASSUME_TAC) then_list \
      PairList [
        ASM_MESON_TAC(PairList [EXTENSION, NOT_IN_EMPTY, IN_SUPPORT]),
        ASM_MESON_TAC(PairList [ITERATE_CLAUSES, FINITE_RULES, ITERATE_SUPPORT])
      ]
    ]
  )

def ITERATE_SING:
  prove(
    [
      @hol|{!op. monoidal op ==> !f:A->B x. (iterate op {x} f = f x)}|,
      SIMP_TAC(PairList [ITERATE_CLAUSES, FINITE_RULES, NOT_IN_EMPTY]) then_tac \
      MESON_TAC(PairList [monoidal])
    ]
  )

def ITERATE_CLOSED_NONEMPTY:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !P. (!x y. P x /\ P y ==> P (op x y))
                 ==> !f:A->B s. FINITE s /\ ~(s = {}) /\
                                (!x. x IN s ==> P(f x))
                                ==> P(iterate op s f)}|,
      GEN_TAC then_tac DISCH_TAC then_tac GEN_TAC then_tac \
      DISCH_TAC then_tac \
      GEN_TAC then_tac \
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_INSERT, NOT_IN_EMPTY, NOT_INSERT_EMPTY]) then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{a:A}|, @hol|{t:A->bool}|]) then_tac \
      ASM_CASES_TAC(
        @hol|{t:A->bool = {}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_SING]) then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES])
    ]
  )

def ITERATE_RELATED_NONEMPTY:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !R. (!x1 y1 x2 y2. R x1 x2 /\ R y1 y2 ==> R (op x1 y1) (op x2 y2))
                 ==> !f:A->B g s.
                       FINITE s /\
                       ~(s = {}) /\
                       (!x. x IN s ==> R (f x) (g x))
                       ==> R (iterate op s f) (iterate op s g)}|,
      GEN_TAC then_tac DISCH_TAC then_tac GEN_TAC then_tac \
      DISCH_TAC then_tac \
      GEN_TAC then_tac \
      GEN_TAC then_tac \
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_INSERT, NOT_IN_EMPTY, NOT_INSERT_EMPTY]) then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{a:A}|, @hol|{t:A->bool}|]) then_tac \
      ASM_CASES_TAC(
        @hol|{t:A->bool = {}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_SING]) then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES])
    ]
  )

def ITERATE_DELETE:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f:A->B s a. FINITE s /\ a IN s
                          ==> op (f a) (iterate op (s DELETE a) f) =
                              iterate op s f}|,
      MESON_TAC(PairList [ITERATE_CLAUSES, FINITE_DELETE, IN_DELETE, INSERT_DELETE])
    ]
  )

def ITERATE_DELTA:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !(f:A->B) a s.
                 iterate op s (\x. if x = a then f(x) else neutral op) =
                 if a IN s then f(a) else neutral op}|,
      GEN_TAC then_tac DISCH_TAC then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(ITERATE_SUPPORT)]) then_tac \
      REWRITE_TAC(PairList [SUPPORT_DELTA]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES]) then_tac \
      REWRITE_TAC(PairList [SUPPORT_CLAUSES]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES, ITERATE_SING])
    ]
  )

def ITERATE_IMAGE:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f:A->B g:B->C s.
                  (!x y. x IN s /\ y IN s /\ (f x = f y) ==> (x = y))
                  ==> (iterate op (IMAGE f s) g = iterate op s (g o f))}|,
      GEN_TAC then_tac DISCH_TAC then_tac GEN_TAC then_tac GEN_TAC then_tac \
      SUBGOAL_THEN(
        @hol|{!s. FINITE s /\
           (!x y:A. x IN s /\ y IN s /\ (f x = f y) ==> (x = y))
           ==> (iterate op (IMAGE f s) (g:B->C) = iterate op s (g o f))}|
      )(ASSUME_TAC) then_list \
      PairList [
        REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
        MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
        ASM_SIMP_TAC(PairList [ITERATE_CLAUSES, IMAGE_CLAUSES, FINITE_IMAGE]) then_tac \
        REWRITE_TAC(PairList [o_THM, IN_INSERT]) then_tac \
        ASM_MESON_TAC(PairList [IN_IMAGE]),
        GEN_TAC then_tac DISCH_TAC then_tac \
        ONCE_REWRITE_TAC(PairList [ITERATE_EXPAND_CASES]) then_tac \
        REPEAT(STRIP_TAC) then_tac \
        MATCH_MP_TAC(
          TAUT(
            @hol|{(a <=> a') /\ (a' ==> (b = b'))
               ==> (if a then b else c) = (if a' then b' else c)}|
          )
        ) then_tac \
        REWRITE_TAC(PairList [SUPPORT_CLAUSES]) then_tac \
        REPEAT(STRIP_TAC) then_list \
        PairList [
          MATCH_MP_TAC(FINITE_IMAGE_INJ_EQ) then_tac \
          ASM_MESON_TAC(PairList [IN_SUPPORT]),
          FIRST_X_ASSUM(MATCH_MP_TAC) then_tac ASM_MESON_TAC(PairList [IN_SUPPORT])
        ]
      ]
    ]
  )

def ITERATE_BIJECTION:
  prove(
    [
      @hol|{!op. monoidal op
         ==>  !f:A->B p s.
                 (!x. x IN s ==> p(x) IN s) /\
                 (!y. y IN s ==> ?!x. x IN s /\ p(x) = y)
                 ==> iterate op s f = iterate op s (f o p)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{iterate op (IMAGE (p:A->A) s) (f:A->B)}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        AP_THM_TAC then_tac AP_TERM_TAC then_tac \
        REWRITE_TAC(PairList [EXTENSION, IN_IMAGE]),
        FIRST_X_ASSUM(
          o(MATCH_MP_TAC)(MATCH_MP(INST_TYPE(PairList [[aty, bty]])(ITERATE_IMAGE)))
        )
      ] then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ITERATE_ITERATE_PRODUCT:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !s:A->bool t:A->B->bool x:A->B->C.
                 FINITE s /\ (!i. i IN s ==> FINITE(t i))
                 ==> iterate op s (\i. iterate op (t i) (x i)) =
                     iterate op {i,j | i IN s /\ j IN t i} (\(i,j). x i j)}|,
      GEN_TAC then_tac DISCH_TAC then_tac \
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      ASM_SIMP_TAC(
        PairList [
          NOT_IN_EMPTY,
          SET_RULE(
            @hol|{{a,b | F} = {}}|
          ),
          ITERATE_CLAUSES
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{{i,j | i IN a INSERT s /\ j IN t i} =
               IMAGE (\j. a,j) (t a) UNION {i,j | i IN s /\ j IN t i}}|
          )
        ]
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_INSERT, ITERATE_CLAUSES, IN_INSERT]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      FIRST_ASSUM(
        fun(th):
          W(
            o(
              o(
                o(MP_TAC)(PART_MATCH(o(lhand)(rand))(MATCH_MP(ITERATE_UNION)(th)))
              )(rand)
            )(snd)
          )
      ) then_tac \
      ANTS_TAC then_list \
      PairList [
        ASM_SIMP_TAC(PairList [FINITE_IMAGE, FINITE_PRODUCT_DEPENDENT, IN_INSERT]) then_tac \
        REWRITE_TAC(
          PairList [
            DISJOINT,
            EXTENSION,
            IN_IMAGE,
            IN_INTER,
            NOT_IN_EMPTY,
            IN_ELIM_THM,
            EXISTS_PAIR_THM,
            FORALL_PAIR_THM,
            PAIR_EQ
          ]
        ) then_tac \
        ASM_MESON_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      DISCH_THEN(SUBST1_TAC) then_tac \
      AP_THM_TAC then_tac \
      AP_TERM_TAC then_tac \
      FIRST_ASSUM(
        fun(th):
          W(
            o(
              o(
                o(MP_TAC)(PART_MATCH(o(lhand)(rand))(MATCH_MP(ITERATE_IMAGE)(th)))
              )(rand)
            )(snd)
          )
      ) then_tac \
      ANTS_TAC then_list \
      PairList [
        SIMP_TAC(PairList [FORALL_PAIR_THM]) then_tac \
        CONV_TAC(ONCE_DEPTH_CONV(GEN_BETA_CONV)) then_tac \
        ASM_SIMP_TAC(PairList [PAIR_EQ]),
        DISCH_THEN(SUBST1_TAC) then_tac REWRITE_TAC(PairList [o_DEF]) then_tac \
        CONV_TAC(ONCE_DEPTH_CONV(GEN_BETA_CONV)) then_tac \
        REWRITE_TAC(PairList [ETA_AX])
      ]
    ]
  )

def ITERATE_EQ:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f:A->B g s.
               (!x. x IN s ==> f x = g x) ==> iterate op s f = iterate op s g}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [ITERATE_EXPAND_CASES]) then_tac \
      SUBGOAL_THEN(
        @hol|{support op g s = support op (f:A->B) s}|
      )(SUBST1_TAC) then_list \
      PairList [
        REWRITE_TAC(PairList [EXTENSION, IN_SUPPORT]) then_tac \
        ASM_MESON_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      SUBGOAL_THEN(
        @hol|{FINITE(support op (f:A->B) s) /\
           (!x. x IN (support op f s) ==> f x = g x)}|
      )(MP_TAC) then_list \
      PairList [
        ASM_MESON_TAC(PairList [IN_SUPPORT]),
        REWRITE_TAC(PairList [IMP_CONJ])
      ] then_tac \
      SPEC_TAC(
        [
          @hol|{support op (f:A->B) s}|,
          @hol|{t:A->bool}|
        ]
      ) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES]) then_tac \
      MESON_TAC(PairList [IN_INSERT])
    ]
  )

def ITERATE_RESTRICT_SET:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !P s f:A->B. iterate op {x | x IN s /\ P x} f =
                          iterate op s (\x. if P x then f x else neutral op)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(ITERATE_SUPPORT)]) then_tac \
      REWRITE_TAC(PairList [support, IN_ELIM_THM]) then_tac \
      REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{~((if P x then f x else a) = a) <=> P x /\ ~(f x = a)}|
          ),
          GSYM(CONJ_ASSOC)
        ]
      ) then_tac \
      FIRST_X_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(ITERATE_EQ))) then_tac \
      SIMP_TAC(PairList [IN_ELIM_THM])
    ]
  )

def ITERATE_EQ_GENERAL:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !s:A->bool t:B->bool f:A->C g h.
                 (!y. y IN t ==> ?!x. x IN s /\ h(x) = y) /\
                 (!x. x IN s ==> h(x) IN t /\ g(h x) = f x)
                 ==> iterate op s f = iterate op t g}|,
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{t = IMAGE (h:A->B) s}|
      )(SUBST1_TAC) then_list \
      PairList [
        REWRITE_TAC(PairList [EXTENSION, IN_IMAGE]) then_tac \
        ASM_MESON_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{iterate op s ((g:B->C) o (h:A->B))}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        ASM_MESON_TAC(PairList [ITERATE_EQ, o_THM]),
        CONV_TAC(SYM_CONV) then_tac \
        FIRST_X_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(ITERATE_IMAGE))) then_tac \
        ASM_MESON_TAC(PairList [])
      ]
    ]
  )

def ITERATE_EQ_GENERAL_INVERSES:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !s:A->bool t:B->bool f:A->C g h k.
                 (!y. y IN t ==> k(y) IN s /\ h(k y) = y) /\
                 (!x. x IN s ==> h(x) IN t /\ k(h x) = x /\ g(h x) = f x)
                 ==> iterate op s f = iterate op t g}|,
      REPEAT(STRIP_TAC) then_tac \
      FIRST_X_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(ITERATE_EQ_GENERAL))) then_tac \
      EXISTS_TAC(@hol|{h:A->B}|) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ITERATE_INJECTION:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f:A->B p:A->A s.
                     FINITE s /\
                     (!x. x IN s ==> p x IN s) /\
                     (!x y. x IN s /\ y IN s /\ p x = p y ==> x = y)
                     ==> iterate op s (f o p) = iterate op s f}|,
      REPEAT(STRIP_TAC) then_tac CONV_TAC(SYM_CONV) then_tac \
      FIRST_X_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(ITERATE_BIJECTION))) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{s:A->bool}|,
            @hol|{p:A->A}|
          ])(
          SURJECTIVE_IFF_INJECTIVE
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [SUBSET, IN_IMAGE]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ITERATE_UNION_NONZERO:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f:A->B s t.
                 FINITE(s) /\ FINITE(t) /\
                 (!x. x IN (s INTER t) ==> f x = neutral(op))
                 ==> iterate op (s UNION t) f =
                     op (iterate op s f) (iterate op t f)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(ITERATE_SUPPORT)]) then_tac \
      REWRITE_TAC(PairList [SUPPORT_CLAUSES]) then_tac \
      FIRST_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(ITERATE_UNION))) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_SUPPORT, DISJOINT, IN_INTER, IN_SUPPORT, EXTENSION]) then_tac \
      ASM_MESON_TAC(PairList [IN_INTER, NOT_IN_EMPTY])
    ]
  )

def ITERATE_OP:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !(f:A->B) g s.
                 FINITE s
                 ==> iterate op s (\x. op (f x) (g x)) =
                     op (iterate op s f) (iterate op s g)}|,
      GEN_TAC then_tac DISCH_TAC then_tac GEN_TAC then_tac GEN_TAC then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES, MONOIDAL_AC])
    ]
  )

def ITERATE_SUPERSET:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f:A->B u v.
                 u SUBSET v /\
                 (!x. x IN v /\ ~(x IN u) ==> f(x) = neutral op)
                 ==> iterate op v f = iterate op u f}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(ITERATE_SUPPORT)]) then_tac \
      AP_THM_TAC then_tac \
      AP_TERM_TAC then_tac \
      REWRITE_TAC(PairList [support, EXTENSION, IN_ELIM_THM]) then_tac \
      ASM_MESON_TAC(PairList [SUBSET])
    ]
  )

def ITERATE_UNIV:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f:A->B s. support op f UNIV SUBSET s
                   ==> iterate op s f = iterate op UNIV f}|,
      REWRITE_TAC(PairList [support, SUBSET, IN_ELIM_THM]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      CONV_TAC(SYM_CONV) then_tac \
      FIRST_X_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(ITERATE_SUPERSET))) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def ITERATE_SWAP:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f:A->B->C s t.
                 FINITE s /\ FINITE t
                 ==> iterate op s (\i. iterate op t (f i)) =
                     iterate op t (\j. iterate op s (\i. f i j))}|,
      GEN_TAC then_tac DISCH_TAC then_tac GEN_TAC then_tac \
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES]) then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_EQ_NEUTRAL, GSYM(ITERATE_OP)])
    ]
  )

def ITERATE_IMAGE_NONZERO:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !g:B->C f:A->B s.
                     FINITE s /\
                     (!x y. x IN s /\ y IN s /\ ~(x = y) /\ f x = f y
                            ==> g(f x) = neutral op)
                     ==> iterate op (IMAGE f s) g = iterate op s (g o f)}|,
      GEN_TAC then_tac DISCH_TAC then_tac GEN_TAC then_tac GEN_TAC then_tac \
      ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      ASM_SIMP_TAC(PairList [IMAGE_CLAUSES, ITERATE_CLAUSES, FINITE_IMAGE]) then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{a:A}|, @hol|{s:A->bool}|]) then_tac \
      REWRITE_TAC(PairList [IN_INSERT]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{iterate op s ((g:B->C) o (f:A->B)) = iterate op (IMAGE f s) g}|
      )(SUBST1_TAC) then_list \
      PairList [ASM_MESON_TAC(PairList []), ALL_TAC] then_tac \
      REWRITE_TAC(PairList [IN_IMAGE]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [o_THM]) then_tac \
      SUBGOAL_THEN(
        @hol|{(g:B->C) ((f:A->B) a) = neutral op}|
      )(SUBST1_TAC) then_tac \
      ASM_MESON_TAC(PairList [MONOIDAL_AC])
    ]
  )

def ITERATE_IMAGE_GEN:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f:A->B g:A->C s.
                 FINITE s
                 ==> iterate op s g =
                     iterate op (IMAGE f s)
                        (\y. iterate op {x | x IN s /\ f x = y} g)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{iterate op s (\x:A. iterate op {y:B | y IN IMAGE f s /\ (f x = y)}
           (\y. (g:A->C) x))}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        FIRST_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(ITERATE_EQ))) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        X_GEN_TAC(@hol|{x:A}|) then_tac \
        DISCH_TAC then_tac \
        SUBGOAL_THEN(
          @hol|{{y | y IN IMAGE (f:A->B) s /\ f x = y} = {(f x)}}|
        )(SUBST1_TAC) then_list \
        PairList [ASM(SET_TAC)(PairList []), ASM_SIMP_TAC(PairList [ITERATE_SING])],
        ASM_SIMP_TAC(PairList [ITERATE_RESTRICT_SET]) then_tac \
        FIRST_ASSUM(
          fun(th):
            W(
              o(
                o(
                  o(MP_TAC)(PART_MATCH(o(lhand)(rand))(MATCH_MP(ITERATE_SWAP)(th)))
                )(lhand)
              )(snd)
            )
        ) then_tac \
        ASM_SIMP_TAC(PairList [FINITE_IMAGE])
      ]
    ]
  )

def ITERATE_CASES:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !s P f g:A->B.
                 FINITE s
                 ==> iterate op s (\x. if P x then f x else g x) =
                     op (iterate op {x | x IN s /\ P x} f)
                        (iterate op {x | x IN s /\ ~P x} g)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{op (iterate op {x | x IN s /\ P x} (\x. if P x then f x else (g:A->B) x))
           (iterate op {x | x IN s /\ ~P x} (\x. if P x then f x else g x))}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        FIRST_ASSUM(
          fun(th):
            ASM_SIMP_TAC(
              PairList [
                GSYM(MATCH_MP(ITERATE_UNION)(th)),
                FINITE_RESTRICT,
                SET_RULE(
                  @hol|{DISJOINT {x | x IN s /\ P x} {x | x IN s /\ ~P x}}|
                )
              ]
            )
        ) then_tac \
        AP_THM_TAC then_tac \
        AP_TERM_TAC then_tac \
        SET_TAC(PairList []),
        BINOP_TAC then_tac \
        FIRST_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(ITERATE_EQ))) then_tac \
        SIMP_TAC(PairList [IN_ELIM_THM])
      ]
    ]
  )

def ITERATE_OP_GEN:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f g:A->B s.
                 FINITE(support op f s) /\ FINITE(support op g s)
                 ==> iterate op s (\x. op (f x) (g x)) =
                     op (iterate op s f) (iterate op s g)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(ITERATE_SUPPORT)]) then_tac \
      MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{iterate op (support op f s UNION support op g s)
           (\x. op ((f:A->B) x) (g x))}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        CONV_TAC(SYM_CONV),
        ASM_SIMP_TAC(PairList [ITERATE_OP, FINITE_UNION]) then_tac BINOP_TAC
      ] then_tac \
      FIRST_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(ITERATE_SUPERSET))) then_tac \
      REWRITE_TAC(PairList [support, IN_ELIM_THM, SUBSET, IN_UNION]) then_tac \
      ASM_MESON_TAC(PairList [monoidal])
    ]
  )

def ITERATE_CLAUSES_NUMSEG:
  prove(
    [
      @hol|{!op. monoidal op
         ==> (!m. iterate op (m..0) f = if m = 0 then f(0) else neutral op) /\
             (!m n. iterate op (m..SUC n) f :A =
                    if m <= SUC n then op (iterate op (m..n) f) (f(SUC n))
                    else iterate op (m..n) f)}|,
      REWRITE_TAC(PairList [NUMSEG_CLAUSES]) then_tac REPEAT(STRIP_TAC) then_tac \
      COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES, FINITE_NUMSEG, IN_NUMSEG, FINITE_EMPTY]) then_tac \
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            @hol|{~(SUC n <= n)}|
          ),
          NOT_IN_EMPTY
        ]
      ) then_tac \
      ASM_MESON_TAC(PairList [monoidal])
    ]
  )

def ITERATE_CLAUSES_NUMSEG_LT:
  prove(
    [
      @hol|{!op. monoidal op
         ==> iterate op {i | i < 0} f :A = neutral op /\
             (!k. iterate op {i | i < SUC k} f =
                  op (iterate op {i | i < k} f) (f k))}|,
      SIMP_TAC(PairList [NUMSEG_CLAUSES_LT, ITERATE_CLAUSES, FINITE_NUMSEG_LT]) then_tac \
      REWRITE_TAC(PairList [IN_ELIM_THM, LT_REFL, monoidal]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def ITERATE_CLAUSES_NUMSEG_LE:
  prove(
    [
      @hol|{!op. monoidal op
         ==> iterate op {i | i <= 0} f :A = f 0 /\
             (!k. iterate op {i | i <= SUC k} f =
                  op (iterate op {i | i <= k} f) (f(SUC k)))}|,
      SIMP_TAC(PairList [NUMSEG_CLAUSES_LE, ITERATE_CLAUSES, FINITE_NUMSEG_LE, ITERATE_SING]) then_tac \
      REWRITE_TAC(
        PairList [
          monoidal,
          IN_ELIM_THM,
          ARITH_RULE(
            @hol|{~(SUC k <= k)}|
          )
        ]
      ) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def ITERATE_PAIR:
  prove(
    [
      @hol|{!op. monoidal op
         ==> !f m n. iterate op (2*m..2*n+1) f :A =
                     iterate op (m..n) (\i. op (f(2*i)) (f(2*i+1)))}|,
      GEN_TAC then_tac DISCH_TAC then_tac GEN_TAC then_tac GEN_TAC then_tac \
      INDUCT_TAC then_tac \
      CONV_TAC(NUM_REDUCE_CONV) then_list \
      PairList [
        ASM_SIMP_TAC(
          PairList [
            num_CONV(
              @hol|{1}|
            ),
            ITERATE_CLAUSES_NUMSEG
          ]
        ) then_tac \
        REWRITE_TAC(
          PairList [
            ARITH_RULE(
              @hol|{2 * m <= SUC 0 <=> m = 0}|
            )
          ]
        ) then_tac \
        COND_CASES_TAC then_tac \
        ASM_REWRITE_TAC(PairList [MULT_EQ_0, ARITH]),
        REWRITE_TAC(
          PairList [
            ARITH_RULE(
              @hol|{2 * SUC n + 1 = SUC(SUC(2 * n + 1))}|
            )
          ]
        ) then_tac \
        ASM_SIMP_TAC(PairList [ITERATE_CLAUSES_NUMSEG]) then_tac \
        REWRITE_TAC(
          PairList [
            ARITH_RULE(
              @hol|{2 * m <= SUC(SUC(2 * n + 1)) <=> m <= SUC n}|
            ),
            ARITH_RULE(
              @hol|{2 * m <= SUC(2 * n + 1) <=> m <= SUC n}|
            )
          ]
        ) then_tac \
        COND_CASES_TAC then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        REWRITE_TAC(
          PairList [
            ARITH_RULE(
              @hol|{2 * SUC n = SUC(2 * n + 1)}|
            ),
            ARITH_RULE(
              @hol|{2 * SUC n + 1 = SUC(SUC(2 * n + 1))}|
            )
          ]
        ) then_tac \
        ASM_MESON_TAC(PairList [monoidal])
      ]
    ]
  )

def ITERATE_REFLECT:
  prove(
    [
      @hol|{!op:A->A->A.
         monoidal op
         ==> !x m n. iterate op (m..n) x =
                     if n < m then neutral op
                     else iterate op (0..n-m) (\i. x(n - i))}|,
      REWRITE_TAC(PairList [GSYM(NUMSEG_EMPTY)]) then_tac REPEAT(STRIP_TAC) then_tac \
      COND_CASES_TAC then_list \
      PairList [
        ASM_MESON_TAC(PairList [ITERATE_CLAUSES]),
        RULE_ASSUM_TAC(REWRITE_RULE(PairList [NUMSEG_EMPTY, NOT_LT]))
      ] then_tac \
      FIRST_ASSUM(
        o(
          o(MP_TAC)(
            ISPECL(
              PairList [
                @hol|{\i:num. n - i}|,
                @hol|{x:num->A}|,
                @hol|{0..n-m}|
              ]
            )
          )
        )(
          MATCH_MP(
            INST_TYPE(PairList [[@hol|{:X}|, @hol|{:A}|]])(ITERATE_IMAGE)
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList [o_DEF, IN_NUMSEG]) then_tac \
      ANTS_TAC then_list \
      PairList [ARITH_TAC, DISCH_THEN(o(SUBST1_TAC)(SYM))] then_tac \
      AP_THM_TAC then_tac \
      AP_TERM_TAC then_tac \
      REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, IN_NUMSEG]) then_tac \
      REWRITE_TAC(
        PairList [
          UNWIND_THM2,
          ARITH_RULE(
            @hol|{x = n - y /\ 0 <= y /\ y <= n - m <=>
               y = n - x /\ x <= n /\ y <= n - m}|
          )
        ]
      ) then_tac \
      ASM_ARITH_TAC
    ]
  )

def iterato:
  o(new_specification(PairList ["iterato"]))(prove)(
    [
      @hol|{?itty.
         !dom neut op (<<=) k (f:K->A).
            itty dom neut op (<<=) k f =
            if FINITE {i | i IN k /\ f i IN dom DIFF {neut}} /\
               ~({i | i IN k /\ f i IN dom DIFF {neut}} = {})
            then let i = if ?i. i IN k /\ f i IN dom DIFF {neut} /\
                                !j. j <<= i /\ j IN k /\ f j IN dom DIFF {neut}
                                    ==> j = i
                          then @i. i IN k /\ f i IN dom DIFF {neut} /\
                                   !j. j <<= i /\ j IN k /\
                                       f j IN dom DIFF {neut}
                                       ==> j = i
                          else @i. i IN k /\ f i IN dom DIFF {neut} in
                 op (f i) (itty dom neut op (<<=)
                             {j | j IN k DELETE i /\ f j IN dom DIFF {neut}} f)
            else neut}|,
      REPLICATE_TAC(4)(ONCE_REWRITE_TAC(PairList [GSYM(SKOLEM_THM)])) then_tac \
      REPEAT(GEN_TAC) then_tac \
      GEN_REWRITE_TAC(I)(PairList [EXISTS_SWAP_FUN_THM]) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      GEN_REWRITE_TAC(BINDER_CONV)(PairList [SWAP_FORALL_THM]) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(SKOLEM_THM)]) then_tac \
      GEN_TAC then_tac \
      MATCH_MP_TAC(
        MATCH_MP(WF_REC)(
          ISPEC(
            @hol|{\k. CARD {i | i IN k /\ (f:K->A) i IN dom DIFF {neut}}}|)(
            WF_MEASURE
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList [MEASURE]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      LET_TAC then_tac \
      CONV_TAC(ONCE_DEPTH_CONV(let_CONV)) then_tac \
      AP_TERM_TAC then_tac \
      FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{{i | i IN k DIFF {a} /\ P i} = {i | i IN k /\ P i} DELETE a}|
          )
        ]
      ) then_tac \
      MATCH_MP_TAC(CARD_PSUBSET) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REWRITE_TAC(PairList [PSUBSET_ALT]) then_tac \
      CONJ_TAC then_list \
      PairList [SET_TAC(PairList []), ALL_TAC] then_tac \
      REWRITE_TAC(PairList [IN_ELIM_THM, IN_DELETE, GSYM(CONJ_ASSOC)]) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{p /\ q /\ ~(p /\ ~r /\ q) <=> r /\ p /\ q}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [UNWIND_THM2]) then_tac \
      FIRST_X_ASSUM(
        o(o(MP_TAC)(REWRITE_RULE(PairList [GSYM(MEMBER_NOT_EMPTY)])))(CONJUNCT2)
      ) then_tac \
      REWRITE_TAC(PairList [IN_ELIM_THM, IN_DELETE]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ITERATO_SUPPORT:
  prove(
    [
      @hol|{!dom neut op (<<=) k (f:K->A).
         iterato dom neut op (<<=) {i | i IN k /\ f i IN dom DIFF {neut}} f =
         iterato dom neut op (<<=) k f}|,
      REPEAT(GEN_TAC) then_tac ONCE_REWRITE_TAC(PairList [iterato]) then_tac \
      REWRITE_TAC(
        PairList [
          CONJ_ASSOC,
          SET_RULE(
            @hol|{y IN {x | x IN s /\ P x} /\ P y <=>
               y IN {x | x IN s /\ P x}}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [IN_ELIM_THM, GSYM(CONJ_ASSOC)]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      LET_TAC then_tac \
      CONV_TAC(ONCE_DEPTH_CONV(let_CONV)) then_tac \
      AP_TERM_TAC then_tac \
      AP_THM_TAC then_tac \
      AP_TERM_TAC then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def ITERATO_EXPAND_CASES:
  prove(
    [
      @hol|{!dom neut op (<<=) k (f:K->A).
         iterato dom neut op (<<=) k f =
         if FINITE {i | i IN k /\ f i IN dom DIFF {neut}}
         then iterato dom neut op (<<=) {i | i IN k /\ f i IN dom DIFF {neut}} f
         else neut}|,
      REPEAT(GEN_TAC) then_tac COND_CASES_TAC then_list \
      PairList [
        REWRITE_TAC(PairList [ITERATO_SUPPORT]),
        GEN_REWRITE_TAC(LAND_CONV)(PairList [iterato]) then_tac \
        ASM_REWRITE_TAC(PairList [])
      ]
    ]
  )

def ITERATO_CLAUSES_GEN:
  prove(
    [
      @hol|{!dom neut op (<<=) (f:K->A).
         (iterato dom neut op (<<=) {} f = neut) /\
         (!i k. FINITE {j | j IN k /\ f j IN dom DIFF {neut}} /\
                (!j. j IN k ==> i = j \/ i <<= j \/ j <<= i) /\
                (!j. j <<= i /\ j IN k /\ f j IN dom DIFF {neut} ==> j = i)
                ==> iterato dom neut op (<<=) (i INSERT k) f =
                    if f i IN dom ==> f i = neut \/ i IN k
                    then iterato dom neut op (<<=) k f
                    else op (f i) (iterato dom neut op (<<=) k f))}|,
      REPEAT(GEN_TAC) then_tac CONJ_TAC then_list \
      PairList [
        GEN_REWRITE_TAC(LAND_CONV)(PairList [iterato]) then_tac \
        ASM_REWRITE_TAC(PairList [NOT_IN_EMPTY, EMPTY_GSPEC]),
        REPEAT(GEN_TAC) then_tac STRIP_TAC
      ] then_tac \
      ASM_CASES_TAC(
        @hol|{(i:K) IN k}|
      ) then_tac \
      ASM_SIMP_TAC(
        PairList [
          COND_SWAP,
          SET_RULE(
            @hol|{i IN k ==> i INSERT k = k}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{x IN dom ==> x = a <=> ~(x IN dom DIFF {a})}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [COND_SWAP]) then_tac \
      COND_CASES_TAC then_list \
      PairList [
        GEN_REWRITE_TAC(LAND_CONV)(PairList [iterato]) then_tac \
        FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [IN_DIFF]))) then_tac \
        REWRITE_TAC(PairList [IN_SING]) then_tac \
        STRIP_TAC,
        ONCE_REWRITE_TAC(PairList [GSYM(ITERATO_SUPPORT)]) then_tac AP_THM_TAC then_tac \
        AP_TERM_TAC then_tac \
        ASM(SET_TAC)(PairList [])
      ] then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [])(
          @hol|{q /\ p /\ x = z ==> (if p /\ q then x else y) = z}|
        )
      ) then_tac \
      REPEAT(CONJ_TAC) then_list \
      PairList [
        ASM(SET_TAC)(PairList []),
        MATCH_MP_TAC(FINITE_SUBSET) then_tac \
        EXISTS_TAC(
          @hol|{i INSERT {j | j IN k /\ (f:K->A) j IN dom DIFF {neut}}}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList [FINITE_INSERT]) then_tac \
        ASM(SET_TAC)(PairList []),
        ALL_TAC
      ] then_tac \
      COND_CASES_TAC then_list \
      PairList [
        FIRST_X_ASSUM(o(K(ALL_TAC))(check(o(is_exists)(concl)))),
        FIRST_X_ASSUM(
          o(o(MP_TAC)(SPEC(@hol|{i:K}|)))(REWRITE_RULE(PairList [NOT_EXISTS_THM]))
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      ] then_tac \
      SUBGOAL_THEN(
        @hol|{(@i'. i' IN i INSERT k /\
           (f:K->A) i' IN dom DIFF {neut} /\
           (!j. j <<= i' /\ j IN i INSERT k /\ f j IN dom DIFF {neut}
                ==> j = i')) = i}|
      )(SUBST1_TAC) then_list \
      PairList [
        ALL_TAC,
        CONV_TAC(ONCE_DEPTH_CONV(let_CONV)) then_tac \
        ASM_SIMP_TAC(
          PairList [
            SET_RULE(
              @hol|{~(i IN k) ==> (i INSERT k) DELETE i = k}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [ITERATO_SUPPORT])
      ] then_tac \
      MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      X_GEN_TAC(@hol|{j:K}|) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      EQ_TAC then_tac \
      SIMP_TAC(PairList []) then_list \
      PairList [ALL_TAC, ASM(SET_TAC)(PairList [])] then_tac \
      ASM_CASES_TAC(@hol|{j:K = i}|) then_tac \
      ASM_REWRITE_TAC(PairList [IN_INSERT]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def ITERATO_CLAUSES:
  prove(
    [
      @hol|{!dom neut op (<<=) (f:K->A).
         (iterato dom neut op (<<=) {} f = neut) /\
         (!i k. FINITE {i | i IN k /\ f i IN dom DIFF {neut}} /\
                (!j. j IN k ==> i <<= j /\ ~(j <<= i))
                ==> iterato dom neut op (<<=) (i INSERT k) f =
                    if f i IN dom ==> f i = neut \/ i IN k
                    then iterato dom neut op (<<=) k f
                    else op (f i) (iterato dom neut op (<<=) k f))}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [ITERATO_CLAUSES_GEN]) then_tac \
      MATCH_MP_TAC(CONJUNCT2(SPEC_ALL(ITERATO_CLAUSES_GEN))) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ITERATO_CLAUSES_EXISTS:
  prove(
    [
      @hol|{!dom neut op (<<=) (f:K->A).
         (iterato dom neut op (<<=) {} f = neut) /\
         (!k. FINITE {i | i IN k /\ f i IN dom DIFF {neut}} /\
              ~({i | i IN k /\ f i IN dom DIFF {neut}} = {})
              ==> ?i. i IN k /\ f i IN dom DIFF {neut} /\
                      iterato dom neut op (<<=) k f =
                      op (f i) (iterato dom neut op (<<=) (k DELETE i) f))}|,
      REPEAT(GEN_TAC) then_tac CONJ_TAC then_list \
      PairList [
        GEN_REWRITE_TAC(LAND_CONV)(PairList [iterato]) then_tac \
        ASM_REWRITE_TAC(PairList [NOT_IN_EMPTY, EMPTY_GSPEC]),
        REPEAT(GEN_TAC) then_tac STRIP_TAC
      ] then_tac \
      GEN_REWRITE_TAC(
        o(o(o(BINDER_CONV)(RAND_CONV))(RAND_CONV))(LAND_CONV))(
        PairList [iterato]
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      LET_TAC then_tac \
      GEN_REWRITE_TAC(o(BINDER_CONV)(funpow(4)(RAND_CONV)))(PairList [GSYM(ITERATO_SUPPORT)]) then_tac \
      FIRST_X_ASSUM(
        o(MATCH_MP_TAC)(
          MATCH_MP(
            MESON(
              PairList [])(
              @hol|{t = i ==> (t = i ==> P i) ==> ?j. P j}|
            )
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      COND_CASES_TAC then_list \
      PairList [DISCH_TAC, ASM(SET_TAC)(PairList [])] then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(SELECT_RULE)) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      SIMP_TAC(PairList [])
    ]
  )

def ITERATO_EQ:
  prove(
    [
      @hol|{!dom neut op (<<=) k f (g:K->A).
         (!i. i IN k ==> f i = g i)
         ==> iterato dom neut op (<<=) k f = iterato dom neut op (<<=) k g}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [ITERATO_EXPAND_CASES]) then_tac \
      ASM_SIMP_TAC(
        PairList [
          TAUT(
            @hol|{p /\ q <=> ~(p ==> ~q)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [NOT_IMP]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      SUBGOAL_THEN(
        @hol|{!i. i IN {i | i IN k /\ (g:K->A) i IN dom DIFF {neut}} ==> f i = g i}|
      )(MP_TAC) then_list \
      PairList [ASM(SET_TAC)(PairList []), ALL_TAC] then_tac \
      UNDISCH_TAC(
        @hol|{FINITE {i | i IN k /\ (g:K->A) i IN dom DIFF {neut}}}|
      ) then_tac \
      SPEC_TAC(
        [
          @hol|{{i | i IN k /\ (g:K->A) i IN dom DIFF {neut}}}|,
          @hol|{k:K->bool}|
        ]
      ) then_tac \
      POP_ASSUM_LIST(K(ALL_TAC)) then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [])(
          @hol|{(!n k. FINITE k /\ CARD k = n ==> P k) ==> (!k. FINITE k ==> P k)}|
        )
      ) then_tac \
      REWRITE_TAC(PairList [IMP_IMP]) then_tac \
      MATCH_MP_TAC(num_WF) then_tac \
      X_GEN_TAC(@hol|{n:num}|) then_tac \
      DISCH_TAC then_tac \
      X_GEN_TAC(@hol|{k:K->bool}|) then_tac \
      STRIP_TAC then_tac \
      RULE_ASSUM_TAC(
        REWRITE_RULE(PairList [IMP_IMP, RIGHT_IMP_FORALL_THM, GSYM(CONJ_ASSOC)])
      ) then_tac \
      ASM_CASES_TAC(
        @hol|{k:K->bool = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [ITERATO_CLAUSES_EXISTS]) then_tac \
      ONCE_REWRITE_TAC(PairList [iterato]) then_tac \
      SUBGOAL_THEN(
        @hol|{!s i. i IN k /\ (f:K->A) i IN s <=> i IN k /\ g i IN s}|
      )(ASSUME_TAC) then_list \
      PairList [
        ASM_MESON_TAC(PairList []),
        ASM_REWRITE_TAC(PairList [CONJ_ASSOC])
      ] then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(CONJ_ASSOC)]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      LET_TAC then_tac \
      CONV_TAC(TOP_DEPTH_CONV(let_CONV)) then_tac \
      SUBGOAL_THEN(
        @hol|{(i:K) IN k}|
      )(ASSUME_TAC) then_list \
      PairList [
        EXPAND_TAC("i") then_tac \
        RULE_ASSUM_TAC(REWRITE_RULE(PairList [GSYM(MEMBER_NOT_EMPTY), IN_ELIM_THM])) then_tac \
        FIRST_X_ASSUM(o(MP_TAC)(CONJUNCT2)) then_tac \
        MESON_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      BINOP_TAC then_list \
      PairList [ASM_MESON_TAC(PairList []), ALL_TAC] then_tac \
      ASM_REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{{j | j IN s DELETE i /\ P j} = {j | j IN s /\ P j} DELETE i}|
          )
        ]
      ) then_tac \
      FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_DELETE, FINITE_RESTRICT, IN_DELETE, IN_ELIM_THM]) then_tac \
      REWRITE_TAC(PairList [ONCE_REWRITE_RULE(PairList [CONJ_SYM])(UNWIND_THM1)]) then_tac \
      FIRST_X_ASSUM((fun(th): GEN_REWRITE_TAC(RAND_CONV)(PairList [SYM(th)]))) then_tac \
      MATCH_MP_TAC(CARD_PSUBSET) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def ITERATO_INDUCT:
  prove(
    [
      @hol|{!dom neut op (<<=) k (f:K->A) P.
         P neut /\
         (!i x. i IN k /\ f i IN dom /\ ~(f i = neut) /\ P x ==> P (op (f i) x))
         ==> P(iterato dom neut op (<<=) k f)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{i IN k /\ f i IN s /\ ~(f i = z) /\ Q <=>
               i IN {j | j IN k /\ f j IN s DIFF {z}} /\ Q}|
          )
        ]
      ) then_tac \
      ONCE_REWRITE_TAC(PairList [ITERATO_EXPAND_CASES]) then_tac \
      ONCE_REWRITE_TAC(PairList [COND_RAND]) then_tac \
      SIMP_TAC(PairList []) then_tac \
      REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{(a /\ p ==> if q then r else T) <=> a ==> q ==> p ==> r}|
          )
        ]
      ) then_tac \
      STRIP_TAC then_tac \
      SPEC_TAC(
        [
          @hol|{{i | i IN k /\ (f:K->A) i IN dom DIFF {neut}}}|,
          @hol|{k:K->bool}|
        ]
      ) then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [])(
          @hol|{(!n k. FINITE k /\ CARD k = n ==> P k) ==> (!k. FINITE k ==> P k)}|
        )
      ) then_tac \
      REWRITE_TAC(PairList [IMP_IMP]) then_tac \
      MATCH_MP_TAC(num_WF) then_tac \
      X_GEN_TAC(@hol|{n:num}|) then_tac \
      DISCH_TAC then_tac \
      X_GEN_TAC(@hol|{k:K->bool}|) then_tac \
      STRIP_TAC then_tac \
      RULE_ASSUM_TAC(
        REWRITE_RULE(PairList [IMP_IMP, RIGHT_IMP_FORALL_THM, GSYM(CONJ_ASSOC)])
      ) then_tac \
      ASM_CASES_TAC(
        @hol|{k:K->bool = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [ITERATO_CLAUSES_EXISTS]) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{dom:A->bool}|,
            @hol|{neut:A}|,
            @hol|{op:A->A->A}|,
            @hol|{(<<=):K->K->bool}|,
            @hol|{f:K->A}|
          ])(
          ITERATO_CLAUSES_EXISTS
        )
      ) then_tac \
      DISCH_THEN(o(o(MP_TAC)(SPEC(@hol|{k:K->bool}|)))(CONJUNCT2)) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_RESTRICT]) then_tac \
      MATCH_MP_TAC(
        TAUT(
          @hol|{(p ==> r) /\ (q ==> r) ==> (~p ==> q) ==> r}|
        )
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        ONCE_REWRITE_TAC(PairList [GSYM(ITERATO_SUPPORT)]) then_tac \
        SIMP_TAC(PairList []) then_tac \
        ASM_REWRITE_TAC(PairList [ITERATO_CLAUSES_EXISTS]),
        DISCH_THEN(X_CHOOSE_THEN(@hol|{i:K}|)(MP_TAC))
      ] then_tac \
      REWRITE_TAC(PairList [IN_DIFF, IN_SING]) then_tac \
      STRIP_TAC then_tac \
      FIRST_X_ASSUM(SUBST1_TAC) then_tac \
      FIRST_ASSUM(MATCH_MP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
      EXISTS_TAC(
        @hol|{n - 1}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [CARD_DELETE, FINITE_DELETE, IN_DELETE]) then_tac \
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            @hol|{n - 1 < n <=> ~(n = 0)}|
          )
        ]
      ) then_tac \
      ASM_MESON_TAC(PairList [CARD_EQ_0])
    ]
  )

def ITERATO_CLOSED:
  prove(
    [
      @hol|{!dom neut op (<<=) k (f:K->A) P.
         P neut /\
         (!x y. P x /\ P y ==> P(op x y)) /\
         (!i. i IN k /\ f i IN dom /\ ~(f i = neut) ==> P(f i))
         ==> P(iterato dom neut op (<<=) k f)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(ITERATO_INDUCT) then_tac \
      ASM_SIMP_TAC(PairList [])
    ]
  )

def ITERATO_ITERATE:
  prove(
    [
      @hol|{!(op:A->A->A) ((<<=):K->K->bool).
         monoidal op ==> iterato (:A) (neutral op) op (<<=) = iterate op}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{k:K->bool}|,
          @hol|{f:K->A}|
        ]
      ) then_tac \
      ONCE_REWRITE_TAC(PairList [ITERATE_EXPAND_CASES, ITERATO_EXPAND_CASES]) then_tac \
      REWRITE_TAC(PairList [support, IN_UNIV, IN_DIFF, IN_SING]) then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [])(
          @hol|{(p ==> x = y) ==> (if p then x else z) = (if p then y else z)}|
        )
      ) then_tac \
      SPEC_TAC(
        [
          @hol|{{i | i IN k /\ ~((f:K->A) i = neutral op)}}|,
          @hol|{k:K->bool}|
        ]
      ) then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [])(
          @hol|{(!n k. FINITE k /\ CARD k = n ==> P k) ==> (!k. FINITE k ==> P k)}|
        )
      ) then_tac \
      REWRITE_TAC(PairList [IMP_IMP]) then_tac \
      MATCH_MP_TAC(num_WF) then_tac \
      X_GEN_TAC(@hol|{n:num}|) then_tac \
      DISCH_TAC then_tac \
      X_GEN_TAC(@hol|{k:K->bool}|) then_tac \
      STRIP_TAC then_tac \
      RULE_ASSUM_TAC(
        REWRITE_RULE(PairList [IMP_IMP, RIGHT_IMP_FORALL_THM, GSYM(CONJ_ASSOC)])
      ) then_tac \
      ASM_CASES_TAC(
        @hol|{k:K->bool = {}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [ITERATE_CLAUSES, ITERATO_CLAUSES_EXISTS]) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{(:A)}|,
            @hol|{neutral op:A}|,
            @hol|{op:A->A->A}|,
            @hol|{(<<=):K->K->bool}|,
            @hol|{f:K->A}|
          ])(
          ITERATO_CLAUSES_EXISTS
        )
      ) then_tac \
      DISCH_THEN(o(o(MP_TAC)(SPEC(@hol|{k:K->bool}|)))(CONJUNCT2)) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_RESTRICT]) then_tac \
      MATCH_MP_TAC(
        TAUT(
          @hol|{(p ==> r) /\ (q ==> r) ==> (~p ==> q) ==> r}|
        )
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        ONCE_REWRITE_TAC(PairList [GSYM(ITERATO_SUPPORT), GSYM(ITERATE_SUPPORT)]) then_tac \
        REWRITE_TAC(PairList [support, IN_UNIV, IN_DIFF, IN_SING]) then_tac \
        ASM_SIMP_TAC(PairList [ITERATE_CLAUSES, ITERATO_CLAUSES_EXISTS]),
        DISCH_THEN(X_CHOOSE_THEN(@hol|{i:K}|)(MP_TAC))
      ] then_tac \
      REWRITE_TAC(PairList [IN_DIFF, IN_SING]) then_tac \
      STRIP_TAC then_tac \
      FIRST_X_ASSUM(SUBST1_TAC) then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPECL(
            PairList [
              @hol|{n - 1}|,
              @hol|{k DELETE (i:K)}|
            ]
          )
        )
      ) then_tac \
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            @hol|{n - 1 < n <=> ~(n = 0)}|
          )
        ]
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_DELETE, CARD_DELETE]) then_tac \
      ANTS_TAC then_list \
      PairList [
        ASM_MESON_TAC(PairList [CARD_EQ_0]),
        DISCH_THEN(SUBST1_TAC)
      ] then_tac \
      FIRST_X_ASSUM(
        o(
          o(
            o(MP_TAC)(
              ISPECL(
                PairList [
                  @hol|{f:K->A}|,
                  @hol|{i:K}|,
                  @hol|{k DELETE (i:K)}|
                ]
              )
            )
          )(CONJUNCT2)
        )(MATCH_MP(ITERATE_CLAUSES))
      ) then_tac \
      ASM_REWRITE_TAC(PairList [FINITE_DELETE, IN_DELETE]) then_tac \
      ASM_SIMP_TAC(
        PairList [
          SET_RULE(
            @hol|{i IN k ==> i INSERT (k DELETE i) = k}|
          )
        ]
      )
    ]
  )

def ITERATO_CLAUSES_NUMSEG_LEFT:
  prove(
    [
      @hol|{!dom neut op (f:num->A) m n.
         iterato dom neut op (<=) (m..n) f =
           if m <= n then
             if f m IN dom ==> f m = neut
             then iterato dom neut op (<=) (m+1..n) f
             else op (f m) (iterato dom neut op (<=) (m+1..n) f)
           else neut}|,
      REPEAT(GEN_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{dom:A->bool}|,
            @hol|{neut:A}|,
            @hol|{op:A->A->A}|,
            @hol|{(<=):num->num->bool}|,
            @hol|{f:num->A}|
          ])(
          ITERATO_CLAUSES_GEN
        )
      ) then_tac \
      COND_CASES_TAC then_list \
      PairList [
        DISCH_THEN((fun(th): (ASM_SIMP_TAC(PairList [GSYM(NUMSEG_LREC)]) then_tac MP_TAC(th)))),
        DISCH_THEN(o(MP_TAC)(CONJUNCT1)) then_tac \
        ASM_MESON_TAC(PairList [NUMSEG_EMPTY, NOT_LE])
      ] then_tac \
      DISCH_THEN(
        o(
          o(MP_TAC)(
            SPECL(
              PairList [
                @hol|{m:num}|,
                @hol|{m+1..n}|
              ]
            )
          )
        )(CONJUNCT2)
      ) then_tac \
      ANTS_TAC then_list \
      PairList [
        SIMP_TAC(PairList [FINITE_RESTRICT, FINITE_NUMSEG, IN_NUMSEG]) then_tac \
        ARITH_TAC,
        REWRITE_TAC(
          PairList [
            IN_NUMSEG,
            ARITH_RULE(
              @hol|{~(m + 1 <= m)}|
            )
          ]
        )
      ]
    ]
  )

def nproduct:
  new_definition(
    @hol|{nproduct:(A->bool)->(A->num)->num = iterate(( * ):num->num->num)}|
  )

def NEUTRAL_MUL:
  prove(
    [
      @hol|{neutral(( * ):num->num->num) = 1}|,
      REWRITE_TAC(PairList [neutral]) then_tac MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      MESON_TAC(PairList [MULT_CLAUSES, MULT_EQ_1])
    ]
  )

def MONOIDAL_MUL:
  prove(
    [
      @hol|{monoidal(( * ):num->num->num)}|,
      REWRITE_TAC(PairList [monoidal, NEUTRAL_MUL]) then_tac ARITH_TAC
    ]
  )

def NPRODUCT_CLAUSES:
  prove(
    [
      @hol|{(!f:A->num. nproduct {} f = 1) /\
         (!x (f:B->num) s.
              FINITE(s)
              ==> (nproduct (x INSERT s) f =
                   if x IN s then nproduct s f else f(x) * nproduct s f))}|,
      REWRITE_TAC(PairList [nproduct, GSYM(NEUTRAL_MUL)]) then_tac \
      ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
      MATCH_MP_TAC(ITERATE_CLAUSES) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_MUL])
    ]
  )

def iproduct:
  new_definition(
    @hol|{iproduct:(A->bool)->(A->int)->int = iterate (( * ):int->int->int)}|
  )

def NEUTRAL_INT_MUL:
  prove(
    [
      @hol|{neutral(( * ):int->int->int) = &1}|,
      REWRITE_TAC(PairList [neutral]) then_tac MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      MESON_TAC(PairList [INT_MUL_LID, INT_MUL_RID])
    ]
  )

def MONOIDAL_INT_MUL:
  prove(
    [
      @hol|{monoidal(( * ):int->int->int)}|,
      REWRITE_TAC(PairList [monoidal, NEUTRAL_INT_MUL]) then_tac INT_ARITH_TAC
    ]
  )

def IPRODUCT_CLAUSES:
  prove(
    [
      @hol|{(!f:A->int. iproduct {} f = &1) /\
         (!x (f:B->int) s.
              FINITE(s)
              ==> (iproduct (x INSERT s) f =
                   if x IN s then iproduct s f else f(x) * iproduct s f))}|,
      REWRITE_TAC(PairList [iproduct, GSYM(NEUTRAL_INT_MUL)]) then_tac \
      ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
      MATCH_MP_TAC(ITERATE_CLAUSES) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_INT_MUL])
    ]
  )

def product:
  new_definition(
    @hol|{product:(A->bool)->(A->real)->real = iterate (( * ):real->real->real)}|
  )

def NEUTRAL_REAL_MUL:
  prove(
    [
      @hol|{neutral(( * ):real->real->real) = &1}|,
      REWRITE_TAC(PairList [neutral]) then_tac MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      MESON_TAC(PairList [REAL_MUL_LID, REAL_MUL_RID])
    ]
  )

def MONOIDAL_REAL_MUL:
  prove(
    [
      @hol|{monoidal(( * ):real->real->real)}|,
      REWRITE_TAC(PairList [monoidal, NEUTRAL_REAL_MUL]) then_tac REAL_ARITH_TAC
    ]
  )

def PRODUCT_CLAUSES:
  prove(
    [
      @hol|{(!f:A->real. product {} f = &1) /\
         (!x (f:B->real) s.
              FINITE(s)
              ==> (product (x INSERT s) f =
                   if x IN s then product s f else f(x) * product s f))}|,
      REWRITE_TAC(PairList [product, GSYM(NEUTRAL_REAL_MUL)]) then_tac \
      ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
      MATCH_MP_TAC(ITERATE_CLAUSES) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_MUL])
    ]
  )

def isum:
  new_definition(
    @hol|{isum:(A->bool)->(A->int)->int = iterate((+):int->int->int)}|
  )

def NEUTRAL_INT_ADD:
  prove(
    [
      @hol|{neutral((+):int->int->int) = &0}|,
      REWRITE_TAC(PairList [neutral]) then_tac MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      MESON_TAC(PairList [INT_ADD_LID, INT_ADD_RID])
    ]
  )

def MONOIDAL_INT_ADD:
  prove(
    [
      @hol|{monoidal((+):int->int->int)}|,
      REWRITE_TAC(PairList [monoidal, NEUTRAL_INT_ADD]) then_tac INT_ARITH_TAC
    ]
  )

def ISUM_CLAUSES:
  prove(
    [
      @hol|{(!f:A->int. isum {} f = &0) /\
         (!x (f:B->int) s.
              FINITE(s)
              ==> (isum (x INSERT s) f =
                   if x IN s then isum s f else f(x) + isum s f))}|,
      REWRITE_TAC(PairList [isum, GSYM(NEUTRAL_INT_ADD)]) then_tac \
      ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
      MATCH_MP_TAC(ITERATE_CLAUSES) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_INT_ADD])
    ]
  )

prioritize_num(#void)

def nsum:
  new_definition(
    @hol|{nsum:(A->bool)->(A->num)->num = iterate (+)}|
  )

def NEUTRAL_ADD:
  prove(
    [
      @hol|{neutral((+):num->num->num) = 0}|,
      REWRITE_TAC(PairList [neutral]) then_tac MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      MESON_TAC(PairList [ADD_CLAUSES])
    ]
  )

def MONOIDAL_ADD:
  prove(
    [
      @hol|{monoidal((+):num->num->num)}|,
      REWRITE_TAC(PairList [monoidal, NEUTRAL_ADD]) then_tac ARITH_TAC
    ]
  )

def NSUM_DEGENERATE:
  prove(
    [
      @hol|{!f s:A->bool. ~(FINITE {x | x IN s /\ ~(f x = 0)}) ==> nsum s f = 0}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [nsum]) then_tac \
      SIMP_TAC(PairList [iterate, support, NEUTRAL_ADD])
    ]
  )

def NSUM_CLAUSES:
  prove(
    [
      @hol|{(!f:A->num. nsum {} f = 0) /\
         (!x (f:B->num) s.
              FINITE(s)
              ==> (nsum (x INSERT s) f =
                   if x IN s then nsum s f else f(x) + nsum s f))}|,
      REWRITE_TAC(PairList [nsum, GSYM(NEUTRAL_ADD)]) then_tac \
      ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
      MATCH_MP_TAC(ITERATE_CLAUSES) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_UNION:
  prove(
    [
      @hol|{!f s t:A->bool.
         FINITE s /\ FINITE t /\ DISJOINT s t
         ==> nsum (s UNION t) f = nsum s f + nsum t f}|,
      SIMP_TAC(PairList [nsum, ITERATE_UNION, MONOIDAL_ADD])
    ]
  )

def NSUM_DIFF:
  prove(
    [
      @hol|{!f s t:A->bool.
         FINITE s /\ t SUBSET s
         ==> nsum (s DIFF t) f = nsum s f - nsum t f}|,
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(
        ARITH_RULE(
          @hol|{(x + z = y:num) ==> (x = y - z)}|
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [nsum, ITERATE_DIFF, MONOIDAL_ADD])
    ]
  )

def NSUM_INCL_EXCL:
  prove(
    [
      @hol|{!s t (f:A->num).
         FINITE s /\ FINITE t
         ==> nsum s f + nsum t f = nsum (s UNION t) f + nsum (s INTER t) f}|,
      REWRITE_TAC(PairList [nsum, GSYM(NEUTRAL_ADD)]) then_tac \
      MATCH_MP_TAC(ITERATE_INCL_EXCL) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_SUPPORT:
  prove(
    [
      @hol|{!f s:A->bool. nsum (support (+) f s) f = nsum s f}|,
      SIMP_TAC(PairList [nsum, iterate, SUPPORT_SUPPORT])
    ]
  )

def NSUM_ADD:
  prove(
    [
      @hol|{!f g s:A->bool.
         FINITE s ==> (nsum s (\x. f(x) + g(x)) = nsum s f + nsum s g)}|,
      SIMP_TAC(PairList [nsum, ITERATE_OP, MONOIDAL_ADD])
    ]
  )

def NSUM_ADD_GEN:
  prove(
    [
      @hol|{!f g s:A->bool.
         FINITE {x | x IN s /\ ~(f x = 0)} /\ FINITE {x | x IN s /\ ~(g x = 0)}
         ==> nsum s (\x. f x + g x) = nsum s f + nsum s g}|,
      REWRITE_TAC(PairList [GSYM(NEUTRAL_ADD), GSYM(support), nsum]) then_tac \
      MATCH_MP_TAC(ITERATE_OP_GEN) then_tac \
      ACCEPT_TAC(MONOIDAL_ADD)
    ]
  )

def NSUM_EQ_0:
  prove(
    [
      @hol|{!f s:A->bool. (!x. x IN s ==> f(x) = 0) ==> nsum s f = 0}|,
      REWRITE_TAC(PairList [nsum, GSYM(NEUTRAL_ADD)]) then_tac \
      SIMP_TAC(PairList [ITERATE_EQ_NEUTRAL, MONOIDAL_ADD])
    ]
  )

def NSUM_0:
  prove(
    [
      @hol|{!s:A->bool. nsum s (\n. 0) = 0}|,
      SIMP_TAC(PairList [NSUM_EQ_0])
    ]
  )

def NSUM_LMUL:
  prove(
    [
      @hol|{!f c s:A->bool. nsum s (\x. c * f(x)) = c * nsum s f}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{c = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES, NSUM_0]) then_tac \
      REWRITE_TAC(PairList [nsum]) then_tac \
      ONCE_REWRITE_TAC(PairList [ITERATE_EXPAND_CASES]) then_tac \
      SUBGOAL_THEN(
        @hol|{support (+) (\x:A. c * f(x)) s = support (+) f s}|
      )(SUBST1_TAC) then_list \
      PairList [ASM_SIMP_TAC(PairList [support, MULT_EQ_0, NEUTRAL_ADD]), ALL_TAC] then_tac \
      COND_CASES_TAC then_tac \
      REWRITE_TAC(PairList [NEUTRAL_ADD, MULT_CLAUSES]) then_tac \
      UNDISCH_TAC(
        @hol|{FINITE (support (+) f (s:A->bool))}|
      ) then_tac \
      SPEC_TAC(
        [
          @hol|{support (+) f (s:A->bool)}|,
          @hol|{t:A->bool}|
        ]
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(nsum)]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [NSUM_CLAUSES, MULT_CLAUSES, LEFT_ADD_DISTRIB])
    ]
  )

def NSUM_RMUL:
  prove(
    [
      @hol|{!f c s:A->bool. nsum s (\x. f(x) * c) = nsum s f * c}|,
      ONCE_REWRITE_TAC(PairList [MULT_SYM]) then_tac REWRITE_TAC(PairList [NSUM_LMUL])
    ]
  )

def NSUM_LE:
  prove(
    [
      @hol|{!f g s:A->bool.
         FINITE(s) /\ (!x. x IN s ==> f(x) <= g(x))
         ==> nsum s f <= nsum s g}|,
      ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac GEN_TAC then_tac \
      GEN_TAC then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [NSUM_CLAUSES, LE_REFL, LE_ADD2, IN_INSERT])
    ]
  )

def NSUM_LT:
  prove(
    [
      @hol|{!f g s:A->bool.
         FINITE(s) /\ (!x. x IN s ==> f(x) <= g(x)) /\
         (?x. x IN s /\ f(x) < g(x))
         ==> nsum s f < nsum s g}|,
      REPEAT(GEN_TAC) then_tac \
      REPEAT(DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC))) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{a:A}|)(STRIP_ASSUME_TAC)) then_tac \
      SUBGOAL_THEN(
        @hol|{s = (a:A) INSERT (s DELETE a)}|
      )(SUBST1_TAC) then_list \
      PairList [
        UNDISCH_TAC(
          @hol|{a:A IN s}|
        ) then_tac \
        SET_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      ASM_SIMP_TAC(PairList [NSUM_CLAUSES, FINITE_DELETE, IN_DELETE]) then_tac \
      ASM_SIMP_TAC(PairList [LTE_ADD2, NSUM_LE, IN_DELETE, FINITE_DELETE])
    ]
  )

def NSUM_LT_ALL:
  prove(
    [
      @hol|{!f g s:A->bool.
         FINITE s /\ ~(s = {}) /\ (!x. x IN s ==> f(x) < g(x))
         ==> nsum s f < nsum s g}|,
      MESON_TAC(PairList [MEMBER_NOT_EMPTY, LT_IMP_LE, NSUM_LT])
    ]
  )

def NSUM_EQ:
  prove(
    [
      @hol|{!f g s:A->bool. (!x. x IN s ==> f x = g x) ==> nsum s f = nsum s g}|,
      REWRITE_TAC(PairList [nsum]) then_tac MATCH_MP_TAC(ITERATE_EQ) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_CONST:
  prove(
    [
      @hol|{!c s:A->bool. FINITE s ==> (nsum s (\n. c) = (CARD s) * c)}|,
      GEN_TAC then_tac MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [NSUM_CLAUSES, CARD_CLAUSES]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      ARITH_TAC
    ]
  )

def NSUM_POS_BOUND:
  prove(
    [
      @hol|{!f b s:A->bool. FINITE s /\ nsum s f <= b ==> !x:A. x IN s ==> f x <= b}|,
      GEN_TAC then_tac GEN_TAC then_tac \
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [NSUM_CLAUSES, NOT_IN_EMPTY, IN_INSERT]) then_tac \
      MESON_TAC(
        PairList [
          LE_0,
          ARITH_RULE(
            @hol|{0 <= x /\ 0 <= y /\ x + y <= b ==> x <= b /\ y <= b}|
          )
        ]
      )
    ]
  )

def NSUM_EQ_0_IFF:
  prove(
    [
      @hol|{!s:A->bool. FINITE s ==> (nsum s f = 0 <=> !x. x IN s ==> f x = 0)}|,
      REPEAT(STRIP_TAC) then_tac EQ_TAC then_tac \
      ASM_SIMP_TAC(PairList [NSUM_EQ_0]) then_tac \
      ASM_MESON_TAC(
        PairList [
          ARITH_RULE(
            @hol|{n = 0 <=> n <= 0}|
          ),
          NSUM_POS_BOUND
        ]
      )
    ]
  )

def NSUM_POS_LT:
  prove(
    [
      @hol|{!f s:A->bool.
         FINITE s /\ (?x. x IN s /\ 0 < f x)
         ==> 0 < nsum s f}|,
      SIMP_TAC(
        PairList [
          ARITH_RULE(
            @hol|{0 < n <=> ~(n = 0)}|
          ),
          NSUM_EQ_0_IFF
        ]
      ) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def NSUM_POS_LT_ALL:
  prove(
    [
      @hol|{!s f:A->num.
         FINITE s /\ ~(s = {}) /\ (!i. i IN s ==> 0 < f i) ==> 0 < nsum s f}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(NSUM_POS_LT) then_tac \
      ASM_MESON_TAC(PairList [MEMBER_NOT_EMPTY, REAL_LT_IMP_LE])
    ]
  )

def NSUM_DELETE:
  prove(
    [
      @hol|{!f s a:A. FINITE s /\ a IN s ==> f(a) + nsum(s DELETE a) f = nsum s f}|,
      SIMP_TAC(PairList [nsum, ITERATE_DELETE, MONOIDAL_ADD])
    ]
  )

def NSUM_SING:
  prove(
    [
      @hol|{!f x:A. nsum {x} f = f(x)}|,
      SIMP_TAC(PairList [NSUM_CLAUSES, FINITE_RULES, NOT_IN_EMPTY, ADD_CLAUSES])
    ]
  )

def NSUM_DELTA:
  prove(
    [
      @hol|{!s a. nsum s (\x. if x = a:A then b else 0) = if a IN s then b else 0}|,
      REWRITE_TAC(PairList [nsum, GSYM(NEUTRAL_ADD)]) then_tac \
      SIMP_TAC(PairList [ITERATE_DELTA, MONOIDAL_ADD])
    ]
  )

def NSUM_SWAP:
  prove(
    [
      @hol|{!f:A->B->num s t.
         FINITE(s) /\ FINITE(t)
         ==> (nsum s (\i. nsum t (f i)) = nsum t (\j. nsum s (\i. f i j)))}|,
      GEN_TAC then_tac \
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [NSUM_CLAUSES, NSUM_0, NSUM_ADD, ETA_AX])
    ]
  )

def NSUM_IMAGE:
  prove(
    [
      @hol|{!(f:A->B) g s.
         (!x y. x IN s /\ y IN s /\ (f x = f y) ==> (x = y))
         ==> (nsum (IMAGE f s) g = nsum s (g o f))}|,
      REWRITE_TAC(PairList [nsum, GSYM(NEUTRAL_ADD)]) then_tac \
      MATCH_MP_TAC(ITERATE_IMAGE) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_SUPERSET:
  prove(
    [
      @hol|{!f:A->num u v.
         u SUBSET v /\ (!x. x IN v /\ ~(x IN u) ==> (f(x) = 0))
         ==> (nsum v f = nsum u f)}|,
      SIMP_TAC(PairList [nsum, GSYM(NEUTRAL_ADD), ITERATE_SUPERSET, MONOIDAL_ADD])
    ]
  )

def NSUM_UNIV:
  prove(
    [
      @hol|{!f:A->num s. support (+) f (:A) SUBSET s ==> nsum s f = nsum (:A) f}|,
      REWRITE_TAC(PairList [nsum]) then_tac MATCH_MP_TAC(ITERATE_UNIV) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_UNION_RZERO:
  let lemma:
    prove(
      [
        @hol|{u UNION v = u UNION (v DIFF u)}|,
        SET_TAC(PairList [])
      ]
    )
  prove(
    [
      @hol|{!f:A->num u v.
         FINITE u /\ (!x. x IN v /\ ~(x IN u) ==> (f(x) = 0))
         ==> nsum (u UNION v) f = nsum u f}|,
      REPEAT(STRIP_TAC) then_tac ONCE_REWRITE_TAC(PairList [lemma]) then_tac \
      MATCH_MP_TAC(NSUM_SUPERSET) then_tac \
      ASM_MESON_TAC(PairList [IN_UNION, IN_DIFF, SUBSET])
    ]
  )

def NSUM_UNION_LZERO:
  prove(
    [
      @hol|{!f:A->num u v.
         FINITE v /\ (!x. x IN u /\ ~(x IN v) ==> (f(x) = 0))
         ==> nsum (u UNION v) f = nsum v f}|,
      MESON_TAC(PairList [NSUM_UNION_RZERO, UNION_COMM])
    ]
  )

def NSUM_RESTRICT:
  prove(
    [
      @hol|{!f s:A->bool.
         FINITE s ==> nsum s (\x. if x IN s then f(x) else 0) = nsum s f}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(NSUM_EQ) then_tac \
      ASM_SIMP_TAC(PairList [])
    ]
  )

def NSUM_BOUND:
  prove(
    [
      @hol|{!s f b. FINITE s /\ (!x:A. x IN s ==> f(x) <= b)
         ==> nsum s f <= (CARD s) * b}|,
      SIMP_TAC(PairList [GSYM(NSUM_CONST), NSUM_LE])
    ]
  )

def NSUM_BOUND_GEN:
  prove(
    [
      @hol|{!s f b. FINITE s /\ ~(s = {}) /\ (!x:A. x IN s ==> f(x) <= b DIV (CARD s))
         ==> nsum s f <= b}|,
      SIMP_TAC(PairList [IMP_CONJ, CARD_EQ_0, LE_RDIV_EQ]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{nsum s (\x. CARD(s:A->bool) * f x) <= CARD s * b}|
      )(MP_TAC) then_list \
      PairList [
        ASM_SIMP_TAC(PairList [NSUM_BOUND]),
        ASM_SIMP_TAC(PairList [NSUM_LMUL, LE_MULT_LCANCEL, CARD_EQ_0])
      ]
    ]
  )

def NSUM_BOUND_LT:
  prove(
    [
      @hol|{!s f b. FINITE s /\ (!x:A. x IN s ==> f x <= b) /\ (?x. x IN s /\ f x < b)
         ==> nsum s f < (CARD s) * b}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(LTE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{nsum s (\x:A. b)}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(NSUM_LT) then_tac ASM_REWRITE_TAC(PairList []) then_tac \
        ASM_MESON_TAC(PairList []),
        ASM_SIMP_TAC(PairList [NSUM_CONST, LE_REFL])
      ]
    ]
  )

def NSUM_BOUND_LT_ALL:
  prove(
    [
      @hol|{!s f b. FINITE s /\ ~(s = {}) /\ (!x:A. x IN s ==> f(x) < b)
         ==> nsum s f < (CARD s) * b}|,
      MESON_TAC(PairList [MEMBER_NOT_EMPTY, LT_IMP_LE, NSUM_BOUND_LT])
    ]
  )

def NSUM_BOUND_LT_GEN:
  prove(
    [
      @hol|{!s f b. FINITE s /\ ~(s = {}) /\ (!x:A. x IN s ==> f(x) < b DIV (CARD s))
         ==> nsum s f < b}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(LTE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{nsum (s:A->bool) (\a. f(a) + 1)}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(NSUM_LT_ALL) then_tac ASM_SIMP_TAC(PairList []) then_tac \
        ARITH_TAC,
        MATCH_MP_TAC(NSUM_BOUND_GEN) then_tac \
        ASM_REWRITE_TAC(
          PairList [
            ARITH_RULE(
              @hol|{a + 1 <= b <=> a < b}|
            )
          ]
        )
      ]
    ]
  )

def NSUM_UNION_EQ:
  prove(
    [
      @hol|{!s t u:A->bool.
         FINITE u /\ (s INTER t = {}) /\ (s UNION t = u)
         ==> nsum s f + nsum t f = nsum u f}|,
      MESON_TAC(PairList [NSUM_UNION, DISJOINT, FINITE_SUBSET, SUBSET_UNION])
    ]
  )

def NSUM_EQ_SUPERSET:
  prove(
    [
      @hol|{!f s t:A->bool.
         FINITE t /\ t SUBSET s /\
         (!x. x IN t ==> (f x = g x)) /\
         (!x. x IN s /\ ~(x IN t) ==> (f(x) = 0))
         ==> (nsum s f = nsum t g)}|,
      MESON_TAC(PairList [NSUM_SUPERSET, NSUM_EQ])
    ]
  )

def NSUM_RESTRICT_SET:
  prove(
    [
      @hol|{!P s f. nsum {x:A | x IN s /\ P x} f = nsum s (\x. if P x then f(x) else 0)}|,
      REWRITE_TAC(PairList [nsum, GSYM(NEUTRAL_ADD)]) then_tac \
      MATCH_MP_TAC(ITERATE_RESTRICT_SET) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_NSUM_RESTRICT:
  prove(
    [
      @hol|{!(R:A->B->bool) f s t.
         FINITE s /\ FINITE t
         ==> (nsum s (\x. nsum {y | y IN t /\ R x y} (\y. f x y)) =
              nsum t (\y. nsum {x | x IN s /\ R x y} (\x. f x y)))}|,
      REPEAT(GEN_TAC) then_tac SIMP_TAC(PairList [NSUM_RESTRICT_SET]) then_tac \
      DISCH_THEN((fun(th): REWRITE_TAC(PairList [MATCH_MP(NSUM_SWAP)(th)])))
    ]
  )

def CARD_EQ_NSUM:
  prove(
    [
      @hol|{!s:A->bool. FINITE s ==> ((CARD s) = nsum s (\x. 1))}|,
      SIMP_TAC(PairList [NSUM_CONST, MULT_CLAUSES])
    ]
  )

def NSUM_MULTICOUNT_GEN:
  prove(
    [
      @hol|{!R:A->B->bool s t k.
         FINITE s /\ FINITE t /\
         (!j. j IN t ==> (CARD {i | i IN s /\ R i j} = k(j)))
         ==> (nsum s (\i. (CARD {j | j IN t /\ R i j})) =
              nsum t (\i. (k i)))}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [CONJ_ASSOC]) then_tac \
      DISCH_THEN(CONJUNCTS_THEN(ASSUME_TAC)) then_tac \
      MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{nsum s (\i:A. nsum {j:B | j IN t /\ R i j} (\j. 1))}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(NSUM_EQ) then_tac ASM_REWRITE_TAC(PairList []) then_tac \
        REPEAT(STRIP_TAC) then_tac \
        ASM_SIMP_TAC(PairList [CARD_EQ_NSUM, FINITE_RESTRICT]),
        FIRST_ASSUM((fun(t): ONCE_REWRITE_TAC(PairList [MATCH_MP(NSUM_NSUM_RESTRICT)(t)]))) then_tac \
        MATCH_MP_TAC(NSUM_EQ) then_tac \
        ASM_SIMP_TAC(PairList [NSUM_CONST, FINITE_RESTRICT]) then_tac \
        REWRITE_TAC(PairList [MULT_CLAUSES])
      ]
    ]
  )

def NSUM_MULTICOUNT:
  prove(
    [
      @hol|{!R:A->B->bool s t k.
         FINITE s /\ FINITE t /\
         (!j. j IN t ==> (CARD {i | i IN s /\ R i j} = k))
         ==> (nsum s (\i. (CARD {j | j IN t /\ R i j})) = (k * CARD t))}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{nsum t (\i:B. k)}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(NSUM_MULTICOUNT_GEN) then_tac ASM_REWRITE_TAC(PairList []),
        ASM_SIMP_TAC(PairList [NSUM_CONST]) then_tac REWRITE_TAC(PairList [MULT_AC])
      ]
    ]
  )

def NSUM_IMAGE_GEN:
  prove(
    [
      @hol|{!f:A->B g s.
         FINITE s
         ==> nsum s g =
             nsum (IMAGE f s) (\y. nsum {x | x IN s /\ f x = y} g)}|,
      REWRITE_TAC(PairList [nsum]) then_tac MATCH_MP_TAC(ITERATE_IMAGE_GEN) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_GROUP:
  prove(
    [
      @hol|{!f:A->B g s t.
         FINITE s /\ IMAGE f s SUBSET t
         ==> nsum t (\y. nsum {x | x IN s /\ f(x) = y} g) = nsum s g}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:A->B}|,
            @hol|{g:A->num}|,
            @hol|{s:A->bool}|
          ])(
          NSUM_IMAGE_GEN
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_THEN(SUBST1_TAC) then_tac \
      MATCH_MP_TAC(NSUM_SUPERSET) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(NSUM_EQ_0) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def NSUM_GROUP_RELATION:
  prove(
    [
      @hol|{!R:A->B->bool g s t.
         FINITE s /\
         (!x. x IN s ==> ?!y. y IN t /\ R x y)
         ==> nsum t (\y. nsum {x | x IN s /\ R x y} g) = nsum s g}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{\x:A. @y:B. y IN t /\ R x y}|,
            @hol|{g:A->num}|,
            @hol|{s:A->bool}|,
            @hol|{t:B->bool}|
          ])(
          NSUM_GROUP
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [SUBSET, FORALL_IN_IMAGE]) then_tac \
      ANTS_TAC then_list \
      PairList [
        ASM_MESON_TAC(PairList []),
        DISCH_THEN(o(SUBST1_TAC)(SYM))
      ] then_tac \
      MATCH_MP_TAC(NSUM_EQ) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      AP_THM_TAC then_tac \
      AP_TERM_TAC then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def NSUM_SUBSET:
  prove(
    [
      @hol|{!u v f. FINITE u /\ FINITE v /\ (!x:A. x IN (u DIFF v) ==> f(x) = 0)
         ==> nsum u f <= nsum v f}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:A->num}|,
            @hol|{u INTER v :A->bool}|
          ])(
          NSUM_UNION
        )
      ) then_tac \
      DISCH_THEN(
        fun(th):
          (
            MP_TAC(
              SPEC(
                @hol|{v DIFF u :A->bool}|
              )(th)
            ) then_tac \
            MP_TAC(
              SPEC(
                @hol|{u DIFF v :A->bool}|
              )(th)
            )
          )
      ) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{(u INTER v) UNION (u DIFF v) = u}|
          ),
          SET_RULE(
            @hol|{(u INTER v) UNION (v DIFF u) = v}|
          )
        ]
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_DIFF, FINITE_INTER]) then_tac \
      REPEAT(
        ANTS_TAC then_list \
        PairList [SET_TAC(PairList []), DISCH_THEN(SUBST1_TAC)]
      ) then_tac \
      ASM_SIMP_TAC(PairList [NSUM_EQ_0]) then_tac \
      ARITH_TAC
    ]
  )

def NSUM_SUBSET_SIMPLE:
  prove(
    [
      @hol|{!u v f:A->num. FINITE v /\ u SUBSET v ==> nsum u f <= nsum v f}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(NSUM_SUBSET) then_tac \
      ASM_MESON_TAC(PairList [IN_DIFF, SUBSET, FINITE_SUBSET])
    ]
  )

def NSUM_LE_GEN:
  prove(
    [
      @hol|{!f g s. (!x:A. x IN s ==> f x <= g x) /\ FINITE {x | x IN s /\ ~(g x = 0)}
         ==> nsum s f <= nsum s g}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(NSUM_SUPPORT)]) then_tac \
      REWRITE_TAC(PairList [support, NEUTRAL_ADD]) then_tac \
      TRANS_TAC(LE_TRANS)(
        @hol|{nsum {x | x IN s /\ ~(g(x:A) = 0)} f}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(NSUM_SUBSET) then_tac \
        ASM_REWRITE_TAC(PairList [IN_ELIM_THM, IN_DIFF]) then_tac \
        CONJ_TAC then_list \
        PairList [ALL_TAC, ASM_MESON_TAC(PairList [LE])] then_tac \
        FIRST_X_ASSUM(
          o(MATCH_MP_TAC)(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ])(FINITE_SUBSET)))
        ) then_tac \
        REWRITE_TAC(PairList [SUBSET, IN_ELIM_THM]) then_tac \
        ASM_MESON_TAC(PairList [LE]),
        MATCH_MP_TAC(NSUM_LE) then_tac ASM_SIMP_TAC(PairList [IN_ELIM_THM])
      ]
    ]
  )

def NSUM_MUL_BOUND:
  prove(
    [
      @hol|{!a b s:A->bool.
         FINITE s
         ==> nsum s (\i. a i * b i) <= nsum s a * nsum s b}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [GSYM(NSUM_LMUL)]) then_tac \
      MATCH_MP_TAC(NSUM_LE) then_tac \
      ASM_REWRITE_TAC(PairList [LE_MULT_RCANCEL]) then_tac \
      X_GEN_TAC(@hol|{i:A}|) then_tac \
      DISCH_TAC then_tac \
      DISJ1_TAC then_tac \
      ASM_SIMP_TAC(PairList []) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(NSUM_SING)]) then_tac \
      MATCH_MP_TAC(NSUM_SUBSET_SIMPLE) then_tac \
      ASM_SIMP_TAC(PairList [SING_SUBSET, IN_DIFF])
    ]
  )

def NSUM_IMAGE_NONZERO:
  prove(
    [
      @hol|{!d:B->num i:A->B s.
         FINITE s /\
         (!x y. x IN s /\ y IN s /\ ~(x = y) /\ i x = i y ==> d(i x) = 0)
         ==> nsum (IMAGE i s) d = nsum s (d o i)}|,
      REWRITE_TAC(PairList [GSYM(NEUTRAL_ADD), nsum]) then_tac \
      MATCH_MP_TAC(ITERATE_IMAGE_NONZERO) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_BIJECTION:
  prove(
    [
      @hol|{!f p s:A->bool.
         (!x. x IN s ==> p(x) IN s) /\
         (!y. y IN s ==> ?!x. x IN s /\ p(x) = y)
         ==> nsum s f = nsum s (f o p)}|,
      REWRITE_TAC(PairList [nsum]) then_tac MATCH_MP_TAC(ITERATE_BIJECTION) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_NSUM_PRODUCT:
  prove(
    [
      @hol|{!s:A->bool t:A->B->bool x.
         FINITE s /\ (!i. i IN s ==> FINITE(t i))
         ==> nsum s (\i. nsum (t i) (x i)) =
             nsum {i,j | i IN s /\ j IN t i} (\(i,j). x i j)}|,
      REWRITE_TAC(PairList [nsum]) then_tac MATCH_MP_TAC(ITERATE_ITERATE_PRODUCT) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_EQ_GENERAL:
  prove(
    [
      @hol|{!s:A->bool t:B->bool f g h.
         (!y. y IN t ==> ?!x. x IN s /\ h(x) = y) /\
         (!x. x IN s ==> h(x) IN t /\ g(h x) = f x)
         ==> nsum s f = nsum t g}|,
      REWRITE_TAC(PairList [nsum]) then_tac MATCH_MP_TAC(ITERATE_EQ_GENERAL) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_EQ_GENERAL_INVERSES:
  prove(
    [
      @hol|{!s:A->bool t:B->bool f g h k.
         (!y. y IN t ==> k(y) IN s /\ h(k y) = y) /\
         (!x. x IN s ==> h(x) IN t /\ k(h x) = x /\ g(h x) = f x)
         ==> nsum s f = nsum t g}|,
      REWRITE_TAC(PairList [nsum]) then_tac MATCH_MP_TAC(ITERATE_EQ_GENERAL_INVERSES) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_INJECTION:
  prove(
    [
      @hol|{!f p s:A->bool.
         FINITE s /\
         (!x. x IN s ==> p x IN s) /\
         (!x y. x IN s /\ y IN s /\ p x = p y ==> x = y)
         ==> nsum s (f o p) = nsum s f}|,
      REWRITE_TAC(PairList [nsum]) then_tac MATCH_MP_TAC(ITERATE_INJECTION) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_UNION_NONZERO:
  prove(
    [
      @hol|{!f s t:A->bool.
         FINITE s /\ FINITE t /\ (!x. x IN s INTER t ==> f(x) = 0)
         ==> nsum (s UNION t) f = nsum s f + nsum t f}|,
      REWRITE_TAC(PairList [nsum, GSYM(NEUTRAL_ADD)]) then_tac \
      MATCH_MP_TAC(ITERATE_UNION_NONZERO) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_UNIONS_NONZERO:
  prove(
    [
      @hol|{!f s. FINITE s /\ (!t:A->bool. t IN s ==> FINITE t) /\
         (!t1 t2 x. t1 IN s /\ t2 IN s /\ ~(t1 = t2) /\ x IN t1 /\ x IN t2
                    ==> f x = 0)
         ==> nsum (UNIONS s) f = nsum s (\t. nsum t f)}|,
      GEN_TAC then_tac ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [UNIONS_0, UNIONS_INSERT, NSUM_CLAUSES, IN_INSERT]) then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{t:A->bool}|,
          @hol|{s:(A->bool)->bool}|
        ]
      ) then_tac \
      DISCH_THEN((fun(th): (STRIP_TAC then_tac MP_TAC(th)))) then_tac \
      ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      ASM_SIMP_TAC(PairList [NSUM_CLAUSES]) then_tac \
      ANTS_TAC then_list \
      PairList [
        ASM_MESON_TAC(PairList []),
        DISCH_THEN(o(SUBST_ALL_TAC)(SYM))
      ] then_tac \
      STRIP_TAC then_tac \
      MATCH_MP_TAC(NSUM_UNION_NONZERO) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_UNIONS, IN_INTER, IN_UNIONS]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def NSUM_CASES:
  prove(
    [
      @hol|{!s P f g. FINITE s
         ==> nsum s (\x:A. if P x then f x else g x) =
             nsum {x | x IN s /\ P x} f + nsum {x | x IN s /\ ~P x} g}|,
      REWRITE_TAC(PairList [nsum, GSYM(NEUTRAL_ADD)]) then_tac \
      MATCH_MP_TAC(ITERATE_CASES) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_ADD])
    ]
  )

def NSUM_CLOSED:
  prove(
    [
      @hol|{!P f:A->num s.
         P(0) /\ (!x y. P x /\ P y ==> P(x + y)) /\ (!a. a IN s ==> P(f a))
         ==> P(nsum s f)}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(MATCH_MP(ITERATE_CLOSED)(MONOIDAL_ADD)) then_tac \
      DISCH_THEN(o(MP_TAC)(SPEC(@hol|{P:num->bool}|))) then_tac \
      ASM_SIMP_TAC(PairList [NEUTRAL_ADD, GSYM(nsum)])
    ]
  )

def NSUM_RELATED:
  prove(
    [
      @hol|{!R (f:A->num) g s.
         R 0 0 /\
         (!m n m' n'. R m n /\ R m' n' ==> R (m + m') (n + n')) /\
         FINITE s /\ (!x. x IN s ==> R (f x) (g x))
         ==> R (nsum s f) (nsum s g)}|,
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      GEN_TAC then_tac \
      REPEAT(DISCH_TAC) then_tac \
      MP_TAC(
        ISPEC(@hol|{R:num->num->bool}|)(MATCH_MP(ITERATE_RELATED)(MONOIDAL_ADD))
      ) then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(nsum), NEUTRAL_ADD]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def NSUM_CLOSED_NONEMPTY:
  prove(
    [
      @hol|{!P f:A->num s.
         FINITE s /\ ~(s = {}) /\
         (!x y. P x /\ P y ==> P(x + y)) /\ (!a. a IN s ==> P(f a))
         ==> P(nsum s f)}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(MATCH_MP(ITERATE_CLOSED_NONEMPTY)(MONOIDAL_ADD)) then_tac \
      DISCH_THEN(o(MP_TAC)(SPEC(@hol|{P:num->bool}|))) then_tac \
      ASM_SIMP_TAC(PairList [NEUTRAL_ADD, GSYM(nsum)])
    ]
  )

def NSUM_RELATED_NONEMPTY:
  prove(
    [
      @hol|{!R (f:A->num) g s.
         (!m n m' n'. R m n /\ R m' n' ==> R (m + m') (n + n')) /\
         FINITE s /\ ~(s = {}) /\ (!x. x IN s ==> R (f x) (g x))
         ==> R (nsum s f) (nsum s g)}|,
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      GEN_TAC then_tac \
      REPEAT(DISCH_TAC) then_tac \
      MP_TAC(
        ISPEC(@hol|{R:num->num->bool}|)(MATCH_MP(ITERATE_RELATED_NONEMPTY)(MONOIDAL_ADD))
      ) then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(nsum), NEUTRAL_ADD]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def NSUM_ADD_NUMSEG:
  prove(
    [
      @hol|{!f g m n. nsum(m..n) (\i. f(i) + g(i)) = nsum(m..n) f + nsum(m..n) g}|,
      SIMP_TAC(PairList [NSUM_ADD, FINITE_NUMSEG])
    ]
  )

def NSUM_LE_NUMSEG:
  prove(
    [
      @hol|{!f g m n. (!i. m <= i /\ i <= n ==> f(i) <= g(i))
         ==> nsum(m..n) f <= nsum(m..n) g}|,
      SIMP_TAC(PairList [NSUM_LE, FINITE_NUMSEG, IN_NUMSEG])
    ]
  )

def NSUM_EQ_NUMSEG:
  prove(
    [
      @hol|{!f g m n. (!i. m <= i /\ i <= n ==> (f(i) = g(i)))
         ==> (nsum(m..n) f = nsum(m..n) g)}|,
      MESON_TAC(PairList [NSUM_EQ, FINITE_NUMSEG, IN_NUMSEG])
    ]
  )

def NSUM_CONST_NUMSEG:
  prove(
    [
      @hol|{!c m n. nsum(m..n) (\n. c) = ((n + 1) - m) * c}|,
      SIMP_TAC(PairList [NSUM_CONST, FINITE_NUMSEG, CARD_NUMSEG])
    ]
  )

def NSUM_EQ_0_NUMSEG:
  prove(
    [
      @hol|{!f m n. (!i. m <= i /\ i <= n ==> (f(i) = 0)) ==> (nsum(m..n) f = 0)}|,
      SIMP_TAC(PairList [NSUM_EQ_0, IN_NUMSEG])
    ]
  )

def NSUM_EQ_0_IFF_NUMSEG:
  prove(
    [
      @hol|{!f m n. nsum (m..n) f = 0 <=> !i. m <= i /\ i <= n ==> f i = 0}|,
      SIMP_TAC(PairList [NSUM_EQ_0_IFF, FINITE_NUMSEG, IN_NUMSEG])
    ]
  )

def NSUM_TRIV_NUMSEG:
  prove(
    [
      @hol|{!f m n. n < m ==> (nsum(m..n) f = 0)}|,
      MESON_TAC(PairList [NSUM_EQ_0_NUMSEG, LE_TRANS, NOT_LT])
    ]
  )

def NSUM_SING_NUMSEG:
  prove(
    [
      @hol|{!f n. nsum(n..n) f = f(n)}|,
      SIMP_TAC(PairList [NSUM_SING, NUMSEG_SING])
    ]
  )

def NSUM_CLAUSES_NUMSEG:
  prove(
    [
      @hol|{(!m. nsum(m..0) f = if m = 0 then f(0) else 0) /\
         (!m n. nsum(m..SUC n) f = if m <= SUC n then nsum(m..n) f + f(SUC n)
                                   else nsum(m..n) f)}|,
      MP_TAC(MATCH_MP(ITERATE_CLAUSES_NUMSEG)(MONOIDAL_ADD)) then_tac \
      REWRITE_TAC(PairList [NEUTRAL_ADD, nsum])
    ]
  )

def NSUM_CLAUSES_NUMSEG_LT:
  prove(
    [
      @hol|{nsum {i | i < 0} f = 0 /\
         (!k. nsum {i | i < SUC k} f = nsum {i | i < k} f + f k)}|,
      MP_TAC(MATCH_MP(ITERATE_CLAUSES_NUMSEG_LT)(MONOIDAL_ADD)) then_tac \
      REWRITE_TAC(PairList [NEUTRAL_ADD, nsum])
    ]
  )

def NSUM_CLAUSES_NUMSEG_LE:
  prove(
    [
      @hol|{nsum {i | i <= 0} f = f 0 /\
         (!k. nsum {i | i <= SUC k} f = nsum {i | i <= k} f + f(SUC k))}|,
      MP_TAC(MATCH_MP(ITERATE_CLAUSES_NUMSEG_LE)(MONOIDAL_ADD)) then_tac \
      REWRITE_TAC(PairList [NEUTRAL_ADD, nsum])
    ]
  )

def NSUM_SWAP_NUMSEG:
  prove(
    [
      @hol|{!a b c d f.
         nsum(a..b) (\i. nsum(c..d) (f i)) =
         nsum(c..d) (\j. nsum(a..b) (\i. f i j))}|,
      REPEAT(GEN_TAC) then_tac MATCH_MP_TAC(NSUM_SWAP) then_tac \
      REWRITE_TAC(PairList [FINITE_NUMSEG])
    ]
  )

def NSUM_ADD_SPLIT:
  prove(
    [
      @hol|{!f m n p.
         m <= n + 1 ==> (nsum (m..(n+p)) f = nsum(m..n) f + nsum(n+1..n+p) f)}|,
      SIMP_TAC(
        PairList [
          NUMSEG_ADD_SPLIT,
          NSUM_UNION,
          DISJOINT_NUMSEG,
          FINITE_NUMSEG,
          ARITH_RULE(
            @hol|{x < x + 1}|
          )
        ]
      )
    ]
  )

def NSUM_OFFSET:
  prove(
    [
      @hol|{!p f m n. nsum(m+p..n+p) f = nsum(m..n) (\i. f(i + p))}|,
      SIMP_TAC(PairList [NUMSEG_OFFSET_IMAGE, NSUM_IMAGE, EQ_ADD_RCANCEL, FINITE_NUMSEG]) then_tac \
      REWRITE_TAC(PairList [o_DEF])
    ]
  )

def NSUM_OFFSET_0:
  prove(
    [
      @hol|{!f m n. m <= n ==> (nsum(m..n) f = nsum(0..n-m) (\i. f(i + m)))}|,
      SIMP_TAC(PairList [GSYM(NSUM_OFFSET), ADD_CLAUSES, SUB_ADD])
    ]
  )

def NSUM_CLAUSES_LEFT:
  prove(
    [
      @hol|{!f m n. m <= n ==> nsum(m..n) f = f(m) + nsum(m+1..n) f}|,
      SIMP_TAC(PairList [GSYM(NUMSEG_LREC), NSUM_CLAUSES, FINITE_NUMSEG, IN_NUMSEG]) then_tac \
      ARITH_TAC
    ]
  )

def NSUM_CLAUSES_RIGHT:
  prove(
    [
      @hol|{!f m n. 0 < n /\ m <= n ==> nsum(m..n) f = nsum(m..n-1) f + f(n)}|,
      GEN_TAC then_tac GEN_TAC then_tac INDUCT_TAC then_tac \
      SIMP_TAC(PairList [LT_REFL, NSUM_CLAUSES_NUMSEG, SUC_SUB1])
    ]
  )

def NSUM_PAIR:
  prove(
    [
      @hol|{!f m n. nsum(2*m..2*n+1) f = nsum(m..n) (\i. f(2*i) + f(2*i+1))}|,
      MP_TAC(MATCH_MP(ITERATE_PAIR)(MONOIDAL_ADD)) then_tac \
      REWRITE_TAC(PairList [nsum, NEUTRAL_ADD])
    ]
  )

def NSUM_REFLECT:
  prove(
    [
      @hol|{!x m n. nsum(m..n) x = if n < m then 0 else nsum(0..n-m) (\i. x(n - i))}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [nsum]) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [MATCH_MP(ITERATE_REFLECT)(MONOIDAL_ADD)]) then_tac \
      REWRITE_TAC(PairList [NEUTRAL_ADD])
    ]
  )

def MOD_NSUM_MOD:
  prove(
    [
      @hol|{!f:A->num n s.
         FINITE s ==> (nsum s f) MOD n = nsum s (\i. f(i) MOD n) MOD n}|,
      GEN_TAC then_tac GEN_TAC then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MOD_ZERO, ETA_AX]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [NSUM_CLAUSES]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(MOD_ADD_MOD)]) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(MOD_ADD_MOD)]) then_tac \
      REWRITE_TAC(PairList [MOD_MOD_REFL])
    ]
  )

def MOD_NSUM_MOD_NUMSEG:
  prove(
    [
      @hol|{!f a b n.
         (nsum(a..b) f) MOD n = nsum(a..b) (\i. f i MOD n) MOD n}|,
      MESON_TAC(PairList [MOD_NSUM_MOD, FINITE_NUMSEG])
    ]
  )

def CONG_NSUM:
  prove(
    [
      @hol|{!n (f:A->num) g s.
         FINITE s /\ (!x. x IN s ==> (f x == g x) (mod n))
         ==> (nsum s f == nsum s g) (mod n)}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{\x y:num. (x == y) (mod n)}|,
            @hol|{f:A->num}|,
            @hol|{g:A->num}|,
            @hol|{s:A->bool}|
          ])(
          NSUM_RELATED
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_THEN(MATCH_MP_TAC) then_tac \
      CONV_TAC(NUMBER_RULE)
    ]
  )

def initialization_1:
  let th:
    prove(
      [
        @hol|{(!f g s:A->bool.
                (!x. x IN s ==> f(x) = g(x))
                ==> nsum s (\i. f(i)) = nsum s g) /\
           (!f g a b. (!i. a <= i /\ i <= b ==> f(i) = g(i))
                      ==> nsum(a..b) (\i. f(i)) = nsum(a..b) g) /\
           (!f g p. (!x. p x ==> f x = g x)
                    ==> nsum {y | p y} (\i. f(i)) = nsum {y | p y} g)}|,
        REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(NSUM_EQ) then_tac \
        ASM_SIMP_TAC(PairList [IN_ELIM_THM, IN_NUMSEG])
      ]
    )
  extend_basic_congs(map(SPEC_ALL)(CONJUNCTS(th)))

def CARD_UNIONS_IMAGE:
  prove(
    [
      @hol|{!(f:K->A->bool) s.
         FINITE s /\ (!t. t IN s ==> FINITE(f t)) /\
         (!t u. t IN s /\ u IN s /\ ~(t = u) ==> f t INTER f u = {})
         ==> CARD(UNIONS(IMAGE f s)) = nsum s (\i. CARD(f i))}|,
      GEN_TAC then_tac ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [IMAGE_CLAUSES]) then_tac \
      REWRITE_TAC(PairList [UNIONS_0, UNIONS_INSERT, NOT_IN_EMPTY, IN_INSERT]) then_tac \
      REWRITE_TAC(PairList [CARD_CLAUSES, NSUM_CLAUSES]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN((fun(th): (STRIP_TAC then_tac MP_TAC(th)))) then_tac \
      ASM_SIMP_TAC(PairList [NSUM_CLAUSES]) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(o(SUBST1_TAC)(SYM))(STRIP_ASSUME_TAC)) then_tac \
      CONV_TAC(SYM_CONV) then_tac \
      MATCH_MP_TAC(CARD_UNION_EQ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_IMAGE, FINITE_UNIONS, FINITE_UNION, INTER_UNIONS]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def CARD_UNIONS:
  prove(
    [
      @hol|{!s:(A->bool)->bool.
         FINITE s /\ (!t. t IN s ==> FINITE t) /\
         (!t u. t IN s /\ u IN s /\ ~(t = u) ==> t INTER u = {})
         ==> CARD(UNIONS s) = nsum s CARD}|,
      MP_TAC(ISPEC(@hol|{\x:A->bool. x}|)(CARD_UNIONS_IMAGE)) then_tac \
      REWRITE_TAC(PairList [IMAGE_ID, ETA_AX])
    ]
  )

def EXPAND_NSUM_CONV:
  let PairList [pth_0, & PairList [pth_1, & PairList [pth_2, & PairList []]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{(n < m ==> nsum(m..n) f = 0) /\
           nsum(m..m) f = f m /\
           (m <= n ==> nsum (m..n) f = f m + nsum (m + 1..n) f)}|,
        REWRITE_TAC(PairList [NSUM_CLAUSES_LEFT, NSUM_SING_NUMSEG, NSUM_TRIV_NUMSEG])
      ]
    )
  let ns_tm = @hol|{..}|
  let f_tm = @hol|{f:num->num}|
  let m_tm = @hol|{m:num}|
  let n_tm = @hol|{n:num}|
  fun conv(tm):
    let [smn, ftm] = dest_comb(tm)
    let [s, mn] = dest_comb(smn)
    if !(is_const(s) && (fst(dest_const(s)) == "nsum"))
    | failwith("EXPAND_NSUM_CONV")
    | let [mtm, ntm] = dest_binop(ns_tm)(mn)
      let m = dest_numeral(mtm)
      let n = dest_numeral(ntm)
      if (n < m)
      | let th1 = INST(PairList [[ftm, f_tm], [mtm, m_tm], [ntm, n_tm]])(pth_0)
        MP(th1)(EQT_ELIM(NUM_LT_CONV(lhand(concl(th1)))))
      | if (n == m)
        | CONV_RULE(RAND_CONV(TRY_CONV(BETA_CONV)))(INST(PairList [[ftm, f_tm], [mtm, m_tm]])(pth_1))
        | let th1 = INST(PairList [[ftm, f_tm], [mtm, m_tm], [ntm, n_tm]])(pth_2)
          let th2 = MP(th1)(EQT_ELIM(NUM_LE_CONV(lhand(concl(th1)))))
          CONV_RULE(
            RAND_CONV(
              COMB2_CONV(RAND_CONV(TRY_CONV(BETA_CONV)))(LAND_CONV(LAND_CONV(NUM_ADD_CONV)) then_conv conv)
            )
          )(th2)
  conv

prioritize_real(#void)

def sum:
  new_definition(
    @hol|{sum:(A->bool)->(A->real)->real = iterate (+)}|
  )

def NEUTRAL_REAL_ADD:
  prove(
    [
      @hol|{neutral((+):real->real->real) = &0}|,
      REWRITE_TAC(PairList [neutral]) then_tac MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      MESON_TAC(PairList [REAL_ADD_LID, REAL_ADD_RID])
    ]
  )

def MONOIDAL_REAL_ADD:
  prove(
    [
      @hol|{monoidal((+):real->real->real)}|,
      REWRITE_TAC(PairList [monoidal, NEUTRAL_REAL_ADD]) then_tac REAL_ARITH_TAC
    ]
  )

def SUM_DEGENERATE:
  prove(
    [
      @hol|{!f s:A->bool. ~(FINITE {x | x IN s /\ ~(f x = &0)}) ==> sum s f = &0}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [sum]) then_tac \
      SIMP_TAC(PairList [iterate, support, NEUTRAL_REAL_ADD])
    ]
  )

def SUM_CLAUSES:
  prove(
    [
      @hol|{(!f:A->real. sum {} f = &0) /\
         (!x (f:B->real) s.
              FINITE(s)
              ==> (sum (x INSERT s) f =
                   if x IN s then sum s f else f(x) + sum s f))}|,
      REWRITE_TAC(PairList [sum, GSYM(NEUTRAL_REAL_ADD)]) then_tac \
      ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
      MATCH_MP_TAC(ITERATE_CLAUSES) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_UNION:
  prove(
    [
      @hol|{!f s t:A->bool.
         FINITE s /\ FINITE t /\ DISJOINT s t
         ==> sum (s UNION t) f = sum s f + sum t f}|,
      SIMP_TAC(PairList [sum, ITERATE_UNION, MONOIDAL_REAL_ADD])
    ]
  )

def SUM_DIFF:
  prove(
    [
      @hol|{!f s t:A->bool. FINITE s /\ t SUBSET s ==> (sum (s DIFF t) f = sum s f - sum t f)}|,
      SIMP_TAC(PairList [REAL_EQ_SUB_LADD, sum, ITERATE_DIFF, MONOIDAL_REAL_ADD])
    ]
  )

def SUM_INCL_EXCL:
  prove(
    [
      @hol|{!s t (f:A->real).
         FINITE s /\ FINITE t
         ==> sum s f + sum t f = sum (s UNION t) f + sum (s INTER t) f}|,
      REWRITE_TAC(PairList [sum, GSYM(NEUTRAL_REAL_ADD)]) then_tac \
      MATCH_MP_TAC(ITERATE_INCL_EXCL) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_SUPPORT:
  prove(
    [
      @hol|{!f s:A->bool. sum (support (+) f s) f = sum s f}|,
      SIMP_TAC(PairList [sum, iterate, SUPPORT_SUPPORT])
    ]
  )

def SUM_ADD:
  prove(
    [
      @hol|{!f g s:A->bool. FINITE s ==> (sum s (\x. f(x) + g(x)) = sum s f + sum s g)}|,
      SIMP_TAC(PairList [sum, ITERATE_OP, MONOIDAL_REAL_ADD])
    ]
  )

def SUM_ADD_GEN:
  prove(
    [
      @hol|{!f g s:A->bool.
         FINITE {x | x IN s /\ ~(f x = &0)} /\ FINITE {x | x IN s /\ ~(g x = &0)}
         ==> sum s (\x. f x + g x) = sum s f + sum s g}|,
      REWRITE_TAC(PairList [GSYM(NEUTRAL_REAL_ADD), GSYM(support), sum]) then_tac \
      MATCH_MP_TAC(ITERATE_OP_GEN) then_tac \
      ACCEPT_TAC(MONOIDAL_REAL_ADD)
    ]
  )

def SUM_EQ_0:
  prove(
    [
      @hol|{!f s. (!x:A. x IN s ==> (f(x) = &0)) ==> (sum s f = &0)}|,
      REWRITE_TAC(PairList [sum, GSYM(NEUTRAL_REAL_ADD)]) then_tac \
      SIMP_TAC(PairList [ITERATE_EQ_NEUTRAL, MONOIDAL_REAL_ADD])
    ]
  )

def SUM_0:
  prove(
    [
      @hol|{!s:A->bool. sum s (\n. &0) = &0}|,
      SIMP_TAC(PairList [SUM_EQ_0])
    ]
  )

def SUM_LMUL:
  prove(
    [
      @hol|{!f c s:A->bool. sum s (\x. c * f(x)) = c * sum s f}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{c = &0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_MUL_LZERO, SUM_0]) then_tac \
      REWRITE_TAC(PairList [sum]) then_tac \
      ONCE_REWRITE_TAC(PairList [ITERATE_EXPAND_CASES]) then_tac \
      SUBGOAL_THEN(
        @hol|{support (+) (\x:A. c * f(x)) s = support (+) f s}|
      )(SUBST1_TAC) then_list \
      PairList [
        ASM_SIMP_TAC(PairList [support, REAL_ENTIRE, NEUTRAL_REAL_ADD]),
        ALL_TAC
      ] then_tac \
      COND_CASES_TAC then_tac \
      REWRITE_TAC(PairList [NEUTRAL_REAL_ADD, REAL_MUL_RZERO]) then_tac \
      UNDISCH_TAC(
        @hol|{FINITE (support (+) f (s:A->bool))}|
      ) then_tac \
      SPEC_TAC(
        [
          @hol|{support (+) f (s:A->bool)}|,
          @hol|{t:A->bool}|
        ]
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(sum)]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(
        PairList [SUM_CLAUSES, REAL_MUL_RZERO, REAL_MUL_LZERO, REAL_ADD_LDISTRIB]
      )
    ]
  )

def SUM_RMUL:
  prove(
    [
      @hol|{!f c s:A->bool. sum s (\x. f(x) * c) = sum s f * c}|,
      ONCE_REWRITE_TAC(PairList [REAL_MUL_SYM]) then_tac \
      REWRITE_TAC(PairList [SUM_LMUL])
    ]
  )

def SUM_NEG:
  prove(
    [
      @hol|{!f s:A->bool. sum s (\x. --(f(x))) = --(sum s f)}|,
      ONCE_REWRITE_TAC(
        PairList [
          REAL_ARITH(
            @hol|{--x = --(&1) * x}|
          )
        ]
      ) then_tac \
      SIMP_TAC(PairList [SUM_LMUL])
    ]
  )

def SUM_SUB:
  prove(
    [
      @hol|{!f g s:A->bool. FINITE s ==> sum s (\x. f(x) - g(x)) = sum s f - sum s g}|,
      ONCE_REWRITE_TAC(PairList [real_sub]) then_tac \
      SIMP_TAC(PairList [SUM_NEG, SUM_ADD])
    ]
  )

def SUM_LE:
  prove(
    [
      @hol|{!f g s:A->bool.
         FINITE(s) /\ (!x. x IN s ==> f(x) <= g(x)) ==> sum s f <= sum s g}|,
      ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac GEN_TAC then_tac \
      GEN_TAC then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [SUM_CLAUSES, REAL_LE_REFL, REAL_LE_ADD2, IN_INSERT])
    ]
  )

def SUM_LT:
  prove(
    [
      @hol|{!f g s:A->bool.
         FINITE(s) /\ (!x. x IN s ==> f(x) <= g(x)) /\
         (?x. x IN s /\ f(x) < g(x))
          ==> sum s f < sum s g}|,
      REPEAT(GEN_TAC) then_tac \
      REPEAT(DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC))) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{a:A}|)(STRIP_ASSUME_TAC)) then_tac \
      SUBGOAL_THEN(
        @hol|{s = (a:A) INSERT (s DELETE a)}|
      )(SUBST1_TAC) then_list \
      PairList [
        UNDISCH_TAC(
          @hol|{a:A IN s}|
        ) then_tac \
        SET_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      ASM_SIMP_TAC(PairList [SUM_CLAUSES, FINITE_DELETE, IN_DELETE]) then_tac \
      ASM_SIMP_TAC(PairList [REAL_LTE_ADD2, SUM_LE, IN_DELETE, FINITE_DELETE])
    ]
  )

def SUM_LT_ALL:
  prove(
    [
      @hol|{!f g s:A->bool.
         FINITE s /\ ~(s = {}) /\ (!x. x IN s ==> f(x) < g(x))
         ==> sum s f < sum s g}|,
      MESON_TAC(PairList [MEMBER_NOT_EMPTY, REAL_LT_IMP_LE, SUM_LT])
    ]
  )

def SUM_POS_LT:
  prove(
    [
      @hol|{!f s:A->bool.
         FINITE s /\
         (!x. x IN s ==> &0 <= f x) /\
         (?x. x IN s /\ &0 < f x)
         ==> &0 < sum s f}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LET_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{sum (s:A->bool) (\i. &0)}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [REWRITE_TAC(PairList [SUM_0, REAL_LE_REFL]), MATCH_MP_TAC(SUM_LT)] then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def SUM_POS_LT_ALL:
  prove(
    [
      @hol|{!s f:A->real.
         FINITE s /\ ~(s = {}) /\ (!i. i IN s ==> &0 < f i) ==> &0 < sum s f}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(SUM_POS_LT) then_tac \
      ASM_MESON_TAC(PairList [MEMBER_NOT_EMPTY, REAL_LT_IMP_LE])
    ]
  )

def SUM_EQ:
  prove(
    [
      @hol|{!f g s:A->bool. (!x. x IN s ==> (f x = g x)) ==> (sum s f = sum s g)}|,
      REWRITE_TAC(PairList [sum]) then_tac MATCH_MP_TAC(ITERATE_EQ) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_ABS:
  prove(
    [
      @hol|{!f s:A->bool. FINITE(s) ==> abs(sum s f) <= sum s (\x. abs(f x))}|,
      GEN_TAC then_tac MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(
        PairList [
          SUM_CLAUSES,
          REAL_ABS_NUM,
          REAL_LE_REFL,
          REAL_ARITH(
            @hol|{abs(a) <= b ==> abs(x + a) <= abs(x) + b}|
          )
        ]
      )
    ]
  )

def SUM_ABS_LE:
  prove(
    [
      @hol|{!f:A->real g s:A->bool.
         FINITE s /\ (!x. x IN s ==> abs(f x) <= g x)
         ==> abs(sum s f) <= sum s g}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{sum s (\x:A. abs(f x))}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [SUM_ABS]) then_tac \
      MATCH_MP_TAC(SUM_LE) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def SUM_CONST:
  prove(
    [
      @hol|{!c s:A->bool. FINITE s ==> (sum s (\n. c) = &(CARD s) * c)}|,
      GEN_TAC then_tac MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [SUM_CLAUSES, CARD_CLAUSES, GSYM(REAL_OF_NUM_SUC)]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      REAL_ARITH_TAC
    ]
  )

def SUM_POS_LE:
  prove(
    [
      @hol|{!s:A->bool. (!x. x IN s ==> &0 <= f x) ==> &0 <= sum s f}|,
      REPEAT(STRIP_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{FINITE {x:A | x IN s /\ ~(f x = &0)}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [SUM_DEGENERATE, REAL_LE_REFL]) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(SUM_SUPPORT)]) then_tac \
      REWRITE_TAC(PairList [support, NEUTRAL_REAL_ADD]) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{\x:A. &0}|,
            @hol|{f:A->real}|,
            @hol|{{x:A | x IN s /\ ~(f x = &0)}}|
          ])(
          SUM_LE
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [SUM_0, IN_ELIM_THM])
    ]
  )

def SUM_POS_BOUND:
  prove(
    [
      @hol|{!f b s:A->bool.
         FINITE s /\ (!x. x IN s ==> &0 <= f x) /\ sum s f <= b
         ==> !x:A. x IN s ==> f x <= b}|,
      GEN_TAC then_tac GEN_TAC then_tac \
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [SUM_CLAUSES, NOT_IN_EMPTY, IN_INSERT]) then_tac \
      MESON_TAC(
        PairList [
          SUM_POS_LE,
          REAL_ARITH(
            @hol|{&0 <= x /\ &0 <= y /\ x + y <= b ==> x <= b /\ y <= b}|
          )
        ]
      )
    ]
  )

def SUM_POS_EQ_0:
  prove(
    [
      @hol|{!f s:A->bool.
         FINITE s /\ (!x. x IN s ==> &0 <= f x) /\ (sum s f = &0)
         ==> !x. x IN s ==> f x = &0}|,
      REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM)]) then_tac \
      MESON_TAC(PairList [SUM_POS_BOUND, SUM_POS_LE])
    ]
  )

def SUM_ZERO_EXISTS:
  prove(
    [
      @hol|{!(u:A->real) s.
         FINITE s /\ sum s u = &0
         ==> (!i. i IN s ==> u i = &0) \/
             (?j k. j IN s /\ u j < &0 /\ k IN s /\ u k > &0)}|,
      REPEAT(STRIP_TAC) then_tac \
      REPEAT_TCL(DISJ_CASES_THEN)(ASSUME_TAC)(
        MESON(
          PairList [
            REAL_ARITH(
              @hol|{(&0 <= --u <=> ~(u > &0)) /\ (&0 <= u <=> ~(u < &0))}|
            )
          ])(
          @hol|{(?j k:A. j IN s /\ u j < &0 /\ k IN s /\ u k > &0) \/
             (!i. i IN s ==> &0 <= u i) \/ (!i. i IN s ==> &0 <= --(u i))}|
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISJ1_TAC then_list \
      PairList [
        ALL_TAC,
        ONCE_REWRITE_TAC(
          PairList [
            REAL_ARITH(
              @hol|{x = &0 <=> --x = &0}|
            )
          ]
        )
      ] then_tac \
      MATCH_MP_TAC(SUM_POS_EQ_0) then_tac \
      ASM_REWRITE_TAC(PairList [SUM_NEG, REAL_NEG_0])
    ]
  )

def SUM_DELETE:
  prove(
    [
      @hol|{!f s a:A. FINITE s /\ a IN s ==> sum (s DELETE a) f = sum s f - f(a)}|,
      SIMP_TAC(
        PairList [
          REAL_ARITH(
            @hol|{y = z - x <=> x + y = z:real}|
          ),
          sum,
          ITERATE_DELETE,
          MONOIDAL_REAL_ADD
        ]
      )
    ]
  )

def SUM_DELETE_CASES:
  prove(
    [
      @hol|{!f s a:A. FINITE s
         ==> sum (s DELETE a) f = if a IN s then sum s f - f(a)
                                  else sum s f}|,
      REPEAT(STRIP_TAC) then_tac COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(
        PairList [
          SET_RULE(
            @hol|{~(a IN s) ==> (s DELETE a = s)}|
          ),
          SUM_DELETE
        ]
      )
    ]
  )

def SUM_SING:
  prove(
    [
      @hol|{!f x:A. sum {x} f = f(x)}|,
      SIMP_TAC(PairList [SUM_CLAUSES, FINITE_RULES, NOT_IN_EMPTY, REAL_ADD_RID])
    ]
  )

def SUM_DELTA:
  prove(
    [
      @hol|{!s a. sum s (\x. if x = a:A then b else &0) = if a IN s then b else &0}|,
      REWRITE_TAC(PairList [sum, GSYM(NEUTRAL_REAL_ADD)]) then_tac \
      SIMP_TAC(PairList [ITERATE_DELTA, MONOIDAL_REAL_ADD])
    ]
  )

def SUM_SWAP:
  prove(
    [
      @hol|{!f:A->B->real s t.
         FINITE(s) /\ FINITE(t)
         ==> (sum s (\i. sum t (f i)) = sum t (\j. sum s (\i. f i j)))}|,
      GEN_TAC then_tac \
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [SUM_CLAUSES, SUM_0, SUM_ADD, ETA_AX])
    ]
  )

def SUM_IMAGE:
  prove(
    [
      @hol|{!(f:A->B) g s.
         (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
         ==> sum (IMAGE f s) g = sum s (g o f)}|,
      REWRITE_TAC(PairList [sum, GSYM(NEUTRAL_REAL_ADD)]) then_tac \
      MATCH_MP_TAC(ITERATE_IMAGE) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_SUPERSET:
  prove(
    [
      @hol|{!f:A->real u v.
         u SUBSET v /\ (!x. x IN v /\ ~(x IN u) ==> (f(x) = &0))
         ==> (sum v f = sum u f)}|,
      SIMP_TAC(PairList [sum, GSYM(NEUTRAL_REAL_ADD), ITERATE_SUPERSET, MONOIDAL_REAL_ADD])
    ]
  )

def SUM_UNIV:
  prove(
    [
      @hol|{!f:A->real s. support (+) f (:A) SUBSET s ==> sum s f = sum (:A) f}|,
      REWRITE_TAC(PairList [sum]) then_tac MATCH_MP_TAC(ITERATE_UNIV) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_UNION_RZERO:
  let lemma:
    prove(
      [
        @hol|{u UNION v = u UNION (v DIFF u)}|,
        SET_TAC(PairList [])
      ]
    )
  prove(
    [
      @hol|{!f:A->real u v.
         FINITE u /\ (!x. x IN v /\ ~(x IN u) ==> (f(x) = &0))
         ==> sum (u UNION v) f = sum u f}|,
      REPEAT(STRIP_TAC) then_tac ONCE_REWRITE_TAC(PairList [lemma]) then_tac \
      MATCH_MP_TAC(SUM_SUPERSET) then_tac \
      ASM_MESON_TAC(PairList [IN_UNION, IN_DIFF, SUBSET])
    ]
  )

def SUM_UNION_LZERO:
  prove(
    [
      @hol|{!f:A->real u v.
         FINITE v /\ (!x. x IN u /\ ~(x IN v) ==> (f(x) = &0))
         ==> sum (u UNION v) f = sum v f}|,
      MESON_TAC(PairList [SUM_UNION_RZERO, UNION_COMM])
    ]
  )

def SUM_RESTRICT:
  prove(
    [
      @hol|{!f s:A->bool.
         FINITE s ==> sum s (\x. if x IN s then f(x) else &0) = sum s f}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(SUM_EQ) then_tac \
      ASM_SIMP_TAC(PairList [])
    ]
  )

def SUM_BOUND:
  prove(
    [
      @hol|{!s f b. FINITE s /\ (!x:A. x IN s ==> f(x) <= b)
         ==> sum s f <= &(CARD s) * b}|,
      SIMP_TAC(PairList [GSYM(SUM_CONST), SUM_LE])
    ]
  )

def SUM_BOUND_GEN:
  prove(
    [
      @hol|{!s f b. FINITE s /\ ~(s = {}) /\ (!x:A. x IN s ==> f(x) <= b / &(CARD s))
         ==> sum s f <= b}|,
      MESON_TAC(
        PairList [SUM_BOUND, REAL_DIV_LMUL, REAL_OF_NUM_EQ, HAS_SIZE_0, HAS_SIZE]
      )
    ]
  )

def SUM_ABS_BOUND:
  prove(
    [
      @hol|{!s f b. FINITE s /\ (!x:A. x IN s ==> abs(f(x)) <= b)
         ==> abs(sum s f) <= &(CARD s) * b}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{sum s (\x:A. abs(f x))}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [SUM_BOUND, SUM_ABS])
    ]
  )

def SUM_BOUND_LT:
  prove(
    [
      @hol|{!s f b. FINITE s /\ (!x:A. x IN s ==> f x <= b) /\ (?x. x IN s /\ f x < b)
         ==> sum s f < &(CARD s) * b}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LTE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{sum s (\x:A. b)}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(SUM_LT) then_tac ASM_REWRITE_TAC(PairList []) then_tac \
        ASM_MESON_TAC(PairList []),
        ASM_SIMP_TAC(PairList [SUM_CONST, REAL_LE_REFL])
      ]
    ]
  )

def SUM_BOUND_LT_ALL:
  prove(
    [
      @hol|{!s f b. FINITE s /\ ~(s = {}) /\ (!x:A. x IN s ==> f(x) < b)
         ==> sum s f <  &(CARD s) * b}|,
      MESON_TAC(PairList [MEMBER_NOT_EMPTY, REAL_LT_IMP_LE, SUM_BOUND_LT])
    ]
  )

def SUM_BOUND_LT_GEN:
  prove(
    [
      @hol|{!s f b. FINITE s /\ ~(s = {}) /\ (!x:A. x IN s ==> f(x) < b / &(CARD s))
         ==> sum s f < b}|,
      MESON_TAC(
        PairList [
          SUM_BOUND_LT_ALL,
          REAL_DIV_LMUL,
          REAL_OF_NUM_EQ,
          HAS_SIZE_0,
          HAS_SIZE
        ]
      )
    ]
  )

def SUM_UNION_EQ:
  prove(
    [
      @hol|{!s t u:A->bool.
         FINITE u /\ s INTER t = {} /\ s UNION t = u
         ==> sum s f + sum t f = sum u f}|,
      MESON_TAC(PairList [SUM_UNION, DISJOINT, FINITE_SUBSET, SUBSET_UNION])
    ]
  )

def SUM_EQ_SUPERSET:
  prove(
    [
      @hol|{!f s t:A->bool.
         FINITE t /\ t SUBSET s /\
         (!x. x IN t ==> (f x = g x)) /\
         (!x. x IN s /\ ~(x IN t) ==> (f(x) = &0))
         ==> (sum s f = sum t g)}|,
      MESON_TAC(PairList [SUM_SUPERSET, SUM_EQ])
    ]
  )

def SUM_RESTRICT_SET:
  prove(
    [
      @hol|{!P s f. sum {x:A | x IN s /\ P x} f = sum s (\x. if P x then f x else &0)}|,
      REWRITE_TAC(PairList [sum, GSYM(NEUTRAL_REAL_ADD)]) then_tac \
      MATCH_MP_TAC(ITERATE_RESTRICT_SET) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_SUM_RESTRICT:
  prove(
    [
      @hol|{!(R:A->B->bool) f s t.
         FINITE s /\ FINITE t
         ==> (sum s (\x. sum {y | y IN t /\ R x y} (\y. f x y)) =
              sum t (\y. sum {x | x IN s /\ R x y} (\x. f x y)))}|,
      REPEAT(GEN_TAC) then_tac SIMP_TAC(PairList [SUM_RESTRICT_SET]) then_tac \
      DISCH_THEN((fun(th): REWRITE_TAC(PairList [MATCH_MP(SUM_SWAP)(th)])))
    ]
  )

def CARD_EQ_SUM:
  prove(
    [
      @hol|{!s:A->bool. FINITE s ==> (&(CARD s) = sum s (\x. &1))}|,
      SIMP_TAC(PairList [SUM_CONST, REAL_MUL_RID])
    ]
  )

def SUM_MULTICOUNT_GEN:
  prove(
    [
      @hol|{!R:A->B->bool s t k.
         FINITE s /\ FINITE t /\
         (!j. j IN t ==> (CARD {i | i IN s /\ R i j} = k(j)))
         ==> (sum s (\i. &(CARD {j | j IN t /\ R i j})) =
              sum t (\i. &(k i)))}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [CONJ_ASSOC]) then_tac \
      DISCH_THEN(CONJUNCTS_THEN(ASSUME_TAC)) then_tac \
      MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{sum s (\i:A. sum {j:B | j IN t /\ R i j} (\j. &1))}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(SUM_EQ) then_tac ASM_REWRITE_TAC(PairList []) then_tac \
        REPEAT(STRIP_TAC) then_tac \
        ASM_SIMP_TAC(PairList [CARD_EQ_SUM, FINITE_RESTRICT]),
        FIRST_ASSUM((fun(th): ONCE_REWRITE_TAC(PairList [MATCH_MP(SUM_SUM_RESTRICT)(th)]))) then_tac \
        MATCH_MP_TAC(SUM_EQ) then_tac \
        ASM_SIMP_TAC(PairList [SUM_CONST, FINITE_RESTRICT]) then_tac \
        REWRITE_TAC(PairList [REAL_MUL_RID])
      ]
    ]
  )

def SUM_MULTICOUNT:
  prove(
    [
      @hol|{!R:A->B->bool s t k.
         FINITE s /\ FINITE t /\
         (!j. j IN t ==> (CARD {i | i IN s /\ R i j} = k))
         ==> (sum s (\i. &(CARD {j | j IN t /\ R i j})) = &(k * CARD t))}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{sum t (\i:B. &k)}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(SUM_MULTICOUNT_GEN) then_tac ASM_REWRITE_TAC(PairList []),
        ASM_SIMP_TAC(PairList [SUM_CONST, REAL_OF_NUM_MUL]) then_tac \
        REWRITE_TAC(PairList [MULT_AC])
      ]
    ]
  )

def SUM_IMAGE_GEN:
  prove(
    [
      @hol|{!f:A->B g s.
         FINITE s
         ==> sum s g =
             sum (IMAGE f s) (\y. sum {x | x IN s /\ f x = y} g)}|,
      REWRITE_TAC(PairList [sum]) then_tac MATCH_MP_TAC(ITERATE_IMAGE_GEN) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_GROUP:
  prove(
    [
      @hol|{!f:A->B g s t.
         FINITE s /\ IMAGE f s SUBSET t
         ==> sum t (\y. sum {x | x IN s /\ f(x) = y} g) = sum s g}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:A->B}|,
            @hol|{g:A->real}|,
            @hol|{s:A->bool}|
          ])(
          SUM_IMAGE_GEN
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_THEN(SUBST1_TAC) then_tac \
      MATCH_MP_TAC(SUM_SUPERSET) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(SUM_EQ_0) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def SUM_GROUP_RELATION:
  prove(
    [
      @hol|{!R:A->B->bool g s t.
         FINITE s /\
         (!x. x IN s ==> ?!y. y IN t /\ R x y)
         ==> sum t (\y. sum {x | x IN s /\ R x y} g) = sum s g}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{\x:A. @y:B. y IN t /\ R x y}|,
            @hol|{g:A->real}|,
            @hol|{s:A->bool}|,
            @hol|{t:B->bool}|
          ])(
          SUM_GROUP
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [SUBSET, FORALL_IN_IMAGE]) then_tac \
      ANTS_TAC then_list \
      PairList [
        ASM_MESON_TAC(PairList []),
        DISCH_THEN(o(SUBST1_TAC)(SYM))
      ] then_tac \
      MATCH_MP_TAC(SUM_EQ) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      AP_THM_TAC then_tac \
      AP_TERM_TAC then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def REAL_OF_NUM_SUM:
  prove(
    [
      @hol|{!f s:A->bool. FINITE s ==> (&(nsum s f) = sum s (\x. &(f x)))}|,
      GEN_TAC then_tac MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [SUM_CLAUSES, NSUM_CLAUSES, GSYM(REAL_OF_NUM_ADD)])
    ]
  )

def SUM_SUBSET:
  prove(
    [
      @hol|{!u v f. FINITE u /\ FINITE v /\
         (!x. x IN (u DIFF v) ==> f(x) <= &0) /\
         (!x:A. x IN (v DIFF u) ==> &0 <= f(x))
         ==> sum u f <= sum v f}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:A->real}|,
            @hol|{u INTER v :A->bool}|
          ])(
          SUM_UNION
        )
      ) then_tac \
      DISCH_THEN(
        fun(th):
          (
            MP_TAC(
              SPEC(
                @hol|{v DIFF u :A->bool}|
              )(th)
            ) then_tac \
            MP_TAC(
              SPEC(
                @hol|{u DIFF v :A->bool}|
              )(th)
            )
          )
      ) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{(u INTER v) UNION (u DIFF v) = u}|
          ),
          SET_RULE(
            @hol|{(u INTER v) UNION (v DIFF u) = v}|
          )
        ]
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_DIFF, FINITE_INTER]) then_tac \
      REPEAT(
        ANTS_TAC then_list \
        PairList [SET_TAC(PairList []), DISCH_THEN(SUBST1_TAC)]
      ) then_tac \
      MATCH_MP_TAC(
        REAL_ARITH(
          @hol|{&0 <= --x /\ &0 <= y ==> a + x <= a + y}|
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [GSYM(SUM_NEG), FINITE_DIFF]) then_tac \
      CONJ_TAC then_tac \
      MATCH_MP_TAC(SUM_POS_LE) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_DIFF, REAL_LE_RNEG, REAL_ADD_LID])
    ]
  )

def SUM_SUBSET_SIMPLE:
  prove(
    [
      @hol|{!u v f.
         FINITE v /\ u SUBSET v /\ (!x:A. x IN (v DIFF u) ==> &0 <= f(x))
         ==> sum u f <= sum v f}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(SUM_SUBSET) then_tac \
      ASM_MESON_TAC(PairList [IN_DIFF, SUBSET, FINITE_SUBSET])
    ]
  )

def SUM_MUL_BOUND:
  prove(
    [
      @hol|{!a b s:A->bool.
         FINITE s /\ (!i. i IN s ==> &0 <= a i /\ &0 <= b i)
         ==> sum s (\i. a i * b i) <= sum s a * sum s b}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [GSYM(SUM_LMUL)]) then_tac \
      MATCH_MP_TAC(SUM_LE) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      X_GEN_TAC(@hol|{i:A}|) then_tac \
      DISCH_TAC then_tac \
      MATCH_MP_TAC(REAL_LE_RMUL) then_tac \
      ASM_SIMP_TAC(PairList []) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(SUM_SING)]) then_tac \
      MATCH_MP_TAC(SUM_SUBSET_SIMPLE) then_tac \
      ASM_SIMP_TAC(PairList [SING_SUBSET, IN_DIFF])
    ]
  )

def SUM_IMAGE_NONZERO:
  prove(
    [
      @hol|{!d:B->real i:A->B s.
         FINITE s /\
         (!x y. x IN s /\ y IN s /\ ~(x = y) /\ i x = i y ==> d(i x) = &0)
         ==> sum (IMAGE i s) d = sum s (d o i)}|,
      REWRITE_TAC(PairList [GSYM(NEUTRAL_REAL_ADD), sum]) then_tac \
      MATCH_MP_TAC(ITERATE_IMAGE_NONZERO) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_BIJECTION:
  prove(
    [
      @hol|{!f p s:A->bool.
         (!x. x IN s ==> p(x) IN s) /\
         (!y. y IN s ==> ?!x. x IN s /\ p(x) = y)
         ==> sum s f = sum s (f o p)}|,
      REWRITE_TAC(PairList [sum]) then_tac MATCH_MP_TAC(ITERATE_BIJECTION) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_SUM_PRODUCT:
  prove(
    [
      @hol|{!s:A->bool t:A->B->bool x.
         FINITE s /\ (!i. i IN s ==> FINITE(t i))
         ==> sum s (\i. sum (t i) (x i)) =
             sum {i,j | i IN s /\ j IN t i} (\(i,j). x i j)}|,
      REWRITE_TAC(PairList [sum]) then_tac MATCH_MP_TAC(ITERATE_ITERATE_PRODUCT) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_EQ_GENERAL:
  prove(
    [
      @hol|{!s:A->bool t:B->bool f g h.
         (!y. y IN t ==> ?!x. x IN s /\ h(x) = y) /\
         (!x. x IN s ==> h(x) IN t /\ g(h x) = f x)
         ==> sum s f = sum t g}|,
      REWRITE_TAC(PairList [sum]) then_tac MATCH_MP_TAC(ITERATE_EQ_GENERAL) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_EQ_GENERAL_INVERSES:
  prove(
    [
      @hol|{!s:A->bool t:B->bool f g h k.
         (!y. y IN t ==> k(y) IN s /\ h(k y) = y) /\
         (!x. x IN s ==> h(x) IN t /\ k(h x) = x /\ g(h x) = f x)
         ==> sum s f = sum t g}|,
      REWRITE_TAC(PairList [sum]) then_tac MATCH_MP_TAC(ITERATE_EQ_GENERAL_INVERSES) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_INJECTION:
  prove(
    [
      @hol|{!f p s:A->bool.
         FINITE s /\
         (!x. x IN s ==> p x IN s) /\
         (!x y. x IN s /\ y IN s /\ p x = p y ==> x = y)
         ==> sum s (f o p) = sum s f}|,
      REWRITE_TAC(PairList [sum]) then_tac MATCH_MP_TAC(ITERATE_INJECTION) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_UNION_NONZERO:
  prove(
    [
      @hol|{!f s t:A->bool.
         FINITE s /\ FINITE t /\ (!x. x IN s INTER t ==> f(x) = &0)
         ==> sum (s UNION t) f = sum s f + sum t f}|,
      REWRITE_TAC(PairList [sum, GSYM(NEUTRAL_REAL_ADD)]) then_tac \
      MATCH_MP_TAC(ITERATE_UNION_NONZERO) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_UNIONS_NONZERO:
  prove(
    [
      @hol|{!f s. FINITE s /\ (!t:A->bool. t IN s ==> FINITE t) /\
         (!t1 t2 x. t1 IN s /\ t2 IN s /\ ~(t1 = t2) /\ x IN t1 /\ x IN t2
                    ==> f x = &0)
         ==> sum (UNIONS s) f = sum s (\t. sum t f)}|,
      GEN_TAC then_tac ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [UNIONS_0, UNIONS_INSERT, SUM_CLAUSES, IN_INSERT]) then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{t:A->bool}|,
          @hol|{s:(A->bool)->bool}|
        ]
      ) then_tac \
      DISCH_THEN((fun(th): (STRIP_TAC then_tac MP_TAC(th)))) then_tac \
      ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      ASM_SIMP_TAC(PairList [SUM_CLAUSES]) then_tac \
      ANTS_TAC then_list \
      PairList [
        ASM_MESON_TAC(PairList []),
        DISCH_THEN(o(SUBST_ALL_TAC)(SYM))
      ] then_tac \
      STRIP_TAC then_tac \
      MATCH_MP_TAC(SUM_UNION_NONZERO) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_UNIONS, IN_INTER, IN_UNIONS]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def SUM_CASES:
  prove(
    [
      @hol|{!s P f g. FINITE s
         ==> sum s (\x:A. if P x then f x else g x) =
             sum {x | x IN s /\ P x} f + sum {x | x IN s /\ ~P x} g}|,
      REWRITE_TAC(PairList [sum, GSYM(NEUTRAL_REAL_ADD)]) then_tac \
      MATCH_MP_TAC(ITERATE_CASES) then_tac \
      REWRITE_TAC(PairList [MONOIDAL_REAL_ADD])
    ]
  )

def SUM_CASES_1:
  prove(
    [
      @hol|{!s a:A. FINITE s /\ a IN s
         ==> sum s (\x. if x = a then y else f(x)) = sum s f + (y - f a)}|,
      REPEAT(STRIP_TAC) then_tac ASM_SIMP_TAC(PairList [SUM_CASES]) then_tac \
      ASM_SIMP_TAC(PairList [GSYM(DELETE), SUM_DELETE]) then_tac \
      ASM_SIMP_TAC(
        PairList [
          SET_RULE(
            @hol|{a IN s ==> {x | x IN s /\ x = a} = {a}}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [SUM_SING]) then_tac \
      REAL_ARITH_TAC
    ]
  )

def SUM_LE_INCLUDED:
  prove(
    [
      @hol|{!f:A->real g:B->real s t i.
         FINITE s /\ FINITE t /\
         (!y. y IN t ==> &0 <= g y) /\
         (!x. x IN s ==> ?y. y IN t /\ i y = x /\ f(x) <= g(y))
         ==> sum s f <= sum t g}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{sum (IMAGE (i:B->A) t) (\y. sum {x | x IN t /\ i x = y} g)}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        ALL_TAC,
        MATCH_MP_TAC(REAL_EQ_IMP_LE) then_tac \
        MATCH_MP_TAC(GSYM(SUM_IMAGE_GEN)) then_tac \
        ASM_REWRITE_TAC(PairList [])
      ] then_tac \
      MATCH_MP_TAC(REAL_LE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{sum s (\y. sum {x | x IN t /\ (i:B->A) x = y} g)}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(SUM_LE) then_tac ASM_REWRITE_TAC(PairList []) then_tac \
        X_GEN_TAC(@hol|{x:A}|) then_tac \
        DISCH_TAC then_tac \
        FIRST_X_ASSUM(o(MP_TAC)(SPEC(@hol|{x:A}|))) then_tac \
        ASM_REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac \
        X_GEN_TAC(@hol|{y:B}|) then_tac \
        STRIP_TAC then_tac \
        MATCH_MP_TAC(REAL_LE_TRANS) then_tac \
        EXISTS_TAC(
          @hol|{sum {y:B} g}|
        ) then_tac \
        CONJ_TAC then_list \
        PairList [ASM_REWRITE_TAC(PairList [SUM_SING]), ALL_TAC],
        ALL_TAC
      ] then_tac \
      MATCH_MP_TAC(SUM_SUBSET_SIMPLE) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_IMAGE]) then_tac \
      ASM_SIMP_TAC(PairList [SUM_POS_LE, FINITE_RESTRICT, IN_ELIM_THM]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def SUM_IMAGE_LE:
  prove(
    [
      @hol|{!f:A->B g s.
         FINITE s /\
         (!x. x IN s ==> &0 <= g(f x))
         ==> sum (IMAGE f s) g <= sum s (g o f)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(SUM_LE_INCLUDED) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_IMAGE, FORALL_IN_IMAGE]) then_tac \
      ASM_REWRITE_TAC(PairList [o_THM]) then_tac \
      EXISTS_TAC(@hol|{f:A->B}|) then_tac \
      MESON_TAC(PairList [REAL_LE_REFL])
    ]
  )

def SUM_CLOSED:
  prove(
    [
      @hol|{!P f:A->real s.
         P(&0) /\ (!x y. P x /\ P y ==> P(x + y)) /\ (!a. a IN s ==> P(f a))
         ==> P(sum s f)}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(MATCH_MP(ITERATE_CLOSED)(MONOIDAL_REAL_ADD)) then_tac \
      DISCH_THEN(o(MP_TAC)(SPEC(@hol|{P:real->bool}|))) then_tac \
      ASM_SIMP_TAC(PairList [NEUTRAL_REAL_ADD, GSYM(sum)])
    ]
  )

def SUM_RELATED:
  prove(
    [
      @hol|{!R (f:A->real) g s.
         R (&0) (&0) /\
         (!m n m' n'. R m n /\ R m' n' ==> R (m + m') (n + n')) /\
         FINITE s /\ (!x. x IN s ==> R (f x) (g x))
         ==> R (sum s f) (sum s g)}|,
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      GEN_TAC then_tac \
      REPEAT(DISCH_TAC) then_tac \
      MP_TAC(
        ISPEC(@hol|{R:real->real->bool}|)(MATCH_MP(ITERATE_RELATED)(MONOIDAL_REAL_ADD))
      ) then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(sum), NEUTRAL_REAL_ADD]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def SUM_CLOSED_NONEMPTY:
  prove(
    [
      @hol|{!P f:A->real s.
         FINITE s /\ ~(s = {}) /\
         (!x y. P x /\ P y ==> P(x + y)) /\ (!a. a IN s ==> P(f a))
         ==> P(sum s f)}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(MATCH_MP(ITERATE_CLOSED_NONEMPTY)(MONOIDAL_REAL_ADD)) then_tac \
      DISCH_THEN(o(MP_TAC)(SPEC(@hol|{P:real->bool}|))) then_tac \
      ASM_SIMP_TAC(PairList [NEUTRAL_REAL_ADD, GSYM(sum)])
    ]
  )

def SUM_RELATED_NONEMPTY:
  prove(
    [
      @hol|{!R (f:A->real) g s.
         (!m n m' n'. R m n /\ R m' n' ==> R (m + m') (n + n')) /\
         FINITE s /\ ~(s = {}) /\ (!x. x IN s ==> R (f x) (g x))
         ==> R (sum s f) (sum s g)}|,
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      GEN_TAC then_tac \
      REPEAT(DISCH_TAC) then_tac \
      MP_TAC(
        ISPEC(@hol|{R:real->real->bool}|)(MATCH_MP(ITERATE_RELATED_NONEMPTY)(MONOIDAL_REAL_ADD))
      ) then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(sum), NEUTRAL_REAL_ADD]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def REAL_OF_NUM_SUM_GEN:
  prove(
    [
      @hol|{!f s:A->bool.
         FINITE {i | i IN s /\ ~(f i = 0)} ==> &(nsum s f) = sum s (\x. &(f x))}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(SUM_SUPPORT), GSYM(NSUM_SUPPORT)]) then_tac \
      REWRITE_TAC(PairList [support, NEUTRAL_ADD, NEUTRAL_REAL_ADD, REAL_OF_NUM_EQ]) then_tac \
      ASM_SIMP_TAC(PairList [REAL_OF_NUM_SUM])
    ]
  )

def SUM_ADD_NUMSEG:
  prove(
    [
      @hol|{!f g m n. sum(m..n) (\i. f(i) + g(i)) = sum(m..n) f + sum(m..n) g}|,
      SIMP_TAC(PairList [SUM_ADD, FINITE_NUMSEG])
    ]
  )

def SUM_SUB_NUMSEG:
  prove(
    [
      @hol|{!f g m n. sum(m..n) (\i. f(i) - g(i)) = sum(m..n) f - sum(m..n) g}|,
      SIMP_TAC(PairList [SUM_SUB, FINITE_NUMSEG])
    ]
  )

def SUM_LE_NUMSEG:
  prove(
    [
      @hol|{!f g m n. (!i. m <= i /\ i <= n ==> f(i) <= g(i))
         ==> sum(m..n) f <= sum(m..n) g}|,
      SIMP_TAC(PairList [SUM_LE, FINITE_NUMSEG, IN_NUMSEG])
    ]
  )

def SUM_EQ_NUMSEG:
  prove(
    [
      @hol|{!f g m n. (!i. m <= i /\ i <= n ==> (f(i) = g(i)))
         ==> (sum(m..n) f = sum(m..n) g)}|,
      MESON_TAC(PairList [SUM_EQ, FINITE_NUMSEG, IN_NUMSEG])
    ]
  )

def SUM_ABS_NUMSEG:
  prove(
    [
      @hol|{!f m n. abs(sum(m..n) f) <= sum(m..n) (\i. abs(f i))}|,
      SIMP_TAC(PairList [SUM_ABS, FINITE_NUMSEG])
    ]
  )

def SUM_CONST_NUMSEG:
  prove(
    [
      @hol|{!c m n. sum(m..n) (\n. c) = &((n + 1) - m) * c}|,
      SIMP_TAC(PairList [SUM_CONST, FINITE_NUMSEG, CARD_NUMSEG])
    ]
  )

def SUM_EQ_0_NUMSEG:
  prove(
    [
      @hol|{!f m n. (!i. m <= i /\ i <= n ==> (f(i) = &0)) ==> (sum(m..n) f = &0)}|,
      SIMP_TAC(PairList [SUM_EQ_0, IN_NUMSEG])
    ]
  )

def SUM_TRIV_NUMSEG:
  prove(
    [
      @hol|{!f m n. n < m ==> (sum(m..n) f = &0)}|,
      MESON_TAC(PairList [SUM_EQ_0_NUMSEG, LE_TRANS, NOT_LT])
    ]
  )

def SUM_POS_LE_NUMSEG:
  prove(
    [
      @hol|{!m n f. (!p. m <= p /\ p <= n ==> &0 <= f(p)) ==> &0 <= sum(m..n) f}|,
      SIMP_TAC(PairList [SUM_POS_LE, FINITE_NUMSEG, IN_NUMSEG])
    ]
  )

def SUM_POS_EQ_0_NUMSEG:
  prove(
    [
      @hol|{!f m n. (!p. m <= p /\ p <= n ==> &0 <= f(p)) /\ (sum(m..n) f = &0)
         ==> !p. m <= p /\ p <= n ==> (f(p) = &0)}|,
      MESON_TAC(PairList [SUM_POS_EQ_0, FINITE_NUMSEG, IN_NUMSEG])
    ]
  )

def SUM_SING_NUMSEG:
  prove(
    [
      @hol|{!f n. sum(n..n) f = f(n)}|,
      SIMP_TAC(PairList [SUM_SING, NUMSEG_SING])
    ]
  )

def SUM_CLAUSES_NUMSEG:
  prove(
    [
      @hol|{(!m. sum(m..0) f = if m = 0 then f(0) else &0) /\
         (!m n. sum(m..SUC n) f = if m <= SUC n then sum(m..n) f + f(SUC n)
                                  else sum(m..n) f)}|,
      MP_TAC(MATCH_MP(ITERATE_CLAUSES_NUMSEG)(MONOIDAL_REAL_ADD)) then_tac \
      REWRITE_TAC(PairList [NEUTRAL_REAL_ADD, sum])
    ]
  )

def SUM_CLAUSES_NUMSEG_LT:
  prove(
    [
      @hol|{sum {i | i < 0} f = &0 /\
         (!k. sum {i | i < SUC k} f = sum {i | i < k} f + f k)}|,
      MP_TAC(MATCH_MP(ITERATE_CLAUSES_NUMSEG_LT)(MONOIDAL_REAL_ADD)) then_tac \
      REWRITE_TAC(PairList [NEUTRAL_REAL_ADD, sum])
    ]
  )

def SUM_CLAUSES_NUMSEG_LE:
  prove(
    [
      @hol|{sum {i | i <= 0} f = f 0 /\
         (!k. sum {i | i <= SUC k} f = sum {i | i <= k} f + f(SUC k))}|,
      MP_TAC(MATCH_MP(ITERATE_CLAUSES_NUMSEG_LE)(MONOIDAL_REAL_ADD)) then_tac \
      REWRITE_TAC(PairList [NEUTRAL_REAL_ADD, sum])
    ]
  )

def SUM_SWAP_NUMSEG:
  prove(
    [
      @hol|{!a b c d f.
         sum(a..b) (\i. sum(c..d) (f i)) = sum(c..d) (\j. sum(a..b) (\i. f i j))}|,
      REPEAT(GEN_TAC) then_tac MATCH_MP_TAC(SUM_SWAP) then_tac \
      REWRITE_TAC(PairList [FINITE_NUMSEG])
    ]
  )

def SUM_ADD_SPLIT:
  prove(
    [
      @hol|{!f m n p.
         m <= n + 1 ==> (sum (m..(n+p)) f = sum(m..n) f + sum(n+1..n+p) f)}|,
      SIMP_TAC(
        PairList [
          NUMSEG_ADD_SPLIT,
          SUM_UNION,
          DISJOINT_NUMSEG,
          FINITE_NUMSEG,
          ARITH_RULE(
            @hol|{x < x + 1}|
          )
        ]
      )
    ]
  )

def SUM_OFFSET:
  prove(
    [
      @hol|{!p f m n. sum(m+p..n+p) f = sum(m..n) (\i. f(i + p))}|,
      SIMP_TAC(PairList [NUMSEG_OFFSET_IMAGE, SUM_IMAGE, EQ_ADD_RCANCEL, FINITE_NUMSEG]) then_tac \
      REWRITE_TAC(PairList [o_DEF])
    ]
  )

def SUM_OFFSET_0:
  prove(
    [
      @hol|{!f m n. m <= n ==> (sum(m..n) f = sum(0..n-m) (\i. f(i + m)))}|,
      SIMP_TAC(PairList [GSYM(SUM_OFFSET), ADD_CLAUSES, SUB_ADD])
    ]
  )

def SUM_CLAUSES_LEFT:
  prove(
    [
      @hol|{!f m n. m <= n ==> sum(m..n) f = f(m) + sum(m+1..n) f}|,
      SIMP_TAC(PairList [GSYM(NUMSEG_LREC), SUM_CLAUSES, FINITE_NUMSEG, IN_NUMSEG]) then_tac \
      ARITH_TAC
    ]
  )

def SUM_CLAUSES_RIGHT:
  prove(
    [
      @hol|{!f m n. 0 < n /\ m <= n ==> sum(m..n) f = sum(m..n-1) f + f(n)}|,
      GEN_TAC then_tac GEN_TAC then_tac INDUCT_TAC then_tac \
      SIMP_TAC(PairList [LT_REFL, SUM_CLAUSES_NUMSEG, SUC_SUB1])
    ]
  )

def SUM_PAIR:
  prove(
    [
      @hol|{!f m n. sum(2*m..2*n+1) f = sum(m..n) (\i. f(2*i) + f(2*i+1))}|,
      MP_TAC(MATCH_MP(ITERATE_PAIR)(MONOIDAL_REAL_ADD)) then_tac \
      REWRITE_TAC(PairList [sum, NEUTRAL_REAL_ADD])
    ]
  )

def SUM_REFLECT:
  prove(
    [
      @hol|{!x m n. sum(m..n) x = if n < m then &0 else sum(0..n-m) (\i. x(n - i))}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [sum]) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [MATCH_MP(ITERATE_REFLECT)(MONOIDAL_REAL_ADD)]) then_tac \
      REWRITE_TAC(PairList [NEUTRAL_REAL_ADD])
    ]
  )

def REAL_OF_NUM_SUM_NUMSEG:
  prove(
    [
      @hol|{!f m n. (&(nsum(m..n) f) = sum (m..n) (\i. &(f i)))}|,
      SIMP_TAC(PairList [REAL_OF_NUM_SUM, FINITE_NUMSEG])
    ]
  )

def SUM_PARTIAL_SUC:
  prove(
    [
      @hol|{!f g m n.
         sum (m..n) (\k. f(k) * (g(k + 1) - g(k))) =
             if m <= n then f(n + 1) * g(n + 1) - f(m) * g(m) -
                            sum (m..n) (\k. g(k + 1) * (f(k + 1) - f(k)))
             else &0}|,
      GEN_TAC then_tac GEN_TAC then_tac GEN_TAC then_tac INDUCT_TAC then_tac \
      COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList [SUM_TRIV_NUMSEG, GSYM(NOT_LE)]) then_tac \
      ASM_REWRITE_TAC(PairList [SUM_CLAUSES_NUMSEG]) then_list \
      PairList [
        COND_CASES_TAC then_tac ASM_SIMP_TAC(PairList []) then_list \
        PairList [REAL_ARITH_TAC, ASM_ARITH_TAC],
        ALL_TAC
      ] then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [LE]))) then_tac \
      DISCH_THEN(DISJ_CASES_THEN2(SUBST_ALL_TAC)(ASSUME_TAC)) then_tac \
      ASM_SIMP_TAC(
        PairList [
          GSYM(NOT_LT),
          SUM_TRIV_NUMSEG,
          ARITH_RULE(
            @hol|{n < SUC n}|
          )
        ]
      ) then_tac \
      ASM_SIMP_TAC(PairList [GSYM(ADD1), ADD_CLAUSES]) then_tac \
      REAL_ARITH_TAC
    ]
  )

def SUM_PARTIAL_PRE:
  prove(
    [
      @hol|{!f g m n.
         sum (m..n) (\k. f(k) * (g(k) - g(k - 1))) =
             if m <= n then f(n + 1) * g(n) - f(m) * g(m - 1) -
                            sum (m..n) (\k. g k * (f(k + 1) - f(k)))
             else &0}|,
      REPEAT(GEN_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:num->real}|,
            @hol|{\k. (g:num->real)(k - 1)}|,
            @hol|{m:num}|,
            @hol|{n:num}|
          ])(
          SUM_PARTIAL_SUC
        )
      ) then_tac \
      REWRITE_TAC(PairList [ADD_SUB]) then_tac \
      DISCH_THEN(SUBST1_TAC) then_tac \
      COND_CASES_TAC then_tac \
      REWRITE_TAC(PairList [])
    ]
  )

def SUM_DIFFS:
  prove(
    [
      @hol|{!m n. sum(m..n) (\k. f(k) - f(k + 1)) =
         if m <= n then f(m) - f(n + 1) else &0}|,
      ONCE_REWRITE_TAC(
        PairList [
          REAL_ARITH(
            @hol|{a - b = -- &1 * (b - a)}|
          )
        ]
      ) then_tac \
      ONCE_REWRITE_TAC(PairList [SUM_PARTIAL_SUC]) then_tac \
      REWRITE_TAC(PairList [REAL_SUB_REFL, REAL_MUL_RZERO, SUM_0]) then_tac \
      REAL_ARITH_TAC
    ]
  )

def SUM_DIFFS_ALT:
  prove(
    [
      @hol|{!m n. sum(m..n) (\k. f(k + 1) - f(k)) =
         if m <= n then f(n + 1) - f(m) else &0}|,
      REPEAT(GEN_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_NEG_SUB)]) then_tac \
      SIMP_TAC(PairList [SUM_NEG, SUM_DIFFS]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [REAL_NEG_SUB, REAL_NEG_0])
    ]
  )

def SUM_COMBINE_R:
  prove(
    [
      @hol|{!f m n p. m <= n + 1 /\ n <= p
         ==> sum(m..n) f + sum(n+1..p) f = sum(m..p) f}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(SUM_UNION_EQ) then_tac \
      REWRITE_TAC(
        PairList [
          FINITE_NUMSEG,
          EXTENSION,
          IN_INTER,
          IN_UNION,
          NOT_IN_EMPTY,
          IN_NUMSEG
        ]
      ) then_tac \
      ASM_ARITH_TAC
    ]
  )

def SUM_COMBINE_L:
  prove(
    [
      @hol|{!f m n p. 0 < n /\ m <= n /\ n <= p + 1
         ==> sum(m..n-1) f + sum(n..p) f = sum(m..p) f}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(SUM_UNION_EQ) then_tac \
      REWRITE_TAC(
        PairList [
          FINITE_NUMSEG,
          EXTENSION,
          IN_INTER,
          IN_UNION,
          NOT_IN_EMPTY,
          IN_NUMSEG
        ]
      ) then_tac \
      ASM_ARITH_TAC
    ]
  )

def initialization_2:
  let th:
    prove(
      [
        @hol|{(!f g s:A->bool.
                (!x. x IN s ==> f(x) = g(x))
                ==> sum s (\i. f(i)) = sum s g) /\
           (!f g a b. (!i. a <= i /\ i <= b ==> f(i) = g(i))
                      ==> sum(a..b) (\i. f(i)) = sum(a..b) g) /\
           (!f g p. (!x. p x ==> f x = g x)
                    ==> sum {y | p y} (\i. f(i)) = sum {y | p y} g)}|,
        REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(SUM_EQ) then_tac \
        ASM_SIMP_TAC(PairList [IN_ELIM_THM, IN_NUMSEG])
      ]
    )
  extend_basic_congs(map(SPEC_ALL)(CONJUNCTS(th)))

def EXPAND_SUM_CONV:
  let PairList [pth_0, & PairList [pth_1, & PairList [pth_2, & PairList []]]]:
    o(CONJUNCTS)(prove)(
      [
        @hol|{(n < m ==> sum(m..n) f = &0) /\
           sum(m..m) f = f m /\
           (m <= n ==> sum (m..n) f = f m + sum (m + 1..n) f)}|,
        REWRITE_TAC(PairList [SUM_CLAUSES_LEFT, SUM_SING_NUMSEG, SUM_TRIV_NUMSEG])
      ]
    )
  let ns_tm = @hol|{..}|
  let f_tm = @hol|{f:num->real}|
  let m_tm = @hol|{m:num}|
  let n_tm = @hol|{n:num}|
  fun conv(tm):
    let [smn, ftm] = dest_comb(tm)
    let [s, mn] = dest_comb(smn)
    if !(is_const(s) && (fst(dest_const(s)) == "sum"))
    | failwith("EXPAND_SUM_CONV")
    | let [mtm, ntm] = dest_binop(ns_tm)(mn)
      let m = dest_numeral(mtm)
      let n = dest_numeral(ntm)
      if (n < m)
      | let th1 = INST(PairList [[ftm, f_tm], [mtm, m_tm], [ntm, n_tm]])(pth_0)
        MP(th1)(EQT_ELIM(NUM_LT_CONV(lhand(concl(th1)))))
      | if (n == m)
        | CONV_RULE(RAND_CONV(TRY_CONV(BETA_CONV)))(INST(PairList [[ftm, f_tm], [mtm, m_tm]])(pth_1))
        | let th1 = INST(PairList [[ftm, f_tm], [mtm, m_tm], [ntm, n_tm]])(pth_2)
          let th2 = MP(th1)(EQT_ELIM(NUM_LE_CONV(lhand(concl(th1)))))
          CONV_RULE(
            RAND_CONV(
              COMB2_CONV(RAND_CONV(TRY_CONV(BETA_CONV)))(LAND_CONV(LAND_CONV(NUM_ADD_CONV)) then_conv conv)
            )
          )(th2)
  conv

def REAL_SUB_POW:
  prove(
    [
      @hol|{!x y n.
         1 <= n ==> x pow n - y pow n =
                    (x - y) * sum(0..n-1) (\i. x pow i * y pow (n - 1 - i))}|,
      REWRITE_TAC(PairList [GSYM(SUM_LMUL)]) then_tac \
      REWRITE_TAC(
        PairList [
          REAL_ARITH(
            @hol|{(x - y) * (a * b):real = (x * a) * b - a * (y * b)}|
          )
        ]
      ) then_tac \
      SIMP_TAC(
        PairList [
          GSYM(real_pow),
          ADD1,
          ARITH_RULE(
            @hol|{1 <= n /\ x <= n - 1
               ==> n - 1 - x = n - (x + 1) /\ SUC(n - 1 - x) = n - x}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [SUM_DIFFS_ALT, LE_0]) then_tac \
      SIMP_TAC(
        PairList [
          SUB_0,
          SUB_ADD,
          SUB_REFL,
          real_pow,
          REAL_MUL_LID,
          REAL_MUL_RID
        ]
      )
    ]
  )

def REAL_SUB_POW_R1:
  prove(
    [
      @hol|{!x n. 1 <= n ==> x pow n - &1 = (x - &1) * sum(0..n-1) (\i. x pow i)}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN(
        o(
          o(MP_TAC)(
            SPECL(
              PairList [
                @hol|{x:real}|,
                @hol|{&1}|
              ]
            )
          )
        )(MATCH_MP(REAL_SUB_POW))
      ) then_tac \
      REWRITE_TAC(PairList [REAL_POW_ONE, REAL_MUL_RID])
    ]
  )

def REAL_SUB_POW_L1:
  prove(
    [
      @hol|{!x n. 1 <= n ==> &1 - x pow n = (&1 - x) * sum(0..n-1) (\i. x pow i)}|,
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_NEG_SUB)]) then_tac \
      SIMP_TAC(PairList [REAL_SUB_POW_R1]) then_tac \
      REWRITE_TAC(PairList [REAL_MUL_LNEG])
    ]
  )

def REAL_SUB_POLYFUN:
  prove(
    [
      @hol|{!a x y n.
         1 <= n
         ==> sum(0..n) (\i. a i * x pow i) - sum(0..n) (\i. a i * y pow i) =
             (x - y) *
             sum(0..n-1) (\j. sum(j+1..n) (\i. a i * y pow (i - j - 1)) * x pow j)}|,
      REPEAT(STRIP_TAC) then_tac \
      REWRITE_TAC(PairList [GSYM(SUM_SUB_NUMSEG), GSYM(REAL_SUB_LDISTRIB)]) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [MATCH_MP(SUM_CLAUSES_LEFT)(SPEC_ALL(LE_0))]) then_tac \
      REWRITE_TAC(PairList [REAL_SUB_REFL, real_pow, REAL_MUL_RZERO, REAL_ADD_LID]) then_tac \
      SIMP_TAC(PairList [REAL_SUB_POW, ADD_CLAUSES]) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          REAL_ARITH(
            @hol|{a * x * s:real = x * a * s}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [SUM_LMUL]) then_tac \
      AP_TERM_TAC then_tac \
      SIMP_TAC(PairList [GSYM(SUM_LMUL), GSYM(SUM_RMUL), SUM_SUM_PRODUCT, FINITE_NUMSEG]) then_tac \
      MATCH_MP_TAC(SUM_EQ_GENERAL_INVERSES) then_tac \
      REPEAT(
        EXISTS_TAC(
          @hol|{\(x:num,y:num). (y,x)}|
        )
      ) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_GSPEC, IN_ELIM_PAIR_THM, IN_NUMSEG]) then_tac \
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            @hol|{a - b - c:num = a - (b + c)}|
          ),
          ADD_SYM
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REAL_MUL_AC]) then_tac \
      ARITH_TAC
    ]
  )

def REAL_SUB_POLYFUN_ALT:
  prove(
    [
      @hol|{!a x y n.
         1 <= n
         ==> sum(0..n) (\i. a i * x pow i) - sum(0..n) (\i. a i * y pow i) =
             (x - y) *
             sum(0..n-1) (\j. sum(0..n-j-1) (\k. a(j+k+1) * y pow k) * x pow j)}|,
      REPEAT(STRIP_TAC) then_tac ASM_SIMP_TAC(PairList [REAL_SUB_POLYFUN]) then_tac \
      AP_TERM_TAC then_tac \
      MATCH_MP_TAC(SUM_EQ_NUMSEG) then_tac \
      X_GEN_TAC(@hol|{j:num}|) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      AP_THM_TAC then_tac \
      AP_TERM_TAC then_tac \
      MATCH_MP_TAC(SUM_EQ_GENERAL_INVERSES) then_tac \
      MAP_EVERY(EXISTS_TAC)(
        PairList [
          @hol|{\i. i - (j + 1)}|,
          @hol|{\k. j + k + 1}|
        ]
      ) then_tac \
      REWRITE_TAC(PairList [IN_NUMSEG]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      TRY(BINOP_TAC then_tac AP_TERM_TAC) then_tac \
      ASM_ARITH_TAC
    ]
  )

def REAL_POLYFUN_ROOTBOUND:
  prove(
    [
      @hol|{!n c. ~(!i. i IN 0..n ==> c i = &0)
         ==> FINITE {x | sum(0..n) (\i. c i * x pow i) = &0} /\
             CARD {x | sum(0..n) (\i. c i * x pow i) = &0} <= n}|,
      REWRITE_TAC(PairList [NOT_FORALL_THM, NOT_IMP]) then_tac INDUCT_TAC then_list \
      PairList [
        REWRITE_TAC(PairList [NUMSEG_SING, IN_SING, UNWIND_THM2, SUM_CLAUSES_NUMSEG]) then_tac \
        SIMP_TAC(
          PairList [
            real_pow,
            REAL_MUL_RID,
            EMPTY_GSPEC,
            CARD_CLAUSES,
            FINITE_EMPTY,
            LE_REFL
          ]
        ),
        X_GEN_TAC(@hol|{c:num->real}|) then_tac \
        REWRITE_TAC(PairList [IN_NUMSEG]) then_tac \
        DISCH_TAC then_tac \
        ASM_CASES_TAC(
          @hol|{(c:num->real) (SUC n) = &0}|
        ) then_list \
        PairList [
          ASM_SIMP_TAC(PairList [SUM_CLAUSES_NUMSEG, LE_0, REAL_MUL_LZERO, REAL_ADD_RID]) then_tac \
          REWRITE_TAC(PairList [LE, LEFT_OR_DISTRIB]) then_tac \
          DISJ2_TAC then_tac \
          FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
          ASM_MESON_TAC(PairList [IN_NUMSEG, LE]),
          ASM_CASES_TAC(
            @hol|{{x | sum (0..SUC n) (\i. c i * x pow i) = &0} = {}}|
          ) then_tac \
          ASM_REWRITE_TAC(PairList [FINITE_RULES, CARD_CLAUSES, LE_0]) then_tac \
          FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [GSYM(MEMBER_NOT_EMPTY)]))) then_tac \
          REWRITE_TAC(PairList [IN_ELIM_THM, LEFT_IMP_EXISTS_THM]) then_tac \
          X_GEN_TAC(@hol|{r:real}|) then_tac \
          DISCH_TAC then_tac \
          MP_TAC(
            GEN(@hol|{x:real}|)(
              ISPECL(
                PairList [
                  @hol|{c:num->real}|,
                  @hol|{x:real}|,
                  @hol|{r:real}|,
                  @hol|{SUC n}|
                ])(
                REAL_SUB_POLYFUN
              )
            )
          ) then_tac \
          ASM_REWRITE_TAC(
            PairList [
              ARITH_RULE(
                @hol|{1 <= SUC n}|
              ),
              REAL_SUB_RZERO
            ]
          ) then_tac \
          DISCH_THEN((fun(th): REWRITE_TAC(PairList [th, REAL_ENTIRE, REAL_SUB_0]))) then_tac \
          REWRITE_TAC(
            PairList [
              SET_RULE(
                @hol|{{x | x = c \/ P x} = c INSERT {x | P x}}|
              )
            ]
          ) then_tac \
          MATCH_MP_TAC(
            MESON(
              PairList [
                FINITE_INSERT,
                CARD_CLAUSES,
                ARITH_RULE(
                  @hol|{x <= n ==> SUC x <= SUC n /\ x <= SUC n}|
                )
              ])(
              @hol|{FINITE s /\ CARD s <= n
                 ==> FINITE(r INSERT s) /\ CARD(r INSERT s) <= SUC n}|
            )
          ) then_tac \
          REWRITE_TAC(PairList [SUC_SUB1]) then_tac \
          FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
          EXISTS_TAC(@hol|{n:num}|) then_tac \
          REWRITE_TAC(PairList [IN_NUMSEG, ADD1, LE_REFL, LE_0]) then_tac \
          REWRITE_TAC(
            PairList [
              SUM_SING_NUMSEG,
              ARITH_RULE(
                @hol|{(n + 1) - n - 1 = 0}|
              )
            ]
          ) then_tac \
          ASM_REWRITE_TAC(PairList [GSYM(ADD1), real_pow, REAL_MUL_RID])
        ]
      ]
    ]
  )

def REAL_POLYFUN_FINITE_ROOTS:
  prove(
    [
      @hol|{!n c. FINITE {x | sum(0..n) (\i. c i * x pow i) = &0} <=>
         ?i. i IN 0..n /\ ~(c i = &0)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{a /\ ~b <=> ~(a ==> b)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(NOT_FORALL_THM)]) then_tac \
      EQ_TAC then_tac \
      SIMP_TAC(PairList [REAL_POLYFUN_ROOTBOUND]) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(CONTRAPOS_THM)]) then_tac \
      SIMP_TAC(PairList [REAL_MUL_LZERO, SUM_0]) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{{x | T} = (:real)}|
          ),
          real_INFINITE,
          GSYM(INFINITE)
        ]
      )
    ]
  )

def REAL_POLYFUN_EQ_0:
  prove(
    [
      @hol|{!n c. (!x. sum(0..n) (\i. c i * x pow i) = &0) <=>
         (!i. i IN 0..n ==> c i = &0)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_list \
      PairList [
        GEN_REWRITE_TAC(I)(PairList [TAUT(@hol|{p <=> ~ ~p}|)]) then_tac \
        DISCH_THEN(o(MP_TAC)(MATCH_MP(REAL_POLYFUN_ROOTBOUND))) then_tac \
        ASM_REWRITE_TAC(
          PairList [
            real_INFINITE,
            GSYM(INFINITE),
            DE_MORGAN_THM,
            SET_RULE(
              @hol|{{x | T} = (:real)}|
            )
          ]
        ),
        ASM_SIMP_TAC(PairList [IN_NUMSEG, LE_0, REAL_MUL_LZERO, SUM_0])
      ]
    ]
  )

def REAL_POLYFUN_EQ_CONST:
  prove(
    [
      @hol|{!n c k. (!x. sum(0..n) (\i. c i * x pow i) = k) <=>
         c 0 = k /\ (!i. i IN 1..n ==> c i = &0)}|,
      REPEAT(GEN_TAC) then_tac MATCH_MP_TAC(EQ_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{!x. sum(0..n) (\i. (if i = 0 then c 0 - k else c i) * x pow i) = &0}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        SIMP_TAC(PairList [SUM_CLAUSES_LEFT, LE_0, real_pow, REAL_MUL_RID]) then_tac \
        REWRITE_TAC(
          PairList [
            REAL_ARITH(
              @hol|{(c - k) + s = &0 <=> c + s = k}|
            )
          ]
        ) then_tac \
        AP_TERM_TAC then_tac \
        ABS_TAC then_tac \
        AP_THM_TAC then_tac \
        AP_TERM_TAC then_tac \
        AP_TERM_TAC then_tac \
        MATCH_MP_TAC(SUM_EQ) then_tac \
        GEN_TAC then_tac \
        REWRITE_TAC(PairList [IN_NUMSEG]) then_tac \
        COND_CASES_TAC then_tac \
        ASM_REWRITE_TAC(PairList [ARITH]),
        REWRITE_TAC(PairList [REAL_POLYFUN_EQ_0, IN_NUMSEG, LE_0]) then_tac \
        GEN_REWRITE_TAC(LAND_CONV)(
          PairList [
            MESON(
              PairList [])(
              @hol|{(!n. P n) <=> P 0 /\ (!n. ~(n = 0) ==> P n)}|
            )
          ]
        ) then_tac \
        SIMP_TAC(PairList [LE_0, REAL_SUB_0]) then_tac \
        MESON_TAC(PairList [LE_1])
      ]
    ]
  )

def polynomial_function:
  new_definition(
    @hol|{polynomial_function p <=> ?m c. !x. p x = sum(0..m) (\i. c i * x pow i)}|
  )

def POLYNOMIAL_FUNCTION_CONST:
  prove(
    [
      @hol|{!c. polynomial_function (\x. c)}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [polynomial_function]) then_tac \
      MAP_EVERY(EXISTS_TAC)(
        PairList [
          @hol|{0}|,
          @hol|{(\i. c):num->real}|
        ]
      ) then_tac \
      REWRITE_TAC(PairList [SUM_SING_NUMSEG, real_pow, REAL_MUL_RID])
    ]
  )

def POLYNOMIAL_FUNCTION_ID:
  prove(
    [
      @hol|{polynomial_function (\x. x)}|,
      REWRITE_TAC(PairList [polynomial_function]) then_tac \
      MAP_EVERY(EXISTS_TAC)(
        PairList [
          @hol|{SUC 0}|,
          @hol|{\i. if i = 1 then &1 else &0}|
        ]
      ) then_tac \
      REWRITE_TAC(PairList [SUM_CLAUSES_NUMSEG, LE_0, ARITH]) then_tac \
      REAL_ARITH_TAC
    ]
  )

def POLYNOMIAL_FUNCTION_I:
  prove(
    [
      @hol|{polynomial_function I}|,
      REWRITE_TAC(PairList [I_DEF, POLYNOMIAL_FUNCTION_ID])
    ]
  )

def POLYNOMIAL_FUNCTION_ADD:
  prove(
    [
      @hol|{!p q. polynomial_function p /\ polynomial_function q
         ==> polynomial_function (\x. p x + q x)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [IMP_CONJ, polynomial_function, LEFT_IMP_EXISTS_THM]) then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{m:num}|, @hol|{a:num->real}|]) then_tac \
      STRIP_TAC then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{n:num}|, @hol|{b:num->real}|]) then_tac \
      STRIP_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      EXISTS_TAC(@hol|{MAX m n}|) then_tac \
      EXISTS_TAC(
        @hol|{\i:num. (if i <= m then a i else &0) + (if i <= n then b i else &0)}|
      ) then_tac \
      GEN_TAC then_tac \
      REWRITE_TAC(PairList [REAL_ADD_RDISTRIB, SUM_ADD_NUMSEG]) then_tac \
      REWRITE_TAC(PairList [COND_RAND, COND_RATOR, REAL_MUL_LZERO]) then_tac \
      REWRITE_TAC(PairList [GSYM(SUM_RESTRICT_SET)]) then_tac \
      BINOP_TAC then_tac \
      BINOP_TAC then_tac \
      REWRITE_TAC(PairList []) then_tac \
      REWRITE_TAC(PairList [EXTENSION, IN_ELIM_THM, IN_NUMSEG]) then_tac \
      ARITH_TAC
    ]
  )

def POLYNOMIAL_FUNCTION_LMUL:
  prove(
    [
      @hol|{!p c. polynomial_function p ==> polynomial_function (\x. c * p x)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [IMP_CONJ, polynomial_function, LEFT_IMP_EXISTS_THM]) then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{n:num}|, @hol|{a:num->real}|]) then_tac \
      STRIP_TAC then_tac \
      MAP_EVERY(EXISTS_TAC)(
        PairList [
          @hol|{n:num}|,
          @hol|{\i. c * (a:num->real) i}|
        ]
      ) then_tac \
      ASM_REWRITE_TAC(PairList [SUM_LMUL, GSYM(REAL_MUL_ASSOC)])
    ]
  )

def POLYNOMIAL_FUNCTION_RMUL:
  prove(
    [
      @hol|{!p c. polynomial_function p ==> polynomial_function (\x. p x * c)}|,
      ONCE_REWRITE_TAC(PairList [REAL_MUL_SYM]) then_tac \
      REWRITE_TAC(PairList [POLYNOMIAL_FUNCTION_LMUL])
    ]
  )

def POLYNOMIAL_FUNCTION_NEG:
  prove(
    [
      @hol|{!p. polynomial_function(\x. --(p x)) <=> polynomial_function p}|,
      GEN_TAC then_tac EQ_TAC then_tac \
      DISCH_THEN(
        o(
          o(MP_TAC)(
            SPEC(
              @hol|{--(&1)}|
            )
          )
        )(MATCH_MP(POLYNOMIAL_FUNCTION_LMUL))
      ) then_tac \
      REWRITE_TAC(PairList [REAL_MUL_LNEG, REAL_MUL_LID, ETA_AX, REAL_NEG_NEG])
    ]
  )

def POLYNOMIAL_FUNCTION_SUB:
  prove(
    [
      @hol|{!p q. polynomial_function p /\ polynomial_function q
         ==> polynomial_function (\x. p x - q x)}|,
      SIMP_TAC(PairList [real_sub, POLYNOMIAL_FUNCTION_NEG, POLYNOMIAL_FUNCTION_ADD])
    ]
  )

def POLYNOMIAL_FUNCTION_MUL:
  prove(
    [
      @hol|{!p q. polynomial_function p /\ polynomial_function q
         ==> polynomial_function (\x. p x * q x)}|,
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      GEN_TAC then_tac \
      DISCH_TAC then_tac \
      GEN_REWRITE_TAC(o(BINDER_CONV)(LAND_CONV))(PairList [polynomial_function]) then_tac \
      SIMP_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(!q m c. P q m c) <=> (!m c q. P q m c)}|
          )
        ]
      ) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(FUN_EQ_THM)]) then_tac \
      REWRITE_TAC(PairList [LEFT_FORALL_IMP_THM, EXISTS_REFL]) then_tac \
      INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [SUM_SING_NUMSEG, real_pow, POLYNOMIAL_FUNCTION_RMUL]) then_tac \
      X_GEN_TAC(@hol|{c:num->real}|) then_tac \
      SIMP_TAC(PairList [SUM_CLAUSES_LEFT, LE_0, ADD1]) then_tac \
      REWRITE_TAC(PairList [REAL_ADD_LDISTRIB, real_pow]) then_tac \
      MATCH_MP_TAC(POLYNOMIAL_FUNCTION_ADD) then_tac \
      ASM_SIMP_TAC(PairList [POLYNOMIAL_FUNCTION_RMUL]) then_tac \
      REWRITE_TAC(
        PairList [
          SPEC(
            @hol|{1}|
          )(SUM_OFFSET)
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REAL_POW_ADD, REAL_POW_1, REAL_MUL_ASSOC, SUM_RMUL]) then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPEC(
            @hol|{\i. (c:num->real)(i + 1)}|
          )
        )
      ) then_tac \
      ABBREV_TAC(
        @hol|{q = \x. p x * sum (0..m) (\i. c (i + 1) * x pow i)}|
      ) then_tac \
      RULE_ASSUM_TAC(REWRITE_RULE(PairList [FUN_EQ_THM])) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REWRITE_TAC(PairList [polynomial_function, LEFT_IMP_EXISTS_THM]) then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{n:num}|, @hol|{a:num->real}|]) then_tac \
      STRIP_TAC then_tac \
      EXISTS_TAC(
        @hol|{n + 1}|
      ) then_tac \
      EXISTS_TAC(
        @hol|{\i. if i = 0 then &0 else (a:num->real)(i - 1)}|
      ) then_tac \
      SIMP_TAC(PairList [SUM_CLAUSES_LEFT, LE_0]) then_tac \
      ASM_REWRITE_TAC(
        PairList [
          SPEC(
            @hol|{1}|
          )(SUM_OFFSET),
          ADD_EQ_0,
          ARITH_EQ,
          ADD_SUB
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REAL_POW_ADD, REAL_MUL_ASSOC, SUM_RMUL]) then_tac \
      REAL_ARITH_TAC
    ]
  )

def POLYNOMIAL_FUNCTION_SUM:
  prove(
    [
      @hol|{!s:A->bool p.
         FINITE s /\ (!i. i IN s ==> polynomial_function(\x. p x i))
         ==> polynomial_function (\x. sum s (p x))}|,
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [SUM_CLAUSES, POLYNOMIAL_FUNCTION_CONST]) then_tac \
      SIMP_TAC(PairList [FORALL_IN_INSERT, POLYNOMIAL_FUNCTION_ADD])
    ]
  )

def POLYNOMIAL_FUNCTION_POW:
  prove(
    [
      @hol|{!p n. polynomial_function p ==> polynomial_function (\x. p x pow n)}|,
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM]) then_tac GEN_TAC then_tac \
      DISCH_TAC then_tac \
      INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [real_pow, POLYNOMIAL_FUNCTION_CONST, POLYNOMIAL_FUNCTION_MUL])
    ]
  )

def POLYNOMIAL_FUNCTION_INDUCT:
  prove(
    [
      @hol|{!P. P (\x. x) /\ (!c. P (\x. c)) /\
         (!p q. P p /\ P q ==> P (\x. p x + q x)) /\
         (!p q. P p /\ P q ==> P (\x. p x * q x))
         ==> !p. polynomial_function p ==> P p}|,
      GEN_TAC then_tac STRIP_TAC then_tac \
      REWRITE_TAC(PairList [polynomial_function, LEFT_IMP_EXISTS_THM]) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(!q m c. P q m c) <=> (!m c q. P q m c)}|
          )
        ]
      ) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(FUN_EQ_THM)]) then_tac \
      SIMP_TAC(PairList [LEFT_FORALL_IMP_THM, EXISTS_REFL]) then_tac \
      INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [SUM_SING_NUMSEG, real_pow]) then_tac \
      GEN_TAC then_tac \
      SIMP_TAC(PairList [SUM_CLAUSES_LEFT, ADD1, LE_0]) then_tac \
      FIRST_ASSUM(MATCH_MP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [real_pow]) then_tac \
      REWRITE_TAC(
        PairList [
          SPEC(
            @hol|{1}|
          )(SUM_OFFSET)
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REAL_POW_ADD, REAL_POW_1, REAL_MUL_ASSOC, SUM_RMUL]) then_tac \
      ASM_SIMP_TAC(PairList [])
    ]
  )

def POLYNOMIAL_FUNCTION_o:
  prove(
    [
      @hol|{!p q. polynomial_function p /\ polynomial_function q
         ==> polynomial_function (p o q)}|,
      ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
      REWRITE_TAC(PairList [IMP_CONJ_ALT, RIGHT_FORALL_IMP_THM]) then_tac \
      GEN_TAC then_tac \
      DISCH_TAC then_tac \
      MATCH_MP_TAC(POLYNOMIAL_FUNCTION_INDUCT) then_tac \
      SIMP_TAC(PairList [o_DEF, POLYNOMIAL_FUNCTION_ADD, POLYNOMIAL_FUNCTION_MUL]) then_tac \
      ASM_REWRITE_TAC(PairList [ETA_AX, POLYNOMIAL_FUNCTION_CONST])
    ]
  )

def POLYNOMIAL_FUNCTION_FINITE_ROOTS:
  prove(
    [
      @hol|{!p a. polynomial_function p
         ==> (FINITE {x | p x = a} <=> ~(!x. p x = a))}|,
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_SUB_0)]) then_tac \
      SUBGOAL_THEN(
        @hol|{!p. polynomial_function p ==> (FINITE {x | p x = &0} <=> ~(!x. p x = &0))}|
      )((fun(th): SIMP_TAC(PairList [th, POLYNOMIAL_FUNCTION_SUB, POLYNOMIAL_FUNCTION_CONST]))) then_tac \
      GEN_TAC then_tac \
      REWRITE_TAC(PairList [polynomial_function]) then_tac \
      STRIP_TAC then_tac \
      EQ_TAC then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(CONTRAPOS_THM)]) then_list \
      PairList [
        SIMP_TAC(PairList [UNIV_GSPEC, GSYM(INFINITE), real_INFINITE]),
        ASM_REWRITE_TAC(PairList [REAL_POLYFUN_FINITE_ROOTS]) then_tac \
        SIMP_TAC(
          PairList [
            NOT_EXISTS_THM,
            TAUT(
              @hol|{~(p /\ ~q) <=> p ==> q}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [REAL_MUL_LZERO, SUM_0])
      ]
    ]
  )

prioritize_num(#void)
