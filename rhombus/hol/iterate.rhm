def REAL_POLYFUN_EQ_CONST:
  prove(
    [
      (hol:
         const sum :: (A -> bool) -> (A -> real) -> real
         const #{..} :: num -> num -> num -> bool
         const real_pow :: real -> num -> real
         const IN :: A -> (A -> bool) -> bool
         forall (n :: num, c :: num -> real, k :: real):
           (forall x :: real: sum(#{..}((0 :: num), n), fun (i :: num): c(i) * real_pow(x, i)) == k)
             <=> (c((0 :: num)) == k
                    && (forall i :: num: IN(i, #{..}((1 :: num), n)) ==> c(i) == (0 :: real)))),
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac MATCH_MP_TAC(EQ_TRANS)) then_tac \
            EXISTS_TAC(
              (hol:
                 var n :: num
                 var c :: num -> real
                 var k :: real
                 const sum :: (A -> bool) -> (A -> real) -> real
                 const #{..} :: num -> num -> num -> bool
                 const real_pow :: real -> num -> real
                 forall x :: real:
                   sum(
                     #{..}((0 :: num), n),
                     fun (i :: num): (if i == (0 :: num) | c((0 :: num)) - k | c(i)) * real_pow(x, i)
                   )
                     == (0 :: real))
            )
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                SIMP_TAC(PairList [SUM_CLAUSES_LEFT, LE_0, real_pow, REAL_MUL_RID]) then_tac \
                                REWRITE_TAC(
                                  PairList [
                                    REAL_ARITH(
                                      (hol:
                                         var c :: real
                                         var k :: real
                                         var s :: real
                                         c - k + s == (0 :: real) <=> c + s == k)
                                    )
                                  ]
                                )
                              ) then_tac \
                              AP_TERM_TAC
                            ) then_tac \
                            ABS_TAC
                          ) then_tac \
                          AP_THM_TAC
                        ) then_tac \
                        AP_TERM_TAC
                      ) then_tac \
                      AP_TERM_TAC
                    ) then_tac \
                    MATCH_MP_TAC(SUM_EQ)
                  ) then_tac \
                  GEN_TAC
                ) then_tac \
                REWRITE_TAC(PairList [IN_NUMSEG])
              ) then_tac \
              COND_CASES_TAC
            ) then_tac \
            ASM_REWRITE_TAC(PairList [ARITH])
          ),
          (
            (
              (
                REWRITE_TAC(PairList [REAL_POLYFUN_EQ_0, IN_NUMSEG, LE_0]) then_tac \
                GEN_REWRITE_TAC(LAND_CONV)(
                  PairList [
                    MESON(
                      PairList [])(
                      (hol:
                         var P :: num -> bool
                         (forall n :: num: P(n)) <=> P((0 :: num)) && (forall n :: num: n != (0 :: num) ==> P(n)))
                    )
                  ]
                )
              ) then_tac \
              SIMP_TAC(PairList [LE_0, REAL_SUB_0])
            ) then_tac \
            MESON_TAC(PairList [LE_1])
          )
        ]
      )
    ]
  )

def polynomial_function:
  new_definition(
    (hol:
       var polynomial_function :: (real -> real) -> bool
       var p :: real -> real
       const sum :: (A -> bool) -> (A -> real) -> real
       const #{..} :: num -> num -> num -> bool
       const real_pow :: real -> num -> real
       polynomial_function(p)
         <=> (exists (m :: num, c :: num -> real):
                forall x :: real:
                  p(x) == sum(#{..}((0 :: num), m), fun (i :: num): c(i) * real_pow(x, i))))
  )

