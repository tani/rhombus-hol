                 var s :: A -> bool
                 var f :: A -> num
                 const nsum :: (A -> bool) -> (A -> num) -> num
                 nsum(s, fun (a :: A): f(a) + (1 :: num)))
            )
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            (MATCH_MP_TAC(NSUM_LT_ALL) then_tac ASM_SIMP_TAC(PairList [])) then_tac \
            ARITH_TAC
          ),
          (
            MATCH_MP_TAC(NSUM_BOUND_GEN) then_tac \
            ASM_REWRITE_TAC(
              PairList [
                ARITH_RULE(
                  (hol:
                     var a :: num
                     var b :: num
                     a + (1 :: num) <= b <=> a < b)
                )
              ]
            )
          )
        ]
      )
    ]
  )

def NSUM_UNION_EQ:
  prove(
    [
      (hol:
         var f :: A -> num
         const FINITE :: (A -> bool) -> bool
         const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         const nsum :: (A -> bool) -> (A -> num) -> num
         forall (s :: A -> bool, t :: A -> bool, u :: A -> bool):
           FINITE(u) && (INTER(s, t) == EMPTY && UNION(s, t) == u)
             ==> nsum(s, f) + nsum(t, f) == nsum(u, f)),
      MESON_TAC(PairList [NSUM_UNION, DISJOINT, FINITE_SUBSET, SUBSET_UNION])
    ]
  )

def NSUM_EQ_SUPERSET:
  prove(
    [
      (hol:
         var g :: A -> num
         const FINITE :: (A -> bool) -> bool
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const nsum :: (A -> bool) -> (A -> num) -> num
         forall (f :: A -> num, s :: A -> bool, t :: A -> bool):
           (FINITE(t)
              && (SUBSET(t, s)
                    && ((forall x :: A: IN(x, t) ==> f(x) == g(x))
                          && (forall x :: A: IN(x, s) && !IN(x, t) ==> f(x) == (0 :: num)))))
             ==> nsum(s, f) == nsum(t, g)),
      MESON_TAC(PairList [NSUM_SUPERSET, NSUM_EQ])
    ]
  )

