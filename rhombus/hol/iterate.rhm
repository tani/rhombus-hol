         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const sum :: (A -> bool) -> (A -> real) -> real
         const real_of_num :: num -> real
         const CARD :: (A -> bool) -> num
         forall (s :: A -> bool, f :: A -> real, b :: real):
           FINITE(s) && (forall x :: A: IN(x, s) ==> f(x) <= b)
             ==> sum(s, f) <= real_of_num(CARD(s)) * b),
      SIMP_TAC(PairList [GSYM(SUM_CONST), SUM_LE])
    ]
  )

