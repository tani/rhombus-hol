def NSUM_SUBSET:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
         const nsum :: (A -> bool) -> (A -> num) -> num
         forall (u :: A -> bool, v :: A -> bool, f :: A -> num):
           FINITE(u) && (FINITE(v) && (forall x :: A: IN(x, DIFF(u, v)) ==> f(x) == (0 :: num)))
             ==> nsum(u, f) <= nsum(v, f)),
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(STRIP_TAC) then_tac \
                    MP_TAC(
                      ISPECL(
                        PairList [
                          (hol: var f :: A -> num; f),
                          (hol:
                             var u :: A -> bool
                             var v :: A -> bool
                             const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
                             INTER(u, v))
                        ])(
                        NSUM_UNION
                      )
                    )
                  ) then_tac \
                  DISCH_THEN(
                    fun(th):
                      (
                        MP_TAC(
                          SPEC(
                            (hol:
                               var v :: A -> bool
                               var u :: A -> bool
                               const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                               DIFF(v, u))
                          )(th)
                        ) then_tac \
                        MP_TAC(
                          SPEC(
                            (hol:
                               var u :: A -> bool
                               var v :: A -> bool
                               const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                               DIFF(u, v))
                          )(th)
                        )
                      )
                  )
                ) then_tac \
                REWRITE_TAC(
                  PairList [
                    SET_RULE(
                      (hol:
                         var u :: #{?123988} -> bool
                         var v :: #{?123988} -> bool
                         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
                         const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
                         const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                         UNION(INTER(u, v), DIFF(u, v)) == u)
                    ),
                    SET_RULE(
                      (hol:
                         var u :: #{?123975} -> bool
                         var v :: #{?123975} -> bool
                         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
                         const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
                         const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                         UNION(INTER(u, v), DIFF(v, u)) == v)
                    )
                  ]
                )
              ) then_tac \
              ASM_SIMP_TAC(PairList [FINITE_DIFF, FINITE_INTER])
            ) then_tac \
            REPEAT(
              (
                ANTS_TAC then_list \
                PairList [SET_TAC(PairList []), DISCH_THEN(SUBST1_TAC)]
              )
            )
          ) then_tac \
          ASM_SIMP_TAC(PairList [NSUM_EQ_0])
        ) then_tac \
        ARITH_TAC
      )
    ]
  )

