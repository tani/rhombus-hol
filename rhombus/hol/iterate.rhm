                                    Const("<=", Fun(Num, Fun(Num, Bool))),
                                    App(
                                      Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                                      [
                                        App(
                                          Const("+", Fun(Num, Fun(Num, Num))),
                                          [
                                            Ref("m"),
                                            App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                                          ]
                                        ),
                                        Ref("n")
                                      ]
                                    ),
                                    Ref("f")
                                  ]
                                )
                              ]
                            )
                          ]
                        ),
                        Ref("neut")
                      ]
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  REPEAT(GEN_TAC) then_tac \
                  MP_TAC(
                    ISPECL(
                      PairList [
                        Host.hol_term(Var("dom", Fun(Tvar("A"), Bool))),
                        Host.hol_term(Var("neut", Tvar("A"))),
                        Host.hol_term(Var("op", Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A"))))),
                        Host.hol_term(Const("<=", Fun(Num, Fun(Num, Bool)))),
                        Host.hol_term(Var("f", Fun(Num, Tvar("A"))))
                      ])(
                      ITERATO_CLAUSES_GEN
                    )
                  )
                ) then_tac \
                COND_CASES_TAC
              ) then_list \
              PairList [
                DISCH_THEN((fun(th): (ASM_SIMP_TAC(PairList [GSYM(NUMSEG_LREC)]) then_tac MP_TAC(th)))),
                (
                  DISCH_THEN(o(MP_TAC)(CONJUNCT1)) then_tac \
                  ASM_MESON_TAC(PairList [NUMSEG_EMPTY, NOT_LE])
                )
              ]
            ) then_tac \
            DISCH_THEN(
              o(
                o(MP_TAC)(
                  SPECL(
                    PairList [
                      Host.hol_term(Var("m", Num)),
                      Host.hol_term(App(
                        Const("..", Fun(Num, Fun(Num, Fun(Num, Bool)))),
                        [
                          App(
                            Const("+", Fun(Num, Fun(Num, Num))),
                            [
                              Var("m", Num),
                              App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                            ]
                          ),
                          Var("n", Num)
                        ]
                      ))
                    ]
                  )
                )
              )(CONJUNCT2)
            )
          ) then_tac \
          ANTS_TAC
        ) then_list \
        PairList [
          (
            SIMP_TAC(PairList [FINITE_RESTRICT, FINITE_NUMSEG, IN_NUMSEG]) then_tac \
            ARITH_TAC
          ),
          REWRITE_TAC(
            PairList [
              IN_NUMSEG,
              ARITH_RULE(
                Host.hol_term(Not(
                  App(
                    Const("<=", Fun(Num, Fun(Num, Bool))),
                    [
                      App(
                        Const("+", Fun(Num, Fun(Num, Num))),
                        [
                          Var("m", Num),
                          App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                        ]
                      ),
                      Var("m", Num)
                    ]
                  )
                ))
              )
            ]
          )
        ]
      )
    ]
  )

