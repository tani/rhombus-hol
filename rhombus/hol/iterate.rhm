def ITERATE_OP_GEN:
  prove(
    [
      (hol:
         const monoidal :: (A -> A -> A) -> bool
         const FINITE :: (A -> bool) -> bool
         const support :: (B -> B -> B) -> (A -> B) -> (A -> bool) -> A -> bool
         const iterate :: (B -> B -> B) -> (A -> bool) -> (A -> B) -> B
         forall op :: B -> B -> B:
           monoidal(op)
             ==> (forall (f :: A -> B, g :: A -> B, s :: A -> bool):
                    FINITE(support(op, f, s)) && FINITE(support(op, g, s))
                      ==> (iterate(op, s, fun (x :: A): op(f(x), g(x)))
                             == op(iterate(op, s, f), iterate(op, s, g))))),
      (
        (
