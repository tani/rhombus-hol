def SUM_MULTICOUNT_GEN:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const sum :: (A -> bool) -> (A -> real) -> real
         const real_of_num :: num -> real
         forall (R :: A -> B -> bool, s :: A -> bool, t :: B -> bool, k :: B -> num):
           (FINITE(s)
              && (FINITE(t)
                    && (forall j :: B:
                          IN(j, t)
                            ==> (CARD(
                                   GSPEC(
                                     fun (gen_pvar_322 :: A):
                                       exists i :: A: SETSPEC(gen_pvar_322, IN(i, s) && R(i, j), i)
                                   )
                                 )
                                   == k(j)))))
             ==> (sum(
                    s,
                    fun (i :: A):
                      real_of_num(
                        CARD(
                          GSPEC(
                            fun (gen_pvar_323 :: B):
                              exists j :: B: SETSPEC(gen_pvar_323, IN(j, t) && R(i, j), j)
                          )
                        )
                      )
                  )
                    == sum(t, fun (i :: B): real_of_num(k(i))))),
      (
        (
          (
            (
              (
                (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [CONJ_ASSOC])) then_tac \
                DISCH_THEN(CONJUNCTS_THEN(ASSUME_TAC))
              ) then_tac \
              MATCH_MP_TAC(EQ_TRANS)
            ) then_tac \
            EXISTS_TAC(
              (hol:
                 var s :: A -> bool
                 var t :: B -> bool
                 var R :: A -> B -> bool
                 const sum :: (A -> bool) -> (A -> real) -> real
                 const GSPEC :: (A -> bool) -> A -> bool
                 const SETSPEC :: A -> bool -> A -> bool
                 const IN :: A -> (A -> bool) -> bool
                 sum(
                   s,
                   fun (i :: A):
                     sum(
                       GSPEC(
                         fun (gen_pvar_321 :: B):
                           exists j :: B: SETSPEC(gen_pvar_321, IN(j, t) && R(i, j), j)
                       ),
                       fun (j :: B): (1 :: real)
                     )
                 ))
            )
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            (
              (MATCH_MP_TAC(SUM_EQ) then_tac ASM_REWRITE_TAC(PairList [])) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            ASM_SIMP_TAC(PairList [CARD_EQ_SUM, FINITE_RESTRICT])
          ),
          (
            (
              (
                FIRST_ASSUM((fun(th): ONCE_REWRITE_TAC(PairList [MATCH_MP(SUM_SUM_RESTRICT)(th)]))) then_tac \
                MATCH_MP_TAC(SUM_EQ)
              ) then_tac \
              ASM_SIMP_TAC(PairList [SUM_CONST, FINITE_RESTRICT])
            ) then_tac \
            REWRITE_TAC(PairList [REAL_MUL_RID])
          )
        ]
      )
    ]
  )

