def SUM_GROUP:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const sum :: (A -> bool) -> (A -> real) -> real
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (f :: A -> B, g :: A -> real, s :: A -> bool, t :: B -> bool):
           FINITE(s) && SUBSET(IMAGE(f, s), t)
             ==> (sum(
                    t,
                    fun (y :: B):
                      sum(
                        GSPEC(
                          fun (gen_pvar_327 :: A):
                            exists x :: A: SETSPEC(gen_pvar_327, IN(x, s) && f(x) == y, x)
                        ),
                        g
                      )
                  )
                    == sum(s, g))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      REPEAT(STRIP_TAC) then_tac \
                      MP_TAC(
                        ISPECL(
                          PairList [
                            (hol: var f :: A -> B; f),
                            (hol: var g :: A -> real; g),
                            (hol: var s :: A -> bool; s)
                          ])(
                          SUM_IMAGE_GEN
                        )
                      )
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_tac \
                  DISCH_THEN(SUBST1_TAC)
                ) then_tac \
                MATCH_MP_TAC(SUM_SUPERSET)
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            REPEAT(STRIP_TAC)
          ) then_tac \
          MATCH_MP_TAC(SUM_EQ_0)
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

