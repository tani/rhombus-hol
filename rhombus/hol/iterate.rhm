def SUPPORT_CLAUSES:
  prove(
    [
      (hol:
         var op :: C -> C -> C
         const support :: (B -> B -> B) -> (A -> B) -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const neutral :: (A -> A -> A) -> A
         const DELETE :: (A -> bool) -> A -> A -> bool
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
         const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const o :: (B -> C) -> (A -> B) -> A -> C
         (forall f :: A -> C: support(op, f, EMPTY) == EMPTY)
           && ((forall (f :: A -> C, x :: A, s :: A -> bool):
                  support(op, f, INSERT(x, s))
                    == (if f(x) == neutral(op) | support(op, f, s) | INSERT(x, support(op, f, s))))
                 && ((forall (f :: A -> C, x :: A, s :: A -> bool):
                        support(op, f, DELETE(s, x)) == DELETE(support(op, f, s), x))
                       && ((forall (f :: A -> C, s :: A -> bool, t :: A -> bool):
                              support(op, f, UNION(s, t)) == UNION(support(op, f, s), support(op, f, t)))
                             && ((forall (f :: A -> C, s :: A -> bool, t :: A -> bool):
                                    support(op, f, INTER(s, t))
                                      == INTER(support(op, f, s), support(op, f, t)))
                                   && ((forall (f :: A -> C, s :: A -> bool, t :: A -> bool):
                                          support(op, f, DIFF(s, t))
                                            == DIFF(support(op, f, s), support(op, f, t)))
                                         && (forall (f :: A -> B, g :: B -> C, s :: A -> bool):
                                               support(op, g, IMAGE(f, s))
                                                 == IMAGE(f, support(op, o(g, f), s))))))))),
      (
        (
          (
            REWRITE_TAC(
              PairList [
                support,
                EXTENSION,
                IN_ELIM_THM,
                IN_INSERT,
                IN_DELETE,
                o_THM,
                IN_IMAGE,
                NOT_IN_EMPTY,
                IN_UNION,
                IN_INTER,
                IN_DIFF,
                COND_RAND
              ]
            ) then_tac \
            REPEAT(STRIP_TAC)
          ) then_tac \
          TRY(COND_CASES_TAC)
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def SUPPORT_DELTA:
  prove(
    [
      (hol:
         const support :: (B -> B -> B) -> (A -> B) -> (A -> bool) -> A -> bool
         const neutral :: (A -> A -> A) -> A
         const IN :: A -> (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         forall (op :: B -> B -> B, s :: A -> bool, f :: A -> B, a :: A):
           support(op, fun (x :: A): if x == a | f(x) | neutral(op), s)
             == (if IN(a, s) | support(op, f, INSERT(a, EMPTY)) | EMPTY)),
