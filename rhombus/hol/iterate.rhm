                      ==> iterate(op, IMAGE(f, s), g) == iterate(op, s, o(g, f)))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (((GEN_TAC then_tac DISCH_TAC) then_tac GEN_TAC) then_tac GEN_TAC) then_tac \
                                ONCE_REWRITE_TAC(PairList [IMP_CONJ])
                              ) then_tac \
                              MATCH_MP_TAC(FINITE_INDUCT_STRONG)
                            ) then_tac \
                            ASM_SIMP_TAC(PairList [IMAGE_CLAUSES, ITERATE_CLAUSES, FINITE_IMAGE])
                          ) then_tac \
                          MAP_EVERY(X_GEN_TAC)(PairList [(hol: var a :: A; a), (hol: var s :: A -> bool; s)])
                        ) then_tac \
                        REWRITE_TAC(PairList [IN_INSERT])
                      ) then_tac \
                      REPEAT(STRIP_TAC)
                    ) then_tac \
                    SUBGOAL_THEN(
                      (hol:
                         var op :: C -> C -> C
                         var s :: A -> bool
                         var g :: B -> C
                         var f :: A -> B
                         const iterate :: (B -> B -> B) -> (A -> bool) -> (A -> B) -> B
                         const o :: (B -> C) -> (A -> B) -> A -> C
                         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                         iterate(op, s, o(g, f)) == iterate(op, IMAGE(f, s), g))
                    )(SUBST1_TAC)
                  ) then_list \
