                       && (forall (l :: int, r :: int):
                             FINITE(
                               GSPEC(
                                 fun (gen_pvar_238 :: int):
                                   exists x :: int: SETSPEC(gen_pvar_238, l < x && x < r, x)
                               )
                             ))))),
      (
        (
          MATCH_MP_TAC(
            TAUT(
              (hol:
                 var a :: bool
                 var b :: bool
