         forall (s :: A -> bool, P :: A -> bool, f :: A -> num, g :: A -> num):
           FINITE(s)
             ==> (nsum(s, fun (x :: A): if P(x) | f(x) | g(x))
                    == (nsum(
                          GSPEC(
