                  ARITH_RULE(
                    (hol:
                       var n :: num
                       const SUC :: num -> num
                       (2 :: num) * SUC(n) == SUC((2 :: num) * n + (1 :: num)))
                  ),
                  ARITH_RULE(
                    (hol:
                       var n :: num
                       const SUC :: num -> num
                       (2 :: num) * SUC(n) + (1 :: num) == SUC(SUC((2 :: num) * n + (1 :: num))))
                  )
                ]
              )
            ) then_tac \
            ASM_MESON_TAC(PairList [monoidal])
          )
        ]
      )
    ]
  )

def ITERATE_REFLECT:
  prove(
    [
      (hol:
         const monoidal :: (A -> A -> A) -> bool
         const iterate :: (B -> B -> B) -> (A -> bool) -> (A -> B) -> B
         const #{..} :: num -> num -> num -> bool
         const neutral :: (A -> A -> A) -> A
         forall op :: A -> A -> A:
           monoidal(op)
             ==> (forall (x :: num -> A, m :: num, n :: num):
                    iterate(op, #{..}(m, n), x)
                      == (if n < m
                          | neutral(op)
                          | iterate(op, #{..}((0 :: num), n - m), fun (i :: num): x(n - i))))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (REWRITE_TAC(PairList [GSYM(NUMSEG_EMPTY)]) then_tac REPEAT(STRIP_TAC)) then_tac \
                            COND_CASES_TAC
                          ) then_list \
                          PairList [
                            ASM_MESON_TAC(PairList [ITERATE_CLAUSES]),
                            RULE_ASSUM_TAC(REWRITE_RULE(PairList [NUMSEG_EMPTY, NOT_LT]))
                          ]
                        ) then_tac \
                        FIRST_ASSUM(
                          o(
                            o(MP_TAC)(
                              ISPECL(
                                PairList [
                                  (hol:
                                     var n :: num
                                     fun (i :: num): n - i),
                                  (hol: var x :: num -> A; x),
                                  (hol:
                                     var n :: num
                                     var m :: num
                                     const #{..} :: num -> num -> num -> bool
                                     #{..}((0 :: num), n - m))
                                ]
                              )
                            )
                          )(
                            MATCH_MP(
                              INST_TYPE(PairList [[(hol_type: X), (hol_type: A)]])(ITERATE_IMAGE)
                            )
                          )
                        )
                      ) then_tac \
                      REWRITE_TAC(PairList [o_DEF, IN_NUMSEG])
                    ) then_tac \
                    ANTS_TAC
                  ) then_list \
                  PairList [ARITH_TAC, DISCH_THEN(o(SUBST1_TAC)(SYM))]
                ) then_tac \
                AP_THM_TAC
              ) then_tac \
              AP_TERM_TAC
            ) then_tac \
            REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, IN_NUMSEG])
          ) then_tac \
          REWRITE_TAC(
            PairList [
              UNWIND_THM2,
              ARITH_RULE(
                (hol:
                   var x :: num
                   var n :: num
                   var y :: num
                   var m :: num
                   x == n - y && ((0 :: num) <= y && y <= n - m) <=> y == n - x && (x <= n && y <= n - m))
              )
            ]
          )
        ) then_tac \
        ASM_ARITH_TAC
      )
    ]
  )

def iterato:
  o(new_specification(PairList ["iterato"]))(prove)(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         const LET :: (A -> B) -> A -> B
         const LET_END :: A -> A
         const DELETE :: (A -> bool) -> A -> A -> bool
         const #{@} :: (A -> bool) -> A
         exists itty :: (A -> bool) -> A -> (A -> A -> A) -> (K -> K -> bool) -> (K -> bool) -> (K -> A) -> A:
           forall (dom :: A -> bool, neut :: A, op :: A -> A -> A, #{<<=} :: K -> K -> bool, k :: K -> bool, f :: K -> A):
             itty(dom, neut, op, #{<<=}, k, f)
               == (if FINITE(
                        GSPEC(
                          fun (gen_pvar_265 :: K):
                            exists i :: K:
                              SETSPEC(
                                gen_pvar_265,
