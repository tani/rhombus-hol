def NSUM_UNIONS_NONZERO:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const nsum :: (A -> bool) -> (A -> num) -> num
         const UNIONS :: ((A -> bool) -> bool) -> A -> bool
         forall (f :: A -> num, s :: (A -> bool) -> bool):
           (FINITE(s)
              && ((forall t :: A -> bool: IN(t, s) ==> FINITE(t))
                    && (forall (t1 :: A -> bool, t2 :: A -> bool, x :: A):
                          IN(t1, s) && (IN(t2, s) && (t1 != t2 && (IN(x, t1) && IN(x, t2))))
                            ==> f(x) == (0 :: num))))
             ==> nsum(UNIONS(s), f) == nsum(s, fun (t :: A -> bool): nsum(t, f))),
      (
