         const ALLPAIRS :: (A -> B -> bool) -> list(A) -> list(B) -> bool
         forall (l :: list(A), m :: list(B), P :: A -> bool, Q :: B -> bool):
           (ALL(P, l)
              && (ALL_2(Q, m)
                    && (forall (p :: A, q :: B): P(p) && Q(q) ==> (R(p, q) <=> R_prime(p, q)))))
             ==> (ALLPAIRS(R, l, m) <=> ALLPAIRS(R_prime, l, m))),
      (
        REWRITE_TAC(PairList [GSYM(ALLPAIRS_MEM), GSYM(ALL_MEM)]) then_tac \
        MESON_TAC(PairList [])
