fun mk_cons(h):
  fun(t):
    try:
      let cons = Fusion.mk_const(["CONS", PairList.cons([Fusion.type_of(h), Fusion.aty], PairList [])])
      Fusion.mk_comb([Fusion.mk_comb([cons, h]), t])
      ~catch exn:
        match exn
        | Failure(_): failwith("mk_cons")
        | exn: Host.hol_raise(exn)

fun mk_list([tms, ty]):
  try:
    let nil = Fusion.mk_const(["NIL", PairList.cons([ty, Fusion.aty], PairList [])])
    if Host.hol_equal(tms)(PairList [])
    | nil
    | let cons = Fusion.mk_const(["CONS", PairList.cons([ty, Fusion.aty], PairList [])])
      itlist(Basics.mk_binop(cons))(tms)(nil)
    ~catch exn:
      match exn
      | Failure(_): failwith("mk_list")
      | exn: Host.hol_raise(exn)

fun mk_flist(tms):
  try:
    mk_list([tms, Fusion.type_of(hd(tms))])
    ~catch exn:
      match exn
      | Failure(_): failwith("mk_flist")
      | exn: Host.hol_raise(exn)

