fun mk_cons(h):
  fun(t):
    try:
      let cons = mk_const(["CONS", PairList [[type_of(h), aty]]])
      mk_comb([mk_comb([cons, h]), t])
      ~catch exn:
        match exn
        | Failure(_): failwith("mk_cons")
        | exn: (throw exn)

fun mk_list([tms, ty]):
  try:
    let nil = mk_const(["NIL", PairList [[ty, aty]]])
    if (tms == (PairList []))
    | nil
    | let cons = mk_const(["CONS", PairList [[ty, aty]]])
      itlist(mk_binop(cons))(tms)(nil)
    ~catch exn:
      match exn
      | Failure(_): failwith("mk_list")
      | exn: (throw exn)

fun mk_flist(tms):
  try:
    mk_list([tms, type_of(hd(tms))])
    ~catch exn:
      match exn
      | Failure(_): failwith("mk_flist")
      | exn: (throw exn)

