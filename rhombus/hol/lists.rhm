            ),
            [Const("NIL", Tyapp("list", [Tvar("A")])), Ref("l")]
          ),
          Ref("l")
        )
      ),
      Forall(
        "h",
        Tvar("A"),
        Forall(
          "t",
          Tyapp("list", [Tvar("A")]),
          Forall(
            "l",
            Tyapp("list", [Tvar("A")]),
            Eq(
              Tyapp("list", [Tvar("A")]),
              App(
                Var(
                  "APPEND",
                  Fun(Tyapp("list", [Tvar("A")]), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))
                ),
                [
                  App(
                    Const("CONS", Fun(Tvar("A"), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))),
                    [Ref("h"), Ref("t")]
                  ),
                  Ref("l")
                ]
              ),
              App(
                Const("CONS", Fun(Tvar("A"), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))),
                [
                  Ref("h"),
                  App(
                    Var(
