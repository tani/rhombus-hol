def LIST_INDUCT_TAC:
  let list_INDUCT:
    prove(
      [
        @hol|{!P:(A)list->bool. P [] /\ (!h t. P t ==> P (CONS h t)) ==> !l. P l}|,
        MATCH_ACCEPT_TAC(IndTypes.list_INDUCT)
      ]
    )
  (
    MATCH_MP_TAC(list_INDUCT) then_tac CONJ_TAC then_list \
    PairList [
      ALL_TAC,
      GEN_TAC then_tac GEN_TAC then_tac DISCH_TAC
    ]
  )

def HD:
  new_recursive_definition(list_RECURSION)(
    @hol|{HD(CONS (h:A) t) = h}|
  )

def TL:
  new_recursive_definition(list_RECURSION)(
    @hol|{TL(CONS (h:A) t) = t}|
  )

def APPEND:
  new_recursive_definition(list_RECURSION)(
    @hol|{(!l:(A)list. APPEND [] l = l) /\
       (!h t l. APPEND (CONS h t) l = CONS h (APPEND t l))}|
  )

def REVERSE:
  new_recursive_definition(list_RECURSION)(
    @hol|{(REVERSE [] = []) /\
       (REVERSE (CONS (x:A) l) = APPEND (REVERSE l) [x])}|
  )

def LENGTH:
  new_recursive_definition(list_RECURSION)(
    @hol|{(LENGTH [] = 0) /\
       (!h:A. !t. LENGTH (CONS h t) = SUC (LENGTH t))}|
  )

def MAP:
  new_recursive_definition(list_RECURSION)(
    @hol|{(!f:A->B. MAP f NIL = NIL) /\
       (!f h t. MAP f (CONS h t) = CONS (f h) (MAP f t))}|
  )

def LAST:
  new_recursive_definition(list_RECURSION)(
    @hol|{LAST (CONS (h:A) t) = if t = [] then h else LAST t}|
  )

def BUTLAST:
  new_recursive_definition(list_RECURSION)(
    @hol|{(BUTLAST [] = []) /\
       (BUTLAST (CONS (h:A) t) = if t = [] then [] else CONS h (BUTLAST t))}|
  )

def REPLICATE:
  new_recursive_definition(num_RECURSION)(
    @hol|{(REPLICATE 0 (x:A) = []) /\
       (REPLICATE (SUC n) x = CONS x (REPLICATE n x))}|
  )

def NULL:
  new_recursive_definition(list_RECURSION)(
    @hol|{(NULL [] = T) /\
       (NULL (CONS (h:A) t) = F)}|
  )

def ALL:
  new_recursive_definition(list_RECURSION)(
    @hol|{(ALL P [] = T) /\
       (ALL P (CONS (h:A) t) <=> P h /\ ALL P t)}|
  )

def EX:
  new_recursive_definition(list_RECURSION)(
    @hol|{(EX P [] = F) /\
       (EX P (CONS (h:A) t) <=> P h \/ EX P t)}|
  )

def ITLIST:
  new_recursive_definition(list_RECURSION)(
    @hol|{(ITLIST (f:A->B->B) [] b = b) /\
       (ITLIST f (CONS h t) b = f h (ITLIST f t b))}|
  )

def MEM:
  new_recursive_definition(list_RECURSION)(
    @hol|{(MEM (x:A) [] <=> F) /\
       (MEM x (CONS h t) <=> (x = h) \/ MEM x t)}|
  )

def ALL2_DEF:
  new_recursive_definition(list_RECURSION)(
    @hol|{(ALL2 (P:A->B->bool) [] l2 <=> (l2 = [])) /\
       (ALL2 P (CONS h1 t1) l2 <=>
            if l2 = [] then F
            else P h1 (HD l2) /\ ALL2 P t1 (TL l2))}|
  )

def ALL2:
  prove(
    [
      @hol|{(ALL2 (P:A->B->bool) [] [] <=> T) /\
         (ALL2 P (CONS h1 t1) [] <=> F) /\
         (ALL2 P [] (CONS h2 t2) <=> F) /\
         (ALL2 P (CONS h1 t1) (CONS h2 t2) <=> P h1 h2 /\ ALL2 P t1 t2)}|,
      REWRITE_TAC(PairList [distinctness("list"), ALL2_DEF, HD, TL])
    ]
  )

def MAP2_DEF:
  new_recursive_definition(list_RECURSION)(
    @hol|{(MAP2 (f:A->B->C) [] l = []) /\
       (MAP2 f (CONS h1 t1) l = CONS (f h1 (HD l)) (MAP2 f t1 (TL l)))}|
  )

def MAP2:
  prove(
    [
      @hol|{(MAP2 (f:A->B->C) [] [] = []) /\
         (MAP2 f (CONS h1 t1) (CONS h2 t2) = CONS (f h1 h2) (MAP2 f t1 t2))}|,
      REWRITE_TAC(PairList [MAP2_DEF, HD, TL])
    ]
  )

def EL:
  new_recursive_definition(num_RECURSION)(
    @hol|{(EL 0 l :A = HD l) /\
       (EL (SUC n) l = EL n (TL l))}|
  )

def FILTER:
  new_recursive_definition(list_RECURSION)(
    @hol|{(FILTER (P:A->bool) [] = []) /\
       (FILTER P (CONS h t) = if P h then CONS h (FILTER P t) else FILTER P t)}|
  )

def ASSOC:
  new_recursive_definition(list_RECURSION)(
    @hol|{ASSOC a (CONS (h:A#B) t) = if FST h = a then SND h else ASSOC a t}|
  )

def ITLIST2_DEF:
  new_recursive_definition(list_RECURSION)(
    @hol|{(ITLIST2 (f:A->B->C->C) [] l2 b = b) /\
       (ITLIST2 f (CONS h1 t1) l2 b = f h1 (HD l2) (ITLIST2 f t1 (TL l2) b))}|
  )

def ITLIST2:
  prove(
    [
      @hol|{(ITLIST2 (f:A->B->C->C) [] [] b = b) /\
         (ITLIST2 f (CONS h1 t1) (CONS h2 t2) b = f h1 h2 (ITLIST2 f t1 t2 b))}|,
      REWRITE_TAC(PairList [ITLIST2_DEF, HD, TL])
    ]
  )

def ZIP_DEF:
  new_recursive_definition(list_RECURSION)(
    @hol|{(ZIP [] l2 :(A#B)list = []) /\
       (ZIP (CONS h1 t1) l2:(A#B)list = CONS (h1,HD l2) (ZIP t1 (TL l2)))}|
  )

def ZIP:
  prove(
    [
      @hol|{(ZIP [] [] :(A#B)list = []) /\
         (ZIP (CONS h1 t1) (CONS h2 t2) :(A#B)list = CONS (h1,h2) (ZIP t1 t2))}|,
      REWRITE_TAC(PairList [ZIP_DEF, HD, TL])
    ]
  )

def ALLPAIRS:
  new_recursive_definition(list_RECURSION)(
    @hol|{(ALLPAIRS (f:A->B->bool) [] l <=> T) /\
       (ALLPAIRS f (CONS h t) l <=> ALL (f h) l /\ ALLPAIRS f t l)}|
  )

def PAIRWISE:
  new_recursive_definition(list_RECURSION)(
    @hol|{(PAIRWISE (r:A->A->bool) [] <=> T) /\
       (PAIRWISE (r:A->A->bool) (CONS h t) <=> ALL (r h) t /\ PAIRWISE r t)}|
  )

def list_of_seq:
  new_recursive_definition(num_RECURSION)(
    @hol|{list_of_seq (s:num->A) 0 = [] /\
       list_of_seq s (SUC n) = APPEND (list_of_seq s n) [s n]}|
  )

def NOT_CONS_NIL:
  prove(
    [
      @hol|{!(h:A) t. ~(CONS h t = [])}|,
      REWRITE_TAC(PairList [distinctness("list")])
    ]
  )

def LAST_CLAUSES:
  prove(
    [
      @hol|{(LAST [h:A] = h) /\
         (LAST (CONS h (CONS k t)) = LAST (CONS k t))}|,
      REWRITE_TAC(PairList [LAST, NOT_CONS_NIL])
    ]
  )

def APPEND_NIL:
  prove(
    [
      @hol|{!l:A list. APPEND l [] = l}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [APPEND])
    ]
  )

def APPEND_ASSOC:
  prove(
    [
      @hol|{!(l:A list) m n. APPEND l (APPEND m n) = APPEND (APPEND l m) n}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [APPEND])
    ]
  )

def REVERSE_APPEND:
  prove(
    [
      @hol|{!(l:A list) m. REVERSE (APPEND l m) = APPEND (REVERSE m) (REVERSE l)}|,
      LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [APPEND, REVERSE, APPEND_NIL, APPEND_ASSOC])
    ]
  )

def REVERSE_REVERSE:
  prove(
    [
      @hol|{!l:A list. REVERSE(REVERSE l) = l}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [REVERSE, REVERSE_APPEND, APPEND])
    ]
  )

def REVERSE_EQ_EMPTY:
  prove(
    [
      @hol|{!l:A list. REVERSE l = [] <=> l = []}|,
      MESON_TAC(PairList [REVERSE_REVERSE, REVERSE])
    ]
  )

def CONS_11:
  prove(
    [
      @hol|{!(h1:A) h2 t1 t2. (CONS h1 t1 = CONS h2 t2) <=> (h1 = h2) /\ (t1 = t2)}|,
      REWRITE_TAC(PairList [injectivity("list")])
    ]
  )

def list_CASES:
  prove(
    [
      @hol|{!l:(A)list. (l = []) \/ ?h t. l = CONS h t}|,
      LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [CONS_11, NOT_CONS_NIL]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def LIST_EQ:
  prove(
    [
      @hol|{!l1 l2:A list.
         l1 = l2 <=>
         LENGTH l1 = LENGTH l2 /\ !n. n < LENGTH l2 ==> EL n l1 = EL n l2}|,
      REPEAT(LIST_INDUCT_TAC) then_tac \
      REWRITE_TAC(PairList [NOT_CONS_NIL, CONS_11, LENGTH, CONJUNCT1(LT), NOT_SUC]) then_tac \
      ASM_REWRITE_TAC(PairList [SUC_INJ]) then_tac \
      GEN_REWRITE_TAC(o(RAND_CONV)(RAND_CONV))(
        PairList [
          MESON(
            PairList [num_CASES])(
            @hol|{(!n. P n) <=> P 0 /\ (!n. P(SUC n))}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [EL, HD, TL, LT_0, LT_SUC, CONJ_ACI])
    ]
  )

def LENGTH_APPEND:
  prove(
    [
      @hol|{!(l:A list) m. LENGTH(APPEND l m) = LENGTH l + LENGTH m}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [APPEND, LENGTH, ADD_CLAUSES])
    ]
  )

def MAP_APPEND:
  prove(
    [
      @hol|{!f:A->B. !l1 l2. MAP f (APPEND l1 l2) = APPEND (MAP f l1) (MAP f l2)}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MAP, APPEND])
    ]
  )

def LENGTH_MAP:
  prove(
    [
      @hol|{!l. !f:A->B. LENGTH (MAP f l) = LENGTH l}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MAP, LENGTH])
    ]
  )

def LENGTH_EQ_NIL:
  prove(
    [
      @hol|{!l:A list. (LENGTH l = 0) <=> (l = [])}|,
      LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [LENGTH, NOT_CONS_NIL, NOT_SUC])
    ]
  )

def LENGTH_EQ_CONS:
  prove(
    [
      @hol|{!(l:A list) n. LENGTH l = SUC n <=> ?h t. (l = CONS h t) /\ (LENGTH t = n)}|,
      LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [LENGTH, NOT_SUC, NOT_CONS_NIL]) then_tac \
      ASM_REWRITE_TAC(PairList [SUC_INJ, CONS_11]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def LENGTH_REVERSE:
  prove(
    [
      @hol|{!l:A list. LENGTH(REVERSE l) = LENGTH l}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [REVERSE, LENGTH_APPEND, LENGTH]) then_tac \
      REWRITE_TAC(PairList [ADD_CLAUSES, MULT_CLAUSES])
    ]
  )

def MAP_o:
  prove(
    [
      @hol|{!f:A->B. !g:B->C. !l. MAP (g o f) l = MAP g (MAP f l)}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [MAP, o_THM])
    ]
  )

def MAP_EQ:
  prove(
    [
      @hol|{!(f:A->B) g l. ALL (\x. f x = g x) l ==> (MAP f l = MAP g l)}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [MAP, ALL]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ALL_IMP:
  prove(
    [
      @hol|{!P Q l:A list. (!x. MEM x l /\ P x ==> Q x) /\ ALL P l ==> ALL Q l}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [MEM, ALL]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def NOT_EX:
  prove(
    [
      @hol|{!P l:A list. ~(EX P l) <=> ALL (\x. ~(P x)) l}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [EX, ALL, DE_MORGAN_THM])
    ]
  )

def NOT_ALL:
  prove(
    [
      @hol|{!P l:A list. ~(ALL P l) <=> EX (\x. ~(P x)) l}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [EX, ALL, DE_MORGAN_THM])
    ]
  )

def ALL_MAP:
  prove(
    [
      @hol|{!P (f:A->B) l. ALL P (MAP f l) <=> ALL (P o f) l}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ALL, MAP, o_THM])
    ]
  )

def ALL_EQ:
  prove(
    [
      @hol|{!l:A list.
         ALL R l /\ (!x. R x ==> (P x <=> Q x)) ==> (ALL P l <=> ALL Q l)}|,
      LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [ALL]) then_tac STRIP_TAC then_tac \
      BINOP_TAC then_tac \
      FIRST_ASSUM(MATCH_MP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def ALL_T:
  prove(
    [
      @hol|{!l:A list. ALL (\x. T) l}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ALL])
    ]
  )

def MAP_EQ_ALL2:
  prove(
    [
      @hol|{!(f:A->B) l m. ALL2 (\x y. f x = f y) l m ==> MAP f l = MAP f m}|,
      GEN_TAC then_tac REPEAT(LIST_INDUCT_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [MAP, ALL2, CONS_11]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ALL2_MAP:
  prove(
    [
      @hol|{!P (f:A->B) l. ALL2 P (MAP f l) l <=> ALL (\a. P (f a) a) l}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ALL2, MAP, ALL])
    ]
  )

def MAP_EQ_DEGEN:
  prove(
    [
      @hol|{!l (f:A->A). ALL (\x. f(x) = x) l ==> (MAP f l = l)}|,
      LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [ALL, MAP, CONS_11]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      FIRST_ASSUM(MATCH_MP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def ALL2_AND_RIGHT:
  prove(
    [
      @hol|{!l m P Q. ALL2 (\(x:A) (y:B). P x /\ Q x y) l m <=> ALL P l /\ ALL2 Q l m}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ALL, ALL2]) then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ALL, ALL2]) then_tac \
      REWRITE_TAC(PairList [CONJ_ACI])
    ]
  )

def ITLIST_APPEND:
  prove(
    [
      @hol|{!(f:A->B->B) a l1 l2.
         ITLIST f (APPEND l1 l2) a = ITLIST f l1 (ITLIST f l2 a)}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ITLIST, APPEND])
    ]
  )

def ITLIST_EXTRA:
  prove(
    [
      @hol|{!(f:A->B->B) l. ITLIST f (APPEND l [a]) b = ITLIST f l (f a b)}|,
      REWRITE_TAC(PairList [ITLIST_APPEND, ITLIST])
    ]
  )

def ALL_MP:
  prove(
    [
      @hol|{!P Q (l:A list). ALL (\x. P x ==> Q x) l /\ ALL P l ==> ALL Q l}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [ALL]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def AND_ALL:
  prove(
    [
      @hol|{!l:A list. ALL P l /\ ALL Q l <=> ALL (\x. P x /\ Q x) l}|,
      CONV_TAC(ONCE_DEPTH_CONV(SYM_CONV)) then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ALL, CONJ_ACI])
    ]
  )

def EX_IMP:
  prove(
    [
      @hol|{!P Q (l:A list). (!x. MEM x l /\ P x ==> Q x) /\ EX P l ==> EX Q l}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [MEM, EX]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ALL_MEM:
  prove(
    [
      @hol|{!P (l:A list). (!x. MEM x l ==> P x) <=> ALL P l}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [ALL, MEM]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def LENGTH_REPLICATE:
  prove(
    [
      @hol|{!n x:A. LENGTH(REPLICATE n x) = n}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [LENGTH, REPLICATE])
    ]
  )

def MEM_REPLICATE:
  prove(
    [
      @hol|{!n x y:A. MEM x (REPLICATE n y) <=> x = y /\ ~(n = 0)}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MEM, REPLICATE, NOT_SUC]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def EX_MAP:
  prove(
    [
      @hol|{!P (f:A->B) l. EX P (MAP f l) <=> EX (P o f) l}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [MAP, EX, o_THM])
    ]
  )

def EXISTS_EX:
  prove(
    [
      @hol|{!(P:A->B->bool) l. (?x. EX (P x) l) <=> EX (\s. ?x. P x s) l}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EX]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def FORALL_ALL:
  prove(
    [
      @hol|{!(P:A->B->bool) l. (!x. ALL (P x) l) <=> ALL (\s. !x. P x s) l}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ALL]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def MEM_APPEND:
  prove(
    [
      @hol|{!(x:A) l1 l2. MEM x (APPEND l1 l2) <=> MEM x l1 \/ MEM x l2}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [MEM, APPEND, DISJ_ACI])
    ]
  )

def MEM_MAP:
  prove(
    [
      @hol|{!(f:A->B) y l. MEM y (MAP f l) <=> ?x. MEM x l /\ (y = f x)}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [MEM, MAP]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def FILTER_APPEND:
  prove(
    [
      @hol|{!(P:A->bool) l1 l2.
         FILTER P (APPEND l1 l2) = APPEND (FILTER P l1) (FILTER P l2)}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [FILTER, APPEND]) then_tac \
      GEN_TAC then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [APPEND])
    ]
  )

def FILTER_MAP:
  prove(
    [
      @hol|{!P (f:A->B) l. FILTER P (MAP f l) = MAP f (FILTER (P o f) l)}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [MAP, FILTER, o_THM]) then_tac \
      COND_CASES_TAC then_tac \
      REWRITE_TAC(PairList [MAP])
    ]
  )

def MEM_FILTER:
  prove(
    [
      @hol|{!P l (x:A). MEM x (FILTER P l) <=> P x /\ MEM x l}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MEM, FILTER]) then_tac \
      GEN_TAC then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [MEM]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def LENGTH_FILTER:
  prove(
    [
      @hol|{!P l:A list. LENGTH(FILTER P l) <= LENGTH l}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [FILTER, LE_REFL]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [LENGTH, LE_SUC]) then_tac \
      ASM_MESON_TAC(PairList [LE_TRANS, LE])
    ]
  )

def EX_MEM:
  prove(
    [
      @hol|{!P (l:A list). (?x. P x /\ MEM x l) <=> EX P l}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [EX, MEM]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def MAP_FST_ZIP:
  prove(
    [
      @hol|{!(l1:A list) (l2:B list).
         LENGTH l1 = LENGTH l2 ==> MAP FST (ZIP l1 l2) = l1}|,
      LIST_INDUCT_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [LENGTH, SUC_INJ, MAP, FST, ZIP, NOT_SUC])
    ]
  )

def MAP_SND_ZIP:
  prove(
    [
      @hol|{!(l1:A list) (l2:B list).
         LENGTH l1 = LENGTH l2 ==> MAP SND (ZIP l1 l2) = l2}|,
      LIST_INDUCT_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [LENGTH, SUC_INJ, MAP, FST, ZIP, NOT_SUC])
    ]
  )

def LENGTH_ZIP:
  prove(
    [
      @hol|{!(l1:A list) (l2:B list).
         LENGTH l1 = LENGTH l2 ==> LENGTH(ZIP l1 l2) = LENGTH l2}|,
      REPEAT(LIST_INDUCT_TAC or_tac GEN_TAC) then_tac \
      ASM_SIMP_TAC(PairList [LENGTH, NOT_SUC, ZIP, SUC_INJ])
    ]
  )

def MEM_ASSOC:
  prove(
    [
      @hol|{!(l:(A#B)list) x. MEM (x,ASSOC x l) l <=> MEM x (MAP FST l)}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MEM, MAP, ASSOC]) then_tac \
      GEN_TAC then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [PAIR, FST])
    ]
  )

def ALL_APPEND:
  prove(
    [
      @hol|{!P l1 l2:A list. ALL P (APPEND l1 l2) <=> ALL P l1 /\ ALL P l2}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ALL, APPEND, GSYM(CONJ_ASSOC)])
    ]
  )

def MEM_EL:
  prove(
    [
      @hol|{!(l:A list) n. n < LENGTH l ==> MEM (EL n l) l}|,
      LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [MEM, CONJUNCT1(LT), LENGTH]) then_tac \
      INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [EL, HD, LT_SUC, TL])
    ]
  )

def MEM_EXISTS_EL:
  prove(
    [
      @hol|{!(l:A list) x. MEM x l <=> ?i. i < LENGTH l /\ x = EL i l}|,
      LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [LENGTH, EL, MEM, CONJUNCT1(LT)]) then_tac \
      GEN_TAC then_tac \
      GEN_REWRITE_TAC(RAND_CONV)(
        PairList [
          MESON(
            PairList [num_CASES])(
            @hol|{(?i. P i) <=> P 0 \/ (?i. P(SUC i))}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [LT_SUC, LT_0, EL, HD, TL])
    ]
  )

def ALL_EL:
  prove(
    [
      @hol|{!P (l:A list). (!i. i < LENGTH l ==> P (EL i l)) <=> ALL P l}|,
      REWRITE_TAC(PairList [GSYM(ALL_MEM), MEM_EXISTS_EL]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def ALL2_MAP2:
  prove(
    [
      @hol|{!(f:A->B) (g:C->D) l m.
         ALL2 P (MAP f l) (MAP g m) = ALL2 (\x y. P (f x) (g y)) l m}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ALL2, MAP])
    ]
  )

def AND_ALL2:
  prove(
    [
      @hol|{!(P:A->B->bool) Q l m.
         ALL2 P l m /\ ALL2 Q l m <=> ALL2 (\x y. P x y /\ Q x y) l m}|,
      GEN_TAC then_tac GEN_TAC then_tac \
      CONV_TAC(ONCE_DEPTH_CONV(SYM_CONV)) then_tac \
      LIST_INDUCT_TAC then_tac \
      LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ALL2]) then_tac \
      REWRITE_TAC(PairList [CONJ_ACI])
    ]
  )

def ALLPAIRS_SYM:
  prove(
    [
      @hol|{!(P:A->B->bool) l m. ALLPAIRS P l m <=> ALLPAIRS (\x y. P y x) m l}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [ALLPAIRS]) then_tac \
      LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ALLPAIRS, ALL]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ALLPAIRS_MEM:
  prove(
    [
      @hol|{!(P:A->B->bool) l m.
         (!x y. MEM x l /\ MEM y m ==> P x y) <=> ALLPAIRS P l m}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [ALLPAIRS, GSYM(ALL_MEM), MEM]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def ALLPAIRS_MAP:
  prove(
    [
      @hol|{!P (f:A->B) (g:C->D) l m.
         ALLPAIRS P (MAP f l) (MAP g m) <=>
         ALLPAIRS (\x y. P (f x) (g y)) l m}|,
      REWRITE_TAC(PairList [GSYM(ALLPAIRS_MEM), MEM_MAP]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def ALLPAIRS_EQ:
  prove(
    [
      @hol|{!l m. !P Q. ALL P (l:A list) /\ ALL Q (m:B list) /\
         (!p q. P p /\ Q q ==> (R p q <=> R' p q))
         ==> (ALLPAIRS R l m <=> ALLPAIRS R' l m)}|,
      REWRITE_TAC(PairList [GSYM(ALLPAIRS_MEM), GSYM(ALL_MEM)]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def ALL2_ALL:
  prove(
    [
      @hol|{!P (l:A list). ALL2 P l l <=> ALL (\x. P x x) l}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ALL2, ALL])
    ]
  )

def APPEND_EQ_NIL:
  prove(
    [
      @hol|{!l m:A list. (APPEND l m = []) <=> (l = []) /\ (m = [])}|,
      REWRITE_TAC(PairList [GSYM(LENGTH_EQ_NIL), LENGTH_APPEND, ADD_EQ_0])
    ]
  )

def APPEND_LCANCEL:
  prove(
    [
      @hol|{!l1 l2 l3:A list. APPEND l1 l2 = APPEND l1 l3 <=> l2 = l3}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [APPEND, CONS_11])
    ]
  )

def APPEND_RCANCEL:
  prove(
    [
      @hol|{!l1 l2 l3:A list. APPEND l1 l3 = APPEND l2 l3 <=> l1 = l2}|,
      ONCE_REWRITE_TAC(
        PairList [
          MESON(
            PairList [REVERSE_REVERSE])(
            @hol|{l = l' <=> REVERSE l = REVERSE l'}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REVERSE_APPEND, APPEND_LCANCEL])
    ]
  )

def LENGTH_MAP2:
  prove(
    [
      @hol|{!(f:A->B->C) l m. LENGTH l = LENGTH m ==> LENGTH(MAP2 f l m) = LENGTH m}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [LENGTH, NOT_CONS_NIL, NOT_SUC, MAP2, SUC_INJ])
    ]
  )

def EL_MAP2:
  prove(
    [
      @hol|{!(f:A->B->C) l m k.
         k < LENGTH l /\ k < LENGTH m
         ==> EL k (MAP2 f l m) = f (EL k l) (EL k m)}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [LENGTH, CONJUNCT1(LT)]) then_tac \
      INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [LENGTH, MAP2, EL, HD, TL, LT_SUC])
    ]
  )

def MAP_EQ_NIL:
  prove(
    [
      @hol|{!(f:A->B) l. MAP f l = [] <=> l = []}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [MAP, NOT_CONS_NIL])
    ]
  )

def INJECTIVE_MAP:
  prove(
    [
      @hol|{!f:A->B. (!l m. MAP f l = MAP f m ==> l = m) <=>
         (!x y. f x = f y ==> x = y)}|,
      GEN_TAC then_tac EQ_TAC then_tac DISCH_TAC then_list \
      PairList [
        MAP_EVERY(X_GEN_TAC)(PairList [@hol|{x:A}|, @hol|{y:A}|]) then_tac \
        DISCH_TAC then_tac \
        FIRST_X_ASSUM(
          o(MP_TAC)(
            SPECL(
              PairList [
                @hol|{[x:A]}|,
                @hol|{[y:A]}|
              ]
            )
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList [MAP, CONS_11]),
        REPEAT(LIST_INDUCT_TAC) then_tac \
        ASM_SIMP_TAC(PairList [MAP, NOT_CONS_NIL, CONS_11]) then_tac \
        ASM_MESON_TAC(PairList [])
      ]
    ]
  )

def SURJECTIVE_MAP:
  prove(
    [
      @hol|{!f:A->B. (!m. ?l. MAP f l = m) <=> (!y. ?x. f x = y)}|,
      GEN_TAC then_tac EQ_TAC then_tac DISCH_TAC then_list \
      PairList [
        X_GEN_TAC(@hol|{y:B}|) then_tac \
        FIRST_X_ASSUM(
          o(MP_TAC)(
            SPEC(
              @hol|{[y:B]}|
            )
          )
        ) then_tac \
        REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac \
        LIST_INDUCT_TAC then_tac \
        REWRITE_TAC(PairList [MAP, CONS_11, NOT_CONS_NIL, MAP_EQ_NIL]),
        MATCH_MP_TAC(IndTypes.list_INDUCT)
      ] then_tac \
      ASM_MESON_TAC(PairList [MAP])
    ]
  )

def MAP_ID:
  prove(
    [
      @hol|{!l. MAP (\x:A. x) l = l}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MAP])
    ]
  )

def MAP_I:
  prove(
    [
      @hol|{MAP (I:A->A) = I}|,
      REWRITE_TAC(PairList [FUN_EQ_THM, I_DEF, MAP_ID])
    ]
  )

def BUTLAST_CLAUSES:
  prove(
    [
      @hol|{BUTLAST([]:A list) = [] /\
         (!a:A. BUTLAST [a] = []) /\
         (!(a:A) h t. BUTLAST(CONS a (CONS h t)) = CONS a (BUTLAST(CONS h t)))}|,
      REWRITE_TAC(PairList [BUTLAST, NOT_CONS_NIL])
    ]
  )

def BUTLAST_APPEND:
  prove(
    [
      @hol|{!l m:A list. BUTLAST(APPEND l m) =
         if m = [] then BUTLAST l else APPEND l (BUTLAST m)}|,
      SIMP_TAC(
        PairList [
          COND_RAND,
          APPEND_NIL,
          MESON(
            PairList [])(
            @hol|{(if p then T else q) <=> ~p ==> q}|
          )
        ]
      ) then_tac \
      LIST_INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [APPEND, BUTLAST, APPEND_EQ_NIL])
    ]
  )

def APPEND_BUTLAST_LAST:
  prove(
    [
      @hol|{!l:A list. ~(l = []) ==> APPEND (BUTLAST l) [LAST l] = l}|,
      LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [LAST, BUTLAST, NOT_CONS_NIL]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList [APPEND])
    ]
  )

def LAST_APPEND:
  prove(
    [
      @hol|{!p q:A list. LAST(APPEND p q) = if q = [] then LAST p else LAST q}|,
      LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [APPEND, LAST, APPEND_EQ_NIL]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def LENGTH_TL:
  prove(
    [
      @hol|{!l:A list. ~(l = []) ==> LENGTH(TL l) = LENGTH l - 1}|,
      LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [LENGTH, TL, ARITH, SUC_SUB1])
    ]
  )

def LAST_REVERSE:
  prove(
    [
      @hol|{!l:A list. ~(l = []) ==> LAST(REVERSE l) = HD l}|,
      LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [HD, REVERSE, LAST, LAST_APPEND, NOT_CONS_NIL])
    ]
  )

def HD_REVERSE:
  prove(
    [
      @hol|{!l:A list. ~(l = []) ==> HD(REVERSE l) = LAST l}|,
      MESON_TAC(PairList [LAST_REVERSE, REVERSE_REVERSE, REVERSE_EQ_EMPTY])
    ]
  )

def EL_APPEND:
  prove(
    [
      @hol|{!k l m:A list.
         EL k (APPEND l m) = if k < LENGTH l then EL k l
                             else EL (k - LENGTH l) m}|,
      INDUCT_TAC then_tac REWRITE_TAC(PairList [EL]) then_tac LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [HD, APPEND, LENGTH, SUB_0, EL, LT_0, CONJUNCT1(LT)]) then_tac \
      ASM_REWRITE_TAC(PairList [TL, LT_SUC, SUB_SUC])
    ]
  )

def EL_TL:
  prove(
    [
      @hol|{!n. EL n (TL l):A = EL (n + 1) l}|,
      REWRITE_TAC(PairList [GSYM(ADD1), EL])
    ]
  )

def EL_CONS:
  prove(
    [
      @hol|{!n (h:A) t. EL n (CONS h t) = if n = 0 then h else EL (n - 1) t}|,
      INDUCT_TAC then_tac REWRITE_TAC(PairList [EL, HD, TL, NOT_SUC, SUC_SUB1])
    ]
  )

def LAST_EL:
  prove(
    [
      @hol|{!l:A list. ~(l = []) ==> LAST l = EL (LENGTH l - 1) l}|,
      LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [LAST, LENGTH, SUC_SUB1]) then_tac \
      DISCH_TAC then_tac \
      COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList [LENGTH, EL, HD, EL_CONS, LENGTH_EQ_NIL])
    ]
  )

def HD_APPEND:
  prove(
    [
      @hol|{!l m:A list. HD(APPEND l m) = if l = [] then HD m else HD l}|,
      LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [HD, APPEND, NOT_CONS_NIL])
    ]
  )

def CONS_HD_TL:
  prove(
    [
      @hol|{!l:A list. ~(l = []) ==> l = CONS (HD l) (TL l)}|,
      LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [NOT_CONS_NIL, HD, TL])
    ]
  )

def EL_MAP:
  prove(
    [
      @hol|{!(f:A->B) n l. n < LENGTH l ==> EL n (MAP f l) = f(EL n l)}|,
      GEN_TAC then_tac INDUCT_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [LENGTH, CONJUNCT1(LT), LT_0, EL, HD, TL, MAP, LT_SUC])
    ]
  )

def MAP_REVERSE:
  prove(
    [
      @hol|{!(f:A->B) l. REVERSE(MAP f l) = MAP f (REVERSE l)}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [MAP, REVERSE, MAP_APPEND])
    ]
  )

def ALL_FILTER:
  prove(
    [
      @hol|{!P Q l:A list. ALL P (FILTER Q l) <=> ALL (\x. Q x ==> P x) l}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [ALL, FILTER]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ALL])
    ]
  )

def APPEND_SING:
  prove(
    [
      @hol|{!(h:A) t. APPEND [h] t = CONS h t}|,
      REWRITE_TAC(PairList [APPEND])
    ]
  )

def MEM_APPEND_DECOMPOSE_LEFT:
  prove(
    [
      @hol|{!x:A l. MEM x l <=> ?l1 l2. ~(MEM x l1) /\ l = APPEND l1 (CONS x l2)}|,
      REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{(p <=> q) <=> (p ==> q) /\ (q ==> p)}|
          )
        ]
      ) then_tac \
      SIMP_TAC(PairList [LEFT_IMP_EXISTS_THM, MEM_APPEND, MEM]) then_tac \
      X_GEN_TAC(@hol|{x:A}|) then_tac \
      MATCH_MP_TAC(IndTypes.list_INDUCT) then_tac \
      REWRITE_TAC(PairList [MEM]) then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{y:A}|,
          @hol|{l:A list}|
        ]
      ) then_tac \
      ASM_CASES_TAC(@hol|{x:A = y}|) then_tac \
      ASM_MESON_TAC(PairList [MEM, APPEND])
    ]
  )

def MEM_APPEND_DECOMPOSE:
  prove(
    [
      @hol|{!x:A l. MEM x l <=> ?l1 l2. l = APPEND l1 (CONS x l2)}|,
      REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{(p <=> q) <=> (p ==> q) /\ (q ==> p)}|
          )
        ]
      ) then_tac \
      SIMP_TAC(PairList [LEFT_IMP_EXISTS_THM, MEM_APPEND, MEM]) then_tac \
      ONCE_REWRITE_TAC(PairList [MEM_APPEND_DECOMPOSE_LEFT]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def PAIRWISE_APPEND:
  prove(
    [
      @hol|{!R:A->A->bool l m.
         PAIRWISE R (APPEND l m) <=>
         PAIRWISE R l /\ PAIRWISE R m /\ (!x y. MEM x l /\ MEM y m ==> R x y)}|,
      GEN_TAC then_tac MATCH_MP_TAC(IndTypes.list_INDUCT) then_tac \
      REWRITE_TAC(PairList [APPEND, PAIRWISE, MEM, ALL_APPEND, GSYM(ALL_MEM)]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def PAIRWISE_MAP:
  prove(
    [
      @hol|{!R f:A->B l.
         PAIRWISE R (MAP f l) <=> PAIRWISE (\x y. R (f x) (f y)) l}|,
      GEN_TAC then_tac GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [PAIRWISE, MAP, ALL_MAP, o_DEF])
    ]
  )

def PAIRWISE_IMPLIES:
  prove(
    [
      @hol|{!R:A->A->bool R' l.
         PAIRWISE R l /\ (!x y. MEM x l /\ MEM y l /\ R x y ==> R' x y)
         ==> PAIRWISE R' l}|,
      GEN_TAC then_tac GEN_TAC then_tac MATCH_MP_TAC(IndTypes.list_INDUCT) then_tac \
      REWRITE_TAC(PairList [PAIRWISE, GSYM(ALL_MEM), MEM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def PAIRWISE_TRANSITIVE:
  prove(
    [
      @hol|{!R x y:A l.
         (!x y z. R x y /\ R y z ==> R x z)
         ==> (PAIRWISE R (CONS x (CONS y l)) <=> R x y /\ PAIRWISE R (CONS y l))}|,
      REPEAT(STRIP_TAC) then_tac \
      REWRITE_TAC(
        PairList [
          PAIRWISE,
          ALL,
          GSYM(CONJ_ASSOC),
          TAUT(
            @hol|{(p /\ q /\ r /\ s <=> p /\ r /\ s) <=>
               p /\ s ==> r ==> q}|
          )
        ]
      ) then_tac \
      STRIP_TAC then_tac \
      MATCH_MP_TAC(REWRITE_RULE(PairList [IMP_CONJ])(ALL_IMP)) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def LENGTH_LIST_OF_SEQ:
  prove(
    [
      @hol|{!s:num->A n. LENGTH(list_of_seq s n) = n}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [list_of_seq, LENGTH, LENGTH_APPEND, ADD_CLAUSES])
    ]
  )

def EL_LIST_OF_SEQ:
  prove(
    [
      @hol|{!s:num->A m n. m < n ==> EL m (list_of_seq s n) = s m}|,
      GEN_TAC then_tac ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [list_of_seq, LT, EL_APPEND, LENGTH_LIST_OF_SEQ]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      ASM_SIMP_TAC(PairList [SUB_REFL, EL, HD, LT_REFL])
    ]
  )

def LIST_OF_SEQ_EQ_NIL:
  prove(
    [
      @hol|{!s:num->A n. list_of_seq s n = [] <=> n = 0}|,
      REWRITE_TAC(PairList [GSYM(LENGTH_EQ_NIL), LENGTH_LIST_OF_SEQ, LENGTH])
    ]
  )

def LIST_OF_SEQ_EQ_SELF:
  prove(
    [
      @hol|{!l:A list. list_of_seq (\i. EL i l) (LENGTH l) = l}|,
      SIMP_TAC(PairList [LIST_EQ, LENGTH_LIST_OF_SEQ, EL_LIST_OF_SEQ])
    ]
  )

def LENGTH_EQ_LIST_OF_SEQ:
  prove(
    [
      @hol|{!(l:A list) n. LENGTH l = n <=> l = list_of_seq (\i. EL i l) n}|,
      MESON_TAC(PairList [LIST_OF_SEQ_EQ_SELF, LENGTH_LIST_OF_SEQ])
    ]
  )

def MAP_LIST_OF_SEQ:
  prove(
    [
      @hol|{!f (g:A->B) n. MAP g (list_of_seq f n) = list_of_seq (g o f) n}|,
      GEN_TAC then_tac GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [MAP, list_of_seq, MAP_APPEND, o_THM])
    ]
  )

def LIST_OF_SEQ:
  prove(
    [
      @hol|{(!(f:num->A). list_of_seq f 0 = []) /\
         (!(f:num->A) n.
              list_of_seq f (SUC n) = CONS (f 0) (list_of_seq (f o SUC) n))}|,
      REWRITE_TAC(PairList [CONJUNCT1(list_of_seq)]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [LIST_EQ, LENGTH_LIST_OF_SEQ, LENGTH, EL_CONS]) then_tac \
      INDUCT_TAC then_tac \
      ASM_SIMP_TAC(PairList [NOT_SUC, EL_LIST_OF_SEQ]) then_tac \
      ASM_SIMP_TAC(PairList [LT_SUC, SUC_SUB1, EL_LIST_OF_SEQ, o_THM])
    ]
  )

fun mk_cons(h):
  fun(t):
    try:
      let cons = mk_const(["CONS", PairList [[type_of(h), aty]]])
      mk_comb([mk_comb([cons, h]), t])
      ~catch exn:
        match exn
        | Failure(_): failwith("mk_cons")
        | exn: (throw exn)

fun mk_list([tms, ty]):
  try:
    let nil = mk_const(["NIL", PairList [[ty, aty]]])
    if (tms == (PairList []))
    | nil
    | let cons = mk_const(["CONS", PairList [[ty, aty]]])
      itlist(mk_binop(cons))(tms)(nil)
    ~catch exn:
      match exn
      | Failure(_): failwith("mk_list")
      | exn: (throw exn)

fun mk_flist(tms):
  try:
    mk_list([tms, type_of(hd(tms))])
    ~catch exn:
      match exn
      | Failure(_): failwith("mk_flist")
      | exn: (throw exn)

def MONO_ALL:
  prove(
    [
      @hol|{(!x:A. P x ==> Q x) ==> ALL P l ==> ALL Q l}|,
      DISCH_TAC then_tac \
      SPEC_TAC(
        [
          @hol|{l:A list}|,
          @hol|{l:A list}|
        ]
      ) then_tac \
      LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ALL]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def MONO_ALL2:
  prove(
    [
      @hol|{(!x y. (P:A->B->bool) x y ==> Q x y) ==> ALL2 P l l' ==> ALL2 Q l l'}|,
      DISCH_TAC then_tac \
      SPEC_TAC(
        [
          @hol|{l':B list}|,
          @hol|{l':B list}|
        ]
      ) then_tac \
      SPEC_TAC(
        [
          @hol|{l:A list}|,
          @hol|{l:A list}|
        ]
      ) then_tac \
      LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [ALL2_DEF]) then_tac \
      GEN_TAC then_tac \
      COND_CASES_TAC then_tac \
      REWRITE_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

monotonicity_theorems.value := append(PairList [MONO_ALL, MONO_ALL2])(monotonicity_theorems.value)

fun LIST_CONV(conv):
  fun(tm):
    if is_cons(tm)
    | COMB2_CONV(RAND_CONV(conv))(LIST_CONV(conv))(tm)
    | (if (fst(dest_const(tm)) == "NIL") | REFL(tm) | failwith("LIST_CONV"))

def LENGTH_CONV:
  let pthc:
    prove(
      [
        @hol|{LENGTH(t:A list) = LENGTH t + 0 /\
           LENGTH([]:A list) + n = n /\
           LENGTH(CONS (h:A) t) + n = LENGTH t + SUC n}|,
        REWRITE_TAC(PairList [LENGTH, ADD_CLAUSES])
      ]
    )
  let pths = CONJUNCTS(pthc)
  let avars = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Const("LENGTH",_),ltm):
        if is_list(ltm)
        | let tyin = PairList [[hd(snd(dest_type(type_of(ltm)))), aty]]
          let PairList [h_tm, & PairList [n_tm, & PairList [t_tm, & PairList []]]] = map(inst(tyin))(avars)
          let PairList [pth_init, & PairList [pth_base, & PairList [pth_step, & PairList []]]] = map(INST_TYPE(tyin))(pths)
          fun conv(th):
            let [altm, ntm] = dest_comb(rand(concl(th)))
            let ltm = rand(rand(altm))
            if is_cons(ltm)
            | let [htm, ttm] = dest_cons(ltm)
              let th1 = INST(PairList [[htm, h_tm], [ttm, t_tm], [ntm, n_tm]])(pth_step)
              let [ftm, stm] = dest_comb(rand(concl(th1)))
              let th2 = TRANS(th1)(AP_TERM(ftm)(NUM_SUC_CONV(stm)))
              conv(TRANS(th)(th2))
            | TRANS(th)(INST(PairList [[ntm, n_tm]])(pth_base))
          try:
            conv(INST(PairList [[rand(tm), t_tm]])(pth_init))
            ~catch exn:
              match exn
              | Failure(_): failwith("LENGTH_CONV")
              | exn: (throw exn)
        | match tm
          | _: failwith("LENGTH_CONV")
    | _: failwith("LENGTH_CONV")

def EL_CONV:
  let pthc:
    prove(
      [
        @hol|{EL 0 (CONS (h:A) t) = h /\
           (n = SUC m ==> EL n (CONS h t) = EL m t)}|,
        SIMP_TAC(PairList [EL, HD, TL])
      ]
    )
  let pths = map(UNDISCH_ALL)(CONJUNCTS(pthc))
  let avars = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Comb(Const("EL",_),ntm),ltm):
        if is_list(ltm)
        | let tyin = PairList [[hd(snd(dest_type(type_of(ltm)))), aty]]
          let PairList [h_tm, & PairList [m_tm, & PairList [n_tm, & PairList [t_tm, & PairList []]]]] = map(inst(tyin))(avars)
          let PairList [pth_base, & PairList [pth_step, & PairList []]] = map(INST_TYPE(tyin))(pths)
          fun conv(th):
            let [entm, ltm] = dest_comb(rand(concl(th)))
            let [htm, ttm] = dest_cons(ltm)
            let [etm, ntm] = dest_comb(entm)
            let n = dest_numeral(ntm)
            if (n == num_0)
            | TRANS(th)(INST(PairList [[htm, h_tm], [ttm, t_tm]])(pth_base))
            | let th1 = num_CONV(ntm)
              let th2:
                INST(
                  PairList [
                    [ntm, n_tm],
                    [rand(rand(concl(th1))), m_tm],
                    [htm, h_tm],
                    [ttm, t_tm]
                  ]
                )(pth_step)
              let th3 = TRANS(th)(PROVE_HYP(th1)(th2))
              conv(th3)
          try:
            conv(REFL(tm))
            ~catch exn:
              match exn
              | Failure(_): failwith("EL_CONV")
              | exn: (throw exn)
        | match tm
          | _: failwith("EL_CONV")
    | _: failwith("EL_CONV")

def REVERSE_CONV:
  let pthc:
    prove(
      [
        @hol|{l:A list = APPEND l [] /\
           APPEND (REVERSE []) l:A list = l /\
           APPEND (REVERSE (CONS h t)) l = APPEND (REVERSE t) (CONS h l)}|,
        SIMP_TAC(PairList [APPEND, APPEND_NIL, REVERSE, GSYM(APPEND_ASSOC)])
      ]
    )
  let pths = map(UNDISCH_ALL)(CONJUNCTS(pthc))
  let avars = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Const("REVERSE",_),ltm):
        let tyin = PairList [[hd(snd(dest_type(type_of(ltm)))), aty]]
        let PairList [h_tm, & PairList [l_tm, & PairList [t_tm, & PairList []]]] = map(inst(tyin))(avars)
        let PairList [pth_init, & PairList [pth_base, & PairList [pth_step, & PairList []]]] = map(INST_TYPE(tyin))(pths)
        fun conv(th):
          let [ahtm, ltm] = dest_comb(rand(concl(th)))
          let httm = rand(rand(ahtm))
          if is_cons(httm)
          | let [htm, ttm] = dest_cons(httm)
            let th1 = INST(PairList [[htm, h_tm], [ltm, l_tm], [ttm, t_tm]])(pth_step)
            conv(TRANS(th)(th1))
          | TRANS(th)(INST(PairList [[ltm, l_tm]])(pth_base))
        try:
          conv(INST(PairList [[tm, l_tm]])(pth_init))
          ~catch exn:
            match exn
            | Failure(_): failwith("REVERSE_CONV")
            | exn: (throw exn)
    | _: failwith("REVERSE_CONV")

def LIST_OF_SEQ_CONV:
  let pthc:
    prove(
      [
        @hol|{l:A list = APPEND l [] /\
           APPEND (list_of_seq f 0) l:A list = l /\
           (n = SUC m
            ==> APPEND (list_of_seq f n) l =
                APPEND (list_of_seq f m) (CONS (f m) l))}|,
        SIMP_TAC(PairList [APPEND, APPEND_NIL, list_of_seq, GSYM(APPEND_ASSOC)])
      ]
    )
  let pths = map(UNDISCH_ALL)(CONJUNCTS(pthc))
  let avars = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Comb(Const("list_of_seq",_),ftm),ntm):
        let tyin = PairList [[snd(dest_fun_ty(type_of(ftm))), aty]]
        let PairList [f_tm, & PairList [l_tm, & PairList [m_tm, & PairList [n_tm, & PairList []]]]] = map(inst(tyin))(avars)
        let PairList [pth_init, & PairList [pth_base, & PairList [pth_step, & PairList []]]] = map(INST_TYPE(tyin))(pths)
        let bflag = is_abs(ftm)
        fun conv(th):
          let [nftm, ltm] = dest_comb(rand(concl(th)))
          let [lftm, ntm] = dest_comb(rand(nftm))
          let ftm = rand(lftm)
          let n = dest_numeral(ntm)
          if (n == num_0)
          | TRANS(th)(INST(PairList [[ftm, f_tm], [ltm, l_tm]])(pth_base))
          | let th1 = num_CONV(ntm)
            let th2:
              INST(
                PairList [
                  [ntm, n_tm],
                  [rand(rand(concl(th1))), m_tm],
                  [ftm, f_tm],
                  [ltm, l_tm]
                ]
              )(pth_step)
            let th3 = TRANS(th)(PROVE_HYP(th1)(th2))
            let th4:
              if !bflag
              | th3
              | let [jtm, ctxtm] = dest_comb(rand(concl(th3)))
                let [cttm, xtm] = dest_comb(ctxtm)
                let [ctm, ttm] = dest_comb(cttm)
                TRANS(th3)(AP_TERM(jtm)(AP_THM(AP_TERM(ctm)(BETA_CONV(ttm)))(xtm)))
            conv(th4)
        try:
          conv(INST(PairList [[tm, l_tm]])(pth_init))
          ~catch exn:
            match exn
            | Failure(_): failwith("LIST_OF_SEQ_CONV")
            | exn: (throw exn)
    | _: failwith("LIST_OF_SEQ_CONV")

def [lists_char_INDUCT_v2, char_RECURSION] = define_type("char = ASCII bool bool bool bool bool bool bool bool")

TypeInference.new_type_abbrev(["string", @hol|{:char list}|])

def [lists_dest_char_v2, lists_mk_char_v2, lists_dest_string_v2, lists_mk_string_v2, lists_CHAR_EQ_CONV_v2, STRING_EQ_CONV]:
  let bool_of_term:
    fun(t):
      match t
      | Const("T",_): #true
      | Const("F",_): #false
      | _: failwith("bool_of_term")
  let code_of_term:
    fun(t):
      let [f, tms] = strip_comb(t)
      if (!(is_const(f) && (fst(dest_const(f)) == "ASCII")) || !(length(tms) == 8))
      | failwith("code_of_term")
      | itlist(fun(b): fun(f): (if b | (1 + (2 * f)) | (2 * f)))(map(bool_of_term)(rev(tms)))(0)
  let char_of_term = o(hol_char_chr)(code_of_term)
  let dest_string:
    fun(tm):
      try:
        let tms = dest_list(tm)
        if (fst(dest_type(hd(snd(dest_type(type_of(tm)))))) != "char")
        | fail(#void)
        | let ccs = map(o(hol_string_make(1))(char_of_term))(tms)
          hol_string_escaped(implode(ccs))
        ~catch exn:
          match exn
          | Failure(_): failwith("dest_string")
          | exn: (throw exn)
  let mk_bool:
    fun(b):
      let [true_tm, false_tm] = [@hol|{T}|, @hol|{F}|]
      (if b | true_tm | false_tm)
  let ascii_tm:
    @hol|{ASCII}|
  let mk_code:
    fun(c):
      let lis = map((fun(i): mk_bool((((c div (1 bits.(<<) i)) rem 2) == 1))))(range(0)(7))
      itlist(fun(x): fun(y): mk_comb([y, x]))(lis)(ascii_tm)
  let codes = hol_array_map(mk_code)(Array(& range(0)(255)))
  let mk_code = (fun(c): codes[c])
  let mk_char = o(mk_code)(fun (s): Char.to_int(s[0]))
  let mk_string:
    fun(s):
      let ns = map((fun(i): Char.to_int(to_string(s[i])[0])))(range(0)((s.length() - 1)))
      mk_list([map(mk_code)(ns), @hol|{:char}|])
  let [avars, bvars, cvars]:
    [
      PairList [
        @hol|{a0:bool}|,
        @hol|{a1:bool}|,
        @hol|{a2:bool}|,
        @hol|{a3:bool}|,
        @hol|{a4:bool}|,
        @hol|{a5:bool}|,
        @hol|{a6:bool}|
      ],
      PairList [
        @hol|{b1:bool}|,
        @hol|{b2:bool}|,
        @hol|{b3:bool}|,
        @hol|{b4:bool}|,
        @hol|{b5:bool}|,
        @hol|{b6:bool}|,
        @hol|{b7:bool}|
      ],
      PairList [
        @hol|{c1:bool}|,
        @hol|{c2:bool}|,
        @hol|{c3:bool}|,
        @hol|{c4:bool}|,
        @hol|{c5:bool}|,
        @hol|{c6:bool}|,
        @hol|{c7:bool}|
      ]
    ]
  let ASCII_NEQS_FT:
    o(o(map(EQF_INTRO))(CONJUNCTS))(prove)(
      [
        @hol|{~(ASCII F b1 b2 b3 b4 b5 b6 b7 = ASCII T c1 c2 c3 c4 c5 c6 c7) /\
           ~(ASCII a0 F b2 b3 b4 b5 b6 b7 = ASCII a0 T c2 c3 c4 c5 c6 c7) /\
           ~(ASCII a0 a1 F b3 b4 b5 b6 b7 = ASCII a0 a1 T c3 c4 c5 c6 c7) /\
           ~(ASCII a0 a1 a2 F b4 b5 b6 b7 = ASCII a0 a1 a2 T c4 c5 c6 c7) /\
           ~(ASCII a0 a1 a2 a3 F b5 b6 b7 = ASCII a0 a1 a2 a3 T c5 c6 c7) /\
           ~(ASCII a0 a1 a2 a3 a4 F b6 b7 = ASCII a0 a1 a2 a3 a4 T c6 c7) /\
           ~(ASCII a0 a1 a2 a3 a4 a5 F b7 = ASCII a0 a1 a2 a3 a4 a5 T c7) /\
           ~(ASCII a0 a1 a2 a3 a4 a5 a6 F = ASCII a0 a1 a2 a3 a4 a5 a6 T)}|,
        REWRITE_TAC(PairList [injectivity("char")])
      ]
    )
  let ilist = append(zip(bvars)(cvars))(zip(cvars)(bvars))
  let f = o(o(o(EQF_INTRO)(INST(ilist)))(GSYM))(EQF_ELIM)
  let ASCII_NEQS_TF = map(f)(ASCII_NEQS_FT)
  // Recursive traversal needs the local definition before its first use.
  fun prefix(n):
    fun(l):
      if (n == 0)
      | PairList []
      | match l
        | PairList [h, & t]: PairList [h, & prefix((n - 1))(t)]
        | _: l
  // Recursive comparison needs the local definition before its first use.
  fun findneq(n):
    fun(prefix):
      fun(a):
        fun(b):
          match [a, b]
          | [PairList [b1, & a], PairList [b2, & b]]: (if (b1 != b2) | [n, rev(prefix), bool_of_term(b2), a, b] | findneq((n + 1))(PairList [b1, & prefix])(a)(b))
          | [_, _]: fail(#void)
  let CHAR_DISTINCTNESS:
    fun(c1):
      fun(c2):
        let [_, a_2] = strip_comb(c1)
        let [_, b_2] = strip_comb(c2)
        let [n, p, b, s1, s2] = findneq(0)(PairList [])(a_2)(b_2)
        let ss1 = funpow(n)(tl)(bvars)
        let ss2 = funpow(n)(tl)(cvars)
        let pp = prefix(n)(avars)
        let pth = (if b | ASCII_NEQS_FT | ASCII_NEQS_TF)
        INST(append(zip(p)(pp))(append(zip(s1)(ss1))(zip(s2)(ss2))))(el(n)(pth))
  let [xtm, xstm]:
    [
      @hol|{x:char}|,
      @hol|{xs:string}|
    ]
  let [ytm, ystm]:
    [
      @hol|{y:char}|,
      @hol|{ys:string}|
    ]
  let niltm = @hol|{[]:string}|
  let NIL_EQ_THM = EQT_INTRO(REFL(niltm))
  let [CONS_EQ_THM, CONS_NEQ_THM]:
    o(CONJ_PAIR)(prove)(
      [
        @hol|{(CONS x xs:string = CONS x ys <=> xs = ys) /\
           ((x = y <=> F) ==> (CONS x xs:string = CONS y ys <=> F))}|,
        REWRITE_TAC(PairList [CONS_11]) then_tac MESON_TAC(PairList [])
      ]
    )
  let [NIL_NEQ_CONS, CONS_NEQ_NIL]:
    o(CONJ_PAIR)(prove)(
      [
        @hol|{(NIL:string = CONS x xs <=> F) /\
           (CONS x xs:string = NIL <=> F)}|,
        REWRITE_TAC(PairList [NOT_CONS_NIL])
      ]
    )
  // Recursive proof construction needs the local definition before its first use.
  fun STRING_DISTINCTNESS_2(s1):
    fun(s2):
      if (s1 == niltm)
      | if (s2 == niltm)
        | NIL_EQ_THM
        | let [c2, s2] = [rand(rator(s2)), rand(s2)]
          INST(PairList [[c2, xtm], [s2, xstm]])(NIL_NEQ_CONS)
      | let [c1, s1] = [rand(rator(s1)), rand(s1)]
        if (s2 == niltm)
        | INST(PairList [[c1, xtm], [s1, xstm]])(CONS_NEQ_NIL)
        | let [c2, s2] = [rand(rator(s2)), rand(s2)]
          if (c1 == c2)
          | let th1 = INST(PairList [[c1, xtm], [s1, xstm], [s2, ystm]])(CONS_EQ_THM)
            let th2 = STRING_DISTINCTNESS_2(s1)(s2)
            TRANS(th1)(th2)
          | let ilist = PairList [[c1, xtm], [c2, ytm], [s1, xstm], [s2, ystm]]
            let itm = INST(ilist)(CONS_NEQ_THM)
            MP(itm)(CHAR_DISTINCTNESS(c1)(c2))
  let STRING_DISTINCTNESS = STRING_DISTINCTNESS_2
  let CHAR_EQ_CONV_2:
    fun(tm):
      let [c1, c2] = dest_eq(tm)
      (if (compare(c1)(c2) == 0) | EQT_INTRO(REFL(c1)) | CHAR_DISTINCTNESS(c1)(c2))
  let STRING_EQ_CONV_2:
    fun(tm):
      let [ltm, rtm] = dest_eq(tm)
      (if (compare(ltm)(rtm) == 0) | EQT_INTRO(REFL(ltm)) | STRING_DISTINCTNESS(ltm)(rtm))
  [char_of_term, mk_char, dest_string, mk_string, CHAR_EQ_CONV_2, STRING_EQ_CONV_2]

def char_INDUCT = lists_char_INDUCT_v2

def dest_char = lists_dest_char_v2

def mk_char = lists_mk_char_v2

def dest_string = lists_dest_string_v2

def mk_string = lists_mk_string_v2

def CHAR_EQ_CONV = lists_CHAR_EQ_CONV_v2
