def MEM_MAP:
  prove(
    [
      (hol:
         const MEM :: B -> list(B) -> bool
         const MAP :: (A -> B) -> list(A) -> list(B)
         const MEM_2 as MEM :: A -> list(A) -> bool
         forall (f :: A -> B, y :: B, l :: list(A)):
           MEM(y, MAP(f, l)) <=> (exists x :: A: MEM_2(x, l) && y == f(x))),
      (
        (
          ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
          ASM_REWRITE_TAC(PairList [MEM, MAP])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def FILTER_APPEND:
  prove(
    [
      (hol:
         const FILTER :: (A -> bool) -> list(A) -> list(A)
         const APPEND :: list(A) -> list(A) -> list(A)
         forall (P :: A -> bool, l1 :: list(A), l2 :: list(A)):
           FILTER(P, APPEND(l1, l2)) == APPEND(FILTER(P, l1), FILTER(P, l2))),
