  // Recursive traversal needs the local definition before its first use.
  fun prefix(n):
    fun(l):
      if (n == 0)
      | PairList []
      | match l
        | PairList [h, & t]: PairList [h, & prefix((n - 1))(t)]
        | _: l
  // Recursive comparison needs the local definition before its first use.
  fun findneq(n):
    fun(prefix):
      fun(a):
        fun(b):
          match [a, b]
          | [PairList [b1, & a], PairList [b2, & b]]: (if (b1 != b2) | [n, Host.rev(prefix), bool_of_term(b2), a, b] | findneq((n + 1))(PairList [b1, & prefix])(a)(b))
