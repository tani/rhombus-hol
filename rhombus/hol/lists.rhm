def APPEND_BUTLAST_LAST:
  prove(
    [
      (hol:
         const NIL :: list(A)
         const APPEND :: list(A) -> list(A) -> list(A)
         const BUTLAST :: list(A) -> list(A)
         const CONS :: A -> list(A) -> list(A)
         const LAST :: list(A) -> A
         forall l :: list(A): l != NIL ==> APPEND(BUTLAST(l), CONS(LAST(l), NIL)) == l),
      (
        (
          (LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [LAST, BUTLAST, NOT_CONS_NIL])) then_tac \
          COND_CASES_TAC
        ) then_tac \
        ASM_SIMP_TAC(PairList [APPEND])
      )
    ]
  )

def LAST_APPEND:
  prove(
    [
      (hol:
         const LAST :: list(A) -> A
         const APPEND :: list(A) -> list(A) -> list(A)
         const NIL :: list(A)
         forall (p :: list(A), q :: list(A)): LAST(APPEND(p, q)) == (if q == NIL | LAST(p) | LAST(q))),
      (
        (LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [APPEND, LAST, APPEND_EQ_NIL])) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def LENGTH_TL:
  prove(
    [
      (hol:
         const NIL :: list(A)
         const LENGTH :: list(A) -> num
         const TL :: list(A) -> list(A)
         forall l :: list(A): l != NIL ==> LENGTH(TL(l)) == LENGTH(l) - (1 :: num)),
      (LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [LENGTH, TL, ARITH, SUC_SUB1]))
    ]
  )

def LAST_REVERSE:
  prove(
    [
      (hol:
         const NIL :: list(A)
         const LAST :: list(A) -> A
         const REVERSE :: list(A) -> list(A)
         const HD :: list(A) -> A
         forall l :: list(A): l != NIL ==> LAST(REVERSE(l)) == HD(l)),
      (
        LIST_INDUCT_TAC then_tac \
        REWRITE_TAC(PairList [HD, REVERSE, LAST, LAST_APPEND, NOT_CONS_NIL])
      )
    ]
  )

def HD_REVERSE:
  prove(
    [
      (hol:
         const NIL :: list(A)
         const HD :: list(A) -> A
         const REVERSE :: list(A) -> list(A)
         const LAST :: list(A) -> A
         forall l :: list(A): l != NIL ==> HD(REVERSE(l)) == LAST(l)),
      MESON_TAC(PairList [LAST_REVERSE, REVERSE_REVERSE, REVERSE_EQ_EMPTY])
    ]
  )

def EL_APPEND:
  prove(
    [
      (hol:
         const EL :: num -> list(A) -> A
         const APPEND :: list(A) -> list(A) -> list(A)
         const LENGTH :: list(A) -> num
         forall (k :: num, l :: list(A), m :: list(A)):
           EL(k, APPEND(l, m)) == (if k < LENGTH(l) | EL(k, l) | EL(k - LENGTH(l), m))),
      (
        (
          ((INDUCT_TAC then_tac REWRITE_TAC(PairList [EL])) then_tac LIST_INDUCT_TAC) then_tac \
          REWRITE_TAC(PairList [HD, APPEND, LENGTH, SUB_0, EL, LT_0, CONJUNCT1(LT)])
        ) then_tac \
        ASM_REWRITE_TAC(PairList [TL, LT_SUC, SUB_SUC])
      )
    ]
  )

def EL_TL:
  prove(
    [
      (hol:
         var l :: list(A)
         const EL :: num -> list(A) -> A
         const TL :: list(A) -> list(A)
         forall n :: num: EL(n, TL(l)) == EL(n + (1 :: num), l)),
      REWRITE_TAC(PairList [GSYM(ADD1), EL])
    ]
  )

def EL_CONS:
  prove(
    [
      (hol:
         const EL :: num -> list(A) -> A
         const CONS :: A -> list(A) -> list(A)
         forall (n :: num, h :: A, t :: list(A)):
           EL(n, CONS(h, t)) == (if n == (0 :: num) | h | EL(n - (1 :: num), t))),
      (INDUCT_TAC then_tac REWRITE_TAC(PairList [EL, HD, TL, NOT_SUC, SUC_SUB1]))
    ]
  )

def LAST_EL:
  prove(
    [
      (hol:
         const NIL :: list(A)
         const LAST :: list(A) -> A
         const EL :: num -> list(A) -> A
         const LENGTH :: list(A) -> num
         forall l :: list(A): l != NIL ==> LAST(l) == EL(LENGTH(l) - (1 :: num), l)),
      (
        (
          (
            (LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [LAST, LENGTH, SUC_SUB1])) then_tac \
            DISCH_TAC
          ) then_tac \
          COND_CASES_TAC
        ) then_tac \
        ASM_SIMP_TAC(PairList [LENGTH, EL, HD, EL_CONS, LENGTH_EQ_NIL])
      )
    ]
  )

def HD_APPEND:
  prove(
    [
      (hol:
         const HD :: list(A) -> A
         const APPEND :: list(A) -> list(A) -> list(A)
         const NIL :: list(A)
         forall (l :: list(A), m :: list(A)): HD(APPEND(l, m)) == (if l == NIL | HD(m) | HD(l))),
      (LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [HD, APPEND, NOT_CONS_NIL]))
    ]
  )

def CONS_HD_TL:
  prove(
    [
      (hol:
         const NIL :: list(A)
         const CONS :: A -> list(A) -> list(A)
         const HD :: list(A) -> A
         const TL :: list(A) -> list(A)
         forall l :: list(A): l != NIL ==> l == CONS(HD(l), TL(l))),
      (LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [NOT_CONS_NIL, HD, TL]))
    ]
  )

def EL_MAP:
  prove(
    [
      (hol:
         const LENGTH :: list(A) -> num
         const EL :: num -> list(B) -> B
         const MAP :: (A -> B) -> list(A) -> list(B)
         const EL_2 as EL :: num -> list(A) -> A
         forall (f :: A -> B, n :: num, l :: list(A)):
           n < LENGTH(l) ==> EL(n, MAP(f, l)) == f(EL_2(n, l))),
      (
        ((GEN_TAC then_tac INDUCT_TAC) then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [LENGTH, CONJUNCT1(LT), LT_0, EL, HD, TL, MAP, LT_SUC])
      )
    ]
  )

def MAP_REVERSE:
  prove(
    [
      (hol:
         const REVERSE :: list(B) -> list(B)
         const MAP :: (A -> B) -> list(A) -> list(B)
         const REVERSE_2 as REVERSE :: list(A) -> list(A)
         forall (f :: A -> B, l :: list(A)): REVERSE(MAP(f, l)) == MAP(f, REVERSE_2(l))),
      (
        (GEN_TAC then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [MAP, REVERSE, MAP_APPEND])
      )
    ]
  )

def ALL_FILTER:
  prove(
    [
      (hol:
         const ALL :: (A -> bool) -> list(A) -> bool
         const FILTER :: (A -> bool) -> list(A) -> list(A)
         forall (P :: A -> bool, Q :: A -> bool, l :: list(A)):
           ALL(P, FILTER(Q, l)) <=> ALL(fun (x :: A): Q(x) ==> P(x), l)),
      (
        (
          (
            ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
            REWRITE_TAC(PairList [ALL, FILTER])
          ) then_tac \
          COND_CASES_TAC
        ) then_tac \
        ASM_REWRITE_TAC(PairList [ALL])
      )
    ]
  )

def APPEND_SING:
  prove(
    [
      (hol:
         const APPEND :: list(A) -> list(A) -> list(A)
         const CONS :: A -> list(A) -> list(A)
         const NIL :: list(A)
         forall (h :: A, t :: list(A)): APPEND(CONS(h, NIL), t) == CONS(h, t)),
      REWRITE_TAC(PairList [APPEND])
    ]
  )

def MEM_APPEND_DECOMPOSE_LEFT:
  prove(
    [
      (hol:
         const MEM :: A -> list(A) -> bool
         const APPEND :: list(A) -> list(A) -> list(A)
         const CONS :: A -> list(A) -> list(A)
         forall (x :: A, l :: list(A)):
           MEM(x, l)
             <=> (exists (l1 :: list(A), l2 :: list(A)): !MEM(x, l1) && l == APPEND(l1, CONS(x, l2)))),
      (
        (
          (
            (
              (
                (
                  (
                    REWRITE_TAC(
                      PairList [
                        TAUT(
                          (hol:
                             var p :: bool
                             var q :: bool
                             (p <=> q) <=> (p ==> q) && (q ==> p))
                        )
                      ]
                    ) then_tac \
                    SIMP_TAC(PairList [LEFT_IMP_EXISTS_THM, MEM_APPEND, MEM])
                  ) then_tac \
                  X_GEN_TAC(hol: var x :: A; x)
                ) then_tac \
                MATCH_MP_TAC(IndTypes.list_INDUCT)
              ) then_tac \
              REWRITE_TAC(PairList [MEM])
            ) then_tac \
            MAP_EVERY(X_GEN_TAC)(
              PairList [
                (hol: var y :: A; y),
                (hol: var l :: list(A); l)
              ]
            )
          ) then_tac \
          ASM_CASES_TAC(hol:
                          var x :: A
                          var y :: A
                          x == y)
        ) then_tac \
        ASM_MESON_TAC(PairList [MEM, APPEND])
      )
    ]
  )

def MEM_APPEND_DECOMPOSE:
  prove(
    [
      (hol:
         const MEM :: A -> list(A) -> bool
         const APPEND :: list(A) -> list(A) -> list(A)
         const CONS :: A -> list(A) -> list(A)
         forall (x :: A, l :: list(A)):
           MEM(x, l) <=> (exists (l1 :: list(A), l2 :: list(A)): l == APPEND(l1, CONS(x, l2)))),
      (
        (
          (
            REWRITE_TAC(
              PairList [
                TAUT(
                  (hol:
                     var p :: bool
                     var q :: bool
                     (p <=> q) <=> (p ==> q) && (q ==> p))
                )
              ]
            ) then_tac \
            SIMP_TAC(PairList [LEFT_IMP_EXISTS_THM, MEM_APPEND, MEM])
          ) then_tac \
          ONCE_REWRITE_TAC(PairList [MEM_APPEND_DECOMPOSE_LEFT])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def PAIRWISE_APPEND:
  prove(
    [
      (hol:
         const PAIRWISE :: (A -> A -> bool) -> list(A) -> bool
         const APPEND :: list(A) -> list(A) -> list(A)
         const MEM :: A -> list(A) -> bool
         forall (R :: A -> A -> bool, l :: list(A), m :: list(A)):
           PAIRWISE(R, APPEND(l, m))
             <=> (PAIRWISE(R, l)
                    && (PAIRWISE(R, m) && (forall (x :: A, y :: A): MEM(x, l) && MEM(y, m) ==> R(x, y))))),
      (
        (
          (GEN_TAC then_tac MATCH_MP_TAC(IndTypes.list_INDUCT)) then_tac \
          REWRITE_TAC(PairList [APPEND, PAIRWISE, MEM, ALL_APPEND, GSYM(ALL_MEM)])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def PAIRWISE_MAP:
  prove(
    [
      (hol:
         const PAIRWISE :: (B -> B -> bool) -> list(B) -> bool
         const MAP :: (A -> B) -> list(A) -> list(B)
         const PAIRWISE_2 as PAIRWISE :: (A -> A -> bool) -> list(A) -> bool
         forall (R :: B -> B -> bool, f :: A -> B, l :: list(A)):
           PAIRWISE(R, MAP(f, l)) <=> PAIRWISE_2(fun (x :: A, y :: A): R(f(x), f(y)), l)),
      (
        ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [PAIRWISE, MAP, ALL_MAP, o_DEF])
      )
    ]
  )

def PAIRWISE_IMPLIES:
  prove(
    [
      (hol:
         const PAIRWISE :: (A -> A -> bool) -> list(A) -> bool
         const MEM :: A -> list(A) -> bool
         forall (R :: A -> A -> bool, R_prime as "R'" :: A -> A -> bool, l :: list(A)):
           (PAIRWISE(R, l)
              && (forall (x :: A, y :: A): MEM(x, l) && (MEM(y, l) && R(x, y)) ==> R_prime(x, y)))
             ==> PAIRWISE(R_prime, l)),
      (
        (
          ((GEN_TAC then_tac GEN_TAC) then_tac MATCH_MP_TAC(IndTypes.list_INDUCT)) then_tac \
          REWRITE_TAC(PairList [PAIRWISE, GSYM(ALL_MEM), MEM])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def PAIRWISE_TRANSITIVE:
  prove(
    [
      (hol:
         const PAIRWISE :: (A -> A -> bool) -> list(A) -> bool
         const CONS :: A -> list(A) -> list(A)
         forall (R :: A -> A -> bool, x :: A, y :: A, l :: list(A)):
           (forall (x :: A, y :: A, z :: A): R(x, y) && R(y, z) ==> R(x, z))
             ==> (PAIRWISE(R, CONS(x, CONS(y, l))) <=> R(x, y) && PAIRWISE(R, CONS(y, l)))),
      (
        (
          (
            (
              REPEAT(STRIP_TAC) then_tac \
              REWRITE_TAC(
                PairList [
                  PAIRWISE,
                  ALL,
                  GSYM(CONJ_ASSOC),
                  TAUT(
                    (hol:
                       var p :: bool
                       var q :: bool
                       var r :: bool
                       var s :: bool
                       (p && (q && (r && s)) <=> p && (r && s)) <=> p && s ==> r ==> q)
                  )
                ]
              )
            ) then_tac \
            STRIP_TAC
          ) then_tac \
          MATCH_MP_TAC(REWRITE_RULE(PairList [IMP_CONJ])(ALL_IMP))
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def LENGTH_LIST_OF_SEQ:
  prove(
    [
      (hol:
         const LENGTH :: list(A) -> num
         const list_of_seq :: (num -> A) -> num -> list(A)
         forall (s :: num -> A, n :: num): LENGTH(list_of_seq(s, n)) == n),
      (
        (GEN_TAC then_tac INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [list_of_seq, LENGTH, LENGTH_APPEND, ADD_CLAUSES])
      )
    ]
  )

def EL_LIST_OF_SEQ:
  prove(
    [
      (hol:
         const EL :: num -> list(A) -> A
         const list_of_seq :: (num -> A) -> num -> list(A)
         forall (s :: num -> A, m :: num, n :: num): m < n ==> EL(m, list_of_seq(s, n)) == s(m)),
      (
        (
          (
            (
              (GEN_TAC then_tac ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM])) then_tac \
              INDUCT_TAC
            ) then_tac \
            REWRITE_TAC(PairList [list_of_seq, LT, EL_APPEND, LENGTH_LIST_OF_SEQ])
          ) then_tac \
          REPEAT(STRIP_TAC)
        ) then_tac \
        ASM_SIMP_TAC(PairList [SUB_REFL, EL, HD, LT_REFL])
      )
    ]
  )

def LIST_OF_SEQ_EQ_NIL:
  prove(
    [
      (hol:
         const list_of_seq :: (num -> A) -> num -> list(A)
         const NIL :: list(A)
         forall (s :: num -> A, n :: num): list_of_seq(s, n) == NIL <=> n == (0 :: num)),
      REWRITE_TAC(PairList [GSYM(LENGTH_EQ_NIL), LENGTH_LIST_OF_SEQ, LENGTH])
    ]
  )

def LIST_OF_SEQ_EQ_SELF:
  prove(
    [
      (hol:
         const list_of_seq :: (num -> A) -> num -> list(A)
         const EL :: num -> list(A) -> A
         const LENGTH :: list(A) -> num
         forall l :: list(A): list_of_seq(fun (i :: num): EL(i, l), LENGTH(l)) == l),
      SIMP_TAC(PairList [LIST_EQ, LENGTH_LIST_OF_SEQ, EL_LIST_OF_SEQ])
    ]
  )

def LENGTH_EQ_LIST_OF_SEQ:
  prove(
    [
      (hol:
         const LENGTH :: list(A) -> num
         const list_of_seq :: (num -> A) -> num -> list(A)
         const EL :: num -> list(A) -> A
         forall (l :: list(A), n :: num):
           LENGTH(l) == n <=> l == list_of_seq(fun (i :: num): EL(i, l), n)),
      MESON_TAC(PairList [LIST_OF_SEQ_EQ_SELF, LENGTH_LIST_OF_SEQ])
    ]
  )

def MAP_LIST_OF_SEQ:
  prove(
    [
      (hol:
         const MAP :: (A -> B) -> list(A) -> list(B)
         const list_of_seq :: (num -> A) -> num -> list(A)
         const list_of_seq_2 as list_of_seq :: (num -> B) -> num -> list(B)
         const o :: (A -> B) -> (num -> A) -> num -> B
         forall (f :: num -> A, g :: A -> B, n :: num):
           MAP(g, list_of_seq(f, n)) == list_of_seq_2(o(g, f), n)),
      (
        ((GEN_TAC then_tac GEN_TAC) then_tac INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [MAP, list_of_seq, MAP_APPEND, o_THM])
      )
    ]
  )

def LIST_OF_SEQ:
  prove(
    [
      (hol:
         const list_of_seq :: (num -> A) -> num -> list(A)
         const NIL :: list(A)
         const SUC :: num -> num
         const CONS :: A -> list(A) -> list(A)
         const o :: (num -> A) -> (num -> num) -> num -> A
         (forall f :: num -> A: list_of_seq(f, (0 :: num)) == NIL)
           && (forall (f :: num -> A, n :: num):
                 list_of_seq(f, SUC(n)) == CONS(f((0 :: num)), list_of_seq(o(f, SUC), n)))),
      (
        (
          (
            (
              (
                REWRITE_TAC(PairList [CONJUNCT1(list_of_seq)]) then_tac \
                REPEAT(GEN_TAC)
              ) then_tac \
              REWRITE_TAC(PairList [LIST_EQ, LENGTH_LIST_OF_SEQ, LENGTH, EL_CONS])
            ) then_tac \
            INDUCT_TAC
          ) then_tac \
          ASM_SIMP_TAC(PairList [NOT_SUC, EL_LIST_OF_SEQ])
        ) then_tac \
        ASM_SIMP_TAC(PairList [LT_SUC, SUC_SUB1, EL_LIST_OF_SEQ, o_THM])
      )
    ]
  )

fun mk_cons(h):
  fun(t):
    try:
      let cons = mk_const(["CONS", PairList [[type_of(h), aty]]])
      mk_comb([mk_comb([cons, h]), t])
      ~catch exn:
        match exn
        | Failure(_): failwith("mk_cons")
        | exn: (throw exn)

fun mk_list([tms, ty]):
  try:
    let nil = mk_const(["NIL", PairList [[ty, aty]]])
    if (tms == (PairList []))
    | nil
    | let cons = mk_const(["CONS", PairList [[ty, aty]]])
      itlist(mk_binop(cons))(tms)(nil)
    ~catch exn:
      match exn
      | Failure(_): failwith("mk_list")
      | exn: (throw exn)

fun mk_flist(tms):
  try:
    mk_list([tms, type_of(hd(tms))])
    ~catch exn:
      match exn
      | Failure(_): failwith("mk_flist")
      | exn: (throw exn)

def MONO_ALL:
  prove(
    [
      (hol:
         var P :: A -> bool
         var Q :: A -> bool
         var l :: list(A)
         const ALL :: (A -> bool) -> list(A) -> bool
         (forall x :: A: P(x) ==> Q(x)) ==> ALL(P, l) ==> ALL(Q, l)),
      (
        (
          (
            (
              DISCH_TAC then_tac \
              SPEC_TAC(
                [
                  (hol: var l :: list(A); l),
                  (hol: var l :: list(A); l)
                ]
              )
            ) then_tac \
            LIST_INDUCT_TAC
          ) then_tac \
          ASM_REWRITE_TAC(PairList [ALL])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def MONO_ALL2:
  prove(
    [
      (hol:
         var P :: A -> B -> bool
         var Q :: A -> B -> bool
         var l :: list(A)
         var l_prime as "l'" :: list(B)
         const ALL2 :: (A -> B -> bool) -> list(A) -> list(B) -> bool
         (forall (x :: A, y :: B): P(x, y) ==> Q(x, y)) ==> ALL2(P, l, l_prime) ==> ALL2(Q, l, l_prime)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      DISCH_TAC then_tac \
                      SPEC_TAC(
                        [
                          (hol: var l_prime as "l'" :: list(B); l_prime),
                          (hol: var l_prime as "l'" :: list(B); l_prime)
                        ]
                      )
                    ) then_tac \
                    SPEC_TAC(
                      [
                        (hol: var l :: list(A); l),
                        (hol: var l :: list(A); l)
                      ]
                    )
                  ) then_tac \
                  LIST_INDUCT_TAC
                ) then_tac \
                REWRITE_TAC(PairList [ALL2_DEF])
              ) then_tac \
              GEN_TAC
            ) then_tac \
            COND_CASES_TAC
          ) then_tac \
          REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

monotonicity_theorems.value := append(PairList [MONO_ALL, MONO_ALL2])(monotonicity_theorems.value)

fun LIST_CONV(conv):
  fun(tm):
    if is_cons(tm)
    | COMB2_CONV(RAND_CONV(conv))(LIST_CONV(conv))(tm)
    | (if (fst(dest_const(tm)) == "NIL") | REFL(tm) | failwith("LIST_CONV"))

def LENGTH_CONV:
  let pthc:
    prove(
      [
        (hol:
           var t :: list(A)
           var n :: num
           var h :: A
           const LENGTH :: list(A) -> num
           const NIL :: list(A)
           const CONS :: A -> list(A) -> list(A)
           const SUC :: num -> num
           LENGTH(t) == LENGTH(t) + (0 :: num)
             && (LENGTH(NIL) + n == n && LENGTH(CONS(h, t)) + n == LENGTH(t) + SUC(n))),
        REWRITE_TAC(PairList [LENGTH, ADD_CLAUSES])
      ]
    )
  let pths_2 = CONJUNCTS(pthc)
  let avars_2 = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Const("LENGTH",_),ltm):
        if is_list(ltm)
        | let tyin = PairList [[hd(snd(dest_type(type_of(ltm)))), aty]]
          let PairList [h_tm_2, & PairList [n_tm_2, & PairList [t_tm_2, & PairList []]]] = map(inst(tyin))(avars_2)
          let PairList [pth_init_2, & PairList [pth_base_2, & PairList [pth_step_2, & PairList []]]] = map(INST_TYPE(tyin))(pths_2)
          fun conv(th):
            let [altm, ntm] = dest_comb(rand(concl(th)))
            let ltm = rand(rand(altm))
            if is_cons(ltm)
            | let [htm, ttm] = dest_cons(ltm)
              let th1 = INST(PairList [[htm, h_tm_2], [ttm, t_tm_2], [ntm, n_tm_2]])(pth_step_2)
              let [ftm, stm] = dest_comb(rand(concl(th1)))
              let th2 = TRANS(th1)(AP_TERM(ftm)(NUM_SUC_CONV(stm)))
              conv(TRANS(th)(th2))
            | TRANS(th)(INST(PairList [[ntm, n_tm_2]])(pth_base_2))
          try:
            conv(INST(PairList [[rand(tm), t_tm_2]])(pth_init_2))
            ~catch exn:
              match exn
              | Failure(_): failwith("LENGTH_CONV")
              | exn: (throw exn)
        | match tm
          | _: failwith("LENGTH_CONV")
    | _: failwith("LENGTH_CONV")

def EL_CONV:
  let pthc:
    prove(
      [
        (hol:
           var h :: A
           var t :: list(A)
           var n :: num
           var m :: num
           const EL :: num -> list(A) -> A
           const CONS :: A -> list(A) -> list(A)
           const SUC :: num -> num
           EL((0 :: num), CONS(h, t)) == h && (n == SUC(m) ==> EL(n, CONS(h, t)) == EL(m, t))),
        SIMP_TAC(PairList [EL, HD, TL])
      ]
    )
  let pths_3 = map(UNDISCH_ALL)(CONJUNCTS(pthc))
  let avars_3 = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Comb(Const("EL",_),ntm),ltm):
        if is_list(ltm)
        | let tyin = PairList [[hd(snd(dest_type(type_of(ltm)))), aty]]
          let PairList [h_tm_3, & PairList [m_tm_2, & PairList [n_tm_3, & PairList [t_tm_3, & PairList []]]]] = map(inst(tyin))(avars_3)
          let PairList [pth_base_3, & PairList [pth_step_3, & PairList []]] = map(INST_TYPE(tyin))(pths_3)
          fun conv_2(th):
            let [entm, ltm] = dest_comb(rand(concl(th)))
            let [htm, ttm] = dest_cons(ltm)
            let [etm, ntm] = dest_comb(entm)
            let n = dest_numeral(ntm)
            if (n == num_0)
            | TRANS(th)(INST(PairList [[htm, h_tm_3], [ttm, t_tm_3]])(pth_base_3))
            | let th1 = num_CONV(ntm)
              let th2:
                INST(
                  PairList [
                    [ntm, n_tm_3],
                    [rand(rand(concl(th1))), m_tm_2],
                    [htm, h_tm_3],
                    [ttm, t_tm_3]
                  ]
                )(pth_step_3)
              let th3 = TRANS(th)(PROVE_HYP(th1)(th2))
              conv_2(th3)
          try:
            conv_2(REFL(tm))
            ~catch exn:
              match exn
              | Failure(_): failwith("EL_CONV")
              | exn: (throw exn)
        | match tm
          | _: failwith("EL_CONV")
    | _: failwith("EL_CONV")

def REVERSE_CONV:
  let pthc:
    prove(
      [
        (hol:
           var l :: list(A)
           var h :: A
           var t :: list(A)
           const APPEND :: list(A) -> list(A) -> list(A)
           const NIL :: list(A)
           const REVERSE :: list(A) -> list(A)
           const CONS :: A -> list(A) -> list(A)
           l == APPEND(l, NIL)
             && (APPEND(REVERSE(NIL), l) == l
                   && APPEND(REVERSE(CONS(h, t)), l) == APPEND(REVERSE(t), CONS(h, l)))),
        SIMP_TAC(PairList [APPEND, APPEND_NIL, REVERSE, GSYM(APPEND_ASSOC)])
      ]
    )
  let pths_4 = map(UNDISCH_ALL)(CONJUNCTS(pthc))
  let avars_4 = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Const("REVERSE",_),ltm):
        let tyin = PairList [[hd(snd(dest_type(type_of(ltm)))), aty]]
        let PairList [h_tm_4, & PairList [l_tm_2, & PairList [t_tm_4, & PairList []]]] = map(inst(tyin))(avars_4)
        let PairList [pth_init_3, & PairList [pth_base_4, & PairList [pth_step_4, & PairList []]]] = map(INST_TYPE(tyin))(pths_4)
        fun conv_3(th):
          let [ahtm, ltm] = dest_comb(rand(concl(th)))
          let httm = rand(rand(ahtm))
          if is_cons(httm)
          | let [htm, ttm] = dest_cons(httm)
            let th1 = INST(PairList [[htm, h_tm_4], [ltm, l_tm_2], [ttm, t_tm_4]])(pth_step_4)
            conv_3(TRANS(th)(th1))
          | TRANS(th)(INST(PairList [[ltm, l_tm_2]])(pth_base_4))
        try:
          conv_3(INST(PairList [[tm, l_tm_2]])(pth_init_3))
          ~catch exn:
            match exn
            | Failure(_): failwith("REVERSE_CONV")
            | exn: (throw exn)
    | _: failwith("REVERSE_CONV")

def LIST_OF_SEQ_CONV:
  let pthc:
    prove(
      [
        (hol:
           var l :: list(A)
           var f :: num -> A
           var n :: num
           var m :: num
           const APPEND :: list(A) -> list(A) -> list(A)
           const NIL :: list(A)
           const list_of_seq :: (num -> A) -> num -> list(A)
           const SUC :: num -> num
           const CONS :: A -> list(A) -> list(A)
           l == APPEND(l, NIL)
             && (APPEND(list_of_seq(f, (0 :: num)), l) == l
                   && (n == SUC(m)
                         ==> APPEND(list_of_seq(f, n), l) == APPEND(list_of_seq(f, m), CONS(f(m), l))))),
        SIMP_TAC(PairList [APPEND, APPEND_NIL, list_of_seq, GSYM(APPEND_ASSOC)])
      ]
    )
  let pths_5 = map(UNDISCH_ALL)(CONJUNCTS(pthc))
  let avars_5 = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Comb(Const("list_of_seq",_),ftm),ntm):
        let tyin = PairList [[snd(dest_fun_ty(type_of(ftm))), aty]]
        let PairList [f_tm_2, & PairList [l_tm_3, & PairList [m_tm_3, & PairList [n_tm_4, & PairList []]]]] = map(inst(tyin))(avars_5)
        let PairList [pth_init_4, & PairList [pth_base_5, & PairList [pth_step_5, & PairList []]]] = map(INST_TYPE(tyin))(pths_5)
        let bflag_2 = is_abs(ftm)
        fun conv_4(th):
          let [nftm, ltm] = dest_comb(rand(concl(th)))
          let [lftm, ntm] = dest_comb(rand(nftm))
          let ftm = rand(lftm)
          let n = dest_numeral(ntm)
          if (n == num_0)
          | TRANS(th)(INST(PairList [[ftm, f_tm_2], [ltm, l_tm_3]])(pth_base_5))
          | let th1 = num_CONV(ntm)
            let th2:
              INST(
                PairList [
                  [ntm, n_tm_4],
                  [rand(rand(concl(th1))), m_tm_3],
                  [ftm, f_tm_2],
                  [ltm, l_tm_3]
                ]
              )(pth_step_5)
            let th3 = TRANS(th)(PROVE_HYP(th1)(th2))
            let th4:
              if !bflag_2
              | th3
              | let [jtm, ctxtm] = dest_comb(rand(concl(th3)))
                let [cttm, xtm] = dest_comb(ctxtm)
                let [ctm, ttm] = dest_comb(cttm)
                TRANS(th3)(AP_TERM(jtm)(AP_THM(AP_TERM(ctm)(BETA_CONV(ttm)))(xtm)))
            conv_4(th4)
        try:
          conv_4(INST(PairList [[tm, l_tm_3]])(pth_init_4))
          ~catch exn:
            match exn
            | Failure(_): failwith("LIST_OF_SEQ_CONV")
            | exn: (throw exn)
    | _: failwith("LIST_OF_SEQ_CONV")

def [lists_char_INDUCT_v2, char_RECURSION] = define_type("char = ASCII bool bool bool bool bool bool bool bool")

TypeInference.new_type_abbrev(["string", (hol_type: list(char))])

def [lists_dest_char_v2, lists_mk_char_v2, lists_dest_string_v2, lists_mk_string_v2, lists_CHAR_EQ_CONV_v2, STRING_EQ_CONV]:
  let bool_of_term:
    fun(t):
      match t
      | Const("T",_): #true
      | Const("F",_): #false
      | _: failwith("bool_of_term")
  let code_of_term:
    fun(t):
      let [f, tms] = strip_comb(t)
      if (!(is_const(f) && (fst(dest_const(f)) == "ASCII")) || !(length(tms) == 8))
      | failwith("code_of_term")
      | itlist(fun(b): fun(f): (if b | (1 + (2 * f)) | (2 * f)))(map(bool_of_term)(rev(tms)))(0)
  let char_of_term = o(hol_char_chr)(code_of_term)
  let dest_string:
    fun(tm):
      try:
        let tms = dest_list(tm)
        if (fst(dest_type(hd(snd(dest_type(type_of(tm)))))) != "char")
        | fail()
        | let ccs = map(o(hol_string_make(1))(char_of_term))(tms)
          hol_string_escaped(implode(ccs))
        ~catch exn:
          match exn
          | Failure(_): failwith("dest_string")
          | exn: (throw exn)
  let mk_bool:
    fun(b):
      let [true_tm, false_tm] = [(hol:
                                    #true), (hol:
                                                    #false)]
      (if b | true_tm | false_tm)
  let ascii_tm:
    (hol: const ASCII :: bool -> bool -> bool -> bool -> bool -> bool -> bool -> bool -> char; ASCII)
  let mk_code:
    fun(c):
      let lis = map((fun(i): mk_bool((((c div (1 bits.(<<) i)) rem 2) == 1))))(range(0)(7))
      itlist(fun(x): fun(y): mk_comb([y, x]))(lis)(ascii_tm)
  let codes = hol_array_map(mk_code)(Array(& range(0)(255)))
  let mk_code = (fun(c): codes[c])
  let mk_char = o(mk_code)(fun (s): Char.to_int(s[0]))
  let mk_string:
    fun(s):
      let ns = map((fun(i): Char.to_int(to_string(s[i])[0])))(range(0)((s.length() - 1)))
      mk_list([map(mk_code)(ns), (hol_type: char)])
  let [avars, bvars, cvars]:
    [
      PairList [
        (hol: var a0 :: bool; a0),
        (hol: var a1 :: bool; a1),
        (hol: var a2 :: bool; a2),
        (hol: var a3 :: bool; a3),
        (hol: var a4 :: bool; a4),
        (hol: var a5 :: bool; a5),
        (hol: var a6 :: bool; a6)
      ],
      PairList [
        (hol: var b1 :: bool; b1),
        (hol: var b2 :: bool; b2),
        (hol: var b3 :: bool; b3),
        (hol: var b4 :: bool; b4),
        (hol: var b5 :: bool; b5),
        (hol: var b6 :: bool; b6),
        (hol: var b7 :: bool; b7)
      ],
      PairList [
        (hol: var c1 :: bool; c1),
        (hol: var c2 :: bool; c2),
        (hol: var c3 :: bool; c3),
        (hol: var c4 :: bool; c4),
        (hol: var c5 :: bool; c5),
        (hol: var c6 :: bool; c6),
        (hol: var c7 :: bool; c7)
      ]
    ]
  let ASCII_NEQS_FT:
    o(o(map(EQF_INTRO))(CONJUNCTS))(prove)(
      [
        (hol:
           var b1 :: bool
           var b2 :: bool
           var b3 :: bool
           var b4 :: bool
           var b5 :: bool
           var b6 :: bool
           var b7 :: bool
           var c1 :: bool
           var c2 :: bool
           var c3 :: bool
           var c4 :: bool
           var c5 :: bool
           var c6 :: bool
           var c7 :: bool
           var a0 :: bool
           var a1 :: bool
           var a2 :: bool
           var a3 :: bool
           var a4 :: bool
           var a5 :: bool
           var a6 :: bool
           const ASCII :: bool -> bool -> bool -> bool -> bool -> bool -> bool -> bool -> char
           ASCII(#false, b1, b2, b3, b4, b5, b6, b7) != ASCII(#true, c1, c2, c3, c4, c5, c6, c7)
             && (ASCII(a0, #false, b2, b3, b4, b5, b6, b7) != ASCII(a0, #true, c2, c3, c4, c5, c6, c7)
                   && ((ASCII(a0, a1, #false, b3, b4, b5, b6, b7)
                          != ASCII(a0, a1, #true, c3, c4, c5, c6, c7))
                         && ((ASCII(a0, a1, a2, #false, b4, b5, b6, b7)
                                != ASCII(a0, a1, a2, #true, c4, c5, c6, c7))
                               && ((ASCII(a0, a1, a2, a3, #false, b5, b6, b7)
                                      != ASCII(a0, a1, a2, a3, #true, c5, c6, c7))
                                     && ((ASCII(a0, a1, a2, a3, a4, #false, b6, b7)
                                            != ASCII(a0, a1, a2, a3, a4, #true, c6, c7))
                                           && ((ASCII(a0, a1, a2, a3, a4, a5, #false, b7)
                                                  != ASCII(a0, a1, a2, a3, a4, a5, #true, c7))
                                                 && (ASCII(a0, a1, a2, a3, a4, a5, a6, #false)
                                                       != ASCII(a0, a1, a2, a3, a4, a5, a6, #true))))))))),
        REWRITE_TAC(PairList [injectivity("char")])
      ]
    )
  let ilist = append(zip(bvars)(cvars))(zip(cvars)(bvars))
  let f = o(o(o(EQF_INTRO)(INST(ilist)))(GSYM))(EQF_ELIM)
  let ASCII_NEQS_TF = map(f)(ASCII_NEQS_FT)
  // Recursive traversal needs the local definition before its first use.
  fun prefix(n):
    fun(l):
      if (n == 0)
      | PairList []
      | match l
        | PairList [h, & t]: PairList [h, & prefix((n - 1))(t)]
        | _: l
  // Recursive comparison needs the local definition before its first use.
  fun findneq(n):
    fun(prefix):
      fun(a):
        fun(b):
          match [a, b]
          | [PairList [b1, & a], PairList [b2, & b]]: (if (b1 != b2) | [n, rev(prefix), bool_of_term(b2), a, b] | findneq((n + 1))(PairList [b1, & prefix])(a)(b))
          | [_, _]: fail()
  let CHAR_DISTINCTNESS:
    fun(c1):
      fun(c2):
        let [_, a_2] = strip_comb(c1)
        let [_, b_2] = strip_comb(c2)
        let [n, p, b, s1, s2] = findneq(0)(PairList [])(a_2)(b_2)
        let ss1_2 = funpow(n)(tl)(bvars)
        let ss2_2 = funpow(n)(tl)(cvars)
        let pp = prefix(n)(avars)
        let pth = (if b | ASCII_NEQS_FT | ASCII_NEQS_TF)
        INST(append(zip(p)(pp))(append(zip(s1)(ss1_2))(zip(s2)(ss2_2))))(el(n)(pth))
  let [xtm_2, xstm_2]:
    [
      (hol: var x :: char; x),
      (hol: var xs :: list(char); xs)
    ]
  let [ytm_2, ystm_2]:
    [
      (hol: var y :: char; y),
      (hol: var ys :: list(char); ys)
    ]
  let niltm_2 = hol: const NIL :: list(char); NIL
  let NIL_EQ_THM_2 = EQT_INTRO(REFL(niltm_2))
  let [CONS_EQ_THM_2, CONS_NEQ_THM_2]:
    o(CONJ_PAIR)(prove)(
      [
        (hol:
           var x :: char
           var xs :: list(char)
           var ys :: list(char)
           var y :: char
           const CONS :: char -> list(char) -> list(char)
           (CONS(x, xs) == CONS(x, ys) <=> xs == ys)
             && ((x == y <=> #false) ==> (CONS(x, xs) == CONS(y, ys) <=> #false))),
        (REWRITE_TAC(PairList [CONS_11]) then_tac MESON_TAC(PairList []))
      ]
    )
  let [NIL_NEQ_CONS_2, CONS_NEQ_NIL_2]:
    o(CONJ_PAIR)(prove)(
      [
        (hol:
           var x :: char
           var xs :: list(char)
           const NIL :: list(char)
           const CONS :: char -> list(char) -> list(char)
           (NIL == CONS(x, xs) <=> #false) && (CONS(x, xs) == NIL <=> #false)),
        REWRITE_TAC(PairList [NOT_CONS_NIL])
      ]
    )
  // Recursive proof construction needs the local definition before its first use.
  fun STRING_DISTINCTNESS_2(s1):
    fun(s2):
      if (s1 == niltm_2)
      | if (s2 == niltm_2)
        | NIL_EQ_THM_2
        | let [c2, s2] = [rand(rator(s2)), rand(s2)]
          INST(PairList [[c2, xtm_2], [s2, xstm_2]])(NIL_NEQ_CONS_2)
      | let [c1, s1] = [rand(rator(s1)), rand(s1)]
        if (s2 == niltm_2)
        | INST(PairList [[c1, xtm_2], [s1, xstm_2]])(CONS_NEQ_NIL_2)
        | let [c2, s2] = [rand(rator(s2)), rand(s2)]
          if (c1 == c2)
          | let th1_2 = INST(PairList [[c1, xtm_2], [s1, xstm_2], [s2, ystm_2]])(CONS_EQ_THM_2)
            let th2_2 = STRING_DISTINCTNESS_2(s1)(s2)
            TRANS(th1_2)(th2_2)
          | let ilist = PairList [[c1, xtm_2], [c2, ytm_2], [s1, xstm_2], [s2, ystm_2]]
            let itm = INST(ilist)(CONS_NEQ_THM_2)
            MP(itm)(CHAR_DISTINCTNESS(c1)(c2))
  let STRING_DISTINCTNESS = STRING_DISTINCTNESS_2
  let CHAR_EQ_CONV_2:
    fun(tm):
      let [c1, c2] = dest_eq(tm)
      (if (compare(c1)(c2) == 0) | EQT_INTRO(REFL(c1)) | CHAR_DISTINCTNESS(c1)(c2))
  let STRING_EQ_CONV_2:
    fun(tm):
      let [ltm, rtm] = dest_eq(tm)
      (if (compare(ltm)(rtm) == 0) | EQT_INTRO(REFL(ltm)) | STRING_DISTINCTNESS(ltm)(rtm))
  [char_of_term, mk_char, dest_string, mk_string, CHAR_EQ_CONV_2, STRING_EQ_CONV_2]

def char_INDUCT = lists_char_INDUCT_v2

def dest_char = lists_dest_char_v2

def mk_char = lists_mk_char_v2

def dest_string = lists_dest_string_v2

def mk_string = lists_mk_string_v2

def CHAR_EQ_CONV = lists_CHAR_EQ_CONV_v2
