        PairList [
          (
            (
              (
                MAP_EVERY(X_GEN_TAC)(PairList [(hol: var x :: A; x), (hol: var y :: A; y)]) then_tac \
                DISCH_TAC
              ) then_tac \
              FIRST_X_ASSUM(
                o(MP_TAC)(
                  SPECL(
                    PairList [
                      (hol:
                         var x :: A
                         const CONS :: A -> list(A) -> list(A)
                         const NIL :: list(A)
                         CONS(x, NIL)),
                      (hol:
                         var y :: A
                         const CONS :: A -> list(A) -> list(A)
                         const NIL :: list(A)
                         CONS(y, NIL))
                    ]
                  )
                )
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [MAP, CONS_11])
          ),
          (
            (
              REPEAT(LIST_INDUCT_TAC) then_tac \
              ASM_SIMP_TAC(PairList [MAP, NOT_CONS_NIL, CONS_11])
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

