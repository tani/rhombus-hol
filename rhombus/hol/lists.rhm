def lists_LIST_INDUCT_TAC:«
  (block:«
    let port_tmp_1_list_INDUCT:«
      Up_tactics.prove((block:«
        let port_tmp_2 = Up_tactics.MATCH_ACCEPT_TAC(Up_ind_types.list_INDUCT);
        let port_tmp_3 = Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]]],[\"Const\",\"NIL\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"h\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"t\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"t\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"CONS\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]]]]]],[\"Var\",\"h\",[\"Tyvar\",\"A\"]]],[\"Var\",\"t\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]]]]]]]]]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"l\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"l\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]]]]]]]]");
        Pair(port_tmp_3,port_tmp_2)
      »))
    »;
    (block:«
      let port_tmp_4 = (block:«
        let port_tmp_5 = (block:«
          let port_tmp_6 = PairList [];
          let port_tmp_7 = (block:«
            let port_tmp_8 = Up_tactics.DISCH_TAC;
            let port_tmp_9 = Up_tactics.THEN(Up_tactics.GEN_TAC)(Up_tactics.GEN_TAC);
            let port_tmp_10 = Up_tactics.THEN;
            port_tmp_10(port_tmp_9)(port_tmp_8)
          »);
          PairList.cons(port_tmp_7,port_tmp_6)
        »);
        let port_tmp_11 = Up_tactics.ALL_TAC;
        PairList.cons(port_tmp_11,port_tmp_5)
      »);
      let port_tmp_12 = (block:«
        let port_tmp_13 = Up_tactics.CONJ_TAC;
        let port_tmp_14 = Up_tactics.MATCH_MP_TAC(port_tmp_1_list_INDUCT);
        let port_tmp_15 = Up_tactics.THEN;
        port_tmp_15(port_tmp_14)(port_tmp_13)
      »);
      let port_tmp_16 = Up_tactics.THENL;
      port_tmp_16(port_tmp_12)(port_tmp_4)
    »)
  »)
»

