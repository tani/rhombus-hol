def EX:
  new_recursive_definition(list_RECURSION)(
    Host.hol_term(And(
      Iff(
        App(
          Var("EX", Fun(Fun(Tvar("A"), Bool), Fun(Tyapp("list", [Tvar("A")]), Bool))),
          [Var("P", Fun(Tvar("A"), Bool)), Const("NIL", Tyapp("list", [Tvar("A")]))]
