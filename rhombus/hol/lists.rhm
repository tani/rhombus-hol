def INJECTIVE_MAP:
  prove(
    [
      (hol:
         const MAP :: (A -> B) -> list(A) -> list(B)
         forall f :: A -> B:
           (forall (l :: list(A), m :: list(A)): MAP(f, l) == MAP(f, m) ==> l == m)
             <=> (forall (x :: A, y :: A): f(x) == f(y) ==> x == y)),
