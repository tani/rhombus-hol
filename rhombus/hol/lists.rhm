    ]
  )

def MEM_APPEND:
  prove(
    [
      (hol:
         const MEM :: A -> list(A) -> bool
         const APPEND :: list(A) -> list(A) -> list(A)
         forall (x :: A, l1 :: list(A), l2 :: list(A)):
           MEM(x, APPEND(l1, l2)) <=> MEM(x, l1) || MEM(x, l2)),
      (
        (GEN_TAC then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [MEM, APPEND, DISJ_ACI])
