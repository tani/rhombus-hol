                    [
                      App(
                        Const("CONS", Fun(Tvar("A"), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))),
                        [Var("h", Tvar("A")), Var("t", Tyapp("list", [Tvar("A")]))]
                      )
                    ]
                  ),
                  Var("l", Tyapp("list", [Tvar("A")]))
                ]
              ),
              App(
                Const(
                  "APPEND",
                  Fun(Tyapp("list", [Tvar("A")]), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))
                ),
                [
                  App(
                    Const("REVERSE", Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")]))),
                    [Var("t", Tyapp("list", [Tvar("A")]))]
                  ),
                  App(
                    Const("CONS", Fun(Tvar("A"), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))),
                    [Var("h", Tvar("A")), Var("l", Tyapp("list", [Tvar("A")]))]
                  )
                ]
              )
            )
          )
        )),
        SIMP_TAC(PairList [APPEND, APPEND_NIL, REVERSE, GSYM(APPEND_ASSOC)])
      ]
    )
  let pths_4 = map(UNDISCH_ALL)(CONJUNCTS(pthc))
  let avars_4 = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Const("REVERSE",_),ltm):
        let tyin = PairList [[hd(snd(dest_type(type_of(ltm)))), aty]]
        let PairList [h_tm_4, & PairList [l_tm_2, & PairList [t_tm_4, & PairList []]]] = map(inst(tyin))(avars_4)
        let PairList [pth_init_3, & PairList [pth_base_4, & PairList [pth_step_4, & PairList []]]] = map(INST_TYPE(tyin))(pths_4)
        fun conv_3(th):
          let [ahtm, ltm] = dest_comb(rand(concl(th)))
          let httm = rand(rand(ahtm))
          if is_cons(httm)
          | let [htm, ttm] = dest_cons(httm)
            let th1 = INST(PairList [[htm, h_tm_4], [ltm, l_tm_2], [ttm, t_tm_4]])(pth_step_4)
            conv_3(TRANS(th)(th1))
          | TRANS(th)(INST(PairList [[ltm, l_tm_2]])(pth_base_4))
        try:
          conv_3(INST(PairList [[tm, l_tm_2]])(pth_init_3))
          ~catch exn:
            match exn
            | Failure(_): failwith("REVERSE_CONV")
            | exn: (throw exn)
    | _: failwith("REVERSE_CONV")

def LIST_OF_SEQ_CONV:
  let pthc:
    prove(
      [
