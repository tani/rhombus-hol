def LIST_EQ:
  prove(
    [
      Host.hol_term(Forall(
        "l1",
        Tyapp("list", [Tvar("A")]),
        Forall(
          "l2",
          Tyapp("list", [Tvar("A")]),
          Iff(
            Eq(Tyapp("list", [Tvar("A")]), Ref("l1"), Ref("l2")),
            And(
              Eq(
                Num,
                App(Const("LENGTH", Fun(Tyapp("list", [Tvar("A")]), Num)), [Ref("l1")]),
                App(Const("LENGTH", Fun(Tyapp("list", [Tvar("A")]), Num)), [Ref("l2")])
              ),
              Forall(
                "n",
                Num,
                Implies(
                  App(
                    Const("<", Fun(Num, Fun(Num, Bool))),
                    [Ref("n"), App(Const("LENGTH", Fun(Tyapp("list", [Tvar("A")]), Num)), [Ref("l2")])]
                  ),
                  Eq(
                    Tvar("A"),
                    App(Const("EL", Fun(Num, Fun(Tyapp("list", [Tvar("A")]), Tvar("A")))), [Ref("n"), Ref("l1")]),
                    App(Const("EL", Fun(Num, Fun(Tyapp("list", [Tvar("A")]), Tvar("A")))), [Ref("n"), Ref("l2")])
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              REPEAT(LIST_INDUCT_TAC) then_tac \
              REWRITE_TAC(PairList [NOT_CONS_NIL, CONS_11, LENGTH, CONJUNCT1(LT), NOT_SUC])
            ) then_tac \
            ASM_REWRITE_TAC(PairList [SUC_INJ])
          ) then_tac \
          GEN_REWRITE_TAC(o(RAND_CONV)(RAND_CONV))(
            PairList [
              MESON(
                PairList [num_CASES])(
                Host.hol_term(Iff(
                  Forall("n", Num, App(Var("P", Fun(Num, Bool)), [Ref("n")])),
                  And(
