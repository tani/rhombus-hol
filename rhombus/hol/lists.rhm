fun LIST_CONV(conv):
  fun(tm):
    if Basics.is_cons(tm)
    | Equal.COMB2_CONV(Equal.RAND_CONV(conv))(LIST_CONV(conv))(tm)
    | (if Host.hol_equal(fst(Fusion.dest_const(tm)))("NIL") | Fusion.REFL(tm) | failwith("LIST_CONV"))

def LENGTH_CONV:
  let pthc = Tactics.prove([Host.hol_term(Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Comb(Const("LENGTH", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("num", [])])), Var("t", Tyapp("list", [Tyvar("A")])))), Comb(Comb(Const("+", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])])), Comb(Const("LENGTH", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("num", [])])), Var("t", Tyapp("list", [Tyvar("A")])))), Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Const("_0", Tyapp("num", [])))))), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Comb(Comb(Const("+", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])])), Comb(Const("LENGTH", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("num", [])])), Const("NIL", Tyapp("list", [Tyvar("A")])))), Var("n", Tyapp("num", [])))), Var("n", Tyapp("num", [])))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Comb(Comb(Const("+", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])])), Comb(Const("LENGTH", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("num", [])])), Comb(Comb(Const("CONS", Tyapp("fun", [Tyvar("A"), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Var("h", Tyvar("A"))), Var("t", Tyapp("list", [Tyvar("A")]))))), Var("n", Tyapp("num", [])))), Comb(Comb(Const("+", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])])), Comb(Const("LENGTH", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("num", [])])), Var("t", Tyapp("list", [Tyvar("A")])))), Comb(Const("SUC", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Var("n", Tyapp("num", [])))))))), Simp.REWRITE_TAC(PairList.cons(LENGTH, PairList.cons(Arith.ADD_CLAUSES, PairList [])))])
  let pths_2 = Bool.CONJUNCTS(pthc)
  let avars_2 = sort(Host.hol_lt)(Fusion.frees(Fusion.concl(pthc)))
  fun(tm):
    match tm
    | Fusion.Comb(Fusion.Const("LENGTH",_),ltm):
        if Basics.is_list(ltm)
        | let tyin = PairList.cons([hd(snd(Fusion.dest_type(Fusion.type_of(ltm)))), Fusion.aty], PairList [])
          let PairList [h_tm_2, & PairList [n_tm_2, & PairList [t_tm_2, & PairList []]]] = map(Fusion.inst(tyin))(avars_2)
          let PairList [pth_init_2, & PairList [pth_base_2, & PairList [pth_step_2, & PairList []]]] = map(Fusion.INST_TYPE(tyin))(pths_2)
          fun conv(th):
            let [altm, ntm] = Fusion.dest_comb(Fusion.rand(Fusion.concl(th)))
            let ltm = Fusion.rand(Fusion.rand(altm))
            if Basics.is_cons(ltm)
            | let [htm, ttm] = Basics.dest_cons(ltm)
              let th1 = Fusion.INST(PairList.cons([htm, h_tm_2], PairList.cons([ttm, t_tm_2], PairList.cons([ntm, n_tm_2], PairList []))))(pth_step_2)
              let [ftm, stm] = Fusion.dest_comb(Fusion.rand(Fusion.concl(th1)))
              let th2 = Fusion.TRANS(th1)(Equal.AP_TERM(ftm)(CalcNum.NUM_SUC_CONV(stm)))
              conv(Fusion.TRANS(th)(th2))
            | Fusion.TRANS(th)(Fusion.INST(PairList.cons([ntm, n_tm_2], PairList []))(pth_base_2))
          try:
            conv(Fusion.INST(PairList.cons([Fusion.rand(tm), t_tm_2], PairList []))(pth_init_2))
            ~catch exn:
              match exn
              | Failure(_): failwith("LENGTH_CONV")
              | exn: Host.hol_raise(exn)
        | match tm
          | _: failwith("LENGTH_CONV")
    | _: failwith("LENGTH_CONV")

def EL_CONV:
  let pthc = Tactics.prove([Host.hol_term(Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyvar("A"), Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])])])), Comb(Comb(Const("EL", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyvar("A")])])), Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Const("_0", Tyapp("num", [])))), Comb(Comb(Const("CONS", Tyapp("fun", [Tyvar("A"), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Var("h", Tyvar("A"))), Var("t", Tyapp("list", [Tyvar("A")]))))), Var("h", Tyvar("A")))), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Var("n", Tyapp("num", []))), Comb(Const("SUC", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Var("m", Tyapp("num", []))))), Comb(Comb(Const("=", Tyapp("fun", [Tyvar("A"), Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])])])), Comb(Comb(Const("EL", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyvar("A")])])), Var("n", Tyapp("num", []))), Comb(Comb(Const("CONS", Tyapp("fun", [Tyvar("A"), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Var("h", Tyvar("A"))), Var("t", Tyapp("list", [Tyvar("A")]))))), Comb(Comb(Const("EL", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyvar("A")])])), Var("m", Tyapp("num", []))), Var("t", Tyapp("list", [Tyvar("A")]))))))), Simp.SIMP_TAC(PairList.cons(EL, PairList.cons(HD, PairList.cons(TL, PairList []))))])
  let pths_3 = map(Bool.UNDISCH_ALL)(Bool.CONJUNCTS(pthc))
  let avars_3 = sort(Host.hol_lt)(Fusion.frees(Fusion.concl(pthc)))
  fun(tm):
    match tm
    | Fusion.Comb(Fusion.Comb(Fusion.Const("EL",_),ntm),ltm):
        if Basics.is_list(ltm)
        | let tyin = PairList.cons([hd(snd(Fusion.dest_type(Fusion.type_of(ltm)))), Fusion.aty], PairList [])
          let PairList [h_tm_3, & PairList [m_tm_2, & PairList [n_tm_3, & PairList [t_tm_3, & PairList []]]]] = map(Fusion.inst(tyin))(avars_3)
          let PairList [pth_base_3, & PairList [pth_step_3, & PairList []]] = map(Fusion.INST_TYPE(tyin))(pths_3)
          fun conv_2(th):
            let [entm, ltm] = Fusion.dest_comb(Fusion.rand(Fusion.concl(th)))
            let [htm, ttm] = Basics.dest_cons(ltm)
            let [etm, ntm] = Fusion.dest_comb(entm)
            let n = Basics.dest_numeral(ntm)
            if Host.hol_equal(n)(Host.num_0)
            | Fusion.TRANS(th)(Fusion.INST(PairList.cons([htm, h_tm_3], PairList.cons([ttm, t_tm_3], PairList [])))(pth_base_3))
            | let th1 = CalcNum.num_CONV(ntm)
              let th2 = Fusion.INST(PairList.cons([ntm, n_tm_3], PairList.cons([Fusion.rand(Fusion.rand(Fusion.concl(th1))), m_tm_2], PairList.cons([htm, h_tm_3], PairList.cons([ttm, t_tm_3], PairList [])))))(pth_step_3)
              let th3 = Fusion.TRANS(th)(Bool.PROVE_HYP(th1)(th2))
              conv_2(th3)
          try:
            conv_2(Fusion.REFL(tm))
            ~catch exn:
              match exn
              | Failure(_): failwith("EL_CONV")
              | exn: Host.hol_raise(exn)
        | match tm
          | _: failwith("EL_CONV")
    | _: failwith("EL_CONV")

def REVERSE_CONV:
  let pthc = Tactics.prove([Host.hol_term(Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("bool", [])])])), Var("l", Tyapp("list", [Tyvar("A")]))), Comb(Comb(Const("APPEND", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Var("l", Tyapp("list", [Tyvar("A")]))), Const("NIL", Tyapp("list", [Tyvar("A")]))))), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("bool", [])])])), Comb(Comb(Const("APPEND", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Comb(Const("REVERSE", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])), Const("NIL", Tyapp("list", [Tyvar("A")])))), Var("l", Tyapp("list", [Tyvar("A")])))), Var("l", Tyapp("list", [Tyvar("A")])))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("bool", [])])])), Comb(Comb(Const("APPEND", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Comb(Const("REVERSE", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])), Comb(Comb(Const("CONS", Tyapp("fun", [Tyvar("A"), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Var("h", Tyvar("A"))), Var("t", Tyapp("list", [Tyvar("A")]))))), Var("l", Tyapp("list", [Tyvar("A")])))), Comb(Comb(Const("APPEND", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Comb(Const("REVERSE", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])), Var("t", Tyapp("list", [Tyvar("A")])))), Comb(Comb(Const("CONS", Tyapp("fun", [Tyvar("A"), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Var("h", Tyvar("A"))), Var("l", Tyapp("list", [Tyvar("A")])))))))), Simp.SIMP_TAC(PairList.cons(APPEND, PairList.cons(APPEND_NIL, PairList.cons(REVERSE, PairList.cons(Equal.GSYM(APPEND_ASSOC), PairList [])))))])
  let pths_4 = map(Bool.UNDISCH_ALL)(Bool.CONJUNCTS(pthc))
  let avars_4 = sort(Host.hol_lt)(Fusion.frees(Fusion.concl(pthc)))
  fun(tm):
    match tm
    | Fusion.Comb(Fusion.Const("REVERSE",_),ltm):
        let tyin = PairList.cons([hd(snd(Fusion.dest_type(Fusion.type_of(ltm)))), Fusion.aty], PairList [])
        let PairList [h_tm_4, & PairList [l_tm_2, & PairList [t_tm_4, & PairList []]]] = map(Fusion.inst(tyin))(avars_4)
        let PairList [pth_init_3, & PairList [pth_base_4, & PairList [pth_step_4, & PairList []]]] = map(Fusion.INST_TYPE(tyin))(pths_4)
        fun conv_3(th):
          let [ahtm, ltm] = Fusion.dest_comb(Fusion.rand(Fusion.concl(th)))
          let httm = Fusion.rand(Fusion.rand(ahtm))
          if Basics.is_cons(httm)
          | let [htm, ttm] = Basics.dest_cons(httm)
            let th1 = Fusion.INST(PairList.cons([htm, h_tm_4], PairList.cons([ltm, l_tm_2], PairList.cons([ttm, t_tm_4], PairList []))))(pth_step_4)
            conv_3(Fusion.TRANS(th)(th1))
          | Fusion.TRANS(th)(Fusion.INST(PairList.cons([ltm, l_tm_2], PairList []))(pth_base_4))
        try:
          conv_3(Fusion.INST(PairList.cons([tm, l_tm_2], PairList []))(pth_init_3))
          ~catch exn:
            match exn
            | Failure(_): failwith("REVERSE_CONV")
            | exn: Host.hol_raise(exn)
    | _: failwith("REVERSE_CONV")

def LIST_OF_SEQ_CONV:
  let pthc = Tactics.prove([Host.hol_term(Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("bool", [])])])), Var("l", Tyapp("list", [Tyvar("A")]))), Comb(Comb(Const("APPEND", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Var("l", Tyapp("list", [Tyvar("A")]))), Const("NIL", Tyapp("list", [Tyvar("A")]))))), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("bool", [])])])), Comb(Comb(Const("APPEND", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Comb(Comb(Const("list_of_seq", Tyapp("fun", [Tyapp("fun", [Tyapp("num", []), Tyvar("A")]), Tyapp("fun", [Tyapp("num", []), Tyapp("list", [Tyvar("A")])])])), Var("f", Tyapp("fun", [Tyapp("num", []), Tyvar("A")]))), Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Const("_0", Tyapp("num", []))))), Var("l", Tyapp("list", [Tyvar("A")])))), Var("l", Tyapp("list", [Tyvar("A")])))), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Var("n", Tyapp("num", []))), Comb(Const("SUC", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Var("m", Tyapp("num", []))))), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("bool", [])])])), Comb(Comb(Const("APPEND", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Comb(Comb(Const("list_of_seq", Tyapp("fun", [Tyapp("fun", [Tyapp("num", []), Tyvar("A")]), Tyapp("fun", [Tyapp("num", []), Tyapp("list", [Tyvar("A")])])])), Var("f", Tyapp("fun", [Tyapp("num", []), Tyvar("A")]))), Var("n", Tyapp("num", [])))), Var("l", Tyapp("list", [Tyvar("A")])))), Comb(Comb(Const("APPEND", Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Comb(Comb(Const("list_of_seq", Tyapp("fun", [Tyapp("fun", [Tyapp("num", []), Tyvar("A")]), Tyapp("fun", [Tyapp("num", []), Tyapp("list", [Tyvar("A")])])])), Var("f", Tyapp("fun", [Tyapp("num", []), Tyvar("A")]))), Var("m", Tyapp("num", [])))), Comb(Comb(Const("CONS", Tyapp("fun", [Tyvar("A"), Tyapp("fun", [Tyapp("list", [Tyvar("A")]), Tyapp("list", [Tyvar("A")])])])), Comb(Var("f", Tyapp("fun", [Tyapp("num", []), Tyvar("A")])), Var("m", Tyapp("num", [])))), Var("l", Tyapp("list", [Tyvar("A")]))))))))), Simp.SIMP_TAC(PairList.cons(APPEND, PairList.cons(APPEND_NIL, PairList.cons(list_of_seq, PairList.cons(Equal.GSYM(APPEND_ASSOC), PairList [])))))])
  let pths_5 = map(Bool.UNDISCH_ALL)(Bool.CONJUNCTS(pthc))
  let avars_5 = sort(Host.hol_lt)(Fusion.frees(Fusion.concl(pthc)))
  fun(tm):
    match tm
    | Fusion.Comb(Fusion.Comb(Fusion.Const("list_of_seq",_),ftm),ntm):
        let tyin = PairList.cons([snd(Basics.dest_fun_ty(Fusion.type_of(ftm))), Fusion.aty], PairList [])
        let PairList [f_tm_2, & PairList [l_tm_3, & PairList [m_tm_3, & PairList [n_tm_4, & PairList []]]]] = map(Fusion.inst(tyin))(avars_5)
        let PairList [pth_init_4, & PairList [pth_base_5, & PairList [pth_step_5, & PairList []]]] = map(Fusion.INST_TYPE(tyin))(pths_5)
        let bflag_2 = Fusion.is_abs(ftm)
        fun conv_4(th):
          let [nftm, ltm] = Fusion.dest_comb(Fusion.rand(Fusion.concl(th)))
          let [lftm, ntm] = Fusion.dest_comb(Fusion.rand(nftm))
          let ftm = Fusion.rand(lftm)
          let n = Basics.dest_numeral(ntm)
          if Host.hol_equal(n)(Host.num_0)
          | Fusion.TRANS(th)(Fusion.INST(PairList.cons([ftm, f_tm_2], PairList.cons([ltm, l_tm_3], PairList [])))(pth_base_5))
          | let th1 = CalcNum.num_CONV(ntm)
            let th2 = Fusion.INST(PairList.cons([ntm, n_tm_4], PairList.cons([Fusion.rand(Fusion.rand(Fusion.concl(th1))), m_tm_3], PairList.cons([ftm, f_tm_2], PairList.cons([ltm, l_tm_3], PairList [])))))(pth_step_5)
            let th3 = Fusion.TRANS(th)(Bool.PROVE_HYP(th1)(th2))
            let th4:
              if Host.hol_not(bflag_2)
              | th3
              | let [jtm, ctxtm] = Fusion.dest_comb(Fusion.rand(Fusion.concl(th3)))
                let [cttm, xtm] = Fusion.dest_comb(ctxtm)
                let [ctm, ttm] = Fusion.dest_comb(cttm)
                Fusion.TRANS(th3)(Equal.AP_TERM(jtm)(Equal.AP_THM(Equal.AP_TERM(ctm)(Equal.BETA_CONV(ttm)))(xtm)))
            conv_4(th4)
        try:
          conv_4(Fusion.INST(PairList.cons([tm, l_tm_3], PairList []))(pth_init_4))
          ~catch exn:
            match exn
            | Failure(_): failwith("LIST_OF_SEQ_CONV")
            | exn: Host.hol_raise(exn)
    | _: failwith("LIST_OF_SEQ_CONV")

def [char_INDUCT, char_RECURSION] = IndTypes.define_type("char = ASCII bool bool bool bool bool bool bool bool")

TypeInference.new_type_abbrev(["string", Host.hol_term(Tyapp("list", [Tyapp("char", [])]))])

def [dest_char, mk_char, dest_string, mk_string, CHAR_EQ_CONV, STRING_EQ_CONV]:
  let bool_of_term:
    fun(t):
      match t
      | Fusion.Const("T",_): #true
      | Fusion.Const("F",_): #false
      | _: failwith("bool_of_term")
  let code_of_term:
    fun(t):
      let [f, tms] = Basics.strip_comb(t)
      if (Host.hol_not((Fusion.is_const(f) && Host.hol_equal(fst(Fusion.dest_const(f)))("ASCII"))) || Host.hol_not(Host.hol_equal(length(tms))(8)))
      | failwith("code_of_term")
      | itlist((fun(b): (fun(f): (if b | Host.hol_add(1)(Host.hol_mul(2)(f)) | Host.hol_mul(2)(f)))))(map(bool_of_term)(Host.rev(tms)))(0)
  let char_of_term = o(Host.hol_char_chr)(code_of_term)
  let dest_string:
    fun(tm):
      try:
        let tms = Basics.dest_list(tm)
        if Host.hol_unequal(fst(Fusion.dest_type(hd(snd(Fusion.dest_type(Fusion.type_of(tm)))))))("char")
        | Host.hol_apply_unit(fail)
        | let ccs = map(o(Host.hol_string_make(1))(char_of_term))(tms)
          Host.hol_string_escaped(implode(ccs))
        ~catch exn:
          match exn
          | Failure(_): failwith("dest_string")
          | exn: Host.hol_raise(exn)
  let mk_bool:
    fun(b):
      let [true_tm, false_tm] = [Host.hol_term(Const("T", Tyapp("bool", []))), Host.hol_term(Const("F", Tyapp("bool", [])))]
      (if b | true_tm | false_tm)
  let ascii_tm = Host.hol_term(Const("ASCII", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("char", [])])])])])])])])])))
  let mk_code:
    fun(c):
      let lis = map((fun(i): mk_bool(Host.hol_equal(Host.hol_mod(Host.hol_div(c)(Host.hol_lsl(1)(i)))(2))(1))))(Host.hol_range(0)(7))
      itlist((fun(x): (fun(y): Fusion.mk_comb([y, x]))))(lis)(ascii_tm)
  let codes = Host.hol_array_map(mk_code)(Host.hol_array_of_list(Host.hol_range(0)(255)))
  let mk_code = (fun(c): Host.hol_array_get(codes)(c))
  let mk_char = o(mk_code)(Host.hol_char_code)
  let mk_string:
    fun(s):
      let ns = map((fun(i): Host.hol_char_code(Host.hol_string_get(s)(i))))(Host.hol_range(0)(Host.hol_sub(Host.hol_string_length(s))(1)))
      mk_list([map(mk_code)(ns), Host.hol_term(Tyapp("char", []))])
