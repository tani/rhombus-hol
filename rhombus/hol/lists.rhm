def LIST_INDUCT_TAC:
  let list_INDUCT:
    prove(
      [
        Host.hol_term(Forall(
          "P",
          Fun(Tyapp("list", [Tvar("A")]), Bool),
          Implies(
            And(
              App(Ref("P"), [Const("NIL", Tyapp("list", [Tvar("A")]))]),
              Forall(
                "h",
                Tvar("A"),
                Forall(
                  "t",
                  Tyapp("list", [Tvar("A")]),
                  Implies(
                    App(Ref("P"), [Ref("t")]),
                    App(
                      Ref("P"),
                      [
                        App(
                          Const("CONS", Fun(Tvar("A"), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))),
                          [Ref("h"), Ref("t")]
                        )
                      ]
                    )
                  )
                )
              )
            ),
            Forall("l", Tyapp("list", [Tvar("A")]), App(Ref("P"), [Ref("l")]))
          )
        )),
        MATCH_ACCEPT_TAC(IndTypes.list_INDUCT)
      ]
    )
  (
    (MATCH_MP_TAC(list_INDUCT) then_tac CONJ_TAC) then_list \
    PairList [
      ALL_TAC,
      ((GEN_TAC then_tac GEN_TAC) then_tac DISCH_TAC)
    ]
  )

