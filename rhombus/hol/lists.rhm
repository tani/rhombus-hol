            Eq(
              Tyapp("list", [Tyapp("char", [])]),
              Var("xs", Tyapp("list", [Tyapp("char", [])])),
              Var("ys", Tyapp("list", [Tyapp("char", [])]))
            )
          ),
          Implies(
            Iff(Eq(Tyapp("char", []), Var("x", Tyapp("char", [])), Var("y", Tyapp("char", []))), False),
            Iff(
              Eq(
                Tyapp("list", [Tyapp("char", [])]),
                App(
                  Const(
                    "CONS",
                    Fun(
                      Tyapp("char", []),
                      Fun(Tyapp("list", [Tyapp("char", [])]), Tyapp("list", [Tyapp("char", [])]))
                    )
                  ),
                  [Var("x", Tyapp("char", [])), Var("xs", Tyapp("list", [Tyapp("char", [])]))]
                ),
                App(
                  Const(
                    "CONS",
                    Fun(
                      Tyapp("char", []),
                      Fun(Tyapp("list", [Tyapp("char", [])]), Tyapp("list", [Tyapp("char", [])]))
                    )
                  ),
                  [Var("y", Tyapp("char", [])), Var("ys", Tyapp("list", [Tyapp("char", [])]))]
                )
              ),
              False
            )
          )
        )),
        (REWRITE_TAC(PairList [CONS_11]) then_tac MESON_TAC(PairList []))
      ]
    )
  let [NIL_NEQ_CONS_2, CONS_NEQ_NIL_2]:
    o(CONJ_PAIR)(prove)(
      [
        Host.hol_term(And(
          Iff(
            Eq(
              Tyapp("list", [Tyapp("char", [])]),
              Const("NIL", Tyapp("list", [Tyapp("char", [])])),
              App(
                Const(
                  "CONS",
                  Fun(
                    Tyapp("char", []),
                    Fun(Tyapp("list", [Tyapp("char", [])]), Tyapp("list", [Tyapp("char", [])]))
                  )
                ),
                [Var("x", Tyapp("char", [])), Var("xs", Tyapp("list", [Tyapp("char", [])]))]
              )
            ),
            False
          ),
          Iff(
            Eq(
              Tyapp("list", [Tyapp("char", [])]),
              App(
                Const(
                  "CONS",
                  Fun(
                    Tyapp("char", []),
                    Fun(Tyapp("list", [Tyapp("char", [])]), Tyapp("list", [Tyapp("char", [])]))
                  )
                ),
                [Var("x", Tyapp("char", [])), Var("xs", Tyapp("list", [Tyapp("char", [])]))]
              ),
              Const("NIL", Tyapp("list", [Tyapp("char", [])]))
            ),
            False
          )
        )),
        REWRITE_TAC(PairList [NOT_CONS_NIL])
      ]
    )
  // Recursive proof construction needs the local definition before its first use.
  fun STRING_DISTINCTNESS_2(s1):
    fun(s2):
      if (s1 == niltm_2)
      | if (s2 == niltm_2)
        | NIL_EQ_THM_2
        | let [c2, s2] = [rand(rator(s2)), rand(s2)]
          INST(PairList [[c2, xtm_2], [s2, xstm_2]])(NIL_NEQ_CONS_2)
      | let [c1, s1] = [rand(rator(s1)), rand(s1)]
        if (s2 == niltm_2)
        | INST(PairList [[c1, xtm_2], [s1, xstm_2]])(CONS_NEQ_NIL_2)
        | let [c2, s2] = [rand(rator(s2)), rand(s2)]
          if (c1 == c2)
          | let th1_2 = INST(PairList [[c1, xtm_2], [s1, xstm_2], [s2, ystm_2]])(CONS_EQ_THM_2)
            let th2_2 = STRING_DISTINCTNESS_2(s1)(s2)
            TRANS(th1_2)(th2_2)
          | let ilist = PairList [[c1, xtm_2], [c2, ytm_2], [s1, xstm_2], [s2, ystm_2]]
            let itm = INST(ilist)(CONS_NEQ_THM_2)
            MP(itm)(CHAR_DISTINCTNESS(c1)(c2))
  let STRING_DISTINCTNESS = STRING_DISTINCTNESS_2
  let CHAR_EQ_CONV_2:
    fun(tm):
      let [c1, c2] = dest_eq(tm)
      (if (Host.hol_compare(c1)(c2) == 0) | EQT_INTRO(REFL(c1)) | CHAR_DISTINCTNESS(c1)(c2))
  let STRING_EQ_CONV_2:
    fun(tm):
      let [ltm, rtm] = dest_eq(tm)
      (if (Host.hol_compare(ltm)(rtm) == 0) | EQT_INTRO(REFL(ltm)) | STRING_DISTINCTNESS(ltm)(rtm))
  [char_of_term, mk_char, dest_string, mk_string, CHAR_EQ_CONV_2, STRING_EQ_CONV_2]

