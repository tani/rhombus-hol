                Fun(Tyapp("list", [Tvar("A")]), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))
              ),
              [Var("l", Tyapp("list", [Tvar("A")])), Const("NIL", Tyapp("list", [Tvar("A")]))]
            )
          ),
          And(
            Eq(
              Tyapp("list", [Tvar("A")]),
              App(
                Const(
                  "APPEND",
                  Fun(Tyapp("list", [Tvar("A")]), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))
                ),
                [
                  App(
                    Const("list_of_seq", Fun(Fun(Num, Tvar("A")), Fun(Num, Tyapp("list", [Tvar("A")])))),
                    [Var("f", Fun(Num, Tvar("A"))), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  ),
                  Var("l", Tyapp("list", [Tvar("A")]))
                ]
              ),
              Var("l", Tyapp("list", [Tvar("A")]))
            ),
            Implies(
              Eq(Num, Var("n", Num), App(Const("SUC", Fun(Num, Num)), [Var("m", Num)])),
              Eq(
                Tyapp("list", [Tvar("A")]),
                App(
                  Const(
                    "APPEND",
                    Fun(Tyapp("list", [Tvar("A")]), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))
                  ),
                  [
                    App(
                      Const("list_of_seq", Fun(Fun(Num, Tvar("A")), Fun(Num, Tyapp("list", [Tvar("A")])))),
                      [Var("f", Fun(Num, Tvar("A"))), Var("n", Num)]
                    ),
                    Var("l", Tyapp("list", [Tvar("A")]))
                  ]
                ),
                App(
                  Const(
                    "APPEND",
                    Fun(Tyapp("list", [Tvar("A")]), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))
                  ),
                  [
                    App(
                      Const("list_of_seq", Fun(Fun(Num, Tvar("A")), Fun(Num, Tyapp("list", [Tvar("A")])))),
                      [Var("f", Fun(Num, Tvar("A"))), Var("m", Num)]
                    ),
                    App(
                      Const("CONS", Fun(Tvar("A"), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))),
                      [App(Var("f", Fun(Num, Tvar("A"))), [Var("m", Num)]), Var("l", Tyapp("list", [Tvar("A")]))]
                    )
                  ]
                )
              )
            )
          )
        )),
        SIMP_TAC(PairList [APPEND, APPEND_NIL, list_of_seq, GSYM(APPEND_ASSOC)])
      ]
    )
  let pths_5 = map(UNDISCH_ALL)(CONJUNCTS(pthc))
  let avars_5 = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Comb(Const("list_of_seq",_),ftm),ntm):
        let tyin = PairList [[snd(dest_fun_ty(type_of(ftm))), aty]]
        let PairList [f_tm_2, & PairList [l_tm_3, & PairList [m_tm_3, & PairList [n_tm_4, & PairList []]]]] = map(inst(tyin))(avars_5)
        let PairList [pth_init_4, & PairList [pth_base_5, & PairList [pth_step_5, & PairList []]]] = map(INST_TYPE(tyin))(pths_5)
        let bflag_2 = is_abs(ftm)
        fun conv_4(th):
          let [nftm, ltm] = dest_comb(rand(concl(th)))
          let [lftm, ntm] = dest_comb(rand(nftm))
          let ftm = rand(lftm)
          let n = dest_numeral(ntm)
          if (n == Host.num_0)
          | TRANS(th)(INST(PairList [[ftm, f_tm_2], [ltm, l_tm_3]])(pth_base_5))
          | let th1 = num_CONV(ntm)
            let th2:
              INST(
                PairList [
                  [ntm, n_tm_4],
                  [rand(rand(concl(th1))), m_tm_3],
                  [ftm, f_tm_2],
                  [ltm, l_tm_3]
                ]
              )(pth_step_5)
            let th3 = TRANS(th)(PROVE_HYP(th1)(th2))
            let th4:
              if !bflag_2
              | th3
              | let [jtm, ctxtm] = dest_comb(rand(concl(th3)))
                let [cttm, xtm] = dest_comb(ctxtm)
                let [ctm, ttm] = dest_comb(cttm)
                TRANS(th3)(AP_TERM(jtm)(AP_THM(AP_TERM(ctm)(BETA_CONV(ttm)))(xtm)))
            conv_4(th4)
        try:
          conv_4(INST(PairList [[tm, l_tm_3]])(pth_init_4))
          ~catch exn:
            match exn
            | Failure(_): failwith("LIST_OF_SEQ_CONV")
            | exn: (throw exn)
    | _: failwith("LIST_OF_SEQ_CONV")

