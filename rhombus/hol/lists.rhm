def lists_LIST_INDUCT_TAC:«
  (block:«
    let list_INDUCT:«
      Up_tactics.prove(Pair(Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]]],[\"Const\",\"NIL\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"h\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"t\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"t\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"CONS\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]]]]]],[\"Var\",\"h\",[\"Tyvar\",\"A\"]]],[\"Var\",\"t\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]]]]]]]]]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"l\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"l\",[\"Tyapp\",\"list\",[[\"Tyvar\",\"A\"]]]]]]]]]]"),Up_tactics.MATCH_ACCEPT_TAC(Up_ind_types.list_INDUCT)))
    »;
    (block:«
      let port_tmp_1 = PairList.cons(Up_tactics.ALL_TAC,PairList.cons(Up_tactics.THEN(Up_tactics.THEN(Up_tactics.GEN_TAC)(Up_tactics.GEN_TAC))(Up_tactics.DISCH_TAC),PairList []));
      let port_tmp_2 = Up_tactics.THEN(Up_tactics.MATCH_MP_TAC(list_INDUCT))(Up_tactics.CONJ_TAC);
      Up_tactics.THENL(port_tmp_2)(port_tmp_1)
    »)
  »)
»

