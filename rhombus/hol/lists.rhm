def LIST_INDUCT_TAC:
  let list_INDUCT:
    prove(
      [
        (hol:
           const NIL :: list(A)
           const CONS :: A -> list(A) -> list(A)
           forall P :: list(A) -> bool:
             P(NIL) && (forall (h :: A, t :: list(A)): P(t) ==> P(CONS(h, t)))
               ==> (forall l :: list(A): P(l))),
        MATCH_ACCEPT_TAC(IndTypes.list_INDUCT)
      ]
    )
  (
    (MATCH_MP_TAC(list_INDUCT) then_tac CONJ_TAC) then_list \
    PairList [
      ALL_TAC,
      ((GEN_TAC then_tac GEN_TAC) then_tac DISCH_TAC)
    ]
  )

def HD:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var HD :: list(A) -> A
       var h :: A
       var t :: list(A)
       const CONS :: A -> list(A) -> list(A)
       HD(CONS(h, t)) == h)
  )

def TL:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var TL :: list(A) -> list(A)
       var h :: A
       var t :: list(A)
       const CONS :: A -> list(A) -> list(A)
       TL(CONS(h, t)) == t)
  )

def APPEND:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var APPEND :: list(A) -> list(A) -> list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       (forall l :: list(A): APPEND(NIL, l) == l)
         && (forall (h :: A, t :: list(A), l :: list(A)):
               APPEND(CONS(h, t), l) == CONS(h, APPEND(t, l))))
  )

def REVERSE:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var REVERSE :: list(A) -> list(A)
       var x :: A
       var l :: list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       const APPEND :: list(A) -> list(A) -> list(A)
       REVERSE(NIL) == NIL && REVERSE(CONS(x, l)) == APPEND(REVERSE(l), CONS(x, NIL)))
  )

def LENGTH:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var LENGTH :: list(A) -> num
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       const SUC :: num -> num
       LENGTH(NIL) == (0 :: num)
         && (forall (h :: A, t :: list(A)): LENGTH(CONS(h, t)) == SUC(LENGTH(t))))
  )

def MAP:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var MAP :: (A -> B) -> list(A) -> list(B)
       const NIL :: list(A)
       const NIL_2 as NIL :: list(B)
       const CONS :: A -> list(A) -> list(A)
       const CONS_2 as CONS :: B -> list(B) -> list(B)
       (forall f :: A -> B: MAP(f, NIL) == NIL_2)
         && (forall (f :: A -> B, h :: A, t :: list(A)): MAP(f, CONS(h, t)) == CONS_2(f(h), MAP(f, t))))
  )

def LAST:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var LAST :: list(A) -> A
       var h :: A
       var t :: list(A)
       const CONS :: A -> list(A) -> list(A)
       const NIL :: list(A)
       LAST(CONS(h, t)) == (if t == NIL | h | LAST(t)))
  )

def BUTLAST:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var BUTLAST :: list(A) -> list(A)
       var h :: A
       var t :: list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       BUTLAST(NIL) == NIL && BUTLAST(CONS(h, t)) == (if t == NIL | NIL | CONS(h, BUTLAST(t))))
  )

def REPLICATE:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var REPLICATE :: num -> A -> list(A)
       var x :: A
       var n :: num
       const NIL :: list(A)
       const SUC :: num -> num
       const CONS :: A -> list(A) -> list(A)
       REPLICATE((0 :: num), x) == NIL && REPLICATE(SUC(n), x) == CONS(x, REPLICATE(n, x)))
  )

def NULL:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var NULL :: list(A) -> bool
       var h :: A
       var t :: list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       (NULL(NIL) <=> #true) && (NULL(CONS(h, t)) <=> #false))
  )

def ALL:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var ALL :: (A -> bool) -> list(A) -> bool
       var P :: A -> bool
       var h :: A
       var t :: list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       (ALL(P, NIL) <=> #true) && (ALL(P, CONS(h, t)) <=> P(h) && ALL(P, t)))
  )

def EX:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var EX :: (A -> bool) -> list(A) -> bool
       var P :: A -> bool
       var h :: A
       var t :: list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       (EX(P, NIL) <=> #false) && (EX(P, CONS(h, t)) <=> P(h) || EX(P, t)))
  )

def ITLIST:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var ITLIST :: (A -> B -> B) -> list(A) -> B -> B
       var f :: A -> B -> B
       var b :: B
       var h :: A
       var t :: list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       ITLIST(f, NIL, b) == b && ITLIST(f, CONS(h, t), b) == f(h, ITLIST(f, t, b)))
  )

def MEM:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var MEM :: A -> list(A) -> bool
       var x :: A
       var h :: A
       var t :: list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       (MEM(x, NIL) <=> #false) && (MEM(x, CONS(h, t)) <=> x == h || MEM(x, t)))
  )

def ALL2_DEF:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var ALL2 :: (A -> B -> bool) -> list(A) -> list(B) -> bool
       var P :: A -> B -> bool
       var l2 :: list(B)
       var h1 :: A
       var t1 :: list(A)
       const NIL :: list(A)
       const NIL_2 as NIL :: list(B)
       const CONS :: A -> list(A) -> list(A)
       const HD :: list(B) -> B
       const TL :: list(B) -> list(B)
       (ALL2(P, NIL, l2) <=> l2 == NIL_2)
         && (ALL2(P, CONS(h1, t1), l2)
               <=> (if l2 == NIL_2 | #false | P(h1, HD(l2)) && ALL2(P, t1, TL(l2)))))
  )

def ALL2:
  prove(
    [
      (hol:
         var P :: A -> B -> bool
         var h1 :: A
         var t1 :: list(A)
         var h2 :: B
         var t2 :: list(B)
         const ALL2 :: (A -> B -> bool) -> list(A) -> list(B) -> bool
         const NIL :: list(A)
         const NIL_2 as NIL :: list(B)
         const CONS :: A -> list(A) -> list(A)
         const CONS_2 as CONS :: B -> list(B) -> list(B)
         (ALL2(P, NIL, NIL_2) <=> #true)
           && ((ALL2(P, CONS(h1, t1), NIL_2) <=> #false)
                 && ((ALL2(P, NIL, CONS_2(h2, t2)) <=> #false)
                       && (ALL2(P, CONS(h1, t1), CONS_2(h2, t2)) <=> P(h1, h2) && ALL2(P, t1, t2))))),
      REWRITE_TAC(PairList [distinctness("list"), ALL2_DEF, HD, TL])
    ]
  )

def MAP2_DEF:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var MAP2 :: (A -> B -> C) -> list(A) -> list(B) -> list(C)
       var f :: A -> B -> C
       var l :: list(B)
       var h1 :: A
       var t1 :: list(A)
       const NIL :: list(A)
       const NIL_2 as NIL :: list(C)
       const CONS :: A -> list(A) -> list(A)
       const CONS_2 as CONS :: C -> list(C) -> list(C)
       const HD :: list(B) -> B
       const TL :: list(B) -> list(B)
       MAP2(f, NIL, l) == NIL_2
         && MAP2(f, CONS(h1, t1), l) == CONS_2(f(h1, HD(l)), MAP2(f, t1, TL(l))))
  )

def MAP2:
  prove(
    [
      (hol:
         var f :: A -> B -> C
         var h1 :: A
         var t1 :: list(A)
         var h2 :: B
         var t2 :: list(B)
         const MAP2 :: (A -> B -> C) -> list(A) -> list(B) -> list(C)
         const NIL :: list(A)
         const NIL_2 as NIL :: list(B)
         const NIL_3 as NIL :: list(C)
         const CONS :: A -> list(A) -> list(A)
         const CONS_2 as CONS :: B -> list(B) -> list(B)
         const CONS_3 as CONS :: C -> list(C) -> list(C)
         MAP2(f, NIL, NIL_2) == NIL_3
           && MAP2(f, CONS(h1, t1), CONS_2(h2, t2)) == CONS_3(f(h1, h2), MAP2(f, t1, t2))),
      REWRITE_TAC(PairList [MAP2_DEF, HD, TL])
    ]
  )

def EL:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var EL :: num -> list(A) -> A
       var l :: list(A)
       var n :: num
       const HD :: list(A) -> A
       const SUC :: num -> num
       const TL :: list(A) -> list(A)
       EL((0 :: num), l) == HD(l) && EL(SUC(n), l) == EL(n, TL(l)))
  )

def FILTER:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var FILTER :: (A -> bool) -> list(A) -> list(A)
       var P :: A -> bool
       var h :: A
       var t :: list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       FILTER(P, NIL) == NIL
         && FILTER(P, CONS(h, t)) == (if P(h) | CONS(h, FILTER(P, t)) | FILTER(P, t)))
  )

def ASSOC:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var ASSOC :: A -> list(pair(A, B)) -> B
       var a :: A
       var h :: pair(A, B)
       var t :: list(pair(A, B))
       const CONS :: pair(A, B) -> list(pair(A, B)) -> list(pair(A, B))
       const FST :: pair(A, B) -> A
       const SND :: pair(A, B) -> B
       ASSOC(a, CONS(h, t)) == (if FST(h) == a | SND(h) | ASSOC(a, t)))
  )

def ITLIST2_DEF:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var ITLIST2 :: (A -> B -> C -> C) -> list(A) -> list(B) -> C -> C
       var f :: A -> B -> C -> C
       var l2 :: list(B)
       var b :: C
       var h1 :: A
       var t1 :: list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       const HD :: list(B) -> B
       const TL :: list(B) -> list(B)
       ITLIST2(f, NIL, l2, b) == b
         && ITLIST2(f, CONS(h1, t1), l2, b) == f(h1, HD(l2), ITLIST2(f, t1, TL(l2), b)))
  )

def ITLIST2:
  prove(
    [
      (hol:
         var f :: A -> B -> C -> C
         var b :: C
         var h1 :: A
         var t1 :: list(A)
         var h2 :: B
         var t2 :: list(B)
         const ITLIST2 :: (A -> B -> C -> C) -> list(A) -> list(B) -> C -> C
         const NIL :: list(A)
         const NIL_2 as NIL :: list(B)
         const CONS :: A -> list(A) -> list(A)
         const CONS_2 as CONS :: B -> list(B) -> list(B)
         ITLIST2(f, NIL, NIL_2, b) == b
           && ITLIST2(f, CONS(h1, t1), CONS_2(h2, t2), b) == f(h1, h2, ITLIST2(f, t1, t2, b))),
      REWRITE_TAC(PairList [ITLIST2_DEF, HD, TL])
    ]
  )

def ZIP_DEF:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var ZIP :: list(A) -> list(B) -> list(pair(A, B))
       var l2 :: list(B)
       var h1 :: A
       var t1 :: list(A)
       const NIL :: list(A)
       const NIL_2 as NIL :: list(pair(A, B))
       const CONS :: A -> list(A) -> list(A)
       const CONS_2 as CONS :: pair(A, B) -> list(pair(A, B)) -> list(pair(A, B))
       const comma as "," :: A -> B -> pair(A, B)
       const HD :: list(B) -> B
       const TL :: list(B) -> list(B)
       ZIP(NIL, l2) == NIL_2 && ZIP(CONS(h1, t1), l2) == CONS_2(comma(h1, HD(l2)), ZIP(t1, TL(l2))))
  )

def ZIP:
  prove(
    [
      (hol:
         var h1 :: A
         var t1 :: list(A)
         var h2 :: B
         var t2 :: list(B)
         const ZIP :: list(A) -> list(B) -> list(pair(A, B))
         const NIL :: list(A)
         const NIL_2 as NIL :: list(B)
         const NIL_3 as NIL :: list(pair(A, B))
         const CONS :: A -> list(A) -> list(A)
         const CONS_2 as CONS :: B -> list(B) -> list(B)
         const CONS_3 as CONS :: pair(A, B) -> list(pair(A, B)) -> list(pair(A, B))
         const comma as "," :: A -> B -> pair(A, B)
         ZIP(NIL, NIL_2) == NIL_3
           && ZIP(CONS(h1, t1), CONS_2(h2, t2)) == CONS_3(comma(h1, h2), ZIP(t1, t2))),
      REWRITE_TAC(PairList [ZIP_DEF, HD, TL])
    ]
  )

def ALLPAIRS:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var ALLPAIRS :: (A -> B -> bool) -> list(A) -> list(B) -> bool
       var f :: A -> B -> bool
       var l :: list(B)
       var h :: A
       var t :: list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       const ALL :: (B -> bool) -> list(B) -> bool
       (ALLPAIRS(f, NIL, l) <=> #true)
         && (ALLPAIRS(f, CONS(h, t), l) <=> ALL(f(h), l) && ALLPAIRS(f, t, l)))
  )

def PAIRWISE:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var PAIRWISE :: (A -> A -> bool) -> list(A) -> bool
       var r :: A -> A -> bool
       var h :: A
       var t :: list(A)
       const NIL :: list(A)
       const CONS :: A -> list(A) -> list(A)
       const ALL :: (A -> bool) -> list(A) -> bool
       (PAIRWISE(r, NIL) <=> #true) && (PAIRWISE(r, CONS(h, t)) <=> ALL(r(h), t) && PAIRWISE(r, t)))
  )

def list_of_seq:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var list_of_seq :: (num -> A) -> num -> list(A)
       var s :: num -> A
       var n :: num
       const NIL :: list(A)
       const SUC :: num -> num
       const APPEND :: list(A) -> list(A) -> list(A)
       const CONS :: A -> list(A) -> list(A)
       list_of_seq(s, (0 :: num)) == NIL
         && list_of_seq(s, SUC(n)) == APPEND(list_of_seq(s, n), CONS(s(n), NIL)))
  )

def NOT_CONS_NIL:
  prove(
    [
      (hol:
         const CONS :: A -> list(A) -> list(A)
         const NIL :: list(A)
         forall (h :: A, t :: list(A)): CONS(h, t) != NIL),
      REWRITE_TAC(PairList [distinctness("list")])
    ]
  )

def LAST_CLAUSES:
  prove(
    [
      (hol:
         var h :: A
         var k :: A
         var t :: list(A)
         const LAST :: list(A) -> A
         const CONS :: A -> list(A) -> list(A)
         const NIL :: list(A)
         LAST(CONS(h, NIL)) == h && LAST(CONS(h, CONS(k, t))) == LAST(CONS(k, t))),
      REWRITE_TAC(PairList [LAST, NOT_CONS_NIL])
    ]
  )

def APPEND_NIL:
  prove(
    [
      (hol:
         const APPEND :: list(A) -> list(A) -> list(A)
         const NIL :: list(A)
         forall l :: list(A): APPEND(l, NIL) == l),
      (LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [APPEND]))
    ]
  )

def APPEND_ASSOC:
  prove(
    [
      (hol:
         const APPEND :: list(A) -> list(A) -> list(A)
         forall (l :: list(A), m :: list(A), n :: list(A)):
           APPEND(l, APPEND(m, n)) == APPEND(APPEND(l, m), n)),
      (LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [APPEND]))
    ]
  )

def REVERSE_APPEND:
  prove(
    [
      (hol:
         const REVERSE :: list(A) -> list(A)
         const APPEND :: list(A) -> list(A) -> list(A)
         forall (l :: list(A), m :: list(A)): REVERSE(APPEND(l, m)) == APPEND(REVERSE(m), REVERSE(l))),
      (
        LIST_INDUCT_TAC then_tac \
        ASM_REWRITE_TAC(PairList [APPEND, REVERSE, APPEND_NIL, APPEND_ASSOC])
      )
    ]
  )

def REVERSE_REVERSE:
  prove(
    [
      (hol:
         const REVERSE :: list(A) -> list(A)
         forall l :: list(A): REVERSE(REVERSE(l)) == l),
      (LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [REVERSE, REVERSE_APPEND, APPEND]))
    ]
  )

def REVERSE_EQ_EMPTY:
  prove(
    [
      (hol:
         const REVERSE :: list(A) -> list(A)
         const NIL :: list(A)
         forall l :: list(A): REVERSE(l) == NIL <=> l == NIL),
      MESON_TAC(PairList [REVERSE_REVERSE, REVERSE])
    ]
  )

def CONS_11:
  prove(
    [
      (hol:
         const CONS :: A -> list(A) -> list(A)
         forall (h1 :: A, h2 :: A, t1 :: list(A), t2 :: list(A)):
           CONS(h1, t1) == CONS(h2, t2) <=> h1 == h2 && t1 == t2),
      REWRITE_TAC(PairList [injectivity("list")])
    ]
  )

def list_CASES:
  prove(
    [
      (hol:
         const NIL :: list(A)
         const CONS :: A -> list(A) -> list(A)
         forall l :: list(A): l == NIL || (exists (h :: A, t :: list(A)): l == CONS(h, t))),
      (
        (LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [CONS_11, NOT_CONS_NIL])) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def LIST_EQ:
  prove(
    [
      (hol:
         const LENGTH :: list(A) -> num
         const EL :: num -> list(A) -> A
         forall (l1 :: list(A), l2 :: list(A)):
           l1 == l2
             <=> (LENGTH(l1) == LENGTH(l2)
                    && (forall n :: num: n < LENGTH(l2) ==> EL(n, l1) == EL(n, l2)))),
      (
        (
          (
            (
              REPEAT(LIST_INDUCT_TAC) then_tac \
              REWRITE_TAC(PairList [NOT_CONS_NIL, CONS_11, LENGTH, CONJUNCT1(LT), NOT_SUC])
            ) then_tac \
            ASM_REWRITE_TAC(PairList [SUC_INJ])
          ) then_tac \
          GEN_REWRITE_TAC(o(RAND_CONV)(RAND_CONV))(
            PairList [
              MESON(
                PairList [num_CASES])(
                (hol:
                   var P :: num -> bool
                   const SUC :: num -> num
                   (forall n :: num: P(n)) <=> P((0 :: num)) && (forall n :: num: P(SUC(n))))
              )
            ]
          )
        ) then_tac \
        REWRITE_TAC(PairList [EL, HD, TL, LT_0, LT_SUC, CONJ_ACI])
      )
    ]
  )

def LENGTH_APPEND:
  prove(
    [
      (hol:
         const LENGTH :: list(A) -> num
         const APPEND :: list(A) -> list(A) -> list(A)
         forall (l :: list(A), m :: list(A)): LENGTH(APPEND(l, m)) == LENGTH(l) + LENGTH(m)),
      (LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [APPEND, LENGTH, ADD_CLAUSES]))
    ]
  )

def MAP_APPEND:
  prove(
    [
      (hol:
         const MAP :: (A -> B) -> list(A) -> list(B)
         const APPEND :: list(A) -> list(A) -> list(A)
         const APPEND_2 as APPEND :: list(B) -> list(B) -> list(B)
         forall (f :: A -> B, l1 :: list(A), l2 :: list(A)):
           MAP(f, APPEND(l1, l2)) == APPEND_2(MAP(f, l1), MAP(f, l2))),
      ((GEN_TAC then_tac LIST_INDUCT_TAC) then_tac ASM_REWRITE_TAC(PairList [MAP, APPEND]))
    ]
  )

def LENGTH_MAP:
  prove(
    [
      (hol:
         const LENGTH :: list(B) -> num
         const MAP :: (A -> B) -> list(A) -> list(B)
         const LENGTH_2 as LENGTH :: list(A) -> num
         forall (l :: list(A), f :: A -> B): LENGTH(MAP(f, l)) == LENGTH_2(l)),
      (LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MAP, LENGTH]))
    ]
  )

def LENGTH_EQ_NIL:
  prove(
    [
      (hol:
         const LENGTH :: list(A) -> num
         const NIL :: list(A)
         forall l :: list(A): LENGTH(l) == (0 :: num) <=> l == NIL),
      (LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [LENGTH, NOT_CONS_NIL, NOT_SUC]))
    ]
  )

def LENGTH_EQ_CONS:
  prove(
    [
      (hol:
         const LENGTH :: list(A) -> num
         const SUC :: num -> num
         const CONS :: A -> list(A) -> list(A)
         forall (l :: list(A), n :: num):
           LENGTH(l) == SUC(n) <=> (exists (h :: A, t :: list(A)): l == CONS(h, t) && LENGTH(t) == n)),
      (
        (
          (LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [LENGTH, NOT_SUC, NOT_CONS_NIL])) then_tac \
          ASM_REWRITE_TAC(PairList [SUC_INJ, CONS_11])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def LENGTH_REVERSE:
  prove(
    [
      (hol:
         const LENGTH :: list(A) -> num
         const REVERSE :: list(A) -> list(A)
         forall l :: list(A): LENGTH(REVERSE(l)) == LENGTH(l)),
      (
        (LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [REVERSE, LENGTH_APPEND, LENGTH])) then_tac \
        REWRITE_TAC(PairList [ADD_CLAUSES, MULT_CLAUSES])
      )
    ]
  )

def MAP_o:
  prove(
    [
      (hol:
         const MAP :: (A -> C) -> list(A) -> list(C)
         const o :: (B -> C) -> (A -> B) -> A -> C
         const MAP_2 as MAP :: (B -> C) -> list(B) -> list(C)
         const MAP_3 as MAP :: (A -> B) -> list(A) -> list(B)
         forall (f :: A -> B, g :: B -> C, l :: list(A)): MAP(o(g, f), l) == MAP_2(g, MAP_3(f, l))),
      (
        ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [MAP, o_THM])
      )
    ]
  )

def MAP_EQ:
  prove(
    [
      (hol:
         const ALL :: (A -> bool) -> list(A) -> bool
         const MAP :: (A -> B) -> list(A) -> list(B)
         forall (f :: A -> B, g :: A -> B, l :: list(A)):
           ALL(fun (x :: A): f(x) == g(x), l) ==> MAP(f, l) == MAP(g, l)),
      (
        (
          ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
          REWRITE_TAC(PairList [MAP, ALL])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def ALL_IMP:
  prove(
    [
      (hol:
         const MEM :: A -> list(A) -> bool
         const ALL :: (A -> bool) -> list(A) -> bool
         forall (P :: A -> bool, Q :: A -> bool, l :: list(A)):
           (forall x :: A: MEM(x, l) && P(x) ==> Q(x)) && ALL(P, l) ==> ALL(Q, l)),
      (
        (
          ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
          REWRITE_TAC(PairList [MEM, ALL])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def NOT_EX:
  prove(
    [
      (hol:
         const EX :: (A -> bool) -> list(A) -> bool
         const ALL :: (A -> bool) -> list(A) -> bool
         forall (P :: A -> bool, l :: list(A)): !EX(P, l) <=> ALL(fun (x :: A): !P(x), l)),
      (
        (GEN_TAC then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [EX, ALL, DE_MORGAN_THM])
      )
    ]
  )

def NOT_ALL:
  prove(
    [
      (hol:
         const ALL :: (A -> bool) -> list(A) -> bool
         const EX :: (A -> bool) -> list(A) -> bool
         forall (P :: A -> bool, l :: list(A)): !ALL(P, l) <=> EX(fun (x :: A): !P(x), l)),
      (
        (GEN_TAC then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [EX, ALL, DE_MORGAN_THM])
      )
    ]
  )

def ALL_MAP:
  prove(
    [
      (hol:
         const ALL :: (B -> bool) -> list(B) -> bool
         const MAP :: (A -> B) -> list(A) -> list(B)
         const ALL_2 as ALL :: (A -> bool) -> list(A) -> bool
         const o :: (B -> bool) -> (A -> B) -> A -> bool
         forall (P :: B -> bool, f :: A -> B, l :: list(A)): ALL(P, MAP(f, l)) <=> ALL_2(o(P, f), l)),
      (
        ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [ALL, MAP, o_THM])
      )
    ]
  )

def ALL_EQ:
  prove(
    [
      (hol:
         var R :: A -> bool
         var P :: A -> bool
         var Q :: A -> bool
         const ALL :: (A -> bool) -> list(A) -> bool
         forall l :: list(A):
           ALL(R, l) && (forall x :: A: R(x) ==> (P(x) <=> Q(x))) ==> (ALL(P, l) <=> ALL(Q, l))),
      (
        (
          (
            ((LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [ALL])) then_tac STRIP_TAC) then_tac \
            BINOP_TAC
          ) then_tac \
          FIRST_ASSUM(MATCH_MP_TAC)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def ALL_T:
  prove(
    [
      (hol:
         const ALL :: (A -> bool) -> list(A) -> bool
         forall l :: list(A): ALL(fun (x :: A): #true, l)),
      (LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ALL]))
    ]
  )

def MAP_EQ_ALL2:
  prove(
    [
      (hol:
         const ALL2 :: (A -> A -> bool) -> list(A) -> list(A) -> bool
         const MAP :: (A -> B) -> list(A) -> list(B)
         forall (f :: A -> B, l :: list(A), m :: list(A)):
           ALL2(fun (x :: A, y :: A): f(x) == f(y), l, m) ==> MAP(f, l) == MAP(f, m)),
      (
        (
          (GEN_TAC then_tac REPEAT(LIST_INDUCT_TAC)) then_tac \
          ASM_REWRITE_TAC(PairList [MAP, ALL2, CONS_11])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def ALL2_MAP:
  prove(
    [
      (hol:
         const ALL2 :: (B -> A -> bool) -> list(B) -> list(A) -> bool
         const MAP :: (A -> B) -> list(A) -> list(B)
         const ALL :: (A -> bool) -> list(A) -> bool
         forall (P :: B -> A -> bool, f :: A -> B, l :: list(A)):
           ALL2(P, MAP(f, l), l) <=> ALL(fun (a :: A): P(f(a), a), l)),
      (
        ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [ALL2, MAP, ALL])
      )
    ]
  )

def MAP_EQ_DEGEN:
  prove(
    [
      (hol:
         const ALL :: (A -> bool) -> list(A) -> bool
         const MAP :: (A -> A) -> list(A) -> list(A)
         forall (l :: list(A), f :: A -> A): ALL(fun (x :: A): f(x) == x, l) ==> MAP(f, l) == l),
      (
        (
          (
            (
              (LIST_INDUCT_TAC then_tac REWRITE_TAC(PairList [ALL, MAP, CONS_11])) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          FIRST_ASSUM(MATCH_MP_TAC)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def ALL2_AND_RIGHT:
  prove(
    [
      (hol:
         const ALL2 :: (A -> B -> bool) -> list(A) -> list(B) -> bool
         const ALL :: (A -> bool) -> list(A) -> bool
         forall (l :: list(A), m :: list(B), P :: A -> bool, Q :: A -> B -> bool):
           ALL2(fun (x :: A, y :: B): P(x) && Q(x, y), l, m) <=> ALL(P, l) && ALL2(Q, l, m)),
      (
        (
          ((LIST_INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [ALL, ALL2])) then_tac LIST_INDUCT_TAC) then_tac \
          ASM_REWRITE_TAC(PairList [ALL, ALL2])
        ) then_tac \
        REWRITE_TAC(PairList [CONJ_ACI])
      )
    ]
  )

def ITLIST_APPEND:
  prove(
    [
      (hol:
         const ITLIST :: (A -> B -> B) -> list(A) -> B -> B
         const APPEND :: list(A) -> list(A) -> list(A)
         forall (f :: A -> B -> B, a :: B, l1 :: list(A), l2 :: list(A)):
           ITLIST(f, APPEND(l1, l2), a) == ITLIST(f, l1, ITLIST(f, l2, a))),
      (
        ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [ITLIST, APPEND])
      )
    ]
  )

def ITLIST_EXTRA:
  prove(
    [
      (hol:
         var a :: A
         var b :: B
         const ITLIST :: (A -> B -> B) -> list(A) -> B -> B
         const APPEND :: list(A) -> list(A) -> list(A)
         const CONS :: A -> list(A) -> list(A)
         const NIL :: list(A)
         forall (f :: A -> B -> B, l :: list(A)):
           ITLIST(f, APPEND(l, CONS(a, NIL)), b) == ITLIST(f, l, f(a, b))),
      REWRITE_TAC(PairList [ITLIST_APPEND, ITLIST])
    ]
  )

def ALL_MP:
  prove(
    [
      (hol:
         const ALL :: (A -> bool) -> list(A) -> bool
         forall (P :: A -> bool, Q :: A -> bool, l :: list(A)):
           ALL(fun (x :: A): P(x) ==> Q(x), l) && ALL(P, l) ==> ALL(Q, l)),
      (
        (
          ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
          REWRITE_TAC(PairList [ALL])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def AND_ALL:
  prove(
    [
      (hol:
         var P :: A -> bool
         var Q :: A -> bool
         const ALL :: (A -> bool) -> list(A) -> bool
         forall l :: list(A): ALL(P, l) && ALL(Q, l) <=> ALL(fun (x :: A): P(x) && Q(x), l)),
      (
        (CONV_TAC(ONCE_DEPTH_CONV(SYM_CONV)) then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [ALL, CONJ_ACI])
      )
    ]
  )

def EX_IMP:
  prove(
    [
      (hol:
         const MEM :: A -> list(A) -> bool
         const EX :: (A -> bool) -> list(A) -> bool
         forall (P :: A -> bool, Q :: A -> bool, l :: list(A)):
           (forall x :: A: MEM(x, l) && P(x) ==> Q(x)) && EX(P, l) ==> EX(Q, l)),
      (
        (
          ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
          REWRITE_TAC(PairList [MEM, EX])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def ALL_MEM:
  prove(
    [
      (hol:
         const MEM :: A -> list(A) -> bool
         const ALL :: (A -> bool) -> list(A) -> bool
         forall (P :: A -> bool, l :: list(A)): (forall x :: A: MEM(x, l) ==> P(x)) <=> ALL(P, l)),
      (
        ((GEN_TAC then_tac LIST_INDUCT_TAC) then_tac REWRITE_TAC(PairList [ALL, MEM])) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def LENGTH_REPLICATE:
  prove(
    [
      (hol:
         const LENGTH :: list(A) -> num
         const REPLICATE :: num -> A -> list(A)
         forall (n :: num, x :: A): LENGTH(REPLICATE(n, x)) == n),
      (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [LENGTH, REPLICATE]))
    ]
  )

def MEM_REPLICATE:
  prove(
    [
      (hol:
         const MEM :: A -> list(A) -> bool
         const REPLICATE :: num -> A -> list(A)
         forall (n :: num, x :: A, y :: A): MEM(x, REPLICATE(n, y)) <=> x == y && n != (0 :: num)),
      (
        (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [MEM, REPLICATE, NOT_SUC])) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def EX_MAP:
  prove(
    [
      (hol:
         const EX :: (B -> bool) -> list(B) -> bool
         const MAP :: (A -> B) -> list(A) -> list(B)
         const EX_2 as EX :: (A -> bool) -> list(A) -> bool
         const o :: (B -> bool) -> (A -> B) -> A -> bool
         forall (P :: B -> bool, f :: A -> B, l :: list(A)): EX(P, MAP(f, l)) <=> EX_2(o(P, f), l)),
      (
        ((GEN_TAC then_tac GEN_TAC) then_tac LIST_INDUCT_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [MAP, EX, o_THM])
