fun LIST_CONV(conv):
  fun(tm):
    if is_cons(tm)
    | COMB2_CONV(RAND_CONV(conv))(LIST_CONV(conv))(tm)
    | (if (fst(dest_const(tm)) == "NIL") | REFL(tm) | failwith("LIST_CONV"))

def LENGTH_CONV:
  let pthc:
    prove(
      [
        Host.hol_term(And(
          Eq(
            Num,
            App(
              Const("LENGTH", Fun(Tyapp("list", [Tvar("A")]), Num)),
              [Var("t", Tyapp("list", [Tvar("A")]))]
            ),
            App(
              Const("+", Fun(Num, Fun(Num, Num))),
              [
                App(
                  Const("LENGTH", Fun(Tyapp("list", [Tvar("A")]), Num)),
                  [Var("t", Tyapp("list", [Tvar("A")]))]
                ),
                App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])
              ]
            )
          ),
          And(
            Eq(
              Num,
              App(
                Const("+", Fun(Num, Fun(Num, Num))),
                [
                  App(
                    Const("LENGTH", Fun(Tyapp("list", [Tvar("A")]), Num)),
                    [Const("NIL", Tyapp("list", [Tvar("A")]))]
                  ),
                  Var("n", Num)
                ]
              ),
              Var("n", Num)
            ),
            Eq(
              Num,
              App(
                Const("+", Fun(Num, Fun(Num, Num))),
                [
                  App(
                    Const("LENGTH", Fun(Tyapp("list", [Tvar("A")]), Num)),
                    [
                      App(
                        Const("CONS", Fun(Tvar("A"), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))),
                        [Var("h", Tvar("A")), Var("t", Tyapp("list", [Tvar("A")]))]
                      )
                    ]
                  ),
                  Var("n", Num)
                ]
              ),
              App(
                Const("+", Fun(Num, Fun(Num, Num))),
                [
                  App(
                    Const("LENGTH", Fun(Tyapp("list", [Tvar("A")]), Num)),
                    [Var("t", Tyapp("list", [Tvar("A")]))]
                  ),
                  App(Const("SUC", Fun(Num, Num)), [Var("n", Num)])
                ]
              )
            )
          )
        )),
        REWRITE_TAC(PairList [LENGTH, ADD_CLAUSES])
      ]
    )
  let pths_2 = CONJUNCTS(pthc)
  let avars_2 = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Const("LENGTH",_),ltm):
        if is_list(ltm)
        | let tyin = PairList [[hd(snd(dest_type(type_of(ltm)))), aty]]
          let PairList [h_tm_2, & PairList [n_tm_2, & PairList [t_tm_2, & PairList []]]] = map(inst(tyin))(avars_2)
          let PairList [pth_init_2, & PairList [pth_base_2, & PairList [pth_step_2, & PairList []]]] = map(INST_TYPE(tyin))(pths_2)
          fun conv(th):
            let [altm, ntm] = dest_comb(rand(concl(th)))
            let ltm = rand(rand(altm))
            if is_cons(ltm)
            | let [htm, ttm] = dest_cons(ltm)
              let th1 = INST(PairList [[htm, h_tm_2], [ttm, t_tm_2], [ntm, n_tm_2]])(pth_step_2)
              let [ftm, stm] = dest_comb(rand(concl(th1)))
              let th2 = TRANS(th1)(AP_TERM(ftm)(NUM_SUC_CONV(stm)))
              conv(TRANS(th)(th2))
            | TRANS(th)(INST(PairList [[ntm, n_tm_2]])(pth_base_2))
          try:
            conv(INST(PairList [[rand(tm), t_tm_2]])(pth_init_2))
            ~catch exn:
              match exn
              | Failure(_): failwith("LENGTH_CONV")
              | exn: (throw exn)
        | match tm
          | _: failwith("LENGTH_CONV")
    | _: failwith("LENGTH_CONV")

def EL_CONV:
  let pthc:
    prove(
      [
        Host.hol_term(And(
          Eq(
            Tvar("A"),
            App(
              Const("EL", Fun(Num, Fun(Tyapp("list", [Tvar("A")]), Tvar("A")))),
              [
                App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]),
                App(
                  Const("CONS", Fun(Tvar("A"), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))),
                  [Var("h", Tvar("A")), Var("t", Tyapp("list", [Tvar("A")]))]
                )
              ]
            ),
            Var("h", Tvar("A"))
          ),
          Implies(
            Eq(Num, Var("n", Num), App(Const("SUC", Fun(Num, Num)), [Var("m", Num)])),
            Eq(
              Tvar("A"),
              App(
                Const("EL", Fun(Num, Fun(Tyapp("list", [Tvar("A")]), Tvar("A")))),
                [
                  Var("n", Num),
                  App(
                    Const("CONS", Fun(Tvar("A"), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))),
                    [Var("h", Tvar("A")), Var("t", Tyapp("list", [Tvar("A")]))]
                  )
                ]
              ),
              App(
                Const("EL", Fun(Num, Fun(Tyapp("list", [Tvar("A")]), Tvar("A")))),
                [Var("m", Num), Var("t", Tyapp("list", [Tvar("A")]))]
              )
            )
          )
        )),
        SIMP_TAC(PairList [EL, HD, TL])
      ]
    )
  let pths_3 = map(UNDISCH_ALL)(CONJUNCTS(pthc))
  let avars_3 = sort(fun (x): fun (y): x < y)(frees(concl(pthc)))
  fun(tm):
    match tm
    | Comb(Comb(Const("EL",_),ntm),ltm):
        if is_list(ltm)
        | let tyin = PairList [[hd(snd(dest_type(type_of(ltm)))), aty]]
          let PairList [h_tm_3, & PairList [m_tm_2, & PairList [n_tm_3, & PairList [t_tm_3, & PairList []]]]] = map(inst(tyin))(avars_3)
          let PairList [pth_base_3, & PairList [pth_step_3, & PairList []]] = map(INST_TYPE(tyin))(pths_3)
          fun conv_2(th):
            let [entm, ltm] = dest_comb(rand(concl(th)))
            let [htm, ttm] = dest_cons(ltm)
            let [etm, ntm] = dest_comb(entm)
            let n = dest_numeral(ntm)
            if (n == Host.num_0)
            | TRANS(th)(INST(PairList [[htm, h_tm_3], [ttm, t_tm_3]])(pth_base_3))
            | let th1 = num_CONV(ntm)
              let th2:
                INST(
                  PairList [
                    [ntm, n_tm_3],
                    [rand(rand(concl(th1))), m_tm_2],
                    [htm, h_tm_3],
                    [ttm, t_tm_3]
                  ]
                )(pth_step_3)
              let th3 = TRANS(th)(PROVE_HYP(th1)(th2))
              conv_2(th3)
          try:
            conv_2(REFL(tm))
            ~catch exn:
              match exn
              | Failure(_): failwith("EL_CONV")
              | exn: (throw exn)
        | match tm
          | _: failwith("EL_CONV")
    | _: failwith("EL_CONV")

