  def offinc = 10000

  def inferences = Box(0)

  fun mk_negated([p, a]): [Host.hol_neg(p), a]

  curried fun qpartition(p, m):
    curried fun qpartition(l):
      if Host.hol_physical_equal(l)(m)
      | Host.hol_raise(Unchanged())
      | match l
        | PairList []: Host.hol_raise(Unchanged())
        | PairList [h, & t]:
            if p(h)
            | try:
                let [yes, no] = qpartition(t)
                [PairList [h, & yes], no]
                ~catch exn:
                  match exn
                  | Unchanged(): [PairList [h], t]
                  | exn: Host.hol_raise(exn)
            | let [yes, no] = qpartition(t)
              [yes, PairList [h, & no]]
    fun(l):
      try:
        qpartition(l)
        ~catch exn:
          match exn
          | Unchanged(): [PairList [], l]
          | exn: Host.hol_raise(exn)

  def [reset_vars_v2, fol_of_var_v2, hol_of_var]:
    let vstore_2 = Box(PairList [])
    let gstore_2 = Box(PairList [])
    let vcounter_2 = Box(0)
    let inc_vcounter:
      fun(_):
        let n = Host.ref_get(vcounter_2)
        let m = Host.hol_add(n)(1)
        if Host.hol_ge(m)(offinc)
        | failwith("inc_vcounter: too many variables")
        | Host.ref_set(vcounter_2)(m)
          n
    let reset_vars:
      fun(_):
        Host.ref_set(vstore_2)(PairList [])
        Host.ref_set(gstore_2)(PairList [])
        Host.ref_set(vcounter_2)(0)
    let fol_of_var:
      fun(v):
        let currentvars = Host.ref_get(vstore_2)
        try:
          assoc(v)(currentvars)
          ~catch exn:
            match exn
            | Failure(_):
                let n = Host.hol_apply_unit(inc_vcounter)
                Host.ref_set(vstore_2)(PairList [[v, n], & currentvars])
                n
            | exn: Host.hol_raise(exn)
    let hol_of_var:
      fun(v):
        try:
          rev_assoc(v)(Host.ref_get(vstore_2))
          ~catch exn:
            match exn
            | Failure(_): rev_assoc(v)(Host.ref_get(gstore_2))
            | exn: Host.hol_raise(exn)
    let hol_of_bumped_var:
      fun(v):
        try:
          hol_of_var(v)
          ~catch exn:
            match exn
            | Failure(_):
                let v_prime = Host.hol_mod(v)(offinc)
                let hv_prime = hol_of_var(v_prime)
                let gv = genvar(type_of(hv_prime))
                Host.ref_set(gstore_2)(PairList [[gv, v], & Host.ref_get(gstore_2)])
                gv
            | exn: Host.hol_raise(exn)
    [reset_vars, fol_of_var, hol_of_bumped_var]

  def [reset_consts_v2, fol_of_const_v2, hol_of_const]:
    let false_tm = Host.hol_term(False)
    let cstore_2 = Box(PairList [])
    let ccounter_2 = Box(2)
    let reset_consts:
      fun(_):
        Host.ref_set(cstore_2)(PairList [[false_tm, 1]])
        Host.ref_set(ccounter_2)(2)
    let fol_of_const:
      fun(c):
        let currentconsts = Host.ref_get(cstore_2)
        try:
          assoc(c)(currentconsts)
          ~catch exn:
            match exn
            | Failure(_):
                let n = Host.ref_get(ccounter_2)
                Host.ref_set(ccounter_2)(Host.hol_add(n)(1))
                Host.ref_set(cstore_2)(PairList [[c, n], & currentconsts])
                n
            | exn: Host.hol_raise(exn)
    let hol_of_const = (fun(c): rev_assoc(c)(Host.ref_get(cstore_2)))
    [reset_consts, fol_of_const, hol_of_const]

  curried fun fol_of_term(env, consts, tm):
    if (is_var(tm) && Host.hol_not(mem(tm)(consts)))
    | Fvar(fol_of_var_v2(tm))
    | let [f, args] = strip_comb(tm)
      if mem(f)(env)
      | failwith("fol_of_term: higher order")
      | let ff = fol_of_const_v2(f)
        Fnapp(ff, map(fol_of_term(env, consts))(args))

  curried fun fol_of_atom(env, consts, tm):
    let [f, args] = strip_comb(tm)
    if mem(f)(env)
    | failwith("fol_of_atom: higher order")
    | let ff = fol_of_const_v2(f)
      [ff, map(fol_of_term(env, consts))(args)]

  curried fun fol_of_literal(env, consts, tm):
    try:
      let tm_prime = dest_neg(tm)
      let [p, a_2] = fol_of_atom(env, consts, tm_prime)
      [Host.hol_neg(p), a_2]
      ~catch exn:
        match exn
        | Failure(_): fol_of_atom(env, consts, tm)
        | exn: Host.hol_raise(exn)

  curried fun fol_of_form(env, consts, tm):
    try:
      let [v, bod] = dest_forall(tm)
      let fv = fol_of_var_v2(v)
      let fbod = fol_of_form(PairList [v, & env])(subtract(consts)(PairList [v]))(bod)
      Forallq(fv, fbod)
      ~catch exn:
        match exn
        | Failure(_):
            try:
              let [l, r] = dest_conj(tm)
              let fl_2 = fol_of_form(env, consts, l)
              let fr_2 = fol_of_form(env, consts, r)
              Conj(fl_2, fr_2)
              ~catch exn:
                match exn
                | Failure(_):
                    try:
                      let [l, r] = dest_disj(tm)
                      let fl_3 = fol_of_form(env, consts, l)
                      let fr_3 = fol_of_form(env, consts, r)
                      Disj(fl_3, fr_3)
                      ~catch exn:
                        match exn
                        | Failure(_): Atom(fol_of_literal(env, consts, tm))
                        | exn: Host.hol_raise(exn)
                | exn: Host.hol_raise(exn)
        | exn: Host.hol_raise(exn)

  fun hol_of_term(tm):
    match tm
    | Fvar(v): hol_of_var(v)
    | Fnapp(f,args): list_mk_comb([hol_of_const(f), map(hol_of_term)(args)])

  fun hol_of_atom([p, args]): list_mk_comb([hol_of_const(p), map(hol_of_term)(args)])

  fun hol_of_literal([p, args]): (if Host.hol_lt(p)(0) | mk_neg(hol_of_atom([Host.hol_neg(p), args])) | hol_of_atom([p, args]))

  curried fun fol_free_in(v, tm):
    match tm
    | Fvar(x): Host.hol_equal(x)(v)
    | Fnapp(_,lis): exists(fol_free_in(v))(lis)

  curried fun fol_subst(theta, tm):
    match tm
    | Fvar(v): rev_assocd(v)(theta)(tm)
    | Fnapp(f,args):
        let args_prime = qmap(fol_subst(theta))(args)
        (if Host.hol_physical_equal(args_prime)(args) | tm | Fnapp(f, args_prime))

  curried fun fol_inst(theta, [p, args] as at):
    let args_prime = qmap(fol_subst(theta))(args)
    (if Host.hol_physical_equal(args_prime)(args) | at | [p, args_prime])

  curried fun fol_subst_bump(offset, theta, tm):
    match tm
    | Fvar(v):
        if Host.hol_lt(v)(offinc)
        | let v_prime = Host.hol_add(v)(offset)
          rev_assocd(v_prime)(theta)(Fvar(v_prime))
        | rev_assocd(v)(theta)(tm)
    | Fnapp(f,args):
        let args_prime = qmap(fol_subst_bump(offset, theta))(args)
        (if Host.hol_physical_equal(args_prime)(args) | tm | Fnapp(f, args_prime))

  curried fun fol_inst_bump(offset, theta, [p, args] as at):
    let args_prime = qmap(fol_subst_bump(offset, theta))(args)
    (if Host.hol_physical_equal(args_prime)(args) | at | [p, args_prime])

  curried fun istriv(env, x, t):
    match t
    | Fvar(y):
        if Host.hol_equal(y)(x)
        | #true
        | try:
            let t_prime = rev_assoc(y)(env)
            istriv(env, x, t_prime)
            ~catch exn:
              match exn
              | Failure("find"): #false
              | exn: Host.hol_raise(exn)
    | Fnapp(f,args): (exists(istriv(env, x))(args) && failwith("cyclic"))

  curried fun fol_unify(offset, tm1, tm2, sofar):
    match [tm1, tm2]
    | [Fnapp(f,fargs), Fnapp(g,gargs)]: (if Host.hol_unequal(f)(g) | failwith("") | itlist2(fol_unify(offset))(fargs)(gargs)(sofar))
    | [_, Fvar(x)]:
        let x_prime = Host.hol_add(x)(offset)
        try:
          let tm2_prime = rev_assoc(x_prime)(sofar)
          fol_unify(0, tm1, tm2_prime, sofar)
          ~catch exn:
            match exn
            | Failure("find"): (if istriv(sofar, x_prime, tm1) | sofar | PairList [[tm1, x_prime], & sofar])
            | exn: Host.hol_raise(exn)
    | [Fvar(x), _]:
        try:
          let tm1_prime = rev_assoc(x)(sofar)
          fol_unify(offset, tm1_prime, tm2, sofar)
          ~catch exn:
            match exn
            | Failure("find"):
                let tm2_prime = fol_subst_bump(offset, PairList [], tm2)
                (if istriv(sofar, x, tm2_prime) | sofar | PairList [[tm2_prime, x], & sofar])
            | exn: Host.hol_raise(exn)

  curried fun fol_eq(insts, tm1, tm2):
    if Host.hol_physical_equal(tm1)(tm2)
    | #true
    | match [tm1, tm2]
      | [Fnapp(f,fargs), Fnapp(g,gargs)]: (Host.hol_equal(f)(g) && Host.forall2(fol_eq(insts))(fargs)(gargs))
      | [_, Fvar(x)]:
          try:
            let tm2_prime = rev_assoc(x)(insts)
            fol_eq(insts, tm1, tm2_prime)
            ~catch exn:
              match exn
              | Failure("find"):
                  try:
                    istriv(insts, x, tm1)
                    ~catch exn:
                      match exn
                      | Failure(_): #false
                      | exn: Host.hol_raise(exn)
              | exn: Host.hol_raise(exn)
      | [Fvar(x), _]:
          try:
            let tm1_prime = rev_assoc(x)(insts)
            fol_eq(insts, tm1_prime, tm2)
            ~catch exn:
              match exn
              | Failure("find"):
                  try:
                    istriv(insts, x, tm2)
                    ~catch exn:
                      match exn
                      | Failure(_): #false
                      | exn: Host.hol_raise(exn)
              | exn: Host.hol_raise(exn)

  curried fun fol_atom_eq(insts, [p1, args1], [p2, args2]): (Host.hol_equal(p1)(p2) && Host.forall2(fol_eq(insts))(args1)(args2))

  fun cacheconts(f):
    let memory = Box(PairList [])
    fun([gg, [insts, offset, size]] as input):
      if (
        exists(
          (fun([_, [insts_prime, _, size_prime]]): (Host.hol_equal(insts)(insts_prime) && (Host.hol_le(size)(size_prime) || Host.ref_get(meson_depth))))
        )(Host.ref_get(memory))
      )
      | failwith("cachecont")
      | Host.ref_set(memory)(PairList [input, & Host.ref_get(memory)])
      f(input)

  curried fun checkan(insts, [p, a], ancestors):
    let p_prime = Host.hol_neg(p)
    let t_prime = [p_prime, a]
    try:
      let ours = assoc(p_prime)(ancestors)
      (if exists((fun(u): fol_atom_eq(insts)(t_prime)(snd(fst(u)))))(ours) | failwith("checkan") | ancestors)
      ~catch exn:
        match exn
        | Failure("find"): ancestors
        | exn: Host.hol_raise(exn)

  curried fun insertan(insts, [p, a], ancestors):
    let p_prime = Host.hol_neg(p)
    let t_prime = [p_prime, a]
    let [ourancp, otheranc]:
      try:
        Host.remove((fun([pr, _]): Host.hol_equal(pr)(p_prime)))(ancestors)
        ~catch exn:
          match exn
          | Failure(_): [[p_prime, PairList []], ancestors]
          | exn: Host.hol_raise(exn)
    let ouranc = snd(ourancp)
    (if exists((fun(u): fol_atom_eq(insts)(t_prime)(snd(fst(u)))))(ouranc) | failwith("insertan: loop") | PairList [[p_prime, PairList [[[PairList [], t_prime], [0, TRUTH]], & ouranc]], & otheranc])

  curried fun fol_subst_partial(insts, tm):
    match tm
    | Fvar(v):
        try:
          let t = rev_assoc(v)(insts)
          fol_subst_partial(insts, t)
          ~catch exn:
            match exn
            | Failure("find"): tm
            | exn: Host.hol_raise(exn)
    | Fnapp(f,args): Fnapp(f, map(fol_subst_partial(insts))(args))

  curried fun separate_insts(offset, oldinsts, newinsts):
    let [locins, globins] = qpartition((fun([_, v]): Host.hol_le(offset)(v)), oldinsts)(newinsts)
    if Host.hol_equal(globins)(oldinsts)
    | [map((fun([t, x]): [fol_subst_partial(newinsts, t), x]))(locins), oldinsts]
    | [
        map((fun([t, x]): [fol_subst_partial(newinsts, t), x]))(locins),
        map((fun([t, x]): [fol_subst_partial(newinsts, t), x]))(globins)
      ]

  curried fun meson_single_expand(loffset, rule, [[g, ancestors], [insts, offset, size]]):
    let [[hyps, conc], tag] = rule
    let allins = Host.rev_itlist2(fol_unify(loffset))(snd(g))(snd(conc))(insts)
    let [locin, globin] = separate_insts(offset, insts, allins)
    let mk_ihyp:
      fun(h):
        let h_prime = fol_inst_bump(offset, locin, h)
        [h_prime, checkan(insts, h_prime, ancestors)]
    let newhyps = map(mk_ihyp)(hyps)
    Host.ref_set(inferences)(Host.hol_add(Host.ref_get(inferences))(1))
    [newhyps, [globin, Host.hol_add(offset)(offinc), Host.hol_sub(size)(length(hyps))]]

  curried fun meson_expand_cont(loffset, rules, state, cont): tryfind((fun(r): cont(snd(r))(meson_single_expand(loffset, r, state))))(rules)

  curried fun meson_expand(rules, [[g, ancestors], [insts, offset, size] as tup], cont):
    let pr = fst(g)
    let newancestors = insertan(insts, g, ancestors)
    let newstate = [[g, newancestors], tup]
    try:
      if (Host.ref_get(meson_prefine) && Host.hol_gt(pr)(0))
      | failwith("meson_expand")
      | let arules = assoc(pr)(ancestors)
        meson_expand_cont(0, arules, newstate, cont)
      ~catch exn:
        match exn
        | Cut(): failwith("meson_expand")
        | Failure(_):
            try:
              let crules = filter((fun([[h, _], _]): Host.hol_le(length(h))(size)))(assoc(pr)(rules))
              meson_expand_cont(offset, crules, newstate, cont)
              ~catch exn:
                match exn
                | Cut(): failwith("meson_expand")
                | Failure(_): failwith("meson_expand")
                | exn: Host.hol_raise(exn)
        | exn: Host.hol_raise(exn)

  fun expand_goal(rules):
    fun expand_goal_2(depth):
      fun([[g, _], [insts, offset, size]] as state):
        fun(cont):
          if Host.hol_lt(depth)(0)
          | failwith("expand_goal: too deep")
          | meson_expand(
              rules,
              state,
              fun(apprule):
                fun([_, [pinsts, _, _]] as newstate):
                  expand_goals_2(Host.hol_sub(depth)(1))(newstate)(
                    cacheconts(
                      fun([gs, [newinsts, newoffset, newsize]]):
                        let [locin, globin] = separate_insts(offset, pinsts, newinsts)
                        let g_prime = Subgoal(g, gs, apprule, offset, locin)
                        if (Host.hol_equal(globin)(insts) && Host.hol_equal(gs)(PairList []))
                        | try:
                            cont([g_prime, [globin, newoffset, size]])
                            ~catch exn:
                              match exn
                              | Failure(_): Host.hol_raise(Cut())
                              | exn: Host.hol_raise(exn)
                        | try:
                            cont([g_prime, [globin, newoffset, newsize]])
                            ~catch exn:
                              match exn
                              | Cut(): failwith("expand_goal")
                              | Failure(_): failwith("expand_goal")
                              | exn: Host.hol_raise(exn)
                    )
                  )
            )
    fun expand_goals_2(depth):
      fun([gl, [insts, offset, size] as tup]):
        fun(cont):
          match gl
          | PairList []: cont([PairList [], tup])
          | PairList [g, & PairList []]: expand_goal_2(depth)([g, tup])((fun([g_prime, stup]): cont([PairList [g_prime], stup])))
          | gl:
              if Host.hol_ge(size)(Host.ref_get(meson_dcutin))
              | let lsize = Host.hol_div(size)(Host.ref_get(meson_skew))
                let rsize = Host.hol_sub(size)(lsize)
                let [lgoals, rgoals] = Host.chop_list(Host.hol_div(length(gl))(2))(gl)
                try:
                  expand_goals_2(depth)([lgoals, [insts, offset, lsize]])(
                    cacheconts(
                      (fun([lg_prime, [i, off, n]]): expand_goals_2(depth)([rgoals, [i, off, Host.hol_add(n)(rsize)]])(cacheconts((fun([rg_prime, ztup]): cont([append(lg_prime)(rg_prime), ztup])))))
                    )
                  )
                  ~catch exn:
                    match exn
                    | Failure(_):
                        expand_goals_2(depth)([rgoals, [insts, offset, lsize]])(
                          cacheconts(
                            fun([rg_prime, [i, off, n]]):
                              expand_goals_2(depth)([lgoals, [i, off, Host.hol_add(n)(rsize)]])(
                                cacheconts(
                                  (fun([lg_prime, [_, _, fsize] as ztup]): (if Host.hol_le(Host.hol_add(n)(rsize))(Host.hol_add(lsize)(fsize)) | failwith("repetition of demigoal pair") | cont([append(lg_prime)(rg_prime), ztup])))
                                )
                              )
                          )
                        )
                    | exn: Host.hol_raise(exn)
              | let PairList [g, & gs] = gl
                expand_goal_2(depth)([g, tup])(
                  cacheconts(
                    (fun([g_prime, stup]): expand_goals_2(depth)([gs, stup])(cacheconts((fun([gs_prime, ftup]): cont([PairList [g_prime, & gs_prime], ftup])))))
                  )
                )
    (fun(g): (fun(maxdep): (fun(maxinf): (fun(cont): expand_goal_2(maxdep)([g, [PairList [], Host.hol_mul(2)(offinc), maxinf]])(cont)))))

  curried fun solve_goal(rules, incdepth, min, max, incsize):
    fun solve(n):
      fun(g):
        if Host.hol_gt(n)(max)
        | failwith("solve_goal: Too deep")
        | if (Host.ref_get(meson_chatty) && Host.ref_get(Host.verbose))
          | Host.hol_print_string(
              Host.hol_concat(Host.hol_string_of_int(Host.ref_get(inferences)))(
                Host.hol_concat(" inferences so far. ")(
                  Host.hol_concat("Searching with maximum size ")(Host.hol_concat(Host.hol_string_of_int(n))("."))
                )
              )
            )
            Host.hol_apply_unit(Host.hol_print_newline)
          | if Host.ref_get(Host.verbose)
            | Host.hol_print_string(Host.hol_concat(Host.hol_string_of_int(Host.ref_get(inferences)))(".."))
              Host.hol_apply_unit(Host.hol_print_flush)
            | #void
        try:
          let gi = (if incdepth | expand_goal(rules)(g)(n)(100000)((fun(x): x)) | expand_goal(rules)(g)(100000)(n)((fun(x): x)))
          if (Host.ref_get(meson_chatty) && Host.ref_get(Host.verbose))
          | Host.hol_print_string(
              Host.hol_concat("Goal solved with ")(Host.hol_concat(Host.hol_string_of_int(Host.ref_get(inferences)))(" inferences."))
            )
            Host.hol_apply_unit(Host.hol_print_newline)
          | if Host.ref_get(Host.verbose)
            | Host.hol_print_string(Host.hol_concat("solved at ")(Host.hol_string_of_int(Host.ref_get(inferences))))
              Host.hol_apply_unit(Host.hol_print_newline)
            | #void
          gi
          ~catch exn:
            match exn
            | Failure(_): solve(Host.hol_add(n)(incsize))(g)
            | exn: Host.hol_raise(exn)
    (fun(g): solve(min)([g, PairList []]))

  def fol_of_hol_clauses:
    let eqt = (fun([a1, [b1, c1]]): (fun([a2, [b2, c2]]): (Host.hol_equal(a1)(a2) && (Host.hol_equal(b1)(b2) && equals_thm(c1)(c2)))))
    fun mk_contraposes(n):
      fun(th):
        fun(used):
          fun(unused):
            fun(sofar):
              match unused
              | PairList []: sofar
              | PairList [h, & t]:
                  let nw = [[map(mk_negated)(append(used)(t)), h], [n, th]]
                  mk_contraposes(Host.hol_add(n)(1))(th)(append(used)(PairList [h]))(t)(PairList [nw, & sofar])
    let fol_of_hol_clause:
      fun(th):
        let lconsts = freesl(hyp(th))
        let tm = concl(th)
        let hlits = disjuncts(tm)
        let flits = map(fol_of_literal(PairList [], lconsts))(hlits)
        let basics = mk_contraposes(0)(th)(PairList [])(flits)(PairList [])
        (if forall((fun([p, _]): Host.hol_lt(p)(0)))(flits) | PairList [[[map(mk_negated)(flits), [1, PairList []]], [-1, th]], & basics] | basics)
    fun(thms):
      let rawrules = itlist(o(Host.union_prime(eqt))(fol_of_hol_clause))(thms)(PairList [])
      let prs = Host.setify(map(o(o(fst)(snd))(fst))(rawrules))
      let prules = map((fun(t): [t, filter(o(o(o(Host.hol_equal(t))(fst))(snd))(fst))(rawrules)]))(prs)
      let srules = sort((fun([p, _]): (fun([q, _]): Host.hol_le(Host.abs(p))(Host.abs(q)))))(prules)
      srules

  def optimize_rules:
    let optimize_clause_order = (fun(cls): sort((fun([[l1, _], _]): (fun([[l2, _], _]): Host.hol_le(length(l1))(length(l2)))))(cls))
    map((fun([a, b]): [a, optimize_clause_order(b)]))

  def [clear_contrapos_cache_v2, make_hol_contrapos]:
    let DISJ_AC_2 = AC(DISJ_ACI)
    let imp_CONV_2:
      REWR_CONV(
        TAUT(
          Host.hol_term(Iff(Or(Var("a", Bool), Var("b", Bool)), Implies(Not(Var("b", Bool)), Var("a", Bool))))
        )
      )
    let push_CONV_2:
      GEN_REWRITE_CONV(TOP_SWEEP_CONV)(
        PairList [
          TAUT(
            Host.hol_term(Iff(Not(Or(Var("a", Bool), Var("b", Bool))), And(Not(Var("a", Bool)), Not(Var("b", Bool)))))
          ),
          TAUT(Host.hol_term(Iff(Not(Not(Var("a", Bool))), Var("a", Bool))))
        ]
      )
    let pull_CONV_2:
      GEN_REWRITE_CONV(DEPTH_CONV)(
        PairList [
          TAUT(
            Host.hol_term(Iff(Or(Not(Var("a", Bool)), Not(Var("b", Bool))), Not(And(Var("a", Bool), Var("b", Bool)))))
          )
        ]
      )
    let imf_CONV_2 = REWR_CONV(TAUT(Host.hol_term(Iff(Not(Var("p", Bool)), Implies(Var("p", Bool), False)))))
    let memory = Box(PairList [])
    let clear_contrapos_cache = (fun(_): Host.ref_set(memory)(PairList []))
    let make_hol_contrapos:
      fun([n, th]):
        let tm = concl(th)
        let key = [n, tm]
        try:
          assoc(key)(Host.ref_get(memory))
          ~catch exn:
            match exn
            | Failure(_):
                if Host.hol_lt(n)(0)
                | CONV_RULE((pull_CONV_2 then_conv imf_CONV_2))(th)
                | let djs = disjuncts(tm)
                  let acth:
                    if Host.hol_equal(n)(0)
                    | th
                    | let [ldjs, rdjs] = Host.chop_list(n)(djs)
                      let ndjs = PairList [hd(rdjs), & append(ldjs)(tl(rdjs))]
                      EQ_MP(DISJ_AC_2(mk_eq([tm, list_mk_disj(ndjs)])))(th)
                  let fth = (if Host.hol_equal(length(djs))(1) | acth | CONV_RULE((imp_CONV_2 then_conv push_CONV_2))(acth))
                  Host.ref_set(memory)(PairList [[key, fth], & Host.ref_get(memory)])
                  fth
            | exn: Host.hol_raise(exn)
    [clear_contrapos_cache, make_hol_contrapos]

  def finish_RULE:
    GEN_REWRITE_RULE(I)(
      PairList [
        TAUT(Host.hol_term(Iff(Implies(Not(Var("p", Bool)), Var("p", Bool)), Var("p", Bool)))),
        TAUT(Host.hol_term(Iff(Implies(Var("p", Bool), Not(Var("p", Bool))), Not(Var("p", Bool)))))
      ]
    )

  def meson_to_hol:
    let hol_negate:
      fun(tm):
        try:
          dest_neg(tm)
          ~catch exn:
            match exn
            | Failure(_): mk_neg(tm)
            | exn: Host.hol_raise(exn)
    let merge_inst = (fun([t, x]): (fun(current): PairList [[fol_subst(current, t), x], & current]))
    fun meson_to_hol(insts):
      fun(Subgoal(g,gs,[n, th],offset,locin)):
        let newins = itlist(merge_inst)(locin)(insts)
        let g_prime = fol_inst(newins, g)
        let hol_g = hol_of_literal(g_prime)
        let ths = map(meson_to_hol(newins))(gs)
        let hth:
          if equals_thm(th)(TRUTH)
          | ASSUME(hol_g)
          | let cth = make_hol_contrapos([n, th])
            (if Host.hol_equal(ths)(PairList []) | cth | MATCH_MP(cth)(end_itlist(CONJ)(ths)))
        let ith = PART_MATCH(I)(hth)(hol_g)
        finish_RULE(DISCH(hol_negate(concl(ith)))(ith))
    meson_to_hol

  def create_equality_axioms:
    let eq_thms:
      o(CONJUNCTS)(prove)(
        [
          Host.hol_term(And(
            Eq(Tvar("A"), Var("x", Tvar("A")), Var("x", Tvar("A"))),
            Or(
              Not(Eq(Tvar("A"), Var("x", Tvar("A")), Var("y", Tvar("A")))),
              Or(
                Not(Eq(Tvar("A"), Var("x", Tvar("A")), Var("z", Tvar("A")))),
                Eq(Tvar("A"), Var("y", Tvar("A")), Var("z", Tvar("A")))
              )
            )
          )),
          (
            (
              (
                REWRITE_TAC(PairList []) then_tac \
                ASM_CASES_TAC(Host.hol_term(Eq(Tvar("A"), Var("x", Tvar("A")), Var("y", Tvar("A")))))
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            CONV_TAC(TAUT)
          )
        ]
      )
    let imp_elim_CONV:
      REWR_CONV(
        TAUT(
          Host.hol_term(Iff(Implies(Var("a", Bool), Var("b", Bool)), Or(Not(Var("a", Bool)), Var("b", Bool))))
        )
      )
    let eq_elim_RULE:
      MATCH_MP(
        TAUT(
          Host.hol_term(Implies(Iff(Var("a", Bool), Var("b", Bool)), Or(Var("b", Bool), Not(Var("a", Bool)))))
        )
      )
    let veq_tm = rator(rator(concl(hd(eq_thms))))
    let create_equivalence_axioms:
      fun([eq, _]):
        let tyins = type_match(type_of(veq_tm))(type_of(eq))(PairList [])
        map(INST_TYPE(tyins))(eq_thms)
    fun tm_consts(tm):
      fun(acc):
        let [fn, args] = strip_comb(tm)
        (if Host.hol_equal(args)(PairList []) | acc | itlist(tm_consts)(args)(insert([fn, length(args)])(acc)))
    fun fm_consts(tm):
      fun([preds, funs] as acc):
        try:
          fm_consts(snd(dest_forall(tm)))(acc)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  fm_consts(snd(dest_exists(tm)))(acc)
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let [l, r] = dest_conj(tm)
                          fm_consts(l)(fm_consts(r)(acc))
                          ~catch exn:
                            match exn
                            | Failure(_):
                                try:
                                  let [l, r] = dest_disj(tm)
                                  fm_consts(l)(fm_consts(r)(acc))
                                  ~catch exn:
                                    match exn
                                    | Failure(_):
                                        try:
                                          let [l, r] = dest_imp(tm)
                                          fm_consts(l)(fm_consts(r)(acc))
                                          ~catch exn:
                                            match exn
                                            | Failure(_):
                                                try:
                                                  fm_consts(dest_neg(tm))(acc)
                                                  ~catch exn:
                                                    match exn
                                                    | Failure(_):
                                                        try:
                                                          let [l, r] = dest_eq(tm)
                                                          (if Host.hol_equal(type_of(l))(bool_ty) | fm_consts(r)(fm_consts(l)(acc)) | failwith("atomic equality"))
                                                          ~catch exn:
                                                            match exn
                                                            | Failure(_):
                                                                let [pred, args] = strip_comb(tm)
                                                                (if Host.hol_equal(args)(PairList []) | acc | [insert([pred, length(args)])(preds), itlist(tm_consts)(args)(funs)])
                                                            | exn: Host.hol_raise(exn)
                                                    | exn: Host.hol_raise(exn)
                                            | exn: Host.hol_raise(exn)
                                    | exn: Host.hol_raise(exn)
                            | exn: Host.hol_raise(exn)
                    | exn: Host.hol_raise(exn)
            | exn: Host.hol_raise(exn)
    let create_congruence_axiom:
      fun(pflag):
        fun([tm, len]):
          let [atys, rty]:
            splitlist(
              fun(ty):
                let [op, l] = dest_type(ty)
                (if Host.hol_equal(op)("fun") | [hd(l), hd(tl(l))] | Host.hol_apply_unit(fail))
            )(type_of(tm))
          let ctys = fst(Host.chop_list(len)(atys))
          let largs_2 = map(genvar)(ctys)
          let rargs_2 = map(genvar)(ctys)
          let th1 = rev_itlist(C(curry(MK_COMB)))(map(o(ASSUME)(mk_eq))(zip(largs_2)(rargs_2)))(REFL(tm))
          let th2 = (if pflag | eq_elim_RULE(th1) | th1)
          itlist((fun(e): (fun(th): CONV_RULE(imp_elim_CONV)(DISCH(e)(th)))))(hyp(th2))(th2)
    fun(tms):
      let [preds, funs] = itlist(fm_consts)(tms)([PairList [], PairList []])
      let [eqs0, noneqs] = partition((fun([t, _]): (is_const(t) && Host.hol_equal(fst(dest_const(t)))("="))))(preds)
      if Host.hol_equal(eqs0)(PairList [])
      | PairList []
      | let pcongs_2 = map(create_congruence_axiom(#true))(noneqs)
        let fcongs_2 = map(create_congruence_axiom(#false))(funs)
        let [preds1, _] = itlist(fm_consts)(map(concl)(append(pcongs_2)(fcongs_2)))([PairList [], PairList []])
        let eqs1 = filter((fun([t, _]): (is_const(t) && Host.hol_equal(fst(dest_const(t)))("="))))(preds1)
        let eqs = union(eqs0)(eqs1)
        let equivs = itlist(o(Host.union_prime(equals_thm))(create_equivalence_axioms))(eqs)(PairList [])
        append(equivs)(append(pcongs_2)(fcongs_2))

  def perform_brand_modification:
    fun subterms_irrefl_2(lconsts):
      fun(tm):
        fun(acc):
          if (is_var(tm) || is_const(tm))
          | acc
          | let [fn, args] = strip_comb(tm)
            itlist(subterms_refl_2(lconsts))(args)(acc)
    fun subterms_refl_2(lconsts):
      fun(tm):
        fun(acc):
          if is_var(tm)
          | (if mem(tm)(lconsts) | insert(tm)(acc) | acc)
          | if is_const(tm)
            | insert(tm)(acc)
            | let [fn, args] = strip_comb(tm)
              itlist(subterms_refl_2(lconsts))(args)(insert(tm)(acc))
    let CLAUSIFY:
      CONV_RULE(
        REWR_CONV(
          TAUT(
            Host.hol_term(Iff(Implies(Var("a", Bool), Var("b", Bool)), Or(Not(Var("a", Bool)), Var("b", Bool))))
          )
        )
      )
    fun BRAND(tms):
      fun(th):
        if Host.hol_equal(tms)(PairList [])
        | th
        | let tm = hd(tms)
          let gv = genvar(type_of(tm))
          let eq = mk_eq([gv, tm])
          let th_prime_2 = CLAUSIFY(DISCH(eq)(SUBS(PairList [SYM(ASSUME(eq))])(th)))
          let tms_prime_2 = map(subst(PairList [[gv, tm]]))(tl(tms))
          BRAND(tms_prime_2)(th_prime_2)
    let BRAND_CONGS:
      fun(th):
        let lconsts = freesl(hyp(th))
        let lits = disjuncts(concl(th))
        let atoms:
          map(
            fun(t):
              try:
                dest_neg(t)
                ~catch exn:
                  match exn
                  | Failure(_): t
                  | exn: Host.hol_raise(exn)
          )(lits)
        let [eqs, noneqs]:
          partition(
            fun(t):
              try:
                Host.hol_equal(fst(dest_const(fst(strip_comb(t)))))("=")
                ~catch exn:
                  match exn
                  | Failure(_): #false
                  | exn: Host.hol_raise(exn)
          )(atoms)
        let acc = itlist(subterms_irrefl_2(lconsts))(noneqs)(PairList [])
        let uts = itlist(o(o(itlist(subterms_irrefl_2(lconsts)))(snd))(strip_comb))(eqs)(acc)
        let sts = sort((fun(s): (fun(t): Host.hol_not(free_in(s)(t)))))(uts)
        BRAND(sts)(th)
    let BRANDE:
      fun(th):
        let tm = concl(th)
        let [l, r] = dest_eq(tm)
        let gv = genvar(type_of(l))
        let eq = mk_eq([r, gv])
        CLAUSIFY(DISCH(eq)(EQ_MP(AP_TERM(rator(tm))(ASSUME(eq)))(th)))
    let LDISJ_CASES = (fun(th): (fun(lth): (fun(rth): DISJ_CASES(th)(DISJ1(lth)(concl(rth)))(DISJ2(concl(lth))(rth)))))
    let ASSOCIATE = CONV_RULE(REWR_CONV(GSYM(DISJ_ASSOC)))
    fun BRAND_TRANS(th):
      let tm = concl(th)
      try:
        let [l, r] = dest_disj(tm)
        if is_eq(l)
        | let lth = ASSUME(l)
          let lth1_2 = BRANDE(lth)
          let lth2_2 = BRANDE(SYM(lth))
          let rth_2 = BRAND_TRANS(ASSUME(r))
          append(map(o(ASSOCIATE)(LDISJ_CASES(th)(lth1_2)))(rth_2))(map(o(ASSOCIATE)(LDISJ_CASES(th)(lth2_2)))(rth_2))
        | let rth = BRAND_TRANS(ASSUME(r))
          map(LDISJ_CASES(th)(ASSUME(l)))(rth)
        ~catch exn:
          match exn
          | Failure(_): (if is_eq(tm) | PairList [BRANDE(th), BRANDE(SYM(th))] | PairList [th])
          | exn: Host.hol_raise(exn)
    let find_eqs:
      find_terms(
        fun(t):
          try:
            Host.hol_equal(fst(dest_const(t)))("=")
            ~catch exn:
              match exn
              | Failure(_): #false
              | exn: Host.hol_raise(exn)
      )
    let REFLEXATE:
      fun(ths):
        let eqs = itlist(o(o(union)(find_eqs))(concl))(ths)(PairList [])
        let tys = map(o(o(o(o(hd)(snd))(dest_type))(snd))(dest_const))(eqs)
        let gvs = map(genvar)(tys)
        itlist((fun(v): (fun(acc): PairList [REFL(v), & acc])))(gvs)(ths)
    fun(ths):
      if exists(can(o(find_term(is_eq))(concl)))(ths)
      | let ths_prime = map(BRAND_CONGS)(ths)
        let ths_prime_prime = itlist(o(Host.union_prime(equals_thm))(BRAND_TRANS))(ths_prime)(PairList [])
        REFLEXATE(ths_prime_prime)
      | ths

  def POLY_ASSUME_TAC:
    fun uniq_prime(eq):
      fun(l):
        match l
        | PairList [x, & PairList [y, & _] as t]:
            let t_prime = uniq_prime(eq)(t)
            if eq(x)(y)
            | t_prime
            | (if Host.hol_physical_equal(t_prime)(t) | l | PairList [x, & t_prime])
        | _: l
    let setify_prime = (fun(le): (fun(eq): (fun(s): uniq_prime(eq)(sort(le)(s)))))
    fun grab_constants(tm):
      fun(acc):
        if (is_forall(tm) || is_exists(tm))
        | grab_constants(body(rand(tm)))(acc)
        | if (is_iff(tm) || (is_imp(tm) || (is_conj(tm) || is_disj(tm))))
          | grab_constants(rand(tm))(grab_constants(lhand(tm))(acc))
          | (if is_neg(tm) | grab_constants(rand(tm))(acc) | union(find_terms(is_const)(tm))(acc))
    let match_consts:
      fun([tm1, tm2]):
        let [s1_2, ty1_2] = dest_const(tm1)
        let [s2_2, ty2_2] = dest_const(tm2)
        (if Host.hol_equal(s1_2)(s2_2) | type_match(ty1_2)(ty2_2)(PairList []) | failwith("match_consts"))
    let polymorph:
      fun(mconsts):
        fun(th):
          let tvs = subtract(type_vars_in_term(concl(th)))(Host.unions(map(type_vars_in_term)(hyp(th))))
          if Host.hol_equal(tvs)(PairList [])
          | PairList [th]
          | let pconsts = grab_constants(concl(th))(PairList [])
            let tyins = mapfilter(match_consts)(Host.allpairs((fun(x): (fun(y): [x, y])))(pconsts)(mconsts))
            let ths_prime = setify_prime((fun(th): (fun(th_prime): Host.hol_le(dest_thm(th))(dest_thm(th_prime)))))(equals_thm)(mapfilter(C(INST_TYPE)(th))(tyins))
            if Host.hol_equal(ths_prime)(PairList [])
            | Host.warn(#true)("No useful-looking instantiations of lemma")
              PairList [th]
            | ths_prime
    fun polymorph_all(mconsts):
      fun(ths):
        fun(acc):
          if Host.hol_equal(ths)(PairList [])
          | acc
          | let ths_prime = polymorph(mconsts)(hd(ths))
            let mconsts_prime = itlist(grab_constants)(map(concl)(ths_prime))(mconsts)
            polymorph_all(mconsts_prime)(tl(ths))(Host.union_prime(equals_thm)(ths_prime)(acc))
    fun(ths):
      fun([asl, w] as gl):
        let mconsts = itlist(o(o(grab_constants)(concl))(snd))(asl)(PairList [])
        let ths_prime = polymorph_all(mconsts)(ths)(PairList [])
        MAP_EVERY(ASSUME_TAC)(ths_prime)(gl)

  curried fun SIMPLE_MESON_REFUTE(min, max, inc, ths):
    Host.hol_apply_unit(clear_contrapos_cache_v2)
    Host.ref_set(inferences)(0)
    let old_dcutin = Host.ref_get(meson_dcutin)
    (if Host.ref_get(meson_depth) | Host.ref_set(meson_dcutin)(100001) | #void)
    let ths_prime = (if Host.ref_get(meson_brand) | perform_brand_modification(ths) | append(ths)(create_equality_axioms(map(concl)(ths))))
    let rules = optimize_rules(fol_of_hol_clauses(ths_prime))
    let [proof, [insts, _, _]] = solve_goal(rules)(Host.ref_get(meson_depth))(min)(max)(inc)([1, PairList []])
    Host.ref_set(meson_dcutin)(old_dcutin)
    meson_to_hol(insts)(proof)

  curried fun CONJUNCTS_THEN_prime_impl(ttac, cth): (ttac(CONJUNCT1(cth)) then_tac ttac(CONJUNCT2(cth)))

  curried fun PURE_MESON_TAC(min, max, inc, gl):
    Host.hol_apply_unit(reset_vars_v2)
    Host.hol_apply_unit(reset_consts_v2)
    (
      FIRST_ASSUM(CONTR_TAC) or_tac \
      W(o(o(o(ACCEPT_TAC)(SIMPLE_MESON_REFUTE(min, max, inc)))(map(snd)))(fst))
    )(gl)

  def QUANT_BOOL_CONV:
    PURE_REWRITE_CONV(
      PairList [
        FORALL_BOOL_THM,
        EXISTS_BOOL_THM,
        COND_CLAUSES,
        NOT_CLAUSES,
        IMP_CLAUSES,
        AND_CLAUSES,
        OR_CLAUSES,
        EQ_CLAUSES,
        FORALL_SIMP,
        EXISTS_SIMP
      ]
    )

  curried fun SPLIT_TAC(n, g):
    (
      (
        (FIRST_X_ASSUM(CONJUNCTS_THEN_prime_impl(ASSUME_TAC)) then_tac SPLIT_TAC(n)) or_tac \
        (if Host.hol_gt(n)(0) | (FIRST_X_ASSUM(DISJ_CASES_TAC) then_tac SPLIT_TAC(Host.hol_sub(n)(1))) | NO_TAC)
      ) or_tac \
      ALL_TAC
    )(g)

  def reset_vars = reset_vars_v2

  def fol_of_var = fol_of_var_v2

  def reset_consts = reset_consts_v2

  def fol_of_const = fol_of_const_v2

  def clear_contrapos_cache = clear_contrapos_cache_v2

  def CONJUNCTS_THEN_prime = CONJUNCTS_THEN_prime_impl

curried fun GEN_MESON_TAC(min, max, step, ths):
  (
    (
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (REFUTE_THEN(ASSUME_TAC) then_tac Meson.POLY_ASSUME_TAC(map(GEN_ALL)(ths))) then_tac \
                                  W(o(MAP_EVERY(o(o(UNDISCH_TAC)(concl))(snd)))(fst))
                                ) then_tac \
                                SELECT_ELIM_TAC
                              ) then_tac \
                              W((fun([asl, w]): MAP_EVERY((fun(v): SPEC_TAC([v, v])))(frees(w))))
                            ) then_tac \
                            CONV_TAC(
                              (
                                (
                                  (
                                    (PRESIMP_CONV then_conv TOP_DEPTH_CONV(BETA_CONV)) then_conv \
                                    LAMBDA_ELIM_CONV
                                  ) then_conv \
                                  CONDS_CELIM_CONV
                                ) then_conv \
                                Meson.QUANT_BOOL_CONV
                              )
                            )
                          ) then_tac \
                          REPEAT((GEN_TAC or_tac DISCH_TAC))
                        ) then_tac \
                        REFUTE_THEN(ASSUME_TAC)
                      ) then_tac \
                      RULE_ASSUM_TAC(CONV_RULE((NNF_CONV then_conv SKOLEM_CONV)))
                    ) then_tac \
                    REPEAT(FIRST_X_ASSUM(CHOOSE_TAC))
                  ) then_tac \
                  ASM_FOL_TAC
                ) then_tac \
                Meson.SPLIT_TAC(Host.ref_get(meson_split_limit))
              ) then_tac \
              RULE_ASSUM_TAC(CONV_RULE((PRENEX_CONV then_conv WEAK_CNF_CONV)))
            ) then_tac \
            RULE_ASSUM_TAC(
              Host.repeat(
                (fun(th): SPEC(genvar(type_of(fst(dest_forall(concl(th))))))(th))
              )
            )
          ) then_tac \
          REPEAT(FIRST_X_ASSUM(Meson.CONJUNCTS_THEN_prime(ASSUME_TAC)))
        ) then_tac \
        RULE_ASSUM_TAC(CONV_RULE(ASSOC_CONV(DISJ_ASSOC)))
      ) then_tac \
      REPEAT(FIRST_X_ASSUM(SUBST_VAR_TAC))
    ) then_tac \
    Meson.PURE_MESON_TAC(min)(max)(step)
  )

def ASM_MESON_TAC = GEN_MESON_TAC(0, 50, 1)

fun MESON_TAC(ths): (POP_ASSUM_LIST(K(ALL_TAC)) then_tac ASM_MESON_TAC(ths))

curried fun MESON(ths, tm):
  let th = TAC_PROOF([[PairList [], tm], MESON_TAC(ths)])
  let [asl, tm_prime] = dest_thm(th)
  if (Host.hol_unequal(asl)(PairList []) && Host.hol_not(subset(asl)(Host.unions(map(hyp)(ths)))))
  | failwith("MESON: too many assumptions in result")
  | if Host.hol_equal(tm_prime)(tm)
    | th
    | try:
        EQ_MP(ALPHA(tm_prime)(tm))(th)
        ~catch exn:
          match exn
          | Failure(_): failwith("MESON: the wrong result")
          | exn: Host.hol_raise(exn)
