def meson_depth = Box(#false)

def meson_prefine = Box(#true)

def meson_dcutin = Box(1)

def meson_skew = Box(3)

def meson_brand = Box(#false)

def meson_split_limit = Box(8)

def meson_chatty = Box(#false)

class Cut()

variant fol_term:
  Fvar(index)
  Fnapp(symbol, arguments)

variant fol_form:
  Atom(atom)
  Conj(left, right)
  Disj(left, right)
  Forallq(variable, body)

variant fol_goal:
  Subgoal(goal, subgoals, rule, offset, local_instances)

namespace Meson:
