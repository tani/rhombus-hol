fun MESON_TAC(ths):«
  (block:«
    let port_tmp_31 = ASM_MESON_TAC(ths);
    let port_tmp_32 = Tactics.POP_ASSUM_LIST(K(Tactics.ALL_TAC));
    Tactics.THEN(port_tmp_32)(port_tmp_31)
  »)
»

fun MESON(ths):«
  (fun(tm):«
    (block:«
      let th:«
        Tactics.TAC_PROOF([[PairList [], tm], MESON_TAC(ths)])
      »;
      (block:«
        let [asl, tm_prime]:«
          Fusion.dest_thm(th)
        »;
        (block:«
          if (Host.hol_unequal(asl)(PairList []) && Host.hol_not(subset(asl)(Host.unions(map(Fusion.hyp)(ths)))))
          | failwith("MESON: too many assumptions in result")
          | (block:«
            if Host.hol_equal(tm_prime)(tm)
            | th
            | (block:«
              try:«
                Fusion.EQ_MP(Equal.ALPHA(tm_prime)(tm))(th);
                ~catch port_tmp_33:«
                  let port_tmp_34 = port_tmp_33;
                  match port_tmp_34
                  | Failure(_):«
                      failwith("MESON: the wrong result")
                  »
                  | port_tmp_33:«
                      Host.hol_raise(port_tmp_33)
                  »
                »
              »
            »)
          »)
        »)
      »)
    »)
  »)
»
