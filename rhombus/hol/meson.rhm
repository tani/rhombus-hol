fun MESON(ths):
  fun port_tmp_37(tm):
    let th = Tactics.TAC_PROOF([[PairList [], tm], MESON_TAC(ths)])
    let [asl, tm_prime] = Fusion.dest_thm(th)
    if (Host.hol_unequal(asl)(PairList []) && Host.hol_not(subset(asl)(Host.unions(map(Fusion.hyp)(ths)))))
    | failwith("MESON: too many assumptions in result")
    | if Host.hol_equal(tm_prime)(tm)
      | th
      | try:
          Fusion.EQ_MP(Equal.ALPHA(tm_prime)(tm))(th)
          ~catch port_tmp_36:
            match port_tmp_36
            | Failure(_): failwith("MESON: the wrong result")
            | port_tmp_36: Host.hol_raise(port_tmp_36)
  port_tmp_37
