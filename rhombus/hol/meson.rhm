fun GEN_MESON_TAC(min):«
  (fun(max):«
    (fun(step):«
      (fun(ths):«
        (block:«
          let port_tmp_1 = Meson.PURE_MESON_TAC(min)(max)(step);
          let port_tmp_2 = (block:«
            let port_tmp_3 = Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Tactics.SUBST_VAR_TAC));
            let port_tmp_4 = (block:«
              let port_tmp_5 = Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Canon.ASSOC_CONV(Theorems.DISJ_ASSOC)));
              let port_tmp_6 = (block:«
                let port_tmp_7 = Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Meson.CONJUNCTS_THEN_prime(Tactics.ASSUME_TAC)));
                let port_tmp_8 = (block:«
                  let port_tmp_9 = Tactics.RULE_ASSUM_TAC(Host.repeat((fun(th):«
                    Bool.SPEC(Basics.genvar(Fusion.type_of(fst(Basics.dest_forall(Fusion.concl(th))))))(th)
                  »)));
                  let port_tmp_10 = (block:«
                    let port_tmp_11 = Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.THENC(Canon.PRENEX_CONV)(Canon.WEAK_CNF_CONV)));
                    let port_tmp_12 = (block:«
                      let port_tmp_13 = Meson.SPLIT_TAC(Host.ref_get(meson_split_limit));
                      let port_tmp_14 = Tactics.THEN((block:«
                        let port_tmp_15 = Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Tactics.CHOOSE_TAC));
                        let port_tmp_16 = (block:«
                          let port_tmp_17 = Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.THENC(Canon.NNF_CONV)(Canon.SKOLEM_CONV)));
                          let port_tmp_18 = (block:«
                            let port_tmp_19 = Class.REFUTE_THEN(Tactics.ASSUME_TAC);
                            let port_tmp_20 = (block:«
                              let port_tmp_21 = Tactics.REPEAT(Tactics.ORELSE(Tactics.GEN_TAC)(Tactics.DISCH_TAC));
                              let port_tmp_22 = (block:«
                                let port_tmp_23 = Tactics.CONV_TAC(Equal.THENC(Equal.THENC(Equal.THENC(Equal.THENC(Canon.PRESIMP_CONV)(Equal.TOP_DEPTH_CONV(Equal.BETA_CONV)))(Canon.LAMBDA_ELIM_CONV))(Canon.CONDS_CELIM_CONV))(Meson.QUANT_BOOL_CONV));
                                let port_tmp_24 = (block:«
                                  let port_tmp_25 = W((fun([asl, w]):«
                                    Tactics.MAP_EVERY((fun(v):«
                                      Tactics.SPEC_TAC([v, v])
                                    »))(Fusion.frees(w))
                                  »));
                                  let port_tmp_26 = Tactics.THEN((block:«
                                    let port_tmp_27 = W(o(Tactics.MAP_EVERY(o(o(Tactics.UNDISCH_TAC)(Fusion.concl))(snd)))(fst));
                                    let port_tmp_28 = (block:«
                                      let port_tmp_29 = Meson.POLY_ASSUME_TAC(map(Bool.GEN_ALL)(ths));
                                      let port_tmp_30 = Class.REFUTE_THEN(Tactics.ASSUME_TAC);
                                      Tactics.THEN(port_tmp_30)(port_tmp_29)
                                    »);
                                    Tactics.THEN(port_tmp_28)(port_tmp_27)
                                  »))(Canon.SELECT_ELIM_TAC);
                                  Tactics.THEN(port_tmp_26)(port_tmp_25)
                                »);
                                Tactics.THEN(port_tmp_24)(port_tmp_23)
                              »);
                              Tactics.THEN(port_tmp_22)(port_tmp_21)
                            »);
                            Tactics.THEN(port_tmp_20)(port_tmp_19)
                          »);
                          Tactics.THEN(port_tmp_18)(port_tmp_17)
                        »);
                        Tactics.THEN(port_tmp_16)(port_tmp_15)
                      »))(Canon.ASM_FOL_TAC);
                      Tactics.THEN(port_tmp_14)(port_tmp_13)
                    »);
                    Tactics.THEN(port_tmp_12)(port_tmp_11)
                  »);
                  Tactics.THEN(port_tmp_10)(port_tmp_9)
                »);
                Tactics.THEN(port_tmp_8)(port_tmp_7)
              »);
              Tactics.THEN(port_tmp_6)(port_tmp_5)
            »);
            Tactics.THEN(port_tmp_4)(port_tmp_3)
