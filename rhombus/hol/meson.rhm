  def meson_Meson_offinc = 10000

  def meson_Meson_inferences = Box(0)

  fun meson_Meson_mk_negated([p, a]): [Host.hol_neg(p), a]

  fun meson_Meson_qpartition(p):
    fun(m):
      fun qpartition(l):
        if Host.hol_physical_equal(l)(m)
        | Host.hol_raise(Unchanged())
        | match l
          | PairList []: Host.hol_raise(Unchanged())
          | PairList [h, & t]:
              if p(h)
              | try:
                  let [yes, no] = qpartition(t)
                  [PairList.cons(h, yes), no]
                  ~catch exn:
                    match exn
                    | Unchanged(): [PairList.cons(h, PairList []), t]
                    | exn: Host.hol_raise(exn)
              | let [yes, no] = qpartition(t)
                [yes, PairList.cons(h, no)]
      fun(l):
        try:
          qpartition(l)
          ~catch exn:
            match exn
            | Unchanged(): [PairList [], l]
            | exn: Host.hol_raise(exn)

  def [meson_Meson_reset_vars, meson_Meson_fol_of_var, meson_Meson_hol_of_var]:
    let vstore_2 = Box(PairList [])
    let gstore_2 = Box(PairList [])
    let vcounter_2 = Box(0)
    let inc_vcounter:
      fun(_):
        let n = Host.ref_get(vcounter_2)
        let m = Host.hol_add(n)(1)
        if Host.hol_ge(m)(meson_Meson_offinc)
        | failwith("inc_vcounter: too many variables")
        | Host.ref_set(vcounter_2)(m)
          n
    let reset_vars:
      fun(_):
        Host.ref_set(vstore_2)(PairList [])
        Host.ref_set(gstore_2)(PairList [])
        Host.ref_set(vcounter_2)(0)
    let fol_of_var:
      fun(v):
        let currentvars = Host.ref_get(vstore_2)
        try:
          assoc(v)(currentvars)
          ~catch exn:
            match exn
            | Failure(_):
                let n = Host.hol_apply_unit(inc_vcounter)
                Host.ref_set(vstore_2)(PairList.cons([v, n], currentvars))
                n
            | exn: Host.hol_raise(exn)
    let hol_of_var:
      fun(v):
        try:
          rev_assoc(v)(Host.ref_get(vstore_2))
          ~catch exn:
            match exn
            | Failure(_): rev_assoc(v)(Host.ref_get(gstore_2))
            | exn: Host.hol_raise(exn)
    let hol_of_bumped_var:
      fun(v):
        try:
          hol_of_var(v)
          ~catch exn:
            match exn
            | Failure(_):
                let v_prime = Host.hol_mod(v)(meson_Meson_offinc)
                let hv_prime = hol_of_var(v_prime)
                let gv = Basics.genvar(Fusion.type_of(hv_prime))
                Host.ref_set(gstore_2)(PairList.cons([gv, v], Host.ref_get(gstore_2)))
                gv
            | exn: Host.hol_raise(exn)
    [reset_vars, fol_of_var, hol_of_bumped_var]

  def [meson_Meson_reset_consts, meson_Meson_fol_of_const, meson_Meson_hol_of_const]:
    let false_tm = Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]")
    let cstore_2 = Box(PairList [])
    let ccounter_2 = Box(2)
    let reset_consts:
      fun(_):
        Host.ref_set(cstore_2)(PairList.cons([false_tm, 1], PairList []))
        Host.ref_set(ccounter_2)(2)
    let fol_of_const:
      fun(c):
        let currentconsts = Host.ref_get(cstore_2)
        try:
          assoc(c)(currentconsts)
          ~catch exn:
            match exn
            | Failure(_):
                let n = Host.ref_get(ccounter_2)
                Host.ref_set(ccounter_2)(Host.hol_add(n)(1))
                Host.ref_set(cstore_2)(PairList.cons([c, n], currentconsts))
                n
            | exn: Host.hol_raise(exn)
    let hol_of_const = (fun(c): rev_assoc(c)(Host.ref_get(cstore_2)))
    [reset_consts, fol_of_const, hol_of_const]

  fun meson_Meson_fol_of_term(env):
    fun(consts):
      fun(tm):
        if (Fusion.is_var(tm) && Host.hol_not(mem(tm)(consts)))
        | meson_ctor_Fvar(meson_Meson_fol_of_var(tm))
        | let [f, args] = Basics.strip_comb(tm)
          if mem(f)(env)
          | failwith("fol_of_term: higher order")
          | let ff = meson_Meson_fol_of_const(f)
            meson_ctor_Fnapp(ff, map(meson_Meson_fol_of_term(env)(consts))(args))

  fun meson_Meson_fol_of_atom(env):
    fun(consts):
      fun(tm):
        let [f, args] = Basics.strip_comb(tm)
        if mem(f)(env)
        | failwith("fol_of_atom: higher order")
        | let ff = meson_Meson_fol_of_const(f)
          [ff, map(meson_Meson_fol_of_term(env)(consts))(args)]

  fun meson_Meson_fol_of_literal(env):
    fun(consts):
      fun(tm):
        try:
          let tm_prime = Basics.dest_neg(tm)
          let [p, a_2] = meson_Meson_fol_of_atom(env)(consts)(tm_prime)
          [Host.hol_neg(p), a_2]
          ~catch exn:
            match exn
            | Failure(_): meson_Meson_fol_of_atom(env)(consts)(tm)
            | exn: Host.hol_raise(exn)

  fun meson_Meson_fol_of_form(env):
    fun(consts):
      fun(tm):
        try:
          let [v, bod] = Basics.dest_forall(tm)
          let fv = meson_Meson_fol_of_var(v)
          let fbod = meson_Meson_fol_of_form(PairList.cons(v, env))(subtract(consts)(PairList.cons(v, PairList [])))(bod)
          meson_ctor_Forallq(fv, fbod)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  let [l, r] = Basics.dest_conj(tm)
                  let fl_2 = meson_Meson_fol_of_form(env)(consts)(l)
                  let fr_2 = meson_Meson_fol_of_form(env)(consts)(r)
                  meson_ctor_Conj(fl_2, fr_2)
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let [l, r] = Basics.dest_disj(tm)
                          let fl_3 = meson_Meson_fol_of_form(env)(consts)(l)
                          let fr_3 = meson_Meson_fol_of_form(env)(consts)(r)
                          meson_ctor_Disj(fl_3, fr_3)
                          ~catch exn:
                            match exn
                            | Failure(_): meson_ctor_Atom(meson_Meson_fol_of_literal(env)(consts)(tm))
                            | exn: Host.hol_raise(exn)
                    | exn: Host.hol_raise(exn)
            | exn: Host.hol_raise(exn)

  fun meson_Meson_hol_of_term(tm):
    match tm
    | meson_ctor_Fvar(v): meson_Meson_hol_of_var(v)
    | meson_ctor_Fnapp(f,args): Basics.list_mk_comb([meson_Meson_hol_of_const(f), map(meson_Meson_hol_of_term)(args)])

  fun meson_Meson_hol_of_atom([p, args]): Basics.list_mk_comb([meson_Meson_hol_of_const(p), map(meson_Meson_hol_of_term)(args)])

  fun meson_Meson_hol_of_literal([p, args]): (if Host.hol_lt(p)(0) | Bool.mk_neg(meson_Meson_hol_of_atom([Host.hol_neg(p), args])) | meson_Meson_hol_of_atom([p, args]))

  fun meson_Meson_fol_free_in(v):
    fun(tm):
      match tm
      | meson_ctor_Fvar(x): Host.hol_equal(x)(v)
      | meson_ctor_Fnapp(_,lis): exists(meson_Meson_fol_free_in(v))(lis)

  fun meson_Meson_fol_subst(theta):
    fun(tm):
      match tm
      | meson_ctor_Fvar(v): rev_assocd(v)(theta)(tm)
      | meson_ctor_Fnapp(f,args):
          let args_prime = qmap(meson_Meson_fol_subst(theta))(args)
          (if Host.hol_physical_equal(args_prime)(args) | tm | meson_ctor_Fnapp(f, args_prime))

  fun meson_Meson_fol_inst(theta):
    fun([p, args] as at):
      let args_prime = qmap(meson_Meson_fol_subst(theta))(args)
      (if Host.hol_physical_equal(args_prime)(args) | at | [p, args_prime])

  fun meson_Meson_fol_subst_bump(offset):
    fun(theta):
      fun(tm):
        match tm
        | meson_ctor_Fvar(v):
            if Host.hol_lt(v)(meson_Meson_offinc)
            | let v_prime = Host.hol_add(v)(offset)
              rev_assocd(v_prime)(theta)(meson_ctor_Fvar(v_prime))
            | rev_assocd(v)(theta)(tm)
        | meson_ctor_Fnapp(f,args):
            let args_prime = qmap(meson_Meson_fol_subst_bump(offset)(theta))(args)
            (if Host.hol_physical_equal(args_prime)(args) | tm | meson_ctor_Fnapp(f, args_prime))

  fun meson_Meson_fol_inst_bump(offset):
    fun(theta):
      fun([p, args] as at):
        let args_prime = qmap(meson_Meson_fol_subst_bump(offset)(theta))(args)
        (if Host.hol_physical_equal(args_prime)(args) | at | [p, args_prime])

  fun meson_Meson_istriv(env):
    fun(x):
      fun(t):
        match t
        | meson_ctor_Fvar(y):
            if Host.hol_equal(y)(x)
            | #true
            | try:
                let t_prime = rev_assoc(y)(env)
                meson_Meson_istriv(env)(x)(t_prime)
                ~catch exn:
                  match exn
                  | Failure("find"): #false
                  | exn: Host.hol_raise(exn)
        | meson_ctor_Fnapp(f,args): (exists(meson_Meson_istriv(env)(x))(args) && failwith("cyclic"))

  fun meson_Meson_fol_unify(offset):
    fun(tm1):
      fun(tm2):
        fun(sofar):
          match [tm1, tm2]
          | [meson_ctor_Fnapp(f,fargs), meson_ctor_Fnapp(g,gargs)]: (if Host.hol_unequal(f)(g) | failwith("") | itlist2(meson_Meson_fol_unify(offset))(fargs)(gargs)(sofar))
          | [_, meson_ctor_Fvar(x)]:
              let x_prime = Host.hol_add(x)(offset)
              try:
                let tm2_prime = rev_assoc(x_prime)(sofar)
                meson_Meson_fol_unify(0)(tm1)(tm2_prime)(sofar)
                ~catch exn:
                  match exn
                  | Failure("find"): (if meson_Meson_istriv(sofar)(x_prime)(tm1) | sofar | PairList.cons([tm1, x_prime], sofar))
                  | exn: Host.hol_raise(exn)
          | [meson_ctor_Fvar(x), _]:
              try:
                let tm1_prime = rev_assoc(x)(sofar)
                meson_Meson_fol_unify(offset)(tm1_prime)(tm2)(sofar)
                ~catch exn:
                  match exn
                  | Failure("find"):
                      let tm2_prime = meson_Meson_fol_subst_bump(offset)(PairList [])(tm2)
                      (if meson_Meson_istriv(sofar)(x)(tm2_prime) | sofar | PairList.cons([tm2_prime, x], sofar))
                  | exn: Host.hol_raise(exn)

  fun meson_Meson_fol_eq(insts):
    fun(tm1):
      fun(tm2):
        if Host.hol_physical_equal(tm1)(tm2)
        | #true
        | match [tm1, tm2]
          | [meson_ctor_Fnapp(f,fargs), meson_ctor_Fnapp(g,gargs)]: (Host.hol_equal(f)(g) && Host.forall2(meson_Meson_fol_eq(insts))(fargs)(gargs))
          | [_, meson_ctor_Fvar(x)]:
              try:
                let tm2_prime = rev_assoc(x)(insts)
                meson_Meson_fol_eq(insts)(tm1)(tm2_prime)
                ~catch exn:
                  match exn
                  | Failure("find"):
                      try:
                        meson_Meson_istriv(insts)(x)(tm1)
                        ~catch exn:
                          match exn
                          | Failure(_): #false
                          | exn: Host.hol_raise(exn)
                  | exn: Host.hol_raise(exn)
          | [meson_ctor_Fvar(x), _]:
              try:
                let tm1_prime = rev_assoc(x)(insts)
                meson_Meson_fol_eq(insts)(tm1_prime)(tm2)
                ~catch exn:
                  match exn
                  | Failure("find"):
                      try:
                        meson_Meson_istriv(insts)(x)(tm2)
                        ~catch exn:
                          match exn
                          | Failure(_): #false
                          | exn: Host.hol_raise(exn)
                  | exn: Host.hol_raise(exn)

  fun meson_Meson_fol_atom_eq(insts): (fun([p1, args1]): (fun([p2, args2]): (Host.hol_equal(p1)(p2) && Host.forall2(meson_Meson_fol_eq(insts))(args1)(args2))))

  fun meson_Meson_cacheconts(f):
    let memory = Box(PairList [])
    fun([gg, [insts, offset, size]] as input):
      (if exists((fun([_, [insts_prime, _, size_prime]]): (Host.hol_equal(insts)(insts_prime) && (Host.hol_le(size)(size_prime) || Host.ref_get(meson_depth)))))(Host.ref_get(memory)) | failwith("cachecont") | Host.ref_set(memory)(PairList.cons(input, Host.ref_get(memory))))
      f(input)

  fun meson_Meson_checkan(insts):
    fun([p, a]):
      fun(ancestors):
        let p_prime = Host.hol_neg(p)
        let t_prime = [p_prime, a]
        try:
          let ours = assoc(p_prime)(ancestors)
          (if exists((fun(u): meson_Meson_fol_atom_eq(insts)(t_prime)(snd(fst(u)))))(ours) | failwith("checkan") | ancestors)
          ~catch exn:
            match exn
            | Failure("find"): ancestors
            | exn: Host.hol_raise(exn)

  fun meson_Meson_insertan(insts):
    fun([p, a]):
      fun(ancestors):
        let p_prime = Host.hol_neg(p)
        let t_prime = [p_prime, a]
        let [ourancp, otheranc]:
          try:
            Host.remove((fun([pr, _]): Host.hol_equal(pr)(p_prime)))(ancestors)
            ~catch exn:
              match exn
              | Failure(_): [[p_prime, PairList []], ancestors]
              | exn: Host.hol_raise(exn)
        let ouranc = snd(ourancp)
        (if exists((fun(u): meson_Meson_fol_atom_eq(insts)(t_prime)(snd(fst(u)))))(ouranc) | failwith("insertan: loop") | PairList.cons([p_prime, PairList.cons([[PairList [], t_prime], [0, Bool.TRUTH]], ouranc)], otheranc))

  fun meson_Meson_fol_subst_partial(insts):
    fun(tm):
      match tm
      | meson_ctor_Fvar(v):
          try:
            let t = rev_assoc(v)(insts)
            meson_Meson_fol_subst_partial(insts)(t)
            ~catch exn:
              match exn
              | Failure("find"): tm
              | exn: Host.hol_raise(exn)
      | meson_ctor_Fnapp(f,args): meson_ctor_Fnapp(f, map(meson_Meson_fol_subst_partial(insts))(args))

  fun meson_Meson_separate_insts(offset):
    fun(oldinsts):
      fun(newinsts):
        let [locins, globins] = meson_Meson_qpartition((fun([_, v]): Host.hol_le(offset)(v)))(oldinsts)(newinsts)
        (if Host.hol_equal(globins)(oldinsts) | [map((fun([t, x]): [meson_Meson_fol_subst_partial(newinsts)(t), x]))(locins), oldinsts] | [map((fun([t, x]): [meson_Meson_fol_subst_partial(newinsts)(t), x]))(locins), map((fun([t, x]): [meson_Meson_fol_subst_partial(newinsts)(t), x]))(globins)])

  fun meson_Meson_meson_single_expand(loffset):
    fun(rule):
      fun([[g, ancestors], [insts, offset, size]]):
        let [[hyps, conc], tag] = rule
        let allins = Host.rev_itlist2(meson_Meson_fol_unify(loffset))(snd(g))(snd(conc))(insts)
        let [locin, globin] = meson_Meson_separate_insts(offset)(insts)(allins)
        let mk_ihyp:
          fun(h):
            let h_prime = meson_Meson_fol_inst_bump(offset)(locin)(h)
            [h_prime, meson_Meson_checkan(insts)(h_prime)(ancestors)]
        let newhyps = map(mk_ihyp)(hyps)
        Host.ref_set(meson_Meson_inferences)(Host.hol_add(Host.ref_get(meson_Meson_inferences))(1))
        [newhyps, [globin, Host.hol_add(offset)(meson_Meson_offinc), Host.hol_sub(size)(length(hyps))]]

  fun meson_Meson_meson_expand_cont(loffset): (fun(rules): (fun(state): (fun(cont): tryfind((fun(r): cont(snd(r))(meson_Meson_meson_single_expand(loffset)(r)(state))))(rules))))

  fun meson_Meson_meson_expand(rules):
    fun([[g, ancestors], [insts, offset, size] as tup]):
      fun(cont):
        let pr = fst(g)
        let newancestors = meson_Meson_insertan(insts)(g)(ancestors)
        let newstate = [[g, newancestors], tup]
        try:
          if (Host.ref_get(meson_prefine) && Host.hol_gt(pr)(0))
          | failwith("meson_expand")
          | let arules = assoc(pr)(ancestors)
            meson_Meson_meson_expand_cont(0)(arules)(newstate)(cont)
          ~catch exn:
            match exn
            | Cut(): failwith("meson_expand")
            | Failure(_):
                try:
                  let crules = filter((fun([[h, _], _]): Host.hol_le(length(h))(size)))(assoc(pr)(rules))
                  meson_Meson_meson_expand_cont(offset)(crules)(newstate)(cont)
                  ~catch exn:
                    match exn
                    | Cut(): failwith("meson_expand")
                    | Failure(_): failwith("meson_expand")
                    | exn: Host.hol_raise(exn)
            | exn: Host.hol_raise(exn)

  fun meson_Meson_expand_goal(rules):
    fun expand_goal_2(depth):
      fun([[g, _], [insts, offset, size]] as state):
        fun(cont):
          if Host.hol_lt(depth)(0)
          | failwith("expand_goal: too deep")
          | meson_Meson_meson_expand(rules)(state)(
              fun(apprule):
                fun([_, [pinsts, _, _]] as newstate):
                  expand_goals_2(Host.hol_sub(depth)(1))(newstate)(
                    meson_Meson_cacheconts(
                      fun([gs, [newinsts, newoffset, newsize]]):
                        let [locin, globin] = meson_Meson_separate_insts(offset)(pinsts)(newinsts)
                        let g_prime = meson_ctor_Subgoal(g, gs, apprule, offset, locin)
                        if (Host.hol_equal(globin)(insts) && Host.hol_equal(gs)(PairList []))
                        | try:
                            cont([g_prime, [globin, newoffset, size]])
                            ~catch exn:
                              match exn
                              | Failure(_): Host.hol_raise(Cut())
                              | exn: Host.hol_raise(exn)
                        | try:
                            cont([g_prime, [globin, newoffset, newsize]])
                            ~catch exn:
                              match exn
                              | Cut(): failwith("expand_goal")
                              | Failure(_): failwith("expand_goal")
                              | exn: Host.hol_raise(exn))))
    fun expand_goals_2(depth):
      fun([gl, [insts, offset, size] as tup]):
        fun(cont):
          match gl
          | PairList []: cont([PairList [], tup])
          | PairList [g, & PairList []]: expand_goal_2(depth)([g, tup])((fun([g_prime, stup]): cont([PairList.cons(g_prime, PairList []), stup])))
          | gl:
              if Host.hol_ge(size)(Host.ref_get(meson_dcutin))
              | let lsize = Host.hol_div(size)(Host.ref_get(meson_skew))
                let rsize = Host.hol_sub(size)(lsize)
                let [lgoals, rgoals] = Host.chop_list(Host.hol_div(length(gl))(2))(gl)
                try:
                  expand_goals_2(depth)([lgoals, [insts, offset, lsize]])(meson_Meson_cacheconts((fun([lg_prime, [i, off, n]]): expand_goals_2(depth)([rgoals, [i, off, Host.hol_add(n)(rsize)]])(meson_Meson_cacheconts((fun([rg_prime, ztup]): cont([append(lg_prime)(rg_prime), ztup])))))))
                  ~catch exn:
                    match exn
                    | Failure(_): expand_goals_2(depth)([rgoals, [insts, offset, lsize]])(meson_Meson_cacheconts((fun([rg_prime, [i, off, n]]): expand_goals_2(depth)([lgoals, [i, off, Host.hol_add(n)(rsize)]])(meson_Meson_cacheconts((fun([lg_prime, [_, _, fsize] as ztup]): (if Host.hol_le(Host.hol_add(n)(rsize))(Host.hol_add(lsize)(fsize)) | failwith("repetition of demigoal pair") | cont([append(lg_prime)(rg_prime), ztup]))))))))
                    | exn: Host.hol_raise(exn)
              | let PairList [g, & gs] = gl
                expand_goal_2(depth)([g, tup])(meson_Meson_cacheconts((fun([g_prime, stup]): expand_goals_2(depth)([gs, stup])(meson_Meson_cacheconts((fun([gs_prime, ftup]): cont([PairList.cons(g_prime, gs_prime), ftup])))))))
    (fun(g): (fun(maxdep): (fun(maxinf): (fun(cont): expand_goal_2(maxdep)([g, [PairList [], Host.hol_mul(2)(meson_Meson_offinc), maxinf]])(cont)))))

  fun meson_Meson_solve_goal(rules):
    fun(incdepth):
      fun(min):
        fun(max):
          fun(incsize):
            fun solve(n):
              fun(g):
                if Host.hol_gt(n)(max)
                | failwith("solve_goal: Too deep")
                | if (Host.ref_get(meson_chatty) && Host.ref_get(Host.verbose))
                  | Host.hol_print_string(Host.hol_concat(Host.hol_string_of_int(Host.ref_get(meson_Meson_inferences)))(Host.hol_concat(" inferences so far. ")(Host.hol_concat("Searching with maximum size ")(Host.hol_concat(Host.hol_string_of_int(n))(".")))))
                    Host.hol_apply_unit(Host.hol_print_newline)
                  | if Host.ref_get(Host.verbose)
                    | Host.hol_print_string(Host.hol_concat(Host.hol_string_of_int(Host.ref_get(meson_Meson_inferences)))(".."))
                      Host.hol_apply_unit(Host.hol_print_flush)
                    | #void
                try:
                  let gi = (if incdepth | meson_Meson_expand_goal(rules)(g)(n)(100000)((fun(x): x)) | meson_Meson_expand_goal(rules)(g)(100000)(n)((fun(x): x)))
                  if (Host.ref_get(meson_chatty) && Host.ref_get(Host.verbose))
                  | Host.hol_print_string(Host.hol_concat("Goal solved with ")(Host.hol_concat(Host.hol_string_of_int(Host.ref_get(meson_Meson_inferences)))(" inferences.")))
                    Host.hol_apply_unit(Host.hol_print_newline)
                  | if Host.ref_get(Host.verbose)
                    | Host.hol_print_string(Host.hol_concat("solved at ")(Host.hol_string_of_int(Host.ref_get(meson_Meson_inferences))))
                      Host.hol_apply_unit(Host.hol_print_newline)
                    | #void
                  gi
                  ~catch exn:
                    match exn
                    | Failure(_): solve(Host.hol_add(n)(incsize))(g)
                    | exn: Host.hol_raise(exn)
            (fun(g): solve(min)([g, PairList []]))

  def meson_Meson_fol_of_hol_clauses:
    let eqt = (fun([a1, [b1, c1]]): (fun([a2, [b2, c2]]): (Host.hol_equal(a1)(a2) && (Host.hol_equal(b1)(b2) && Fusion.equals_thm(c1)(c2)))))
    fun mk_contraposes(n):
      fun(th):
        fun(used):
          fun(unused):
            fun(sofar):
              match unused
              | PairList []: sofar
              | PairList [h, & t]:
                  let nw = [[map(meson_Meson_mk_negated)(append(used)(t)), h], [n, th]]
                  mk_contraposes(Host.hol_add(n)(1))(th)(append(used)(PairList.cons(h, PairList [])))(t)(PairList.cons(nw, sofar))
    let fol_of_hol_clause:
      fun(th):
        let lconsts = Fusion.freesl(Fusion.hyp(th))
        let tm = Fusion.concl(th)
        let hlits = Basics.disjuncts(tm)
        let flits = map(meson_Meson_fol_of_literal(PairList [])(lconsts))(hlits)
        let basics = mk_contraposes(0)(th)(PairList [])(flits)(PairList [])
        (if forall((fun([p, _]): Host.hol_lt(p)(0)))(flits) | PairList.cons([[map(meson_Meson_mk_negated)(flits), [1, PairList []]], [-1, th]], basics) | basics)
    fun(thms):
      let rawrules = itlist(o(Host.union_prime(eqt))(fol_of_hol_clause))(thms)(PairList [])
      let prs = Host.setify(map(o(o(fst)(snd))(fst))(rawrules))
      let prules = map((fun(t): [t, filter(o(o(o(Host.hol_equal(t))(fst))(snd))(fst))(rawrules)]))(prs)
      let srules = sort((fun([p, _]): (fun([q, _]): Host.hol_le(Host.abs(p))(Host.abs(q)))))(prules)
      srules

  def meson_Meson_optimize_rules:
    let optimize_clause_order = (fun(cls): sort((fun([[l1, _], _]): (fun([[l2, _], _]): Host.hol_le(length(l1))(length(l2)))))(cls))
    map((fun([a, b]): [a, optimize_clause_order(b)]))

  def [meson_Meson_clear_contrapos_cache, meson_Meson_make_hol_contrapos]:
    let DISJ_AC_2 = Theorems.AC(Theorems.DISJ_ACI)
    let imp_CONV_2 = Simp.REWR_CONV(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]]")))
    let push_CONV_2 = Simp.GEN_REWRITE_CONV(Equal.TOP_SWEEP_CONV)(PairList.cons(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]]]")), PairList.cons(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]")), PairList [])))
    let pull_CONV_2 = Simp.GEN_REWRITE_CONV(Equal.DEPTH_CONV)(PairList.cons(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]]]")), PairList []))
    let imf_CONV_2 = Simp.REWR_CONV(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]],[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]]]")))
    let memory = Box(PairList [])
    let clear_contrapos_cache = (fun(_): Host.ref_set(memory)(PairList []))
    let make_hol_contrapos:
      fun([n, th]):
        let tm = Fusion.concl(th)
        let key = [n, tm]
        try:
          assoc(key)(Host.ref_get(memory))
          ~catch exn:
            match exn
            | Failure(_):
                if Host.hol_lt(n)(0)
                | Equal.CONV_RULE(Equal.THENC(pull_CONV_2)(imf_CONV_2))(th)
                | let djs = Basics.disjuncts(tm)
                  let acth:
                    if Host.hol_equal(n)(0)
                    | th
                    | let [ldjs, rdjs] = Host.chop_list(n)(djs)
                      let ndjs = PairList.cons(hd(rdjs), append(ldjs)(tl(rdjs)))
                      Fusion.EQ_MP(DISJ_AC_2(Fusion.mk_eq([tm, Bool.list_mk_disj(ndjs)])))(th)
                  let fth = (if Host.hol_equal(length(djs))(1) | acth | Equal.CONV_RULE(Equal.THENC(imp_CONV_2)(push_CONV_2))(acth))
                  Host.ref_set(memory)(PairList.cons([key, fth], Host.ref_get(memory)))
                  fth
            | exn: Host.hol_raise(exn)
    [clear_contrapos_cache, make_hol_contrapos]

  def meson_Meson_finish_RULE = Simp.GEN_REWRITE_RULE(I)(PairList.cons(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]]")), PairList.cons(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]]]")), PairList [])))

  def meson_Meson_meson_to_hol:
    let hol_negate:
      fun(tm):
        try:
          Basics.dest_neg(tm)
          ~catch exn:
            match exn
            | Failure(_): Bool.mk_neg(tm)
            | exn: Host.hol_raise(exn)
    let merge_inst = (fun([t, x]): (fun(current): PairList.cons([meson_Meson_fol_subst(current)(t), x], current)))
    fun meson_to_hol(insts):
      fun(meson_ctor_Subgoal(g,gs,[n, th],offset,locin)):
        let newins = itlist(merge_inst)(locin)(insts)
        let g_prime = meson_Meson_fol_inst(newins)(g)
        let hol_g = meson_Meson_hol_of_literal(g_prime)
        let ths = map(meson_to_hol(newins))(gs)
        let hth:
          if Fusion.equals_thm(th)(Bool.TRUTH)
          | Fusion.ASSUME(hol_g)
          | let cth = meson_Meson_make_hol_contrapos([n, th])
            (if Host.hol_equal(ths)(PairList []) | cth | Drule.MATCH_MP(cth)(end_itlist(Bool.CONJ)(ths)))
        let ith = Drule.PART_MATCH(I)(hth)(hol_g)
        meson_Meson_finish_RULE(Bool.DISCH(hol_negate(Fusion.concl(ith)))(ith))
    meson_to_hol

  def meson_Meson_create_equality_axioms:
    let eq_thms = o(Bool.CONJUNCTS)(Tactics.prove)([Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"z\",[\"Tyvar\",\"A\"]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]],[\"Var\",\"z\",[\"Tyvar\",\"A\"]]]]]]"), Tactics.THEN(Tactics.THEN(Tactics.THEN(Simp.REWRITE_TAC(PairList []))(Class.ASM_CASES_TAC(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]"))))(Simp.ASM_REWRITE_TAC(PairList [])))(Tactics.CONV_TAC(Class.TAUT))])
    let imp_elim_CONV = Simp.REWR_CONV(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]]")))
    let eq_elim_RULE = Drule.MATCH_MP(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]]]")))
    let veq_tm = Fusion.rator(Fusion.rator(Fusion.concl(hd(eq_thms))))
    let create_equivalence_axioms:
      fun([eq, _]):
        let tyins = Basics.type_match(Fusion.type_of(veq_tm))(Fusion.type_of(eq))(PairList [])
        map(Fusion.INST_TYPE(tyins))(eq_thms)
    fun tm_consts(tm):
      fun(acc):
        let [fn, args] = Basics.strip_comb(tm)
        (if Host.hol_equal(args)(PairList []) | acc | itlist(tm_consts)(args)(insert([fn, length(args)])(acc)))
    fun fm_consts(tm):
      fun([preds, funs] as acc):
        try:
          fm_consts(snd(Basics.dest_forall(tm)))(acc)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  fm_consts(snd(Basics.dest_exists(tm)))(acc)
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let [l, r] = Basics.dest_conj(tm)
                          fm_consts(l)(fm_consts(r)(acc))
                          ~catch exn:
                            match exn
                            | Failure(_):
                                try:
                                  let [l, r] = Basics.dest_disj(tm)
                                  fm_consts(l)(fm_consts(r)(acc))
                                  ~catch exn:
                                    match exn
                                    | Failure(_):
                                        try:
                                          let [l, r] = Basics.dest_imp(tm)
                                          fm_consts(l)(fm_consts(r)(acc))
                                          ~catch exn:
                                            match exn
                                            | Failure(_):
                                                try:
                                                  fm_consts(Basics.dest_neg(tm))(acc)
                                                  ~catch exn:
                                                    match exn
                                                    | Failure(_):
                                                        try:
                                                          let [l, r] = Fusion.dest_eq(tm)
                                                          (if Host.hol_equal(Fusion.type_of(l))(Fusion.bool_ty) | fm_consts(r)(fm_consts(l)(acc)) | failwith("atomic equality"))
                                                          ~catch exn:
                                                            match exn
                                                            | Failure(_):
                                                                let [pred, args] = Basics.strip_comb(tm)
                                                                (if Host.hol_equal(args)(PairList []) | acc | [insert([pred, length(args)])(preds), itlist(tm_consts)(args)(funs)])
                                                            | exn: Host.hol_raise(exn)
                                                    | exn: Host.hol_raise(exn)
                                            | exn: Host.hol_raise(exn)
                                    | exn: Host.hol_raise(exn)
                            | exn: Host.hol_raise(exn)
                    | exn: Host.hol_raise(exn)
            | exn: Host.hol_raise(exn)
    let create_congruence_axiom:
      fun(pflag):
        fun([tm, len]):
          let [atys, rty]:
            splitlist(
              fun(ty):
                let [op, l] = Fusion.dest_type(ty)
                (if Host.hol_equal(op)("fun") | [hd(l), hd(tl(l))] | Host.hol_apply_unit(fail)))(Fusion.type_of(tm))
          let ctys = fst(Host.chop_list(len)(atys))
          let largs_2 = map(Basics.genvar)(ctys)
          let rargs_2 = map(Basics.genvar)(ctys)
          let th1 = rev_itlist(C(curry(Fusion.MK_COMB)))(map(o(Fusion.ASSUME)(Fusion.mk_eq))(zip(largs_2)(rargs_2)))(Fusion.REFL(tm))
          let th2 = (if pflag | eq_elim_RULE(th1) | th1)
          itlist((fun(e): (fun(th): Equal.CONV_RULE(imp_elim_CONV)(Bool.DISCH(e)(th)))))(Fusion.hyp(th2))(th2)
    fun(tms):
      let [preds, funs] = itlist(fm_consts)(tms)([PairList [], PairList []])
      let [eqs0, noneqs] = partition((fun([t, _]): (Fusion.is_const(t) && Host.hol_equal(fst(Fusion.dest_const(t)))("="))))(preds)
      if Host.hol_equal(eqs0)(PairList [])
      | PairList []
      | let pcongs_2 = map(create_congruence_axiom(#true))(noneqs)
        let fcongs_2 = map(create_congruence_axiom(#false))(funs)
        let [preds1, _] = itlist(fm_consts)(map(Fusion.concl)(append(pcongs_2)(fcongs_2)))([PairList [], PairList []])
        let eqs1 = filter((fun([t, _]): (Fusion.is_const(t) && Host.hol_equal(fst(Fusion.dest_const(t)))("="))))(preds1)
        let eqs = union(eqs0)(eqs1)
        let equivs = itlist(o(Host.union_prime(Fusion.equals_thm))(create_equivalence_axioms))(eqs)(PairList [])
        append(equivs)(append(pcongs_2)(fcongs_2))

  def meson_Meson_perform_brand_modification:
    fun subterms_irrefl_2(lconsts):
      fun(tm):
        fun(acc):
          if (Fusion.is_var(tm) || Fusion.is_const(tm))
          | acc
          | let [fn, args] = Basics.strip_comb(tm)
            itlist(subterms_refl_2(lconsts))(args)(acc)
    fun subterms_refl_2(lconsts):
      fun(tm):
        fun(acc):
          if Fusion.is_var(tm)
          | (if mem(tm)(lconsts) | insert(tm)(acc) | acc)
          | if Fusion.is_const(tm)
            | insert(tm)(acc)
            | let [fn, args] = Basics.strip_comb(tm)
              itlist(subterms_refl_2(lconsts))(args)(insert(tm)(acc))
    let CLAUSIFY = Equal.CONV_RULE(Simp.REWR_CONV(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]]"))))
    fun BRAND(tms):
      fun(th):
        if Host.hol_equal(tms)(PairList [])
        | th
        | let tm = hd(tms)
          let gv = Basics.genvar(Fusion.type_of(tm))
          let eq = Fusion.mk_eq([gv, tm])
          let th_prime_2 = CLAUSIFY(Bool.DISCH(eq)(Equal.SUBS(PairList.cons(Equal.SYM(Fusion.ASSUME(eq)), PairList []))(th)))
          let tms_prime_2 = map(Basics.subst(PairList.cons([gv, tm], PairList [])))(tl(tms))
          BRAND(tms_prime_2)(th_prime_2)
    let BRAND_CONGS:
      fun(th):
        let lconsts = Fusion.freesl(Fusion.hyp(th))
        let lits = Basics.disjuncts(Fusion.concl(th))
        let atoms:
          map(
            fun(t):
              try:
                Basics.dest_neg(t)
                ~catch exn:
                  match exn
                  | Failure(_): t
                  | exn: Host.hol_raise(exn))(lits)
        let [eqs, noneqs]:
          partition(
            fun(t):
              try:
                Host.hol_equal(fst(Fusion.dest_const(fst(Basics.strip_comb(t)))))("=")
                ~catch exn:
                  match exn
                  | Failure(_): #false
                  | exn: Host.hol_raise(exn))(atoms)
        let acc = itlist(subterms_irrefl_2(lconsts))(noneqs)(PairList [])
        let uts = itlist(o(o(itlist(subterms_irrefl_2(lconsts)))(snd))(Basics.strip_comb))(eqs)(acc)
        let sts = sort((fun(s): (fun(t): Host.hol_not(Basics.free_in(s)(t)))))(uts)
        BRAND(sts)(th)
    let BRANDE:
      fun(th):
        let tm = Fusion.concl(th)
        let [l, r] = Fusion.dest_eq(tm)
        let gv = Basics.genvar(Fusion.type_of(l))
        let eq = Fusion.mk_eq([r, gv])
        CLAUSIFY(Bool.DISCH(eq)(Fusion.EQ_MP(Equal.AP_TERM(Fusion.rator(tm))(Fusion.ASSUME(eq)))(th)))
    let LDISJ_CASES = (fun(th): (fun(lth): (fun(rth): Bool.DISJ_CASES(th)(Bool.DISJ1(lth)(Fusion.concl(rth)))(Bool.DISJ2(Fusion.concl(lth))(rth)))))
    let ASSOCIATE = Equal.CONV_RULE(Simp.REWR_CONV(Equal.GSYM(Theorems.DISJ_ASSOC)))
    fun BRAND_TRANS(th):
      let tm = Fusion.concl(th)
      try:
        let [l, r] = Basics.dest_disj(tm)
        if Fusion.is_eq(l)
        | let lth = Fusion.ASSUME(l)
          let lth1_2 = BRANDE(lth)
          let lth2_2 = BRANDE(Equal.SYM(lth))
          let rth_2 = BRAND_TRANS(Fusion.ASSUME(r))
          append(map(o(ASSOCIATE)(LDISJ_CASES(th)(lth1_2)))(rth_2))(map(o(ASSOCIATE)(LDISJ_CASES(th)(lth2_2)))(rth_2))
        | let rth = BRAND_TRANS(Fusion.ASSUME(r))
          map(LDISJ_CASES(th)(Fusion.ASSUME(l)))(rth)
        ~catch exn:
          match exn
          | Failure(_): (if Fusion.is_eq(tm) | PairList.cons(BRANDE(th), PairList.cons(BRANDE(Equal.SYM(th)), PairList [])) | PairList.cons(th, PairList []))
          | exn: Host.hol_raise(exn)
    let find_eqs:
      Basics.find_terms(
        fun(t):
          try:
            Host.hol_equal(fst(Fusion.dest_const(t)))("=")
            ~catch exn:
              match exn
              | Failure(_): #false
              | exn: Host.hol_raise(exn))
    let REFLEXATE:
      fun(ths):
        let eqs = itlist(o(o(union)(find_eqs))(Fusion.concl))(ths)(PairList [])
        let tys = map(o(o(o(o(hd)(snd))(Fusion.dest_type))(snd))(Fusion.dest_const))(eqs)
        let gvs = map(Basics.genvar)(tys)
        itlist((fun(v): (fun(acc): PairList.cons(Fusion.REFL(v), acc))))(gvs)(ths)
    fun(ths):
      if exists(can(o(Basics.find_term(Fusion.is_eq))(Fusion.concl)))(ths)
      | let ths_prime = map(BRAND_CONGS)(ths)
        let ths_prime_prime = itlist(o(Host.union_prime(Fusion.equals_thm))(BRAND_TRANS))(ths_prime)(PairList [])
        REFLEXATE(ths_prime_prime)
      | ths

  def meson_Meson_POLY_ASSUME_TAC:
    fun uniq_prime(eq):
      fun(l):
        match l
        | PairList [x, & PairList [y, & _] as t]:
            let t_prime = uniq_prime(eq)(t)
            if eq(x)(y)
            | t_prime
            | (if Host.hol_physical_equal(t_prime)(t) | l | PairList.cons(x, t_prime))
        | _: l
    let setify_prime = (fun(le): (fun(eq): (fun(s): uniq_prime(eq)(sort(le)(s)))))
    fun grab_constants(tm):
      fun(acc):
        if (Basics.is_forall(tm) || Basics.is_exists(tm))
        | grab_constants(Basics.body(Fusion.rand(tm)))(acc)
        | if (Bool.is_iff(tm) || (Basics.is_imp(tm) || (Basics.is_conj(tm) || Basics.is_disj(tm))))
          | grab_constants(Fusion.rand(tm))(grab_constants(Equal.lhand(tm))(acc))
          | (if Basics.is_neg(tm) | grab_constants(Fusion.rand(tm))(acc) | union(Basics.find_terms(Fusion.is_const)(tm))(acc))
    let match_consts:
      fun([tm1, tm2]):
        let [s1_2, ty1_2] = Fusion.dest_const(tm1)
        let [s2_2, ty2_2] = Fusion.dest_const(tm2)
        (if Host.hol_equal(s1_2)(s2_2) | Basics.type_match(ty1_2)(ty2_2)(PairList []) | failwith("match_consts"))
    let polymorph:
      fun(mconsts):
        fun(th):
          let tvs = subtract(Fusion.type_vars_in_term(Fusion.concl(th)))(Host.unions(map(Fusion.type_vars_in_term)(Fusion.hyp(th))))
          if Host.hol_equal(tvs)(PairList [])
          | PairList.cons(th, PairList [])
          | let pconsts = grab_constants(Fusion.concl(th))(PairList [])
            let tyins = mapfilter(match_consts)(Host.allpairs((fun(x): (fun(y): [x, y])))(pconsts)(mconsts))
            let ths_prime = setify_prime((fun(th): (fun(th_prime): Host.hol_le(Fusion.dest_thm(th))(Fusion.dest_thm(th_prime)))))(Fusion.equals_thm)(mapfilter(C(Fusion.INST_TYPE)(th))(tyins))
            if Host.hol_equal(ths_prime)(PairList [])
            | Host.warn(#true)("No useful-looking instantiations of lemma")
              PairList.cons(th, PairList [])
            | ths_prime
    fun polymorph_all(mconsts):
      fun(ths):
        fun(acc):
          if Host.hol_equal(ths)(PairList [])
          | acc
          | let ths_prime = polymorph(mconsts)(hd(ths))
            let mconsts_prime = itlist(grab_constants)(map(Fusion.concl)(ths_prime))(mconsts)
            polymorph_all(mconsts_prime)(tl(ths))(Host.union_prime(Fusion.equals_thm)(ths_prime)(acc))
    fun(ths):
      fun([asl, w] as gl):
        let mconsts = itlist(o(o(grab_constants)(Fusion.concl))(snd))(asl)(PairList [])
        let ths_prime = polymorph_all(mconsts)(ths)(PairList [])
        Tactics.MAP_EVERY(Tactics.ASSUME_TAC)(ths_prime)(gl)

  fun meson_Meson_SIMPLE_MESON_REFUTE(min):
    fun(max):
      fun(inc):
        fun(ths):
          Host.hol_apply_unit(meson_Meson_clear_contrapos_cache)
          Host.ref_set(meson_Meson_inferences)(0)
          let old_dcutin = Host.ref_get(meson_dcutin)
          (if Host.ref_get(meson_depth) | Host.ref_set(meson_dcutin)(100001) | #void)
          let ths_prime = (if Host.ref_get(meson_brand) | meson_Meson_perform_brand_modification(ths) | append(ths)(meson_Meson_create_equality_axioms(map(Fusion.concl)(ths))))
          let rules = meson_Meson_optimize_rules(meson_Meson_fol_of_hol_clauses(ths_prime))
          let [proof, [insts, _, _]] = meson_Meson_solve_goal(rules)(Host.ref_get(meson_depth))(min)(max)(inc)([1, PairList []])
          Host.ref_set(meson_dcutin)(old_dcutin)
          meson_Meson_meson_to_hol(insts)(proof)

  fun meson_Meson_CONJUNCTS_THEN_prime(ttac): (fun(cth): Tactics.THEN(ttac(Bool.CONJUNCT1(cth)))(ttac(Bool.CONJUNCT2(cth))))

  fun meson_Meson_PURE_MESON_TAC(min):
    fun(max):
      fun(inc):
        fun(gl):
          Host.hol_apply_unit(meson_Meson_reset_vars)
          Host.hol_apply_unit(meson_Meson_reset_consts)
          Tactics.ORELSE(Tactics.FIRST_ASSUM(Tactics.CONTR_TAC))(W(o(o(o(Tactics.ACCEPT_TAC)(meson_Meson_SIMPLE_MESON_REFUTE(min)(max)(inc)))(map(snd)))(fst)))(gl)

  def meson_Meson_QUANT_BOOL_CONV = Simp.PURE_REWRITE_CONV(PairList.cons(Class.FORALL_BOOL_THM, PairList.cons(Class.EXISTS_BOOL_THM, PairList.cons(Class.COND_CLAUSES, PairList.cons(Class.NOT_CLAUSES, PairList.cons(Theorems.IMP_CLAUSES, PairList.cons(Theorems.AND_CLAUSES, PairList.cons(Theorems.OR_CLAUSES, PairList.cons(Theorems.EQ_CLAUSES, PairList.cons(Theorems.FORALL_SIMP, PairList.cons(Theorems.EXISTS_SIMP, PairList [])))))))))))

  fun meson_Meson_SPLIT_TAC(n): (fun(g): Tactics.ORELSE(Tactics.ORELSE(Tactics.THEN(Tactics.FIRST_X_ASSUM(meson_Meson_CONJUNCTS_THEN_prime(Tactics.ASSUME_TAC)))(meson_Meson_SPLIT_TAC(n)))((if Host.hol_gt(n)(0) | Tactics.THEN(Tactics.FIRST_X_ASSUM(Tactics.DISJ_CASES_TAC))(meson_Meson_SPLIT_TAC(Host.hol_sub(n)(1))) | Tactics.NO_TAC)))(Tactics.ALL_TAC)(g))

