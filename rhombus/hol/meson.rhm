  ASM_MESON_TAC
  MESON_TAC
  MESON

def meson_depth = Box(#false)

def meson_prefine = Box(#true)

def meson_dcutin = Box(1)

def meson_skew = Box(3)

def meson_brand = Box(#false)

def meson_split_limit = Box(8)

def meson_chatty = Box(#false)

class Cut()

variant fol_term:
  Fvar(index)
  Fnapp(symbol, arguments)

variant fol_form:
  Atom(atom)
  Conj(left, right)
  Disj(left, right)
  Forallq(variable, body)

variant fol_goal:
  Subgoal(goal, subgoals, rule, offset, local_instances)

namespace Meson:
  export:
    offinc
    inferences
    mk_negated
    qpartition
    rename reset_vars_v2 as reset_vars
    rename fol_of_var_v2 as fol_of_var
    hol_of_var
    rename reset_consts_v2 as reset_consts
    rename fol_of_const_v2 as fol_of_const
    hol_of_const
    fol_of_term
    fol_of_atom
    fol_of_literal
    fol_of_form
    hol_of_term
    hol_of_atom
    hol_of_literal
    fol_free_in
    fol_subst
    fol_inst
    fol_subst_bump
    fol_inst_bump
    istriv
    fol_unify
    fol_eq
    fol_atom_eq
    cacheconts
    checkan
    insertan
    fol_subst_partial
    separate_insts
    meson_single_expand
    meson_expand_cont
    meson_expand
    expand_goal
    solve_goal
    fol_of_hol_clauses
    optimize_rules
    rename clear_contrapos_cache_v2 as clear_contrapos_cache
    make_hol_contrapos
    finish_RULE
    meson_to_hol
    create_equality_axioms
    perform_brand_modification
    POLY_ASSUME_TAC
    SIMPLE_MESON_REFUTE
    rename CONJUNCTS_THEN_prime_impl as CONJUNCTS_THEN_prime
    PURE_MESON_TAC
    QUANT_BOOL_CONV
    SPLIT_TAC

  def offinc = 10000

  def inferences = Box(0)

  fun mk_negated([p, a]): [(-p), a]

  fun qpartition(p):
    fun(m):
      fun qpartition(l):
        if (l === m)
        | (throw Unchanged())
        | match l
          | PairList []: (throw Unchanged())
          | PairList [h, & t]:
              if p(h)
              | try:
                  let [yes, no] = qpartition(t)
                  [PairList [h, & yes], no]
                  ~catch exn:
                    match exn
                    | Unchanged(): [PairList [h], t]
                    | exn: (throw exn)
              | let [yes, no] = qpartition(t)
                [yes, PairList [h, & no]]
      fun(l):
        try:
          qpartition(l)
          ~catch exn:
            match exn
            | Unchanged(): [PairList [], l]
            | exn: (throw exn)

  def [reset_vars_v2, fol_of_var_v2, hol_of_var]:
    let vstore_2 = Box(PairList [])
    let gstore_2 = Box(PairList [])
    let vcounter_2 = Box(0)
    let inc_vcounter:
      fun(_):
        let n = vcounter_2.value
        let m = (n + 1)
        if (m >= offinc)
        | failwith("inc_vcounter: too many variables")
        | vcounter_2.value := m
          n
    let reset_vars:
      fun(_):
        vstore_2.value := PairList []
        gstore_2.value := PairList []
        vcounter_2.value := 0
    let fol_of_var:
      fun(v):
        let currentvars = vstore_2.value
        try:
          assoc(v)(currentvars)
          ~catch exn:
            match exn
            | Failure(_):
                let n = inc_vcounter(#void)
                vstore_2.value := PairList [[v, n], & currentvars]
                n
            | exn: (throw exn)
    let hol_of_var:
      fun(v):
        try:
          rev_assoc(v)(vstore_2.value)
          ~catch exn:
            match exn
            | Failure(_): rev_assoc(v)(gstore_2.value)
            | exn: (throw exn)
    let hol_of_bumped_var:
      fun(v):
        try:
          hol_of_var(v)
          ~catch exn:
            match exn
            | Failure(_):
                let v_prime = (v rem offinc)
                let hv_prime = hol_of_var(v_prime)
                let gv = genvar(type_of(hv_prime))
                gstore_2.value := PairList [[gv, v], & gstore_2.value]
                gv
            | exn: (throw exn)
    [reset_vars, fol_of_var, hol_of_bumped_var]

  def [reset_consts_v2, fol_of_const_v2, hol_of_const]:
    let false_tm = @hol|{F}|
    let cstore_2 = Box(PairList [])
    let ccounter_2 = Box(2)
    let reset_consts:
      fun(_):
        cstore_2.value := PairList [[false_tm, 1]]
        ccounter_2.value := 2
    let fol_of_const:
      fun(c):
        let currentconsts = cstore_2.value
        try:
          assoc(c)(currentconsts)
          ~catch exn:
            match exn
            | Failure(_):
                let n = ccounter_2.value
                ccounter_2.value := n + 1
                cstore_2.value := PairList [[c, n], & currentconsts]
                n
            | exn: (throw exn)
    let hol_of_const = (fun(c): rev_assoc(c)(cstore_2.value))
    [reset_consts, fol_of_const, hol_of_const]

  fun fol_of_term(env):
    fun(consts):
      fun(tm):
        if (is_var(tm) && !mem(tm)(consts))
        | Fvar(fol_of_var_v2(tm))
        | let [f, args] = strip_comb(tm)
          if mem(f)(env)
          | failwith("fol_of_term: higher order")
          | let ff = fol_of_const_v2(f)
            Fnapp(ff, map(fol_of_term(env)(consts))(args))

  fun fol_of_atom(env):
    fun(consts):
      fun(tm):
        let [f, args] = strip_comb(tm)
        if mem(f)(env)
        | failwith("fol_of_atom: higher order")
        | let ff = fol_of_const_v2(f)
          [ff, map(fol_of_term(env)(consts))(args)]

  fun fol_of_literal(env):
    fun(consts):
      fun(tm):
        try:
          let tm_prime = dest_neg(tm)
          let [p, a_2] = fol_of_atom(env)(consts)(tm_prime)
          [(-p), a_2]
          ~catch exn:
            match exn
            | Failure(_): fol_of_atom(env)(consts)(tm)
            | exn: (throw exn)

  fun fol_of_form(env):
    fun(consts):
      fun(tm):
        try:
          let [v, bod] = dest_forall(tm)
          let fv = fol_of_var_v2(v)
          let fbod = fol_of_form(PairList [v, & env])(subtract(consts)(PairList [v]))(bod)
          Forallq(fv, fbod)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  let [l, r] = dest_conj(tm)
                  let fl_2 = fol_of_form(env)(consts)(l)
                  let fr_2 = fol_of_form(env)(consts)(r)
                  Conj(fl_2, fr_2)
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let [l, r] = dest_disj(tm)
                          let fl_3 = fol_of_form(env)(consts)(l)
                          let fr_3 = fol_of_form(env)(consts)(r)
                          Disj(fl_3, fr_3)
                          ~catch exn:
                            match exn
                            | Failure(_): Atom(fol_of_literal(env)(consts)(tm))
                            | exn: (throw exn)
                    | exn: (throw exn)
            | exn: (throw exn)

  fun hol_of_term(tm):
    match tm
    | Fvar(v): hol_of_var(v)
    | Fnapp(f,args): list_mk_comb([hol_of_const(f), map(hol_of_term)(args)])

  fun hol_of_atom([p, args]): list_mk_comb([hol_of_const(p), map(hol_of_term)(args)])

  fun hol_of_literal([p, args]): (if (p < 0) | mk_neg(hol_of_atom([(-p), args])) | hol_of_atom([p, args]))

  fun fol_free_in(v):
    fun(tm):
      match tm
      | Fvar(x): (x == v)
      | Fnapp(_,lis): exists(fol_free_in(v))(lis)

  fun fol_subst(theta):
    fun(tm):
      match tm
      | Fvar(v): rev_assocd(v)(theta)(tm)
      | Fnapp(f,args):
          let args_prime = qmap(fol_subst(theta))(args)
          (if (args_prime === args) | tm | Fnapp(f, args_prime))

  fun fol_inst(theta):
    fun([p, args] as at):
      let args_prime = qmap(fol_subst(theta))(args)
      (if (args_prime === args) | at | [p, args_prime])

  fun fol_subst_bump(offset):
    fun(theta):
      fun(tm):
        match tm
        | Fvar(v):
            if (v < offinc)
            | let v_prime = (v + offset)
              rev_assocd(v_prime)(theta)(Fvar(v_prime))
            | rev_assocd(v)(theta)(tm)
        | Fnapp(f,args):
            let args_prime = qmap(fol_subst_bump(offset)(theta))(args)
            (if (args_prime === args) | tm | Fnapp(f, args_prime))

  fun fol_inst_bump(offset):
    fun(theta):
      fun([p, args] as at):
        let args_prime = qmap(fol_subst_bump(offset)(theta))(args)
        (if (args_prime === args) | at | [p, args_prime])

  fun istriv(env):
    fun(x):
      fun(t):
        match t
        | Fvar(y):
            if (y == x)
            | #true
            | try:
                let t_prime = rev_assoc(y)(env)
                istriv(env)(x)(t_prime)
                ~catch exn:
                  match exn
                  | Failure("find"): #false
                  | exn: (throw exn)
        | Fnapp(f,args): (exists(istriv(env)(x))(args) && failwith("cyclic"))

  fun fol_unify(offset):
    fun(tm1):
      fun(tm2):
        fun(sofar):
          match [tm1, tm2]
          | [Fnapp(f,fargs), Fnapp(g,gargs)]: (if (f != g) | failwith("") | itlist2(fol_unify(offset))(fargs)(gargs)(sofar))
          | [_, Fvar(x)]:
              let x_prime = (x + offset)
              try:
                let tm2_prime = rev_assoc(x_prime)(sofar)
                fol_unify(0)(tm1)(tm2_prime)(sofar)
                ~catch exn:
                  match exn
                  | Failure("find"): (if istriv(sofar)(x_prime)(tm1) | sofar | PairList [[tm1, x_prime], & sofar])
                  | exn: (throw exn)
          | [Fvar(x), _]:
              try:
                let tm1_prime = rev_assoc(x)(sofar)
                fol_unify(offset)(tm1_prime)(tm2)(sofar)
                ~catch exn:
                  match exn
                  | Failure("find"):
                      let tm2_prime = fol_subst_bump(offset)(PairList [])(tm2)
                      (if istriv(sofar)(x)(tm2_prime) | sofar | PairList [[tm2_prime, x], & sofar])
                  | exn: (throw exn)

  fun fol_eq(insts):
    fun(tm1):
      fun(tm2):
        if (tm1 === tm2)
        | #true
        | match [tm1, tm2]
          | [Fnapp(f,fargs), Fnapp(g,gargs)]: ((f == g) && forall2(fol_eq(insts))(fargs)(gargs))
          | [_, Fvar(x)]:
              try:
                let tm2_prime = rev_assoc(x)(insts)
                fol_eq(insts)(tm1)(tm2_prime)
                ~catch exn:
                  match exn
                  | Failure("find"):
                      try:
                        istriv(insts)(x)(tm1)
                        ~catch exn:
                          match exn
                          | Failure(_): #false
                          | exn: (throw exn)
                  | exn: (throw exn)
          | [Fvar(x), _]:
              try:
                let tm1_prime = rev_assoc(x)(insts)
                fol_eq(insts)(tm1_prime)(tm2)
                ~catch exn:
                  match exn
                  | Failure("find"):
                      try:
                        istriv(insts)(x)(tm2)
                        ~catch exn:
                          match exn
                          | Failure(_): #false
                          | exn: (throw exn)
                  | exn: (throw exn)

  fun fol_atom_eq(insts): fun([p1, args1]): fun([p2, args2]): ((p1 == p2) && forall2(fol_eq(insts))(args1)(args2))

  fun cacheconts(f):
    let memory = Box(PairList [])
    fun([gg, [insts, offset, size]] as input):
      if (
        exists(
          (fun([_, [insts_prime, _, size_prime]]): ((insts == insts_prime) && ((size <= size_prime) || meson_depth.value)))
        )(memory.value)
      )
      | failwith("cachecont")
      | memory.value := PairList [input, & memory.value]
      f(input)

  fun checkan(insts):
    fun([p, a]):
      fun(ancestors):
        let p_prime = (-p)
        let t_prime = [p_prime, a]
        try:
          let ours = assoc(p_prime)(ancestors)
          (if exists((fun(u): fol_atom_eq(insts)(t_prime)(snd(fst(u)))))(ours) | failwith("checkan") | ancestors)
          ~catch exn:
            match exn
            | Failure("find"): ancestors
            | exn: (throw exn)

  fun insertan(insts):
    fun([p, a]):
      fun(ancestors):
        let p_prime = (-p)
        let t_prime = [p_prime, a]
        let [ourancp, otheranc]:
          try:
            remove((fun([pr, _]): (pr == p_prime)))(ancestors)
            ~catch exn:
              match exn
              | Failure(_): [[p_prime, PairList []], ancestors]
              | exn: (throw exn)
        let ouranc = snd(ourancp)
        (if exists((fun(u): fol_atom_eq(insts)(t_prime)(snd(fst(u)))))(ouranc) | failwith("insertan: loop") | PairList [[p_prime, PairList [[[PairList [], t_prime], [0, TRUTH]], & ouranc]], & otheranc])

  fun fol_subst_partial(insts):
    fun(tm):
      match tm
      | Fvar(v):
          try:
            let t = rev_assoc(v)(insts)
            fol_subst_partial(insts)(t)
            ~catch exn:
              match exn
              | Failure("find"): tm
              | exn: (throw exn)
      | Fnapp(f,args): Fnapp(f, map(fol_subst_partial(insts))(args))

  fun separate_insts(offset):
    fun(oldinsts):
      fun(newinsts):
        let [locins, globins] = qpartition((fun([_, v]): (offset <= v)))(oldinsts)(newinsts)
        if (globins == oldinsts)
        | [map((fun([t, x]): [fol_subst_partial(newinsts)(t), x]))(locins), oldinsts]
        | [
            map((fun([t, x]): [fol_subst_partial(newinsts)(t), x]))(locins),
            map((fun([t, x]): [fol_subst_partial(newinsts)(t), x]))(globins)
          ]

  fun meson_single_expand(loffset):
    fun(rule):
      fun([[g, ancestors], [insts, offset, size]]):
        let [[hyps, conc], tag] = rule
        let allins = rev_itlist2(fol_unify(loffset))(snd(g))(snd(conc))(insts)
        let [locin, globin] = separate_insts(offset)(insts)(allins)
        let mk_ihyp:
          fun(h):
            let h_prime = fol_inst_bump(offset)(locin)(h)
            [h_prime, checkan(insts)(h_prime)(ancestors)]
        let newhyps = map(mk_ihyp)(hyps)
        inferences.value := inferences.value + 1
        [newhyps, [globin, (offset + offinc), (size - length(hyps))]]

  fun meson_expand_cont(loffset): fun(rules): fun(state): fun(cont): tryfind((fun(r): cont(snd(r))(meson_single_expand(loffset)(r)(state))))(rules)

  fun meson_expand(rules):
    fun([[g, ancestors], [insts, offset, size] as tup]):
      fun(cont):
        let pr = fst(g)
        let newancestors = insertan(insts)(g)(ancestors)
        let newstate = [[g, newancestors], tup]
        try:
          if (meson_prefine.value && (pr > 0))
          | failwith("meson_expand")
          | let arules = assoc(pr)(ancestors)
            meson_expand_cont(0)(arules)(newstate)(cont)
          ~catch exn:
            match exn
            | Cut(): failwith("meson_expand")
            | Failure(_):
                try:
                  let crules = filter((fun([[h, _], _]): (length(h) <= size)))(assoc(pr)(rules))
                  meson_expand_cont(offset)(crules)(newstate)(cont)
                  ~catch exn:
                    match exn
                    | Cut(): failwith("meson_expand")
                    | Failure(_): failwith("meson_expand")
                    | exn: (throw exn)
            | exn: (throw exn)

  fun expand_goal(rules):
    // Mutually recursive goal expansion needs local definitions for forward references.
    fun expand_goal_2(depth):
      fun([[g, _], [insts, offset, size]] as state):
        fun(cont):
          if (depth < 0)
          | failwith("expand_goal: too deep")
          | meson_expand(
              rules)(
              state)(
              fun(apprule):
                fun([_, [pinsts, _, _]] as newstate):
                  expand_goals_2((depth - 1))(newstate)(
                    cacheconts(
                      fun([gs, [newinsts, newoffset, newsize]]):
                        let [locin, globin] = separate_insts(offset)(pinsts)(newinsts)
                        let g_prime = Subgoal(g, gs, apprule, offset, locin)
                        if ((globin == insts) && (gs == (PairList [])))
                        | try:
                            cont([g_prime, [globin, newoffset, size]])
                            ~catch exn:
                              match exn
                              | Failure(_): (throw Cut())
                              | exn: (throw exn)
                        | try:
                            cont([g_prime, [globin, newoffset, newsize]])
                            ~catch exn:
                              match exn
                              | Cut(): failwith("expand_goal")
                              | Failure(_): failwith("expand_goal")
                              | exn: (throw exn)
                    )
                  )
            )
    // Mutually recursive goal expansion needs local definitions for forward references.
    fun expand_goals_2(depth):
      fun([gl, [insts, offset, size] as tup]):
        fun(cont):
          match gl
          | PairList []: cont([PairList [], tup])
          | PairList [g, & PairList []]: expand_goal_2(depth)([g, tup])((fun([g_prime, stup]): cont([PairList [g_prime], stup])))
          | gl:
              if (size >= meson_dcutin.value)
              | let lsize = (size div meson_skew.value)
                let rsize = (size - lsize)
                let [lgoals, rgoals] = chop_list((length(gl) div 2))(gl)
                try:
                  expand_goals_2(depth)([lgoals, [insts, offset, lsize]])(
                    cacheconts(
                      (fun([lg_prime, [i, off, n]]): expand_goals_2(depth)([rgoals, [i, off, (n + rsize)]])(cacheconts((fun([rg_prime, ztup]): cont([append(lg_prime)(rg_prime), ztup])))))
                    )
                  )
                  ~catch exn:
                    match exn
                    | Failure(_):
                        expand_goals_2(depth)([rgoals, [insts, offset, lsize]])(
                          cacheconts(
                            fun([rg_prime, [i, off, n]]):
                              expand_goals_2(depth)([lgoals, [i, off, (n + rsize)]])(
                                cacheconts(
                                  (fun([lg_prime, [_, _, fsize] as ztup]): (if ((n + rsize) <= (lsize + fsize)) | failwith("repetition of demigoal pair") | cont([append(lg_prime)(rg_prime), ztup])))
                                )
                              )
                          )
                        )
                    | exn: (throw exn)
              | let PairList [g, & gs] = gl
                expand_goal_2(depth)([g, tup])(
                  cacheconts(
                    (fun([g_prime, stup]): expand_goals_2(depth)([gs, stup])(cacheconts((fun([gs_prime, ftup]): cont([PairList [g_prime, & gs_prime], ftup])))))
                  )
                )
    fun(g): fun(maxdep): fun(maxinf): fun(cont): expand_goal_2(maxdep)([g, [PairList [], (2 * offinc), maxinf]])(cont)

  fun solve_goal(rules):
    fun(incdepth):
      fun(min):
        fun(max):
          fun(incsize):
            // Recursive deepening needs the local definition before its first use.
            fun solve(n):
              fun(g):
                if (n > max)
                | failwith("solve_goal: Too deep")
                | if (meson_chatty.value && verbose.value)
                  | print((to_string(inferences.value) +& (" inferences so far. " +& ("Searching with maximum size " +& (to_string(n) +& ".")))))
                    println("")
                  | if verbose.value
                    | print((to_string(inferences.value) +& ".."))
                      Host.hol_print_flush()
                    | #void
                try:
                  let gi = (if incdepth | expand_goal(rules)(g)(n)(100000)((fun(x): x)) | expand_goal(rules)(g)(100000)(n)((fun(x): x)))
                  if (meson_chatty.value && verbose.value)
                  | print(("Goal solved with " +& (to_string(inferences.value) +& " inferences.")))
                    println("")
                  | if verbose.value
                    | print(("solved at " +& to_string(inferences.value)))
                      println("")
                    | #void
                  gi
                  ~catch exn:
                    match exn
                    | Failure(_): solve((n + incsize))(g)
                    | exn: (throw exn)
            fun(g): solve(min)([g, PairList []])

  def fol_of_hol_clauses:
    let eqt = fun([a1, [b1, c1]]): fun([a2, [b2, c2]]): ((a1 == a2) && ((b1 == b2) && equals_thm(c1)(c2)))
    // Recursive contrapositive construction needs the local definition before its first use.
    fun mk_contraposes(n):
      fun(th):
        fun(used):
          fun(unused):
            fun(sofar):
              match unused
              | PairList []: sofar
              | PairList [h, & t]:
                  let nw = [[map(mk_negated)(append(used)(t)), h], [n, th]]
                  mk_contraposes((n + 1))(th)(append(used)(PairList [h]))(t)(PairList [nw, & sofar])
    let fol_of_hol_clause:
      fun(th):
        let lconsts = freesl(hyp(th))
        let tm = concl(th)
        let hlits = disjuncts(tm)
        let flits = map(fol_of_literal(PairList [])(lconsts))(hlits)
        let basics = mk_contraposes(0)(th)(PairList [])(flits)(PairList [])
        (if forall((fun([p, _]): (p < 0)))(flits) | PairList [[[map(mk_negated)(flits), [1, PairList []]], [-1, th]], & basics] | basics)
    fun(thms):
      let rawrules = itlist(o(union_prime(eqt))(fol_of_hol_clause))(thms)(PairList [])
      let prs = setify(map(o(o(fst)(snd))(fst))(rawrules))
      let prules = map((fun(t): [t, filter(o(o(o((fun (y): t == y))(fst))(snd))(fst))(rawrules)]))(prs)
      let srules = sort(fun([p, _]): fun([q, _]): (math.abs(p) <= math.abs(q)))(prules)
      srules

  def optimize_rules:
    let optimize_clause_order = (fun(cls): sort(fun([[l1, _], _]): fun([[l2, _], _]): (length(l1) <= length(l2)))(cls))
    map((fun([a, b]): [a, optimize_clause_order(b)]))

  def [clear_contrapos_cache_v2, make_hol_contrapos]:
    let DISJ_AC_2 = AC(DISJ_ACI)
    let imp_CONV_2:
      REWR_CONV(
        TAUT(
          @hol|{a \/ b <=> ~b ==> a}|
        )
      )
    let push_CONV_2:
      GEN_REWRITE_CONV(TOP_SWEEP_CONV)(
        PairList [
          TAUT(
            @hol|{~(a \/ b) <=> ~a /\ ~b}|
          ),
          TAUT(@hol|{~(~a) <=> a}|)
        ]
      )
    let pull_CONV_2:
      GEN_REWRITE_CONV(DEPTH_CONV)(
        PairList [
          TAUT(
            @hol|{~a \/ ~b <=> ~(a /\ b)}|
          )
        ]
      )
    let imf_CONV_2 = REWR_CONV(TAUT(@hol|{~p <=> p ==> F}|))
    let memory = Box(PairList [])
    let clear_contrapos_cache = (fun(_): (memory.value := (PairList [])))
    let make_hol_contrapos:
      fun([n, th]):
        let tm = concl(th)
        let key = [n, tm]
        try:
          assoc(key)(memory.value)
          ~catch exn:
            match exn
            | Failure(_):
                if (n < 0)
                | CONV_RULE(pull_CONV_2 then_conv imf_CONV_2)(th)
                | let djs = disjuncts(tm)
                  let acth:
                    if (n == 0)
                    | th
                    | let [ldjs, rdjs] = chop_list(n)(djs)
                      let ndjs = PairList [hd(rdjs), & append(ldjs)(tl(rdjs))]
                      EQ_MP(DISJ_AC_2(mk_eq([tm, list_mk_disj(ndjs)])))(th)
                  let fth = (if (length(djs) == 1) | acth | CONV_RULE(imp_CONV_2 then_conv push_CONV_2)(acth))
                  memory.value := PairList [[key, fth], & memory.value]
                  fth
            | exn: (throw exn)
    [clear_contrapos_cache, make_hol_contrapos]

  def finish_RULE:
    GEN_REWRITE_RULE(I)(
      PairList [
        TAUT(@hol|{(~p ==> p) <=> p}|),
        TAUT(@hol|{(p ==> ~p) <=> ~p}|)
      ]
    )

  def meson_to_hol:
    let hol_negate:
      fun(tm):
        try:
          dest_neg(tm)
          ~catch exn:
            match exn
            | Failure(_): mk_neg(tm)
            | exn: (throw exn)
    let merge_inst = fun([t, x]): fun(current): PairList [[fol_subst(current)(t), x], & current]
    // Recursive proof translation needs the local definition before its first use.
    fun meson_to_hol(insts):
      fun(Subgoal(g,gs,[n, th],offset,locin)):
        let newins = itlist(merge_inst)(locin)(insts)
        let g_prime = fol_inst(newins)(g)
        let hol_g = hol_of_literal(g_prime)
        let ths = map(meson_to_hol(newins))(gs)
        let hth:
          if equals_thm(th)(TRUTH)
          | ASSUME(hol_g)
          | let cth = make_hol_contrapos([n, th])
            (if (ths == (PairList [])) | cth | MATCH_MP(cth)(end_itlist(CONJ)(ths)))
        let ith = PART_MATCH(I)(hth)(hol_g)
        finish_RULE(DISCH(hol_negate(concl(ith)))(ith))
    meson_to_hol

  def create_equality_axioms:
    let eq_thms:
      o(CONJUNCTS)(prove)(
        [
          @hol|{(x:A = x) /\
             (~(x:A = y) \/ ~(x = z) \/ (y = z))}|,
          REWRITE_TAC(PairList []) then_tac \
          ASM_CASES_TAC(@hol|{x:A = y}|) then_tac \
          ASM_REWRITE_TAC(PairList []) then_tac \
          CONV_TAC(TAUT)
        ]
      )
    let imp_elim_CONV:
      REWR_CONV(
        TAUT(
          @hol|{(a ==> b) <=> ~a \/ b}|
        )
      )
    let eq_elim_RULE:
      MATCH_MP(
        TAUT(
          @hol|{(a <=> b) ==> b \/ ~a}|
        )
      )
    let veq_tm = rator(rator(concl(hd(eq_thms))))
    let create_equivalence_axioms:
      fun([eq, _]):
        let tyins = type_match(type_of(veq_tm))(type_of(eq))(PairList [])
        map(INST_TYPE(tyins))(eq_thms)
    // Recursive term collection needs the local definition before its first use.
    fun tm_consts(tm):
      fun(acc):
        let [fn, args] = strip_comb(tm)
        (if (args == (PairList [])) | acc | itlist(tm_consts)(args)(insert([fn, length(args)])(acc)))
    // Recursive formula collection needs the local definition before its first use.
    fun fm_consts(tm):
      fun([preds, funs] as acc):
        try:
          fm_consts(snd(dest_forall(tm)))(acc)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  fm_consts(snd(dest_exists(tm)))(acc)
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let [l, r] = dest_conj(tm)
                          fm_consts(l)(fm_consts(r)(acc))
                          ~catch exn:
                            match exn
                            | Failure(_):
                                try:
                                  let [l, r] = dest_disj(tm)
                                  fm_consts(l)(fm_consts(r)(acc))
                                  ~catch exn:
                                    match exn
                                    | Failure(_):
                                        try:
                                          let [l, r] = dest_imp(tm)
                                          fm_consts(l)(fm_consts(r)(acc))
                                          ~catch exn:
                                            match exn
                                            | Failure(_):
                                                try:
                                                  fm_consts(dest_neg(tm))(acc)
                                                  ~catch exn:
                                                    match exn
                                                    | Failure(_):
                                                        try:
                                                          let [l, r] = dest_eq(tm)
                                                          (if (type_of(l) == bool_ty) | fm_consts(r)(fm_consts(l)(acc)) | failwith("atomic equality"))
                                                          ~catch exn:
                                                            match exn
                                                            | Failure(_):
                                                                let [pred, args] = strip_comb(tm)
                                                                (if (args == (PairList [])) | acc | [insert([pred, length(args)])(preds), itlist(tm_consts)(args)(funs)])
                                                            | exn: (throw exn)
                                                    | exn: (throw exn)
                                            | exn: (throw exn)
                                    | exn: (throw exn)
                            | exn: (throw exn)
                    | exn: (throw exn)
            | exn: (throw exn)
    let create_congruence_axiom:
      fun(pflag):
        fun([tm, len]):
          let [atys, rty]:
            splitlist(
              fun(ty):
                let [op, l] = dest_type(ty)
                (if (op == "fun") | [hd(l), hd(tl(l))] | fail())
            )(type_of(tm))
          let ctys = fst(chop_list(len)(atys))
          let largs_2 = map(genvar)(ctys)
          let rargs_2 = map(genvar)(ctys)
          let th1 = rev_itlist(C(curry(MK_COMB)))(map(o(ASSUME)(mk_eq))(zip(largs_2)(rargs_2)))(REFL(tm))
          let th2 = (if pflag | eq_elim_RULE(th1) | th1)
          itlist(fun(e): fun(th): CONV_RULE(imp_elim_CONV)(DISCH(e)(th)))(hyp(th2))(th2)
    fun(tms):
      let [preds, funs] = itlist(fm_consts)(tms)([PairList [], PairList []])
      let [eqs0, noneqs] = partition((fun([t, _]): (is_const(t) && (fst(dest_const(t)) == "="))))(preds)
      if (eqs0 == (PairList []))
      | PairList []
      | let pcongs_2 = map(create_congruence_axiom(#true))(noneqs)
        let fcongs_2 = map(create_congruence_axiom(#false))(funs)
        let [preds1, _] = itlist(fm_consts)(map(concl)(append(pcongs_2)(fcongs_2)))([PairList [], PairList []])
        let eqs1 = filter((fun([t, _]): (is_const(t) && (fst(dest_const(t)) == "="))))(preds1)
        let eqs = union(eqs0)(eqs1)
        let equivs = itlist(o(union_prime(equals_thm))(create_equivalence_axioms))(eqs)(PairList [])
        append(equivs)(append(pcongs_2)(fcongs_2))

  def perform_brand_modification:
    // Mutual recursion needs both local definitions, including the forward reference.
    fun subterms_irrefl_2(lconsts):
      fun(tm):
        fun(acc):
          if (is_var(tm) || is_const(tm))
          | acc
          | let [fn, args] = strip_comb(tm)
            itlist(subterms_refl_2(lconsts))(args)(acc)
    // Mutual recursion needs both local definitions before use.
    fun subterms_refl_2(lconsts):
      fun(tm):
        fun(acc):
          if is_var(tm)
          | (if mem(tm)(lconsts) | insert(tm)(acc) | acc)
          | if is_const(tm)
            | insert(tm)(acc)
            | let [fn, args] = strip_comb(tm)
              itlist(subterms_refl_2(lconsts))(args)(insert(tm)(acc))
    let CLAUSIFY:
      CONV_RULE(
        REWR_CONV(
          TAUT(
            @hol|{a ==> b <=> ~a \/ b}|
          )
        )
      )
    // Recursive clause branding needs the local definition before its first use.
    fun BRAND(tms):
      fun(th):
        if (tms == (PairList []))
        | th
        | let tm = hd(tms)
          let gv = genvar(type_of(tm))
          let eq = mk_eq([gv, tm])
          let th_prime_2 = CLAUSIFY(DISCH(eq)(SUBS(PairList [SYM(ASSUME(eq))])(th)))
          let tms_prime_2 = map(subst(PairList [[gv, tm]]))(tl(tms))
          BRAND(tms_prime_2)(th_prime_2)
    let BRAND_CONGS:
      fun(th):
        let lconsts = freesl(hyp(th))
        let lits = disjuncts(concl(th))
        let atoms:
          map(
            fun(t):
              try:
                dest_neg(t)
                ~catch exn:
                  match exn
                  | Failure(_): t
                  | exn: (throw exn)
          )(lits)
        let [eqs, noneqs]:
          partition(
            fun(t):
              try:
                (fst(dest_const(fst(strip_comb(t)))) == "=")
                ~catch exn:
                  match exn
                  | Failure(_): #false
                  | exn: (throw exn)
          )(atoms)
        let acc = itlist(subterms_irrefl_2(lconsts))(noneqs)(PairList [])
        let uts = itlist(o(o(itlist(subterms_irrefl_2(lconsts)))(snd))(strip_comb))(eqs)(acc)
        let sts = sort(fun(s): fun(t): !free_in(s)(t))(uts)
        BRAND(sts)(th)
    let BRANDE:
      fun(th):
        let tm = concl(th)
        let [l, r] = dest_eq(tm)
        let gv = genvar(type_of(l))
        let eq = mk_eq([r, gv])
        CLAUSIFY(DISCH(eq)(EQ_MP(AP_TERM(rator(tm))(ASSUME(eq)))(th)))
    let LDISJ_CASES = fun(th): fun(lth): fun(rth): DISJ_CASES(th)(DISJ1(lth)(concl(rth)))(DISJ2(concl(lth))(rth))
    let ASSOCIATE = CONV_RULE(REWR_CONV(GSYM(DISJ_ASSOC)))
    fun BRAND_TRANS(th):
      let tm = concl(th)
      try:
        let [l, r] = dest_disj(tm)
        if is_eq(l)
        | let lth = ASSUME(l)
          let lth1_2 = BRANDE(lth)
          let lth2_2 = BRANDE(SYM(lth))
          let rth_2 = BRAND_TRANS(ASSUME(r))
          append(map(o(ASSOCIATE)(LDISJ_CASES(th)(lth1_2)))(rth_2))(map(o(ASSOCIATE)(LDISJ_CASES(th)(lth2_2)))(rth_2))
        | let rth = BRAND_TRANS(ASSUME(r))
          map(LDISJ_CASES(th)(ASSUME(l)))(rth)
        ~catch exn:
          match exn
          | Failure(_): (if is_eq(tm) | PairList [BRANDE(th), BRANDE(SYM(th))] | PairList [th])
          | exn: (throw exn)
    let find_eqs:
      find_terms(
        fun(t):
          try:
            (fst(dest_const(t)) == "=")
            ~catch exn:
              match exn
              | Failure(_): #false
              | exn: (throw exn)
      )
    let REFLEXATE:
      fun(ths):
        let eqs = itlist(o(o(union)(find_eqs))(concl))(ths)(PairList [])
        let tys = map(o(o(o(o(hd)(snd))(dest_type))(snd))(dest_const))(eqs)
        let gvs = map(genvar)(tys)
        itlist(fun(v): fun(acc): PairList [REFL(v), & acc])(gvs)(ths)
    fun(ths):
      if exists(can(o(find_term(is_eq))(concl)))(ths)
      | let ths_prime = map(BRAND_CONGS)(ths)
        let ths_prime_prime = itlist(o(union_prime(equals_thm))(BRAND_TRANS))(ths_prime)(PairList [])
        REFLEXATE(ths_prime_prime)
      | ths

  def POLY_ASSUME_TAC:
    // Recursive deduplication needs the local definition before its first use.
    fun uniq_prime(eq):
      fun(l):
        match l
        | PairList [x, & PairList [y, & _] as t]:
            let t_prime = uniq_prime(eq)(t)
            if eq(x)(y)
            | t_prime
            | (if (t_prime === t) | l | PairList [x, & t_prime])
        | _: l
    let setify_prime = fun(le): fun(eq): fun(s): uniq_prime(eq)(sort(le)(s))
    // Recursive collection needs the local definition before its first use.
    fun grab_constants(tm):
      fun(acc):
        if (is_forall(tm) || is_exists(tm))
        | grab_constants(body(rand(tm)))(acc)
        | if (is_iff(tm) || (is_imp(tm) || (is_conj(tm) || is_disj(tm))))
          | grab_constants(rand(tm))(grab_constants(lhand(tm))(acc))
          | (if is_neg(tm) | grab_constants(rand(tm))(acc) | union(find_terms(is_const)(tm))(acc))
    let match_consts:
      fun([tm1, tm2]):
        let [s1_2, ty1_2] = dest_const(tm1)
        let [s2_2, ty2_2] = dest_const(tm2)
        (if (s1_2 == s2_2) | type_match(ty1_2)(ty2_2)(PairList []) | failwith("match_consts"))
    let polymorph:
      fun(mconsts):
        fun(th):
          let tvs = subtract(type_vars_in_term(concl(th)))(unions(map(type_vars_in_term)(hyp(th))))
          if (tvs == (PairList []))
          | PairList [th]
          | let pconsts = grab_constants(concl(th))(PairList [])
            let tyins = mapfilter(match_consts)(allpairs(fun(x): fun(y): [x, y])(pconsts)(mconsts))
            let ths_prime = setify_prime(fun(th): fun(th_prime): polymorphic_le(dest_thm(th))(dest_thm(th_prime)))(equals_thm)(mapfilter(C(INST_TYPE)(th))(tyins))
            if (ths_prime == (PairList []))
            | warn(#true)("No useful-looking instantiations of lemma")
              PairList [th]
            | ths_prime
    // Recursive polymorphization needs the local definition before its first use.
    fun polymorph_all(mconsts):
      fun(ths):
        fun(acc):
          if (ths == (PairList []))
          | acc
          | let ths_prime = polymorph(mconsts)(hd(ths))
            let mconsts_prime = itlist(grab_constants)(map(concl)(ths_prime))(mconsts)
            polymorph_all(mconsts_prime)(tl(ths))(union_prime(equals_thm)(ths_prime)(acc))
    fun(ths):
      fun([asl, w] as gl):
        let mconsts = itlist(o(o(grab_constants)(concl))(snd))(asl)(PairList [])
        let ths_prime = polymorph_all(mconsts)(ths)(PairList [])
        MAP_EVERY(ASSUME_TAC)(ths_prime)(gl)

  fun SIMPLE_MESON_REFUTE(min):
    fun(max):
      fun(inc):
        fun(ths):
          clear_contrapos_cache_v2(#void)
          inferences.value := 0
          let old_dcutin = meson_dcutin.value
          (if meson_depth.value | (meson_dcutin.value := 100001) | #void)
          let ths_prime = (if meson_brand.value | perform_brand_modification(ths) | append(ths)(create_equality_axioms(map(concl)(ths))))
          let rules = optimize_rules(fol_of_hol_clauses(ths_prime))
          let [proof, [insts, _, _]] = solve_goal(rules)(meson_depth.value)(min)(max)(inc)([1, PairList []])
          meson_dcutin.value := old_dcutin
          meson_to_hol(insts)(proof)

  fun CONJUNCTS_THEN_prime_impl(ttac): fun(cth): (ttac(CONJUNCT1(cth)) then_tac ttac(CONJUNCT2(cth)))

  fun PURE_MESON_TAC(min):
    fun(max):
      fun(inc):
        fun(gl):
          reset_vars_v2(#void)
          reset_consts_v2(#void)
          (
            FIRST_ASSUM(CONTR_TAC) or_tac \
            W(o(o(o(ACCEPT_TAC)(SIMPLE_MESON_REFUTE(min)(max)(inc)))(map(snd)))(fst))
          )(gl)

  def QUANT_BOOL_CONV:
    PURE_REWRITE_CONV(
      PairList [
        FORALL_BOOL_THM,
        EXISTS_BOOL_THM,
        COND_CLAUSES,
        NOT_CLAUSES,
        IMP_CLAUSES,
        AND_CLAUSES,
        OR_CLAUSES,
        EQ_CLAUSES,
        FORALL_SIMP,
        EXISTS_SIMP
      ]
    )

  fun SPLIT_TAC(n):
    fun(g):
      (
        FIRST_X_ASSUM(CONJUNCTS_THEN_prime_impl(ASSUME_TAC)) then_tac SPLIT_TAC(n) or_tac \
        (if (n > 0) | (FIRST_X_ASSUM(DISJ_CASES_TAC) then_tac SPLIT_TAC((n - 1))) | NO_TAC) or_tac \
        ALL_TAC
      )(g)

fun GEN_MESON_TAC(min):
  fun(max):
    fun(step):
      fun(ths):
        (
          REFUTE_THEN(ASSUME_TAC) then_tac Meson.POLY_ASSUME_TAC(map(GEN_ALL)(ths)) then_tac \
          W(o(MAP_EVERY(o(o(UNDISCH_TAC)(concl))(snd)))(fst)) then_tac \
          SELECT_ELIM_TAC then_tac \
          W((fun([asl, w]): MAP_EVERY((fun(v): SPEC_TAC([v, v])))(frees(w)))) then_tac \
          CONV_TAC(
            PRESIMP_CONV then_conv TOP_DEPTH_CONV(BETA_CONV) then_conv \
            LAMBDA_ELIM_CONV then_conv \
            CONDS_CELIM_CONV then_conv \
            Meson.QUANT_BOOL_CONV
          ) then_tac \
          REPEAT(GEN_TAC or_tac DISCH_TAC) then_tac \
          REFUTE_THEN(ASSUME_TAC) then_tac \
          RULE_ASSUM_TAC(CONV_RULE(NNF_CONV then_conv SKOLEM_CONV)) then_tac \
          REPEAT(FIRST_X_ASSUM(CHOOSE_TAC)) then_tac \
          ASM_FOL_TAC then_tac \
          Meson.SPLIT_TAC(meson_split_limit.value) then_tac \
          RULE_ASSUM_TAC(CONV_RULE(PRENEX_CONV then_conv WEAK_CNF_CONV)) then_tac \
          RULE_ASSUM_TAC(
            repeat(
              (fun(th): SPEC(genvar(type_of(fst(dest_forall(concl(th))))))(th))
            )
          ) then_tac \
          REPEAT(FIRST_X_ASSUM(Meson.CONJUNCTS_THEN_prime(ASSUME_TAC))) then_tac \
          RULE_ASSUM_TAC(CONV_RULE(ASSOC_CONV(DISJ_ASSOC))) then_tac \
          REPEAT(FIRST_X_ASSUM(SUBST_VAR_TAC)) then_tac \
          Meson.PURE_MESON_TAC(min)(max)(step)
        )

def ASM_MESON_TAC = GEN_MESON_TAC(0)(50)(1)

fun MESON_TAC(ths): (POP_ASSUM_LIST(K(ALL_TAC)) then_tac ASM_MESON_TAC(ths))

fun MESON(ths):
  fun(tm):
    let th = TAC_PROOF([[PairList [], tm], MESON_TAC(ths)])
    let [asl, tm_prime] = dest_thm(th)
    if ((asl != (PairList [])) && !subset(asl)(unions(map(hyp)(ths))))
    | failwith("MESON: too many assumptions in result")
    | if (tm_prime == tm)
      | th
      | try:
          EQ_MP(ALPHA(tm_prime)(tm))(th)
          ~catch exn:
            match exn
            | Failure(_): failwith("MESON: the wrong result")
            | exn: (throw exn)
