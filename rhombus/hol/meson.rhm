fun GEN_MESON_TAC(min): (fun(max): (fun(step): (fun(ths): Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Class.REFUTE_THEN(Tactics.ASSUME_TAC))(Meson.POLY_ASSUME_TAC(map(Bool.GEN_ALL)(ths))))(W(o(Tactics.MAP_EVERY(o(o(Tactics.UNDISCH_TAC)(Fusion.concl))(snd)))(fst))))(Canon.SELECT_ELIM_TAC))(W((fun([asl, w]): Tactics.MAP_EVERY((fun(v): Tactics.SPEC_TAC([v, v])))(Fusion.frees(w))))))(Tactics.CONV_TAC(Equal.THENC(Equal.THENC(Equal.THENC(Equal.THENC(Canon.PRESIMP_CONV)(Equal.TOP_DEPTH_CONV(Equal.BETA_CONV)))(Canon.LAMBDA_ELIM_CONV))(Canon.CONDS_CELIM_CONV))(Meson.QUANT_BOOL_CONV))))(Tactics.REPEAT(Tactics.ORELSE(Tactics.GEN_TAC)(Tactics.DISCH_TAC))))(Class.REFUTE_THEN(Tactics.ASSUME_TAC)))(Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.THENC(Canon.NNF_CONV)(Canon.SKOLEM_CONV)))))(Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Tactics.CHOOSE_TAC))))(Canon.ASM_FOL_TAC))(Meson.SPLIT_TAC(Host.ref_get(meson_split_limit))))(Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.THENC(Canon.PRENEX_CONV)(Canon.WEAK_CNF_CONV)))))(Tactics.RULE_ASSUM_TAC(Host.repeat((fun(th): Bool.SPEC(Basics.genvar(Fusion.type_of(fst(Basics.dest_forall(Fusion.concl(th))))))(th))))))(Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Meson.CONJUNCTS_THEN_prime(Tactics.ASSUME_TAC)))))(Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Canon.ASSOC_CONV(Theorems.DISJ_ASSOC)))))(Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Tactics.SUBST_VAR_TAC))))(Meson.PURE_MESON_TAC(min)(max)(step)))))

def ASM_MESON_TAC = GEN_MESON_TAC(0)(50)(1)

fun MESON_TAC(ths): Tactics.THEN(Tactics.POP_ASSUM_LIST(K(Tactics.ALL_TAC)))(ASM_MESON_TAC(ths))

fun MESON(ths):
  fun(tm):
    let th = Tactics.TAC_PROOF([[PairList [], tm], MESON_TAC(ths)])
    let [asl, tm_prime] = Fusion.dest_thm(th)
    if (Host.hol_unequal(asl)(PairList []) && Host.hol_not(subset(asl)(Host.unions(map(Fusion.hyp)(ths)))))
    | failwith("MESON: too many assumptions in result")
    | if Host.hol_equal(tm_prime)(tm)
      | th
      | try:
          Fusion.EQ_MP(Equal.ALPHA(tm_prime)(tm))(th)
          ~catch exn:
            match exn
            | Failure(_): failwith("MESON: the wrong result")
            | exn: Host.hol_raise(exn)
