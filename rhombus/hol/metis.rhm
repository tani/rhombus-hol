      unify

    def anonymousName = Name.fromString("_")

    def anonymousVar = Term.Var(anonymousName)

    variant qterm:
      Var()
      Fn(symbol_arity, arguments)

    fun cmp
    | cmp(PairList []): 0
    | cmp(PairList [[q1, q2] as q1_q2, & qs]):
        if (q1 === q2)
        | cmp(qs)
        | match q1_q2
          | [Var(), Var()]: 0
          | [Var(), Fn(_,_)]: -1
          | [Fn(_,_), Var()]: 1
          | [Fn(f1,f1_prime), Fn(f2,f2_prime)]: fnCmp([f1, f1_prime])([f2, f2_prime])(qs)

    fun fnCmp([n1, q1]):
      fun([n2, q2]):
        fun(qs):
          let c = Name_arity.compare(n1)(n2)
          (if (c != 0) | c | cmp(append(zip(q1)(q2))(qs)))

    fun compareQterm(q1): fun(q2): cmp(PairList [[q1, q2]])

    fun compareFnQterm(f1): fun(f2): fnCmp(f1)(f2)(PairList [])

    fun equalQterm(q1): fun(q2): (compareQterm(q1)(q2) == 0)

    fun equalFnQterm(f1): fun(f2): (compareFnQterm(f1)(f2) == 0)

    fun termToQterm
    | termToQterm(Term.Var(_)): Var()
    | termToQterm(Term.Fn([f, l])): Fn([f, length(l)], PairList.map(l, termToQterm))

    fun qm_impl
    | qm_impl(PairList []): #true
    | qm_impl(PairList [[Var(), _], & rest]): qm_impl(rest)
    | qm_impl(PairList [[Fn(_,_), Var()], & _]): #false
    | qm_impl(PairList [[Fn(f,a), Fn(g,b)], & rest]): (Name_arity.equal(f)(g) && qm_impl(append(zip(a)(b))(rest)))

    fun matchQtermQterm(qtm): fun(qtm_prime): qm_impl(PairList [[qtm, qtm_prime]])

    fun qm_v2
    | qm_v2(PairList []): #true
    | qm_v2(PairList [[Var(), _], & rest]): qm_v2(rest)
    | qm_v2(PairList [[Fn(_,_), Term.Var(_)], & _]): #false
    | qm_v2(PairList [[Fn([f, n],a), Term.Fn([g, b])], & rest]): (Name.equal(f)(g) && ((n == length(b)) && qm_v2(append(zip(a)(b))(rest))))

    fun matchQtermTerm(qtm): fun(tm): qm_v2(PairList [[qtm, tm]])

    fun qn(qsub):
      fun(stage_arg):
        match stage_arg
        | PairList []: Some(qsub)
        | PairList [[Term.Var(v), qtm], & rest]:
            match Name.Map.peek(qsub)(v)
            | None(): qn(Name.Map.insert(qsub)([v, qtm]))(rest)
            | Some(qtm_prime): (if equalQterm(qtm)(qtm_prime) | qn(qsub)(rest) | None())
        | PairList [[Term.Fn(_), Var()], & _]: None()
        | PairList [[Term.Fn([f, a]), Fn([g, n],b)], & rest]: (if (Name.equal(f)(g) && (length(a) == n)) | qn(qsub)(append(zip(a)(b))(rest)) | None())

    fun matchTermQterm(qsub): fun(tm): fun(qtm): qn(qsub)(PairList [[tm, qtm]])

    fun qv(s):
      fun(t):
        match [s, t]
        | [Var(), x]: x
        | [x, Var()]: x
        | [Fn(f,a), Fn(g,b)]:
            let _ = (Name_arity.equal(f)(g) || failwith("Term_net.qv"))
            Fn(f, map2(qv)(a)(b))

    fun qu(qsub):
      fun(stage_arg):
        match stage_arg
        | PairList []: qsub
        | PairList [[Var(), _], & rest]: qu(qsub)(rest)
        | PairList [[qtm, Term.Var(v)], & rest]:
            let qtm:
              match Name.Map.peek(qsub)(v)
              | None(): qtm
              | Some(qtm_prime): qv(qtm)(qtm_prime)
            qu(Name.Map.insert(qsub)([v, qtm]))(rest)
        | PairList [[Fn([f, n],a), Term.Fn([g, b])], & rest]: (if (Name.equal(f)(g) && (n == length(b))) | qu(qsub)(append(zip(a)(b))(rest)) | failwith("Term_net.qu"))

    fun unifyQtermQterm(qtm): fun(qtm_prime): Useful.total(qv(qtm))(qtm_prime)

    fun unifyQtermTerm(qsub): fun(qtm): fun(tm): Useful.total(qu(qsub))(PairList [[qtm, tm]])

    fun qtermToTerm
    | qtermToTerm(Var()): anonymousVar
    | qtermToTerm(Fn([f, _],l)): Term.Fn([f, PairList.map(l, qtermToTerm)])

    record Parameters(fifo)

    variant net:
      Result(results)
      Single(term, net)
      Multiple(variables, functions)

    variant termNet:
      Net(parameters, size, net)

    fun newNet(parm): Net(parm, 0, None())

    fun computeSize
    | computeSize(Result(l)): length(l)
    | computeSize(Single(_,n)): computeSize(n)
    | computeSize(Multiple(vs,fs)):
        Name_arity.Map.foldl((fun([_, n, acc]): (acc + computeSize(n))))(
          match vs
          | Some(n): computeSize(n)
          | None(): 0
        )(fs)

    fun netSize
    | netSize(None()): None()
    | netSize(Some(n)): Some([computeSize(n), n])

    fun size
    | size(Net(_,_,None())): 0
    | size(Net(_,_,Some([i, _]))): i

    fun null(net): (size(net) == 0)

    fun singles(qtms): fun(a): Mlist.foldr((fun([x, y]): Single(x, y)))(a)(qtms)

    fun pre
    | pre(None()): [0, None()]
    | pre(Some([i, n])): [i, Some(n)]

    fun add(a):
      fun(b):
        fun(c):
          match [a, b, c]
          | [Result(l), PairList [], Result(l_prime)]: Result(append(l)(l_prime))
          | [a, PairList [qtm, & qtms] as input1, Single(qtm_prime,n)]:
              if equalQterm(qtm)(qtm_prime)
              | Single(qtm, add(a)(qtms)(n))
              | add(a)(input1)(
                  add(n)(PairList [qtm_prime])(Multiple(None(), Name_arity.Map.newMap(#void)))
                )
          | [a, PairList [Var(), & qtms], Multiple(vs,fs)]: Multiple(Some(oadd(a)(qtms)(vs)), fs)
          | [a, PairList [Fn(f,l), & qtms], Multiple(vs,fs)]:
              let n = Name_arity.Map.peek(fs)(f)
              Multiple(vs, Name_arity.Map.insert(fs)([f, oadd(a)(append(l)(qtms))(n)]))
          | _: (throw Useful.Bug("Term_net.insert: Match"))

    fun oadd(a):
      fun(qtms):
        fun
        | (None()): singles(qtms)(a)
        | (Some(n)): add(a)(qtms)(n)

    fun ins(a): fun(qtm): fun([i, n]): Some([(i + 1), oadd(Result(PairList [a]))(PairList [qtm])(n)])

    fun insert_impl(Net(p,k,n)):
      fun([tm, a]):
        try:
          Net(p, (k + 1), ins([k, a])(termToQterm(tm))(pre(n)))
          ~catch exn:
            match exn
            | Failure(_): (throw Useful.Bug("Term_net.insert: should never fail"))
            | exn: (throw exn)

    fun fromList(parm): fun(l): Mlist.foldl((fun([tm_a, n]): insert_impl(n)(tm_a)))(newNet(parm))(l)

    fun filter_impl(pred):
      fun(net):
        fun filt
        | filt(Result(l)):
            match PairList.filter(l, ~keep: (fun([_, a]): pred(a)))
            | PairList []: None()
            | l: Some(Result(l))
        | filt(Single(qtm,n)):
            match filt(n)
            | None(): None()
            | Some(n): Some(Single(qtm, n))
        | filt(Multiple(vs,fs)):
            let vs = Option.bind(vs)(filt)
            let fs = Name_arity.Map.mapPartial((fun([_, n]): filt(n)))(fs)
            (if (!Option.is_some(vs) && Name_arity.Map.null(fs)) | None() | Some(Multiple(vs, fs)))
        try:
          match net
          | Net(_,_,None()): net
          | Net(p,k,Some([_, n])): Net(p, k, netSize(filt(n)))
          ~catch exn:
            match exn
            | Failure(_): (throw Useful.Bug("Term_net.filter: should never fail"))
            | exn: (throw exn)

    fun toString(net): ("Term_net[" +& (to_string(size(net)) +& "]"))

    fun norm
    | norm([PairList [0, & ks], PairList [[_, n] as f, & fs], qtms]):
        let [a_2, qtms] = Mlist.revDivide(qtms)(n)
        addQterm(Fn(f, a_2))([ks, fs, qtms])
    | norm(stack): stack

    fun addQterm(qtm):
      fun([ks, fs, qtms]):
        let ks:
          match ks
          | PairList []: PairList []
          | PairList [k, & ks]: PairList [(k - 1), & ks]
        norm([ks, fs, PairList [qtm, & qtms]])

    fun addFn([_, n] as f): fun([ks, fs, qtms]): norm([PairList [n, & ks], PairList [f, & fs], qtms])

    def stackEmpty = [PairList [], PairList [], PairList []]

    def stackAddQterm = addQterm

    def stackAddFn = addFn

    fun stackValue
    | stackValue([PairList [], PairList [], PairList [qtm, & PairList []]]): qtm
    | stackValue(_): (throw Useful.Bug("Term_net.stackValue"))

    fun fold_impl(inc):
      fun(acc):
        fun
        | (PairList []): acc
        | (PairList [[0, stack, net], & rest]): fold_impl(inc)(inc([stackValue(stack), net, acc]))(rest)
        | (PairList [[n, stack, Single(qtm,net)], & rest]): fold_impl(inc)(acc)(PairList [[(n - 1), stackAddQterm(qtm)(stack), net], & rest])
        | (PairList [[n, stack, Multiple(v,fns)], & rest]):
            let n = (n - 1)
            let rest:
              match v
              | None(): rest
              | Some(net): PairList [[n, stackAddQterm(Var())(stack), net], & rest]
            let getFns = (fun([[_, k] as f, net, x]): PairList [[(k + n), stackAddFn(f)(stack), net], & x])
            fold_impl(inc)(acc)(Name_arity.Map.foldr(getFns)(rest)(fns))
        | (_): (throw Useful.Bug("Term_net.foldTerms.fold"))

    fun foldTerms(inc): fun(acc): fun(net): fold_impl(inc)(acc)(PairList [[1, stackEmpty, net]])

    fun foldEqualTerms(pat):
      fun(inc):
        fun(acc):
          fun fold
          | fold([PairList [], net]): inc([pat, net, acc])
          | fold([PairList [pat, & pats], Single(qtm,net)]): (if equalQterm(pat)(qtm) | fold([pats, net]) | acc)
          | fold([PairList [Var(), & pats], Multiple(v,_)]):
              match v
              | None(): acc
              | Some(net): fold([pats, net])
          | fold([PairList [Fn(f,a), & pats], Multiple(_,fns)]):
              match Name_arity.Map.peek(fns)(f)
              | None(): acc
              | Some(net): fold([append(a)(pats), net])
          | fold(_): (throw Useful.Bug("Term_net.foldEqualTerms.fold"))
          (fun(net): fold([PairList [pat], net]))

    fun fold_v2(inc):
      fun(acc):
        fun
        | (PairList []): acc
        | (PairList [[PairList [], stack, net], & rest]): fold_v2(inc)(inc([stackValue(stack), net, acc]))(rest)
        | (PairList [[PairList [Var(), & pats], stack, net], & rest]):
            let harvest = (fun([qtm, n, l]): PairList [[pats, stackAddQterm(qtm)(stack), n], & l])
            fold_v2(inc)(acc)(foldTerms(harvest)(rest)(net))
        | (PairList [[PairList [pat, & pats], stack, Single(qtm,net)], & rest]):
            match unifyQtermQterm(pat)(qtm)
            | None(): fold_v2(inc)(acc)(rest)
            | Some(qtm): fold_v2(inc)(acc)(PairList [[pats, stackAddQterm(qtm)(stack), net], & rest])
        | (PairList [[PairList [Fn(f,a) as pat, & pats], stack, Multiple(v,fns)], & rest]):
            let rest:
              match v
              | None(): rest
              | Some(net): PairList [[pats, stackAddQterm(pat)(stack), net], & rest]
            let rest:
              match Name_arity.Map.peek(fns)(f)
              | None(): rest
              | Some(net): PairList [[append(a)(pats), stackAddFn(f)(stack), net], & rest]
            fold_v2(inc)(acc)(rest)
        | (_): (throw Useful.Bug("Term_net.foldUnifiableTerms.fold"))

    fun foldUnifiableTerms(pat): fun(inc): fun(acc): fun(net): fold_v2(inc)(acc)(PairList [[PairList [pat], stackEmpty, net]])

    fun idwise([m, _]): fun([n, _]): Useful.intCompare(m)(n)

    fun fifoize(Parameters(fifo)): fun(l): (if fifo | OCamlList.sort(idwise)(l) | l)

    fun finally(parm): fun(l): PairList.map(fifoize(parm)(l), snd)

    fun mat_impl(acc):
      fun(stage_arg):
        match stage_arg
        | PairList []: acc
        | PairList [[Result(l), PairList []], & rest]: mat_impl(append(l)(acc))(rest)
        | PairList [[Single(qtm,n), PairList [tm, & tms]], & rest]: mat_impl(acc)((if matchQtermTerm(qtm)(tm) | PairList [[n, tms], & rest] | rest))
        | PairList [[Multiple(vs,fs), PairList [tm, & tms]], & rest]:
            let rest:
              match vs
              | None(): rest
              | Some(n): PairList [[n, tms], & rest]
            let rest:
              match tm
              | Term.Var(_): rest
              | Term.Fn([f, l]):
                  match Name_arity.Map.peek(fs)([f, length(l)])
                  | None(): rest
                  | Some(n): PairList [[n, append(l)(tms)], & rest]
            mat_impl(acc)(rest)
        | _: (throw Useful.Bug("Term_net.match: Match"))

    fun matchNet(x):
      fun(y):
        match [x, y]
        | [Net(_,_,None()), _]: PairList []
        | [Net(p,_,Some([_, n])), tm]:
            try:
              finally(p)(mat_impl(PairList [])(PairList [[n, PairList [tm]]]))
              ~catch exn:
                match exn
                | Failure(_): (throw Useful.Bug("Term_net.match: should never fail"))
                | exn: (throw exn)

    fun unseenInc(qsub): fun(v): fun(tms): fun([qtm, net, rest]): PairList [[Name.Map.insert(qsub)([v, qtm]), net, tms], & rest]

    fun seenInc(qsub): fun(tms): fun([_, net, rest]): PairList [[qsub, net, tms], & rest]

    fun mat_v2(acc):
      fun(stage_arg):
        match stage_arg
        | PairList []: acc
        | PairList [[_, Result(l), PairList []], & rest]: mat_v2(append(l)(acc))(rest)
        | PairList [[qsub, Single(qtm,net), PairList [tm, & tms]], & rest]:
            match matchTermQterm(qsub)(tm)(qtm)
            | None(): mat_v2(acc)(rest)
            | Some(qsub): mat_v2(acc)(PairList [[qsub, net, tms], & rest])
        | PairList [[qsub, Multiple(_,_) as net, PairList [Term.Var(v), & tms]], & rest]:
            match Name.Map.peek(qsub)(v)
            | None(): mat_v2(acc)(foldTerms(unseenInc(qsub)(v)(tms))(rest)(net))
            | Some(qtm): mat_v2(acc)(foldEqualTerms(qtm)(seenInc(qsub)(tms))(rest)(net))
        | PairList [[qsub, Multiple(_,fns), PairList [Term.Fn([f, a]), & tms]], & rest]:
            let rest:
              match Name_arity.Map.peek(fns)([f, length(a)])
              | None(): rest
              | Some(net): PairList [[qsub, net, append(a)(tms)], & rest]
            mat_v2(acc)(rest)
        | _: (throw Useful.Bug("Term_net.matched.mat"))

    fun matched(x):
      fun(tm):
        match x
        | Net(_,_,None()): PairList []
        | Net(parm,_,Some([_, net])):
            try:
              finally(parm)(mat_v2(PairList [])(PairList [[Name.Map.newMap(#void), net, PairList [tm]]]))
              ~catch exn:
                match exn
                | Failure(_): (throw Useful.Bug("Term_net.matched: should never fail"))
                | exn: (throw exn)

    fun inc(qsub): fun(v): fun(tms): fun([qtm, net, rest]): PairList [[Name.Map.insert(qsub)([v, qtm]), net, tms], & rest]

    fun mat_v3(acc):
      fun(stage_arg):
        match stage_arg
        | PairList []: acc
        | PairList [[_, Result(l), PairList []], & rest]: mat_v3(append(l)(acc))(rest)
        | PairList [[qsub, Single(qtm,net), PairList [tm, & tms]], & rest]:
            match unifyQtermTerm(qsub)(qtm)(tm)
            | None(): mat_v3(acc)(rest)
            | Some(qsub): mat_v3(acc)(PairList [[qsub, net, tms], & rest])
        | PairList [[qsub, Multiple(_,_) as net, PairList [Term.Var(v), & tms]], & rest]:
            match Name.Map.peek(qsub)(v)
            | None(): mat_v3(acc)(foldTerms(inc(qsub)(v)(tms))(rest)(net))
            | Some(qtm): mat_v3(acc)(foldUnifiableTerms(qtm)(inc(qsub)(v)(tms))(rest)(net))
        | PairList [[qsub, Multiple(v,fns), PairList [Term.Fn([f, a]), & tms]], & rest]:
            let rest:
              match v
              | None(): rest
              | Some(net): PairList [[qsub, net, tms], & rest]
            let rest:
              match Name_arity.Map.peek(fns)([f, length(a)])
              | None(): rest
              | Some(net): PairList [[qsub, net, append(a)(tms)], & rest]
            mat_v3(acc)(rest)
        | _: (throw Useful.Bug("Term_net.unify.mat"))

    fun unify(x):
      fun(tm):
        match x
        | Net(_,_,None()): PairList []
        | Net(parm,_,Some([_, net])):
            try:
              finally(parm)(mat_v3(PairList [])(PairList [[Name.Map.newMap(#void), net, PairList [tm]]]))
              ~catch exn:
                match exn
                | Failure(_): (throw Useful.Bug("Term_net.unify: should never fail"))
                | exn: (throw exn)

  namespace Atom_net:
    export:
      atomToTerm
      termToAtom
      newNet
      size
      rename insert_impl as insert
      fromList
      rename filter_impl as filter
      toString
      matchNet
      matched
      unify

    fun atomToTerm(atom): Term.Fn(atom)

    fun termToAtom
    | termToAtom(Term.Var(_)): (throw Useful.Bug("Atom_net.termToAtom"))
    | termToAtom(Term.Fn(atom)): atom

    def newNet = Term_net.newNet

    def size = Term_net.size

    fun insert_impl(net): fun([atm, a]): Term_net.insert(net)([atomToTerm(atm), a])

    fun fromList(parm): fun(l): Mlist.foldl((fun([atm_a, n]): insert_impl(n)(atm_a)))(newNet(parm))(l)

    def filter_impl = Term_net.filter

    fun toString(net): ("Atom_net[" +& (to_string(size(net)) +& "]"))

    fun matchNet(net): fun(atm): Term_net.matchNet(net)(atomToTerm(atm))

    fun matched(net): fun(atm): Term_net.matched(net)(atomToTerm(atm))

    fun unify(net): fun(atm): Term_net.unify(net)(atomToTerm(atm))

  namespace Literal_net:
    export:
      LiteralNet
      newNet
      pos
      neg
      size
      rename insert_impl as insert
      fromList
      rename filter_impl as filter
      toString
      matchNet
      matched
      unify

    record LiteralNet(positive, negative)

    fun newNet(parm): LiteralNet(Atom_net.newNet(parm), Atom_net.newNet(parm))

    fun pos(LiteralNet(positive,_)): Atom_net.size(positive)

    fun neg(LiteralNet(_,negative)): Atom_net.size(negative)

    fun size(net): (pos(net) + neg(net))

    fun insert_impl(LiteralNet(positive,negative)):
      fun(stage_arg):
        match stage_arg
        | [[#true, atm], a]: LiteralNet(Atom_net.insert(positive)([atm, a]), negative)
        | [[#false, atm], a]: LiteralNet(positive, Atom_net.insert(negative)([atm, a]))

    fun fromList(parm): fun(l): Mlist.foldl((fun([lit_a, n]): insert_impl(n)(lit_a)))(newNet(parm))(l)

    fun filter_impl(pred): fun(LiteralNet(positive,negative)): LiteralNet(Atom_net.filter(pred)(positive), Atom_net.filter(pred)(negative))

    fun toString(net): ("Literal_net[" +& (to_string(size(net)) +& "]"))

    fun matchNet(LiteralNet(positive,negative)):
      fun(stage_arg):
        match stage_arg
        | [#true, atm]: Atom_net.matchNet(positive)(atm)
        | [#false, atm]: Atom_net.matchNet(negative)(atm)

    fun matched(LiteralNet(positive,negative)):
      fun(stage_arg):
        match stage_arg
        | [#true, atm]: Atom_net.matched(positive)(atm)
        | [#false, atm]: Atom_net.matched(negative)(atm)

    fun unify(LiteralNet(positive,negative)):
      fun(stage_arg):
        match stage_arg
        | [#true, atm]: Atom_net.unify(positive)(atm)
        | [#false, atm]: Atom_net.unify(negative)(atm)

  namespace Subsume:
    export:
      findRest
      addSym
      clauseSym
      sortClause
      incompatible
      idCompare
      idSetEmpty
      idSetAdd
      idSetAddMax
      idSetIntersect
      NonunitT
      Subsume
      newSubsume
      size
      rename insert_impl as insert
      rename filter_impl as filter
      toString
      matchLit
      genClauseSubsumes
      emptySubsumes
      unitSubsumes
      nonunitSubsumes
      genSubsumes
      subsumes
      strictlySubsumes
      isSubsumed
      isStrictlySubsumed
      clauseSubsumes
      clauseStrictlySubsumes

    fun findRest(pred):
      // Recursive search needs the local definition before its first use.
      fun f(ys):
        fun(stage_arg):
          match stage_arg
          | PairList []: None()
          | PairList [x, & xs]: (if pred(x) | Some([x, OCamlList.rev_append(ys)(xs)]) | f(PairList [x, & ys])(xs))
      f(PairList [])

    fun addSym([lit, acc]):
      match Useful.total(Literal.sym)(lit)
      | None(): acc
      | Some(lit): PairList [lit, & acc]

    fun clauseSym(lits): Mlist.foldl(addSym)(lits)(lits)

    fun sortClause(cl):
      let lits = Literal.Set.toList(cl)
      Mlist.sortMap(Literal.typedSymbols)(Useful.revCompare(Useful.intCompare))(lits)

    fun incompatible(lit):
      fun(lit_prime):
        let lits = clauseSym(PairList [lit])
        !OCamlList.exists(can(Literal.unify(Substitute.empty)(lit_prime)))(lits)

    fun idCompare([id1, len1]):
      fun([id2, len2]):
        let c = Useful.intCompare(len1)(len2)
        (if (c != 0) | c | Useful.intCompare(id1)(id2))

    def idSetEmpty = Pset.empty(idCompare)

    fun idSetAdd([id_len, set]): Pset.add(set)(id_len)

    fun idSetAddMax(max): fun([[_, len] as id_len, set]): (if (len <= max) | Pset.add(set)(id_len) | set)

    fun idSetIntersect(set1): fun(set2): Pset.intersect(set1)(set2)

    record NonunitT(nextId, clauses, fstLits, sndLits)

    record Subsume(empty, unitn, nonunit)

    fun newSubsume(_):
      Subsume(
        PairList [],
        Literal_net.newNet(Term_net.Parameters(#false)),
        NonunitT(
          0,
          Intmap.newMap(#void),
          Literal_net.newNet(Term_net.Parameters(#false)),
          Literal_net.newNet(Term_net.Parameters(#false))
        )
      )

    fun size(Subsume(empty,unitn,NonunitT(_,clauses,_,_))): ((length(empty) + Literal_net.size(unitn)) + Intmap.size(clauses))

    fun insert_impl(Subsume(empty,unitn,nonunit)):
      fun([cl_prime, a]):
        match sortClause(cl_prime)
        | PairList []:
            let empty = PairList [[cl_prime, Substitute.empty, a], & empty]
            Subsume(empty, unitn, nonunit)
        | PairList [lit, & PairList []]:
            let unitn = Literal_net.insert(unitn)([lit, [lit, cl_prime, a]])
            Subsume(empty, unitn, nonunit)
        | PairList [fstLit, & PairList [sndLit, & otherLits] as nonFstLits]:
            let NonunitT(nextId,clauses,fstLits,sndLits) = nonunit
            let id_length = [nextId, Literal.Set.size(cl_prime)]
            let fstLits = Literal_net.insert(fstLits)([fstLit, id_length])
            let [sndLit, otherLits]:
              match findRest(incompatible(fstLit))(nonFstLits)
              | Some(sndLit_otherLits): sndLit_otherLits
              | None(): [sndLit, otherLits]
            let sndLits = Literal_net.insert(sndLits)([sndLit, id_length])
            let lits_prime = append(otherLits)(PairList [fstLit, sndLit])
            let clauses = Intmap.insert(clauses)([nextId, [lits_prime, cl_prime, a]])
            let nextId = (nextId + 1)
            let nonunit = NonunitT(nextId, clauses, fstLits, sndLits)
            Subsume(empty, unitn, nonunit)

    fun filter_impl(pred):
      fun(Subsume(empty,unitn,nonunit)):
        let pred3 = (fun([_, _, x]): pred(x))
        let empty = PairList.filter(empty, ~keep: pred3)
        let unitn = Literal_net.filter(pred3)(unitn)
        let NonunitT(nextId,clauses,fstLits,sndLits) = nonunit
        let clauses_prime = Intmap.filter((fun(x): pred3(snd(x))))(clauses)
        let nonunit:
          if (Intmap.size(clauses) == Intmap.size(clauses_prime))
          | nonunit
          | let predId = (fun([id, _]): Intmap.inDomain(id)(clauses_prime))
            let fstLits_2 = Literal_net.filter(predId)(fstLits)
            let sndLits_2 = Literal_net.filter(predId)(sndLits)
            NonunitT(nextId, clauses_prime, fstLits_2, sndLits_2)
        Subsume(empty, unitn, nonunit)

    fun toString(subsume): ("Subsume{" +& (to_string(size(subsume)) +& "}"))

    fun matchLit(lit_prime):
      fun([lit, acc]):
        match Useful.total(Literal.matchLiterals(Substitute.empty)(lit_prime))(lit)
        | Some(sub): PairList [sub, & acc]
        | None(): acc

    fun genClauseSubsumes(pred):
      fun(cl_prime):
        fun(lits_prime):
          fun(cl):
            fun(a):
              // Recursive subsumption search needs the local definition before its first use.
              fun mkSubsl(acc):
                fun(sub):
                  fun(arg):
                    match arg
                    | PairList []: Some([sub, Mlist.sortMap(length)(Useful.intCompare)(acc)])
                    | PairList [lit_prime, & lits_prime]:
                          match Mlist.foldl(matchLit(lit_prime))(PairList [])(cl)
                          | PairList []: None()
                          | PairList [sub_prime, & PairList []]:
                              match Useful.total(Substitute.union(sub))(sub_prime)
                              | None(): None()
                              | Some(sub): mkSubsl(acc)(sub)(lits_prime)
                          | subs: mkSubsl(PairList [subs, & acc])(sub)(lits_prime)
              fun search
              | search(PairList []): None()
              | search(PairList [[sub, PairList []], & others]):
                  let x = [cl_prime, sub, a]
                  (if pred(x) | Some(x) | search(others))
              | search(PairList [[_, PairList [PairList [], & _]], & others]): search(others)
              | search(PairList [[sub, PairList [PairList [sub_prime, & subs], & subsl]], & others]):
                  let others = PairList [[sub, PairList [subs, & subsl]], & others]
                  match Useful.total(Substitute.union(sub))(sub_prime)
                  | None(): search(others)
                  | Some(sub): search(PairList [[sub, subsl], & others])
              match mkSubsl(PairList [])(Substitute.empty)(lits_prime)
              | None(): None()
              | Some(sub_subsl): search(PairList [sub_subsl])

    fun emptySubsumes(pred): fun(empty): Mlist.find(pred)(empty)

    fun unitSubsumes(pred):
      fun(unitn):
        fun(cl):
          let subLit:
            fun(lit):
              let subUnit:
                fun([lit_prime, cl_prime, a]):
                  match Useful.total(Literal.matchLiterals(Substitute.empty)(lit_prime))(lit)
                  | None(): None()
                  | Some(sub):
                      let x = [cl_prime, sub, a]
                      (if pred(x) | Some(x) | None())
              Mlist.first(subUnit)(Literal_net.matchNet(unitn)(lit))
          Mlist.first(subLit)(cl)

    fun nonunitSubsumes(pred):
      fun(nonunit):
        fun(max):
          fun(cl):
            let addId:
              match max
              | None(): idSetAdd
              | Some(n): idSetAddMax(n)
            let subLit = fun(lits): fun([lit, acc]): Mlist.foldl(addId)(acc)(Literal_net.matchNet(lits)(lit))
            let NonunitT(_,clauses,fstLits,sndLits) = nonunit
            let subCl_prime:
              fun([id, _]):
                let [lits_prime, cl_prime, a_2] = Intmap.get(clauses)(id)
                genClauseSubsumes(pred)(cl_prime)(lits_prime)(cl)(a_2)
            let fstCands = Mlist.foldl(subLit(fstLits))(idSetEmpty)(cl)
            let sndCands = Mlist.foldl(subLit(sndLits))(idSetEmpty)(cl)
            let cands = idSetIntersect(fstCands)(sndCands)
            Pset.firstl(subCl_prime)(cands)

    fun genSubsumes(pred):
      fun(Subsume(empty,unitn,nonunit)):
        fun(max):
          fun(cl):
            match emptySubsumes(pred)(empty)
            | Some(_) as s: s
            | None():
                if (max == Some(0))
                | None()
                | let cl = clauseSym(Literal.Set.toList(cl))
                  match unitSubsumes(pred)(unitn)(cl)
                  | Some(_) as s: s
                  | None(): (if (max == Some(1)) | None() | nonunitSubsumes(pred)(nonunit)(max)(cl))

    fun subsumes(pred): fun(subsume): fun(cl): genSubsumes(pred)(subsume)(None())(cl)

    fun strictlySubsumes(pred): fun(subsume): fun(cl): genSubsumes(pred)(subsume)(Some(Literal.Set.size(cl)))(cl)

    fun isSubsumed(subs): fun(cl): Option.is_some(subsumes(K(#true))(subs)(cl))

    fun isStrictlySubsumed(subs): fun(cl): Option.is_some(strictlySubsumes(K(#true))(subs)(cl))

    fun clauseSubsumes(cl_prime):
      fun(cl):
        let lits_prime_2 = sortClause(cl_prime)
        let lits_2 = clauseSym(Literal.Set.toList(cl))
        match genClauseSubsumes(K(#true))(cl_prime)(lits_prime_2)(lits_2)(#void)
        | Some([_, sub, #void]): Some(sub)
        | None(): None()

    fun clauseStrictlySubsumes(cl_prime): fun(cl): (if (Literal.Set.size(cl_prime) > Literal.Set.size(cl)) | None() | clauseSubsumes(cl_prime)(cl))

  namespace Knuth_bendix_order:
    export:
      notEqualTerm
      firstNotEqualTerm
      Kbo
      uniformWeight
      arityPrecedence
      default
      Weight
      weightEmpty
      weightZero
      weightIsZero
      weightNeg
      add
      weightAdd
      weightSubtract
      weightTerm
      weightLowerBound
      rename compare_impl as compare

    fun notEqualTerm([x, y]): !Term.equal(x)(y)

    fun firstNotEqualTerm(f):
      fun(l):
        match Mlist.find(notEqualTerm)(l)
        | Some([x, y]): f(x)(y)
        | None(): (throw Useful.Bug("firstNotEqualTerm"))

    record Kbo(weight, precedence)

    def uniformWeight = K(1)

    fun arityPrecedence([f1, n1]):
      fun([f2, n2]):
        let c = Useful.intCompare(n1)(n2)
        (if (c != 0) | c | Name.compare(f1)(f2))

    def default = Kbo(uniformWeight, arityPrecedence)

    variant weight:
      Weight(symbols, constant)

    def weightEmpty = Name.Map.newMap(#void)

    def weightZero = Weight(weightEmpty, 0)

    fun weightIsZero(Weight(m,c)): ((c == 0) && Name.Map.null(m))

    fun weightNeg(Weight(m,c)): Weight(Name.Map.transform((fun(x): (-x)))(m), (-c))

    fun add([[_, n1], [_, n2]]):
      let n = (n1 + n2)
      (if (n == 0) | None() | Some(n))

    fun weightAdd(Weight(m1,c1)): fun(Weight(m2,c2)): Weight(Name.Map.union(add)(m1)(m2), (c1 + c2))

    fun weightSubtract(w1): fun(w2): weightAdd(w1)(weightNeg(w2))

    fun weightTerm(weight):
      fun(tm):
        // Recursive weight accumulation needs the local definition before its first use.
        fun wt(m):
          fun(c):
            fun(arg):
              match arg
              | PairList []: Weight(m, c)
              | PairList [Term.Var(v), & tms]:
                    let n = Option.value(Name.Map.peek(m)(v))(~default: 0)
                    wt(Name.Map.insert(m)([v, (n + 1)]))((c + 1))(tms)
              | PairList [Term.Fn([f, a]), & tms]: wt(m)((c + weight([f, length(a)])))(append(a)(tms))
        wt(weightEmpty)(-1)(PairList [tm])

    fun weightLowerBound(Weight(m,c)): (if Name.Map.exists((fun([_, n]): (n < 0)))(m) | None() | Some(c))

    fun compare_impl(Kbo(weight,precedence)):
      fun(tm1):
        fun(tm2):
          let weightDifference = fun(tm1):
            fun(tm2):
              let w1_2 = weightTerm(weight)(tm1)
              let w2_2 = weightTerm(weight)(tm2)
              weightSubtract(w2_2)(w1_2)
          // Mutually recursive ordering needs local definitions for forward references.
          fun weightLess_2(tm1):
            fun(tm2):
              let w = weightDifference(tm1)(tm2)
              (if weightIsZero(w) | precedenceLess_2(tm1)(tm2) | weightDiffLess_2(w)(tm1)(tm2))
          // Mutually recursive ordering needs local definitions for forward references.
          fun weightDiffLess_2(w):
            fun(tm1):
              fun(tm2):
                match weightLowerBound(w)
                | None(): #false
                | Some(0): precedenceLess_2(tm1)(tm2)
                | Some(n): (n > 0)
          // Mutually recursive ordering needs local definitions before use.
          fun precedenceLess_2(x):
            fun(y):
              match [x, y]
              | [Term.Fn([f1, a1]), Term.Fn([f2, a2])]:
                  let c = precedence([f1, length(a1)])([f2, length(a2)])
                  if (c < 0)
                  | #true
                  | (if (c == 0) | firstNotEqualTerm(weightLess_2)(zip(a1)(a2)) | #false)
              | _: #false
          let weightDiffGreater = fun(w): fun(tm1): fun(tm2): weightDiffLess_2(weightNeg(w))(tm2)(tm1)
          // Mutually recursive comparison needs local definitions for forward references.
          fun weightCmp_2(tm1):
            fun(tm2):
              let w = weightDifference(tm1)(tm2)
              if weightIsZero(w)
              | precedenceCmp_2(tm1)(tm2)
              | if weightDiffLess_2(w)(tm1)(tm2)
                | Some(-1)
                | (if weightDiffGreater(w)(tm1)(tm2) | Some(1) | None())
          // Mutually recursive comparison needs local definitions before use.
          fun precedenceCmp_2(x):
            fun(y):
              match [x, y]
              | [Term.Fn([f1, a1]), Term.Fn([f2, a2])]:
                  let c = precedence([f1, length(a1)])([f2, length(a2)])
                  if (c < 0)
                  | Some(-1)
                  | (if (c == 0) | firstNotEqualTerm(weightCmp_2)(zip(a1)(a2)) | Some(1))
              | _: (throw Useful.Bug("kboOrder.precendenceCmp"))
          if Term.equal(tm1)(tm2) | Some(0) | weightCmp_2(tm1)(tm2)

