    variant orient:
      Left_to_right()
      Right_to_left()

    fun toStringOrient(ort):
      match ort
      | Left_to_right(): "-->"
      | Right_to_left(): "<--"

    fun toStringOrientOption(orto):
      match orto
      | Host.Some(ort): toStringOrient(ort)
      | Host.None(): "<->"

    record RewriteT(order, known, redexes, subterms, waiting)

    variant rewrite:
      Rewrite(rules)

    curried fun updateWaiting(rw, waiting):
      let Rewrite(RewriteT(order,known,redexes,subterms,_)) = rw
      Rewrite(RewriteT(order, known, redexes, subterms, waiting))

    curried fun deleteWaiting(Rewrite(RewriteT(_,_,_,_,waiting)) as rw, id): updateWaiting(rw)(Intset.delete(waiting)(id))

    fun newRewrite(order):
      Rewrite(
        RewriteT(
          order,
          Host.hol_apply_unit(Intmap.newMap),
          Term_net.newNet(Term_net.Parameters(#false)),
          Term_net.newNet(Term_net.Parameters(#false)),
          Intset.empty
        )
      )

    curried fun peek(Rewrite(RewriteT(_,known,_,_,_)), id): Intmap.peek(known)(id)

    fun size(Rewrite(RewriteT(_,known,_,_,_))): Intmap.size(known)

    fun equations(Rewrite(RewriteT(_,known,_,_,_))): Intmap.foldr((fun([_, [eqn, _], eqns]): PairList [eqn, & eqns]))(PairList [])(known)

    curried fun termReducible(order, known, id):
      let eqnRed:
        fun([[l, r], _]):
          fun(tm):
            match Useful.total(Substitute.matchTerms(Substitute.empty)(l))(tm)
            | Host.None(): #false
            | Host.Some(sub): Host.hol_equal(order(tm)(Substitute.subst(Substitute.normalize(sub))(r)))(Host.Some(1))
      let knownRed = (fun(tm): (fun([eqnId, [eqn, ort]]): (Host.hol_unequal(eqnId)(id) && ((Host.hol_unequal(ort)(Host.Some(Right_to_left())) && eqnRed(eqn)(tm)) || (Host.hol_unequal(ort)(Host.Some(Left_to_right())) && eqnRed(Rule.symEqn(eqn))(tm))))))
      fun termRed_2(tm): (Intmap.exists(knownRed(tm))(known) || subtermRed_2(tm))
      fun subtermRed_2
      | subtermRed_2(Term.Var(_)): #false
      | subtermRed_2(Term.Fn([_, tms])): Host.OCamlList.exists(termRed_2)(tms)
      termRed_2

    curried fun literalReducible(order, known, id, lit): Host.OCamlList.exists(termReducible(order, known, id))(Literal.arguments(lit))

    curried fun literalsReducible(order, known, id, lits): Literal.Set.exists(literalReducible(order, known, id))(lits)

    curried fun thmReducible(order, known, id, th): literalsReducible(order)(known)(id)(Thm.clause(th))

    fun orderToOrient(arg_2):
      match arg_2
      | Host.Some(0): failwith("Rewrite.orient: reflexive")
      | Host.Some(c):
          if Host.hol_gt(c)(0)
          | Host.Some(Left_to_right())
          | match arg_2
            | Host.Some(_): Host.Some(Right_to_left())
            | Host.None(): Host.None()
      | Host.Some(_): Host.Some(Right_to_left())
      | Host.None(): Host.None()

    curried fun ins(redexes, redex, id, ort): Term_net.insert(redexes)([redex, [id, ort]])

    curried fun addRedexes(id, [[[l, r], _], ort], redexes):
      match ort
      | Host.Some(Left_to_right()): ins(redexes, l, id, Left_to_right())
      | Host.Some(Right_to_left()): ins(redexes, r, id, Right_to_left())
      | Host.None(): ins(ins(redexes, l, id, Left_to_right()), r, id, Right_to_left())

    curried fun add(Rewrite(RewriteT(_,known,_,_,_)) as rw, [id, eqn]):
      if Intmap.inDomain(id)(known)
      | rw
      | let Rewrite(RewriteT(order,_,redexes,subterms,waiting)) = rw
        let [l, r] = fst(eqn)
        let ort = orderToOrient(order(l)(r))
        let known = Intmap.insert(known)([id, [eqn, ort]])
        let redexes = addRedexes(id, [eqn, ort], redexes)
        let waiting = Intset.add(waiting)(id)
        let rw = Rewrite(RewriteT(order, known, redexes, subterms, waiting))
        rw

    fun uncurriedAdd([eqn, rw]): add(rw, eqn)

    fun addList(rw): Mlist.foldl(uncurriedAdd)(rw)

    curried fun reorder([i, _], [j, _]): Useful.intCompare(j)(i)

    curried fun matchingRedexes(redexes, tm): Host.OCamlList.sort(reorder)(Term_net.matchNet(redexes)(tm))

    curried fun wellOriented(x, y):
      match [x, y]
      | [Host.None(), _]: #true
      | [Host.Some(Left_to_right()), Left_to_right()]: #true
      | [Host.Some(Right_to_left()), Right_to_left()]: #true
      | _: #false

    curried fun redexResidue(x, y):
      match [x, y]
      | [Left_to_right(), [l_r, _]]: l_r
      | [Right_to_left(), [[l, r], _]]: [r, l]

    curried fun orientedEquation(dir, eqn):
      match dir
      | Left_to_right(): eqn
      | Right_to_left(): Rule.symEqn(eqn)

    fun rewrIdConv_prime_impl(order):
      fun(known):
        fun(redexes):
          fun(id):
            fun(tm):
              let rewr:
                fun([id_prime, lr]):
                  let _ = (Host.hol_unequal(id)(id_prime) || failwith("same theorem"))
                  let [eqn, ort] = Intmap.get(known)(id_prime)
                  let _ = (wellOriented(ort, lr) || failwith("orientation"))
                  let [l, r] = redexResidue(lr, eqn)
                  let sub = Substitute.normalize(Substitute.matchTerms(Substitute.empty)(l)(tm))
                  let tm_prime = Substitute.subst(sub)(r)
                  let _ = (Option.is_some(ort) || (Host.hol_equal(order(tm)(tm_prime))(Host.Some(1)) || failwith("order")))
                  let [_, th] = orientedEquation(lr, eqn)
                  [tm_prime, Thm.subst(sub)(th)]
              match Mlist.first(Useful.total(rewr))(matchingRedexes(redexes, tm))
              | Host.None(): failwith("Rewrite.rewrIdConv: no matching rewrites")
              | Host.Some(res): res

    fun rewriteIdConv_prime_impl(order): (fun(known): (fun(redexes): (fun(id): (if Intmap.null(known) | Rule.allConv | Rule.repeatTopDownConv(rewrIdConv_prime_impl(order, known, redexes, id))))))

    curried fun mkNeqConv(order, lit):
      let [l, r] = Literal.destNeq(lit)
      let subject = order(l)(r)
      match subject
      | Host.None(): failwith("incomparable")
      | Host.Some(c):
          if Host.hol_lt(c)(0)
          | let th = Rule.symmetryRule(l)(r)
            (fun(tm): (if Term.equal(tm)(r) | [l, th] | failwith("mkNeqConv: RL")))
          | match subject
            | Host.Some(0): failwith("irreflexive")
            | Host.Some(_):
                let th = Thm.assume(lit)
                (fun(tm): (if Term.equal(tm)(l) | [r, th] | failwith("mkNeqConv: LR")))
      | Host.Some(0): failwith("irreflexive")
      | Host.Some(_):
          let th = Thm.assume(lit)
          (fun(tm): (if Term.equal(tm)(l) | [r, th] | failwith("mkNeqConv: LR")))

    variant neqConvs:
      Neq_convs(conversions)

    def neqConvsEmpty = Neq_convs(Host.hol_apply_unit(Literal.Map.newMap))

    fun neqConvsNull(Neq_convs(m)): Literal.Map.null(m)

    curried fun neqConvsAdd(order, Neq_convs(m), lit):
      match Useful.total(mkNeqConv(order))(lit)
      | Host.None(): Host.None()
      | Host.Some(conv): Host.Some(Neq_convs(Literal.Map.insert(m)([lit, conv])))

    fun mkNeqConvs(order):
      let add:
        fun([lit, [neq, lits]]):
          match neqConvsAdd(order, neq, lit)
          | Host.Some(neq): [neq, lits]
          | Host.None(): [neq, Literal.Set.add(lits)(lit)]
      Literal.Set.foldl(add)([neqConvsEmpty, Literal.Set.empty])

    curried fun neqConvsDelete(Neq_convs(m), lit): Neq_convs(Literal.Map.delete(m)(lit))

    fun neqConvsToConv(Neq_convs(m)): Rule.firstConv(Literal.Map.foldr((fun([_, c, l]): PairList [c, & l]))(PairList [])(m))

    curried fun neqConvsFoldl(f, b, Neq_convs(m)): Literal.Map.foldl((fun([l, _, z]): f([l, z])))(b)(m)

    curried fun neqConvsRewrIdLiterule(order, known, redexes, id, neq):
      if (Intmap.null(known) && neqConvsNull(neq))
      | Rule.allLiterule
      | let neq_conv = neqConvsToConv(neq)
        let rewr_conv = rewrIdConv_prime_impl(order, known, redexes, id)
        let conv = Rule.orelseConv(neq_conv)(rewr_conv)
        let conv = Rule.repeatTopDownConv(conv)
        Rule.allArgumentsLiterule(conv)

    fun rewriteIdEqn_prime_impl(order):
      fun(known):
        fun(redexes):
          fun(id):
            fun([l_r, th] as eqn):
              let [neq, _] = mkNeqConvs(order)(Thm.clause(th))
              let literule = neqConvsRewrIdLiterule(order, known, redexes, id, neq)
              let [strongEqn, lit]:
                match Rule.equationLiteral(eqn)
                | Host.None(): [#true, Literal.mkEq(l_r)]
                | Host.Some(lit): [#false, lit]
              let [lit_prime, litTh] = literule(lit)
              if Literal.equal(lit)(lit_prime)
              | eqn
              | [
                  Literal.destEq(lit_prime),
                  if strongEqn
                  | th
                  | (if Host.hol_not(Thm.negateMember(lit)(litTh)) | litTh | Thm.resolve(lit)(th)(litTh))
                ]

    fun rewriteIdLiteralsRule_prime_impl(order):
      fun(known):
        fun(redexes):
          fun(id):
            fun(lits):
              fun(th):
                let mk_literule = neqConvsRewrIdLiterule(order, known, redexes, id)
                let rewr_neq_lit:
                  fun([lit, [changed, neq, lits, th] as acc]):
                    let neq = neqConvsDelete(neq, lit)
                    let [lit_prime, litTh] = mk_literule(neq)(lit)
                    if Literal.equal(lit)(lit_prime)
                    | acc
                    | let th = (if Thm.member(lit)(th) | Thm.resolve(lit)(th)(litTh) | th)
                      match neqConvsAdd(order, neq, lit_prime)
                      | Host.Some(neq): [#true, neq, lits, th]
                      | Host.None(): [changed, neq, Literal.Set.add(lits)(lit_prime), th]
                fun rewr_neq_lits(neq):
                  fun(lits):
                    fun(th):
                      let [changed, neq, lits, th] = neqConvsFoldl(rewr_neq_lit, [#false, neq, lits, th], neq)
                      (if changed | rewr_neq_lits(neq)(lits)(th) | [neq, lits, th])
                let [neq, lits] = mkNeqConvs(order)(lits)
                let [neq, lits, th] = rewr_neq_lits(neq)(lits)(th)
                let rewr_literule = mk_literule(neq)
                let rewr_lit = (fun([lit, th]): (if Thm.member(lit)(th) | Rule.literalRule(rewr_literule)(lit)(th) | th))
                Literal.Set.foldl(rewr_lit)(th)(lits)

    fun rewriteIdRule_prime_impl(order): (fun(known): (fun(redexes): (fun(id): (fun(th): rewriteIdLiteralsRule_prime_impl(order)(known)(redexes)(id)(Thm.clause(th))(th)))))

    curried fun rewrIdConv(Rewrite(RewriteT(_,known,redexes,_,_)), order): rewrIdConv_prime_impl(order, known, redexes)

    curried fun rewrConv(rewrite, order): rewrIdConv(rewrite, order)(-1)

    curried fun rewriteIdConv(Rewrite(RewriteT(_,known,redexes,_,_)), order): rewriteIdConv_prime_impl(order, known, redexes)

    curried fun rewriteConv(rewrite, order): rewriteIdConv(rewrite, order)(-1)

    curried fun rewriteIdLiteralsRule(Rewrite(RewriteT(_,known,redexes,_,_)), order): rewriteIdLiteralsRule_prime_impl(order, known, redexes)

    curried fun rewriteLiteralsRule(rewrite, order): rewriteIdLiteralsRule(rewrite, order)(-1)

    curried fun rewriteIdRule(Rewrite(RewriteT(_,known,redexes,_,_)), order): rewriteIdRule_prime_impl(order, known, redexes)

    curried fun rewriteRule(rewrite, order): rewriteIdRule(rewrite, order)(-1)

    curried fun addSubterms(id, [[l, r], _], subterms):
      let addSubterm = (fun(b): (fun([[path, tm], net]): Term_net.insert(net)([tm, [id, b, path]])))
      let subterms = Mlist.foldl(addSubterm(#true))(subterms)(Term.subterms(l))
      let subterms = Mlist.foldl(addSubterm(#false))(subterms)(Term.subterms(r))
      subterms

    curried fun sameRedexes(x, y, z):
      match [x, y, z]
      | [Host.None(), _, _]: #false
      | [Host.Some(Left_to_right()), [l0, _], [l, _]]: Term.equal(l0)(l)
      | [Host.Some(Right_to_left()), [_, r0], [_, r]]: Term.equal(r0)(r)

    curried fun redexResidues(x, [l, r]):
      match x
      | Host.None(): PairList [[l, r, #false], [r, l, #false]]
      | Host.Some(Left_to_right()): PairList [[l, r, #true]]
      | Host.Some(Right_to_left()): PairList [[r, l, #true]]

    curried fun findReducibles(order, known, subterms, id):
      let checkValidRewr:
        fun([l, r, ord]):
          fun(id_prime):
            fun(left):
              fun(path):
                let [[[x, y], _], _] = Intmap.get(known)(id_prime)
                let tm = Term.subterm((if left | x | y))(path)
                let sub = Substitute.matchTerms(Substitute.empty)(l)(tm)
                if ord
                | #void
                | let tm_prime = Substitute.subst(Substitute.normalize(sub))(r)
                  (if Host.hol_equal(order(tm)(tm_prime))(Host.Some(1)) | #void | failwith("order"))
      let addRed = (fun(lr): (fun([[id_prime, left, path], todo]): (if (Host.hol_unequal(id)(id_prime) && (Host.hol_not(Intset.member(id_prime)(todo)) && can(checkValidRewr(lr)(id_prime)(left))(path))) | Intset.add(todo)(id_prime) | todo)))
      let findRed = (fun([[l, _, _] as lr, todo]): Mlist.foldl(addRed(lr))(todo)(Term_net.matched(subterms)(l)))
      Mlist.foldl(findRed)

    curried fun reduce1(newx, id, [eqn0, ort0], [rpl, spl, todo, rw, changed]):
      let [eq0, _] = eqn0
      let Rewrite(RewriteT(order,known,redexes,subterms,waiting)) = rw
      let [eq, _] as eqn = rewriteIdEqn_prime_impl(order, known, redexes, id, eqn0)
      let [l0_2, r0_2] = eq0
      let [l_2, r_2] = eq
      let identical = (Term.equal(l_2)(l0_2) && Term.equal(r_2)(r0_2))
      let same_redexes = (identical || sameRedexes(ort0, eq0, eq))
      let rpl = (if same_redexes | rpl | Intset.add(rpl)(id))
      let spl = (if (newx || identical) | spl | Intset.add(spl)(id))
      let changed = (if (Host.hol_not(newx) && identical) | changed | Intset.add(changed)(id))
      let ort:
        if same_redexes
        | Host.Some(ort0)
        | let [l, r] = eq
          Useful.total(orderToOrient)(order(l)(r))
      match ort
      | Host.None():
          let known = Intmap.delete(known)(id)
          let rw = Rewrite(RewriteT(order, known, redexes, subterms, waiting))
          [rpl, spl, todo, rw, changed]
      | Host.Some(ort):
          let todo = (if (Host.hol_not(newx) && same_redexes) | todo | findReducibles(order, known, subterms, id)(todo)(redexResidues(ort, eq)))
          let known = (if identical | known | Intmap.insert(known)([id, [eqn, ort]]))
          let redexes = (if same_redexes | redexes | addRedexes(id, [eqn, ort], redexes))
          let subterms = (if (newx || Host.hol_not(identical)) | addSubterms(id, eqn, subterms) | subterms)
          let rw = Rewrite(RewriteT(order, known, redexes, subterms, waiting))
          [rpl, spl, todo, rw, changed]

    curried fun pick(known, set):
      let oriented:
        fun(id):
          match Intmap.peek(known)(id)
          | Host.Some([_, Host.Some(_)] as x): Host.Some([id, x])
          | _: Host.None()
      let any:
        fun(id):
          match Intmap.peek(known)(id)
          | Host.Some(x): Host.Some([id, x])
          | _: Host.None()
      match Intset.firstl(oriented)(set)
      | Host.Some(_) as x: x
      | Host.None(): Intset.firstl(any)(set)

    curried fun cleanRedexes(known, redexes, rpl):
      if Intset.null(rpl)
      | redexes
      | let filt = (fun([id, _]): Host.hol_not(Intset.member(id)(rpl)))
        let addReds:
          fun([id, reds]):
            match Intmap.peek(known)(id)
            | Host.None(): reds
            | Host.Some(eqn_ort): addRedexes(id, eqn_ort, reds)
        let redexes = Term_net.filter(filt)(redexes)
        let redexes = Intset.foldl(addReds)(redexes)(rpl)
        redexes

    curried fun cleanSubterms(known, subterms, spl):
      if Intset.null(spl)
      | subterms
      | let filt = (fun([id, _, _]): Host.hol_not(Intset.member(id)(spl)))
        let addSubtms:
          fun([id, subtms]):
            match Intmap.peek(known)(id)
            | Host.None(): subtms
            | Host.Some([eqn, _]): addSubterms(id, eqn, subtms)
        let subterms = Term_net.filter(filt)(subterms)
        let subterms = Intset.foldl(addSubtms)(subterms)(spl)
        subterms

    curried fun rebuild(rpl, spl, rw):
      let Rewrite(RewriteT(order,known,redexes,subterms,waiting)) = rw
      let redexes = cleanRedexes(known, redexes, rpl)
      let subterms = cleanSubterms(known, subterms, spl)
      Rewrite(RewriteT(order, known, redexes, subterms, waiting))

    fun reduceAcc([rpl, spl, todo, Rewrite(RewriteT(_,known,_,_,waiting)) as rw, changed]):
      match pick(known, todo)
      | Host.Some([id, eqn_ort]):
          let todo = Intset.delete(todo)(id)
          reduceAcc(reduce1(#false, id, eqn_ort, [rpl, spl, todo, rw, changed]))
      | Host.None():
          match pick(known, waiting)
          | Host.Some([id, eqn_ort]):
              let rw = deleteWaiting(rw, id)
              reduceAcc(reduce1(#true, id, eqn_ort, [rpl, spl, todo, rw, changed]))
          | Host.None(): [rebuild(rpl, spl, rw), Intset.toList(changed)]

    fun isReduced(Rewrite(RewriteT(_,_,_,_,waiting))): Intset.null(waiting)

    fun reduce_prime_impl(rw): (if isReduced(rw) | [rw, PairList []] | reduceAcc([Intset.empty, Intset.empty, Intset.empty, rw, Intset.empty]))

    fun reduce(rw): fst(reduce_prime_impl(rw))

    fun addEqn([id_eqn, rw]): add(rw, id_eqn)

    curried fun orderedRewrite(order, ths):
      let rw = Mlist.foldl(addEqn)(newRewrite(order))(Mlist.enumerate(ths))
      rewriteRule(rw, order)

    curried fun order_impl(_, _): Host.Some(1)

    def rewrite = orderedRewrite(order_impl)

    def rewrIdConv_prime = rewrIdConv_prime_impl

    def rewriteIdConv_prime = rewriteIdConv_prime_impl

    def rewriteIdEqn_prime = rewriteIdEqn_prime_impl

    def rewriteIdLiteralsRule_prime = rewriteIdLiteralsRule_prime_impl

    def rewriteIdRule_prime = rewriteIdRule_prime_impl

    def reduce_prime = reduce_prime_impl

    def order = order_impl

  namespace Units:
    export:
      Units
      empty
      size
      toString
      add
      addList
