    variant inferenceType:
      Axiom()
      Assume()
      Subst()
      Factor()
      Resolve()
      Refl()
      Equality()

    variant thm:
      Thm(clause, inference)

    fun clause(Thm(cl,_)): cl

    fun inference(Thm(_,inf)): inf

    fun isTautology(th):
      let chk:
        fun
        | ([_, None()]): None()
        | ([[pol, atm], Some(set)]): (if ((pol && Atom.isRefl(atm)) || Atom.Set.member(atm)(set)) | None() | Some(Atom.Set.add(set)(atm)))
      match Literal.Set.foldl(chk)(Some(Atom.Set.empty))(clause(th))
      | Some(_): #false
      | None(): #true

    fun isContradiction(th): Literal.Set.null(clause(th))

    fun destUnit(Thm(cl,_)): (if (Literal.Set.size(cl) == 1) | Literal.Set.pick(cl) | failwith("Thm.destUnit"))

    def isUnit = can(destUnit)

    fun destUnitEq(th): Literal.destEq(destUnit(th))

    def isUnitEq = can(destUnitEq)

    fun member(lit): fun(Thm(cl,_)): Literal.Set.member(lit)(cl)

    fun negateMember(lit): fun(Thm(cl,_)): Literal.Set.negateMember(lit)(cl)

    fun compare_impl(th1): fun(th2): Literal.Set.compare(clause(th1))(clause(th2))

    fun equal(th1): fun(th2): Literal.Set.equal(clause(th1))(clause(th2))

    fun freeIn(v): fun(Thm(cl,_)): Literal.Set.freeIn(v)(cl)

    fun freeVars(Thm(cl,_)): Literal.Set.freeVars(cl)

    fun inferenceTypeToString
    | inferenceTypeToString(Axiom()): "axiom"
    | inferenceTypeToString(Assume()): "assume"
    | inferenceTypeToString(Subst()): "subst"
    | inferenceTypeToString(Factor()): "factor"
    | inferenceTypeToString(Resolve()): "resolve"
    | inferenceTypeToString(Refl()): "refl"
    | inferenceTypeToString(Equality()): "equality"

    fun toString(Thm(cl,[infType, ths])): (inferenceTypeToString(infType) +& (": " +& Literal.Set.toString(cl)))

    fun print_proof(Thm(cl,[infType, ths])):
      Host.OCamlFormat.print_string(("Inference: " +& inferenceTypeToString(infType)))
      Host.OCamlFormat.print_break(0)(0)
      Host.OCamlFormat.print_string(("Clauses: " +& Literal.Set.toString(cl)))
      Host.OCamlFormat.print_break(0)(0)
      Host.OCamlFormat.print_string("Theorems: ")
      if (ths == (PairList []))
      | Host.OCamlFormat.print_string("<none>")
      | Host.OCamlFormat.print_break(0)(0)
        Host.OCamlFormat.open_vbox(2)
        Host.OCamlFormat.print_break(0)(0)
        PairList.for_each(ths, print_proof)
        Host.OCamlFormat.close_box()
      Host.OCamlFormat.print_break(0)(0)

    fun axiom(cl): Thm(cl, [Axiom(), PairList []])

    fun assume(lit): Thm(Literal.Set.fromList(PairList [lit, Literal.negate(lit)]), [Assume(), PairList []])

    fun subst(sub):
      fun(Thm(cl,inf) as th):
        let cl_prime = Literal.Set.subst(sub)(cl)
        if (cl === cl_prime)
        | th
        | match inf
          | [Subst(), _]: Thm(cl_prime, inf)
          | _: Thm(cl_prime, [Subst(), PairList [th]])

    fun resolve(lit):
      fun(Thm(cl1,_) as th1):
        fun(Thm(cl2,_) as th2):
          let cl1_prime_2 = Literal.Set.delete(cl1)(lit)
          let cl2_prime_2 = Literal.Set.delete(cl2)(Literal.negate(lit))
          Thm(Literal.Set.union(cl1_prime_2)(cl2_prime_2), [Resolve(), PairList [th1, th2]])

    fun refl(tm): Thm(Literal.Set.singleton([#true, Atom.mkRefl(tm)]), [Refl(), PairList []])

    fun equality(lit):
      fun(path):
        fun(t):
          let s = Literal.subterm(lit)(path)
          let lit_prime = Literal.replace(lit)([path, t])
          let eqLit = Literal.mkNeq([s, t])
          let cl = Literal.Set.fromList(PairList [eqLit, Literal.negate(lit), lit_prime])
          Thm(cl, [Equality(), PairList []])

  namespace Proof:
    export:
      Axiom
      Assume
      Subst
      Resolve
      Refl
      Equality
      parents
      inferenceToThm
      reconstructSubst
      reconstructResolvant
      reconstructEquality
      reconstruct
      thmToInference
      proof
      freeIn
      freeVars

    variant inference:
      Axiom(clause)
      Assume(atom)
      Subst(substitution, theorem)
      Resolve(atom, left, right)
      Refl(term)
      Equality(literal, path, replacement)

    fun parents
    | parents(Axiom(_)): PairList []
    | parents(Assume(_)): PairList []
    | parents(Subst(_,th)): PairList [th]
    | parents(Resolve(_,th,th_prime)): PairList [th, th_prime]
    | parents(Refl(_)): PairList []
    | parents(Equality(_,_,_)): PairList []

    fun inferenceToThm
    | inferenceToThm(Axiom(cl)): Thm.axiom(cl)
    | inferenceToThm(Assume(atm)): Thm.assume([#true, atm])
    | inferenceToThm(Subst(sub,th)): Thm.subst(sub)(th)
    | inferenceToThm(Resolve(atm,th,th_prime)): Thm.resolve([#true, atm])(th)(th_prime)
    | inferenceToThm(Refl(tm)): Thm.refl(tm)
    | inferenceToThm(Equality(lit,path,r)): Thm.equality(lit)(path)(r)

    fun reconstructSubst(cl):
      fun(cl_prime):
        fun recon
        | recon(PairList []): (throw Useful.Bug("can't reconstruct Subst rule"))
        | recon(PairList [[PairList [], sub], & others]): (if Literal.Set.equal(Literal.Set.subst(sub)(cl))(cl_prime) | sub | recon(others))
        | recon(PairList [[PairList [lit, & lits], sub], & others]):
            let checkLit:
              fun([lit_prime, acc]):
                match Useful.total(Literal.matchLiterals(sub)(lit))(lit_prime)
                | None(): acc
                | Some(sub): PairList [[lits, sub], & acc]
            recon(Literal.Set.foldl(checkLit)(others)(cl_prime))
        Substitute.normalize(recon(PairList [[Literal.Set.toList(cl), Substitute.empty]]))

    fun reconstructResolvant(cl1):
      fun(cl2):
        fun(cl):
          if !Literal.Set.subset(cl1)(cl)
          | Literal.Set.pick(Literal.Set.difference(cl1)(cl))
          | if !Literal.Set.subset(cl2)(cl)
            | Literal.negate(Literal.Set.pick(Literal.Set.difference(cl2)(cl)))
            | let cl1_prime_2 = Literal.Set.negate(cl1)
              let cl2_prime_2 = Literal.Set.negate(cl2)
              let lits = Literal.Set.intersectList(PairList [cl1, cl1_prime_2, cl2, cl2_prime_2])
              (if !Literal.Set.null(lits) | Literal.Set.pick(lits) | (throw Useful.Bug("can't reconstruct Resolve rule")))

    fun reconstructEquality(cl):
      // Recursive synchronization needs the local definition before its first use.
      fun sync(s):
        fun(t):
          fun(path):
            fun([f, a]):
              fun([f_prime, a_prime]):
                if !(Name.equal(f)(f_prime) && (length(a) == length(a_prime)))
                | None()
                | let itms = Mlist.enumerate(zip(a)(a_prime))
                  match PairList.filter(itms, ~keep: (fun(x): !uncurry(Term.equal)(snd(x))))
                  | PairList [[i, [tm, tm_prime]], & PairList []]:
                      let path = PairList [i, & path]
                      if (Term.equal(tm)(s) && Term.equal(tm_prime)(t))
                      | Some(PairList.reverse(path))
                      | match [tm, tm_prime]
                        | [Term.Fn(f_a), Term.Fn(f_a_prime)]: sync(s)(t)(path)(f_a)(f_a_prime)
                        | _: None()
                  | _: None()
      let recon_2:
        fun([neq, [pol, atm], [pol_prime, atm_prime]]):
          if (pol == pol_prime)
          | None()
          | let [s, t] = Literal.destNeq(neq)
            let path:
              if !Term.equal(s)(t)
              | sync(s)(t)(PairList [])(atm)(atm_prime)
              | (if !Atom.equal(atm)(atm_prime) | None() | Atom.find(Term.equal(s))(atm))
            match path
            | Some(path): Some([[pol_prime, atm], path, t])
            | None(): None()
      let candidates:
        match OCamlList.partition(Literal.isNeq)(Literal.Set.toList(cl))
        | [PairList [l1, & PairList []], PairList [l2, & PairList [l3, & PairList []]]]: PairList [[l1, l2, l3], [l1, l3, l2]]
        | [PairList [l1, & PairList [l2, & PairList []]], PairList [l3, & PairList []]]: PairList [[l1, l2, l3], [l1, l3, l2], [l2, l1, l3], [l2, l3, l1]]
        | [PairList [l1, & PairList []], PairList [l2, & PairList []]]: PairList [[l1, l1, l2], [l1, l2, l1]]
        | _: (throw Useful.Bug("reconstructEquality: malformed"))
      match Mlist.first(recon_2)(candidates)
      | Some(info): info
      | None(): (throw Useful.Bug("can't reconstruct Equality rule"))

    fun reconstruct(cl):
      fun(stage_arg):
        match stage_arg
        | [Thm.Axiom(), PairList []]: Axiom(cl)
        | [Thm.Assume(), PairList []]:
            match Literal.Set.findl(Literal.positive)(cl)
            | Some([_, atm]): Assume(atm)
            | None(): (throw Useful.Bug("malformed Assume inference"))
        | [Thm.Subst(), PairList [th, & PairList []]]: Subst(reconstructSubst(Thm.clause(th))(cl), th)
        | [Thm.Resolve(), PairList [th1, & PairList [th2, & PairList []]]]:
            let cl1_2 = Thm.clause(th1)
            let cl2_2 = Thm.clause(th2)
            let [pol, atm] = reconstructResolvant(cl1_2)(cl2_2)(cl)
            (if pol | Resolve(atm, th1, th2) | Resolve(atm, th2, th1))
        | [Thm.Refl(), PairList []]:
            match Literal.Set.findl(K(#true))(cl)
            | Some(lit): Refl(Literal.destRefl(lit))
            | None(): (throw Useful.Bug("malformed Refl inference"))
        | [Thm.Equality(), PairList []]:
            let [x, y, z] = reconstructEquality(cl)
            Equality(x, y, z)
        | _: (throw Useful.Bug("malformed inference"))

    fun thmToInference(th):
      let cl = Thm.clause(th)
      let thmInf = Thm.inference(th)
      let inf = reconstruct(cl)(thmInf)
      inf

    fun proof(th):
      let emptyThms = Literal.Set_map.newMap(#void)
      fun addThms([th, ths]):
        let cl = Thm.clause(th)
        if Literal.Set_map.inDomain(cl)(ths)
        | ths
        | let [_, pars] = Thm.inference(th)
          let ths = Mlist.foldl(addThms)(ths)(pars)
          (if Literal.Set_map.inDomain(cl)(ths) | ths | Literal.Set_map.insert(ths)([cl, th]))
      let mkThms = (fun(th): addThms([th, emptyThms]))
      fun addProof([th, [ths, acc]]):
        let cl = Thm.clause(th)
        match Literal.Set_map.peek(ths)(cl)
        | None(): [ths, acc]
        | Some(th):
            let [_, pars] = Thm.inference(th)
            let [ths, acc] = Mlist.foldl(addProof)([ths, acc])(pars)
            let ths = Literal.Set_map.delete(ths)(cl)
            let acc = PairList [[th, thmToInference(th)], & acc]
            [ths, acc]
      let mkProof:
        fun(ths):
          fun(th):
            let [ths, acc] = addProof([th, [ths, PairList []]])
            PairList.reverse(acc)
      let ths = mkThms(th)
      let infs = mkProof(ths)(th)
      infs

    fun freeIn(v):
      fun(infs):
        let free:
          fun(th_inf):
            match th_inf
            | [_, Axiom(lits)]: Literal.Set.freeIn(v)(lits)
            | [_, Assume(atm)]: Atom.freeIn(v)(atm)
            | [th, Subst(_,_)]: Thm.freeIn(v)(th)
            | [_, Resolve(_,_,_)]: #false
            | [_, Refl(tm)]: Term.freeIn(v)(tm)
            | [_, Equality(lit,_,tm)]: (Literal.freeIn(v)(lit) || Term.freeIn(v)(tm))
        OCamlList.exists(free)(infs)

    def freeVars:
      let inc:
        fun([th_inf, set]):
          Name.Set.union(set)(
            match th_inf
            | [_, Axiom(lits)]: Literal.Set.freeVars(lits)
            | [_, Assume(atm)]: Atom.freeVars(atm)
            | [th, Subst(_,_)]: Thm.freeVars(th)
            | [_, Resolve(_,_,_)]: Name.Set.empty
            | [_, Refl(tm)]: Term.freeVars(tm)
            | [_, Equality(lit,_,tm)]: Name.Set.union(Literal.freeVars(lit))(Term.freeVars(tm))
          )
      Mlist.foldl(inc)(Name.Set.empty)

