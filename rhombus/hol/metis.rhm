        | let n = Host.hol_sub(n)(Host.hol_add(k)(1))
          let [key_value, right] = treeDeleteNth(n, right)
          let size = Host.hol_sub(size)(1)
          let node = Node(size, priority, left, key, value, right)
          [key_value, Tree(node)]

