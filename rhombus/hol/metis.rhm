      rewrite_rewritables
      choose_clause_rewritables
      rewritables
      delete
      extract_rewritables
      prefactor_simplify
      postfactor_simplify
      sort_utilitywise
      post_factor
      factor1
      pre_factor
      rename factor_prime_impl as factor_prime
