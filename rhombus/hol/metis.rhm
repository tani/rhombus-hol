      record TNode(l, v, r, h)

      variant t:
        Empty()
        Node(node)

      fun height
      | height(Empty()): 0
      | height(Node(TNode(_,_,_,h))): h

      curried fun create(l, v, r):
        let hl:
          match l
          | Empty(): 0
          | Node(TNode(_,_,_,h)): h
        let hr:
          match r
          | Empty(): 0
          | Node(TNode(_,_,_,h)): h
        Node(TNode(l, v, r, (if Host.hol_ge(hl)(hr) | Host.hol_add(hl)(1) | Host.hol_add(hr)(1))))

      curried fun bal(l, v, r):
        let hl:
          match l
          | Empty(): 0
          | Node(TNode(_,_,_,h)): h
        let hr:
          match r
          | Empty(): 0
          | Node(TNode(_,_,_,h)): h
        if Host.hol_gt(hl)(Host.hol_add(hr)(2))
        | match l
          | Empty(): Host.hol_invalid_arg("Set.bal")
          | Node(TNode(ll,lv,lr,_)):
              if Host.hol_ge(height(ll))(height(lr))
              | create(ll)(lv)(create(lr, v, r))
              | match lr
                | Empty(): Host.hol_invalid_arg("Set.bal")
                | Node(TNode(lrl,lrv,lrr,_)): create(create(ll, lv, lrl))(lrv)(create(lrr, v, r))
        | if Host.hol_gt(hr)(Host.hol_add(hl)(2))
          | match r
            | Empty(): Host.hol_invalid_arg("Set.bal")
            | Node(TNode(rl,rv,rr,_)):
                if Host.hol_ge(height(rr))(height(rl))
                | create(create(l, v, rl), rv, rr)
                | match rl
                  | Empty(): Host.hol_invalid_arg("Set.bal")
                  | Node(TNode(rll,rlv,rlr,_)): create(create(l, v, rll))(rlv)(create(rlr, rv, rr))
          | Node(TNode(l, v, r, (if Host.hol_ge(hl)(hr) | Host.hol_add(hl)(1) | Host.hol_add(hr)(1))))

      fun add(x):
        fun
        | (Empty()): Node(TNode(Empty(), x, Empty(), 1))
        | (Node(TNode(l,v,r,_)) as t):
            let c = Ordered.compare(x)(v)
            if Host.hol_equal(c)(0)
            | t
            | if Host.hol_lt(c)(0)
              | let ll = add(x)(l)
                (if Host.hol_physical_equal(l)(ll) | t | bal(ll, v, r))
              | let rr = add(x)(r)
                (if Host.hol_physical_equal(r)(rr) | t | bal(l, v, rr))

      fun singleton(x): Node(TNode(Empty(), x, Empty(), 1))

      fun add_min_element(x):
        fun
        | (Empty()): singleton(x)
        | (Node(TNode(l,v,r,_))): bal(add_min_element(x)(l), v, r)

      fun add_max_element(x):
        fun
        | (Empty()): singleton(x)
        | (Node(TNode(l,v,r,_))): bal(l)(v)(add_max_element(x)(r))

      curried fun join(l, v, r):
        match [l, r]
        | [Empty(), _]: add_min_element(v)(r)
        | [_, Empty()]: add_max_element(v)(l)
        | [Node(TNode(ll,lv,lr,lh)), Node(TNode(rl,rv,rr,rh))]:
            if Host.hol_gt(lh)(Host.hol_add(rh)(2))
            | bal(ll)(lv)(join(lr, v, r))
            | (if Host.hol_gt(rh)(Host.hol_add(lh)(2)) | bal(join(l, v, rl), rv, rr) | create(l, v, r))

      fun min_elt
      | min_elt(Empty()): Host.hol_raise(Host.Not_found())
      | min_elt(Node(TNode(Empty(),v,_,_))): v
      | min_elt(Node(TNode(l,_,_,_))): min_elt(l)

      fun remove_min_elt
      | remove_min_elt(Empty()): Host.hol_invalid_arg("Set.remove_min_elt")
      | remove_min_elt(Node(TNode(Empty(),_,r,_))): r
      | remove_min_elt(Node(TNode(l,v,r,_))): bal(remove_min_elt(l), v, r)

      curried fun merge_impl(t1, t2):
        match [t1, t2]
        | [Empty(), t]: t
        | [t, Empty()]: t
        | [_, _]: bal(t1)(min_elt(t2))(remove_min_elt(t2))

      curried fun concat(t1, t2):
        match [t1, t2]
        | [Empty(), t]: t
        | [t, Empty()]: t
        | [_, _]: join(t1)(min_elt(t2))(remove_min_elt(t2))

      fun split(x):
        fun
        | (Empty()): [Empty(), #false, Empty()]
        | (Node(TNode(l,v,r,_))):
            let c = Ordered.compare(x)(v)
            if Host.hol_equal(c)(0)
            | [l, #true, r]
            | if Host.hol_lt(c)(0)
              | let [ll, pres, rl] = split(x)(l)
                [ll, pres, join(rl, v, r)]
              | let [lr, pres, rr] = split(x)(r)
                [join(l, v, lr), pres, rr]

      def empty = Empty()

      fun is_empty
      | is_empty(Empty()): #true
      | is_empty(_): #false

      fun mem_impl(x):
        fun
        | (Empty()): #false
        | (Node(TNode(l,v,r,_))):
            let c = Ordered.compare(x)(v)
            (Host.hol_equal(c)(0) || mem_impl(x)((if Host.hol_lt(c)(0) | l | r)))

      fun remove_impl(x):
        fun
        | (Empty()): Empty()
        | (Node(TNode(l,v,r,_)) as t):
            let c = Ordered.compare(x)(v)
            if Host.hol_equal(c)(0)
            | merge_impl(l, r)
            | if Host.hol_lt(c)(0)
              | let ll = remove_impl(x)(l)
                (if Host.hol_physical_equal(l)(ll) | t | bal(ll, v, r))
              | let rr = remove_impl(x)(r)
                (if Host.hol_physical_equal(r)(rr) | t | bal(l, v, rr))

      curried fun union_impl(s1, s2):
        match [s1, s2]
        | [Empty(), t2]: t2
        | [t1, Empty()]: t1
        | [Node(TNode(l1,v1,r1,h1)), Node(TNode(l2,v2,r2,h2))]:
            if Host.hol_ge(h1)(h2)
            | if Host.hol_equal(h2)(1)
              | add(v2)(s1)
              | let [l2, _, r2] = split(v1)(s2)
                join(union_impl(l1, l2))(v1)(union_impl(r1, r2))
            | if Host.hol_equal(h1)(1)
              | add(v1)(s2)
              | let [l1, _, r1] = split(v2)(s1)
                join(union_impl(l1, l2))(v2)(union_impl(r1, r2))

      curried fun inter(s1, s2):
        match [s1, s2]
        | [Empty(), _]: Empty()
        | [_, Empty()]: Empty()
        | [Node(TNode(l1,v1,r1,_)), t2]:
            match split(v1)(t2)
            | [l2, #false, r2]: concat(inter(l1, l2))(inter(r1, r2))
            | [l2, #true, r2]: join(inter(l1, l2))(v1)(inter(r1, r2))

      variant split_bis:
        Found()
        NotFound(left, right)

      curried fun diff(s1, s2):
        match [s1, s2]
        | [Empty(), _]: Empty()
        | [t1, Empty()]: t1
        | [Node(TNode(l1,v1,r1,_)), t2]:
            match split(v1)(t2)
            | [l2, #false, r2]: join(diff(l1, l2))(v1)(diff(r1, r2))
            | [l2, #true, r2]: concat(diff(l1, l2))(diff(r1, r2))

      variant enumeration:
        End()
        More(element, right, enumeration)

      curried fun cons_enum(s, e):
        match s
        | Empty(): e
        | Node(TNode(l,v,r,_)): cons_enum(l, More(v, r, e))

      curried fun compare_aux(e1, e2):
        match [e1, e2]
        | [End(), End()]: 0
        | [End(), _]: -1
        | [_, End()]: 1
        | [More(v1,r1,e1), More(v2,r2,e2)]:
            let c = Ordered.compare(v1)(v2)
            (if Host.hol_unequal(c)(0) | c | compare_aux(cons_enum(r1, e1))(cons_enum(r2, e2)))

      curried fun compare_impl_2(s1, s2): compare_aux(cons_enum(s1, End()))(cons_enum(s2, End()))

      curried fun equal_impl(s1, s2): Host.hol_equal(compare_impl_2(s1, s2))(0)

      curried fun subset_impl(s1, s2):
        match [s1, s2]
        | [Empty(), _]: #true
        | [_, Empty()]: #false
        | [Node(TNode(l1,v1,r1,_)), Node(TNode(l2,v2,r2,_)) as t2]:
            let c = Ordered.compare(v1)(v2)
            if Host.hol_equal(c)(0)
            | (subset_impl(l1, l2) && subset_impl(r1, r2))
            | (if Host.hol_lt(c)(0) | (subset_impl(Node(TNode(l1, v1, Empty(), 0)), l2) && subset_impl(r1, t2)) | (subset_impl(Node(TNode(Empty(), v1, r1, 0)), r2) && subset_impl(l1, t2)))

      curried fun fold(f, s, accu):
        match s
        | Empty(): accu
        | Node(TNode(l,v,r,_)): fold(f)(r)(f(v)(fold(f, l, accu)))

      fun for_all(p):
        fun
        | (Empty()): #true
        | (Node(TNode(l,v,r,_))): (p(v) && (for_all(p)(l) && for_all(p)(r)))

      fun exists_impl(p):
        fun
        | (Empty()): #false
        | (Node(TNode(l,v,r,_))): (p(v) || (exists_impl(p)(l) || exists_impl(p)(r)))

      fun cardinal
      | cardinal(Empty()): 0
      | cardinal(Node(TNode(l,_,r,_))): Host.hol_add(Host.hol_add(cardinal(l))(1))(cardinal(r))

      fun elements_aux(accu):
        fun
        | (Empty()): accu
        | (Node(TNode(l,v,r,_))): elements_aux(PairList [v, & elements_aux(accu)(r)])(l)

      fun elements(s): elements_aux(PairList [])(s)

      def choose_impl = min_elt

      def merge = merge_impl

      def mem = mem_impl

      def remove = remove_impl

      def union = union_impl

      def compare = compare_impl_2

      def equal = equal_impl

      def subset = subset_impl

      def exists = exists_impl

      def choose = choose_impl

    def compare = compare_impl

    def subterm_prime = subterm_prime_impl

    def find = find_impl

