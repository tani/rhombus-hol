          elements
          rename choose_impl as choose

        record TNode(l, v, r, h)

        variant t:
          Empty()
          Node(node)

        fun height
        | height(Empty()): 0
        | height(Node(TNode(_,_,_,h))): h

        fun create(l):
          fun(v):
            fun(r):
              let hl:
                match l
                | Empty(): 0
                | Node(TNode(_,_,_,h)): h
              let hr:
                match r
                | Empty(): 0
                | Node(TNode(_,_,_,h)): h
              Node(TNode(l, v, r, (if (hl >= hr) | (hl + 1) | (hr + 1))))

        fun bal(l):
          fun(v):
            fun(r):
              let hl:
                match l
                | Empty(): 0
                | Node(TNode(_,_,_,h)): h
              let hr:
                match r
                | Empty(): 0
                | Node(TNode(_,_,_,h)): h
              if (hl > (hr + 2))
              | match l
                | Empty(): (throw InvalidArgument("Set.bal"))
                | Node(TNode(ll,lv,lr,_)):
                    if (height(ll) >= height(lr))
                    | create(ll)(lv)(create(lr)(v)(r))
                    | match lr
                      | Empty(): (throw InvalidArgument("Set.bal"))
                      | Node(TNode(lrl,lrv,lrr,_)): create(create(ll)(lv)(lrl))(lrv)(create(lrr)(v)(r))
              | if (hr > (hl + 2))
                | match r
                  | Empty(): (throw InvalidArgument("Set.bal"))
                  | Node(TNode(rl,rv,rr,_)):
                      if (height(rr) >= height(rl))
                      | create(create(l)(v)(rl))(rv)(rr)
                      | match rl
                        | Empty(): (throw InvalidArgument("Set.bal"))
                        | Node(TNode(rll,rlv,rlr,_)): create(create(l)(v)(rll))(rlv)(create(rlr)(rv)(rr))
                | Node(TNode(l, v, r, (if (hl >= hr) | (hl + 1) | (hr + 1))))

        fun add_impl(x):
          fun(stage_arg):
            match stage_arg
            | Empty(): Node(TNode(Empty(), x, Empty(), 1))
            | Node(TNode(l,v,r,_)) as t:
                let c = Ordered.compare(x)(v)
                if (c == 0)
                | t
                | if (c < 0)
                  | let ll = add_impl(x)(l)
                    (if (l === ll) | t | bal(ll)(v)(r))
                  | let rr = add_impl(x)(r)
                    (if (r === rr) | t | bal(l)(v)(rr))

        fun singleton(x): Node(TNode(Empty(), x, Empty(), 1))

        fun add_min_element(x):
          fun(stage_arg):
            match stage_arg
            | Empty(): singleton(x)
            | Node(TNode(l,v,r,_)): bal(add_min_element(x)(l))(v)(r)

        fun add_max_element(x):
          fun(stage_arg):
            match stage_arg
            | Empty(): singleton(x)
            | Node(TNode(l,v,r,_)): bal(l)(v)(add_max_element(x)(r))

        fun join(l):
          fun(v):
            fun(r):
              match [l, r]
              | [Empty(), _]: add_min_element(v)(r)
              | [_, Empty()]: add_max_element(v)(l)
              | [Node(TNode(ll,lv,lr,lh)), Node(TNode(rl,rv,rr,rh))]:
                  if (lh > (rh + 2))
                  | bal(ll)(lv)(join(lr)(v)(r))
                  | (if (rh > (lh + 2)) | bal(join(l)(v)(rl))(rv)(rr) | create(l)(v)(r))

        fun min_elt
        | min_elt(Empty()): (throw Not_found())
        | min_elt(Node(TNode(Empty(),v,_,_))): v
        | min_elt(Node(TNode(l,_,_,_))): min_elt(l)

        fun remove_min_elt
        | remove_min_elt(Empty()): (throw InvalidArgument("Set.remove_min_elt"))
        | remove_min_elt(Node(TNode(Empty(),_,r,_))): r
        | remove_min_elt(Node(TNode(l,v,r,_))): bal(remove_min_elt(l))(v)(r)

        fun merge_impl(t1):
          fun(t2):
            match [t1, t2]
            | [Empty(), t]: t
            | [t, Empty()]: t
            | [_, _]: bal(t1)(min_elt(t2))(remove_min_elt(t2))

        fun concat(t1):
          fun(t2):
            match [t1, t2]
            | [Empty(), t]: t
            | [t, Empty()]: t
            | [_, _]: join(t1)(min_elt(t2))(remove_min_elt(t2))

        fun split_impl(x):
          fun(stage_arg):
            match stage_arg
            | Empty(): [Empty(), #false, Empty()]
            | Node(TNode(l,v,r,_)):
                let c = Ordered.compare(x)(v)
                if (c == 0)
                | [l, #true, r]
                | if (c < 0)
                  | let [ll, pres, rl] = split_impl(x)(l)
                    [ll, pres, join(rl)(v)(r)]
                  | let [lr, pres, rr] = split_impl(x)(r)
                    [join(l)(v)(lr), pres, rr]

        def empty = Empty()

        fun is_empty
        | is_empty(Empty()): #true
        | is_empty(_): #false

        fun mem_impl(x):
          fun(stage_arg):
            match stage_arg
            | Empty(): #false
            | Node(TNode(l,v,r,_)):
                let c = Ordered.compare(x)(v)
                ((c == 0) || mem_impl(x)((if (c < 0) | l | r)))

        fun remove_impl(x):
          fun(stage_arg):
            match stage_arg
            | Empty(): Empty()
            | Node(TNode(l,v,r,_)) as t:
                let c = Ordered.compare(x)(v)
                if (c == 0)
                | merge_impl(l)(r)
                | if (c < 0)
                  | let ll = remove_impl(x)(l)
                    (if (l === ll) | t | bal(ll)(v)(r))
                  | let rr = remove_impl(x)(r)
                    (if (r === rr) | t | bal(l)(v)(rr))

        fun union_impl(s1):
          fun(s2):
            match [s1, s2]
            | [Empty(), t2]: t2
            | [t1, Empty()]: t1
            | [Node(TNode(l1,v1,r1,h1)), Node(TNode(l2,v2,r2,h2))]:
                if (h1 >= h2)
                | if (h2 == 1)
                  | add_impl(v2)(s1)
                  | let [l2, _, r2] = split_impl(v1)(s2)
                    join(union_impl(l1)(l2))(v1)(union_impl(r1)(r2))
                | if (h1 == 1)
                  | add_impl(v1)(s2)
                  | let [l1, _, r1] = split_impl(v2)(s1)
                    join(union_impl(l1)(l2))(v2)(union_impl(r1)(r2))

        fun inter(s1):
          fun(s2):
            match [s1, s2]
            | [Empty(), _]: Empty()
            | [_, Empty()]: Empty()
            | [Node(TNode(l1,v1,r1,_)), t2]:
                match split_impl(v1)(t2)
                | [l2, #false, r2]: concat(inter(l1)(l2))(inter(r1)(r2))
                | [l2, #true, r2]: join(inter(l1)(l2))(v1)(inter(r1)(r2))

        variant split_bis:
          Found()
          NotFound(left, right)

        fun diff(s1):
          fun(s2):
            match [s1, s2]
            | [Empty(), _]: Empty()
            | [t1, Empty()]: t1
            | [Node(TNode(l1,v1,r1,_)), t2]:
                match split_impl(v1)(t2)
                | [l2, #false, r2]: join(diff(l1)(l2))(v1)(diff(r1)(r2))
                | [l2, #true, r2]: concat(diff(l1)(l2))(diff(r1)(r2))

        variant enumeration:
          End()
          More(element, right, enumeration)

        fun cons_enum(s):
          fun(e):
            match s
            | Empty(): e
            | Node(TNode(l,v,r,_)): cons_enum(l)(More(v, r, e))

        fun compare_aux(e1):
          fun(e2):
            match [e1, e2]
            | [End(), End()]: 0
            | [End(), _]: -1
            | [_, End()]: 1
            | [More(v1,r1,e1), More(v2,r2,e2)]:
                let c = Ordered.compare(v1)(v2)
                (if (c != 0) | c | compare_aux(cons_enum(r1)(e1))(cons_enum(r2)(e2)))

        fun compare_impl_2(s1): fun(s2): compare_aux(cons_enum(s1)(End()))(cons_enum(s2)(End()))

        fun equal_impl(s1): fun(s2): (compare_impl_2(s1)(s2) == 0)

        fun subset_impl(s1):
          fun(s2):
            match [s1, s2]
            | [Empty(), _]: #true
            | [_, Empty()]: #false
            | [Node(TNode(l1,v1,r1,_)), Node(TNode(l2,v2,r2,_)) as t2]:
                let c = Ordered.compare(v1)(v2)
                if (c == 0)
                | (subset_impl(l1)(l2) && subset_impl(r1)(r2))
                | (if (c < 0) | (subset_impl(Node(TNode(l1, v1, Empty(), 0)))(l2) && subset_impl(r1)(t2)) | (subset_impl(Node(TNode(Empty(), v1, r1, 0)))(r2) && subset_impl(l1)(t2)))

        fun fold(f):
          fun(s):
            fun(accu):
              match s
              | Empty(): accu
              | Node(TNode(l,v,r,_)): fold(f)(r)(f(v)(fold(f)(l)(accu)))

        fun for_all(p):
          fun(stage_arg):
            match stage_arg
            | Empty(): #true
            | Node(TNode(l,v,r,_)): (p(v) && (for_all(p)(l) && for_all(p)(r)))

        fun exists_impl(p):
          fun(stage_arg):
            match stage_arg
            | Empty(): #false
            | Node(TNode(l,v,r,_)): (p(v) || (exists_impl(p)(l) || exists_impl(p)(r)))

        fun cardinal
        | cardinal(Empty()): 0
        | cardinal(Node(TNode(l,_,r,_))): ((cardinal(l) + 1) + cardinal(r))

        fun elements_aux(accu):
          fun(stage_arg):
            match stage_arg
            | Empty(): accu
            | Node(TNode(l,v,r,_)): elements_aux(PairList [v, & elements_aux(accu)(r)])(l)

        fun elements(s): elements_aux(PairList [])(s)

        def choose_impl = min_elt

      def compare_impl_2 = Se.compare

      fun add_impl(s): fun(x): Se.add(x)(s)

      fun foldr_impl(f): fun(a): fun(s): Se.fold(fun(x): fun(acc): f([x, acc]))(s)(a)

      def foldl_impl = foldr_impl

      def member = Se.mem

      def empty = Se.empty

      def union_impl = Se.union

      def difference = Se.diff

      def toList = Se.elements

      def singleton = Se.singleton

      def null = Se.is_empty

      def size = Se.cardinal

      def pick = Se.choose

      def equal_impl = Se.equal

      def exists_impl = Se.exists

      fun fromList(l): OCamlList.fold_right(Se.add)(l)(Se.empty)

      fun delete(s): fun(x): Se.remove(x)(s)

      def subset_impl = Se.subset

      def intersect_impl = Se.inter

      fun intersectList
      | intersectList(PairList []): Se.empty
      | intersectList(PairList [s, & ss]): OCamlList.fold_right(Se.inter)(ss)(s)

      fun findl(p):
        fun(s):
          let go:
            fun(x):
              fun(arg):
                match arg
                | (Some(_) as s): s
                | (None()): (if p(x) | Some(x) | None())
          Se.fold(go)(s)(None())

      fun firstl(f):
        fun(s):
          let go:
            fun(x):
              fun(arg):
                match arg
                | (Some(_) as s): s
                | (None()): f(x)
          Se.fold(go)(s)(None())

      fun transform(f): fun(s): Se.fold(fun(x): fun(acc): PairList [f(x), & acc])(s)(PairList [])

      def all = Se.for_all

      fun count(p): fun(s): Se.fold(fun(x): fun(c): (if p(x) | (c + 1) | c))(s)(0)

  namespace Literal:
    export:
      polarity
      atom
      name
