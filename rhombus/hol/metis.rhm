      Set

    def compare_impl = compare

    fun equal(n1): fun(n2): (n1 == n2)

    def prefix = "_"

    fun numName(i): Useful.mkPrefix(prefix)(to_string(i))

    fun newName(_): numName(Useful.newInt(#void))

    fun newNames(n): PairList.map(Useful.newInts(n), numName)

    fun variantPrime(avoid):
      fun(n):
        fun variant(n): (if avoid(n) | variant((n +& "'")) | n)
        variant(n)

    fun variantNum(avoid):
      fun(n):
        let isDigitOrPrime = (fun(c): ((c == "'") || Useful.isDigit(c)))
        if !avoid(n)
        | n
        | let n = Useful.stripSuffix(isDigitOrPrime)(n)
          fun variant_2(i):
            let n_i = (n +& to_string(i))
            (if avoid(n_i) | variant_2((i + 1)) | n_i)
          variant_2(0)

    fun toString(s): s

    fun fromString(s): s

    namespace Ordered:
      export:
        rename compare_impl_2 as compare

      def compare_impl_2 = compare_impl

