          | [PairList [], PairList []]: 0
          | [PairList [], PairList [_, & _]]: -1
          | [PairList [_, & _], PairList []]: 1
          | [PairList [x, & xs], PairList [y, & ys]]:
              let c = cmp(x)(y)
              (if Host.hol_unequal(c)(0) | c | lex_2(xs)(ys))
      lex_2

    curried fun boolCompare(x, y):
