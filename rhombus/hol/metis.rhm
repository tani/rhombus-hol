                  | let [lr, pres, rr] = split(x)(r)
                    [join(l)(v)(lr), pres, rr]

        def empty = Empty()

        fun is_empty
        | is_empty(Empty()): #true
        | is_empty(_): #false

        fun mem_impl(x):
