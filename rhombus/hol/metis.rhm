  namespace Heap:
    export:
      Empty
      Em
      Tr
      Heap
      rank
      makeT
      merge
      newHeap
      add
      size
      null
      top
      remove
      app
      toList
      toString

    class Empty()

    variant node:
      Em()
      Tr(rank, value, left, right)

    variant heap:
      Heap(compare, size, root)

    fun rank
    | rank(Em()): 0
    | rank(Tr(r,_,_,_)): r

    fun makeT([x, a, b]): (if Host.hol_ge(rank(a))(rank(b)) | Tr(Host.hol_add(rank(b))(1), x, a, b) | Tr(Host.hol_add(rank(a))(1), x, b, a))

    fun merge_impl(cmp):
      fun mrg
      | mrg([h, Em()]): h
      | mrg([Em(), h]): h
      | mrg([Tr(_,x,a1,b1) as h1, Tr(_,y,a2,b2) as h2]): (if Host.hol_gt(cmp(x)(y))(0) | makeT([y, a2, mrg([h1, b2])]) | makeT([x, a1, mrg([b1, h2])]))
      mrg

    fun newHeap(cmp): Heap(cmp, 0, Em())

    curried fun add(Heap(f,n,a), x): Heap(f, Host.hol_add(n)(1), merge_impl(f)([Tr(1, x, Em(), Em()), a]))

    fun size(Heap(_,n,_)): n

    fun null(h): Host.hol_equal(size(h))(0)

    fun top
    | top(Heap(_,_,Em())): Host.hol_raise(Empty())
    | top(Heap(_,_,Tr(_,x,_,_))): x

    fun remove_impl
    | remove_impl(Heap(_,_,Em())): Host.hol_raise(Empty())
    | remove_impl(Heap(f,n,Tr(_,x,a,b))): [x, Heap(f, Host.hol_sub(n)(1), merge_impl(f)([a, b]))]

    fun app(f):
      fun ap
      | ap(PairList []): #void
      | ap(PairList [Em(), & rest]): ap(rest)
      | ap(PairList [Tr(_,d,a,b), & rest]):
          f(d)
          ap(PairList [a, b, & rest])
      (fun(Heap(_,_,a)): ap(PairList [a]))

    fun toList(h):
      if null(h)
      | PairList []
      | let [x, h] = remove_impl(h)
        PairList [x, & toList(h)]

    fun toString(h): Host.hol_concat("Heap[")(Host.hol_concat((if null(h) | "" | Host.hol_string_of_int(size(h))))("]"))

    def merge = merge_impl

    def remove = remove_impl

