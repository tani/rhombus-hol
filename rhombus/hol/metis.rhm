    variant units:
      Units(net)

    def empty = Units(Literal_net.newNet(Term_net.Parameters(#false)))

    fun size(Units(net)): Literal_net.size(net)

    fun toString(units): Host.hol_concat("U{")(Host.hol_concat(Host.hol_string_of_int(size(units)))("}"))

    curried fun add(Units(net), [lit, th] as uTh):
      let net = Literal_net.insert(net)([lit, uTh])
      match Useful.total(Literal.sym)(lit)
      | Host.None(): Units(net)
      | Host.Some([pol, _] as lit_prime):
          let th_prime = ((if pol | Rule.symEq | Rule.symNeq))(lit)(th)
          let net = Literal_net.insert(net)([lit_prime, [lit_prime, th_prime]])
          Units(net)

    def addList = Mlist.foldl((fun([th, u]): add(u, th)))

    curried fun matchUnits(Units(net), lit):
      let check_2:
        fun([lit_prime, _] as uTh):
          match Useful.total(Literal.matchLiterals(Substitute.empty)(lit_prime))(lit)
          | Host.None(): Host.None()
          | Host.Some(sub): Host.Some([uTh, sub])
      Mlist.first(check_2)(Literal_net.matchNet(net)(lit))

    fun reduce(units):
      let red1:
        fun([lit, news_th]):
          match Useful.total(Literal.destIrrefl)(lit)
          | Host.Some(tm):
              let [news, th] = news_th
              let th = Thm.resolve(lit)(th)(Thm.refl(tm))
              [news, th]
          | Host.None():
              let lit_prime = Literal.negate(lit)
              match matchUnits(units, lit_prime)
              | Host.None(): news_th
              | Host.Some([[_, rth], sub]):
                  let [news, th] = news_th
                  let rth = Thm.subst(sub)(rth)
                  let th = Thm.resolve(lit)(th)(rth)
                  let newLits = Literal.Set.delete(Thm.clause(rth))(lit_prime)
                  let news = Literal.Set.union(newLits)(news)
                  [news, th]
      fun red([news, th]): (if Literal.Set.null(news) | th | red(Literal.Set.foldl(red1)([Literal.Set.empty, th])(news)))
      (fun(th): Rule.removeSym(red([Thm.clause(th), th])))

