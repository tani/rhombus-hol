    def maxSpace = 1000

    fun multInt(x):
      fun(y):
        let m = hol_int_of_float(floor(math.sqrt(hol_float(max_int))))
        (if ((x <= m) && (y <= m)) | Some((x * y)) | None())

    fun iexp(x):
      fun(y):
        fun(acc):
          if ((y rem 2) == 0)
          | iexp_prime_impl(x)(y)(acc)
          | match multInt(acc)(x)
            | Some(acc): iexp_prime_impl(x)(y)(acc)
            | None(): None()

    fun iexp_prime_impl(x):
      fun(y):
        fun(acc):
          if (y == 1)
          | Some(acc)
          | let y = (y div 2)
            match multInt(x)(x)
            | Some(x): iexp(x)(y)(acc)
            | None(): None()

    fun expInt(x):
      fun(y):
        if (y <= 1)
        | if (y == 0)
          | Some(1)
          | (if (y == 1) | Some(x) | (throw Useful.Bug("expInt: negative exponent")))
        | if (x <= 1)
          | (if (0 <= x) | Some(x) | (throw Useful.Bug("expInt: negative exponand")))
          | iexp(x)(y)(1)

    fun boolToInt
    | boolToInt(#true): 1
    | boolToInt(#false): 0

    fun intToBool
    | intToBool(1): #true
    | intToBool(0): #false
    | intToBool(_): (throw Useful.Bug("Model.intToBool"))

    fun minMaxInterval(i): fun(j): Useful.interval(i)(((1 + j) - i))

    record Size(size)

    def zeroElement = 0

    fun incrementElement(Size(n)):
      fun(i):
        let i = (i + 1)
        (if (i == n) | None() | Some(i))

    fun elementListSpace(Size(n)):
      fun(arity):
        match expInt(n)(arity)
        | None(): None()
        | Some(m) as s: (if (m <= maxSpace) | s | None())

    fun elementListIndex(Size(n)):
      // Recursive indexing needs the local definition before its first use.
      fun f(acc):
        fun(elts):
          match elts
          | PairList []: acc
          | PairList [elt, & elts]: f(((n * acc) + elt))(elts)
      f(0)

    record Fixed(functions, relations)

    def uselessFixedFunction = K(K(None()))

    def uselessFixedRelation = K(K(None()))

    def emptyFunctions = Name_arity.Map.newMap(#void)

    def emptyRelations = Name_arity.Map.newMap(#void)

    fun fixed0(f):
      fun(sz):
        fun(elts):
          match elts
          | PairList []: f(sz)
          | _: (throw Useful.Bug("Model.fixed0: wrong arity"))

    fun fixed1(f):
      fun(sz):
        fun(elts):
          match elts
          | PairList [x, & PairList []]: f(sz)(x)
          | _: (throw Useful.Bug("Model.fixed1: wrong arity"))

    fun fixed2(f):
      fun(sz):
        fun(elts):
          match elts
          | PairList [x, & PairList [y, & PairList []]]: f(sz)(x)(y)
          | _: (throw Useful.Bug("Model.fixed2: wrong arity"))

    def emptyFixed:
      let fns_2 = emptyFunctions
      let rels_2 = emptyRelations
      Fixed(fns_2, rels_2)

    fun peekFunctionFixed(fix):
      fun(name_arity):
        let Fixed(fns,_) = fix
        Name_arity.Map.peek(fns)(name_arity)

    fun peekRelationFixed(fix):
      fun(name_arity):
        let Fixed(_,rels) = fix
        Name_arity.Map.peek(rels)(name_arity)

    fun getFunctionFixed(fix):
      fun(name_arity):
        match peekFunctionFixed(fix)(name_arity)
        | Some(f): f
        | None(): uselessFixedFunction

    fun getRelationFixed(fix):
      fun(name_arity):
        match peekRelationFixed(fix)(name_arity)
        | Some(rel): rel
        | None(): uselessFixedRelation

    fun insertFunctionFixed(fix):
      fun(name_arity_fun):
        let Fixed(fns,rels) = fix
        let fns = Name_arity.Map.insert(fns)(name_arity_fun)
        Fixed(fns, rels)

    fun insertRelationFixed(fix):
      fun(name_arity_rel):
        let Fixed(fns,rels) = fix
        let rels = Name_arity.Map.insert(rels)(name_arity_rel)
        Fixed(fns, rels)

    fun union_impl(_): (throw Useful.Bug("Model.unionFixed: nameArity clash"))

    fun unionFixed(fix1):
      fun(fix2):
        let Fixed(fns1_2,rels1_2) = fix1
        let Fixed(fns2_2,rels2_2) = fix2
        let fns = Name_arity.Map.union(union_impl)(fns1_2)(fns2_2)
        let rels = Name_arity.Map.union(union_impl)(rels1_2)(rels2_2)
        Fixed(fns, rels)

    def unionListFixed:
      let union_2 = (fun([fix, acc]): unionFixed(acc)(fix))
      Mlist.foldl(union_2)(emptyFixed)

    fun hasTypeFn(_):
      fun(elts):
        match elts
        | PairList [x, & PairList [_, & PairList []]]: Some(x)
        | _: (throw Useful.Bug("Model.hasTypeFn: wrong arity"))

    fun eqRel(_):
      fun(elts):
        match elts
        | PairList [x, & PairList [y, & PairList []]]: Some((x == y))
        | _: (throw Useful.Bug("Model.eqRel: wrong arity"))

    def basicFixed:
      let fns = Name_arity.Map.singleton([Term.hasTypeFunction, hasTypeFn])
      let rels = Name_arity.Map.singleton([Atom.eqRelation, eqRel])
      Fixed(fns, rels)

    record FixedMap(functionMap, relationMap)

    fun mapFixed(fixMap):
      fun(fix):
        let FixedMap(fnMap_2,relMap_2) = fixMap
        let Fixed(fns_3,rels_3) = fix
        let fns = Name_arity.Map.compose(fnMap_2)(fns_3)
        let rels = Name_arity.Map.compose(relMap_2)(rels_3)
        Fixed(fns, rels)

    def projectionMin = 1

    def projectionMax = 9

    def projectionList = minMaxInterval(projectionMin)(projectionMax)

    fun projectionName(i):
      let _ = ((projectionMin <= i) || (throw Useful.Bug("Model.projectionName: less than projectionMin")))
      let _ = ((i <= projectionMax) || (throw Useful.Bug("Model.projectionName: greater than projectionMax")))
      Name.fromString(("project" +& to_string(i)))

    fun projectionFn(i): fun(_): fun(elts): Some(OCamlList.nth(elts)((i - 1)))

    fun arityProjectionFixed(arity):
      let mkProj = (fun(i): [[projectionName(i), arity], projectionFn(i)])
      // Recursive projection construction needs the local definition before its first use.
      fun addProj(i): fun(acc): (if (i > arity) | acc | addProj((i + 1))(Name_arity.Map.insert(acc)(mkProj(i))))
      let fns = addProj(projectionMin)(emptyFunctions)
      let rels = emptyRelations
      Fixed(fns, rels)

    def projectionFixed = unionListFixed(PairList.map(projectionList, arityProjectionFixed))

    def numeralMin = -100

    def numeralMax = 100

    def numeralList = minMaxInterval(numeralMin)(numeralMax)

    fun numeralName(i):
      let _ = ((numeralMin <= i) || (throw Useful.Bug("Model.numeralName: less than numeralMin")))
      let _ = ((i <= numeralMax) || (throw Useful.Bug("Model.numeralName: greater than numeralMax")))
      let s = (if (i < 0) | ("negative" +& to_string((-i))) | to_string(i))
      Name.fromString(s)

    def addName = Name.fromString("+")

    def divName = Name.fromString("div")

    def dividesName = Name.fromString("divides")

    def evenName = Name.fromString("even")

    def expName = Name.fromString("exp")

    def geName = Name.fromString(">=")

    def gtName = Name.fromString(">")

    def isZeroName = Name.fromString("isZero")

    def leName = Name.fromString("<=")

    def ltName = Name.fromString("<")

    def modName = Name.fromString("mod")

    def multName = Name.fromString("*")

    def negName = Name.fromString("~")

    def oddName = Name.fromString("odd")

    def preName = Name.fromString("pre")

    def subName = Name.fromString("-")

    def sucName = Name.fromString("suc")

    fun modN(Size(n)): fun(x): (x rem n)

    fun oneN_impl(sz): modN(sz)(1)

    fun multN_impl(sz): fun([x, y]): modN(sz)((x * y))

    fun numeralFn_impl(i): fun(sz): Some(modN(sz)(i))

    fun addFn_impl(sz): fun(x): fun(y): Some(modN(sz)((x + y)))

    fun divFn_impl(Size(n)):
      fun(x):
        fun(y):
          let y = (if (y == 0) | n | y)
          Some((x div y))

    fun expFn_impl(sz): fun(x): fun(y): Some(Useful.exp(multN_impl(sz))(x)(y)(oneN_impl(sz)))

    fun modFn_impl(Size(n)):
      fun(x):
        fun(y):
          let y = (if (y == 0) | n | y)
          Some((x rem y))

    fun multFn_impl(sz): fun(x): fun(y): Some(multN_impl(sz)([x, y]))

    fun negFn_impl(Size(n)): fun(x): Some((if (x == 0) | 0 | (n - x)))

    fun preFn_impl(Size(n)): fun(x): Some((if (x == 0) | (n - 1) | (x - 1)))

    fun subFn_impl(Size(n)): fun(x): fun(y): Some((if (x < y) | ((n + x) - y) | (x - y)))

    fun sucFn_impl(Size(n)): fun(x): Some((if (x == (n - 1)) | 0 | (x + 1)))

    fun dividesRel_impl(_): fun(x): fun(y): Some(Useful.divides(x)(y))

    fun evenRel_impl(_): fun(x): Some(((x rem 2) == 0))

    fun geRel_impl(_): fun(x): fun(y): Some((x >= y))

    fun gtRel_impl(_): fun(x): fun(y): Some((x > y))

    fun isZeroRel_impl(_): fun(x): Some((x == 0))

    fun leRel_impl(_): fun(x): fun(y): Some((x <= y))

    fun ltRel_impl(_): fun(x): fun(y): Some((x < y))

    fun oddRel_impl(_): fun(x): Some(((x rem 2) == 1))

    def modularFixed:
      let fns:
        Name_arity.Map.fromList(
          append(PairList.map(numeralList, (fun(i): [[numeralName(i), 0], fixed0(numeralFn_impl(i))])))(
            PairList [
              [[addName, 2], fixed2(addFn_impl)],
              [[divName, 2], fixed2(divFn_impl)],
              [[expName, 2], fixed2(expFn_impl)],
              [[modName, 2], fixed2(modFn_impl)],
              [[multName, 2], fixed2(multFn_impl)],
              [[negName, 1], fixed1(negFn_impl)],
              [[preName, 1], fixed1(preFn_impl)],
              [[subName, 2], fixed2(subFn_impl)],
              [[sucName, 1], fixed1(sucFn_impl)]
            ]
          )
        )
      let rels:
        Name_arity.Map.fromList(
          PairList [
            [[dividesName, 2], fixed2(dividesRel_impl)],
            [[evenName, 1], fixed1(evenRel_impl)],
            [[geName, 2], fixed2(geRel_impl)],
            [[gtName, 2], fixed2(gtRel_impl)],
            [[isZeroName, 1], fixed1(isZeroRel_impl)],
            [[leName, 2], fixed2(leRel_impl)],
            [[ltName, 2], fixed2(ltRel_impl)],
            [[oddName, 1], fixed1(oddRel_impl)]
          ]
        )
      Fixed(fns, rels)

    fun cutN(Size(n)): fun(x): (if (x >= n) | (n - 1) | x)

    fun oneN_v2(sz): cutN(sz)(1)

    fun multN_v2(sz): fun([x, y]): cutN(sz)((x * y))

    fun numeralFn_v2(i): fun(sz): (if (i < 0) | None() | Some(cutN(sz)(i)))

    fun addFn_v2(sz): fun(x): fun(y): Some(cutN(sz)((x + y)))

    fun divFn_v2(_): fun(x): fun(y): (if (y == 0) | None() | Some((x div y)))

    fun expFn_v2(sz): fun(x): fun(y): Some(Useful.exp(multN_v2(sz))(x)(y)(oneN_v2(sz)))

    fun modFn_v2(Size(n)): fun(x): fun(y): (if ((y == 0) || (x == (n - 1))) | None() | Some((x rem y)))

    fun multFn_v2(sz): fun(x): fun(y): Some(multN_v2(sz)([x, y]))

    fun negFn_v2(_): fun(x): (if (x == 0) | Some(0) | None())

    fun preFn_v2(_): fun(x): (if (x == 0) | None() | Some((x - 1)))

    fun subFn_v2(Size(n)):
      fun(x):
        fun(y):
          if (y == 0)
          | Some(x)
          | (if ((x == (n - 1)) || (x < y)) | None() | Some((x - y)))

    fun sucFn_v2(sz): fun(x): Some(cutN(sz)((x + 1)))

    fun dividesRel_v2(Size(n)):
      fun(x):
        fun(y):
          if ((x == 1) || (y == 0))
          | Some(#true)
          | if (x == 0)
            | Some(#false)
            | (if (y == (n - 1)) | None() | Some(Useful.divides(x)(y)))

    fun evenRel_v2(Size(n)): fun(x): (if (x == (n - 1)) | None() | Some(((x rem 2) == 0)))

    fun geRel_v2(Size(n)):
      fun(y):
        fun(x):
          if (x == (n - 1))
          | (if (y == (n - 1)) | None() | Some(#false))
          | (if (y == (n - 1)) | Some(#true) | Some((x <= y)))

    fun gtRel_v2(Size(n)):
      fun(y):
        fun(x):
          if (x == (n - 1))
          | (if (y == (n - 1)) | None() | Some(#false))
          | (if (y == (n - 1)) | Some(#true) | Some((x < y)))

    fun isZeroRel_v2(_): fun(x): Some((x == 0))

    fun leRel_v2(Size(n)):
      fun(x):
        fun(y):
          if (x == (n - 1))
          | (if (y == (n - 1)) | None() | Some(#false))
          | (if (y == (n - 1)) | Some(#true) | Some((x <= y)))

    fun ltRel_v2(Size(n)):
      fun(x):
        fun(y):
          if (x == (n - 1))
          | (if (y == (n - 1)) | None() | Some(#false))
          | (if (y == (n - 1)) | Some(#true) | Some((x < y)))

    fun oddRel_v2(Size(n)): fun(x): (if (x == (n - 1)) | None() | Some(((x rem 2) == 1)))

    def overflowFixed:
      let fns:
        Name_arity.Map.fromList(
          append(PairList.map(numeralList, (fun(i): [[numeralName(i), 0], fixed0(numeralFn_v2(i))])))(
            PairList [
              [[addName, 2], fixed2(addFn_v2)],
              [[divName, 2], fixed2(divFn_v2)],
              [[expName, 2], fixed2(expFn_v2)],
              [[modName, 2], fixed2(modFn_v2)],
              [[multName, 2], fixed2(multFn_v2)],
              [[negName, 1], fixed1(negFn_v2)],
              [[preName, 1], fixed1(preFn_v2)],
              [[subName, 2], fixed2(subFn_v2)],
              [[sucName, 1], fixed1(sucFn_v2)]
            ]
          )
        )
      let rels:
        Name_arity.Map.fromList(
          PairList [
            [[dividesName, 2], fixed2(dividesRel_v2)],
            [[evenName, 1], fixed1(evenRel_v2)],
            [[geName, 2], fixed2(geRel_v2)],
            [[gtName, 2], fixed2(gtRel_v2)],
            [[isZeroName, 1], fixed1(isZeroRel_v2)],
            [[leName, 2], fixed2(leRel_v2)],
            [[ltName, 2], fixed2(ltRel_v2)],
            [[oddName, 1], fixed1(oddRel_v2)]
          ]
        )
      Fixed(fns, rels)

    def cardName = Name.fromString("card")

    def complementName = Name.fromString("complement")

    def differenceName = Name.fromString("difference")

    def emptyName = Name.fromString("empty")

    def memberName = Name.fromString("member")

    def insertName = Name.fromString("insert")

    def intersectName = Name.fromString("intersect")

    def singletonName = Name.fromString("singleton")

    def subsetName = Name.fromString("subset")

    def symmetricDifferenceName = Name.fromString("symmetricDifference")

    def unionName = Name.fromString("union")

    def universeName = Name.fromString("universe")

    fun eltN(Size(n)):
      // Recursive element indexing needs the local definition before its first use.
      fun f_2(acc):
        fun(stage_arg):
          match stage_arg
          | 0: acc
          | x: f_2((acc + 1))((x div 2))
      f_2(-1)(n)

    fun posN(i): Word.shiftLeft([1, Word.fromInt(i)])

    fun univN(sz): Word.minus([posN(eltN(sz)), 1])

    fun setN(sz): fun(x): Word.andb([Word.fromInt(x), univN(sz)])

    fun cardFn(sz):
      fun(x):
        // Recursive cardinality counting needs the local definition before its first use.
        fun f_3(acc):
          fun(stage_arg):
            match stage_arg
            | 0: acc
            | s:
                let acc = (if (Word.andb([s, 1]) == 0) | acc | (acc + 1))
                f_3(acc)(Word.shiftRight([s, 1]))
        Some(f_3(setN(sz)(x))(0))

    fun complementFn(sz): fun(x): Some(Word.toInt(Word.xorb([univN(sz), setN(sz)(x)])))

    fun differenceFn(sz):
      fun(x):
        fun(y):
          let x_2 = setN(sz)(x)
          let y_2 = setN(sz)(y)
          Some(Word.toInt(Word.andb([x_2, Word.notb(y_2)])))

    fun emptyFn(_): Some(0)

    fun insertFn(sz):
      fun(x):
        fun(y):
          let x_3 = (x rem eltN(sz))
          let y_3 = setN(sz)(y)
          Some(Word.toInt(Word.orb([posN(x_3), y_3])))

    fun intersectFn(sz): fun(x): fun(y): Some(Word.toInt(Word.andb([setN(sz)(x), setN(sz)(y)])))

    fun singletonFn(sz):
      fun(x):
        let x = (x rem eltN(sz))
        Some(Word.toInt(posN(x)))

    fun symmetricDifferenceFn(sz):
      fun(x):
        fun(y):
          let x_4 = setN(sz)(x)
          let y_4 = setN(sz)(y)
          Some(Word.toInt(Word.xorb([x_4, y_4])))

    fun unionFn(sz): fun(x): fun(y): Some(Word.toInt(Word.orb([setN(sz)(x), setN(sz)(y)])))

    fun universeFn(sz): Some(Word.toInt(univN(sz)))

    fun memberRel(sz):
      fun(x):
        fun(y):
          let x_5 = (x rem eltN(sz))
          let y_5 = setN(sz)(y)
          Some((Word.andb([posN(x_5), y_5]) != 0))

    fun subsetRel(sz):
      fun(x):
        fun(y):
          let x_6 = setN(sz)(x)
          let y_6 = setN(sz)(y)
          Some((Word.andb([x_6, Word.notb(y_6)]) == 0))

    def setFixed:
      let fns:
        Name_arity.Map.fromList(
          PairList [
            [[cardName, 1], fixed1(cardFn)],
            [[complementName, 1], fixed1(complementFn)],
            [[differenceName, 2], fixed2(differenceFn)],
            [[emptyName, 0], fixed0(emptyFn)],
            [[insertName, 2], fixed2(insertFn)],
            [[intersectName, 2], fixed2(intersectFn)],
            [[singletonName, 1], fixed1(singletonFn)],
            [[symmetricDifferenceName, 2], fixed2(symmetricDifferenceFn)],
            [[unionName, 2], fixed2(unionFn)],
            [[universeName, 0], fixed0(universeFn)]
          ]
        )
      let rels = Name_arity.Map.fromList(PairList [[[memberName, 2], fixed2(memberRel)], [[subsetName, 2], fixed2(subsetRel)]])
      Fixed(fns, rels)

    def appendName = Name.fromString("@")

    def consName = Name.fromString("::")

    def lengthName = Name.fromString("length")

    def nilName = Name.fromString("nil")

    def nullName = Name.fromString("null")

    def tailName = Name.fromString("tail")

    def baseFix:
      let fix_2 = unionFixed(projectionFixed)(overflowFixed)
      let sucFn = getFunctionFixed(fix_2)([sucName, 1])
      let suc2Fn = fun(sz): fun(_): fun(x): sucFn(sz)(PairList [x])
      insertFunctionFixed(fix_2)([[sucName, 2], fixed2(suc2Fn)])

    def fixMap:
      FixedMap(
        Name_arity.Map.fromList(
          PairList [
            [[appendName, 2], addName],
            [[consName, 2], sucName],
            [[lengthName, 1], projectionName(1)],
            [[nilName, 0], numeralName(0)],
            [[tailName, 1], preName]
          ]
        ),
        Name_arity.Map.fromList(PairList [[[nullName, 1], isZeroName]])
      )

    def listFixed = mapFixed(fixMap)(baseFix)

    variant valuation:
      Valuation(map)

    def emptyValuation = Valuation(Name.Map.newMap(#void))

    fun insertValuation(Valuation(m)): fun(v_i): Valuation(Name.Map.insert(m)(v_i))

    fun peekValuation(Valuation(m)): fun(v): Name.Map.peek(m)(v)

    fun constantValuation(i):
      let add = (fun([v, v_prime]): insertValuation(v_prime)([v, i]))
      Name.Set.foldl(add)(emptyValuation)

    def zeroValuation = constantValuation(zeroElement)

    fun getValuation(v_prime):
      fun(v):
        match peekValuation(v_prime)(v)
        | Some(i): i
        | None(): failwith("Model.getValuation: incomplete valuation")

    fun randomValuation(Size(n)):
      fun(vs):
        let f_4 = (fun([v, v_prime]): insertValuation(v_prime)([v, ocaml_random_int(n)]))
        Name.Set.foldl(f_4)(emptyValuation)(vs)

    fun incrementValuation(n):
      fun(vars):
        // Recursive valuation increment needs the local definition before its first use.
        fun inc(vs):
          fun(v_prime):
            match vs
            | PairList []: None()
            | PairList [v, & vs]:
                let [carry, i]:
                  match incrementElement(n)(getValuation(v_prime)(v))
                  | Some(i): [#false, i]
                  | None(): [#true, zeroElement]
                let v_prime = insertValuation(v_prime)([v, i])
                (if carry | inc(vs)(v_prime) | Some(v_prime))
        inc(Name.Set.toList(vars))

    fun foldValuation(n):
      fun(vars):
        fun(f):
          let inc_2 = incrementValuation(n)(vars)
          // Recursive folding needs the local definition before its first use.
          fun fold(v_prime):
            fun(acc):
              let acc = f([v_prime, acc])
              match inc_2(v_prime)
              | None(): acc
              | Some(v_prime): fold(v_prime)(acc)
          let zero = zeroValuation(vars)
          fold(zero)

    def cUNKNOWN = -1

    variant table:
      Forgetful_table()
      Array_table(array)

    fun newTable(n):
      fun(arity):
        match elementListSpace(Size(n))(arity)
        | None(): Forgetful_table()
        | Some(space): Array_table(Array.make(space, cUNKNOWN))

    fun randomResult(r): ocaml_random_int(r)

    fun lookupTable(n):
      fun(vR):
        fun(table):
          fun(elts):
            match table
            | Forgetful_table(): randomResult(vR)
            | Array_table(a):
                let i = elementListIndex(Size(n))(elts)
                let r = a[i]
                if (r != cUNKNOWN)
                | r
                | let r = randomResult(vR)
                  let #void = (a[i] := r)
                  r

    fun updateTable(n):
      fun(table):
        fun([elts, r]):
          match table
          | Forgetful_table(): #void
          | Array_table(a):
              let i = elementListIndex(Size(n))(elts)
              let #void = (a[i] := r)
              #void

    record Tables(domainSize, rangeSize, tableMap)

    fun newTables(n): fun(vR): Tables(n, vR, Box(Name_arity.Map.newMap(#void)))

    fun getTables(tables):
      fun(n_a):
        let Tables(n,_,tm) = tables
        let m = tm.value
        match Name_arity.Map.peek(m)(n_a)
        | Some(t): t
        | None():
            let [_, a_2] = n_a
            let t = newTable(n)(a_2)
            let m = Name_arity.Map.insert(m)([n_a, t])
            let #void = (tm.value := m)
            t

    fun lookupTables(tables):
      fun([n, elts]):
        let Tables(vN,vR,_) = tables
        let a_3 = length(elts)
        let table = getTables(tables)([n, a_3])
        lookupTable(vN)(vR)(table)(elts)

    fun updateTables(tables):
      fun([[n, elts], r]):
        let Tables(vN,_,_) = tables
        let a_4 = length(elts)
        let table = getTables(tables)([n, a_4])
        updateTable(vN)(table)([elts, r])

    record Parameters(sizep, fixed)

    record Model(sizem, fixedFunctions, fixedRelations, randomFunctions, randomRelations)

    fun newModel(Parameters(vN,fixed)):
      let Fixed(fns,rels) = fixed
      let fixFns_2 = Name_arity.Map.transform((fun(f): f(Size(vN))))(fns)
      let fixRels_2 = Name_arity.Map.transform((fun(r): r(Size(vN))))(rels)
      let rndFns_2 = newTables(vN)(vN)
      let rndRels_2 = newTables(vN)(2)
      Model(vN, fixFns_2, fixRels_2, rndFns_2, rndRels_2)

    fun msize(Model(vN,_,_,_,_)): vN

    fun psize(Parameters(vN,_)): vN

    fun peekFixedFunction(vM):
      fun([n, elts]):
        let Model(_,fixFns,_,_,_) = vM
        match Name_arity.Map.peek(fixFns)([n, length(elts)])
        | None(): None()
        | Some(fixFn): fixFn(elts)

    fun isFixedFunction(vM): fun(n_elts): Option.is_some(peekFixedFunction(vM)(n_elts))

    fun peekFixedRelation(vM):
      fun([n, elts]):
        let Model(_,_,fixRels,_,_) = vM
        match Name_arity.Map.peek(fixRels)([n, length(elts)])
        | None(): None()
        | Some(fixRel): fixRel(elts)

    fun isFixedRelation(vM): fun(n_elts): Option.is_some(peekFixedRelation(vM)(n_elts))

    def defaultSize = 8

    def defaultFixed = unionListFixed(PairList [basicFixed, projectionFixed, modularFixed, setFixed, listFixed])

    def default = Parameters(defaultSize, defaultFixed)

    fun destTerm(tm):
      match tm
      | Term.Var(_): tm
      | Term.Fn(f_tms):
          match Term.stripApp(tm)
          | [_, PairList []]: tm
          | [Term.Var(_) as v, tms]: Term.Fn([Term.appName, PairList [v, & tms]])
          | [Term.Fn([f, tms]), tms_prime]: Term.Fn([f, append(tms)(tms_prime)])

    fun interpretFunction(vM):
      fun(n_elts):
        match peekFixedFunction(vM)(n_elts)
        | Some(r): r
        | None():
            let Model(_,_,_,rndFns,_) = vM
            lookupTables(rndFns)(n_elts)

    fun interpretRelation(vM):
      fun(n_elts):
        match peekFixedRelation(vM)(n_elts)
        | Some(r): r
        | None():
            let Model(_,_,_,_,rndRels) = vM
            intToBool(lookupTables(rndRels)(n_elts))

    fun interpretTerm(vM):
      fun(vV):
        fun interpret(tm):
          match destTerm(tm)
          | Term.Var(v): getValuation(vV)(v)
          | Term.Fn([f, tms]): interpretFunction(vM)([f, PairList.map(tms, interpret)])
        interpret

    fun interpretAtom(vM): fun(vV): fun([r, tms]): interpretRelation(vM)([r, OCamlList.map(interpretTerm(vM)(vV))(tms)])

    fun interpretFormula(vM):
      let vN = msize(vM)
      // Mutually recursive formula interpretation needs local definitions for forward references.
      fun interpret_2(vV):
        fun(fm):
          match fm
          | Formula.True(): #true
          | Formula.False(): #false
          | Formula.Atom(atm): interpretAtom(vM)(vV)(atm)
          | Formula.Not(p): !interpret_2(vV)(p)
          | Formula.Or(p,q): (interpret_2(vV)(p) || interpret_2(vV)(q))
          | Formula.And(p,q): (interpret_2(vV)(p) && interpret_2(vV)(q))
          | Formula.Imp(p,q): interpret_2(vV)(Formula.Or(Formula.Not(p), q))
          | Formula.Iff(p,q): (interpret_2(vV)(p) == interpret_2(vV)(q))
          | Formula.Forall(v,p): interpret_prime_2(vV)(p)(v)(vN)
          | Formula.Exists(v,p): interpret_2(vV)(Formula.Not(Formula.Forall(v, Formula.Not(p))))
      // Mutually recursive formula interpretation needs both local definitions before use.
      fun interpret_prime_2(vV):
        fun(fm):
          fun(v):
            fun(i):
              if (i == 0)
              | #true
              | let i = (i - 1)
                let vV_prime = insertValuation(vV)([v, i])
                (interpret_2(vV_prime)(fm) && interpret_prime_2(vV)(fm)(v)(i))
      interpret_2

    fun interpretLiteral(vM):
      fun(vV):
        fun([pol, atm]):
          let b = interpretAtom(vM)(vV)(atm)
          (if pol | b | !b)

    fun interpretClause(vM): fun(vV): fun(cl): Literal.Set.exists(interpretLiteral(vM)(vV))(cl)

    fun check_impl(interpret):
      fun(maxChecks):
        fun(vM):
          fun(fv):
            fun(x):
              let vN = msize(vM)
              let score = (fun([vV, [vT, vF]]): (if interpret(vM)(vV)(x) | [(vT + 1), vF] | [vT, (vF + 1)]))
              let randomCheck = (fun(acc): score([randomValuation(Size(vN))(fv), acc]))
              let maxChecks:
                match maxChecks
                | None(): maxChecks
                | Some(m):
                    match expInt(vN)(Name.Set.size(fv))
                    | Some(n): (if (n <= m) | None() | maxChecks)
                    | None(): maxChecks
              match maxChecks
              | Some(m): funpow(m)(randomCheck)([0, 0])
              | None(): foldValuation(Size(vN))(fv)(score)([0, 0])

    fun checkAtom(maxChecks): fun(vM): fun(atm): check_impl(interpretAtom)(maxChecks)(vM)(Atom.freeVars(atm))(atm)

    fun checkFormula(maxChecks): fun(vM): fun(fm): check_impl(interpretFormula)(maxChecks)(vM)(Formula.freeVars(fm))(fm)

    fun checkLiteral(maxChecks): fun(vM): fun(lit): check_impl(interpretLiteral)(maxChecks)(vM)(Literal.freeVars(lit))(lit)

    fun checkClause(maxChecks): fun(vM): fun(cl): check_impl(interpretClause)(maxChecks)(vM)(Literal.Set.freeVars(cl))(cl)

    fun updateFunction(vM):
      fun(func_elts_elt):
        let Model(_,_,_,rndFns,_) = vM
        let #void = updateTables(rndFns)(func_elts_elt)
        #void

    fun updateRelation(vM):
      fun([rel_elts, pol]):
        let Model(_,_,_,_,rndRels) = vM
        let #void = updateTables(rndRels)([rel_elts, boolToInt(pol)])
        #void

    variant modelTerm:
      Model_var()
      Model_fn(symbol, arguments, elements)

    fun modelTerm(vM):
      fun(vV):
        fun modelTm(tm):
          match destTerm(tm)
          | Term.Var(v): [Model_var(), getValuation(vV)(v)]
          | Term.Fn([f, tms]):
              let [tms, xs] = unzip(PairList.map(tms, modelTm))
              [Model_fn(f, tms, xs), interpretFunction(vM)([f, xs])]
        modelTm

    variant perturbation:
      Function_perturbation(application, result)
      Relation_perturbation(application, polarity)

    fun perturb(vM):
      fun(pert):
        match pert
        | Function_perturbation([func, elts],elt): updateFunction(vM)([[func, elts], elt])
        | Relation_perturbation([rel, elts],pol): updateRelation(vM)([[rel, elts], pol])

    fun pertTerm(vM):
      fun(target):
        fun(tm):
          fun(acc):
            match target
            | PairList []: acc
            | _:
                match tm
                | Model_var(): acc
                | Model_fn(func,tms,xs):
                    let onTarget = (fun(ys): OCamlList.mem(interpretFunction(vM)([func, ys]))(target))
                    let func_xs = [func, xs]
                    let acc:
                      if isFixedFunction(vM)(func_xs)
                      | acc
                      | let add = (fun([y, acc]): PairList [Function_perturbation(func_xs, y), & acc])
                        Mlist.foldl(add)(acc)(target)
                    pertTerms(vM)(onTarget)(tms)(xs)(acc)

    fun pertTerms(vM):
      fun(onTarget):
        let vN = msize(vM)
        let filterElements:
          fun(pred):
            // Recursive filtering needs the local definition before its first use.
            fun filt(i):
              fun(acc):
                match i
                | 0: acc
                | _:
                    let i = (i - 1)
                    let acc = (if pred(i) | PairList [i, & acc] | acc)
                    filt(i)(acc)
            filt(vN)(PairList [])
        fun pert
        | pert([_, PairList [], PairList [], acc]): acc
        | pert([ys, PairList [tm, & tms], PairList [x, & xs], acc]):
            let pred = (fun(y): ((y != x) && onTarget(OCamlList.rev_append(ys)(PairList [y, & xs]))))
            let target = filterElements(pred)
            let acc = pertTerm(vM)(target)(tm)(acc)
            pert([PairList [x, & ys], tms, xs, acc])
        | pert([_, _, _, _]): (throw Useful.Bug("Model.pertTerms.pert"))
        (fun(x): fun(y): fun(z): pert([PairList [], x, y, z]))

    fun pertAtom(vM):
      fun(vV):
        fun(target):
          fun([rel, tms]):
            fun(acc):
              let onTarget = (fun(ys): (interpretRelation(vM)([rel, ys]) == target))
              let [tms, xs] = unzip(OCamlList.map(modelTerm(vM)(vV))(tms))
              let rel_xs = [rel, xs]
              let acc = (if isFixedRelation(vM)(rel_xs) | acc | PairList [Relation_perturbation(rel_xs, target), & acc])
              pertTerms(vM)(onTarget)(tms)(xs)(acc)

    fun pertLiteral(vM): fun(vV): fun([[pol, atm], acc]): pertAtom(vM)(vV)(pol)(atm)(acc)

    fun pertClause(vM): fun(vV): fun(cl): fun(acc): Literal.Set.foldl(pertLiteral(vM)(vV))(acc)(cl)

    fun pickPerturb(vM): fun(perts): (if Mlist.null(perts) | #void | perturb(vM)(OCamlList.nth(perts)(ocaml_random_int(length(perts)))))

    fun perturbTerm(vM): fun(vV): fun([tm, target]): pickPerturb(vM)(pertTerm(vM)(target)(fst(modelTerm(vM)(vV)(tm)))(PairList []))

    fun perturbAtom(vM): fun(vV): fun([atm, target]): pickPerturb(vM)(pertAtom(vM)(vV)(target)(atm)(PairList []))

    fun perturbLiteral(vM): fun(vV): fun(lit): pickPerturb(vM)(pertLiteral(vM)(vV)([lit, PairList []]))

    fun perturbClause(vM): fun(vV): fun(cl): pickPerturb(vM)(pertClause(vM)(vV)(cl)(PairList []))

  namespace Term_net:
    export:
      anonymousName
      anonymousVar
      Var
      Fn
      cmp
      fnCmp
      compareQterm
      compareFnQterm
      equalQterm
      equalFnQterm
      termToQterm
      rename qm_v2 as qm
      matchQtermQterm
      matchQtermTerm
      qn
      matchTermQterm
      qv
      qu
      unifyQtermQterm
      unifyQtermTerm
      qtermToTerm
      Parameters
      Result
      Single
      Multiple
      Net
      newNet
      computeSize
      netSize
      size
      null
      singles
      pre
      add
      oadd
      ins
      rename insert_impl as insert
      fromList
      rename filter_impl as filter
      toString
      norm
      addQterm
      addFn
      stackEmpty
      stackAddQterm
      stackAddFn
      stackValue
      rename fold_v2 as fold
      foldTerms
      foldEqualTerms
