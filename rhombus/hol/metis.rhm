        record TNode(l, v, d, r, h)

        variant t:
          Empty()
          Node(node)

        fun height
        | height(Empty()): 0
        | height(Node(TNode(_,_,_,_,h))): h

        fun create(l):
          fun(x):
            fun(d):
              fun(r):
                let hl_2 = height(l)
                let hr_2 = height(r)
                Node(
                  TNode(l, x, d, r, (if (hl_2 >= hr_2) | (hl_2 + 1) | (hr_2 + 1)))
                )

        fun singleton(x): fun(d): Node(TNode(Empty(), x, d, Empty(), 1))

        fun bal(l):
          fun(x):
            fun(d):
              fun(r):
                let hl:
                  match l
                  | Empty(): 0
                  | Node(TNode(_,_,_,_,h)): h
                let hr:
                  match r
                  | Empty(): 0
                  | Node(TNode(_,_,_,_,h)): h
                if (hl > (hr + 2))
                | match l
                  | Empty(): (throw InvalidArgument("Map.bal"))
                  | Node(TNode(ll,lv,ld,lr,_)):
                      if (height(ll) >= height(lr))
                      | create(ll)(lv)(ld)(create(lr)(x)(d)(r))
                      | match lr
                        | Empty(): (throw InvalidArgument("Map.bal"))
                        | Node(TNode(lrl,lrv,lrd,lrr,_)): create(create(ll)(lv)(ld)(lrl))(lrv)(lrd)(create(lrr)(x)(d)(r))
                | if (hr > (hl + 2))
                  | match r
                    | Empty(): (throw InvalidArgument("Map.bal"))
                    | Node(TNode(rl,rv,rd,rr,_)):
                        if (height(rr) >= height(rl))
                        | create(create(l)(x)(d)(rl))(rv)(rd)(rr)
                        | match rl
                          | Empty(): (throw InvalidArgument("Map.bal"))
                          | Node(TNode(rll,rlv,rld,rlr,_)): create(create(l)(x)(d)(rll))(rlv)(rld)(create(rlr)(rv)(rd)(rr))
                  | Node(TNode(l, x, d, r, (if (hl >= hr) | (hl + 1) | (hr + 1))))

        def empty = Empty()

        fun is_empty
        | is_empty(Empty()): #true
        | is_empty(_): #false

        fun add_impl(x):
          fun(data):
            fun
            | (Empty()): Node(TNode(Empty(), x, data, Empty(), 1))
            | (Node(TNode(l,v,d,r,h)) as m):
                let c = Ordered.compare(x)(v)
                if (c == 0)
                | (if (d === data) | m | Node(TNode(l, x, data, r, h)))
                | if (c < 0)
                  | let ll = add_impl(x)(data)(l)
                    (if (l === ll) | m | bal(ll)(v)(d)(r))
                  | let rr = add_impl(x)(data)(r)
                    (if (r === rr) | m | bal(l)(v)(d)(rr))

        fun find_impl(x):
          fun(stage_arg):
            match stage_arg
            | Empty(): (throw Not_found())
            | Node(TNode(l,v,d,r,_)):
                let c = Ordered.compare(x)(v)
                if (c == 0)
                | d
                | find_impl(x)((if (c < 0) | l | r))

        fun mem_impl(x):
          fun(stage_arg):
            match stage_arg
            | Empty(): #false
            | Node(TNode(l,v,_,r,_)):
                let c = Ordered.compare(x)(v)
                ((c == 0) || mem_impl(x)((if (c < 0) | l | r)))

        fun min_binding
        | min_binding(Empty()): (throw Not_found())
        | min_binding(Node(TNode(Empty(),v,d,_,_))): [v, d]
        | min_binding(Node(TNode(l,_,_,_,_))): min_binding(l)

        fun remove_min_binding
        | remove_min_binding(Empty()): (throw InvalidArgument("Map.remove_min_elt"))
        | remove_min_binding(Node(TNode(Empty(),_,_,r,_))): r
        | remove_min_binding(Node(TNode(l,v,d,r,_))): bal(remove_min_binding(l))(v)(d)(r)

        fun merge_impl(t1):
          fun(t2):
            match [t1, t2]
            | [Empty(), t]: t
            | [t, Empty()]: t
            | [_, _]:
                let [x, d] = min_binding(t2)
                bal(t1)(x)(d)(remove_min_binding(t2))

        fun remove_impl(x):
          fun(stage_arg):
            match stage_arg
            | Empty(): Empty()
            | Node(TNode(l,v,d,r,_)) as m:
                let c = Ordered.compare(x)(v)
                if (c == 0)
                | merge_impl(l)(r)
                | if (c < 0)
                  | let ll = remove_impl(x)(l)
                    (if (l === ll) | m | bal(ll)(v)(d)(r))
                  | let rr = remove_impl(x)(r)
                    (if (r === rr) | m | bal(l)(v)(d)(rr))

        fun map_impl(f):
          fun(stage_arg):
            match stage_arg
            | Empty(): Empty()
            | Node(TNode(l,v,d,r,h)):
                let l_prime = map_impl(f)(l)
                let d_prime = f(d)
                let r_prime = map_impl(f)(r)
                Node(TNode(l_prime, v, d_prime, r_prime, h))

        fun fold(f):
          fun(m):
            fun(accu):
              match m
              | Empty(): accu
              | Node(TNode(l,v,d,r,_)): fold(f)(r)(f(v)(d)(fold(f)(l)(accu)))

        fun exists_impl(p):
          fun(stage_arg):
            match stage_arg
            | Empty(): #false
            | Node(TNode(l,v,d,r,_)): (p(v)(d) || (exists_impl(p)(l) || exists_impl(p)(r)))

        fun add_min_binding(k):
          fun(x):
            fun
            | (Empty()): singleton(k)(x)
            | (Node(TNode(l,v,d,r,_))): bal(add_min_binding(k)(x)(l))(v)(d)(r)

        fun add_max_binding(k):
          fun(x):
            fun
            | (Empty()): singleton(k)(x)
            | (Node(TNode(l,v,d,r,_))): bal(l)(v)(d)(add_max_binding(k)(x)(r))

        fun join(l):
          fun(v):
            fun(d):
              fun(r):
                match [l, r]
                | [Empty(), _]: add_min_binding(v)(d)(r)
                | [_, Empty()]: add_max_binding(v)(d)(l)
                | [Node(TNode(ll,lv,ld,lr,lh)), Node(TNode(rl,rv,rd,rr,rh))]:
                    if (lh > (rh + 2))
                    | bal(ll)(lv)(ld)(join(lr)(v)(d)(r))
                    | (if (rh > (lh + 2)) | bal(join(l)(v)(d)(rl))(rv)(rd)(rr) | create(l)(v)(d)(r))

        fun concat(t1):
          fun(t2):
            match [t1, t2]
            | [Empty(), t]: t
            | [t, Empty()]: t
            | [_, _]:
                let [x, d] = min_binding(t2)
                join(t1)(x)(d)(remove_min_binding(t2))

        fun concat_or_join(t1):
          fun(v):
            fun(d):
              fun(t2):
                match d
                | Some(d): join(t1)(v)(d)(t2)
                | None(): concat(t1)(t2)

        fun split_impl(x):
          fun(stage_arg):
            match stage_arg
            | Empty(): [Empty(), None(), Empty()]
            | Node(TNode(l,v,d,r,_)):
                let c = Ordered.compare(x)(v)
                if (c == 0)
                | [l, Some(d), r]
                | if (c < 0)
                  | let [ll, pres, rl] = split_impl(x)(l)
                    [ll, pres, join(rl)(v)(d)(r)]
                  | let [lr, pres, rr] = split_impl(x)(r)
                    [join(l)(v)(d)(lr), pres, rr]

        fun merge_v2(f):
          fun(s1):
            fun(s2):
              let subject = [s1, s2]
              match subject
              | [Empty(), Empty()]: Empty()
              | [Node(TNode(l1,v1,d1,r1,h1)), _]:
                  if (h1 >= height(s2))
                  | let [l2, d2, r2] = split_impl(v1)(s2)
                    concat_or_join(merge_v2(f)(l1)(l2))(v1)(f(v1)(Some(d1))(d2))(merge_v2(f)(r1)(r2))
                  | match subject
                    | [_, Node(TNode(l2,v2,d2,r2,_))]:
                        let [l1, d1, r1] = split_impl(v2)(s1)
                        concat_or_join(merge_v2(f)(l1)(l2))(v2)(f(v2)(d1)(Some(d2)))(merge_v2(f)(r1)(r2))
                    | _: (if #false | #void | failwith("Assertion failed"))
              | [_, Node(TNode(l2,v2,d2,r2,_))]:
                  let [l1, d1, r1] = split_impl(v2)(s1)
                  concat_or_join(merge_v2(f)(l1)(l2))(v2)(f(v2)(d1)(Some(d2)))(merge_v2(f)(r1)(r2))
              | _: (if #false | #void | failwith("Assertion failed"))

        fun filter_impl(p):
          fun(stage_arg):
            match stage_arg
            | Empty(): Empty()
            | Node(TNode(l,v,d,r,_)) as m:
                let l_prime = filter_impl(p)(l)
                let pvd = p(v)(d)
                let r_prime = filter_impl(p)(r)
                if pvd
                | (if ((l === l_prime) && (r === r_prime)) | m | join(l_prime)(v)(d)(r_prime))
                | concat(l_prime)(r_prime)

        variant enumeration:
          End()
          More(key, value, right, enumeration)

        fun cardinal
        | cardinal(Empty()): 0
        | cardinal(Node(TNode(l,_,_,r,_))): ((cardinal(l) + 1) + cardinal(r))

        fun bindings_aux(accu):
          fun(stage_arg):
            match stage_arg
            | Empty(): accu
            | Node(TNode(l,v,d,r,_)): bindings_aux(PairList [[v, d], & bindings_aux(accu)(r)])(l)

        fun bindings(s): bindings_aux(PairList [])(s)

      fun newMap(_): Ma.empty

      def null = Ma.is_empty

      fun singleton([k, x]): Ma.singleton(k)(x)

      def size = Ma.cardinal

      fun get(m):
        fun(k):
          try:
            Ma.find(k)(m)
            ~catch exn:
              match exn
              | Not_found(): failwith("Mmap.get: element not found")
              | exn: (throw exn)

      fun peek(m):
        fun(k):
          try:
            Some(Ma.find(k)(m))
            ~catch exn:
              match exn
              | Not_found(): None()
              | exn: (throw exn)

      fun insert_impl(m): fun([k, v]): Ma.add(k)(v)(m)

      def toList = Ma.bindings

      fun fromList(l): OCamlList.fold_right((fun([v, tm]): Ma.add(v)(tm)))(l)(Ma.empty)

      fun foldl_impl(f): fun(b): fun(m): OCamlList.fold_left(fun(s): fun([v, tm]): f([v, tm, s]))(b)(Ma.bindings(m))

      def foldr_impl = foldl_impl

      fun filter_impl(f): fun(m): Ma.filter(fun(x): fun(y): f([x, y]))(m)

      def inDomain = Ma.mem

      fun union_impl(f):
        fun(m1):
          fun(m2):
            let f_prime:
              fun(k):
                fun(arg):
                  match arg
                  | ([Some(x), Some(y)]): f([[k, x], [k, y]])
                  | ([Some(x), None()]): Some(x)
                  | ([None(), Some(y)]): Some(y)
                  | ([None(), None()]): None()
            Ma.merge(fun(k): fun(x): fun(y): f_prime(k)([x, y]))(m1)(m2)

      fun delete(m): fun(k): Ma.remove(k)(m)

      fun mapPartial(f):
        fun(m):
          Ma.fold(
            fun(k):
              fun(x):
                fun(acc):
                  match f([k, x])
                  | Some(y): Ma.add(k)(y)(acc)
                  | None(): acc
          )(m)(Ma.empty)

      def transform = Ma.map

      fun exists_impl(f): fun(m): Ma.exists(fun(k): fun(v): f([k, v]))(m)

