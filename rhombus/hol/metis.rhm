    curried fun equalKey(compareKey, key1, key2): Host.hol_equal(compareKey(key1)(key2))(0)

    def randomPriority = Host.ocaml_random_bits

    def comparePriority = Word.compare

    variant tree:
      Empty()
      Tree(node)

    record Node(size, priority, left, key, value, right)

    curried fun lowerPriorityNode(node1, node2):
      let Node(_,p1_2,_,_,_,_) = node1
      let Node(_,p2_2,_,_,_,_) = node2
      Host.hol_lt(comparePriority(p1_2)(p2_2))(0)

    fun treeNew(_): Empty()

    fun nodeSize(Node(x,_,_,_,_,_)): x

    fun treeSize(tree):
      match tree
      | Empty(): 0
      | Tree(x): nodeSize(x)

    curried fun mkNode(priority, left, key, value, right):
      let size = Host.hol_add(Host.hol_add(treeSize(left))(1))(treeSize(right))
      Node(size, priority, left, key, value, right)

    curried fun mkTree(priority, left, key, value, right):
      let node = mkNode(priority, left, key, value, right)
      Tree(node)

    curried fun treeLeftSpine(acc, tree):
      match tree
      | Empty(): acc
      | Tree(node): nodeLeftSpine(acc, node)

    curried fun nodeLeftSpine(acc, node):
      let Node(_,_,left,_,_,_) = node
      treeLeftSpine(PairList [node, & acc], left)

    curried fun treeRightSpine(acc, tree):
      match tree
      | Empty(): acc
      | Tree(node): nodeRightSpine(acc, node)

    curried fun nodeRightSpine(acc, node):
      let Node(_,_,_,_,_,right) = node
      treeRightSpine(PairList [node, & acc], right)

    curried fun mkNodeSingleton(priority, key, value):
      let size_2 = 1
      let left_2 = Empty()
      let right_2 = Empty()
      Node(size_2, priority, left_2, key, value, right_2)

    fun nodeSingleton([key, value]):
      let priority = Host.hol_apply_unit(randomPriority)
      mkNodeSingleton(priority, key, value)

    fun treeSingleton(key_value):
      let node = nodeSingleton(key_value)
      Tree(node)

    curried fun treeAppend(tree1, tree2):
      match tree1
      | Empty(): tree2
      | Tree(node1):
          match tree2
          | Empty(): tree1
          | Tree(node2):
              if lowerPriorityNode(node1, node2)
              | let Node(_,priority,left,key,value,right) = node2
                let left = treeAppend(tree1, left)
                mkTree(priority, left, key, value, right)
              | let Node(_,priority,left,key,value,right) = node1
                let right = treeAppend(right, tree2)
                mkTree(priority, left, key, value, right)

    curried fun treeCombine(left, node, right):
      let left_node = treeAppend(left, Tree(node))
      treeAppend(left_node, right)

    curried fun treePeek(compareKey, pkey, tree):
      match tree
      | Empty(): Host.None()
      | Tree(node): nodePeek(compareKey, pkey, node)

    curried fun nodePeek(compareKey, pkey, node):
      let Node(_,_,left,key,value,right) = node
      let c = compareKey(pkey)(key)
      if Host.hol_lt(c)(0)
      | treePeek(compareKey, pkey, left)
      | (if Host.hol_equal(c)(0) | Host.Some(value) | treePeek(compareKey, pkey, right))

    curried fun treePeekPath(compareKey, pkey, path, tree):
      match tree
      | Empty(): [path, Host.None()]
      | Tree(node): nodePeekPath(compareKey, pkey, path, node)

    curried fun nodePeekPath(compareKey, pkey, path, node):
      let Node(_,_,left,key,_,right) = node
      let c = compareKey(pkey)(key)
      if Host.hol_lt(c)(0)
      | treePeekPath(compareKey, pkey, PairList [[#true, node], & path], left)
      | (if Host.hol_equal(c)(0) | [path, Host.Some(node)] | treePeekPath(compareKey, pkey, PairList [[#false, node], & path], right))

    fun addSidePath([[wentLeft, node], [leftTree, rightTree]]):
      let Node(_,priority,left,key,value,right) = node
      (if wentLeft | [leftTree, mkTree(priority, rightTree, key, value, right)] | [mkTree(priority, left, key, value, leftTree), rightTree])

    fun addSidesPath(left_right): Mlist.foldl(addSidePath)(left_right)

    fun mkSidesPath(path): addSidesPath([Empty(), Empty()])(path)

    fun updateTree([[wentLeft, node], tree]):
      let Node(_,priority,left,key,value,right) = node
      (if wentLeft | mkTree(priority, tree, key, value, right) | mkTree(priority, left, key, value, tree))

    fun updateTreePath(tree): Mlist.foldl(updateTree)(tree)

    fun insertNodePath(node):
      fun insert_2(left_right):
        fun(path):
          match path
          | PairList []:
              let [left, right] = left_right
              treeCombine(left, node, right)
          | PairList [[_, snode] as step, & rest]:
              if lowerPriorityNode(snode, node)
              | let left_right = addSidePath([step, left_right])
                insert_2(left_right)(rest)
              | let [left, right] = left_right
                let tree = treeCombine(left, node, right)
                updateTreePath(tree)(path)
      insert_2([Empty(), Empty()])

    curried fun nodePartition(compareKey, pkey, node):
      let [path, pnode] = nodePeekPath(compareKey, pkey, PairList [], node)
      match pnode
      | Host.None():
          let [left, right] = mkSidesPath(path)
          [left, Host.None(), right]
      | Host.Some(node):
          let Node(_,_,left,key,value,right) = node
          let [left, right] = addSidesPath([left, right])(path)
          [left, Host.Some([key, value]), right]

    curried fun treePeekKey(compareKey, pkey, tree):
      match tree
      | Empty(): Host.None()
      | Tree(node): nodePeekKey(compareKey, pkey, node)

    curried fun nodePeekKey(compareKey, pkey, node):
      let Node(_,_,left,key,value,right) = node
      let c = compareKey(pkey)(key)
