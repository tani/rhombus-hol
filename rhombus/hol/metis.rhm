    def anonymousName = Name.fromString("_")

    def anonymousVar = Term.Var(anonymousName)

    variant qterm:
      Var()
      Fn(symbol_arity, arguments)

    fun cmp
    | cmp(PairList []): 0
    | cmp(PairList [[q1, q2] as q1_q2, & qs]):
        if Host.hol_physical_equal(q1)(q2)
        | cmp(qs)
        | match q1_q2
          | [Var(), Var()]: 0
          | [Var(), Fn(_,_)]: -1
          | [Fn(_,_), Var()]: 1
          | [Fn(f1,f1_prime), Fn(f2,f2_prime)]: fnCmp([f1, f1_prime], [f2, f2_prime], qs)

    curried fun fnCmp([n1, q1], [n2, q2], qs):
      let c = Name_arity.compare(n1)(n2)
      (if Host.hol_unequal(c)(0) | c | cmp(append(zip(q1)(q2))(qs)))

    curried fun compareQterm(q1, q2): cmp(PairList [[q1, q2]])

    curried fun compareFnQterm(f1, f2): fnCmp(f1, f2, PairList [])

    curried fun equalQterm(q1, q2): Host.hol_equal(compareQterm(q1, q2))(0)

    curried fun equalFnQterm(f1, f2): Host.hol_equal(compareFnQterm(f1, f2))(0)

    fun termToQterm
    | termToQterm(Term.Var(_)): Var()
    | termToQterm(Term.Fn([f, l])): Fn([f, length(l)], Host.OCamlList.map(termToQterm)(l))

    fun qm_impl
    | qm_impl(PairList []): #true
    | qm_impl(PairList [[Var(), _], & rest]): qm_impl(rest)
    | qm_impl(PairList [[Fn(_,_), Var()], & _]): #false
    | qm_impl(PairList [[Fn(f,a), Fn(g,b)], & rest]): (Name_arity.equal(f)(g) && qm_impl(append(zip(a)(b))(rest)))

    curried fun matchQtermQterm(qtm, qtm_prime): qm_impl(PairList [[qtm, qtm_prime]])

    fun qm_v2
    | qm_v2(PairList []): #true
    | qm_v2(PairList [[Var(), _], & rest]): qm_v2(rest)
    | qm_v2(PairList [[Fn(_,_), Term.Var(_)], & _]): #false
    | qm_v2(PairList [[Fn([f, n],a), Term.Fn([g, b])], & rest]): (Name.equal(f)(g) && (Host.hol_equal(n)(length(b)) && qm_v2(append(zip(a)(b))(rest))))

    curried fun matchQtermTerm(qtm, tm): qm_v2(PairList [[qtm, tm]])

    fun qn(qsub):
      fun
      | (PairList []): Host.Some(qsub)
      | (PairList [[Term.Var(v), qtm], & rest]):
          match Name.Map.peek(qsub)(v)
          | Host.None(): qn(Name.Map.insert(qsub)([v, qtm]))(rest)
          | Host.Some(qtm_prime): (if equalQterm(qtm, qtm_prime) | qn(qsub)(rest) | Host.None())
      | (PairList [[Term.Fn(_), Var()], & _]): Host.None()
      | (PairList [[Term.Fn([f, a]), Fn([g, n],b)], & rest]): (if (Name.equal(f)(g) && Host.hol_equal(length(a))(n)) | qn(qsub)(append(zip(a)(b))(rest)) | Host.None())

    curried fun matchTermQterm(qsub, tm, qtm): qn(qsub)(PairList [[tm, qtm]])

    curried fun qv(s, t):
      match [s, t]
      | [Var(), x]: x
      | [x, Var()]: x
      | [Fn(f,a), Fn(g,b)]:
          let _ = (Name_arity.equal(f)(g) || failwith("Term_net.qv"))
          Fn(f, Host.map2(qv)(a)(b))

    fun qu(qsub):
      fun
      | (PairList []): qsub
      | (PairList [[Var(), _], & rest]): qu(qsub)(rest)
      | (PairList [[qtm, Term.Var(v)], & rest]):
          let qtm:
            match Name.Map.peek(qsub)(v)
            | Host.None(): qtm
            | Host.Some(qtm_prime): qv(qtm, qtm_prime)
          qu(Name.Map.insert(qsub)([v, qtm]))(rest)
      | (PairList [[Fn([f, n],a), Term.Fn([g, b])], & rest]): (if (Name.equal(f)(g) && Host.hol_equal(n)(length(b))) | qu(qsub)(append(zip(a)(b))(rest)) | failwith("Term_net.qu"))

    curried fun unifyQtermQterm(qtm, qtm_prime): Useful.total(qv(qtm))(qtm_prime)

    curried fun unifyQtermTerm(qsub, qtm, tm): Useful.total(qu(qsub))(PairList [[qtm, tm]])

    fun qtermToTerm
    | qtermToTerm(Var()): anonymousVar
    | qtermToTerm(Fn([f, _],l)): Term.Fn([f, Host.OCamlList.map(qtermToTerm)(l)])

    record Parameters(fifo)

    variant net:
      Result(results)
      Single(term, net)
      Multiple(variables, functions)

    variant termNet:
      Net(parameters, size, net)

    fun newNet(parm): Net(parm, 0, Host.None())

    fun computeSize
    | computeSize(Result(l)): length(l)
    | computeSize(Single(_,n)): computeSize(n)
    | computeSize(Multiple(vs,fs)):
        Name_arity.Map.foldl((fun([_, n, acc]): Host.hol_add(acc)(computeSize(n))))(
          match vs
          | Host.Some(n): computeSize(n)
          | Host.None(): 0
        )(fs)

    fun netSize
    | netSize(Host.None()): Host.None()
    | netSize(Host.Some(n)): Host.Some([computeSize(n), n])

    fun size
    | size(Net(_,_,Host.None())): 0
    | size(Net(_,_,Host.Some([i, _]))): i

    fun null(net): Host.hol_equal(size(net))(0)

    curried fun singles(qtms, a): Mlist.foldr((fun([x, y]): Single(x, y)))(a)(qtms)

    fun pre
    | pre(Host.None()): [0, Host.None()]
    | pre(Host.Some([i, n])): [i, Host.Some(n)]

    curried fun add(a, b, c):
      match [a, b, c]
      | [Result(l), PairList [], Result(l_prime)]: Result(append(l)(l_prime))
      | [a, PairList [qtm, & qtms] as input1, Single(qtm_prime,n)]:
          if equalQterm(qtm, qtm_prime)
          | Single(qtm, add(a, qtms, n))
          | add(a)(input1)(
              add(n)(PairList [qtm_prime])(Multiple(Host.None(), Host.hol_apply_unit(Name_arity.Map.newMap)))
            )
      | [a, PairList [Var(), & qtms], Multiple(vs,fs)]: Multiple(Host.Some(oadd(a, qtms)(vs)), fs)
      | [a, PairList [Fn(f,l), & qtms], Multiple(vs,fs)]:
          let n = Name_arity.Map.peek(fs)(f)
          Multiple(vs, Name_arity.Map.insert(fs)([f, oadd(a)(append(l)(qtms))(n)]))
      | _: Host.hol_raise(Useful.Bug("Term_net.insert: Match"))

    curried fun oadd(a, qtms):
      fun
      | (Host.None()): singles(qtms, a)
      | (Host.Some(n)): add(a, qtms, n)

    curried fun ins(a, qtm, [i, n]): Host.Some([Host.hol_add(i)(1), oadd(Result(PairList [a]), PairList [qtm])(n)])

    curried fun insert_impl(Net(p,k,n), [tm, a]):
      try:
        Net(p, Host.hol_add(k)(1), ins([k, a])(termToQterm(tm))(pre(n)))
        ~catch exn:
          match exn
          | Failure(_): Host.hol_raise(Useful.Bug("Term_net.insert: should never fail"))
          | exn: Host.hol_raise(exn)

    curried fun fromList(parm, l): Mlist.foldl((fun([tm_a, n]): insert_impl(n, tm_a)))(newNet(parm))(l)

    fun filter_impl(pred):
      fun filt
      | filt(Result(l)):
          match Host.OCamlList.filter((fun([_, a]): pred(a)))(l)
          | PairList []: Host.None()
          | l: Host.Some(Result(l))
      | filt(Single(qtm,n)):
          match filt(n)
          | Host.None(): Host.None()
          | Host.Some(n): Host.Some(Single(qtm, n))
      | filt(Multiple(vs,fs)):
          let vs = Option.bind(vs)(filt)
          let fs = Name_arity.Map.mapPartial((fun([_, n]): filt(n)))(fs)
          (if (Host.hol_not(Option.is_some(vs)) && Name_arity.Map.null(fs)) | Host.None() | Host.Some(Multiple(vs, fs)))
      try:
        fun
        | (Net(_,_,Host.None()) as net): net
        | (Net(p,k,Host.Some([_, n]))): Net(p, k, netSize(filt(n)))
        ~catch exn:
          match exn
          | Failure(_): Host.hol_raise(Useful.Bug("Term_net.filter: should never fail"))
          | exn: Host.hol_raise(exn)

    fun toString(net): Host.hol_concat("Term_net[")(Host.hol_concat(Host.hol_string_of_int(size(net)))("]"))

    fun norm
    | norm([PairList [0, & ks], PairList [[_, n] as f, & fs], qtms]):
        let [a_2, qtms] = Mlist.revDivide(qtms)(n)
        addQterm(Fn(f, a_2), [ks, fs, qtms])
    | norm(stack): stack

    curried fun addQterm(qtm, [ks, fs, qtms]):
      let ks:
        match ks
        | PairList []: PairList []
        | PairList [k, & ks]: PairList [Host.hol_sub(k)(1), & ks]
      norm([ks, fs, PairList [qtm, & qtms]])

    curried fun addFn([_, n] as f, [ks, fs, qtms]): norm([PairList [n, & ks], PairList [f, & fs], qtms])

    def stackEmpty = [PairList [], PairList [], PairList []]

    def stackAddQterm = addQterm

    def stackAddFn = addFn

    fun stackValue
    | stackValue([PairList [], PairList [], PairList [qtm, & PairList []]]): qtm
    | stackValue(_): Host.hol_raise(Useful.Bug("Term_net.stackValue"))

    curried fun fold_impl(inc, acc):
      fun
      | (PairList []): acc
      | (PairList [[0, stack, net], & rest]): fold_impl(inc)(inc([stackValue(stack), net, acc]))(rest)
      | (PairList [[n, stack, Single(qtm,net)], & rest]): fold_impl(inc, acc)(PairList [[Host.hol_sub(n)(1), stackAddQterm(qtm)(stack), net], & rest])
      | (PairList [[n, stack, Multiple(v,fns)], & rest]):
          let n = Host.hol_sub(n)(1)
          let rest:
            match v
            | Host.None(): rest
            | Host.Some(net): PairList [[n, stackAddQterm(Var())(stack), net], & rest]
          let getFns = (fun([[_, k] as f, net, x]): PairList [[Host.hol_add(k)(n), stackAddFn(f)(stack), net], & x])
          fold_impl(inc, acc)(Name_arity.Map.foldr(getFns)(rest)(fns))
      | (_): Host.hol_raise(Useful.Bug("Term_net.foldTerms.fold"))

    curried fun foldTerms(inc, acc, net): fold_impl(inc, acc)(PairList [[1, stackEmpty, net]])

    curried fun foldEqualTerms(pat, inc, acc):
      fun fold
      | fold([PairList [], net]): inc([pat, net, acc])
      | fold([PairList [pat, & pats], Single(qtm,net)]): (if equalQterm(pat, qtm) | fold([pats, net]) | acc)
      | fold([PairList [Var(), & pats], Multiple(v,_)]):
          match v
          | Host.None(): acc
          | Host.Some(net): fold([pats, net])
      | fold([PairList [Fn(f,a), & pats], Multiple(_,fns)]):
          match Name_arity.Map.peek(fns)(f)
          | Host.None(): acc
          | Host.Some(net): fold([append(a)(pats), net])
      | fold(_): Host.hol_raise(Useful.Bug("Term_net.foldEqualTerms.fold"))
      (fun(net): fold([PairList [pat], net]))

    curried fun fold_v2(inc, acc):
      fun
      | (PairList []): acc
      | (PairList [[PairList [], stack, net], & rest]): fold_v2(inc)(inc([stackValue(stack), net, acc]))(rest)
      | (PairList [[PairList [Var(), & pats], stack, net], & rest]):
          let harvest = (fun([qtm, n, l]): PairList [[pats, stackAddQterm(qtm)(stack), n], & l])
          fold_v2(inc, acc)(foldTerms(harvest, rest, net))
      | (PairList [[PairList [pat, & pats], stack, Single(qtm,net)], & rest]):
          match unifyQtermQterm(pat, qtm)
          | Host.None(): fold_v2(inc, acc)(rest)
          | Host.Some(qtm): fold_v2(inc, acc)(PairList [[pats, stackAddQterm(qtm)(stack), net], & rest])
      | (PairList [[PairList [Fn(f,a) as pat, & pats], stack, Multiple(v,fns)], & rest]):
          let rest:
            match v
            | Host.None(): rest
            | Host.Some(net): PairList [[pats, stackAddQterm(pat)(stack), net], & rest]
          let rest:
            match Name_arity.Map.peek(fns)(f)
            | Host.None(): rest
            | Host.Some(net): PairList [[append(a)(pats), stackAddFn(f)(stack), net], & rest]
          fold_v2(inc, acc)(rest)
      | (_): Host.hol_raise(Useful.Bug("Term_net.foldUnifiableTerms.fold"))

    curried fun foldUnifiableTerms(pat, inc, acc, net): fold_v2(inc, acc)(PairList [[PairList [pat], stackEmpty, net]])

    curried fun idwise([m, _], [n, _]): Useful.intCompare(m)(n)

    curried fun fifoize(Parameters(fifo), l): (if fifo | Host.OCamlList.sort(idwise)(l) | l)

    curried fun finally(parm, l): Host.OCamlList.map(snd)(fifoize(parm, l))

    fun mat_impl(acc):
      fun
      | (PairList []): acc
      | (PairList [[Result(l), PairList []], & rest]): mat_impl(append(l)(acc))(rest)
      | (PairList [[Single(qtm,n), PairList [tm, & tms]], & rest]): mat_impl(acc)((if matchQtermTerm(qtm, tm) | PairList [[n, tms], & rest] | rest))
      | (PairList [[Multiple(vs,fs), PairList [tm, & tms]], & rest]):
          let rest:
            match vs
            | Host.None(): rest
            | Host.Some(n): PairList [[n, tms], & rest]
          let rest:
            match tm
            | Term.Var(_): rest
            | Term.Fn([f, l]):
                match Name_arity.Map.peek(fs)([f, length(l)])
                | Host.None(): rest
                | Host.Some(n): PairList [[n, append(l)(tms)], & rest]
          mat_impl(acc)(rest)
      | (_): Host.hol_raise(Useful.Bug("Term_net.match: Match"))

    curried fun matchNet(x, y):
      match [x, y]
      | [Net(_,_,Host.None()), _]: PairList []
      | [Net(p,_,Host.Some([_, n])), tm]:
          try:
            finally(p)(mat_impl(PairList [])(PairList [[n, PairList [tm]]]))
            ~catch exn:
              match exn
              | Failure(_): Host.hol_raise(Useful.Bug("Term_net.match: should never fail"))
              | exn: Host.hol_raise(exn)

    curried fun unseenInc(qsub, v, tms, [qtm, net, rest]): PairList [[Name.Map.insert(qsub)([v, qtm]), net, tms], & rest]

    curried fun seenInc(qsub, tms, [_, net, rest]): PairList [[qsub, net, tms], & rest]

    fun mat_v2(acc):
      fun
      | (PairList []): acc
      | (PairList [[_, Result(l), PairList []], & rest]): mat_v2(append(l)(acc))(rest)
      | (PairList [[qsub, Single(qtm,net), PairList [tm, & tms]], & rest]):
          match matchTermQterm(qsub, tm, qtm)
          | Host.None(): mat_v2(acc)(rest)
          | Host.Some(qsub): mat_v2(acc)(PairList [[qsub, net, tms], & rest])
      | (PairList [[qsub, Multiple(_,_) as net, PairList [Term.Var(v), & tms]], & rest]):
          match Name.Map.peek(qsub)(v)
          | Host.None(): mat_v2(acc)(foldTerms(unseenInc(qsub, v, tms), rest, net))
          | Host.Some(qtm): mat_v2(acc)(foldEqualTerms(qtm)(seenInc(qsub, tms))(rest)(net))
      | (PairList [[qsub, Multiple(_,fns), PairList [Term.Fn([f, a]), & tms]], & rest]):
          let rest:
            match Name_arity.Map.peek(fns)([f, length(a)])
            | Host.None(): rest
            | Host.Some(net): PairList [[qsub, net, append(a)(tms)], & rest]
          mat_v2(acc)(rest)
      | (_): Host.hol_raise(Useful.Bug("Term_net.matched.mat"))

    curried fun matched(x, tm):
      match x
      | Net(_,_,Host.None()): PairList []
      | Net(parm,_,Host.Some([_, net])):
          try:
            finally(parm)(mat_v2(PairList [])(PairList [[Host.hol_apply_unit(Name.Map.newMap), net, PairList [tm]]]))
            ~catch exn:
              match exn
              | Failure(_): Host.hol_raise(Useful.Bug("Term_net.matched: should never fail"))
              | exn: Host.hol_raise(exn)

    curried fun inc(qsub, v, tms, [qtm, net, rest]): PairList [[Name.Map.insert(qsub)([v, qtm]), net, tms], & rest]

    fun mat_v3(acc):
      fun
      | (PairList []): acc
      | (PairList [[_, Result(l), PairList []], & rest]): mat_v3(append(l)(acc))(rest)
      | (PairList [[qsub, Single(qtm,net), PairList [tm, & tms]], & rest]):
          match unifyQtermTerm(qsub, qtm, tm)
          | Host.None(): mat_v3(acc)(rest)
          | Host.Some(qsub): mat_v3(acc)(PairList [[qsub, net, tms], & rest])
      | (PairList [[qsub, Multiple(_,_) as net, PairList [Term.Var(v), & tms]], & rest]):
          match Name.Map.peek(qsub)(v)
          | Host.None(): mat_v3(acc)(foldTerms(inc(qsub, v, tms), rest, net))
          | Host.Some(qtm): mat_v3(acc)(foldUnifiableTerms(qtm)(inc(qsub, v, tms))(rest)(net))
      | (PairList [[qsub, Multiple(v,fns), PairList [Term.Fn([f, a]), & tms]], & rest]):
          let rest:
            match v
            | Host.None(): rest
            | Host.Some(net): PairList [[qsub, net, tms], & rest]
          let rest:
            match Name_arity.Map.peek(fns)([f, length(a)])
            | Host.None(): rest
            | Host.Some(net): PairList [[qsub, net, append(a)(tms)], & rest]
          mat_v3(acc)(rest)
      | (_): Host.hol_raise(Useful.Bug("Term_net.unify.mat"))

    curried fun unify(x, tm):
      match x
      | Net(_,_,Host.None()): PairList []
      | Net(parm,_,Host.Some([_, net])):
          try:
            finally(parm)(mat_v3(PairList [])(PairList [[Host.hol_apply_unit(Name.Map.newMap), net, PairList [tm]]]))
            ~catch exn:
              match exn
              | Failure(_): Host.hol_raise(Useful.Bug("Term_net.unify: should never fail"))
              | exn: Host.hol_raise(exn)

    def qm = qm_v2

    def insert = insert_impl

    def filter = filter_impl

    def fold = fold_v2

    def mat = mat_v3

  namespace Atom_net:
    export:
