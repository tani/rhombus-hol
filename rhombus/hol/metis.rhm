        record TNode(l, v, r, h)

        variant t:
          Empty()
          Node(node)

        fun height
        | height(Empty()): 0
        | height(Node(TNode(_,_,_,h))): h

        fun create(l):
          fun(v):
            fun(r):
              let hl:
                match l
                | Empty(): 0
                | Node(TNode(_,_,_,h)): h
              let hr:
                match r
                | Empty(): 0
                | Node(TNode(_,_,_,h)): h
