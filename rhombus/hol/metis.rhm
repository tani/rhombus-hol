    fun name([rel, _]): rel

    fun arguments([_, args]): args

    fun arity(atm): length(arguments(atm))

    fun relation(atm): [name(atm), arity(atm)]

    def functions:
      let f = (fun([tm, acc]): Name_arity.Set.union(Term.functions(tm))(acc))
      (fun(atm): Mlist.foldl(f)(Name_arity.Set.empty)(arguments(atm)))

    def functionNames:
      let f = (fun([tm, acc]): Name.Set.union(Term.functionNames(tm))(acc))
      (fun(atm): Mlist.foldl(f)(Name.Set.empty)(arguments(atm)))

    fun mkBinop(p): fun([a, b]): [p, PairList [a, b]]

    fun destBinop(p):
      fun(stage_arg):
        match stage_arg
        | [x, PairList [a, & PairList [b, & PairList []]]]: (if Name.equal(x)(p) | [a, b] | failwith("Atom.destBinop: wrong binop"))
        | _: failwith("Atom.destBinop: not a binop")

    fun isBinop(p): can(destBinop(p))

    fun symbols(atm): Mlist.foldl((fun([tm, z]): (Term.symbols(tm) + z)))(1)(arguments(atm))

    fun compare_impl([p1, tms1]):
      fun([p2, tms2]):
        let c = Name.compare(p1)(p2)
        (if (c != 0) | c | Useful.lexCompare(Term.compare)(tms1)(tms2))

    fun equal(atm1): fun(atm2): (compare_impl(atm1)(atm2) == 0)

    def subterm:
      let subterm_prime:
        fun
        | ([_, PairList []]): (throw Useful.Bug("Atom.subterm: empty path"))
        | ([[_, tms], PairList [h, & t]]): (if (h >= length(tms)) | failwith("Atom.subterm: bad path") | Term.subterm(OCamlList.nth(tms)(h))(t))
      (fun(x): fun(y): subterm_prime([x, y]))

    fun subterms([_, tms]):
      let f = (fun([[n, tm], l]): append(PairList.map(Term.subterms(tm), (fun([p, s]): [PairList [n, & p], s])))(l))
      Mlist.foldl(f)(PairList [])(Mlist.enumerate(tms))

    fun replace([rel, tms] as atm):
      fun(stage_arg):
        match stage_arg
        | [PairList [], _]: (throw Useful.Bug("Atom.replace: empty path"))
        | [PairList [h, & t], res]:
            if (h >= length(tms))
            | failwith("Atom.replace: bad path")
            | let tm = OCamlList.nth(tms)(h)
              let tm_prime = Term.replace(tm)([t, res])
              (if (tm === tm_prime) | atm | [rel, Mlist.updateNth([h, tm_prime])(tms)])

    fun find_impl(pred):
      fun([_, tms]):
        let f:
          fun([i, tm]):
            match Term.find(pred)(tm)
            | Some(path): Some(PairList [i, & path])
            | None(): None()
        Mlist.first(f)(Mlist.enumerate(tms))

    fun freeIn(v): fun(atm): OCamlList.exists(Term.freeIn(v))(arguments(atm))

    def freeVars:
      let f = (fun([tm, acc]): Name.Set.union(Term.freeVars(tm))(acc))
      (fun(atm): Mlist.foldl(f)(Name.Set.empty)(arguments(atm)))

    fun subst(sub):
      fun([p, tms] as atm):
        let tms_prime = OCamlList.map(Substitute.subst(sub))(tms)
        (if (tms_prime === tms) | atm | [p, tms_prime])

    fun matchAtoms(sub):
      fun([p1, tms1]):
        fun([p2, tms2]):
          let matchArg = (fun([[tm1, tm2], sub]): Substitute.matchTerms(sub)(tm1)(tm2))
          let _ = ((Name.equal(p1)(p2) && (length(tms1) == length(tms2))) || failwith("Atom.match"))
          Mlist.foldl(matchArg)(sub)(zip(tms1)(tms2))

    fun unify(sub):
      fun([p1, tms1]):
        fun([p2, tms2]):
          let unifyArg = (fun([[tm1, tm2], sub]): Substitute.unify(sub)(tm1)(tm2))
          let _ = ((Name.equal(p1)(p2) && (length(tms1) == length(tms2))) || failwith("Atom.unify"))
          Mlist.foldl(unifyArg)(sub)(zip(tms1)(tms2))

    def eqRelationName = Name.fromString("=")

    def eqRelationArity = 2

    def eqRelation = [eqRelationName, eqRelationArity]

    def mkEq = mkBinop(eqRelationName)

    fun destEq(x): destBinop(eqRelationName)(x)

    fun isEq(x): isBinop(eqRelationName)(x)

    fun mkRefl(tm): mkEq([tm, tm])

    fun destRefl(atm):
      let [l, r] = destEq(atm)
      let _ = (Term.equal(l)(r) || failwith("Atom.destRefl"))
      l

    fun isRefl(x): can(destRefl)(x)

    fun sym(atm):
      let [l, r] = destEq(atm)
      let _ = (!Term.equal(l)(r) || failwith("Atom.sym: refl"))
      mkEq([r, l])

    fun lhs(atm): fst(destEq(atm))

    fun rhs(atm): snd(destEq(atm))

    fun typedSymbols([_, tms]): Mlist.foldl((fun([tm, z]): (Term.typedSymbols(tm) + z)))(1)(tms)

    fun nonVarTypedSubterms([_, tms]):
      let addArg:
        fun([[n, arg], acc]):
          let addTm = (fun([[path, tm], acc]): PairList [[PairList [n, & path], tm], & acc])
          Mlist.foldl(addTm)(acc)(Term.nonVarTypedSubterms(arg))
      Mlist.foldl(addArg)(PairList [])(Mlist.enumerate(tms))

    namespace Ordered:
