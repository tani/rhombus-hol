        fun bal(l):
          fun(v):
            fun(r):
              let hl:
                match l
                | Empty(): 0
                | Node(TNode(_,_,_,h)): h
              let hr:
                match r
                | Empty(): 0
                | Node(TNode(_,_,_,h)): h
              if (hl > (hr + 2))
              | match l
                | Empty(): (throw InvalidArgument("Set.bal"))
