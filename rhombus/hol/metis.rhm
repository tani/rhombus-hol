    fun atomToTerm(atom): Term.Fn(atom)

    fun termToAtom
    | termToAtom(Term.Var(_)): Host.hol_raise(Useful.Bug("Atom_net.termToAtom"))
    | termToAtom(Term.Fn(atom)): atom

    def newNet = Term_net.newNet

    def size = Term_net.size

    curried fun insert_impl(net, [atm, a]): Term_net.insert(net)([atomToTerm(atm), a])

    curried fun fromList(parm, l): Mlist.foldl((fun([atm_a, n]): insert_impl(n, atm_a)))(newNet(parm))(l)

    def filter_impl = Term_net.filter

    fun toString(net): Host.hol_concat("Atom_net[")(Host.hol_concat(Host.hol_string_of_int(size(net)))("]"))

    curried fun matchNet(net, atm): Term_net.matchNet(net)(atomToTerm(atm))

