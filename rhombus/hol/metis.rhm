      // OCaml 4.14.1 Set.Make; Copyright 1996 INRIA, Xavier Leroy.
      // LGPL 2.1 with OCaml linking exception; see tools/translate/stdlib.
      namespace Se:
        export:
          TNode
          Empty
          Node
          height
          create
          bal
          add
          singleton
          add_min_element
          add_max_element
          join
          min_elt
          remove_min_elt
          merge
          concat
          split
          empty
          is_empty
          mem
