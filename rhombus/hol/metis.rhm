    curried fun cutN(Size(n), x): (if Host.hol_ge(x)(n) | Host.hol_sub(n)(1) | x)

    fun oneN_v2(sz): cutN(sz, 1)

    curried fun multN_v2(sz, [x, y]): cutN(sz)(Host.hol_mul(x)(y))

    curried fun numeralFn_v2(i, sz): (if Host.hol_lt(i)(0) | Host.None() | Host.Some(cutN(sz, i)))

    curried fun addFn_v2(sz, x, y): Host.Some(cutN(sz)(Host.hol_add(x)(y)))

    curried fun divFn_v2(_, x, y): (if Host.hol_equal(y)(0) | Host.None() | Host.Some(Host.hol_div(x)(y)))

    curried fun expFn_v2(sz, x, y): Host.Some(Useful.exp(multN_v2(sz))(x)(y)(oneN_v2(sz)))

    curried fun modFn_v2(Size(n), x, y): (if (Host.hol_equal(y)(0) || Host.hol_equal(x)(Host.hol_sub(n)(1))) | Host.None() | Host.Some(Host.hol_mod(x)(y)))

    curried fun multFn_v2(sz, x, y): Host.Some(multN_v2(sz, [x, y]))

    curried fun negFn_v2(_, x): (if Host.hol_equal(x)(0) | Host.Some(0) | Host.None())

    curried fun preFn_v2(_, x): (if Host.hol_equal(x)(0) | Host.None() | Host.Some(Host.hol_sub(x)(1)))

    curried fun subFn_v2(Size(n), x, y):
      if Host.hol_equal(y)(0)
      | Host.Some(x)
      | (if (Host.hol_equal(x)(Host.hol_sub(n)(1)) || Host.hol_lt(x)(y)) | Host.None() | Host.Some(Host.hol_sub(x)(y)))

    curried fun sucFn_v2(sz, x): Host.Some(cutN(sz)(Host.hol_add(x)(1)))

    curried fun dividesRel_v2(Size(n), x, y):
      if (Host.hol_equal(x)(1) || Host.hol_equal(y)(0))
      | Host.Some(#true)
      | if Host.hol_equal(x)(0)
        | Host.Some(#false)
        | (if Host.hol_equal(y)(Host.hol_sub(n)(1)) | Host.None() | Host.Some(Useful.divides(x)(y)))

    curried fun evenRel_v2(Size(n), x): (if Host.hol_equal(x)(Host.hol_sub(n)(1)) | Host.None() | Host.Some(Host.hol_equal(Host.hol_mod(x)(2))(0)))

    curried fun geRel_v2(Size(n), y, x):
      if Host.hol_equal(x)(Host.hol_sub(n)(1))
      | (if Host.hol_equal(y)(Host.hol_sub(n)(1)) | Host.None() | Host.Some(#false))
      | (if Host.hol_equal(y)(Host.hol_sub(n)(1)) | Host.Some(#true) | Host.Some(Host.hol_le(x)(y)))

    curried fun gtRel_v2(Size(n), y, x):
      if Host.hol_equal(x)(Host.hol_sub(n)(1))
      | (if Host.hol_equal(y)(Host.hol_sub(n)(1)) | Host.None() | Host.Some(#false))
      | (if Host.hol_equal(y)(Host.hol_sub(n)(1)) | Host.Some(#true) | Host.Some(Host.hol_lt(x)(y)))

    curried fun isZeroRel_v2(_, x): Host.Some(Host.hol_equal(x)(0))

    curried fun leRel_v2(Size(n), x, y):
      if Host.hol_equal(x)(Host.hol_sub(n)(1))
      | (if Host.hol_equal(y)(Host.hol_sub(n)(1)) | Host.None() | Host.Some(#false))
      | (if Host.hol_equal(y)(Host.hol_sub(n)(1)) | Host.Some(#true) | Host.Some(Host.hol_le(x)(y)))

    curried fun ltRel_v2(Size(n), x, y):
      if Host.hol_equal(x)(Host.hol_sub(n)(1))
      | (if Host.hol_equal(y)(Host.hol_sub(n)(1)) | Host.None() | Host.Some(#false))
      | (if Host.hol_equal(y)(Host.hol_sub(n)(1)) | Host.Some(#true) | Host.Some(Host.hol_lt(x)(y)))

    curried fun oddRel_v2(Size(n), x): (if Host.hol_equal(x)(Host.hol_sub(n)(1)) | Host.None() | Host.Some(Host.hol_equal(Host.hol_mod(x)(2))(1)))

