    variant term:
      Var(variable)
      Fn(application)

    fun destVar
    | destVar(Var(v)): v
    | destVar(Fn(_)): failwith("destVar")

    def isVar = can(destVar)

    fun equalVar(v):
      fun(stage_arg):
        match stage_arg
        | Var(v_prime): Name.equal(v)(v_prime)
        | _: #false

    fun destFn
    | destFn(Fn(f)): f
    | destFn(Var(_)): failwith("destFn")

    def isFn = can(destFn)

    fun fnName(tm): fst(destFn(tm))

    fun fnArguments(tm): snd(destFn(tm))

    fun fnArity(tm): PairList.length(fnArguments(tm))

    fun fnFunction(tm): [fnName(tm), fnArity(tm)]

    fun functions(tm):
      // Recursive function collection needs the local definition before its first use.
      fun letc(fs):
        fun(stage_arg):
          match stage_arg
          | PairList []: fs
          | PairList [Var(_), & tms]: letc(fs)(tms)
          | PairList [Fn([n, l]), & tms]: letc(Name_arity.Set.add(fs)([n, PairList.length(l)]))(append(l)(tms))
      letc(Name_arity.Set.empty)(PairList [tm])

    fun functionNames(tm):
      // Recursive name collection needs the local definition before its first use.
      fun letc_2(fs):
        fun(stage_arg):
          match stage_arg
          | PairList []: fs
          | PairList [Var(_), & tms]: letc_2(fs)(tms)
          | PairList [Fn([n, l]), & tms]: letc_2(Name.Set.add(fs)(n))(append(l)(tms))
      letc_2(Name.Set.empty)(PairList [tm])

    fun mkConst(c): Fn([c, PairList []])

    fun destConst
    | destConst(Fn([c, PairList []])): c
    | destConst(_): failwith("destConst")

    def isConst = can(destConst)

    fun mkBinop(f): fun([a, b]): Fn([f, PairList [a, b]])

    fun destBinop(f):
      fun(stage_arg):
        match stage_arg
        | Fn([x, PairList [a, & PairList [b, & PairList []]]]): (if Name.equal(x)(f) | [a, b] | failwith("Term.destBinop: wrong binop"))
        | _: failwith("Term.destBinop: not a binop")

    fun isBinop(f): can(destBinop(f))

    def vAR_SYMBOLS = 1

    def fN_SYMBOLS = 1

    fun symbols(tm):
      // Recursive symbol counting needs the local definition before its first use.
      fun sz(n):
        fun(stage_arg):
          match stage_arg
          | PairList []: n
          | PairList [Var(_), & tms]: sz((n + vAR_SYMBOLS))(tms)
          | PairList [Fn([letc, args]), & tms]: sz((n + fN_SYMBOLS))(append(args)(tms))
      sz(0)(PairList [tm])

    fun compare_impl(tm1):
      fun(tm2):
        fun cmp
        | cmp([PairList [], PairList []]): 0
        | cmp([PairList [tm1, & tms1], PairList [tm2, & tms2]]):
            if (tm1 === tm2)
            | cmp([tms1, tms2])
            | match [tm1, tm2]
              | [Var(v1), Var(v2)]:
                  let c = Name.compare(v1)(v2)
                  (if (c != 0) | c | cmp([tms1, tms2]))
              | [Var(_), Fn(_)]: -1
              | [Fn(_), Var(_)]: 1
              | [Fn([f1, a1]), Fn([f2, a2])]:
                  let c = Name.compare(f1)(f2)
                  if (c != 0)
                  | c
                  | let c = Useful.intCompare(PairList.length(a1))(PairList.length(a2))
                    (if (c != 0) | c | cmp([append(a1)(tms1), append(a2)(tms2)]))
        | cmp(_): (throw Useful.Bug("Term.compare"))
        cmp([PairList [tm1], PairList [tm2]])

    fun equal(tm1): fun(tm2): (compare_impl(tm1)(tm2) == 0)

    fun subterm_prime_impl
    | subterm_prime_impl([tm, PairList []]): tm
    | subterm_prime_impl([Var(_), PairList [_, & _]]): failwith("Term.subterm: Var")
    | subterm_prime_impl([Fn([_, tms]), PairList [h, & t]]): (if (h >= PairList.length(tms)) | failwith("Term.replace: Fn") | subterm_prime_impl([OCamlList.nth(tms)(h), t]))

    fun subterm(s): fun(t): subterm_prime_impl([s, t])

    fun subterms(tm):
      fun subtms
      | subtms([PairList [], acc]): acc
      | subtms([PairList [[path, tm], & rest], acc]):
          let f_2 = (fun([n, arg]): [PairList [n, & path], arg])
          let acc_2 = PairList [[PairList.reverse(path), tm], & acc]
          match tm
          | Var(_): subtms([rest, acc_2])
          | Fn([_, args]): subtms([append(PairList.map(Mlist.enumerate(args), f_2))(rest), acc_2])
      subtms([PairList [[PairList [], tm]], PairList []])

    fun replace(tm):
      fun(stage_arg):
        match stage_arg
        | [PairList [], res]: (if equal(res)(tm) | tm | res)
        | [PairList [h, & t], res]:
            match tm
            | Var(_): failwith("Term.replace: Var")
            | Fn([letc, tms]):
                if (h >= PairList.length(tms))
                | failwith("Term.replace: Fn")
                | let arg = OCamlList.nth(tms)(h)
                  let arg_prime = replace(arg)([t, res])
                  (if (arg_prime === arg) | tm | Fn([letc, Mlist.updateNth([h, arg_prime])(tms)]))

    fun find_impl(pred):
      fun(tm):
        fun search
        | search(PairList []): None()
        | search(PairList [[path, tm], & rest]):
            if pred(tm)
            | Some(PairList.reverse(path))
            | match tm
              | Var(_): search(rest)
              | Fn([_, a]):
                  let subtms_2 = PairList.map(Mlist.enumerate(a), (fun([i, t]): [PairList [i, & path], t]))
                  search(append(subtms_2)(rest))
        search(PairList [[PairList [], tm]])

    fun freeIn(v):
      fun(tm):
        // Recursive variable search needs the local definition before its first use.
        fun free(v):
          fun(stage_arg):
            match stage_arg
            | PairList []: #false
            | PairList [Var(w), & tms]: (Name.equal(v)(w) || free(v)(tms))
            | PairList [Fn([_, args]), & tms]: free(v)(append(args)(tms))
        free(v)(PairList [tm])

    def freeVarsList:
      // Recursive free-variable search needs the local definition before its first use.
      fun free_2(vs):
        fun(stage_arg):
          match stage_arg
          | PairList []: vs
          | PairList [Var(v), & tms]: free_2(Name.Set.add(vs)(v))(tms)
          | PairList [Fn([_, args]), & tms]: free_2(vs)(append(args)(tms))
      free_2(Name.Set.empty)

    fun freeVars(tm): freeVarsList(PairList [tm])

    fun newVar(_): Var(Name.newName(#void))

    fun newVars(n): PairList.map(Name.newNames(n), (fun(x): Var(x)))

    fun avoid(av): fun(n): Name.Set.member(n)(av)

    fun variantPrime(av): fun(n): Name.variantPrime(avoid(av))(n)

    fun variantNum(av): fun(n): Name.variantNum(avoid(av))(n)

    def hasTypeFunctionName = Name.fromString(":")

    def hasTypeFunction = [hasTypeFunctionName, 2]

    fun destFnHasType([f, a]):
      if !Name.equal(f)(hasTypeFunctionName)
      | failwith("Term.destFnHasType")
      | match a
        | PairList [tm, & PairList [ty, & PairList []]]: [tm, ty]
        | _: failwith("Term.destFnHasType")

    def isFnHasType = can(destFnHasType)

    fun isTypedVar(tm):
      match tm
      | Var(_): #true
      | Fn(letc):
          match Useful.total(destFnHasType)(letc)
          | Some([Var(_), _]): #true
          | _: #false

    fun typedSymbols(tm):
      // Recursive typed-symbol counting needs the local definition before its first use.
      fun sz_2(n):
        fun(stage_arg):
          match stage_arg
          | PairList []: n
          | PairList [tm, & tms]:
              match tm
              | Var(_): sz_2((n + 1))(tms)
              | Fn(letc):
                  match Useful.total(destFnHasType)(letc)
                  | Some([tm, _]): sz_2(n)(PairList [tm, & tms])
                  | None():
                      let [_, a_2] = letc
                      sz_2((n + 1))(append(a_2)(tms))
      sz_2(0)(PairList [tm])

    fun nonVarTypedSubterms(tm):
      fun subtms_3
      | subtms_3([PairList [], acc]): acc
      | subtms_3([PairList [[path, tm], & rest], acc]):
          match tm
          | Var(_): subtms_3([rest, acc])
          | Fn(letc):
              match Useful.total(destFnHasType)(letc)
              | Some([t, _]):
                  match t
                  | Var(_): subtms_3([rest, acc])
                  | Fn(_):
                      let acc_3 = PairList [[PairList.reverse(path), tm], & acc]
                      let rest_2 = PairList [[PairList [0, & path], t], & rest]
                      subtms_3([rest_2, acc_3])
              | None():
                  let f = (fun([n, arg]): [PairList [n, & path], arg])
                  let [_, args] = letc
                  let acc = PairList [[PairList.reverse(path), tm], & acc]
                  let rest = append(PairList.map(Mlist.enumerate(args), f))(rest)
                  subtms_3([rest, acc])
      subtms_3([PairList [[PairList [], tm]], PairList []])

    def appName = Name.fromString(".")

    fun mkFnApp([fTm, aTm]): [appName, PairList [fTm, aTm]]

    fun mkApp(f_a): Fn(mkFnApp(f_a))

    fun destFnApp([f, a]):
      if !Name.equal(f)(appName)
      | failwith("Term.destFnApp")
      | match a
        | PairList [fTm, & PairList [aTm, & PairList []]]: [fTm, aTm]
        | _: failwith("Term.destFnApp")

    def isFnApp = can(destFnApp)

    fun destApp(tm):
      match tm
      | Var(_): failwith("Term.destApp")
      | Fn(letc): destFnApp(letc)

    def isApp = can(destApp)
    fun listMkApp([f, l]): OCamlList.fold_left(fun(acc): fun(x): mkApp([x, acc]))(f)(l)

    fun stripApp(tm):
      // Recursive application stripping needs the local definition before its first use.
      fun strip(tms):
        fun(tm):
          match Useful.total(destApp)(tm)
          | Some([f, a]): strip(PairList [a, & tms])(f)
          | None(): [tm, tms]
      strip(PairList [])(tm)

    fun toString
    | toString(Var(v)): v
    | toString(Fn([n, PairList []])): n
    | toString(Fn([n, l])):
        (n +& ("(" +& (hol_string_concat(", ")(PairList.map(l, toString)) +& ")")))

    namespace Ordered:
      export:
        rename compare_impl_2 as compare

      def compare_impl_2 = compare_impl

    // OCaml 4.14.1 Map.Make; Copyright 1996 INRIA, Xavier Leroy.
    // LGPL 2.1 with OCaml linking exception; see THIRD_PARTY_LICENSES/OCaml.txt.
    namespace Map:
      export:
        TNode
        Empty
        Node
        height
        create
        singleton
        bal
        empty
        is_empty
        add
        rename find_impl_2 as find
        rename mem_impl as mem
        min_binding
        remove_min_binding
        rename merge_v2 as merge
        rename remove_impl as remove
        rename map_impl as map
        fold
        rename exists_impl as exists
        add_min_binding
        add_max_binding
        join
        concat
        concat_or_join
        split
        rename filter_impl as filter
        End
        More
        cardinal
        bindings_aux
        bindings

      record TNode(l, v, d, r, h)

      variant t:
        Empty()
        Node(node)

      fun height
      | height(Empty()): 0
      | height(Node(TNode(_,_,_,_,h))): h

      fun create(l):
        fun(x):
          fun(d):
            fun(r):
              let hl_2 = height(l)
              let hr_2 = height(r)
              Node(
                TNode(l, x, d, r, (if (hl_2 >= hr_2) | (hl_2 + 1) | (hr_2 + 1)))
              )

      fun singleton(x): fun(d): Node(TNode(Empty(), x, d, Empty(), 1))

      fun bal(l):
        fun(x):
          fun(d):
            fun(r):
              let hl:
                match l
                | Empty(): 0
                | Node(TNode(_,_,_,_,h)): h
              let hr:
                match r
                | Empty(): 0
                | Node(TNode(_,_,_,_,h)): h
              if (hl > (hr + 2))
              | match l
                | Empty(): (throw InvalidArgument("Map.bal"))
                | Node(TNode(ll,lv,ld,lr,_)):
                    if (height(ll) >= height(lr))
                    | create(ll)(lv)(ld)(create(lr)(x)(d)(r))
                    | match lr
                      | Empty(): (throw InvalidArgument("Map.bal"))
                      | Node(TNode(lrl,lrv,lrd,lrr,_)): create(create(ll)(lv)(ld)(lrl))(lrv)(lrd)(create(lrr)(x)(d)(r))
              | if (hr > (hl + 2))
                | match r
                  | Empty(): (throw InvalidArgument("Map.bal"))
                  | Node(TNode(rl,rv,rd,rr,_)):
                      if (height(rr) >= height(rl))
                      | create(create(l)(x)(d)(rl))(rv)(rd)(rr)
                      | match rl
                        | Empty(): (throw InvalidArgument("Map.bal"))
                        | Node(TNode(rll,rlv,rld,rlr,_)): create(create(l)(x)(d)(rll))(rlv)(rld)(create(rlr)(rv)(rd)(rr))
                | Node(TNode(l, x, d, r, (if (hl >= hr) | (hl + 1) | (hr + 1))))

      def empty = Empty()

      fun is_empty
      | is_empty(Empty()): #true
      | is_empty(_): #false

      fun add(x):
        fun(data):
          fun
          | (Empty()): Node(TNode(Empty(), x, data, Empty(), 1))
          | (Node(TNode(l,v,d,r,h)) as m):
              let c = Ordered.compare(x)(v)
              if (c == 0)
              | (if (d === data) | m | Node(TNode(l, x, data, r, h)))
              | if (c < 0)
                | let ll = add(x)(data)(l)
                  (if (l === ll) | m | bal(ll)(v)(d)(r))
                | let rr = add(x)(data)(r)
                  (if (r === rr) | m | bal(l)(v)(d)(rr))
      fun find_impl_2(x):
        fun(stage_arg):
          match stage_arg
          | Empty(): (throw Not_found())
          | Node(TNode(l,v,d,r,_)):
              let c = Ordered.compare(x)(v)
              if (c == 0)
              | d
              | find_impl_2(x)((if (c < 0) | l | r))
      fun mem_impl(x):
        fun(stage_arg):
          match stage_arg
          | Empty(): #false
          | Node(TNode(l,v,_,r,_)):
              let c = Ordered.compare(x)(v)
              ((c == 0) || mem_impl(x)((if (c < 0) | l | r)))

      fun min_binding
      | min_binding(Empty()): (throw Not_found())
      | min_binding(Node(TNode(Empty(),v,d,_,_))): [v, d]
      | min_binding(Node(TNode(l,_,_,_,_))): min_binding(l)

      fun remove_min_binding
      | remove_min_binding(Empty()): (throw InvalidArgument("Map.remove_min_elt"))
      | remove_min_binding(Node(TNode(Empty(),_,_,r,_))): r
      | remove_min_binding(Node(TNode(l,v,d,r,_))): bal(remove_min_binding(l))(v)(d)(r)

      fun merge_impl(t1):
        fun(t2):
          match [t1, t2]
          | [Empty(), t]: t
          | [t, Empty()]: t
          | [_, _]:
              let [x, d] = min_binding(t2)
              bal(t1)(x)(d)(remove_min_binding(t2))
      fun remove_impl(x):
        fun(stage_arg):
          match stage_arg
          | Empty(): Empty()
          | Node(TNode(l,v,d,r,_)) as m:
              let c = Ordered.compare(x)(v)
              if (c == 0)
              | merge_impl(l)(r)
              | if (c < 0)
                | let ll = remove_impl(x)(l)
                  (if (l === ll) | m | bal(ll)(v)(d)(r))
                | let rr = remove_impl(x)(r)
                  (if (r === rr) | m | bal(l)(v)(d)(rr))
      fun map_impl(f):
        fun(stage_arg):
          match stage_arg
          | Empty(): Empty()
          | Node(TNode(l,v,d,r,h)):
              let l_prime = map_impl(f)(l)
              let d_prime = f(d)
              let r_prime = map_impl(f)(r)
              Node(TNode(l_prime, v, d_prime, r_prime, h))

      fun fold(f):
        fun(m):
          fun(accu):
            match m
            | Empty(): accu
            | Node(TNode(l,v,d,r,_)): fold(f)(r)(f(v)(d)(fold(f)(l)(accu)))
      fun exists_impl(p):
        fun(stage_arg):
          match stage_arg
          | Empty(): #false
          | Node(TNode(l,v,d,r,_)): (p(v)(d) || (exists_impl(p)(l) || exists_impl(p)(r)))

      fun add_min_binding(k):
        fun(x):
          fun
          | (Empty()): singleton(k)(x)
          | (Node(TNode(l,v,d,r,_))): bal(add_min_binding(k)(x)(l))(v)(d)(r)

      fun add_max_binding(k):
        fun(x):
          fun
          | (Empty()): singleton(k)(x)
          | (Node(TNode(l,v,d,r,_))): bal(l)(v)(d)(add_max_binding(k)(x)(r))

      fun join(l):
        fun(v):
          fun(d):
            fun(r):
              match [l, r]
              | [Empty(), _]: add_min_binding(v)(d)(r)
              | [_, Empty()]: add_max_binding(v)(d)(l)
              | [Node(TNode(ll,lv,ld,lr,lh)), Node(TNode(rl,rv,rd,rr,rh))]:
                  if (lh > (rh + 2))
                  | bal(ll)(lv)(ld)(join(lr)(v)(d)(r))
                  | (if (rh > (lh + 2)) | bal(join(l)(v)(d)(rl))(rv)(rd)(rr) | create(l)(v)(d)(r))

      fun concat(t1):
        fun(t2):
          match [t1, t2]
          | [Empty(), t]: t
          | [t, Empty()]: t
          | [_, _]:
              let [x, d] = min_binding(t2)
              join(t1)(x)(d)(remove_min_binding(t2))

      fun concat_or_join(t1):
        fun(v):
          fun(d):
            fun(t2):
              match d
              | Some(d): join(t1)(v)(d)(t2)
              | None(): concat(t1)(t2)
      fun split(x):
        fun(stage_arg):
          match stage_arg
          | Empty(): [Empty(), None(), Empty()]
          | Node(TNode(l,v,d,r,_)):
              let c = Ordered.compare(x)(v)
              if (c == 0)
              | [l, Some(d), r]
              | if (c < 0)
                | let [ll, pres, rl] = split(x)(l)
                  [ll, pres, join(rl)(v)(d)(r)]
                | let [lr, pres, rr] = split(x)(r)
                  [join(l)(v)(d)(lr), pres, rr]

      fun merge_v2(f):
        fun(s1):
          fun(s2):
            let subject = [s1, s2]
            match subject
            | [Empty(), Empty()]: Empty()
            | [Node(TNode(l1,v1,d1,r1,h1)), _]:
                if (h1 >= height(s2))
                | let [l2, d2, r2] = split(v1)(s2)
                  concat_or_join(merge_v2(f)(l1)(l2))(v1)(f(v1)(Some(d1))(d2))(merge_v2(f)(r1)(r2))
                | match subject
                  | [_, Node(TNode(l2,v2,d2,r2,_))]:
                      let [l1, d1, r1] = split(v2)(s1)
                      concat_or_join(merge_v2(f)(l1)(l2))(v2)(f(v2)(d1)(Some(d2)))(merge_v2(f)(r1)(r2))
                  | _: (if #false | #void | failwith("Assertion failed"))
            | [_, Node(TNode(l2,v2,d2,r2,_))]:
                let [l1, d1, r1] = split(v2)(s1)
                concat_or_join(merge_v2(f)(l1)(l2))(v2)(f(v2)(d1)(Some(d2)))(merge_v2(f)(r1)(r2))
            | _: (if #false | #void | failwith("Assertion failed"))
      fun filter_impl(p):
        fun(stage_arg):
          match stage_arg
          | Empty(): Empty()
          | Node(TNode(l,v,d,r,_)) as m:
              let l_prime = filter_impl(p)(l)
              let pvd = p(v)(d)
              let r_prime = filter_impl(p)(r)
              if pvd
              | (if ((l === l_prime) && (r === r_prime)) | m | join(l_prime)(v)(d)(r_prime))
              | concat(l_prime)(r_prime)

      variant enumeration:
        End()
        More(key, value, right, enumeration)

      fun cardinal
      | cardinal(Empty()): 0
      | cardinal(Node(TNode(l,_,_,r,_))): ((cardinal(l) + 1) + cardinal(r))
      fun bindings_aux(accu):
        fun(stage_arg):
          match stage_arg
          | Empty(): accu
          | Node(TNode(l,v,d,r,_)): bindings_aux(PairList [[v, d], & bindings_aux(accu)(r)])(l)

      fun bindings(s): bindings_aux(PairList [])(s)

