    curried fun foldl_impl(f, a, l): Host.OCamlList.fold_left((fun(acc): (fun(x): f([x, acc]))))(a)(l)

    curried fun foldr_impl(f, a, l): Host.OCamlList.fold_right((fun(x): (fun(acc): f([x, acc]))))(l)(a)

    fun null
