    def xVarName = Name.fromString("x")

    def xVar = Term.Var(xVarName)

    def yVarName = Name.fromString("y")

    def yVar = Term.Var(yVarName)

    def zVarName = Name.fromString("z")

    def zVar = Term.Var(zVarName)

    fun xIVarName(i): Name.fromString(("x" +& to_string(i)))

    fun xIVar(i): Term.Var(xIVarName(i))

    fun yIVarName(i): Name.fromString(("y" +& to_string(i)))

    fun yIVar(i): Term.Var(yIVarName(i))

    fun reflexivityRule(x): Thm.refl(x)

    def reflexivity = reflexivityRule(xVar)

    fun symmetryRule(x):
      fun(y):
        let reflTh = reflexivityRule(x)
        let reflLit = Thm.destUnit(reflTh)
        let eqTh = Thm.equality(reflLit)(PairList [0])(y)
        Thm.resolve(reflLit)(reflTh)(eqTh)

    def symmetry = symmetryRule(xVar)(yVar)

    def transitivity:
      let eqTh = Thm.equality(Literal.mkEq([yVar, zVar]))(PairList [0])(xVar)
      Thm.resolve(Literal.mkEq([yVar, xVar]))(symmetry)(eqTh)

    fun symEq(lit):
      fun(th):
        let [x, y] = Literal.destEq(lit)
        if Term.equal(x)(y)
        | th
        | let sub = Substitute.fromList(PairList [[xVarName, x], [yVarName, y]])
          let symTh = Thm.subst(sub)(symmetry)
          Thm.resolve(lit)(th)(symTh)

    fun equationLiteral([t_u, th]):
      let lit = Literal.mkEq(t_u)
      (if Literal.Set.member(lit)(Thm.clause(th)) | Some(lit) | None())

    fun reflEqn(t): [[t, t], Thm.refl(t)]

    fun symEqn([[t, u], th] as eqn):
      if Term.equal(t)(u)
      | eqn
      | [
          [u, t],
          match equationLiteral(eqn)
          | Some(t_u): symEq(t_u)(th)
          | None(): th
        ]

    fun transEqn([[x, y], th1] as eqn1):
      fun([[_, z], th2] as eqn2):
        if Term.equal(x)(y)
        | eqn2
        | if Term.equal(y)(z)
          | eqn1
          | if Term.equal(x)(z)
            | reflEqn(x)
            | [
                [x, z],
                match equationLiteral(eqn1)
                | None(): th1
                | Some(x_y):
                    match equationLiteral(eqn2)
                    | None(): th2
                    | Some(y_z):
                        let sub = Substitute.fromList(PairList [[xVarName, x], [yVarName, y], [zVarName, z]])
                        let th = Thm.subst(sub)(transitivity)
                        let th = Thm.resolve(x_y)(th1)(th)
                        let th = Thm.resolve(y_z)(th2)(th)
                        th
              ]

    fun allConv(tm): [tm, Thm.refl(tm)]

    fun noConv(_): failwith("noConv")

    fun thenConvTrans(tm):
      fun([tm_prime, th1]):
        fun([tm_prime_prime, th2]):
          let eqn1_2 = [[tm, tm_prime], th1]
          let eqn2_2 = [[tm_prime, tm_prime_prime], th2]
          let [_, th] = transEqn(eqn1_2)(eqn2_2)
          [tm_prime_prime, th]

    fun thenConv(conv1):
      fun(conv2):
        fun(tm):
          let [tm_prime, _] as res1 = conv1(tm)
          let res2 = conv2(tm_prime)
          thenConvTrans(tm)(res1)(res2)

    fun orelseConv(conv1):
      fun(conv2):
        fun(tm):
          try:
            conv1(tm)
            ~catch exn:
              match exn
              | Failure(_): conv2(tm)
              | exn: (throw exn)

    fun tryConv(conv): orelseConv(conv)(allConv)

    fun changedConv(conv):
      fun(tm):
        let [tm_prime, _] as res = conv(tm)
        (if (tm == tm_prime) | failwith("changedConv") | res)

    fun repeatConv(conv): fun(tm): tryConv(thenConv(conv)(repeatConv(conv)))(tm)

    fun flip(f): fun(x): fun(y): f(y)(x)

    fun firstConv_impl(tm):
      fun(stage_arg):
        match stage_arg
        | PairList []: failwith("firstConv")
        | PairList [conv, & PairList []]: conv(tm)
        | PairList [conv, & convs]: orelseConv(conv)(flip(firstConv_impl)(convs))(tm)

    fun firstConv_v2(convs): fun(tm): firstConv_impl(tm)(convs)

    fun everyConv_impl(tm):
      fun(stage_arg):
        match stage_arg
        | PairList []: allConv(tm)
        | PairList [conv, & PairList []]: conv(tm)
        | PairList [conv, & convs]: thenConv(conv)(flip(everyConv_impl)(convs))(tm)

    fun everyConv_v2(convs): fun(tm): everyConv_impl(tm)(convs)

    fun rewrConv([[x, y], eqTh] as eqn):
      fun(path):
        fun(tm):
          if Term.equal(x)(y)
          | allConv(tm)
          | if Mlist.null(path)
            | [y, eqTh]
            | let reflTh = Thm.refl(tm)
              let reflLit = Thm.destUnit(reflTh)
              let th = Thm.equality(reflLit)(PairList [1, & path])(y)
              let th = Thm.resolve(reflLit)(reflTh)(th)
              let th:
                match equationLiteral(eqn)
                | None(): th
                | Some(x_y): Thm.resolve(x_y)(eqTh)(th)
              let tm_prime = Term.replace(tm)([path, y])
              [tm_prime, th]

    fun pathConv(conv):
      fun(path):
        fun(tm):
          let x = Term.subterm(tm)(path)
          let [y, th] = conv(x)
          rewrConv([[x, y], th])(path)(tm)

    fun subtermConv(conv): fun(i): pathConv(conv)(PairList [i])

    fun subtermsConv(conv):
      fun(stage_arg):
        match stage_arg
        | Term.Var(_) as tm: allConv(tm)
        | Term.Fn([_, a]) as tm: everyConv_v2(OCamlList.map(subtermConv(conv))(Useful.interval(0)(length(a))))(tm)

    fun bottomUpConv(conv): fun(tm): thenConv(subtermsConv(bottomUpConv(conv)))(repeatConv(conv))(tm)

    fun topDownConv(conv): fun(tm): thenConv(repeatConv(conv))(subtermsConv(topDownConv(conv)))(tm)

    fun repeatTopDownConv(conv):
      fun(tm):
        fun f_2(tm): thenConv(repeatConv(conv))(g_2)(tm)
        fun g_2(tm): thenConv(subtermsConv(f_2))(h_2)(tm)
        fun h_2(tm): tryConv(thenConv(conv)(f_2))(tm)
        f_2(tm)

    fun allLiterule(lit): [lit, Thm.assume(lit)]

    fun noLiterule(_): failwith("noLiterule")

    fun thenLiterule(literule1):
      fun(literule2):
        fun(lit):
          let [lit_prime, th1] as res1 = literule1(lit)
          let [lit_prime_prime, th2] as res2 = literule2(lit_prime)
          if Literal.equal(lit)(lit_prime)
          | res2
          | if Literal.equal(lit_prime)(lit_prime_prime)
            | res1
            | if Literal.equal(lit)(lit_prime_prime)
              | allLiterule(lit)
              | [
                  lit_prime_prime,
                  if !Thm.member(lit_prime)(th1)
                  | th1
                  | (if !Thm.negateMember(lit_prime)(th2) | th2 | Thm.resolve(lit_prime)(th1)(th2))
                ]

    fun orelseLiterule(literule1):
      fun(literule2):
        fun(lit):
          try:
            literule1(lit)
            ~catch exn:
              match exn
              | Failure(_): literule2(lit)
              | exn: (throw exn)

    fun tryLiterule(literule): orelseLiterule(literule)(allLiterule)

    fun changedLiterule(literule):
      fun(lit):
        let [lit_prime, _] as res = literule(lit)
        (if (lit == lit_prime) | failwith("changedLiterule") | res)

    fun repeatLiterule(literule): fun(lit): tryLiterule(thenLiterule(literule)(repeatLiterule(literule)))(lit)

    fun firstLiterule_impl(lit):
      fun(stage_arg):
        match stage_arg
        | PairList []: failwith("firstLiterule")
        | PairList [literule, & PairList []]: literule(lit)
        | PairList [literule, & literules]: orelseLiterule(literule)(flip(firstLiterule_impl)(literules))(lit)

    fun firstLiterule_v2(literules): fun(lit): firstLiterule_impl(lit)(literules)

    fun everyLiterule_impl(lit):
      fun(stage_arg):
        match stage_arg
        | PairList []: allLiterule(lit)
        | PairList [literule, & PairList []]: literule(lit)
        | PairList [literule, & literules]: thenLiterule(literule)(flip(everyLiterule_impl)(literules))(lit)

    fun everyLiterule_v2(literules): fun(lit): everyLiterule_impl(lit)(literules)

    fun rewrLiterule([[x, y], eqTh] as eqn):
      fun(path):
        fun(lit):
          if Term.equal(x)(y)
          | allLiterule(lit)
          | let th = Thm.equality(lit)(path)(y)
            let th:
              match equationLiteral(eqn)
              | None(): th
              | Some(x_y): Thm.resolve(x_y)(eqTh)(th)
            let lit_prime = Literal.replace(lit)([path, y])
            [lit_prime, th]

    fun pathLiterule(conv):
      fun(path):
        fun(lit):
          let tm = Literal.subterm(lit)(path)
          let [tm_prime, th] = conv(tm)
          rewrLiterule([[tm, tm_prime], th])(path)(lit)

    fun argumentLiterule(conv): fun(i): pathLiterule(conv)(PairList [i])

    fun allArgumentsLiterule(conv): fun(lit): everyLiterule_v2(OCamlList.map(argumentLiterule(conv))(Useful.interval(0)(Literal.arity(lit))))(lit)

    fun allRule(th): th

    fun noRule(_): failwith("noRule")

    fun thenRule(rule1): fun(rule2): fun(th): rule1(rule2(th))

    fun orelseRule(rule1):
      fun(rule2):
        fun(th):
          try:
            rule1(th)
            ~catch exn:
              match exn
              | Failure(_): rule2(th)
              | exn: (throw exn)

    fun tryRule(rule): orelseRule(rule)(allRule)

    fun changedRule(rule):
      fun(th):
        let th_prime = rule(th)
        (if !Literal.Set.equal(Thm.clause(th))(Thm.clause(th_prime)) | th_prime | failwith("changedRule"))

    fun repeatRule(rule): fun(lit): tryRule(thenRule(rule)(repeatRule(rule)))(lit)

    fun firstRule_impl(th):
      fun(stage_arg):
        match stage_arg
        | PairList []: failwith("firstRule")
        | PairList [rule, & PairList []]: rule(th)
        | PairList [rule, & rules]: orelseRule(rule)(flip(firstRule_impl)(rules))(th)

    fun firstRule_v2(rules): fun(th): firstRule_impl(th)(rules)

    fun everyRule_impl(th):
      fun(stage_arg):
        match stage_arg
        | PairList []: allRule(th)
        | PairList [rule, & PairList []]: rule(th)
        | PairList [rule, & rules]: thenRule(rule)(flip(everyRule_impl)(rules))(th)

    fun everyRule_v2(rules): fun(th): everyRule_impl(th)(rules)

    fun literalRule(literule):
      fun(lit):
        fun(th):
          let [lit_prime, litTh] = literule(lit)
          if Literal.equal(lit)(lit_prime)
          | th
          | (if !Thm.negateMember(lit)(litTh) | litTh | Thm.resolve(lit)(th)(litTh))

    fun rewrRule(eqTh): fun(lit): fun(path): literalRule(rewrLiterule(eqTh)(path))(lit)

    fun pathRule(conv): fun(lit): fun(path): literalRule(pathLiterule(conv)(path))(lit)

    fun literalsRule(literule):
      fun(lits):
        fun(th):
          let f = (fun([lit, th]): (if Thm.member(lit)(th) | literalRule(literule)(lit)(th) | th))
          Literal.Set.foldl(f)(th)(lits)

    fun allLiteralsRule(literule): fun(th): literalsRule(literule)(Thm.clause(th))(th)

    fun convRule(conv): allLiteralsRule(allArgumentsLiterule(conv))

    fun functionCongruence([f, n]):
      let xs_2 = Mlist.tabulate([n, xIVar])
      let ys_2 = Mlist.tabulate([n, yIVar])
      let cong:
        fun([[i, yi], [th, lit]]):
          let path = PairList [1, i]
          let th = Thm.resolve(lit)(th)(Thm.equality(lit)(path)(yi))
          let lit = Literal.replace(lit)([path, yi])
          [th, lit]
      let reflTh = Thm.refl(Term.Fn([f, xs_2]))
      let reflLit = Thm.destUnit(reflTh)
      fst(Mlist.foldl(cong)([reflTh, reflLit])(Mlist.enumerate(ys_2)))

    fun relationCongruence([r, n]):
      let xs_3 = Mlist.tabulate([n, xIVar])
      let ys_3 = Mlist.tabulate([n, yIVar])
      let cong:
        fun([[i, yi], [th, lit]]):
          let path = PairList [i]
          let th = Thm.resolve(lit)(th)(Thm.equality(lit)(path)(yi))
          let lit = Literal.replace(lit)([path, yi])
          [th, lit]
      let assumeLit = [#false, [r, xs_3]]
      let assumeTh = Thm.assume(assumeLit)
      fst(Mlist.foldl(cong)([assumeTh, assumeLit])(Mlist.enumerate(ys_3)))

    fun symNeq(lit):
      fun(th):
        let [x, y] = Literal.destNeq(lit)
        if Term.equal(x)(y)
        | th
        | let sub = Substitute.fromList(PairList [[xVarName, y], [yVarName, x]])
          let symTh = Thm.subst(sub)(symmetry)
          Thm.resolve(lit)(th)(symTh)

    fun sym([pol, _] as lit): fun(th): (if pol | symEq(lit)(th) | symNeq(lit)(th))

    fun removeIrrefl(th):
      let irrefl:
        fun
        | ([[#true, _], th]): th
        | ([[#false, atm] as lit, th]):
            match Useful.total(Atom.destRefl)(atm)
            | Some(x): Thm.resolve(lit)(th)(Thm.refl(x))
            | None(): th
      Literal.Set.foldl(irrefl)(th)(Thm.clause(th))

    fun removeSym(th):
      let rem:
        fun([[pol, atm] as lit, [eqs, th]]):
          match Useful.total(Atom.sym)(atm)
          | None(): [eqs, th]
          | Some(atm_prime):
              if Literal.Set.member(lit)(eqs)
              | [eqs, (if pol | symEq(lit)(th) | symNeq(lit)(th))]
              | [Literal.Set.add(eqs)([pol, atm_prime]), th]
      snd(Literal.Set.foldl(rem)([Literal.Set.empty, th])(Thm.clause(th)))

    fun expandAbbrevs(th):
      let expand:
        fun(lit):
          let [x, y] = Literal.destNeq(lit)
          let _ = (Term.isTypedVar(x) || (Term.isTypedVar(y) || failwith("Rule.expandAbbrevs: no vars")))
          let _ = (!Term.equal(x)(y) || failwith("Rule.expandAbbrevs: equal vars"))
          Substitute.unify(Substitute.empty)(x)(y)
      match Literal.Set.firstl(Useful.total(expand))(Thm.clause(th))
      | None(): removeIrrefl(th)
      | Some(sub): expandAbbrevs(Thm.subst(sub)(th))

    fun simplify(th):
      if Thm.isTautology(th)
      | None()
      | let th_prime = th
        let th_prime = expandAbbrevs(th_prime)
        let th_prime = removeSym(th_prime)
        (if Thm.equal(th)(th_prime) | Some(th) | simplify(th_prime))

    fun freshVars(th): Thm.subst(Substitute.freshVars(Thm.freeVars(th)))(th)

    variant edge:
      Factor_edge(left, right)
      Refl_edge(left, right)

    variant joinStatus:
      Joined()
      Joinable(substitution)
      Apart()

    fun joinEdge(sub):
      fun(edge):
        let result:
          match edge
          | Factor_edge(atm,atm_prime): Useful.total(Atom.unify(sub)(atm))(atm_prime)
          | Refl_edge(tm,tm_prime): Useful.total(Substitute.unify(sub)(tm))(tm_prime)
        match result
        | None(): Apart()
        | Some(sub_prime): (if (sub === sub_prime) | Joined() | Joinable(sub_prime))

    fun updateApart(sub):
      fun(edges):
        // Recursive edge updates need the local definition before its first use.
        fun update(acc):
          fun(stage_arg):
            match stage_arg
            | PairList []: Some(acc)
            | PairList [edge, & edges]:
                match joinEdge(sub)(edge)
                | Joined(): None()
                | Joinable(_): update(PairList [edge, & acc])(edges)
                | Apart(): update(acc)(edges)
        update(PairList [])(edges)

    fun addFactorEdge([pol, atm]):
      fun([[pol_prime, atm_prime], acc]):
        if (pol != pol_prime)
        | acc
        | let edge = Factor_edge(atm, atm_prime)
          match joinEdge(Substitute.empty)(edge)
          | Joined(): (throw Useful.Bug("addFactorEdge: joined"))
          | Joinable(sub): PairList [[sub, edge], & acc]
          | Apart(): acc

    fun addReflEdge_impl
    | addReflEdge_impl([[#false, _], acc]): acc
    | addReflEdge_impl([[#true, atm], acc]):
        let [x, y] = Atom.destEq(atm)
        let edge = Refl_edge(x, y)
        match joinEdge(Substitute.empty)(edge)
        | Joined(): (throw Useful.Bug("addRefl: joined"))
        | Joinable(_): PairList [edge, & acc]
        | Apart(): acc

    def addReflEdge_v2 = curry(addReflEdge_impl)

    fun addIrreflEdge_impl
    | addIrreflEdge_impl([[#true, _], acc]): acc
    | addIrreflEdge_impl([[#false, atm], acc]):
        let [x, y] = Atom.destEq(atm)
        let edge = Refl_edge(x, y)
        match joinEdge(Substitute.empty)(edge)
        | Joined(): (throw Useful.Bug("addRefl: joined"))
        | Joinable(sub): PairList [[sub, edge], & acc]
        | Apart(): acc

    def addIrreflEdge_v2 = curry(addIrreflEdge_impl)

    fun init_edges(acc):
      fun(apart):
        fun
        | (PairList []):
            let init = (fun([[apart, sub, edge], [edges, acc]]): [PairList [edge, & edges], PairList [[apart, sub, edges], & acc]])
            snd(Mlist.foldl(init)([PairList [], PairList []])(acc))
        | (PairList [[sub, edge], & sub_edges]):
            let [acc, apart]:
              match updateApart(sub)(apart)
              | Some(apart_prime): [PairList [[apart_prime, sub, edge], & acc], PairList [edge, & apart]]
              | None(): [acc, apart]
            init_edges(acc)(apart)(sub_edges)

    fun mk_edges(apart):
      fun(sub_edges):
        fun
        | (PairList []): init_edges(PairList [])(apart)(sub_edges)
        | (PairList [lit, & lits]):
            let sub_edges = Mlist.foldl(addFactorEdge(lit))(sub_edges)(lits)
            let [apart, sub_edges]:
              match Useful.total(Literal.sym)(lit)
              | None(): [apart, sub_edges]
              | Some(lit_prime):
                  let apart = addReflEdge_v2(lit)(apart)
                  let sub_edges = addIrreflEdge_v2(lit)(sub_edges)
                  let sub_edges = Mlist.foldl(addFactorEdge(lit_prime))(sub_edges)(lits)
                  [apart, sub_edges]
            mk_edges(apart)(sub_edges)(lits)

    fun fact(acc):
      fun(stage_arg):
        match stage_arg
        | PairList []: acc
        | PairList [[_, sub, PairList []], & others]: fact(PairList [sub, & acc])(others)
        | PairList [[apart, sub, PairList [edge, & edges]], & others]:
            let others:
              match joinEdge(sub)(edge)
              | Joinable(sub_prime):
                  let others = PairList [[PairList [edge, & apart], sub, edges], & others]
                  match updateApart(sub_prime)(apart)
                  | None(): others
                  | Some(apart_prime): PairList [[apart_prime, sub_prime, edges], & others]
              | _: PairList [[apart, sub, edges], & others]
            fact(acc)(others)

    fun factor_prime_impl(cl):
      let edges = mk_edges(PairList [])(PairList [])(Literal.Set.toList(cl))
      let result = fact(PairList [])(edges)
      result

    fun factor(th):
      let fact = (fun(sub): removeIrrefl(removeSym(Thm.subst(sub)(th))))
      PairList.map(factor_prime_impl(Thm.clause(th)), fact)

