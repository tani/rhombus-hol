fun METIS_TAC(ths):
  let port_tmp_1 = ASM_METIS_TAC(ths)
  let port_tmp_2 = Tactics.POP_ASSUM_LIST(K(Tactics.ALL_TAC))
  Tactics.THEN(port_tmp_2)(port_tmp_1)

fun METIS(ths): (fun(tm): Tactics.prove([tm, METIS_TAC(ths)]))
