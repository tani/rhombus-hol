  namespace Heap:
    export:
      Empty
      Em
      Tr
      Heap
      rank
      makeT
      rename merge_impl as merge
      newHeap
      add
      size
      null
      top
      rename remove_impl as remove
      app
      toList
      toString

    class Empty()

    variant node:
      Em()
      Tr(rank, value, left, right)

    variant heap:
      Heap(compare, size, root)

    fun rank
    | rank(Em()): 0
    | rank(Tr(r,_,_,_)): r

    fun makeT([x, a, b]): (if (rank(a) >= rank(b)) | Tr((rank(b) + 1), x, a, b) | Tr((rank(a) + 1), x, b, a))

    fun merge_impl(cmp):
      fun(h):
        fun mrg
        | mrg([h, Em()]): h
        | mrg([Em(), h]): h
        | mrg([Tr(_,x,a1,b1) as h1, Tr(_,y,a2,b2) as h2]): (if (cmp(x)(y) > 0) | makeT([y, a2, mrg([h1, b2])]) | makeT([x, a1, mrg([b1, h2])]))
        mrg(h)

    fun newHeap(cmp): Heap(cmp, 0, Em())

    fun add(Heap(f,n,a)): fun(x): Heap(f, (n + 1), merge_impl(f)([Tr(1, x, Em(), Em()), a]))

    fun size(Heap(_,n,_)): n

    fun null(h): (size(h) == 0)

    fun top
    | top(Heap(_,_,Em())): (throw Empty())
    | top(Heap(_,_,Tr(_,x,_,_))): x

    fun remove_impl
    | remove_impl(Heap(_,_,Em())): (throw Empty())
    | remove_impl(Heap(f,n,Tr(_,x,a,b))): [x, Heap(f, (n - 1), merge_impl(f)([a, b]))]

    fun app(f):
      fun(Heap(_,_,a)):
        fun ap
        | ap(PairList []): #void
        | ap(PairList [Em(), & rest]): ap(rest)
        | ap(PairList [Tr(_,d,a,b), & rest]):
            f(d)
            ap(PairList [a, b, & rest])
        ap(PairList [a])

    fun toList(h):
      if null(h)
      | PairList []
      | let [x, h] = remove_impl(h)
        PairList [x, & toList(h)]

    fun toString(h): ("Heap[" +& ((if null(h) | "" | to_string(size(h))) +& "]"))

  namespace Name:
    export:
      rename compare_impl as compare
      equal
      prefix
      numName
      newName
      newNames
      variantPrime
      variantNum
      toString
      fromString
      Ordered
