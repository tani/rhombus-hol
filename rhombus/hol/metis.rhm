        | treeAppend(left, right)
        | let size_4 = Host.hol_sub(size)(1)
          let right_3 = treeDelete(compareKey, dkey, right)
          let node = Node(size_4, priority, left, key, value, right_3)
          Tree(node)

    curried fun treeMapPartial(f, tree):
