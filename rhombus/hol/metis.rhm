    variant subst:
      Subst(map)

    def empty = Subst(Host.hol_apply_unit(Name.Map.newMap))

    fun null(Subst(m)): Name.Map.null(m)

    fun size(Subst(m)): Name.Map.size(m)

    curried fun peek(Subst(m), v): Name.Map.peek(m)(v)

    curried fun insert_impl(Subst(m), v_tm): Subst(Name.Map.insert(m)(v_tm))

    fun singleton(v_tm): insert_impl(empty, v_tm)

    fun toList(Subst(m)): Name.Map.toList(m)

    fun fromList(l): Subst(Name.Map.fromList(l))

    curried fun foldl_impl(f, b, Subst(m)): Name.Map.foldl(f)(b)(m)

    curried fun foldr_impl(f, b, Subst(m)): Name.Map.foldr(f)(b)(m)

    fun normalize(Subst(m) as sub):
      let isNotId = (fun([v, tm]): Host.hol_not(Term.equalVar(v)(tm)))
      let m_prime = Name.Map.filter(isNotId)(m)
      (if Host.hol_equal(Name.Map.size(m))(Name.Map.size(m_prime)) | sub | Subst(m_prime))

    fun subst(sub):
      fun tmSub
      | tmSub(Term.Var(v) as tm):
          match peek(sub, v)
          | Host.Some(tm_prime): (if Host.hol_physical_equal(tm)(tm_prime) | tm | tm_prime)
          | Host.None(): tm
      | tmSub(Term.Fn([f, args]) as tm):
          let args_prime = Host.OCamlList.map(tmSub)(args)
          (if Host.hol_physical_equal(args)(args_prime) | tm | Term.Fn([f, args_prime]))
      (fun(tm): (if null(sub) | tm | tmSub(tm)))

    curried fun restrict(Subst(m) as sub, varSet):
      let isRestrictedVar = (fun([v, _]): Name.Set.member(v)(varSet))
      let m_prime = Name.Map.filter(isRestrictedVar)(m)
      (if Host.hol_equal(Name.Map.size(m))(Name.Map.size(m_prime)) | sub | Subst(m_prime))

    curried fun remove_impl(Subst(m) as sub, varSet):
      let isRestrictedVar = (fun([v, _]): Host.hol_not(Name.Set.member(v)(varSet)))
      let m_prime = Name.Map.filter(isRestrictedVar)(m)
      (if Host.hol_equal(Name.Map.size(m))(Name.Map.size(m_prime)) | sub | Subst(m_prime))

    curried fun compose(Subst(m1) as sub1, sub2):
      let f = (fun([v, tm, s]): insert_impl(s)([v, subst(sub2)(tm)]))
      (if null(sub2) | sub1 | Name.Map.foldl(f)(sub2)(m1))

    curried fun union_impl(Subst(m1) as s1, Subst(m2) as s2):
      let compatible = (fun([[_, tm1], [_, tm2]]): (if Term.equal(tm1)(tm2) | Host.Some(tm1) | failwith("Substitute.union: incompatible")))
      if Name.Map.null(m1)
      | s2
      | (if Name.Map.null(m2) | s1 | Subst(Name.Map.union(compatible)(m1)(m2)))

    fun invert(Subst(m)):
      let inv:
        fun
        | ([v, Term.Var(w), s]): (if Name.Map.inDomain(w)(s) | failwith("Substitute.invert: non-injective") | Name.Map.insert(s)([w, Term.Var(v)]))
        | ([_, Term.Fn(_), _]): failwith("Substitute.invert: non-variable")
      Subst(Name.Map.foldl(inv)(Host.hol_apply_unit(Name.Map.newMap))(m))

    def isRenaming = can(invert)

    fun freshVars(s):
      let add = (fun([v, m]): insert_impl(m)([v, Host.hol_apply_unit(Term.newVar)]))
      Name.Set.foldl(add)(empty)(s)

    def redexes:
      let add = (fun([v, _, s]): Name.Set.add(s)(v))
      foldl_impl(add, Name.Set.empty)

    def residueFreeVars:
      let add = (fun([_, t, s]): Name.Set.union(s)(Term.freeVars(t)))
      foldl_impl(add, Name.Set.empty)

    def freeVars:
      let add = (fun([v, t, s]): Name.Set.union(Name.Set.add(s)(v))(Term.freeVars(t)))
      foldl_impl(add, Name.Set.empty)

    def functions:
      let add = (fun([_, t, s]): Name_arity.Set.union(s)(Term.functions(t)))
      foldl_impl(add, Name_arity.Set.empty)

    curried fun matchTerms(sub, tm1, tm2):
      fun matchList(sub):
        fun
        | (PairList []): sub
        | (PairList [[Term.Var(v), tm], & rest]):
            let sub:
              match peek(sub, v)
              | Host.None(): insert_impl(sub, [v, tm])
              | Host.Some(tm_prime): (if Term.equal(tm)(tm_prime) | sub | failwith("Substitute.match: incompatible matches"))
            matchList(sub)(rest)
        | (PairList [[Term.Fn([f1, args1]), Term.Fn([f2, args2])], & rest]): (if (Name.equal(f1)(f2) && Host.hol_equal(length(args1))(length(args2))) | matchList(sub)(append(zip(args1)(args2))(rest)) | failwith("Substitute.match: different structure"))
        | (_): failwith("Substitute.match: functions can't match vars")
      matchList(sub)(PairList [[tm1, tm2]])

    curried fun unify(sub, tm1, tm2):
      fun solve_2(sub):
        fun
        | (PairList []): sub
        | (PairList [[tm1, tm2], & rest]): (if Host.hol_physical_equal(tm1)(tm2) | solve_2(sub)(rest) | solve_prime_2(sub)([subst(sub)(tm1), subst(sub)(tm2), rest]))
      fun solve_prime_2(sub):
        fun
        | ([Term.Var(v), tm, rest]):
            if Term.equalVar(v)(tm)
            | solve_2(sub)(rest)
            | if Term.freeIn(v)(tm)
              | failwith("Substitute.unify: occurs check")
              | match peek(sub, v)
                | Host.None(): solve_2(compose(sub)(singleton([v, tm])))(rest)
                | Host.Some(tm_prime): solve_prime_2(sub)([tm_prime, tm, rest])
        | ([tm1, Term.Var(_) as tm2, rest]): solve_prime_2(sub)([tm2, tm1, rest])
        | ([Term.Fn([f1, args1]), Term.Fn([f2, args2]), rest]): (if (Name.equal(f1)(f2) && Host.hol_equal(length(args1))(length(args2))) | solve_2(sub)(append(zip(args1)(args2))(rest)) | failwith("Substitute.unify: different structure"))
      solve_2(sub)(PairList [[tm1, tm2]])

    def insert = insert_impl

    def foldl = foldl_impl

    def foldr = foldr_impl

    def remove = remove_impl

    def union = union_impl

  namespace Atom:
    export:
      name
      arguments
      arity
      relation
      functions
      functionNames
      mkBinop
      destBinop
      isBinop
      symbols
      compare
      equal
      subterm
      subterms
      replace
      find
      freeIn
      freeVars
      subst
      matchAtoms
      unify
      eqRelationName
      eqRelationArity
      eqRelation
      mkEq
      destEq
      isEq
      mkRefl
      destRefl
      isRefl
      sym
      lhs
      rhs
      typedSymbols
      nonVarTypedSubterms
      Ordered
      Map
      Set

    fun name([rel, _]): rel

    fun arguments([_, args]): args

    fun arity(atm): length(arguments(atm))

    fun relation(atm): [name(atm), arity(atm)]

    def functions:
      let f = (fun([tm, acc]): Name_arity.Set.union(Term.functions(tm))(acc))
      (fun(atm): Mlist.foldl(f)(Name_arity.Set.empty)(arguments(atm)))

    def functionNames:
      let f = (fun([tm, acc]): Name.Set.union(Term.functionNames(tm))(acc))
      (fun(atm): Mlist.foldl(f)(Name.Set.empty)(arguments(atm)))

    curried fun mkBinop(p, [a, b]): [p, PairList [a, b]]

    fun destBinop(p):
      fun
      | ([x, PairList [a, & PairList [b, & PairList []]]]): (if Name.equal(x)(p) | [a, b] | failwith("Atom.destBinop: wrong binop"))
      | (_): failwith("Atom.destBinop: not a binop")

    fun isBinop(p): can(destBinop(p))

    fun symbols(atm): Mlist.foldl((fun([tm, z]): Host.hol_add(Term.symbols(tm))(z)))(1)(arguments(atm))

    curried fun compare_impl([p1, tms1], [p2, tms2]):
      let c = Name.compare(p1)(p2)
      (if Host.hol_unequal(c)(0) | c | Useful.lexCompare(Term.compare)(tms1)(tms2))

    curried fun equal(atm1, atm2): Host.hol_equal(compare_impl(atm1, atm2))(0)

    def subterm:
      let subterm_prime:
        fun
        | ([_, PairList []]): Host.hol_raise(Useful.Bug("Atom.subterm: empty path"))
        | ([[_, tms], PairList [h, & t]]): (if Host.hol_ge(h)(length(tms)) | failwith("Atom.subterm: bad path") | Term.subterm(Host.OCamlList.nth(tms)(h))(t))
      (fun(x): (fun(y): subterm_prime([x, y])))

    fun subterms([_, tms]):
      let f = (fun([[n, tm], l]): append(Host.OCamlList.map((fun([p, s]): [PairList [n, & p], s]))(Term.subterms(tm)))(l))
      Mlist.foldl(f)(PairList [])(Mlist.enumerate(tms))

    fun replace([rel, tms] as atm):
      fun
      | ([PairList [], _]): Host.hol_raise(Useful.Bug("Atom.replace: empty path"))
      | ([PairList [h, & t], res]):
          if Host.hol_ge(h)(length(tms))
          | failwith("Atom.replace: bad path")
          | let tm = Host.OCamlList.nth(tms)(h)
            let tm_prime = Term.replace(tm)([t, res])
            (if Host.hol_physical_equal(tm)(tm_prime) | atm | [rel, Mlist.updateNth([h, tm_prime])(tms)])

    fun find_impl(pred):
      let f:
        fun([i, tm]):
          match Term.find(pred)(tm)
          | Host.Some(path): Host.Some(PairList [i, & path])
          | Host.None(): Host.None()
      (fun([_, tms]): Mlist.first(f)(Mlist.enumerate(tms)))

    curried fun freeIn(v, atm): Host.OCamlList.exists(Term.freeIn(v))(arguments(atm))

    def freeVars:
      let f = (fun([tm, acc]): Name.Set.union(Term.freeVars(tm))(acc))
      (fun(atm): Mlist.foldl(f)(Name.Set.empty)(arguments(atm)))

    curried fun subst(sub, [p, tms] as atm):
      let tms_prime = Host.OCamlList.map(Substitute.subst(sub))(tms)
      (if Host.hol_physical_equal(tms_prime)(tms) | atm | [p, tms_prime])

    curried fun matchAtoms(sub, [p1, tms1], [p2, tms2]):
      let matchArg = (fun([[tm1, tm2], sub]): Substitute.matchTerms(sub)(tm1)(tm2))
      let _ = ((Name.equal(p1)(p2) && Host.hol_equal(length(tms1))(length(tms2))) || failwith("Atom.match"))
      Mlist.foldl(matchArg)(sub)(zip(tms1)(tms2))

    curried fun unify(sub, [p1, tms1], [p2, tms2]):
      let unifyArg = (fun([[tm1, tm2], sub]): Substitute.unify(sub)(tm1)(tm2))
      let _ = ((Name.equal(p1)(p2) && Host.hol_equal(length(tms1))(length(tms2))) || failwith("Atom.unify"))
      Mlist.foldl(unifyArg)(sub)(zip(tms1)(tms2))

    def eqRelationName = Name.fromString("=")

    def eqRelationArity = 2

    def eqRelation = [eqRelationName, eqRelationArity]

    def mkEq = mkBinop(eqRelationName)

    fun destEq(x): destBinop(eqRelationName)(x)

    fun isEq(x): isBinop(eqRelationName)(x)

    fun mkRefl(tm): mkEq([tm, tm])

    fun destRefl(atm):
      let [l, r] = destEq(atm)
      let _ = (Term.equal(l)(r) || failwith("Atom.destRefl"))
      l

    fun isRefl(x): can(destRefl)(x)

    fun sym(atm):
      let [l, r] = destEq(atm)
      let _ = (Host.hol_not(Term.equal(l)(r)) || failwith("Atom.sym: refl"))
      mkEq([r, l])

    fun lhs(atm): fst(destEq(atm))

    fun rhs(atm): snd(destEq(atm))

    fun typedSymbols([_, tms]): Mlist.foldl((fun([tm, z]): Host.hol_add(Term.typedSymbols(tm))(z)))(1)(tms)

    fun nonVarTypedSubterms([_, tms]):
      let addArg:
        fun([[n, arg], acc]):
          let addTm = (fun([[path, tm], acc]): PairList [[PairList [n, & path], tm], & acc])
          Mlist.foldl(addTm)(acc)(Term.nonVarTypedSubterms(arg))
      Mlist.foldl(addArg)(PairList [])(Mlist.enumerate(tms))

    namespace Ordered:
      export:
        compare

      def compare_impl_2 = compare_impl

      def compare = compare_impl_2

    namespace Map:
      export:
        Ma
        newMap
        null
        singleton
        size
        get
        peek
        insert
        toList
        fromList
        foldl
        foldr
        filter
        inDomain
        union
        delete
        mapPartial
        transform
        exists

      // OCaml 4.14.1 Map.Make; Copyright 1996 INRIA, Xavier Leroy.
      // LGPL 2.1 with OCaml linking exception; see tools/translate/stdlib.
      namespace Ma:
        export:
          TNode
          Empty
          Node
          height
          create
          singleton
          bal
          empty
          is_empty
          add
          find
          mem
          min_binding
          remove_min_binding
          merge
          remove
          map
          fold
          exists
          add_min_binding
          add_max_binding
          join
          concat
          concat_or_join
          split
          filter
          End
          More
          cardinal
          bindings_aux
          bindings

        record TNode(l, v, d, r, h)

        variant t:
          Empty()
          Node(node)

        fun height
        | height(Empty()): 0
        | height(Node(TNode(_,_,_,_,h))): h

        curried fun create(l, x, d, r):
          let hl_2 = height(l)
          let hr_2 = height(r)
          Node(
            TNode(l, x, d, r, (if Host.hol_ge(hl_2)(hr_2) | Host.hol_add(hl_2)(1) | Host.hol_add(hr_2)(1)))
          )

        curried fun singleton(x, d): Node(TNode(Empty(), x, d, Empty(), 1))

        curried fun bal(l, x, d, r):
          let hl:
            match l
            | Empty(): 0
            | Node(TNode(_,_,_,_,h)): h
          let hr:
            match r
            | Empty(): 0
            | Node(TNode(_,_,_,_,h)): h
          if Host.hol_gt(hl)(Host.hol_add(hr)(2))
          | match l
            | Empty(): Host.hol_invalid_arg("Map.bal")
            | Node(TNode(ll,lv,ld,lr,_)):
                if Host.hol_ge(height(ll))(height(lr))
                | create(ll)(lv)(ld)(create(lr, x, d, r))
                | match lr
                  | Empty(): Host.hol_invalid_arg("Map.bal")
                  | Node(TNode(lrl,lrv,lrd,lrr,_)): create(create(ll, lv, ld, lrl))(lrv)(lrd)(create(lrr, x, d, r))
          | if Host.hol_gt(hr)(Host.hol_add(hl)(2))
            | match r
              | Empty(): Host.hol_invalid_arg("Map.bal")
              | Node(TNode(rl,rv,rd,rr,_)):
                  if Host.hol_ge(height(rr))(height(rl))
                  | create(create(l, x, d, rl), rv, rd, rr)
                  | match rl
                    | Empty(): Host.hol_invalid_arg("Map.bal")
                    | Node(TNode(rll,rlv,rld,rlr,_)): create(create(l, x, d, rll))(rlv)(rld)(create(rlr, rv, rd, rr))
            | Node(TNode(l, x, d, r, (if Host.hol_ge(hl)(hr) | Host.hol_add(hl)(1) | Host.hol_add(hr)(1))))

        def empty = Empty()

        fun is_empty
        | is_empty(Empty()): #true
        | is_empty(_): #false

        curried fun add(x, data):
          fun
          | (Empty()): Node(TNode(Empty(), x, data, Empty(), 1))
          | (Node(TNode(l,v,d,r,h)) as m):
              let c = Ordered.compare(x)(v)
              if Host.hol_equal(c)(0)
              | (if Host.hol_physical_equal(d)(data) | m | Node(TNode(l, x, data, r, h)))
              | if Host.hol_lt(c)(0)
                | let ll = add(x, data)(l)
                  (if Host.hol_physical_equal(l)(ll) | m | bal(ll, v, d, r))
                | let rr = add(x, data)(r)
                  (if Host.hol_physical_equal(r)(rr) | m | bal(l, v, d, rr))

        fun find_impl_2(x):
          fun
          | (Empty()): Host.hol_raise(Host.Not_found())
          | (Node(TNode(l,v,d,r,_))):
              let c = Ordered.compare(x)(v)
              if Host.hol_equal(c)(0)
              | d
              | find_impl_2(x)((if Host.hol_lt(c)(0) | l | r))

        fun mem_impl(x):
          fun
          | (Empty()): #false
          | (Node(TNode(l,v,_,r,_))):
              let c = Ordered.compare(x)(v)
              (Host.hol_equal(c)(0) || mem_impl(x)((if Host.hol_lt(c)(0) | l | r)))

        fun min_binding
        | min_binding(Empty()): Host.hol_raise(Host.Not_found())
        | min_binding(Node(TNode(Empty(),v,d,_,_))): [v, d]
        | min_binding(Node(TNode(l,_,_,_,_))): min_binding(l)

        fun remove_min_binding
        | remove_min_binding(Empty()): Host.hol_invalid_arg("Map.remove_min_elt")
        | remove_min_binding(Node(TNode(Empty(),_,_,r,_))): r
        | remove_min_binding(Node(TNode(l,v,d,r,_))): bal(remove_min_binding(l), v, d, r)

        curried fun merge_impl(t1, t2):
          match [t1, t2]
          | [Empty(), t]: t
          | [t, Empty()]: t
          | [_, _]:
              let [x, d] = min_binding(t2)
              bal(t1)(x)(d)(remove_min_binding(t2))

        fun remove_impl(x):
          fun
          | (Empty()): Empty()
          | (Node(TNode(l,v,d,r,_)) as m):
              let c = Ordered.compare(x)(v)
              if Host.hol_equal(c)(0)
              | merge_impl(l, r)
              | if Host.hol_lt(c)(0)
                | let ll = remove_impl(x)(l)
                  (if Host.hol_physical_equal(l)(ll) | m | bal(ll, v, d, r))
                | let rr = remove_impl(x)(r)
                  (if Host.hol_physical_equal(r)(rr) | m | bal(l, v, d, rr))

        fun map_impl(f):
          fun
          | (Empty()): Empty()
          | (Node(TNode(l,v,d,r,h))):
              let l_prime = map_impl(f)(l)
              let d_prime = f(d)
              let r_prime = map_impl(f)(r)
              Node(TNode(l_prime, v, d_prime, r_prime, h))

        curried fun fold(f, m, accu):
          match m
          | Empty(): accu
          | Node(TNode(l,v,d,r,_)): fold(f)(r)(f(v)(d)(fold(f, l, accu)))

        fun exists_impl(p):
          fun
          | (Empty()): #false
          | (Node(TNode(l,v,d,r,_))): (p(v)(d) || (exists_impl(p)(l) || exists_impl(p)(r)))

        curried fun add_min_binding(k, x):
          fun
          | (Empty()): singleton(k, x)
          | (Node(TNode(l,v,d,r,_))): bal(add_min_binding(k, x)(l), v, d, r)

        curried fun add_max_binding(k, x):
          fun
          | (Empty()): singleton(k, x)
          | (Node(TNode(l,v,d,r,_))): bal(l)(v)(d)(add_max_binding(k, x)(r))

        curried fun join(l, v, d, r):
          match [l, r]
          | [Empty(), _]: add_min_binding(v, d)(r)
          | [_, Empty()]: add_max_binding(v, d)(l)
          | [Node(TNode(ll,lv,ld,lr,lh)), Node(TNode(rl,rv,rd,rr,rh))]:
              if Host.hol_gt(lh)(Host.hol_add(rh)(2))
              | bal(ll)(lv)(ld)(join(lr, v, d, r))
              | (if Host.hol_gt(rh)(Host.hol_add(lh)(2)) | bal(join(l, v, d, rl), rv, rd, rr) | create(l, v, d, r))

        curried fun concat(t1, t2):
          match [t1, t2]
          | [Empty(), t]: t
          | [t, Empty()]: t
          | [_, _]:
              let [x, d] = min_binding(t2)
              join(t1)(x)(d)(remove_min_binding(t2))

        curried fun concat_or_join(t1, v, d, t2):
          match d
          | Host.Some(d): join(t1, v, d, t2)
          | Host.None(): concat(t1, t2)

        fun split(x):
          fun
          | (Empty()): [Empty(), Host.None(), Empty()]
          | (Node(TNode(l,v,d,r,_))):
              let c = Ordered.compare(x)(v)
              if Host.hol_equal(c)(0)
              | [l, Host.Some(d), r]
              | if Host.hol_lt(c)(0)
                | let [ll, pres, rl] = split(x)(l)
                  [ll, pres, join(rl, v, d, r)]
                | let [lr, pres, rr] = split(x)(r)
                  [join(l, v, d, lr), pres, rr]

        curried fun merge_v2(f, s1, s2):
          let subject = [s1, s2]
          match subject
          | [Empty(), Empty()]: Empty()
          | [Node(TNode(l1,v1,d1,r1,h1)), _]:
              if Host.hol_ge(h1)(height(s2))
              | let [l2, d2, r2] = split(v1)(s2)
                concat_or_join(merge_v2(f, l1, l2))(v1)(f(v1)(Host.Some(d1))(d2))(merge_v2(f, r1, r2))
              | match subject
                | [_, Node(TNode(l2,v2,d2,r2,_))]:
                    let [l1, d1, r1] = split(v2)(s1)
                    concat_or_join(merge_v2(f, l1, l2))(v2)(f(v2)(d1)(Host.Some(d2)))(merge_v2(f, r1, r2))
                | _: (if #false | #void | failwith("Assertion failed"))
          | [_, Node(TNode(l2,v2,d2,r2,_))]:
              let [l1, d1, r1] = split(v2)(s1)
              concat_or_join(merge_v2(f, l1, l2))(v2)(f(v2)(d1)(Host.Some(d2)))(merge_v2(f, r1, r2))
          | _: (if #false | #void | failwith("Assertion failed"))

        fun filter_impl(p):
          fun
          | (Empty()): Empty()
          | (Node(TNode(l,v,d,r,_)) as m):
              let l_prime = filter_impl(p)(l)
              let pvd = p(v)(d)
              let r_prime = filter_impl(p)(r)
              if pvd
              | (if (Host.hol_physical_equal(l)(l_prime) && Host.hol_physical_equal(r)(r_prime)) | m | join(l_prime, v, d, r_prime))
              | concat(l_prime, r_prime)

        variant enumeration:
          End()
          More(key, value, right, enumeration)

        fun cardinal
        | cardinal(Empty()): 0
        | cardinal(Node(TNode(l,_,_,r,_))): Host.hol_add(Host.hol_add(cardinal(l))(1))(cardinal(r))

        fun bindings_aux(accu):
          fun
          | (Empty()): accu
          | (Node(TNode(l,v,d,r,_))): bindings_aux(PairList [[v, d], & bindings_aux(accu)(r)])(l)

        fun bindings(s): bindings_aux(PairList [])(s)

        def find = find_impl_2

        def mem = mem_impl

        def merge = merge_v2

        def remove = remove_impl

        def map = map_impl

        def exists = exists_impl

        def filter = filter_impl

      fun newMap(_): Ma.empty

      def null = Ma.is_empty

      fun singleton([k, x]): Ma.singleton(k)(x)

      def size = Ma.cardinal

      curried fun get(m, k):
        try:
          Ma.find(k)(m)
          ~catch exn:
            match exn
            | Host.Not_found(): failwith("Mmap.get: element not found")
            | exn: Host.hol_raise(exn)

      curried fun peek(m, k):
        try:
          Host.Some(Ma.find(k)(m))
          ~catch exn:
            match exn
            | Host.Not_found(): Host.None()
            | exn: Host.hol_raise(exn)

      curried fun insert_impl(m, [k, v]): Ma.add(k)(v)(m)

      def toList = Ma.bindings

      fun fromList(l): Host.OCamlList.fold_right((fun([v, tm]): Ma.add(v)(tm)))(l)(Ma.empty)

      curried fun foldl_impl(f, b, m): Host.OCamlList.fold_left((fun(s): (fun([v, tm]): f([v, tm, s]))))(b)(Ma.bindings(m))

      def foldr_impl = foldl_impl

      fun filter_impl(f): Ma.filter((fun(x): (fun(y): f([x, y]))))

      def inDomain = Ma.mem

      curried fun union_impl(f, m1, m2):
        let f_prime:
          fun(k):
            fun
            | ([Host.Some(x), Host.Some(y)]): f([[k, x], [k, y]])
            | ([Host.Some(x), Host.None()]): Host.Some(x)
            | ([Host.None(), Host.Some(y)]): Host.Some(y)
            | ([Host.None(), Host.None()]): Host.None()
        Ma.merge((fun(k): (fun(x): (fun(y): f_prime(k)([x, y])))))(m1)(m2)

      curried fun delete(m, k): Ma.remove(k)(m)

      curried fun mapPartial(f, m):
        Ma.fold(
          fun(k):
            fun(x):
              fun(acc):
                match f([k, x])
                | Host.Some(y): Ma.add(k)(y)(acc)
                | Host.None(): acc
        )(m)(Ma.empty)

      def transform = Ma.map

      fun exists_impl(f): Ma.exists((fun(k): (fun(m): f([k, m]))))

      def insert = insert_impl

      def foldl = foldl_impl

      def foldr = foldr_impl

      def filter = filter_impl

      def union = union_impl

      def exists = exists_impl

    namespace Set:
      export:
        Se
        compare
        add
        foldr
        foldl
        member
        empty
        union
        difference
        toList
        singleton
        null
        size
