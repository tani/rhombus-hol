        for_all
        rename exists_impl as exists
        cardinal
        elements_aux
        elements
        rename choose_impl as choose

      record TNode(l, v, r, h)

      variant t:
        Empty()
        Node(node)

      fun height
      | height(Empty()): 0
      | height(Node(TNode(_,_,_,h))): h

      fun create(l):
        fun(v):
          fun(r):
            let hl:
              match l
              | Empty(): 0
              | Node(TNode(_,_,_,h)): h
            let hr:
              match r
              | Empty(): 0
              | Node(TNode(_,_,_,h)): h
            Node(TNode(l, v, r, (if (hl >= hr) | (hl + 1) | (hr + 1))))

      fun bal(l):
        fun(v):
          fun(r):
            let hl:
              match l
              | Empty(): 0
              | Node(TNode(_,_,_,h)): h
            let hr:
              match r
              | Empty(): 0
              | Node(TNode(_,_,_,h)): h
            if (hl > (hr + 2))
            | match l
              | Empty(): (throw InvalidArgument("Set.bal"))
              | Node(TNode(ll,lv,lr,_)):
                  if (height(ll) >= height(lr))
                  | create(ll)(lv)(create(lr)(v)(r))
                  | match lr
                    | Empty(): (throw InvalidArgument("Set.bal"))
                    | Node(TNode(lrl,lrv,lrr,_)): create(create(ll)(lv)(lrl))(lrv)(create(lrr)(v)(r))
            | if (hr > (hl + 2))
              | match r
                | Empty(): (throw InvalidArgument("Set.bal"))
                | Node(TNode(rl,rv,rr,_)):
                    if (height(rr) >= height(rl))
                    | create(create(l)(v)(rl))(rv)(rr)
                    | match rl
                      | Empty(): (throw InvalidArgument("Set.bal"))
                      | Node(TNode(rll,rlv,rlr,_)): create(create(l)(v)(rll))(rlv)(create(rlr)(rv)(rr))
              | Node(TNode(l, v, r, (if (hl >= hr) | (hl + 1) | (hr + 1))))
      fun add(x):
        fun(stage_arg):
          match stage_arg
          | Empty(): Node(TNode(Empty(), x, Empty(), 1))
          | Node(TNode(l,v,r,_)) as t:
              let c = Ordered.compare(x)(v)
              if (c == 0)
              | t
              | if (c < 0)
                | let ll = add(x)(l)
                  (if (l === ll) | t | bal(ll)(v)(r))
                | let rr = add(x)(r)
                  (if (r === rr) | t | bal(l)(v)(rr))

      fun singleton(x): Node(TNode(Empty(), x, Empty(), 1))
      fun add_min_element(x):
        fun(stage_arg):
          match stage_arg
          | Empty(): singleton(x)
          | Node(TNode(l,v,r,_)): bal(add_min_element(x)(l))(v)(r)
      fun add_max_element(x):
        fun(stage_arg):
          match stage_arg
          | Empty(): singleton(x)
          | Node(TNode(l,v,r,_)): bal(l)(v)(add_max_element(x)(r))

      fun join(l):
        fun(v):
          fun(r):
            match [l, r]
            | [Empty(), _]: add_min_element(v)(r)
            | [_, Empty()]: add_max_element(v)(l)
            | [Node(TNode(ll,lv,lr,lh)), Node(TNode(rl,rv,rr,rh))]:
                if (lh > (rh + 2))
                | bal(ll)(lv)(join(lr)(v)(r))
                | (if (rh > (lh + 2)) | bal(join(l)(v)(rl))(rv)(rr) | create(l)(v)(r))

      fun min_elt
      | min_elt(Empty()): (throw Not_found())
      | min_elt(Node(TNode(Empty(),v,_,_))): v
      | min_elt(Node(TNode(l,_,_,_))): min_elt(l)

      fun remove_min_elt
      | remove_min_elt(Empty()): (throw InvalidArgument("Set.remove_min_elt"))
      | remove_min_elt(Node(TNode(Empty(),_,r,_))): r
      | remove_min_elt(Node(TNode(l,v,r,_))): bal(remove_min_elt(l))(v)(r)

      fun merge_impl(t1):
        fun(t2):
          match [t1, t2]
          | [Empty(), t]: t
          | [t, Empty()]: t
          | [_, _]: bal(t1)(min_elt(t2))(remove_min_elt(t2))

      fun concat(t1):
        fun(t2):
          match [t1, t2]
          | [Empty(), t]: t
          | [t, Empty()]: t
          | [_, _]: join(t1)(min_elt(t2))(remove_min_elt(t2))
      fun split(x):
        fun(stage_arg):
          match stage_arg
          | Empty(): [Empty(), #false, Empty()]
          | Node(TNode(l,v,r,_)):
              let c = Ordered.compare(x)(v)
              if (c == 0)
              | [l, #true, r]
              | if (c < 0)
                | let [ll, pres, rl] = split(x)(l)
                  [ll, pres, join(rl)(v)(r)]
                | let [lr, pres, rr] = split(x)(r)
                  [join(l)(v)(lr), pres, rr]

      def empty = Empty()

      fun is_empty
      | is_empty(Empty()): #true
      | is_empty(_): #false
      fun mem_impl(x):
        fun(stage_arg):
          match stage_arg
          | Empty(): #false
          | Node(TNode(l,v,r,_)):
              let c = Ordered.compare(x)(v)
              ((c == 0) || mem_impl(x)((if (c < 0) | l | r)))
      fun remove_impl(x):
        fun(stage_arg):
          match stage_arg
          | Empty(): Empty()
          | Node(TNode(l,v,r,_)) as t:
              let c = Ordered.compare(x)(v)
              if (c == 0)
              | merge_impl(l)(r)
              | if (c < 0)
                | let ll = remove_impl(x)(l)
                  (if (l === ll) | t | bal(ll)(v)(r))
                | let rr = remove_impl(x)(r)
                  (if (r === rr) | t | bal(l)(v)(rr))

      fun union_impl(s1):
        fun(s2):
          match [s1, s2]
          | [Empty(), t2]: t2
          | [t1, Empty()]: t1
          | [Node(TNode(l1,v1,r1,h1)), Node(TNode(l2,v2,r2,h2))]:
              if (h1 >= h2)
              | if (h2 == 1)
                | add(v2)(s1)
                | let [l2, _, r2] = split(v1)(s2)
                  join(union_impl(l1)(l2))(v1)(union_impl(r1)(r2))
              | if (h1 == 1)
                | add(v1)(s2)
                | let [l1, _, r1] = split(v2)(s1)
                  join(union_impl(l1)(l2))(v2)(union_impl(r1)(r2))

      fun inter(s1):
        fun(s2):
          match [s1, s2]
          | [Empty(), _]: Empty()
          | [_, Empty()]: Empty()
          | [Node(TNode(l1,v1,r1,_)), t2]:
              match split(v1)(t2)
              | [l2, #false, r2]: concat(inter(l1)(l2))(inter(r1)(r2))
              | [l2, #true, r2]: join(inter(l1)(l2))(v1)(inter(r1)(r2))

      variant split_bis:
        Found()
        NotFound(left, right)

      fun diff(s1):
        fun(s2):
          match [s1, s2]
          | [Empty(), _]: Empty()
          | [t1, Empty()]: t1
          | [Node(TNode(l1,v1,r1,_)), t2]:
              match split(v1)(t2)
              | [l2, #false, r2]: join(diff(l1)(l2))(v1)(diff(r1)(r2))
              | [l2, #true, r2]: concat(diff(l1)(l2))(diff(r1)(r2))

      variant enumeration:
        End()
        More(element, right, enumeration)

      fun cons_enum(s):
        fun(e):
          match s
          | Empty(): e
          | Node(TNode(l,v,r,_)): cons_enum(l)(More(v, r, e))

      fun compare_aux(e1):
        fun(e2):
          match [e1, e2]
          | [End(), End()]: 0
          | [End(), _]: -1
          | [_, End()]: 1
          | [More(v1,r1,e1), More(v2,r2,e2)]:
              let c = Ordered.compare(v1)(v2)
              (if (c != 0) | c | compare_aux(cons_enum(r1)(e1))(cons_enum(r2)(e2)))

      fun compare_impl_2(s1): fun(s2): compare_aux(cons_enum(s1)(End()))(cons_enum(s2)(End()))

      fun equal_impl(s1): fun(s2): (compare_impl_2(s1)(s2) == 0)

      fun subset_impl(s1):
        fun(s2):
          match [s1, s2]
          | [Empty(), _]: #true
          | [_, Empty()]: #false
          | [Node(TNode(l1,v1,r1,_)), Node(TNode(l2,v2,r2,_)) as t2]:
              let c = Ordered.compare(v1)(v2)
              if (c == 0)
              | (subset_impl(l1)(l2) && subset_impl(r1)(r2))
              | (if (c < 0) | (subset_impl(Node(TNode(l1, v1, Empty(), 0)))(l2) && subset_impl(r1)(t2)) | (subset_impl(Node(TNode(Empty(), v1, r1, 0)))(r2) && subset_impl(l1)(t2)))

      fun fold(f):
        fun(s):
          fun(accu):
            match s
            | Empty(): accu
            | Node(TNode(l,v,r,_)): fold(f)(r)(f(v)(fold(f)(l)(accu)))
      fun for_all(p):
        fun(stage_arg):
          match stage_arg
          | Empty(): #true
          | Node(TNode(l,v,r,_)): (p(v) && (for_all(p)(l) && for_all(p)(r)))
      fun exists_impl(p):
        fun(stage_arg):
          match stage_arg
          | Empty(): #false
          | Node(TNode(l,v,r,_)): (p(v) || (exists_impl(p)(l) || exists_impl(p)(r)))

      fun cardinal
      | cardinal(Empty()): 0
      | cardinal(Node(TNode(l,_,r,_))): ((cardinal(l) + 1) + cardinal(r))
      fun elements_aux(accu):
        fun(stage_arg):
          match stage_arg
          | Empty(): accu
          | Node(TNode(l,v,r,_)): elements_aux(PairList [v, & elements_aux(accu)(r)])(l)

      fun elements(s): elements_aux(PairList [])(s)

      def choose_impl = min_elt

  namespace Substitute:
    export:
      Subst
      empty
      null
      size
      peek
      rename insert_impl as insert
      singleton
      toList
      fromList
      rename foldl_impl as foldl
      rename foldr_impl as foldr
      normalize
      subst
      restrict
      rename remove_impl as remove
      compose
      rename union_impl as union
      invert
      isRenaming
      freshVars
      redexes
      residueFreeVars
      freeVars
      functions
      matchTerms
      unify

    variant subst:
      Subst(map)

    def empty = Subst(Name.Map.newMap(#void))

    fun null(Subst(m)): Name.Map.null(m)

    fun size(Subst(m)): Name.Map.size(m)

    fun peek(Subst(m)): fun(v): Name.Map.peek(m)(v)

    fun insert_impl(Subst(m)): fun(v_tm): Subst(Name.Map.insert(m)(v_tm))

    fun singleton(v_tm): insert_impl(empty)(v_tm)

    fun toList(Subst(m)): Name.Map.toList(m)

    fun fromList(l): Subst(Name.Map.fromList(l))

    fun foldl_impl(f): fun(b): fun(Subst(m)): Name.Map.foldl(f)(b)(m)

    fun foldr_impl(f): fun(b): fun(Subst(m)): Name.Map.foldr(f)(b)(m)

    fun normalize(Subst(m) as sub):
      let isNotId = (fun([v, tm]): !Term.equalVar(v)(tm))
      let m_prime = Name.Map.filter(isNotId)(m)
      (if (Name.Map.size(m) == Name.Map.size(m_prime)) | sub | Subst(m_prime))

    fun subst(sub):
      fun tmSub
      | tmSub(Term.Var(v) as tm):
          match peek(sub)(v)
          | Some(tm_prime): (if (tm === tm_prime) | tm | tm_prime)
          | None(): tm
      | tmSub(Term.Fn([f, args]) as tm):
          let args_prime = PairList.map(args, tmSub)
          (if (args === args_prime) | tm | Term.Fn([f, args_prime]))
      (fun(tm): (if null(sub) | tm | tmSub(tm)))

    fun restrict(Subst(m) as sub):
      fun(varSet):
        let isRestrictedVar = (fun([v, _]): Name.Set.member(v)(varSet))
        let m_prime = Name.Map.filter(isRestrictedVar)(m)
        (if (Name.Map.size(m) == Name.Map.size(m_prime)) | sub | Subst(m_prime))

    fun remove_impl(Subst(m) as sub):
      fun(varSet):
        let isRestrictedVar = (fun([v, _]): !Name.Set.member(v)(varSet))
        let m_prime = Name.Map.filter(isRestrictedVar)(m)
        (if (Name.Map.size(m) == Name.Map.size(m_prime)) | sub | Subst(m_prime))

    fun compose(Subst(m1) as sub1):
      fun(sub2):
        let f = (fun([v, tm, s]): insert_impl(s)([v, subst(sub2)(tm)]))
        (if null(sub2) | sub1 | Name.Map.foldl(f)(sub2)(m1))

    fun union_impl(Subst(m1) as s1):
      fun(Subst(m2) as s2):
        let compatible = (fun([[_, tm1], [_, tm2]]): (if Term.equal(tm1)(tm2) | Some(tm1) | failwith("Substitute.union: incompatible")))
        if Name.Map.null(m1)
        | s2
        | (if Name.Map.null(m2) | s1 | Subst(Name.Map.union(compatible)(m1)(m2)))

    fun invert(Subst(m)):
      let inv:
        fun
        | ([v, Term.Var(w), s]): (if Name.Map.inDomain(w)(s) | failwith("Substitute.invert: non-injective") | Name.Map.insert(s)([w, Term.Var(v)]))
        | ([_, Term.Fn(_), _]): failwith("Substitute.invert: non-variable")
      Subst(Name.Map.foldl(inv)(Name.Map.newMap(#void))(m))

    def isRenaming = can(invert)

    fun freshVars(s):
      let add = (fun([v, m]): insert_impl(m)([v, Term.newVar(#void)]))
      Name.Set.foldl(add)(empty)(s)

    def redexes:
      let add = (fun([v, _, s]): Name.Set.add(s)(v))
      foldl_impl(add)(Name.Set.empty)

    def residueFreeVars:
      let add = (fun([_, t, s]): Name.Set.union(s)(Term.freeVars(t)))
      foldl_impl(add)(Name.Set.empty)

    def freeVars:
      let add = (fun([v, t, s]): Name.Set.union(Name.Set.add(s)(v))(Term.freeVars(t)))
      foldl_impl(add)(Name.Set.empty)

    def functions:
      let add = (fun([_, t, s]): Name_arity.Set.union(s)(Term.functions(t)))
      foldl_impl(add)(Name_arity.Set.empty)

    fun matchTerms(sub):
      fun(tm1):
        fun(tm2):
          // Recursive term matching needs the local definition before its first use.
          fun matchList(sub):
            fun(stage_arg):
              match stage_arg
              | PairList []: sub
              | PairList [[Term.Var(v), tm], & rest]:
                  let sub:
                    match peek(sub)(v)
                    | None(): insert_impl(sub)([v, tm])
                    | Some(tm_prime): (if Term.equal(tm)(tm_prime) | sub | failwith("Substitute.match: incompatible matches"))
                  matchList(sub)(rest)
              | PairList [[Term.Fn([f1, args1]), Term.Fn([f2, args2])], & rest]: (if (Name.equal(f1)(f2) && (length(args1) == length(args2))) | matchList(sub)(append(zip(args1)(args2))(rest)) | failwith("Substitute.match: different structure"))
              | _: failwith("Substitute.match: functions can't match vars")
          matchList(sub)(PairList [[tm1, tm2]])

    fun unify(sub):
      fun(tm1):
        fun(tm2):
          // Mutually recursive unification needs local definitions for forward references.
          fun solve_2(sub):
            fun(stage_arg):
              match stage_arg
              | PairList []: sub
              | PairList [[tm1, tm2], & rest]: (if (tm1 === tm2) | solve_2(sub)(rest) | solve_prime_2(sub)([subst(sub)(tm1), subst(sub)(tm2), rest]))
          // Mutually recursive unification needs both local definitions before use.
          fun solve_prime_2(sub):
            fun(stage_arg):
              match stage_arg
              | [Term.Var(v), tm, rest]:
                  if Term.equalVar(v)(tm)
                  | solve_2(sub)(rest)
                  | if Term.freeIn(v)(tm)
                    | failwith("Substitute.unify: occurs check")
                    | match peek(sub)(v)
                      | None(): solve_2(compose(sub)(singleton([v, tm])))(rest)
                      | Some(tm_prime): solve_prime_2(sub)([tm_prime, tm, rest])
              | [tm1, Term.Var(_) as tm2, rest]: solve_prime_2(sub)([tm2, tm1, rest])
              | [Term.Fn([f1, args1]), Term.Fn([f2, args2]), rest]: (if (Name.equal(f1)(f2) && (length(args1) == length(args2))) | solve_2(sub)(append(zip(args1)(args2))(rest)) | failwith("Substitute.unify: different structure"))
          solve_2(sub)(PairList [[tm1, tm2]])

  namespace Atom:
    export:
      name
      arguments
      arity
      relation
      functions
      functionNames
      mkBinop
      destBinop
      isBinop
      symbols
      rename compare_impl as compare
      equal
