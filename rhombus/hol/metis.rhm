    variant formula:
      True()
      False()
      AtomValue(atom)
      Not(body)
      And(left, right)
      Or(left, right)
      Imp(antecedent, consequent)
      Iff(left, right)
      Forall(variable, body)
      Exists(variable, body)

    fun mkBoolean
    | mkBoolean(#true): True()
    | mkBoolean(#false): False()

    fun destBoolean
    | destBoolean(True()): #true
    | destBoolean(False()): #false
    | destBoolean(_): failwith("destBoolean")

    def isBoolean = can(destBoolean)

    fun isTrue(fm):
      match fm
      | True(): #true
      | _: #false

    fun isFalse(fm):
      match fm
      | False(): #true
      | _: #false

    fun functions(fm):
      fun funcs(fs):
        fun
        | (PairList []): fs
        | (PairList [True(), & fms]): funcs(fs)(fms)
        | (PairList [False(), & fms]): funcs(fs)(fms)
        | (PairList [AtomValue(atm), & fms]): funcs(Name_arity.Set.union(Atom.functions(atm))(fs))(fms)
        | (PairList [Not(p), & fms]): funcs(fs)(PairList [p, & fms])
        | (PairList [And(p,q), & fms]): funcs(fs)(PairList [p, q, & fms])
        | (PairList [Or(p,q), & fms]): funcs(fs)(PairList [p, q, & fms])
        | (PairList [Imp(p,q), & fms]): funcs(fs)(PairList [p, q, & fms])
        | (PairList [Iff(p,q), & fms]): funcs(fs)(PairList [p, q, & fms])
        | (PairList [Forall(_,p), & fms]): funcs(fs)(PairList [p, & fms])
        | (PairList [Exists(_,p), & fms]): funcs(fs)(PairList [p, & fms])
      funcs(Name_arity.Set.empty)(PairList [fm])

    fun functionNames(fm):
      fun funcs_2(fs):
        fun
        | (PairList []): fs
        | (PairList [True(), & fms]): funcs_2(fs)(fms)
        | (PairList [False(), & fms]): funcs_2(fs)(fms)
        | (PairList [AtomValue(atm), & fms]): funcs_2(Name.Set.union(Atom.functionNames(atm))(fs))(fms)
        | (PairList [Not(p), & fms]): funcs_2(fs)(PairList [p, & fms])
        | (PairList [And(p,q), & fms]): funcs_2(fs)(PairList [p, q, & fms])
        | (PairList [Or(p,q), & fms]): funcs_2(fs)(PairList [p, q, & fms])
        | (PairList [Imp(p,q), & fms]): funcs_2(fs)(PairList [p, q, & fms])
        | (PairList [Iff(p,q), & fms]): funcs_2(fs)(PairList [p, q, & fms])
        | (PairList [Forall(_,p), & fms]): funcs_2(fs)(PairList [p, & fms])
        | (PairList [Exists(_,p), & fms]): funcs_2(fs)(PairList [p, & fms])
      funcs_2(Name.Set.empty)(PairList [fm])

    fun relations(fm):
      fun rels(fs):
        fun
        | (PairList []): fs
        | (PairList [True(), & fms]): rels(fs)(fms)
        | (PairList [False(), & fms]): rels(fs)(fms)
        | (PairList [AtomValue(atm), & fms]): rels(Name_arity.Set.add(fs)(Atom.relation(atm)))(fms)
        | (PairList [Not(p), & fms]): rels(fs)(PairList [p, & fms])
        | (PairList [And(p,q), & fms]): rels(fs)(PairList [p, q, & fms])
        | (PairList [Or(p,q), & fms]): rels(fs)(PairList [p, q, & fms])
        | (PairList [Imp(p,q), & fms]): rels(fs)(PairList [p, q, & fms])
        | (PairList [Iff(p,q), & fms]): rels(fs)(PairList [p, q, & fms])
        | (PairList [Forall(_,p), & fms]): rels(fs)(PairList [p, & fms])
        | (PairList [Exists(_,p), & fms]): rels(fs)(PairList [p, & fms])
      rels(Name_arity.Set.empty)(PairList [fm])

    fun relationNames(fm):
      fun rels_2(fs):
        fun
        | (PairList []): fs
        | (PairList [True(), & fms]): rels_2(fs)(fms)
        | (PairList [False(), & fms]): rels_2(fs)(fms)
        | (PairList [AtomValue(atm), & fms]): rels_2(Name.Set.add(fs)(Atom.name(atm)))(fms)
        | (PairList [Not(p), & fms]): rels_2(fs)(PairList [p, & fms])
        | (PairList [And(p,q), & fms]): rels_2(fs)(PairList [p, q, & fms])
        | (PairList [Or(p,q), & fms]): rels_2(fs)(PairList [p, q, & fms])
        | (PairList [Imp(p,q), & fms]): rels_2(fs)(PairList [p, q, & fms])
        | (PairList [Iff(p,q), & fms]): rels_2(fs)(PairList [p, q, & fms])
        | (PairList [Forall(_,p), & fms]): rels_2(fs)(PairList [p, & fms])
        | (PairList [Exists(_,p), & fms]): rels_2(fs)(PairList [p, & fms])
      rels_2(Name.Set.empty)(PairList [fm])

    fun destAtom
    | destAtom(AtomValue(atm)): atm
    | destAtom(_): failwith("Formula.destAtom")

    def isAtom = can(destAtom)

    fun destNeg
    | destNeg(Not(p)): p
    | destNeg(_): failwith("Formula.destNeg")

    def isNeg = can(destNeg)

    def stripNeg:
      fun strip(n):
        fun
        | (Not(fm)): strip(Host.hol_add(n)(1))(fm)
        | (fm): [n, fm]
      strip(0)

    fun listMkConj(fms):
      match Host.OCamlList.rev(fms)
      | PairList []: True()
      | PairList [fm, & fms]: Mlist.foldl((fun([x, y]): And(x, y)))(fm)(fms)

    def stripConj:
      fun strip_2(cs):
        fun
        | (And(p,q)): strip_2(PairList [p, & cs])(q)
        | (fm): Host.OCamlList.rev(PairList [fm, & cs])
      fun
      | (True()): PairList []
      | (fm): strip_2(PairList [])(fm)

    def flattenConj:
      fun flat_2(acc):
        fun
        | (PairList []): acc
        | (PairList [And(p,q), & fms]): flat_2(acc)(PairList [q, p, & fms])
        | (PairList [True(), & fms]): flat_2(acc)(fms)
        | (PairList [fm, & fms]): flat_2(PairList [fm, & acc])(fms)
      (fun(fm): flat_2(PairList [])(PairList [fm]))

    fun listMkDisj(fms):
      match Host.OCamlList.rev(fms)
      | PairList []: False()
      | PairList [fm, & fms]: Mlist.foldl((fun([x, y]): Or(x, y)))(fm)(fms)

    def stripDisj:
      fun strip_3(cs):
        fun
        | (Or(p,q)): strip_3(PairList [p, & cs])(q)
        | (fm): Host.OCamlList.rev(PairList [fm, & cs])
      fun
      | (False()): PairList []
      | (fm): strip_3(PairList [])(fm)

    def flattenDisj:
      fun flat_3(acc):
        fun
        | (PairList []): acc
        | (PairList [Or(p,q), & fms]): flat_3(acc)(PairList [q, p, & fms])
        | (PairList [False(), & fms]): flat_3(acc)(fms)
        | (PairList [fm, & fms]): flat_3(PairList [fm, & acc])(fms)
      (fun(fm): flat_3(PairList [])(PairList [fm]))

    fun listMkEquiv(fms):
      match Host.OCamlList.rev(fms)
      | PairList []: True()
      | PairList [fm, & fms]: Mlist.foldl((fun([x, y]): Iff(x, y)))(fm)(fms)

    def stripEquiv:
      fun strip_4(cs):
        fun
        | (Iff(p,q)): strip_4(PairList [p, & cs])(q)
        | (fm): Host.OCamlList.rev(PairList [fm, & cs])
      fun
      | (True()): PairList []
      | (fm): strip_4(PairList [])(fm)

    def flattenEquiv:
      fun flat_4(acc):
        fun
        | (PairList []): acc
        | (PairList [Iff(p,q), & fms]): flat_4(acc)(PairList [q, p, & fms])
        | (PairList [True(), & fms]): flat_4(acc)(fms)
        | (PairList [fm, & fms]): flat_4(PairList [fm, & acc])(fms)
      (fun(fm): flat_4(PairList [])(PairList [fm]))

    fun destForall
    | destForall(Forall(v,f)): [v, f]
    | destForall(_): failwith("destForall")

    def isForall = can(destForall)

    fun listMkForall
    | listMkForall([PairList [], body]): body
    | listMkForall([PairList [v, & vs], body]): Forall(v, listMkForall([vs, body]))

    fun setMkForall([vs, body]): Name.Set.foldr((fun([x, y]): Forall(x, y)))(body)(vs)

    def stripForall:
      fun strip_5(vs):
        fun
        | (Forall(v,b)): strip_5(PairList [v, & vs])(b)
        | (tm): [Host.OCamlList.rev(vs), tm]
      strip_5(PairList [])

    fun destExists
    | destExists(Exists(v,f)): [v, f]
    | destExists(_): failwith("destExists")

    def isExists = can(destExists)

    fun listMkExists
    | listMkExists([PairList [], body]): body
    | listMkExists([PairList [v, & vs], body]): Exists(v, listMkExists([vs, body]))

    fun setMkExists([vs, body]): Name.Set.foldr((fun([x, y]): Exists(x, y)))(body)(vs)

    def stripExists:
      fun strip_6(vs):
        fun
        | (Exists(v,b)): strip_6(PairList [v, & vs])(b)
        | (tm): [Host.OCamlList.rev(vs), tm]
      strip_6(PairList [])

    fun symbols(fm):
      fun sz(n):
        fun
        | (PairList []): n
        | (PairList [True(), & fms]): sz(Host.hol_add(n)(1))(fms)
        | (PairList [False(), & fms]): sz(Host.hol_add(n)(1))(fms)
        | (PairList [AtomValue(atm), & fms]): sz(Host.hol_add(n)(Atom.symbols(atm)))(fms)
        | (PairList [Not(p), & fms]): sz(Host.hol_add(n)(1))(PairList [p, & fms])
        | (PairList [And(p,q), & fms]): sz(Host.hol_add(n)(1))(PairList [p, q, & fms])
        | (PairList [Or(p,q), & fms]): sz(Host.hol_add(n)(1))(PairList [p, q, & fms])
        | (PairList [Imp(p,q), & fms]): sz(Host.hol_add(n)(1))(PairList [p, q, & fms])
        | (PairList [Iff(p,q), & fms]): sz(Host.hol_add(n)(1))(PairList [p, q, & fms])
        | (PairList [Forall(_,p), & fms]): sz(Host.hol_add(n)(1))(PairList [p, & fms])
        | (PairList [Exists(_,p), & fms]): sz(Host.hol_add(n)(1))(PairList [p, & fms])
      sz(0)(PairList [fm])

    curried fun compare_impl(fm1, fm2):
      fun cmp
      | cmp(PairList []): 0
      | cmp(PairList [[f1, f2] as f1_f2, & fs]):
          if Host.hol_physical_equal(f1)(f2)
          | cmp(fs)
          | match f1_f2
            | [True(), True()]: cmp(fs)
            | [True(), _]: -1
            | [_, True()]: 1
            | [False(), False()]: cmp(fs)
            | [False(), _]: -1
            | [_, False()]: 1
            | [AtomValue(atm1), AtomValue(atm2)]:
                let c = Atom.compare(atm1)(atm2)
                (if Host.hol_unequal(c)(0) | c | cmp(fs))
            | [AtomValue(_), _]: -1
            | [_, AtomValue(_)]: 1
            | [Not(p1), Not(p2)]: cmp(PairList [[p1, p2], & fs])
            | [Not(_), _]: -1
            | [_, Not(_)]: 1
            | [And(p1,q1), And(p2,q2)]: cmp(PairList [[p1, p2], [q1, q2], & fs])
            | [And(_,_), _]: -1
            | [_, And(_,_)]: 1
            | [Or(p1,q1), Or(p2,q2)]: cmp(PairList [[p1, p2], [q1, q2], & fs])
            | [Or(_,_), _]: -1
            | [_, Or(_,_)]: 1
            | [Imp(p1,q1), Imp(p2,q2)]: cmp(PairList [[p1, p2], [q1, q2], & fs])
            | [Imp(_,_), _]: -1
            | [_, Imp(_,_)]: 1
            | [Iff(p1,q1), Iff(p2,q2)]: cmp(PairList [[p1, p2], [q1, q2], & fs])
            | [Iff(_,_), _]: -1
            | [_, Iff(_,_)]: 1
            | [Forall(v1,p1), Forall(v2,p2)]:
                let c = Name.compare(v1)(v2)
                (if Host.hol_unequal(c)(0) | c | cmp(PairList [[p1, p2], & fs]))
            | [Forall(_,_), Exists(_,_)]: -1
            | [Exists(_,_), Forall(_,_)]: 1
            | [Exists(v1,p1), Exists(v2,p2)]:
                let c = Name.compare(v1)(v2)
                (if Host.hol_unequal(c)(0) | c | cmp(PairList [[p1, p2], & fs]))
      cmp(PairList [[fm1, fm2]])

    curried fun equal(fm1, fm2): Host.hol_equal(compare_impl(fm1, fm2))(0)

    fun freeIn(v):
      fun f
      | f(PairList []): #false
      | f(PairList [True(), & fms]): f(fms)
      | f(PairList [False(), & fms]): f(fms)
      | f(PairList [AtomValue(atm), & fms]): (Atom.freeIn(v)(atm) || f(fms))
      | f(PairList [Not(p), & fms]): f(PairList [p, & fms])
      | f(PairList [And(p,q), & fms]): f(PairList [p, q, & fms])
      | f(PairList [Or(p,q), & fms]): f(PairList [p, q, & fms])
      | f(PairList [Imp(p,q), & fms]): f(PairList [p, q, & fms])
      | f(PairList [Iff(p,q), & fms]): f(PairList [p, q, & fms])
      | f(PairList [Forall(w,p), & fms]): (if Name.equal(v)(w) | f(fms) | f(PairList [p, & fms]))
      | f(PairList [Exists(w,p), & fms]): (if Name.equal(v)(w) | f(fms) | f(PairList [p, & fms]))
      (fun(fm): f(PairList [fm]))

    fun add([fm, vs]):
      fun fv(vs):
        fun
        | (PairList []): vs
        | (PairList [[_, True()], & fms]): fv(vs)(fms)
        | (PairList [[_, False()], & fms]): fv(vs)(fms)
        | (PairList [[bv, AtomValue(atm)], & fms]): fv(Name.Set.union(vs)(Name.Set.difference(Atom.freeVars(atm))(bv)))(fms)
        | (PairList [[bv, Not(p)], & fms]): fv(vs)(PairList [[bv, p], & fms])
        | (PairList [[bv, And(p,q)], & fms]): fv(vs)(PairList [[bv, p], [bv, q], & fms])
        | (PairList [[bv, Or(p,q)], & fms]): fv(vs)(PairList [[bv, p], [bv, q], & fms])
        | (PairList [[bv, Imp(p,q)], & fms]): fv(vs)(PairList [[bv, p], [bv, q], & fms])
        | (PairList [[bv, Iff(p,q)], & fms]): fv(vs)(PairList [[bv, p], [bv, q], & fms])
        | (PairList [[bv, Forall(v,p)], & fms]): fv(vs)(PairList [[Name.Set.add(bv)(v), p], & fms])
        | (PairList [[bv, Exists(v,p)], & fms]): fv(vs)(PairList [[Name.Set.add(bv)(v), p], & fms])
      fv(vs)(PairList [[Name.Set.empty, fm]])

    fun freeVars(fm): add([fm, Name.Set.empty])

    fun freeVarsList(fms): Mlist.foldl(add)(Name.Set.empty)(fms)

    fun specialize(fm): snd(stripForall(fm))

    fun generalize(fm): listMkForall([Name.Set.toList(freeVars(fm)), fm])

    curried fun substCheck(sub, fm): (if Substitute.null(sub) | fm | substFm(sub, fm))

    curried fun substFm(sub, fm):
      match fm
      | True(): fm
      | False(): fm
      | AtomValue([p, tms]):
          let tms_prime = Host.OCamlList.map(Substitute.subst(sub))(tms)
          (if Host.hol_physical_equal(tms)(tms_prime) | fm | AtomValue([p, tms_prime]))
      | Not(p):
          let p_prime = substFm(sub, p)
          (if Host.hol_physical_equal(p)(p_prime) | fm | Not(p_prime))
      | And(p,q): substConn(sub, fm, (fun([x, y]): And(x, y)), p, q)
      | Or(p,q): substConn(sub, fm, (fun([x, y]): Or(x, y)), p, q)
      | Imp(p,q): substConn(sub, fm, (fun([x, y]): Imp(x, y)), p, q)
      | Iff(p,q): substConn(sub, fm, (fun([x, y]): Iff(x, y)), p, q)
      | Forall(v,p): substQuant(sub, fm, (fun([x, y]): Forall(x, y)), v, p)
      | Exists(v,p): substQuant(sub, fm, (fun([x, y]): Exists(x, y)), v, p)

    curried fun substConn(sub, fm, conn, p, q):
      let p_prime_2 = substFm(sub, p)
      let q_prime_2 = substFm(sub, q)
      (if (Host.hol_physical_equal(p)(p_prime_2) && Host.hol_physical_equal(q)(q_prime_2)) | fm | conn([p_prime_2, q_prime_2]))

    curried fun substQuant(sub, fm, quant, v, p):
      let f_2:
        fun([w, s]):
          if Name.equal(w)(v)
          | s
          | match Substitute.peek(sub)(w)
            | Host.None(): Name.Set.add(s)(w)
            | Host.Some(tm): Name.Set.union(s)(Term.freeVars(tm))
      let vars = freeVars(p)
      let vars = Name.Set.foldl(f_2)(Name.Set.empty)(vars)
      let v_prime = Term.variantPrime(vars)(v)
      let sub = (if Name.equal(v)(v_prime) | Substitute.remove(sub)(Name.Set.singleton(v)) | Substitute.insert(sub)([v, Term.Var(v_prime)]))
      let p_prime = substCheck(sub, p)
      (if (Name.equal(v)(v_prime) && Host.hol_physical_equal(p)(p_prime)) | fm | quant([v_prime, p_prime]))

    def subst = substCheck

    fun mkEq(a_b): AtomValue(Atom.mkEq(a_b))

    fun destEq(fm): Atom.destEq(destAtom(fm))

    def isEq = can(destEq)

    fun mkNeq(a_b): Not(mkEq(a_b))

    fun destNeq
    | destNeq(Not(fm)): destEq(fm)
    | destNeq(_): failwith("Formula.destNeq")

    def isNeq = can(destNeq)

    fun mkRefl(tm): AtomValue(Atom.mkRefl(tm))

    fun destRefl(fm): Atom.destRefl(destAtom(fm))

    def isRefl = can(destRefl)

    fun sym(fm): AtomValue(Atom.sym(destAtom(fm)))

    fun lhs(fm): fst(destEq(fm))

    fun rhs(fm): snd(destEq(fm))

    def truthName = Name.fromString("T")

    def falsityName = Name.fromString("F")

    def conjunctionName = Name.fromString("/\\")

    def disjunctionName = Name.fromString("\\/")

    def implicationName = Name.fromString("==>")

    def equivalenceName = Name.fromString("<=>")

    def universalName = Name.fromString("!")

    def existentialName = Name.fromString("?")

    fun demote
    | demote(True()): Term.Fn([truthName, PairList []])
    | demote(False()): Term.Fn([falsityName, PairList []])
    | demote(AtomValue([p, tms])): Term.Fn([p, tms])
    | demote(Not(p)):
        let s = "~"
        Term.Fn([Name.fromString(s), PairList [demote(p)]])
    | demote(And(p,q)): Term.Fn([conjunctionName, PairList [demote(p), demote(q)]])
    | demote(Or(p,q)): Term.Fn([disjunctionName, PairList [demote(p), demote(q)]])
    | demote(Imp(p,q)): Term.Fn([implicationName, PairList [demote(p), demote(q)]])
    | demote(Iff(p,q)): Term.Fn([equivalenceName, PairList [demote(p), demote(q)]])
    | demote(Forall(v,b)): Term.Fn([universalName, PairList [Term.Var(v), demote(b)]])
    | demote(Exists(v,b)): Term.Fn([existentialName, PairList [Term.Var(v), demote(b)]])

    fun toString(fm): Term.toString(demote(fm))

    curried fun add_asms(asms, goal): (if Mlist.null(asms) | goal | Imp(listMkConj(Host.OCamlList.rev(asms)), goal))

    curried fun add_var_asms(asms, v, goal): add_asms(asms, Forall(v, goal))

    curried fun split(asms, pol, fm):
      match [pol, fm]
      | [#true, True()]: PairList []
      | [#true, Not(f)]: split(asms, #false, f)
      | [#true, And(f1,f2)]: append(split(asms, #true, f1))(split(PairList [f1, & asms], #true, f2))
      | [#true, Or(f1,f2)]: split(PairList [Not(f1), & asms], #true, f2)
      | [#true, Imp(f1,f2)]: split(PairList [f1, & asms], #true, f2)
      | [#true, Iff(f1,f2)]: append(split(PairList [f1, & asms], #true, f2))(split(PairList [f2, & asms], #true, f1))
      | [#true, Forall(v,f)]: Host.OCamlList.map(add_var_asms(asms, v))(split(PairList [], #true, f))
      | [#false, False()]: PairList []
      | [#false, Not(f)]: split(asms, #true, f)
      | [#false, And(f1,f2)]: split(PairList [f1, & asms], #false, f2)
      | [#false, Or(f1,f2)]: append(split(asms, #false, f1))(split(PairList [Not(f1), & asms], #false, f2))
      | [#false, Imp(f1,f2)]: append(split(asms, #true, f1))(split(PairList [f1, & asms], #false, f2))
      | [#false, Iff(f1,f2)]: append(split(PairList [f1, & asms], #false, f2))(split(PairList [Not(f2), & asms], #true, f1))
      | [#false, Exists(v,f)]: Host.OCamlList.map(add_var_asms(asms, v))(split(PairList [], #false, f))
      | _: PairList [add_asms(asms)((if pol | fm | Not(fm)))]

    fun splitGoal(fm): split(PairList [], #true, fm)

    namespace Ordered:
      export:
        compare

      def compare_impl_2 = compare_impl

      def compare = compare_impl_2

    namespace Map:
      export:
        Ma
        newMap
        null
        singleton
        size
        get
        peek
        insert
        toList
        fromList
        foldl
        foldr
        filter
        inDomain
        union
        delete
        mapPartial
        transform
        exists

      // OCaml 4.14.1 Map.Make; Copyright 1996 INRIA, Xavier Leroy.
      // LGPL 2.1 with OCaml linking exception; see tools/translate/stdlib.
      namespace Ma:
        export:
          TNode
          Empty
          Node
          height
          create
          singleton
          bal
          empty
          is_empty
          add
          find
          mem
          min_binding
          remove_min_binding
          merge
          remove
          map
          fold
          exists
