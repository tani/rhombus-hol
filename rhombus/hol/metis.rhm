      | treePeekKey(compareKey, pkey, left)
      | (if Host.hol_equal(c)(0) | Host.Some([key, value]) | treePeekKey(compareKey, pkey, right))

    curried fun treeInsert(compareKey, key_value, tree):
      let [key, value] = key_value
      let [path, inode] = treePeekPath(compareKey, key, PairList [], tree)
      match inode
      | Host.None():
          let node = nodeSingleton([key, value])
          insertNodePath(node)(path)
      | Host.Some(node):
          let Node(size,priority,left,_,_,right) = node
          let node = Node(size, priority, left, key, value, right)
          updateTreePath(Tree(node))(path)

    curried fun treeDelete(compareKey, dkey, tree):
      match tree
      | Empty(): Host.hol_raise(Useful.Bug("Map.delete: element not found"))
      | Tree(node): nodeDelete(compareKey, dkey, node)

    curried fun nodeDelete(compareKey, dkey, node):
      let Node(size,priority,left,key,value,right) = node
