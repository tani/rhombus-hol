        Empty
        Node
        height
        create
        bal
        add
        singleton
        add_min_element
        add_max_element
        join
        min_elt
        remove_min_elt
        rename merge_impl as merge
        concat
        split
        empty
        is_empty
        rename mem_impl as mem
        rename remove_impl as remove
        rename union_impl as union
        inter
        Found
        NotFound
        diff
        End
        More
        cons_enum
        compare_aux
        rename compare_impl_2 as compare
        rename equal_impl as equal
        rename subset_impl as subset
