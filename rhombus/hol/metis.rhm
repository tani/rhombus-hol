      clauseStrictlySubsumes

    fun findRest(pred):
      fun f(ys):
        fun
        | (PairList []): Host.None()
        | (PairList [x, & xs]): (if pred(x) | Host.Some([x, Host.OCamlList.rev_append(ys)(xs)]) | f(PairList [x, & ys])(xs))
      f(PairList [])

    fun addSym([lit, acc]):
      match Useful.total(Literal.sym)(lit)
      | Host.None(): acc
      | Host.Some(lit): PairList [lit, & acc]

    fun clauseSym(lits): Mlist.foldl(addSym)(lits)(lits)

    fun sortClause(cl):
      let lits = Literal.Set.toList(cl)
      Mlist.sortMap(Literal.typedSymbols)(Useful.revCompare(Useful.intCompare))(lits)

    fun incompatible(lit):
      let lits = clauseSym(PairList [lit])
      (fun(lit_prime): Host.hol_not(Host.OCamlList.exists(can(Literal.unify(Substitute.empty)(lit_prime)))(lits)))

    curried fun idCompare([id1, len1], [id2, len2]):
      let c = Useful.intCompare(len1)(len2)
      (if Host.hol_unequal(c)(0) | c | Useful.intCompare(id1)(id2))

    def idSetEmpty = Pset.empty(idCompare)

    fun idSetAdd([id_len, set]): Pset.add(set)(id_len)

    curried fun idSetAddMax(max, [[_, len] as id_len, set]): (if Host.hol_le(len)(max) | Pset.add(set)(id_len) | set)

    curried fun idSetIntersect(set1, set2): Pset.intersect(set1)(set2)

    record NonunitT(nextId, clauses, fstLits, sndLits)

    record Subsume(empty, unitn, nonunit)

    fun newSubsume(_):
      Subsume(
        PairList [],
        Literal_net.newNet(Term_net.Parameters(#false)),
        NonunitT(
          0,
          Host.hol_apply_unit(Intmap.newMap),
          Literal_net.newNet(Term_net.Parameters(#false)),
          Literal_net.newNet(Term_net.Parameters(#false))
        )
      )

    fun size(Subsume(empty,unitn,NonunitT(_,clauses,_,_))): Host.hol_add(Host.hol_add(length(empty))(Literal_net.size(unitn)))(Intmap.size(clauses))

    curried fun insert_impl(Subsume(empty,unitn,nonunit), [cl_prime, a]):
      match sortClause(cl_prime)
      | PairList []:
          let empty = PairList [[cl_prime, Substitute.empty, a], & empty]
          Subsume(empty, unitn, nonunit)
      | PairList [lit, & PairList []]:
          let unitn = Literal_net.insert(unitn)([lit, [lit, cl_prime, a]])
          Subsume(empty, unitn, nonunit)
      | PairList [fstLit, & PairList [sndLit, & otherLits] as nonFstLits]:
          let NonunitT(nextId,clauses,fstLits,sndLits) = nonunit
          let id_length = [nextId, Literal.Set.size(cl_prime)]
          let fstLits = Literal_net.insert(fstLits)([fstLit, id_length])
          let [sndLit, otherLits]:
            match findRest(incompatible(fstLit))(nonFstLits)
            | Host.Some(sndLit_otherLits): sndLit_otherLits
            | Host.None(): [sndLit, otherLits]
          let sndLits = Literal_net.insert(sndLits)([sndLit, id_length])
          let lits_prime = append(otherLits)(PairList [fstLit, sndLit])
          let clauses = Intmap.insert(clauses)([nextId, [lits_prime, cl_prime, a]])
          let nextId = Host.hol_add(nextId)(1)
          let nonunit = NonunitT(nextId, clauses, fstLits, sndLits)
          Subsume(empty, unitn, nonunit)

    curried fun filter_impl(pred, Subsume(empty,unitn,nonunit)):
      let pred3 = (fun([_, _, x]): pred(x))
      let empty = Host.OCamlList.filter(pred3)(empty)
      let unitn = Literal_net.filter(pred3)(unitn)
      let NonunitT(nextId,clauses,fstLits,sndLits) = nonunit
      let clauses_prime = Intmap.filter((fun(x): pred3(snd(x))))(clauses)
      let nonunit:
        if Host.hol_equal(Intmap.size(clauses))(Intmap.size(clauses_prime))
        | nonunit
        | let predId = (fun([id, _]): Intmap.inDomain(id)(clauses_prime))
          let fstLits_2 = Literal_net.filter(predId)(fstLits)
          let sndLits_2 = Literal_net.filter(predId)(sndLits)
          NonunitT(nextId, clauses_prime, fstLits_2, sndLits_2)
      Subsume(empty, unitn, nonunit)

    fun toString(subsume): Host.hol_concat("Subsume{")(Host.hol_concat(Host.hol_string_of_int(size(subsume)))("}"))

    curried fun matchLit(lit_prime, [lit, acc]):
      match Useful.total(Literal.matchLiterals(Substitute.empty)(lit_prime))(lit)
      | Host.Some(sub): PairList [sub, & acc]
      | Host.None(): acc

    curried fun genClauseSubsumes(pred, cl_prime, lits_prime, cl, a):
      fun mkSubsl(acc):
        fun(sub):
          fun
          | (PairList []): Host.Some([sub, Mlist.sortMap(length)(Useful.intCompare)(acc)])
          | (PairList [lit_prime, & lits_prime]):
              match Mlist.foldl(matchLit(lit_prime))(PairList [])(cl)
              | PairList []: Host.None()
              | PairList [sub_prime, & PairList []]:
                  match Useful.total(Substitute.union(sub))(sub_prime)
                  | Host.None(): Host.None()
                  | Host.Some(sub): mkSubsl(acc)(sub)(lits_prime)
              | subs: mkSubsl(PairList [subs, & acc])(sub)(lits_prime)
      fun search
      | search(PairList []): Host.None()
      | search(PairList [[sub, PairList []], & others]):
          let x = [cl_prime, sub, a]
          (if pred(x) | Host.Some(x) | search(others))
      | search(PairList [[_, PairList [PairList [], & _]], & others]): search(others)
      | search(PairList [[sub, PairList [PairList [sub_prime, & subs], & subsl]], & others]):
          let others = PairList [[sub, PairList [subs, & subsl]], & others]
          match Useful.total(Substitute.union(sub))(sub_prime)
          | Host.None(): search(others)
          | Host.Some(sub): search(PairList [[sub, subsl], & others])
      match mkSubsl(PairList [])(Substitute.empty)(lits_prime)
      | Host.None(): Host.None()
      | Host.Some(sub_subsl): search(PairList [sub_subsl])

    curried fun emptySubsumes(pred, empty): Mlist.find(pred)(empty)

    curried fun unitSubsumes(pred, unitn):
      let subLit:
        fun(lit):
          let subUnit:
            fun([lit_prime, cl_prime, a]):
              match Useful.total(Literal.matchLiterals(Substitute.empty)(lit_prime))(lit)
              | Host.None(): Host.None()
              | Host.Some(sub):
                  let x = [cl_prime, sub, a]
                  (if pred(x) | Host.Some(x) | Host.None())
          Mlist.first(subUnit)(Literal_net.matchNet(unitn)(lit))
      Mlist.first(subLit)

    curried fun nonunitSubsumes(pred, nonunit, max, cl):
      let addId:
        match max
        | Host.None(): idSetAdd
        | Host.Some(n): idSetAddMax(n)
      let subLit = (fun(lits): (fun([lit, acc]): Mlist.foldl(addId)(acc)(Literal_net.matchNet(lits)(lit))))
      let NonunitT(_,clauses,fstLits,sndLits) = nonunit
      let subCl_prime:
        fun([id, _]):
          let [lits_prime, cl_prime, a_2] = Intmap.get(clauses)(id)
          genClauseSubsumes(pred, cl_prime, lits_prime, cl, a_2)
      let fstCands = Mlist.foldl(subLit(fstLits))(idSetEmpty)(cl)
      let sndCands = Mlist.foldl(subLit(sndLits))(idSetEmpty)(cl)
      let cands = idSetIntersect(fstCands, sndCands)
      Pset.firstl(subCl_prime)(cands)

    curried fun genSubsumes(pred, Subsume(empty,unitn,nonunit), max, cl):
      match emptySubsumes(pred, empty)
      | Host.Some(_) as s: s
      | Host.None():
          if Host.hol_equal(max)(Host.Some(0))
          | Host.None()
          | let cl = clauseSym(Literal.Set.toList(cl))
            match unitSubsumes(pred, unitn)(cl)
            | Host.Some(_) as s: s
            | Host.None(): (if Host.hol_equal(max)(Host.Some(1)) | Host.None() | nonunitSubsumes(pred, nonunit, max, cl))

    curried fun subsumes(pred, subsume, cl): genSubsumes(pred, subsume, Host.None(), cl)

    curried fun strictlySubsumes(pred, subsume, cl): genSubsumes(pred)(subsume)(Host.Some(Literal.Set.size(cl)))(cl)

    curried fun isSubsumed(subs, cl): Option.is_some(subsumes(K(#true), subs, cl))

    curried fun isStrictlySubsumed(subs, cl): Option.is_some(strictlySubsumes(K(#true), subs, cl))

    curried fun clauseSubsumes(cl_prime, cl):
      let lits_prime_2 = sortClause(cl_prime)
      let lits_2 = clauseSym(Literal.Set.toList(cl))
      match Host.hol_apply_unit(genClauseSubsumes(K(#true))(cl_prime)(lits_prime_2)(lits_2))
      | Host.Some([_, sub, #void]): Host.Some(sub)
      | Host.None(): Host.None()

    curried fun clauseStrictlySubsumes(cl_prime, cl): (if Host.hol_gt(Literal.Set.size(cl_prime))(Literal.Set.size(cl)) | Host.None() | clauseSubsumes(cl_prime, cl))

    def insert = insert_impl

    def filter = filter_impl

  namespace Knuth_bendix_order:
    export:
      notEqualTerm
      firstNotEqualTerm
      Kbo
      uniformWeight
      arityPrecedence
      default
      Weight
      weightEmpty
      weightZero
      weightIsZero
      weightNeg
      add
      weightAdd
      weightSubtract
      weightTerm
      weightLowerBound
      compare

    fun notEqualTerm([x, y]): Host.hol_not(Term.equal(x)(y))

    curried fun firstNotEqualTerm(f, l):
      match Mlist.find(notEqualTerm)(l)
      | Host.Some([x, y]): f(x)(y)
      | Host.None(): Host.hol_raise(Useful.Bug("firstNotEqualTerm"))

    record Kbo(weight, precedence)

    def uniformWeight = K(1)

    curried fun arityPrecedence([f1, n1], [f2, n2]):
      let c = Useful.intCompare(n1)(n2)
      (if Host.hol_unequal(c)(0) | c | Name.compare(f1)(f2))

    def default = Kbo(uniformWeight, arityPrecedence)

    variant weight:
      Weight(symbols, constant)

    def weightEmpty = Host.hol_apply_unit(Name.Map.newMap)

    def weightZero = Weight(weightEmpty, 0)

    fun weightIsZero(Weight(m,c)): (Host.hol_equal(c)(0) && Name.Map.null(m))

    fun weightNeg(Weight(m,c)): Weight(Name.Map.transform((fun(x): Host.hol_neg(x)))(m), Host.hol_neg(c))

    fun add([[_, n1], [_, n2]]):
      let n = Host.hol_add(n1)(n2)
      (if Host.hol_equal(n)(0) | Host.None() | Host.Some(n))

    curried fun weightAdd(Weight(m1,c1), Weight(m2,c2)): Weight(Name.Map.union(add)(m1)(m2), Host.hol_add(c1)(c2))

    curried fun weightSubtract(w1, w2): weightAdd(w1)(weightNeg(w2))

    fun weightTerm(weight):
      fun wt(m):
        fun(c):
          fun
          | (PairList []): Weight(m, c)
          | (PairList [Term.Var(v), & tms]):
              let n = Option.value(Name.Map.peek(m)(v))(~default: 0)
              wt(Name.Map.insert(m)([v, Host.hol_add(n)(1)]))(Host.hol_add(c)(1))(tms)
          | (PairList [Term.Fn([f, a]), & tms]): wt(m)(Host.hol_add(c)(weight([f, length(a)])))(append(a)(tms))
      (fun(tm): wt(weightEmpty)(-1)(PairList [tm]))

    fun weightLowerBound(Weight(m,c)): (if Name.Map.exists((fun([_, n]): Host.hol_lt(n)(0)))(m) | Host.None() | Host.Some(c))

    fun compare_impl(Kbo(weight,precedence)):
      let weightDifference:
        fun(tm1):
          fun(tm2):
            let w1_2 = weightTerm(weight)(tm1)
            let w2_2 = weightTerm(weight)(tm2)
            weightSubtract(w2_2, w1_2)
      fun weightLess_2(tm1):
        fun(tm2):
          let w = weightDifference(tm1)(tm2)
          (if weightIsZero(w) | precedenceLess_2(tm1)(tm2) | weightDiffLess_2(w)(tm1)(tm2))
      fun weightDiffLess_2(w):
        fun(tm1):
          fun(tm2):
            match weightLowerBound(w)
            | Host.None(): #false
            | Host.Some(0): precedenceLess_2(tm1)(tm2)
            | Host.Some(n): Host.hol_gt(n)(0)
      fun precedenceLess_2(x):
        fun(y):
          match [x, y]
          | [Term.Fn([f1, a1]), Term.Fn([f2, a2])]:
              let c = precedence([f1, length(a1)])([f2, length(a2)])
              if Host.hol_lt(c)(0)
              | #true
              | (if Host.hol_equal(c)(0) | firstNotEqualTerm(weightLess_2)(zip(a1)(a2)) | #false)
          | _: #false
      let weightDiffGreater = (fun(w): (fun(tm1): (fun(tm2): weightDiffLess_2(weightNeg(w))(tm2)(tm1))))
      fun weightCmp_2(tm1):
        fun(tm2):
          let w = weightDifference(tm1)(tm2)
          if weightIsZero(w)
          | precedenceCmp_2(tm1)(tm2)
          | if weightDiffLess_2(w)(tm1)(tm2)
            | Host.Some(-1)
            | (if weightDiffGreater(w)(tm1)(tm2) | Host.Some(1) | Host.None())
      fun precedenceCmp_2(x):
        fun(y):
          match [x, y]
          | [Term.Fn([f1, a1]), Term.Fn([f2, a2])]:
              let c = precedence([f1, length(a1)])([f2, length(a2)])
              if Host.hol_lt(c)(0)
              | Host.Some(-1)
              | (if Host.hol_equal(c)(0) | firstNotEqualTerm(weightCmp_2)(zip(a1)(a2)) | Host.Some(1))
          | _: Host.hol_raise(Useful.Bug("kboOrder.precendenceCmp"))
      (fun(tm1): (fun(tm2): (if Term.equal(tm1)(tm2) | Host.Some(0) | weightCmp_2(tm1)(tm2))))

    def compare = compare_impl

  namespace Rewrite:
    export:
      Left_to_right
      Right_to_left
      toStringOrient
      toStringOrientOption
      RewriteT
      Rewrite
      updateWaiting
      deleteWaiting
      newRewrite
      peek
      size
      equations
      termReducible
      literalReducible
      literalsReducible
      thmReducible
