        fun merge_v2(f):
          fun(s1):
            fun(s2):
              let subject = [s1, s2]
              match subject
              | [Empty(), Empty()]: Empty()
              | [Node(TNode(l1,v1,d1,r1,h1)), _]:
                  if (h1 >= height(s2))
                  | let [l2, d2, r2] = split(v1)(s2)
