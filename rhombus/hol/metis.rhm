      def included_difference = include_1.difference

      def included_toList = include_1.toList

      def included_singleton = include_1.singleton

      def included_null = include_1.null

      def included_size = include_1.size

      def included_pick = include_1.pick

      def included_equal = include_1.equal

      def included_exists = include_1.exists

      def included_fromList = include_1.fromList

      def included_delete = include_1.delete

      def included_subset = include_1.subset

      def included_intersect = include_1.intersect

      def included_intersectList = include_1.intersectList

      def included_findl = include_1.findl

      def included_firstl = include_1.firstl

      def included_transform = include_1.transform

      def included_all = include_1.all

      def included_count = include_1.count

      fun negateMember(lit): fun(set): included_member(negate(lit))(set)

      def negate_impl:
        let f = (fun([lit, set]): included_add(set)(negate(lit)))
        included_foldl(f)(included_empty)

      def relations:
        let f = (fun([lit, set]): Name_arity.Set.add(set)(relation(lit)))
        included_foldl(f)(Name_arity.Set.empty)

      def functions_impl:
        let f = (fun([lit, set]): Name_arity.Set.union(set)(functions(lit)))
        included_foldl(f)(Name_arity.Set.empty)

      fun freeIn_impl(v): included_exists(freeIn(v))

      def freeVars_impl:
        let f = (fun([lit, set]): Name.Set.union(set)(freeVars(lit)))
        included_foldl(f)(Name.Set.empty)

      def freeVarsList:
        let f = (fun([lits, set]): Name.Set.union(set)(freeVars_impl(lits)))
        Mlist.foldl(f)(Name.Set.empty)

      def symbols_impl:
        let f = (fun([lit, z]): (symbols(lit) + z))
        included_foldl(f)(0)

      def typedSymbols_impl:
        let f = (fun([lit, z]): (typedSymbols(lit) + z))
        included_foldl(f)(0)

      fun subst_impl(sub):
        fun(lits):
          let substLit:
            fun([lit, [eq, lits_prime]]):
              let lit_prime = subst(sub)(lit)
              let eq = (eq && (lit === lit_prime))
              [eq, included_add(lits_prime)(lit_prime)]
          let [eq, lits_prime] = included_foldl(substLit)([#true, included_empty])(lits)
          (if eq | lits | lits_prime)

      fun conjoin(set): Formula.listMkConj(PairList.map(included_toList(set), toFormula))

      fun disjoin(set): Formula.listMkDisj(PairList.map(included_toList(set), toFormula))

      fun toString_impl(cl):
        ("{" +& (hol_string_concat(", ")(PairList.map(included_toList(cl), toString)) +& "}"))

