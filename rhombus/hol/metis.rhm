  namespace Word:
    export:
      rename compare_impl as compare
      shiftLeft
      shiftRight
      minus
      andb
      orb
      xorb
      notb
      toInt
      fromInt

    fun compare_impl(x): fun(y): compare(x)(y)

    fun shiftLeft([x, y]): (x bits.(<<) y)

    fun shiftRight([x, y]): (x bits.(>>) y)

    fun minus([x, y]): (x - y)

    fun andb([x, y]): (x bits.and y)

    fun orb([x, y]): (x bits.or y)

    fun xorb([x, y]): (x bits.xor y)

    fun notb(x): (x bits.xor -1)

    fun toInt(x): x

    fun fromInt(x): x

  namespace Mlist:
    export:
      rename foldl_impl as foldl
      rename foldr_impl as foldr
      null
      tabulate
      rename find_impl as find
      first
      enumerate
      revDivide
      updateNth
      sortMap

    fun foldl_impl(f): fun(a): fun(l): OCamlList.fold_left(fun(acc): fun(x): f([x, acc]))(a)(l)

    fun foldr_impl(f): fun(a): fun(l): OCamlList.fold_right(fun(x): fun(acc): f([x, acc]))(l)(a)

    fun null
    | null(PairList []): #true
    | null(_): #false

    fun tabulate([n, f]):
      fun go(i): (if (i === n) | PairList [] | PairList [f(i), & go((i + 1))])
      go(0)

    fun find_impl(p):
      fun(l):
        try:
          Some(OCamlList.find(p)(l))
          ~catch exn:
            match exn
            | Not_found(): None()
            | exn: (throw exn)

    // Recursive namespace declaration needs a binding for self-reference.
    fun first(f):
      fun(arg):
        match arg
        | PairList []: None()
        | PairList [x, & xs]:
            match f(x)
            | None(): first(f)(xs)
            | s: s

    fun enumerate(l): mapi(fun(x): fun(y): [x, y])(l)

    fun revDivide(l):
      fun(n):
        // Recursive division needs the local definition before its first use.
        fun revDiv(acc):
          fun(arg):
            match arg
            | [l, 0]: [acc, l]
            | [PairList [], _]: (throw InvalidArgument("Metis_prover.Mlist.revDivide"))
            | [PairList [h, & t], n]: revDiv(PairList [h, & acc])([t, (n - 1)])
        revDiv(PairList [])([l, n])

    fun updateNth([n, x]):
      fun(l):
        let [a_2, b] = revDivide(l)(n)
        match b
        | PairList []: (throw InvalidArgument("Metis_prover.Mlist.updateNth"))
        | PairList [_, & t]: OCamlList.rev_append(a_2)(PairList [x, & t])

    fun sortMap(f):
      fun(cmp):
        fun(xs):
          match xs
          | PairList []: PairList []
          | PairList [_, & PairList []] as l: l
          | xs:
              let ncmp = fun([m, _]): fun([n, _]): cmp(m)(n)
              let nxs = PairList.map(xs, (fun(x): [f(x), x]))
              let nys = OCamlList.sort(ncmp)(nxs)
              PairList.map(nys, snd)

  namespace Option:
    export:
      is_some
      bind
      value

    fun is_some
    | is_some(Some(_)): #true
    | is_some(None()): #false

    fun bind(opt):
      fun(f):
        match opt
        | Some(x): f(x)
        | None(): None()

    fun value(opt):
      fun(~default: default):
        match opt
        | Some(x): x
        | None(): default

  namespace Useful:
    export:
      critical
      isDigit
      Bug
      total
      exp
      revCompare
      prodCompare
      lexCompare
