    fun critical(x): x

    fun isDigit(c): (("0" <= c) && (c <= "9"))

    class Bug(message)

    fun total(f):
      fun(x):
        try:
          Some(f(x))
          ~catch exn:
            match exn
            | Failure(_): None()
            | exn: (throw exn)

    fun exp(m):
      // Recursive exponentiation needs the local definition before its first use.
      fun f(x):
        fun(y):
          fun(z):
            match y
            | 0: z
            | _: f(m([x, x]))((y div 2))((if ((y rem 2) == 0) | z | m([z, x])))
      f

    fun revCompare(cmp): fun(x): fun(y): cmp(y)(x)

    fun prodCompare(xCmp):
      fun(yCmp):
        fun([x1, y1]):
          fun([x2, y2]):
            let c = xCmp(x1)(x2)
            (if (c != 0) | c | yCmp(y1)(y2))

    fun lexCompare(cmp):
      // Recursive lexical comparison needs the local definition before its first use.
      fun lex_2(xs):
        fun(ys):
          match [xs, ys]
          | [PairList [], PairList []]: 0
          | [PairList [], PairList [_, & _]]: -1
          | [PairList [_, & _], PairList []]: 1
          | [PairList [x, & xs], PairList [y, & ys]]:
              let c = cmp(x)(y)
              (if (c != 0) | c | lex_2(xs)(ys))
      lex_2

    fun boolCompare(x):
      fun(y):
        match [x, y]
        | [#false, #true]: -1
        | [#true, #false]: 1
        | _: 0

    fun intCompare(x): fun(y): compare(x)(y)

    fun mkPrefix(p): fun(s): (p +& s)

    fun stripSuffix(pred):
      fun(s):
        fun strip(pos):
          if (pos < 0)
          | ""
          | (if pred(to_string(s[pos])) | strip((pos - 1)) | hol_string_sub(s)(0)((pos + 1)))
        strip((s.length() - 1))
    fun interval(m):
      fun(arg):
        match arg
        | 0: PairList []
        | len: PairList [m, & interval((m + 1))((len - 1))]

    fun divides_impl
    | divides_impl([_, 0]): #true
    | divides_impl([0, _]): #false
    | divides_impl([a, b]): ((b rem math.abs(a)) == 0)

    def divides_v2 = curry(divides_impl)

    def generator = Box(0)

    fun newIntThunk(_):
      let n = generator.value
      generator.value := n + 1
      n

    fun newIntsThunk(k):
      fun(_):
        let n = generator.value
        generator.value := n + k
        interval(n)(k)

    fun newInt(_): newIntThunk(#void)

    fun newInts(k): (if (k <= 0) | PairList [] | newIntsThunk(k)(#void))

