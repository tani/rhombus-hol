      Map
      Set

    variant term:
      Var(variable)
      Fn(application)

    fun destVar
    | destVar(Var(v)): v
    | destVar(Fn(_)): failwith("destVar")

    def isVar = can(destVar)

    fun equalVar(v):
      fun
      | (Var(v_prime)): Name.equal(v)(v_prime)
      | (_): #false

    fun destFn
    | destFn(Fn(f)): f
    | destFn(Var(_)): failwith("destFn")

    def isFn = can(destFn)

    fun fnName(tm): fst(destFn(tm))

    fun fnArguments(tm): snd(destFn(tm))

    fun fnArity(tm): Host.OCamlList.length(fnArguments(tm))

    fun fnFunction(tm): [fnName(tm), fnArity(tm)]

    fun functions(tm):
      fun letc(fs):
        fun
        | (PairList []): fs
        | (PairList [Var(_), & tms]): letc(fs)(tms)
        | (PairList [Fn([n, l]), & tms]): letc(Name_arity.Set.add(fs)([n, Host.OCamlList.length(l)]))(append(l)(tms))
      letc(Name_arity.Set.empty)(PairList [tm])

    fun functionNames(tm):
      fun letc_2(fs):
        fun
        | (PairList []): fs
        | (PairList [Var(_), & tms]): letc_2(fs)(tms)
        | (PairList [Fn([n, l]), & tms]): letc_2(Name.Set.add(fs)(n))(append(l)(tms))
      letc_2(Name.Set.empty)(PairList [tm])

    fun mkConst(c): Fn([c, PairList []])

    fun destConst
    | destConst(Fn([c, PairList []])): c
    | destConst(_): failwith("destConst")

    def isConst = can(destConst)

    curried fun mkBinop(f, [a, b]): Fn([f, PairList [a, b]])

    fun destBinop(f):
      fun
      | (Fn([x, PairList [a, & PairList [b, & PairList []]]])): (if Name.equal(x)(f) | [a, b] | failwith("Term.destBinop: wrong binop"))
      | (_): failwith("Term.destBinop: not a binop")

    fun isBinop(f): can(destBinop(f))

    def vAR_SYMBOLS = 1

    def fN_SYMBOLS = 1

    fun symbols(tm):
      fun sz(n):
        fun
        | (PairList []): n
        | (PairList [Var(_), & tms]): sz(Host.hol_add(n)(vAR_SYMBOLS))(tms)
        | (PairList [Fn([letc, args]), & tms]): sz(Host.hol_add(n)(fN_SYMBOLS))(append(args)(tms))
      sz(0)(PairList [tm])

    curried fun compare_impl(tm1, tm2):
      fun cmp
      | cmp([PairList [], PairList []]): 0
      | cmp([PairList [tm1, & tms1], PairList [tm2, & tms2]]):
          if Host.hol_physical_equal(tm1)(tm2)
          | cmp([tms1, tms2])
          | match [tm1, tm2]
            | [Var(v1), Var(v2)]:
                let c = Name.compare(v1)(v2)
                (if Host.hol_unequal(c)(0) | c | cmp([tms1, tms2]))
            | [Var(_), Fn(_)]: -1
            | [Fn(_), Var(_)]: 1
            | [Fn([f1, a1]), Fn([f2, a2])]:
                let c = Name.compare(f1)(f2)
                if Host.hol_unequal(c)(0)
                | c
                | let c = Useful.intCompare(Host.OCamlList.length(a1))(Host.OCamlList.length(a2))
                  (if Host.hol_unequal(c)(0) | c | cmp([append(a1)(tms1), append(a2)(tms2)]))
      | cmp(_): Host.hol_raise(Useful.Bug("Term.compare"))
      cmp([PairList [tm1], PairList [tm2]])

    curried fun equal(tm1, tm2): Host.hol_equal(compare_impl(tm1, tm2))(0)

    fun subterm_prime_impl
    | subterm_prime_impl([tm, PairList []]): tm
    | subterm_prime_impl([Var(_), PairList [_, & _]]): failwith("Term.subterm: Var")
    | subterm_prime_impl([Fn([_, tms]), PairList [h, & t]]): (if Host.hol_ge(h)(Host.OCamlList.length(tms)) | failwith("Term.replace: Fn") | subterm_prime_impl([Host.OCamlList.nth(tms)(h), t]))

    curried fun subterm(s, t): subterm_prime_impl([s, t])

    fun subterms(tm):
      fun subtms
      | subtms([PairList [], acc]): acc
      | subtms([PairList [[path, tm], & rest], acc]):
          let f_2 = (fun([n, arg]): [PairList [n, & path], arg])
          let acc_2 = PairList [[Host.OCamlList.rev(path), tm], & acc]
          match tm
          | Var(_): subtms([rest, acc_2])
          | Fn([_, args]): subtms([append(Host.OCamlList.map(f_2)(Mlist.enumerate(args)))(rest), acc_2])
      subtms([PairList [[PairList [], tm]], PairList []])

    fun replace(tm):
      fun
      | ([PairList [], res]): (if equal(res, tm) | tm | res)
      | ([PairList [h, & t], res]):
          match tm
          | Var(_): failwith("Term.replace: Var")
          | Fn([letc, tms]):
              if Host.hol_ge(h)(Host.OCamlList.length(tms))
              | failwith("Term.replace: Fn")
              | let arg = Host.OCamlList.nth(tms)(h)
                let arg_prime = replace(arg)([t, res])
                (if Host.hol_physical_equal(arg_prime)(arg) | tm | Fn([letc, Mlist.updateNth([h, arg_prime])(tms)]))

    fun find_impl(pred):
      fun search
      | search(PairList []): Host.None()
      | search(PairList [[path, tm], & rest]):
          if pred(tm)
          | Host.Some(Host.OCamlList.rev(path))
          | match tm
            | Var(_): search(rest)
            | Fn([_, a]):
                let subtms_2 = Host.OCamlList.map((fun([i, t]): [PairList [i, & path], t]))(Mlist.enumerate(a))
                search(append(subtms_2)(rest))
      (fun(tm): search(PairList [[PairList [], tm]]))

    curried fun freeIn(v, tm):
      fun free(v):
        fun
        | (PairList []): #false
        | (PairList [Var(w), & tms]): (Name.equal(v)(w) || free(v)(tms))
        | (PairList [Fn([_, args]), & tms]): free(v)(append(args)(tms))
      free(v)(PairList [tm])

    def freeVarsList:
      fun free_2(vs):
        fun
        | (PairList []): vs
        | (PairList [Var(v), & tms]): free_2(Name.Set.add(vs)(v))(tms)
        | (PairList [Fn([_, args]), & tms]): free_2(vs)(append(args)(tms))
      free_2(Name.Set.empty)

    fun freeVars(tm): freeVarsList(PairList [tm])

    fun newVar(_): Var(Host.hol_apply_unit(Name.newName))

    fun newVars(n): Host.OCamlList.map((fun(x): Var(x)))(Name.newNames(n))

    curried fun avoid(av, n): Name.Set.member(n)(av)

    fun variantPrime(av): Name.variantPrime(avoid(av))

    fun variantNum(av): Name.variantNum(avoid(av))

    def hasTypeFunctionName = Name.fromString(":")

    def hasTypeFunction = [hasTypeFunctionName, 2]

    fun destFnHasType([f, a]):
      if Host.hol_not(Name.equal(f)(hasTypeFunctionName))
      | failwith("Term.destFnHasType")
      | match a
        | PairList [tm, & PairList [ty, & PairList []]]: [tm, ty]
        | _: failwith("Term.destFnHasType")

    def isFnHasType = can(destFnHasType)

    fun isTypedVar(tm):
      match tm
      | Var(_): #true
      | Fn(letc):
          match Useful.total(destFnHasType)(letc)
          | Host.Some([Var(_), _]): #true
          | _: #false

    fun typedSymbols(tm):
      fun sz_2(n):
        fun
        | (PairList []): n
        | (PairList [tm, & tms]):
            match tm
            | Var(_): sz_2(Host.hol_add(n)(1))(tms)
            | Fn(letc):
                match Useful.total(destFnHasType)(letc)
                | Host.Some([tm, _]): sz_2(n)(PairList [tm, & tms])
                | Host.None():
                    let [_, a_2] = letc
                    sz_2(Host.hol_add(n)(1))(append(a_2)(tms))
      sz_2(0)(PairList [tm])

    fun nonVarTypedSubterms(tm):
      fun subtms_3
      | subtms_3([PairList [], acc]): acc
      | subtms_3([PairList [[path, tm], & rest], acc]):
          match tm
          | Var(_): subtms_3([rest, acc])
          | Fn(letc):
              match Useful.total(destFnHasType)(letc)
              | Host.Some([t, _]):
                  match t
                  | Var(_): subtms_3([rest, acc])
                  | Fn(_):
                      let acc_3 = PairList [[Host.OCamlList.rev(path), tm], & acc]
                      let rest_2 = PairList [[PairList [0, & path], t], & rest]
                      subtms_3([rest_2, acc_3])
              | Host.None():
                  let f = (fun([n, arg]): [PairList [n, & path], arg])
                  let [_, args] = letc
                  let acc = PairList [[Host.OCamlList.rev(path), tm], & acc]
                  let rest = append(Host.OCamlList.map(f)(Mlist.enumerate(args)))(rest)
                  subtms_3([rest, acc])
      subtms_3([PairList [[PairList [], tm]], PairList []])

    def appName = Name.fromString(".")

    fun mkFnApp([fTm, aTm]): [appName, PairList [fTm, aTm]]

    fun mkApp(f_a): Fn(mkFnApp(f_a))

    fun destFnApp([f, a]):
      if Host.hol_not(Name.equal(f)(appName))
      | failwith("Term.destFnApp")
      | match a
        | PairList [fTm, & PairList [aTm, & PairList []]]: [fTm, aTm]
        | _: failwith("Term.destFnApp")

    def isFnApp = can(destFnApp)

    fun destApp(tm):
      match tm
      | Var(_): failwith("Term.destApp")
      | Fn(letc): destFnApp(letc)

    def isApp = can(destApp)

    fun listMkApp([f, l]): Host.OCamlList.fold_left((fun(acc): (fun(x): mkApp([x, acc]))))(f)(l)

    fun stripApp(tm):
      fun strip(tms):
        fun(tm):
          match Useful.total(destApp)(tm)
          | Host.Some([f, a]): strip(PairList [a, & tms])(f)
          | Host.None(): [tm, tms]
      strip(PairList [])(tm)

    fun toString
    | toString(Var(v)): v
    | toString(Fn([n, PairList []])): n
    | toString(Fn([n, l])):
        Host.hol_concat(n)(
          Host.hol_concat("(")(Host.hol_concat(Host.hol_string_concat(", ")(Host.OCamlList.map(toString)(l)))(")"))
        )

