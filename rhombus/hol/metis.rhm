        record TNode(l, v, r, h)

        variant t:
          Empty()
          Node(node)

        fun height
        | height(Empty()): 0
        | height(Node(TNode(_,_,_,h))): h

        curried fun create(l, v, r):
          let hl:
            match l
            | Empty(): 0
            | Node(TNode(_,_,_,h)): h
          let hr:
            match r
            | Empty(): 0
            | Node(TNode(_,_,_,h)): h
          Node(TNode(l, v, r, (if Host.hol_ge(hl)(hr) | Host.hol_add(hl)(1) | Host.hol_add(hr)(1))))

        curried fun bal(l, v, r):
          let hl:
            match l
            | Empty(): 0
            | Node(TNode(_,_,_,h)): h
          let hr:
            match r
            | Empty(): 0
            | Node(TNode(_,_,_,h)): h
          if Host.hol_gt(hl)(Host.hol_add(hr)(2))
          | match l
            | Empty(): Host.hol_invalid_arg("Set.bal")
            | Node(TNode(ll,lv,lr,_)):
                if Host.hol_ge(height(ll))(height(lr))
                | create(ll)(lv)(create(lr, v, r))
                | match lr
                  | Empty(): Host.hol_invalid_arg("Set.bal")
                  | Node(TNode(lrl,lrv,lrr,_)): create(create(ll, lv, lrl))(lrv)(create(lrr, v, r))
          | if Host.hol_gt(hr)(Host.hol_add(hl)(2))
            | match r
              | Empty(): Host.hol_invalid_arg("Set.bal")
              | Node(TNode(rl,rv,rr,_)):
                  if Host.hol_ge(height(rr))(height(rl))
                  | create(create(l, v, rl), rv, rr)
                  | match rl
                    | Empty(): Host.hol_invalid_arg("Set.bal")
                    | Node(TNode(rll,rlv,rlr,_)): create(create(l, v, rll))(rlv)(create(rlr, rv, rr))
            | Node(TNode(l, v, r, (if Host.hol_ge(hl)(hr) | Host.hol_add(hl)(1) | Host.hol_add(hr)(1))))

        fun add(x):
          fun
          | (Empty()): Node(TNode(Empty(), x, Empty(), 1))
          | (Node(TNode(l,v,r,_)) as t):
              let c = Set_ordered.compare(x)(v)
              if Host.hol_equal(c)(0)
              | t
              | if Host.hol_lt(c)(0)
                | let ll = add(x)(l)
                  (if Host.hol_physical_equal(l)(ll) | t | bal(ll, v, r))
                | let rr = add(x)(r)
                  (if Host.hol_physical_equal(r)(rr) | t | bal(l, v, rr))

        fun singleton(x): Node(TNode(Empty(), x, Empty(), 1))

        fun add_min_element(x):
          fun
          | (Empty()): singleton(x)
          | (Node(TNode(l,v,r,_))): bal(add_min_element(x)(l), v, r)

        fun add_max_element(x):
          fun
          | (Empty()): singleton(x)
          | (Node(TNode(l,v,r,_))): bal(l)(v)(add_max_element(x)(r))

        curried fun join(l, v, r):
          match [l, r]
          | [Empty(), _]: add_min_element(v)(r)
          | [_, Empty()]: add_max_element(v)(l)
          | [Node(TNode(ll,lv,lr,lh)), Node(TNode(rl,rv,rr,rh))]:
              if Host.hol_gt(lh)(Host.hol_add(rh)(2))
              | bal(ll)(lv)(join(lr, v, r))
              | (if Host.hol_gt(rh)(Host.hol_add(lh)(2)) | bal(join(l, v, rl), rv, rr) | create(l, v, r))

        fun min_elt
        | min_elt(Empty()): Host.hol_raise(Host.Not_found())
        | min_elt(Node(TNode(Empty(),v,_,_))): v
        | min_elt(Node(TNode(l,_,_,_))): min_elt(l)

        fun remove_min_elt
        | remove_min_elt(Empty()): Host.hol_invalid_arg("Set.remove_min_elt")
        | remove_min_elt(Node(TNode(Empty(),_,r,_))): r
        | remove_min_elt(Node(TNode(l,v,r,_))): bal(remove_min_elt(l), v, r)

        curried fun merge_impl(t1, t2):
          match [t1, t2]
          | [Empty(), t]: t
          | [t, Empty()]: t
          | [_, _]: bal(t1)(min_elt(t2))(remove_min_elt(t2))

        curried fun concat(t1, t2):
          match [t1, t2]
          | [Empty(), t]: t
          | [t, Empty()]: t
          | [_, _]: join(t1)(min_elt(t2))(remove_min_elt(t2))

        fun split(x):
          fun
          | (Empty()): [Empty(), #false, Empty()]
          | (Node(TNode(l,v,r,_))):
              let c = Set_ordered.compare(x)(v)
              if Host.hol_equal(c)(0)
              | [l, #true, r]
              | if Host.hol_lt(c)(0)
                | let [ll, pres, rl] = split(x)(l)
                  [ll, pres, join(rl, v, r)]
                | let [lr, pres, rr] = split(x)(r)
                  [join(l, v, lr), pres, rr]

        def empty = Empty()

        fun is_empty
        | is_empty(Empty()): #true
        | is_empty(_): #false

        fun mem_impl(x):
          fun
          | (Empty()): #false
          | (Node(TNode(l,v,r,_))):
              let c = Set_ordered.compare(x)(v)
              (Host.hol_equal(c)(0) || mem_impl(x)((if Host.hol_lt(c)(0) | l | r)))

        fun remove_impl(x):
          fun
          | (Empty()): Empty()
          | (Node(TNode(l,v,r,_)) as t):
              let c = Set_ordered.compare(x)(v)
              if Host.hol_equal(c)(0)
              | merge_impl(l, r)
              | if Host.hol_lt(c)(0)
                | let ll = remove_impl(x)(l)
                  (if Host.hol_physical_equal(l)(ll) | t | bal(ll, v, r))
                | let rr = remove_impl(x)(r)
                  (if Host.hol_physical_equal(r)(rr) | t | bal(l, v, rr))

        curried fun union_impl(s1, s2):
          match [s1, s2]
          | [Empty(), t2]: t2
          | [t1, Empty()]: t1
          | [Node(TNode(l1,v1,r1,h1)), Node(TNode(l2,v2,r2,h2))]:
              if Host.hol_ge(h1)(h2)
              | if Host.hol_equal(h2)(1)
                | add(v2)(s1)
                | let [l2, _, r2] = split(v1)(s2)
                  join(union_impl(l1, l2))(v1)(union_impl(r1, r2))
              | if Host.hol_equal(h1)(1)
                | add(v1)(s2)
                | let [l1, _, r1] = split(v2)(s1)
                  join(union_impl(l1, l2))(v2)(union_impl(r1, r2))

        curried fun inter(s1, s2):
          match [s1, s2]
          | [Empty(), _]: Empty()
          | [_, Empty()]: Empty()
          | [Node(TNode(l1,v1,r1,_)), t2]:
              match split(v1)(t2)
              | [l2, #false, r2]: concat(inter(l1, l2))(inter(r1, r2))
              | [l2, #true, r2]: join(inter(l1, l2))(v1)(inter(r1, r2))

        variant split_bis:
          Found()
          NotFound(left, right)

        curried fun diff(s1, s2):
          match [s1, s2]
          | [Empty(), _]: Empty()
          | [t1, Empty()]: t1
          | [Node(TNode(l1,v1,r1,_)), t2]:
              match split(v1)(t2)
              | [l2, #false, r2]: join(diff(l1, l2))(v1)(diff(r1, r2))
              | [l2, #true, r2]: concat(diff(l1, l2))(diff(r1, r2))

        variant enumeration:
          End()
          More(element, right, enumeration)

        curried fun cons_enum(s, e):
          match s
          | Empty(): e
          | Node(TNode(l,v,r,_)): cons_enum(l, More(v, r, e))

        curried fun compare_aux(e1, e2):
          match [e1, e2]
          | [End(), End()]: 0
          | [End(), _]: -1
          | [_, End()]: 1
          | [More(v1,r1,e1), More(v2,r2,e2)]:
              let c = Set_ordered.compare(v1)(v2)
              (if Host.hol_unequal(c)(0) | c | compare_aux(cons_enum(r1, e1))(cons_enum(r2, e2)))

        curried fun compare_impl_2(s1, s2): compare_aux(cons_enum(s1, End()))(cons_enum(s2, End()))

        curried fun equal_impl(s1, s2): Host.hol_equal(compare_impl_2(s1, s2))(0)

        curried fun subset_impl(s1, s2):
          match [s1, s2]
          | [Empty(), _]: #true
          | [_, Empty()]: #false
          | [Node(TNode(l1,v1,r1,_)), Node(TNode(l2,v2,r2,_)) as t2]:
              let c = Set_ordered.compare(v1)(v2)
              if Host.hol_equal(c)(0)
              | (subset_impl(l1, l2) && subset_impl(r1, r2))
              | (if Host.hol_lt(c)(0) | (subset_impl(Node(TNode(l1, v1, Empty(), 0)), l2) && subset_impl(r1, t2)) | (subset_impl(Node(TNode(Empty(), v1, r1, 0)), r2) && subset_impl(l1, t2)))

        curried fun fold(f, s, accu):
          match s
          | Empty(): accu
          | Node(TNode(l,v,r,_)): fold(f)(r)(f(v)(fold(f, l, accu)))

        fun for_all(p):
          fun
          | (Empty()): #true
          | (Node(TNode(l,v,r,_))): (p(v) && (for_all(p)(l) && for_all(p)(r)))

        fun exists_impl(p):
          fun
          | (Empty()): #false
          | (Node(TNode(l,v,r,_))): (p(v) || (exists_impl(p)(l) || exists_impl(p)(r)))

        fun cardinal
        | cardinal(Empty()): 0
        | cardinal(Node(TNode(l,_,r,_))): Host.hol_add(Host.hol_add(cardinal(l))(1))(cardinal(r))

        fun elements_aux(accu):
          fun
          | (Empty()): accu
          | (Node(TNode(l,v,r,_))): elements_aux(PairList [v, & elements_aux(accu)(r)])(l)

        fun elements(s): elements_aux(PairList [])(s)

        def choose_impl = min_elt

        def merge = merge_impl

        def mem = mem_impl

        def remove = remove_impl

        def union = union_impl

        def compare = compare_impl_2

        def equal = equal_impl

        def subset = subset_impl

        def exists = exists_impl

        def choose = choose_impl

      def compare_impl_2 = Se.compare

      curried fun add(s, x): Se.add(x)(s)

      curried fun foldr_impl(f, a, s): Se.fold((fun(x): (fun(acc): f([x, acc]))))(s)(a)

      def foldl_impl = foldr_impl

      def member = Se.mem

      def empty = Se.empty

      def union_impl = Se.union

      def difference = Se.diff

      def toList = Se.elements

      def singleton = Se.singleton

      def null = Se.is_empty

      def size = Se.cardinal

      def pick = Se.choose

      def equal_impl = Se.equal

      def exists_impl = Se.exists

      fun fromList(l): Host.OCamlList.fold_right(Se.add)(l)(Se.empty)

      curried fun delete(s, x): Se.remove(x)(s)

      def subset_impl = Se.subset

      def intersect_impl = Se.inter

      fun intersectList
      | intersectList(PairList []): Se.empty
      | intersectList(PairList [s, & ss]): Host.OCamlList.fold_right(Se.inter)(ss)(s)

      curried fun findl(p, s):
        let go:
          fun(x):
            fun
            | (Host.Some(_) as s): s
            | (Host.None()): (if p(x) | Host.Some(x) | Host.None())
        Se.fold(go)(s)(Host.None())

      curried fun firstl(f, s):
        let go:
          fun(x):
            fun
            | (Host.Some(_) as s): s
            | (Host.None()): f(x)
        Se.fold(go)(s)(Host.None())

      curried fun transform(f, s): Se.fold((fun(x): (fun(acc): PairList [f(x), & acc])))(s)(PairList [])

      def all = Se.for_all

      curried fun count(p, s): Se.fold((fun(x): (fun(c): (if p(x) | Host.hol_add(c)(1) | c))))(s)(0)

      def compare = compare_impl_2

      def foldr = foldr_impl

      def foldl = foldl_impl

      def union = union_impl

      def equal = equal_impl

      def exists = exists_impl

      def subset = subset_impl

      def intersect = intersect_impl

    def compare = compare_impl

  namespace Thm:
    export:
      Axiom
      Assume
      Subst
      Factor
      Resolve
      Refl
      Equality
      Thm
      clause
      inference
      isTautology
      isContradiction
      destUnit
      isUnit
      destUnitEq
      isUnitEq
      member
      negateMember
      compare
      equal
      freeIn
      freeVars
      inferenceTypeToString
      toString
      print_proof
      axiom
      assume
      subst
      resolve
      refl
      equality

    variant inferenceType:
      Axiom()
      Assume()
      Subst()
      Factor()
      Resolve()
      Refl()
      Equality()

    variant thm:
      Thm(clause, inference)

    fun clause(Thm(cl,_)): cl

    fun inference(Thm(_,inf)): inf

    fun isTautology(th):
      let chk:
        fun
        | ([_, Host.None()]): Host.None()
        | ([[pol, atm], Host.Some(set)]): (if ((pol && Atom.isRefl(atm)) || Atom.Set.member(atm)(set)) | Host.None() | Host.Some(Atom.Set.add(set)(atm)))
      match Literal.Set.foldl(chk)(Host.Some(Atom.Set.empty))(clause(th))
      | Host.Some(_): #false
      | Host.None(): #true

    fun isContradiction(th): Literal.Set.null(clause(th))

    fun destUnit(Thm(cl,_)): (if Host.hol_equal(Literal.Set.size(cl))(1) | Literal.Set.pick(cl) | failwith("Thm.destUnit"))

    def isUnit = can(destUnit)

    fun destUnitEq(th): Literal.destEq(destUnit(th))

    def isUnitEq = can(destUnitEq)

    curried fun member(lit, Thm(cl,_)): Literal.Set.member(lit)(cl)

    curried fun negateMember(lit, Thm(cl,_)): Literal.Set.negateMember(lit)(cl)

    curried fun compare_impl(th1, th2): Literal.Set.compare(clause(th1))(clause(th2))

    curried fun equal(th1, th2): Literal.Set.equal(clause(th1))(clause(th2))

    curried fun freeIn(v, Thm(cl,_)): Literal.Set.freeIn(v)(cl)

    fun freeVars(Thm(cl,_)): Literal.Set.freeVars(cl)

    fun inferenceTypeToString
    | inferenceTypeToString(Axiom()): "axiom"
    | inferenceTypeToString(Assume()): "assume"
    | inferenceTypeToString(Subst()): "subst"
    | inferenceTypeToString(Factor()): "factor"
    | inferenceTypeToString(Resolve()): "resolve"
    | inferenceTypeToString(Refl()): "refl"
    | inferenceTypeToString(Equality()): "equality"

    fun toString(Thm(cl,[infType, ths])): Host.hol_concat(inferenceTypeToString(infType))(Host.hol_concat(": ")(Literal.Set.toString(cl)))

    fun print_proof(Thm(cl,[infType, ths])):
      Host.OCamlFormat.print_string(Host.hol_concat("Inference: ")(inferenceTypeToString(infType)))
      Host.OCamlFormat.print_break(0)(0)
      Host.OCamlFormat.print_string(Host.hol_concat("Clauses: ")(Literal.Set.toString(cl)))
      Host.OCamlFormat.print_break(0)(0)
      Host.OCamlFormat.print_string("Theorems: ")
      if Host.hol_equal(ths)(PairList [])
      | Host.OCamlFormat.print_string("<none>")
      | Host.OCamlFormat.print_break(0)(0)
        Host.OCamlFormat.open_vbox(2)
        Host.OCamlFormat.print_break(0)(0)
        Host.OCamlList.iter(print_proof)(ths)
        Host.hol_apply_unit(Host.OCamlFormat.close_box)
      Host.OCamlFormat.print_break(0)(0)

    fun axiom(cl): Thm(cl, [Axiom(), PairList []])

    fun assume(lit): Thm(Literal.Set.fromList(PairList [lit, Literal.negate(lit)]), [Assume(), PairList []])

    curried fun subst(sub, Thm(cl,inf) as th):
      let cl_prime = Literal.Set.subst(sub)(cl)
      if Host.hol_physical_equal(cl)(cl_prime)
      | th
      | match inf
        | [Subst(), _]: Thm(cl_prime, inf)
        | _: Thm(cl_prime, [Subst(), PairList [th]])

    curried fun resolve(lit, Thm(cl1,_) as th1, Thm(cl2,_) as th2):
      let cl1_prime_2 = Literal.Set.delete(cl1)(lit)
      let cl2_prime_2 = Literal.Set.delete(cl2)(Literal.negate(lit))
      Thm(Literal.Set.union(cl1_prime_2)(cl2_prime_2), [Resolve(), PairList [th1, th2]])

    fun refl(tm): Thm(Literal.Set.singleton([#true, Atom.mkRefl(tm)]), [Refl(), PairList []])

    curried fun equality(lit, path, t):
      let s = Literal.subterm(lit)(path)
      let lit_prime = Literal.replace(lit)([path, t])
      let eqLit = Literal.mkNeq([s, t])
      let cl = Literal.Set.fromList(PairList [eqLit, Literal.negate(lit), lit_prime])
      Thm(cl, [Equality(), PairList []])

    def compare = compare_impl

  namespace Proof:
    export:
      Axiom
      Assume
      Subst
      Resolve
      Refl
      Equality
      parents
      inferenceToThm
      reconstructSubst
      reconstructResolvant
      reconstructEquality
      reconstruct
      thmToInference
      proof
      freeIn
      freeVars

    variant inference:
      Axiom(clause)
      Assume(atom)
      Subst(substitution, theorem)
      Resolve(atom, left, right)
      Refl(term)
      Equality(literal, path, replacement)

    fun parents
    | parents(Axiom(_)): PairList []
    | parents(Assume(_)): PairList []
    | parents(Subst(_,th)): PairList [th]
    | parents(Resolve(_,th,th_prime)): PairList [th, th_prime]
    | parents(Refl(_)): PairList []
    | parents(Equality(_,_,_)): PairList []

    fun inferenceToThm
    | inferenceToThm(Axiom(cl)): Thm.axiom(cl)
    | inferenceToThm(Assume(atm)): Thm.assume([#true, atm])
    | inferenceToThm(Subst(sub,th)): Thm.subst(sub)(th)
    | inferenceToThm(Resolve(atm,th,th_prime)): Thm.resolve([#true, atm])(th)(th_prime)
    | inferenceToThm(Refl(tm)): Thm.refl(tm)
    | inferenceToThm(Equality(lit,path,r)): Thm.equality(lit)(path)(r)

    curried fun reconstructSubst(cl, cl_prime):
      fun recon
      | recon(PairList []): Host.hol_raise(Useful.Bug("can't reconstruct Subst rule"))
      | recon(PairList [[PairList [], sub], & others]): (if Literal.Set.equal(Literal.Set.subst(sub)(cl))(cl_prime) | sub | recon(others))
      | recon(PairList [[PairList [lit, & lits], sub], & others]):
          let checkLit:
            fun([lit_prime, acc]):
              match Useful.total(Literal.matchLiterals(sub)(lit))(lit_prime)
              | Host.None(): acc
              | Host.Some(sub): PairList [[lits, sub], & acc]
          recon(Literal.Set.foldl(checkLit)(others)(cl_prime))
      Substitute.normalize(recon(PairList [[Literal.Set.toList(cl), Substitute.empty]]))

    curried fun reconstructResolvant(cl1, cl2, cl):
      if Host.hol_not(Literal.Set.subset(cl1)(cl))
      | Literal.Set.pick(Literal.Set.difference(cl1)(cl))
      | if Host.hol_not(Literal.Set.subset(cl2)(cl))
        | Literal.negate(Literal.Set.pick(Literal.Set.difference(cl2)(cl)))
        | let cl1_prime_2 = Literal.Set.negate(cl1)
          let cl2_prime_2 = Literal.Set.negate(cl2)
          let lits = Literal.Set.intersectList(PairList [cl1, cl1_prime_2, cl2, cl2_prime_2])
          (if Host.hol_not(Literal.Set.null(lits)) | Literal.Set.pick(lits) | Host.hol_raise(Useful.Bug("can't reconstruct Resolve rule")))

    fun reconstructEquality(cl):
      fun sync(s):
        fun(t):
          fun(path):
            fun([f, a]):
              fun([f_prime, a_prime]):
                if Host.hol_not((Name.equal(f)(f_prime) && Host.hol_equal(length(a))(length(a_prime))))
                | Host.None()
                | let itms = Mlist.enumerate(zip(a)(a_prime))
                  match Host.OCamlList.filter((fun(x): Host.hol_not(uncurry(Term.equal)(snd(x)))))(itms)
                  | PairList [[i, [tm, tm_prime]], & PairList []]:
                      let path = PairList [i, & path]
                      if (Term.equal(tm)(s) && Term.equal(tm_prime)(t))
                      | Host.Some(Host.OCamlList.rev(path))
                      | match [tm, tm_prime]
                        | [Term.Fn(f_a), Term.Fn(f_a_prime)]: sync(s)(t)(path)(f_a)(f_a_prime)
                        | _: Host.None()
                  | _: Host.None()
      let recon_2:
        fun([neq, [pol, atm], [pol_prime, atm_prime]]):
          if Host.hol_equal(pol)(pol_prime)
          | Host.None()
          | let [s, t] = Literal.destNeq(neq)
            let path:
              if Host.hol_not(Term.equal(s)(t))
              | sync(s)(t)(PairList [])(atm)(atm_prime)
              | (if Host.hol_not(Atom.equal(atm)(atm_prime)) | Host.None() | Atom.find(Term.equal(s))(atm))
            match path
            | Host.Some(path): Host.Some([[pol_prime, atm], path, t])
            | Host.None(): Host.None()
      let candidates:
        match Host.OCamlList.partition(Literal.isNeq)(Literal.Set.toList(cl))
        | [PairList [l1, & PairList []], PairList [l2, & PairList [l3, & PairList []]]]: PairList [[l1, l2, l3], [l1, l3, l2]]
        | [PairList [l1, & PairList [l2, & PairList []]], PairList [l3, & PairList []]]: PairList [[l1, l2, l3], [l1, l3, l2], [l2, l1, l3], [l2, l3, l1]]
        | [PairList [l1, & PairList []], PairList [l2, & PairList []]]: PairList [[l1, l1, l2], [l1, l2, l1]]
        | _: Host.hol_raise(Useful.Bug("reconstructEquality: malformed"))
      match Mlist.first(recon_2)(candidates)
      | Host.Some(info): info
      | Host.None(): Host.hol_raise(Useful.Bug("can't reconstruct Equality rule"))

    fun reconstruct(cl):
      fun
      | ([Thm.Axiom(), PairList []]): Axiom(cl)
      | ([Thm.Assume(), PairList []]):
          match Literal.Set.findl(Literal.positive)(cl)
          | Host.Some([_, atm]): Assume(atm)
          | Host.None(): Host.hol_raise(Useful.Bug("malformed Assume inference"))
      | ([Thm.Subst(), PairList [th, & PairList []]]): Subst(reconstructSubst(Thm.clause(th), cl), th)
      | ([Thm.Resolve(), PairList [th1, & PairList [th2, & PairList []]]]):
          let cl1_2 = Thm.clause(th1)
          let cl2_2 = Thm.clause(th2)
          let [pol, atm] = reconstructResolvant(cl1_2, cl2_2, cl)
          (if pol | Resolve(atm, th1, th2) | Resolve(atm, th2, th1))
      | ([Thm.Refl(), PairList []]):
          match Literal.Set.findl(K(#true))(cl)
          | Host.Some(lit): Refl(Literal.destRefl(lit))
          | Host.None(): Host.hol_raise(Useful.Bug("malformed Refl inference"))
      | ([Thm.Equality(), PairList []]):
          let [x, y, z] = reconstructEquality(cl)
          Equality(x, y, z)
      | (_): Host.hol_raise(Useful.Bug("malformed inference"))

    fun thmToInference(th):
      let cl = Thm.clause(th)
      let thmInf = Thm.inference(th)
      let inf = reconstruct(cl)(thmInf)
      inf

    fun proof(th):
      let emptyThms = Host.hol_apply_unit(Literal.Set_map.newMap)
      fun addThms([th, ths]):
        let cl = Thm.clause(th)
        if Literal.Set_map.inDomain(cl)(ths)
        | ths
        | let [_, pars] = Thm.inference(th)
          let ths = Mlist.foldl(addThms)(ths)(pars)
          (if Literal.Set_map.inDomain(cl)(ths) | ths | Literal.Set_map.insert(ths)([cl, th]))
      let mkThms = (fun(th): addThms([th, emptyThms]))
      fun addProof([th, [ths, acc]]):
        let cl = Thm.clause(th)
        match Literal.Set_map.peek(ths)(cl)
        | Host.None(): [ths, acc]
        | Host.Some(th):
            let [_, pars] = Thm.inference(th)
            let [ths, acc] = Mlist.foldl(addProof)([ths, acc])(pars)
            let ths = Literal.Set_map.delete(ths)(cl)
            let acc = PairList [[th, thmToInference(th)], & acc]
            [ths, acc]
      let mkProof:
        fun(ths):
          fun(th):
            let [ths, acc] = addProof([th, [ths, PairList []]])
            Host.OCamlList.rev(acc)
      let ths = mkThms(th)
      let infs = mkProof(ths)(th)
      infs

    fun freeIn(v):
      let free:
        fun(th_inf):
          match th_inf
          | [_, Axiom(lits)]: Literal.Set.freeIn(v)(lits)
          | [_, Assume(atm)]: Atom.freeIn(v)(atm)
          | [th, Subst(_,_)]: Thm.freeIn(v)(th)
          | [_, Resolve(_,_,_)]: #false
          | [_, Refl(tm)]: Term.freeIn(v)(tm)
          | [_, Equality(lit,_,tm)]: (Literal.freeIn(v)(lit) || Term.freeIn(v)(tm))
      Host.OCamlList.exists(free)

    def freeVars:
      let inc:
        fun([th_inf, set]):
          Name.Set.union(set)(
            match th_inf
            | [_, Axiom(lits)]: Literal.Set.freeVars(lits)
            | [_, Assume(atm)]: Atom.freeVars(atm)
            | [th, Subst(_,_)]: Thm.freeVars(th)
            | [_, Resolve(_,_,_)]: Name.Set.empty
            | [_, Refl(tm)]: Term.freeVars(tm)
            | [_, Equality(lit,_,tm)]: Name.Set.union(Literal.freeVars(lit))(Term.freeVars(tm))
          )
      Mlist.foldl(inc)(Name.Set.empty)

  namespace Rule:
