    fun equalKey(compareKey): fun(key1): fun(key2): (compareKey(key1)(key2) == 0)

    def randomPriority = ocaml_random_bits

    def comparePriority = Word.compare

    variant tree:
      Empty()
      Tree(node)

    record Node(size, priority, left, key, value, right)

    fun lowerPriorityNode(node1):
      fun(node2):
        let Node(_,p1_2,_,_,_,_) = node1
        let Node(_,p2_2,_,_,_,_) = node2
        (comparePriority(p1_2)(p2_2) < 0)

    fun treeNew(_): Empty()

    fun nodeSize(Node(x,_,_,_,_,_)): x

    fun treeSize(tree):
      match tree
      | Empty(): 0
      | Tree(x): nodeSize(x)

    fun mkNode(priority):
      fun(left):
        fun(key):
          fun(value):
            fun(right):
              let size = ((treeSize(left) + 1) + treeSize(right))
              Node(size, priority, left, key, value, right)

    fun mkTree(priority):
      fun(left):
        fun(key):
          fun(value):
            fun(right):
              let node = mkNode(priority)(left)(key)(value)(right)
              Tree(node)

    fun treeLeftSpine(acc):
      fun(tree):
        match tree
        | Empty(): acc
        | Tree(node): nodeLeftSpine(acc)(node)

    fun nodeLeftSpine(acc):
      fun(node):
        let Node(_,_,left,_,_,_) = node
        treeLeftSpine(PairList [node, & acc])(left)

    fun treeRightSpine(acc):
      fun(tree):
        match tree
        | Empty(): acc
        | Tree(node): nodeRightSpine(acc)(node)

    fun nodeRightSpine(acc):
      fun(node):
        let Node(_,_,_,_,_,right) = node
        treeRightSpine(PairList [node, & acc])(right)

    fun mkNodeSingleton(priority):
      fun(key):
        fun(value):
          let size_2 = 1
          let left_2 = Empty()
          let right_2 = Empty()
          Node(size_2, priority, left_2, key, value, right_2)

    fun nodeSingleton([key, value]):
      let priority = randomPriority()
      mkNodeSingleton(priority)(key)(value)

    fun treeSingleton(key_value):
      let node = nodeSingleton(key_value)
      Tree(node)

    fun treeAppend(tree1):
      fun(tree2):
        match tree1
        | Empty(): tree2
        | Tree(node1):
            match tree2
            | Empty(): tree1
            | Tree(node2):
                if lowerPriorityNode(node1)(node2)
                | let Node(_,priority,left,key,value,right) = node2
                  let left = treeAppend(tree1)(left)
                  mkTree(priority)(left)(key)(value)(right)
                | let Node(_,priority,left,key,value,right) = node1
                  let right = treeAppend(right)(tree2)
                  mkTree(priority)(left)(key)(value)(right)

    fun treeCombine(left):
      fun(node):
        fun(right):
          let left_node = treeAppend(left)(Tree(node))
          treeAppend(left_node)(right)

    fun treePeek(compareKey):
      fun(pkey):
        fun(tree):
          match tree
          | Empty(): None()
          | Tree(node): nodePeek(compareKey)(pkey)(node)

    fun nodePeek(compareKey):
      fun(pkey):
        fun(node):
          let Node(_,_,left,key,value,right) = node
          let c = compareKey(pkey)(key)
          if (c < 0)
          | treePeek(compareKey)(pkey)(left)
          | (if (c == 0) | Some(value) | treePeek(compareKey)(pkey)(right))

    fun treePeekPath(compareKey):
      fun(pkey):
        fun(path):
          fun(tree):
            match tree
            | Empty(): [path, None()]
            | Tree(node): nodePeekPath(compareKey)(pkey)(path)(node)

    fun nodePeekPath(compareKey):
      fun(pkey):
        fun(path):
          fun(node):
            let Node(_,_,left,key,_,right) = node
            let c = compareKey(pkey)(key)
            if (c < 0)
            | treePeekPath(compareKey)(pkey)(PairList [[#true, node], & path])(left)
            | (if (c == 0) | [path, Some(node)] | treePeekPath(compareKey)(pkey)(PairList [[#false, node], & path])(right))

    fun addSidePath([[wentLeft, node], [leftTree, rightTree]]):
      let Node(_,priority,left,key,value,right) = node
      (if wentLeft | [leftTree, mkTree(priority)(rightTree)(key)(value)(right)] | [mkTree(priority)(left)(key)(value)(leftTree), rightTree])

    fun addSidesPath(left_right): fun(path): Mlist.foldl(addSidePath)(left_right)(path)

    fun mkSidesPath(path): addSidesPath([Empty(), Empty()])(path)

    fun updateTree([[wentLeft, node], tree]):
      let Node(_,priority,left,key,value,right) = node
      (if wentLeft | mkTree(priority)(tree)(key)(value)(right) | mkTree(priority)(left)(key)(value)(tree))

    fun updateTreePath(tree): fun(path): Mlist.foldl(updateTree)(tree)(path)

    fun insertNodePath(node):
      fun(path):
        // Recursive tree insertion needs the local definition before its first use.
        fun insert_2(left_right):
          fun(path):
            match path
            | PairList []:
                let [left, right] = left_right
                treeCombine(left)(node)(right)
            | PairList [[_, snode] as step, & rest]:
                if lowerPriorityNode(snode)(node)
                | let left_right = addSidePath([step, left_right])
                  insert_2(left_right)(rest)
                | let [left, right] = left_right
                  let tree = treeCombine(left)(node)(right)
                  updateTreePath(tree)(path)
        insert_2([Empty(), Empty()])(path)

    fun nodePartition(compareKey):
      fun(pkey):
        fun(node):
          let [path, pnode] = nodePeekPath(compareKey)(pkey)(PairList [])(node)
          match pnode
          | None():
              let [left, right] = mkSidesPath(path)
              [left, None(), right]
          | Some(node):
              let Node(_,_,left,key,value,right) = node
              let [left, right] = addSidesPath([left, right])(path)
              [left, Some([key, value]), right]

    fun treePeekKey(compareKey):
      fun(pkey):
        fun(tree):
          match tree
          | Empty(): None()
          | Tree(node): nodePeekKey(compareKey)(pkey)(node)

    fun nodePeekKey(compareKey):
      fun(pkey):
        fun(node):
          let Node(_,_,left,key,value,right) = node
          let c = compareKey(pkey)(key)
          if (c < 0)
          | treePeekKey(compareKey)(pkey)(left)
          | (if (c == 0) | Some([key, value]) | treePeekKey(compareKey)(pkey)(right))

    fun treeInsert(compareKey):
      fun(key_value):
        fun(tree):
          let [key, value] = key_value
          let [path, inode] = treePeekPath(compareKey)(key)(PairList [])(tree)
          match inode
          | None():
              let node = nodeSingleton([key, value])
              insertNodePath(node)(path)
          | Some(node):
              let Node(size,priority,left,_,_,right) = node
              let node = Node(size, priority, left, key, value, right)
              updateTreePath(Tree(node))(path)

    fun treeDelete(compareKey):
      fun(dkey):
        fun(tree):
          match tree
          | Empty(): (throw Useful.Bug("Map.delete: element not found"))
          | Tree(node): nodeDelete(compareKey)(dkey)(node)

    fun nodeDelete(compareKey):
      fun(dkey):
        fun(node):
          let Node(size,priority,left,key,value,right) = node
          let c = compareKey(dkey)(key)
          if (c < 0)
          | let size_3 = (size - 1)
            let left_3 = treeDelete(compareKey)(dkey)(left)
            let node = Node(size_3, priority, left_3, key, value, right)
            Tree(node)
          | if (c == 0)
            | treeAppend(left)(right)
            | let size_4 = (size - 1)
              let right_3 = treeDelete(compareKey)(dkey)(right)
              let node = Node(size_4, priority, left, key, value, right_3)
              Tree(node)

    fun treeMapPartial(f):
      fun(tree):
        match tree
        | Empty(): Empty()
        | Tree(node): nodeMapPartial(f)(node)

    fun nodeMapPartial(f):
      fun(Node(_,priority,left,key,value,right)):
        let left_4 = treeMapPartial(f)(left)
        let vo_2 = f([key, value])
        let right_4 = treeMapPartial(f)(right)
        match vo_2
        | None(): treeAppend(left_4)(right_4)
        | Some(value): mkTree(priority)(left_4)(key)(value)(right_4)

    fun treeMap(f):
      fun(tree):
        match tree
        | Empty(): Empty()
        | Tree(node): Tree(nodeMap(f)(node))

    fun nodeMap(f):
      fun(node):
        let Node(size,priority,left,key,value,right) = node
        let left_5 = treeMap(f)(left)
        let value_2 = f([key, value])
        let right_5 = treeMap(f)(right)
        Node(size, priority, left_5, key, value_2, right_5)

    fun treeMerge(compareKey):
      fun(f1):
        fun(f2):
          fun(fb):
            fun(tree1):
              fun(tree2):
                match tree1
                | Empty(): treeMapPartial(f2)(tree2)
                | Tree(node1):
                    match tree2
                    | Empty(): treeMapPartial(f1)(tree1)
                    | Tree(node2): nodeMerge(compareKey)(f1)(f2)(fb)(node1)(node2)

    fun nodeMerge(compareKey):
      fun(f1):
        fun(f2):
          fun(fb):
            fun(node1):
              fun(node2):
                let Node(_,priority,left,key,value,right) = node2
                let [l, kvo, r] = nodePartition(compareKey)(key)(node1)
                let left_6 = treeMerge(compareKey)(f1)(f2)(fb)(l)(left)
                let right_6 = treeMerge(compareKey)(f1)(f2)(fb)(r)(right)
                let vo:
                  match kvo
                  | None(): f2([key, value])
                  | Some(kv): fb([kv, [key, value]])
                match vo
                | None(): treeAppend(left_6)(right_6)
                | Some(value):
                    let node = mkNodeSingleton(priority)(key)(value)
                    treeCombine(left_6)(node)(right_6)

    fun treeUnion(compareKey):
      fun(f):
        fun(f2):
          fun(tree1):
            fun(tree2):
              match tree1
              | Empty(): tree2
              | Tree(node1):
                  match tree2
                  | Empty(): tree1
                  | Tree(node2): nodeUnion(compareKey)(f)(f2)(node1)(node2)

    fun nodeUnion(compareKey):
      fun(f):
        fun(f2):
          fun(node1):
            fun(node2):
              if (node1 === node2)
              | nodeMapPartial(f2)(node1)
