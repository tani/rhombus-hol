    def newId:
      let r = Box(0)
      let newI:
        fun(_):
          let n = r.value
          let #void = (r.value := (n + 1))
          n
      (fun(_): Useful.critical(newI)(#void))

    variant literalOrder:
      No_literal_order()
      Unsigned_literal_order()
      Positive_literal_order()

    record Parameters(ordering, orderLiterals, orderTerms)

    record ClauseInfo(parameters, id, thm)

    variant clause:
      Clause(info)

    fun toString(Clause(ClauseInfo(_,id,thm))): Thm.toString(thm)

    def default = Parameters(Knuth_bendix_order.default, Positive_literal_order(), #true)

    fun mk(info): Clause(info)

    fun dest(Clause(info)): info

    fun id_impl(Clause(ClauseInfo(_,i,_))): i

    fun thm_impl(Clause(ClauseInfo(_,_,th))): th

    fun equalThms(cl): fun(cl_prime): Thm.equal(thm_impl(cl))(thm_impl(cl_prime))

    fun newClause(parameters): fun(thm): Clause(ClauseInfo(parameters, newId(#void), thm))

    fun literals(cl): Thm.clause(thm_impl(cl))

    fun isTautology(Clause(ClauseInfo(_,_,thm))): Thm.isTautology(thm)

    fun isContradiction(Clause(ClauseInfo(_,_,thm))): Thm.isContradiction(thm)

    fun strictlyLess(ordering):
      fun(x):
        fun(y):
          let subject = Knuth_bendix_order.compare(ordering)(x)(y)
          match subject
          | Some(c):
              if (c < 0)
              | #true
              | match subject
                | _: #false
          | _: #false

    fun isLargerTerm(Parameters(ordering,_,orderTerms)): fun([l, r]): (!orderTerms || !strictlyLess(ordering)(l)(r))

    fun atomToTerms(atm):
      match Useful.total(Atom.destEq)(atm)
      | None(): PairList [Term.Fn(atm)]
      | Some([l, r]): PairList [l, r]

    fun notStrictlyLess(ordering):
      fun([xs, ys]):
        let less = (fun(x): OCamlList.exists((fun(y): strictlyLess(ordering)(x)(y)))(ys))
        !OCamlList.for_all(less)(xs)

    fun isLargerLiteral(Parameters(ordering,orderLiterals,_)):
      fun(lits):
        match orderLiterals
        | No_literal_order(): K(#true)
        | Unsigned_literal_order():
            let addLit = (fun([[_, atm], acc]): append(atomToTerms(atm))(acc))
            let tms = Literal.Set.foldl(addLit)(PairList [])(lits)
            (fun([_, atm_prime]): notStrictlyLess(ordering)([atomToTerms(atm_prime), tms]))
        | Positive_literal_order():
            match Literal.Set.findl(K(#true))(lits)
            | None(): K(#true)
            | Some([pol, _]):
                let addLit = (fun([[p, atm], acc]): (if (p == pol) | append(atomToTerms(atm))(acc) | acc))
                let tms = Literal.Set.foldl(addLit)(PairList [])(lits)
                (fun([pol_prime, atm_prime]): (if (pol != pol_prime) | pol | notStrictlyLess(ordering)([atomToTerms(atm_prime), tms])))

    fun largestLiterals(Clause(ClauseInfo(parameters,_,thm))):
      let litSet = Thm.clause(thm)
      let isLarger = isLargerLiteral(parameters)(litSet)
      let addLit = (fun([lit, s]): (if isLarger(lit) | Literal.Set.add(s)(lit) | s))
      Literal.Set.foldr(addLit)(Literal.Set.empty)(litSet)

    fun largestEquations(Clause(ClauseInfo(parameters,_,_)) as cl):
      let addEq = fun(lit): fun(ort): fun([l, _] as l_r): fun(acc): (if isLargerTerm(parameters)(l_r) | PairList [[lit, ort, l], & acc] | acc)
      let addLit:
        fun([lit, acc]):
          match Useful.total(Literal.destEq)(lit)
          | None(): acc
          | Some([l, r]):
              let acc = addEq(lit)(Rewrite.Right_to_left())([r, l])(acc)
              let acc = addEq(lit)(Rewrite.Left_to_right())([l, r])(acc)
              acc
      Literal.Set.foldr(addLit)(PairList [])(largestLiterals(cl))

    fun addLit([lit, acc]):
      let addTm = (fun([[path, tm], acc]): PairList [[lit, path, tm], & acc])
      Mlist.foldl(addTm)(acc)(Literal.nonVarTypedSubterms(lit))

    fun largestSubterms(cl): Literal.Set.foldl(addLit)(PairList [])(largestLiterals(cl))

    fun allSubterms(cl): Literal.Set.foldl(addLit)(PairList [])(literals(cl))

    fun subsumes(subs): fun(cl): Subsume.isStrictlySubsumed(subs)(literals(cl))

    fun freshVars(Clause(ClauseInfo(parameters,id,thm))): Clause(ClauseInfo(parameters, id, Rule.freshVars(thm)))

    fun simplify(Clause(ClauseInfo(parameters,id,thm))):
      match Rule.simplify(thm)
      | None(): None()
      | Some(thm): Some(Clause(ClauseInfo(parameters, id, thm)))

    fun reduce(units): fun(Clause(ClauseInfo(parameters,id,thm))): Clause(ClauseInfo(parameters, id, Units.reduce(units)(thm)))

    fun rewrite(rewr):
      fun(Clause(ClauseInfo(parameters,id,thm))):
        let simp:
          fun(th):
            let Parameters(ordering,_,_) = parameters
            let cmp = Knuth_bendix_order.compare(ordering)
            Rewrite.rewriteIdRule(rewr)(cmp)(id)(th)
        let thm:
          match Rewrite.peek(rewr)(id)
          | None(): simp(thm)
          | Some([[_, thm], _]): (if Rewrite.isReduced(rewr) | thm | simp(thm))
        let result = Clause(ClauseInfo(parameters, id, thm))
        result

    fun factor(Clause(ClauseInfo(parameters,_,thm)) as cl):
      let lits = largestLiterals(cl)
      let apply_2 = (fun(sub): newClause(parameters)(Thm.subst(sub)(thm)))
      PairList.map(Rule.factor_prime(lits), apply_2)

    fun resolve([cl1, lit1]):
      fun([cl2, lit2]):
        let Clause(ClauseInfo(parameters_2,_,th1_2)) = cl1
        let Clause(ClauseInfo(_,_,th2_2)) = cl2
        let sub = Literal.unify(Substitute.empty)(lit1)(Literal.negate(lit2))
        let lit1 = Literal.subst(sub)(lit1)
        let lit2 = Literal.negate(lit1)
        let th1_3 = Thm.subst(sub)(th1_2)
        let th2_3 = Thm.subst(sub)(th2_2)
        let _ = (isLargerLiteral(parameters_2)(Thm.clause(th1_3))(lit1) || failwith("resolve: clause1: ordering constraints"))
        let _ = (isLargerLiteral(parameters_2)(Thm.clause(th2_3))(lit2) || failwith("resolve: clause2: ordering constraints"))
        let th = Thm.resolve(lit1)(th1_3)(th2_3)
        let cl = Clause(ClauseInfo(parameters_2, newId(#void), th))
        cl

    fun paramodulate([cl1, lit1, ort1, tm1]):
      fun([cl2, lit2, path2, tm2]):
        let Clause(ClauseInfo(parameters_3,_,th1_4)) = cl1
        let Clause(ClauseInfo(_,_,th2_4)) = cl2
        let sub = Substitute.unify(Substitute.empty)(tm1)(tm2)
        let lit1_2 = Literal.subst(sub)(lit1)
        let lit2_2 = Literal.subst(sub)(lit2)
        let th1_5 = Thm.subst(sub)(th1_4)
        let th2_5 = Thm.subst(sub)(th2_4)
        let _ = (isLargerLiteral(parameters_3)(Thm.clause(th1_5))(lit1_2) || failwith("Clause.paramodulate: with clause: ordering"))
        let _ = (isLargerLiteral(parameters_3)(Thm.clause(th2_5))(lit2_2) || failwith("Clause.paramodulate: into clause: ordering"))
        let eqn = [Literal.destEq(lit1_2), th1_5]
        let [l_r, _] as eqn:
          match ort1
          | Rewrite.Left_to_right(): eqn
          | Rewrite.Right_to_left(): Rule.symEqn(eqn)
        let _ = (isLargerTerm(parameters_3)(l_r) || failwith("Clause.paramodulate: equation: ordering constraints"))
        let th = Rule.rewrRule(eqn)(lit2_2)(path2)(th2_5)
        Clause(ClauseInfo(parameters_3, newId(#void), th))

