      let value_2 = f([key, value])
      let right_5 = treeMap(f, right)
      Node(size, priority, left_5, key, value_2, right_5)

    curried fun treeMerge(compareKey, f1, f2, fb, tree1, tree2):
      match tree1
      | Empty(): treeMapPartial(f2, tree2)
      | Tree(node1):
