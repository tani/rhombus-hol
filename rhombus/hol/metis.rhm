        fun concat(t1):
          fun(t2):
            match [t1, t2]
            | [Empty(), t]: t
            | [t, Empty()]: t
            | [_, _]:
                let [x, d] = min_binding(t2)
                join(t1)(x)(d)(remove_min_binding(t2))

        fun concat_or_join(t1):
          fun(v):
            fun(d):
              fun(t2):
                match d
                | Some(d): join(t1)(v)(d)(t2)
                | None(): concat(t1)(t2)

        fun split(x):
          fun(stage_arg):
            match stage_arg
            | Empty(): [Empty(), None(), Empty()]
            | Node(TNode(l,v,d,r,_)):
