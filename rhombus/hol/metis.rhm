    def maxSpace = 1000

    curried fun multInt(x, y):
      let m = Host.hol_int_of_float(Host.floor(Host.float_sqrt(Host.hol_float(Host.max_int))))
      (if (Host.hol_le(x)(m) && Host.hol_le(y)(m)) | Host.Some(Host.hol_mul(x)(y)) | Host.None())

    curried fun iexp(x, y, acc):
      if Host.hol_equal(Host.hol_mod(y)(2))(0)
      | iexp_prime_impl(x, y, acc)
      | match multInt(acc, x)
        | Host.Some(acc): iexp_prime_impl(x, y, acc)
        | Host.None(): Host.None()

    fun iexp_prime_impl(x):
      fun(y):
        fun(acc):
          if Host.hol_equal(y)(1)
          | Host.Some(acc)
          | let y = Host.hol_div(y)(2)
            match multInt(x, x)
            | Host.Some(x): iexp(x, y, acc)
            | Host.None(): Host.None()

    curried fun expInt(x, y):
      if Host.hol_le(y)(1)
      | if Host.hol_equal(y)(0)
        | Host.Some(1)
        | (if Host.hol_equal(y)(1) | Host.Some(x) | Host.hol_raise(Useful.Bug("expInt: negative exponent")))
      | if Host.hol_le(x)(1)
        | (if Host.hol_le(0)(x) | Host.Some(x) | Host.hol_raise(Useful.Bug("expInt: negative exponand")))
        | iexp(x, y, 1)

    fun boolToInt
    | boolToInt(#true): 1
    | boolToInt(#false): 0

    fun intToBool
    | intToBool(1): #true
    | intToBool(0): #false
    | intToBool(_): Host.hol_raise(Useful.Bug("Model.intToBool"))

    curried fun minMaxInterval(i, j): Useful.interval(i)(Host.hol_sub(Host.hol_add(1)(j))(i))

    record Size(size)

    def zeroElement = 0

    curried fun incrementElement(Size(n), i):
      let i = Host.hol_add(i)(1)
      (if Host.hol_equal(i)(n) | Host.None() | Host.Some(i))

    curried fun elementListSpace(Size(n), arity):
      match expInt(n, arity)
      | Host.None(): Host.None()
      | Host.Some(m) as s: (if Host.hol_le(m)(maxSpace) | s | Host.None())

    fun elementListIndex(Size(n)):
      fun f(acc):
        fun(elts):
          match elts
          | PairList []: acc
          | PairList [elt, & elts]: f(Host.hol_add(Host.hol_mul(n)(acc))(elt))(elts)
      f(0)

    record Fixed(functions, relations)

    def uselessFixedFunction = K(K(Host.None()))

    def uselessFixedRelation = K(K(Host.None()))

    def emptyFunctions = Host.hol_apply_unit(Name_arity.Map.newMap)

    def emptyRelations = Host.hol_apply_unit(Name_arity.Map.newMap)

    curried fun fixed0(f, sz, elts):
      match elts
      | PairList []: f(sz)
      | _: Host.hol_raise(Useful.Bug("Model.fixed0: wrong arity"))

    curried fun fixed1(f, sz, elts):
      match elts
      | PairList [x, & PairList []]: f(sz)(x)
      | _: Host.hol_raise(Useful.Bug("Model.fixed1: wrong arity"))

    curried fun fixed2(f, sz, elts):
      match elts
      | PairList [x, & PairList [y, & PairList []]]: f(sz)(x)(y)
      | _: Host.hol_raise(Useful.Bug("Model.fixed2: wrong arity"))

    def emptyFixed:
      let fns_2 = emptyFunctions
      let rels_2 = emptyRelations
      Fixed(fns_2, rels_2)

    curried fun peekFunctionFixed(fix, name_arity):
      let Fixed(fns,_) = fix
      Name_arity.Map.peek(fns)(name_arity)

    curried fun peekRelationFixed(fix, name_arity):
      let Fixed(_,rels) = fix
      Name_arity.Map.peek(rels)(name_arity)

    curried fun getFunctionFixed(fix, name_arity):
      match peekFunctionFixed(fix, name_arity)
      | Host.Some(f): f
      | Host.None(): uselessFixedFunction

    curried fun getRelationFixed(fix, name_arity):
      match peekRelationFixed(fix, name_arity)
      | Host.Some(rel): rel
      | Host.None(): uselessFixedRelation

    curried fun insertFunctionFixed(fix, name_arity_fun):
      let Fixed(fns,rels) = fix
      let fns = Name_arity.Map.insert(fns)(name_arity_fun)
      Fixed(fns, rels)

    curried fun insertRelationFixed(fix, name_arity_rel):
      let Fixed(fns,rels) = fix
      let rels = Name_arity.Map.insert(rels)(name_arity_rel)
      Fixed(fns, rels)

    fun union_impl(_): Host.hol_raise(Useful.Bug("Model.unionFixed: nameArity clash"))

    curried fun unionFixed(fix1, fix2):
      let Fixed(fns1_2,rels1_2) = fix1
      let Fixed(fns2_2,rels2_2) = fix2
      let fns = Name_arity.Map.union(union_impl)(fns1_2)(fns2_2)
      let rels = Name_arity.Map.union(union_impl)(rels1_2)(rels2_2)
      Fixed(fns, rels)

    def unionListFixed:
      let union_2 = (fun([fix, acc]): unionFixed(acc, fix))
      Mlist.foldl(union_2)(emptyFixed)

    curried fun hasTypeFn(_, elts):
      match elts
      | PairList [x, & PairList [_, & PairList []]]: Host.Some(x)
      | _: Host.hol_raise(Useful.Bug("Model.hasTypeFn: wrong arity"))

    curried fun eqRel(_, elts):
      match elts
      | PairList [x, & PairList [y, & PairList []]]: Host.Some(Host.hol_equal(x)(y))
      | _: Host.hol_raise(Useful.Bug("Model.eqRel: wrong arity"))

    def basicFixed:
      let fns = Name_arity.Map.singleton([Term.hasTypeFunction, hasTypeFn])
      let rels = Name_arity.Map.singleton([Atom.eqRelation, eqRel])
      Fixed(fns, rels)

    record FixedMap(functionMap, relationMap)

    curried fun mapFixed(fixMap, fix):
      let FixedMap(fnMap_2,relMap_2) = fixMap
      let Fixed(fns_3,rels_3) = fix
      let fns = Name_arity.Map.compose(fnMap_2)(fns_3)
      let rels = Name_arity.Map.compose(relMap_2)(rels_3)
      Fixed(fns, rels)

    def projectionMin = 1

    def projectionMax = 9

    def projectionList = minMaxInterval(projectionMin, projectionMax)

    fun projectionName(i):
      let _ = (Host.hol_le(projectionMin)(i) || Host.hol_raise(Useful.Bug("Model.projectionName: less than projectionMin")))
      let _ = (Host.hol_le(i)(projectionMax) || Host.hol_raise(Useful.Bug("Model.projectionName: greater than projectionMax")))
      Name.fromString(Host.hol_concat("project")(Host.hol_string_of_int(i)))

    curried fun projectionFn(i, _, elts): Host.Some(Host.OCamlList.nth(elts)(Host.hol_sub(i)(1)))

    fun arityProjectionFixed(arity):
      let mkProj = (fun(i): [[projectionName(i), arity], projectionFn(i)])
      fun addProj(i): (fun(acc): (if Host.hol_gt(i)(arity) | acc | addProj(Host.hol_add(i)(1))(Name_arity.Map.insert(acc)(mkProj(i)))))
      let fns = addProj(projectionMin)(emptyFunctions)
      let rels = emptyRelations
      Fixed(fns, rels)

    def projectionFixed = unionListFixed(Host.OCamlList.map(arityProjectionFixed)(projectionList))

    def numeralMin = -100

    def numeralMax = 100

    def numeralList = minMaxInterval(numeralMin, numeralMax)

    fun numeralName(i):
      let _ = (Host.hol_le(numeralMin)(i) || Host.hol_raise(Useful.Bug("Model.numeralName: less than numeralMin")))
      let _ = (Host.hol_le(i)(numeralMax) || Host.hol_raise(Useful.Bug("Model.numeralName: greater than numeralMax")))
      let s = (if Host.hol_lt(i)(0) | Host.hol_concat("negative")(Host.hol_string_of_int(Host.hol_neg(i))) | Host.hol_string_of_int(i))
      Name.fromString(s)

