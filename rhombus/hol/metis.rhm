    variant orient:
      Left_to_right()
      Right_to_left()

    fun toStringOrient(ort):
      match ort
      | Left_to_right(): "-->"
      | Right_to_left(): "<--"

    fun toStringOrientOption(orto):
      match orto
      | Some(ort): toStringOrient(ort)
      | None(): "<->"

    record RewriteT(order, known, redexes, subterms, waiting)

    variant rewrite:
      Rewrite(rules)

    fun updateWaiting(rw):
      fun(waiting):
        let Rewrite(RewriteT(order,known,redexes,subterms,_)) = rw
        Rewrite(RewriteT(order, known, redexes, subterms, waiting))

    fun deleteWaiting(Rewrite(RewriteT(_,_,_,_,waiting)) as rw): fun(id): updateWaiting(rw)(Intset.delete(waiting)(id))

    fun newRewrite(order):
      Rewrite(
        RewriteT(
          order,
          Intmap.newMap(#void),
          Term_net.newNet(Term_net.Parameters(#false)),
          Term_net.newNet(Term_net.Parameters(#false)),
          Intset.empty
        )
      )

    fun peek(Rewrite(RewriteT(_,known,_,_,_))): fun(id): Intmap.peek(known)(id)

    fun size(Rewrite(RewriteT(_,known,_,_,_))): Intmap.size(known)

    fun equations(Rewrite(RewriteT(_,known,_,_,_))): Intmap.foldr((fun([_, [eqn, _], eqns]): PairList [eqn, & eqns]))(PairList [])(known)

    fun termReducible(order):
      fun(known):
        fun(id):
          let eqnRed = fun([[l, r], _]):
            fun(tm):
              match Useful.total(Substitute.matchTerms(Substitute.empty)(l))(tm)
              | None(): #false
              | Some(sub): (order(tm)(Substitute.subst(Substitute.normalize(sub))(r)) == Some(1))
          let knownRed = fun(tm): fun([eqnId, [eqn, ort]]): ((eqnId != id) && (((ort != Some(Right_to_left())) && eqnRed(eqn)(tm)) || ((ort != Some(Left_to_right())) && eqnRed(Rule.symEqn(eqn))(tm))))
          fun termRed_2(tm): (Intmap.exists(knownRed(tm))(known) || subtermRed_2(tm))
          fun subtermRed_2
          | subtermRed_2(Term.Var(_)): #false
          | subtermRed_2(Term.Fn([_, tms])): OCamlList.exists(termRed_2)(tms)
          termRed_2

    fun literalReducible(order): fun(known): fun(id): fun(lit): OCamlList.exists(termReducible(order)(known)(id))(Literal.arguments(lit))

    fun literalsReducible(order): fun(known): fun(id): fun(lits): Literal.Set.exists(literalReducible(order)(known)(id))(lits)

    fun thmReducible(order): fun(known): fun(id): fun(th): literalsReducible(order)(known)(id)(Thm.clause(th))

    fun orderToOrient(arg_2):
      match arg_2
      | Some(0): failwith("Rewrite.orient: reflexive")
      | Some(c):
          if (c > 0)
          | Some(Left_to_right())
          | match arg_2
            | Some(_): Some(Right_to_left())
            | None(): None()
      | Some(_): Some(Right_to_left())
      | None(): None()

    fun ins(redexes): fun(redex): fun(id): fun(ort): Term_net.insert(redexes)([redex, [id, ort]])

    fun addRedexes(id):
      fun([[[l, r], _], ort]):
        fun(redexes):
          match ort
          | Some(Left_to_right()): ins(redexes)(l)(id)(Left_to_right())
          | Some(Right_to_left()): ins(redexes)(r)(id)(Right_to_left())
          | None(): ins(ins(redexes)(l)(id)(Left_to_right()))(r)(id)(Right_to_left())

    fun add(Rewrite(RewriteT(_,known,_,_,_)) as rw):
      fun([id, eqn]):
        if Intmap.inDomain(id)(known)
        | rw
        | let Rewrite(RewriteT(order,_,redexes,subterms,waiting)) = rw
          let [l, r] = fst(eqn)
          let ort = orderToOrient(order(l)(r))
          let known = Intmap.insert(known)([id, [eqn, ort]])
          let redexes = addRedexes(id)([eqn, ort])(redexes)
          let waiting = Intset.add(waiting)(id)
          let rw = Rewrite(RewriteT(order, known, redexes, subterms, waiting))
          rw

    fun uncurriedAdd([eqn, rw]): add(rw)(eqn)

    fun addList(rw): fun(xs): Mlist.foldl(uncurriedAdd)(rw)(xs)

    fun reorder([i, _]): fun([j, _]): Useful.intCompare(j)(i)

    fun matchingRedexes(redexes): fun(tm): OCamlList.sort(reorder)(Term_net.matchNet(redexes)(tm))

    fun wellOriented(x):
      fun(y):
        match [x, y]
        | [None(), _]: #true
        | [Some(Left_to_right()), Left_to_right()]: #true
        | [Some(Right_to_left()), Right_to_left()]: #true
        | _: #false

    fun redexResidue(x):
      fun(y):
        match [x, y]
        | [Left_to_right(), [l_r, _]]: l_r
        | [Right_to_left(), [[l, r], _]]: [r, l]

    fun orientedEquation(dir):
      fun(eqn):
        match dir
        | Left_to_right(): eqn
        | Right_to_left(): Rule.symEqn(eqn)

    fun rewrIdConv_prime_impl(order):
      fun(known):
        fun(redexes):
          fun(id):
            fun(tm):
              let rewr:
                fun([id_prime, lr]):
                  let _ = ((id != id_prime) || failwith("same theorem"))
                  let [eqn, ort] = Intmap.get(known)(id_prime)
                  let _ = (wellOriented(ort)(lr) || failwith("orientation"))
                  let [l, r] = redexResidue(lr)(eqn)
                  let sub = Substitute.normalize(Substitute.matchTerms(Substitute.empty)(l)(tm))
                  let tm_prime = Substitute.subst(sub)(r)
                  let _ = (Option.is_some(ort) || ((order(tm)(tm_prime) == Some(1)) || failwith("order")))
                  let [_, th] = orientedEquation(lr)(eqn)
                  [tm_prime, Thm.subst(sub)(th)]
              match Mlist.first(Useful.total(rewr))(matchingRedexes(redexes)(tm))
              | None(): failwith("Rewrite.rewrIdConv: no matching rewrites")
              | Some(res): res

    fun rewriteIdConv_prime_impl(order): fun(known): fun(redexes): fun(id): (if Intmap.null(known) | Rule.allConv | Rule.repeatTopDownConv(rewrIdConv_prime_impl(order)(known)(redexes)(id)))

    fun mkNeqConv(order):
      fun(lit):
        fun(tm):
          let [l, r] = Literal.destNeq(lit)
          let subject = order(l)(r)
          match subject
          | None(): failwith("incomparable")
          | Some(c):
              if (c < 0)
              | let th = Rule.symmetryRule(l)(r)
                (if Term.equal(tm)(r) | [l, th] | failwith("mkNeqConv: RL"))
              | match subject
                | Some(0): failwith("irreflexive")
                | Some(_):
                    let th = Thm.assume(lit)
                    (if Term.equal(tm)(l) | [r, th] | failwith("mkNeqConv: LR"))
          | Some(0): failwith("irreflexive")
          | Some(_):
              let th = Thm.assume(lit)
              (if Term.equal(tm)(l) | [r, th] | failwith("mkNeqConv: LR"))

    variant neqConvs:
      Neq_convs(conversions)

    def neqConvsEmpty = Neq_convs(Literal.Map.newMap(#void))

    fun neqConvsNull(Neq_convs(m)): Literal.Map.null(m)

    fun neqConvsAdd(order):
      fun(Neq_convs(m)):
        fun(lit):
          match Useful.total(mkNeqConv(order))(lit)
          | None(): None()
          | Some(conv): Some(Neq_convs(Literal.Map.insert(m)([lit, conv])))

    fun mkNeqConvs(order):
      let add:
        fun([lit, [neq, lits]]):
          match neqConvsAdd(order)(neq)(lit)
          | Some(neq): [neq, lits]
          | None(): [neq, Literal.Set.add(lits)(lit)]
      Literal.Set.foldl(add)([neqConvsEmpty, Literal.Set.empty])

    fun neqConvsDelete(Neq_convs(m)): fun(lit): Neq_convs(Literal.Map.delete(m)(lit))

    fun neqConvsToConv(Neq_convs(m)): Rule.firstConv(Literal.Map.foldr((fun([_, c, l]): PairList [c, & l]))(PairList [])(m))

    fun neqConvsFoldl(f): fun(b): fun(Neq_convs(m)): Literal.Map.foldl((fun([l, _, z]): f([l, z])))(b)(m)

    fun neqConvsRewrIdLiterule(order):
      fun(known):
        fun(redexes):
          fun(id):
            fun(neq):
              if (Intmap.null(known) && neqConvsNull(neq))
              | Rule.allLiterule
              | let neq_conv = neqConvsToConv(neq)
                let rewr_conv = rewrIdConv_prime_impl(order)(known)(redexes)(id)
                let conv = Rule.orelseConv(neq_conv)(rewr_conv)
                let conv = Rule.repeatTopDownConv(conv)
                Rule.allArgumentsLiterule(conv)

    fun rewriteIdEqn_prime_impl(order):
      fun(known):
        fun(redexes):
          fun(id):
            fun([l_r, th] as eqn):
              let [neq, _] = mkNeqConvs(order)(Thm.clause(th))
              let literule = neqConvsRewrIdLiterule(order)(known)(redexes)(id)(neq)
              let [strongEqn, lit]:
                match Rule.equationLiteral(eqn)
                | None(): [#true, Literal.mkEq(l_r)]
                | Some(lit): [#false, lit]
              let [lit_prime, litTh] = literule(lit)
              if Literal.equal(lit)(lit_prime)
              | eqn
              | [
                  Literal.destEq(lit_prime),
                  if strongEqn
                  | th
                  | (if !Thm.negateMember(lit)(litTh) | litTh | Thm.resolve(lit)(th)(litTh))
                ]

    fun rewriteIdLiteralsRule_prime_impl(order):
      fun(known):
        fun(redexes):
          fun(id):
            fun(lits):
              fun(th):
                let mk_literule = neqConvsRewrIdLiterule(order)(known)(redexes)(id)
                let rewr_neq_lit:
                  fun([lit, [changed, neq, lits, th] as acc]):
                    let neq = neqConvsDelete(neq)(lit)
                    let [lit_prime, litTh] = mk_literule(neq)(lit)
                    if Literal.equal(lit)(lit_prime)
                    | acc
                    | let th = (if Thm.member(lit)(th) | Thm.resolve(lit)(th)(litTh) | th)
                      match neqConvsAdd(order)(neq)(lit_prime)
                      | Some(neq): [#true, neq, lits, th]
                      | None(): [changed, neq, Literal.Set.add(lits)(lit_prime), th]
                // Recursive disequality rewriting needs the local definition before its first use.
                fun rewr_neq_lits(neq):
                  fun(lits):
                    fun(th):
                      let [changed, neq, lits, th] = neqConvsFoldl(rewr_neq_lit)([#false, neq, lits, th])(neq)
                      (if changed | rewr_neq_lits(neq)(lits)(th) | [neq, lits, th])
                let [neq, lits] = mkNeqConvs(order)(lits)
                let [neq, lits, th] = rewr_neq_lits(neq)(lits)(th)
                let rewr_literule = mk_literule(neq)
                let rewr_lit = (fun([lit, th]): (if Thm.member(lit)(th) | Rule.literalRule(rewr_literule)(lit)(th) | th))
                Literal.Set.foldl(rewr_lit)(th)(lits)

    fun rewriteIdRule_prime_impl(order): fun(known): fun(redexes): fun(id): fun(th): rewriteIdLiteralsRule_prime_impl(order)(known)(redexes)(id)(Thm.clause(th))(th)

    fun rewrIdConv(Rewrite(RewriteT(_,known,redexes,_,_))): fun(order): rewrIdConv_prime_impl(order)(known)(redexes)

    fun rewrConv(rewrite): fun(order): rewrIdConv(rewrite)(order)(-1)

    fun rewriteIdConv(Rewrite(RewriteT(_,known,redexes,_,_))): fun(order): rewriteIdConv_prime_impl(order)(known)(redexes)

    fun rewriteConv(rewrite): fun(order): rewriteIdConv(rewrite)(order)(-1)

    fun rewriteIdLiteralsRule(Rewrite(RewriteT(_,known,redexes,_,_))): fun(order): rewriteIdLiteralsRule_prime_impl(order)(known)(redexes)

    fun rewriteLiteralsRule(rewrite): fun(order): rewriteIdLiteralsRule(rewrite)(order)(-1)

    fun rewriteIdRule(Rewrite(RewriteT(_,known,redexes,_,_))): fun(order): rewriteIdRule_prime_impl(order)(known)(redexes)

    fun rewriteRule(rewrite): fun(order): rewriteIdRule(rewrite)(order)(-1)

    fun addSubterms(id):
      fun([[l, r], _]):
        fun(subterms):
          let addSubterm = fun(b): fun([[path, tm], net]): Term_net.insert(net)([tm, [id, b, path]])
          let subterms = Mlist.foldl(addSubterm(#true))(subterms)(Term.subterms(l))
          let subterms = Mlist.foldl(addSubterm(#false))(subterms)(Term.subterms(r))
          subterms

    fun sameRedexes(x):
      fun(y):
        fun(z):
          match [x, y, z]
          | [None(), _, _]: #false
          | [Some(Left_to_right()), [l0, _], [l, _]]: Term.equal(l0)(l)
          | [Some(Right_to_left()), [_, r0], [_, r]]: Term.equal(r0)(r)

    fun redexResidues(x):
      fun([l, r]):
        match x
        | None(): PairList [[l, r, #false], [r, l, #false]]
        | Some(Left_to_right()): PairList [[l, r, #true]]
        | Some(Right_to_left()): PairList [[r, l, #true]]

    fun findReducibles(order):
      fun(known):
        fun(subterms):
          fun(id):
            let checkValidRewr:
              fun([l, r, ord]):
                fun(id_prime):
                  fun(left):
                    fun(path):
                      let [[[x, y], _], _] = Intmap.get(known)(id_prime)
                      let tm = Term.subterm((if left | x | y))(path)
                      let sub = Substitute.matchTerms(Substitute.empty)(l)(tm)
                      if ord
                      | #void
                      | let tm_prime = Substitute.subst(Substitute.normalize(sub))(r)
                        (if (order(tm)(tm_prime) == Some(1)) | #void | failwith("order"))
            let addRed = fun(lr): fun([[id_prime, left, path], todo]): (if ((id != id_prime) && (!Intset.member(id_prime)(todo) && can(checkValidRewr(lr)(id_prime)(left))(path))) | Intset.add(todo)(id_prime) | todo)
            let findRed = (fun([[l, _, _] as lr, todo]): Mlist.foldl(addRed(lr))(todo)(Term_net.matched(subterms)(l)))
            Mlist.foldl(findRed)

    fun reduce1(newx):
      fun(id):
        fun([eqn0, ort0]):
          fun([rpl, spl, todo, rw, changed]):
            let [eq0, _] = eqn0
            let Rewrite(RewriteT(order,known,redexes,subterms,waiting)) = rw
            let [eq, _] as eqn = rewriteIdEqn_prime_impl(order)(known)(redexes)(id)(eqn0)
            let [l0_2, r0_2] = eq0
            let [l_2, r_2] = eq
            let identical = (Term.equal(l_2)(l0_2) && Term.equal(r_2)(r0_2))
            let same_redexes = (identical || sameRedexes(ort0)(eq0)(eq))
            let rpl = (if same_redexes | rpl | Intset.add(rpl)(id))
            let spl = (if (newx || identical) | spl | Intset.add(spl)(id))
            let changed = (if (!newx && identical) | changed | Intset.add(changed)(id))
            let ort:
              if same_redexes
              | Some(ort0)
              | let [l, r] = eq
                Useful.total(orderToOrient)(order(l)(r))
            match ort
            | None():
                let known = Intmap.delete(known)(id)
                let rw = Rewrite(RewriteT(order, known, redexes, subterms, waiting))
                [rpl, spl, todo, rw, changed]
            | Some(ort):
                let todo = (if (!newx && same_redexes) | todo | findReducibles(order)(known)(subterms)(id)(todo)(redexResidues(ort)(eq)))
                let known = (if identical | known | Intmap.insert(known)([id, [eqn, ort]]))
                let redexes = (if same_redexes | redexes | addRedexes(id)([eqn, ort])(redexes))
                let subterms = (if (newx || !identical) | addSubterms(id)(eqn)(subterms) | subterms)
                let rw = Rewrite(RewriteT(order, known, redexes, subterms, waiting))
                [rpl, spl, todo, rw, changed]

    fun pick(known):
      fun(set):
        let oriented:
          fun(id):
            match Intmap.peek(known)(id)
            | Some([_, Some(_)] as x): Some([id, x])
            | _: None()
        let any:
          fun(id):
            match Intmap.peek(known)(id)
            | Some(x): Some([id, x])
            | _: None()
        match Intset.firstl(oriented)(set)
        | Some(_) as x: x
        | None(): Intset.firstl(any)(set)

    fun cleanRedexes(known):
      fun(redexes):
        fun(rpl):
          if Intset.null(rpl)
          | redexes
          | let filt = (fun([id, _]): !Intset.member(id)(rpl))
            let addReds:
              fun([id, reds]):
                match Intmap.peek(known)(id)
                | None(): reds
                | Some(eqn_ort): addRedexes(id)(eqn_ort)(reds)
            let redexes = Term_net.filter(filt)(redexes)
            let redexes = Intset.foldl(addReds)(redexes)(rpl)
            redexes

    fun cleanSubterms(known):
      fun(subterms):
        fun(spl):
          if Intset.null(spl)
          | subterms
          | let filt = (fun([id, _, _]): !Intset.member(id)(spl))
            let addSubtms:
              fun([id, subtms]):
                match Intmap.peek(known)(id)
                | None(): subtms
                | Some([eqn, _]): addSubterms(id)(eqn)(subtms)
            let subterms = Term_net.filter(filt)(subterms)
            let subterms = Intset.foldl(addSubtms)(subterms)(spl)
            subterms

    fun rebuild(rpl):
      fun(spl):
        fun(rw):
          let Rewrite(RewriteT(order,known,redexes,subterms,waiting)) = rw
          let redexes = cleanRedexes(known)(redexes)(rpl)
          let subterms = cleanSubterms(known)(subterms)(spl)
          Rewrite(RewriteT(order, known, redexes, subterms, waiting))

    fun reduceAcc([rpl, spl, todo, Rewrite(RewriteT(_,known,_,_,waiting)) as rw, changed]):
      match pick(known)(todo)
      | Some([id, eqn_ort]):
          let todo = Intset.delete(todo)(id)
          reduceAcc(reduce1(#false)(id)(eqn_ort)([rpl, spl, todo, rw, changed]))
      | None():
          match pick(known)(waiting)
          | Some([id, eqn_ort]):
              let rw = deleteWaiting(rw)(id)
              reduceAcc(reduce1(#true)(id)(eqn_ort)([rpl, spl, todo, rw, changed]))
          | None(): [rebuild(rpl)(spl)(rw), Intset.toList(changed)]

    fun isReduced(Rewrite(RewriteT(_,_,_,_,waiting))): Intset.null(waiting)

    fun reduce_prime_impl(rw): (if isReduced(rw) | [rw, PairList []] | reduceAcc([Intset.empty, Intset.empty, Intset.empty, rw, Intset.empty]))

    fun reduce(rw): fst(reduce_prime_impl(rw))

    fun addEqn([id_eqn, rw]): add(rw)(id_eqn)

    fun orderedRewrite(order):
      fun(ths):
        let rw = Mlist.foldl(addEqn)(newRewrite(order))(Mlist.enumerate(ths))
        rewriteRule(rw)(order)

    fun order_impl(_): fun(_): Some(1)

    def rewrite = orderedRewrite(order_impl)

  namespace Units:
    export:
      Units
      empty
      size
      toString
      add
      addList
      matchUnits
      reduce

    variant units:
      Units(net)

    def empty = Units(Literal_net.newNet(Term_net.Parameters(#false)))

    fun size(Units(net)): Literal_net.size(net)

    fun toString(units): ("U{" +& (to_string(size(units)) +& "}"))

    fun add(Units(net)):
      fun([lit, th] as uTh):
        let net = Literal_net.insert(net)([lit, uTh])
        match Useful.total(Literal.sym)(lit)
        | None(): Units(net)
        | Some([pol, _] as lit_prime):
            let th_prime = ((if pol | Rule.symEq | Rule.symNeq))(lit)(th)
            let net = Literal_net.insert(net)([lit_prime, [lit_prime, th_prime]])
            Units(net)

    def addList = Mlist.foldl((fun([th, u]): add(u)(th)))

    fun matchUnits(Units(net)):
      fun(lit):
        let check_2:
          fun([lit_prime, _] as uTh):
            match Useful.total(Literal.matchLiterals(Substitute.empty)(lit_prime))(lit)
            | None(): None()
            | Some(sub): Some([uTh, sub])
        Mlist.first(check_2)(Literal_net.matchNet(net)(lit))

    fun reduce(units):
      let red1:
        fun([lit, news_th]):
          match Useful.total(Literal.destIrrefl)(lit)
          | Some(tm):
              let [news, th] = news_th
              let th = Thm.resolve(lit)(th)(Thm.refl(tm))
              [news, th]
          | None():
              let lit_prime = Literal.negate(lit)
              match matchUnits(units)(lit_prime)
              | None(): news_th
              | Some([[_, rth], sub]):
                  let [news, th] = news_th
                  let rth = Thm.subst(sub)(rth)
                  let th = Thm.resolve(lit)(th)(rth)
                  let newLits = Literal.Set.delete(Thm.clause(rth))(lit_prime)
                  let news = Literal.Set.union(newLits)(news)
                  [news, th]
      fun red([news, th]): (if Literal.Set.null(news) | th | red(Literal.Set.foldl(red1)([Literal.Set.empty, th])(news)))
      (fun(th): Rule.removeSym(red([Thm.clause(th), th])))

  namespace Clause:
    export:
      newId
      No_literal_order
      Unsigned_literal_order
      Positive_literal_order
