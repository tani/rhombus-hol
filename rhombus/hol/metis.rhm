    curried fun treeUnion(compareKey, f, f2, tree1, tree2):
      match tree1
      | Empty(): tree2
      | Tree(node1):
          match tree2
          | Empty(): tree1
          | Tree(node2): nodeUnion(compareKey, f, f2, node1, node2)

    curried fun nodeUnion(compareKey, f, f2, node1, node2):
