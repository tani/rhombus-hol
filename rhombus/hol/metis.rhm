            | Empty(): Empty()
            | Node(TNode(l,v,r,_)) as t:
                let c = Set_ordered.compare(x)(v)
                if (c == 0)
                | merge_impl(l)(r)
                | if (c < 0)
                  | let ll = remove_impl(x)(l)
