  def [reset_consts_v2, fol_of_const_v2, hol_of_const] = [Meson.Meson.reset_consts, Meson.Meson.fol_of_const, Meson.Meson.hol_of_const]

  def preterm_of_const = o(o(TypeInference.preterm_of_term)(hol_of_const))(Host.hol_int_of_string)

  fun prefix(s): Host.hol_concat("__")(s)

  fun preterm_of_fol_term
  | preterm_of_fol_term(Metis_prover.Term.Var(x)): TypeInference.Varp(prefix(x), TypeInference.dpty)
  | preterm_of_fol_term(Metis_prover.Term.Fn([f, args])):
      let pf = preterm_of_const(f)
      let pargs = Host.OCamlList.map(preterm_of_fol_term)(args)
      Preterm.list_mk_combp([pf, pargs])

  fun preterm_of_predicate
  | preterm_of_predicate("="): TypeInference.Constp("=", TypeInference.dpty)
  | preterm_of_predicate(p): preterm_of_const(p)

  fun preterm_of_atom([p, args]):
    let pp = preterm_of_predicate(p)
    let pargs = Host.OCamlList.map(preterm_of_fol_term)(args)
    TypeInference.Typing(Preterm.list_mk_combp([pp, pargs]), TypeInference.pretype_of_type(bool_ty))

  fun preterm_of_literal([pol, fat]):
    let pat = preterm_of_atom(fat)
    (if pol | pat | Preterm.mk_negp(pat))

  fun preterm_of_eq([s, t]): Preterm.mk_eqp([preterm_of_fol_term(s), preterm_of_fol_term(t)])

  fun typecheck(env): o(o(TypeInference.term_of_preterm)(TypeInference.retypecheck(env)))(Preterm.unconst_preterm)

  fun typecheckl(env):
    fun
    | (PairList []): PairList []
    | (xs): Host.hol_pipe(Host.hol_pipe(Preterm.list_mk_disjp(xs))(typecheck(env)))(disjuncts)

  fun hol_of_term(env): o(typecheck(env))(preterm_of_fol_term)

  fun hol_of_atom(env): o(typecheck(env))(preterm_of_atom)

  fun hol_of_literal(env): o(typecheck(env))(preterm_of_literal)

  fun hol_of_clause(env): o(o(typecheck(env))(Preterm.list_mk_disjp))(map(preterm_of_literal))

  fun hol_of_substitution(env): o(o(map(dest_eq))(typecheckl(env)))(map(preterm_of_eq))

  def reset_consts = reset_consts_v2

  def fol_of_const = fol_of_const_v2

namespace Metis_path:
  export:
    hol_of_term_path
    hol_of_atom_path
    hol_of_literal_path

  curried fun hol_of_term_path(tm, path):
    match [tm, path]
    | [tm, PairList []]: [tm, ""]
    | [Metis_prover.Term.Fn([f, args]), PairList [i, & is]]:
        let arity = length(args)
        (if Host.hol_lt(i)(arity) | #void | failwith("Assertion failed"))
        let [tm_prime, path_prime] = hol_of_term_path(Host.OCamlList.nth(args)(i), is)
        [
          tm_prime,
          Host.hol_concat(Host.hol_string_make(Host.hol_sub(Host.hol_sub(arity)(i))(1))("l"))(Host.hol_concat("r")(path_prime))
        ]
    | _: failwith("hol_of_term_path")

  fun hol_of_atom_path([p, args]): hol_of_term_path(Metis_prover.Term.Fn([p, args]))

  curried fun hol_of_literal_path([pol, atom], path):
    let [s, path] = hol_of_atom_path(atom)(path)
    [s, (if pol | path | Host.hol_concat("r")(path))]

namespace Metis_unify:
  export:
    verb
    Unify
    unify_fo_ho_term
    unify_fo_ho_atom
    unify_fo_ho_literal

  def verb = Box(#false)

  class Unify()

  curried fun unify_fo_ho_term(vars, fat, tm, m):
    (if Host.ref_get(verb) | Host.hol_printf("unify_fo_ho_term: fat = %s, tm = %s\n%!")(Metis_prover.Term.toString(fat))(Host.string_of_term(tm)) | #void)
    match fat
    | Metis_prover.Term.Var(v):
        if Host.OCamlList.mem_assoc(v)(m)
        | (if Host.ref_get(verb) | Host.hol_printf("var_assoc\n%!") | #void)
          let tm_prime = Host.OCamlList.assoc(v)(m)
          (if Host.hol_equal(tm)(tm_prime) | m | Host.hol_raise(Unify()))
        | match fat
          | Metis_prover.Term.Var(v):
              (if Host.ref_get(verb) | Host.hol_printf("var\n%!") | #void)
              if (is_var(tm) && Host.hol_not(Host.OCamlList.mem(tm)(vars)))
              | PairList [[v, tm], & m]
              | (if Host.ref_get(verb) | Host.hol_printf("Unify!\n%!") | #void)
                Host.hol_raise(Unify())
          | Metis_prover.Term.Fn([f, args]):
              (if Host.ref_get(verb) | Host.hol_printf("fn\n%!") | #void)
              let [hf, hargs]:
                try:
                  strip_comb(tm)
                  ~catch exn:
                    match exn
                    | Failure(_): Host.hol_raise(Unify())
                    | exn: Host.hol_raise(exn)
              if Host.ref_get(verb)
              | Host.hol_printf("hf = %s\n%!")(Host.string_of_term(hf))
                Host.hol_printf("is_var: %s\n%!")((if is_var(hf) | "true" | "false"))
              | #void
              (if (is_const(hf) || is_var(hf)) | #void | failwith("Assertion failed"))
              (if Host.hol_equal(hf)(Metis_mapping.hol_of_const(Host.hol_int_of_string(f))) | itlist2(unify_fo_ho_term(vars))(args)(hargs)(m) | Host.hol_raise(Unify()))
    | Metis_prover.Term.Var(v):
        (if Host.ref_get(verb) | Host.hol_printf("var\n%!") | #void)
        if (is_var(tm) && Host.hol_not(Host.OCamlList.mem(tm)(vars)))
        | PairList [[v, tm], & m]
        | (if Host.ref_get(verb) | Host.hol_printf("Unify!\n%!") | #void)
          Host.hol_raise(Unify())
    | Metis_prover.Term.Fn([f, args]):
        (if Host.ref_get(verb) | Host.hol_printf("fn\n%!") | #void)
        let [hf, hargs]:
          try:
            strip_comb(tm)
            ~catch exn:
              match exn
              | Failure(_): Host.hol_raise(Unify())
              | exn: Host.hol_raise(exn)
        if Host.ref_get(verb)
        | Host.hol_printf("hf = %s\n%!")(Host.string_of_term(hf))
          Host.hol_printf("is_var: %s\n%!")((if is_var(hf) | "true" | "false"))
        | #void
        (if (is_const(hf) || is_var(hf)) | #void | failwith("Assertion failed"))
        (if Host.hol_equal(hf)(Metis_mapping.hol_of_const(Host.hol_int_of_string(f))) | itlist2(unify_fo_ho_term(vars))(args)(hargs)(m) | Host.hol_raise(Unify()))

  curried fun unify_fo_ho_atom(vars, [p, args], htm, m):
    if Host.hol_equal(p)("=")
    | try:
        let [hl, hr] = dest_eq(htm)
        itlist2(unify_fo_ho_term(vars))(args)(PairList [hl, hr])(m)
        ~catch exn:
          match exn
          | Failure(_): Host.hol_raise(Unify())
          | exn: Host.hol_raise(exn)
    | unify_fo_ho_term(vars, Metis_prover.Term.Fn([p, args]), htm, m)

  curried fun unify_fo_ho_literal(vars, [pol, atom], htm, m):
    let htm_prime:
      if pol
      | htm
      | try:
          dest_neg(htm)
          ~catch exn:
            match exn
            | Failure(_): Host.hol_raise(Unify())
            | exn: Host.hol_raise(exn)
    unify_fo_ho_atom(vars, atom, htm_prime, m)

namespace Metis_rules:
  export:
    FRONT
    RESOLVE_N
    RESOLVE
    DISCH_DISJ
    DISCH_DISJS

  curried fun FRONT(lit, thm):
    let conc = concl(thm)
    let disj = disjuncts(concl(thm))
    let rest:
      match partition((fun(l): Host.hol_equal(l)(lit)))(disj)
      | [PairList [], _]: failwith("FRONT: literal not in disjunction")
      | [_, r]: r
    let disj_prime = PairList [lit, & rest]
    let conc_prime = list_mk_disj(disj_prime)
    let eq = DISJ_ACI_RULE(mk_eq([conc, conc_prime]))
    [PURE_ONCE_REWRITE_RULE(PairList [eq])(thm), rest]

  def RESOLVE_N:
    let RESOLVE_1_2 = TAUT(Host.hol_term(Forall("a", Bool, Implies(Ref("a"), Implies(Not(Ref("a")), False)))))
    let RESOLVE_2L_2:
      TAUT(
        Host.hol_term(Forall(
          "a",
          Bool,
          Forall("b", Bool, Implies(Or(Ref("a"), Ref("b")), Implies(Not(Ref("a")), Ref("b"))))
        ))
      )
    let RESOLVE_2R_2:
      TAUT(
        Host.hol_term(Forall(
          "a",
          Bool,
          Forall("c", Bool, Implies(Ref("a"), Implies(Or(Not(Ref("a")), Ref("c")), Ref("c"))))
        ))
      )
    let RESOLVE_3_2:
      TAUT(
        Host.hol_term(Forall(
          "a",
          Bool,
          Forall(
            "b",
            Bool,
            Forall(
              "c",
              Bool,
              Implies(Or(Ref("a"), Ref("b")), Implies(Or(Not(Ref("a")), Ref("c")), Or(Ref("b"), Ref("c"))))
            )
          )
        ))
      )
    fun(atom):
      fun
      | ([PairList [], PairList []]): SPEC(atom)(RESOLVE_1_2)
      | ([r1, PairList []]): SPECL(PairList [atom, list_mk_disj(r1)], RESOLVE_2L_2)
      | ([PairList [], r2]): SPECL(PairList [atom, list_mk_disj(r2)], RESOLVE_2R_2)
      | ([r1, r2]): SPECL(PairList [atom, list_mk_disj(r1), list_mk_disj(r2)], RESOLVE_3_2)

  curried fun RESOLVE(atom, th1, th2):
    try:
      let [th1_prime_2, r1_2] = FRONT(atom, th1)
      let [th2_prime_2, r2_2] = FRONT(mk_neg(atom), th2)
      let res = RESOLVE_N(atom)([r1_2, r2_2])
      MP(MP(res)(th1_prime_2))(th2_prime_2)
      ~catch exn:
        match exn
        | Failure(_): failwith("resolve")
        | exn: Host.hol_raise(exn)

  def DISCH_DISJ:
    let IMPL_NOT_L_2:
      TAUT(
        Host.hol_term(Forall(
          "a",
          Bool,
          Forall("b", Bool, Iff(Implies(Not(Ref("a")), Ref("b")), Or(Ref("a"), Ref("b"))))
        ))
      )
    let IMPL_NOT_R_2:
      TAUT(
        Host.hol_term(Forall(
          "a",
          Bool,
          Forall("b", Bool, Iff(Implies(Ref("a"), Ref("b")), Or(Not(Ref("a")), Ref("b"))))
        ))
      )
    fun(tm):
      fun(th):
        let impl_2 = DISCH(tm)(th)
        let [tm_prime_2, IMPL_NOT_2]:
          try:
            [dest_neg(tm), IMPL_NOT_L_2]
            ~catch exn:
              match exn
              | Failure(_): [tm, IMPL_NOT_R_2]
              | exn: Host.hol_raise(exn)
        let eq = SPECL(PairList [tm_prime_2, concl(th)], IMPL_NOT_2)
        PURE_ONCE_REWRITE_RULE(PairList [eq])(impl_2)

  curried fun DISCH_DISJS(tms, th): Host.OCamlList.fold_right(DISCH_DISJ)(tms)(th)

namespace Metis_reconstruct2:
  export:
    term_eq_mod_type
    match_elems
    match_fo_ho_clause
    string_of_tminst
    string_of_tyinst
    string_of_instantiation
    reorient_tysubst
    hol_of_thm

  curried fun term_eq_mod_type(t1, t2, tyinsts):
    try:
      let [_, tminsts, tyinsts] = term_type_unify(t1)(t2)([PairList [], PairList [], tyinsts])
      if Host.ref_get(metisverb)
      | Host.hol_printf("unified with |tminsts| = %d!\n%!")(Host.OCamlList.length(tminsts))
        Host.OCamlList.iter(
          (fun([t1, t2]): Host.hol_printf("%s <- %s\n%!")(Host.string_of_term(t1))(Host.string_of_term(t2)))
        )(tminsts)
      | #void
      (if Host.hol_equal(tminsts)(PairList []) | Host.Some(tyinsts) | Host.None())
      ~catch exn:
        match exn
        | Failure(_): Host.None()
        | exn: Host.hol_raise(exn)

  curried fun match_elems(f, m):
    fun
    | ([PairList [], PairList []]): PairList [m]
    | ([PairList [], _]): PairList []
    | ([PairList [x, & xs], ys]):
        Host.hol_pipe(
          Host.OCamlList.map(
            fun(y):
              match f(x)(y)(m)
              | Host.Some(m_prime): match_elems(f, m_prime)([xs, Host.OCamlList.filter(Host.hol_physical_unequal(y))(ys)])
              | Host.None(): PairList []
          )(ys)
        )(Host.OCamlList.concat)

  fun match_fo_ho_clause(vars):
    match_elems(
      fun(ft):
        fun(ht):
          fun(m):
            try:
              Host.Some(Metis_unify.unify_fo_ho_literal(vars)(ft)(ht)(m))
              ~catch exn:
                match exn
                | Metis_unify.Unify(): Host.None()
                | exn: Host.hol_raise(exn),
      PairList []
    )

  def string_of_tminst:
    o(Host.hol_string_concat(", "))(
      map(
        (fun([tm, v]): Host.hol_concat(Host.string_of_term(tm))(Host.hol_concat(" <- ")(Host.string_of_term(v))))
      )
    )

  def string_of_tyinst:
    o(Host.hol_string_concat(", "))(
      map(
        (fun([ty, v]): Host.hol_concat(Host.string_of_type(ty))(Host.hol_concat(" <- ")(Host.string_of_type(v))))
      )
    )

  fun string_of_instantiation([it, tminst, tyinst]):
    Host.hol_concat("([")(
      Host.hol_concat(string_of_tminst(tminst))(Host.hol_concat("], [")(Host.hol_concat(string_of_tyinst(tyinst))("])")))
    )

  curried fun reorient_tysubst(vars, sub):
    let sub_prime:
      map(
        (fun([ty, v]): (if (Host.OCamlList.mem(v)(vars) && is_vartype(ty)) | [v, ty] | [ty, v]))
      )(sub)
    map((fun([ty, v]): [tysubst(sub_prime)(ty), v]))(sub_prime)

  curried fun hol_of_thm(axioms, fth):
    (if Host.ref_get(metisverb) | Host.hol_printf("hol_of_thm: %s\n%!")(Metis_prover.Thm.toString(fth)) | #void)
    let env = Preterm.env_of_ths(axioms)
    let hth:
      match Metis_prover.Proof.thmToInference(fth)
      | Metis_prover.Proof.Axiom(clause):
          let clausel = Metis_prover.Literal.Set.toList(clause)
          let maxs:
            Utils.List.concat_map(
              fun(ax):
                let disjs = Host.hol_pipe(concl(ax))(striplist(dest_disj))
                let tmvars = freesl(hyp(ax))
                let ms = match_fo_ho_clause(tmvars)([clausel, disjs])
                map((fun(m): [m, ax]))(ms)
            )(axioms)
          (if Host.hol_gt(Host.OCamlList.length(maxs))(0) | #void | failwith("Assertion failed"))
          let tminst = Host.OCamlList.map((fun([v, tm]): [mk_var([Metis_mapping.prefix(v), type_of(tm)]), tm]))
          (if Host.ref_get(metisverb) | Host.hol_printf("length maxs = %d\n%!")(Host.OCamlList.length(maxs)) | #void)
          if Host.ref_get(metisverb)
          | Host.OCamlList.iter(
              (fun([m, ax]): Host.hol_printf("max: %s with m = %s\n%!")(Host.string_of_thm(ax))(string_of_tminst(tminst(m))))
            )(maxs)
          | #void
          let [m, ax] = Host.OCamlList.hd(maxs)
          INST(tminst(m))(ax)
      | Metis_prover.Proof.Subst(fsub,fth1):
          let th1 = hol_of_thm(axioms, fth1)
          (if Host.ref_get(metisverb) | Host.hol_printf("subst with th1 = %s\n%!")(Host.string_of_thm(th1)) | #void)
          let fsubl = Metis_prover.Substitute.toList(fsub)
          (if Host.ref_get(metisverb) | Host.hol_printf("before substitution lifting\n%!") | #void)
          let hsub = Host.hol_pipe(map((fun([v, t]): [t, Metis_prover.Term.Var(v)]))(fsubl))(Metis_mapping.hol_of_substitution(env))
          (if Host.ref_get(metisverb) | Host.hol_printf("subst: %s\n%!")(string_of_tminst(hsub)) | #void)
          let tyinst:
            itlist(
              fun([t, v]):
                fun(m):
                  let v_prime = find((fun(v_prime): Host.hol_equal(Host.name_of(v_prime))(Host.name_of(v))))(frees(concl(th1)))
                  type_unify(type_of(v))(type_of(v_prime))(m)
            )(hsub)(PairList [])
          let tminst = map((fun([t, v]): [inst(tyinst)(t), inst(tyinst)(v)]))(hsub)
          (if Host.ref_get(metisverb) | Host.hol_printf("before instantiate of th1 = %s with %s\n%!")(Host.string_of_thm(th1))(string_of_instantiation([PairList [], tminst, tyinst])) | #void)
          INSTANTIATE([PairList [], tminst, tyinst])(th1)
      | Metis_prover.Proof.Resolve(atom,fth1,fth2):
          let th1_2 = hol_of_thm(axioms, fth1)
          let th2_2 = hol_of_thm(axioms, fth2)
          let env = append(Preterm.env_of_ths(PairList [th1_2, th2_2]))(env)
          if Host.ref_get(metisverb)
          | Host.OCamlList.iter(
              (fun([s, pty]): Host.hol_printf("%s <- %s\n%!")(s)(Host.string_of_type(TypeInference.type_of_pretype(pty))))
            )(env)
          | #void
          (if Host.ref_get(metisverb) | Host.hol_printf("before resolving\n%!") | #void)
          (if Host.ref_get(metisverb) | Host.hol_printf("th1 = %s\n%!")(Host.string_of_thm(th1_2)) | #void)
          (if Host.ref_get(metisverb) | Host.hol_printf("th2 = %s\n%!")(Host.string_of_thm(th2_2)) | #void)
          let tm1_2 = Host.hol_pipe(striplist(dest_disj)(concl(th1_2)))(Host.OCamlList.filter(o(Host.hol_not)(is_neg)))
          let tm2_2:
            Host.hol_pipe(
              Host.hol_pipe(striplist(dest_disj)(concl(th2_2)))(Host.OCamlList.filter(is_neg))
            )(Host.OCamlList.map(dest_neg))
          (if Host.ref_get(metisverb) | Host.OCamlList.iter(o(Host.hol_printf("tm1: %s\n%!"))(Host.string_of_term))(tm1_2) | #void)
          (if Host.ref_get(metisverb) | Host.OCamlList.iter(o(Host.hol_printf("tm2: %s\n%!"))(Host.string_of_term))(tm2_2) | #void)
          let hatom = Metis_mapping.hol_of_atom(env)(atom)
          (if Host.ref_get(metisverb) | Host.hol_printf("hatom: %s\n%!")(Host.string_of_term(hatom)) | #void)
          let cands:
            Utils.List.concat_map(
              fun(x):
                match term_eq_mod_type(hatom, x, PairList [])
                | Host.None(): PairList []
                | Host.Some(m): Utils.List.filter_map((fun(y): term_eq_mod_type(hatom, y, m)))(tm2_2)
            )(tm1_2)
          (if Host.ref_get(metisverb) | Host.hol_printf("%d candidates available\n%!")(Host.OCamlList.length(cands)) | #void)
          (if Host.hol_gt(Host.OCamlList.length(cands))(0) | #void | failwith("Assertion failed"))
          let h = Host.OCamlList.hd(cands)
          (if Host.OCamlList.for_all(Host.hol_equal(h))(cands) | #void | failwith("Assertion failed"))
          let tyinsts = Host.OCamlList.hd(cands)
          let tyvars:
            Host.hol_pipe(
              Host.hol_pipe(Host.hol_pipe(map(hyp)(axioms))(Host.OCamlList.concat))(map(type_vars_in_term))
            )(Host.OCamlList.concat)
          (if Host.ref_get(metisverb) | Host.hol_printf("Reorienting type substitution ...\n%!") | #void)
          let tyinsts = reorient_tysubst(tyvars, tyinsts)
          (if Host.ref_get(metisverb) | Host.hol_printf("Resolving ...\n%!") | #void)
          Metis_rules.RESOLVE(inst(tyinsts)(hatom))(INST_TYPE(tyinsts)(th1_2))(INST_TYPE(tyinsts)(th2_2))
      | Metis_prover.Proof.Refl(term): REFL(Metis_mapping.hol_of_term(env)(term))
      | Metis_prover.Proof.Assume(atom): SPEC(Metis_mapping.hol_of_atom(env)(atom))(EXCLUDED_MIDDLE)
      | Metis_prover.Proof.Equality(flit,fpath,ft):
          let hlit = Metis_mapping.hol_of_literal(env)(flit)
          let [fs, hpath] = Metis_path.hol_of_literal_path(flit)(fpath)
          let hs = follow_path(hpath)(hlit)
          let ht = Metis_mapping.hol_of_term(env)(ft)
          let m = type_unify(type_of(ht))(type_of(hs))(PairList [])
          let [hlit, hs, ht] = [inst(m)(hlit), inst(m)(hs), inst(m)(ht)]
          if Host.ref_get(metisverb)
          | Host.hol_printf("Trying to replace %s : %s with %s : %s\n%!")(Host.string_of_term(hs))(Host.string_of_type(type_of(hs)))(Host.string_of_term(ht))(Host.string_of_type(type_of(ht)))
            Host.hol_printf("In %s\n%!")(Host.string_of_term(hlit))
          | #void
          let heq = mk_eq([hs, ht])
          let conv = PATH_CONV(hpath)(PURE_ONCE_REWRITE_CONV(PairList [ASSUME(heq)]))
          let hlit_prime = CONV_RULE(conv)(ASSUME(hlit))
          (if Host.ref_get(metisverb) | Host.hol_printf("hlit = %s, hlit' = %s\n%!")(Host.string_of_term(hlit))(Host.string_of_thm(hlit_prime)) | #void)
          if Host.hol_unequal(hs)(ht)
          | (if Host.hol_unequal(concl(hlit_prime))(hlit) | #void | failwith("Assertion failed"))
          | #void
          try:
            Metis_rules.DISCH_DISJS(PairList [heq, hlit])(hlit_prime)
            ~catch exn:
              match exn
              | Failure(_): failwith("equality")
              | exn: Host.hol_raise(exn)
    let hth = CONV_RULE(DISJ_CANON_CONV)(hth)
    if Host.ref_get(metisverb)
    | Host.hol_printf("hol_of_thm finished\n%!")
      let hth_prime = Host.hol_pipe(Host.hol_pipe(Metis_prover.Thm.clause(fth))(Metis_prover.Literal.Set.toList))(Metis_mapping.hol_of_clause(env))
      Host.hol_printf("hol_of_thm returned:\n%s\n for\n%s\n%!")(Host.string_of_term(concl(hth)))(Host.string_of_term(hth_prime))
    | #void
    hth

namespace Metis_generate:
  export:
    metis_name
    metis_of_term
    metis_of_atom
    metis_of_literal
    metis_of_clause
    metis_of_clauses

  def metis_name = Host.hol_string_of_int

  curried fun metis_of_term(env, consts, tm):
    if (is_var(tm) && Host.hol_not(Host.OCamlList.mem(tm)(consts)))
    | Metis_prover.Term.Var(metis_name(Meson.Meson.fol_of_var(tm)))
    | let [f, args] = strip_comb(tm)
      if Host.OCamlList.mem(f)(env)
      | failwith("metis_of_term: higher order")
      | let ff = Meson.Meson.fol_of_const(f)
        Metis_prover.Term.Fn([metis_name(ff), map(metis_of_term(env, consts))(args)])

  curried fun metis_of_atom(env, consts, tm):
    try:
      let [l, r] = dest_eq(tm)
      let l_prime_2 = metis_of_term(env, consts, l)
      let r_prime_2 = metis_of_term(env, consts, r)
      Metis_prover.Atom.mkEq([l_prime_2, r_prime_2])
      ~catch exn:
        match exn
        | Failure(_):
            let [f, args] = strip_comb(tm)
            if Host.OCamlList.mem(f)(env)
            | failwith("metis_of_atom: higher order")
            | let ff = Meson.Meson.fol_of_const(f)
              [metis_name(ff), map(metis_of_term(env, consts))(args)]
        | exn: Host.hol_raise(exn)

  curried fun metis_of_literal(env, consts, tm):
    let [pol, tm_prime]:
      try:
        [#false, dest_neg(tm)]
        ~catch exn:
          match exn
          | Failure(_): [#true, tm]
          | exn: Host.hol_raise(exn)
    [pol, metis_of_atom(env, consts, tm_prime)]

  fun metis_of_clause(th):
    let lconsts = freesl(hyp(th))
    let tm = concl(th)
    let hlits = disjuncts(tm)
    let flits = map(metis_of_literal(PairList [], lconsts))(hlits)
    let set = Metis_prover.Literal.Set.fromList(flits)
    Metis_prover.Thm.axiom(set)

  def metis_of_clauses = map(metis_of_clause)

namespace Metis:
  export:
    split_limit
    PRINT_TAC
    PRINT_ID_TAC
    FOL_PREPARE_TAC
    without_warnings
    SIMPLE_METIS_REFUTE
    PURE_METIS_TAC
    GEN_METIS_TAC

  def split_limit = Box(0)

  fun PRINT_TAC(g):
    Host.print_goal(g)
    ALL_TAC(g)

  curried fun PRINT_ID_TAC(s, g):
    Host.hol_print_endline(s)
    PRINT_TAC(g)

  fun FOL_PREPARE_TAC(ths):
    (
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  REFUTE_THEN(ASSUME_TAC) then_tac \
                                  Meson.Meson.POLY_ASSUME_TAC(map(GEN_ALL)(ths))
                                ) then_tac \
                                W(o(MAP_EVERY(o(o(UNDISCH_TAC)(concl))(snd)))(fst))
                              ) then_tac \
                              SELECT_ELIM_TAC
                            ) then_tac \
                            W((fun([asl, w]): MAP_EVERY((fun(v): SPEC_TAC([v, v])))(frees(w))))
                          ) then_tac \
                          CONV_TAC(
                            (
                              (
                                (
                                  (PRESIMP_CONV then_conv TOP_DEPTH_CONV(BETA_CONV)) then_conv \
                                  LAMBDA_ELIM_CONV
                                ) then_conv \
                                CONDS_CELIM_CONV
                              ) then_conv \
                              Meson.Meson.QUANT_BOOL_CONV
                            )
                          )
                        ) then_tac \
                        REPEAT((GEN_TAC or_tac DISCH_TAC))
                      ) then_tac \
                      REFUTE_THEN(ASSUME_TAC)
                    ) then_tac \
                    RULE_ASSUM_TAC(CONV_RULE((NNF_CONV then_conv SKOLEM_CONV)))
                  ) then_tac \
                  REPEAT(FIRST_X_ASSUM(CHOOSE_TAC))
                ) then_tac \
                ASM_FOL_TAC
              ) then_tac \
              Meson.Meson.SPLIT_TAC(Host.ref_get(split_limit))
            ) then_tac \
            RULE_ASSUM_TAC(CONV_RULE((PRENEX_CONV then_conv WEAK_CNF_CONV)))
          ) then_tac \
          RULE_ASSUM_TAC(
            Host.repeat(
              (fun(th): SPEC(genvar(type_of(fst(dest_forall(concl(th))))))(th))
            )
          )
        ) then_tac \
        REPEAT(FIRST_X_ASSUM(Meson.Meson.CONJUNCTS_THEN_prime(ASSUME_TAC)))
      ) then_tac \
      RULE_ASSUM_TAC(CONV_RULE(ASSOC_CONV(DISJ_ASSOC)))
    )

  fun without_warnings(f):
    let tiv = Host.ref_get(TypeInference.type_invention_warning)
    let reset = (fun(_): Host.ref_set(TypeInference.type_invention_warning)(tiv))
    Host.ref_set(TypeInference.type_invention_warning)(#false)
    try:
      let y = Host.hol_apply_unit(f)
      Host.hol_apply_unit(reset)
      y
      ~catch exn:
        match exn
        | e:
            Host.hol_apply_unit(reset)
            Host.hol_raise(e)
        | exn: Host.hol_raise(exn)

  fun SIMPLE_METIS_REFUTE(ths):
    Host.hol_apply_unit(Meson.Meson.clear_contrapos_cache)
    Host.ocaml_random_init(0)
    let rules = Metis_generate.metis_of_clauses(ths)
    if Host.ref_get(metisverb)
    | Host.hol_printf("Original ths:\n%!")
      Host.OCamlList.iter(o(Host.hol_printf("%s\n%!"))(Host.string_of_thm))(ths)
    | #void
    let res = Metis_prover.Loop.run(rules)
    (if Host.ref_get(metisverb) | Metis_prover.Thm.print_proof(res) | #void)
    let ths = map(CONV_RULE(DISJ_CANON_CONV))(ths)
    let proof = without_warnings((fun(_): Metis_reconstruct2.hol_of_thm(ths)(res)))
    if Host.ref_get(metisverb)
    | Host.hol_printf("ths:\n%!")
      Host.OCamlList.iter(
        fun(t):
          Host.print_thm(t)
          Host.hol_printf("\n%!")
      )(ths)
      Host.hol_printf("Metis theorem:\n%!")
      Host.print_thm(proof)
      Host.hol_printf("Metis end.\n%!")
    | #void
    let allhyps = Host.OCamlList.concat(Host.OCamlList.map(hyp)(ths))
    (if forall((fun(h): Host.OCamlList.mem(h)(allhyps)))(hyp(proof)) | #void | failwith("Assertion failed"))
    (if Host.hol_equal(concl(proof))(Host.hol_term(False)) | #void | failwith("Assertion failed"))
    proof

  fun PURE_METIS_TAC(g):
    Host.hol_apply_unit(Meson.Meson.reset_vars)
    Host.hol_apply_unit(Meson.Meson.reset_consts)
    (
      FIRST_ASSUM(CONTR_TAC) or_tac \
      W(o(o(o(ACCEPT_TAC)(SIMPLE_METIS_REFUTE))(map(snd)))(fst))
    )(g)

  fun GEN_METIS_TAC(ths): (FOL_PREPARE_TAC(ths) then_tac PURE_METIS_TAC)

def ASM_METIS_TAC = Metis.GEN_METIS_TAC

fun METIS_TAC(ths): (POP_ASSUM_LIST(K(ALL_TAC)) then_tac ASM_METIS_TAC(ths))

curried fun METIS(ths, tm): prove([tm, METIS_TAC(ths)])
