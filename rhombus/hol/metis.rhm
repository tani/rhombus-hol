    fun polarity([pol, _]): pol

    fun atom([_, atm]): atm

    fun name(lit): Atom.name(atom(lit))

    fun arguments(lit): Atom.arguments(atom(lit))

    fun arity(lit): Atom.arity(atom(lit))

    fun positive(lit): polarity(lit)

    fun negative(lit): !polarity(lit)

    fun negate([pol, atm]): [!pol, atm]

    fun relation(lit): Atom.relation(atom(lit))

    fun functions(lit): Atom.functions(atom(lit))

    fun functionNames(lit): Atom.functionNames(atom(lit))

    fun mkBinop(rel): fun([pol, a, b]): [pol, Atom.mkBinop(rel)([a, b])]

    fun destBinop(rel):
      fun([pol, atm]):
        match Atom.destBinop(rel)(atm)
        | [a, b]: [pol, a, b]

    fun isBinop(rel): can(destBinop(rel))

    fun toFormula
    | toFormula([#true, atm]): Formula.Atom(atm)
    | toFormula([#false, atm]): Formula.Not(Formula.Atom(atm))

    fun fromFormula
    | fromFormula(Formula.Atom(atm)): [#true, atm]
    | fromFormula(Formula.Not(Formula.Atom(atm))): [#false, atm]
    | fromFormula(_): failwith("Literal.fromFormula")

    fun symbols([_, atm]): Atom.symbols(atm)

    def compare_impl = Useful.prodCompare(Useful.boolCompare)(Atom.compare)

    fun equal([p1, atm1]): fun([p2, atm2]): ((p1 == p2) && Atom.equal(atm1)(atm2))

    fun subterm(lit): fun(path): Atom.subterm(atom(lit))(path)

    fun subterms(lit): Atom.subterms(atom(lit))

    fun replace([pol, atm] as lit):
      fun(path_tm):
        let atm_prime = Atom.replace(atm)(path_tm)
        (if (atm === atm_prime) | lit | [pol, atm_prime])

    fun freeIn(v): fun(lit): Atom.freeIn(v)(atom(lit))

    fun freeVars(lit): Atom.freeVars(atom(lit))

    fun subst(sub):
      fun([pol, atm] as lit):
        let atm_prime = Atom.subst(sub)(atm)
        (if (atm_prime === atm) | lit | [pol, atm_prime])

    fun matchLiterals(sub):
      fun([pol1, atm1]):
        fun([pol2, atm2]):
          let _ = ((pol1 == pol2) || failwith("Literal.match"))
          Atom.matchAtoms(sub)(atm1)(atm2)

    fun unify(sub):
      fun([pol1, atm1]):
        fun([pol2, atm2]):
          let _ = ((pol1 == pol2) || failwith("Literal.unify"))
          Atom.unify(sub)(atm1)(atm2)

    fun mkEq(l_r): [#true, Atom.mkEq(l_r)]

    fun destEq
    | destEq([#true, atm]): Atom.destEq(atm)
    | destEq([#false, _]): failwith("Literal.destEq")

    def isEq = can(destEq)

    fun mkNeq(l_r): [#false, Atom.mkEq(l_r)]

    fun destNeq
    | destNeq([#false, atm]): Atom.destEq(atm)
    | destNeq([#true, _]): failwith("Literal.destNeq")

    def isNeq = can(destNeq)

    fun mkRefl(tm): [#true, Atom.mkRefl(tm)]

    fun destRefl
    | destRefl([#true, atm]): Atom.destRefl(atm)
    | destRefl([#false, _]): failwith("Literal.destRefl")

    def isRefl = can(destRefl)

    fun mkIrrefl(tm): [#false, Atom.mkRefl(tm)]

    fun destIrrefl
    | destIrrefl([#true, _]): failwith("Literal.destIrrefl")
    | destIrrefl([#false, atm]): Atom.destRefl(atm)

    def isIrrefl = can(destIrrefl)

    fun sym([pol, atm]): [pol, Atom.sym(atm)]

    fun lhs([_, atm]): Atom.lhs(atm)

    fun rhs([_, atm]): Atom.rhs(atm)

    fun typedSymbols([_, atm]): Atom.typedSymbols(atm)

    fun nonVarTypedSubterms([_, atm]): Atom.nonVarTypedSubterms(atm)

    fun toString(literal): Formula.toString(toFormula(literal))

