    record Simplify(subsumes, reduce, rewrites)

    record Parameters(clause, prefactor, postfactor)

    record ActiveT(parameters, clauses, units, rewrite, subsume, literals, equations, subterms, allSubterms)

    variant active:
      Active(state)

    fun getSubsume(Active(ActiveT(_,_,_,_,s,_,_,_,_))): s

    curried fun setRewrite(active, rewrite):
      let Active(ActiveT(parameters,clauses,units,_,subsume,literals,equations,subterms,allSubterms)) = active
      Active(
        ActiveT(parameters, clauses, units, rewrite, subsume, literals, equations, subterms, allSubterms)
      )

    def maxSimplify = Simplify(#true, #true, #true)

    def default = Parameters(Clause.default, maxSimplify, maxSimplify)

    fun empty(parameters):
      let Parameters(clause,_,_) = parameters
      let Clause.Parameters(ordering,_,_) = clause
      Active(
        ActiveT(
          parameters,
          Host.hol_apply_unit(Intmap.newMap),
          Units.empty,
          Rewrite.newRewrite(Knuth_bendix_order.compare(ordering)),
          Host.hol_apply_unit(Subsume.newSubsume),
          Literal_net.newNet(Term_net.Parameters(#false)),
          Term_net.newNet(Term_net.Parameters(#false)),
          Term_net.newNet(Term_net.Parameters(#false)),
          Term_net.newNet(Term_net.Parameters(#false))
        )
      )

    fun size(Active(ActiveT(_,clauses,_,_,_,_,_,_,_))): Intmap.size(clauses)

    fun clauses_impl(Active(ActiveT(_,cls,_,_,_,_,_,_,_))):
      let add = (fun([_, cl, acc]): PairList [cl, & acc])
      Intmap.foldr(add)(PairList [])(cls)

    fun saturation(active):
      let remove_2:
        fun([cl, [cls, subs]]):
          let lits = Clause.literals(cl)
          (if Subsume.isStrictlySubsumed(subs)(lits) | [cls, subs] | [PairList [cl, & cls], Subsume.insert(subs)([lits, #void])])
      let cls = clauses_impl(active)
      let [cls, _] = Mlist.foldl(remove_2)([PairList [], Host.hol_apply_unit(Subsume.newSubsume)])(cls)
      let [cls, subs] = Mlist.foldl(remove_2)([PairList [], Host.hol_apply_unit(Subsume.newSubsume)])(cls)
      cls

    fun toString(active): Host.hol_concat("Active{")(Host.hol_concat(Host.hol_string_of_int(size(active)))("}"))

    curried fun simplify(simp, units, rewr, subs):
      let Simplify(s,r,w) = simp
      fun rewrite(cl):
        let cl_prime = Clause.rewrite(rewr)(cl)
        if Clause.equalThms(cl)(cl_prime)
        | Host.Some(cl)
        | match Clause.simplify(cl_prime)
          | Host.None(): Host.None()
          | Host.Some(cl_prime_prime): (if Clause.equalThms(cl_prime)(cl_prime_prime) | Host.Some(cl_prime) | rewrite(cl_prime_prime))
      fun(cl):
        match Clause.simplify(cl)
        | Host.None(): Host.None()
        | Host.Some(cl):
            match (if w | rewrite(cl) | Host.Some(cl))
            | Host.None(): Host.None()
            | Host.Some(cl):
                let cl = (if r | Clause.reduce(units)(cl) | cl)
                (if (s && Clause.subsumes(subs)(cl)) | Host.None() | Host.Some(cl))

    curried fun simplifyActive(simp, active):
      let Active(ActiveT(_,_,units,rewrite_2,subsume,_,_,_,_)) = active
      simplify(simp, units, rewrite_2, subsume)

    curried fun addUnit(units, cl):
      let th = Clause.thm(cl)
      match Useful.total(Thm.destUnit)(th)
      | Host.Some(lit): Units.add(units)([lit, th])
      | Host.None(): units

    curried fun addRewrite(rewrite, cl):
      let th = Clause.thm(cl)
      match Useful.total(Thm.destUnitEq)(th)
      | Host.Some(l_r): Rewrite.add(rewrite)([Clause.id(cl), [l_r, th]])
      | Host.None(): rewrite

    curried fun addSubsume(subsume, cl): Subsume.insert(subsume)([Clause.literals(cl), cl])

    curried fun addLiterals(literals, cl):
      let add = (fun([[_, atm] as lit, literals]): (if Atom.isEq(atm) | literals | Literal_net.insert(literals)([lit, [cl, lit]])))
      Literal.Set.foldl(add)(literals)(Clause.largestLiterals(cl))

    curried fun addEquations(equations, cl):
      let add = (fun([[lit, ort, tm], equations]): Term_net.insert(equations)([tm, [cl, lit, ort, tm]]))
      Mlist.foldl(add)(equations)(Clause.largestEquations(cl))

    curried fun addSubterms(subterms, cl):
      let add = (fun([[lit, path, tm], subterms]): Term_net.insert(subterms)([tm, [cl, lit, path, tm]]))
      Mlist.foldl(add)(subterms)(Clause.largestSubterms(cl))

    curried fun addAllSubterms(allSubterms, cl):
      let add = (fun([[_, _, tm], allSubterms]): Term_net.insert(allSubterms)([tm, [cl, tm]]))
      Mlist.foldl(add)(allSubterms)(Clause.allSubterms(cl))

    curried fun addClause(active, cl):
      let Active(ActiveT(parameters,clauses,units,rewrite_3,subsume,literals,equations,subterms,allSubterms)) = active
      let clauses_2 = Intmap.insert(clauses)([Clause.id(cl), cl])
      let subsume_2 = addSubsume(subsume, cl)
      let literals_2 = addLiterals(literals, cl)
      let equations_2 = addEquations(equations, cl)
      let subterms_2 = addSubterms(subterms, cl)
      let allSubterms_2 = addAllSubterms(allSubterms, cl)
      Active(
        ActiveT(
          parameters,
          clauses_2,
          units,
          rewrite_3,
          subsume_2,
          literals_2,
          equations_2,
          subterms_2,
          allSubterms_2
        )
      )

    curried fun addFactorClause(active, cl):
      let Active(ActiveT(parameters,clauses,units,rewrite_4,subsume,literals,equations,subterms,allSubterms)) = active
      let units_2 = addUnit(units, cl)
      let rewrite_5 = addRewrite(rewrite_4, cl)
      Active(
        ActiveT(parameters, clauses, units_2, rewrite_5, subsume, literals, equations, subterms, allSubterms)
      )

    curried fun deduceResolution(literals, cl, [[_, atm] as lit, acc]):
      let resolve:
        fun([cl_lit, acc]):
          match Useful.total(Clause.resolve(cl_lit))([cl, lit])
          | Host.Some(cl_prime): PairList [cl_prime, & acc]
          | Host.None(): acc
      (if Atom.isEq(atm) | acc | Mlist.foldl(resolve)(acc)(Literal_net.unify(literals)(Literal.negate(lit))))

    curried fun deduceParamodulationWith(subterms, cl, [[lit, ort, tm], acc]):
      let para:
        fun([cl_lit_path_tm, acc]):
          match Useful.total(Clause.paramodulate([cl, lit, ort, tm]))(cl_lit_path_tm)
          | Host.Some(cl_prime): PairList [cl_prime, & acc]
          | Host.None(): acc
      Mlist.foldl(para)(acc)(Term_net.unify(subterms)(tm))

    curried fun deduceParamodulationInto(equations, cl, [[lit, path, tm], acc]):
      let para:
        fun([cl_lit_ort_tm, acc]):
          match Useful.total(Clause.paramodulate(cl_lit_ort_tm))([cl, lit, path, tm])
          | Host.Some(cl_prime): PairList [cl_prime, & acc]
          | Host.None(): acc
      Mlist.foldl(para)(acc)(Term_net.unify(equations)(tm))

    curried fun deduce(active, cl):
      let Active(ActiveT(parameters,_,_,_,_,literals,equations,subterms,_)) = active
      let lits = Clause.largestLiterals(cl)
      let eqns = Clause.largestEquations(cl)
      let subtms = (if Term_net.null(equations) | PairList [] | Clause.largestSubterms(cl))
      let acc = PairList []
      let acc = Literal.Set.foldl(deduceResolution(literals, cl))(acc)(lits)
      let acc = Mlist.foldl(deduceParamodulationWith(subterms, cl))(acc)(eqns)
      let acc = Mlist.foldl(deduceParamodulationInto(equations, cl))(acc)(subtms)
      let acc = Host.OCamlList.rev(acc)
      acc

    fun clause_rewritables(active):
      let Active(ActiveT(_,clauses,_,rewrite_6,_,_,_,_,_)) = active
      let rewr:
        fun([id, cl, ids]):
          let cl_prime = Clause.rewrite(rewrite_6)(cl)
          (if Clause.equalThms(cl)(cl_prime) | ids | Intset.add(ids)(id))
      Intmap.foldr(rewr)(Intset.empty)(clauses)

    fun orderedRedexResidues([[[l, r], _], ort]):
      match ort
      | Host.None(): PairList []
      | Host.Some(Rewrite.Left_to_right()): PairList [[l, r, #true]]
      | Host.Some(Rewrite.Right_to_left()): PairList [[r, l, #true]]

    fun unorderedRedexResidues([[[l, r], _], ort]):
      match ort
      | Host.None(): PairList [[l, r, #false], [r, l, #false]]
      | Host.Some(_): PairList []

    curried fun rewrite_rewritables(active, rewr_ids):
      let Active(ActiveT(parameters,clauses,_,rewrite_7,_,_,_,_,allSubterms)) = active
      let Parameters(Clause.Parameters(ordering,_,_),_,_) = parameters
      let order = Knuth_bendix_order.compare(ordering)
      let addRewr = (fun([id, acc]): (if Intmap.inDomain(id)(clauses) | Intset.add(acc)(id) | acc))
      let addReduce:
        fun([[l, r, ord], acc]):
          let isValidRewr:
            fun(tm):
              match Useful.total(Substitute.matchTerms(Substitute.empty)(l))(tm)
              | Host.None(): #false
              | Host.Some(sub):
                  if ord
                  | #true
                  | let tm_prime = Substitute.subst(Substitute.normalize(sub))(r)
                    Host.hol_equal(order(tm)(tm_prime))(Host.Some(1))
          let addRed:
            fun([[cl, tm], acc]):
              let id = Clause.id(cl)
              if Intset.member(id)(acc)
              | acc
              | (if Host.hol_not(isValidRewr(tm)) | acc | Intset.add(acc)(id))
          Mlist.foldl(addRed)(acc)(Term_net.matched(allSubterms)(l))
      let addEquation:
        fun(redexResidues):
          fun([id, acc]):
            match Rewrite.peek(rewrite_7)(id)
            | Host.None(): acc
            | Host.Some(eqn_ort): Mlist.foldl(addReduce)(acc)(redexResidues(eqn_ort))
      let addOrdered = addEquation(orderedRedexResidues)
      let addUnordered = addEquation(unorderedRedexResidues)
      let ids = Intset.empty
      let ids = Mlist.foldl(addRewr)(ids)(rewr_ids)
      let ids = Mlist.foldl(addOrdered)(ids)(rewr_ids)
      let ids = Mlist.foldl(addUnordered)(ids)(rewr_ids)
      ids

    curried fun choose_clause_rewritables(active, ids): Host.hol_le(size(active))(length(ids))

    curried fun rewritables(active, ids): (if choose_clause_rewritables(active, ids) | clause_rewritables(active) | rewrite_rewritables(active, ids))

    curried fun delete(active, ids):
      if Intset.null(ids)
      | active
      | let idPred = (fun(id): Host.hol_not(Intset.member(id)(ids)))
        let clausePred = (fun(cl): idPred(Clause.id(cl)))
        let Active(ActiveT(parameters,clauses,units,rewrite_8,subsume,literals,equations,subterms,allSubterms)) = active
        let cP1 = (fun([x, _]): clausePred(x))
        let cP1_4 = (fun([x, _, _, _]): clausePred(x))
        let clauses_3 = Intmap.filter((fun(x): idPred(fst(x))))(clauses)
        let subsume_3 = Subsume.filter(clausePred)(subsume)
        let literals_3 = Literal_net.filter(cP1)(literals)
        let equations_3 = Term_net.filter(cP1_4)(equations)
        let subterms_3 = Term_net.filter(cP1_4)(subterms)
        let allSubterms_3 = Term_net.filter(cP1)(allSubterms)
        Active(
          ActiveT(
            parameters,
            clauses_3,
            units,
            rewrite_8,
            subsume_3,
            literals_3,
            equations_3,
            subterms_3,
            allSubterms_3
          )
        )

    fun extract_rewritables(Active(ActiveT(_,clauses,_,rewrite,_,_,_,_,_)) as active):
      if Rewrite.isReduced(rewrite)
      | [active, PairList []]
      | let [rewrite_9, ids] = Rewrite.reduce_prime(rewrite)
        let active = setRewrite(active, rewrite_9)
        let ids = rewritables(active, ids)
        let cls = Intset.transform(Intmap.get(clauses))(ids)
        [delete(active, ids), cls]

    curried fun prefactor_simplify(active, subsume):
      let Active(ActiveT(parameters,_,units,rewrite_10,_,_,_,_,_)) = active
      let Parameters(_,prefactor,_) = parameters
      simplify(prefactor, units, rewrite_10, subsume)

    curried fun postfactor_simplify(active, subsume):
      let Active(ActiveT(parameters,_,units,rewrite_11,_,_,_,_,_)) = active
      let Parameters(_,_,postfactor) = parameters
      simplify(postfactor, units, rewrite_11, subsume)

    def sort_utilitywise:
      let utility:
        fun(cl):
          match Literal.Set.size(Clause.literals(cl))
          | 0: -1
          | 1: (if Thm.isUnitEq(Clause.thm(cl)) | 0 | 1)
          | n: n
      Mlist.sortMap(utility)(Useful.intCompare)

    fun post_factor([cl, [active, subsume, acc] as active_subsume_acc]):
      match postfactor_simplify(active, subsume)(cl)
      | Host.None(): active_subsume_acc
      | Host.Some(cl_prime):
          if Clause.equalThms(cl_prime)(cl)
          | let active_2 = addFactorClause(active, cl)
            let subsume_4 = addSubsume(subsume, cl)
            let acc_2 = PairList [cl, & acc]
            [active_2, subsume_4, acc_2]
          | factor1([cl_prime, active_subsume_acc])

    fun factor1([cl, active_subsume_acc]):
      let cls = sort_utilitywise(PairList [cl, & Clause.factor(cl)])
      Mlist.foldl(post_factor)(active_subsume_acc)(cls)

    fun pre_factor([cl, [active, subsume, _] as active_subsume_acc]):
      match prefactor_simplify(active, subsume)(cl)
      | Host.None(): active_subsume_acc
      | Host.Some(cl): factor1([cl, active_subsume_acc])

    fun factor_prime_impl(active):
      fun(acc):
        fun
        | (PairList []): [active, Host.OCamlList.rev(acc)]
        | (cls):
            let cls = sort_utilitywise(cls)
            let subsume = getSubsume(active)
            let [active, _, acc] = Mlist.foldl(pre_factor)([active, subsume, acc])(cls)
            let [active, cls] = extract_rewritables(active)
            factor_prime_impl(active, acc)(cls)

    curried fun factor(active, cls): factor_prime_impl(active, PairList [])(cls)

    curried fun mk_clause(params, th): Clause.mk(Clause.ClauseInfo(params, Host.hol_apply_unit(Clause.newId), th))

    curried fun newActive(parameters, Ax_cj.AxCjThm(axioms_thm,conjecture_thm)):
      let Parameters(clause,_,_) = parameters
      let mk_clause = mk_clause(clause)
      let active = empty(parameters)
      let [active, axioms] = factor(active)(Host.OCamlList.map(mk_clause)(axioms_thm))
      let [active, conjecture] = factor(active)(Host.OCamlList.map(mk_clause)(conjecture_thm))
      [active, Ax_cj.AxCjCl(axioms, conjecture)]

    curried fun add(active, cl):
      match simplifyActive(maxSimplify, active)(cl)
      | Host.None(): [active, PairList []]
      | Host.Some(cl_prime):
          if Clause.isContradiction(cl_prime)
          | [active, PairList [cl_prime]]
          | if Host.hol_not(Clause.equalThms(cl)(cl_prime))
            | factor(active, PairList [cl_prime])
            | let active = addClause(active, cl)
              let cl = Clause.freshVars(cl)
              let cls = deduce(active, cl)
              let [active, cls] = factor(active, cls)
              [active, cls]

    def clauses = clauses_impl

    def factor_prime = factor_prime_impl

  namespace Waiting:
    export:
      ModelParameters
      Parameters
      WaitingT
      Waiting
      defaultModels
      default
      size
      toString
      mkModelClause
      mkModelClauses
      perturbModel
      initialModel
      checkModels
      perturbModels
      clauseSymbols
      clauseVariables
      clauseLiterals
      clausePriority
      clauseWeight
      add_prime
      add
      cmp
      empty
      newWaiting
      remove

    record ModelParameters(model, initialPerturbations, maxChecks, perturbations, weight)

    record Parameters(symbolsWeight, variablesWeight, literalsWeight, modelsP)

    record WaitingT(parameters, clauses, models)

    variant waiting:
      Waiting(state)

    def defaultModels = PairList [ModelParameters(Model.default, 100, Host.Some(20), 0, 1.0)]

    def default = Parameters(1.0, 1.0, 1.0, defaultModels)

    fun size(Waiting(WaitingT(_,clauses,_))): Heap.size(clauses)

    fun toString(w): Host.hol_concat("Waiting{")(Host.hol_concat(Host.hol_string_of_int(size(w)))("}"))

    fun mkModelClause(cl):
      let lits = Clause.literals(cl)
      let fvs = Literal.Set.freeVars(lits)
      [fvs, lits]

    def mkModelClauses = Host.OCamlList.map(mkModelClause)

    curried fun perturbModel(vM, cls):
      if Mlist.null(cls)
      | Host.hol_apply_unit(K)
      | let vN = Model.Size(Model.msize(vM))
        let perturbClause:
          fun([fv, cl]):
            let vV = Model.randomValuation(vN)(fv)
            (if Model.interpretClause(vM)(vV)(cl) | #void | Model.perturbClause(vM)(vV)(cl))
        let perturbClauses = (fun(_): Host.OCamlList.iter(perturbClause)(cls))
        (fun(n): Host.hol_apply_unit(Host.funpow(n)(perturbClauses)))

    curried fun initialModel(axioms, conjecture, parm):
      let ModelParameters(model,initialPerturbations,_,_,_) = parm
      let m = Model.newModel(model)
      let #void = perturbModel(m, conjecture)(initialPerturbations)
      let #void = perturbModel(m, axioms)(initialPerturbations)
      m

    curried fun checkModels(parms, models, [fv, cl]):
      let check_2:
        fun([[parm, model], z]):
          let ModelParameters(_,_,maxChecks,_,weight) = parm
          let n = maxChecks
          let [vT, vF] = Model.check(Model.interpretClause)(n)(model)(fv)(cl)
          Host.hol_mul(
            Host.hol_add(1.0)(
              Host.hol_rat_div(Host.hol_float(vT))(Host.power_num(Host.hol_float(Host.hol_add(vT)(vF)))(weight))
            )
          )(z)
      Mlist.foldl(check_2)(1.0)(zip(parms)(models))

    curried fun perturbModels(parms, models, cls):
      let perturb:
        fun([parm, model]):
          let ModelParameters(_,_,_,perturbations,_) = parm
          perturbModel(model, cls)(perturbations)
      Host.OCamlList.iter(perturb)(zip(parms)(models))

    fun clauseSymbols(cl): Host.hol_float(Literal.Set.typedSymbols(cl))

    fun clauseVariables(cl): Host.hol_float(Host.hol_add(Name.Set.size(Literal.Set.freeVars(cl)))(1))

    fun clauseLiterals(cl): Host.hol_float(Literal.Set.size(cl))

    fun clausePriority(cl): Host.hol_mul(1e-12)(Host.hol_float(Clause.id(cl)))

    curried fun clauseWeight(parm, mods, dist, mcl, cl):
      let Parameters(symbolsWeight,variablesWeight,literalsWeight,modelsP) = parm
      let lits = Clause.literals(cl)
      let symbolsW = Host.power_num(clauseSymbols(lits))(symbolsWeight)
      let variablesW = Host.power_num(clauseVariables(lits))(variablesWeight)
      let literalsW = Host.power_num(clauseLiterals(lits))(literalsWeight)
      let modelsW = checkModels(modelsP, mods, mcl)
      let weight = Host.hol_mul(Host.hol_mul(Host.hol_mul(Host.hol_mul(dist)(symbolsW))(variablesW))(literalsW))(modelsW)
      let weight = Host.hol_add(weight)(clausePriority(cl))
      weight

    fun add_prime_impl(waiting):
      fun(dist):
        fun(mcls):
          fun(cls):
            let Waiting(WaitingT(parameters,clauses,models)) = waiting
            let Parameters(_,_,_,modelParameters) = parameters
            let dist = Host.hol_add(dist)(Host.log(Host.hol_float(length(cls))))
            let addCl:
              fun([[mcl, cl], acc]):
                let weight = clauseWeight(parameters, models, dist, mcl, cl)
                Heap.add(acc)([weight, [dist, cl]])
            let clauses = Mlist.foldl(addCl)(clauses)(zip(mcls)(cls))
            let #void = perturbModels(modelParameters, models, mcls)
            Waiting(WaitingT(parameters, clauses, models))

    curried fun add(waiting, [dist, cls]):
      if Mlist.null(cls)
      | waiting
      | let waiting = add_prime_impl(waiting)(dist)(mkModelClauses(cls))(cls)
        waiting

    curried fun cmp([w1, _], [w2, _]): Host.hol_compare(w1)(w2)

    curried fun empty(parameters, axioms, conjecture):
      let Parameters(_,_,_,modelParameters) = parameters
      let clauses_2 = Heap.newHeap(cmp)
      let models_2 = Host.OCamlList.map(initialModel(axioms, conjecture))(modelParameters)
      Waiting(WaitingT(parameters, clauses_2, models_2))

    curried fun newWaiting(parameters, Ax_cj.AxCjCl(axioms_cl,conjecture_cl)):
      let mAxioms_2 = mkModelClauses(axioms_cl)
      let mConjecture_2 = mkModelClauses(conjecture_cl)
      let waiting = empty(parameters, mAxioms_2, mConjecture_2)
      (if (Mlist.null(axioms_cl) && Mlist.null(conjecture_cl)) | waiting | add_prime_impl(waiting)(0.0)(append(mAxioms_2)(mConjecture_2))(append(axioms_cl)(conjecture_cl)))

    fun remove_impl(Waiting(WaitingT(parameters,clauses,models))):
      if Heap.null(clauses)
      | Host.None()
      | let [[_, dcl], clauses] = Heap.remove(clauses)
        let waiting = Waiting(WaitingT(parameters, clauses, models))
        Host.Some([dcl, waiting])

    def add_prime = add_prime_impl

    def remove = remove_impl

  namespace Resolution:
    export:
      Parameters
      ResolutionT
      Resolution
      default
      newResolution
      active
      waiting
      Contradiction
      Satisfiable
      Decided
      Undecided
      iterate
      loop

    record Parameters(activeP, waitingP)

    record ResolutionT(parameters, active, waiting)

    variant resolution:
      Resolution(state)

    def default = Parameters(Active.default, Waiting.default)

    curried fun newResolution(parameters, ths):
      let Parameters(activeParm,waitingParm) = parameters
      let [active, cls] = Active.newActive(activeParm)(ths)
      let waiting = Waiting.newWaiting(waitingParm)(cls)
      Resolution(ResolutionT(parameters, active, waiting))

    fun active_impl(Resolution(ResolutionT(_,a,_))): a

    fun waiting_impl(Resolution(ResolutionT(_,_,w))): w

    variant decision:
      Contradiction(theorem)
      Satisfiable(clauses)

    variant state:
      Decided(decision)
      Undecided(resolution)

    fun iterate(res):
      let Resolution(ResolutionT(parameters,active,waiting)) = res
      match Waiting.remove(waiting)
      | Host.None():
          let sat = Satisfiable(Host.OCamlList.map(Clause.thm)(Active.saturation(active)))
          Decided(sat)
      | Host.Some([[d, cl], waiting]):
          if Clause.isContradiction(cl)
          | Decided(Contradiction(Clause.thm(cl)))
          | let [active, cls] = Active.add(active)(cl)
            let waiting = Waiting.add(waiting)([d, cls])
            let res = Resolution(ResolutionT(parameters, active, waiting))
            Undecided(res)

    fun loop(res):
      match iterate(res)
      | Decided(dec): dec
      | Undecided(res): loop(res)

    def active = active_impl

    def waiting = waiting_impl

  namespace Loop:
    export:
      loop
      run

    fun loop(res):
      match Resolution.iterate(res)
      | Resolution.Decided(dec): Host.Some(dec)
      | Resolution.Undecided(res): loop(res)

    fun run(rules):
      let ths = Ax_cj.AxCjThm(rules, PairList [])
      let res = Resolution.newResolution(Resolution.default)(ths)
      match loop(res)
      | Host.None(): failwith("metis: timeout")
      | Host.Some(Resolution.Contradiction(thm)): thm
      | Host.Some(Resolution.Satisfiable(_)): failwith("metis: found satisfiable assignment")

namespace Metis_debug:
  export:
    print_varandtype
    show_types
    hide_types

  curried fun print_varandtype(fmt, tm):
    let [hop, args] = strip_comb(tm)
    let s_2 = Host.name_of(hop)
    let ty_2 = type_of(hop)
    if (is_var(hop) && Host.hol_equal(args)(PairList []))
    | Host.OCamlFormat.pp_print_string(fmt)("(")
      Host.OCamlFormat.pp_print_string(fmt)(s_2)
      Host.OCamlFormat.pp_print_string(fmt)(":")
      Host.pp_print_type(fmt)(ty_2)
      Host.OCamlFormat.pp_print_string(fmt)(")")
    | Host.hol_apply_unit(fail)

  def [show_types_v2, hide_types]:
    [
      (fun(_): Host.install_user_printer(["Show Types", print_varandtype])),
      fun(_):
        try:
          Host.delete_user_printer("Show Types")
          ~catch exn:
            match exn
            | Failure(_): failwith(Host.hol_concat("hide_types: ")("Types are already hidden."))
            | exn: Host.hol_raise(exn)
    ]

  def show_types = show_types_v2

namespace Preterm:
  export:
    mk_negp
    mk_eqp
    mk_conjp
    mk_disjp
    list_mk_combp
    list_mk_disjp
    unconst_preterm
    env_of_preterm
