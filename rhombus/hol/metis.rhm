        // OCaml 4.14.1 Set.Make; Copyright 1996 INRIA, Xavier Leroy.
        // LGPL 2.1 with OCaml linking exception; see tools/translate/stdlib.
        namespace Se:
          export:
            TNode
            Empty
            Node
