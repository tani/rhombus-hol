    curried fun equal(n1, n2): Host.hol_equal(n1)(n2)

    def prefix = "_"

    fun numName(i): Useful.mkPrefix(prefix)(Host.hol_string_of_int(i))

    fun newName(_): numName(Host.hol_apply_unit(Useful.newInt))

    fun newNames(n): Host.OCamlList.map(numName)(Useful.newInts(n))

    fun variantPrime(avoid):
      fun variant(n): (if avoid(n) | variant(Host.hol_concat(n)("'")) | n)
      variant

    curried fun variantNum(avoid, n):
      let isDigitOrPrime = (fun(c): (Host.hol_equal(c)("'") || Useful.isDigit(c)))
      if Host.hol_not(avoid(n))
      | n
      | let n = Useful.stripSuffix(isDigitOrPrime)(n)
        fun variant_2(i):
          let n_i = Host.hol_concat(n)(Host.hol_string_of_int(i))
          (if avoid(n_i) | variant_2(Host.hol_add(i)(1)) | n_i)
        variant_2(0)

    fun toString(s): s

    fun fromString(s): s

