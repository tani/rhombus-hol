    def cardName = Name.fromString("card")

    def complementName = Name.fromString("complement")

    def differenceName = Name.fromString("difference")

    def emptyName = Name.fromString("empty")

    def memberName = Name.fromString("member")

    def insertName = Name.fromString("insert")

    def intersectName = Name.fromString("intersect")

    def singletonName = Name.fromString("singleton")

    def subsetName = Name.fromString("subset")

    def symmetricDifferenceName = Name.fromString("symmetricDifference")

    def unionName = Name.fromString("union")

    def universeName = Name.fromString("universe")

    fun eltN(Size(n)):
      fun f_2(acc):
        fun
        | (0): acc
        | (x): f_2(Host.hol_add(acc)(1))(Host.hol_div(x)(2))
      f_2(-1)(n)

    fun posN(i): Word.shiftLeft([1, Word.fromInt(i)])

    fun univN(sz): Word.minus([posN(eltN(sz)), 1])

    curried fun setN(sz, x): Word.andb([Word.fromInt(x), univN(sz)])

    curried fun cardFn(sz, x):
      fun f_3(acc):
        fun
        | (0): acc
        | (s):
            let acc = (if Host.hol_equal(Word.andb([s, 1]))(0) | acc | Host.hol_add(acc)(1))
            f_3(acc)(Word.shiftRight([s, 1]))
      Host.Some(f_3(setN(sz, x))(0))

    curried fun complementFn(sz, x): Host.Some(Word.toInt(Word.xorb([univN(sz), setN(sz, x)])))

    curried fun differenceFn(sz, x, y):
      let x_2 = setN(sz, x)
      let y_2 = setN(sz, y)
      Host.Some(Word.toInt(Word.andb([x_2, Word.notb(y_2)])))

    fun emptyFn(_): Host.Some(0)

    curried fun insertFn(sz, x, y):
      let x_3 = Host.hol_mod(x)(eltN(sz))
      let y_3 = setN(sz, y)
      Host.Some(Word.toInt(Word.orb([posN(x_3), y_3])))

    curried fun intersectFn(sz, x, y): Host.Some(Word.toInt(Word.andb([setN(sz, x), setN(sz, y)])))

    curried fun singletonFn(sz, x):
      let x = Host.hol_mod(x)(eltN(sz))
      Host.Some(Word.toInt(posN(x)))

    curried fun symmetricDifferenceFn(sz, x, y):
      let x_4 = setN(sz, x)
      let y_4 = setN(sz, y)
      Host.Some(Word.toInt(Word.xorb([x_4, y_4])))

    curried fun unionFn(sz, x, y): Host.Some(Word.toInt(Word.orb([setN(sz, x), setN(sz, y)])))

    fun universeFn(sz): Host.Some(Word.toInt(univN(sz)))

    curried fun memberRel(sz, x, y):
      let x_5 = Host.hol_mod(x)(eltN(sz))
      let y_5 = setN(sz, y)
      Host.Some(Host.hol_unequal(Word.andb([posN(x_5), y_5]))(0))

    curried fun subsetRel(sz, x, y):
      let x_6 = setN(sz, x)
      let y_6 = setN(sz, y)
      Host.Some(Host.hol_equal(Word.andb([x_6, Word.notb(y_6)]))(0))

    def setFixed:
      let fns:
        Name_arity.Map.fromList(
          PairList [
            [[cardName, 1], fixed1(cardFn)],
            [[complementName, 1], fixed1(complementFn)],
            [[differenceName, 2], fixed2(differenceFn)],
            [[emptyName, 0], fixed0(emptyFn)],
            [[insertName, 2], fixed2(insertFn)],
            [[intersectName, 2], fixed2(intersectFn)],
            [[singletonName, 1], fixed1(singletonFn)],
            [[symmetricDifferenceName, 2], fixed2(symmetricDifferenceFn)],
            [[unionName, 2], fixed2(unionFn)],
            [[universeName, 0], fixed0(universeFn)]
          ]
        )
      let rels = Name_arity.Map.fromList(PairList [[[memberName, 2], fixed2(memberRel)], [[subsetName, 2], fixed2(subsetRel)]])
      Fixed(fns, rels)

    def appendName = Name.fromString("@")

    def consName = Name.fromString("::")

    def lengthName = Name.fromString("length")

    def nilName = Name.fromString("nil")

    def nullName = Name.fromString("null")

    def tailName = Name.fromString("tail")

    def baseFix:
      let fix_2 = unionFixed(projectionFixed, overflowFixed)
      let sucFn = getFunctionFixed(fix_2, [sucName, 1])
      let suc2Fn = (fun(sz): (fun(_): (fun(x): sucFn(sz)(PairList [x]))))
      insertFunctionFixed(fix_2)([[sucName, 2], fixed2(suc2Fn)])

    def fixMap:
      FixedMap(
        Name_arity.Map.fromList(
          PairList [
            [[appendName, 2], addName],
            [[consName, 2], sucName],
            [[lengthName, 1], projectionName(1)],
            [[nilName, 0], numeralName(0)],
            [[tailName, 1], preName]
          ]
        ),
        Name_arity.Map.fromList(PairList [[[nullName, 1], isZeroName]])
      )

    def listFixed = mapFixed(fixMap, baseFix)

    variant valuation:
      Valuation(map)

    def emptyValuation = Valuation(Host.hol_apply_unit(Name.Map.newMap))

    curried fun insertValuation(Valuation(m), v_i): Valuation(Name.Map.insert(m)(v_i))

    curried fun peekValuation(Valuation(m), v): Name.Map.peek(m)(v)

    fun constantValuation(i):
      let add = (fun([v, v_prime]): insertValuation(v_prime, [v, i]))
      Name.Set.foldl(add)(emptyValuation)

    def zeroValuation = constantValuation(zeroElement)

    curried fun getValuation(v_prime, v):
      match peekValuation(v_prime, v)
      | Host.Some(i): i
      | Host.None(): failwith("Model.getValuation: incomplete valuation")

    curried fun randomValuation(Size(n), vs):
      let f_4 = (fun([v, v_prime]): insertValuation(v_prime)([v, Host.ocaml_random_int(n)]))
      Name.Set.foldl(f_4)(emptyValuation)(vs)

    curried fun incrementValuation(n, vars):
      fun inc(vs):
        fun(v_prime):
          match vs
          | PairList []: Host.None()
          | PairList [v, & vs]:
              let [carry, i]:
                match incrementElement(n)(getValuation(v_prime, v))
                | Host.Some(i): [#false, i]
                | Host.None(): [#true, zeroElement]
              let v_prime = insertValuation(v_prime, [v, i])
              (if carry | inc(vs)(v_prime) | Host.Some(v_prime))
      inc(Name.Set.toList(vars))

    curried fun foldValuation(n, vars, f):
      let inc_2 = incrementValuation(n, vars)
      fun fold(v_prime):
        fun(acc):
          let acc = f([v_prime, acc])
          match inc_2(v_prime)
          | Host.None(): acc
          | Host.Some(v_prime): fold(v_prime)(acc)
      let zero = zeroValuation(vars)
      fold(zero)

    def cUNKNOWN = -1

    variant table:
      Forgetful_table()
      Array_table(array)

    curried fun newTable(n, arity):
      match elementListSpace(Size(n), arity)
      | Host.None(): Forgetful_table()
      | Host.Some(space): Array_table(Host.hol_array_make(space)(cUNKNOWN))

    fun randomResult(r): Host.ocaml_random_int(r)

    curried fun lookupTable(n, vR, table, elts):
      match table
      | Forgetful_table(): randomResult(vR)
      | Array_table(a):
          let i = elementListIndex(Size(n))(elts)
          let r = Host.hol_array_get(a)(i)
          if Host.hol_unequal(r)(cUNKNOWN)
          | r
          | let r = randomResult(vR)
            let #void = Host.hol_array_set(a)(i)(r)
            r

    curried fun updateTable(n, table, [elts, r]):
      match table
      | Forgetful_table(): #void
      | Array_table(a):
          let i = elementListIndex(Size(n))(elts)
          let #void = Host.hol_array_set(a)(i)(r)
          #void

    record Tables(domainSize, rangeSize, tableMap)

    curried fun newTables(n, vR): Tables(n, vR, Box(Host.hol_apply_unit(Name_arity.Map.newMap)))

    curried fun getTables(tables, n_a):
      let Tables(n,_,tm) = tables
      let m = Host.ref_get(tm)
      match Name_arity.Map.peek(m)(n_a)
      | Host.Some(t): t
      | Host.None():
          let [_, a_2] = n_a
          let t = newTable(n, a_2)
          let m = Name_arity.Map.insert(m)([n_a, t])
          let #void = Host.ref_set(tm)(m)
          t

    curried fun lookupTables(tables, [n, elts]):
      let Tables(vN,vR,_) = tables
      let a_3 = length(elts)
      let table = getTables(tables, [n, a_3])
      lookupTable(vN, vR, table, elts)

    curried fun updateTables(tables, [[n, elts], r]):
      let Tables(vN,_,_) = tables
      let a_4 = length(elts)
      let table = getTables(tables, [n, a_4])
      updateTable(vN, table, [elts, r])

    record Parameters(sizep, fixed)

    record Model(sizem, fixedFunctions, fixedRelations, randomFunctions, randomRelations)

    fun newModel(Parameters(vN,fixed)):
      let Fixed(fns,rels) = fixed
      let fixFns_2 = Name_arity.Map.transform((fun(f): f(Size(vN))))(fns)
      let fixRels_2 = Name_arity.Map.transform((fun(r): r(Size(vN))))(rels)
      let rndFns_2 = newTables(vN, vN)
      let rndRels_2 = newTables(vN, 2)
      Model(vN, fixFns_2, fixRels_2, rndFns_2, rndRels_2)

    fun msize(Model(vN,_,_,_,_)): vN

    fun psize(Parameters(vN,_)): vN

    curried fun peekFixedFunction(vM, [n, elts]):
      let Model(_,fixFns,_,_,_) = vM
      match Name_arity.Map.peek(fixFns)([n, length(elts)])
      | Host.None(): Host.None()
      | Host.Some(fixFn): fixFn(elts)

    curried fun isFixedFunction(vM, n_elts): Option.is_some(peekFixedFunction(vM, n_elts))

    curried fun peekFixedRelation(vM, [n, elts]):
      let Model(_,_,fixRels,_,_) = vM
      match Name_arity.Map.peek(fixRels)([n, length(elts)])
      | Host.None(): Host.None()
      | Host.Some(fixRel): fixRel(elts)

    curried fun isFixedRelation(vM, n_elts): Option.is_some(peekFixedRelation(vM, n_elts))

    def defaultSize = 8

    def defaultFixed = unionListFixed(PairList [basicFixed, projectionFixed, modularFixed, setFixed, listFixed])

    def default = Parameters(defaultSize, defaultFixed)

    fun destTerm(tm):
      match tm
      | Term.Var(_): tm
      | Term.Fn(f_tms):
          match Term.stripApp(tm)
          | [_, PairList []]: tm
          | [Term.Var(_) as v, tms]: Term.Fn([Term.appName, PairList [v, & tms]])
          | [Term.Fn([f, tms]), tms_prime]: Term.Fn([f, append(tms)(tms_prime)])

    curried fun interpretFunction(vM, n_elts):
      match peekFixedFunction(vM, n_elts)
      | Host.Some(r): r
      | Host.None():
          let Model(_,_,_,rndFns,_) = vM
          lookupTables(rndFns, n_elts)

    curried fun interpretRelation(vM, n_elts):
      match peekFixedRelation(vM, n_elts)
      | Host.Some(r): r
      | Host.None():
          let Model(_,_,_,_,rndRels) = vM
          intToBool(lookupTables(rndRels, n_elts))

    curried fun interpretTerm(vM, vV):
      fun interpret(tm):
        match destTerm(tm)
        | Term.Var(v): getValuation(vV, v)
        | Term.Fn([f, tms]): interpretFunction(vM)([f, Host.OCamlList.map(interpret)(tms)])
      interpret

    curried fun interpretAtom(vM, vV, [r, tms]): interpretRelation(vM)([r, Host.OCamlList.map(interpretTerm(vM, vV))(tms)])

    fun interpretFormula(vM):
      let vN = msize(vM)
      fun interpret_2(vV):
        fun(fm):
          match fm
          | Formula.True(): #true
          | Formula.False(): #false
          | Formula.Atom(atm): interpretAtom(vM, vV, atm)
          | Formula.Not(p): Host.hol_not(interpret_2(vV)(p))
          | Formula.Or(p,q): (interpret_2(vV)(p) || interpret_2(vV)(q))
          | Formula.And(p,q): (interpret_2(vV)(p) && interpret_2(vV)(q))
          | Formula.Imp(p,q): interpret_2(vV)(Formula.Or(Formula.Not(p), q))
          | Formula.Iff(p,q): Host.hol_equal(interpret_2(vV)(p))(interpret_2(vV)(q))
          | Formula.Forall(v,p): interpret_prime_2(vV)(p)(v)(vN)
          | Formula.Exists(v,p): interpret_2(vV)(Formula.Not(Formula.Forall(v, Formula.Not(p))))
      fun interpret_prime_2(vV):
        fun(fm):
          fun(v):
            fun(i):
              if Host.hol_equal(i)(0)
              | #true
              | let i = Host.hol_sub(i)(1)
                let vV_prime = insertValuation(vV, [v, i])
                (interpret_2(vV_prime)(fm) && interpret_prime_2(vV)(fm)(v)(i))
      interpret_2

    curried fun interpretLiteral(vM, vV, [pol, atm]):
      let b = interpretAtom(vM, vV, atm)
      (if pol | b | Host.hol_not(b))

    curried fun interpretClause(vM, vV, cl): Literal.Set.exists(interpretLiteral(vM, vV))(cl)

    curried fun check_impl(interpret, maxChecks, vM, fv, x):
      let vN = msize(vM)
      let score = (fun([vV, [vT, vF]]): (if interpret(vM)(vV)(x) | [Host.hol_add(vT)(1), vF] | [vT, Host.hol_add(vF)(1)]))
      let randomCheck = (fun(acc): score([randomValuation(Size(vN), fv), acc]))
      let maxChecks:
        match maxChecks
        | Host.None(): maxChecks
        | Host.Some(m):
            match expInt(vN)(Name.Set.size(fv))
            | Host.Some(n): (if Host.hol_le(n)(m) | Host.None() | maxChecks)
            | Host.None(): maxChecks
      match maxChecks
      | Host.Some(m): Host.funpow(m)(randomCheck)([0, 0])
      | Host.None(): foldValuation(Size(vN), fv, score)([0, 0])

    curried fun checkAtom(maxChecks, vM, atm): check_impl(interpretAtom)(maxChecks)(vM)(Atom.freeVars(atm))(atm)

    curried fun checkFormula(maxChecks, vM, fm): check_impl(interpretFormula)(maxChecks)(vM)(Formula.freeVars(fm))(fm)

    curried fun checkLiteral(maxChecks, vM, lit): check_impl(interpretLiteral)(maxChecks)(vM)(Literal.freeVars(lit))(lit)

    curried fun checkClause(maxChecks, vM, cl): check_impl(interpretClause)(maxChecks)(vM)(Literal.Set.freeVars(cl))(cl)

    curried fun updateFunction(vM, func_elts_elt):
      let Model(_,_,_,rndFns,_) = vM
      let #void = updateTables(rndFns, func_elts_elt)
      #void

    curried fun updateRelation(vM, [rel_elts, pol]):
      let Model(_,_,_,_,rndRels) = vM
      let #void = updateTables(rndRels)([rel_elts, boolToInt(pol)])
      #void

    variant modelTerm:
      Model_var()
      Model_fn(symbol, arguments, elements)

    curried fun modelTerm(vM, vV):
      fun modelTm(tm):
        match destTerm(tm)
        | Term.Var(v): [Model_var(), getValuation(vV, v)]
        | Term.Fn([f, tms]):
            let [tms, xs] = unzip(Host.OCamlList.map(modelTm)(tms))
            [Model_fn(f, tms, xs), interpretFunction(vM, [f, xs])]
      modelTm

    variant perturbation:
      Function_perturbation(application, result)
      Relation_perturbation(application, polarity)

    curried fun perturb(vM, pert):
      match pert
      | Function_perturbation([func, elts],elt): updateFunction(vM, [[func, elts], elt])
      | Relation_perturbation([rel, elts],pol): updateRelation(vM, [[rel, elts], pol])

    curried fun pertTerm(vM, target, tm, acc):
      match target
      | PairList []: acc
      | _:
          match tm
          | Model_var(): acc
          | Model_fn(func,tms,xs):
              let onTarget = (fun(ys): Host.OCamlList.mem(interpretFunction(vM, [func, ys]))(target))
              let func_xs = [func, xs]
              let acc:
                if isFixedFunction(vM, func_xs)
                | acc
                | let add = (fun([y, acc]): PairList [Function_perturbation(func_xs, y), & acc])
                  Mlist.foldl(add)(acc)(target)
              pertTerms(vM, onTarget)(tms)(xs)(acc)

    curried fun pertTerms(vM, onTarget):
      let vN = msize(vM)
      let filterElements:
        fun(pred):
          fun filt(i):
            fun(acc):
              match i
              | 0: acc
              | _:
                  let i = Host.hol_sub(i)(1)
                  let acc = (if pred(i) | PairList [i, & acc] | acc)
                  filt(i)(acc)
          filt(vN)(PairList [])
      fun pert
      | pert([_, PairList [], PairList [], acc]): acc
      | pert([ys, PairList [tm, & tms], PairList [x, & xs], acc]):
          let pred = (fun(y): (Host.hol_unequal(y)(x) && onTarget(Host.OCamlList.rev_append(ys)(PairList [y, & xs]))))
          let target = filterElements(pred)
          let acc = pertTerm(vM, target, tm, acc)
          pert([PairList [x, & ys], tms, xs, acc])
      | pert([_, _, _, _]): Host.hol_raise(Useful.Bug("Model.pertTerms.pert"))
      (fun(x): (fun(y): (fun(z): pert([PairList [], x, y, z]))))

    curried fun pertAtom(vM, vV, target, [rel, tms], acc):
      let onTarget = (fun(ys): Host.hol_equal(interpretRelation(vM, [rel, ys]))(target))
      let [tms, xs] = unzip(Host.OCamlList.map(modelTerm(vM, vV))(tms))
      let rel_xs = [rel, xs]
      let acc = (if isFixedRelation(vM, rel_xs) | acc | PairList [Relation_perturbation(rel_xs, target), & acc])
      pertTerms(vM, onTarget)(tms)(xs)(acc)

    curried fun pertLiteral(vM, vV, [[pol, atm], acc]): pertAtom(vM, vV, pol, atm, acc)

    curried fun pertClause(vM, vV, cl, acc): Literal.Set.foldl(pertLiteral(vM, vV))(acc)(cl)

    curried fun pickPerturb(vM, perts): (if Mlist.null(perts) | #void | perturb(vM)(Host.OCamlList.nth(perts)(Host.ocaml_random_int(length(perts)))))

    curried fun perturbTerm(vM, vV, [tm, target]): pickPerturb(vM)(pertTerm(vM)(target)(fst(modelTerm(vM, vV)(tm)))(PairList []))

    curried fun perturbAtom(vM, vV, [atm, target]): pickPerturb(vM)(pertAtom(vM, vV, target, atm, PairList []))

    curried fun perturbLiteral(vM, vV, lit): pickPerturb(vM)(pertLiteral(vM, vV, [lit, PairList []]))

    curried fun perturbClause(vM, vV, cl): pickPerturb(vM)(pertClause(vM, vV, cl, PairList []))

    def iexp_prime = iexp_prime_impl

    def union = union_impl

    def oneN = oneN_v2

    def multN = multN_v2

    def numeralFn = numeralFn_v2

    def addFn = addFn_v2

    def divFn = divFn_v2

    def expFn = expFn_v2

    def modFn = modFn_v2

    def multFn = multFn_v2

    def negFn = negFn_v2

    def preFn = preFn_v2

    def subFn = subFn_v2

    def sucFn = sucFn_v2

    def dividesRel = dividesRel_v2

    def evenRel = evenRel_v2

    def geRel = geRel_v2

    def gtRel = gtRel_v2

    def isZeroRel = isZeroRel_v2

    def leRel = leRel_v2

    def ltRel = ltRel_v2

    def oddRel = oddRel_v2

    def check = check_impl

