      Host.Some(Host.hol_div(x)(y))

    curried fun expFn_impl(sz, x, y): Host.Some(Useful.exp(multN_impl(sz))(x)(y)(oneN_impl(sz)))

    curried fun modFn_impl(Size(n), x, y):
      let y = (if Host.hol_equal(y)(0) | n | y)
      Host.Some(Host.hol_mod(x)(y))

    curried fun multFn_impl(sz, x, y): Host.Some(multN_impl(sz, [x, y]))

    curried fun negFn_impl(Size(n), x): Host.Some((if Host.hol_equal(x)(0) | 0 | Host.hol_sub(n)(x)))

    curried fun preFn_impl(Size(n), x): Host.Some((if Host.hol_equal(x)(0) | Host.hol_sub(n)(1) | Host.hol_sub(x)(1)))

    curried fun subFn_impl(Size(n), x, y): Host.Some((if Host.hol_lt(x)(y) | Host.hol_sub(Host.hol_add(n)(x))(y) | Host.hol_sub(x)(y)))

    curried fun sucFn_impl(Size(n), x): Host.Some((if Host.hol_equal(x)(Host.hol_sub(n)(1)) | 0 | Host.hol_add(x)(1)))

    curried fun dividesRel_impl(_, x, y): Host.Some(Useful.divides(x)(y))

    curried fun evenRel_impl(_, x): Host.Some(Host.hol_equal(Host.hol_mod(x)(2))(0))

    curried fun geRel_impl(_, x, y): Host.Some(Host.hol_ge(x)(y))

    curried fun gtRel_impl(_, x, y): Host.Some(Host.hol_gt(x)(y))

    curried fun isZeroRel_impl(_, x): Host.Some(Host.hol_equal(x)(0))

    curried fun leRel_impl(_, x, y): Host.Some(Host.hol_le(x)(y))

    curried fun ltRel_impl(_, x, y): Host.Some(Host.hol_lt(x)(y))

    curried fun oddRel_impl(_, x): Host.Some(Host.hol_equal(Host.hol_mod(x)(2))(1))

