    record Simplify(subsumes, reduce, rewrites)

    record Parameters(clause, prefactor, postfactor)

    record ActiveT(parameters, clauses, units, rewrite, subsume, literals, equations, subterms, allSubterms)

    variant active:
      Active(state)

    fun getSubsume(Active(ActiveT(_,_,_,_,s,_,_,_,_))): s

    fun setRewrite(active):
      fun(rewrite):
        let Active(ActiveT(parameters,clauses,units,_,subsume,literals,equations,subterms,allSubterms)) = active
        Active(
          ActiveT(parameters, clauses, units, rewrite, subsume, literals, equations, subterms, allSubterms)
        )

    def maxSimplify = Simplify(#true, #true, #true)

    def default = Parameters(Clause.default, maxSimplify, maxSimplify)

    fun empty(parameters):
      let Parameters(clause,_,_) = parameters
      let Clause.Parameters(ordering,_,_) = clause
      Active(
        ActiveT(
          parameters,
          Intmap.newMap(#void),
          Units.empty,
          Rewrite.newRewrite(Knuth_bendix_order.compare(ordering)),
          Subsume.newSubsume(#void),
          Literal_net.newNet(Term_net.Parameters(#false)),
          Term_net.newNet(Term_net.Parameters(#false)),
          Term_net.newNet(Term_net.Parameters(#false)),
          Term_net.newNet(Term_net.Parameters(#false))
        )
      )

    fun size(Active(ActiveT(_,clauses,_,_,_,_,_,_,_))): Intmap.size(clauses)

    fun clauses_impl(Active(ActiveT(_,cls,_,_,_,_,_,_,_))):
      let add = (fun([_, cl, acc]): PairList [cl, & acc])
      Intmap.foldr(add)(PairList [])(cls)

    fun saturation(active):
      let remove_2:
        fun([cl, [cls, subs]]):
          let lits = Clause.literals(cl)
          (if Subsume.isStrictlySubsumed(subs)(lits) | [cls, subs] | [PairList [cl, & cls], Subsume.insert(subs)([lits, #void])])
      let cls = clauses_impl(active)
      let [cls, _] = Mlist.foldl(remove_2)([PairList [], Subsume.newSubsume(#void)])(cls)
      let [cls, subs] = Mlist.foldl(remove_2)([PairList [], Subsume.newSubsume(#void)])(cls)
      cls

    fun toString(active): ("Active{" +& (to_string(size(active)) +& "}"))

    fun simplify(simp):
      fun(units):
        fun(rewr):
          fun(subs):
            let Simplify(s,r,w) = simp
            fun rewrite(cl):
              let cl_prime = Clause.rewrite(rewr)(cl)
              if Clause.equalThms(cl)(cl_prime)
              | Some(cl)
              | match Clause.simplify(cl_prime)
                | None(): None()
                | Some(cl_prime_prime): (if Clause.equalThms(cl_prime)(cl_prime_prime) | Some(cl_prime) | rewrite(cl_prime_prime))
            fun(cl):
              match Clause.simplify(cl)
              | None(): None()
              | Some(cl):
                  match (if w | rewrite(cl) | Some(cl))
                  | None(): None()
                  | Some(cl):
                      let cl = (if r | Clause.reduce(units)(cl) | cl)
                      (if (s && Clause.subsumes(subs)(cl)) | None() | Some(cl))

    fun simplifyActive(simp):
      fun(active):
        let Active(ActiveT(_,_,units,rewrite_2,subsume,_,_,_,_)) = active
        simplify(simp)(units)(rewrite_2)(subsume)

    fun addUnit(units):
      fun(cl):
        let th = Clause.thm(cl)
        match Useful.total(Thm.destUnit)(th)
        | Some(lit): Units.add(units)([lit, th])
        | None(): units

    fun addRewrite(rewrite):
      fun(cl):
        let th = Clause.thm(cl)
        match Useful.total(Thm.destUnitEq)(th)
        | Some(l_r): Rewrite.add(rewrite)([Clause.id(cl), [l_r, th]])
        | None(): rewrite

    fun addSubsume(subsume): fun(cl): Subsume.insert(subsume)([Clause.literals(cl), cl])

    fun addLiterals(literals):
      fun(cl):
        let add = (fun([[_, atm] as lit, literals]): (if Atom.isEq(atm) | literals | Literal_net.insert(literals)([lit, [cl, lit]])))
        Literal.Set.foldl(add)(literals)(Clause.largestLiterals(cl))

    fun addEquations(equations):
      fun(cl):
        let add = (fun([[lit, ort, tm], equations]): Term_net.insert(equations)([tm, [cl, lit, ort, tm]]))
        Mlist.foldl(add)(equations)(Clause.largestEquations(cl))

    fun addSubterms(subterms):
      fun(cl):
        let add = (fun([[lit, path, tm], subterms]): Term_net.insert(subterms)([tm, [cl, lit, path, tm]]))
        Mlist.foldl(add)(subterms)(Clause.largestSubterms(cl))

    fun addAllSubterms(allSubterms):
      fun(cl):
        let add = (fun([[_, _, tm], allSubterms]): Term_net.insert(allSubterms)([tm, [cl, tm]]))
        Mlist.foldl(add)(allSubterms)(Clause.allSubterms(cl))

    fun addClause(active):
      fun(cl):
        let Active(ActiveT(parameters,clauses,units,rewrite_3,subsume,literals,equations,subterms,allSubterms)) = active
        let clauses_2 = Intmap.insert(clauses)([Clause.id(cl), cl])
        let subsume_2 = addSubsume(subsume)(cl)
        let literals_2 = addLiterals(literals)(cl)
        let equations_2 = addEquations(equations)(cl)
        let subterms_2 = addSubterms(subterms)(cl)
        let allSubterms_2 = addAllSubterms(allSubterms)(cl)
        Active(
          ActiveT(
            parameters,
            clauses_2,
            units,
            rewrite_3,
            subsume_2,
            literals_2,
            equations_2,
            subterms_2,
            allSubterms_2
          )
        )

    fun addFactorClause(active):
      fun(cl):
        let Active(ActiveT(parameters,clauses,units,rewrite_4,subsume,literals,equations,subterms,allSubterms)) = active
        let units_2 = addUnit(units)(cl)
        let rewrite_5 = addRewrite(rewrite_4)(cl)
        Active(
          ActiveT(parameters, clauses, units_2, rewrite_5, subsume, literals, equations, subterms, allSubterms)
        )

    fun deduceResolution(literals):
      fun(cl):
        fun([[_, atm] as lit, acc]):
          let resolve:
            fun([cl_lit, acc]):
              match Useful.total(Clause.resolve(cl_lit))([cl, lit])
              | Some(cl_prime): PairList [cl_prime, & acc]
              | None(): acc
          (if Atom.isEq(atm) | acc | Mlist.foldl(resolve)(acc)(Literal_net.unify(literals)(Literal.negate(lit))))

    fun deduceParamodulationWith(subterms):
      fun(cl):
        fun([[lit, ort, tm], acc]):
          let para:
            fun([cl_lit_path_tm, acc]):
              match Useful.total(Clause.paramodulate([cl, lit, ort, tm]))(cl_lit_path_tm)
              | Some(cl_prime): PairList [cl_prime, & acc]
              | None(): acc
          Mlist.foldl(para)(acc)(Term_net.unify(subterms)(tm))

    fun deduceParamodulationInto(equations):
      fun(cl):
        fun([[lit, path, tm], acc]):
          let para:
            fun([cl_lit_ort_tm, acc]):
              match Useful.total(Clause.paramodulate(cl_lit_ort_tm))([cl, lit, path, tm])
              | Some(cl_prime): PairList [cl_prime, & acc]
              | None(): acc
          Mlist.foldl(para)(acc)(Term_net.unify(equations)(tm))

    fun deduce(active):
      fun(cl):
        let Active(ActiveT(parameters,_,_,_,_,literals,equations,subterms,_)) = active
        let lits = Clause.largestLiterals(cl)
        let eqns = Clause.largestEquations(cl)
        let subtms = (if Term_net.null(equations) | PairList [] | Clause.largestSubterms(cl))
        let acc = PairList []
        let acc = Literal.Set.foldl(deduceResolution(literals)(cl))(acc)(lits)
        let acc = Mlist.foldl(deduceParamodulationWith(subterms)(cl))(acc)(eqns)
        let acc = Mlist.foldl(deduceParamodulationInto(equations)(cl))(acc)(subtms)
        let acc = PairList.reverse(acc)
        acc

    fun clause_rewritables(active):
      let Active(ActiveT(_,clauses,_,rewrite_6,_,_,_,_,_)) = active
      let rewr:
        fun([id, cl, ids]):
          let cl_prime = Clause.rewrite(rewrite_6)(cl)
          (if Clause.equalThms(cl)(cl_prime) | ids | Intset.add(ids)(id))
      Intmap.foldr(rewr)(Intset.empty)(clauses)

    fun orderedRedexResidues([[[l, r], _], ort]):
      match ort
      | None(): PairList []
      | Some(Rewrite.Left_to_right()): PairList [[l, r, #true]]
      | Some(Rewrite.Right_to_left()): PairList [[r, l, #true]]

    fun unorderedRedexResidues([[[l, r], _], ort]):
      match ort
      | None(): PairList [[l, r, #false], [r, l, #false]]
      | Some(_): PairList []

    fun rewrite_rewritables(active):
      fun(rewr_ids):
        let Active(ActiveT(parameters,clauses,_,rewrite_7,_,_,_,_,allSubterms)) = active
        let Parameters(Clause.Parameters(ordering,_,_),_,_) = parameters
        let order = Knuth_bendix_order.compare(ordering)
        let addRewr = (fun([id, acc]): (if Intmap.inDomain(id)(clauses) | Intset.add(acc)(id) | acc))
        let addReduce:
          fun([[l, r, ord], acc]):
            let isValidRewr:
              fun(tm):
                match Useful.total(Substitute.matchTerms(Substitute.empty)(l))(tm)
                | None(): #false
                | Some(sub):
                    if ord
                    | #true
                    | let tm_prime = Substitute.subst(Substitute.normalize(sub))(r)
                      (order(tm)(tm_prime) == Some(1))
            let addRed:
              fun([[cl, tm], acc]):
                let id = Clause.id(cl)
                if Intset.member(id)(acc)
                | acc
                | (if !isValidRewr(tm) | acc | Intset.add(acc)(id))
            Mlist.foldl(addRed)(acc)(Term_net.matched(allSubterms)(l))
        let addEquation:
          fun(redexResidues):
            fun([id, acc]):
              match Rewrite.peek(rewrite_7)(id)
              | None(): acc
              | Some(eqn_ort): Mlist.foldl(addReduce)(acc)(redexResidues(eqn_ort))
        let addOrdered = addEquation(orderedRedexResidues)
        let addUnordered = addEquation(unorderedRedexResidues)
        let ids = Intset.empty
        let ids = Mlist.foldl(addRewr)(ids)(rewr_ids)
        let ids = Mlist.foldl(addOrdered)(ids)(rewr_ids)
        let ids = Mlist.foldl(addUnordered)(ids)(rewr_ids)
        ids

    fun choose_clause_rewritables(active): fun(ids): (size(active) <= length(ids))

    fun rewritables(active): fun(ids): (if choose_clause_rewritables(active)(ids) | clause_rewritables(active) | rewrite_rewritables(active)(ids))

    fun delete(active):
      fun(ids):
        if Intset.null(ids)
        | active
        | let idPred = (fun(id): !Intset.member(id)(ids))
          let clausePred = (fun(cl): idPred(Clause.id(cl)))
          let Active(ActiveT(parameters,clauses,units,rewrite_8,subsume,literals,equations,subterms,allSubterms)) = active
          let cP1 = (fun([x, _]): clausePred(x))
          let cP1_4 = (fun([x, _, _, _]): clausePred(x))
          let clauses_3 = Intmap.filter((fun(x): idPred(fst(x))))(clauses)
          let subsume_3 = Subsume.filter(clausePred)(subsume)
          let literals_3 = Literal_net.filter(cP1)(literals)
          let equations_3 = Term_net.filter(cP1_4)(equations)
          let subterms_3 = Term_net.filter(cP1_4)(subterms)
          let allSubterms_3 = Term_net.filter(cP1)(allSubterms)
          Active(
            ActiveT(
              parameters,
              clauses_3,
              units,
              rewrite_8,
              subsume_3,
              literals_3,
              equations_3,
              subterms_3,
              allSubterms_3
            )
          )

    fun extract_rewritables(Active(ActiveT(_,clauses,_,rewrite,_,_,_,_,_)) as active):
      if Rewrite.isReduced(rewrite)
      | [active, PairList []]
      | let [rewrite_9, ids] = Rewrite.reduce_prime(rewrite)
        let active = setRewrite(active)(rewrite_9)
        let ids = rewritables(active)(ids)
        let cls = Intset.transform(Intmap.get(clauses))(ids)
        [delete(active)(ids), cls]

    fun prefactor_simplify(active):
      fun(subsume):
        let Active(ActiveT(parameters,_,units,rewrite_10,_,_,_,_,_)) = active
        let Parameters(_,prefactor,_) = parameters
        simplify(prefactor)(units)(rewrite_10)(subsume)

    fun postfactor_simplify(active):
      fun(subsume):
        let Active(ActiveT(parameters,_,units,rewrite_11,_,_,_,_,_)) = active
        let Parameters(_,_,postfactor) = parameters
        simplify(postfactor)(units)(rewrite_11)(subsume)

    def sort_utilitywise:
      let utility:
        fun(cl):
          match Literal.Set.size(Clause.literals(cl))
          | 0: -1
          | 1: (if Thm.isUnitEq(Clause.thm(cl)) | 0 | 1)
          | n: n
      Mlist.sortMap(utility)(Useful.intCompare)

    fun post_factor([cl, [active, subsume, acc] as active_subsume_acc]):
      match postfactor_simplify(active)(subsume)(cl)
      | None(): active_subsume_acc
      | Some(cl_prime):
          if Clause.equalThms(cl_prime)(cl)
          | let active_2 = addFactorClause(active)(cl)
            let subsume_4 = addSubsume(subsume)(cl)
            let acc_2 = PairList [cl, & acc]
            [active_2, subsume_4, acc_2]
          | factor1([cl_prime, active_subsume_acc])

    fun factor1([cl, active_subsume_acc]):
      let cls = sort_utilitywise(PairList [cl, & Clause.factor(cl)])
      Mlist.foldl(post_factor)(active_subsume_acc)(cls)

    fun pre_factor([cl, [active, subsume, _] as active_subsume_acc]):
      match prefactor_simplify(active)(subsume)(cl)
      | None(): active_subsume_acc
      | Some(cl): factor1([cl, active_subsume_acc])

    fun factor_prime_impl(active):
      fun(acc):
        fun
        | (PairList []): [active, PairList.reverse(acc)]
        | (cls):
            let cls = sort_utilitywise(cls)
            let subsume = getSubsume(active)
            let [active, _, acc] = Mlist.foldl(pre_factor)([active, subsume, acc])(cls)
            let [active, cls] = extract_rewritables(active)
            factor_prime_impl(active)(acc)(cls)

    fun factor(active): fun(cls): factor_prime_impl(active)(PairList [])(cls)

    fun mk_clause(params): fun(th): Clause.mk(Clause.ClauseInfo(params, Clause.newId(#void), th))

    fun newActive(parameters):
      fun(Ax_cj.AxCjThm(axioms_thm,conjecture_thm)):
        let Parameters(clause,_,_) = parameters
        let mk_clause = mk_clause(clause)
        let active = empty(parameters)
        let [active, axioms] = factor(active)(PairList.map(axioms_thm, mk_clause))
        let [active, conjecture] = factor(active)(PairList.map(conjecture_thm, mk_clause))
        [active, Ax_cj.AxCjCl(axioms, conjecture)]

    fun add(active):
      fun(cl):
        match simplifyActive(maxSimplify)(active)(cl)
        | None(): [active, PairList []]
        | Some(cl_prime):
            if Clause.isContradiction(cl_prime)
            | [active, PairList [cl_prime]]
            | if !Clause.equalThms(cl)(cl_prime)
              | factor(active)(PairList [cl_prime])
              | let active = addClause(active)(cl)
                let cl = Clause.freshVars(cl)
                let cls = deduce(active)(cl)
                let [active, cls] = factor(active)(cls)
                [active, cls]

  namespace Waiting:
    export:
      ModelParameters
      Parameters
      WaitingT
      Waiting
      defaultModels
      default
      size
      toString
      mkModelClause
      mkModelClauses
      perturbModel
      initialModel
      checkModels
      perturbModels
      clauseSymbols
      clauseVariables
      clauseLiterals
      clausePriority
      clauseWeight
      rename add_prime_impl as add_prime
      add
      cmp
      empty
      newWaiting
      rename remove_impl as remove

    record ModelParameters(model, initialPerturbations, maxChecks, perturbations, weight)

    record Parameters(symbolsWeight, variablesWeight, literalsWeight, modelsP)

    record WaitingT(parameters, clauses, models)

    variant waiting:
      Waiting(state)

    def defaultModels = PairList [ModelParameters(Model.default, 100, Some(20), 0, 1.0)]

    def default = Parameters(1.0, 1.0, 1.0, defaultModels)

    fun size(Waiting(WaitingT(_,clauses,_))): Heap.size(clauses)

    fun toString(w): ("Waiting{" +& (to_string(size(w)) +& "}"))

    fun mkModelClause(cl):
      let lits = Clause.literals(cl)
      let fvs = Literal.Set.freeVars(lits)
      [fvs, lits]

    def mkModelClauses = OCamlList.map(mkModelClause)

    fun perturbModel(vM):
      fun(cls):
        if Mlist.null(cls)
        | K(#void)
        | let vN = Model.Size(Model.msize(vM))
          let perturbClause:
            fun([fv, cl]):
              let vV = Model.randomValuation(vN)(fv)
              (if Model.interpretClause(vM)(vV)(cl) | #void | Model.perturbClause(vM)(vV)(cl))
          let perturbClauses = (fun(_): PairList.for_each(cls, perturbClause))
          (fun(n): funpow(n)(perturbClauses)(#void))

    fun initialModel(axioms):
      fun(conjecture):
        fun(parm):
          let ModelParameters(model,initialPerturbations,_,_,_) = parm
          let m = Model.newModel(model)
          let #void = perturbModel(m)(conjecture)(initialPerturbations)
          let #void = perturbModel(m)(axioms)(initialPerturbations)
          m

    fun checkModels(parms):
      fun(models):
        fun([fv, cl]):
          let check_2:
            fun([[parm, model], z]):
              let ModelParameters(_,_,maxChecks,_,weight) = parm
              let n = maxChecks
              let [vT, vF] = Model.check(Model.interpretClause)(n)(model)(fv)(cl)
              ((1.0 + (hol_float(vT) / power_num(hol_float((vT + vF)))(weight))) * z)
          Mlist.foldl(check_2)(1.0)(zip(parms)(models))

    fun perturbModels(parms):
      fun(models):
        fun(cls):
          let perturb:
            fun([parm, model]):
              let ModelParameters(_,_,_,perturbations,_) = parm
              perturbModel(model)(cls)(perturbations)
          PairList.for_each(zip(parms)(models), perturb)

    fun clauseSymbols(cl): hol_float(Literal.Set.typedSymbols(cl))

    fun clauseVariables(cl): hol_float((Name.Set.size(Literal.Set.freeVars(cl)) + 1))

    fun clauseLiterals(cl): hol_float(Literal.Set.size(cl))

    fun clausePriority(cl): ((1e-12) * hol_float(Clause.id(cl)))

    fun clauseWeight(parm):
      fun(mods):
        fun(dist):
          fun(mcl):
            fun(cl):
              let Parameters(symbolsWeight,variablesWeight,literalsWeight,modelsP) = parm
              let lits = Clause.literals(cl)
              let symbolsW = power_num(clauseSymbols(lits))(symbolsWeight)
              let variablesW = power_num(clauseVariables(lits))(variablesWeight)
              let literalsW = power_num(clauseLiterals(lits))(literalsWeight)
              let modelsW = checkModels(modelsP)(mods)(mcl)
              let weight = ((((dist * symbolsW) * variablesW) * literalsW) * modelsW)
              let weight = (weight + clausePriority(cl))
              weight

    fun add_prime_impl(waiting):
      fun(dist):
        fun(mcls):
          fun(cls):
            let Waiting(WaitingT(parameters,clauses,models)) = waiting
            let Parameters(_,_,_,modelParameters) = parameters
            let dist = (dist + log(hol_float(length(cls))))
            let addCl:
              fun([[mcl, cl], acc]):
                let weight = clauseWeight(parameters)(models)(dist)(mcl)(cl)
                Heap.add(acc)([weight, [dist, cl]])
            let clauses = Mlist.foldl(addCl)(clauses)(zip(mcls)(cls))
            let #void = perturbModels(modelParameters)(models)(mcls)
            Waiting(WaitingT(parameters, clauses, models))

    fun add(waiting):
      fun([dist, cls]):
        if Mlist.null(cls)
        | waiting
        | let waiting = add_prime_impl(waiting)(dist)(mkModelClauses(cls))(cls)
          waiting

    fun cmp([w1, _]): fun([w2, _]): compare(w1)(w2)

    fun empty(parameters):
      fun(axioms):
        fun(conjecture):
          let Parameters(_,_,_,modelParameters) = parameters
          let clauses_2 = Heap.newHeap(cmp)
          let models_2 = OCamlList.map(initialModel(axioms)(conjecture))(modelParameters)
          Waiting(WaitingT(parameters, clauses_2, models_2))

    fun newWaiting(parameters):
      fun(Ax_cj.AxCjCl(axioms_cl,conjecture_cl)):
        let mAxioms_2 = mkModelClauses(axioms_cl)
        let mConjecture_2 = mkModelClauses(conjecture_cl)
        let waiting = empty(parameters)(mAxioms_2)(mConjecture_2)
        (if (Mlist.null(axioms_cl) && Mlist.null(conjecture_cl)) | waiting | add_prime_impl(waiting)(0.0)(append(mAxioms_2)(mConjecture_2))(append(axioms_cl)(conjecture_cl)))

    fun remove_impl(Waiting(WaitingT(parameters,clauses,models))):
      if Heap.null(clauses)
      | None()
      | let [[_, dcl], clauses] = Heap.remove(clauses)
        let waiting = Waiting(WaitingT(parameters, clauses, models))
        Some([dcl, waiting])

  namespace Resolution:
    export:
      Parameters
      ResolutionT
      Resolution
      default
      newResolution
      rename active_impl as active
      rename waiting_impl as waiting
      Contradiction
      Satisfiable
      Decided
      Undecided
      iterate
      loop

    record Parameters(activeP, waitingP)

    record ResolutionT(parameters, active, waiting)

    variant resolution:
      Resolution(state)

    def default = Parameters(Active.default, Waiting.default)

    fun newResolution(parameters):
      fun(ths):
        let Parameters(activeParm,waitingParm) = parameters
        let [active, cls] = Active.newActive(activeParm)(ths)
        let waiting = Waiting.newWaiting(waitingParm)(cls)
        Resolution(ResolutionT(parameters, active, waiting))

    fun active_impl(Resolution(ResolutionT(_,a,_))): a

    fun waiting_impl(Resolution(ResolutionT(_,_,w))): w

    variant decision:
      Contradiction(theorem)
      Satisfiable(clauses)

    variant state:
      Decided(decision)
      Undecided(resolution)

    fun iterate(res):
      let Resolution(ResolutionT(parameters,active,waiting)) = res
      match Waiting.remove(waiting)
      | None():
          let sat = Satisfiable(PairList.map(Active.saturation(active), Clause.thm))
          Decided(sat)
      | Some([[d, cl], waiting]):
          if Clause.isContradiction(cl)
          | Decided(Contradiction(Clause.thm(cl)))
          | let [active, cls] = Active.add(active)(cl)
            let waiting = Waiting.add(waiting)([d, cls])
            let res = Resolution(ResolutionT(parameters, active, waiting))
            Undecided(res)

    fun loop(res):
      match iterate(res)
      | Decided(dec): dec
      | Undecided(res): loop(res)

  namespace Loop:
    export:
      loop
      run

    fun loop(res):
      match Resolution.iterate(res)
      | Resolution.Decided(dec): Some(dec)
      | Resolution.Undecided(res): loop(res)

    fun run(rules):
      let ths = Ax_cj.AxCjThm(rules, PairList [])
      let res = Resolution.newResolution(Resolution.default)(ths)
      match loop(res)
      | None(): failwith("metis: timeout")
      | Some(Resolution.Contradiction(thm)): thm
      | Some(Resolution.Satisfiable(_)): failwith("metis: found satisfiable assignment")

namespace Metis_debug:
  export:
    print_varandtype
    rename show_types_v2 as show_types
    hide_types

  fun print_varandtype(fmt):
    fun(tm):
      let [hop, args] = strip_comb(tm)
      let s_2 = Host.name_of(hop)
      let ty_2 = type_of(hop)
      if (is_var(hop) && (args == (PairList [])))
      | Host.OCamlFormat.pp_print_string(fmt)("(")
        Host.OCamlFormat.pp_print_string(fmt)(s_2)
        Host.OCamlFormat.pp_print_string(fmt)(":")
        Host.pp_print_type(fmt)(ty_2)
        Host.OCamlFormat.pp_print_string(fmt)(")")
      | fail()

  def [show_types_v2, hide_types]:
    [
      (fun(_): Host.install_user_printer(["Show Types", print_varandtype])),
      fun(_):
        try:
          Host.delete_user_printer("Show Types")
          ~catch exn:
            match exn
            | Failure(_): failwith(("hide_types: " +& "Types are already hidden."))
            | exn: (throw exn)
    ]

namespace Preterm:
  export:
    mk_negp
    mk_eqp
    mk_conjp
    mk_disjp
    list_mk_combp
    list_mk_disjp
    unconst_preterm
    env_of_preterm
    env_of_th
    env_of_ths

  fun mk_negp(pt): TypeInference.Combp(TypeInference.preterm_of_term(@hol|{~}|), pt)

  fun mk_eqp([ps, pt]): TypeInference.Combp(TypeInference.Combp(TypeInference.Constp("=", TypeInference.dpty), ps), pt)

  fun mk_conjp([ps, pt]):
    TypeInference.Combp(
      TypeInference.Combp(TypeInference.preterm_of_term(@hol|{/\}|), ps),
      pt
    )

  fun mk_disjp([ps, pt]):
    TypeInference.Combp(
      TypeInference.Combp(TypeInference.preterm_of_term(@hol|{\/}|), ps),
      pt
    )

  fun list_mk_combp([h, t]): rev_itlist(fun(x): fun(acc): TypeInference.Combp(acc, x))(t)(h)

  def initialization_1:
    if (
      (list_mk_combp(
          [
            TypeInference.Varp("1", TypeInference.dpty),
            PairList [
              TypeInference.Varp("2", TypeInference.dpty),
              TypeInference.Varp("3", TypeInference.dpty)
            ]
          ]
        ) == TypeInference.Combp(
          TypeInference.Combp(
            TypeInference.Varp("1", TypeInference.Ptycon("", PairList [])),
            TypeInference.Varp("2", TypeInference.Ptycon("", PairList []))
          ),
          TypeInference.Varp("3", TypeInference.Ptycon("", PairList []))
        ))
    )
    | #void
    | failwith("Assertion failed")

  fun list_mk_disjp
  | list_mk_disjp(PairList []): TypeInference.preterm_of_term(@hol|{F}|)
  | list_mk_disjp(PairList [h, & t]): itlist(curry(mk_disjp))(t)(h)

  fun unconst_preterm
  | unconst_preterm(TypeInference.Varp(s,pty)): TypeInference.Varp(s, pty)
  | unconst_preterm(TypeInference.Constp(s,pty)): TypeInference.Varp(s, pty)
  | unconst_preterm(TypeInference.Combp(l,r)): TypeInference.Combp(unconst_preterm(l), unconst_preterm(r))
  | unconst_preterm(TypeInference.Typing(ptm,pty)): TypeInference.Typing(unconst_preterm(ptm), pty)
  | unconst_preterm(_): failwith("unconst_preterm")

  fun env_of_preterm
  | env_of_preterm(TypeInference.Varp(s,pty)): PairList [[s, pty]]
  | env_of_preterm(TypeInference.Constp(s,pty)): PairList []
  | env_of_preterm(TypeInference.Combp(l,r)): append(env_of_preterm(l))(env_of_preterm(r))
  | env_of_preterm(TypeInference.Typing(ptm,pty)): env_of_preterm(ptm)
  | env_of_preterm(_): failwith("env_of_preterm")

  def env_of_th = o(o(env_of_preterm)(TypeInference.preterm_of_term))(concl)

  def env_of_ths = o(OCamlList.concat)(OCamlList.map(env_of_th))

namespace Metis_mapping:
  export:
    rename reset_consts_v2 as reset_consts
    rename fol_of_const_v2 as fol_of_const
    hol_of_const
    preterm_of_const
    prefix
    preterm_of_fol_term
    preterm_of_predicate
    preterm_of_atom
    preterm_of_literal
    preterm_of_eq
    typecheck
    typecheckl
    hol_of_term
    hol_of_atom
    hol_of_literal
    hol_of_clause
    hol_of_substitution

  def [reset_consts_v2, fol_of_const_v2, hol_of_const] = [Meson.Meson.reset_consts, Meson.Meson.fol_of_const, Meson.Meson.hol_of_const]

  def preterm_of_const = o(o(TypeInference.preterm_of_term)(hol_of_const))(hol_int_of_string)

  fun prefix(s): ("__" +& s)

  fun preterm_of_fol_term
  | preterm_of_fol_term(Metis_prover.Term.Var(x)): TypeInference.Varp(prefix(x), TypeInference.dpty)
  | preterm_of_fol_term(Metis_prover.Term.Fn([f, args])):
      let pf = preterm_of_const(f)
      let pargs = PairList.map(args, preterm_of_fol_term)
      Preterm.list_mk_combp([pf, pargs])

  fun preterm_of_predicate
  | preterm_of_predicate("="): TypeInference.Constp("=", TypeInference.dpty)
  | preterm_of_predicate(p): preterm_of_const(p)

  fun preterm_of_atom([p, args]):
    let pp = preterm_of_predicate(p)
    let pargs = PairList.map(args, preterm_of_fol_term)
    TypeInference.Typing(Preterm.list_mk_combp([pp, pargs]), TypeInference.pretype_of_type(bool_ty))

  fun preterm_of_literal([pol, fat]):
    let pat = preterm_of_atom(fat)
    (if pol | pat | Preterm.mk_negp(pat))

  fun preterm_of_eq([s, t]): Preterm.mk_eqp([preterm_of_fol_term(s), preterm_of_fol_term(t)])

  fun typecheck(env): o(o(TypeInference.term_of_preterm)(TypeInference.retypecheck(env)))(Preterm.unconst_preterm)

  fun typecheckl(env):
    fun(stage_arg):
      match stage_arg
      | PairList []: PairList []
      | xs: ((Preterm.list_mk_disjp(xs) |> typecheck(env)) |> disjuncts)

  fun hol_of_term(env): o(typecheck(env))(preterm_of_fol_term)

  fun hol_of_atom(env): o(typecheck(env))(preterm_of_atom)

  fun hol_of_literal(env): o(typecheck(env))(preterm_of_literal)

  fun hol_of_clause(env): o(o(typecheck(env))(Preterm.list_mk_disjp))(map(preterm_of_literal))

  fun hol_of_substitution(env): o(o(map(dest_eq))(typecheckl(env)))(map(preterm_of_eq))

namespace Metis_path:
  export:
    hol_of_term_path
    hol_of_atom_path
    hol_of_literal_path

  fun hol_of_term_path(tm):
    fun(path):
      match [tm, path]
      | [tm, PairList []]: [tm, ""]
      | [Metis_prover.Term.Fn([f, args]), PairList [i, & is]]:
          let arity = length(args)
          (if (i < arity) | #void | failwith("Assertion failed"))
          let [tm_prime, path_prime] = hol_of_term_path(OCamlList.nth(args)(i))(is)
          [
            tm_prime,
            (hol_string_make(((arity - i) - 1))("l") +& ("r" +& path_prime))
          ]
      | _: failwith("hol_of_term_path")

  fun hol_of_atom_path([p, args]): hol_of_term_path(Metis_prover.Term.Fn([p, args]))

  fun hol_of_literal_path([pol, atom]):
    fun(path):
      let [s, path] = hol_of_atom_path(atom)(path)
      [s, (if pol | path | ("r" +& path))]

namespace Metis_unify:
  export:
    verb
    Unify
    unify_fo_ho_term
    unify_fo_ho_atom
    unify_fo_ho_literal

  def verb = Box(#false)

  class Unify()

  fun unify_fo_ho_term(vars):
    fun(fat):
      fun(tm):
        fun(m):
          (if verb.value | hol_printf("unify_fo_ho_term: fat = %s, tm = %s\n%!")(Metis_prover.Term.toString(fat))(Host.string_of_term(tm)) | #void)
          match fat
          | Metis_prover.Term.Var(v):
              if OCamlList.mem_assoc(v)(m)
              | (if verb.value | hol_printf("var_assoc\n%!") | #void)
                let tm_prime = OCamlList.assoc(v)(m)
                (if (tm == tm_prime) | m | (throw Unify()))
              | match fat
                | Metis_prover.Term.Var(v):
                    (if verb.value | hol_printf("var\n%!") | #void)
                    if (is_var(tm) && !OCamlList.mem(tm)(vars))
                    | PairList [[v, tm], & m]
                    | (if verb.value | hol_printf("Unify!\n%!") | #void)
                      (throw Unify())
                | Metis_prover.Term.Fn([f, args]):
                    (if verb.value | hol_printf("fn\n%!") | #void)
                    let [hf, hargs]:
                      try:
                        strip_comb(tm)
                        ~catch exn:
                          match exn
                          | Failure(_): (throw Unify())
                          | exn: (throw exn)
                    if verb.value
                    | hol_printf("hf = %s\n%!")(Host.string_of_term(hf))
                      hol_printf("is_var: %s\n%!")((if is_var(hf) | "true" | "false"))
                    | #void
                    (if (is_const(hf) || is_var(hf)) | #void | failwith("Assertion failed"))
                    (if (hf == Metis_mapping.hol_of_const(hol_int_of_string(f))) | itlist2(unify_fo_ho_term(vars))(args)(hargs)(m) | (throw Unify()))
          | Metis_prover.Term.Var(v):
              (if verb.value | hol_printf("var\n%!") | #void)
              if (is_var(tm) && !OCamlList.mem(tm)(vars))
              | PairList [[v, tm], & m]
              | (if verb.value | hol_printf("Unify!\n%!") | #void)
                (throw Unify())
          | Metis_prover.Term.Fn([f, args]):
              (if verb.value | hol_printf("fn\n%!") | #void)
              let [hf, hargs]:
                try:
                  strip_comb(tm)
                  ~catch exn:
                    match exn
                    | Failure(_): (throw Unify())
                    | exn: (throw exn)
              if verb.value
              | hol_printf("hf = %s\n%!")(Host.string_of_term(hf))
                hol_printf("is_var: %s\n%!")((if is_var(hf) | "true" | "false"))
              | #void
              (if (is_const(hf) || is_var(hf)) | #void | failwith("Assertion failed"))
              (if (hf == Metis_mapping.hol_of_const(hol_int_of_string(f))) | itlist2(unify_fo_ho_term(vars))(args)(hargs)(m) | (throw Unify()))

  fun unify_fo_ho_atom(vars):
    fun([p, args]):
      fun(htm):
        fun(m):
          if (p == "=")
          | try:
              let [hl, hr] = dest_eq(htm)
              itlist2(unify_fo_ho_term(vars))(args)(PairList [hl, hr])(m)
              ~catch exn:
                match exn
                | Failure(_): (throw Unify())
                | exn: (throw exn)
          | unify_fo_ho_term(vars)(Metis_prover.Term.Fn([p, args]))(htm)(m)

  fun unify_fo_ho_literal(vars):
    fun([pol, atom]):
      fun(htm):
        fun(m):
          let htm_prime:
            if pol
            | htm
            | try:
                dest_neg(htm)
                ~catch exn:
                  match exn
                  | Failure(_): (throw Unify())
                  | exn: (throw exn)
          unify_fo_ho_atom(vars)(atom)(htm_prime)(m)

namespace Metis_rules:
  export:
    FRONT
    RESOLVE_N
    RESOLVE
    DISCH_DISJ
    DISCH_DISJS

  fun FRONT(lit):
    fun(thm):
      let conc = concl(thm)
      let disj = disjuncts(concl(thm))
      let rest:
        match partition((fun(l): (l == lit)))(disj)
        | [PairList [], _]: failwith("FRONT: literal not in disjunction")
        | [_, r]: r
      let disj_prime = PairList [lit, & rest]
      let conc_prime = list_mk_disj(disj_prime)
      let eq = DISJ_ACI_RULE(mk_eq([conc, conc_prime]))
      [PURE_ONCE_REWRITE_RULE(PairList [eq])(thm), rest]

  def RESOLVE_N:
    let RESOLVE_1_2 = TAUT(@hol|{!a. a ==> ~a ==> F}|)
    let RESOLVE_2L_2:
      TAUT(
        @hol|{!a b. a \/ b ==> ~a ==> b}|
      )
    let RESOLVE_2R_2:
      TAUT(
        @hol|{!a c. a ==> ~a \/ c ==> c}|
      )
    let RESOLVE_3_2:
      TAUT(
        @hol|{!a b c. a \/ b ==> ~a \/ c ==> b \/ c}|
      )
    fun(atom):
      fun
      | ([PairList [], PairList []]): SPEC(atom)(RESOLVE_1_2)
      | ([r1, PairList []]): SPECL(PairList [atom, list_mk_disj(r1)])(RESOLVE_2L_2)
      | ([PairList [], r2]): SPECL(PairList [atom, list_mk_disj(r2)])(RESOLVE_2R_2)
      | ([r1, r2]): SPECL(PairList [atom, list_mk_disj(r1), list_mk_disj(r2)])(RESOLVE_3_2)

  fun RESOLVE(atom):
    fun(th1):
      fun(th2):
        try:
          let [th1_prime_2, r1_2] = FRONT(atom)(th1)
          let [th2_prime_2, r2_2] = FRONT(mk_neg(atom))(th2)
          let res = RESOLVE_N(atom)([r1_2, r2_2])
          MP(MP(res)(th1_prime_2))(th2_prime_2)
          ~catch exn:
            match exn
            | Failure(_): failwith("resolve")
            | exn: (throw exn)

  def DISCH_DISJ:
    let IMPL_NOT_L_2:
      TAUT(
        @hol|{!a b. ~a ==> b <=>  a \/ b}|
      )
    let IMPL_NOT_R_2:
      TAUT(
        @hol|{!a b.  a ==> b <=> ~a \/ b}|
      )
    fun(tm):
      fun(th):
        let impl_2 = DISCH(tm)(th)
        let [tm_prime_2, IMPL_NOT_2]:
          try:
            [dest_neg(tm), IMPL_NOT_L_2]
            ~catch exn:
              match exn
              | Failure(_): [tm, IMPL_NOT_R_2]
              | exn: (throw exn)
        let eq = SPECL(PairList [tm_prime_2, concl(th)])(IMPL_NOT_2)
        PURE_ONCE_REWRITE_RULE(PairList [eq])(impl_2)

  fun DISCH_DISJS(tms): fun(th): OCamlList.fold_right(DISCH_DISJ)(tms)(th)

namespace Metis_reconstruct2:
  export:
    term_eq_mod_type
    match_elems
    match_fo_ho_clause
    string_of_tminst
    string_of_tyinst
    string_of_instantiation
    reorient_tysubst
    hol_of_thm

  fun term_eq_mod_type(t1):
    fun(t2):
      fun(tyinsts):
        try:
          let [_, tminsts, tyinsts] = term_type_unify(t1)(t2)([PairList [], PairList [], tyinsts])
          if metisverb.value
          | hol_printf("unified with |tminsts| = %d!\n%!")(PairList.length(tminsts))
            OCamlList.iter(
              (fun([t1, t2]): hol_printf("%s <- %s\n%!")(Host.string_of_term(t1))(Host.string_of_term(t2)))
            )(tminsts)
          | #void
          (if (tminsts == (PairList [])) | Some(tyinsts) | None())
          ~catch exn:
            match exn
            | Failure(_): None()
            | exn: (throw exn)

  fun match_elems(f):
    fun(m):
      fun
      | ([PairList [], PairList []]): PairList [m]
      | ([PairList [], _]): PairList []
      | ([PairList [x, & xs], ys]):
          (OCamlList.map(
              fun(y):
                match f(x)(y)(m)
                | Some(m_prime): match_elems(f)(m_prime)([xs, PairList.filter(ys, ~keep: (fun (other): !(y === other)))])
                | None(): PairList []
            )(ys) |> OCamlList.concat)

  fun match_fo_ho_clause(vars):
    match_elems(
      fun(ft):
        fun(ht):
          fun(m):
            try:
              Some(Metis_unify.unify_fo_ho_literal(vars)(ft)(ht)(m))
              ~catch exn:
                match exn
                | Metis_unify.Unify(): None()
                | exn: (throw exn)
    )(PairList [])

  def string_of_tminst:
    o(hol_string_concat(", "))(
      map(
        (fun([tm, v]): (Host.string_of_term(tm) +& (" <- " +& Host.string_of_term(v))))
      )
    )

  def string_of_tyinst:
    o(hol_string_concat(", "))(
      map(
        (fun([ty, v]): (Host.string_of_type(ty) +& (" <- " +& Host.string_of_type(v))))
      )
    )

  fun string_of_instantiation([it, tminst, tyinst]):
    ("([" +& (string_of_tminst(tminst) +& ("], [" +& (string_of_tyinst(tyinst) +& "])"))))

  fun reorient_tysubst(vars):
    fun(sub):
      let sub_prime:
        map(
          (fun([ty, v]): (if (OCamlList.mem(v)(vars) && is_vartype(ty)) | [v, ty] | [ty, v]))
        )(sub)
      map((fun([ty, v]): [tysubst(sub_prime)(ty), v]))(sub_prime)

  fun hol_of_thm(axioms):
    fun(fth):
      (if metisverb.value | hol_printf("hol_of_thm: %s\n%!")(Metis_prover.Thm.toString(fth)) | #void)
      let env = Preterm.env_of_ths(axioms)
      let hth:
        match Metis_prover.Proof.thmToInference(fth)
        | Metis_prover.Proof.Axiom(clause):
            let clausel = Metis_prover.Literal.Set.toList(clause)
            let maxs:
              Utils.List.concat_map(
                fun(ax):
                  let disjs = (concl(ax) |> striplist(dest_disj))
                  let tmvars = freesl(hyp(ax))
                  let ms = match_fo_ho_clause(tmvars)([clausel, disjs])
                  map((fun(m): [m, ax]))(ms)
              )(axioms)
            (if (PairList.length(maxs) > 0) | #void | failwith("Assertion failed"))
            let tminst = OCamlList.map((fun([v, tm]): [mk_var([Metis_mapping.prefix(v), type_of(tm)]), tm]))
            (if metisverb.value | hol_printf("length maxs = %d\n%!")(PairList.length(maxs)) | #void)
            if metisverb.value
            | OCamlList.iter(
                (fun([m, ax]): hol_printf("max: %s with m = %s\n%!")(Host.string_of_thm(ax))(string_of_tminst(tminst(m))))
              )(maxs)
            | #void
            let [m, ax] = OCamlList.hd(maxs)
            INST(tminst(m))(ax)
        | Metis_prover.Proof.Subst(fsub,fth1):
            let th1 = hol_of_thm(axioms)(fth1)
            (if metisverb.value | hol_printf("subst with th1 = %s\n%!")(Host.string_of_thm(th1)) | #void)
            let fsubl = Metis_prover.Substitute.toList(fsub)
            (if metisverb.value | hol_printf("before substitution lifting\n%!") | #void)
            let hsub = (map((fun([v, t]): [t, Metis_prover.Term.Var(v)]))(fsubl) |> Metis_mapping.hol_of_substitution(env))
            (if metisverb.value | hol_printf("subst: %s\n%!")(string_of_tminst(hsub)) | #void)
            let tyinst:
              itlist(
                fun([t, v]):
                  fun(m):
                    let v_prime = find((fun(v_prime): (Host.name_of(v_prime) == Host.name_of(v))))(frees(concl(th1)))
                    type_unify(type_of(v))(type_of(v_prime))(m)
              )(hsub)(PairList [])
            let tminst = map((fun([t, v]): [inst(tyinst)(t), inst(tyinst)(v)]))(hsub)
            (if metisverb.value | hol_printf("before instantiate of th1 = %s with %s\n%!")(Host.string_of_thm(th1))(string_of_instantiation([PairList [], tminst, tyinst])) | #void)
            INSTANTIATE([PairList [], tminst, tyinst])(th1)
        | Metis_prover.Proof.Resolve(atom,fth1,fth2):
            let th1_2 = hol_of_thm(axioms)(fth1)
            let th2_2 = hol_of_thm(axioms)(fth2)
            let env = append(Preterm.env_of_ths(PairList [th1_2, th2_2]))(env)
            if metisverb.value
            | OCamlList.iter(
                (fun([s, pty]): hol_printf("%s <- %s\n%!")(s)(Host.string_of_type(TypeInference.type_of_pretype(pty))))
              )(env)
            | #void
            (if metisverb.value | hol_printf("before resolving\n%!") | #void)
            (if metisverb.value | hol_printf("th1 = %s\n%!")(Host.string_of_thm(th1_2)) | #void)
            (if metisverb.value | hol_printf("th2 = %s\n%!")(Host.string_of_thm(th2_2)) | #void)
            let tm1_2 = (striplist(dest_disj)(concl(th1_2)) |> OCamlList.filter(o((fun (x): !x))(is_neg)))
            let tm2_2:
              ((striplist(dest_disj)(concl(th2_2)) |> OCamlList.filter(is_neg)) |> OCamlList.map(dest_neg))
            (if metisverb.value | OCamlList.iter(o(hol_printf("tm1: %s\n%!"))(Host.string_of_term))(tm1_2) | #void)
            (if metisverb.value | OCamlList.iter(o(hol_printf("tm2: %s\n%!"))(Host.string_of_term))(tm2_2) | #void)
            let hatom = Metis_mapping.hol_of_atom(env)(atom)
            (if metisverb.value | hol_printf("hatom: %s\n%!")(Host.string_of_term(hatom)) | #void)
            let cands:
              Utils.List.concat_map(
                fun(x):
                  match term_eq_mod_type(hatom)(x)(PairList [])
                  | None(): PairList []
                  | Some(m): Utils.List.filter_map((fun(y): term_eq_mod_type(hatom)(y)(m)))(tm2_2)
              )(tm1_2)
            (if metisverb.value | hol_printf("%d candidates available\n%!")(PairList.length(cands)) | #void)
            (if (PairList.length(cands) > 0) | #void | failwith("Assertion failed"))
            let h = OCamlList.hd(cands)
            (if OCamlList.for_all((fun (y): h == y))(cands) | #void | failwith("Assertion failed"))
            let tyinsts = OCamlList.hd(cands)
            let tyvars:
              (((map(hyp)(axioms) |> OCamlList.concat) |> map(type_vars_in_term)) |> OCamlList.concat)
            (if metisverb.value | hol_printf("Reorienting type substitution ...\n%!") | #void)
            let tyinsts = reorient_tysubst(tyvars)(tyinsts)
            (if metisverb.value | hol_printf("Resolving ...\n%!") | #void)
            Metis_rules.RESOLVE(inst(tyinsts)(hatom))(INST_TYPE(tyinsts)(th1_2))(INST_TYPE(tyinsts)(th2_2))
        | Metis_prover.Proof.Refl(term): REFL(Metis_mapping.hol_of_term(env)(term))
        | Metis_prover.Proof.Assume(atom): SPEC(Metis_mapping.hol_of_atom(env)(atom))(EXCLUDED_MIDDLE)
        | Metis_prover.Proof.Equality(flit,fpath,ft):
            let hlit = Metis_mapping.hol_of_literal(env)(flit)
            let [fs, hpath] = Metis_path.hol_of_literal_path(flit)(fpath)
            let hs = follow_path(hpath)(hlit)
            let ht = Metis_mapping.hol_of_term(env)(ft)
            let m = type_unify(type_of(ht))(type_of(hs))(PairList [])
            let [hlit, hs, ht] = [inst(m)(hlit), inst(m)(hs), inst(m)(ht)]
            if metisverb.value
            | hol_printf("Trying to replace %s : %s with %s : %s\n%!")(Host.string_of_term(hs))(Host.string_of_type(type_of(hs)))(Host.string_of_term(ht))(Host.string_of_type(type_of(ht)))
              hol_printf("In %s\n%!")(Host.string_of_term(hlit))
            | #void
            let heq = mk_eq([hs, ht])
            let conv = PATH_CONV(hpath)(PURE_ONCE_REWRITE_CONV(PairList [ASSUME(heq)]))
            let hlit_prime = CONV_RULE(conv)(ASSUME(hlit))
            (if metisverb.value | hol_printf("hlit = %s, hlit' = %s\n%!")(Host.string_of_term(hlit))(Host.string_of_thm(hlit_prime)) | #void)
            if (hs != ht)
            | (if (concl(hlit_prime) != hlit) | #void | failwith("Assertion failed"))
            | #void
            try:
              Metis_rules.DISCH_DISJS(PairList [heq, hlit])(hlit_prime)
              ~catch exn:
                match exn
                | Failure(_): failwith("equality")
                | exn: (throw exn)
      let hth = CONV_RULE(DISJ_CANON_CONV)(hth)
      if metisverb.value
      | hol_printf("hol_of_thm finished\n%!")
        let hth_prime = ((Metis_prover.Thm.clause(fth) |> Metis_prover.Literal.Set.toList) |> Metis_mapping.hol_of_clause(env))
        hol_printf("hol_of_thm returned:\n%s\n for\n%s\n%!")(Host.string_of_term(concl(hth)))(Host.string_of_term(hth_prime))
      | #void
      hth

namespace Metis_generate:
  export:
    metis_name
    metis_of_term
    metis_of_atom
    metis_of_literal
    metis_of_clause
    metis_of_clauses

  def metis_name = (fun (n): to_string(n))

  fun metis_of_term(env):
    fun(consts):
      fun(tm):
        if (is_var(tm) && !OCamlList.mem(tm)(consts))
        | Metis_prover.Term.Var(metis_name(Meson.Meson.fol_of_var(tm)))
        | let [f, args] = strip_comb(tm)
          if OCamlList.mem(f)(env)
          | failwith("metis_of_term: higher order")
          | let ff = Meson.Meson.fol_of_const(f)
            Metis_prover.Term.Fn([metis_name(ff), map(metis_of_term(env)(consts))(args)])

  fun metis_of_atom(env):
    fun(consts):
      fun(tm):
        try:
          let [l, r] = dest_eq(tm)
          let l_prime_2 = metis_of_term(env)(consts)(l)
          let r_prime_2 = metis_of_term(env)(consts)(r)
          Metis_prover.Atom.mkEq([l_prime_2, r_prime_2])
          ~catch exn:
            match exn
            | Failure(_):
                let [f, args] = strip_comb(tm)
                if OCamlList.mem(f)(env)
                | failwith("metis_of_atom: higher order")
                | let ff = Meson.Meson.fol_of_const(f)
                  [metis_name(ff), map(metis_of_term(env)(consts))(args)]
            | exn: (throw exn)

  fun metis_of_literal(env):
    fun(consts):
      fun(tm):
        let [pol, tm_prime]:
          try:
            [#false, dest_neg(tm)]
            ~catch exn:
              match exn
              | Failure(_): [#true, tm]
              | exn: (throw exn)
        [pol, metis_of_atom(env)(consts)(tm_prime)]

  fun metis_of_clause(th):
    let lconsts = freesl(hyp(th))
    let tm = concl(th)
    let hlits = disjuncts(tm)
    let flits = map(metis_of_literal(PairList [])(lconsts))(hlits)
    let set = Metis_prover.Literal.Set.fromList(flits)
    Metis_prover.Thm.axiom(set)

  def metis_of_clauses = map(metis_of_clause)

namespace Metis:
  export:
    split_limit
    PRINT_TAC
    PRINT_ID_TAC
    FOL_PREPARE_TAC
    without_warnings
    SIMPLE_METIS_REFUTE
    PURE_METIS_TAC
    GEN_METIS_TAC

  def split_limit = Box(0)

  fun PRINT_TAC(g):
    Host.print_goal(g)
    ALL_TAC(g)

  fun PRINT_ID_TAC(s):
    fun(g):
      println(s)
      PRINT_TAC(g)

  fun FOL_PREPARE_TAC(ths):
    (
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  REFUTE_THEN(ASSUME_TAC) then_tac \
                                  Meson.Meson.POLY_ASSUME_TAC(map(GEN_ALL)(ths))
                                ) then_tac \
                                W(o(MAP_EVERY(o(o(UNDISCH_TAC)(concl))(snd)))(fst))
                              ) then_tac \
                              SELECT_ELIM_TAC
                            ) then_tac \
                            W((fun([asl, w]): MAP_EVERY((fun(v): SPEC_TAC([v, v])))(frees(w))))
                          ) then_tac \
                          CONV_TAC(
                            (
                              (
                                (
                                  (PRESIMP_CONV then_conv TOP_DEPTH_CONV(BETA_CONV)) then_conv \
                                  LAMBDA_ELIM_CONV
                                ) then_conv \
                                CONDS_CELIM_CONV
                              ) then_conv \
                              Meson.Meson.QUANT_BOOL_CONV
                            )
                          )
                        ) then_tac \
                        REPEAT((GEN_TAC or_tac DISCH_TAC))
                      ) then_tac \
                      REFUTE_THEN(ASSUME_TAC)
                    ) then_tac \
                    RULE_ASSUM_TAC(CONV_RULE((NNF_CONV then_conv SKOLEM_CONV)))
                  ) then_tac \
                  REPEAT(FIRST_X_ASSUM(CHOOSE_TAC))
                ) then_tac \
                ASM_FOL_TAC
              ) then_tac \
              Meson.Meson.SPLIT_TAC(split_limit.value)
            ) then_tac \
            RULE_ASSUM_TAC(CONV_RULE((PRENEX_CONV then_conv WEAK_CNF_CONV)))
          ) then_tac \
          RULE_ASSUM_TAC(
            repeat(
              (fun(th): SPEC(genvar(type_of(fst(dest_forall(concl(th))))))(th))
            )
          )
        ) then_tac \
        REPEAT(FIRST_X_ASSUM(Meson.Meson.CONJUNCTS_THEN_prime(ASSUME_TAC)))
      ) then_tac \
      RULE_ASSUM_TAC(CONV_RULE(ASSOC_CONV(DISJ_ASSOC)))
    )

  fun without_warnings(f):
    let tiv = TypeInference.type_invention_warning.value
    let reset = (fun(_): (TypeInference.type_invention_warning.value := tiv))
    TypeInference.type_invention_warning.value := #false
    try:
      let y = f(#void)
      reset(#void)
      y
      ~catch exn:
        match exn
        | e:
            reset(#void)
            (throw e)
        | exn: (throw exn)

  fun SIMPLE_METIS_REFUTE(ths):
    Meson.Meson.clear_contrapos_cache(#void)
    ocaml_random_init(0)
    let rules = Metis_generate.metis_of_clauses(ths)
    if metisverb.value
    | hol_printf("Original ths:\n%!")
      OCamlList.iter(o(hol_printf("%s\n%!"))(Host.string_of_thm))(ths)
    | #void
    let res = Metis_prover.Loop.run(rules)
    (if metisverb.value | Metis_prover.Thm.print_proof(res) | #void)
    let ths = map(CONV_RULE(DISJ_CANON_CONV))(ths)
    let proof = without_warnings((fun(_): Metis_reconstruct2.hol_of_thm(ths)(res)))
    if metisverb.value
    | hol_printf("ths:\n%!")
      OCamlList.iter(
        fun(t):
          Host.print_thm(t)
          hol_printf("\n%!")
      )(ths)
      hol_printf("Metis theorem:\n%!")
      Host.print_thm(proof)
      hol_printf("Metis end.\n%!")
    | #void
    let allhyps = OCamlList.concat(PairList.map(ths, hyp))
    (if forall((fun(h): OCamlList.mem(h)(allhyps)))(hyp(proof)) | #void | failwith("Assertion failed"))
    (if (concl(proof) == @hol|{F}|) | #void | failwith("Assertion failed"))
    proof

  fun PURE_METIS_TAC(g):
    Meson.Meson.reset_vars(#void)
    Meson.Meson.reset_consts(#void)
    (
      FIRST_ASSUM(CONTR_TAC) or_tac \
      W(o(o(o(ACCEPT_TAC)(SIMPLE_METIS_REFUTE))(map(snd)))(fst))
    )(g)

  fun GEN_METIS_TAC(ths): (FOL_PREPARE_TAC(ths) then_tac PURE_METIS_TAC)

def ASM_METIS_TAC = Metis.GEN_METIS_TAC

fun METIS_TAC(ths): (POP_ASSUM_LIST(K(ALL_TAC)) then_tac ASM_METIS_TAC(ths))

fun METIS(ths): fun(tm): prove([tm, METIS_TAC(ths)])
