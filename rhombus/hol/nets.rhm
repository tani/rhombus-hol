#lang rhombus
// (c) University of Cambridge 1998; John Harrison 1998-2007. See ../LICENSE.
import: "private/compat.rhm" open
import: "fusion.rhm" open
import: "basics.rhm" open
export:
  empty_net
  enter
  lookup
  merge_nets
class Vnet()
class Cnet(k)
class Lcnet(k)
class Lnet(k)
class Netnode(vnet,cnets,lcnets,lnets,tips)
def empty_net = Netnode(#false,Map.empty,Map.empty,Map.empty,PairList [])
fun canon_eq(x,y):
  try:
    compare(x)(y) == 0
    ~catch InvalidArgument(_): #false
fun canon_lt(x,y):
  try:
    compare(x)(y) < 0
    ~catch InvalidArgument(_): #false
fun sinsert(x,l):
  if l == PairList []
  | PairList [x]
  | let h = hd(l)
    cond
    | canon_eq(h,x): failwith("sinsert")
    | canon_lt(x,h): PairList.cons(x,l)
    | ~else: PairList.cons(h,sinsert(x,tl(l)))
fun set_insert(x,l):
  try:
    sinsert(x,l)
    ~catch Failure("sinsert"): l
fun label_to_store(lconsts,tm):
  let [op, args] = strip_comb(tm)
  cond
  | is_const(op): [Cnet([fst(dest_const(op)), length(args)]), args]
  | is_abs(op):
      let [bv, bod] = dest_abs(op)
      let bod1 = if mem(bv)(lconsts) | vsubst(PairList [[genvar(type_of(bv)), bv]])(bod) | bod
      [Lnet(length(args)), PairList.cons(bod1,args)]
  | mem(op)(lconsts): [Lcnet([fst(dest_var(op)), length(args)]), args]
  | ~else: [Vnet(), PairList []]
fun update(k,upd,m):
  let child = if k in m | m[k] | empty_net
  m.set(k,upd(child))
fun net_update(lconsts,elem,tms,net):
  let Netnode(v,c,lc,l,tips) = net
  match tms
  | PairList []: Netnode(v,c,lc,l,set_insert(elem,tips))
  | PairList [tm, & rtms]:
      let [label, ntms] = label_to_store(lconsts,tm)
      fun upd(child): net_update(lconsts,elem,append(ntms)(rtms),child)
      match label
      | Vnet(): Netnode(upd(if v | v | empty_net),c,lc,l,tips)
      | Cnet(k): Netnode(v,update(k,upd,c),lc,l,tips)
      | Lcnet(k): Netnode(v,c,update(k,upd,lc),l,tips)
      | Lnet(k): Netnode(v,c,lc,update(k,upd,l),tips)
fun enter(lconsts): fun([tm, elem]): fun(net): net_update(lconsts,elem,PairList [tm],net)
fun label_for_lookup(tm):
  let [op, args] = strip_comb(tm)
  cond
  | is_const(op): [Cnet([fst(dest_const(op)), length(args)]), args]
  | is_abs(op): [Lnet(length(args)), PairList.cons(body(op),args)]
  | ~else: [Lcnet([fst(dest_var(op)), length(args)]), args]
fun follow(tms,net):
  let Netnode(v,c,lc,l,tips) = net
  match tms
  | PairList []: tips
  | PairList [tm, & rtms]:
      let [label, ntms] = label_for_lookup(tm)
      fun collect(k,m):
        if k in m
        | follow(append(ntms)(rtms),m[k])
        | PairList []
      let collection:
        match label
        | Cnet(k): collect(k,c)
        | Lcnet(k): collect(k,lc)
        | Lnet(k): collect(k,l)
        | Vnet(): PairList []
      if v | append(collection)(follow(rtms,v)) | collection
fun lookup(tm): fun(net): follow(PairList [tm],net)
fun set_merge(l1,l2):
  cond
  | l1 == PairList []: l2
  | l2 == PairList []: l1
  | ~else:
      let h1 = hd(l1)
      let h2 = hd(l2)
      cond
      | canon_eq(h1,h2): PairList.cons(h1,set_merge(tl(l1),tl(l2)))
      | canon_lt(h1,h2): PairList.cons(h1,set_merge(tl(l1),l2))
      | ~else: PairList.cons(h2,set_merge(l1,tl(l2)))
fun merge_nets([n1, n2]):
  let Netnode(v1,c1,lc1,l1,t1) = n1
  let Netnode(v2,c2,lc2,l2,t2) = n2
  let v = cond | v1 && v2: merge_nets([v1, v2]) | v1: v1 | ~else: v2
  fun merge_map(a,b):
    let mutable out = a
    for ((k,y) in b):
      out := out.set(k,if k in out | merge_nets([out[k], y]) | y)
    out
  Netnode(v,merge_map(c1,c2),merge_map(lc1,lc2),merge_map(l1,l2),set_merge(t1,t2))