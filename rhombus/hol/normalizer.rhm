export:
  SEMIRING_NORMALIZERS_CONV
  NUM_NORMALIZE_CONV

def SEMIRING_NORMALIZERS_CONV:
  let SEMIRING_PTHS:
    prove(
      [
        @hol|{(!x:A y z. add x (add y z) = add (add x y) z) /\
           (!x y. add x y = add y x) /\
           (!x. add r0 x = x) /\
           (!x y z. mul x (mul y z) = mul (mul x y) z) /\
           (!x y. mul x y = mul y x) /\
           (!x. mul r1 x = x) /\
           (!x. mul r0 x = r0) /\
           (!x y z. mul x (add y z) = add (mul x y) (mul x z)) /\
           (!x. pwr x 0 = r1) /\
           (!x n. pwr x (SUC n) = mul x (pwr x n))
           ==> (mul r1 x = x) /\
               (add (mul a m) (mul b m) = mul (add a b) m) /\
               (add (mul a m) m = mul (add a r1) m) /\
               (add m (mul a m) = mul (add a r1) m) /\
               (add m m = mul (add r1 r1) m) /\
               (mul r0 m = r0) /\
               (add r0 a = a) /\
               (add a r0 = a) /\
               (mul a b = mul b a) /\
               (mul (add a b) c = add (mul a c) (mul b c)) /\
               (mul r0 a = r0) /\
               (mul a r0 = r0) /\
               (mul r1 a = a) /\
               (mul a r1 = a) /\
               (mul (mul lx ly) (mul rx ry) = mul (mul lx rx) (mul ly ry)) /\
               (mul (mul lx ly) (mul rx ry) = mul lx (mul ly (mul rx ry))) /\
               (mul (mul lx ly) (mul rx ry) = mul rx (mul (mul lx ly) ry)) /\
               (mul (mul lx ly) rx = mul (mul lx rx) ly) /\
               (mul (mul lx ly) rx = mul lx (mul ly rx)) /\
               (mul lx rx = mul rx lx) /\
               (mul lx (mul rx ry) = mul (mul lx rx) ry) /\
               (mul lx (mul rx ry) = mul rx (mul lx ry)) /\
               (add (add a b) (add c d) = add (add a c) (add b d)) /\
               (add (add a b) c = add a (add b c)) /\
               (add a (add c d) = add c (add a d)) /\
               (add (add a b) c = add (add a c) b) /\
               (add a c = add c a) /\
               (add a (add c d) = add (add a c) d) /\
               (mul (pwr x p) (pwr x q) = pwr x (p + q)) /\
               (mul x (pwr x q) = pwr x (SUC q)) /\
               (mul (pwr x q) x = pwr x (SUC q)) /\
               (mul x x = pwr x 2) /\
               (pwr (mul x y) q = mul (pwr x q) (pwr y q)) /\
               (pwr (pwr x p) q = pwr x (p * q)) /\
               (pwr x 0 = r1) /\
               (pwr x 1 = x) /\
               (mul x (add y z) = add (mul x y) (mul x z)) /\
               (pwr x (SUC q) = mul x (pwr x q))}|,
        STRIP_TAC then_tac \
        SUBGOAL_THEN(
          @hol|{(!m:A n. add m n = add n m) /\
             (!m n p. add (add m n) p = add m (add n p)) /\
             (!m n p. add m (add n p) = add n (add m p)) /\
             (!x. add x r0 = x) /\
             (!m n. mul m n = mul n m) /\
             (!m n p. mul (mul m n) p = mul m (mul n p)) /\
             (!m n p. mul m (mul n p) = mul n (mul m p)) /\
             (!m n p. mul (add m n) p = add (mul m p) (mul n p)) /\
             (!x. mul x r1 = x) /\
             (!x. mul x r0 = r0)}|
        )(MP_TAC) then_list \
        PairList [
          ASM_MESON_TAC(PairList []),
          MAP_EVERY((fun(t): UNDISCH_THEN(t)(K(ALL_TAC))))(
            PairList [
              @hol|{!x:A y z. add x (add y z) = add (add x y) z}|,
              @hol|{!x:A y. add x y :A = add y x}|,
              @hol|{!x:A y z. mul x (mul y z) = mul (mul x y) z}|,
              @hol|{!x:A y. mul x y :A = mul y x}|
            ]
          ) then_tac \
          STRIP_TAC
        ] then_tac \
        ASM_REWRITE_TAC(
          PairList [
            num_CONV(
              @hol|{2}|
            ),
            num_CONV(
              @hol|{1}|
            )
          ]
        ) then_tac \
        SUBGOAL_THEN(
          @hol|{!m n:num x:A. pwr x (m + n) :A = mul (pwr x m) (pwr x n)}|
        )(ASSUME_TAC) then_list \
        PairList [
          GEN_TAC then_tac INDUCT_TAC then_tac \
          ASM_REWRITE_TAC(PairList [ADD_CLAUSES]),
          ALL_TAC
        ] then_tac \
        SUBGOAL_THEN(
          @hol|{!x:A y:A n:num. pwr (mul x y) n = mul (pwr x n) (pwr y n)}|
        )(ASSUME_TAC) then_list \
        PairList [
          GEN_TAC then_tac GEN_TAC then_tac INDUCT_TAC then_tac \
          ASM_REWRITE_TAC(PairList []),
          ALL_TAC
        ] then_tac \
        SUBGOAL_THEN(
          @hol|{!x:A m:num n. pwr (pwr x m) n = pwr x (m * n)}|
        )((fun(th): ASM_MESON_TAC(PairList [th]))) then_tac \
        GEN_TAC then_tac \
        GEN_TAC then_tac \
        INDUCT_TAC then_tac \
        ASM_REWRITE_TAC(PairList [MULT_CLAUSES])
      ]
    )
  let true_tm = concl(TRUTH)
  fun(sth):
    fun(rth):
      fun([is_semiring_constant, SEMIRING_ADD_CONV, SEMIRING_MUL_CONV, SEMIRING_POW_CONV]):
        fun(variable_order):
          let PairList [pthm_01, & PairList [pthm_02, & PairList [pthm_03, & PairList [pthm_04, & PairList [pthm_05, & PairList [pthm_06, & PairList [pthm_07, & PairList [pthm_08, & PairList [pthm_09, & PairList [pthm_10, & PairList [pthm_11, & PairList [pthm_12, & PairList [pthm_13, & PairList [pthm_14, & PairList [pthm_15, & PairList [pthm_16, & PairList [pthm_17, & PairList [pthm_18, & PairList [pthm_19, & PairList [pthm_20, & PairList [pthm_21, & PairList [pthm_22, & PairList [pthm_23, & PairList [pthm_24, & PairList [pthm_25, & PairList [pthm_26, & PairList [pthm_27, & PairList [pthm_28, & PairList [pthm_29, & PairList [pthm_30, & PairList [pthm_31, & PairList [pthm_32, & PairList [pthm_33, & PairList [pthm_34, & PairList [pthm_35, & PairList [pthm_36, & PairList [pthm_37, & PairList [pthm_38, & PairList []]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]] = CONJUNCTS(MATCH_MP(SEMIRING_PTHS)(sth))
          let add_tm = rator(rator(lhand(concl(pthm_07))))
          let mul_tm = rator(rator(lhand(concl(pthm_13))))
          let pow_tm = rator(rator(rand(concl(pthm_32))))
          let zero_tm = rand(concl(pthm_06))
          let one_tm = rand(lhand(concl(pthm_14)))
          let ty = type_of(rand(concl(pthm_01)))
          let p_tm = @hol|{p:num}|
          let q_tm = @hol|{q:num}|
          let zeron_tm = @hol|{0}|
          let onen_tm = @hol|{1}|
          let a_tm = mk_var(["a", ty])
          let b_tm = mk_var(["b", ty])
          let c_tm = mk_var(["c", ty])
          let d_tm = mk_var(["d", ty])
          let lx_tm = mk_var(["lx", ty])
          let ly_tm = mk_var(["ly", ty])
          let m_tm = mk_var(["m", ty])
          let rx_tm = mk_var(["rx", ty])
          let ry_tm = mk_var(["ry", ty])
          let x_tm = mk_var(["x", ty])
          let y_tm = mk_var(["y", ty])
          let z_tm = mk_var(["z", ty])
          let dest_add = dest_binop(add_tm)
          let dest_mul = dest_binop(mul_tm)
          let dest_pow:
            fun(tm):
              let [l, r] = dest_binop(pow_tm)(tm)
              (if is_numeral(r) | [l, r] | failwith("dest_pow"))
          let is_add = is_binop(add_tm)
          let is_mul = is_binop(mul_tm)
          let [nthm_1, nthm_2, sub_tm, neg_tm, dest_sub, is_sub]:
            if (concl(rth) == true_tm)
            | [rth, rth, true_tm, true_tm, (fun(t): [t, t]), K(#false)]
            | let nthm_1_2 = SPEC(x_tm)(CONJUNCT1(rth))
              let nthm_2_2 = SPECL(PairList [x_tm, y_tm])(CONJUNCT2(rth))
              let sub_tm_2 = rator(rator(lhand(concl(nthm_2_2))))
              let neg_tm_2 = rator(lhand(concl(nthm_1_2)))
              let dest_sub_2 = dest_binop(sub_tm_2)
              let is_sub_2 = is_binop(sub_tm_2)
              [nthm_1_2, nthm_2_2, sub_tm_2, neg_tm_2, dest_sub_2, is_sub_2]
          let normalizers:
            let POWVAR_MUL_CONV:
              fun(tm):
                let [l, r] = dest_mul(tm)
                if (is_semiring_constant(l) && is_semiring_constant(r))
                | SEMIRING_MUL_CONV(tm)
                | try:
                    let [lx, ln] = dest_pow(l)
                    try:
                      let [rx, rn] = dest_pow(r)
                      let th1 = INST(PairList [[lx, x_tm], [ln, p_tm], [rn, q_tm]])(pthm_29)
                      let [tm1, tm2] = dest_comb(rand(concl(th1)))
                      TRANS(th1)(AP_TERM(tm1)(NUM_ADD_CONV(tm2)))
                      ~catch exn:
                        match exn
                        | Failure(_):
                            let th1 = INST(PairList [[lx, x_tm], [ln, q_tm]])(pthm_31)
                            let [tm1, tm2] = dest_comb(rand(concl(th1)))
                            TRANS(th1)(AP_TERM(tm1)(NUM_SUC_CONV(tm2)))
                        | exn: (throw exn)
                    ~catch exn:
                      match exn
                      | Failure(_):
                          try:
                            let [rx, rn] = dest_pow(r)
                            let th1 = INST(PairList [[rx, x_tm], [rn, q_tm]])(pthm_30)
                            let [tm1, tm2] = dest_comb(rand(concl(th1)))
                            TRANS(th1)(AP_TERM(tm1)(NUM_SUC_CONV(tm2)))
                            ~catch exn:
                              match exn
                              | Failure(_): INST(PairList [[l, x_tm]])(pthm_32)
                              | exn: (throw exn)
                      | exn: (throw exn)
            let MONOMIAL_DEONE:
              fun(th):
                try:
                  let [l, r] = dest_mul(rand(concl(th)))
                  (if (l == one_tm) | TRANS(th)(INST(PairList [[r, x_tm]])(pthm_01)) | th)
                  ~catch exn:
                    match exn
                    | Failure(_): th
                    | exn: (throw exn)
            // Recursive monomial expansion needs the local definition before its first use.
            fun MONOMIAL_POW(tm):
              fun(bod):
                fun(ntm):
                  if !is_comb(bod)
                  | REFL(tm)
                  | if is_semiring_constant(bod)
                    | SEMIRING_POW_CONV(tm)
                    | let [lop, r] = dest_comb(bod)
                      if !is_comb(lop)
                      | REFL(tm)
                      | let [op, l] = dest_comb(lop)
                        if ((op == pow_tm) && is_numeral(r))
                        | let th1 = INST(PairList [[l, x_tm], [r, p_tm], [ntm, q_tm]])(pthm_34)
                          let [l, r] = dest_comb(rand(concl(th1)))
                          TRANS(th1)(AP_TERM(l)(NUM_MULT_CONV(r)))
                        | if (op == mul_tm)
                          | let th1 = INST(PairList [[l, x_tm], [r, y_tm], [ntm, q_tm]])(pthm_33)
                            let [xy, z] = dest_comb(rand(concl(th1)))
                            let [x, y] = dest_comb(xy)
                            let thl = MONOMIAL_POW(y)(l)(ntm)
                            let thr = MONOMIAL_POW(z)(r)(ntm)
                            TRANS(th1)(MK_COMB([AP_TERM(x)(thl), thr]))
                          | REFL(tm)
            let MONOMIAL_POW_CONV:
              fun(tm):
                let [lop, r] = dest_comb(tm)
                let [op, l] = dest_comb(lop)
                if ((op != pow_tm) || !is_numeral(r))
                | failwith("MONOMIAL_POW_CONV")
                | if (r == zeron_tm)
                  | INST(PairList [[l, x_tm]])(pthm_35)
                  | (if (r == onen_tm) | INST(PairList [[l, x_tm]])(pthm_36) | MONOMIAL_DEONE(MONOMIAL_POW(tm)(l)(r)))
            let powvar:
              fun(tm):
                if is_semiring_constant(tm)
                | one_tm
                | try:
                    let [lop, r] = dest_comb(tm)
                    let [op, l] = dest_comb(lop)
                    (if ((op == pow_tm) && is_numeral(r)) | l | failwith(""))
                    ~catch exn:
                      match exn
                      | Failure(_): tm
                      | exn: (throw exn)
            let vorder:
              fun(x):
                fun(y):
                  if (x == y)
                  | 0
                  | if (x == one_tm)
                    | -1
                    | if (y == one_tm)
                      | 1
                      | (if variable_order(x)(y) | -1 | 1)
            // Recursive monomial multiplication needs the local definition before its first use.
            fun MONOMIAL_MUL(tm):
              fun(l):
                fun(r):
                  try:
                    let [lx, ly] = dest_mul(l)
                    let vl = powvar(lx)
                    try:
                      let [rx, ry] = dest_mul(r)
                      let vr = powvar(rx)
                      let ord = vorder(vl)(vr)
                      if (ord == 0)
                      | let th1 = INST(PairList [[lx, lx_tm], [ly, ly_tm], [rx, rx_tm], [ry, ry_tm]])(pthm_15)
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        let [tm3, tm4] = dest_comb(tm1)
                        let th2 = AP_THM(AP_TERM(tm3)(POWVAR_MUL_CONV(tm4)))(tm2)
                        let th3 = TRANS(th1)(th2)
                        let [tm5, tm6] = dest_comb(rand(concl(th3)))
                        let [tm7, tm8] = dest_comb(tm6)
                        let th4 = MONOMIAL_MUL(tm6)(rand(tm7))(tm8)
                        TRANS(th3)(AP_TERM(tm5)(th4))
                      | let th0 = (if (ord < 0) | pthm_16 | pthm_17)
                        let th1 = INST(PairList [[lx, lx_tm], [ly, ly_tm], [rx, rx_tm], [ry, ry_tm]])(th0)
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        let [tm3, tm4] = dest_comb(tm2)
                        TRANS(th1)(AP_TERM(tm1)(MONOMIAL_MUL(tm2)(rand(tm3))(tm4)))
                      ~catch exn:
                        match exn
                        | Failure(_):
                            let vr = powvar(r)
                            let ord = vorder(vl)(vr)
                            if (ord == 0)
                            | let th1 = INST(PairList [[lx, lx_tm], [ly, ly_tm], [r, rx_tm]])(pthm_18)
                              let [tm1, tm2] = dest_comb(rand(concl(th1)))
                              let [tm3, tm4] = dest_comb(tm1)
                              let th2 = AP_THM(AP_TERM(tm3)(POWVAR_MUL_CONV(tm4)))(tm2)
                              TRANS(th1)(th2)
                            | if (ord < 0)
                              | let th1 = INST(PairList [[lx, lx_tm], [ly, ly_tm], [r, rx_tm]])(pthm_19)
                                let [tm1, tm2] = dest_comb(rand(concl(th1)))
                                let [tm3, tm4] = dest_comb(tm2)
                                TRANS(th1)(AP_TERM(tm1)(MONOMIAL_MUL(tm2)(rand(tm3))(tm4)))
                              | INST(PairList [[l, lx_tm], [r, rx_tm]])(pthm_20)
                        | exn: (throw exn)
                    ~catch exn:
                      match exn
                      | Failure(_):
                          let vl = powvar(l)
                          try:
                            let [rx, ry] = dest_mul(r)
                            let vr = powvar(rx)
                            let ord = vorder(vl)(vr)
                            if (ord == 0)
                            | let th1 = INST(PairList [[l, lx_tm], [rx, rx_tm], [ry, ry_tm]])(pthm_21)
                              let [tm1, tm2] = dest_comb(rand(concl(th1)))
                              let [tm3, tm4] = dest_comb(tm1)
                              TRANS(th1)(AP_THM(AP_TERM(tm3)(POWVAR_MUL_CONV(tm4)))(tm2))
                            | if (ord > 0)
                              | let th1 = INST(PairList [[l, lx_tm], [rx, rx_tm], [ry, ry_tm]])(pthm_22)
                                let [tm1, tm2] = dest_comb(rand(concl(th1)))
                                let [tm3, tm4] = dest_comb(tm2)
                                TRANS(th1)(AP_TERM(tm1)(MONOMIAL_MUL(tm2)(rand(tm3))(tm4)))
                              | REFL(tm)
                            ~catch exn:
                              match exn
                              | Failure(_):
                                  let vr = powvar(r)
                                  let ord = vorder(vl)(vr)
                                  if (ord == 0)
                                  | POWVAR_MUL_CONV(tm)
                                  | (if (ord > 0) | INST(PairList [[l, lx_tm], [r, rx_tm]])(pthm_20) | REFL(tm))
                              | exn: (throw exn)
                      | exn: (throw exn)
            let MONOMIAL_MUL_CONV:
              fun(tm):
                let [l, r] = dest_mul(tm)
                MONOMIAL_DEONE(MONOMIAL_MUL(tm)(l)(r))
            fun PMM_CONV(tm):
              let [l, r] = dest_mul(tm)
              try:
                let [y, z] = dest_add(r)
                let th1 = INST(PairList [[l, x_tm], [y, y_tm], [z, z_tm]])(pthm_37)
                let [tm1, tm2] = dest_comb(rand(concl(th1)))
                let [tm3, tm4] = dest_comb(tm1)
                let th2 = MK_COMB([AP_TERM(tm3)(MONOMIAL_MUL_CONV(tm4)), PMM_CONV(tm2)])
                TRANS(th1)(th2)
                ~catch exn:
                  match exn
                  | Failure(_): MONOMIAL_MUL_CONV(tm)
                  | exn: (throw exn)
            let POLYNOMIAL_MONOMIAL_MUL_CONV = PMM_CONV
            let MONOMIAL_ADD_CONV:
              fun(tm):
                let [l, r] = dest_add(tm)
                if (is_semiring_constant(l) && is_semiring_constant(r))
                | SEMIRING_ADD_CONV(tm)
                | let th1:
                    if (is_mul(l) && is_semiring_constant(lhand(l)))
                    | (if (is_mul(r) && is_semiring_constant(lhand(r))) | INST(PairList [[lhand(l), a_tm], [lhand(r), b_tm], [rand(r), m_tm]])(pthm_02) | INST(PairList [[lhand(l), a_tm], [r, m_tm]])(pthm_03))
                    | (if (is_mul(r) && is_semiring_constant(lhand(r))) | INST(PairList [[lhand(r), a_tm], [l, m_tm]])(pthm_04) | INST(PairList [[r, m_tm]])(pthm_05))
                  let [tm1, tm2] = dest_comb(rand(concl(th1)))
                  let [tm3, tm4] = dest_comb(tm1)
                  let th2 = AP_TERM(tm3)(SEMIRING_ADD_CONV(tm4))
                  let th3 = TRANS(th1)(AP_THM(th2)(tm2))
                  let tm5 = rand(concl(th3))
                  (if (lhand(tm5) == zero_tm) | TRANS(th3)(INST(PairList [[rand(tm5), m_tm]])(pthm_06)) | MONOMIAL_DEONE(th3))
            let powervars:
              fun(tm):
                let ptms = striplist(dest_mul)(tm)
                (if is_semiring_constant(hd(ptms)) | tl(ptms) | ptms)
            let dest_varpow:
              fun(tm):
                try:
                  let [x, n] = dest_pow(tm)
                  [x, dest_numeral(n)]
                  ~catch exn:
                    match exn
                    | Failure(_): [tm, (if is_semiring_constant(tm) | num_0 | num_1)]
                    | exn: (throw exn)
            // Recursive ordering needs the local definition before its first use.
            fun lexorder(l1):
              fun(l2):
                match [l1, l2]
                | [PairList [], PairList []]: 0
                | [vps, PairList []]: -1
                | [PairList [], vps]: 1
                | [PairList [[x1, n1], & vs1], PairList [[x2, n2], & vs2]]:
                    if variable_order(x1)(x2)
                    | 1
                    | if variable_order(x2)(x1)
                      | -1
                      | if (n1 < n2)
                        | -1
                        | (if (n2 < n1) | 1 | lexorder(vs1)(vs2))
            let morder:
              fun(tm1):
                fun(tm2):
                  let vdegs1 = map(dest_varpow)(powervars(tm1))
                  let vdegs2 = map(dest_varpow)(powervars(tm2))
                  let deg1 = itlist(o((fun (x): fun (y): x + y))(snd))(vdegs1)(num_0)
                  let deg2 = itlist(o((fun (x): fun (y): x + y))(snd))(vdegs2)(num_0)
                  if (deg1 < deg2)
                  | -1
                  | (if (deg1 > deg2) | 1 | lexorder(vdegs1)(vdegs2))
            let DEZERO_RULE:
              fun(th):
                let tm = rand(concl(th))
                if !is_add(tm)
                | th
                | let [lop, r] = dest_comb(tm)
                  let l = rand(lop)
                  if (l == zero_tm)
                  | TRANS(th)(INST(PairList [[r, a_tm]])(pthm_07))
                  | (if (r == zero_tm) | TRANS(th)(INST(PairList [[l, a_tm]])(pthm_08)) | th)
            fun PADD(tm):
              let [l, r] = dest_add(tm)
              if (l == zero_tm)
              | INST(PairList [[r, a_tm]])(pthm_07)
              | if (r == zero_tm)
                | INST(PairList [[l, a_tm]])(pthm_08)
                | if is_add(l)
                  | let [a, b] = dest_add(l)
                    if is_add(r)
                    | let [c, d] = dest_add(r)
                      let ord = morder(a)(c)
                      if (ord == 0)
                      | let th1 = INST(PairList [[a, a_tm], [b, b_tm], [c, c_tm], [d, d_tm]])(pthm_23)
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        let [tm3, tm4] = dest_comb(tm1)
                        let th2 = AP_TERM(tm3)(MONOMIAL_ADD_CONV(tm4))
                        DEZERO_RULE(TRANS(th1)(MK_COMB([th2, PADD(tm2)])))
                      | let th1 = (if (ord > 0) | INST(PairList [[a, a_tm], [b, b_tm], [r, c_tm]])(pthm_24) | INST(PairList [[l, a_tm], [c, c_tm], [d, d_tm]])(pthm_25))
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        DEZERO_RULE(TRANS(th1)(AP_TERM(tm1)(PADD(tm2))))
                    | let ord = morder(a)(r)
                      if (ord == 0)
                      | let th1 = INST(PairList [[a, a_tm], [b, b_tm], [r, c_tm]])(pthm_26)
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        let [tm3, tm4] = dest_comb(tm1)
                        let th2 = AP_THM(AP_TERM(tm3)(MONOMIAL_ADD_CONV(tm4)))(tm2)
                        DEZERO_RULE(TRANS(th1)(th2))
                      | if (ord > 0)
                        | let th1 = INST(PairList [[a, a_tm], [b, b_tm], [r, c_tm]])(pthm_24)
                          let [tm1, tm2] = dest_comb(rand(concl(th1)))
                          DEZERO_RULE(TRANS(th1)(AP_TERM(tm1)(PADD(tm2))))
                        | DEZERO_RULE(INST(PairList [[l, a_tm], [r, c_tm]])(pthm_27))
                  | if is_add(r)
                    | let [c, d] = dest_add(r)
                      let ord = morder(l)(c)
                      if (ord == 0)
                      | let th1 = INST(PairList [[l, a_tm], [c, c_tm], [d, d_tm]])(pthm_28)
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        let [tm3, tm4] = dest_comb(tm1)
                        let th2 = AP_THM(AP_TERM(tm3)(MONOMIAL_ADD_CONV(tm4)))(tm2)
                        DEZERO_RULE(TRANS(th1)(th2))
                      | if (ord > 0)
                        | REFL(tm)
                        | let th1 = INST(PairList [[l, a_tm], [c, c_tm], [d, d_tm]])(pthm_25)
                          let [tm1, tm2] = dest_comb(rand(concl(th1)))
                          DEZERO_RULE(TRANS(th1)(AP_TERM(tm1)(PADD(tm2))))
                    | let ord = morder(l)(r)
                      if (ord == 0)
                      | MONOMIAL_ADD_CONV(tm)
                      | (if (ord > 0) | DEZERO_RULE(REFL(tm)) | DEZERO_RULE(INST(PairList [[l, a_tm], [r, c_tm]])(pthm_27)))
            let POLYNOMIAL_ADD_CONV = PADD
            fun PMUL(tm):
              let [l, r] = dest_mul(tm)
              if !is_add(l)
              | POLYNOMIAL_MONOMIAL_MUL_CONV(tm)
              | if !is_add(r)
                | let th1 = INST(PairList [[l, a_tm], [r, b_tm]])(pthm_09)
                  TRANS(th1)(POLYNOMIAL_MONOMIAL_MUL_CONV(rand(concl(th1))))
                | let [a, b] = dest_add(l)
                  let th1 = INST(PairList [[a, a_tm], [b, b_tm], [r, c_tm]])(pthm_10)
                  let [tm1, tm2] = dest_comb(rand(concl(th1)))
                  let [tm3, tm4] = dest_comb(tm1)
                  let th2 = AP_TERM(tm3)(POLYNOMIAL_MONOMIAL_MUL_CONV(tm4))
                  let th3 = TRANS(th1)(MK_COMB([th2, PMUL(tm2)]))
                  TRANS(th3)(POLYNOMIAL_ADD_CONV(rand(concl(th3))))
            let POLYNOMIAL_MUL_CONV:
              fun(tm):
                let [l, r] = dest_mul(tm)
                if (l == zero_tm)
                | INST(PairList [[r, a_tm]])(pthm_11)
                | if (r == zero_tm)
                  | INST(PairList [[l, a_tm]])(pthm_12)
                  | if (l == one_tm)
                    | INST(PairList [[r, a_tm]])(pthm_13)
                    | (if (r == one_tm) | INST(PairList [[l, a_tm]])(pthm_14) | PMUL(tm))
            fun PPOW(tm):
              let [l, n] = dest_pow(tm)
              if (n == zeron_tm)
              | INST(PairList [[l, x_tm]])(pthm_35)
              | if (n == onen_tm)
                | INST(PairList [[l, x_tm]])(pthm_36)
                | let th1 = num_CONV(n)
                  let th2 = INST(PairList [[l, x_tm], [rand(rand(concl(th1))), q_tm]])(pthm_38)
                  let [tm1, tm2] = dest_comb(rand(concl(th2)))
                  let th3 = TRANS(th2)(AP_TERM(tm1)(PPOW(tm2)))
                  let th4 = TRANS(AP_TERM(rator(tm))(th1))(th3)
                  TRANS(th4)(POLYNOMIAL_MUL_CONV(rand(concl(th4))))
            let POLYNOMIAL_POW_CONV = (fun(tm): (if is_add(lhand(tm)) | PPOW(tm) | MONOMIAL_POW_CONV(tm)))
            let POLYNOMIAL_NEG_CONV:
              fun(tm):
                let [l, r] = dest_comb(tm)
                if (l != neg_tm)
                | failwith("POLYNOMIAL_NEG_CONV")
                | let th1 = INST(PairList [[r, x_tm]])(nthm_1)
                  TRANS(th1)(POLYNOMIAL_MONOMIAL_MUL_CONV(rand(concl(th1))))
            let POLYNOMIAL_SUB_CONV:
              fun(tm):
                let [l, r] = dest_sub(tm)
                let th1 = INST(PairList [[l, x_tm], [r, y_tm]])(nthm_2)
                let [tm1, tm2] = dest_comb(rand(concl(th1)))
                let th2 = AP_TERM(tm1)(POLYNOMIAL_MONOMIAL_MUL_CONV(tm2))
                TRANS(th1)(TRANS(th2)(POLYNOMIAL_ADD_CONV(rand(concl(th2)))))
            fun POLYNOMIAL_CONV(tm):
              if (!is_comb(tm) || is_semiring_constant(tm))
              | REFL(tm)
              | let [lop, r] = dest_comb(tm)
                if (lop == neg_tm)
                | let th1 = AP_TERM(lop)(POLYNOMIAL_CONV(r))
                  TRANS(th1)(POLYNOMIAL_NEG_CONV(rand(concl(th1))))
                | if !is_comb(lop)
                  | REFL(tm)
                  | let [op, l] = dest_comb(lop)
                    if ((op == pow_tm) && is_numeral(r))
                    | let th1 = AP_THM(AP_TERM(op)(POLYNOMIAL_CONV(l)))(r)
                      TRANS(th1)(POLYNOMIAL_POW_CONV(rand(concl(th1))))
                    | if ((op == add_tm) || ((op == mul_tm) || (op == sub_tm)))
                      | let th1 = MK_COMB([AP_TERM(op)(POLYNOMIAL_CONV(l)), POLYNOMIAL_CONV(r)])
                        let fn:
                          if (op == add_tm)
                          | POLYNOMIAL_ADD_CONV
                          | (if (op == mul_tm) | POLYNOMIAL_MUL_CONV | POLYNOMIAL_SUB_CONV)
                        TRANS(th1)(fn(rand(concl(th1))))
                      | REFL(tm)
            [
              POLYNOMIAL_NEG_CONV,
              POLYNOMIAL_ADD_CONV,
              POLYNOMIAL_SUB_CONV,
              POLYNOMIAL_MUL_CONV,
              POLYNOMIAL_POW_CONV,
              POLYNOMIAL_CONV
            ]
          normalizers

def NUM_NORMALIZE_CONV:
  let sth:
    prove(
      [
        @hol|{(!x y z. x + (y + z) = (x + y) + z) /\
           (!x y. x + y = y + x) /\
           (!x. 0 + x = x) /\
           (!x y z. x * (y * z) = (x * y) * z) /\
           (!x y. x * y = y * x) /\
           (!x. 1 * x = x) /\
           (!x. 0 * x = 0) /\
           (!x y z. x * (y + z) = x * y + x * z) /\
           (!x. x EXP 0 = 1) /\
           (!x n. x EXP (SUC n) = x * x EXP n)}|,
        REWRITE_TAC(PairList [EXP, MULT_CLAUSES, ADD_CLAUSES, LEFT_ADD_DISTRIB]) then_tac \
        REWRITE_TAC(PairList [ADD_AC, MULT_AC])
      ]
    )
  let rth = TRUTH
  let is_semiring_constant = is_numeral
  let SEMIRING_ADD_CONV = NUM_ADD_CONV
  let SEMIRING_MUL_CONV = NUM_MULT_CONV
  let SEMIRING_POW_CONV = NUM_EXP_CONV
  let [_, _, _, _, _, NUM_NORMALIZE_CONV] = SEMIRING_NORMALIZERS_CONV(sth)(rth)([is_semiring_constant, SEMIRING_ADD_CONV, SEMIRING_MUL_CONV, SEMIRING_POW_CONV])(fun (x): fun (y): x < y)
  NUM_NORMALIZE_CONV
