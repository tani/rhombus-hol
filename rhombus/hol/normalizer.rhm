                      if Host.hol_equal(ord)(0)
                      | MONOMIAL_ADD_CONV(tm)
                      | (if Host.hol_gt(ord)(0) | DEZERO_RULE(REFL(tm)) | DEZERO_RULE(INST(PairList [[l, a_tm_2], [r, c_tm_2]])(pthm_27)))
            let POLYNOMIAL_ADD_CONV = PADD
            fun PMUL(tm):
              let [l, r] = dest_mul_2(tm)
              if Host.hol_not(is_add_2(l))
              | POLYNOMIAL_MONOMIAL_MUL_CONV(tm)
              | if Host.hol_not(is_add_2(r))
                | let th1 = INST(PairList [[l, a_tm_2], [r, b_tm_2]])(pthm_09)
                  TRANS(th1)(POLYNOMIAL_MONOMIAL_MUL_CONV(rand(concl(th1))))
                | let [a_3, b] = dest_add_2(l)
                  let th1 = INST(PairList [[a_3, a_tm_2], [b, b_tm_2], [r, c_tm_2]])(pthm_10)
                  let [tm1, tm2] = dest_comb(rand(concl(th1)))
                  let [tm3, tm4] = dest_comb(tm1)
                  let th2 = AP_TERM(tm3)(POLYNOMIAL_MONOMIAL_MUL_CONV(tm4))
                  let th3 = TRANS(th1)(MK_COMB([th2, PMUL(tm2)]))
                  TRANS(th3)(POLYNOMIAL_ADD_CONV(rand(concl(th3))))
            let POLYNOMIAL_MUL_CONV:
              fun(tm):
                let [l, r] = dest_mul_2(tm)
                if Host.hol_equal(l)(zero_tm_2)
                | INST(PairList [[r, a_tm_2]])(pthm_11)
                | if Host.hol_equal(r)(zero_tm_2)
                  | INST(PairList [[l, a_tm_2]])(pthm_12)
                  | if Host.hol_equal(l)(one_tm_2)
                    | INST(PairList [[r, a_tm_2]])(pthm_13)
                    | (if Host.hol_equal(r)(one_tm_2) | INST(PairList [[l, a_tm_2]])(pthm_14) | PMUL(tm))
            fun PPOW(tm):
              let [l, n] = dest_pow_2(tm)
              if Host.hol_equal(n)(zeron_tm_2)
              | INST(PairList [[l, x_tm_2]])(pthm_35)
              | if Host.hol_equal(n)(onen_tm_2)
                | INST(PairList [[l, x_tm_2]])(pthm_36)
                | let th1 = num_CONV(n)
                  let th2 = INST(PairList [[l, x_tm_2], [rand(rand(concl(th1))), q_tm_2]])(pthm_38)
                  let [tm1, tm2] = dest_comb(rand(concl(th2)))
                  let th3 = TRANS(th2)(AP_TERM(tm1)(PPOW(tm2)))
                  let th4 = TRANS(AP_TERM(rator(tm))(th1))(th3)
                  TRANS(th4)(POLYNOMIAL_MUL_CONV(rand(concl(th4))))
            let POLYNOMIAL_POW_CONV = (fun(tm): (if is_add_2(lhand(tm)) | PPOW(tm) | MONOMIAL_POW_CONV(tm)))
            let POLYNOMIAL_NEG_CONV:
              fun(tm):
                let [l, r] = dest_comb(tm)
                if Host.hol_unequal(l)(neg_tm)
                | failwith("POLYNOMIAL_NEG_CONV")
                | let th1 = INST(PairList [[r, x_tm_2]])(nthm_1)
                  TRANS(th1)(POLYNOMIAL_MONOMIAL_MUL_CONV(rand(concl(th1))))
            let POLYNOMIAL_SUB_CONV:
              fun(tm):
                let [l, r] = dest_sub(tm)
                let th1 = INST(PairList [[l, x_tm_2], [r, y_tm_2]])(nthm_2)
                let [tm1, tm2] = dest_comb(rand(concl(th1)))
                let th2 = AP_TERM(tm1)(POLYNOMIAL_MONOMIAL_MUL_CONV(tm2))
                TRANS(th1)(TRANS(th2)(POLYNOMIAL_ADD_CONV(rand(concl(th2)))))
            fun POLYNOMIAL_CONV(tm):
              if (Host.hol_not(is_comb(tm)) || is_semiring_constant(tm))
              | REFL(tm)
              | let [lop, r] = dest_comb(tm)
                if Host.hol_equal(lop)(neg_tm)
                | let th1 = AP_TERM(lop)(POLYNOMIAL_CONV(r))
                  TRANS(th1)(POLYNOMIAL_NEG_CONV(rand(concl(th1))))
                | if Host.hol_not(is_comb(lop))
                  | REFL(tm)
                  | let [op, l] = dest_comb(lop)
                    if (Host.hol_equal(op)(pow_tm_2) && is_numeral(r))
                    | let th1 = AP_THM(AP_TERM(op)(POLYNOMIAL_CONV(l)))(r)
                      TRANS(th1)(POLYNOMIAL_POW_CONV(rand(concl(th1))))
                    | if (Host.hol_equal(op)(add_tm_2) || (Host.hol_equal(op)(mul_tm_2) || Host.hol_equal(op)(sub_tm)))
                      | let th1 = MK_COMB([AP_TERM(op)(POLYNOMIAL_CONV(l)), POLYNOMIAL_CONV(r)])
                        let fn:
                          if Host.hol_equal(op)(add_tm_2)
                          | POLYNOMIAL_ADD_CONV
                          | (if Host.hol_equal(op)(mul_tm_2) | POLYNOMIAL_MUL_CONV | POLYNOMIAL_SUB_CONV)
                        TRANS(th1)(fn(rand(concl(th1))))
                      | REFL(tm)
            [
              POLYNOMIAL_NEG_CONV,
              POLYNOMIAL_ADD_CONV,
              POLYNOMIAL_SUB_CONV,
              POLYNOMIAL_MUL_CONV,
              POLYNOMIAL_POW_CONV,
              POLYNOMIAL_CONV
            ]
          normalizers

def NUM_NORMALIZE_CONV:
  let sth_2:
    prove(
      [
        Host.hol_term(And(
          Forall(
            "x",
            Num,
            Forall(
              "y",
              Num,
              Forall(
                "z",
                Num,
                Eq(
                  Num,
                  App(
                    Const("+", Fun(Num, Fun(Num, Num))),
                    [Ref("x"), App(Const("+", Fun(Num, Fun(Num, Num))), [Ref("y"), Ref("z")])]
                  ),
                  App(
                    Const("+", Fun(Num, Fun(Num, Num))),
                    [App(Const("+", Fun(Num, Fun(Num, Num))), [Ref("x"), Ref("y")]), Ref("z")]
                  )
                )
              )
            )
          ),
          And(
            Forall(
              "x",
              Num,
              Forall(
                "y",
                Num,
                Eq(
                  Num,
                  App(Const("+", Fun(Num, Fun(Num, Num))), [Ref("x"), Ref("y")]),
                  App(Const("+", Fun(Num, Fun(Num, Num))), [Ref("y"), Ref("x")])
                )
              )
            ),
            And(
              Forall(
                "x",
                Num,
                Eq(
                  Num,
                  App(
                    Const("+", Fun(Num, Fun(Num, Num))),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]), Ref("x")]
                  ),
                  Ref("x")
                )
              ),
              And(
                Forall(
                  "x",
                  Num,
                  Forall(
                    "y",
                    Num,
                    Forall(
                      "z",
                      Num,
                      Eq(
                        Num,
                        App(
                          Const("*", Fun(Num, Fun(Num, Num))),
                          [Ref("x"), App(Const("*", Fun(Num, Fun(Num, Num))), [Ref("y"), Ref("z")])]
                        ),
                        App(
                          Const("*", Fun(Num, Fun(Num, Num))),
                          [App(Const("*", Fun(Num, Fun(Num, Num))), [Ref("x"), Ref("y")]), Ref("z")]
                        )
                      )
                    )
                  )
                ),
                And(
                  Forall(
                    "x",
                    Num,
                    Forall(
                      "y",
                      Num,
                      Eq(
                        Num,
                        App(Const("*", Fun(Num, Fun(Num, Num))), [Ref("x"), Ref("y")]),
                        App(Const("*", Fun(Num, Fun(Num, Num))), [Ref("y"), Ref("x")])
                      )
                    )
                  ),
                  And(
                    Forall(
                      "x",
                      Num,
                      Eq(
                        Num,
                        App(
                          Const("*", Fun(Num, Fun(Num, Num))),
                          [
                            App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]),
                            Ref("x")
                          ]
                        ),
                        Ref("x")
                      )
                    ),
                    And(
                      Forall(
                        "x",
                        Num,
                        Eq(
                          Num,
                          App(
                            Const("*", Fun(Num, Fun(Num, Num))),
                            [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]), Ref("x")]
                          ),
                          App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])
                        )
                      ),
                      And(
                        Forall(
                          "x",
                          Num,
                          Forall(
                            "y",
                            Num,
                            Forall(
                              "z",
                              Num,
                              Eq(
                                Num,
                                App(
                                  Const("*", Fun(Num, Fun(Num, Num))),
                                  [Ref("x"), App(Const("+", Fun(Num, Fun(Num, Num))), [Ref("y"), Ref("z")])]
                                ),
                                App(
                                  Const("+", Fun(Num, Fun(Num, Num))),
                                  [
                                    App(Const("*", Fun(Num, Fun(Num, Num))), [Ref("x"), Ref("y")]),
                                    App(Const("*", Fun(Num, Fun(Num, Num))), [Ref("x"), Ref("z")])
                                  ]
                                )
                              )
                            )
                          )
                        ),
                        And(
                          Forall(
                            "x",
                            Num,
                            Eq(
                              Num,
                              App(
                                Const("EXP", Fun(Num, Fun(Num, Num))),
                                [Ref("x"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                              ),
                              App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                            )
                          ),
                          Forall(
                            "x",
                            Num,
                            Forall(
                              "n",
                              Num,
                              Eq(
                                Num,
                                App(
                                  Const("EXP", Fun(Num, Fun(Num, Num))),
                                  [Ref("x"), App(Const("SUC", Fun(Num, Num)), [Ref("n")])]
                                ),
                                App(
                                  Const("*", Fun(Num, Fun(Num, Num))),
                                  [Ref("x"), App(Const("EXP", Fun(Num, Fun(Num, Num))), [Ref("x"), Ref("n")])]
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )),
        (
          REWRITE_TAC(PairList [EXP, MULT_CLAUSES, ADD_CLAUSES, LEFT_ADD_DISTRIB]) then_tac \
          REWRITE_TAC(PairList [ADD_AC, MULT_AC])
        )
      ]
    )
  let rth_2 = TRUTH
  let is_semiring_constant_2 = is_numeral
  let SEMIRING_ADD_CONV_2 = NUM_ADD_CONV
  let SEMIRING_MUL_CONV_2 = NUM_MULT_CONV
  let SEMIRING_POW_CONV_2 = NUM_EXP_CONV
  let [_, _, _, _, _, NUM_NORMALIZE_CONV] = SEMIRING_NORMALIZERS_CONV(sth_2)(rth_2)([is_semiring_constant_2, SEMIRING_ADD_CONV_2, SEMIRING_MUL_CONV_2, SEMIRING_POW_CONV_2])(Host.hol_lt)
  NUM_NORMALIZE_CONV
