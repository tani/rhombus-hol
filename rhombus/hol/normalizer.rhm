                      let [tm1, tm2] = Fusion.dest_comb(Fusion.rand(Fusion.concl(th1)))
                      let [tm3, tm4] = Fusion.dest_comb(tm1)
                      let th2 = Equal.AP_THM(Equal.AP_TERM(tm3)(MONOMIAL_ADD_CONV(tm4)))(tm2)
                      DEZERO_RULE(Fusion.TRANS(th1)(th2))
                    | if Host.hol_gt(ord)(0)
                      | Fusion.REFL(tm)
                      | let th1 = Fusion.INST(PairList.cons([l, a_tm_2], PairList.cons([c, c_tm_2], PairList.cons([d, d_tm_2], PairList []))))(pthm_25)
                        let [tm1, tm2] = Fusion.dest_comb(Fusion.rand(Fusion.concl(th1)))
                        DEZERO_RULE(Fusion.TRANS(th1)(Equal.AP_TERM(tm1)(PADD(tm2))))
                  | let ord = morder(l)(r)
                    if Host.hol_equal(ord)(0)
                    | MONOMIAL_ADD_CONV(tm)
                    | (if Host.hol_gt(ord)(0) | DEZERO_RULE(Fusion.REFL(tm)) | DEZERO_RULE(Fusion.INST(PairList.cons([l, a_tm_2], PairList.cons([r, c_tm_2], PairList [])))(pthm_27)))
          let POLYNOMIAL_ADD_CONV = PADD
          fun PMUL(tm):
            let [l, r] = dest_mul_2(tm)
            if Host.hol_not(is_add_2(l))
            | POLYNOMIAL_MONOMIAL_MUL_CONV(tm)
            | if Host.hol_not(is_add_2(r))
              | let th1 = Fusion.INST(PairList.cons([l, a_tm_2], PairList.cons([r, b_tm_2], PairList [])))(pthm_09)
                Fusion.TRANS(th1)(POLYNOMIAL_MONOMIAL_MUL_CONV(Fusion.rand(Fusion.concl(th1))))
              | let [a_3, b] = dest_add_2(l)
                let th1 = Fusion.INST(PairList.cons([a_3, a_tm_2], PairList.cons([b, b_tm_2], PairList.cons([r, c_tm_2], PairList []))))(pthm_10)
                let [tm1, tm2] = Fusion.dest_comb(Fusion.rand(Fusion.concl(th1)))
                let [tm3, tm4] = Fusion.dest_comb(tm1)
                let th2 = Equal.AP_TERM(tm3)(POLYNOMIAL_MONOMIAL_MUL_CONV(tm4))
                let th3 = Fusion.TRANS(th1)(Fusion.MK_COMB([th2, PMUL(tm2)]))
                Fusion.TRANS(th3)(POLYNOMIAL_ADD_CONV(Fusion.rand(Fusion.concl(th3))))
          let POLYNOMIAL_MUL_CONV:
            fun(tm):
              let [l, r] = dest_mul_2(tm)
              if Host.hol_equal(l)(zero_tm_2)
              | Fusion.INST(PairList.cons([r, a_tm_2], PairList []))(pthm_11)
              | if Host.hol_equal(r)(zero_tm_2)
                | Fusion.INST(PairList.cons([l, a_tm_2], PairList []))(pthm_12)
                | if Host.hol_equal(l)(one_tm_2)
                  | Fusion.INST(PairList.cons([r, a_tm_2], PairList []))(pthm_13)
                  | (if Host.hol_equal(r)(one_tm_2) | Fusion.INST(PairList.cons([l, a_tm_2], PairList []))(pthm_14) | PMUL(tm))
          fun PPOW(tm):
            let [l, n] = dest_pow_2(tm)
            if Host.hol_equal(n)(zeron_tm_2)
            | Fusion.INST(PairList.cons([l, x_tm_2], PairList []))(pthm_35)
            | if Host.hol_equal(n)(onen_tm_2)
              | Fusion.INST(PairList.cons([l, x_tm_2], PairList []))(pthm_36)
              | let th1 = CalcNum.num_CONV(n)
                let th2 = Fusion.INST(PairList.cons([l, x_tm_2], PairList.cons([Fusion.rand(Fusion.rand(Fusion.concl(th1))), q_tm_2], PairList [])))(pthm_38)
                let [tm1, tm2] = Fusion.dest_comb(Fusion.rand(Fusion.concl(th2)))
                let th3 = Fusion.TRANS(th2)(Equal.AP_TERM(tm1)(PPOW(tm2)))
                let th4 = Fusion.TRANS(Equal.AP_TERM(Fusion.rator(tm))(th1))(th3)
                Fusion.TRANS(th4)(POLYNOMIAL_MUL_CONV(Fusion.rand(Fusion.concl(th4))))
          let POLYNOMIAL_POW_CONV = (fun(tm): (if is_add_2(Equal.lhand(tm)) | PPOW(tm) | MONOMIAL_POW_CONV(tm)))
          let POLYNOMIAL_NEG_CONV:
            fun(tm):
              let [l, r] = Fusion.dest_comb(tm)
              if Host.hol_unequal(l)(neg_tm)
              | failwith("POLYNOMIAL_NEG_CONV")
              | let th1 = Fusion.INST(PairList.cons([r, x_tm_2], PairList []))(nthm_1)
                Fusion.TRANS(th1)(POLYNOMIAL_MONOMIAL_MUL_CONV(Fusion.rand(Fusion.concl(th1))))
          let POLYNOMIAL_SUB_CONV:
            fun(tm):
              let [l, r] = dest_sub(tm)
              let th1 = Fusion.INST(PairList.cons([l, x_tm_2], PairList.cons([r, y_tm_2], PairList [])))(nthm_2)
