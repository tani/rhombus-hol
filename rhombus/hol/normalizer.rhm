              Fusion.TRANS(th1)(Fusion.TRANS(th2)(POLYNOMIAL_ADD_CONV(Fusion.rand(Fusion.concl(th2)))))
          fun POLYNOMIAL_CONV(tm):
            if (Host.hol_not(Fusion.is_comb(tm)) || is_semiring_constant(tm))
            | Fusion.REFL(tm)
            | let [lop, r] = Fusion.dest_comb(tm)
              if Host.hol_equal(lop)(neg_tm)
              | let th1 = Equal.AP_TERM(lop)(POLYNOMIAL_CONV(r))
                Fusion.TRANS(th1)(POLYNOMIAL_NEG_CONV(Fusion.rand(Fusion.concl(th1))))
              | if Host.hol_not(Fusion.is_comb(lop))
                | Fusion.REFL(tm)
                | let [op, l] = Fusion.dest_comb(lop)
                  if (Host.hol_equal(op)(pow_tm_2) && Nums.is_numeral(r))
                  | let th1 = Equal.AP_THM(Equal.AP_TERM(op)(POLYNOMIAL_CONV(l)))(r)
                    Fusion.TRANS(th1)(POLYNOMIAL_POW_CONV(Fusion.rand(Fusion.concl(th1))))
                  | if (Host.hol_equal(op)(add_tm_2) || (Host.hol_equal(op)(mul_tm_2) || Host.hol_equal(op)(sub_tm)))
                    | let th1 = Fusion.MK_COMB([Equal.AP_TERM(op)(POLYNOMIAL_CONV(l)), POLYNOMIAL_CONV(r)])
                      let fn:
                        if Host.hol_equal(op)(add_tm_2)
                        | POLYNOMIAL_ADD_CONV
                        | (if Host.hol_equal(op)(mul_tm_2) | POLYNOMIAL_MUL_CONV | POLYNOMIAL_SUB_CONV)
                      Fusion.TRANS(th1)(fn(Fusion.rand(Fusion.concl(th1))))
                    | Fusion.REFL(tm)
          [POLYNOMIAL_NEG_CONV, POLYNOMIAL_ADD_CONV, POLYNOMIAL_SUB_CONV, POLYNOMIAL_MUL_CONV, POLYNOMIAL_POW_CONV, POLYNOMIAL_CONV]

