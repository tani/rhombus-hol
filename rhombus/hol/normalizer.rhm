          let [nthm_1, nthm_2, sub_tm, neg_tm, dest_sub, is_sub]:
            if (concl(rth) == true_tm_2)
            | [rth, rth, true_tm_2, true_tm_2, (fun(t): [t, t]), K(#false)]
            | let nthm_1_2 = SPEC(x_tm_2)(CONJUNCT1(rth))
              let nthm_2_2 = SPECL(PairList [x_tm_2, y_tm_2])(CONJUNCT2(rth))
              let sub_tm_2 = rator(rator(lhand(concl(nthm_2_2))))
              let neg_tm_2 = rator(lhand(concl(nthm_1_2)))
              let dest_sub_2 = dest_binop(sub_tm_2)
              let is_sub_2 = is_binop(sub_tm_2)
              [nthm_1_2, nthm_2_2, sub_tm_2, neg_tm_2, dest_sub_2, is_sub_2]
          let normalizers:
            let POWVAR_MUL_CONV:
              fun(tm):
                let [l, r] = dest_mul_2(tm)
                if (is_semiring_constant(l) && is_semiring_constant(r))
                | SEMIRING_MUL_CONV(tm)
                | try:
                    let [lx, ln] = dest_pow_2(l)
                    try:
                      let [rx, rn] = dest_pow_2(r)
                      let th1 = INST(PairList [[lx, x_tm_2], [ln, p_tm_2], [rn, q_tm_2]])(pthm_29)
                      let [tm1, tm2] = dest_comb(rand(concl(th1)))
                      TRANS(th1)(AP_TERM(tm1)(NUM_ADD_CONV(tm2)))
                      ~catch exn:
                        match exn
                        | Failure(_):
                            let th1 = INST(PairList [[lx, x_tm_2], [ln, q_tm_2]])(pthm_31)
                            let [tm1, tm2] = dest_comb(rand(concl(th1)))
                            TRANS(th1)(AP_TERM(tm1)(NUM_SUC_CONV(tm2)))
                        | exn: (throw exn)
                    ~catch exn:
                      match exn
                      | Failure(_):
                          try:
                            let [rx, rn] = dest_pow_2(r)
                            let th1 = INST(PairList [[rx, x_tm_2], [rn, q_tm_2]])(pthm_30)
                            let [tm1, tm2] = dest_comb(rand(concl(th1)))
                            TRANS(th1)(AP_TERM(tm1)(NUM_SUC_CONV(tm2)))
                            ~catch exn:
                              match exn
                              | Failure(_): INST(PairList [[l, x_tm_2]])(pthm_32)
                              | exn: (throw exn)
                      | exn: (throw exn)
            let MONOMIAL_DEONE:
              fun(th):
                try:
                  let [l, r] = dest_mul_2(rand(concl(th)))
                  (if (l == one_tm_2) | TRANS(th)(INST(PairList [[r, x_tm_2]])(pthm_01)) | th)
                  ~catch exn:
                    match exn
                    | Failure(_): th
                    | exn: (throw exn)
            // Recursive monomial expansion needs the local definition before its first use.
            fun MONOMIAL_POW(tm):
              fun(bod):
                fun(ntm):
                  if !is_comb(bod)
                  | REFL(tm)
                  | if is_semiring_constant(bod)
                    | SEMIRING_POW_CONV(tm)
                    | let [lop, r] = dest_comb(bod)
                      if !is_comb(lop)
                      | REFL(tm)
                      | let [op, l] = dest_comb(lop)
                        if ((op == pow_tm_2) && is_numeral(r))
                        | let th1 = INST(PairList [[l, x_tm_2], [r, p_tm_2], [ntm, q_tm_2]])(pthm_34)
                          let [l, r] = dest_comb(rand(concl(th1)))
                          TRANS(th1)(AP_TERM(l)(NUM_MULT_CONV(r)))
                        | if (op == mul_tm_2)
                          | let th1 = INST(PairList [[l, x_tm_2], [r, y_tm_2], [ntm, q_tm_2]])(pthm_33)
                            let [xy, z] = dest_comb(rand(concl(th1)))
                            let [x, y] = dest_comb(xy)
                            let thl_2 = MONOMIAL_POW(y)(l)(ntm)
                            let thr_2 = MONOMIAL_POW(z)(r)(ntm)
                            TRANS(th1)(MK_COMB([AP_TERM(x)(thl_2), thr_2]))
                          | REFL(tm)
            let MONOMIAL_POW_CONV:
              fun(tm):
                let [lop, r] = dest_comb(tm)
                let [op, l] = dest_comb(lop)
                if ((op != pow_tm_2) || !is_numeral(r))
                | failwith("MONOMIAL_POW_CONV")
                | if (r == zeron_tm_2)
                  | INST(PairList [[l, x_tm_2]])(pthm_35)
                  | (if (r == onen_tm_2) | INST(PairList [[l, x_tm_2]])(pthm_36) | MONOMIAL_DEONE(MONOMIAL_POW(tm)(l)(r)))
            let powvar:
              fun(tm):
                if is_semiring_constant(tm)
                | one_tm_2
                | try:
                    let [lop, r] = dest_comb(tm)
                    let [op, l] = dest_comb(lop)
                    (if ((op == pow_tm_2) && is_numeral(r)) | l | failwith(""))
                    ~catch exn:
                      match exn
                      | Failure(_): tm
                      | exn: (throw exn)
            let vorder:
              fun(x):
                fun(y):
                  if (x == y)
                  | 0
                  | if (x == one_tm_2)
                    | -1
                    | if (y == one_tm_2)
                      | 1
                      | (if variable_order(x)(y) | -1 | 1)
            // Recursive monomial multiplication needs the local definition before its first use.
            fun MONOMIAL_MUL(tm):
              fun(l):
                fun(r):
                  try:
                    let [lx, ly] = dest_mul_2(l)
                    let vl = powvar(lx)
                    try:
                      let [rx, ry] = dest_mul_2(r)
                      let vr = powvar(rx)
                      let ord = vorder(vl)(vr)
                      if (ord == 0)
                      | let th1 = INST(PairList [[lx, lx_tm_2], [ly, ly_tm_2], [rx, rx_tm_2], [ry, ry_tm_2]])(pthm_15)
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        let [tm3, tm4] = dest_comb(tm1)
                        let th2 = AP_THM(AP_TERM(tm3)(POWVAR_MUL_CONV(tm4)))(tm2)
                        let th3 = TRANS(th1)(th2)
                        let [tm5, tm6] = dest_comb(rand(concl(th3)))
                        let [tm7, tm8] = dest_comb(tm6)
                        let th4 = MONOMIAL_MUL(tm6)(rand(tm7))(tm8)
                        TRANS(th3)(AP_TERM(tm5)(th4))
                      | let th0 = (if (ord < 0) | pthm_16 | pthm_17)
                        let th1 = INST(PairList [[lx, lx_tm_2], [ly, ly_tm_2], [rx, rx_tm_2], [ry, ry_tm_2]])(th0)
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        let [tm3, tm4] = dest_comb(tm2)
                        TRANS(th1)(AP_TERM(tm1)(MONOMIAL_MUL(tm2)(rand(tm3))(tm4)))
                      ~catch exn:
                        match exn
                        | Failure(_):
                            let vr = powvar(r)
                            let ord = vorder(vl)(vr)
                            if (ord == 0)
                            | let th1 = INST(PairList [[lx, lx_tm_2], [ly, ly_tm_2], [r, rx_tm_2]])(pthm_18)
                              let [tm1, tm2] = dest_comb(rand(concl(th1)))
                              let [tm3, tm4] = dest_comb(tm1)
                              let th2 = AP_THM(AP_TERM(tm3)(POWVAR_MUL_CONV(tm4)))(tm2)
                              TRANS(th1)(th2)
                            | if (ord < 0)
                              | let th1 = INST(PairList [[lx, lx_tm_2], [ly, ly_tm_2], [r, rx_tm_2]])(pthm_19)
                                let [tm1, tm2] = dest_comb(rand(concl(th1)))
                                let [tm3, tm4] = dest_comb(tm2)
                                TRANS(th1)(AP_TERM(tm1)(MONOMIAL_MUL(tm2)(rand(tm3))(tm4)))
                              | INST(PairList [[l, lx_tm_2], [r, rx_tm_2]])(pthm_20)
                        | exn: (throw exn)
                    ~catch exn:
                      match exn
                      | Failure(_):
                          let vl = powvar(l)
                          try:
                            let [rx, ry] = dest_mul_2(r)
                            let vr = powvar(rx)
                            let ord = vorder(vl)(vr)
                            if (ord == 0)
                            | let th1 = INST(PairList [[l, lx_tm_2], [rx, rx_tm_2], [ry, ry_tm_2]])(pthm_21)
                              let [tm1, tm2] = dest_comb(rand(concl(th1)))
                              let [tm3, tm4] = dest_comb(tm1)
                              TRANS(th1)(AP_THM(AP_TERM(tm3)(POWVAR_MUL_CONV(tm4)))(tm2))
                            | if (ord > 0)
                              | let th1 = INST(PairList [[l, lx_tm_2], [rx, rx_tm_2], [ry, ry_tm_2]])(pthm_22)
                                let [tm1, tm2] = dest_comb(rand(concl(th1)))
                                let [tm3, tm4] = dest_comb(tm2)
                                TRANS(th1)(AP_TERM(tm1)(MONOMIAL_MUL(tm2)(rand(tm3))(tm4)))
                              | REFL(tm)
                            ~catch exn:
                              match exn
                              | Failure(_):
                                  let vr = powvar(r)
                                  let ord = vorder(vl)(vr)
                                  if (ord == 0)
                                  | POWVAR_MUL_CONV(tm)
                                  | (if (ord > 0) | INST(PairList [[l, lx_tm_2], [r, rx_tm_2]])(pthm_20) | REFL(tm))
                              | exn: (throw exn)
                      | exn: (throw exn)
            let MONOMIAL_MUL_CONV:
              fun(tm):
                let [l, r] = dest_mul_2(tm)
                MONOMIAL_DEONE(MONOMIAL_MUL(tm)(l)(r))
            fun PMM_CONV(tm):
              let [l, r] = dest_mul_2(tm)
              try:
                let [y, z] = dest_add_2(r)
                let th1 = INST(PairList [[l, x_tm_2], [y, y_tm_2], [z, z_tm_2]])(pthm_37)
                let [tm1, tm2] = dest_comb(rand(concl(th1)))
                let [tm3, tm4] = dest_comb(tm1)
                let th2 = MK_COMB([AP_TERM(tm3)(MONOMIAL_MUL_CONV(tm4)), PMM_CONV(tm2)])
                TRANS(th1)(th2)
                ~catch exn:
                  match exn
                  | Failure(_): MONOMIAL_MUL_CONV(tm)
                  | exn: (throw exn)
            let POLYNOMIAL_MONOMIAL_MUL_CONV = PMM_CONV
            let MONOMIAL_ADD_CONV:
              fun(tm):
                let [l, r] = dest_add_2(tm)
                if (is_semiring_constant(l) && is_semiring_constant(r))
                | SEMIRING_ADD_CONV(tm)
                | let th1:
                    if (is_mul_2(l) && is_semiring_constant(lhand(l)))
                    | (if (is_mul_2(r) && is_semiring_constant(lhand(r))) | INST(PairList [[lhand(l), a_tm_2], [lhand(r), b_tm_2], [rand(r), m_tm_2]])(pthm_02) | INST(PairList [[lhand(l), a_tm_2], [r, m_tm_2]])(pthm_03))
                    | (if (is_mul_2(r) && is_semiring_constant(lhand(r))) | INST(PairList [[lhand(r), a_tm_2], [l, m_tm_2]])(pthm_04) | INST(PairList [[r, m_tm_2]])(pthm_05))
                  let [tm1, tm2] = dest_comb(rand(concl(th1)))
                  let [tm3, tm4] = dest_comb(tm1)
                  let th2 = AP_TERM(tm3)(SEMIRING_ADD_CONV(tm4))
                  let th3 = TRANS(th1)(AP_THM(th2)(tm2))
                  let tm5 = rand(concl(th3))
                  (if (lhand(tm5) == zero_tm_2) | TRANS(th3)(INST(PairList [[rand(tm5), m_tm_2]])(pthm_06)) | MONOMIAL_DEONE(th3))
            let powervars:
              fun(tm):
                let ptms = striplist(dest_mul_2)(tm)
                (if is_semiring_constant(hd(ptms)) | tl(ptms) | ptms)
            let dest_varpow:
              fun(tm):
                try:
                  let [x, n] = dest_pow_2(tm)
                  [x, dest_numeral(n)]
                  ~catch exn:
                    match exn
                    | Failure(_): [tm, (if is_semiring_constant(tm) | num_0 | num_1)]
                    | exn: (throw exn)
            // Recursive ordering needs the local definition before its first use.
            fun lexorder(l1):
              fun(l2):
                match [l1, l2]
                | [PairList [], PairList []]: 0
                | [vps, PairList []]: -1
                | [PairList [], vps]: 1
                | [PairList [[x1, n1], & vs1], PairList [[x2, n2], & vs2]]:
                    if variable_order(x1)(x2)
                    | 1
                    | if variable_order(x2)(x1)
                      | -1
                      | if (n1 < n2)
                        | -1
                        | (if (n2 < n1) | 1 | lexorder(vs1)(vs2))
            let morder:
              fun(tm1):
                fun(tm2):
                  let vdegs1_2 = map(dest_varpow)(powervars(tm1))
                  let vdegs2_2 = map(dest_varpow)(powervars(tm2))
                  let deg1_2 = itlist(o((fun (x): fun (y): x + y))(snd))(vdegs1_2)(num_0)
                  let deg2_2 = itlist(o((fun (x): fun (y): x + y))(snd))(vdegs2_2)(num_0)
                  if (deg1_2 < deg2_2)
                  | -1
                  | (if (deg1_2 > deg2_2) | 1 | lexorder(vdegs1_2)(vdegs2_2))
            let DEZERO_RULE:
              fun(th):
                let tm = rand(concl(th))
                if !is_add_2(tm)
                | th
                | let [lop, r] = dest_comb(tm)
                  let l = rand(lop)
                  if (l == zero_tm_2)
                  | TRANS(th)(INST(PairList [[r, a_tm_2]])(pthm_07))
                  | (if (r == zero_tm_2) | TRANS(th)(INST(PairList [[l, a_tm_2]])(pthm_08)) | th)
            fun PADD(tm):
              let [l, r] = dest_add_2(tm)
              if (l == zero_tm_2)
              | INST(PairList [[r, a_tm_2]])(pthm_07)
              | if (r == zero_tm_2)
                | INST(PairList [[l, a_tm_2]])(pthm_08)
                | if is_add_2(l)
                  | let [a_2, b] = dest_add_2(l)
                    if is_add_2(r)
                    | let [c, d] = dest_add_2(r)
                      let ord = morder(a_2)(c)
                      if (ord == 0)
                      | let th1 = INST(PairList [[a_2, a_tm_2], [b, b_tm_2], [c, c_tm_2], [d, d_tm_2]])(pthm_23)
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        let [tm3, tm4] = dest_comb(tm1)
                        let th2 = AP_TERM(tm3)(MONOMIAL_ADD_CONV(tm4))
                        DEZERO_RULE(TRANS(th1)(MK_COMB([th2, PADD(tm2)])))
                      | let th1 = (if (ord > 0) | INST(PairList [[a_2, a_tm_2], [b, b_tm_2], [r, c_tm_2]])(pthm_24) | INST(PairList [[l, a_tm_2], [c, c_tm_2], [d, d_tm_2]])(pthm_25))
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        DEZERO_RULE(TRANS(th1)(AP_TERM(tm1)(PADD(tm2))))
                    | let ord = morder(a_2)(r)
                      if (ord == 0)
                      | let th1 = INST(PairList [[a_2, a_tm_2], [b, b_tm_2], [r, c_tm_2]])(pthm_26)
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        let [tm3, tm4] = dest_comb(tm1)
                        let th2 = AP_THM(AP_TERM(tm3)(MONOMIAL_ADD_CONV(tm4)))(tm2)
                        DEZERO_RULE(TRANS(th1)(th2))
                      | if (ord > 0)
                        | let th1 = INST(PairList [[a_2, a_tm_2], [b, b_tm_2], [r, c_tm_2]])(pthm_24)
                          let [tm1, tm2] = dest_comb(rand(concl(th1)))
                          DEZERO_RULE(TRANS(th1)(AP_TERM(tm1)(PADD(tm2))))
                        | DEZERO_RULE(INST(PairList [[l, a_tm_2], [r, c_tm_2]])(pthm_27))
                  | if is_add_2(r)
                    | let [c, d] = dest_add_2(r)
                      let ord = morder(l)(c)
                      if (ord == 0)
                      | let th1 = INST(PairList [[l, a_tm_2], [c, c_tm_2], [d, d_tm_2]])(pthm_28)
                        let [tm1, tm2] = dest_comb(rand(concl(th1)))
                        let [tm3, tm4] = dest_comb(tm1)
                        let th2 = AP_THM(AP_TERM(tm3)(MONOMIAL_ADD_CONV(tm4)))(tm2)
                        DEZERO_RULE(TRANS(th1)(th2))
                      | if (ord > 0)
                        | REFL(tm)
                        | let th1 = INST(PairList [[l, a_tm_2], [c, c_tm_2], [d, d_tm_2]])(pthm_25)
                          let [tm1, tm2] = dest_comb(rand(concl(th1)))
                          DEZERO_RULE(TRANS(th1)(AP_TERM(tm1)(PADD(tm2))))
                    | let ord = morder(l)(r)
                      if (ord == 0)
                      | MONOMIAL_ADD_CONV(tm)
                      | (if (ord > 0) | DEZERO_RULE(REFL(tm)) | DEZERO_RULE(INST(PairList [[l, a_tm_2], [r, c_tm_2]])(pthm_27)))
            let POLYNOMIAL_ADD_CONV = PADD
            fun PMUL(tm):
              let [l, r] = dest_mul_2(tm)
              if !is_add_2(l)
              | POLYNOMIAL_MONOMIAL_MUL_CONV(tm)
              | if !is_add_2(r)
                | let th1 = INST(PairList [[l, a_tm_2], [r, b_tm_2]])(pthm_09)
                  TRANS(th1)(POLYNOMIAL_MONOMIAL_MUL_CONV(rand(concl(th1))))
                | let [a_3, b] = dest_add_2(l)
                  let th1 = INST(PairList [[a_3, a_tm_2], [b, b_tm_2], [r, c_tm_2]])(pthm_10)
                  let [tm1, tm2] = dest_comb(rand(concl(th1)))
                  let [tm3, tm4] = dest_comb(tm1)
                  let th2 = AP_TERM(tm3)(POLYNOMIAL_MONOMIAL_MUL_CONV(tm4))
                  let th3 = TRANS(th1)(MK_COMB([th2, PMUL(tm2)]))
                  TRANS(th3)(POLYNOMIAL_ADD_CONV(rand(concl(th3))))
            let POLYNOMIAL_MUL_CONV:
              fun(tm):
                let [l, r] = dest_mul_2(tm)
                if (l == zero_tm_2)
                | INST(PairList [[r, a_tm_2]])(pthm_11)
                | if (r == zero_tm_2)
                  | INST(PairList [[l, a_tm_2]])(pthm_12)
                  | if (l == one_tm_2)
                    | INST(PairList [[r, a_tm_2]])(pthm_13)
                    | (if (r == one_tm_2) | INST(PairList [[l, a_tm_2]])(pthm_14) | PMUL(tm))
            fun PPOW(tm):
              let [l, n] = dest_pow_2(tm)
              if (n == zeron_tm_2)
              | INST(PairList [[l, x_tm_2]])(pthm_35)
              | if (n == onen_tm_2)
                | INST(PairList [[l, x_tm_2]])(pthm_36)
                | let th1 = num_CONV(n)
                  let th2 = INST(PairList [[l, x_tm_2], [rand(rand(concl(th1))), q_tm_2]])(pthm_38)
                  let [tm1, tm2] = dest_comb(rand(concl(th2)))
                  let th3 = TRANS(th2)(AP_TERM(tm1)(PPOW(tm2)))
                  let th4 = TRANS(AP_TERM(rator(tm))(th1))(th3)
                  TRANS(th4)(POLYNOMIAL_MUL_CONV(rand(concl(th4))))
            let POLYNOMIAL_POW_CONV = (fun(tm): (if is_add_2(lhand(tm)) | PPOW(tm) | MONOMIAL_POW_CONV(tm)))
            let POLYNOMIAL_NEG_CONV:
              fun(tm):
                let [l, r] = dest_comb(tm)
                if (l != neg_tm)
                | failwith("POLYNOMIAL_NEG_CONV")
                | let th1 = INST(PairList [[r, x_tm_2]])(nthm_1)
                  TRANS(th1)(POLYNOMIAL_MONOMIAL_MUL_CONV(rand(concl(th1))))
            let POLYNOMIAL_SUB_CONV:
              fun(tm):
                let [l, r] = dest_sub(tm)
                let th1 = INST(PairList [[l, x_tm_2], [r, y_tm_2]])(nthm_2)
                let [tm1, tm2] = dest_comb(rand(concl(th1)))
                let th2 = AP_TERM(tm1)(POLYNOMIAL_MONOMIAL_MUL_CONV(tm2))
                TRANS(th1)(TRANS(th2)(POLYNOMIAL_ADD_CONV(rand(concl(th2)))))
            fun POLYNOMIAL_CONV(tm):
              if (!is_comb(tm) || is_semiring_constant(tm))
              | REFL(tm)
              | let [lop, r] = dest_comb(tm)
                if (lop == neg_tm)
                | let th1 = AP_TERM(lop)(POLYNOMIAL_CONV(r))
                  TRANS(th1)(POLYNOMIAL_NEG_CONV(rand(concl(th1))))
                | if !is_comb(lop)
                  | REFL(tm)
                  | let [op, l] = dest_comb(lop)
                    if ((op == pow_tm_2) && is_numeral(r))
                    | let th1 = AP_THM(AP_TERM(op)(POLYNOMIAL_CONV(l)))(r)
                      TRANS(th1)(POLYNOMIAL_POW_CONV(rand(concl(th1))))
                    | if ((op == add_tm_2) || ((op == mul_tm_2) || (op == sub_tm)))
                      | let th1 = MK_COMB([AP_TERM(op)(POLYNOMIAL_CONV(l)), POLYNOMIAL_CONV(r)])
                        let fn:
                          if (op == add_tm_2)
                          | POLYNOMIAL_ADD_CONV
                          | (if (op == mul_tm_2) | POLYNOMIAL_MUL_CONV | POLYNOMIAL_SUB_CONV)
                        TRANS(th1)(fn(rand(concl(th1))))
                      | REFL(tm)
            [
              POLYNOMIAL_NEG_CONV,
              POLYNOMIAL_ADD_CONV,
              POLYNOMIAL_SUB_CONV,
              POLYNOMIAL_MUL_CONV,
              POLYNOMIAL_POW_CONV,
              POLYNOMIAL_CONV
            ]
          normalizers

def NUM_NORMALIZE_CONV:
  let sth_2:
    prove(
      [
        (hol:
           const EXP :: num -> num -> num
           const SUC :: num -> num
           (forall (x :: num, y :: num, z :: num): x + (y + z) == x + y + z)
             && ((forall (x :: num, y :: num): x + y == y + x)
                   && ((forall x :: num: (0 :: num) + x == x)
                         && ((forall (x :: num, y :: num, z :: num): x * (y * z) == x * y * z)
                               && ((forall (x :: num, y :: num): x * y == y * x)
                                     && ((forall x :: num: (1 :: num) * x == x)
                                           && ((forall x :: num: (0 :: num) * x == (0 :: num))
                                                 && ((forall (x :: num, y :: num, z :: num):
                                                        x * (y + z) == x * y + x * z)
                                                       && ((forall x :: num: EXP(x, (0 :: num)) == (1 :: num))
                                                             && (forall (x :: num, n :: num):
                                                                   EXP(x, SUC(n)) == x * EXP(x, n))))))))))),
        (
          REWRITE_TAC(PairList [EXP, MULT_CLAUSES, ADD_CLAUSES, LEFT_ADD_DISTRIB]) then_tac \
          REWRITE_TAC(PairList [ADD_AC, MULT_AC])
        )
      ]
    )
  let rth_2 = TRUTH
  let is_semiring_constant_2 = is_numeral
  let SEMIRING_ADD_CONV_2 = NUM_ADD_CONV
  let SEMIRING_MUL_CONV_2 = NUM_MULT_CONV
  let SEMIRING_POW_CONV_2 = NUM_EXP_CONV
  let [_, _, _, _, _, NUM_NORMALIZE_CONV] = SEMIRING_NORMALIZERS_CONV(sth_2)(rth_2)([is_semiring_constant_2, SEMIRING_ADD_CONV_2, SEMIRING_MUL_CONV_2, SEMIRING_POW_CONV_2])(fun (x): fun (y): x < y)
  NUM_NORMALIZE_CONV
