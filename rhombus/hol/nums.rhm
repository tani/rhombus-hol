        MESON_TAC(PairList [nums_NUM_REP_RULES_v2, fst(num_tydef), snd(num_tydef), IND_SUC_0])
      )
    ]
  )

def SUC_INJ:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall (m :: num, n :: num): SUC(m) == SUC(n) <=> m == n),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [SUC_DEF])) then_tac \
                            EQ_TAC
                          ) then_tac \
                          DISCH_TAC
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [])
                      ) then_tac \
                      POP_ASSUM(o(MP_TAC)(AP_TERM(hol:
                                                    const dest_num :: num -> ind
                                                    dest_num)))
                    ) then_tac \
                    SUBGOAL_THEN(
                      (hol:
                         const NUM_REP :: ind -> bool
                         const IND_SUC :: ind -> ind
                         const dest_num :: num -> ind
                         forall p :: num: NUM_REP(IND_SUC(dest_num(p))))
                    )(MP_TAC)
                  ) then_list \
                  PairList [
                    (GEN_TAC then_tac MATCH_MP_TAC(CONJUNCT2(nums_NUM_REP_RULES_v2))),
                    ALL_TAC
                  ]
                ) then_tac \
                REWRITE_TAC(PairList [fst(num_tydef), snd(num_tydef)])
              ) then_tac \
              DISCH_TAC
            ) then_tac \
            ASM_REWRITE_TAC(PairList [nums_IND_SUC_INJ_v2])
          ) then_tac \
          DISCH_THEN(o(MP_TAC)(AP_TERM(hol:
                                         const mk_num :: ind -> num
                                         mk_num)))
        ) then_tac \
        REWRITE_TAC(PairList [fst(num_tydef)])
      )
    ]
  )

def nums_num_INDUCTION:
  prove(
    [
      (hol:
         const _0 :: num
         const SUC :: num -> num
         forall P :: num -> bool:
           P(_0) && (forall n :: num: P(n) ==> P(SUC(n))) ==> (forall n :: num: P(n))),
      (
        (
          (
            (
              REPEAT(STRIP_TAC) then_tac \
              MP_TAC(
                SPEC(
                  (hol:
                     var P :: num -> bool
                     const NUM_REP :: ind -> bool
                     const mk_num :: ind -> num
                     fun (i :: ind): NUM_REP(i) && P(mk_num(i)))
                )(nums_NUM_REP_INDUCT_v2)
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [GSYM(ZERO_DEF), nums_NUM_REP_RULES_v2])
          ) then_tac \
          W(
            o(
              o(C(SUBGOAL_THEN)((fun(t): REWRITE_TAC(PairList [t]))))(funpow(2)(lhand))
            )(snd)
          )
        ) then_list \
        PairList [
          (
            REPEAT(STRIP_TAC) then_list \
            PairList [
              (
                MATCH_MP_TAC(CONJUNCT2(nums_NUM_REP_RULES_v2)) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ),
              (
                SUBGOAL_THEN(
                  (hol:
                     var i :: ind
                     const mk_num :: ind -> num
                     const IND_SUC :: ind -> ind
                     const SUC :: num -> num
                     mk_num(IND_SUC(i)) == SUC(mk_num(i)))
                )(SUBST1_TAC) then_list \
                PairList [
                  (
                    (
                      (
                        (REWRITE_TAC(PairList [SUC_DEF]) then_tac REPEAT(AP_TERM_TAC)) then_tac \
                        CONV_TAC(SYM_CONV)
                      ) then_tac \
                      REWRITE_TAC(PairList [GSYM(snd(num_tydef))])
                    ) then_tac \
                    FIRST_ASSUM(MATCH_ACCEPT_TAC)
                  ),
                  (FIRST_ASSUM(MATCH_MP_TAC) then_tac FIRST_ASSUM(MATCH_ACCEPT_TAC))
                ]
              )
            ]
          ),
          (
            DISCH_THEN(
              o(MP_TAC)(SPEC(hol:
                               var n :: num
                               const dest_num :: num -> ind
                               dest_num(n)))
            ) then_tac \
            REWRITE_TAC(PairList [fst(num_tydef), snd(num_tydef)])
