def NUMERAL:
  let num_ty = Fusion.type_of(Equal.lhand(Fusion.concl(ZERO_DEF)))
  let funn_ty = Fusion.mk_fun_ty(num_ty)(num_ty)
  let numeral_tm = Fusion.mk_var(["NUMERAL", funn_ty])
  let n_tm = Fusion.mk_var(["n", num_ty])
  HolPair.new_definition(Fusion.mk_eq([Fusion.mk_comb([numeral_tm, n_tm]), n_tm]))

def PairList [nums_NOT_SUC_v2, & PairList [nums_num_INDUCTION_v2, & PairList [nums_num_Axiom_v2, & PairList []]]]:
  let th = Tactics.prove([Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Const("_0", Tyapp("num", []))), Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Const("_0", Tyapp("num", []))))), Simp.REWRITE_TAC(PairList.cons(NUMERAL, PairList []))])
  map(Simp.GEN_REWRITE_RULE(Equal.DEPTH_CONV)(PairList.cons(th, PairList [])))(PairList.cons(nums_NOT_SUC, PairList.cons(nums_num_INDUCTION, PairList.cons(nums_num_Axiom, PairList []))))

def INDUCT_TAC = Tactics.THENL(Tactics.THEN(Tactics.MATCH_MP_TAC(nums_num_INDUCTION_v2))(Tactics.CONJ_TAC))(PairList.cons(Tactics.ALL_TAC, PairList.cons(Tactics.THEN(Tactics.GEN_TAC)(Tactics.DISCH_TAC), PairList [])))

def num_RECURSION:
  let avs = fst(Basics.strip_forall(Fusion.concl(nums_num_Axiom_v2)))
  Bool.GENL(avs)(Bool.EXISTENCE(Bool.SPECL(avs)(nums_num_Axiom_v2)))

def num_CASES = Tactics.prove([Host.hol_term(Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("m", Tyapp("num", [])), Comb(Comb(Const("\\/", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Var("m", Tyapp("num", []))), Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Const("_0", Tyapp("num", []))))), Comb(Const("?", Tyapp("fun", [Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("n", Tyapp("num", [])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Var("m", Tyapp("num", []))), Comb(Const("SUC", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Var("n", Tyapp("num", [])))))))))), Tactics.THEN(INDUCT_TAC)(Meson.MESON_TAC(PairList []))])

Host.ref_set(Class.inductive_type_store)(PairList.cons(["num", [2, nums_num_INDUCTION_v2, num_RECURSION]], Host.ref_get(Class.inductive_type_store)))

def BIT0_DEF:
  let funn_ty = Fusion.type_of(Fusion.rator(Equal.lhand(snd(Basics.dest_forall(Fusion.concl(NUMERAL))))))
  let bit0_tm = Fusion.mk_var(["BIT0", funn_ty])
  let hol_def_2 = HolPair.new_definition(Fusion.mk_eq([bit0_tm, Host.hol_term(Comb(Const("@", Tyapp("fun", [Tyapp("fun", [Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])]), Tyapp("bool", [])]), Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])])), Abs(Var("fn", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Comb(Var("fn", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Const("_0", Tyapp("num", []))))), Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Const("_0", Tyapp("num", []))))), Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("n", Tyapp("num", [])), Comb(Comb(Const("=", Tyapp("fun", [Tyapp("num", []), Tyapp("fun", [Tyapp("num", []), Tyapp("bool", [])])])), Comb(Var("fn", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Comb(Const("SUC", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Var("n", Tyapp("num", []))))), Comb(Const("SUC", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Comb(Const("SUC", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Comb(Var("fn", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Var("n", Tyapp("num", []))))))))))))]))
  let th_2 = Equal.BETA_RULE(Bool.ISPECL(PairList.cons(Host.hol_term(Comb(Const("NUMERAL", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Const("_0", Tyapp("num", [])))), PairList.cons(Host.hol_term(Abs(Var("m", Tyapp("num", [])), Abs(Var("n", Tyapp("num", [])), Comb(Const("SUC", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Comb(Const("SUC", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Var("m", Tyapp("num", []))))))), PairList [])))(num_RECURSION))
  Simp.REWRITE_RULE(PairList.cons(Equal.GSYM(hol_def_2), PairList []))(Class.SELECT_RULE(th_2))

def BIT1_DEF:
  let funn_ty = Fusion.type_of(Fusion.rator(Equal.lhand(Equal.lhand(Fusion.concl(BIT0_DEF)))))
  let num_ty = snd(Basics.dest_fun_ty(funn_ty))
  let n_tm = Fusion.mk_var(["n", num_ty])
  let bit1_tm = Fusion.mk_var(["BIT1", funn_ty])
  HolPair.new_definition(Fusion.mk_eq([Fusion.mk_comb([bit1_tm, n_tm]), Host.hol_term(Comb(Const("SUC", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Comb(Const("BIT0", Tyapp("fun", [Tyapp("num", []), Tyapp("num", [])])), Var("n", Tyapp("num", [])))))]))

def mk_numeral:
  let pow24_2 = Host.pow2(24)
  let num_0_2 = Host.num(0)
  let zero_tm_2 = Fusion.mk_const(["_0", PairList []])
  let BIT0_tm_2 = Fusion.mk_const(["BIT0", PairList []])
  let BIT1_tm_2 = Fusion.mk_const(["BIT1", PairList []])
  let NUMERAL_tm_2 = Fusion.mk_const(["NUMERAL", PairList []])
  fun stripzeros(l):
    match l
    | PairList [#false, & t]: stripzeros(t)
    | _: l
  fun raw_list_of_num(l):
    fun(n):
      if Host.hol_equal(n)(num_0_2)
      | stripzeros(l)
      | let h = Host.hol_int_of_num(Host.mod_num(n)(pow24_2))
        raw_list_of_num(PairList.cons(Host.hol_unequal(Host.hol_land(h)(8388608))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(4194304))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(2097152))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(1048576))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(524288))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(262144))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(131072))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(65536))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(32768))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(16384))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(8192))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(4096))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(2048))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(1024))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(512))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(256))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(128))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(64))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(32))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(16))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(8))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(4))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(2))(0), PairList.cons(Host.hol_unequal(Host.hol_land(h)(1))(0), l)))))))))))))))))))))))))(Host.quo_num(n)(pow24_2))
  fun numeral_of_list(t):
    fun(l):
      match l
      | PairList []: t
      | PairList [b, & r]: numeral_of_list(Fusion.mk_comb([(if b | BIT1_tm_2 | BIT0_tm_2), t]))(r)
  let mk_raw_numeral = (fun(n): numeral_of_list(zero_tm_2)(raw_list_of_num(PairList [])(n)))
  (fun(n): (if Host.hol_lt(n)(num_0_2) | failwith("mk_numeral: negative argument") | Fusion.mk_comb([NUMERAL_tm_2, mk_raw_numeral(n)])))

fun mk_small_numeral(n): mk_numeral(Host.num(n))

fun dest_small_numeral(t): Host.hol_int_of_num(Basics.dest_numeral(t))

def is_numeral = can(Basics.dest_numeral)

def the_specifications = Box(PairList [])

def new_specification:
  let code = (fun(c): mk_small_numeral(Host.hol_char_code(Host.hol_string_get(c)(0))))
  let mk_code = (fun(name): end_itlist(curry(HolPair.mk_pair))(map(code)(explode(name))))
  let check_distinct:
    fun(l):
      try:
        itlist((fun(t): (fun(res): (if mem(t)(res) | Host.hol_apply_unit(fail) | PairList.cons(t, res)))))(l)(PairList [])
        #true
        ~catch exn:
          match exn
          | Failure(_): #false
          | exn: Host.hol_raise(exn)
  let specify:
    fun(name):
      fun(th):
        let ntm = mk_code(name)
        let gv = Basics.genvar(Fusion.type_of(ntm))
        let th0 = Equal.CONV_RULE(Simp.REWR_CONV(Class.SKOLEM_THM))(Bool.GEN(gv)(th))
        let th1 = Equal.CONV_RULE(Equal.THENC(Equal.RATOR_CONV(Simp.REWR_CONV(Class.EXISTS_THM)))(Equal.BETA_CONV))(th0)
        let [l, r] = Fusion.dest_comb(Fusion.concl(th1))
        let rn = Fusion.mk_comb([r, ntm])
        let ty = Fusion.type_of(rn)
        let th2 = HolPair.new_definition(Fusion.mk_eq([Fusion.mk_var([name, ty]), rn]))
        Simp.GEN_REWRITE_RULE(Equal.ONCE_DEPTH_CONV)(PairList.cons(Equal.GSYM(th2), PairList []))(Bool.SPEC(ntm)(Equal.CONV_RULE(Equal.BETA_CONV)(th1)))
  fun specifies(names):
    fun(th):
      match names
      | PairList []: th
      | PairList [name, & onames]:
          let th_prime = specify(name)(th)
          specifies(onames)(th_prime)
  fun(names):
    fun(th):
      let [asl, c] = Fusion.dest_thm(th)
      if Host.hol_not(Host.hol_equal(asl)(PairList []))
      | failwith("new_specification: Assumptions not allowed in theorem")
      | if Host.hol_not(Host.hol_equal(Fusion.frees(c))(PairList []))
        | failwith(Host.hol_concat("new_specification: Free variables in predicate: ")(Host.hol_string_concat(", ")(map((fun(Fusion.Var(name,_)): name))(Fusion.frees(c)))))
        | let avs = fst(Basics.strip_exists(c))
          if (Host.hol_equal(length(names))(0) || Host.hol_gt(length(names))(length(avs)))
          | failwith("new_specification: Unsuitable number of constant names")
          | if Host.hol_not(check_distinct(names))
            | failwith("new_specification: Constant names not distinct")
            | try:
                let sth = snd(find((fun([[names_prime, th_prime], sth_prime]): (Host.hol_equal(names_prime)(names) && Fusion.aconv(Fusion.concl(th_prime))(Fusion.concl(th)))))(Host.ref_get(the_specifications)))
                Host.warn(#true)("Benign respecification")
                sth
                ~catch exn:
                  match exn
                  | Failure(_):
                      let sth = specifies(names)(th)
                      Host.ref_set(the_specifications)(PairList.cons([[names, th], sth], Host.ref_get(the_specifications)))
                      sth
                  | exn: Host.hol_raise(exn)

def NOT_SUC = nums_NOT_SUC_v2

def num_INDUCTION = nums_num_INDUCTION_v2

def num_Axiom = nums_num_Axiom_v2
