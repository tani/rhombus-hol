new_type(["ind", 0])

def ONE_ONE:
  new_definition(
    hol_term(Iff(
      App(Var("ONE_ONE", Fun(Fun(Tvar("A"), Tvar("B")), Bool)), [Var("f", Fun(Tvar("A"), Tvar("B")))]),
      Forall(
        "x1",
        Tvar("A"),
        Forall(
          "x2",
          Tvar("A"),
          Implies(
            Eq(
              Tvar("B"),
              App(Var("f", Fun(Tvar("A"), Tvar("B"))), [Ref("x1")]),
              App(Var("f", Fun(Tvar("A"), Tvar("B"))), [Ref("x2")])
            ),
            Eq(Tvar("A"), Ref("x1"), Ref("x2"))
          )
        )
      )
    ))
  )

def ONTO:
  new_definition(
    hol_term(Iff(
      App(Var("ONTO", Fun(Fun(Tvar("A"), Tvar("B")), Bool)), [Var("f", Fun(Tvar("A"), Tvar("B")))]),
      Forall(
        "y",
        Tvar("B"),
        Exists(
          "x",
          Tvar("A"),
          Eq(Tvar("B"), Ref("y"), App(Var("f", Fun(Tvar("A"), Tvar("B"))), [Ref("x")]))
        )
      )
    ))
  )

def INFINITY_AX:
  new_axiom(
    hol_term(Exists(
      "f",
      Fun(Tyapp("ind", []), Tyapp("ind", [])),
      And(
        App(Const("ONE_ONE", Fun(Fun(Tyapp("ind", []), Tyapp("ind", [])), Bool)), [Ref("f")]),
        Not(App(Const("ONTO", Fun(Fun(Tyapp("ind", []), Tyapp("ind", [])), Bool)), [Ref("f")]))
      )
    ))
  )

def IND_SUC_0_EXISTS:
  prove(
    [
      hol_term(Exists(
        "f",
        Fun(Tyapp("ind", []), Tyapp("ind", [])),
        Exists(
          "z",
          Tyapp("ind", []),
          And(
            Forall(
              "x1",
              Tyapp("ind", []),
              Forall(
                "x2",
                Tyapp("ind", []),
                Iff(
                  Eq(Tyapp("ind", []), App(Ref("f"), [Ref("x1")]), App(Ref("f"), [Ref("x2")])),
                  Eq(Tyapp("ind", []), Ref("x1"), Ref("x2"))
                )
              )
            ),
            Forall("x", Tyapp("ind", []), Not(Eq(Tyapp("ind", []), App(Ref("f"), [Ref("x")]), Ref("z"))))
          )
        )
      )),
      (
        (
          (
            (
              X_CHOOSE_TAC(hol_term(Var("f", Fun(Tyapp("ind", []), Tyapp("ind", [])))))(INFINITY_AX) then_tac \
              EXISTS_TAC(hol_term(Var("f", Fun(Tyapp("ind", []), Tyapp("ind", [])))))
            ) then_tac \
            POP_ASSUM(MP_TAC)
          ) then_tac \
          REWRITE_TAC(PairList [ONE_ONE, ONTO])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def IND_SUC_SPEC:
  let th1:
    new_definition(
      hol_term(Eq(
        Fun(Tyapp("ind", []), Tyapp("ind", [])),
        Var("IND_SUC", Fun(Tyapp("ind", []), Tyapp("ind", []))),
        App(
          Const(
            "@",
            Fun(Fun(Fun(Tyapp("ind", []), Tyapp("ind", [])), Bool), Fun(Tyapp("ind", []), Tyapp("ind", [])))
          ),
          [
            Lambda(
              "f",
              Fun(Tyapp("ind", []), Tyapp("ind", [])),
              Exists(
                "z",
                Tyapp("ind", []),
                And(
                  Forall(
                    "x1",
                    Tyapp("ind", []),
                    Forall(
                      "x2",
                      Tyapp("ind", []),
                      Iff(
                        Eq(Tyapp("ind", []), App(Ref("f"), [Ref("x1")]), App(Ref("f"), [Ref("x2")])),
                        Eq(Tyapp("ind", []), Ref("x1"), Ref("x2"))
                      )
                    )
                  ),
                  Forall("x", Tyapp("ind", []), Not(Eq(Tyapp("ind", []), App(Ref("f"), [Ref("x")]), Ref("z"))))
                )
              )
            )
          ]
        )
      ))
    )
  let th2 = REWRITE_RULE(PairList [GSYM(th1)])(SELECT_RULE(IND_SUC_0_EXISTS))
  let th3:
    new_definition(
      hol_term(Eq(
        Tyapp("ind", []),
        Var("IND_0", Tyapp("ind", [])),
        App(
          Const("@", Fun(Fun(Tyapp("ind", []), Bool), Tyapp("ind", []))),
          [
            Lambda(
              "z",
              Tyapp("ind", []),
              And(
                Forall(
                  "x1",
                  Tyapp("ind", []),
                  Forall(
                    "x2",
                    Tyapp("ind", []),
                    Iff(
                      Eq(
                        Tyapp("ind", []),
                        App(Const("IND_SUC", Fun(Tyapp("ind", []), Tyapp("ind", []))), [Ref("x1")]),
                        App(Const("IND_SUC", Fun(Tyapp("ind", []), Tyapp("ind", []))), [Ref("x2")])
                      ),
                      Eq(Tyapp("ind", []), Ref("x1"), Ref("x2"))
                    )
                  )
                ),
                Forall(
                  "x",
                  Tyapp("ind", []),
                  Not(
                    Eq(
                      Tyapp("ind", []),
                      App(Const("IND_SUC", Fun(Tyapp("ind", []), Tyapp("ind", []))), [Ref("x")]),
                      Ref("z")
                    )
                  )
                )
              )
            )
          ]
        )
      ))
    )
  REWRITE_RULE(PairList [GSYM(th3)])(SELECT_RULE(th2))

def [nums_IND_SUC_INJ_v2, IND_SUC_0] = CONJ_PAIR(IND_SUC_SPEC)

def [nums_NUM_REP_RULES_v2, nums_NUM_REP_INDUCT_v2, NUM_REP_CASES]:
  new_inductive_definition(
    hol_term(And(
      App(Var("NUM_REP", Fun(Tyapp("ind", []), Bool)), [Const("IND_0", Tyapp("ind", []))]),
      Forall(
        "i",
        Tyapp("ind", []),
        Implies(
          App(Var("NUM_REP", Fun(Tyapp("ind", []), Bool)), [Ref("i")]),
          App(
            Var("NUM_REP", Fun(Tyapp("ind", []), Bool)),
            [App(Const("IND_SUC", Fun(Tyapp("ind", []), Tyapp("ind", []))), [Ref("i")])]
          )
        )
      )
    ))
  )

def num_tydef = new_basic_type_definition("num")(["mk_num", "dest_num"])(CONJUNCT1(nums_NUM_REP_RULES_v2))

def ZERO_DEF:
  new_definition(
    hol_term(Eq(
      Num,
      Var("_0", Num),
      App(Const("mk_num", Fun(Tyapp("ind", []), Num)), [Const("IND_0", Tyapp("ind", []))])
    ))
  )

def SUC_DEF:
  new_definition(
    hol_term(Eq(
      Num,
      App(Var("SUC", Fun(Num, Num)), [Var("n", Num)]),
      App(
        Const("mk_num", Fun(Tyapp("ind", []), Num)),
        [
          App(
            Const("IND_SUC", Fun(Tyapp("ind", []), Tyapp("ind", []))),
            [App(Const("dest_num", Fun(Num, Tyapp("ind", []))), [Var("n", Num)])]
          )
        ]
      )
    ))
  )

def nums_NOT_SUC:
  prove(
    [
      hol_term(Forall("n", Num, Not(Eq(Num, App(Const("SUC", Fun(Num, Num)), [Ref("n")]), Const("_0", Num))))),
      (
        REWRITE_TAC(PairList [SUC_DEF, ZERO_DEF]) then_tac \
        MESON_TAC(PairList [nums_NUM_REP_RULES_v2, fst(num_tydef), snd(num_tydef), IND_SUC_0])
      )
    ]
  )

def SUC_INJ:
  prove(
    [
      hol_term(Forall(
        "m",
        Num,
        Forall(
          "n",
          Num,
          Iff(
            Eq(
              Num,
              App(Const("SUC", Fun(Num, Num)), [Ref("m")]),
              App(Const("SUC", Fun(Num, Num)), [Ref("n")])
            ),
            Eq(Num, Ref("m"), Ref("n"))
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [SUC_DEF])) then_tac \
                            EQ_TAC
                          ) then_tac \
                          DISCH_TAC
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [])
                      ) then_tac \
                      POP_ASSUM(o(MP_TAC)(AP_TERM(hol_term(Const("dest_num", Fun(Num, Tyapp("ind", [])))))))
                    ) then_tac \
                    SUBGOAL_THEN(
                      hol_term(Forall(
                        "p",
                        Num,
                        App(
                          Const("NUM_REP", Fun(Tyapp("ind", []), Bool)),
                          [
                            App(
                              Const("IND_SUC", Fun(Tyapp("ind", []), Tyapp("ind", []))),
                              [App(Const("dest_num", Fun(Num, Tyapp("ind", []))), [Ref("p")])]
                            )
                          ]
                        )
                      ))
                    )(MP_TAC)
                  ) then_list \
                  PairList [
                    (GEN_TAC then_tac MATCH_MP_TAC(CONJUNCT2(nums_NUM_REP_RULES_v2))),
                    ALL_TAC
                  ]
                ) then_tac \
                REWRITE_TAC(PairList [fst(num_tydef), snd(num_tydef)])
              ) then_tac \
              DISCH_TAC
            ) then_tac \
            ASM_REWRITE_TAC(PairList [nums_IND_SUC_INJ_v2])
          ) then_tac \
          DISCH_THEN(o(MP_TAC)(AP_TERM(hol_term(Const("mk_num", Fun(Tyapp("ind", []), Num))))))
        ) then_tac \
        REWRITE_TAC(PairList [fst(num_tydef)])
      )
    ]
  )

def nums_num_INDUCTION:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Num, Bool),
        Implies(
          And(
            App(Ref("P"), [Const("_0", Num)]),
            Forall(
              "n",
              Num,
              Implies(
                App(Ref("P"), [Ref("n")]),
                App(Ref("P"), [App(Const("SUC", Fun(Num, Num)), [Ref("n")])])
              )
            )
          ),
          Forall("n", Num, App(Ref("P"), [Ref("n")]))
        )
      )),
      (
        (
          (
            (
              REPEAT(STRIP_TAC) then_tac \
              MP_TAC(
                SPEC(
                  hol_term(Lambda(
                    "i",
                    Tyapp("ind", []),
                    And(
                      App(Const("NUM_REP", Fun(Tyapp("ind", []), Bool)), [Ref("i")]),
                      App(Var("P", Fun(Num, Bool)), [App(Const("mk_num", Fun(Tyapp("ind", []), Num)), [Ref("i")])])
                    )
                  ))
                )(nums_NUM_REP_INDUCT_v2)
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [GSYM(ZERO_DEF), nums_NUM_REP_RULES_v2])
          ) then_tac \
          W(
            o(
              o(C(SUBGOAL_THEN)((fun(t): REWRITE_TAC(PairList [t]))))(funpow(2)(lhand))
            )(snd)
          )
        ) then_list \
        PairList [
          (
            REPEAT(STRIP_TAC) then_list \
            PairList [
              (
                MATCH_MP_TAC(CONJUNCT2(nums_NUM_REP_RULES_v2)) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ),
              (
                SUBGOAL_THEN(
                  hol_term(Eq(
                    Num,
                    App(
                      Const("mk_num", Fun(Tyapp("ind", []), Num)),
                      [App(Const("IND_SUC", Fun(Tyapp("ind", []), Tyapp("ind", []))), [Var("i", Tyapp("ind", []))])]
                    ),
                    App(
                      Const("SUC", Fun(Num, Num)),
                      [App(Const("mk_num", Fun(Tyapp("ind", []), Num)), [Var("i", Tyapp("ind", []))])]
                    )
                  ))
                )(SUBST1_TAC) then_list \
                PairList [
                  (
                    (
                      (
                        (REWRITE_TAC(PairList [SUC_DEF]) then_tac REPEAT(AP_TERM_TAC)) then_tac \
                        CONV_TAC(SYM_CONV)
                      ) then_tac \
                      REWRITE_TAC(PairList [GSYM(snd(num_tydef))])
                    ) then_tac \
                    FIRST_ASSUM(MATCH_ACCEPT_TAC)
                  ),
                  (FIRST_ASSUM(MATCH_MP_TAC) then_tac FIRST_ASSUM(MATCH_ACCEPT_TAC))
                ]
              )
            ]
          ),
          (
            DISCH_THEN(
              o(MP_TAC)(SPEC(hol_term(App(Const("dest_num", Fun(Num, Tyapp("ind", []))), [Var("n", Num)]))))
            ) then_tac \
            REWRITE_TAC(PairList [fst(num_tydef), snd(num_tydef)])
          )
        ]
      )
    ]
  )

def nums_num_Axiom:
  prove(
    [
      hol_term(Forall(
        "e",
        Tvar("A"),
        Forall(
          "f",
          Fun(Tvar("A"), Fun(Num, Tvar("A"))),
          ExistsUnique(
            "fn",
            Fun(Num, Tvar("A")),
            And(
              Eq(Tvar("A"), App(Ref("fn"), [Const("_0", Num)]), Ref("e")),
              Forall(
                "n",
                Num,
                Eq(
                  Tvar("A"),
                  App(Ref("fn"), [App(Const("SUC", Fun(Num, Num)), [Ref("n")])]),
                  App(Ref("f"), [App(Ref("fn"), [Ref("n")]), Ref("n")])
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            REPEAT(GEN_TAC) then_tac \
            ONCE_REWRITE_TAC(PairList [EXISTS_UNIQUE_THM])
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (
                  o(MP_TAC)(prove_inductive_relations_exist)(
                    hol_term(And(
                      App(Var("PRG", Fun(Num, Fun(Tvar("A"), Bool))), [Const("_0", Num), Var("e", Tvar("A"))]),
                      Forall(
                        "b",
                        Tvar("A"),
                        Forall(
                          "n",
                          Num,
                          Implies(
                            App(Var("PRG", Fun(Num, Fun(Tvar("A"), Bool))), [Ref("n"), Ref("b")]),
                            App(
                              Var("PRG", Fun(Num, Fun(Tvar("A"), Bool))),
                              [
                                App(Const("SUC", Fun(Num, Num)), [Ref("n")]),
                                App(Var("f", Fun(Tvar("A"), Fun(Num, Tvar("A")))), [Ref("b"), Ref("n")])
                              ]
                            )
                          )
                        )
                      )
                    ))
                  ) then_tac \
                  DISCH_THEN(CHOOSE_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC)))
                ) then_tac \
                DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(o(ASSUME_TAC)(GSYM)))
              ) then_tac \
              SUBGOAL_THEN(
                hol_term(Forall(
                  "n",
                  Num,
                  ExistsUnique(
                    "y",
                    Tvar("A"),
                    App(Var("PRG", Fun(Num, Fun(Tvar("A"), Bool))), [Ref("n"), Ref("y")])
                  )
                ))
              )(MP_TAC)
            ) then_list \
            PairList [
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (MATCH_MP_TAC(nums_num_INDUCTION) then_tac REPEAT(STRIP_TAC)) then_tac \
                                  FIRST_ASSUM((fun(th): GEN_REWRITE_TAC(BINDER_CONV)(PairList [GSYM(th)])))
                                ) then_tac \
                                REWRITE_TAC(PairList [GSYM(nums_NOT_SUC), nums_NOT_SUC, SUC_INJ, EXISTS_UNIQUE_REFL])
                              ) then_tac \
                              REWRITE_TAC(PairList [UNWIND_THM1])
                            ) then_tac \
                            UNDISCH_TAC(
                              hol_term(ExistsUnique(
                                "y",
                                Tvar("A"),
                                App(Var("PRG", Fun(Num, Fun(Tvar("A"), Bool))), [Var("n", Num), Ref("y")])
                              ))
                            )
                          ) then_tac \
                          REWRITE_TAC(PairList [EXISTS_UNIQUE_THM])
                        ) then_tac \
                        DISCH_THEN(
                          CONJUNCTS_THEN2(X_CHOOSE_TAC(hol_term(Var("y", Tvar("A")))))(ASSUME_TAC)
                        )
                      ) then_tac \
                      REPEAT(STRIP_TAC)
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_list \
                  PairList [
                    MAP_EVERY(EXISTS_TAC)(
                      PairList [
                        hol_term(App(Var("f", Fun(Tvar("A"), Fun(Num, Tvar("A")))), [Var("y", Tvar("A")), Var("n", Num)])),
                        hol_term(Var("y", Tvar("A")))
                      ]
                    ),
                    (
                      (AP_THM_TAC then_tac AP_TERM_TAC) then_tac \
                      FIRST_ASSUM(MATCH_MP_TAC)
                    )
                  ]
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ),
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REWRITE_TAC(PairList [UNIQUE_SKOLEM_ALT]) then_tac \
                            DISCH_THEN(
                              X_CHOOSE_THEN(hol_term(Var("fn", Fun(Num, Tvar("A")))))(o(ASSUME_TAC)(GSYM))
                            )
                          ) then_tac \
                          EXISTS_TAC(hol_term(Var("fn", Fun(Num, Tvar("A")))))
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [])
                      ) then_tac \
                      GEN_TAC
                    ) then_tac \
                    FIRST_ASSUM(o(MATCH_MP_TAC)(CONJUNCT2))
                  ) then_tac \
                  FIRST_ASSUM((fun(th): GEN_REWRITE_TAC(I)(PairList [GSYM(th)])))
                ) then_tac \
                REFL_TAC
              )
            ]
          ),
          (
            (
              (
                (
                  (REPEAT(STRIP_TAC) then_tac ONCE_REWRITE_TAC(PairList [FUN_EQ_THM])) then_tac \
                  MATCH_MP_TAC(nums_num_INDUCTION)
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          )
        ]
      )
    ]
  )

def NUMERAL:
  let num_ty = type_of(lhand(concl(ZERO_DEF)))
  let funn_ty = mk_fun_ty(num_ty)(num_ty)
  let numeral_tm = mk_var(["NUMERAL", funn_ty])
  let n_tm = mk_var(["n", num_ty])
  new_definition(mk_eq([mk_comb([numeral_tm, n_tm]), n_tm]))

def PairList [nums_NOT_SUC_v3, & PairList [nums_num_INDUCTION_v3, & PairList [nums_num_Axiom_v2, & PairList []]]]:
  let th:
    prove(
      [
        hol_term(Eq(Num, Const("_0", Num), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]))),
        REWRITE_TAC(PairList [NUMERAL])
      ]
    )
  map(GEN_REWRITE_RULE(DEPTH_CONV)(PairList [th]))(PairList [nums_NOT_SUC, nums_num_INDUCTION, nums_num_Axiom])

def INDUCT_TAC:
  (
    (MATCH_MP_TAC(nums_num_INDUCTION_v3) then_tac CONJ_TAC) then_list \
    PairList [ALL_TAC, (GEN_TAC then_tac DISCH_TAC)]
  )

def num_RECURSION:
  let avs = fst(strip_forall(concl(nums_num_Axiom_v2)))
  GENL(avs)(EXISTENCE(SPECL(avs)(nums_num_Axiom_v2)))

def num_CASES:
  prove(
    [
      hol_term(Forall(
        "m",
        Num,
        Or(
          Eq(Num, Ref("m"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])),
          Exists("n", Num, Eq(Num, Ref("m"), App(Const("SUC", Fun(Num, Num)), [Ref("n")])))
        )
      )),
      (INDUCT_TAC then_tac MESON_TAC(PairList []))
    ]
  )

def initialization_1:
  (inductive_type_store.value := (PairList [
      ["num", [2, nums_num_INDUCTION_v3, num_RECURSION]],
      & inductive_type_store.value
    ]))

def BIT0_DEF:
  let funn_ty = type_of(rator(lhand(snd(dest_forall(concl(NUMERAL))))))
  let bit0_tm = mk_var(["BIT0", funn_ty])
  let hol_def_2:
    new_definition(
      mk_eq(
        [
          bit0_tm,
          hol_term(App(
            Const("@", Fun(Fun(Fun(Num, Num), Bool), Fun(Num, Num))),
            [
              Lambda(
                "fn",
                Fun(Num, Num),
                And(
                  Eq(
                    Num,
                    App(Ref("fn"), [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]),
                    App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])
                  ),
                  Forall(
                    "n",
                    Num,
                    Eq(
                      Num,
                      App(Ref("fn"), [App(Const("SUC", Fun(Num, Num)), [Ref("n")])]),
                      App(
                        Const("SUC", Fun(Num, Num)),
                        [App(Const("SUC", Fun(Num, Num)), [App(Ref("fn"), [Ref("n")])])]
                      )
                    )
                  )
                )
              )
            ]
          ))
        ]
      )
    )
  let th_2:
    BETA_RULE(
      ISPECL(
        PairList [
          hol_term(App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])),
          hol_term(Lambda(
            "m",
            Num,
            Lambda(
              "n",
              Num,
              App(Const("SUC", Fun(Num, Num)), [App(Const("SUC", Fun(Num, Num)), [Ref("m")])])
            )
          ))
        ])(
        num_RECURSION
      )
    )
  REWRITE_RULE(PairList [GSYM(hol_def_2)])(SELECT_RULE(th_2))

def BIT1_DEF:
  let funn_ty = type_of(rator(lhand(lhand(concl(BIT0_DEF)))))
  let num_ty = snd(dest_fun_ty(funn_ty))
  let n_tm = mk_var(["n", num_ty])
  let bit1_tm = mk_var(["BIT1", funn_ty])
  new_definition(
    mk_eq(
      [
        mk_comb([bit1_tm, n_tm]),
        hol_term(App(Const("SUC", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [Var("n", Num)])]))
      ]
    )
  )

def mk_numeral:
  let pow24_2 = pow2(24)
  let num_0_2 = Host.num(0)
  let zero_tm_2 = mk_const(["_0", PairList []])
  let BIT0_tm_2 = mk_const(["BIT0", PairList []])
  let BIT1_tm_2 = mk_const(["BIT1", PairList []])
  let NUMERAL_tm_2 = mk_const(["NUMERAL", PairList []])
  fun stripzeros(l):
    match l
    | PairList [#false, & t]: stripzeros(t)
    | _: l
  // Recursive calls need the local definition before its first use.
  fun raw_list_of_num(l):
    fun(n):
      if (n == num_0_2)
      | stripzeros(l)
      | let h = Host.hol_int_of_num(Host.mod_num(n)(pow24_2))
        raw_list_of_num(
          PairList [
            ((h bits.and 8388608) != 0),
            ((h bits.and 4194304) != 0),
            ((h bits.and 2097152) != 0),
            ((h bits.and 1048576) != 0),
            ((h bits.and 524288) != 0),
            ((h bits.and 262144) != 0),
            ((h bits.and 131072) != 0),
            ((h bits.and 65536) != 0),
            ((h bits.and 32768) != 0),
            ((h bits.and 16384) != 0),
            ((h bits.and 8192) != 0),
            ((h bits.and 4096) != 0),
            ((h bits.and 2048) != 0),
            ((h bits.and 1024) != 0),
            ((h bits.and 512) != 0),
            ((h bits.and 256) != 0),
            ((h bits.and 128) != 0),
            ((h bits.and 64) != 0),
            ((h bits.and 32) != 0),
            ((h bits.and 16) != 0),
            ((h bits.and 8) != 0),
            ((h bits.and 4) != 0),
            ((h bits.and 2) != 0),
            ((h bits.and 1) != 0),
            & l
          ]
        )(Host.quo_num(n)(pow24_2))
  // Recursive calls need the local definition before its first use.
  fun numeral_of_list(t):
    fun(l):
      match l
      | PairList []: t
      | PairList [b, & r]: numeral_of_list(mk_comb([(if b | BIT1_tm_2 | BIT0_tm_2), t]))(r)
  let mk_raw_numeral = (fun(n): numeral_of_list(zero_tm_2)(raw_list_of_num(PairList [])(n)))
  (fun(n): (if (n < num_0_2) | failwith("mk_numeral: negative argument") | mk_comb([NUMERAL_tm_2, mk_raw_numeral(n)])))

fun mk_small_numeral(n): mk_numeral(Host.num(n))

fun dest_small_numeral(t): Host.hol_int_of_num(dest_numeral(t))

def is_numeral = can(dest_numeral)

def the_specifications = Box(PairList [])

def new_specification:
  let code = (fun(c): mk_small_numeral(Host.hol_char_code(Host.hol_string_get(c)(0))))
  let mk_code = (fun(name): end_itlist(curry(mk_pair))(map(code)(explode(name))))
  let check_distinct:
    fun(l):
      try:
        itlist(fun(t): fun(res): (if mem(t)(res) | fail() | PairList [t, & res]))(l)(PairList [])
        #true
        ~catch exn:
          match exn
          | Failure(_): #false
          | exn: (throw exn)
  let specify:
    fun(name):
      fun(th):
        let ntm = mk_code(name)
        let gv = genvar(type_of(ntm))
        let th0 = CONV_RULE(REWR_CONV(SKOLEM_THM))(GEN(gv)(th))
        let th1 = CONV_RULE((RATOR_CONV(REWR_CONV(EXISTS_THM)) then_conv BETA_CONV))(th0)
        let [l, r] = dest_comb(concl(th1))
        let rn = mk_comb([r, ntm])
        let ty = type_of(rn)
        let th2 = new_definition(mk_eq([mk_var([name, ty]), rn]))
        GEN_REWRITE_RULE(ONCE_DEPTH_CONV)(PairList [GSYM(th2)])(SPEC(ntm)(CONV_RULE(BETA_CONV)(th1)))
  // Recursive calls need the local definition before its first use.
  fun specifies(names):
    fun(th):
      match names
      | PairList []: th
      | PairList [name, & onames]:
          let th_prime = specify(name)(th)
          specifies(onames)(th_prime)
  fun(names):
    fun(th):
      let [asl, c] = dest_thm(th)
      if !(asl == (PairList []))
      | failwith("new_specification: Assumptions not allowed in theorem")
      | if !(frees(c) == (PairList []))
        | failwith(
            ("new_specification: Free variables in predicate: " +& Host.hol_string_concat(", ")(map((fun(Var(name,_)): name))(frees(c))))
          )
        | let avs = fst(strip_exists(c))
          if ((length(names) == 0) || (length(names) > length(avs)))
          | failwith("new_specification: Unsuitable number of constant names")
          | if !check_distinct(names)
            | failwith("new_specification: Constant names not distinct")
            | try:
                let sth:
                  snd(
                    find(
                      (fun([[names_prime, th_prime], sth_prime]): ((names_prime == names) && aconv(concl(th_prime))(concl(th))))
                    )(the_specifications.value)
                  )
                warn(#true)("Benign respecification")
                sth
                ~catch exn:
                  match exn
                  | Failure(_):
                      let sth = specifies(names)(th)
                      the_specifications.value := PairList [[[names, th], sth], & the_specifications.value]
                      sth
                  | exn: (throw exn)

def IND_SUC_INJ = nums_IND_SUC_INJ_v2

def NUM_REP_RULES = nums_NUM_REP_RULES_v2

def NUM_REP_INDUCT = nums_NUM_REP_INDUCT_v2

def NOT_SUC = nums_NOT_SUC_v3

def num_INDUCTION = nums_num_INDUCTION_v3

def num_Axiom = nums_num_Axiom_v2
