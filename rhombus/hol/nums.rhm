new_type(["ind", 0])

def ONE_ONE:
  new_definition(
    (hol:
       var ONE_ONE :: (A -> B) -> bool
       var f :: A -> B
       ONE_ONE(f) <=> (forall (x1 :: A, x2 :: A): f(x1) == f(x2) ==> x1 == x2))
  )

def ONTO:
  new_definition(
    (hol:
       var ONTO :: (A -> B) -> bool
       var f :: A -> B
       ONTO(f) <=> (forall y :: B: exists x :: A: y == f(x)))
  )

def INFINITY_AX:
  new_axiom(
    (hol:
       const ONE_ONE :: (ind -> ind) -> bool
       const ONTO :: (ind -> ind) -> bool
       exists f :: ind -> ind: ONE_ONE(f) && !ONTO(f))
  )

def IND_SUC_0_EXISTS:
  prove(
    [
      (hol:
         exists (f :: ind -> ind, z :: ind):
           (forall (x1 :: ind, x2 :: ind): f(x1) == f(x2) <=> x1 == x2) && (forall x :: ind: f(x) != z)),
      (
        (
          (
            (
              X_CHOOSE_TAC(hol:
                             var f :: ind -> ind
                             f)(INFINITY_AX) then_tac \
              EXISTS_TAC(hol:
                           var f :: ind -> ind
                           f)
            ) then_tac \
            POP_ASSUM(MP_TAC)
          ) then_tac \
          REWRITE_TAC(PairList [ONE_ONE, ONTO])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def IND_SUC_SPEC:
  let th1:
    new_definition(
      (hol:
         var IND_SUC :: ind -> ind
         const select as "@" :: ((ind -> ind) -> bool) -> ind -> ind
         IND_SUC
           == select(
                fun (f :: ind -> ind):
                  exists z :: ind:
                    (forall (x1 :: ind, x2 :: ind): f(x1) == f(x2) <=> x1 == x2)
                      && (forall x :: ind: f(x) != z)
              ))
    )
  let th2 = REWRITE_RULE(PairList [GSYM(th1)])(SELECT_RULE(IND_SUC_0_EXISTS))
  let th3:
    new_definition(
      (hol:
         var IND_0 :: ind
         const select as "@" :: (ind -> bool) -> ind
         const IND_SUC :: ind -> ind
         IND_0
           == select(
                fun (z :: ind):
                  (forall (x1 :: ind, x2 :: ind): IND_SUC(x1) == IND_SUC(x2) <=> x1 == x2)
                    && (forall x :: ind: IND_SUC(x) != z)
              ))
    )
  REWRITE_RULE(PairList [GSYM(th3)])(SELECT_RULE(th2))

def [nums_IND_SUC_INJ_v2, IND_SUC_0] = CONJ_PAIR(IND_SUC_SPEC)

