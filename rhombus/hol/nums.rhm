def nums_num_Axiom:
  prove(
    [
      (hol:
         const _0 :: num
         const SUC :: num -> num
         forall (e :: A, f :: A -> num -> A):
           exists1 fn :: num -> A: fn(_0) == e && (forall n :: num: fn(SUC(n)) == f(fn(n), n))),
      (
        (
          (
            REPEAT(GEN_TAC) then_tac \
            ONCE_REWRITE_TAC(PairList [EXISTS_UNIQUE_THM])
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (
                  o(MP_TAC)(prove_inductive_relations_exist)(
                    (hol:
                       var PRG :: num -> A -> bool
                       var e :: A
                       var f :: A -> num -> A
                       const _0 :: num
                       const SUC :: num -> num
                       PRG(_0, e) && (forall (b :: A, n :: num): PRG(n, b) ==> PRG(SUC(n), f(b, n))))
                  ) then_tac \
                  DISCH_THEN(CHOOSE_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC)))
                ) then_tac \
                DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(o(ASSUME_TAC)(GSYM)))
              ) then_tac \
              SUBGOAL_THEN(
                (hol:
                   var PRG :: num -> A -> bool
                   forall n :: num: exists1 y :: A: PRG(n, y))
              )(MP_TAC)
            ) then_list \
            PairList [
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (MATCH_MP_TAC(nums_num_INDUCTION) then_tac REPEAT(STRIP_TAC)) then_tac \
                                  FIRST_ASSUM((fun(th): GEN_REWRITE_TAC(BINDER_CONV)(PairList [GSYM(th)])))
                                ) then_tac \
                                REWRITE_TAC(PairList [GSYM(nums_NOT_SUC), nums_NOT_SUC, SUC_INJ, EXISTS_UNIQUE_REFL])
                              ) then_tac \
                              REWRITE_TAC(PairList [UNWIND_THM1])
                            ) then_tac \
                            UNDISCH_TAC(
                              (hol:
                                 var PRG :: num -> A -> bool
                                 var n :: num
                                 exists1 y :: A: PRG(n, y))
                            )
                          ) then_tac \
                          REWRITE_TAC(PairList [EXISTS_UNIQUE_THM])
                        ) then_tac \
                        DISCH_THEN(
                          CONJUNCTS_THEN2(X_CHOOSE_TAC(hol:
                                                         var y :: A
                                                         y))(ASSUME_TAC)
                        )
                      ) then_tac \
                      REPEAT(STRIP_TAC)
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_list \
                  PairList [
                    MAP_EVERY(EXISTS_TAC)(
                      PairList [
                        (hol:
                           var f :: A -> num -> A
                           var y :: A
                           var n :: num
                           f(y, n)),
                        (hol:
                           var y :: A
                           y)
                      ]
                    ),
                    (
                      (AP_THM_TAC then_tac AP_TERM_TAC) then_tac \
                      FIRST_ASSUM(MATCH_MP_TAC)
                    )
                  ]
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ),
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REWRITE_TAC(PairList [UNIQUE_SKOLEM_ALT]) then_tac \
                            DISCH_THEN(
                              X_CHOOSE_THEN(hol:
                                              var fn :: num -> A
                                              fn)(o(ASSUME_TAC)(GSYM))
                            )
                          ) then_tac \
                          EXISTS_TAC(hol:
                                       var fn :: num -> A
                                       fn)
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [])
                      ) then_tac \
                      GEN_TAC
                    ) then_tac \
                    FIRST_ASSUM(o(MATCH_MP_TAC)(CONJUNCT2))
                  ) then_tac \
                  FIRST_ASSUM((fun(th): GEN_REWRITE_TAC(I)(PairList [GSYM(th)])))
                ) then_tac \
                REFL_TAC
              )
            ]
          ),
          (
            (
              (
                (
                  (REPEAT(STRIP_TAC) then_tac ONCE_REWRITE_TAC(PairList [FUN_EQ_THM])) then_tac \
                  MATCH_MP_TAC(nums_num_INDUCTION)
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          )
        ]
      )
    ]
  )

def NUMERAL:
  let num_ty = type_of(lhand(concl(ZERO_DEF)))
  let funn_ty = mk_fun_ty(num_ty)(num_ty)
  let numeral_tm = mk_var(["NUMERAL", funn_ty])
  let n_tm = mk_var(["n", num_ty])
  new_definition(mk_eq([mk_comb([numeral_tm, n_tm]), n_tm]))

def PairList [nums_NOT_SUC_v3, & PairList [nums_num_INDUCTION_v3, & PairList [nums_num_Axiom_v2, & PairList []]]]:
  let th:
    prove(
      [
        (hol:
           const _0 :: num
           _0 == (0 :: num)),
        REWRITE_TAC(PairList [NUMERAL])
      ]
    )
  map(GEN_REWRITE_RULE(DEPTH_CONV)(PairList [th]))(PairList [nums_NOT_SUC, nums_num_INDUCTION, nums_num_Axiom])

def INDUCT_TAC:
  (
    (MATCH_MP_TAC(nums_num_INDUCTION_v3) then_tac CONJ_TAC) then_list \
    PairList [ALL_TAC, (GEN_TAC then_tac DISCH_TAC)]
  )

def num_RECURSION:
  let avs = fst(strip_forall(concl(nums_num_Axiom_v2)))
  GENL(avs)(EXISTENCE(SPECL(avs)(nums_num_Axiom_v2)))

def num_CASES:
  prove(
    [
      (hol:
         const SUC :: num -> num
         forall m :: num: m == (0 :: num) || (exists n :: num: m == SUC(n))),
      (INDUCT_TAC then_tac MESON_TAC(PairList []))
    ]
  )

def initialization_1:
  (inductive_type_store.value := (PairList [
      ["num", [2, nums_num_INDUCTION_v3, num_RECURSION]],
      & inductive_type_store.value
    ]))

def BIT0_DEF:
  let funn_ty = type_of(rator(lhand(snd(dest_forall(concl(NUMERAL))))))
  let bit0_tm = mk_var(["BIT0", funn_ty])
  let hol_def_2:
    new_definition(
      mk_eq(
        [
          bit0_tm,
          (hol:
             const select as "@" :: ((num -> num) -> bool) -> num -> num
             const SUC :: num -> num
             select(
               fun (fn :: num -> num):
                 fn((0 :: num)) == (0 :: num) && (forall n :: num: fn(SUC(n)) == SUC(SUC(fn(n))))
             ))
        ]
      )
    )
  let th_2:
    BETA_RULE(
      ISPECL(
        PairList [
          (hol:
             (0 :: num)),
          (hol:
             const SUC :: num -> num
             fun (m :: num, n :: num): SUC(SUC(m)))
        ])(
        num_RECURSION
      )
    )
  REWRITE_RULE(PairList [GSYM(hol_def_2)])(SELECT_RULE(th_2))

def BIT1_DEF:
  let funn_ty = type_of(rator(lhand(lhand(concl(BIT0_DEF)))))
  let num_ty = snd(dest_fun_ty(funn_ty))
  let n_tm = mk_var(["n", num_ty])
  let bit1_tm = mk_var(["BIT1", funn_ty])
  new_definition(
    mk_eq(
      [
        mk_comb([bit1_tm, n_tm]),
        (hol:
           var n :: num
           const SUC :: num -> num
           const BIT0 :: num -> num
           SUC(BIT0(n)))
      ]
    )
  )

def mk_numeral:
  let pow24_2 = pow2(24)
  let num_0_2 = 0
  let zero_tm_2 = mk_const(["_0", PairList []])
  let BIT0_tm_2 = mk_const(["BIT0", PairList []])
  let BIT1_tm_2 = mk_const(["BIT1", PairList []])
  let NUMERAL_tm_2 = mk_const(["NUMERAL", PairList []])
  fun stripzeros(l):
    match l
    | PairList [#false, & t]: stripzeros(t)
    | _: l
  // Recursive calls need the local definition before its first use.
  fun raw_list_of_num(l):
    fun(n):
      if (n == num_0_2)
      | stripzeros(l)
      | let h = hol_int_of_num(mod_num(n)(pow24_2))
        raw_list_of_num(
          PairList [
            ((h bits.and 8388608) != 0),
            ((h bits.and 4194304) != 0),
            ((h bits.and 2097152) != 0),
            ((h bits.and 1048576) != 0),
            ((h bits.and 524288) != 0),
            ((h bits.and 262144) != 0),
            ((h bits.and 131072) != 0),
            ((h bits.and 65536) != 0),
            ((h bits.and 32768) != 0),
            ((h bits.and 16384) != 0),
            ((h bits.and 8192) != 0),
            ((h bits.and 4096) != 0),
            ((h bits.and 2048) != 0),
            ((h bits.and 1024) != 0),
            ((h bits.and 512) != 0),
            ((h bits.and 256) != 0),
            ((h bits.and 128) != 0),
            ((h bits.and 64) != 0),
            ((h bits.and 32) != 0),
            ((h bits.and 16) != 0),
            ((h bits.and 8) != 0),
            ((h bits.and 4) != 0),
            ((h bits.and 2) != 0),
            ((h bits.and 1) != 0),
            & l
          ]
        )(quo_num(n)(pow24_2))
  // Recursive calls need the local definition before its first use.
  fun numeral_of_list(t):
    fun(l):
      match l
      | PairList []: t
      | PairList [b, & r]: numeral_of_list(mk_comb([(if b | BIT1_tm_2 | BIT0_tm_2), t]))(r)
  let mk_raw_numeral = (fun(n): numeral_of_list(zero_tm_2)(raw_list_of_num(PairList [])(n)))
  (fun(n): (if (n < num_0_2) | failwith("mk_numeral: negative argument") | mk_comb([NUMERAL_tm_2, mk_raw_numeral(n)])))

fun mk_small_numeral(n): mk_numeral(n)

fun dest_small_numeral(t): hol_int_of_num(dest_numeral(t))

def is_numeral = can(dest_numeral)

def the_specifications = Box(PairList [])

def new_specification:
  let code = (fun(c): mk_small_numeral(Char.to_int(to_string(c[0])[0])))
  let mk_code = (fun(name): end_itlist(curry(mk_pair))(map(code)(explode(name))))
  let check_distinct:
    fun(l):
      try:
        itlist(fun(t): fun(res): (if mem(t)(res) | fail() | PairList [t, & res]))(l)(PairList [])
        #true
        ~catch exn:
          match exn
          | Failure(_): #false
          | exn: (throw exn)
  let specify:
    fun(name):
      fun(th):
        let ntm = mk_code(name)
        let gv = genvar(type_of(ntm))
        let th0 = CONV_RULE(REWR_CONV(SKOLEM_THM))(GEN(gv)(th))
        let th1 = CONV_RULE((RATOR_CONV(REWR_CONV(EXISTS_THM)) then_conv BETA_CONV))(th0)
        let [l, r] = dest_comb(concl(th1))
        let rn = mk_comb([r, ntm])
        let ty = type_of(rn)
        let th2 = new_definition(mk_eq([mk_var([name, ty]), rn]))
        GEN_REWRITE_RULE(ONCE_DEPTH_CONV)(PairList [GSYM(th2)])(SPEC(ntm)(CONV_RULE(BETA_CONV)(th1)))
  // Recursive calls need the local definition before its first use.
  fun specifies(names):
    fun(th):
      match names
      | PairList []: th
      | PairList [name, & onames]:
          let th_prime = specify(name)(th)
          specifies(onames)(th_prime)
  fun(names):
    fun(th):
      let [asl, c] = dest_thm(th)
      if !(asl == (PairList []))
      | failwith("new_specification: Assumptions not allowed in theorem")
      | if !(frees(c) == (PairList []))
        | failwith(
            ("new_specification: Free variables in predicate: " +& hol_string_concat(", ")(map((fun(Var(name,_)): name))(frees(c))))
          )
        | let avs = fst(strip_exists(c))
          if ((length(names) == 0) || (length(names) > length(avs)))
          | failwith("new_specification: Unsuitable number of constant names")
          | if !check_distinct(names)
            | failwith("new_specification: Constant names not distinct")
            | try:
                let sth:
                  snd(
                    find(
                      (fun([[names_prime, th_prime], sth_prime]): ((names_prime == names) && aconv(concl(th_prime))(concl(th))))
                    )(the_specifications.value)
                  )
                warn(#true)("Benign respecification")
                sth
                ~catch exn:
                  match exn
                  | Failure(_):
                      let sth = specifies(names)(th)
                      the_specifications.value := PairList [[[names, th], sth], & the_specifications.value]
                      sth
                  | exn: (throw exn)

def IND_SUC_INJ = nums_IND_SUC_INJ_v2

def NUM_REP_RULES = nums_NUM_REP_RULES_v2

def NUM_REP_INDUCT = nums_NUM_REP_INDUCT_v2

def NOT_SUC = nums_NOT_SUC_v3

def num_INDUCTION = nums_num_INDUCTION_v3

def num_Axiom = nums_num_Axiom_v2
