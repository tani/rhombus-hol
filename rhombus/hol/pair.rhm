fun pair_SUBLET_CONV(conv):«
  (block:«
    fun largconv(tm):«
      (block:«
        let port_tmp_174 = tm;
        match port_tmp_174
        | Up_fusion.Comb(Up_fusion.Const("LET",_),_):«
            Up_fusion.REFL(tm)
        »
        | Up_fusion.Comb(l,r):«
            Up_equal.COMB2_CONV(largconv)(conv)(tm)
        »
        | _:«
            failwith("SUBLET_CONV")
        »
      »)
    »;
    (fun(tm):«
      (block:«
        if Up_basics.is_let(tm)
        | largconv(tm)
        | failwith("SUBLET_CONV")
      »)
    »)
  »)
»

