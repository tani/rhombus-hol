def pair_RECURSION = Tactics.prove([Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyvar\",\"C\"]]]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"PAIR'\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyvar\",\"C\"]]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyvar\",\"C\"]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"fn\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyvar\",\"C\"]]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"a0\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"a1\",[\"Tyvar\",\"B\"]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"C\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"C\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"fn\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyvar\",\"C\"]]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]]]]]]],[\"Var\",\"a0\",[\"Tyvar\",\"A\"]]],[\"Var\",\"a1\",[\"Tyvar\",\"B\"]]]]],[\"Comb\",[\"Comb\",[\"Var\",\"PAIR'\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyvar\",\"C\"]]]]]],[\"Var\",\"a0\",[\"Tyvar\",\"A\"]]],[\"Var\",\"a1\",[\"Tyvar\",\"B\"]]]]]]]]]]]]"), Tactics.THEN(Tactics.THEN(Tactics.GEN_TAC)(Tactics.EXISTS_TAC(Host.expand_quote("[\"Abs\",[\"Var\",\"p\",[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]]],[\"Comb\",[\"Comb\",[\"Var\",\"PAIR'\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyvar\",\"C\"]]]]]],[\"Comb\",[\"Const\",\"FST\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyvar\",\"A\"]]]],[\"Var\",\"p\",[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]]]]],[\"Comb\",[\"Const\",\"SND\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyvar\",\"B\"]]]],[\"Var\",\"p\",[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]]]]]]"))))(Simp.REWRITE_TAC(PairList.cons(FST, PairList.cons(SND, PairList []))))])

def is_pair = Basics.is_binary(",")

def dest_pair = Basics.dest_binary(",")

def mk_pair:
  let ptm = Fusion.mk_const([",", PairList []])
  (fun([l, r]): Fusion.mk_comb([Fusion.mk_comb([Fusion.inst(PairList.cons([Fusion.type_of(l), Fusion.aty], PairList.cons([Fusion.type_of(r), Fusion.bty], PairList [])))(ptm), l]), r]))

Simp.extend_basic_rewrites(PairList.cons(FST, PairList.cons(SND, PairList.cons(PAIR, PairList []))))

def the_definitions = Box(PairList.cons(SND_DEF, PairList.cons(FST_DEF, PairList.cons(COMMA_DEF, PairList.cons(mk_pair_def, PairList.cons(GEQ_DEF, PairList.cons(GABS_DEF, PairList.cons(LET_END_DEF, PairList.cons(LET_DEF, PairList.cons(Trivia.one_DEF, PairList.cons(Trivia.I_DEF, PairList.cons(Trivia.o_DEF, PairList.cons(Class.COND_DEF, PairList.cons(Tactics._FALSITY_, PairList.cons(Bool.EXISTS_UNIQUE_DEF, PairList.cons(Bool.NOT_DEF, PairList.cons(Bool.F_DEF, PairList.cons(Bool.OR_DEF, PairList.cons(Bool.EXISTS_DEF, PairList.cons(Bool.FORALL_DEF, PairList.cons(Bool.IMP_DEF, PairList.cons(Bool.AND_DEF, PairList.cons(Bool.T_DEF, PairList [])))))))))))))))))))))))

def new_definition:
  fun depair_2(gv):
    fun(arg):
      try:
        let [l, r] = dest_pair(arg)
        append(depair_2(Basics.list_mk_icomb("FST")(PairList.cons(gv, PairList [])))(l))(depair_2(Basics.list_mk_icomb("SND")(PairList.cons(gv, PairList [])))(r))
        ~catch exn:
          match exn
          | Failure(_): PairList.cons([gv, arg], PairList [])
          | exn: Host.hol_raise(exn)
  let depair:
    fun(arg):
      let gv = Basics.genvar(Fusion.type_of(arg))
      [gv, depair_2(gv)(arg)]
  fun(tm):
    let [avs, hol_def_2] = Basics.strip_forall(tm)
    try:
      let [th, th_prime] = tryfind((fun(th): [th, Drule.PART_MATCH(I)(th)(hol_def_2)]))(Host.ref_get(the_definitions))
      Host.hol_ignore(Drule.PART_MATCH(I)(th_prime)(snd(Basics.strip_forall(Fusion.concl(th)))))
      Host.warn(#true)("Benign redefinition")
      Bool.GEN_ALL(Bool.GENL(avs)(th_prime))
      ~catch exn:
        match exn
        | Failure(_):
            let [l, r] = Fusion.dest_eq(hol_def_2)
            let [fn, args] = Basics.strip_comb(l)
            let [gargs, reps] = Host.F_F(I)(Host.unions)(unzip(map(depair)(args)))
            let l_prime_2 = Basics.list_mk_comb([fn, gargs])
            let r_prime_2 = Basics.subst(reps)(r)
            let th1 = Drule.new_definition(Fusion.mk_eq([l_prime_2, r_prime_2]))
            let slist = zip(args)(gargs)
            let th2 = Fusion.INST(slist)(Bool.SPEC_ALL(th1))
            let xreps = map(o(Basics.subst(slist))(fst))(reps)
            let threps = map(o(Equal.SYM)(Simp.PURE_REWRITE_CONV(PairList.cons(FST, PairList.cons(SND, PairList [])))))(xreps)
            let th3 = Fusion.TRANS(th2)(Equal.SYM(Equal.SUBS_CONV(threps)(r)))
            let th4 = Bool.GEN_ALL(Bool.GENL(avs)(th3))
            Host.ref_set(the_definitions)(PairList.cons(th4, Host.ref_get(the_definitions)))
            th4
        | exn: Host.hol_raise(exn)

