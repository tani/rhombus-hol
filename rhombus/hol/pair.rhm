        | _:«
            failwith("SUBLET_CONV")
        »
      »)
    »;
    (fun(tm):«
      (block:«
        if Basics.is_let(tm)
        | largconv(tm)
        | failwith("SUBLET_CONV")
      »)
    »)
  »)
»

def _SEQPATTERN = pair__SEQPATTERN

def _UNGUARDED_PATTERN = pair__UNGUARDED_PATTERN

def _GUARDED_PATTERN = pair__GUARDED_PATTERN

def _MATCH = pair__MATCH

def _FUNCTION = pair__FUNCTION
