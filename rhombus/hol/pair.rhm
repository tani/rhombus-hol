def FORALL_PAIR_THM:
  prove(
    [
      @hol|{!P:A#B->bool. (!p. P p) <=> (!p1 p2. P(p1,p2))}|,
      MESON_TAC(PairList [PAIR])
    ]
  )

def EXISTS_PAIR_THM:
  prove(
    [
      @hol|{!P:A#B->bool. (?p. P p) <=> ?p1 p2. P(p1,p2)}|,
      MESON_TAC(PairList [PAIR])
    ]
  )

