def CHOICE_UNPAIR_THM:
  prove(
    [
      @hol|{!P. (@(x:A,y:B). P x y) = (@p. P (FST p) (SND p))}|,
      REWRITE_TAC(PairList [LAMBDA_PAIR])
    ]
  )

def CHOICE_PAIRED_THM:
  prove(
    [
      @hol|{!P Q. (?x:A y:B. P x y) /\ (!x y. P x y ==> Q(x,y)) ==> Q (@(x,y). P x y)}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      INTRO_TAC("!P Q; (@x0 y0. P0) PQ") then_tac \
                      SUBGOAL_THEN(
                        @hol|{(\ (x:A,y:B). P x y:bool) = (\p. P (FST p) (SND p))}|
                      )(SUBST1_TAC)
                    ) then_list \
                    PairList [REWRITE_TAC(PairList [LAMBDA_PAIR_THM]), SELECT_ELIM_TAC]
                  ) then_tac \
                  INTRO_TAC("![c]; c")
                ) then_tac \
                ONCE_REWRITE_TAC(PairList [GSYM(PAIR)])
              ) then_tac \
              REMOVE_THEN("PQ")(MATCH_MP_TAC)
            ) then_tac \
            REMOVE_THEN("c")(MATCH_MP_TAC)
          ) then_tac \
          REWRITE_TAC(PairList [EXISTS_PAIR_THM])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def let_CONV:
  let let1_CONV_2 = (REWR_CONV(LET_DEF) then_conv GEN_BETA_CONV)
  let lete_CONV_2 = REWR_CONV(LET_END_DEF)
  fun EXPAND_BETAS_CONV(tm):
    let tm_prime = rator(tm)
    try:
      let1_CONV_2(tm)
      ~catch exn:
        match exn
        | Failure(_):
            let th1 = AP_THM(EXPAND_BETAS_CONV(tm_prime))(rand(tm))
            let th2 = GEN_BETA_CONV(rand(concl(th1)))
            TRANS(th1)(th2)
        | exn: (throw exn)
  fun(tm):
    let [ltm, pargs] = strip_comb(tm)
    if ((fst(dest_const(ltm)) != "LET") || (pargs == (PairList [])))
    | failwith("let_CONV")
    | let abstm = hd(pargs)
      let [vs, bod] = strip_gabs(abstm)
      let es = tl(pargs)
      let n = length(es)
      (if (length(vs) != n) | failwith("let_CONV") | (EXPAND_BETAS_CONV then_conv lete_CONV_2)(tm))

def LET_TAC:
  let is_trivlet_2:
    fun(tm):
      try:
        let [assigs, bod] = dest_let(tm)
        forall(uncurry((fun (x): fun (y): x == y)))(assigs)
        ~catch exn:
          match exn
          | Failure(_): #false
          | exn: (throw exn)
  let pth:
    prove(
      [
        @hol|{((x,y) = a) <=> (x = FST a) /\ (y = SND a)}|,
        MESON_TAC(PairList [PAIR, PAIR_EQ])
      ]
    )
  let rewr1_CONV_2 = GEN_REWRITE_CONV(TOP_DEPTH_CONV)(PairList [pth])
  let rewr2_RULE_2:
    GEN_REWRITE_RULE(o(LAND_CONV)(DEPTH_CONV))(
      PairList [
        TAUT(@hol|{(x = x) <=> T}|),
        TAUT(@hol|{a /\ T <=> a}|)
      ]
    )
  let PROVE_DEPAIRING_EXISTS_2:
    fun(tm):
      let th1 = rewr1_CONV_2(tm)
      let tm1 = rand(concl(th1))
      let cjs = conjuncts(tm1)
      let vars = map(lhand)(cjs)
      let th2 = EQ_MP(SYM(th1))(ASSUME(tm1))
      let th3 = DISCH_ALL(itlist(SIMPLE_EXISTS)(vars)(th2))
      let th4 = INST(map((fun(t): [rand(t), lhand(t)]))(cjs))(th3)
      MP(rewr2_RULE_2(th4))(TRUTH)
  fun([asl, w] as gl):
    let path:
      try:
        find_path(is_trivlet_2)(w)
        ~catch exn:
          match exn
          | Failure(_): find_path(is_let)(w)
          | exn: (throw exn)
    let tm = follow_path(path)(w)
    let [assigs, bod] = dest_let(tm)
    let abbrevs = mapfilter((fun([x, y]): (if (x == y) | fail() | mk_eq([x, y]))))(assigs)
    let lvars_2 = itlist(o(o(union)(frees))(lhs))(abbrevs)(PairList [])
    let avoids_2 = itlist(o(o(union)(thm_frees))(snd))(asl)(frees(w))
    let rename = vsubst(zip(variants(avoids_2)(lvars_2))(lvars_2))
    let abbrevs_prime:
      map(
        fun(eq):
          let [l, r] = dest_eq(eq)
          mk_eq([rename(l), r])
      )(abbrevs)
    let deprths = map(PROVE_DEPAIRING_EXISTS_2)(abbrevs_prime)
    (
      MAP_EVERY(
        REPEAT_TCL(CHOOSE_THEN)(
          fun(th):
            let th_prime = SYM(th)
            (SUBST_ALL_TAC(th_prime) then_tac ASSUME_TAC(th_prime))
        )
      )(deprths) then_tac \
      W(
        fun([asl_prime, w_prime]):
          let tm_prime = follow_path(path)(w_prime)
          CONV_TAC(PATH_CONV(path)(K(let_CONV(tm_prime))))
      )
    )(gl)

fun SUBLET_CONV(conv):
  fun(tm):
    fun largconv(tm):
      match tm
      | Comb(Const("LET",_),_): REFL(tm)
      | Comb(l,r): COMB2_CONV(largconv)(conv)(tm)
      | _: failwith("SUBLET_CONV")
    if is_let(tm) | largconv(tm) | failwith("SUBLET_CONV")

