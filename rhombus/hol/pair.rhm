              DISCH_TAC
            ) then_tac \
            X_GEN_TAC(Host.hol_term(Var("f", Fun(Tvar("A"), Fun(Tvar("B"), Tvar("C"))))))
          ) then_tac \
          FIRST_ASSUM(
            o(MP_TAC)(
              SPEC(
                Host.hol_term(App(
                  Const(
