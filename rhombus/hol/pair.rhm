def LET_DEF:
  Drule.new_definition(
    Host.hol_term(Eq(
      Tvar("B"),
      App(
        Var("LET", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Tvar("A"), Tvar("B")))),
        [Var("f", Fun(Tvar("A"), Tvar("B"))), Var("x", Tvar("A"))]
      ),
      App(Var("f", Fun(Tvar("A"), Tvar("B"))), [Var("x", Tvar("A"))])
    ))
  )

def LET_END_DEF:
  Drule.new_definition(
    Host.hol_term(Eq(
      Tvar("A"),
      App(Var("LET_END", Fun(Tvar("A"), Tvar("A"))), [Var("t", Tvar("A"))]),
      Var("t", Tvar("A"))
    ))
  )

def GABS_DEF:
  Drule.new_definition(
    Host.hol_term(Eq(
      Tvar("A"),
      App(Var("GABS", Fun(Fun(Tvar("A"), Bool), Tvar("A"))), [Var("P", Fun(Tvar("A"), Bool))]),
      App(Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))), [Var("P", Fun(Tvar("A"), Bool))])
    ))
  )

def GEQ_DEF:
  Drule.new_definition(
    Host.hol_term(Iff(
      App(
        Var("GEQ", Fun(Tvar("A"), Fun(Tvar("A"), Bool))),
        [Var("a", Tvar("A")), Var("b", Tvar("A"))]
      ),
      Eq(Tvar("A"), Var("a", Tvar("A")), Var("b", Tvar("A")))
    ))
  )

def pair__SEQPATTERN:
  Drule.new_definition(
    Host.hol_term(Eq(
      Fun(
        Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
        Fun(Fun(Tvar("A"), Fun(Tvar("B"), Bool)), Fun(Tvar("A"), Fun(Tvar("B"), Bool)))
      ),
      Var(
        "_SEQPATTERN",
        Fun(
          Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
          Fun(Fun(Tvar("A"), Fun(Tvar("B"), Bool)), Fun(Tvar("A"), Fun(Tvar("B"), Bool)))
        )
      ),
      Lambda(
        "r",
        Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
        Lambda(
          "s",
          Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
          Lambda(
            "x",
            Tvar("A"),
            App(
              Const(
                "COND",
                Fun(Bool, Fun(Fun(Tvar("B"), Bool), Fun(Fun(Tvar("B"), Bool), Fun(Tvar("B"), Bool))))
              ),
              [
                Exists("y", Tvar("B"), App(Ref("r"), [Ref("x"), Ref("y")])),
                App(Ref("r"), [Ref("x")]),
                App(Ref("s"), [Ref("x")])
              ]
            )
          )
        )
      )
    ))
  )

def pair__UNGUARDED_PATTERN:
  Drule.new_definition(
    Host.hol_term(Eq(
      Fun(Bool, Fun(Bool, Bool)),
      Var("_UNGUARDED_PATTERN", Fun(Bool, Fun(Bool, Bool))),
      Lambda("p", Bool, Lambda("r", Bool, And(Ref("p"), Ref("r"))))
    ))
  )

def pair__GUARDED_PATTERN:
  Drule.new_definition(
    Host.hol_term(Eq(
      Fun(Bool, Fun(Bool, Fun(Bool, Bool))),
      Var("_GUARDED_PATTERN", Fun(Bool, Fun(Bool, Fun(Bool, Bool)))),
      Lambda("p", Bool, Lambda("g", Bool, Lambda("r", Bool, And(Ref("p"), And(Ref("g"), Ref("r"))))))
    ))
  )

def pair__MATCH:
  Drule.new_definition(
    Host.hol_term(Eq(
      Fun(Tvar("A"), Fun(Fun(Tvar("A"), Fun(Tvar("B"), Bool)), Tvar("B"))),
      Var("_MATCH", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Fun(Tvar("B"), Bool)), Tvar("B")))),
      Lambda(
        "e",
        Tvar("A"),
        Lambda(
          "r",
          Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
          App(
            Const("COND", Fun(Bool, Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))))),
            [
              App(Const("?!", Fun(Fun(Tvar("B"), Bool), Bool)), [App(Ref("r"), [Ref("e")])]),
              App(Const("@", Fun(Fun(Tvar("B"), Bool), Tvar("B"))), [App(Ref("r"), [Ref("e")])]),
              App(Const("@", Fun(Fun(Tvar("B"), Bool), Tvar("B"))), [Lambda("z", Tvar("B"), False)])
            ]
          )
        )
      )
    ))
  )

def pair__FUNCTION:
  Drule.new_definition(
    Host.hol_term(Eq(
      Fun(Fun(Tvar("A"), Fun(Tvar("B"), Bool)), Fun(Tvar("A"), Tvar("B"))),
      Var("_FUNCTION", Fun(Fun(Tvar("A"), Fun(Tvar("B"), Bool)), Fun(Tvar("A"), Tvar("B")))),
      Lambda(
        "r",
        Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
        Lambda(
          "x",
          Tvar("A"),
          App(
            Const("COND", Fun(Bool, Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))))),
            [
              App(Const("?!", Fun(Fun(Tvar("B"), Bool), Bool)), [App(Ref("r"), [Ref("x")])]),
              App(Const("@", Fun(Fun(Tvar("B"), Bool), Tvar("B"))), [App(Ref("r"), [Ref("x")])]),
              App(Const("@", Fun(Fun(Tvar("B"), Bool), Tvar("B"))), [Lambda("z", Tvar("B"), False)])
            ]
          )
        )
      )
    ))
  )

def mk_pair_def:
  Drule.new_definition(
    Host.hol_term(Eq(
      Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
      App(
        Var("mk_pair", Fun(Tvar("A"), Fun(Tvar("B"), Fun(Tvar("A"), Fun(Tvar("B"), Bool))))),
        [Var("x", Tvar("A")), Var("y", Tvar("B"))]
      ),
      Lambda(
        "a",
        Tvar("A"),
        Lambda(
          "b",
          Tvar("B"),
          And(Eq(Tvar("A"), Ref("a"), Var("x", Tvar("A"))), Eq(Tvar("B"), Ref("b"), Var("y", Tvar("B"))))
        )
      )
    ))
  )

def PAIR_EXISTS_THM:
  prove(
    [
      Host.hol_term(Exists(
        "x",
        Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
        Exists(
          "a",
          Tvar("A"),
          Exists(
            "b",
            Tvar("B"),
            Eq(
              Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
              Ref("x"),
              App(
                Const("mk_pair", Fun(Tvar("A"), Fun(Tvar("B"), Fun(Tvar("A"), Fun(Tvar("B"), Bool))))),
                [Ref("a"), Ref("b")]
              )
            )
          )
        )
      )),
      MESON_TAC(PairList [])
    ]
  )

def prod_tybij = new_type_definition("prod")(["ABS_prod", "REP_prod"])(PAIR_EXISTS_THM)

def REP_ABS_PAIR:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Tvar("A"),
        Forall(
          "y",
          Tvar("B"),
          Eq(
            Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
            App(
              Const(
                "REP_prod",
                Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Fun(Tvar("A"), Fun(Tvar("B"), Bool)))
              ),
              [
                App(
                  Const(
                    "ABS_prod",
                    Fun(Fun(Tvar("A"), Fun(Tvar("B"), Bool)), Tyapp("prod", [Tvar("A"), Tvar("B")]))
                  ),
                  [
                    App(
                      Const("mk_pair", Fun(Tvar("A"), Fun(Tvar("B"), Fun(Tvar("A"), Fun(Tvar("B"), Bool))))),
                      [Ref("x"), Ref("y")]
                    )
                  ]
                )
              ]
            ),
            App(
              Const("mk_pair", Fun(Tvar("A"), Fun(Tvar("B"), Fun(Tvar("A"), Fun(Tvar("B"), Bool))))),
              [Ref("x"), Ref("y")]
            )
          )
        )
      )),
      MESON_TAC(PairList [prod_tybij])
    ]
  )

Host.parse_as_infix([",", [14, "right"]])

def COMMA_DEF:
  Drule.new_definition(
    Host.hol_term(Eq(
      Tyapp("prod", [Tvar("A"), Tvar("B")]),
      App(
        Var(",", Fun(Tvar("A"), Fun(Tvar("B"), Tyapp("prod", [Tvar("A"), Tvar("B")])))),
        [Var("x", Tvar("A")), Var("y", Tvar("B"))]
      ),
      App(
        Const(
          "ABS_prod",
          Fun(Fun(Tvar("A"), Fun(Tvar("B"), Bool)), Tyapp("prod", [Tvar("A"), Tvar("B")]))
        ),
        [
          App(
            Const("mk_pair", Fun(Tvar("A"), Fun(Tvar("B"), Fun(Tvar("A"), Fun(Tvar("B"), Bool))))),
            [Var("x", Tvar("A")), Var("y", Tvar("B"))]
          )
        ]
      )
    ))
  )

def FST_DEF:
  Drule.new_definition(
    Host.hol_term(Eq(
      Tvar("A"),
      App(
        Var("FST", Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Tvar("A"))),
        [Var("p", Tyapp("prod", [Tvar("A"), Tvar("B")]))]
      ),
      App(
        Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))),
        [
          Lambda(
            "x",
            Tvar("A"),
            Exists(
              "y",
              Tvar("B"),
              Eq(
                Tyapp("prod", [Tvar("A"), Tvar("B")]),
                Var("p", Tyapp("prod", [Tvar("A"), Tvar("B")])),
                App(
                  Const(",", Fun(Tvar("A"), Fun(Tvar("B"), Tyapp("prod", [Tvar("A"), Tvar("B")])))),
                  [Ref("x"), Ref("y")]
                )
              )
            )
          )
        ]
      )
    ))
  )

def SND_DEF:
  Drule.new_definition(
    Host.hol_term(Eq(
      Tvar("B"),
      App(
        Var("SND", Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Tvar("B"))),
        [Var("p", Tyapp("prod", [Tvar("A"), Tvar("B")]))]
      ),
      App(
        Const("@", Fun(Fun(Tvar("B"), Bool), Tvar("B"))),
        [
          Lambda(
            "y",
            Tvar("B"),
            Exists(
              "x",
              Tvar("A"),
              Eq(
                Tyapp("prod", [Tvar("A"), Tvar("B")]),
                Var("p", Tyapp("prod", [Tvar("A"), Tvar("B")])),
                App(
                  Const(",", Fun(Tvar("A"), Fun(Tvar("B"), Tyapp("prod", [Tvar("A"), Tvar("B")])))),
                  [Ref("x"), Ref("y")]
                )
              )
            )
          )
        ]
      )
    ))
  )

def PAIR_EQ:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Tvar("A"),
        Forall(
          "y",
          Tvar("B"),
          Forall(
            "a",
            Tvar("A"),
            Forall(
              "b",
              Tvar("B"),
              Iff(
                Eq(
                  Tyapp("prod", [Tvar("A"), Tvar("B")]),
                  App(
                    Const(",", Fun(Tvar("A"), Fun(Tvar("B"), Tyapp("prod", [Tvar("A"), Tvar("B")])))),
                    [Ref("x"), Ref("y")]
                  ),
                  App(
                    Const(",", Fun(Tvar("A"), Fun(Tvar("B"), Tyapp("prod", [Tvar("A"), Tvar("B")])))),
                    [Ref("a"), Ref("b")]
                  )
                ),
                And(Eq(Tvar("A"), Ref("x"), Ref("a")), Eq(Tvar("B"), Ref("y"), Ref("b")))
              )
            )
          )
        )
      )),
      (
        (
          (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
          PairList [
            (
              (
                (
                  REWRITE_TAC(PairList [COMMA_DEF]) then_tac \
                  DISCH_THEN(
                    o(MP_TAC)(
                      AP_TERM(
                        Host.hol_term(Const(
                          "REP_prod",
                          Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Fun(Tvar("A"), Fun(Tvar("B"), Bool)))
                        ))
                      )
                    )
                  )
                ) then_tac \
                REWRITE_TAC(PairList [REP_ABS_PAIR])
              ) then_tac \
              REWRITE_TAC(PairList [mk_pair_def, FUN_EQ_THM])
            ),
            ALL_TAC
          ]
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def PAIR_SURJECTIVE:
  prove(
    [
      Host.hol_term(Forall(
        "p",
        Tyapp("prod", [Tvar("A"), Tvar("B")]),
        Exists(
          "x",
          Tvar("A"),
          Exists(
            "y",
            Tvar("B"),
            Eq(
              Tyapp("prod", [Tvar("A"), Tvar("B")]),
              Ref("p"),
              App(
                Const(",", Fun(Tvar("A"), Fun(Tvar("B"), Tyapp("prod", [Tvar("A"), Tvar("B")])))),
                [Ref("x"), Ref("y")]
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (GEN_TAC then_tac REWRITE_TAC(PairList [COMMA_DEF])) then_tac \
                      MP_TAC(
                        SPEC(
                          Host.hol_term(App(
                            Const(
                              "REP_prod",
                              Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Fun(Tvar("A"), Fun(Tvar("B"), Bool)))
                            ),
                            [Var("p", Tyapp("prod", [Tvar("A"), Tvar("B")]))]
                          ))
                        )(CONJUNCT2(prod_tybij))
                      )
                    ) then_tac \
                    REWRITE_TAC(PairList [CONJUNCT1(prod_tybij)])
                  ) then_tac \
                  DISCH_THEN(
                    X_CHOOSE_THEN(Host.hol_term(Var("a", Tvar("A"))))(X_CHOOSE_THEN(Host.hol_term(Var("b", Tvar("B"))))(MP_TAC))
                  )
                ) then_tac \
                DISCH_THEN(
                  o(MP_TAC)(
                    AP_TERM(
                      Host.hol_term(Const(
                        "ABS_prod",
                        Fun(Fun(Tvar("A"), Fun(Tvar("B"), Bool)), Tyapp("prod", [Tvar("A"), Tvar("B")]))
                      ))
                    )
                  )
                )
              ) then_tac \
              REWRITE_TAC(PairList [CONJUNCT1(prod_tybij)])
            ) then_tac \
            DISCH_THEN(SUBST1_TAC)
          ) then_tac \
          MAP_EVERY(EXISTS_TAC)(PairList [Host.hol_term(Var("a", Tvar("A"))), Host.hol_term(Var("b", Tvar("B")))])
        ) then_tac \
        REFL_TAC
      )
    ]
  )

def FST:
  prove(
    [
      Host.hol_term(Forall(
