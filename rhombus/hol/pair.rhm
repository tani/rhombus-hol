def LET_DEF:
  Drule.new_definition(
    @hol|{LET (f:A->B) x = f x}|
  )

def LET_END_DEF:
  Drule.new_definition(
    @hol|{LET_END (t:A) = t}|
  )

def GABS_DEF:
  Drule.new_definition(
    @hol|{GABS (P:A->bool) = (@) P}|
  )

def GEQ_DEF:
  Drule.new_definition(
    @hol|{GEQ a b = (a:A = b)}|
  )

def pair__SEQPATTERN:
  Drule.new_definition(
    @hol|{_SEQPATTERN = \(r:A->B->bool) s x. if ?y. r x y then r x else s x}|
  )

def pair__UNGUARDED_PATTERN:
  Drule.new_definition(
    @hol|{_UNGUARDED_PATTERN = \p r. p /\ r}|
  )

def pair__GUARDED_PATTERN:
  Drule.new_definition(
    @hol|{_GUARDED_PATTERN = \p g r. p /\ g /\ r}|
  )

def pair__MATCH:
  Drule.new_definition(
    @hol|{_MATCH =  \e (r:A->B->bool). if (?!) (r e) then (@) (r e) else @z. F}|
  )

def pair__FUNCTION:
  Drule.new_definition(
    @hol|{_FUNCTION = \(r:A->B->bool) x. if (?!) (r x) then (@) (r x) else @z. F}|
  )

def mk_pair_def:
  Drule.new_definition(
    @hol|{mk_pair (x:A) (y:B) = \a b. (a = x) /\ (b = y)}|
  )

def PAIR_EXISTS_THM:
  prove(
    [
      @hol|{?x. ?(a:A) (b:B). x = mk_pair a b}|,
      MESON_TAC(PairList [])
    ]
  )

def prod_tybij = new_type_definition("prod")(["ABS_prod", "REP_prod"])(PAIR_EXISTS_THM)

def REP_ABS_PAIR:
  prove(
    [
      @hol|{!(x:A) (y:B). REP_prod (ABS_prod (mk_pair x y)) = mk_pair x y}|,
      MESON_TAC(PairList [prod_tybij])
    ]
  )

Host.parse_as_infix([",", [14, "right"]])

def COMMA_DEF:
  Drule.new_definition(
    @hol|{(x:A),(y:B) = ABS_prod(mk_pair x y)}|
  )

def FST_DEF:
  Drule.new_definition(
    @hol|{FST (p:A#B) = @x. ?y. p = x,y}|
  )

def SND_DEF:
  Drule.new_definition(
    @hol|{SND (p:A#B) = @y. ?x. p = x,y}|
  )

def PAIR_EQ:
  prove(
    [
      @hol|{!(x:A) (y:B) a b. (x,y = a,b) <=> (x = a) /\ (y = b)}|,
      (
        (
          (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
          PairList [
            (
              (
                (
                  REWRITE_TAC(PairList [COMMA_DEF]) then_tac \
                  DISCH_THEN(
                    o(MP_TAC)(
                      AP_TERM(
                        @hol|{REP_prod:A#B->A->B->bool}|
                      )
                    )
                  )
                ) then_tac \
                REWRITE_TAC(PairList [REP_ABS_PAIR])
              ) then_tac \
              REWRITE_TAC(PairList [mk_pair_def, FUN_EQ_THM])
            ),
            ALL_TAC
          ]
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def PAIR_SURJECTIVE:
  prove(
    [
      @hol|{!p:A#B. ?x y. p = x,y}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (GEN_TAC then_tac REWRITE_TAC(PairList [COMMA_DEF])) then_tac \
                      MP_TAC(
                        SPEC(
                          @hol|{REP_prod p :A->B->bool}|
                        )(CONJUNCT2(prod_tybij))
                      )
                    ) then_tac \
                    REWRITE_TAC(PairList [CONJUNCT1(prod_tybij)])
                  ) then_tac \
                  DISCH_THEN(
                    X_CHOOSE_THEN(@hol|{a:A}|)(X_CHOOSE_THEN(@hol|{b:B}|)(MP_TAC))
                  )
                ) then_tac \
                DISCH_THEN(
                  o(MP_TAC)(
                    AP_TERM(
                      @hol|{ABS_prod:(A->B->bool)->A#B}|
                    )
                  )
                )
              ) then_tac \
              REWRITE_TAC(PairList [CONJUNCT1(prod_tybij)])
            ) then_tac \
            DISCH_THEN(SUBST1_TAC)
          ) then_tac \
          MAP_EVERY(EXISTS_TAC)(PairList [@hol|{a:A}|, @hol|{b:B}|])
        ) then_tac \
        REFL_TAC
      )
    ]
  )

def FST:
  prove(
    [
      @hol|{!(x:A) (y:B). FST(x,y) = x}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [FST_DEF])) then_tac \
                        MATCH_MP_TAC(SELECT_UNIQUE)
                      ) then_tac \
                      GEN_TAC
                    ) then_tac \
                    BETA_TAC
                  ) then_tac \
                  REWRITE_TAC(PairList [PAIR_EQ])
                ) then_tac \
                EQ_TAC
              ) then_tac \
              STRIP_TAC
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          EXISTS_TAC(@hol|{y:B}|)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def SND:
  prove(
    [
      @hol|{!(x:A) (y:B). SND(x,y) = y}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [SND_DEF])) then_tac \
                        MATCH_MP_TAC(SELECT_UNIQUE)
                      ) then_tac \
                      GEN_TAC
                    ) then_tac \
                    BETA_TAC
                  ) then_tac \
                  REWRITE_TAC(PairList [PAIR_EQ])
                ) then_tac \
                EQ_TAC
              ) then_tac \
              STRIP_TAC
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          EXISTS_TAC(@hol|{x:A}|)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def PAIR:
  prove(
    [
      @hol|{!x:A#B. FST x,SND x = x}|,
      (
        (
          GEN_TAC then_tac \
          X_CHOOSE_THEN(@hol|{a:A}|)(X_CHOOSE_THEN(@hol|{b:B}|)(SUBST1_TAC))(SPEC(@hol|{x:A#B}|)(PAIR_SURJECTIVE))
        ) then_tac \
        REWRITE_TAC(PairList [FST, SND])
      )
    ]
  )

def pair_INDUCT:
  prove(
    [
      @hol|{!P:A#B->bool. (!x y. P (x,y)) ==> !p. P p}|,
      (
        (
          REPEAT(STRIP_TAC) then_tac \
          GEN_REWRITE_TAC(RAND_CONV)(PairList [GSYM(PAIR)])
        ) then_tac \
        FIRST_ASSUM(MATCH_ACCEPT_TAC)
      )
    ]
  )

def pair_RECURSION:
  prove(
    [
      @hol|{!PAIR'. ?fn:A#B->C. !a0 a1. fn (a0,a1) = PAIR' a0 a1}|,
      (
        (
          GEN_TAC then_tac \
          EXISTS_TAC(
            @hol|{\p. (PAIR':A->B->C) (FST p) (SND p)}|
          )
        ) then_tac \
        REWRITE_TAC(PairList [FST, SND])
      )
    ]
  )

def is_pair = is_binary(",")

def dest_pair = dest_binary(",")

fun mk_pair([l, r]):
  let ptm = mk_const([",", PairList []])
  mk_comb(
    [
      mk_comb(
        [
          inst(PairList [[type_of(l), aty], [type_of(r), bty]])(ptm),
          l
        ]
      ),
      r
    ]
  )

extend_basic_rewrites(PairList [FST, SND, PAIR])

def the_definitions:
  Box(
    PairList [
      SND_DEF,
      FST_DEF,
      COMMA_DEF,
      mk_pair_def,
      GEQ_DEF,
      GABS_DEF,
      LET_END_DEF,
      LET_DEF,
      one_DEF,
      I_DEF,
      o_DEF,
      COND_DEF,
      _FALSITY_,
      EXISTS_UNIQUE_DEF,
      NOT_DEF,
      F_DEF,
      OR_DEF,
      EXISTS_DEF,
      FORALL_DEF,
      IMP_DEF,
      AND_DEF,
      T_DEF
    ]
  )

def new_definition:
  // Recursive depairing needs the local definition before its first use.
  fun depair_2(gv):
    fun(arg):
      try:
        let [l, r] = dest_pair(arg)
        append(depair_2(list_mk_icomb("FST")(PairList [gv]))(l))(depair_2(list_mk_icomb("SND")(PairList [gv]))(r))
        ~catch exn:
          match exn
          | Failure(_): PairList [[gv, arg]]
          | exn: (throw exn)
  let depair:
    fun(arg):
      let gv = genvar(type_of(arg))
      [gv, depair_2(gv)(arg)]
  fun(tm):
    let [avs, hol_def_2] = strip_forall(tm)
    try:
      let [th, th_prime] = tryfind((fun(th): [th, PART_MATCH(I)(th)(hol_def_2)]))(the_definitions.value)
      hol_ignore(PART_MATCH(I)(th_prime)(snd(strip_forall(concl(th)))))
      warn(#true)("Benign redefinition")
      GEN_ALL(GENL(avs)(th_prime))
      ~catch exn:
        match exn
        | Failure(_):
            let [l, r] = dest_eq(hol_def_2)
            let [fn, args] = strip_comb(l)
            let [gargs, reps] = F_F(I)(unions)(unzip(map(depair)(args)))
            let l_prime_2 = list_mk_comb([fn, gargs])
            let r_prime_2 = subst(reps)(r)
            let th1 = Drule.new_definition(mk_eq([l_prime_2, r_prime_2]))
            let slist = zip(args)(gargs)
            let th2 = INST(slist)(SPEC_ALL(th1))
            let xreps = map(o(subst(slist))(fst))(reps)
            let threps = map(o(SYM)(PURE_REWRITE_CONV(PairList [FST, SND])))(xreps)
            let th3 = TRANS(th2)(SYM(SUBS_CONV(threps)(r)))
            let th4 = GEN_ALL(GENL(avs)(th3))
            the_definitions.value := PairList [th4, & the_definitions.value]
            th4
        | exn: (throw exn)

def CURRY_DEF:
  new_definition(
    @hol|{CURRY(f:A#B->C) x y = f(x,y)}|
  )

def UNCURRY_DEF:
  new_definition(
    @hol|{!f x y. UNCURRY(f:A->B->C)(x,y) = f x y}|
  )

def PASSOC_DEF:
  new_definition(
    @hol|{!f x y z. PASSOC (f:(A#B)#C->D) (x,y,z) = f ((x,y),z)}|
  )

fun GABS_CONV(conv):
  fun(tm):
    if is_abs(tm)
    | ABS_CONV(conv)(tm)
    | let [gabs, bod] = dest_comb(tm)
      let [f, qtm] = dest_abs(bod)
      let [xs, bod] = strip_forall(qtm)
      AP_TERM(gabs)(ABS(f)(itlist(MK_FORALL)(xs)(RAND_CONV(conv)(bod))))

def GEN_BETA_CONV:
  let projection_cache = Box(PairList [])
  let create_projections:
    fun(conname):
      try:
        assoc(conname)(projection_cache.value)
        ~catch exn:
          match exn
          | Failure(_):
              let genty = get_const_type(conname)
              let conty = fst(dest_type(repeat(o(snd)(dest_fun_ty))(genty)))
              let [_, _, rth] = assoc(conty)(inductive_type_store.value)
              let sth = SPEC_ALL(rth)
              let [evs, bod] = strip_exists(concl(sth))
              let cjs = conjuncts(bod)
              let ourcj:
                find(
                  o(
                    o(
                      o(
                        o(o(o(o(o((fun (y): conname == y))(fst))(dest_const))(fst))(strip_comb))(rand)
                      )(lhand)
                    )(snd)
                  )(strip_forall)
                )(cjs)
              let n = index(ourcj)(cjs)
              let [avs, eqn] = strip_forall(ourcj)
              let [con_prime, args] = strip_comb(rand(eqn))
              let [aargs, zargs] = chop_list(length(avs))(args)
              let gargs = map(o(genvar)(type_of))(zargs)
              let gcon = genvar(itlist(o(mk_fun_ty)(type_of))(avs)(type_of(rand(eqn))))
              let bth:
                INST(
                  PairList [
                    [list_mk_abs([append(aargs)(gargs), list_mk_comb([gcon, avs])]), con_prime]
                  ]
                )(sth)
              let cth = el(n)(CONJUNCTS(ASSUME(snd(strip_exists(concl(bth))))))
              let dth = CONV_RULE(funpow(length(avs))(BINDER_CONV)(RAND_CONV(BETAS_CONV)))(cth)
              let eth = SIMPLE_EXISTS(rator(lhand(snd(strip_forall(concl(dth))))))(dth)
              let fth = PROVE_HYP(bth)(itlist(SIMPLE_CHOOSE)(evs)(eth))
              let zty = type_of(rand(snd(strip_forall(concl(dth)))))
              let mk_projector:
                fun(a):
                  let ity = type_of(a)
                  let th = BETA_RULE(PINST(PairList [[ity, zty]])(PairList [[list_mk_abs([avs, a]), gcon]])(fth))
                  SYM(SPEC_ALL(SELECT_RULE(th)))
              let ths = map(mk_projector)(avs)
              projection_cache.value := PairList [[conname, ths], & projection_cache.value]
              ths
          | exn: (throw exn)
  let GEQ_CONV_2 = REWR_CONV(GSYM(GEQ_DEF))
  let DEGEQ_RULE_2 = CONV_RULE(REWR_CONV(GEQ_DEF))
  let pth:
    prove(
      [
        @hol|{(?) P ==> P (GABS P)}|,
        SIMP_TAC(PairList [GABS_DEF, SELECT_AX, ETA_AX])
      ]
    )
  let GABS_RULE = MATCH_MP(pth)
  fun create_iterated_projections(tm):
    if (frees(tm) == (PairList []))
    | PairList []
    | if is_var(tm)
      | PairList [REFL(tm)]
      | let [con, args] = strip_comb(tm)
        let prjths = create_projections(fst(dest_const(con)))
        let atm = rand(rand(concl(hd(prjths))))
        let instn = term_match(PairList [])(atm)(tm)
        let arths = map(INSTANTIATE(instn))(prjths)
        let ths:
          map(
            fun(arth):
              let sths = create_iterated_projections(lhand(concl(arth)))
              map(CONV_RULE(RAND_CONV(SUBS_CONV(PairList [arth]))))(sths)
          )(arths)
        unions_prime(equals_thm)(ths)
  let GEN_BETA_CONV:
    fun(tm):
      try:
        BETA_CONV(tm)
        ~catch exn:
          match exn
          | Failure(_):
              let [l, r] = dest_comb(tm)
              let [vstr, bod] = dest_gabs(l)
              let instn = term_match(PairList [])(vstr)(r)
              let prjs = create_iterated_projections(vstr)
              let th1 = SUBS_CONV(prjs)(bod)
              let bod_prime = rand(concl(th1))
              let gv = genvar(type_of(vstr))
              let pat = mk_abs([gv, subst(PairList [[gv, vstr]])(bod_prime)])
              let th2 = TRANS(BETA_CONV(mk_comb([pat, vstr])))(SYM(th1))
              let avs = fst(strip_forall(body(rand(l))))
              let th3 = GENL(fst(strip_forall(body(rand(l)))))(th2)
              let efn = genvar(type_of(pat))
              let th4 = EXISTS([mk_exists([efn, subst(PairList [[efn, pat]])(concl(th3))]), pat])(th3)
              let th5 = CONV_RULE(funpow((length(avs) + 1))(BINDER_CONV)(GEQ_CONV_2))(th4)
              let th6 = CONV_RULE(BETA_CONV)(GABS_RULE(th5))
              INSTANTIATE(instn)(DEGEQ_RULE_2(SPEC_ALL(th6)))
          | exn: (throw exn)
  GEN_BETA_CONV

def initialization_1:
  extend_basic_convs(
