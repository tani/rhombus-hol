  let pth = Tactics.prove([Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"?6109\"],[\"Tyvar\",\"?6115\"]]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"?6109\"],[\"Tyvar\",\"?6115\"]]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?6109\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?6115\"],[\"Tyapp\",\"prod\",[[\"Tyvar\",\"?6109\"],[\"Tyvar\",\"?6115\"]]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"?6109\"]]],[\"Var\",\"y\",[\"Tyvar\",\"?6115\"]]]],[\"Var\",\"a\",[\"Tyapp\",\"prod\",[[\"Tyvar\",\"?6109\"],[\"Tyvar\",\"?6115\"]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?6109\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?6109\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"?6109\"]]],[\"Comb\",[\"Const\",\"FST\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"?6109\"],[\"Tyvar\",\"?6115\"]]],[\"Tyvar\",\"?6109\"]]]],[\"Var\",\"a\",[\"Tyapp\",\"prod\",[[\"Tyvar\",\"?6109\"],[\"Tyvar\",\"?6115\"]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?6115\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?6115\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"y\",[\"Tyvar\",\"?6115\"]]],[\"Comb\",[\"Const\",\"SND\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"?6109\"],[\"Tyvar\",\"?6115\"]]],[\"Tyvar\",\"?6115\"]]]],[\"Var\",\"a\",[\"Tyapp\",\"prod\",[[\"Tyvar\",\"?6109\"],[\"Tyvar\",\"?6115\"]]]]]]]]"), Meson.MESON_TAC(PairList.cons(PAIR, PairList.cons(PAIR_EQ, PairList [])))])
  let rewr1_CONV_2 = Simp.GEN_REWRITE_CONV(Equal.TOP_DEPTH_CONV)(PairList.cons(pth, PairList []))
  let rewr2_RULE_2 = Simp.GEN_REWRITE_RULE(o(Equal.LAND_CONV)(Equal.DEPTH_CONV))(PairList.cons(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?6129\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?6129\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"?6129\"]]],[\"Var\",\"x\",[\"Tyvar\",\"?6129\"]]]],[\"Const\",\"T\",[\"Tyapp\",\"bool\",[]]]]")), PairList.cons(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]],[\"Const\",\"T\",[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]")), PairList [])))
  let PROVE_DEPAIRING_EXISTS_2:
    fun(tm):
      let th1 = rewr1_CONV_2(tm)
      let tm1 = Fusion.rand(Fusion.concl(th1))
      let cjs = Basics.conjuncts(tm1)
      let vars = map(Equal.lhand)(cjs)
      let th2 = Fusion.EQ_MP(Equal.SYM(th1))(Fusion.ASSUME(tm1))
      let th3 = Bool.DISCH_ALL(itlist(Bool.SIMPLE_EXISTS)(vars)(th2))
      let th4 = Fusion.INST(map((fun(t): [Fusion.rand(t), Equal.lhand(t)]))(cjs))(th3)
      Bool.MP(rewr2_RULE_2(th4))(Bool.TRUTH)
  fun([asl, w] as gl):
    let path:
      try:
        Basics.find_path(is_trivlet_2)(w)
        ~catch exn:
          match exn
          | Failure(_): Basics.find_path(Basics.is_let)(w)
          | exn: Host.hol_raise(exn)
    let tm = Basics.follow_path(path)(w)
    let [assigs, bod] = Basics.dest_let(tm)
    let abbrevs = mapfilter((fun([x, y]): (if Host.hol_equal(x)(y) | Host.hol_apply_unit(fail) | Fusion.mk_eq([x, y]))))(assigs)
    let lvars_2 = itlist(o(o(union)(Fusion.frees))(Equal.lhs))(abbrevs)(PairList [])
    let avoids_2 = itlist(o(o(union)(Basics.thm_frees))(snd))(asl)(Fusion.frees(w))
    let rename = Fusion.vsubst(zip(Basics.variants(avoids_2)(lvars_2))(lvars_2))
    let abbrevs_prime:
      map(
        fun(eq):
          let [l, r] = Fusion.dest_eq(eq)
          Fusion.mk_eq([rename(l), r]))(abbrevs)
    let deprths = map(PROVE_DEPAIRING_EXISTS_2)(abbrevs_prime)
    Tactics.THEN(
      Tactics.MAP_EVERY(
        Tactics.REPEAT_TCL(Tactics.CHOOSE_THEN)(
          fun(th):
            let th_prime = Equal.SYM(th)
            Tactics.THEN(Tactics.SUBST_ALL_TAC(th_prime))(Tactics.ASSUME_TAC(th_prime))))(deprths))(
      W(
        fun([asl_prime, w_prime]):
          let tm_prime = Basics.follow_path(path)(w_prime)
          Tactics.CONV_TAC(Equal.PATH_CONV(path)(K(let_CONV(tm_prime))))))(gl)

fun SUBLET_CONV(conv):
  fun largconv(tm):
    match tm
    | Fusion.Comb(Fusion.Const("LET",_),_): Fusion.REFL(tm)
    | Fusion.Comb(l,r): Equal.COMB2_CONV(largconv)(conv)(tm)
    | _: failwith("SUBLET_CONV")
  (fun(tm): (if Basics.is_let(tm) | largconv(tm) | failwith("SUBLET_CONV")))

