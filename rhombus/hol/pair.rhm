def PAIRED_ETA_THM:
  prove(
    [
      @hol|{(!f:A#B->C. (\(x,y). f (x,y)) = f) /\
         (!f:A#B#C->D. (\(x,y,z). f (x,y,z)) = f) /\
         (!f:A#B#C#D->E. (\(w,x,y,z). f (w,x,y,z)) = f)}|,
      (
        REPEAT(STRIP_TAC) then_tac \
        REWRITE_TAC(PairList [FUN_EQ_THM, FORALL_PAIR_THM])
      )
    ]
  )

