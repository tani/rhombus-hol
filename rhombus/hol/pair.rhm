              Ref("P"),
              [
                Lambda(
                  "a",
                  Tvar("A"),
                  Lambda(
                    "b",
                    Tvar("B"),
                    App(
                      Ref("f"),
                      [
                        App(
                          Const(",", Fun(Tvar("A"), Fun(Tvar("B"), Tyapp("prod", [Tvar("A"), Tvar("B")])))),
                          [Ref("a"), Ref("b")]
                        )
