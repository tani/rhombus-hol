            Tvar("A"),
            App(
              Const("FST", Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Tvar("A"))),
              [
                App(
                  Const(",", Fun(Tvar("A"), Fun(Tvar("B"), Tyapp("prod", [Tvar("A"), Tvar("B")])))),
                  [Ref("x"), Ref("y")]
                )
              ]
            ),
            Ref("x")
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [FST_DEF])) then_tac \
                        MATCH_MP_TAC(SELECT_UNIQUE)
                      ) then_tac \
                      GEN_TAC
                    ) then_tac \
                    BETA_TAC
                  ) then_tac \
                  REWRITE_TAC(PairList [PAIR_EQ])
