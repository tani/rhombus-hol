def PASSOC_DEF = new_definition(Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyvar\",\"C\"]]],[\"Tyvar\",\"D\"]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"f\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyvar\",\"C\"]]],[\"Tyvar\",\"D\"]]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"y\",[\"Tyvar\",\"B\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"C\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"z\",[\"Tyvar\",\"C\"]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"D\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"D\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Var\",\"PASSOC\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyvar\",\"C\"]]],[\"Tyvar\",\"D\"]]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"prod\",[[\"Tyvar\",\"B\"],[\"Tyvar\",\"C\"]]]]],[\"Tyvar\",\"D\"]]]]]],[\"Var\",\"f\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyvar\",\"C\"]]],[\"Tyvar\",\"D\"]]]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"B\"],[\"Tyvar\",\"C\"]]],[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"prod\",[[\"Tyvar\",\"B\"],[\"Tyvar\",\"C\"]]]]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"C\"],[\"Tyapp\",\"prod\",[[\"Tyvar\",\"B\"],[\"Tyvar\",\"C\"]]]]]]]],[\"Var\",\"y\",[\"Tyvar\",\"B\"]]],[\"Var\",\"z\",[\"Tyvar\",\"C\"]]]]]],[\"Comb\",[\"Var\",\"f\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyvar\",\"C\"]]],[\"Tyvar\",\"D\"]]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"C\"],[\"Tyapp\",\"prod\",[[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]],[\"Tyvar\",\"C\"]]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"prod\",[[\"Tyvar\",\"A\"],[\"Tyvar\",\"B\"]]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"B\"]]]],[\"Var\",\"z\",[\"Tyvar\",\"C\"]]]]]]]]]]]]]"))

fun GABS_CONV(conv):
  fun(tm):
    if Fusion.is_abs(tm)
    | Equal.ABS_CONV(conv)(tm)
    | let [gabs, bod] = Fusion.dest_comb(tm)
      let [f, qtm] = Fusion.dest_abs(bod)
      let [xs, bod] = Basics.strip_forall(qtm)
      Equal.AP_TERM(gabs)(Fusion.ABS(f)(itlist(Drule.MK_FORALL)(xs)(Equal.RAND_CONV(conv)(bod))))

def GEN_BETA_CONV:
  let projection_cache = Box(PairList [])
  let create_projections:
    fun(conname):
      try:
        assoc(conname)(Host.ref_get(projection_cache))
        ~catch exn:
          match exn
          | Failure(_):
              let genty = Fusion.get_const_type(conname)
              let conty = fst(Fusion.dest_type(Host.repeat(o(snd)(Basics.dest_fun_ty))(genty)))
              let [_, _, rth] = assoc(conty)(Host.ref_get(Class.inductive_type_store))
              let sth = Bool.SPEC_ALL(rth)
              let [evs, bod] = Basics.strip_exists(Fusion.concl(sth))
              let cjs = Basics.conjuncts(bod)
              let ourcj = find(o(o(o(o(o(o(o(o(Host.hol_equal(conname))(fst))(Fusion.dest_const))(fst))(Basics.strip_comb))(Fusion.rand))(Equal.lhand))(snd))(Basics.strip_forall))(cjs)
              let n = Host.index(ourcj)(cjs)
              let [avs, eqn] = Basics.strip_forall(ourcj)
              let [con_prime, args] = Basics.strip_comb(Fusion.rand(eqn))
              let [aargs, zargs] = Host.chop_list(length(avs))(args)
              let gargs = map(o(Basics.genvar)(Fusion.type_of))(zargs)
              let gcon = Basics.genvar(itlist(o(Fusion.mk_fun_ty)(Fusion.type_of))(avs)(Fusion.type_of(Fusion.rand(eqn))))
              let bth = Fusion.INST(PairList.cons([Basics.list_mk_abs([append(aargs)(gargs), Basics.list_mk_comb([gcon, avs])]), con_prime], PairList []))(sth)
              let cth = Host.el(n)(Bool.CONJUNCTS(Fusion.ASSUME(snd(Basics.strip_exists(Fusion.concl(bth))))))
              let dth = Equal.CONV_RULE(Host.funpow(length(avs))(Equal.BINDER_CONV)(Equal.RAND_CONV(Drule.BETAS_CONV)))(cth)
              let eth = Bool.SIMPLE_EXISTS(Fusion.rator(Equal.lhand(snd(Basics.strip_forall(Fusion.concl(dth))))))(dth)
              let fth = Bool.PROVE_HYP(bth)(itlist(Bool.SIMPLE_CHOOSE)(evs)(eth))
              let zty = Fusion.type_of(Fusion.rand(snd(Basics.strip_forall(Fusion.concl(dth)))))
              let mk_projector:
                fun(a):
                  let ity = Fusion.type_of(a)
                  let th = Equal.BETA_RULE(Bool.PINST(PairList.cons([ity, zty], PairList []))(PairList.cons([Basics.list_mk_abs([avs, a]), gcon], PairList []))(fth))
                  Equal.SYM(Bool.SPEC_ALL(Class.SELECT_RULE(th)))
              let ths = map(mk_projector)(avs)
              Host.ref_set(projection_cache)(PairList.cons([conname, ths], Host.ref_get(projection_cache)))
              ths
          | exn: Host.hol_raise(exn)
  let GEQ_CONV_2 = Simp.REWR_CONV(Equal.GSYM(GEQ_DEF))
  let DEGEQ_RULE_2 = Equal.CONV_RULE(Simp.REWR_CONV(GEQ_DEF))
  let pth = Tactics.prove([Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?5216\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?5216\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?5216\"],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Const\",\"GABS\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?5216\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyvar\",\"?5216\"]]]],[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?5216\"],[\"Tyapp\",\"bool\",[]]]]]]]]"), Simp.SIMP_TAC(PairList.cons(GABS_DEF, PairList.cons(Class.SELECT_AX, PairList.cons(Class.ETA_AX, PairList []))))])
  let GABS_RULE = Drule.MATCH_MP(pth)
  fun create_iterated_projections(tm):
    if Host.hol_equal(Fusion.frees(tm))(PairList [])
    | PairList []
    | if Fusion.is_var(tm)
      | PairList.cons(Fusion.REFL(tm), PairList [])
      | let [con, args] = Basics.strip_comb(tm)
        let prjths = create_projections(fst(Fusion.dest_const(con)))
        let atm = Fusion.rand(Fusion.rand(Fusion.concl(hd(prjths))))
        let instn = Drule.term_match(PairList [])(atm)(tm)
        let arths = map(Drule.INSTANTIATE(instn))(prjths)
        let ths:
          map(
            fun(arth):
              let sths = create_iterated_projections(Equal.lhand(Fusion.concl(arth)))
              map(Equal.CONV_RULE(Equal.RAND_CONV(Equal.SUBS_CONV(PairList.cons(arth, PairList [])))))(sths))(arths)
        Host.unions_prime(Fusion.equals_thm)(ths)
  let GEN_BETA_CONV:
    fun(tm):
      try:
        Equal.BETA_CONV(tm)
        ~catch exn:
          match exn
          | Failure(_):
              let [l, r] = Fusion.dest_comb(tm)
              let [vstr, bod] = Basics.dest_gabs(l)
              let instn = Drule.term_match(PairList [])(vstr)(r)
              let prjs = create_iterated_projections(vstr)
              let th1 = Equal.SUBS_CONV(prjs)(bod)
              let bod_prime = Fusion.rand(Fusion.concl(th1))
              let gv = Basics.genvar(Fusion.type_of(vstr))
              let pat = Fusion.mk_abs([gv, Basics.subst(PairList.cons([gv, vstr], PairList []))(bod_prime)])
              let th2 = Fusion.TRANS(Equal.BETA_CONV(Fusion.mk_comb([pat, vstr])))(Equal.SYM(th1))
              let avs = fst(Basics.strip_forall(Basics.body(Fusion.rand(l))))
              let th3 = Bool.GENL(fst(Basics.strip_forall(Basics.body(Fusion.rand(l)))))(th2)
              let efn = Basics.genvar(Fusion.type_of(pat))
              let th4 = Bool.EXISTS([Bool.mk_exists([efn, Basics.subst(PairList.cons([efn, pat], PairList []))(Fusion.concl(th3))]), pat])(th3)
              let th5 = Equal.CONV_RULE(Host.funpow(Host.hol_add(length(avs))(1))(Equal.BINDER_CONV)(GEQ_CONV_2))(th4)
              let th6 = Equal.CONV_RULE(Equal.BETA_CONV)(GABS_RULE(th5))
              Drule.INSTANTIATE(instn)(DEGEQ_RULE_2(Bool.SPEC_ALL(th6)))
          | exn: Host.hol_raise(exn)
  GEN_BETA_CONV

Simp.extend_basic_convs(["GEN_BETA_CONV", [Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"GABS\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?5220\"],[\"Tyvar\",\"?5219\"]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?5220\"],[\"Tyvar\",\"?5219\"]]]]]],[\"Abs\",[\"Var\",\"a\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?5220\"],[\"Tyvar\",\"?5219\"]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"c\",[\"Tyvar\",\"?5220\"]]]"), GEN_BETA_CONV]])

