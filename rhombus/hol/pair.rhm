def let_CONV:
  let let1_CONV_2 = Equal.THENC(Simp.REWR_CONV(LET_DEF))(GEN_BETA_CONV)
  let lete_CONV_2 = Simp.REWR_CONV(LET_END_DEF)
  fun EXPAND_BETAS_CONV(tm):
    let tm_prime = Fusion.rator(tm)
    try:
      let1_CONV_2(tm)
      ~catch exn:
        match exn
        | Failure(_):
            let th1 = Equal.AP_THM(EXPAND_BETAS_CONV(tm_prime))(Fusion.rand(tm))
            let th2 = GEN_BETA_CONV(Fusion.rand(Fusion.concl(th1)))
            Fusion.TRANS(th1)(th2)
        | exn: Host.hol_raise(exn)
  fun(tm):
    let [ltm, pargs] = Basics.strip_comb(tm)
    if (Host.hol_unequal(fst(Fusion.dest_const(ltm)))("LET") || Host.hol_equal(pargs)(PairList []))
    | failwith("let_CONV")
    | let abstm = hd(pargs)
      let [vs, bod] = Basics.strip_gabs(abstm)
      let es = tl(pargs)
      let n = length(es)
      (if Host.hol_unequal(length(vs))(n) | failwith("let_CONV") | Equal.THENC(EXPAND_BETAS_CONV)(lete_CONV_2)(tm))

