    let port_tmp_1 = Up_meson.MESON_TAC(PairList []);
    let port_tmp_2 = Host.expand_quote("[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"bool\",[]]]]]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"a\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"b\",[\"Tyvar\",\"B\"]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"bool\",[]]]]]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"bool\",[]]]]]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"bool\",[]]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"mk_pair\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"B\"],[\"Tyapp\",\"bool\",[]]]]]]]]]]],[\"Var\",\"a\",[\"Tyvar\",\"A\"]]],[\"Var\",\"b\",[\"Tyvar\",\"B\"]]]]]]]]]]");
    Pair(port_tmp_2,port_tmp_1)
  »))
