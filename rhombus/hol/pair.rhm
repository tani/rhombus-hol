                    )
                  ),
                  [
                    Lambda(
                      "f",
                      Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Tvar("C")),
                      Forall(
                        "a",
                        Tvar("A"),
                        Forall(
                          "b",
                          Tvar("B"),
                          App(
                            Const("GEQ", Fun(Tvar("C"), Fun(Tvar("C"), Bool))),
                            [
                              App(
                                Ref("f"),
                                [
                                  App(
                                    Const(",", Fun(Tvar("A"), Fun(Tvar("B"), Tyapp("prod", [Tvar("A"), Tvar("B")])))),
                                    [Ref("a"), Ref("b")]
                                  )
                                ]
                              ),
                              App(Var("f", Fun(Tvar("A"), Fun(Tvar("B"), Tvar("C")))), [Ref("a"), Ref("b")])
                            ]
                          )
                        )
                      )
                    )
                  ]
                ))
              )
            )
          )
        ) then_tac \
        SIMP_TAC(PairList [ETA_AX])
      )
