fun GABS_CONV(conv):
  fun(tm):
    if is_abs(tm)
    | ABS_CONV(conv)(tm)
    | let [gabs, bod] = dest_comb(tm)
      let [f, qtm] = dest_abs(bod)
      let [xs, bod] = strip_forall(qtm)
      AP_TERM(gabs)(ABS(f)(itlist(MK_FORALL)(xs)(RAND_CONV(conv)(bod))))

def GEN_BETA_CONV:
  let projection_cache = Box(PairList [])
  let create_projections:
    fun(conname):
      try:
        assoc(conname)(projection_cache.value)
        ~catch exn:
          match exn
          | Failure(_):
              let genty = get_const_type(conname)
              let conty = fst(dest_type(repeat(o(snd)(dest_fun_ty))(genty)))
              let [_, _, rth] = assoc(conty)(inductive_type_store.value)
              let sth = SPEC_ALL(rth)
              let [evs, bod] = strip_exists(concl(sth))
              let cjs = conjuncts(bod)
              let ourcj:
                find(
                  o(
                    o(
                      o(
                        o(o(o(o(o((fun (y): conname == y))(fst))(dest_const))(fst))(strip_comb))(rand)
                      )(lhand)
                    )(snd)
                  )(strip_forall)
                )(cjs)
              let n = index(ourcj)(cjs)
              let [avs, eqn] = strip_forall(ourcj)
              let [con_prime, args] = strip_comb(rand(eqn))
              let [aargs, zargs] = chop_list(length(avs))(args)
              let gargs = map(o(genvar)(type_of))(zargs)
              let gcon = genvar(itlist(o(mk_fun_ty)(type_of))(avs)(type_of(rand(eqn))))
              let bth:
                INST(
                  PairList [
                    [list_mk_abs([append(aargs)(gargs), list_mk_comb([gcon, avs])]), con_prime]
                  ]
                )(sth)
              let cth = el(n)(CONJUNCTS(ASSUME(snd(strip_exists(concl(bth))))))
              let dth = CONV_RULE(funpow(length(avs))(BINDER_CONV)(RAND_CONV(BETAS_CONV)))(cth)
              let eth = SIMPLE_EXISTS(rator(lhand(snd(strip_forall(concl(dth))))))(dth)
              let fth = PROVE_HYP(bth)(itlist(SIMPLE_CHOOSE)(evs)(eth))
              let zty = type_of(rand(snd(strip_forall(concl(dth)))))
              let mk_projector:
                fun(a):
                  let ity = type_of(a)
                  let th = BETA_RULE(PINST(PairList [[ity, zty]])(PairList [[list_mk_abs([avs, a]), gcon]])(fth))
                  SYM(SPEC_ALL(SELECT_RULE(th)))
              let ths = map(mk_projector)(avs)
              projection_cache.value := PairList [[conname, ths], & projection_cache.value]
              ths
          | exn: (throw exn)
  let GEQ_CONV_2 = REWR_CONV(GSYM(GEQ_DEF))
  let DEGEQ_RULE_2 = CONV_RULE(REWR_CONV(GEQ_DEF))
  let pth:
    prove(
      [
        Host.hol_term(Implies(
          App(Const("?", Fun(Fun(Tvar("?5216"), Bool), Bool)), [Var("P", Fun(Tvar("?5216"), Bool))]),
          App(
            Var("P", Fun(Tvar("?5216"), Bool)),
            [
              App(
                Const("GABS", Fun(Fun(Tvar("?5216"), Bool), Tvar("?5216"))),
                [Var("P", Fun(Tvar("?5216"), Bool))]
              )
            ]
          )
        )),
        SIMP_TAC(PairList [GABS_DEF, SELECT_AX, ETA_AX])
      ]
    )
  let GABS_RULE = MATCH_MP(pth)
  fun create_iterated_projections(tm):
    if (frees(tm) == (PairList []))
    | PairList []
    | if is_var(tm)
      | PairList [REFL(tm)]
      | let [con, args] = strip_comb(tm)
        let prjths = create_projections(fst(dest_const(con)))
        let atm = rand(rand(concl(hd(prjths))))
        let instn = term_match(PairList [])(atm)(tm)
        let arths = map(INSTANTIATE(instn))(prjths)
        let ths:
          map(
            fun(arth):
              let sths = create_iterated_projections(lhand(concl(arth)))
              map(CONV_RULE(RAND_CONV(SUBS_CONV(PairList [arth]))))(sths)
          )(arths)
        unions_prime(equals_thm)(ths)
  let GEN_BETA_CONV:
    fun(tm):
      try:
        BETA_CONV(tm)
        ~catch exn:
          match exn
          | Failure(_):
              let [l, r] = dest_comb(tm)
              let [vstr, bod] = dest_gabs(l)
              let instn = term_match(PairList [])(vstr)(r)
              let prjs = create_iterated_projections(vstr)
              let th1 = SUBS_CONV(prjs)(bod)
              let bod_prime = rand(concl(th1))
              let gv = genvar(type_of(vstr))
              let pat = mk_abs([gv, subst(PairList [[gv, vstr]])(bod_prime)])
              let th2 = TRANS(BETA_CONV(mk_comb([pat, vstr])))(SYM(th1))
              let avs = fst(strip_forall(body(rand(l))))
              let th3 = GENL(fst(strip_forall(body(rand(l)))))(th2)
              let efn = genvar(type_of(pat))
              let th4 = EXISTS([mk_exists([efn, subst(PairList [[efn, pat]])(concl(th3))]), pat])(th3)
              let th5 = CONV_RULE(funpow((length(avs) + 1))(BINDER_CONV)(GEQ_CONV_2))(th4)
              let th6 = CONV_RULE(BETA_CONV)(GABS_RULE(th5))
              INSTANTIATE(instn)(DEGEQ_RULE_2(SPEC_ALL(th6)))
          | exn: (throw exn)
  GEN_BETA_CONV

