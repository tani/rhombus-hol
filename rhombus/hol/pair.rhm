                    BETA_TAC
                  ) then_tac \
                  REWRITE_TAC(PairList [PAIR_EQ])
                ) then_tac \
                EQ_TAC
              ) then_tac \
              STRIP_TAC
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          EXISTS_TAC(Host.hol_term(Var("x", Tvar("A"))))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def PAIR:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Tyapp("prod", [Tvar("A"), Tvar("B")]),
        Eq(
          Tyapp("prod", [Tvar("A"), Tvar("B")]),
          App(
            Const(",", Fun(Tvar("A"), Fun(Tvar("B"), Tyapp("prod", [Tvar("A"), Tvar("B")])))),
            [
              App(Const("FST", Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Tvar("A"))), [Ref("x")]),
              App(Const("SND", Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Tvar("B"))), [Ref("x")])
            ]
          ),
          Ref("x")
        )
      )),
      (
        (
          GEN_TAC then_tac \
          X_CHOOSE_THEN(Host.hol_term(Var("a", Tvar("A"))))(X_CHOOSE_THEN(Host.hol_term(Var("b", Tvar("B"))))(SUBST1_TAC))(SPEC(Host.hol_term(Var("x", Tyapp("prod", [Tvar("A"), Tvar("B")]))))(PAIR_SURJECTIVE))
        ) then_tac \
        REWRITE_TAC(PairList [FST, SND])
      )
    ]
  )

