#lang rhombus

// Direct translation of the pinned HOL Light parser.ml.

// =========================================================================
// Lexical analyzer, type and preterm parsers.
//
//       John Harrison, University of Cambridge Computer Laboratory
//
//            (c) Copyright, University of Cambridge 1998
//              (c) Copyright, John Harrison 1998-2007
//     (c) Copyright, Andrea Gabrielli, Marco Maggesi 2017-2018
// =========================================================================

// The parser reads the text of `@hol|{...}|` quotations at run time, against
// the binder, prefix, infix, interface and type tables of the theories loaded
// so far, exactly as HOL Light's quotation expander calls parse_term.

import:
  "lib.rhm" open
  "private/ocaml.rhm" open
  "fusion.rhm" open:
    only:
      get_const_type
      get_type_arity
  "printer.rhm" as Host:
    expose:
      isspace
      issep
      isbra
      issymb
      isalnum
      isnum
      reserve_words
      is_reserved_word
  "preterm.rhm" as TypeInference:
    expose:
      Varp
      Constp
      Combp
      Absp
      Typing
      Utv
      Ptycon
      dpty
  lib("racket/base.rkt") as Base:
    only:
      #{string->bytes/utf-8}
      #{bytes->string/latin-1}

export:
  Noparse
  |||
  ++
  >>
  many
  fix
  listof
  nothing
  elistof
  leftbin
  rightbin
  possibly
  some
  a
  atleast
  finished
  Ident
  Resword
  comment_token
  lex
  parse_pretype
  install_parser
  delete_parser
  installed_parsers
  try_user_parser
  parse_preterm
  parse_type
  parse_term

// -------------------------------------------------------------------------
// Need to have this now for set enums, since "," isn't a reserved word.
// -------------------------------------------------------------------------

Host.parse_as_infix([",", [14, "right"]])

// -------------------------------------------------------------------------
// Basic parser combinators. The infix `|||`, `++` and `>>` keep OCaml's
// precedence: `++` binds tighter than `>>` and `|||`, which share one level;
// all three associate to the left. A module that imports `++` from here no
// longer sees Rhombus' own `++`.
// -------------------------------------------------------------------------

class Noparse()

operator ((parser1 :: Function) ||| (parser2 :: Function)):
  ~associativity: ~left
  fun(input):
    try:
      parser1(input)
      ~catch Noparse(): parser2(input)

operator ((parser1 :: Function) ++ (parser2 :: Function)):
  ~associativity: ~left
  ~stronger_than: |||
  fun(input):
    let [result1, rest1] = parser1(input)
    let [result2, rest2] = parser2(rest1)
    [[result1, result2], rest2]

fun many(prs):
  fun(input):
    try:
      let [result, next] = prs(input)
      let [results, rest] = many(prs)(next)
      [PairList.cons(result, results), rest]
      ~catch Noparse(): [PairList [], input]

operator ((prs :: Function) >> (treatment :: Function)):
  ~associativity: ~left
  ~same_as: |||
  ~weaker_than: ++
  fun(input):
    let [result, rest] = prs(input)
    [treatment(result), rest]

fun fix(err):
  fun(prs):
    fun(input):
      try:
        prs(input)
        ~catch Noparse(): failwith(err +& " expected")

fun listof(prs):
  fun(sep):
    fun(err):
      prs ++ many(sep ++ fix(err)(prs) >> snd) >> (fun([h, t]): PairList.cons(h, t))

fun nothing(input): [PairList [], input]

fun elistof(prs):
  fun(sep):
    fun(err):
      listof(prs)(sep)(err) ||| nothing

fun leftbin(prs):
  fun(sep):
    fun(cons):
      fun(err):
        (prs ++ many(sep ++ fix(err)(prs))
           >> (fun([x, opxs]):
                 let [ops, xs] = unzip(opxs)
                 itlist2(fun(op): fun(y): fun(x): cons(op)(x)(y))(rev(ops))(rev(xs))(x)))

fun rightbin(prs):
  fun(sep):
    fun(cons):
      fun(err):
        (prs ++ many(sep ++ fix(err)(prs))
           >> (fun([x, opxs]):
                 if opxs == PairList []
                 | x
                 | let [ops, xs] = unzip(opxs)
                   itlist2(cons)(ops)(PairList.cons(x, butlast(xs)))(last(xs))))

fun possibly(prs):
  fun(input):
    try:
      let [x, rest] = prs(input)
      [PairList [x], rest]
      ~catch Noparse(): [PairList [], input]

fun some(p):
  fun(input):
    match input
    | PairList []: throw Noparse()
    | PairList [h, & t]:
        if p(h)
        | [h, t]
        | throw Noparse()

fun a(tok): some(fun(item): item == tok)

fun atleast(n):
  fun(prs):
    fun(i):
      (if n <= 0
       | many(prs)
       | prs ++ atleast(n - 1)(prs) >> (fun([h, t]): PairList.cons(h, t)))(i)

fun finished(input):
  if input == PairList [] | [0, input] | failwith("Unparsed input")

// -------------------------------------------------------------------------
// The basic lexical classes: identifiers, strings and reserved words.
// -------------------------------------------------------------------------

class Ident(name):
  extends HolVariant
  override ocaml_view(): [0, PairList [this.name]]
class Resword(name):
  extends HolVariant
  override ocaml_view(): [1, PairList [this.name]]

// -------------------------------------------------------------------------
// Lexical analyzer. Apart from some special bracket symbols, each
// identifier is made up of the longest string of alphanumerics or
// the longest string of symbolics.
// -------------------------------------------------------------------------

reserve_words(PairList ["//"])

def comment_token = Box(Resword("//"))

def lex:
  let collect = fun([h, t]): end_itlist(fun(x): fun(y): x +& y)(PairList.cons(h, t))
  let reserve:
    fun(tok):
      match tok
      | Ident(n):
          if is_reserved_word(n) | Resword(n) | tok
      | t: t
  let stringof = fun(p): atleast(1)(p) >> end_itlist(fun(x): fun(y): x +& y)
  let simple_ident = stringof(some(isalnum)) ||| stringof(some(issymb))
  let undertail = stringof(a("_")) ++ possibly(simple_ident) >> collect
  let ident = (undertail ||| simple_ident) ++ many(undertail) >> collect
  let septok = stringof(some(issep))
  let escapecode:
    fun(i):
      match i
      | PairList ["\\", & rst]: ["\\", rst]
      | PairList ["\"", & rst]: ["\"", rst]
      | PairList ["'", & rst]: ["'", rst]
      | PairList ["n", & rst]: ["\n", rst]
      | PairList ["r", & rst]: ["\r", rst]
      | PairList ["t", & rst]: ["\t", rst]
      | PairList ["b", & rst]: ["\b", rst]
      | PairList [" ", & rst]: [" ", rst]
      | PairList ["x", h, l, & rst]:
          [hol_string_make(1)(hol_char_chr(hol_int_of_string("0x" +& h +& l))), rst]
      | PairList [a, b, c, & rst] when forall(isnum)(PairList [a, b, c]):
          [hol_string_make(1)(hol_char_chr(hol_int_of_string(a +& b +& c))), rst]
      | _: failwith("lex:unrecognized OCaml-style escape in string")
  let stringchar:
    (some(fun(i): i != "\\" && i != "\"")
       ||| (a("\\") ++ escapecode >> snd))
  let string:
    (a("\"") ++ many(stringchar) ++ a("\"")
       >> (fun([[_, s], _]): "\"" +& implode(s) +& "\""))
  let rawtoken = (string ||| some(isbra) ||| septok ||| ident) >> (fun(x): Ident(x))
  let simptoken = many(some(isspace)) ++ rawtoken >> o(reserve)(snd)
  fun tokens(i):
    try:
      let [t, rst] = simptoken(i)
      if t == comment_token.value
      | (many(fun(i): if i != PairList [] && hd(i) != "\n" | [1, tl(i)] | throw Noparse())
           ++ tokens
           >> snd)(rst)
      | let [toks, rst1] = tokens(rst)
        [PairList.cons(t, toks), rst1]
      ~catch Noparse(): [PairList [], i]
  o(fst)(tokens ++ many(some(isspace)) ++ finished >> o(fst)(fst))

// -------------------------------------------------------------------------
// Parser for pretypes. Concrete syntax:
//
// TYPE        :: SUMTYPE -> TYPE
//              | SUMTYPE
//
// SUMTYPE     :: PRODTYPE + SUMTYPE
//              | PRODTYPE
//
// PRODTYPE    :: POWTYPE # PRODTYPE
//              | POWTYPE
//
// POWTYPE     :: APPTYPE ^ POWTYPE
//              | APPTYPE
//
// APPTYPE     :: ATOMICTYPES type-constructor  [Provided arity matches]
//              | ATOMICTYPES                   [Provided only 1 ATOMICTYPE]
//
// ATOMICTYPES :: type-constructor              [Provided arity zero]
//              | type-variable
//              | ( TYPE )
//              | ( TYPE LIST )
//
// TYPELIST    :: TYPE , TYPELIST
//              | TYPE
//
// Two features make this different from previous HOL type syntax:
//
//  o Any identifier not in use as a type constant will be parsed as a
//    type variable; a ' is not needed and a * is not allowed.
//
//  o Antiquotation is not supported.
// -------------------------------------------------------------------------

def parse_pretype:
  let mk_prefinty:
    fun prefinty(n):
      if n == num_1
      | Ptycon("1", PairList [])
      | let c = (if mod_num(n)(num_2) == num_0 | "tybit0" | "tybit1")
        Ptycon(c, PairList [prefinty(quo_num(n)(num_2))])
    fun(n):
      if n < num_1 | failwith("mk_prefinty") | prefinty(n)
  let btyop = fun(n): fun(_n_prime): fun(x): fun(y): Ptycon(n, PairList [x, y])
  let mk_apptype:
    fun
    | ([PairList [s], PairList []]): s
    | ([tys, PairList [c]]): Ptycon(c, tys)
    | (_): failwith("Bad type construction")
  let has_arity:
    fun(test):
      fun(s):
        try:
          test(get_type_arity(s))
          ~catch Failure(_): #false
  let type_atom:
    fun(input):
      match input
      | PairList [Ident(s), & rest]:
          let ty:
            try:
              TypeInference.pretype_of_type(assoc(s)(TypeInference.type_abbrevs(#void)))
              ~catch Failure(_):
                try:
                  mk_prefinty(num_of_string(s))
                  ~catch Failure(_):
                    if has_arity(fun(n): n == 0)(s) | Ptycon(s, PairList []) | Utv(s)
          [ty, rest]
      | _: throw Noparse()
  let type_constructor:
    fun(input):
      match input
      | PairList [Ident(s), & rest]:
          if has_arity(fun(n): n > 0)(s) | [s, rest] | throw Noparse()
      | _: throw Noparse()
  // The type grammar is mutually recursive.
  fun pretype(i):
    rightbin(sumtype)(a(Resword("->")))(btyop("fun"))("proper use of type operator (->)")(i)
  fun sumtype(i):
    rightbin(prodtype)(a(Ident("+")))(btyop("sum"))("proper use of type operator (+)")(i)
  fun prodtype(i):
    rightbin(carttype)(a(Ident("#")))(btyop("prod"))("proper use of type operator (#)")(i)
  fun carttype(i):
    leftbin(apptype)(a(Ident("^")))(btyop("cart"))("proper use of type operator (^)")(i)
  fun apptype(i):
    (atomictypes ++ (type_constructor >> (fun(x): PairList [x])
                       ||| nothing) >> mk_apptype)(i)
  fun atomictypes(i):
    ((a(Resword("(")) ++ typelist ++ a(Resword(")")) >> o(snd)(fst))
       ||| (type_atom >> (fun(x): PairList [x])))(i)
  fun typelist(i):
    listof(pretype)(a(Ident(",")))("comma separated list for type constructor")(i)
  pretype

// -------------------------------------------------------------------------
// Hook to allow installation of user parsers.
// -------------------------------------------------------------------------

def parser_list = Box(PairList [])
fun try_parsers(ps):
  fun(i):
    if ps == PairList []
    | throw Noparse()
    | try:
        snd(hd(ps))(i)
        ~catch Noparse(): try_parsers(tl(ps))(i)
fun install_parser(dat): parser_list.value := PairList.cons(dat, parser_list.value)
fun delete_parser(key):
  try:
    parser_list.value := snd(remove(fun([key_prime, _]): key == key_prime)(parser_list.value))
    ~catch Failure(_): #void
fun installed_parsers(_): parser_list.value
fun try_user_parser(i): try_parsers(parser_list.value)(i)

// -------------------------------------------------------------------------
// Initial preterm parsing. This uses binder and precedence/associativity/
// prefix status to guide parsing and preterm construction, but treats all
// identifiers as variables.
//
// PRETERM            :: APPL_PRETERM binop APPL_PRETERM
//                     | APPL_PRETERM
//
// APPL_PRETERM       :: APPL_PRETERM : type
//                     | APPL_PRETERM BINDER_PRETERM
//                     | BINDER_PRETERM
//
// BINDER_PRETERM     :: binder VARSTRUCT_PRETERMS . PRETERM
//                     | let PRETERM and ... and PRETERM in PRETERM
//                     | ATOMIC_PRETERM
//
// VARSTRUCT_PRETERMS :: TYPED_PRETERM VARSTRUCT_PRETERMS
//                     | TYPED_PRETERM
//
// TYPED_PRETERM      :: TYPED_PRETERM : type
//                     | ATOMIC_PRETERM
//
// ATOMIC_PRETERM     :: ( PRETERM )
//                     | if PRETERM then PRETERM else PRETERM
//                     | [ PRETERM; .. ; PRETERM ]
//                     | { PRETERM, .. , PRETERM }
//                     | { PRETERM | PRETERM }
//                     | identifier
//
// Note that arbitrary preterms are allowed as varstructs. This allows
// more general forms of matching and considerably regularizes the syntax.
// -------------------------------------------------------------------------

def gcounter = Box(0)

def parse_preterm:
  fun pairwise(r):
    fun(l):
      match l
      | PairList []: #true
      | PairList [h, & t]: forall(r(h))(t) && pairwise(r)(t)
  fun pfrees(ptm):
    match ptm
    | Varp(v, pty):
        if v == "" && pty == dpty
        | PairList []
        | if can(get_const_type)(v) || can(num_of_string)(v)
               || exists(fun([w, _]): v == w)(Host.the_interface.value)
          | PairList []
          | PairList [ptm]
    | Constp(_, _): PairList []
    | Combp(p1, p2): union(pfrees(p1))(pfrees(p2))
    | Absp(p1, p2): subtract(pfrees(p2))(pfrees(p1))
    | Typing(p, _): pfrees(p)
  let pdest_eq:
    fun
    | (Combp(Combp(Varp("=", _), l), r)): [l, r]
    | (Combp(Combp(Varp("<=>", _), l), r)): [l, r]
  let pmk_let:
    fun([letbindings, body]):
      let [vars, tms] = unzip(map(pdest_eq)(letbindings))
      warn(!pairwise(fun(s): fun(t): intersect(pfrees(s))(pfrees(t)) == PairList [])(vars))(
        "duplicate names on left of let-binding: latest is used")
      let lend = Combp(Varp("LET_END", dpty), body)
      let abs = itlist(fun(v): fun(t): Absp(v, t))(vars)(lend)
      let labs = Combp(Varp("LET", dpty), abs)
      rev_itlist(fun(x): fun(f): Combp(f, x))(tms)(labs)
  let pmk_vbinder:
    fun([n, v, bod]):
      if n == "\\" | Absp(v, bod) | Combp(Varp(n, dpty), Absp(v, bod))
  let pmk_binder:
    fun([n, vs, bod]): itlist(fun(v): fun(b): pmk_vbinder([n, v, b]))(vs)(bod)
  let pmk_set_enum:
    fun(ptms):
      itlist(fun(x): fun(t): Combp(Combp(Varp("INSERT", dpty), x), t))(ptms)(Varp("EMPTY", dpty))
  let pgenvar:
    fun():
      let count = gcounter.value
      gcounter.value := count + 1
      Varp("GEN%PVAR%" +& to_string(count), dpty)
  let pmk_exists = fun([v, ptm]): Combp(Varp("?", dpty), Absp(v, ptm))
  let pmk_list:
    fun(els): itlist(fun(x): fun(y): Combp(Combp(Varp("CONS", dpty), x), y))(els)(Varp("NIL", dpty))
  let pmk_bool:
    let tt = Varp("T", dpty)
    let ff = Varp("F", dpty)
    fun(b): if b | tt | ff
  let pmk_char:
    fun(c):
      let lis = map(fun(i): pmk_bool(((c bits.(>>) i) mod 2) == 1))(range(0)(7))
      itlist(fun(x): fun(y): Combp(y, x))(lis)(Varp("ASCII", dpty))
  // Strings reach the parser as byte strings (see parse_term), so each
  // character code is a byte, as with OCaml's String.get.
  let pmk_string:
    fun(s :: String):
      let ns = map(fun(i): Char.to_int(s[i]))(range(0)(s.length() - 1))
      pmk_list(map(pmk_char)(ns))
  let pmk_setcompr:
    fun([fabs, bvs, babs]):
      let v = pgenvar()
      let bod:
        itlist(curry(pmk_exists))(bvs)(
          Combp(Combp(Combp(Varp("SETSPEC", dpty), v), babs), fabs))
      Combp(Varp("GSPEC", dpty), Absp(v, bod))
  let pmk_setabs:
    fun([fabs, babs]):
      let evs:
        let fvs = pfrees(fabs)
        let bvs = pfrees(babs)
        if length(fvs) <= 1 || bvs == PairList [] | fvs | intersect(fvs)(bvs)
      pmk_setcompr([fabs, evs, babs])
  fun mk_precedence(infxs):
    fun(prs):
      fun(inp):
        match infxs
        | PairList [[s, [p, at]], & _]:
            let [topins, rest] = partition(fun([s_prime, pat_prime]): pat_prime == [p, at])(infxs)
            (if at == "right" | rightbin | leftbin)(
              mk_precedence(rest)(prs))(
              end_itlist(fun(x): fun(y): x ||| y)(map(fun([s, _]): a(Ident(s)))(topins)))(
              fun(Ident(op)): fun(x): fun(y): Combp(Combp(Varp(op, dpty), x), y))(
              "term after binary operator")(
              inp)
        | _: prs(inp)
  let pmk_geq = fun(s): fun(t): Combp(Combp(Varp("GEQ", dpty), s), t)
  let pmk_pattern:
    fun([[pat, guards], res]):
      let x = pgenvar()
      let y = pgenvar()
      let vs = pfrees(pat)
      let bod:
        if guards == PairList []
        | Combp(Combp(Varp("_UNGUARDED_PATTERN", dpty), pmk_geq(pat)(x)),
                pmk_geq(res)(y))
        | Combp(Combp(Combp(Varp("_GUARDED_PATTERN", dpty), pmk_geq(pat)(x)),
                      hd(guards)),
                pmk_geq(res)(y))
      Absp(x, Absp(y, itlist(curry(pmk_exists))(vs)(bod)))
  let pretype = parse_pretype
  fun is_string_token(s :: String):
    s.length() >= 2 && s.substring(0, 1) == "\"" && s.substring(s.length() - 1, s.length()) == "\""
  let string:
    fun(inp):
      match inp
      | PairList [Ident(s), & rst] when is_string_token(s): [s.substring(1, s.length() - 1), rst]
      | _: throw Noparse()
  let singleton1 = fun(x): PairList [x]
  let lmk_ite = fun([[[[[_, b], _], l], _], r]): Combp(Combp(Combp(Varp("COND", dpty), b), l), r)
  let lmk_typed:
    fun
    | ([p, PairList []]): p
    | ([p, PairList [ty]]): Typing(p, ty)
    | (_): fail(#void)
  let lmk_let = fun([[[_, bnds], _], ptm]): pmk_let([bnds, ptm])
  let lmk_binder = fun([[[[s, h], t], _], p]): pmk_binder([s, PairList.cons(h, t), p])
  let lmk_setenum = fun([l, _]): pmk_set_enum(l)
  let lmk_setabs = fun([[[l, _], r], _]): pmk_setabs([l, r])
  let lmk_setcompr:
    fun([[[[[f, _], vs], _], b], _]):
      pmk_setcompr([f, pfrees(vs), b])
  let lmk_decimal:
    fun([[_, l0], ropt]):
      let [l, r]:
        if ropt == PairList []
        | [l0, "1"]
        | let r0 = hd(ropt)
          let n_l = num_of_string(l0)
          let n_r = num_of_string(r0)
          let n_d = power_num(10)(r0.length())
          let n_n = n_l * n_d + n_r
          [to_string(n_n), to_string(n_d)]
      Combp(Combp(Varp("DECIMAL", dpty), Varp(l, dpty)), Varp(r, dpty))
  let lmk_univ:
    fun([[_, pty], _]):
      Typing(Varp("UNIV", dpty), Ptycon("fun", PairList [pty, Ptycon("bool", PairList [])]))
  let any_identifier:
    fun
    | (PairList [Ident(s), & rest]): [s, rest]
    | (_): throw Noparse()
  let identifier:
    fun
    | (PairList [Ident(s), & rest]):
        if can(Host.get_infix_status)(s) || Host.is_prefix(s) || Host.parses_as_binder(s)
        | throw Noparse()
        | [s, rest]
    | (_): throw Noparse()
  let binder:
    fun
    | (PairList [Ident(s), & rest]):
        if Host.parses_as_binder(s) | [s, rest] | throw Noparse()
    | (_): throw Noparse()
  let pre_fix:
    fun
    | (PairList [Ident(s), & rest]):
        if Host.is_prefix(s) | [s, rest] | throw Noparse()
    | (_): throw Noparse()
  fun fails(msg): fun(_): failwith(msg)
  // The preterm grammar is mutually recursive.
  fun preterm(i):
    mk_precedence(Host.infixes(#void))(typed_appl_preterm)(i)
  fun nocommapreterm(i):
    let infs = filter(fun([s, _]): s != ",")(Host.infixes(#void))
    mk_precedence(infs)(typed_appl_preterm)(i)
  fun typed_appl_preterm(i):
    (appl_preterm
       ++ possibly(a(Resword(":")) ++ pretype >> snd)
       >> lmk_typed)(i)
  fun appl_preterm(i):
    (pre_fix ++ appl_preterm
       >> (fun([x, y]): Combp(Varp(x, dpty), y))
       ||| (binder_preterm ++ many(binder_preterm)
              >> (fun([h, t]): itlist(fun(x): fun(y): Combp(y, x))(rev(t))(h))))(i)
  fun binder_preterm(i):
    ((a(Resword("let"))
        ++ leftbin(preterm >> singleton1)(a(Resword("and")))(K(append))("binding")
        ++ a(Resword("in"))
        ++ preterm
        >> lmk_let)
       ||| (binder
              ++ typed_apreterm
              ++ many(typed_apreterm)
              ++ a(Resword("."))
              ++ preterm
              >> lmk_binder)
       ||| atomic_preterm)(i)
  fun typed_apreterm(i):
    (atomic_preterm
       ++ possibly(a(Resword(":")) ++ pretype >> snd)
       >> lmk_typed)(i)
  fun atomic_preterm(i):
    (try_user_parser
       ||| ((a(Resword("(")) ++ a(Resword(":"))) ++ pretype ++ a(Resword(")"))
              >> lmk_univ)
       ||| ((a(Resword("(")) ++ a(Resword(":"))) ++ pretype
              >> fails("closing right parenthesis on universe expected"))
       ||| ((a(Resword("(")) ++ a(Resword(":")))
              >> fails("type in universe construction expected"))
       ||| (string >> pmk_string)
       ||| (a(Resword("("))
              ++ (any_identifier >> (fun(s): Varp(s, dpty)))
              ++ a(Resword(")"))
              >> o(snd)(fst))
       ||| (a(Resword("("))
              ++ preterm
              ++ a(Resword(")"))
              >> o(snd)(fst))
       ||| (a(Resword("if"))
              ++ preterm
              ++ a(Resword("then"))
              ++ preterm
              ++ a(Resword("else"))
              ++ preterm
              >> lmk_ite)
       ||| (a(Resword("if")) ++ preterm ++ a(Resword("then")) ++ preterm ++ a(Resword("else"))
              >> fails("malformed else clause"))
       ||| (a(Resword("if")) ++ preterm ++ a(Resword("then")) ++ preterm
              >> fails("missing else following then clause"))
       ||| (a(Resword("if")) ++ preterm ++ a(Resword("then"))
              >> fails("malformed then clause in if-then-else statement"))
       ||| (a(Resword("if")) ++ preterm
              >> fails("missing 'then' reserved word in if-then-else statement"))
       ||| (a(Resword("if"))
              >> fails("malformed if-then-else"))
       ||| (a(Resword("["))
              ++ elistof(preterm)(a(Resword(";")))("semicolon separated list of terms")
              ++ a(Resword("]"))
              >> o(pmk_list)(o(snd)(fst)))
       ||| (a(Resword("["))
              ++ elistof(preterm)(a(Resword(";")))("semicolon separated list of terms")
              >> fails("closing square bracket of list expected"))
       ||| (a(Resword("{"))
              ++ (elistof(nocommapreterm)(a(Ident(",")))("comma separated list of terms") ++ a(Resword("}"))
                    >> lmk_setenum
                    ||| (preterm ++ a(Resword("|")) ++ preterm ++ a(Resword("}"))
                           >> lmk_setabs)
                    ||| (preterm ++ a(Resword("|")) ++ preterm
                           ++ a(Resword("|")) ++ preterm ++ a(Resword("}"))
                           >> lmk_setcompr))
              >> snd)
       ||| (a(Resword("{")) >> fails("malformed set {}"))
       ||| (a(Resword("match")) ++ preterm ++ a(Resword("with")) ++ clauses
              >> (fun([[[_, e], _], c]): Combp(Combp(Varp("_MATCH", dpty), e), c)))
       ||| (a(Resword("match")) >> fails("malformed match-with statement"))
       ||| (a(Resword("function")) ++ clauses
              >> (fun([_, c]): Combp(Varp("_FUNCTION", dpty), c)))
       ||| (a(Resword("function")) >> fails("malformed function and pattern clauses"))
       ||| (a(Ident("#")) ++ identifier
              ++ possibly(a(Resword(".")) ++ identifier >> snd)
              >> lmk_decimal)
       ||| (a(Ident("#")) >> fails("malformed numerical # identifier"))
       ||| (identifier >> (fun(s): Varp(s, dpty))))(i)
  fun pattern(i):
    (preterm ++ possibly(a(Resword("when")) ++ preterm >> snd))(i)
  fun clause(i):
    ((pattern ++ (a(Resword("->")) ++ preterm >> snd)) >> pmk_pattern)(i)
  fun clauses(i):
    ((possibly(a(Resword("|")))
        ++ listof(clause)(a(Resword("|")))("pattern-match clause") >> snd)
       >> end_itlist(fun(s): fun(t): Combp(Combp(Varp("_SEQPATTERN", dpty), s), t)))(i)
  fun(inp):
    match inp
    | PairList [Ident(s)] when !is_string_token(s): [Varp(s, dpty), PairList []]
    | _: preterm(inp)

// -------------------------------------------------------------------------
// Type and term parsers.
// -------------------------------------------------------------------------

// OCaml strings are byte strings, and explode splits them into bytes. The
// text is read the same way: each byte of its UTF-8 encoding becomes one
// character, so string literals encode bytes as upstream and other
// non-ASCII text is rejected by the lexer as upstream does.
fun explode_bytes(s :: String):
  explode(to_string(Base.#{bytes->string/latin-1}(Base.#{string->bytes/utf-8}(s))))

fun parse_type(s):
  let [pty, l] = o(parse_pretype)(o(lex)(explode_bytes))(s)
  if l == PairList []
  | TypeInference.type_of_pretype(pty)
  | failwith("Unparsed input following type")

fun parse_term(s):
  let [ptm, l] = o(parse_preterm)(o(lex)(explode_bytes))(s)
  if l == PairList []
  | o(TypeInference.term_of_preterm)(TypeInference.retypecheck(PairList []))(ptm)
  | failwith("Unparsed input following term")
