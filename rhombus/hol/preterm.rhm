import: "compat.rhm" open
import: "fusion.rhm" open
import: "basics.rhm" open
import: "syntax_state.rhm" open
import: "surface_state.rhm" open

export:
  ignore_constant_varstruct
  type_invention_warning
  type_invention_error
  the_implicit_types
  make_overloadable
  remove_interface
  reduce_interface
  override_interface
  overload_interface
  prioritize_overload
  new_type_abbrev
  remove_type_abbrev
  type_abbrevs
  Utv
  Ptycon
  Stv
  dpty
  pretype_of_type
  Varp
  Constp
  Combp
  Absp
  Typing
  preterm_of_term
  type_of_pretype
  term_of_preterm
  retypecheck

def mutable ignore_constant_varstruct = #true
def mutable type_invention_warning = #true
def mutable type_invention_error = #false
def mutable the_implicit_types = PairList []

fun make_overloadable(s):
  fun(gty):
    if can(assoc(s))(the_overload_skeletons)
    | if assoc(s)(the_overload_skeletons) == gty
      | #void
      | failwith("make_overloadable: differs from existing skeleton")
    | the_overload_skeletons := PairList.cons(Pair(s,gty),the_overload_skeletons)

fun remove_interface(sym):
  the_interface := filter(fun(Pair(s,_)): s != sym)(the_interface)

fun reduce_interface(Pair(sym,tm)):
  def namty:
    try: dest_const(tm)
    ~catch Failure(_): dest_var(tm)
  the_interface := filter(fun(Pair(s,nt)): !(s == sym && nt == namty))(the_interface)

fun override_interface(Pair(sym,tm)):
  def namty:
    try: dest_const(tm)
    ~catch Failure(_): dest_var(tm)
  remove_interface(sym)
  the_interface := PairList.cons(Pair(sym,namty),the_interface)

fun overload_interface(Pair(sym,tm)):
  def gty:
    try: assoc(sym)(the_overload_skeletons)
    ~catch Failure(_): failwith("symbol "" +& sym +& "" is not overloadable")
  def namty:
    try: dest_const(tm)
    ~catch Failure(_): dest_var(tm)
  def Pair(_,ty) = namty
  if !can(type_match(gty)(ty))(PairList [])
  | failwith("Not an instance of type skeleton")
  | block:
      the_interface := filter(fun(Pair(s,nt)): !(s == sym && nt == namty))(the_interface)
      the_interface := PairList.cons(Pair(sym,namty),the_interface)

fun prioritize_overload(ty):
  for(Pair(s,gty) in the_overload_skeletons):
    try:
      def Pair(_,Pair(n,t)) =
        find(
          fun(Pair(s1,Pair(_,t1))):
            s1 == s && mem(ty)(map(fst)(type_match(gty)(t1)(PairList [])))
        )(the_interface)
      overload_interface(Pair(s,mk_var(Pair(n,t))))
      ~catch Failure(_): #void

def mutable type_abbreviation_list = PairList []
fun remove_type_abbrev(s):
  type_abbreviation_list := filter(fun(Pair(s1,_)): s1 != s)(type_abbreviation_list)
fun new_type_abbrev(Pair(s,ty)):
  remove_type_abbrev(s)
  type_abbreviation_list := PairList.cons(Pair(s,ty),type_abbreviation_list)
fun type_abbrevs(): type_abbreviation_list

class Pretype()
class Utv(name):
  extends Pretype
class Ptycon(name,args):
  extends Pretype
class Stv(index):
  extends Pretype

def dpty = Ptycon("",PairList [])

fun pretype_of_type(ty):
  match ty
  | Tyvar(s): Utv(s)
  | Tyapp(con,args): Ptycon(con,map(pretype_of_type)(args))

class Preterm()
class Varp(name,pty):
  extends Preterm
class Constp(name,pty):
  extends Preterm
class Combp(func,arg):
  extends Preterm
class Absp(var,body):
  extends Preterm
class Typing(term,pty):
  extends Preterm

fun preterm_of_term(tm):
  try:
    def Pair(n,ty) = dest_var(tm)
    Varp(n,pretype_of_type(ty))
  ~catch Failure(_):
    try:
      def Pair(n,ty) = dest_const(tm)
      Constp(n,pretype_of_type(ty))
    ~catch Failure(_):
      try:
        def Pair(v,bod) = dest_abs(tm)
        Absp(preterm_of_term(v),preterm_of_term(bod))
      ~catch Failure(_):
        def Pair(l,r) = dest_comb(tm)
        Combp(preterm_of_term(l),preterm_of_term(r))

def mutable tyv_num = 0
fun new_type_var():
  def n = tyv_num
  tyv_num := n+1
  Stv(n)

fun pretype_subst(th):
  fun(ty):
    match ty
    | Ptycon(c,args): Ptycon(c,map(pretype_subst(th))(args))
    | Utv(_):
        try: rev_assoc(ty)(th)
        ~catch Failure(_): ty
    | _: failwith("pretype_subst: Unexpected form of pretype")

fun pretype_instance(ty):
  def gty = pretype_of_type(ty)
  def tvs = map(pretype_of_type)(tyvars(ty))
  def subs = map(fun(tv): Pair(new_type_var(),tv))(tvs)
  pretype_subst(subs)(gty)

fun get_generic_type(cname):
  def matches = filter(fun(Pair(s,_)): s == cname)(the_interface)
  match matches
  | PairList [Pair(_,Pair(_,ty))]: ty
  | PairList [_,_, & _]:
      assoc(cname)(the_overload_skeletons)
  | PairList []: get_const_type(cname)

fun get_var_type(vname): assoc(vname)(the_implicit_types)

fun env_lookup(i,env):
  try: assoc(i)(env)
  ~catch Failure(_): #false

fun solve(env):
  fun(pty):
    match pty
    | Ptycon(f,args): Ptycon(f,map(solve(env))(args))
    | Stv(i):
        def x = env_lookup(i,env)
        if x | solve(env)(x) | pty
    | _: pty

fun free_stvs(ty):
  fun collect(t,acc):
    match t
    | Stv(n): insert(n)(acc)
    | Utv(_): acc
    | Ptycon(_,args): itlist(fun(x): fun(a): collect(x,a))(args)(acc)
  collect(ty,PairList [])

fun type_of_pretype_base(ty):
  match ty
  | Stv(n): Pair(mk_vartype("?" +& to_string(n)),#true)
  | Utv(v): Pair(mk_vartype(v),#false)
  | Ptycon(con,args):
      def pairs = map(type_of_pretype_base)(args)
      def Pair(ts,flags) = unzip(pairs)
      Pair(mk_type(Pair(con,ts)),exists(I)(flags))

fun type_of_pretype(ty): fst(type_of_pretype_base(ty))

fun istrivial(env):
  fun(x):
    fun(ty):
      match ty
      | Stv(y):
          y == x || (env_lookup(y,env) && istrivial(env)(x)(env_lookup(y,env)))
      | Ptycon(_,args):
          if exists(istrivial(env)(x))(args)
          | failwith("typechecking error: recursive type")
          | #false
      | _: #false

fun unify(env):
  fun(ty1):
    fun(ty2):
      def a = solve(env)(ty1)
      def b = solve(env)(ty2)
      if a == b
      | env
      | match Pair(a,b)
        | Pair(Ptycon(f,fa),Ptycon(g,ga)):
            if f != g || length(fa) != length(ga)
            | failwith("typechecking error: types cannot be unified")
            | itlist2(fun(x): fun(y): fun(e): unify(e)(x)(y))(fa)(ga)(env)
        | Pair(Stv(x),t):
            if istrivial(env)(x)(t)
            | env
            | PairList.cons(Pair(x,t),env)
        | Pair(t,Stv(x)): unify(env)(Stv(x))(t)
        | _: failwith("typechecking error: types cannot be unified")

fun pmk_cv(Pair(s,pty)):
  if can(get_const_type)(s) | Constp(s,pty) | Varp(s,pty)

fun typify(target):
  fun(Pair(ptm,venv,uenv)):
    match ptm
    | Varp(s,_) when can(assoc(s))(venv):
        def ty1 = assoc(s)(venv)
        Pair(Varp(s,ty1),Pair(PairList [],unify(uenv)(ty1)(target)))
    | Varp(s,_):
        if !is_hidden(s) && can(get_generic_type)(s)
        | block:
            def pty = pretype_instance(get_generic_type(s))
            Pair(Constp(s,pty),Pair(PairList [],unify(uenv)(pty)(target)))
        | block:
            def v = Varp(s,target)
            if !can(get_var_type)(s)
            | Pair(v,Pair(PairList [Pair(s,target)],uenv))
            | block:
                def pty = pretype_instance(get_var_type(s))
                Pair(v,Pair(PairList [Pair(s,target)],unify(uenv)(pty)(target)))
    | Constp(s,pty):
        Pair(Constp(s,pty),Pair(PairList [],unify(uenv)(pty)(target)))
    | Combp(f,x):
        def argty = new_type_var()
        def fty = Ptycon("fun",PairList [argty,target])
        def Pair(f1,Pair(vf,e1)) = typify(fty)(Pair(f,venv,uenv))
        def Pair(x1,Pair(vx,e2)) = typify(argty)(Pair(x,append(vf)(venv),e1))
        Pair(Combp(f1,x1),Pair(append(vf)(vx),e2))
    | Typing(tm,pty):
        typify(target)(Pair(tm,venv,unify(uenv)(target)(pty)))
    | Absp(v,bod):
        def Pair(argty,retty):
          match solve(uenv)(target)
          | Ptycon("fun",PairList [a,b]): Pair(a,b)
          | _: Pair(new_type_var(),new_type_var())
        def fty = Ptycon("fun",PairList [argty,retty])
        def e0 = unify(uenv)(fty)(target)
        def Pair(v1,Pair(vv,e1)) = typify(argty)(Pair(v,PairList [],e0))
        def Pair(v2,vv2):
          match v1
          | Constp(s,_) when ignore_constant_varstruct: Pair(Varp(s,argty),PairList [Pair(s,argty)])
          | _: Pair(v1,vv)
        def Pair(b1,Pair(vb,e2)) = typify(retty)(Pair(bod,append(vv2)(venv),e1))
        Pair(Absp(v2,b1),Pair(vb,e2))

fun resolve_interface(ptm):
  fun(cont):
    fun(env):
      match ptm
      | Combp(f,x): resolve_interface(f)(resolve_interface(x)(cont))(env)
      | Absp(v,b): resolve_interface(v)(resolve_interface(b)(cont))(env)
      | Typing(t,_): resolve_interface(t)(cont)(env)
      | Varp(_,_): cont(env)
      | Constp(s,ty):
          def maps = filter(fun(Pair(s1,_)): s1 == s)(the_interface)
          if maps == PairList []
          | cont(env)
          | tryfind(
              fun(Pair(_,Pair(_,ty1))):
                cont(unify(env)(pretype_instance(ty1))(ty))
            )(maps)

fun solve_preterm(env):
  fun(ptm):
    match ptm
    | Varp(s,ty): Varp(s,solve(env)(ty))
    | Combp(f,x): Combp(solve_preterm(env)(f),solve_preterm(env)(x))
    | Absp(v,b): Absp(solve_preterm(env)(v),solve_preterm(env)(b))
    | Typing(t,ty): Typing(solve_preterm(env)(t),solve(env)(ty))
    | Constp(s,ty):
        def tys = solve(env)(ty)
        try:
          def Pair(_,Pair(c1,_)) =
            find(
              fun(Pair(s1,Pair(_,ty1))):
                s == s1 && can(unify(env)(pretype_instance(ty1)))(ty)
            )(the_interface)
          pmk_cv(Pair(c1,tys))
        ~catch Failure(_): Constp(s,tys)

fun term_of_preterm(ptm):
  fun cv(t):
    match t
    | Varp(s,pty): mk_var(Pair(s,type_of_pretype(pty)))
    | Constp(s,pty): mk_mconst(Pair(s,type_of_pretype(pty)))
    | Combp(l,r): mk_comb(Pair(cv(l),cv(r)))
    | Absp(v,bod): mk_gabs(Pair(cv(v),cv(bod)))
    | Typing(tm,_): cv(tm)
  cv(ptm)

fun retypecheck(venv):
  fun(ptm):
    def ty = new_type_var()
    def Pair(ptm1,Pair(_,env)):
      try: typify(ty)(Pair(ptm,venv,PairList []))
      ~catch Failure(e): failwith("typechecking error (initial type assignment): " +& e)
    def env1:
      try: resolve_interface(ptm1)(I)(env)
      ~catch Failure(_): failwith("typechecking error (overload resolution)")
    solve_preterm(env1)(ptm1)
