#lang rhombus
// (c) University of Cambridge 1998; John Harrison 1998-2007.
// (c) Marco Maggesi 2017; Andrea Gabrielli, Marco Maggesi 2017-2018.
// Direct text-rendering translation of HOL Light printer.ml.  Rhombus has no
// OCaml Format formatter, so the prettyprinter is represented by pure String
// composition while preserving interface reversal and parse-status rules.
import: "compat.rhm" open
import: "fusion.rhm" open
import: "basics.rhm" open
import: "syntax_state.rhm" open

export:
  name_of
  install_user_printer
  delete_user_printer
  try_user_printer
  string_of_type
  string_of_term
  string_of_thm
  print_type
  print_term
  print_thm

fun name_of(tm):
  try: fst(dest_var(tm))
  ~catch Failure(_):
    try: fst(dest_const(tm))
    ~catch Failure(_): ""

fun reverse_interface(Pair(s0,ty0)):
  if !reverse_interface_mapping
  | s0
  | try:
      fst(find(
        fun(Pair(_,Pair(s1,ty))):
          s1 == s0 && can(type_match(ty)(ty0))(PairList [])
      )(the_interface))
    ~catch Failure(_): s0

fun string_of_type(ty):
  fun atom(t):
    match t
    | Tyvar(s): s
    | Tyapp("fun",PairList [a,b]):
        def sa = if is_fun_ty(a) | "(" +& atom(a) +& ")" | atom(a)
        sa +& "->" +& atom(b)
    | Tyapp(c,PairList []): c
    | Tyapp(c,PairList [x]): atom(x) +& " " +& c
    | Tyapp(c,args):
        "(" +& join_strings(map(atom)(args),",") +& ")" +& c
  atom(ty)

fun join_strings(xs,sep):
  match xs
  | PairList []: ""
  | PairList [h]: h
  | PairList [h, & t]: h +& sep +& join_strings(t,sep)

def mutable user_printers = PairList []
fun install_user_printer(Pair(name,pr)):
  user_printers := PairList.cons(Pair(name,pr),user_printers)
fun delete_user_printer(name):
  user_printers := filter(fun(Pair(n,_)): n != name)(user_printers)
fun try_user_printer(tm):
  tryfind(fun(Pair(_,pr)): pr(tm))(user_printers)

fun type_has_invented(ty):
  match ty
  | Tyvar(s): s.length() > 0 && s.substring(0,1) == "?"
  | Tyapp(_,args): exists(type_has_invented)(args)

fun maybe_typed(tm,s):
  if print_types_of_subterms == 2
     || (print_types_of_subterms == 1 && type_has_invented(type_of(tm)))
  | "(" +& s +& ":" +& string_of_type(type_of(tm)) +& ")"
  | s

fun atom_name(tm):
  def s0 = name_of(tm)
  def s = reverse_interface(Pair(s0,type_of(tm)))
  def shown =
    if parses_as_binder(s) || is_prefix(s) || can(get_infix_status)(s)
    | "(" +& s +& ")"
    | s
  maybe_typed(tm,shown)

fun string_of_term(tm):
  fun parens(need,s): if need | "(" +& s +& ")" | s

  fun dest_binary_name(t):
    match t
    | Comb(Comb(op,l),r):
        def s = reverse_interface(Pair(name_of(op),type_of(op)))
        Pair(s,Pair(l,r))
    | _: failwith("dest_binary_name")

  fun collect_binder(s,t,acc):
    if s == "\\"
    | if is_abs(t)
      | block:
          def Pair(v,b) = dest_abs(t)
          collect_binder(s,b,PairList.cons(v,acc))
      | Pair(plist_rev(acc),t)
    | try:
        def Pair(h,a) = dest_comb(t)
        if reverse_interface(Pair(name_of(h),type_of(h))) != s
        | Pair(plist_rev(acc),t)
        | block:
            def Pair(v,b) = dest_abs(a)
            collect_binder(s,b,PairList.cons(v,acc))
      ~catch Failure(_): Pair(plist_rev(acc),t)

  fun render(prec,t):
    try: try_user_printer(t)
    ~catch Failure(_):
      if is_var(t) || is_const(t)
      | atom_name(t)
      | if is_abs(t)
        | block:
            def Pair(vs,bod) = collect_binder("\\",t,PairList [])
            def s = "\\" +& join_strings(map(fun(v): atom_name(v))(vs)," ")
                      +& ". " +& render(0,bod)
            parens(prec > 0,s)
        | block:
            def Pair(h,args) = strip_comb(t)
            def hs = reverse_interface(Pair(name_of(h),type_of(h)))
            if parses_as_binder(hs) && length(args) == 1 && is_abs(hd(args))
            | block:
                def Pair(vs,bod) = collect_binder(hs,t,PairList [])
                def s = hs +& (if isalnum(hs) | " " | "")
                          +& join_strings(map(fun(v): atom_name(v))(vs)," ")
                          +& ". " +& render(0,bod)
                parens(prec > 0,s)
            | if is_prefix(hs) && length(args) == 1
              | block:
                  def s = hs +& (if isalnum(hs) | " " | "") +& render(999,hd(args))
                  parens(prec >= 1000,s)
              | if length(args) == 2 && can(get_infix_status)(hs)
                | block:
                    def Pair(ip,assoc) = get_infix_status(hs)
                    def l = hd(args)
                    def r = hd(tl(args))
                    def ls = render((if assoc == "right" | ip+1 | ip),l)
                    def rs = render((if assoc == "right" | ip | ip+1),r)
                    def spacer = if mem(hs)(unspaced_binops) | "" | " "
                    def s = ls +& spacer +& hs +& spacer +& rs
                    parens(ip <= prec,s)
                | if hs == "COND" && length(args) == 3
                  | block:
                      def s = "if " +& render(0,hd(args))
                                +& " then " +& render(0,hd(tl(args)))
                                +& " else " +& render(0,hd(tl(tl(args))))
                      parens(prec > 0,s)
                  | block:
                      def head =
                        if is_var(h) || is_const(h) | atom_name(h) | "(" +& render(0,h) +& ")"
                      def astr = join_strings(map(fun(x): render(1000,x))(args)," ")
                      parens(prec >= 1000,head +& (if astr == "" | "" | " " +& astr))
  render(0,tm)

fun string_of_thm(th):
  def Pair(asl,c) = dest_thm(th)
  def left:
    if asl == PairList []
    | ""
    | if print_all_thm
      | join_strings(map(string_of_term)(asl),", ") +& " "
      | "... "
  left +& "|- " +& string_of_term(c)

fun print_type(ty):
  print(string_of_type(ty))
fun print_term(tm):
  print(string_of_term(tm))
fun print_thm(th):
  print(string_of_thm(th))
