def [isspace, issep, isbra, issymb, isalpha, isnum, isalnum]:
  let charcode = fun(s): OCamlChar.code(OCamlString.get(s)(0))
  let spaces = " \t\n\r"
  let separators = ",;"
  let brackets = "()[]{}"
  let symbs = "\\!@#$%^&*-+|\\<=>/?~.:"
  let alphas = "'abcdefghijklmnopqrstuvwxyz_ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  let nums = "0123456789"
  let allchars = spaces +& separators +& brackets +& symbs +& alphas +& nums
  let csetsize = itlist(o(max)(charcode))(explode(allchars))(256)
  let ctable = OCamlArray.make(csetsize)(0)
  do_list(fun(c): OCamlArray.set(ctable)(charcode(c))(1))(explode(spaces))
  do_list(fun(c): OCamlArray.set(ctable)(charcode(c))(2))(explode(separators))
  do_list(fun(c): OCamlArray.set(ctable)(charcode(c))(4))(explode(brackets))
  do_list(fun(c): OCamlArray.set(ctable)(charcode(c))(8))(explode(symbs))
  do_list(fun(c): OCamlArray.set(ctable)(charcode(c))(16))(explode(alphas))
  do_list(fun(c): OCamlArray.set(ctable)(charcode(c))(32))(explode(nums))
  let isspace = fun(c): OCamlArray.get(ctable)(charcode(c)) == 1
  let issep = fun(c): OCamlArray.get(ctable)(charcode(c)) == 2
  let isbra = fun(c): OCamlArray.get(ctable)(charcode(c)) == 4
  let issymb = fun(c): OCamlArray.get(ctable)(charcode(c)) == 8
  let isalpha = fun(c): OCamlArray.get(ctable)(charcode(c)) == 16
  let isnum = fun(c): OCamlArray.get(ctable)(charcode(c)) == 32
  let isalnum = fun(c): OCamlArray.get(ctable)(charcode(c)) >= 16
  [isspace, issep, isbra, issymb, isalpha, isnum, isalnum]

def [reserve_words, unreserve_words, is_reserved_word, reserved_words]:
  let reswords = Box(PairList ["(",
                               ")",
                               "[",
                               "]",
                               "{",
                               "}",
                               ":",
                               ";",
                               ".",
                               "|",
                               "let",
                               "in",
                               "and",
                               "if",
                               "then",
                               "else",
                               "match",
                               "with",
                               "function",
                               "->",
                               "when"])
  [fun(ns): reswords.value := union(reswords.value)(ns),
   fun(ns): reswords.value := subtract(reswords.value)(ns),
   fun(n): mem(n)(reswords.value),
   fun(_): reswords.value]

def [unparse_as_binder, parse_as_binder, parses_as_binder, binders]:
  let binder_list = Box(PairList [])
  [fun(n): binder_list.value := subtract(binder_list.value)(PairList [n]),
   fun(n): binder_list.value := union(binder_list.value)(PairList [n]),
   fun(n): mem(n)(binder_list.value),
   fun(_): binder_list.value]

def [unparse_as_prefix, parse_as_prefix, is_prefix, prefixes]:
  let prefix_list = Box(PairList [])
  [fun(n): prefix_list.value := subtract(prefix_list.value)(PairList [n]),
   fun(n): prefix_list.value := union(prefix_list.value)(PairList [n]),
   fun(n): mem(n)(prefix_list.value),
   fun(_): prefix_list.value]

def [unparse_as_infix, parse_as_infix, get_infix_status, infixes]:
  let cmp:
    fun([s, [x, a]]): fun([t, [y, b]]): x < y || x == y && a > b || x == y && a == b && s < t
  let infix_list = Box(PairList [])
  [fun(n): infix_list.value := filter(o(fun(x): fun(y): x != y(n))(fst))(infix_list.value),
   fun([n, d]):
     infix_list.value := sort(cmp)(PairList.cons([n, d], filter(o(fun(x): fun(y): x != y(n))(fst))(infix_list.value))),
   fun(n): assoc(n)(infix_list.value),
   fun(_): infix_list.value]

def the_interface = Box(PairList [])

def the_overload_skeletons = Box(PairList [])

// include Format: its functions are imported and exported above

set_max_boxes(100)

def reverse_interface_mapping = Box(#true)

def unspaced_binops = Box(PairList [",", "..", "$"])

def prebroken_binops = Box(PairList ["==>"])

def print_unambiguous_comprehensions = Box(#false)

def typify_universal_set = Box(#true)

def print_all_thm = Box(#true)

def print_types_of_subterms = Box(1)

fun name_of(tm):
  match tm
  | Var(x, ty): x
  | Const(x, ty): x
  | _: ""

def printer_color_const = Box(Some("32"))

def printer_color_resword = Box(Some("34"))

def printer_color_binder = Box(Some("35"))

def printer_color_infix = Box(None())

def printer_color_prefix = Box(None())

def printer_color_type = Box(Some("36"))

def printer_color_typevar = Box(Some("34"))

def printer_color_itypevar = Box(Some("31"))

fun pp_print_colored_string(colorcode):
  fun(fmt):
    fun(contents):
      match colorcode
      | Some(thecode):
          let ansicmd = "\x1b[" +& thecode +& "m"
          let endcmd = "\x1b[0m"
          pp_print_as(fmt)(0)(ansicmd)
          pp_print_string(fmt)(contents)
          pp_print_as(fmt)(0)(endcmd)
      | None(): pp_print_string(fmt)(contents)

def [pp_print_colored_const, pp_print_colored_resword, pp_print_colored_binder, pp_print_colored_infix, pp_print_colored_prefix, pp_print_colored_tyvar]:
  [fun(fmt): fun(s): pp_print_colored_string(printer_color_const.value)(fmt)(s),
   fun(fmt): fun(s): pp_print_colored_string(printer_color_resword.value)(fmt)(s),
   fun(fmt): fun(s): pp_print_colored_string(printer_color_binder.value)(fmt)(s),
   fun(fmt): fun(s): pp_print_colored_string(printer_color_infix.value)(fmt)(s),
   fun(fmt): fun(s): pp_print_colored_string(printer_color_prefix.value)(fmt)(s),
   fun(fmt):
     fun(s):
       pp_print_colored_string(if OCamlString.get(s)(0) == "?" | printer_color_itypevar.value | printer_color_typevar.value)(fmt)(s)]

def [pp_print_type, pp_print_qtype]:
  let soc:
    fun(sep):
      fun(flag):
        fun(ss):
          if ss == PairList []
          | ""
          | let s = end_itlist(fun(s1): fun(s2): s1 +& sep +& s2)(ss)
            if flag | "(" +& s +& ")" | s
  fun sot(pr):
    fun(ty):
      try:
        dest_vartype(ty)
        ~catch Failure(_):
            try:
              string_of_num(dest_finty(ty))
              ~catch Failure(_):
                  match dest_type(ty)
                  | [con, PairList []]: con
                  | ["fun", PairList [ty1, ty2]]: soc("->")(pr > 0)(PairList [sot(1)(ty1), sot(0)(ty2)])
                  | ["sum", PairList [ty1, ty2]]: soc("+")(pr > 2)(PairList [sot(3)(ty1), sot(2)(ty2)])
                  | ["prod", PairList [ty1, ty2]]: soc("#")(pr > 4)(PairList [sot(5)(ty1), sot(4)(ty2)])
                  | ["cart", PairList [ty1, ty2]]: soc("^")(pr > 6)(PairList [sot(6)(ty1), sot(7)(ty2)])
                  | [con, args]: soc(",")(#true)(map(sot(0))(args)) +& con
  [fun(fmt): fun(ty): pp_print_string(fmt)(sot(0)(ty)),
   fun(fmt):
     fun(ty):
       pp_print_string(fmt)("`:")
       pp_print_string(fmt)(sot(0)(ty))
       pp_print_string(fmt)("`")]

def [pp_print_colored_type, pp_print_colored_qtype]:
  let color_print_str:
    fun(fmt): fun(s): pp_print_colored_string(printer_color_type.value)(fmt)(s)
  let soc:
    fun(sep):
      fun(flag):
        fun(ss):
          fun(fmt):
            if ss == PairList []
            | #void
            | let _ = (if flag | color_print_str(fmt)("(") | #void)
              let tuple_printer = end_itlist(fun(pp):
                                               fun(pp_next):
                                                 fun(fmt):
                                                   pp(fmt)
                                                   color_print_str(fmt)(sep)
                                                   pp_next(fmt))(ss)
              let _ = tuple_printer(fmt)
              if flag | color_print_str(fmt)(")") | #void
  fun sot(pr):
    fun(ty):
      fun(fmt):
        try:
          pp_print_colored_tyvar(fmt)(dest_vartype(ty))
          ~catch Failure(_):
              try:
                color_print_str(fmt)(string_of_num(dest_finty(ty)))
                ~catch Failure(_):
                    match dest_type(ty)
                    | [con, PairList []]: color_print_str(fmt)(con)
                    | ["fun", PairList [ty1, ty2]]: soc("->")(pr > 0)(PairList [sot(1)(ty1), sot(0)(ty2)])(fmt)
                    | ["sum", PairList [ty1, ty2]]: soc("+")(pr > 2)(PairList [sot(3)(ty1), sot(2)(ty2)])(fmt)
                    | ["prod", PairList [ty1, ty2]]: soc("#")(pr > 4)(PairList [sot(5)(ty1), sot(4)(ty2)])(fmt)
                    | ["cart", PairList [ty1, ty2]]: soc("^")(pr > 6)(PairList [sot(6)(ty1), sot(7)(ty2)])(fmt)
                    | [con, args]:
                        soc(",")(#true)(map(sot(0))(args))(fmt)
                        color_print_str(fmt)(con)
  [fun(fmt): fun(ty): sot(0)(ty)(fmt),
   fun(fmt):
     fun(ty):
       pp_print_string(fmt)("`:")
       sot(0)(ty)(fmt)
       pp_print_string(fmt)("`")]

def [install_user_printer, install_user_color_printer, delete_user_printer, delete_user_color_printer, try_user_printer, try_user_color_printer]:
  let user_printers = Box(PairList [])
  let user_color_printers = Box(PairList [])
  [fun(pr): user_printers.value := PairList.cons(pr, user_printers.value),
   fun(pr): user_color_printers.value := PairList.cons(pr, user_color_printers.value),
   fun(s):
     user_printers.value := snd(remove(fun([s_prime, _]): s == s_prime)(user_printers.value)),
   fun(s):
     user_color_printers.value := snd(remove(fun([s_prime, _]): s == s_prime)(user_color_printers.value)),
   fun(fmt): fun(tm): tryfind(fun([_, pr]): pr(fmt)(tm))(user_printers.value),
   fun(fmt): fun(tm): tryfind(fun([_, pr]): pr(fmt)(tm))(user_color_printers.value)]

def [pp_print_term, pp_print_colored_term]:
  let reverse_interface:
    fun([s0, ty0]):
      if !reverse_interface_mapping.value
      | s0
      | try:
          fst(find(fun([s, [s_prime, ty]]): s_prime == s0 && can(type_match(ty)(ty0))(PairList []))(the_interface.value))
          ~catch Failure(_): s0
  let DEST_BINARY:
    fun(c):
      fun(tm):
        try:
          let [il, r] = dest_comb(tm)
          let [i, l] = dest_comb(il)
          if (i == c || \
              (is_const(i) && \
               is_const(c) && reverse_interface(dest_const(i)) == reverse_interface(dest_const(c))))
          | [l, r]
          | fail(#void)
          ~catch Failure(_): failwith("DEST_BINARY")
  let ARIGHT:
    fun(s):
      match snd(get_infix_status(s))
      | "right": #true
      | _: #false
  fun powerof10(n):
    if abs_num(n) < num(1)
    | #false
    | if n == num(1)
      | #true
      | powerof10(n / num(10))
  let bool_of_term:
    fun(t):
      match t
      | Const("T", _): #true
      | Const("F", _): #false
      | _: failwith("bool_of_term")
  let code_of_term:
    fun(t):
      let [f, tms] = strip_comb(t)
      if !(is_const(f) && fst(dest_const(f)) == "ASCII") || !(length(tms) == 8)
      | failwith("code_of_term")
      | itlist(fun(b): fun(f): if b | 1 + 2 * f | 2 * f)(map(bool_of_term)(rev(tms)))(0)
  fun dest_clause(tm):
    let pbod = snd(strip_exists(body(body(tm))))
    let [s, args] = strip_comb(pbod)
    if name_of(s) == "_UNGUARDED_PATTERN" && length(args) == 2
    | PairList [rand(rator(hd(args))), rand(rator(hd(tl(args))))]
    | if name_of(s) == "_GUARDED_PATTERN" && length(args) == 3
      | PairList [rand(rator(hd(args))), hd(tl(args)), rand(rator(hd(tl(tl(args)))))]
      | failwith("dest_clause")
  fun dest_clauses(tm):
    let [s, args] = strip_comb(tm)
    if name_of(s) == "_SEQPATTERN" && length(args) == 2
    | PairList.cons(dest_clause(hd(args)), dest_clauses(hd(tl(args))))
    | PairList [dest_clause(tm)]
  let pdest_cond:
    fun(tm):
      match tm
      | Comb(Comb(Comb(Const("COND", _), i), t), e): [[i, t], e]
      | _: failwith("pdest_cond")
  let print_colored_term:
    fun(use_color):
      fun(fmt):
        let color_switch = (fun(pp): if use_color | pp | pp_print_string)
        let try_user_printers:
          fun(tm):
            if use_color
            | try:
                try_user_color_printer(fmt)(tm)
                ~catch _: try_user_printer(fmt)(tm)
            | try_user_printer(fmt)(tm)
        let print_numeral = fun(tm): pp_print_string(fmt)(string_of_num(dest_numeral(tm)))
        fun print_term(prec):
          fun(tm):
            try:
              try_user_printers(tm)
              ~catch Failure(_):
                  try:
                    print_numeral(tm)
                    ~catch Failure(_):
                        try:
                          print_string_or_list(tm)
                          ~catch Failure(_):
                              if is_gabs(tm)
                              | print_binder(prec)(tm)
                              | let [hop, args] = strip_comb(tm)
                                let s = reverse_interface([name_of(hop), type_of(hop)])
                                try:
                                  print_empty_set(s)(tm)(args)
                                  ~catch Failure(_):
                                      try:
                                        print_universal_set(s)(tm)(args)
                                        ~catch Failure(_):
                                            try:
                                              print_finite_set(s)(tm)
                                              ~catch Failure(_):
                                                  try:
                                                    print_set_comprehension(s)(tm)
                                                    ~catch Failure(_):
                                                        try:
                                                          print_let_term(s)(prec)(tm)
                                                          ~catch Failure(_):
                                                              try:
                                                                print_decimal(s)(args)
                                                                ~catch Failure(_):
                                                                    try:
                                                                      print_match(s)(prec)(args)
                                                                      ~catch Failure(_):
                                                                          try:
                                                                            print_function(s)(prec)(args)
                                                                            ~catch Failure(_):
                                                                                try:
                                                                                  print_cond(s)(prec)(tm)(args)
                                                                                  ~catch Failure(_):
                                                                                      try:
                                                                                        print_prefix_app(s)(prec)(args)
                                                                                        ~catch Failure(_):
                                                                                            try:
                                                                                              print_binder_app(s)(prec)(tm)(args)
                                                                                              ~catch Failure(_):
                                                                                                  try:
                                                                                                    print_infix_app(s)(prec)(tm)(hop)(args)
                                                                                                    ~catch Failure(_):
                                                                                                        if (is_const(hop) || is_var(hop)) && args == PairList []
                                                                                                        | print_atom(hop)(s)
                                                                                                        | print_generic_app(prec)(tm)
        fun print_string_or_list(tm):
          let tms = dest_list(tm)
          try:
            if fst(dest_type(hd(snd(dest_type(type_of(tm)))))) != "char"
            | fail(#void)
            | let ccs = map(o(o(OCamlString.make(1))(OCamlChar.chr))(code_of_term))(tms)
              let s = "\"" +& OCamlString.escaped(implode(ccs)) +& "\""
              pp_print_string(fmt)(s)
            ~catch Failure(_):
                pp_open_box(fmt)(0)
                pp_print_string(fmt)("[")
                pp_open_box(fmt)(0)
                print_term_sequence(#true)(";")(0)(tms)
                pp_close_box(fmt)(#void)
                pp_print_string(fmt)("]")
                pp_close_box(fmt)(#void)
        fun print_empty_set(s):
          fun(tm):
            fun(args):
              if s == "EMPTY" && is_const(tm) && args == PairList []
              | pp_print_string(fmt)("{}")
              | fail(#void)
        fun print_universal_set(s):
          fun(tm):
            fun(args):
              if s == "UNIV" && typify_universal_set.value && is_const(tm) && args == PairList []
              | let ty = fst(dest_fun_ty(type_of(tm)))
                pp_print_string(fmt)("(:")
                pp_print_type(fmt)(ty)
                pp_print_string(fmt)(")")
              | fail(#void)
        fun print_finite_set(s):
          fun(tm):
            if s != "INSERT"
            | fail(#void)
            | let [mems, oth] = splitlist(dest_binary("INSERT"))(tm)
              if is_const(oth) && fst(dest_const(oth)) == "EMPTY"
              | pp_open_box(fmt)(0)
                pp_print_string(fmt)("{")
                pp_open_box(fmt)(0)
                print_term_sequence(#true)(",")(14)(mems)
                pp_close_box(fmt)(#void)
                pp_print_string(fmt)("}")
                pp_close_box(fmt)(#void)
              | fail(#void)
        fun print_set_comprehension(s):
          fun(tm):
            if s != "GSPEC"
            | fail(#void)
            | let [evs, bod] = strip_exists(body(rand(tm)))
              let [bod1, fabs] = dest_comb(bod)
              let [bod2, babs] = dest_comb(bod1)
              let c = rator(bod2)
              if fst(dest_const(c)) != "SETSPEC" | fail(#void) | pp_print_string(fmt)("{")
              print_term(0)(fabs)
              pp_print_string(fmt)(" | ")
              let fvs = frees(fabs)
              let bvs = frees(babs)
              if (!print_unambiguous_comprehensions.value && \
                  set_eq(evs)(if length(fvs) <= 1 || bvs == PairList [] | fvs | intersect(fvs)(bvs)))
              | #void
              | print_term_sequence(#false)(",")(14)(evs)
                pp_print_string(fmt)(" | ")
              print_term(0)(babs)
              pp_print_string(fmt)("}")
        fun print_let_term(s):
          fun(prec):
            fun(tm):
              if s != "LET"
              | fail(#void)
              | let [eqs, bod] = dest_let(tm)
                if prec == 0
                | pp_open_hvbox(fmt)(0)
                | pp_open_hvbox(fmt)(1)
                  pp_print_string(fmt)("(")
                color_switch(pp_print_colored_resword)(fmt)("let ")
                print_term(0)(mk_eq(hd(eqs)))
                do_list(fun([v, t]):
                          pp_print_break(fmt)(1)(0)
                          color_switch(pp_print_colored_resword)(fmt)("and ")
                          print_term(0)(mk_eq([v, t])))(tl(eqs))
                color_switch(pp_print_colored_resword)(fmt)(" in")
                pp_print_break(fmt)(1)(0)
                print_term(0)(bod)
                if prec == 0 | #void | pp_print_string(fmt)(")")
                pp_close_box(fmt)(#void)
        fun print_decimal(s):
          fun(args):
            if s != "DECIMAL"
            | fail(#void)
            | let n_num = dest_numeral(hd(args))
              let n_den = dest_numeral(hd(tl(args)))
              if !powerof10(n_den)
              | fail(#void)
              | let s_num = string_of_num(quo_num(n_num)(n_den))
                let s_den = implode(tl(explode(string_of_num(n_den + mod_num(n_num)(n_den)))))
                pp_print_string(fmt)("#" +& s_num +& (if n_den == num(1) | "" | ".") +& s_den)
        fun print_match(s):
          fun(prec):
            fun(args):
              if s != "_MATCH" || length(args) != 2
              | fail(#void)
              | let cls = dest_clauses(hd(tl(args)))
                if prec == 0 | #void | pp_print_string(fmt)("(")
                pp_open_hvbox(fmt)(0)
                color_switch(pp_print_colored_resword)(fmt)("match ")
                print_term(0)(hd(args))
                color_switch(pp_print_colored_resword)(fmt)(" with")
                pp_print_break(fmt)(1)(2)
                print_clauses(cls)
                pp_close_box(fmt)(#void)
                if prec == 0 | #void | pp_print_string(fmt)(")")
        fun print_function(s):
          fun(prec):
            fun(args):
              if s != "_FUNCTION" || length(args) != 1
              | fail(#void)
              | let cls = dest_clauses(hd(args))
                if prec == 0 | #void | pp_print_string(fmt)("(")
                pp_open_hvbox(fmt)(0)
                color_switch(pp_print_colored_resword)(fmt)("function")
                pp_print_break(fmt)(1)(2)
                print_clauses(cls)
                pp_close_box(fmt)(#void)
                if prec == 0 | #void | pp_print_string(fmt)(")")
        fun print_cond(s):
          fun(prec):
            fun(tm):
              fun(args):
                if s != "COND" || length(args) != 3
                | fail(#void)
                | if prec == 0
                  | #void
                  | pp_print_string(fmt)("(")
                  pp_open_hvbox(fmt)(-1)
                  let [ccls, ecl] = splitlist(pdest_cond)(tm)
                  if length(ccls) <= 4
                  | color_switch(pp_print_colored_resword)(fmt)("if ")
                    print_term(0)(hd(args))
                    pp_print_break(fmt)(0)(0)
                    color_switch(pp_print_colored_resword)(fmt)(" then ")
                    print_term(0)(hd(tl(args)))
                    pp_print_break(fmt)(0)(0)
                    color_switch(pp_print_colored_resword)(fmt)(" else ")
                    print_term(0)(hd(tl(tl(args))))
                  | color_switch(pp_print_colored_resword)(fmt)("if ")
                    print_term(0)(fst(hd(ccls)))
                    color_switch(pp_print_colored_resword)(fmt)(" then ")
                    print_term(0)(snd(hd(ccls)))
                    pp_print_break(fmt)(0)(0)
                    do_list(fun([i, t]):
                              color_switch(pp_print_colored_resword)(fmt)(" else if ")
                              print_term(0)(i)
                              color_switch(pp_print_colored_resword)(fmt)(" then ")
                              print_term(0)(t)
                              pp_print_break(fmt)(0)(0))(tl(ccls))
                    color_switch(pp_print_colored_resword)(fmt)(" else ")
                    print_term(0)(ecl)
                  pp_close_box(fmt)(#void)
                  if prec == 0 | #void | pp_print_string(fmt)(")")
        fun print_prefix_app(s):
          fun(prec):
            fun(args):
              if !(is_prefix(s) && length(args) == 1)
              | fail(#void)
              | if prec == 1000
                | pp_print_string(fmt)("(")
                | #void
                color_switch(pp_print_colored_prefix)(fmt)(s)
                if (isalnum(s) || \
                    s == "--" && \
                    length(args) == 1 && \
                    (try:
                       let [l, _] = dest_comb(hd(args))
                       let s0 = name_of(l)
                       let ty0 = type_of(l)
                       reverse_interface([s0, ty0]) == "--" || \
                       mem(fst(dest_const(l)))(PairList ["real_of_num", "int_of_num"])
                       ~catch Failure(_): #false) || \
                    s == "~" && length(args) == 1 && is_neg(hd(args)))
                | pp_print_string(fmt)(" ")
                | #void
                print_term(999)(hd(args))
                if prec == 1000 | pp_print_string(fmt)(")") | #void
        fun print_binder_app(s):
          fun(prec):
            fun(tm):
              fun(args):
                if !(parses_as_binder(s) && length(args) == 1 && is_gabs(hd(args)))
                | fail(#void)
                | print_binder(prec)(tm)
        fun print_infix_app(s):
          fun(prec):
            fun(tm):
              fun(hop):
                fun(args):
                  if length(args) != 2 || !can(get_infix_status)(s)
                  | fail(#void)
                  | let bargs:
                      if ARIGHT(s)
                      | let [tms, tmt] = splitlist(DEST_BINARY(hop))(tm)
                        append(tms)(PairList [tmt])
                      | let [tmt, tms] = rev_splitlist(DEST_BINARY(hop))(tm)
                        PairList.cons(tmt, tms)
                    let newprec = fst(get_infix_status(s))
                    if newprec <= prec
                    | pp_open_hvbox(fmt)(1)
                      pp_print_string(fmt)("(")
                    | pp_open_hvbox(fmt)(0)
                    print_term(newprec)(hd(bargs))
                    do_list(fun(x):
                              if mem(s)(unspaced_binops.value)
                              | #void
                              | if mem(s)(prebroken_binops.value)
                                | pp_print_break(fmt)(1)(0)
                                | pp_print_string(fmt)(" ")
                              color_switch(pp_print_colored_infix)(fmt)(s)
                              if mem(s)(unspaced_binops.value)
                              | pp_print_break(fmt)(0)(0)
                              | if mem(s)(prebroken_binops.value)
                                | pp_print_string(fmt)(" ")
                                | pp_print_break(fmt)(1)(0)
                              print_term(newprec)(x))(tl(bargs))
                    if newprec <= prec | pp_print_string(fmt)(")") | #void
                    pp_close_box(fmt)(#void)
        fun print_atom(hop):
          fun(s):
            let s_prime:
              (if parses_as_binder(s) || can(get_infix_status)(s) || is_prefix(s) | "(" +& s +& ")" | s)
            fun has_invented_typevar(ty):
              if is_vartype(ty)
              | OCamlString.get(dest_vartype(ty))(0) == "?"
              | OCamlList.exists(has_invented_typevar)(snd(dest_type(ty)))
            if (print_types_of_subterms.value == 2 || \
                (print_types_of_subterms.value == 1 && has_invented_typevar(type_of(hop))))
            | pp_open_box(fmt)(0)
              pp_print_string(fmt)("(")
              if is_const(hop)
              | color_switch(pp_print_colored_const)(fmt)(s_prime)
              | pp_print_string(fmt)(s_prime)
              if (OCamlString.length(s_prime) > 0 && \
                  issymb(OCamlString.sub(s_prime)(OCamlString.length(s_prime) - 1)(1)))
              | pp_print_string(fmt)(" ")
              | #void
              pp_print_string(fmt)(":")
              (if use_color | pp_print_colored_type | pp_print_type)(fmt)(type_of(hop))
              pp_print_string(fmt)(")")
              pp_close_box(fmt)(#void)
            | if is_const(hop)
              | color_switch(pp_print_colored_const)(fmt)(s_prime)
              | pp_print_string(fmt)(s_prime)
        fun print_generic_app(prec):
          fun(tm):
            let [l, r] = dest_comb(tm)
            pp_open_hvbox(fmt)(0)
            if prec == 1000 | pp_print_string(fmt)("(") | #void
            print_term(999)(l)
            if ((try:
                   mem(fst(dest_const(l)))(PairList ["real_of_num", "int_of_num"])
                   ~catch Failure(_): #false))
            | #void
            | pp_print_space(fmt)(#void)
            print_term(1000)(r)
            if prec == 1000 | pp_print_string(fmt)(")") | #void
            pp_close_box(fmt)(#void)
        fun print_term_sequence(break):
          fun(sep):
            fun(prec):
              fun(tms):
                if tms == PairList []
                | #void
                | print_term(prec)(hd(tms))
                  let ttms = tl(tms)
                  if ttms == PairList []
                  | #void
                  | pp_print_string(fmt)(sep)
                    if break | pp_print_space(fmt)(#void) | #void
                    print_term_sequence(break)(sep)(prec)(ttms)
        fun print_binder(prec):
          fun(tm):
            let absf = is_gabs(tm)
            let [s, s_prime]:
              if absf
              | ["\\", "\\"]
              | let bt = rator(tm)
                let sn = name_of(bt)
                [sn, reverse_interface([sn, type_of(bt)])]
            fun collectvs(tm):
              if absf
              | if is_abs(tm)
                | let [v, t] = dest_abs(tm)
                  let [vs, bod] = collectvs(t)
                  [PairList.cons([#false, v], vs), bod]
                | if is_gabs(tm)
                  | let [v, t] = dest_gabs(tm)
                    let [vs, bod] = collectvs(t)
                    [PairList.cons([#true, v], vs), bod]
                  | [PairList [], tm]
              | if is_comb(tm) && name_of(rator(tm)) == s
                | if is_abs(rand(tm))
                  | let [v, t] = dest_abs(rand(tm))
                    let [vs, bod] = collectvs(t)
                    [PairList.cons([#false, v], vs), bod]
                  | if is_gabs(rand(tm))
                    | let [v, t] = dest_gabs(rand(tm))
                      let [vs, bod] = collectvs(t)
                      [PairList.cons([#true, v], vs), bod]
                    | [PairList [], tm]
                | [PairList [], tm]
            let [vs, bod] = collectvs(tm)
            if prec == 0
            | pp_open_hvbox(fmt)(4)
            | pp_open_hvbox(fmt)(5)
              pp_print_string(fmt)("(")
            color_switch(pp_print_colored_binder)(fmt)(s_prime)
            if isalnum(s_prime) | pp_print_string(fmt)(" ") | #void
            do_list(fun([b, x]):
                      if b | pp_print_string(fmt)("(") | #void
                      print_term(0)(x)
                      if b | pp_print_string(fmt)(")") | #void
                      pp_print_string(fmt)(" "))(butlast(vs))
            if fst(last(vs)) | pp_print_string(fmt)("(") | #void
            print_term(0)(snd(last(vs)))
            if fst(last(vs)) | pp_print_string(fmt)(")") | #void
            pp_print_string(fmt)(".")
            pp_print_space(fmt)(#void)
            print_term(0)(bod)
            if prec == 0 | #void | pp_print_string(fmt)(")")
            pp_close_box(fmt)(#void)
        fun print_clauses(cls):
          match cls
          | PairList [c]: print_clause(c)
          | PairList [c, & cs]:
              print_clause(c)
              pp_print_break(fmt)(1)(0)
              pp_print_string(fmt)("| ")
              print_clauses(cs)
        fun print_clause(cl):
          match cl
          | PairList [p, g, r]:
              print_term(1)(p)
              pp_print_string(fmt)(" when ")
              print_term(1)(g)
              pp_print_string(fmt)(" -> ")
              print_term(1)(r)
          | PairList [p, r]:
              print_term(1)(p)
              pp_print_string(fmt)(" -> ")
              print_term(1)(r)
        print_term(0)
  [print_colored_term(#false), print_colored_term(#true)]

def [pp_print_qterm, pp_print_colored_qterm]:
  let fn:
    fun(use_color):
      fun(fmt):
        fun(tm):
          pp_print_string(fmt)("`")
          (if use_color | pp_print_colored_term | pp_print_term)(fmt)(tm)
          pp_print_string(fmt)("`")
  [fn(#false), fn(#true)]

def [pp_print_thm, pp_print_colored_thm]:
  let fn:
    fun(use_color):
      fun(fmt):
        fun(th):
          let [asl, tm] = dest_thm(th)
          if !(asl == PairList [])
          | if print_all_thm.value
            | (if use_color | pp_print_colored_term | pp_print_term)(fmt)(hd(asl))
              do_list(fun(x):
                        pp_print_string(fmt)(",")
                        pp_print_space(fmt)(#void)
                        (if use_color | pp_print_colored_term | pp_print_term)(fmt)(x))(tl(asl))
            | pp_print_string(fmt)("...")
            pp_print_space(fmt)(#void)
          | #void
          pp_open_hbox(fmt)(#void)
          pp_print_string(fmt)("|- ")
          (if use_color | pp_print_colored_term | pp_print_term)(fmt)(tm)
          pp_close_box(fmt)(#void)
  [fn(#false), fn(#true)]

def print_type = pp_print_type(std_formatter)

def print_qtype = pp_print_qtype(std_formatter)

def print_term = pp_print_term(std_formatter)

def print_qterm = pp_print_qterm(std_formatter)

def print_thm = pp_print_thm(std_formatter)

fun print_to_string(printer):
  let buf = OCamlBuffer.create(16)
  let fmt = formatter_of_buffer(buf)
  let _ = pp_set_max_boxes(fmt)(100)
  let print = printer(fmt)
  let flush = pp_print_flush(fmt)
  fun(x):
    let _ = pp_set_margin(fmt)(get_margin(#void))
    let _ = print(x)
    let _ = flush(#void)
    let s = OCamlBuffer.contents(buf)
    let _ = OCamlBuffer.reset(buf)
    s

def string_of_type = print_to_string(pp_print_type)

def string_of_term = print_to_string(pp_print_term)

def string_of_thm = print_to_string(pp_print_thm)
