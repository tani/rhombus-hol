    port_tmp_26
  fun port_tmp_28(x):
    fun port_tmp_27(y):
      let k = ocaml_term_hash(x)
      fun upd(t):
        match t
        | Empty(): Leaf(k,PairList.cons([x, y],PairList []))
        | Leaf(h,l): (if fpf_equal(h)(k) | Leaf(h,port_tmp_19_define_list([x, y])(l)) | newbranch(h)(t)(k)(Leaf(k,PairList.cons([x, y],PairList []))))
        | Branch(p,b,l,r):
            if fpf_unequal(fpf_land(k)(fpf_sub(b)(1)))(p)
            | newbranch(p)(t)(k)(Leaf(k,PairList.cons([x, y],PairList [])))
            | (if fpf_equal(fpf_land(k)(b))(0) | Branch(p,b,upd(l),r) | Branch(p,b,l,upd(r)))
