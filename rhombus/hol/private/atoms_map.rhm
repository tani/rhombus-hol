#lang rhombus
// Original lib.ml Patricia-tree insertion/fold subset used by basics.atoms.
import: "compat.rhm" open
import: "../fusion.rhm" open
import: "term_hash.rhm" open
import:
  lib("racket/base.rkt") open:
    only:
      #{bitwise-xor}
      #{bitwise-and}
export:
  is_undefined
  mapf
  foldr
  tryapplyd
  undefine
  combine
  choose
  undefined
  fpf_define
  foldl
  applyd
  apply
class Empty()
class Leaf(hash,items)
class Branch(prefix,bit,left,right)
def undefined = Empty()
fun band(x,y): #{bitwise-and}(x,y)
fun newbranch(p1,t1,p2,t2):
  let zp = #{bitwise-xor}(p1,p2)
  let b = band(zp,-zp)
  let p = band(p1,b-1)
  if band(p1,b) == 0 | Branch(p,b,t1,t2) | Branch(p,b,t2,t1)
fun define_list(xy,l):
  let [x, y] = xy
  match l
  | PairList [ab :: List, & t]:
      let c = compare(x)(fst(ab))
      cond
      | c == 0: PairList.cons(xy,t)
      | c < 0: PairList.cons(xy,l)
      | ~else: PairList.cons(ab,define_list(xy,t))
  | PairList []: PairList [xy]
fun fpf_define(x):
  fun(y):
    let k = ocaml_term_hash(x)
    fun upd(t):
      match t
      | Empty(): Leaf(k,PairList [[x, y]])
      | Leaf(h,l): (if h == k | Leaf(h,define_list([x, y],l)) | newbranch(h,t,k,Leaf(k,PairList [[x, y]])))
      | Branch(p,b,l,r):
          cond
          | band(k,b-1) != p: newbranch(p,t,k,Leaf(k,PairList [[x, y]]))
          | band(k,b) == 0: Branch(p,b,upd(l),r)
          | ~else: Branch(p,b,l,upd(r))
    upd
fun foldl(f):
  fun(a):
    fun(t):
      fun fl(f,a,l):
        match l
        | PairList []: a
        | PairList [[x, y], & t]: fl(f,f(a)(x)(y),t)
      match t
      | Empty(): a
      | Leaf(_,l): fl(f,a,l)
      | Branch(_,_,l,r): foldl(f)(foldl(f)(a)(l))(r)

fun applyd(f):
  fun(d):
    fun(x):
      fun apply_listd(l):
        match l
        | PairList [[a, b],&t]:
            let c=compare(x)(a)
            if c==0 | b | (if c>0 | apply_listd(t) | d(x))
        | PairList []: d(x)
      let k=ocaml_term_hash(x)
      fun look(t):
        match t
        | Leaf(h,l): (if h==k | apply_listd(l) | d(x))
        | Branch(p,b,l,r):
            if band(#{bitwise-xor}(k,p),b-1)==0
            | look(if band(k,b)==0 | l | r)
            | d(x)
        | _: d(x)
      look(f)
fun apply(f): applyd(f)(fun(_): failwith("apply"))

// Additional lib.ml operations, translated from its original compiler AST.
fun fpf_raise(x): throw x
fun fpf_equal(x): fun(y): x==y
fun fpf_unequal(x): fun(y): x!=y
fun fpf_physical_equal(x): fun(y): x===y
fun fpf_lt(x): fun(y): x<y
fun fpf_gt(x): fun(y): x>y
fun fpf_le(x): fun(y): x<=y
fun fpf_add(x): fun(y): x+y
fun fpf_sub(x): fun(y): x-y
fun fpf_neg(x): -x
fun fpf_land(x): fun(y): band(x,y)
fun fpf_lxor(x): fun(y): #{bitwise-xor}(x,y)



fun fpf_is_undefined(f):
  match f
  | Empty(): #true
  | _: #false

def fpf_mapf:
  fun map_list(f):
    fun port_tmp_3(l):
      match l
      | PairList []: PairList []
      | PairList [[x, y], & t]:
          let port_tmp_1 = map_list(f)(t)
          let port_tmp_2 = [x, f(y)]
          PairList.cons(port_tmp_2,port_tmp_1)
    port_tmp_3
  fun port_tmp_4_mapf(f):
    fun port_tmp_7(t):
      match t
      | Empty(): Empty()
      | Leaf(h,l): Leaf(h,map_list(f)(l))
      | Branch(p,b,l,r):
          let port_tmp_5 = port_tmp_4_mapf(f)(r)
          let port_tmp_6 = port_tmp_4_mapf(f)(l)
          Branch(p,b,port_tmp_6,port_tmp_5)
    port_tmp_7
  port_tmp_4_mapf

def fpf_foldr:
  fun foldr_list(f):
    fun port_tmp_9(l):
      fun port_tmp_8(a):
        match l
        | PairList []: a
        | PairList [[x, y], & t]: f(x)(y)(foldr_list(f)(t)(a))
      port_tmp_8
    port_tmp_9
  fun port_tmp_10_foldr(f):
    fun port_tmp_12(t):
      fun port_tmp_11(a):
        match t
        | Empty(): a
        | Leaf(h,l): foldr_list(f)(l)(a)
        | Branch(p,b,l,r): port_tmp_10_foldr(f)(l)(port_tmp_10_foldr(f)(r)(a))
      port_tmp_11
    port_tmp_12
  port_tmp_10_foldr

fun fpf_tryapplyd(f): (fun(a): (fun(d): applyd(f)((fun(x): d))(a)))

def fpf_undefine:
  fun undefine_list(x):
    fun port_tmp_13(l):
      match l
      | PairList [[a, b] as ab, & t]:
          let c = compare(x)(a)
          if fpf_equal(c)(0)
          | t
          | if fpf_lt(c)(0)
            | l
            | let t_prime = undefine_list(x)(t)
              (if fpf_physical_equal(t_prime)(t) | l | PairList.cons(ab,t_prime))
      | PairList []: PairList []
    port_tmp_13
  fun port_tmp_14(x):
    let k = ocaml_term_hash(x)
    fun und(t):
      match t
      | Leaf(h,l):
          if fpf_equal(h)(k)
          | let l_prime = undefine_list(x)(l)
            if fpf_physical_equal(l_prime)(l)
            | t
            | (if fpf_equal(l_prime)(PairList []) | Empty() | Leaf(h,l_prime))
          | match t
            | Branch(p,b,l,r):
                if fpf_equal(fpf_land(k)(fpf_sub(b)(1)))(p)
                | if fpf_equal(fpf_land(k)(b))(0)
                  | let l_prime = und(l)
                    if fpf_physical_equal(l_prime)(l)
                    | t
                    | match l_prime
                      | Empty(): r
                      | _: Branch(p,b,l_prime,r)
                  | let r_prime = und(r)
                    if fpf_physical_equal(r_prime)(r)
                    | t
                    | match r_prime
                      | Empty(): l
                      | _: Branch(p,b,l,r_prime)
                | match t
                  | _: t
            | _: t
      | Branch(p,b,l,r):
          if fpf_equal(fpf_land(k)(fpf_sub(b)(1)))(p)
          | if fpf_equal(fpf_land(k)(b))(0)
            | let l_prime = und(l)
              if fpf_physical_equal(l_prime)(l)
              | t
              | match l_prime
                | Empty(): r
                | _: Branch(p,b,l_prime,r)
            | let r_prime = und(r)
              if fpf_physical_equal(r_prime)(r)
              | t
              | match r_prime
                | Empty(): l
                | _: Branch(p,b,l,r_prime)
          | match t
            | _: t
      | _: t
    und
  port_tmp_14

def [fpf__op7c__op2d__op3e_, fpf_combine]:
  fun port_tmp_18(p1):
    fun port_tmp_17(t1):
      fun port_tmp_16(p2):
        fun port_tmp_15(t2):
          let zp = fpf_lxor(p1)(p2)
          let b = fpf_land(zp)(fpf_neg(zp))
          let p = fpf_land(p1)(fpf_sub(b)(1))
          (if fpf_equal(fpf_land(p1)(b))(0) | Branch(p,b,t1,t2) | Branch(p,b,t2,t1))
        port_tmp_15
      port_tmp_16
    port_tmp_17
  let newbranch = port_tmp_18
  fun port_tmp_19_define_list([x, y] as xy):
    fun port_tmp_21(l):
      match l
      | PairList [[a, b] as ab, & t]:
          let c = compare(x)(a)
          if fpf_equal(c)(0)
          | PairList.cons(xy,t)
          | (if fpf_lt(c)(0) | PairList.cons(xy,l) | PairList.cons(ab,port_tmp_19_define_list(xy)(t)))
      | PairList []: PairList.cons(xy,PairList [])
    port_tmp_21
  fun port_tmp_20_combine_list(op):
    fun port_tmp_26(z):
      fun port_tmp_25(l1):
        fun port_tmp_24(l2):
          match [l1, l2]
          | [PairList [], _]: l2
          | [_, PairList []]: l1
          | [PairList [[x1, y1] as xy1, & t1], PairList [[x2, y2] as xy2, & t2]]:
              let c = compare(x1)(x2)
              if fpf_lt(c)(0)
              | PairList.cons(xy1,port_tmp_20_combine_list(op)(z)(t1)(l2))
              | if fpf_gt(c)(0)
                | PairList.cons(xy2,port_tmp_20_combine_list(op)(z)(l1)(t2))
                | let port_tmp_22_y = op(y1)(y2)
                  let port_tmp_23_l = port_tmp_20_combine_list(op)(z)(t1)(t2)
                  (if z(port_tmp_22_y) | port_tmp_23_l | PairList.cons([x1, port_tmp_22_y],port_tmp_23_l))
        port_tmp_24
