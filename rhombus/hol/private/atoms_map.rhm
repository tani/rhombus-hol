              | if fpf_equal(fpf_land(k)(b))(0)
                | match port_tmp_29_combine(op)(z)(l)(lf)
                  | Empty(): r
                  | l_prime: Branch(p,b,l_prime,r)
                | match port_tmp_29_combine(op)(z)(r)(lf)
