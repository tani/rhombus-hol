#lang rhombus
// Original lib.ml Patricia-tree insertion/fold subset used by basics.atoms.
import: "compat.rhm" open
import: "../fusion.rhm" open
import: "term_hash.rhm" open
import:
  lib("racket/base.rkt") open:
    only:
      #{bitwise-xor}
      #{bitwise-and}
export:
  is_undefined
  mapf
  foldr
  tryapplyd
  undefine
  combine
  choose
  undefined
  fpf_define
  foldl
  applyd
  apply
class Empty()
class Leaf(hash,items)
class Branch(prefix,bit,left,right)
def undefined = Empty()
fun band(x,y): #{bitwise-and}(x,y)
fun newbranch(p1,t1,p2,t2):
  let zp = #{bitwise-xor}(p1,p2)
  let b = band(zp,-zp)
  let p = band(p1,b-1)
  if band(p1,b) == 0 | Branch(p,b,t1,t2) | Branch(p,b,t2,t1)
fun define_list(xy,l):
  let [x, y] = xy
  match l
  | PairList [ab :: List, & t]:
      let c = compare(x)(fst(ab))
      cond
      | c == 0: PairList.cons(xy,t)
      | c < 0: PairList.cons(xy,l)
      | ~else: PairList.cons(ab,define_list(xy,t))
  | PairList []: PairList [xy]
fun fpf_define(x):
  fun(y):
    let k = ocaml_term_hash(x)
    fun upd(t):
      match t
      | Empty(): Leaf(k,PairList [[x, y]])
      | Leaf(h,l): (if h == k | Leaf(h,define_list([x, y],l)) | newbranch(h,t,k,Leaf(k,PairList [[x, y]])))
      | Branch(p,b,l,r):
          cond
          | band(k,b-1) != p: newbranch(p,t,k,Leaf(k,PairList [[x, y]]))
          | band(k,b) == 0: Branch(p,b,upd(l),r)
          | ~else: Branch(p,b,l,upd(r))
    upd
fun foldl(f):
  fun(a):
    fun(t):
      fun fl(f,a,l):
        match l
        | PairList []: a
        | PairList [[x, y], & t]: fl(f,f(a)(x)(y),t)
      match t
      | Empty(): a
      | Leaf(_,l): fl(f,a,l)
      | Branch(_,_,l,r): foldl(f)(foldl(f)(a)(l))(r)

fun applyd(f):
  fun(d):
    fun(x):
      fun apply_listd(l):
        match l
        | PairList [[a, b],&t]:
            let c=compare(x)(a)
            if c==0 | b | (if c>0 | apply_listd(t) | d(x))
        | PairList []: d(x)
      let k=ocaml_term_hash(x)
      fun look(t):
        match t
        | Leaf(h,l): (if h==k | apply_listd(l) | d(x))
        | Branch(p,b,l,r):
            if band(#{bitwise-xor}(k,p),b-1)==0
            | look(if band(k,b)==0 | l | r)
            | d(x)
        | _: d(x)
      look(f)
fun apply(f): applyd(f)(fun(_): failwith("apply"))
// Additional lib.ml operations, translated from its original compiler AST.
fun fpf_raise(x): throw x
fun fpf_equal(x): fun(y): x==y
fun fpf_unequal(x): fun(y): x!=y
fun fpf_physical_equal(x): fun(y): x===y
fun fpf_lt(x): fun(y): x<y
fun fpf_gt(x): fun(y): x>y
fun fpf_le(x): fun(y): x<=y
fun fpf_add(x): fun(y): x+y
fun fpf_sub(x): fun(y): x-y
fun fpf_neg(x): -x
fun fpf_land(x): fun(y): band(x,y)
fun fpf_lxor(x): fun(y): #{bitwise-xor}(x,y)



fun fpf_is_undefined(f):
  match f
  | Empty(): #true
  | _: #false

def fpf_mapf:
  // Recursive local helpers need definitions so their own bodies can call them.
  fun map_list(f):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [[x, y], & t]: PairList [[x, f(y)], & map_list(f)(t)]
  fun mapf_2(f):
    fun(t):
      match t
      | Empty(): Empty()
      | Leaf(h,l): Leaf(h, map_list(f)(l))
      | Branch(p,b,l,r): Branch(p, b, mapf_2(f)(l), mapf_2(f)(r))
  mapf_2

def fpf_foldr:
  // Recursive local helpers need definitions so their own bodies can call them.
  fun foldr_list(f):
    fun(l):
      fun(a):
        match l
        | PairList []: a
        | PairList [[x, y], & t]: f(x)(y)(foldr_list(f)(t)(a))
  fun foldr_2(f):
    fun(t):
      fun(a):
        match t
        | Empty(): a
        | Leaf(h,l): foldr_list(f)(l)(a)
        | Branch(p,b,l,r): foldr_2(f)(l)(foldr_2(f)(r)(a))
  foldr_2

fun fpf_tryapplyd(f): fun(a): fun(d): applyd(f)((fun(x): d))(a)

def fpf_undefine:
  // This recursive local helper needs a definition for self-reference.
  fun undefine_list(x):
    fun(l):
      match l
      | PairList [[a, b] as ab, & t]:
          let c = compare(x)(a)
          if fpf_equal(c)(0)
          | t
          | if fpf_lt(c)(0)
            | l
            | let t_prime = undefine_list(x)(t)
              (if fpf_physical_equal(t_prime)(t) | l | PairList [ab, & t_prime])
      | PairList []: PairList []
  fun(x):
    fun(t):
      let k = ocaml_term_hash(x)
      fun und(t):
        match t
        | Leaf(h,l):
            if fpf_equal(h)(k)
            | let l_prime = undefine_list(x)(l)
              if fpf_physical_equal(l_prime)(l)
              | t
              | (if fpf_equal(l_prime)(PairList []) | Empty() | Leaf(h, l_prime))
            | match t
              | Branch(p,b,l,r):
                  if fpf_equal(fpf_land(k)(fpf_sub(b)(1)))(p)
                  | if fpf_equal(fpf_land(k)(b))(0)
                    | let l_prime = und(l)
                      if fpf_physical_equal(l_prime)(l)
                      | t
                      | match l_prime
                        | Empty(): r
                        | _: Branch(p, b, l_prime, r)
                    | let r_prime = und(r)
                      if fpf_physical_equal(r_prime)(r)
                      | t
                      | match r_prime
                        | Empty(): l
                        | _: Branch(p, b, l, r_prime)
                  | match t
                    | _: t
              | _: t
        | Branch(p,b,l,r):
            if fpf_equal(fpf_land(k)(fpf_sub(b)(1)))(p)
            | if fpf_equal(fpf_land(k)(b))(0)
              | let l_prime = und(l)
                if fpf_physical_equal(l_prime)(l)
                | t
                | match l_prime
                  | Empty(): r
                  | _: Branch(p, b, l_prime, r)
              | let r_prime = und(r)
                if fpf_physical_equal(r_prime)(r)
                | t
                | match r_prime
                  | Empty(): l
                  | _: Branch(p, b, l, r_prime)
            | match t
              | _: t
        | _: t
      und(t)

def [fpf__op7c__op2d__op3e__v2, fpf_combine]:
  // Recursive local helpers need definitions so their own bodies can call them.
  let newbranch = fun(p1):
    fun(t1):
      fun(p2):
        fun(t2):
          let zp = fpf_lxor(p1)(p2)
          let b = fpf_land(zp)(fpf_neg(zp))
          let p = fpf_land(p1)(fpf_sub(b)(1))
          (if fpf_equal(fpf_land(p1)(b))(0) | Branch(p, b, t1, t2) | Branch(p, b, t2, t1))
  fun define_list_2([x, y] as xy):
    fun(l):
      match l
      | PairList [[a, b] as ab, & t]:
          let c = compare(x)(a)
          if fpf_equal(c)(0)
          | PairList [xy, & t]
          | (if fpf_lt(c)(0) | PairList [xy, & l] | PairList [ab, & define_list_2(xy)(t)])
      | PairList []: PairList [xy]
  fun combine_list_2(op):
    fun(z):
      fun(l1):
        fun(l2):
          match [l1, l2]
          | [PairList [], _]: l2
          | [_, PairList []]: l1
          | [PairList [[x1, y1] as xy1, & t1], PairList [[x2, y2] as xy2, & t2]]:
              let c = compare(x1)(x2)
              if fpf_lt(c)(0)
              | PairList [xy1, & combine_list_2(op)(z)(t1)(l2)]
              | if fpf_gt(c)(0)
                | PairList [xy2, & combine_list_2(op)(z)(l1)(t2)]
                | let y_2 = op(y1)(y2)
                  let l_2 = combine_list_2(op)(z)(t1)(t2)
                  (if z(y_2) | l_2 | PairList [[x1, y_2], & l_2])
  let _op7c__op2d__op3e_ = fun(x):
    fun(y):
      fun(t):
        let k = ocaml_term_hash(x)
        fun upd(t):
              match t
              | Empty(): Leaf(k, PairList [[x, y]])
              | Leaf(h,l): (if fpf_equal(h)(k) | Leaf(h, define_list_2([x, y])(l)) | newbranch(h)(t)(k)(Leaf(k, PairList [[x, y]])))
              | Branch(p,b,l,r):
                  if fpf_unequal(fpf_land(k)(fpf_sub(b)(1)))(p)
                  | newbranch(p)(t)(k)(Leaf(k, PairList [[x, y]]))
                  | (if fpf_equal(fpf_land(k)(b))(0) | Branch(p, b, upd(l), r) | Branch(p, b, l, upd(r)))
        upd(t)
  fun combine_2(op):
    fun(z):
      fun(t1):
        fun(t2):
          match [t1, t2]
          | [Empty(), _]: t2
          | [_, Empty()]: t1
          | [Leaf(h1,l1), Leaf(h2,l2)]:
              if fpf_equal(h1)(h2)
              | let l = combine_list_2(op)(z)(l1)(l2)
                (if fpf_equal(l)(PairList []) | Empty() | Leaf(h1, l))
              | newbranch(h1)(t1)(h2)(t2)
          | [Leaf(k,lis) as lf, Branch(p,b,l,r) as br]:
              if fpf_equal(fpf_land(k)(fpf_sub(b)(1)))(p)
              | if fpf_equal(fpf_land(k)(b))(0)
                | match combine_2(op)(z)(lf)(l)
                  | Empty(): r
                  | l_prime: Branch(p, b, l_prime, r)
                | match combine_2(op)(z)(lf)(r)
                  | Empty(): l
                  | r_prime: Branch(p, b, l, r_prime)
              | newbranch(k)(lf)(p)(br)
          | [Branch(p,b,l,r) as br, Leaf(k,lis) as lf]:
              if fpf_equal(fpf_land(k)(fpf_sub(b)(1)))(p)
              | if fpf_equal(fpf_land(k)(b))(0)
                | match combine_2(op)(z)(l)(lf)
                  | Empty(): r
                  | l_prime: Branch(p, b, l_prime, r)
                | match combine_2(op)(z)(r)(lf)
                  | Empty(): l
                  | r_prime: Branch(p, b, l, r_prime)
              | newbranch(p)(br)(k)(lf)
          | [Branch(p1,b1,l1,r1), Branch(p2,b2,l2,r2)]:
              if fpf_lt(b1)(b2)
              | if fpf_unequal(fpf_land(p2)(fpf_sub(b1)(1)))(p1)
                | newbranch(p1)(t1)(p2)(t2)
                | if fpf_equal(fpf_land(p2)(b1))(0)
                  | match combine_2(op)(z)(l1)(t2)
                    | Empty(): r1
                    | l: Branch(p1, b1, l, r1)
                  | match combine_2(op)(z)(r1)(t2)
                    | Empty(): l1
                    | r: Branch(p1, b1, l1, r)
              | if fpf_lt(b2)(b1)
                | if fpf_unequal(fpf_land(p1)(fpf_sub(b2)(1)))(p2)
                  | newbranch(p1)(t1)(p2)(t2)
                  | if fpf_equal(fpf_land(p1)(b2))(0)
                    | match combine_2(op)(z)(t1)(l2)
                      | Empty(): r2
                      | l: Branch(p2, b2, l, r2)
                    | match combine_2(op)(z)(t1)(r2)
                      | Empty(): l2
                      | r: Branch(p2, b2, l2, r)
                | if fpf_equal(p1)(p2)
                  | match [combine_2(op)(z)(l1)(l2), combine_2(op)(z)(r1)(r2)]
                    | [Empty(), r]: r
                    | [l, Empty()]: l
                    | [l, r]: Branch(p1, b1, l, r)
                  | newbranch(p1)(t1)(p2)(t2)
  [_op7c__op2d__op3e_, combine_2]

fun fpf_choose(t):
  match t
  | Empty(): failwith("choose: completely undefined function")
  | Leaf(h,l): hd(l)
  | Branch(b,p,t1,t2): fpf_choose(t1)

def is_undefined = fpf_is_undefined

def mapf = fpf_mapf

def foldr = fpf_foldr

def tryapplyd = fpf_tryapplyd

def undefine = fpf_undefine

def _op7c__op2d__op3e_ = fpf__op7c__op2d__op3e__v2

def combine = fpf_combine

def choose = fpf_choose
