                    | Empty(): l1
                    | r: Branch(p1,b1,l1,r)
              | if fpf_lt(b2)(b1)
                | if fpf_unequal(fpf_land(p1)(fpf_sub(b2)(1)))(p2)
                  | newbranch(p1)(t1)(p2)(t2)
                  | if fpf_equal(fpf_land(p1)(b2))(0)
                    | match port_tmp_29_combine(op)(z)(t1)(l2)
