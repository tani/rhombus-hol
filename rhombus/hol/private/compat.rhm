#lang rhombus
import: "curried.rhm" open
// (c) University of Cambridge 1998; John Harrison 1998-2007.
// Derived from HOL Light; redistribution terms and disclaimer in ../LICENSE.
// Algorithm-preserving translations from upstream lib.ml; kernel-reachable subset.
// OCaml lists are PairList, not Rhombus's RRB-tree List.
export:
  Failure
  failwith
  I
  K
  C
  o
  fst
  snd
  hd
  tl
  map
  can
  itlist
  rev_itlist
  forall
  exists
  length
  filter
  partition
  mem
  insert
  union
  subtract
  subset
  assoc
  rev_assocd
  qmap
  sort
  append

class Failure(message)
fun failwith(s): throw Failure(s)
fun I(x): x
curried fun K(x, y): x
curried fun C(f, x, y): f(y)(x)
curried fun o(f, g, x): f(g(x))
fun fst([x, y]): x
fun snd([x, y]): y
fun hd(l):
  match l
  | PairList [h, & t]: h
  | _: failwith("hd")
fun tl(l):
  match l
  | PairList [h, & t]: t
  | _: failwith("tl")
fun map(f):
  fun mapf(l):
    match l
    | PairList []: PairList []
    | PairList [x, & t]:
        let y = f(x)
        PairList.cons(y, mapf(t))
  mapf
fun can(f):
  fun(x):
    try:
      f(x)
      #true
      ~catch Failure(_): #false
fun itlist(f):
  fun(l):
    fun(b):
      match l
      | PairList []: b
      | PairList [h, & t]:
          let rest = itlist(f)(t)(b)
          f(h)(rest)
fun rev_itlist(f):
  fun(l):
    fun(b):
      match l
      | PairList []: b
      | PairList [h, & t]: rev_itlist(f)(t)(f(h)(b))
fun forall(p):
  fun(l):
    match l
    | PairList []: #true
    | PairList [h, & t]: p(h) && forall(p)(t)
fun exists(p):
  fun(l):
    match l
    | PairList []: #false
    | PairList [h, & t]: p(h) || exists(p)(t)
fun length(l):
  fun len(k,l):
    if l == PairList [] | k | len(k+1,tl(l))
  len(0,l)
fun filter(p):
  fun(l):
    match l
    | PairList []: l
    | PairList [h, & t]:
        let t1 = filter(p)(t)
        if p(h) | (if t1 === t | l | PairList.cons(h,t1)) | t1
fun partition(p):
  fun(l):
    match l
    | PairList []: [PairList [], l]
    | PairList [h, & t]:
        let [yes, no] = partition(p)(t)
        if p(h)
        | (if yes === t | [l, PairList []] | [PairList.cons(h,yes), no])
        | (if no === t | [PairList [], l] | [yes, PairList.cons(h,no)])
// On immutable HOL values structural == is equivalent to OCaml compare(...)=0.
// This is deliberately NOT a general OCaml polymorphic compare implementation.
fun mem(x):
  fun(l):
    match l
    | PairList []: #false
    | PairList [h, & t]: x == h || mem(x)(t)
fun insert(x): fun(l): if mem(x)(l) | l | PairList.cons(x,l)
fun union(l1): fun(l2): itlist(insert)(l1)(l2)
fun subtract(l1): fun(l2): filter(fun(x): !mem(x)(l2))(l1)
fun subset(l1): fun(l2): forall(fun(x): mem(x)(l2))(l1)
fun assoc(a):
  fun(l):
    match l
    | PairList [[x, y], & t]: (if x == a | y | assoc(a)(t))
    | PairList []: failwith("find")
fun rev_assocd(a):
  fun(l):
    fun(d):
      match l
      | PairList []: d
      | PairList [[x, y], & t]: (if y == a | x | rev_assocd(a)(t)(d))
fun qmap(f):
  fun(l):
    match l
    | PairList [h, & t]:
        let h1 = f(h)
        let t1 = qmap(f)(t)
        if h1 === h && t1 === t | l | PairList.cons(h1,t1)
    | _: l
fun append(l1):
  fun(l2):
    match l1
    | PairList []: l2
    | PairList [h, & t]: PairList.cons(h,append(t)(l2))
fun sort(cmp):
  fun(l):
    match l
    | PairList []: PairList []
    | PairList [piv, & rest]:
        let [r, left] = partition(cmp(piv))(rest)
        append(sort(cmp)(left))(PairList.cons(piv,sort(cmp)(r)))

// Further original lib.ml utilities needed by basics/equal/nets.
export:
  curry
  uncurry
  W
  fail
  rev_assoc
  itlist2
  end_itlist
  splitlist
  rev_splitlist
  striplist
  nsplit
  find
  tryfind
  mapfilter
  zip
  unzip
  implode
  explode
  Unchanged
  InvalidArgument
class Unchanged()
class InvalidArgument(message)
fun fail(): failwith("")
fun curry(f): fun(x): fun(y): f([x, y])
fun uncurry(f): fun([x, y]): f(x)(y)
fun W(f): fun(x): f(x)(x)
fun rev_assoc(a):
  fun(l):
    match l
    | PairList [[x, y], & t]: (if y == a | x | rev_assoc(a)(t))
    | PairList []: failwith("find")
fun itlist2(f):
  fun(l1):
    fun(l2):
      fun(b):
        match [l1, l2]
        | [PairList [], PairList []]: b
        | [PairList [h1, & t1], PairList [h2, & t2]]:
            let rest = itlist2(f)(t1)(t2)(b)
            f(h1)(h2)(rest)
        | _: failwith("itlist2")
fun end_itlist(f):
  fun(l):
    match l
    | PairList []: failwith("end_itlist")
    | PairList [x]: x
    | PairList [h, & t]:
        let rest = end_itlist(f)(t)
        f(h)(rest)
fun splitlist(dest):
  fun(x):
    try:
      let [l, r] = dest(x)
      let [ls, res] = splitlist(dest)(r)
      [PairList.cons(l,ls), res]
      ~catch Failure(_): [PairList [], x]
fun rev_splitlist(dest):
  fun rsplist(ls,x):
    try:
      let [l, r] = dest(x)
      rsplist(PairList.cons(r,ls),l)
      ~catch Failure(_): [x, ls]
  fun(x): rsplist(PairList [],x)
fun striplist(dest):
  fun strip(x,acc):
    try:
      let [l, r] = dest(x)
      strip(l,strip(r,acc))
      ~catch Failure(_): PairList.cons(x,acc)
  fun(x): strip(x,PairList [])
fun nsplit(dest):
  fun(clist):
    fun(x):
      if clist == PairList []
      | [PairList [], x]
      | let [l, r] = dest(x)
        let [ll, y] = nsplit(dest)(tl(clist))(r)
        [PairList.cons(l,ll), y]
fun find(p):
  fun(l):
    match l
    | PairList []: failwith("find")
    | PairList [h, & t]: (if p(h) | h | find(p)(t))
fun tryfind(f):
  fun(l):
    match l
    | PairList []: failwith("tryfind")
    | PairList [h, & t]:
        try:
          f(h)
          ~catch Failure(_): tryfind(f)(t)
fun mapfilter(f):
  fun(l):
    match l
    | PairList []: PairList []
    | PairList [h, & t]:
        let rest = mapfilter(f)(t)
        try:
          PairList.cons(f(h),rest)
          ~catch Failure(_): rest
fun zip(l1):
  fun(l2):
    match [l1, l2]
    | [PairList [], PairList []]: PairList []
    | [PairList [h1, & t1], PairList [h2, & t2]]: PairList.cons([h1, h2],zip(t1)(t2))
    | _: failwith("zip")
fun unzip(l):
  match l
  | PairList []: [PairList [], PairList []]
  | PairList [[a, b], & rest]:
      let [alist, blist] = unzip(rest)
      [PairList.cons(a,alist), PairList.cons(b,blist)]
fun implode(l): itlist(fun(x): fun(y): x +& y)(l)("")
fun explode(s):
  fun exap(n,l):
    if n < 0 | l | exap(n-1,PairList.cons(s.substring(n,n+1),l))
  exap(s.length()-1,PairList [])
