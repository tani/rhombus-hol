#lang rhombus/and_meta
// Accept grouped arguments while executing the original unary stages in order.
// A completed application returns its result unchanged, including functions.
export: curry_stages curried

meta:
  fun unary_stages(args, body):
    match args
    | [arg]: 'fun($arg) $body'
    | [arg, & rest]: 'fun($arg): $(unary_stages(rest, body))'
    | []: error("curried: expected at least one argument")

fun curry_stages(stage, remaining):
  fun dispatch(first, & args):
    fun consume(stage, remaining, args):
      match args
      | []: curry_stages(stage, remaining)
      | [arg, & rest]:
          let result = stage(arg)
          if rest == []
          | (if remaining == 1 | result | curry_stages(result, remaining - 1))
          | consume(result, (if remaining > 1 | remaining - 1 | 1), rest)
    consume(stage, remaining, [first, & args])
  dispatch

// The first binding can be a tuple pattern. Further stages remain ordinary funs
// so initialization between arguments happens at the original application step.
defn.macro
| 'curried fun $name($arg, ...) $body':
    let args = [arg, ...]
    'def $name = curry_stages(($(unary_stages(args, body))), $(args.length()))'
| 'curried($arity) fun $name($arg) $body':
    'def $name = curry_stages((fun($arg) $body), $arity)'
