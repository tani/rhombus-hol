#lang rhombus
// Immutable OCaml algebraic values, options, and tuples.
import: "compat.rhm" open
export:
  HolVariant
  None
  Some
  HolTuple3
  HolTuple4
  HolTuple5
  HolTuple6
  HolTuple7
  HolTuple8
  HolTuple9
  HolTuple10
  HolTuple11
  HolTuple12
  HolTuple13
class HolVariant():
  nonfinal
  implements Equatable
  override equals(other :~ HolVariant, recur): this === other || recur(this.port_view(),other.port_view())
  override hash_code(recur): recur(this.port_view())
  method port_view(): failwith("abstract variant")
class None():
  extends HolVariant
  override port_view(): Pair(0,Pair(0,PairList []))
class Some(field0):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.field0]))
class HolTuple3(a,b,c):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.a,this.b,this.c]))
class HolTuple4(a,b,c,d):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.a,this.b,this.c,this.d]))
class HolTuple5(a,b,c,d,e):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.a,this.b,this.c,this.d,this.e]))
class HolTuple6(a,b,c,d,e,f):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.a,this.b,this.c,this.d,this.e,this.f]))
class HolTuple7(a,b,c,d,e,f,g):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.a,this.b,this.c,this.d,this.e,this.f,this.g]))
class HolTuple8(a,b,c,d,e,f,g,h):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.a,this.b,this.c,this.d,this.e,this.f,this.g,this.h]))
class HolTuple9(a,b,c,d,e,f,g,h,i):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.a,this.b,this.c,this.d,this.e,this.f,this.g,this.h,this.i]))
class HolTuple10(a,b,c,d,e,f,g,h,i,j):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.a,this.b,this.c,this.d,this.e,this.f,this.g,this.h,this.i,this.j]))

class HolTuple11(a,b,c,d,e,f,g,h,i,j,k):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.a,this.b,this.c,this.d,this.e,this.f,this.g,this.h,this.i,this.j,this.k]))

class HolTuple12(a,b,c,d,e,f,g,h,i,j,k,l):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.a,this.b,this.c,this.d,this.e,this.f,this.g,this.h,this.i,this.j,this.k,this.l]))

class HolTuple13(a,b,c,d,e,f,g,h,i,j,k,l,m):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,PairList [this.a,this.b,this.c,this.d,this.e,this.f,this.g,this.h,this.i,this.j,this.k,this.l,this.m]))
