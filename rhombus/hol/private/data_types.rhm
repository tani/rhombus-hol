#lang rhombus
// Immutable OCaml algebraic values and options.
import: "compat.rhm" open
export:
  HolVariant
  None
  Some
class HolVariant():
  nonfinal
  implements Equatable
  override equals(other :~ HolVariant, recur): this === other || recur(this.port_view(),other.port_view())
  override hash_code(recur): recur(this.port_view())
  method port_view(): failwith("abstract variant")
class None():
  extends HolVariant
  override port_view(): [0, [0, PairList []]]
class Some(field0):
  extends HolVariant
  override port_view(): [1, [0, PairList [this.field0]]]
