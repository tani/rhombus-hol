#lang rhombus/and_meta
import: "data_types.rhm" open
export: variant record

// Constructor order is the OCaml structural-comparison order. Nullary and
// payload constructors have separate tag sequences, as in the OCaml runtime.
defn.macro 'variant $type:
              $case
              ...':
  let empty_tag = Box(0)
  let payload_tag = Box(0)
  let [declaration, ...]:
    for List (case in [case, ...]):
      match case
      | '$name($field, ...)':
          let fields = [field, ...]
          let kind = if fields == [] | 0 | 1
          let counter = if kind == 0 | empty_tag | payload_tag
          let tag = counter.value
          counter.value := tag + 1
          'class $name($field, ...):
             extends HolVariant
             override port_view(): [$(kind), [$(tag), PairList [this . $field, ...]]]'
      | _: error("variant: expected a constructor declaration")
  '$declaration
   ...'

defn.macro 'record $name($field, ...)':
  let [key, ...] = [field.unwrap() +& "", ...]
  'class $name($field, ...):
     extends HolVariant
     override port_view(): PairList [this . $field, ...]
     method port_update(updates):
       $name((if updates.has_key($key) | updates[$key] | this . $field), ...)'
