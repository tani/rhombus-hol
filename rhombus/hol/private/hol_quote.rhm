#lang rhombus/and_meta
// `hol:` — Rhombus-native HOL term quotation.
//
// A `hol:` block declares free variables and constants with complete HOL
// types and ends in one HOL expression. Expressions and types are parsed
// in their own spaces with Rhombus enforestation (operators keep their
// native order and associativity), then elaborated at expansion time:
// names resolve to declarations or the innermost binder, and every
// application, operator and branch is checked against fully declared
// types. There is no unification, inference or coercion. The elaborated term
// is embedded as constant data, which build_term turns into a kernel term with
// the public constructors (mk_var, mk_mconst, mk_comb, mk_abs, mk_type,
// mk_vartype); no theorem is produced. Constant data costs the compiler
// nothing per node, unlike generated constructor calls.
//
// A HOL name that is not a Rhombus identifier is an escaped identifier
// (`#{+}`, `#{|x'|}`); an infix operator name on its own (`#{+}(m, n)`) is that
// name. `(NAME :: type)` is the name at exactly that type: a variable when a
// variable of that name is declared or bound in the quotation, a constant
// otherwise. It writes a second instance of a constant, a variable that a
// binder of the same name hides, and `!` and `-`, which are also prefix forms.
// HOL_QUOTE_DUMP=1 prints every expansion (tools/hol_light_golden/
// compare_quote_dumps.py compares two such logs).
import:
  "ocaml.rhm" open
  "../fusion.rhm" as Kernel
  "../basics.rhm" as Basics
  "../parser.rhm" as Parser
  lib("racket/base.rkt"):
    expose:
      quote
      getenv
  meta:
    lib("racket/base.rkt") as Rkt:
      only:
        #{exact-nonnegative-integer?}
        #{datum->syntax}
        #{getenv}
// ---------------------------------------------------------------------
// Run time: a quoted term's constant data to a kernel term. The data is
// ["V", name] / ["T", name, args] for types and ["v", name, type],
// ["c", name, type], ["a", f, x], ["l", v, body] for terms.

fun build_type(d):
  match d
  | PairList["V", n]: Kernel.mk_vartype(n)
  | PairList["T", n, args]: Kernel.mk_type([n, PairList.map(args, build_type)])
fun build_term(d):
  match d
  | PairList["v", n, ty]: Kernel.mk_var([n, build_type(ty)])
  | PairList["c", n, ty]: Basics.mk_mconst([n, build_type(ty)])
  | PairList["a", f, x]: Kernel.mk_comb([build_term(f), build_term(x)])
  | PairList["l", v, b]: Kernel.mk_abs([build_term(v), build_term(b)])

// ---------------------------------------------------------------------
// Run time: `@hol|{...}|` text. HOL Light's quotation expander turns
// `` `:ty` `` into parse_type and every other quotation into parse_term, read
// against the theory tables of the moment; HOL_QUOTE_CHECK=1 prints each
// result as HOLCHECK lines in the HOL_QUOTE_DUMP encoding.

def quote_check = getenv("HOL_QUOTE_CHECK")

fun json_string(s :: String) :: String:
  "\"" ++ s.replace("\\", "\\\\", ~all: #true).replace("\"", "\\\"", ~all: #true).replace("\n", "\\n", ~all: #true) ++ "\""
fun type_json(ty) :: String:
  if Kernel.is_vartype(ty)
  | "[\"Tyvar\"," ++ json_string(Kernel.dest_vartype(ty)) ++ "]"
  | let [n, args] = Kernel.dest_type(ty)
    "[\"Tyapp\"," ++ json_string(n) ++ ",[" ++ String.join(for List (a in args): type_json(a), ",") ++ "]]"
fun term_json(tm) :: String:
  cond
  | Kernel.is_var(tm):
      let [n, ty] = Kernel.dest_var(tm)
      "[\"Var\"," ++ json_string(n) ++ "," ++ type_json(ty) ++ "]"
  | Kernel.is_const(tm):
      let [n, ty] = Kernel.dest_const(tm)
      "[\"Const\"," ++ json_string(n) ++ "," ++ type_json(ty) ++ "]"
  | Kernel.is_comb(tm):
      let [f, x] = Kernel.dest_comb(tm)
      "[\"Comb\"," ++ term_json(f) ++ "," ++ term_json(x) ++ "]"
  | ~else:
      let [v, b] = Kernel.dest_abs(tm)
      "[\"Abs\"," ++ term_json(v) ++ "," ++ term_json(b) ++ "]"

fun quote_text(site :: String, s :: String):
  let body = s.trim(~end: #false)
  if body.length() > 0 && body[0] == Char":"
  | Parser.parse_type(body.substring(1, body.length()))
  | let tm = Parser.parse_term(s)
    when quote_check
    | println("HOLCHECK\t" ++ site ++ "\t" ++ term_json(tm))
    tm

// ---------------------------------------------------------------------
// Spaces for HOL types and terms.

space.enforest hol_type_space:
  space_path rhombus_hol/hol_type
  macro_definer type_macro
  meta_namespace hol_type_meta:
    description "HOL type"
    parse_syntax_class Parsed
    parse_prefix_more_syntax_class AfterPrefixParsed
    parse_infix_more_syntax_class AfterInfixParsed
    export:
      pack
      unpack
    private parsed_packer do_pack
    private parsed_unpacker do_unpack
    fun pack(s :: Syntax) :: Syntax: do_pack(s)
    fun unpack(stx) :: Syntax: do_unpack(stx, #false)
    identifier_parser: fun (id): pack('["name", $id]')

space.enforest hol_term_space:
  space_path rhombus_hol/hol_term
  macro_definer term_macro
  meta_namespace hol_term_meta:
    description "HOL term"
    parse_syntax_class Parsed
    parse_prefix_more_syntax_class AfterPrefixParsed
    parse_infix_more_syntax_class AfterInfixParsed
    export:
      pack
      unpack
    private parsed_packer do_pack
    private parsed_unpacker do_unpack
    fun pack(s :: Syntax) :: Syntax: do_pack(s)
    fun unpack(stx) :: Syntax: do_unpack(stx, #false)
    identifier_parser: fun (id): pack('["ref", $id]')

// Types: names, constructor application, ->, grouping and the type 1.
hol_type_space.type_macro '$left #%call ($(arg :: hol_type_meta.Parsed), ...)':
  ~stronger_than: ~other
  ~associativity: ~left
  hol_type_meta.pack('["apply", $left, [$arg, ...]]')
hol_type_space.type_macro '#%parens ($(t :: hol_type_meta.Parsed))':
  t
hol_type_space.type_macro '#%literal $(n :: Term)':
  hol_type_meta.pack('["literal", $n]')
hol_type_space.type_macro '$left -> $right':
  ~weaker_than: ~other
  ~associativity: ~right
  hol_type_meta.pack('["fun", $left, $right]')

// Terms.
operator_order.def hol_implication:
  ~associativity: ~right
  ~weaker_than:
    arithmetic
    comparison
    logical_negation
    logical_conjunction
    logical_disjunction
operator_order.def hol_equivalence:
  ~associativity: ~none
  ~weaker_than:
    arithmetic
    comparison
    logical_negation
    logical_conjunction
    logical_disjunction
    hol_implication

hol_term_space.term_macro '$left #%call ($(arg :: hol_term_meta.Parsed), ...)':
  ~stronger_than: ~other
  ~associativity: ~left
  hol_term_meta.pack('["app", $left, [$arg, ...]]')
hol_term_space.term_macro
| '#%parens ($(lit :: Term) :: $ty ...)':
    ~all_stx: stx
    let '$(t :: hol_type_meta.Parsed)' = '$ty ...'
    if Rkt.#{exact-nonnegative-integer?}(lit.unwrap())
    | hol_term_meta.pack('["numeral", $lit, $t]')
    | unless lit.unwrap() is_a Symbol
      | syntax_meta.error("expected a numeral or a constant name before `::`", stx)
      hol_term_meta.pack('["typed", $lit, $t]')
| '#%parens (- $(lit :: Term) :: $_ ...)':
    ~all_stx: stx
    syntax_meta.error("negative numerals have no literal form; negate a typed numeral instead", stx)
| '#%parens ($(e :: hol_term_meta.Parsed))':
    e
hol_term_space.term_macro '#%literal $(v :: Term)':
  ~all_stx: stx
  match v.unwrap()
  | b :: Boolean: hol_term_meta.pack('["truth", $v]')
  | n :: Int: syntax_meta.error("a numeral needs a type, as in (" +& n +& " :: num)", stx)
  | _: syntax_meta.error("not a HOL term literal", stx)

hol_term_space.term_macro '$left && $right':
  ~order: logical_conjunction
  hol_term_meta.pack('["op2", "&&", $left, $right]')
hol_term_space.term_macro '$left || $right':
  ~order: logical_disjunction
  hol_term_meta.pack('["op2", "||", $left, $right]')
hol_term_space.term_macro
| '==>':
    ~all_stx: stx
    hol_term_meta.pack('["ref", $stx]')
| '$left ==> $right':
    ~order: hol_implication
    hol_term_meta.pack('["op2", "==>", $left, $right]')
hol_term_space.term_macro '$left <=> $right':
  ~order: hol_equivalence
  hol_term_meta.pack('["op2", "<=>", $left, $right]')
hol_term_space.term_macro
| '==':
    ~all_stx: stx
    hol_term_meta.pack('["ref", $stx]')
| '$left == $right':
    ~order: equivalence
    hol_term_meta.pack('["op2", "==", $left, $right]')
hol_term_space.term_macro '$left != $right':
  ~order: equivalence
  hol_term_meta.pack('["op2", "!=", $left, $right]')
hol_term_space.term_macro '! $right':
  ~order: logical_negation
  hol_term_meta.pack('["op1", "!", $right]')
hol_term_space.term_macro
| '+':
    ~all_stx: stx
    hol_term_meta.pack('["ref", $stx]')
| '$left + $right':
    ~order: addition
    hol_term_meta.pack('["op2", "+", $left, $right]')
hol_term_space.term_macro
| '- $right':
    ~order: multiplication
    hol_term_meta.pack('["op1", "-", $right]')
| '$left - $right':
    ~order: addition
    hol_term_meta.pack('["op2", "-", $left, $right]')
hol_term_space.term_macro
| '*':
    ~all_stx: stx
    hol_term_meta.pack('["ref", $stx]')
| '$left * $right':
    ~order: multiplication
    hol_term_meta.pack('["op2", "*", $left, $right]')
hol_term_space.term_macro
| '/':
    ~all_stx: stx
    hol_term_meta.pack('["ref", $stx]')
| '$left / $right':
    ~order: multiplication
    hol_term_meta.pack('["op2", "/", $left, $right]')
hol_term_space.term_macro
| '<':
    ~all_stx: stx
    hol_term_meta.pack('["ref", $stx]')
| '$left < $right':
    ~order: order_comparison
    hol_term_meta.pack('["op2", "<", $left, $right]')
hol_term_space.term_macro
| '<=':
    ~all_stx: stx
    hol_term_meta.pack('["ref", $stx]')
| '$left <= $right':
    ~order: order_comparison
    hol_term_meta.pack('["op2", "<=", $left, $right]')
hol_term_space.term_macro
| '>':
    ~all_stx: stx
    hol_term_meta.pack('["ref", $stx]')
| '$left > $right':
    ~order: order_comparison
    hol_term_meta.pack('["op2", ">", $left, $right]')
hol_term_space.term_macro
| '>=':
    ~all_stx: stx
    hol_term_meta.pack('["ref", $stx]')
| '$left >= $right':
    ~order: order_comparison
    hol_term_meta.pack('["op2", ">=", $left, $right]')

meta:
  fun parse_binding(g :: Syntax) :: Syntax:
    match g
    | '$(id :: Identifier) :: $ty ...':
        let '$(t :: hol_type_meta.Parsed)' = '$ty ...'
        '[$id, $t]'
    | _: syntax_meta.error("expected `name :: type` in a binder", g)

hol_term_space.term_macro
| 'forall ($b, ...): $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "forall", [$(parse_binding(b)), ...], $body]')
| 'forall $b ...: $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "forall", [$(parse_binding('$b ...'))], $body]')
hol_term_space.term_macro
| 'exists ($b, ...): $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "exists", [$(parse_binding(b)), ...], $body]')
| 'exists $b ...: $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "exists", [$(parse_binding('$b ...'))], $body]')
hol_term_space.term_macro
| 'exists1 ($b, ...): $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "exists1", [$(parse_binding(b)), ...], $body]')
| 'exists1 $b ...: $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "exists1", [$(parse_binding('$b ...'))], $body]')
hol_term_space.term_macro 'fun ($b, ...): $(body :: hol_term_meta.Parsed)':
  hol_term_meta.pack('["binder", "fun", [$(parse_binding(b)), ...], $body]')
hol_term_space.term_macro 'if $tst ... | $(thn :: hol_term_meta.Parsed) | $(els :: hol_term_meta.Parsed)':
  let '$(c :: hol_term_meta.Parsed)' = '$tst ...'
  hol_term_meta.pack('["if", $c, $thn, $els]')

// ---------------------------------------------------------------------
// Elaboration: names, types and the typed quoted AST.

meta:
  // Types are ["V", name] and ["T", name, [arg, ...]].
  def bool_ty = ["T", "bool", []]
  fun fun_ty(a, b): ["T", "fun", [a, b]]
  fun show_type(ty) :: String:
    match ty
    | ["V", n]: n
    | ["T", "fun", [a, b]]:
        let left = match a | ["T", "fun", _]: "(" ++ show_type(a) ++ ")" | _: show_type(a)
        left ++ " -> " ++ show_type(b)
    | ["T", n, []]: n
    | ["T", n, args]: n ++ "(" ++ String.join(for List (a in args): show_type(a), ", ") ++ ")"
  // Surface type constructors whose kernel name differs.
  def surface_tycons = { "pair": "prod" }
  def builtin_arity = { "bool": 0, "num": 0, "int": 0, "real": 0, "fun": 2,
                        "list": 1, "prod": 2 }
  fun is_tyvar_name(s :: String):
    s.length() > 0 && (Char.is_uppercase(s[0]) || s[0] == #{#\?})
  fun elab_type(stx) :~ List:
    match hol_type_meta.unpack(stx)
    | '["name", $id]':
        let s = to_string(id.unwrap())
        if is_tyvar_name(s)
        | ["V", s]
        | let k = surface_tycons.get(s, s)
          match builtin_arity.get(k, #false)
          | n :: Int when n != 0:
              syntax_meta.error("type constructor `" ++ s ++ "` expects " +& n +& " argument(s)", id)
          | _: ["T", k, []]
    | '["literal", $n]':
        if n.unwrap() == 1
        | ["T", "1", []]
        | syntax_meta.error("not a HOL type", n)
    | '["fun", $a, $b]': fun_ty(elab_type(a), elab_type(b))
    | '["apply", $f, [$arg, ...]]':
        let args = [elab_type(arg), ...]
        match hol_type_meta.unpack(f)
        | '["name", $id]':
            let s = to_string(id.unwrap())
            when is_tyvar_name(s)
            | syntax_meta.error("a type variable cannot be applied", id)
            let k = surface_tycons.get(s, s)
            match builtin_arity.get(k, #false)
            | n :: Int when n != args.length():
                syntax_meta.error("type constructor `" ++ s ++ "` expects " +& n +& " argument(s)", id)
            | _: ["T", k, args]
        | _: syntax_meta.error("expected a type constructor name", f)

  fun json_str(s :: String) :: String:
    "\"" ++ s.replace("\\", "\\\\", ~all: #true).replace("\"", "\\\"", ~all: #true).replace("\n", "\\n", ~all: #true) ++ "\""
  fun json_type(ty) :: String:
    match ty
    | ["V", n]: "[\"Tyvar\"," ++ json_str(n) ++ "]"
    | ["T", n, args]: "[\"Tyapp\"," ++ json_str(n) ++ ",[" ++ String.join(for List (a in args): json_type(a), ",") ++ "]]"
  // Typed quoted AST: ["var", name, type], ["const", name, type],
  // ["app", f, x] and ["abs", v, body].
  fun var_node(n, ty): ["var", n, ty]
  fun const_node(n, ty): ["const", n, ty]
  fun comb_node(f, x): ["app", f, x]
  fun abs_node(v, b): ["abs", v, b]

  // The same AST as JSON, for HOL_QUOTE_DUMP.
  fun node_json(node) :: String:
    match node
    | ["var", n, ty]: "[\"Var\"," ++ json_str(n) ++ "," ++ json_type(ty) ++ "]"
    | ["const", n, ty]: "[\"Const\"," ++ json_str(n) ++ "," ++ json_type(ty) ++ "]"
    | ["app", f, x]: "[\"Comb\"," ++ node_json(f) ++ "," ++ node_json(x) ++ "]"
    | ["abs", v, b]: "[\"Abs\"," ++ node_json(v) ++ "," ++ node_json(b) ++ "]"

  // Constant data for build_type / build_term.
  fun type_data(ty):
    match ty
    | ["V", n]: PairList["V", n]
    | ["T", n, args]: PairList["T", n, PairList[& (for List (a in args): type_data(a))]]
  fun term_data(node):
    match node
    | ["var", n, ty]: PairList["v", n, type_data(ty)]
    | ["const", n, ty]: PairList["c", n, type_data(ty)]
    | ["app", f, x]: PairList["a", term_data(f), term_data(x)]
    | ["abs", v, b]: PairList["l", term_data(v), term_data(b)]
  fun constant(data): expr_meta.pack_s_exp(['quote', Rkt.#{datum->syntax}(#false, data)])
  def '$(build_term_ref :: expr_meta.Parsed)' = 'build_term'
  def '$(build_type_ref :: expr_meta.Parsed)' = 'build_type'
  fun term_expression(node) :: Syntax:
    expr_meta.pack_s_exp([build_term_ref, constant(term_data(node))])
  fun type_expression(ty) :: Syntax:
    expr_meta.pack_s_exp([build_type_ref, constant(type_data(ty))])

  // Environment entries: [kind, hol_name, type] keyed by surface symbol.
  fun hol_name(id :: Syntax) :: String: to_string(id.unwrap())

  fun expect(ty, want, stx, what):
    unless ty == want
    | syntax_meta.error(what ++ ": expected type " ++ show_type(want) ++ ", found " ++ show_type(ty), stx)

  fun numeral_node(n :: Int):
    fun bits(n):
      cond
      | n == 0: const_node("_0", ["T", "num", []])
      | n rem 2 == 0: comb_node(const_node("BIT0", fun_ty(["T", "num", []], ["T", "num", []])), bits(n div 2))
      | ~else: comb_node(const_node("BIT1", fun_ty(["T", "num", []], ["T", "num", []])), bits(n div 2))
    comb_node(const_node("NUMERAL", fun_ty(["T", "num", []], ["T", "num", []])), bits(n))

  // Operator constants by operand type.
  def arithmetic_ops:
    { ["+", "num"]: "+", ["-", "num"]: "-", ["*", "num"]: "*",
      ["<", "num"]: "<", ["<=", "num"]: "<=", [">", "num"]: ">", [">=", "num"]: ">=",
      ["+", "int"]: "int_add", ["-", "int"]: "int_sub", ["*", "int"]: "int_mul",
      ["<", "int"]: "int_lt", ["<=", "int"]: "int_le", [">", "int"]: "int_gt", [">=", "int"]: "int_ge",
      ["+", "real"]: "real_add", ["-", "real"]: "real_sub", ["*", "real"]: "real_mul", ["/", "real"]: "real_div",
      ["<", "real"]: "real_lt", ["<=", "real"]: "real_le", [">", "real"]: "real_gt", [">=", "real"]: "real_ge" }
  def negation_ops = { "int": "int_neg", "real": "real_neg" }
  def numeral_injections = { "int": "int_of_num", "real": "real_of_num" }

  fun elab(stx, env :~ Map) :~ List:
    match hol_term_meta.unpack(stx)
    | '["ref", $id]':
        match env.get(id.unwrap(), #false)
        | [kind, name, ty]:
            [if kind == "var" | var_node(name, ty) | const_node(name, ty), ty]
        | _: syntax_meta.error("unbound HOL name; declare it with `var` or `const`", id)
    | '["typed", $name, $t]':
        let ty = elab_type(t)
        let n = to_string(name.unwrap())
        match env.get(name.unwrap(), #false)
        | ["var", _, _]: [var_node(n, ty), ty]
        | _: [const_node(n, ty), ty]
    | '["truth", $v]':
        [const_node(if v.unwrap() | "T" | "F", bool_ty), bool_ty]
    | '["numeral", $lit, $t]':
        let ty = elab_type(t)
        let n = numeral_node(lit.unwrap())
        match ty
        | ["T", "num", []]: [n, ty]
        | ["T", k, []] when numeral_injections.has_key(k):
            [comb_node(const_node(numeral_injections[k], fun_ty(["T", "num", []], ty)), n), ty]
        | _: syntax_meta.error("a numeral needs type num, int or real, not " ++ show_type(ty), stx)
    | '["app", $f, [$arg, ...]]':
        for values(acc = elab(f, env)) (a in [arg, ...]):
          let [fj, fty] = acc
          match fty
          | ["T", "fun", [dom, cod]]:
              let [aj, aty] = elab(a, env)
              expect(aty, dom, a, "argument")
              [comb_node(fj, aj), cod]
          | _: syntax_meta.error("applied term has type " ++ show_type(fty) ++ ", not a function type", f)
    | '["op1", "!", $x]':
        let [xj, xty] = elab(x, env)
        expect(xty, bool_ty, x, "operand of !")
        [comb_node(const_node("~", fun_ty(bool_ty, bool_ty)), xj), bool_ty]
    | '["op1", "-", $x]':
        let [xj, xty] = elab(x, env)
        match xty
        | ["T", k, []] when negation_ops.has_key(k):
            [comb_node(const_node(negation_ops[k], fun_ty(xty, xty)), xj), xty]
        | _: syntax_meta.error("unary - is not defined at type " ++ show_type(xty), stx)
    | '["op2", $op, $l, $r]':
        let o = op.unwrap()
        let [lj, lty] = elab(l, env)
        let [rj, rty] = elab(r, env)
        fun binop(name, ty, res):
          [comb_node(comb_node(const_node(name, fun_ty(ty, fun_ty(ty, res))), lj), rj), res]
        match o
        | "&&" || "||" || "==>" || "<=>":
            expect(lty, bool_ty, l, "operand of " ++ o)
            expect(rty, bool_ty, r, "operand of " ++ o)
            binop({ "&&": "/\\", "||": "\\/", "==>": "==>", "<=>": "=" }[o], bool_ty, bool_ty)
        | "==":
            expect(rty, lty, r, "right side of ==")
            binop("=", lty, bool_ty)
        | "!=":
            expect(rty, lty, r, "right side of !=")
            let [eq, _] = binop("=", lty, bool_ty)
            [comb_node(const_node("~", fun_ty(bool_ty, bool_ty)), eq), bool_ty]
        | _:
            expect(rty, lty, r, "right operand of " ++ o)
            let k = match lty | ["T", k, []]: k | _: ""
            match arithmetic_ops.get([o, k], #false)
            | #false: syntax_meta.error(o ++ " is not defined at type " ++ show_type(lty), stx)
            | name:
                let res = if o == "<" || o == "<=" || o == ">" || o == ">=" | bool_ty | lty
                binop(name, lty, res)
    | '["binder", $kind, [[$id, $t], ...], $body]':
        let k = kind.unwrap()
        let vars:
          for List (i in [id, ...], ty in [t, ...]):
            [i, hol_name(i), elab_type(ty)]
        let body_env:
          for values(e :~ Map = env) ([i, name, ty] in vars):
            e ++ { i.unwrap(): ["var", name, ty] }
        let [bj, bty] = elab(body, body_env)
        unless k == "fun"
        | expect(bty, bool_ty, body, "body of " ++ k)
        let binder = { "forall": "!", "exists": "?", "exists1": "?!" }
        for values(acc = [bj, bty]) ([_, name, ty] in vars.reverse()):
          let [j, jty] = acc
          let abs = abs_node(var_node(name, ty), j)
          let aty = fun_ty(ty, jty)
          if k == "fun"
          | [abs, aty]
          | [comb_node(const_node(binder[k], fun_ty(aty, bool_ty)), abs), bool_ty]
    | '["if", $c, $t, $e]':
        let [cj, cty] = elab(c, env)
        expect(cty, bool_ty, c, "condition of if")
        let [tj, tty] = elab(t, env)
        let [ej, ety] = elab(e, env)
        expect(ety, tty, e, "else branch")
        let cond_ty = fun_ty(bool_ty, fun_ty(tty, fun_ty(tty, tty)))
        [comb_node(comb_node(comb_node(const_node("COND", cond_ty), cj), tj), ej), tty]

  fun parse_declaration(g :: Syntax) :~ maybe(List):
    fun decl(kind, id, ty):
      let '$(t :: hol_type_meta.Parsed)' = ty
      [kind, id, elab_type(t)]
    match g
    | 'var $(id :: Identifier) :: $ty ...': decl("var", id, '$ty ...')
    | 'const $(id :: Identifier) :: $ty ...': decl("const", id, '$ty ...')
    | 'var $_ ...': syntax_meta.error("expected `var name :: type`", g)
    | 'const $_ ...': syntax_meta.error("expected `const name :: type`", g)
    | _: #false

// `hol:` quotation of a term, and `@hol|{...}|` quotation of HOL Light text.
expr.macro
| 'hol: $(g :: Group); ...':
    ~all_stx: stx
    let groups = [g, ...]
    when groups == []
    | syntax_meta.error("a hol: block needs a body expression", stx)
    let decls = for List (d in groups.take(groups.length() - 1)):
      match parse_declaration(d)
      | #false: syntax_meta.error("declarations must come first and be followed by exactly one expression", d)
      | decl: decl
    let body = groups[groups.length() - 1]
    when parse_declaration(body)
    | syntax_meta.error("a hol: block needs a body expression after its declarations", stx)
    let env:
      for values(e :~ Map = {}) ([kind, id, ty] in decls):
        when e.has_key(id.unwrap())
        | syntax_meta.error("duplicate declaration", id)
        e ++ { id.unwrap(): [kind, hol_name(id), ty] }
    let '$(parsed :: hol_term_meta.Parsed)' = body
    let [j, _] = elab(parsed, env)
    // Migration aid: HOL_QUOTE_DUMP=1 prints every expansion for comparison.
    when Rkt.#{getenv}("HOL_QUOTE_DUMP")
    | println("HOLDUMP\t" ++ to_string(stx.srcloc()) ++ "\t" ++ node_json(j))
    term_expression(j)
| 'hol ([$(piece :: String), ...])':
    ~all_stx: stx
    let text = String.append(piece.unwrap(), ...)
    'quote_text($(to_string(stx.srcloc())), $text)'

// `hol_type:` quotation of a type.
expr.macro 'hol_type: $(t :: hol_type_meta.Parsed)':
  type_expression(elab_type(t))

export:
  hol
  hol_type
  meta:
    hol_term_meta
    hol_type_meta
  // Forms and operators inside `hol:` and type positions.
  only_space hol_term_space:
    && || ==> <=> == != ! + - * / < <= > >=
    forall exists exists1 fun if
    names:
      #%literal #%parens #%call
  only_space hol_type_space:
    ->
    names:
      #%literal #%parens #%call
