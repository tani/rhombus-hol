#lang rhombus/and_meta
// `@hol|{...}|` — HOL Light quotations.
//
// The text between `@hol|{` and `}|` is HOL Light's own quotation syntax.
// As HOL Light's quotation expander does for `` `...` ``, a quotation whose
// text starts with `:` is read by parse_type and any other by parse_term
// (../parser.rhm), at run time, against the binder, prefix, infix, overload
// and type tables of the theories loaded at that moment. The raw text form
// keeps backslashes and braces literal; `|@` is the only escape.
//
// HOL_QUOTE_CHECK=1 prints every elaborated term as a HOLCHECK line (site,
// then the term as JSON: ["Var", name, type], ["Const", name, type],
// ["Comb", f, x], ["Abs", v, body]; types ["Tyvar", name] and
// ["Tyapp", name, [args]]).
import:
  "../fusion.rhm" as Kernel
  "../parser.rhm" as Parser
  lib("racket/base.rkt"):
    expose: getenv

export:
  hol
  term_json
  type_json

def quote_check = getenv("HOL_QUOTE_CHECK")

fun json_string(s :: String) :: String:
  "\"" ++ s.replace("\\", "\\\\", ~all: #true).replace("\"", "\\\"", ~all: #true).replace("\n", "\\n", ~all: #true) ++ "\""

fun type_json(ty) :: String:
  if Kernel.is_vartype(ty)
  | "[\"Tyvar\"," ++ json_string(Kernel.dest_vartype(ty)) ++ "]"
  | let [n, args] = Kernel.dest_type(ty)
    "[\"Tyapp\"," ++ json_string(n) ++ ",[" ++ String.join(for List (a in args): type_json(a), ",") ++ "]]"

fun term_json(tm) :: String:
  cond
  | Kernel.is_var(tm):
      let [n, ty] = Kernel.dest_var(tm)
      "[\"Var\"," ++ json_string(n) ++ "," ++ type_json(ty) ++ "]"
  | Kernel.is_const(tm):
      let [n, ty] = Kernel.dest_const(tm)
      "[\"Const\"," ++ json_string(n) ++ "," ++ type_json(ty) ++ "]"
  | Kernel.is_comb(tm):
      let [f, x] = Kernel.dest_comb(tm)
      "[\"Comb\"," ++ term_json(f) ++ "," ++ term_json(x) ++ "]"
  | ~else:
      let [v, b] = Kernel.dest_abs(tm)
      "[\"Abs\"," ++ term_json(v) ++ "," ++ term_json(b) ++ "]"

fun quote_text(site :: String, s :: String):
  let body = s.trim(~end: #false)
  if body.length() > 0 && body[0] == Char":"
  | Parser.parse_type(body.substring(1, body.length()))
  | let tm = Parser.parse_term(s)
    when quote_check
    | println("HOLCHECK\t" ++ site ++ "\t" ++ term_json(tm))
    tm

// `@hol|{text}|` reads as `hol(["text", ...])`.
expr.macro 'hol ([$(piece :: String), ...])':
  ~all_stx: stx
  let text = String.append(piece.unwrap(), ...)
  'quote_text($(to_string(stx.srcloc())), $text)'
