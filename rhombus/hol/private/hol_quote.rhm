#lang rhombus/and_meta
// `hol:` — Rhombus-native HOL term quotation.
//
// A `hol:` block declares free variables and typed constant schemes,
// then ends in one HOL expression. Expressions and types are parsed
// in their own spaces with Rhombus enforestation (operators keep their
// native order and associativity), then elaborated at expansion time:
// names resolve to declarations or the innermost binder, and every
// application, operator and branch contributes first-order type constraints.
// Variables can omit types; declared constant schemes are freshly instantiated
// at each occurrence. There are no implicit coercions. The result is a
// sequence of direct calls to public kernel term/type constructors; no theorem is produced.
//
// Constants use one declared type scheme, even when used at several types.
// Ordinary references resolve from declarations and lexical binders; escaped
// identifiers name symbolic terms directly. Prefer distinct binder names.
// Optional `const.name` and `var.name` select declarations beneath a shadowing
// binder, or bypass a term macro with the same name (such as `const.#{+}`).
// A declaration alias remains available for names such as a newline.
import:
  "ocaml.rhm" open
  "../fusion.rhm" as Kernel
  "../basics.rhm" as Basics
  meta:
    lib("racket/base.rkt") as Rkt:
      only:
        #{exact-nonnegative-integer?}
// ---------------------------------------------------------------------
// Spaces for HOL types and terms.

space.enforest hol_type_space:
  space_path rhombus_hol/hol_type
  macro_definer type_macro
  meta_namespace hol_type_meta:
    description "HOL type"
    parse_syntax_class Parsed
    parse_prefix_more_syntax_class AfterPrefixParsed
    parse_infix_more_syntax_class AfterInfixParsed
    export:
      pack
      unpack
    private parsed_packer do_pack
    private parsed_unpacker do_unpack
    fun pack(s :: Syntax) :: Syntax: do_pack(s)
    fun unpack(stx) :: Syntax: do_unpack(stx, #false)
    identifier_parser: fun (id): pack('["name", $id]')

space.enforest hol_term_space:
  space_path rhombus_hol/hol_term
  macro_definer term_macro
  meta_namespace hol_term_meta:
    description "HOL term"
    parse_syntax_class Parsed
    parse_prefix_more_syntax_class AfterPrefixParsed
    parse_infix_more_syntax_class AfterInfixParsed
    export:
      pack
      unpack
    private parsed_packer do_pack
    private parsed_unpacker do_unpack
    fun pack(s :: Syntax) :: Syntax: do_pack(s)
    fun unpack(stx) :: Syntax: do_unpack(stx, #false)
    identifier_parser: fun (id): pack('["ref", $id]')

// Types: names, constructor application, ->, grouping and the type 1.
hol_type_space.type_macro '$left #%call ($(arg :: hol_type_meta.Parsed), ...)':
  ~stronger_than: ~other
  ~associativity: ~left
  hol_type_meta.pack('["apply", $left, [$arg, ...]]')
hol_type_space.type_macro '#%parens ($(t :: hol_type_meta.Parsed))':
  t
hol_type_space.type_macro '#%literal $(n :: Term)':
  hol_type_meta.pack('["literal", $n]')
hol_type_space.type_macro '$left -> $right':
  ~weaker_than: ~other
  ~associativity: ~right
  hol_type_meta.pack('["fun", $left, $right]')

// Terms.
operator_order.def hol_implication:
  ~associativity: ~right
  ~weaker_than:
    arithmetic
    comparison
    logical_negation
    logical_conjunction
    logical_disjunction
operator_order.def hol_equivalence:
  ~associativity: ~none
  ~weaker_than:
    arithmetic
    comparison
    logical_negation
    logical_conjunction
    logical_disjunction
    hol_implication

hol_term_space.term_macro '$left #%call ($(arg :: hol_term_meta.Parsed), ...)':
  ~stronger_than: ~other
  ~associativity: ~left
  hol_term_meta.pack('["app", $left, [$arg, ...]]')
hol_term_space.term_macro 'const . $(id :: Identifier)':
  hol_term_meta.pack('["declared", "const", $id]')
hol_term_space.term_macro 'var . $(id :: Identifier)':
  hol_term_meta.pack('["declared", "var", $id]')
hol_term_space.term_macro '$left :: $ty ...':
  ~weaker_than: ~other
  let '$(t :: hol_type_meta.Parsed)' = '$ty ...'
  hol_term_meta.pack('["annotation", $left, $t]')
hol_term_space.term_macro
| '#%parens ($(lit :: Term) :: $ty ...)':
    ~all_stx: stx
    let '$(t :: hol_type_meta.Parsed)' = '$ty ...'
    if Rkt.#{exact-nonnegative-integer?}(lit.unwrap())
    | hol_term_meta.pack('["numeral", $lit, $t]')
    | let '$(e :: hol_term_meta.Parsed)' = '$lit'
      hol_term_meta.pack('["annotation", $e, $t]')
| '#%parens (- $(lit :: Term) :: $_ ...)':
    ~all_stx: stx
    syntax_meta.error("negative numerals have no literal form; negate a typed numeral instead", stx)
| '#%parens ($(e :: hol_term_meta.Parsed))':
    e
hol_term_space.term_macro '#%literal $(v :: Term)':
  ~all_stx: stx
  match v.unwrap()
  | b :: Boolean: hol_term_meta.pack('["truth", $v]')
  | n :: Int: syntax_meta.error("a numeral needs a type, as in (" +& n +& " :: num)", stx)
  | _: syntax_meta.error("not a HOL term literal", stx)

hol_term_space.term_macro '$left && $right':
  ~order: logical_conjunction
  hol_term_meta.pack('["op2", "&&", $left, $right]')
hol_term_space.term_macro '$left || $right':
  ~order: logical_disjunction
  hol_term_meta.pack('["op2", "||", $left, $right]')
hol_term_space.term_macro '$left ==> $right':
  ~order: hol_implication
  hol_term_meta.pack('["op2", "==>", $left, $right]')
hol_term_space.term_macro '$left <=> $right':
  ~order: hol_equivalence
  hol_term_meta.pack('["op2", "<=>", $left, $right]')
hol_term_space.term_macro '$left == $right':
  ~order: equivalence
  hol_term_meta.pack('["op2", "==", $left, $right]')
hol_term_space.term_macro '$left != $right':
  ~order: equivalence
  hol_term_meta.pack('["op2", "!=", $left, $right]')
hol_term_space.term_macro '! $right':
  ~order: logical_negation
  hol_term_meta.pack('["op1", "!", $right]')
hol_term_space.term_macro '$left + $right':
  ~order: addition
  hol_term_meta.pack('["op2", "+", $left, $right]')
hol_term_space.term_macro
| '- $right':
    ~order: multiplication
    hol_term_meta.pack('["op1", "-", $right]')
| '$left - $right':
    ~order: addition
    hol_term_meta.pack('["op2", "-", $left, $right]')
hol_term_space.term_macro '$left * $right':
  ~order: multiplication
  hol_term_meta.pack('["op2", "*", $left, $right]')
hol_term_space.term_macro '$left / $right':
  ~order: multiplication
  hol_term_meta.pack('["op2", "/", $left, $right]')
hol_term_space.term_macro '$left < $right':
  ~order: order_comparison
  hol_term_meta.pack('["op2", "<", $left, $right]')
hol_term_space.term_macro '$left <= $right':
  ~order: order_comparison
  hol_term_meta.pack('["op2", "<=", $left, $right]')
hol_term_space.term_macro '$left > $right':
  ~order: order_comparison
  hol_term_meta.pack('["op2", ">", $left, $right]')
hol_term_space.term_macro '$left >= $right':
  ~order: order_comparison
  hol_term_meta.pack('["op2", ">=", $left, $right]')

meta:
  fun parse_binding(g :: Syntax) :: Syntax:
    match g
    | '$(id :: Identifier) :: $ty ...':
        let '$(t :: hol_type_meta.Parsed)' = '$ty ...'
        '[$id, $t]'
    | '$(id :: Identifier)': '[$id, #false]'
    | _: syntax_meta.error("expected `name` or `name :: type` in a binder", g)

hol_term_space.term_macro
| 'forall ($b, ...): $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "forall", [$(parse_binding(b)), ...], $body]')
| 'forall $b ...: $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "forall", [$(parse_binding('$b ...'))], $body]')
hol_term_space.term_macro
| 'exists ($b, ...): $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "exists", [$(parse_binding(b)), ...], $body]')
| 'exists $b ...: $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "exists", [$(parse_binding('$b ...'))], $body]')
hol_term_space.term_macro
| 'exists1 ($b, ...): $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "exists1", [$(parse_binding(b)), ...], $body]')
| 'exists1 $b ...: $(body :: hol_term_meta.Parsed)':
    hol_term_meta.pack('["binder", "exists1", [$(parse_binding('$b ...'))], $body]')
hol_term_space.term_macro 'fun ($b, ...): $(body :: hol_term_meta.Parsed)':
  hol_term_meta.pack('["binder", "fun", [$(parse_binding(b)), ...], $body]')
hol_term_space.term_macro 'if $tst ... | $(thn :: hol_term_meta.Parsed) | $(els :: hol_term_meta.Parsed)':
  let '$(c :: hol_term_meta.Parsed)' = '$tst ...'
  hol_term_meta.pack('["if", $c, $thn, $els]')

// ---------------------------------------------------------------------
// Elaboration: names, types and the typed quoted AST.

meta:
  // Types are ["V", name] and ["T", name, [arg, ...]].
  def bool_ty = ["T", "bool", []]
  fun fun_ty(a, b): ["T", "fun", [a, b]]
  fun show_type(ty) :: String:
    match ty
    | ["M", _, label]: "?" ++ label
    | ["V", n]: n
    | ["T", "fun", [a, b]]:
        let left = match a | ["T", "fun", _]: "(" ++ show_type(a) ++ ")" | _: show_type(a)
        left ++ " -> " ++ show_type(b)
    | ["T", n, []]: n
    | ["T", n, args]: n ++ "(" ++ String.join(for List (a in args): show_type(a), ", ") ++ ")"
  // Surface type constructors whose kernel name differs.
  def surface_tycons = { "pair": "prod" }
  def builtin_arity = { "bool": 0, "num": 0, "int": 0, "real": 0, "fun": 2,
                        "list": 1, "prod": 2 }
  fun is_tyvar_name(s :: String):
    s.length() > 0 && (Char.is_uppercase(s[0]) || s[0] == #{#\?})
  fun elab_type(stx) :~ List:
    match hol_type_meta.unpack(stx)
    | '["name", $id]':
        let s = to_string(id.unwrap())
        if is_tyvar_name(s)
        | ["V", s]
        | let k = surface_tycons.get(s, s)
          match builtin_arity.get(k, #false)
          | n :: Int when n != 0:
              syntax_meta.error("type constructor `" ++ s ++ "` expects " +& n +& " argument(s)", id)
          | _: ["T", k, []]
    | '["literal", $n]':
        if n.unwrap() == 1
        | ["T", "1", []]
        | syntax_meta.error("not a HOL type", n)
    | '["fun", $a, $b]': fun_ty(elab_type(a), elab_type(b))
    | '["apply", $f, [$arg, ...]]':
        let args = [elab_type(arg), ...]
        match hol_type_meta.unpack(f)
        | '["name", $id]':
            let s = to_string(id.unwrap())
            when is_tyvar_name(s)
            | syntax_meta.error("a type variable cannot be applied", id)
            let k = surface_tycons.get(s, s)
            match builtin_arity.get(k, #false)
            | n :: Int when n != args.length():
                syntax_meta.error("type constructor `" ++ s ++ "` expects " +& n +& " argument(s)", id)
            | _: ["T", k, args]
        | _: syntax_meta.error("expected a type constructor name", f)

  // A context belongs to one quotation; inference never reads runtime
  // theories or mutates kernel state. Its substitutions are occurs-checked.
  fun inference_context(): [Box({}), Box(0), Box({}), Box({}), Box({}), Box({})]
  // Kernel variable identity includes its name. Give lexical binders names
  // distinct from declared free variables and other binders so `var.x`
  // remains free even beneath a surface binder named x.
  // Only declared variables and enclosing binders are avoided: sibling
  // binders may reuse a name, as in the HOL Light source.
  fun binder_name(base, ctx, env :~ Map):
    let used = ctx[3].value
    fun in_scope(name):
      used.has_key(name) || (for any (entry in env.values()): entry[0] == "var" && entry[1] == name)
    fun choose(n):
      let name = if n == 0 | base | base ++ "_" +& n
      if in_scope(name) | choose(n + 1) | name
    choose(0)
  fun fresh_type(ctx, label):
    let n = ctx[1].value
    ctx[1].value := n + 1
    ["M", n, label]
  fun resolve_type(ty, ctx):
    match ty
    | ["M", n, _]:
        match ctx[0].value.get(n, #false)
        | #false: ty
        | t: resolve_type(t, ctx)
    | _: ty
  fun occurs(n, ty, ctx):
    match resolve_type(ty, ctx)
    | ["M", m, _]: n == m
    | ["T", _, args]: for any (a in args): occurs(n, a, ctx)
    | _: #false
  fun unify_type(left, right, ctx, stx, what):
    let a = resolve_type(left, ctx)
    let b = resolve_type(right, ctx)
    unless a == b
    | match [a, b]
      | [["M", n, _], _]:
          when occurs(n, b, ctx)
          | syntax_meta.error(what ++ ": infinite type", stx)
          ctx[0].value := ctx[0].value ++ {n: b}
      | [_, ["M", _, _]]: unify_type(b, a, ctx, stx, what)
      | [["T", name, args], ["T", other, bs]] when name == other && args.length() == bs.length():
          for (x in args, y in bs): unify_type(x, y, ctx, stx, what)
      | _:
          syntax_meta.error(what ++ ": incompatible types " ++ show_type(a) ++ " and " ++ show_type(b), stx)
  fun instantiate_scheme(ty, ctx):
    let mutable vars :: Map = {}
    fun walk(t):
      match t
      | ["V", n]:
          // A scheme variable named like a rigid variable of the quotation
          // (see `hol:`) denotes that variable, as in the HOL Light source.
          if ctx[5].value.has_key(n)
          | ["V", n]
          | unless vars.has_key(n)
            | vars := vars ++ {n: fresh_type(ctx, n)}
            vars[n]
      | ["T", n, args]: ["T", n, for List (a in args): walk(a)]
    walk(ty)
  fun register_rigid_type(ty, ctx):
    match ty
    | ["V", name]: ctx[2].value := ctx[2].value ++ {name: #true}
    | ["T", _, args]: for (a in args): register_rigid_type(a, ctx)
    | _: #void
  fun final_type(ty, ctx):
    match resolve_type(ty, ctx)
    | ["M", n, label]:
        let used = ctx[2].value
        when label != "" && label != "Inferred"
        | ctx[4].value := ctx[4].value ++ {label: #true}
        let base = if label == "" | "Inferred" | label
        fun choose(n):
          let name = if n == 0 | base | base ++ "_" +& n
          if used.has_key(name) | choose(n + 1) | name
        let name = choose(0)
        ctx[2].value := used ++ {name: #true}
        let t = ["V", name]
        ctx[0].value := ctx[0].value ++ {n: t}
        t
    | ["T", n, args]: ["T", n, for List (a in args): final_type(a, ctx)]
    | t: t

  // Parse constructor references once, then compose already parsed expressions.
  // Re-enforesting every nested constructor/list literal is expensive in the
  // large theory quotations. The generated code still calls the same public
  // constructors directly; these are syntax fragments, not runtime helpers.
  def '$(mk_vartype_ref :: expr_meta.Parsed)' = 'Kernel.mk_vartype'
  def '$(mk_type_ref :: expr_meta.Parsed)' = 'Kernel.mk_type'
  def '$(mk_var_ref :: expr_meta.Parsed)' = 'Kernel.mk_var'
  def '$(mk_mconst_ref :: expr_meta.Parsed)' = 'Basics.mk_mconst'
  def '$(mk_comb_ref :: expr_meta.Parsed)' = 'Kernel.mk_comb'
  def '$(mk_abs_ref :: expr_meta.Parsed)' = 'Kernel.mk_abs'
  def '$(list_ref :: expr_meta.Parsed)' = 'List'
  def '$(pair_list_ref :: expr_meta.Parsed)' = 'PairList'
  fun constructor_call(proc, args): expr_meta.pack_s_exp([proc, & args])
  fun tuple_expression(args): constructor_call(list_ref, args)
  fun name_expression(name): expr_meta.pack_expr(Syntax.make(name, 'ctx'))

  fun type_expression(ty) :: Syntax:
    match ty
    | ["V", n]: constructor_call(mk_vartype_ref, [name_expression(n)])
    | ["T", n, args]:
        let arg = for List (a in args): type_expression(a)
        constructor_call(mk_type_ref, [tuple_expression([name_expression(n), constructor_call(pair_list_ref, arg)])])
  fun variable_expression(n, ty): ["var", n, ty]
  fun constant_expression(n, ty): ["const", n, ty]
  fun application_expression(f, x): ["app", f, x]
  fun abstraction_expression(v, b): ["abs", v, b]

  fun term_expression(node, ctx) :: Syntax:
    match node
    | ["var", n, ty]: constructor_call(mk_var_ref, [tuple_expression([name_expression(n), type_expression(final_type(ty, ctx))])])
    | ["const", n, ty]: constructor_call(mk_mconst_ref, [tuple_expression([name_expression(n), type_expression(final_type(ty, ctx))])])
    | ["app", f, x]: constructor_call(mk_comb_ref, [tuple_expression([term_expression(f, ctx), term_expression(x, ctx)])])
    | ["abs", v, b]: constructor_call(mk_abs_ref, [tuple_expression([term_expression(v, ctx), term_expression(b, ctx)])])
    | ["arithmetic", op, ty, left, right, stx]:
        let t = final_type(ty, ctx)
        let k = match t | ["T", k, []]: k | _: ""
        match arithmetic_ops.get([op, k], #false)
        | #false: syntax_meta.error("ambiguous or unsupported " ++ op ++ "; add a type annotation", stx)
        | name:
            let res = if op == "<" || op == "<=" || op == ">" || op == ">=" | bool_ty | t
            term_expression(application_expression(application_expression(constant_expression(name, fun_ty(t, fun_ty(t, res))), left), right), ctx)
    | ["negation", ty, x, stx]:
        let t = final_type(ty, ctx)
        let k = match t | ["T", k, []]: k | _: ""
        match negation_ops.get(k, #false)
        | #false: syntax_meta.error("ambiguous or unsupported unary -; add a type annotation", stx)
        | name: term_expression(application_expression(constant_expression(name, fun_ty(t, t)), x), ctx)

  // Environment entries: [kind, hol_name, type] keyed by surface symbol.
  fun hol_name(id :: Syntax, alias) :: String:
    match alias
    | #false: to_string(id.unwrap())
    | n: to_string(n.unwrap())

  fun expect(ty, want, stx, what, ctx): unify_type(ty, want, ctx, stx, what)

  fun numeral_expression(n :: Int):
    fun bits(n):
      cond
      | n == 0: constant_expression("_0", ["T", "num", []])
      | n rem 2 == 0: application_expression(constant_expression("BIT0", fun_ty(["T", "num", []], ["T", "num", []])), bits(n div 2))
      | ~else: application_expression(constant_expression("BIT1", fun_ty(["T", "num", []], ["T", "num", []])), bits(n div 2))
    application_expression(constant_expression("NUMERAL", fun_ty(["T", "num", []], ["T", "num", []])), bits(n))

  // Operator constants by operand type.
  def arithmetic_ops:
    { ["+", "num"]: "+", ["-", "num"]: "-", ["*", "num"]: "*",
      ["<", "num"]: "<", ["<=", "num"]: "<=", [">", "num"]: ">", [">=", "num"]: ">=",
      ["+", "int"]: "int_add", ["-", "int"]: "int_sub", ["*", "int"]: "int_mul",
      ["<", "int"]: "int_lt", ["<=", "int"]: "int_le", [">", "int"]: "int_gt", [">=", "int"]: "int_ge",
      ["+", "real"]: "real_add", ["-", "real"]: "real_sub", ["*", "real"]: "real_mul", ["/", "real"]: "real_div",
      ["<", "real"]: "real_lt", ["<=", "real"]: "real_le", [">", "real"]: "real_gt", [">=", "real"]: "real_ge" }
  def negation_ops = { "int": "int_neg", "real": "real_neg" }
  def numeral_injections = { "int": "int_of_num", "real": "real_of_num" }

  fun elab(stx, env :~ Map, ctx) :~ List:
    match hol_term_meta.unpack(stx)
    | '["ref", $id]':
        match env.get(id.unwrap(), #false)
        | [kind, name, ty]:
            let t = if kind == "var" | ty | instantiate_scheme(ty, ctx)
            [if kind == "var" | variable_expression(name, t) | constant_expression(name, t), t]
        | _: syntax_meta.error("unbound HOL name; declare it with `var` or `const`", id)
    | '["declared", $kind, $id]':
        match env.get([kind.unwrap(), id.unwrap()], #false)
        | [k, name, ty]:
            let t = if k == "var" | ty | instantiate_scheme(ty, ctx)
            [if k == "var" | variable_expression(name, t) | constant_expression(name, t), t]
        | _: syntax_meta.error("undeclared qualified HOL name", id)
    | '["truth", $v]':
        [constant_expression(if v.unwrap() | "T" | "F", bool_ty), bool_ty]
    | '["annotation", $e, $t]':
        let ty = elab_type(t)
        register_rigid_type(ty, ctx)
        let [node, inferred] = elab(e, env, ctx)
        expect(inferred, ty, stx, "annotation", ctx)
        [node, ty]
    | '["numeral", $lit, $t]':
        let ty = elab_type(t)
        let n = numeral_expression(lit.unwrap())
        match ty
        | ["T", "num", []]: [n, ty]
        | ["T", k, []] when numeral_injections.has_key(k):
            [application_expression(constant_expression(numeral_injections[k], fun_ty(["T", "num", []], ty)), n), ty]
        | _: syntax_meta.error("a numeral needs type num, int or real, not " ++ show_type(ty), stx)
    | '["app", $f, [$arg, ...]]':
        for values(acc = elab(f, env, ctx)) (a in [arg, ...]):
          let [fj, fty] = acc
          let [aj, aty] = elab(a, env, ctx)
          let cod = fresh_type(ctx, "Inferred")
          expect(fty, fun_ty(aty, cod), f, "application", ctx)
          [application_expression(fj, aj), cod]
    | '["op1", "!", $x]':
        let [xj, xty] = elab(x, env, ctx)
        expect(xty, bool_ty, x, "operand of !", ctx)
        [application_expression(constant_expression("~", fun_ty(bool_ty, bool_ty)), xj), bool_ty]
    | '["op1", "-", $x]':
        let [xj, xty] = elab(x, env, ctx)
        [["negation", xty, xj, stx], xty]
    | '["op2", $op, $l, $r]':
        let o = op.unwrap()
        let [lj, lty] = elab(l, env, ctx)
        let [rj, rty] = elab(r, env, ctx)
        fun binop(name, ty, res):
          [application_expression(application_expression(constant_expression(name, fun_ty(ty, fun_ty(ty, res))), lj), rj), res]
        match o
        | "&&" || "||" || "==>" || "<=>":
            expect(lty, bool_ty, l, "operand of " ++ o, ctx)
            expect(rty, bool_ty, r, "operand of " ++ o, ctx)
            binop({ "&&": "/\\", "||": "\\/", "==>": "==>", "<=>": "=" }[o], bool_ty, bool_ty)
        | "==":
            expect(rty, lty, r, "right side of ==", ctx)
            binop("=", lty, bool_ty)
        | "!=":
            expect(rty, lty, r, "right side of !=", ctx)
            let [eq, _] = binop("=", lty, bool_ty)
            [application_expression(constant_expression("~", fun_ty(bool_ty, bool_ty)), eq), bool_ty]
        | _:
            expect(rty, lty, r, "right operand of " ++ o, ctx)
            let res = if o == "<" || o == "<=" || o == ">" || o == ">=" | bool_ty | lty
            [["arithmetic", o, lty, lj, rj, stx], res]
    | '["binder", $kind, [[$id, $t], ...], $body]':
        let k = kind.unwrap()
        let vars:
          for List (i in [id, ...], ty in [t, ...]):
            let t = if ty.unwrap() == #false | fresh_type(ctx, "Inferred") | elab_type(ty)
            register_rigid_type(t, ctx)
            [i, binder_name(to_string(i.unwrap()), ctx, env), t]
        let body_env:
          for values(e :~ Map = env) ([i, name, ty] in vars):
            e ++ { i.unwrap(): ["var", name, ty] }
        let [bj, bty] = elab(body, body_env, ctx)
        unless k == "fun"
        | expect(bty, bool_ty, body, "body of " ++ k, ctx)
        let binder = { "forall": "!", "exists": "?", "exists1": "?!" }
        for values(acc = [bj, bty]) ([_, name, ty] in vars.reverse()):
          let [j, jty] = acc
          let abs = abstraction_expression(variable_expression(name, ty), j)
          let aty = fun_ty(ty, jty)
          if k == "fun"
          | [abs, aty]
          | [application_expression(constant_expression(binder[k], fun_ty(aty, bool_ty)), abs), bool_ty]
    | '["if", $c, $t, $e]':
        let [cj, cty] = elab(c, env, ctx)
        expect(cty, bool_ty, c, "condition of if", ctx)
        let [tj, tty] = elab(t, env, ctx)
        let [ej, ety] = elab(e, env, ctx)
        expect(ety, tty, e, "else branch", ctx)
        let cond_ty = fun_ty(bool_ty, fun_ty(tty, fun_ty(tty, tty)))
        [application_expression(application_expression(application_expression(constant_expression("COND", cond_ty), cj), tj), ej), tty]

  fun parse_declaration(g :: Syntax) :~ maybe(List):
    fun decl(kind, id, alias, ty):
      let '$(t :: hol_type_meta.Parsed)' = ty
      [kind, id, alias, elab_type(t)]
    match g
    | 'var $(id :: Identifier) as $(n :: Term) :: $ty ...': decl("var", id, n, '$ty ...')
    | 'var $(id :: Identifier) :: $ty ...': decl("var", id, #false, '$ty ...')
    | 'const $(id :: Identifier) as $(n :: Term) :: $ty ...': decl("const", id, n, '$ty ...')
    | 'const $(id :: Identifier) :: $ty ...': decl("const", id, #false, '$ty ...')
    | 'var $(id :: Identifier)': ["var", id, #false, #false]
    | 'var . $_ ...': #false
    | 'const . $_ ...': #false
    | 'var $_ ...': syntax_meta.error("expected `var name` or `var name :: type`", g)
    | 'const $_ ...': syntax_meta.error("expected `const name :: type`", g)
    | _: #false

// `hol:` quotation of a term.
expr.macro 'hol: $(g :: Group); ...':
  ~all_stx: stx
  let groups = [g, ...]
  when groups == []
  | syntax_meta.error("a hol: block needs a body expression", stx)
  let decls = for List (d in groups.take(groups.length() - 1)):
    match parse_declaration(d)
    | #false: syntax_meta.error("declarations must come first and be followed by exactly one expression", d)
    | decl: decl
  let body = groups[groups.length() - 1]
  when parse_declaration(body)
  | syntax_meta.error("a hol: block needs a body expression after its declarations", stx)
  // Elaborate once with every scheme variable fresh per occurrence. If a
  // constant's scheme variable stays unconstrained and shares its name with a
  // rigid variable of the quotation, elaborate again with that name shared
  // (the HOL Light reading); keep the first result if sharing is ill-typed.
  fun elaborate(shared):
    let ctx = inference_context()
    ctx[5].value := shared
    let env:
      for values(e :~ Map = {}) ([kind, id, alias, ty] in decls):
        when e.has_key([kind, id.unwrap()])
        | syntax_meta.error("duplicate declaration", id)
        let t = if ty == #false | fresh_type(ctx, "Inferred") | ty
        when kind == "var"
        | register_rigid_type(t, ctx)
          ctx[3].value := ctx[3].value ++ {hol_name(id, alias): #true}
        let entry = [kind, hol_name(id, alias), t]
        let qualified = e ++ { [kind, id.unwrap()]: entry }
        if kind == "const" && e.has_key(["var", id.unwrap()])
        | qualified
        | qualified ++ { id.unwrap(): entry }
    let '$(parsed :: hol_term_meta.Parsed)' = body
    let [j, _] = elab(parsed, env, ctx)
    let rigid = ctx[2].value
    let result = term_expression(j, ctx)
    let candidates:
      for values(m :~ Map = {}) (name in ctx[4].value.keys()):
        if rigid.has_key(name) | m ++ {name: #true} | m
    [result, candidates]
  let [first, candidates] = elaborate({})
  if candidates.length() == 0
  | first
  | try:
      let [second, _] = elaborate(candidates)
      second
      ~catch _: first

// `hol_type:` quotation of a type.
expr.macro 'hol_type: $(t :: hol_type_meta.Parsed)':
  type_expression(elab_type(t))

export:
  hol
  hol_type
  meta:
    hol_term_meta
    hol_type_meta
  // Forms and operators inside `hol:` and type positions.
  only_space hol_term_space:
    && || ==> <=> == != ! + - * / < <= > >= ::
    forall exists exists1 fun if const var
    names:
      #%literal #%parens #%call
  only_space hol_type_space:
    ->
    names:
      #%literal #%parens #%call
