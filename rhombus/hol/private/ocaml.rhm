#lang rhombus
// OCaml runtime behavior that HOL Light relies on: Stdlib exceptions,
// polymorphic compare, Hashtbl.hash and Random. The hash and random parts
// are based on the OCaml 4.14.1 runtime (Copyright 1996 INRIA; Xavier Leroy,
// runtime/hash.c and stdlib/random.ml); modified 2026-10-06 and 2026-10-07:
// HOL data-model subset translated to Rhombus.
// LGPL-2.1 with OCaml linking exception; see ../../../THIRD_PARTY_LICENSES/OCaml.txt.
import: lib("racket/base.rkt") as Rkt
import: lib("openssl/md5.rkt") as MD5
