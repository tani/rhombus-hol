// Stdlib exceptions.
class Failure(message)
fun failwith(s): throw Failure(s)
class InvalidArgument(message)
class Not_found()

// Pairs and list concatenation (@).
fun fst([x, y]): x
fun snd([x, y]): y
fun append(l1):
  fun(l2):
    match l1
    | PairList []: l2
    | PairList [h, & t]: PairList.cons(h,append(t)(l2))

// Values that stand for OCaml constructor applications. ocaml_view gives
// the value compared (and, for kernel objects, hashed) in their place:
// [tag, field, ...] for kernel types, terms and theorems.
interface OcamlValue:
  method ocaml_view()

// Base of translated OCaml variant and record types. Equality and hashing
// are the default structural ones of immutable classes; ocaml_view gives
// the constructor kind, tag and fields for OCaml's ordering.
class HolVariant():
  nonfinal
  implements OcamlValue
  override ocaml_view(): failwith("abstract variant")

// The option type.
class None():
  extends HolVariant
  override ocaml_view(): [0, [0, PairList []]]
class Some(value):
  extends HolVariant
  override ocaml_view(): [1, [0, PairList [value]]]

// OCaml's polymorphic compare. Returns the sign only.
fun cmp_scalar(x,y): if x == y | 0 | (if x < y | -1 | 1)
fun compare(x):
  fun(y):
    if x === y | 0 | compare_distinct(x,y)
// Tuples and views are Rhombus lists: compare fields left to right by index
// (no first/rest copies), stopping at the end of `a` as before.
fun compare_lists(a :: List, b :: List):
  let n = a.length()
  fun loop(i):
    if i == n
    | 0
    | let c = compare(a[i])(b[i])
      if c != 0 | c | loop(i + 1)
  loop(0)
fun compare_pairlists(x :: PairList, y :: PairList):
  // Both are non-empty here.
  let c = compare(x.first)(y.first)
  if c != 0 | c | compare(x.rest)(y.rest)
fun compare_distinct(x,y):
  cond
  | x is_a OcamlValue && y is_a OcamlValue:
      let vx = (x :~ OcamlValue).ocaml_view()
      let vy = (y :~ OcamlValue).ocaml_view()
      // Views are compared field by field, as OCaml compares blocks.
      if vx is_a List && vy is_a List | compare_lists(vx,vy) | compare(vx)(vy)
  // Structural equality first: it is native and settles equal subterms.
  | x == y: 0
  | x is_a Function || y is_a Function: throw InvalidArgument("compare: functional value")
  | x is_a PairList && y is_a PairList && x != PairList [] && y != PairList []:
      compare_pairlists(x, y)
  | x is_a List && y is_a List: compare_lists(x,y)
  | x == PairList []: -1
  | y == PairList []: 1
  | ~else: cmp_scalar(x,y)

// OCaml's polymorphic < and <= for values that are not Comparable in
// Rhombus, such as lists and tuples.
fun polymorphic_lt(x): fun(y): compare(x)(y) < 0
fun polymorphic_le(x): fun(y): compare(x)(y) <= 0

// Hashtbl.hash: MurmurHash3 mixing and the original bounded breadth-first
// traversal over the OCaml representation of HOL data.
class HashBlock(tag,fields)
class HashImmediate(value)
def block = HashBlock
def immediate = HashImmediate

def mask = 0xffffffff
fun u32(v): v bits.and mask
fun rotl(v,n): u32((v bits.(<<) n) bits.or (v bits.(>>) (32-n)))
fun mix(h,d):
  let d1 = u32(d * 0xcc9e2d51)
  let d2 = u32(rotl(d1,15) * 0x1b873593)
  u32(rotl(h bits.xor d2,13) * 5 + 0xe6546b64)
fun mix_int(h,d):
  mix(h,u32((d bits.(>>) 32) bits.xor (d bits.(>>) 63) bits.xor d))
fun mix_string(h,s :: ReadableString):
  let bs = s.utf8_bytes()
  let len = bs.length()
  fun chunks(i,h):
    cond
    | i >= len: h bits.xor len
    | ~else:
        let end = if i+4 < len | i+4 | len
        fun word(j,w):
          if j >= end
          | w
          | word(j+1,w bits.or (bs[j] bits.(<<) (8*(j-i))))
        chunks(i+4,mix(h,word(i,0)))
  chunks(0,h)
fun finish(h):
  let a = u32((h bits.xor (h bits.(>>) 16)) * 0x85ebca6b)
  let b = u32((a bits.xor (a bits.(>>) 13)) * 0xc2b2ae35)
  (b bits.xor (b bits.(>>) 16)) bits.and 0x3fffffff
fun hash_model(obj):
  let queue = Array.make(100,#false)
  queue[0] := obj
  fun loop(rd,wr,num,h):
    cond
    | rd == wr || num == 0: finish(h)
    | ~else:
        match queue[rd]
        | HashImmediate(value):
            loop(rd+1,wr,num-1,mix_int(h,(value bits.(<<) 1) bits.or 1))
        | s :: ReadableString: loop(rd+1,wr,num-1,mix_string(h,s))
        | HashBlock(tag,fields :: PairList):
            let h1 = mix(h,(fields.length() bits.(<<) 10)+tag)
            fun enqueue(fields,wr):
              cond
              | wr == 100: wr
              | ~else:
                  match fields
                  | PairList []: wr
                  | PairList [f, & rest]:
                      queue[wr] := f
                      enqueue(rest,wr+1)
            loop(rd+1,enqueue(fields,wr),num,h1)
        | _: error("hash_model: unsupported host value")
  loop(0,1,10,0)
fun hash_representation(v):
  match v
  | v :: OcamlValue:
      let [tag, & fields] = v.ocaml_view()
      block(tag, PairList[& for List (f in fields): hash_representation(f)])
  | PairList []: immediate(0)
  | PairList [h, & t]: block(0,PairList [hash_representation(h),hash_representation(t)])
  | n :: Int: immediate(n)
  | s :: String: s
fun ocaml_hash(v): hash_model(hash_representation(v))

// Random.State's 30-bit generator and integer seed initialization.
def state = Array(0x3ae2522b,0x1d8d4634,0x15b4fad0,0x18b14ace,0x12f8a3c4,0x3b086c47,0x16d467d6,0x101d91c7,0x321df177,0x0176c193,0x1ff72bf1,0x1e889109,0x0b464b18,0x2b86b97c,0x0891da48,0x03137463,0x085ac5a1,0x15d61f2f,0x3bced359,0x29c1c132,0x3a86766e,0x366d8c86,0x1f5b6222,0x3ce1b59f,0x2ebf78e1,0x27cd1b86,0x258f3dc3,0x389a8194,0x02e4c44c,0x18c43f7d,0x0f6e534f,0x1e7df359,0x055d0b7e,0x10e84e7e,0x126198e4,0x0e7722cb,0x1cbede28,0x3391b964,0x3d40e92a,0x0c59933d,0x0b8cd0b7,0x24efff1c,0x2803fdaa,0x08ebc72e,0x0f522e32,0x05398edc,0x2144a04c,0x0aef3cbd,0x01ad4719,0x35b93cd6,0x2a559d4f,0x1e6fd768,0x26e27f36,0x186f18c3,0x2fbf967a)
def index = Box(0)
fun ocaml_random_bits():
  index.value := (index.value+1) rem 55
  let i=index.value
  let cur=state[i]
  let v=(state[(i+24) rem 55] + (cur bits.xor ((cur bits.(>>) 25) bits.and 0x1f))) bits.and 0x3fffffff
  state[i] := v
  v
fun ocaml_random_int(n):
  if n<=0 || n>0x3fffffff | throw InvalidArgument("Random.int") | #void
  fun draw():
    let r=ocaml_random_bits()
    let v=r rem n
    if r-v>0x3fffffff-n+1 | draw() | v
  draw()
fun ocaml_random_init(seed):
  for (i in 0..55): state[i] := i
  let acc=Box(#"x")
  for (i in 0..110):
    let j=i rem 55
    acc.value := MD5.#{md5-bytes}(Rkt.#{open-input-bytes}(Rkt.#{bytes-append}(acc.value,Rkt.#{string->bytes/utf-8}(to_string(seed)))))
    let d=acc.value
    let n=Rkt.#{bytes-ref}(d,0)+(Rkt.#{bytes-ref}(d,1) bits.(<<) 8)+(Rkt.#{bytes-ref}(d,2) bits.(<<) 16)+(Rkt.#{bytes-ref}(d,3) bits.(<<) 24)
    state[j] := (state[j] bits.xor n) bits.and 0x3fffffff
  index.value := 0

// Stdlib values and functions used by the translated sources.
fun hol_max(x): fun(y): if x>y | x | y
fun hol_min(x): fun(y): if x<y | x | y
fun hol_ignore(_): #void
// OCaml's int_of_string: an optional sign, then decimal digits or a 0x, 0o
// or 0b prefixed literal, with `_` allowed after the first digit.
fun hol_int_of_string(s :: String):
  let m = Rkt.#{regexp-match}(#{#px"^([-+]?)(0[xX][0-9a-fA-F][0-9a-fA-F_]*|0[oO][0-7][0-7_]*|0[bB][01][01_]*|[0-9][0-9_]*)$"}, s)
  if !m
  | failwith("int_of_string")
  | let sign = (if to_string(Rkt.#{cadr}(m)) == "-" | -1 | 1)
    let lit = to_string(Rkt.#{caddr}(m)).replace("_", "", ~all: #true)
    let prefix = (if lit.length() > 1 | lit.substring(0, 2).downcase() | "")
    let [radix, digits]:
      cond
      | prefix == "0x": [16, lit.substring(2, lit.length())]
      | prefix == "0o": [8, lit.substring(2, lit.length())]
      | prefix == "0b": [2, lit.substring(2, lit.length())]
      | ~else: [10, lit]
    sign * Rkt.#{string->number}(digits, radix)
fun hol_int_of_float(n): math.truncate(n)
fun hol_float(n): Rkt.#{exact->inexact}(n)
fun string_of_int(n :: Int): to_string(n)
fun hol_int_of_num(n): if n==math.truncate(n) | n | failwith("int_of_num")
fun hol_char_code(s): Char.to_int(s[0])
fun hol_char_chr(n):
  if n<0 || n>255 | (throw InvalidArgument("Char.chr")) | Rkt.string(Rkt.#{integer->char}(n))
fun hol_string_sub(s): fun(i): fun(n): Rkt.substring(s,i,i+n)
fun hol_string_make(n): fun(c): Rkt.#{make-string}(n,Rkt.#{string-ref}(c,0))
fun quo_num(x): fun(y): math.truncate(x/y)
fun mod_num(x): fun(y): x-y*math.truncate(x/y)
fun power_num(x): fun(y): x ** y
fun minus_num(x): -x
fun abs_num(x): math.abs(x)
fun gcd_num(x): fun(y): Rkt.gcd(x,y)

// OCaml Stdlib and Num functions under their OCaml names, as the code that
// tools/ml2rhm generates calls them.
fun not(b): !b
fun abs(n): if n < 0 | -n | n
def max = hol_max
def min = hol_min
def ignore = hol_ignore
def int_of_string = hol_int_of_string
def int_of_float = hol_int_of_float
def float_of_int = hol_float
fun string_of_float(x): to_string(x)
fun lnot(n): Rkt.#{bitwise-not}(n)
fun incr(r): r.value := r.value + 1
fun decr(r): r.value := r.value - 1
fun invalid_arg(s): throw InvalidArgument(s)
fun print_string(s): print(s)
fun print_endline(s): println(s)
fun print_newline(_): println("")
fun num(n): n
fun succ_num(n): n + 1
fun is_integer_num(n): n is_a Int
fun string_of_num(n): to_string(n)
fun numdom(x): [Rkt.numerator(x), Rkt.denominator(x)]
def max_int = 4611686018427387903
fun floor(x): Rkt.#{exact->inexact}(math.floor(x))
fun log(x): Rkt.log(x)
fun hol_printf(fmt):
  fun emit(i,acc):
    if i>=fmt.length()
    | print(acc)
    | let c=to_string(fmt[i])
      cond
      | c!="%": emit(i+1,acc +& c)
      | i+1>=fmt.length(): print(acc +& "%")
      | ~else:
          let code=to_string(fmt[i+1])
          cond
          | code=="%": emit(i+2,acc +& "%")
          | code=="!": emit(i+2,acc)
          | code=="a": (fun(_p): fun(v): emit(i+2,acc +& to_string(v)))
          | ~else: (fun(v): emit(i+2,acc +& to_string(v)))
  emit(0,"")
class HolLazy(thunk,state)
fun hol_lazy(thunk): HolLazy(thunk,Box(None()))
fun hol_force(p):
  match p.state.value
  | Some([#true, v]): v
  | Some([#false, e]): (throw e)
  | None():
      try:
        let v=p.thunk()
        p.state.value:=Some([#true, v])
        v
        ~catch e:
          p.state.value:=Some([#false, e])
          (throw e)
fun hol_array_fold_left(f):
  fun(start):
    fun(a):
      fun fold(i,acc):
        if i==a.length() | acc | fold(i+1,f(acc)(a[i]))
      fold(0,start)
fun hol_array_map(f):
  fun(a):
    let out=Array.make(a.length(),#void)
    for (i in 0 .. a.length()):
      out[i] := f(a[i])
    out
fun hol_string_concat(sep):
  fun(l):
    match l
    | PairList []: ""
    | PairList [h,&t]:
        for values(acc = h) (x in (t :: PairList)): acc +& sep +& x
fun hol_string_escaped(s :: String):
  fun escape(c):
    match c
    | "\\": "\\\\"
    | "\"": "\\\""
    | "\n": "\\n"
    | "\t": "\\t"
    | "\r": "\\r"
    | "\b": "\\b"
    | _:
        let n=hol_char_code(c)
        if n<32 || n>126
        | "\\" +& (if n<100 | "0" | "") +& (if n<10 | "0" | "") +& to_string(n)
        | c
  for values(acc = "") (i in 0..s.length()): acc +& escape(s.substring(i,i+1))

// Hashtbl: bindings of one key are stacked, newest first. Each binding
// carries a sequence number; fold visits bindings newest first.
class HolHashTable(bindings, counter)
// String.compare and compare at type int.
namespace OCamlString:
  export:
    compare
    length
    get
    sub
    make
    concat
    escaped
    trim
    uppercase_ascii
    lowercase_ascii
    starts_with
    index
    contains
  fun compare(s1 :: String): fun(s2 :: String): if s1 < s2 | -1 | (if s1 == s2 | 0 | 1)
  // Characters are one-character strings, as elsewhere in the port.
  fun length(s :: String): s.length()
  fun get(s :: String):
    fun(i):
      if i < 0 || i >= s.length() | throw InvalidArgument("index out of bounds") | s.substring(i, i + 1)
  fun sub(s :: String):
    fun(i):
      fun(n):
        if i < 0 || n < 0 || i + n > s.length()
        | throw InvalidArgument("String.sub / Bytes.sub")
        | s.substring(i, i + n)
  def make = hol_string_make
  def concat = hol_string_concat
  def escaped = hol_string_escaped
  fun trim(s :: String):
    fun blank(i): s.substring(i, i + 1) in [" ", "\n", "\r", "\t", "\f"]
    fun first(i): if i < s.length() && blank(i) | first(i + 1) | i
    fun last(i): if i > 0 && blank(i - 1) | last(i - 1) | i
    let a = first(0)
    if a == s.length() | "" | s.substring(a, last(s.length()))
  fun uppercase_ascii(s :: String): Rkt.#{string-upcase}(s)
  fun lowercase_ascii(s :: String): Rkt.#{string-downcase}(s)
  fun starts_with(~prefix: p :: String, s :: String):
    p.length() <= s.length() && s.substring(0, p.length()) == p
  fun index(s :: String):
    fun(c :: String):
      fun loop(i):
        cond
        | i >= s.length(): throw Not_found()
        | s.substring(i, i + 1) == c: i
        | ~else: loop(i + 1)
      loop(0)
  fun contains(s :: String):
    fun(c :: String):
      for any (i in 0 .. s.length()): s.substring(i, i + 1) == c

// Char: characters are one-character strings.
namespace OCamlChar:
  export:
    code
    chr
  def code = hol_char_code
  fun chr(n): Rkt.#{string->immutable-string}(hol_char_chr(n))

// Array, curried as in OCaml, over Rhombus mutable arrays.
namespace OCamlArray:
  export:
    make
    get
    set
    length
    of_list
    to_list
    map
    fold_left
    make_matrix
  fun make(n):
    fun(x):
      if n < 0 | throw InvalidArgument("Array.make") | Array.make(n, x)
  fun get(a :: Array): fun(i): a[i]
  fun set(a :: Array): fun(i): fun(x): a[i] := x
  fun length(a :: Array): a.length()
  fun of_list(l :: PairList): Array(& l)
  fun to_list(a :: Array): PairList[& a]
  fun map(f): fun(a :: Array): Array(& (for List (x in a): f(x)))
  fun fold_left(f): fun(init): fun(a :: Array): for values(acc = init) (x in a): f(acc)(x)
  fun make_matrix(n): fun(m): fun(x): Array(& (for List (i in 0 .. n): Array.make(m, x)))

// Printf and the parts of Format that HOL Light uses outside its printer:
// %d %i %s %c %f %b and %%, with the arguments taken one at a time.
fun format_directives(fmt :: String):
  fun loop(i, n):
    cond
    | i + 1 >= fmt.length(): n
    | fmt.substring(i, i + 1) != "%": loop(i + 1, n)
    | fmt.substring(i + 1, i + 2) == "%": loop(i + 2, n)
    | ~else: loop(i + 2, n + 1)
  loop(0, 0)
fun format_apply(fmt :: String, args :: List):
  let out = Rkt.#{open-output-string}()
  fun loop(i, args :: List):
    when i < fmt.length()
    | let c = fmt.substring(i, i + 1)
      if c == "%" && i + 1 < fmt.length()
      | let d = fmt.substring(i + 1, i + 2)
        if d == "%"
        | Rkt.#{write-string}("%", out)
          loop(i + 2, args)
        | let v = args[0]
          Rkt.#{write-string}(if v is_a String | v | to_string(v), out)
          loop(i + 2, args.drop(1))
      | Rkt.#{write-string}(c, out)
        loop(i + 1, args)
  loop(0, args)
  Rkt.#{string->immutable-string}(Rkt.#{get-output-string}(out))
fun format_curried(fmt :: String, k):
  let n = format_directives(fmt)
  fun collect(args :: List):
    if args.length() == n | k(format_apply(fmt, args)) | fun(x): collect(args.add(x))
  collect([])

namespace Printf:
  export:
    printf
    sprintf
    eprintf
  fun printf(fmt): format_curried(fmt, fun(s): print(s))
  fun sprintf(fmt): format_curried(fmt, fun(s): s)
  fun eprintf(fmt): format_curried(fmt, fun(s): Rkt.#{write-string}(s, Rkt.#{current-error-port}()))

namespace Format:
  export:
    printf
    print_string
    print_newline
    print_flush
    std_formatter
    pp_print_string
    pp_print_newline
    pp_open_hbox
    pp_close_box
  def std_formatter = #void
  fun printf(fmt): format_curried(fmt, fun(s): print(s))
  fun print_string(s): print(s)
  fun print_newline(_): println("")
  fun print_flush(_): Rkt.#{flush-output}()
  fun pp_print_string(_): fun(s): print(s)
  fun pp_print_newline(_): fun(_): println("")
  fun pp_open_hbox(_): fun(_): #void
  fun pp_close_box(_): fun(_): #void
namespace OCamlInt:
  export: compare
  fun compare(i1 :: Int): fun(i2 :: Int): if i1 < i2 | -1 | (if i1 == i2 | 0 | 1)

// Map.Make(Key): OCaml's persistent maps, curried and raising Not_found as
// in the original, over Rhombus immutable maps. Key.compare is not consulted:
// the adapter is only for key types whose compare agrees with `==` (tuples of
// strings and integers), and no caller observes the iteration order.
namespace OCamlMap:
  export:
    Make
    S
  class S():
    property empty: {}
    method find(k): fun(m :: Map): if k in m | m[k] | throw Not_found()
    method add(k): fun(v): fun(m :: Map): m ++ { k: v }
    method mem(k): fun(m :: Map): k in m
    method remove(k): fun(m :: Map): m.remove(k)
    method union(f):
      fun(m1 :: Map):
        fun(m2 :: Map):
          for values(acc :: Map = m1) ((k, v2) in m2):
            if k in acc
            | match f(k)(acc[k])(v2)
              | Some(v): acc ++ { k: v }
              | None(): acc.remove(k)
            | acc ++ { k: v2 }
  fun Make(_key_compare) :: S: S()

namespace Hashtbl:
  export:
    create
    find
    add
    remove
    fold
    clear
    replace
  fun create(_): HolHashTable(MutableMap(), Box(0))
  fun clear(t):
    for (k in t.bindings.keys().to_list()): t.bindings.remove(k)
  fun stack(t, k): t.bindings.get(k, PairList [])
  fun find(t):
    fun(k):
      match stack(t, k)
      | PairList [[_, v], & _]: v
      | _: (throw Not_found())
  fun add(t):
    fun(k):
      fun(v):
        t.counter.value := t.counter.value + 1
        t.bindings[k] := PairList.cons([t.counter.value, v], stack(t, k))
  fun replace(t):
    fun(k):
      fun(v):
        match stack(t, k)
        | PairList [[n, _], & rest]: t.bindings[k] := PairList.cons([n, v], rest)
        | _: add(t)(k)(v)
  fun remove(t):
    fun(k):
      match stack(t, k)
      | PairList [_, & rest]:
          if rest == PairList [] | t.bindings.remove(k) | (t.bindings[k] := rest)
      | _: #void
  fun fold(f):
    fun(t):
      fun(start):
        let all:
          for List ((k, st) in t.bindings):
            each [n, v] in (st :: PairList)
            [n, k, v]
        let newest_first = all.sort(fun(a, b): a[0] > b[0])
        for values(acc = start) ([_, k, v] in newest_first): f(k)(v)(acc)

// List, with OCaml's argument order and exceptions.
namespace OCamlList:
  export:
    length
    rev
    iteri
    map
    concat
    exists
    filter
    find
    fold_left
    fold_right
    for_all
    hd
    iter
    mem
    mem_assoc
    nth
    partition
    rev_append
    sort
    map2
    for_all2
    fold_left2
    fold_right2
    mapi
    rev_map
    assoc
    concat_map
    filter_map
  fun map(f):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let v=f(h)
          PairList.cons(v,map(f)(t))
  fun concat(l):
    match l
    | PairList []: PairList []
    | PairList [h,&t]:
        let rest=concat(t)
        append(h)(rest)
  fun exists(p):
    fun(l):
      match l
      | PairList []: #false
      | PairList [h,&t]: p(h) || exists(p)(t)
  fun filter(p):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let keep=p(h)
          let rest=filter(p)(t)
          if keep | PairList.cons(h,rest) | rest
  fun find(p):
    fun(l):
      match l
      | PairList []: (throw Not_found())
      | PairList [h,&t]: (if p(h) | h | find(p)(t))
  fun fold_left(f):
    fun(a):
      fun(l):
        match l
        | PairList []: a
        | PairList [h,&t]: fold_left(f)(f(a)(h))(t)
  fun fold_right(f):
    fun(l):
      fun(a):
        match l
        | PairList []: a
        | PairList [h,&t]:
            let rest=fold_right(f)(t)(a)
            f(h)(rest)
  fun for_all(p):
    fun(l):
      match l
      | PairList []: #true
      | PairList [h,&t]: p(h) && for_all(p)(t)
  fun hd(l):
    match l
    | PairList [h,&_]: h
    | _: failwith("hd")
  fun tl(l):
    match l
    | PairList [_,&t]: t
    | _: failwith("tl")
  fun iter(f):
    fun(l):
      match l
      | PairList []: #void
      | PairList [h,&t]:
          f(h)
          iter(f)(t)
  fun mem(x):
    fun(l):
      match l
      | PairList []: #false
      | PairList [h,&t]: x == h || mem(x)(t)
  fun mem_assoc(x): fun(l): exists(fun([y, _]): x==y)(l)
  // List.nth as translated: the failures are those of hd and tl.
  fun nth(l): fun(n): if n == 0 | hd(l) | nth(tl(l))(n-1)
  fun partition(p):
    fun(l):
      match l
      | PairList []: [PairList [], PairList []]
      | PairList [h,&t]:
          let keep=p(h)
          let [yes, no]=partition(p)(t)
          if keep | [PairList.cons(h,yes), no] | [yes, PairList.cons(h,no)]
  fun rev_append(l1): fun(l2): append(PairList.reverse(l1))(l2)
  // Stable merge sort (lib.ml's mergesort with cmp x y <= 0).
  fun merge(ord):
    fun(l1):
      fun(l2):
        match l1
        | PairList []: l2
        | PairList [h1, & t1]:
            match l2
            | PairList []: l1
            | PairList [h2, & t2]: (if ord(h1)(h2) | PairList [h1, & merge(ord)(t1)(l2)] | PairList [h2, & merge(ord)(l1)(t2)])
  fun sort(cmp):
    fun(l):
      let ord = fun(x): fun(y): cmp(x)(y) <= 0
      fun mergepairs(l1):
        fun(l2):
          match [l1, l2]
          | [PairList [s, & PairList []], PairList []]: s
          | [l, PairList []]: mergepairs(PairList [])(l)
          | [l, PairList [s1, & PairList []]]: mergepairs(PairList [s1, & l])(PairList [])
          | [l, PairList [s1, & PairList [s2, & ss]]]: mergepairs(PairList [merge(ord)(s1)(s2), & l])(ss)
      if l == PairList [] | PairList [] | mergepairs(PairList [])(map(fun(x): PairList [x])(l))
  fun map2(f):
    fun(l1):
      fun(l2):
        match [l1, l2]
        | [PairList [], PairList []]: PairList []
        | [PairList [x,&xs], PairList [y,&ys]]:
            let z=f(x)(y)
            PairList.cons(z,map2(f)(xs)(ys))
        | _: (throw InvalidArgument("List.map2"))
  fun assoc(x):
    fun(l):
      match l
      | PairList []: (throw Not_found())
      | PairList [[y, v],&t]: (if x==y | v | assoc(x)(t))
  fun concat_map(f): fun(l): concat(map(f)(l))
  fun filter_map(f):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let v=f(h)
          match v
          | None(): filter_map(f)(t)
          | Some(x): PairList.cons(x,filter_map(f)(t))
  fun fold_left2(f):
    fun(a):
      fun(l1):
        fun(l2):
          match [l1, l2]
          | [PairList [], PairList []]: a
          | [PairList [x,&xs], PairList [y,&ys]]: fold_left2(f)(f(a)(x)(y))(xs)(ys)
          | _: (throw InvalidArgument("List.fold_left2"))
  fun fold_right2(f):
    fun(l1):
      fun(l2):
        fun(a):
          match [l1, l2]
          | [PairList [], PairList []]: a
          | [PairList [x,&xs], PairList [y,&ys]]: f(x)(y)(fold_right2(f)(xs)(ys)(a))
          | _: (throw InvalidArgument("List.fold_right2"))
  fun mapi(f):
    fun(l):
      fun go(i,rest):
        match rest
        | PairList []: PairList []
        | PairList [h,&t]:
            let v=f(i)(h)
            PairList.cons(v,go(i+1,t))
      go(0,l)
  fun rev_map(f):
    fun(l):
      for values(acc = PairList []) (x in (l :: PairList)): PairList.cons(f(x),acc)
  fun for_all2(p):
    fun(l1):
      fun(l2):
        match [l1, l2]
        | [PairList [], PairList []]: #true
        | [PairList [x,&xs], PairList [y,&ys]]: p(x)(y) && for_all2(p)(xs)(ys)
        | _: (throw InvalidArgument("List.for_all2"))
  fun length(l :: PairList): l.length()
  fun rev(l :: PairList): l.reverse()
  fun iteri(f):
    fun(l :: PairList):
      for (x in l, i in 0 ..): f(i)(x)
