#lang rhombus
// Copyright INRIA; based on OCaml 4.14.1 stdlib/map.ml.
// Modified 2026-10-05: Rhombus translation specialized for HOL nets.
// LGPL-2.1 with OCaml linking exception; see ../../../THIRD_PARTY_LICENSES/OCaml.txt.
// OCaml 4.14.1 stdlib/map.ml translation; LGPL-2.1 with OCaml linking exception.
// Map.union specialized to nets' callback, which always returns Some.
import: "compat.rhm" open
export:
  map_empty
  map_find
  map_add
  map_union
  NotFound
class NotFound()
class Empty()
class Node(l,v,d,r,h)
class Some(d)
def map_empty = Empty()
fun height(t):
  match t
  | Empty(): 0
  | Node(_,_,_,_,h): h
fun create(l,v,d,r): Node(l,v,d,r,1+(if height(l) >= height(r) | height(l) | height(r)))
fun singleton(v,d): Node(map_empty,v,d,map_empty,1)
fun bal(l,v,d,r):
  def hl = height(l)
  def hr = height(r)
  cond
  | hl > hr+2:
      def Node(ll,lv,ld,lr,_) = l
      if height(ll) >= height(lr)
      | create(ll,lv,ld,create(lr,v,d,r))
      | block:
          def Node(lrl,lrv,lrd,lrr,_) = lr
          create(create(ll,lv,ld,lrl),lrv,lrd,create(lrr,v,d,r))
  | hr > hl+2:
      def Node(rl,rv,rd,rr,_) = r
      if height(rr) >= height(rl)
      | create(create(l,v,d,rl),rv,rd,rr)
      | block:
          def Node(rll,rlv,rld,rlr,_) = rl
          create(create(l,v,d,rll),rlv,rld,create(rlr,rv,rd,rr))
  | ~else: create(l,v,d,r)
fun map_add(cmp):
  fun(x):
    fun(data):
      fun add(m):
        match m
        | Empty(): singleton(x,data)
        | Node(l,v,d,r,h):
            def c = cmp(x)(v)
            cond
            | c == 0: (if d === data | m | Node(l,x,data,r,h))
            | c < 0:
                def ll = add(l)
                if l === ll | m | bal(ll,v,d,r)
            | ~else:
                def rr = add(r)
                if r === rr | m | bal(l,v,d,rr)
      add
fun map_find(cmp):
  fun(x):
    fun find(m):
      match m
      | Empty(): throw NotFound()
      | Node(l,v,d,r,_):
          def c = cmp(x)(v)
          if c == 0 | d | find(if c < 0 | l | r)
    find
fun add_min(k,x,t):
  match t
  | Empty(): singleton(k,x)
  | Node(l,v,d,r,_): bal(add_min(k,x,l),v,d,r)
fun add_max(k,x,t):
  match t
  | Empty(): singleton(k,x)
  | Node(l,v,d,r,_): bal(l,v,d,add_max(k,x,r))
fun join(l,v,d,r):
  match Pair(l,r)
  | Pair(Empty(),_): add_min(v,d,r)
  | Pair(_,Empty()): add_max(v,d,l)
  | Pair(Node(ll,lv,ld,lr,lh),Node(rl,rv,rd,rr,rh)):
      cond
      | lh > rh+2: bal(ll,lv,ld,join(lr,v,d,r))
      | rh > lh+2: bal(join(l,v,d,rl),rv,rd,rr)
      | ~else: create(l,v,d,r)
fun split(cmp,x,t):
  match t
  | Empty(): values(map_empty,#false,map_empty)
  | Node(l,v,d,r,_):
      def c = cmp(x)(v)
      cond
      | c == 0: values(l,Some(d),r)
      | c < 0:
          def values(ll,pres,rl) = split(cmp,x,l)
          values(ll,pres,join(rl,v,d,r))
      | ~else:
          def values(lr,pres,rr) = split(cmp,x,r)
          values(join(l,v,d,lr),pres,rr)
fun map_union(cmp):
  fun(f):
    fun(s1):
      fun(s2):
        match Pair(s1,s2)
        | Pair(Empty(),s): s
        | Pair(s,Empty()): s
        | Pair(Node(l1,v1,d1,r1,h1),Node(l2,v2,d2,r2,h2)):
            if h1 >= h2
            | block:
                def values(ll2,dd2,rr2) = split(cmp,v1,s2)
                def l = map_union(cmp)(f)(l1)(ll2)
                def r = map_union(cmp)(f)(r1)(rr2)
                def d = match dd2 | Some(d2): f(v1)(d1)(d2) | _: d1
                join(l,v1,d,r)
            | block:
                def values(ll1,dd1,rr1) = split(cmp,v2,s1)
                def l = map_union(cmp)(f)(ll1)(l2)
                def r = map_union(cmp)(f)(rr1)(r2)
                def d = match dd1 | Some(d1): f(v2)(d1)(d2) | _: d2
                join(l,v2,d,r)