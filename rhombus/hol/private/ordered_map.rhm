#lang rhombus
// Mechanical OCaml Map.Make / Set.Make interface over ordered immutable lists.
// Ordering and traversal use the supplied OCaml comparator.
import: "compat.rhm" open
import: "data_types.rhm" open
export:
  ordered_map_merge
  OrderedSet
  ordered_set_empty
  ordered_set_is_empty
  ordered_set_singleton
  ordered_set_cardinal
  ordered_set_elements
  ordered_set_fold
  ordered_set_mem
  ordered_set_compare
  ordered_set_add
  ordered_set_union
  ordered_set_diff
  ordered_set_choose
  ordered_set_equal
  ordered_set_exists
  ordered_set_remove
  ordered_set_subset
  ordered_set_inter
  ordered_set_for_all
  OrderedMap
  Not_found
  ordered_map_empty
  ordered_map_is_empty
  ordered_map_singleton
  ordered_map_cardinal
  ordered_map_find
  ordered_map_add
  ordered_map_bindings
  ordered_map_fold
  ordered_map_filter
  ordered_map_mem
  ordered_map_remove
  ordered_map_map
  ordered_map_exists
class Not_found()
class OrderedMap(cmp,entries):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,entries))
fun ordered_map_empty(cmp): OrderedMap(cmp,PairList [])
fun ordered_map_is_empty(m :: OrderedMap): m.entries==PairList []
fun ordered_map_singleton(cmp): fun(k): fun(v): OrderedMap(cmp,PairList [Pair(k,v)])
fun ordered_map_cardinal(m :: OrderedMap): length(m.entries)
fun ordered_map_find(k):
  fun(m :: OrderedMap):
    fun find(l):
      match l
      | PairList []: throw Not_found()
      | PairList [Pair(key,value),&t]:
          let c=m.cmp(k)(key)
          if c==0 | value | (if c<0 | throw Not_found() | find(t))
    find(m.entries)
fun ordered_map_add(k):
  fun(v):
    fun(m :: OrderedMap):
      fun add(l):
        match l
        | PairList []: PairList [Pair(k,v)]
        | PairList [Pair(key,value),&t]:
            let c=m.cmp(k)(key)
            cond
            | c==0: (if v===value | l | PairList.cons(Pair(k,v),t))
            | c<0: PairList.cons(Pair(k,v),l)
            | ~else:
                let t_prime=add(t)
                if t_prime===t | l | PairList.cons(Pair(key,value),t_prime)
      let entries=add(m.entries)
      if entries===m.entries | m | OrderedMap(m.cmp,entries)
fun ordered_map_bindings(m :: OrderedMap): m.entries
fun ordered_map_fold(f): fun(m :: OrderedMap): fun(a): rev_itlist(fun(Pair(k,v)): fun(acc): f(k)(v)(acc))(m.entries)(a)
fun ordered_map_filter(p):
  fun(m :: OrderedMap): OrderedMap(m.cmp,filter(fun(Pair(k,v)): p(k)(v))(m.entries))
fun ordered_map_mem(k):
  fun(m):
    try:
      ordered_map_find(k)(m)
      #true
      ~catch Not_found(): #false
fun ordered_map_remove(k):
  fun(m :: OrderedMap):
    fun remove(l):
      match l
      | PairList []: l
      | PairList [Pair(key,value),&t]:
          let c=m.cmp(k)(key)
          cond
          | c==0: t
          | c<0: l
          | ~else:
              let t_prime=remove(t)
              if t_prime===t | l | PairList.cons(Pair(key,value),t_prime)
    let entries=remove(m.entries)
    if entries===m.entries | m | OrderedMap(m.cmp,entries)
fun ordered_map_map(f): fun(m :: OrderedMap): OrderedMap(m.cmp,map(fun(Pair(k,v)): Pair(k,f(v)))(m.entries))
fun ordered_map_exists(p): fun(m :: OrderedMap): exists(fun(Pair(k,v)): p(k)(v))(m.entries)
fun ordered_map_merge(f):
  fun(m1 :: OrderedMap):
    fun(m2 :: OrderedMap):
      fun merge(l1,l2):
        match Pair(l1,l2)
        | Pair(PairList [],PairList []): PairList []
        | ~else:
            let Pair(k,Pair(v1,Pair(v2,Pair(t1,t2)))):
              match Pair(l1,l2)
              | Pair(PairList [Pair(k,v),&t],PairList []): Pair(k,Pair(Some(v),Pair(None(),Pair(t,l2))))
              | Pair(PairList [],PairList [Pair(k,v),&t]): Pair(k,Pair(None(),Pair(Some(v),Pair(l1,t))))
              | Pair(PairList [Pair(k1,v1),&t1],PairList [Pair(k2,v2),&t2]):
                  let c=m1.cmp(k1)(k2)
                  cond
                  | c==0: Pair(k1,Pair(Some(v1),Pair(Some(v2),Pair(t1,t2))))
                  | c<0: Pair(k1,Pair(Some(v1),Pair(None(),Pair(t1,l2))))
                  | ~else: Pair(k2,Pair(None(),Pair(Some(v2),Pair(l1,t2))))
            let v=f(k)(v1)(v2)
            let tail=merge(t1,t2)
            match v
            | Some(x): PairList.cons(Pair(k,x),tail)
            | None(): tail
      OrderedMap(m1.cmp,merge(m1.entries,m2.entries))
class OrderedSet(cmp,entries):
  extends HolVariant
  override port_view(): Pair(1,Pair(0,entries))
fun ordered_set_empty(cmp): OrderedSet(cmp,PairList [])
fun ordered_set_is_empty(s :: OrderedSet): s.entries==PairList []
fun ordered_set_singleton(cmp): fun(x): OrderedSet(cmp,PairList [x])
fun ordered_set_cardinal(s :: OrderedSet): length(s.entries)
fun ordered_set_elements(s :: OrderedSet): s.entries
fun ordered_set_fold(f): fun(s :: OrderedSet): fun(a): rev_itlist(f)(s.entries)(a)
fun ordered_set_mem(x): fun(s :: OrderedSet): exists(fun(y): s.cmp(x)(y)==0)(s.entries)
fun ordered_set_compare(s1 :: OrderedSet):
  fun(s2 :: OrderedSet):
    fun cmp(l1,l2):
      match Pair(l1,l2)
      | Pair(PairList [],PairList []): 0
      | Pair(PairList [],_): -1
      | Pair(_,PairList []): 1
      | Pair(PairList [h1,&t1],PairList [h2,&t2]):
          let c=s1.cmp(h1)(h2)
          if c==0 | cmp(t1,t2) | c
    cmp(s1.entries,s2.entries)
fun ordered_set_add(x):
  fun(s :: OrderedSet):
    fun add(l):
      match l
      | PairList []: PairList [x]
      | PairList [h,&t]:
          let c=s.cmp(x)(h)
          cond
          | c==0: l
          | c<0: PairList.cons(x,l)
          | ~else:
              let t_prime=add(t)
              if t_prime===t | l | PairList.cons(h,t_prime)
    let entries=add(s.entries)
    if entries===s.entries | s | OrderedSet(s.cmp,entries)
fun ordered_set_union(s1 :: OrderedSet): fun(s2 :: OrderedSet): itlist(ordered_set_add)(s1.entries)(s2)
fun ordered_set_diff(s1 :: OrderedSet): fun(s2): OrderedSet(s1.cmp,filter(fun(x): !ordered_set_mem(x)(s2))(s1.entries))
fun ordered_set_choose(s :: OrderedSet): if s.entries==PairList [] | throw Not_found() | hd(s.entries)
fun ordered_set_equal(s1): fun(s2): ordered_set_compare(s1)(s2)==0
fun ordered_set_exists(p): fun(s :: OrderedSet): exists(p)(s.entries)
fun ordered_set_remove(x): fun(s :: OrderedSet): OrderedSet(s.cmp,filter(fun(y): s.cmp(x)(y)!=0)(s.entries))
fun ordered_set_subset(s1 :: OrderedSet): fun(s2): forall(fun(x): ordered_set_mem(x)(s2))(s1.entries)
fun ordered_set_inter(s1 :: OrderedSet): fun(s2): OrderedSet(s1.cmp,filter(fun(x): ordered_set_mem(x)(s2))(s1.entries))
fun ordered_set_for_all(p): fun(s :: OrderedSet): forall(p)(s.entries)
