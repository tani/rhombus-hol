#lang rhombus
import: "../tactics.rhm" as Tactics
import: "../equal.rhm" as Equal
export: then_tac then_list or_tac then_conv or_conv

// OCaml's infix THEN, THENL, ORELSE, THENC and ORELSEC share one
// left-associative level (`~same_as` is not transitive, so each operator
// names all earlier ones), so they mix without parentheses as upstream:
// `a then_tac b then_list [..] then_tac c` is ((a THEN b) THENL [..]) THEN c.
operator (left then_tac right):
  ~associativity: ~left
  Tactics.THEN(left)(right)
operator (left then_list right):
  ~associativity: ~left
  ~same_as: then_tac
  Tactics.THENL(left)(right)
operator (left or_tac right):
  ~associativity: ~left
  ~same_as: then_tac then_list
  Tactics.ORELSE(left)(right)
operator (left then_conv right):
  ~associativity: ~left
  ~same_as: then_tac then_list or_tac
  Equal.THENC(left)(right)
operator (left or_conv right):
  ~associativity: ~left
  ~same_as: then_tac then_list or_tac then_conv
  Equal.ORELSEC(left)(right)
