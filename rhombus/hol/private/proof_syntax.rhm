#lang rhombus
// The infix tactical and conversional operators, for modules that import
// them together: then_tac, then_list and or_tac are defined with THEN, THENL
// and ORELSE in ../tactics.rhm, then_conv and or_conv with THENC and ORELSEC
// in ../equal.rhm. All five share one left-associative level, as OCaml's
// infix THEN, THENL, ORELSE, THENC and ORELSEC do, so
// `a then_tac b then_list [..] then_tac c` is ((a THEN b) THENL [..]) THEN c.
import:
  "../tactics.rhm" open:
    only:
      then_tac
      then_list
      or_tac
  "../equal.rhm" open:
    only:
      then_conv
      or_conv
export: then_tac then_list or_tac then_conv or_conv
