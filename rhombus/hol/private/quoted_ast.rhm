#lang rhombus/and_meta
// Offline-inferred literal ASTs, materialized through public constructors.
// hol_term(Comb(Const("!", ...), ...)) is read as constructor-shaped syntax and
// serialized at expansion time; it is not HOL text and no theorem is recorded.
import: "compat.rhm" open
import: "../fusion.rhm" as Kernel
import: "../basics.rhm" as Basics
import:
  lib("json/main.rkt") open:
    only: #{string->jsexpr}
import:
  lib("racket/base.rkt") open:
    only:
      #{string?}
      #{string->immutable-string}
export: expand_quote hol_term
fun immutable_ast(value):
  if #{string?}(value)
  | #{string->immutable-string}(value)
  | match value
    | PairList [ & items]: map(immutable_ast)(items)
    | _: failwith("invalid offline quotation data")
fun expand_type(ast):
  match ast
  | PairList ["Tyvar",name]: Kernel.mk_vartype(name)
  | PairList ["Tyapp",name,args]: Kernel.mk_type([name, map(expand_type)(args)])
  | _: failwith("invalid offline type quotation")
fun expand_term(ast):
  match ast
  | PairList ["Var",name,ty]: Kernel.mk_var([name, expand_type(ty)])
  | PairList ["Const",name,ty]: Basics.mk_mconst([name, expand_type(ty)])
  | PairList ["Comb",left,right]:
      let r=expand_term(right)
      let l=expand_term(left)
      Kernel.mk_comb([l, r])
  | PairList ["Abs",variable,body]:
      let b=expand_term(body)
      let v=expand_term(variable)
      Kernel.mk_abs([v, b])
  | _: failwith("invalid offline term quotation")
fun expand_quote(encoded):
  let ast=immutable_ast(#{string->jsexpr}(encoded))
  match ast
  | PairList ["Tyvar",_]: expand_type(ast)
  | PairList ["Tyapp",_,_]: expand_type(ast)
  | _: expand_term(ast)

meta:
  fun escape(s :: String) :: String:
    s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
  fun quoted(n): "\"" +& escape(n.unwrap()) +& "\""
  fun join(parts):
    match parts
    | []: ""
    | [p]: p
    | [p, & rest]: p +& "," +& join(rest)
  fun application(f, x): "[\"Comb\"," +& f +& "," +& x +& "]"
  fun function_type(a, b): "[\"Tyapp\",\"fun\",[" +& a +& "," +& b +& "]]"
  def bool_type = "[\"Tyapp\",\"bool\",[]]"
  fun variable(n, ty): "[\"Var\"," +& quoted(n) +& "," +& ty +& "]"
  fun constant(n, ty): "[\"Const\",\"" +& escape(n) +& "\"," +& ty +& "]"
  fun reference(n, bindings):
    match bindings
    | [[name, ty], & rest]:
        if n.unwrap() == name | variable(n, ty) | reference(n, rest)
    | []: error("hol_term: unbound Ref")
  fun abstraction(n, ty, body, bindings):
    "[\"Abs\"," +& variable(n, ty) +& "," +& encode(body, [[n.unwrap(), ty], & bindings]) +& "]"
  fun quantified(symbol, n, ty, body, bindings):
    application(constant(symbol, function_type(function_type(ty, bool_type), bool_type)),
                abstraction(n, ty, body, bindings))
  fun binary(symbol, ty, a, b, bindings):
    application(application(constant(symbol, function_type(ty, function_type(ty, bool_type))),
                            encode(a, bindings)), encode(b, bindings))
  fun applications(f, args, bindings):
    match args
    | []: f
    | [arg, & rest]: applications(application(f, encode(arg, bindings)), rest, bindings)
  fun encode(stx, bindings = []) :: String:
    match stx
    | 'Tvar($n)': "[\"Tyvar\"," +& quoted(n) +& "]"
    | 'Fun($a, $b)': function_type(encode(a), encode(b))
    | 'Bool': bool_type
    | 'Num': "[\"Tyapp\",\"num\",[]]"
    | 'Real': "[\"Tyapp\",\"real\",[]]"
    | 'Int': "[\"Tyapp\",\"int\",[]]"
    | 'Ref($n)': reference(n, bindings)
    | 'Lambda($n, $ty, $b)': abstraction(n, encode(ty), b, bindings)
    | 'Forall($n, $ty, $b)': quantified("!", n, encode(ty), b, bindings)
    | 'Exists($n, $ty, $b)': quantified("?", n, encode(ty), b, bindings)
    | 'ExistsUnique($n, $ty, $b)': quantified("?!", n, encode(ty), b, bindings)
    | 'Eq($ty, $a, $b)': binary("=", encode(ty), a, b, bindings)
    | 'And($a, $b)': binary("/\\", bool_type, a, b, bindings)
    | 'Or($a, $b)': binary("\\/", bool_type, a, b, bindings)
    | 'Implies($a, $b)': binary("==>", bool_type, a, b, bindings)
    | 'Iff($a, $b)': binary("=", bool_type, a, b, bindings)
    | 'Not($a)': application(constant("~", function_type(bool_type, bool_type)), encode(a, bindings))
    | 'True': constant("T", bool_type)
    | 'False': constant("F", bool_type)
    | 'App($f, [$a, ...])': applications(encode(f, bindings), [a, ...], bindings)
    | 'Tyvar($n)': "[\"Tyvar\"," +& quoted(n) +& "]"
    | 'Tyapp($n, [$a, ...])': "[\"Tyapp\"," +& quoted(n) +& ",[" +& join([encode('$a'), ...]) +& "]]"
    | 'Var($n, $t)': "[\"Var\"," +& quoted(n) +& "," +& encode(t) +& "]"
    | 'Const($n, $t)': "[\"Const\"," +& quoted(n) +& "," +& encode(t) +& "]"
    | 'Comb($f, $x)': "[\"Comb\"," +& encode(f, bindings) +& "," +& encode(x, bindings) +& "]"
    | 'Abs($v, $b)': "[\"Abs\"," +& encode(v, bindings) +& "," +& encode(b, bindings) +& "]"
    | _: error("hol_term: unsupported term syntax")
expr.macro 'hol_term($t)':
  'expand_quote($(encode(t)))'
