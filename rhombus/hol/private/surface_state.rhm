#lang rhombus
// Hidden-constant state, translated from preterm.ml. See ../LICENSE.
import: "compat.rhm" open
export:
  hide_constant
  unhide_constant
  is_hidden
def mutable hcs = PairList []
fun hide_constant(c): hcs := union(PairList [c])(hcs)
fun unhide_constant(c): hcs := subtract(hcs)(PairList [c])
fun is_hidden(c): mem(c)(hcs)