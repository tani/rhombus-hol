#lang rhombus
// The parts of HOL Light's printer.ml that the parser and the theories use:
// the character classes, reserved words, binder/prefix/infix tables, the
// interface and overload state, and diagnostic printing stubs (the printer
// itself is not ported).
// (c) University of Cambridge 1998; John Harrison 1998-2007.
// The lexer and the term and type parsers are in ../parser.rhm.
import:
  "../lib.rhm" open
  "ocaml.rhm" open
import: "../fusion.rhm" open

export:
  pp_close_box
  pp_open_box
  pp_open_vbox
  pp_print_char
  pp_print_cut
  pp_print_int
  pp_print_newline
  pp_print_space
  pp_print_term
  print_term
  print_to_string
  std_formatter
  print_goal
  OCamlFormat
  string_of_type
  pp_print_type
  install_user_printer
  delete_user_printer
  hol_std_formatter
  string_of_thm
  print_thm
  hol_print_flush
  name_of
  string_of_term
  isspace
  issep
  isbra
  issymb
  isalpha
  isnum
  isalnum
  reserve_words
  unreserve_words
  is_reserved_word
  reserved_words
  parse_as_binder
  unparse_as_binder
  parses_as_binder
  binders
  parse_as_prefix
  unparse_as_prefix
  is_prefix
  prefixes
  parse_as_infix
  unparse_as_infix
  get_infix_status
  infixes
  the_interface
  the_overload_skeletons

fun name_of(tm):
  try:
    fst(dest_const(tm))
    ~catch Failure(_): fst(dest_var(tm))
// Diagnostic rendering only; HOL's printer is outside the runtime engine.
fun string_of_term(tm):
  match tm
  | Var(s,_): s
  | Const(s,_): s
  | Comb(f,x): "(" +& string_of_term(f) +& " " +& string_of_term(x) +& ")"
  | Abs(v,b): "(lambda " +& string_of_term(v) +& ". " +& string_of_term(b) +& ")"

// printer.ml: character classes of the lexer, by the first character of a
// string as in the original's lookup table.
def spaces = " \t\n\r"
def separators = ",;"
def brackets = "()[]{}"
def symbs = "\\!@#$%^&*-+|\\<=>/?~.:"
def alphas = "'abcdefghijklmnopqrstuvwxyz_ABCDEFGHIJKLMNOPQRSTUVWXYZ"
def nums = "0123456789"
fun char_class(c :: String):
  let ch = c.substring(0, 1)
  cond
  | spaces.contains(ch): 1
  | separators.contains(ch): 2
  | brackets.contains(ch): 4
  | symbs.contains(ch): 8
  | alphas.contains(ch): 16
  | nums.contains(ch): 32
  | ~else: 0
fun isspace(c): char_class(c) == 1
fun issep(c): char_class(c) == 2
fun isbra(c): char_class(c) == 4
fun issymb(c): char_class(c) == 8
fun isalpha(c): char_class(c) == 16
fun isnum(c): char_class(c) == 32
fun isalnum(c): char_class(c) >= 16

// printer.ml: reserved words.
def mutable reswords:
  PairList ["(", ")", "[", "]", "{", "}",
            ":", ";", ".", "|",
            "let", "in", "and", "if", "then", "else",
            "match", "with", "function", "->", "when"]
fun reserve_words(ns): reswords := union(reswords)(ns)
fun unreserve_words(ns): reswords := subtract(reswords)(ns)
fun is_reserved_word(n): mem(n)(reswords)
fun reserved_words(): reswords

// printer.ml: the tables that control the special parse status of names.
def mutable binder_list = PairList []
fun unparse_as_binder(n): binder_list := subtract(binder_list)(PairList [n])
fun parse_as_binder(n): binder_list := union(binder_list)(PairList [n])
fun parses_as_binder(n): mem(n)(binder_list)
fun binders(): binder_list
def mutable prefix_list = PairList []
fun unparse_as_prefix(n): prefix_list := subtract(prefix_list)(PairList [n])
fun parse_as_prefix(n): prefix_list := union(prefix_list)(PairList [n])
fun is_prefix(n): mem(n)(prefix_list)
fun prefixes(): prefix_list
def mutable infix_list = PairList []
fun infix_cmp([s, [x, a]]):
  fun([t, [y, b]]):
    x < y || (x == y && polymorphic_lt(b)(a)) || (x == y && a == b && polymorphic_lt(s)(t))
fun unparse_as_infix(n): infix_list := filter(fun([m, _]): m != n)(infix_list)
fun parse_as_infix([n, d]):
  infix_list := sort(infix_cmp)(PairList.cons([n, d], filter(fun([m, _]): m != n)(infix_list)))
fun get_infix_status(n): assoc(n)(infix_list)
fun infixes(): infix_list
fun hol_print_flush(): #void
import: lib("racket/base.rkt") as Primitive
def hol_std_formatter = #void
fun string_of_thm(th): string_of_term(concl(th))
fun print_thm(th): println(string_of_thm(th))
fun string_of_type(ty):
  match ty
  | Tyvar(s): s
  | Tyapp(s,PairList []): s
  | Tyapp(s,args): s +& "(" +& hol_string_concat(",")(map(string_of_type)(args)) +& ")"
fun pp_print_type(_fmt): fun(ty): print(string_of_type(ty))
def the_interface = Box(PairList [])
def the_overload_skeletons = Box(PairList [])
def user_printers = Box(PairList [])
fun install_user_printer([name, printer]):
  user_printers.value := PairList.cons([name, printer],user_printers.value)
fun delete_user_printer(name):
  let _ = assoc(name)(user_printers.value)
  user_printers.value := filter(fun([n, _]): n!=name)(user_printers.value)
namespace OCamlFormat:
  export:
    pp_print_string
    pp_print_type
    print_string
    open_vbox
    close_box
    print_break
  fun print_string(s): print(s)
  fun open_vbox(_): #void
  fun close_box(): #void
  fun print_break(_n): fun(_i): print(" ")
  fun pp_print_string(_fmt): fun(s): print(s)
  def pp_print_type = fun(_fmt): fun(ty): print(string_of_type(ty))

fun print_goal([_assumptions, g]): println(string_of_term(g))

def std_formatter = #void
fun pp_close_box(_fmt): fun(): #void
fun pp_open_box(_fmt): fun(_indent): #void
fun pp_open_vbox(_fmt): fun(_indent): #void
fun pp_print_char(_fmt): fun(c): print(c)
fun pp_print_cut(_fmt): fun(): #void
fun pp_print_int(_fmt): fun(n): print(to_string(n))
fun pp_print_newline(_fmt): fun(): println("")
fun pp_print_space(_fmt): fun(): print(" ")
fun pp_print_term(_fmt): fun(t): print(string_of_term(t))
fun print_term(t): print(string_of_term(t))
import: lib("racket/port.rkt") as HostPort
fun print_to_string(f): fun(x): HostPort.#{with-output-to-string}(fun(): f(#void)(x))
