// Private host containers used by the original evaluation and proof code.
fun fpf_singleton(x): fun(y): fpf_define(x)(y)(undefined)
class HolLazy(thunk,state)
fun hol_lazy(thunk): HolLazy(thunk,Box(None()))
fun hol_force(p):
  match p.state.value
  | Some([#true, v]): v
  | Some([#false, e]): (throw e)
  | None():
      try:
        let v=p.thunk()
        p.state.value:=Some([#true, v])
        v
        ~catch e:
          p.state.value:=Some([#false, e])
          (throw e)
// OCaml Hashtbl: bindings of one key are stacked, newest first. Each binding
// carries a sequence number so that fold visits bindings oldest first.
class Not_found()
class HolHashTable(bindings, counter)
fun hashtbl_bindings(t):
  for fold (acc = PairList []) ((k, st) in t.bindings):
    rev_itlist(fun([n, v]): fun(acc): PairList.cons([n, [k, v]], acc))(st)(acc)
namespace Hashtbl:
  export:
    create
    find
    add
    remove
    fold
    clear
    replace
  fun create(_): HolHashTable(MutableMap(), Box(0))
  fun clear(t):
    for (k in t.bindings.keys().to_list()): t.bindings.remove(k)
  fun stack(t, k): t.bindings.get(k, PairList [])
  fun find(t):
    fun(k):
      match stack(t, k)
      | PairList [[_, v], & _]: v
      | _: (throw Not_found())
  fun add(t):
    fun(k):
      fun(v):
        t.counter.value := t.counter.value + 1
        t.bindings[k] := PairList.cons([t.counter.value, v], stack(t, k))
  fun replace(t):
    fun(k):
      fun(v):
        match stack(t, k)
        | PairList [[n, _], & rest]: t.bindings[k] := PairList.cons([n, v], rest)
        | _: add(t)(k)(v)
  fun remove(t):
    fun(k):
      match stack(t, k)
      | PairList [_, & rest]:
          if rest == PairList [] | t.bindings.remove(k) | (t.bindings[k] := rest)
      | _: #void
  fun fold(f):
    fun(t):
      fun(start):
        let all = hashtbl_bindings(t)
        let newest_first = sort(fun([n1, _]): fun([n2, _]): n1 >= n2)(all)
        rev_itlist(fun([_, [k, v]]): fun(a): f(k)(v)(a))(newest_first)(start)

