fun hol_printf(fmt):
  fun emit(i,acc):
    if i>=fmt.length()
    | print(acc)
    | block:
        let c=to_string(fmt[i])
        cond
        | c!="%": emit(i+1,acc +& c)
        | i+1>=fmt.length(): print(acc +& "%")
        | ~else:
            let code=to_string(fmt[i+1])
            cond
            | code=="%": emit(i+2,acc +& "%")
            | code=="!": emit(i+2,acc)
            | code=="a": (fun(_p): fun(v): emit(i+2,acc +& to_string(v)))
            | ~else: (fun(v): emit(i+2,acc +& to_string(v)))
  emit(0,"")
