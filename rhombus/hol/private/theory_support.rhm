fun name_of(tm):
  try:
    fst(dest_const(tm))
    ~catch Failure(_): fst(dest_var(tm))
// Diagnostic rendering only; HOL's printer is outside the runtime engine.
fun string_of_term(tm):
  match tm
  | Var(s,_): s
  | Const(s,_): s
  | Comb(f,x): "(" +& string_of_term(f) +& " " +& string_of_term(x) +& ")"
  | Abs(v,b): "(lambda " +& string_of_term(v) +& ". " +& string_of_term(b) +& ")"

// The original tactic-pattern parser combinators; tokens are not HOL terms.
class Ident(name):
  extends HolVariant
  override ocaml_view(): [0, PairList [this.name]]
class Resword(name):
  extends HolVariant
  override ocaml_view(): [1, PairList [this.name]]
class Noparse()
fun parser_choice(p):
  fun(q):
    fun(inp):
      try:
        p(inp)
        ~catch Noparse(): q(inp)
fun parser_sequence(p):
  fun(q):
    fun(inp):
      let [a, r]=p(inp)
      let [b, s]=q(r)
      [[a, b], s]
fun parser_map(p):
  fun(f):
    fun(inp):
      let [a, r]=p(inp)
      [f(a), r]
fun many(p):
  fun(inp):
    try:
      let [a, r]=p(inp)
      let [xs, s]=many(p)(r)
      [PairList.cons(a,xs), s]
      ~catch Noparse(): [PairList [], inp]
fun possibly(p):
  fun(inp):
    try:
      let [a, r]=p(inp)
      [PairList [a], r]
      ~catch Noparse(): [PairList [], inp]
fun some(p):
  fun(inp):
    match inp
    | PairList [h,&t]: (if p(h) | [h, t] | throw Noparse())
    | _: throw Noparse()
fun a(tok): some(fun(t): t==tok)
fun fix(err):
  fun(p):
    fun(inp):
      try:
        p(inp)
        ~catch Noparse(): failwith(err+&" expected")
fun atleast(n):
  fun(p):
    if n<=0
    | many(p)
    | parser_map(parser_sequence(p)(atleast(n-1)(p)))(fun([h, t]): PairList.cons(h,t))
fun listof(p):
  fun(sep):
    fun(err):
      parser_map(parser_sequence(p)(many(parser_map(parser_sequence(sep)(fix(err)(p)))(snd))))(fun([h, t]): PairList.cons(h,t))
fun elistof(p): fun(sep): fun(err): parser_choice(listof(p)(sep)(err))(fun(inp): [PairList [], inp])
def alpha_chars = "'abcdefghijklmnopqrstuvwxyz_ABCDEFGHIJKLMNOPQRSTUVWXYZ"
def num_chars = "0123456789"
def symbol_chars = "\\!@#$%^&*-+|\\<=>/?~.:"
fun isalpha(c): c.length()>0 && alpha_chars.contains(to_string(c[0]))
fun isalnum(c): c.length()>0 && (isalpha(c) || num_chars.contains(to_string(c[0])))
def reserved_pattern_words = PairList ["(",")","[","]","{","}",":",";",".","|","let","in","and","if","then","else","match","with","function","->","when"]
fun lex(chars):
  fun take(p,xs,acc):
    match xs
    | PairList [h,&t]: (if p(h) | take(p,t,PairList.cons(h,acc)) | [implode(rev(acc)), xs])
    | _: [implode(rev(acc)), xs]
  fun scan(xs):
    match xs
    | PairList []: PairList []
    | PairList [h,&t]:
        cond
        | " \t\n\r".contains(h): scan(t)
        | "()[]{};,".contains(h): PairList.cons(Resword(h),scan(t))
        | ~else:
            let pred = if isalnum(h) | isalnum | (fun(c): symbol_chars.contains(c))
            let [s, r]=take(pred,t,PairList [h])
            let tok = if mem(s)(reserved_pattern_words) | Resword(s) | Ident(s)
            PairList.cons(tok,scan(r))
  scan(chars)
// Literal quotations have already been expanded; retain binder metadata.
def mutable theory_binders = PairList []
fun parse_as_binder(s): theory_binders := insert(s)(theory_binders)
fun unparse_as_binder(s): theory_binders := subtract(theory_binders)(PairList [s])
def mutable theory_infixes = PairList []
def mutable theory_prefixes = PairList []
def mutable theory_interface = PairList []
fun parse_as_infix([s, d]):
  theory_infixes := PairList.cons([s, d],filter(fun([n, _]): n!=s)(theory_infixes))
fun parse_as_prefix(s): theory_prefixes := insert(s)(theory_prefixes)
fun remove_interface(s): theory_interface := filter(fun([n, _]): n!=s)(theory_interface)
fun override_interface([s, tm]):
  remove_interface(s)
  theory_interface := PairList.cons([s, tm],theory_interface)
fun hol_print_flush(): #void
import: lib("racket/base.rkt") as Primitive
def hol_std_formatter = #void
fun string_of_thm(th): string_of_term(concl(th))
fun print_thm(th): println(string_of_thm(th))
fun string_of_type(ty):
  match ty
  | Tyvar(s): s
  | Tyapp(s,PairList []): s
  | Tyapp(s,args): s +& "(" +& hol_string_concat(",")(map(string_of_type)(args)) +& ")"
fun pp_print_type(_fmt): fun(ty): print(string_of_type(ty))
def the_interface = Box(PairList [])
def the_overload_skeletons = Box(PairList [])
def user_printers = Box(PairList [])
fun install_user_printer([name, printer]):
  user_printers.value := PairList.cons([name, printer],user_printers.value)
fun delete_user_printer(name):
  let _ = assoc(name)(user_printers.value)
  user_printers.value := filter(fun([n, _]): n!=name)(user_printers.value)
namespace OCamlFormat:
  export:
    pp_print_string
    pp_print_type
    print_string
    open_vbox
    close_box
    print_break
  fun print_string(s): print(s)
  fun open_vbox(_): #void
  fun close_box(): #void
  fun print_break(_n): fun(_i): print(" ")
  fun pp_print_string(_fmt): fun(s): print(s)
  def pp_print_type = fun(_fmt): fun(ty): print(string_of_type(ty))

fun isnum(c): c.length()>0 && num_chars.contains(to_string(c[0]))

fun print_goal([_assumptions, g]): println(string_of_term(g))

def std_formatter = #void
fun pp_close_box(_fmt): fun(): #void
fun pp_open_box(_fmt): fun(_indent): #void
fun pp_open_vbox(_fmt): fun(_indent): #void
fun pp_print_char(_fmt): fun(c): print(c)
fun pp_print_cut(_fmt): fun(): #void
fun pp_print_int(_fmt): fun(n): print(to_string(n))
fun pp_print_newline(_fmt): fun(): println("")
fun pp_print_space(_fmt): fun(): print(" ")
fun pp_print_term(_fmt): fun(t): print(string_of_term(t))
fun print_term(t): print(string_of_term(t))
import: lib("racket/port.rkt") as HostPort
fun print_to_string(f): fun(x): HostPort.#{with-output-to-string}(fun(): f(#void)(x))
