fun hol_force(p):
  match p.state.value
  | Some(Pair(#true,v)): v
  | Some(Pair(#false,e)): hol_raise(e)
  | None():
      try:
        let v=p.thunk()
        p.state.value:=Some(Pair(#true,v))
        v
        ~catch e:
          p.state.value:=Some(Pair(#false,e))
          hol_raise(e)
class HolHashTable(entries)
namespace Hashtbl:
  export:
    create
    find
    add
    remove
    fold
    clear
    replace
  fun clear(t): t.entries.value:=PairList []
  fun replace(t):
    fun(k):
      fun(v):
        fun upd(l):
          match l
          | PairList []: PairList [Pair(k,v)]
          | PairList [Pair(key,_old) as h,&rest]:
              if key==k | PairList.cons(Pair(k,v),rest) | PairList.cons(h,upd(rest))
        t.entries.value:=upd(t.entries.value)
  fun create(_): HolHashTable(Box(PairList []))
  fun find(t): fun(k): OCamlList.assoc(k)(t.entries.value)
  fun add(t):
    fun(k):
      fun(v):
        t.entries.value:=PairList.cons(Pair(k,v),t.entries.value)
  fun remove(t):
    fun(k):
      fun drop(l):
        match l
        | PairList []: l
        | PairList [Pair(key,_) as h,&rest]:
            if key==k | rest | PairList.cons(h,drop(rest))
      t.entries.value:=drop(t.entries.value)
  fun fold(f):
    fun(t):
      fun(start):
        rev_itlist(fun(Pair(k,v)): fun(a): f(k)(v)(a))(t.entries.value)(start)

