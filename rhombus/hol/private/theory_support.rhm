#lang rhombus
// The parts of HOL Light's parser.ml and printer.ml that the theories call:
// the parser combinators behind string patterns of tactics and type
// definitions, the interface and overload state used by type inference,
// and diagnostic printing stubs.
// (c) University of Cambridge 1998; John Harrison 1998-2007.
// This module does not parse HOL terms or provide proof rules.
import:
  "../lib.rhm" open
  "ocaml.rhm" open
import: "../fusion.rhm" open

