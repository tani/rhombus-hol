def lib_gcd:«
  (block:«
    fun gxd(x):«
      (fun(y):«
        (block:«
          if hol_equal(y)(0)
          | x
          | gxd(y)(hol_mod(x)(y))
        »)
      »)
    »;
    (fun(x):«
      (fun(y):«
        (block:«
          let x_prime:«
            abs(x)
          »;
          let y_prime:«
            abs(y)
          »;
          (block:«
            if hol_lt(x_prime)(y_prime)
            | gxd(y_prime)(x_prime)
            | gxd(x_prime)(y_prime)
          »)
        »)
      »)
    »)
  »)
»
def gcd = lib_gcd

