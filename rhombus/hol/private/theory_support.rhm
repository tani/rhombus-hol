fun hol_max(x): fun(y): if x>y | x | y
fun hol_min(x): fun(y): if x<y | x | y
fun hol_ignore(_): #void
fun hol_int_of_string(s):
  let n = s.to_int()
  if n | n | failwith("int_of_string")
fun hol_string_length(s): s.length()
fun hol_string_get(s): fun(n): to_string(s[n])
fun hol_range(m):
  fun(n):
    if m>n | PairList [] | PairList.cons(m,hol_range(m+1)(n))
fun name_of(tm):
  try:
    fst(dest_const(tm))
    ~catch Failure(_): fst(dest_var(tm))
// Diagnostic rendering only; HOL's printer is outside the runtime engine.
fun string_of_term(tm):
  match tm
  | Var(s,_): s
  | Const(s,_): s
  | Comb(f,x): "(" +& string_of_term(f) +& " " +& string_of_term(x) +& ")"
  | Abs(v,b): "(lambda " +& string_of_term(v) +& ". " +& string_of_term(b) +& ")"

// The original tactic-pattern parser combinators; tokens are not HOL terms.
class Ident(name):
  extends HolVariant
  override ocaml_view(): [0, PairList [this.name]]
class Resword(name):
  extends HolVariant
  override ocaml_view(): [1, PairList [this.name]]
class Noparse()
fun parser_choice(p):
  fun(q):
    fun(inp):
      try:
        p(inp)
        ~catch Noparse(): q(inp)
fun parser_sequence(p):
  fun(q):
    fun(inp):
      let [a, r]=p(inp)
      let [b, s]=q(r)
      [[a, b], s]
fun parser_map(p):
  fun(f):
    fun(inp):
      let [a, r]=p(inp)
      [f(a), r]
fun many(p):
  fun(inp):
    try:
      let [a, r]=p(inp)
      let [xs, s]=many(p)(r)
      [PairList.cons(a,xs), s]
      ~catch Noparse(): [PairList [], inp]
fun possibly(p):
  fun(inp):
    try:
      let [a, r]=p(inp)
      [PairList [a], r]
      ~catch Noparse(): [PairList [], inp]
fun some(p):
  fun(inp):
    match inp
    | PairList [h,&t]: (if p(h) | [h, t] | throw Noparse())
    | _: throw Noparse()
fun a(tok): some(fun(t): t==tok)
fun fix(err):
  fun(p):
    fun(inp):
      try:
        p(inp)
        ~catch Noparse(): failwith(err+&" expected")
fun atleast(n):
  fun(p):
    if n<=0
    | many(p)
    | parser_map(parser_sequence(p)(atleast(n-1)(p)))(fun([h, t]): PairList.cons(h,t))
fun listof(p):
  fun(sep):
    fun(err):
      parser_map(parser_sequence(p)(many(parser_map(parser_sequence(sep)(fix(err)(p)))(snd))))(fun([h, t]): PairList.cons(h,t))
fun elistof(p): fun(sep): fun(err): parser_choice(listof(p)(sep)(err))(fun(inp): [PairList [], inp])
def alpha_chars = "'abcdefghijklmnopqrstuvwxyz_ABCDEFGHIJKLMNOPQRSTUVWXYZ"
def num_chars = "0123456789"
def symbol_chars = "\\!@#$%^&*-+|\\<=>/?~.:"
fun isalpha(c): c.length()>0 && alpha_chars.contains(to_string(c[0]))
fun isalnum(c): c.length()>0 && (isalpha(c) || num_chars.contains(to_string(c[0])))
def reserved_pattern_words = PairList ["(",")","[","]","{","}",":",";",".","|","let","in","and","if","then","else","match","with","function","->","when"]
fun lex(chars):
  fun take(p,xs,acc):
    match xs
    | PairList [h,&t]: (if p(h) | take(p,t,PairList.cons(h,acc)) | [implode(rev(acc)), xs])
    | _: [implode(rev(acc)), xs]
  fun scan(xs):
    match xs
    | PairList []: PairList []
    | PairList [h,&t]:
        cond
        | " \t\n\r".contains(h): scan(t)
        | "()[]{};,".contains(h): PairList.cons(Resword(h),scan(t))
        | ~else:
            let pred = if isalnum(h) | isalnum | (fun(c): symbol_chars.contains(c))
            let [s, r]=take(pred,t,PairList [h])
            let tok = if mem(s)(reserved_pattern_words) | Resword(s) | Ident(s)
            PairList.cons(tok,scan(r))
  scan(chars)
// Literal quotations have already been expanded; retain binder metadata.
def mutable theory_binders = PairList []
fun parse_as_binder(s): theory_binders := insert(s)(theory_binders)
fun unparse_as_binder(s): theory_binders := subtract(theory_binders)(PairList [s])
def mutable theory_infixes = PairList []
def mutable theory_prefixes = PairList []
def mutable theory_interface = PairList []
fun parse_as_infix([s, d]):
  theory_infixes := PairList.cons([s, d],filter(fun([n, _]): n!=s)(theory_infixes))
fun parse_as_prefix(s): theory_prefixes := insert(s)(theory_prefixes)
fun remove_interface(s): theory_interface := filter(fun([n, _]): n!=s)(theory_interface)
fun override_interface([s, tm]):
  remove_interface(s)
  theory_interface := PairList.cons([s, tm],theory_interface)
fun hol_print_string(s): print(s)
fun hol_print_newline(): println("")
fun hol_print_flush(): #void
fun hol_lsr(x): fun(y): x bits.(>>) y
fun hol_rat_div(x): fun(y): x/y
fun hol_int_of_num(n): if n==math.truncate(n) | n | failwith("int_of_num")
fun hol_char_code(s): Char.to_int(s[0])
fun num(n): n
fun quo_num(x): fun(y): math.truncate(x/y)
fun mod_num(x): fun(y): x-y*math.truncate(x/y)
fun power_num(x): fun(y): x ** y
fun minus_num(x): -x
fun abs_num(x): math.abs(x)
fun hol_string_concat(sep):
  fun(l):
    match l
    | PairList []: ""
    | PairList [h,&t]: h +& itlist(fun(x): fun(y): sep +& x +& y)(t)("")
// The unqualified lib.ml versions, visible below despite the OCamlList names.
def list_rev = rev
def list_exists = exists
def list_hd = hd
def list_mem = mem
namespace OCamlList:
  export:
    map
    rev
    length
    concat
    exists
    filter
    find
    fold_left
    fold_right
    for_all
    hd
    iter
    mem
    mem_assoc
    nth
    partition
    rev_append
    sort
    map2
    for_all2
    fold_left2
    fold_right2
    mapi
    rev_map
    assoc
    concat_map
    filter_map
  fun map(f):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let v=f(h)
          PairList.cons(v,map(f)(t))
  def rev = list_rev
  def length = (fun(l): itlist(fun(_): fun(n): n+1)(l)(0))
  def concat = flat
  def exists = list_exists
  fun filter(p):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let keep=p(h)
          let rest=filter(p)(t)
          if keep | PairList.cons(h,rest) | rest
  fun find(p):
    fun(l):
      match l
      | PairList []: (throw Not_found())
      | PairList [h,&t]: (if p(h) | h | find(p)(t))
  fun fold_left(f): fun(a): fun(l): rev_itlist(C(f))(l)(a)
  fun fold_right(f): fun(l): fun(a): itlist(f)(l)(a)
  def for_all = forall
  def hd = list_hd
  def iter = do_list
  def mem = list_mem
  fun mem_assoc(x): fun(l): exists(fun([y, _]): x==y)(l)
  def nth = C(el)
  fun partition(p):
    fun(l):
      match l
      | PairList []: [PairList [], PairList []]
      | PairList [h,&t]:
          let keep=p(h)
          let [yes, no]=partition(p)(t)
          if keep | [PairList.cons(h,yes), no] | [yes, PairList.cons(h,no)]
  fun rev_append(l1): fun(l2): append(rev(l1))(l2)
  fun sort(cmp): fun(l): mergesort(fun(x): fun(y): cmp(x)(y)<=0)(l)
  fun map2(f):
    fun(l1):
      fun(l2):
        match [l1, l2]
        | [PairList [], PairList []]: PairList []
        | [PairList [x,&xs], PairList [y,&ys]]:
            let z=f(x)(y)
            PairList.cons(z,map2(f)(xs)(ys))
        | _: (throw InvalidArgument("List.map2"))
  fun assoc(x):
    fun(l):
      match l
      | PairList []: (throw Not_found())
      | PairList [[y, v],&t]: (if x==y | v | assoc(x)(t))
  fun concat_map(f): fun(l): concat(map(f)(l))
  fun filter_map(f):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let v=f(h)
          match v
          | None(): filter_map(f)(t)
          | Some(x): PairList.cons(x,filter_map(f)(t))

  fun fold_left2(f):
    fun(a):
      fun(l1):
        fun(l2):
          match [l1, l2]
          | [PairList [], PairList []]: a
          | [PairList [x,&xs], PairList [y,&ys]]: fold_left2(f)(f(a)(x)(y))(xs)(ys)
          | _: (throw InvalidArgument("List.fold_left2"))
  fun fold_right2(f):
    fun(l1):
      fun(l2):
        fun(a):
          match [l1, l2]
          | [PairList [], PairList []]: a
          | [PairList [x,&xs], PairList [y,&ys]]: f(x)(y)(fold_right2(f)(xs)(ys)(a))
          | _: (throw InvalidArgument("List.fold_right2"))
  fun mapi(f):
    fun(l):
      fun go(i,rest):
        match rest
        | PairList []: PairList []
        | PairList [h,&t]:
            let v=f(i)(h)
            PairList.cons(v,go(i+1,t))
      go(0,l)
  fun rev_map(f): fun(l): rev_itlist(fun(x): fun(a): PairList.cons(f(x),a))(l)(PairList [])

  fun for_all2(p):
    fun(l1):
      fun(l2):
        match [l1, l2]
        | [PairList [], PairList []]: #true
        | [PairList [x,&xs], PairList [y,&ys]]: p(x)(y) && for_all2(p)(xs)(ys)
        | _: (throw InvalidArgument("List.for_all2"))


import: lib("racket/base.rkt") as Primitive
fun hol_array_make(n): fun(v): Array.make(n,v)
fun hol_array_get(a): fun(i): a[i]
fun hol_array_set(a): fun(i): fun(v): (a[i] := v)
fun hol_array_fold_left(f):
  fun(start):
    fun(a):
      fun fold(i,acc):
        if i==a.length() | acc | fold(i+1,f(acc)(a[i]))
      fold(0,start)
fun hol_string_make(n): fun(c): Primitive.#{make-string}(n,Primitive.#{string-ref}(c,0))
fun hol_string_sub(s): fun(i): fun(n): Primitive.substring(s,i,i+n)
def hol_std_formatter = #void
fun hol_printf(fmt):
  fun emit(i,acc):
    if i>=fmt.length()
    | print(acc)
    | let c=to_string(fmt[i])
      cond
      | c!="%": emit(i+1,acc +& c)
      | i+1>=fmt.length(): print(acc +& "%")
      | ~else:
          let code=to_string(fmt[i+1])
          cond
          | code=="%": emit(i+2,acc +& "%")
          | code=="!": emit(i+2,acc)
          | code=="a": (fun(_p): fun(v): emit(i+2,acc +& to_string(v)))
          | ~else: (fun(v): emit(i+2,acc +& to_string(v)))
  emit(0,"")
fun hol_fprintf(_formatter): hol_printf
fun hol_lnot(n): n bits.xor -1
fun hol_int_of_float(n): math.truncate(n)
fun hol_float(n): Primitive.#{exact->inexact}(n)
fun string_of_thm(th): string_of_term(concl(th))
fun print_thm(th): println(string_of_thm(th))
fun hol_or(x): fun(y): x || y
fun hol_and(x): fun(y): x && y
fun string_of_type(ty):
  match ty
  | Tyvar(s): s
  | Tyapp(s,PairList []): s
  | Tyapp(s,args): s +& "(" +& hol_string_concat(",")(map(string_of_type)(args)) +& ")"
fun pp_print_type(_fmt): fun(ty): print(string_of_type(ty))
def the_interface = Box(PairList [])
def the_overload_skeletons = Box(PairList [])
def user_printers = Box(PairList [])
fun install_user_printer([name, printer]):
  user_printers.value := PairList.cons([name, printer],user_printers.value)
fun delete_user_printer(name):
  let _ = assoc(name)(user_printers.value)
  user_printers.value := filter(fun([n, _]): n!=name)(user_printers.value)
namespace OCamlFormat:
  export:
    pp_print_string
    pp_print_type
    print_string
    open_vbox
    close_box
    print_break
  def print_string = hol_print_string
  fun open_vbox(_): #void
  fun close_box(): #void
  fun print_break(_n): fun(_i): print(" ")
  fun pp_print_string(_fmt): fun(s): print(s)
  def pp_print_type = fun(_fmt): fun(ty): print(string_of_type(ty))

fun isnum(c): c.length()>0 && num_chars.contains(to_string(c[0]))

class HolLazy(thunk,state)
fun hol_lazy(thunk): HolLazy(thunk,Box(None()))
fun hol_force(p):
  match p.state.value
  | Some([#true, v]): v
  | Some([#false, e]): (throw e)
  | None():
      try:
        let v=p.thunk()
        p.state.value:=Some([#true, v])
        v
        ~catch e:
          p.state.value:=Some([#false, e])
          (throw e)
class HolHashTable(bindings, counter)
fun hashtbl_bindings(t):
  for fold (acc = PairList []) ((k, st) in t.bindings):
    rev_itlist(fun([n, v]): fun(acc): PairList.cons([n, [k, v]], acc))(st)(acc)
namespace Hashtbl:
  export:
    create
    find
    add
    remove
    fold
    clear
    replace
  fun create(_): HolHashTable(MutableMap(), Box(0))
  fun clear(t):
    for (k in t.bindings.keys().to_list()): t.bindings.remove(k)
  fun stack(t, k): t.bindings.get(k, PairList [])
  fun find(t):
    fun(k):
      match stack(t, k)
      | PairList [[_, v], & _]: v
      | _: (throw Not_found())
  fun add(t):
    fun(k):
      fun(v):
        t.counter.value := t.counter.value + 1
        t.bindings[k] := PairList.cons([t.counter.value, v], stack(t, k))
  fun replace(t):
    fun(k):
      fun(v):
        match stack(t, k)
        | PairList [[n, _], & rest]: t.bindings[k] := PairList.cons([n, v], rest)
        | _: add(t)(k)(v)
  fun remove(t):
    fun(k):
      match stack(t, k)
      | PairList [_, & rest]:
          if rest == PairList [] | t.bindings.remove(k) | (t.bindings[k] := rest)
      | _: #void
  fun fold(f):
    fun(t):
      fun(start):
        let all = hashtbl_bindings(t)
        let newest_first = sort(fun([n1, _]): fun([n2, _]): n1 >= n2)(all)
        rev_itlist(fun([_, [k, v]]): fun(a): f(k)(v)(a))(newest_first)(start)

fun hol_invalid_arg(s): (throw InvalidArgument(s))

def max_int = 4611686018427387903
fun float_sqrt(x): math.sqrt(x)
fun floor(x): Primitive.#{exact->inexact}(math.floor(x))
fun log(x): Primitive.log(x)
fun hol_print_endline(s): println(s)
fun print_goal([_assumptions, g]): println(string_of_term(g))

fun numdom(x): [Primitive.numerator(x), Primitive.denominator(x)]
fun gcd_num(x): fun(y): Primitive.gcd(x,y)
def std_formatter = #void
fun pp_close_box(_fmt): fun(): #void
fun pp_open_box(_fmt): fun(_indent): #void
fun pp_open_vbox(_fmt): fun(_indent): #void
fun pp_print_char(_fmt): fun(c): print(c)
fun pp_print_cut(_fmt): fun(): #void
fun pp_print_int(_fmt): fun(n): print(to_string(n))
fun pp_print_newline(_fmt): fun(): println("")
fun pp_print_space(_fmt): fun(): print(" ")
fun pp_print_term(_fmt): fun(t): print(string_of_term(t))
fun print_term(t): print(string_of_term(t))
import: lib("racket/port.rkt") as HostPort
fun print_to_string(f): fun(x): HostPort.#{with-output-to-string}(fun(): f(#void)(x))

fun hol_char_chr(n):
  if n<0 || n>255 | hol_invalid_arg("Char.chr") | Primitive.string(Primitive.#{integer->char}(n))

fun hol_array_of_list(l): Array(& l)
fun hol_array_map(f):
  fun(a):
    let out=Array.make(a.length(),#void)
    for (i in 0 .. a.length()):
      out[i] := f(a[i])
    out
fun hol_string_escaped(s):
  fun escape(c):
    match c
    | "\\": "\\\\"
    | "\"": "\\\""
    | "\n": "\\n"
    | "\t": "\\t"
    | "\r": "\\r"
    | "\b": "\\b"
    | _:
        let n=hol_char_code(c)
        if n<32 || n>126
        | "\\" +& (if n<100 | "0" | "") +& (if n<10 | "0" | "") +& to_string(n)
        | c
  implode(map(escape)(explode(s)))

