fun hol_lt(x): fun(y): hol_compare(x)(y) < 0
fun hol_gt(x): fun(y): hol_compare(x)(y) > 0
fun hol_le(x): fun(y): hol_compare(x)(y) <= 0
fun hol_ge(x): fun(y): hol_compare(x)(y) >= 0
fun hol_max(x): fun(y): if x>y | x | y
fun hol_min(x): fun(y): if x<y | x | y
fun hol_ignore(_): #void
fun hol_apply_unit(f):
  if f is_a Function.of_arity(0) | f() | f(#void)
fun hol_incr(b): b.value := b.value+1
fun hol_decr(b): b.value := b.value-1
fun hol_int_of_string(s):
  let n = s.to_int()
  if n | n | failwith("int_of_string")
fun hol_string_length(s): s.length()
fun hol_string_get(s): fun(n): to_string(s[n])
fun hol_range(m):
  fun(n):
    if m>n | PairList [] | PairList.cons(m,hol_range(m+1)(n))
fun ref_get(b): b.value
fun ref_set(b): fun(v): b.value := v
fun F_F(f): fun(g): fun([x, y]): [f(x), g(y)]
fun rev(l): rev_itlist(fun(x): fun(a): PairList.cons(x,a))(l)(PairList [])
fun check(p): fun(x): if p(x) | x | failwith("check")
fun funpow(n): fun(f): fun(x): if n<1 | x | funpow(n-1)(f)(f(x))
fun repeat(f):
  fun(x):
    try:
      repeat(f)(f(x))
      ~catch Failure(_): x
fun map2(f):
  fun(l1):
    fun(l2):
      match [l1, l2]
      | [PairList [], PairList []]: PairList []
      | [PairList [h1,&t1], PairList [h2,&t2]]: PairList.cons(f(h1)(h2),map2(f)(t1)(t2))
      | _: failwith("map2")
fun chop_list(n):
  fun(l):
    if n==0
    | [PairList [], l]
    | let [m, t] = chop_list(n-1)(tl(l))
      [PairList.cons(hd(l),m), t]
fun shareout(pat):
  fun(all):
    match pat
    | PairList []: (if all==PairList [] | PairList [] | failwith("shareout"))
    | PairList [h,&t]:
        let [l, r] = chop_list(length(h))(all)
        PairList.cons(l,shareout(t)(r))
fun intersect(l1): fun(l2): filter(fun(x): mem(x)(l2))(l1)
fun union_prime(eq):
  fun(l1):
    fun(l2):
      itlist(fun(x): fun(l): if exists(eq(x))(l) | l | PairList.cons(x,l))(l1)(l2)
fun setify(l):
  fun uniq(xs):
    match xs
    | PairList [x,y,&t]: (if x==y | uniq(PairList.cons(y,t)) | PairList.cons(x,uniq(PairList.cons(y,t))))
    | _: xs
  uniq(sort(fun(x): fun(y): hol_compare(x)(y)<=0)(l))
fun warn(c): fun(s): if c | println("Warning: "+&s) | #void
fun name_of(tm):
  try:
    fst(dest_const(tm))
    ~catch Failure(_): fst(dest_var(tm))
// Diagnostic rendering only; HOL's printer is outside the runtime engine.
fun string_of_term(tm):
  match tm
  | Var(s,_): s
  | Const(s,_): s
  | Comb(f,x): "(" +& string_of_term(f) +& " " +& string_of_term(x) +& ")"
  | Abs(v,b): "(lambda " +& string_of_term(v) +& ". " +& string_of_term(b) +& ")"

fun abs(n): math.abs(n)
fun hol_compare(x):
  fun(y):
    if x === y | 0 | hol_compare_distinct(x)(y)
fun hol_compare_distinct(x):
  fun(y):
    match [x, y]
    | [PairList [h,&t], PairList [h1,&t1]]:
        let c=hol_compare(h)(h1)
        if c==0 | hol_compare(t)(t1) | c
    | [[a, b], [c, d]]:
        let n=hol_compare(a)(c)
        if n==0 | hol_compare(b)(d) | n
    | [[h,&t], [h1,&t1]]:
        let c=hol_compare(h)(h1)
        if c==0 | hol_compare(t)(t1) | c
    | [a :: HolVariant, b :: HolVariant]: hol_compare(a.port_view())(b.port_view())
    | [a :: Theorem, b :: Theorem]: hol_compare(dest_thm(a))(dest_thm(b))
    | _: compare(x)(y)

// The original tactic-pattern parser combinators; tokens are not HOL terms.
class Ident(name):
  extends HolVariant
  override port_view(): [0, PairList [this.name]]
class Resword(name):
  extends HolVariant
  override port_view(): [1, PairList [this.name]]
class Noparse()
fun parser_choice(p):
  fun(q):
    fun(inp):
      try:
        p(inp)
        ~catch Noparse(): q(inp)
fun parser_sequence(p):
  fun(q):
    fun(inp):
      let [a, r]=p(inp)
      let [b, s]=q(r)
      [[a, b], s]
fun parser_map(p):
  fun(f):
    fun(inp):
      let [a, r]=p(inp)
      [f(a), r]
fun many(p):
  fun(inp):
    try:
      let [a, r]=p(inp)
      let [xs, s]=many(p)(r)
      [PairList.cons(a,xs), s]
      ~catch Noparse(): [PairList [], inp]
fun possibly(p):
  fun(inp):
    try:
      let [a, r]=p(inp)
      [PairList [a], r]
      ~catch Noparse(): [PairList [], inp]
fun some(p):
  fun(inp):
    match inp
    | PairList [h,&t]: (if p(h) | [h, t] | throw Noparse())
    | _: throw Noparse()
fun a(tok): some(fun(t): t==tok)
fun fix(err):
  fun(p):
    fun(inp):
      try:
        p(inp)
        ~catch Noparse(): failwith(err+&" expected")
fun atleast(n):
  fun(p):
    if n<=0
    | many(p)
    | parser_map(parser_sequence(p)(atleast(n-1)(p)))(fun([h, t]): PairList.cons(h,t))
fun listof(p):
  fun(sep):
    fun(err):
      parser_map(parser_sequence(p)(many(parser_map(parser_sequence(sep)(fix(err)(p)))(snd))))(fun([h, t]): PairList.cons(h,t))
fun elistof(p): fun(sep): fun(err): parser_choice(listof(p)(sep)(err))(fun(inp): [PairList [], inp])
def alpha_chars = "'abcdefghijklmnopqrstuvwxyz_ABCDEFGHIJKLMNOPQRSTUVWXYZ"
def num_chars = "0123456789"
def symbol_chars = "\\!@#$%^&*-+|\\<=>/?~.:"
fun isalpha(c): c.length()>0 && alpha_chars.contains(to_string(c[0]))
fun isalnum(c): c.length()>0 && (isalpha(c) || num_chars.contains(to_string(c[0])))
def reserved_pattern_words = PairList ["(",")","[","]","{","}",":",";",".","|","let","in","and","if","then","else","match","with","function","->","when"]
fun lex(chars):
  fun take(p,xs,acc):
    match xs
    | PairList [h,&t]: (if p(h) | take(p,t,PairList.cons(h,acc)) | [implode(rev(acc)), xs])
    | _: [implode(rev(acc)), xs]
  fun scan(xs):
    match xs
    | PairList []: PairList []
    | PairList [h,&t]:
        cond
        | " \t\n\r".contains(h): scan(t)
        | "()[]{};,".contains(h): PairList.cons(Resword(h),scan(t))
        | ~else:
            let pred = if isalnum(h) | isalnum | (fun(c): symbol_chars.contains(c))
            let [s, r]=take(pred,t,PairList [h])
            let tok = if mem(s)(reserved_pattern_words) | Resword(s) | Ident(s)
            PairList.cons(tok,scan(r))
  scan(chars)
// Literal quotations have already been expanded; retain binder metadata.
def mutable theory_binders = PairList []
fun parse_as_binder(s): theory_binders := insert(s)(theory_binders)
fun unparse_as_binder(s): theory_binders := subtract(theory_binders)(PairList [s])
def mutable theory_infixes = PairList []
def mutable theory_prefixes = PairList []
def mutable theory_interface = PairList []
fun parse_as_infix([s, d]):
  theory_infixes := PairList.cons([s, d],filter(fun([n, _]): n!=s)(theory_infixes))
fun parse_as_prefix(s): theory_prefixes := insert(s)(theory_prefixes)
fun remove_interface(s): theory_interface := filter(fun([n, _]): n!=s)(theory_interface)
fun override_interface([s, tm]):
  remove_interface(s)
  theory_interface := PairList.cons([s, tm],theory_interface)
fun do_list(f):
  fun(l):
    match l
    | PairList []: #void
    | PairList [h,&t]:
        f(h)
        do_list(f)(t)
fun hol_print_string(s): print(s)
fun hol_print_newline(): println("")
fun hol_print_flush(): #void
fun forall2(p):
  fun forallp(l1):
    fun(l2):
      match [l1, l2]
      | [PairList [], PairList []]: #true
      | [PairList [h1,&t1], PairList [h2,&t2]]: p(h1)(h2) && forallp(t1)(t2)
      | _: failwith("forall2")
  forallp
fun lib_last(l):
  match l
  | PairList [x, & PairList []]: x
  | PairList [h, & t]: lib_last(t)
  | PairList []: failwith("last")

def last = lib_last

fun lib_butlast(l):
  match l
  | PairList [_, & PairList []]: PairList []
  | PairList [h, & t]: PairList [h, & lib_butlast(t)]
  | PairList []: failwith("butlast")

def butlast = lib_butlast

fun lib_el(n): fun(l): (if (n == 0) | hd(l) | lib_el((n - 1))(tl(l)))

def el = lib_el

fun lib_mapi(f):
  fun(xs):
    // This recursive local helper needs a definition for self-reference.
    fun aux(i):
      fun(f):
        fun(xs):
          match xs
          | PairList []: PairList []
          | PairList [h, & tl]: PairList [f(i)(h), & aux((i + 1))(f)(tl)]
    aux(0)(f)(xs)

def mapi = lib_mapi

fun lib_rev_itlist2(f):
  fun(l1):
    fun(l2):
      fun(b):
        match [l1, l2]
        | [PairList [], PairList []]: b
        | [PairList [h1, & t1], PairList [h2, & t2]]: lib_rev_itlist2(f)(t1)(t2)(f(h1)(h2)(b))
        | _: failwith("rev_itlist2")

def rev_itlist2 = lib_rev_itlist2

fun lib_flat(l): itlist(append)(l)(PairList [])

def flat = lib_flat

fun lib_remove(p):
  fun(l):
    match l
    | PairList []: failwith("remove")
    | PairList [h, & t]:
        if p(h)
        | [h, t]
        | let [y, n] = lib_remove(p)(t)
          [y, PairList [h, & n]]

def remove = lib_remove

fun lib_find_index(p):
  fun ind(n):
    fun(l):
      match l
      | PairList []: None()
      | PairList [h, & t]: (if p(h) | Some(n) | ind((n + 1))(t))
  ind(0)
def find_index = lib_find_index

fun lib_index(x):
  fun(l):
    match find_index(o(fun (c): 0 == c)(hol_compare(x)))(l)
    | Some(n): n
    | None(): failwith("index")

def index = lib_index

fun lib_unions(l): itlist(union)(l)(PairList [])

def unions = lib_unions

fun lib_set_eq(l1): fun(l2): (subset(l1)(l2) && subset(l2)(l1))

def set_eq = lib_set_eq

fun lib_uniq(l):
  match l
  | PairList [x, & PairList [y, & _] as t]:
      let t_prime = lib_uniq(t)
      if (hol_compare(x)(y) == 0)
      | t_prime
      | (if (t_prime === t) | l | PairList [x, & t_prime])
  | _: l

def uniq = lib_uniq

def lib_gcd:
  // This recursive local helper needs a definition for self-reference.
  fun gxd(x): fun(y): (if (y == 0) | x | gxd(y)((x rem y)))
  fun(x):
    fun(y):
      let x_prime_2 = abs(x)
      let y_prime_2 = abs(y)
      (if hol_lt(x_prime_2)(y_prime_2) | gxd(y_prime_2)(x_prime_2) | gxd(x_prime_2)(y_prime_2))

def gcd = lib_gcd

fun lib_allpairs(f):
  fun(l1):
    fun(l2):
      match l1
      | PairList [h1, & t1]: itlist(fun(x): fun(a): PairList [f(h1)(x), & a])(l2)(lib_allpairs(f)(t1)(l2))
      | PairList []: PairList []

def allpairs = lib_allpairs

fun lib_assocd(a):
  fun(l):
    fun(d):
      match l
      | PairList []: d
      | PairList [[x, y], & t]: (if (hol_compare(x)(a) == 0) | y | lib_assocd(a)(t)(d))

def assocd = lib_assocd

fun lib_merge(ord):
  fun(l1):
    fun(l2):
      match l1
      | PairList []: l2
      | PairList [h1, & t1]:
          match l2
          | PairList []: l1
          | PairList [h2, & t2]: (if ord(h1)(h2) | PairList [h1, & lib_merge(ord)(t1)(l2)] | PairList [h2, & lib_merge(ord)(l1)(t2)])

def merge = lib_merge

fun lib_mergesort(ord):
  fun mergepairs(l1):
    fun(l2):
      match [l1, l2]
      | [PairList [s, & PairList []], PairList []]: s
      | [l, PairList []]: mergepairs(PairList [])(l)
      | [l, PairList [s1, & PairList []]]: mergepairs(PairList [s1, & l])(PairList [])
      | [l, PairList [s1, & PairList [s2, & ss]]]: mergepairs(PairList [merge(ord)(s1)(s2), & l])(ss)
  (fun(l): (if (l == (PairList [])) | PairList [] | mergepairs(PairList [])(map((fun(x): PairList [x]))(l))))
def mergesort = lib_mergesort

fun hol_lsr(x): fun(y): x bits.(>>) y
fun hol_rat_div(x): fun(y): x/y
fun hol_int_of_num(n): if n==math.truncate(n) | n | failwith("int_of_num")
fun hol_char_code(s): Char.to_int(s[0])
fun num(n): n
def num_0 = 0
def num_1 = 1
def num_2 = 2
def num_10 = 10
fun pow2(n): 2 ** n
fun quo_num(x): fun(y): math.truncate(x/y)
fun mod_num(x): fun(y): x-y*math.truncate(x/y)
fun power_num(x): fun(y): x ** y
fun minus_num(x): -x
def abs_num = abs
def verbose = Box(#true)
fun report(s): println(s)
fun unions_prime(eq): fun(l): itlist(union_prime(eq))(l)(PairList [])
fun hol_string_concat(sep):
  fun(l):
    match l
    | PairList []: ""
    | PairList [h,&t]: h +& itlist(fun(x): fun(y): sep +& x +& y)(t)("")
// The unqualified lib.ml versions, visible below despite the OCamlList names.
def list_rev = rev
def list_exists = exists
def list_hd = hd
def list_mem = mem
namespace OCamlList:
  export:
    map
    rev
    length
    concat
    exists
    filter
    find
    fold_left
    fold_right
    for_all
    hd
    iter
    mem
    mem_assoc
    nth
    partition
    rev_append
    sort
    map2
    for_all2
    fold_left2
    fold_right2
    mapi
    rev_map
    assoc
    concat_map
    filter_map
  fun map(f):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let v=f(h)
          PairList.cons(v,map(f)(t))
  def rev = list_rev
  def length = (fun(l): itlist(fun(_): fun(n): n+1)(l)(0))
  def concat = flat
  def exists = list_exists
  fun filter(p):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let keep=p(h)
          let rest=filter(p)(t)
          if keep | PairList.cons(h,rest) | rest
  fun find(p):
    fun(l):
      match l
      | PairList []: (throw Not_found())
      | PairList [h,&t]: (if p(h) | h | find(p)(t))
  fun fold_left(f): fun(a): fun(l): rev_itlist(C(f))(l)(a)
  fun fold_right(f): fun(l): fun(a): itlist(f)(l)(a)
  def for_all = forall
  def hd = list_hd
  def iter = do_list
  def mem = list_mem
  fun mem_assoc(x): fun(l): exists(fun([y, _]): x==y)(l)
  def nth = C(el)
  fun partition(p):
    fun(l):
      match l
      | PairList []: [PairList [], PairList []]
      | PairList [h,&t]:
          let keep=p(h)
          let [yes, no]=partition(p)(t)
          if keep | [PairList.cons(h,yes), no] | [yes, PairList.cons(h,no)]
  fun rev_append(l1): fun(l2): append(rev(l1))(l2)
  fun sort(cmp): fun(l): mergesort(fun(x): fun(y): cmp(x)(y)<=0)(l)
  fun map2(f):
    fun(l1):
      fun(l2):
        match [l1, l2]
        | [PairList [], PairList []]: PairList []
        | [PairList [x,&xs], PairList [y,&ys]]:
            let z=f(x)(y)
            PairList.cons(z,map2(f)(xs)(ys))
        | _: (throw InvalidArgument("List.map2"))
  fun assoc(x):
    fun(l):
      match l
      | PairList []: (throw Not_found())
      | PairList [[y, v],&t]: (if x==y | v | assoc(x)(t))
  fun concat_map(f): fun(l): concat(map(f)(l))
  fun filter_map(f):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let v=f(h)
          match v
          | None(): filter_map(f)(t)
          | Some(x): PairList.cons(x,filter_map(f)(t))

  fun fold_left2(f):
    fun(a):
      fun(l1):
        fun(l2):
          match [l1, l2]
          | [PairList [], PairList []]: a
          | [PairList [x,&xs], PairList [y,&ys]]: fold_left2(f)(f(a)(x)(y))(xs)(ys)
          | _: (throw InvalidArgument("List.fold_left2"))
  fun fold_right2(f):
    fun(l1):
      fun(l2):
        fun(a):
          match [l1, l2]
          | [PairList [], PairList []]: a
          | [PairList [x,&xs], PairList [y,&ys]]: f(x)(y)(fold_right2(f)(xs)(ys)(a))
          | _: (throw InvalidArgument("List.fold_right2"))
  fun mapi(f):
    fun(l):
      fun go(i,rest):
        match rest
        | PairList []: PairList []
        | PairList [h,&t]:
            let v=f(i)(h)
            PairList.cons(v,go(i+1,t))
      go(0,l)
  fun rev_map(f): fun(l): rev_itlist(fun(x): fun(a): PairList.cons(f(x),a))(l)(PairList [])

  fun for_all2(p):
    fun(l1):
      fun(l2):
        match [l1, l2]
        | [PairList [], PairList []]: #true
        | [PairList [x,&xs], PairList [y,&ys]]: p(x)(y) && for_all2(p)(xs)(ys)
        | _: (throw InvalidArgument("List.for_all2"))


import: lib("racket/base.rkt") as Primitive
fun hol_array_make(n): fun(v): Array.make(n,v)
fun hol_array_get(a): fun(i): a[i]
fun hol_array_set(a): fun(i): fun(v): (a[i] := v)
fun hol_array_fold_left(f):
  fun(start):
    fun(a):
      fun fold(i,acc):
        if i==a.length() | acc | fold(i+1,f(acc)(a[i]))
      fold(0,start)
fun hol_string_make(n): fun(c): Primitive.#{make-string}(n,Primitive.#{string-ref}(c,0))
fun hol_string_sub(s): fun(i): fun(n): Primitive.substring(s,i,i+n)
def hol_std_formatter = #void
fun hol_printf(fmt):
  fun emit(i,acc):
    if i>=fmt.length()
    | print(acc)
    | let c=to_string(fmt[i])
      cond
      | c!="%": emit(i+1,acc +& c)
      | i+1>=fmt.length(): print(acc +& "%")
      | ~else:
          let code=to_string(fmt[i+1])
          cond
          | code=="%": emit(i+2,acc +& "%")
          | code=="!": emit(i+2,acc)
          | code=="a": (fun(_p): fun(v): emit(i+2,acc +& to_string(v)))
          | ~else: (fun(v): emit(i+2,acc +& to_string(v)))
  emit(0,"")
fun hol_fprintf(_formatter): hol_printf
