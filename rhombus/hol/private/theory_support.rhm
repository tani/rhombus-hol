fun lib_uniq(l):«
  (block:«
    let port_tmp_9 = l;
    match port_tmp_9
    | PairList [x, & PairList [y, & _] as t]:«
        (block:«
          let t_prime:«
            lib_uniq(t)
          »;
          (block:«
            if hol_equal(hol_compare(x)(y))(0)
            | t_prime
            | (block:«
              if hol_physical_equal(t_prime)(t)
              | l
              | PairList.cons(x,t_prime)
            »)
          »)
        »)
    »
    | _:«
        l
    »
  »)
»
