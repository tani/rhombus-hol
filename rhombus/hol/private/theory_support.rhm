namespace OCamlList:
  export:
    map
    rev
    length
    concat
    exists
    filter
    find
    fold_left
    fold_right
    for_all
    hd
    iter
    mem
    mem_assoc
    nth
    partition
    rev_append
    sort
    map2
    for_all2
    fold_left2
    fold_right2
    mapi
    rev_map
    assoc
    concat_map
    filter_map
  fun map(f):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let v=f(h)
          PairList.cons(v,map(f)(t))
  def rev = (fun(l): rev_itlist(fun(x): fun(t): PairList.cons(x,t))(l)(PairList []))
  def length = (fun(l): itlist(fun(_): fun(n): n+1)(l)(0))
  def concat = flat
  def exists = (fun(p): fun(l): !forall(fun(x): !p(x))(l))
  fun filter(p):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let keep=p(h)
          let rest=filter(p)(t)
          if keep | PairList.cons(h,rest) | rest
  fun find(p):
    fun(l):
      match l
      | PairList []: hol_raise(Not_found())
      | PairList [h,&t]: (if p(h) | h | find(p)(t))
  fun fold_left(f): fun(a): fun(l): rev_itlist(C(f))(l)(a)
  fun fold_right(f): fun(l): fun(a): itlist(f)(l)(a)
  def for_all = forall
  fun hd(l): match l | PairList [h,&_]: h | _: failwith("hd")
  def iter = do_list
  fun mem(x): fun(l): exists(fun(y): x==y)(l)
  fun mem_assoc(x): fun(l): exists(fun(Pair(y,_)): x==y)(l)
  def nth = C(el)
  fun partition(p):
    fun(l):
      match l
      | PairList []: Pair(PairList [],PairList [])
      | PairList [h,&t]:
          let keep=p(h)
          let Pair(yes,no)=partition(p)(t)
          if keep | Pair(PairList.cons(h,yes),no) | Pair(yes,PairList.cons(h,no))
  fun rev_append(l1): fun(l2): append(rev(l1))(l2)
  fun sort(cmp): fun(l): mergesort(fun(x): fun(y): cmp(x)(y)<=0)(l)
  fun map2(f):
    fun(l1):
      fun(l2):
        match Pair(l1,l2)
        | Pair(PairList [],PairList []): PairList []
        | Pair(PairList [x,&xs],PairList [y,&ys]):
            let z=f(x)(y)
            PairList.cons(z,map2(f)(xs)(ys))
        | _: hol_raise(InvalidArgument("List.map2"))
  fun assoc(x):
    fun(l):
      match l
      | PairList []: hol_raise(Not_found())
      | PairList [Pair(y,v),&t]: (if x==y | v | assoc(x)(t))
  fun concat_map(f): fun(l): concat(map(f)(l))
  fun filter_map(f):
    fun(l):
      match l
      | PairList []: PairList []
      | PairList [h,&t]:
          let v=f(h)
          match v
          | None(): filter_map(f)(t)
          | Some(x): PairList.cons(x,filter_map(f)(t))

  fun fold_left2(f):
    fun(a):
      fun(l1):
        fun(l2):
          match Pair(l1,l2)
          | Pair(PairList [],PairList []): a
          | Pair(PairList [x,&xs],PairList [y,&ys]): fold_left2(f)(f(a)(x)(y))(xs)(ys)
          | _: hol_raise(InvalidArgument("List.fold_left2"))
  fun fold_right2(f):
    fun(l1):
      fun(l2):
        fun(a):
          match Pair(l1,l2)
          | Pair(PairList [],PairList []): a
          | Pair(PairList [x,&xs],PairList [y,&ys]): f(x)(y)(fold_right2(f)(xs)(ys)(a))
          | _: hol_raise(InvalidArgument("List.fold_right2"))
  fun mapi(f):
    fun(l):
      fun go(i,rest):
        match rest
        | PairList []: PairList []
        | PairList [h,&t]:
            let v=f(i)(h)
            PairList.cons(v,go(i+1,t))
      go(0,l)
  fun rev_map(f):
    fun(l): rev_itlist(fun(x): fun(a): PairList.cons(f(x),a))(l)(PairList [])

  fun for_all2(p):
    fun(l1):
      fun(l2):
        match Pair(l1,l2)
        | Pair(PairList [],PairList []): #true
        | Pair(PairList [x,&xs],PairList [y,&ys]): p(x)(y) && for_all2(p)(xs)(ys)
        | _: hol_raise(InvalidArgument("List.for_all2"))

