fun hol_not(x): !x
fun hol_equal(x): fun(y): x == y
fun hol_unequal(x): fun(y): x != y
fun hol_physical_equal(x): fun(y): x === y
fun hol_physical_unequal(x): fun(y): !(x === y)
fun hol_add(x): fun(y): x+y
fun hol_sub(x): fun(y): x-y
fun hol_mul(x): fun(y): x*y
fun hol_div(x): fun(y): math.truncate(x/y)
fun hol_mod(x): fun(y): (x rem y)
fun hol_neg(x): -x
fun hol_lt(x): fun(y): hol_compare(x)(y) < 0
fun hol_gt(x): fun(y): hol_compare(x)(y) > 0
fun hol_le(x): fun(y): hol_compare(x)(y) <= 0
fun hol_ge(x): fun(y): hol_compare(x)(y) >= 0
fun hol_concat(x): fun(y): x +& y
fun hol_raise(x): throw x
fun hol_max(x): fun(y): if x>y | x | y
fun hol_min(x): fun(y): if x<y | x | y
fun hol_ignore(_): #void
fun hol_apply_unit(f):
  if f is_a Function.of_arity(0) | f() | f(#void)
fun hol_incr(b): b.value := b.value+1
fun hol_decr(b): b.value := b.value-1
fun hol_int_of_string(s):
  let n = s.to_int()
  if n | n | failwith("int_of_string")
fun hol_string_of_int(n): to_string(n)
fun hol_string_length(s): s.length()
fun hol_string_get(s): fun(n): to_string(s[n])
fun hol_range(m):
  fun(n):
    if m>n | PairList [] | PairList.cons(m,hol_range(m+1)(n))
fun ref_get(b): b.value
fun ref_set(b): fun(v): b.value := v
fun F_F(f): fun(g): fun(Pair(x,y)): Pair(f(x),g(y))
fun rev(l): rev_itlist(fun(x): fun(a): PairList.cons(x,a))(l)(PairList [])
fun check(p): fun(x): if p(x) | x | failwith("check")
fun funpow(n): fun(f): fun(x): if n<1 | x | funpow(n-1)(f)(f(x))
fun repeat(f):
  fun(x):
    try:
      repeat(f)(f(x))
      ~catch Failure(_): x
fun map2(f):
  fun(l1):
    fun(l2):
      match Pair(l1,l2)
      | Pair(PairList [],PairList []): PairList []
      | Pair(PairList [h1,&t1],PairList [h2,&t2]): PairList.cons(f(h1)(h2),map2(f)(t1)(t2))
      | _: failwith("map2")
fun chop_list(n):
  fun(l):
    if n==0
    | Pair(PairList [],l)
    | block:
        let Pair(m,t) = chop_list(n-1)(tl(l))
        Pair(PairList.cons(hd(l),m),t)
fun shareout(pat):
  fun(all):
    match pat
    | PairList []: (if all==PairList [] | PairList [] | failwith("shareout"))
    | PairList [h,&t]:
        let Pair(l,r) = chop_list(length(h))(all)
        PairList.cons(l,shareout(t)(r))
fun intersect(l1): fun(l2): filter(fun(x): mem(x)(l2))(l1)
fun union_prime(eq):
  fun(l1):
    fun(l2):
      itlist(fun(x): fun(l): if exists(eq(x))(l) | l | PairList.cons(x,l))(l1)(l2)
fun setify(l):
  fun uniq(xs):
    match xs
    | PairList [x,y,&t]: (if x==y | uniq(PairList.cons(y,t)) | PairList.cons(x,uniq(PairList.cons(y,t))))
    | _: xs
  uniq(sort(fun(x): fun(y): hol_compare(x)(y)<=0)(l))
fun warn(c): fun(s): if c | println("Warning: "+&s) | #void
fun name_of(tm):
  try:
    fst(dest_const(tm))
    ~catch Failure(_): fst(dest_var(tm))
// Diagnostic rendering only; HOL's printer is outside the runtime engine.
fun string_of_term(tm):
  match tm
  | Var(s,_): s
  | Const(s,_): s
  | Comb(f,x): "(" +& string_of_term(f) +& " " +& string_of_term(x) +& ")"
  | Abs(v,b): "(lambda " +& string_of_term(v) +& ". " +& string_of_term(b) +& ")"

fun abs(n): math.abs(n)
fun hol_compare(x):
  fun(y):
    if x === y | 0 | hol_compare_distinct(x)(y)
fun hol_compare_distinct(x):
  fun(y):
    match Pair(x,y)
    | Pair(PairList [h,&t],PairList [h1,&t1]):
        let c=hol_compare(h)(h1)
        if c==0 | hol_compare(t)(t1) | c
    | Pair(Pair(a,b),Pair(c,d)):
        let n=hol_compare(a)(c)
        if n==0 | hol_compare(b)(d) | n
    | Pair(a :: HolVariant,b :: HolVariant): hol_compare(a.port_view())(b.port_view())
    | Pair(a :: Map,b :: Map):
        let order=a["port_record_order"]
        hol_compare(map(fun(k): a[k])(order))(map(fun(k): b[k])(order))
    | Pair(a :: Theorem,b :: Theorem): hol_compare(dest_thm(a))(dest_thm(b))
    | _: compare(x)(y)

// The original tactic-pattern parser combinators; tokens are not HOL terms.
class Ident(name):
  extends HolVariant
  override port_view(): Pair(0,PairList [this.name])
class Resword(name):
  extends HolVariant
  override port_view(): Pair(1,PairList [this.name])
class Noparse()
fun parser_choice(p):
  fun(q):
    fun(inp):
      try:
        p(inp)
        ~catch Noparse(): q(inp)
fun parser_sequence(p):
  fun(q):
    fun(inp):
      let Pair(a,r)=p(inp)
      let Pair(b,s)=q(r)
      Pair(Pair(a,b),s)
fun parser_map(p):
  fun(f):
    fun(inp):
      let Pair(a,r)=p(inp)
      Pair(f(a),r)
fun many(p):
  fun(inp):
    try:
      let Pair(a,r)=p(inp)
      let Pair(xs,s)=many(p)(r)
      Pair(PairList.cons(a,xs),s)
      ~catch Noparse(): Pair(PairList [],inp)
fun possibly(p):
  fun(inp):
    try:
      let Pair(a,r)=p(inp)
      Pair(PairList [a],r)
      ~catch Noparse(): Pair(PairList [],inp)
fun some(p):
  fun(inp):
    match inp
    | PairList [h,&t]: (if p(h) | Pair(h,t) | throw Noparse())
    | _: throw Noparse()
fun a(tok): some(fun(t): t==tok)
fun fix(err):
  fun(p):
    fun(inp):
      try:
        p(inp)
        ~catch Noparse(): failwith(err+&" expected")
fun atleast(n):
  fun(p):
    if n<=0
    | many(p)
    | parser_map(parser_sequence(p)(atleast(n-1)(p)))(fun(Pair(h,t)): PairList.cons(h,t))
fun listof(p):
  fun(sep):
    fun(err):
      parser_map(parser_sequence(p)(many(parser_map(parser_sequence(sep)(fix(err)(p)))(snd))))(fun(Pair(h,t)): PairList.cons(h,t))
fun elistof(p): fun(sep): fun(err): parser_choice(listof(p)(sep)(err))(fun(inp): Pair(PairList [],inp))
def alpha_chars = "'abcdefghijklmnopqrstuvwxyz_ABCDEFGHIJKLMNOPQRSTUVWXYZ"
def num_chars = "0123456789"
def symbol_chars = "\\!@#$%^&*-+|\\<=>/?~.:"
fun isalpha(c): c.length()>0 && alpha_chars.contains(to_string(c[0]))
fun isalnum(c): c.length()>0 && (isalpha(c) || num_chars.contains(to_string(c[0])))
def reserved_pattern_words = PairList ["(",")","[","]","{","}",":",";",".","|","let","in","and","if","then","else","match","with","function","->","when"]
fun lex(chars):
  fun take(p,xs,acc):
    match xs
    | PairList [h,&t]: (if p(h) | take(p,t,PairList.cons(h,acc)) | Pair(implode(rev(acc)),xs))
    | _: Pair(implode(rev(acc)),xs)
  fun scan(xs):
    match xs
    | PairList []: PairList []
    | PairList [h,&t]:
        cond
        | " \t\n\r".contains(h): scan(t)
        | "()[]{};,".contains(h): PairList.cons(Resword(h),scan(t))
        | ~else:
            let pred = if isalnum(h) | isalnum | (fun(c): symbol_chars.contains(c))
            let Pair(s,r)=take(pred,t,PairList [h])
            let tok = if mem(s)(reserved_pattern_words) | Resword(s) | Ident(s)
            PairList.cons(tok,scan(r))
  scan(chars)
// Literal quotations have already been expanded; retain binder metadata.
def mutable theory_binders = PairList []
fun parse_as_binder(s): theory_binders := insert(s)(theory_binders)
fun unparse_as_binder(s): theory_binders := subtract(theory_binders)(PairList [s])
def mutable theory_infixes = PairList []
def mutable theory_prefixes = PairList []
def mutable theory_interface = PairList []
fun parse_as_infix(Pair(s,d)):
  theory_infixes := PairList.cons(Pair(s,d),filter(fun(Pair(n,_)): n!=s)(theory_infixes))
fun parse_as_prefix(s): theory_prefixes := insert(s)(theory_prefixes)
fun remove_interface(s): theory_interface := filter(fun(Pair(n,_)): n!=s)(theory_interface)
fun override_interface(Pair(s,tm)):
  remove_interface(s)
  theory_interface := PairList.cons(Pair(s,tm),theory_interface)
fun do_list(f):
  fun(l):
    match l
    | PairList []: #void
    | PairList [h,&t]:
        f(h)
        do_list(f)(t)
fun hol_print_string(s): print(s)
fun hol_print_newline(): println("")
fun hol_print_flush(): #void
fun forall2(p):
  fun forallp(l1):
    fun(l2):
      match Pair(l1,l2)
      | Pair(PairList [],PairList []): #true
      | Pair(PairList [h1,&t1],PairList [h2,&t2]): p(h1)(h2) && forallp(t1)(t2)
      | _: failwith("forall2")
  forallp

