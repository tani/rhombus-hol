def lib_num_of_string:«
  (block:«
    let hol_values:«
      PairList.cons(Pair("0",0),PairList.cons(Pair("1",1),PairList.cons(Pair("2",2),PairList.cons(Pair("3",3),PairList.cons(Pair("4",4),PairList.cons(Pair("5",5),PairList.cons(Pair("6",6),PairList.cons(Pair("7",7),PairList.cons(Pair("8",8),PairList.cons(Pair("9",9),PairList.cons(Pair("a",10),PairList.cons(Pair("A",10),PairList.cons(Pair("b",11),PairList.cons(Pair("B",11),PairList.cons(Pair("c",12),PairList.cons(Pair("C",12),PairList.cons(Pair("d",13),PairList.cons(Pair("D",13),PairList.cons(Pair("e",14),PairList.cons(Pair("E",14),PairList.cons(Pair("f",15),PairList.cons(Pair("F",15),PairList []))))))))))))))))))))))
    »;
    (block:«
      let valof:«
        (fun(b):«
          (fun(s):«
            (block:«
              let v:«
                num(assoc(s)(hol_values))
              »;
              (block:«
                if hol_lt(v)(b)
                | v
                | failwith("num_of_string: invalid digit for base")
              »)
            »)
          »)
        »)
      »;
      let two:«
        num_2
      »;
      let ten:«
        num_10
      »;
      let sixteen:«
        num(16)
      »;
      (block:«
        fun num_of_stringlist(b):«
          (fun(l):«
            (block:«
              let port_tmp_1 = l;
              match port_tmp_1
              | PairList []:«
                  failwith("num_of_string: no digits after base indicator")
              »
              | PairList [h, & PairList []]:«
                  valof(b)(h)
              »
              | PairList [h, & t]:«
                  hol_add(valof(b)(h))(hol_mul(b)(num_of_stringlist(b)(t)))
              »
            »)
          »)
        »;
        (fun(s):«
          (block:«
            let port_tmp_2 = explode(s);
            match port_tmp_2
            | PairList []:«
                failwith("num_of_string: no digits")
            »
            | PairList ["0", & PairList ["x", & hexdigits]]:«
                num_of_stringlist(sixteen)(rev(hexdigits))
            »
            | PairList ["0", & PairList ["b", & bindigits]]:«
                num_of_stringlist(two)(rev(bindigits))
            »
            | decdigits:«
                num_of_stringlist(ten)(rev(decdigits))
            »
          »)
        »)
      »)
    »)
  »)
»
