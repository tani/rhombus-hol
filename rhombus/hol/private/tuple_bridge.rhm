#lang rhombus/and_meta
// OCaml triples share one binding view with the core's named representations.
import: "data_types.rhm" as Data
import: "compat.rhm" open
import: "../drule.rhm" as Rules
import: "../tactics.rhm" as Tactics
export: triple3
export: coerce_instantiation
fun tuple_view(t :: (Data.HolTuple3 || Rules.Instantiation || Tactics.GoalState)):
  match t
  | Data.HolTuple3(_,_,_): t
  | Rules.Instantiation(a,b,c): Data.HolTuple3(a,b,c)
  | Tactics.GoalState(a,b,c): Data.HolTuple3(a,b,c)
export bind.macro 'Triple3($a, $b, $c)':
  '(Data.HolTuple3($a,$b,$c) :: converting(fun(t :: (Data.HolTuple3 || Rules.Instantiation || Tactics.GoalState)): tuple_view(t)))'
fun triple3(a,b,c):
  match a
  | Pair(_ :: PairList,_ :: Rules.Instantiation):
      if b is_a PairList && c is_a Function | Tactics.GoalState(a,b,c) | Data.HolTuple3(a,b,c)
  | _: Data.HolTuple3(a,b,c)
fun coerce_instantiation(i):
  match i
  | Rules.Instantiation(_,_,_): i
  | Data.HolTuple3(a,b,c): Rules.Instantiation(a,b,c)
  | _: failwith("instantiation triple expected")
// Keep the tuple view at higher-order calls into the core as well.
export: INSTANTIATE INSTANTIATE_ALL instantiate inst_goal compose_insts term_type_unify
fun INSTANTIATE(i): Rules.INSTANTIATE(coerce_instantiation(i))
fun INSTANTIATE_ALL(i): Rules.INSTANTIATE_ALL(coerce_instantiation(i))
fun instantiate(i): Rules.instantiate(coerce_instantiation(i))
fun inst_goal(i): Tactics.inst_goal(coerce_instantiation(i))
fun compose_insts(i): fun(j): Tactics.compose_insts(coerce_instantiation(i))(coerce_instantiation(j))
fun term_type_unify(x): fun(y): fun(i): Rules.term_type_unify(x)(y)(coerce_instantiation(i))
