                | PairList [[PtyconValue(f,fargs), PtyconValue(g,gargs), ptm], & oth]: (if (Host.hol_equal(f)(g) && Host.hol_equal(length(fargs))(length(gargs))) | unify_2(env)(append(Host.map2((fun(x): (fun(y): [x, y, ptm])))(fargs)(gargs))(oth)) | failwith(string_of_ty_error(env)(ptm)))
