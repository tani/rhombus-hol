curried fun preterm_make_overloadable(s, gty):
  if can(assoc(s))(Host.ref_get(Host.the_overload_skeletons))
  | (if Host.hol_equal(assoc(s)(Host.ref_get(Host.the_overload_skeletons)))(gty) | #void | failwith("make_overloadable: differs from existing skeleton"))
  | Host.ref_set(Host.the_overload_skeletons)(PairList [[s, gty], & Host.ref_get(Host.the_overload_skeletons)])

fun preterm_remove_interface(sym):
  let interface = filter(o(Host.hol_unequal(sym))(fst))(Host.ref_get(Host.the_interface))
  Host.ref_set(Host.the_interface)(interface)

fun preterm_reduce_interface([sym, tm]):
  let namty:
    try:
      dest_const(tm)
      ~catch exn:
        match exn
        | Failure(_): dest_var(tm)
        | exn: Host.hol_raise(exn)
  Host.ref_set(Host.the_interface)(filter(Host.hol_unequal([sym, namty]))(Host.ref_get(Host.the_interface)))

fun preterm_override_interface([sym, tm]):
  let namty:
    try:
      dest_const(tm)
      ~catch exn:
        match exn
        | Failure(_): dest_var(tm)
        | exn: Host.hol_raise(exn)
  let interface = filter(o(Host.hol_unequal(sym))(fst))(Host.ref_get(Host.the_interface))
  Host.ref_set(Host.the_interface)(PairList [[sym, namty], & interface])

fun preterm_overload_interface([sym, tm]):
  let gty:
    try:
      assoc(sym)(Host.ref_get(Host.the_overload_skeletons))
      ~catch exn:
        match exn
        | Failure(_): failwith(Host.hol_concat("symbol \"")(Host.hol_concat(sym)("\" is not overloadable")))
        | exn: Host.hol_raise(exn)
  let [name, ty] as namty:
    try:
      dest_const(tm)
      ~catch exn:
        match exn
        | Failure(_): dest_var(tm)
        | exn: Host.hol_raise(exn)
  if Host.hol_not(can(type_match(gty)(ty))(PairList []))
  | failwith("Not an instance of type skeleton")
  | let interface = filter(Host.hol_unequal([sym, namty]))(Host.ref_get(Host.the_interface))
    Host.ref_set(Host.the_interface)(PairList [[sym, namty], & interface])

fun preterm_prioritize_overload(ty):
  Host.do_list(
    fun([s, gty]):
      try:
        let [_, [n, t]]:
          find(
            (fun([s_prime, [n, t]]): (Host.hol_equal(s_prime)(s) && mem(ty)(map(fst)(type_match(gty)(t)(PairList [])))))
          )(Host.ref_get(Host.the_interface))
        preterm_overload_interface([s, mk_var([n, t])])
        ~catch exn:
          match exn
          | Failure(_): #void
          | exn: Host.hol_raise(exn)
  )(Host.ref_get(Host.the_overload_skeletons))

def [preterm_new_type_abbrev_v2, preterm_remove_type_abbrev_v2, preterm_type_abbrevs]:
  let the_type_abbreviations = Box(PairList [])
  let remove_type_abbrev_2:
    fun(s):
      Host.ref_set(the_type_abbreviations)(
        filter((fun([s_prime, _]): Host.hol_unequal(s_prime)(s)))(Host.ref_get(the_type_abbreviations))
      )
  let new_type_abbrev_2:
    fun([s, ty]):
      remove_type_abbrev_2(s)
      Host.ref_set(the_type_abbreviations)(Host.merge(Host.hol_lt)(PairList [[s, ty]])(Host.ref_get(the_type_abbreviations)))
  let type_abbrevs_2 = (fun(_): Host.ref_get(the_type_abbreviations))
  [new_type_abbrev_2, remove_type_abbrev_2, type_abbrevs_2]

def [preterm_hide_constant_v2, preterm_unhide_constant_v2, preterm_is_hidden]:
  let hcs = Box(PairList [])
  let hide_constant_2 = (fun(c): Host.ref_set(hcs)(union(PairList [c])(Host.ref_get(hcs))))
  let unhide_constant_2 = (fun(c): Host.ref_set(hcs)(subtract(Host.ref_get(hcs))(PairList [c])))
  let is_hidden_2 = (fun(c): mem(c)(Host.ref_get(hcs)))
  [hide_constant_2, unhide_constant_2, is_hidden_2]

variant pretype:
  UtvValue(name)
  PtyconValue(name, arguments)
  StvValue(index)

def preterm_dpty = PtyconValue("", PairList [])

fun preterm_pretype_of_type(ty):
  match ty
  | Tyvar(s): UtvValue(s)
  | Tyapp(con,args): PtyconValue(con, map(preterm_pretype_of_type)(args))

variant preterm:
  VarpValue(name, pretype)
  ConstpValue(name, pretype)
  CombpValue(operator, operand)
  AbspValue(variable, body)
  TypingValue(term, pretype)

fun preterm_preterm_of_term(tm):
  try:
    let [n, ty] = dest_var(tm)
    VarpValue(n, preterm_pretype_of_type(ty))
    ~catch exn:
      match exn
      | Failure(_):
          try:
            let [n, ty] = dest_const(tm)
            ConstpValue(n, preterm_pretype_of_type(ty))
            ~catch exn:
              match exn
              | Failure(_):
                  try:
                    let [v, bod] = dest_abs(tm)
                    AbspValue(preterm_preterm_of_term(v), preterm_preterm_of_term(bod))
                    ~catch exn:
                      match exn
                      | Failure(_):
                          let [l, r] = dest_comb(tm)
                          CombpValue(preterm_preterm_of_term(l), preterm_preterm_of_term(r))
                      | exn: Host.hol_raise(exn)
              | exn: Host.hol_raise(exn)
      | exn: Host.hol_raise(exn)

def [preterm_type_of_pretype_v2, preterm_term_of_preterm_v2, preterm_retypecheck]:
  let tyv_num = Box(0)
  let new_type_var:
    fun(_):
      let n = Host.ref_get(tyv_num)
      Host.ref_set(tyv_num)(Host.hol_add(n)(1))
      StvValue(n)
  let pmk_cv = (fun([s, pty]): (if can(get_const_type)(s) | ConstpValue(s, pty) | VarpValue(s, pty)))
  let num_pty = PtyconValue("num", PairList [])
  let NUMERAL_2 = ConstpValue("NUMERAL", PtyconValue("fun", PairList [num_pty, num_pty]))
  let BIT0_2 = ConstpValue("BIT0", PtyconValue("fun", PairList [num_pty, num_pty]))
  let BIT1_2 = ConstpValue("BIT1", PtyconValue("fun", PairList [num_pty, num_pty]))
  let t_0_2 = ConstpValue("_0", num_pty)
  fun pmk_numeral_2(n):
    if Host.hol_equal(n)(Host.num_0)
    | t_0_2
    | let m_2 = Host.quo_num(n)(Host.num_2)
      let b_2 = Host.mod_num(n)(Host.num_2)
      let op = (if Host.hol_equal(b_2)(Host.num_0) | BIT0_2 | BIT1_2)
      CombpValue(op, pmk_numeral_2(m_2))
  let pmk_numeral = (fun(n): CombpValue(NUMERAL_2, pmk_numeral_2(n)))
  fun pretype_subst(th):
