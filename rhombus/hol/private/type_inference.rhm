                let [ty_prime, ty_prime_prime]:
                  match ty
                  | PtyconValue("fun",PairList [ty_prime, & PairList [ty_prime_prime, & PairList []]]): [ty_prime, ty_prime_prime]
                  | _: [Host.hol_apply_unit(new_type_var), Host.hol_apply_unit(new_type_var)]
                let ty_prime_prime_prime = PtyconValue("fun", PairList [ty_prime, ty_prime_prime])
                let uenv0 = unify(Host.Some(ptm))(uenv)(ty_prime_prime_prime)(ty)
                let [v_prime, venv1, uenv1] = typify(ty_prime)([v, PairList [], uenv0])
                let [v_prime, venv1, uenv1]:
                  match v_prime
                  | ConstpValue(s,_):
                      if Host.ref_get(preterm_ignore_constant_varstruct)
                      | [VarpValue(s, ty_prime), PairList [[s, ty_prime]], uenv0]
                      | match v_prime
                        | _: [v_prime, venv1, uenv1]
                  | _: [v_prime, venv1, uenv1]
                let [bod_prime, venv2, uenv2] = typify(ty_prime_prime)([bod, append(venv1)(venv), uenv1])
                [AbspValue(v_prime, bod_prime), venv2, uenv2]
            | _: failwith("typify: unexpected constant at this stage")
      | VarpValue(s,_):
          Host.warn((Host.hol_unequal(s)("") && Host.isnum(s)))("Non-numeral begins with a digit")
          if (Host.hol_not(preterm_is_hidden(s)) && can(get_generic_type)(s))
          | let pty = pretype_instance(get_generic_type(s))
            let ptm = ConstpValue(s, pty)
            [ptm, PairList [], unify(Host.Some(ptm))(uenv)(pty)(ty)]
          | let ptm = VarpValue(s, ty)
            if Host.hol_not(can(get_var_type)(s))
            | [ptm, PairList [[s, ty]], uenv]
            | let pty = pretype_instance(get_var_type(s))
              [ptm, PairList [[s, ty]], unify(Host.Some(ptm))(uenv)(pty)(ty)]
      | CombpValue(f,x):
          let ty_prime_prime = Host.hol_apply_unit(new_type_var)
          let ty_prime = PtyconValue("fun", PairList [ty_prime_prime, ty])
          let [f_prime, venv1, uenv1] = typify(ty_prime)([f, venv, uenv])
          let [x_prime, venv2, uenv2] = typify(ty_prime_prime)([x, append(venv1)(venv), uenv1])
          [CombpValue(f_prime, x_prime), append(venv1)(venv2), uenv2]
      | TypingValue(tm,pty): typify(ty)([tm, venv, unify(Host.Some(tm))(uenv)(ty)(pty)])
      | AbspValue(v,bod):
          let [ty_prime, ty_prime_prime]:
            match ty
            | PtyconValue("fun",PairList [ty_prime, & PairList [ty_prime_prime, & PairList []]]): [ty_prime, ty_prime_prime]
            | _: [Host.hol_apply_unit(new_type_var), Host.hol_apply_unit(new_type_var)]
          let ty_prime_prime_prime = PtyconValue("fun", PairList [ty_prime, ty_prime_prime])
          let uenv0 = unify(Host.Some(ptm))(uenv)(ty_prime_prime_prime)(ty)
          let [v_prime, venv1, uenv1] = typify(ty_prime)([v, PairList [], uenv0])
          let [v_prime, venv1, uenv1]:
            match v_prime
            | ConstpValue(s,_):
                if Host.ref_get(preterm_ignore_constant_varstruct)
                | [VarpValue(s, ty_prime), PairList [[s, ty_prime]], uenv0]
                | match v_prime
                  | _: [v_prime, venv1, uenv1]
            | _: [v_prime, venv1, uenv1]
          let [bod_prime, venv2, uenv2] = typify(ty_prime_prime)([bod, append(venv1)(venv), uenv1])
          [AbspValue(v_prime, bod_prime), venv2, uenv2]
      | _: failwith("typify: unexpected constant at this stage")
  fun resolve_interface(ptm):
    fun(cont):
      fun(env):
        match ptm
        | CombpValue(f,x): resolve_interface(f)(resolve_interface(x)(cont))(env)
        | AbspValue(v,bod): resolve_interface(v)(resolve_interface(bod)(cont))(env)
        | VarpValue(_,_): cont(env)
        | ConstpValue(s,ty):
            let maps = filter((fun([s_prime, _]): Host.hol_equal(s_prime)(s)))(Host.ref_get(Host.the_interface))
            if Host.hol_equal(maps)(PairList [])
            | cont(env)
            | tryfind(
                fun([_, [_, ty_prime]]):
                  let ty_prime = pretype_instance(ty_prime)
                  cont(unify(Host.Some(ptm))(env)(ty_prime)(ty))
              )(maps)
  fun solve_preterm(env):
    fun(ptm):
      match ptm
      | VarpValue(s,ty): VarpValue(s, solve(env)(ty))
      | CombpValue(f,x): CombpValue(solve_preterm(env)(f), solve_preterm(env)(x))
      | AbspValue(v,bod): AbspValue(solve_preterm(env)(v), solve_preterm(env)(bod))
      | ConstpValue(s,ty):
          let tys = solve(env)(ty)
          try:
            let [_, [c_prime, _]]:
              find(
                (fun([s_prime, [c_prime, ty_prime]]): (Host.hol_equal(s)(s_prime) && can(unify(Host.None())(env)(pretype_instance(ty_prime)))(ty)))
              )(Host.ref_get(Host.the_interface))
            pmk_cv([c_prime, tys])
            ~catch exn:
              match exn
              | Failure(_): ConstpValue(s, tys)
              | exn: Host.hol_raise(exn)
  fun type_of_pretype_base(ty):
    match ty
    | StvValue(n):
        let s = Host.hol_concat("?")(Host.hol_string_of_int(n))
        [mk_vartype(s), #true]
    | UtvValue(v): [mk_vartype(v), #false]
    | PtyconValue(con,args):
        let [args_prime, translated] = unzip(map(type_of_pretype_base)(args))
        let translated = Host.OCamlList.fold_left(Host.hol_or)(#false)(translated)
        [mk_type([con, args_prime]), translated]
  let type_of_pretype_2 = (fun(ty): fst(type_of_pretype_base(ty)))
  let stvs_translated_terms = Box(PairList [])
  fun term_of_preterm_3(ptm):
    match ptm
    | VarpValue(s,pty):
        let [ty, translated] = type_of_pretype_base(pty)
        let v = mk_var([s, ty])
        let _ = (if (translated && Host.hol_not(exists((fun(s_prime): Host.hol_equal(s)(s_prime)))(Host.ref_get(stvs_translated_terms)))) | Host.ref_set(stvs_translated_terms)(PairList [s, & Host.ref_get(stvs_translated_terms)]) | #void)
        v
    | ConstpValue(s,pty):
        let [ty, translated] = type_of_pretype_base(pty)
        let c = mk_mconst([s, ty])
        let _ = (if (translated && Host.hol_not(exists((fun(s_prime): Host.hol_equal(s)(s_prime)))(Host.ref_get(stvs_translated_terms)))) | Host.ref_set(stvs_translated_terms)(PairList [s, & Host.ref_get(stvs_translated_terms)]) | #void)
        c
    | CombpValue(l,r): mk_comb([term_of_preterm_3(l), term_of_preterm_3(r)])
    | AbspValue(v,bod): mk_gabs([term_of_preterm_3(v), term_of_preterm_3(bod)])
    | TypingValue(ptm,pty): term_of_preterm_3(ptm)
  let report_type_invention:
    fun(_):
      if Host.hol_unequal(Host.ref_get(stvs_translated_terms))(PairList [])
      | if Host.ref_get(preterm_type_invention_error)
        | failwith(
            Host.hol_concat("typechecking error (cannot infer type of variables): ")(Host.hol_string_concat(", ")(Host.ref_get(stvs_translated_terms)))
          )
        | Host.warn(Host.ref_get(preterm_type_invention_warning))("inventing type variables")
      | #void
  let term_of_preterm_2:
    fun(ptm):
      Host.ref_set(stvs_translated_terms)(PairList [])
      let tm = term_of_preterm_3(ptm)
      Host.hol_apply_unit(report_type_invention)
      tm
  let retypecheck_2:
    fun(venv):
      fun(ptm):
        let ty = Host.hol_apply_unit(new_type_var)
        let [ptm_prime, _, env]:
          try:
            typify(ty)([ptm, venv, Host.undefined])
            ~catch exn:
              match exn
              | Failure(e): failwith(Host.hol_concat("typechecking error (initial type assignment):")(e))
              | exn: Host.hol_raise(exn)
        let env_prime:
          try:
            resolve_interface(ptm_prime)((fun(e): e))(env)
            ~catch exn:
              match exn
              | Failure(_): failwith("typechecking error (overload resolution)")
              | exn: Host.hol_raise(exn)
        let ptm_prime_prime = solve_preterm(env_prime)(ptm_prime)
        ptm_prime_prime
  [type_of_pretype_2, term_of_preterm_2, retypecheck_2]

def ignore_constant_varstruct = preterm_ignore_constant_varstruct

def type_invention_warning = preterm_type_invention_warning

def type_invention_error = preterm_type_invention_error

def the_implicit_types = preterm_the_implicit_types

def make_overloadable = preterm_make_overloadable

def remove_interface = preterm_remove_interface

def reduce_interface = preterm_reduce_interface

def override_interface = preterm_override_interface

def overload_interface = preterm_overload_interface

def prioritize_overload = preterm_prioritize_overload

def new_type_abbrev = preterm_new_type_abbrev_v2

def remove_type_abbrev = preterm_remove_type_abbrev_v2

def type_abbrevs = preterm_type_abbrevs

def hide_constant = preterm_hide_constant_v2

def unhide_constant = preterm_unhide_constant_v2

def is_hidden = preterm_is_hidden

def dpty = preterm_dpty

def pretype_of_type = preterm_pretype_of_type

def preterm_of_term = preterm_preterm_of_term

def type_of_pretype = preterm_type_of_pretype_v2

def term_of_preterm = preterm_term_of_preterm_v2

def retypecheck = preterm_retypecheck
