      | PairList []: get_const_type(cname)
  let get_var_type = (fun(vname): assoc(vname)(Host.ref_get(preterm_the_implicit_types)))
  fun solve(env):
    fun(pty):
      match pty
      | PtyconValue(f,args): PtyconValue(f, map(solve(env))(args))
      | StvValue(i): (if Host.defined(env)(i) | solve(env)(Host.apply(env)(i)) | pty)
      | _: pty
  fun free_stvs_2
  | free_stvs_2(StvValue(n)): PairList [n]
  | free_stvs_2(UtvValue(_)): PairList []
  | free_stvs_2(PtyconValue(_,args)): Host.flat(map(free_stvs_2)(args))
  let free_stvs = o(Host.setify)(free_stvs_2)
  let string_of_pretype:
    fun(stvs):
      fun type_of_pretype_prime(ns):
        fun
        | (StvValue(n)): mk_vartype((if mem(n)(ns) | Host.hol_concat("?")(Host.hol_string_of_int(n)) | "_"))
        | (UtvValue(v)): mk_vartype(v)
        | (PtyconValue(con,args)): mk_type([con, map(type_of_pretype_prime(ns))(args)])
      o(Host.string_of_type)(type_of_pretype_prime(stvs))
  fun untyped_t_of_pt
  | untyped_t_of_pt(VarpValue(s,pty)): mk_var([s, aty])
  | untyped_t_of_pt(ConstpValue(s,pty)): mk_mconst([s, get_const_type(s)])
  | untyped_t_of_pt(CombpValue(l,r)): mk_comb([untyped_t_of_pt(l), untyped_t_of_pt(r)])
  | untyped_t_of_pt(AbspValue(v,bod)): mk_gabs([untyped_t_of_pt(v), untyped_t_of_pt(bod)])
  | untyped_t_of_pt(TypingValue(ptm,pty)): untyped_t_of_pt(ptm)
  let string_of_preterm = o(Host.string_of_term)(untyped_t_of_pt)
  let string_of_ty_error:
    fun(env):
      fun
      | (Host.None()): Host.hol_concat("unify: types cannot be unified ")("(you should not see this message, please report)")
      | (Host.Some([t, ty1, ty2])):
          let ty1_2 = solve(env)(ty1)
          let ty2_2 = solve(env)(ty2)
          let sty1 = string_of_pretype(free_stvs(ty2_2))(ty1_2)
          let sty2 = string_of_pretype(free_stvs(ty1_2))(ty2_2)
