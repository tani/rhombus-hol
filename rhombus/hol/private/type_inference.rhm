      | UtvValue(v): rev_assocd(ty)(th)(ty)
      | _: failwith("pretype_subst: Unexpected form of pretype")
  let pretype_instance:
    fun(ty):
      let gty_2 = preterm_pretype_of_type(ty)
      let tyvs_2 = map(preterm_pretype_of_type)(tyvars(ty))
      let subs = map((fun(tv): [Host.hol_apply_unit(new_type_var), tv]))(tyvs_2)
      pretype_subst(subs)(gty_2)
  let get_generic_type:
