// parse_term (../parser.rhm) elaborates every `@hol|{...}|` quotation with
// retypecheck and term_of_preterm below.

import:
  "../basics.rhm" open:
    only:
      type_match
      mk_mconst
      mk_gabs
  "../fusion.rhm" open:
    only:
      mk_type
      mk_vartype
      tyvars
      aty
      get_const_type
      mk_var
      mk_comb
      dest_var
      dest_const
      dest_comb
      dest_abs
      Tyvar
      Tyapp
  "../lib.rhm" open
  "ocaml.rhm" open
  "theory_support.rhm" as Host
  "declarations.rhm" open
  "../fusion.rhm" as Fusion
  "../basics.rhm" as Basics
  "../nets.rhm" as Nets
  "../equal.rhm" as Equal

export:
  ignore_constant_varstruct
  type_invention_warning
  type_invention_error
  the_implicit_types
  make_overloadable
  remove_interface
  reduce_interface
  override_interface
  overload_interface
  prioritize_overload
  new_type_abbrev
  remove_type_abbrev
  type_abbrevs
  hide_constant
  unhide_constant
  is_hidden
  rename UtvValue as Utv
  rename PtyconValue as Ptycon
  rename StvValue as Stv
  dpty
  pretype_of_type
  rename VarpValue as Varp
  rename ConstpValue as Constp
  rename CombpValue as Combp
  rename AbspValue as Absp
  rename TypingValue as Typing
  preterm_of_term
  type_of_pretype
  term_of_preterm
  retypecheck

def preterm_ignore_constant_varstruct = Box(#true)

def preterm_type_invention_warning = Box(#true)

def preterm_type_invention_error = Box(#false)

def preterm_the_implicit_types = Box(PairList [])

fun preterm_make_overloadable(s):
  fun(gty):
    if can(assoc(s))(Host.the_overload_skeletons.value)
    | (if (assoc(s)(Host.the_overload_skeletons.value) == gty) | #void | failwith("make_overloadable: differs from existing skeleton"))
    | Host.the_overload_skeletons.value := PairList [[s, gty], & Host.the_overload_skeletons.value]

fun preterm_remove_interface(sym):
  let interface = filter(o((fun (y): sym != y))(fst))(Host.the_interface.value)
  Host.the_interface.value := interface

fun preterm_reduce_interface([sym, tm]):
  let namty:
    try:
      dest_const(tm)
      ~catch exn:
        match exn
        | Failure(_): dest_var(tm)
        | exn: (throw exn)
  Host.the_interface.value := filter((fun (y): ([sym, namty]) != y))(Host.the_interface.value)

fun preterm_override_interface([sym, tm]):
  let namty:
    try:
      dest_const(tm)
      ~catch exn:
        match exn
        | Failure(_): dest_var(tm)
        | exn: (throw exn)
  let interface = filter(o((fun (y): sym != y))(fst))(Host.the_interface.value)
  Host.the_interface.value := PairList [[sym, namty], & interface]

fun preterm_overload_interface([sym, tm]):
  let gty:
    try:
      assoc(sym)(Host.the_overload_skeletons.value)
      ~catch exn:
        match exn
        | Failure(_): failwith(("symbol \"" +& (sym +& "\" is not overloadable")))
        | exn: (throw exn)
  let [name, ty] as namty:
    try:
      dest_const(tm)
      ~catch exn:
        match exn
        | Failure(_): dest_var(tm)
        | exn: (throw exn)
  if !can(type_match(gty)(ty))(PairList [])
  | failwith("Not an instance of type skeleton")
  | let interface = filter((fun (y): ([sym, namty]) != y))(Host.the_interface.value)
    Host.the_interface.value := PairList [[sym, namty], & interface]

fun preterm_prioritize_overload(ty):
  do_list(
    fun([s, gty]):
      try:
        let [_, [n, t]]:
          find(
            (fun([s_prime, [n, t]]): ((s_prime == s) && mem(ty)(map(fst)(type_match(gty)(t)(PairList [])))))
          )(Host.the_interface.value)
        preterm_overload_interface([s, mk_var([n, t])])
        ~catch exn:
          match exn
          | Failure(_): #void
          | exn: (throw exn)
  )(Host.the_overload_skeletons.value)

def [preterm_new_type_abbrev_v2, preterm_remove_type_abbrev_v2, preterm_type_abbrevs]:
  let the_type_abbreviations = Box(PairList [])
  let remove_type_abbrev_2:
    fun(s):
      the_type_abbreviations.value := filter((fun([s_prime, _]): (s_prime != s)))(the_type_abbreviations.value)
  let new_type_abbrev_2:
    fun([s, ty]):
      remove_type_abbrev_2(s)
      the_type_abbreviations.value := merge(polymorphic_lt)(PairList [[s, ty]])(the_type_abbreviations.value)
  let type_abbrevs_2 = (fun(_): the_type_abbreviations.value)
  [new_type_abbrev_2, remove_type_abbrev_2, type_abbrevs_2]

def [preterm_hide_constant_v2, preterm_unhide_constant_v2, preterm_is_hidden]:
  let hcs = Box(PairList [])
  let hide_constant_2 = (fun(c): (hcs.value := union(PairList [c])(hcs.value)))
  let unhide_constant_2 = (fun(c): (hcs.value := subtract(hcs.value)(PairList [c])))
  let is_hidden_2 = (fun(c): mem(c)(hcs.value))
  [hide_constant_2, unhide_constant_2, is_hidden_2]

variant pretype:
  UtvValue(name)
  PtyconValue(name, arguments)
  StvValue(index)

def preterm_dpty = PtyconValue("", PairList [])

fun preterm_pretype_of_type(ty):
  match ty
  | Tyvar(s): UtvValue(s)
  | Tyapp(con,args): PtyconValue(con, map(preterm_pretype_of_type)(args))

variant preterm:
  VarpValue(name, pretype)
  ConstpValue(name, pretype)
  CombpValue(operator, operand)
  AbspValue(variable, body)
  TypingValue(term, pretype)

fun preterm_preterm_of_term(tm):
  try:
    let [n, ty] = dest_var(tm)
    VarpValue(n, preterm_pretype_of_type(ty))
    ~catch exn:
      match exn
      | Failure(_):
          try:
            let [n, ty] = dest_const(tm)
            ConstpValue(n, preterm_pretype_of_type(ty))
            ~catch exn:
              match exn
              | Failure(_):
                  try:
                    let [v, bod] = dest_abs(tm)
                    AbspValue(preterm_preterm_of_term(v), preterm_preterm_of_term(bod))
                    ~catch exn:
                      match exn
                      | Failure(_):
                          let [l, r] = dest_comb(tm)
                          CombpValue(preterm_preterm_of_term(l), preterm_preterm_of_term(r))
                      | exn: (throw exn)
              | exn: (throw exn)
      | exn: (throw exn)

def [preterm_type_of_pretype_v2, preterm_term_of_preterm_v2, preterm_retypecheck]:
  let tyv_num = Box(0)
  let new_type_var:
    fun(_):
      let n = tyv_num.value
      tyv_num.value := n + 1
      StvValue(n)
  let pmk_cv = (fun([s, pty]): (if can(get_const_type)(s) | ConstpValue(s, pty) | VarpValue(s, pty)))
  let num_pty = PtyconValue("num", PairList [])
  let NUMERAL = ConstpValue("NUMERAL", PtyconValue("fun", PairList [num_pty, num_pty]))
  let BIT0 = ConstpValue("BIT0", PtyconValue("fun", PairList [num_pty, num_pty]))
  let BIT1 = ConstpValue("BIT1", PtyconValue("fun", PairList [num_pty, num_pty]))
  let t_0 = ConstpValue("_0", num_pty)
  fun pmk_numeral_2(n):
    if (n == num_0)
    | t_0
    | let m = quo_num(n)(num_2)
      let b = mod_num(n)(num_2)
      let op = (if (b == num_0) | BIT0 | BIT1)
      CombpValue(op, pmk_numeral_2(m))
  let pmk_numeral = (fun(n): CombpValue(NUMERAL, pmk_numeral_2(n)))
  // Recursive local helpers need definitions so their own bodies can call them.
  fun pretype_subst(th):
    fun(ty):
      match ty
      | PtyconValue(tycon,args): PtyconValue(tycon, map(pretype_subst(th))(args))
      | UtvValue(v): rev_assocd(ty)(th)(ty)
      | _: failwith("pretype_subst: Unexpected form of pretype")
  let pretype_instance:
    fun(ty):
      let gty = preterm_pretype_of_type(ty)
      let tyvs = map(preterm_pretype_of_type)(tyvars(ty))
      let subs = map((fun(tv): [new_type_var(#void), tv]))(tyvs)
      pretype_subst(subs)(gty)
  let get_generic_type:
    fun(cname):
      match filter(o((fun (y): cname == y))(fst))(Host.the_interface.value)
      | PairList [[_, [c, ty]], & PairList []]: ty
      | PairList [_, & PairList [_, & _]]: assoc(cname)(Host.the_overload_skeletons.value)
      | PairList []: get_const_type(cname)
  let get_var_type = (fun(vname): assoc(vname)(preterm_the_implicit_types.value))
  fun solve(env):
    fun(pty):
      match pty
      | PtyconValue(f,args): PtyconValue(f, map(solve(env))(args))
      | StvValue(i): (if defined(env)(i) | solve(env)(apply(env)(i)) | pty)
      | _: pty
  fun free_stvs_2
  | free_stvs_2(StvValue(n)): PairList [n]
  | free_stvs_2(UtvValue(_)): PairList []
  | free_stvs_2(PtyconValue(_,args)): flat(map(free_stvs_2)(args))
  let free_stvs = o(setify)(free_stvs_2)
  let string_of_pretype = fun(stvs):
    fun(pt):
      fun type_of_pretype_prime(ns):
        fun
        | (StvValue(n)): mk_vartype((if mem(n)(ns) | ("?" +& to_string(n)) | "_"))
        | (UtvValue(v)): mk_vartype(v)
        | (PtyconValue(con,args)): mk_type([con, map(type_of_pretype_prime(ns))(args)])
      Host.string_of_type(type_of_pretype_prime(stvs)(pt))
  fun untyped_t_of_pt
  | untyped_t_of_pt(VarpValue(s,pty)): mk_var([s, aty])
  | untyped_t_of_pt(ConstpValue(s,pty)): mk_mconst([s, get_const_type(s)])
  | untyped_t_of_pt(CombpValue(l,r)): mk_comb([untyped_t_of_pt(l), untyped_t_of_pt(r)])
  | untyped_t_of_pt(AbspValue(v,bod)): mk_gabs([untyped_t_of_pt(v), untyped_t_of_pt(bod)])
  | untyped_t_of_pt(TypingValue(ptm,pty)): untyped_t_of_pt(ptm)
  let string_of_preterm = o(Host.string_of_term)(untyped_t_of_pt)
  let string_of_ty_error:
    fun(env):
      fun(error):
        match error
        | None(): ("unify: types cannot be unified " +& "(you should not see this message, please report)")
        | Some([t, ty1, ty2]):
            let ty1_2 = solve(env)(ty1)
            let ty2_2 = solve(env)(ty2)
            let sty1 = string_of_pretype(free_stvs(ty2_2))(ty1_2)
            let sty2 = string_of_pretype(free_stvs(ty1_2))(ty2_2)
            let default_msg:
              fun(s):
                (" " +& (s +& (" cannot have type " +& (sty1 +& (" and " +& (sty2 +& " simultaneously"))))))
            match t
            | ConstpValue(s,_):
                (" " +& (s +& (" has type " +& (Host.string_of_type(get_const_type(s)) +& (", " +& ("it cannot be used with type " +& sty2))))))
            | VarpValue(s,_): default_msg(s)
            | t: default_msg(string_of_preterm(t))
  fun istrivial(ptm):
    fun(env):
      fun(x):
        fun(ty):
          match ty
          | StvValue(y): y == x || (defined(env)(y) && istrivial(ptm)(env)(x)(apply(env)(y)))
          | PtyconValue(f, args) when exists(istrivial(ptm)(env)(x))(args):
              failwith(string_of_ty_error(env)(ptm))
          | _: #false
  let unify:
    fun(ptm):
      fun(env):
        fun(ty1):
          fun(ty2):
            // The original shadows unify with its recursive worker.
            fun unify(env):
              fun(constraints):
                match constraints
                | PairList []: env
                | PairList [[ty1, ty2, _], & oth] when ty1 == ty2: unify(env)(oth)
                | PairList [[PtyconValue(f, fargs), PtyconValue(g, gargs), ptm], & oth]:
                    if f == g && length(fargs) == length(gargs)
                    | unify(env)(append(map2(fun(x): fun(y): [x, y, ptm])(fargs)(gargs))(oth))
                    | failwith(string_of_ty_error(env)(ptm))
                | PairList [[StvValue(x), t, ptm], & oth]:
                    if defined(env)(x)
                    | unify(env)(PairList.cons([apply(env)(x), t, ptm], oth))
                    | unify(if istrivial(ptm)(env)(x)(t) | env | fpf_define(x)(t)(env))(oth)
                | PairList [[t, StvValue(x), ptm], & oth]:
                    unify(env)(PairList.cons([StvValue(x), t, ptm], oth))
                | PairList [[_, _, ptm], & oth]: failwith(string_of_ty_error(env)(ptm))
            let origin:
              match ptm
              | None(): None()
              | Some(t): Some([t, ty1, ty2])
            unify(env)(PairList [[ty1, ty2, origin]])
  fun typify(ty):
    fun([ptm, venv, uenv]):
      match ptm
      | VarpValue(s, _) when can(assoc(s))(venv):
          let ty_prime = assoc(s)(venv)
          [VarpValue(s, ty_prime), PairList [], unify(Some(ptm))(uenv)(ty_prime)(ty)]
      | VarpValue(s, _) when can(num_of_string)(s):
          let t = pmk_numeral(num_of_string(s))
          let ty_prime = PtyconValue("num", PairList [])
          [t, PairList [], unify(Some(ptm))(uenv)(ty_prime)(ty)]
      | VarpValue(s, _):
          warn(s != "" && Host.isnum(s))("Non-numeral begins with a digit")
          if !preterm_is_hidden(s) && can(get_generic_type)(s)
          | let pty = pretype_instance(get_generic_type(s))
            let ptm = ConstpValue(s, pty)
            [ptm, PairList [], unify(Some(ptm))(uenv)(pty)(ty)]
          | let ptm = VarpValue(s, ty)
            if !can(get_var_type)(s)
            | [ptm, PairList [[s, ty]], uenv]
            | let pty = pretype_instance(get_var_type(s))
              [ptm, PairList [[s, ty]], unify(Some(ptm))(uenv)(pty)(ty)]
      | CombpValue(f, x):
          let ty_prime_prime = new_type_var(#void)
          let ty_prime = PtyconValue("fun", PairList [ty_prime_prime, ty])
          let [f_prime, venv1, uenv1] = typify(ty_prime)([f, venv, uenv])
          let [x_prime, venv2, uenv2] = typify(ty_prime_prime)([x, append(venv1)(venv), uenv1])
          [CombpValue(f_prime, x_prime), append(venv1)(venv2), uenv2]
      | TypingValue(tm, pty): typify(ty)([tm, venv, unify(Some(tm))(uenv)(ty)(pty)])
      | AbspValue(v, bod):
          let [ty_prime, ty_prime_prime]:
            match ty
            | PtyconValue("fun", PairList [ty_prime, ty_prime_prime]): [ty_prime, ty_prime_prime]
            | _: [new_type_var(#void), new_type_var(#void)]
          let ty_prime_prime_prime = PtyconValue("fun", PairList [ty_prime, ty_prime_prime])
          let uenv0 = unify(Some(ptm))(uenv)(ty_prime_prime_prime)(ty)
          let [v_prime, venv1, uenv1]:
            let [v_prime, venv1, uenv1] = typify(ty_prime)([v, PairList [], uenv0])
            match v_prime
            | ConstpValue(s, _) when preterm_ignore_constant_varstruct.value:
                [VarpValue(s, ty_prime), PairList [[s, ty_prime]], uenv0]
            | _: [v_prime, venv1, uenv1]
          let [bod_prime, venv2, uenv2] = typify(ty_prime_prime)([bod, append(venv1)(venv), uenv1])
          [AbspValue(v_prime, bod_prime), venv2, uenv2]
      | _: failwith("typify: unexpected constant at this stage")
  fun resolve_interface(ptm):
    fun(cont):
      fun(env):
        match ptm
        | CombpValue(f,x): resolve_interface(f)(resolve_interface(x)(cont))(env)
        | AbspValue(v,bod): resolve_interface(v)(resolve_interface(bod)(cont))(env)
        | VarpValue(_,_): cont(env)
        | ConstpValue(s,ty):
            let maps = filter((fun([s_prime, _]): (s_prime == s)))(Host.the_interface.value)
            if (maps == (PairList []))
            | cont(env)
            | tryfind(
                fun([_, [_, ty_prime]]):
                  let ty_prime = pretype_instance(ty_prime)
                  cont(unify(Some(ptm))(env)(ty_prime)(ty))
              )(maps)
  fun solve_preterm(env):
    fun(ptm):
      match ptm
      | VarpValue(s,ty): VarpValue(s, solve(env)(ty))
      | CombpValue(f,x): CombpValue(solve_preterm(env)(f), solve_preterm(env)(x))
      | AbspValue(v,bod): AbspValue(solve_preterm(env)(v), solve_preterm(env)(bod))
      | ConstpValue(s,ty):
          let tys = solve(env)(ty)
          try:
            let [_, [c_prime, _]]:
              find(
                (fun([s_prime, [c_prime, ty_prime]]): ((s == s_prime) && can(unify(None())(env)(pretype_instance(ty_prime)))(ty)))
              )(Host.the_interface.value)
            pmk_cv([c_prime, tys])
            ~catch exn:
              match exn
              | Failure(_): ConstpValue(s, tys)
              | exn: (throw exn)
  fun type_of_pretype_base(ty):
    match ty
    | StvValue(n):
        let s = ("?" +& to_string(n))
        [mk_vartype(s), #true]
    | UtvValue(v): [mk_vartype(v), #false]
    | PtyconValue(con,args):
        let [args_prime, translated] = unzip(map(type_of_pretype_base)(args))
        let translated = OCamlList.fold_left(fun (x): fun (y): x || y)(#false)(translated)
        [mk_type([con, args_prime]), translated]
  let type_of_pretype_2 = (fun(ty): fst(type_of_pretype_base(ty)))
  let stvs_translated_terms = Box(PairList [])
  fun term_of_preterm_3(ptm):
    match ptm
    | VarpValue(s,pty):
        let [ty, translated] = type_of_pretype_base(pty)
        let v = mk_var([s, ty])
        let _ = (if (translated && !exists((fun(s_prime): (s == s_prime)))(stvs_translated_terms.value)) | (stvs_translated_terms.value := (PairList [s, & stvs_translated_terms.value])) | #void)
        v
    | ConstpValue(s,pty):
        let [ty, translated] = type_of_pretype_base(pty)
        let c = mk_mconst([s, ty])
        let _ = (if (translated && !exists((fun(s_prime): (s == s_prime)))(stvs_translated_terms.value)) | (stvs_translated_terms.value := (PairList [s, & stvs_translated_terms.value])) | #void)
        c
    | CombpValue(l,r): mk_comb([term_of_preterm_3(l), term_of_preterm_3(r)])
    | AbspValue(v,bod): mk_gabs([term_of_preterm_3(v), term_of_preterm_3(bod)])
    | TypingValue(ptm,pty): term_of_preterm_3(ptm)
  let report_type_invention:
    fun(_):
      if (stvs_translated_terms.value != (PairList []))
      | if preterm_type_invention_error.value
        | failwith(
            ("typechecking error (cannot infer type of variables): " +& hol_string_concat(", ")(stvs_translated_terms.value))
          )
        | warn(preterm_type_invention_warning.value)("inventing type variables")
      | #void
  let term_of_preterm_2:
    fun(ptm):
      stvs_translated_terms.value := PairList []
      let tm = term_of_preterm_3(ptm)
      report_type_invention(#void)
      tm
  let retypecheck_2 = fun(venv):
    fun(ptm):
      let ty = new_type_var(#void)
      let [ptm_prime, _, env]:
        try:
          typify(ty)([ptm, venv, undefined])
          ~catch exn:
            match exn
            | Failure(e): failwith(("typechecking error (initial type assignment):" +& e))
            | exn: (throw exn)
      let env_prime:
        try:
          resolve_interface(ptm_prime)((fun(e): e))(env)
          ~catch exn:
            match exn
            | Failure(_): failwith("typechecking error (overload resolution)")
            | exn: (throw exn)
      let ptm_prime_prime = solve_preterm(env_prime)(ptm_prime)
      ptm_prime_prime
  [type_of_pretype_2, term_of_preterm_2, retypecheck_2]

def ignore_constant_varstruct = preterm_ignore_constant_varstruct

def type_invention_warning = preterm_type_invention_warning

def type_invention_error = preterm_type_invention_error

def the_implicit_types = preterm_the_implicit_types

def make_overloadable = preterm_make_overloadable

def remove_interface = preterm_remove_interface

def reduce_interface = preterm_reduce_interface

def override_interface = preterm_override_interface

def overload_interface = preterm_overload_interface

def prioritize_overload = preterm_prioritize_overload

def new_type_abbrev = preterm_new_type_abbrev_v2

def remove_type_abbrev = preterm_remove_type_abbrev_v2

def type_abbrevs = preterm_type_abbrevs

def hide_constant = preterm_hide_constant_v2

def unhide_constant = preterm_unhide_constant_v2

def is_hidden = preterm_is_hidden

def dpty = preterm_dpty

def pretype_of_type = preterm_pretype_of_type

def preterm_of_term = preterm_preterm_of_term

def type_of_pretype = preterm_type_of_pretype_v2

def term_of_preterm = preterm_term_of_preterm_v2

def retypecheck = preterm_retypecheck
