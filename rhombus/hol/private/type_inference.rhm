  fun istrivial(ptm):
    fun(env):
      fun(x):
        fun(arg_2):
          match arg_2
          | StvValue(y): (Host.hol_equal(y)(x) || (Host.defined(env)(y) && istrivial(ptm)(env)(x)(Host.apply(env)(y))))
          | PtyconValue(f,args):
