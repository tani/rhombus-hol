#lang rhombus
// Rhombus-native type-description frontend for inductive type specifications.
// This accepts type descriptions only; it does not parse HOL terms.
import: "compat.rhm" open
import: "theory_support.rhm" as Host
import: "type_inference.rhm" as Syntax
import: "../fusion.rhm" as Kernel
export: parse_pretype
fun token_name(t):
  match t
  | Host.Ident(s): s
  | Host.Resword(s): s
fun has_token(s,src):
  match src
  | PairList [h,&_]: token_name(h)==s
  | _: #false
fun type_arity(s):
  try:
    Kernel.get_type_arity(s)
    ~catch Failure(_): -1
fun finite_type(n):
  if n==1
  | Syntax.Ptycon("1",PairList [])
  | Syntax.Ptycon((if n mod 2==0 | "tybit0" | "tybit1"),PairList [finite_type(math.floor(n/2))])
fun atom_type(s):
  try:
    Syntax.pretype_of_type(assoc(s)(Syntax.type_abbrevs(#void)))
    ~catch Failure(_):
      cond
      | can(Host.num_of_string)(s):
          let n=Host.num_of_string(s)
          if n>=1 && n==math.floor(n) | finite_type(n) | Syntax.Utv(s)
      | type_arity(s)==0: Syntax.Ptycon(s,PairList [])
      | ~else: Syntax.Utv(s)
fun parse_pretype(src):
  fun app_type(input):
    let [args, rest]=atomic_types(input)
    match rest
    | PairList [Host.Ident(c),&tail]:
        if type_arity(c)>0
        | [Syntax.Ptycon(c,args), tail]
        | single_type(args,rest)
    | _: single_type(args,rest)
  fun single_type(args,rest):
    match args
    | PairList [ty]: [ty, rest]
    | _: failwith("Bad type construction")
  fun atomic_types(input):
    match input
    | PairList [Host.Resword("("),&rest]:
        let [first, tail]=parse_level(0,rest)
        fun more(tys,rst):
          cond
          | has_token(",",rst):
              let [next, r]=parse_level(0,tl(rst))
              more(PairList.cons(next,tys),r)
          | has_token(")",rst): [Host.rev(tys), tl(rst)]
          | ~else: failwith("type description: missing closing parenthesis")
        more(PairList [first],tail)
    | PairList [Host.Ident(s),&rest]: [PairList [atom_type(s)], rest]
    | _: throw Host.Noparse()
  fun parse_level(level,input):
    if level==4
    | app_type(input)
    | block:
        let [left, rest]=parse_level(level+1,input)
        let [op, con]=Host.el(level)(PairList [["->", "fun"],["+", "sum"],["#", "prod"],["^", "cart"]])
        fun finish(l,rst):
          if has_token(op,rst)
          | block:
              let [right, tail]=parse_level((if level==3 | level+1 | level),tl(rst))
              let result=Syntax.Ptycon(con,PairList [l,right])
              if level==3 | finish(result,tail) | [result, tail]
          | [l, rst]
        finish(left,rest)
  parse_level(0,src)
