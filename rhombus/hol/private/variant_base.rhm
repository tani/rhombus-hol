#lang rhombus
// Shared comparison protocol for immutable OCaml algebraic values.
// Equality and hashing are the default structural ones of immutable
// classes; port_view supplies OCaml's structural ordering (hol_compare).
import: "compat.rhm" open
export: HolVariant
class HolVariant():
  nonfinal
  method port_view(): failwith("abstract variant")
