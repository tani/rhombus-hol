#lang rhombus
// Shared comparison protocol for immutable OCaml algebraic values.
// Equality and hashing are the default structural ones of immutable
// classes; ocaml_view supplies OCaml's structural ordering.
import: "ocaml.rhm" open
export: HolVariant
class HolVariant():
  nonfinal
  implements OcamlValue
  override ocaml_view(): failwith("abstract variant")
