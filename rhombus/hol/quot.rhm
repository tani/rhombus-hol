fun define_quotient_type(tyname):
  fun([absname, repname]):
    fun(eqv):
      let ty = hd(snd(Fusion.dest_type(Fusion.type_of(eqv))))
      let pty = Fusion.mk_fun_ty(ty)(Fusion.bool_ty)
      let s_2 = Fusion.mk_var(["s", pty])
      let x_2 = Fusion.mk_var(["x", ty])
      let eqvx = Fusion.mk_comb([eqv, x_2])
      let pred = Fusion.mk_abs([s_2, Bool.mk_exists([x_2, Fusion.mk_eq([s_2, eqvx])])])
      let th0 = Equal.BETA_CONV(Fusion.mk_comb([pred, eqvx]))
      let th1 = Bool.EXISTS([Fusion.rand(Fusion.concl(th0)), x_2])(Fusion.REFL(eqvx))
      let th2 = Fusion.EQ_MP(Equal.SYM(th0))(th1)
      let [abs_2, rep] = Fusion.new_basic_type_definition(tyname)([absname, repname])(th2)
      [abs_2, Equal.CONV_RULE(Equal.LAND_CONV(Equal.BETA_CONV))(rep)]

