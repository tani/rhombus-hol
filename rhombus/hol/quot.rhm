fun quot_define_quotient_type(tyname):«
  (fun(Pair(absname,repname)):«
    (fun(eqv):«
      (block:«
        let ty:«
          hd(snd(Up_fusion.dest_type(Up_fusion.type_of(eqv))))
        »;
        (block:«
          let pty:«
            Up_fusion.mk_fun_ty(ty)(Up_fusion.bool_ty)
          »;
          (block:«
            let port_tmp_1_s:«
              Up_fusion.mk_var(Pair("s",pty))
            »;
            let port_tmp_2_x:«
              Up_fusion.mk_var(Pair("x",ty))
            »;
            (block:«
              let eqvx:«
                Up_fusion.mk_comb(Pair(eqv,port_tmp_2_x))
              »;
              (block:«
                let pred:«
                  Up_fusion.mk_abs(Pair(port_tmp_1_s,Up_bool.mk_exists(Pair(port_tmp_2_x,Up_fusion.mk_eq(Pair(port_tmp_1_s,eqvx))))))
                »;
                (block:«
                  let th0:«
                    Up_equal.BETA_CONV(Up_fusion.mk_comb(Pair(pred,eqvx)))
                  »;
                  (block:«
                    let th1:«
                      (block:«
                        let port_tmp_3 = Up_fusion.REFL(eqvx);
                        let port_tmp_4 = Pair(Up_fusion.rand(Up_fusion.concl(th0)),port_tmp_2_x);
                        Up_bool.EXISTS(port_tmp_4)(port_tmp_3)
                      »)
                    »;
                    (block:«
                      let th2:«
                        Up_fusion.EQ_MP(Up_equal.SYM(th0))(th1)
                      »;
                      (block:«
                        let Pair(port_tmp_5_abs,rep):«
                          Up_fusion.new_basic_type_definition(tyname)(Pair(absname,repname))(th2)
                        »;
                        Pair(port_tmp_5_abs,Up_equal.CONV_RULE(Up_equal.LAND_CONV(Up_equal.BETA_CONV))(rep))
                      »)
                    »)
                  »)
                »)
              »)
            »)
          »)
        »)
      »)
    »)
  »)
»

def quot_lift_function:«
  (block:«
    let SELECT_LEMMA:«
      Up_tactics.prove(Pair(Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"@\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyvar\",\"A\"]]]],[\"Abs\",[\"Var\",\"y\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]]]"),(block:«
        let port_tmp_6 = Up_tactics.MATCH_ACCEPT_TAC(Up_class.SELECT_REFL);
        let port_tmp_7 = Up_tactics.THEN(Up_tactics.GEN_TAC)(Up_simp.GEN_REWRITE_TAC(o(Up_equal.LAND_CONV)(Up_equal.BINDER_CONV))(PairList.cons(Up_theorems.EQ_SYM_EQ,PairList [])));
        Up_tactics.THEN(port_tmp_7)(port_tmp_6)
      »)))
    »;
    (fun(tybij2):«
      (block:«
        let Pair(tybl,tybr):«
          Up_fusion.dest_comb(Up_fusion.concl(tybij2))
        »;
        (block:«
          let eqvx:«
            Up_fusion.rand(Up_basics.body(Up_fusion.rand(Up_fusion.rand(tybl))))
          »;
          (block:«
            let Pair(eqv,xtm):«
              Up_fusion.dest_comb(eqvx)
            »;
            (block:«
              let Pair(dmr,rtm):«
                Up_fusion.dest_eq(tybr)
