                                      (block:«
                                        let evs:«
                                          Up_basics.variants(wfvs)(map((fun(v):«
                                            Up_fusion.mk_var(Pair(fst(Up_fusion.dest_var(v)),ety))
                                          »))(rvs))
                                        »;
                                        (block:«
