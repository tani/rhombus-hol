                                                                        (block:«
                                                                          let port_tmp_19 = Up_equal.AP_THM(th)(v);
                                                                          let port_tmp_20 = Up_equal.RAND_CONV(Up_equal.BETA_CONV);
                                                                          Up_equal.CONV_RULE(port_tmp_20)(port_tmp_19)
                                                                        »)
                                                                      »)
                                                                    »))(newargs)(dth)
                                                                  »;
                                                                  (block:«
                                                                    let targs:«
                                                                      map((fun(v):«
                                                                        Up_fusion.mk_comb(Pair(mk,Up_fusion.mk_comb(Pair(eqv,v))))
                                                                      »))(rvs)
                                                                    »;
                                                                    (block:«
                                                                      let dme_th:«
                                                                        (block:«
                                                                          let th:«
                                                                            Up_fusion.INST(PairList.cons(Pair(eqvx,rtm),PairList []))(tybij2)
                                                                          »;
                                                                          Up_fusion.EQ_MP(th)((block:«
                                                                            let port_tmp_21 = Up_fusion.REFL(eqvx);
                                                                            let port_tmp_22 = Pair(Up_equal.lhs(Up_fusion.concl(th)),xtm);
                                                                            Up_bool.EXISTS(port_tmp_22)(port_tmp_21)
                                                                          »))
                                                                        »)
                                                                      »;
                                                                      (block:«
                                                                        let ith:«
                                                                          Up_fusion.INST(zip(targs)(evs))(eth)
                                                                        »;
                                                                        (block:«
                                                                          let jth:«
                                                                            Up_equal.SUBS(map((fun(v):«
                                                                              Up_fusion.INST(PairList.cons(Pair(v,xtm),PairList []))(dme_th)
                                                                            »))(rvs))(ith)
                                                                          »;
                                                                          (block:«
                                                                            let Pair(apop,uxtm):«
                                                                              Up_fusion.dest_comb(Up_fusion.rand(Up_fusion.concl(jth)))
                                                                            »;
                                                                            (block:«
                                                                              let extm:«
                                                                                Up_basics.body(uxtm)
                                                                              »;
                                                                              (block:«
                                                                                let Pair(evs,bod):«
                                                                                  Up_basics.strip_exists(extm)
                                                                                »;
                                                                                (block:«
                                                                                  let th1:«
                                                                                    Up_fusion.ASSUME(bod)
                                                                                  »;
                                                                                  (block:«
                                                                                    let th2:«
                                                                                      (block:«
                                                                                        if Host.hol_equal(evs)(PairList [])
                                                                                        | th1
                                                                                        | (block:«
                                                                                          let Pair(th2a,th2b):«
                                                                                            Up_bool.CONJ_PAIR(th1)
                                                                                          »;
                                                                                          (block:«
                                                                                            let ethlist:«
                                                                                              (block:«
                                                                                                let port_tmp_23 = map(Up_fusion.REFL)(qvs);
                                                                                                let port_tmp_24 = Up_bool.CONJUNCTS(th2b);
                                                                                                append(port_tmp_24)(port_tmp_23)
                                                                                              »)
                                                                                            »;
                                                                                            (block:«
                                                                                              let th2c:«
                                                                                                end_itlist(Up_bool.CONJ)(map((fun(v):«
                                                                                                  find(o(o(Host.hol_equal(Up_equal.lhand(v)))(Up_equal.lhand))(Up_fusion.concl))(ethlist)
                                                                                                »))(hyps))
                                                                                              »;
                                                                                              (block:«
