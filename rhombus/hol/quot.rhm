                                Up_fusion.frees(wtm)
                              »;
                              (block:«
                                let Pair(hyps,con):«
                                  (block:«
                                    try:«
                                      Host.F_F(Up_basics.conjuncts)(I)(Up_basics.dest_imp(wtm));
                                      ~catch port_tmp_10:«
                                        let port_tmp_11 = port_tmp_10;
                                        match port_tmp_11
                                        | Failure(_):«
                                            Pair(PairList [],wtm)
                                        »
                                        | port_tmp_10:«
                                            Host.hol_raise(port_tmp_10)
                                        »
                                      »
                                    »
                                  »)
                                »;
                                (block:«
