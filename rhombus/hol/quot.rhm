export:
  define_quotient_type
  lift_function
  lift_theorem

fun define_quotient_type(tyname):
  fun([absname, repname]):
    fun(eqv):
      let ty = hd(snd(dest_type(type_of(eqv))))
      let pty = mk_fun_ty(ty)(bool_ty)
      let s_2 = mk_var(["s", pty])
      let x_2 = mk_var(["x", ty])
      let eqvx = mk_comb([eqv, x_2])
      let pred = mk_abs([s_2, mk_exists([x_2, mk_eq([s_2, eqvx])])])
      let th0 = BETA_CONV(mk_comb([pred, eqvx]))
      let th1 = EXISTS([rand(concl(th0)), x_2])(REFL(eqvx))
      let th2 = EQ_MP(SYM(th0))(th1)
      let [abs_2, rep] = new_basic_type_definition(tyname)([absname, repname])(th2)
      [abs_2, CONV_RULE(LAND_CONV(BETA_CONV))(rep)]

def lift_function:
  let SELECT_LEMMA:
    prove(
      [
        (hol:
           const #{@} :: (A -> bool) -> A
           forall x :: A: #{@}(fun (y :: A): x == y) == x),
        (
          (
            GEN_TAC then_tac \
            GEN_REWRITE_TAC(o(LAND_CONV)(BINDER_CONV))(PairList [EQ_SYM_EQ])
          ) then_tac \
          MATCH_ACCEPT_TAC(SELECT_REFL)
        )
      ]
    )
  fun(tybij2):
    fun([refl_th, trans_th]):
      fun(fname):
        fun(wth):
          let [tybl, tybr] = dest_comb(concl(tybij2))
          let eqvx = rand(body(rand(rand(tybl))))
          let [eqv, xtm] = dest_comb(eqvx)
          let [dmr, rtm] = dest_eq(tybr)
          let [dest, mrt] = dest_comb(dmr)
          let mk = rator(mrt)
          let ety = type_of(mrt)
          let wtm = repeat(o(snd)(dest_forall))(concl(wth))
          let wfvs = frees(wtm)
          let [hyps, con]:
            try:
              F_F(conjuncts)(I)(dest_imp(wtm))
              ~catch exn:
                match exn
                | Failure(_): [PairList [], wtm]
                | exn: (throw exn)
          let [eqs, rels] = partition(is_eq)(hyps)
          let rvs = map(lhand)(rels)
          let qvs = map(lhs)(eqs)
          let evs = variants(wfvs)(map((fun(v): mk_var([fst(dest_var(v)), ety])))(rvs))
          let mems = map2(fun(rv): fun(ev): mk_comb([mk_comb([dest, ev]), rv]))(rvs)(evs)
          let [lcon, rcon] = dest_comb(con)
          let u = variant(append(evs)(wfvs))(mk_var(["u", type_of(rcon)]))
          let ucon = mk_comb([lcon, u])
          let dbod = list_mk_conj(PairList [ucon, & mems])
          let detm = list_mk_exists([rvs, dbod])
          let datm = mk_abs([u, detm])
          let hol_def_2 = (if is_eq(con) | list_mk_icomb("@")(PairList [datm]) | mk_comb([mk, datm]))
          let newargs:
            map(
              fun(e):
                try:
                  lhs(e)
                  ~catch exn:
                    match exn
                    | Failure(_): assoc(lhand(e))(zip(rvs)(evs))
                    | exn: (throw exn)
            )(hyps)
          let rdef = list_mk_abs([newargs, hol_def_2])
          let ldef = mk_var([fname, type_of(rdef)])
          let dth = new_definition(mk_eq([ldef, rdef]))
          let eth = rev_itlist(fun(v): fun(th): CONV_RULE(RAND_CONV(BETA_CONV))(AP_THM(th)(v)))(newargs)(dth)
          let targs = map((fun(v): mk_comb([mk, mk_comb([eqv, v])])))(rvs)
          let th = INST(PairList [[eqvx, rtm]])(tybij2)
          let dme_th = EQ_MP(th)(EXISTS([lhs(concl(th)), xtm])(REFL(eqvx)))
          let ith = INST(zip(targs)(evs))(eth)
          let jth = SUBS(map((fun(v): INST(PairList [[v, xtm]])(dme_th)))(rvs))(ith)
          let [apop, uxtm] = dest_comb(rand(concl(jth)))
          let extm = body(uxtm)
          let [evs, bod] = strip_exists(extm)
          let th1 = ASSUME(bod)
          let th2:
            if (evs == (PairList []))
            | th1
            | let [th2a, th2b] = CONJ_PAIR(th1)
              let ethlist = append(CONJUNCTS(th2b))(map(REFL)(qvs))
              let th2c:
                end_itlist(CONJ)(
                  map((fun(v): find(o(o((fun (y): lhand(v) == y))(lhand))(concl))(ethlist)))(hyps)
                )
              let th2d = MATCH_MP(wth)(th2c)
              let th2e:
                try:
                  TRANS(th2d)(th2a)
                  ~catch exn:
                    match exn
                    | Failure(_): MATCH_MP(trans_th)(CONJ(th2d)(th2a))
                    | exn: (throw exn)
              itlist(SIMPLE_CHOOSE)(evs)(th2e)
          let th3 = ASSUME(concl(th2))
          let th4 = end_itlist(CONJ)(PairList [th3, & map(C(SPEC)(refl_th))(rvs)])
          let th5 = itlist(SIMPLE_EXISTS)(evs)(ASSUME(bod))
          let th6 = MATCH_MP(DISCH_ALL(th5))(th4)
          let th7 = IMP_ANTISYM_RULE(DISCH_ALL(th2))(DISCH_ALL(th6))
          let th8 = TRANS(jth)(AP_TERM(apop)(ABS(u)(th7)))
          let fconv = (if is_eq(con) | REWR_CONV(SELECT_LEMMA) | RAND_CONV(ETA_CONV))
          let th9 = CONV_RULE(RAND_CONV(fconv))(th8)
          [eth, GSYM(th9)]

def lift_theorem:
  let pth:
    prove(
      [
        (hol:
           var R :: Repty -> Repty -> bool
           var mk :: (Repty -> bool) -> Absty
           var dest :: Absty -> Repty -> bool
           const #{@} :: (A -> bool) -> A
           ((forall x :: Repty: R(x, x))
              && ((forall (x :: Repty, y :: Repty): R(x, y) <=> R(y, x))
                    && ((forall (x :: Repty, y :: Repty, z :: Repty): R(x, y) && R(y, z) ==> R(x, z))
                          && ((forall a :: Absty: mk(dest(a)) == a)
                                && (forall r :: Repty -> bool:
                                      (exists x :: Repty: r == R(x)) <=> dest(mk(r)) == r)))))
             ==> ((forall (x :: Repty, y :: Repty): R(x, y) <=> mk(R(x)) == mk(R(y)))
                    && ((forall P :: Absty -> bool:
                           (forall x :: Repty: P(mk(R(x)))) <=> (forall x :: Absty: P(x)))
                          && ((forall P :: Absty -> bool:
                                 (exists x :: Repty: P(mk(R(x)))) <=> (exists x :: Absty: P(x)))
                                && (forall x :: Absty: mk(R(#{@}(dest(x)))) == x))))),
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  STRIP_TAC then_tac \
                                  SUBGOAL_THEN(
                                    (hol:
                                       var mk :: (Repty -> bool) -> Absty
                                       var R :: Repty -> Repty -> bool
                                       forall (x :: Repty, y :: Repty): mk(R(x)) == mk(R(y)) <=> R(x) == R(y))
                                  )(ASSUME_TAC)
                                ) then_list \
                                PairList [ASM_MESON_TAC(PairList []), ALL_TAC]
                              ) then_tac \
                              MATCH_MP_TAC(
                                TAUT(
                                  (hol:
                                     var a :: bool
                                     var b :: bool
                                     var c :: bool
                                     var d :: bool
                                     a && (b && c) && (b ==> a ==> d) ==> a && (b && (c && d)))
                                )
                              )
                            ) then_tac \
                            CONJ_TAC
                          ) then_list \
                          PairList [
                            (
                              (ASM_REWRITE_TAC(PairList []) then_tac REWRITE_TAC(PairList [FUN_EQ_THM])) then_tac \
                              ASM_MESON_TAC(PairList [])
                            ),
                            ALL_TAC
                          ]
                        ) then_tac \
                        REPEAT(DISCH_THEN((fun(th): REWRITE_TAC(PairList [GSYM(th)]))))
                      ) then_tac \
                      X_GEN_TAC(hol: var x :: Repty; x)
                    ) then_tac \
                    SUBGOAL_THEN(
                      (hol:
                         var dest :: Absty -> Repty -> bool
                         var mk :: (Repty -> bool) -> Absty
                         var R :: Repty -> Repty -> bool
                         var x :: Repty
                         dest(mk(R(x))) == R(x))
                    )(SUBST1_TAC)
                  ) then_list \
                  PairList [ASM_MESON_TAC(PairList []), ALL_TAC]
                ) then_tac \
                GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [GSYM(ETA_AX)])
              ) then_tac \
              FIRST_ASSUM((fun(th): GEN_REWRITE_TAC(I)(PairList [th])))
            ) then_tac \
            CONV_TAC(SELECT_CONV)
          ) then_tac \
          ASM_MESON_TAC(PairList [])
        )
      ]
    )
  fun(tybij):
    fun([refl_th, sym_th, trans_th]):
      fun(trths):
        let tybij1_2 = GEN_ALL(fst(tybij))
        let tybij2_2 = GEN_ALL(snd(tybij))
        let cth = end_itlist(CONJ)(PairList [refl_th, sym_th, trans_th, tybij1_2, tybij2_2])
        let ith = MATCH_MP(pth)(cth)
        REWRITE_RULE(PairList [ith, & trths])
