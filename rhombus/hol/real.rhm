    ]
  )

def REAL_ABS_TRIANGLE_LE:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         forall (x :: real, y :: real, z :: real):
           real_abs(x) + real_abs(y - x) <= z ==> real_abs(y) <= z),
      REAL_ARITH_TAC
    ]
  )

def REAL_ABS_TRIANGLE_LT:
  prove(
    [
      (hol:
         const real_abs :: real -> real
