def REAL_CONVEX_BOUND2_LT:
  prove(
    [
      (hol:
         var b :: real
         forall (x :: real, y :: real, a :: real, u :: real, v :: real):
           x < a && (y < b && ((0 :: real) <= u && ((0 :: real) <= v && u + v == (1 :: real))))
             ==> u * x + v * y < u * a + v * b),
      (
        (
          (
            (
              (
                REPEAT(GEN_TAC) then_tac \
                ASM_CASES_TAC(
                  (hol:
                     var u :: real
                     u == (0 :: real))
                )
              ) then_list \
              PairList [
                (
                  ASM_REWRITE_TAC(PairList [REAL_MUL_LZERO, REAL_ADD_LID]) then_tac \
                  REPEAT(STRIP_TAC)
                ),
                (
                  (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LTE_ADD2)) then_tac \
                  ASM_SIMP_TAC(PairList [REAL_LE_LMUL, REAL_LT_IMP_LE])
                )
              ]
            ) then_tac \
            MATCH_MP_TAC(REAL_LT_LMUL)
          ) then_tac \
          REPEAT(POP_ASSUM(MP_TAC))
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def REAL_CONVEX_BOUND2_LE:
  prove(
    [
      (hol:
         var b :: real
         forall (x :: real, y :: real, a :: real, u :: real, v :: real):
           x <= a && (y <= b && ((0 :: real) <= u && ((0 :: real) <= v && u + v == (1 :: real))))
             ==> u * x + v * y <= u * a + v * b),
      (
        (
          (
            (
              (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LE_ADD2)) then_tac \
              CONJ_TAC
            ) then_tac \
            MATCH_MP_TAC(REAL_LE_LMUL)
          ) then_tac \
          REPEAT(POP_ASSUM(MP_TAC))
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def REAL_CONVEX_BOUND_LT:
  prove(
    [
      (hol:
         forall (x :: real, y :: real, a :: real, u :: real, v :: real):
           x < a && (y < a && ((0 :: real) <= u && ((0 :: real) <= v && u + v == (1 :: real))))
             ==> u * x + v * y < a),
      MESON_TAC(
        PairList [
          REAL_CONVEX_BOUND2_LT,
          MESON(
            PairList [REAL_MUL_LID, REAL_ADD_RDISTRIB])(
            (hol:
               var u :: real
               var v :: real
               var a :: real
               u + v == (1 :: real) ==> u * a + v * a == a)
          )
        ]
      )
    ]
  )

def REAL_CONVEX_BOUND_LE:
  prove(
    [
      (hol:
         forall (x :: real, y :: real, a :: real, u :: real, v :: real):
           x <= a && (y <= a && ((0 :: real) <= u && ((0 :: real) <= v && u + v == (1 :: real))))
             ==> u * x + v * y <= a),
      MESON_TAC(
        PairList [
          REAL_CONVEX_BOUND2_LE,
          MESON(
            PairList [REAL_MUL_LID, REAL_ADD_RDISTRIB])(
            (hol:
               var u :: real
               var v :: real
               var a :: real
               u + v == (1 :: real) ==> u * a + v * a == a)
          )
        ]
      )
    ]
  )

def REAL_CONVEX_BOUND_GT:
  prove(
    [
      (hol:
         forall (x :: real, y :: real, a :: real, u :: real, v :: real):
           a < x && (a < y && ((0 :: real) <= u && ((0 :: real) <= v && u + v == (1 :: real))))
             ==> a < u * x + v * y),
      MESON_TAC(
        PairList [
          REAL_CONVEX_BOUND2_LT,
          MESON(
            PairList [REAL_MUL_LID, REAL_ADD_RDISTRIB])(
            (hol:
               var u :: real
               var v :: real
               var a :: real
               u + v == (1 :: real) ==> u * a + v * a == a)
          )
        ]
      )
    ]
  )

def REAL_CONVEX_BOUND_GE:
  prove(
    [
      (hol:
         forall (x :: real, y :: real, a :: real, u :: real, v :: real):
           a <= x && (a <= y && ((0 :: real) <= u && ((0 :: real) <= v && u + v == (1 :: real))))
             ==> a <= u * x + v * y),
      MESON_TAC(
        PairList [
          REAL_CONVEX_BOUND2_LE,
          MESON(
            PairList [REAL_MUL_LID, REAL_ADD_RDISTRIB])(
            (hol:
               var u :: real
               var v :: real
               var a :: real
               u + v == (1 :: real) ==> u * a + v * a == a)
          )
        ]
      )
    ]
  )

def REAL_CONVEX_BOUNDS_LE:
  prove(
    [
      (hol:
         forall (x :: real, y :: real, a :: real, b :: real, u :: real, v :: real):
           (a <= x
              && (x <= b
                    && (a <= y
                          && (y <= b && ((0 :: real) <= u && ((0 :: real) <= v && u + v == (1 :: real)))))))
             ==> a <= u * x + v * y && u * x + v * y <= b),
      MESON_TAC(
        PairList [
          REAL_CONVEX_BOUND2_LE,
          MESON(
            PairList [REAL_MUL_LID, REAL_ADD_RDISTRIB])(
            (hol:
               var u :: real
               var v :: real
               var a :: real
               u + v == (1 :: real) ==> u * a + v * a == a)
          )
        ]
      )
    ]
  )

def REAL_CONVEX_BOUNDS_LT:
  prove(
    [
      (hol:
         forall (x :: real, y :: real, a :: real, b :: real, u :: real, v :: real):
           (a < x
              && (x < b
                    && (a < y
                          && (y < b && ((0 :: real) <= u && ((0 :: real) <= v && u + v == (1 :: real)))))))
             ==> a < u * x + v * y && u * x + v * y < b),
      MESON_TAC(
        PairList [
          REAL_CONVEX_BOUND2_LT,
          MESON(
            PairList [REAL_MUL_LID, REAL_ADD_RDISTRIB])(
            (hol:
               var u :: real
               var v :: real
               var a :: real
               u + v == (1 :: real) ==> u * a + v * a == a)
          )
        ]
      )
    ]
  )

def REAL_ARCH_SIMPLE:
  let lemma:
    prove(
      [
        (hol:
           var P :: real -> bool
           const real_of_num :: num -> real
           (forall x :: real: (exists n :: num: x == real_of_num(n)) ==> P(x))
             <=> (forall n :: num: P(real_of_num(n)))),
        MESON_TAC(PairList [])
      ]
    )
  prove(
    [
      (hol:
         const real_of_num :: num -> real
         forall x :: real: exists n :: num: x <= real_of_num(n)),
      (
        (
          MP_TAC(
            SPEC(
              (hol:
                 const real_of_num :: num -> real
                 fun (y :: real): exists n :: num: y == real_of_num(n))
            )(REAL_COMPLETE)
          ) then_tac \
          REWRITE_TAC(PairList [lemma])
        ) then_tac \
        MESON_TAC(
          PairList [
            REAL_LE_SUB_LADD,
            REAL_OF_NUM_ADD,
            REAL_LE_TOTAL,
            REAL_ARITH(
              (hol:
                 var M :: real
                 !(M <= M - (1 :: real)))
            )
          ]
        )
      )
    ]
  )

def REAL_ARCH_LT:
  prove(
    [
      (hol:
         const real_of_num :: num -> real
         forall x :: real: exists n :: num: x < real_of_num(n)),
      MESON_TAC(
        PairList [
          REAL_ARCH_SIMPLE,
          REAL_OF_NUM_ADD,
          REAL_ARITH(
            (hol:
               var x :: real
               var n :: real
               x <= n ==> x < n + (1 :: real))
          )
        ]
      )
    ]
  )

def REAL_ARCH:
  prove(
    [
      (hol:
         const real_of_num :: num -> real
         forall x :: real:
           (0 :: real) < x ==> (forall y :: real: exists n :: num: y < real_of_num(n) * x)),
      MESON_TAC(PairList [REAL_ARCH_LT, REAL_LT_LDIV_EQ])
    ]
  )

def REAL_ARCH_INV:
  prove(
    [
      (hol:
         const real_inv :: real -> real
         const real_of_num :: num -> real
         forall e :: real:
           (0 :: real) < e
             <=> (exists n :: num:
                    n != (0 :: num)
                      && ((0 :: real) < real_inv(real_of_num(n)) && real_inv(real_of_num(n)) < e))),
      (
        (
          (
            (
              (
                (GEN_TAC then_tac EQ_TAC) then_list \
                PairList [ALL_TAC, MESON_TAC(PairList [REAL_LT_TRANS])]
              ) then_tac \
              DISCH_TAC
            ) then_tac \
            MP_TAC(
              SPEC(hol:
                     var e :: real
                     const real_inv :: real -> real
                     real_inv(e))(REAL_ARCH_LT)
            )
          ) then_tac \
          MATCH_MP_TAC(MONO_EXISTS)
        ) then_tac \
        ASM_MESON_TAC(
          PairList [REAL_LT_INV2, REAL_INV_INV, REAL_LT_INV_EQ, REAL_LT_TRANS, REAL_LT_ANTISYM]
        )
      )
    ]
  )

def REAL_POW_LBOUND:
  prove(
    [
      (hol:
         const real_of_num :: num -> real
         const real_pow :: real -> num -> real
         forall (x :: real, n :: num):
           (0 :: real) <= x ==> (1 :: real) + real_of_num(n) * x <= real_pow((1 :: real) + x, n)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (GEN_TAC then_tac REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM])) then_tac \
                      DISCH_TAC
                    ) then_tac \
                    INDUCT_TAC
                  ) then_tac \
                  REWRITE_TAC(PairList [real_pow, REAL_MUL_LZERO, REAL_ADD_RID, REAL_LE_REFL])
                ) then_tac \
                REWRITE_TAC(PairList [GSYM(REAL_OF_NUM_SUC)])
              ) then_tac \
              MATCH_MP_TAC(REAL_LE_TRANS)
            ) then_tac \
            EXISTS_TAC(
              (hol:
                 var x :: real
                 var n :: num
                 const real_of_num :: num -> real
                 ((1 :: real) + x) * ((1 :: real) + real_of_num(n) * x))
            )
          ) then_tac \
          ASM_SIMP_TAC(
            PairList [
              REAL_LE_LMUL,
              REAL_ARITH(
                (hol:
                   var x :: real
                   (0 :: real) <= x ==> (0 :: real) <= (1 :: real) + x)
              )
            ]
          )
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            REAL_LE_MUL,
            REAL_POS,
            REAL_ARITH(
              (hol:
                 var n :: real
                 var x :: real
                 (1 :: real) + (n + (1 :: real)) * x <= ((1 :: real) + x) * ((1 :: real) + n * x)
                   <=> (0 :: real) <= n * (x * x))
            )
          ]
        )
      )
    ]
  )

def REAL_ARCH_POW:
  prove(
    [
      (hol:
         const real_pow :: real -> num -> real
         forall (x :: real, y :: real): (1 :: real) < x ==> (exists n :: num: y < real_pow(x, n))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(STRIP_TAC) then_tac \
                          MP_TAC(
                            SPEC(
                              (hol:
                                 var x :: real
                                 x - (1 :: real))
                            )(REAL_ARCH)
                          )
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [REAL_SUB_LT])
                      ) then_tac \
                      DISCH_THEN(o(MP_TAC)(SPEC(hol:
                                                  var y :: real
                                                  y)))
                    ) then_tac \
                    MATCH_MP_TAC(MONO_EXISTS)
                  ) then_tac \
                  X_GEN_TAC(hol:
                              var n :: num
                              n)
                ) then_tac \
                DISCH_TAC
              ) then_tac \
              MATCH_MP_TAC(REAL_LTE_TRANS)
            ) then_tac \
            EXISTS_TAC(
              (hol:
                 var n :: num
                 var x :: real
                 const real_of_num :: num -> real
                 (1 :: real) + real_of_num(n) * (x - (1 :: real)))
            )
          ) then_tac \
          ASM_SIMP_TAC(
            PairList [
              REAL_ARITH(
                (hol:
                   var x :: real
                   var y :: real
                   x < y ==> x < (1 :: real) + y)
              )
            ]
          )
        ) then_tac \
        ASM_MESON_TAC(
          PairList [
            REAL_POW_LBOUND,
            REAL_SUB_ADD2,
            REAL_ARITH(
              (hol:
                 var x :: real
                 (1 :: real) < x ==> (0 :: real) <= x - (1 :: real))
            )
          ]
        )
      )
    ]
  )

def REAL_ARCH_POW2:
  prove(
    [
      (hol:
         const real_pow :: real -> num -> real
         forall x :: real: exists n :: num: x < real_pow((2 :: real), n)),
      SIMP_TAC(PairList [REAL_ARCH_POW, REAL_OF_NUM_LT, ARITH])
    ]
  )

def REAL_ARCH_POW_INV:
  prove(
    [
      (hol:
         const real_pow :: real -> num -> real
         forall (x :: real, y :: real):
           (0 :: real) < y && x < (1 :: real) ==> (exists n :: num: real_pow(x, n) < y)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(STRIP_TAC) then_tac \
                          ASM_CASES_TAC(
                            (hol:
                               var x :: real
                               (0 :: real) < x)
                          )
                        ) then_list \
                        PairList [
                          ALL_TAC,
                          ASM_MESON_TAC(PairList [REAL_POW_1, REAL_LET_TRANS, REAL_NOT_LT])
                        ]
                      ) then_tac \
                      SUBGOAL_THEN(
                        (hol:
                           var x :: real
                           const real_inv :: real -> real
                           real_inv((1 :: real)) < real_inv(x))
                      )(MP_TAC)
                    ) then_list \
                    PairList [ASM_SIMP_TAC(PairList [REAL_LT_INV2]), REWRITE_TAC(PairList [REAL_INV_1])]
                  ) then_tac \
                  DISCH_THEN(
                    o(
                      o(MP_TAC)(SPEC(hol:
                                       var y :: real
                                       const real_inv :: real -> real
                                       real_inv(y)))
                    )(MATCH_MP(REAL_ARCH_POW))
                  )
                ) then_tac \
                MATCH_MP_TAC(MONO_EXISTS)
              ) then_tac \
              GEN_TAC
            ) then_tac \
            DISCH_TAC
          ) then_tac \
          GEN_REWRITE_TAC(BINOP_CONV)(PairList [GSYM(REAL_INV_INV)])
        ) then_tac \
        ASM_SIMP_TAC(PairList [GSYM(REAL_POW_INV), REAL_LT_INV, REAL_LT_INV2])
      )
    ]
  )

def real_sgn:
  new_definition(
    (hol:
       var real_sgn :: real -> real
       var x :: real
       real_sgn(x)
         == (if (0 :: real) < x | (1 :: real) | (if x < (0 :: real) | -(1 :: real) | (0 :: real))))
  )

def REAL_SGN_0:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         real_sgn((0 :: real)) == (0 :: real)),
      (REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC)
    ]
  )

def REAL_SGN_NEG:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         forall x :: real: real_sgn(-x) == -real_sgn(x)),
      (REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC)
    ]
  )

def REAL_SGN_ABS:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         const real_abs :: real -> real
         forall x :: real: real_sgn(x) * real_abs(x) == x),
      (REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC)
    ]
  )

def REAL_SGN_ABS_ALT:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         const real_abs :: real -> real
         forall x :: real: real_sgn(x) * x == real_abs(x)),
      ((GEN_TAC then_tac REWRITE_TAC(PairList [real_sgn])) then_tac REAL_ARITH_TAC)
    ]
  )

def REAL_EQ_SGN_ABS:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         const real_abs :: real -> real
         forall (x :: real, y :: real):
           x == y <=> real_sgn(x) == real_sgn(y) && real_abs(x) == real_abs(y)),
      MESON_TAC(PairList [REAL_SGN_ABS])
    ]
  )

def REAL_ABS_SGN:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         const real_sgn :: real -> real
         forall x :: real: real_abs(real_sgn(x)) == real_sgn(real_abs(x))),
      (REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC)
    ]
  )

def REAL_SGN:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         const real_abs :: real -> real
         forall x :: real: real_sgn(x) == x / real_abs(x)),
      (
        (
          GEN_TAC then_tac \
          ASM_CASES_TAC(
            (hol:
               var x :: real
               x == (0 :: real))
          )
        ) then_list \
        PairList [
          ASM_REWRITE_TAC(PairList [real_div, REAL_MUL_LZERO, REAL_SGN_0]),
          (
            GEN_REWRITE_TAC(o(RAND_CONV)(LAND_CONV))(PairList [GSYM(REAL_SGN_ABS)]) then_tac \
            ASM_SIMP_TAC(
              PairList [
                real_div,
                GSYM(REAL_MUL_ASSOC),
                REAL_ABS_ZERO,
                REAL_MUL_RINV,
                REAL_MUL_RID
              ]
            )
          )
        ]
      )
    ]
  )

def REAL_SGN_MUL:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         forall (x :: real, y :: real): real_sgn(x * y) == real_sgn(x) * real_sgn(y)),
      (
        REWRITE_TAC(PairList [REAL_SGN, REAL_ABS_MUL, real_div, REAL_INV_MUL]) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def REAL_SGN_INV:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         const real_inv :: real -> real
         forall x :: real: real_sgn(real_inv(x)) == real_sgn(x)),
      REWRITE_TAC(
        PairList [
          real_sgn,
          REAL_LT_INV_EQ,
          GSYM(REAL_INV_NEG),
          REAL_ARITH(
            (hol:
               var x :: real
               x < (0 :: real) <=> (0 :: real) < -x)
          )
        ]
      )
    ]
  )

def REAL_SGN_DIV:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         forall (x :: real, y :: real): real_sgn(x / y) == real_sgn(x) / real_sgn(y)),
      (
        (
          REWRITE_TAC(PairList [REAL_SGN, REAL_ABS_DIV]) then_tac \
          REWRITE_TAC(PairList [real_div, REAL_INV_MUL, REAL_INV_INV])
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def REAL_SGN_EQ:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         (forall x :: real: real_sgn(x) == (0 :: real) <=> x == (0 :: real))
           && ((forall x :: real: real_sgn(x) == (1 :: real) <=> x > (0 :: real))
                 && (forall x :: real: real_sgn(x) == -(1 :: real) <=> x < (0 :: real)))),
      (REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC)
    ]
  )

def REAL_SGN_CASES:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         forall x :: real:
           real_sgn(x) == (0 :: real) || (real_sgn(x) == (1 :: real) || real_sgn(x) == -(1 :: real))),
      (REWRITE_TAC(PairList [real_sgn]) then_tac MESON_TAC(PairList []))
    ]
  )

def REAL_SGN_INEQS:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         (forall x :: real: (0 :: real) <= real_sgn(x) <=> (0 :: real) <= x)
           && ((forall x :: real: (0 :: real) < real_sgn(x) <=> (0 :: real) < x)
                 && ((forall x :: real: (0 :: real) >= real_sgn(x) <=> (0 :: real) >= x)
                       && ((forall x :: real: (0 :: real) > real_sgn(x) <=> (0 :: real) > x)
                             && ((forall x :: real: (0 :: real) == real_sgn(x) <=> (0 :: real) == x)
                                   && ((forall x :: real: real_sgn(x) <= (0 :: real) <=> x <= (0 :: real))
                                         && ((forall x :: real:
                                                real_sgn(x) < (0 :: real) <=> x < (0 :: real))
                                               && ((forall x :: real:
                                                      real_sgn(x) >= (0 :: real) <=> x >= (0 :: real))
                                                     && ((forall x :: real:
                                                            real_sgn(x) > (0 :: real) <=> x > (0 :: real))
                                                           && (forall x :: real:
                                                                 real_sgn(x) == (0 :: real) <=> x == (0 :: real))))))))))),
      (REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC)
    ]
  )

def REAL_SGN_POW:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         const real_pow :: real -> num -> real
         forall (x :: real, n :: num): real_sgn(real_pow(x, n)) == real_pow(real_sgn(x), n)),
      (
        (
          (GEN_TAC then_tac INDUCT_TAC) then_tac \
          ASM_REWRITE_TAC(PairList [REAL_SGN_MUL, real_pow])
        ) then_tac \
        REWRITE_TAC(PairList [real_sgn, REAL_LT_01])
      )
    ]
  )

def REAL_SGN_POW_2:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         const real_pow :: real -> num -> real
         const real_abs :: real -> real
         forall x :: real: real_sgn(real_pow(x, (2 :: num))) == real_sgn(real_abs(x))),
      (
        (
          REWRITE_TAC(PairList [real_sgn]) then_tac \
          SIMP_TAC(
            PairList [
              GSYM(REAL_NOT_LE),
              REAL_ABS_POS,
              REAL_LE_POW_2,
              REAL_ARITH(
                (hol:
                   var x :: real
                   (0 :: real) <= x ==> (x <= (0 :: real) <=> x == (0 :: real)))
              )
            ]
          )
        ) then_tac \
        REWRITE_TAC(PairList [REAL_POW_EQ_0, REAL_ABS_ZERO, ARITH])
      )
    ]
  )

def REAL_SGN_REAL_SGN:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         forall x :: real: real_sgn(real_sgn(x)) == real_sgn(x)),
      (REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC)
    ]
  )

def REAL_INV_SGN:
  prove(
    [
      (hol:
         const real_inv :: real -> real
         const real_sgn :: real -> real
         forall x :: real: real_inv(real_sgn(x)) == real_sgn(x)),
      (
        (
          (GEN_TAC then_tac REWRITE_TAC(PairList [real_sgn])) then_tac \
          REPEAT(COND_CASES_TAC)
        ) then_tac \
        REWRITE_TAC(PairList [REAL_INV_0, REAL_INV_1, REAL_INV_NEG])
      )
    ]
  )

def REAL_SGN_EQ_INEQ:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         const real_abs :: real -> real
         const real_max :: real -> real -> real
         forall (x :: real, y :: real):
           real_sgn(x) == real_sgn(y)
             <=> x == y || real_abs(x - y) < real_max(real_abs(x), real_abs(y))),
      (REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC)
    ]
  )

def REAL_SGNS_EQ:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         forall (x :: real, y :: real):
           real_sgn(x) == real_sgn(y)
             <=> ((x == (0 :: real) <=> y == (0 :: real))
                    && ((x > (0 :: real) <=> y > (0 :: real)) && (x < (0 :: real) <=> y < (0 :: real))))),
      (REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC)
    ]
  )

def REAL_SGNS_EQ_ALT:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         forall (x :: real, y :: real):
           real_sgn(x) == real_sgn(y)
             <=> ((x == (0 :: real) ==> y == (0 :: real))
                    && ((x > (0 :: real) ==> y > (0 :: real)) && (x < (0 :: real) ==> y < (0 :: real))))),
      (REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC)
    ]
  )

def REAL_WLOG_LE:
  prove(
    [
      (hol:
         var P :: real -> real -> bool
         ((forall (x :: real, y :: real): P(x, y) <=> P(y, x))
            && (forall (x :: real, y :: real): x <= y ==> P(x, y)))
           ==> (forall (x :: real, y :: real): P(x, y))),
      MESON_TAC(PairList [REAL_LE_TOTAL])
    ]
  )

def REAL_WLOG_LT:
  prove(
    [
      (hol:
         var P :: real -> real -> bool
         ((forall x :: real: P(x, x))
            && ((forall (x :: real, y :: real): P(x, y) <=> P(y, x))
                  && (forall (x :: real, y :: real): x < y ==> P(x, y))))
           ==> (forall (x :: real, y :: real): P(x, y))),
      MESON_TAC(PairList [REAL_LT_TOTAL])
    ]
  )

def REAL_WLOG_LE_3:
  prove(
    [
      (hol:
         forall P :: real -> real -> real -> bool:
           ((forall (x :: real, y :: real, z :: real): P(x, y, z) ==> P(y, x, z) && P(x, z, y))
              && (forall (x :: real, y :: real, z :: real): x <= y && y <= z ==> P(x, y, z)))
             ==> (forall (x :: real, y :: real, z :: real): P(x, y, z))),
      MESON_TAC(PairList [REAL_LE_TOTAL])
    ]
  )

def real_sqrt:
  new_definition(
    (hol:
       var sqrt :: real -> real
       var x :: real
       const select as "@" :: (real -> bool) -> real
       const real_sgn :: real -> real
       const real_pow :: real -> num -> real
       const real_abs :: real -> real
       sqrt(x)
         == select(
              fun (y :: real): real_sgn(y) == real_sgn(x) && real_pow(y, (2 :: num)) == real_abs(x)
            ))
  )

def SQRT_UNIQUE:
  prove(
    [
      (hol:
         const real_pow :: real -> num -> real
         const sqrt :: real -> real
         forall (x :: real, y :: real):
           (0 :: real) <= y && real_pow(y, (2 :: num)) == x ==> sqrt(x) == y),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [real_sqrt])) then_tac \
                        MATCH_MP_TAC(SELECT_UNIQUE)
                      ) then_tac \
                      FIRST_X_ASSUM(o(SUBST1_TAC)(SYM))
                    ) then_tac \
                    REWRITE_TAC(PairList [REAL_SGN_POW_2, REAL_ABS_POW])
                  ) then_tac \
                  X_GEN_TAC(hol:
                              var z :: real
                              z)
                ) then_tac \
                ASM_REWRITE_TAC(PairList [real_abs])
              ) then_tac \
              REWRITE_TAC(
                PairList [
                  REAL_ENTIRE,
                  REAL_SUB_0,
                  REAL_ARITH(
                    (hol:
                       var x :: real
                       var y :: real
                       const real_pow :: real -> num -> real
                       real_pow(x, (2 :: num)) == real_pow(y, (2 :: num)) <=> (x - y) * (x - -y) == (0 :: real))
                  )
                ]
              )
            ) then_tac \
            REWRITE_TAC(PairList [real_sgn])
          ) then_tac \
          REPEAT(POP_ASSUM(MP_TAC))
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def POW_2_SQRT:
  prove(
    [
      (hol:
         const sqrt :: real -> real
         const real_pow :: real -> num -> real
         forall x :: real: (0 :: real) <= x ==> sqrt(real_pow(x, (2 :: num))) == x),
      MESON_TAC(PairList [SQRT_UNIQUE])
    ]
  )

def SQRT_0:
  prove(
    [
      (hol:
         const sqrt :: real -> real
         sqrt((0 :: real)) == (0 :: real)),
      MESON_TAC(PairList [SQRT_UNIQUE, REAL_POW_2, REAL_MUL_LZERO, REAL_POS])
    ]
  )

def SQRT_1:
  prove(
    [
      (hol:
         const sqrt :: real -> real
         sqrt((1 :: real)) == (1 :: real)),
      MESON_TAC(PairList [SQRT_UNIQUE, REAL_POW_2, REAL_MUL_LID, REAL_POS])
    ]
  )

def POW_2_SQRT_ABS:
  prove(
    [
      (hol:
         const sqrt :: real -> real
         const real_pow :: real -> num -> real
         const real_abs :: real -> real
         forall x :: real: sqrt(real_pow(x, (2 :: num))) == real_abs(x)),
      (
        (
          (GEN_TAC then_tac MATCH_MP_TAC(SQRT_UNIQUE)) then_tac \
          REWRITE_TAC(PairList [REAL_ABS_POS, REAL_POW_2, GSYM(REAL_ABS_MUL)])
        ) then_tac \
        REWRITE_TAC(PairList [real_abs, REAL_LE_SQUARE])
      )
    ]
  )

def SQRT_WORKS_GEN:
  let lemma:
    prove(
      [
        (hol:
           const real_pow :: real -> num -> real
           forall (x :: real, y :: real):
             real_pow(x, (2 :: num)) < y
               ==> (exists x_prime as "x'" :: real: x < x_prime && real_pow(x_prime, (2 :: num)) < y)),
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REPEAT(STRIP_TAC) then_tac \
                        EXISTS_TAC(
                          (hol:
                             var x :: real
                             var y :: real
                             const real_abs :: real -> real
                             const real_min :: real -> real -> real
                             const real_pow :: real -> num -> real
                             real_abs(x)
                               + real_min(
                                   (1 :: real),
                                   (y - real_pow(x, (2 :: num))) / ((2 :: real) * real_abs(x) + (2 :: real))
                                 ))
                        )
                      ) then_tac \
                      ASSUME_TAC(
                        REAL_ARITH(
                          (hol:
                             var x :: real
                             const real_abs :: real -> real
                             (0 :: real) < (2 :: real) * real_abs(x) + (1 :: real)
                               && (0 :: real) < (2 :: real) * real_abs(x) + (2 :: real))
                        )
                      )
                    ) then_tac \
                    ASM_SIMP_TAC(
                      PairList [
                        REAL_LT_DIV,
                        REAL_SUB_LT,
                        REAL_ARITH(
                          (hol:
                             var y :: real
                             var x :: real
                             const real_abs :: real -> real
                             const real_min :: real -> real -> real
                             (0 :: real) < y ==> x < real_abs(x) + real_min((1 :: real), y))
                        )
                      ]
                    )
                  ) then_tac \
                  REWRITE_TAC(
                    PairList [
                      REAL_ARITH(
                        (hol:
                           var x :: real
                           var e :: real
                           const real_pow :: real -> num -> real
                           real_pow(x + e, (2 :: num)) == e * ((2 :: real) * x + e) + real_pow(x, (2 :: num)))
                      )
                    ]
                  )
                ) then_tac \
                REWRITE_TAC(PairList [REAL_POW2_ABS, GSYM(REAL_LT_SUB_LADD)])
              ) then_tac \
              TRANS_TAC(REAL_LET_TRANS)(
                (hol:
                   var y :: real
                   var x :: real
                   const real_pow :: real -> num -> real
                   const real_abs :: real -> real
                   (y - real_pow(x, (2 :: num)))
                     / ((2 :: real) * real_abs(x) + (2 :: real))
                     * ((2 :: real) * real_abs(x) + (1 :: real)))
              )
            ) then_tac \
            CONJ_TAC
          ) then_list \
          PairList [
            (
              (
                (
                  MATCH_MP_TAC(REAL_LE_MUL2) then_tac \
                  REWRITE_TAC(PairList [REAL_LE_MIN, REAL_POS, REAL_MIN_LE, REAL_LE_REFL])
                ) then_tac \
                ASM_SIMP_TAC(
                  PairList [
                    REAL_LE_ADD,
                    REAL_POS,
                    REAL_LE_MUL,
                    REAL_ABS_POS,
                    REAL_LT_IMP_LE,
                    REAL_LT_DIV,
                    REAL_SUB_LT,
                    REAL_LE_MIN
                  ]
                )
              ) then_tac \
              REWRITE_TAC(PairList [REAL_LE_LADD, REAL_MIN_LE, REAL_LE_REFL])
            ),
            (
              (
                (
                  SIMP_TAC(
                    PairList [
                      real_div,
                      REAL_ARITH(
                        (hol:
                           var a :: real
                           var b :: real
                           var c :: real
                           const real_inv :: real -> real
                           a * real_inv(b) * c == a * c * real_inv(b))
                      )
                    ]
                  ) then_tac \
                  REWRITE_TAC(PairList [GSYM(real_div)])
                ) then_tac \
                ASM_SIMP_TAC(PairList [REAL_LT_LDIV_EQ, REAL_LT_LMUL_EQ, REAL_SUB_LT])
              ) then_tac \
              REAL_ARITH_TAC
            )
          ]
        )
      ]
    )
  let lemma_prime:
    prove(
      [
        (hol:
           const real_pow :: real -> num -> real
           forall (x :: real, y :: real):
             (0 :: real) < x && ((0 :: real) < y && y < real_pow(x, (2 :: num)))
               ==> (exists x_prime as "x'" :: real:
                      x_prime < x && ((0 :: real) < x_prime && y < real_pow(x_prime, (2 :: num))))),
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    REPEAT(STRIP_TAC) then_tac \
                                    MP_TAC(
                                      ISPECL(
                                        PairList [
                                          (hol:
                                             var x :: real
                                             const real_inv :: real -> real
                                             const real_abs :: real -> real
                                             real_inv(real_abs(x))),
                                          (hol:
                                             var y :: real
                                             const real_inv :: real -> real
                                             real_inv(y))
                                        ])(
                                        lemma
                                      )
                                    )
                                  ) then_tac \
                                  ASM_SIMP_TAC(PairList [REAL_POW_INV, REAL_POW2_ABS, REAL_LT_INV2])
                                ) then_tac \
                                REWRITE_TAC(PairList [GSYM(REAL_ABS_INV)])
                              ) then_tac \
                              DISCH_THEN(X_CHOOSE_THEN(hol:
                                                         var x_prime as "x'" :: real
                                                         x_prime)(STRIP_ASSUME_TAC))
                            ) then_tac \
                            EXISTS_TAC(hol:
                                         var x_prime as "x'" :: real
                                         const real_inv :: real -> real
                                         real_inv(x_prime))
                          ) then_tac \
                          REWRITE_TAC(PairList [REAL_POW_INV])
                        ) then_tac \
                        REWRITE_TAC(PairList [REAL_LT_INV_EQ])
                      ) then_tac \
                      CONJ_TAC
                    ) then_list \
                    PairList [
                      GEN_REWRITE_TAC(RAND_CONV)(PairList [GSYM(REAL_INV_INV)]),
                      (
                        (
                          CONJ_TAC then_list \
                          PairList [
                            (REPEAT(POP_ASSUM(MP_TAC)) then_tac REAL_ARITH_TAC),
                            ALL_TAC
                          ]
                        ) then_tac \
                        GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_INV_INV)])
                      )
                    ]
                  ) then_tac \
                  MATCH_MP_TAC(REAL_LT_INV2)
                ) then_tac \
                (
                  CONJ_TAC then_list \
                  PairList [
                    ALL_TAC,
                    (REPEAT(POP_ASSUM(MP_TAC)) then_tac REAL_ARITH_TAC)
                  ]
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [REAL_LT_INV_EQ, REAL_LT_POW_2])
            ) then_tac \
            REPEAT(POP_ASSUM(MP_TAC))
          ) then_tac \
          REAL_ARITH_TAC
        )
      ]
    )
  let main_lemma:
    prove(
      [
        (hol:
           const real_pow :: real -> num -> real
           forall y :: real: (0 :: real) < y ==> (exists x :: real: real_pow(x, (2 :: num)) == y)),
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REPEAT(STRIP_TAC) then_tac \
                        FIRST_ASSUM(o(ASSUME_TAC)(MATCH_MP(REAL_LT_IMP_NZ)))
                      ) then_tac \
                      MP_TAC(
                        ISPEC(
                          (hol:
                             var y :: real
                             const real_pow :: real -> num -> real
                             fun (x :: real): (0 :: real) <= x && real_pow(x, (2 :: num)) <= y))(
                          REAL_COMPLETE
                        )
                      )
                    ) then_tac \
                    REWRITE_TAC(PairList [])
                  ) then_tac \
                  ANTS_TAC
                ) then_list \
                PairList [
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        CONJ_TAC then_list \
                                        PairList [
                                          (
                                            (
                                              EXISTS_TAC(
                                                (hol:
                                                   (0 :: real))
                                              ) then_tac \
                                              REPEAT(POP_ASSUM(MP_TAC))
                                            ) then_tac \
                                            REAL_ARITH_TAC
                                          ),
                                          ALL_TAC
                                        ]
                                      ) then_tac \
                                      EXISTS_TAC(
                                        (hol:
                                           var y :: real
                                           y + (1 :: real))
                                      )
                                    ) then_tac \
                                    X_GEN_TAC(hol:
                                                var x :: real
                                                x)
                                  ) then_tac \
                                  DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC))
                                ) then_tac \
                                GEN_REWRITE_TAC(I)(PairList [GSYM(CONTRAPOS_THM)])
                              ) then_tac \
                              REWRITE_TAC(PairList [REAL_NOT_LE])
                            ) then_tac \
                            DISCH_TAC
                          ) then_tac \
                          TRANS_TAC(REAL_LET_TRANS)(
                            (hol:
                               var y :: real
                               const real_pow :: real -> num -> real
                               real_pow(y + (1 :: real), (2 :: num)))
                          )
                        ) then_tac \
                        ASM_SIMP_TAC(
                          PairList [
                            GSYM(REAL_LT_SQUARE_ABS),
                            REAL_POW_LT,
                            REAL_ARITH(
                              (hol:
                                 var y :: real
                                 const real_pow :: real -> num -> real
                                 (0 :: real) < y && (0 :: real) < real_pow(y, (2 :: num))
                                   ==> y <= real_pow(y + (1 :: real), (2 :: num)))
                            )
                          ]
                        )
                      ) then_tac \
                      REPEAT(POP_ASSUM(MP_TAC))
                    ) then_tac \
                    REAL_ARITH_TAC
                  ),
                  (
                    (
                      MATCH_MP_TAC(MONO_EXISTS) then_tac \
                      X_GEN_TAC(hol:
                                  var s :: real
                                  s)
                    ) then_tac \
                    STRIP_TAC
                  )
                ]
              ) then_tac \
              REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM), GSYM(REAL_NOT_LT)])
            ) then_tac \
            REPEAT(STRIP_TAC)
          ) then_list \
          PairList [
            (
              (
                (
                  MP_TAC(
                    ISPECL(PairList [(hol:
                                        var s :: real
                                        s), (hol:
                                                                  var y :: real
                                                                  y)])(lemma_prime)
                  ) then_tac \
                  ASM_REWRITE_TAC(PairList [NOT_IMP])
                ) then_tac \
                CONJ_TAC
              ) then_list \
              PairList [
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  UNDISCH_TAC(
                                    (hol:
                                       var y :: real
                                       var s :: real
                                       const real_pow :: real -> num -> real
                                       y < real_pow(s, (2 :: num)))
                                  ) then_tac \
                                  ASM_CASES_TAC(
                                    (hol:
                                       var s :: real
                                       s == (0 :: real))
                                  )
                                ) then_tac \
                                ASM_REWRITE_TAC(PairList [REAL_LT_LE])
                              ) then_tac \
                              REWRITE_TAC(PairList [REAL_POW_ZERO])
                            ) then_tac \
                            CONV_TAC(NUM_REDUCE_CONV)
                          ) then_tac \
                          ASM_REWRITE_TAC(PairList [REAL_NOT_LE])
                        ) then_tac \
                        STRIP_TAC
                      ) then_tac \
                      FIRST_X_ASSUM(MATCH_MP_TAC)
                    ) then_tac \
                    UNDISCH_TAC(
                      (hol:
                         var y :: real
                         (0 :: real) < y)
                    )
                  ) then_tac \
                  REAL_ARITH_TAC
                ),
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      DISCH_THEN(
                                        X_CHOOSE_THEN(hol:
                                                        var z :: real
                                                        z)(CONJUNCTS_THEN2(MP_TAC)(STRIP_ASSUME_TAC))
                                      ) then_tac \
                                      REWRITE_TAC(PairList [REAL_NOT_LT])
                                    ) then_tac \
                                    FIRST_X_ASSUM(MATCH_MP_TAC)
                                  ) then_tac \
                                  X_GEN_TAC(hol:
                                              var x :: real
                                              x)
                                ) then_tac \
                                DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC))
                              ) then_tac \
                              GEN_REWRITE_TAC(I)(PairList [GSYM(CONTRAPOS_THM)])
                            ) then_tac \
                            REWRITE_TAC(PairList [REAL_NOT_LE])
                          ) then_tac \
                          DISCH_TAC
                        ) then_tac \
                        TRANS_TAC(REAL_LTE_TRANS)(
                          (hol:
                             var z :: real
                             const real_pow :: real -> num -> real
                             real_pow(z, (2 :: num)))
                        )
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [GSYM(REAL_LE_SQUARE_ABS)])
                    ) then_tac \
                    REPEAT(POP_ASSUM(MP_TAC))
                  ) then_tac \
                  REAL_ARITH_TAC
                )
              ]
            ),
            (
              (
                (
                  (
                    (
                      MP_TAC(ISPECL(PairList [(hol:
                                                 var s :: real
                                                 s), (hol:
                                                                           var y :: real
                                                                           y)])(lemma)) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_tac \
                    DISCH_THEN(
                      X_CHOOSE_THEN(hol:
                                      var z :: real
                                      z)(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC))
                    )
                  ) then_tac \
                  MATCH_MP_TAC(
                    REAL_ARITH(
                      (hol:
                         var z :: real
                         var s :: real
                         const real_abs :: real -> real
                         real_abs(z) <= s ==> s < z ==> #false)
                    )
                  )
                ) then_tac \
                FIRST_X_ASSUM(MATCH_MP_TAC)
              ) then_tac \
              ASM_SIMP_TAC(PairList [REAL_ABS_POS, REAL_POW2_ABS, REAL_LT_IMP_LE])
            )
          ]
        )
      ]
    )
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         const sqrt :: real -> real
         const real_pow :: real -> num -> real
         const real_abs :: real -> real
         forall x :: real:
           real_sgn(sqrt(x)) == real_sgn(x) && real_pow(sqrt(x), (2 :: num)) == real_abs(x)),
      (
        (
          (
            (GEN_TAC then_tac REWRITE_TAC(PairList [real_sqrt])) then_tac \
            CONV_TAC(SELECT_CONV)
          ) then_tac \
          SUBGOAL_THEN(
            (hol:
               const real_pow :: real -> num -> real
               forall x :: real:
                 (0 :: real) < x ==> (exists y :: real: (0 :: real) < y && real_pow(y, (2 :: num)) == x))
          )(ASSUME_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REPEAT(STRIP_TAC) then_tac \
                            MP_TAC(SPEC(hol:
                                          var x :: real
                                          x)(main_lemma))
                          ) then_tac \
                          ASM_REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM])
                        ) then_tac \
                        X_GEN_TAC(hol:
                                    var y :: real
                                    y)
                      ) then_tac \
                      STRIP_TAC
                    ) then_tac \
                    EXISTS_TAC(hol:
                                 var y :: real
                                 const real_abs :: real -> real
                                 real_abs(y))
                  ) then_tac \
                  ASM_REWRITE_TAC(PairList [REAL_POW2_ABS, GSYM(REAL_ABS_NZ)])
                ) then_tac \
                DISCH_THEN(SUBST_ALL_TAC)
              ) then_tac \
              REPEAT(POP_ASSUM(MP_TAC))
            ) then_tac \
            REAL_ARITH_TAC
          ),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              ASM_CASES_TAC(
                                (hol:
                                   var x :: real
                                   x == (0 :: real))
                              ) then_tac \
                              ASM_REWRITE_TAC(PairList [REAL_SGN_0, REAL_SGN_EQ, UNWIND_THM2])
                            ) then_tac \
                            REWRITE_TAC(PairList [REAL_ABS_NUM, REAL_POW_ZERO, ARITH])
                          ) then_tac \
                          FIRST_X_ASSUM(
                            o(MP_TAC)(SPEC(hol:
                                             var x :: real
                                             const real_abs :: real -> real
                                             real_abs(x)))
                          )
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [GSYM(REAL_ABS_NZ)])
                      ) then_tac \
                      DISCH_THEN(X_CHOOSE_THEN(hol:
                                                 var y :: real
                                                 y)(STRIP_ASSUME_TAC))
                    ) then_tac \
                    EXISTS_TAC(
                      (hol:
                         var x :: real
                         var y :: real
                         const real_sgn :: real -> real
                         real_sgn(x) * y)
                    )
                  ) then_tac \
                  ASM_REWRITE_TAC(PairList [REAL_POW_MUL, GSYM(REAL_SGN_POW), REAL_SGN_POW_2])
                ) then_tac \
                REWRITE_TAC(PairList [REAL_SGN_MUL, REAL_SGN_REAL_SGN])
              ) then_tac \
              ASM_SIMP_TAC(
                PairList [
                  real_sgn,
                  REAL_ARITH(
                    (hol:
                       var x :: real
                       const real_abs :: real -> real
                       (0 :: real) < real_abs(x) <=> x != (0 :: real))
                  )
                ]
              )
            ) then_tac \
            REWRITE_TAC(PairList [REAL_MUL_LID, REAL_MUL_RID])
          )
        ]
      )
    ]
  )

def SQRT_UNIQUE_GEN:
  prove(
    [
      (hol:
         const real_sgn :: real -> real
         const real_pow :: real -> num -> real
         const real_abs :: real -> real
         const sqrt :: real -> real
         forall (x :: real, y :: real):
           real_sgn(y) == real_sgn(x) && real_pow(y, (2 :: num)) == real_abs(x) ==> sqrt(x) == y),
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(GEN_TAC) then_tac \
                    MP_TAC(GSYM(SPEC(hol:
                                       var x :: real
                                       x)(SQRT_WORKS_GEN)))
                  ) then_tac \
                  SIMP_TAC(
                    PairList [
                      REAL_ENTIRE,
                      REAL_SUB_0,
                      REAL_ARITH(
                        (hol:
                           var x :: real
                           var y :: real
                           const real_pow :: real -> num -> real
                           real_pow(x, (2 :: num)) == real_pow(y, (2 :: num)) <=> (x - y) * (x - -y) == (0 :: real))
                      )
                    ]
                  )
                ) then_tac \
                DISCH_THEN(K(ALL_TAC))
              ) then_tac \
              REWRITE_TAC(PairList [IMP_CONJ_ALT])
            ) then_tac \
            STRIP_TAC
          ) then_tac \
          ASM_REWRITE_TAC(PairList [REAL_SGN_NEG])
        ) then_tac \
        SIMP_TAC(
          PairList [
            REAL_ARITH(
              (hol:
                 var x :: real
                 -x == x <=> x == (0 :: real))
            ),
            REAL_SGN_EQ,
            REAL_NEG_0,
            SQRT_0
          ]
        )
      )
    ]
  )

def SQRT_NEG:
