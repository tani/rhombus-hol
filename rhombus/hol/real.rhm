def REAL_POW_MONO:
  prove(
    [
      @hol|{!m n x. &1 <= x /\ m <= n ==> x pow m <= x pow n}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [LE_EXISTS]) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC)) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{d:num}|)(SUBST1_TAC)) then_tac \
      REWRITE_TAC(PairList [REAL_POW_ADD]) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_MUL_RID)]) then_tac \
      MATCH_MP_TAC(REAL_LE_LMUL) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(REAL_LE_TRANS) then_tac \
        EXISTS_TAC(
          @hol|{&1}|
        ) then_tac \
        REWRITE_TAC(PairList [REAL_OF_NUM_LE, ARITH]) then_tac \
        MATCH_MP_TAC(REAL_POW_LE_1) then_tac \
        ASM_REWRITE_TAC(PairList []),
        MATCH_MP_TAC(REAL_POW_LE_1) then_tac ASM_REWRITE_TAC(PairList [])
      ]
    ]
  )

def REAL_POW_LT2:
  prove(
    [
      @hol|{!n x y. ~(n = 0) /\ &0 <= x /\ x < y ==> x pow n < y pow n}|,
      INDUCT_TAC then_tac REWRITE_TAC(PairList [NOT_SUC, real_pow]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
