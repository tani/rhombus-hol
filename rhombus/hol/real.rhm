          CONJ_TAC
        ) then_list \
        PairList [
          (
            (
              MATCH_MP_TAC(REAL_LT_MUL) then_tac \
              POP_ASSUM_LIST(o(MP_TAC)(end_itlist(CONJ)))
            ) then_tac \
            REAL_ARITH_TAC
          ),
          (
            SUBGOAL_THEN(
              (hol:
                 var x :: real
                 var y :: real
                 const real_inv :: real -> real
                 real_inv(x) * x == (1 :: real) && real_inv(y) * y == (1 :: real))
            )(ASSUME_TAC) then_list \
            PairList [
              (
                (
                  (CONJ_TAC then_tac MATCH_MP_TAC(REAL_MUL_LINV)) then_tac \
                  POP_ASSUM_LIST(o(MP_TAC)(end_itlist(CONJ)))
                ) then_tac \
                REAL_ARITH_TAC
              ),
              (
                (
                  ASM_REWRITE_TAC(PairList [REAL_MUL_ASSOC, REAL_MUL_LID]) then_tac \
                  GEN_REWRITE_TAC(o(LAND_CONV)(LAND_CONV))(PairList [REAL_MUL_SYM])
                ) then_tac \
                ASM_REWRITE_TAC(PairList [GSYM(REAL_MUL_ASSOC), REAL_MUL_RID])
              )
            ]
          )
        ]
      )
    ]
  )

