      ) then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(REAL_LT_LMUL))) then_tac \
      POP_ASSUM(o(o(ASSUME_TAC)(MATCH_MP(REAL_MUL_LINV)))(MATCH_MP(REAL_LT_IMP_NZ))) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_MUL_ASSOC, REAL_MUL_LID])
