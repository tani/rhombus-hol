def REAL_DOWN:
  prove(
    [
      (hol:
         forall d :: real: (0 :: real) < d ==> (exists e :: real: (0 :: real) < e && e < d)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (GEN_TAC then_tac DISCH_TAC) then_tac \
                        EXISTS_TAC(
                          (hol:
                             var d :: real
                             d / (2 :: real))
                        )
                      ) then_tac \
                      ASSUME_TAC(
                        REAL_ARITH(
                          (hol:
                             (0 :: real) < (2 :: real))
                        )
                      )
                    ) then_tac \
                    ASSUME_TAC(
                      MATCH_MP(REAL_MUL_LINV)(
                        REAL_ARITH(
                          (hol:
                             (2 :: real) != (0 :: real))
                        )
                      )
                    )
                  ) then_tac \
                  CONJ_TAC
                ) then_tac \
                MATCH_MP_TAC(REAL_LT_RCANCEL_IMP)
              ) then_tac \
              EXISTS_TAC(
                (hol:
                   (2 :: real))
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [real_div, GSYM(REAL_MUL_ASSOC), REAL_MUL_RID])
          ) then_tac \
          UNDISCH_TAC(
            (hol:
               var d :: real
               (0 :: real) < d)
          )
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

