def real_sqrt:
  new_definition(
    Host.hol_term(Eq(
      Real,
      App(Var("sqrt", Fun(Real, Real)), [Var("x", Real)]),
      App(
        Const("@", Fun(Fun(Real, Bool), Real)),
        [
          Lambda(
            "y",
            Real,
            And(
              Eq(
                Real,
                App(Const("real_sgn", Fun(Real, Real)), [Ref("y")]),
                App(Const("real_sgn", Fun(Real, Real)), [Var("x", Real)])
              ),
              Eq(
                Real,
                App(
                  Const("real_pow", Fun(Real, Fun(Num, Real))),
                  [
                    Ref("y"),
                    App(
                      Const("NUMERAL", Fun(Num, Num)),
                      [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                    )
                  ]
                ),
                App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])
              )
            )
          )
        ]
      )
    ))
  )

def SQRT_UNIQUE:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Implies(
            And(
              App(
                Const("real_le", Fun(Real, Fun(Real, Bool))),
                [
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  ),
                  Ref("y")
                ]
              ),
              Eq(
                Real,
                App(
                  Const("real_pow", Fun(Real, Fun(Num, Real))),
                  [
                    Ref("y"),
                    App(
                      Const("NUMERAL", Fun(Num, Num)),
                      [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                    )
                  ]
                ),
                Ref("x")
              )
            ),
            Eq(Real, App(Const("sqrt", Fun(Real, Real)), [Ref("x")]), Ref("y"))
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [real_sqrt])) then_tac \
                        MATCH_MP_TAC(SELECT_UNIQUE)
                      ) then_tac \
                      FIRST_X_ASSUM(o(SUBST1_TAC)(SYM))
                    ) then_tac \
                    REWRITE_TAC(PairList [REAL_SGN_POW_2, REAL_ABS_POW])
                  ) then_tac \
                  X_GEN_TAC(Host.hol_term(Var("z", Real)))
                ) then_tac \
                ASM_REWRITE_TAC(PairList [real_abs])
              ) then_tac \
              REWRITE_TAC(
                PairList [
                  REAL_ENTIRE,
                  REAL_SUB_0,
                  REAL_ARITH(
                    Host.hol_term(Iff(
                      Eq(
                        Real,
                        App(
                          Const("real_pow", Fun(Real, Fun(Num, Real))),
                          [
                            Var("x", Real),
                            App(
                              Const("NUMERAL", Fun(Num, Num)),
                              [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                            )
                          ]
                        ),
                        App(
                          Const("real_pow", Fun(Real, Fun(Num, Real))),
                          [
                            Var("y", Real),
                            App(
                              Const("NUMERAL", Fun(Num, Num)),
                              [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                            )
                          ]
                        )
                      ),
                      Eq(
                        Real,
                        App(
                          Const("real_mul", Fun(Real, Fun(Real, Real))),
                          [
                            App(Const("real_sub", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)]),
                            App(
                              Const("real_sub", Fun(Real, Fun(Real, Real))),
                              [Var("x", Real), App(Const("real_neg", Fun(Real, Real)), [Var("y", Real)])]
                            )
                          ]
                        ),
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                        )
                      )
                    ))
                  )
                ]
              )
            ) then_tac \
            REWRITE_TAC(PairList [real_sgn])
