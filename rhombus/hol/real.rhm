def REAL_MAX_ACI:
  prove(
    [
      (hol:
         var x :: real
         var y :: real
         var z :: real
         const real_max :: real -> real -> real
         real_max(x, y) == real_max(y, x)
           && (real_max(real_max(x, y), z) == real_max(x, real_max(y, z))
                 && (real_max(x, real_max(y, z)) == real_max(y, real_max(x, z))
                       && (real_max(x, x) == x && real_max(x, real_max(x, y)) == real_max(x, y))))),
