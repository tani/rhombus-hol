def REAL_POW_MONO_LT:
  prove(
    [
      @hol|{!m n x. &1 < x /\ m < n ==> x pow m < x pow n}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [LT_EXISTS]) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC)) then_tac \
      DISCH_THEN(CHOOSE_THEN(SUBST_ALL_TAC)) then_tac \
      REWRITE_TAC(PairList [REAL_POW_ADD]) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_MUL_RID)]) then_tac \
      MATCH_MP_TAC(REAL_LT_LMUL) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(REAL_POW_LT) then_tac MATCH_MP_TAC(REAL_LT_TRANS) then_tac \
        EXISTS_TAC(
          @hol|{&1}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList [REAL_OF_NUM_LT, ARITH]),
        SPEC_TAC([@hol|{d:num}|, @hol|{d:num}|]) then_tac \
        INDUCT_TAC then_tac \
        ONCE_REWRITE_TAC(PairList [real_pow]) then_list \
        PairList [
          ASM_REWRITE_TAC(PairList [real_pow, REAL_MUL_RID]),
          ALL_TAC
        ] then_tac \
        GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_MUL_LID)]) then_tac \
        MATCH_MP_TAC(REAL_LT_MUL2) then_tac \
        ASM_REWRITE_TAC(PairList [REAL_OF_NUM_LE, ARITH])
      ]
    ]
  )

def REAL_POW_POW:
  prove(
    [
      @hol|{!x m n. (x pow m) pow n = x pow (m * n)}|,
      GEN_TAC then_tac GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [real_pow, MULT_CLAUSES, REAL_POW_ADD])
    ]
  )

def REAL_EQ_RCANCEL_IMP:
  prove(
    [
      @hol|{!x y z. ~(z = &0) /\ (x * z = y * z) ==> (x = y)}|,
      REPEAT(GEN_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_SUB_0)]) then_tac \
      REWRITE_TAC(PairList [REAL_SUB_RZERO, GSYM(REAL_SUB_RDISTRIB), REAL_ENTIRE]) then_tac \
      CONV_TAC(TAUT)
    ]
  )

def REAL_EQ_LCANCEL_IMP:
  prove(
    [
      @hol|{!x y z. ~(z = &0) /\ (z * x = z * y) ==> (x = y)}|,
      ONCE_REWRITE_TAC(PairList [REAL_MUL_SYM]) then_tac \
      MATCH_ACCEPT_TAC(REAL_EQ_RCANCEL_IMP)
    ]
  )

def REAL_LT_DIV:
  prove(
    [
      @hol|{!x y. &0 < x /\ &0 < y ==> &0 < x / y}|,
      SIMP_TAC(PairList [REAL_LT_MUL, REAL_LT_INV_EQ, real_div])
    ]
  )

def REAL_LE_DIV:
  prove(
    [
      @hol|{!x y. &0 <= x /\ &0 <= y ==> &0 <= x / y}|,
      SIMP_TAC(PairList [REAL_LE_MUL, REAL_LE_INV_EQ, real_div])
    ]
  )

def REAL_DIV_POW2:
  prove(
    [
      @hol|{!x m n. ~(x = &0)
         ==> (x pow m / x pow n = if n <= m then x pow (m - n)
                                  else inv(x pow (n - m)))}|,
      REPEAT(STRIP_TAC) then_tac COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_SIMP_TAC(PairList [REAL_POW_SUB]) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_INV_INV)]) then_tac \
      AP_TERM_TAC then_tac \
      REWRITE_TAC(PairList [REAL_INV_DIV]) then_tac \
      UNDISCH_TAC(@hol|{~(n:num <= m)}|) then_tac \
      REWRITE_TAC(PairList [NOT_LE]) then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(LT_IMP_LE))) then_tac \
      ASM_SIMP_TAC(PairList [REAL_POW_SUB])
    ]
  )

def REAL_DIV_POW2_ALT:
  prove(
    [
      @hol|{!x m n. ~(x = &0)
         ==> (x pow m / x pow n = if n < m then x pow (m - n)
                                  else inv(x pow (n - m)))}|,
      REPEAT(STRIP_TAC) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_INV_INV)]) then_tac \
      ONCE_REWRITE_TAC(PairList [REAL_INV_DIV]) then_tac \
      ASM_SIMP_TAC(PairList [GSYM(NOT_LE), REAL_DIV_POW2]) then_tac \
      ASM_CASES_TAC(@hol|{m <= n:num}|) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_INV_INV])
    ]
  )

def REAL_LT_POW2:
  prove(
    [
      @hol|{!n. &0 < &2 pow n}|,
      SIMP_TAC(PairList [REAL_POW_LT, REAL_OF_NUM_LT, ARITH])
    ]
  )

def REAL_LE_POW2:
  prove(
    [
      @hol|{!n. &1 <= &2 pow n}|,
      GEN_TAC then_tac MATCH_MP_TAC(REAL_LE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{&2 pow 0}|
      ) then_tac \
      SIMP_TAC(PairList [REAL_POW_MONO, LE_0, REAL_OF_NUM_LE, ARITH]) then_tac \
      REWRITE_TAC(PairList [real_pow, REAL_LE_REFL])
    ]
  )

def REAL_POW2_ABS:
  prove(
    [
      @hol|{!x. abs(x) pow 2 = x pow 2}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [real_abs]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [REAL_POW_NEG, ARITH_EVEN])
    ]
  )

def REAL_LE_SQUARE_ABS:
  prove(
    [
      @hol|{!x y. abs(x) <= abs(y) <=> x pow 2 <= y pow 2}|,
      REPEAT(GEN_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_POW2_ABS)]) then_tac \
      MESON_TAC(
        PairList [
          REAL_POW_LE2,
          REAL_ABS_POS,
          NUM_EQ_CONV(
            @hol|{2 = 0}|
          ),
          REAL_POW_LT2,
          REAL_NOT_LE
        ]
      )
    ]
  )

def REAL_LT_SQUARE_ABS:
  prove(
    [
      @hol|{!x y. abs(x) < abs(y) <=> x pow 2 < y pow 2}|,
      REWRITE_TAC(PairList [GSYM(REAL_NOT_LE), REAL_LE_SQUARE_ABS])
    ]
  )

def REAL_EQ_SQUARE_ABS:
  prove(
    [
      @hol|{!x y. abs x = abs y <=> x pow 2 = y pow 2}|,
      REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM), REAL_LE_SQUARE_ABS])
    ]
  )

def REAL_LE_POW_2:
  prove(
    [
      @hol|{!x. &0 <= x pow 2}|,
      REWRITE_TAC(PairList [REAL_POW_2, REAL_LE_SQUARE])
    ]
  )

def REAL_LT_POW_2:
  prove(
    [
      @hol|{!x. &0 < x pow 2 <=> ~(x = &0)}|,
      REWRITE_TAC(
        PairList [
          REAL_LE_POW_2,
          REAL_ARITH(
            @hol|{&0 < x <=> &0 <= x /\ ~(x = &0)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REAL_POW_EQ_0, ARITH])
    ]
  )

def REAL_SOS_EQ_0:
  prove(
    [
      @hol|{!x y. x pow 2 + y pow 2 = &0 <=> x = &0 /\ y = &0}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac \
      SIMP_TAC(PairList [REAL_POW_2, REAL_MUL_LZERO, REAL_ADD_LID]) then_tac \
      DISCH_THEN(
        o(MP_TAC)(
          MATCH_MP(
            REAL_ARITH(
              @hol|{x + y = &0 ==> &0 <= x /\ &0 <= y ==> x = &0 /\ y = &0}|
            )
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList [REAL_LE_SQUARE, REAL_ENTIRE])
    ]
  )

def REAL_POW_ZERO:
  prove(
    [
      @hol|{!n. &0 pow n = if n = 0 then &1 else &0}|,
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [real_pow, NOT_SUC, REAL_MUL_LZERO])
    ]
  )

def REAL_POW_MONO_INV:
  prove(
    [
      @hol|{!m n x. &0 <= x /\ x <= &1 /\ n <= m ==> x pow m <= x pow n}|,
      REPEAT(STRIP_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{x = &0}|
      ) then_list \
      PairList [
        ASM_REWRITE_TAC(PairList [REAL_POW_ZERO]) then_tac \
        REPEAT(
          COND_CASES_TAC then_tac \
          REWRITE_TAC(PairList [REAL_POS, REAL_LE_REFL])
        ) then_tac \
        UNDISCH_TAC(@hol|{n:num <= m}|) then_tac \
        ASM_REWRITE_TAC(PairList [LE]),
        GEN_REWRITE_TAC(BINOP_CONV)(PairList [GSYM(REAL_INV_INV)]) then_tac \
        MATCH_MP_TAC(REAL_LE_INV2) then_tac \
        REWRITE_TAC(PairList [GSYM(REAL_POW_INV)]) then_tac \
        CONJ_TAC then_list \
        PairList [
          MATCH_MP_TAC(REAL_POW_LT) then_tac REWRITE_TAC(PairList [REAL_LT_INV_EQ]),
          MATCH_MP_TAC(REAL_POW_MONO) then_tac ASM_REWRITE_TAC(PairList []) then_tac \
          MATCH_MP_TAC(REAL_INV_1_LE)
        ] then_tac \
        ASM_REWRITE_TAC(PairList [REAL_LT_LE])
      ]
    ]
  )

def REAL_POW_LE2_REV:
  prove(
    [
      @hol|{!n x y. ~(n = 0) /\ &0 <= y /\ x pow n <= y pow n ==> x <= y}|,
      MESON_TAC(PairList [REAL_POW_LT2, REAL_NOT_LE])
    ]
  )

def REAL_POW_LT2_REV:
  prove(
    [
      @hol|{!n x y. &0 <= y /\ x pow n < y pow n ==> x < y}|,
      MESON_TAC(PairList [REAL_POW_LE2, REAL_NOT_LE])
    ]
  )

def REAL_POW_EQ:
  prove(
    [
      @hol|{!n x y. ~(n = 0) /\ &0 <= x /\ &0 <= y /\ x pow n = y pow n ==> x = y}|,
      REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM)]) then_tac \
      MESON_TAC(PairList [REAL_POW_LE2_REV])
    ]
  )

def REAL_POW_EQ_ABS:
  prove(
    [
      @hol|{!n x y. ~(n = 0) /\ x pow n = y pow n ==> abs x = abs y}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_POW_EQ) then_tac \
      EXISTS_TAC(@hol|{n:num}|) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_ABS_POS, GSYM(REAL_ABS_POW)])
    ]
  )

def REAL_POW_EQ_1_IMP:
  prove(
    [
      @hol|{!x n. ~(n = 0) /\ x pow n = &1 ==> abs(x) = &1}|,
      REPEAT(STRIP_TAC) then_tac \
      GEN_REWRITE_TAC(RAND_CONV)(PairList [GSYM(REAL_ABS_NUM)]) then_tac \
      MATCH_MP_TAC(REAL_POW_EQ_ABS) then_tac \
      EXISTS_TAC(@hol|{n:num}|) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_POW_ONE])
    ]
  )

def REAL_POW_EQ_1:
  prove(
    [
      @hol|{!x n. x pow n = &1 <=> abs(x) = &1 /\ (x < &0 ==> EVEN(n)) \/ n = 0}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [real_pow]) then_tac \
      ASM_CASES_TAC(
        @hol|{abs(x) = &1}|
      ) then_list \
      PairList [ALL_TAC, ASM_MESON_TAC(PairList [REAL_POW_EQ_1_IMP])] then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      FIRST_X_ASSUM(
        o(DISJ_CASES_THEN(SUBST1_TAC))(
          MATCH_MP(
            REAL_ARITH(
              @hol|{abs x = a ==> x = a \/ x = --a}|
            )
          )
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_POW_NEG, REAL_POW_ONE]) then_tac \
      REPEAT(COND_CASES_TAC) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_POW_LT2_ODD:
  prove(
    [
      @hol|{!n x y. x < y /\ ODD n ==> x pow n < y pow n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [ARITH]) then_tac \
      STRIP_TAC then_tac \
      DISJ_CASES_TAC(SPEC(@hol|{y:real}|)(REAL_LE_NEGTOTAL)) then_list \
      PairList [
        DISJ_CASES_TAC(
          REAL_ARITH(
            @hol|{&0 <= x \/ &0 < --x}|
          )
        ) then_tac \
        ASM_SIMP_TAC(PairList [REAL_POW_LT2]) then_tac \
        SUBGOAL_THEN(
          @hol|{&0 < --x pow n /\ &0 <= y pow n}|
        )(MP_TAC) then_list \
        PairList [
          ASM_SIMP_TAC(PairList [REAL_POW_LE, REAL_POW_LT]),
          ASM_REWRITE_TAC(PairList [REAL_POW_NEG, GSYM(NOT_ODD)]) then_tac \
          REAL_ARITH_TAC
        ],
        SUBGOAL_THEN(
          @hol|{--y pow n < --x pow n}|
        )(MP_TAC) then_list \
        PairList [
          MATCH_MP_TAC(REAL_POW_LT2) then_tac ASM_REWRITE_TAC(PairList []),
          ASM_REWRITE_TAC(PairList [REAL_POW_NEG, GSYM(NOT_ODD)])
        ] then_tac \
        REPEAT(POP_ASSUM(MP_TAC)) then_tac \
        REAL_ARITH_TAC
      ]
    ]
  )

def REAL_POW_LE2_ODD:
  prove(
    [
      @hol|{!n x y. x <= y /\ ODD n ==> x pow n <= y pow n}|,
      REWRITE_TAC(PairList [REAL_LE_LT]) then_tac REPEAT(STRIP_TAC) then_tac \
      ASM_SIMP_TAC(PairList [REAL_POW_LT2_ODD])
    ]
  )

def REAL_POW_LT2_ODD_EQ:
  prove(
    [
      @hol|{!n x y. ODD n ==> (x pow n < y pow n <=> x < y)}|,
      MESON_TAC(PairList [REAL_POW_LT2_ODD, REAL_POW_LE2_ODD, REAL_NOT_LE])
    ]
  )

def REAL_POW_LE2_ODD_EQ:
  prove(
    [
      @hol|{!n x y. ODD n ==> (x pow n <= y pow n <=> x <= y)}|,
      MESON_TAC(PairList [REAL_POW_LT2_ODD, REAL_POW_LE2_ODD, REAL_NOT_LE])
    ]
  )

def REAL_POW_EQ_ODD_EQ:
  prove(
    [
      @hol|{!n x y. ODD n ==> (x pow n = y pow n <=> x = y)}|,
      SIMP_TAC(PairList [GSYM(REAL_LE_ANTISYM), REAL_POW_LE2_ODD_EQ])
    ]
  )

def REAL_POW_EQ_ODD:
  prove(
    [
      @hol|{!n x y. ODD n /\ x pow n = y pow n ==> x = y}|,
      MESON_TAC(PairList [REAL_POW_EQ_ODD_EQ])
    ]
  )

def REAL_POW_EQ_EQ:
  prove(
    [
      @hol|{!n x y. x pow n = y pow n <=>
         if EVEN n then n = 0 \/ abs x = abs y else x = y}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [real_pow, ARITH]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList [REAL_POW_EQ_ODD_EQ, GSYM(NOT_EVEN)]) then_tac \
      EQ_TAC then_list \
      PairList [ASM_MESON_TAC(PairList [REAL_POW_EQ_ABS]), ALL_TAC] then_tac \
      REWRITE_TAC(PairList [REAL_EQ_SQUARE_ABS]) then_tac \
      DISCH_TAC then_tac \
      FIRST_X_ASSUM(
        o(X_CHOOSE_THEN(@hol|{m:num}|)(SUBST1_TAC))(REWRITE_RULE(PairList [EVEN_EXISTS]))
      ) then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(REAL_POW_POW)])
    ]
  )

def REAL_EVENPOW_ABS:
  prove(
    [
      @hol|{!x n. EVEN n ==> abs x pow n = x pow n}|,
      SIMP_TAC(PairList [REAL_POW_EQ_EQ, REAL_ABS_ABS])
    ]
  )

def REAL_OF_NUM_MOD:
  prove(
    [
      @hol|{!m n. &(m MOD n):real = &m - &(m DIV n) * &n}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [REAL_EQ_SUB_LADD]) then_tac \
      REWRITE_TAC(PairList [REAL_OF_NUM_CLAUSES]) then_tac \
      MESON_TAC(PairList [DIVISION_SIMP, ADD_SYM])
    ]
  )

def REAL_OF_NUM_DIV:
  prove(
    [
      @hol|{!m n. &(m DIV n):real = &m / &n - &(m MOD n) / &n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_list \
      PairList [
        ASM_REWRITE_TAC(
          PairList [
            DIV_ZERO,
            real_div,
            REAL_INV_0,
            REAL_MUL_RZERO,
            REAL_SUB_REFL
          ]
        ),
        MATCH_MP_TAC(REAL_EQ_LCANCEL_IMP) then_tac \
        EXISTS_TAC(@hol|{&n:real}|) then_tac \
        ASM_SIMP_TAC(PairList [REAL_SUB_LDISTRIB, REAL_DIV_LMUL, REAL_OF_NUM_EQ]) then_tac \
        REWRITE_TAC(PairList [REAL_OF_NUM_MOD]) then_tac \
        REAL_ARITH_TAC
      ]
    ]
  )

def REAL_CONVEX_BOUND2_LT:
  prove(
    [
      @hol|{!x y a u v. x < a /\ y < b /\ &0 <= u /\ &0 <= v /\ u + v = &1
         ==> u * x + v * y < u * a + v * b}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{u = &0}|
      ) then_list \
      PairList [
        ASM_REWRITE_TAC(PairList [REAL_MUL_LZERO, REAL_ADD_LID]) then_tac \
        REPEAT(STRIP_TAC),
        REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LTE_ADD2) then_tac \
        ASM_SIMP_TAC(PairList [REAL_LE_LMUL, REAL_LT_IMP_LE])
      ] then_tac \
      MATCH_MP_TAC(REAL_LT_LMUL) then_tac \
      REPEAT(POP_ASSUM(MP_TAC)) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_CONVEX_BOUND2_LE:
  prove(
    [
      @hol|{!x y a u v. x <= a /\ y <= b /\ &0 <= u /\ &0 <= v /\ u + v = &1
         ==> u * x + v * y <= u * a + v * b}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LE_ADD2) then_tac \
      CONJ_TAC then_tac \
      MATCH_MP_TAC(REAL_LE_LMUL) then_tac \
      REPEAT(POP_ASSUM(MP_TAC)) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_CONVEX_BOUND_LT:
  prove(
    [
      @hol|{!x y a u v. x < a /\ y < a /\ &0 <= u /\ &0 <= v /\ (u + v = &1)
         ==> u * x + v * y < a}|,
      MESON_TAC(
        PairList [
          REAL_CONVEX_BOUND2_LT,
          MESON(
