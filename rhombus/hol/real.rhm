      ASM_REWRITE_TAC(PairList [REAL_INV_0, REAL_MUL_LZERO, REAL_MUL_RZERO]) then_tac \
      MATCH_MP_TAC(REAL_MUL_LINV_UNIQ) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          AC(REAL_MUL_AC)(
            @hol|{(a * b) * (c * d) = (a * c) * (b * d)}|
          )
        ]
      ) then_tac \
      EVERY_ASSUM(o(SUBST1_TAC)(MATCH_MP(REAL_MUL_LINV))) then_tac \
      REWRITE_TAC(PairList [REAL_MUL_LID])
    ]
  )

def REAL_INV_DIV:
