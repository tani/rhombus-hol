def REAL_DIV_EQ_1:
  prove(
    [
      @hol|{!x y:real. x / y = &1 <=> x = y /\ ~(x = &0) /\ ~(y = &0)}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [real_div]) then_tac \
      ASM_CASES_TAC(
