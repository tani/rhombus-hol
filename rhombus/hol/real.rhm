def real_REAL_OF_NUM_MAX:«
  Up_tactics.prove((block:«
    let port_tmp_11 = Up_simp.REWRITE_TAC((block:«
      let port_tmp_12 = (block:«
        let port_tmp_13 = (block:«
          let port_tmp_14 = (block:«
            let port_tmp_15 = PairList [];
            let port_tmp_16 = Up_equal.GSYM(Up_class.COND_RAND);
            PairList.cons(port_tmp_16,port_tmp_15)
          »);
          let port_tmp_17 = Up_realax.real_max;
          PairList.cons(port_tmp_17,port_tmp_14)
        »);
        let port_tmp_18 = Up_arith.MAX;
        PairList.cons(port_tmp_18,port_tmp_13)
      »);
      let port_tmp_19 = Up_realax.REAL_OF_NUM_LE;
      PairList.cons(port_tmp_19,port_tmp_12)
    »));
    let port_tmp_20 = Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"real_max\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]],[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"MAX\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]],[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]]]]]]");
    Pair(port_tmp_20,port_tmp_11)
  »))
