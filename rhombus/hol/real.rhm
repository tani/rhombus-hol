                              ),
                              ALL_TAC
                            ]
                          ) then_tac \
                          ASM_CASES_TAC(
                            (hol:
                               var y :: real
                               (0 :: real) <= y)
                          )
                        ) then_list \
                        PairList [
                          ALL_TAC,
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      ONCE_REWRITE_TAC(
                                        PairList [
                                          REAL_ARITH(
                                            (hol:
                                               var x :: real
                                               var y :: real
                                               const real_abs :: real -> real
                                               real_abs(x - y) == real_abs(-x - -y))
                                          )
                                        ]
                                      ) then_tac \
                                      REWRITE_TAC(PairList [GSYM(SQRT_NEG)])
                                    ) then_tac \
                                    TRANS_TAC(REAL_LE_TRANS)(
                                      (hol:
                                         var x :: real
                                         var y :: real
                                         const sqrt :: real -> real
                                         const real_abs :: real -> real
                                         sqrt(real_abs(-x - -y)))
                                    )
                                  ) then_tac \
                                  REWRITE_TAC(
                                    PairList [
                                      SQRT_MONO_LE_EQ,
                                      REAL_ARITH(
                                        (hol:
                                           var x :: real
                                           const real_abs :: real -> real
                                           real_abs(x) <= (2 :: real) * real_abs(x))
                                      )
                                    ]
                                  )
                                ) then_tac \
                                MATCH_MP_TAC(REAL_ABS_LE_SQRT_POS)
                              ) then_tac \
                              REPEAT(POP_ASSUM(MP_TAC))
                            ) then_tac \
                            REAL_ARITH_TAC
                          )
                        ]
                      ) then_tac \
                      ASM_SIMP_TAC(
                        PairList [
                          SQRT_LE_0,
                          REAL_ARITH(
                            (hol:
                               var x :: real
                               var y :: real
                               const real_abs :: real -> real
                               !((0 :: real) <= x) && (0 :: real) <= y ==> real_abs(x - y) == y - x)
                          )
                        ]
                      )
                    ) then_tac \
                    MATCH_MP_TAC(REAL_LE_RSQRT)
                  ) then_tac \
                  MP_TAC(
                    SPEC(
                      (hol:
                         var x :: real
                         var y :: real
                         const sqrt :: real -> real
                         sqrt(-x) - sqrt(y))
                    )(REAL_LE_POW_2)
                  )
                ) then_tac \
                REWRITE_TAC(
                  PairList [
                    REAL_ARITH(
                      (hol:
                         var x :: real
                         var y :: real
                         const real_pow :: real -> num -> real
                         real_pow(x - y, (2 :: num))
                           == real_pow(x, (2 :: num)) + real_pow(y, (2 :: num)) - (2 :: real) * (x * y))
                    )
                  ]
                )
              ) then_tac \
              REWRITE_TAC(PairList [REAL_SQRT_POW_2])
            ) then_tac \
            REWRITE_TAC(PairList [SQRT_NEG, REAL_ABS_NEG])
          ) then_tac \
          REPEAT(POP_ASSUM(MP_TAC))
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def sqrt = real_sqrt
