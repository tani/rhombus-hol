def REAL_ABS_MUL:
  prove(
    [
      @hol|{!x y. abs(x * y) = abs(x) * abs(y)}|,
      REPEAT(GEN_TAC) then_tac \
      DISJ_CASES_TAC(SPEC(@hol|{x:real}|)(REAL_LE_NEGTOTAL)) then_list \
      PairList [
        ALL_TAC,
        GEN_REWRITE_TAC(o(RAND_CONV)(LAND_CONV))(PairList [GSYM(REAL_ABS_NEG)])
      ] then_tac \
      (
        DISJ_CASES_TAC(SPEC(@hol|{y:real}|)(REAL_LE_NEGTOTAL)) then_list \
        PairList [
          ALL_TAC,
          GEN_REWRITE_TAC(o(RAND_CONV)(RAND_CONV))(PairList [GSYM(REAL_ABS_NEG)])
        ]
      ) then_tac \
      ASSUM_LIST(o(o(o(MP_TAC)(MATCH_MP(REAL_LE_MUL)))(end_itlist(CONJ)))(rev)) then_tac \
      REWRITE_TAC(PairList [REAL_MUL_LNEG, REAL_MUL_RNEG, REAL_NEG_NEG]) then_tac \
      DISCH_TAC then_list \
      PairList [
        ALL_TAC,
        GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_ABS_NEG)]),
        GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_ABS_NEG)]),
        ALL_TAC
      ] then_tac \
      ASM_REWRITE_TAC(PairList [real_abs, REAL_MUL_LNEG, REAL_MUL_RNEG, REAL_NEG_NEG])
    ]
  )

def REAL_POW_LE:
  prove(
