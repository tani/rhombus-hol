      REPEAT(GEN_TAC) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          REAL_ARITH(
            @hol|{(x = y) <=> (x - y = &0)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(REAL_SUB_LDISTRIB), REAL_ENTIRE, REAL_SUB_RZERO])
    ]
  )

def REAL_EQ_MUL_RCANCEL:
