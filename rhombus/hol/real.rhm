def REAL_LT_INV:
  prove(
    [
      @hol|{!x. &0 < x ==> &0 < inv(x)}|,
      GEN_TAC then_tac \
      REPEAT_TCL(DISJ_CASES_THEN)(ASSUME_TAC)(
        SPEC(@hol|{inv(x)}|)(REAL_LT_NEGTOTAL)
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_list \
      PairList [
        RULE_ASSUM_TAC(REWRITE_RULE(PairList [REAL_INV_EQ_0])) then_tac \
        ASM_REWRITE_TAC(PairList []),
        DISCH_TAC then_tac \
        SUBGOAL_THEN(
          @hol|{&0 < --(inv x) * x}|
        )(MP_TAC) then_list \
        PairList [
          MATCH_MP_TAC(REAL_LT_MUL) then_tac ASM_REWRITE_TAC(PairList []),
          REWRITE_TAC(PairList [REAL_MUL_LNEG])
        ]
      ] then_tac \
      SUBGOAL_THEN(
        @hol|{inv(x) * x = &1}|
      )(SUBST1_TAC) then_list \
      PairList [
        MATCH_MP_TAC(REAL_MUL_LINV) then_tac \
        UNDISCH_TAC(
          @hol|{&0 < x}|
        ) then_tac \
        REAL_ARITH_TAC,
        REWRITE_TAC(PairList [REAL_LT_RNEG, REAL_ADD_LID, REAL_OF_NUM_LT, ARITH])
      ]
    ]
  )

def REAL_LT_INV_EQ:
