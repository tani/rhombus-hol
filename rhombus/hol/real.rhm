def REAL_ARCH_SIMPLE:
  let lemma:
    prove(
      [
        @hol|{(!x. (?n. x = &n) ==> P x) <=> !n. P(&n)}|,
        MESON_TAC(PairList [])
      ]
    )
  prove(
    [
      @hol|{!x. ?n. x <= &n}|,
      MP_TAC(
        SPEC(
          @hol|{\y. ?n. y = &n}|
        )(REAL_COMPLETE)
      ) then_tac \
      REWRITE_TAC(PairList [lemma]) then_tac \
      MESON_TAC(
        PairList [
          REAL_LE_SUB_LADD,
          REAL_OF_NUM_ADD,
          REAL_LE_TOTAL,
          REAL_ARITH(
            @hol|{~(M <= M - &1)}|
          )
        ]
      )
    ]
  )

def REAL_ARCH_LT:
  prove(
    [
      @hol|{!x. ?n. x < &n}|,
      MESON_TAC(
        PairList [
          REAL_ARCH_SIMPLE,
          REAL_OF_NUM_ADD,
          REAL_ARITH(
            @hol|{x <= n ==> x < n + &1}|
          )
        ]
      )
    ]
  )

def REAL_ARCH:
  prove(
    [
      @hol|{!x. &0 < x ==> !y. ?n. y < &n * x}|,
      MESON_TAC(PairList [REAL_ARCH_LT, REAL_LT_LDIV_EQ])
    ]
  )

def REAL_ARCH_INV:
  prove(
    [
      @hol|{!e. &0 < e <=> ?n. ~(n = 0) /\ &0 < inv(&n) /\ inv(&n) < e}|,
      GEN_TAC then_tac EQ_TAC then_list \
      PairList [ALL_TAC, MESON_TAC(PairList [REAL_LT_TRANS])] then_tac \
      DISCH_TAC then_tac \
      MP_TAC(
        SPEC(@hol|{inv(e)}|)(REAL_ARCH_LT)
      ) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      ASM_MESON_TAC(
        PairList [REAL_LT_INV2, REAL_INV_INV, REAL_LT_INV_EQ, REAL_LT_TRANS, REAL_LT_ANTISYM]
      )
    ]
  )

def REAL_POW_LBOUND:
  prove(
    [
      @hol|{!x n. &0 <= x ==> &1 + &n * x <= (&1 + x) pow n}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM]) then_tac \
      DISCH_TAC then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [real_pow, REAL_MUL_LZERO, REAL_ADD_RID, REAL_LE_REFL]) then_tac \
      REWRITE_TAC(PairList [GSYM(REAL_OF_NUM_SUC)]) then_tac \
      MATCH_MP_TAC(REAL_LE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{(&1 + x) * (&1 + &n * x)}|
      ) then_tac \
      ASM_SIMP_TAC(
        PairList [
          REAL_LE_LMUL,
          REAL_ARITH(
            @hol|{&0 <= x ==> &0 <= &1 + x}|
          )
        ]
      ) then_tac \
      ASM_SIMP_TAC(
        PairList [
          REAL_LE_MUL,
          REAL_POS,
          REAL_ARITH(
            @hol|{&1 + (n + &1) * x <= (&1 + x) * (&1 + n * x) <=> &0 <= n * x * x}|
          )
        ]
      )
    ]
  )

def REAL_ARCH_POW:
  prove(
    [
      @hol|{!x y. &1 < x ==> ?n. y < x pow n}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        SPEC(
          @hol|{x - &1}|
        )(REAL_ARCH)
      ) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_SUB_LT]) then_tac \
      DISCH_THEN(o(MP_TAC)(SPEC(@hol|{y:real}|))) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      X_GEN_TAC(@hol|{n:num}|) then_tac \
      DISCH_TAC then_tac \
      MATCH_MP_TAC(REAL_LTE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{&1 + &n * (x - &1)}|
      ) then_tac \
      ASM_SIMP_TAC(
        PairList [
          REAL_ARITH(
            @hol|{x < y ==> x < &1 + y}|
          )
        ]
      ) then_tac \
      ASM_MESON_TAC(
        PairList [
          REAL_POW_LBOUND,
          REAL_SUB_ADD2,
          REAL_ARITH(
            @hol|{&1 < x ==> &0 <= x - &1}|
          )
        ]
      )
    ]
  )

def REAL_ARCH_POW2:
  prove(
    [
      @hol|{!x. ?n. x < &2 pow n}|,
      SIMP_TAC(PairList [REAL_ARCH_POW, REAL_OF_NUM_LT, ARITH])
    ]
  )

def REAL_ARCH_POW_INV:
  prove(
    [
      @hol|{!x y. &0 < y /\ x < &1 ==> ?n. x pow n < y}|,
      REPEAT(STRIP_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{&0 < x}|
      ) then_list \
      PairList [
        ALL_TAC,
        ASM_MESON_TAC(PairList [REAL_POW_1, REAL_LET_TRANS, REAL_NOT_LT])
      ] then_tac \
      SUBGOAL_THEN(
        @hol|{inv(&1) < inv(x)}|
      )(MP_TAC) then_list \
      PairList [ASM_SIMP_TAC(PairList [REAL_LT_INV2]), REWRITE_TAC(PairList [REAL_INV_1])] then_tac \
      DISCH_THEN(
        o(
          o(MP_TAC)(SPEC(@hol|{inv(y)}|))
        )(MATCH_MP(REAL_ARCH_POW))
      ) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      GEN_TAC then_tac \
      DISCH_TAC then_tac \
      GEN_REWRITE_TAC(BINOP_CONV)(PairList [GSYM(REAL_INV_INV)]) then_tac \
      ASM_SIMP_TAC(PairList [GSYM(REAL_POW_INV), REAL_LT_INV, REAL_LT_INV2])
    ]
  )

def real_sgn:
  new_definition(
    @hol|{(real_sgn:real->real) x =
       if &0 < x then &1 else if x < &0 then -- &1 else &0}|
  )

def REAL_SGN_0:
  prove(
    [
      @hol|{real_sgn(&0) = &0}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC
    ]
  )

def REAL_SGN_NEG:
  prove(
    [
      @hol|{!x. real_sgn(--x) = --(real_sgn x)}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC
    ]
  )

def REAL_SGN_ABS:
  prove(
    [
      @hol|{!x. real_sgn(x) * abs(x) = x}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC
    ]
  )

def REAL_SGN_ABS_ALT:
  prove(
    [
      @hol|{!x. real_sgn x * x = abs x}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC
    ]
  )

def REAL_EQ_SGN_ABS:
  prove(
    [
      @hol|{!x y:real. x = y <=> real_sgn x = real_sgn y /\ abs x = abs y}|,
      MESON_TAC(PairList [REAL_SGN_ABS])
    ]
  )

def REAL_ABS_SGN:
  prove(
    [
      @hol|{!x. abs(real_sgn x) = real_sgn(abs x)}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC
    ]
  )

def REAL_SGN:
  prove(
    [
      @hol|{!x. real_sgn x = x / abs x}|,
      GEN_TAC then_tac \
      ASM_CASES_TAC(
        @hol|{x = &0}|
      ) then_list \
      PairList [
        ASM_REWRITE_TAC(PairList [real_div, REAL_MUL_LZERO, REAL_SGN_0]),
        GEN_REWRITE_TAC(o(RAND_CONV)(LAND_CONV))(PairList [GSYM(REAL_SGN_ABS)]) then_tac \
        ASM_SIMP_TAC(
          PairList [
            real_div,
            GSYM(REAL_MUL_ASSOC),
            REAL_ABS_ZERO,
            REAL_MUL_RINV,
            REAL_MUL_RID
          ]
        )
      ]
    ]
  )

def REAL_SGN_MUL:
  prove(
    [
      @hol|{!x y. real_sgn(x * y) = real_sgn(x) * real_sgn(y)}|,
      REWRITE_TAC(PairList [REAL_SGN, REAL_ABS_MUL, real_div, REAL_INV_MUL]) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_SGN_INV:
  prove(
    [
      @hol|{!x. real_sgn(inv x) = real_sgn x}|,
      REWRITE_TAC(
        PairList [
          real_sgn,
          REAL_LT_INV_EQ,
          GSYM(REAL_INV_NEG),
          REAL_ARITH(
            @hol|{x < &0 <=> &0 < --x}|
          )
        ]
      )
    ]
  )

def REAL_SGN_DIV:
  prove(
    [
      @hol|{!x y. real_sgn(x / y) = real_sgn(x) / real_sgn(y)}|,
      REWRITE_TAC(PairList [REAL_SGN, REAL_ABS_DIV]) then_tac \
      REWRITE_TAC(PairList [real_div, REAL_INV_MUL, REAL_INV_INV]) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_SGN_EQ:
  prove(
    [
      @hol|{(!x. real_sgn x = &0 <=> x = &0) /\
         (!x. real_sgn x = &1 <=> x > &0) /\
         (!x. real_sgn x = -- &1 <=> x < &0)}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC
    ]
  )

def REAL_SGN_CASES:
  prove(
    [
      @hol|{!x. real_sgn x = &0 \/ real_sgn x = &1 \/ real_sgn x = -- &1}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac MESON_TAC(PairList [])
    ]
  )

def REAL_SGN_INEQS:
  prove(
    [
      @hol|{(!x. &0 <= real_sgn x <=> &0 <= x) /\
         (!x. &0 < real_sgn x <=> &0 < x) /\
         (!x. &0 >= real_sgn x <=> &0 >= x) /\
         (!x. &0 > real_sgn x <=> &0 > x) /\
         (!x. &0 = real_sgn x <=> &0 = x) /\
         (!x. real_sgn x <= &0 <=> x <= &0) /\
         (!x. real_sgn x < &0 <=> x < &0) /\
         (!x. real_sgn x >= &0 <=> x >= &0) /\
         (!x. real_sgn x > &0 <=> x > &0) /\
         (!x. real_sgn x = &0 <=> x = &0)}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC
    ]
  )

def REAL_SGN_POW:
  prove(
    [
      @hol|{!x n. real_sgn(x pow n) = real_sgn(x) pow n}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [REAL_SGN_MUL, real_pow]) then_tac \
      REWRITE_TAC(PairList [real_sgn, REAL_LT_01])
    ]
  )

def REAL_SGN_POW_2:
  prove(
    [
      @hol|{!x. real_sgn(x pow 2) = real_sgn(abs x)}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac \
      SIMP_TAC(
        PairList [
          GSYM(REAL_NOT_LE),
          REAL_ABS_POS,
          REAL_LE_POW_2,
          REAL_ARITH(
            @hol|{&0 <= x ==> (x <= &0 <=> x = &0)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REAL_POW_EQ_0, REAL_ABS_ZERO, ARITH])
    ]
  )

def REAL_SGN_REAL_SGN:
  prove(
    [
      @hol|{!x. real_sgn(real_sgn x) = real_sgn x}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC
    ]
  )

def REAL_INV_SGN:
  prove(
    [
      @hol|{!x. real_inv(real_sgn x) = real_sgn x}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [real_sgn]) then_tac \
      REPEAT(COND_CASES_TAC) then_tac \
      REWRITE_TAC(PairList [REAL_INV_0, REAL_INV_1, REAL_INV_NEG])
    ]
  )

def REAL_SGN_EQ_INEQ:
  prove(
    [
      @hol|{!x y. real_sgn x = real_sgn y <=>
         x = y \/ abs(x - y) < max (abs x) (abs y)}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC
    ]
  )

def REAL_SGNS_EQ:
  prove(
    [
      @hol|{!x y. real_sgn x = real_sgn y <=>
         (x = &0 <=> y = &0) /\
         (x > &0 <=> y > &0) /\
         (x < &0 <=> y < &0)}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC
    ]
  )

def REAL_SGNS_EQ_ALT:
  prove(
    [
      @hol|{!x y. real_sgn x = real_sgn y <=>
         (x = &0 ==> y = &0) /\
         (x > &0 ==> y > &0) /\
         (x < &0 ==> y < &0)}|,
      REWRITE_TAC(PairList [real_sgn]) then_tac REAL_ARITH_TAC
    ]
  )

def REAL_WLOG_LE:
  prove(
    [
      @hol|{(!x y. P x y <=> P y x) /\ (!x y. x <= y ==> P x y) ==> !x y. P x y}|,
      MESON_TAC(PairList [REAL_LE_TOTAL])
    ]
  )

def REAL_WLOG_LT:
  prove(
    [
      @hol|{(!x. P x x) /\ (!x y. P x y <=> P y x) /\ (!x y. x < y ==> P x y)
         ==> !x y. P x y}|,
      MESON_TAC(PairList [REAL_LT_TOTAL])
    ]
  )

def REAL_WLOG_LE_3:
  prove(
    [
      @hol|{!P. (!x y z. P x y z ==> P y x z /\ P x z y) /\
         (!x y z:real. x <= y /\ y <= z ==> P x y z)
         ==> !x y z. P x y z}|,
      MESON_TAC(PairList [REAL_LE_TOTAL])
    ]
  )

def real_sqrt:
  new_definition(
    @hol|{sqrt(x) = @y. real_sgn y = real_sgn x /\ y pow 2 = abs x}|
  )

def SQRT_UNIQUE:
  prove(
    [
      @hol|{!x y. &0 <= y /\ y pow 2 = x ==> sqrt(x) = y}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [real_sqrt]) then_tac \
      MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      FIRST_X_ASSUM(o(SUBST1_TAC)(SYM)) then_tac \
      REWRITE_TAC(PairList [REAL_SGN_POW_2, REAL_ABS_POW]) then_tac \
      X_GEN_TAC(@hol|{z:real}|) then_tac \
      ASM_REWRITE_TAC(PairList [real_abs]) then_tac \
      REWRITE_TAC(
        PairList [
          REAL_ENTIRE,
          REAL_SUB_0,
          REAL_ARITH(
            @hol|{x pow 2 = y pow 2 <=> (x - y) * (x - --y) = &0}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [real_sgn]) then_tac \
      REPEAT(POP_ASSUM(MP_TAC)) then_tac \
      REAL_ARITH_TAC
    ]
  )

def POW_2_SQRT:
  prove(
    [
      @hol|{!x. &0 <= x ==> sqrt(x pow 2) = x}|,
      MESON_TAC(PairList [SQRT_UNIQUE])
    ]
  )

def SQRT_0:
  prove(
    [
      @hol|{sqrt(&0) = &0}|,
      MESON_TAC(PairList [SQRT_UNIQUE, REAL_POW_2, REAL_MUL_LZERO, REAL_POS])
    ]
  )

def SQRT_1:
  prove(
    [
      @hol|{sqrt(&1) = &1}|,
      MESON_TAC(PairList [SQRT_UNIQUE, REAL_POW_2, REAL_MUL_LID, REAL_POS])
    ]
  )

def POW_2_SQRT_ABS:
  prove(
    [
      @hol|{!x. sqrt(x pow 2) = abs(x)}|,
      GEN_TAC then_tac MATCH_MP_TAC(SQRT_UNIQUE) then_tac \
      REWRITE_TAC(PairList [REAL_ABS_POS, REAL_POW_2, GSYM(REAL_ABS_MUL)]) then_tac \
      REWRITE_TAC(PairList [real_abs, REAL_LE_SQUARE])
    ]
  )

def SQRT_WORKS_GEN:
  let lemma:
    prove(
      [
        @hol|{!x y. x pow 2 < y ==> ?x'. x < x' /\ x' pow 2 < y}|,
        REPEAT(STRIP_TAC) then_tac \
        EXISTS_TAC(
          @hol|{abs x + min (&1) ((y - x pow 2) / (&2 * abs x + &2))}|
        ) then_tac \
        ASSUME_TAC(
          REAL_ARITH(
            @hol|{&0 < &2 * abs x + &1 /\ &0 < &2 * abs x + &2}|
          )
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            REAL_LT_DIV,
            REAL_SUB_LT,
            REAL_ARITH(
              @hol|{&0 < y ==> x < abs x + min (&1) y}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(
          PairList [
            REAL_ARITH(
              @hol|{(x + e) pow 2 = e * (&2 * x + e) + x pow 2}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [REAL_POW2_ABS, GSYM(REAL_LT_SUB_LADD)]) then_tac \
        TRANS_TAC(REAL_LET_TRANS)(
          @hol|{(y - x pow 2) / (&2 * abs x + &2) * (&2 * abs x + &1)}|
        ) then_tac \
        CONJ_TAC then_list \
        PairList [
          MATCH_MP_TAC(REAL_LE_MUL2) then_tac \
          REWRITE_TAC(PairList [REAL_LE_MIN, REAL_POS, REAL_MIN_LE, REAL_LE_REFL]) then_tac \
          ASM_SIMP_TAC(
            PairList [
              REAL_LE_ADD,
              REAL_POS,
              REAL_LE_MUL,
              REAL_ABS_POS,
              REAL_LT_IMP_LE,
              REAL_LT_DIV,
              REAL_SUB_LT,
              REAL_LE_MIN
            ]
          ) then_tac \
          REWRITE_TAC(PairList [REAL_LE_LADD, REAL_MIN_LE, REAL_LE_REFL]),
          SIMP_TAC(
            PairList [
              real_div,
              REAL_ARITH(
                @hol|{(a * inv b) * c = (a * c) * inv b}|
              )
            ]
          ) then_tac \
          REWRITE_TAC(PairList [GSYM(real_div)]) then_tac \
          ASM_SIMP_TAC(PairList [REAL_LT_LDIV_EQ, REAL_LT_LMUL_EQ, REAL_SUB_LT]) then_tac \
          REAL_ARITH_TAC
        ]
      ]
    )
  let lemma_prime:
    prove(
      [
        @hol|{!x y. &0 < x /\ &0 < y /\ y < x pow 2
           ==> ?x'. x' < x /\ &0 < x' /\ y < x' pow 2}|,
        REPEAT(STRIP_TAC) then_tac \
        MP_TAC(
          ISPECL(
            PairList [
              @hol|{inv(abs x):real}|,
              @hol|{inv y:real}|
            ])(
            lemma
          )
        ) then_tac \
        ASM_SIMP_TAC(PairList [REAL_POW_INV, REAL_POW2_ABS, REAL_LT_INV2]) then_tac \
        REWRITE_TAC(PairList [GSYM(REAL_ABS_INV)]) then_tac \
        DISCH_THEN(X_CHOOSE_THEN(@hol|{x':real}|)(STRIP_ASSUME_TAC)) then_tac \
        EXISTS_TAC(@hol|{inv x':real}|) then_tac \
        REWRITE_TAC(PairList [REAL_POW_INV]) then_tac \
        REWRITE_TAC(PairList [REAL_LT_INV_EQ]) then_tac \
        CONJ_TAC then_list \
        PairList [
          GEN_REWRITE_TAC(RAND_CONV)(PairList [GSYM(REAL_INV_INV)]),
          CONJ_TAC then_list \
          PairList [
            REPEAT(POP_ASSUM(MP_TAC)) then_tac REAL_ARITH_TAC,
            ALL_TAC
          ] then_tac \
          GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_INV_INV)])
        ] then_tac \
        MATCH_MP_TAC(REAL_LT_INV2) then_tac \
        (
          CONJ_TAC then_list \
          PairList [
            ALL_TAC,
            REPEAT(POP_ASSUM(MP_TAC)) then_tac REAL_ARITH_TAC
          ]
        ) then_tac \
        ASM_REWRITE_TAC(PairList [REAL_LT_INV_EQ, REAL_LT_POW_2]) then_tac \
        REPEAT(POP_ASSUM(MP_TAC)) then_tac \
        REAL_ARITH_TAC
      ]
    )
  let main_lemma:
    prove(
      [
        @hol|{!y. &0 < y ==> ?x. x pow 2 = y}|,
        REPEAT(STRIP_TAC) then_tac \
        FIRST_ASSUM(o(ASSUME_TAC)(MATCH_MP(REAL_LT_IMP_NZ))) then_tac \
        MP_TAC(
          ISPEC(
            @hol|{\x. &0 <= x /\ x pow 2 <= y}|)(
            REAL_COMPLETE
          )
        ) then_tac \
        REWRITE_TAC(PairList []) then_tac \
        ANTS_TAC then_list \
        PairList [
          CONJ_TAC then_list \
          PairList [
            EXISTS_TAC(
              @hol|{&0}|
            ) then_tac \
            REPEAT(POP_ASSUM(MP_TAC)) then_tac \
            REAL_ARITH_TAC,
            ALL_TAC
          ] then_tac \
          EXISTS_TAC(
            @hol|{y + &1}|
          ) then_tac \
          X_GEN_TAC(@hol|{x:real}|) then_tac \
          DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC)) then_tac \
          GEN_REWRITE_TAC(I)(PairList [GSYM(CONTRAPOS_THM)]) then_tac \
          REWRITE_TAC(PairList [REAL_NOT_LE]) then_tac \
          DISCH_TAC then_tac \
          TRANS_TAC(REAL_LET_TRANS)(
            @hol|{(y + &1) pow 2}|
          ) then_tac \
          ASM_SIMP_TAC(
            PairList [
              GSYM(REAL_LT_SQUARE_ABS),
              REAL_POW_LT,
              REAL_ARITH(
                @hol|{&0 < y /\ &0 < y pow 2 ==> y <= (y + &1) pow 2}|
              )
            ]
          ) then_tac \
          REPEAT(POP_ASSUM(MP_TAC)) then_tac \
          REAL_ARITH_TAC,
          MATCH_MP_TAC(MONO_EXISTS) then_tac \
          X_GEN_TAC(@hol|{s:real}|) then_tac \
          STRIP_TAC
        ] then_tac \
        REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM), GSYM(REAL_NOT_LT)]) then_tac \
        REPEAT(STRIP_TAC) then_list \
        PairList [
          MP_TAC(
            ISPECL(PairList [@hol|{s:real}|, @hol|{y:real}|])(lemma_prime)
          ) then_tac \
          ASM_REWRITE_TAC(PairList [NOT_IMP]) then_tac \
          CONJ_TAC then_list \
          PairList [
            UNDISCH_TAC(
              @hol|{y:real < s pow 2}|
            ) then_tac \
            ASM_CASES_TAC(
              @hol|{s = &0}|
            ) then_tac \
            ASM_REWRITE_TAC(PairList [REAL_LT_LE]) then_tac \
            REWRITE_TAC(PairList [REAL_POW_ZERO]) then_tac \
            CONV_TAC(NUM_REDUCE_CONV) then_tac \
            ASM_REWRITE_TAC(PairList [REAL_NOT_LE]) then_tac \
            STRIP_TAC then_tac \
            FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
            UNDISCH_TAC(
              @hol|{&0 < y}|
            ) then_tac \
            REAL_ARITH_TAC,
            DISCH_THEN(
              X_CHOOSE_THEN(@hol|{z:real}|)(CONJUNCTS_THEN2(MP_TAC)(STRIP_ASSUME_TAC))
            ) then_tac \
            REWRITE_TAC(PairList [REAL_NOT_LT]) then_tac \
            FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
            X_GEN_TAC(@hol|{x:real}|) then_tac \
            DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC)) then_tac \
            GEN_REWRITE_TAC(I)(PairList [GSYM(CONTRAPOS_THM)]) then_tac \
            REWRITE_TAC(PairList [REAL_NOT_LE]) then_tac \
            DISCH_TAC then_tac \
            TRANS_TAC(REAL_LTE_TRANS)(
              @hol|{(z:real) pow 2}|
            ) then_tac \
            ASM_REWRITE_TAC(PairList [GSYM(REAL_LE_SQUARE_ABS)]) then_tac \
            REPEAT(POP_ASSUM(MP_TAC)) then_tac \
            REAL_ARITH_TAC
          ],
          MP_TAC(ISPECL(PairList [@hol|{s:real}|, @hol|{y:real}|])(lemma)) then_tac \
          ASM_REWRITE_TAC(PairList []) then_tac \
          DISCH_THEN(
            X_CHOOSE_THEN(@hol|{z:real}|)(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC))
          ) then_tac \
          MATCH_MP_TAC(
            REAL_ARITH(
              @hol|{abs z <= s ==> s < z ==> F}|
            )
          ) then_tac \
          FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
          ASM_SIMP_TAC(PairList [REAL_ABS_POS, REAL_POW2_ABS, REAL_LT_IMP_LE])
        ]
      ]
    )
  prove(
    [
      @hol|{!x. real_sgn(sqrt x) = real_sgn x /\ sqrt(x) pow 2 = abs x}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [real_sqrt]) then_tac \
      CONV_TAC(SELECT_CONV) then_tac \
      SUBGOAL_THEN(
        @hol|{!x. &0 < x ==> ?y. &0 < y /\ y pow 2 = x}|
      )(ASSUME_TAC) then_list \
      PairList [
        REPEAT(STRIP_TAC) then_tac \
        MP_TAC(SPEC(@hol|{x:real}|)(main_lemma)) then_tac \
        ASM_REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac \
        X_GEN_TAC(@hol|{y:real}|) then_tac \
        STRIP_TAC then_tac \
        EXISTS_TAC(@hol|{abs y:real}|) then_tac \
        ASM_REWRITE_TAC(PairList [REAL_POW2_ABS, GSYM(REAL_ABS_NZ)]) then_tac \
        DISCH_THEN(SUBST_ALL_TAC) then_tac \
        REPEAT(POP_ASSUM(MP_TAC)) then_tac \
        REAL_ARITH_TAC,
        ASM_CASES_TAC(
          @hol|{x = &0}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList [REAL_SGN_0, REAL_SGN_EQ, UNWIND_THM2]) then_tac \
        REWRITE_TAC(PairList [REAL_ABS_NUM, REAL_POW_ZERO, ARITH]) then_tac \
        FIRST_X_ASSUM(
          o(MP_TAC)(SPEC(@hol|{abs x}|))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [GSYM(REAL_ABS_NZ)]) then_tac \
        DISCH_THEN(X_CHOOSE_THEN(@hol|{y:real}|)(STRIP_ASSUME_TAC)) then_tac \
        EXISTS_TAC(
          @hol|{real_sgn x * y}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList [REAL_POW_MUL, GSYM(REAL_SGN_POW), REAL_SGN_POW_2]) then_tac \
        REWRITE_TAC(PairList [REAL_SGN_MUL, REAL_SGN_REAL_SGN]) then_tac \
        ASM_SIMP_TAC(
          PairList [
            real_sgn,
            REAL_ARITH(
              @hol|{&0 < abs x <=> ~(x = &0)}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [REAL_MUL_LID, REAL_MUL_RID])
      ]
    ]
  )

def SQRT_UNIQUE_GEN:
  prove(
    [
      @hol|{!x y. real_sgn y = real_sgn x /\ y pow 2 = abs x ==> sqrt x = y}|,
      REPEAT(GEN_TAC) then_tac \
      MP_TAC(GSYM(SPEC(@hol|{x:real}|)(SQRT_WORKS_GEN))) then_tac \
      SIMP_TAC(
        PairList [
          REAL_ENTIRE,
          REAL_SUB_0,
          REAL_ARITH(
            @hol|{x pow 2 = y pow 2 <=> (x:real - y) * (x - --y) = &0}|
          )
        ]
      ) then_tac \
      DISCH_THEN(K(ALL_TAC)) then_tac \
      REWRITE_TAC(PairList [IMP_CONJ_ALT]) then_tac \
      STRIP_TAC then_tac \
      ASM_REWRITE_TAC(PairList [REAL_SGN_NEG]) then_tac \
      SIMP_TAC(
        PairList [
          REAL_ARITH(
            @hol|{--x = x <=> x = &0}|
          ),
          REAL_SGN_EQ,
          REAL_NEG_0,
          SQRT_0
        ]
      )
    ]
  )

def SQRT_NEG:
  prove(
    [
      @hol|{!x. sqrt(--x) = --sqrt(x)}|,
      GEN_TAC then_tac MATCH_MP_TAC(SQRT_UNIQUE_GEN) then_tac \
      REWRITE_TAC(PairList [REAL_SGN_NEG, REAL_POW_NEG, REAL_ABS_NEG, ARITH]) then_tac \
      REWRITE_TAC(PairList [SQRT_WORKS_GEN])
    ]
  )

def REAL_SGN_SQRT:
  prove(
    [
      @hol|{!x. real_sgn(sqrt x) = real_sgn x}|,
      REWRITE_TAC(PairList [SQRT_WORKS_GEN])
    ]
  )

def SQRT_WORKS:
  prove(
    [
      @hol|{!x. &0 <= x ==> &0 <= sqrt(x) /\ sqrt(x) pow 2 = x}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(SPEC(@hol|{x:real}|)(SQRT_WORKS_GEN)) then_tac \
      REWRITE_TAC(PairList [real_sgn]) then_tac \
      REPEAT(POP_ASSUM(MP_TAC)) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_POS_EQ_SQUARE:
  prove(
    [
      @hol|{!x. &0 <= x <=> ?y. y pow 2 = x}|,
      MESON_TAC(PairList [REAL_LE_POW_2, SQRT_WORKS])
    ]
  )

def SQRT_POS_LE:
  prove(
    [
      @hol|{!x. &0 <= x ==> &0 <= sqrt(x)}|,
      MESON_TAC(PairList [SQRT_WORKS])
    ]
  )

def SQRT_POW_2:
  prove(
    [
      @hol|{!x. &0 <= x ==> sqrt(x) pow 2 = x}|,
      MESON_TAC(PairList [SQRT_WORKS])
    ]
  )

def SQRT_POW2:
  prove(
    [
      @hol|{!x. sqrt(x) pow 2 = x <=> &0 <= x}|,
      MESON_TAC(PairList [REAL_POW_2, REAL_LE_SQUARE, SQRT_POW_2])
    ]
  )

def SQRT_MUL:
  prove(
    [
      @hol|{!x y. sqrt(x * y) = sqrt x * sqrt y}|,
      REPEAT(GEN_TAC) then_tac MATCH_MP_TAC(SQRT_UNIQUE_GEN) then_tac \
      REWRITE_TAC(PairList [REAL_SGN_MUL, REAL_POW_MUL, SQRT_WORKS_GEN, REAL_ABS_MUL])
    ]
  )

def SQRT_INV:
  prove(
    [
      @hol|{!x. sqrt (inv x) = inv(sqrt x)}|,
      GEN_TAC then_tac MATCH_MP_TAC(SQRT_UNIQUE_GEN) then_tac \
      REWRITE_TAC(PairList [REAL_SGN_INV, REAL_POW_INV, REAL_ABS_INV, SQRT_WORKS_GEN])
    ]
  )

def SQRT_DIV:
  prove(
    [
      @hol|{!x y. sqrt (x / y) = sqrt x / sqrt y}|,
      REWRITE_TAC(PairList [real_div, SQRT_MUL, SQRT_INV])
    ]
  )

def SQRT_LT_0:
  prove(
    [
      @hol|{!x. &0 < sqrt x <=> &0 < x}|,
      REWRITE_TAC(PairList [GSYM(real_gt), GSYM(REAL_SGN_EQ), REAL_SGN_SQRT])
    ]
  )

def SQRT_EQ_0:
  prove(
    [
      @hol|{!x. sqrt x = &0 <=> x = &0}|,
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_SGN_EQ)]) then_tac \
      REWRITE_TAC(PairList [REAL_SGN_SQRT])
    ]
  )

def SQRT_LE_0:
  prove(
    [
      @hol|{!x. &0 <= sqrt x <=> &0 <= x}|,
      REWRITE_TAC(
        PairList [
          REAL_ARITH(
            @hol|{&0 <= x <=> &0 < x \/ x = &0}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [SQRT_LT_0, SQRT_EQ_0])
    ]
  )

def REAL_ABS_SQRT:
  prove(
    [
      @hol|{!x. abs(sqrt x) = sqrt(abs x)}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [real_abs, SQRT_LE_0]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [SQRT_NEG])
    ]
  )

def SQRT_MONO_LT:
  prove(
    [
      @hol|{!x y. x < y ==> sqrt(x) < sqrt(y)}|,
      SUBGOAL_THEN(
        @hol|{!x y. &0 <= x /\ x < y ==> sqrt x < sqrt y}|
      )(ASSUME_TAC) then_list \
      PairList [
        REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_POW_LT2_REV) then_tac \
        EXISTS_TAC(
          @hol|{2}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList [SQRT_WORKS_GEN, SQRT_LE_0]) then_tac \
        REPEAT(POP_ASSUM(MP_TAC)) then_tac \
        REAL_ARITH_TAC,
        REPEAT(STRIP_TAC) then_tac \
        ASM_CASES_TAC(
          @hol|{&0 <= x}|
        ) then_tac \
        ASM_SIMP_TAC(PairList []) then_tac \
        ASM_CASES_TAC(
          @hol|{&0 <= y}|
        ) then_list \
        PairList [
          MATCH_MP_TAC(REAL_LTE_TRANS) then_tac \
          EXISTS_TAC(
            @hol|{&0}|
          ) then_tac \
          ASM_REWRITE_TAC(PairList [GSYM(REAL_NOT_LE), SQRT_LE_0]),
          FIRST_X_ASSUM(
            o(MP_TAC)(
              SPECL(
                PairList [
                  @hol|{--y:real}|,
                  @hol|{--x:real}|
                ]
              )
            )
          ) then_tac \
          REWRITE_TAC(PairList [SQRT_NEG]) then_tac \
          REPEAT(POP_ASSUM(MP_TAC)) then_tac \
          REAL_ARITH_TAC
        ]
      ]
    ]
  )

def SQRT_MONO_LE:
  prove(
    [
      @hol|{!x y. x <= y ==> sqrt(x) <= sqrt(y)}|,
      MESON_TAC(PairList [REAL_LE_LT, SQRT_MONO_LT])
    ]
  )

def SQRT_MONO_LT_EQ:
  prove(
    [
      @hol|{!x y. sqrt(x) < sqrt(y) <=> x < y}|,
      MESON_TAC(PairList [REAL_NOT_LT, SQRT_MONO_LT, SQRT_MONO_LE])
    ]
  )

def SQRT_MONO_LE_EQ:
  prove(
    [
      @hol|{!x y. sqrt(x) <= sqrt(y) <=> x <= y}|,
      MESON_TAC(PairList [REAL_NOT_LT, SQRT_MONO_LT, SQRT_MONO_LE])
    ]
  )

def SQRT_INJ:
  prove(
    [
      @hol|{!x y. sqrt(x) = sqrt(y) <=> x = y}|,
      SIMP_TAC(PairList [GSYM(REAL_LE_ANTISYM), SQRT_MONO_LE_EQ])
    ]
  )

def SQRT_EQ_1:
  prove(
    [
      @hol|{!x. sqrt x = &1 <=> x = &1}|,
      MESON_TAC(PairList [SQRT_INJ, SQRT_1])
    ]
  )

def SQRT_POS_LT:
  prove(
    [
      @hol|{!x. &0 < x ==> &0 < sqrt(x)}|,
      MESON_TAC(PairList [REAL_LT_LE, SQRT_POS_LE, SQRT_EQ_0])
    ]
  )

def REAL_LE_LSQRT:
  prove(
    [
      @hol|{!x y. &0 <= y /\ x <= y pow 2 ==> sqrt(x) <= y}|,
      MESON_TAC(PairList [SQRT_MONO_LE, REAL_POW_LE, POW_2_SQRT])
    ]
  )

def REAL_LE_RSQRT:
  prove(
    [
      @hol|{!x y. x pow 2 <= y ==> x <= sqrt(y)}|,
      MESON_TAC(
        PairList [
          REAL_LE_TOTAL,
          SQRT_MONO_LE,
          SQRT_POS_LE,
          REAL_POW_2,
          REAL_LE_SQUARE,
          REAL_LE_TRANS,
          POW_2_SQRT
        ]
      )
    ]
  )

def REAL_LT_LSQRT:
  prove(
    [
      @hol|{!x y. &0 <= y /\ x < y pow 2 ==> sqrt x < y}|,
      MESON_TAC(PairList [SQRT_MONO_LT, REAL_POW_LE, POW_2_SQRT])
    ]
  )

def REAL_LT_RSQRT:
  prove(
    [
      @hol|{!x y. x pow 2 < y ==> x < sqrt(y)}|,
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(
        REAL_ARITH(
          @hol|{abs x < a ==> x < a}|
        )
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(POW_2_SQRT_ABS)]) then_tac \
      MATCH_MP_TAC(SQRT_MONO_LT) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_POW_2, REAL_LE_SQUARE])
    ]
  )

def SQRT_EVEN_POW2:
  prove(
    [
      @hol|{!n. EVEN n ==> (sqrt(&2 pow n) = &2 pow (n DIV 2))}|,
      SIMP_TAC(PairList [EVEN_EXISTS, LEFT_IMP_EXISTS_THM, DIV_MULT, ARITH_EQ]) then_tac \
      MESON_TAC(PairList [SQRT_UNIQUE, REAL_POW_POW, MULT_SYM, REAL_POW_LE, REAL_POS])
    ]
  )

def REAL_DIV_SQRT:
  prove(
    [
      @hol|{!x. &0 <= x ==> x / sqrt(x) = sqrt(x)}|,
      REWRITE_TAC(PairList [REAL_LE_LT]) then_tac REPEAT(STRIP_TAC) then_list \
      PairList [
        ALL_TAC,
        ASM_MESON_TAC(PairList [SQRT_0, real_div, REAL_MUL_LZERO])
      ] then_tac \
      ASM_SIMP_TAC(PairList [REAL_EQ_LDIV_EQ, SQRT_POS_LT, GSYM(REAL_POW_2)]) then_tac \
      ASM_SIMP_TAC(PairList [SQRT_POW_2, REAL_LT_IMP_LE])
    ]
  )

def REAL_RSQRT_LE:
  prove(
    [
      @hol|{!x y. &0 <= x /\ &0 <= y /\ x <= sqrt y ==> x pow 2 <= y}|,
      MESON_TAC(PairList [REAL_POW_LE2, SQRT_POW_2])
    ]
  )

def REAL_LSQRT_LE:
  prove(
    [
      @hol|{!x y. &0 <= x /\ sqrt x <= y ==> x <= y pow 2}|,
      MESON_TAC(PairList [REAL_POW_LE2, SQRT_POS_LE, REAL_LE_TRANS, SQRT_POW_2])
    ]
  )

def REAL_SQRT_POW_2:
  prove(
    [
      @hol|{!x. sqrt x pow 2 = abs x}|,
      REWRITE_TAC(PairList [SQRT_WORKS_GEN])
    ]
  )

def REAL_ABS_LE_SQRT_POS:
  prove(
    [
      @hol|{!x y. &0 <= x /\ &0 <= y ==> abs(sqrt x - sqrt y) <= sqrt(abs(x - y))}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LE_RSQRT) then_tac \
      REWRITE_TAC(PairList [REAL_POW_2]) then_tac \
      TRANS_TAC(REAL_LE_TRANS)(
        @hol|{abs(sqrt x - sqrt y) * abs(sqrt x + sqrt y)}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(REAL_LE_LMUL) then_tac REWRITE_TAC(PairList [REAL_ABS_POS]) then_tac \
        MATCH_MP_TAC(
          REAL_ARITH(
            @hol|{&0 <= x /\ &0 <= y ==> abs(x - y) <= abs(x + y)}|
          )
        ) then_tac \
        ASM_SIMP_TAC(PairList [SQRT_POS_LE]),
        REWRITE_TAC(
          PairList [
            GSYM(REAL_ABS_MUL),
            REAL_ARITH(
              @hol|{(x - y:real) * (x + y) = x pow 2 - y pow 2}|
            )
          ]
        ) then_tac \
        ASM_SIMP_TAC(PairList [SQRT_POW_2, REAL_LE_REFL])
      ]
    ]
  )

def REAL_ABS_LE_SQRT:
  prove(
    [
      @hol|{!x y. abs(sqrt x - sqrt y) <= sqrt(&2 * abs(x - y))}|,
      MATCH_MP_TAC(REAL_WLOG_LE) then_tac CONJ_TAC then_list \
      PairList [REWRITE_TAC(PairList [REAL_ABS_SUB]), ALL_TAC] then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{x:real}|, @hol|{y:real}|]) then_tac \
      DISCH_TAC then_tac \
      ASM_CASES_TAC(
        @hol|{&0 <= x}|
      ) then_list \
      PairList [
        TRANS_TAC(REAL_LE_TRANS)(
          @hol|{sqrt(abs(x - y))}|
        ) then_tac \
        REWRITE_TAC(
          PairList [
            SQRT_MONO_LE_EQ,
            REAL_ARITH(
              @hol|{abs x <= &2 * abs x}|
            )
          ]
        ) then_tac \
        MATCH_MP_TAC(REAL_ABS_LE_SQRT_POS) then_tac \
        REPEAT(POP_ASSUM(MP_TAC)) then_tac \
        REAL_ARITH_TAC,
        ALL_TAC
      ] then_tac \
      ASM_CASES_TAC(
        @hol|{&0 <= y}|
      ) then_list \
      PairList [
        ALL_TAC,
        ONCE_REWRITE_TAC(
          PairList [
            REAL_ARITH(
              @hol|{abs(x - y) = abs(--x - --y)}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [GSYM(SQRT_NEG)]) then_tac \
        TRANS_TAC(REAL_LE_TRANS)(
          @hol|{sqrt(abs(--x - --y))}|
        ) then_tac \
        REWRITE_TAC(
          PairList [
            SQRT_MONO_LE_EQ,
            REAL_ARITH(
              @hol|{abs x <= &2 * abs x}|
            )
          ]
        ) then_tac \
        MATCH_MP_TAC(REAL_ABS_LE_SQRT_POS) then_tac \
        REPEAT(POP_ASSUM(MP_TAC)) then_tac \
        REAL_ARITH_TAC
      ] then_tac \
      ASM_SIMP_TAC(
        PairList [
          SQRT_LE_0,
          REAL_ARITH(
            @hol|{~(&0 <= x) /\ &0 <= y ==> abs(x - y) = y - x}|
          )
        ]
      ) then_tac \
      MATCH_MP_TAC(REAL_LE_RSQRT) then_tac \
      MP_TAC(
        SPEC(
          @hol|{sqrt(--x) - sqrt y}|
        )(REAL_LE_POW_2)
      ) then_tac \
      REWRITE_TAC(
        PairList [
          REAL_ARITH(
            @hol|{(x - y:real) pow 2 = (x pow 2 + y pow 2) - &2 * x * y}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REAL_SQRT_POW_2]) then_tac \
      REWRITE_TAC(PairList [SQRT_NEG, REAL_ABS_NEG]) then_tac \
      REPEAT(POP_ASSUM(MP_TAC)) then_tac \
      REAL_ARITH_TAC
    ]
  )

def sqrt = real_sqrt
