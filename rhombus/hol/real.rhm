      @hol|{!x y. inv(x * y) = inv(x) * inv(y)}|,
      REPEAT(GEN_TAC) then_tac \
      MAP_EVERY(ASM_CASES_TAC)(
        PairList [
          @hol|{x = &0}|,
          @hol|{y = &0}|
