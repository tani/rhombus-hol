def REAL_OF_NUM_LT:
  prove(
    [
      @hol|{!m n. &m < &n <=> m < n}|,
      REWRITE_TAC(PairList [real_lt, GSYM(NOT_LE), REAL_OF_NUM_LE])
    ]
  )

def REAL_OF_NUM_GE:
  prove(
    [
      @hol|{!m n. &m >= &n <=> m >= n}|,
      REWRITE_TAC(PairList [GE, real_ge, REAL_OF_NUM_LE])
    ]
  )

def REAL_OF_NUM_GT:
  prove(
    [
      @hol|{!m n. &m > &n <=> m > n}|,
      REWRITE_TAC(PairList [GT, real_gt, REAL_OF_NUM_LT])
    ]
  )

def REAL_OF_NUM_MAX:
  prove(
    [
      @hol|{!m n. max (&m) (&n) = &(MAX m n)}|,
      REWRITE_TAC(PairList [REAL_OF_NUM_LE, MAX, real_max, GSYM(COND_RAND)])
    ]
  )

def REAL_OF_NUM_MIN:
  prove(
    [
      @hol|{!m n. min (&m) (&n) = &(MIN m n)}|,
      REWRITE_TAC(PairList [REAL_OF_NUM_LE, MIN, real_min, GSYM(COND_RAND)])
    ]
  )

def REAL_OF_NUM_SUC:
  prove(
    [
      @hol|{!n. &n + &1 = &(SUC n)}|,
      REWRITE_TAC(PairList [ADD1, REAL_OF_NUM_ADD])
    ]
  )

def REAL_OF_NUM_SUB:
  prove(
    [
      @hol|{!m n. m <= n ==> (&n - &m = &(n - m))}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [LE_EXISTS]) then_tac \
      STRIP_TAC then_tac \
      ASM_REWRITE_TAC(PairList [ADD_SUB2]) then_tac \
      REWRITE_TAC(PairList [GSYM(REAL_OF_NUM_ADD)]) then_tac \
      ONCE_REWRITE_TAC(PairList [REAL_ADD_SYM]) then_tac \
      REWRITE_TAC(PairList [real_sub, GSYM(REAL_ADD_ASSOC)]) then_tac \
      MESON_TAC(PairList [REAL_ADD_LINV, REAL_ADD_SYM, REAL_ADD_LID])
    ]
  )

def REAL_OF_NUM_SUB_CASES:
  prove(
    [
      @hol|{!m n. &m - &n = if n <= m then &(m - n) else -- &(n - m)}|,
      REPEAT(GEN_TAC) then_tac COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList [REAL_OF_NUM_SUB]) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_NEG_SUB)]) then_tac \
      AP_TERM_TAC then_tac \
      MATCH_MP_TAC(REAL_OF_NUM_SUB) then_tac \
      ASM_MESON_TAC(PairList [LE_CASES])
    ]
  )

def REAL_OF_NUM_CLAUSES:
  prove(
    [
      @hol|{(!m n. &m:real = &n <=> m = n) /\
         (!m n. &m:real >= &n <=> m >= n) /\
         (!m n. &m:real > &n <=> m > n) /\
         (!m n. &m:real <= &n <=> m <= n) /\
         (!m n. &m:real < &n <=> m < n) /\
         (!m n. max (&m) (&n):real = &(MAX m n)) /\
         (!m n. min (&m) (&n):real = &(MIN m n)) /\
         (!m n. &m + &n:real = &(m + n)) /\
         (!m n. &m * &n:real = &(m * n)) /\
         (!x n. (&x:real) pow n = &(x EXP n))}|,
      REWRITE_TAC(
        PairList [
          REAL_OF_NUM_EQ,
          REAL_OF_NUM_GE,
          REAL_OF_NUM_GT,
          REAL_OF_NUM_LE,
          REAL_OF_NUM_LT,
          REAL_OF_NUM_MAX,
          REAL_OF_NUM_MIN,
          REAL_OF_NUM_ADD,
          REAL_OF_NUM_MUL,
          REAL_OF_NUM_POW
        ]
      )
    ]
  )

def REAL_MUL_AC:
  prove(
    [
      @hol|{(m * n = n * m) /\
         ((m * n) * p = m * (n * p)) /\
         (m * (n * p) = n * (m * p))}|,
      REWRITE_TAC(PairList [REAL_MUL_ASSOC, EQT_INTRO(SPEC_ALL(REAL_MUL_SYM))]) then_tac \
      AP_THM_TAC then_tac \
      AP_TERM_TAC then_tac \
      MATCH_ACCEPT_TAC(REAL_MUL_SYM)
    ]
  )

def REAL_ADD_RDISTRIB:
  prove(
    [
      @hol|{!x y z. (x + y) * z = x * z + y * z}|,
      MESON_TAC(PairList [REAL_MUL_SYM, REAL_ADD_LDISTRIB])
    ]
  )

def REAL_LT_LADD_IMP:
  prove(
    [
      @hol|{!x y z. y < z ==> x + y < x + z}|,
      REPEAT(GEN_TAC) then_tac CONV_TAC(CONTRAPOS_CONV) then_tac \
      REWRITE_TAC(PairList [real_lt]) then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(REAL_LE_LADD_IMP))) then_tac \
      DISCH_THEN(
        o(MP_TAC)(SPEC(@hol|{--x}|))
      ) then_tac \
      REWRITE_TAC(PairList [REAL_ADD_ASSOC, REAL_ADD_LINV, REAL_ADD_LID])
    ]
  )

def REAL_LT_MUL:
  prove(
    [
      @hol|{!x y. &0 < x /\ &0 < y ==> &0 < x * y}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [REAL_LT_LE]) then_tac \
      CONV_TAC(ONCE_DEPTH_CONV(SYM_CONV)) then_tac \
      STRIP_TAC then_tac \
      ASM_REWRITE_TAC(PairList [REAL_ENTIRE]) then_tac \
      MATCH_MP_TAC(REAL_LE_MUL) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

