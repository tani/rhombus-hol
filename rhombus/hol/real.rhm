                      )
                    )
                  )
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [REAL_POW_NEG, REAL_POW_ONE])
            ) then_tac \
            REPEAT(COND_CASES_TAC)
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        REAL_ARITH_TAC
      )
    ]
  )

def REAL_POW_LT2_ODD:
  prove(
    [
      (hol:
         const ODD :: num -> bool
         const real_pow :: real -> num -> real
         forall (n :: num, x :: real, y :: real): x < y && ODD(n) ==> real_pow(x, n) < real_pow(y, n)),
      (
        (
          (
            (
              (
                REPEAT(GEN_TAC) then_tac \
                ASM_CASES_TAC(
                  (hol:
                     var n :: num
                     n == (0 :: num))
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [ARITH])
            ) then_tac \
            STRIP_TAC
          ) then_tac \
          DISJ_CASES_TAC(SPEC(hol:
                                var y :: real
                                y)(REAL_LE_NEGTOTAL))
        ) then_list \
        PairList [
          (
            (
              (
                DISJ_CASES_TAC(
                  REAL_ARITH(
                    (hol:
                       var x :: real
                       (0 :: real) <= x || (0 :: real) < -x)
                  )
                ) then_tac \
                ASM_SIMP_TAC(PairList [REAL_POW_LT2])
              ) then_tac \
              SUBGOAL_THEN(
                (hol:
                   var x :: real
                   var n :: num
                   var y :: real
                   const real_pow :: real -> num -> real
                   (0 :: real) < real_pow(-x, n) && (0 :: real) <= real_pow(y, n))
              )(MP_TAC)
            ) then_list \
            PairList [
              ASM_SIMP_TAC(PairList [REAL_POW_LE, REAL_POW_LT]),
              (
                ASM_REWRITE_TAC(PairList [REAL_POW_NEG, GSYM(NOT_ODD)]) then_tac \
                REAL_ARITH_TAC
              )
            ]
          ),
          (
            (
              (
                SUBGOAL_THEN(
                  (hol:
                     var y :: real
                     var n :: num
                     var x :: real
                     const real_pow :: real -> num -> real
                     real_pow(-y, n) < real_pow(-x, n))
                )(MP_TAC) then_list \
                PairList [
                  (MATCH_MP_TAC(REAL_POW_LT2) then_tac ASM_REWRITE_TAC(PairList [])),
                  ASM_REWRITE_TAC(PairList [REAL_POW_NEG, GSYM(NOT_ODD)])
                ]
              ) then_tac \
              REPEAT(POP_ASSUM(MP_TAC))
            ) then_tac \
            REAL_ARITH_TAC
          )
        ]
      )
    ]
  )

