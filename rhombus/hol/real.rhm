def REAL_OF_NUM_LT:
  prove(
    [
      Host.hol_term(Forall(
        "m",
        Num,
        Forall(
          "n",
          Num,
          Iff(
            App(
              Const("real_lt", Fun(Real, Fun(Real, Bool))),
              [
                App(Const("real_of_num", Fun(Num, Real)), [Ref("m")]),
                App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])
              ]
            ),
            App(Const("<", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")])
          )
        )
      )),
      REWRITE_TAC(PairList [real_lt, GSYM(NOT_LE), REAL_OF_NUM_LE])
    ]
  )

def REAL_OF_NUM_GE:
  prove(
    [
      Host.hol_term(Forall(
        "m",
        Num,
        Forall(
          "n",
          Num,
          Iff(
            App(
              Const("real_ge", Fun(Real, Fun(Real, Bool))),
              [
                App(Const("real_of_num", Fun(Num, Real)), [Ref("m")]),
                App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])
              ]
            ),
            App(Const(">=", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")])
          )
        )
      )),
      REWRITE_TAC(PairList [GE, real_ge, REAL_OF_NUM_LE])
    ]
  )

def REAL_OF_NUM_GT:
  prove(
    [
      Host.hol_term(Forall(
        "m",
        Num,
        Forall(
          "n",
          Num,
          Iff(
            App(
              Const("real_gt", Fun(Real, Fun(Real, Bool))),
              [
                App(Const("real_of_num", Fun(Num, Real)), [Ref("m")]),
                App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])
              ]
            ),
            App(Const(">", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")])
          )
        )
      )),
      REWRITE_TAC(PairList [GT, real_gt, REAL_OF_NUM_LT])
    ]
  )

def REAL_OF_NUM_MAX:
  prove(
    [
      Host.hol_term(Forall(
        "m",
        Num,
        Forall(
          "n",
          Num,
          Eq(
            Real,
            App(
              Const("real_max", Fun(Real, Fun(Real, Real))),
              [
                App(Const("real_of_num", Fun(Num, Real)), [Ref("m")]),
                App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])
              ]
            ),
            App(
              Const("real_of_num", Fun(Num, Real)),
              [App(Const("MAX", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])]
            )
          )
        )
      )),
      REWRITE_TAC(PairList [REAL_OF_NUM_LE, MAX, real_max, GSYM(COND_RAND)])
    ]
  )

