def REAL_ABS_MUL:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         forall (x :: real, y :: real): real_abs(x * y) == real_abs(x) * real_abs(y)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      REPEAT(GEN_TAC) then_tac \
                      DISJ_CASES_TAC(SPEC(hol:
                                            var x :: real
                                            x)(REAL_LE_NEGTOTAL))
                    ) then_list \
                    PairList [
                      ALL_TAC,
                      GEN_REWRITE_TAC(o(RAND_CONV)(LAND_CONV))(PairList [GSYM(REAL_ABS_NEG)])
                    ]
                  ) then_tac \
                  (
                    DISJ_CASES_TAC(SPEC(hol:
                                          var y :: real
                                          y)(REAL_LE_NEGTOTAL)) then_list \
                    PairList [
                      ALL_TAC,
                      GEN_REWRITE_TAC(o(RAND_CONV)(RAND_CONV))(PairList [GSYM(REAL_ABS_NEG)])
                    ]
                  )
                ) then_tac \
                ASSUM_LIST(o(o(o(MP_TAC)(MATCH_MP(REAL_LE_MUL)))(end_itlist(CONJ)))(rev))
              ) then_tac \
              REWRITE_TAC(PairList [REAL_MUL_LNEG, REAL_MUL_RNEG, REAL_NEG_NEG])
            ) then_tac \
            DISCH_TAC
          ) then_list \
          PairList [
            ALL_TAC,
            GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_ABS_NEG)]),
            GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_ABS_NEG)]),
            ALL_TAC
          ]
        ) then_tac \
        ASM_REWRITE_TAC(PairList [real_abs, REAL_MUL_LNEG, REAL_MUL_RNEG, REAL_NEG_NEG])
      )
    ]
  )

