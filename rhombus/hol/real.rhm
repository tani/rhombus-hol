def REAL_ABS_LE_SQRT_POS:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         const sqrt :: real -> real
         forall (x :: real, y :: real):
           (0 :: real) <= x && (0 :: real) <= y
             ==> real_abs(sqrt(x) - sqrt(y)) <= sqrt(real_abs(x - y))),
      (
        (
          (
            (
              (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LE_RSQRT)) then_tac \
              REWRITE_TAC(PairList [REAL_POW_2])
            ) then_tac \
            TRANS_TAC(REAL_LE_TRANS)(
              (hol:
                 var x :: real
                 var y :: real
                 const real_abs :: real -> real
                 const sqrt :: real -> real
                 real_abs(sqrt(x) - sqrt(y)) * real_abs(sqrt(x) + sqrt(y)))
            )
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            (
              (MATCH_MP_TAC(REAL_LE_LMUL) then_tac REWRITE_TAC(PairList [REAL_ABS_POS])) then_tac \
              MATCH_MP_TAC(
                REAL_ARITH(
                  (hol:
                     var x :: real
                     var y :: real
                     const real_abs :: real -> real
                     (0 :: real) <= x && (0 :: real) <= y ==> real_abs(x - y) <= real_abs(x + y))
                )
              )
            ) then_tac \
            ASM_SIMP_TAC(PairList [SQRT_POS_LE])
          ),
          (
            REWRITE_TAC(
              PairList [
                GSYM(REAL_ABS_MUL),
                REAL_ARITH(
                  (hol:
                     var x :: real
                     var y :: real
                     const real_pow :: real -> num -> real
                     (x - y) * (x + y) == real_pow(x, (2 :: num)) - real_pow(y, (2 :: num)))
                )
              ]
            ) then_tac \
            ASM_SIMP_TAC(PairList [SQRT_POW_2, REAL_LE_REFL])
          )
        ]
      )
    ]
  )

def REAL_ABS_LE_SQRT:
  prove(
    [
      (hol:
         const real_abs :: real -> real
         const sqrt :: real -> real
         forall (x :: real, y :: real):
           real_abs(sqrt(x) - sqrt(y)) <= sqrt((2 :: real) * real_abs(x - y))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (MATCH_MP_TAC(REAL_WLOG_LE) then_tac CONJ_TAC) then_list \
                                    PairList [REWRITE_TAC(PairList [REAL_ABS_SUB]), ALL_TAC]
                                  ) then_tac \
                                  MAP_EVERY(X_GEN_TAC)(PairList [(hol:
                                                                    var x :: real
                                                                    x), (hol:
                                                                                              var y :: real
                                                                                              y)])
                                ) then_tac \
