def SQRT_UNIQUE_GEN:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Implies(
            And(
              Eq(
                Real,
                App(Const("real_sgn", Fun(Real, Real)), [Ref("y")]),
                App(Const("real_sgn", Fun(Real, Real)), [Ref("x")])
              ),
              Eq(
                Real,
                App(
                  Const("real_pow", Fun(Real, Fun(Num, Real))),
                  [
                    Ref("y"),
                    App(
                      Const("NUMERAL", Fun(Num, Num)),
                      [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                    )
                  ]
                ),
                App(Const("real_abs", Fun(Real, Real)), [Ref("x")])
              )
            ),
            Eq(Real, App(Const("sqrt", Fun(Real, Real)), [Ref("x")]), Ref("y"))
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(GEN_TAC) then_tac \
                    MP_TAC(GSYM(SPEC(Host.hol_term(Var("x", Real)))(SQRT_WORKS_GEN)))
                  ) then_tac \
                  SIMP_TAC(
                    PairList [
                      REAL_ENTIRE,
                      REAL_SUB_0,
                      REAL_ARITH(
                        Host.hol_term(Iff(
                          Eq(
                            Real,
                            App(
                              Const("real_pow", Fun(Real, Fun(Num, Real))),
                              [
                                Var("x", Real),
                                App(
                                  Const("NUMERAL", Fun(Num, Num)),
                                  [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                                )
                              ]
                            ),
                            App(
                              Const("real_pow", Fun(Real, Fun(Num, Real))),
                              [
                                Var("y", Real),
                                App(
                                  Const("NUMERAL", Fun(Num, Num)),
                                  [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                                )
                              ]
                            )
                          ),
                          Eq(
                            Real,
                            App(
                              Const("real_mul", Fun(Real, Fun(Real, Real))),
                              [
                                App(Const("real_sub", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)]),
                                App(
                                  Const("real_sub", Fun(Real, Fun(Real, Real))),
                                  [Var("x", Real), App(Const("real_neg", Fun(Real, Real)), [Var("y", Real)])]
                                )
                              ]
                            ),
                            App(
                              Const("real_of_num", Fun(Num, Real)),
                              [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                            )
                          )
                        ))
                      )
                    ]
                  )
                ) then_tac \
                DISCH_THEN(K(ALL_TAC))
              ) then_tac \
              REWRITE_TAC(PairList [IMP_CONJ_ALT])
            ) then_tac \
            STRIP_TAC
          ) then_tac \
          ASM_REWRITE_TAC(PairList [REAL_SGN_NEG])
        ) then_tac \
        SIMP_TAC(
          PairList [
            REAL_ARITH(
              Host.hol_term(Iff(
                Eq(Real, App(Const("real_neg", Fun(Real, Real)), [Var("x", Real)]), Var("x", Real)),
                Eq(
                  Real,
                  Var("x", Real),
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  )
                )
              ))
            ),
            REAL_SGN_EQ,
            REAL_NEG_0,
            SQRT_0
          ]
        )
      )
    ]
  )

