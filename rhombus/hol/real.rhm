def REAL_ARCH_SIMPLE:
  let lemma:
    prove(
      [
        Host.hol_term(Iff(
          Forall(
            "x",
            Real,
            Implies(
              Exists("n", Num, Eq(Real, Ref("x"), App(Const("real_of_num", Fun(Num, Real)), [Ref("n")]))),
              App(Var("P", Fun(Real, Bool)), [Ref("x")])
            )
          ),
          Forall(
            "n",
            Num,
            App(Var("P", Fun(Real, Bool)), [App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])])
          )
        )),
        MESON_TAC(PairList [])
      ]
    )
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Real,
        Exists(
          "n",
          Num,
          App(
            Const("real_le", Fun(Real, Fun(Real, Bool))),
            [Ref("x"), App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])]
          )
        )
      )),
      (
        (
          MP_TAC(
            SPEC(
              Host.hol_term(Lambda(
                "y",
                Real,
                Exists("n", Num, Eq(Real, Ref("y"), App(Const("real_of_num", Fun(Num, Real)), [Ref("n")])))
              ))
            )(REAL_COMPLETE)
          ) then_tac \
          REWRITE_TAC(PairList [lemma])
        ) then_tac \
        MESON_TAC(
          PairList [
            REAL_LE_SUB_LADD,
            REAL_OF_NUM_ADD,
            REAL_LE_TOTAL,
            REAL_ARITH(
              Host.hol_term(Not(
                App(
                  Const("real_le", Fun(Real, Fun(Real, Bool))),
                  [
                    Var("M", Real),
                    App(
                      Const("real_sub", Fun(Real, Fun(Real, Real))),
                      [
                        Var("M", Real),
                        App(
                          Const("real_of_num", Fun(Num, Real)),
                          [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                        )
                      ]
                    )
                  ]
                )
              ))
            )
          ]
        )
      )
    ]
  )

