def REAL_LT_INV2:
  prove(
    [
      (hol:
         const real_inv :: real -> real
         forall (x :: real, y :: real): (0 :: real) < x && x < y ==> real_inv(y) < real_inv(x)),
      (
        (
          (
            (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LT_RCANCEL_IMP)) then_tac \
            EXISTS_TAC(
