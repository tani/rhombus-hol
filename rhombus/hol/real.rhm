def REAL_OF_NUM_LT:
  prove(
    [
      (hol:
         const real_of_num :: num -> real
         forall (m :: num, n :: num): real_of_num(m) < real_of_num(n) <=> m < n),
      REWRITE_TAC(PairList [real_lt, GSYM(NOT_LE), REAL_OF_NUM_LE])
    ]
  )

def REAL_OF_NUM_GE:
  prove(
    [
      (hol:
         const real_of_num :: num -> real
         forall (m :: num, n :: num): real_of_num(m) >= real_of_num(n) <=> m >= n),
      REWRITE_TAC(PairList [GE, real_ge, REAL_OF_NUM_LE])
    ]
  )

def REAL_OF_NUM_GT:
  prove(
    [
      (hol:
         const real_of_num :: num -> real
         forall (m :: num, n :: num): real_of_num(m) > real_of_num(n) <=> m > n),
      REWRITE_TAC(PairList [GT, real_gt, REAL_OF_NUM_LT])
    ]
  )

def REAL_OF_NUM_MAX:
  prove(
    [
      (hol:
         const real_max :: real -> real -> real
         const real_of_num :: num -> real
         const MAX :: num -> num -> num
         forall (m :: num, n :: num):
           real_max(real_of_num(m), real_of_num(n)) == real_of_num(MAX(m, n))),
      REWRITE_TAC(PairList [REAL_OF_NUM_LE, MAX, real_max, GSYM(COND_RAND)])
    ]
  )

def REAL_OF_NUM_MIN:
  prove(
    [
      (hol:
         const real_min :: real -> real -> real
         const real_of_num :: num -> real
         const MIN :: num -> num -> num
         forall (m :: num, n :: num):
           real_min(real_of_num(m), real_of_num(n)) == real_of_num(MIN(m, n))),
      REWRITE_TAC(PairList [REAL_OF_NUM_LE, MIN, real_min, GSYM(COND_RAND)])
    ]
  )

def REAL_OF_NUM_SUC:
  prove(
    [
      (hol:
         const real_of_num :: num -> real
         const SUC :: num -> num
         forall n :: num: real_of_num(n) + (1 :: real) == real_of_num(SUC(n))),
      REWRITE_TAC(PairList [ADD1, REAL_OF_NUM_ADD])
    ]
  )

def REAL_OF_NUM_SUB:
  prove(
    [
      (hol:
         const real_of_num :: num -> real
         forall (m :: num, n :: num): m <= n ==> real_of_num(n) - real_of_num(m) == real_of_num(n - m)),
      (
        (
          (
            (
              (
                (
                  (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [LE_EXISTS])) then_tac \
                  STRIP_TAC
                ) then_tac \
                ASM_REWRITE_TAC(PairList [ADD_SUB2])
              ) then_tac \
              REWRITE_TAC(PairList [GSYM(REAL_OF_NUM_ADD)])
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [REAL_ADD_SYM])
          ) then_tac \
          REWRITE_TAC(PairList [real_sub, GSYM(REAL_ADD_ASSOC)])
        ) then_tac \
        MESON_TAC(PairList [REAL_ADD_LINV, REAL_ADD_SYM, REAL_ADD_LID])
      )
    ]
  )

def REAL_OF_NUM_SUB_CASES:
  prove(
    [
      (hol:
         const real_of_num :: num -> real
         forall (m :: num, n :: num):
           real_of_num(m) - real_of_num(n) == (if n <= m | real_of_num(m - n) | -real_of_num(n - m))),
      (
        (
          (
            (
              (
                (REPEAT(GEN_TAC) then_tac COND_CASES_TAC) then_tac \
                ASM_SIMP_TAC(PairList [REAL_OF_NUM_SUB])
              ) then_tac \
              GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(REAL_NEG_SUB)])
            ) then_tac \
            AP_TERM_TAC
          ) then_tac \
          MATCH_MP_TAC(REAL_OF_NUM_SUB)
        ) then_tac \
        ASM_MESON_TAC(PairList [LE_CASES])
      )
    ]
  )

def REAL_OF_NUM_CLAUSES:
  prove(
    [
      (hol:
         const real_of_num :: num -> real
         const real_max :: real -> real -> real
         const MAX :: num -> num -> num
         const real_min :: real -> real -> real
         const MIN :: num -> num -> num
         const real_pow :: real -> num -> real
         const EXP :: num -> num -> num
         (forall (m :: num, n :: num): real_of_num(m) == real_of_num(n) <=> m == n)
           && ((forall (m :: num, n :: num): real_of_num(m) >= real_of_num(n) <=> m >= n)
                 && ((forall (m :: num, n :: num): real_of_num(m) > real_of_num(n) <=> m > n)
                       && ((forall (m :: num, n :: num): real_of_num(m) <= real_of_num(n) <=> m <= n)
                             && ((forall (m :: num, n :: num): real_of_num(m) < real_of_num(n) <=> m < n)
                                   && ((forall (m :: num, n :: num):
                                          real_max(real_of_num(m), real_of_num(n))
                                            == real_of_num(MAX(m, n)))
                                         && ((forall (m :: num, n :: num):
                                                real_min(real_of_num(m), real_of_num(n))
                                                  == real_of_num(MIN(m, n)))
                                               && ((forall (m :: num, n :: num):
                                                      real_of_num(m) + real_of_num(n) == real_of_num(m + n))
                                                     && ((forall (m :: num, n :: num):
                                                            real_of_num(m) * real_of_num(n)
                                                              == real_of_num(m * n))
                                                           && (forall (x :: num, n :: num):
                                                                 real_pow(real_of_num(x), n)
                                                                   == real_of_num(EXP(x, n)))))))))))),
      REWRITE_TAC(
        PairList [
          REAL_OF_NUM_EQ,
          REAL_OF_NUM_GE,
          REAL_OF_NUM_GT,
          REAL_OF_NUM_LE,
          REAL_OF_NUM_LT,
          REAL_OF_NUM_MAX,
          REAL_OF_NUM_MIN,
          REAL_OF_NUM_ADD,
          REAL_OF_NUM_MUL,
          REAL_OF_NUM_POW
        ]
      )
    ]
  )

def REAL_MUL_AC:
  prove(
    [
      (hol:
         var m :: real
         var n :: real
         var p :: real
         m * n == n * m && (m * n * p == m * (n * p) && m * (n * p) == n * (m * p))),
      (
        (
          (
            REWRITE_TAC(PairList [REAL_MUL_ASSOC, EQT_INTRO(SPEC_ALL(REAL_MUL_SYM))]) then_tac \
            AP_THM_TAC
          ) then_tac \
          AP_TERM_TAC
        ) then_tac \
        MATCH_ACCEPT_TAC(REAL_MUL_SYM)
      )
    ]
  )

def REAL_ADD_RDISTRIB:
  prove(
    [
      (hol:
         forall (x :: real, y :: real, z :: real): (x + y) * z == x * z + y * z),
      MESON_TAC(PairList [REAL_MUL_SYM, REAL_ADD_LDISTRIB])
    ]
  )

def REAL_LT_LADD_IMP:
  prove(
    [
      (hol:
         forall (x :: real, y :: real, z :: real): y < z ==> x + y < x + z),
      (
        (
          (
            (
              (REPEAT(GEN_TAC) then_tac CONV_TAC(CONTRAPOS_CONV)) then_tac \
              REWRITE_TAC(PairList [real_lt])
            ) then_tac \
            DISCH_THEN(o(MP_TAC)(MATCH_MP(REAL_LE_LADD_IMP)))
          ) then_tac \
          DISCH_THEN(
            o(MP_TAC)(SPEC(hol:
                             var x :: real
                             -x))
          )
        ) then_tac \
        REWRITE_TAC(PairList [REAL_ADD_ASSOC, REAL_ADD_LINV, REAL_ADD_LID])
      )
    ]
  )

def REAL_LT_MUL:
  prove(
    [
      (hol:
         forall (x :: real, y :: real): (0 :: real) < x && (0 :: real) < y ==> (0 :: real) < x * y),
      (
        (
          (
            (
              (
                (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [REAL_LT_LE])) then_tac \
                CONV_TAC(ONCE_DEPTH_CONV(SYM_CONV))
              ) then_tac \
              STRIP_TAC
            ) then_tac \
            ASM_REWRITE_TAC(PairList [REAL_ENTIRE])
          ) then_tac \
          MATCH_MP_TAC(REAL_LE_MUL)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def REAL_ARITH_TAC = CONV_TAC(REAL_ARITH)

def REAL_EQ_ADD_LCANCEL_0:
  prove(
    [
      (hol:
