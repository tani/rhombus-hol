                      ) then_tac \
                      ASM_CASES_TAC(
                        (hol:
                           var x :: real
                           const real_abs :: real -> real
                           real_abs(x) == (1 :: real))
                      )
                    ) then_list \
                    PairList [ALL_TAC, ASM_MESON_TAC(PairList [REAL_POW_EQ_1_IMP])]
