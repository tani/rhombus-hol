def REAL_OF_NUM_SUC:
  prove(
    [
      Host.hol_term(Forall(
        "n",
        Num,
        Eq(
          Real,
          App(
            Const("real_add", Fun(Real, Fun(Real, Real))),
            [
              App(Const("real_of_num", Fun(Num, Real)), [Ref("n")]),
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
              )
            ]
          ),
          App(Const("real_of_num", Fun(Num, Real)), [App(Const("SUC", Fun(Num, Num)), [Ref("n")])])
        )
      )),
      REWRITE_TAC(PairList [ADD1, REAL_OF_NUM_ADD])
    ]
  )

def REAL_OF_NUM_SUB:
  prove(
    [
      Host.hol_term(Forall(
        "m",
        Num,
        Forall(
          "n",
          Num,
          Implies(
            App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")]),
            Eq(
              Real,
              App(
                Const("real_sub", Fun(Real, Fun(Real, Real))),
                [
                  App(Const("real_of_num", Fun(Num, Real)), [Ref("n")]),
                  App(Const("real_of_num", Fun(Num, Real)), [Ref("m")])
                ]
              ),
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("-", Fun(Num, Fun(Num, Num))), [Ref("n"), Ref("m")])]
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [LE_EXISTS])) then_tac \
                  STRIP_TAC
                ) then_tac \
                ASM_REWRITE_TAC(PairList [ADD_SUB2])
              ) then_tac \
              REWRITE_TAC(PairList [GSYM(REAL_OF_NUM_ADD)])
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [REAL_ADD_SYM])
          ) then_tac \
          REWRITE_TAC(PairList [real_sub, GSYM(REAL_ADD_ASSOC)])
        ) then_tac \
