def SQRT_MONO_LT:
  prove(
    [
      (hol:
         const sqrt :: real -> real
         forall (x :: real, y :: real): x < y ==> sqrt(x) < sqrt(y)),
      (
        SUBGOAL_THEN(
          (hol:
             const sqrt :: real -> real
             forall (x :: real, y :: real): (0 :: real) <= x && x < y ==> sqrt(x) < sqrt(y))
        )(ASSUME_TAC) then_list \
        PairList [
          (
            (
              (
                (
                  (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_POW_LT2_REV)) then_tac \
                  EXISTS_TAC(
                    (hol:
                       (2 :: num))
                  )
                ) then_tac \
                ASM_REWRITE_TAC(PairList [SQRT_WORKS_GEN, SQRT_LE_0])
              ) then_tac \
              REPEAT(POP_ASSUM(MP_TAC))
            ) then_tac \
            REAL_ARITH_TAC
          ),
          (
            (
              (
                (
                  REPEAT(STRIP_TAC) then_tac \
                  ASM_CASES_TAC(
                    (hol:
                       var x :: real
                       (0 :: real) <= x)
                  )
                ) then_tac \
                ASM_SIMP_TAC(PairList [])
              ) then_tac \
              ASM_CASES_TAC(
                (hol:
                   var y :: real
                   (0 :: real) <= y)
              )
            ) then_list \
            PairList [
              (
                (
                  MATCH_MP_TAC(REAL_LTE_TRANS) then_tac \
                  EXISTS_TAC(
                    (hol:
                       (0 :: real))
                  )
                ) then_tac \
                ASM_REWRITE_TAC(PairList [GSYM(REAL_NOT_LE), SQRT_LE_0])
              ),
              (
                (
                  (
                    FIRST_X_ASSUM(
                      o(MP_TAC)(
                        SPECL(
                          PairList [
                            (hol:
                               var y :: real
                               -y),
                            (hol:
                               var x :: real
                               -x)
                          ]
                        )
                      )
                    ) then_tac \
                    REWRITE_TAC(PairList [SQRT_NEG])
                  ) then_tac \
                  REPEAT(POP_ASSUM(MP_TAC))
                ) then_tac \
                REAL_ARITH_TAC
              )
            ]
          )
        ]
      )
    ]
  )

