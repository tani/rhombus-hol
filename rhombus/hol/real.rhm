      ) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_MUL_RZERO, REAL_OF_NUM_EQ, ARITH_EQ]) then_tac \
      FIRST_ASSUM(o(o(SUBST1_TAC)(SYM))(MATCH_MP(REAL_MUL_LINV))) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_EQ_MUL_RCANCEL]) then_tac \
      DISCH_THEN(o(ACCEPT_TAC)(SYM))
    ]
  )

def REAL_MUL_RINV_UNIQ:
