def REAL_ARCH_POW_INV:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Implies(
            And(
              App(
                Const("real_lt", Fun(Real, Fun(Real, Bool))),
                [
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  ),
                  Ref("y")
                ]
              ),
              App(
                Const("real_lt", Fun(Real, Fun(Real, Bool))),
                [
                  Ref("x"),
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                  )
                ]
              )
            ),
            Exists(
              "n",
              Num,
              App(
                Const("real_lt", Fun(Real, Fun(Real, Bool))),
                [App(Const("real_pow", Fun(Real, Fun(Num, Real))), [Ref("x"), Ref("n")]), Ref("y")]
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(STRIP_TAC) then_tac \
                          ASM_CASES_TAC(
                            Host.hol_term(App(
                              Const("real_lt", Fun(Real, Fun(Real, Bool))),
                              [
                                App(
                                  Const("real_of_num", Fun(Num, Real)),
                                  [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                                ),
                                Var("x", Real)
                              ]
                            ))
                          )
                        ) then_list \
                        PairList [
                          ALL_TAC,
                          ASM_MESON_TAC(PairList [REAL_POW_1, REAL_LET_TRANS, REAL_NOT_LT])
                        ]
                      ) then_tac \
                      SUBGOAL_THEN(
                        Host.hol_term(App(
                          Const("real_lt", Fun(Real, Fun(Real, Bool))),
                          [
                            App(
                              Const("real_inv", Fun(Real, Real)),
                              [
                                App(
                                  Const("real_of_num", Fun(Num, Real)),
                                  [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                                )
                              ]
                            ),
                            App(Const("real_inv", Fun(Real, Real)), [Var("x", Real)])
                          ]
                        ))
                      )(MP_TAC)
                    ) then_list \
                    PairList [ASM_SIMP_TAC(PairList [REAL_LT_INV2]), REWRITE_TAC(PairList [REAL_INV_1])]
                  ) then_tac \
                  DISCH_THEN(
                    o(
                      o(MP_TAC)(SPEC(Host.hol_term(App(Const("real_inv", Fun(Real, Real)), [Var("y", Real)]))))
                    )(MATCH_MP(REAL_ARCH_POW))
                  )
                ) then_tac \
                MATCH_MP_TAC(MONO_EXISTS)
              ) then_tac \
              GEN_TAC
            ) then_tac \
            DISCH_TAC
          ) then_tac \
          GEN_REWRITE_TAC(BINOP_CONV)(PairList [GSYM(REAL_INV_INV)])
        ) then_tac \
        ASM_SIMP_TAC(PairList [GSYM(REAL_POW_INV), REAL_LT_INV, REAL_LT_INV2])
      )
    ]
  )

