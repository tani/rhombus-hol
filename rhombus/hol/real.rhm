                              ) then_tac \
                              ASM_CASES_TAC(
                                (hol:
                                   var x :: real
                                   (0 :: real) <= x)
                              )
                            ) then_list \
                            PairList [
                              (
                                (
                                  (
                                    (
                                      TRANS_TAC(REAL_LE_TRANS)(
                                        (hol:
                                           var x :: real
                                           var y :: real
                                           const sqrt :: real -> real
                                           const real_abs :: real -> real
                                           sqrt(real_abs(x - y)))
                                      ) then_tac \
