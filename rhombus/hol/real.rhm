def REAL_LT_MUL_EQ:
  prove(
    [
      @hol|{(!x y. &0 < x ==> (&0 < x * y <=> &0 < y)) /\
         (!x y. &0 < y ==> (&0 < x * y <=> &0 < x))}|,
      MESON_TAC(PairList [REAL_LT_LMUL_EQ, REAL_LT_RMUL_EQ, REAL_MUL_LZERO, REAL_MUL_RZERO])
    ]
  )

def REAL_MUL_POS_LT:
  prove(
    [
      @hol|{!x y. &0 < x * y <=> &0 < x /\ &0 < y \/ x < &0 /\ y < &0}|,
      REPEAT(STRIP_TAC) then_tac \
      STRIP_ASSUME_TAC(SPEC(@hol|{x:real}|)(REAL_LT_NEGTOTAL)) then_tac \
      STRIP_ASSUME_TAC(SPEC(@hol|{y:real}|)(REAL_LT_NEGTOTAL)) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_MUL_LZERO, REAL_MUL_RZERO, REAL_LT_REFL]) then_tac \
      ASSUM_LIST(o(o(MP_TAC)(MATCH_MP(REAL_LT_MUL)))(end_itlist(CONJ))) then_tac \
      REPEAT(POP_ASSUM(MP_TAC)) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_MUL_POS_LE:
  prove(
    [
      @hol|{!x y. &0 <= x * y <=>
         x = &0 \/ y = &0 \/ &0 < x /\ &0 < y \/ x < &0 /\ y < &0}|,
      REWRITE_TAC(
        PairList [
          REAL_ARITH(
            @hol|{&0 <= x <=> x = &0 \/ &0 < x}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REAL_MUL_POS_LT, REAL_ENTIRE]) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_LE_RDIV_EQ:
  prove(
    [
      @hol|{!x y z. &0 < z ==> (x <= y / z <=> x * z <= y)}|,
      REPEAT(STRIP_TAC) then_tac \
      FIRST_ASSUM(
        (fun(th): GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(MATCH_MP(REAL_LE_RMUL_EQ)(th))]))
      ) then_tac \
      ASM_SIMP_TAC(
        PairList [
          real_div,
          GSYM(REAL_MUL_ASSOC),
          REAL_MUL_LINV,
          REAL_MUL_RID,
          REAL_LT_IMP_NZ
        ]
      )
    ]
  )

def REAL_LE_LDIV_EQ:
  prove(
    [
      @hol|{!x y z. &0 < z ==> (x / z <= y <=> x <= y * z)}|,
      REPEAT(STRIP_TAC) then_tac \
      FIRST_ASSUM(
        (fun(th): GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(MATCH_MP(REAL_LE_RMUL_EQ)(th))]))
      ) then_tac \
      ASM_SIMP_TAC(
        PairList [
          real_div,
          GSYM(REAL_MUL_ASSOC),
          REAL_MUL_LINV,
          REAL_MUL_RID,
          REAL_LT_IMP_NZ
        ]
      )
    ]
  )

def REAL_LT_RDIV_EQ:
  prove(
    [
      @hol|{!x y z. &0 < z ==> (x < y / z <=> x * z < y)}|,
      SIMP_TAC(PairList [GSYM(REAL_NOT_LE), REAL_LE_LDIV_EQ])
    ]
  )

def REAL_LT_LDIV_EQ:
  prove(
    [
      @hol|{!x y z. &0 < z ==> (x / z < y <=> x < y * z)}|,
      SIMP_TAC(PairList [GSYM(REAL_NOT_LE), REAL_LE_RDIV_EQ])
    ]
  )

def REAL_EQ_RDIV_EQ:
  prove(
    [
      @hol|{!x y z. &0 < z ==> ((x = y / z) <=> (x * z = y))}|,
      REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM)]) then_tac \
      SIMP_TAC(PairList [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ])
    ]
  )

def REAL_EQ_LDIV_EQ:
  prove(
    [
      @hol|{!x y z. &0 < z ==> ((x / z = y) <=> (x = y * z))}|,
      REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM)]) then_tac \
      SIMP_TAC(PairList [REAL_LE_RDIV_EQ, REAL_LE_LDIV_EQ])
    ]
  )

def REAL_LT_DIV2_EQ:
  prove(
    [
      @hol|{!x y z. &0 < z ==> (x / z < y / z <=> x < y)}|,
      SIMP_TAC(PairList [real_div, REAL_LT_RMUL_EQ, REAL_LT_INV_EQ])
    ]
  )

def REAL_LE_DIV2_EQ:
  prove(
    [
      @hol|{!x y z. &0 < z ==> (x / z <= y / z <=> x <= y)}|,
      SIMP_TAC(PairList [real_div, REAL_LE_RMUL_EQ, REAL_LT_INV_EQ])
    ]
  )

def REAL_MUL_2:
  prove(
    [
      @hol|{!x. &2 * x = x + x}|,
      REAL_ARITH_TAC
    ]
  )

def REAL_POW_EQ_0:
  prove(
    [
      @hol|{!x n. (x pow n = &0) <=> (x = &0) /\ ~(n = 0)}|,
      GEN_TAC then_tac INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [NOT_SUC, real_pow, REAL_ENTIRE]) then_list \
      PairList [REAL_ARITH_TAC, CONV_TAC(TAUT)]
    ]
  )

def REAL_LE_MUL2:
  prove(
    [
      @hol|{!w x y z. &0 <= w /\ w <= x /\ &0 <= y /\ y <= z
         ==> w * y <= x * z}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{w * z}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [MATCH_MP_TAC(REAL_LE_LMUL), MATCH_MP_TAC(REAL_LE_RMUL)] then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      MATCH_MP_TAC(REAL_LE_TRANS) then_tac \
      EXISTS_TAC(@hol|{y:real}|) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def REAL_LT_MUL2:
  prove(
    [
      @hol|{!w x y z. &0 <= w /\ w < x /\ &0 <= y /\ y < z
         ==> w * y < x * z}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LET_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{w * z}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [MATCH_MP_TAC(REAL_LE_LMUL), MATCH_MP_TAC(REAL_LT_RMUL)] then_tac \
      ASM_REWRITE_TAC(PairList []) then_list \
      PairList [
        MATCH_MP_TAC(REAL_LT_IMP_LE) then_tac ASM_REWRITE_TAC(PairList []),
        MATCH_MP_TAC(REAL_LET_TRANS) then_tac \
        EXISTS_TAC(@hol|{y:real}|) then_tac \
        ASM_REWRITE_TAC(PairList [])
      ]
    ]
  )

def REAL_LT_SQUARE:
  prove(
    [
      @hol|{!x. (&0 < x * x) <=> ~(x = &0)}|,
      GEN_TAC then_tac \
      REWRITE_TAC(PairList [REAL_LT_LE, REAL_LE_SQUARE]) then_tac \
      GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [EQ_SYM_EQ]) then_tac \
      REWRITE_TAC(PairList [REAL_ENTIRE])
    ]
  )

def REAL_POW_1:
  prove(
    [
      @hol|{!x. x pow 1 = x}|,
      REWRITE_TAC(
        PairList [
          num_CONV(
            @hol|{1}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [real_pow, REAL_MUL_RID])
    ]
  )

def REAL_POW_ONE:
  prove(
    [
      @hol|{!n. &1 pow n = &1}|,
      INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [real_pow, REAL_MUL_LID])
    ]
  )

def REAL_LT_INV2:
  prove(
    [
      @hol|{!x y. &0 < x /\ x < y ==> inv(y) < inv(x)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LT_RCANCEL_IMP) then_tac \
      EXISTS_TAC(
        @hol|{x * y}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(REAL_LT_MUL) then_tac \
        POP_ASSUM_LIST(o(MP_TAC)(end_itlist(CONJ))) then_tac \
        REAL_ARITH_TAC,
        SUBGOAL_THEN(
          @hol|{(inv x * x = &1) /\ (inv y * y = &1)}|
        )(ASSUME_TAC) then_list \
        PairList [
          CONJ_TAC then_tac MATCH_MP_TAC(REAL_MUL_LINV) then_tac \
          POP_ASSUM_LIST(o(MP_TAC)(end_itlist(CONJ))) then_tac \
          REAL_ARITH_TAC,
          ASM_REWRITE_TAC(PairList [REAL_MUL_ASSOC, REAL_MUL_LID]) then_tac \
          GEN_REWRITE_TAC(o(LAND_CONV)(LAND_CONV))(PairList [REAL_MUL_SYM]) then_tac \
          ASM_REWRITE_TAC(PairList [GSYM(REAL_MUL_ASSOC), REAL_MUL_RID])
        ]
      ]
    ]
  )

def REAL_LE_INV2:
  prove(
    [
      @hol|{!x y. &0 < x /\ x <= y ==> inv(y) <= inv(x)}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [REAL_LE_LT]) then_tac \
      ASM_CASES_TAC(@hol|{x:real = y}|) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      STRIP_TAC then_tac \
      DISJ1_TAC then_tac \
      MATCH_MP_TAC(REAL_LT_INV2) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def REAL_LT_LINV:
  prove(
    [
      @hol|{!x y. &0 < y /\ inv y < x ==> inv x < y}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(SPEC(@hol|{y:real}|)(REAL_LT_INV)) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_TAC then_tac \
      MP_TAC(
        SPECL(
          PairList [
            @hol|{(inv y:real)}|,
            @hol|{x:real}|
          ])(
          REAL_LT_INV2
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_INV_INV])
    ]
  )

def REAL_LT_RINV:
  prove(
    [
      @hol|{!x y. &0 < x /\ x < inv y ==> y < inv x}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(SPEC(@hol|{x:real}|)(REAL_LT_INV)) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_TAC then_tac \
      MP_TAC(
        SPECL(
          PairList [
            @hol|{x:real}|,
            @hol|{inv y:real}|
          ])(
          REAL_LT_INV2
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_INV_INV])
    ]
  )

def REAL_LE_LINV:
  prove(
    [
      @hol|{!x y. &0 < y /\ inv y <= x ==> inv x <= y}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(SPEC(@hol|{y:real}|)(REAL_LT_INV)) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_TAC then_tac \
      MP_TAC(
        SPECL(
          PairList [
            @hol|{(inv y:real)}|,
            @hol|{x:real}|
          ])(
          REAL_LE_INV2
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_INV_INV])
    ]
  )

def REAL_LE_RINV:
  prove(
    [
      @hol|{!x y. &0 < x /\ x <= inv y ==> y <= inv x}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(SPEC(@hol|{x:real}|)(REAL_LT_INV)) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_TAC then_tac \
      MP_TAC(
        SPECL(
          PairList [
            @hol|{x:real}|,
            @hol|{inv y:real}|
          ])(
          REAL_LE_INV2
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_INV_INV])
    ]
  )

def REAL_INV_LE_1:
  prove(
    [
      @hol|{!x. &1 <= x ==> inv(x) <= &1}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_INV_1)]) then_tac \
      MATCH_MP_TAC(REAL_LE_INV2) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_LT_01])
    ]
  )

def REAL_INV_1_LE:
  prove(
    [
      @hol|{!x. &0 < x /\ x <= &1 ==> &1 <= inv(x)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_INV_1)]) then_tac \
      MATCH_MP_TAC(REAL_LE_INV2) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_LT_01])
    ]
  )

def REAL_INV_LT_1:
  prove(
    [
      @hol|{!x. &1 < x ==> inv(x) < &1}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_INV_1)]) then_tac \
      MATCH_MP_TAC(REAL_LT_INV2) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_LT_01])
    ]
  )

def REAL_INV_1_LT:
  prove(
    [
      @hol|{!x. &0 < x /\ x < &1 ==> &1 < inv(x)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_INV_1)]) then_tac \
      MATCH_MP_TAC(REAL_LT_INV2) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_LT_01])
    ]
  )

def REAL_SUB_INV:
  prove(
    [
      @hol|{!x y. ~(x = &0) /\ ~(y = &0) ==> (inv(x) - inv(y) = (y - x) / (x * y))}|,
      REWRITE_TAC(PairList [real_div, REAL_SUB_RDISTRIB, REAL_INV_MUL]) then_tac \
      SIMP_TAC(PairList [REAL_MUL_ASSOC, REAL_MUL_RINV, REAL_MUL_LID]) then_tac \
      REWRITE_TAC(PairList [GSYM(REAL_MUL_ASSOC)]) then_tac \
      REWRITE_TAC(PairList [GSYM(real_div)]) then_tac \
      SIMP_TAC(PairList [REAL_DIV_LMUL])
    ]
  )

def REAL_DOWN:
  prove(
    [
      @hol|{!d. &0 < d ==> ?e. &0 < e /\ e < d}|,
      GEN_TAC then_tac DISCH_TAC then_tac \
      EXISTS_TAC(
        @hol|{d / &2}|
      ) then_tac \
      ASSUME_TAC(
        REAL_ARITH(
          @hol|{&0 < &2}|
        )
      ) then_tac \
      ASSUME_TAC(
        MATCH_MP(REAL_MUL_LINV)(
          REAL_ARITH(
            @hol|{~(&2 = &0)}|
          )
        )
      ) then_tac \
      CONJ_TAC then_tac \
      MATCH_MP_TAC(REAL_LT_RCANCEL_IMP) then_tac \
      EXISTS_TAC(
        @hol|{&2}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [real_div, GSYM(REAL_MUL_ASSOC), REAL_MUL_RID]) then_tac \
      UNDISCH_TAC(
        @hol|{&0 < d}|
      ) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_DOWN2:
  prove(
    [
      @hol|{!d1 d2. &0 < d1 /\ &0 < d2 ==> ?e. &0 < e /\ e < d1 /\ e < d2}|,
      REPEAT(GEN_TAC) then_tac STRIP_TAC then_tac \
      DISJ_CASES_TAC(
        SPECL(
          PairList [@hol|{d1:real}|, @hol|{d2:real}|])(
          REAL_LE_TOTAL
        )
      ) then_list \
      PairList [
        MP_TAC(SPEC(@hol|{d1:real}|)(REAL_DOWN)),
        MP_TAC(SPEC(@hol|{d2:real}|)(REAL_DOWN))
      ] then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{e:real}|)(STRIP_ASSUME_TAC)) then_tac \
      EXISTS_TAC(@hol|{e:real}|) then_tac \
      POP_ASSUM_LIST(o(MP_TAC)(end_itlist(CONJ))) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_POW_LE2:
  prove(
    [
      @hol|{!n x y. &0 <= x /\ x <= y ==> x pow n <= y pow n}|,
      INDUCT_TAC then_tac REWRITE_TAC(PairList [real_pow, REAL_LE_REFL]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(REAL_LE_MUL2) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(REAL_POW_LE) then_tac ASM_REWRITE_TAC(PairList []),
        FIRST_ASSUM(MATCH_MP_TAC) then_tac ASM_REWRITE_TAC(PairList [])
      ]
    ]
  )

def REAL_POW_LE_1:
  prove(
    [
