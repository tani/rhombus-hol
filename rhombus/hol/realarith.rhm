            App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Ref("y"), Ref("x")])
          )
        )
      )),
      (REWRITE_TAC(PairList [real_lt]) then_tac CONV_TAC(TAUT))
    ]
  )

