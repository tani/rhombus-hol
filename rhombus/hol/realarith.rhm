      itlist(uncurry(net_of_conv))(
        PairList [
          [xy_lt_2, (fun(t): [REAL_LT_CONV_2(t), REAL_NOT_LT_CONV_2(t)])],
          [xy_le_2, (fun(t): [REAL_LE_CONV_2(t), REAL_NOT_LE_CONV_2(t)])],
          [xy_gt_2, (fun(t): [REAL_GT_CONV_2(t), REAL_NOT_GT_CONV_2(t)])],
          [xy_ge_2, (fun(t): [REAL_GE_CONV_2(t), REAL_NOT_GE_CONV_2(t)])],
          [xy_eq_2, (fun(t): [REAL_EQ_CONV_2(t), REAL_NOT_EQ_CONV_2(t)])]
        ]
      )(empty_net)
    let REAL_INEQ_NORM_CONV_2 = REWRITES_CONV(net_single_2)
    let REAL_INEQ_NORM_DCONV_2 = REWRITES_CONV(net_double_2)
    let NNF_NORM_CONV = GEN_NNF_CONV(#false)([REAL_INEQ_NORM_CONV_2, REAL_INEQ_NORM_DCONV_2])
    let rules = MATCH_MP_RULE_2(pth_mul_2)
    let MUL_RULE_2 = (fun(th): CONV_RULE(LAND_CONV(POLY_MUL_CONV))(rules(th)))
    let rules = MATCH_MP_RULE_2(pth_add_2)
    let ADD_RULE_2 = (fun(th): CONV_RULE(LAND_CONV(POLY_ADD_CONV))(rules(th)))
    let rule = MATCH_MP(pth_emul_2)
    let EMUL_RULE_2 = fun(tm): fun(th): CONV_RULE(LAND_CONV(POLY_MUL_CONV))(SPEC(tm)(rule(th)))
    let SQUARE_RULE_2 = (fun(t): CONV_RULE(LAND_CONV(POLY_MUL_CONV))(SPEC(t)(pth_square_2)))
    let hol_of_positivstellensatz:
      fun([eqs, les, lts]):
        fun translate(prf):
          match prf
          | Axiom_eq(n): el(n)(eqs)
          | Axiom_le(n): el(n)(les)
          | Axiom_lt(n): el(n)(lts)
          | Rational_eq(x): EQT_ELIM(NUMERIC_EQ_CONV(mk_comb([mk_comb([eq_tm_2, mk_numeric(x)]), z_tm_2])))
          | Rational_le(x): EQT_ELIM(NUMERIC_GE_CONV(mk_comb([mk_comb([ge_tm_2, mk_numeric(x)]), z_tm_2])))
          | Rational_lt(x): EQT_ELIM(NUMERIC_GT_CONV(mk_comb([mk_comb([gt_tm_2, mk_numeric(x)]), z_tm_2])))
          | Square(t): SQUARE_RULE_2(t)
          | Eqmul(t,p): EMUL_RULE_2(t)(translate(p))
          | Sum(p1,p2): ADD_RULE_2(CONJ(translate(p1))(translate(p2)))
          | Product(p1,p2): MUL_RULE_2(CONJ(translate(p1))(translate(p2)))
        (fun(prf): CONV_RULE(FIRST_CONV(PairList [NUMERIC_GE_CONV, NUMERIC_GT_CONV, NUMERIC_EQ_CONV]))(translate(prf)))
    let init_conv:
      (
        (
          (
            (
              (
                ((TOP_DEPTH_CONV(BETA_CONV) then_conv PRESIMP_CONV) then_conv NNF_CONV) then_conv \
                DEPTH_BINOP_CONV(or_tm_2)(CONDS_ELIM_CONV)
              ) then_conv \
              NNF_NORM_CONV
            ) then_conv \
            SKOLEM_CONV
          ) then_conv \
          PRENEX_CONV
        ) then_conv \
        WEAK_DNF_CONV
      )
    // Recursive proof splitting needs the local definition before its first use.
    fun overall(dun):
      fun(ths):
        match ths
        | PairList []:
            let [eq, ne] = partition(o(is_req_2)(concl))(dun)
            let [le, nl] = partition(o(is_ge_2)(concl))(ne)
            let lt = filter(o(is_gt_2)(concl))(nl)
            prover(hol_of_positivstellensatz)([eq, le, lt])
        | PairList [th, & oths]:
            let tm = concl(th)
            if is_conj(tm)
            | let [th1, th2] = CONJ_PAIR(th)
              overall(dun)(PairList [th1, th2, & oths])
            | if is_disj(tm)
              | let th1_2 = overall(dun)(PairList [ASSUME(lhand(tm)), & oths])
                let th2_2 = overall(dun)(PairList [ASSUME(rand(tm)), & oths])
                DISJ_CASES(th)(th1_2)(th2_2)
              | overall(PairList [th, & dun])(oths)
    fun(tm):
      let NNF_NORM_CONV_prime = GEN_NNF_CONV(#false)([CACHE_CONV(REAL_INEQ_NORM_CONV_2), (fun(t): failwith(""))])
      fun absremover(t):
        (
          TOP_DEPTH_CONV((absconv1 then_conv BINOP_CONV(LAND_CONV(POLY_CONV)))) then_conv \
          TRY_CONV(((absconv2 then_conv NNF_NORM_CONV_prime) then_conv BINOP_CONV(absremover)))
        )(t)
      let th0 = init_conv(mk_neg(tm))
      let tm0 = rand(concl(th0))
      let th:
        if (tm0 == false_tm_2)
        | fst(EQ_IMP_RULE(th0))
        | let [evs, bod] = strip_exists(tm0)
          let [avs, ibod] = strip_forall(bod)
          let th1 = itlist(MK_FORALL)(avs)(DEPTH_BINOP_CONV(or_tm_2)(absremover)(ibod))
          let th2 = overall(PairList [])(PairList [SPECL(avs)(ASSUME(rand(concl(th1))))])
          let th3 = itlist(SIMPLE_CHOOSE)(evs)(PROVE_HYP(EQ_MP(th1)(ASSUME(bod)))(th2))
          DISCH_ALL(PROVE_HYP(EQ_MP(th0)(ASSUME(mk_neg(tm))))(th3))
      MP(INST(PairList [[tm, p_tm_2]])(pth_final_2))(th)

def REAL_LINEAR_PROVER:
  let linear_add_2 = combine((fun (x): fun (y): x + y))((fun(z): (z == num_0)))
  let linear_cmul_2 = (fun(c): mapf((fun(x): (c * x))))
  let one_tm_2:
    Host.hol_term(App(
      Const("real_of_num", Fun(Num, Real)),
      [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
    ))
  let contradictory = fun(p): fun([e, _]): ((is_undefined(e) && !p(num_0)) || ((dom(e) == (PairList [one_tm_2])) && !p(apply(e)(one_tm_2))))
  // Recursive elimination needs the local definition before its first use.
  fun linear_ineqs(vars):
    fun([les, lts]):
      try:
        find(contradictory((fun(x): (x > num_0))))(lts)
        ~catch exn:
          match exn
          | Failure(_):
              try:
                find(contradictory((fun(x): (x >= num_0))))(les)
                ~catch exn:
                  match exn
                  | Failure(_):
                      if (vars == (PairList []))
                      | failwith("linear_ineqs: no contradiction")
                      | let ineqs = append(les)(lts)
                        let blowup:
                          fun(v):
                            (length(filter((fun([e, _]): (tryapplyd(e)(v)(num_0) > num_0)))(ineqs)) * length(filter((fun([e, _]): (tryapplyd(e)(v)(num_0) < num_0)))(ineqs)))
                        let v = fst(hd(sort(fun([_, i]): fun([_, j]): (i < j))(map((fun(v): [v, blowup(v)]))(vars))))
                        let addup:
                          fun([e1, p1]):
                            fun([e2, p2]):
                              fun(acc):
                                let c1_2 = tryapplyd(e1)(v)(num_0)
                                let c2_2 = tryapplyd(e2)(v)(num_0)
                                if ((c1_2 * c2_2) >= num_0)
                                | acc
                                | let e1_prime_2 = linear_cmul_2(Host.abs_num(c2_2))(e1)
                                  let e2_prime_2 = linear_cmul_2(Host.abs_num(c1_2))(e2)
                                  let p1_prime_2 = Product(Rational_lt(Host.abs_num(c2_2)), p1)
                                  let p2_prime_2 = Product(Rational_lt(Host.abs_num(c1_2)), p2)
                                  PairList [[linear_add_2(e1_prime_2)(e2_prime_2), Sum(p1_prime_2, p2_prime_2)], & acc]
                        let [les0_2, les1_2] = partition((fun([e, _]): (tryapplyd(e)(v)(num_0) == num_0)))(les)
                        let [lts0_2, lts1_2] = partition((fun([e, _]): (tryapplyd(e)(v)(num_0) == num_0)))(lts)
                        let [lesp_2, lesn_2] = partition((fun([e, _]): (tryapplyd(e)(v)(num_0) > num_0)))(les1_2)
                        let [ltsp_2, ltsn_2] = partition((fun([e, _]): (tryapplyd(e)(v)(num_0) > num_0)))(lts1_2)
                        let les_prime_2 = itlist((fun(ep1): itlist(addup(ep1))(lesp_2)))(lesn_2)(les0_2)
                        let lts_prime_2 = itlist((fun(ep1): itlist(addup(ep1))(append(lesp_2)(ltsp_2))))(ltsn_2)(itlist((fun(ep1): itlist(addup(ep1))(append(lesn_2)(ltsn_2))))(ltsp_2)(lts0_2))
                        linear_ineqs(subtract(vars)(PairList [v]))([les_prime_2, lts_prime_2])
                  | exn: (throw exn)
          | exn: (throw exn)
  fun linear_eqs([eqs, les, lts]):
    try:
      find(contradictory((fun(x): (x == num_0))))(eqs)
      ~catch exn:
        match exn
        | Failure(_):
            match eqs
            | PairList []:
                let vars = subtract(itlist(o(o(union)(dom))(fst))(append(les)(lts))(PairList []))(PairList [one_tm_2])
                linear_ineqs(vars)([les, lts])
            | PairList [[e, p], & es]:
                if is_undefined(e)
                | linear_eqs([es, les, lts])
                | let [x, c] = choose(undefine(one_tm_2)(e))
                  let xform:
                    fun([t, q] as inp):
                      let d = tryapplyd(t)(x)(num_0)
                      if (d == num_0)
                      | inp
                      | let k = Host.hol_rat_div((Host.minus_num(d) * Host.abs_num(c)))(c)
                        let e_prime_2 = linear_cmul_2(k)(e)
                        let t_prime_2 = linear_cmul_2(Host.abs_num(c))(t)
                        let p_prime_2 = Eqmul(term_of_rat(k), p)
                        let q_prime_2 = Product(Rational_lt(Host.abs_num(c)), q)
                        [linear_add_2(e_prime_2)(t_prime_2), Sum(p_prime_2, q_prime_2)]
                  linear_eqs([map(xform)(es), map(xform)(les), map(xform)(lts)])
        | exn: (throw exn)
  let linear_prover:
    fun([eq, le, lt]):
      let eqs_2 = map2(fun(p): fun(n): [p, Axiom_eq(n)])(eq)(Host.hol_range(0)((length(eq) - 1)))
      let les_2 = map2(fun(p): fun(n): [p, Axiom_le(n)])(le)(Host.hol_range(0)((length(le) - 1)))
      let lts_2 = map2(fun(p): fun(n): [p, Axiom_lt(n)])(lt)(Host.hol_range(0)((length(lt) - 1)))
      linear_eqs([eqs_2, les_2, lts_2])
  let one_tm_3:
    Host.hol_term(App(
      Const("real_of_num", Fun(Num, Real)),
      [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
    ))
  let zero_tm_2:
    Host.hol_term(App(
      Const("real_of_num", Fun(Num, Real)),
      [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
    ))
  let add_tm_2 = Host.hol_term(Const("real_add", Fun(Real, Fun(Real, Real))))
  let mul_tm_2 = Host.hol_term(Const("real_mul", Fun(Real, Fun(Real, Real))))
  fun lin_of_hol_2(tm):
    if (tm == zero_tm_2)
    | undefined
    | if !is_comb(tm)
      | fpf_singleton(tm)(Host.num(1))
      | if is_ratconst(tm)
        | fpf_singleton(one_tm_3)(rat_of_term(tm))
        | let [lop, r] = dest_comb(tm)
          if !is_comb(lop)
          | fpf_singleton(tm)(Host.num(1))
          | let [op, l] = dest_comb(lop)
            if (op == add_tm_2)
            | linear_add_2(lin_of_hol_2(l))(lin_of_hol_2(r))
            | (if ((op == mul_tm_2) && is_ratconst(l)) | fpf_singleton(r)(rat_of_term(l)) | fpf_singleton(tm)(Host.num(1)))
  let lin_of_hol = lin_of_hol_2
  let is_alien:
    fun(tm):
      match tm
      | Comb(Const("real_of_num",_),n):
          if !is_numeral(n)
          | #true
          | match tm
            | _: #false
      | _: #false
  let is_suc_alien:
    fun(tm):
      match tm
      | Comb(Const("real_of_num",_),Comb(Const("SUC",_),_)): #true
      | _: #false
  let dest_suc_alien:
    fun(tm):
      match tm
      | Comb(Const("real_of_num",_),Comb(Const("SUC",_),n)): n
      | _: failwith("")
  let n_tm = Host.hol_term(Var("n", Num))
  let pth = REWRITE_RULE(PairList [GSYM(real_ge)])(SPEC(n_tm)(REAL_POS))
  let pth_suc = REWRITE_RULE(PairList [GSYM(real_gt)])(SPEC(n_tm)(REAL_POS_LT))
  fun(translator):
    fun([eq, le, lt]):
      let eq_pols_2 = map(o(o(lin_of_hol)(lhand))(concl))(eq)
      let le_pols_2 = map(o(o(lin_of_hol)(lhand))(concl))(le)
      let lt_pols_2 = map(o(o(lin_of_hol)(lhand))(concl))(lt)
      let all_aliens = filter(is_alien)(itlist(o(union)(dom))(append(eq_pols_2)(append(le_pols_2)(lt_pols_2)))(PairList []))
      let [suc_aliens, aliens] = partition(is_suc_alien)(all_aliens)
      let le_pols_prime = append(le_pols_2)(map((fun(v): fpf_singleton(v)(Host.num(1))))(aliens))
      let lt_pols_prime = append(lt_pols_2)(map((fun(v): fpf_singleton(v)(Host.num(1))))(suc_aliens))
      let [_, proof] = linear_prover([eq_pols_2, le_pols_prime, lt_pols_prime])
      let le_prime = append(le)(map((fun(a): INST(PairList [[rand(a), n_tm]])(pth)))(aliens))
      let lt_prime = append(lt)(map((fun(a): INST(PairList [[dest_suc_alien(a), n_tm]])(pth_suc)))(suc_aliens))
      translator([eq, le_prime, lt_prime])(proof)

def realarith_REAL_ARITH:
  let [REAL_POLY_NEG_CONV, REAL_POLY_ADD_CONV, REAL_POLY_SUB_CONV, REAL_POLY_MUL_CONV, REAL_POLY_POW_CONV, REAL_POLY_CONV]:
    SEMIRING_NORMALIZERS_CONV(REAL_POLY_CLAUSES)(REAL_POLY_NEG_CLAUSES)(
      [
        is_realintconst,
        REAL_INT_ADD_CONV,
        REAL_INT_MUL_CONV,
        REAL_INT_POW_CONV
      ]
    )(fun (x): fun (y): x < y)
  let rule_2:
    realarith_GEN_REAL_ARITH(
      [
        mk_realintconst,
        REAL_INT_EQ_CONV,
        REAL_INT_GE_CONV,
        REAL_INT_GT_CONV,
        REAL_POLY_CONV,
        REAL_POLY_NEG_CONV,
        REAL_POLY_ADD_CONV,
        REAL_POLY_MUL_CONV,
        NO_CONV,
        NO_CONV,
        REAL_LINEAR_PROVER
      ]
    )
  let deabs_conv_2 = REWRITE_CONV(PairList [real_abs, real_max, real_min])
  fun(tm):
    let th1 = deabs_conv_2(tm)
    EQ_MP(SYM(th1))(rule_2(rand(concl(th1))))

