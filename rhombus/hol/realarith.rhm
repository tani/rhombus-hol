def REAL_NEG_SUB:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Eq(
            Real,
            App(
              Const("real_neg", Fun(Real, Real)),
              [App(Const("real_sub", Fun(Real, Fun(Real, Real))), [Ref("x"), Ref("y")])]
            ),
            App(Const("real_sub", Fun(Real, Fun(Real, Real))), [Ref("y"), Ref("x")])
          )
        )
      )),
      (
        REWRITE_TAC(PairList [real_sub, REAL_NEG_ADD, REAL_NEG_NEG]) then_tac \
        REWRITE_TAC(PairList [REAL_ADD_AC])
      )
    ]
  )

def REAL_LE_LT:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Iff(
            App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("y")]),
            Or(
              App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("y")]),
              Eq(Real, Ref("x"), Ref("y"))
            )
          )
        )
      )),
      (
        REWRITE_TAC(PairList [real_lt]) then_tac \
        MESON_TAC(PairList [REAL_LE_ANTISYM, REAL_LE_TOTAL])
      )
    ]
  )

