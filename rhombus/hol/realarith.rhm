                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          ))
        )
      ]
    )
  let pth_abs_2:
    prove(
      [
        Host.hol_term(Iff(
          App(Var("P", Fun(Real, Bool)), [App(Const("real_abs", Fun(Real, Real)), [Var("x", Real)])]),
          Or(
            And(
              App(
                Const("real_ge", Fun(Real, Fun(Real, Bool))),
                [
                  Var("x", Real),
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  )
                ]
              ),
              App(Var("P", Fun(Real, Bool)), [Var("x", Real)])
            ),
            And(
              App(
                Const("real_gt", Fun(Real, Fun(Real, Bool))),
                [
                  App(
                    Const("real_of_num", Fun(Num, Real)),
                    [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                  ),
                  Var("x", Real)
                ]
              ),
              App(Var("P", Fun(Real, Bool)), [App(Const("real_neg", Fun(Real, Real)), [Var("x", Real)])])
            )
          )
        )),
        (
          (
            REWRITE_TAC(PairList [real_abs, real_gt, real_ge]) then_tac \
            COND_CASES_TAC
          ) then_tac \
          ASM_REWRITE_TAC(PairList [real_lt])
        )
      ]
    )
  let pth_max_2:
    prove(
      [
        Host.hol_term(Iff(
          App(
            Var("P", Fun(Real, Bool)),
            [App(Const("real_max", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)])]
          ),
          Or(
            And(
              App(Const("real_ge", Fun(Real, Fun(Real, Bool))), [Var("y", Real), Var("x", Real)]),
              App(Var("P", Fun(Real, Bool)), [Var("y", Real)])
            ),
            And(
              App(Const("real_gt", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)]),
              App(Var("P", Fun(Real, Bool)), [Var("x", Real)])
            )
          )
        )),
        (
          (
            REWRITE_TAC(PairList [real_max, real_gt, real_ge]) then_tac \
            COND_CASES_TAC
          ) then_tac \
          ASM_REWRITE_TAC(PairList [real_lt])
        )
      ]
    )
  let pth_min_2:
    prove(
      [
        Host.hol_term(Iff(
          App(
            Var("P", Fun(Real, Bool)),
            [App(Const("real_min", Fun(Real, Fun(Real, Real))), [Var("x", Real), Var("y", Real)])]
          ),
          Or(
            And(
              App(Const("real_ge", Fun(Real, Fun(Real, Bool))), [Var("y", Real), Var("x", Real)]),
              App(Var("P", Fun(Real, Bool)), [Var("x", Real)])
            ),
            And(
              App(Const("real_gt", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Var("y", Real)]),
              App(Var("P", Fun(Real, Bool)), [Var("y", Real)])
            )
          )
        )),
        (
          (
            REWRITE_TAC(PairList [real_min, real_gt, real_ge]) then_tac \
            COND_CASES_TAC
          ) then_tac \
          ASM_REWRITE_TAC(PairList [real_lt])
        )
      ]
    )
  let abs_tm_2 = Host.hol_term(Const("real_abs", Fun(Real, Real)))
  let p_tm_3 = Host.hol_term(Var("P", Fun(Real, Bool)))
  let x_tm_3 = Host.hol_term(Var("x", Real))
  let y_tm_3 = Host.hol_term(Var("y", Real))
  let is_max_2 = is_binop(Host.hol_term(Const("real_max", Fun(Real, Fun(Real, Real)))))
  let is_min_2 = is_binop(Host.hol_term(Const("real_min", Fun(Real, Fun(Real, Real)))))
  let is_abs_2 = (fun(t): (is_comb(t) && (rator(t) == abs_tm_2)))
  let eliminate_construct:
    fun(p):
      fun(c):
        fun(tm):
          let t = find_term((fun(t): (p(t) && free_in(t)(tm))))(tm)
          let v = genvar(type_of(t))
          let th0 = SYM(BETA_CONV(mk_comb([mk_abs([v, subst(PairList [[v, t]])(tm)]), t])))
          let [p, ax] = dest_comb(rand(concl(th0)))
          CONV_RULE(RAND_CONV(BINOP_CONV(RAND_CONV(BETA_CONV))))(TRANS(th0)(c(p)(ax)))
  let elim_abs_2 = eliminate_construct(is_abs_2)(fun(p): fun(ax): INST(PairList [[p, p_tm_3], [rand(ax), x_tm_3]])(pth_abs_2))
  let elim_max_2:
    eliminate_construct(is_max_2)(
      fun(p):
        fun(ax):
          let [ax, y] = dest_comb(ax)
          INST(PairList [[p, p_tm_3], [rand(ax), x_tm_3], [y, y_tm_3]])(pth_max_2)
    )
  let elim_min_2:
    eliminate_construct(is_min_2)(
      fun(p):
        fun(ax):
          let [ax, y] = dest_comb(ax)
          INST(PairList [[p, p_tm_3], [rand(ax), x_tm_3], [y, y_tm_3]])(pth_min_2)
    )
  let ABSMAXMIN_ELIM_CONV2_2 = FIRST_CONV(PairList [elim_abs_2, elim_max_2, elim_min_2])
  fun([mkconst, EQ, GE, GT, NORM, NEG, ADD, MUL, PROVER]):
    realarith_GEN_REAL_ARITH(
      [
        mkconst,
        EQ,
        GE,
        GT,
        NORM,
        NEG,
        ADD,
        MUL,
        ABSMAXMIN_ELIM_CONV1_2,
        ABSMAXMIN_ELIM_CONV2_2,
        PROVER
      ]
    )

def realarith_REAL_ARITH_v2:
  let [REAL_POLY_NEG_CONV, REAL_POLY_ADD_CONV, REAL_POLY_SUB_CONV, REAL_POLY_MUL_CONV, REAL_POLY_POW_CONV, REAL_POLY_CONV]:
    SEMIRING_NORMALIZERS_CONV(REAL_POLY_CLAUSES)(REAL_POLY_NEG_CLAUSES)(
      [
        is_realintconst,
        REAL_INT_ADD_CONV,
        REAL_INT_MUL_CONV,
        REAL_INT_POW_CONV
      ]
    )(fun (x): fun (y): x < y)
  realarith_GEN_REAL_ARITH_v2(
    [
      mk_realintconst,
      REAL_INT_EQ_CONV,
      REAL_INT_GE_CONV,
      REAL_INT_GT_CONV,
      REAL_POLY_CONV,
      REAL_POLY_NEG_CONV,
      REAL_POLY_ADD_CONV,
      REAL_POLY_MUL_CONV,
      REAL_LINEAR_PROVER
    ]
  )

def GEN_REAL_ARITH = realarith_GEN_REAL_ARITH_v2

def REAL_ARITH = realarith_REAL_ARITH_v2
