def REAL_ENTIRE:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Iff(
            Eq(
              Real,
              App(Const("real_mul", Fun(Real, Fun(Real, Real))), [Ref("x"), Ref("y")]),
              App(
                Const("real_of_num", Fun(Num, Real)),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
              )
            ),
            Or(
              Eq(
                Real,
                Ref("x"),
                App(
                  Const("real_of_num", Fun(Num, Real)),
                  [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                )
              ),
              Eq(
                Real,
                Ref("y"),
                App(
                  Const("real_of_num", Fun(Num, Real)),
                  [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    ((REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac STRIP_TAC) then_tac \
                    ASM_REWRITE_TAC(PairList [REAL_MUL_LZERO, REAL_MUL_RZERO])
                  ) then_tac \
                  ASM_CASES_TAC(
                    Host.hol_term(Eq(
                      Real,
                      Var("x", Real),
                      App(
                        Const("real_of_num", Fun(Num, Real)),
                        [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                      )
                    ))
                  )
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              FIRST_ASSUM(
                o(MP_TAC)(
                  AP_TERM(
