def REAL_LTE_TOTAL:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Real,
        Forall(
          "y",
          Real,
          Or(
            App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("y")]),
            App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("y"), Ref("x")])
          )
        )
      )),
      (REWRITE_TAC(PairList [real_lt]) then_tac CONV_TAC(TAUT))
    ]
  )

