def REAL_LTE_TOTAL:
  prove(
    [
      @hol|{!x y. x < y \/ y <= x}|,
      REWRITE_TAC(PairList [real_lt]) then_tac CONV_TAC(TAUT)
    ]
  )

def REAL_LET_TOTAL:
  prove(
    [
      @hol|{!x y. x <= y \/ y < x}|,
      REWRITE_TAC(PairList [real_lt]) then_tac CONV_TAC(TAUT)
    ]
  )

def REAL_LT_IMP_LE:
  prove(
    [
      @hol|{!x y. x < y ==> x <= y}|,
      MESON_TAC(PairList [real_lt, REAL_LE_TOTAL])
    ]
  )

def REAL_LTE_TRANS:
  prove(
    [
      @hol|{!x y z. x < y /\ y <= z ==> x < z}|,
      MESON_TAC(PairList [real_lt, REAL_LE_TRANS])
    ]
  )

def REAL_LET_TRANS:
  prove(
    [
      @hol|{!x y z. x <= y /\ y < z ==> x < z}|,
      MESON_TAC(PairList [real_lt, REAL_LE_TRANS])
    ]
  )

def REAL_LT_TRANS:
  prove(
    [
      @hol|{!x y z. x < y /\ y < z ==> x < z}|,
      MESON_TAC(PairList [REAL_LTE_TRANS, REAL_LT_IMP_LE])
    ]
  )

def REAL_LE_ADD:
  prove(
    [
      @hol|{!x y. &0 <= x /\ &0 <= y ==> &0 <= x + y}|,
      MESON_TAC(PairList [REAL_LE_LADD_IMP, REAL_ADD_RID, REAL_LE_TRANS])
    ]
  )

def REAL_LTE_ANTISYM:
  prove(
    [
      @hol|{!x y. ~(x < y /\ y <= x)}|,
      MESON_TAC(PairList [real_lt])
    ]
  )

def REAL_SUB_LE:
  prove(
    [
      @hol|{!x y. &0 <= (x - y) <=> y <= x}|,
      REWRITE_TAC(PairList [real_sub, GSYM(REAL_LE_LNEG), REAL_LE_NEG2])
    ]
  )

def REAL_NEG_SUB:
  prove(
    [
      @hol|{!x y. --(x - y) = y - x}|,
      REWRITE_TAC(PairList [real_sub, REAL_NEG_ADD, REAL_NEG_NEG]) then_tac \
      REWRITE_TAC(PairList [REAL_ADD_AC])
    ]
  )

def REAL_LE_LT:
  prove(
    [
      @hol|{!x y. x <= y <=> x < y \/ (x = y)}|,
      REWRITE_TAC(PairList [real_lt]) then_tac \
      MESON_TAC(PairList [REAL_LE_ANTISYM, REAL_LE_TOTAL])
    ]
  )

def REAL_SUB_LT:
  prove(
    [
      @hol|{!x y. &0 < (x - y) <=> y < x}|,
      REWRITE_TAC(PairList [real_lt]) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_NEG_SUB)]) then_tac \
      REWRITE_TAC(PairList [REAL_LE_LNEG, REAL_ADD_RID, REAL_SUB_LE])
    ]
  )

def REAL_NOT_LT:
  prove(
    [
      @hol|{!x y. ~(x < y) <=> y <= x}|,
      REWRITE_TAC(PairList [real_lt])
    ]
  )

def REAL_SUB_0:
  prove(
    [
      @hol|{!x y. (x - y = &0) <=> (x = y)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM)]) then_tac \
      GEN_REWRITE_TAC(o(LAND_CONV)(LAND_CONV))(PairList [GSYM(REAL_NOT_LT)]) then_tac \
      REWRITE_TAC(PairList [REAL_SUB_LE, REAL_SUB_LT]) then_tac \
      REWRITE_TAC(PairList [REAL_NOT_LT])
    ]
  )

def REAL_LT_LE:
  prove(
    [
      @hol|{!x y. x < y <=> x <= y /\ ~(x = y)}|,
      MESON_TAC(PairList [real_lt, REAL_LE_TOTAL, REAL_LE_ANTISYM])
    ]
  )

def REAL_LT_REFL:
  prove(
    [
      @hol|{!x. ~(x < x)}|,
      REWRITE_TAC(PairList [real_lt, REAL_LE_REFL])
    ]
  )

def REAL_LTE_ADD:
  prove(
    [
      @hol|{!x y. &0 < x /\ &0 <= y ==> &0 < x + y}|,
      MESON_TAC(PairList [REAL_LE_LADD_IMP, REAL_ADD_RID, REAL_LTE_TRANS])
    ]
  )

def REAL_LET_ADD:
  prove(
    [
      @hol|{!x y. &0 <= x /\ &0 < y ==> &0 < x + y}|,
      MESON_TAC(PairList [REAL_LTE_ADD, REAL_ADD_SYM])
    ]
  )

def REAL_LT_ADD:
  prove(
    [
      @hol|{!x y. &0 < x /\ &0 < y ==> &0 < x + y}|,
      MESON_TAC(PairList [REAL_LT_IMP_LE, REAL_LTE_ADD])
    ]
  )

def REAL_ENTIRE:
  prove(
    [
      @hol|{!x y. (x * y = &0) <=> (x = &0) \/ (y = &0)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac STRIP_TAC then_tac \
      ASM_REWRITE_TAC(PairList [REAL_MUL_LZERO, REAL_MUL_RZERO]) then_tac \
      ASM_CASES_TAC(
        @hol|{x = &0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      FIRST_ASSUM(
        o(MP_TAC)(
          AP_TERM(
            @hol|{(*) (inv x)}|
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList [REAL_MUL_ASSOC]) then_tac \
      FIRST_ASSUM((fun(th): REWRITE_TAC(PairList [MATCH_MP(REAL_MUL_LINV)(th)]))) then_tac \
      REWRITE_TAC(PairList [REAL_MUL_LID, REAL_MUL_RZERO])
    ]
  )

def REAL_LE_NEGTOTAL:
  prove(
    [
      @hol|{!x. &0 <= x \/ &0 <= --x}|,
      REWRITE_TAC(PairList [REAL_LE_RNEG, REAL_ADD_LID, REAL_LE_TOTAL])
    ]
  )

def REAL_LE_SQUARE:
  prove(
    [
      @hol|{!x. &0 <= x * x}|,
      GEN_TAC then_tac \
      DISJ_CASES_TAC(SPEC(@hol|{x:real}|)(REAL_LE_NEGTOTAL)) then_tac \
      POP_ASSUM((fun(th): MP_TAC(MATCH_MP(REAL_LE_MUL)(CONJ(th)(th))))) then_tac \
      REWRITE_TAC(PairList [REAL_MUL_LNEG, REAL_MUL_RNEG, REAL_NEG_NEG])
    ]
  )

def REAL_MUL_RID:
  prove(
    [
      @hol|{!x. x * &1 = x}|,
      MESON_TAC(PairList [REAL_MUL_LID, REAL_MUL_SYM])
    ]
  )

def REAL_POW_2:
  prove(
    [
      @hol|{!x. x pow 2 = x * x}|,
      REWRITE_TAC(
        PairList [
          num_CONV(
            @hol|{2}|
          ),
          num_CONV(
            @hol|{1}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [real_pow, REAL_MUL_RID])
    ]
  )

def REAL_POLY_CLAUSES:
  prove(
    [
      @hol|{(!x y z. x + (y + z) = (x + y) + z) /\
         (!x y. x + y = y + x) /\
         (!x. &0 + x = x) /\
         (!x y z. x * (y * z) = (x * y) * z) /\
         (!x y. x * y = y * x) /\
         (!x. &1 * x = x) /\
         (!x. &0 * x = &0) /\
         (!x y z. x * (y + z) = x * y + x * z) /\
         (!x. x pow 0 = &1) /\
         (!x n. x pow (SUC n) = x * x pow n)}|,
      REWRITE_TAC(PairList [real_pow, REAL_ADD_LDISTRIB, REAL_MUL_LZERO]) then_tac \
      REWRITE_TAC(PairList [REAL_MUL_ASSOC, REAL_ADD_LID, REAL_MUL_LID]) then_tac \
      REWRITE_TAC(PairList [REAL_ADD_AC]) then_tac \
      REWRITE_TAC(PairList [REAL_MUL_SYM])
    ]
  )

def REAL_POLY_NEG_CLAUSES:
  prove(
    [
      @hol|{(!x. --x = --(&1) * x) /\
         (!x y. x - y = x + --(&1) * y)}|,
      REWRITE_TAC(PairList [REAL_MUL_LNEG, real_sub, REAL_MUL_LID])
    ]
  )

def REAL_POS:
  prove(
    [
      @hol|{!n. &0 <= &n}|,
      REWRITE_TAC(PairList [REAL_OF_NUM_LE, LE_0])
    ]
  )

def REAL_LT_NZ:
  prove(
    [
      @hol|{!n. ~(&n = &0) <=> (&0 < &n)}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [REAL_LT_LE]) then_tac \
      CONV_TAC(RAND_CONV(ONCE_DEPTH_CONV(SYM_CONV))) then_tac \
      ASM_CASES_TAC(
        @hol|{&n = &0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [REAL_LE_REFL, REAL_POS])
    ]
  )

def REAL_POS_LT:
  prove(
    [
      @hol|{!n. &0 < &(SUC n)}|,
      GEN_TAC then_tac \
      REWRITE_TAC(
        PairList [
          SPEC(@hol|{SUC n}|)(GSYM(REAL_LT_NZ)),
          REAL_OF_NUM_EQ
        ]
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(LT_NZ), LT_0])
    ]
  )

variant positivstellensatz:
  Axiom_eq(index)
  Axiom_le(index)
  Axiom_lt(index)
  Rational_eq(rational)
  Rational_le(rational)
  Rational_lt(rational)
  Square(term)
  Eqmul(multiplier, certificate)
  Sum(left, right)
  Product(left, right)

def realarith_GEN_REAL_ARITH:
  let pth_2:
    prove(
      [
        @hol|{(x < y <=> y - x > &0) /\
           (x <= y <=> y - x >= &0) /\
           (x > y <=> x - y > &0) /\
           (x >= y <=> x - y >= &0) /\
           ((x = y) <=> (x - y = &0)) /\
           (~(x < y) <=> x - y >= &0) /\
           (~(x <= y) <=> x - y > &0) /\
           (~(x > y) <=> y - x >= &0) /\
           (~(x >= y) <=> y - x > &0) /\
           (~(x = y) <=> x - y > &0 \/ --(x - y) > &0)}|,
        REWRITE_TAC(PairList [real_gt, real_ge, REAL_SUB_LT, REAL_SUB_LE, REAL_NEG_SUB]) then_tac \
        REWRITE_TAC(PairList [REAL_SUB_0, real_lt]) then_tac \
        MESON_TAC(PairList [REAL_LE_ANTISYM])
      ]
    )
  let pth_final = TAUT(@hol|{(~p ==> F) ==> p}|)
  let pth_add:
    prove(
      [
        @hol|{((x = &0) /\ (y = &0) ==> (x + y = &0)) /\
           ((x = &0) /\ y >= &0 ==> x + y >= &0) /\
           ((x = &0) /\ y > &0 ==> x + y > &0) /\
           (x >= &0 /\ (y = &0) ==> x + y >= &0) /\
           (x >= &0 /\ y >= &0 ==> x + y >= &0) /\
           (x >= &0 /\ y > &0 ==> x + y > &0) /\
           (x > &0 /\ (y = &0) ==> x + y > &0) /\
           (x > &0 /\ y >= &0 ==> x + y > &0) /\
           (x > &0 /\ y > &0 ==> x + y > &0)}|,
        SIMP_TAC(PairList [REAL_ADD_LID, REAL_ADD_RID, real_ge, real_gt]) then_tac \
        REWRITE_TAC(PairList [REAL_LE_LT]) then_tac \
        MESON_TAC(PairList [REAL_ADD_LID, REAL_ADD_RID, REAL_LT_ADD])
      ]
    )
  let pth_mul:
    prove(
      [
        @hol|{((x = &0) /\ (y = &0) ==> (x * y = &0)) /\
           ((x = &0) /\ y >= &0 ==> (x * y = &0)) /\
           ((x = &0) /\ y > &0 ==> (x * y = &0)) /\
           (x >= &0 /\ (y = &0) ==> (x * y = &0)) /\
           (x >= &0 /\ y >= &0 ==> x * y >= &0) /\
           (x >= &0 /\ y > &0 ==> x * y >= &0) /\
           (x > &0 /\ (y = &0) ==> (x * y = &0)) /\
           (x > &0 /\ y >= &0 ==> x * y >= &0) /\
           (x > &0 /\ y > &0 ==> x * y > &0)}|,
        SIMP_TAC(PairList [REAL_MUL_LZERO, REAL_MUL_RZERO, real_ge, real_gt]) then_tac \
        SIMP_TAC(PairList [REAL_LT_LE, REAL_LE_MUL]) then_tac \
        MESON_TAC(PairList [REAL_ENTIRE])
      ]
    )
  let pth_emul:
    prove(
      [
        @hol|{(y = &0) ==> !x. x * y = &0}|,
        SIMP_TAC(PairList [REAL_MUL_RZERO])
      ]
    )
  let pth_square:
    prove(
      [
        @hol|{!x. x * x >= &0}|,
        REWRITE_TAC(PairList [real_ge, REAL_POW_2, REAL_LE_SQUARE])
      ]
    )
  let MATCH_MP_RULE:
    fun(th):
      fun(th2):
        let net = itlist((fun(th): net_of_conv(lhand(concl(th)))(PART_MATCH(lhand)(th))))(CONJUNCTS(th))(empty_net)
        MP(REWRITES_CONV(net)(concl(th2)))(th2)
  let x_tm = @hol|{x:real}|
  let y_tm = @hol|{y:real}|
  let neg_tm = @hol|{(--):real->real}|
  let gt_tm = @hol|{(>):real->real->bool}|
  let ge_tm = @hol|{(>=):real->real->bool}|
  let eq_tm = @hol|{(=):real->real->bool}|
  let p_tm = @hol|{p:bool}|
  let or_tm = @hol|{(\/)}|
  let false_tm = @hol|{F}|
  let z_tm:
    @hol|{&0 :real}|
  let xy_lt = @hol|{(x:real) < y}|
  let xy_nlt = @hol|{~((x:real) < y)}|
  let xy_le = @hol|{(x:real) <= y}|
  let xy_nle = @hol|{~((x:real) <= y)}|
  let xy_gt = @hol|{(x:real) > y}|
  let xy_ngt = @hol|{~((x:real) > y)}|
  let xy_ge = @hol|{(x:real) >= y}|
  let xy_nge = @hol|{~((x:real) >= y)}|
  let xy_eq = @hol|{x:real = y}|
  let xy_ne = @hol|{~(x:real = y)}|
  let is_ge = is_binop(ge_tm)
  let is_gt = is_binop(gt_tm)
  let is_req = is_binop(eq_tm)
  fun([mk_numeric, NUMERIC_EQ_CONV, NUMERIC_GE_CONV, NUMERIC_GT_CONV, POLY_CONV, POLY_NEG_CONV, POLY_ADD_CONV, POLY_MUL_CONV, absconv1, absconv2, prover]):
    let REAL_INEQ_CONV:
      fun(pth):
        fun(tm):
          let [lop, r] = dest_comb(tm)
          let th = INST(PairList [[rand(lop), x_tm], [r, y_tm]])(pth)
          TRANS(th)(LAND_CONV(POLY_CONV)(rand(concl(th))))
    let PairList [REAL_LT_CONV, & PairList [REAL_LE_CONV, & PairList [REAL_GT_CONV, & PairList [REAL_GE_CONV, & PairList [REAL_EQ_CONV, & PairList [REAL_NOT_LT_CONV, & PairList [REAL_NOT_LE_CONV, & PairList [REAL_NOT_GT_CONV, & PairList [REAL_NOT_GE_CONV, & PairList [_, & PairList []]]]]]]]]]] = map(REAL_INEQ_CONV)(CONJUNCTS(pth_2))
    let pth = last(CONJUNCTS(pth_2))
    let REAL_NOT_EQ_CONV:
      fun(tm):
        let [l, r] = dest_eq(tm)
        let th = INST(PairList [[l, x_tm], [r, y_tm]])(pth)
        let th_p = POLY_CONV(lhand(lhand(rand(concl(th)))))
        let th_x = AP_TERM(neg_tm)(th_p)
        let th_n = CONV_RULE(RAND_CONV(POLY_NEG_CONV))(th_x)
        let th_prime = MK_DISJ(AP_THM(AP_TERM(gt_tm)(th_p))(z_tm))(AP_THM(AP_TERM(gt_tm)(th_n))(z_tm))
        TRANS(th)(th_prime)
    let net_single:
      itlist(uncurry(net_of_conv))(
        PairList [
          [xy_lt, REAL_LT_CONV],
          [xy_nlt, (fun(t): REAL_NOT_LT_CONV(rand(t)))],
          [xy_le, REAL_LE_CONV],
          [xy_nle, (fun(t): REAL_NOT_LE_CONV(rand(t)))],
          [xy_gt, REAL_GT_CONV],
          [xy_ngt, (fun(t): REAL_NOT_GT_CONV(rand(t)))],
          [xy_ge, REAL_GE_CONV],
          [xy_nge, (fun(t): REAL_NOT_GE_CONV(rand(t)))],
          [xy_eq, REAL_EQ_CONV],
          [xy_ne, (fun(t): REAL_NOT_EQ_CONV(rand(t)))]
        ]
      )(empty_net)
    let net_double:
      itlist(uncurry(net_of_conv))(
        PairList [
          [xy_lt, (fun(t): [REAL_LT_CONV(t), REAL_NOT_LT_CONV(t)])],
          [xy_le, (fun(t): [REAL_LE_CONV(t), REAL_NOT_LE_CONV(t)])],
          [xy_gt, (fun(t): [REAL_GT_CONV(t), REAL_NOT_GT_CONV(t)])],
          [xy_ge, (fun(t): [REAL_GE_CONV(t), REAL_NOT_GE_CONV(t)])],
          [xy_eq, (fun(t): [REAL_EQ_CONV(t), REAL_NOT_EQ_CONV(t)])]
        ]
      )(empty_net)
    let REAL_INEQ_NORM_CONV = REWRITES_CONV(net_single)
    let REAL_INEQ_NORM_DCONV = REWRITES_CONV(net_double)
    let NNF_NORM_CONV = GEN_NNF_CONV(#false)([REAL_INEQ_NORM_CONV, REAL_INEQ_NORM_DCONV])
    let rules = MATCH_MP_RULE(pth_mul)
    let MUL_RULE = (fun(th): CONV_RULE(LAND_CONV(POLY_MUL_CONV))(rules(th)))
    let rules = MATCH_MP_RULE(pth_add)
    let ADD_RULE = (fun(th): CONV_RULE(LAND_CONV(POLY_ADD_CONV))(rules(th)))
    let rule = MATCH_MP(pth_emul)
    let EMUL_RULE = fun(tm): fun(th): CONV_RULE(LAND_CONV(POLY_MUL_CONV))(SPEC(tm)(rule(th)))
    let SQUARE_RULE = (fun(t): CONV_RULE(LAND_CONV(POLY_MUL_CONV))(SPEC(t)(pth_square)))
    let hol_of_positivstellensatz:
      fun([eqs, les, lts]):
        fun translate(prf):
          match prf
          | Axiom_eq(n): el(n)(eqs)
          | Axiom_le(n): el(n)(les)
          | Axiom_lt(n): el(n)(lts)
          | Rational_eq(x): EQT_ELIM(NUMERIC_EQ_CONV(mk_comb([mk_comb([eq_tm, mk_numeric(x)]), z_tm])))
          | Rational_le(x): EQT_ELIM(NUMERIC_GE_CONV(mk_comb([mk_comb([ge_tm, mk_numeric(x)]), z_tm])))
          | Rational_lt(x): EQT_ELIM(NUMERIC_GT_CONV(mk_comb([mk_comb([gt_tm, mk_numeric(x)]), z_tm])))
          | Square(t): SQUARE_RULE(t)
          | Eqmul(t,p): EMUL_RULE(t)(translate(p))
          | Sum(p1,p2): ADD_RULE(CONJ(translate(p1))(translate(p2)))
          | Product(p1,p2): MUL_RULE(CONJ(translate(p1))(translate(p2)))
        (fun(prf): CONV_RULE(FIRST_CONV(PairList [NUMERIC_GE_CONV, NUMERIC_GT_CONV, NUMERIC_EQ_CONV]))(translate(prf)))
    let init_conv:
      (
        TOP_DEPTH_CONV(BETA_CONV) then_conv PRESIMP_CONV then_conv NNF_CONV then_conv \
        DEPTH_BINOP_CONV(or_tm)(CONDS_ELIM_CONV) then_conv \
        NNF_NORM_CONV then_conv \
        SKOLEM_CONV then_conv \
        PRENEX_CONV then_conv \
        WEAK_DNF_CONV
      )
    // Recursive proof splitting needs the local definition before its first use.
    fun overall(dun):
      fun(ths):
        match ths
        | PairList []:
            let [eq, ne] = partition(o(is_req)(concl))(dun)
            let [le, nl] = partition(o(is_ge)(concl))(ne)
            let lt = filter(o(is_gt)(concl))(nl)
            prover(hol_of_positivstellensatz)([eq, le, lt])
        | PairList [th, & oths]:
            let tm = concl(th)
            if is_conj(tm)
            | let [th1, th2] = CONJ_PAIR(th)
              overall(dun)(PairList [th1, th2, & oths])
            | if is_disj(tm)
              | let th1_2 = overall(dun)(PairList [ASSUME(lhand(tm)), & oths])
                let th2_2 = overall(dun)(PairList [ASSUME(rand(tm)), & oths])
                DISJ_CASES(th)(th1_2)(th2_2)
              | overall(PairList [th, & dun])(oths)
    fun(tm):
      let NNF_NORM_CONV_prime = GEN_NNF_CONV(#false)([CACHE_CONV(REAL_INEQ_NORM_CONV), (fun(t): failwith(""))])
      fun absremover(t):
        (
          TOP_DEPTH_CONV(absconv1 then_conv BINOP_CONV(LAND_CONV(POLY_CONV))) then_conv \
          TRY_CONV(absconv2 then_conv NNF_NORM_CONV_prime then_conv BINOP_CONV(absremover))
        )(t)
      let th0 = init_conv(mk_neg(tm))
      let tm0 = rand(concl(th0))
      let th:
        if (tm0 == false_tm)
        | fst(EQ_IMP_RULE(th0))
        | let [evs, bod] = strip_exists(tm0)
          let [avs, ibod] = strip_forall(bod)
          let th1 = itlist(MK_FORALL)(avs)(DEPTH_BINOP_CONV(or_tm)(absremover)(ibod))
          let th2 = overall(PairList [])(PairList [SPECL(avs)(ASSUME(rand(concl(th1))))])
          let th3 = itlist(SIMPLE_CHOOSE)(evs)(PROVE_HYP(EQ_MP(th1)(ASSUME(bod)))(th2))
          DISCH_ALL(PROVE_HYP(EQ_MP(th0)(ASSUME(mk_neg(tm))))(th3))
      MP(INST(PairList [[tm, p_tm]])(pth_final))(th)

def REAL_LINEAR_PROVER:
  let linear_add = combine((fun (x): fun (y): x + y))((fun(z): (z == num_0)))
  let linear_cmul = (fun(c): mapf((fun(x): (c * x))))
  let one_tm:
    @hol|{&1}|
  let contradictory = fun(p): fun([e, _]): ((is_undefined(e) && !p(num_0)) || ((dom(e) == (PairList [one_tm])) && !p(apply(e)(one_tm))))
  // Recursive elimination needs the local definition before its first use.
  fun linear_ineqs(vars):
    fun([les, lts]):
      try:
        find(contradictory((fun(x): (x > num_0))))(lts)
        ~catch exn:
          match exn
          | Failure(_):
              try:
                find(contradictory((fun(x): (x >= num_0))))(les)
                ~catch exn:
                  match exn
                  | Failure(_):
                      if (vars == (PairList []))
                      | failwith("linear_ineqs: no contradiction")
                      | let ineqs = append(les)(lts)
                        let blowup:
                          fun(v):
                            (length(filter((fun([e, _]): (tryapplyd(e)(v)(num_0) > num_0)))(ineqs)) * length(filter((fun([e, _]): (tryapplyd(e)(v)(num_0) < num_0)))(ineqs)))
                        let v = fst(hd(sort(fun([_, i]): fun([_, j]): (i < j))(map((fun(v): [v, blowup(v)]))(vars))))
                        let addup:
                          fun([e1, p1]):
                            fun([e2, p2]):
                              fun(acc):
                                let c1 = tryapplyd(e1)(v)(num_0)
                                let c2 = tryapplyd(e2)(v)(num_0)
                                if ((c1 * c2) >= num_0)
                                | acc
                                | let e1_prime = linear_cmul(abs_num(c2))(e1)
                                  let e2_prime = linear_cmul(abs_num(c1))(e2)
                                  let p1_prime = Product(Rational_lt(abs_num(c2)), p1)
                                  let p2_prime = Product(Rational_lt(abs_num(c1)), p2)
                                  PairList [[linear_add(e1_prime)(e2_prime), Sum(p1_prime, p2_prime)], & acc]
                        let [les0, les1] = partition((fun([e, _]): (tryapplyd(e)(v)(num_0) == num_0)))(les)
                        let [lts0, lts1] = partition((fun([e, _]): (tryapplyd(e)(v)(num_0) == num_0)))(lts)
                        let [lesp, lesn] = partition((fun([e, _]): (tryapplyd(e)(v)(num_0) > num_0)))(les1)
                        let [ltsp, ltsn] = partition((fun([e, _]): (tryapplyd(e)(v)(num_0) > num_0)))(lts1)
                        let les_prime = itlist((fun(ep1): itlist(addup(ep1))(lesp)))(lesn)(les0)
                        let lts_prime = itlist((fun(ep1): itlist(addup(ep1))(append(lesp)(ltsp))))(ltsn)(itlist((fun(ep1): itlist(addup(ep1))(append(lesn)(ltsn))))(ltsp)(lts0))
                        linear_ineqs(subtract(vars)(PairList [v]))([les_prime, lts_prime])
                  | exn: (throw exn)
          | exn: (throw exn)
  fun linear_eqs([eqs, les, lts]):
    try:
      find(contradictory((fun(x): (x == num_0))))(eqs)
      ~catch exn:
        match exn
        | Failure(_):
            match eqs
            | PairList []:
                let vars = subtract(itlist(o(o(union)(dom))(fst))(append(les)(lts))(PairList []))(PairList [one_tm])
                linear_ineqs(vars)([les, lts])
            | PairList [[e, p], & es]:
                if is_undefined(e)
                | linear_eqs([es, les, lts])
                | let [x, c] = choose(undefine(one_tm)(e))
                  let xform:
                    fun([t, q] as inp):
                      let d = tryapplyd(t)(x)(num_0)
                      if (d == num_0)
                      | inp
                      | let k = ((minus_num(d) * abs_num(c)) / c)
                        let e_prime = linear_cmul(k)(e)
                        let t_prime = linear_cmul(abs_num(c))(t)
                        let p_prime = Eqmul(term_of_rat(k), p)
                        let q_prime = Product(Rational_lt(abs_num(c)), q)
                        [linear_add(e_prime)(t_prime), Sum(p_prime, q_prime)]
                  linear_eqs([map(xform)(es), map(xform)(les), map(xform)(lts)])
        | exn: (throw exn)
  let linear_prover:
    fun([eq, le, lt]):
      let eqs_2 = map2(fun(p): fun(n): [p, Axiom_eq(n)])(eq)(range(0)((length(eq) - 1)))
      let les_2 = map2(fun(p): fun(n): [p, Axiom_le(n)])(le)(range(0)((length(le) - 1)))
      let lts_2 = map2(fun(p): fun(n): [p, Axiom_lt(n)])(lt)(range(0)((length(lt) - 1)))
      linear_eqs([eqs_2, les_2, lts_2])
  let one_tm:
    @hol|{&1}|
  let zero_tm:
    @hol|{&0}|
  let add_tm = @hol|{(+):real->real->real}|
  let mul_tm = @hol|{(*):real->real->real}|
  fun lin_of_hol_2(tm):
    if (tm == zero_tm)
    | undefined
    | if !is_comb(tm)
      | fpf_singleton(tm)(1)
      | if is_ratconst(tm)
        | fpf_singleton(one_tm)(rat_of_term(tm))
        | let [lop, r] = dest_comb(tm)
          if !is_comb(lop)
          | fpf_singleton(tm)(1)
          | let [op, l] = dest_comb(lop)
            if (op == add_tm)
            | linear_add(lin_of_hol_2(l))(lin_of_hol_2(r))
            | (if ((op == mul_tm) && is_ratconst(l)) | fpf_singleton(r)(rat_of_term(l)) | fpf_singleton(tm)(1))
  let lin_of_hol = lin_of_hol_2
  let is_alien:
    fun(tm):
      match tm
      | Comb(Const("real_of_num",_),n):
          if !is_numeral(n)
          | #true
          | match tm
            | _: #false
      | _: #false
  let is_suc_alien:
    fun(tm):
      match tm
      | Comb(Const("real_of_num",_),Comb(Const("SUC",_),_)): #true
      | _: #false
  let dest_suc_alien:
    fun(tm):
      match tm
      | Comb(Const("real_of_num",_),Comb(Const("SUC",_),n)): n
      | _: failwith("")
  let n_tm = @hol|{n:num}|
  let pth = REWRITE_RULE(PairList [GSYM(real_ge)])(SPEC(n_tm)(REAL_POS))
  let pth_suc = REWRITE_RULE(PairList [GSYM(real_gt)])(SPEC(n_tm)(REAL_POS_LT))
  fun(translator):
    fun([eq, le, lt]):
      let eq_pols = map(o(o(lin_of_hol)(lhand))(concl))(eq)
      let le_pols = map(o(o(lin_of_hol)(lhand))(concl))(le)
      let lt_pols = map(o(o(lin_of_hol)(lhand))(concl))(lt)
      let all_aliens = filter(is_alien)(itlist(o(union)(dom))(append(eq_pols)(append(le_pols)(lt_pols)))(PairList []))
      let [suc_aliens, aliens] = partition(is_suc_alien)(all_aliens)
      let le_pols_prime = append(le_pols)(map((fun(v): fpf_singleton(v)(1)))(aliens))
      let lt_pols_prime = append(lt_pols)(map((fun(v): fpf_singleton(v)(1)))(suc_aliens))
      let [_, proof] = linear_prover([eq_pols, le_pols_prime, lt_pols_prime])
      let le_prime = append(le)(map((fun(a): INST(PairList [[rand(a), n_tm]])(pth)))(aliens))
      let lt_prime = append(lt)(map((fun(a): INST(PairList [[dest_suc_alien(a), n_tm]])(pth_suc)))(suc_aliens))
      translator([eq, le_prime, lt_prime])(proof)

def realarith_REAL_ARITH:
  let [REAL_POLY_NEG_CONV, REAL_POLY_ADD_CONV, REAL_POLY_SUB_CONV, REAL_POLY_MUL_CONV, REAL_POLY_POW_CONV, REAL_POLY_CONV]:
    SEMIRING_NORMALIZERS_CONV(REAL_POLY_CLAUSES)(REAL_POLY_NEG_CLAUSES)(
      [
        is_realintconst,
        REAL_INT_ADD_CONV,
        REAL_INT_MUL_CONV,
        REAL_INT_POW_CONV
      ]
    )(fun (x): fun (y): x < y)
  let rule:
    realarith_GEN_REAL_ARITH(
      [
        mk_realintconst,
        REAL_INT_EQ_CONV,
        REAL_INT_GE_CONV,
        REAL_INT_GT_CONV,
        REAL_POLY_CONV,
        REAL_POLY_NEG_CONV,
        REAL_POLY_ADD_CONV,
        REAL_POLY_MUL_CONV,
        NO_CONV,
        NO_CONV,
        REAL_LINEAR_PROVER
      ]
    )
  let deabs_conv = REWRITE_CONV(PairList [real_abs, real_max, real_min])
  fun(tm):
    let th1 = deabs_conv(tm)
    EQ_MP(SYM(th1))(rule(rand(concl(th1))))

def realarith_GEN_REAL_ARITH_v2:
  let ABSMAXMIN_ELIM_CONV1:
    GEN_REWRITE_CONV(I)(
      PairList [
        time(realarith_REAL_ARITH)(
          @hol|{(--(&1) * abs(x) >= r <=>
              --(&1) * x >= r /\ &1 * x >= r) /\
             (--(&1) * abs(x) + a >= r <=>
              a + --(&1) * x >= r /\ a + &1 * x >= r) /\
             (a + --(&1) * abs(x) >= r <=>
              a + --(&1) * x >= r /\ a + &1 * x >= r) /\
             (a + --(&1) * abs(x) + b >= r <=>
              a + --(&1) * x + b >= r /\ a + &1 * x + b >= r) /\
             (a + b + --(&1) * abs(x) >= r <=>
              a + b + --(&1) * x >= r /\ a + b + &1 * x >= r) /\
             (a + b + --(&1) * abs(x) + c >= r <=>
              a + b + --(&1) * x + c >= r /\ a + b + &1 * x + c >= r) /\
             (--(&1) * max x y >= r <=>
              --(&1) * x >= r /\ --(&1) * y >= r) /\
             (--(&1) * max x y + a >= r <=>
              a + --(&1) * x >= r /\ a + --(&1) * y >= r) /\
             (a + --(&1) * max x y >= r <=>
              a + --(&1) * x >= r /\ a + --(&1) * y >= r) /\
             (a + --(&1) * max x y + b >= r <=>
              a + --(&1) * x + b >= r /\ a + --(&1) * y  + b >= r) /\
             (a + b + --(&1) * max x y >= r <=>
              a + b + --(&1) * x >= r /\ a + b + --(&1) * y >= r) /\
             (a + b + --(&1) * max x y + c >= r <=>
              a + b + --(&1) * x + c >= r /\ a + b + --(&1) * y  + c >= r) /\
             (&1 * min x y >= r <=>
              &1 * x >= r /\ &1 * y >= r) /\
             (&1 * min x y + a >= r <=>
              a + &1 * x >= r /\ a + &1 * y >= r) /\
             (a + &1 * min x y >= r <=>
              a + &1 * x >= r /\ a + &1 * y >= r) /\
             (a + &1 * min x y + b >= r <=>
              a + &1 * x + b >= r /\ a + &1 * y  + b >= r) /\
             (a + b + &1 * min x y >= r <=>
              a + b + &1 * x >= r /\ a + b + &1 * y >= r) /\
             (a + b + &1 * min x y + c >= r <=>
              a + b + &1 * x + c >= r /\ a + b + &1 * y  + c >= r) /\
             (min x y >= r <=>
               x >= r /\  y >= r) /\
             (min x y + a >= r <=>
              a + x >= r /\ a + y >= r) /\
             (a + min x y >= r <=>
              a + x >= r /\ a + y >= r) /\
             (a + min x y + b >= r <=>
              a + x + b >= r /\ a + y  + b >= r) /\
             (a + b + min x y >= r <=>
              a + b + x >= r /\ a + b + y >= r) /\
             (a + b + min x y + c >= r <=>
              a + b + x + c >= r /\ a + b + y + c >= r) /\
             (--(&1) * abs(x) > r <=>
              --(&1) * x > r /\ &1 * x > r) /\
             (--(&1) * abs(x) + a > r <=>
              a + --(&1) * x > r /\ a + &1 * x > r) /\
             (a + --(&1) * abs(x) > r <=>
              a + --(&1) * x > r /\ a + &1 * x > r) /\
             (a + --(&1) * abs(x) + b > r <=>
              a + --(&1) * x + b > r /\ a + &1 * x + b > r) /\
             (a + b + --(&1) * abs(x) > r <=>
              a + b + --(&1) * x > r /\ a + b + &1 * x > r) /\
             (a + b + --(&1) * abs(x) + c > r <=>
              a + b + --(&1) * x + c > r /\ a + b + &1 * x + c > r) /\
             (--(&1) * max x y > r <=>
              --(&1) * x > r /\ --(&1) * y > r) /\
             (--(&1) * max x y + a > r <=>
              a + --(&1) * x > r /\ a + --(&1) * y > r) /\
             (a + --(&1) * max x y > r <=>
              a + --(&1) * x > r /\ a + --(&1) * y > r) /\
             (a + --(&1) * max x y + b > r <=>
              a + --(&1) * x + b > r /\ a + --(&1) * y  + b > r) /\
             (a + b + --(&1) * max x y > r <=>
              a + b + --(&1) * x > r /\ a + b + --(&1) * y > r) /\
             (a + b + --(&1) * max x y + c > r <=>
              a + b + --(&1) * x + c > r /\ a + b + --(&1) * y  + c > r) /\
             (min x y > r <=>
               x > r /\  y > r) /\
             (min x y + a > r <=>
              a + x > r /\ a + y > r) /\
             (a + min x y > r <=>
              a + x > r /\ a + y > r) /\
             (a + min x y + b > r <=>
              a + x + b > r /\ a + y  + b > r) /\
             (a + b + min x y > r <=>
              a + b + x > r /\ a + b + y > r) /\
             (a + b + min x y + c > r <=>
              a + b + x + c > r /\ a + b + y + c > r)}|
        )
      ]
    )
  let pth_abs:
    prove(
      [
        @hol|{P(abs x) <=> (x >= &0 /\ P x) \/ (&0 > x /\ P (--x))}|,
        REWRITE_TAC(PairList [real_abs, real_gt, real_ge]) then_tac \
        COND_CASES_TAC then_tac \
        ASM_REWRITE_TAC(PairList [real_lt])
      ]
    )
  let pth_max:
    prove(
      [
        @hol|{P(max x y) <=> (y >= x /\ P y) \/ (x > y /\ P x)}|,
        REWRITE_TAC(PairList [real_max, real_gt, real_ge]) then_tac \
        COND_CASES_TAC then_tac \
        ASM_REWRITE_TAC(PairList [real_lt])
      ]
    )
  let pth_min:
    prove(
      [
        @hol|{P(min x y) <=> (y >= x /\ P x) \/ (x > y /\ P y)}|,
        REWRITE_TAC(PairList [real_min, real_gt, real_ge]) then_tac \
        COND_CASES_TAC then_tac \
        ASM_REWRITE_TAC(PairList [real_lt])
      ]
    )
  let abs_tm = @hol|{real_abs}|
  let p_tm = @hol|{P:real->bool}|
  let x_tm = @hol|{x:real}|
  let y_tm = @hol|{y:real}|
  let is_max = is_binop(@hol|{real_max}|)
  let is_min = is_binop(@hol|{real_min}|)
  let is_abs = (fun(t): (is_comb(t) && (rator(t) == abs_tm)))
  let eliminate_construct:
    fun(p):
      fun(c):
        fun(tm):
          let t = find_term((fun(t): (p(t) && free_in(t)(tm))))(tm)
          let v = genvar(type_of(t))
          let th0 = SYM(BETA_CONV(mk_comb([mk_abs([v, subst(PairList [[v, t]])(tm)]), t])))
          let [p, ax] = dest_comb(rand(concl(th0)))
          CONV_RULE(RAND_CONV(BINOP_CONV(RAND_CONV(BETA_CONV))))(TRANS(th0)(c(p)(ax)))
  let elim_abs = eliminate_construct(is_abs)(fun(p): fun(ax): INST(PairList [[p, p_tm], [rand(ax), x_tm]])(pth_abs))
  let elim_max:
    eliminate_construct(is_max)(
      fun(p):
        fun(ax):
          let [ax, y] = dest_comb(ax)
          INST(PairList [[p, p_tm], [rand(ax), x_tm], [y, y_tm]])(pth_max)
    )
  let elim_min:
    eliminate_construct(is_min)(
      fun(p):
        fun(ax):
          let [ax, y] = dest_comb(ax)
          INST(PairList [[p, p_tm], [rand(ax), x_tm], [y, y_tm]])(pth_min)
    )
  let ABSMAXMIN_ELIM_CONV2 = FIRST_CONV(PairList [elim_abs, elim_max, elim_min])
  fun([mkconst, EQ, GE, GT, NORM, NEG, ADD, MUL, PROVER]):
    realarith_GEN_REAL_ARITH(
      [
        mkconst,
        EQ,
        GE,
        GT,
        NORM,
        NEG,
        ADD,
        MUL,
        ABSMAXMIN_ELIM_CONV1,
        ABSMAXMIN_ELIM_CONV2,
        PROVER
      ]
    )

def realarith_REAL_ARITH_v2:
  let [REAL_POLY_NEG_CONV, REAL_POLY_ADD_CONV, REAL_POLY_SUB_CONV, REAL_POLY_MUL_CONV, REAL_POLY_POW_CONV, REAL_POLY_CONV]:
    SEMIRING_NORMALIZERS_CONV(REAL_POLY_CLAUSES)(REAL_POLY_NEG_CLAUSES)(
      [
        is_realintconst,
        REAL_INT_ADD_CONV,
        REAL_INT_MUL_CONV,
        REAL_INT_POW_CONV
      ]
    )(fun (x): fun (y): x < y)
  realarith_GEN_REAL_ARITH_v2(
    [
      mk_realintconst,
      REAL_INT_EQ_CONV,
      REAL_INT_GE_CONV,
      REAL_INT_GT_CONV,
      REAL_POLY_CONV,
      REAL_POLY_NEG_CONV,
      REAL_POLY_ADD_CONV,
      REAL_POLY_MUL_CONV,
      REAL_LINEAR_PROVER
    ]
  )

def GEN_REAL_ARITH = realarith_GEN_REAL_ARITH_v2

def REAL_ARITH = realarith_REAL_ARITH_v2
