  let xy_nge_2 = Host.expand_quote("[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"real_ge\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]],[\"Var\",\"y\",[\"Tyapp\",\"real\",[]]]]]")
  let xy_eq_2 = Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]],[\"Var\",\"y\",[\"Tyapp\",\"real\",[]]]]")
  let xy_ne_2 = Host.expand_quote("[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]],[\"Var\",\"y\",[\"Tyapp\",\"real\",[]]]]]")
  let is_ge_2 = Basics.is_binop(ge_tm_2)
  let is_gt_2 = Basics.is_binop(gt_tm_2)
  let is_req_2 = Basics.is_binop(eq_tm_2)
  fun([mk_numeric, NUMERIC_EQ_CONV, NUMERIC_GE_CONV, NUMERIC_GT_CONV, POLY_CONV, POLY_NEG_CONV, POLY_ADD_CONV, POLY_MUL_CONV, absconv1, absconv2, prover]):
    let REAL_INEQ_CONV:
      fun(pth):
        fun(tm):
          let [lop, r] = Fusion.dest_comb(tm)
          let th = Fusion.INST(PairList.cons([Fusion.rand(lop), x_tm_2], PairList.cons([r, y_tm_2], PairList [])))(pth)
          Fusion.TRANS(th)(Equal.LAND_CONV(POLY_CONV)(Fusion.rand(Fusion.concl(th))))
    let PairList [REAL_LT_CONV_2, & PairList [REAL_LE_CONV_2, & PairList [REAL_GT_CONV_2, & PairList [REAL_GE_CONV_2, & PairList [REAL_EQ_CONV_2, & PairList [REAL_NOT_LT_CONV_2, & PairList [REAL_NOT_LE_CONV_2, & PairList [REAL_NOT_GT_CONV_2, & PairList [REAL_NOT_GE_CONV_2, & PairList [_, & PairList []]]]]]]]]]] = map(REAL_INEQ_CONV)(Bool.CONJUNCTS(pth_2))
    let pth = Host.last(Bool.CONJUNCTS(pth_2))
    let REAL_NOT_EQ_CONV_2:
      fun(tm):
        let [l, r] = Fusion.dest_eq(tm)
        let th = Fusion.INST(PairList.cons([l, x_tm_2], PairList.cons([r, y_tm_2], PairList [])))(pth)
        let th_p = POLY_CONV(Equal.lhand(Equal.lhand(Fusion.rand(Fusion.concl(th)))))
        let th_x = Equal.AP_TERM(neg_tm_2)(th_p)
        let th_n = Equal.CONV_RULE(Equal.RAND_CONV(POLY_NEG_CONV))(th_x)
        let th_prime = Drule.MK_DISJ(Equal.AP_THM(Equal.AP_TERM(gt_tm_2)(th_p))(z_tm_2))(Equal.AP_THM(Equal.AP_TERM(gt_tm_2)(th_n))(z_tm_2))
        Fusion.TRANS(th)(th_prime)
    let net_single_2 = itlist(uncurry(Simp.net_of_conv))(PairList.cons([xy_lt_2, REAL_LT_CONV_2], PairList.cons([xy_nlt_2, (fun(t): REAL_NOT_LT_CONV_2(Fusion.rand(t)))], PairList.cons([xy_le_2, REAL_LE_CONV_2], PairList.cons([xy_nle_2, (fun(t): REAL_NOT_LE_CONV_2(Fusion.rand(t)))], PairList.cons([xy_gt_2, REAL_GT_CONV_2], PairList.cons([xy_ngt_2, (fun(t): REAL_NOT_GT_CONV_2(Fusion.rand(t)))], PairList.cons([xy_ge_2, REAL_GE_CONV_2], PairList.cons([xy_nge_2, (fun(t): REAL_NOT_GE_CONV_2(Fusion.rand(t)))], PairList.cons([xy_eq_2, REAL_EQ_CONV_2], PairList.cons([xy_ne_2, (fun(t): REAL_NOT_EQ_CONV_2(Fusion.rand(t)))], PairList [])))))))))))(Nets.empty_net)
    let net_double_2 = itlist(uncurry(Simp.net_of_conv))(PairList.cons([xy_lt_2, (fun(t): [REAL_LT_CONV_2(t), REAL_NOT_LT_CONV_2(t)])], PairList.cons([xy_le_2, (fun(t): [REAL_LE_CONV_2(t), REAL_NOT_LE_CONV_2(t)])], PairList.cons([xy_gt_2, (fun(t): [REAL_GT_CONV_2(t), REAL_NOT_GT_CONV_2(t)])], PairList.cons([xy_ge_2, (fun(t): [REAL_GE_CONV_2(t), REAL_NOT_GE_CONV_2(t)])], PairList.cons([xy_eq_2, (fun(t): [REAL_EQ_CONV_2(t), REAL_NOT_EQ_CONV_2(t)])], PairList []))))))(Nets.empty_net)
    let REAL_INEQ_NORM_CONV_2 = Simp.REWRITES_CONV(net_single_2)
    let REAL_INEQ_NORM_DCONV_2 = Simp.REWRITES_CONV(net_double_2)
    let NNF_NORM_CONV = Canon.GEN_NNF_CONV(#false)([REAL_INEQ_NORM_CONV_2, REAL_INEQ_NORM_DCONV_2])
    let rules = MATCH_MP_RULE_2(pth_mul_2)
    let MUL_RULE_2 = (fun(th): Equal.CONV_RULE(Equal.LAND_CONV(POLY_MUL_CONV))(rules(th)))
    let rules = MATCH_MP_RULE_2(pth_add_2)
    let ADD_RULE_2 = (fun(th): Equal.CONV_RULE(Equal.LAND_CONV(POLY_ADD_CONV))(rules(th)))
    let rule = Drule.MATCH_MP(pth_emul_2)
    let EMUL_RULE_2 = (fun(tm): (fun(th): Equal.CONV_RULE(Equal.LAND_CONV(POLY_MUL_CONV))(Bool.SPEC(tm)(rule(th)))))
    let SQUARE_RULE_2 = (fun(t): Equal.CONV_RULE(Equal.LAND_CONV(POLY_MUL_CONV))(Bool.SPEC(t)(pth_square_2)))
    let hol_of_positivstellensatz:
      fun([eqs, les, lts]):
        fun translate(prf):
          match prf
          | realarith_ctor_Axiom_eq(n): Host.el(n)(eqs)
          | realarith_ctor_Axiom_le(n): Host.el(n)(les)
          | realarith_ctor_Axiom_lt(n): Host.el(n)(lts)
          | realarith_ctor_Rational_eq(x): Bool.EQT_ELIM(NUMERIC_EQ_CONV(Fusion.mk_comb([Fusion.mk_comb([eq_tm_2, mk_numeric(x)]), z_tm_2])))
          | realarith_ctor_Rational_le(x): Bool.EQT_ELIM(NUMERIC_GE_CONV(Fusion.mk_comb([Fusion.mk_comb([ge_tm_2, mk_numeric(x)]), z_tm_2])))
          | realarith_ctor_Rational_lt(x): Bool.EQT_ELIM(NUMERIC_GT_CONV(Fusion.mk_comb([Fusion.mk_comb([gt_tm_2, mk_numeric(x)]), z_tm_2])))
          | realarith_ctor_Square(t): SQUARE_RULE_2(t)
          | realarith_ctor_Eqmul(t,p): EMUL_RULE_2(t)(translate(p))
          | realarith_ctor_Sum(p1,p2): ADD_RULE_2(Bool.CONJ(translate(p1))(translate(p2)))
          | realarith_ctor_Product(p1,p2): MUL_RULE_2(Bool.CONJ(translate(p1))(translate(p2)))
        (fun(prf): Equal.CONV_RULE(Equal.FIRST_CONV(PairList.cons(NUMERIC_GE_CONV, PairList.cons(NUMERIC_GT_CONV, PairList.cons(NUMERIC_EQ_CONV, PairList [])))))(translate(prf)))
    let init_conv = Equal.THENC(Equal.THENC(Equal.THENC(Equal.THENC(Equal.THENC(Equal.THENC(Equal.THENC(Equal.TOP_DEPTH_CONV(Equal.BETA_CONV))(Canon.PRESIMP_CONV))(Canon.NNF_CONV))(Equal.DEPTH_BINOP_CONV(or_tm_2)(Canon.CONDS_ELIM_CONV)))(NNF_NORM_CONV))(Canon.SKOLEM_CONV))(Canon.PRENEX_CONV))(Canon.WEAK_DNF_CONV)
    fun overall(dun):
      fun(ths):
        match ths
        | PairList []:
            let [eq, ne] = partition(o(is_req_2)(Fusion.concl))(dun)
            let [le, nl] = partition(o(is_ge_2)(Fusion.concl))(ne)
            let lt = filter(o(is_gt_2)(Fusion.concl))(nl)
            prover(hol_of_positivstellensatz)([eq, le, lt])
        | PairList [th, & oths]:
            let tm = Fusion.concl(th)
            if Basics.is_conj(tm)
            | let [th1, th2] = Bool.CONJ_PAIR(th)
              overall(dun)(PairList.cons(th1, PairList.cons(th2, oths)))
            | if Basics.is_disj(tm)
              | let th1_2 = overall(dun)(PairList.cons(Fusion.ASSUME(Equal.lhand(tm)), oths))
                let th2_2 = overall(dun)(PairList.cons(Fusion.ASSUME(Fusion.rand(tm)), oths))
                Bool.DISJ_CASES(th)(th1_2)(th2_2)
              | overall(PairList.cons(th, dun))(oths)
    fun(tm):
      let NNF_NORM_CONV_prime = Canon.GEN_NNF_CONV(#false)([Equal.CACHE_CONV(REAL_INEQ_NORM_CONV_2), (fun(t): failwith(""))])
      fun absremover(t): Equal.THENC(Equal.TOP_DEPTH_CONV(Equal.THENC(absconv1)(Equal.BINOP_CONV(Equal.LAND_CONV(POLY_CONV)))))(Equal.TRY_CONV(Equal.THENC(Equal.THENC(absconv2)(NNF_NORM_CONV_prime))(Equal.BINOP_CONV(absremover))))(t)
      let th0 = init_conv(Bool.mk_neg(tm))
      let tm0 = Fusion.rand(Fusion.concl(th0))
      let th:
        if Host.hol_equal(tm0)(false_tm_2)
        | fst(Bool.EQ_IMP_RULE(th0))
        | let [evs, bod] = Basics.strip_exists(tm0)
          let [avs, ibod] = Basics.strip_forall(bod)
          let th1 = itlist(Drule.MK_FORALL)(avs)(Equal.DEPTH_BINOP_CONV(or_tm_2)(absremover)(ibod))
          let th2 = overall(PairList [])(PairList.cons(Bool.SPECL(avs)(Fusion.ASSUME(Fusion.rand(Fusion.concl(th1)))), PairList []))
          let th3 = itlist(Bool.SIMPLE_CHOOSE)(evs)(Bool.PROVE_HYP(Fusion.EQ_MP(th1)(Fusion.ASSUME(bod)))(th2))
          Bool.DISCH_ALL(Bool.PROVE_HYP(Fusion.EQ_MP(th0)(Fusion.ASSUME(Bool.mk_neg(tm))))(th3))
      Bool.MP(Fusion.INST(PairList.cons([tm, p_tm_2], PairList []))(pth_final_2))(th)

def REAL_LINEAR_PROVER:
  let linear_add_2 = Host.combine(Host.hol_add)((fun(z): Host.hol_equal(z)(Host.num_0)))
  let linear_cmul_2 = (fun(c): Host.mapf((fun(x): Host.hol_mul(c)(x))))
  let one_tm_2 = Host.expand_quote("[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"NUMERAL\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Comb\",[\"Const\",\"BIT1\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Const\",\"_0\",[\"Tyapp\",\"num\",[]]]]]]")
  let contradictory = (fun(p): (fun([e, _]): ((Host.is_undefined(e) && Host.hol_not(p(Host.num_0))) || (Host.hol_equal(Host.dom(e))(PairList.cons(one_tm_2, PairList [])) && Host.hol_not(p(Host.apply(e)(one_tm_2)))))))
  fun linear_ineqs(vars):
    fun([les, lts]):
      try:
        find(contradictory((fun(x): Host.hol_gt(x)(Host.num_0))))(lts)
        ~catch exn:
          match exn
          | Failure(_):
              try:
                find(contradictory((fun(x): Host.hol_ge(x)(Host.num_0))))(les)
                ~catch exn:
                  match exn
                  | Failure(_):
                      if Host.hol_equal(vars)(PairList [])
                      | failwith("linear_ineqs: no contradiction")
                      | let ineqs = append(les)(lts)
                        let blowup = (fun(v): Host.hol_mul(length(filter((fun([e, _]): Host.hol_gt(Host.tryapplyd(e)(v)(Host.num_0))(Host.num_0)))(ineqs)))(length(filter((fun([e, _]): Host.hol_lt(Host.tryapplyd(e)(v)(Host.num_0))(Host.num_0)))(ineqs))))
                        let v = fst(hd(sort((fun([_, i]): (fun([_, j]): Host.hol_lt(i)(j))))(map((fun(v): [v, blowup(v)]))(vars))))
                        let addup:
                          fun([e1, p1]):
                            fun([e2, p2]):
                              fun(acc):
                                let c1_2 = Host.tryapplyd(e1)(v)(Host.num_0)
                                let c2_2 = Host.tryapplyd(e2)(v)(Host.num_0)
                                if Host.hol_ge(Host.hol_mul(c1_2)(c2_2))(Host.num_0)
                                | acc
                                | let e1_prime_2 = linear_cmul_2(Host.abs_num(c2_2))(e1)
                                  let e2_prime_2 = linear_cmul_2(Host.abs_num(c1_2))(e2)
                                  let p1_prime_2 = realarith_ctor_Product(realarith_ctor_Rational_lt(Host.abs_num(c2_2)), p1)
                                  let p2_prime_2 = realarith_ctor_Product(realarith_ctor_Rational_lt(Host.abs_num(c1_2)), p2)
                                  PairList.cons([linear_add_2(e1_prime_2)(e2_prime_2), realarith_ctor_Sum(p1_prime_2, p2_prime_2)], acc)
                        let [les0_2, les1_2] = partition((fun([e, _]): Host.hol_equal(Host.tryapplyd(e)(v)(Host.num_0))(Host.num_0)))(les)
                        let [lts0_2, lts1_2] = partition((fun([e, _]): Host.hol_equal(Host.tryapplyd(e)(v)(Host.num_0))(Host.num_0)))(lts)
                        let [lesp_2, lesn_2] = partition((fun([e, _]): Host.hol_gt(Host.tryapplyd(e)(v)(Host.num_0))(Host.num_0)))(les1_2)
                        let [ltsp_2, ltsn_2] = partition((fun([e, _]): Host.hol_gt(Host.tryapplyd(e)(v)(Host.num_0))(Host.num_0)))(lts1_2)
                        let les_prime_2 = itlist((fun(ep1): itlist(addup(ep1))(lesp_2)))(lesn_2)(les0_2)
                        let lts_prime_2 = itlist((fun(ep1): itlist(addup(ep1))(append(lesp_2)(ltsp_2))))(ltsn_2)(itlist((fun(ep1): itlist(addup(ep1))(append(lesn_2)(ltsn_2))))(ltsp_2)(lts0_2))
                        linear_ineqs(subtract(vars)(PairList.cons(v, PairList [])))([les_prime_2, lts_prime_2])
                  | exn: Host.hol_raise(exn)
          | exn: Host.hol_raise(exn)
  fun linear_eqs([eqs, les, lts]):
    try:
      find(contradictory((fun(x): Host.hol_equal(x)(Host.num_0))))(eqs)
      ~catch exn:
        match exn
        | Failure(_):
            match eqs
            | PairList []:
                let vars = subtract(itlist(o(o(union)(Host.dom))(fst))(append(les)(lts))(PairList []))(PairList.cons(one_tm_2, PairList []))
                linear_ineqs(vars)([les, lts])
            | PairList [[e, p], & es]:
                if Host.is_undefined(e)
                | linear_eqs([es, les, lts])
                | let [x, c] = Host.choose(Host.undefine(one_tm_2)(e))
                  let xform:
                    fun([t, q] as inp):
                      let d = Host.tryapplyd(t)(x)(Host.num_0)
                      if Host.hol_equal(d)(Host.num_0)
                      | inp
                      | let k = Host.hol_rat_div(Host.hol_mul(Host.minus_num(d))(Host.abs_num(c)))(c)
                        let e_prime_2 = linear_cmul_2(k)(e)
                        let t_prime_2 = linear_cmul_2(Host.abs_num(c))(t)
                        let p_prime_2 = realarith_ctor_Eqmul(CalcInt.term_of_rat(k), p)
                        let q_prime_2 = realarith_ctor_Product(realarith_ctor_Rational_lt(Host.abs_num(c)), q)
                        [linear_add_2(e_prime_2)(t_prime_2), realarith_ctor_Sum(p_prime_2, q_prime_2)]
                  linear_eqs([map(xform)(es), map(xform)(les), map(xform)(lts)])
        | exn: Host.hol_raise(exn)
  let linear_prover:
    fun([eq, le, lt]):
      let eqs_2 = Host.map2((fun(p): (fun(n): [p, realarith_ctor_Axiom_eq(n)])))(eq)(Host.hol_range(0)(Host.hol_sub(length(eq))(1)))
      let les_2 = Host.map2((fun(p): (fun(n): [p, realarith_ctor_Axiom_le(n)])))(le)(Host.hol_range(0)(Host.hol_sub(length(le))(1)))
      let lts_2 = Host.map2((fun(p): (fun(n): [p, realarith_ctor_Axiom_lt(n)])))(lt)(Host.hol_range(0)(Host.hol_sub(length(lt))(1)))
      linear_eqs([eqs_2, les_2, lts_2])
  let one_tm_3 = Host.expand_quote("[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"NUMERAL\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Comb\",[\"Const\",\"BIT1\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Const\",\"_0\",[\"Tyapp\",\"num\",[]]]]]]")
  let zero_tm_2 = Host.expand_quote("[\"Comb\",[\"Const\",\"real_of_num\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Const\",\"NUMERAL\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Const\",\"_0\",[\"Tyapp\",\"num\",[]]]]]")
  let add_tm_2 = Host.expand_quote("[\"Const\",\"real_add\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]]]]")
  let mul_tm_2 = Host.expand_quote("[\"Const\",\"real_mul\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"real\",[]]]]]]]")
  fun lin_of_hol_2(tm):
    if Host.hol_equal(tm)(zero_tm_2)
    | Host.undefined
    | if Host.hol_not(Fusion.is_comb(tm))
      | Host.fpf_singleton(tm)(Host.num(1))
      | if CalcInt.is_ratconst(tm)
        | Host.fpf_singleton(one_tm_3)(CalcInt.rat_of_term(tm))
        | let [lop, r] = Fusion.dest_comb(tm)
          if Host.hol_not(Fusion.is_comb(lop))
          | Host.fpf_singleton(tm)(Host.num(1))
          | let [op, l] = Fusion.dest_comb(lop)
            if Host.hol_equal(op)(add_tm_2)
            | linear_add_2(lin_of_hol_2(l))(lin_of_hol_2(r))
            | (if (Host.hol_equal(op)(mul_tm_2) && CalcInt.is_ratconst(l)) | Host.fpf_singleton(r)(CalcInt.rat_of_term(l)) | Host.fpf_singleton(tm)(Host.num(1)))
  let lin_of_hol = lin_of_hol_2
  let is_alien:
    fun(tm):
      match tm
      | Fusion.Comb(Fusion.Const("real_of_num",_),n):
          if Host.hol_not(Nums.is_numeral(n))
          | #true
          | match tm
            | _: #false
      | _: #false
  let is_suc_alien:
    fun(tm):
      match tm
      | Fusion.Comb(Fusion.Const("real_of_num",_),Fusion.Comb(Fusion.Const("SUC",_),_)): #true
      | _: #false
  let dest_suc_alien:
    fun(tm):
      match tm
      | Fusion.Comb(Fusion.Const("real_of_num",_),Fusion.Comb(Fusion.Const("SUC",_),n)): n
      | _: failwith("")
  let n_tm = Host.expand_quote("[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]")
  let pth = Simp.REWRITE_RULE(PairList.cons(Equal.GSYM(Realax.real_ge), PairList []))(Bool.SPEC(n_tm)(REAL_POS))
  let pth_suc = Simp.REWRITE_RULE(PairList.cons(Equal.GSYM(Realax.real_gt), PairList []))(Bool.SPEC(n_tm)(REAL_POS_LT))
  fun(translator):
    fun([eq, le, lt]):
      let eq_pols_2 = map(o(o(lin_of_hol)(Equal.lhand))(Fusion.concl))(eq)
      let le_pols_2 = map(o(o(lin_of_hol)(Equal.lhand))(Fusion.concl))(le)
      let lt_pols_2 = map(o(o(lin_of_hol)(Equal.lhand))(Fusion.concl))(lt)
      let all_aliens = filter(is_alien)(itlist(o(union)(Host.dom))(append(eq_pols_2)(append(le_pols_2)(lt_pols_2)))(PairList []))
      let [suc_aliens, aliens] = partition(is_suc_alien)(all_aliens)
      let le_pols_prime = append(le_pols_2)(map((fun(v): Host.fpf_singleton(v)(Host.num(1))))(aliens))
      let lt_pols_prime = append(lt_pols_2)(map((fun(v): Host.fpf_singleton(v)(Host.num(1))))(suc_aliens))
      let [_, proof] = linear_prover([eq_pols_2, le_pols_prime, lt_pols_prime])
      let le_prime = append(le)(map((fun(a): Fusion.INST(PairList.cons([Fusion.rand(a), n_tm], PairList []))(pth)))(aliens))
      let lt_prime = append(lt)(map((fun(a): Fusion.INST(PairList.cons([dest_suc_alien(a), n_tm], PairList []))(pth_suc)))(suc_aliens))
      translator([eq, le_prime, lt_prime])(proof)

