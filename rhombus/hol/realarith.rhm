def realarith_REAL_LTE_TOTAL:«
  Up_tactics.prove((block:«
    let port_tmp_1 = (block:«
      let port_tmp_2 = Up_tactics.CONV_TAC(Up_class.TAUT);
      let port_tmp_3 = Up_simp.REWRITE_TAC(PairList.cons(Up_realax.real_lt,PairList []));
      let port_tmp_4 = Up_tactics.THEN;
      port_tmp_4(port_tmp_3)(port_tmp_2)
    »);
    let port_tmp_5 = Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"y\",[\"Tyapp\",\"real\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"real_lt\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]],[\"Var\",\"y\",[\"Tyapp\",\"real\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"real_le\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"real\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"y\",[\"Tyapp\",\"real\",[]]]],[\"Var\",\"x\",[\"Tyapp\",\"real\",[]]]]]]]]]");
    Pair(port_tmp_5,port_tmp_1)
  »))
»

