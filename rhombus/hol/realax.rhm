def NADD_DIST:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         const dest_nadd :: nadd -> num -> num
         forall x :: nadd:
           exists B :: num:
             forall (m :: num, n :: num):
               dist(#{|,|}(dest_nadd(x, m), dest_nadd(x, n))) <= B * dist(#{|,|}(m, n))),
      (
        (
          (
            (
              (
