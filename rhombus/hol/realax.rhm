def real_tybij:
  define_quotient_type(
    "real")(
    ["mk_real", "dest_real"])(
    Host.hol_term(Const(
      "treal_eq",
      Fun(
        Tyapp("prod", [Tyapp("hreal", []), Tyapp("hreal", [])]),
        Fun(Tyapp("prod", [Tyapp("hreal", []), Tyapp("hreal", [])]), Bool)
      )
    ))
  )

def [realax_real_of_num_v2, real_of_num_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_of_num")(TREAL_OF_NUM_WELLDEF)

def [realax_real_neg_v2, real_neg_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_neg")(TREAL_NEG_WELLDEF)

def [realax_real_add_v2, real_add_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_add")(TREAL_ADD_WELLDEF)

def [realax_real_mul_v2, real_mul_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_mul")(TREAL_MUL_WELLDEF)

def [realax_real_le_v2, real_le_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_le")(TREAL_LE_WELLDEF)

def [realax_real_inv_v2, real_inv_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_inv")(TREAL_INV_WELLDEF)

