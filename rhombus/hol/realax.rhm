Host.parse_as_prefix("--")

Host.parse_as_infix(["/", [22, "left"]])

Host.parse_as_infix(["pow", [24, "left"]])

def initialization_6:
  do_list(TypeInference.overload_interface)(
    PairList [
      ["+", (hol: const real_add :: real -> real -> real; real_add)],
      ["-", (hol: var real_sub :: real -> real -> real; real_sub)],
      ["*", (hol: const real_mul :: real -> real -> real; real_mul)],
      ["/", (hol: var real_div :: real -> real -> real; real_div)],
      ["<", (hol: var real_lt :: real -> real -> bool; real_lt)],
      ["<=", (hol: const real_le :: real -> real -> bool; real_le)],
      [">", (hol: var real_gt :: real -> real -> bool; real_gt)],
      [">=", (hol: var real_ge :: real -> real -> bool; real_ge)],
      ["--", (hol: const real_neg :: real -> real; real_neg)],
      ["pow", (hol: var real_pow :: real -> num -> real; real_pow)],
      ["inv", (hol: const real_inv :: real -> real; real_inv)],
      ["abs", (hol: var real_abs :: real -> real; real_abs)],
      ["max", (hol: var real_max :: real -> real -> real; real_max)],
      ["min", (hol: var real_min :: real -> real -> real; real_min)],
      ["&", (hol: const real_of_num :: num -> real; real_of_num)]
    ]
  )

fun prioritize_real(_): TypeInference.prioritize_overload(mk_type(["real", PairList []]))

def real_sub:
  new_definition(
    (hol:
       var real_sub :: real -> real -> real
       var x :: real
       var y :: real
       real_sub(x, y) == x + -y)
  )

def real_lt:
  new_definition(
    (hol:
       var real_lt :: real -> real -> bool
       var x :: real
       var y :: real
       real_lt(x, y) <=> !(y <= x))
  )

def real_ge:
  new_definition(
    (hol:
       var real_ge :: real -> real -> bool
       var x :: real
       var y :: real
       real_ge(x, y) <=> y <= x)
  )

def real_gt:
  new_definition(
    (hol:
       var real_gt :: real -> real -> bool
       var x :: real
       var y :: real
       real_gt(x, y) <=> y < x)
  )

def real_abs:
  new_definition(
    (hol:
       var real_abs :: real -> real
       var x :: real
       real_abs(x) == (if (0 :: real) <= x | x | -x))
  )

def real_pow:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var real_pow :: real -> num -> real
       var x :: real
       const SUC :: num -> num
       real_pow(x, (0 :: num)) == (1 :: real)
         && (forall n :: num: real_pow(x, SUC(n)) == x * real_pow(x, n)))
  )

def real_div:
  new_definition(
    (hol:
       var real_div :: real -> real -> real
       var x :: real
       var y :: real
       const real_inv :: real -> real
       real_div(x, y) == x * real_inv(y))
  )

def real_max:
  new_definition(
    (hol:
       var real_max :: real -> real -> real
       var m :: real
       var n :: real
       real_max(m, n) == (if m <= n | n | m))
  )

def real_min:
  new_definition(
    (hol:
       var real_min :: real -> real -> real
       var m :: real
       var n :: real
       real_min(m, n) == (if m <= n | m | n))
  )

def REAL_HREAL_LEMMA1:
  prove(
    [
      (hol:
         const hreal_le :: hreal -> hreal -> bool
         exists r :: hreal -> real:
           (forall x :: real: (0 :: real) <= x <=> (exists y :: hreal: x == r(y)))
             && (forall (y :: hreal, z :: hreal): hreal_le(y, z) <=> r(y) <= r(z))),
      (
        (
          (
            (
              (
                EXISTS_TAC(
                  (hol:
                     const mk_real :: (pair(hreal, hreal) -> bool) -> real
                     const treal_eq :: pair(hreal, hreal) -> pair(hreal, hreal) -> bool
                     const #{|,|} :: hreal -> hreal -> pair(hreal, hreal)
                     const hreal_of_num :: num -> hreal
                     fun (y :: hreal): mk_real(treal_eq(#{|,|}(y, hreal_of_num((0 :: num))))))
                ) then_tac \
                REWRITE_TAC(PairList [GSYM(real_le_th)])
              ) then_tac \
              REWRITE_TAC(PairList [treal_le, realax_HREAL_ADD_LID_v2, HREAL_ADD_RID])
            ) then_tac \
            GEN_TAC
          ) then_tac \
          EQ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            (
                                              (
                                                MP_TAC(
                                                  INST(
                                                    PairList [
                                                      [
                                                        (hol:
                                                           var x :: real
                                                           const dest_real :: real -> pair(hreal, hreal) -> bool
                                                           dest_real(x)),
                                                        (hol: var r :: pair(hreal, hreal) -> bool; r)
                                                      ]
                                                    ]
                                                  )(snd(real_tybij))
                                                ) then_tac \
                                                REWRITE_TAC(PairList [fst(real_tybij)])
                                              ) then_tac \
                                              DISCH_THEN(
                                                X_CHOOSE_THEN(hol: var p :: pair(hreal, hreal); p)(MP_TAC)
                                              )
                                            ) then_tac \
                                            DISCH_THEN(
                                              o(MP_TAC)(
                                                AP_TERM(
                                                  (hol: const mk_real :: (pair(hreal, hreal) -> bool) -> real; mk_real)
                                                )
                                              )
                                            )
                                          ) then_tac \
                                          REWRITE_TAC(PairList [fst(real_tybij)])
                                        ) then_tac \
                                        DISCH_THEN(SUBST1_TAC)
                                      ) then_tac \
                                      REWRITE_TAC(PairList [GSYM(real_of_num_th), GSYM(real_le_th)])
                                    ) then_tac \
                                    SUBST1_TAC(
                                      GSYM(
                                        ISPEC(hol: var p :: pair(hreal, hreal); p)(PAIR)
                                      )
                                    )
                                  ) then_tac \
                                  PURE_REWRITE_TAC(PairList [treal_of_num, treal_le])
                                ) then_tac \
                                PURE_REWRITE_TAC(PairList [realax_HREAL_ADD_LID_v2, HREAL_ADD_RID])
                              ) then_tac \
                              DISCH_THEN(
                                o(X_CHOOSE_THEN(hol: var d :: hreal; d)(SUBST1_TAC))(MATCH_MP(realax_HREAL_LE_EXISTS_v2))
                              )
                            ) then_tac \
                            EXISTS_TAC(hol: var d :: hreal; d)
