              (FIRST_ASSUM(MATCH_MP_TAC) then_tac ASM_REWRITE_TAC(PairList [])),
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        ASM_REWRITE_TAC(PairList [nadd_le, NADD_ADD, NADD_MUL, NADD_OF_NUM]) then_tac \
                                        ONCE_REWRITE_TAC(PairList [ADD_SYM])
                                      ) then_tac \
                                      REWRITE_TAC(PairList [ADD1, RIGHT_ADD_DISTRIB])
                                    ) then_tac \
                                    REWRITE_TAC(PairList [MULT_2, MULT_CLAUSES, ADD_ASSOC, LE_ADD_RCANCEL])
                                  ) then_tac \
                                  REWRITE_TAC(PairList [GSYM(ADD_ASSOC)])
                                ) then_tac \
                                ONCE_REWRITE_TAC(PairList [ADD_SYM])
                              ) then_tac \
                              ONCE_REWRITE_TAC(PairList [BOUNDS_IGNORE])
                            ) then_tac \
                            MAP_EVERY(EXISTS_TAC)(
                              PairList [
                                @hol|{0}|,
                                @hol|{n:num}|
                              ]
                            )
