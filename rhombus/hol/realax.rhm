def NADD_UBOUND:
  prove(
    [
      (hol:
         const dest_nadd :: nadd -> num -> num
         forall x :: nadd:
           exists (B :: num, N :: num): forall n :: num: N <= n ==> dest_nadd(x, n) <= B * n),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          GEN_TAC then_tac \
                          X_CHOOSE_THEN(hol: var A1 :: num; A1)(X_CHOOSE_TAC(hol: var A2 :: num; A2))(SPEC(hol: var x :: nadd; x)(NADD_BOUND))
                        ) then_tac \
                        EXISTS_TAC(hol:
                                     var A1 :: num
                                     var A2 :: num
                                     A1 + A2)
                      ) then_tac \
                      EXISTS_TAC(
                        (hol:
                           (1 :: num))
                      )
                    ) then_tac \
                    REPEAT(STRIP_TAC)
                  ) then_tac \
                  MATCH_MP_TAC(LE_TRANS)
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     var A1 :: num
                     var n :: num
                     var A2 :: num
                     A1 * n + A2)
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, LE_ADD_LCANCEL])
          ) then_tac \
          GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(el(3)(CONJUNCTS(MULT_CLAUSES)))])
        ) then_tac \
        ASM_REWRITE_TAC(PairList [LE_MULT_LCANCEL])
      )
    ]
  )

def NADD_NONZERO:
  prove(
    [
      (hol:
         const nadd_eq :: nadd -> nadd -> bool
         const nadd_of_num :: num -> nadd
         const dest_nadd :: nadd -> num -> num
         forall x :: nadd:
           !nadd_eq(x, nadd_of_num((0 :: num)))
             ==> (exists N :: num: forall n :: num: N <= n ==> dest_nadd(x, n) != (0 :: num))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (GEN_TAC then_tac DISCH_THEN(o(MP_TAC)(MATCH_MP(NADD_ARCH_MULT)))) then_tac \
                          DISCH_THEN(
                            o(MP_TAC)(
                              SPEC(
                                (hol:
                                   (1 :: num))
                              )
                            )
                          )
                        ) then_tac \
                        REWRITE_TAC(PairList [nadd_le, NADD_MUL, NADD_OF_NUM, MULT_CLAUSES])
                      ) then_tac \
                      DISCH_THEN(
                        X_CHOOSE_THEN(hol: var A1 :: num; A1)(X_CHOOSE_TAC(hol: var A2 :: num; A2))
                      )
                    ) then_tac \
                    EXISTS_TAC(
                      (hol:
                         var A2 :: num
                         A2 + (1 :: num))
                    )
                  ) then_tac \
                  X_GEN_TAC(hol: var n :: num; n)
                ) then_tac \
                REPEAT(DISCH_TAC)
              ) then_tac \
              FIRST_ASSUM(o(o(UNDISCH_TAC)(check(is_forall)))(concl))
            ) then_tac \
            REWRITE_TAC(PairList [NOT_FORALL_THM, NOT_LE, GSYM(LE_SUC_LT), ADD1])
          ) then_tac \
          EXISTS_TAC(hol: var n :: num; n)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES])
      )
    ]
  )

def NADD_LBOUND:
  prove(
    [
      (hol:
