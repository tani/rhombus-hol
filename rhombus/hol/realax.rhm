def NADD_COMPLETE:
  prove(
    [
      @hol|{!P. (?x. P x) /\ (?M. !x. P x ==> x <<= M) ==>
         ?M. (!x. P x ==> x <<= M) /\
             !M'. (!x. P x ==> x <<= M') ==> M <<= M'}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          GEN_TAC then_tac \
                          DISCH_THEN(
                            CONJUNCTS_THEN2(X_CHOOSE_TAC(@hol|{a:nadd}|))(X_CHOOSE_TAC(@hol|{m:nadd}|))
                          )
                        ) then_tac \
                        SUBGOAL_THEN(
                          @hol|{!n. ?r. (?x. P x /\ &r <<= &n ** x) /\
                             !r'. (?x. P x /\ &r' <<= &n ** x) ==> r' <= r}|
                        )(MP_TAC)
                      ) then_list \
                      PairList [
                        (
                          (
                            (GEN_TAC then_tac REWRITE_TAC(PairList [GSYM(num_MAX)])) then_tac \
                            CONJ_TAC
                          ) then_list \
                          PairList [
                            (
                              MAP_EVERY(EXISTS_TAC)(
                                PairList [
                                  @hol|{0}|,
                                  @hol|{a:nadd}|
                                ]
                              ) then_tac \
                              ASM_REWRITE_TAC(PairList [NADD_LE_0])
                            ),
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            (
                                              (
                                                (
                                                  X_CHOOSE_TAC(@hol|{N:num}|)(SPEC(@hol|{m:nadd}|)(NADD_ARCH)) then_tac \
                                                  EXISTS_TAC(@hol|{n * N}|)
                                                ) then_tac \
                                                X_GEN_TAC(@hol|{p:num}|)
                                              ) then_tac \
                                              DISCH_THEN(X_CHOOSE_THEN(@hol|{w:nadd}|)(STRIP_ASSUME_TAC))
                                            ) then_tac \
                                            ONCE_REWRITE_TAC(PairList [GSYM(NADD_OF_NUM_LE)])
                                          ) then_tac \
                                          MATCH_MP_TAC(NADD_LE_TRANS)
                                        ) then_tac \
                                        EXISTS_TAC(
                                          @hol|{&n ** w}|
                                        )
                                      ) then_tac \
                                      ASM_REWRITE_TAC(PairList [])
                                    ) then_tac \
                                    MATCH_MP_TAC(NADD_LE_TRANS)
                                  ) then_tac \
                                  EXISTS_TAC(
                                    @hol|{&n ** &N}|
                                  )
                                ) then_tac \
                                CONJ_TAC
                              ) then_list \
                              PairList [
                                (
                                  (
                                    (
                                      (
                                        (MATCH_MP_TAC(NADD_LE_LMUL) then_tac MATCH_MP_TAC(NADD_LE_TRANS)) then_tac \
                                        EXISTS_TAC(@hol|{m:nadd}|)
                                      ) then_tac \
                                      ASM_REWRITE_TAC(PairList [])
                                    ) then_tac \
                                    FIRST_ASSUM(MATCH_MP_TAC)
                                  ) then_tac \
                                  ASM_REWRITE_TAC(PairList [])
                                ),
                                (MATCH_MP_TAC(NADD_EQ_IMP_LE) then_tac MATCH_ACCEPT_TAC(NADD_OF_NUM_MUL))
                              ]
                            )
                          ]
                        ),
                        (
                          (
                            (
                              (
                                (
                                  ONCE_REWRITE_TAC(PairList [SKOLEM_THM]) then_tac \
                                  DISCH_THEN(
                                    X_CHOOSE_THEN(@hol|{r:num->num}|)(
                                      fun(th):
                                        let [th1, th2] = CONJ_PAIR(SPEC(@hol|{n:num}|)(th))
                                        MAP_EVERY(o(MP_TAC)(GEN(@hol|{n:num}|)))(PairList [th1, th2])
                                    )
                                  )
                                ) then_tac \
                                DISCH_THEN(
                                  o(o(MP_TAC)(GEN(@hol|{n:num}|)))(
                                    SPECL(
                                      PairList [
                                        @hol|{n:num}|,
                                        @hol|{SUC(r(n:num))}|
