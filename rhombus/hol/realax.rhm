    let port_tmp_6 = Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"dist\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]],[\"Tyapp\",\"num\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]],[\"Comb\",[\"Const\",\"NUMERAL\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Const\",\"_0\",[\"Tyapp\",\"num\",[]]]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]]");
