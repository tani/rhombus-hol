def nadd_inv:
  new_definition(
    (hol:
       var nadd_inv :: nadd -> nadd
       var x :: nadd
       const nadd_eq :: nadd -> nadd -> bool
       const nadd_of_num :: num -> nadd
       const mk_nadd :: (num -> num) -> nadd
       const nadd_rinv :: nadd -> num -> num
       nadd_inv(x)
         == (if nadd_eq(x, nadd_of_num((0 :: num))) | nadd_of_num((0 :: num)) | mk_nadd(nadd_rinv(x))))
  )

TypeInference.override_interface(["inv", (hol: const nadd_inv :: nadd -> nadd; nadd_inv)])

def NADD_INV:
  prove(
    [
      (hol:
         const dest_nadd :: nadd -> num -> num
         const nadd_inv :: nadd -> nadd
         const nadd_eq :: nadd -> nadd -> bool
         const nadd_of_num :: num -> nadd
         const nadd_rinv :: nadd -> num -> num
         forall x :: nadd:
           dest_nadd(nadd_inv(x))
             == (if nadd_eq(x, nadd_of_num((0 :: num))) | fun (n :: num): (0 :: num) | nadd_rinv(x))),
      (
        (
          (
            (
              (
                (GEN_TAC then_tac REWRITE_TAC(PairList [nadd_inv])) then_tac \
                ASM_CASES_TAC(
                  (hol:
                     var x :: nadd
                     const nadd_eq :: nadd -> nadd -> bool
                     const nadd_of_num :: num -> nadd
                     nadd_eq(x, nadd_of_num((0 :: num))))
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [NADD_OF_NUM, MULT_CLAUSES])
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(nadd_rep), is_nadd])
          ) then_tac \
          MATCH_MP_TAC(NADD_MUL_LINV_LEMMA8)
        ) then_tac \
        POP_ASSUM(ACCEPT_TAC)
      )
    ]
  )

