def initialization_1:
  do_list(TypeInference.overload_interface)(
    PairList [
      ["+", (hol: const #{+} :: num -> num -> num; #{+})],
      ["-", (hol: (#{-} :: num -> num -> num))],
      ["*", (hol: const #{*} :: num -> num -> num; #{*})],
      ["<", (hol: const #{<} :: num -> num -> bool; #{<})],
      ["<=", (hol: const #{<=} :: num -> num -> bool; #{<=})],
      [">", (hol: const #{>} :: num -> num -> bool; #{>})],
      [">=", (hol: const #{>=} :: num -> num -> bool; #{>=})]
    ]
  )

fun prioritize_num(_): TypeInference.prioritize_overload(mk_type(["num", PairList []]))

def dist:
  new_definition(
    (hol:
       var dist :: pair(num, num) -> num
       var m :: num
       var n :: num
       const #{|,|} :: num -> num -> pair(num, num)
       dist(#{|,|}(m, n)) == m - n + (n - m))
  )

def DIST_REFL:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall n :: num: dist(#{|,|}(n, n)) == (0 :: num)),
      REWRITE_TAC(PairList [dist, SUB_REFL, ADD_CLAUSES])
    ]
  )

def DIST_LZERO:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall n :: num: dist(#{|,|}((0 :: num), n)) == n),
      REWRITE_TAC(PairList [dist, SUB_0, ADD_CLAUSES])
    ]
  )

def DIST_RZERO:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall n :: num: dist(#{|,|}(n, (0 :: num))) == n),
      REWRITE_TAC(PairList [dist, SUB_0, ADD_CLAUSES])
    ]
  )

def DIST_SYM:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall (m :: num, n :: num): dist(#{|,|}(m, n)) == dist(#{|,|}(n, m))),
      (REWRITE_TAC(PairList [dist]) then_tac MATCH_ACCEPT_TAC(ADD_SYM))
    ]
  )

def DIST_LADD:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall (m :: num, p :: num, n :: num): dist(#{|,|}(m + n, m + p)) == dist(#{|,|}(n, p))),
      REWRITE_TAC(PairList [dist, SUB_ADD_LCANCEL])
    ]
  )

def DIST_RADD:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall (m :: num, p :: num, n :: num): dist(#{|,|}(m + p, n + p)) == dist(#{|,|}(m, n))),
      REWRITE_TAC(PairList [dist, SUB_ADD_RCANCEL])
    ]
  )

def DIST_LADD_0:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall (m :: num, n :: num): dist(#{|,|}(m + n, m)) == n),
      REWRITE_TAC(PairList [dist, ADD_SUB2, ADD_SUBR2, ADD_CLAUSES])
    ]
  )

def DIST_RADD_0:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall (m :: num, n :: num): dist(#{|,|}(m, m + n)) == n),
      (ONCE_REWRITE_TAC(PairList [DIST_SYM]) then_tac MATCH_ACCEPT_TAC(DIST_LADD_0))
    ]
  )

def DIST_LMUL:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall (m :: num, n :: num, p :: num): m * dist(#{|,|}(n, p)) == dist(#{|,|}(m * n, m * p))),
      REWRITE_TAC(PairList [dist, LEFT_ADD_DISTRIB, LEFT_SUB_DISTRIB])
    ]
  )

def DIST_RMUL:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall (m :: num, n :: num, p :: num): dist(#{|,|}(m, n)) * p == dist(#{|,|}(m * p, n * p))),
      REWRITE_TAC(PairList [dist, RIGHT_ADD_DISTRIB, RIGHT_SUB_DISTRIB])
    ]
  )

def DIST_EQ_0:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall (m :: num, n :: num): dist(#{|,|}(m, n)) == (0 :: num) <=> m == n),
      REWRITE_TAC(PairList [dist, ADD_EQ_0, SUB_EQ_0, LE_ANTISYM])
    ]
  )

def DIST_ELIM_THM:
  prove(
    [
      (hol:
         var P :: num -> bool
         var x :: num
         var y :: num
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         P(dist(#{|,|}(x, y))) <=> (forall d :: num: (x == y + d ==> P(d)) && (y == x + d ==> P(d)))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              DISJ_CASES_TAC(
                                SPECL(PairList [(hol: var x :: num; x), (hol: var y :: num; y)])(LE_CASES)
                              ) then_tac \
                              POP_ASSUM(
                                o(X_CHOOSE_THEN(hol: var e :: num; e)(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))
                              )
                            ) then_tac \
                            REWRITE_TAC(PairList [dist, ADD_SUB, ADD_SUB2, ADD_SUBR, ADD_SUBR2])
                          ) then_tac \
                          REWRITE_TAC(PairList [ADD_CLAUSES, EQ_ADD_LCANCEL])
                        ) then_tac \
                        GEN_REWRITE_TAC(o(RAND_CONV)(ONCE_DEPTH_CONV))(PairList [EQ_SYM_EQ])
                      ) then_tac \
                      REWRITE_TAC(PairList [GSYM(ADD_ASSOC), EQ_ADD_LCANCEL_0, ADD_EQ_0])
                    ) then_tac \
                    ASM_CASES_TAC(
                      (hol:
                         var e :: num
                         e == (0 :: num))
                    )
                  ) then_tac \
                  ASM_REWRITE_TAC(PairList [])
                ) then_tac \
                EQ_TAC
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          FIRST_ASSUM(MATCH_MP_TAC)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def [realax_DIST_LE_CASES_v2, realax_DIST_ADDBOUND_v2, realax_DIST_TRIANGLE_v2, realax_DIST_ADD2_v2, DIST_ADD2_REV]:
  let conv = HIGHER_REWRITE_CONV(PairList [SUB_ELIM_THM, COND_ELIM_THM, DIST_ELIM_THM])(#false)
  let DIST_ELIM_TAC:
    (
      ((CONV_TAC(conv) then_tac TRY(GEN_TAC)) then_tac CONJ_TAC) then_tac \
      DISCH_THEN(
        fun(th):
          let [l, r] = dest_eq(concl(th))
          (
            SUBST_ALL_TAC(th) then_tac \
            (if (is_var(l) && !vfree_in(l)(r)) | ALL_TAC | ASSUME_TAC(th))
          )
      )
    )
  let DIST_ELIM_TAC_prime:
    (
      (
        (
          (
            (
              (REPEAT(STRIP_TAC) then_tac REPEAT(DIST_ELIM_TAC)) then_tac \
              REWRITE_TAC(PairList [GSYM(NOT_LT), LT_EXISTS])
            ) then_tac \
            DISCH_THEN(CHOOSE_THEN(SUBST_ALL_TAC))
          ) then_tac \
          POP_ASSUM(MP_TAC)
        ) then_tac \
        CONV_TAC(LAND_CONV(NUM_CANCEL_CONV))
      ) then_tac \
      REWRITE_TAC(PairList [ADD_CLAUSES, NOT_SUC])
    )
  let DIST_LE_CASES_2:
    prove(
      [
        (hol:
           const dist :: pair(num, num) -> num
           const #{|,|} :: num -> num -> pair(num, num)
           forall (m :: num, n :: num, p :: num): dist(#{|,|}(m, n)) <= p <=> m <= n + p && n <= m + p),
        (
          (REPEAT(GEN_TAC) then_tac REPEAT(DIST_ELIM_TAC)) then_tac \
          REWRITE_TAC(PairList [GSYM(ADD_ASSOC), LE_ADD, LE_ADD_LCANCEL])
        )
      ]
    )
  let DIST_ADDBOUND_2:
    prove(
      [
        (hol:
           const dist :: pair(num, num) -> num
           const #{|,|} :: num -> num -> pair(num, num)
           forall (m :: num, n :: num): dist(#{|,|}(m, n)) <= m + n),
        (
          (
            (REPEAT(GEN_TAC) then_tac DIST_ELIM_TAC) then_list \
            PairList [ONCE_REWRITE_TAC(PairList [ADD_SYM]), ALL_TAC]
          ) then_tac \
          REWRITE_TAC(PairList [ADD_ASSOC, LE_ADDR])
        )
      ]
    )
  let PairList [DIST_TRIANGLE_2, & PairList [DIST_ADD2_2, & PairList [DIST_ADD2_REV_2, & PairList []]]]:
    o(CONJUNCTS)(prove)(
      [
        (hol:
           const dist :: pair(num, num) -> num
           const #{|,|} :: num -> num -> pair(num, num)
           (forall (m :: num, n :: num, p :: num):
              dist(#{|,|}(m, p)) <= dist(#{|,|}(m, n)) + dist(#{|,|}(n, p)))
             && ((forall (m :: num, n :: num, p :: num, q :: num):
                    dist(#{|,|}(m + n, p + q)) <= dist(#{|,|}(m, p)) + dist(#{|,|}(n, q)))
                   && (forall (m :: num, n :: num, p :: num, q :: num):
                         dist(#{|,|}(m, p)) <= dist(#{|,|}(m + n, p + q)) + dist(#{|,|}(n, q))))),
        DIST_ELIM_TAC_prime
      ]
    )
  [DIST_LE_CASES_2, DIST_ADDBOUND_2, DIST_TRIANGLE_2, DIST_ADD2_2, DIST_ADD2_REV_2]

def DIST_TRIANGLE_LE:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall (m :: num, n :: num, p :: num, q :: num):
           dist(#{|,|}(m, n)) + dist(#{|,|}(n, p)) <= q ==> dist(#{|,|}(m, p)) <= q),
      (
        (
          (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(LE_TRANS)) then_tac \
          EXISTS_TAC(
            (hol:
               var m :: num
               var n :: num
               var p :: num
               const dist :: pair(num, num) -> num
               const #{|,|} :: num -> num -> pair(num, num)
               dist(#{|,|}(m, n)) + dist(#{|,|}(n, p)))
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList [realax_DIST_TRIANGLE_v2])
      )
    ]
  )

def DIST_TRIANGLES_LE:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         forall (m :: num, n :: num, p :: num, q :: num, r :: num, s :: num):
           dist(#{|,|}(m, n)) <= r && dist(#{|,|}(p, q)) <= s
             ==> dist(#{|,|}(m, p)) <= dist(#{|,|}(n, q)) + (r + s)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(DIST_TRIANGLE_LE)) then_tac \
                            EXISTS_TAC(hol: var n :: num; n)
                          ) then_tac \
                          GEN_REWRITE_TAC(RAND_CONV)(PairList [ADD_SYM])
                        ) then_tac \
                        REWRITE_TAC(PairList [GSYM(ADD_ASSOC)])
                      ) then_tac \
                      MATCH_MP_TAC(LE_ADD2)
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_tac \
                  MATCH_MP_TAC(DIST_TRIANGLE_LE)
                ) then_tac \
                EXISTS_TAC(hol: var q :: num; q)
              ) then_tac \
              GEN_REWRITE_TAC(RAND_CONV)(PairList [ADD_SYM])
            ) then_tac \
            REWRITE_TAC(PairList [LE_ADD_LCANCEL])
          ) then_tac \
          ONCE_REWRITE_TAC(PairList [DIST_SYM])
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def BOUNDS_LINEAR:
  prove(
    [
      (hol:
         forall (A :: num, B :: num, C :: num): (forall n :: num: A * n <= B * n + C) <=> A <= B),
      (
        (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (CONV_TAC(CONTRAPOS_CONV) then_tac REWRITE_TAC(PairList [NOT_LE])) then_tac \
                    DISCH_THEN(o(CHOOSE_THEN(SUBST1_TAC))(REWRITE_RULE(PairList [LT_EXISTS])))
                  ) then_tac \
                  REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, LE_ADD_LCANCEL])
                ) then_tac \
                DISCH_THEN(o(MP_TAC)(SPEC(hol:
                                            var C :: num
                                            const SUC :: num -> num
                                            SUC(C))))
              ) then_tac \
              REWRITE_TAC(PairList [NOT_LE, MULT_CLAUSES, ADD_CLAUSES, LT_SUC_LE])
            ) then_tac \
            REWRITE_TAC(PairList [ADD_ASSOC, LE_ADDR])
          ),
          (
            DISCH_THEN(o(CHOOSE_THEN(SUBST1_TAC))(REWRITE_RULE(PairList [LE_EXISTS]))) then_tac \
            REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, GSYM(ADD_ASSOC), LE_ADD])
          )
        ]
      )
    ]
  )

def BOUNDS_LINEAR_0:
  prove(
    [
      (hol:
         forall (A :: num, B :: num): (forall n :: num: A * n <= B) <=> A == (0 :: num)),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          MP_TAC(
            SPECL(
              PairList [
                (hol: var A :: num; A),
                (hol:
                   (0 :: num)),
                (hol: var B :: num; B)
              ])(
              BOUNDS_LINEAR
            )
          )
        ) then_tac \
        REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES, LE])
      )
    ]
  )

def BOUNDS_DIVIDED:
  prove(
    [
      (hol:
         forall P :: num -> num:
           (exists B :: num: forall n :: num: P(n) <= B)
             <=> (exists (A :: num, B :: num): forall n :: num: n * P(n) <= A * n + B)),
      (
        ((GEN_TAC then_tac EQ_TAC) then_tac STRIP_TAC) then_list \
        PairList [
          (
            (
              (
                (
                  MAP_EVERY(EXISTS_TAC)(
                    PairList [
                      (hol: var B :: num; B),
                      (hol:
                         (0 :: num))
                    ]
                  ) then_tac \
                  GEN_TAC
                ) then_tac \
                REWRITE_TAC(PairList [ADD_CLAUSES])
              ) then_tac \
              GEN_REWRITE_TAC(RAND_CONV)(PairList [MULT_SYM])
            ) then_tac \
            ASM_REWRITE_TAC(PairList [LE_MULT_LCANCEL])
          ),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            (
                                              (
                                                EXISTS_TAC(
                                                  (hol:
                                                     var P :: num -> num
                                                     var A :: num
                                                     var B :: num
                                                     P((0 :: num)) + (A + B))
                                                ) then_tac \
                                                GEN_TAC
                                              ) then_tac \
                                              MP_TAC(
                                                SPECL(
                                                  PairList [
                                                    (hol: var n :: num; n),
                                                    (hol:
                                                       var P :: num -> num
                                                       var n :: num
                                                       P(n)),
                                                    (hol:
                                                       var P :: num -> num
                                                       var A :: num
                                                       var B :: num
                                                       P((0 :: num)) + (A + B))
                                                  ])(
                                                  LE_MULT_LCANCEL
                                                )
                                              )
                                            ) then_tac \
                                            ASM_CASES_TAC(
                                              (hol:
                                                 var n :: num
                                                 n == (0 :: num))
                                            )
                                          ) then_tac \
                                          ASM_REWRITE_TAC(PairList [LE_ADD])
                                        ) then_tac \
                                        DISCH_THEN(o(SUBST1_TAC)(SYM))
                                      ) then_tac \
                                      MATCH_MP_TAC(LE_TRANS)
                                    ) then_tac \
                                    EXISTS_TAC(
                                      (hol:
                                         var A :: num
                                         var n :: num
                                         var B :: num
                                         A * n + B)
                                    )
                                  ) then_tac \
                                  ASM_REWRITE_TAC(PairList [])
                                ) then_tac \
                                REWRITE_TAC(PairList [LEFT_ADD_DISTRIB])
                              ) then_tac \
                              GEN_REWRITE_TAC(RAND_CONV)(PairList [ADD_SYM])
                            ) then_tac \
                            GEN_REWRITE_TAC(o(RAND_CONV)(ONCE_DEPTH_CONV))(PairList [MULT_SYM])
                          ) then_tac \
                          REWRITE_TAC(PairList [GSYM(ADD_ASSOC), LE_ADD_LCANCEL])
                        ) then_tac \
                        MATCH_MP_TAC(LE_TRANS)
                      ) then_tac \
                      EXISTS_TAC(hol:
                                   var B :: num
                                   var n :: num
                                   B * n)
                    ) then_tac \
                    REWRITE_TAC(PairList [LE_ADD])
                  ) then_tac \
                  UNDISCH_TAC(
                    (hol:
                       var n :: num
                       n != (0 :: num))
                  )
                ) then_tac \
                SPEC_TAC([(hol: var n :: num; n), (hol: var n :: num; n)])
              ) then_tac \
              INDUCT_TAC
            ) then_tac \
            ASM_REWRITE_TAC(PairList [MULT_CLAUSES, LE_ADD])
          )
        ]
      )
    ]
  )

def BOUNDS_NOTZERO:
  prove(
    [
      (hol:
         forall (P :: num -> num -> num, A :: num, B :: num):
           (P((0 :: num), (0 :: num)) == (0 :: num)
              && (forall (m :: num, n :: num): P(m, n) <= A * (m + n) + B))
             ==> (exists B :: num: forall (m :: num, n :: num): P(m, n) <= B * (m + n))),
      (
        (
          (
            (
              REPEAT(STRIP_TAC) then_tac \
              EXISTS_TAC(hol:
                           var A :: num
                           var B :: num
                           A + B)
            ) then_tac \
            REPEAT(GEN_TAC)
          ) then_tac \
          ASM_CASES_TAC(
            (hol:
               var m :: num
               var n :: num
               m + n == (0 :: num))
          )
        ) then_list \
        PairList [
          (
            RULE_ASSUM_TAC(REWRITE_RULE(PairList [ADD_EQ_0])) then_tac \
            ASM_REWRITE_TAC(PairList [LE_0])
          ),
          (
            (
              (
                (
                  (
                    (
                      (
                        MATCH_MP_TAC(LE_TRANS) then_tac \
                        EXISTS_TAC(
                          (hol:
                             var A :: num
                             var m :: num
                             var n :: num
                             var B :: num
                             A * (m + n) + B)
                        )
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_tac \
                    REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, LE_ADD_LCANCEL])
                  ) then_tac \
                  UNDISCH_TAC(
                    (hol:
                       var m :: num
                       var n :: num
                       m + n != (0 :: num))
                  )
                ) then_tac \
                SPEC_TAC(
                  [
                    (hol:
                       var m :: num
                       var n :: num
                       m + n),
                    (hol: var p :: num; p)
                  ]
                )
              ) then_tac \
              INDUCT_TAC
            ) then_tac \
            REWRITE_TAC(PairList [MULT_CLAUSES, LE_ADD])
          )
        ]
      )
    ]
  )

def BOUNDS_IGNORE:
  prove(
    [
      (hol:
         forall (P :: num -> num, Q :: num -> num):
           (exists B :: num: forall i :: num: P(i) <= Q(i) + B)
             <=> (exists (B :: num, N :: num): forall i :: num: N <= i ==> P(i) <= Q(i) + B)),
      (
        ((REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac STRIP_TAC) then_list \
        PairList [
          (EXISTS_TAC(hol: var B :: num; B) then_tac ASM_REWRITE_TAC(PairList [])),
          (
            (
              (
                (
                  POP_ASSUM(MP_TAC) then_tac \
                  SPEC_TAC([(hol: var B :: num; B), (hol: var B :: num; B)])
                ) then_tac \
                SPEC_TAC([(hol: var N :: num; N), (hol: var N :: num; N)])
              ) then_tac \
              INDUCT_TAC
            ) then_list \
            PairList [
              (
                (
                  ((REWRITE_TAC(PairList [LE_0]) then_tac GEN_TAC) then_tac DISCH_TAC) then_tac \
                  EXISTS_TAC(hol: var B :: num; B)
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ),
              (
                (
                  (
                    (
                      (
                        ((GEN_TAC then_tac DISCH_TAC) then_tac FIRST_ASSUM(MATCH_MP_TAC)) then_tac \
                        EXISTS_TAC(
                          (hol:
                             var B :: num
                             var P :: num -> num
                             var N :: num
                             B + P(N))
                        )
                      ) then_tac \
                      X_GEN_TAC(hol: var i :: num; i)
                    ) then_tac \
                    DISCH_TAC
                  ) then_tac \
                  ASM_CASES_TAC(
                    (hol:
                       var N :: num
                       var i :: num
                       const SUC :: num -> num
                       SUC(N) <= i)
                  )
                ) then_list \
                PairList [
                  (
                    (
                      (
                        (
                          MATCH_MP_TAC(LE_TRANS) then_tac \
                          EXISTS_TAC(
                            (hol:
                               var Q :: num -> num
                               var i :: num
                               var B :: num
                               Q(i) + B)
                          )
                        ) then_tac \
                        REWRITE_TAC(PairList [LE_ADD, ADD_ASSOC])
                      ) then_tac \
                      FIRST_ASSUM(MATCH_MP_TAC)
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ),
                  (
                    (
                      (
                        (
                          (
                            (
                              UNDISCH_TAC(
                                (hol:
                                   var N :: num
                                   var i :: num
                                   const SUC :: num -> num
                                   !(SUC(N) <= i))
                              ) then_tac \
                              REWRITE_TAC(PairList [NOT_LE, LT])
                            ) then_tac \
                            ASM_REWRITE_TAC(PairList [GSYM(NOT_LE)])
                          ) then_tac \
                          DISCH_THEN(SUBST1_TAC)
                        ) then_tac \
                        REWRITE_TAC(PairList [ADD_ASSOC])
                      ) then_tac \
                      ONCE_REWRITE_TAC(PairList [ADD_SYM])
                    ) then_tac \
                    REWRITE_TAC(PairList [LE_ADD])
                  )
                ]
              )
            ]
          )
        ]
      )
    ]
  )

def is_nadd:
  new_definition(
    (hol:
       var is_nadd :: (num -> num) -> bool
       var x :: num -> num
       const dist :: pair(num, num) -> num
       const #{|,|} :: num -> num -> pair(num, num)
       is_nadd(x)
         <=> (exists B :: num:
                forall (m :: num, n :: num): dist(#{|,|}(m * x(n), n * x(m))) <= B * (m + n)))
  )

def is_nadd_0:
  prove(
    [
      (hol:
         const is_nadd :: (num -> num) -> bool
         is_nadd(fun (n :: num): (0 :: num))),
      REWRITE_TAC(PairList [is_nadd, MULT_CLAUSES, DIST_REFL, LE_0])
    ]
  )

def [realax_nadd_abs_v2, nadd_rep] = new_basic_type_definition("nadd")(["mk_nadd", "dest_nadd"])(is_nadd_0)

TypeInference.override_interface(["fn", (hol: const dest_nadd :: nadd -> num -> num; dest_nadd)])

TypeInference.override_interface(["afn", (hol: const mk_nadd :: (num -> num) -> nadd; mk_nadd)])

def NADD_CAUCHY:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         const dest_nadd :: nadd -> num -> num
         forall x :: nadd:
           exists B :: num:
             forall (m :: num, n :: num):
               dist(#{|,|}(m * dest_nadd(x, n), n * dest_nadd(x, m))) <= B * (m + n)),
      REWRITE_TAC(PairList [GSYM(is_nadd), nadd_rep, realax_nadd_abs_v2, ETA_AX])
    ]
  )

def NADD_BOUND:
  prove(
    [
      (hol:
         const dest_nadd :: nadd -> num -> num
         forall x :: nadd: exists (A :: num, B :: num): forall n :: num: dest_nadd(x, n) <= A * n + B),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      GEN_TAC then_tac \
                      X_CHOOSE_TAC(hol: var B :: num; B)(SPEC(hol: var x :: nadd; x)(NADD_CAUCHY))
                    ) then_tac \
                    MAP_EVERY(EXISTS_TAC)(
                      PairList [
                        (hol:
                           var B :: num
                           var x :: nadd
                           const dest_nadd :: nadd -> num -> num
                           B + dest_nadd(x, (1 :: num))),
                        (hol: var B :: num; B)
                      ]
                    )
                  ) then_tac \
                  GEN_TAC
                ) then_tac \
                POP_ASSUM(
                  o(MP_TAC)(
                    SPECL(
                      PairList [
                        (hol: var n :: num; n),
                        (hol:
                           (1 :: num))
                      ]
                    )
                  )
                )
              ) then_tac \
              REWRITE_TAC(PairList [realax_DIST_LE_CASES_v2, MULT_CLAUSES])
            ) then_tac \
            DISCH_THEN(o(MP_TAC)(CONJUNCT2))
          ) then_tac \
          REWRITE_TAC(PairList [LEFT_ADD_DISTRIB, RIGHT_ADD_DISTRIB, MULT_CLAUSES])
        ) then_tac \
        REWRITE_TAC(PairList [ADD_AC, MULT_AC])
      )
    ]
  )

def NADD_MULTIPLICATIVE:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         const dest_nadd :: nadd -> num -> num
         forall x :: nadd:
           exists B :: num:
             forall (m :: num, n :: num):
               dist(#{|,|}(dest_nadd(x, m * n), m * dest_nadd(x, n))) <= B * m + B),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              GEN_TAC then_tac \
                              X_CHOOSE_TAC(hol: var B :: num; B)(SPEC(hol: var x :: nadd; x)(NADD_CAUCHY))
                            ) then_tac \
                            EXISTS_TAC(
                              (hol:
                                 var B :: num
                                 var x :: nadd
                                 const dest_nadd :: nadd -> num -> num
                                 B + dest_nadd(x, (0 :: num)))
                            )
                          ) then_tac \
                          REPEAT(GEN_TAC)
                        ) then_tac \
                        ASM_CASES_TAC(
                          (hol:
                             var n :: num
                             n == (0 :: num))
                        )
                      ) then_list \
                      PairList [
                        (
                          (
                            (
                              (
                                MATCH_MP_TAC(LE_IMP(realax_DIST_ADDBOUND_v2)) then_tac \
                                ASM_REWRITE_TAC(PairList [MULT_CLAUSES, RIGHT_ADD_DISTRIB, MULT_AC])
                              ) then_tac \
                              REWRITE_TAC(PairList [LE_EXISTS])
                            ) then_tac \
                            CONV_TAC(ONCE_DEPTH_CONV(NUM_CANCEL_CONV))
                          ) then_tac \
                          REWRITE_TAC(PairList [GSYM(EXISTS_REFL)])
                        ),
                        UNDISCH_TAC(
                          (hol:
                             var n :: num
                             n != (0 :: num))
                        )
                      ]
                    ) then_tac \
                    REWRITE_TAC(
                      PairList [
                        TAUT(
                          (hol:
                             var a :: bool
                             var b :: bool
