               var x :: nadd
               const dist :: pair(num, num) -> num
               const #{|,|} :: num -> num -> pair(num, num)
               const dest_nadd :: nadd -> num -> num
               const nadd_rinv :: nadd -> num -> num
               exists (A2 :: num, B2 :: num):
                 forall n :: num: dist(#{|,|}(dest_nadd(x, n) * nadd_rinv(x, n), n * n)) <= A2 * n + B2)
