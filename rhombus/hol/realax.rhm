Host.parse_as_infix(["treal_le", [12, "right"]])

Host.parse_as_infix(["treal_eq", [10, "right"]])

TypeInference.make_overloadable("+")(Host.hol_term(Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))))

TypeInference.make_overloadable("-")(Host.hol_term(Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))))

TypeInference.make_overloadable("*")(Host.hol_term(Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))))

TypeInference.make_overloadable("/")(Host.hol_term(Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))))

TypeInference.make_overloadable("<")(Host.hol_term(Fun(Tvar("A"), Fun(Tvar("A"), Bool))))

TypeInference.make_overloadable("<=")(Host.hol_term(Fun(Tvar("A"), Fun(Tvar("A"), Bool))))

TypeInference.make_overloadable(">")(Host.hol_term(Fun(Tvar("A"), Fun(Tvar("A"), Bool))))

TypeInference.make_overloadable(">=")(Host.hol_term(Fun(Tvar("A"), Fun(Tvar("A"), Bool))))

TypeInference.make_overloadable("--")(Host.hol_term(Fun(Tvar("A"), Tvar("A"))))

TypeInference.make_overloadable("pow")(Host.hol_term(Fun(Tvar("A"), Fun(Num, Tvar("A")))))

TypeInference.make_overloadable("inv")(Host.hol_term(Fun(Tvar("A"), Tvar("A"))))

TypeInference.make_overloadable("abs")(Host.hol_term(Fun(Tvar("A"), Tvar("A"))))

TypeInference.make_overloadable("max")(Host.hol_term(Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))))

TypeInference.make_overloadable("min")(Host.hol_term(Fun(Tvar("A"), Fun(Tvar("A"), Tvar("A")))))

TypeInference.make_overloadable("&")(Host.hol_term(Fun(Num, Tvar("A"))))

def initialization_1:
  Host.do_list(TypeInference.overload_interface)(
    PairList [
      ["+", Host.hol_term(Const("+", Fun(Num, Fun(Num, Num))))],
      ["-", Host.hol_term(Const("-", Fun(Num, Fun(Num, Num))))],
      ["*", Host.hol_term(Const("*", Fun(Num, Fun(Num, Num))))],
      ["<", Host.hol_term(Const("<", Fun(Num, Fun(Num, Bool))))],
      ["<=", Host.hol_term(Const("<=", Fun(Num, Fun(Num, Bool))))],
      [">", Host.hol_term(Const(">", Fun(Num, Fun(Num, Bool))))],
      [">=", Host.hol_term(Const(">=", Fun(Num, Fun(Num, Bool))))]
    ]
  )

fun prioritize_num(_): TypeInference.prioritize_overload(mk_type(["num", PairList []]))

def dist:
  new_definition(
    Host.hol_term(Eq(
      Num,
      App(
        Var("dist", Fun(Tyapp("prod", [Num, Num]), Num)),
        [App(Const(",", Fun(Num, Fun(Num, Tyapp("prod", [Num, Num])))), [Var("m", Num), Var("n", Num)])]
      ),
      App(
        Const("+", Fun(Num, Fun(Num, Num))),
        [
          App(Const("-", Fun(Num, Fun(Num, Num))), [Var("m", Num), Var("n", Num)]),
          App(Const("-", Fun(Num, Fun(Num, Num))), [Var("n", Num), Var("m", Num)])
        ]
      )
    ))
  )

def DIST_REFL:
  prove(
    [
      Host.hol_term(Forall(
        "n",
        Num,
        Eq(
          Num,
          App(
            Const("dist", Fun(Tyapp("prod", [Num, Num]), Num)),
            [App(Const(",", Fun(Num, Fun(Num, Tyapp("prod", [Num, Num])))), [Ref("n"), Ref("n")])]
          ),
          App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])
        )
      )),
      REWRITE_TAC(PairList [dist, SUB_REFL, ADD_CLAUSES])
    ]
  )

def DIST_LZERO:
  prove(
    [
      Host.hol_term(Forall(
        "n",
        Num,
        Eq(
          Num,
          App(
            Const("dist", Fun(Tyapp("prod", [Num, Num]), Num)),
            [
              App(
                Const(",", Fun(Num, Fun(Num, Tyapp("prod", [Num, Num])))),
                [App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]), Ref("n")]
              )
            ]
          ),
          Ref("n")
        )
      )),
      REWRITE_TAC(PairList [dist, SUB_0, ADD_CLAUSES])
    ]
  )

