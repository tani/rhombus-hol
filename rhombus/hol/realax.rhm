      )
    ]
  )

def TREAL_ADD_WELLDEF:
  prove(
    [
      @hol|{!x1 x2 y1 y2. x1 treal_eq x2 /\ y1 treal_eq y2 ==>
         (x1 treal_add y1) treal_eq (x2 treal_add y2)}|,
      (
        (
          (
            (
              (
                (
                  (REPEAT(GEN_TAC) then_tac DISCH_TAC) then_tac \
                  MATCH_MP_TAC(TREAL_EQ_TRANS)
                ) then_tac \
                EXISTS_TAC(
                  @hol|{x1 treal_add y2}|
                )
              ) then_tac \
              CONJ_TAC
            ) then_list \
            PairList [ONCE_REWRITE_TAC(PairList [TREAL_ADD_SYM_EQ]), ALL_TAC]
          ) then_tac \
          MATCH_MP_TAC(TREAL_ADD_WELLDEFR)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def TREAL_MUL_WELLDEFR:
  prove(
    [
      @hol|{!x1 x2 y. x1 treal_eq x2 ==> (x1 treal_mul y) treal_eq (x2 treal_mul y)}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REWRITE_TAC(PairList [FORALL_PAIR_THM, treal_mul, treal_eq]) then_tac \
                        REPEAT(GEN_TAC)
                      ) then_tac \
                      ONCE_REWRITE_TAC(
                        PairList [
                          AC(HREAL_ADD_AC)(
                            @hol|{(a + b) + (c + d) = (a + d) + (b + c)}|
                          )
                        ]
                      )
                    ) then_tac \
                    REWRITE_TAC(PairList [GSYM(HREAL_ADD_RDISTRIB)])
                  ) then_tac \
                  DISCH_TAC
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              AP_TERM_TAC
            ) then_tac \
            ONCE_REWRITE_TAC(PairList [realax_HREAL_ADD_SYM_v2])
          ) then_tac \
          POP_ASSUM(SUBST1_TAC)
        ) then_tac \
        REFL_TAC
      )
    ]
  )

def TREAL_MUL_WELLDEF:
  prove(
    [
      @hol|{!x1 x2 y1 y2. x1 treal_eq x2 /\ y1 treal_eq y2 ==>
         (x1 treal_mul y1) treal_eq (x2 treal_mul y2)}|,
      (
        (
          (
            (
              (
                (
                  (REPEAT(GEN_TAC) then_tac DISCH_TAC) then_tac \
                  MATCH_MP_TAC(TREAL_EQ_TRANS)
                ) then_tac \
                EXISTS_TAC(
                  @hol|{x1 treal_mul y2}|
                )
              ) then_tac \
              CONJ_TAC
            ) then_list \
            PairList [ONCE_REWRITE_TAC(PairList [TREAL_MUL_SYM_EQ]), ALL_TAC]
          ) then_tac \
          MATCH_MP_TAC(TREAL_MUL_WELLDEFR)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def TREAL_EQ_IMP_LE:
  prove(
    [
      @hol|{!x y. x treal_eq y ==> x treal_le y}|,
      SIMP_TAC(PairList [FORALL_PAIR_THM, treal_eq, treal_le, realax_HREAL_LE_REFL_v2])
    ]
  )

def TREAL_LE_WELLDEF:
  prove(
    [
      @hol|{!x1 x2 y1 y2. x1 treal_eq x2 /\ y1 treal_eq y2 ==>
         (x1 treal_le y1 <=> x2 treal_le y2)}|,
      (
        (
          REPEAT((STRIP_TAC or_tac EQ_TAC)) then_list \
          PairList [
            (
              (
                (
                  MATCH_MP_TAC(TREAL_LE_TRANS) then_tac \
                  EXISTS_TAC(@hol|{y1:hreal#hreal}|)
                ) then_tac \
                CONJ_TAC
              ) then_list \
              PairList [
                (
                  (
                    (
                      (
                        MATCH_MP_TAC(TREAL_LE_TRANS) then_tac \
                        EXISTS_TAC(@hol|{x1:hreal#hreal}|)
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_tac \
                    MATCH_MP_TAC(TREAL_EQ_IMP_LE)
                  ) then_tac \
                  ONCE_REWRITE_TAC(PairList [TREAL_EQ_SYM])
                ),
                MATCH_MP_TAC(TREAL_EQ_IMP_LE)
              ]
            ),
            (
              (
                (
                  MATCH_MP_TAC(TREAL_LE_TRANS) then_tac \
                  EXISTS_TAC(@hol|{y2:hreal#hreal}|)
                ) then_tac \
                CONJ_TAC
              ) then_list \
              PairList [
                (
                  (
                    (
                      MATCH_MP_TAC(TREAL_LE_TRANS) then_tac \
                      EXISTS_TAC(@hol|{x2:hreal#hreal}|)
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_tac \
                  MATCH_MP_TAC(TREAL_EQ_IMP_LE)
                ),
                (MATCH_MP_TAC(TREAL_EQ_IMP_LE) then_tac ONCE_REWRITE_TAC(PairList [TREAL_EQ_SYM]))
              ]
            )
          ]
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def TREAL_INV_WELLDEF:
  let lemma:
    prove(
      [
        @hol|{(@d. x = x + d) = &0}|,
        (
          (
            (
              ((MATCH_MP_TAC(SELECT_UNIQUE) then_tac BETA_TAC) then_tac GEN_TAC) then_tac \
              GEN_REWRITE_TAC(funpow(2)(LAND_CONV))(PairList [GSYM(HREAL_ADD_RID)])
            ) then_tac \
            REWRITE_TAC(PairList [HREAL_EQ_ADD_LCANCEL])
          ) then_tac \
          MATCH_ACCEPT_TAC(EQ_SYM_EQ)
        )
      ]
    )
  prove(
    [
      @hol|{!x y. x treal_eq y ==> (treal_inv x) treal_eq (treal_inv y)}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                REWRITE_TAC(PairList [FORALL_PAIR_THM]) then_tac \
                                MAP_EVERY(X_GEN_TAC)(
                                  PairList [
                                    @hol|{x1:hreal}|,
                                    @hol|{x2:hreal}|,
                                    @hol|{y1:hreal}|,
                                    @hol|{y2:hreal}|
                                  ]
                                )
                              ) then_tac \
                              PURE_REWRITE_TAC(PairList [treal_eq, treal_inv])
                            ) then_tac \
                            ASM_CASES_TAC(
                              @hol|{x1 :hreal = x2}|
                            )
                          ) then_tac \
                          ASM_CASES_TAC(
                            @hol|{y1 :hreal = y2}|
                          )
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [])
                      ) then_tac \
                      REWRITE_TAC(PairList [TREAL_EQ_REFL])
                    ) then_tac \
                    DISCH_THEN(o(MP_TAC)(GEN_REWRITE_RULE(RAND_CONV)(PairList [realax_HREAL_ADD_SYM_v2])))
                  ) then_tac \
                  REWRITE_TAC(PairList [HREAL_EQ_ADD_LCANCEL, HREAL_EQ_ADD_RCANCEL])
                ) then_tac \
                DISCH_TAC
              ) then_tac \
              ASM_REWRITE_TAC(PairList [realax_HREAL_LE_REFL_v2, lemma, HREAL_INV_0, TREAL_EQ_REFL])
            ) then_tac \
            ASM_CASES_TAC(
              @hol|{x2 <= x1}|
            )
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        FIRST_ASSUM(
                          o(o(o(ASSUME_TAC)(SYM))(SELECT_RULE))(MATCH_MP(realax_HREAL_LE_EXISTS_v2))
                        ) then_tac \
                        UNDISCH_TAC(
                          @hol|{x1 + y2 = x2 + y1}|
                        )
                      ) then_tac \
                      FIRST_ASSUM(o(SUBST1_TAC)(SYM))
                    ) then_tac \
                    REWRITE_TAC(PairList [HREAL_EQ_ADD_LCANCEL, GSYM(realax_HREAL_ADD_ASSOC_v2)])
                  ) then_tac \
                  DISCH_THEN(o(SUBST1_TAC)(SYM))
                ) then_tac \
                REWRITE_TAC(PairList [ONCE_REWRITE_RULE(PairList [realax_HREAL_ADD_SYM_v2])(realax_HREAL_LE_ADD_v2)])
              ) then_tac \
              GEN_REWRITE_TAC(
                o(o(o(o(RAND_CONV)(LAND_CONV))(RAND_CONV))(BINDER_CONV))(LAND_CONV))(
                PairList [realax_HREAL_ADD_SYM_v2]
              )
            ) then_tac \
            REWRITE_TAC(PairList [HREAL_EQ_ADD_LCANCEL, TREAL_EQ_REFL])
          ),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              DISJ_CASES_THEN(MP_TAC)(
                                SPECL(
                                  PairList [
                                    @hol|{x1:hreal}|,
                                    @hol|{x2:hreal}|
                                  ])(
                                  realax_HREAL_LE_TOTAL_v2
                                )
                              ) then_tac \
                              ASM_REWRITE_TAC(PairList [])
                            ) then_tac \
                            DISCH_TAC
                          ) then_tac \
                          FIRST_ASSUM(
