def NADD_ARCH_MULT:
  prove(
    [
      (hol:
         const nadd_eq :: nadd -> nadd -> bool
         const nadd_of_num :: num -> nadd
         const nadd_le :: nadd -> nadd -> bool
         const nadd_mul :: nadd -> nadd -> nadd
         forall (x :: nadd, k :: num):
           !nadd_eq(x, nadd_of_num((0 :: num)))
             ==> (exists N :: num: nadd_le(nadd_of_num(k), nadd_mul(nadd_of_num(N), x)))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            (
                                              (
                                                (
                                                  (
                                                    REPEAT(GEN_TAC) then_tac \
                                                    REWRITE_TAC(PairList [nadd_eq, nadd_le, NOT_EXISTS_THM])
                                                  ) then_tac \
                                                  X_CHOOSE_TAC(hol: var B :: num; B)(SPEC(hol: var x :: nadd; x)(NADD_CAUCHY))
                                                ) then_tac \
                                                DISCH_THEN(
                                                  o(MP_TAC)(
                                                    SPEC(hol:
                                                           var B :: num
                                                           var k :: num
                                                           B + k)
                                                  )
                                                )
                                              ) then_tac \
                                              REWRITE_TAC(PairList [NOT_FORALL_THM, NADD_OF_NUM])
                                            ) then_tac \
                                            REWRITE_TAC(PairList [MULT_CLAUSES, DIST_RZERO, NOT_LE])
                                          ) then_tac \
                                          DISCH_THEN(X_CHOOSE_TAC(hol: var N :: num; N))
                                        ) then_tac \
                                        MAP_EVERY(EXISTS_TAC)(
                                          PairList [
                                            (hol: var N :: num; N),
                                            (hol:
                                               var B :: num
                                               var N :: num
                                               B * N)
                                          ]
                                        )
                                      ) then_tac \
                                      X_GEN_TAC(hol: var i :: num; i)
                                    ) then_tac \
                                    REWRITE_TAC(PairList [NADD_MUL, NADD_OF_NUM])
                                  ) then_tac \
                                  MATCH_MP_TAC(GEN_ALL(fst(EQ_IMP_RULE(SPEC_ALL(LE_ADD_RCANCEL)))))
                                ) then_tac \
                                EXISTS_TAC(hol:
                                             var B :: num
                                             var i :: num
                                             B * i)
                              ) then_tac \
                              REWRITE_TAC(PairList [GSYM(ADD_ASSOC), GSYM(LEFT_ADD_DISTRIB)])
                            ) then_tac \
                            MATCH_MP_TAC(LE_TRANS)
                          ) then_tac \
                          EXISTS_TAC(
                            (hol:
                               var i :: num
                               var x :: nadd
                               var N :: num
                               const dest_nadd :: nadd -> num -> num
                               i * dest_nadd(x, N))
                          )
                        ) then_tac \
                        RULE_ASSUM_TAC(REWRITE_RULE(PairList [realax_DIST_LE_CASES_v2]))
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_tac \
                    REWRITE_TAC(PairList [GSYM(RIGHT_ADD_DISTRIB)])
                  ) then_tac \
                  GEN_REWRITE_TAC(RAND_CONV)(PairList [MULT_SYM])
                ) then_tac \
                REWRITE_TAC(PairList [LE_MULT_RCANCEL])
              ) then_tac \
              DISJ1_TAC
            ) then_tac \
            MATCH_MP_TAC(LT_IMP_LE)
          ) then_tac \
          ONCE_REWRITE_TAC(PairList [ADD_SYM])
        ) then_tac \
        FIRST_ASSUM(ACCEPT_TAC)
      )
    ]
  )

def NADD_ARCH_ZERO:
  prove(
    [
      (hol:
         const nadd_le :: nadd -> nadd -> bool
         const nadd_mul :: nadd -> nadd -> nadd
         const nadd_of_num :: num -> nadd
         const nadd_eq :: nadd -> nadd -> bool
         forall (x :: nadd, k :: nadd):
           (forall n :: num: nadd_le(nadd_mul(nadd_of_num(n), x), k))
             ==> nadd_eq(x, nadd_of_num((0 :: num)))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (REPEAT(GEN_TAC) then_tac CONV_TAC(CONTRAPOS_CONV)) then_tac \
                                    DISCH_TAC
                                  ) then_tac \
                                  REWRITE_TAC(PairList [NOT_FORALL_THM])
                                ) then_tac \
                                X_CHOOSE_TAC(hol: var p :: num; p)(SPEC(hol: var k :: nadd; k)(NADD_ARCH))
                              ) then_tac \
                              FIRST_ASSUM(o(MP_TAC)(MATCH_MP(NADD_ARCH_MULT)))
                            ) then_tac \
                            DISCH_THEN(o(X_CHOOSE_TAC(hol: var N :: num; N))(SPEC(hol: var p :: num; p)))
                          ) then_tac \
                          EXISTS_TAC(
                            (hol:
                               var N :: num
                               N + (1 :: num))
                          )
                        ) then_tac \
                        DISCH_TAC
                      ) then_tac \
                      UNDISCH_TAC(
                        (hol:
                           var x :: nadd
                           const nadd_eq :: nadd -> nadd -> bool
                           const nadd_of_num :: num -> nadd
                           !nadd_eq(x, nadd_of_num((0 :: num))))
                      )
                    ) then_tac \
                    REWRITE_TAC(PairList [GSYM(NADD_LE_ANTISYM), NADD_LE_0])
                  ) then_tac \
                  MATCH_MP_TAC(GEN_ALL(fst(EQ_IMP_RULE(SPEC_ALL(NADD_LE_RADD)))))
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     var N :: num
                     var x :: nadd
                     const nadd_mul :: nadd -> nadd -> nadd
                     const nadd_of_num :: num -> nadd
                     nadd_mul(nadd_of_num(N), x))
                )
              ) then_tac \
              MATCH_MP_TAC(NADD_LE_TRANS)
            ) then_tac \
            EXISTS_TAC(hol: var k :: nadd; k)
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            SUBGOAL_THEN(
              (hol:
                 var N :: num
                 var x :: nadd
                 const nadd_eq :: nadd -> nadd -> bool
                 const nadd_mul :: nadd -> nadd -> nadd
                 const nadd_of_num :: num -> nadd
                 const nadd_add :: nadd -> nadd -> nadd
                 nadd_eq(nadd_mul(nadd_of_num(N + (1 :: num)), x), nadd_add(x, nadd_mul(nadd_of_num(N), x))))
            )(MP_TAC) then_list \
            PairList [
              (
                (
                  (
                    (ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac MATCH_MP_TAC(NADD_EQ_TRANS)) then_tac \
                    EXISTS_TAC(
                      (hol:
                         var x :: nadd
                         var N :: num
                         const nadd_add :: nadd -> nadd -> nadd
                         const nadd_mul :: nadd -> nadd -> nadd
                         const nadd_of_num :: num -> nadd
                         nadd_add(nadd_mul(nadd_of_num((1 :: num)), x), nadd_mul(nadd_of_num(N), x)))
                    )
                  ) then_tac \
                  CONJ_TAC
                ) then_list \
                PairList [
                  (
                    (
                      (
                        MATCH_MP_TAC(NADD_EQ_TRANS) then_tac \
                        EXISTS_TAC(
                          (hol:
                             var N :: num
                             var x :: nadd
                             const nadd_mul :: nadd -> nadd -> nadd
                             const nadd_add :: nadd -> nadd -> nadd
                             const nadd_of_num :: num -> nadd
                             nadd_mul(nadd_add(nadd_of_num((1 :: num)), nadd_of_num(N)), x))
                        )
                      ) then_tac \
                      CONJ_TAC
                    ) then_list \
                    PairList [
                      MESON_TAC(PairList [NADD_OF_NUM_ADD, NADD_MUL_WELLDEF, NADD_EQ_REFL, NADD_EQ_SYM]),
                      MESON_TAC(PairList [NADD_RDISTRIB, NADD_MUL_SYM, NADD_EQ_SYM, NADD_EQ_TRANS])
                    ]
                  ),
                  MESON_TAC(PairList [NADD_ADD_WELLDEF, NADD_EQ_REFL, NADD_MUL_LID])
                ]
              ),
              ASM_MESON_TAC(PairList [NADD_LE_WELLDEF, NADD_EQ_REFL])
            ]
          ),
          ASM_MESON_TAC(PairList [NADD_LE_TRANS, NADD_LE_WELLDEF, NADD_EQ_REFL, NADD_ADD_LID])
        ]
      )
    ]
  )

def NADD_ARCH_LEMMA:
  prove(
    [
      (hol:
         const nadd_le :: nadd -> nadd -> bool
         const nadd_mul :: nadd -> nadd -> nadd
         const nadd_of_num :: num -> nadd
         const nadd_add :: nadd -> nadd -> nadd
         forall (x :: nadd, y :: nadd, z :: nadd):
           (forall n :: num:
              nadd_le(nadd_mul(nadd_of_num(n), x), nadd_add(nadd_mul(nadd_of_num(n), y), z)))
             ==> nadd_le(x, y)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REPEAT(STRIP_TAC) then_tac \
                            DISJ_CASES_TAC(
                              SPECL(
                                PairList [
                                  (hol: var x :: nadd; x),
                                  (hol: var y :: nadd; y)
                                ])(
                                NADD_LE_TOTAL
                              )
                            )
                          ) then_tac \
                          ASM_REWRITE_TAC(PairList [])
                        ) then_tac \
                        FIRST_ASSUM(
                          o(X_CHOOSE_TAC(hol: var d :: nadd; d))(MATCH_MP(NADD_LE_EXISTS))
                        )
                      ) then_tac \
                      MATCH_MP_TAC(NADD_EQ_IMP_LE)
                    ) then_tac \
                    MATCH_MP_TAC(NADD_EQ_TRANS)
                  ) then_tac \
                  EXISTS_TAC(
                    (hol:
                       var y :: nadd
                       var d :: nadd
                       const nadd_add :: nadd -> nadd -> nadd
                       nadd_add(y, d))
                  )
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              MATCH_MP_TAC(NADD_EQ_TRANS)
            ) then_tac \
            EXISTS_TAC(
              (hol:
                 var y :: nadd
                 const nadd_add :: nadd -> nadd -> nadd
                 const nadd_of_num :: num -> nadd
                 nadd_add(y, nadd_of_num((0 :: num))))
            )
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (MATCH_MP_TAC(NADD_ADD_WELLDEF) then_tac REWRITE_TAC(PairList [NADD_EQ_REFL])) then_tac \
                MATCH_MP_TAC(NADD_ARCH_ZERO)
              ) then_tac \
              EXISTS_TAC(hol: var z :: nadd; z)
            ) then_tac \
            ASM_MESON_TAC(PairList [NADD_MUL_WELLDEF, NADD_LE_WELLDEF, NADD_LDISTRIB, NADD_LE_LADD, NADD_EQ_REFL])
          ),
          ASM_MESON_TAC(PairList [NADD_ADD_LID, NADD_ADD_WELLDEF, NADD_EQ_TRANS, NADD_ADD_SYM])
        ]
      )
    ]
  )

def NADD_COMPLETE:
  prove(
    [
      (hol:
         const nadd_le :: nadd -> nadd -> bool
         forall P :: nadd -> bool:
           (exists x :: nadd: P(x)) && (exists M :: nadd: forall x :: nadd: P(x) ==> nadd_le(x, M))
             ==> (exists M :: nadd:
                    (forall x :: nadd: P(x) ==> nadd_le(x, M))
                      && (forall #{|M'|} :: nadd:
                            (forall x :: nadd: P(x) ==> nadd_le(x, #{|M'|})) ==> nadd_le(M, #{|M'|})))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          GEN_TAC then_tac \
                          DISCH_THEN(
                            CONJUNCTS_THEN2(X_CHOOSE_TAC(hol: var a :: nadd; a))(X_CHOOSE_TAC(hol: var m :: nadd; m))
                          )
                        ) then_tac \
                        SUBGOAL_THEN(
                          (hol:
                             var P :: nadd -> bool
                             const nadd_le :: nadd -> nadd -> bool
                             const nadd_of_num :: num -> nadd
                             const nadd_mul :: nadd -> nadd -> nadd
                             forall n :: num:
                               exists r :: num:
                                 (exists x :: nadd: P(x) && nadd_le(nadd_of_num(r), nadd_mul(nadd_of_num(n), x)))
                                   && (forall #{|r'|} :: num:
                                         (exists x :: nadd:
                                            P(x) && nadd_le(nadd_of_num(#{|r'|}), nadd_mul(nadd_of_num(n), x)))
                                           ==> #{|r'|} <= r))
                        )(MP_TAC)
                      ) then_list \
                      PairList [
                        (
                          (
                            (GEN_TAC then_tac REWRITE_TAC(PairList [GSYM(num_MAX)])) then_tac \
                            CONJ_TAC
                          ) then_list \
                          PairList [
                            (
                              MAP_EVERY(EXISTS_TAC)(
                                PairList [
                                  (hol:
                                     (0 :: num)),
                                  (hol: var a :: nadd; a)
                                ]
                              ) then_tac \
                              ASM_REWRITE_TAC(PairList [NADD_LE_0])
                            ),
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
