def [realax_real_mul_v2, real_mul_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_mul")(TREAL_MUL_WELLDEF)

def [realax_real_le_v2, real_le_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_le")(TREAL_LE_WELLDEF)

def [realax_real_inv_v2, real_inv_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_inv")(TREAL_INV_WELLDEF)

def PairList [realax_REAL_ADD_SYM_v2, & PairList [realax_REAL_ADD_ASSOC_v2, & PairList [realax_REAL_ADD_LID_v2, & PairList [realax_REAL_ADD_LINV_v2, & PairList [realax_REAL_MUL_SYM_v2, & PairList [realax_REAL_MUL_ASSOC_v2, & PairList [realax_REAL_MUL_LID_v2, & PairList [realax_REAL_ADD_LDISTRIB_v2, & PairList [realax_REAL_LE_REFL_v2, & PairList [realax_REAL_LE_ANTISYM_v2, & PairList [realax_REAL_LE_TRANS_v2, & PairList [realax_REAL_LE_TOTAL_v2, & PairList [realax_REAL_LE_LADD_IMP_v2, & PairList [realax_REAL_LE_MUL_v2, & PairList [realax_REAL_INV_0_v2, & PairList [realax_REAL_MUL_LINV_v2, & PairList [realax_REAL_OF_NUM_EQ_v2, & PairList [realax_REAL_OF_NUM_LE_v2, & PairList [realax_REAL_OF_NUM_ADD_v2, & PairList [REAL_OF_NUM_MUL, & PairList []]]]]]]]]]]]]]]]]]]]]:
  map(
    lift_theorem(real_tybij)([TREAL_EQ_REFL, TREAL_EQ_SYM, TREAL_EQ_TRANS])(PairList [real_of_num_th, real_neg_th, real_add_th, real_mul_th, real_le_th, real_inv_th])
  )(
