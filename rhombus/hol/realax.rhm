                            ) then_tac \
                            REWRITE_TAC(PairList [realax_REAL_ADD_LID_v2])
                          ) then_tac \
                          DISCH_TAC
                        ) then_tac \
                        MP_TAC(
                          SPEC(
                            @hol|{\y. P(y + x) :bool}|
                          )(REAL_COMPLETE_SOMEPOS)
                        )
                      ) then_tac \
                      BETA_TAC
                    ) then_tac \
                    W(o(o(C(SUBGOAL_THEN)(MP_TAC))(funpow(2)(o(fst)(dest_imp))))(snd))
                  ) then_list \
                  PairList [
                    (
                      CONJ_TAC then_list \
