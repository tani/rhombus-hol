def NADD_ALTMUL:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         const dest_nadd :: nadd -> num -> num
         forall (x :: nadd, y :: nadd):
           exists (A :: num, B :: num):
             forall n :: num:
               dist(#{|,|}(n * dest_nadd(x, dest_nadd(y, n)), dest_nadd(x, n) * dest_nadd(y, n)))
                 <= A * n + B),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              REPEAT(GEN_TAC) then_tac \
                              X_CHOOSE_TAC(hol: var B :: num; B)(SPEC(hol: var x :: nadd; x)(NADD_CAUCHY))
                            ) then_tac \
                            MP_TAC(SPEC(hol: var y :: nadd; y)(NADD_BOUND))
                          ) then_tac \
                          DISCH_THEN(
                            X_CHOOSE_THEN(hol: var M :: num; M)(X_CHOOSE_TAC(hol: var L :: num; L))
                          )
                        ) then_tac \
                        MAP_EVERY(EXISTS_TAC)(
                          PairList [
                            (hol:
                               var B :: num
                               var M :: num
                               B * ((1 :: num) + M)),
                            (hol:
                               var B :: num
                               var L :: num
                               B * L)
                          ]
                        )
                      ) then_tac \
                      GEN_TAC
                    ) then_tac \
                    GEN_REWRITE_TAC(o(o(LAND_CONV)(RAND_CONV))(RAND_CONV))(PairList [MULT_SYM])
                  ) then_tac \
                  MATCH_MP_TAC(LE_TRANS)
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     var B :: num
                     var n :: num
                     var y :: nadd
                     const dest_nadd :: nadd -> num -> num
                     B * (n + dest_nadd(y, n)))
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            REWRITE_TAC(PairList [LEFT_ADD_DISTRIB, RIGHT_ADD_DISTRIB])
          ) then_tac \
          REWRITE_TAC(PairList [MULT_CLAUSES, GSYM(ADD_ASSOC), LE_ADD_LCANCEL])
        ) then_tac \
        ASM_REWRITE_TAC(
          PairList [
            GSYM(LEFT_ADD_DISTRIB),
            GSYM(MULT_ASSOC),
            LE_MULT_LCANCEL
          ]
        )
      )
    ]
  )

TypeInference.override_interface(["===", (hol: var nadd_eq :: nadd -> nadd -> bool; nadd_eq)])

def nadd_eq:
  new_definition(
    (hol:
       var nadd_eq :: nadd -> nadd -> bool
       var x :: nadd
       var y :: nadd
       const dist :: pair(num, num) -> num
       const #{|,|} :: num -> num -> pair(num, num)
       const dest_nadd :: nadd -> num -> num
       nadd_eq(x, y)
         <=> (exists B :: num: forall n :: num: dist(#{|,|}(dest_nadd(x, n), dest_nadd(y, n))) <= B))
  )

