        ),
        Forall(
          "d",
          Num,
          And(
            Implies(
              Eq(Num, Var("x", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("y", Num), Ref("d")])),
              App(Var("P", Fun(Num, Bool)), [Ref("d")])
            ),
            Implies(
              Eq(Num, Var("y", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("x", Num), Ref("d")])),
              App(Var("P", Fun(Num, Bool)), [Ref("d")])
            )
          )
        )
      )),
