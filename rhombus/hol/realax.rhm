def NADD_COMPLETE:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Tyapp("nadd", []), Bool),
        Implies(
          And(
            Exists("x", Tyapp("nadd", []), App(Ref("P"), [Ref("x")])),
            Exists(
              "M",
              Tyapp("nadd", []),
              Forall(
                "x",
                Tyapp("nadd", []),
                Implies(
                  App(Ref("P"), [Ref("x")]),
                  App(
                    Const("nadd_le", Fun(Tyapp("nadd", []), Fun(Tyapp("nadd", []), Bool))),
                    [Ref("x"), Ref("M")]
                  )
                )
              )
            )
          ),
          Exists(
            "M",
            Tyapp("nadd", []),
            And(
              Forall(
                "x",
                Tyapp("nadd", []),
                Implies(
                  App(Ref("P"), [Ref("x")]),
                  App(
                    Const("nadd_le", Fun(Tyapp("nadd", []), Fun(Tyapp("nadd", []), Bool))),
                    [Ref("x"), Ref("M")]
                  )
                )
              ),
              Forall(
                "M'",
                Tyapp("nadd", []),
                Implies(
                  Forall(
                    "x",
                    Tyapp("nadd", []),
                    Implies(
                      App(Ref("P"), [Ref("x")]),
                      App(
                        Const("nadd_le", Fun(Tyapp("nadd", []), Fun(Tyapp("nadd", []), Bool))),
                        [Ref("x"), Ref("M'")]
                      )
                    )
                  ),
                  App(
                    Const("nadd_le", Fun(Tyapp("nadd", []), Fun(Tyapp("nadd", []), Bool))),
                    [Ref("M"), Ref("M'")]
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          GEN_TAC then_tac \
                          DISCH_THEN(
                            CONJUNCTS_THEN2(X_CHOOSE_TAC(Host.hol_term(Var("a", Tyapp("nadd", [])))))(X_CHOOSE_TAC(Host.hol_term(Var("m", Tyapp("nadd", [])))))
                          )
                        ) then_tac \
                        SUBGOAL_THEN(
                          Host.hol_term(Forall(
                            "n",
                            Num,
                            Exists(
                              "r",
                              Num,
                              And(
                                Exists(
                                  "x",
                                  Tyapp("nadd", []),
                                  And(
                                    App(Var("P", Fun(Tyapp("nadd", []), Bool)), [Ref("x")]),
                                    App(
                                      Const("nadd_le", Fun(Tyapp("nadd", []), Fun(Tyapp("nadd", []), Bool))),
                                      [
                                        App(Const("nadd_of_num", Fun(Num, Tyapp("nadd", []))), [Ref("r")]),
                                        App(
                                          Const("nadd_mul", Fun(Tyapp("nadd", []), Fun(Tyapp("nadd", []), Tyapp("nadd", [])))),
                                          [App(Const("nadd_of_num", Fun(Num, Tyapp("nadd", []))), [Ref("n")]), Ref("x")]
                                        )
                                      ]
                                    )
                                  )
                                ),
                                Forall(
                                  "r'",
                                  Num,
                                  Implies(
                                    Exists(
                                      "x",
                                      Tyapp("nadd", []),
                                      And(
