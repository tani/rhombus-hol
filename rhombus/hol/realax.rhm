def TREAL_MUL_LINV:
  prove(
    [
      @hol|{!x. ~(x treal_eq treal_of_num 0) ==>
         (treal_inv(x) treal_mul x) treal_eq (treal_of_num 1)}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            (
                                              (
                                                REWRITE_TAC(PairList [FORALL_PAIR_THM]) then_tac \
                                                MAP_EVERY(X_GEN_TAC)(
                                                  PairList [
                                                    @hol|{x:hreal}|,
                                                    @hol|{y:hreal}|
                                                  ]
                                                )
                                              ) then_tac \
                                              PURE_REWRITE_TAC(PairList [treal_eq, treal_of_num, treal_mul, treal_inv])
                                            ) then_tac \
                                            PURE_REWRITE_TAC(PairList [realax_HREAL_ADD_LID_v2, HREAL_ADD_RID])
                                          ) then_tac \
                                          DISCH_TAC
                                        ) then_tac \
                                        PURE_ASM_REWRITE_TAC(PairList [COND_CLAUSES])
                                      ) then_tac \
                                      COND_CASES_TAC
                                    ) then_tac \
                                    PURE_REWRITE_TAC(PairList [treal_mul, treal_eq])
                                  ) then_tac \
                                  REWRITE_TAC(PairList [realax_HREAL_ADD_LID_v2, HREAL_ADD_RID, HREAL_MUL_LZERO, HREAL_MUL_RZERO])
                                ) then_list \
                                PairList [
                                  ALL_TAC,
                                  (
                                    (
                                      DISJ_CASES_THEN(MP_TAC)(
                                        SPECL(
                                          PairList [
                                            @hol|{x:hreal}|,
                                            @hol|{y:hreal}|
                                          ])(
                                          realax_HREAL_LE_TOTAL_v2
                                        )
                                      ) then_tac \
                                      ASM_REWRITE_TAC(PairList [])
                                    ) then_tac \
                                    DISCH_TAC
                                  )
                                ]
                              ) then_tac \
                              FIRST_ASSUM(o(MP_TAC)(MATCH_MP(realax_HREAL_LE_EXISTS_v2)))
                            ) then_tac \
                            DISCH_THEN(o(MP_TAC)(SELECT_RULE))
                          ) then_tac \
                          DISCH_THEN(
                            fun(th):
                              (
                                ASSUME_TAC(SYM(th)) then_tac \
                                GEN_REWRITE_TAC(o(LAND_CONV)(RAND_CONV))(PairList [th])
                              )
                          )
                        ) then_tac \
                        REWRITE_TAC(PairList [realax_HREAL_ADD_LDISTRIB_v2])
                      ) then_tac \
                      GEN_REWRITE_TAC(RAND_CONV)(PairList [realax_HREAL_ADD_SYM_v2])
                    ) then_tac \
                    AP_TERM_TAC
                  ) then_tac \
                  MATCH_MP_TAC(realax_HREAL_MUL_LINV_v2)
                ) then_tac \
                DISCH_THEN(SUBST_ALL_TAC)
              ) then_tac \
              FIRST_ASSUM(o(o(UNDISCH_TAC)(check(is_eq)))(concl))
            ) then_tac \
            ASM_REWRITE_TAC(PairList [HREAL_ADD_RID])
          ) then_tac \
          PURE_ONCE_REWRITE_TAC(PairList [EQ_SYM_EQ])
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

