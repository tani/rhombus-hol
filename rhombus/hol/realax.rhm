def NADD_MUL_WELLDEF_LEMMA:
  prove(
    [
      (hol:
         const nadd_eq :: nadd -> nadd -> bool
         const nadd_mul :: nadd -> nadd -> nadd
         forall (x :: nadd, y :: nadd, #{|y'|} :: nadd):
           nadd_eq(y, #{|y'|}) ==> nadd_eq(nadd_mul(x, y), nadd_mul(x, #{|y'|}))),
      (
        (
          (
            (
              (
                (
                  (
                    (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [nadd_eq, NADD_MUL])) then_tac \
                    DISCH_THEN(X_CHOOSE_TAC(hol: var B1 :: num; B1))
                  ) then_tac \
                  X_CHOOSE_TAC(hol: var B2 :: num; B2)(SPEC(hol: var x :: nadd; x)(NADD_DIST))
                ) then_tac \
                EXISTS_TAC(hol:
                             var B2 :: num
                             var B1 :: num
                             B2 * B1)
              ) then_tac \
              X_GEN_TAC(hol: var n :: num; n)
            ) then_tac \
            MATCH_MP_TAC(LE_TRANS)
          ) then_tac \
          EXISTS_TAC(
            (hol:
               var B2 :: num
               var y :: nadd
               var n :: num
               var #{|y'|} :: nadd
               const dist :: pair(num, num) -> num
               const #{|,|} :: num -> num -> pair(num, num)
               const dest_nadd :: nadd -> num -> num
               B2 * dist(#{|,|}(dest_nadd(y, n), dest_nadd(#{|y'|}, n))))
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList [LE_MULT_LCANCEL])
      )
    ]
  )

def NADD_MUL_WELLDEF:
  prove(
    [
      (hol:
         const nadd_eq :: nadd -> nadd -> bool
         const nadd_mul :: nadd -> nadd -> nadd
         forall (x :: nadd, #{|x'|} :: nadd, y :: nadd, #{|y'|} :: nadd):
           nadd_eq(x, #{|x'|}) && nadd_eq(y, #{|y'|})
             ==> nadd_eq(nadd_mul(x, y), nadd_mul(#{|x'|}, #{|y'|}))),
      (
        (
          (
            (
              (
                (
                  (REPEAT(GEN_TAC) then_tac STRIP_TAC) then_tac \
                  MATCH_MP_TAC(NADD_EQ_TRANS)
                ) then_tac \
                EXISTS_TAC(
                  (hol:
                     var #{|x'|} :: nadd
                     var y :: nadd
                     const nadd_mul :: nadd -> nadd -> nadd
                     nadd_mul(#{|x'|}, y))
                )
              ) then_tac \
              CONJ_TAC
            ) then_list \
            PairList [
              (
                (
                  (
                    (
                      (
                        MATCH_MP_TAC(NADD_EQ_TRANS) then_tac \
                        EXISTS_TAC(
                          (hol:
                             var y :: nadd
                             var #{|x'|} :: nadd
                             const nadd_mul :: nadd -> nadd -> nadd
                             nadd_mul(y, #{|x'|}))
                        )
                      ) then_tac \
                      REWRITE_TAC(PairList [NADD_MUL_SYM])
                    ) then_tac \
                    MATCH_MP_TAC(NADD_EQ_TRANS)
                  ) then_tac \
                  EXISTS_TAC(
                    (hol:
                       var y :: nadd
                       var x :: nadd
                       const nadd_mul :: nadd -> nadd -> nadd
                       nadd_mul(y, x))
                  )
                ) then_tac \
                REWRITE_TAC(PairList [NADD_MUL_SYM])
              ),
              ALL_TAC
            ]
          ) then_tac \
          MATCH_MP_TAC(NADD_MUL_WELLDEF_LEMMA)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

