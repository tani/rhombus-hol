        ) then_tac \
        REWRITE_TAC(PairList [GSYM(EXISTS_REFL)])
      )
    ]
  )

def NADD_ADDITIVE:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         const dest_nadd :: nadd -> num -> num
         forall x :: nadd:
           exists B :: num:
             forall (m :: num, n :: num):
               dist(#{|,|}(dest_nadd(x, m + n), dest_nadd(x, m) + dest_nadd(x, n))) <= B),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            GEN_TAC then_tac \
                            X_CHOOSE_TAC(hol: var B :: num; B)(SPEC(hol: var x :: nadd; x)(NADD_CAUCHY))
                          ) then_tac \
                          EXISTS_TAC(
                            (hol:
                               var B :: num
                               var x :: nadd
                               const dest_nadd :: nadd -> num -> num
                               (3 :: num) * B + dest_nadd(x, (0 :: num)))
                          )
                        ) then_tac \
                        REPEAT(GEN_TAC)
                      ) then_tac \
                      ASM_CASES_TAC(
                        (hol:
                           var m :: num
                           var n :: num
                           m + n == (0 :: num))
                      )
                    ) then_list \
                    PairList [
                      (
                        (
                          RULE_ASSUM_TAC(REWRITE_RULE(PairList [ADD_EQ_0])) then_tac \
                          ONCE_REWRITE_TAC(PairList [DIST_SYM])
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [ADD_CLAUSES, DIST_LADD_0, LE_ADDR])
                      ),
                      (
                        (
                          (
                            MATCH_MP_TAC(LE_TRANS) then_tac \
                            EXISTS_TAC(
                              (hol:
                                 var B :: num
                                 (3 :: num) * B)
                            )
                          ) then_tac \
                          REWRITE_TAC(PairList [LE_ADD])
                        ) then_tac \
                        UNDISCH_TAC(
                          (hol:
                             var m :: num
                             var n :: num
                             m + n != (0 :: num))
                        )
                      )
                    ]
                  ) then_tac \
                  REWRITE_TAC(
                    PairList [
                      TAUT(
                        (hol:
                           var a :: bool
                           var b :: bool
                           !a ==> b <=> a || b)
                      ),
                      GSYM(LE_MULT_LCANCEL)
                    ]
                  )
                ) then_tac \
                REWRITE_TAC(PairList [DIST_LMUL, LEFT_ADD_DISTRIB])
              ) then_tac \
              GEN_REWRITE_TAC(o(o(LAND_CONV)(RAND_CONV))(LAND_CONV))(PairList [RIGHT_ADD_DISTRIB])
            ) then_tac \
            MATCH_MP_TAC(LE_IMP(realax_DIST_ADD2_v2))
          ) then_tac \
          SUBGOAL_THEN(
            (hol:
               var m :: num
               var n :: num
               var B :: num
               (m + n) * ((3 :: num) * B) == B * (m + (m + n)) + B * (n + (m + n)))
          )(SUBST1_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                (
                  REWRITE_TAC(
                    PairList [
                      SYM(
                        REWRITE_CONV(PairList [ARITH])(
                          (hol:
                             (1 :: num) + ((1 :: num) + (1 :: num)))
                        )
                      )
                    ]
                  ) then_tac \
                  REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, LEFT_ADD_DISTRIB, MULT_CLAUSES])
                ) then_tac \
                REWRITE_TAC(PairList [MULT_AC])
              ) then_tac \
              CONV_TAC(NUM_CANCEL_CONV)
            ) then_tac \
            REFL_TAC
          ),
          (MATCH_MP_TAC(LE_ADD2) then_tac ASM_REWRITE_TAC(PairList []))
        ]
      )
    ]
  )

def NADD_SUC:
  prove(
    [
      (hol:
         const dist :: pair(num, num) -> num
         const #{|,|} :: num -> num -> pair(num, num)
         const dest_nadd :: nadd -> num -> num
         const SUC :: num -> num
         forall x :: nadd:
           exists B :: num: forall n :: num: dist(#{|,|}(dest_nadd(x, SUC(n)), dest_nadd(x, n))) <= B),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      GEN_TAC then_tac \
                      X_CHOOSE_TAC(hol: var B :: num; B)(SPEC(hol: var x :: nadd; x)(NADD_ADDITIVE))
                    ) then_tac \
                    EXISTS_TAC(
                      (hol:
                         var B :: num
                         var x :: nadd
                         const dest_nadd :: nadd -> num -> num
                         B + dest_nadd(x, (1 :: num)))
                    )
                  ) then_tac \
                  GEN_TAC
                ) then_tac \
                MATCH_MP_TAC(LE_IMP(realax_DIST_TRIANGLE_v2))
              ) then_tac \
              EXISTS_TAC(
                (hol:
                   var x :: nadd
                   var n :: num
                   const dest_nadd :: nadd -> num -> num
                   dest_nadd(x, n) + dest_nadd(x, (1 :: num)))
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [ADD1])
          ) then_tac \
          MATCH_MP_TAC(LE_ADD2)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [DIST_LADD_0, LE_REFL])
      )
    ]
  )

def NADD_DIST_LEMMA:
