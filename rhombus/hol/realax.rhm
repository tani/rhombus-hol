                                ),
                                (
                                  (MATCH_MP_TAC(NADD_LE_LMUL) then_tac FIRST_ASSUM(MATCH_MP_TAC)) then_tac \
                                  ASM_REWRITE_TAC(PairList [])
                                )
                              ]
                            ),
                            (
                              (
                                (
                                  ONCE_REWRITE_TAC(PairList [ADD_SYM]) then_tac \
                                  REWRITE_TAC(PairList [GSYM(MULT_SUC)])
                                ) then_tac \
                                MATCH_MP_TAC(NADD_EQ_IMP_LE)
