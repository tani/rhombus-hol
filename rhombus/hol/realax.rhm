              ) then_tac \
              SUBGOAL_THEN(
                @hol|{fn(afn r) = r}|
              )(ASSUME_TAC)
            ) then_list \
            PairList [
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    REWRITE_TAC(PairList [GSYM(nadd_rep)]) then_tac \
                                    REWRITE_TAC(PairList [is_nadd, realax_DIST_LE_CASES_v2])
                                  ) then_tac \
                                  EXISTS_TAC(
                                    @hol|{1}|
                                  )
                                ) then_tac \
                                REWRITE_TAC(PairList [MULT_CLAUSES])
                              ) then_tac \
                              REWRITE_TAC(PairList [FORALL_AND_THM])
                            ) then_tac \
                            GEN_REWRITE_TAC(RAND_CONV)(PairList [SWAP_FORALL_THM])
                          ) then_tac \
                          GEN_REWRITE_TAC(
                            o(o(LAND_CONV)(funpow(2)(BINDER_CONV)))(funpow(2)(RAND_CONV)))(
                            PairList [ADD_SYM]
                          )
                        ) then_tac \
                        REWRITE_TAC(PairList [])
                      ) then_tac \
                      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{i:num}|, @hol|{n:num}|])
                    ) then_tac \
                    MATCH_MP_TAC(LE_TRANS)
                  ) then_tac \
                  EXISTS_TAC(
                    @hol|{n * r(i:num) + n}|
