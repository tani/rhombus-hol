       var nadd_le :: nadd -> nadd -> bool
       var x :: nadd
       var y :: nadd
       const dest_nadd :: nadd -> num -> num
       nadd_le(x, y) <=> (exists B :: num: forall n :: num: dest_nadd(x, n) <= dest_nadd(y, n) + B))
  )

