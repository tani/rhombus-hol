                                    )
                                  )
                                )
                              ) then_tac \
                              REWRITE_TAC(PairList [LE_SUC_LT, LT_REFL, NOT_EXISTS_THM])
                            ) then_tac \
                            DISCH_THEN(
                              o(
                                o(
                                  o(
                                    o(ASSUME_TAC)(GENL(PairList [@hol|{n:num}|, @hol|{x:nadd}|]))
                                  )(
                                    MATCH_MP(
                                      ITAUT(
                                        @hol|{(a \/ b) /\ ~(c /\ b) ==> c ==> a}|
                                      )
                                    )
                                  )
                                )(
                                  CONJ(
                                    SPECL(
                                      PairList [
                                        @hol|{&n ** x}|,
                                        @hol|{&(SUC(r(n:num)))}|
