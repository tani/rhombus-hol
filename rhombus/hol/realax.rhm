              GEN_REWRITE_TAC(o(RAND_CONV)(RAND_CONV))(PairList [ADD_SYM])
            ) then_tac \
            REWRITE_TAC(
              PairList [
                LEFT_ADD_DISTRIB,
                RIGHT_ADD_DISTRIB,
                GSYM(ADD_ASSOC),
                LE_ADD
              ]
            )
          )
        ]
      )
    ]
  )

def nadd_inv:
  new_definition(
    @hol|{nadd_inv(x) = if x === &0 then &0 else afn(nadd_rinv x)}|
  )

TypeInference.override_interface(["inv", @hol|{nadd_inv:nadd->nadd}|])

def NADD_INV:
  prove(
    [
      @hol|{!x. fn(nadd_inv x) = if x === &0 then (\n. 0) else nadd_rinv x}|,
      (
        (
          (
            (
              (
                (GEN_TAC then_tac REWRITE_TAC(PairList [nadd_inv])) then_tac \
                ASM_CASES_TAC(
                  @hol|{x === &0}|
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [NADD_OF_NUM, MULT_CLAUSES])
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(nadd_rep), is_nadd])
          ) then_tac \
          MATCH_MP_TAC(NADD_MUL_LINV_LEMMA8)
        ) then_tac \
        POP_ASSUM(ACCEPT_TAC)
      )
    ]
  )

def NADD_MUL_LINV:
  prove(
    [
      @hol|{!x. ~(x === &0) ==> inv(x) ** x === &1}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (GEN_TAC then_tac DISCH_TAC) then_tac \
                      REWRITE_TAC(PairList [nadd_eq, NADD_MUL])
                    ) then_tac \
                    ONCE_REWRITE_TAC(PairList [BOUNDS_DIVIDED])
                  ) then_tac \
                  X_CHOOSE_THEN(@hol|{A1:num}|)(X_CHOOSE_TAC(@hol|{B1:num}|))(
                    SPECL(
                      PairList [
                        @hol|{inv(x)}|,
                        @hol|{x:nadd}|
                      ])(
                      NADD_ALTMUL
                    )
                  )
                ) then_tac \
                REWRITE_TAC(PairList [DIST_LMUL, NADD_OF_NUM, MULT_CLAUSES])
              ) then_tac \
              FIRST_ASSUM(o(X_CHOOSE_TAC(@hol|{N:num}|))(MATCH_MP(NADD_MUL_LINV_LEMMA2)))
            ) then_tac \
            X_CHOOSE_THEN(@hol|{A':num}|)(X_CHOOSE_TAC(@hol|{B':num}|))(SPEC(@hol|{x:nadd}|)(NADD_BOUND))
          ) then_tac \
          SUBGOAL_THEN(
            @hol|{?A2 B2. !n. dist(fn x n * nadd_rinv x n,n * n) <= A2 * n + B2}|
          )(STRIP_ASSUME_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          EXISTS_TAC(@hol|{A':num}|) then_tac \
                          ONCE_REWRITE_TAC(PairList [BOUNDS_IGNORE])
                        ) then_tac \
                        MAP_EVERY(EXISTS_TAC)(PairList [@hol|{B':num}|, @hol|{N:num}|])
                      ) then_tac \
                      REPEAT(STRIP_TAC)
                    ) then_tac \
                    MATCH_MP_TAC(LE_TRANS)
                  ) then_tac \
                  EXISTS_TAC(
                    @hol|{fn x n}|
                  )
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              FIRST_ASSUM(MATCH_MP_TAC)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            MAP_EVERY(EXISTS_TAC)(
                              PairList [
                                @hol|{A1 + A2}|,
                                @hol|{B1 + B2}|
                              ]
                            ) then_tac \
                            GEN_TAC
                          ) then_tac \
                          MATCH_MP_TAC(DIST_TRIANGLE_LE)
                        ) then_tac \
                        EXISTS_TAC(
                          @hol|{fn (inv x) n * fn x n}|
                        )
                      ) then_tac \
                      REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB])
                    ) then_tac \
                    ONCE_REWRITE_TAC(
                      PairList [
                        AC(ADD_AC)(
                          @hol|{(a + b) + c + d = (a + c) + (b + d)}|
                        )
                      ]
                    )
                  ) then_tac \
                  MATCH_MP_TAC(LE_ADD2)
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              GEN_REWRITE_TAC(o(o(LAND_CONV)(RAND_CONV))(LAND_CONV))(PairList [MULT_SYM])
            ) then_tac \
            ASM_REWRITE_TAC(PairList [NADD_INV])
          )
        ]
      )
    ]
  )

def NADD_INV_0:
  prove(
    [
      @hol|{inv(&0) === &0}|,
      REWRITE_TAC(PairList [nadd_inv, NADD_EQ_REFL])
    ]
  )

def NADD_INV_WELLDEF:
  let TAC:
    fun(tm):
      fun(ths):
        (
          ((MATCH_MP_TAC(NADD_EQ_TRANS) then_tac EXISTS_TAC(tm)) then_tac CONJ_TAC) then_list \
          PairList [ALL_TAC, ASM_MESON_TAC(ths)]
        )
  prove(
    [
      @hol|{!x y. x === y ==> inv(x) === inv(y)}|,
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(STRIP_TAC) then_tac \
                    ASM_CASES_TAC(
                      @hol|{x === &0}|
                    )
                  ) then_list \
                  PairList [
                    (
                      SUBGOAL_THEN(
                        @hol|{y === &0}|
                      )(ASSUME_TAC) then_list \
                      PairList [
                        ASM_MESON_TAC(PairList [NADD_EQ_TRANS, NADD_EQ_SYM]),
                        ASM_REWRITE_TAC(PairList [nadd_inv, NADD_EQ_REFL])
                      ]
                    ),
                    (
                      SUBGOAL_THEN(
                        @hol|{~(y === &0)}|
                      )(ASSUME_TAC) then_list \
                      PairList [ASM_MESON_TAC(PairList [NADD_EQ_TRANS, NADD_EQ_SYM]), ALL_TAC]
                    )
                  ]
                ) then_tac \
                TAC(
                  @hol|{inv(y) ** &1}|
                )(PairList [NADD_MUL_SYM, NADD_MUL_LID, NADD_EQ_TRANS])
              ) then_tac \
              TAC(
                @hol|{inv(y) ** (inv(x) ** x)}|
              )(PairList [NADD_MUL_LINV, NADD_MUL_WELLDEF, NADD_EQ_REFL])
            ) then_tac \
            TAC(
              @hol|{inv(y) ** (inv(x) ** y)}|
            )(PairList [NADD_MUL_WELLDEF, NADD_EQ_REFL, NADD_EQ_SYM])
          ) then_tac \
          TAC(
            @hol|{(inv(y) ** y) ** inv(x)}|
          )(PairList [NADD_MUL_ASSOC, NADD_MUL_SYM, NADD_EQ_TRANS, NADD_MUL_WELLDEF, NADD_EQ_REFL])
        ) then_tac \
        ASM_MESON_TAC(
          PairList [
            NADD_MUL_LINV,
            NADD_MUL_WELLDEF,
            NADD_EQ_REFL,
            NADD_MUL_LID,
            NADD_EQ_TRANS,
            NADD_EQ_SYM
          ]
        )
      )
    ]
  )

def hreal_tybij:
  define_quotient_type(
    "hreal")(
    ["mk_hreal", "dest_hreal"])(
    @hol|{(===)}|
  )

def initialization_4:
  do_list(TypeInference.overload_interface)(
    PairList [
      [
        "+",
        @hol|{hreal_add:hreal->hreal->hreal}|
      ],
      [
        "*",
        @hol|{hreal_mul:hreal->hreal->hreal}|
      ],
      ["<=", @hol|{hreal_le:hreal->hreal->bool}|]
    ]
  )

def initialization_5:
  do_list(TypeInference.override_interface)(
    PairList [
      ["&", @hol|{hreal_of_num:num->hreal}|],
      ["inv", @hol|{hreal_inv:hreal->hreal}|]
    ]
  )

def [realax_hreal_of_num_v2, hreal_of_num_th] = lift_function(snd(hreal_tybij))([NADD_EQ_REFL, NADD_EQ_TRANS])("hreal_of_num")(NADD_OF_NUM_WELLDEF)

def [realax_hreal_add_v2, hreal_add_th] = lift_function(snd(hreal_tybij))([NADD_EQ_REFL, NADD_EQ_TRANS])("hreal_add")(NADD_ADD_WELLDEF)

def [realax_hreal_mul_v2, hreal_mul_th] = lift_function(snd(hreal_tybij))([NADD_EQ_REFL, NADD_EQ_TRANS])("hreal_mul")(NADD_MUL_WELLDEF)

def [realax_hreal_le_v2, hreal_le_th] = lift_function(snd(hreal_tybij))([NADD_EQ_REFL, NADD_EQ_TRANS])("hreal_le")(NADD_LE_WELLDEF)

def [realax_hreal_inv_v2, hreal_inv_th] = lift_function(snd(hreal_tybij))([NADD_EQ_REFL, NADD_EQ_TRANS])("hreal_inv")(NADD_INV_WELLDEF)

def HREAL_COMPLETE:
  let th1:
    ASSUME(
      @hol|{(P:nadd->bool) = (\x. Q(mk_hreal((===) x)))}|
    )
  let th2 = BETA_RULE(AP_THM(th1)(@hol|{x:nadd}|))
  let th3 = lift_theorem(hreal_tybij)([NADD_EQ_REFL, NADD_EQ_SYM, NADD_EQ_TRANS])(PairList [hreal_of_num_th, hreal_add_th, hreal_mul_th, hreal_le_th, th2])(SPEC_ALL(NADD_COMPLETE))
  let th4:
    MATCH_MP(DISCH_ALL(th3))(
      REFL(
        @hol|{\x. Q(mk_hreal((===) x)):bool}|
      )
    )
  CONV_RULE(GEN_ALPHA_CONV(@hol|{P:hreal->bool}|))(GEN_ALL(th4))

def PairList [realax_HREAL_OF_NUM_EQ_v2, & PairList [realax_HREAL_OF_NUM_LE_v2, & PairList [realax_HREAL_OF_NUM_ADD_v2, & PairList [realax_HREAL_OF_NUM_MUL_v2, & PairList [realax_HREAL_LE_REFL_v2, & PairList [realax_HREAL_LE_TRANS_v2, & PairList [realax_HREAL_LE_ANTISYM_v2, & PairList [realax_HREAL_LE_TOTAL_v2, & PairList [realax_HREAL_LE_ADD_v2, & PairList [realax_HREAL_LE_EXISTS_v2, & PairList [realax_HREAL_ARCH_v2, & PairList [realax_HREAL_ADD_SYM_v2, & PairList [realax_HREAL_ADD_ASSOC_v2, & PairList [realax_HREAL_ADD_LID_v2, & PairList [realax_HREAL_ADD_LCANCEL_v2, & PairList [realax_HREAL_MUL_SYM_v2, & PairList [realax_HREAL_MUL_ASSOC_v2, & PairList [realax_HREAL_MUL_LID_v2, & PairList [realax_HREAL_ADD_LDISTRIB_v2, & PairList [realax_HREAL_MUL_LINV_v2, & PairList [HREAL_INV_0, & PairList []]]]]]]]]]]]]]]]]]]]]]:
  map(
    lift_theorem(hreal_tybij)([NADD_EQ_REFL, NADD_EQ_SYM, NADD_EQ_TRANS])(PairList [hreal_of_num_th, hreal_add_th, hreal_mul_th, hreal_le_th, hreal_inv_th])
  )(
    PairList [
      NADD_OF_NUM_EQ,
      NADD_OF_NUM_LE,
      NADD_OF_NUM_ADD,
      NADD_OF_NUM_MUL,
      NADD_LE_REFL,
      NADD_LE_TRANS,
      NADD_LE_ANTISYM,
      NADD_LE_TOTAL,
      NADD_LE_ADD,
      NADD_LE_EXISTS,
      NADD_ARCH,
      NADD_ADD_SYM,
      NADD_ADD_ASSOC,
      NADD_ADD_LID,
      NADD_ADD_LCANCEL,
      NADD_MUL_SYM,
      NADD_MUL_ASSOC,
      NADD_MUL_LID,
      NADD_LDISTRIB,
      NADD_MUL_LINV,
      NADD_INV_0
    ]
  )

def HREAL_LE_EXISTS_DEF:
  prove(
    [
      @hol|{!m n. m <= n <=> ?d. n = m + d}|,
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac \
            REWRITE_TAC(PairList [realax_HREAL_LE_EXISTS_v2])
          ) then_tac \
          DISCH_THEN(CHOOSE_THEN(SUBST1_TAC))
        ) then_tac \
        REWRITE_TAC(PairList [realax_HREAL_LE_ADD_v2])
      )
    ]
  )

def HREAL_EQ_ADD_LCANCEL:
  prove(
    [
      @hol|{!m n p. (m + n = m + p) <=> (n = p)}|,
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac \
            REWRITE_TAC(PairList [realax_HREAL_ADD_LCANCEL_v2])
          ) then_tac \
          DISCH_THEN(SUBST1_TAC)
        ) then_tac \
        REFL_TAC
      )
    ]
  )

def HREAL_EQ_ADD_RCANCEL:
  prove(
    [
      @hol|{!m n p. (m + p = n + p) <=> (m = n)}|,
      (
        ONCE_REWRITE_TAC(PairList [realax_HREAL_ADD_SYM_v2]) then_tac \
        REWRITE_TAC(PairList [HREAL_EQ_ADD_LCANCEL])
      )
    ]
  )

def HREAL_LE_ADD_LCANCEL:
  prove(
    [
      @hol|{!m n p. (m + n <= m + p) <=> (n <= p)}|,
      REWRITE_TAC(PairList [HREAL_LE_EXISTS_DEF, GSYM(realax_HREAL_ADD_ASSOC_v2), HREAL_EQ_ADD_LCANCEL])
    ]
  )

def HREAL_LE_ADD_RCANCEL:
  prove(
    [
      @hol|{!m n p. (m + p <= n + p) <=> (m <= n)}|,
      (
        ONCE_REWRITE_TAC(PairList [realax_HREAL_ADD_SYM_v2]) then_tac \
        MATCH_ACCEPT_TAC(HREAL_LE_ADD_LCANCEL)
      )
    ]
  )

def HREAL_ADD_RID:
  prove(
    [
      @hol|{!n. n + &0 = n}|,
      (
        ONCE_REWRITE_TAC(PairList [realax_HREAL_ADD_SYM_v2]) then_tac \
        MATCH_ACCEPT_TAC(realax_HREAL_ADD_LID_v2)
      )
    ]
  )

def HREAL_ADD_RDISTRIB:
  prove(
    [
      @hol|{!m n p. (m + n) * p = m * p + n * p}|,
      (
        ONCE_REWRITE_TAC(PairList [realax_HREAL_MUL_SYM_v2]) then_tac \
        MATCH_ACCEPT_TAC(realax_HREAL_ADD_LDISTRIB_v2)
      )
    ]
  )

def HREAL_MUL_LZERO:
  prove(
    [
      @hol|{!m. &0 * m = &0}|,
      (
        (
          (
            (
              (
                GEN_TAC then_tac \
                MP_TAC(
                  SPECL(
                    PairList [
                      @hol|{&0}|,
                      @hol|{&1}|,
                      @hol|{m:hreal}|
                    ])(
                    HREAL_ADD_RDISTRIB
                  )
                )
              ) then_tac \
              REWRITE_TAC(PairList [realax_HREAL_ADD_LID_v2])
            ) then_tac \
            GEN_REWRITE_TAC(funpow(2)(LAND_CONV))(PairList [GSYM(realax_HREAL_ADD_LID_v2)])
          ) then_tac \
          REWRITE_TAC(PairList [HREAL_EQ_ADD_RCANCEL])
        ) then_tac \
        DISCH_THEN(o(ACCEPT_TAC)(SYM))
      )
    ]
  )

def HREAL_MUL_RZERO:
  prove(
    [
      @hol|{!m. m * &0 = &0}|,
      (
        ONCE_REWRITE_TAC(PairList [realax_HREAL_MUL_SYM_v2]) then_tac \
        MATCH_ACCEPT_TAC(HREAL_MUL_LZERO)
      )
    ]
  )

def HREAL_ADD_AC:
  prove(
    [
      @hol|{(m + n = n + m) /\
         ((m + n) + p = m + (n + p)) /\
         (m + (n + p) = n + (m + p))}|,
      (
        (
          (
            REWRITE_TAC(PairList [realax_HREAL_ADD_ASSOC_v2, EQT_INTRO(SPEC_ALL(realax_HREAL_ADD_SYM_v2))]) then_tac \
            AP_THM_TAC
          ) then_tac \
          AP_TERM_TAC
        ) then_tac \
        MATCH_ACCEPT_TAC(realax_HREAL_ADD_SYM_v2)
      )
    ]
  )

def HREAL_LE_ADD2:
  prove(
    [
      @hol|{!a b c d. a <= b /\ c <= d ==> a + c <= b + d}|,
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [HREAL_LE_EXISTS_DEF])) then_tac \
            DISCH_THEN(
              CONJUNCTS_THEN2(X_CHOOSE_TAC(@hol|{d1:hreal}|))(X_CHOOSE_TAC(@hol|{d2:hreal}|))
            )
          ) then_tac \
          EXISTS_TAC(
            @hol|{d1 + d2}|
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList [HREAL_ADD_AC])
      )
    ]
  )

def HREAL_LE_MUL_RCANCEL_IMP:
  prove(
    [
      @hol|{!a b c. a <= b ==> a * c <= b * c}|,
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [HREAL_LE_EXISTS_DEF])) then_tac \
            DISCH_THEN(X_CHOOSE_THEN(@hol|{d:hreal}|)(SUBST1_TAC))
          ) then_tac \
          EXISTS_TAC(
            @hol|{d * c}|
          )
        ) then_tac \
        REWRITE_TAC(PairList [HREAL_ADD_RDISTRIB])
      )
    ]
  )

def treal_of_num:
  new_definition(
    @hol|{treal_of_num n = (&n, &0)}|
  )

def treal_neg:
  new_definition(
    @hol|{treal_neg ((x:hreal),(y:hreal)) = (y,x)}|
  )

def treal_add:
  new_definition(
    @hol|{(x1,y1) treal_add (x2,y2) = (x1 + x2, y1 + y2)}|
  )

def treal_mul:
  new_definition(
    @hol|{(x1,y1) treal_mul (x2,y2) = ((x1 * x2) + (y1 * y2),(x1 * y2) + (y1 * x2))}|
  )

def treal_le:
  new_definition(
    @hol|{(x1,y1) treal_le (x2,y2) <=> x1 + y2 <= x2 + y1}|
  )

def treal_inv:
  new_definition(
    @hol|{treal_inv(x,y) = if x = y then (&0, &0)
       else if y <= x then (inv(@d. x = y + d), &0)
       else (&0, inv(@d. y = x + d))}|
  )

def treal_eq:
  new_definition(
    @hol|{(x1,y1) treal_eq (x2,y2) <=> (x1 + y2 = x2 + y1)}|
  )

def TREAL_EQ_REFL:
  prove(
    [
      @hol|{!x. x treal_eq x}|,
      REWRITE_TAC(PairList [FORALL_PAIR_THM, treal_eq])
    ]
  )

def TREAL_EQ_SYM:
  prove(
    [
      @hol|{!x y. x treal_eq y <=> y treal_eq x}|,
      REWRITE_TAC(PairList [FORALL_PAIR_THM, treal_eq, EQ_SYM_EQ])
    ]
  )

def TREAL_EQ_TRANS:
  prove(
    [
      @hol|{!x y z. x treal_eq y /\ y treal_eq z ==> x treal_eq z}|,
      (
        (
          (
            (
              (
                (
                  REWRITE_TAC(PairList [FORALL_PAIR_THM, treal_eq]) then_tac \
                  REPEAT(GEN_TAC)
                ) then_tac \
                DISCH_THEN(
                  o(
                    o(o(MP_TAC)(MK_COMB))(
                      F_F(
                        AP_TERM(
                          @hol|{(+)}|
                        )
                      )(I)
                    )
                  )(CONJ_PAIR)
                )
              ) then_tac \
              GEN_REWRITE_TAC(o(LAND_CONV)(LAND_CONV))(PairList [realax_HREAL_ADD_SYM_v2])
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(realax_HREAL_ADD_ASSOC_v2), HREAL_EQ_ADD_LCANCEL])
          ) then_tac \
          REWRITE_TAC(PairList [realax_HREAL_ADD_ASSOC_v2, HREAL_EQ_ADD_RCANCEL])
        ) then_tac \
        DISCH_THEN(o(MATCH_ACCEPT_TAC)(ONCE_REWRITE_RULE(PairList [realax_HREAL_ADD_SYM_v2])))
      )
    ]
  )

def TREAL_EQ_AP:
  prove(
    [
      @hol|{!x y. (x = y) ==> x treal_eq y}|,
      SIMP_TAC(PairList [TREAL_EQ_REFL])
    ]
  )

def TREAL_OF_NUM_EQ:
  prove(
    [
      @hol|{!m n. (treal_of_num m treal_eq treal_of_num n) <=> (m = n)}|,
      REWRITE_TAC(PairList [treal_of_num, treal_eq, realax_HREAL_OF_NUM_EQ_v2, HREAL_ADD_RID])
    ]
  )

def TREAL_OF_NUM_LE:
  prove(
    [
      @hol|{!m n. (treal_of_num m treal_le treal_of_num n) <=> m <= n}|,
      REWRITE_TAC(PairList [treal_of_num, treal_le, realax_HREAL_OF_NUM_LE_v2, HREAL_ADD_RID])
    ]
  )

def TREAL_OF_NUM_ADD:
  prove(
    [
      @hol|{!m n. (treal_of_num m treal_add treal_of_num n) treal_eq
         (treal_of_num(m + n))}|,
      REWRITE_TAC(
        PairList [
          treal_of_num,
          treal_eq,
          treal_add,
          realax_HREAL_OF_NUM_ADD_v2,
          HREAL_ADD_RID,
          ADD_CLAUSES
        ]
      )
    ]
  )

def TREAL_OF_NUM_MUL:
  prove(
    [
      @hol|{!m n. (treal_of_num m treal_mul treal_of_num n) treal_eq
         (treal_of_num(m * n))}|,
      REWRITE_TAC(
        PairList [
          treal_of_num,
          treal_eq,
          treal_mul,
          realax_HREAL_OF_NUM_MUL_v2,
          HREAL_MUL_RZERO,
          HREAL_MUL_LZERO,
          HREAL_ADD_RID,
          realax_HREAL_ADD_LID_v2,
          HREAL_ADD_RID,
          MULT_CLAUSES
        ]
      )
    ]
  )

def TREAL_ADD_SYM_EQ:
  prove(
    [
