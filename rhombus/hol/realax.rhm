def NADD_INV_WELLDEF:
  let TAC:
    fun(tm):
      fun(ths):
        (
          ((MATCH_MP_TAC(NADD_EQ_TRANS) then_tac EXISTS_TAC(tm)) then_tac CONJ_TAC) then_list \
          PairList [ALL_TAC, ASM_MESON_TAC(ths)]
        )
  prove(
    [
      (hol:
         const nadd_eq :: nadd -> nadd -> bool
         const nadd_inv :: nadd -> nadd
         forall (x :: nadd, y :: nadd): nadd_eq(x, y) ==> nadd_eq(nadd_inv(x), nadd_inv(y))),
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(STRIP_TAC) then_tac \
                    ASM_CASES_TAC(
                      (hol:
                         var x :: nadd
                         const nadd_eq :: nadd -> nadd -> bool
                         const nadd_of_num :: num -> nadd
                         nadd_eq(x, nadd_of_num((0 :: num))))
                    )
                  ) then_list \
                  PairList [
                    (
                      SUBGOAL_THEN(
                        (hol:
                           var y :: nadd
                           const nadd_eq :: nadd -> nadd -> bool
                           const nadd_of_num :: num -> nadd
                           nadd_eq(y, nadd_of_num((0 :: num))))
                      )(ASSUME_TAC) then_list \
                      PairList [
                        ASM_MESON_TAC(PairList [NADD_EQ_TRANS, NADD_EQ_SYM]),
                        ASM_REWRITE_TAC(PairList [nadd_inv, NADD_EQ_REFL])
                      ]
                    ),
                    (
                      SUBGOAL_THEN(
                        (hol:
                           var y :: nadd
                           const nadd_eq :: nadd -> nadd -> bool
                           const nadd_of_num :: num -> nadd
                           !nadd_eq(y, nadd_of_num((0 :: num))))
                      )(ASSUME_TAC) then_list \
                      PairList [ASM_MESON_TAC(PairList [NADD_EQ_TRANS, NADD_EQ_SYM]), ALL_TAC]
                    )
                  ]
                ) then_tac \
                TAC(
                  (hol:
                     var y :: nadd
                     const nadd_mul :: nadd -> nadd -> nadd
                     const nadd_inv :: nadd -> nadd
                     const nadd_of_num :: num -> nadd
                     nadd_mul(nadd_inv(y), nadd_of_num((1 :: num))))
                )(PairList [NADD_MUL_SYM, NADD_MUL_LID, NADD_EQ_TRANS])
              ) then_tac \
              TAC(
                (hol:
                   var y :: nadd
                   var x :: nadd
                   const nadd_mul :: nadd -> nadd -> nadd
                   const nadd_inv :: nadd -> nadd
                   nadd_mul(nadd_inv(y), nadd_mul(nadd_inv(x), x)))
              )(PairList [NADD_MUL_LINV, NADD_MUL_WELLDEF, NADD_EQ_REFL])
            ) then_tac \
            TAC(
              (hol:
                 var y :: nadd
                 var x :: nadd
                 const nadd_mul :: nadd -> nadd -> nadd
                 const nadd_inv :: nadd -> nadd
                 nadd_mul(nadd_inv(y), nadd_mul(nadd_inv(x), y)))
            )(PairList [NADD_MUL_WELLDEF, NADD_EQ_REFL, NADD_EQ_SYM])
          ) then_tac \
          TAC(
            (hol:
               var y :: nadd
               var x :: nadd
               const nadd_mul :: nadd -> nadd -> nadd
               const nadd_inv :: nadd -> nadd
               nadd_mul(nadd_mul(nadd_inv(y), y), nadd_inv(x)))
          )(PairList [NADD_MUL_ASSOC, NADD_MUL_SYM, NADD_EQ_TRANS, NADD_MUL_WELLDEF, NADD_EQ_REFL])
        ) then_tac \
        ASM_MESON_TAC(
          PairList [
            NADD_MUL_LINV,
            NADD_MUL_WELLDEF,
            NADD_EQ_REFL,
            NADD_MUL_LID,
            NADD_EQ_TRANS,
            NADD_EQ_SYM
          ]
        )
      )
    ]
  )

def hreal_tybij:
  define_quotient_type(
    "hreal")(
    ["mk_hreal", "dest_hreal"])(
    (hol: const nadd_eq :: nadd -> nadd -> bool; nadd_eq)
  )

def initialization_4:
  do_list(TypeInference.overload_interface)(
    PairList [
      [
        "+",
        (hol: var hreal_add :: hreal -> hreal -> hreal; hreal_add)
      ],
      [
        "*",
        (hol: var hreal_mul :: hreal -> hreal -> hreal; hreal_mul)
      ],
      ["<=", (hol: var hreal_le :: hreal -> hreal -> bool; hreal_le)]
    ]
  )

def initialization_5:
  do_list(TypeInference.override_interface)(
    PairList [
      ["&", (hol: var hreal_of_num :: num -> hreal; hreal_of_num)],
      ["inv", (hol: var hreal_inv :: hreal -> hreal; hreal_inv)]
    ]
  )

def [realax_hreal_of_num_v2, hreal_of_num_th] = lift_function(snd(hreal_tybij))([NADD_EQ_REFL, NADD_EQ_TRANS])("hreal_of_num")(NADD_OF_NUM_WELLDEF)

def [realax_hreal_add_v2, hreal_add_th] = lift_function(snd(hreal_tybij))([NADD_EQ_REFL, NADD_EQ_TRANS])("hreal_add")(NADD_ADD_WELLDEF)

def [realax_hreal_mul_v2, hreal_mul_th] = lift_function(snd(hreal_tybij))([NADD_EQ_REFL, NADD_EQ_TRANS])("hreal_mul")(NADD_MUL_WELLDEF)

def [realax_hreal_le_v2, hreal_le_th] = lift_function(snd(hreal_tybij))([NADD_EQ_REFL, NADD_EQ_TRANS])("hreal_le")(NADD_LE_WELLDEF)

def [realax_hreal_inv_v2, hreal_inv_th] = lift_function(snd(hreal_tybij))([NADD_EQ_REFL, NADD_EQ_TRANS])("hreal_inv")(NADD_INV_WELLDEF)

def HREAL_COMPLETE:
  let th1:
    ASSUME(
      (hol:
         var P :: nadd -> bool
         var Q :: hreal -> bool
         const mk_hreal :: (nadd -> bool) -> hreal
         const nadd_eq :: nadd -> nadd -> bool
         P == (fun (x :: nadd): Q(mk_hreal(nadd_eq(x)))))
    )
  let th2 = BETA_RULE(AP_THM(th1)(hol: var x :: nadd; x))
  let th3 = lift_theorem(hreal_tybij)([NADD_EQ_REFL, NADD_EQ_SYM, NADD_EQ_TRANS])(PairList [hreal_of_num_th, hreal_add_th, hreal_mul_th, hreal_le_th, th2])(SPEC_ALL(NADD_COMPLETE))
  let th4:
    MATCH_MP(DISCH_ALL(th3))(
      REFL(
        (hol:
           var Q :: hreal -> bool
           const mk_hreal :: (nadd -> bool) -> hreal
           const nadd_eq :: nadd -> nadd -> bool
           fun (x :: nadd): Q(mk_hreal(nadd_eq(x))))
      )
    )
  CONV_RULE(GEN_ALPHA_CONV(hol: var P :: hreal -> bool; P))(GEN_ALL(th4))

def PairList [realax_HREAL_OF_NUM_EQ_v2, & PairList [realax_HREAL_OF_NUM_LE_v2, & PairList [realax_HREAL_OF_NUM_ADD_v2, & PairList [realax_HREAL_OF_NUM_MUL_v2, & PairList [realax_HREAL_LE_REFL_v2, & PairList [realax_HREAL_LE_TRANS_v2, & PairList [realax_HREAL_LE_ANTISYM_v2, & PairList [realax_HREAL_LE_TOTAL_v2, & PairList [realax_HREAL_LE_ADD_v2, & PairList [realax_HREAL_LE_EXISTS_v2, & PairList [realax_HREAL_ARCH_v2, & PairList [realax_HREAL_ADD_SYM_v2, & PairList [realax_HREAL_ADD_ASSOC_v2, & PairList [realax_HREAL_ADD_LID_v2, & PairList [realax_HREAL_ADD_LCANCEL_v2, & PairList [realax_HREAL_MUL_SYM_v2, & PairList [realax_HREAL_MUL_ASSOC_v2, & PairList [realax_HREAL_MUL_LID_v2, & PairList [realax_HREAL_ADD_LDISTRIB_v2, & PairList [realax_HREAL_MUL_LINV_v2, & PairList [HREAL_INV_0, & PairList []]]]]]]]]]]]]]]]]]]]]]:
  map(
    lift_theorem(hreal_tybij)([NADD_EQ_REFL, NADD_EQ_SYM, NADD_EQ_TRANS])(PairList [hreal_of_num_th, hreal_add_th, hreal_mul_th, hreal_le_th, hreal_inv_th])
  )(
    PairList [
      NADD_OF_NUM_EQ,
      NADD_OF_NUM_LE,
      NADD_OF_NUM_ADD,
      NADD_OF_NUM_MUL,
      NADD_LE_REFL,
      NADD_LE_TRANS,
      NADD_LE_ANTISYM,
      NADD_LE_TOTAL,
      NADD_LE_ADD,
      NADD_LE_EXISTS,
      NADD_ARCH,
      NADD_ADD_SYM,
      NADD_ADD_ASSOC,
      NADD_ADD_LID,
      NADD_ADD_LCANCEL,
      NADD_MUL_SYM,
      NADD_MUL_ASSOC,
      NADD_MUL_LID,
      NADD_LDISTRIB,
      NADD_MUL_LINV,
      NADD_INV_0
    ]
  )

def HREAL_LE_EXISTS_DEF:
  prove(
    [
      (hol:
         const hreal_le :: hreal -> hreal -> bool
         const hreal_add :: hreal -> hreal -> hreal
         forall (m :: hreal, n :: hreal): hreal_le(m, n) <=> (exists d :: hreal: n == hreal_add(m, d))),
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac \
            REWRITE_TAC(PairList [realax_HREAL_LE_EXISTS_v2])
          ) then_tac \
          DISCH_THEN(CHOOSE_THEN(SUBST1_TAC))
        ) then_tac \
        REWRITE_TAC(PairList [realax_HREAL_LE_ADD_v2])
      )
    ]
  )

def HREAL_EQ_ADD_LCANCEL:
  prove(
    [
      (hol:
         const hreal_add :: hreal -> hreal -> hreal
         forall (m :: hreal, n :: hreal, p :: hreal): hreal_add(m, n) == hreal_add(m, p) <=> n == p),
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac \
            REWRITE_TAC(PairList [realax_HREAL_ADD_LCANCEL_v2])
          ) then_tac \
          DISCH_THEN(SUBST1_TAC)
        ) then_tac \
        REFL_TAC
      )
    ]
  )

def HREAL_EQ_ADD_RCANCEL:
  prove(
    [
      (hol:
         const hreal_add :: hreal -> hreal -> hreal
         forall (m :: hreal, n :: hreal, p :: hreal): hreal_add(m, p) == hreal_add(n, p) <=> m == n),
      (
        ONCE_REWRITE_TAC(PairList [realax_HREAL_ADD_SYM_v2]) then_tac \
        REWRITE_TAC(PairList [HREAL_EQ_ADD_LCANCEL])
      )
    ]
  )

def HREAL_LE_ADD_LCANCEL:
  prove(
    [
      (hol:
         const hreal_le :: hreal -> hreal -> bool
         const hreal_add :: hreal -> hreal -> hreal
         forall (m :: hreal, n :: hreal, p :: hreal):
           hreal_le(hreal_add(m, n), hreal_add(m, p)) <=> hreal_le(n, p)),
      REWRITE_TAC(PairList [HREAL_LE_EXISTS_DEF, GSYM(realax_HREAL_ADD_ASSOC_v2), HREAL_EQ_ADD_LCANCEL])
    ]
  )

def HREAL_LE_ADD_RCANCEL:
  prove(
    [
      (hol:
         const hreal_le :: hreal -> hreal -> bool
         const hreal_add :: hreal -> hreal -> hreal
         forall (m :: hreal, n :: hreal, p :: hreal):
           hreal_le(hreal_add(m, p), hreal_add(n, p)) <=> hreal_le(m, n)),
      (
        ONCE_REWRITE_TAC(PairList [realax_HREAL_ADD_SYM_v2]) then_tac \
        MATCH_ACCEPT_TAC(HREAL_LE_ADD_LCANCEL)
      )
    ]
  )

def HREAL_ADD_RID:
  prove(
    [
      (hol:
         const hreal_add :: hreal -> hreal -> hreal
         const hreal_of_num :: num -> hreal
         forall n :: hreal: hreal_add(n, hreal_of_num((0 :: num))) == n),
      (
        ONCE_REWRITE_TAC(PairList [realax_HREAL_ADD_SYM_v2]) then_tac \
        MATCH_ACCEPT_TAC(realax_HREAL_ADD_LID_v2)
      )
    ]
  )

def HREAL_ADD_RDISTRIB:
  prove(
    [
      (hol:
         const hreal_mul :: hreal -> hreal -> hreal
         const hreal_add :: hreal -> hreal -> hreal
         forall (m :: hreal, n :: hreal, p :: hreal):
           hreal_mul(hreal_add(m, n), p) == hreal_add(hreal_mul(m, p), hreal_mul(n, p))),
      (
        ONCE_REWRITE_TAC(PairList [realax_HREAL_MUL_SYM_v2]) then_tac \
        MATCH_ACCEPT_TAC(realax_HREAL_ADD_LDISTRIB_v2)
      )
    ]
  )

def HREAL_MUL_LZERO:
  prove(
    [
      (hol:
         const hreal_mul :: hreal -> hreal -> hreal
         const hreal_of_num :: num -> hreal
         forall m :: hreal: hreal_mul(hreal_of_num((0 :: num)), m) == hreal_of_num((0 :: num))),
      (
        (
          (
            (
              (
                GEN_TAC then_tac \
                MP_TAC(
                  SPECL(
                    PairList [
                      (hol:
                         const hreal_of_num :: num -> hreal
                         hreal_of_num((0 :: num))),
                      (hol:
                         const hreal_of_num :: num -> hreal
                         hreal_of_num((1 :: num))),
                      (hol: var m :: hreal; m)
                    ])(
                    HREAL_ADD_RDISTRIB
                  )
                )
              ) then_tac \
              REWRITE_TAC(PairList [realax_HREAL_ADD_LID_v2])
            ) then_tac \
            GEN_REWRITE_TAC(funpow(2)(LAND_CONV))(PairList [GSYM(realax_HREAL_ADD_LID_v2)])
          ) then_tac \
          REWRITE_TAC(PairList [HREAL_EQ_ADD_RCANCEL])
        ) then_tac \
        DISCH_THEN(o(ACCEPT_TAC)(SYM))
      )
    ]
  )

def HREAL_MUL_RZERO:
  prove(
    [
      (hol:
         const hreal_mul :: hreal -> hreal -> hreal
         const hreal_of_num :: num -> hreal
         forall m :: hreal: hreal_mul(m, hreal_of_num((0 :: num))) == hreal_of_num((0 :: num))),
      (
        ONCE_REWRITE_TAC(PairList [realax_HREAL_MUL_SYM_v2]) then_tac \
        MATCH_ACCEPT_TAC(HREAL_MUL_LZERO)
      )
    ]
  )

def HREAL_ADD_AC:
  prove(
    [
      (hol:
         var m :: hreal
         var n :: hreal
         var p :: hreal
         const hreal_add :: hreal -> hreal -> hreal
         hreal_add(m, n) == hreal_add(n, m)
           && (hreal_add(hreal_add(m, n), p) == hreal_add(m, hreal_add(n, p))
                 && hreal_add(m, hreal_add(n, p)) == hreal_add(n, hreal_add(m, p)))),
      (
        (
          (
            REWRITE_TAC(PairList [realax_HREAL_ADD_ASSOC_v2, EQT_INTRO(SPEC_ALL(realax_HREAL_ADD_SYM_v2))]) then_tac \
            AP_THM_TAC
          ) then_tac \
          AP_TERM_TAC
        ) then_tac \
        MATCH_ACCEPT_TAC(realax_HREAL_ADD_SYM_v2)
      )
    ]
  )

def HREAL_LE_ADD2:
  prove(
    [
      (hol:
         const hreal_le :: hreal -> hreal -> bool
         const hreal_add :: hreal -> hreal -> hreal
         forall (a :: hreal, b :: hreal, c :: hreal, d :: hreal):
           hreal_le(a, b) && hreal_le(c, d) ==> hreal_le(hreal_add(a, c), hreal_add(b, d))),
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [HREAL_LE_EXISTS_DEF])) then_tac \
            DISCH_THEN(
              CONJUNCTS_THEN2(X_CHOOSE_TAC(hol: var d1 :: hreal; d1))(X_CHOOSE_TAC(hol: var d2 :: hreal; d2))
            )
          ) then_tac \
          EXISTS_TAC(
            (hol:
               var d1 :: hreal
               var d2 :: hreal
               const hreal_add :: hreal -> hreal -> hreal
               hreal_add(d1, d2))
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList [HREAL_ADD_AC])
      )
    ]
  )

def HREAL_LE_MUL_RCANCEL_IMP:
  prove(
    [
      (hol:
         const hreal_le :: hreal -> hreal -> bool
         const hreal_mul :: hreal -> hreal -> hreal
         forall (a :: hreal, b :: hreal, c :: hreal):
           hreal_le(a, b) ==> hreal_le(hreal_mul(a, c), hreal_mul(b, c))),
      (
        (
          (
            (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [HREAL_LE_EXISTS_DEF])) then_tac \
            DISCH_THEN(X_CHOOSE_THEN(hol: var d :: hreal; d)(SUBST1_TAC))
          ) then_tac \
          EXISTS_TAC(
            (hol:
               var d :: hreal
               var c :: hreal
               const hreal_mul :: hreal -> hreal -> hreal
               hreal_mul(d, c))
          )
        ) then_tac \
        REWRITE_TAC(PairList [HREAL_ADD_RDISTRIB])
      )
    ]
  )

def treal_of_num:
  new_definition(
    (hol:
       var treal_of_num :: num -> pair(hreal, hreal)
       var n :: num
       const #{|,|} :: hreal -> hreal -> pair(hreal, hreal)
       const hreal_of_num :: num -> hreal
       treal_of_num(n) == #{|,|}(hreal_of_num(n), hreal_of_num((0 :: num))))
  )

def treal_neg:
  new_definition(
    (hol:
       var treal_neg :: pair(hreal, hreal) -> pair(hreal, hreal)
       var x :: hreal
       var y :: hreal
       const #{|,|} :: hreal -> hreal -> pair(hreal, hreal)
       treal_neg(#{|,|}(x, y)) == #{|,|}(y, x))
  )

def treal_add:
  new_definition(
    (hol:
       var treal_add :: pair(hreal, hreal) -> pair(hreal, hreal) -> pair(hreal, hreal)
       var x1 :: hreal
       var y1 :: hreal
       var x2 :: hreal
       var y2 :: hreal
       const #{|,|} :: hreal -> hreal -> pair(hreal, hreal)
       const hreal_add :: hreal -> hreal -> hreal
       treal_add(#{|,|}(x1, y1), #{|,|}(x2, y2)) == #{|,|}(hreal_add(x1, x2), hreal_add(y1, y2)))
  )

def treal_mul:
  new_definition(
    (hol:
       var treal_mul :: pair(hreal, hreal) -> pair(hreal, hreal) -> pair(hreal, hreal)
       var x1 :: hreal
       var y1 :: hreal
       var x2 :: hreal
       var y2 :: hreal
       const #{|,|} :: hreal -> hreal -> pair(hreal, hreal)
       const hreal_add :: hreal -> hreal -> hreal
       const hreal_mul :: hreal -> hreal -> hreal
       treal_mul(#{|,|}(x1, y1), #{|,|}(x2, y2))
         == #{|,|}(
              hreal_add(hreal_mul(x1, x2), hreal_mul(y1, y2)),
              hreal_add(hreal_mul(x1, y2), hreal_mul(y1, x2))
            ))
  )

def treal_le:
  new_definition(
    (hol:
       var treal_le :: pair(hreal, hreal) -> pair(hreal, hreal) -> bool
       var x1 :: hreal
       var y1 :: hreal
       var x2 :: hreal
       var y2 :: hreal
       const #{|,|} :: hreal -> hreal -> pair(hreal, hreal)
       const hreal_le :: hreal -> hreal -> bool
       const hreal_add :: hreal -> hreal -> hreal
       treal_le(#{|,|}(x1, y1), #{|,|}(x2, y2)) <=> hreal_le(hreal_add(x1, y2), hreal_add(x2, y1)))
  )

def treal_inv:
  new_definition(
    (hol:
       var treal_inv :: pair(hreal, hreal) -> pair(hreal, hreal)
       var x :: hreal
       var y :: hreal
       const #{|,|} :: hreal -> hreal -> pair(hreal, hreal)
       const hreal_of_num :: num -> hreal
       const hreal_le :: hreal -> hreal -> bool
       const hreal_inv :: hreal -> hreal
       const #{@} :: (hreal -> bool) -> hreal
       const hreal_add :: hreal -> hreal -> hreal
       treal_inv(#{|,|}(x, y))
         == (if x == y
             | #{|,|}(hreal_of_num((0 :: num)), hreal_of_num((0 :: num)))
             | if hreal_le(y, x)
               | #{|,|}(
                   hreal_inv(#{@}(fun (d :: hreal): x == hreal_add(y, d))),
                   hreal_of_num((0 :: num))
                 )
               | #{|,|}(
                   hreal_of_num((0 :: num)),
                   hreal_inv(#{@}(fun (d :: hreal): y == hreal_add(x, d)))
                 )))
  )

def treal_eq:
  new_definition(
    (hol:
       var treal_eq :: pair(hreal, hreal) -> pair(hreal, hreal) -> bool
       var x1 :: hreal
       var y1 :: hreal
       var x2 :: hreal
       var y2 :: hreal
       const #{|,|} :: hreal -> hreal -> pair(hreal, hreal)
       const hreal_add :: hreal -> hreal -> hreal
       treal_eq(#{|,|}(x1, y1), #{|,|}(x2, y2)) <=> hreal_add(x1, y2) == hreal_add(x2, y1))
  )

def TREAL_EQ_REFL:
  prove(
    [
      (hol:
         const treal_eq :: pair(hreal, hreal) -> pair(hreal, hreal) -> bool
         forall x :: pair(hreal, hreal): treal_eq(x, x)),
      REWRITE_TAC(PairList [FORALL_PAIR_THM, treal_eq])
    ]
  )

def TREAL_EQ_SYM:
  prove(
    [
      (hol:
         const treal_eq :: pair(hreal, hreal) -> pair(hreal, hreal) -> bool
         forall (x :: pair(hreal, hreal), y :: pair(hreal, hreal)): treal_eq(x, y) <=> treal_eq(y, x)),
      REWRITE_TAC(PairList [FORALL_PAIR_THM, treal_eq, EQ_SYM_EQ])
    ]
  )

def TREAL_EQ_TRANS:
  prove(
    [
      (hol:
         const treal_eq :: pair(hreal, hreal) -> pair(hreal, hreal) -> bool
         forall (x :: pair(hreal, hreal), y :: pair(hreal, hreal), z :: pair(hreal, hreal)):
           treal_eq(x, y) && treal_eq(y, z) ==> treal_eq(x, z)),
      (
        (
          (
            (
              (
                (
                  REWRITE_TAC(PairList [FORALL_PAIR_THM, treal_eq]) then_tac \
                  REPEAT(GEN_TAC)
                ) then_tac \
                DISCH_THEN(
                  o(
                    o(o(MP_TAC)(MK_COMB))(
                      F_F(
                        AP_TERM(
                          (hol: const hreal_add :: hreal -> hreal -> hreal; hreal_add)
                        )
                      )(I)
                    )
                  )(CONJ_PAIR)
                )
              ) then_tac \
              GEN_REWRITE_TAC(o(LAND_CONV)(LAND_CONV))(PairList [realax_HREAL_ADD_SYM_v2])
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(realax_HREAL_ADD_ASSOC_v2), HREAL_EQ_ADD_LCANCEL])
          ) then_tac \
          REWRITE_TAC(PairList [realax_HREAL_ADD_ASSOC_v2, HREAL_EQ_ADD_RCANCEL])
        ) then_tac \
        DISCH_THEN(o(MATCH_ACCEPT_TAC)(ONCE_REWRITE_RULE(PairList [realax_HREAL_ADD_SYM_v2])))
      )
    ]
  )

def TREAL_EQ_AP:
  prove(
    [
      (hol:
         const treal_eq :: pair(hreal, hreal) -> pair(hreal, hreal) -> bool
         forall (x :: pair(hreal, hreal), y :: pair(hreal, hreal)): x == y ==> treal_eq(x, y)),
      SIMP_TAC(PairList [TREAL_EQ_REFL])
    ]
  )

def TREAL_OF_NUM_EQ:
  prove(
    [
      (hol:
         const treal_eq :: pair(hreal, hreal) -> pair(hreal, hreal) -> bool
         const treal_of_num :: num -> pair(hreal, hreal)
         forall (m :: num, n :: num): treal_eq(treal_of_num(m), treal_of_num(n)) <=> m == n),
      REWRITE_TAC(PairList [treal_of_num, treal_eq, realax_HREAL_OF_NUM_EQ_v2, HREAL_ADD_RID])
    ]
  )

def TREAL_OF_NUM_LE:
  prove(
    [
      (hol:
         const treal_le :: pair(hreal, hreal) -> pair(hreal, hreal) -> bool
         const treal_of_num :: num -> pair(hreal, hreal)
         forall (m :: num, n :: num): treal_le(treal_of_num(m), treal_of_num(n)) <=> m <= n),
      REWRITE_TAC(PairList [treal_of_num, treal_le, realax_HREAL_OF_NUM_LE_v2, HREAL_ADD_RID])
    ]
  )

def TREAL_OF_NUM_ADD:
  prove(
    [
      (hol:
         const treal_eq :: pair(hreal, hreal) -> pair(hreal, hreal) -> bool
         const treal_add :: pair(hreal, hreal) -> pair(hreal, hreal) -> pair(hreal, hreal)
         const treal_of_num :: num -> pair(hreal, hreal)
         forall (m :: num, n :: num):
           treal_eq(treal_add(treal_of_num(m), treal_of_num(n)), treal_of_num(m + n))),
      REWRITE_TAC(
