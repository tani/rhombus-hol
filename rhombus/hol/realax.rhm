def TREAL_ADD_WELLDEFR:
  prove(
    [
      @hol|{!x1 x2 y. x1 treal_eq x2 ==> (x1 treal_add y) treal_eq (x2 treal_add y)}|,
      (
        (
          (
            REWRITE_TAC(PairList [FORALL_PAIR_THM, treal_add, treal_eq]) then_tac \
            REWRITE_TAC(PairList [HREAL_EQ_ADD_RCANCEL, realax_HREAL_ADD_ASSOC_v2])
          ) then_tac \
          ONCE_REWRITE_TAC(PairList [realax_HREAL_ADD_SYM_v2])
        ) then_tac \
