                DISCH_THEN(o(MP_TAC)(MATCH_MP(HREAL_LE_ADD2)))
              ) then_tac \
              GEN_REWRITE_TAC(o(LAND_CONV)(LAND_CONV))(PairList [realax_HREAL_ADD_SYM_v2])
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(realax_HREAL_ADD_ASSOC_v2), HREAL_LE_ADD_LCANCEL])
