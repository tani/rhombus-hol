def NADD_ALTMUL:
  prove(
    [
      @hol|{!x y. ?A B. !n. dist(n * fn x (fn y n),fn x n * fn y n) <= A * n + B}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              REPEAT(GEN_TAC) then_tac \
                              X_CHOOSE_TAC(@hol|{B:num}|)(SPEC(@hol|{x:nadd}|)(NADD_CAUCHY))
                            ) then_tac \
                            MP_TAC(SPEC(@hol|{y:nadd}|)(NADD_BOUND))
                          ) then_tac \
                          DISCH_THEN(
                            X_CHOOSE_THEN(@hol|{M:num}|)(X_CHOOSE_TAC(@hol|{L:num}|))
                          )
                        ) then_tac \
                        MAP_EVERY(EXISTS_TAC)(
                          PairList [
                            @hol|{B * (1 + M)}|,
                            @hol|{B * L}|
                          ]
                        )
                      ) then_tac \
