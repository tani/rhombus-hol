                                (
                                  FIRST_ASSUM(o(MP_TAC)(MATCH_MP(realax_REAL_LE_LADD_IMP_v2))) then_tac \
                                  DISCH_THEN(
                                    o(MP_TAC)(SPEC(@hol|{--x}|))
                                  )
                                ) then_tac \
                                REWRITE_TAC(PairList [realax_REAL_ADD_LINV_v2])
