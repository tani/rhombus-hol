def initialization_3:
  TypeInference.override_interface(
    [
      "**",
      @hol|{nadd_mul:nadd->nadd->nadd}|
    ]
  )

def nadd_mul:
  new_definition(
    @hol|{x ** y = afn(\n. fn x (fn y n))}|
  )

def NADD_MUL:
  prove(
    [
      @hol|{!x y. fn(x ** y) = \n. fn x (fn y n)}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              REPEAT(GEN_TAC) then_tac \
                              REWRITE_TAC(PairList [nadd_mul, GSYM(nadd_rep), is_nadd])
                            ) then_tac \
                            X_CHOOSE_TAC(@hol|{B:num}|)(SPEC(@hol|{y:nadd}|)(NADD_CAUCHY))
                          ) then_tac \
                          X_CHOOSE_TAC(@hol|{C:num}|)(SPEC(@hol|{x:nadd}|)(NADD_DIST))
                        ) then_tac \
                        X_CHOOSE_TAC(@hol|{D:num}|)(SPEC(@hol|{x:nadd}|)(NADD_MULTIPLICATIVE))
                      ) then_tac \
                      MATCH_MP_TAC(BOUNDS_NOTZERO)
                    ) then_tac \
                    REWRITE_TAC(PairList [MULT_CLAUSES, DIST_REFL])
                  ) then_tac \
                  MAP_EVERY(EXISTS_TAC)(
                    PairList [
                      @hol|{D + C * B}|,
                      @hol|{D + D}|
                    ]
                  )
                ) then_tac \
                REPEAT(GEN_TAC)
              ) then_tac \
              MATCH_MP_TAC(LE_TRANS)
            ) then_tac \
            EXISTS_TAC(
              @hol|{(D * m + D) + (D * n + D) + C * B * (m + n)}|
            )
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  MATCH_MP_TAC(LE_IMP(realax_DIST_TRIANGLE_v2)) then_tac \
                                  EXISTS_TAC(
                                    @hol|{fn x (m * fn y n)}|
                                  )
                                ) then_tac \
                                MATCH_MP_TAC(LE_ADD2)
                              ) then_tac \
                              ONCE_REWRITE_TAC(PairList [DIST_SYM])
                            ) then_tac \
                            ASM_REWRITE_TAC(PairList [])
                          ) then_tac \
                          MATCH_MP_TAC(LE_IMP(realax_DIST_TRIANGLE_v2))
                        ) then_tac \
                        EXISTS_TAC(
                          @hol|{fn x (n * fn y m)}|
                        )
                      ) then_tac \
                      MATCH_MP_TAC(LE_ADD2)
                    ) then_tac \
                    ONCE_REWRITE_TAC(PairList [DIST_SYM])
                  ) then_tac \
                  ASM_REWRITE_TAC(PairList [])
                ) then_tac \
                MATCH_MP_TAC(LE_TRANS)
              ) then_tac \
              EXISTS_TAC(
                @hol|{C * dist(m * fn y n,n * fn y m)}|
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [LE_MULT_LCANCEL])
          ),
          (
            MATCH_MP_TAC(EQ_IMP_LE) then_tac \
            REWRITE_TAC(PairList [LEFT_ADD_DISTRIB, RIGHT_ADD_DISTRIB, MULT_ASSOC, ADD_AC])
          )
        ]
      )
    ]
  )

