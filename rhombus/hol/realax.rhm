                      EXISTS_TAC(hol: var n :: num; n)
                    ) then_tac \
                    POP_ASSUM(MP_TAC)
                  ) then_tac \
                  ASM_CASES_TAC(
                    (hol:
                       var n :: num
                       n == (0 :: num))
