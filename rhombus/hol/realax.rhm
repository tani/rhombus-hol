                        GSYM(LE_MULT_LCANCEL),
                        DIST_LMUL
                      ]
                    )
                  ) then_tac \
                  REWRITE_TAC(PairList [MULT_ASSOC])
                ) then_tac \
                GEN_REWRITE_TAC(
                  o(o(o(LAND_CONV)(RAND_CONV))(RAND_CONV))(LAND_CONV))(
                  PairList [MULT_SYM]
