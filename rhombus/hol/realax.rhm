                  (
                    (
                      (
                        ASM_REWRITE_TAC(PairList [nadd_le, NADD_ADD, NADD_MUL, NADD_OF_NUM]) then_tac \
                        EXISTS_TAC(@hol|{0}|)
                      ) then_tac \
                      REWRITE_TAC(PairList [ADD_CLAUSES, MULT_CLAUSES])
                    ) then_tac \
