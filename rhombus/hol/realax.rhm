def NADD_LE_TOTAL_LEMMA:
  prove(
    [
      (hol:
         const nadd_le :: nadd -> nadd -> bool
         const dest_nadd :: nadd -> num -> num
         forall (x :: nadd, y :: nadd):
           !nadd_le(x, y)
             ==> (forall B :: num:
                    exists n :: num: n != (0 :: num) && dest_nadd(y, n) + B < dest_nadd(x, n))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
