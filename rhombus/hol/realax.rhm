TypeInference.make_overloadable("*")(@hol|{:A->A->A}|)

TypeInference.make_overloadable("/")(@hol|{:A->A->A}|)

TypeInference.make_overloadable("<")(@hol|{:A->A->bool}|)

TypeInference.make_overloadable("<=")(@hol|{:A->A->bool}|)

TypeInference.make_overloadable(">")(@hol|{:A->A->bool}|)

TypeInference.make_overloadable(">=")(@hol|{:A->A->bool}|)

TypeInference.make_overloadable("--")(@hol|{:A->A}|)

