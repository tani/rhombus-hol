                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              )
            ]
          )
        ]
      )
    ]
  )

def NADD_UBOUND:
  prove(
    [
      @hol|{!x. ?B N. !n. N <= n ==> fn x n <= B * n}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          GEN_TAC then_tac \
                          X_CHOOSE_THEN(@hol|{A1:num}|)(X_CHOOSE_TAC(@hol|{A2:num}|))(SPEC(@hol|{x:nadd}|)(NADD_BOUND))
                        ) then_tac \
                        EXISTS_TAC(@hol|{A1 + A2}|)
                      ) then_tac \
                      EXISTS_TAC(
                        @hol|{1}|
                      )
                    ) then_tac \
                    REPEAT(STRIP_TAC)
                  ) then_tac \
                  MATCH_MP_TAC(LE_TRANS)
                ) then_tac \
                EXISTS_TAC(
                  @hol|{A1 * n + A2}|
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, LE_ADD_LCANCEL])
          ) then_tac \
          GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(el(3)(CONJUNCTS(MULT_CLAUSES)))])
        ) then_tac \
        ASM_REWRITE_TAC(PairList [LE_MULT_LCANCEL])
      )
    ]
  )

def NADD_NONZERO:
  prove(
    [
      @hol|{!x. ~(x === &0) ==> ?N. !n. N <= n ==> ~(fn x n = 0)}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (GEN_TAC then_tac DISCH_THEN(o(MP_TAC)(MATCH_MP(NADD_ARCH_MULT)))) then_tac \
                          DISCH_THEN(
                            o(MP_TAC)(
                              SPEC(
                                @hol|{1}|
                              )
                            )
                          )
                        ) then_tac \
                        REWRITE_TAC(PairList [nadd_le, NADD_MUL, NADD_OF_NUM, MULT_CLAUSES])
                      ) then_tac \
                      DISCH_THEN(
                        X_CHOOSE_THEN(@hol|{A1:num}|)(X_CHOOSE_TAC(@hol|{A2:num}|))
                      )
                    ) then_tac \
                    EXISTS_TAC(
                      @hol|{A2 + 1}|
                    )
                  ) then_tac \
                  X_GEN_TAC(@hol|{n:num}|)
                ) then_tac \
                REPEAT(DISCH_TAC)
              ) then_tac \
              FIRST_ASSUM(o(o(UNDISCH_TAC)(check(is_forall)))(concl))
            ) then_tac \
            REWRITE_TAC(PairList [NOT_FORALL_THM, NOT_LE, GSYM(LE_SUC_LT), ADD1])
          ) then_tac \
          EXISTS_TAC(@hol|{n:num}|)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [MULT_CLAUSES, ADD_CLAUSES])
      )
    ]
  )

def NADD_LBOUND:
  prove(
    [
      @hol|{!x. ~(x === &0) ==> ?A N. !n. N <= n ==> n <= A * fn x n}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (GEN_TAC then_tac DISCH_TAC) then_tac \
                                        FIRST_ASSUM(o(X_CHOOSE_TAC(@hol|{N:num}|))(MATCH_MP(NADD_NONZERO)))
                                      ) then_tac \
                                      FIRST_ASSUM(o(MP_TAC)(MATCH_MP(NADD_ARCH_MULT)))
                                    ) then_tac \
                                    DISCH_THEN(
                                      o(MP_TAC)(
                                        SPEC(
                                          @hol|{1}|
                                        )
                                      )
                                    )
                                  ) then_tac \
                                  REWRITE_TAC(PairList [nadd_le, NADD_MUL, NADD_OF_NUM, MULT_CLAUSES])
                                ) then_tac \
                                DISCH_THEN(
                                  X_CHOOSE_THEN(@hol|{A1:num}|)(X_CHOOSE_TAC(@hol|{A2:num}|))
                                )
                              ) then_tac \
                              EXISTS_TAC(@hol|{A1 + A2}|)
                            ) then_tac \
                            EXISTS_TAC(@hol|{N:num}|)
                          ) then_tac \
                          GEN_TAC
                        ) then_tac \
                        DISCH_THEN(ANTE_RES_THEN(ASSUME_TAC))
                      ) then_tac \
                      MATCH_MP_TAC(LE_TRANS)
                    ) then_tac \
                    EXISTS_TAC(
                      @hol|{A1 * fn x n + A2}|
                    )
                  ) then_tac \
                  ASM_REWRITE_TAC(PairList [RIGHT_ADD_DISTRIB, LE_ADD_LCANCEL])
                ) then_tac \
                GEN_REWRITE_TAC(LAND_CONV)(PairList [GSYM(el(3)(CONJUNCTS(MULT_CLAUSES)))])
              ) then_tac \
              REWRITE_TAC(PairList [LE_MULT_LCANCEL])
            ) then_tac \
            DISJ2_TAC
          ) then_tac \
          REWRITE_TAC(
            PairList [
              GSYM(
                REWRITE_CONV(PairList [ARITH_SUC])(
                  @hol|{SUC 0}|
                )
              )
            ]
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList [GSYM(NOT_LT), LT])
      )
    ]
  )

def nadd_rinv:
  new_definition(
    @hol|{nadd_rinv(x) = \n. (n * n) DIV (fn x n)}|
  )

def NADD_MUL_LINV_LEMMA0:
  prove(
    [
      @hol|{!x. ~(x === &0) ==> ?A B. !n. nadd_rinv x n <= A * n + B}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (GEN_TAC then_tac DISCH_TAC) then_tac \
                                          ONCE_REWRITE_TAC(PairList [BOUNDS_IGNORE])
                                        ) then_tac \
                                        FIRST_ASSUM(o(MP_TAC)(MATCH_MP(NADD_LBOUND)))
                                      ) then_tac \
                                      DISCH_THEN(
                                        X_CHOOSE_THEN(@hol|{A:num}|)(X_CHOOSE_TAC(@hol|{N:num}|))
                                      )
                                    ) then_tac \
                                    MAP_EVERY(EXISTS_TAC)(
                                      PairList [
                                        @hol|{A:num}|,
                                        @hol|{0}|,
                                        @hol|{SUC N}|
                                      ]
                                    )
                                  ) then_tac \
                                  GEN_TAC
                                ) then_tac \
                                DISCH_TAC
                              ) then_tac \
                              REWRITE_TAC(PairList [ADD_CLAUSES])
                            ) then_tac \
                            MP_TAC(
                              SPECL(
                                PairList [
                                  @hol|{nadd_rinv x n}|,
                                  @hol|{A * n}|,
                                  @hol|{n:num}|
                                ])(
                                LE_MULT_RCANCEL
                              )
                            )
                          ) then_tac \
                          UNDISCH_TAC(
                            @hol|{SUC N <= n}|
                          )
                        ) then_tac \
                        ASM_CASES_TAC(
                          @hol|{n = 0}|
                        )
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [LE, NOT_SUC])
                    ) then_tac \
                    DISCH_TAC
                  ) then_tac \
                  DISCH_THEN(o(SUBST1_TAC)(SYM))
                ) then_tac \
                MATCH_MP_TAC(LE_TRANS)
              ) then_tac \
              EXISTS_TAC(
                @hol|{nadd_rinv x n * A * fn x n}|
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [LE_MULT_LCANCEL])
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (DISJ2_TAC then_tac FIRST_ASSUM(MATCH_MP_TAC)) then_tac \
                MATCH_MP_TAC(LE_TRANS)
              ) then_tac \
              EXISTS_TAC(@hol|{SUC N}|)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [LE, LE_REFL])
          ),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          GEN_REWRITE_TAC(LAND_CONV)(PairList [MULT_SYM]) then_tac \
