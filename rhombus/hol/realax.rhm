                ASM_REWRITE_TAC(PairList [ADD_ASSOC, LE_ADD])
              ),
              ALL_TAC
            ]
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        (X_GEN_TAC(@hol|{x:nadd}|) then_tac DISCH_TAC) then_tac \
                        MATCH_MP_TAC(NADD_ARCH_LEMMA)
                      ) then_tac \
