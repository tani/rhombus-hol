                        (
                          EXISTS_TAC(
                            @hol|{&0}|
                          ) then_tac \
                          ASM_REWRITE_TAC(PairList [realax_REAL_LE_REFL_v2, realax_REAL_ADD_LID_v2])
                        ),
                        (
                          (
                            (
