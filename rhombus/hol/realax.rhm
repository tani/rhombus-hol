def nadd_rinv:
  new_definition(
    (hol:
       var nadd_rinv :: nadd -> num -> num
       var x :: nadd
       const DIV :: num -> num -> num
       const dest_nadd :: nadd -> num -> num
       nadd_rinv(x) == (fun (n :: num): DIV(n * n, dest_nadd(x, n))))
  )

