def real_tybij:
  define_quotient_type(
    "real")(
    ["mk_real", "dest_real"])(
    @hol|{(treal_eq)}|
  )

def [realax_real_of_num_v2, real_of_num_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_of_num")(TREAL_OF_NUM_WELLDEF)

def [realax_real_neg_v2, real_neg_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_neg")(TREAL_NEG_WELLDEF)

def [realax_real_add_v2, real_add_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_add")(TREAL_ADD_WELLDEF)

def [realax_real_mul_v2, real_mul_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_mul")(TREAL_MUL_WELLDEF)

def [realax_real_le_v2, real_le_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_le")(TREAL_LE_WELLDEF)

def [realax_real_inv_v2, real_inv_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_inv")(TREAL_INV_WELLDEF)

def PairList [realax_REAL_ADD_SYM_v2, & PairList [realax_REAL_ADD_ASSOC_v2, & PairList [realax_REAL_ADD_LID_v2, & PairList [realax_REAL_ADD_LINV_v2, & PairList [realax_REAL_MUL_SYM_v2, & PairList [realax_REAL_MUL_ASSOC_v2, & PairList [realax_REAL_MUL_LID_v2, & PairList [realax_REAL_ADD_LDISTRIB_v2, & PairList [realax_REAL_LE_REFL_v2, & PairList [realax_REAL_LE_ANTISYM_v2, & PairList [realax_REAL_LE_TRANS_v2, & PairList [realax_REAL_LE_TOTAL_v2, & PairList [realax_REAL_LE_LADD_IMP_v2, & PairList [realax_REAL_LE_MUL_v2, & PairList [realax_REAL_INV_0_v2, & PairList [realax_REAL_MUL_LINV_v2, & PairList [realax_REAL_OF_NUM_EQ_v2, & PairList [realax_REAL_OF_NUM_LE_v2, & PairList [realax_REAL_OF_NUM_ADD_v2, & PairList [REAL_OF_NUM_MUL, & PairList []]]]]]]]]]]]]]]]]]]]]:
  map(
    lift_theorem(real_tybij)([TREAL_EQ_REFL, TREAL_EQ_SYM, TREAL_EQ_TRANS])(PairList [real_of_num_th, real_neg_th, real_add_th, real_mul_th, real_le_th, real_inv_th])
  )(
    PairList [
      TREAL_ADD_SYM,
      TREAL_ADD_ASSOC,
      TREAL_ADD_LID,
      TREAL_ADD_LINV,
      TREAL_MUL_SYM,
      TREAL_MUL_ASSOC,
      TREAL_MUL_LID,
      TREAL_ADD_LDISTRIB,
      TREAL_LE_REFL,
      TREAL_LE_ANTISYM,
      TREAL_LE_TRANS,
      TREAL_LE_TOTAL,
      TREAL_LE_LADD_IMP,
      TREAL_LE_MUL,
      TREAL_INV_0,
      TREAL_MUL_LINV,
      TREAL_OF_NUM_EQ,
      TREAL_OF_NUM_LE,
      TREAL_OF_NUM_ADD,
      TREAL_OF_NUM_MUL
    ]
  )

Host.parse_as_prefix("--")

Host.parse_as_infix(["/", [22, "left"]])

Host.parse_as_infix(["pow", [24, "left"]])

def initialization_6:
  do_list(TypeInference.overload_interface)(
    PairList [
      ["+", @hol|{real_add:real->real->real}|],
      ["-", @hol|{real_sub:real->real->real}|],
      ["*", @hol|{real_mul:real->real->real}|],
      ["/", @hol|{real_div:real->real->real}|],
      ["<", @hol|{real_lt:real->real->bool}|],
      ["<=", @hol|{real_le:real->real->bool}|],
      [">", @hol|{real_gt:real->real->bool}|],
      [">=", @hol|{real_ge:real->real->bool}|],
      ["--", @hol|{real_neg:real->real}|],
      ["pow", @hol|{real_pow:real->num->real}|],
      ["inv", @hol|{real_inv:real->real}|],
      ["abs", @hol|{real_abs:real->real}|],
      ["max", @hol|{real_max:real->real->real}|],
      ["min", @hol|{real_min:real->real->real}|],
      ["&", @hol|{real_of_num:num->real}|]
    ]
  )

fun prioritize_real(_): TypeInference.prioritize_overload(mk_type(["real", PairList []]))

def real_sub:
  new_definition(
    @hol|{x - y = x + --y}|
  )

def real_lt:
  new_definition(
    @hol|{x < y <=> ~(y <= x)}|
  )

def real_ge:
  new_definition(
    @hol|{x >= y <=> y <= x}|
  )

def real_gt:
  new_definition(
    @hol|{x > y <=> y < x}|
  )

def real_abs:
  new_definition(
    @hol|{abs(x) = if &0 <= x then x else --x}|
  )

def real_pow:
  new_recursive_definition(num_RECURSION)(
    @hol|{(x pow 0 = &1) /\
       (!n. x pow (SUC n) = x * (x pow n))}|
  )

def real_div:
  new_definition(
    @hol|{x / y = x * inv(y)}|
  )

def real_max:
  new_definition(
    @hol|{real_max m n = if m <= n then n else m}|
  )

def real_min:
  new_definition(
    @hol|{real_min m n = if m <= n then m else n}|
  )

