def TREAL_EQ_TRANS:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Tyapp("prod", [Tyapp("hreal", []), Tyapp("hreal", [])]),
        Forall(
          "y",
          Tyapp("prod", [Tyapp("hreal", []), Tyapp("hreal", [])]),
          Forall(
            "z",
            Tyapp("prod", [Tyapp("hreal", []), Tyapp("hreal", [])]),
            Implies(
              And(
                App(
                  Const(
                    "treal_eq",
                    Fun(
                      Tyapp("prod", [Tyapp("hreal", []), Tyapp("hreal", [])]),
                      Fun(Tyapp("prod", [Tyapp("hreal", []), Tyapp("hreal", [])]), Bool)
                    )
                  ),
                  [Ref("x"), Ref("y")]
                ),
                App(
                  Const(
                    "treal_eq",
                    Fun(
                      Tyapp("prod", [Tyapp("hreal", []), Tyapp("hreal", [])]),
                      Fun(Tyapp("prod", [Tyapp("hreal", []), Tyapp("hreal", [])]), Bool)
                    )
                  ),
                  [Ref("y"), Ref("z")]
                )
              ),
              App(
                Const(
                  "treal_eq",
                  Fun(
                    Tyapp("prod", [Tyapp("hreal", []), Tyapp("hreal", [])]),
                    Fun(Tyapp("prod", [Tyapp("hreal", []), Tyapp("hreal", [])]), Bool)
                  )
                ),
                [Ref("x"), Ref("z")]
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  REWRITE_TAC(PairList [FORALL_PAIR_THM, treal_eq]) then_tac \
                  REPEAT(GEN_TAC)
                ) then_tac \
                DISCH_THEN(
                  o(
                    o(o(MP_TAC)(MK_COMB))(
                      Host.F_F(
                        AP_TERM(
                          Host.hol_term(Const("hreal_add", Fun(Tyapp("hreal", []), Fun(Tyapp("hreal", []), Tyapp("hreal", [])))))
                        )
                      )(I)
                    )
                  )(CONJ_PAIR)
                )
              ) then_tac \
              GEN_REWRITE_TAC(o(LAND_CONV)(LAND_CONV))(PairList [realax_HREAL_ADD_SYM_v2])
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(realax_HREAL_ADD_ASSOC_v2), HREAL_EQ_ADD_LCANCEL])
          ) then_tac \
          REWRITE_TAC(PairList [realax_HREAL_ADD_ASSOC_v2, HREAL_EQ_ADD_RCANCEL])
        ) then_tac \
        DISCH_THEN(o(MATCH_ACCEPT_TAC)(ONCE_REWRITE_RULE(PairList [realax_HREAL_ADD_SYM_v2])))
      )
    ]
  )

