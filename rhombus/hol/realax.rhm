def realax_DIST_SYM:«
  Up_tactics.prove(Pair(Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"dist\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]],[\"Tyapp\",\"num\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]]]],[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]],[\"Comb\",[\"Const\",\"dist\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]],[\"Tyapp\",\"num\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]],[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]]]]]]]]]"),(block:«
    let port_tmp_1 = Up_tactics.MATCH_ACCEPT_TAC(Up_arith.ADD_SYM);
    let port_tmp_2 = Up_simp.REWRITE_TAC(PairList.cons(realax_dist,PairList []));
    Up_tactics.THEN(port_tmp_2)(port_tmp_1)
  »)))
