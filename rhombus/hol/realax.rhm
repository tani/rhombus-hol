                                      NADD_LE_TOTAL
                                    )
                                  )
                                )
                              )(SPEC_ALL)
                            )
                          ) then_tac \
                          DISCH_TAC
                        )
                      ]
                    ) then_tac \
                    SUBGOAL_THEN(
                      @hol|{!n i. i * r(n) <= n * r(i) + n}|
                    )(ASSUME_TAC)
                  ) then_list \
                  PairList [
                    (
                      (
                        (
                          (
                            (
                              (
                                REPEAT(GEN_TAC) then_tac \
                                FIRST_ASSUM(
                                  o(X_CHOOSE_THEN(@hol|{x:nadd}|)(STRIP_ASSUME_TAC))(SPEC(@hol|{n:num}|))
