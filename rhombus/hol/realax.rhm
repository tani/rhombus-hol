                        ) then_tac \
                        CONJ_TAC
                      ) then_list \
                      PairList [
                        (
                          (
                            (
                              MATCH_MP_TAC(NADD_LE_TRANS) then_tac \
                              EXISTS_TAC(
                                @hol|{&i ** &(r(n:num))}|
