                                             const nadd_mul :: nadd -> nadd -> nadd
                                             const nadd_of_num :: num -> nadd
                                             nadd_mul(nadd_of_num(n), w))
                                        )
                                      ) then_tac \
                                      ASM_REWRITE_TAC(PairList [])
                                    ) then_tac \
                                    MATCH_MP_TAC(NADD_LE_TRANS)
                                  ) then_tac \
                                  EXISTS_TAC(
                                    (hol:
                                       var n :: num
                                       var N :: num
                                       const nadd_mul :: nadd -> nadd -> nadd
                                       const nadd_of_num :: num -> nadd
                                       nadd_mul(nadd_of_num(n), nadd_of_num(N)))
