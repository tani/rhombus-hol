def real_tybij:
  define_quotient_type(
    "real")(
    ["mk_real", "dest_real"])(
    (hol: const treal_eq :: pair(hreal, hreal) -> pair(hreal, hreal) -> bool; treal_eq)
  )

def [realax_real_of_num_v2, real_of_num_th] = lift_function(snd(real_tybij))([TREAL_EQ_REFL, TREAL_EQ_TRANS])("real_of_num")(TREAL_OF_NUM_WELLDEF)

