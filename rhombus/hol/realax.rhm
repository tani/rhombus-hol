              ),
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              REWRITE_TAC(PairList [NADD_LE_RADD]) then_tac \
                              FIRST_ASSUM(
                                o(X_CHOOSE_THEN(@hol|{x:nadd}|)(MP_TAC))(SPEC(@hol|{n:num}|))
                              )
                            ) then_tac \
                            DISCH_THEN(STRIP_ASSUME_TAC)
                          ) then_tac \
