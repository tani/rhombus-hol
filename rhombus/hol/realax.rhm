            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            MAP_EVERY(EXISTS_TAC)(
                              PairList [
                                (hol:
                                   var A1 :: num
                                   var A2 :: num
                                   A1 + A2),
                                (hol:
                                   var B1 :: num
