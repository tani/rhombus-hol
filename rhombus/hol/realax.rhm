fun realax_prioritize_num(_):«
  Up_type_inference.prioritize_overload(Up_fusion.mk_type(Pair("num",PairList [])))
»

def realax_dist:«
  Up_pair.new_definition(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"dist\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]],[\"Tyapp\",\"num\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]]]],[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"+\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"-\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]],[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"-\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]],[\"Var\",\"m\",[\"Tyapp\",\"num\",[]]]]]]"))
»

def realax_DIST_REFL:«
  Up_tactics.prove((block:«
    let port_tmp_1 = Up_simp.REWRITE_TAC(PairList.cons(realax_dist,PairList.cons(Up_arith.SUB_REFL,PairList.cons(Up_arith.ADD_CLAUSES,PairList []))));
    let port_tmp_2 = Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"dist\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]],[\"Tyapp\",\"num\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]],[\"Comb\",[\"Const\",\"NUMERAL\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Const\",\"_0\",[\"Tyapp\",\"num\",[]]]]]]]");
    Pair(port_tmp_2,port_tmp_1)
  »))
»

def realax_DIST_LZERO:«
  Up_tactics.prove((block:«
    let port_tmp_3 = Up_simp.REWRITE_TAC(PairList.cons(realax_dist,PairList.cons(Up_arith.SUB_0,PairList.cons(Up_arith.ADD_CLAUSES,PairList []))));
    let port_tmp_4 = Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"dist\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]],[\"Tyapp\",\"num\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\",\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"prod\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]]]]]],[\"Comb\",[\"Const\",\"NUMERAL\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"num\",[]],[\"Tyapp\",\"num\",[]]]]],[\"Const\",\"_0\",[\"Tyapp\",\"num\",[]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]],[\"Var\",\"n\",[\"Tyapp\",\"num\",[]]]]]]");
    Pair(port_tmp_4,port_tmp_3)
  »))
