      )
    ]
  )

def TREAL_LE_MUL:
  prove(
    [
      @hol|{!x y. (treal_of_num 0) treal_le x /\ (treal_of_num 0) treal_le y
         ==> (treal_of_num 0) treal_le (x treal_mul y)}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REWRITE_TAC(PairList [FORALL_PAIR_THM, treal_of_num, treal_le, treal_mul]) then_tac \
                        REPEAT(GEN_TAC)
                      ) then_tac \
                      REWRITE_TAC(PairList [realax_HREAL_ADD_LID_v2, HREAL_ADD_RID])
                    ) then_tac \
                    DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC))
                  ) then_tac \
                  DISCH_THEN(o(CHOOSE_THEN(SUBST1_TAC))(MATCH_MP(realax_HREAL_LE_EXISTS_v2)))
                ) then_tac \
                REWRITE_TAC(
                  PairList [
                    realax_HREAL_ADD_LDISTRIB_v2,
                    HREAL_LE_ADD_LCANCEL,
                    GSYM(realax_HREAL_ADD_ASSOC_v2)
                  ]
                )
              ) then_tac \
              GEN_REWRITE_TAC(RAND_CONV)(PairList [realax_HREAL_ADD_SYM_v2])
            ) then_tac \
            ASM_REWRITE_TAC(PairList [HREAL_LE_ADD_LCANCEL])
          ) then_tac \
          MATCH_MP_TAC(HREAL_LE_MUL_RCANCEL_IMP)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def TREAL_INV_0:
