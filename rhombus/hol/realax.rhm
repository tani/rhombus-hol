                  [App(Const(",", Fun(Num, Fun(Num, Tyapp("prod", [Num, Num])))), [Ref("m"), Ref("n")])]
                ),
                App(Const("+", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])
              ]
            )
          )
        )),
