export:
  prove_recursive_functions_exist
  new_recursive_definition

def prove_recursive_functions_exist:
  let prove_raw_recursive_functions_exist:
    fun(ax):
      fun(tm):
        let rawcls = conjuncts(tm)
        let spcls = map(o(snd)(strip_forall))(rawcls)
        let lpats = map(o(strip_comb)(lhand))(spcls)
        let ufns = itlist(o(insert)(fst))(lpats)(PairList [])
        let axth = SPEC_ALL(ax)
        let [exvs, axbody] = strip_exists(concl(axth))
        let axcls = conjuncts(axbody)
        let f:
          o(
            o(o(o(o(o(fst)(dest_const))(Host.repeat(rator)))(rand))(lhand))(snd)
          )(strip_forall)
        let findax = C(assoc)(map((fun(t): [f(t), t]))(axcls))
        let raxs = map(o(o(o(o(o(findax)(fst))(dest_const))(Host.repeat(rator)))(hd))(snd))(lpats)
        let axfns = map(o(o(o(Host.repeat(rator))(lhand))(snd))(strip_forall))(raxs)
        let urfns = map((fun(v): Host.assocd(v)(Host.setify(zip(axfns)(map(fst)(lpats))))(v)))(exvs)
        let axtm_2 = list_mk_exists([exvs, list_mk_conj(raxs)])
        let urtm_2 = list_mk_exists([urfns, tm])
        let insts = term_match(PairList [])(axtm_2)(urtm_2)
        let ixth = INSTANTIATE(insts)(axth)
        let [ixvs, ixbody] = strip_exists(concl(ixth))
        let ixtm = subst(zip(urfns)(ixvs))(ixbody)
        let ixths = CONJUNCTS(ASSUME(ixtm))
        let rixths = map((fun(t): find(o(aconv(t))(concl))(ixths)))(rawcls)
        let rixth = itlist(SIMPLE_EXISTS)(ufns)(end_itlist(CONJ)(rixths))
        PROVE_HYP(ixth)(itlist(SIMPLE_CHOOSE)(urfns)(rixth))
  let canonize:
    fun(t):
      let [avs, bod] = strip_forall(t)
      let [l, r] = dest_eq(bod)
      let [fn, args] = strip_comb(l)
      let rarg_2 = hd(args)
      let vargs_2 = tl(args)
      let l_prime_2 = mk_comb([fn, rarg_2])
      let r_prime_2 = list_mk_abs([vargs_2, r])
      let fvs = frees(rarg_2)
      let hol_def_2 = ASSUME(list_mk_forall([fvs, mk_eq([l_prime_2, r_prime_2])]))
      GENL(avs)(RIGHT_BETAS(vargs_2)(SPECL(fvs)(hol_def_2)))
  let prove_canon_recursive_functions_exist:
    fun(ax):
      fun(tm):
        let ths = map(canonize)(conjuncts(tm))
        let atm = list_mk_conj(map(o(hd)(hyp))(ths))
        let aths = CONJUNCTS(ASSUME(atm))
        let rth = end_itlist(CONJ)(Host.map2(PROVE_HYP)(aths)(ths))
        let eth = prove_raw_recursive_functions_exist(ax)(atm)
        let evs = fst(strip_exists(concl(eth)))
        PROVE_HYP(eth)(itlist(SIMPLE_CHOOSE)(evs)(itlist(SIMPLE_EXISTS)(evs)(rth)))
  let reshuffle_2:
    fun(fn):
      fun(args):
        fun(acc):
          let args_prime = uncurry(C(append))(partition(is_var)(args))
          if (args == args_prime)
          | acc
          | let gvs = map(o(genvar)(type_of))(args)
            let gvs_prime = map(C(assoc)(zip(args)(gvs)))(args_prime)
            let lty = itlist(o(mk_fun_ty)(type_of))(gvs_prime)(Host.funpow(length(gvs))(o(o(o(hd)(tl))(snd))(dest_type))(type_of(fn)))
            let fn_prime = genvar(lty)
            let hol_def_3 = mk_eq([fn, list_mk_abs([gvs, list_mk_comb([fn_prime, gvs_prime])])])
            PairList [ASSUME(hol_def_3), & acc]
  let scrub_def_2:
    fun(t):
      fun(th):
        let [l, r] = dest_eq(t)
        MP(INST(PairList [[r, l]])(DISCH(t)(th)))(REFL(r))
  fun(ax):
    fun(tm):
      let rawcls = conjuncts(tm)
      let spcls = map(o(snd)(strip_forall))(rawcls)
      let lpats = map(o(strip_comb)(lhand))(spcls)
      let ufns = itlist(o(insert)(fst))(lpats)(PairList [])
      let uxargs = map(C(assoc)(lpats))(ufns)
      let trths = itlist2(reshuffle_2)(ufns)(uxargs)(PairList [])
      let tth = GEN_REWRITE_CONV(REDEPTH_CONV)(PairList [BETA_THM, & trths])(tm)
      let eth = prove_canon_recursive_functions_exist(ax)(rand(concl(tth)))
      let [evs, ebod] = strip_exists(concl(eth))
      let fth = itlist(SIMPLE_EXISTS)(ufns)(EQ_MP(SYM(tth))(ASSUME(ebod)))
      let gth = itlist(scrub_def_2)(map(concl)(trths))(fth)
      PROVE_HYP(eth)(itlist(SIMPLE_CHOOSE)(evs)(gth))

def new_recursive_definition:
  let the_recursive_definitions = Box(PairList [])
  let find_redefinition:
    fun(tm):
      fun(th):
        let th_prime = PART_MATCH(I)(th)(tm)
        Host.hol_ignore(PART_MATCH(I)(th_prime)(concl(th)))
        th_prime
  fun(ax):
    fun(tm):
      try:
        let th = tryfind(find_redefinition(tm))(Host.ref_get(the_recursive_definitions))
        Host.warn(#true)("Benign redefinition of recursive function")
        th
        ~catch exn:
          match exn
          | Failure(_):
              let rawcls = conjuncts(tm)
              let spcls = map(o(snd)(strip_forall))(rawcls)
              let lpats = map(o(strip_comb)(lhand))(spcls)
              let ufns = itlist(o(insert)(fst))(lpats)(PairList [])
              let fvs = map((fun(t): subtract(frees(t))(ufns)))(rawcls)
              let gcls = Host.map2(curry(list_mk_forall))(fvs)(rawcls)
              let eth = prove_recursive_functions_exist(ax)(list_mk_conj(gcls))
              let [evs, bod] = strip_exists(concl(eth))
              let dth = new_specification(map(o(fst)(dest_var))(evs))(eth)
              let dths = Host.map2(SPECL)(fvs)(CONJUNCTS(dth))
              let th = end_itlist(CONJ)(dths)
              Host.ref_set(the_recursive_definitions)(PairList [th, & Host.ref_get(the_recursive_definitions)])
              th
          | exn: (throw exn)
