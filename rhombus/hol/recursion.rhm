                            map(o(Up_basics.strip_comb)(Up_equal.lhand))(spcls)
                          »;
                          (block:«
                            let ufns:«
                              itlist(o(insert)(fst))(lpats)(PairList [])
                            »;
                            (block:«
                              let fvs:«
                                map((fun(t):«
                                  subtract(Up_fusion.frees(t))(ufns)
                                »))(rawcls)
                              »;
                              (block:«
                                let gcls:«
                                  Host.map2(curry(Up_bool.list_mk_forall))(fvs)(rawcls)
                                »;
                                (block:«
                                  let eth:«
                                    recursion_prove_recursive_functions_exist(ax)(Up_bool.list_mk_conj(gcls))
                                  »;
                                  (block:«
                                    let Pair(evs,bod):«
                                      Up_basics.strip_exists(Up_fusion.concl(eth))
                                    »;
                                    (block:«
                                      let dth:«
                                        Up_nums.new_specification(map(o(fst)(Up_fusion.dest_var))(evs))(eth)
                                      »;
                                      (block:«
                                        let dths:«
                                          Host.map2(Up_bool.SPECL)(fvs)(Up_bool.CONJUNCTS(dth))
                                        »;
                                        (block:«
                                          let th:«
                                            end_itlist(Up_bool.CONJ)(dths)
                                          »;
                                          (block:«
                                            Host.ref_set(the_recursive_definitions)(PairList.cons(th,Host.ref_get(the_recursive_definitions)));
                                            th
                                          »)
                                        »)
                                      »)
                                    »)
                                  »)
                                »)
                              »)
                            »)
                          »)
                        »)
                      »)
                    »)
                »
                | port_tmp_28:«
                    Host.hol_raise(port_tmp_28)
