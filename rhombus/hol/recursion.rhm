def prove_recursive_functions_exist:
  let prove_raw_recursive_functions_exist:
    fun(ax):
      fun(tm):
        let rawcls = Basics.conjuncts(tm)
        let spcls = map(o(snd)(Basics.strip_forall))(rawcls)
        let lpats = map(o(Basics.strip_comb)(Equal.lhand))(spcls)
        let ufns = itlist(o(insert)(fst))(lpats)(PairList [])
        let axth = Bool.SPEC_ALL(ax)
        let [exvs, axbody] = Basics.strip_exists(Fusion.concl(axth))
        let axcls = Basics.conjuncts(axbody)
        let f = o(o(o(o(o(o(fst)(Fusion.dest_const))(Host.repeat(Fusion.rator)))(Fusion.rand))(Equal.lhand))(snd))(Basics.strip_forall)
        let findax = C(assoc)(map((fun(t): [f(t), t]))(axcls))
        let raxs = map(o(o(o(o(o(findax)(fst))(Fusion.dest_const))(Host.repeat(Fusion.rator)))(hd))(snd))(lpats)
        let axfns = map(o(o(o(Host.repeat(Fusion.rator))(Equal.lhand))(snd))(Basics.strip_forall))(raxs)
        let urfns = map((fun(v): Host.assocd(v)(Host.setify(zip(axfns)(map(fst)(lpats))))(v)))(exvs)
        let axtm_2 = Bool.list_mk_exists([exvs, Bool.list_mk_conj(raxs)])
        let urtm_2 = Bool.list_mk_exists([urfns, tm])
        let insts = Drule.term_match(PairList [])(axtm_2)(urtm_2)
        let ixth = Drule.INSTANTIATE(insts)(axth)
        let [ixvs, ixbody] = Basics.strip_exists(Fusion.concl(ixth))
        let ixtm = Basics.subst(zip(urfns)(ixvs))(ixbody)
        let ixths = Bool.CONJUNCTS(Fusion.ASSUME(ixtm))
        let rixths = map((fun(t): find(o(Fusion.aconv(t))(Fusion.concl))(ixths)))(rawcls)
        let rixth = itlist(Bool.SIMPLE_EXISTS)(ufns)(end_itlist(Bool.CONJ)(rixths))
        Bool.PROVE_HYP(ixth)(itlist(Bool.SIMPLE_CHOOSE)(urfns)(rixth))
  let canonize:
    fun(t):
      let [avs, bod] = Basics.strip_forall(t)
      let [l, r] = Fusion.dest_eq(bod)
      let [fn, args] = Basics.strip_comb(l)
      let rarg_2 = hd(args)
      let vargs_2 = tl(args)
      let l_prime_2 = Fusion.mk_comb([fn, rarg_2])
      let r_prime_2 = Basics.list_mk_abs([vargs_2, r])
      let fvs = Fusion.frees(rarg_2)
      let hol_def_2 = Fusion.ASSUME(Bool.list_mk_forall([fvs, Fusion.mk_eq([l_prime_2, r_prime_2])]))
      Bool.GENL(avs)(IndDefs.RIGHT_BETAS(vargs_2)(Bool.SPECL(fvs)(hol_def_2)))
  let prove_canon_recursive_functions_exist:
    fun(ax):
      fun(tm):
        let ths = map(canonize)(Basics.conjuncts(tm))
        let atm = Bool.list_mk_conj(map(o(hd)(Fusion.hyp))(ths))
        let aths = Bool.CONJUNCTS(Fusion.ASSUME(atm))
        let rth = end_itlist(Bool.CONJ)(Host.map2(Bool.PROVE_HYP)(aths)(ths))
        let eth = prove_raw_recursive_functions_exist(ax)(atm)
        let evs = fst(Basics.strip_exists(Fusion.concl(eth)))
        Bool.PROVE_HYP(eth)(itlist(Bool.SIMPLE_CHOOSE)(evs)(itlist(Bool.SIMPLE_EXISTS)(evs)(rth)))
  let reshuffle_2:
    fun(fn):
      fun(args):
        fun(acc):
          let args_prime = uncurry(C(append))(partition(Fusion.is_var)(args))
          if Host.hol_equal(args)(args_prime)
          | acc
          | let gvs = map(o(Basics.genvar)(Fusion.type_of))(args)
            let gvs_prime = map(C(assoc)(zip(args)(gvs)))(args_prime)
            let lty = itlist(o(Fusion.mk_fun_ty)(Fusion.type_of))(gvs_prime)(Host.funpow(length(gvs))(o(o(o(hd)(tl))(snd))(Fusion.dest_type))(Fusion.type_of(fn)))
            let fn_prime = Basics.genvar(lty)
            let hol_def_3 = Fusion.mk_eq([fn, Basics.list_mk_abs([gvs, Basics.list_mk_comb([fn_prime, gvs_prime])])])
            PairList.cons(Fusion.ASSUME(hol_def_3), acc)
  let scrub_def_2:
    fun(t):
      fun(th):
        let [l, r] = Fusion.dest_eq(t)
        Bool.MP(Fusion.INST(PairList.cons([r, l], PairList []))(Bool.DISCH(t)(th)))(Fusion.REFL(r))
  fun(ax):
    fun(tm):
      let rawcls = Basics.conjuncts(tm)
      let spcls = map(o(snd)(Basics.strip_forall))(rawcls)
      let lpats = map(o(Basics.strip_comb)(Equal.lhand))(spcls)
      let ufns = itlist(o(insert)(fst))(lpats)(PairList [])
      let uxargs = map(C(assoc)(lpats))(ufns)
      let trths = itlist2(reshuffle_2)(ufns)(uxargs)(PairList [])
      let tth = Simp.GEN_REWRITE_CONV(Equal.REDEPTH_CONV)(PairList.cons(Theorems.BETA_THM, trths))(tm)
      let eth = prove_canon_recursive_functions_exist(ax)(Fusion.rand(Fusion.concl(tth)))
      let [evs, ebod] = Basics.strip_exists(Fusion.concl(eth))
      let fth = itlist(Bool.SIMPLE_EXISTS)(ufns)(Fusion.EQ_MP(Equal.SYM(tth))(Fusion.ASSUME(ebod)))
      let gth = itlist(scrub_def_2)(map(Fusion.concl)(trths))(fth)
      Bool.PROVE_HYP(eth)(itlist(Bool.SIMPLE_CHOOSE)(evs)(gth))

def new_recursive_definition:
  let the_recursive_definitions = Box(PairList [])
  let find_redefinition:
    fun(tm):
      fun(th):
        let th_prime = Drule.PART_MATCH(I)(th)(tm)
        Host.hol_ignore(Drule.PART_MATCH(I)(th_prime)(Fusion.concl(th)))
        th_prime
  fun(ax):
    fun(tm):
      try:
        let th = tryfind(find_redefinition(tm))(Host.ref_get(the_recursive_definitions))
        Host.warn(#true)("Benign redefinition of recursive function")
        th
        ~catch exn:
          match exn
          | Failure(_):
              let rawcls = Basics.conjuncts(tm)
              let spcls = map(o(snd)(Basics.strip_forall))(rawcls)
              let lpats = map(o(Basics.strip_comb)(Equal.lhand))(spcls)
              let ufns = itlist(o(insert)(fst))(lpats)(PairList [])
              let fvs = map((fun(t): subtract(Fusion.frees(t))(ufns)))(rawcls)
              let gcls = Host.map2(curry(Bool.list_mk_forall))(fvs)(rawcls)
              let eth = prove_recursive_functions_exist(ax)(Bool.list_mk_conj(gcls))
              let [evs, bod] = Basics.strip_exists(Fusion.concl(eth))
              let dth = Nums.new_specification(map(o(fst)(Fusion.dest_var))(evs))(eth)
              let dths = Host.map2(Bool.SPECL)(fvs)(Bool.CONJUNCTS(dth))
              let th = end_itlist(Bool.CONJ)(dths)
              Host.ref_set(the_recursive_definitions)(PairList.cons(th, Host.ref_get(the_recursive_definitions)))
              th
          | exn: Host.hol_raise(exn)
