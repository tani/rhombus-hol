def recursion_new_recursive_definition:«
  (block:«
    let the_recursive_definitions:«
      Box(PairList [])
    »;
    (block:«
      let find_redefinition:«
        (fun(tm):«
          (fun(th):«
            (block:«
              let th_prime:«
                Up_drule.PART_MATCH(I)(th)(tm)
              »;
              (block:«
                Host.hol_ignore(Up_drule.PART_MATCH(I)(th_prime)(Up_fusion.concl(th)));
                th_prime
              »)
            »)
          »)
        »)
      »;
      (fun(ax):«
        (fun(tm):«
          (block:«
            try:«
              (block:«
                let th:«
                  (block:«
                    let port_tmp_26 = Host.ref_get(the_recursive_definitions);
                    let port_tmp_27 = find_redefinition(tm);
                    tryfind(port_tmp_27)(port_tmp_26)
                  »)
                »;
                (block:«
                  Host.warn(#true)("Benign redefinition of recursive function");
                  th
                »)
              »);
              ~catch port_tmp_28:«
                let port_tmp_29 = port_tmp_28;
                match port_tmp_29
                | Failure(_):«
                    (block:«
                      let rawcls:«
                        Up_basics.conjuncts(tm)
                      »;
                      (block:«
                        let spcls:«
                          map(o(snd)(Up_basics.strip_forall))(rawcls)
                        »;
                        (block:«
