            Iff(
              App(
                Const("IN", Fun(Fun(Tvar("K"), Tvar("A")), Fun(Fun(Fun(Tvar("K"), Tvar("A")), Bool), Bool))),
                [
                  Ref("x"),
                  App(
                    Const(
                      "cartesian_product",
                      Fun(
                        Fun(Tvar("K"), Bool),
                        Fun(Fun(Tvar("K"), Fun(Tvar("A"), Bool)), Fun(Fun(Tvar("K"), Tvar("A")), Bool))
                      )
                    ),
                    [Ref("k"), Ref("s")]
                  )
                ]
              ),
              And(
                App(
                  Const("EXTENSIONAL", Fun(Fun(Tvar("K"), Bool), Fun(Fun(Tvar("K"), Tvar("A")), Bool))),
                  [Ref("k"), Ref("x")]
                ),
                Forall(
                  "i",
                  Tvar("K"),
                  Implies(
                    App(Const("IN", Fun(Tvar("K"), Fun(Fun(Tvar("K"), Bool), Bool))), [Ref("i"), Ref("k")]),
                    App(
                      Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                      [App(Ref("x"), [Ref("i")]), App(Ref("s"), [Ref("i")])]
                    )
                  )
                )
              )
            )
          )
        )
      )),
      REWRITE_TAC(PairList [cartesian_product, IN_ELIM_THM])
    ]
  )

def CARTESIAN_PRODUCT:
  prove(
    [
      hol_term(Forall(
        "k",
        Fun(Tvar("K"), Bool),
        Forall(
          "s",
          Fun(Tvar("K"), Fun(Tvar("A"), Bool)),
          Eq(
            Fun(Fun(Tvar("K"), Tvar("A")), Bool),
            App(
              Const(
                "cartesian_product",
                Fun(
                  Fun(Tvar("K"), Bool),
                  Fun(Fun(Tvar("K"), Fun(Tvar("A"), Bool)), Fun(Fun(Tvar("K"), Tvar("A")), Bool))
                )
              ),
