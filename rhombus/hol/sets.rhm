                  App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("b"), Ref("x")])
                )
              )
            )
          ),
          And(
            Forall(
              "x",
              Real,
              Implies(
                App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Ref("s")]),
                App(
                  Const("real_le", Fun(Real, Fun(Real, Bool))),
                  [App(Const("inf", Fun(Fun(Real, Bool), Real)), [Ref("s")]), Ref("x")]
                )
              )
            ),
            Forall(
              "b",
              Real,
              Implies(
                Forall(
                  "x",
                  Real,
                  Implies(
                    App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Ref("s")]),
                    App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("b"), Ref("x")])
                  )
                ),
                App(
                  Const("real_le", Fun(Real, Fun(Real, Bool))),
                  [Ref("b"), App(Const("inf", Fun(Fun(Real, Bool), Real)), [Ref("s")])]
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      ((GEN_TAC then_tac STRIP_TAC) then_tac REWRITE_TAC(PairList [inf])) then_tac \
                      CONV_TAC(ONCE_DEPTH_CONV(SELECT_CONV))
                    ) then_tac \
                    ONCE_REWRITE_TAC(PairList [GSYM(REAL_LE_NEG2)])
                  ) then_tac \
                  EXISTS_TAC(
                    hol_term(App(
                      Const("real_neg", Fun(Real, Real)),
                      [
                        App(
                          Const("sup", Fun(Fun(Real, Bool), Real)),
                          [
                            App(
                              Const("IMAGE", Fun(Fun(Real, Real), Fun(Fun(Real, Bool), Fun(Real, Bool)))),
                              [Const("real_neg", Fun(Real, Real)), Var("s", Fun(Real, Bool))]
                            )
                          ]
                        )
                      ]
                    ))
                  )
                ) then_tac \
                MP_TAC(
                  SPEC(
                    hol_term(App(
                      Const("IMAGE", Fun(Fun(Real, Real), Fun(Fun(Real, Bool), Fun(Real, Bool)))),
                      [Const("real_neg", Fun(Real, Real)), Var("s", Fun(Real, Bool))]
                    ))
                  )(SUP)
                )
              ) then_tac \
              REWRITE_TAC(PairList [REAL_NEG_NEG])
            ) then_tac \
            ABBREV_TAC(
              hol_term(Eq(
                Real,
                Var("a", Real),
                App(
                  Const("sup", Fun(Fun(Real, Bool), Real)),
                  [
                    App(
                      Const("IMAGE", Fun(Fun(Real, Real), Fun(Fun(Real, Bool), Fun(Real, Bool)))),
                      [Const("real_neg", Fun(Real, Real)), Var("s", Fun(Real, Bool))]
                    )
                  ]
                )
              ))
            )
          ) then_tac \
          REWRITE_TAC(PairList [GSYM(MEMBER_NOT_EMPTY), IN_IMAGE])
        ) then_tac \
        ASM_MESON_TAC(PairList [REAL_NEG_NEG, MEMBER_NOT_EMPTY, REAL_LE_NEG2])
      )
    ]
  )

