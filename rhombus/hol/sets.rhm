def inf:
  new_definition(
    (hol:
       var inf :: (real -> bool) -> real
       var s :: real -> bool
       const #{@} :: (A -> bool) -> A
       const IN :: A -> (A -> bool) -> bool
       inf(s)
         == #{@}(
              fun (a :: real):
                (forall x :: real: IN(x, s) ==> a <= x)
                  && (forall b :: real: (forall x :: real: IN(x, s) ==> b <= x) ==> b <= a)
            ))
  )

def INF_EQ:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const inf :: (real -> bool) -> real
         forall (s :: real -> bool, t :: real -> bool):
           (forall a :: real:
              (forall x :: real: IN(x, s) ==> a <= x) <=> (forall x :: real: IN(x, t) ==> a <= x))
             ==> inf(s) == inf(t)),
      SIMP_TAC(PairList [inf])
    ]
  )

def INF:
  prove(
    [
      (hol:
         const EMPTY :: A -> bool
         const IN :: A -> (A -> bool) -> bool
         const inf :: (real -> bool) -> real
         forall s :: real -> bool:
           s != EMPTY && (exists b :: real: forall x :: real: IN(x, s) ==> b <= x)
             ==> ((forall x :: real: IN(x, s) ==> inf(s) <= x)
                    && (forall b :: real: (forall x :: real: IN(x, s) ==> b <= x) ==> b <= inf(s)))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      ((GEN_TAC then_tac STRIP_TAC) then_tac REWRITE_TAC(PairList [inf])) then_tac \
                      CONV_TAC(ONCE_DEPTH_CONV(SELECT_CONV))
                    ) then_tac \
                    ONCE_REWRITE_TAC(PairList [GSYM(REAL_LE_NEG2)])
                  ) then_tac \
                  EXISTS_TAC(
                    (hol:
                       var s :: real -> bool
                       const sup :: (real -> bool) -> real
                       const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                       const real_neg :: real -> real
                       -sup(IMAGE(real_neg, s)))
                  )
                ) then_tac \
                MP_TAC(
                  SPEC(
                    (hol:
                       var s :: real -> bool
                       const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                       const real_neg :: real -> real
                       IMAGE(real_neg, s))
                  )(SUP)
                )
              ) then_tac \
              REWRITE_TAC(PairList [REAL_NEG_NEG])
            ) then_tac \
            ABBREV_TAC(
              (hol:
                 var a :: real
                 var s :: real -> bool
                 const sup :: (real -> bool) -> real
                 const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                 const real_neg :: real -> real
                 a == sup(IMAGE(real_neg, s)))
            )
          ) then_tac \
          REWRITE_TAC(PairList [GSYM(MEMBER_NOT_EMPTY), IN_IMAGE])
        ) then_tac \
        ASM_MESON_TAC(PairList [REAL_NEG_NEG, MEMBER_NOT_EMPTY, REAL_LE_NEG2])
      )
    ]
  )

