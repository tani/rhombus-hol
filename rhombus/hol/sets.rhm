def has_inf:
  new_definition(
    hol_term(Iff(
      App(
        Var("has_inf", Fun(Fun(Real, Bool), Fun(Real, Bool))),
        [Var("s", Fun(Real, Bool)), Var("b", Real)]
      ),
      Forall(
        "c",
        Real,
        Iff(
          Forall(
            "x",
            Real,
            Implies(
              App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Var("s", Fun(Real, Bool))]),
              App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("c"), Ref("x")])
            )
          ),
          App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("c"), Var("b", Real)])
        )
      )
    ))
  )

