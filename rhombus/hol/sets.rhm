def ITSET_EQ:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "f",
          Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
          Forall(
            "g",
            Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
            Forall(
              "b",
              Tvar("B"),
              Implies(
                And(
                  App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                  And(
                    Forall(
                      "x",
                      Tvar("A"),
                      Implies(
                        App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                        Eq(Fun(Tvar("B"), Tvar("B")), App(Ref("f"), [Ref("x")]), App(Ref("g"), [Ref("x")]))
                      )
                    ),
                    And(
                      Forall(
                        "x",
                        Tvar("A"),
                        Forall(
                          "y",
                          Tvar("A"),
                          Forall(
                            "s",
                            Tvar("B"),
                            Implies(
                              Not(Eq(Tvar("A"), Ref("x"), Ref("y"))),
                              Eq(
                                Tvar("B"),
                                App(Ref("f"), [Ref("x"), App(Ref("f"), [Ref("y"), Ref("s")])]),
                                App(Ref("f"), [Ref("y"), App(Ref("f"), [Ref("x"), Ref("s")])])
                              )
                            )
                          )
                        )
                      ),
                      Forall(
                        "x",
                        Tvar("A"),
                        Forall(
                          "y",
                          Tvar("A"),
                          Forall(
                            "s",
                            Tvar("B"),
                            Implies(
                              Not(Eq(Tvar("A"), Ref("x"), Ref("y"))),
                              Eq(
                                Tvar("B"),
                                App(Ref("g"), [Ref("x"), App(Ref("g"), [Ref("y"), Ref("s")])]),
                                App(Ref("g"), [Ref("y"), App(Ref("g"), [Ref("x"), Ref("s")])])
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                ),
                Eq(
                  Tvar("B"),
                  App(
                    Const(
                      "ITSET",
                      Fun(
                        Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
                        Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Tvar("B")))
                      )
                    ),
                    [Ref("f"), Ref("s"), Ref("b")]
                  ),
                  App(
                    Const(
                      "ITSET",
                      Fun(
                        Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
                        Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Tvar("B")))
                      )
                    ),
                    [Ref("g"), Ref("s"), Ref("b")]
