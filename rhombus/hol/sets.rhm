  )

def CARD_UNION_EQ:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         const CARD :: (A -> bool) -> num
         forall (s :: A -> bool, t :: A -> bool, u :: A -> bool):
           FINITE(u) && (INTER(s, t) == EMPTY && UNION(s, t) == u) ==> CARD(s) + CARD(t) == CARD(u)),
      MESON_TAC(PairList [CARD_UNION, FINITE_SUBSET, SUBSET_UNION])
    ]
  )

