def CARD_DELETE:
  prove(
    [
      hol_term(Forall(
        "x",
        Tvar("A"),
        Forall(
          "s",
          Fun(Tvar("A"), Bool),
          Implies(
            App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
            Eq(
              Num,
              App(
                Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)),
                [
                  App(
                    Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                    [Ref("s"), Ref("x")]
                  )
                ]
              ),
              App(
                Const("COND", Fun(Bool, Fun(Num, Fun(Num, Num)))),
                [
                  App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                  App(
                    Const("-", Fun(Num, Fun(Num, Num))),
                    [
                      App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")]),
                      App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                    ]
                  ),
                  App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")])
                ]
              )
            )
          )
        )
      )),
      (
        (REPEAT(STRIP_TAC) then_tac COND_CASES_TAC) then_list \
        PairList [
          (
            (
              SUBGOAL_THEN(
                hol_term(Eq(
                  Fun(Tvar("A"), Bool),
                  Var("s", Fun(Tvar("A"), Bool)),
                  App(
                    Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                    [
                      Var("x", Tvar("A")),
                      App(
                        Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                        [Var("s", Fun(Tvar("A"), Bool)), Var("x", Tvar("A"))]
                      )
                    ]
                  )
                ))
              )((fun(th): GEN_REWRITE_TAC(o(RAND_CONV)(ONCE_DEPTH_CONV))(PairList [th]))) then_list \
              PairList [
                (
                  UNDISCH_TAC(
                    hol_term(App(
                      Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                      [Var("x", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
                    ))
                  ) then_tac \
                  SET_TAC(PairList [])
                ),
                ALL_TAC
              ]
            ) then_tac \
            ASM_SIMP_TAC(PairList [CARD_CLAUSES, FINITE_DELETE, IN_DELETE, SUC_SUB1])
          ),
          (
            (
              AP_TERM_TAC then_tac \
              UNDISCH_TAC(
                hol_term(Not(
                  App(
                    Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                    [Var("x", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
                  )
                ))
              )
            ) then_tac \
            SET_TAC(PairList [])
          )
        ]
      )
    ]
  )

def CARD_UNION_EQ:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("A"), Bool),
          Forall(
            "u",
            Fun(Tvar("A"), Bool),
            Implies(
              And(
                App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("u")]),
                And(
                  Eq(
                    Fun(Tvar("A"), Bool),
                    App(
                      Const("INTER", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                      [Ref("s"), Ref("t")]
                    ),
                    Const("EMPTY", Fun(Tvar("A"), Bool))
                  ),
                  Eq(
                    Fun(Tvar("A"), Bool),
                    App(
                      Const("UNION", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                      [Ref("s"), Ref("t")]
                    ),
                    Ref("u")
                  )
                )
              ),
              Eq(
                Num,
                App(
                  Const("+", Fun(Num, Fun(Num, Num))),
                  [
                    App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")]),
                    App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("t")])
                  ]
                ),
                App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("u")])
              )
            )
          )
        )
      )),
      MESON_TAC(PairList [CARD_UNION, FINITE_SUBSET, SUBSET_UNION])
    ]
  )

def CARD_DIFF:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("A"), Bool),
          Implies(
            And(
              App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
              App(
                Const("SUBSET", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Bool))),
                [Ref("t"), Ref("s")]
              )
            ),
            Eq(
              Num,
              App(
                Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)),
                [
                  App(
                    Const("DIFF", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                    [Ref("s"), Ref("t")]
                  )
                ]
              ),
              App(
                Const("-", Fun(Num, Fun(Num, Num))),
                [
                  App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")]),
                  App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("t")])
                ]
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              REPEAT(STRIP_TAC) then_tac \
              MATCH_MP_TAC(
                ARITH_RULE(
                  hol_term(Implies(
                    Eq(Num, App(Const("+", Fun(Num, Fun(Num, Num))), [Var("a", Num), Var("b", Num)]), Var("c", Num)),
                    Eq(Num, Var("a", Num), App(Const("-", Fun(Num, Fun(Num, Num))), [Var("c", Num), Var("b", Num)]))
                  ))
                )
              )
            ) then_tac \
            MATCH_MP_TAC(CARD_UNION_EQ)
          ) then_tac \
          ASM_SIMP_TAC(PairList [])
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

