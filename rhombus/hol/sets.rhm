def HAS_SIZE_INDEX:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "n",
          Num,
          Implies(
            App(Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))), [Ref("s"), Ref("n")]),
            Exists(
              "f",
              Fun(Num, Tvar("A")),
              And(
                Forall(
                  "m",
                  Num,
                  Implies(
                    App(Const("<", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")]),
                    App(
                      Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                      [App(Ref("f"), [Ref("m")]), Ref("s")]
                    )
                  )
                ),
                Forall(
                  "x",
                  Tvar("A"),
                  Implies(
                    App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                    ExistsUnique(
                      "m",
                      Num,
                      And(
                        App(Const("<", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")]),
                        Eq(Tvar("A"), App(Ref("f"), [Ref("m")]), Ref("x"))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
