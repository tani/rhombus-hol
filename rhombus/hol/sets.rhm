def IMAGE_INTERS:
  prove(
    [
      hol_term(Forall(
        "f",
        Fun(Tvar("A"), Tvar("B")),
        Forall(
          "s",
          Fun(Fun(Tvar("A"), Bool), Bool),
          Implies(
            And(
              Not(
                Eq(Fun(Fun(Tvar("A"), Bool), Bool), Ref("s"), Const("EMPTY", Fun(Fun(Tvar("A"), Bool), Bool)))
              ),
              Forall(
                "x",
                Tvar("A"),
                Forall(
                  "y",
                  Tvar("A"),
                  Implies(
                    And(
                      App(
                        Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                        [
                          Ref("x"),
                          App(Const("UNIONS", Fun(Fun(Fun(Tvar("A"), Bool), Bool), Fun(Tvar("A"), Bool))), [Ref("s")])
                        ]
                      ),
                      And(
                        App(
                          Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                          [
                            Ref("y"),
                            App(Const("UNIONS", Fun(Fun(Fun(Tvar("A"), Bool), Bool), Fun(Tvar("A"), Bool))), [Ref("s")])
                          ]
                        ),
                        Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("f"), [Ref("y")]))
                      )
                    ),
                    Eq(Tvar("A"), Ref("x"), Ref("y"))
                  )
                )
              )
            ),
            Eq(
              Fun(Tvar("B"), Bool),
              App(
                Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                [
                  Ref("f"),
                  App(Const("INTERS", Fun(Fun(Fun(Tvar("A"), Bool), Bool), Fun(Tvar("A"), Bool))), [Ref("s")])
                ]
              ),
              App(
                Const("INTERS", Fun(Fun(Fun(Tvar("B"), Bool), Bool), Fun(Tvar("B"), Bool))),
                [
                  App(
                    Const(
                      "IMAGE",
                      Fun(
                        Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)),
                        Fun(Fun(Fun(Tvar("A"), Bool), Bool), Fun(Fun(Tvar("B"), Bool), Bool))
                      )
                    ),
                    [
                      App(
                        Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                        [Ref("f")]
                      ),
                      Ref("s")
                    ]
                  )
                ]
              )
            )
          )
        )
      )),
      (REWRITE_TAC(PairList [INTERS_IMAGE]) then_tac SET_TAC(PairList []))
    ]
  )

