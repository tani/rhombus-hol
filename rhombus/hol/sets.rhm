def IMAGE_PAIRED_CROSS:
  prove(
    [
      (hol:
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const GABS :: (A -> bool) -> A
         const GEQ :: A -> A -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         forall (f :: A -> B, g :: C -> D, s :: A -> bool, t :: C -> bool):
           IMAGE(
             GABS(
               fun (f_2 :: pair(A, C) -> pair(B, D)):
                 forall (x :: A, y :: C): GEQ(f_2(#{|,|}(x, y)), #{|,|}(f(x), g(y)))
             ),
             CROSS(s, t)
           )
             == CROSS(IMAGE(f, s), IMAGE(g, t))),
      (
        REWRITE_TAC(
          PairList [
            EXTENSION,
            IN_IMAGE,
            EXISTS_PAIR_THM,
            IN_CROSS,
            FORALL_PAIR_THM,
            PAIR_EQ
          ]
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def CROSS_INTER:
  prove(
    [
      (hol:
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
         (forall (s :: A -> bool, t :: B -> bool, u :: B -> bool):
            CROSS(s, INTER(t, u)) == INTER(CROSS(s, t), CROSS(s, u)))
           && (forall (s :: A -> bool, t :: A -> bool, u :: B -> bool):
                 CROSS(INTER(s, t), u) == INTER(CROSS(s, u), CROSS(t, u)))),
      (
        (
          REWRITE_TAC(PairList [EXTENSION, FORALL_PAIR_THM, IN_INTER, IN_CROSS]) then_tac \
          REPEAT(STRIP_TAC)
        ) then_tac \
        CONV_TAC(TAUT)
      )
    ]
  )

def CROSS_UNION:
