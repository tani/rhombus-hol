                       const CONS :: A -> list(A) -> list(A)
                       CONS(x, l))
                  ) then_tac \
                  ASM_REWRITE_TAC(PairList [LENGTH])
                ) then_tac \
                ASM_REWRITE_TAC(PairList [set_of_list])
              ) then_tac \
              FIRST_ASSUM((fun(th): REWRITE_TAC(PairList [MATCH_MP(CONJUNCT2(CARD_CLAUSES))(th)])))
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          )
        ]
      )
    ]
  )

