def UNIONS_EQ_INTERS:
  prove(
    [
      (hol:
         const UNIONS :: ((A -> bool) -> bool) -> A -> bool
         const INTERS :: ((A -> bool) -> bool) -> A -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         forall f :: (A -> bool) -> bool:
           UNIONS(f) == INTERS(f) <=> (exists s :: A -> bool: f == INSERT(s, EMPTY))),
      (
        REWRITE_TAC(
          PairList [
            SET_RULE(
              (hol:
                 var f :: #{?85123} -> bool
                 const INSERT :: A -> (A -> bool) -> A -> bool
                 const EMPTY :: A -> bool
                 const IN :: A -> (A -> bool) -> bool
                 (exists s :: #{?85123}: f == INSERT(s, EMPTY))
                   <=> f != EMPTY && (forall (s :: #{?85123}, t :: #{?85123}): IN(s, f) && IN(t, f) ==> s == t))
            )
          ]
        ) then_tac \
        SET_TAC(PairList [])
      )
    ]
  )

