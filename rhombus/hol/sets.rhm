                      MAP_EVERY(EXISTS_TAC)(PairList [hol_term(Var("y", Tvar("A"))), hol_term(Var("v", Tvar("B")))]) then_tac \
                      ONCE_REWRITE_TAC(PairList [lem])
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [IN_DELETE])
                  ),
                  (FIRST_ASSUM(MATCH_MP_TAC) then_tac ASM_REWRITE_TAC(PairList []))
                ]
              )
            ]
          )
        ]
      )
    ]
  )

def FINREC_UNIQUE_LEMMA:
  prove(
    [
      hol_term(Forall(
        "f",
        Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
        Forall(
          "b",
