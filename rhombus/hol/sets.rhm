              Eq(Fun(Tvar("A"), Bool), Ref("s"), Const("EMPTY", Fun(Tvar("A"), Bool))),
              Or(
                Eq(Fun(Tvar("B"), Bool), Ref("t"), Const("EMPTY", Fun(Tvar("B"), Bool))),
                And(
                  App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                  App(Const("FINITE", Fun(Fun(Tvar("B"), Bool), Bool)), [Ref("t")])
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REPEAT(GEN_TAC) then_tac \
                            ASM_CASES_TAC(
                              hol_term(Eq(Fun(Tvar("A"), Bool), Var("s", Fun(Tvar("A"), Bool)), Const("EMPTY", Fun(Tvar("A"), Bool))))
                            )
                          ) then_tac \
                          ASM_REWRITE_TAC(PairList [CROSS_EMPTY, FINITE_EMPTY])
                        ) then_tac \
                        ASM_CASES_TAC(
                          hol_term(Eq(Fun(Tvar("B"), Bool), Var("t", Fun(Tvar("B"), Bool)), Const("EMPTY", Fun(Tvar("B"), Bool))))
                        )
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [CROSS_EMPTY, FINITE_EMPTY])
                    ) then_tac \
                    EQ_TAC
                  ) then_tac \
                  REWRITE_TAC(PairList [FINITE_CROSS])
                ) then_tac \
                REPEAT(STRIP_TAC)
              ) then_list \
              PairList [
                FIRST_ASSUM(
                  o(MP_TAC)(
                    MATCH_MP(
                      ISPEC(
                        hol_term(Const("FST", Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Tvar("A")))))(
                        FINITE_IMAGE
                      )
                    )
                  )
                ),
                FIRST_ASSUM(
                  o(MP_TAC)(
                    MATCH_MP(
                      ISPEC(
                        hol_term(Const("SND", Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Tvar("B")))))(
                        FINITE_IMAGE
                      )
                    )
                  )
                )
              ]
            ) then_tac \
            MATCH_MP_TAC(REWRITE_RULE(PairList [IMP_CONJ_ALT])(FINITE_SUBSET))
          ) then_tac \
          REWRITE_TAC(PairList [SUBSET, IN_IMAGE, EXISTS_PAIR_THM, IN_CROSS])
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

