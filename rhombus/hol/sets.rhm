def COMPONENT:
  prove(
    [
      @hol|{!x:A. !s. x IN (x INSERT s)}|,
      SET_TAC(PairList [])
    ]
  )

def DECOMPOSITION:
  prove(
    [
      @hol|{!s:A->bool. !x. x IN s <=> ?t. (s = x INSERT t) /\ ~(x IN t)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac STRIP_TAC then_tac \
      ASM_REWRITE_TAC(PairList [IN_INSERT]) then_tac \
      EXISTS_TAC(
        @hol|{s DELETE x:A}|
      ) then_tac \
