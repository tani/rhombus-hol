Host.parse_as_infix(Pair("DELETE",Pair(21,"left")))

Host.parse_as_infix(Pair("HAS_SIZE",Pair(12,"right")))

Host.parse_as_infix(Pair("<=_c",Pair(12,"right")))

Host.parse_as_infix(Pair("<_c",Pair(12,"right")))

Host.parse_as_infix(Pair(">=_c",Pair(12,"right")))

Host.parse_as_infix(Pair(">_c",Pair(12,"right")))

