def BIJECTIONS_CARD_EQ:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("B"), Bool),
          Forall(
            "f",
            Fun(Tvar("A"), Tvar("B")),
            Forall(
              "g",
              Fun(Tvar("B"), Tvar("A")),
              Implies(
                And(
                  Or(
                    App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                    App(Const("FINITE", Fun(Fun(Tvar("B"), Bool), Bool)), [Ref("t")])
                  ),
                  And(
                    Forall(
                      "x",
                      Tvar("A"),
                      Implies(
                        App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                        And(
                          App(
                            Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))),
                            [App(Ref("f"), [Ref("x")]), Ref("t")]
                          ),
                          Eq(Tvar("A"), App(Ref("g"), [App(Ref("f"), [Ref("x")])]), Ref("x"))
                        )
                      )
                    ),
                    Forall(
                      "y",
                      Tvar("B"),
                      Implies(
                        App(Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))), [Ref("y"), Ref("t")]),
                        And(
                          App(
                            Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                            [App(Ref("g"), [Ref("y")]), Ref("s")]
                          ),
                          Eq(Tvar("B"), App(Ref("f"), [App(Ref("g"), [Ref("y")])]), Ref("y"))
                        )
                      )
                    )
                  )
                ),
                Eq(
                  Num,
                  App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")]),
                  App(Const("CARD", Fun(Fun(Tvar("B"), Bool), Num)), [Ref("t")])
                )
              )
            )
          )
        )
      )),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          DISCH_THEN(
            CONJUNCTS_THEN2(MP_TAC)(o(MP_TAC)(MATCH_MP(BIJECTIONS_HAS_SIZE_EQ)))
          )
        ) then_tac \
        MESON_TAC(PairList [HAS_SIZE])
      )
    ]
  )

def WF_FINITE:
  prove(
    [
      hol_term(Forall(
