                  "y",
                  Tvar("A"),
                  Forall(
                    "z",
                    Tvar("A"),
                    Implies(
                      And(App(Ref("<<"), [Ref("x"), Ref("y")]), App(Ref("<<"), [Ref("y"), Ref("z")])),
                      App(Ref("<<"), [Ref("x"), Ref("z")])
                    )
                  )
                )
              ),
              Forall(
                "x",
                Tvar("A"),
                App(
                  Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)),
