      @hol|{!s:A->bool. (s = EMPTY) \/ ?x:A. ?t. (s = x INSERT t) /\ ~(x IN t)}|,
      MESON_TAC(PairList [MEMBER_NOT_EMPTY, DECOMPOSITION])
    ]
  )

def ABSORPTION:
  prove(
    [
      @hol|{!x:A. !s. x IN s <=> (x INSERT s = s)}|,
