    [
      (hol:
         var P :: B -> bool
         const IN :: A -> (A -> bool) -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         forall (f :: A -> B, s :: A -> bool):
           (forall y :: B: IN(y, IMAGE(f, s)) ==> P(y)) <=> (forall x :: A: IN(x, s) ==> P(f(x)))),
