                    (DISCH_TAC then_tac X_GEN_TAC(hol: var s :: A -> bool; s)) then_tac \
                    DISCH_TAC
                  ) then_tac \
                  FIRST_ASSUM(
                    o(MP_TAC)(
                      SPECL(
                        PairList [
                          (hol:
                             var s :: A -> bool
                             var t :: A -> bool
                             const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
                             INTER(s, t)),
                          (hol:
                             var s :: A -> bool
                             var u :: A -> bool
                             const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
                             INTER(s, u))
                        ]
                      )
                    )
                  )
                ) then_tac \
                ANTS_TAC
              ) then_list \
              PairList [ALL_TAC, (MATCH_MP_TAC(EQ_IMP) then_tac AP_TERM_TAC)]
            ) then_tac \
            ASM(SET_TAC)(PairList [])
          )
        ]
      )
    ]
  )

