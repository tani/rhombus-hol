def EXTENSIONAL_EQ:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "f",
          Fun(Tvar("A"), Tvar("B")),
          Forall(
            "g",
            Fun(Tvar("A"), Tvar("B")),
            Implies(
              And(
                App(
                  Const("IN", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Fun(Tvar("A"), Tvar("B")), Bool), Bool))),
                  [
                    Ref("f"),
                    App(
                      Const("EXTENSIONAL", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Bool))),
                      [Ref("s")]
                    )
                  ]
                ),
                And(
                  App(
                    Const("IN", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Fun(Tvar("A"), Tvar("B")), Bool), Bool))),
                    [
                      Ref("g"),
                      App(
                        Const("EXTENSIONAL", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Bool))),
                        [Ref("s")]
                      )
                    ]
                  ),
                  Forall(
                    "x",
                    Tvar("A"),
                    Implies(
                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                      Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("g"), [Ref("x")]))
                    )
                  )
                )
              ),
              Eq(Fun(Tvar("A"), Tvar("B")), Ref("f"), Ref("g"))
            )
          )
        )
      )),
      (
        (
          (
            (REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [FUN_EQ_THM])) then_tac \
            GEN_TAC
          ) then_tac \
          ASM_CASES_TAC(
            hol_term(App(
              Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
              [Var("x", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
            ))
          )
        ) then_list \
        PairList [
          ASM_SIMP_TAC(PairList []),
          ASM_MESON_TAC(PairList [IN_EXTENSIONAL_UNDEFINED])
        ]
      )
    ]
  )

