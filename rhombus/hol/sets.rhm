def HAS_SIZE_IMAGE_INJ_RESTRICT:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const IN :: A -> (A -> bool) -> bool
         const HAS_SIZE :: (A -> bool) -> num -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         forall (f :: A -> B, s :: A -> bool, t :: B -> bool, P :: B -> bool, n :: num):
           (FINITE(s)
              && (FINITE(t)
                    && (CARD(s) == CARD(t)
                          && (SUBSET(IMAGE(f, s), t)
                                && ((forall (x :: A, y :: A):
                                       IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> x == y)
                                      && HAS_SIZE(
                                           GSPEC(
                                             fun (gen_pvar_219 :: A):
                                               exists x :: A:
                                                 SETSPEC(gen_pvar_219, IN(x, s) && P(f(x)), x)
                                           ),
                                           n
                                         ))))))
             ==> HAS_SIZE(
                   GSPEC(
                     fun (gen_pvar_220 :: B):
                       exists x :: B: SETSPEC(gen_pvar_220, IN(x, t) && P(x), x)
                   ),
                   n
                 )),
      (
        (
          REPEAT(STRIP_TAC) then_tac \
          SUBGOAL_THEN(
            (hol:
               var t :: B -> bool
               var P :: B -> bool
               var f :: A -> B
               var s :: A -> bool
               const GSPEC :: (A -> bool) -> A -> bool
               const SETSPEC :: A -> bool -> A -> bool
               const IN :: A -> (A -> bool) -> bool
               const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
               GSPEC(
                 fun (gen_pvar_217 :: B):
                   exists x :: B: SETSPEC(gen_pvar_217, IN(x, t) && P(x), x)
               )
                 == IMAGE(
                      f,
                      GSPEC(
                        fun (gen_pvar_218 :: A):
                          exists x :: A: SETSPEC(gen_pvar_218, IN(x, s) && P(f(x)), x)
                      )
                    ))
          )(SUBST1_TAC)
        ) then_list \
        PairList [
          (
            (
              MP_TAC(
                ISPECL(
                  PairList [
                    (hol: var s :: A -> bool; s),
                    (hol: var t :: B -> bool; t),
                    (hol: var f :: A -> B; f)
                  ])(
                  SURJECTIVE_IFF_INJECTIVE_GEN
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            ASM(SET_TAC)(PairList [])
          ),
          (
            (MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ) then_tac ASM_REWRITE_TAC(PairList [])) then_tac \
            ASM(SET_TAC)(PairList [])
          )
        ]
      )
    ]
  )

def CARD_LE_INJ:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (s :: A -> bool, t :: B -> bool):
           FINITE(s) && (FINITE(t) && CARD(s) <= CARD(t))
             ==> (exists f :: A -> B:
                    SUBSET(IMAGE(f, s), t)
                      && (forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> x == y))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
                                            REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM])
                                          ) then_tac \
                                          MATCH_MP_TAC(FINITE_INDUCT_STRONG)
                                        ) then_tac \
                                        REWRITE_TAC(PairList [IMAGE_CLAUSES, EMPTY_SUBSET, NOT_IN_EMPTY])
                                      ) then_tac \
                                      SIMP_TAC(PairList [CARD_CLAUSES])
                                    ) then_tac \
                                    MAP_EVERY(X_GEN_TAC)(PairList [(hol: var x :: A; x), (hol: var s :: A -> bool; s)])
                                  ) then_tac \
                                  STRIP_TAC
                                ) then_tac \
                                MATCH_MP_TAC(FINITE_INDUCT_STRONG)
                              ) then_tac \
                              REWRITE_TAC(PairList [CARD_CLAUSES, LE, NOT_SUC])
                            ) then_tac \
                            MAP_EVERY(X_GEN_TAC)(PairList [(hol: var y :: B; y), (hol: var t :: B -> bool; t)])
                          ) then_tac \
                          SIMP_TAC(PairList [CARD_CLAUSES])
                        ) then_tac \
                        DISCH_THEN(CONJUNCTS_THEN2(K(ALL_TAC))(STRIP_ASSUME_TAC))
                      ) then_tac \
                      REWRITE_TAC(PairList [LE_SUC])
                    ) then_tac \
                    STRIP_TAC
                  ) then_tac \
                  FIRST_X_ASSUM(o(MP_TAC)(SPEC(hol: var t :: B -> bool; t)))
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              DISCH_THEN(
                X_CHOOSE_THEN(hol: var f :: A -> B; f)(STRIP_ASSUME_TAC)
              )
            ) then_tac \
            EXISTS_TAC(
              (hol:
                 var x :: A
                 var y :: B
                 var f :: A -> B
                 fun (z :: A): if z == x | y | f(z))
            )
          ) then_tac \
          REWRITE_TAC(PairList [IN_INSERT, SUBSET, IN_IMAGE])
        ) then_tac \
        ASM_MESON_TAC(PairList [SUBSET, IN_IMAGE])
      )
    ]
  )

def FORALL_IN_CLAUSES:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const EMPTY :: A -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         (forall P :: A -> bool: (forall x :: A: IN(x, EMPTY) ==> P(x)) <=> #true)
           && (forall (P :: A -> bool, a :: A, s :: A -> bool):
                 (forall x :: A: IN(x, INSERT(a, s)) ==> P(x))
                   <=> P(a) && (forall x :: A: IN(x, s) ==> P(x)))),
      (REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY]) then_tac MESON_TAC(PairList []))
    ]
  )

def EXISTS_IN_CLAUSES:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const EMPTY :: A -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         (forall P :: A -> bool: (exists x :: A: IN(x, EMPTY) && P(x)) <=> #false)
           && (forall (P :: A -> bool, a :: A, s :: A -> bool):
                 (exists x :: A: IN(x, INSERT(a, s)) && P(x))
                   <=> P(a) || (exists x :: A: IN(x, s) && P(x)))),
      (REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY]) then_tac MESON_TAC(PairList []))
    ]
  )

def INJECTIVE_ON_IMAGE:
  prove(
    [
      (hol:
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (f :: A -> B, u :: A -> bool):
           (forall (s :: A -> bool, t :: A -> bool):
              SUBSET(s, u) && (SUBSET(t, u) && IMAGE(f, s) == IMAGE(f, t)) ==> s == t)
