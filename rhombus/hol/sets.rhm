                                PairList [
                                  NOT_FORALL_THM,
                                  NOT_IMP,
                                  TAUT(
                                    (hol:
                                       var p :: bool
                                       var q :: bool
                                       !(p && q) <=> p ==> !q)
                                  )
                                ]
                              )
                            ) then_tac \
                            REWRITE_TAC(
                              PairList [
                                ARITH_RULE(
                                  (hol:
                                     var x :: num
                                     var n :: num
                                     const SUC :: num -> num
                                     !(x <= n) <=> SUC(n) <= x)
                                )
                              ]
                            )
                          ) then_tac \
                          REWRITE_TAC(PairList [CHOOSE_SUBSET_EQ])
                        ) then_tac \
                        REWRITE_TAC(PairList [RIGHT_AND_EXISTS_THM])
                      ) then_tac \
                      ONCE_REWRITE_TAC(PairList [SWAP_EXISTS_THM])
                    ) then_tac \
                    MATCH_MP_TAC(MONO_EXISTS)
                  ) then_tac \
                  X_GEN_TAC(hol: var s :: A -> bool; s)
                ) then_tac \
                REWRITE_TAC(PairList [HAS_SIZE])
              ) then_tac \
              STRIP_TAC
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          MATCH_MP_TAC(FINITE_SUBSET_UNIONS_CHAIN)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

