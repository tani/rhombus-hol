def REAL_SUP_EQ_INF:
  prove(
    [
      (hol:
         const EMPTY :: A -> bool
         const IN :: A -> (A -> bool) -> bool
         const real_abs :: real -> real
         const sup :: (real -> bool) -> real
         const inf :: (real -> bool) -> real
         const INSERT :: A -> (A -> bool) -> A -> bool
         forall s :: real -> bool:
           s != EMPTY && (exists B :: real: forall x :: real: IN(x, s) ==> real_abs(x) <= B)
             ==> (sup(s) == inf(s) <=> (exists a :: real: s == INSERT(a, EMPTY)))),
      (
        (REPEAT(STRIP_TAC) then_tac EQ_TAC) then_list \
        PairList [
          (
            (
              (
                (
                  DISCH_TAC then_tac \
                  EXISTS_TAC(hol:
                               var s :: real -> bool
                               const sup :: (real -> bool) -> real
                               sup(s))
                ) then_tac \
                MATCH_MP_TAC(
                  SET_RULE(
                    (hol:
                       var s :: #{?112204} -> bool
                       var a :: #{?112204}
                       const EMPTY :: A -> bool
                       const IN :: A -> (A -> bool) -> bool
                       const INSERT :: A -> (A -> bool) -> A -> bool
                       s != EMPTY && (forall x :: #{?112204}: IN(x, s) ==> x == a) ==> s == INSERT(a, EMPTY))
                  )
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM)])
            ) then_tac \
            ASM_MESON_TAC(PairList [SUP, REAL_ABS_BOUNDS, INF])
          ),
          (
            STRIP_TAC then_tac \
            ASM_SIMP_TAC(PairList [SUP_INSERT_FINITE, INF_INSERT_FINITE, FINITE_EMPTY])
          )
        ]
      )
    ]
  )

