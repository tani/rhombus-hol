def FINITE_INDUCT_STRONG:
  prove(
    [
      (hol:
         const EMPTY :: A -> bool
         const IN :: A -> (A -> bool) -> bool
         const FINITE :: (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         forall P :: (A -> bool) -> bool:
           (P(EMPTY)
              && (forall (x :: A, s :: A -> bool): P(s) && (!IN(x, s) && FINITE(s)) ==> P(INSERT(x, s))))
             ==> (forall s :: A -> bool: FINITE(s) ==> P(s))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (GEN_TAC then_tac STRIP_TAC) then_tac \
                      SUBGOAL_THEN(
                        (hol:
                           var P :: (A -> bool) -> bool
                           const FINITE :: (A -> bool) -> bool
                           forall s :: A -> bool: FINITE(s) ==> FINITE(s) && P(s))
                      )(MP_TAC)
                    ) then_list \
                    PairList [ALL_TAC, MESON_TAC(PairList [])]
                  ) then_tac \
                  MATCH_MP_TAC(sets_FINITE_INDUCT_v2)
                ) then_tac \
                ASM_SIMP_TAC(PairList [sets_FINITE_RULES_v2])
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          ASM_CASES_TAC(
            (hol:
               var x :: A
               var s :: A -> bool
               const IN :: A -> (A -> bool) -> bool
               IN(x, s))
          )
        ) then_list \
        PairList [
          (
            (
              SUBGOAL_THEN(
                (hol:
                   var x :: A
                   var s :: A -> bool
                   const INSERT :: A -> (A -> bool) -> A -> bool
                   INSERT(x, s) == s)
              )((fun(th): ASM_REWRITE_TAC(PairList [th]))) then_tac \
              UNDISCH_TAC(
                (hol:
                   var x :: A
                   var s :: A -> bool
                   const IN :: A -> (A -> bool) -> bool
                   IN(x, s))
              )
            ) then_tac \
            SET_TAC(PairList [])
          ),
          (FIRST_ASSUM(MATCH_MP_TAC) then_tac ASM_REWRITE_TAC(PairList []))
        ]
      )
    ]
  )

