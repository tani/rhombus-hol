def HAS_SIZE_CLAUSES:
  let lemma:
    SET_RULE(
      hol_term(Implies(
        App(
          Const("IN", Fun(Tvar("?95389"), Fun(Fun(Tvar("?95389"), Bool), Bool))),
          [Var("a", Tvar("?95389")), Var("s", Fun(Tvar("?95389"), Bool))]
        ),
        Eq(
          Fun(Tvar("?95389"), Bool),
          Var("s", Fun(Tvar("?95389"), Bool)),
          App(
            Const("INSERT", Fun(Tvar("?95389"), Fun(Fun(Tvar("?95389"), Bool), Fun(Tvar("?95389"), Bool)))),
            [
              Var("a", Tvar("?95389")),
              App(
                Const("DELETE", Fun(Fun(Tvar("?95389"), Bool), Fun(Tvar("?95389"), Fun(Tvar("?95389"), Bool)))),
                [Var("s", Fun(Tvar("?95389"), Bool)), Var("a", Tvar("?95389"))]
              )
            ]
          )
        )
      ))
    )
  prove(
    [
      hol_term(And(
        Iff(
          App(
            Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
            [Var("s", Fun(Tvar("A"), Bool)), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
          ),
          Eq(Fun(Tvar("A"), Bool), Var("s", Fun(Tvar("A"), Bool)), Const("EMPTY", Fun(Tvar("A"), Bool)))
        ),
        Iff(
          App(
            Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
            [Var("s", Fun(Tvar("A"), Bool)), App(Const("SUC", Fun(Num, Num)), [Var("n", Num)])]
          ),
          Exists(
            "a",
            Tvar("A"),
            Exists(
              "t",
              Fun(Tvar("A"), Bool),
              And(
                App(Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))), [Ref("t"), Var("n", Num)]),
                And(
                  Not(App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("a"), Ref("t")])),
                  Eq(
                    Fun(Tvar("A"), Bool),
                    Var("s", Fun(Tvar("A"), Bool)),
                    App(
                      Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                      [Ref("a"), Ref("t")]
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (REWRITE_TAC(PairList [HAS_SIZE_0]) then_tac REPEAT(STRIP_TAC)) then_tac \
          EQ_TAC
        ) then_list \
        PairList [
          (
            REWRITE_TAC(PairList [HAS_SIZE_SUC, GSYM(MEMBER_NOT_EMPTY)]) then_tac \
            MESON_TAC(PairList [lemma, IN_DELETE])
          ),
          SIMP_TAC(PairList [LEFT_IMP_EXISTS_THM, HAS_SIZE, CARD_CLAUSES, FINITE_INSERT])
        ]
      )
    ]
  )

def HAS_SIZE_CONV:
  let pth_2:
    prove(
      [
        hol_term(And(
          Iff(
            And(
              Not(
                App(
                  Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                  [Var("a", Tvar("A")), Const("EMPTY", Fun(Tvar("A"), Bool))]
                )
              ),
              Var("P", Bool)
            ),
            Var("P", Bool)
          ),
          And(
            Iff(
              And(
                Not(
                  App(
                    Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                    [
                      Var("a", Tvar("A")),
                      App(
                        Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                        [Var("b", Tvar("A")), Const("EMPTY", Fun(Tvar("A"), Bool))]
                      )
                    ]
                  )
                ),
                Var("P", Bool)
              ),
              And(Not(Eq(Tvar("A"), Var("a", Tvar("A")), Var("b", Tvar("A")))), Var("P", Bool))
            ),
            Iff(
              And(
                Not(
                  App(
                    Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                    [
                      Var("a", Tvar("A")),
                      App(
                        Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                        [Var("b", Tvar("A")), Var("cs", Fun(Tvar("A"), Bool))]
                      )
                    ]
                  )
                ),
                Var("P", Bool)
              ),
              And(
                Not(Eq(Tvar("A"), Var("a", Tvar("A")), Var("b", Tvar("A")))),
                And(
                  Not(
                    App(
                      Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                      [Var("a", Tvar("A")), Var("cs", Fun(Tvar("A"), Bool))]
                    )
                  ),
                  Var("P", Bool)
                )
              )
            )
          )
        )),
        SET_TAC(PairList [])
      ]
    )
  let qth_2:
    prove(
      [
        hol_term(And(
          Iff(
            Exists(
              "s",
              Fun(Tvar("A"), Bool),
              And(
                App(
                  Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
                  [Ref("s"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
                ),
                App(Var("P", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")])
              )
            ),
            App(Var("P", Fun(Fun(Tvar("A"), Bool), Bool)), [Const("EMPTY", Fun(Tvar("A"), Bool))])
          ),
          Iff(
            Exists(
              "s",
              Fun(Tvar("A"), Bool),
              And(
                App(
                  Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
                  [Ref("s"), App(Const("SUC", Fun(Num, Num)), [Var("n", Num)])]
                ),
                App(Var("P", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")])
              )
            ),
            Exists(
              "a",
              Tvar("A"),
              Exists(
                "s",
                Fun(Tvar("A"), Bool),
                And(
                  App(Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))), [Ref("s"), Var("n", Num)]),
                  And(
                    Not(App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("a"), Ref("s")])),
                    App(
                      Var("P", Fun(Fun(Tvar("A"), Bool), Bool)),
                      [
                        App(
                          Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                          [Ref("a"), Ref("s")]
                        )
                      ]
                    )
                  )
                )
              )
            )
          )
        )),
        (REWRITE_TAC(PairList [HAS_SIZE_CLAUSES]) then_tac MESON_TAC(PairList []))
      ]
    )
  let qconv_0_2 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT1(qth_2)])
  let qconv_1_2 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT2(qth_2)])
  let rconv_0_2 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT1(pth_2)])
  let rconv_1_2 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT2(pth_2)])
  fun EXISTS_HAS_SIZE_AND_CONV(tm):
    (
      qconv_0_2 or_conv \
      (
        (BINDER_CONV(LAND_CONV(RAND_CONV(num_CONV))) then_conv qconv_1_2) then_conv \
        BINDER_CONV(EXISTS_HAS_SIZE_AND_CONV)
      )
    )(tm)
  fun NOT_IN_INSERT_CONV(tm):
    (
      (
        (rconv_0_2 then_conv NOT_IN_INSERT_CONV) or_conv \
        (rconv_1_2 then_conv RAND_CONV(NOT_IN_INSERT_CONV))
      ) or_conv \
      ALL_CONV
    )(tm)
  let HAS_SIZE_CONV:
    (
      GEN_REWRITE_CONV(I)(PairList [CONJUNCT1(HAS_SIZE_CLAUSES)]) or_conv \
      (
        (
          RAND_CONV(num_CONV) then_conv \
          GEN_REWRITE_CONV(I)(PairList [CONJUNCT2(HAS_SIZE_CLAUSES)])
        ) then_conv \
        BINDER_CONV(EXISTS_HAS_SIZE_AND_CONV)
      )
    )
  fun(tm):
    let th = HAS_SIZE_CONV(tm)
    let tm_prime = rand(concl(th))
    let [evs, bod] = strip_exists(tm_prime)
    if (evs == (PairList []))
    | th
    | let th_prime = funpow(length(evs))(BINDER_CONV)(NOT_IN_INSERT_CONV)(tm_prime)
      TRANS(th)(th_prime)

