def IN:
  new_definition(
    hol_term(Forall(
      "P",
      Fun(Tvar("A"), Bool),
      Forall(
        "x",
        Tvar("A"),
        Iff(
          App(Var("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("P")]),
          App(Ref("P"), [Ref("x")])
        )
      )
    ))
  )

def EXTENSION:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("A"), Bool),
          Iff(
            Eq(Fun(Tvar("A"), Bool), Ref("s"), Ref("t")),
            Forall(
              "x",
              Tvar("A"),
              Iff(
                App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("t")])
              )
            )
          )
        )
      )),
      REWRITE_TAC(PairList [IN, FUN_EQ_THM])
    ]
  )

def GSPEC:
  new_definition(
    hol_term(Eq(
      Fun(Tvar("A"), Bool),
      App(
        Var("GSPEC", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool))),
        [Var("p", Fun(Tvar("A"), Bool))]
      ),
      Var("p", Fun(Tvar("A"), Bool))
    ))
  )

def SETSPEC:
  new_definition(
    hol_term(Iff(
      App(
        Var("SETSPEC", Fun(Tvar("A"), Fun(Bool, Fun(Tvar("A"), Bool)))),
        [Var("v", Tvar("A")), Var("P", Bool), Var("t", Tvar("A"))]
      ),
      And(Var("P", Bool), Eq(Tvar("A"), Var("v", Tvar("A")), Var("t", Tvar("A"))))
    ))
  )

def IN_ELIM_THM:
  prove(
    [
      hol_term(And(
        Forall(
          "P",
          Fun(Fun(Bool, Fun(Tvar("A"), Bool)), Bool),
          Forall(
            "x",
            Tvar("A"),
            Iff(
              App(
                Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                [
                  Ref("x"),
                  App(
                    Const("GSPEC", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool))),
                    [
                      Lambda(
                        "v",
                        Tvar("A"),
                        App(
                          Ref("P"),
                          [App(Const("SETSPEC", Fun(Tvar("A"), Fun(Bool, Fun(Tvar("A"), Bool)))), [Ref("v")])]
                        )
                      )
                    ]
                  )
                ]
              ),
              App(
                Ref("P"),
                [Lambda("p", Bool, Lambda("t", Tvar("A"), And(Ref("p"), Eq(Tvar("A"), Ref("x"), Ref("t")))))]
              )
            )
          )
        ),
        And(
          Forall(
            "p",
            Fun(Tvar("A"), Bool),
            Forall(
              "x",
              Tvar("A"),
              Iff(
                App(
                  Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                  [
                    Ref("x"),
                    App(
                      Const("GSPEC", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool))),
                      [
                        Lambda(
                          "v",
                          Tvar("A"),
                          Exists(
                            "y",
                            Tvar("A"),
                            App(
                              Const("SETSPEC", Fun(Tvar("A"), Fun(Bool, Fun(Tvar("A"), Bool)))),
                              [Ref("v"), App(Ref("p"), [Ref("y")]), Ref("y")]
                            )
                          )
                        )
                      ]
                    )
                  ]
                ),
                App(Ref("p"), [Ref("x")])
              )
            )
          ),
          And(
            Forall(
              "P",
              Fun(Fun(Bool, Fun(Tvar("A"), Bool)), Bool),
              Forall(
                "x",
                Tvar("A"),
                Iff(
                  App(
                    Const("GSPEC", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool))),
                    [
                      Lambda(
                        "v",
                        Tvar("A"),
                        App(
                          Ref("P"),
                          [App(Const("SETSPEC", Fun(Tvar("A"), Fun(Bool, Fun(Tvar("A"), Bool)))), [Ref("v")])]
                        )
                      ),
                      Ref("x")
                    ]
                  ),
                  App(
                    Ref("P"),
                    [Lambda("p", Bool, Lambda("t", Tvar("A"), And(Ref("p"), Eq(Tvar("A"), Ref("x"), Ref("t")))))]
                  )
                )
              )
            ),
            And(
              Forall(
                "p",
                Fun(Tvar("A"), Bool),
                Forall(
                  "x",
                  Tvar("A"),
                  Iff(
                    App(
                      Const("GSPEC", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool))),
                      [
                        Lambda(
                          "v",
                          Tvar("A"),
                          Exists(
                            "y",
                            Tvar("A"),
                            App(
                              Const("SETSPEC", Fun(Tvar("A"), Fun(Bool, Fun(Tvar("A"), Bool)))),
                              [Ref("v"), App(Ref("p"), [Ref("y")]), Ref("y")]
                            )
                          )
                        ),
                        Ref("x")
                      ]
                    ),
                    App(Ref("p"), [Ref("x")])
                  )
                )
              ),
              Forall(
                "p",
                Fun(Tvar("A"), Bool),
                Forall(
                  "x",
                  Tvar("A"),
                  Iff(
                    App(
                      Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                      [Ref("x"), Lambda("y", Tvar("A"), App(Ref("p"), [Ref("y")]))]
                    ),
                    App(Ref("p"), [Ref("x")])
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [IN, GSPEC])) then_tac \
            TRY((AP_TERM_TAC then_tac REWRITE_TAC(PairList [FUN_EQ_THM])))
          ) then_tac \
          REWRITE_TAC(PairList [SETSPEC])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

