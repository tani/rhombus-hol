    (hol:
       var has_inf :: (real -> bool) -> real -> bool
       var s :: real -> bool
       var b :: real
       const IN :: A -> (A -> bool) -> bool
       has_inf(s, b) <=> (forall c :: real: (forall x :: real: IN(x, s) ==> c <= x) <=> c <= b))
  )

