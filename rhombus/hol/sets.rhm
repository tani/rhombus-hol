def GE_C:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("B"), Bool),
          Iff(
            App(
              Const(">=_c", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("B"), Bool), Bool))),
              [Ref("s"), Ref("t")]
            ),
            Exists(
              "f",
              Fun(Tvar("A"), Tvar("B")),
              Forall(
                "y",
                Tvar("B"),
                Implies(
                  App(Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))), [Ref("y"), Ref("t")]),
                  Exists(
                    "x",
                    Tvar("A"),
                    And(
                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                      Eq(Tvar("B"), Ref("y"), App(Ref("f"), [Ref("x")]))
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (REWRITE_TAC(PairList [ge_c, LE_C]) then_tac MESON_TAC(PairList []))
    ]
  )

