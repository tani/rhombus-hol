                REPEAT(STRIP_TAC)
              ) then_list \
              PairList [
                FIRST_ASSUM(
                  o(MP_TAC)(
                    MATCH_MP(
                      ISPEC(
                        (hol: const FST :: pair(A, B) -> A; FST))(
                        FINITE_IMAGE
                      )
                    )
                  )
                ),
                FIRST_ASSUM(
                  o(MP_TAC)(
                    MATCH_MP(
                      ISPEC(
                        (hol: const SND :: pair(A, B) -> B; SND))(
                        FINITE_IMAGE
                      )
                    )
                  )
                )
              ]
            ) then_tac \
            MATCH_MP_TAC(REWRITE_RULE(PairList [IMP_CONJ_ALT])(FINITE_SUBSET))
          ) then_tac \
          REWRITE_TAC(PairList [SUBSET, IN_IMAGE, EXISTS_PAIR_THM, IN_CROSS])
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

def INFINITE_CROSS_EQ:
  prove(
    [
      (hol:
         const INFINITE :: (A -> bool) -> bool
