                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [CROSS_EMPTY, FINITE_EMPTY])
                    ) then_tac \
                    EQ_TAC
                  ) then_tac \
                  REWRITE_TAC(PairList [FINITE_CROSS])
