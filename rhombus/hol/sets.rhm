Host.parse_as_infix(["<_c", [12, "right"]])

Host.parse_as_infix([">=_c", [12, "right"]])

Host.parse_as_infix([">_c", [12, "right"]])

Host.parse_as_infix(["=_c", [12, "right"]])

def IN:
  new_definition(
    @hol|{!P:A->bool. !x. x IN P <=> P x}|
  )

def EXTENSION:
  prove(
    [
      @hol|{!s t. (s = t) <=> !x:A. x IN s <=> x IN t}|,
      REWRITE_TAC(PairList [IN, FUN_EQ_THM])
    ]
  )

def GSPEC:
  new_definition(
    @hol|{GSPEC (p:A->bool) = p}|
  )

def SETSPEC:
  new_definition(
    @hol|{SETSPEC (v:A) P t <=> P /\ (v = t)}|
  )

def IN_ELIM_THM:
  prove(
    [
      @hol|{(!P x:A. x IN GSPEC (\v. P (SETSPEC v)) <=> P (\p t. p /\ (x = t))) /\
         (!p x:A. x IN GSPEC (\v. ?y. SETSPEC v (p y) y) <=> p x) /\
         (!P x:A. GSPEC (\v. P (SETSPEC v)) x <=> P (\p t. p /\ (x = t))) /\
         (!p x:A. GSPEC (\v. ?y. SETSPEC v (p y) y) x <=> p x) /\
         (!p x:A. x IN (\y. p y) <=> p x)}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [IN, GSPEC]) then_tac \
      TRY(AP_TERM_TAC then_tac REWRITE_TAC(PairList [FUN_EQ_THM])) then_tac \
      REWRITE_TAC(PairList [SETSPEC]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def EMPTY:
  new_definition(
    @hol|{EMPTY = (\x:A. F)}|
  )

def INSERT_DEF:
  new_definition(
    @hol|{x INSERT s = \y:A. y IN s \/ (y = x)}|
  )

def UNIV:
  new_definition(
    @hol|{UNIV = (\x:A. T)}|
  )

def UNION:
  new_definition(
    @hol|{s UNION t = {x:A | x IN s \/ x IN t}}|
  )

def UNIONS:
  new_definition(
    @hol|{UNIONS s = {x:A | ?u. u IN s /\ x IN u}}|
  )

def INTER:
  new_definition(
    @hol|{s INTER t = {x:A | x IN s /\ x IN t}}|
  )

def INTERS:
  new_definition(
    @hol|{INTERS s = {x:A | !u. u IN s ==> x IN u}}|
  )

def DIFF:
  new_definition(
    @hol|{s DIFF t =  {x:A | x IN s /\ ~(x IN t)}}|
  )

def INSERT:
  prove(
    [
      @hol|{x INSERT s = {y:A | y IN s \/ (y = x)}}|,
      REWRITE_TAC(PairList [EXTENSION, INSERT_DEF, IN_ELIM_THM])
    ]
  )

def DELETE:
  new_definition(
    @hol|{s DELETE x = {y:A | y IN s /\ ~(y = x)}}|
  )

def SUBSET:
  new_definition(
    @hol|{s SUBSET t <=> !x:A. x IN s ==> x IN t}|
  )

def PSUBSET:
  new_definition(
    @hol|{(s:A->bool) PSUBSET t <=> s SUBSET t /\ ~(s = t)}|
  )

def DISJOINT:
  new_definition(
    @hol|{DISJOINT (s:A->bool) t <=> (s INTER t = EMPTY)}|
  )

def SING:
  new_definition(
    @hol|{SING s = ?x:A. s = {x}}|
  )

def [sets_FINITE_RULES_v2, sets_FINITE_INDUCT_v2, FINITE_CASES]:
  new_inductive_definition(
    @hol|{FINITE (EMPTY:A->bool) /\
       !(x:A) s. FINITE s ==> FINITE (x INSERT s)}|
  )

def INFINITE:
  new_definition(
    @hol|{INFINITE (s:A->bool) <=> ~(FINITE s)}|
  )

def IMAGE:
  new_definition(
    @hol|{IMAGE (f:A->B) s = { y | ?x. x IN s /\ (y = f x)}}|
  )

def INJ:
  new_definition(
    @hol|{INJ (f:A->B) s t <=>
       (!x. x IN s ==> (f x) IN t) /\
       (!x y. x IN s /\ y IN s /\ (f x = f y) ==> (x = y))}|
  )

def SURJ:
  new_definition(
    @hol|{SURJ (f:A->B) s t <=>
       (!x. x IN s ==> (f x) IN t) /\
       (!x. (x IN t) ==> ?y. y IN s /\ (f y = x))}|
  )

def BIJ:
  new_definition(
    @hol|{BIJ (f:A->B) s t <=> INJ f s t /\ SURJ f s t}|
  )

def CHOICE:
  new_definition(
    @hol|{CHOICE s = @x:A. x IN s}|
  )

def REST:
  new_definition(
    @hol|{REST (s:A->bool) = s DELETE (CHOICE s)}|
  )

def NOT_IN_EMPTY:
  prove(
    [
      @hol|{!x:A. ~(x IN EMPTY)}|,
      REWRITE_TAC(PairList [IN, EMPTY])
    ]
  )

def IN_UNIV:
  prove(
    [
      @hol|{!x:A. x IN UNIV}|,
      REWRITE_TAC(PairList [UNIV, IN])
    ]
  )

def IN_UNION:
  prove(
    [
      @hol|{!s t (x:A). x IN (s UNION t) <=> x IN s \/ x IN t}|,
      REWRITE_TAC(PairList [IN_ELIM_THM, UNION])
    ]
  )

def IN_UNIONS:
  prove(
    [
      @hol|{!s (x:A). x IN (UNIONS s) <=> ?t. t IN s /\ x IN t}|,
      REWRITE_TAC(PairList [IN_ELIM_THM, UNIONS])
    ]
  )

def IN_INTER:
  prove(
    [
      @hol|{!s t (x:A). x IN (s INTER t) <=> x IN s /\ x IN t}|,
      REWRITE_TAC(PairList [IN_ELIM_THM, INTER])
    ]
  )

def IN_INTERS:
  prove(
    [
      @hol|{!s (x:A). x IN (INTERS s) <=> !t. t IN s ==> x IN t}|,
      REWRITE_TAC(PairList [IN_ELIM_THM, INTERS])
    ]
  )

def IN_DIFF:
  prove(
    [
      @hol|{!(s:A->bool) t x. x IN (s DIFF t) <=> x IN s /\ ~(x IN t)}|,
      REWRITE_TAC(PairList [IN_ELIM_THM, DIFF])
    ]
  )

def IN_INSERT:
  prove(
    [
      @hol|{!x:A. !y s. x IN (y INSERT s) <=> (x = y) \/ x IN s}|,
      ONCE_REWRITE_TAC(PairList [DISJ_SYM]) then_tac \
      REWRITE_TAC(PairList [IN_ELIM_THM, INSERT])
    ]
  )

def IN_DELETE:
  prove(
    [
      @hol|{!s. !x:A. !y. x IN (s DELETE y) <=> x IN s /\ ~(x = y)}|,
      REWRITE_TAC(PairList [IN_ELIM_THM, DELETE])
    ]
  )

def IN_SING:
  prove(
    [
      @hol|{!x y. x IN {y:A} <=> (x = y)}|,
      REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY])
    ]
  )

def IN_IMAGE:
  prove(
    [
      @hol|{!y:B. !s f. (y IN (IMAGE f s)) <=> ?x:A. (y = f x) /\ x IN s}|,
      ONCE_REWRITE_TAC(PairList [CONJ_SYM]) then_tac \
      REWRITE_TAC(PairList [IN_ELIM_THM, IMAGE])
    ]
  )

def IN_REST:
  prove(
    [
      @hol|{!x:A. !s. x IN (REST s) <=> x IN s /\ ~(x = CHOICE s)}|,
      REWRITE_TAC(PairList [REST, IN_DELETE])
    ]
  )

def FORALL_IN_INSERT:
  prove(
    [
      @hol|{!P a s. (!x:A. x IN (a INSERT s) ==> P x) <=> P a /\ (!x. x IN s ==> P x)}|,
      REWRITE_TAC(PairList [IN_INSERT]) then_tac MESON_TAC(PairList [])
    ]
  )

def EXISTS_IN_INSERT:
  prove(
    [
      @hol|{!P a s. (?x:A. x IN (a INSERT s) /\ P x) <=> P a \/ ?x. x IN s /\ P x}|,
      REWRITE_TAC(PairList [IN_INSERT]) then_tac MESON_TAC(PairList [])
    ]
  )

def FORALL_IN_UNION:
  prove(
    [
      @hol|{!P s t:A->bool.
         (!x. x IN s UNION t ==> P x) <=>
         (!x. x IN s ==> P x) /\ (!x. x IN t ==> P x)}|,
      REWRITE_TAC(PairList [IN_UNION]) then_tac MESON_TAC(PairList [])
    ]
  )

def EXISTS_IN_UNION:
  prove(
    [
      @hol|{!P s t:A->bool.
         (?x. x IN s UNION t /\ P x) <=>
         (?x. x IN s /\ P x) \/ (?x. x IN t /\ P x)}|,
      REWRITE_TAC(PairList [IN_UNION]) then_tac MESON_TAC(PairList [])
    ]
  )

def FORALL_IN_IMAGE:
  prove(
    [
      @hol|{!(f:A->B) s. (!y. y IN IMAGE f s ==> P y) <=> (!x. x IN s ==> P(f x))}|,
      REWRITE_TAC(PairList [IN_IMAGE]) then_tac MESON_TAC(PairList [])
    ]
  )

def EXISTS_IN_IMAGE:
  prove(
    [
      @hol|{!(f:A->B) s. (?y. y IN IMAGE f s /\ P y) <=> ?x. x IN s /\ P(f x)}|,
      REWRITE_TAC(PairList [IN_IMAGE]) then_tac MESON_TAC(PairList [])
    ]
  )

def FORALL_IN_GSPEC:
  prove(
    [
      @hol|{(!P Q (f:A->B). (!z. z IN {f x | P x} ==> Q z) <=> (!x. P x ==> Q(f x))) /\
         (!P Q (f:A->B->C).
              (!z. z IN {f x y | P x y} ==> Q z) <=>
              (!x y. P x y ==> Q(f x y))) /\
         (!P Q (f:A->B->C->D).
              (!z. z IN {f w x y | P w x y} ==> Q z) <=>
              (!w x y. P w x y ==> Q(f w x y))) /\
         (!P Q (f:A->B->C->D->E).
              (!z. z IN {f v w x y | P v w x y} ==> Q z) <=>
              (!v w x y. P v w x y ==> Q(f v w x y)))}|,
      REWRITE_TAC(PairList [GSPEC, IN_ELIM_THM]) then_tac MESON_TAC(PairList [])
    ]
  )

def EXISTS_IN_GSPEC:
  prove(
    [
      @hol|{(!P Q (f:A->B). (?z. z IN {f x | P x} /\ Q z) <=> (?x. P x /\ Q(f x))) /\
         (!P Q (f:A->B->C).
              (?z. z IN {f x y | P x y} /\ Q z) <=>
              (?x y. P x y /\ Q(f x y))) /\
         (!P Q (f:A->B->C->D).
              (?z. z IN {f w x y | P w x y} /\ Q z) <=>
              (?w x y. P w x y /\ Q(f w x y))) /\
         (!P Q (f:A->B->C->D->E).
              (?z. z IN {f v w x y | P v w x y} /\ Q z) <=>
              (?v w x y. P v w x y /\ Q(f v w x y)))}|,
      REWRITE_TAC(PairList [GSPEC, IN_ELIM_THM]) then_tac MESON_TAC(PairList [])
    ]
  )

def UNIONS_IMAGE:
  prove(
    [
      @hol|{!(f:A->B->bool) s. UNIONS (IMAGE f s) = {y | ?x. x IN s /\ y IN f x}}|,
      REPEAT(GEN_TAC) then_tac GEN_REWRITE_TAC(I)(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [IN_UNIONS, IN_IMAGE, IN_ELIM_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def INTERS_IMAGE:
  prove(
    [
      @hol|{!(f:A->B->bool) s. INTERS (IMAGE f s) = {y | !x. x IN s ==> y IN f x}}|,
      REPEAT(GEN_TAC) then_tac GEN_REWRITE_TAC(I)(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [IN_INTERS, IN_IMAGE, IN_ELIM_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def UNIONS_GSPEC:
  prove(
    [
      @hol|{(!P (f:A->B->bool).
              UNIONS {f x | P x} = {a | ?x. P x /\ a IN (f x)}) /\
         (!P (f:A->B->C->bool).
              UNIONS {f x y | P x y} = {a | ?x y. P x y /\ a IN (f x y)}) /\
         (!P (f:A->B->C->D->bool).
              UNIONS {f x y z | P x y z} =
              {a | ?x y z. P x y z /\ a IN (f x y z)})}|,
      REPEAT(STRIP_TAC) then_tac GEN_REWRITE_TAC(I)(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [IN_UNIONS, IN_ELIM_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def INTERS_GSPEC:
  prove(
    [
      @hol|{(!P (f:A->B->bool).
              INTERS {f x | P x} = {a | !x. P x ==> a IN (f x)}) /\
         (!P (f:A->B->C->bool).
              INTERS {f x y | P x y} = {a | !x y. P x y ==> a IN (f x y)}) /\
         (!P (f:A->B->C->D->bool).
              INTERS {f x y z | P x y z} =
              {a | !x y z. P x y z ==> a IN (f x y z)})}|,
      REPEAT(STRIP_TAC) then_tac GEN_REWRITE_TAC(I)(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [IN_INTERS, IN_ELIM_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def CHOICE_DEF:
  prove(
    [
      @hol|{!s:A->bool. ~(s = EMPTY) ==> (CHOICE s) IN s}|,
      REWRITE_TAC(PairList [CHOICE, EXTENSION, NOT_IN_EMPTY, NOT_FORALL_THM, EXISTS_THM])
    ]
  )

def SET_TAC:
  let PRESET_CONV:
    (
      REWRITE_CONV(PairList [INTERS_IMAGE, INTERS_GSPEC, UNIONS_IMAGE, UNIONS_GSPEC]) then_conv \
      REWRITE_CONV(PairList [EXTENSION, SUBSET, PSUBSET, DISJOINT, SING, BIJ, INJ, SURJ]) then_conv \
      REWRITE_CONV(
        PairList [
          NOT_IN_EMPTY,
          IN_UNIV,
          IN_UNION,
          IN_INTER,
          IN_DIFF,
          IN_INSERT,
          IN_DELETE,
          IN_REST,
          IN_INTERS,
          IN_UNIONS,
          IN_IMAGE,
          IN_ELIM_THM,
          IN
        ]
      )
    )
  fun(ths):
    (
      MAP_EVERY(MP_TAC)(ths) then_tac POP_ASSUM_LIST(K(ALL_TAC)) then_tac \
      REPEAT(COND_CASES_TAC then_tac POP_ASSUM(MP_TAC)) then_tac \
      CONV_TAC(PRESET_CONV) then_tac \
      MAP_EVERY(MP_TAC)(filter((fun(th): (CONV_RULE(PRESET_CONV)(th) == TRUTH)))(ths)) then_tac \
      REWRITE_TAC(PairList [IN]) then_tac \
      MESON_TAC(PairList [])
    )

fun SET_RULE(tm): prove([tm, SET_TAC(PairList [])])

def NOT_EQUAL_SETS:
  prove(
    [
      @hol|{!s:A->bool. !t. ~(s = t) <=> ?x. x IN t <=> ~(x IN s)}|,
      SET_TAC(PairList [])
    ]
  )

def INSERT_RESTRICT:
  prove(
    [
      @hol|{!P s a:A.
         {x | x IN a INSERT s /\ P x} =
         if P a then a INSERT {x | x IN s /\ P x} else {x | x IN s /\ P x}}|,
      REPEAT(GEN_TAC) then_tac COND_CASES_TAC then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def UNIV_1:
  prove(
    [
      @hol|{(:1) = {one}}|,
      SET_TAC(PairList [one])
    ]
  )

def MEMBER_NOT_EMPTY:
  prove(
    [
      @hol|{!s:A->bool. (?x. x IN s) <=> ~(s = EMPTY)}|,
      SET_TAC(PairList [])
    ]
  )

def UNIV_NOT_EMPTY:
  prove(
    [
      @hol|{~(UNIV:A->bool = EMPTY)}|,
      SET_TAC(PairList [])
    ]
  )

def EMPTY_NOT_UNIV:
  prove(
    [
      @hol|{~(EMPTY:A->bool = UNIV)}|,
      SET_TAC(PairList [])
    ]
  )

def EQ_UNIV:
  prove(
    [
      @hol|{(!x:A. x IN s) <=> (s = UNIV)}|,
      SET_TAC(PairList [])
    ]
  )

def SUBSET_TRANS:
  prove(
    [
      @hol|{!(s:A->bool) t u. s SUBSET t /\ t SUBSET u ==> s SUBSET u}|,
      SET_TAC(PairList [])
    ]
  )

def SUBSET_REFL:
  prove(
    [
      @hol|{!s:A->bool. s SUBSET s}|,
      SET_TAC(PairList [])
    ]
  )

def SUBSET_ANTISYM:
  prove(
    [
      @hol|{!(s:A->bool) t. s SUBSET t /\ t SUBSET s ==> s = t}|,
      SET_TAC(PairList [])
    ]
  )

def SUBSET_ANTISYM_EQ:
  prove(
    [
      @hol|{!(s:A->bool) t. s SUBSET t /\ t SUBSET s <=> s = t}|,
      SET_TAC(PairList [])
    ]
  )

def EMPTY_SUBSET:
