def CARD_LE_INJ:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("B"), Bool),
          Implies(
            And(
              App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
              And(
                App(Const("FINITE", Fun(Fun(Tvar("B"), Bool), Bool)), [Ref("t")]),
                App(
                  Const("<=", Fun(Num, Fun(Num, Bool))),
                  [
                    App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")]),
                    App(Const("CARD", Fun(Fun(Tvar("B"), Bool), Num)), [Ref("t")])
                  ]
                )
              )
            ),
            Exists(
              "f",
              Fun(Tvar("A"), Tvar("B")),
              And(
                App(
                  Const("SUBSET", Fun(Fun(Tvar("B"), Bool), Fun(Fun(Tvar("B"), Bool), Bool))),
                  [
                    App(
                      Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                      [Ref("f"), Ref("s")]
                    ),
                    Ref("t")
                  ]
                ),
                Forall(
                  "x",
                  Tvar("A"),
                  Forall(
                    "y",
                    Tvar("A"),
                    Implies(
                      And(
                        App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                        And(
                          App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("y"), Ref("s")]),
                          Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("f"), [Ref("y")]))
                        )
                      ),
                      Eq(Tvar("A"), Ref("x"), Ref("y"))
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
                                            REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM])
                                          ) then_tac \
                                          MATCH_MP_TAC(FINITE_INDUCT_STRONG)
                                        ) then_tac \
                                        REWRITE_TAC(PairList [IMAGE_CLAUSES, EMPTY_SUBSET, NOT_IN_EMPTY])
                                      ) then_tac \
                                      SIMP_TAC(PairList [CARD_CLAUSES])
                                    ) then_tac \
                                    MAP_EVERY(X_GEN_TAC)(PairList [hol_term(Var("x", Tvar("A"))), hol_term(Var("s", Fun(Tvar("A"), Bool)))])
                                  ) then_tac \
                                  STRIP_TAC
                                ) then_tac \
                                MATCH_MP_TAC(FINITE_INDUCT_STRONG)
                              ) then_tac \
                              REWRITE_TAC(PairList [CARD_CLAUSES, LE, NOT_SUC])
                            ) then_tac \
                            MAP_EVERY(X_GEN_TAC)(PairList [hol_term(Var("y", Tvar("B"))), hol_term(Var("t", Fun(Tvar("B"), Bool)))])
                          ) then_tac \
                          SIMP_TAC(PairList [CARD_CLAUSES])
                        ) then_tac \
                        DISCH_THEN(CONJUNCTS_THEN2(K(ALL_TAC))(STRIP_ASSUME_TAC))
                      ) then_tac \
                      REWRITE_TAC(PairList [LE_SUC])
                    ) then_tac \
                    STRIP_TAC
                  ) then_tac \
                  FIRST_X_ASSUM(o(MP_TAC)(SPEC(hol_term(Var("t", Fun(Tvar("B"), Bool))))))
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              DISCH_THEN(
                X_CHOOSE_THEN(hol_term(Var("f", Fun(Tvar("A"), Tvar("B")))))(STRIP_ASSUME_TAC)
              )
            ) then_tac \
            EXISTS_TAC(
              hol_term(Lambda(
                "z",
                Tvar("A"),
                App(
                  Const("COND", Fun(Bool, Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))))),
                  [
