                GSPEC(
                  fun (gen_pvar_227 :: A):
                    exists x :: A: SETSPEC(gen_pvar_227, IN(f(x), t), x)
                )
                  == k)
             <=> (forall (x :: A, y :: A): f(x) == f(y) ==> x == y)),
      (
