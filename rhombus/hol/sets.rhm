def SURJECTIVE_IFF_INJECTIVE_GEN:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (s :: A -> bool, t :: B -> bool, f :: A -> B):
           FINITE(s) && (FINITE(t) && (CARD(s) == CARD(t) && SUBSET(IMAGE(f, s), t)))
             ==> ((forall y :: B: IN(y, t) ==> (exists x :: A: IN(x, s) && f(x) == y))
                    <=> (forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> x == y))),
      (
        (
          (REPEAT(STRIP_TAC) then_tac EQ_TAC) then_tac \
          REPEAT(STRIP_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                ASM_CASES_TAC(hol:
                                var x :: A
                                var y :: A
                                x == y) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              SUBGOAL_THEN(
                (hol:
                   var s :: A -> bool
                   var f :: A -> B
                   var y :: A
                   const CARD :: (A -> bool) -> num
                   const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                   const DELETE :: (A -> bool) -> A -> A -> bool
                   CARD(s) <= CARD(IMAGE(f, DELETE(s, y))))
              )(MP_TAC)
            ) then_list \
            PairList [
              (
                (
                  (
                    (ASM_REWRITE_TAC(PairList []) then_tac MATCH_MP_TAC(CARD_SUBSET)) then_tac \
                    ASM_SIMP_TAC(PairList [FINITE_IMAGE, FINITE_DELETE])
                  ) then_tac \
                  REWRITE_TAC(PairList [SUBSET, IN_IMAGE, IN_DELETE])
                ) then_tac \
                ASM_MESON_TAC(PairList [])
              ),
              (
                (
                  (
                    (
                      (REWRITE_TAC(PairList [NOT_LE]) then_tac MATCH_MP_TAC(LET_TRANS)) then_tac \
                      EXISTS_TAC(
                        (hol:
                           var s :: A -> bool
                           var y :: A
                           const CARD :: (A -> bool) -> num
                           const DELETE :: (A -> bool) -> A -> A -> bool
                           CARD(DELETE(s, y)))
                      )
                    ) then_tac \
                    ASM_SIMP_TAC(PairList [CARD_IMAGE_LE, FINITE_DELETE])
                  ) then_tac \
                  ASM_SIMP_TAC(
                    PairList [
                      CARD_DELETE,
                      ARITH_RULE(
                        (hol:
                           var x :: num
                           x - (1 :: num) < x <=> x != (0 :: num))
                      )
                    ]
                  )
                ) then_tac \
                ASM_MESON_TAC(PairList [CARD_EQ_0, MEMBER_NOT_EMPTY])
              )
            ]
          ),
          (
            (
              SUBGOAL_THEN(
                (hol:
                   var f :: A -> B
                   var s :: A -> bool
                   var t :: B -> bool
                   const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                   IMAGE(f, s) == t)
              )(MP_TAC) then_list \
              PairList [ALL_TAC, ASM_MESON_TAC(PairList [EXTENSION, IN_IMAGE])]
            ) then_tac \
            ASM_MESON_TAC(PairList [CARD_SUBSET_EQ, CARD_IMAGE_INJ])
          )
        ]
      )
    ]
  )

def SURJECTIVE_IFF_INJECTIVE:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (s :: A -> bool, f :: A -> A):
           FINITE(s) && SUBSET(IMAGE(f, s), s)
             ==> ((forall y :: A: IN(y, s) ==> (exists x :: A: IN(x, s) && f(x) == y))
                    <=> (forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> x == y))),
      SIMP_TAC(PairList [SURJECTIVE_IFF_INJECTIVE_GEN])
    ]
  )

def IMAGE_IMP_INJECTIVE_GEN:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (s :: A -> bool, t :: B -> bool, f :: A -> B):
           FINITE(s) && (CARD(s) == CARD(t) && IMAGE(f, s) == t)
             ==> (forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> x == y)),
      (
