def le_c:
  new_definition(
    hol_term(Iff(
      App(
        Var("<=_c", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("B"), Bool), Bool))),
        [Var("s", Fun(Tvar("A"), Bool)), Var("t", Fun(Tvar("B"), Bool))]
      ),
      Exists(
        "f",
        Fun(Tvar("A"), Tvar("B")),
        And(
          Forall(
            "x",
            Tvar("A"),
            Implies(
              App(
                Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                [Ref("x"), Var("s", Fun(Tvar("A"), Bool))]
              ),
              App(
                Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))),
                [App(Ref("f"), [Ref("x")]), Var("t", Fun(Tvar("B"), Bool))]
              )
            )
          ),
          Forall(
            "x",
            Tvar("A"),
            Forall(
              "y",
              Tvar("A"),
              Implies(
                And(
                  App(
                    Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                    [Ref("x"), Var("s", Fun(Tvar("A"), Bool))]
                  ),
                  And(
                    App(
                      Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                      [Ref("y"), Var("s", Fun(Tvar("A"), Bool))]
                    ),
                    Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("f"), [Ref("y")]))
                  )
                ),
                Eq(Tvar("A"), Ref("x"), Ref("y"))
              )
            )
          )
        )
      )
    ))
  )

