                                                    o(MP_TAC)(
                                                      SPEC(
                                                        (hol:
                                                           var a :: real
                                                           var b :: real
                                                           const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                                                           const real_of_num :: num -> real
                                                           const UNIV :: A -> bool
                                                           IMAGE(fun (n :: num): a + (b - a) / (real_of_num(n) + (2 :: real)), UNIV))
                                                      )
                                                    )
                                                  )
