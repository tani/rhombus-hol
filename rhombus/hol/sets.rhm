                  PairList [
                    (hol: var f :: A -> B; f),
                    (hol: var g :: B -> A; g)
                  ]
                )
              ) then_tac \
              STRIP_TAC
            ) then_tac \
            EXISTS_TAC(
              (hol:
                 var a :: A
                 var b :: B
                 var f :: A -> B
                 fun (x :: A): if x == a | b | f(x))
            )
          ) then_tac \
          EXISTS_TAC(
            (hol:
               var b :: B
               var a :: A
               var g :: B -> A
               fun (y :: B): if y == b | a | g(y))
          )
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def BIJECTIONS_HAS_SIZE:
  prove(
    [
