         const EMPTY :: A -> bool
         const inf :: (real -> bool) -> real
         const IN :: A -> (A -> bool) -> bool
         forall s :: real -> bool:
           FINITE(s) && s != EMPTY
             ==> (inf(s) == a <=> IN(a, s) && (forall y :: real: IN(y, s) ==> a <= y))),
      (
        ASM_SIMP_TAC(
          PairList [
            GSYM(REAL_LE_ANTISYM),
            REAL_LE_INF_FINITE,
            REAL_INF_LE_FINITE,
            NOT_INSERT_EMPTY,
            FINITE_INSERT,
            FINITE_EMPTY
          ]
        ) then_tac \
        MESON_TAC(PairList [REAL_LE_REFL, REAL_LE_TRANS, REAL_LE_ANTISYM])
      )
    ]
  )

def INF_INSERT_FINITE:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const inf :: (real -> bool) -> real
         const INSERT :: A -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         const real_min :: real -> real -> real
         forall (x :: real, s :: real -> bool):
           FINITE(s) ==> inf(INSERT(x, s)) == (if s == EMPTY | x | real_min(x, inf(s)))),
      (
        (
          (
            (
              (
                (
                  (REPEAT(STRIP_TAC) then_tac COND_CASES_TAC) then_tac \
                  ASM_SIMP_TAC(
                    PairList [
                      INF_UNIQUE_FINITE,
                      FINITE_INSERT,
                      FINITE_EMPTY,
                      NOT_INSERT_EMPTY,
                      FORALL_IN_INSERT,
                      NOT_IN_EMPTY
                    ]
                  )
                ) then_tac \
                REWRITE_TAC(PairList [IN_SING, REAL_LE_REFL])
              ) then_tac \
              REWRITE_TAC(PairList [real_min])
            ) then_tac \
            COND_CASES_TAC
          ) then_tac \
          ASM_SIMP_TAC(PairList [INF_FINITE, IN_INSERT, REAL_LE_REFL])
        ) then_tac \
        ASM_MESON_TAC(PairList [INF_FINITE, REAL_LE_TOTAL, REAL_LE_TRANS])
      )
    ]
  )

def INF_SING:
