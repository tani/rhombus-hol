def INJECTIVE_IMAGE:
  prove(
    [
      (hol:
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         forall f :: A -> B:
           (forall (s :: A -> bool, t :: A -> bool): IMAGE(f, s) == IMAGE(f, t) ==> s == t)
             <=> (forall (x :: A, y :: A): f(x) == f(y) ==> x == y)),
