def UNIONS_GSPEC:
  prove(
    [
      (hol:
         const UNIONS :: ((A -> bool) -> bool) -> A -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         (forall (P :: A -> bool, f :: A -> B -> bool):
            UNIONS(
              GSPEC(
                fun (gen_pvar_18 :: B -> bool):
                  exists x :: A: SETSPEC(gen_pvar_18, P(x), f(x))
              )
            )
              == GSPEC(
                   fun (gen_pvar_19 :: B):
                     exists a :: B: SETSPEC(gen_pvar_19, exists x :: A: P(x) && IN(a, f(x)), a)
                 ))
           && ((forall (P :: A -> B -> bool, f :: A -> B -> C -> bool):
                  UNIONS(
                    GSPEC(
                      fun (gen_pvar_20 :: C -> bool):
