def INF:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Real, Bool),
        Implies(
          And(
            Not(Eq(Fun(Real, Bool), Ref("s"), Const("EMPTY", Fun(Real, Bool)))),
            Exists(
              "b",
              Real,
              Forall(
                "x",
                Real,
                Implies(
