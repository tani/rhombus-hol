def EXISTS_IN_UNIONS:
  prove(
    [
      @hol|{!P s. (?x:A. x IN UNIONS s /\ P x) <=> (?t x. t IN s /\ x IN t /\ P x)}|,
      SET_TAC(PairList [])
    ]
