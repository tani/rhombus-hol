def SUBSET_UNION:
  prove(
    [
      @hol|{(!s:A->bool. !t. s SUBSET (s UNION t)) /\
         (!s:A->bool. !t. s SUBSET (t UNION s))}|,
      SET_TAC(PairList [])
    ]
  )

def SUBSET_UNION_ABSORPTION:
  prove(
    [
      @hol|{!s:A->bool. !t. s SUBSET t <=> (s UNION t = t)}|,
