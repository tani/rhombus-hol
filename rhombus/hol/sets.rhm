def dest_setenum:
  let fn = splitlist(dest_binary("INSERT"))
  fun(tm):
    let [l, n] = fn(tm)
    (if (is_const(n) && (fst(dest_const(n)) == "EMPTY")) | l | failwith("dest_setenum: not a finite set enumeration"))

def is_setenum = can(dest_setenum)

def mk_setenum:
  let insert_atm_2 = hol: const INSERT :: A -> (A -> bool) -> A -> bool; INSERT
  let nil_atm_2 = hol: const EMPTY :: A -> bool; EMPTY
  fun([l, ty]):
    let insert_tm_2 = inst(PairList [[ty, aty]])(insert_atm_2)
    let nil_tm_2 = inst(PairList [[ty, aty]])(nil_atm_2)
    itlist(mk_binop(insert_tm_2))(l)(nil_tm_2)

fun mk_fset(l): mk_setenum([l, type_of(hd(l))])

def pairwise:
  new_definition(
    (hol:
       var pairwise :: (A -> A -> bool) -> (A -> bool) -> bool
       var r :: A -> A -> bool
       var s :: A -> bool
       const IN :: A -> (A -> bool) -> bool
       pairwise(r, s) <=> (forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && x != y) ==> r(x, y)))
  )

