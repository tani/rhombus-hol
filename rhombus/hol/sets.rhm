      )
    ]
  )

def SUP_FINITE:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const EMPTY :: A -> bool
         const IN :: A -> (A -> bool) -> bool
         const sup :: (real -> bool) -> real
         forall s :: real -> bool:
