                  )
                ),
                Forall(
                  "c",
                  Real,
                  Implies(
                    App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Ref("c"), Ref("l")]),
                    Exists(
                      "x",
                      Real,
                      And(
                        App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Ref("s")]),
                        App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Ref("c"), Ref("x")])
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
                  PairList [
                    (
                      (
                        (
                          (INTRO_TAC("hp") then_tac CONJ_TAC) then_list \
                          PairList [
                            (
                              HYP_TAC("hp")(REWRITE_RULE(PairList [HAS_SUP_SUP])) then_tac \
                              ASM_REWRITE_TAC(PairList [])
                            ),
                            ALL_TAC
                          ]
                        ) then_tac \
                        CONJ_TAC
                      ) then_list \
                      PairList [
                        ASM_MESON_TAC(PairList [HAS_SUP_UBOUND]),
                        ASM_MESON_TAC(PairList [HAS_SUP_APPROACH])
                      ]
                    ),
                    ALL_TAC
                  ]
                ) then_tac \
                INTRO_TAC("ne bound approach")
              ) then_tac \
              ASM_REWRITE_TAC(PairList [has_sup])
            ) then_tac \
            GEN_TAC
          ) then_tac \
          EQ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (INTRO_TAC("hp") then_tac REWRITE_TAC(PairList [GSYM(REAL_NOT_LT)])) then_tac \
                      INTRO_TAC("lc")
                    ) then_tac \
                    REMOVE_THEN("approach")(
                      o(MP_TAC)(
                        SPEC(
                          hol_term(App(
                            Const("real_div", Fun(Real, Fun(Real, Real))),
                            [
                              App(Const("real_add", Fun(Real, Fun(Real, Real))), [Var("l", Real), Var("c", Real)]),
                              App(
                                Const("real_of_num", Fun(Num, Real)),
                                [
                                  App(
                                    Const("NUMERAL", Fun(Num, Num)),
                                    [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                                  )
                                ]
                              )
                            ]
                          ))
                        )
                      )
                    )
                  ) then_tac \
                  ANTS_TAC
                ) then_list \
                PairList [ASM_REAL_ARITH_TAC, INTRO_TAC("@x0. x0 +")]
              ) then_tac \
              USE_THEN("x0")(o(HYP_TAC("hp"))(C(MATCH_MP)))
            ) then_tac \
            ASM_REAL_ARITH_TAC
          ),
          (
            (
              INTRO_TAC("hp; !x; x") then_tac \
              TRANS_TAC(REAL_LE_TRANS)(hol_term(Var("l", Real)))
            ) then_tac \
            ASM_SIMP_TAC(PairList [])
          )
        ]
      )
    ]
  )

def HAS_INF_LE:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Real, Bool),
        Forall(
          "t",
          Fun(Real, Bool),
          Forall(
            "l",
            Real,
            Forall(
              "m",
              Real,
              Implies(
                And(
                  App(Const("has_inf", Fun(Fun(Real, Bool), Fun(Real, Bool))), [Ref("s"), Ref("l")]),
                  And(
                    App(Const("has_inf", Fun(Fun(Real, Bool), Fun(Real, Bool))), [Ref("t"), Ref("m")]),
                    Forall(
                      "y",
                      Real,
                      Implies(
                        App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("y"), Ref("t")]),
                        Exists(
                          "x",
                          Real,
                          And(
                            App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Ref("s")]),
                            App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("y")])
                          )
                        )
                      )
                    )
                  )
                ),
                App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("l"), Ref("m")])
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                INTRO_TAC("!s t l m; l m le") then_tac \
                                HYP_TAC("l: s l1 l2")(REWRITE_RULE(PairList [HAS_INF]))
                              ) then_tac \
                              HYP_TAC("m: t m1 m2")(REWRITE_RULE(PairList [HAS_INF]))
                            ) then_tac \
                            REFUTE_THEN(o(LABEL_TAC("lt"))(REWRITE_RULE(PairList [REAL_NOT_LE])))
                          ) then_tac \
                          CLAIM_TAC(
                            "@c. c1 c2")(
                            hol_term(Exists(
                              "c",
                              Real,
                              And(
                                App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Var("m", Real), Ref("c")]),
                                App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Ref("c"), Var("l", Real)])
                              )
                            ))
                          )
                        ) then_list \
                        PairList [
                          (
                            EXISTS_TAC(
                              hol_term(App(
                                Const("real_div", Fun(Real, Fun(Real, Real))),
                                [
                                  App(Const("real_add", Fun(Real, Fun(Real, Real))), [Var("l", Real), Var("m", Real)]),
                                  App(
                                    Const("real_of_num", Fun(Num, Real)),
                                    [
                                      App(
                                        Const("NUMERAL", Fun(Num, Num)),
                                        [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]
                                      )
                                    ]
                                  )
                                ]
                              ))
                            ) then_tac \
                            ASM_REAL_ARITH_TAC
                          ),
                          ALL_TAC
                        ]
                      ) then_tac \
                      HYP_TAC("m2: +")(SPEC(hol_term(Var("c", Real))))
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [NOT_EXISTS_THM])
                  ) then_tac \
                  INTRO_TAC("!x; x xc")
                ) then_tac \
                CLAIM_TAC(
                  "@y. y yx")(
                  hol_term(Exists(
                    "y",
                    Real,
                    And(
                      App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("y"), Var("s", Fun(Real, Bool))]),
                      App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("y"), Var("x", Real)])
                    )
                  ))
                )
              ) then_list \
              PairList [HYP(MESON_TAC)("le x")(PairList []), ALL_TAC]
            ) then_tac \
            HYP_TAC("l1: +")(SPEC(hol_term(Var("y", Real))))
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_REAL_ARITH_TAC
      )
    ]
  )

