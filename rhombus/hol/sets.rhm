                    ) then_tac \
                    DISCH_THEN((fun(th): (MP_TAC(CONJUNCT1(th)) then_tac MP_TAC(th))))
                  ) then_tac \
                  DISCH_THEN(CONJUNCTS_THEN(ANTE_RES_THEN(ASSUME_TAC)))
                ) then_tac \
                REWRITE_TAC(PairList [FINREC])
              ) then_tac \
              STRIP_TAC
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

def FINREC_EXISTS_LEMMA:
  let lem:
    prove(
      [
        hol_term(Implies(
          Not(
            App(
              Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
              [Var("x", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
            )
          ),
          Eq(
            Fun(Tvar("A"), Bool),
            App(
              Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
              [
                App(
                  Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                  [Var("x", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
                ),
                Var("x", Tvar("A"))
              ]
            ),
            Var("s", Fun(Tvar("A"), Bool))
          )
        )),
        SET_TAC(PairList [])
      ]
    )
  prove(
    [
      hol_term(Forall(
        "f",
        Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
        Forall(
          "b",
          Tvar("B"),
          Forall(
            "s",
            Fun(Tvar("A"), Bool),
            Implies(
              App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
              Exists(
                "a",
                Tvar("B"),
                Exists(
                  "n",
                  Num,
                  App(
                    Const(
                      "FINREC",
                      Fun(
                        Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
                        Fun(Tvar("B"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Fun(Num, Bool))))
                      )
                    ),
                    [Ref("f"), Ref("b"), Ref("s"), Ref("a"), Ref("n")]
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          ((GEN_TAC then_tac GEN_TAC) then_tac MATCH_MP_TAC(FINITE_INDUCT_STRONG)) then_tac \
          REPEAT(STRIP_TAC)
        ) then_list \
        PairList [
          (
            MAP_EVERY(EXISTS_TAC)(
              PairList [
                hol_term(Var("b", Tvar("B"))),
                hol_term(App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]))
              ]
            ) then_tac \
            REWRITE_TAC(PairList [FINREC])
          ),
          (
            (
              (
                MAP_EVERY(EXISTS_TAC)(
                  PairList [
                    hol_term(App(
                      Var("f", Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B")))),
                      [Var("x", Tvar("A")), Var("a", Tvar("B"))]
                    )),
                    hol_term(App(Const("SUC", Fun(Num, Num)), [Var("n", Num)]))
                  ]
                ) then_tac \
                REWRITE_TAC(PairList [FINREC])
              ) then_tac \
              MAP_EVERY(EXISTS_TAC)(PairList [hol_term(Var("x", Tvar("A"))), hol_term(Var("a", Tvar("B")))])
            ) then_tac \
            FIRST_ASSUM((fun(th): ASM_REWRITE_TAC(PairList [MATCH_MP(lem)(th), IN_INSERT])))
          )
        ]
      )
    ]
  )

def FINREC_FUN_LEMMA:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Forall(
          "R",
          Fun(Tvar("A"), Fun(Tvar("B"), Fun(Tvar("C"), Bool))),
          Implies(
            And(
              Forall(
                "s",
                Tvar("A"),
                Implies(
                  App(Ref("P"), [Ref("s")]),
                  Exists("a", Tvar("B"), Exists("n", Tvar("C"), App(Ref("R"), [Ref("s"), Ref("a"), Ref("n")])))
                )
              ),
              Forall(
                "n1",
                Tvar("C"),
                Forall(
                  "n2",
                  Tvar("C"),
                  Forall(
                    "s",
                    Tvar("A"),
                    Forall(
                      "a1",
                      Tvar("B"),
                      Forall(
                        "a2",
                        Tvar("B"),
                        Implies(
                          And(
                            App(Ref("R"), [Ref("s"), Ref("a1"), Ref("n1")]),
                            App(Ref("R"), [Ref("s"), Ref("a2"), Ref("n2")])
                          ),
                          And(Eq(Tvar("B"), Ref("a1"), Ref("a2")), Eq(Tvar("C"), Ref("n1"), Ref("n2")))
                        )
                      )
                    )
                  )
                )
              )
            ),
            Exists(
              "f",
              Fun(Tvar("A"), Tvar("B")),
              Forall(
                "s",
                Tvar("A"),
                Forall(
                  "a",
                  Tvar("B"),
                  Implies(
                    App(Ref("P"), [Ref("s")]),
                    Iff(
                      Exists("n", Tvar("C"), App(Ref("R"), [Ref("s"), Ref("a"), Ref("n")])),
                      Eq(Tvar("B"), App(Ref("f"), [Ref("s")]), Ref("a"))
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                REPEAT(STRIP_TAC) then_tac \
                EXISTS_TAC(
                  hol_term(Lambda(
                    "s",
                    Tvar("A"),
                    App(
                      Const("@", Fun(Fun(Tvar("B"), Bool), Tvar("B"))),
                      [
                        Lambda(
                          "a",
                          Tvar("B"),
                          Exists(
                            "n",
                            Tvar("C"),
                            App(
                              Var("R", Fun(Tvar("A"), Fun(Tvar("B"), Fun(Tvar("C"), Bool)))),
                              [Ref("s"), Ref("a"), Ref("n")]
                            )
                          )
                        )
                      ]
                    )
                  ))
                )
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            BETA_TAC
          ) then_tac \
          EQ_TAC
        ) then_list \
        PairList [
          (
            (STRIP_TAC then_tac MATCH_MP_TAC(SELECT_UNIQUE)) then_tac \
            ASM_MESON_TAC(PairList [])
          ),
          (
            (
              DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
              CONV_TAC(SELECT_CONV)
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

