def RESTRICTION_RESTRICTION:
  prove(
    [
      (hol:
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const RESTRICTION :: (A -> bool) -> (A -> B) -> A -> B
         forall (s :: A -> bool, t :: A -> bool, f :: A -> B):
           SUBSET(s, t) ==> RESTRICTION(s, RESTRICTION(t, f)) == RESTRICTION(s, f)),
