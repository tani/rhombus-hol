def BIJECTIONS_HAS_SIZE:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("B"), Bool),
          Forall(
            "f",
            Fun(Tvar("A"), Tvar("B")),
            Forall(
              "g",
              Fun(Tvar("B"), Tvar("A")),
              Implies(
                And(
                  Forall(
                    "x",
                    Tvar("A"),
                    Implies(
                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                      And(
                        App(
                          Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))),
                          [App(Ref("f"), [Ref("x")]), Ref("t")]
                        ),
                        Eq(Tvar("A"), App(Ref("g"), [App(Ref("f"), [Ref("x")])]), Ref("x"))
                      )
                    )
                  ),
                  And(
                    Forall(
                      "y",
                      Tvar("B"),
                      Implies(
                        App(Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))), [Ref("y"), Ref("t")]),
                        And(
                          App(
                            Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                            [App(Ref("g"), [Ref("y")]), Ref("s")]
                          ),
                          Eq(Tvar("B"), App(Ref("f"), [App(Ref("g"), [Ref("y")])]), Ref("y"))
                        )
                      )
                    ),
                    App(Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))), [Ref("s"), Var("n", Num)])
                  )
                ),
                App(Const("HAS_SIZE", Fun(Fun(Tvar("B"), Bool), Fun(Num, Bool))), [Ref("t"), Var("n", Num)])
              )
            )
          )
        )
      )),
      (
        (
          REPEAT(STRIP_TAC) then_tac \
          SUBGOAL_THEN(
            hol_term(Eq(
              Fun(Tvar("B"), Bool),
              Var("t", Fun(Tvar("B"), Bool)),
              App(
                Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                [Var("f", Fun(Tvar("A"), Tvar("B"))), Var("s", Fun(Tvar("A"), Bool))]
              )
            ))
          )(SUBST_ALL_TAC)
        ) then_list \
        PairList [
          ASM(SET_TAC)(PairList []),
          (MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ) then_tac ASM_MESON_TAC(PairList []))
        ]
      )
    ]
  )

