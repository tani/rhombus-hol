                                )
                              ),
                              Forall(
                                "x",
                                Tvar("A"),
                                Implies(
                                  Not(App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")])),
                                  Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), Var("d", Tvar("B")))
                                )
                              )
                            ),
                            Ref("f")
                          ]
                        )
                      )
                    )
                  ]
                )
              ]
            )
          )
        )
      )),
      MESON_TAC(PairList [HAS_SIZE_FUNSPACE, HAS_SIZE])
    ]
  )

