                             DELETE(s, a)),
                          (hol:
                             var t :: B -> bool
                             var b :: B
                             const DELETE :: (A -> bool) -> A -> A -> bool
                             DELETE(t, b))
                        ])(
                        CARD_EQ_BIJECTIONS
                      )
                    )
