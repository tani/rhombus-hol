                                 const DELETE :: (A -> bool) -> A -> A -> bool
                                 const SUC :: num -> num
                                 FINREC(f, b, DELETE(s, y), c, SUC(n)))
                            ) then_tac \
                            DISCH_THEN(ANTE_RES_THEN(o(MP_TAC)(SPEC(hol: var x :: A; x))))
                          ) then_tac \
                          ASM_REWRITE_TAC(PairList [IN_DELETE])
                        ) then_tac \
                        DISCH_THEN(X_CHOOSE_THEN(hol: var v :: B; v)(STRIP_ASSUME_TAC))
                      ) then_tac \
                      EXISTS_TAC(
                        (hol:
                           var f :: A -> B -> B
                           var y :: A
                           var v :: B
                           f(y, v))
                      )
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [FINREC])
                  ) then_tac \
                  CONJ_TAC
                ) then_list \
                PairList [
                  (
                    (
                      MAP_EVERY(EXISTS_TAC)(PairList [(hol: var y :: A; y), (hol: var v :: B; v)]) then_tac \
                      ONCE_REWRITE_TAC(PairList [lem])
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [IN_DELETE])
                  ),
                  (FIRST_ASSUM(MATCH_MP_TAC) then_tac ASM_REWRITE_TAC(PairList []))
                ]
              )
            ]
          )
        ]
      )
    ]
  )

def FINREC_UNIQUE_LEMMA:
  prove(
    [
      (hol:
         const FINREC :: (A -> B -> B) -> B -> (A -> bool) -> B -> num -> bool
         forall (f :: A -> B -> B, b :: B):
           (forall (x :: A, y :: A, s :: B): x != y ==> f(x, f(y, s)) == f(y, f(x, s)))
             ==> (forall (n1 :: num, n2 :: num, s :: A -> bool, a1 :: B, a2 :: B):
                    FINREC(f, b, s, a1, n1) && FINREC(f, b, s, a2, n2) ==> a1 == a2 && n1 == n2)),
      (
        (
          ((REPEAT(GEN_TAC) then_tac DISCH_TAC) then_tac INDUCT_TAC) then_tac \
          INDUCT_TAC
        ) then_list \
        PairList [
          (REWRITE_TAC(PairList [FINREC]) then_tac MESON_TAC(PairList [NOT_IN_EMPTY])),
          (REWRITE_TAC(PairList [FINREC]) then_tac MESON_TAC(PairList [NOT_IN_EMPTY])),
          (REWRITE_TAC(PairList [FINREC]) then_tac MESON_TAC(PairList [NOT_IN_EMPTY])),
          (
            (
              (
                (
                  (
                    (
                      IMP_RES_THEN(ASSUME_TAC)(FINREC_SUC_LEMMA) then_tac \
                      REPEAT(GEN_TAC)
                    ) then_tac \
                    DISCH_THEN((fun(th): (MP_TAC(CONJUNCT1(th)) then_tac MP_TAC(th))))
                  ) then_tac \
                  DISCH_THEN(CONJUNCTS_THEN(ANTE_RES_THEN(ASSUME_TAC)))
                ) then_tac \
                REWRITE_TAC(PairList [FINREC])
              ) then_tac \
              STRIP_TAC
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

def FINREC_EXISTS_LEMMA:
  let lem:
    prove(
      [
        (hol:
           var x :: A
           var s :: A -> bool
           const IN :: A -> (A -> bool) -> bool
           const DELETE :: (A -> bool) -> A -> A -> bool
           const INSERT :: A -> (A -> bool) -> A -> bool
           !IN(x, s) ==> DELETE(INSERT(x, s), x) == s),
        SET_TAC(PairList [])
      ]
    )
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const FINREC :: (A -> B -> B) -> B -> (A -> bool) -> B -> num -> bool
         forall (f :: A -> B -> B, b :: B, s :: A -> bool):
           FINITE(s) ==> (exists (a :: B, n :: num): FINREC(f, b, s, a, n))),
      (
        (
          ((GEN_TAC then_tac GEN_TAC) then_tac MATCH_MP_TAC(FINITE_INDUCT_STRONG)) then_tac \
          REPEAT(STRIP_TAC)
        ) then_list \
        PairList [
          (
            MAP_EVERY(EXISTS_TAC)(
              PairList [
                (hol: var b :: B; b),
                (hol:
                   (0 :: num))
              ]
            ) then_tac \
            REWRITE_TAC(PairList [FINREC])
          ),
          (
            (
              (
                MAP_EVERY(EXISTS_TAC)(
                  PairList [
                    (hol:
                       var f :: A -> B -> B
                       var x :: A
                       var a :: B
                       f(x, a)),
                    (hol:
                       var n :: num
                       const SUC :: num -> num
                       SUC(n))
                  ]
                ) then_tac \
                REWRITE_TAC(PairList [FINREC])
              ) then_tac \
              MAP_EVERY(EXISTS_TAC)(PairList [(hol: var x :: A; x), (hol: var a :: B; a)])
            ) then_tac \
            FIRST_ASSUM((fun(th): ASM_REWRITE_TAC(PairList [MATCH_MP(lem)(th), IN_INSERT])))
          )
        ]
      )
    ]
  )

def FINREC_FUN_LEMMA:
  prove(
    [
      (hol:
         forall (P :: A -> bool, R :: A -> B -> C -> bool):
           ((forall s :: A: P(s) ==> (exists (a :: B, n :: C): R(s, a, n)))
              && (forall (n1 :: C, n2 :: C, s :: A, a1 :: B, a2 :: B):
                    R(s, a1, n1) && R(s, a2, n2) ==> a1 == a2 && n1 == n2))
             ==> (exists f :: A -> B:
                    forall (s :: A, a :: B): P(s) ==> ((exists n :: C: R(s, a, n)) <=> f(s) == a))),
      (
        (
          (
            (
              (
                REPEAT(STRIP_TAC) then_tac \
                EXISTS_TAC(
                  (hol:
                     var R :: A -> B -> C -> bool
                     const #{@} :: (A -> bool) -> A
                     fun (s :: A): #{@}(fun (a :: B): exists n :: C: R(s, a, n)))
                )
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            BETA_TAC
          ) then_tac \
          EQ_TAC
        ) then_list \
        PairList [
          (
            (STRIP_TAC then_tac MATCH_MP_TAC(SELECT_UNIQUE)) then_tac \
            ASM_MESON_TAC(PairList [])
          ),
          (
            (
              DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
              CONV_TAC(SELECT_CONV)
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

def FINREC_FUN:
  prove(
    [
      (hol:
         const EMPTY :: A -> bool
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const DELETE :: (A -> bool) -> A -> A -> bool
         forall (f :: A -> B -> B, b :: B):
           (forall (x :: A, y :: A, s :: B): x != y ==> f(x, f(y, s)) == f(y, f(x, s)))
             ==> (exists g :: (A -> bool) -> B:
                    g(EMPTY) == b
                      && (forall (s :: A -> bool, x :: A):
                            FINITE(s) && IN(x, s) ==> g(s) == f(x, g(DELETE(s, x)))))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      REPEAT(STRIP_TAC) then_tac \
                      IMP_RES_THEN(MP_TAC)(FINREC_UNIQUE_LEMMA)
                    ) then_tac \
                    DISCH_THEN(o(MP_TAC)(SPEC(hol: var b :: B; b)))
                  ) then_tac \
                  DISCH_THEN(
                    o(MP_TAC)(
                      CONJ(
                        SPECL(
                          PairList [
                            (hol: var f :: A -> B -> B; f),
                            (hol: var b :: B; b)
                          ])(
                          FINREC_EXISTS_LEMMA
                        )
                      )
                    )
                  )
                ) then_tac \
                DISCH_THEN(o(MP_TAC)(MATCH_MP(FINREC_FUN_LEMMA)))
              ) then_tac \
              DISCH_THEN(X_CHOOSE_TAC(hol: var g :: (A -> bool) -> B; g))
            ) then_tac \
            EXISTS_TAC(hol: var g :: (A -> bool) -> B; g)
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (
            SUBGOAL_THEN(
              (hol:
                 const FINITE :: (A -> bool) -> bool
                 const EMPTY :: A -> bool
                 FINITE(EMPTY))
            )(ANTE_RES_THEN((fun(th): GEN_REWRITE_TAC(I)(PairList [GSYM(th)])))) then_list \
            PairList [
              REWRITE_TAC(PairList [sets_FINITE_RULES_v2]),
              (
                EXISTS_TAC(hol:
                             (0 :: num)) then_tac \
                REWRITE_TAC(PairList [FINREC])
              )
            ]
          ),
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(STRIP_TAC) then_tac \
                          ANTE_RES_THEN(MP_TAC)(
                            ASSUME(
                              (hol:
                                 var s :: A -> bool
                                 const FINITE :: (A -> bool) -> bool
                                 FINITE(s))
                            )
                          )
                        ) then_tac \
                        DISCH_THEN(o(ASSUME_TAC)(GSYM))
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_tac \
                    FIRST_ASSUM(
                      o(MP_TAC)(
                        SPEC(
                          (hol:
                             var g :: (A -> bool) -> B
                             var s :: A -> bool
                             g(s))
                        )
                      )
                    )
                  ) then_tac \
                  REWRITE_TAC(PairList [])
                ) then_tac \
                REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM])
              ) then_tac \
              INDUCT_TAC
            ) then_list \
            PairList [
              (
                (
                  (ASM_REWRITE_TAC(PairList [FINREC]) then_tac DISCH_TAC) then_tac \
                  UNDISCH_TAC(
                    (hol:
                       var x :: A
                       var s :: A -> bool
                       const IN :: A -> (A -> bool) -> bool
                       IN(x, s))
                  )
                ) then_tac \
                ASM_REWRITE_TAC(PairList [NOT_IN_EMPTY])
              ),
              (
                (
                  (
                    (
                      (
                        IMP_RES_THEN(ASSUME_TAC)(FINREC_SUC_LEMMA) then_tac \
                        DISCH_THEN(ANTE_RES_THEN(o(MP_TAC)(SPEC(hol: var x :: A; x))))
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_tac \
                    DISCH_THEN(
                      X_CHOOSE_THEN(hol: var w :: B; w)(CONJUNCTS_THEN(ASSUME_TAC))
                    )
                  ) then_tac \
                  SUBGOAL_THEN(
                    (hol:
                       var g :: (A -> bool) -> B
                       var s :: A -> bool
                       var x :: A
                       var w :: B
                       const DELETE :: (A -> bool) -> A -> A -> bool
                       g(DELETE(s, x)) == w)
                  )(SUBST1_TAC)
                ) then_list \
                PairList [
                  (
                    SUBGOAL_THEN(
                      (hol:
                         var s :: A -> bool
                         var x :: A
                         const FINITE :: (A -> bool) -> bool
                         const DELETE :: (A -> bool) -> A -> A -> bool
                         FINITE(DELETE(s, x)))
                    )(MP_TAC) then_list \
                    PairList [
                      (
                        (
                          (
                            MATCH_MP_TAC(FINITE_SUBSET) then_tac \
                            EXISTS_TAC(hol: var s :: A -> bool; s)
                          ) then_tac \
                          ASM_REWRITE_TAC(PairList [])
                        ) then_tac \
                        SET_TAC(PairList [])
                      ),
                      (
                        (
                          (
                            DISCH_THEN(ANTE_RES_THEN(o(MP_TAC)(GSYM))) then_tac \
                            DISCH_THEN((fun(th): REWRITE_TAC(PairList [th])))
                          ) then_tac \
                          EXISTS_TAC(hol: var n :: num; n)
                        ) then_tac \
                        ASM_REWRITE_TAC(PairList [])
                      )
                    ]
                  ),
                  ASM_REWRITE_TAC(PairList [])
                ]
              )
            ]
          )
        ]
      )
    ]
  )

def SET_RECURSION_LEMMA:
  prove(
    [
      (hol:
         const EMPTY :: A -> bool
         const FINITE :: (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (f :: A -> B -> B, b :: B):
           (forall (x :: A, y :: A, s :: B): x != y ==> f(x, f(y, s)) == f(y, f(x, s)))
             ==> (exists g :: (A -> bool) -> B:
                    g(EMPTY) == b
                      && (forall (x :: A, s :: A -> bool):
                            FINITE(s) ==> g(INSERT(x, s)) == (if IN(x, s) | g(s) | f(x, g(s)))))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REPEAT(GEN_TAC) then_tac \
                        DISCH_THEN(
                          o(o(MP_TAC)(SPEC(hol: var b :: B; b)))(MATCH_MP(FINREC_FUN))
                        )
                      ) then_tac \
                      DISCH_THEN(
                        X_CHOOSE_THEN(hol: var g :: (A -> bool) -> B; g)(STRIP_ASSUME_TAC)
                      )
                    ) then_tac \
                    EXISTS_TAC(hol: var g :: (A -> bool) -> B; g)
                  ) then_tac \
                  ASM_REWRITE_TAC(PairList [])
                ) then_tac \
                REPEAT(GEN_TAC)
              ) then_tac \
              COND_CASES_TAC
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          DISCH_TAC
        ) then_list \
        PairList [
          (
            (AP_TERM_TAC then_tac REWRITE_TAC(PairList [GSYM(ABSORPTION)])) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ),
          (
            SUBGOAL_THEN(
              (hol:
                 var x :: A
                 var s :: A -> bool
                 const FINITE :: (A -> bool) -> bool
                 const INSERT :: A -> (A -> bool) -> A -> bool
                 const IN :: A -> (A -> bool) -> bool
                 FINITE(INSERT(x, s)) && IN(x, INSERT(x, s)))
            )(MP_TAC) then_list \
            PairList [
              (
                REWRITE_TAC(PairList [IN_INSERT]) then_tac \
                ASM_MESON_TAC(PairList [sets_FINITE_RULES_v2])
              ),
              (
                (
                  (
                    DISCH_THEN(ANTE_RES_THEN(SUBST1_TAC)) then_tac \
                    REPEAT(AP_TERM_TAC)
                  ) then_tac \
                  UNDISCH_TAC(
                    (hol:
                       var x :: A
                       var s :: A -> bool
                       const IN :: A -> (A -> bool) -> bool
                       !IN(x, s))
                  )
                ) then_tac \
                SET_TAC(PairList [])
              )
            ]
          )
        ]
      )
    ]
  )

def ITSET:
  new_definition(
    (hol:
       var ITSET :: (A -> B -> B) -> (A -> bool) -> B -> B
       var f :: A -> B -> B
       var s :: A -> bool
       var b :: B
       const #{@} :: (A -> bool) -> A
       const EMPTY :: A -> bool
       const FINITE :: (A -> bool) -> bool
       const INSERT :: A -> (A -> bool) -> A -> bool
       const IN :: A -> (A -> bool) -> bool
       ITSET(f, s, b)
         == #{@}(
              fun (g :: (A -> bool) -> B):
                g(EMPTY) == b
                  && (forall (x :: A, s :: A -> bool):
                        FINITE(s) ==> g(INSERT(x, s)) == (if IN(x, s) | g(s) | f(x, g(s)))),
              s
            ))
  )

def FINITE_RECURSION:
  prove(
    [
      (hol:
         const ITSET :: (A -> B -> B) -> (A -> bool) -> B -> B
         const EMPTY :: A -> bool
         const FINITE :: (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (f :: A -> B -> B, b :: B):
           (forall (x :: A, y :: A, s :: B): x != y ==> f(x, f(y, s)) == f(y, f(x, s)))
             ==> (ITSET(f, EMPTY, b) == b
                    && (forall (x :: A, s :: A -> bool):
                          FINITE(s)
                            ==> (ITSET(f, INSERT(x, s), b)
                                   == (if IN(x, s) | ITSET(f, s, b) | f(x, ITSET(f, s, b))))))),
      (
        (
          (
            (
              (REPEAT(GEN_TAC) then_tac DISCH_TAC) then_tac \
              REWRITE_TAC(PairList [ITSET])
            ) then_tac \
            CONV_TAC(SELECT_CONV)
          ) then_tac \
          MATCH_MP_TAC(SET_RECURSION_LEMMA)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def FINITE_RECURSION_DELETE:
  prove(
    [
      (hol:
         const ITSET :: (A -> B -> B) -> (A -> bool) -> B -> B
         const EMPTY :: A -> bool
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const DELETE :: (A -> bool) -> A -> A -> bool
         forall (f :: A -> B -> B, b :: B):
           (forall (x :: A, y :: A, s :: B): x != y ==> f(x, f(y, s)) == f(y, f(x, s)))
             ==> (ITSET(f, EMPTY, b) == b
                    && (forall (x :: A, s :: A -> bool):
                          FINITE(s)
                            ==> (ITSET(f, s, b)
                                   == (if IN(x, s)
                                       | f(x, ITSET(f, DELETE(s, x), b))
                                       | ITSET(f, DELETE(s, x), b)))))),
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(GEN_TAC) then_tac \
                    DISCH_THEN(o(MP_TAC)(MATCH_MP(FINITE_RECURSION)))
                  ) then_tac \
                  DISCH_THEN(o(STRIP_ASSUME_TAC)(SPEC(hol: var b :: B; b)))
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              REPEAT(GEN_TAC)
            ) then_tac \
            ASM_CASES_TAC(
              (hol:
                 var x :: A
                 var s :: A -> bool
                 const IN :: A -> (A -> bool) -> bool
                 IN(x, s))
            )
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          DISCH_THEN(o(MP_TAC)(MATCH_MP(FINITE_DELETE_IMP))) then_tac \
                          DISCH_THEN(o(ANTE_RES_THEN(MP_TAC))(SPEC(hol: var x :: A; x)))
                        ) then_tac \
                        DISCH_THEN(o(MP_TAC)(SPEC(hol: var x :: A; x)))
                      ) then_tac \
                      REWRITE_TAC(PairList [IN_DELETE])
                    ) then_tac \
                    DISCH_THEN(o(SUBST1_TAC)(SYM))
                  ) then_tac \
                  AP_THM_TAC
                ) then_tac \
                AP_TERM_TAC
              ) then_tac \
              UNDISCH_TAC(
                (hol:
                   var x :: A
                   var s :: A -> bool
                   const IN :: A -> (A -> bool) -> bool
                   IN(x, s))
              )
            ) then_tac \
            SET_TAC(PairList [])
          ),
          (
            (
              ((DISCH_TAC then_tac AP_THM_TAC) then_tac AP_TERM_TAC) then_tac \
              UNDISCH_TAC(
                (hol:
                   var x :: A
                   var s :: A -> bool
                   const IN :: A -> (A -> bool) -> bool
                   !IN(x, s))
              )
            ) then_tac \
            SET_TAC(PairList [])
          )
        ]
      )
    ]
  )

def ITSET_EQ:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const ITSET :: (A -> B -> B) -> (A -> bool) -> B -> B
         forall (s :: A -> bool, f :: A -> B -> B, g :: A -> B -> B, b :: B):
           (FINITE(s)
              && ((forall x :: A: IN(x, s) ==> f(x) == g(x))
                    && ((forall (x :: A, y :: A, s :: B): x != y ==> f(x, f(y, s)) == f(y, f(x, s)))
                          && (forall (x :: A, y :: A, s :: B): x != y ==> g(x, g(y, s)) == g(y, g(x, s))))))
             ==> ITSET(f, s, b) == ITSET(g, s, b)),
      (
        (
          (
            (
              (
                (
                  (
                    ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
                    REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM])
                  ) then_tac \
                  MATCH_MP_TAC(FINITE_INDUCT_STRONG)
                ) then_tac \
                SIMP_TAC(PairList [FINITE_RECURSION, NOT_IN_EMPTY, IN_INSERT])
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            AP_TERM_TAC
          ) then_tac \
          FIRST_ASSUM(o(MATCH_MP_TAC)(REWRITE_RULE(PairList [RIGHT_IMP_FORALL_THM])))
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def CARD:
  new_definition(
    (hol:
       var CARD :: (A -> bool) -> num
       var s :: A -> bool
       const ITSET :: (A -> B -> B) -> (A -> bool) -> B -> B
       const SUC :: num -> num
       CARD(s) == ITSET(fun (x :: A, n :: num): SUC(n), s, (0 :: num)))
  )

def CARD_CLAUSES:
  prove(
    [
      (hol:
         const CARD :: (A -> bool) -> num
         const EMPTY :: A -> bool
         const FINITE :: (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         const SUC :: num -> num
         CARD((EMPTY :: A -> bool)) == (0 :: num)
           && (forall (x :: A, s :: A -> bool):
                 FINITE(s) ==> CARD(INSERT(x, s)) == (if IN(x, s) | CARD(s) | SUC(CARD(s))))),
      (
        MP_TAC(
          ISPECL(
            PairList [
              (hol:
                 const SUC :: num -> num
                 fun (x :: A, n :: num): SUC(n)),
              (hol:
                 (0 :: num))
            ])(
            FINITE_RECURSION
          )
        ) then_tac \
        REWRITE_TAC(PairList [CARD])
      )
    ]
  )

def CARD_UNION:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         const CARD :: (A -> bool) -> num
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         forall (s :: A -> bool, t :: A -> bool):
           FINITE(s) && (FINITE(t) && INTER(s, t) == EMPTY) ==> CARD(UNION(s, t)) == CARD(s) + CARD(t)),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          REWRITE_TAC(
                                            PairList [
                                              TAUT(
                                                (hol:
                                                   var a :: bool
                                                   var b :: bool
                                                   var c :: bool
                                                   var d :: bool
