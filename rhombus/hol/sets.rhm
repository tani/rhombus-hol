                ) then_tac \
                ASM_REWRITE_TAC(PairList [IMAGE_CLAUSES, INTERS_0, INTERS_1])
              ) then_tac \
              REWRITE_TAC(PairList [IMAGE_CLAUSES, INTERS_INSERT])
            ) then_tac \
            MATCH_MP_TAC(
              SET_RULE(
                (hol:
                   var f :: #{?85478} -> #{?85485}
                   var s :: #{?85478} -> bool
                   var t :: #{?85478} -> bool
                   var u :: #{?85485} -> bool
                   const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                   const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
                   IMAGE(f, INTER(s, t)) == INTER(IMAGE(f, s), IMAGE(f, t)) && IMAGE(f, t) == u
                     ==> IMAGE(f, INTER(s, t)) == INTER(IMAGE(f, s), u))
              )
            )
          ) then_tac \
