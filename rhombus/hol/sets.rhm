                  "COND",
                  Fun(Bool, Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool))))
                ),
                [
                  App(Ref("P"), [Ref("a")]),
                  App(
