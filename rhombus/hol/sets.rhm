                      (INTRO_TAC("hp") then_tac REWRITE_TAC(PairList [GSYM(REAL_NOT_LT)])) then_tac \
                      INTRO_TAC("lc")
                    ) then_tac \
                    REMOVE_THEN("approach")(
                      o(MP_TAC)(
                        SPEC(
                          (hol:
                             var l :: real
                             var c :: real
                             (l + c) / (2 :: real))
                        )
                      )
                    )
                  ) then_tac \
                  ANTS_TAC
                ) then_list \
                PairList [ASM_REAL_ARITH_TAC, INTRO_TAC("@x0. x0 +")]
              ) then_tac \
              USE_THEN("x0")(o(HYP_TAC("hp"))(C(MATCH_MP)))
            ) then_tac \
            ASM_REAL_ARITH_TAC
          ),
          (
            (
              INTRO_TAC("hp; !x; x") then_tac \
              TRANS_TAC(REAL_LE_TRANS)(hol: var l :: real; l)
            ) then_tac \
            ASM_SIMP_TAC(PairList [])
          )
        ]
      )
    ]
  )

def HAS_INF_LE:
  prove(
    [
      (hol:
         const has_inf :: (real -> bool) -> real -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (s :: real -> bool, t :: real -> bool, l :: real, m :: real):
           (has_inf(s, l)
              && (has_inf(t, m)
                    && (forall y :: real: IN(y, t) ==> (exists x :: real: IN(x, s) && x <= y))))
             ==> l <= m),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                INTRO_TAC("!s t l m; l m le") then_tac \
                                HYP_TAC("l: s l1 l2")(REWRITE_RULE(PairList [HAS_INF]))
                              ) then_tac \
                              HYP_TAC("m: t m1 m2")(REWRITE_RULE(PairList [HAS_INF]))
                            ) then_tac \
                            REFUTE_THEN(o(LABEL_TAC("lt"))(REWRITE_RULE(PairList [REAL_NOT_LE])))
                          ) then_tac \
                          CLAIM_TAC(
                            "@c. c1 c2")(
                            (hol:
                               var m :: real
                               var l :: real
                               exists c :: real: m < c && c < l)
                          )
                        ) then_list \
                        PairList [
                          (
                            EXISTS_TAC(
                              (hol:
                                 var l :: real
                                 var m :: real
                                 (l + m) / (2 :: real))
                            ) then_tac \
                            ASM_REAL_ARITH_TAC
                          ),
                          ALL_TAC
                        ]
                      ) then_tac \
                      HYP_TAC("m2: +")(SPEC(hol: var c :: real; c))
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [NOT_EXISTS_THM])
                  ) then_tac \
                  INTRO_TAC("!x; x xc")
                ) then_tac \
                CLAIM_TAC(
                  "@y. y yx")(
                  (hol:
                     var s :: real -> bool
                     var x :: real
                     const IN :: A -> (A -> bool) -> bool
                     exists y :: real: IN(y, s) && y <= x)
                )
              ) then_list \
              PairList [HYP(MESON_TAC)("le x")(PairList []), ALL_TAC]
            ) then_tac \
            HYP_TAC("l1: +")(SPEC(hol: var y :: real; y))
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_REAL_ARITH_TAC
      )
    ]
  )

def HAS_SUP_LE:
  prove(
    [
      (hol:
         const has_sup :: (real -> bool) -> real -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (s :: real -> bool, t :: real -> bool, l :: real, m :: real):
           (has_sup(s, l)
              && (has_sup(t, m)
                    && (forall y :: real: IN(y, t) ==> (exists x :: real: IN(x, s) && y <= x))))
             ==> m <= l),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                INTRO_TAC("!s t l m; l m le") then_tac \
                                HYP_TAC("l: s l1 l2")(REWRITE_RULE(PairList [HAS_SUP]))
