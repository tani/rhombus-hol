def dest_setenum:
  let fn = splitlist(Basics.dest_binary("INSERT"))
  fun(tm):
    let [l, n] = fn(tm)
    (if (Fusion.is_const(n) && Host.hol_equal(fst(Fusion.dest_const(n)))("EMPTY")) | l | failwith("dest_setenum: not a finite set enumeration"))

def is_setenum = can(dest_setenum)

def mk_setenum:
  let insert_atm_2 = Host.hol_term(Const("INSERT", Tyapp("fun", [Tyvar("A"), Tyapp("fun", [Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])]), Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])])])])))
  let nil_atm_2 = Host.hol_term(Const("EMPTY", Tyapp("fun", [Tyvar("A"), Tyapp("bool", [])])))
  fun([l, ty]):
    let insert_tm_2 = Fusion.inst(PairList.cons([ty, Fusion.aty], PairList []))(insert_atm_2)
    let nil_tm_2 = Fusion.inst(PairList.cons([ty, Fusion.aty], PairList []))(nil_atm_2)
    itlist(Basics.mk_binop(insert_tm_2))(l)(nil_tm_2)

fun mk_fset(l): mk_setenum([l, Fusion.type_of(hd(l))])

