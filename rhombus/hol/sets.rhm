def CARD_IMAGE_LT2:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         forall (f :: A -> B, g :: A -> C, s :: A -> bool):
           (FINITE(s)
              && ((forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && g(x) == g(y)) ==> f(x) == f(y))
                    && !(forall (x :: A, y :: A):
                           IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> g(x) == g(y))))
             ==> CARD(IMAGE(f, s)) < CARD(IMAGE(g, s))),
      (
        (
          (
            (
              (
                REPEAT(STRIP_TAC) then_tac \
                FIRST_X_ASSUM(
                  o(X_CHOOSE_TAC(hol: var h :: C -> B; h))(GEN_REWRITE_RULE(I)(PairList [FUNCTION_FACTORS_LEFT_GEN]))
                )
              ) then_tac \
              SUBGOAL_THEN(
                (hol:
                   var f :: A -> B
                   var s :: A -> bool
                   var h :: C -> B
                   var g :: A -> C
                   const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                   IMAGE(f, s) == IMAGE(h, IMAGE(g, s)))
              )(SUBST1_TAC)
            ) then_list \
            PairList [ASM(SET_TAC)(PairList []), ALL_TAC]
          ) then_tac \
          ASM_SIMP_TAC(PairList [LT_LE, CARD_IMAGE_LE, FINITE_IMAGE, CARD_IMAGE_EQ_INJ])
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

