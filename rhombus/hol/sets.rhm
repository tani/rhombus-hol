          ) then_tac \
          SET_TAC(PairList [])
        )
      ]
    )
  prove(
    [
      (hol:
         const EMPTY :: A -> bool
         const IN :: A -> (A -> bool) -> bool
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const DELETE :: (A -> bool) -> A -> A -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const INTERS :: ((A -> bool) -> bool) -> A -> bool
         forall (f :: A -> B, g :: (A -> bool) -> bool, s :: A -> bool, u :: A -> bool):
           (g != EMPTY
              && ((forall t :: A -> bool: IN(t, g) ==> SUBSET(t, u))
                    && (forall t :: A -> bool:
                          IN(t, DELETE(g, s))
                            ==> SUBSET(
                                  GSPEC(
                                    fun (gen_pvar_87 :: A):
                                      exists x :: A:
                                        SETSPEC(gen_pvar_87, IN(x, u) && IN(f(x), IMAGE(f, t)), x)
                                  ),
                                  t
                                ))))
             ==> IMAGE(f, INTERS(g)) == INTERS(IMAGE(IMAGE(f), g))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  REPEAT(GEN_TAC) then_tac \
                                  ASM_CASES_TAC(
                                    (hol:
                                       var s :: A -> bool
                                       var g :: (A -> bool) -> bool
                                       const IN :: A -> (A -> bool) -> bool
                                       IN(s, g))
                                  )
                                ) then_tac \
                                ASM_SIMP_TAC(
                                  PairList [
                                    SET_RULE(
                                      (hol:
                                         var s :: #{?85514}
                                         var g :: #{?85514} -> bool
                                         const IN :: A -> (A -> bool) -> bool
                                         const DELETE :: (A -> bool) -> A -> A -> bool
                                         !IN(s, g) ==> DELETE(g, s) == g)
                                    )
                                  ]
                                )
                              ) then_list \
                              PairList [ALL_TAC, MESON_TAC(PairList [lemma])]
                            ) then_tac \
                            REWRITE_TAC(PairList [CONJ_ASSOC])
                          ) then_tac \
                          DISCH_THEN(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC))
                        ) then_tac \
                        FIRST_X_ASSUM(
                          o(SUBST1_TAC)(
                            MATCH_MP(
                              SET_RULE(
                                (hol:
                                   var x :: #{?85506}
                                   var s :: #{?85506} -> bool
                                   const IN :: A -> (A -> bool) -> bool
                                   const INSERT :: A -> (A -> bool) -> A -> bool
                                   const DELETE :: (A -> bool) -> A -> A -> bool
                                   IN(x, s) ==> s == INSERT(x, DELETE(s, x)))
                              )
                            )
