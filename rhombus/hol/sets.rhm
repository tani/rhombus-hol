def CHOOSE_SUBSET_BETWEEN:
  prove(
    [
      (hol:
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const FINITE :: (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const HAS_SIZE :: (A -> bool) -> num -> bool
         forall (n :: num, s :: A -> bool, u :: A -> bool):
           SUBSET(s, u) && (FINITE(s) && (CARD(s) <= n && (FINITE(u) ==> n <= CARD(u))))
             ==> (exists t :: A -> bool: SUBSET(s, t) && (SUBSET(t, u) && HAS_SIZE(t, n)))),
      (
        (
          (
            REPEAT(STRIP_TAC) then_tac \
            MP_TAC(
              ISPECL(
                PairList [
                  (hol:
                     var n :: num
                     var s :: A -> bool
                     const CARD :: (A -> bool) -> num
                     n - CARD(s)),
                  (hol:
                     var u :: A -> bool
                     var s :: A -> bool
                     const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                     DIFF(u, s))
                ])(
                CHOOSE_SUBSET_STRONG
              )
            )
          ) then_tac \
          ANTS_TAC
        ) then_list \
        PairList [
          (
            (
              (
                ASM_CASES_TAC(
                  (hol:
                     var u :: A -> bool
                     const FINITE :: (A -> bool) -> bool
                     FINITE(u))
                ) then_tac \
                ASM_SIMP_TAC(
                  PairList [
                    CARD_DIFF,
                    ARITH_RULE(
                      (hol:
                         var n :: num
                         var m :: num
                         var x :: num
                         n <= m ==> n - x <= m - x)
                    )
                  ]
                )
              ) then_tac \
              MATCH_MP_TAC(
                TAUT(hol:
                       var p :: bool
                       var q :: bool
                       !p ==> p ==> q)
              )
            ) then_tac \
            ASM_MESON_TAC(
              PairList [
                FINITE_UNION,
                FINITE_SUBSET,
                SET_RULE(
                  (hol:
                     var u :: #{?97668} -> bool
                     var s :: #{?97668} -> bool
                     const SUBSET :: (A -> bool) -> (A -> bool) -> bool
                     const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
                     const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                     SUBSET(u, UNION(DIFF(u, s), s)))
                )
              ]
            )
          ),
          (
            (
              (
                (
                  (
                    (
                      (
                        DISCH_THEN(X_CHOOSE_THEN(hol: var t :: A -> bool; t)(STRIP_ASSUME_TAC)) then_tac \
                        EXISTS_TAC(
                          (hol:
                             var s :: A -> bool
                             var t :: A -> bool
                             const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
                             UNION(s, t))
                        )
                      ) then_tac \
                      REPEAT((CONJ_TAC then_list PairList [ASM(SET_TAC)(PairList []), ALL_TAC]))
                    ) then_tac \
                    SUBGOAL_THEN(
                      (hol:
                         var n :: num
                         var s :: A -> bool
                         const CARD :: (A -> bool) -> num
                         n == CARD(s) + (n - CARD(s)))
                    )(SUBST1_TAC)
                  ) then_list \
                  PairList [ASM_ARITH_TAC, MATCH_MP_TAC(HAS_SIZE_UNION)]
                ) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              ASM_REWRITE_TAC(PairList [HAS_SIZE])
            ) then_tac \
            ASM(SET_TAC)(PairList [])
          )
        ]
      )
    ]
  )

def CARD_LE_UNIONS_CHAIN:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const FINITE :: (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const UNIONS :: ((A -> bool) -> bool) -> A -> bool
         forall (f :: (A -> bool) -> bool, n :: num):
           ((forall (t :: A -> bool, u :: A -> bool):
               IN(t, f) && IN(u, f) ==> SUBSET(t, u) || SUBSET(u, t))
              && (forall t :: A -> bool: IN(t, f) ==> FINITE(t) && CARD(t) <= n))
             ==> FINITE(UNIONS(f)) && CARD(UNIONS(f)) <= n),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      REPEAT(GEN_TAC) then_tac \
                                      ASM_CASES_TAC(
                                        (hol:
                                           var f :: (A -> bool) -> bool
                                           const EMPTY :: A -> bool
                                           f == EMPTY)
                                      )
                                    ) then_tac \
                                    ASM_REWRITE_TAC(PairList [UNIONS_0, FINITE_EMPTY, CARD_CLAUSES, LE_0])
                                  ) then_tac \
                                  DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC))
                                ) then_tac \
                                GEN_REWRITE_TAC(I)(PairList [GSYM(CONTRAPOS_THM)])
                              ) then_tac \
