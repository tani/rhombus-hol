                  ) then_tac \
                  DISCH_TAC
                ) then_tac \
                MP_TAC(
                  ISPECL(
                    PairList [
                      (hol:
                         var s :: A -> bool
                         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
                         const PSUBSET :: (A -> bool) -> (A -> bool) -> bool
                         fun (t :: A -> bool, u :: A -> bool): SUBSET(s, t) && PSUBSET(t, u)),
                      (hol:
                         var f :: (A -> bool) -> bool
                         var s :: A -> bool
                         const GSPEC :: (A -> bool) -> A -> bool
                         const SETSPEC :: A -> bool -> A -> bool
                         const IN :: A -> (A -> bool) -> bool
                         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
                         GSPEC(
                           fun (gen_pvar_105 :: A -> bool):
                             exists t :: A -> bool: SETSPEC(gen_pvar_105, IN(t, f) && SUBSET(s, t), t)
                         ))
                    ])(
                    FINITE_TRANSITIVITY_CHAIN
                  )
                )
