def CHOICE_DEF:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Implies(
          Not(Eq(Fun(Tvar("A"), Bool), Ref("s"), Const("EMPTY", Fun(Tvar("A"), Bool)))),
          App(
            Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
            [App(Const("CHOICE", Fun(Fun(Tvar("A"), Bool), Tvar("A"))), [Ref("s")]), Ref("s")]
          )
        )
      )),
      REWRITE_TAC(PairList [CHOICE, EXTENSION, NOT_IN_EMPTY, NOT_FORALL_THM, EXISTS_THM])
    ]
  )

def SET_TAC:
  let PRESET_CONV:
    (
      (
        REWRITE_CONV(PairList [INTERS_IMAGE, INTERS_GSPEC, UNIONS_IMAGE, UNIONS_GSPEC]) then_conv \
        REWRITE_CONV(PairList [EXTENSION, SUBSET, PSUBSET, DISJOINT, SING, BIJ, INJ, SURJ])
      ) then_conv \
      REWRITE_CONV(
        PairList [
          NOT_IN_EMPTY,
          IN_UNIV,
          IN_UNION,
          IN_INTER,
          IN_DIFF,
          IN_INSERT,
          IN_DELETE,
          IN_REST,
          IN_INTERS,
          IN_UNIONS,
          IN_IMAGE,
          IN_ELIM_THM,
          IN
        ]
      )
    )
  fun(ths):
    (
      (
        (
          (
            (
              (MAP_EVERY(MP_TAC)(ths) then_tac POP_ASSUM_LIST(K(ALL_TAC))) then_tac \
              REPEAT((COND_CASES_TAC then_tac POP_ASSUM(MP_TAC)))
            ) then_tac \
            CONV_TAC(PRESET_CONV)
          ) then_tac \
          MAP_EVERY(MP_TAC)(filter((fun(th): (CONV_RULE(PRESET_CONV)(th) == TRUTH)))(ths))
        ) then_tac \
        REWRITE_TAC(PairList [IN])
      ) then_tac \
      MESON_TAC(PairList [])
    )

fun SET_RULE(tm): prove([tm, SET_TAC(PairList [])])

def NOT_EQUAL_SETS:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("A"), Bool),
          Iff(
            Not(Eq(Fun(Tvar("A"), Bool), Ref("s"), Ref("t"))),
            Exists(
              "x",
              Tvar("A"),
              Iff(
                App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("t")]),
                Not(App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]))
              )
            )
          )
        )
      )),
      SET_TAC(PairList [])
    ]
  )

