def CHOICE_DEF:
  prove(
    [
      (hol:
         const EMPTY :: A -> bool
         const IN :: A -> (A -> bool) -> bool
         const CHOICE :: (A -> bool) -> A
         forall s :: A -> bool: s != EMPTY ==> IN(CHOICE(s), s)),
      REWRITE_TAC(PairList [CHOICE, EXTENSION, NOT_IN_EMPTY, NOT_FORALL_THM, EXISTS_THM])
    ]
  )

def SET_TAC:
  let PRESET_CONV:
    (
      (
        REWRITE_CONV(PairList [INTERS_IMAGE, INTERS_GSPEC, UNIONS_IMAGE, UNIONS_GSPEC]) then_conv \
        REWRITE_CONV(PairList [EXTENSION, SUBSET, PSUBSET, DISJOINT, SING, BIJ, INJ, SURJ])
      ) then_conv \
      REWRITE_CONV(
        PairList [
          NOT_IN_EMPTY,
          IN_UNIV,
          IN_UNION,
          IN_INTER,
          IN_DIFF,
          IN_INSERT,
          IN_DELETE,
          IN_REST,
          IN_INTERS,
          IN_UNIONS,
          IN_IMAGE,
          IN_ELIM_THM,
          IN
        ]
      )
    )
  fun(ths):
    (
      (
        (
          (
            (
              (MAP_EVERY(MP_TAC)(ths) then_tac POP_ASSUM_LIST(K(ALL_TAC))) then_tac \
              REPEAT((COND_CASES_TAC then_tac POP_ASSUM(MP_TAC)))
            ) then_tac \
            CONV_TAC(PRESET_CONV)
          ) then_tac \
          MAP_EVERY(MP_TAC)(filter((fun(th): (CONV_RULE(PRESET_CONV)(th) == TRUTH)))(ths))
        ) then_tac \
        REWRITE_TAC(PairList [IN])
      ) then_tac \
      MESON_TAC(PairList [])
    )

fun SET_RULE(tm): prove([tm, SET_TAC(PairList [])])

def NOT_EQUAL_SETS:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         forall (s :: A -> bool, t :: A -> bool): s != t <=> (exists x :: A: IN(x, t) <=> !IN(x, s))),
      SET_TAC(PairList [])
    ]
  )

def INSERT_RESTRICT:
  prove(
    [
      (hol:
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         forall (P :: A -> bool, s :: A -> bool, a :: A):
           GSPEC(
             fun (gen_pvar_30 :: A):
               exists x :: A: SETSPEC(gen_pvar_30, IN(x, INSERT(a, s)) && P(x), x)
           )
             == (if P(a)
                 | INSERT(
                     a,
                     GSPEC(
                       fun (gen_pvar_31 :: A):
                         exists x :: A: SETSPEC(gen_pvar_31, IN(x, s) && P(x), x)
                     )
                   )
                 | GSPEC(
                     fun (gen_pvar_32 :: A):
                       exists x :: A: SETSPEC(gen_pvar_32, IN(x, s) && P(x), x)
                   ))),
      (
        (REPEAT(GEN_TAC) then_tac COND_CASES_TAC) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

