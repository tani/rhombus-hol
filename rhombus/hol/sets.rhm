def IMAGE_INJECTIVE_IMAGE_OF_SUBSET:
  prove(
    [
      hol_term(Forall(
        "f",
        Fun(Tvar("A"), Tvar("B")),
        Forall(
          "s",
          Fun(Tvar("A"), Bool),
          Exists(
            "t",
            Fun(Tvar("A"), Bool),
            And(
              App(
                Const("SUBSET", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Bool))),
                [Ref("t"), Ref("s")]
              ),
              And(
                Eq(
                  Fun(Tvar("B"), Bool),
                  App(
                    Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                    [Ref("f"), Ref("s")]
                  ),
                  App(
                    Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                    [Ref("f"), Ref("t")]
                  )
                ),
                Forall(
                  "x",
                  Tvar("A"),
                  Forall(
                    "y",
                    Tvar("A"),
                    Implies(
                      And(
                        App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("t")]),
                        And(
                          App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("y"), Ref("t")]),
                          Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("f"), [Ref("y")]))
                        )
                      ),
                      Eq(Tvar("A"), Ref("x"), Ref("y"))
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          SUBGOAL_THEN(
            hol_term(Exists(
              "g",
              Fun(Tvar("B"), Tvar("A")),
              Forall(
                "y",
                Tvar("B"),
                Implies(
                  App(
                    Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))),
                    [
                      Ref("y"),
                      App(
                        Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                        [Var("f", Fun(Tvar("A"), Tvar("B"))), Var("s", Fun(Tvar("A"), Bool))]
                      )
                    ]
                  ),
                  And(
                    App(
                      Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                      [App(Ref("g"), [Ref("y")]), Var("s", Fun(Tvar("A"), Bool))]
                    ),
                    Eq(Tvar("B"), App(Var("f", Fun(Tvar("A"), Tvar("B"))), [App(Ref("g"), [Ref("y")])]), Ref("y"))
                  )
                )
              )
            ))
          )(STRIP_ASSUME_TAC)
        ) then_list \
        PairList [
          (
            REWRITE_TAC(PairList [GSYM(SURJECTIVE_ON_RIGHT_INVERSE)]) then_tac \
            SET_TAC(PairList [])
          ),
          (
            EXISTS_TAC(
              hol_term(App(
                Const("IMAGE", Fun(Fun(Tvar("B"), Tvar("A")), Fun(Fun(Tvar("B"), Bool), Fun(Tvar("A"), Bool)))),
                [
                  Var("g", Fun(Tvar("B"), Tvar("A"))),
                  App(
                    Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                    [Var("f", Fun(Tvar("A"), Tvar("B"))), Var("s", Fun(Tvar("A"), Bool))]
                  )
                ]
              ))
            ) then_tac \
            ASM(SET_TAC)(PairList [])
          )
        ]
      )
    ]
  )

