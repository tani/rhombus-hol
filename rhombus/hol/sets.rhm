                        Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))),
                        [
                          Ref("x"),
                          App(
                            Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                            [Ref("f"), Ref("s")]
                          )
                        ]
                      ),
                      App(
                        Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))),
                        [
                          Ref("y"),
                          App(
                            Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                            [Ref("f"), Ref("s")]
                          )
                        ]
                      )
                    ),
                    App(Ref("P"), [Ref("x"), Ref("y")])
                  )
                )
              ),
              Forall(
                "x",
                Tvar("A"),
                Forall(
                  "y",
                  Tvar("A"),
                  Implies(
                    And(
                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("y"), Ref("s")])
                    ),
                    App(Ref("P"), [App(Ref("f"), [Ref("x")]), App(Ref("f"), [Ref("y")])])
                  )
                )
              )
            )
          )
        )
      )),
      SET_TAC(PairList [])
    ]
  )

