def UNION_OF:
  new_definition(
    (hol:
       var UNION_OF :: (((A -> bool) -> bool) -> bool) -> ((A -> bool) -> bool) -> (A -> bool) -> bool
       var P :: ((A -> bool) -> bool) -> bool
       var Q :: (A -> bool) -> bool
       const IN :: A -> (A -> bool) -> bool
       const UNIONS :: ((A -> bool) -> bool) -> A -> bool
       UNION_OF(P, Q)
         == (fun (s :: A -> bool):
               exists u :: (A -> bool) -> bool:
                 P(u) && ((forall c :: A -> bool: IN(c, u) ==> Q(c)) && UNIONS(u) == s)))
  )

def INTERSECTION_OF:
  new_definition(
    (hol:
       var INTERSECTION_OF :: (((A -> bool) -> bool) -> bool) -> ((A -> bool) -> bool) -> (A -> bool) -> bool
       var P :: ((A -> bool) -> bool) -> bool
       var Q :: (A -> bool) -> bool
       const IN :: A -> (A -> bool) -> bool
       const INTERS :: ((A -> bool) -> bool) -> A -> bool
       INTERSECTION_OF(P, Q)
         == (fun (s :: A -> bool):
               exists u :: (A -> bool) -> bool:
                 P(u) && ((forall c :: A -> bool: IN(c, u) ==> Q(c)) && INTERS(u) == s)))
  )

