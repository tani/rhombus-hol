def INTER_UNIONS:
  prove(
    [
      (hol:
         const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
         const UNIONS :: ((A -> bool) -> bool) -> A -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         (forall (s :: (A -> bool) -> bool, t :: A -> bool):
            INTER(UNIONS(s), t)
              == UNIONS(
                   GSPEC(
                     fun (gen_pvar_43 :: A -> bool):
                       exists x :: A -> bool: SETSPEC(gen_pvar_43, IN(x, s), INTER(x, t))
                   )
                 ))
           && (forall (s :: (A -> bool) -> bool, t :: A -> bool):
                 INTER(t, UNIONS(s))
                   == UNIONS(
                        GSPEC(
                          fun (gen_pvar_44 :: A -> bool):
                            exists x :: A -> bool: SETSPEC(gen_pvar_44, IN(x, s), INTER(t, x))
                        )
                      ))),
      (
        (
          ONCE_REWRITE_TAC(PairList [EXTENSION]) then_tac \
          REWRITE_TAC(PairList [IN_UNIONS, IN_ELIM_THM, IN_INTER])
        ) then_tac \
        MESON_TAC(PairList [IN_INTER])
      )
    ]
  )

