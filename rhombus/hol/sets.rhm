         forall (s :: A -> bool, t :: B -> bool, #{|s'|} :: A -> bool, #{|t'|} :: B -> bool):
           DISJOINT(CROSS(s, t), CROSS(#{|s'|}, #{|t'|}))
             <=> DISJOINT(s, #{|s'|}) || DISJOINT(t, #{|t'|})),
