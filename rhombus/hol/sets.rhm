def INF_APPROACH:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Real, Bool),
        Forall(
          "c",
          Real,
          Implies(
            And(
              Not(Eq(Fun(Real, Bool), Ref("s"), Const("EMPTY", Fun(Real, Bool)))),
              And(
                Exists(
                  "b",
                  Real,
                  Forall(
                    "x",
                    Real,
                    Implies(
                      App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Ref("s")]),
                      App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("b"), Ref("x")])
                    )
                  )
                ),
                App(
                  Const("real_lt", Fun(Real, Fun(Real, Bool))),
                  [App(Const("inf", Fun(Fun(Real, Bool), Real)), [Ref("s")]), Ref("c")]
                )
              )
            ),
            Exists(
              "x",
              Real,
              And(
                App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Ref("s")]),
                App(Const("real_lt", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("c")])
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    INTRO_TAC("!s c; npty bound lt") then_tac \
                    REFUTE_THEN(
                      o(LABEL_TAC("hp"))(REWRITE_RULE(PairList [NOT_EXISTS_THM, DE_MORGAN_THM, REAL_NOT_LT]))
                    )
                  ) then_tac \
                  REMOVE_THEN("lt")(MP_TAC)
                ) then_tac \
                REWRITE_TAC(PairList [REAL_NOT_LT])
              ) then_tac \
              HYP(o(o(MP_TAC)(MATCH_MP(INF)))(end_itlist(CONJ)))("npty bound")(PairList [])
            ) then_tac \
            INTRO_TAC("_ inf")
          ) then_tac \
          REMOVE_THEN("inf")(MATCH_MP_TAC)
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

