def le_c:
  new_definition(
    (hol:
       var #{<=_c} :: (A -> bool) -> (B -> bool) -> bool
       var s :: A -> bool
       var t :: B -> bool
       const IN :: A -> (A -> bool) -> bool
       #{<=_c}(s, t)
         <=> (exists f :: A -> B:
                (forall x :: A: IN(x, s) ==> IN(f(x), t))
                  && (forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> x == y)))
  )

def lt_c:
  new_definition(
    (hol:
       var #{<_c} :: (A -> bool) -> (B -> bool) -> bool
       var s :: A -> bool
       var t :: B -> bool
       const #{<=_c} :: (A -> bool) -> (B -> bool) -> bool
       #{<_c}(s, t) <=> #{<=_c}(s, t) && !#{<=_c}(t, s))
  )

def eq_c:
  new_definition(
    (hol:
       var #{=_c} :: (A -> bool) -> (B -> bool) -> bool
       var s :: A -> bool
       var t :: B -> bool
       const IN :: A -> (A -> bool) -> bool
       #{=_c}(s, t)
         <=> (exists f :: A -> B:
                (forall x :: A: IN(x, s) ==> IN(f(x), t))
                  && (forall y :: B: IN(y, t) ==> (exists1 x :: A: IN(x, s) && f(x) == y))))
  )

def ge_c:
  new_definition(
    (hol:
       var #{>=_c} :: (A -> bool) -> (B -> bool) -> bool
       var s :: A -> bool
       var t :: B -> bool
       const #{<=_c} :: (A -> bool) -> (B -> bool) -> bool
       #{>=_c}(s, t) <=> #{<=_c}(t, s))
  )

def gt_c:
  new_definition(
    (hol:
       var #{>_c} :: (A -> bool) -> (B -> bool) -> bool
       var s :: A -> bool
       var t :: B -> bool
       const #{<_c} :: (A -> bool) -> (B -> bool) -> bool
       #{>_c}(s, t) <=> #{<_c}(t, s))
  )

def LE_C:
  prove(
    [
      (hol:
         const #{<=_c} :: (A -> bool) -> (B -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (s :: B -> bool, t :: A -> bool):
           #{<=_c}(s, t)
             <=> (exists g :: A -> B:
                    forall x :: B: IN(x, s) ==> (exists y :: A: IN(y, t) && g(y) == x))),
      (
        REWRITE_TAC(
          PairList [
            le_c,
            INJECTIVE_ON_LEFT_INVERSE,
            SURJECTIVE_ON_RIGHT_INVERSE,
            RIGHT_IMP_EXISTS_THM,
            SKOLEM_THM,
            RIGHT_AND_EXISTS_THM
          ]
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def GE_C:
  prove(
    [
      (hol:
         const #{>=_c} :: (A -> bool) -> (B -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (s :: A -> bool, t :: B -> bool):
           #{>=_c}(s, t)
             <=> (exists f :: A -> B:
                    forall y :: B: IN(y, t) ==> (exists x :: A: IN(x, s) && y == f(x)))),
      (REWRITE_TAC(PairList [ge_c, LE_C]) then_tac MESON_TAC(PairList []))
    ]
  )

def COUNTABLE:
  new_definition(
    (hol:
       var COUNTABLE :: (A -> bool) -> bool
       var t :: A -> bool
       const #{>=_c} :: (A -> bool) -> (B -> bool) -> bool
       const UNIV :: A -> bool
       COUNTABLE(t) <=> #{>=_c}((UNIV :: num -> bool), t))
  )

def sup:
  new_definition(
    (hol:
       var sup :: (real -> bool) -> real
       var s :: real -> bool
       const #{@} :: (A -> bool) -> A
       const IN :: A -> (A -> bool) -> bool
       sup(s)
         == #{@}(
              fun (a :: real):
                (forall x :: real: IN(x, s) ==> x <= a)
                  && (forall b :: real: (forall x :: real: IN(x, s) ==> x <= b) ==> a <= b)
            ))
  )

def SUP_EQ:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const sup :: (real -> bool) -> real
         forall (s :: real -> bool, t :: real -> bool):
           (forall b :: real:
              (forall x :: real: IN(x, s) ==> x <= b) <=> (forall x :: real: IN(x, t) ==> x <= b))
             ==> sup(s) == sup(t)),
      SIMP_TAC(PairList [sup])
    ]
  )

def SUP:
  prove(
    [
      (hol:
         const EMPTY :: A -> bool
         const IN :: A -> (A -> bool) -> bool
         const sup :: (real -> bool) -> real
         forall s :: real -> bool:
           s != EMPTY && (exists b :: real: forall x :: real: IN(x, s) ==> x <= b)
             ==> ((forall x :: real: IN(x, s) ==> x <= sup(s))
                    && (forall b :: real: (forall x :: real: IN(x, s) ==> x <= b) ==> sup(s) <= b))),
      (
        (
          (
            (
              REWRITE_TAC(PairList [sup]) then_tac \
              CONV_TAC(ONCE_DEPTH_CONV(SELECT_CONV))
            ) then_tac \
            REPEAT(STRIP_TAC)
          ) then_tac \
          MATCH_MP_TAC(REAL_COMPLETE)
        ) then_tac \
        ASM_MESON_TAC(PairList [MEMBER_NOT_EMPTY])
      )
    ]
  )

