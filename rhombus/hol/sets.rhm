def FINITE_INDUCT_DELETE:
  prove(
    [
      (hol:
         const EMPTY :: A -> bool
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const DELETE :: (A -> bool) -> A -> A -> bool
         forall P :: (A -> bool) -> bool:
           (P(EMPTY)
              && (forall s :: A -> bool:
                    FINITE(s) && s != EMPTY ==> (exists x :: A: IN(x, s) && (P(DELETE(s, x)) ==> P(s)))))
             ==> (forall s :: A -> bool: FINITE(s) ==> P(s))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          ((GEN_TAC then_tac STRIP_TAC) then_tac GEN_TAC) then_tac \
                          WF_INDUCT_TAC(
                            (hol:
                               var s :: A -> bool
                               const CARD :: (A -> bool) -> num
                               CARD(s))
                          )
                        ) then_tac \
                        ASM_CASES_TAC(
                          (hol:
                             var s :: A -> bool
                             const EMPTY :: A -> bool
                             s == EMPTY)
                        )
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_tac \
                    DISCH_TAC
                  ) then_tac \
                  UNDISCH_TAC(
                    (hol:
                       var P :: (A -> bool) -> bool
                       const FINITE :: (A -> bool) -> bool
                       const EMPTY :: A -> bool
                       const IN :: A -> (A -> bool) -> bool
                       const DELETE :: (A -> bool) -> A -> A -> bool
                       forall s :: A -> bool:
                         FINITE(s) && s != EMPTY ==> (exists x :: A: IN(x, s) && (P(DELETE(s, x)) ==> P(s))))
                  )
                ) then_tac \
                DISCH_THEN(o(MP_TAC)(SPEC(hol: var s :: A -> bool; s)))
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            DISCH_THEN(
              X_CHOOSE_THEN(hol: var x :: A; x)(CONJUNCTS_THEN2(ASSUME_TAC)(MATCH_MP_TAC))
            )
          ) then_tac \
          FIRST_X_ASSUM(
            o(MP_TAC)(
              SPEC(
                (hol:
                   var s :: A -> bool
                   var x :: A
                   const DELETE :: (A -> bool) -> A -> A -> bool
                   DELETE(s, x))
              )
            )
          )
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            FINITE_DELETE,
            CARD_DELETE,
            CARD_EQ_0,
            ARITH_RULE(
              (hol:
                 var n :: num
