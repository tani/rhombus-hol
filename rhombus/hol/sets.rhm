         forall (r :: A -> A -> bool, x :: A, s :: A -> bool):
           (forall y :: A: IN(y, s) ==> (r(x, y) <=> r(y, x)))
             ==> (pairwise(r, INSERT(x, s))
                    <=> (forall y :: A: IN(y, s) && y != x ==> r(x, y)) && pairwise(r, s))),
