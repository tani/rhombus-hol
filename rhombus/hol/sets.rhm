    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const pairwise :: (A -> A -> bool) -> (A -> bool) -> bool
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const UNIONS :: ((A -> bool) -> bool) -> A -> bool
         forall (R :: A -> A -> bool, c :: (A -> bool) -> bool):
           ((forall s :: A -> bool: IN(s, c) ==> pairwise(R, s))
              && (forall (s :: A -> bool, t :: A -> bool):
                    IN(s, c) && IN(t, c) ==> SUBSET(s, t) || SUBSET(t, s)))
             ==> pairwise(R, UNIONS(c))),
      (REWRITE_TAC(PairList [pairwise]) then_tac SET_TAC(PairList []))
    ]
  )

