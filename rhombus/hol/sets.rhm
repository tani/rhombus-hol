           (pairwise(P, s)
              && (forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && (P(x, y) && x != y)) ==> Q(x, y)))
             ==> pairwise(Q, s)),
      (REWRITE_TAC(PairList [pairwise]) then_tac SET_TAC(PairList []))
    ]
  )

