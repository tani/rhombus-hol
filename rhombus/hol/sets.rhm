                                exists a :: D:
                                  SETSPEC(
                                    gen_pvar_23,
                                    exists (x :: A, y :: B, z :: C): P(x, y, z) && IN(a, f(x, y, z)),
                                    a
                                  )
                            )))),
      (
        (
          (REPEAT(STRIP_TAC) then_tac GEN_REWRITE_TAC(I)(PairList [EXTENSION])) then_tac \
          REWRITE_TAC(PairList [IN_UNIONS, IN_ELIM_THM])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

