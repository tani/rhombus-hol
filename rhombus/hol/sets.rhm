    ]
  )

def INSERT_UNION:
  prove(
    [
      @hol|{!x:A. !s t. (x INSERT s) UNION t =
         if x IN t then s UNION t else x INSERT (s UNION t)}|,
      REPEAT(GEN_TAC) then_tac COND_CASES_TAC then_tac \
      POP_ASSUM(MP_TAC) then_tac \
      SET_TAC(PairList [])
    ]
  )

def INSERT_UNION_EQ:
  prove(
    [
      @hol|{!x:A. !s t. (x INSERT s) UNION t = x INSERT (s UNION t)}|,
      SET_TAC(PairList [])
    ]
  )

def INSERT_INTER:
  prove(
    [
      @hol|{!x:A. !s t. (x INSERT s) INTER t =
         if x IN t then x INSERT (s INTER t) else s INTER t}|,
      REPEAT(GEN_TAC) then_tac COND_CASES_TAC then_tac \
      POP_ASSUM(MP_TAC) then_tac \
      SET_TAC(PairList [])
    ]
