               const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
               exists g :: B -> A: forall y :: B: IN(y, IMAGE(f, s)) ==> IN(g(y), s) && f(g(y)) == y)
          )(STRIP_ASSUME_TAC)
        ) then_list \
        PairList [
