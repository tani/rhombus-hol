                    (hol:
                       var t :: #{?96268} -> bool
                       var s :: #{?96268} -> bool
                       const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
                       const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
