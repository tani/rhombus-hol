def FINREC:
  new_recursive_definition(num_RECURSION)(
    (hol:
       var FINREC :: (A -> B -> B) -> B -> (A -> bool) -> B -> num -> bool
       var f :: A -> B -> B
       var b :: B
       var s :: A -> bool
       var a :: B
       var n :: num
       const EMPTY :: A -> bool
       const SUC :: num -> num
       const IN :: A -> (A -> bool) -> bool
       const DELETE :: (A -> bool) -> A -> A -> bool
       (FINREC(f, b, s, a, (0 :: num)) <=> s == EMPTY && a == b)
         && (FINREC(f, b, s, a, SUC(n))
               <=> (exists (x :: A, c :: B):
                      IN(x, s) && (FINREC(f, b, DELETE(s, x), c, n) && a == f(x, c)))))
  )

