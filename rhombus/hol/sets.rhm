def num_FINITE:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Num, Bool),
        Iff(
          App(Const("FINITE", Fun(Fun(Num, Bool), Bool)), [Ref("s")]),
          Exists(
            "a",
            Num,
            Forall(
              "x",
              Num,
              Implies(
                App(Const("IN", Fun(Num, Fun(Fun(Num, Bool), Bool))), [Ref("x"), Ref("s")]),
                App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("x"), Ref("a")])
              )
            )
          )
        )
      )),
      (
        (GEN_TAC then_tac EQ_TAC) then_list \
        PairList [
          (
            (
              (
                SPEC_TAC([hol_term(Var("s", Fun(Num, Bool))), hol_term(Var("s", Fun(Num, Bool)))]) then_tac \
                MATCH_MP_TAC(FINITE_INDUCT_STRONG)
              ) then_tac \
              REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY])
            ) then_tac \
            MESON_TAC(PairList [LE_CASES, LE_TRANS])
          ),
          (
            (
              (
                (
                  DISCH_THEN(X_CHOOSE_TAC(hol_term(Var("n", Num)))) then_tac \
                  MATCH_MP_TAC(FINITE_SUBSET)
                ) then_tac \
                EXISTS_TAC(
                  hol_term(App(
                    Const("GSPEC", Fun(Fun(Num, Bool), Fun(Num, Bool))),
                    [
                      Lambda(
                        "GEN%PVAR%193",
                        Num,
                        Exists(
                          "m",
                          Num,
                          App(
                            Const("SETSPEC", Fun(Num, Fun(Bool, Fun(Num, Bool)))),
                            [
                              Ref("GEN%PVAR%193"),
                              App(Const("<=", Fun(Num, Fun(Num, Bool))), [Ref("m"), Var("n", Num)]),
                              Ref("m")
                            ]
                          )
                        )
                      )
                    ]
                  ))
                )
              ) then_tac \
              REWRITE_TAC(PairList [FINITE_NUMSEG_LE])
            ) then_tac \
            ASM_SIMP_TAC(PairList [SUBSET, IN_ELIM_THM])
          )
        ]
      )
    ]
  )

