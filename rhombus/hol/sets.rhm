    ]
  )

def CARD_EQ_BIJECTION:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const IN :: A -> (A -> bool) -> bool
         forall (s :: A -> bool, t :: B -> bool):
           FINITE(s) && (FINITE(t) && CARD(s) == CARD(t))
             ==> (exists f :: A -> B:
                    (forall x :: A: IN(x, s) ==> IN(f(x), t))
                      && ((forall y :: B: IN(y, t) ==> (exists x :: A: IN(x, s) && f(x) == y))
                            && (forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> x == y)))),
      (
        (
          (
            (
              (
                (
                  MP_TAC(CARD_LE_INJ) then_tac \
                  REPEAT((MATCH_MP_TAC(MONO_FORALL) then_tac GEN_TAC))
                ) then_tac \
                DISCH_THEN((fun(th): (STRIP_TAC then_tac MP_TAC(th))))
              ) then_tac \
              ASM_REWRITE_TAC(PairList [LE_REFL])
            ) then_tac \
            MATCH_MP_TAC(MONO_EXISTS)
          ) then_tac \
          ASM_SIMP_TAC(PairList [SURJECTIVE_IFF_INJECTIVE_GEN])
        ) then_tac \
        MESON_TAC(PairList [SUBSET, IN_IMAGE])
      )
    ]
  )

def CARD_EQ_BIJECTIONS:
