         (forall (s :: A -> bool, t :: B -> bool, u :: B -> bool):
            CROSS(s, UNION(t, u)) == UNION(CROSS(s, t), CROSS(s, u)))
           && (forall (s :: A -> bool, t :: A -> bool, u :: B -> bool):
