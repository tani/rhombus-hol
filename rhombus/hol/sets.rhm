def EMPTY_UNIONS:
  prove(
    [
      @hol|{!s. (UNIONS s = {}) <=> !t:A->bool. t IN s ==> t = {}}|,
      SET_TAC(PairList [])
    ]
  )

def INTER_UNIONS:
  prove(
    [
      @hol|{(!s (t:A->bool). UNIONS s INTER t = UNIONS {x INTER t | x IN s}) /\
         (!s (t:A->bool). t INTER UNIONS s = UNIONS {t INTER x | x IN s})}|,
      ONCE_REWRITE_TAC(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [IN_UNIONS, IN_ELIM_THM, IN_INTER]) then_tac \
      MESON_TAC(PairList [IN_INTER])
    ]
  )

def UNIONS_SUBSET:
  prove(
    [
      @hol|{!f (t:A->bool). UNIONS f SUBSET t <=> !s. s IN f ==> s SUBSET t}|,
      SET_TAC(PairList [])
    ]
  )

def SUBSET_UNIONS:
  prove(
    [
      @hol|{!(f:(A->bool)->bool) g. f SUBSET g ==> UNIONS f SUBSET UNIONS g}|,
      SET_TAC(PairList [])
    ]
  )

def UNIONS_UNION:
  prove(
    [
      @hol|{!s t:(A->bool)->bool. UNIONS(s UNION t) = (UNIONS s) UNION (UNIONS t)}|,
      SET_TAC(PairList [])
    ]
  )

def INTERS_UNION:
  prove(
    [
      @hol|{!s t:(A->bool)->bool. INTERS (s UNION t) = INTERS s INTER INTERS t}|,
      SET_TAC(PairList [])
    ]
  )

def UNIONS_MONO:
  prove(
    [
      @hol|{!s t:(A->bool)->bool.
         (!x. x IN s ==> ?y. y IN t /\ x SUBSET y) ==> UNIONS s SUBSET UNIONS t}|,
      SET_TAC(PairList [])
    ]
  )

def UNIONS_MONO_IMAGE:
  prove(
    [
      @hol|{!(f:A->B->bool) g s.
         (!x. x IN s ==> f x SUBSET g x)
         ==> UNIONS(IMAGE f s) SUBSET UNIONS(IMAGE g s)}|,
      SET_TAC(PairList [])
    ]
  )

def UNIONS_UNIV:
  prove(
    [
      @hol|{UNIONS (:A->bool) = (:A)}|,
      REWRITE_TAC(PairList [EXTENSION, IN_UNIONS, IN_UNIV]) then_tac \
      MESON_TAC(PairList [IN_SING])
    ]
  )

def UNIONS_INSERT_EMPTY:
  prove(
    [
      @hol|{!s:(A->bool)->bool. UNIONS({} INSERT s) = UNIONS s}|,
      ONCE_REWRITE_TAC(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [IN_UNIONS, IN_INSERT]) then_tac \
      MESON_TAC(PairList [NOT_IN_EMPTY])
    ]
  )

def UNIONS_DELETE_EMPTY:
  prove(
    [
      @hol|{!s:(A->bool)->bool. UNIONS(s DELETE {}) = UNIONS s}|,
      ONCE_REWRITE_TAC(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [IN_UNIONS, IN_DELETE]) then_tac \
      MESON_TAC(PairList [NOT_IN_EMPTY])
    ]
  )

def INTERS_0:
  prove(
    [
      @hol|{INTERS {} = (:A)}|,
      SET_TAC(PairList [])
    ]
  )

def INTERS_1:
  prove(
    [
      @hol|{!s:A->bool. INTERS {s} = s}|,
      SET_TAC(PairList [])
    ]
  )

def INTERS_2:
  prove(
    [
      @hol|{!s (t:A->bool). INTERS {s,t} = s INTER t}|,
      SET_TAC(PairList [])
    ]
  )

def INTERS_INSERT:
  prove(
    [
      @hol|{!(s:A->bool) u. INTERS (s INSERT u) = s INTER (INTERS u)}|,
      SET_TAC(PairList [])
    ]
  )

def SUBSET_INTERS:
  prove(
    [
      @hol|{!(s:A->bool) f. s SUBSET INTERS f <=> (!t. t IN f ==> s SUBSET t)}|,
      SET_TAC(PairList [])
    ]
  )

def INTERS_SUBSET:
  prove(
    [
      @hol|{!u s:A->bool.
         ~(u = {}) /\ (!t. t IN u ==> t SUBSET s) ==> INTERS u SUBSET s}|,
      SET_TAC(PairList [])
    ]
  )

def INTERS_SUBSET_STRONG:
  prove(
    [
      @hol|{!u s:A->bool. (?t. t IN u /\ t SUBSET s) ==> INTERS u SUBSET s}|,
      SET_TAC(PairList [])
    ]
  )

def INTERS_ANTIMONO:
  prove(
    [
      @hol|{!(f:(A->bool)->bool) g. g SUBSET f ==> INTERS f SUBSET INTERS g}|,
      SET_TAC(PairList [])
    ]
  )

def INTERS_EQ_UNIV:
  prove(
    [
      @hol|{!f. INTERS f = (:A) <=> !s. s IN f ==> s = (:A)}|,
      SET_TAC(PairList [])
    ]
  )

def INTERS_ANTIMONO_GEN:
  prove(
    [
      @hol|{!s (t:(A->bool)->bool).
         (!y. y IN t ==> ?x. x IN s /\ x SUBSET y)
         ==> INTERS s SUBSET INTERS t}|,
      SET_TAC(PairList [])
    ]
  )

def IMAGE_CLAUSES:
  prove(
    [
      @hol|{(IMAGE (f:A->B) {} = {}) /\
         (IMAGE f (x INSERT s) = (f x) INSERT (IMAGE f s))}|,
      REWRITE_TAC(PairList [IMAGE, IN_ELIM_THM, NOT_IN_EMPTY, IN_INSERT, EXTENSION]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def IMAGE_UNION:
  prove(
    [
      @hol|{!(f:A->B) s t. IMAGE f (s UNION t) = (IMAGE f s) UNION (IMAGE f t)}|,
      REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, IN_UNION]) then_tac MESON_TAC(PairList [])
    ]
  )

def IMAGE_ID:
  prove(
    [
      @hol|{!s:A->bool. IMAGE (\x. x) s = s}|,
      REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, UNWIND_THM1])
    ]
  )

def IMAGE_I:
  prove(
    [
      @hol|{!s:A->bool. IMAGE I s = s}|,
      REWRITE_TAC(PairList [I_DEF, IMAGE_ID])
    ]
  )

def IMAGE_o:
  prove(
    [
      @hol|{!(f:B->C) (g:A->B) s. IMAGE (f o g) s = IMAGE f (IMAGE g s)}|,
      REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, o_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def IMAGE_SUBSET:
  prove(
    [
      @hol|{!(f:A->B) s t. s SUBSET t ==> (IMAGE f s) SUBSET (IMAGE f t)}|,
      REWRITE_TAC(PairList [SUBSET, IN_IMAGE]) then_tac MESON_TAC(PairList [])
    ]
  )

def IMAGE_INTER_INJ:
  prove(
    [
      @hol|{!(f:A->B) s t.
         (!x y. f(x) = f(y) ==> x = y)
         ==> (IMAGE f (s INTER t) = (IMAGE f s) INTER (IMAGE f t))}|,
      REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, IN_INTER]) then_tac MESON_TAC(PairList [])
    ]
  )

def IMAGE_DIFF_INJ:
  prove(
    [
      @hol|{!f:A->B s t.
         (!x y. x IN s /\ y IN t /\ f x = f y ==> x = y)
         ==> IMAGE f (s DIFF t) = IMAGE f s DIFF IMAGE f t}|,
      SET_TAC(PairList [])
    ]
  )

def IMAGE_DIFF_INJ_ALT:
  prove(
    [
      @hol|{!f:A->B s t.
         (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\ t SUBSET s
         ==> IMAGE f (s DIFF t) = IMAGE f s DIFF IMAGE f t}|,
      SET_TAC(PairList [])
    ]
  )

def IMAGE_DELETE_INJ:
  prove(
    [
      @hol|{!f:A->B s a.
         (!x. x IN s /\ f x = f a ==> x = a)
         ==> IMAGE f (s DELETE a) = IMAGE f s DELETE f a}|,
      SET_TAC(PairList [])
    ]
  )

def IMAGE_DELETE_INJ_ALT:
  prove(
    [
      @hol|{!f:A->B s a.
         (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\ a IN s
         ==> IMAGE f (s DELETE a) = IMAGE f s DELETE f a}|,
      SET_TAC(PairList [])
    ]
  )

def IMAGE_EQ_EMPTY:
  prove(
    [
      @hol|{!(f:A->B) s. (IMAGE f s = {}) <=> (s = {})}|,
      REWRITE_TAC(PairList [EXTENSION, NOT_IN_EMPTY, IN_IMAGE]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def FORALL_IN_IMAGE_2:
  prove(
    [
      @hol|{!(f:A->B) P s. (!x y. x IN IMAGE f s /\ y IN IMAGE f s ==> P x y) <=>
         (!x y. x IN s /\ y IN s ==> P (f x) (f y))}|,
      SET_TAC(PairList [])
    ]
  )

def IMAGE_CONST:
  prove(
    [
      @hol|{!(s:A->bool) (c:B). IMAGE (\x. c) s = if s = {} then {} else {c}}|,
      REPEAT(GEN_TAC) then_tac COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [IMAGE_CLAUSES]) then_tac \
      REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, IN_SING]) then_tac \
      ASM_MESON_TAC(PairList [MEMBER_NOT_EMPTY])
    ]
  )

def SIMPLE_IMAGE:
  prove(
    [
      @hol|{!(f:A->B) s. {f x | x IN s} = IMAGE f s}|,
      REWRITE_TAC(PairList [EXTENSION, IN_ELIM_THM, IN_IMAGE]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def SIMPLE_IMAGE_GEN:
  prove(
    [
      @hol|{!(f:A->B) P. {f x | P x} = IMAGE f {x | P x}}|,
      SET_TAC(PairList [])
    ]
  )

def IMAGE_UNIONS:
  prove(
    [
      @hol|{!(f:A->B) s. IMAGE f (UNIONS s) = UNIONS (IMAGE (IMAGE f) s)}|,
      ONCE_REWRITE_TAC(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [IN_UNIONS, IN_IMAGE]) then_tac \
      REWRITE_TAC(PairList [LEFT_AND_EXISTS_THM]) then_tac \
      ONCE_REWRITE_TAC(PairList [SWAP_EXISTS_THM]) then_tac \
      REWRITE_TAC(PairList [GSYM(CONJ_ASSOC), UNWIND_THM2, IN_IMAGE]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def FUN_IN_IMAGE:
  prove(
    [
      @hol|{!(f:A->B) s x. x IN s ==> f(x) IN IMAGE f s}|,
      SET_TAC(PairList [])
    ]
  )

def SURJECTIVE_IMAGE_EQ:
  prove(
    [
      @hol|{!(f:A->B) s t.
         (!y. y IN t ==> ?x. f x = y) /\ (!x. (f x) IN t <=> x IN s)
         ==> IMAGE f s = t}|,
      SET_TAC(PairList [])
    ]
  )

def IMAGE_EQ:
  prove(
    [
      @hol|{!(f:A->B) g s. (!x. x IN s ==> f x = g x) ==> IMAGE f s = IMAGE g s}|,
      SET_TAC(PairList [])
    ]
  )

def EMPTY_GSPEC:
  prove(
    [
      @hol|{{x:A | F} = {}}|,
      SET_TAC(PairList [])
    ]
  )

def UNIV_GSPEC:
  prove(
    [
      @hol|{{x | T} = (:A)}|,
      SET_TAC(PairList [])
    ]
  )

def SING_GSPEC:
  prove(
    [
      @hol|{(!a:A. {x | x = a} = {a}) /\
         (!a:A. {x | a = x} = {a})}|,
      SET_TAC(PairList [])
    ]
  )

def SING_ALT:
  prove(
    [
      @hol|{!s:A->bool. (?x. s = {x}) <=> ?!x. x IN s}|,
      SET_TAC(PairList [])
    ]
  )

def IN_GSPEC:
  prove(
    [
      @hol|{!s:A->bool. {x | x IN s} = s}|,
      SET_TAC(PairList [])
    ]
  )

def IN_ELIM_PAIR_THM:
  prove(
    [
      @hol|{!(P:A->B->bool) a b. (a,b) IN {(x,y) | P x y} <=> P a b}|,
      REWRITE_TAC(PairList [IN_ELIM_THM]) then_tac MESON_TAC(PairList [PAIR_EQ])
    ]
  )

def IN_ELIM_TRIPLE_THM:
  prove(
    [
      @hol|{(!(P:A->B->C->bool) a b c. (a,b,c) IN {(x,y,z) | P x y z} <=> P a b c) /\
         (!(P:A->B->C->bool) a b c. ((a,b),c) IN {((x,y),z) | P x y z} <=> P a b c)}|,
      REWRITE_TAC(PairList [IN_ELIM_THM, PAIR_EQ]) then_tac MESON_TAC(PairList [])
    ]
  )

def IN_ELIM_QUAD_THM:
  prove(
    [
      @hol|{(!(P:A->B->C->D->bool) a b c d.
              (a,b,c,d) IN {w,x,y,z | P w x y z} <=> P a b c d) /\
         (!(P:A->B->C->D->bool) a b c d.
              ((a,b),(c,d)) IN {(w,x),(y,z) | P w x y z} <=> P a b c d) /\
         (!(P:A->B->C->D->bool) a b c d.
              (((a,b),c),d) IN {(((w,x),y),z) | P w x y z} <=> P a b c d)}|,
      REWRITE_TAC(PairList [IN_ELIM_THM, PAIR_EQ]) then_tac MESON_TAC(PairList [])
    ]
  )

def SET_PAIR_THM:
  prove(
    [
      @hol|{!(P:A#B->bool). {p | P p} = {(a,b) | P(a,b)}}|,
      REWRITE_TAC(PairList [EXTENSION, FORALL_PAIR_THM, IN_ELIM_THM, IN_ELIM_PAIR_THM])
    ]
  )

def SET_PROVE_CASES:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         P {} /\ (!a s. ~(a IN s) ==> P(a INSERT s))
         ==> !s. P s}|,
      MESON_TAC(PairList [SET_CASES])
    ]
  )

def UNIONS_SINGS_GEN:
  prove(
    [
      @hol|{!P:A->bool. UNIONS {{x} | P x} = {x | P x}}|,
      REWRITE_TAC(PairList [UNIONS_GSPEC]) then_tac SET_TAC(PairList [])
    ]
  )

def UNIONS_SINGS:
  prove(
    [
      @hol|{!s:A->bool. UNIONS {{x} | x IN s} = s}|,
      REWRITE_TAC(PairList [UNIONS_GSPEC]) then_tac SET_TAC(PairList [])
    ]
  )

def IMAGE_INTERS:
  prove(
    [
      @hol|{!(f:A->B) s.
         ~(s = {}) /\
         (!x y. x IN UNIONS s /\ y IN UNIONS s /\ f x = f y ==> x = y)
         ==> IMAGE f (INTERS s) = INTERS(IMAGE (IMAGE f) s)}|,
      REWRITE_TAC(PairList [INTERS_IMAGE]) then_tac SET_TAC(PairList [])
    ]
  )

def DIFF_INTERS:
  prove(
    [
      @hol|{!(u:A->bool) s. u DIFF INTERS s = UNIONS {u DIFF t | t IN s}}|,
      REWRITE_TAC(PairList [UNIONS_GSPEC]) then_tac SET_TAC(PairList [])
    ]
  )

def INTERS_UNIONS:
  prove(
    [
      @hol|{!s. INTERS s = UNIV DIFF (UNIONS {(:A) DIFF t | t IN s})}|,
      REWRITE_TAC(PairList [GSYM(DIFF_INTERS)]) then_tac SET_TAC(PairList [])
    ]
  )

def UNIONS_INTERS:
  prove(
    [
      @hol|{!s. UNIONS s = UNIV DIFF (INTERS {(:A) DIFF t | t IN s})}|,
      GEN_TAC then_tac GEN_REWRITE_TAC(I)(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [IN_UNIONS, IN_UNIV, IN_DIFF, INTERS_GSPEC, IN_ELIM_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def UNIONS_DIFF:
  prove(
    [
      @hol|{!s t:A->bool. UNIONS s DIFF t = UNIONS {x DIFF t | x IN s}}|,
      REWRITE_TAC(PairList [UNIONS_GSPEC]) then_tac SET_TAC(PairList [])
    ]
  )

def DIFF_UNIONS:
  prove(
    [
      @hol|{!(u:A->bool) s. u DIFF UNIONS s = u INTER INTERS {u DIFF t | t IN s}}|,
      REWRITE_TAC(PairList [INTERS_GSPEC]) then_tac SET_TAC(PairList [])
    ]
  )

def DIFF_UNIONS_NONEMPTY:
  prove(
    [
      @hol|{!(u:A->bool) s. ~(s = {}) ==> u DIFF UNIONS s = INTERS {u DIFF t | t IN s}}|,
      REWRITE_TAC(PairList [INTERS_GSPEC]) then_tac SET_TAC(PairList [])
    ]
  )

def INTERS_OVER_UNIONS:
  prove(
    [
      @hol|{!f:A->(B->bool)->bool s.
         INTERS { UNIONS(f x) | x IN s} =
         UNIONS { INTERS {g x | x IN s} |g| !x. x IN s ==> g x IN f x}}|,
      REPEAT(GEN_TAC) then_tac GEN_REWRITE_TAC(I)(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [SIMPLE_IMAGE, INTERS_IMAGE, UNIONS_IMAGE, UNIONS_GSPEC]) then_tac \
      REWRITE_TAC(PairList [IN_UNIONS, IN_ELIM_THM]) then_tac \
      X_GEN_TAC(@hol|{b:B}|) then_tac \
      REWRITE_TAC(PairList [RIGHT_IMP_EXISTS_THM, SKOLEM_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def INTER_INTERS:
  prove(
    [
      @hol|{(!f s:A->bool.
              s INTER INTERS f =
              if f = {} then s else INTERS {s INTER t | t IN f}) /\
         (!f s:A->bool.
              INTERS f INTER s =
              if f = {} then s else INTERS {t INTER s | t IN f})}|,
      REPEAT(STRIP_TAC) then_tac COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [INTERS_0, INTER_UNIV, INTERS_GSPEC]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def UNIONS_OVER_INTERS:
  prove(
    [
      @hol|{!f:A->(B->bool)->bool s.
         UNIONS { INTERS(f x) | x IN s} =
         INTERS { UNIONS {g x | x IN s} |g| !x. x IN s ==> g x IN f x}}|,
      REPEAT(GEN_TAC) then_tac GEN_REWRITE_TAC(I)(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [SIMPLE_IMAGE, INTERS_IMAGE, UNIONS_IMAGE, INTERS_GSPEC]) then_tac \
      REWRITE_TAC(PairList [IN_INTERS, IN_ELIM_THM]) then_tac \
      GEN_TAC then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{(p <=> q) <=> (~p <=> ~q)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [NOT_FORALL_THM, NOT_IMP, NOT_EXISTS_THM]) then_tac \
      REWRITE_TAC(PairList [AND_FORALL_THM, GSYM(SKOLEM_THM)]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def UNIONS_EQ_INTERS:
  prove(
    [
      @hol|{!f:(A->bool)->bool. UNIONS f = INTERS f <=> ?s. f = {s}}|,
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{(?s. f = {s}) <=> ~(f = {}) /\ !s t. s IN f /\ t IN f ==> s = t}|
          )
        ]
      ) then_tac \
      SET_TAC(PairList [])
    ]
  )

def EXISTS_UNIQUE_UNIONS_INTERS:
  prove(
    [
      @hol|{!P. (?!s:A->bool. P s) <=> UNIONS {s | P s} = INTERS {s | P s}}|,
      REWRITE_TAC(PairList [UNIONS_EQ_INTERS]) then_tac SET_TAC(PairList [])
    ]
  )

def IMAGE_INTERS_SUBSET:
  prove(
    [
      @hol|{!(f:A->B) g. IMAGE f (INTERS g) SUBSET INTERS (IMAGE (IMAGE f) g)}|,
      REWRITE_TAC(PairList [INTERS_IMAGE]) then_tac SET_TAC(PairList [])
    ]
  )

def IMAGE_INTER_SUBSET:
  prove(
    [
      @hol|{!(f:A->B) s t. IMAGE f (s INTER t) SUBSET IMAGE f s INTER IMAGE f t}|,
      SET_TAC(PairList [])
    ]
  )

def IMAGE_INTER_SATURATED_GEN:
  prove(
    [
      @hol|{!f:A->B s t u.
         {x | x IN u /\ f(x) IN IMAGE f s} SUBSET s /\ t SUBSET u \/
         {x | x IN u /\ f(x) IN IMAGE f t} SUBSET t /\ s SUBSET u
         ==> IMAGE f (s INTER t) = IMAGE f s INTER IMAGE f t}|,
      SET_TAC(PairList [])
    ]
  )

def IMAGE_INTERS_SATURATED_GEN:
  let lemma:
    prove(
      [
        @hol|{~(g = {}) /\
           (!t. t IN g ==> t SUBSET u /\ {x | x IN u /\ f(x) IN IMAGE f t} SUBSET t)
           ==> IMAGE f (INTERS g) = INTERS (IMAGE (IMAGE f) g)}|,
        ONCE_REWRITE_TAC(PairList [EXTENSION]) then_tac \
        REWRITE_TAC(PairList [INTERS_IMAGE, IN_INTERS, IN_IMAGE]) then_tac \
        REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM, IN_ELIM_THM, NOT_IN_EMPTY]) then_tac \
        ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
        REWRITE_TAC(PairList [IMP_CONJ, FORALL_UNWIND_THM2]) then_tac \
        SET_TAC(PairList [])
      ]
    )
  prove(
    [
      @hol|{!f:A->B g s u.
         ~(g = {}) /\
         (!t. t IN g ==> t SUBSET u) /\
         (!t. t IN g DELETE s ==> {x | x IN u /\ f(x) IN IMAGE f t} SUBSET t)
         ==> IMAGE f (INTERS g) = INTERS (IMAGE (IMAGE f) g)}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{(s:A->bool) IN g}|
      ) then_tac \
      ASM_SIMP_TAC(
        PairList [
          SET_RULE(
            @hol|{~(s IN g) ==> g DELETE s = g}|
          )
        ]
      ) then_list \
      PairList [ALL_TAC, MESON_TAC(PairList [lemma])] then_tac \
      REWRITE_TAC(PairList [CONJ_ASSOC]) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC)) then_tac \
      FIRST_X_ASSUM(
        o(SUBST1_TAC)(
          MATCH_MP(
            SET_RULE(
              @hol|{x IN s ==> s = x INSERT (s DELETE x)}|
            )
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_INSERT, NOT_INSERT_EMPTY]) then_tac \
      STRIP_TAC then_tac \
      ASM_CASES_TAC(
        @hol|{g DELETE (s:A->bool) = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [IMAGE_CLAUSES, INTERS_0, INTERS_1]) then_tac \
      REWRITE_TAC(PairList [IMAGE_CLAUSES, INTERS_INSERT]) then_tac \
      MATCH_MP_TAC(
        SET_RULE(
          @hol|{IMAGE f (s INTER t) = IMAGE f s INTER IMAGE f t /\
             IMAGE f t = u ==> IMAGE f (s INTER t) = IMAGE f s INTER u}|
        )
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(IMAGE_INTER_SATURATED_GEN) then_tac \
        EXISTS_TAC(@hol|{u:A->bool}|) then_tac \
        ASM(SET_TAC)(PairList []),
        MATCH_MP_TAC(lemma) then_tac ASM(SET_TAC)(PairList [])
      ]
    ]
  )

def IMAGE_INTER_SATURATED:
  prove(
    [
      @hol|{!f:A->B s t.
         {x | f(x) IN IMAGE f s} SUBSET s \/ {x | f(x) IN IMAGE f t} SUBSET t
          ==> IMAGE f (s INTER t) = IMAGE f s INTER IMAGE f t}|,
      SET_TAC(PairList [])
    ]
  )

def IMAGE_INTERS_SATURATED:
  prove(
    [
      @hol|{!f:A->B g s.
         ~(g = {}) /\ (!t. t IN g DELETE s ==> {x | f(x) IN IMAGE f t} SUBSET t)
         ==> IMAGE f (INTERS g) = INTERS (IMAGE (IMAGE f) g)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(IMAGE_INTERS_SATURATED_GEN) then_tac \
      MAP_EVERY(EXISTS_TAC)(
        PairList [
          @hol|{s:A->bool}|,
          @hol|{(:A)}|
        ]
      ) then_tac \
      ASM_REWRITE_TAC(PairList [IN_UNIV, SUBSET_UNIV])
    ]
  )

def FINITE_INDUCT_STRONG:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         P {} /\ (!x s. P s /\ ~(x IN s) /\ FINITE s ==> P(x INSERT s))
         ==> !s. FINITE s ==> P s}|,
      GEN_TAC then_tac STRIP_TAC then_tac \
      SUBGOAL_THEN(
        @hol|{!s:A->bool. FINITE s ==> FINITE s /\ P s}|
      )(MP_TAC) then_list \
      PairList [ALL_TAC, MESON_TAC(PairList [])] then_tac \
      MATCH_MP_TAC(sets_FINITE_INDUCT_v2) then_tac \
      ASM_SIMP_TAC(PairList [sets_FINITE_RULES_v2]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_CASES_TAC(
        @hol|{x:A IN s}|
      ) then_list \
      PairList [
        SUBGOAL_THEN(
          @hol|{x:A INSERT s = s}|
        )((fun(th): ASM_REWRITE_TAC(PairList [th]))) then_tac \
        UNDISCH_TAC(
          @hol|{x:A IN s}|
        ) then_tac \
        SET_TAC(PairList []),
        FIRST_ASSUM(MATCH_MP_TAC) then_tac ASM_REWRITE_TAC(PairList [])
      ]
    ]
  )

def INJECTIVE_ON_ALT:
  prove(
    [
      @hol|{!P f:A->B.
         (!x y. P x /\ P y /\ f x = f y ==> x = y) <=>
         (!x y. P x /\ P y ==> (f x = f y <=> x = y))}|,
      MESON_TAC(PairList [])
    ]
  )

def INJECTIVE_ALT:
  prove(
    [
      @hol|{!f:A->B. (!x y. f x = f y ==> x = y) <=> (!x y. f x = f y <=> x = y)}|,
      MESON_TAC(PairList [])
    ]
  )

def SURJECTIVE_ON_RIGHT_INVERSE:
  prove(
    [
      @hol|{!(f:A->B) t.
         (!y. y IN t ==> ?x. x IN s /\ (f(x) = y)) <=>
         (?g. !y. y IN t ==> g(y) IN s /\ (f(g(y)) = y))}|,
      REWRITE_TAC(PairList [RIGHT_IMP_EXISTS_THM, SKOLEM_THM])
    ]
  )

def INJECTIVE_ON_LEFT_INVERSE:
  let lemma:
    MESON(
      PairList [])(
      @hol|{(!x. x IN s ==> (g(f(x)) = x)) <=>
         (!y x. x IN s /\ (y = (f:A->B) x) ==> (g y = x))}|
    )
  prove(
    [
      @hol|{!(f:A->B) s. (!x y. x IN s /\ y IN s /\ (f x = f y) ==> (x = y)) <=>
         (?g. !x. x IN s ==> (g(f(x)) = x))}|,
      REWRITE_TAC(PairList [lemma, GSYM(SKOLEM_THM)]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def BIJECTIVE_ON_LEFT_RIGHT_INVERSE:
  prove(
    [
      @hol|{!(f:A->B) s t.
         (!x. x IN s ==> f(x) IN t)
         ==> ((!x y. x IN s /\ y IN s /\ f(x) = f(y) ==> x = y) /\
              (!y. y IN t ==> ?x. x IN s /\ f x = y) <=>
             ?g. (!y. y IN t ==> g(y) IN s) /\
                 (!y. y IN t ==> (f(g(y)) = y)) /\
                 (!x. x IN s ==> (g(f(x)) = x)))}|,
      REPEAT(GEN_TAC) then_tac DISCH_TAC then_tac \
      REWRITE_TAC(PairList [INJECTIVE_ON_LEFT_INVERSE, SURJECTIVE_ON_RIGHT_INVERSE]) then_tac \
      REWRITE_TAC(PairList [RIGHT_AND_EXISTS_THM]) then_tac \
      AP_TERM_TAC then_tac \
      ABS_TAC then_tac \
      EQ_TAC then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def SURJECTIVE_RIGHT_INVERSE:
  prove(
    [
      @hol|{!f:A->B. (!y. ?x. f(x) = y) <=> (?g. !y. f(g(y)) = y)}|,
      MESON_TAC(PairList [SURJECTIVE_ON_RIGHT_INVERSE, IN_UNIV])
    ]
  )

def INJECTIVE_LEFT_INVERSE:
  let th:
    REWRITE_RULE(PairList [IN_UNIV])(
      ISPECL(
        PairList [
          @hol|{f:A->B}|,
          @hol|{UNIV:A->bool}|
        ])(
        INJECTIVE_ON_LEFT_INVERSE
      )
    )
  prove(
    [
      @hol|{!f:A->B. (!x y. f x = f y ==> x = y) <=> (?g. !x. g(f(x)) = x)}|,
      REWRITE_TAC(PairList [th])
    ]
  )

def BIJECTIVE_LEFT_RIGHT_INVERSE:
  prove(
    [
      @hol|{!f:A->B.
         (!x y. f(x) = f(y) ==> x = y) /\ (!y. ?x. f x = y) <=>
         ?g. (!y. f(g(y)) = y) /\ (!x. g(f(x)) = x)}|,
      GEN_TAC then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:A->B}|,
            @hol|{(:A)}|,
            @hol|{(:B)}|
          ])(
          BIJECTIVE_ON_LEFT_RIGHT_INVERSE
        )
      ) then_tac \
      REWRITE_TAC(PairList [IN_UNIV])
    ]
  )

def FUNCTION_FACTORS_LEFT_GEN:
  prove(
    [
      @hol|{!P (f:A->B) (g:A->C).
         (!x y. P x /\ P y /\ g x = g y ==> f x = f y) <=>
         (?h. !x. P x ==> f(x) = h(g x))}|,
      ONCE_REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(!x. P x ==> f(x) = g(k x)) <=> (!y x. P x /\ y = k x ==> f x = g y)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(SKOLEM_THM)]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def FUNCTION_FACTORS_LEFT:
  prove(
    [
      @hol|{!(f:A->B) (g:A->C). (!x y. g x = g y ==> f x = f y) <=> ?h. f = h o g}|,
      REWRITE_TAC(
        PairList [
          FUN_EQ_THM,
          o_THM,
          GSYM(
            REWRITE_RULE(PairList [])(ISPEC(@hol|{\x. T}|)(FUNCTION_FACTORS_LEFT_GEN))
          )
        ]
      )
    ]
  )

def FUNCTION_FACTORS_RIGHT_GEN:
  prove(
    [
      @hol|{!P (f:A->C) (g:B->C).
         (!x. P x ==> ?y. g(y) = f(x)) <=>
         (?h. !x. P x ==> f(x) = g(h x))}|,
      REWRITE_TAC(PairList [GSYM(SKOLEM_THM)]) then_tac MESON_TAC(PairList [])
    ]
  )

def FUNCTION_FACTORS_RIGHT:
  prove(
    [
      @hol|{!(f:A->C) (g:B->C). (!x. ?y. g(y) = f(x)) <=> ?h. f = g o h}|,
      REWRITE_TAC(PairList [FUN_EQ_THM, o_THM, GSYM(SKOLEM_THM)]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def SURJECTIVE_FORALL_THM:
  prove(
    [
      @hol|{!f:A->B. (!y. ?x. f x = y) <=> (!P. (!x. P(f x)) <=> (!y. P y))}|,
      GEN_TAC then_tac EQ_TAC then_list \
      PairList [MESON_TAC(PairList []), ALL_TAC] then_tac \
      DISCH_THEN((fun(th): ONCE_REWRITE_TAC(PairList [GSYM(th)]))) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def SURJECTIVE_EXISTS_THM:
  prove(
    [
      @hol|{!f:A->B. (!y. ?x. f x = y) <=> (!P. (?x. P(f x)) <=> (?y. P y))}|,
      GEN_TAC then_tac EQ_TAC then_list \
      PairList [MESON_TAC(PairList []), ALL_TAC] then_tac \
      DISCH_THEN(
        o(MP_TAC)(
          SPEC(
            @hol|{\y:B. !x:A. ~(f x = y)}|
          )
        )
      ) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def SURJECTIVE_IMAGE_THM:
  prove(
    [
      @hol|{!f:A->B. (!y. ?x. f x = y) <=> (!P. IMAGE f {x | P(f x)} = {x | P x})}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, IN_ELIM_THM]) then_tac \
      EQ_TAC then_list \
      PairList [
        ALL_TAC,
        DISCH_THEN(o(MP_TAC)(SPEC(@hol|{\y:B. T}|)))
      ] then_tac \
      MESON_TAC(PairList [])
    ]
  )

def IMAGE_INJECTIVE_IMAGE_OF_SUBSET:
  prove(
    [
      @hol|{!f:A->B s.
         ?t. t SUBSET s /\
             IMAGE f s = IMAGE f t /\
             (!x y. x IN t /\ y IN t /\ f x = f y ==> x = y)}|,
      REPEAT(GEN_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{?g. !y. y IN IMAGE (f:A->B) s ==> g(y) IN s /\ f(g(y)) = y}|
      )(STRIP_ASSUME_TAC) then_list \
      PairList [
        REWRITE_TAC(PairList [GSYM(SURJECTIVE_ON_RIGHT_INVERSE)]) then_tac \
        SET_TAC(PairList []),
        EXISTS_TAC(
          @hol|{IMAGE (g:B->A) (IMAGE (f:A->B) s)}|
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      ]
    ]
  )

def FINITE_EMPTY:
  prove(
    [
      @hol|{FINITE ({}:A->bool)}|,
      REWRITE_TAC(PairList [sets_FINITE_RULES_v2])
    ]
  )

def FINITE_SUBSET:
  prove(
    [
      @hol|{!(s:A->bool) t. FINITE t /\ s SUBSET t ==> FINITE s}|,
      ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac \
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(sets_FINITE_INDUCT_v2) then_tac \
      CONJ_TAC then_list \
      PairList [MESON_TAC(PairList [SUBSET_EMPTY, sets_FINITE_RULES_v2]), ALL_TAC] then_tac \
      X_GEN_TAC(@hol|{x:A}|) then_tac \
      X_GEN_TAC(@hol|{u:A->bool}|) then_tac \
      DISCH_TAC then_tac \
      X_GEN_TAC(@hol|{t:A->bool}|) then_tac \
      DISCH_TAC then_tac \
      SUBGOAL_THEN(
        @hol|{FINITE((x:A) INSERT (t DELETE x))}|
      )(ASSUME_TAC) then_list \
      PairList [
        MATCH_MP_TAC(CONJUNCT2(sets_FINITE_RULES_v2)) then_tac \
        FIRST_ASSUM(MATCH_MP_TAC) then_tac \
        UNDISCH_TAC(
          @hol|{t SUBSET (x:A INSERT u)}|
        ) then_tac \
        SET_TAC(PairList []),
        ASM_CASES_TAC(
          @hol|{x:A IN t}|
        ) then_list \
        PairList [
          SUBGOAL_THEN(
            @hol|{x:A INSERT (t DELETE x) = t}|
          )(SUBST_ALL_TAC) then_list \
          PairList [
            UNDISCH_TAC(
              @hol|{x:A IN t}|
            ) then_tac \
            SET_TAC(PairList []),
            ASM_REWRITE_TAC(PairList [])
          ],
          FIRST_ASSUM(MATCH_MP_TAC) then_tac \
          UNDISCH_TAC(
            @hol|{t SUBSET x:A INSERT u}|
          ) then_tac \
          UNDISCH_TAC(
            @hol|{~(x:A IN t)}|
          ) then_tac \
          SET_TAC(PairList [])
        ]
      ]
    ]
  )

def FINITE_RESTRICT:
  prove(
    [
      @hol|{!s:A->bool P. FINITE s ==> FINITE {x | x IN s /\ P x}}|,
      MESON_TAC(PairList [SUBSET_RESTRICT, FINITE_SUBSET])
    ]
  )

def FINITE_UNION_IMP:
  prove(
    [
      @hol|{!(s:A->bool) t. FINITE s /\ FINITE t ==> FINITE (s UNION t)}|,
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(sets_FINITE_INDUCT_v2) then_tac \
      REWRITE_TAC(PairList [UNION_EMPTY]) then_tac \
      SUBGOAL_THEN(
        @hol|{!x s t. (x:A INSERT s) UNION t = x INSERT (s UNION t)}|
      )((fun(th): REWRITE_TAC(PairList [th]))) then_list \
      PairList [SET_TAC(PairList []), MESON_TAC(PairList [sets_FINITE_RULES_v2])]
    ]
  )

def FINITE_UNION:
  prove(
    [
      @hol|{!(s:A->bool) t. FINITE(s UNION t) <=> FINITE(s) /\ FINITE(t)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [
        REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(FINITE_SUBSET) then_tac \
        EXISTS_TAC(
          @hol|{(s:A->bool) UNION t}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        SET_TAC(PairList []),
        MATCH_ACCEPT_TAC(FINITE_UNION_IMP)
      ]
    ]
  )

def FINITE_INTER:
  prove(
    [
      @hol|{!(s:A->bool) t. FINITE s \/ FINITE t ==> FINITE (s INTER t)}|,
      MESON_TAC(PairList [INTER_SUBSET, FINITE_SUBSET])
    ]
  )

def FINITE_INSERT:
  prove(
    [
      @hol|{!(s:A->bool) x. FINITE (x INSERT s) <=> FINITE s}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_list \
      PairList [
        MATCH_MP_TAC(FINITE_SUBSET) then_tac \
        EXISTS_TAC(
          @hol|{x:A INSERT s}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        SET_TAC(PairList []),
        MATCH_MP_TAC(CONJUNCT2(sets_FINITE_RULES_v2)) then_tac \
        ASM_REWRITE_TAC(PairList [])
      ]
    ]
  )

def FINITE_SING:
  prove(
    [
      @hol|{!a:A. FINITE {a}}|,
      REWRITE_TAC(PairList [FINITE_INSERT, sets_FINITE_RULES_v2])
    ]
  )

def FINITE_DELETE_IMP:
  prove(
    [
      @hol|{!(s:A->bool) x. FINITE s ==> FINITE (s DELETE x)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(FINITE_SUBSET) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def FINITE_DELETE:
  prove(
    [
      @hol|{!(s:A->bool) x. FINITE (s DELETE x) <=> FINITE s}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac \
      REWRITE_TAC(PairList [FINITE_DELETE_IMP]) then_tac \
      ASM_CASES_TAC(
        @hol|{x:A IN s}|
      ) then_list \
      PairList [
        SUBGOAL_THEN(
          @hol|{s = x INSERT (s DELETE x:A)}|
        )((fun(th): GEN_REWRITE_TAC(o(RAND_CONV)(RAND_CONV))(PairList [th]))) then_tac \
        REWRITE_TAC(PairList [FINITE_INSERT]) then_tac \
        POP_ASSUM(MP_TAC) then_tac \
        SET_TAC(PairList []),
        SUBGOAL_THEN(
          @hol|{s DELETE x:A = s}|
        )((fun(th): REWRITE_TAC(PairList [th]))) then_tac \
        POP_ASSUM(MP_TAC) then_tac \
        SET_TAC(PairList [])
      ]
    ]
  )

def FINITE_FINITE_UNIONS:
  prove(
    [
      @hol|{!s:(A->bool)->bool.
         FINITE(s) ==> (FINITE(UNIONS s) <=> (!t. t IN s ==> FINITE(t)))}|,
      MATCH_MP_TAC(sets_FINITE_INDUCT_v2) then_tac \
      REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY, UNIONS_0, UNIONS_INSERT]) then_tac \
      REWRITE_TAC(PairList [FINITE_UNION, sets_FINITE_RULES_v2]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def FINITE_IMAGE_EXPAND:
  prove(
    [
      @hol|{!(f:A->B) s. FINITE s ==> FINITE {y | ?x. x IN s /\ (y = f x)}}|,
      GEN_TAC then_tac MATCH_MP_TAC(sets_FINITE_INDUCT_v2) then_tac \
      REWRITE_TAC(PairList [NOT_IN_EMPTY, REWRITE_RULE(PairList [])(EMPTY_GSPEC), sets_FINITE_RULES_v2]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{{y | ?z. z IN (x INSERT s) /\ (y = (f:A->B) z)} =
           {y | ?z. z IN s /\ (y = f z)} UNION {(f x)}}|
      )((fun(th): REWRITE_TAC(PairList [th]))) then_list \
      PairList [
        REWRITE_TAC(PairList [EXTENSION, IN_ELIM_THM, IN_INSERT, IN_UNION, NOT_IN_EMPTY]) then_tac \
        MESON_TAC(PairList []),
        REWRITE_TAC(PairList [FINITE_UNION, FINITE_INSERT, sets_FINITE_RULES_v2])
      ]
    ]
  )

def FINITE_IMAGE:
  prove(
    [
      @hol|{!(f:A->B) s. FINITE s ==> FINITE (IMAGE f s)}|,
      REWRITE_TAC(PairList [IMAGE, FINITE_IMAGE_EXPAND])
    ]
  )

def FINITE_IMAGE_INJ_GENERAL:
  prove(
    [
      @hol|{!(f:A->B) A s.
         (!x y. x IN s /\ y IN s /\ f(x) = f(y) ==> x = y) /\
         FINITE A
         ==> FINITE {x | x IN s /\ f(x) IN A}}|,
      REPEAT(STRIP_TAC) then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [INJECTIVE_ON_LEFT_INVERSE]))) then_tac \
      DISCH_THEN(X_CHOOSE_TAC(@hol|{g:B->A}|)) then_tac \
      MATCH_MP_TAC(FINITE_SUBSET) then_tac \
      EXISTS_TAC(
        @hol|{IMAGE (g:B->A) A}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_IMAGE]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def FINITE_FINITE_PREIMAGE_GENERAL:
  prove(
    [
      @hol|{!f:A->B s t.
         FINITE t /\
         (!y. y IN t ==> FINITE {x | x IN s /\ f(x) = y})
         ==> FINITE {x | x IN s /\ f(x) IN t}}|,
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{{x | x IN s /\ (f:A->B)(x) IN t} =
           UNIONS (IMAGE (\a. {x | x IN s /\ f x = a}) t)}|
      )(SUBST1_TAC) then_list \
      PairList [
        GEN_REWRITE_TAC(I)(PairList [EXTENSION]) then_tac \
        REWRITE_TAC(PairList [IN_ELIM_THM, IN_UNIONS]) then_tac \
        REWRITE_TAC(PairList [EXISTS_IN_IMAGE]) then_tac \
        SET_TAC(PairList []),
        ASM_SIMP_TAC(PairList [FINITE_FINITE_UNIONS, FINITE_IMAGE, FORALL_IN_IMAGE])
      ]
    ]
  )

def FINITE_FINITE_PREIMAGE:
  prove(
    [
      @hol|{!f:A->B t.
         FINITE t /\
         (!y. y IN t ==> FINITE {x | f(x) = y})
         ==> FINITE {x | f(x) IN t}}|,
      REPEAT(GEN_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:A->B}|,
            @hol|{(:A)}|,
            @hol|{t:B->bool}|
          ])(
          FINITE_FINITE_PREIMAGE_GENERAL
        )
      ) then_tac \
      REWRITE_TAC(PairList [IN_UNIV])
    ]
  )

def FINITE_IMAGE_INJ_EQ:
  prove(
    [
      @hol|{!(f:A->B) s.
         (!x y. x IN s /\ y IN s /\ f(x) = f(y) ==> x = y)
         ==> (FINITE(IMAGE f s) <=> FINITE s)}|,
      REPEAT(STRIP_TAC) then_tac EQ_TAC then_tac \
      ASM_SIMP_TAC(PairList [FINITE_IMAGE]) then_tac \
      POP_ASSUM(MP_TAC) then_tac \
      REWRITE_TAC(PairList [IMP_IMP]) then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(FINITE_IMAGE_INJ_GENERAL))) then_tac \
      MATCH_MP_TAC(EQ_IMP) then_tac \
      AP_TERM_TAC then_tac \
      SET_TAC(PairList [])
    ]
  )

def FINITE_IMAGE_INJ:
  prove(
    [
      @hol|{!(f:A->B) A.
         (!x y. f(x) = f(y) ==> x = y) /\ FINITE A
         ==> FINITE {x | f(x) IN A}}|,
      REPEAT(GEN_TAC) then_tac \
      MP_TAC(
        SPECL(
          PairList [
            @hol|{f:A->B}|,
            @hol|{A:B->bool}|,
            @hol|{UNIV:A->bool}|
          ])(
          FINITE_IMAGE_INJ_GENERAL
        )
      ) then_tac \
      REWRITE_TAC(PairList [IN_UNIV])
    ]
  )

def FINITE_IMAGE_GEN:
  prove(
    [
      @hol|{!(f:A->B) (g:A->C) s t.
         IMAGE f s SUBSET t /\ FINITE t /\
         (!x y. x IN s /\ y IN s /\ f x = f y ==> g x = g y)
         ==> FINITE(IMAGE g s)}|,
      REPEAT(STRIP_TAC) then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [FUNCTION_FACTORS_LEFT_GEN]))) then_tac \
      DISCH_THEN(X_CHOOSE_TAC(@hol|{h:B->C}|)) then_tac \
      SUBGOAL_THEN(
        @hol|{IMAGE g s = IMAGE (h:B->C) (IMAGE (f:A->B) s)}|
      )(SUBST1_TAC) then_list \
      PairList [
        ASM(SET_TAC)(PairList []),
        ASM_MESON_TAC(PairList [FINITE_IMAGE, FINITE_SUBSET])
      ]
    ]
  )

def INFINITE_IMAGE:
  prove(
    [
      @hol|{!f:A->B s.
         INFINITE s /\ (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
         ==> INFINITE (IMAGE f s)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [IMP_CONJ_ALT, INJECTIVE_ON_LEFT_INVERSE]) then_tac \
      DISCH_THEN(X_CHOOSE_TAC(@hol|{g:B->A}|)) then_tac \
      REWRITE_TAC(PairList [INFINITE, CONTRAPOS_THM]) then_tac \
      DISCH_TAC then_tac \
      SUBGOAL_THEN(
        @hol|{s = IMAGE (g:B->A) (IMAGE f s)}|
      )(SUBST1_TAC) then_list \
      PairList [
        ASM(SET_TAC)(PairList []),
        MATCH_MP_TAC(FINITE_IMAGE) then_tac ASM_REWRITE_TAC(PairList [])
      ]
    ]
  )

def INFINITE_IMAGE_INJ:
  prove(
    [
      @hol|{!f:A->B. (!x y. (f x = f y) ==> (x = y))
         ==> !s. INFINITE s ==> INFINITE(IMAGE f s)}|,
      MESON_TAC(PairList [INFINITE_IMAGE])
    ]
  )

def INFINITE_NONEMPTY:
  prove(
    [
      @hol|{!s:A->bool. INFINITE(s) ==> ~(s = EMPTY)}|,
      MESON_TAC(PairList [INFINITE, sets_FINITE_RULES_v2])
    ]
  )

def INFINITE_DIFF_FINITE:
  prove(
    [
      @hol|{!s:A->bool t. INFINITE(s) /\ FINITE(t) ==> INFINITE(s DIFF t)}|,
      REPEAT(GEN_TAC) then_tac \
      MATCH_MP_TAC(
        TAUT(
          @hol|{(b /\ ~c ==> ~a) ==> a /\ b ==> c}|
        )
      ) then_tac \
      REWRITE_TAC(PairList [INFINITE]) then_tac \
      STRIP_TAC then_tac \
      MATCH_MP_TAC(FINITE_SUBSET) then_tac \
      EXISTS_TAC(
        @hol|{(t:A->bool) UNION (s DIFF t)}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [FINITE_UNION]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def SUBSET_IMAGE_INJ:
  prove(
    [
      @hol|{!f:A->B s t.
         s SUBSET (IMAGE f t) <=>
         ?u. u SUBSET t /\
             (!x y. x IN u /\ y IN u ==> (f x = f y <=> x = y)) /\
             s = IMAGE f u}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [ALL_TAC, MESON_TAC(PairList [IMAGE_SUBSET])] then_tac \
      DISCH_TAC then_tac \
      FIRST_ASSUM(
        o(MP_TAC)(
          MATCH_MP(
            SET_RULE(
              @hol|{s SUBSET IMAGE f t ==> !x. x IN s ==> ?y. y IN t /\ f y = x}|
            )
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList [SURJECTIVE_ON_RIGHT_INVERSE]) then_tac \
      DISCH_THEN(X_CHOOSE_TAC(@hol|{g:B->A}|)) then_tac \
      EXISTS_TAC(
        @hol|{IMAGE (g:B->A) s}|
      ) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def SUBSET_IMAGE:
  prove(
    [
      @hol|{!f:A->B s t. s SUBSET (IMAGE f t) <=> ?u. u SUBSET t /\ (s = IMAGE f u)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [ALL_TAC, MESON_TAC(PairList [IMAGE_SUBSET])] then_tac \
      REWRITE_TAC(PairList [SUBSET_IMAGE_INJ]) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      SET_TAC(PairList [])
    ]
  )

def EXISTS_SUBSET_IMAGE:
  prove(
    [
      @hol|{!P (f:A->B) s.
         (?t. t SUBSET IMAGE f s /\ P t) <=> (?t. t SUBSET s /\ P (IMAGE f t))}|,
      REWRITE_TAC(PairList [SUBSET_IMAGE]) then_tac MESON_TAC(PairList [])
    ]
  )

def FORALL_SUBSET_IMAGE:
  prove(
    [
      @hol|{!P (f:A->B) s.
         (!t. t SUBSET IMAGE f s ==> P t) <=>
         (!t. t SUBSET s ==> P(IMAGE f t))}|,
      REWRITE_TAC(PairList [SUBSET_IMAGE]) then_tac MESON_TAC(PairList [])
    ]
  )

def EXISTS_SUBSET_IMAGE_INJ:
  prove(
    [
      @hol|{!P (f:A->B) s.
         (?t. t SUBSET IMAGE f s /\ P t) <=>
         (?t. t SUBSET s /\
              (!x y. x IN t /\ y IN t ==> (f x = f y <=> x = y)) /\
              P (IMAGE f t))}|,
      REWRITE_TAC(PairList [SUBSET_IMAGE_INJ]) then_tac MESON_TAC(PairList [])
    ]
  )

def FORALL_SUBSET_IMAGE_INJ:
  prove(
    [
      @hol|{!P (f:A->B) s.
         (!t. t SUBSET IMAGE f s ==> P t) <=>
         (!t. t SUBSET s /\
              (!x y. x IN t /\ y IN t ==> (f x = f y <=> x = y))
              ==> P(IMAGE f t))}|,
      REPEAT(GEN_TAC) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(!t. p t) <=> ~(?t. ~p t)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [NOT_IMP, EXISTS_SUBSET_IMAGE_INJ, GSYM(CONJ_ASSOC)])
    ]
  )

def EXISTS_FINITE_SUBSET_IMAGE_INJ:
  prove(
    [
      @hol|{!P (f:A->B) s.
         (?t. FINITE t /\ t SUBSET IMAGE f s /\ P t) <=>
         (?t. FINITE t /\ t SUBSET s /\
              (!x y. x IN t /\ y IN t ==> (f x = f y <=> x = y)) /\
              P (IMAGE f t))}|,
      ONCE_REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{p /\ q /\ r <=> q /\ p /\ r}|
          )
        ]
      ) then_tac \
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [EXISTS_SUBSET_IMAGE_INJ]) then_tac \
      AP_TERM_TAC then_tac \
      ABS_TAC then_tac \
      MESON_TAC(PairList [FINITE_IMAGE_INJ_EQ])
    ]
  )

def FORALL_FINITE_SUBSET_IMAGE_INJ:
  prove(
    [
      @hol|{!P (f:A->B) s.
         (!t. FINITE t /\ t SUBSET IMAGE f s ==> P t) <=>
         (!t. FINITE t /\ t SUBSET s /\
              (!x y. x IN t /\ y IN t ==> (f x = f y <=> x = y))
              ==> P(IMAGE f t))}|,
      REPEAT(GEN_TAC) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(!t. p t) <=> ~(?t. ~p t)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [NOT_IMP, EXISTS_FINITE_SUBSET_IMAGE_INJ, GSYM(CONJ_ASSOC)])
    ]
  )

def EXISTS_FINITE_SUBSET_IMAGE:
  prove(
    [
      @hol|{!P (f:A->B) s.
         (?t. FINITE t /\ t SUBSET IMAGE f s /\ P t) <=>
         (?t. FINITE t /\ t SUBSET s /\ P (IMAGE f t))}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [
        REWRITE_TAC(PairList [EXISTS_FINITE_SUBSET_IMAGE_INJ]) then_tac \
        MESON_TAC(PairList []),
        MESON_TAC(PairList [FINITE_IMAGE, IMAGE_SUBSET])
      ]
    ]
  )

def FORALL_FINITE_SUBSET_IMAGE:
  prove(
    [
      @hol|{!P (f:A->B) s.
         (!t. FINITE t /\ t SUBSET IMAGE f s ==> P t) <=>
         (!t. FINITE t /\ t SUBSET s ==> P(IMAGE f t))}|,
      REPEAT(GEN_TAC) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(!x. P x) <=> ~(?x. ~P x)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [NOT_IMP, GSYM(CONJ_ASSOC), EXISTS_FINITE_SUBSET_IMAGE])
    ]
  )

def FINITE_SUBSET_IMAGE:
  prove(
    [
      @hol|{!f:A->B s t.
         FINITE(t) /\ t SUBSET (IMAGE f s) <=>
         ?s'. FINITE s' /\ s' SUBSET s /\ (t = IMAGE f s')}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [ALL_TAC, ASM_MESON_TAC(PairList [FINITE_IMAGE, IMAGE_SUBSET])] then_tac \
      SPEC_TAC([@hol|{t:B->bool}|, @hol|{t:B->bool}|]) then_tac \
      REWRITE_TAC(PairList [FORALL_FINITE_SUBSET_IMAGE]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def FINITE_SUBSET_IMAGE_IMP:
  prove(
    [
      @hol|{!f:A->B s t.
         FINITE(t) /\ t SUBSET (IMAGE f s)
         ==> ?s'. FINITE s' /\ s' SUBSET s /\ t SUBSET (IMAGE f s')}|,
      MESON_TAC(PairList [SUBSET_REFL, FINITE_SUBSET_IMAGE])
    ]
  )

def FINITE_IMAGE_EQ:
  prove(
    [
      @hol|{!(f:A->B) s. FINITE(IMAGE f s) <=>
         ?t. FINITE t /\ t SUBSET s /\ IMAGE f s = IMAGE f t}|,
      MESON_TAC(PairList [FINITE_SUBSET_IMAGE, FINITE_IMAGE, SUBSET_REFL])
    ]
  )

def FINITE_IMAGE_EQ_INJ:
  prove(
    [
      @hol|{!(f:A->B) s. FINITE(IMAGE f s) <=>
         ?t. FINITE t /\ t SUBSET s /\ IMAGE f s = IMAGE f t /\
             (!x y. x IN t /\ y IN t ==> (f x = f y <=> x = y))}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [ALL_TAC, MESON_TAC(PairList [FINITE_IMAGE])] then_tac \
      DISCH_TAC then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:A->B}|,
            @hol|{IMAGE (f:A->B) s}|,
            @hol|{s:A->bool}|
          ])(
          SUBSET_IMAGE_INJ
        )
      ) then_tac \
      REWRITE_TAC(PairList [SUBSET_REFL]) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      ASM_METIS_TAC(PairList [FINITE_IMAGE_INJ_EQ])
    ]
  )

def FINITE_DIFF:
  prove(
    [
      @hol|{!s t:A->bool. FINITE s ==> FINITE(s DIFF t)}|,
      MESON_TAC(PairList [FINITE_SUBSET, SUBSET_DIFF])
    ]
  )

def INFINITE_SUPERSET:
  prove(
    [
      @hol|{!s t:A->bool. INFINITE s /\ s SUBSET t ==> INFINITE t}|,
      REWRITE_TAC(PairList [INFINITE]) then_tac MESON_TAC(PairList [FINITE_SUBSET])
    ]
  )

def FINITE_TRANSITIVITY_CHAIN:
  prove(
    [
      @hol|{!R s:A->bool.
         FINITE s /\
         (!x. ~(R x x)) /\
         (!x y z. R x y /\ R y z ==> R x z) /\
         (!x. x IN s ==> ?y. y IN s /\ R x y)
         ==> s = {}}|,
      GEN_TAC then_tac ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [NOT_IN_EMPTY]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def UNIONS_MAXIMAL_SETS:
  prove(
    [
      @hol|{!f. FINITE f
         ==> UNIONS {t:A->bool | t IN f /\ !u. u IN f ==> ~(t PSUBSET u)} =
             UNIONS f}|,
      SIMP_TAC(PairList [GSYM(SUBSET_ANTISYM_EQ), SUBSET_UNIONS, SUBSET_RESTRICT]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(UNIONS_MONO) then_tac \
      X_GEN_TAC(@hol|{s:A->bool}|) then_tac \
      DISCH_TAC then_tac \
      REWRITE_TAC(PairList [EXISTS_IN_GSPEC]) then_tac \
      GEN_REWRITE_TAC(I)(PairList [TAUT(@hol|{p <=> ~ ~ p}|)]) then_tac \
      DISCH_TAC then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{\t u:A->bool. s SUBSET t /\ t PSUBSET u}|,
            @hol|{{t:A->bool | t IN f /\ s SUBSET t}}|
          ])(
          FINITE_TRANSITIVITY_CHAIN
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [NOT_IMP, FINITE_RESTRICT, FORALL_IN_GSPEC, EXISTS_IN_GSPEC]) then_tac \
      REPEAT(CONJ_TAC) then_list \
      PairList [
        SET_TAC(PairList []),
        SET_TAC(PairList []),
        ALL_TAC,
        ASM(SET_TAC)(PairList [])
      ] then_tac \
      ASM_MESON_TAC(PairList [PSUBSET_TRANS, SUBSET_PSUBSET_TRANS, PSUBSET])
    ]
  )

def FINITE_SUBSET_UNIONS:
  prove(
    [
      @hol|{!f s:A->bool.
         FINITE s /\ s SUBSET UNIONS f
         ==> ?f'. FINITE f' /\ f' SUBSET f /\ s SUBSET UNIONS f'}|,
      REPEAT(STRIP_TAC) then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [SUBSET]))) then_tac \
      GEN_REWRITE_TAC(o(LAND_CONV)(TOP_DEPTH_CONV))(PairList [IN_UNIONS, RIGHT_IMP_EXISTS_THM]) then_tac \
      REWRITE_TAC(PairList [SKOLEM_THM, LEFT_IMP_EXISTS_THM]) then_tac \
      X_GEN_TAC(@hol|{u:A->A->bool}|) then_tac \
      DISCH_TAC then_tac \
      EXISTS_TAC(
        @hol|{IMAGE (u:A->A->bool) s}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_IMAGE, UNIONS_IMAGE]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def UNIONS_IN_CHAIN:
  prove(
    [
      @hol|{!f:(A->bool)->bool.
         FINITE f /\ ~(f = {}) /\
         (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
         ==> UNIONS f IN f}|,
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(sets_FINITE_INDUCT_v2) then_tac \
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM, FORALL_IN_INSERT, UNIONS_INSERT]) then_tac \
      REWRITE_TAC(
        PairList [
          FORALL_AND_THM,
          TAUT(
            @hol|{p ==> q /\ r <=> (p ==> q) /\ (p ==> r)}|
          ),
          NOT_INSERT_EMPTY
        ]
      ) then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{s:A->bool}|,
          @hol|{f:(A->bool)->bool}|
        ]
      ) then_tac \
      ASM_CASES_TAC(
        @hol|{f:(A->bool)->bool = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [UNIONS_0, IN_INSERT, UNION_EMPTY]) then_tac \
      DISCH_THEN((fun(th): (STRIP_TAC then_tac MP_TAC(th)))) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [])(
          @hol|{s UNION t = s \/ s UNION t = t
             ==> t IN f ==> s UNION t = s \/ s UNION t IN f}|
        )
      ) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def INTERS_IN_CHAIN:
  prove(
    [
      @hol|{!f:(A->bool)->bool.
         FINITE f /\ ~(f = {}) /\
         (!s t. s IN f /\ t IN f ==> s SUBSET t \/ t SUBSET s)
         ==> INTERS f IN f}|,
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(sets_FINITE_INDUCT_v2) then_tac \
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM, FORALL_IN_INSERT, INTERS_INSERT]) then_tac \
      REWRITE_TAC(
        PairList [
          FORALL_AND_THM,
          TAUT(
            @hol|{p ==> q /\ r <=> (p ==> q) /\ (p ==> r)}|
          ),
          NOT_INSERT_EMPTY
        ]
      ) then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{s:A->bool}|,
          @hol|{f:(A->bool)->bool}|
        ]
      ) then_tac \
      ASM_CASES_TAC(
        @hol|{f:(A->bool)->bool = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [INTERS_0, IN_INSERT, INTER_UNIV]) then_tac \
      DISCH_THEN((fun(th): (STRIP_TAC then_tac MP_TAC(th)))) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      MATCH_MP_TAC(
        MESON(
          PairList [])(
          @hol|{s INTER t = s \/ s INTER t = t
             ==> t IN f ==> s INTER t = s \/ s INTER t IN f}|
        )
      ) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def FINITE_SUBSET_UNIONS_DIRECTED_EQ:
  prove(
    [
      @hol|{!f s:A->bool.
         ~(f = {}) /\
         (!t u. t IN f /\ u IN f
                ==> ?v. v IN f /\ t SUBSET v /\ u SUBSET v) /\
         FINITE s
         ==> (s SUBSET UNIONS f <=> ?t. t IN f /\ s SUBSET t)}|,
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      GEN_TAC then_tac \
      REPEAT(DISCH_TAC) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [INSERT_SUBSET]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def FINITE_SUBSET_UNIONS_CHAIN_EQ:
  time(prove)(
    [
      @hol|{!f s:A->bool.
         ~(f = {}) /\
         (!t u. t IN f /\ u IN f ==> t SUBSET u \/ u SUBSET t) /\
         FINITE s
         ==> (s SUBSET UNIONS f <=> ?t. t IN f /\ s SUBSET t)}|,
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(FINITE_SUBSET_UNIONS_DIRECTED_EQ) then_tac \
      ASM_MESON_TAC(PairList [SUBSET_REFL])
    ]
  )

def FINITE_SUBSET_UNIONS_CHAIN:
  prove(
    [
      @hol|{!f s:A->bool.
         FINITE s /\ s SUBSET UNIONS f /\ ~(f = {}) /\
         (!t u. t IN f /\ u IN f ==> t SUBSET u \/ u SUBSET t)
         ==> ?t. t IN f /\ s SUBSET t}|,
      MESON_TAC(PairList [FINITE_SUBSET_UNIONS_CHAIN_EQ])
    ]
  )

def FINREC:
  new_recursive_definition(num_RECURSION)(
    @hol|{(FINREC (f:A->B->B) b s a 0 <=> (s = {}) /\ (a = b)) /\
       (FINREC (f:A->B->B) b s a (SUC n) <=>
                    ?x c. x IN s /\
                          FINREC f b (s DELETE x) c n  /\
                          (a = f x c))}|
  )

def FINREC_1_LEMMA:
  prove(
    [
      @hol|{!(f:A->B->B) b s a. FINREC f b s a (SUC 0) <=> ?x. s = {x} /\ a = f x b}|,
      REWRITE_TAC(PairList [FINREC]) then_tac REPEAT(GEN_TAC) then_tac \
      AP_TERM_TAC then_tac \
      ABS_TAC then_tac \
      SET_TAC(PairList [])
    ]
  )

def FINREC_SUC_LEMMA:
  let lem:
    prove(
      [
        @hol|{s DELETE (x:A) DELETE y = s DELETE y DELETE x}|,
        SET_TAC(PairList [])
      ]
    )
  prove(
    [
      @hol|{!(f:A->B->B) b.
         (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s)))
         ==> !n s z.
                FINREC f b s z (SUC n)
                ==> !x. x IN s ==> ?w. FINREC f b (s DELETE x) w n /\
                                       (z = f x w)}|,
      REPEAT(GEN_TAC) then_tac DISCH_TAC then_tac INDUCT_TAC then_list \
      PairList [
        REWRITE_TAC(PairList [FINREC_1_LEMMA]) then_tac REWRITE_TAC(PairList [FINREC]) then_tac \
        REPEAT(GEN_TAC) then_tac \
        STRIP_TAC then_tac \
        STRIP_TAC then_tac \
        ASM_REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY]) then_tac \
        DISCH_THEN(SUBST1_TAC) then_tac \
        EXISTS_TAC(@hol|{b:B}|) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        SET_TAC(PairList []),
        REPEAT(GEN_TAC) then_tac \
        GEN_REWRITE_TAC(LAND_CONV)(PairList [FINREC]) then_tac \
        DISCH_THEN(X_CHOOSE_THEN(@hol|{y:A}|)(MP_TAC)) then_tac \
        DISCH_THEN(X_CHOOSE_THEN(@hol|{c:B}|)(STRIP_ASSUME_TAC)) then_tac \
        X_GEN_TAC(@hol|{x:A}|) then_tac \
        DISCH_TAC then_tac \
        ASM_CASES_TAC(@hol|{x:A = y}|) then_tac \
        ASM_REWRITE_TAC(PairList []) then_list \
        PairList [
          EXISTS_TAC(@hol|{c:B}|) then_tac \
          ASM_REWRITE_TAC(PairList []),
          UNDISCH_TAC(
            @hol|{FINREC (f:A->B->B) b (s DELETE y) c (SUC n)}|
          ) then_tac \
          DISCH_THEN(ANTE_RES_THEN(o(MP_TAC)(SPEC(@hol|{x:A}|)))) then_tac \
          ASM_REWRITE_TAC(PairList [IN_DELETE]) then_tac \
          DISCH_THEN(X_CHOOSE_THEN(@hol|{v:B}|)(STRIP_ASSUME_TAC)) then_tac \
          EXISTS_TAC(
            @hol|{(f:A->B->B) y v}|
          ) then_tac \
          ASM_REWRITE_TAC(PairList [FINREC]) then_tac \
          CONJ_TAC then_list \
          PairList [
            MAP_EVERY(EXISTS_TAC)(PairList [@hol|{y:A}|, @hol|{v:B}|]) then_tac \
            ONCE_REWRITE_TAC(PairList [lem]) then_tac \
            ASM_REWRITE_TAC(PairList [IN_DELETE]),
            FIRST_ASSUM(MATCH_MP_TAC) then_tac ASM_REWRITE_TAC(PairList [])
          ]
        ]
      ]
    ]
  )

def FINREC_UNIQUE_LEMMA:
  prove(
    [
      @hol|{!(f:A->B->B) b.
         (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s)))
         ==> !n1 n2 s a1 a2.
                FINREC f b s a1 n1 /\ FINREC f b s a2 n2
                ==> (a1 = a2) /\ (n1 = n2)}|,
      REPEAT(GEN_TAC) then_tac DISCH_TAC then_tac INDUCT_TAC then_tac \
      INDUCT_TAC then_list \
      PairList [
        REWRITE_TAC(PairList [FINREC]) then_tac MESON_TAC(PairList [NOT_IN_EMPTY]),
        REWRITE_TAC(PairList [FINREC]) then_tac MESON_TAC(PairList [NOT_IN_EMPTY]),
        REWRITE_TAC(PairList [FINREC]) then_tac MESON_TAC(PairList [NOT_IN_EMPTY]),
        IMP_RES_THEN(ASSUME_TAC)(FINREC_SUC_LEMMA) then_tac \
        REPEAT(GEN_TAC) then_tac \
        DISCH_THEN((fun(th): (MP_TAC(CONJUNCT1(th)) then_tac MP_TAC(th)))) then_tac \
        DISCH_THEN(CONJUNCTS_THEN(ANTE_RES_THEN(ASSUME_TAC))) then_tac \
        REWRITE_TAC(PairList [FINREC]) then_tac \
        STRIP_TAC then_tac \
        ASM_MESON_TAC(PairList [])
      ]
    ]
  )

def FINREC_EXISTS_LEMMA:
  let lem:
    prove(
      [
        @hol|{~(x IN s ) ==> ((x:A INSERT s) DELETE x = s)}|,
        SET_TAC(PairList [])
      ]
    )
  prove(
    [
      @hol|{!(f:A->B->B) b s. FINITE s ==> ?a n. FINREC f b s a n}|,
      GEN_TAC then_tac GEN_TAC then_tac MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REPEAT(STRIP_TAC) then_list \
      PairList [
        MAP_EVERY(EXISTS_TAC)(
          PairList [
            @hol|{b:B}|,
            @hol|{0}|
          ]
        ) then_tac \
        REWRITE_TAC(PairList [FINREC]),
        MAP_EVERY(EXISTS_TAC)(
          PairList [
            @hol|{(f:A->B->B) x a}|,
            @hol|{SUC n}|
          ]
        ) then_tac \
        REWRITE_TAC(PairList [FINREC]) then_tac \
        MAP_EVERY(EXISTS_TAC)(PairList [@hol|{x:A}|, @hol|{a:B}|]) then_tac \
        FIRST_ASSUM((fun(th): ASM_REWRITE_TAC(PairList [MATCH_MP(lem)(th), IN_INSERT])))
      ]
    ]
  )

def FINREC_FUN_LEMMA:
  prove(
    [
      @hol|{!P (R:A->B->C->bool).
         (!s. P s ==> ?a n. R s a n) /\
         (!n1 n2 s a1 a2. R s a1 n1 /\ R s a2 n2 ==> (a1 = a2) /\ (n1 = n2))
         ==> ?f. !s a. P s ==> ((?n. R s a n) <=> (f s = a))}|,
      REPEAT(STRIP_TAC) then_tac \
      EXISTS_TAC(
        @hol|{\s:A. @a:B. ?n:C. R s a n}|
      ) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      BETA_TAC then_tac \
      EQ_TAC then_list \
      PairList [
        STRIP_TAC then_tac MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
        ASM_MESON_TAC(PairList []),
        DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
        CONV_TAC(SELECT_CONV) then_tac \
        ASM_MESON_TAC(PairList [])
      ]
    ]
  )

def FINREC_FUN:
  prove(
    [
      @hol|{!(f:A->B->B) b.
         (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s)))
         ==> ?g. (g {} = b) /\
                 !s x. FINITE s /\ x IN s
                       ==> (g s = f x (g (s DELETE x)))}|,
      REPEAT(STRIP_TAC) then_tac \
      IMP_RES_THEN(MP_TAC)(FINREC_UNIQUE_LEMMA) then_tac \
      DISCH_THEN(o(MP_TAC)(SPEC(@hol|{b:B}|))) then_tac \
      DISCH_THEN(
        o(MP_TAC)(
          CONJ(
            SPECL(
              PairList [
                @hol|{f:A->B->B}|,
                @hol|{b:B}|
              ])(
              FINREC_EXISTS_LEMMA
            )
          )
        )
      ) then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(FINREC_FUN_LEMMA))) then_tac \
      DISCH_THEN(X_CHOOSE_TAC(@hol|{g:(A->bool)->B}|)) then_tac \
      EXISTS_TAC(@hol|{g:(A->bool)->B}|) then_tac \
      CONJ_TAC then_list \
      PairList [
        SUBGOAL_THEN(
          @hol|{FINITE(EMPTY:A->bool)}|
        )(ANTE_RES_THEN((fun(th): GEN_REWRITE_TAC(I)(PairList [GSYM(th)])))) then_list \
        PairList [
          REWRITE_TAC(PairList [sets_FINITE_RULES_v2]),
          EXISTS_TAC(@hol|{0}|) then_tac \
          REWRITE_TAC(PairList [FINREC])
        ],
        REPEAT(STRIP_TAC) then_tac \
        ANTE_RES_THEN(MP_TAC)(
          ASSUME(
            @hol|{FINITE(s:A->bool)}|
          )
        ) then_tac \
        DISCH_THEN(o(ASSUME_TAC)(GSYM)) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        FIRST_ASSUM(
          o(MP_TAC)(
            SPEC(
              @hol|{(g:(A->bool)->B) s}|
            )
          )
        ) then_tac \
        REWRITE_TAC(PairList []) then_tac \
        REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac \
        INDUCT_TAC then_list \
        PairList [
          ASM_REWRITE_TAC(PairList [FINREC]) then_tac DISCH_TAC then_tac \
          UNDISCH_TAC(
            @hol|{x:A IN s}|
          ) then_tac \
          ASM_REWRITE_TAC(PairList [NOT_IN_EMPTY]),
          IMP_RES_THEN(ASSUME_TAC)(FINREC_SUC_LEMMA) then_tac \
          DISCH_THEN(ANTE_RES_THEN(o(MP_TAC)(SPEC(@hol|{x:A}|)))) then_tac \
          ASM_REWRITE_TAC(PairList []) then_tac \
          DISCH_THEN(
            X_CHOOSE_THEN(@hol|{w:B}|)(CONJUNCTS_THEN(ASSUME_TAC))
          ) then_tac \
          SUBGOAL_THEN(
            @hol|{(g (s DELETE x:A) = w:B)}|
          )(SUBST1_TAC) then_list \
          PairList [
            SUBGOAL_THEN(
              @hol|{FINITE(s DELETE x:A)}|
            )(MP_TAC) then_list \
            PairList [
              MATCH_MP_TAC(FINITE_SUBSET) then_tac \
              EXISTS_TAC(@hol|{s:A->bool}|) then_tac \
              ASM_REWRITE_TAC(PairList []) then_tac \
              SET_TAC(PairList []),
              DISCH_THEN(ANTE_RES_THEN(o(MP_TAC)(GSYM))) then_tac \
              DISCH_THEN((fun(th): REWRITE_TAC(PairList [th]))) then_tac \
              EXISTS_TAC(@hol|{n:num}|) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ],
            ASM_REWRITE_TAC(PairList [])
          ]
        ]
      ]
    ]
  )

def SET_RECURSION_LEMMA:
  prove(
    [
      @hol|{!(f:A->B->B) b.
         (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s)))
         ==> ?g. (g {} = b) /\
                 !x s. FINITE s
                       ==> (g (x INSERT s) =
                                 if x IN s then g s else f x (g s))}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN(
        o(o(MP_TAC)(SPEC(@hol|{b:B}|)))(MATCH_MP(FINREC_FUN))
      ) then_tac \
      DISCH_THEN(
        X_CHOOSE_THEN(@hol|{g:(A->bool)->B}|)(STRIP_ASSUME_TAC)
      ) then_tac \
      EXISTS_TAC(@hol|{g:(A->bool)->B}|) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REPEAT(GEN_TAC) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_TAC then_list \
      PairList [
        AP_TERM_TAC then_tac REWRITE_TAC(PairList [GSYM(ABSORPTION)]) then_tac \
        ASM_REWRITE_TAC(PairList []),
        SUBGOAL_THEN(
          @hol|{FINITE(x:A INSERT s) /\ x IN (x INSERT s)}|
        )(MP_TAC) then_list \
        PairList [
          REWRITE_TAC(PairList [IN_INSERT]) then_tac \
          ASM_MESON_TAC(PairList [sets_FINITE_RULES_v2]),
          DISCH_THEN(ANTE_RES_THEN(SUBST1_TAC)) then_tac \
          REPEAT(AP_TERM_TAC) then_tac \
          UNDISCH_TAC(
            @hol|{~(x:A IN s)}|
          ) then_tac \
          SET_TAC(PairList [])
        ]
      ]
    ]
  )

def ITSET:
  new_definition(
    @hol|{ITSET (f:A->B->B) s b =
       (@g. (g {} = b) /\
            !x s. FINITE s
                  ==> (g (x INSERT s) = if x IN s then g s else f x (g s)))
       s}|
  )

def FINITE_RECURSION:
  prove(
    [
      @hol|{!(f:A->B->B) b.
         (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s)))
         ==> (ITSET f {} b = b) /\
             !x s. FINITE s
                   ==> (ITSET f (x INSERT s) b =
                        if x IN s then ITSET f s b
                                  else f x (ITSET f s b))}|,
      REPEAT(GEN_TAC) then_tac DISCH_TAC then_tac \
      REWRITE_TAC(PairList [ITSET]) then_tac \
      CONV_TAC(SELECT_CONV) then_tac \
      MATCH_MP_TAC(SET_RECURSION_LEMMA) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def FINITE_RECURSION_DELETE:
  prove(
    [
      @hol|{!(f:A->B->B) b.
         (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s)))
         ==> (ITSET f {} b = b) /\
             !x s. FINITE s
                   ==> (ITSET f s b =
                        if x IN s then f x (ITSET f (s DELETE x) b)
                                  else ITSET f (s DELETE x) b)}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(FINITE_RECURSION))) then_tac \
      DISCH_THEN(o(STRIP_ASSUME_TAC)(SPEC(@hol|{b:B}|))) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{x:A IN s}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_list \
      PairList [
        DISCH_THEN(o(MP_TAC)(MATCH_MP(FINITE_DELETE_IMP))) then_tac \
        DISCH_THEN(o(ANTE_RES_THEN(MP_TAC))(SPEC(@hol|{x:A}|))) then_tac \
        DISCH_THEN(o(MP_TAC)(SPEC(@hol|{x:A}|))) then_tac \
        REWRITE_TAC(PairList [IN_DELETE]) then_tac \
        DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
        AP_THM_TAC then_tac \
        AP_TERM_TAC then_tac \
        UNDISCH_TAC(
          @hol|{x:A IN s}|
        ) then_tac \
        SET_TAC(PairList []),
        DISCH_TAC then_tac AP_THM_TAC then_tac AP_TERM_TAC then_tac \
        UNDISCH_TAC(
          @hol|{~(x:A IN s)}|
        ) then_tac \
        SET_TAC(PairList [])
      ]
    ]
  )

def ITSET_EQ:
  prove(
    [
      @hol|{!s (f:A->B->B) g b.
         FINITE(s) /\ (!x. x IN s ==> (f x = g x)) /\
         (!x y s. ~(x = y) ==> (f x (f y s) = f y (f x s))) /\
         (!x y s. ~(x = y) ==> (g x (g y s) = g y (g x s)))
         ==> (ITSET f s b = ITSET g s b)}|,
      ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [FINITE_RECURSION, NOT_IN_EMPTY, IN_INSERT]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      AP_TERM_TAC then_tac \
      FIRST_ASSUM(o(MATCH_MP_TAC)(REWRITE_RULE(PairList [RIGHT_IMP_FORALL_THM]))) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def CARD:
  new_definition(
    @hol|{CARD (s:A->bool) = ITSET (\x n. SUC n) s 0}|
  )

def CARD_CLAUSES:
  prove(
    [
      @hol|{(CARD ({}:A->bool) = 0) /\
         (!(x:A) s. FINITE s ==>
                       (CARD (x INSERT s) =
                            if x IN s then CARD s else SUC(CARD s)))}|,
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{\(x:A) n. SUC n}|,
            @hol|{0}|
          ])(
          FINITE_RECURSION
        )
      ) then_tac \
      REWRITE_TAC(PairList [CARD])
    ]
  )

def CARD_UNION:
  prove(
    [
      @hol|{!(s:A->bool) t. FINITE(s) /\ FINITE(t) /\ (s INTER t = EMPTY)
         ==> (CARD (s UNION t) = CARD s + CARD t)}|,
      REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{a /\ b /\ c ==> d <=> a ==> b /\ c ==> d}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [UNION_EMPTY, CARD_CLAUSES, INTER_EMPTY, ADD_CLAUSES]) then_tac \
      X_GEN_TAC(@hol|{x:A}|) then_tac \
      X_GEN_TAC(@hol|{s:A->bool}|) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{(x:A INSERT s) UNION t = x INSERT (s UNION t)}|
      )(SUBST1_TAC) then_list \
      PairList [SET_TAC(PairList []), ALL_TAC] then_tac \
      SUBGOAL_THEN(
        @hol|{FINITE ((s:A->bool) UNION t) /\ FINITE s}|
      )(STRIP_ASSUME_TAC) then_list \
      PairList [
        ASM_REWRITE_TAC(PairList []) then_tac MATCH_MP_TAC(FINITE_UNION_IMP) then_tac \
        ASM_REWRITE_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      MP_TAC(
        ISPECL(PairList [@hol|{x:A}|, @hol|{s:A->bool}|])(CONJUNCT2(CARD_CLAUSES))
      ) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{x:A}|,
            @hol|{s:A->bool UNION t}|
          ]
        )(CONJUNCT2(CARD_CLAUSES))
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_TAC then_tac \
      DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      SUBGOAL_THEN(
        @hol|{~(x:A IN (s UNION t))}|
      )(ASSUME_TAC) then_list \
      PairList [
        ASM_REWRITE_TAC(PairList [IN_UNION]) then_tac \
        UNDISCH_TAC(
          @hol|{(x:A INSERT s) INTER t = EMPTY}|
        ) then_tac \
        REWRITE_TAC(PairList [EXTENSION, IN_INSERT, IN_INTER, NOT_IN_EMPTY]) then_tac \
        MESON_TAC(PairList []),
        ASM_REWRITE_TAC(PairList [SUC_INJ, ADD_CLAUSES]) then_tac \
        FIRST_ASSUM(MATCH_MP_TAC) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        UNDISCH_TAC(
          @hol|{x:A INSERT s INTER t = EMPTY}|
        ) then_tac \
        SET_TAC(PairList [])
      ]
    ]
  )

def CARD_DELETE:
  prove(
    [
      @hol|{!x:A s. FINITE(s)
         ==> (CARD(s DELETE x) = if x IN s then CARD(s) - 1 else CARD(s))}|,
      REPEAT(STRIP_TAC) then_tac COND_CASES_TAC then_list \
      PairList [
        SUBGOAL_THEN(
          @hol|{s = x:A INSERT (s DELETE x)}|
        )((fun(th): GEN_REWRITE_TAC(o(RAND_CONV)(ONCE_DEPTH_CONV))(PairList [th]))) then_list \
        PairList [
          UNDISCH_TAC(
            @hol|{x:A IN s}|
          ) then_tac \
          SET_TAC(PairList []),
          ALL_TAC
        ] then_tac \
        ASM_SIMP_TAC(PairList [CARD_CLAUSES, FINITE_DELETE, IN_DELETE, SUC_SUB1]),
        AP_TERM_TAC then_tac \
        UNDISCH_TAC(
          @hol|{~(x:A IN s)}|
        ) then_tac \
        SET_TAC(PairList [])
      ]
    ]
  )

def CARD_UNION_EQ:
  prove(
    [
      @hol|{!s t u:A->bool.
         FINITE u /\ s INTER t = {} /\ s UNION t = u
         ==> (CARD s + CARD t = CARD u)}|,
      MESON_TAC(PairList [CARD_UNION, FINITE_SUBSET, SUBSET_UNION])
    ]
  )

def CARD_DIFF:
  prove(
    [
      @hol|{!s t:A->bool. FINITE s /\ t SUBSET s ==> CARD(s DIFF t) = CARD s - CARD t}|,
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(
        ARITH_RULE(
          @hol|{a + b:num = c ==> a = c - b}|
        )
      ) then_tac \
      MATCH_MP_TAC(CARD_UNION_EQ) then_tac \
      ASM_SIMP_TAC(PairList []) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def CARD_EQ_0:
  prove(
    [
      @hol|{!s:A->bool. FINITE s ==> ((CARD s = 0) <=> (s = {}))}|,
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [CARD_CLAUSES, NOT_INSERT_EMPTY, NOT_SUC])
    ]
  )

def CARD_SING:
  prove(
    [
      @hol|{!a:A. CARD {a} = 1}|,
      SIMP_TAC(PairList [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY, NOT_IN_EMPTY, ARITH])
    ]
  )

def CARD_LE_2:
  prove(
    [
      @hol|{!a (b:A). CARD{a,b} <= 2}|,
      SIMP_TAC(PairList [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY, IN_INSERT, NOT_IN_EMPTY]) then_tac \
      REPEAT(GEN_TAC or_tac COND_CASES_TAC) then_tac \
      ARITH_TAC
    ]
  )

def CARD_LE_3:
  prove(
    [
      @hol|{!a b (c:A). CARD{a,b,c} <= 3}|,
      SIMP_TAC(PairList [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY, IN_INSERT, NOT_IN_EMPTY]) then_tac \
      REPEAT(GEN_TAC or_tac COND_CASES_TAC) then_tac \
      ARITH_TAC
    ]
  )

def CARD_LE_4:
  prove(
    [
      @hol|{!a b c (d:A). CARD{a,b,c,d} <= 4}|,
      SIMP_TAC(PairList [CARD_CLAUSES, FINITE_INSERT, FINITE_EMPTY, IN_INSERT, NOT_IN_EMPTY]) then_tac \
      REPEAT(GEN_TAC or_tac COND_CASES_TAC) then_tac \
      ARITH_TAC
    ]
  )

def FINITE_INDUCT_DELETE:
  prove(
    [
      @hol|{!P. P {} /\
         (!s. FINITE s /\ ~(s = {}) ==> ?x. x IN s /\ (P(s DELETE x) ==> P s))
         ==> !s:A->bool. FINITE s ==> P s}|,
      GEN_TAC then_tac STRIP_TAC then_tac GEN_TAC then_tac \
      WF_INDUCT_TAC(
        @hol|{CARD(s:A->bool)}|
      ) then_tac \
      ASM_CASES_TAC(
        @hol|{s:A->bool = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_TAC then_tac \
      UNDISCH_TAC(
        @hol|{!s. FINITE s /\ ~(s = {}) ==> ?x:A. x IN s /\ (P(s DELETE x) ==> P s)}|
      ) then_tac \
      DISCH_THEN(o(MP_TAC)(SPEC(@hol|{s:A->bool}|))) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_THEN(
        X_CHOOSE_THEN(@hol|{x:A}|)(CONJUNCTS_THEN2(ASSUME_TAC)(MATCH_MP_TAC))
      ) then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPEC(
            @hol|{s DELETE (x:A)}|
          )
        )
      ) then_tac \
      ASM_SIMP_TAC(
        PairList [
          FINITE_DELETE,
          CARD_DELETE,
          CARD_EQ_0,
          ARITH_RULE(
            @hol|{n - 1 < n <=> ~(n = 0)}|
          )
        ]
      )
    ]
  )

def HAS_SIZE:
  new_definition(
    @hol|{(s:A->bool) HAS_SIZE n <=> FINITE s /\ CARD s = n}|
  )

def HAS_SIZE_CARD:
  prove(
    [
      @hol|{!(s:A->bool) n. s HAS_SIZE n ==> CARD s = n}|,
      SIMP_TAC(PairList [HAS_SIZE])
    ]
  )

def HAS_SIZE_0:
  prove(
    [
      @hol|{!(s:A->bool). s HAS_SIZE 0 <=> (s = {})}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [HAS_SIZE]) then_tac \
      EQ_TAC then_tac \
      DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList [sets_FINITE_RULES_v2, CARD_CLAUSES]) then_tac \
      FIRST_ASSUM(o(MP_TAC)(CONJUNCT2)) then_tac \
      FIRST_ASSUM(o(MP_TAC)(CONJUNCT1)) then_tac \
      SPEC_TAC([@hol|{s:A->bool}|, @hol|{s:A->bool}|]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [NOT_INSERT_EMPTY]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      STRIP_TAC then_tac \
      FIRST_ASSUM((fun(th): REWRITE_TAC(PairList [MATCH_MP(CONJUNCT2(CARD_CLAUSES))(th)]))) then_tac \
      ASM_REWRITE_TAC(PairList [NOT_SUC])
    ]
  )

def HAS_SIZE_SUC:
  prove(
    [
      @hol|{!(s:A->bool) n. s HAS_SIZE (SUC n) <=>
         ~(s = {}) /\ !a. a IN s ==> (s DELETE a) HAS_SIZE n}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [HAS_SIZE]) then_tac \
      ASM_CASES_TAC(
        @hol|{s:A->bool = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [CARD_CLAUSES, sets_FINITE_RULES_v2, NOT_IN_EMPTY, NOT_SUC]) then_tac \
      REWRITE_TAC(PairList [FINITE_DELETE]) then_tac \
      ASM_CASES_TAC(
        @hol|{FINITE(s:A->bool)}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [NOT_FORALL_THM, MEMBER_NOT_EMPTY]) then_tac \
      EQ_TAC then_tac \
      REPEAT(STRIP_TAC) then_list \
      PairList [
        MP_TAC(
          ISPECL(
            PairList [
              @hol|{a:A}|,
              @hol|{s DELETE a:A}|
            ]
          )(CONJUNCT2(CARD_CLAUSES))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [FINITE_DELETE, IN_DELETE]) then_tac \
        SUBGOAL_THEN(
          @hol|{a INSERT (s DELETE a:A) = s}|
        )(SUBST1_TAC) then_list \
        PairList [
          UNDISCH_TAC(
            @hol|{a:A IN s}|
          ) then_tac \
          SET_TAC(PairList []),
          ASM_REWRITE_TAC(PairList [SUC_INJ]) then_tac MESON_TAC(PairList [])
        ],
        FIRST_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [GSYM(MEMBER_NOT_EMPTY)]))) then_tac \
        DISCH_THEN(X_CHOOSE_TAC(@hol|{a:A}|)) then_tac \
        MP_TAC(
          ISPECL(
            PairList [
              @hol|{a:A}|,
              @hol|{s DELETE a:A}|
            ]
          )(CONJUNCT2(CARD_CLAUSES))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [FINITE_DELETE, IN_DELETE]) then_tac \
        SUBGOAL_THEN(
          @hol|{a INSERT (s DELETE a:A) = s}|
        )(SUBST1_TAC) then_list \
        PairList [
          UNDISCH_TAC(
            @hol|{a:A IN s}|
          ) then_tac \
          SET_TAC(PairList []),
          ASM_MESON_TAC(PairList [])
        ]
      ]
    ]
  )

def HAS_SIZE_UNION:
  prove(
    [
      @hol|{!(s:A->bool) t m n.
         s HAS_SIZE m /\ t HAS_SIZE n /\ DISJOINT s t
         ==> (s UNION t) HAS_SIZE (m + n)}|,
      SIMP_TAC(PairList [HAS_SIZE, FINITE_UNION, DISJOINT, CARD_UNION])
    ]
  )

def HAS_SIZE_DIFF:
  prove(
    [
      @hol|{!(s:A->bool) t m n.
         s HAS_SIZE m /\ t HAS_SIZE n /\ t SUBSET s
         ==> (s DIFF t) HAS_SIZE (m - n)}|,
      SIMP_TAC(PairList [HAS_SIZE, FINITE_DIFF, CARD_DIFF])
    ]
  )

def HAS_SIZE_UNIONS:
  prove(
    [
      @hol|{!s t:A->B->bool m n.
         s HAS_SIZE m /\
         (!x. x IN s ==> t(x) HAS_SIZE n) /\
         (!x y. x IN s /\ y IN s /\ ~(x = y) ==> DISJOINT (t x) (t y))
         ==> UNIONS {t(x) | x IN s} HAS_SIZE (m * n)}|,
      GEN_REWRITE_TAC(o(funpow(4)(BINDER_CONV))(funpow(2)(LAND_CONV)))(PairList [HAS_SIZE]) then_tac \
      REWRITE_TAC(PairList [GSYM(CONJ_ASSOC)]) then_tac \
      ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      CONJ_TAC then_list \
      PairList [
        REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [CARD_CLAUSES]) then_tac \
        DISCH_THEN(CONJUNCTS_THEN2(o(SUBST1_TAC)(SYM))(K(ALL_TAC))) then_tac \
        REWRITE_TAC(PairList [MULT_CLAUSES, HAS_SIZE_0, EMPTY_UNIONS]) then_tac \
        REWRITE_TAC(PairList [IN_ELIM_THM, NOT_IN_EMPTY]),
        ALL_TAC
      ] then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{x:A}|, @hol|{s:A->bool}|]) then_tac \
      STRIP_TAC then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{t:A->B->bool}|,
          @hol|{m:num}|,
          @hol|{n:num}|
        ]
      ) then_tac \
      ASM_SIMP_TAC(PairList [CARD_CLAUSES]) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(o(SUBST1_TAC)(SYM))(STRIP_ASSUME_TAC)) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{UNIONS {t y | y IN x INSERT s} = t x UNION UNIONS {t y | y IN s}}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            @hol|{SUC a * b = b + a * b}|
          )
        ]
      ) then_tac \
      MATCH_MP_TAC(HAS_SIZE_UNION) then_tac \
      ASM_SIMP_TAC(PairList [IN_INSERT]) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{DISJOINT a (UNIONS s) <=> !x. x IN s ==> DISJOINT a x}|
          )
        ]
      ) then_tac \
      ASM_SIMP_TAC(PairList [IN_ELIM_THM, LEFT_IMP_EXISTS_THM]) then_tac \
      ASM_MESON_TAC(PairList [IN_INSERT])
    ]
  )

def FINITE_HAS_SIZE:
  prove(
    [
      @hol|{!s:A->bool. FINITE s <=> s HAS_SIZE CARD s}|,
      REWRITE_TAC(PairList [HAS_SIZE])
    ]
  )

def HAS_SIZE_CLAUSES:
  let lemma:
    SET_RULE(
      @hol|{a IN s ==> (s = a INSERT (s DELETE a))}|
    )
  prove(
    [
      @hol|{(s HAS_SIZE 0 <=> s = {}) /\
         (s HAS_SIZE (SUC n) <=>
              ?(a:A) t. t HAS_SIZE n /\ ~(a IN t) /\ (s = a INSERT t))}|,
      REWRITE_TAC(PairList [HAS_SIZE_0]) then_tac REPEAT(STRIP_TAC) then_tac \
      EQ_TAC then_list \
      PairList [
        REWRITE_TAC(PairList [HAS_SIZE_SUC, GSYM(MEMBER_NOT_EMPTY)]) then_tac \
        MESON_TAC(PairList [lemma, IN_DELETE]),
        SIMP_TAC(PairList [LEFT_IMP_EXISTS_THM, HAS_SIZE, CARD_CLAUSES, FINITE_INSERT])
      ]
    ]
  )

def HAS_SIZE_CONV:
  let pth:
    prove(
      [
        @hol|{(~((a:A) IN {}) /\ P <=> P) /\
           (~(a IN {b}) /\ P <=> ~(a = b) /\ P) /\
           (~(a IN (b INSERT cs)) /\ P <=> ~(a = b) /\ ~(a IN cs) /\ P)}|,
        SET_TAC(PairList [])
      ]
    )
  let qth:
    prove(
      [
        @hol|{((?s. s HAS_SIZE 0 /\ P s) <=> P {}) /\
           ((?s. s HAS_SIZE (SUC n) /\ P s) <=>
            (?(a:A) s. s HAS_SIZE n /\ ~(a IN s) /\ P(a INSERT s)))}|,
        REWRITE_TAC(PairList [HAS_SIZE_CLAUSES]) then_tac MESON_TAC(PairList [])
      ]
    )
  let qconv_0 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT1(qth)])
  let qconv_1 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT2(qth)])
  let rconv_0 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT1(pth)])
  let rconv_1 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT2(pth)])
  fun EXISTS_HAS_SIZE_AND_CONV(tm):
    (
      qconv_0 or_conv \
      (
        BINDER_CONV(LAND_CONV(RAND_CONV(num_CONV))) then_conv qconv_1 then_conv \
        BINDER_CONV(EXISTS_HAS_SIZE_AND_CONV)
      )
    )(tm)
  fun NOT_IN_INSERT_CONV(tm):
    (
      rconv_0 then_conv NOT_IN_INSERT_CONV or_conv \
      (rconv_1 then_conv RAND_CONV(NOT_IN_INSERT_CONV)) or_conv \
      ALL_CONV
    )(tm)
  let HAS_SIZE_CONV:
    (
      GEN_REWRITE_CONV(I)(PairList [CONJUNCT1(HAS_SIZE_CLAUSES)]) or_conv \
      (
        RAND_CONV(num_CONV) then_conv \
        GEN_REWRITE_CONV(I)(PairList [CONJUNCT2(HAS_SIZE_CLAUSES)]) then_conv \
        BINDER_CONV(EXISTS_HAS_SIZE_AND_CONV)
      )
    )
  fun(tm):
    let th = HAS_SIZE_CONV(tm)
    let tm_prime = rand(concl(th))
    let [evs, bod] = strip_exists(tm_prime)
    if (evs == (PairList []))
    | th
    | let th_prime = funpow(length(evs))(BINDER_CONV)(NOT_IN_INSERT_CONV)(tm_prime)
      TRANS(th)(th_prime)

def CARD_SUBSET_EQ:
  prove(
    [
      @hol|{!(a:A->bool) b. FINITE b /\ a SUBSET b /\ (CARD a = CARD b) ==> (a = b)}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        SPECL(
          PairList [
            @hol|{a:A->bool}|,
            @hol|{b DIFF (a:A->bool)}|
          ])(
          CARD_UNION
        )
      ) then_tac \
      SUBGOAL_THEN(
        @hol|{FINITE(a:A->bool)}|
      )(ASSUME_TAC) then_list \
      PairList [ASM_MESON_TAC(PairList [FINITE_SUBSET]), ALL_TAC] then_tac \
      SUBGOAL_THEN(
        @hol|{FINITE(b:A->bool DIFF a)}|
      )(ASSUME_TAC) then_list \
      PairList [
        MATCH_MP_TAC(FINITE_SUBSET) then_tac \
        EXISTS_TAC(@hol|{b:A->bool}|) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        SET_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      SUBGOAL_THEN(
        @hol|{a:A->bool INTER (b DIFF a) = EMPTY}|
      )(ASSUME_TAC) then_list \
      PairList [SET_TAC(PairList []), ALL_TAC] then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      SUBGOAL_THEN(
        @hol|{a UNION (b:A->bool DIFF a) = b}|
      )(ASSUME_TAC) then_list \
      PairList [
        UNDISCH_TAC(
          @hol|{a:A->bool SUBSET b}|
        ) then_tac \
        SET_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            @hol|{(a = a + b) <=> (b = 0)}|
          )
        ]
      ) then_tac \
      DISCH_TAC then_tac \
      SUBGOAL_THEN(
        @hol|{b:A->bool DIFF a = EMPTY}|
      )(MP_TAC) then_list \
      PairList [
        REWRITE_TAC(PairList [GSYM(HAS_SIZE_0)]) then_tac \
        ASM_REWRITE_TAC(PairList [HAS_SIZE]),
        UNDISCH_TAC(
          @hol|{a:A->bool SUBSET b}|
        ) then_tac \
        SET_TAC(PairList [])
      ]
    ]
  )

def CARD_SUBSET:
  prove(
    [
      @hol|{!(a:A->bool) b. a SUBSET b /\ FINITE(b) ==> CARD(a) <= CARD(b)}|,
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{b:A->bool = a UNION (b DIFF a)}|
      )(SUBST1_TAC) then_list \
      PairList [
        UNDISCH_TAC(
          @hol|{a:A->bool SUBSET b}|
        ) then_tac \
        SET_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      SUBGOAL_THEN(
        @hol|{CARD (a UNION b DIFF a) = CARD(a:A->bool) + CARD(b DIFF a)}|
      )(SUBST1_TAC) then_list \
      PairList [
        MATCH_MP_TAC(CARD_UNION) then_tac REPEAT(CONJ_TAC) then_list \
        PairList [
          MATCH_MP_TAC(FINITE_SUBSET) then_tac \
          EXISTS_TAC(@hol|{b:A->bool}|) then_tac \
          ASM_REWRITE_TAC(PairList []),
          MATCH_MP_TAC(FINITE_SUBSET) then_tac \
          EXISTS_TAC(@hol|{b:A->bool}|) then_tac \
          ASM_REWRITE_TAC(PairList []) then_tac \
          SET_TAC(PairList []),
          SET_TAC(PairList [])
        ],
        ARITH_TAC
      ]
    ]
  )

def CARD_SUBSET_LE:
  prove(
    [
      @hol|{!(a:A->bool) b. FINITE b /\ a SUBSET b /\ CARD b <= CARD a ==> a = b}|,
      MESON_TAC(PairList [CARD_SUBSET, CARD_SUBSET_EQ, LE_ANTISYM])
    ]
  )

def SUBSET_CARD_EQ:
  prove(
    [
      @hol|{!s t:A->bool. FINITE t /\ s SUBSET t ==> (CARD s = CARD t <=> s = t)}|,
      MESON_TAC(PairList [CARD_SUBSET_EQ, LE_ANTISYM, CARD_SUBSET])
    ]
  )

def FINITE_CARD_LE_SUBSET:
  prove(
    [
      @hol|{!s (t:A->bool) n.
         s SUBSET t /\ FINITE t /\ CARD t <= n
         ==> FINITE s /\ CARD s <= n}|,
      MESON_TAC(PairList [FINITE_SUBSET, CARD_SUBSET, LE_TRANS])
    ]
  )

def CARD_PSUBSET:
  prove(
    [
      @hol|{!(a:A->bool) b. a PSUBSET b /\ FINITE(b) ==> CARD(a) < CARD(b)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{a PSUBSET b <=> ?x. x IN b /\ ~(x IN a) /\ a SUBSET (b DELETE x)}|
          )
        ]
      ) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC)) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{x:A}|)(STRIP_ASSUME_TAC)) then_tac \
      MATCH_MP_TAC(LET_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{CARD(b DELETE (x:A))}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [CARD_SUBSET, FINITE_DELETE]) then_tac \
      ASM_SIMP_TAC(
        PairList [
          CARD_DELETE,
          ARITH_RULE(
            @hol|{n - 1 < n <=> ~(n = 0)}|
          )
        ]
      ) then_tac \
      ASM_MESON_TAC(PairList [CARD_EQ_0, MEMBER_NOT_EMPTY])
    ]
  )

def CARD_PSUBSET_IMP:
  prove(
    [
      @hol|{!a b:A->bool. a SUBSET b /\ ~(CARD a = CARD b) ==> a PSUBSET b}|,
      REWRITE_TAC(PairList [PSUBSET]) then_tac MESON_TAC(PairList [])
    ]
  )

def CARD_PSUBSET_EQ:
  prove(
    [
      @hol|{!a b:A->bool. FINITE b /\ a SUBSET b ==> (a PSUBSET b <=> CARD a < CARD b)}|,
      MESON_TAC(PairList [CARD_PSUBSET_IMP, CARD_PSUBSET, LT_REFL])
    ]
  )

def CARD_UNION_LE:
  prove(
    [
      @hol|{!s t:A->bool.
         FINITE s /\ FINITE t ==> CARD(s UNION t) <= CARD(s) + CARD(t)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(LE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{CARD(s:A->bool) + CARD(t DIFF s)}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [LE_ADD_LCANCEL, CARD_SUBSET, SUBSET_DIFF, FINITE_DIFF]) then_tac \
      MATCH_MP_TAC(EQ_IMP_LE) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{s UNION t = s UNION (t DIFF s)}|
          )
        ]
      ) then_tac \
      MATCH_MP_TAC(CARD_UNION) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_DIFF]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def FINITE_CARD_LE_UNION:
  prove(
    [
      @hol|{!s (t:A->bool) m n.
         (FINITE s /\ CARD s <= m) /\
         (FINITE t /\ CARD t <= n)
         ==> FINITE(s UNION t) /\ CARD(s UNION t) <= m + n}|,
      MESON_TAC(PairList [FINITE_UNION, CARD_UNION_LE, LE_ADD2, LE_TRANS])
    ]
  )

def CARD_UNIONS_LE:
  prove(
    [
      @hol|{!s t:A->B->bool m n.
         s HAS_SIZE m /\ (!x. x IN s ==> FINITE(t x) /\ CARD(t x) <= n)
         ==> CARD(UNIONS {t(x) | x IN s}) <= m * n}|,
      GEN_REWRITE_TAC(o(funpow(4)(BINDER_CONV))(funpow(2)(LAND_CONV)))(PairList [HAS_SIZE]) then_tac \
      REWRITE_TAC(PairList [GSYM(CONJ_ASSOC)]) then_tac \
      ONCE_REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      CONJ_TAC then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{UNIONS {t x | x IN {}} = {}}|
          ),
          CARD_CLAUSES,
          LE_0
        ]
      ) then_tac \
      REPEAT(GEN_TAC) then_tac \
      STRIP_TAC then_tac \
      REPEAT(GEN_TAC) then_tac \
      ASM_SIMP_TAC(PairList [CARD_CLAUSES, sets_FINITE_RULES_v2]) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(o(SUBST_ALL_TAC)(SYM))(ASSUME_TAC)) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{UNIONS {t x | x IN a INSERT s} = t(a) UNION UNIONS {t x | x IN s}}|
          )
        ]
      ) then_tac \
      MATCH_MP_TAC(LE_TRANS) then_tac \
      EXISTS_TAC(
        @hol|{CARD((t:A->B->bool) x) + CARD(UNIONS {(t:A->B->bool) y | y IN s})}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(CARD_UNION_LE) then_tac ASM_SIMP_TAC(PairList [IN_INSERT]) then_tac \
        REWRITE_TAC(
          PairList [
            SET_RULE(
              @hol|{{t x | x IN s} = IMAGE t s}|
            )
          ]
        ) then_tac \
        ASM_SIMP_TAC(PairList [FINITE_FINITE_UNIONS, FINITE_IMAGE, FORALL_IN_IMAGE, IN_INSERT]),
        MATCH_MP_TAC(
          ARITH_RULE(
            @hol|{a <= n /\ b <= x * n ==> a + b <= SUC x * n}|
          )
        ) then_tac \
        ASM_SIMP_TAC(PairList [IN_INSERT])
      ]
    ]
  )

def CARD_UNION_GEN:
  prove(
    [
      @hol|{!s t:A->bool.
         FINITE s /\ FINITE t
         ==> CARD(s UNION t) = (CARD(s) + CARD(t)) - CARD(s INTER t)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{s UNION t = s UNION (t DIFF s)}|
          )
        ]
      ) then_tac \
      ASM_SIMP_TAC(
        PairList [
          ARITH_RULE(
            @hol|{x:num <= y ==> (a + y) - x = a + (y - x)}|
          ),
          CARD_SUBSET,
          INTER_SUBSET,
          GSYM(CARD_DIFF)
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{t DIFF (s INTER t) = t DIFF s}|
          )
        ]
      ) then_tac \
      MATCH_MP_TAC(CARD_UNION) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_DIFF]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def CARD_UNION_OVERLAP_EQ:
  prove(
    [
      @hol|{!s t:A->bool.
         FINITE s /\ FINITE t
         ==> (CARD(s UNION t) = CARD s + CARD t <=> s INTER t = {})}|,
      REPEAT(GEN_TAC) then_tac STRIP_TAC then_tac \
      ASM_SIMP_TAC(PairList [CARD_UNION_GEN]) then_tac \
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            @hol|{a - b = a <=> b = 0 \/ a = 0}|
          )
        ]
      ) then_tac \
      ASM_SIMP_TAC(PairList [ADD_EQ_0, CARD_EQ_0, FINITE_INTER]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def CARD_UNION_OVERLAP:
  prove(
    [
      @hol|{!s t:A->bool.
         FINITE s /\ FINITE t /\ CARD(s UNION t) < CARD(s) + CARD(t)
         ==> ~(s INTER t = {})}|,
      SIMP_TAC(PairList [GSYM(CARD_UNION_OVERLAP_EQ)]) then_tac ARITH_TAC
    ]
  )

def CARD_IMAGE_INJ:
  prove(
    [
      @hol|{!(f:A->B) s. (!x y. x IN s /\ y IN s /\ (f(x) = f(y)) ==> (x = y)) /\
         FINITE s ==> (CARD (IMAGE f s) = CARD s)}|,
      GEN_TAC then_tac \
      REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{a /\ b ==> c <=> b ==> a ==> c}|
          )
        ]
      ) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [NOT_IN_EMPTY, IMAGE_CLAUSES]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      ASM_SIMP_TAC(PairList [CARD_CLAUSES, FINITE_IMAGE, IN_IMAGE]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_MESON_TAC(PairList [IN_INSERT])
    ]
  )

def HAS_SIZE_IMAGE_INJ:
  prove(
    [
      @hol|{!(f:A->B) s n.
         (!x y. x IN s /\ y IN s /\ (f(x) = f(y)) ==> (x = y)) /\ s HAS_SIZE n
         ==> (IMAGE f s) HAS_SIZE n}|,
      SIMP_TAC(PairList [HAS_SIZE, FINITE_IMAGE]) then_tac \
      MESON_TAC(PairList [CARD_IMAGE_INJ])
    ]
  )

def CARD_IMAGE_LE:
  prove(
    [
      @hol|{!(f:A->B) s. FINITE s ==> CARD(IMAGE f s) <= CARD s}|,
      GEN_TAC then_tac MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [IMAGE_CLAUSES, CARD_CLAUSES, FINITE_IMAGE, LE_REFL]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      COND_CASES_TAC then_tac \
      DISCH_THEN(o(MP_TAC)(CONJUNCT1)) then_tac \
      ARITH_TAC
    ]
  )

def FINITE_CARD_LE_IMAGE:
  prove(
    [
      @hol|{!(f:A->B) s n.
         FINITE s /\ CARD s <= n ==> FINITE(IMAGE f s) /\ CARD(IMAGE f s) <= n}|,
      MESON_TAC(PairList [CARD_IMAGE_LE, LE_TRANS, FINITE_IMAGE])
    ]
  )

def CARD_IMAGE_INJ_EQ:
  prove(
    [
      @hol|{!f:A->B s t.
         FINITE s /\
         (!x. x IN s ==> f(x) IN t) /\
         (!y. y IN t ==> ?!x. x IN s /\ f(x) = y)
         ==> CARD t = CARD s}|,
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{t = IMAGE (f:A->B) s}|
      )(SUBST1_TAC) then_list \
      PairList [
        REWRITE_TAC(PairList [EXTENSION, IN_IMAGE]) then_tac ASM_MESON_TAC(PairList []),
        MATCH_MP_TAC(CARD_IMAGE_INJ) then_tac ASM_MESON_TAC(PairList [])
      ]
    ]
  )

def CARD_SUBSET_IMAGE:
  prove(
    [
      @hol|{!(f:A->B) s t. FINITE t /\ s SUBSET IMAGE f t ==> CARD s <= CARD t}|,
      MESON_TAC(PairList [LE_TRANS, FINITE_IMAGE, CARD_IMAGE_LE, CARD_SUBSET])
    ]
  )

def HAS_SIZE_IMAGE_INJ_EQ:
  prove(
    [
      @hol|{!(f:A->B) s n.
         (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)
         ==> ((IMAGE f s) HAS_SIZE n <=> s HAS_SIZE n)}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [HAS_SIZE]) then_tac \
      MATCH_MP_TAC(
        TAUT(
          @hol|{(a' <=> a) /\ (a ==> (b' <=> b)) ==> (a' /\ b' <=> a /\ b)}|
        )
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        MATCH_MP_TAC(FINITE_IMAGE_INJ_EQ),
        DISCH_TAC then_tac AP_THM_TAC then_tac AP_TERM_TAC then_tac \
        MATCH_MP_TAC(CARD_IMAGE_INJ)
      ] then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def CARD_IMAGE_EQ_INJ:
  prove(
    [
      @hol|{!f:A->B s.
         FINITE s
         ==> (CARD(IMAGE f s) = CARD s <=>
              !x y. x IN s /\ y IN s /\ f x = f y ==> x = y)}|,
      REPEAT(STRIP_TAC) then_tac EQ_TAC then_list \
      PairList [DISCH_TAC, ASM_MESON_TAC(PairList [CARD_IMAGE_INJ])] then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{x:A}|, @hol|{y:A}|]) then_tac \
      STRIP_TAC then_tac \
      ASM_CASES_TAC(@hol|{x:A = y}|) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      UNDISCH_TAC(
        @hol|{CARD(IMAGE (f:A->B) s) = CARD s}|
      ) then_tac \
      SUBGOAL_THEN(
        @hol|{IMAGE  (f:A->B) s = IMAGE f (s DELETE y)}|
      )(SUBST1_TAC) then_list \
      PairList [ASM(SET_TAC)(PairList []), REWRITE_TAC(PairList [])] then_tac \
      MATCH_MP_TAC(
        ARITH_RULE(
          @hol|{!n. m <= n /\ n < p ==> ~(m:num = p)}|
        )
      ) then_tac \
      EXISTS_TAC(
        @hol|{CARD(s DELETE (y:A))}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [CARD_IMAGE_LE, FINITE_DELETE]) then_tac \
      ASM_SIMP_TAC(
        PairList [
          CARD_DELETE,
          CARD_EQ_0,
          ARITH_RULE(
            @hol|{n - 1 < n <=> ~(n = 0)}|
          )
        ]
      ) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def EXISTS_SMALL_SUBSET_IMAGE_INJ:
  prove(
    [
      @hol|{!P (f:A->B) s n.
         (?t. FINITE t /\ CARD t < n /\ t SUBSET IMAGE f s /\ P t) <=>
         (?t. FINITE t /\ CARD t < n /\ t SUBSET s /\
              (!x y. x IN t /\ y IN t ==> (f x = f y <=> x = y)) /\
              P (IMAGE f t))}|,
      ONCE_REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{p /\ q /\ r /\ s <=> r /\ s /\ p /\ q}|
          )
        ]
      ) then_tac \
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [EXISTS_SUBSET_IMAGE_INJ]) then_tac \
      REWRITE_TAC(PairList [CONJ_ASSOC]) then_tac \
      AP_TERM_TAC then_tac \
      ABS_TAC then_tac \
      MATCH_MP_TAC(
        TAUT(
          @hol|{(p ==> (q <=> s)) /\ (p /\ s ==> (r <=> t))
             ==> ((p /\ q) /\ r <=> (p /\ s) /\ t)}|
        )
      ) then_tac \
      MESON_TAC(PairList [CARD_IMAGE_INJ, FINITE_IMAGE_INJ_EQ])
    ]
  )

def FORALL_SMALL_SUBSET_IMAGE_INJ:
  prove(
    [
      @hol|{!P (f:A->B) s n.
         (!t. FINITE t /\ CARD t < n /\ t SUBSET IMAGE f s ==> P t) <=>
         (!t. FINITE t /\ CARD t < n /\ t SUBSET s /\
              (!x y. x IN t /\ y IN t ==> (f x = f y <=> x = y))
              ==> P (IMAGE f t))}|,
      REPEAT(GEN_TAC) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(!t. p t) <=> ~(?t. ~p t)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [NOT_IMP, EXISTS_SMALL_SUBSET_IMAGE_INJ, GSYM(CONJ_ASSOC)])
    ]
  )

def EXISTS_SMALL_SUBSET_IMAGE:
  prove(
    [
      @hol|{!P (f:A->B) s n.
         (?t. FINITE t /\ CARD t < n /\ t SUBSET IMAGE f s /\ P t) <=>
         (?t. FINITE t /\ CARD t < n /\ t SUBSET s /\
              P (IMAGE f t))}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [
        REWRITE_TAC(PairList [EXISTS_SMALL_SUBSET_IMAGE_INJ]) then_tac MESON_TAC(PairList []),
        MESON_TAC(PairList [FINITE_IMAGE, CARD_IMAGE_LE, LET_TRANS, IMAGE_SUBSET])
      ]
    ]
  )

def FORALL_SMALL_SUBSET_IMAGE:
  prove(
    [
      @hol|{!P (f:A->B) s n.
         (!t. FINITE t /\ CARD t < n /\ t SUBSET IMAGE f s ==> P t) <=>
         (!t. FINITE t /\ CARD t < n /\ t SUBSET s ==> P (IMAGE f t))}|,
      REPEAT(GEN_TAC) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(!t. p t) <=> ~(?t. ~p t)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [NOT_IMP, EXISTS_SMALL_SUBSET_IMAGE, GSYM(CONJ_ASSOC)])
    ]
  )

def CARD_IMAGE_LE2:
  prove(
    [
      @hol|{!(f:A->B) (g:A->C) s.
         FINITE s /\
         (!x y. x IN s /\ y IN s /\ g x = g y ==> f x = f y)
         ==> CARD(IMAGE f s) <= CARD(IMAGE g s)}|,
      REPEAT(STRIP_TAC) then_tac \
      FIRST_X_ASSUM(
        o(X_CHOOSE_TAC(@hol|{h:C->B}|))(GEN_REWRITE_RULE(I)(PairList [FUNCTION_FACTORS_LEFT_GEN]))
      ) then_tac \
      TRANS_TAC(LE_TRANS)(
        @hol|{CARD(IMAGE ((h:C->B) o (g:A->C)) s)}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [IMAGE_o, CARD_IMAGE_LE, FINITE_IMAGE]) then_tac \
      MATCH_MP_TAC(EQ_IMP_LE) then_tac \
      AP_TERM_TAC then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def CARD_IMAGE_LT2:
  prove(
    [
      @hol|{!(f:A->B) (g:A->C) s.
         FINITE s /\
         (!x y. x IN s /\ y IN s /\ g x = g y ==> f x = f y) /\
         ~(!x y. x IN s /\ y IN s /\ f x = f y ==> g x = g y)
         ==> CARD(IMAGE f s) < CARD(IMAGE g s)}|,
      REPEAT(STRIP_TAC) then_tac \
      FIRST_X_ASSUM(
        o(X_CHOOSE_TAC(@hol|{h:C->B}|))(GEN_REWRITE_RULE(I)(PairList [FUNCTION_FACTORS_LEFT_GEN]))
      ) then_tac \
      SUBGOAL_THEN(
        @hol|{IMAGE f s = IMAGE (h:C->B) (IMAGE (g:A->C) s)}|
      )(SUBST1_TAC) then_list \
      PairList [ASM(SET_TAC)(PairList []), ALL_TAC] then_tac \
      ASM_SIMP_TAC(PairList [LT_LE, CARD_IMAGE_LE, FINITE_IMAGE, CARD_IMAGE_EQ_INJ]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def CHOOSE_SUBSET_STRONG:
  prove(
    [
      @hol|{!n s:A->bool.
         (FINITE s ==> n <= CARD s) ==> ?t. t SUBSET s /\ t HAS_SIZE n}|,
      INDUCT_TAC then_tac REWRITE_TAC(PairList [HAS_SIZE_0, HAS_SIZE_SUC]) then_list \
      PairList [MESON_TAC(PairList [EMPTY_SUBSET]), ALL_TAC] then_tac \
      MATCH_MP_TAC(SET_PROVE_CASES) then_tac \
      REWRITE_TAC(
        PairList [
          FINITE_EMPTY,
          CARD_CLAUSES,
          ARITH_RULE(
            @hol|{~(SUC n <= 0)}|
          )
        ]
      ) then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{a:A}|, @hol|{s:A->bool}|]) then_tac \
      DISCH_TAC then_tac \
      ASM_SIMP_TAC(PairList [CARD_CLAUSES, FINITE_INSERT, LE_SUC]) then_tac \
      DISCH_TAC then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(SPEC(@hol|{s:A->bool}|))) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{t:A->bool}|)(STRIP_ASSUME_TAC)) then_tac \
      EXISTS_TAC(
        @hol|{(a:A) INSERT t}|
      ) then_tac \
      REPEAT(CONJ_TAC then_list PairList [ASM(SET_TAC)(PairList []), ALL_TAC]) then_tac \
      RULE_ASSUM_TAC(REWRITE_RULE(PairList [HAS_SIZE])) then_tac \
      ASM_SIMP_TAC(PairList [HAS_SIZE, CARD_DELETE, FINITE_INSERT, FINITE_DELETE, CARD_CLAUSES]) then_tac \
      GEN_TAC then_tac \
      COND_CASES_TAC then_tac \
      REWRITE_TAC(PairList [SUC_SUB1]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def CHOOSE_SUBSET_EQ:
  prove(
    [
      @hol|{!n s:A->bool.
         (FINITE s ==> n <= CARD s) <=> (?t. t SUBSET s /\ t HAS_SIZE n)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac \
      REWRITE_TAC(PairList [CHOOSE_SUBSET_STRONG]) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{t:A->bool}|)(STRIP_ASSUME_TAC)) then_tac \
      DISCH_TAC then_tac \
      TRANS_TAC(LE_TRANS)(
        @hol|{CARD(t:A->bool)}|
      ) then_tac \
      ASM_MESON_TAC(PairList [CARD_SUBSET, HAS_SIZE, LE_REFL])
    ]
  )

def CHOOSE_SUBSET:
  prove(
    [
      @hol|{!s:A->bool. FINITE s ==> !n. n <= CARD s ==> ?t. t SUBSET s /\ t HAS_SIZE n}|,
      MESON_TAC(PairList [CHOOSE_SUBSET_STRONG])
    ]
  )

def CHOOSE_SUBSET_BETWEEN:
  prove(
    [
      @hol|{!n s u:A->bool.
         s SUBSET u /\ FINITE s /\ CARD s <= n /\ (FINITE u ==> n <= CARD u)
         ==> ?t. s SUBSET t /\ t SUBSET u /\ t HAS_SIZE n}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{n - CARD(s:A->bool)}|,
            @hol|{u DIFF s:A->bool}|
          ])(
          CHOOSE_SUBSET_STRONG
        )
      ) then_tac \
      ANTS_TAC then_list \
      PairList [
        ASM_CASES_TAC(
          @hol|{FINITE(u:A->bool)}|
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            CARD_DIFF,
            ARITH_RULE(
              @hol|{n:num <= m ==> n - x <= m - x}|
            )
          ]
        ) then_tac \
        MATCH_MP_TAC(
          TAUT(@hol|{~p ==> p ==> q}|)
        ) then_tac \
        ASM_MESON_TAC(
          PairList [
            FINITE_UNION,
            FINITE_SUBSET,
            SET_RULE(
              @hol|{u SUBSET (u DIFF s) UNION s}|
            )
          ]
        ),
        DISCH_THEN(X_CHOOSE_THEN(@hol|{t:A->bool}|)(STRIP_ASSUME_TAC)) then_tac \
        EXISTS_TAC(
          @hol|{s UNION t:A->bool}|
        ) then_tac \
        REPEAT(CONJ_TAC then_list PairList [ASM(SET_TAC)(PairList []), ALL_TAC]) then_tac \
        SUBGOAL_THEN(
          @hol|{n:num = CARD(s) + (n - CARD(s:A->bool))}|
        )(SUBST1_TAC) then_list \
        PairList [ASM_ARITH_TAC, MATCH_MP_TAC(HAS_SIZE_UNION)] then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        ASM_REWRITE_TAC(PairList [HAS_SIZE]) then_tac \
        ASM(SET_TAC)(PairList [])
      ]
    ]
  )

def CARD_LE_UNIONS_CHAIN:
  prove(
    [
      @hol|{!(f:(A->bool)->bool) n.
         (!t u. t IN f /\ u IN f ==> t SUBSET u \/ u SUBSET t) /\
         (!t. t IN f ==> FINITE t /\ CARD t <= n)
         ==> FINITE(UNIONS f) /\ CARD(UNIONS f) <= n}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{f:(A->bool)->bool = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [UNIONS_0, FINITE_EMPTY, CARD_CLAUSES, LE_0]) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC)) then_tac \
      GEN_REWRITE_TAC(I)(PairList [GSYM(CONTRAPOS_THM)]) then_tac \
      REWRITE_TAC(
        PairList [
          NOT_FORALL_THM,
          NOT_IMP,
          TAUT(
            @hol|{~(p /\ q) <=> p ==> ~q}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            @hol|{~(x <= n) <=> SUC n <= x}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [CHOOSE_SUBSET_EQ]) then_tac \
      REWRITE_TAC(PairList [RIGHT_AND_EXISTS_THM]) then_tac \
      ONCE_REWRITE_TAC(PairList [SWAP_EXISTS_THM]) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      X_GEN_TAC(@hol|{s:A->bool}|) then_tac \
      REWRITE_TAC(PairList [HAS_SIZE]) then_tac \
      STRIP_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      MATCH_MP_TAC(FINITE_SUBSET_UNIONS_CHAIN) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def CARD_LE_1:
  prove(
    [
      @hol|{!s:A->bool. FINITE s /\ CARD s <= 1 <=> ?a. s SUBSET {a}}|,
      GEN_TAC then_tac \
      REWRITE_TAC(
        PairList [
          ARITH_RULE(
            @hol|{c <= 1 <=> c = 0 \/ c = 1}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [LEFT_OR_DISTRIB, GSYM(HAS_SIZE)]) then_tac \
      CONV_TAC(ONCE_DEPTH_CONV(HAS_SIZE_CONV)) then_tac \
      SET_TAC(PairList [])
    ]
  )

def INVOLUTION_EVEN_NOFIXPOINTS:
  prove(
    [
      @hol|{!f (s:A->bool).
         FINITE s /\ (!x. x IN s ==> f x IN s /\ ~(f x = x) /\ f(f x) = x)
         ==> EVEN(CARD s)}|,
      REPEAT(GEN_TAC) then_tac \
      ABBREV_TAC(
        @hol|{n = CARD(s:A->bool)}|
      ) then_tac \
      POP_ASSUM(MP_TAC) then_tac \
      REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{p ==> q /\ r ==> s <=> (q /\ p) /\ r ==> s}|
          )
        ]
      ) then_tac \
      MAP_EVERY((fun(t): SPEC_TAC([t, t])))(PairList [@hol|{s:A->bool}|, @hol|{n:num}|]) then_tac \
      MATCH_MP_TAC(num_WF) then_tac \
      X_GEN_TAC(@hol|{n:num}|) then_tac \
      DISCH_TAC then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [ARITH]) then_tac \
      MATCH_MP_TAC(SET_PROVE_CASES) then_tac \
      ASM_REWRITE_TAC(PairList [CARD_CLAUSES]) then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{a:A}|, @hol|{s:A->bool}|]) then_tac \
      SIMP_TAC(PairList [FINITE_INSERT, IMP_CONJ, CARD_CLAUSES, FORALL_IN_INSERT]) then_tac \
      REWRITE_TAC(PairList [IN_INSERT]) then_tac \
      ASM_CASES_TAC(
        @hol|{f(a:A) = a}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 1}|
      ) then_tac \
      ASM_SIMP_TAC(
        PairList [
          ARITH_RULE(
            @hol|{SUC n = 1 <=> n = 0}|
          ),
          CARD_EQ_0,
          NOT_IN_EMPTY
        ]
      ) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPEC(
            @hol|{n - 2}|
          )
        )
      ) then_tac \
      ANTS_TAC then_list \
      PairList [ASM_ARITH_TAC, ALL_TAC] then_tac \
      DISCH_THEN(
        o(MP_TAC)(
          SPEC(
            @hol|{s DELETE (f:A->A) a}|
          )
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_DELETE, CARD_DELETE, EVEN_SUB, ARITH]) then_tac \
      ASM_REWRITE_TAC(
        PairList [
          ARITH_RULE(
            @hol|{n <= 2 <=> n = 0 \/ n = 1 \/ n = 2}|
          )
        ]
      ) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 2}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [ARITH]) then_tac \
      DISCH_THEN(MATCH_MP_TAC) then_tac \
      CONJ_TAC then_list \
      PairList [ASM_ARITH_TAC, ASM(SET_TAC)(PairList [])]
    ]
  )

def INVOLUTION_EVEN_FIXPOINTS:
  prove(
    [
      @hol|{!f (s:A->bool).
         FINITE s /\ (!x. x IN s ==> f x IN s /\ f(f x) = x)
         ==> (EVEN(CARD {x | x IN s /\ f x = x}) <=> EVEN(CARD s))}|,
      REPEAT(STRIP_TAC) then_tac \
      TRANS_TAC(EQ_TRANS)(
        @hol|{EVEN(CARD({x:A | x IN s /\ f x = x} UNION {x | x IN s /\ ~(f x = x)}))}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        ALL_TAC,
        AP_TERM_TAC then_tac AP_TERM_TAC then_tac SET_TAC(PairList [])
      ] then_tac \
      ASM_SIMP_TAC(
        PairList [
          EVEN_ADD,
          CARD_UNION,
          FINITE_RESTRICT,
          SET_RULE(
            @hol|{{x | x IN s /\ P x} INTER {x | x IN s /\ ~P x} = {}}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          TAUT(@hol|{(p <=> (p <=> q)) <=> q}|)
        ]
      ) then_tac \
      MATCH_MP_TAC(INVOLUTION_EVEN_NOFIXPOINTS) then_tac \
      EXISTS_TAC(@hol|{f:A->A}|) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_RESTRICT]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def HAS_SIZE_PRODUCT_DEPENDENT:
  prove(
    [
      @hol|{!s m t n.
         s HAS_SIZE m /\ (!x. x IN s ==> t(x) HAS_SIZE n)
         ==> {(x:A,y:B) | x IN s /\ y IN t(x)} HAS_SIZE (m * n)}|,
      GEN_REWRITE_TAC(o(funpow(4)(BINDER_CONV))(funpow(2)(LAND_CONV)))(PairList [HAS_SIZE]) then_tac \
      REWRITE_TAC(PairList [IMP_CONJ, RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      SIMP_TAC(PairList [CARD_CLAUSES, NOT_IN_EMPTY, IN_INSERT]) then_tac \
      CONJ_TAC then_list \
      PairList [
        GEN_TAC then_tac DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
        REWRITE_TAC(PairList [MULT_CLAUSES, HAS_SIZE_0]) then_tac \
        SET_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{x:A}|, @hol|{s:A->bool}|]) then_tac \
      STRIP_TAC then_tac \
      X_GEN_TAC(@hol|{m:num}|) then_tac \
      DISCH_THEN(o(ASSUME_TAC)(SYM)) then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{t:A->B->bool}|,
          @hol|{n:num}|
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{a \/ b ==> c <=> (a ==> c) /\ (b ==> c)}|
          )
        ]
      ) then_tac \
      SIMP_TAC(PairList [FORALL_AND_THM, LEFT_FORALL_IMP_THM, EXISTS_REFL]) then_tac \
      STRIP_TAC then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPEC(
            @hol|{CARD(s:A->bool)}|
          )
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [MULT_CLAUSES]) then_tac \
      DISCH_TAC then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{{(x,y) | (x = a \/ x IN s) /\ y IN t(x)} =
               {(x,y) | x IN s /\ y IN t(x)} UNION
               IMAGE (\y. (a,y)) (t a)}|
          )
        ]
      ) then_tac \
      MATCH_MP_TAC(HAS_SIZE_UNION) then_tac \
      ASM_SIMP_TAC(PairList [HAS_SIZE_IMAGE_INJ, PAIR_EQ]) then_tac \
      REWRITE_TAC(
        PairList [
          DISJOINT,
          IN_IMAGE,
          IN_ELIM_THM,
          IN_INTER,
          EXTENSION,
          NOT_IN_EMPTY,
          EXISTS_PAIR_THM,
          PAIR_EQ
        ]
      ) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      ASM_MESON_TAC(PairList [PAIR_EQ])
    ]
  )

def FINITE_PRODUCT_DEPENDENT:
  prove(
    [
      @hol|{!f:A->B->C s t.
         FINITE s /\ (!x. x IN s ==> FINITE(t x))
         ==> FINITE {f x y | x IN s /\ y IN (t x)}}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(FINITE_SUBSET) then_tac \
      EXISTS_TAC(
        @hol|{IMAGE (\(x,y). (f:A->B->C) x y) {x,y | x IN s /\ y IN t x}}|
      ) then_tac \
      REWRITE_TAC(PairList [SUBSET, IN_IMAGE, EXISTS_PAIR_THM, IN_ELIM_PAIR_THM]) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_GSPEC]) then_tac \
      CONJ_TAC then_list \
      PairList [MATCH_MP_TAC(FINITE_IMAGE), MESON_TAC(PairList [])] then_tac \
      MAP_EVERY(UNDISCH_TAC)(
        PairList [
          @hol|{!x:A. x IN s ==> FINITE(t x :B->bool)}|,
          @hol|{FINITE(s:A->bool)}|
        ]
      ) then_tac \
      MAP_EVERY((fun(t): SPEC_TAC([t, t])))(
        PairList [
          @hol|{t:A->B->bool}|,
          @hol|{s:A->bool}|
        ]
      ) then_tac \
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      CONJ_TAC then_list \
      PairList [
        GEN_TAC then_tac \
        SUBGOAL_THEN(
          @hol|{{(x:A,y:B) | x IN {} /\ y IN (t x)} = {}}|
        )((fun(th): REWRITE_TAC(PairList [th, sets_FINITE_RULES_v2]))) then_tac \
        REWRITE_TAC(PairList [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY]),
        ALL_TAC
      ] then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{a:A}|, @hol|{s:A->bool}|]) then_tac \
      STRIP_TAC then_tac \
      X_GEN_TAC(@hol|{t:A->B->bool}|) then_tac \
      SUBGOAL_THEN(
        @hol|{{(x:A,y:B) | x IN (a INSERT s) /\ y IN (t x)} =
           IMAGE (\y. a,y) (t a) UNION {(x,y) | x IN s /\ y IN (t x)}}|
      )((fun(th): ASM_SIMP_TAC(PairList [IN_INSERT, FINITE_IMAGE, FINITE_UNION, th]))) then_tac \
      REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, IN_ELIM_THM, IN_INSERT, IN_UNION]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def FINITE_PRODUCT:
  prove(
    [
      @hol|{!s t. FINITE s /\ FINITE t ==> FINITE {(x:A,y:B) | x IN s /\ y IN t}}|,
      SIMP_TAC(PairList [FINITE_PRODUCT_DEPENDENT])
    ]
  )

def CARD_PRODUCT:
  prove(
    [
      @hol|{!s t. FINITE s /\ FINITE t
         ==> (CARD {(x:A,y:B) | x IN s /\ y IN t} = CARD s * CARD t)}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        SPECL(
          PairList [
            @hol|{s:A->bool}|,
            @hol|{CARD(s:A->bool)}|,
            @hol|{\x:A. t:B->bool}|,
            @hol|{CARD(t:B->bool)}|
          ])(
          HAS_SIZE_PRODUCT_DEPENDENT
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [HAS_SIZE])
    ]
  )

def HAS_SIZE_PRODUCT:
  prove(
    [
      @hol|{!s m t n. s HAS_SIZE m /\ t HAS_SIZE n
         ==> {(x:A,y:B) | x IN s /\ y IN t} HAS_SIZE (m * n)}|,
      SIMP_TAC(PairList [HAS_SIZE, CARD_PRODUCT, FINITE_PRODUCT])
    ]
  )

Host.parse_as_infix(["CROSS", [22, "right"]])

def CROSS:
  new_definition(
    @hol|{(s:A->bool) CROSS (t:B->bool) = {x,y | x IN s /\ y IN t}}|
  )

def IN_CROSS:
  prove(
    [
      @hol|{!(x:A) (y:B) s t. (x,y) IN (s CROSS t) <=> x IN s /\ y IN t}|,
      REWRITE_TAC(PairList [CROSS, IN_ELIM_PAIR_THM])
    ]
  )

def HAS_SIZE_CROSS:
  prove(
    [
      @hol|{!(s:A->bool) (t:B->bool) m n.
         s HAS_SIZE m /\ t HAS_SIZE n ==> (s CROSS t) HAS_SIZE (m * n)}|,
      REWRITE_TAC(PairList [CROSS, HAS_SIZE_PRODUCT])
    ]
  )

def FINITE_CROSS:
  prove(
    [
      @hol|{!(s:A->bool) (t:B->bool). FINITE s /\ FINITE t ==> FINITE(s CROSS t)}|,
      SIMP_TAC(PairList [CROSS, FINITE_PRODUCT])
    ]
  )

def CARD_CROSS:
  prove(
    [
      @hol|{!(s:A->bool) (t:B->bool). FINITE s /\ FINITE t ==> CARD(s CROSS t) = CARD s * CARD t}|,
      SIMP_TAC(PairList [CROSS, CARD_PRODUCT])
    ]
  )

def CROSS_EQ_EMPTY:
  prove(
    [
      @hol|{!(s:A->bool) (t:B->bool). s CROSS t = {} <=> s = {} \/ t = {}}|,
      REWRITE_TAC(PairList [EXTENSION, FORALL_PAIR_THM, IN_CROSS, NOT_IN_EMPTY]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def CROSS_EMPTY:
  prove(
    [
      @hol|{(!s:A->bool. s CROSS {} = {}) /\ (!t:B->bool. {} CROSS t = {})}|,
      REWRITE_TAC(PairList [CROSS_EQ_EMPTY])
    ]
  )

def CROSS_SING:
  prove(
    [
      @hol|{!x:A y:B. {x} CROSS {y} = {(x,y)}}|,
      REWRITE_TAC(PairList [EXTENSION, FORALL_PAIR_THM, IN_SING, IN_CROSS, PAIR_EQ])
    ]
  )

def CROSS_UNIV:
  prove(
    [
      @hol|{(:A) CROSS (:B) = (:A#B)}|,
      REWRITE_TAC(PairList [CROSS, EXTENSION, IN_ELIM_PAIR_THM, FORALL_PAIR_THM, IN_UNIV])
    ]
  )

def FINITE_CROSS_EQ:
  prove(
    [
      @hol|{!s:A->bool t:B->bool.
         FINITE(s CROSS t) <=> s = {} \/ t = {} \/ FINITE s /\ FINITE t}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{s:A->bool = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [CROSS_EMPTY, FINITE_EMPTY]) then_tac \
      ASM_CASES_TAC(
        @hol|{t:B->bool = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [CROSS_EMPTY, FINITE_EMPTY]) then_tac \
      EQ_TAC then_tac \
      REWRITE_TAC(PairList [FINITE_CROSS]) then_tac \
      REPEAT(STRIP_TAC) then_list \
      PairList [
        FIRST_ASSUM(
          o(MP_TAC)(
            MATCH_MP(
              ISPEC(
                @hol|{FST:A#B->A}|)(
                FINITE_IMAGE
              )
            )
          )
        ),
        FIRST_ASSUM(
          o(MP_TAC)(
            MATCH_MP(
              ISPEC(
                @hol|{SND:A#B->B}|)(
                FINITE_IMAGE
              )
            )
          )
        )
      ] then_tac \
      MATCH_MP_TAC(REWRITE_RULE(PairList [IMP_CONJ_ALT])(FINITE_SUBSET)) then_tac \
      REWRITE_TAC(PairList [SUBSET, IN_IMAGE, EXISTS_PAIR_THM, IN_CROSS]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def INFINITE_CROSS_EQ:
  prove(
    [
      @hol|{!(s:A->bool) (t:B->bool).
         INFINITE(s CROSS t) <=>
         ~(s = {}) /\ INFINITE t \/ INFINITE s /\ ~(t = {})}|,
      REWRITE_TAC(PairList [INFINITE, FINITE_CROSS_EQ]) then_tac \
      MESON_TAC(PairList [FINITE_EMPTY])
    ]
  )

def FINITE_CROSS_UNIV:
  prove(
    [
      @hol|{FINITE(:A#B) <=> FINITE(:A) /\ FINITE(:B)}|,
      REWRITE_TAC(PairList [GSYM(CROSS_UNIV), FINITE_CROSS_EQ, UNIV_NOT_EMPTY])
    ]
  )

def INFINITE_CROSS_UNIV:
  prove(
    [
      @hol|{INFINITE(:A#B) <=> INFINITE(:A) \/ INFINITE(:B)}|,
      REWRITE_TAC(PairList [GSYM(CROSS_UNIV), INFINITE_CROSS_EQ, UNIV_NOT_EMPTY]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def FINITE_UNIV_PAIR:
  prove(
    [
      @hol|{FINITE(:A#A) <=> FINITE(:A)}|,
      REWRITE_TAC(PairList [FINITE_CROSS_UNIV])
    ]
  )

def INFINITE_UNIV_PAIR:
  prove(
    [
      @hol|{INFINITE(:A#A) <=> INFINITE(:A)}|,
      REWRITE_TAC(PairList [INFINITE_CROSS_UNIV])
    ]
  )

def FORALL_IN_CROSS:
  prove(
    [
      @hol|{!P s t. (!z:A#B. z IN s CROSS t ==> P z) <=>
         (!x y. x IN s /\ y IN t ==> P(x,y))}|,
      REWRITE_TAC(PairList [FORALL_PAIR_THM, IN_CROSS])
    ]
  )

def EXISTS_IN_CROSS:
  prove(
    [
      @hol|{!P s t. (?z:A#B. z IN s CROSS t /\ P z) <=>
         (?x y. x IN s /\ y IN t /\ P(x,y))}|,
      REWRITE_TAC(PairList [EXISTS_PAIR_THM, GSYM(CONJ_ASSOC), IN_CROSS])
    ]
  )

def SUBSET_CROSS:
  prove(
    [
      @hol|{!(s:A->bool) (t:B->bool) s' t'.
         s CROSS t SUBSET s' CROSS t' <=>
         s = {} \/ t = {} \/ s SUBSET s' /\ t SUBSET t'}|,
      SIMP_TAC(
        PairList [
          CROSS,
          EXTENSION,
          IN_ELIM_PAIR_THM,
          SUBSET,
          FORALL_PAIR_THM,
          IN_CROSS,
          NOT_IN_EMPTY
        ]
      ) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def CROSS_MONO:
  prove(
    [
      @hol|{!(s:A->bool) (t:B->bool) s' t'. s SUBSET s' /\ t SUBSET t' ==> s CROSS t SUBSET s' CROSS t'}|,
      SIMP_TAC(PairList [SUBSET_CROSS])
    ]
  )

def CROSS_EQ:
  prove(
    [
      @hol|{!s s':A->bool t t':B->bool.
         s CROSS t = s' CROSS t' <=>
         (s = {} \/ t = {}) /\ (s' = {} \/ t' = {}) \/ s = s' /\ t = t'}|,
      REWRITE_TAC(PairList [GSYM(SUBSET_ANTISYM_EQ), SUBSET_CROSS]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def IMAGE_FST_CROSS:
  prove(
    [
      @hol|{!s:A->bool t:B->bool.
         IMAGE FST (s CROSS t) = if t = {} then {} else s}|,
      REPEAT(GEN_TAC) then_tac COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [CROSS_EMPTY, IMAGE_CLAUSES]) then_tac \
      REWRITE_TAC(PairList [EXTENSION, IN_IMAGE]) then_tac \
      ONCE_REWRITE_TAC(PairList [CONJ_SYM]) then_tac \
      REWRITE_TAC(PairList [EXISTS_IN_CROSS, FST]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def IMAGE_SND_CROSS:
  prove(
    [
      @hol|{!s:A->bool t:B->bool.
         IMAGE SND (s CROSS t) = if s = {} then {} else t}|,
      REPEAT(GEN_TAC) then_tac COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [CROSS_EMPTY, IMAGE_CLAUSES]) then_tac \
      REWRITE_TAC(PairList [EXTENSION, IN_IMAGE]) then_tac \
      ONCE_REWRITE_TAC(PairList [CONJ_SYM]) then_tac \
      REWRITE_TAC(PairList [EXISTS_IN_CROSS, SND]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def IMAGE_PAIRED_CROSS:
  prove(
    [
      @hol|{!(f:A->B) (g:C->D) s t.
         IMAGE (\(x,y). f x,g y) (s CROSS t) = (IMAGE f s) CROSS (IMAGE g t)}|,
      REWRITE_TAC(
        PairList [
          EXTENSION,
          IN_IMAGE,
          EXISTS_PAIR_THM,
          IN_CROSS,
          FORALL_PAIR_THM,
          PAIR_EQ
        ]
      ) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def CROSS_INTER:
  prove(
    [
      @hol|{(!(s:A->bool) (t:B->bool) u.
              s CROSS (t INTER u) = (s CROSS t) INTER (s CROSS u)) /\
         (!(s:A->bool) t (u:B->bool).
              (s INTER t) CROSS u = (s CROSS u) INTER (t CROSS u))}|,
      REWRITE_TAC(PairList [EXTENSION, FORALL_PAIR_THM, IN_INTER, IN_CROSS]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      CONV_TAC(TAUT)
    ]
  )

def CROSS_UNION:
  prove(
    [
      @hol|{(!(s:A->bool) (t:B->bool) u.
              s CROSS (t UNION u) = (s CROSS t) UNION (s CROSS u)) /\
         (!(s:A->bool) t (u:B->bool).
              (s UNION t) CROSS u = (s CROSS u) UNION (t CROSS u))}|,
      REWRITE_TAC(PairList [EXTENSION, FORALL_PAIR_THM, IN_UNION, IN_CROSS]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      CONV_TAC(TAUT)
    ]
  )

def CROSS_DIFF:
  prove(
    [
      @hol|{(!(s:A->bool) (t:B->bool) u.
              s CROSS (t DIFF u) = (s CROSS t) DIFF (s CROSS u)) /\
         (!(s:A->bool) t (u:B->bool).
              (s DIFF t) CROSS u = (s CROSS u) DIFF (t CROSS u))}|,
      REWRITE_TAC(PairList [EXTENSION, FORALL_PAIR_THM, IN_DIFF, IN_CROSS]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      CONV_TAC(TAUT)
    ]
  )

def INTER_CROSS:
  prove(
    [
      @hol|{!(s:A->bool) s' (t:B->bool) t'.
         (s CROSS t) INTER (s' CROSS t') = (s INTER s') CROSS (t INTER t')}|,
      REWRITE_TAC(PairList [EXTENSION, IN_INTER, FORALL_PAIR_THM, IN_CROSS]) then_tac \
      CONV_TAC(TAUT)
    ]
  )

def [sets_CROSS_UNIONS_UNIONS_v2, CROSS_UNIONS]:
  o(CONJ_PAIR)(prove)(
    [
      @hol|{(!(f:(A->bool)->bool) (g:(B->bool)->bool).
              (UNIONS f) CROSS (UNIONS g) =
              UNIONS {s CROSS t | s IN f /\ t IN g}) /\
         (!(s:A->bool) (f:(A->bool)->bool).
              s CROSS (UNIONS f) = UNIONS {s CROSS t | t IN f}) /\
         (!(f:(A->bool)->bool) (t:B->bool).
              (UNIONS f) CROSS t = UNIONS {s CROSS t | s IN f})}|,
      REWRITE_TAC(PairList [UNIONS_GSPEC, EXTENSION, FORALL_PAIR_THM, IN_ELIM_THM, IN_CROSS]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def [sets_CROSS_INTERS_INTERS_v2, CROSS_INTERS]:
  o(CONJ_PAIR)(prove)(
    [
      @hol|{(!(f:(A->bool)->bool) (g:(B->bool)->bool).
              (INTERS f) CROSS (INTERS g) =
              if f = {} then INTERS {UNIV CROSS t | t IN g}
              else if g = {} then INTERS {s CROSS UNIV | s IN f}
              else INTERS {s CROSS t | s IN f /\ t IN g}) /\
         (!(s:A->bool) (f:(A->bool)->bool).
              s CROSS (INTERS f) =
              if f = {} then s CROSS UNIV else INTERS {s CROSS t | t IN f}) /\
         (!(f:(A->bool)->bool) (t:B->bool).
              (INTERS f) CROSS t =
              if f = {} then UNIV CROSS t else INTERS {s CROSS t | s IN f})}|,
      REPEAT(STRIP_TAC) then_tac \
      REPEAT(COND_CASES_TAC then_tac REWRITE_TAC(PairList [])) then_tac \
      ASM_REWRITE_TAC(
        PairList [INTERS_GSPEC, EXTENSION, FORALL_PAIR_THM, IN_ELIM_THM, IN_CROSS, NOT_IN_EMPTY]
      ) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def DISJOINT_CROSS:
  prove(
    [
      @hol|{!s:A->bool t:B->bool s' t'.
         DISJOINT (s CROSS t) (s' CROSS t') <=>
         DISJOINT s s' \/ DISJOINT t t'}|,
      REWRITE_TAC(PairList [DISJOINT, INTER_CROSS, CROSS_EQ_EMPTY])
    ]
  )

def ARB:
  new_definition(
    @hol|{ARB = (@x:A. F)}|
  )

def EXTENSIONAL:
  new_definition(
    @hol|{EXTENSIONAL s = {f:A->B | !x. ~(x IN s) ==> f x = ARB}}|
  )

def IN_EXTENSIONAL:
  prove(
    [
      @hol|{!s f:A->B. f IN EXTENSIONAL s <=> (!x. ~(x IN s) ==> f x = ARB)}|,
      REWRITE_TAC(PairList [EXTENSIONAL, IN_ELIM_THM])
    ]
  )

def IN_EXTENSIONAL_UNDEFINED:
  prove(
    [
      @hol|{!s f:A->B x. f IN EXTENSIONAL s /\ ~(x IN s) ==> f x = ARB}|,
      SIMP_TAC(PairList [IN_EXTENSIONAL])
    ]
  )

def EXTENSIONAL_EMPTY:
  prove(
    [
      @hol|{EXTENSIONAL {} = {\x:A. ARB:B}}|,
      REWRITE_TAC(PairList [EXTENSION, IN_EXTENSIONAL, IN_SING, NOT_IN_EMPTY]) then_tac \
      REWRITE_TAC(PairList [FUN_EQ_THM])
    ]
  )

def EXTENSIONAL_UNIV:
  prove(
    [
      @hol|{!f:A->B. EXTENSIONAL (:A) f}|,
      REWRITE_TAC(PairList [EXTENSIONAL, IN_UNIV, IN_ELIM_THM])
    ]
  )

def EXTENSIONAL_EQ:
  prove(
    [
      @hol|{!s f g:A->B.
         f IN EXTENSIONAL s /\ g IN EXTENSIONAL s /\ (!x. x IN s ==> f x = g x)
         ==> f = g}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
      GEN_TAC then_tac \
      ASM_CASES_TAC(
        @hol|{x:A IN s}|
      ) then_list \
      PairList [
        ASM_SIMP_TAC(PairList []),
        ASM_MESON_TAC(PairList [IN_EXTENSIONAL_UNDEFINED])
      ]
    ]
  )

def RESTRICTION:
  new_definition(
    @hol|{RESTRICTION s (f:A->B) x = if x IN s then f x else ARB}|
  )

def RESTRICTION_THM:
  prove(
    [
      @hol|{!s (f:A->B). RESTRICTION s f = \x. if x IN s then f x else ARB}|,
      REWRITE_TAC(PairList [FUN_EQ_THM, RESTRICTION])
    ]
  )

def RESTRICTION_DEFINED:
  prove(
    [
      @hol|{!s f:A->B x. x IN s ==> RESTRICTION s f x = f x}|,
      SIMP_TAC(PairList [RESTRICTION])
    ]
  )

def RESTRICTION_UNDEFINED:
  prove(
    [
      @hol|{!s f:A->B x. ~(x IN s) ==> RESTRICTION s f x = ARB}|,
      SIMP_TAC(PairList [RESTRICTION])
    ]
  )

def RESTRICTION_EQ:
  prove(
    [
      @hol|{!s f:A->B x y. x IN s /\ f x = y ==> RESTRICTION s f x = y}|,
      SIMP_TAC(PairList [RESTRICTION_DEFINED])
    ]
  )

def RESTRICTION_IN_EXTENSIONAL:
  prove(
    [
      @hol|{!s f:A->B. RESTRICTION s f IN EXTENSIONAL s}|,
      SIMP_TAC(PairList [IN_EXTENSIONAL, RESTRICTION])
    ]
  )

def RESTRICTION_EXTENSION:
  prove(
    [
      @hol|{!s f g:A->B. RESTRICTION s f = RESTRICTION s g <=>
         (!x. x IN s ==> f x = g x)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [RESTRICTION, FUN_EQ_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def RESTRICTION_FIXPOINT:
  prove(
    [
      @hol|{!s f:A->B. RESTRICTION s f = f <=> f IN EXTENSIONAL s}|,
      REWRITE_TAC(PairList [IN_EXTENSIONAL, FUN_EQ_THM, RESTRICTION]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def RESTRICTION_UNIV:
  prove(
    [
      @hol|{!f:A->B. RESTRICTION UNIV f = f}|,
      REWRITE_TAC(PairList [FUN_EQ_THM, RESTRICTION, IN_UNIV])
    ]
  )

def RESTRICTION_RESTRICTION:
  prove(
    [
      @hol|{!s t f:A->B.
         s SUBSET t ==> RESTRICTION s (RESTRICTION t f) = RESTRICTION s f}|,
      REWRITE_TAC(PairList [FUN_EQ_THM, RESTRICTION]) then_tac SET_TAC(PairList [])
    ]
  )

def RESTRICTION_IDEMP:
  prove(
    [
      @hol|{!s f:A->B. RESTRICTION s (RESTRICTION s f) = RESTRICTION s f}|,
      REWRITE_TAC(PairList [RESTRICTION_FIXPOINT, RESTRICTION_IN_EXTENSIONAL])
    ]
  )

def IMAGE_RESTRICTION:
  prove(
    [
      @hol|{!f:A->B s t. s SUBSET t ==> IMAGE (RESTRICTION t f) s = IMAGE f s}|,
      REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, RESTRICTION]) then_tac SET_TAC(PairList [])
    ]
  )

def RESTRICTION_COMPOSE_RIGHT:
  prove(
    [
      @hol|{!f:A->B g:B->C s.
         RESTRICTION s (g o RESTRICTION s f) =
         RESTRICTION s (g o f)}|,
      REWRITE_TAC(PairList [FUN_EQ_THM, o_DEF, RESTRICTION]) then_tac \
      SIMP_TAC(PairList [SUBSET, FORALL_IN_IMAGE]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def RESTRICTION_COMPOSE_LEFT:
  prove(
    [
      @hol|{!f:A->B g:B->C s t.
         IMAGE f s SUBSET t
         ==> RESTRICTION s (RESTRICTION t g o f) =
             RESTRICTION s (g o f)}|,
      REWRITE_TAC(PairList [FUN_EQ_THM, o_DEF, RESTRICTION]) then_tac \
      SIMP_TAC(PairList [SUBSET, FORALL_IN_IMAGE]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def RESTRICTION_COMPOSE:
  prove(
    [
      @hol|{!f:A->B g:B->C s t.
         IMAGE f s SUBSET t
         ==> RESTRICTION s (RESTRICTION t g o RESTRICTION s f) =
             RESTRICTION s (g o f)}|,
      SIMP_TAC(PairList [RESTRICTION_COMPOSE_LEFT, RESTRICTION_COMPOSE_RIGHT])
    ]
  )

def RESTRICTION_UNIQUE:
  prove(
    [
      @hol|{!s (f:A->B) g.
         RESTRICTION s f = g <=> EXTENSIONAL s g /\ !x. x IN s ==> f x = g x}|,
      REWRITE_TAC(PairList [FUN_EQ_THM, RESTRICTION, EXTENSIONAL, IN_ELIM_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def RESTRICTION_UNIQUE_ALT:
  prove(
    [
      @hol|{!s (f:A->B) g.
         f = RESTRICTION s g <=> EXTENSIONAL s f /\ !x. x IN s ==> f x = g x}|,
      REWRITE_TAC(PairList [FUN_EQ_THM, RESTRICTION, EXTENSIONAL, IN_ELIM_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def cartesian_product:
  new_definition(
    @hol|{cartesian_product k s =
       {f:K->A | EXTENSIONAL k f /\ !i. i IN k ==> f i IN s i}}|
  )

def IN_CARTESIAN_PRODUCT:
  prove(
    [
      @hol|{!k s (x:K->A).
         x IN cartesian_product k s <=>
         EXTENSIONAL k x /\ (!i. i IN k ==> x i IN s i)}|,
      REWRITE_TAC(PairList [cartesian_product, IN_ELIM_THM])
    ]
  )

def CARTESIAN_PRODUCT:
  prove(
    [
      @hol|{!k s. cartesian_product k s =
         {f:K->A | !i. f i IN (if i IN k then s i else {ARB})}}|,
      REPEAT(GEN_TAC) then_tac GEN_REWRITE_TAC(I)(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [cartesian_product, IN_ELIM_THM, EXTENSIONAL]) then_tac \
      MESON_TAC(PairList [IN_SING])
    ]
  )

def RESTRICTION_IN_CARTESIAN_PRODUCT:
  prove(
    [
      @hol|{!k s (f:K->A).
         RESTRICTION k f IN cartesian_product k s <=>
         !i. i IN k ==> (f i) IN (s i)}|,
      REWRITE_TAC(PairList [RESTRICTION, cartesian_product, EXTENSIONAL, IN_ELIM_THM]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def CARTESIAN_PRODUCT_AS_RESTRICTIONS:
  prove(
    [
      @hol|{!k (s:K->A->bool).
         cartesian_product k s =
         {RESTRICTION k f |f| !i. i IN k ==> f i IN s i}}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [GSYM(SUBSET_ANTISYM_EQ), SUBSET, FORALL_IN_GSPEC]) then_tac \
      REWRITE_TAC(PairList [RESTRICTION_IN_CARTESIAN_PRODUCT]) then_tac \
      X_GEN_TAC(@hol|{x:K->A}|) then_tac \
      REWRITE_TAC(PairList [cartesian_product, IN_ELIM_THM, EXTENSIONAL]) then_tac \
      STRIP_TAC then_tac \
      EXISTS_TAC(@hol|{x:K->A}|) then_tac \
      ASM_REWRITE_TAC(PairList [FUN_EQ_THM, RESTRICTION]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def CARTESIAN_PRODUCT_EQ_EMPTY:
  prove(
    [
      @hol|{!k s:K->A->bool.
         cartesian_product k s = {} <=> ?i. i IN k /\ s i = {}}|,
      REPEAT(GEN_TAC) then_tac \
      GEN_REWRITE_TAC(LAND_CONV)(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{(?i. i IN k /\ s i = {}) <=> ~(!i. ?a. i IN k ==> a IN s i)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [SKOLEM_THM, NOT_EXISTS_THM, cartesian_product]) then_tac \
      REWRITE_TAC(PairList [IN_ELIM_THM, NOT_IN_EMPTY]) then_tac \
      EQ_TAC then_tac \
      DISCH_TAC then_tac \
      X_GEN_TAC(@hol|{f:K->A}|) then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPEC(
            @hol|{\i. if i IN k then (f:K->A) i else ARB}|
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList [EXTENSIONAL, IN_ELIM_THM]) then_tac \
      SIMP_TAC(PairList [])
    ]
  )

def CARTESIAN_PRODUCT_EMPTY:
  prove(
    [
      @hol|{!(s:K->A->bool). cartesian_product {} s = {(\i. ARB)}}|,
      REWRITE_TAC(PairList [CARTESIAN_PRODUCT, NOT_IN_EMPTY, EXTENSION]) then_tac \
      REWRITE_TAC(PairList [IN_ELIM_THM, IN_SING]) then_tac \
      REWRITE_TAC(PairList [FUN_EQ_THM])
    ]
  )

def CARTESIAN_PRODUCT_EQ_MEMBERS:
  prove(
    [
      @hol|{!k s x y:K->A.
         x IN cartesian_product k s /\ y IN cartesian_product k s /\
         (!i. i IN k ==> x i = y i)
         ==> x = y}|,
      REWRITE_TAC(PairList [cartesian_product, IN_ELIM_THM]) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(EXTENSIONAL_EQ) then_tac \
      EXISTS_TAC(@hol|{k:K->bool}|) then_tac \
      ASM_REWRITE_TAC(PairList [IN])
    ]
  )

def CARTESIAN_PRODUCT_EQ_MEMBERS_EQ:
  prove(
    [
      @hol|{!k s x y:K->A.
         x IN cartesian_product k s /\
         y IN cartesian_product k s
         ==> (x = y <=> !i. i IN k ==> x i = y i)}|,
      MESON_TAC(PairList [CARTESIAN_PRODUCT_EQ_MEMBERS])
    ]
  )

def SUBSET_CARTESIAN_PRODUCT:
  prove(
    [
      @hol|{!k s t:K->A->bool.
         cartesian_product k s SUBSET cartesian_product k t <=>
         cartesian_product k s = {} \/ !i. i IN k ==> s i SUBSET t i}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{cartesian_product k (s:K->A->bool) = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [EMPTY_SUBSET]) then_tac \
      REWRITE_TAC(PairList [SUBSET, cartesian_product, IN_ELIM_THM]) then_tac \
      EQ_TAC then_list \
      PairList [ALL_TAC, MESON_TAC(PairList [])] then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(GEN_REWRITE_RULE(RAND_CONV)(PairList [CARTESIAN_PRODUCT_EQ_EMPTY]))
      ) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{~(?i. i IN k /\ s i = {}) <=> (!i. ?a. i IN k ==> a IN s i)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [SKOLEM_THM, LEFT_IMP_EXISTS_THM]) then_tac \
      X_GEN_TAC(@hol|{z:K->A}|) then_tac \
      DISCH_TAC then_tac \
      DISCH_TAC then_tac \
      X_GEN_TAC(@hol|{i:K}|) then_tac \
      DISCH_TAC then_tac \
      X_GEN_TAC(@hol|{x:A}|) then_tac \
      DISCH_TAC then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPEC(
            @hol|{(\j. if j IN k then if j = i then x else z j else ARB):K->A}|
          )
        )
      ) then_tac \
      REWRITE_TAC(PairList [EXTENSIONAL, IN_ELIM_THM]) then_tac \
      SIMP_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def CARTESIAN_PRODUCT_EQ:
  prove(
    [
      @hol|{!k s t:K->A->bool.
         cartesian_product k s = cartesian_product k t <=>
         cartesian_product k s = {} /\ cartesian_product k t = {} \/
         !i. i IN k ==> s i = t i}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{!i. i IN k ==> (s:K->A->bool) i = t i}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_list \
      PairList [
        ASM_SIMP_TAC(PairList [cartesian_product, EXTENSION, IN_ELIM_THM]),
        ASM_CASES_TAC(
          @hol|{cartesian_product k (t:K->A->bool) = {}}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        ASM_CASES_TAC(
          @hol|{cartesian_product k (s:K->A->bool) = {}}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        ASM_REWRITE_TAC(PairList [GSYM(SUBSET_ANTISYM_EQ), SUBSET_CARTESIAN_PRODUCT]) then_tac \
        ASM(SET_TAC)(PairList [])
      ]
    ]
  )

def INTER_CARTESIAN_PRODUCT:
  prove(
    [
      @hol|{!k s t:K->A->bool.
         (cartesian_product k s) INTER (cartesian_product k t) =
         cartesian_product k (\i. s i INTER t i)}|,
      REWRITE_TAC(PairList [EXTENSION, cartesian_product, IN_INTER, IN_ELIM_THM]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def CARTESIAN_PRODUCT_UNIV:
  prove(
    [
      @hol|{cartesian_product (:K) (\i. (:A)) = (:K->A)}|,
      REWRITE_TAC(PairList [EXTENSION, IN_UNIV, cartesian_product, IN_ELIM_THM]) then_tac \
      REWRITE_TAC(PairList [EXTENSIONAL_UNIV])
    ]
  )

def CARTESIAN_PRODUCT_SINGS:
  prove(
    [
      @hol|{!k x:K->A. EXTENSIONAL k x ==> cartesian_product k (\i. {x i}) = {x}}|,
      REWRITE_TAC(PairList [cartesian_product, IN_SING]) then_tac \
      REWRITE_TAC(PairList [EXTENSION, EXTENSIONAL, IN_ELIM_THM, IN_SING]) then_tac \
      REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def CARTESIAN_PRODUCT_SINGS_GEN:
  prove(
    [
      @hol|{!k (x:K->A). cartesian_product k (\i. {x i}) = {RESTRICTION k x}}|,
      REWRITE_TAC(PairList [cartesian_product, IN_SING]) then_tac \
      REWRITE_TAC(PairList [EXTENSION, EXTENSIONAL, IN_ELIM_THM, IN_SING]) then_tac \
      REWRITE_TAC(PairList [FUN_EQ_THM, RESTRICTION]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def IMAGE_PROJECTION_CARTESIAN_PRODUCT:
  prove(
    [
      @hol|{!k s:K->A->bool i.
         IMAGE (\x. x i) (cartesian_product k s) =
         if cartesian_product k s = {} then {}
         else if i IN k then s i else {ARB}}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{cartesian_product k (s:K->A->bool) = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [IMAGE_CLAUSES]) then_tac \
      REWRITE_TAC(PairList [GSYM(SUBSET_ANTISYM_EQ), SUBSET, FORALL_IN_IMAGE]) then_tac \
      SIMP_TAC(PairList [CARTESIAN_PRODUCT, IN_ELIM_THM]) then_tac \
      X_GEN_TAC(@hol|{x:A}|) then_tac \
      DISCH_TAC then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(GEN_REWRITE_RULE(RAND_CONV)(PairList [CARTESIAN_PRODUCT_EQ_EMPTY]))
      ) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{~(?i. i IN k /\ s i = {}) <=> (!i. ?a. i IN k ==> a IN s i)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [SKOLEM_THM, LEFT_IMP_EXISTS_THM]) then_tac \
      X_GEN_TAC(@hol|{z:K->A}|) then_tac \
      DISCH_TAC then_tac \
      REWRITE_TAC(PairList [IN_IMAGE, IN_ELIM_THM]) then_tac \
      EXISTS_TAC(
        @hol|{\j. if j = i then x else if j IN k then (z:K->A) j else ARB}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [IN_SING])
    ]
  )

def FORALL_CARTESIAN_PRODUCT_ELEMENTS:
  prove(
    [
      @hol|{!P k s:K->A->bool.
         (!z i. z IN cartesian_product k s /\ i IN k ==> P i (z i)) <=>
         cartesian_product k s = {} \/
         (!i x. i IN k /\ x IN s i ==> P i x)}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{cartesian_product k (s:K->A->bool) = {}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [NOT_IN_EMPTY]) then_tac \
      REWRITE_TAC(PairList [cartesian_product, IN_ELIM_THM]) then_tac \
      EQ_TAC then_list \
      PairList [DISCH_TAC, MESON_TAC(PairList [])] then_tac \
      FIRST_ASSUM(
        o(MP_TAC)(GEN_REWRITE_RULE(RAND_CONV)(PairList [CARTESIAN_PRODUCT_EQ_EMPTY]))
      ) then_tac \
      REWRITE_TAC(
        PairList [
          SKOLEM_THM,
          LEFT_IMP_EXISTS_THM,
          SET_RULE(
            @hol|{~(?i. i IN k /\ s i = {}) <=> (!i. ?x. i IN k ==> x IN s i)}|
          )
        ]
      ) then_tac \
      X_GEN_TAC(@hol|{z:K->A}|) then_tac \
      DISCH_TAC then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{i:K}|, @hol|{x:A}|]) then_tac \
      STRIP_TAC then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPECL(
            PairList [
              @hol|{\j. if j = i then x else if j IN k then (z:K->A) j else ARB}|,
              @hol|{i:K}|
            ]
          )
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [EXTENSIONAL, IN_ELIM_THM]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def FORALL_CARTESIAN_PRODUCT_ELEMENTS_EQ:
  prove(
    [
      @hol|{!P k (s:K->A->bool).
         ~(cartesian_product k s = {})
         ==> ((!i x. i IN k /\ x IN s i ==> P i x) <=>
              !z i. z IN cartesian_product k s /\ i IN k ==> P i (z i))}|,
      SIMP_TAC(PairList [FORALL_CARTESIAN_PRODUCT_ELEMENTS])
    ]
  )

def EXISTS_CARTESIAN_PRODUCT_ELEMENT:
  prove(
    [
      @hol|{!P k s:K->A->bool.
         (?z. z IN cartesian_product k s /\ (!i. i IN k ==> P i (z i))) <=>
         (!i. i IN k ==> ?x. x IN (s i) /\ P i x)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [CARTESIAN_PRODUCT_AS_RESTRICTIONS, EXISTS_IN_GSPEC]) then_tac \
      SIMP_TAC(PairList [RESTRICTION]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def product_map:
  new_definition(
    @hol|{product_map k (f:K->A->B) = \x. RESTRICTION k (\i. f i (x i))}|
  )

def PRODUCT_MAP_RESTRICTION:
  prove(
    [
      @hol|{!(f:K->A->B) k x.
         product_map k f (RESTRICTION k x) = RESTRICTION k (\i. f i (x i))}|,
      SIMP_TAC(PairList [product_map, RESTRICTION, o_THM, FUN_EQ_THM])
    ]
  )

def IMAGE_PRODUCT_MAP:
  prove(
    [
      @hol|{!(f:K->A->B) k s.
         IMAGE (product_map k f) (cartesian_product k s) =
         cartesian_product k (\i. IMAGE (f i) (s i))}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [CARTESIAN_PRODUCT_AS_RESTRICTIONS]) then_tac \
      ONCE_REWRITE_TAC(PairList [SIMPLE_IMAGE_GEN]) then_tac \
      REWRITE_TAC(PairList [product_map, GSYM(IMAGE_o), o_DEF]) then_tac \
      GEN_REWRITE_TAC(I)(PairList [EXTENSION]) then_tac \
      X_GEN_TAC(@hol|{g:K->B}|) then_tac \
      REWRITE_TAC(PairList [IN_IMAGE, RESTRICTION, IN_ELIM_THM]) then_tac \
      EQ_TAC then_tac \
      STRIP_TAC then_tac \
      ASM_REWRITE_TAC(PairList [RESTRICTION_EXTENSION]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def disjoint_union:
  new_definition(
    @hol|{disjoint_union (k:K->bool) (s:K->A->bool) = { (i,x) | i IN k /\ x IN s i}}|
  )

def SUBSET_DISJOINT_UNION:
  prove(
    [
      @hol|{!k (s:K->A->bool) t.
         disjoint_union k s SUBSET disjoint_union k t <=>
         !i. i IN k ==> s i SUBSET t i}|,
      REWRITE_TAC(PairList [SUBSET, disjoint_union, FORALL_IN_GSPEC]) then_tac \
      REWRITE_TAC(PairList [IN_ELIM_PAIR_THM]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def DISJOINT_UNION_EQ:
  prove(
    [
      @hol|{!k (s:K->A->bool) t.
         disjoint_union k s = disjoint_union k t <=>
         !i. i IN k ==> s i = t i}|,
      REWRITE_TAC(PairList [GSYM(SUBSET_ANTISYM_EQ), SUBSET_DISJOINT_UNION]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def SUBSET_DISJOINT_UNION_EXISTS:
  prove(
    [
      @hol|{!k (s:K->A->bool) u.
         u SUBSET disjoint_union k s <=>
         ?t. u = disjoint_union k t /\ !i. i IN k ==> t i SUBSET s i}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [DISCH_TAC, MESON_TAC(PairList [SUBSET_DISJOINT_UNION])] then_tac \
      EXISTS_TAC(
        @hol|{\i. {x | (i,x) IN (u:K#A->bool)}}|
      ) then_tac \
      POP_ASSUM(MP_TAC) then_tac \
      REWRITE_TAC(PairList [SUBSET, EXTENSION]) then_tac \
      REWRITE_TAC(PairList [disjoint_union, FORALL_PAIR_THM, IN_ELIM_PAIR_THM]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def INTER_DISJOINT_UNION:
  prove(
    [
      @hol|{!k s t:K->A->bool.
         (disjoint_union k s) INTER (disjoint_union k t) =
         disjoint_union k (\i. s i INTER t i)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [EXTENSION, disjoint_union, IN_INTER, IN_ELIM_THM]) then_tac \
      MESON_TAC(PairList [PAIR_EQ])
    ]
  )

def UNION_DISJOINT_UNION:
  prove(
    [
      @hol|{!k s t:K->A->bool.
         (disjoint_union k s) UNION (disjoint_union k t) =
         disjoint_union k (\i. s i UNION t i)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [EXTENSION, disjoint_union, IN_UNION, IN_ELIM_THM]) then_tac \
      MESON_TAC(PairList [PAIR_EQ])
    ]
  )

def DISJOINT_UNION_EQ_EMPTY:
  prove(
    [
      @hol|{!k s:K->A->bool.
         disjoint_union k s = {} <=> !i. i IN k ==> s i = {}}|,
      REWRITE_TAC(PairList [EXTENSION, FORALL_PAIR_THM, disjoint_union, IN_ELIM_PAIR_THM, NOT_IN_EMPTY]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def DISJOINT_DISJOINT_UNION:
  prove(
    [
      @hol|{!k s t:K->A->bool.
         DISJOINT (disjoint_union k s) (disjoint_union k t) =
         !i. i IN k ==> DISJOINT (s i) (t i)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [DISJOINT, INTER_DISJOINT_UNION, DISJOINT_UNION_EQ_EMPTY])
    ]
  )

def HAS_SIZE_FUNSPACE:
  prove(
    [
      @hol|{!d n t:B->bool m s:A->bool.
         s HAS_SIZE m /\ t HAS_SIZE n
         ==> {f | (!x. x IN s ==> f(x) IN t) /\ (!x. ~(x IN s) ==> (f x = d))}
             HAS_SIZE (n EXP m)}|,
      GEN_TAC then_tac GEN_TAC then_tac GEN_TAC then_tac INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [HAS_SIZE_CLAUSES]) then_list \
      PairList [
        REPEAT(STRIP_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [NOT_IN_EMPTY, EXP]) then_tac \
        CONV_TAC(HAS_SIZE_CONV) then_tac \
        EXISTS_TAC(@hol|{(\x. d):A->B}|) then_tac \
        REWRITE_TAC(PairList [EXTENSION, IN_ELIM_THM, IN_SING]) then_tac \
        REWRITE_TAC(PairList [FUN_EQ_THM]),
        REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM, LEFT_AND_EXISTS_THM])
      ] then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{s0:A->bool}|,
          @hol|{a:A}|,
          @hol|{s:A->bool}|
        ]
      ) then_tac \
      STRIP_TAC then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(SPEC(@hol|{s:A->bool}|))) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      STRIP_TAC then_tac \
      SUBGOAL_THEN(
        @hol|{{f:A->B | (!x. x IN a INSERT s ==> f x IN t) /\
                     (!x. ~(x IN a INSERT s) ==> (f x = d))} =
           IMAGE (\(b,g) x. if x = a then b else g(x))
                 {b,g | b IN t /\
                        g IN {f | (!x. x IN s ==> f x IN t) /\
                                  (!x. ~(x IN s) ==> (f x = d))}}}|
      )(SUBST1_TAC) then_list \
      PairList [
        REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, FORALL_PAIR_THM, IN_ELIM_THM, EXISTS_PAIR_THM]) then_tac \
        REWRITE_TAC(
          PairList [
            PAIR_EQ,
            CONJ_ASSOC,
            ONCE_REWRITE_RULE(PairList [CONJ_SYM])(UNWIND_THM1)
          ]
        ) then_tac \
        X_GEN_TAC(@hol|{f:A->B}|) then_tac \
        REWRITE_TAC(PairList [IN_INSERT]) then_tac \
        EQ_TAC then_list \
        PairList [
          STRIP_TAC then_tac \
          MAP_EVERY(EXISTS_TAC)(
            PairList [
              @hol|{(f:A->B) a}|,
              @hol|{\x. if x IN s then (f:A->B) x else d}|
            ]
          ) then_tac \
          REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
          ASM_MESON_TAC(PairList []),
          DISCH_THEN(
            X_CHOOSE_THEN(@hol|{b:B}|)(
              X_CHOOSE_THEN(@hol|{g:A->B}|)(STRIP_ASSUME_TAC)
            )
          ) then_tac \
          ASM_REWRITE_TAC(PairList []) then_tac \
          ASM_MESON_TAC(PairList [])
        ],
        ALL_TAC
      ] then_tac \
      MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ) then_tac \
      ASM_SIMP_TAC(PairList [EXP, HAS_SIZE_PRODUCT]) then_tac \
      REWRITE_TAC(PairList [FORALL_PAIR_THM, IN_ELIM_THM, PAIR_EQ, CONJ_ASSOC]) then_tac \
      REWRITE_TAC(PairList [ONCE_REWRITE_RULE(PairList [CONJ_SYM])(UNWIND_THM1)]) then_tac \
      CONV_TAC(ONCE_DEPTH_CONV(GEN_BETA_CONV)) then_tac \
      REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
      REPEAT(GEN_TAC) then_tac \
      STRIP_TAC then_tac \
      CONJ_TAC then_list \
      PairList [
        FIRST_X_ASSUM(o(MP_TAC)(SPEC(@hol|{a:A}|))) then_tac \
        REWRITE_TAC(PairList []),
        X_GEN_TAC(@hol|{x:A}|) then_tac \
        FIRST_X_ASSUM(o(MP_TAC)(SPEC(@hol|{x:A}|))) then_tac \
        ASM_MESON_TAC(PairList [])
      ]
    ]
  )

def CARD_FUNSPACE:
  prove(
    [
      @hol|{!s t. FINITE s /\ FINITE t
         ==> (CARD {f:A->B | (!x. x IN s ==> f(x) IN t) /\
                             (!x. ~(x IN s) ==> (f x = d))} =
             (CARD t) EXP (CARD s))}|,
      MESON_TAC(PairList [HAS_SIZE_FUNSPACE, HAS_SIZE])
    ]
  )

def FINITE_FUNSPACE:
  prove(
    [
      @hol|{!s t. FINITE s /\ FINITE t
         ==> FINITE {f:A->B | (!x. x IN s ==> f(x) IN t) /\
                              (!x. ~(x IN s) ==> (f x = d))}}|,
      MESON_TAC(PairList [HAS_SIZE_FUNSPACE, HAS_SIZE])
    ]
  )

def HAS_SIZE_FUNSPACE_UNIV:
  prove(
    [
      @hol|{!m n. (:A) HAS_SIZE m /\ (:B) HAS_SIZE n ==> (:A->B) HAS_SIZE (n EXP m)}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(HAS_SIZE_FUNSPACE))) then_tac \
      REWRITE_TAC(PairList [IN_UNIV, UNIV_GSPEC])
    ]
  )

def CARD_FUNSPACE_UNIV:
  prove(
    [
      @hol|{FINITE(:A) /\ FINITE(:B) ==> CARD(:A->B) = CARD(:B) EXP CARD(:A)}|,
      MESON_TAC(PairList [HAS_SIZE_FUNSPACE_UNIV, HAS_SIZE])
    ]
  )

def FINITE_FUNSPACE_UNIV:
  prove(
    [
      @hol|{FINITE(:A) /\ FINITE(:B) ==> FINITE(:A->B)}|,
      MESON_TAC(PairList [HAS_SIZE_FUNSPACE_UNIV, HAS_SIZE])
    ]
  )

def HAS_SIZE_BOOL:
  prove(
    [
      @hol|{(:bool) HAS_SIZE 2}|,
      SUBGOAL_THEN(
        @hol|{(:bool) = {F,T}}|
      )(SUBST1_TAC) then_list \
      PairList [
        REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_INSERT]) then_tac CONV_TAC(TAUT),
        SIMP_TAC(
          PairList [
            HAS_SIZE,
            CARD_CLAUSES,
            FINITE_INSERT,
            FINITE_EMPTY,
            ARITH,
            IN_SING,
            NOT_IN_EMPTY
          ]
        )
      ]
    ]
  )

def CARD_BOOL:
  prove(
    [
      @hol|{CARD(:bool) = 2}|,
      MESON_TAC(PairList [HAS_SIZE_BOOL, HAS_SIZE])
    ]
  )

def FINITE_BOOL:
  prove(
    [
      @hol|{FINITE(:bool)}|,
      MESON_TAC(PairList [HAS_SIZE_BOOL, HAS_SIZE])
    ]
  )

def HAS_SIZE_POWERSET:
  prove(
    [
      @hol|{!(s:A->bool) n. s HAS_SIZE n ==> {t | t SUBSET s} HAS_SIZE (2 EXP n)}|,
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{{t | t SUBSET s} =
           {f | (!x:A. x IN s ==> f(x) IN UNIV) /\ (!x. ~(x IN s) ==> (f x = F))}}|
      )(SUBST1_TAC) then_list \
      PairList [
        REWRITE_TAC(PairList [EXTENSION, IN_ELIM_THM, IN_UNIV, SUBSET, IN, CONTRAPOS_THM]),
        MATCH_MP_TAC(HAS_SIZE_FUNSPACE) then_tac ASM_REWRITE_TAC(PairList []) then_tac \
        CONV_TAC(HAS_SIZE_CONV) then_tac \
        MAP_EVERY(EXISTS_TAC)(PairList [@hol|{T}|, @hol|{F}|]) then_tac \
        REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_INSERT, NOT_IN_EMPTY]) then_tac \
        CONV_TAC(TAUT)
      ]
    ]
  )

def CARD_POWERSET:
  prove(
    [
      @hol|{!s:A->bool. FINITE s ==> (CARD {t | t SUBSET s} = 2 EXP (CARD s))}|,
      MESON_TAC(PairList [HAS_SIZE_POWERSET, HAS_SIZE])
    ]
  )

def FINITE_POWERSET:
  prove(
    [
      @hol|{!s:A->bool. FINITE s ==> FINITE {t | t SUBSET s}}|,
      MESON_TAC(PairList [HAS_SIZE_POWERSET, HAS_SIZE])
    ]
  )

def FINITE_POWERSET_EQ:
  prove(
    [
      @hol|{!s:A->bool. FINITE {t | t SUBSET s} <=> FINITE s}|,
      GEN_TAC then_tac EQ_TAC then_tac REWRITE_TAC(PairList [FINITE_POWERSET]) then_tac \
      DISCH_TAC then_tac \
      SUBGOAL_THEN(
        @hol|{FINITE(IMAGE (\x:A. {x}) s)}|
      )(MP_TAC) then_list \
      PairList [
        FIRST_X_ASSUM(
          o(MATCH_MP_TAC)(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ])(FINITE_SUBSET)))
        ) then_tac \
        SIMP_TAC(PairList [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, IN_SING]),
        MATCH_MP_TAC(EQ_IMP) then_tac MATCH_MP_TAC(FINITE_IMAGE_INJ_EQ) then_tac \
        SET_TAC(PairList [])
      ]
    ]
  )

def FINITE_RESTRICTED_SUBSETS:
  prove(
    [
      @hol|{!P s:A->bool. FINITE s ==> FINITE {t | t SUBSET s /\ P t}}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(FINITE_SUBSET) then_tac \
      EXISTS_TAC(
        @hol|{{t:A->bool | t SUBSET s}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_POWERSET]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def FINITE_UNIONS:
  prove(
    [
      @hol|{!s:(A->bool)->bool.
         FINITE(UNIONS s) <=> FINITE s /\ (!t. t IN s ==> FINITE t)}|,
      GEN_TAC then_tac \
      ASM_CASES_TAC(
        @hol|{FINITE(s:(A->bool)->bool)}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_FINITE_UNIONS]) then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(FINITE_POWERSET))) then_tac \
      POP_ASSUM(MP_TAC) then_tac \
      REWRITE_TAC(PairList [CONTRAPOS_THM]) then_tac \
      MATCH_MP_TAC(REWRITE_RULE(PairList [IMP_CONJ_ALT])(FINITE_SUBSET)) then_tac \
      SET_TAC(PairList [])
    ]
  )

def FINITE_CARD_LE_UNIONS:
  prove(
    [
      @hol|{!s (t:A->B->bool) m n.
         (!x. x IN s ==> FINITE(t x) /\ CARD(t x) <= n) /\
         FINITE s /\ CARD s <= m
         ==> FINITE(UNIONS {t x | x IN s}) /\
             CARD(UNIONS {t x | x IN s}) <= m * n}|,
      REPEAT(STRIP_TAC) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_UNIONS, FORALL_IN_GSPEC, FINITE_IMAGE, SIMPLE_IMAGE]) then_tac \
      TRANS_TAC(LE_TRANS)(
        @hol|{CARD(s:A->bool) * n}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(SIMPLE_IMAGE), LE_MULT_RCANCEL]) then_tac \
      MATCH_MP_TAC(CARD_UNIONS_LE) then_tac \
      ASM_REWRITE_TAC(PairList [HAS_SIZE])
    ]
  )

def POWERSET_CLAUSES:
  prove(
    [
      @hol|{{s:A->bool | s SUBSET {}} = {{}} /\
         (!a:A t. {s | s SUBSET (a INSERT t)} =
                  {s | s SUBSET t} UNION IMAGE (\s. a INSERT s) {s | s SUBSET t})}|,
      REWRITE_TAC(PairList [SUBSET_INSERT_DELETE, SUBSET_EMPTY, SING_GSPEC]) then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{a:A}|, @hol|{t:A->bool}|]) then_tac \
      MATCH_MP_TAC(SUBSET_ANTISYM) then_tac \
      REWRITE_TAC(PairList [UNION_SUBSET]) then_tac \
      ONCE_REWRITE_TAC(PairList [SUBSET]) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_IMAGE, FORALL_IN_GSPEC]) then_tac \
      REWRITE_TAC(PairList [IN_ELIM_THM, IN_UNION, IN_IMAGE]) then_tac \
      CONJ_TAC then_list \
      PairList [ALL_TAC, SET_TAC(PairList [])] then_tac \
      X_GEN_TAC(@hol|{s:A->bool}|) then_tac \
      ASM_CASES_TAC(
        @hol|{(a:A) IN s}|
      ) then_list \
      PairList [ALL_TAC, ASM(SET_TAC)(PairList [])] then_tac \
      STRIP_TAC then_tac \
      DISJ2_TAC then_tac \
      EXISTS_TAC(
        @hol|{s DELETE (a:A)}|
      ) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def FINITE_IMAGE_INFINITE:
  prove(
    [
      @hol|{!f:A->B s.
         INFINITE s /\ FINITE(IMAGE f s)
         ==> ?a. a IN s /\ INFINITE {x | x IN s /\ f x = f a}}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [IMP_CONJ_ALT]) then_tac \
      DISCH_TAC then_tac \
      GEN_REWRITE_TAC(I)(PairList [GSYM(CONTRAPOS_THM)]) then_tac \
      REWRITE_TAC(
        PairList [
          NOT_EXISTS_THM,
          INFINITE,
          TAUT(
            @hol|{~(p /\ q) <=> p ==> ~q}|
          )
        ]
      ) then_tac \
      DISCH_TAC then_tac \
      SUBGOAL_THEN(
        @hol|{s = UNIONS {{x | x IN s /\ (f:A->B) x = y} |y| y IN IMAGE f s}}|
      )(SUBST1_TAC) then_list \
      PairList [
        REWRITE_TAC(PairList [UNIONS_GSPEC]) then_tac SET_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      ASM_SIMP_TAC(PairList [FINITE_UNIONS, SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE])
    ]
  )

def FINITE_RESTRICTED_POWERSET:
  prove(
    [
      @hol|{!(s:A->bool) n.
         FINITE {t | t SUBSET s /\ t HAS_SIZE n} <=>
         FINITE s \/ n = 0}|,
      REPEAT(GEN_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{n = 0}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_list \
      PairList [
        REWRITE_TAC(
          PairList [
            HAS_SIZE_0,
            SET_RULE(
              @hol|{t SUBSET s /\ t = {} <=> t = {}}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [SING_GSPEC, FINITE_SING]),
        ASM_CASES_TAC(
          @hol|{FINITE(s:A->bool)}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList []) then_list \
        PairList [
          ONCE_REWRITE_TAC(
            PairList [
              SET_RULE(
                @hol|{{x | P x /\ Q x} = {x | x IN {y | P y} /\ Q x}}|
              )
            ]
          ) then_tac \
          ASM_SIMP_TAC(PairList [FINITE_RESTRICT, FINITE_POWERSET]),
          DISCH_TAC then_tac \
          SUBGOAL_THEN(
            @hol|{FINITE(s:A->bool)}|
          )(MP_TAC) then_list \
          PairList [ALL_TAC, ASM_REWRITE_TAC(PairList [])] then_tac \
          MATCH_MP_TAC(FINITE_SUBSET) then_tac \
          EXISTS_TAC(
            @hol|{UNIONS {t:A->bool | t SUBSET s /\ t HAS_SIZE n}}|
          ) then_tac \
          CONJ_TAC then_list \
          PairList [
            ASM_SIMP_TAC(PairList [FINITE_UNIONS, FORALL_IN_GSPEC]) then_tac \
            SIMP_TAC(PairList [HAS_SIZE]),
            GEN_REWRITE_TAC(I)(PairList [SUBSET]) then_tac \
            X_GEN_TAC(@hol|{x:A}|) then_tac \
            DISCH_TAC then_tac \
            REWRITE_TAC(PairList [UNIONS_GSPEC, IN_ELIM_THM]) then_tac \
            ONCE_REWRITE_TAC(
              PairList [
                SET_RULE(
                  @hol|{P /\ x IN t <=> {x} SUBSET t /\ P}|
                )
              ]
            ) then_tac \
            MATCH_MP_TAC(CHOOSE_SUBSET_BETWEEN) then_tac \
            ASM_REWRITE_TAC(PairList [SING_SUBSET, FINITE_SING, CARD_SING]) then_tac \
            ASM_SIMP_TAC(PairList [LE_1])
          ]
        ]
      ]
    ]
  )

def FINITE_RESTRICTED_FUNSPACE:
  prove(
    [
      @hol|{!s:A->bool t:B->bool k.
         FINITE s /\ FINITE t
         ==> FINITE {f | IMAGE f s SUBSET t /\ {x | ~(f x = k x)} SUBSET s}}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(FINITE_SUBSET) then_tac \
      EXISTS_TAC(
        @hol|{IMAGE (\u:(A#B)->bool x. if ?y. (x,y) IN u then @y. (x,y) IN u else k x)
           {u | u SUBSET (s CROSS t)}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_POWERSET, FINITE_CROSS, FINITE_IMAGE]) then_tac \
      GEN_REWRITE_TAC(I)(PairList [SUBSET]) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_GSPEC]) then_tac \
      X_GEN_TAC(@hol|{f:A->B}|) then_tac \
      STRIP_TAC then_tac \
      REWRITE_TAC(PairList [IN_IMAGE, IN_ELIM_THM]) then_tac \
      EXISTS_TAC(
        @hol|{IMAGE (\x. x,(f:A->B) x) {x | ~(f x = k x)}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_IMAGE]) then_tac \
      CONJ_TAC then_list \
      PairList [
        ALL_TAC,
        REWRITE_TAC(PairList [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, IN_CROSS]) then_tac \
        ASM(SET_TAC)(PairList [])
      ] then_tac \
      REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
      X_GEN_TAC(@hol|{x:A}|) then_tac \
      REWRITE_TAC(PairList [IN_IMAGE, IN_ELIM_THM, PAIR_EQ]) then_tac \
      REWRITE_TAC(PairList [GSYM(CONJ_ASSOC), UNWIND_THM1, UNWIND_THM2]) then_tac \
      ASM_CASES_TAC(
        @hol|{(f:A->B) x = k x}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def NUMSEG_CLAUSES_LT:
  prove(
    [
      @hol|{{i | i < 0} = {} /\
         (!k. {i | i < SUC k} = k INSERT {i | i < k})}|,
      REWRITE_TAC(PairList [LT]) then_tac SET_TAC(PairList [])
    ]
  )

def HAS_SIZE_NUMSEG_LT:
  prove(
    [
      @hol|{!n. {m | m < n} HAS_SIZE n}|,
      REWRITE_TAC(PairList [HAS_SIZE]) then_tac INDUCT_TAC then_tac \
      ASM_SIMP_TAC(
        PairList [
          NUMSEG_CLAUSES_LT,
          FINITE_EMPTY,
          CARD_CLAUSES,
          FINITE_INSERT,
          IN_ELIM_THM,
          LT_REFL
        ]
      )
    ]
  )

def CARD_NUMSEG_LT:
  prove(
    [
      @hol|{!n. CARD {m | m < n} = n}|,
      REWRITE_TAC(PairList [REWRITE_RULE(PairList [HAS_SIZE])(HAS_SIZE_NUMSEG_LT)])
    ]
  )

def FINITE_NUMSEG_LT:
  prove(
    [
      @hol|{!n:num. FINITE {m | m < n}}|,
      REWRITE_TAC(PairList [REWRITE_RULE(PairList [HAS_SIZE])(HAS_SIZE_NUMSEG_LT)])
    ]
  )

def NUMSEG_CLAUSES_LE:
  prove(
    [
      @hol|{{i | i <= 0} = {0} /\
         (!k. {i | i <= SUC k} = SUC k INSERT {i | i <= k})}|,
      REWRITE_TAC(PairList [LE]) then_tac SET_TAC(PairList [])
    ]
  )

def HAS_SIZE_NUMSEG_LE:
  prove(
    [
      @hol|{!n. {m | m <= n} HAS_SIZE (n + 1)}|,
      REWRITE_TAC(PairList [GSYM(LT_SUC_LE), HAS_SIZE_NUMSEG_LT, ADD1])
    ]
  )

def FINITE_NUMSEG_LE:
  prove(
    [
      @hol|{!n. FINITE {m | m <= n}}|,
      REWRITE_TAC(PairList [REWRITE_RULE(PairList [HAS_SIZE])(HAS_SIZE_NUMSEG_LE)])
    ]
  )

def CARD_NUMSEG_LE:
  prove(
    [
      @hol|{!n. CARD {m | m <= n} = n + 1}|,
      REWRITE_TAC(PairList [REWRITE_RULE(PairList [HAS_SIZE])(HAS_SIZE_NUMSEG_LE)])
    ]
  )

def num_FINITE:
  prove(
    [
      @hol|{!s:num->bool. FINITE s <=> ?a. !x. x IN s ==> x <= a}|,
      GEN_TAC then_tac EQ_TAC then_list \
      PairList [
        SPEC_TAC([@hol|{s:num->bool}|, @hol|{s:num->bool}|]) then_tac \
        MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
        REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY]) then_tac \
        MESON_TAC(PairList [LE_CASES, LE_TRANS]),
        DISCH_THEN(X_CHOOSE_TAC(@hol|{n:num}|)) then_tac \
        MATCH_MP_TAC(FINITE_SUBSET) then_tac \
        EXISTS_TAC(
          @hol|{{m:num | m <= n}}|
        ) then_tac \
        REWRITE_TAC(PairList [FINITE_NUMSEG_LE]) then_tac \
        ASM_SIMP_TAC(PairList [SUBSET, IN_ELIM_THM])
      ]
    ]
  )

def num_FINITE_AVOID:
  prove(
    [
      @hol|{!s:num->bool. FINITE(s) ==> ?a. ~(a IN s)}|,
      MESON_TAC(PairList [num_FINITE, LT, NOT_LT])
    ]
  )

def num_INFINITE_EQ:
  prove(
    [
      @hol|{!s:num->bool. INFINITE s <=> !N. ?n. N <= n /\ n IN s}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [INFINITE, num_FINITE]) then_tac \
      MESON_TAC(PairList [NOT_LE, LT_IMP_LE, LE_SUC_LT])
    ]
  )

def num_INFINITE:
  prove(
    [
      @hol|{INFINITE(:num)}|,
      REWRITE_TAC(PairList [INFINITE]) then_tac \
      MESON_TAC(PairList [num_FINITE_AVOID, IN_UNIV])
    ]
  )

def string_INFINITE:
  prove(
    [
      @hol|{INFINITE(:string)}|,
      MP_TAC(num_INFINITE) then_tac REWRITE_TAC(PairList [INFINITE, CONTRAPOS_THM]) then_tac \
      DISCH_THEN(
        o(
          o(MP_TAC)(ISPEC(@hol|{LENGTH:string->num}|))
        )(MATCH_MP(FINITE_IMAGE))
      ) then_tac \
      MATCH_MP_TAC(EQ_IMP) then_tac \
      AP_TERM_TAC then_tac \
      REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_IMAGE]) then_tac \
      MESON_TAC(PairList [LENGTH_REPLICATE])
    ]
  )

def FINITE_REAL_INTERVAL:
  prove(
    [
      @hol|{(!a. ~FINITE {x:real | a < x}) /\
         (!a. ~FINITE {x:real | a <= x}) /\
         (!b. ~FINITE {x:real | x < b}) /\
         (!b. ~FINITE {x:real | x <= b}) /\
         (!a b. FINITE {x:real | a < x /\ x < b} <=> b <= a) /\
         (!a b. FINITE {x:real | a <= x /\ x < b} <=> b <= a) /\
         (!a b. FINITE {x:real | a < x /\ x <= b} <=> b <= a) /\
         (!a b. FINITE {x:real | a <= x /\ x <= b} <=> b <= a)}|,
      SUBGOAL_THEN(
        @hol|{!a b. FINITE {x:real | a < x /\ x < b} <=> b <= a}|
      )(ASSUME_TAC) then_list \
      PairList [
        REPEAT(GEN_TAC) then_tac \
        REWRITE_TAC(PairList [GSYM(REAL_NOT_LT)]) then_tac \
        ASM_CASES_TAC(
          @hol|{a:real < b}|
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            REAL_ARITH(
              @hol|{~(a:real < b) ==> ~(a < x /\ x < b)}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(PairList [EMPTY_GSPEC, FINITE_EMPTY]) then_tac \
        DISCH_THEN(
          o(MP_TAC)(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ])(FINITE_SUBSET)))
        ) then_tac \
        DISCH_THEN(
          o(MP_TAC)(
            SPEC(
              @hol|{IMAGE (\n. a + (b - a) / (&n + &2)) (:num)}|
            )
          )
        ) then_tac \
        REWRITE_TAC(PairList [SUBSET, FORALL_IN_IMAGE, IN_UNIV, IN_ELIM_THM]) then_tac \
        SIMP_TAC(
          PairList [
            REAL_LT_ADDR,
            REAL_ARITH(
              @hol|{a + x / y < b <=> x / y < b - a}|
            )
          ]
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            REAL_LT_DIV,
            REAL_SUB_LT,
            REAL_LT_LDIV_EQ,
            NOT_IMP,
            REAL_ARITH(
              @hol|{&0:real < &n + &2}|
            )
          ]
        ) then_tac \
        REWRITE_TAC(
          PairList [
            REAL_ARITH(
              @hol|{x:real < x * (n + &2) <=> &0 < x * (n + &1)}|
            )
          ]
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            REAL_SUB_LT,
            REAL_LT_MUL,
            REAL_ARITH(
              @hol|{&0:real < &n + &1}|
            )
          ]
        ) then_tac \
        MP_TAC(num_INFINITE) then_tac \
        REWRITE_TAC(PairList [INFINITE]) then_tac \
        MATCH_MP_TAC(EQ_IMP) then_tac \
        AP_TERM_TAC then_tac \
        CONV_TAC(SYM_CONV) then_tac \
        MATCH_MP_TAC(FINITE_IMAGE_INJ_EQ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            REAL_OF_NUM_EQ,
            REAL_FIELD(
              @hol|{a < b ==> (a + (b - a) / (&n + &2) = a + (b - a) / (&m + &2) <=>
                 &n:real = &m)}|
            )
          ]
        ),
        ALL_TAC
      ] then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REPEAT(CONJ_TAC) then_tac \
      REPEAT(GEN_TAC) then_list \
      PairList [
        DISCH_THEN(
          o(
            o(MP_TAC)(
              SPEC(
                @hol|{{x:real | a < x /\ x < a + &1}}|
              )
            )
          )(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ])(FINITE_SUBSET)))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [SUBSET, IN_ELIM_THM]) then_tac \
        REAL_ARITH_TAC,
        DISCH_THEN(
          o(
            o(MP_TAC)(
              SPEC(
                @hol|{{x:real | a < x /\ x < a + &1}}|
              )
            )
          )(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ])(FINITE_SUBSET)))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [SUBSET, IN_ELIM_THM]) then_tac \
        REAL_ARITH_TAC,
        DISCH_THEN(
          o(
            o(MP_TAC)(
              SPEC(
                @hol|{{x:real | b - &1 < x /\ x < b}}|
              )
            )
          )(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ])(FINITE_SUBSET)))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [SUBSET, IN_ELIM_THM]) then_tac \
        REAL_ARITH_TAC,
        DISCH_THEN(
          o(
            o(MP_TAC)(
              SPEC(
                @hol|{{x:real | b - &1 < x /\ x < b}}|
              )
            )
          )(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ])(FINITE_SUBSET)))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [SUBSET, IN_ELIM_THM]) then_tac \
        REAL_ARITH_TAC,
        REWRITE_TAC(
          PairList [
            REAL_ARITH(
              @hol|{a:real <= x /\ x < b <=> (a < x /\ x < b) \/ ~(b <= a) /\ x = a}|
            )
          ]
        ),
        REWRITE_TAC(
          PairList [
            REAL_ARITH(
              @hol|{a:real < x /\ x <= b <=> (a < x /\ x < b) \/ ~(b <= a) /\ x = b}|
            )
          ]
        ),
        ASM_CASES_TAC(@hol|{b:real = a}|) then_tac \
        ASM_SIMP_TAC(PairList [REAL_LE_ANTISYM, REAL_LE_REFL, SING_GSPEC, FINITE_SING]) then_tac \
        ASM_SIMP_TAC(
          PairList [
            REAL_ARITH(
              @hol|{~(b:real = a) ==>
                 (a <= x /\ x <= b <=> (a < x /\ x < b) \/ ~(b <= a) /\ x = a \/
                 ~(b <= a) /\ x = b)}|
            )
          ]
        )
      ] then_tac \
      ASM_REWRITE_TAC(
        PairList [
          FINITE_UNION,
          SET_RULE(
            @hol|{{x | p x \/ q x} = {x | p x} UNION {x | q x}}|
          )
        ]
      ) then_tac \
      ASM_CASES_TAC(
        @hol|{b:real <= a}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [EMPTY_GSPEC, FINITE_EMPTY])
    ]
  )

def real_INFINITE:
  prove(
    [
      @hol|{INFINITE(:real)}|,
      REWRITE_TAC(PairList [INFINITE]) then_tac \
      DISCH_THEN(
        o(
          o(MP_TAC)(
            SPEC(
              @hol|{{x:real | &0 <= x}}|
            )
          )
        )(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ])(FINITE_SUBSET)))
      ) then_tac \
      REWRITE_TAC(PairList [FINITE_REAL_INTERVAL, SUBSET_UNIV])
    ]
  )

def HAS_SIZE_INDEX:
  prove(
    [
      @hol|{!s n. s HAS_SIZE n
         ==> ?f:num->A. (!m. m < n ==> f(m) IN s) /\
                        (!x. x IN s ==> ?!m. m < n /\ (f m = x))}|,
      ONCE_REWRITE_TAC(PairList [SWAP_FORALL_THM]) then_tac INDUCT_TAC then_tac \
      SIMP_TAC(PairList [HAS_SIZE_0, HAS_SIZE_SUC, LT, NOT_IN_EMPTY]) then_tac \
      X_GEN_TAC(@hol|{s:A->bool}|) then_tac \
      REWRITE_TAC(PairList [EXTENSION, NOT_IN_EMPTY]) then_tac \
      REWRITE_TAC(PairList [NOT_FORALL_THM]) then_tac \
      DISCH_THEN(
        CONJUNCTS_THEN2(X_CHOOSE_TAC(@hol|{a:A}|))(o(MP_TAC)(SPEC(@hol|{a:A}|)))
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_TAC then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPEC(
            @hol|{s DELETE (a:A)}|
          )
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{f:num->A}|)(STRIP_ASSUME_TAC)) then_tac \
      EXISTS_TAC(
        @hol|{\m:num. if m < n then f(m) else a:A}|
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        GEN_TAC then_tac REWRITE_TAC(PairList []) then_tac COND_CASES_TAC then_tac \
        ASM_MESON_TAC(PairList [IN_DELETE]),
        ALL_TAC
      ] then_tac \
      X_GEN_TAC(@hol|{x:A}|) then_tac \
      DISCH_TAC then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(SPEC(@hol|{x:A}|))) then_tac \
      ASM_REWRITE_TAC(PairList [IN_DELETE]) then_tac \
      CONV_TAC(ONCE_DEPTH_CONV(COND_ELIM_CONV)) then_tac \
      ASM_CASES_TAC(@hol|{a:A = x}|) then_tac \
      ASM_SIMP_TAC(PairList []) then_tac \
      ASM_MESON_TAC(PairList [LT_REFL, IN_DELETE])
    ]
  )

def INFINITE_ENUMERATE:
  prove(
    [
      @hol|{!s:num->bool.
         INFINITE s
         ==> ?r:num->num. (!m n. m < n ==> r(m) < r(n)) /\
                          IMAGE r (:num) = s}|,
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{!n:num. ?x. n <= x /\ x IN s}|
      )(MP_TAC) then_list \
      PairList [
        ASM_MESON_TAC(PairList [INFINITE, num_FINITE, LT_IMP_LE, NOT_LE]),
        GEN_REWRITE_TAC(o(LAND_CONV)(BINDER_CONV))(PairList [num_WOP])
      ] then_tac \
      REWRITE_TAC(PairList [SKOLEM_THM, LEFT_IMP_EXISTS_THM, FORALL_AND_THM]) then_tac \
      REWRITE_TAC(
        PairList [
          TAUT(
            @hol|{p ==> ~(q /\ r) <=> q /\ p ==> ~r}|
          )
        ]
      ) then_tac \
      X_GEN_TAC(@hol|{next:num->num}|) then_tac \
      STRIP_TAC then_tac \
      o(MP_TAC)(prove_recursive_functions_exist(num_RECURSION))(
        @hol|{(f(0) = next 0) /\ (!n. f(SUC n) = next(f n + 1))}|
      ) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      X_GEN_TAC(@hol|{r:num->num}|) then_tac \
      STRIP_TAC then_tac \
      MATCH_MP_TAC(
        TAUT(
          @hol|{p /\ (p ==> q) ==> p /\ q}|
        )
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        GEN_TAC then_tac INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [LT]) then_tac \
        ASM_MESON_TAC(
          PairList [
            ARITH_RULE(
              @hol|{m <= n /\ n + 1 <= p ==> m < p}|
            ),
            LE_LT
          ]
        ),
        DISCH_TAC
      ] then_tac \
      ASM_REWRITE_TAC(PairList [GSYM(SUBSET_ANTISYM_EQ), FORALL_IN_IMAGE, SUBSET]) then_tac \
      REWRITE_TAC(PairList [IN_IMAGE, IN_UNIV]) then_tac \
      CONJ_TAC then_list \
      PairList [INDUCT_TAC then_tac ASM_MESON_TAC(PairList []), ALL_TAC] then_tac \
      MATCH_MP_TAC(num_WF) then_tac \
      X_GEN_TAC(@hol|{n:num}|) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      ASM_CASES_TAC(
        @hol|{?m:num. m < n /\ m IN s}|
      ) then_list \
      PairList [
        MP_TAC(
          SPEC(
            @hol|{\m:num. m < n /\ m IN s}|
          )(num_MAX)
        ) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        MATCH_MP_TAC(
          TAUT(
            @hol|{p /\ (q ==> r) ==> (p <=> q) ==> r}|
          )
        ) then_tac \
        CONJ_TAC then_list \
        PairList [MESON_TAC(PairList [LT_IMP_LE]), ALL_TAC] then_tac \
        DISCH_THEN(X_CHOOSE_THEN(@hol|{p:num}|)(STRIP_ASSUME_TAC)) then_tac \
        SUBGOAL_THEN(
          @hol|{?q. p = (r:num->num) q}|
        )(CHOOSE_THEN(SUBST_ALL_TAC)) then_list \
        PairList [
          ASM_MESON_TAC(PairList []),
          EXISTS_TAC(@hol|{SUC q}|)
        ] then_tac \
        ASM_REWRITE_TAC(PairList [GSYM(LE_ANTISYM), GSYM(NOT_LT)]) then_tac \
        ASM_MESON_TAC(
          PairList [
            NOT_LE,
            ARITH_RULE(
              @hol|{r < p <=> r + 1 <= p}|
            )
          ]
        ),
        EXISTS_TAC(@hol|{0}|) then_tac \
        ASM_REWRITE_TAC(PairList [GSYM(LE_ANTISYM), GSYM(NOT_LT)]) then_tac \
        ASM_MESON_TAC(PairList [LE_0])
      ]
    ]
  )

def INFINITE_ENUMERATE_EQ:
  prove(
    [
      @hol|{!s:num->bool.
         INFINITE s <=> ?r. (!m n:num. m < n ==> r m < r n) /\ IMAGE r (:num) = s}|,
      GEN_TAC then_tac EQ_TAC then_tac \
      REWRITE_TAC(PairList [INFINITE_ENUMERATE]) then_tac \
      DISCH_THEN(
        X_CHOOSE_THEN(@hol|{r:num->num}|)(o(STRIP_ASSUME_TAC)(GSYM))
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      MATCH_MP_TAC(INFINITE_IMAGE) then_tac \
      REWRITE_TAC(PairList [num_INFINITE, IN_UNIV]) then_tac \
      MATCH_MP_TAC(WLOG_LT) then_tac \
      ASM_MESON_TAC(PairList [LT_REFL])
    ]
  )

def INFINITE_ENUMERATE_SUBSET:
  prove(
    [
      @hol|{!s. INFINITE s <=>
         ?f:num->A. (!x. f x IN s) /\ (!x y. f x = f y ==> x = y)}|,
      GEN_TAC then_tac EQ_TAC then_tac STRIP_TAC then_list \
      PairList [
        SUBGOAL_THEN(
          @hol|{?f:num->A. !n. f n IN s /\ !m. m < n ==> ~(f m = f n)}|
        )(MP_TAC) then_list \
        PairList [
          MATCH_MP_TAC(MATCH_MP(WF_REC_EXISTS)(WF_num)) then_tac \
          SIMP_TAC(PairList []) then_tac \
          MAP_EVERY(X_GEN_TAC)(PairList [@hol|{f:num->A}|, @hol|{n:num}|]) then_tac \
          STRIP_TAC then_tac \
          FIRST_ASSUM(
            o(
              o(MP_TAC)(
                SPEC(
                  @hol|{IMAGE (f:num->A) {m | m < n}}|
                )
              )
            )(MATCH_MP(REWRITE_RULE(PairList [IMP_CONJ])(INFINITE_DIFF_FINITE)))
          ) then_tac \
          SIMP_TAC(PairList [FINITE_IMAGE, FINITE_NUMSEG_LT]) then_tac \
          DISCH_THEN(o(MP_TAC)(MATCH_MP(INFINITE_NONEMPTY))) then_tac \
          SET_TAC(PairList []),
          MATCH_MP_TAC(MONO_EXISTS) then_tac GEN_TAC then_tac STRIP_TAC then_tac \
          ASM_REWRITE_TAC(PairList []) then_tac \
          MATCH_MP_TAC(WLOG_LT) then_tac \
          ASM(SET_TAC)(PairList [])
        ],
        MATCH_MP_TAC(INFINITE_SUPERSET) then_tac \
        EXISTS_TAC(
          @hol|{IMAGE (f:num->A) (:num)}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList [SUBSET, FORALL_IN_IMAGE]) then_tac \
        ASM_MESON_TAC(PairList [INFINITE_IMAGE_INJ, num_INFINITE])
      ]
    ]
  )

def set_of_list:
  new_recursive_definition(list_RECURSION)(
    @hol|{(set_of_list ([]:A list) = {}) /\
       (set_of_list (CONS (h:A) t) = h INSERT (set_of_list t))}|
  )

def list_of_set:
  new_definition(
    @hol|{list_of_set s = @l:A list. set_of_list l = s /\ LENGTH l = CARD s}|
  )

def LIST_OF_SET_PROPERTIES:
  prove(
    [
      @hol|{!s:A->bool. FINITE(s)
         ==> (set_of_list(list_of_set s) = s) /\
             (LENGTH(list_of_set s) = CARD s)}|,
      REWRITE_TAC(PairList [list_of_set]) then_tac \
      CONV_TAC(BINDER_CONV(RAND_CONV(SELECT_CONV))) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REPEAT(STRIP_TAC) then_list \
      PairList [
        EXISTS_TAC(@hol|{[]:A list}|) then_tac \
        REWRITE_TAC(PairList [CARD_CLAUSES, LENGTH, set_of_list]),
        EXISTS_TAC(
          @hol|{CONS (x:A) l}|
        ) then_tac \
        ASM_REWRITE_TAC(PairList [LENGTH]) then_tac \
        ASM_REWRITE_TAC(PairList [set_of_list]) then_tac \
        FIRST_ASSUM((fun(th): REWRITE_TAC(PairList [MATCH_MP(CONJUNCT2(CARD_CLAUSES))(th)]))) then_tac \
        ASM_REWRITE_TAC(PairList [])
      ]
    ]
  )

def SET_OF_LIST_OF_SET:
  prove(
    [
      @hol|{!s:A->bool. FINITE(s) ==> (set_of_list(list_of_set s) = s)}|,
      MESON_TAC(PairList [LIST_OF_SET_PROPERTIES])
    ]
  )

def LENGTH_LIST_OF_SET:
  prove(
    [
      @hol|{!s:A->bool. FINITE(s) ==> (LENGTH(list_of_set s) = CARD s)}|,
      MESON_TAC(PairList [LIST_OF_SET_PROPERTIES])
    ]
  )

def MEM_LIST_OF_SET:
  prove(
    [
      @hol|{!s:A->bool. FINITE(s) ==> !x. MEM x (list_of_set s) <=> x IN s}|,
      GEN_TAC then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(SET_OF_LIST_OF_SET))) then_tac \
      DISCH_THEN(
        (fun(th): GEN_REWRITE_TAC(o(BINDER_CONV)(funpow(2)(RAND_CONV)))(PairList [GSYM(th)]))
      ) then_tac \
      SPEC_TAC(
        [
          @hol|{list_of_set(s:A->bool)}|,
          @hol|{l:A list}|
        ]
      ) then_tac \
      LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [MEM, set_of_list, NOT_IN_EMPTY]) then_tac \
      ASM_REWRITE_TAC(PairList [IN_INSERT])
    ]
  )

def FINITE_SET_OF_LIST:
  prove(
    [
      @hol|{!l:A list. FINITE(set_of_list l)}|,
      LIST_INDUCT_TAC then_tac ASM_SIMP_TAC(PairList [set_of_list, sets_FINITE_RULES_v2])
    ]
  )

def IN_SET_OF_LIST:
  prove(
    [
      @hol|{!x l:A list. x IN (set_of_list l) <=> MEM x l}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY, MEM, set_of_list]) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def SET_OF_LIST_APPEND:
  prove(
    [
      @hol|{!l1 l2:A list.
         set_of_list(APPEND l1 l2) = set_of_list(l1) UNION set_of_list(l2)}|,
      REWRITE_TAC(PairList [EXTENSION, IN_SET_OF_LIST, IN_UNION, MEM_APPEND])
    ]
  )

def SET_OF_LIST_MAP:
  prove(
    [
      @hol|{!(f:A->B) l. set_of_list(MAP f l) = IMAGE f (set_of_list l)}|,
      GEN_TAC then_tac LIST_INDUCT_TAC then_tac \
      ASM_REWRITE_TAC(PairList [set_of_list, MAP, IMAGE_CLAUSES])
    ]
  )

def SET_OF_LIST_EQ_EMPTY:
  prove(
    [
      @hol|{!l:A list. set_of_list l = {} <=> l = []}|,
      LIST_INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [set_of_list, NOT_CONS_NIL, NOT_INSERT_EMPTY])
    ]
  )

def LIST_OF_SET_EMPTY:
  prove(
    [
      @hol|{list_of_set {}:A list = []}|,
      REWRITE_TAC(PairList [GSYM(LENGTH_EQ_NIL)]) then_tac \
      SIMP_TAC(PairList [LENGTH_LIST_OF_SET, FINITE_EMPTY, CARD_CLAUSES])
    ]
  )

def LIST_OF_SET_SING:
  prove(
    [
      @hol|{!a:A. list_of_set {a} = [a]}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [list_of_set]) then_tac \
      MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      MATCH_MP_TAC(list_INDUCT) then_tac \
      REWRITE_TAC(PairList [NOT_CONS_NIL]) then_tac \
      SIMP_TAC(PairList [LENGTH, CARD_CLAUSES, FINITE_EMPTY, NOT_IN_EMPTY, NOT_SUC]) then_tac \
      GEN_TAC then_tac \
      LIST_INDUCT_TAC then_tac \
      DISCH_THEN(K(ALL_TAC)) then_tac \
      SIMP_TAC(
        PairList [
          LENGTH,
          set_of_list,
          CONS_11,
          SUC_INJ,
          NOT_CONS_NIL,
          NOT_SUC
        ]
      ) then_tac \
      SET_TAC(PairList [])
    ]
  )

def dest_setenum:
  let fn = splitlist(dest_binary("INSERT"))
  fun(tm):
    let [l, n] = fn(tm)
    (if (is_const(n) && (fst(dest_const(n)) == "EMPTY")) | l | failwith("dest_setenum: not a finite set enumeration"))

def is_setenum = can(dest_setenum)

def mk_setenum:
  let insert_atm = @hol|{(INSERT):A->(A->bool)->(A->bool)}|
  let nil_atm = @hol|{(EMPTY):A->bool}|
  fun([l, ty]):
    let insert_tm = inst(PairList [[ty, aty]])(insert_atm)
    let nil_tm = inst(PairList [[ty, aty]])(nil_atm)
    itlist(mk_binop(insert_tm))(l)(nil_tm)

fun mk_fset(l): mk_setenum([l, type_of(hd(l))])

def pairwise:
  new_definition(
    @hol|{pairwise r (s:A->bool) <=> !x y. x IN s /\ y IN s /\ ~(x = y) ==> r x y}|
  )

def PAIRWISE_EMPTY:
  prove(
    [
      @hol|{!r:A->A->bool. pairwise r {} <=> T}|,
      REWRITE_TAC(PairList [pairwise, NOT_IN_EMPTY]) then_tac MESON_TAC(PairList [])
    ]
  )

def PAIRWISE_SING:
  prove(
    [
      @hol|{!r x:A. pairwise r {x} <=> T}|,
      REWRITE_TAC(PairList [pairwise, IN_SING]) then_tac MESON_TAC(PairList [])
    ]
  )

def PAIRWISE_IMP:
  prove(
    [
      @hol|{!P Q s:A->bool.
         pairwise P s /\
         (!x y. x IN s /\ y IN s /\ P x y /\ ~(x = y) ==> Q x y)
         ==> pairwise Q s}|,
      REWRITE_TAC(PairList [pairwise]) then_tac SET_TAC(PairList [])
    ]
  )

def PAIRWISE_MONO:
  prove(
    [
      @hol|{!(r:A->A->bool) s t. pairwise r s /\ t SUBSET s ==> pairwise r t}|,
      REWRITE_TAC(PairList [pairwise]) then_tac SET_TAC(PairList [])
    ]
  )

def PAIRWISE_AND:
  prove(
    [
      @hol|{!R R' s. pairwise R s /\ pairwise R' s <=>
         pairwise (\x y:A. R x y /\ R' x y) s}|,
      REWRITE_TAC(PairList [pairwise]) then_tac SET_TAC(PairList [])
    ]
  )

def PAIRWISE_INSERT:
  prove(
    [
      @hol|{!r x s.
         pairwise r (x INSERT s) <=>
         (!y:A. y IN s /\ ~(y = x) ==> r x y /\ r y x) /\
         pairwise r s}|,
      REWRITE_TAC(PairList [pairwise, IN_INSERT]) then_tac MESON_TAC(PairList [])
    ]
  )

def PAIRWISE_INSERT_SYMMETRIC:
  prove(
    [
      @hol|{!r (x:A) s.
         (!y. y IN s ==> (r x y <=> r y x))
         ==> (pairwise r (x INSERT s) <=>
              (!y. y IN s /\ ~(y = x) ==> r x y) /\ pairwise r s)}|,
      REWRITE_TAC(PairList [PAIRWISE_INSERT]) then_tac MESON_TAC(PairList [])
    ]
  )

def PAIRWISE_IMAGE:
  prove(
    [
      @hol|{!r (f:A->B).
         pairwise r (IMAGE f s) <=>
         pairwise (\x y. ~(f x = f y) ==> r (f x) (f y)) s}|,
      REWRITE_TAC(PairList [pairwise, IN_IMAGE]) then_tac MESON_TAC(PairList [])
    ]
  )

def PAIRWISE_UNION:
  prove(
    [
      @hol|{!R s t. pairwise R (s UNION t) <=>
         pairwise R s /\ pairwise R t /\
         (!x y:A. x IN s DIFF t /\ y IN t DIFF s ==> R x y /\ R y x)}|,
      REWRITE_TAC(PairList [pairwise]) then_tac SET_TAC(PairList [])
    ]
  )

def PAIRWISE_CHAIN_UNIONS:
  prove(
    [
      @hol|{!R:A->A->bool c.
         (!s. s IN c ==> pairwise R s) /\
         (!s t. s IN c /\ t IN c ==> s SUBSET t \/ t SUBSET s)
         ==> pairwise R (UNIONS c)}|,
      REWRITE_TAC(PairList [pairwise]) then_tac SET_TAC(PairList [])
    ]
  )

def DIFF_UNIONS_PAIRWISE_DISJOINT:
  prove(
    [
      @hol|{!s t:(A->bool)->bool.
         pairwise DISJOINT s /\ t SUBSET s
         ==> UNIONS s DIFF UNIONS t = UNIONS(s DIFF t)}|,
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(
        SET_RULE(
          @hol|{t UNION u = s /\ DISJOINT t u ==> s DIFF t = u}|
        )
      ) then_tac \
      CONJ_TAC then_list \
      PairList [
        REWRITE_TAC(PairList [GSYM(UNIONS_UNION)]) then_tac AP_TERM_TAC then_tac \
        ASM(SET_TAC)(PairList []),
        REWRITE_TAC(PairList [DISJOINT, INTER_UNIONS, EMPTY_UNIONS, FORALL_IN_GSPEC]) then_tac \
        FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [pairwise]))) then_tac \
        REWRITE_TAC(PairList [DISJOINT, IN_DIFF]) then_tac \
        REPEAT(STRIP_TAC) then_tac \
        FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
        REPEAT(CONJ_TAC then_list PairList [ASM(SET_TAC)(PairList []), ALL_TAC]) then_tac \
        ASM_MESON_TAC(PairList [])
      ]
    ]
  )

def INTER_UNIONS_PAIRWISE_DISJOINT:
  prove(
    [
      @hol|{!s t:(A->bool)->bool.
         pairwise DISJOINT (s UNION t)
         ==> UNIONS s INTER UNIONS t = UNIONS(s INTER t)}|,
      REPEAT(GEN_TAC) then_tac \
      REWRITE_TAC(PairList [INTER_UNIONS, SIMPLE_IMAGE, UNIONS_IMAGE]) then_tac \
      GEN_REWRITE_TAC(RAND_CONV)(PairList [EXTENSION]) then_tac \
      REWRITE_TAC(PairList [pairwise, IN_UNIONS, IN_INTER, IN_ELIM_THM, IN_UNION]) then_tac \
      DISCH_TAC then_tac \
      X_GEN_TAC(@hol|{z:A}|) then_tac \
      REWRITE_TAC(PairList [RIGHT_AND_EXISTS_THM]) then_tac \
      EQ_TAC then_list \
      PairList [
        REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM]),
        MESON_TAC(PairList [])
      ] then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{u:A->bool}|,
          @hol|{v:A->bool}|
        ]
      ) then_tac \
      STRIP_TAC then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPECL(
            PairList [
              @hol|{u:A->bool}|,
              @hol|{v:A->bool}|
            ]
          )
        )
      ) then_tac \
      ASM_CASES_TAC(
        @hol|{u:A->bool = v}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_list \
      PairList [ASM_MESON_TAC(PairList []), ASM(SET_TAC)(PairList [])]
    ]
  )

def PSUBSET_UNIONS_PAIRWISE_DISJOINT:
  prove(
    [
      @hol|{!u v:(A->bool)->bool.
         pairwise DISJOINT v /\ u PSUBSET (v DELETE {})
         ==> UNIONS u PSUBSET UNIONS v}|,
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(
        SET_RULE(
          @hol|{u SUBSET v /\ ~(v DIFF u = {}) ==> u PSUBSET v}|
        )
      ) then_tac \
      CONJ_TAC then_list \
      PairList [ASM(SET_TAC)(PairList []), ALL_TAC] then_tac \
      W(
        o(
          o(
            o(
              o(MP_TAC)(PART_MATCH(o(lhand)(rand))(DIFF_UNIONS_PAIRWISE_DISJOINT))
            )(lhand)
          )(rand)
        )(snd)
      ) then_tac \
      ANTS_TAC then_list \
      PairList [ASM(SET_TAC)(PairList []), DISCH_THEN(SUBST1_TAC)] then_tac \
      REWRITE_TAC(PairList [EMPTY_UNIONS]) then_tac \
      FIRST_ASSUM(o(o(MP_TAC)(CONJUNCT2))(GEN_REWRITE_RULE(I)(PairList [PSUBSET_ALT]))) then_tac \
      REWRITE_TAC(PairList [IN_DELETE, IN_DIFF]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

Host.parse_as_infix(["UNION_OF", [20, "right"]])

Host.parse_as_infix(["INTERSECTION_OF", [20, "right"]])

def UNION_OF:
  new_definition(
    @hol|{P UNION_OF Q =
       \s:A->bool. ?u. P u /\ (!c. c IN u ==> Q c) /\ UNIONS u = s}|
  )

def INTERSECTION_OF:
  new_definition(
    @hol|{P INTERSECTION_OF Q =
       \s:A->bool. ?u. P u /\ (!c. c IN u ==> Q c) /\ INTERS u = s}|
  )

def UNION_OF_INC:
  prove(
    [
      @hol|{!P Q s:A->bool. P {s} /\ Q s ==> (P UNION_OF Q) s}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [UNION_OF]) then_tac \
      EXISTS_TAC(
        @hol|{{s:A->bool}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [UNIONS_1, IN_SING])
    ]
  )

def INTERSECTION_OF_INC:
  prove(
    [
      @hol|{!P Q s:A->bool. P {s} /\ Q s ==> (P INTERSECTION_OF Q) s}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [INTERSECTION_OF]) then_tac \
      EXISTS_TAC(
        @hol|{{s:A->bool}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [INTERS_1, IN_SING])
    ]
  )

def UNION_OF_MONO:
  prove(
    [
      @hol|{!P Q Q' s:A->bool.
         (P UNION_OF Q) s /\ (!x. Q x ==> Q' x) ==> (P UNION_OF Q') s}|,
      REWRITE_TAC(PairList [UNION_OF]) then_tac MESON_TAC(PairList [])
    ]
  )

def INTERSECTION_OF_MONO:
  prove(
    [
      @hol|{!P Q Q' s:A->bool.
         (P INTERSECTION_OF Q) s /\ (!x. Q x ==> Q' x)
         ==> (P INTERSECTION_OF Q') s}|,
      REWRITE_TAC(PairList [INTERSECTION_OF]) then_tac MESON_TAC(PairList [])
    ]
  )

def FORALL_UNION_OF:
  prove(
    [
      @hol|{(!s:A->bool. (P UNION_OF Q) s ==> R s) <=>
         (!t. P t /\ (!c. c IN t ==> Q c) ==> R(UNIONS t))}|,
      REWRITE_TAC(PairList [UNION_OF]) then_tac MESON_TAC(PairList [])
    ]
  )

def FORALL_INTERSECTION_OF:
  prove(
    [
      @hol|{(!s:A->bool. (P INTERSECTION_OF Q) s ==> R s) <=>
         (!t. P t /\ (!c. c IN t ==> Q c) ==> R(INTERS t))}|,
      REWRITE_TAC(PairList [INTERSECTION_OF]) then_tac MESON_TAC(PairList [])
    ]
  )

def UNION_OF_EMPTY:
  prove(
    [
      @hol|{!P Q:(A->bool)->bool. P {} ==> (P UNION_OF Q) {}}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [UNION_OF]) then_tac \
      EXISTS_TAC(@hol|{{}:(A->bool)->bool}|) then_tac \
      ASM_REWRITE_TAC(PairList [UNIONS_0, NOT_IN_EMPTY])
    ]
  )

def INTERSECTION_OF_EMPTY:
  prove(
    [
      @hol|{!P Q:(A->bool)->bool. P {} ==> (P INTERSECTION_OF Q) UNIV}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [INTERSECTION_OF]) then_tac \
      EXISTS_TAC(@hol|{{}:(A->bool)->bool}|) then_tac \
      ASM_REWRITE_TAC(PairList [INTERS_0, NOT_IN_EMPTY])
    ]
  )

def ARBITRARY:
  new_definition(
    @hol|{ARBITRARY (s:(A->bool)->bool) <=> T}|
  )

def ARBITRARY_UNION_OF_ALT:
  prove(
    [
      @hol|{!B s:A->bool.
         (ARBITRARY UNION_OF B) s <=>
         !x. x IN s ==>  ?u. u IN B /\ x IN u /\ u SUBSET s}|,
      GEN_TAC then_tac \
      REWRITE_TAC(
        PairList [
          FORALL_AND_THM,
          TAUT(
            @hol|{(p <=> q) <=> (p ==> q) /\ (q ==> p)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [FORALL_UNION_OF, ARBITRARY]) then_tac \
      CONJ_TAC then_list \
      PairList [SET_TAC(PairList []), ALL_TAC] then_tac \
      X_GEN_TAC(@hol|{s:A->bool}|) then_tac \
      DISCH_TAC then_tac \
      REWRITE_TAC(PairList [ARBITRARY, UNION_OF]) then_tac \
      EXISTS_TAC(
        @hol|{{u:A->bool | u IN B /\ u SUBSET s}}|
      ) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def ARBITRARY_UNION_OF_EMPTY:
  prove(
    [
      @hol|{!P:(A->bool)->bool. (ARBITRARY UNION_OF P) {}}|,
      SIMP_TAC(PairList [UNION_OF_EMPTY, ARBITRARY])
    ]
  )

def ARBITRARY_INTERSECTION_OF_EMPTY:
  prove(
    [
      @hol|{!P:(A->bool)->bool. (ARBITRARY INTERSECTION_OF P) UNIV}|,
      SIMP_TAC(PairList [INTERSECTION_OF_EMPTY, ARBITRARY])
    ]
  )

def ARBITRARY_UNION_OF_INC:
  prove(
    [
      @hol|{!P s:A->bool. P s ==> (ARBITRARY UNION_OF P) s}|,
      SIMP_TAC(PairList [UNION_OF_INC, ARBITRARY])
    ]
  )

def ARBITRARY_INTERSECTION_OF_INC:
  prove(
    [
      @hol|{!P s:A->bool. P s ==> (ARBITRARY INTERSECTION_OF P) s}|,
      SIMP_TAC(PairList [INTERSECTION_OF_INC, ARBITRARY])
    ]
  )

def ARBITRARY_UNION_OF_COMPLEMENT:
  prove(
    [
      @hol|{!P s. (ARBITRARY UNION_OF P) s <=>
         (ARBITRARY INTERSECTION_OF (\s. P((:A) DIFF s))) ((:A) DIFF s)}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [UNION_OF, INTERSECTION_OF]) then_tac \
      EQ_TAC then_tac \
      DISCH_THEN(
        X_CHOOSE_THEN(@hol|{u:(A->bool)->bool}|)(STRIP_ASSUME_TAC)
      ) then_tac \
      EXISTS_TAC(
        @hol|{IMAGE (\c. (:A) DIFF c) u}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [ARBITRARY, FORALL_IN_IMAGE, COMPL_COMPL]) then_tac \
      ONCE_REWRITE_TAC(PairList [UNIONS_INTERS, INTERS_UNIONS]) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{{f y | y IN IMAGE g s} = IMAGE (\x. f(g x)) s}|
          )
        ]
      ) then_tac \
      ASM_REWRITE_TAC(PairList [IMAGE_ID, COMPL_COMPL])
    ]
  )

def ARBITRARY_INTERSECTION_OF_COMPLEMENT:
  prove(
    [
      @hol|{!P s. (ARBITRARY INTERSECTION_OF P) s <=>
         (ARBITRARY UNION_OF (\s. P((:A) DIFF s))) ((:A) DIFF s)}|,
      REWRITE_TAC(PairList [ARBITRARY_UNION_OF_COMPLEMENT]) then_tac \
      REWRITE_TAC(PairList [ETA_AX, COMPL_COMPL])
    ]
  )

def ARBITRARY_UNION_OF_IDEMPOT:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         ARBITRARY UNION_OF ARBITRARY UNION_OF P = ARBITRARY UNION_OF P}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
      X_GEN_TAC(@hol|{s:A->bool}|) then_tac \
      EQ_TAC then_tac \
      REWRITE_TAC(PairList [ARBITRARY_UNION_OF_INC]) then_tac \
      REWRITE_TAC(PairList [UNION_OF, LEFT_IMP_EXISTS_THM]) then_tac \
      X_GEN_TAC(@hol|{u:(A->bool)->bool}|) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC)) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(MP_TAC)(o(SUBST1_TAC)(SYM))) then_tac \
      GEN_REWRITE_TAC(o(LAND_CONV)(ONCE_DEPTH_CONV))(PairList [RIGHT_IMP_EXISTS_THM]) then_tac \
      REWRITE_TAC(PairList [SKOLEM_THM, LEFT_IMP_EXISTS_THM]) then_tac \
      X_GEN_TAC(@hol|{f:(A->bool)->(A->bool)->bool}|) then_tac \
      DISCH_TAC then_tac \
      EXISTS_TAC(
        @hol|{IMAGE SND {s,t | s IN u /\ t IN (f:(A->bool)->(A->bool)->bool) s}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [ARBITRARY]) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_IMAGE, FORALL_IN_GSPEC]) then_tac \
      CONJ_TAC then_list \
      PairList [ASM(SET_TAC)(PairList []), REWRITE_TAC(PairList [UNIONS_IMAGE])] then_tac \
      REWRITE_TAC(PairList [EXISTS_IN_GSPEC]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def ARBITRARY_INTERSECTION_OF_IDEMPOT:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         ARBITRARY INTERSECTION_OF ARBITRARY INTERSECTION_OF P =
         ARBITRARY INTERSECTION_OF P}|,
      REWRITE_TAC(
        PairList [
          COMPL_COMPL,
          ETA_AX,
          REWRITE_RULE(PairList [GSYM(FUN_EQ_THM), ETA_AX])(ARBITRARY_INTERSECTION_OF_COMPLEMENT)
        ]
      ) then_tac \
      REWRITE_TAC(PairList [ARBITRARY_UNION_OF_IDEMPOT])
    ]
  )

def ARBITRARY_UNION_OF_UNIONS:
  prove(
    [
      @hol|{!P u:(A->bool)->bool.
         (!s. s IN u ==> (ARBITRARY UNION_OF P) s)
         ==> (ARBITRARY UNION_OF P) (UNIONS u)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(ARBITRARY_UNION_OF_IDEMPOT)]) then_tac \
      ONCE_REWRITE_TAC(PairList [UNION_OF]) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      EXISTS_TAC(@hol|{u:(A->bool)->bool}|) then_tac \
      ASM_REWRITE_TAC(PairList [ARBITRARY])
    ]
  )

def ARBITRARY_UNION_OF_UNION:
  prove(
    [
      @hol|{!P s t:A->bool.
         (ARBITRARY UNION_OF P) s /\ (ARBITRARY UNION_OF P) t
         ==> (ARBITRARY UNION_OF P) (s UNION t)}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [GSYM(UNIONS_2)]) then_tac \
      MATCH_MP_TAC(ARBITRARY_UNION_OF_UNIONS) then_tac \
      ASM_REWRITE_TAC(PairList [ARBITRARY, FORALL_IN_INSERT]) then_tac \
      REWRITE_TAC(PairList [ARBITRARY, NOT_IN_EMPTY])
    ]
  )

def ARBITRARY_INTERSECTION_OF_INTERS:
  prove(
    [
      @hol|{!P u:(A->bool)->bool.
         (!s. s IN u ==> (ARBITRARY INTERSECTION_OF P) s)
         ==> (ARBITRARY INTERSECTION_OF P) (INTERS u)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(ARBITRARY_INTERSECTION_OF_IDEMPOT)]) then_tac \
      ONCE_REWRITE_TAC(PairList [INTERSECTION_OF]) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      EXISTS_TAC(@hol|{u:(A->bool)->bool}|) then_tac \
      ASM_REWRITE_TAC(PairList [ARBITRARY])
    ]
  )

def ARBITRARY_INTERSECTION_OF_INTER:
  prove(
    [
      @hol|{!P s t:A->bool.
         (ARBITRARY INTERSECTION_OF P) s /\ (ARBITRARY INTERSECTION_OF P) t
         ==> (ARBITRARY INTERSECTION_OF P) (s INTER t)}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [GSYM(INTERS_2)]) then_tac \
      MATCH_MP_TAC(ARBITRARY_INTERSECTION_OF_INTERS) then_tac \
      ASM_REWRITE_TAC(PairList [ARBITRARY, FORALL_IN_INSERT]) then_tac \
      REWRITE_TAC(PairList [ARBITRARY, NOT_IN_EMPTY])
    ]
  )

def ARBITRARY_UNION_OF_INTER_EQ:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         (!s t. (ARBITRARY UNION_OF P) s /\ (ARBITRARY UNION_OF P) t
                ==> (ARBITRARY UNION_OF P) (s INTER t)) <=>
         (!s t. P s /\ P t ==> (ARBITRARY UNION_OF P) (s INTER t))}|,
      GEN_TAC then_tac EQ_TAC then_list \
      PairList [MESON_TAC(PairList [ARBITRARY_UNION_OF_INC]), DISCH_TAC] then_tac \
      REPEAT(GEN_TAC) then_tac \
      GEN_REWRITE_TAC(o(LAND_CONV)(ONCE_DEPTH_CONV))(PairList [UNION_OF]) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      DISCH_THEN(o(STRIP_ASSUME_TAC)(GSYM)) then_tac \
      ASM_REWRITE_TAC(PairList [INTER_UNIONS]) then_tac \
      REPLICATE_TAC(2)(
        MATCH_MP_TAC(ARBITRARY_UNION_OF_UNIONS) then_tac \
        ASM_SIMP_TAC(PairList [SIMPLE_IMAGE, ARBITRARY, FORALL_IN_IMAGE]) then_tac \
        REPEAT(STRIP_TAC)
      )
    ]
  )

def ARBITRARY_UNION_OF_INTER:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         (!s t. P s /\ P t ==> P(s INTER t))
         ==> (!s t. (ARBITRARY UNION_OF P) s /\ (ARBITRARY UNION_OF P) t
                    ==> (ARBITRARY UNION_OF P) (s INTER t))}|,
      REWRITE_TAC(PairList [ARBITRARY_UNION_OF_INTER_EQ]) then_tac \
      MESON_TAC(PairList [ARBITRARY_UNION_OF_INC])
    ]
  )

def ARBITRARY_INTERSECTION_OF_UNION_EQ:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         (!s t. (ARBITRARY INTERSECTION_OF P) s /\
                (ARBITRARY INTERSECTION_OF P) t
                ==> (ARBITRARY INTERSECTION_OF P) (s UNION t)) <=>
         (!s t. P s /\ P t ==> (ARBITRARY INTERSECTION_OF P) (s UNION t))}|,
      ONCE_REWRITE_TAC(PairList [ARBITRARY_INTERSECTION_OF_COMPLEMENT]) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{UNIV DIFF (s UNION t) = (UNIV DIFF s) INTER (UNIV DIFF t)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          MESON(
            PairList [COMPL_COMPL])(
            @hol|{(!s. P(UNIV DIFF s)) <=> (!s. P s)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [ARBITRARY_UNION_OF_INTER_EQ]) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{s INTER t = UNIV DIFF ((UNIV DIFF s) UNION (UNIV DIFF t))}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          MESON(
            PairList [COMPL_COMPL])(
            @hol|{(!s. P(UNIV DIFF s)) <=> (!s. P s)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [COMPL_COMPL])
    ]
  )

def ARBITRARY_INTERSECTION_OF_UNION:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         (!s t. P s /\ P t ==> P(s UNION t))
         ==> (!s t. (ARBITRARY INTERSECTION_OF P) s /\
                    (ARBITRARY INTERSECTION_OF P) t
                    ==> (ARBITRARY INTERSECTION_OF P) (s UNION t))}|,
      REWRITE_TAC(PairList [ARBITRARY_INTERSECTION_OF_UNION_EQ]) then_tac \
      MESON_TAC(PairList [ARBITRARY_INTERSECTION_OF_INC])
    ]
  )

def FINITE_UNION_OF_EMPTY:
  prove(
    [
      @hol|{!P:(A->bool)->bool. (FINITE UNION_OF P) {}}|,
      SIMP_TAC(PairList [UNION_OF_EMPTY, FINITE_EMPTY])
    ]
  )

def FINITE_INTERSECTION_OF_EMPTY:
  prove(
    [
      @hol|{!P:(A->bool)->bool. (FINITE INTERSECTION_OF P) UNIV}|,
      SIMP_TAC(PairList [INTERSECTION_OF_EMPTY, FINITE_EMPTY])
    ]
  )

def FINITE_UNION_OF_INC:
  prove(
    [
      @hol|{!P s:A->bool. P s ==> (FINITE UNION_OF P) s}|,
      SIMP_TAC(PairList [UNION_OF_INC, FINITE_SING])
    ]
  )

def FINITE_INTERSECTION_OF_INC:
  prove(
    [
      @hol|{!P s:A->bool. P s ==> (FINITE INTERSECTION_OF P) s}|,
      SIMP_TAC(PairList [INTERSECTION_OF_INC, FINITE_SING])
    ]
  )

def FINITE_UNION_OF_COMPLEMENT:
  prove(
    [
      @hol|{!P s. (FINITE UNION_OF P) s <=>
         (FINITE INTERSECTION_OF (\s. P((:A) DIFF s))) ((:A) DIFF s)}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [UNION_OF, INTERSECTION_OF]) then_tac \
      EQ_TAC then_tac \
      DISCH_THEN(
        X_CHOOSE_THEN(@hol|{u:(A->bool)->bool}|)(STRIP_ASSUME_TAC)
      ) then_tac \
      EXISTS_TAC(
        @hol|{IMAGE (\c. (:A) DIFF c) u}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_IMAGE, FORALL_IN_IMAGE, COMPL_COMPL]) then_tac \
      ONCE_REWRITE_TAC(PairList [UNIONS_INTERS, INTERS_UNIONS]) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{{f y | y IN IMAGE g s} = IMAGE (\x. f(g x)) s}|
          )
        ]
      ) then_tac \
      ASM_REWRITE_TAC(PairList [IMAGE_ID, COMPL_COMPL])
    ]
  )

def FINITE_INTERSECTION_OF_COMPLEMENT:
  prove(
    [
      @hol|{!P s. (FINITE INTERSECTION_OF P) s <=>
         (FINITE UNION_OF (\s. P((:A) DIFF s))) ((:A) DIFF s)}|,
      REWRITE_TAC(PairList [FINITE_UNION_OF_COMPLEMENT]) then_tac \
      REWRITE_TAC(PairList [ETA_AX, COMPL_COMPL])
    ]
  )

def FINITE_UNION_OF_IDEMPOT:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         FINITE UNION_OF FINITE UNION_OF P = FINITE UNION_OF P}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [FUN_EQ_THM]) then_tac \
      X_GEN_TAC(@hol|{s:A->bool}|) then_tac \
      EQ_TAC then_tac \
      REWRITE_TAC(PairList [FINITE_UNION_OF_INC]) then_tac \
      REWRITE_TAC(PairList [UNION_OF, LEFT_IMP_EXISTS_THM]) then_tac \
      X_GEN_TAC(@hol|{u:(A->bool)->bool}|) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC)) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(MP_TAC)(o(SUBST1_TAC)(SYM))) then_tac \
      GEN_REWRITE_TAC(o(LAND_CONV)(ONCE_DEPTH_CONV))(PairList [RIGHT_IMP_EXISTS_THM]) then_tac \
      REWRITE_TAC(PairList [SKOLEM_THM, LEFT_IMP_EXISTS_THM]) then_tac \
      X_GEN_TAC(@hol|{f:(A->bool)->(A->bool)->bool}|) then_tac \
      DISCH_TAC then_tac \
      EXISTS_TAC(
        @hol|{IMAGE SND {s,t | s IN u /\ t IN (f:(A->bool)->(A->bool)->bool) s}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_IMAGE, FINITE_PRODUCT_DEPENDENT]) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_IMAGE, FORALL_IN_GSPEC]) then_tac \
      CONJ_TAC then_list \
      PairList [ASM(SET_TAC)(PairList []), REWRITE_TAC(PairList [UNIONS_IMAGE])] then_tac \
      REWRITE_TAC(PairList [EXISTS_IN_GSPEC]) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def FINITE_INTERSECTION_OF_IDEMPOT:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         FINITE INTERSECTION_OF FINITE INTERSECTION_OF P =
         FINITE INTERSECTION_OF P}|,
      REWRITE_TAC(
        PairList [
          COMPL_COMPL,
          ETA_AX,
          REWRITE_RULE(PairList [GSYM(FUN_EQ_THM), ETA_AX])(FINITE_INTERSECTION_OF_COMPLEMENT)
        ]
      ) then_tac \
      REWRITE_TAC(PairList [FINITE_UNION_OF_IDEMPOT])
    ]
  )

def FINITE_UNION_OF_UNIONS:
  prove(
    [
      @hol|{!P u:(A->bool)->bool.
         FINITE u /\ (!s. s IN u ==> (FINITE UNION_OF P) s)
         ==> (FINITE UNION_OF P) (UNIONS u)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(FINITE_UNION_OF_IDEMPOT)]) then_tac \
      ONCE_REWRITE_TAC(PairList [UNION_OF]) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      EXISTS_TAC(@hol|{u:(A->bool)->bool}|) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def FINITE_UNION_OF_UNION:
  prove(
    [
      @hol|{!P s t:A->bool.
         (FINITE UNION_OF P) s /\ (FINITE UNION_OF P) t
         ==> (FINITE UNION_OF P) (s UNION t)}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [GSYM(UNIONS_2)]) then_tac \
      MATCH_MP_TAC(FINITE_UNION_OF_UNIONS) then_tac \
      ASM_REWRITE_TAC(PairList [FINITE_INSERT, FORALL_IN_INSERT]) then_tac \
      REWRITE_TAC(PairList [FINITE_EMPTY, NOT_IN_EMPTY])
    ]
  )

def FINITE_INTERSECTION_OF_INTERS:
  prove(
    [
      @hol|{!P u:(A->bool)->bool.
         FINITE u /\ (!s. s IN u ==> (FINITE INTERSECTION_OF P) s)
         ==> (FINITE INTERSECTION_OF P) (INTERS u)}|,
      REPEAT(STRIP_TAC) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(FINITE_INTERSECTION_OF_IDEMPOT)]) then_tac \
      ONCE_REWRITE_TAC(PairList [INTERSECTION_OF]) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      EXISTS_TAC(@hol|{u:(A->bool)->bool}|) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def FINITE_INTERSECTION_OF_INTER:
  prove(
    [
      @hol|{!P s t:A->bool.
         (FINITE INTERSECTION_OF P) s /\ (FINITE INTERSECTION_OF P) t
         ==> (FINITE INTERSECTION_OF P) (s INTER t)}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [GSYM(INTERS_2)]) then_tac \
      MATCH_MP_TAC(FINITE_INTERSECTION_OF_INTERS) then_tac \
      ASM_REWRITE_TAC(PairList [FINITE_INSERT, FORALL_IN_INSERT]) then_tac \
      REWRITE_TAC(PairList [FINITE_EMPTY, NOT_IN_EMPTY])
    ]
  )

def FINITE_UNION_OF_INTER_EQ:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         (!s t. (FINITE UNION_OF P) s /\ (FINITE UNION_OF P) t
                    ==> (FINITE UNION_OF P) (s INTER t)) <=>
         (!s t. P s /\ P t ==> (FINITE UNION_OF P) (s INTER t))}|,
      GEN_TAC then_tac EQ_TAC then_list \
      PairList [MESON_TAC(PairList [FINITE_UNION_OF_INC]), DISCH_TAC] then_tac \
      REPEAT(GEN_TAC) then_tac \
      GEN_REWRITE_TAC(o(LAND_CONV)(ONCE_DEPTH_CONV))(PairList [UNION_OF]) then_tac \
      REWRITE_TAC(PairList []) then_tac \
      DISCH_THEN(o(STRIP_ASSUME_TAC)(GSYM)) then_tac \
      ASM_REWRITE_TAC(PairList [INTER_UNIONS]) then_tac \
      REPLICATE_TAC(2)(
        MATCH_MP_TAC(FINITE_UNION_OF_UNIONS) then_tac \
        ASM_SIMP_TAC(PairList [SIMPLE_IMAGE, FINITE_IMAGE, FORALL_IN_IMAGE]) then_tac \
        REPEAT(STRIP_TAC)
      )
    ]
  )

def FINITE_UNION_OF_INTER:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         (!s t. P s /\ P t ==> P(s INTER t))
         ==> (!s t. (FINITE UNION_OF P) s /\ (FINITE UNION_OF P) t
                    ==> (FINITE UNION_OF P) (s INTER t))}|,
      REWRITE_TAC(PairList [FINITE_UNION_OF_INTER_EQ]) then_tac \
      MESON_TAC(PairList [FINITE_UNION_OF_INC])
    ]
  )

def FINITE_INTERSECTION_OF_UNION_EQ:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         (!s t. (FINITE INTERSECTION_OF P) s /\
                (FINITE INTERSECTION_OF P) t
                ==> (FINITE INTERSECTION_OF P) (s UNION t)) <=>
         (!s t. P s /\ P t ==> (FINITE INTERSECTION_OF P) (s UNION t))}|,
      ONCE_REWRITE_TAC(PairList [FINITE_INTERSECTION_OF_COMPLEMENT]) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{UNIV DIFF (s UNION t) = (UNIV DIFF s) INTER (UNIV DIFF t)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          MESON(
            PairList [COMPL_COMPL])(
            @hol|{(!s. P(UNIV DIFF s)) <=> (!s. P s)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [FINITE_UNION_OF_INTER_EQ]) then_tac \
      REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{s INTER t = UNIV DIFF ((UNIV DIFF s) UNION (UNIV DIFF t))}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          MESON(
            PairList [COMPL_COMPL])(
            @hol|{(!s. P(UNIV DIFF s)) <=> (!s. P s)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [COMPL_COMPL])
    ]
  )

def FINITE_INTERSECTION_OF_UNION:
  prove(
    [
      @hol|{!P:(A->bool)->bool.
         (!s t. P s /\ P t ==> P(s UNION t))
         ==> (!s t. (FINITE INTERSECTION_OF P) s /\
                    (FINITE INTERSECTION_OF P) t
                    ==> (FINITE INTERSECTION_OF P) (s UNION t))}|,
      REWRITE_TAC(PairList [FINITE_INTERSECTION_OF_UNION_EQ]) then_tac \
      MESON_TAC(PairList [FINITE_INTERSECTION_OF_INC])
    ]
  )

def CARD_SET_OF_LIST_LE:
  prove(
    [
      @hol|{!l:A list. CARD(set_of_list l) <= LENGTH l}|,
      LIST_INDUCT_TAC then_tac \
      SIMP_TAC(PairList [LENGTH, set_of_list, CARD_CLAUSES, FINITE_SET_OF_LIST]) then_tac \
      ASM_ARITH_TAC
    ]
  )

def HAS_SIZE_SET_OF_LIST:
  prove(
    [
      @hol|{!l. (set_of_list l) HAS_SIZE (LENGTH l) <=> PAIRWISE (\x y:A. ~(x = y)) l}|,
      REWRITE_TAC(PairList [HAS_SIZE, FINITE_SET_OF_LIST]) then_tac LIST_INDUCT_TAC then_tac \
      ASM_SIMP_TAC(
        PairList [
          CARD_CLAUSES,
          LENGTH,
          set_of_list,
          PAIRWISE,
          ALL,
          FINITE_SET_OF_LIST,
          GSYM(ALL_MEM),
          IN_SET_OF_LIST
        ]
      ) then_tac \
      COND_CASES_TAC then_tac \
      ASM_REWRITE_TAC(PairList [SUC_INJ]) then_tac \
      ASM_MESON_TAC(
        PairList [
          CARD_SET_OF_LIST_LE,
          ARITH_RULE(
            @hol|{~(SUC n <= n)}|
          )
        ]
      )
    ]
  )

def SURJECTIVE_IFF_INJECTIVE_GEN:
  prove(
    [
      @hol|{!s t f:A->B.
         FINITE s /\ FINITE t /\ (CARD s = CARD t) /\ (IMAGE f s) SUBSET t
         ==> ((!y. y IN t ==> ?x. x IN s /\ (f x = y)) <=>
              (!x y. x IN s /\ y IN s /\ (f x = f y) ==> (x = y)))}|,
      REPEAT(STRIP_TAC) then_tac EQ_TAC then_tac \
      REPEAT(STRIP_TAC) then_list \
      PairList [
        ASM_CASES_TAC(@hol|{x:A = y}|) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        SUBGOAL_THEN(
          @hol|{CARD s <= CARD (IMAGE (f:A->B) (s DELETE y))}|
        )(MP_TAC) then_list \
        PairList [
          ASM_REWRITE_TAC(PairList []) then_tac MATCH_MP_TAC(CARD_SUBSET) then_tac \
          ASM_SIMP_TAC(PairList [FINITE_IMAGE, FINITE_DELETE]) then_tac \
          REWRITE_TAC(PairList [SUBSET, IN_IMAGE, IN_DELETE]) then_tac \
          ASM_MESON_TAC(PairList []),
          REWRITE_TAC(PairList [NOT_LE]) then_tac MATCH_MP_TAC(LET_TRANS) then_tac \
          EXISTS_TAC(
            @hol|{CARD(s DELETE (y:A))}|
          ) then_tac \
          ASM_SIMP_TAC(PairList [CARD_IMAGE_LE, FINITE_DELETE]) then_tac \
          ASM_SIMP_TAC(
            PairList [
              CARD_DELETE,
              ARITH_RULE(
                @hol|{x - 1 < x <=> ~(x = 0)}|
              )
            ]
          ) then_tac \
          ASM_MESON_TAC(PairList [CARD_EQ_0, MEMBER_NOT_EMPTY])
        ],
        SUBGOAL_THEN(
          @hol|{IMAGE (f:A->B) s = t}|
        )(MP_TAC) then_list \
        PairList [ALL_TAC, ASM_MESON_TAC(PairList [EXTENSION, IN_IMAGE])] then_tac \
        ASM_MESON_TAC(PairList [CARD_SUBSET_EQ, CARD_IMAGE_INJ])
      ]
    ]
  )

def SURJECTIVE_IFF_INJECTIVE:
  prove(
    [
      @hol|{!s f:A->A.
         FINITE s /\ (IMAGE f s) SUBSET s
         ==> ((!y. y IN s ==> ?x. x IN s /\ (f x = y)) <=>
              (!x y. x IN s /\ y IN s /\ (f x = f y) ==> (x = y)))}|,
      SIMP_TAC(PairList [SURJECTIVE_IFF_INJECTIVE_GEN])
    ]
  )

def IMAGE_IMP_INJECTIVE_GEN:
  prove(
    [
      @hol|{!s t f:A->B.
         FINITE s /\ (CARD s = CARD t) /\ (IMAGE f s = t)
         ==> !x y. x IN s /\ y IN s /\ (f x = f y) ==> (x = y)}|,
      REPEAT(GEN_TAC) then_tac DISCH_THEN(o(ASSUME_TAC)(GSYM)) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{s:A->bool}|,
            @hol|{t:B->bool}|,
            @hol|{f:A->B}|
          ])(
          SURJECTIVE_IFF_INJECTIVE_GEN
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [SUBSET_REFL, FINITE_IMAGE]) then_tac \
      ASM_MESON_TAC(PairList [EXTENSION, IN_IMAGE])
    ]
  )

def IMAGE_IMP_INJECTIVE:
  prove(
    [
      @hol|{!s f:A->A.
         FINITE s /\ IMAGE f s = s
         ==> !x y. x IN s /\ y IN s /\ f x = f y ==> x = y}|,
      MESON_TAC(PairList [IMAGE_IMP_INJECTIVE_GEN])
    ]
  )

def HAS_SIZE_IMAGE_INJ_RESTRICT:
  prove(
    [
      @hol|{!(f:A->B) s t P n.
         FINITE s /\ FINITE t /\ CARD s = CARD t /\
         IMAGE f s SUBSET t /\
         (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y) /\
         {x | x IN s /\ P(f x)} HAS_SIZE n
         ==> {x | x IN t /\ P x} HAS_SIZE n}|,
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{{x | x IN t /\ P x} = IMAGE (f:A->B) {x | x IN s /\ P(f x)}}|
      )(SUBST1_TAC) then_list \
      PairList [
        MP_TAC(
          ISPECL(
            PairList [
              @hol|{s:A->bool}|,
              @hol|{t:B->bool}|,
              @hol|{f:A->B}|
            ])(
            SURJECTIVE_IFF_INJECTIVE_GEN
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        ASM(SET_TAC)(PairList []),
        MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ) then_tac ASM_REWRITE_TAC(PairList []) then_tac \
        ASM(SET_TAC)(PairList [])
      ]
    ]
  )

def CARD_LE_INJ:
  prove(
    [
      @hol|{!s t. FINITE s /\ FINITE t /\ CARD s <= CARD t
         ==> ?f:A->B. (IMAGE f s) SUBSET t /\
                      !x y. x IN s /\ y IN s /\ (f x = f y) ==> (x = y)}|,
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [IMAGE_CLAUSES, EMPTY_SUBSET, NOT_IN_EMPTY]) then_tac \
      SIMP_TAC(PairList [CARD_CLAUSES]) then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{x:A}|, @hol|{s:A->bool}|]) then_tac \
      STRIP_TAC then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [CARD_CLAUSES, LE, NOT_SUC]) then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{y:B}|, @hol|{t:B->bool}|]) then_tac \
      SIMP_TAC(PairList [CARD_CLAUSES]) then_tac \
      DISCH_THEN(CONJUNCTS_THEN2(K(ALL_TAC))(STRIP_ASSUME_TAC)) then_tac \
      REWRITE_TAC(PairList [LE_SUC]) then_tac \
      STRIP_TAC then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(SPEC(@hol|{t:B->bool}|))) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      DISCH_THEN(
        X_CHOOSE_THEN(@hol|{f:A->B}|)(STRIP_ASSUME_TAC)
      ) then_tac \
      EXISTS_TAC(
        @hol|{\z:A. if z = x then (y:B) else f(z)}|
      ) then_tac \
      REWRITE_TAC(PairList [IN_INSERT, SUBSET, IN_IMAGE]) then_tac \
      ASM_MESON_TAC(PairList [SUBSET, IN_IMAGE])
    ]
  )

def FORALL_IN_CLAUSES:
  prove(
    [
      @hol|{(!P. (!x:A. x IN {} ==> P x) <=> T) /\
         (!P a s. (!x:A. x IN (a INSERT s) ==> P x) <=> P a /\ (!x. x IN s ==> P x))}|,
      REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY]) then_tac MESON_TAC(PairList [])
    ]
  )

def EXISTS_IN_CLAUSES:
  prove(
    [
      @hol|{(!P. (?x:A. x IN {} /\ P x) <=> F) /\
         (!P a s. (?x:A. x IN (a INSERT s) /\ P x) <=> P a \/ (?x. x IN s /\ P x))}|,
      REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY]) then_tac MESON_TAC(PairList [])
    ]
  )

def INJECTIVE_ON_IMAGE:
  prove(
    [
      @hol|{!f:A->B u.
         (!s t. s SUBSET u /\ t SUBSET u /\ IMAGE f s = IMAGE f t ==> s = t) <=>
         (!x y. x IN u /\ y IN u /\ f x = f y ==> x = y)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [DISCH_TAC, SET_TAC(PairList [])] then_tac \
      MAP_EVERY(X_GEN_TAC)(PairList [@hol|{x:A}|, @hol|{y:A}|]) then_tac \
      STRIP_TAC then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPECL(
            PairList [
              @hol|{{x:A}}|,
              @hol|{{y:A}}|
            ]
          )
        )
      ) then_tac \
      ASM_REWRITE_TAC(PairList [SING_SUBSET, IMAGE_CLAUSES]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def INJECTIVE_IMAGE:
  prove(
    [
      @hol|{!f:A->B.
         (!s t. IMAGE f s = IMAGE f t ==> s = t) <=> (!x y. f x = f y ==> x = y)}|,
      GEN_TAC then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:A->B}|,
            @hol|{(:A)}|
          ])(
          INJECTIVE_ON_IMAGE
        )
      ) then_tac \
      REWRITE_TAC(PairList [IN_UNIV, SUBSET_UNIV])
    ]
  )

def SURJECTIVE_ON_IMAGE:
  prove(
    [
      @hol|{!f:A->B u v.
         (!t. t SUBSET v ==> ?s. s SUBSET u /\ IMAGE f s = t) <=>
         (!y. y IN v ==> ?x. x IN u /\ f x = y)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [
        DISCH_TAC then_tac X_GEN_TAC(@hol|{y:B}|) then_tac \
        DISCH_TAC then_tac \
        FIRST_X_ASSUM(
          o(MP_TAC)(
            SPEC(
              @hol|{{y:B}}|
            )
          )
        ) then_tac \
        ASM(SET_TAC)(PairList []),
        DISCH_TAC then_tac X_GEN_TAC(@hol|{t:B->bool}|) then_tac \
        DISCH_TAC then_tac \
        EXISTS_TAC(
          @hol|{{x | x IN u /\ (f:A->B) x IN t}}|
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      ]
    ]
  )

def SURJECTIVE_IMAGE:
  prove(
    [
      @hol|{!f:A->B. (!t. ?s. IMAGE f s = t) <=> (!y. ?x. f x = y)}|,
      GEN_TAC then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:A->B}|,
            @hol|{(:A)}|,
            @hol|{(:B)}|
          ])(
          SURJECTIVE_ON_IMAGE
        )
      ) then_tac \
      REWRITE_TAC(PairList [IN_UNIV, SUBSET_UNIV])
    ]
  )

def INJECTIVE_ON_PREIMAGE:
  prove(
    [
      @hol|{!f:A->B s u.
         (!t t'. t SUBSET u /\ t' SUBSET u /\
                 {x | x IN s /\ f x IN t} = {x | x IN s /\ f x IN t'}
                 ==> t = t') <=>
         u SUBSET IMAGE f s}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_list \
      PairList [ALL_TAC, ASM(SET_TAC)(PairList [])] then_tac \
      REWRITE_TAC(PairList [SUBSET]) then_tac \
      X_GEN_TAC(@hol|{y:B}|) then_tac \
      FIRST_X_ASSUM(
        o(MP_TAC)(
          SPECL(
            PairList [
              @hol|{{y:B}}|,
              @hol|{{}:B->bool}|
            ]
          )
        )
      ) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def SURJECTIVE_ON_PREIMAGE:
  prove(
    [
      @hol|{!f:A->B s u.
         (!k. k SUBSET s
              ==> ?t. t SUBSET u /\ {x | x IN s /\ f x IN t} = k) <=>
         IMAGE f s SUBSET u /\
         (!x y. x IN s /\ y IN s /\ f x = f y ==> x = y)}|,
      REPEAT(STRIP_TAC) then_tac EQ_TAC then_tac DISCH_TAC then_list \
      PairList [
        CONJ_TAC then_list \
        PairList [
          REWRITE_TAC(PairList [SUBSET, FORALL_IN_IMAGE]) then_tac \
          X_GEN_TAC(@hol|{x:A}|) then_tac \
          DISCH_TAC then_tac \
          FIRST_X_ASSUM(
            o(MP_TAC)(
              SPEC(
                @hol|{{x:A}}|
              )
            )
          ) then_tac \
          ASM(SET_TAC)(PairList []),
          MAP_EVERY(X_GEN_TAC)(PairList [@hol|{x:A}|, @hol|{y:A}|]) then_tac \
          STRIP_TAC then_tac \
          FIRST_X_ASSUM(
            o(MP_TAC)(
              SPEC(
                @hol|{{x:A}}|
              )
            )
          ) then_tac \
          ASM(SET_TAC)(PairList [])
        ],
        X_GEN_TAC(@hol|{k:A->bool}|) then_tac STRIP_TAC then_tac \
        EXISTS_TAC(
          @hol|{IMAGE (f:A->B) k}|
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      ]
    ]
  )

def INJECTIVE_PREIMAGE:
  prove(
    [
      @hol|{!f:A->B.
         (!t t'. {x | f x IN t} = {x | f x IN t'} ==> t = t') <=>
         IMAGE f UNIV = UNIV}|,
      REPEAT(GEN_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:A->B}|,
            @hol|{(:A)}|,
            @hol|{(:B)}|
          ])(
          INJECTIVE_ON_PREIMAGE
        )
      ) then_tac \
      REWRITE_TAC(PairList [IN_UNIV, SUBSET_UNIV]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def SURJECTIVE_PREIMAGE:
  prove(
    [
      @hol|{!f:A->B. (!k. ?t. {x | f x IN t} = k) <=> (!x y. f x = f y ==> x = y)}|,
      REPEAT(GEN_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{f:A->B}|,
            @hol|{(:A)}|,
            @hol|{(:B)}|
          ])(
          SURJECTIVE_ON_PREIMAGE
        )
      ) then_tac \
      REWRITE_TAC(PairList [IN_UNIV, SUBSET_UNIV]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def CARD_EQ_BIJECTION:
  prove(
    [
      @hol|{!s t. FINITE s /\ FINITE t /\ CARD s = CARD t
         ==> ?f:A->B. (!x. x IN s ==> f(x) IN t) /\
                      (!y. y IN t ==> ?x. x IN s /\ f x = y) /\
                      !x y. x IN s /\ y IN s /\ (f x = f y) ==> (x = y)}|,
      MP_TAC(CARD_LE_INJ) then_tac \
      REPEAT(MATCH_MP_TAC(MONO_FORALL) then_tac GEN_TAC) then_tac \
      DISCH_THEN((fun(th): (STRIP_TAC then_tac MP_TAC(th)))) then_tac \
      ASM_REWRITE_TAC(PairList [LE_REFL]) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      ASM_SIMP_TAC(PairList [SURJECTIVE_IFF_INJECTIVE_GEN]) then_tac \
      MESON_TAC(PairList [SUBSET, IN_IMAGE])
    ]
  )

def CARD_EQ_BIJECTIONS:
  prove(
    [
      @hol|{!s t. FINITE s /\ FINITE t /\ CARD s = CARD t
         ==> ?f:A->B g. (!x. x IN s ==> f(x) IN t /\ g(f x) = x) /\
                        (!y. y IN t ==> g(y) IN s /\ f(g y) = y)}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN(o(MP_TAC)(MATCH_MP(CARD_EQ_BIJECTION))) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      REWRITE_TAC(PairList [SURJECTIVE_ON_RIGHT_INVERSE]) then_tac \
      GEN_TAC then_tac \
      REWRITE_TAC(PairList [LEFT_AND_EXISTS_THM, RIGHT_AND_EXISTS_THM]) then_tac \
      MATCH_MP_TAC(MONO_EXISTS) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def CARD_EQ_BIJECTIONS_SPECIAL:
  prove(
    [
      @hol|{!s t (a:A) (b:B).
         FINITE s /\ FINITE t /\ CARD s = CARD t /\ a IN s /\ b IN t
         ==> ?f g. f a = b /\ g b = a /\
                   (!x. x IN s ==> f x IN t /\ g (f x) = x) /\
                   (!y. y IN t ==> g y IN s /\ f (g y) = y)}|,
      REPEAT(STRIP_TAC) then_tac \
      MP_TAC(
        ISPECL(
          PairList [
            @hol|{s DELETE (a:A)}|,
            @hol|{t DELETE (b:B)}|
          ])(
          CARD_EQ_BIJECTIONS
        )
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_DELETE, CARD_DELETE, IN_DELETE, LEFT_IMP_EXISTS_THM]) then_tac \
      MAP_EVERY(X_GEN_TAC)(
        PairList [
          @hol|{f:A->B}|,
          @hol|{g:B->A}|
        ]
      ) then_tac \
      STRIP_TAC then_tac \
      EXISTS_TAC(
        @hol|{\x. if x = a then b else (f:A->B) x}|
      ) then_tac \
      EXISTS_TAC(
        @hol|{\y. if y = b then a else (g:B->A) y}|
      ) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def BIJECTIONS_HAS_SIZE:
  prove(
    [
      @hol|{!s t f:A->B g.
         (!x. x IN s ==> f(x) IN t /\ g(f x) = x) /\
         (!y. y IN t ==> g(y) IN s /\ f(g y) = y) /\
         s HAS_SIZE n
         ==> t HAS_SIZE n}|,
      REPEAT(STRIP_TAC) then_tac \
      SUBGOAL_THEN(
        @hol|{t = IMAGE (f:A->B) s}|
      )(SUBST_ALL_TAC) then_list \
      PairList [
        ASM(SET_TAC)(PairList []),
        MATCH_MP_TAC(HAS_SIZE_IMAGE_INJ) then_tac ASM_MESON_TAC(PairList [])
      ]
    ]
  )

def BIJECTIONS_HAS_SIZE_EQ:
  prove(
    [
      @hol|{!s t f:A->B g.
         (!x. x IN s ==> f(x) IN t /\ g(f x) = x) /\
         (!y. y IN t ==> g(y) IN s /\ f(g y) = y)
         ==> !n. s HAS_SIZE n <=> t HAS_SIZE n}|,
      REPEAT(STRIP_TAC) then_tac EQ_TAC then_tac \
      MATCH_MP_TAC(
        ONCE_REWRITE_RULE(
          PairList [
            TAUT(
              @hol|{a /\ b /\ c ==> d <=> a /\ b ==> c ==> d}|
            )
          ]
        )(BIJECTIONS_HAS_SIZE)
      ) then_list \
      PairList [
        MAP_EVERY(EXISTS_TAC)(
          PairList [
            @hol|{f:A->B}|,
            @hol|{g:B->A}|
          ]
        ),
        MAP_EVERY(EXISTS_TAC)(
          PairList [
            @hol|{g:B->A}|,
            @hol|{f:A->B}|
          ]
        )
      ] then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def BIJECTIONS_CARD_EQ:
  prove(
    [
      @hol|{!s t f:A->B g.
         (FINITE s \/ FINITE t) /\
         (!x. x IN s ==> f(x) IN t /\ g(f x) = x) /\
         (!y. y IN t ==> g(y) IN s /\ f(g y) = y)
         ==> CARD s = CARD t}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN(
        CONJUNCTS_THEN2(MP_TAC)(o(MP_TAC)(MATCH_MP(BIJECTIONS_HAS_SIZE_EQ)))
      ) then_tac \
      MESON_TAC(PairList [HAS_SIZE])
    ]
  )

def WF_FINITE:
  prove(
    [
      @hol|{!(<<). (!x. ~(x << x)) /\ (!x y z. x << y /\ y << z ==> x << z) /\
         (!x:A. FINITE {y | y << x})
         ==> WF(<<)}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [WF_DCHAIN]) then_tac \
      DISCH_THEN(X_CHOOSE_THEN(@hol|{s:num->A}|)(STRIP_ASSUME_TAC)) then_tac \
      SUBGOAL_THEN(
        @hol|{!m n. m < n ==> (s:num->A) n << s m}|
      )(ASSUME_TAC) then_list \
      PairList [
        MATCH_MP_TAC(TRANSITIVE_STEPWISE_LT) then_tac ASM_MESON_TAC(PairList []),
        ALL_TAC
      ] then_tac \
      MP_TAC(ISPEC(@hol|{s:num->A}|)(INFINITE_IMAGE_INJ)) then_tac \
      ANTS_TAC then_list \
      PairList [ASM_MESON_TAC(PairList [LT_CASES]), ALL_TAC] then_tac \
      DISCH_THEN(o(MP_TAC)(SPEC(@hol|{(:num)}|))) then_tac \
      REWRITE_TAC(PairList [num_INFINITE]) then_tac \
      REWRITE_TAC(PairList [INFINITE]) then_tac \
      MATCH_MP_TAC(FINITE_SUBSET) then_tac \
      EXISTS_TAC(
        @hol|{s(0) INSERT {y:A | y << s(0)}}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList [FINITE_INSERT]) then_tac \
      REWRITE_TAC(PairList [SUBSET, FORALL_IN_IMAGE, IN_UNIV, IN_INSERT]) then_tac \
      INDUCT_TAC then_tac \
      REWRITE_TAC(PairList [IN_ELIM_THM]) then_tac \
      ASM_MESON_TAC(PairList [LT_0])
    ]
  )

def WF_PSUBSET:
  prove(
    [
      @hol|{!s:A->bool. FINITE s ==> WF (\t1 t2. t1 PSUBSET t2 /\ t2 SUBSET s)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(WF_FINITE) then_tac \
      SIMP_TAC(PairList [CONJ_ASSOC]) then_tac \
      CONJ_TAC then_list \
      PairList [
        SET_TAC(PairList []),
        X_GEN_TAC(@hol|{t:A->bool}|)
      ] then_tac \
      MATCH_MP_TAC(FINITE_SUBSET) then_tac \
      EXISTS_TAC(
        @hol|{{t:A->bool | t SUBSET s}}|
      ) then_tac \
      ASM_SIMP_TAC(PairList [FINITE_POWERSET]) then_tac \
      SET_TAC(PairList [])
    ]
  )

def le_c:
  new_definition(
    @hol|{s <=_c t <=>
       ?f:A->B. (!x. x IN s ==> f(x) IN t) /\
                (!x y. x IN s /\ y IN s /\ f(x) = f(y) ==> x = y)}|
  )

def lt_c:
  new_definition(
    @hol|{(s:A->bool) <_c (t:B->bool) <=> s <=_c t /\ ~(t <=_c s)}|
  )

def eq_c:
  new_definition(
    @hol|{(s:A->bool) =_c (t:B->bool) <=>
       ?f. (!x. x IN s ==> f(x) IN t) /\
           !y. y IN t ==> ?!x. x IN s /\ (f x = y)}|
  )

def ge_c:
  new_definition(
    @hol|{(s:A->bool) >=_c (t:B->bool) <=> t <=_c s}|
  )

def gt_c:
  new_definition(
    @hol|{(s:A->bool) >_c (t:B->bool) <=> t <_c s}|
  )

def LE_C:
  prove(
    [
      @hol|{!s t. s <=_c t <=> ?g:A->B. !x. x IN s ==> ?y. y IN t /\ g y = x}|,
      REWRITE_TAC(
        PairList [
          le_c,
          INJECTIVE_ON_LEFT_INVERSE,
          SURJECTIVE_ON_RIGHT_INVERSE,
          RIGHT_IMP_EXISTS_THM,
          SKOLEM_THM,
          RIGHT_AND_EXISTS_THM
        ]
      ) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def GE_C:
  prove(
    [
      @hol|{!s t. s >=_c t <=> ?f:A->B. !y. y IN t ==> ?x. x IN s /\ (y = f x)}|,
      REWRITE_TAC(PairList [ge_c, LE_C]) then_tac MESON_TAC(PairList [])
    ]
  )

def COUNTABLE:
  new_definition(
    @hol|{COUNTABLE (t:A->bool) <=> (:num) >=_c t}|
  )

def sup:
  new_definition(
    @hol|{sup s = @a:real. (!x. x IN s ==> x <= a) /\
       !b. (!x. x IN s ==> x <= b) ==> a <= b}|
  )

def SUP_EQ:
  prove(
    [
      @hol|{!s t. (!b. (!x. x IN s ==> x <= b) <=> (!x. x IN t ==> x <= b))
         ==> sup s = sup t}|,
      SIMP_TAC(PairList [sup])
    ]
  )

def SUP:
  prove(
    [
      @hol|{!s. ~(s = {}) /\ (?b. !x. x IN s ==> x <= b)
         ==> (!x. x IN s ==> x <= sup s) /\
             !b. (!x. x IN s ==> x <= b) ==> sup s <= b}|,
      REWRITE_TAC(PairList [sup]) then_tac \
      CONV_TAC(ONCE_DEPTH_CONV(SELECT_CONV)) then_tac \
      REPEAT(STRIP_TAC) then_tac \
      MATCH_MP_TAC(REAL_COMPLETE) then_tac \
      ASM_MESON_TAC(PairList [MEMBER_NOT_EMPTY])
    ]
  )

def SUP_FINITE_LEMMA:
  prove(
    [
      @hol|{!s. FINITE s /\ ~(s = {}) ==> ?b:real. b IN s /\ !x. x IN s ==> x <= b}|,
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [NOT_INSERT_EMPTY, IN_INSERT]) then_tac \
      REWRITE_TAC(PairList [GSYM(MEMBER_NOT_EMPTY)]) then_tac \
      MESON_TAC(PairList [REAL_LE_TOTAL, REAL_LE_TRANS])
    ]
  )

def SUP_FINITE:
  prove(
    [
      @hol|{!s. FINITE s /\ ~(s = {}) ==> (sup s) IN s /\ !x. x IN s ==> x <= sup s}|,
      GEN_TAC then_tac DISCH_TAC then_tac \
      FIRST_ASSUM(o(MP_TAC)(MATCH_MP(SUP_FINITE_LEMMA))) then_tac \
      ASM_MESON_TAC(PairList [REAL_LE_ANTISYM, REAL_LE_TOTAL, SUP])
    ]
  )

def REAL_LE_SUP_FINITE:
  prove(
    [
      @hol|{!s a. FINITE s /\ ~(s = {}) ==> (a <= sup s <=> ?x. x IN s /\ a <= x)}|,
      MESON_TAC(PairList [SUP_FINITE, REAL_LE_TRANS])
    ]
  )

def REAL_SUP_LE_FINITE:
  prove(
    [
      @hol|{!s a. FINITE s /\ ~(s = {}) ==> (sup s <= a <=> !x. x IN s ==> x <= a)}|,
      MESON_TAC(PairList [SUP_FINITE, REAL_LE_TRANS])
    ]
  )

def REAL_LT_SUP_FINITE:
  prove(
    [
      @hol|{!s a. FINITE s /\ ~(s = {}) ==> (a < sup s <=> ?x. x IN s /\ a < x)}|,
      MESON_TAC(PairList [SUP_FINITE, REAL_LTE_TRANS])
    ]
  )

def REAL_SUP_LT_FINITE:
  prove(
    [
      @hol|{!s a. FINITE s /\ ~(s = {}) ==> (sup s < a <=> !x. x IN s ==> x < a)}|,
      MESON_TAC(PairList [SUP_FINITE, REAL_LET_TRANS])
    ]
  )

def REAL_SUP_UNIQUE:
  prove(
    [
      @hol|{!s b. (!x. x IN s ==> x <= b) /\
         (!b'. b' < b ==> ?x. x IN s /\ b' < x)
         ==> sup s = b}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [sup]) then_tac \
      MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      ASM_MESON_TAC(PairList [REAL_NOT_LE, REAL_LE_ANTISYM])
    ]
  )

def REAL_SUP_LE:
  prove(
    [
      @hol|{!b. ~(s = {}) /\ (!x. x IN s ==> x <= b) ==> sup s <= b}|,
      MESON_TAC(PairList [SUP])
    ]
  )

def REAL_SUP_LE_SUBSET:
  prove(
    [
      @hol|{!s t. ~(s = {}) /\ s SUBSET t /\ (?b. !x. x IN t ==> x <= b)
         ==> sup s <= sup t}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_SUP_LE) then_tac \
      MP_TAC(SPEC(@hol|{t:real->bool}|)(SUP)) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def REAL_SUP_BOUNDS:
  prove(
    [
      @hol|{!s a b. ~(s = {}) /\ (!x. x IN s ==> a <= x /\ x <= b)
         ==> a <= sup s /\ sup s <= b}|,
      REPEAT(GEN_TAC) then_tac STRIP_TAC then_tac \
      MP_TAC(SPEC(@hol|{s:real->bool}|)(SUP)) then_tac \
      ANTS_TAC then_list \
      PairList [ASM_MESON_TAC(PairList []), ALL_TAC] then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [GSYM(MEMBER_NOT_EMPTY)]))) then_tac \
      ASM_MESON_TAC(PairList [REAL_LE_TRANS])
    ]
  )

def REAL_ABS_SUP_LE:
  prove(
    [
      @hol|{!s a. ~(s = {}) /\ (!x. x IN s ==> abs(x) <= a) ==> abs(sup s) <= a}|,
      REWRITE_TAC(PairList [GSYM(REAL_BOUNDS_LE), REAL_SUP_BOUNDS])
    ]
  )

def REAL_SUP_ASCLOSE:
  prove(
    [
      @hol|{!s l e. ~(s = {}) /\ (!x. x IN s ==> abs(x - l) <= e)
         ==> abs(sup s - l) <= e}|,
      SIMP_TAC(
        PairList [
          REAL_ARITH(
            @hol|{abs(x - l):real <= e <=> l - e <= x /\ x <= l + e}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REAL_SUP_BOUNDS])
    ]
  )

def SUP_UNIQUE_FINITE:
  prove(
    [
      @hol|{!s. FINITE s /\ ~(s = {})
         ==> (sup s = a <=> a IN s /\ !y. y IN s ==> y <= a)}|,
      ASM_SIMP_TAC(
        PairList [
          GSYM(REAL_LE_ANTISYM),
          REAL_LE_SUP_FINITE,
          REAL_SUP_LE_FINITE,
          NOT_INSERT_EMPTY,
          FINITE_INSERT,
          FINITE_EMPTY
        ]
      ) then_tac \
      MESON_TAC(PairList [REAL_LE_REFL, REAL_LE_TRANS, REAL_LE_ANTISYM])
    ]
  )

def SUP_INSERT_FINITE:
  prove(
    [
      @hol|{!x s. FINITE s ==> sup(x INSERT s) = if s = {} then x else max x (sup s)}|,
      REPEAT(STRIP_TAC) then_tac COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(
        PairList [
          SUP_UNIQUE_FINITE,
          FINITE_INSERT,
          FINITE_EMPTY,
          NOT_INSERT_EMPTY,
          FORALL_IN_INSERT,
          NOT_IN_EMPTY
        ]
      ) then_tac \
      REWRITE_TAC(PairList [IN_SING, REAL_LE_REFL]) then_tac \
      REWRITE_TAC(PairList [real_max]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList [SUP_FINITE, IN_INSERT, REAL_LE_REFL]) then_tac \
      ASM_MESON_TAC(PairList [SUP_FINITE, REAL_LE_TOTAL, REAL_LE_TRANS])
    ]
  )

def SUP_SING:
  prove(
    [
      @hol|{!a. sup {a} = a}|,
      SIMP_TAC(PairList [SUP_INSERT_FINITE, FINITE_EMPTY])
    ]
  )

def SUP_INSERT_INSERT:
  prove(
    [
      @hol|{!a b s. sup (b INSERT a INSERT s) = sup (max a b INSERT s)}|,
      REPEAT(GEN_TAC) then_tac MATCH_MP_TAC(SUP_EQ) then_tac \
      X_GEN_TAC(@hol|{c:real}|) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_INSERT]) then_tac \
      ASM_CASES_TAC(
        @hol|{!x:real. x IN s ==> x <= c}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_LE_SUP:
  prove(
    [
      @hol|{!s a b y. y IN s /\ a <= y /\ (!x. x IN s ==> x <= b) ==> a <= sup s}|,
      MESON_TAC(PairList [SUP, MEMBER_NOT_EMPTY, REAL_LE_TRANS])
    ]
  )

def REAL_SUP_LE_EQ:
  prove(
    [
      @hol|{!s y. ~(s = {}) /\ (?b. !x. x IN s ==> x <= b)
         ==> (sup s <= y <=> !x. x IN s ==> x <= y)}|,
      MESON_TAC(PairList [SUP, REAL_LE_TRANS])
    ]
  )

def SUP_UNIQUE:
  prove(
    [
      @hol|{!s b. (!c. (!x. x IN s ==> x <= c) <=> b <= c) ==> sup s = b}|,
      REPEAT(STRIP_TAC) then_tac \
      GEN_REWRITE_TAC(RAND_CONV)(PairList [GSYM(SUP_SING)]) then_tac \
      MATCH_MP_TAC(SUP_EQ) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def SUP_UNION:
  prove(
    [
      @hol|{!s t. ~(s = {}) /\ ~(t = {}) /\
         (?b. !x. x IN s ==> x <= b) /\ (?c. !x. x IN t ==> x <= c)
         ==> sup(s UNION t) = max (sup s) (sup t)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(SUP_UNIQUE) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_UNION, REAL_MAX_LE]) then_tac \
      ASM_MESON_TAC(PairList [SUP, REAL_LE_TRANS])
    ]
  )

def ELEMENT_LE_SUP:
  prove(
    [
      @hol|{!s a. (?b. !x. x IN s ==> x <= b) /\ a IN s ==> a <= sup s}|,
      MESON_TAC(PairList [REAL_LE_SUP, REAL_LE_REFL])
    ]
  )

def SUP_APPROACH:
  prove(
    [
      @hol|{!s c. ~(s = {}) /\ (?b. !x. x IN s ==> x <= b) /\ c < sup s
         ==> ?x. x IN s /\ c < x}|,
      INTRO_TAC("!s c; npty bound lt") then_tac \
      REFUTE_THEN(
        o(LABEL_TAC("hp"))(REWRITE_RULE(PairList [NOT_EXISTS_THM, DE_MORGAN_THM, REAL_NOT_LT]))
      ) then_tac \
      REMOVE_THEN("lt")(MP_TAC) then_tac \
      REWRITE_TAC(PairList [REAL_NOT_LT]) then_tac \
      HYP(o(o(MP_TAC)(MATCH_MP(SUP)))(end_itlist(CONJ)))("npty bound")(PairList []) then_tac \
      INTRO_TAC("_ sup") then_tac \
      REMOVE_THEN("sup")(MATCH_MP_TAC) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def REAL_MAX_SUP:
  prove(
    [
      @hol|{!x y. max x y = sup {x,y}}|,
      SIMP_TAC(
        PairList [
          GSYM(REAL_LE_ANTISYM),
          REAL_SUP_LE_FINITE,
          REAL_LE_SUP_FINITE,
          sets_FINITE_RULES_v2,
          NOT_INSERT_EMPTY,
          REAL_MAX_LE,
          REAL_LE_MAX
        ]
      ) then_tac \
      REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY]) then_tac \
      MESON_TAC(PairList [REAL_LE_TOTAL])
    ]
  )

def inf:
  new_definition(
    @hol|{inf s = @a:real. (!x. x IN s ==> a <= x) /\
       !b. (!x. x IN s ==> b <= x) ==> b <= a}|
  )

def INF_EQ:
  prove(
    [
      @hol|{!s t. (!a. (!x. x IN s ==> a <= x) <=> (!x. x IN t ==> a <= x))
         ==> inf s = inf t}|,
      SIMP_TAC(PairList [inf])
    ]
  )

def INF:
  prove(
    [
      @hol|{!s. ~(s = {}) /\ (?b. !x. x IN s ==> b <= x)
         ==> (!x. x IN s ==> inf s <= x) /\
             !b. (!x. x IN s ==> b <= x) ==> b <= inf s}|,
      GEN_TAC then_tac STRIP_TAC then_tac REWRITE_TAC(PairList [inf]) then_tac \
      CONV_TAC(ONCE_DEPTH_CONV(SELECT_CONV)) then_tac \
      ONCE_REWRITE_TAC(PairList [GSYM(REAL_LE_NEG2)]) then_tac \
      EXISTS_TAC(
        @hol|{--(sup (IMAGE (--) s))}|
      ) then_tac \
      MP_TAC(
        SPEC(
          @hol|{IMAGE (--) (s:real->bool)}|
        )(SUP)
      ) then_tac \
      REWRITE_TAC(PairList [REAL_NEG_NEG]) then_tac \
      ABBREV_TAC(
        @hol|{a = sup (IMAGE (--) s)}|
      ) then_tac \
      REWRITE_TAC(PairList [GSYM(MEMBER_NOT_EMPTY), IN_IMAGE]) then_tac \
      ASM_MESON_TAC(PairList [REAL_NEG_NEG, MEMBER_NOT_EMPTY, REAL_LE_NEG2])
    ]
  )

def INF_FINITE_LEMMA:
  prove(
    [
      @hol|{!s. FINITE s /\ ~(s = {}) ==> ?b:real. b IN s /\ !x. x IN s ==> b <= x}|,
      REWRITE_TAC(PairList [IMP_CONJ]) then_tac \
      MATCH_MP_TAC(FINITE_INDUCT_STRONG) then_tac \
      REWRITE_TAC(PairList [NOT_INSERT_EMPTY, IN_INSERT]) then_tac \
      REWRITE_TAC(PairList [GSYM(MEMBER_NOT_EMPTY)]) then_tac \
      MESON_TAC(PairList [REAL_LE_TOTAL, REAL_LE_TRANS])
    ]
  )

def INF_FINITE:
  prove(
    [
      @hol|{!s. FINITE s /\ ~(s = {}) ==> (inf s) IN s /\ !x. x IN s ==> inf s <= x}|,
      GEN_TAC then_tac DISCH_TAC then_tac \
      FIRST_ASSUM(o(MP_TAC)(MATCH_MP(INF_FINITE_LEMMA))) then_tac \
      ASM_MESON_TAC(PairList [REAL_LE_ANTISYM, REAL_LE_TOTAL, INF])
    ]
  )

def REAL_LE_INF_FINITE:
  prove(
    [
      @hol|{!s a. FINITE s /\ ~(s = {}) ==> (a <= inf s <=> !x. x IN s ==> a <= x)}|,
      MESON_TAC(PairList [INF_FINITE, REAL_LE_TRANS])
    ]
  )

def REAL_INF_LE_FINITE:
  prove(
    [
      @hol|{!s a. FINITE s /\ ~(s = {}) ==> (inf s <= a <=> ?x. x IN s /\ x <= a)}|,
      MESON_TAC(PairList [INF_FINITE, REAL_LE_TRANS])
    ]
  )

def REAL_LT_INF_FINITE:
  prove(
    [
      @hol|{!s a. FINITE s /\ ~(s = {}) ==> (a < inf s <=> !x. x IN s ==> a < x)}|,
      MESON_TAC(PairList [INF_FINITE, REAL_LTE_TRANS])
    ]
  )

def REAL_INF_LT_FINITE:
  prove(
    [
      @hol|{!s a. FINITE s /\ ~(s = {}) ==> (inf s < a <=> ?x. x IN s /\ x < a)}|,
      MESON_TAC(PairList [INF_FINITE, REAL_LET_TRANS])
    ]
  )

def REAL_INF_UNIQUE:
  prove(
    [
      @hol|{!s b. (!x. x IN s ==> b <= x) /\
         (!b'. b < b' ==> ?x. x IN s /\ x < b')
         ==> inf s = b}|,
      REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [inf]) then_tac \
      MATCH_MP_TAC(SELECT_UNIQUE) then_tac \
      ASM_MESON_TAC(PairList [REAL_NOT_LE, REAL_LE_ANTISYM])
    ]
  )

def REAL_LE_INF:
  prove(
    [
      @hol|{!b. ~(s = {}) /\ (!x. x IN s ==> b <= x) ==> b <= inf s}|,
      MESON_TAC(PairList [INF])
    ]
  )

def REAL_LE_INF_SUBSET:
  prove(
    [
      @hol|{!s t. ~(t = {}) /\ t SUBSET s /\ (?b. !x. x IN s ==> b <= x)
         ==> inf s <= inf t}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(REAL_LE_INF) then_tac \
      MP_TAC(SPEC(@hol|{s:real->bool}|)(INF)) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def REAL_INF_BOUNDS:
  prove(
    [
      @hol|{!s a b. ~(s = {}) /\ (!x. x IN s ==> a <= x /\ x <= b)
         ==> a <= inf s /\ inf s <= b}|,
      REPEAT(GEN_TAC) then_tac STRIP_TAC then_tac \
      MP_TAC(SPEC(@hol|{s:real->bool}|)(INF)) then_tac \
      ANTS_TAC then_list \
      PairList [ASM_MESON_TAC(PairList []), ALL_TAC] then_tac \
      FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [GSYM(MEMBER_NOT_EMPTY)]))) then_tac \
      ASM_MESON_TAC(PairList [REAL_LE_TRANS])
    ]
  )

def REAL_ABS_INF_LE:
  prove(
    [
      @hol|{!s a. ~(s = {}) /\ (!x. x IN s ==> abs(x) <= a) ==> abs(inf s) <= a}|,
      REWRITE_TAC(PairList [GSYM(REAL_BOUNDS_LE), REAL_INF_BOUNDS])
    ]
  )

def REAL_INF_ASCLOSE:
  prove(
    [
      @hol|{!s l e. ~(s = {}) /\ (!x. x IN s ==> abs(x - l) <= e)
         ==> abs(inf s - l) <= e}|,
      SIMP_TAC(
        PairList [
          REAL_ARITH(
            @hol|{abs(x - l):real <= e <=> l - e <= x /\ x <= l + e}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [REAL_INF_BOUNDS])
    ]
  )

def INF_UNIQUE_FINITE:
  prove(
    [
      @hol|{!s. FINITE s /\ ~(s = {})
         ==> (inf s = a <=> a IN s /\ !y. y IN s ==> a <= y)}|,
      ASM_SIMP_TAC(
        PairList [
          GSYM(REAL_LE_ANTISYM),
          REAL_LE_INF_FINITE,
          REAL_INF_LE_FINITE,
          NOT_INSERT_EMPTY,
          FINITE_INSERT,
          FINITE_EMPTY
        ]
      ) then_tac \
      MESON_TAC(PairList [REAL_LE_REFL, REAL_LE_TRANS, REAL_LE_ANTISYM])
    ]
  )

def INF_INSERT_FINITE:
  prove(
    [
      @hol|{!x s. FINITE s ==> inf(x INSERT s) = if s = {} then x else min x (inf s)}|,
      REPEAT(STRIP_TAC) then_tac COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(
        PairList [
          INF_UNIQUE_FINITE,
          FINITE_INSERT,
          FINITE_EMPTY,
          NOT_INSERT_EMPTY,
          FORALL_IN_INSERT,
          NOT_IN_EMPTY
        ]
      ) then_tac \
      REWRITE_TAC(PairList [IN_SING, REAL_LE_REFL]) then_tac \
      REWRITE_TAC(PairList [real_min]) then_tac \
      COND_CASES_TAC then_tac \
      ASM_SIMP_TAC(PairList [INF_FINITE, IN_INSERT, REAL_LE_REFL]) then_tac \
      ASM_MESON_TAC(PairList [INF_FINITE, REAL_LE_TOTAL, REAL_LE_TRANS])
    ]
  )

def INF_SING:
  prove(
    [
      @hol|{!a. inf {a} = a}|,
      SIMP_TAC(PairList [INF_INSERT_FINITE, FINITE_EMPTY])
    ]
  )

def INF_INSERT_INSERT:
  prove(
    [
      @hol|{!a b s. inf (b INSERT a INSERT s) = inf (min a b INSERT s)}|,
      REPEAT(GEN_TAC) then_tac MATCH_MP_TAC(INF_EQ) then_tac \
      X_GEN_TAC(@hol|{c:real}|) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_INSERT]) then_tac \
      ASM_CASES_TAC(
        @hol|{!x:real. x IN s ==> c <= x}|
      ) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      REAL_ARITH_TAC
    ]
  )

def REAL_SUP_EQ_INF:
  prove(
    [
      @hol|{!s. ~(s = {}) /\ (?B. !x. x IN s ==> abs(x) <= B)
         ==> (sup s = inf s <=> ?a. s = {a})}|,
      REPEAT(STRIP_TAC) then_tac EQ_TAC then_list \
      PairList [
        DISCH_TAC then_tac \
        EXISTS_TAC(@hol|{sup s}|) then_tac \
        MATCH_MP_TAC(
          SET_RULE(
            @hol|{~(s = {}) /\ (!x. x IN s ==> x = a) ==> s = {a}}|
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList [GSYM(REAL_LE_ANTISYM)]) then_tac \
        ASM_MESON_TAC(PairList [SUP, REAL_ABS_BOUNDS, INF]),
        STRIP_TAC then_tac \
        ASM_SIMP_TAC(PairList [SUP_INSERT_FINITE, INF_INSERT_FINITE, FINITE_EMPTY])
      ]
    ]
  )

def REAL_INF_LE:
  prove(
    [
      @hol|{!s a b y. y IN s /\ y <= b /\ (!x. x IN s ==> a <= x) ==> inf s <= b}|,
      MESON_TAC(PairList [INF, MEMBER_NOT_EMPTY, REAL_LE_TRANS])
    ]
  )

def REAL_LE_INF_EQ:
  prove(
    [
      @hol|{!s y. ~(s = {}) /\ (?b. !x. x IN s ==> b <= x)
         ==> (y <= inf s <=> !x. x IN s ==> y <= x)}|,
      MESON_TAC(PairList [INF, REAL_LE_TRANS])
    ]
  )

def INF_UNIQUE:
  prove(
    [
      @hol|{!s b. (!c. (!x. x IN s ==> c <= x) <=> c <= b) ==> inf s = b}|,
      REPEAT(STRIP_TAC) then_tac \
      GEN_REWRITE_TAC(RAND_CONV)(PairList [GSYM(INF_SING)]) then_tac \
      MATCH_MP_TAC(INF_EQ) then_tac \
      ASM(SET_TAC)(PairList [])
    ]
  )

def INF_UNION:
  prove(
    [
      @hol|{!s t. ~(s = {}) /\ ~(t = {}) /\
         (?b. !x. x IN s ==> b <= x) /\ (?c. !x. x IN t ==> c <= x)
         ==> inf(s UNION t) = min (inf s) (inf t)}|,
      REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(INF_UNIQUE) then_tac \
      REWRITE_TAC(PairList [FORALL_IN_UNION, REAL_LE_MIN]) then_tac \
      ASM_MESON_TAC(PairList [INF, REAL_LE_TRANS])
    ]
  )

def INF_LE_ELEMENT:
  prove(
    [
      @hol|{!s a. (?b. !x. x IN s ==> b <= x) /\ a IN s ==> inf s <= a}|,
      MESON_TAC(PairList [REAL_INF_LE, REAL_LE_REFL])
    ]
  )

def INF_APPROACH:
  prove(
    [
      @hol|{!s c. ~(s = {}) /\ (?b. !x. x IN s ==> b <= x) /\ inf s < c
         ==> ?x. x IN s /\ x < c}|,
      INTRO_TAC("!s c; npty bound lt") then_tac \
      REFUTE_THEN(
        o(LABEL_TAC("hp"))(REWRITE_RULE(PairList [NOT_EXISTS_THM, DE_MORGAN_THM, REAL_NOT_LT]))
      ) then_tac \
      REMOVE_THEN("lt")(MP_TAC) then_tac \
      REWRITE_TAC(PairList [REAL_NOT_LT]) then_tac \
      HYP(o(o(MP_TAC)(MATCH_MP(INF)))(end_itlist(CONJ)))("npty bound")(PairList []) then_tac \
      INTRO_TAC("_ inf") then_tac \
      REMOVE_THEN("inf")(MATCH_MP_TAC) then_tac \
      ASM_MESON_TAC(PairList [])
    ]
  )

def REAL_MIN_INF:
  prove(
    [
      @hol|{!x y. min x y = inf {x,y}}|,
      SIMP_TAC(
        PairList [
          GSYM(REAL_LE_ANTISYM),
          REAL_INF_LE_FINITE,
          REAL_LE_INF_FINITE,
          sets_FINITE_RULES_v2,
          NOT_INSERT_EMPTY,
          REAL_MIN_LE,
          REAL_LE_MIN
        ]
      ) then_tac \
      REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY]) then_tac \
      MESON_TAC(PairList [REAL_LE_TOTAL])
    ]
  )

Host.parse_as_infix(["has_inf", [12, "right"]])

Host.parse_as_infix(["has_sup", [12, "right"]])

def has_inf:
  new_definition(
    @hol|{s has_inf b <=> (!c. (!x:real. x IN s ==> c <= x) <=> c <= b)}|
  )

def has_sup:
  new_definition(
    @hol|{s has_sup b <=> (!c. (!x:real. x IN s ==> x <= c) <=> b <= c)}|
  )

def HAS_INF_LBOUND:
  prove(
    [
      @hol|{!s b x. s has_inf b /\ x IN s ==> b <= x}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [has_inf]) then_tac \
      MESON_TAC(PairList [REAL_LE_REFL])
    ]
  )

def HAS_SUP_UBOUND:
  prove(
    [
      @hol|{!s b x. s has_sup b /\ x IN s ==> x <= b}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [has_sup]) then_tac \
      MESON_TAC(PairList [REAL_LE_REFL])
    ]
  )

def HAS_INF_INF:
  prove(
    [
      @hol|{!s l. s has_inf l <=>
         ~(s = {}) /\
         (?b. !x. x IN s ==> b <= x) /\
         inf s = l}|,
      GEN_TAC then_tac GEN_TAC then_tac REWRITE_TAC(PairList [has_inf]) then_tac \
      EQ_TAC then_tac \
      STRIP_TAC then_list \
      PairList [
        CONJ_TAC then_list \
        PairList [
          REFUTE_THEN(SUBST_ALL_TAC) then_tac POP_ASSUM(MP_TAC) then_tac \
          REWRITE_TAC(PairList [NOT_IN_EMPTY, NOT_FORALL_THM]) then_tac \
          EXISTS_TAC(
            @hol|{l + &1:real}|
          ) then_tac \
          REAL_ARITH_TAC,
          ALL_TAC
        ] then_tac \
        CONJ_TAC then_list \
        PairList [
          ASM_REWRITE_TAC(PairList []) then_tac MESON_TAC(PairList [REAL_LE_REFL]),
          ALL_TAC
        ] then_tac \
        MATCH_MP_TAC(INF_UNIQUE) then_tac \
        ASM_REWRITE_TAC(PairList []),
        GEN_TAC then_tac \
        MP_TAC(SPEC(@hol|{s:real->bool}|)(INF)) then_tac \
        ANTS_TAC then_list \
        PairList [
          ASM_REWRITE_TAC(PairList []) then_tac ASM_MESON_TAC(PairList []),
          ALL_TAC
        ] then_tac \
        POP_ASSUM(SUBST_ALL_TAC) then_tac \
        STRIP_TAC then_tac \
        EQ_TAC then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        REPEAT(STRIP_TAC) then_tac \
        TRANS_TAC(REAL_LE_TRANS)(@hol|{l:real}|) then_tac \
        ASM_SIMP_TAC(PairList [])
      ]
    ]
  )

def HAS_SUP_SUP:
  prove(
    [
      @hol|{!s l. s has_sup l <=>
         ~(s = {}) /\
         (?b. !x. x IN s ==> x <= b) /\
         sup s = l}|,
      GEN_TAC then_tac GEN_TAC then_tac REWRITE_TAC(PairList [has_sup]) then_tac \
      EQ_TAC then_tac \
      STRIP_TAC then_list \
      PairList [
        CONJ_TAC then_list \
        PairList [
          REFUTE_THEN(SUBST_ALL_TAC) then_tac POP_ASSUM(MP_TAC) then_tac \
          REWRITE_TAC(PairList [NOT_IN_EMPTY, NOT_FORALL_THM]) then_tac \
          EXISTS_TAC(
            @hol|{l - &1:real}|
          ) then_tac \
          REAL_ARITH_TAC,
          ALL_TAC
        ] then_tac \
        CONJ_TAC then_list \
        PairList [
          ASM_REWRITE_TAC(PairList []) then_tac MESON_TAC(PairList [REAL_LE_REFL]),
          ALL_TAC
        ] then_tac \
        MATCH_MP_TAC(SUP_UNIQUE) then_tac \
        ASM_REWRITE_TAC(PairList []),
        GEN_TAC then_tac \
        MP_TAC(SPEC(@hol|{s:real->bool}|)(SUP)) then_tac \
        ANTS_TAC then_list \
        PairList [
          ASM_REWRITE_TAC(PairList []) then_tac ASM_MESON_TAC(PairList []),
          ALL_TAC
        ] then_tac \
        POP_ASSUM(SUBST_ALL_TAC) then_tac \
        STRIP_TAC then_tac \
        EQ_TAC then_tac \
        ASM_REWRITE_TAC(PairList []) then_tac \
        REPEAT(STRIP_TAC) then_tac \
        TRANS_TAC(REAL_LE_TRANS)(@hol|{l:real}|) then_tac \
        ASM_SIMP_TAC(PairList [])
      ]
    ]
  )

def INF_EXISTS:
  prove(
    [
      @hol|{!s. (?l. s has_inf l) <=> ~(s = {}) /\ (?b. !x. x IN s ==> b <= x)}|,
      MESON_TAC(PairList [HAS_INF_INF])
    ]
  )

def SUP_EXISTS:
  prove(
    [
      @hol|{!s. (?l. s has_sup l) <=> ~(s = {}) /\ (?b. !x. x IN s ==> x <= b)}|,
      MESON_TAC(PairList [HAS_SUP_SUP])
    ]
  )

def HAS_INF_APPROACH:
  prove(
    [
      @hol|{!s l c. s has_inf l /\ l < c ==> ?x. x IN s /\ x < c}|,
      REWRITE_TAC(PairList [HAS_INF_INF]) then_tac MESON_TAC(PairList [INF_APPROACH])
    ]
  )

def HAS_SUP_APPROACH:
  prove(
    [
      @hol|{!s l c. s has_sup l /\ c < l ==> ?x. x IN s /\ c < x}|,
      REWRITE_TAC(PairList [HAS_SUP_SUP]) then_tac MESON_TAC(PairList [SUP_APPROACH])
    ]
  )

def HAS_INF:
  prove(
    [
      @hol|{!s l. s has_inf l <=>
         ~(s = {}) /\
         (!x. x IN s ==> l <= x) /\
         (!c. l < c ==> ?x. x IN s /\ x < c)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [
        INTRO_TAC("hp") then_tac CONJ_TAC then_list \
        PairList [
          HYP_TAC("hp")(REWRITE_RULE(PairList [HAS_INF_INF])) then_tac \
          ASM_REWRITE_TAC(PairList []),
          ALL_TAC
        ] then_tac \
        CONJ_TAC then_list \
        PairList [
          ASM_MESON_TAC(PairList [HAS_INF_LBOUND]),
          ASM_MESON_TAC(PairList [HAS_INF_APPROACH])
        ],
        ALL_TAC
      ] then_tac \
      INTRO_TAC("ne bound approach") then_tac \
      ASM_REWRITE_TAC(PairList [has_inf]) then_tac \
      GEN_TAC then_tac \
      EQ_TAC then_list \
      PairList [
        INTRO_TAC("hp") then_tac REWRITE_TAC(PairList [GSYM(REAL_NOT_LT)]) then_tac \
        INTRO_TAC("lc") then_tac \
        REMOVE_THEN("approach")(
          o(MP_TAC)(
            SPEC(
              @hol|{(l + c) / &2}|
            )
          )
        ) then_tac \
        ANTS_TAC then_list \
        PairList [ASM_REAL_ARITH_TAC, INTRO_TAC("@x0. x0 +")] then_tac \
        USE_THEN("x0")(o(HYP_TAC("hp"))(C(MATCH_MP))) then_tac \
        ASM_REAL_ARITH_TAC,
        INTRO_TAC("hp; !x; x") then_tac \
        TRANS_TAC(REAL_LE_TRANS)(@hol|{l:real}|) then_tac \
        ASM_SIMP_TAC(PairList [])
      ]
    ]
  )

def HAS_SUP:
  prove(
    [
      @hol|{!s l. s has_sup l <=>
         ~(s = {}) /\
         (!x. x IN s ==> x <= l) /\
         (!c. c < l ==> ?x. x IN s /\ c < x)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [
        INTRO_TAC("hp") then_tac CONJ_TAC then_list \
        PairList [
          HYP_TAC("hp")(REWRITE_RULE(PairList [HAS_SUP_SUP])) then_tac \
          ASM_REWRITE_TAC(PairList []),
          ALL_TAC
        ] then_tac \
        CONJ_TAC then_list \
        PairList [
          ASM_MESON_TAC(PairList [HAS_SUP_UBOUND]),
          ASM_MESON_TAC(PairList [HAS_SUP_APPROACH])
        ],
        ALL_TAC
      ] then_tac \
      INTRO_TAC("ne bound approach") then_tac \
      ASM_REWRITE_TAC(PairList [has_sup]) then_tac \
      GEN_TAC then_tac \
      EQ_TAC then_list \
      PairList [
        INTRO_TAC("hp") then_tac REWRITE_TAC(PairList [GSYM(REAL_NOT_LT)]) then_tac \
        INTRO_TAC("lc") then_tac \
        REMOVE_THEN("approach")(
          o(MP_TAC)(
            SPEC(
              @hol|{(l + c) / &2}|
            )
          )
        ) then_tac \
        ANTS_TAC then_list \
        PairList [ASM_REAL_ARITH_TAC, INTRO_TAC("@x0. x0 +")] then_tac \
        USE_THEN("x0")(o(HYP_TAC("hp"))(C(MATCH_MP))) then_tac \
        ASM_REAL_ARITH_TAC,
        INTRO_TAC("hp; !x; x") then_tac \
        TRANS_TAC(REAL_LE_TRANS)(@hol|{l:real}|) then_tac \
        ASM_SIMP_TAC(PairList [])
      ]
    ]
  )

def HAS_INF_LE:
  prove(
    [
      @hol|{!s t l m. s has_inf l /\ t has_inf m /\
         (!y. y IN t ==> ?x. x IN s /\ x <= y)
         ==> l <= m}|,
      INTRO_TAC("!s t l m; l m le") then_tac \
      HYP_TAC("l: s l1 l2")(REWRITE_RULE(PairList [HAS_INF])) then_tac \
      HYP_TAC("m: t m1 m2")(REWRITE_RULE(PairList [HAS_INF])) then_tac \
      REFUTE_THEN(o(LABEL_TAC("lt"))(REWRITE_RULE(PairList [REAL_NOT_LE]))) then_tac \
      CLAIM_TAC(
        "@c. c1 c2")(
        @hol|{?c:real. m < c /\ c < l}|
      ) then_list \
      PairList [
        EXISTS_TAC(
          @hol|{(l + m) / &2}|
        ) then_tac \
        ASM_REAL_ARITH_TAC,
        ALL_TAC
      ] then_tac \
      HYP_TAC("m2: +")(SPEC(@hol|{c:real}|)) then_tac \
      ASM_REWRITE_TAC(PairList [NOT_EXISTS_THM]) then_tac \
      INTRO_TAC("!x; x xc") then_tac \
      CLAIM_TAC(
        "@y. y yx")(
        @hol|{?y:real. y IN s /\ y <= x}|
      ) then_list \
      PairList [HYP(MESON_TAC)("le x")(PairList []), ALL_TAC] then_tac \
      HYP_TAC("l1: +")(SPEC(@hol|{y:real}|)) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_REAL_ARITH_TAC
    ]
  )

def HAS_SUP_LE:
  prove(
    [
      @hol|{!s t l m. s has_sup l /\ t has_sup m /\
         (!y. y IN t ==> ?x. x IN s /\ y <= x)
         ==> m <= l}|,
      INTRO_TAC("!s t l m; l m le") then_tac \
      HYP_TAC("l: s l1 l2")(REWRITE_RULE(PairList [HAS_SUP])) then_tac \
      HYP_TAC("m: t m1 m2")(REWRITE_RULE(PairList [HAS_SUP])) then_tac \
      REFUTE_THEN(o(LABEL_TAC("lt"))(REWRITE_RULE(PairList [REAL_NOT_LE]))) then_tac \
      CLAIM_TAC(
        "@c. c1 c2")(
        @hol|{?c:real. l < c /\ c < m}|
      ) then_list \
      PairList [
        EXISTS_TAC(
          @hol|{(l + m) / &2}|
        ) then_tac \
        ASM_REAL_ARITH_TAC,
        ALL_TAC
      ] then_tac \
      HYP_TAC("m2: +")(SPEC(@hol|{c:real}|)) then_tac \
      ASM_REWRITE_TAC(PairList [NOT_EXISTS_THM]) then_tac \
      INTRO_TAC("!x; x xc") then_tac \
      CLAIM_TAC(
        "@y. y yx")(
        @hol|{?y:real. y IN s /\ x <= y}|
      ) then_list \
      PairList [HYP(MESON_TAC)("le x")(PairList []), ALL_TAC] then_tac \
      HYP_TAC("l1: +")(SPEC(@hol|{y:real}|)) then_tac \
      ASM_REWRITE_TAC(PairList []) then_tac \
      ASM_REAL_ARITH_TAC
    ]
  )

def new_inductive_set:
  let const_of_var = (fun(v): mk_mconst([Host.name_of(v), type_of(v)]))
  // Recursive traversal needs the local definition before its first use.
  fun f(n):
    fun(tm):
      fun(arg):
        match arg
        | PairList []: tm
        | PairList [ty, & tys]:
              let v = variant(variables(tm))(mk_var([("x" +& to_string(n)), ty]))
              f((n + 1))(mk_comb([tm, v]))(tys)
  let comb_all:
    fun(tm):
      let tys = fst(splitlist(dest_fun_ty)(type_of(tm)))
      f(0)(tm)(tys)
  let mk_eqin = o(REWR_CONV(GSYM(IN)))(comb_all)
  let transf = (fun(conv): o(o(rhs)(concl))(conv))
  let remove_in_conv:
    fun(ptm):
      fun(tm):
        let rconv = REWR_CONV(SYM(mk_eqin(ptm)))
        let htm = fst(strip_comb(snd(dest_binary("IN")(tm))))
        (if (htm == ptm) | rconv(tm) | fail())
  let remove_in_transf = o(o(o(transf)(ONCE_DEPTH_CONV))(FIRST_CONV))(map(remove_in_conv))
  let rule_head:
    fun(tm):
      let tm = snd(strip_forall(tm))
      let tm = snd(splitlist(dest_binop(@hol|{(==>)}|))(tm))
      let tm = snd(dest_binary("IN")(tm))
      fst(strip_comb(tm))
  let find_pvars = o(o(setify)(map(rule_head)))(binops(@hol|{(/\)}|))
  fun(tm):
    let pvars = find_pvars(tm)
    let dtm = remove_in_transf(pvars)(tm)
    let [th_rules, th_induct, th_cases] = new_inductive_definition(dtm)
    let insert_in_rule = REWRITE_RULE(map(o(mk_eqin)(const_of_var))(pvars))
    [insert_in_rule(th_rules), insert_in_rule(th_induct), insert_in_rule(th_cases)]

def FINITE_RULES = sets_FINITE_RULES_v2

def FINITE_INDUCT = sets_FINITE_INDUCT_v2

def CROSS_UNIONS_UNIONS = sets_CROSS_UNIONS_UNIONS_v2

def CROSS_INTERS_INTERS = sets_CROSS_INTERS_INTERS_v2
