      SET_TAC(PairList [])
    ]
  )

def INSERT_AC:
  prove(
    [
      @hol|{(x:A) INSERT (y INSERT s) = y INSERT (x INSERT s) /\
         x INSERT (x INSERT s) = x INSERT s}|,
      REWRITE_TAC(PairList [INSERT_COMM, INSERT_INSERT])
    ]
  )

def INTER_ACI:
  prove(
    [
      @hol|{((p:A->bool) INTER q = q INTER p) /\
         ((p INTER q) INTER r = p INTER q INTER r) /\
         (p INTER q INTER r = q INTER p INTER r) /\
         (p INTER p = p) /\
         (p INTER p INTER q = p INTER q)}|,
      SET_TAC(PairList [])
    ]
  )

def UNION_ACI:
  prove(
    [
      @hol|{((p:A->bool) UNION q = q UNION p) /\
         ((p UNION q) UNION r = p UNION q UNION r) /\
         (p UNION q UNION r = q UNION p UNION r) /\
         (p UNION p = p) /\
         (p UNION p UNION q = p UNION q)}|,
      SET_TAC(PairList [])
    ]
  )

