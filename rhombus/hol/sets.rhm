             ==> (UNIONS(
                    GSPEC(
                      fun (gen_pvar_106 :: A -> bool):
                        exists t :: A -> bool:
                          SETSPEC(
                            gen_pvar_106,
                            IN(t, f) && (forall u :: A -> bool: IN(u, f) ==> !PSUBSET(t, u)),
                            t
                          )
