    [
      (hol:
         const RESTRICTION :: (A -> bool) -> (A -> B) -> A -> B
         forall (s :: A -> bool, f :: A -> B): RESTRICTION(s, RESTRICTION(s, f)) == RESTRICTION(s, f)),
