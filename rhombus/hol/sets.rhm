def CARD_EQ_BIJECTION:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("B"), Bool),
          Implies(
            And(
              App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
              And(
                App(Const("FINITE", Fun(Fun(Tvar("B"), Bool), Bool)), [Ref("t")]),
                Eq(
                  Num,
                  App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")]),
                  App(Const("CARD", Fun(Fun(Tvar("B"), Bool), Num)), [Ref("t")])
                )
              )
            ),
            Exists(
              "f",
              Fun(Tvar("A"), Tvar("B")),
              And(
                Forall(
                  "x",
                  Tvar("A"),
                  Implies(
                    App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                    App(
                      Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))),
                      [App(Ref("f"), [Ref("x")]), Ref("t")]
                    )
                  )
                ),
                And(
                  Forall(
                    "y",
                    Tvar("B"),
                    Implies(
                      App(Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))), [Ref("y"), Ref("t")]),
                      Exists(
                        "x",
                        Tvar("A"),
                        And(
                          App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                          Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), Ref("y"))
                        )
                      )
                    )
                  ),
                  Forall(
                    "x",
                    Tvar("A"),
                    Forall(
                      "y",
                      Tvar("A"),
                      Implies(
                        And(
                          App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                          And(
                            App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("y"), Ref("s")]),
                            Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("f"), [Ref("y")]))
                          )
                        ),
                        Eq(Tvar("A"), Ref("x"), Ref("y"))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  MP_TAC(CARD_LE_INJ) then_tac \
                  REPEAT((MATCH_MP_TAC(MONO_FORALL) then_tac GEN_TAC))
                ) then_tac \
                DISCH_THEN((fun(th): (STRIP_TAC then_tac MP_TAC(th))))
              ) then_tac \
              ASM_REWRITE_TAC(PairList [LE_REFL])
            ) then_tac \
            MATCH_MP_TAC(MONO_EXISTS)
          ) then_tac \
          ASM_SIMP_TAC(PairList [SURJECTIVE_IFF_INJECTIVE_GEN])
        ) then_tac \
        MESON_TAC(PairList [SUBSET, IN_IMAGE])
      )
    ]
  )

