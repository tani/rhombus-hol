Host.parse_as_infix(["IN", [11, "right"]])

Host.parse_as_infix(["SUBSET", [12, "right"]])

Host.parse_as_infix(["PSUBSET", [12, "right"]])

Host.parse_as_infix(["INTER", [20, "right"]])

Host.parse_as_infix(["UNION", [16, "right"]])

Host.parse_as_infix(["DIFF", [18, "left"]])

Host.parse_as_infix(["INSERT", [21, "right"]])

Host.parse_as_infix(["DELETE", [21, "left"]])

Host.parse_as_infix(["HAS_SIZE", [12, "right"]])

