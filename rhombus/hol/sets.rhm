  )

def ITSET:
  new_definition(
    hol_term(Eq(
      Tvar("B"),
      App(
        Var(
          "ITSET",
          Fun(
            Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
            Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Tvar("B")))
          )
        ),
        [
          Var("f", Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B")))),
          Var("s", Fun(Tvar("A"), Bool)),
          Var("b", Tvar("B"))
        ]
      ),
      App(
        Const(
          "@",
          Fun(Fun(Fun(Fun(Tvar("A"), Bool), Tvar("B")), Bool), Fun(Fun(Tvar("A"), Bool), Tvar("B")))
        ),
        [
          Lambda(
            "g",
            Fun(Fun(Tvar("A"), Bool), Tvar("B")),
            And(
              Eq(Tvar("B"), App(Ref("g"), [Const("EMPTY", Fun(Tvar("A"), Bool))]), Var("b", Tvar("B"))),
              Forall(
                "x",
                Tvar("A"),
                Forall(
                  "s",
                  Fun(Tvar("A"), Bool),
                  Implies(
                    App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                    Eq(
                      Tvar("B"),
                      App(
                        Ref("g"),
                        [
                          App(
                            Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                            [Ref("x"), Ref("s")]
                          )
                        ]
                      ),
                      App(
                        Const("COND", Fun(Bool, Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))))),
                        [
                          App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                          App(Ref("g"), [Ref("s")]),
                          App(Var("f", Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B")))), [Ref("x"), App(Ref("g"), [Ref("s")])])
                        ]
                      )
                    )
                  )
                )
              )
            )
          ),
          Var("s", Fun(Tvar("A"), Bool))
        ]
      )
    ))
  )

def FINITE_RECURSION:
  prove(
    [
      hol_term(Forall(
        "f",
        Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
        Forall(
          "b",
          Tvar("B"),
          Implies(
            Forall(
              "x",
              Tvar("A"),
              Forall(
                "y",
                Tvar("A"),
                Forall(
                  "s",
                  Tvar("B"),
                  Implies(
                    Not(Eq(Tvar("A"), Ref("x"), Ref("y"))),
                    Eq(
                      Tvar("B"),
                      App(Ref("f"), [Ref("x"), App(Ref("f"), [Ref("y"), Ref("s")])]),
                      App(Ref("f"), [Ref("y"), App(Ref("f"), [Ref("x"), Ref("s")])])
                    )
                  )
                )
              )
            ),
            And(
              Eq(
                Tvar("B"),
                App(
                  Const(
                    "ITSET",
                    Fun(
                      Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
                      Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Tvar("B")))
                    )
                  ),
                  [Ref("f"), Const("EMPTY", Fun(Tvar("A"), Bool)), Ref("b")]
                ),
                Ref("b")
              ),
              Forall(
                "x",
                Tvar("A"),
                Forall(
                  "s",
                  Fun(Tvar("A"), Bool),
                  Implies(
                    App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                    Eq(
                      Tvar("B"),
                      App(
                        Const(
                          "ITSET",
                          Fun(
                            Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
                            Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Tvar("B")))
                          )
                        ),
                        [
                          Ref("f"),
                          App(
                            Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                            [Ref("x"), Ref("s")]
                          ),
                          Ref("b")
                        ]
                      ),
                      App(
                        Const("COND", Fun(Bool, Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))))),
                        [
                          App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                          App(
                            Const(
                              "ITSET",
                              Fun(
                                Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
                                Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Tvar("B")))
                              )
                            ),
                            [Ref("f"), Ref("s"), Ref("b")]
                          ),
                          App(
                            Ref("f"),
                            [
                              Ref("x"),
                              App(
                                Const(
                                  "ITSET",
                                  Fun(
                                    Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
                                    Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Tvar("B")))
                                  )
                                ),
                                [Ref("f"), Ref("s"), Ref("b")]
                              )
                            ]
                          )
                        ]
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (REPEAT(GEN_TAC) then_tac DISCH_TAC) then_tac \
              REWRITE_TAC(PairList [ITSET])
            ) then_tac \
            CONV_TAC(SELECT_CONV)
          ) then_tac \
          MATCH_MP_TAC(SET_RECURSION_LEMMA)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

