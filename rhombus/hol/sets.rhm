def BIJECTIONS_HAS_SIZE_EQ:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const HAS_SIZE :: (A -> bool) -> num -> bool
         forall (s :: A -> bool, t :: B -> bool, f :: A -> B, g :: B -> A):
           ((forall x :: A: IN(x, s) ==> IN(f(x), t) && g(f(x)) == x)
              && (forall y :: B: IN(y, t) ==> IN(g(y), s) && f(g(y)) == y))
