def new_inductive_set:
  let const_of_var = (fun(v): Basics.mk_mconst([Host.name_of(v), Fusion.type_of(v)]))
  fun f(n):
    fun(tm):
      fun
      | (PairList []): tm
      | (PairList [ty, & tys]):
          let v = Fusion.variant(Basics.variables(tm))(Fusion.mk_var([Host.hol_concat("x")(Host.hol_string_of_int(n)), ty]))
          f(Host.hol_add(n)(1))(Fusion.mk_comb([tm, v]))(tys)
  let comb_all:
    fun(tm):
      let tys = fst(splitlist(Basics.dest_fun_ty)(Fusion.type_of(tm)))
      f(0)(tm)(tys)
  let mk_eqin = o(Simp.REWR_CONV(Equal.GSYM(IN)))(comb_all)
  let transf = (fun(conv): o(o(Equal.rhs)(Fusion.concl))(conv))
  let remove_in_conv:
    fun(ptm):
      let rconv = Simp.REWR_CONV(Equal.SYM(mk_eqin(ptm)))
      fun(tm):
        let htm = fst(Basics.strip_comb(snd(Basics.dest_binary("IN")(tm))))
        (if Host.hol_equal(htm)(ptm) | rconv(tm) | Host.hol_apply_unit(fail))
  let remove_in_transf = o(o(o(transf)(Equal.ONCE_DEPTH_CONV))(Equal.FIRST_CONV))(map(remove_in_conv))
  let rule_head:
    fun(tm):
      let tm = snd(Basics.strip_forall(tm))
      let tm = snd(splitlist(Basics.dest_binop(Host.hol_term(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])))))(tm))
      let tm = snd(Basics.dest_binary("IN")(tm))
      fst(Basics.strip_comb(tm))
  let find_pvars = o(o(Host.setify)(map(rule_head)))(Basics.binops(Host.hol_term(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])))))
  fun(tm):
    let pvars = find_pvars(tm)
    let dtm = remove_in_transf(pvars)(tm)
    let [th_rules, th_induct, th_cases] = IndDefs.new_inductive_definition(dtm)
    let insert_in_rule = Simp.REWRITE_RULE(map(o(mk_eqin)(const_of_var))(pvars))
    [insert_in_rule(th_rules), insert_in_rule(th_induct), insert_in_rule(th_cases)]
