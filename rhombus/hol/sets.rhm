def SET_RECURSION_LEMMA:
  prove(
    [
      hol_term(Forall(
        "f",
        Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
        Forall(
          "b",
          Tvar("B"),
          Implies(
            Forall(
              "x",
              Tvar("A"),
              Forall(
                "y",
                Tvar("A"),
                Forall(
                  "s",
                  Tvar("B"),
                  Implies(
                    Not(Eq(Tvar("A"), Ref("x"), Ref("y"))),
                    Eq(
                      Tvar("B"),
                      App(Ref("f"), [Ref("x"), App(Ref("f"), [Ref("y"), Ref("s")])]),
                      App(Ref("f"), [Ref("y"), App(Ref("f"), [Ref("x"), Ref("s")])])
                    )
                  )
                )
              )
            ),
            Exists(
              "g",
              Fun(Fun(Tvar("A"), Bool), Tvar("B")),
              And(
                Eq(Tvar("B"), App(Ref("g"), [Const("EMPTY", Fun(Tvar("A"), Bool))]), Ref("b")),
                Forall(
                  "x",
                  Tvar("A"),
                  Forall(
                    "s",
                    Fun(Tvar("A"), Bool),
                    Implies(
                      App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                      Eq(
                        Tvar("B"),
                        App(
                          Ref("g"),
                          [
                            App(
                              Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                              [Ref("x"), Ref("s")]
                            )
                          ]
                        ),
                        App(
                          Const("COND", Fun(Bool, Fun(Tvar("B"), Fun(Tvar("B"), Tvar("B"))))),
                          [
                            App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                            App(Ref("g"), [Ref("s")]),
                            App(Ref("f"), [Ref("x"), App(Ref("g"), [Ref("s")])])
                          ]
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        REPEAT(GEN_TAC) then_tac \
                        DISCH_THEN(
                          o(o(MP_TAC)(SPEC(hol_term(Var("b", Tvar("B"))))))(MATCH_MP(FINREC_FUN))
                        )
                      ) then_tac \
                      DISCH_THEN(
                        X_CHOOSE_THEN(hol_term(Var("g", Fun(Fun(Tvar("A"), Bool), Tvar("B")))))(STRIP_ASSUME_TAC)
                      )
                    ) then_tac \
                    EXISTS_TAC(hol_term(Var("g", Fun(Fun(Tvar("A"), Bool), Tvar("B")))))
                  ) then_tac \
                  ASM_REWRITE_TAC(PairList [])
                ) then_tac \
                REPEAT(GEN_TAC)
              ) then_tac \
              COND_CASES_TAC
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          DISCH_TAC
        ) then_list \
        PairList [
          (
            (AP_TERM_TAC then_tac REWRITE_TAC(PairList [GSYM(ABSORPTION)])) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ),
          (
            SUBGOAL_THEN(
              hol_term(And(
                App(
                  Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)),
                  [
                    App(
                      Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                      [Var("x", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
                    )
                  ]
                ),
                App(
                  Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                  [
                    Var("x", Tvar("A")),
                    App(
                      Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                      [Var("x", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
                    )
                  ]
                )
              ))
            )(MP_TAC) then_list \
            PairList [
              (
                REWRITE_TAC(PairList [IN_INSERT]) then_tac \
                ASM_MESON_TAC(PairList [sets_FINITE_RULES_v2])
              ),
              (
                (
                  (
                    DISCH_THEN(ANTE_RES_THEN(SUBST1_TAC)) then_tac \
                    REPEAT(AP_TERM_TAC)
                  ) then_tac \
                  UNDISCH_TAC(
                    hol_term(Not(
                      App(
                        Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                        [Var("x", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
                      )
                    ))
                  )
                ) then_tac \
                SET_TAC(PairList [])
