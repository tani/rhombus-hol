         const UNIV :: A -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const one :: 1
         const EMPTY :: A -> bool
         UNIV == INSERT(one, EMPTY)),
      SET_TAC(PairList [one])
    ]
