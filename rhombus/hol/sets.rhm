         forall (s :: A -> bool, t :: B -> bool, f :: A -> B, g :: B -> A):
           ((forall x :: A: IN(x, s) ==> IN(f(x), t) && g(f(x)) == x)
              && ((forall y :: B: IN(y, t) ==> IN(g(y), s) && f(g(y)) == y) && HAS_SIZE(s, n)))
             ==> HAS_SIZE(t, n)),
