def cartesian_product:
  new_definition(
    hol_term(Eq(
      Fun(Fun(Tvar("K"), Tvar("A")), Bool),
      App(
        Var(
          "cartesian_product",
          Fun(
            Fun(Tvar("K"), Bool),
            Fun(Fun(Tvar("K"), Fun(Tvar("A"), Bool)), Fun(Fun(Tvar("K"), Tvar("A")), Bool))
          )
        ),
        [Var("k", Fun(Tvar("K"), Bool)), Var("s", Fun(Tvar("K"), Fun(Tvar("A"), Bool)))]
      ),
      App(
        Const("GSPEC", Fun(Fun(Fun(Tvar("K"), Tvar("A")), Bool), Fun(Fun(Tvar("K"), Tvar("A")), Bool))),
        [
          Lambda(
            "GEN%PVAR%142",
            Fun(Tvar("K"), Tvar("A")),
            Exists(
              "f",
              Fun(Tvar("K"), Tvar("A")),
              App(
                Const(
                  "SETSPEC",
                  Fun(Fun(Tvar("K"), Tvar("A")), Fun(Bool, Fun(Fun(Tvar("K"), Tvar("A")), Bool)))
                ),
                [
                  Ref("GEN%PVAR%142"),
                  And(
                    App(
                      Const("EXTENSIONAL", Fun(Fun(Tvar("K"), Bool), Fun(Fun(Tvar("K"), Tvar("A")), Bool))),
                      [Var("k", Fun(Tvar("K"), Bool)), Ref("f")]
                    ),
                    Forall(
                      "i",
                      Tvar("K"),
                      Implies(
                        App(
                          Const("IN", Fun(Tvar("K"), Fun(Fun(Tvar("K"), Bool), Bool))),
                          [Ref("i"), Var("k", Fun(Tvar("K"), Bool))]
                        ),
                        App(
                          Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                          [App(Ref("f"), [Ref("i")]), App(Var("s", Fun(Tvar("K"), Fun(Tvar("A"), Bool))), [Ref("i")])]
                        )
                      )
                    )
                  ),
                  Ref("f")
                ]
              )
            )
          )
        ]
      )
    ))
  )

def IN_CARTESIAN_PRODUCT:
  prove(
    [
      hol_term(Forall(
        "k",
