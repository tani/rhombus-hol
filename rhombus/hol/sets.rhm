def set_of_list:
  new_recursive_definition(list_RECURSION)(
    (hol:
       var set_of_list :: list(A) -> A -> bool
       var h :: A
       var t :: list(A)
       const NIL :: list(A)
       const EMPTY :: A -> bool
       const CONS :: A -> list(A) -> list(A)
       const INSERT :: A -> (A -> bool) -> A -> bool
       set_of_list(NIL) == EMPTY && set_of_list(CONS(h, t)) == INSERT(h, set_of_list(t)))
  )

def list_of_set:
  new_definition(
    (hol:
       var list_of_set :: (A -> bool) -> list(A)
       var s :: A -> bool
       const #{@} :: (A -> bool) -> A
       const set_of_list :: list(A) -> A -> bool
       const LENGTH :: list(A) -> num
       const CARD :: (A -> bool) -> num
       list_of_set(s) == #{@}(fun (l :: list(A)): set_of_list(l) == s && LENGTH(l) == CARD(s)))
  )

def LIST_OF_SET_PROPERTIES:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const set_of_list :: list(A) -> A -> bool
         const list_of_set :: (A -> bool) -> list(A)
         const LENGTH :: list(A) -> num
         const CARD :: (A -> bool) -> num
         forall s :: A -> bool:
           FINITE(s) ==> set_of_list(list_of_set(s)) == s && LENGTH(list_of_set(s)) == CARD(s)),
      (
        (
          (
            (
              REWRITE_TAC(PairList [list_of_set]) then_tac \
              CONV_TAC(BINDER_CONV(RAND_CONV(SELECT_CONV)))
            ) then_tac \
            MATCH_MP_TAC(FINITE_INDUCT_STRONG)
