              ]
            )
          ]
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def BIJECTIONS_CARD_EQ:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         forall (s :: A -> bool, t :: B -> bool, f :: A -> B, g :: B -> A):
           ((FINITE(s) || FINITE(t))
              && ((forall x :: A: IN(x, s) ==> IN(f(x), t) && g(f(x)) == x)
