def CARD:
  new_definition(
    hol_term(Eq(
      Num,
      App(Var("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Var("s", Fun(Tvar("A"), Bool))]),
      App(
        Const("ITSET", Fun(Fun(Tvar("A"), Fun(Num, Num)), Fun(Fun(Tvar("A"), Bool), Fun(Num, Num)))),
        [
          Lambda("x", Tvar("A"), Lambda("n", Num, App(Const("SUC", Fun(Num, Num)), [Ref("n")]))),
          Var("s", Fun(Tvar("A"), Bool)),
          App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])
        ]
      )
    ))
  )

