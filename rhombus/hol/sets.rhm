                    == GSPEC(
                         fun (gen_pvar_21 :: C):
                           exists a :: C:
                             SETSPEC(
                               gen_pvar_21,
                               exists (x :: A, y :: B): P(x, y) && IN(a, f(x, y)),
                               a
                             )
                       ))
                 && (forall (P :: A -> B -> C -> bool, f :: A -> B -> C -> D -> bool):
                       UNIONS(
                         GSPEC(
                           fun (gen_pvar_22 :: D -> bool):
                             exists (x :: A, y :: B, z :: C):
