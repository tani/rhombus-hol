def REAL_SUP_UNIQUE:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const sup :: (real -> bool) -> real
         forall (s :: real -> bool, b :: real):
           ((forall x :: real: IN(x, s) ==> x <= b)
              && (forall #{|b'|} :: real:
                    #{|b'|} < b ==> (exists x :: real: IN(x, s) && #{|b'|} < x)))
             ==> sup(s) == b),
