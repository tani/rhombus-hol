    [
      @hol|{!s t:A->bool. s PSUBSET t <=> s SUBSET t /\ (?a. a IN t /\ ~(a IN s))}|,
      REWRITE_TAC(PairList [PSUBSET]) then_tac SET_TAC(PairList [])
    ]
  )

def UNION_ASSOC:
  prove(
    [
      @hol|{!(s:A->bool) t u. (s UNION t) UNION u = s UNION (t UNION u)}|,
