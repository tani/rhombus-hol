def SURJECTIVE_ON_RIGHT_INVERSE:
  prove(
    [
      (hol:
         var s :: A -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (f :: A -> B, t :: B -> bool):
           (forall y :: B: IN(y, t) ==> (exists x :: A: IN(x, s) && f(x) == y))
             <=> (exists g :: B -> A: forall y :: B: IN(y, t) ==> IN(g(y), s) && f(g(y)) == y)),
