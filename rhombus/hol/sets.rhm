         forall (f :: (A -> bool) -> bool, s :: A -> bool):
           (f != EMPTY
              && ((forall (t :: A -> bool, u :: A -> bool):
                     IN(t, f) && IN(u, f)
                       ==> (exists v :: A -> bool: IN(v, f) && (SUBSET(t, v) && SUBSET(u, v))))
                    && FINITE(s)))
             ==> (SUBSET(s, UNIONS(f)) <=> (exists t :: A -> bool: IN(t, f) && SUBSET(s, t)))),
      (
