                PairList [
                  (hol: var s :: A -> bool; s),
                  (hol: var t :: B -> bool; t),
                  (hol: var f :: A -> B; f)
                ])(
                SURJECTIVE_IFF_INJECTIVE_GEN
              )
            )
          ) then_tac \
          ASM_SIMP_TAC(PairList [SUBSET_REFL, FINITE_IMAGE])
        ) then_tac \
        ASM_MESON_TAC(PairList [EXTENSION, IN_IMAGE])
