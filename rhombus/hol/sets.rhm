def FINITE_CARD_LE_UNIONS:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
          Forall(
            "m",
            Num,
            Forall(
              "n",
              Num,
              Implies(
                And(
                  Forall(
                    "x",
                    Tvar("A"),
                    Implies(
                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                      And(
                        App(Const("FINITE", Fun(Fun(Tvar("B"), Bool), Bool)), [App(Ref("t"), [Ref("x")])]),
                        App(
                          Const("<=", Fun(Num, Fun(Num, Bool))),
                          [App(Const("CARD", Fun(Fun(Tvar("B"), Bool), Num)), [App(Ref("t"), [Ref("x")])]), Ref("n")]
                        )
                      )
                    )
                  ),
                  And(
                    App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                    App(
                      Const("<=", Fun(Num, Fun(Num, Bool))),
                      [App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")]), Ref("m")]
                    )
                  )
                ),
                And(
                  App(
                    Const("FINITE", Fun(Fun(Tvar("B"), Bool), Bool)),
                    [
                      App(
                        Const("UNIONS", Fun(Fun(Fun(Tvar("B"), Bool), Bool), Fun(Tvar("B"), Bool))),
                        [
                          App(
                            Const("GSPEC", Fun(Fun(Fun(Tvar("B"), Bool), Bool), Fun(Fun(Tvar("B"), Bool), Bool))),
                            [
                              Lambda(
                                "GEN%PVAR%161",
                                Fun(Tvar("B"), Bool),
                                Exists(
                                  "x",
                                  Tvar("A"),
                                  App(
                                    Const("SETSPEC", Fun(Fun(Tvar("B"), Bool), Fun(Bool, Fun(Fun(Tvar("B"), Bool), Bool)))),
                                    [
                                      Ref("GEN%PVAR%161"),
                                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                                      App(Ref("t"), [Ref("x")])
                                    ]
                                  )
                                )
                              )
                            ]
                          )
                        ]
                      )
                    ]
                  ),
                  App(
                    Const("<=", Fun(Num, Fun(Num, Bool))),
                    [
                      App(
                        Const("CARD", Fun(Fun(Tvar("B"), Bool), Num)),
                        [
                          App(
                            Const("UNIONS", Fun(Fun(Fun(Tvar("B"), Bool), Bool), Fun(Tvar("B"), Bool))),
                            [
                              App(
                                Const("GSPEC", Fun(Fun(Fun(Tvar("B"), Bool), Bool), Fun(Fun(Tvar("B"), Bool), Bool))),
                                [
                                  Lambda(
                                    "GEN%PVAR%162",
                                    Fun(Tvar("B"), Bool),
                                    Exists(
                                      "x",
                                      Tvar("A"),
                                      App(
                                        Const("SETSPEC", Fun(Fun(Tvar("B"), Bool), Fun(Bool, Fun(Fun(Tvar("B"), Bool), Bool)))),
                                        [
                                          Ref("GEN%PVAR%162"),
                                          App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                                          App(Ref("t"), [Ref("x")])
                                        ]
                                      )
                                    )
                                  )
                                ]
                              )
                            ]
                          )
                        ]
                      ),
                      App(Const("*", Fun(Num, Fun(Num, Num))), [Ref("m"), Ref("n")])
                    ]
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                REPEAT(STRIP_TAC) then_tac \
                ASM_SIMP_TAC(PairList [FINITE_UNIONS, FORALL_IN_GSPEC, FINITE_IMAGE, SIMPLE_IMAGE])
              ) then_tac \
              TRANS_TAC(LE_TRANS)(
