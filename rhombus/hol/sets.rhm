                Implies(
                  App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Var("s", Fun(Real, Bool))]),
                  App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("a"), Ref("x")])
                )
              ),
              Forall(
                "b",
                Real,
                Implies(
                  Forall(
                    "x",
                    Real,
                    Implies(
                      App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Var("s", Fun(Real, Bool))]),
                      App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("b"), Ref("x")])
                    )
                  ),
                  App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("b"), Ref("a")])
                )
              )
            )
          )
        ]
      )
    ))
  )

