              Ref("x")
            )
          )
        ),
        Forall(
          "y",
          Tvar("B"),
          Forall(
            "x",
            Tvar("A"),
            Implies(
              And(
                App(
                  Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                  [Ref("x"), Var("s", Fun(Tvar("A"), Bool))]
                ),
                Eq(Tvar("B"), Ref("y"), App(Var("f", Fun(Tvar("A"), Tvar("B"))), [Ref("x")]))
              ),
              Eq(Tvar("A"), App(Var("g", Fun(Tvar("B"), Tvar("A"))), [Ref("y")]), Ref("x"))
            )
          )
        )
      ))
    )
  prove(
    [
      hol_term(Forall(
        "f",
        Fun(Tvar("A"), Tvar("B")),
        Forall(
          "s",
          Fun(Tvar("A"), Bool),
          Iff(
            Forall(
              "x",
              Tvar("A"),
              Forall(
                "y",
                Tvar("A"),
                Implies(
                  And(
                    App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                    And(
                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("y"), Ref("s")]),
                      Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("f"), [Ref("y")]))
                    )
                  ),
                  Eq(Tvar("A"), Ref("x"), Ref("y"))
                )
              )
            ),
            Exists(
              "g",
              Fun(Tvar("B"), Tvar("A")),
              Forall(
                "x",
                Tvar("A"),
                Implies(
                  App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                  Eq(Tvar("A"), App(Ref("g"), [App(Ref("f"), [Ref("x")])]), Ref("x"))
                )
              )
            )
          )
        )
      )),
      (
        REWRITE_TAC(PairList [lemma, GSYM(SKOLEM_THM)]) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

