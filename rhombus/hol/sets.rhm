         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         (forall (f :: (A -> bool) -> bool, s :: A -> bool):
            INTER(s, INTERS(f))
              == (if f == EMPTY
                  | s
                  | INTERS(
                      GSPEC(
                        fun (gen_pvar_75 :: A -> bool):
                          exists t :: A -> bool: SETSPEC(gen_pvar_75, IN(t, f), INTER(s, t))
