    ]
  )

def ARB:
  new_definition(
    (hol:
       var ARB :: A
       const #{@} :: (A -> bool) -> A
       ARB == #{@}(fun (x :: A): #false))
  )

def EXTENSIONAL:
  new_definition(
    (hol:
       var EXTENSIONAL :: (A -> bool) -> (A -> B) -> bool
       var s :: A -> bool
       const GSPEC :: (A -> bool) -> A -> bool
       const SETSPEC :: A -> bool -> A -> bool
       const IN :: A -> (A -> bool) -> bool
       const ARB :: A
       EXTENSIONAL(s)
         == GSPEC(
              fun (gen_pvar_141 :: A -> B):
                exists f :: A -> B:
                  SETSPEC(gen_pvar_141, forall x :: A: !IN(x, s) ==> f(x) == ARB, f)
            ))
  )

def IN_EXTENSIONAL:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const EXTENSIONAL :: (A -> bool) -> (A -> B) -> bool
         const ARB :: A
         forall (s :: A -> bool, f :: A -> B):
           IN(f, EXTENSIONAL(s)) <=> (forall x :: A: !IN(x, s) ==> f(x) == ARB)),
      REWRITE_TAC(PairList [EXTENSIONAL, IN_ELIM_THM])
    ]
  )

def IN_EXTENSIONAL_UNDEFINED:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const EXTENSIONAL :: (A -> bool) -> (A -> B) -> bool
         const ARB :: A
         forall (s :: A -> bool, f :: A -> B, x :: A):
           IN(f, EXTENSIONAL(s)) && !IN(x, s) ==> f(x) == ARB),
      SIMP_TAC(PairList [IN_EXTENSIONAL])
    ]
  )

def EXTENSIONAL_EMPTY:
  prove(
    [
      (hol:
         const EXTENSIONAL :: (A -> bool) -> (A -> B) -> bool
         const EMPTY :: A -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const ARB :: A
         EXTENSIONAL(EMPTY) == (INSERT :: (A -> B) -> ((A -> B) -> bool) -> (A -> B) -> bool)(fun (x :: A): (ARB :: B), (EMPTY :: (A -> B) -> bool))),
      (
        REWRITE_TAC(PairList [EXTENSION, IN_EXTENSIONAL, IN_SING, NOT_IN_EMPTY]) then_tac \
        REWRITE_TAC(PairList [FUN_EQ_THM])
      )
    ]
  )

def EXTENSIONAL_UNIV:
  prove(
    [
      (hol:
         const EXTENSIONAL :: (A -> bool) -> (A -> B) -> bool
         const UNIV :: A -> bool
         forall f :: A -> B: EXTENSIONAL(UNIV, f)),
      REWRITE_TAC(PairList [EXTENSIONAL, IN_UNIV, IN_ELIM_THM])
    ]
  )

def EXTENSIONAL_EQ:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const EXTENSIONAL :: (A -> bool) -> (A -> B) -> bool
         forall (s :: A -> bool, f :: A -> B, g :: A -> B):
           (IN(f, EXTENSIONAL(s))
              && (IN(g, EXTENSIONAL(s)) && (forall x :: A: IN(x, s) ==> f(x) == g(x))))
             ==> f == g),
      (
        (
          (
            (REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [FUN_EQ_THM])) then_tac \
            GEN_TAC
          ) then_tac \
          ASM_CASES_TAC(
            (hol:
               var x :: A
               var s :: A -> bool
               const IN :: A -> (A -> bool) -> bool
               IN(x, s))
          )
        ) then_list \
        PairList [
          ASM_SIMP_TAC(PairList []),
          ASM_MESON_TAC(PairList [IN_EXTENSIONAL_UNDEFINED])
        ]
      )
    ]
  )

def RESTRICTION:
  new_definition(
    (hol:
       var RESTRICTION :: (A -> bool) -> (A -> B) -> A -> B
       var s :: A -> bool
       var f :: A -> B
       var x :: A
       const IN :: A -> (A -> bool) -> bool
       const ARB :: A
       RESTRICTION(s, f, x) == (if IN(x, s) | f(x) | ARB))
  )

def RESTRICTION_THM:
  prove(
    [
      (hol:
         const RESTRICTION :: (A -> bool) -> (A -> B) -> A -> B
         const IN :: A -> (A -> bool) -> bool
         const ARB :: A
         forall (s :: A -> bool, f :: A -> B):
           RESTRICTION(s, f) == (fun (x :: A): if IN(x, s) | f(x) | ARB)),
      REWRITE_TAC(PairList [FUN_EQ_THM, RESTRICTION])
    ]
  )

def RESTRICTION_DEFINED:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const RESTRICTION :: (A -> bool) -> (A -> B) -> A -> B
         forall (s :: A -> bool, f :: A -> B, x :: A): IN(x, s) ==> RESTRICTION(s, f, x) == f(x)),
      SIMP_TAC(PairList [RESTRICTION])
    ]
  )

def RESTRICTION_UNDEFINED:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const RESTRICTION :: (A -> bool) -> (A -> B) -> A -> B
         const ARB :: A
         forall (s :: A -> bool, f :: A -> B, x :: A): !IN(x, s) ==> RESTRICTION(s, f, x) == ARB),
      SIMP_TAC(PairList [RESTRICTION])
    ]
  )

def RESTRICTION_EQ:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const RESTRICTION :: (A -> bool) -> (A -> B) -> A -> B
         forall (s :: A -> bool, f :: A -> B, x :: A, y :: B):
           IN(x, s) && f(x) == y ==> RESTRICTION(s, f, x) == y),
      SIMP_TAC(PairList [RESTRICTION_DEFINED])
    ]
  )

def RESTRICTION_IN_EXTENSIONAL:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const RESTRICTION :: (A -> bool) -> (A -> B) -> A -> B
         const EXTENSIONAL :: (A -> bool) -> (A -> B) -> bool
         forall (s :: A -> bool, f :: A -> B): IN(RESTRICTION(s, f), EXTENSIONAL(s))),
      SIMP_TAC(PairList [IN_EXTENSIONAL, RESTRICTION])
    ]
  )

def RESTRICTION_EXTENSION:
  prove(
    [
      (hol:
         const RESTRICTION :: (A -> bool) -> (A -> B) -> A -> B
         const IN :: A -> (A -> bool) -> bool
         forall (s :: A -> bool, f :: A -> B, g :: A -> B):
           RESTRICTION(s, f) == RESTRICTION(s, g) <=> (forall x :: A: IN(x, s) ==> f(x) == g(x))),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          REWRITE_TAC(PairList [RESTRICTION, FUN_EQ_THM])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def RESTRICTION_FIXPOINT:
  prove(
    [
      (hol:
         const RESTRICTION :: (A -> bool) -> (A -> B) -> A -> B
         const IN :: A -> (A -> bool) -> bool
         const EXTENSIONAL :: (A -> bool) -> (A -> B) -> bool
         forall (s :: A -> bool, f :: A -> B): RESTRICTION(s, f) == f <=> IN(f, EXTENSIONAL(s))),
      (
