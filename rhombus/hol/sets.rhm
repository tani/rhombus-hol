def HAS_SIZE_CLAUSES:
  let lemma:
    SET_RULE(
      (hol:
         var a :: #{?95389}
         var s :: #{?95389} -> bool
         const IN :: A -> (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const DELETE :: (A -> bool) -> A -> A -> bool
         IN(a, s) ==> s == INSERT(a, DELETE(s, a)))
    )
  prove(
    [
      (hol:
         var s :: A -> bool
         var n :: num
         const HAS_SIZE :: (A -> bool) -> num -> bool
         const EMPTY :: A -> bool
         const SUC :: num -> num
         const IN :: A -> (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         (HAS_SIZE(s, (0 :: num)) <=> s == EMPTY)
           && (HAS_SIZE(s, SUC(n))
                 <=> (exists (a :: A, t :: A -> bool): HAS_SIZE(t, n) && (!IN(a, t) && s == INSERT(a, t))))),
      (
        (
          (REWRITE_TAC(PairList [HAS_SIZE_0]) then_tac REPEAT(STRIP_TAC)) then_tac \
          EQ_TAC
        ) then_list \
        PairList [
          (
            REWRITE_TAC(PairList [HAS_SIZE_SUC, GSYM(MEMBER_NOT_EMPTY)]) then_tac \
            MESON_TAC(PairList [lemma, IN_DELETE])
          ),
          SIMP_TAC(PairList [LEFT_IMP_EXISTS_THM, HAS_SIZE, CARD_CLAUSES, FINITE_INSERT])
        ]
      )
    ]
  )

def HAS_SIZE_CONV:
  let pth_2:
    prove(
      [
        (hol:
           var a :: A
           var P :: bool
           var b :: A
           var cs :: A -> bool
           const IN :: A -> (A -> bool) -> bool
           const EMPTY :: A -> bool
           const INSERT :: A -> (A -> bool) -> A -> bool
           (!IN(a, EMPTY) && P <=> P)
             && ((!IN(a, INSERT(b, EMPTY)) && P <=> a != b && P)
                   && (!IN(a, INSERT(b, cs)) && P <=> a != b && (!IN(a, cs) && P)))),
        SET_TAC(PairList [])
      ]
    )
  let qth_2:
    prove(
      [
        (hol:
           var P :: (A -> bool) -> bool
           var n :: num
           const HAS_SIZE :: (A -> bool) -> num -> bool
           const EMPTY :: A -> bool
           const SUC :: num -> num
           const IN :: A -> (A -> bool) -> bool
           const INSERT :: A -> (A -> bool) -> A -> bool
           ((exists s :: A -> bool: HAS_SIZE(s, (0 :: num)) && P(s)) <=> P(EMPTY))
             && ((exists s :: A -> bool: HAS_SIZE(s, SUC(n)) && P(s))
                   <=> (exists (a :: A, s :: A -> bool): HAS_SIZE(s, n) && (!IN(a, s) && P(INSERT(a, s)))))),
        (REWRITE_TAC(PairList [HAS_SIZE_CLAUSES]) then_tac MESON_TAC(PairList []))
      ]
    )
  let qconv_0_2 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT1(qth_2)])
  let qconv_1_2 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT2(qth_2)])
  let rconv_0_2 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT1(pth_2)])
  let rconv_1_2 = GEN_REWRITE_CONV(I)(PairList [CONJUNCT2(pth_2)])
  fun EXISTS_HAS_SIZE_AND_CONV(tm):
    (
      qconv_0_2 or_conv \
      (
        (BINDER_CONV(LAND_CONV(RAND_CONV(num_CONV))) then_conv qconv_1_2) then_conv \
        BINDER_CONV(EXISTS_HAS_SIZE_AND_CONV)
      )
    )(tm)
  fun NOT_IN_INSERT_CONV(tm):
    (
      (
        (rconv_0_2 then_conv NOT_IN_INSERT_CONV) or_conv \
        (rconv_1_2 then_conv RAND_CONV(NOT_IN_INSERT_CONV))
      ) or_conv \
      ALL_CONV
    )(tm)
  let HAS_SIZE_CONV:
    (
      GEN_REWRITE_CONV(I)(PairList [CONJUNCT1(HAS_SIZE_CLAUSES)]) or_conv \
      (
        (
          RAND_CONV(num_CONV) then_conv \
          GEN_REWRITE_CONV(I)(PairList [CONJUNCT2(HAS_SIZE_CLAUSES)])
        ) then_conv \
        BINDER_CONV(EXISTS_HAS_SIZE_AND_CONV)
      )
    )
  fun(tm):
    let th = HAS_SIZE_CONV(tm)
    let tm_prime = rand(concl(th))
    let [evs, bod] = strip_exists(tm_prime)
    if (evs == (PairList []))
    | th
    | let th_prime = funpow(length(evs))(BINDER_CONV)(NOT_IN_INSERT_CONV)(tm_prime)
      TRANS(th)(th_prime)

