def INF_UNION:
  prove(
    [
      (hol:
         const EMPTY :: A -> bool
         const IN :: A -> (A -> bool) -> bool
         const inf :: (real -> bool) -> real
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         const real_min :: real -> real -> real
         forall (s :: real -> bool, t :: real -> bool):
           (s != EMPTY
              && (t != EMPTY
                    && ((exists b :: real: forall x :: real: IN(x, s) ==> b <= x)
                          && (exists c :: real: forall x :: real: IN(x, t) ==> c <= x))))
             ==> inf(UNION(s, t)) == real_min(inf(s), inf(t))),
