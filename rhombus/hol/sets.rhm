           pairwise(r, IMAGE(f, s))
             <=> pairwise(fun (x :: A, y :: A): f(x) != f(y) ==> r(f(x), f(y)), s)),
      (REWRITE_TAC(PairList [pairwise, IN_IMAGE]) then_tac MESON_TAC(PairList []))
