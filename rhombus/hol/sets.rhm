def sup:
  new_definition(
    hol_term(Eq(
      Real,
      App(Var("sup", Fun(Fun(Real, Bool), Real)), [Var("s", Fun(Real, Bool))]),
      App(
        Const("@", Fun(Fun(Real, Bool), Real)),
        [
          Lambda(
            "a",
