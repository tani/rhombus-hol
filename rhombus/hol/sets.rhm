Host.parse_as_infix(Pair("IN",Pair(11,"right")))

Host.parse_as_infix(Pair("SUBSET",Pair(12,"right")))

Host.parse_as_infix(Pair("PSUBSET",Pair(12,"right")))

Host.parse_as_infix(Pair("INTER",Pair(20,"right")))

Host.parse_as_infix(Pair("UNION",Pair(16,"right")))

Host.parse_as_infix(Pair("DIFF",Pair(18,"left")))

