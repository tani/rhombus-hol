def CARD_EQ_BIJECTIONS_SPECIAL:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const IN :: A -> (A -> bool) -> bool
         forall (s :: A -> bool, t :: B -> bool, a :: A, b :: B):
           FINITE(s) && (FINITE(t) && (CARD(s) == CARD(t) && (IN(a, s) && IN(b, t))))
             ==> (exists (f :: A -> B, g :: B -> A):
                    f(a) == b
                      && (g(b) == a
                            && ((forall x :: A: IN(x, s) ==> IN(f(x), t) && g(f(x)) == x)
                                  && (forall y :: B: IN(y, t) ==> IN(g(y), s) && f(g(y)) == y))))),
