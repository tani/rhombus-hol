def CROSS_EQ:
  prove(
    [
      (hol:
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         const EMPTY :: A -> bool
         forall (s :: A -> bool, #{|s'|} :: A -> bool, t :: B -> bool, #{|t'|} :: B -> bool):
           CROSS(s, t) == CROSS(#{|s'|}, #{|t'|})
             <=> ((s == EMPTY || t == EMPTY) && (#{|s'|} == EMPTY || #{|t'|} == EMPTY)
