def UNION_EMPTY:
  prove(
    [
      @hol|{(!s:A->bool. EMPTY UNION s = s) /\
         (!s:A->bool. s UNION EMPTY = s)}|,
      SET_TAC(PairList [])
    ]
  )

def UNION_UNIV:
  prove(
    [
      @hol|{(!s:A->bool. UNIV UNION s = UNIV) /\
         (!s:A->bool. s UNION UNIV = UNIV)}|,
      SET_TAC(PairList [])
    ]
  )

def EMPTY_UNION:
  prove(
    [
      @hol|{!s:A->bool. !t. (s UNION t = EMPTY) <=> (s = EMPTY) /\ (t = EMPTY)}|,
      SET_TAC(PairList [])
    ]
  )

def UNION_SUBSET:
  prove(
    [
      @hol|{!s t u:A->bool. (s UNION t) SUBSET u <=> s SUBSET u /\ t SUBSET u}|,
      SET_TAC(PairList [])
    ]
  )

def UNION_RESTRICT:
  prove(
    [
      @hol|{!P s t:A->bool.
         {x | x IN (s UNION t) /\ P x} =
         {x | x IN s /\ P x} UNION {x | x IN t /\ P x}}|,
      SET_TAC(PairList [])
    ]
  )

def FORALL_SUBSET_UNION:
  prove(
    [
      @hol|{!t u:A->bool.
         (!s. s SUBSET t UNION u ==> P s) <=>
         (!t' u'. t' SUBSET t /\ u' SUBSET u ==> P(t' UNION u'))}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [
        REPEAT(STRIP_TAC) then_tac FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
        ASM(SET_TAC)(PairList []),
        DISCH_TAC then_tac X_GEN_TAC(@hol|{s:A->bool}|) then_tac \
        DISCH_TAC then_tac \
        FIRST_ASSUM(
          o(MP_TAC)(
            SPECL(
              PairList [
                @hol|{s INTER t:A->bool}|,
                @hol|{s INTER u:A->bool}|
              ]
            )
          )
        ) then_tac \
        ANTS_TAC then_list \
        PairList [ALL_TAC, MATCH_MP_TAC(EQ_IMP) then_tac AP_TERM_TAC] then_tac \
        ASM(SET_TAC)(PairList [])
      ]
    ]
  )

def EXISTS_SUBSET_UNION:
  prove(
    [
      @hol|{!t u:A->bool.
         (?s. s SUBSET t UNION u /\ P s) <=>
         (?t' u'. t' SUBSET t /\ u' SUBSET u /\ P(t' UNION u'))}|,
      REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [FORALL_SUBSET_UNION]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def FORALL_SUBSET_INSERT:
  prove(
    [
      @hol|{!a:A t. (!s. s SUBSET a INSERT t ==> P s) <=>
         (!s. s SUBSET t ==> P s /\ P (a INSERT s))}|,
      REPEAT(GEN_TAC) then_tac \
      ONCE_REWRITE_TAC(
        PairList [
          SET_RULE(
            @hol|{a INSERT s = {a} UNION s}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(
        PairList [
          FORALL_SUBSET_UNION,
          SET_RULE(
            @hol|{s SUBSET {a} <=> s = {} \/ s = {a}}|
          )
        ]
      ) then_tac \
      MESON_TAC(PairList [UNION_EMPTY])
    ]
  )

def EXISTS_SUBSET_INSERT:
  prove(
    [
      @hol|{!a:A t. (?s. s SUBSET a INSERT t /\ P s) <=>
         (?s. s SUBSET t /\ (P s \/ P (a INSERT s)))}|,
      REWRITE_TAC(
        PairList [
          MESON(
            PairList [])(
            @hol|{(?x. P x /\ Q x) <=> ~(!x. P x ==> ~Q x)}|
          )
        ]
      ) then_tac \
      REWRITE_TAC(PairList [FORALL_SUBSET_INSERT]) then_tac \
      MESON_TAC(PairList [])
    ]
  )

def INTER_ASSOC:
