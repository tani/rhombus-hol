def FINITE_PRODUCT_DEPENDENT:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const IN :: A -> (A -> bool) -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         forall (f :: A -> B -> C, s :: A -> bool, t :: A -> B -> bool):
           FINITE(s) && (forall x :: A: IN(x, s) ==> FINITE(t(x)))
             ==> FINITE(
                   GSPEC(
                     fun (gen_pvar_128 :: C):
                       exists (x :: A, y :: B):
                         SETSPEC(gen_pvar_128, IN(x, s) && IN(y, t(x)), f(x, y))
                   )
                 )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(FINITE_SUBSET)) then_tac \
                                        EXISTS_TAC(
                                          (hol:
                                             var f :: A -> B -> C
                                             var s :: A -> bool
                                             var t :: A -> B -> bool
                                             const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                                             const GABS :: (A -> bool) -> A
                                             const GEQ :: A -> A -> bool
                                             const #{|,|} :: A -> B -> pair(A, B)
                                             const GSPEC :: (A -> bool) -> A -> bool
                                             const SETSPEC :: A -> bool -> A -> bool
                                             const IN :: A -> (A -> bool) -> bool
                                             IMAGE(
                                               GABS(
                                                 fun (f_2 :: pair(A, B) -> C): forall (x :: A, y :: B): GEQ(f_2(#{|,|}(x, y)), f(x, y))
                                               ),
                                               GSPEC(
                                                 fun (gen_pvar_127 :: pair(A, B)):
                                                   exists (x :: A, y :: B): SETSPEC(gen_pvar_127, IN(x, s) && IN(y, t(x)), #{|,|}(x, y))
                                               )
                                             ))
                                        )
                                      ) then_tac \
                                      REWRITE_TAC(PairList [SUBSET, IN_IMAGE, EXISTS_PAIR_THM, IN_ELIM_PAIR_THM])
                                    ) then_tac \
                                    REWRITE_TAC(PairList [FORALL_IN_GSPEC])
                                  ) then_tac \
                                  CONJ_TAC
                                ) then_list \
                                PairList [MATCH_MP_TAC(FINITE_IMAGE), MESON_TAC(PairList [])]
                              ) then_tac \
                              MAP_EVERY(UNDISCH_TAC)(
                                PairList [
                                  (hol:
                                     var s :: A -> bool
                                     var t :: A -> B -> bool
                                     const IN :: A -> (A -> bool) -> bool
                                     const FINITE :: (A -> bool) -> bool
                                     forall x :: A: IN(x, s) ==> FINITE(t(x))),
                                  (hol:
                                     var s :: A -> bool
                                     const FINITE :: (A -> bool) -> bool
                                     FINITE(s))
                                ]
                              )
                            ) then_tac \
                            MAP_EVERY((fun(t): SPEC_TAC([t, t])))(
                              PairList [
                                (hol: var t :: A -> B -> bool; t),
                                (hol: var s :: A -> bool; s)
                              ]
                            )
                          ) then_tac \
                          REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM])
                        ) then_tac \
                        MATCH_MP_TAC(FINITE_INDUCT_STRONG)
                      ) then_tac \
                      CONJ_TAC
                    ) then_list \
                    PairList [
                      (
                        (
                          GEN_TAC then_tac \
                          SUBGOAL_THEN(
                            (hol:
                               var t :: A -> B -> bool
                               const GSPEC :: (A -> bool) -> A -> bool
                               const SETSPEC :: A -> bool -> A -> bool
                               const IN :: A -> (A -> bool) -> bool
                               const EMPTY :: A -> bool
                               const #{|,|} :: A -> B -> pair(A, B)
                               GSPEC(
                                 fun (gen_pvar_126 :: pair(A, B)):
                                   exists (x :: A, y :: B):
                                     SETSPEC(gen_pvar_126, IN(x, EMPTY) && IN(y, t(x)), #{|,|}(x, y))
                               )
                                 == EMPTY)
                          )((fun(th): REWRITE_TAC(PairList [th, sets_FINITE_RULES_v2])))
                        ) then_tac \
                        REWRITE_TAC(PairList [EXTENSION, IN_ELIM_THM, NOT_IN_EMPTY])
                      ),
                      ALL_TAC
                    ]
                  ) then_tac \
                  MAP_EVERY(X_GEN_TAC)(PairList [(hol: var a :: A; a), (hol: var s :: A -> bool; s)])
                ) then_tac \
                STRIP_TAC
              ) then_tac \
              X_GEN_TAC(hol: var t :: A -> B -> bool; t)
            ) then_tac \
            SUBGOAL_THEN(
              (hol:
                 var a :: A
                 var s :: A -> bool
                 var t :: A -> B -> bool
                 const GSPEC :: (A -> bool) -> A -> bool
                 const SETSPEC :: A -> bool -> A -> bool
                 const IN :: A -> (A -> bool) -> bool
                 const INSERT :: A -> (A -> bool) -> A -> bool
                 const #{|,|} :: A -> B -> pair(A, B)
                 const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
                 const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                 GSPEC(
                   fun (gen_pvar_124 :: pair(A, B)):
                     exists (x :: A, y :: B):
                       SETSPEC(gen_pvar_124, IN(x, INSERT(a, s)) && IN(y, t(x)), #{|,|}(x, y))
                 )
                   == UNION(
                        IMAGE(fun (y :: B): #{|,|}(a, y), t(a)),
                        GSPEC(
                          fun (gen_pvar_125 :: pair(A, B)):
                            exists (x :: A, y :: B):
                              SETSPEC(gen_pvar_125, IN(x, s) && IN(y, t(x)), #{|,|}(x, y))
                        )
                      ))
            )((fun(th): ASM_SIMP_TAC(PairList [IN_INSERT, FINITE_IMAGE, FINITE_UNION, th])))
          ) then_tac \
          REWRITE_TAC(PairList [EXTENSION, IN_IMAGE, IN_ELIM_THM, IN_INSERT, IN_UNION])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def FINITE_PRODUCT:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         forall (s :: A -> bool, t :: B -> bool):
           FINITE(s) && FINITE(t)
             ==> FINITE(
                   GSPEC(
                     fun (gen_pvar_129 :: pair(A, B)):
                       exists (x :: A, y :: B):
                         SETSPEC(gen_pvar_129, IN(x, s) && IN(y, t), #{|,|}(x, y))
                   )
                 )),
      SIMP_TAC(PairList [FINITE_PRODUCT_DEPENDENT])
    ]
  )

def CARD_PRODUCT:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         forall (s :: A -> bool, t :: B -> bool):
           FINITE(s) && FINITE(t)
             ==> (CARD(
                    GSPEC(
                      fun (gen_pvar_130 :: pair(A, B)):
                        exists (x :: A, y :: B):
                          SETSPEC(gen_pvar_130, IN(x, s) && IN(y, t), #{|,|}(x, y))
                    )
                  )
                    == CARD(s) * CARD(t))),
      (
        (
          REPEAT(STRIP_TAC) then_tac \
          MP_TAC(
            SPECL(
              PairList [
                (hol: var s :: A -> bool; s),
                (hol:
                   var s :: A -> bool
                   const CARD :: (A -> bool) -> num
                   CARD(s)),
                (hol:
                   var t :: B -> bool
                   fun (x :: A): t),
                (hol:
                   var t :: B -> bool
                   const CARD :: (A -> bool) -> num
                   CARD(t))
              ])(
              HAS_SIZE_PRODUCT_DEPENDENT
            )
          )
        ) then_tac \
        ASM_SIMP_TAC(PairList [HAS_SIZE])
      )
    ]
  )

def HAS_SIZE_PRODUCT:
  prove(
    [
      (hol:
         const HAS_SIZE :: (A -> bool) -> num -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         forall (s :: A -> bool, m :: num, t :: B -> bool, n :: num):
           HAS_SIZE(s, m) && HAS_SIZE(t, n)
             ==> HAS_SIZE(
                   GSPEC(
                     fun (gen_pvar_131 :: pair(A, B)):
                       exists (x :: A, y :: B):
                         SETSPEC(gen_pvar_131, IN(x, s) && IN(y, t), #{|,|}(x, y))
                   ),
                   m * n
                 )),
      SIMP_TAC(PairList [HAS_SIZE, CARD_PRODUCT, FINITE_PRODUCT])
    ]
  )

Host.parse_as_infix(["CROSS", [22, "right"]])

def CROSS:
  new_definition(
    (hol:
       var CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
       var s :: A -> bool
       var t :: B -> bool
       const GSPEC :: (A -> bool) -> A -> bool
       const SETSPEC :: A -> bool -> A -> bool
       const IN :: A -> (A -> bool) -> bool
       const #{|,|} :: A -> B -> pair(A, B)
       CROSS(s, t)
         == GSPEC(
              fun (gen_pvar_132 :: pair(A, B)):
                exists (x :: A, y :: B): SETSPEC(gen_pvar_132, IN(x, s) && IN(y, t), #{|,|}(x, y))
            ))
  )

def IN_CROSS:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         forall (x :: A, y :: B, s :: A -> bool, t :: B -> bool):
           IN(#{|,|}(x, y), CROSS(s, t)) <=> IN(x, s) && IN(y, t)),
      REWRITE_TAC(PairList [CROSS, IN_ELIM_PAIR_THM])
    ]
  )

def HAS_SIZE_CROSS:
  prove(
    [
      (hol:
         const HAS_SIZE :: (A -> bool) -> num -> bool
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         forall (s :: A -> bool, t :: B -> bool, m :: num, n :: num):
           HAS_SIZE(s, m) && HAS_SIZE(t, n) ==> HAS_SIZE(CROSS(s, t), m * n)),
      REWRITE_TAC(PairList [CROSS, HAS_SIZE_PRODUCT])
    ]
  )

def FINITE_CROSS:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         forall (s :: A -> bool, t :: B -> bool): FINITE(s) && FINITE(t) ==> FINITE(CROSS(s, t))),
      SIMP_TAC(PairList [CROSS, FINITE_PRODUCT])
    ]
  )

def CARD_CROSS:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const CARD :: (A -> bool) -> num
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         forall (s :: A -> bool, t :: B -> bool):
           FINITE(s) && FINITE(t) ==> CARD(CROSS(s, t)) == CARD(s) * CARD(t)),
      SIMP_TAC(PairList [CROSS, CARD_PRODUCT])
    ]
  )

def CROSS_EQ_EMPTY:
  prove(
    [
      (hol:
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         const EMPTY :: A -> bool
         forall (s :: A -> bool, t :: B -> bool): CROSS(s, t) == EMPTY <=> s == EMPTY || t == EMPTY),
