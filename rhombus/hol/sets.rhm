                      ),
                      [
                        Ref("GEN%PVAR%143"),
                        Forall(
                          "i",
                          Tvar("K"),
                          App(
                            Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                            [
                              App(Ref("f"), [Ref("i")]),
                              App(
                                Const(
                                  "COND",
                                  Fun(Bool, Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool))))
