def FINITE_INDUCT_STRONG:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Fun(Tvar("A"), Bool), Bool),
        Implies(
          And(
            App(Ref("P"), [Const("EMPTY", Fun(Tvar("A"), Bool))]),
            Forall(
              "x",
              Tvar("A"),
              Forall(
                "s",
                Fun(Tvar("A"), Bool),
                Implies(
                  And(
                    App(Ref("P"), [Ref("s")]),
                    And(
                      Not(App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")])),
                      App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")])
                    )
                  ),
                  App(
                    Ref("P"),
                    [
                      App(
                        Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                        [Ref("x"), Ref("s")]
                      )
                    ]
                  )
                )
              )
            )
          ),
          Forall(
            "s",
            Fun(Tvar("A"), Bool),
            Implies(
              App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
              App(Ref("P"), [Ref("s")])
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (GEN_TAC then_tac STRIP_TAC) then_tac \
                      SUBGOAL_THEN(
                        hol_term(Forall(
                          "s",
                          Fun(Tvar("A"), Bool),
                          Implies(
                            App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                            And(
                              App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                              App(Var("P", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")])
                            )
                          )
                        ))
                      )(MP_TAC)
                    ) then_list \
                    PairList [ALL_TAC, MESON_TAC(PairList [])]
                  ) then_tac \
                  MATCH_MP_TAC(sets_FINITE_INDUCT_v2)
                ) then_tac \
                ASM_SIMP_TAC(PairList [sets_FINITE_RULES_v2])
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          ASM_CASES_TAC(
            hol_term(App(
              Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
              [Var("x", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
            ))
          )
        ) then_list \
        PairList [
          (
            (
              SUBGOAL_THEN(
                hol_term(Eq(
                  Fun(Tvar("A"), Bool),
                  App(
                    Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                    [Var("x", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
                  ),
                  Var("s", Fun(Tvar("A"), Bool))
                ))
              )((fun(th): ASM_REWRITE_TAC(PairList [th]))) then_tac \
              UNDISCH_TAC(
                hol_term(App(
                  Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                  [Var("x", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
                ))
              )
            ) then_tac \
            SET_TAC(PairList [])
          ),
          (FIRST_ASSUM(MATCH_MP_TAC) then_tac ASM_REWRITE_TAC(PairList []))
        ]
      )
    ]
  )

