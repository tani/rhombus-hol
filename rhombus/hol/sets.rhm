def [sets_CROSS_UNIONS_UNIONS_v2, CROSS_UNIONS]:
  o(CONJ_PAIR)(prove)(
    [
      (hol:
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         const UNIONS :: ((A -> bool) -> bool) -> A -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         (forall (f :: (A -> bool) -> bool, g :: (B -> bool) -> bool):
            CROSS(UNIONS(f), UNIONS(g))
              == UNIONS(
                   GSPEC(
                     fun (gen_pvar_133 :: pair(A, B) -> bool):
                       exists (s :: A -> bool, t :: B -> bool):
                         SETSPEC(gen_pvar_133, IN(s, f) && IN(t, g), CROSS(s, t))
                   )
                 ))
           && ((forall (s :: A -> bool, f :: (A -> bool) -> bool):
                  CROSS(s, UNIONS(f))
                    == UNIONS(
                         GSPEC(
                           fun (gen_pvar_134 :: pair(A, A) -> bool):
                             exists t :: A -> bool: SETSPEC(gen_pvar_134, IN(t, f), CROSS(s, t))
                         )
                       ))
                 && (forall (f :: (A -> bool) -> bool, t :: B -> bool):
                       CROSS(UNIONS(f), t)
                         == UNIONS(
                              GSPEC(
                                fun (gen_pvar_135 :: pair(A, B) -> bool):
                                  exists s :: A -> bool: SETSPEC(gen_pvar_135, IN(s, f), CROSS(s, t))
                              )
                            )))),
      (
        REWRITE_TAC(PairList [UNIONS_GSPEC, EXTENSION, FORALL_PAIR_THM, IN_ELIM_THM, IN_CROSS]) then_tac \
        SET_TAC(PairList [])
      )
    ]
  )

def [sets_CROSS_INTERS_INTERS_v2, CROSS_INTERS]:
  o(CONJ_PAIR)(prove)(
    [
      (hol:
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         const INTERS :: ((A -> bool) -> bool) -> A -> bool
         const EMPTY :: A -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         const UNIV :: A -> bool
         (forall (f :: (A -> bool) -> bool, g :: (B -> bool) -> bool):
            CROSS(INTERS(f), INTERS(g))
              == (if f == EMPTY
                  | INTERS(
                      GSPEC(
                        fun (gen_pvar_136 :: pair(A, B) -> bool):
                          exists t :: B -> bool: SETSPEC(gen_pvar_136, IN(t, g), CROSS(UNIV, t))
                      )
                    )
                  | if g == EMPTY
                    | INTERS(
                        GSPEC(
                          fun (gen_pvar_137 :: pair(A, B) -> bool):
                            exists s :: A -> bool: SETSPEC(gen_pvar_137, IN(s, f), CROSS(s, UNIV))
                        )
                      )
                    | INTERS(
                        GSPEC(
                          fun (gen_pvar_138 :: pair(A, B) -> bool):
                            exists (s :: A -> bool, t :: B -> bool):
                              SETSPEC(gen_pvar_138, IN(s, f) && IN(t, g), CROSS(s, t))
                        )
                      )))
           && ((forall (s :: A -> bool, f :: (A -> bool) -> bool):
                  CROSS(s, INTERS(f))
                    == (if f == EMPTY
                        | CROSS(s, UNIV)
                        | INTERS(
                            GSPEC(
                              fun (gen_pvar_139 :: pair(A, A) -> bool):
                                exists t :: A -> bool:
                                  SETSPEC(gen_pvar_139, IN(t, f), CROSS(s, t))
                            )
                          )))
                 && (forall (f :: (A -> bool) -> bool, t :: B -> bool):
                       CROSS(INTERS(f), t)
                         == (if f == EMPTY
                             | CROSS(UNIV, t)
                             | INTERS(
                                 GSPEC(
                                   fun (gen_pvar_140 :: pair(A, B) -> bool):
                                     exists s :: A -> bool: SETSPEC(gen_pvar_140, IN(s, f), CROSS(s, t))
                                 )
                               ))))),
      (
        (
          (
            REPEAT(STRIP_TAC) then_tac \
            REPEAT((COND_CASES_TAC then_tac REWRITE_TAC(PairList [])))
          ) then_tac \
          ASM_REWRITE_TAC(
            PairList [INTERS_GSPEC, EXTENSION, FORALL_PAIR_THM, IN_ELIM_THM, IN_CROSS, NOT_IN_EMPTY]
          )
        ) then_tac \
        ASM(SET_TAC)(PairList [])
      )
    ]
  )

def DISJOINT_CROSS:
  prove(
