                            App(
                              Const("SETSPEC", Fun(Tvar("A"), Fun(Bool, Fun(Tvar("A"), Bool)))),
                              [Ref("GEN%PVAR%229"), App(Ref("<<"), [Ref("y"), Ref("x")]), Ref("y")]
                            )
                          )
                        )
                      ]
                    )
                  ]
                )
              )
            )
          ),
          App(Const("WF", Fun(Fun(Tvar("A"), Fun(Tvar("A"), Bool)), Bool)), [Ref("<<")])
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
