def CARD_FUNSPACE:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("B"), Bool),
          Implies(
            And(
              App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
              App(Const("FINITE", Fun(Fun(Tvar("B"), Bool), Bool)), [Ref("t")])
            ),
            Eq(
              Num,
              App(
                Const("CARD", Fun(Fun(Fun(Tvar("A"), Tvar("B")), Bool), Num)),
                [
                  App(
                    Const("GSPEC", Fun(Fun(Fun(Tvar("A"), Tvar("B")), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Bool))),
                    [
                      Lambda(
                        "GEN%PVAR%151",
                        Fun(Tvar("A"), Tvar("B")),
                        Exists(
                          "f",
                          Fun(Tvar("A"), Tvar("B")),
                          App(
                            Const(
                              "SETSPEC",
                              Fun(Fun(Tvar("A"), Tvar("B")), Fun(Bool, Fun(Fun(Tvar("A"), Tvar("B")), Bool)))
                            ),
                            [
                              Ref("GEN%PVAR%151"),
                              And(
                                Forall(
                                  "x",
                                  Tvar("A"),
                                  Implies(
                                    App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                                    App(
                                      Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))),
                                      [App(Ref("f"), [Ref("x")]), Ref("t")]
                                    )
                                  )
                                ),
                                Forall(
                                  "x",
                                  Tvar("A"),
                                  Implies(
                                    Not(App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")])),
                                    Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), Var("d", Tvar("B")))
                                  )
                                )
                              ),
                              Ref("f")
                            ]
                          )
                        )
                      )
                    ]
                  )
                ]
              ),
              App(
                Const("EXP", Fun(Num, Fun(Num, Num))),
                [
                  App(Const("CARD", Fun(Fun(Tvar("B"), Bool), Num)), [Ref("t")]),
                  App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")])
                ]
              )
            )
          )
        )
      )),
      MESON_TAC(PairList [HAS_SIZE_FUNSPACE, HAS_SIZE])
    ]
  )

