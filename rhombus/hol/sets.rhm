def DISJOINT_CROSS:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("B"), Bool),
          Forall(
            "s'",
            Fun(Tvar("A"), Bool),
            Forall(
              "t'",
              Fun(Tvar("B"), Bool),
              Iff(
                App(
                  Const(
                    "DISJOINT",
                    Fun(
                      Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Bool),
                      Fun(Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Bool), Bool)
                    )
                  ),
                  [
                    App(
                      Const(
                        "CROSS",
                        Fun(
                          Fun(Tvar("A"), Bool),
                          Fun(Fun(Tvar("B"), Bool), Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Bool))
                        )
                      ),
                      [Ref("s"), Ref("t")]
                    ),
                    App(
                      Const(
                        "CROSS",
                        Fun(
                          Fun(Tvar("A"), Bool),
                          Fun(Fun(Tvar("B"), Bool), Fun(Tyapp("prod", [Tvar("A"), Tvar("B")]), Bool))
                        )
                      ),
                      [Ref("s'"), Ref("t'")]
                    )
                  ]
                ),
                Or(
                  App(
                    Const("DISJOINT", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Bool))),
                    [Ref("s"), Ref("s'")]
                  ),
                  App(
                    Const("DISJOINT", Fun(Fun(Tvar("B"), Bool), Fun(Fun(Tvar("B"), Bool), Bool))),
                    [Ref("t"), Ref("t'")]
                  )
                )
              )
            )
          )
        )
      )),
      REWRITE_TAC(PairList [DISJOINT, INTER_CROSS, CROSS_EQ_EMPTY])
    ]
  )

def ARB:
  new_definition(
    hol_term(Eq(
      Tvar("A"),
      Var("ARB", Tvar("A")),
      App(Const("@", Fun(Fun(Tvar("A"), Bool), Tvar("A"))), [Lambda("x", Tvar("A"), False)])
    ))
  )

def EXTENSIONAL:
  new_definition(
    hol_term(Eq(
      Fun(Fun(Tvar("A"), Tvar("B")), Bool),
      App(
        Var("EXTENSIONAL", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Bool))),
        [Var("s", Fun(Tvar("A"), Bool))]
      ),
      App(
        Const("GSPEC", Fun(Fun(Fun(Tvar("A"), Tvar("B")), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Bool))),
        [
          Lambda(
            "GEN%PVAR%141",
            Fun(Tvar("A"), Tvar("B")),
            Exists(
              "f",
              Fun(Tvar("A"), Tvar("B")),
              App(
                Const(
                  "SETSPEC",
                  Fun(Fun(Tvar("A"), Tvar("B")), Fun(Bool, Fun(Fun(Tvar("A"), Tvar("B")), Bool)))
                ),
                [
                  Ref("GEN%PVAR%141"),
                  Forall(
                    "x",
                    Tvar("A"),
                    Implies(
                      Not(
                        App(
                          Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                          [Ref("x"), Var("s", Fun(Tvar("A"), Bool))]
                        )
                      ),
                      Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), Const("ARB", Tvar("B")))
                    )
                  ),
                  Ref("f")
                ]
              )
            )
          )
        ]
      )
    ))
  )

def IN_EXTENSIONAL:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "f",
          Fun(Tvar("A"), Tvar("B")),
          Iff(
            App(
              Const("IN", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Fun(Tvar("A"), Tvar("B")), Bool), Bool))),
              [
                Ref("f"),
                App(
                  Const("EXTENSIONAL", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Bool))),
                  [Ref("s")]
                )
              ]
            ),
            Forall(
              "x",
              Tvar("A"),
              Implies(
                Not(App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")])),
                Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), Const("ARB", Tvar("B")))
              )
            )
          )
        )
      )),
      REWRITE_TAC(PairList [EXTENSIONAL, IN_ELIM_THM])
    ]
  )

def IN_EXTENSIONAL_UNDEFINED:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "f",
          Fun(Tvar("A"), Tvar("B")),
          Forall(
            "x",
            Tvar("A"),
            Implies(
              And(
                App(
                  Const("IN", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Fun(Tvar("A"), Tvar("B")), Bool), Bool))),
                  [
                    Ref("f"),
                    App(
                      Const("EXTENSIONAL", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Bool))),
                      [Ref("s")]
                    )
                  ]
                ),
                Not(App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]))
              ),
              Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), Const("ARB", Tvar("B")))
            )
          )
        )
      )),
      SIMP_TAC(PairList [IN_EXTENSIONAL])
    ]
  )

def EXTENSIONAL_EMPTY:
  prove(
    [
      hol_term(Eq(
        Fun(Fun(Tvar("A"), Tvar("B")), Bool),
        App(
          Const("EXTENSIONAL", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Tvar("B")), Bool))),
