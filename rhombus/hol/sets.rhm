        ) then_tac \
        ASM_MESON_TAC(PairList [SUBSET, IN_IMAGE])
      )
    ]
  )

def FORALL_IN_CLAUSES:
  prove(
    [
      hol_term(And(
        Forall(
          "P",
          Fun(Tvar("A"), Bool),
          Iff(
            Forall(
              "x",
              Tvar("A"),
              Implies(
                App(
                  Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                  [Ref("x"), Const("EMPTY", Fun(Tvar("A"), Bool))]
                ),
                App(Ref("P"), [Ref("x")])
              )
            ),
            True
          )
        ),
        Forall(
          "P",
          Fun(Tvar("A"), Bool),
          Forall(
            "a",
            Tvar("A"),
            Forall(
              "s",
              Fun(Tvar("A"), Bool),
              Iff(
                Forall(
                  "x",
                  Tvar("A"),
                  Implies(
                    App(
                      Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                      [
                        Ref("x"),
                        App(
                          Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                          [Ref("a"), Ref("s")]
                        )
                      ]
                    ),
                    App(Ref("P"), [Ref("x")])
                  )
                ),
                And(
                  App(Ref("P"), [Ref("a")]),
                  Forall(
                    "x",
                    Tvar("A"),
                    Implies(
                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                      App(Ref("P"), [Ref("x")])
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY]) then_tac MESON_TAC(PairList []))
    ]
  )

