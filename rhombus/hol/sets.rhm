def IN:
  new_definition(
    (hol:
       var IN :: A -> (A -> bool) -> bool
       forall (P :: A -> bool, x :: A): IN(x, P) <=> P(x))
  )

def EXTENSION:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         forall (s :: A -> bool, t :: A -> bool): s == t <=> (forall x :: A: IN(x, s) <=> IN(x, t))),
      REWRITE_TAC(PairList [IN, FUN_EQ_THM])
    ]
  )

def GSPEC:
  new_definition(
    (hol:
       var GSPEC :: (A -> bool) -> A -> bool
       var p :: A -> bool
       GSPEC(p) == p)
  )

def SETSPEC:
  new_definition(
    (hol:
       var SETSPEC :: A -> bool -> A -> bool
       var v :: A
       var P :: bool
       var t :: A
       SETSPEC(v, P, t) <=> P && v == t)
  )

def IN_ELIM_THM:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         (forall (P :: (bool -> A -> bool) -> bool, x :: A):
            IN(x, GSPEC(fun (v :: A): P(SETSPEC(v)))) <=> P(fun (p :: bool, t :: A): p && x == t))
           && ((forall (p :: A -> bool, x :: A):
                  IN(x, GSPEC(fun (v :: A): exists y :: A: SETSPEC(v, p(y), y))) <=> p(x))
                 && ((forall (P :: (bool -> A -> bool) -> bool, x :: A):
                        GSPEC(fun (v :: A): P(SETSPEC(v)), x)
                          <=> P(fun (p :: bool, t :: A): p && x == t))
                       && ((forall (p :: A -> bool, x :: A):
                              GSPEC(fun (v :: A): exists y :: A: SETSPEC(v, p(y), y), x) <=> p(x))
                             && (forall (p :: A -> bool, x :: A): IN(x, fun (y :: A): p(y)) <=> p(x)))))),
      (
        (
          (
            (REPEAT(STRIP_TAC) then_tac REWRITE_TAC(PairList [IN, GSPEC])) then_tac \
            TRY((AP_TERM_TAC then_tac REWRITE_TAC(PairList [FUN_EQ_THM])))
          ) then_tac \
          REWRITE_TAC(PairList [SETSPEC])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def EMPTY:
  new_definition(
    (hol:
       var EMPTY :: A -> bool
       EMPTY == (fun (x :: A): #false))
  )

def INSERT_DEF:
  new_definition(
    (hol:
       var INSERT :: A -> (A -> bool) -> A -> bool
       var x :: A
       var s :: A -> bool
       const IN :: A -> (A -> bool) -> bool
       INSERT(x, s) == (fun (y :: A): IN(y, s) || y == x))
  )

def UNIV:
  new_definition(
    (hol:
       var UNIV :: A -> bool
       UNIV == (fun (x :: A): #true))
  )

def UNION:
  new_definition(
    (hol:
       var UNION :: (A -> bool) -> (A -> bool) -> A -> bool
       var s :: A -> bool
       var t :: A -> bool
       const GSPEC :: (A -> bool) -> A -> bool
       const SETSPEC :: A -> bool -> A -> bool
       const IN :: A -> (A -> bool) -> bool
       UNION(s, t)
         == GSPEC(
              fun (gen_pvar_0 :: A):
                exists x :: A: SETSPEC(gen_pvar_0, IN(x, s) || IN(x, t), x)
            ))
  )

def UNIONS:
  new_definition(
    (hol:
       var UNIONS :: ((A -> bool) -> bool) -> A -> bool
       var s :: (A -> bool) -> bool
       const GSPEC :: (A -> bool) -> A -> bool
       const SETSPEC :: A -> bool -> A -> bool
       const IN :: A -> (A -> bool) -> bool
       UNIONS(s)
         == GSPEC(
              fun (gen_pvar_1 :: A):
                exists x :: A: SETSPEC(gen_pvar_1, exists u :: A -> bool: IN(u, s) && IN(x, u), x)
            ))
  )

def INTER:
  new_definition(
    (hol:
       var INTER :: (A -> bool) -> (A -> bool) -> A -> bool
       var s :: A -> bool
       var t :: A -> bool
       const GSPEC :: (A -> bool) -> A -> bool
       const SETSPEC :: A -> bool -> A -> bool
       const IN :: A -> (A -> bool) -> bool
       INTER(s, t)
         == GSPEC(
              fun (gen_pvar_2 :: A):
                exists x :: A: SETSPEC(gen_pvar_2, IN(x, s) && IN(x, t), x)
            ))
  )

def INTERS:
  new_definition(
    (hol:
       var INTERS :: ((A -> bool) -> bool) -> A -> bool
       var s :: (A -> bool) -> bool
       const GSPEC :: (A -> bool) -> A -> bool
       const SETSPEC :: A -> bool -> A -> bool
       const IN :: A -> (A -> bool) -> bool
       INTERS(s)
         == GSPEC(
              fun (gen_pvar_3 :: A):
                exists x :: A: SETSPEC(gen_pvar_3, forall u :: A -> bool: IN(u, s) ==> IN(x, u), x)
            ))
  )

def DIFF:
  new_definition(
    (hol:
       var DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
       var s :: A -> bool
       var t :: A -> bool
       const GSPEC :: (A -> bool) -> A -> bool
       const SETSPEC :: A -> bool -> A -> bool
       const IN :: A -> (A -> bool) -> bool
       DIFF(s, t)
         == GSPEC(
              fun (gen_pvar_4 :: A):
                exists x :: A: SETSPEC(gen_pvar_4, IN(x, s) && !IN(x, t), x)
            ))
  )

def INSERT:
  prove(
    [
      (hol:
         var x :: A
         var s :: A -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         INSERT(x, s)
           == GSPEC(
                fun (gen_pvar_5 :: A):
                  exists y :: A: SETSPEC(gen_pvar_5, IN(y, s) || y == x, y)
              )),
      REWRITE_TAC(PairList [EXTENSION, INSERT_DEF, IN_ELIM_THM])
    ]
  )

def DELETE:
  new_definition(
    (hol:
       var DELETE :: (A -> bool) -> A -> A -> bool
       var s :: A -> bool
       var x :: A
       const GSPEC :: (A -> bool) -> A -> bool
       const SETSPEC :: A -> bool -> A -> bool
       const IN :: A -> (A -> bool) -> bool
       DELETE(s, x)
         == GSPEC(
              fun (gen_pvar_6 :: A):
                exists y :: A: SETSPEC(gen_pvar_6, IN(y, s) && y != x, y)
            ))
  )

def SUBSET:
  new_definition(
    (hol:
       var SUBSET :: (A -> bool) -> (A -> bool) -> bool
       var s :: A -> bool
       var t :: A -> bool
       const IN :: A -> (A -> bool) -> bool
       SUBSET(s, t) <=> (forall x :: A: IN(x, s) ==> IN(x, t)))
  )

def PSUBSET:
  new_definition(
    (hol:
       var PSUBSET :: (A -> bool) -> (A -> bool) -> bool
       var s :: A -> bool
       var t :: A -> bool
       const SUBSET :: (A -> bool) -> (A -> bool) -> bool
       PSUBSET(s, t) <=> SUBSET(s, t) && s != t)
  )

def DISJOINT:
  new_definition(
    (hol:
       var DISJOINT :: (A -> bool) -> (A -> bool) -> bool
       var s :: A -> bool
       var t :: A -> bool
       const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
       const EMPTY :: A -> bool
       DISJOINT(s, t) <=> INTER(s, t) == EMPTY)
  )

def SING:
  new_definition(
    (hol:
       var SING :: (A -> bool) -> bool
       var s :: A -> bool
       const INSERT :: A -> (A -> bool) -> A -> bool
       const EMPTY :: A -> bool
       SING(s) <=> (exists x :: A: s == INSERT(x, EMPTY)))
  )

def [sets_FINITE_RULES_v2, sets_FINITE_INDUCT_v2, FINITE_CASES]:
  new_inductive_definition(
    (hol:
       var FINITE :: (A -> bool) -> bool
       const EMPTY :: A -> bool
       const INSERT :: A -> (A -> bool) -> A -> bool
       FINITE(EMPTY) && (forall (x :: A, s :: A -> bool): FINITE(s) ==> FINITE(INSERT(x, s))))
  )

def INFINITE:
  new_definition(
    (hol:
       var INFINITE :: (A -> bool) -> bool
       var s :: A -> bool
       const FINITE :: (A -> bool) -> bool
       INFINITE(s) <=> !FINITE(s))
  )

def IMAGE:
  new_definition(
    (hol:
       var IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
       var f :: A -> B
       var s :: A -> bool
       const GSPEC :: (A -> bool) -> A -> bool
       const SETSPEC :: A -> bool -> A -> bool
       const IN :: A -> (A -> bool) -> bool
       IMAGE(f, s)
         == GSPEC(
              fun (gen_pvar_7 :: B):
                exists y :: B: SETSPEC(gen_pvar_7, exists x :: A: IN(x, s) && y == f(x), y)
            ))
  )

def INJ:
  new_definition(
    (hol:
       var INJ :: (A -> B) -> (A -> bool) -> (B -> bool) -> bool
       var f :: A -> B
       var s :: A -> bool
       var t :: B -> bool
       const IN :: A -> (A -> bool) -> bool
       INJ(f, s, t)
         <=> ((forall x :: A: IN(x, s) ==> IN(f(x), t))
                && (forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> x == y)))
  )

def SURJ:
  new_definition(
    (hol:
       var SURJ :: (A -> B) -> (A -> bool) -> (B -> bool) -> bool
       var f :: A -> B
       var s :: A -> bool
       var t :: B -> bool
       const IN :: A -> (A -> bool) -> bool
       SURJ(f, s, t)
         <=> ((forall x :: A: IN(x, s) ==> IN(f(x), t))
                && (forall x :: B: IN(x, t) ==> (exists y :: A: IN(y, s) && f(y) == x))))
  )

def BIJ:
  new_definition(
    (hol:
       var BIJ :: (A -> B) -> (A -> bool) -> (B -> bool) -> bool
       var f :: A -> B
       var s :: A -> bool
       var t :: B -> bool
       const INJ :: (A -> B) -> (A -> bool) -> (B -> bool) -> bool
       const SURJ :: (A -> B) -> (A -> bool) -> (B -> bool) -> bool
       BIJ(f, s, t) <=> INJ(f, s, t) && SURJ(f, s, t))
  )

def CHOICE:
  new_definition(
    (hol:
       var CHOICE :: (A -> bool) -> A
       var s :: A -> bool
       const #{@} :: (A -> bool) -> A
       const IN :: A -> (A -> bool) -> bool
       CHOICE(s) == #{@}(fun (x :: A): IN(x, s)))
  )

def REST:
  new_definition(
    (hol:
       var REST :: (A -> bool) -> A -> bool
       var s :: A -> bool
       const DELETE :: (A -> bool) -> A -> A -> bool
       const CHOICE :: (A -> bool) -> A
       REST(s) == DELETE(s, CHOICE(s)))
  )

def NOT_IN_EMPTY:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const EMPTY :: A -> bool
         forall x :: A: !IN(x, EMPTY)),
      REWRITE_TAC(PairList [IN, EMPTY])
    ]
  )

def IN_UNIV:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const UNIV :: A -> bool
         forall x :: A: IN(x, UNIV)),
      REWRITE_TAC(PairList [UNIV, IN])
    ]
  )

def IN_UNION:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         forall (s :: A -> bool, t :: A -> bool, x :: A): IN(x, UNION(s, t)) <=> IN(x, s) || IN(x, t)),
      REWRITE_TAC(PairList [IN_ELIM_THM, UNION])
    ]
  )

def IN_UNIONS:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const UNIONS :: ((A -> bool) -> bool) -> A -> bool
         forall (s :: (A -> bool) -> bool, x :: A):
           IN(x, UNIONS(s)) <=> (exists t :: A -> bool: IN(t, s) && IN(x, t))),
      REWRITE_TAC(PairList [IN_ELIM_THM, UNIONS])
    ]
  )

def IN_INTER:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const INTER :: (A -> bool) -> (A -> bool) -> A -> bool
         forall (s :: A -> bool, t :: A -> bool, x :: A): IN(x, INTER(s, t)) <=> IN(x, s) && IN(x, t)),
      REWRITE_TAC(PairList [IN_ELIM_THM, INTER])
    ]
  )

def IN_INTERS:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const INTERS :: ((A -> bool) -> bool) -> A -> bool
         forall (s :: (A -> bool) -> bool, x :: A):
           IN(x, INTERS(s)) <=> (forall t :: A -> bool: IN(t, s) ==> IN(x, t))),
      REWRITE_TAC(PairList [IN_ELIM_THM, INTERS])
    ]
  )

def IN_DIFF:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
         forall (s :: A -> bool, t :: A -> bool, x :: A): IN(x, DIFF(s, t)) <=> IN(x, s) && !IN(x, t)),
      REWRITE_TAC(PairList [IN_ELIM_THM, DIFF])
    ]
  )

def IN_INSERT:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         forall (x :: A, y :: A, s :: A -> bool): IN(x, INSERT(y, s)) <=> x == y || IN(x, s)),
      (
        ONCE_REWRITE_TAC(PairList [DISJ_SYM]) then_tac \
        REWRITE_TAC(PairList [IN_ELIM_THM, INSERT])
      )
    ]
  )

def IN_DELETE:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const DELETE :: (A -> bool) -> A -> A -> bool
         forall (s :: A -> bool, x :: A, y :: A): IN(x, DELETE(s, y)) <=> IN(x, s) && x != y),
      REWRITE_TAC(PairList [IN_ELIM_THM, DELETE])
    ]
  )

def IN_SING:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         const EMPTY :: A -> bool
         forall (x :: A, y :: A): IN(x, INSERT(y, EMPTY)) <=> x == y),
      REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY])
    ]
  )

def IN_IMAGE:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         forall (y :: B, s :: A -> bool, f :: A -> B):
           IN(y, IMAGE(f, s)) <=> (exists x :: A: y == f(x) && IN(x, s))),
      (
        ONCE_REWRITE_TAC(PairList [CONJ_SYM]) then_tac \
        REWRITE_TAC(PairList [IN_ELIM_THM, IMAGE])
      )
    ]
  )

def IN_REST:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const REST :: (A -> bool) -> A -> bool
         const CHOICE :: (A -> bool) -> A
         forall (x :: A, s :: A -> bool): IN(x, REST(s)) <=> IN(x, s) && x != CHOICE(s)),
      REWRITE_TAC(PairList [REST, IN_DELETE])
    ]
  )

def FORALL_IN_INSERT:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         forall (P :: A -> bool, a :: A, s :: A -> bool):
           (forall x :: A: IN(x, INSERT(a, s)) ==> P(x)) <=> P(a) && (forall x :: A: IN(x, s) ==> P(x))),
      (REWRITE_TAC(PairList [IN_INSERT]) then_tac MESON_TAC(PairList []))
    ]
  )

def EXISTS_IN_INSERT:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const INSERT :: A -> (A -> bool) -> A -> bool
         forall (P :: A -> bool, a :: A, s :: A -> bool):
           (exists x :: A: IN(x, INSERT(a, s)) && P(x)) <=> P(a) || (exists x :: A: IN(x, s) && P(x))),
      (REWRITE_TAC(PairList [IN_INSERT]) then_tac MESON_TAC(PairList []))
    ]
  )

def FORALL_IN_UNION:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         forall (P :: A -> bool, s :: A -> bool, t :: A -> bool):
           (forall x :: A: IN(x, UNION(s, t)) ==> P(x))
             <=> (forall x :: A: IN(x, s) ==> P(x)) && (forall x :: A: IN(x, t) ==> P(x))),
      (REWRITE_TAC(PairList [IN_UNION]) then_tac MESON_TAC(PairList []))
    ]
  )

def EXISTS_IN_UNION:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         forall (P :: A -> bool, s :: A -> bool, t :: A -> bool):
           (exists x :: A: IN(x, UNION(s, t)) && P(x))
             <=> (exists x :: A: IN(x, s) && P(x)) || (exists x :: A: IN(x, t) && P(x))),
      (REWRITE_TAC(PairList [IN_UNION]) then_tac MESON_TAC(PairList []))
    ]
  )

def FORALL_IN_IMAGE:
