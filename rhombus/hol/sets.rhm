           FINITE(s) && FINITE(t)
             ==> (CARD(
                    GSPEC(
                      fun (gen_pvar_151 :: A -> B):
                        exists f :: A -> B:
                          SETSPEC(
                            gen_pvar_151,
                            (forall x :: A: IN(x, s) ==> IN(f(x), t))
                              && (forall x :: A: !IN(x, s) ==> f(x) == d),
