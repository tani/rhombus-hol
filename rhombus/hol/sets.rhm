                "y",
                Tvar("A"),
                Forall(
                  "s",
                  Tvar("B"),
                  Implies(
                    Not(Eq(Tvar("A"), Ref("x"), Ref("y"))),
                    Eq(
                      Tvar("B"),
                      App(Ref("f"), [Ref("x"), App(Ref("f"), [Ref("y"), Ref("s")])]),
                      App(Ref("f"), [Ref("y"), App(Ref("f"), [Ref("x"), Ref("s")])])
                    )
                  )
                )
              )
            ),
            Forall(
              "n1",
              Num,
              Forall(
                "n2",
                Num,
                Forall(
                  "s",
                  Fun(Tvar("A"), Bool),
                  Forall(
                    "a1",
                    Tvar("B"),
                    Forall(
                      "a2",
                      Tvar("B"),
                      Implies(
                        And(
                          App(
                            Const(
                              "FINREC",
                              Fun(
                                Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
                                Fun(Tvar("B"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Fun(Num, Bool))))
                              )
                            ),
                            [Ref("f"), Ref("b"), Ref("s"), Ref("a1"), Ref("n1")]
                          ),
                          App(
                            Const(
                              "FINREC",
                              Fun(
                                Fun(Tvar("A"), Fun(Tvar("B"), Tvar("B"))),
                                Fun(Tvar("B"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Fun(Num, Bool))))
                              )
                            ),
                            [Ref("f"), Ref("b"), Ref("s"), Ref("a2"), Ref("n2")]
                          )
                        ),
                        And(Eq(Tvar("B"), Ref("a1"), Ref("a2")), Eq(Num, Ref("n1"), Ref("n2")))
                      )
                    )
