                Or(
                  App(Ref("P"), [Ref("a")]),
                  Exists(
                    "x",
                    Tvar("A"),
                    And(
                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                      App(Ref("P"), [Ref("x")])
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (REWRITE_TAC(PairList [IN_INSERT, NOT_IN_EMPTY]) then_tac MESON_TAC(PairList []))
    ]
  )

def INJECTIVE_ON_IMAGE:
