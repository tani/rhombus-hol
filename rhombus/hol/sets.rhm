                              HYP_TAC("m: t m1 m2")(REWRITE_RULE(PairList [HAS_SUP]))
                            ) then_tac \
                            REFUTE_THEN(o(LABEL_TAC("lt"))(REWRITE_RULE(PairList [REAL_NOT_LE])))
                          ) then_tac \
                          CLAIM_TAC(
                            "@c. c1 c2")(
                            (hol:
                               var l :: real
                               var m :: real
                               exists c :: real: l < c && c < m)
                          )
                        ) then_list \
                        PairList [
                          (
                            EXISTS_TAC(
                              (hol:
                                 var l :: real
                                 var m :: real
                                 (l + m) / (2 :: real))
                            ) then_tac \
                            ASM_REAL_ARITH_TAC
                          ),
                          ALL_TAC
                        ]
                      ) then_tac \
                      HYP_TAC("m2: +")(SPEC(hol: var c :: real; c))
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [NOT_EXISTS_THM])
                  ) then_tac \
                  INTRO_TAC("!x; x xc")
                ) then_tac \
                CLAIM_TAC(
                  "@y. y yx")(
                  (hol:
                     var s :: real -> bool
                     var x :: real
                     const IN :: A -> (A -> bool) -> bool
                     exists y :: real: IN(y, s) && x <= y)
                )
              ) then_list \
              PairList [HYP(MESON_TAC)("le x")(PairList []), ALL_TAC]
            ) then_tac \
            HYP_TAC("l1: +")(SPEC(hol: var y :: real; y))
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_tac \
        ASM_REAL_ARITH_TAC
      )
    ]
  )

def new_inductive_set:
  let const_of_var = (fun(v): mk_mconst([Host.name_of(v), type_of(v)]))
  // Recursive traversal needs the local definition before its first use.
  fun f(n):
    fun(tm):
      fun(arg):
        match arg
        | PairList []: tm
        | PairList [ty, & tys]:
              let v = variant(variables(tm))(mk_var([("x" +& to_string(n)), ty]))
              f((n + 1))(mk_comb([tm, v]))(tys)
  let comb_all:
    fun(tm):
      let tys = fst(splitlist(dest_fun_ty)(type_of(tm)))
      f(0)(tm)(tys)
  let mk_eqin = o(REWR_CONV(GSYM(IN)))(comb_all)
  let transf = (fun(conv): o(o(rhs)(concl))(conv))
  let remove_in_conv:
    fun(ptm):
      fun(tm):
        let rconv = REWR_CONV(SYM(mk_eqin(ptm)))
        let htm = fst(strip_comb(snd(dest_binary("IN")(tm))))
        (if (htm == ptm) | rconv(tm) | fail())
  let remove_in_transf = o(o(o(transf)(ONCE_DEPTH_CONV))(FIRST_CONV))(map(remove_in_conv))
  let rule_head:
    fun(tm):
      let tm = snd(strip_forall(tm))
      let tm = snd(splitlist(dest_binop(hol: const #{==>} :: bool -> bool -> bool; const.#{==>}))(tm))
      let tm = snd(dest_binary("IN")(tm))
      fst(strip_comb(tm))
  let find_pvars = o(o(setify)(map(rule_head)))(binops(hol: const #{|/\|} :: bool -> bool -> bool; #{|/\|}))
  fun(tm):
    let pvars = find_pvars(tm)
    let dtm = remove_in_transf(pvars)(tm)
    let [th_rules, th_induct, th_cases] = new_inductive_definition(dtm)
    let insert_in_rule = REWRITE_RULE(map(o(mk_eqin)(const_of_var))(pvars))
    [insert_in_rule(th_rules), insert_in_rule(th_induct), insert_in_rule(th_cases)]

def FINITE_RULES = sets_FINITE_RULES_v2

