def dest_setenum:
  let fn = splitlist(dest_binary("INSERT"))
  fun(tm):
    let [l, n] = fn(tm)
    (if (is_const(n) && (fst(dest_const(n)) == "EMPTY")) | l | failwith("dest_setenum: not a finite set enumeration"))

def is_setenum = can(dest_setenum)

def mk_setenum:
  let insert_atm_2 = hol_term(Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))))
  let nil_atm_2 = hol_term(Const("EMPTY", Fun(Tvar("A"), Bool)))
  fun([l, ty]):
    let insert_tm_2 = inst(PairList [[ty, aty]])(insert_atm_2)
    let nil_tm_2 = inst(PairList [[ty, aty]])(nil_atm_2)
    itlist(mk_binop(insert_tm_2))(l)(nil_tm_2)

fun mk_fset(l): mk_setenum([l, type_of(hd(l))])

def pairwise:
  new_definition(
    hol_term(Iff(
      App(
        Var("pairwise", Fun(Fun(Tvar("A"), Fun(Tvar("A"), Bool)), Fun(Fun(Tvar("A"), Bool), Bool))),
        [Var("r", Fun(Tvar("A"), Fun(Tvar("A"), Bool))), Var("s", Fun(Tvar("A"), Bool))]
      ),
      Forall(
        "x",
        Tvar("A"),
        Forall(
          "y",
          Tvar("A"),
          Implies(
            And(
              App(
                Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                [Ref("x"), Var("s", Fun(Tvar("A"), Bool))]
              ),
              And(
                App(
                  Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                  [Ref("y"), Var("s", Fun(Tvar("A"), Bool))]
                ),
                Not(Eq(Tvar("A"), Ref("x"), Ref("y")))
              )
            ),
            App(Var("r", Fun(Tvar("A"), Fun(Tvar("A"), Bool))), [Ref("x"), Ref("y")])
