                                  ) then_list \
                                  PairList [
                                    (MATCH_MP_TAC(TRANSITIVE_STEPWISE_LT) then_tac ASM_MESON_TAC(PairList [])),
                                    ALL_TAC
                                  ]
                                ) then_tac \
                                MP_TAC(ISPEC(hol_term(Var("s", Fun(Num, Tvar("A")))))(INFINITE_IMAGE_INJ))
                              ) then_tac \
                              ANTS_TAC
                            ) then_list \
                            PairList [ASM_MESON_TAC(PairList [LT_CASES]), ALL_TAC]
                          ) then_tac \
                          DISCH_THEN(o(MP_TAC)(SPEC(hol_term(Const("UNIV", Fun(Num, Bool))))))
                        ) then_tac \
                        REWRITE_TAC(PairList [num_INFINITE])
                      ) then_tac \
                      REWRITE_TAC(PairList [INFINITE])
                    ) then_tac \
                    MATCH_MP_TAC(FINITE_SUBSET)
                  ) then_tac \
                  EXISTS_TAC(
                    hol_term(App(
                      Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                      [
