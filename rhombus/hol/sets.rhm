                      Implies(
                        App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Ref("t")]),
                        App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("c"), Ref("x")])
                      )
                    )
                  )
                )
              )
            ),
            Eq(
              Real,
              App(
                Const("inf", Fun(Fun(Real, Bool), Real)),
                [
                  App(
                    Const("UNION", Fun(Fun(Real, Bool), Fun(Fun(Real, Bool), Fun(Real, Bool)))),
                    [Ref("s"), Ref("t")]
                  )
                ]
              ),
              App(
                Const("real_min", Fun(Real, Fun(Real, Real))),
                [
                  App(Const("inf", Fun(Fun(Real, Bool), Real)), [Ref("s")]),
                  App(Const("inf", Fun(Fun(Real, Bool), Real)), [Ref("t")])
