                  ) then_tac \
                  INTRO_TAC("!x; x xc")
                ) then_tac \
                CLAIM_TAC(
                  "@y. y yx")(
                  hol_term(Exists(
                    "y",
                    Real,
                    And(
                      App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("y"), Var("s", Fun(Real, Bool))]),
                      App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Var("x", Real), Ref("y")])
                    )
                  ))
