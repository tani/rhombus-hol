                Implies(
                  App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Var("s", Fun(Real, Bool))]),
                  App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("a")])
                )
              ),
              Forall(
                "b",
                Real,
                Implies(
                  Forall(
                    "x",
                    Real,
                    Implies(
                      App(Const("IN", Fun(Real, Fun(Fun(Real, Bool), Bool))), [Ref("x"), Var("s", Fun(Real, Bool))]),
                      App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("x"), Ref("b")])
                    )
                  ),
                  App(Const("real_le", Fun(Real, Fun(Real, Bool))), [Ref("a"), Ref("b")])
                )
              )
            )
          )
        ]
      )
    ))
  )

