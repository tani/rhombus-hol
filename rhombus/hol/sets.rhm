              (hol:
                 var g :: B -> A
                 var f :: A -> B
                 var s :: A -> bool
                 const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                 IMAGE(g, IMAGE(f, s)))
            ) then_tac \
            ASM(SET_TAC)(PairList [])
          )
        ]
      )
    ]
  )

