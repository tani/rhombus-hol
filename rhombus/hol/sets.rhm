def DISJOINT_UNION_EQ_EMPTY:
  prove(
    [
      hol_term(Forall(
        "k",
        Fun(Tvar("K"), Bool),
        Forall(
          "s",
          Fun(Tvar("K"), Fun(Tvar("A"), Bool)),
          Iff(
            Eq(
              Fun(Tyapp("prod", [Tvar("K"), Tvar("A")]), Bool),
              App(
                Const(
                  "disjoint_union",
                  Fun(
                    Fun(Tvar("K"), Bool),
                    Fun(Fun(Tvar("K"), Fun(Tvar("A"), Bool)), Fun(Tyapp("prod", [Tvar("K"), Tvar("A")]), Bool))
                  )
                ),
                [Ref("k"), Ref("s")]
              ),
              Const("EMPTY", Fun(Tyapp("prod", [Tvar("K"), Tvar("A")]), Bool))
            ),
            Forall(
              "i",
              Tvar("K"),
              Implies(
                App(Const("IN", Fun(Tvar("K"), Fun(Fun(Tvar("K"), Bool), Bool))), [Ref("i"), Ref("k")]),
                Eq(Fun(Tvar("A"), Bool), App(Ref("s"), [Ref("i")]), Const("EMPTY", Fun(Tvar("A"), Bool)))
              )
            )
          )
        )
      )),
      (
        REWRITE_TAC(PairList [EXTENSION, FORALL_PAIR_THM, disjoint_union, IN_ELIM_PAIR_THM, NOT_IN_EMPTY]) then_tac \
        SET_TAC(PairList [])
      )
    ]
  )

def DISJOINT_DISJOINT_UNION:
  prove(
    [
      hol_term(Forall(
        "k",
        Fun(Tvar("K"), Bool),
        Forall(
          "s",
          Fun(Tvar("K"), Fun(Tvar("A"), Bool)),
          Forall(
            "t",
            Fun(Tvar("K"), Fun(Tvar("A"), Bool)),
            Iff(
              App(
                Const(
                  "DISJOINT",
                  Fun(
                    Fun(Tyapp("prod", [Tvar("K"), Tvar("A")]), Bool),
                    Fun(Fun(Tyapp("prod", [Tvar("K"), Tvar("A")]), Bool), Bool)
                  )
                ),
                [
                  App(
                    Const(
                      "disjoint_union",
                      Fun(
                        Fun(Tvar("K"), Bool),
                        Fun(Fun(Tvar("K"), Fun(Tvar("A"), Bool)), Fun(Tyapp("prod", [Tvar("K"), Tvar("A")]), Bool))
                      )
                    ),
                    [Ref("k"), Ref("s")]
                  ),
                  App(
                    Const(
                      "disjoint_union",
                      Fun(
                        Fun(Tvar("K"), Bool),
                        Fun(Fun(Tvar("K"), Fun(Tvar("A"), Bool)), Fun(Tyapp("prod", [Tvar("K"), Tvar("A")]), Bool))
                      )
                    ),
                    [Ref("k"), Ref("t")]
                  )
                ]
              ),
              Forall(
                "i",
                Tvar("K"),
                Implies(
                  App(Const("IN", Fun(Tvar("K"), Fun(Fun(Tvar("K"), Bool), Bool))), [Ref("i"), Ref("k")]),
                  App(
                    Const("DISJOINT", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Bool))),
                    [App(Ref("s"), [Ref("i")]), App(Ref("t"), [Ref("i")])]
                  )
                )
              )
            )
          )
        )
      )),
      (
        REPEAT(GEN_TAC) then_tac \
        REWRITE_TAC(PairList [DISJOINT, INTER_DISJOINT_UNION, DISJOINT_UNION_EQ_EMPTY])
      )
    ]
  )

