                                   const SUBSET :: (A -> bool) -> (A -> bool) -> bool
                                   const INSERT :: A -> (A -> bool) -> A -> bool
                                   const EMPTY :: A -> bool
                                   P && IN(x, t) <=> SUBSET(INSERT(x, EMPTY), t) && P)
                              )
                            ]
                          )
                        ) then_tac \
                        MATCH_MP_TAC(CHOOSE_SUBSET_BETWEEN)
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [SING_SUBSET, FINITE_SING, CARD_SING])
                    ) then_tac \
                    ASM_SIMP_TAC(PairList [LE_1])
                  )
                ]
              )
            ]
          )
        ]
      )
    ]
  )

def FINITE_RESTRICTED_FUNSPACE:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         forall (s :: A -> bool, t :: B -> bool, k :: A -> B):
           FINITE(s) && FINITE(t)
             ==> FINITE(
                   GSPEC(
                     fun (gen_pvar_180 :: A -> B):
                       exists f :: A -> B:
                         SETSPEC(
                           gen_pvar_180,
                           SUBSET(IMAGE(f, s), t)
                             && SUBSET(
                                  GSPEC(
                                    fun (gen_pvar_179 :: A):
                                      exists x :: A: SETSPEC(gen_pvar_179, f(x) != k(x), x)
                                  ),
                                  s
                                ),
                           f
                         )
                   )
                 )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (REPEAT(STRIP_TAC) then_tac MATCH_MP_TAC(FINITE_SUBSET)) then_tac \
                                        EXISTS_TAC(
                                          (hol:
                                             var k :: A -> B
                                             var s :: A -> bool
                                             var t :: B -> bool
                                             const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                                             const IN :: A -> (A -> bool) -> bool
                                             const #{|,|} :: A -> B -> pair(A, B)
                                             const #{@} :: (A -> bool) -> A
                                             const GSPEC :: (A -> bool) -> A -> bool
                                             const SETSPEC :: A -> bool -> A -> bool
                                             const SUBSET :: (A -> bool) -> (A -> bool) -> bool
                                             const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
                                             IMAGE(
                                               fun (u :: pair(A, B) -> bool, x :: A):
                                                 if (exists y :: B: IN(#{|,|}(x, y), u)) | #{@}(fun (y :: B): IN(#{|,|}(x, y), u)) | k(x),
                                               GSPEC(
                                                 fun (gen_pvar_178 :: pair(A, B) -> bool):
                                                   exists u :: pair(A, B) -> bool: SETSPEC(gen_pvar_178, SUBSET(u, CROSS(s, t)), u)
                                               )
                                             ))
                                        )
                                      ) then_tac \
                                      ASM_SIMP_TAC(PairList [FINITE_POWERSET, FINITE_CROSS, FINITE_IMAGE])
                                    ) then_tac \
                                    GEN_REWRITE_TAC(I)(PairList [SUBSET])
                                  ) then_tac \
                                  REWRITE_TAC(PairList [FORALL_IN_GSPEC])
                                ) then_tac \
                                X_GEN_TAC(hol: var f :: A -> B; f)
                              ) then_tac \
                              STRIP_TAC
                            ) then_tac \
                            REWRITE_TAC(PairList [IN_IMAGE, IN_ELIM_THM])
                          ) then_tac \
                          EXISTS_TAC(
                            (hol:
                               var f :: A -> B
                               var k :: A -> B
                               const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
                               const #{|,|} :: A -> B -> pair(A, B)
                               const GSPEC :: (A -> bool) -> A -> bool
                               const SETSPEC :: A -> bool -> A -> bool
                               IMAGE(
                                 fun (x :: A): #{|,|}(x, f(x)),
                                 GSPEC(
                                   fun (gen_pvar_177 :: A):
                                     exists x :: A: SETSPEC(gen_pvar_177, f(x) != k(x), x)
                                 )
                               ))
                          )
                        ) then_tac \
                        ASM_SIMP_TAC(PairList [FINITE_IMAGE])
                      ) then_tac \
                      CONJ_TAC
                    ) then_list \
                    PairList [
                      ALL_TAC,
                      (
                        REWRITE_TAC(PairList [SUBSET, FORALL_IN_IMAGE, IN_ELIM_THM, IN_CROSS]) then_tac \
                        ASM(SET_TAC)(PairList [])
                      )
                    ]
                  ) then_tac \
                  REWRITE_TAC(PairList [FUN_EQ_THM])
                ) then_tac \
                X_GEN_TAC(hol: var x :: A; x)
              ) then_tac \
              REWRITE_TAC(PairList [IN_IMAGE, IN_ELIM_THM, PAIR_EQ])
            ) then_tac \
            REWRITE_TAC(PairList [GSYM(CONJ_ASSOC), UNWIND_THM1, UNWIND_THM2])
          ) then_tac \
          ASM_CASES_TAC(
            (hol:
               var f :: A -> B
               var x :: A
               var k :: A -> B
               f(x) == k(x))
          )
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def NUMSEG_CLAUSES_LT:
  prove(
    [
      (hol:
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const EMPTY :: A -> bool
         const SUC :: num -> num
         const INSERT :: A -> (A -> bool) -> A -> bool
         (GSPEC(
            fun (gen_pvar_181 :: num):
              exists i :: num: SETSPEC(gen_pvar_181, i < (0 :: num), i)
          )
            == EMPTY)
           && (forall k :: num:
                 GSPEC(
                   fun (gen_pvar_182 :: num):
                     exists i :: num: SETSPEC(gen_pvar_182, i < SUC(k), i)
                 )
                   == INSERT(
                        k,
                        GSPEC(
                          fun (gen_pvar_183 :: num):
                            exists i :: num: SETSPEC(gen_pvar_183, i < k, i)
                        )
                      ))),
      (REWRITE_TAC(PairList [LT]) then_tac SET_TAC(PairList []))
    ]
  )

