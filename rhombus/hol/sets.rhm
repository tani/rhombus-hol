def SURJECTIVE_IFF_INJECTIVE_GEN:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "t",
          Fun(Tvar("B"), Bool),
          Forall(
            "f",
            Fun(Tvar("A"), Tvar("B")),
            Implies(
              And(
                App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                And(
                  App(Const("FINITE", Fun(Fun(Tvar("B"), Bool), Bool)), [Ref("t")]),
                  And(
                    Eq(
                      Num,
                      App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")]),
                      App(Const("CARD", Fun(Fun(Tvar("B"), Bool), Num)), [Ref("t")])
                    ),
                    App(
                      Const("SUBSET", Fun(Fun(Tvar("B"), Bool), Fun(Fun(Tvar("B"), Bool), Bool))),
                      [
                        App(
                          Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                          [Ref("f"), Ref("s")]
                        ),
                        Ref("t")
                      ]
                    )
                  )
                )
              ),
              Iff(
                Forall(
                  "y",
                  Tvar("B"),
                  Implies(
                    App(Const("IN", Fun(Tvar("B"), Fun(Fun(Tvar("B"), Bool), Bool))), [Ref("y"), Ref("t")]),
                    Exists(
                      "x",
                      Tvar("A"),
                      And(
                        App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                        Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), Ref("y"))
                      )
                    )
                  )
                ),
                Forall(
                  "x",
                  Tvar("A"),
                  Forall(
                    "y",
                    Tvar("A"),
                    Implies(
                      And(
                        App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                        And(
                          App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("y"), Ref("s")]),
                          Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("f"), [Ref("y")]))
                        )
                      ),
                      Eq(Tvar("A"), Ref("x"), Ref("y"))
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (REPEAT(STRIP_TAC) then_tac EQ_TAC) then_tac \
          REPEAT(STRIP_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                ASM_CASES_TAC(hol_term(Eq(Tvar("A"), Var("x", Tvar("A")), Var("y", Tvar("A"))))) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              SUBGOAL_THEN(
                hol_term(App(
                  Const("<=", Fun(Num, Fun(Num, Bool))),
                  [
                    App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Var("s", Fun(Tvar("A"), Bool))]),
                    App(
                      Const("CARD", Fun(Fun(Tvar("B"), Bool), Num)),
                      [
                        App(
                          Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                          [
                            Var("f", Fun(Tvar("A"), Tvar("B"))),
                            App(
                              Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                              [Var("s", Fun(Tvar("A"), Bool)), Var("y", Tvar("A"))]
                            )
                          ]
                        )
                      ]
                    )
                  ]
                ))
              )(MP_TAC)
            ) then_list \
            PairList [
              (
                (
                  (
                    (ASM_REWRITE_TAC(PairList []) then_tac MATCH_MP_TAC(CARD_SUBSET)) then_tac \
                    ASM_SIMP_TAC(PairList [FINITE_IMAGE, FINITE_DELETE])
                  ) then_tac \
                  REWRITE_TAC(PairList [SUBSET, IN_IMAGE, IN_DELETE])
                ) then_tac \
                ASM_MESON_TAC(PairList [])
              ),
              (
                (
                  (
                    (
                      (REWRITE_TAC(PairList [NOT_LE]) then_tac MATCH_MP_TAC(LET_TRANS)) then_tac \
                      EXISTS_TAC(
                        hol_term(App(
                          Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)),
                          [
                            App(
                              Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                              [Var("s", Fun(Tvar("A"), Bool)), Var("y", Tvar("A"))]
                            )
                          ]
                        ))
                      )
                    ) then_tac \
                    ASM_SIMP_TAC(PairList [CARD_IMAGE_LE, FINITE_DELETE])
                  ) then_tac \
                  ASM_SIMP_TAC(
                    PairList [
                      CARD_DELETE,
                      ARITH_RULE(
                        hol_term(Iff(
                          App(
                            Const("<", Fun(Num, Fun(Num, Bool))),
                            [
                              App(
                                Const("-", Fun(Num, Fun(Num, Num))),
                                [
                                  Var("x", Num),
                                  App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                                ]
                              ),
                              Var("x", Num)
                            ]
                          ),
                          Not(Eq(Num, Var("x", Num), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])))
                        ))
                      )
                    ]
                  )
                ) then_tac \
                ASM_MESON_TAC(PairList [CARD_EQ_0, MEMBER_NOT_EMPTY])
              )
            ]
          ),
          (
            (
              SUBGOAL_THEN(
                hol_term(Eq(
                  Fun(Tvar("B"), Bool),
                  App(
                    Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                    [Var("f", Fun(Tvar("A"), Tvar("B"))), Var("s", Fun(Tvar("A"), Bool))]
                  ),
                  Var("t", Fun(Tvar("B"), Bool))
                ))
              )(MP_TAC) then_list \
              PairList [ALL_TAC, ASM_MESON_TAC(PairList [EXTENSION, IN_IMAGE])]
            ) then_tac \
            ASM_MESON_TAC(PairList [CARD_SUBSET_EQ, CARD_IMAGE_INJ])
          )
        ]
      )
    ]
  )

