def FORALL_IN_CROSS:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         forall (P :: pair(A, B) -> bool, s :: A -> bool, t :: B -> bool):
           (forall z :: pair(A, B): IN(z, CROSS(s, t)) ==> P(z))
             <=> (forall (x :: A, y :: B): IN(x, s) && IN(y, t) ==> P(#{|,|}(x, y)))),
      REWRITE_TAC(PairList [FORALL_PAIR_THM, IN_CROSS])
    ]
  )

def EXISTS_IN_CROSS:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         const #{|,|} :: A -> B -> pair(A, B)
         forall (P :: pair(A, B) -> bool, s :: A -> bool, t :: B -> bool):
           (exists z :: pair(A, B): IN(z, CROSS(s, t)) && P(z))
             <=> (exists (x :: A, y :: B): IN(x, s) && (IN(y, t) && P(#{|,|}(x, y))))),
      REWRITE_TAC(PairList [EXISTS_PAIR_THM, GSYM(CONJ_ASSOC), IN_CROSS])
    ]
  )

def SUBSET_CROSS:
  prove(
    [
      (hol:
         const SUBSET :: (A -> bool) -> (A -> bool) -> bool
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         const EMPTY :: A -> bool
         forall (s :: A -> bool, t :: B -> bool, #{|s'|} :: A -> bool, #{|t'|} :: B -> bool):
           SUBSET(CROSS(s, t), CROSS(#{|s'|}, #{|t'|}))
             <=> s == EMPTY || (t == EMPTY || SUBSET(s, #{|s'|}) && SUBSET(t, #{|t'|}))),
      (
        SIMP_TAC(
          PairList [
            CROSS,
            EXTENSION,
            IN_ELIM_PAIR_THM,
            SUBSET,
            FORALL_PAIR_THM,
            IN_CROSS,
            NOT_IN_EMPTY
          ]
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def CROSS_MONO:
