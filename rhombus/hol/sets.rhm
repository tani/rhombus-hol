def INSERT_SUBSET:
  prove(
    [
      @hol|{!x:A. !s t. (x INSERT s) SUBSET t <=> (x IN t /\ s SUBSET t)}|,
      SET_TAC(PairList [])
    ]
  )

def SUBSET_INSERT:
  prove(
    [
      @hol|{!x:A. !s. ~(x IN s) ==> !t. s SUBSET (x INSERT t) <=> s SUBSET t}|,
      SET_TAC(PairList [])
    ]
  )

def INSERT_DIFF:
  prove(
    [
      @hol|{!s t. !x:A. (x INSERT s) DIFF t =
         if x IN t then s DIFF t else x INSERT (s DIFF t)}|,
      REPEAT(GEN_TAC) then_tac COND_CASES_TAC then_tac \
