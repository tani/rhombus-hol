def FINITE_CROSS_EQ:
  prove(
    [
      (hol:
         const FINITE :: (A -> bool) -> bool
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         const EMPTY :: A -> bool
         forall (s :: A -> bool, t :: B -> bool):
           FINITE(CROSS(s, t)) <=> s == EMPTY || (t == EMPTY || FINITE(s) && FINITE(t))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            REPEAT(GEN_TAC) then_tac \
                            ASM_CASES_TAC(
                              (hol:
                                 var s :: A -> bool
                                 const EMPTY :: A -> bool
                                 s == EMPTY)
                            )
                          ) then_tac \
                          ASM_REWRITE_TAC(PairList [CROSS_EMPTY, FINITE_EMPTY])
                        ) then_tac \
                        ASM_CASES_TAC(
                          (hol:
                             var t :: B -> bool
                             const EMPTY :: A -> bool
                             t == EMPTY)
