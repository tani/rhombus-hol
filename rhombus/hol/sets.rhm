def PAIRWISE_UNION:
  prove(
    [
      (hol:
         const pairwise :: (A -> A -> bool) -> (A -> bool) -> bool
         const UNION :: (A -> bool) -> (A -> bool) -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         const DIFF :: (A -> bool) -> (A -> bool) -> A -> bool
         forall (R :: A -> A -> bool, s :: A -> bool, t :: A -> bool):
           pairwise(R, UNION(s, t))
             <=> (pairwise(R, s)
                    && (pairwise(R, t)
                          && (forall (x :: A, y :: A):
                                IN(x, DIFF(s, t)) && IN(y, DIFF(t, s)) ==> R(x, y) && R(y, x))))),
      (REWRITE_TAC(PairList [pairwise]) then_tac SET_TAC(PairList []))
    ]
  )

def PAIRWISE_CHAIN_UNIONS:
