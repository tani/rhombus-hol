def string_INFINITE:
  prove(
    [
      hol_term(App(
        Const("INFINITE", Fun(Fun(Tyapp("list", [Tyapp("char", [])]), Bool), Bool)),
        [Const("UNIV", Fun(Tyapp("list", [Tyapp("char", [])]), Bool))]
      )),
      (
        (
          (
            (
              (
                (MP_TAC(num_INFINITE) then_tac REWRITE_TAC(PairList [INFINITE, CONTRAPOS_THM])) then_tac \
                DISCH_THEN(
                  o(
                    o(MP_TAC)(ISPEC(hol_term(Const("LENGTH", Fun(Tyapp("list", [Tyapp("char", [])]), Num)))))
                  )(MATCH_MP(FINITE_IMAGE))
                )
              ) then_tac \
              MATCH_MP_TAC(EQ_IMP)
            ) then_tac \
            AP_TERM_TAC
          ) then_tac \
          REWRITE_TAC(PairList [EXTENSION, IN_UNIV, IN_IMAGE])
