def CROSS_EMPTY:
  prove(
    [
      (hol:
         const CROSS :: (A -> bool) -> (B -> bool) -> pair(A, B) -> bool
         const EMPTY :: A -> bool
         (forall s :: A -> bool: CROSS(s, EMPTY) == EMPTY)
           && (forall t :: B -> bool: CROSS(EMPTY, t) == EMPTY)),
