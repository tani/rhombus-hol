def INJECTIVE_ON_LEFT_INVERSE:
  let lemma:
    MESON(
      PairList [])(
      (hol:
         var s :: A -> bool
         var g :: B -> A
         var f :: A -> B
         const IN :: A -> (A -> bool) -> bool
         (forall x :: A: IN(x, s) ==> g(f(x)) == x)
           <=> (forall (y :: B, x :: A): IN(x, s) && y == f(x) ==> g(y) == x))
    )
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         forall (f :: A -> B, s :: A -> bool):
           (forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> x == y)
             <=> (exists g :: B -> A: forall x :: A: IN(x, s) ==> g(f(x)) == x)),
      (
        REWRITE_TAC(PairList [lemma, GSYM(SKOLEM_THM)]) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def BIJECTIVE_ON_LEFT_RIGHT_INVERSE:
  prove(
    [
      (hol:
         const IN :: A -> (A -> bool) -> bool
         forall (f :: A -> B, s :: A -> bool, t :: B -> bool):
           (forall x :: A: IN(x, s) ==> IN(f(x), t))
             ==> (((forall (x :: A, y :: A): IN(x, s) && (IN(y, s) && f(x) == f(y)) ==> x == y)
                     && (forall y :: B: IN(y, t) ==> (exists x :: A: IN(x, s) && f(x) == y)))
                    <=> (exists g :: B -> A:
                           (forall y :: B: IN(y, t) ==> IN(g(y), s))
                             && ((forall y :: B: IN(y, t) ==> f(g(y)) == y)
                                   && (forall x :: A: IN(x, s) ==> g(f(x)) == x))))),
      (
        (
          (
            (
              (
                (
                  (REPEAT(GEN_TAC) then_tac DISCH_TAC) then_tac \
                  REWRITE_TAC(PairList [INJECTIVE_ON_LEFT_INVERSE, SURJECTIVE_ON_RIGHT_INVERSE])
                ) then_tac \
                REWRITE_TAC(PairList [RIGHT_AND_EXISTS_THM])
              ) then_tac \
              AP_TERM_TAC
            ) then_tac \
            ABS_TAC
          ) then_tac \
          EQ_TAC
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

