def FINITE_INDUCT_DELETE:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Fun(Tvar("A"), Bool), Bool),
        Implies(
          And(
            App(Ref("P"), [Const("EMPTY", Fun(Tvar("A"), Bool))]),
            Forall(
              "s",
              Fun(Tvar("A"), Bool),
              Implies(
                And(
                  App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                  Not(Eq(Fun(Tvar("A"), Bool), Ref("s"), Const("EMPTY", Fun(Tvar("A"), Bool))))
                ),
                Exists(
                  "x",
                  Tvar("A"),
                  And(
                    App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                    Implies(
                      App(
                        Ref("P"),
                        [
                          App(
                            Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                            [Ref("s"), Ref("x")]
                          )
                        ]
                      ),
                      App(Ref("P"), [Ref("s")])
                    )
                  )
                )
              )
            )
          ),
          Forall(
            "s",
            Fun(Tvar("A"), Bool),
            Implies(
              App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
              App(Ref("P"), [Ref("s")])
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          ((GEN_TAC then_tac STRIP_TAC) then_tac GEN_TAC) then_tac \
                          WF_INDUCT_TAC(
                            hol_term(App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Var("s", Fun(Tvar("A"), Bool))]))
                          )
                        ) then_tac \
                        ASM_CASES_TAC(
                          hol_term(Eq(Fun(Tvar("A"), Bool), Var("s", Fun(Tvar("A"), Bool)), Const("EMPTY", Fun(Tvar("A"), Bool))))
                        )
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_tac \
                    DISCH_TAC
                  ) then_tac \
                  UNDISCH_TAC(
                    hol_term(Forall(
                      "s",
                      Fun(Tvar("A"), Bool),
                      Implies(
                        And(
                          App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")]),
                          Not(Eq(Fun(Tvar("A"), Bool), Ref("s"), Const("EMPTY", Fun(Tvar("A"), Bool))))
                        ),
                        Exists(
                          "x",
                          Tvar("A"),
                          And(
                            App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("s")]),
                            Implies(
                              App(
                                Var("P", Fun(Fun(Tvar("A"), Bool), Bool)),
                                [
                                  App(
                                    Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                                    [Ref("s"), Ref("x")]
                                  )
                                ]
                              ),
                              App(Var("P", Fun(Fun(Tvar("A"), Bool), Bool)), [Ref("s")])
                            )
                          )
                        )
                      )
                    ))
                  )
                ) then_tac \
                DISCH_THEN(o(MP_TAC)(SPEC(hol_term(Var("s", Fun(Tvar("A"), Bool))))))
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            DISCH_THEN(
              X_CHOOSE_THEN(hol_term(Var("x", Tvar("A"))))(CONJUNCTS_THEN2(ASSUME_TAC)(MATCH_MP_TAC))
            )
          ) then_tac \
          FIRST_X_ASSUM(
            o(MP_TAC)(
              SPEC(
                hol_term(App(
                  Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                  [Var("s", Fun(Tvar("A"), Bool)), Var("x", Tvar("A"))]
                ))
              )
            )
          )
        ) then_tac \
        ASM_SIMP_TAC(
          PairList [
            FINITE_DELETE,
            CARD_DELETE,
            CARD_EQ_0,
            ARITH_RULE(
              hol_term(Iff(
                App(
                  Const("<", Fun(Num, Fun(Num, Bool))),
                  [
                    App(
                      Const("-", Fun(Num, Fun(Num, Num))),
                      [
                        Var("n", Num),
                        App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])
                      ]
                    ),
                    Var("n", Num)
                  ]
                ),
                Not(Eq(Num, Var("n", Num), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])))
              ))
            )
          ]
        )
      )
    ]
  )

def HAS_SIZE:
  new_definition(
    hol_term(Iff(
      App(
        Var("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
        [Var("s", Fun(Tvar("A"), Bool)), Var("n", Num)]
      ),
      And(
        App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Var("s", Fun(Tvar("A"), Bool))]),
        Eq(
          Num,
          App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Var("s", Fun(Tvar("A"), Bool))]),
          Var("n", Num)
        )
      )
    ))
  )

def HAS_SIZE_CARD:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "n",
          Num,
          Implies(
            App(Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))), [Ref("s"), Ref("n")]),
            Eq(Num, App(Const("CARD", Fun(Fun(Tvar("A"), Bool), Num)), [Ref("s")]), Ref("n"))
          )
        )
      )),
      SIMP_TAC(PairList [HAS_SIZE])
    ]
  )

def HAS_SIZE_0:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Iff(
          App(
            Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
            [Ref("s"), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]
          ),
          Eq(Fun(Tvar("A"), Bool), Ref("s"), Const("EMPTY", Fun(Tvar("A"), Bool)))
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [HAS_SIZE])) then_tac \
                              EQ_TAC
                            ) then_tac \
                            DISCH_TAC
                          ) then_tac \
                          ASM_REWRITE_TAC(PairList [sets_FINITE_RULES_v2, CARD_CLAUSES])
                        ) then_tac \
                        FIRST_ASSUM(o(MP_TAC)(CONJUNCT2))
                      ) then_tac \
                      FIRST_ASSUM(o(MP_TAC)(CONJUNCT1))
                    ) then_tac \
                    SPEC_TAC([hol_term(Var("s", Fun(Tvar("A"), Bool))), hol_term(Var("s", Fun(Tvar("A"), Bool)))])
                  ) then_tac \
                  MATCH_MP_TAC(FINITE_INDUCT_STRONG)
                ) then_tac \
                REWRITE_TAC(PairList [NOT_INSERT_EMPTY])
              ) then_tac \
              REPEAT(GEN_TAC)
            ) then_tac \
            STRIP_TAC
          ) then_tac \
          FIRST_ASSUM((fun(th): REWRITE_TAC(PairList [MATCH_MP(CONJUNCT2(CARD_CLAUSES))(th)])))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [NOT_SUC])
      )
    ]
  )

def HAS_SIZE_SUC:
  prove(
    [
      hol_term(Forall(
        "s",
        Fun(Tvar("A"), Bool),
        Forall(
          "n",
          Num,
          Iff(
            App(
              Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
              [Ref("s"), App(Const("SUC", Fun(Num, Num)), [Ref("n")])]
            ),
            And(
              Not(Eq(Fun(Tvar("A"), Bool), Ref("s"), Const("EMPTY", Fun(Tvar("A"), Bool)))),
              Forall(
                "a",
                Tvar("A"),
                Implies(
                  App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("a"), Ref("s")]),
                  App(
                    Const("HAS_SIZE", Fun(Fun(Tvar("A"), Bool), Fun(Num, Bool))),
                    [
                      App(
                        Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                        [Ref("s"), Ref("a")]
                      ),
                      Ref("n")
                    ]
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [HAS_SIZE])) then_tac \
                      ASM_CASES_TAC(
                        hol_term(Eq(Fun(Tvar("A"), Bool), Var("s", Fun(Tvar("A"), Bool)), Const("EMPTY", Fun(Tvar("A"), Bool))))
                      )
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [CARD_CLAUSES, sets_FINITE_RULES_v2, NOT_IN_EMPTY, NOT_SUC])
                  ) then_tac \
                  REWRITE_TAC(PairList [FINITE_DELETE])
                ) then_tac \
                ASM_CASES_TAC(
                  hol_term(App(Const("FINITE", Fun(Fun(Tvar("A"), Bool), Bool)), [Var("s", Fun(Tvar("A"), Bool))]))
                )
              ) then_tac \
              ASM_REWRITE_TAC(PairList [NOT_FORALL_THM, MEMBER_NOT_EMPTY])
            ) then_tac \
            EQ_TAC
          ) then_tac \
          REPEAT(STRIP_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                MP_TAC(
                  ISPECL(
                    PairList [
                      hol_term(Var("a", Tvar("A"))),
                      hol_term(App(
                        Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                        [Var("s", Fun(Tvar("A"), Bool)), Var("a", Tvar("A"))]
                      ))
                    ]
                  )(CONJUNCT2(CARD_CLAUSES))
                ) then_tac \
                ASM_REWRITE_TAC(PairList [FINITE_DELETE, IN_DELETE])
              ) then_tac \
              SUBGOAL_THEN(
                hol_term(Eq(
                  Fun(Tvar("A"), Bool),
                  App(
                    Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                    [
                      Var("a", Tvar("A")),
                      App(
                        Const("DELETE", Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Fun(Tvar("A"), Bool)))),
                        [Var("s", Fun(Tvar("A"), Bool)), Var("a", Tvar("A"))]
                      )
                    ]
                  ),
                  Var("s", Fun(Tvar("A"), Bool))
                ))
              )(SUBST1_TAC)
            ) then_list \
            PairList [
              (
                UNDISCH_TAC(
                  hol_term(App(
                    Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))),
                    [Var("a", Tvar("A")), Var("s", Fun(Tvar("A"), Bool))]
                  ))
