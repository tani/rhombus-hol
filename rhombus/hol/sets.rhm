def UNIONS_IMAGE:
  prove(
    [
      (hol:
         const UNIONS :: ((A -> bool) -> bool) -> A -> bool
         const IMAGE :: (A -> B) -> (A -> bool) -> B -> bool
         const GSPEC :: (A -> bool) -> A -> bool
         const SETSPEC :: A -> bool -> A -> bool
         const IN :: A -> (A -> bool) -> bool
         forall (f :: A -> B -> bool, s :: A -> bool):
           UNIONS(IMAGE(f, s))
             == GSPEC(
                  fun (gen_pvar_16 :: B):
                    exists y :: B: SETSPEC(gen_pvar_16, exists x :: A: IN(x, s) && IN(y, f(x)), y)
                )),
      (
        (
          (REPEAT(GEN_TAC) then_tac GEN_REWRITE_TAC(I)(PairList [EXTENSION])) then_tac \
          REWRITE_TAC(PairList [IN_UNIONS, IN_IMAGE, IN_ELIM_THM])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

