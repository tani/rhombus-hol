def SET_PROVE_CASES:
  prove(
    [
      hol_term(Forall(
        "P",
        Fun(Fun(Tvar("A"), Bool), Bool),
        Implies(
          And(
            App(Ref("P"), [Const("EMPTY", Fun(Tvar("A"), Bool))]),
            Forall(
              "a",
              Tvar("A"),
              Forall(
                "s",
                Fun(Tvar("A"), Bool),
                Implies(
                  Not(App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("a"), Ref("s")])),
                  App(
                    Ref("P"),
                    [
                      App(
                        Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                        [Ref("a"), Ref("s")]
                      )
                    ]
                  )
                )
              )
            )
          ),
          Forall("s", Fun(Tvar("A"), Bool), App(Ref("P"), [Ref("s")]))
        )
      )),
      MESON_TAC(PairList [SET_CASES])
    ]
  )

