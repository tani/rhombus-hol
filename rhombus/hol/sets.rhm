        Forall(
          "u",
          Fun(Tvar("A"), Bool),
          Iff(
            Forall(
              "s",
              Fun(Tvar("A"), Bool),
              Forall(
                "t",
                Fun(Tvar("A"), Bool),
                Implies(
                  And(
                    App(
                      Const("SUBSET", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Bool))),
                      [Ref("s"), Ref("u")]
                    ),
                    And(
                      App(
                        Const("SUBSET", Fun(Fun(Tvar("A"), Bool), Fun(Fun(Tvar("A"), Bool), Bool))),
                        [Ref("t"), Ref("u")]
                      ),
                      Eq(
                        Fun(Tvar("B"), Bool),
                        App(
                          Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                          [Ref("f"), Ref("s")]
                        ),
                        App(
                          Const("IMAGE", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("B"), Bool)))),
                          [Ref("f"), Ref("t")]
                        )
                      )
                    )
                  ),
                  Eq(Fun(Tvar("A"), Bool), Ref("s"), Ref("t"))
                )
              )
            ),
            Forall(
              "x",
              Tvar("A"),
              Forall(
                "y",
                Tvar("A"),
                Implies(
                  And(
                    App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("x"), Ref("u")]),
                    And(
                      App(Const("IN", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Bool))), [Ref("y"), Ref("u")]),
                      Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("f"), [Ref("y")]))
                    )
                  ),
                  Eq(Tvar("A"), Ref("x"), Ref("y"))
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
                  PairList [DISCH_TAC, SET_TAC(PairList [])]
                ) then_tac \
                MAP_EVERY(X_GEN_TAC)(PairList [hol_term(Var("x", Tvar("A"))), hol_term(Var("y", Tvar("A")))])
              ) then_tac \
              STRIP_TAC
            ) then_tac \
            FIRST_X_ASSUM(
              o(MP_TAC)(
                SPECL(
                  PairList [
                    hol_term(App(
                      Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                      [Var("x", Tvar("A")), Const("EMPTY", Fun(Tvar("A"), Bool))]
                    )),
                    hol_term(App(
                      Const("INSERT", Fun(Tvar("A"), Fun(Fun(Tvar("A"), Bool), Fun(Tvar("A"), Bool)))),
                      [Var("y", Tvar("A")), Const("EMPTY", Fun(Tvar("A"), Bool))]
                    ))
                  ]
                )
              )
            )
          ) then_tac \
          ASM_REWRITE_TAC(PairList [SING_SUBSET, IMAGE_CLAUSES])
        ) then_tac \
        SET_TAC(PairList [])
      )
    ]
  )

