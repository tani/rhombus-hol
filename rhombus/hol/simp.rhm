def REWR_CONV = PART_MATCH(lhs)

def IMP_REWR_CONV = PART_MATCH(o(o(lhs)(snd))(dest_imp))

fun ORDERED_REWR_CONV(ord):
  fun(th):
    let basic_conv = REWR_CONV(th)
    fun(tm):
      let thm = basic_conv(tm)
      let [l, r] = dest_eq(concl(thm))
      (if ord(l)(r) | thm | failwith("ORDERED_REWR_CONV: wrong orientation"))

fun ORDERED_IMP_REWR_CONV(ord):
  fun(th):
    let basic_conv = IMP_REWR_CONV(th)
    fun(tm):
      let thm = basic_conv(tm)
      let [l, r] = dest_eq(rand(concl(thm)))
      (if ord(l)(r) | thm | failwith("ORDERED_IMP_REWR_CONV: wrong orientation"))

def term_order:
  // Recursive local helpers need definitions for self-reference.
  fun lexify(ord):
    fun(l1):
      fun(l2):
        if (l1 == (PairList []))
        | #false
        | if (l2 == (PairList []))
          | #true
          | let h1_2 = hd(l1)
            let h2_2 = hd(l2)
            (ord(h1_2)(h2_2) || ((h1_2 == h2_2) && lexify(ord)(tl(l1))(tl(l2))))
  fun dyn_order(top):
    fun(tm1):
      fun(tm2):
        let [f1_2, args1_2] = strip_comb(tm1)
        let [f2_2, args2_2] = strip_comb(tm2)
        if (f1_2 == f2_2)
        | lexify(dyn_order(f1_2))(args1_2)(args2_2)
        | if (f2_2 == top)
          | #false
          | (if (f1_2 == top) | #true | (f1_2 > f2_2))
  dyn_order(@hol|{T}|)

fun net_of_thm(rep):
  fun(th):
    let tm = concl(th)
    let lconsts = freesl(hyp(th))
    let matchable = o(can)(term_match(lconsts))
    match tm
    | Comb(Comb(Const("=",_),Abs(x,Comb(Var(s,ty) as v,x_prime)) as l),v_prime):
        if ((x_prime == x) && ((v_prime == v) && !(x == v)))
        | let conv:
            fun(tm):
              match tm
              | Abs(y,Comb(t,y_prime)):
                  if ((y == y_prime) && !free_in(y)(t))
                  | INSTANTIATE(term_match(PairList [])(v)(t))(th)
                  | match tm
                    | _: failwith("REWR_CONV (ETA_AX special case)")
              | _: failwith("REWR_CONV (ETA_AX special case)")
          enter(lconsts)([l, [1, conv]])
        | match tm
          | Comb(Comb(Const("=",_),l),r):
              if (rep && free_in(l)(r))
              | let th_prime = EQT_INTRO(th)
                enter(lconsts)([l, [1, REWR_CONV(th_prime)]])
              | (if (rep && (matchable(l)(r) && matchable(r)(l))) | enter(lconsts)([l, [1, ORDERED_REWR_CONV(term_order)(th)]]) | enter(lconsts)([l, [1, REWR_CONV(th)]]))
          | Comb(Comb(_,t),Comb(Comb(Const("=",_),l),r)):
              if (rep && free_in(l)(r))
              | let th_prime = DISCH(t)(EQT_INTRO(UNDISCH(th)))
                enter(lconsts)([l, [3, IMP_REWR_CONV(th_prime)]])
              | (if (rep && (matchable(l)(r) && matchable(r)(l))) | enter(lconsts)([l, [3, ORDERED_IMP_REWR_CONV(term_order)(th)]]) | enter(lconsts)([l, [3, IMP_REWR_CONV(th)]]))
    | Comb(Comb(Const("=",_),l),r):
        if (rep && free_in(l)(r))
        | let th_prime = EQT_INTRO(th)
          enter(lconsts)([l, [1, REWR_CONV(th_prime)]])
        | (if (rep && (matchable(l)(r) && matchable(r)(l))) | enter(lconsts)([l, [1, ORDERED_REWR_CONV(term_order)(th)]]) | enter(lconsts)([l, [1, REWR_CONV(th)]]))
    | Comb(Comb(_,t),Comb(Comb(Const("=",_),l),r)):
        if (rep && free_in(l)(r))
        | let th_prime = DISCH(t)(EQT_INTRO(UNDISCH(th)))
          enter(lconsts)([l, [3, IMP_REWR_CONV(th_prime)]])
        | (if (rep && (matchable(l)(r) && matchable(r)(l))) | enter(lconsts)([l, [3, ORDERED_IMP_REWR_CONV(term_order)(th)]]) | enter(lconsts)([l, [3, IMP_REWR_CONV(th)]]))
fun net_of_conv(tm): fun(conv): fun(sofar): enter(PairList [])([tm, [2, conv]])(sofar)

fun net_of_cong(th):
  fun(sofar):
    let [conc, n] = repeat((fun([tm, m]): [snd(dest_imp(tm)), (m + 1)]))([concl(th), 0])
    if (n == 0)
    | failwith("net_of_cong: Non-implicational congruence")
    | let pat = lhs(conc)
      let conv = GEN_PART_MATCH(o(lhand)(funpow(n)(rand)))(th)
      enter(PairList [])([pat, [4, conv]])(sofar)

def mk_rewrites:
  let IMP_CONJ_CONV_2:
    REWR_CONV(
      ITAUT(
        @hol|{p ==> q ==> r <=> p /\ q ==> r}|
      )
    )
  let cnv:
    REWR_CONV(
      ITAUT(
        @hol|{(!x. P x ==> Q) <=> (?x. P x) ==> Q}|
      )
    )
  let IMP_EXISTS_RULE_2 = fun(v): fun(th): CONV_RULE(cnv)(GEN(v)(th))
  let collect_condition:
    fun(oldhyps):
      fun(th):
        let conds = subtract(hyp(th))(oldhyps)
        if (conds == (PairList []))
        | th
        | let jth = itlist(DISCH)(conds)(th)
          let kth = CONV_RULE(REPEATC(IMP_CONJ_CONV_2))(jth)
          let [hol_cond_2, eqn] = dest_imp(concl(kth))
          let fvs = subtract(subtract(frees(hol_cond_2))(frees(eqn)))(freesl(oldhyps))
          itlist(IMP_EXISTS_RULE_2)(fvs)(kth)
  // This recursive local helper needs a definition for self-reference.
  fun split_rewrites(oldhyps):
    fun(cf):
      fun(th):
        fun(sofar):
          let tm = concl(th)
          if is_forall(tm)
          | split_rewrites(oldhyps)(cf)(SPEC_ALL(th))(sofar)
          | if is_conj(tm)
            | split_rewrites(oldhyps)(cf)(CONJUNCT1(th))(split_rewrites(oldhyps)(cf)(CONJUNCT2(th))(sofar))
            | if (is_imp(tm) && cf)
              | split_rewrites(oldhyps)(cf)(UNDISCH(th))(sofar)
              | if is_eq(tm)
                | PairList [(if cf | collect_condition(oldhyps)(th) | th), & sofar]
                | if is_neg(tm)
                  | let ths = split_rewrites(oldhyps)(cf)(EQF_INTRO(th))(sofar)
                    (if is_eq(rand(tm)) | split_rewrites(oldhyps)(cf)(EQF_INTRO(GSYM(th)))(ths) | ths)
                  | split_rewrites(oldhyps)(cf)(EQT_INTRO(th))(sofar)
  fun(cf): fun(th): fun(sofar): split_rewrites(hyp(th))(cf)(th)(sofar)

fun REWRITES_CONV(net):
  fun(tm):
    let pconvs = lookup(tm)(net)
    try:
      tryfind((fun([_, cnv]): cnv(tm)))(pconvs)
      ~catch exn:
        match exn
        | Failure(_): failwith("REWRITES_CONV")
        | exn: (throw exn)

variant prover:
  Prover(conv, augmentor)

fun mk_prover(applicator):
  fun(augmentor):
    fun mk_prover(state):
      let apply_2 = applicator(state)
      let augment_2 = (fun(thms): mk_prover(augmentor(state)(thms)))
      Prover(apply_2, augment_2)
    mk_prover

fun augment(Prover(_,aug)): fun(thms): aug(thms)

fun apply_prover(Prover(conv,_)): fun(tm): conv(tm)

variant simpset:
  Simpset(net, prover, provers, rewmaker)

fun basic_prover(strat):
  fun(Simpset(net,prover,provers,rewmaker) as ss):
    fun(lev):
      fun(tm):
        let sth:
          try:
            strat(ss)(lev)(tm)
            ~catch exn:
              match exn
              | Failure(_): REFL(tm)
              | exn: (throw exn)
        try:
          EQT_ELIM(sth)
          ~catch exn:
            match exn
            | Failure(_):
                let tth = tryfind((fun(pr): apply_prover(pr)(rand(concl(sth)))))(provers)
                EQ_MP(SYM(sth))(tth)
            | exn: (throw exn)

fun ss_of_thms(thms):
  fun(Simpset(net,prover,provers,rewmaker)):
    let cthms = itlist(rewmaker)(thms)(PairList [])
    let net_prime = itlist(net_of_thm(#true))(cthms)(net)
    Simpset(net_prime, prover, provers, rewmaker)

fun ss_of_conv(keytm):
  fun(conv):
    fun(Simpset(net,prover,provers,rewmaker)):
      let net_prime = net_of_conv(keytm)(conv)(net)
      Simpset(net_prime, prover, provers, rewmaker)

fun ss_of_congs(thms):
  fun(Simpset(net,prover,provers,rewmaker)):
    let net_prime = itlist(net_of_cong)(thms)(net)
    Simpset(net_prime, prover, provers, rewmaker)

fun ss_of_prover(newprover): fun(Simpset(net,_,provers,rewmaker)): Simpset(net, newprover, provers, rewmaker)

fun ss_of_provers(newprovers): fun(Simpset(net,prover,provers,rewmaker)): Simpset(net, prover, append(newprovers)(provers), rewmaker)

fun ss_of_maker(newmaker): fun(Simpset(net,prover,provers,_)): Simpset(net, prover, provers, newmaker)

fun AUGMENT_SIMPSET(cth):
  fun(Simpset(net,prover,provers,rewmaker)):
    let provers_prime = map(C(augment)(PairList [cth]))(provers)
    let cthms = rewmaker(cth)(PairList [])
    let net_prime = itlist(net_of_thm(#true))(cthms)(net)
    Simpset(net_prime, prover, provers_prime, rewmaker)

def [simp_ONCE_DEPTH_SQCONV_v2, simp_DEPTH_SQCONV_v2, simp_REDEPTH_SQCONV_v2, simp_TOP_DEPTH_SQCONV_v2, TOP_SWEEP_SQCONV]:
  let IMP_REWRITES_CONV = fun(strat):
    fun(Simpset(net,prover,provers,rewmaker) as ss):
      fun(lev):
        fun(pconvs):
          fun(tm):
            tryfind(
              fun([n, cnv]):
                if (n >= 4)
                | fail()
                | let th = cnv(tm)
                  let etm = concl(th)
                  if is_eq(etm)
                  | th
                  | if (lev <= 0)
                    | failwith("IMP_REWRITES_CONV: Too deep")
                    | let cth = prover(strat)(ss)((lev - 1))(lhand(etm))
                      MP(th)(cth)
            )(pconvs)
  // Recursive local conversion helpers need definitions for self-reference.
  fun RUN_SUB_CONV(strat):
    fun(ss):
      fun(lev):
        fun(triv):
          fun(th):
            let tm = concl(th)
            if is_imp(tm)
            | let subtm = lhand(tm)
              let [avs, bod] = strip_forall(subtm)
              let [[t, t_prime], ss_prime, mk_fun]:
                try:
                  [dest_eq(bod), ss, I]
                  ~catch exn:
                    match exn
                    | Failure(_):
                        let [cxt, deq] = dest_imp(bod)
                        [dest_eq(deq), AUGMENT_SIMPSET(ASSUME(cxt))(ss), DISCH(cxt)]
                    | exn: (throw exn)
              let [eth, triv_prime]:
                try:
                  [strat(ss_prime)(lev)(t), #false]
                  ~catch exn:
                    match exn
                    | Failure(_): [REFL(t), triv]
                    | exn: (throw exn)
              let eth_prime = GENL(avs)(mk_fun(eth))
              let th_prime = (if is_var(t_prime) | INST(PairList [[rand(concl(eth)), t_prime]])(th) | GEN_PART_MATCH(lhand)(th)(concl(eth_prime)))
              let th_prime_prime = MP(th_prime)(eth_prime)
              RUN_SUB_CONV(strat)(ss)(lev)(triv_prime)(th_prime_prime)
            | (if triv | fail() | th)
  let GEN_SUB_CONV = fun(strat):
    fun(ss):
      fun(lev):
        fun(pconvs):
          fun(tm):
            try:
              tryfind(
                fun([n, cnv]):
                  if (n < 4)
                  | fail()
                  | let th = cnv(tm)
                    RUN_SUB_CONV(strat)(ss)(lev)(#true)(th)
              )(pconvs)
              ~catch exn:
                match exn
                | Failure(_):
                    if is_comb(tm)
                    | let [l, r] = dest_comb(tm)
                      try:
                        let th1 = strat(ss)(lev)(l)
                        try:
                          let th2 = strat(ss)(lev)(r)
                          MK_COMB([th1, th2])
                          ~catch exn:
                            match exn
                            | Failure(_): AP_THM(th1)(r)
                            | exn: (throw exn)
                        ~catch exn:
                          match exn
                          | Failure(_): AP_TERM(l)(strat(ss)(lev)(r))
                          | exn: (throw exn)
                    | if is_abs(tm)
                      | let [v, bod] = dest_abs(tm)
                        let th = strat(ss)(lev)(bod)
                        try:
                          ABS(v)(th)
                          ~catch exn:
                            match exn
                            | Failure(_):
                                let gv = genvar(type_of(v))
                                let gbod = vsubst(PairList [[gv, v]])(bod)
                                let gth = ABS(gv)(strat(ss)(lev)(gbod))
                                let gtm = concl(gth)
                                let [l, r] = dest_eq(gtm)
                                let v_prime = variant(frees(gtm))(v)
                                let l_prime_2 = alpha(v_prime)(l)
                                let r_prime_2 = alpha(v_prime)(r)
                                EQ_MP(ALPHA(gtm)(mk_eq([l_prime_2, r_prime_2])))(gth)
                            | exn: (throw exn)
                      | failwith("GEN_SUB_CONV")
                | exn: (throw exn)
  fun ONCE_DEPTH_SQCONV(Simpset(net,prover,provers,rewmaker) as ss):
    fun(lev):
      fun(tm):
        let pconvs = lookup(tm)(net)
        try:
          IMP_REWRITES_CONV(ONCE_DEPTH_SQCONV)(ss)(lev)(pconvs)(tm)
          ~catch exn:
            match exn
            | Failure(_): GEN_SUB_CONV(ONCE_DEPTH_SQCONV)(ss)(lev)(pconvs)(tm)
            | exn: (throw exn)
  fun DEPTH_SQCONV(Simpset(net,prover,provers,rewmaker) as ss):
    fun(lev):
      fun(tm):
        let pconvs = lookup(tm)(net)
        try:
          let th1 = GEN_SUB_CONV(DEPTH_SQCONV)(ss)(lev)(pconvs)(tm)
          let tm1 = rand(concl(th1))
          let pconvs1 = lookup(tm1)(net)
          try:
            TRANS(th1)(IMP_REWRITES_CONV(DEPTH_SQCONV)(ss)(lev)(pconvs1)(tm1))
            ~catch exn:
              match exn
              | Failure(_): th1
              | exn: (throw exn)
          ~catch exn:
            match exn
            | Failure(_): IMP_REWRITES_CONV(DEPTH_SQCONV)(ss)(lev)(pconvs)(tm)
            | exn: (throw exn)
  fun REDEPTH_SQCONV(Simpset(net,prover,provers,rewmaker) as ss):
    fun(lev):
      fun(tm):
        let pconvs = lookup(tm)(net)
        let th:
          try:
            let th1 = GEN_SUB_CONV(REDEPTH_SQCONV)(ss)(lev)(pconvs)(tm)
            let tm1 = rand(concl(th1))
            let pconvs1 = lookup(tm1)(net)
            try:
              TRANS(th1)(IMP_REWRITES_CONV(REDEPTH_SQCONV)(ss)(lev)(pconvs1)(tm1))
              ~catch exn:
                match exn
                | Failure(_): th1
                | exn: (throw exn)
            ~catch exn:
              match exn
              | Failure(_): IMP_REWRITES_CONV(REDEPTH_SQCONV)(ss)(lev)(pconvs)(tm)
              | exn: (throw exn)
        try:
          let th_prime = REDEPTH_SQCONV(ss)(lev)(rand(concl(th)))
          TRANS(th)(th_prime)
          ~catch exn:
            match exn
            | Failure(_): th
            | exn: (throw exn)
  fun TOP_DEPTH_SQCONV(Simpset(net,prover,provers,rewmaker) as ss):
    fun(lev):
      fun(tm):
        let pconvs = lookup(tm)(net)
        let th1:
          try:
            IMP_REWRITES_CONV(TOP_DEPTH_SQCONV)(ss)(lev)(pconvs)(tm)
            ~catch exn:
              match exn
              | Failure(_): GEN_SUB_CONV(TOP_DEPTH_SQCONV)(ss)(lev)(pconvs)(tm)
              | exn: (throw exn)
        try:
          let th2 = TOP_DEPTH_SQCONV(ss)(lev)(rand(concl(th1)))
          TRANS(th1)(th2)
          ~catch exn:
            match exn
            | Failure(_): th1
            | exn: (throw exn)
  fun TOP_SWEEP_SQCONV(Simpset(net,prover,provers,rewmaker) as ss):
    fun(lev):
      fun(tm):
        let pconvs = lookup(tm)(net)
        try:
          let th1 = IMP_REWRITES_CONV(TOP_SWEEP_SQCONV)(ss)(lev)(pconvs)(tm)
          try:
            let th2 = TOP_SWEEP_SQCONV(ss)(lev)(rand(concl(th1)))
            TRANS(th1)(th2)
            ~catch exn:
              match exn
              | Failure(_): th1
              | exn: (throw exn)
          ~catch exn:
            match exn
            | Failure(_): GEN_SUB_CONV(TOP_SWEEP_SQCONV)(ss)(lev)(pconvs)(tm)
            | exn: (throw exn)
  [ONCE_DEPTH_SQCONV, DEPTH_SQCONV, REDEPTH_SQCONV, TOP_DEPTH_SQCONV, TOP_SWEEP_SQCONV]

def [simp_set_basic_rewrites_v2, simp_extend_basic_rewrites_v2, simp_basic_rewrites_v2, simp_set_basic_convs_v2, simp_extend_basic_convs_v2, simp_basic_convs_v2, basic_net]:
  let rewrites_2 = Box(PairList [])
  let conversions_2 = Box(PairList [])
  let conv_net_2 = Box(empty_net)
  let rehash_convnet:
    fun(_):
      (conv_net_2.value := itlist(net_of_thm(#true))(rewrites_2.value)(
          itlist((fun([_, [pat, cnv]]): net_of_conv(pat)(cnv)))(conversions_2.value)(empty_net)
        ))
  let set_basic_rewrites_2:
    fun(thl):
      let canon_thl = itlist(mk_rewrites(#false))(thl)(PairList [])
      rewrites_2.value := canon_thl
      rehash_convnet(#void)
  let extend_basic_rewrites_2:
    fun(thl):
      let canon_thl = itlist(mk_rewrites(#false))(thl)(PairList [])
      rewrites_2.value := append(canon_thl)(rewrites_2.value)
      rehash_convnet(#void)
  let basic_rewrites_2 = (fun(_): rewrites_2.value)
  let set_basic_convs_2:
    fun(cnvs):
      conversions_2.value := cnvs
      rehash_convnet(#void)
  let extend_basic_convs_2:
    fun([name, patcong]):
      (conversions_2.value := (PairList [
          [name, patcong],
          & filter((fun([name_prime, _]): (name != name_prime)))(conversions_2.value)
        ]))
      rehash_convnet(#void)
  let basic_convs_2 = (fun(_): conversions_2.value)
  let basic_net_2 = (fun(_): conv_net_2.value)
  [
    set_basic_rewrites_2,
    extend_basic_rewrites_2,
    basic_rewrites_2,
    set_basic_convs_2,
    extend_basic_convs_2,
    basic_convs_2,
    basic_net_2
  ]

def [simp_set_basic_congs_v2, simp_extend_basic_congs_v2, basic_congs]:
  let congs = Box(PairList [])
  [
    (fun(thl): (congs.value := thl)),
    (fun(thl): (congs.value := union_prime(equals_thm)(thl)(congs.value))),
    (fun(_): congs.value)
  ]

fun GENERAL_REWRITE_CONV(rep):
  fun(cnvl):
    fun(builtin_net):
      fun(thl):
        let thl_canon = itlist(mk_rewrites(#false))(thl)(PairList [])
        let final_net = itlist(net_of_thm(rep))(thl_canon)(builtin_net)
        cnvl(REWRITES_CONV(final_net))
fun GEN_REWRITE_CONV(cnvl): fun(thl): GENERAL_REWRITE_CONV(#false)(cnvl)(empty_net)(thl)

fun PURE_REWRITE_CONV(thl): GENERAL_REWRITE_CONV(#true)(TOP_DEPTH_CONV)(empty_net)(thl)
fun REWRITE_CONV(thl): GENERAL_REWRITE_CONV(#true)(TOP_DEPTH_CONV)(basic_net(#void))(thl)
fun PURE_ONCE_REWRITE_CONV(thl): GENERAL_REWRITE_CONV(#false)(ONCE_DEPTH_CONV)(empty_net)(thl)
fun ONCE_REWRITE_CONV(thl): GENERAL_REWRITE_CONV(#false)(ONCE_DEPTH_CONV)(basic_net(#void))(thl)
fun GEN_REWRITE_RULE(cnvl): fun(thl): CONV_RULE(GEN_REWRITE_CONV(cnvl)(thl))

fun PURE_REWRITE_RULE(thl): CONV_RULE(PURE_REWRITE_CONV(thl))
fun REWRITE_RULE(thl): CONV_RULE(REWRITE_CONV(thl))
fun PURE_ONCE_REWRITE_RULE(thl): CONV_RULE(PURE_ONCE_REWRITE_CONV(thl))
fun ONCE_REWRITE_RULE(thl): CONV_RULE(ONCE_REWRITE_CONV(thl))
fun PURE_ASM_REWRITE_RULE(thl): fun(th): PURE_REWRITE_RULE(append(map(ASSUME)(hyp(th)))(thl))(th)

fun ASM_REWRITE_RULE(thl): fun(th): REWRITE_RULE(append(map(ASSUME)(hyp(th)))(thl))(th)

fun PURE_ONCE_ASM_REWRITE_RULE(thl): fun(th): PURE_ONCE_REWRITE_RULE(append(map(ASSUME)(hyp(th)))(thl))(th)

fun ONCE_ASM_REWRITE_RULE(thl): fun(th): ONCE_REWRITE_RULE(append(map(ASSUME)(hyp(th)))(thl))(th)

fun GEN_REWRITE_TAC(cnvl): fun(thl): CONV_TAC(GEN_REWRITE_CONV(cnvl)(thl))

fun PURE_REWRITE_TAC(thl): CONV_TAC(PURE_REWRITE_CONV(thl))
fun REWRITE_TAC(thl): CONV_TAC(REWRITE_CONV(thl))
fun PURE_ONCE_REWRITE_TAC(thl): CONV_TAC(PURE_ONCE_REWRITE_CONV(thl))
fun ONCE_REWRITE_TAC(thl): CONV_TAC(ONCE_REWRITE_CONV(thl))
def PURE_ASM_REWRITE_TAC = ASM(PURE_REWRITE_TAC)

def ASM_REWRITE_TAC = ASM(REWRITE_TAC)

def PURE_ONCE_ASM_REWRITE_TAC = ASM(PURE_ONCE_REWRITE_TAC)

def ONCE_ASM_REWRITE_TAC = ASM(ONCE_REWRITE_TAC)

fun GEN_SIMPLIFY_CONV(strat):
  fun(ss):
    fun(lev):
      fun(thl):
        let ss_prime = itlist(AUGMENT_SIMPSET)(thl)(ss)
        TRY_CONV(strat(ss_prime)(lev))
fun ONCE_SIMPLIFY_CONV(ss): GEN_SIMPLIFY_CONV(simp_ONCE_DEPTH_SQCONV_v2)(ss)(1)
fun SIMPLIFY_CONV(ss): GEN_SIMPLIFY_CONV(simp_TOP_DEPTH_SQCONV_v2)(ss)(3)
def empty_ss = Simpset(empty_net, basic_prover, PairList [], mk_rewrites(#true))

def basic_ss:
  let rewmaker = mk_rewrites(#true)
  fun(thl):
    let cthms = itlist(rewmaker)(thl)(PairList [])
    let net_prime = itlist(net_of_thm(#true))(cthms)(basic_net(#void))
    let net_prime_prime = itlist(net_of_cong)(basic_congs(#void))(net_prime)
    Simpset(net_prime_prime, basic_prover, PairList [], rewmaker)

fun SIMP_CONV(thl): SIMPLIFY_CONV(basic_ss(PairList []))(thl)
fun PURE_SIMP_CONV(thl): SIMPLIFY_CONV(empty_ss)(thl)
fun ONCE_SIMP_CONV(thl): ONCE_SIMPLIFY_CONV(basic_ss(PairList []))(thl)
fun SIMP_RULE(thl): CONV_RULE(SIMP_CONV(thl))
fun PURE_SIMP_RULE(thl): CONV_RULE(PURE_SIMP_CONV(thl))
fun ONCE_SIMP_RULE(thl): CONV_RULE(ONCE_SIMP_CONV(thl))
fun SIMP_TAC(thl): CONV_TAC(SIMP_CONV(thl))
fun PURE_SIMP_TAC(thl): CONV_TAC(PURE_SIMP_CONV(thl))
fun ONCE_SIMP_TAC(thl): CONV_TAC(ONCE_SIMP_CONV(thl))
def ASM_SIMP_TAC = ASM(SIMP_TAC)

def PURE_ASM_SIMP_TAC = ASM(PURE_SIMP_TAC)

def ONCE_ASM_SIMP_TAC = ASM(ONCE_SIMP_TAC)

fun ABBREV_TAC(tm):
  let [cvs, t] = dest_eq(tm)
  let [v, vs] = strip_comb(cvs)
  let rs = list_mk_abs([vs, t])
  let eq = mk_eq([rs, v])
  let th1 = itlist((fun(v): (fun(th): CONV_RULE(LAND_CONV(BETA_CONV))(AP_THM(th)(v)))))(rev(vs))(ASSUME(eq))
  let th2 = SIMPLE_CHOOSE(v)(SIMPLE_EXISTS(v)(GENL(vs)(th1)))
  let th3 = PROVE_HYP(EXISTS([mk_exists([v, eq]), rs])(REFL(rs)))(th2)
  fun([asl, w] as gl):
    let avoids = itlist(o(o(o(union)(frees))(concl))(snd))(asl)(frees(w))
    if mem(v)(avoids)
    | failwith("ABBREV_TAC: variable already used")
    | CHOOSE_THEN(
        fun(th):
          (
            RULE_ASSUM_TAC(PURE_ONCE_REWRITE_RULE(PairList [th])) then_tac \
            PURE_ONCE_REWRITE_TAC(PairList [th]) then_tac \
            ASSUME_TAC(th)
          )
      )(th3)(gl)
fun EXPAND_TAC(s):
  (
    FIRST_ASSUM(
      o(o(SUBST1_TAC)(SYM))(check(o(o(o(o((fun (y): s == y))(fst))(dest_var))(rhs))(concl)))
    ) then_tac \
    BETA_TAC
  )

def ONCE_DEPTH_SQCONV = simp_ONCE_DEPTH_SQCONV_v2

