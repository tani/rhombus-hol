fun simp_ABBREV_TAC(tm):«
  (block:«
    let Pair(cvs,t):«
      Up_fusion.dest_eq(tm)
    »;
    (block:«
      let Pair(v,vs):«
        Up_basics.strip_comb(cvs)
      »;
      (block:«
        let rs:«
          Up_basics.list_mk_abs(Pair(vs,t))
        »;
        (block:«
          let eq:«
            Up_fusion.mk_eq(Pair(rs,v))
          »;
          (block:«
            let th1:«
              (block:«
                let port_tmp_86 = Up_fusion.ASSUME(eq);
                let port_tmp_87 = Host.rev(vs);
                itlist((fun(v):«
                  (fun(th):«
                    (block:«
                      let port_tmp_88 = Up_equal.AP_THM(th)(v);
                      let port_tmp_89 = Up_equal.LAND_CONV(Up_equal.BETA_CONV);
                      Up_equal.CONV_RULE(port_tmp_89)(port_tmp_88)
                    »)
                  »)
                »))(port_tmp_87)(port_tmp_86)
              »)
            »;
            (block:«
              let th2:«
                Up_bool.SIMPLE_CHOOSE(v)(Up_bool.SIMPLE_EXISTS(v)(Up_bool.GENL(vs)(th1)))
              »;
              (block:«
                let th3:«
                  Up_bool.PROVE_HYP((block:«
                    let port_tmp_90 = Up_fusion.REFL(rs);
                    let port_tmp_91 = Pair(Up_bool.mk_exists(Pair(v,eq)),rs);
                    Up_bool.EXISTS(port_tmp_91)(port_tmp_90)
                  »))(th2)
                »;
                (fun(Pair(asl,w) as gl):«
                  (block:«
                    let avoids:«
                      (block:«
                        let port_tmp_92 = Up_fusion.frees(w);
                        let port_tmp_93 = o(o(o(union)(Up_fusion.frees))(Up_fusion.concl))(snd);
                        itlist(port_tmp_93)(asl)(port_tmp_92)
                      »)
                    »;
                    (block:«
                      if mem(v)(avoids)
                      | failwith("ABBREV_TAC: variable already used")
                      | Up_tactics.CHOOSE_THEN((fun(th):«
                        (block:«
                          let port_tmp_94 = Up_tactics.ASSUME_TAC(th);
                          let port_tmp_95 = (block:«
                            let port_tmp_96 = simp_PURE_ONCE_REWRITE_TAC(PairList.cons(th,PairList []));
                            let port_tmp_97 = Up_tactics.RULE_ASSUM_TAC(simp_PURE_ONCE_REWRITE_RULE(PairList.cons(th,PairList [])));
                            Up_tactics.THEN(port_tmp_97)(port_tmp_96)
                          »);
                          Up_tactics.THEN(port_tmp_95)(port_tmp_94)
                        »)
                      »))(th3)(gl)
                    »)
                  »)
                »)
              »)
            »)
          »)
        »)
      »)
    »)
  »)
»

fun simp_EXPAND_TAC(s):«
  Up_tactics.THEN(Up_tactics.FIRST_ASSUM((block:«
    let port_tmp_98 = Host.check(o(o(o(o(Host.hol_equal(s))(fst))(Up_fusion.dest_var))(Up_equal.rhs))(Up_fusion.concl));
    let port_tmp_99 = o(Up_tactics.SUBST1_TAC)(Up_equal.SYM);
    o(port_tmp_99)(port_tmp_98)
  »)))(Up_tactics.BETA_TAC)
»

