fun simp_GEN_SIMPLIFY_CONV(strat):«
  (fun(ss):«
    (fun(lev):«
      (fun(thl):«
        (block:«
          let ss_prime:«
            itlist(simp_AUGMENT_SIMPSET)(thl)(ss)
          »;
          Up_equal.TRY_CONV(strat(ss_prime)(lev))
        »)
      »)
    »)
  »)
»

fun simp_ONCE_SIMPLIFY_CONV(ss):«
  simp_GEN_SIMPLIFY_CONV(simp_ONCE_DEPTH_SQCONV)(ss)(1)
»

fun simp_SIMPLIFY_CONV(ss):«
  simp_GEN_SIMPLIFY_CONV(simp_TOP_DEPTH_SQCONV)(ss)(3)
»

def simp_empty_ss:«
  simp_ctor_Simpset(Up_nets.empty_net,simp_basic_prover,PairList [],simp_mk_rewrites(#true))
»

def simp_basic_ss:«
  (block:«
    let rewmaker:«
      simp_mk_rewrites(#true)
    »;
    (fun(thl):«
      (block:«
        let cthms:«
          itlist(rewmaker)(thl)(PairList [])
        »;
        (block:«
          let net_prime:«
            (block:«
              let port_tmp_84 = Host.hol_apply_unit(simp_basic_net);
              let port_tmp_85 = simp_net_of_thm(#true);
              itlist(port_tmp_85)(cthms)(port_tmp_84)
            »)
          »;
          (block:«
            let net_prime_prime:«
              itlist(simp_net_of_cong)(Host.hol_apply_unit(simp_basic_congs))(net_prime)
            »;
            simp_ctor_Simpset(net_prime_prime,simp_basic_prover,PairList [],rewmaker)
          »)
        »)
      »)
    »)
  »)
»

fun simp_SIMP_CONV(thl):«
  simp_SIMPLIFY_CONV(simp_basic_ss(PairList []))(thl)
»

fun simp_PURE_SIMP_CONV(thl):«
  simp_SIMPLIFY_CONV(simp_empty_ss)(thl)
