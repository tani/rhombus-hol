def REWR_CONV = Drule.PART_MATCH(Equal.lhs)

def IMP_REWR_CONV = Drule.PART_MATCH(o(o(Equal.lhs)(snd))(Basics.dest_imp))

fun ORDERED_REWR_CONV(ord):
  fun(th):
    let basic_conv = REWR_CONV(th)
    fun(tm):
      let thm = basic_conv(tm)
      let [l, r] = Fusion.dest_eq(Fusion.concl(thm))
      (if ord(l)(r) | thm | failwith("ORDERED_REWR_CONV: wrong orientation"))

fun ORDERED_IMP_REWR_CONV(ord):
  fun(th):
    let basic_conv = IMP_REWR_CONV(th)
    fun(tm):
      let thm = basic_conv(tm)
      let [l, r] = Fusion.dest_eq(Fusion.rand(Fusion.concl(thm)))
      (if ord(l)(r) | thm | failwith("ORDERED_IMP_REWR_CONV: wrong orientation"))

def term_order:
  fun lexify(ord):
    fun(l1):
      fun(l2):
        if Host.hol_equal(l1)(PairList [])
        | #false
        | if Host.hol_equal(l2)(PairList [])
          | #true
          | let h1_2 = hd(l1)
            let h2_2 = hd(l2)
            (ord(h1_2)(h2_2) || (Host.hol_equal(h1_2)(h2_2) && lexify(ord)(tl(l1))(tl(l2))))
  fun dyn_order(top):
    fun(tm1):
      fun(tm2):
        let [f1_2, args1_2] = Basics.strip_comb(tm1)
        let [f2_2, args2_2] = Basics.strip_comb(tm2)
        if Host.hol_equal(f1_2)(f2_2)
        | lexify(dyn_order(f1_2))(args1_2)(args2_2)
        | if Host.hol_equal(f2_2)(top)
          | #false
          | (if Host.hol_equal(f1_2)(top) | #true | Host.hol_gt(f1_2)(f2_2))
  dyn_order(Host.hol_term(Const("T", Tyapp("bool", []))))

fun net_of_thm(rep):
  fun(th):
    let tm = Fusion.concl(th)
    let lconsts = Fusion.freesl(Fusion.hyp(th))
    let matchable = o(can)(Drule.term_match(lconsts))
    match tm
    | Fusion.Comb(Fusion.Comb(Fusion.Const("=",_),Fusion.Abs(x,Fusion.Comb(Fusion.Var(s,ty) as v,x_prime)) as l),v_prime):
        if (Host.hol_equal(x_prime)(x) && (Host.hol_equal(v_prime)(v) && Host.hol_not(Host.hol_equal(x)(v))))
        | let conv:
            fun(tm):
              match tm
              | Fusion.Abs(y,Fusion.Comb(t,y_prime)):
                  if (Host.hol_equal(y)(y_prime) && Host.hol_not(Basics.free_in(y)(t)))
                  | Drule.INSTANTIATE(Drule.term_match(PairList [])(v)(t))(th)
                  | match tm
                    | _: failwith("REWR_CONV (ETA_AX special case)")
              | _: failwith("REWR_CONV (ETA_AX special case)")
          Nets.enter(lconsts)([l, [1, conv]])
        | match tm
          | Fusion.Comb(Fusion.Comb(Fusion.Const("=",_),l),r):
              if (rep && Basics.free_in(l)(r))
              | let th_prime = Bool.EQT_INTRO(th)
                Nets.enter(lconsts)([l, [1, REWR_CONV(th_prime)]])
              | (if (rep && (matchable(l)(r) && matchable(r)(l))) | Nets.enter(lconsts)([l, [1, ORDERED_REWR_CONV(term_order)(th)]]) | Nets.enter(lconsts)([l, [1, REWR_CONV(th)]]))
          | Fusion.Comb(Fusion.Comb(_,t),Fusion.Comb(Fusion.Comb(Fusion.Const("=",_),l),r)):
              if (rep && Basics.free_in(l)(r))
              | let th_prime = Bool.DISCH(t)(Bool.EQT_INTRO(Bool.UNDISCH(th)))
                Nets.enter(lconsts)([l, [3, IMP_REWR_CONV(th_prime)]])
              | (if (rep && (matchable(l)(r) && matchable(r)(l))) | Nets.enter(lconsts)([l, [3, ORDERED_IMP_REWR_CONV(term_order)(th)]]) | Nets.enter(lconsts)([l, [3, IMP_REWR_CONV(th)]]))
    | Fusion.Comb(Fusion.Comb(Fusion.Const("=",_),l),r):
        if (rep && Basics.free_in(l)(r))
        | let th_prime = Bool.EQT_INTRO(th)
          Nets.enter(lconsts)([l, [1, REWR_CONV(th_prime)]])
        | (if (rep && (matchable(l)(r) && matchable(r)(l))) | Nets.enter(lconsts)([l, [1, ORDERED_REWR_CONV(term_order)(th)]]) | Nets.enter(lconsts)([l, [1, REWR_CONV(th)]]))
    | Fusion.Comb(Fusion.Comb(_,t),Fusion.Comb(Fusion.Comb(Fusion.Const("=",_),l),r)):
        if (rep && Basics.free_in(l)(r))
        | let th_prime = Bool.DISCH(t)(Bool.EQT_INTRO(Bool.UNDISCH(th)))
          Nets.enter(lconsts)([l, [3, IMP_REWR_CONV(th_prime)]])
        | (if (rep && (matchable(l)(r) && matchable(r)(l))) | Nets.enter(lconsts)([l, [3, ORDERED_IMP_REWR_CONV(term_order)(th)]]) | Nets.enter(lconsts)([l, [3, IMP_REWR_CONV(th)]]))

fun net_of_conv(tm): (fun(conv): (fun(sofar): Nets.enter(PairList [])([tm, [2, conv]])(sofar)))

fun net_of_cong(th):
  fun(sofar):
    let [conc, n] = Host.repeat((fun([tm, m]): [snd(Basics.dest_imp(tm)), Host.hol_add(m)(1)]))([Fusion.concl(th), 0])
    if Host.hol_equal(n)(0)
    | failwith("net_of_cong: Non-implicational congruence")
    | let pat = Equal.lhs(conc)
      let conv = Drule.GEN_PART_MATCH(o(Equal.lhand)(Host.funpow(n)(Fusion.rand)))(th)
      Nets.enter(PairList [])([pat, [4, conv]])(sofar)

def mk_rewrites:
  let IMP_CONJ_CONV_2 = REWR_CONV(Itab.ITAUT(Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("p", Tyapp("bool", []))), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("q", Tyapp("bool", []))), Var("r", Tyapp("bool", []))))), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Comb(Const("/\\", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Var("p", Tyapp("bool", []))), Var("q", Tyapp("bool", [])))), Var("r", Tyapp("bool", [])))))))
  let cnv = REWR_CONV(Itab.ITAUT(Host.hol_term(Comb(Comb(Const("=", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("!", Tyapp("fun", [Tyapp("fun", [Tyvar("?328"), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("x", Tyvar("?328")), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Var("P", Tyapp("fun", [Tyvar("?328"), Tyapp("bool", [])])), Var("x", Tyvar("?328")))), Var("Q", Tyapp("bool", [])))))), Comb(Comb(Const("==>", Tyapp("fun", [Tyapp("bool", []), Tyapp("fun", [Tyapp("bool", []), Tyapp("bool", [])])])), Comb(Const("?", Tyapp("fun", [Tyapp("fun", [Tyvar("?328"), Tyapp("bool", [])]), Tyapp("bool", [])])), Abs(Var("x", Tyvar("?328")), Comb(Var("P", Tyapp("fun", [Tyvar("?328"), Tyapp("bool", [])])), Var("x", Tyvar("?328")))))), Var("Q", Tyapp("bool", [])))))))
  let IMP_EXISTS_RULE_2 = (fun(v): (fun(th): Equal.CONV_RULE(cnv)(Bool.GEN(v)(th))))
  let collect_condition:
    fun(oldhyps):
      fun(th):
        let conds = subtract(Fusion.hyp(th))(oldhyps)
        if Host.hol_equal(conds)(PairList [])
        | th
        | let jth = itlist(Bool.DISCH)(conds)(th)
          let kth = Equal.CONV_RULE(Equal.REPEATC(IMP_CONJ_CONV_2))(jth)
          let [hol_cond_2, eqn] = Basics.dest_imp(Fusion.concl(kth))
          let fvs = subtract(subtract(Fusion.frees(hol_cond_2))(Fusion.frees(eqn)))(Fusion.freesl(oldhyps))
          itlist(IMP_EXISTS_RULE_2)(fvs)(kth)
  fun split_rewrites(oldhyps):
    fun(cf):
      fun(th):
        fun(sofar):
          let tm = Fusion.concl(th)
          if Basics.is_forall(tm)
          | split_rewrites(oldhyps)(cf)(Bool.SPEC_ALL(th))(sofar)
          | if Basics.is_conj(tm)
            | split_rewrites(oldhyps)(cf)(Bool.CONJUNCT1(th))(split_rewrites(oldhyps)(cf)(Bool.CONJUNCT2(th))(sofar))
            | if (Basics.is_imp(tm) && cf)
              | split_rewrites(oldhyps)(cf)(Bool.UNDISCH(th))(sofar)
              | if Fusion.is_eq(tm)
                | PairList.cons((if cf | collect_condition(oldhyps)(th) | th), sofar)
                | if Basics.is_neg(tm)
                  | let ths = split_rewrites(oldhyps)(cf)(Bool.EQF_INTRO(th))(sofar)
                    (if Fusion.is_eq(Fusion.rand(tm)) | split_rewrites(oldhyps)(cf)(Bool.EQF_INTRO(Equal.GSYM(th)))(ths) | ths)
                  | split_rewrites(oldhyps)(cf)(Bool.EQT_INTRO(th))(sofar)
  (fun(cf): (fun(th): (fun(sofar): split_rewrites(Fusion.hyp(th))(cf)(th)(sofar))))

fun REWRITES_CONV(net):
  fun(tm):
    let pconvs = Nets.lookup(tm)(net)
    try:
      tryfind((fun([_, cnv]): cnv(tm)))(pconvs)
      ~catch exn:
        match exn
        | Failure(_): failwith("REWRITES_CONV")
        | exn: Host.hol_raise(exn)

class simp_ctor_Prover(conv, augmentor):
  extends Host.HolVariant
  override port_view(): [1, [0, PairList [this.conv, this.augmentor]]]

fun mk_prover(applicator):
  fun(augmentor):
    fun mk_prover(state):
      let apply_2 = applicator(state)
      let augment_2 = (fun(thms): mk_prover(augmentor(state)(thms)))
      simp_ctor_Prover(apply_2, augment_2)
    mk_prover

fun augment(simp_ctor_Prover(_,aug)): (fun(thms): aug(thms))

fun apply_prover(simp_ctor_Prover(conv,_)): (fun(tm): conv(tm))

class simp_ctor_Simpset(net, prover, provers, rewmaker):
  extends Host.HolVariant
  override port_view(): [1, [0, PairList [this.net, this.prover, this.provers, this.rewmaker]]]

fun basic_prover(strat):
  fun(simp_ctor_Simpset(net,prover,provers,rewmaker) as ss):
    fun(lev):
      fun(tm):
        let sth:
          try:
            strat(ss)(lev)(tm)
            ~catch exn:
              match exn
              | Failure(_): Fusion.REFL(tm)
              | exn: Host.hol_raise(exn)
        try:
          Bool.EQT_ELIM(sth)
          ~catch exn:
            match exn
            | Failure(_):
                let tth = tryfind((fun(pr): apply_prover(pr)(Fusion.rand(Fusion.concl(sth)))))(provers)
                Fusion.EQ_MP(Equal.SYM(sth))(tth)
            | exn: Host.hol_raise(exn)

fun ss_of_thms(thms):
  fun(simp_ctor_Simpset(net,prover,provers,rewmaker)):
    let cthms = itlist(rewmaker)(thms)(PairList [])
    let net_prime = itlist(net_of_thm(#true))(cthms)(net)
    simp_ctor_Simpset(net_prime, prover, provers, rewmaker)

fun ss_of_conv(keytm):
  fun(conv):
    fun(simp_ctor_Simpset(net,prover,provers,rewmaker)):
      let net_prime = net_of_conv(keytm)(conv)(net)
      simp_ctor_Simpset(net_prime, prover, provers, rewmaker)

fun ss_of_congs(thms):
  fun(simp_ctor_Simpset(net,prover,provers,rewmaker)):
    let net_prime = itlist(net_of_cong)(thms)(net)
    simp_ctor_Simpset(net_prime, prover, provers, rewmaker)

fun ss_of_prover(newprover): (fun(simp_ctor_Simpset(net,_,provers,rewmaker)): simp_ctor_Simpset(net, newprover, provers, rewmaker))

fun ss_of_provers(newprovers): (fun(simp_ctor_Simpset(net,prover,provers,rewmaker)): simp_ctor_Simpset(net, prover, append(newprovers)(provers), rewmaker))

fun ss_of_maker(newmaker): (fun(simp_ctor_Simpset(net,prover,provers,_)): simp_ctor_Simpset(net, prover, provers, newmaker))

fun AUGMENT_SIMPSET(cth):
  fun(simp_ctor_Simpset(net,prover,provers,rewmaker)):
    let provers_prime = map(C(augment)(PairList.cons(cth, PairList [])))(provers)
    let cthms = rewmaker(cth)(PairList [])
    let net_prime = itlist(net_of_thm(#true))(cthms)(net)
    simp_ctor_Simpset(net_prime, prover, provers_prime, rewmaker)

def [ONCE_DEPTH_SQCONV, DEPTH_SQCONV, REDEPTH_SQCONV, TOP_DEPTH_SQCONV, TOP_SWEEP_SQCONV]:
  let IMP_REWRITES_CONV:
    fun(strat):
      fun(simp_ctor_Simpset(net,prover,provers,rewmaker) as ss):
        fun(lev):
          fun(pconvs):
            fun(tm):
              tryfind(
                fun([n, cnv]):
                  if Host.hol_ge(n)(4)
                  | Host.hol_apply_unit(fail)
                  | let th = cnv(tm)
                    let etm = Fusion.concl(th)
                    if Fusion.is_eq(etm)
                    | th
                    | if Host.hol_le(lev)(0)
                      | failwith("IMP_REWRITES_CONV: Too deep")
                      | let cth = prover(strat)(ss)(Host.hol_sub(lev)(1))(Equal.lhand(etm))
                        Bool.MP(th)(cth))(pconvs)
  fun RUN_SUB_CONV(strat):
    fun(ss):
      fun(lev):
        fun(triv):
          fun(th):
            let tm = Fusion.concl(th)
            if Basics.is_imp(tm)
            | let subtm = Equal.lhand(tm)
              let [avs, bod] = Basics.strip_forall(subtm)
              let [[t, t_prime], ss_prime, mk_fun]:
                try:
                  [Fusion.dest_eq(bod), ss, I]
                  ~catch exn:
                    match exn
                    | Failure(_):
                        let [cxt, deq] = Basics.dest_imp(bod)
                        [Fusion.dest_eq(deq), AUGMENT_SIMPSET(Fusion.ASSUME(cxt))(ss), Bool.DISCH(cxt)]
                    | exn: Host.hol_raise(exn)
              let [eth, triv_prime]:
                try:
                  [strat(ss_prime)(lev)(t), #false]
                  ~catch exn:
                    match exn
                    | Failure(_): [Fusion.REFL(t), triv]
                    | exn: Host.hol_raise(exn)
              let eth_prime = Bool.GENL(avs)(mk_fun(eth))
              let th_prime = (if Fusion.is_var(t_prime) | Fusion.INST(PairList.cons([Fusion.rand(Fusion.concl(eth)), t_prime], PairList []))(th) | Drule.GEN_PART_MATCH(Equal.lhand)(th)(Fusion.concl(eth_prime)))
              let th_prime_prime = Bool.MP(th_prime)(eth_prime)
              RUN_SUB_CONV(strat)(ss)(lev)(triv_prime)(th_prime_prime)
            | (if triv | Host.hol_apply_unit(fail) | th)
  let GEN_SUB_CONV:
    fun(strat):
      fun(ss):
        fun(lev):
          fun(pconvs):
            fun(tm):
              try:
                tryfind(
                  fun([n, cnv]):
                    if Host.hol_lt(n)(4)
                    | Host.hol_apply_unit(fail)
                    | let th = cnv(tm)
                      RUN_SUB_CONV(strat)(ss)(lev)(#true)(th))(pconvs)
                ~catch exn:
                  match exn
                  | Failure(_):
                      if Fusion.is_comb(tm)
                      | let [l, r] = Fusion.dest_comb(tm)
                        try:
                          let th1 = strat(ss)(lev)(l)
                          try:
                            let th2 = strat(ss)(lev)(r)
                            Fusion.MK_COMB([th1, th2])
                            ~catch exn:
                              match exn
                              | Failure(_): Equal.AP_THM(th1)(r)
                              | exn: Host.hol_raise(exn)
                          ~catch exn:
                            match exn
                            | Failure(_): Equal.AP_TERM(l)(strat(ss)(lev)(r))
                            | exn: Host.hol_raise(exn)
                      | if Fusion.is_abs(tm)
                        | let [v, bod] = Fusion.dest_abs(tm)
                          let th = strat(ss)(lev)(bod)
                          try:
                            Fusion.ABS(v)(th)
                            ~catch exn:
                              match exn
                              | Failure(_):
                                  let gv = Basics.genvar(Fusion.type_of(v))
                                  let gbod = Fusion.vsubst(PairList.cons([gv, v], PairList []))(bod)
                                  let gth = Fusion.ABS(gv)(strat(ss)(lev)(gbod))
                                  let gtm = Fusion.concl(gth)
                                  let [l, r] = Fusion.dest_eq(gtm)
                                  let v_prime = Fusion.variant(Fusion.frees(gtm))(v)
                                  let l_prime_2 = Basics.alpha(v_prime)(l)
                                  let r_prime_2 = Basics.alpha(v_prime)(r)
                                  Fusion.EQ_MP(Equal.ALPHA(gtm)(Fusion.mk_eq([l_prime_2, r_prime_2])))(gth)
                              | exn: Host.hol_raise(exn)
                        | failwith("GEN_SUB_CONV")
                  | exn: Host.hol_raise(exn)
