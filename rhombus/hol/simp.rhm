            ~catch exn:
              match exn
              | Failure(_): GEN_SUB_CONV(TOP_DEPTH_SQCONV)(ss)(lev)(pconvs)(tm)
              | exn: Host.hol_raise(exn)
        try:
          let th2 = TOP_DEPTH_SQCONV(ss)(lev)(Fusion.rand(Fusion.concl(th1)))
          Fusion.TRANS(th1)(th2)
          ~catch exn:
            match exn
            | Failure(_): th1
            | exn: Host.hol_raise(exn)
  fun TOP_SWEEP_SQCONV(simp_ctor_Simpset(net,prover,provers,rewmaker) as ss):
    fun(lev):
      fun(tm):
        let pconvs = Nets.lookup(tm)(net)
        try:
          let th1 = IMP_REWRITES_CONV(TOP_SWEEP_SQCONV)(ss)(lev)(pconvs)(tm)
          try:
            let th2 = TOP_SWEEP_SQCONV(ss)(lev)(Fusion.rand(Fusion.concl(th1)))
            Fusion.TRANS(th1)(th2)
            ~catch exn:
              match exn
              | Failure(_): th1
              | exn: Host.hol_raise(exn)
          ~catch exn:
            match exn
            | Failure(_): GEN_SUB_CONV(TOP_SWEEP_SQCONV)(ss)(lev)(pconvs)(tm)
            | exn: Host.hol_raise(exn)
  [ONCE_DEPTH_SQCONV, DEPTH_SQCONV, REDEPTH_SQCONV, TOP_DEPTH_SQCONV, TOP_SWEEP_SQCONV]

def [set_basic_rewrites, extend_basic_rewrites, basic_rewrites, set_basic_convs, extend_basic_convs, basic_convs, basic_net]:
  let rewrites_2 = Box(PairList [])
  let conversions_2 = Box(PairList [])
  let conv_net_2 = Box(Nets.empty_net)
  let rehash_convnet = (fun(_): Host.ref_set(conv_net_2)(itlist(net_of_thm(#true))(Host.ref_get(rewrites_2))(itlist((fun([_, [pat, cnv]]): net_of_conv(pat)(cnv)))(Host.ref_get(conversions_2))(Nets.empty_net))))
  let set_basic_rewrites_2:
    fun(thl):
      let canon_thl = itlist(mk_rewrites(#false))(thl)(PairList [])
      Host.ref_set(rewrites_2)(canon_thl)
      Host.hol_apply_unit(rehash_convnet)
  let extend_basic_rewrites_2:
    fun(thl):
      let canon_thl = itlist(mk_rewrites(#false))(thl)(PairList [])
      Host.ref_set(rewrites_2)(append(canon_thl)(Host.ref_get(rewrites_2)))
      Host.hol_apply_unit(rehash_convnet)
  let basic_rewrites_2 = (fun(_): Host.ref_get(rewrites_2))
  let set_basic_convs_2:
    fun(cnvs):
      Host.ref_set(conversions_2)(cnvs)
      Host.hol_apply_unit(rehash_convnet)
  let extend_basic_convs_2:
    fun([name, patcong]):
      Host.ref_set(conversions_2)(PairList.cons([name, patcong], filter((fun([name_prime, _]): Host.hol_unequal(name)(name_prime)))(Host.ref_get(conversions_2))))
      Host.hol_apply_unit(rehash_convnet)
  let basic_convs_2 = (fun(_): Host.ref_get(conversions_2))
  let basic_net_2 = (fun(_): Host.ref_get(conv_net_2))
  [set_basic_rewrites_2, extend_basic_rewrites_2, basic_rewrites_2, set_basic_convs_2, extend_basic_convs_2, basic_convs_2, basic_net_2]

def [set_basic_congs, extend_basic_congs, basic_congs]:
  let congs = Box(PairList [])
  [(fun(thl): Host.ref_set(congs)(thl)), (fun(thl): Host.ref_set(congs)(Host.union_prime(Fusion.equals_thm)(thl)(Host.ref_get(congs)))), (fun(_): Host.ref_get(congs))]

fun GENERAL_REWRITE_CONV(rep):
  fun(cnvl):
    fun(builtin_net):
      fun(thl):
        let thl_canon = itlist(mk_rewrites(#false))(thl)(PairList [])
        let final_net = itlist(net_of_thm(rep))(thl_canon)(builtin_net)
        cnvl(REWRITES_CONV(final_net))

fun GEN_REWRITE_CONV(cnvl): (fun(thl): GENERAL_REWRITE_CONV(#false)(cnvl)(Nets.empty_net)(thl))

fun PURE_REWRITE_CONV(thl): GENERAL_REWRITE_CONV(#true)(Equal.TOP_DEPTH_CONV)(Nets.empty_net)(thl)

fun REWRITE_CONV(thl): GENERAL_REWRITE_CONV(#true)(Equal.TOP_DEPTH_CONV)(Host.hol_apply_unit(basic_net))(thl)

fun PURE_ONCE_REWRITE_CONV(thl): GENERAL_REWRITE_CONV(#false)(Equal.ONCE_DEPTH_CONV)(Nets.empty_net)(thl)

fun ONCE_REWRITE_CONV(thl): GENERAL_REWRITE_CONV(#false)(Equal.ONCE_DEPTH_CONV)(Host.hol_apply_unit(basic_net))(thl)

fun GEN_REWRITE_RULE(cnvl): (fun(thl): Equal.CONV_RULE(GEN_REWRITE_CONV(cnvl)(thl)))

fun PURE_REWRITE_RULE(thl): Equal.CONV_RULE(PURE_REWRITE_CONV(thl))

fun REWRITE_RULE(thl): Equal.CONV_RULE(REWRITE_CONV(thl))

fun PURE_ONCE_REWRITE_RULE(thl): Equal.CONV_RULE(PURE_ONCE_REWRITE_CONV(thl))

fun ONCE_REWRITE_RULE(thl): Equal.CONV_RULE(ONCE_REWRITE_CONV(thl))

fun PURE_ASM_REWRITE_RULE(thl): (fun(th): PURE_REWRITE_RULE(append(map(Fusion.ASSUME)(Fusion.hyp(th)))(thl))(th))

fun ASM_REWRITE_RULE(thl): (fun(th): REWRITE_RULE(append(map(Fusion.ASSUME)(Fusion.hyp(th)))(thl))(th))

fun PURE_ONCE_ASM_REWRITE_RULE(thl): (fun(th): PURE_ONCE_REWRITE_RULE(append(map(Fusion.ASSUME)(Fusion.hyp(th)))(thl))(th))

fun ONCE_ASM_REWRITE_RULE(thl): (fun(th): ONCE_REWRITE_RULE(append(map(Fusion.ASSUME)(Fusion.hyp(th)))(thl))(th))

fun GEN_REWRITE_TAC(cnvl): (fun(thl): Tactics.CONV_TAC(GEN_REWRITE_CONV(cnvl)(thl)))

fun PURE_REWRITE_TAC(thl): Tactics.CONV_TAC(PURE_REWRITE_CONV(thl))

fun REWRITE_TAC(thl): Tactics.CONV_TAC(REWRITE_CONV(thl))

fun PURE_ONCE_REWRITE_TAC(thl): Tactics.CONV_TAC(PURE_ONCE_REWRITE_CONV(thl))

fun ONCE_REWRITE_TAC(thl): Tactics.CONV_TAC(ONCE_REWRITE_CONV(thl))

def PURE_ASM_REWRITE_TAC = Tactics.ASM(PURE_REWRITE_TAC)

def ASM_REWRITE_TAC = Tactics.ASM(REWRITE_TAC)

def PURE_ONCE_ASM_REWRITE_TAC = Tactics.ASM(PURE_ONCE_REWRITE_TAC)

def ONCE_ASM_REWRITE_TAC = Tactics.ASM(ONCE_REWRITE_TAC)

fun GEN_SIMPLIFY_CONV(strat):
  fun(ss):
    fun(lev):
      fun(thl):
        let ss_prime = itlist(AUGMENT_SIMPSET)(thl)(ss)
        Equal.TRY_CONV(strat(ss_prime)(lev))

fun ONCE_SIMPLIFY_CONV(ss): GEN_SIMPLIFY_CONV(ONCE_DEPTH_SQCONV)(ss)(1)

fun SIMPLIFY_CONV(ss): GEN_SIMPLIFY_CONV(TOP_DEPTH_SQCONV)(ss)(3)

def empty_ss = simp_ctor_Simpset(Nets.empty_net, basic_prover, PairList [], mk_rewrites(#true))

def basic_ss:
  let rewmaker = mk_rewrites(#true)
  fun(thl):
    let cthms = itlist(rewmaker)(thl)(PairList [])
    let net_prime = itlist(net_of_thm(#true))(cthms)(Host.hol_apply_unit(basic_net))
    let net_prime_prime = itlist(net_of_cong)(Host.hol_apply_unit(basic_congs))(net_prime)
    simp_ctor_Simpset(net_prime_prime, basic_prover, PairList [], rewmaker)

fun SIMP_CONV(thl): SIMPLIFY_CONV(basic_ss(PairList []))(thl)

fun PURE_SIMP_CONV(thl): SIMPLIFY_CONV(empty_ss)(thl)

fun ONCE_SIMP_CONV(thl): ONCE_SIMPLIFY_CONV(basic_ss(PairList []))(thl)

fun SIMP_RULE(thl): Equal.CONV_RULE(SIMP_CONV(thl))

fun PURE_SIMP_RULE(thl): Equal.CONV_RULE(PURE_SIMP_CONV(thl))

fun ONCE_SIMP_RULE(thl): Equal.CONV_RULE(ONCE_SIMP_CONV(thl))

fun SIMP_TAC(thl): Tactics.CONV_TAC(SIMP_CONV(thl))

fun PURE_SIMP_TAC(thl): Tactics.CONV_TAC(PURE_SIMP_CONV(thl))

fun ONCE_SIMP_TAC(thl): Tactics.CONV_TAC(ONCE_SIMP_CONV(thl))

def ASM_SIMP_TAC = Tactics.ASM(SIMP_TAC)

def PURE_ASM_SIMP_TAC = Tactics.ASM(PURE_SIMP_TAC)

def ONCE_ASM_SIMP_TAC = Tactics.ASM(ONCE_SIMP_TAC)

fun ABBREV_TAC(tm):
  let [cvs, t] = Fusion.dest_eq(tm)
  let [v, vs] = Basics.strip_comb(cvs)
  let rs = Basics.list_mk_abs([vs, t])
  let eq = Fusion.mk_eq([rs, v])
  let th1 = itlist((fun(v): (fun(th): Equal.CONV_RULE(Equal.LAND_CONV(Equal.BETA_CONV))(Equal.AP_THM(th)(v)))))(Host.rev(vs))(Fusion.ASSUME(eq))
  let th2 = Bool.SIMPLE_CHOOSE(v)(Bool.SIMPLE_EXISTS(v)(Bool.GENL(vs)(th1)))
  let th3 = Bool.PROVE_HYP(Bool.EXISTS([Bool.mk_exists([v, eq]), rs])(Fusion.REFL(rs)))(th2)
  fun([asl, w] as gl):
    let avoids = itlist(o(o(o(union)(Fusion.frees))(Fusion.concl))(snd))(asl)(Fusion.frees(w))
    (if mem(v)(avoids) | failwith("ABBREV_TAC: variable already used") | Tactics.CHOOSE_THEN((fun(th): Tactics.THEN(Tactics.THEN(Tactics.RULE_ASSUM_TAC(PURE_ONCE_REWRITE_RULE(PairList.cons(th, PairList []))))(PURE_ONCE_REWRITE_TAC(PairList.cons(th, PairList []))))(Tactics.ASSUME_TAC(th))))(th3)(gl))

fun EXPAND_TAC(s): Tactics.THEN(Tactics.FIRST_ASSUM(o(o(Tactics.SUBST1_TAC)(Equal.SYM))(Host.check(o(o(o(o(Host.hol_equal(s))(fst))(Fusion.dest_var))(Equal.rhs))(Fusion.concl)))))(Tactics.BETA_TAC)
