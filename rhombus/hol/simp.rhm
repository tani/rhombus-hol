fun GEN_SIMPLIFY_CONV(strat):«
  (fun(ss):«
    (fun(lev):«
      (fun(thl):«
        (block:«
          let ss_prime:«
            itlist(AUGMENT_SIMPSET)(thl)(ss)
          »;
          Equal.TRY_CONV(strat(ss_prime)(lev))
        »)
      »)
    »)
  »)
»

fun ONCE_SIMPLIFY_CONV(ss):«
  GEN_SIMPLIFY_CONV(ONCE_DEPTH_SQCONV)(ss)(1)
»

fun SIMPLIFY_CONV(ss):«
  GEN_SIMPLIFY_CONV(TOP_DEPTH_SQCONV)(ss)(3)
»

def empty_ss:«
  simp_ctor_Simpset(Nets.empty_net,basic_prover,PairList [],mk_rewrites(#true))
»

def basic_ss:«
  (block:«
    let rewmaker:«
      mk_rewrites(#true)
    »;
    (fun(thl):«
      (block:«
        let cthms:«
          itlist(rewmaker)(thl)(PairList [])
        »;
        (block:«
          let net_prime:«
            (block:«
              let port_tmp_84 = Host.hol_apply_unit(basic_net);
              let port_tmp_85 = net_of_thm(#true);
              itlist(port_tmp_85)(cthms)(port_tmp_84)
            »)
          »;
          (block:«
            let net_prime_prime:«
              itlist(net_of_cong)(Host.hol_apply_unit(basic_congs))(net_prime)
            »;
            simp_ctor_Simpset(net_prime_prime,basic_prover,PairList [],rewmaker)
          »)
        »)
      »)
    »)
  »)
»

fun SIMP_CONV(thl):«
  SIMPLIFY_CONV(basic_ss(PairList []))(thl)
»

fun PURE_SIMP_CONV(thl):«
  SIMPLIFY_CONV(empty_ss)(thl)
»

fun ONCE_SIMP_CONV(thl):«
  ONCE_SIMPLIFY_CONV(basic_ss(PairList []))(thl)
»

fun SIMP_RULE(thl):«
