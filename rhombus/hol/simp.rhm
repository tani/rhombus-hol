def simp_REWR_CONV:«
  Up_drule.PART_MATCH(Up_equal.lhs)
»

def simp_IMP_REWR_CONV:«
  Up_drule.PART_MATCH((block:«
    let port_tmp_1 = Up_basics.dest_imp;
    let port_tmp_2 = o(Up_equal.lhs)(snd);
    let port_tmp_3 = o;
    port_tmp_3(port_tmp_2)(port_tmp_1)
  »))
»

