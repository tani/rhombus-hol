          let tm1 = Fusion.rand(Fusion.concl(th1))
          let pconvs1 = Nets.lookup(tm1)(net)
          try:
            Fusion.TRANS(th1)(IMP_REWRITES_CONV(DEPTH_SQCONV)(ss)(lev)(pconvs1)(tm1))
            ~catch exn:
