fun ABBREV_TAC(tm):
  let [cvs, t] = Fusion.dest_eq(tm)
  let [v, vs] = Basics.strip_comb(cvs)
  let rs = Basics.list_mk_abs([vs, t])
  let eq = Fusion.mk_eq([rs, v])
  let port_tmp_132 = Fusion.ASSUME(eq)
  let port_tmp_133 = Host.rev(vs)
  fun port_tmp_131(v):
    fun port_tmp_130(th):
      let port_tmp_128 = Equal.AP_THM(th)(v)
      let port_tmp_129 = Equal.LAND_CONV(Equal.BETA_CONV)
      Equal.CONV_RULE(port_tmp_129)(port_tmp_128)
    port_tmp_130
  let th1 = itlist(port_tmp_131)(port_tmp_133)(port_tmp_132)
  let th2 = Bool.SIMPLE_CHOOSE(v)(Bool.SIMPLE_EXISTS(v)(Bool.GENL(vs)(th1)))
  let port_tmp_134 = Fusion.REFL(rs)
  let port_tmp_135 = [Bool.mk_exists([v, eq]), rs]
  let th3 = Bool.PROVE_HYP(Bool.EXISTS(port_tmp_135)(port_tmp_134))(th2)
  fun port_tmp_143([asl, w] as gl):
    let port_tmp_136 = Fusion.frees(w)
    let port_tmp_137 = o(o(o(union)(Fusion.frees))(Fusion.concl))(snd)
    let avoids = itlist(port_tmp_137)(asl)(port_tmp_136)
    if mem(v)(avoids)
    | failwith("ABBREV_TAC: variable already used")
    | fun port_tmp_142(th):
        let port_tmp_140 = Tactics.ASSUME_TAC(th)
        let port_tmp_138 = PURE_ONCE_REWRITE_TAC(PairList.cons(th,PairList []))
        let port_tmp_139 = Tactics.RULE_ASSUM_TAC(PURE_ONCE_REWRITE_RULE(PairList.cons(th,PairList [])))
        let port_tmp_141 = Tactics.THEN(port_tmp_139)(port_tmp_138)
        Tactics.THEN(port_tmp_141)(port_tmp_140)
      Tactics.CHOOSE_THEN(port_tmp_142)(th3)(gl)
  port_tmp_143

fun EXPAND_TAC(s):
  let port_tmp_144 = Host.check(o(o(o(o(Host.hol_equal(s))(fst))(Fusion.dest_var))(Equal.rhs))(Fusion.concl))
  let port_tmp_145 = o(Tactics.SUBST1_TAC)(Equal.SYM)
  Tactics.THEN(Tactics.FIRST_ASSUM(o(port_tmp_145)(port_tmp_144)))(Tactics.BETA_TAC)
