fun ABBREV_TAC(tm):«
  (block:«
    let [cvs, t]:«
      Fusion.dest_eq(tm)
    »;
    (block:«
      let [v, vs]:«
        Basics.strip_comb(cvs)
      »;
      (block:«
        let rs:«
          Basics.list_mk_abs([vs, t])
        »;
        (block:«
          let eq:«
            Fusion.mk_eq([rs, v])
          »;
          (block:«
            let th1:«
              (block:«
                let port_tmp_86 = Fusion.ASSUME(eq);
                let port_tmp_87 = Host.rev(vs);
                itlist((fun(v):«
                  (fun(th):«
                    (block:«
                      let port_tmp_88 = Equal.AP_THM(th)(v);
                      let port_tmp_89 = Equal.LAND_CONV(Equal.BETA_CONV);
                      Equal.CONV_RULE(port_tmp_89)(port_tmp_88)
                    »)
                  »)
                »))(port_tmp_87)(port_tmp_86)
              »)
            »;
            (block:«
              let th2:«
                Bool.SIMPLE_CHOOSE(v)(Bool.SIMPLE_EXISTS(v)(Bool.GENL(vs)(th1)))
              »;
              (block:«
                let th3:«
                  Bool.PROVE_HYP((block:«
                    let port_tmp_90 = Fusion.REFL(rs);
                    let port_tmp_91 = [Bool.mk_exists([v, eq]), rs];
                    Bool.EXISTS(port_tmp_91)(port_tmp_90)
                  »))(th2)
                »;
                (fun([asl, w] as gl):«
                  (block:«
                    let avoids:«
                      (block:«
                        let port_tmp_92 = Fusion.frees(w);
                        let port_tmp_93 = o(o(o(union)(Fusion.frees))(Fusion.concl))(snd);
                        itlist(port_tmp_93)(asl)(port_tmp_92)
                      »)
                    »;
                    (block:«
                      if mem(v)(avoids)
                      | failwith("ABBREV_TAC: variable already used")
                      | Tactics.CHOOSE_THEN((fun(th):«
                        (block:«
                          let port_tmp_94 = Tactics.ASSUME_TAC(th);
                          let port_tmp_95 = (block:«
                            let port_tmp_96 = PURE_ONCE_REWRITE_TAC(PairList.cons(th,PairList []));
                            let port_tmp_97 = Tactics.RULE_ASSUM_TAC(PURE_ONCE_REWRITE_RULE(PairList.cons(th,PairList [])));
                            Tactics.THEN(port_tmp_97)(port_tmp_96)
                          »);
                          Tactics.THEN(port_tmp_95)(port_tmp_94)
                        »)
                      »))(th3)(gl)
                    »)
                  »)
                »)
              »)
            »)
          »)
        »)
      »)
    »)
  »)
»

fun EXPAND_TAC(s):«
  Tactics.THEN(Tactics.FIRST_ASSUM((block:«
    let port_tmp_98 = Host.check(o(o(o(o(Host.hol_equal(s))(fst))(Fusion.dest_var))(Equal.rhs))(Fusion.concl));
    let port_tmp_99 = o(Tactics.SUBST1_TAC)(Equal.SYM);
    o(port_tmp_99)(port_tmp_98)
  »)))(Tactics.BETA_TAC)
»
