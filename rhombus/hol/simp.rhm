        »)
      »)
    »;
    (block:«
      fun port_tmp_19_dyn_order(top):«
        (fun(tm1):«
          (fun(tm2):«
            (block:«
              let Pair(port_tmp_20_f1,port_tmp_21_args1):«
                Up_basics.strip_comb(tm1)
              »;
              let Pair(port_tmp_22_f2,port_tmp_23_args2):«
                Up_basics.strip_comb(tm2)
              »;
              (block:«
                if Host.hol_equal(port_tmp_20_f1)(port_tmp_22_f2)
                | (block:«
                  let port_tmp_24 = port_tmp_23_args2;
                  let port_tmp_25 = port_tmp_21_args1;
                  let port_tmp_26 = port_tmp_19_dyn_order(port_tmp_20_f1);
                  let port_tmp_27 = port_tmp_12_lexify;
                  port_tmp_27(port_tmp_26)(port_tmp_25)(port_tmp_24)
                »)
                | (block:«
                  if Host.hol_equal(port_tmp_22_f2)(top)
                  | #false
                  | (block:«
                    if Host.hol_equal(port_tmp_20_f1)(top)
                    | #true
                    | Host.hol_gt(port_tmp_20_f1)(port_tmp_22_f2)
                  »)
                »)
              »)
            »)
          »)
        »)
      »;
