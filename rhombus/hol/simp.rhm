def simp_REWR_CONV:«
  Up_drule.PART_MATCH(Up_equal.lhs)
»

def simp_IMP_REWR_CONV:«
  Up_drule.PART_MATCH(o(o(Up_equal.lhs)(snd))(Up_basics.dest_imp))
»

fun simp_ORDERED_REWR_CONV(ord):«
  (fun(th):«
    (block:«
      let basic_conv:«
        simp_REWR_CONV(th)
      »;
      (fun(tm):«
        (block:«
          let thm:«
            basic_conv(tm)
          »;
          (block:«
            let Pair(l,r):«
              Up_fusion.dest_eq(Up_fusion.concl(thm))
            »;
            (block:«
              if ord(l)(r)
              | thm
              | failwith("ORDERED_REWR_CONV: wrong orientation")
            »)
          »)
        »)
      »)
    »)
  »)
»

fun simp_ORDERED_IMP_REWR_CONV(ord):«
  (fun(th):«
    (block:«
      let basic_conv:«
        simp_IMP_REWR_CONV(th)
      »;
      (fun(tm):«
        (block:«
          let thm:«
            basic_conv(tm)
          »;
          (block:«
            let Pair(l,r):«
              Up_fusion.dest_eq(Up_fusion.rand(Up_fusion.concl(thm)))
            »;
            (block:«
              if ord(l)(r)
              | thm
              | failwith("ORDERED_IMP_REWR_CONV: wrong orientation")
            »)
          »)
        »)
      »)
    »)
  »)
»

def simp_term_order:«
  (block:«
    fun lexify(ord):«
      (fun(l1):«
        (fun(l2):«
          (block:«
            if Host.hol_equal(l1)(PairList [])
            | #false
            | (block:«
              if Host.hol_equal(l2)(PairList [])
              | #true
              | (block:«
                let port_tmp_1_h1:«
                  hd(l1)
                »;
                let port_tmp_2_h2:«
                  hd(l2)
                »;
                (ord(port_tmp_1_h1)(port_tmp_2_h2) || (Host.hol_equal(port_tmp_1_h1)(port_tmp_2_h2) && (block:«
                  let port_tmp_3 = tl(l2);
                  let port_tmp_4 = tl(l1);
                  lexify(ord)(port_tmp_4)(port_tmp_3)
                »)))
              »)
            »)
          »)
        »)
      »)
    »;
    (block:«
      fun dyn_order(top):«
        (fun(tm1):«
          (fun(tm2):«
            (block:«
              let Pair(port_tmp_5_f1,port_tmp_6_args1):«
                Up_basics.strip_comb(tm1)
              »;
              let Pair(port_tmp_7_f2,port_tmp_8_args2):«
                Up_basics.strip_comb(tm2)
              »;
              (block:«
                if Host.hol_equal(port_tmp_5_f1)(port_tmp_7_f2)
                | lexify(dyn_order(port_tmp_5_f1))(port_tmp_6_args1)(port_tmp_8_args2)
                | (block:«
                  if Host.hol_equal(port_tmp_7_f2)(top)
                  | #false
                  | (block:«
                    if Host.hol_equal(port_tmp_5_f1)(top)
                    | #true
                    | Host.hol_gt(port_tmp_5_f1)(port_tmp_7_f2)
                  »)
                »)
              »)
            »)
          »)
        »)
      »;
      dyn_order(Host.expand_quote("[\"Const\",\"T\",[\"Tyapp\",\"bool\",[]]]"))
    »)
  »)
»

fun simp_net_of_thm(rep):«
  (fun(th):«
    (block:«
      let tm:«
        Up_fusion.concl(th)
      »;
      (block:«
        let lconsts:«
          Up_fusion.freesl(Up_fusion.hyp(th))
        »;
        (block:«
          let matchable:«
            o(can)(Up_drule.term_match(lconsts))
          »;
          (block:«
            let port_tmp_9 = tm;
            match port_tmp_9
            | Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("=",_),Up_fusion.Abs(x,Up_fusion.Comb(Up_fusion.Var(s,ty) as v,x_prime)) as l),v_prime):«
                if (Host.hol_equal(x_prime)(x) && (Host.hol_equal(v_prime)(v) && Host.hol_not(Host.hol_equal(x)(v))))
                | (block:«
                  let conv:«
                    (fun(tm):«
                      (block:«
                        let port_tmp_10 = tm;
                        match port_tmp_10
                        | Up_fusion.Abs(y,Up_fusion.Comb(t,y_prime)):«
                            if (Host.hol_equal(y)(y_prime) && Host.hol_not(Up_basics.free_in(y)(t)))
                            | Up_drule.INSTANTIATE(Up_drule.term_match(PairList [])(v)(t))(th)
                            | (block:«
                              let port_tmp_11 = port_tmp_10;
                              match port_tmp_11
                              | _:«
                                  failwith("REWR_CONV (ETA_AX special case)")
                              »
                            »)
                        »
                        | _:«
                            failwith("REWR_CONV (ETA_AX special case)")
                        »
                      »)
                    »)
                  »;
                  Up_nets.enter(lconsts)(Pair(l,Pair(1,conv)))
                »)
                | (block:«
                  let port_tmp_12 = port_tmp_9;
                  match port_tmp_12
                  | Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("=",_),l),r):«
                      (block:«
                        if (rep && Up_basics.free_in(l)(r))
                        | (block:«
                          let th_prime:«
                            Up_bool.EQT_INTRO(th)
                          »;
                          Up_nets.enter(lconsts)(Pair(l,Pair(1,simp_REWR_CONV(th_prime))))
                        »)
                        | (block:«
                          if (rep && (matchable(l)(r) && matchable(r)(l)))
                          | Up_nets.enter(lconsts)(Pair(l,Pair(1,simp_ORDERED_REWR_CONV(simp_term_order)(th))))
                          | Up_nets.enter(lconsts)(Pair(l,Pair(1,simp_REWR_CONV(th))))
                        »)
                      »)
                  »
                  | Up_fusion.Comb(Up_fusion.Comb(_,t),Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("=",_),l),r)):«
                      (block:«
                        if (rep && Up_basics.free_in(l)(r))
                        | (block:«
                          let th_prime:«
                            Up_bool.DISCH(t)(Up_bool.EQT_INTRO(Up_bool.UNDISCH(th)))
                          »;
                          Up_nets.enter(lconsts)(Pair(l,Pair(3,simp_IMP_REWR_CONV(th_prime))))
                        »)
                        | (block:«
                          if (rep && (matchable(l)(r) && matchable(r)(l)))
                          | Up_nets.enter(lconsts)(Pair(l,Pair(3,simp_ORDERED_IMP_REWR_CONV(simp_term_order)(th))))
                          | Up_nets.enter(lconsts)(Pair(l,Pair(3,simp_IMP_REWR_CONV(th))))
                        »)
                      »)
                  »
                »)
            »
            | Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("=",_),l),r):«
                (block:«
                  if (rep && Up_basics.free_in(l)(r))
                  | (block:«
                    let th_prime:«
                      Up_bool.EQT_INTRO(th)
                    »;
                    Up_nets.enter(lconsts)(Pair(l,Pair(1,simp_REWR_CONV(th_prime))))
                  »)
                  | (block:«
                    if (rep && (matchable(l)(r) && matchable(r)(l)))
                    | Up_nets.enter(lconsts)(Pair(l,Pair(1,simp_ORDERED_REWR_CONV(simp_term_order)(th))))
                    | Up_nets.enter(lconsts)(Pair(l,Pair(1,simp_REWR_CONV(th))))
                  »)
                »)
            »
            | Up_fusion.Comb(Up_fusion.Comb(_,t),Up_fusion.Comb(Up_fusion.Comb(Up_fusion.Const("=",_),l),r)):«
                (block:«
                  if (rep && Up_basics.free_in(l)(r))
                  | (block:«
                    let th_prime:«
                      Up_bool.DISCH(t)(Up_bool.EQT_INTRO(Up_bool.UNDISCH(th)))
                    »;
                    Up_nets.enter(lconsts)(Pair(l,Pair(3,simp_IMP_REWR_CONV(th_prime))))
                  »)
                  | (block:«
                    if (rep && (matchable(l)(r) && matchable(r)(l)))
                    | Up_nets.enter(lconsts)(Pair(l,Pair(3,simp_ORDERED_IMP_REWR_CONV(simp_term_order)(th))))
                    | Up_nets.enter(lconsts)(Pair(l,Pair(3,simp_IMP_REWR_CONV(th))))
                  »)
                »)
            »
          »)
        »)
      »)
    »)
  »)
»

fun simp_net_of_conv(tm):«
  (fun(conv):«
    (fun(sofar):«
      Up_nets.enter(PairList [])(Pair(tm,Pair(2,conv)))(sofar)
    »)
  »)
»

fun simp_net_of_cong(th):«
  (fun(sofar):«
    (block:«
      let Pair(conc,n):«
        Host.repeat((fun(Pair(tm,m)):«
          (block:«
            let port_tmp_13 = Host.hol_add(m)(1);
            let port_tmp_14 = snd(Up_basics.dest_imp(tm));
            Pair(port_tmp_14,port_tmp_13)
          »)
        »))(Pair(Up_fusion.concl(th),0))
      »;
      (block:«
        if Host.hol_equal(n)(0)
        | failwith("net_of_cong: Non-implicational congruence")
        | (block:«
          let pat:«
            Up_equal.lhs(conc)
          »;
          (block:«
            let conv:«
              Up_drule.GEN_PART_MATCH(o(Up_equal.lhand)(Host.funpow(n)(Up_fusion.rand)))(th)
            »;
            Up_nets.enter(PairList [])(Pair(pat,Pair(4,conv)))(sofar)
          »)
        »)
      »)
    »)
  »)
»

def simp_mk_rewrites:«
  (block:«
    let port_tmp_15_IMP_CONJ_CONV:«
      simp_REWR_CONV(Up_itab.ITAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"q\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"r\",[\"Tyapp\",\"bool\",[]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"q\",[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"r\",[\"Tyapp\",\"bool\",[]]]]]")))
    »;
    let port_tmp_16_IMP_EXISTS_RULE:«
      (block:«
        let cnv:«
          simp_REWR_CONV(Up_itab.ITAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?328\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"?328\"]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?328\"],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyvar\",\"?328\"]]]],[\"Var\",\"Q\",[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"?\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?328\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"?328\"]],[\"Comb\",[\"Var\",\"P\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"?328\"],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"x\",[\"Tyvar\",\"?328\"]]]]]],[\"Var\",\"Q\",[\"Tyapp\",\"bool\",[]]]]]")))
        »;
        (fun(v):«
          (fun(th):«
            Up_equal.CONV_RULE(cnv)(Up_bool.GEN(v)(th))
          »)
        »)
      »)
    »;
    (block:«
      let collect_condition:«
        (fun(oldhyps):«
          (fun(th):«
            (block:«
              let conds:«
                subtract(Up_fusion.hyp(th))(oldhyps)
              »;
              (block:«
                if Host.hol_equal(conds)(PairList [])
                | th
                | (block:«
                  let jth:«
                    itlist(Up_bool.DISCH)(conds)(th)
                  »;
                  (block:«
                    let kth:«
                      Up_equal.CONV_RULE(Up_equal.REPEATC(port_tmp_15_IMP_CONJ_CONV))(jth)
                    »;
                    (block:«
                      let Pair(port_tmp_17_hol_cond,eqn):«
                        Up_basics.dest_imp(Up_fusion.concl(kth))
                      »;
                      (block:«
                        let fvs:«
                          (block:«
                            let port_tmp_18 = Up_fusion.freesl(oldhyps);
                            let port_tmp_19 = (block:«
                              let port_tmp_20 = Up_fusion.frees(eqn);
                              let port_tmp_21 = Up_fusion.frees(port_tmp_17_hol_cond);
                              subtract(port_tmp_21)(port_tmp_20)
                            »);
                            subtract(port_tmp_19)(port_tmp_18)
                          »)
                        »;
                        itlist(port_tmp_16_IMP_EXISTS_RULE)(fvs)(kth)
                      »)
                    »)
                  »)
                »)
              »)
            »)
          »)
        »)
      »;
      (block:«
        fun split_rewrites(oldhyps):«
          (fun(cf):«
            (fun(th):«
              (fun(sofar):«
                (block:«
                  let tm:«
                    Up_fusion.concl(th)
                  »;
                  (block:«
                    if Up_basics.is_forall(tm)
                    | split_rewrites(oldhyps)(cf)(Up_bool.SPEC_ALL(th))(sofar)
                    | (block:«
                      if Up_basics.is_conj(tm)
                      | (block:«
                        let port_tmp_22 = split_rewrites(oldhyps)(cf)(Up_bool.CONJUNCT2(th))(sofar);
                        let port_tmp_23 = Up_bool.CONJUNCT1(th);
                        split_rewrites(oldhyps)(cf)(port_tmp_23)(port_tmp_22)
                      »)
                      | (block:«
                        if (Up_basics.is_imp(tm) && cf)
                        | split_rewrites(oldhyps)(cf)(Up_bool.UNDISCH(th))(sofar)
                        | (block:«
                          if Up_fusion.is_eq(tm)
                          | PairList.cons((block:«
                            if cf
                            | collect_condition(oldhyps)(th)
                            | th
                          »),sofar)
                          | (block:«
                            if Up_basics.is_neg(tm)
                            | (block:«
                              let ths:«
                                split_rewrites(oldhyps)(cf)(Up_bool.EQF_INTRO(th))(sofar)
                              »;
                              (block:«
                                if Up_fusion.is_eq(Up_fusion.rand(tm))
                                | split_rewrites(oldhyps)(cf)(Up_bool.EQF_INTRO(Up_equal.GSYM(th)))(ths)
                                | ths
                              »)
                            »)
                            | split_rewrites(oldhyps)(cf)(Up_bool.EQT_INTRO(th))(sofar)
                          »)
                        »)
                      »)
                    »)
                  »)
                »)
              »)
            »)
          »)
        »;
        (fun(cf):«
          (fun(th):«
            (fun(sofar):«
              split_rewrites(Up_fusion.hyp(th))(cf)(th)(sofar)
            »)
          »)
        »)
      »)
    »)
  »)
»

fun simp_REWRITES_CONV(net):«
  (fun(tm):«
    (block:«
      let pconvs:«
        Up_nets.lookup(tm)(net)
      »;
      (block:«
        try:«
          tryfind((fun(Pair(_,cnv)):«
            cnv(tm)
          »))(pconvs);
          ~catch port_tmp_24:«
            let port_tmp_25 = port_tmp_24;
            match port_tmp_25
            | Failure(_):«
                failwith("REWRITES_CONV")
            »
            | port_tmp_24:«
                Host.hol_raise(port_tmp_24)
            »
          »
        »
      »)
    »)
  »)
»

class simp_ctor_Prover(conv,augmentor):«
  extends Host.HolVariant;
  override port_view(): Pair(1,Pair(0,PairList [this.conv,this.augmentor]))
»

fun simp_mk_prover(applicator):«
  (fun(augmentor):«
    (block:«
      fun mk_prover(state):«
        (block:«
          let port_tmp_26_apply:«
            applicator(state)
          »;
          let port_tmp_27_augment:«
            (fun(thms):«
              mk_prover(augmentor(state)(thms))
            »)
          »;
          simp_ctor_Prover(port_tmp_26_apply,port_tmp_27_augment)
        »)
      »;
      mk_prover
    »)
  »)
»

fun simp_augment(simp_ctor_Prover(_,aug)):«
  (fun(thms):«
    aug(thms)
  »)
»

fun simp_apply_prover(simp_ctor_Prover(conv,_)):«
  (fun(tm):«
    conv(tm)
  »)
»

class simp_ctor_Simpset(net,prover,provers,rewmaker):«
  extends Host.HolVariant;
  override port_view(): Pair(1,Pair(0,PairList [this.net,this.prover,this.provers,this.rewmaker]))
»

fun simp_basic_prover(strat):«
  (fun(simp_ctor_Simpset(net,prover,provers,rewmaker) as ss):«
    (fun(lev):«
      (fun(tm):«
        (block:«
          let sth:«
            (block:«
              try:«
                strat(ss)(lev)(tm);
                ~catch port_tmp_28:«
                  let port_tmp_29 = port_tmp_28;
                  match port_tmp_29
                  | Failure(_):«
                      Up_fusion.REFL(tm)
                  »
                  | port_tmp_28:«
                      Host.hol_raise(port_tmp_28)
                  »
                »
              »
            »)
          »;
          (block:«
            try:«
              Up_bool.EQT_ELIM(sth);
              ~catch port_tmp_30:«
                let port_tmp_31 = port_tmp_30;
                match port_tmp_31
                | Failure(_):«
                    (block:«
                      let tth:«
                        tryfind((fun(pr):«
                          simp_apply_prover(pr)(Up_fusion.rand(Up_fusion.concl(sth)))
                        »))(provers)
                      »;
                      Up_fusion.EQ_MP(Up_equal.SYM(sth))(tth)
                    »)
                »
                | port_tmp_30:«
                    Host.hol_raise(port_tmp_30)
                »
              »
            »
          »)
        »)
      »)
    »)
  »)
»

fun simp_ss_of_thms(thms):«
  (fun(simp_ctor_Simpset(net,prover,provers,rewmaker)):«
    (block:«
      let cthms:«
        itlist(rewmaker)(thms)(PairList [])
      »;
      (block:«
        let net_prime:«
          itlist(simp_net_of_thm(#true))(cthms)(net)
        »;
        simp_ctor_Simpset(net_prime,prover,provers,rewmaker)
      »)
    »)
  »)
»

fun simp_ss_of_conv(keytm):«
  (fun(conv):«
    (fun(simp_ctor_Simpset(net,prover,provers,rewmaker)):«
      (block:«
        let net_prime:«
