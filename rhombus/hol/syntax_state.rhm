#lang rhombus
// Shared mutable syntax/interface tables factored from HOL Light printer.ml
// and preterm.ml to break their OCaml load-order cycle.
import: "compat.rhm" open
import: "fusion.rhm" open

export:
  isspace
  issep
  isbra
  issymb
  isalpha
  isnum
  isalnum
  reserve_words
  unreserve_words
  is_reserved_word
  reserved_words
  unparse_as_binder
  parse_as_binder
  parses_as_binder
  binders
  unparse_as_prefix
  parse_as_prefix
  is_prefix
  prefixes
  unparse_as_infix
  parse_as_infix
  get_infix_status
  infixes
  the_interface
  the_overload_skeletons
  reverse_interface_mapping
  unspaced_binops
  prebroken_binops
  print_unambiguous_comprehensions
  typify_universal_set
  print_all_thm
  print_types_of_subterms

fun member_char(chars :: String):
  fun(s :: String): chars.contains(s)

def isspace = member_char(" \t\n\r")
def issep = member_char(",;")
def isbra = member_char("()[]{}")
def issymb = member_char("\\!@#$%^&*-+|<=>/?~.:")
def isalpha = member_char("'abcdefghijklmnopqrstuvwxyz_ABCDEFGHIJKLMNOPQRSTUVWXYZ")
def isnum = member_char("0123456789")
fun isalnum(s): isalpha(s) || isnum(s)

def mutable reswords = PairList [
  "(",")","[","]","{","}",":",";",".","|",
  "let","in","and","if","then","else","match","with","function","->","when"
]
fun reserve_words(ns): reswords := union(reswords)(ns)
fun unreserve_words(ns): reswords := subtract(reswords)(ns)
fun is_reserved_word(n): mem(n)(reswords)
fun reserved_words(): reswords

def mutable binder_list = PairList []
fun unparse_as_binder(n): binder_list := subtract(binder_list)(PairList [n])
fun parse_as_binder(n): binder_list := union(binder_list)(PairList [n])
fun parses_as_binder(n): mem(n)(binder_list)
fun binders(): binder_list

def mutable prefix_list = PairList []
fun unparse_as_prefix(n): prefix_list := subtract(prefix_list)(PairList [n])
fun parse_as_prefix(n): prefix_list := union(prefix_list)(PairList [n])
fun is_prefix(n): mem(n)(prefix_list)
fun prefixes(): prefix_list

def mutable infix_list = PairList []
fun infix_cmp(Pair(s,Pair(x,a))):
  fun(Pair(t,Pair(y,b))):
    x < y || (x == y && a > b) || (x == y && a == b && s < t)
fun unparse_as_infix(n):
  infix_list := filter(fun(Pair(k,_)): k != n)(infix_list)
fun parse_as_infix(Pair(n,d)):
  infix_list := sort(infix_cmp)(
    PairList.cons(Pair(n,d),filter(fun(Pair(k,_)): k != n)(infix_list)))
fun get_infix_status(n): assoc(n)(infix_list)
fun infixes(): infix_list

def mutable the_interface = PairList []
def mutable the_overload_skeletons = PairList []

def mutable reverse_interface_mapping = #true
def mutable unspaced_binops = PairList [",","..","$"]
def mutable prebroken_binops = PairList ["==>"]
def mutable print_unambiguous_comprehensions = #false
def mutable typify_universal_set = #true
def mutable print_all_thm = #true
def mutable print_types_of_subterms = 1
