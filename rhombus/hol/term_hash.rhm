#lang rhombus
import: "fusion.rhm" open
import: "hash_runtime.rkt" open
export: ocaml_term_hash
fun model(v):
  match v
  | Tyvar(n): block(0,PairList [n])
  | Tyapp(n,args): block(1,PairList [n,model(args)])
  | Var(n,t): block(0,PairList [n,model(t)])
  | Const(n,t): block(1,PairList [n,model(t)])
  | Comb(f,x): block(2,PairList [model(f),model(x)])
  | Abs(x,b): block(3,PairList [model(x),model(b)])
  | PairList []: immediate(0)
  | PairList [h, & t]: block(0,PairList [model(h),model(t)])
fun ocaml_term_hash(tm): hash_model(model(tm))