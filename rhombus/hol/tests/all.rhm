#lang rhombus
// One module instance of each theory serves all suites. Keep this runner
// sequential: proof tools and conservative definitions have mutable state.
import:
  lib("racket/base.rkt") as R:
    only:
      #{dynamic-require}
      #{getenv}
  "../fusion.rhm" as Kernel
  "support/statement.rhm" open

// Capture the standard context before examples introduce fresh definitions.
R.#{dynamic-require}(PairList [#'lib, "rhombus/hol/define.rhm"], #false)
let standard_axioms = Kernel.axioms()
check standard_axioms.length() ~is 3
R.#{dynamic-require}(PairList [#'lib, "rhombus/hol/tests/axioms.rhm"], #false)

// The historical differential audit is optional, and must precede tests
// that extend the context. No saved theorem is imported into the kernel.
when R.#{getenv}("HOL_TEST_AUDIT")
| R.#{dynamic-require}(PairList [#'lib, "rhombus/hol/tests/golden/hol_light.rhm"], #false)

for (suite in ["fast", "upstream/basic_tests", "upstream/dickson", "upstream/lagrange_lemma"]):
  R.#{dynamic-require}(PairList [#'lib, "rhombus/hol/tests/" ++ suite ++ ".rhm"], #false)
  check unchanged_axioms(standard_axioms) ~is #true
