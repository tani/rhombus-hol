#lang rhombus
// Independent statements specify the trusted standard environment. A mere
// count or comparison with module exports would not detect a changed axiom.
import: "../fusion.rhm" as Kernel
import: "../private/hol_quote.rhm" open
import: "support/statement.rhm" open

let expected = [
  (hol: forall (f :: A -> B): (fun (x :: A): f(x)) == f),
  (hol:
     const #{@} :: (A -> bool) -> A
     forall (P :: A -> bool, x :: A): P(x) ==> P(const.#{@}(P))),
  (hol:
     const ONE_ONE :: (A -> B) -> bool
     const ONTO :: (A -> B) -> bool
     exists f :: ind -> ind: ONE_ONE(f) && !ONTO(f))
]
check Kernel.axioms().length() ~is expected.length()
for (goal in expected):
  check (for any (axiom in Kernel.axioms()): proves(axiom, goal)) ~is #true
