#lang rhombus

import: "../fusion.rhm" open
import: "../basics.rhm" open
import: "../equal.rhm" open
import: "../bool.rhm" open

def p = mk_var(["p", bool_ty])
def q = mk_var(["q", bool_ty])
def x = mk_var(["x", aty])

// mk_iff passes a standalone equality constant to the kernel, which needs
// its boolean instance before either application is constructed.
check mk_iff([p, q]) ~is mk_eq([p, q])

check concl(TRUTH) ~is lhs(concl(T_DEF))
check concl(CONJ(ASSUME(p))(ASSUME(q))) ~is mk_conj([p, q])
check concl(CONJUNCT1(ASSUME(mk_conj([p, q])))) ~is p
check concl(CONJUNCT2(ASSUME(mk_conj([p, q])))) ~is q

def pid = DISCH(p)(ASSUME(p))
check concl(pid) ~is mk_imp([p, p])
check concl(MP(pid)(ASSUME(p))) ~is p

def reflx = REFL(x)
def allx = GEN(x)(reflx)
check is_forall(concl(allx)) ~is #true
check concl(SPEC(x)(allx)) ~is concl(reflx)

check concl(DISJ1(ASSUME(p))(q)) ~is mk_disj([p, q])
check concl(DISJ2(p)(ASSUME(q))) ~is mk_disj([p, q])
