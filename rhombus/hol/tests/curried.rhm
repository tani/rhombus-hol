#lang rhombus
import: "../private/curried.rhm" open

curried(3) fun add(x):
  fun(y):
    fun(z): x + y + z
check add(1, 2, 3) ~is 6
check add(1)(2, 3) ~is 6
check add(1, 2)(3) ~is 6
check add()(1)(2)(3) ~is 6

let seen = Box([])
curried(2) fun shared(x):
  seen.value := seen.value ++ [x]
  let count = Box(0)
  fun(y):
    count.value := count.value + 1
    [x + y, count.value]
let partial = shared(10)
check seen.value ~is [10]
check partial(1) ~is [11, 1]
check partial(2) ~is [12, 2]
check shared(20, 3) ~is [23, 1]
check seen.value ~is [10, 20]

curried(1) fun returns_function(x):
  fun(y): x + y
check returns_function(2, 3) ~is 5
check returns_function(2)(3) ~is 5

curried(2) fun tuple_arg([x, y]):
  fun(z): x + y + z
check tuple_arg([1, 2], 3) ~is 6
