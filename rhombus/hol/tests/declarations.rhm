#lang rhombus
import: "../private/declarations.rhm" open
variant Tree:
  Empty()
  Leaf(value)
  Branch(left, right)
check Empty().ocaml_view() ~is [0, [0, PairList []]]
check Leaf(3).ocaml_view() ~is [1, [0, PairList [3]]]
check Branch(Leaf(1), Empty()) == Branch(Leaf(1), Empty()) ~is #true
check Branch(Leaf(1), Empty()) == Branch(Leaf(2), Empty()) ~is #false
let table = Map {Leaf(3): "found"}
check table[Leaf(3)] ~is "found"
record Entry(key, value)
check Entry("a", 1) with (value = 2) ~is Entry("a", 2)
namespace Nested:
  export: Node
  variant Local:
    Node(value)
check Nested.Node(1).ocaml_view() ~is [1, [0, PairList [1]]]
