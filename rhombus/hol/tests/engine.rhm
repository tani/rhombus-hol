#lang rhombus
import: "../fusion.rhm" open
import: "../basics.rhm" open
import: "../equal.rhm" open
import: "../bool.rhm" open
import: "../drule.rhm" open
import: "../tactics.rhm" open
import: "../itab.rhm" open
import: "../simp.rhm" open
import: "../lib.rhm" as Compat
import: "../private/quoted_ast.rhm" as Quotes
import: "../lib.rhm" as Atoms

// Exercise closed theorem reconstruction through the tactic and tableau layers.
def p = mk_var(["p", bool_ty])
def q = mk_var(["q", bool_ty])
def implication = mk_imp([p, p])
def identity = ITAUT(implication)
check aconv(concl(identity))(implication) ~is #true
check hyp(identity) ~is PairList []
def swap = mk_imp([mk_conj([p, q]), mk_conj([q, p])])
def swapped = ITAUT(swap)
check aconv(concl(swapped))(swap) ~is #true
check hyp(swapped) ~is PairList []

// Rewriting must preserve the assumption that justifies the replacement.
def equation = mk_eq([p, q])
def rewritten = PURE_REWRITE_CONV(PairList [ASSUME(equation)])(p)
check aconv(rhs(concl(rewritten)))(q) ~is #true
check hyp(rewritten) ~is PairList [equation]

// Type instantiation can make distinct variables identical. Do not retain
// a self substitution: later unification would follow it forever.
def generic_x = mk_var(["unify_x", mk_vartype("unify_A")])
def boolean_x = mk_var(["unify_x", bool_ty])
def typed_identity = term_type_unify(generic_x)(boolean_x)(null_inst)
check typed_identity[1] ~is PairList []
def unified_true = term_type_unify(boolean_x)(mk_const(["T", PairList []]))(typed_identity)
check unified_true[1] ~is PairList [[mk_const(["T", PairList []]), boolean_x]]
def recursive_function = mk_var(["unify_f", mk_type(["fun", PairList [bool_ty,bool_ty]])])
check Compat.can(fun(t): term_type_unify(boolean_x)(t)(null_inst))(mk_comb([recursive_function, boolean_x])) ~is #false

// Serialized offline ASTs must reconstruct immutable kernel values.
def quoted_ty = Quotes.hol_term(Tyvar("A"))
check quoted_ty ~is mk_vartype("A")
def quoted_x = mk_var(["x", quoted_ty])
check Quotes.hol_term(Abs(Var("x", Tyvar("A")), Var("x", Tyvar("A")))) ~is mk_abs([quoted_x, quoted_x])

// Merging distinct Patricia branches must retain both bindings.
def map_x = mk_var(["map-x", bool_ty])
def map_y = mk_var(["map-y", bool_ty])
def map_left = Atoms.fpf_define(map_x)(2)(Atoms.undefined)
def map_right = Atoms.fpf_define(map_y)(3)(Atoms.undefined)
def map_joined = Atoms.combine(fun(a): fun(b): a + b)(fun(_): #false)(map_left)(map_right)
check Atoms.apply(map_joined)(map_x) ~is 2
check Atoms.apply(map_joined)(map_y) ~is 3
