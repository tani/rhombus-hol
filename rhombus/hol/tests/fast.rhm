#lang rhombus
// All inexpensive suites share their engine modules in one process.
import:
  lib("racket/base.rkt") as R:
    only: #{dynamic-require}
for (suite in ["fusion", "kernel", "statement", "reference", "declarations", "bool",
               "engine", "hol_quote", "inference_errors", "proof_syntax"]):
  R.#{dynamic-require}(PairList [#'lib, "rhombus/hol/tests/" ++ suite ++ ".rhm"], #false)
