#lang rhombus/static

import:
  rhombus/hol/fusion open

def a = mk_vartype(#'A)
def b = mk_vartype(#'B)
def f = mk_var(#'f, mk_fun_ty(a, b))
def x = mk_var(#'x, a)

check type_of(mk_comb(f, x)) ~is b
check is_fun_ty(type_of(f)) ~is #true
check:
  let (name, ty) = dest_var(x)
  [name, ty]
  ~is [#'x, a]
