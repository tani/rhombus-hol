#lang rhombus

import: "../fusion.rhm" open
import: "../equal.rhm" open

def x = mk_var(Pair("x", bool_ty))
def y = mk_var(Pair("y", bool_ty))
def id = mk_abs(Pair(x, x))
def red = mk_comb(Pair(id, y))

check is_var(x) ~is #true
check type_of(x) ~is bool_ty
check rhs(concl(BETA_CONV(red))) ~is y
check aconv(rhs(concl(BETA_CONV(red))))(y) ~is #true
