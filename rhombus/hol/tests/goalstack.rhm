#lang rhombus
// The interactive subgoal package of tactics.ml: g, e, er, r, b, top_thm.
import:
  "../fusion.rhm" open
  "../bool.rhm" open
  "../tactics.rhm" open
  "../lib.rhm" open:
    except: check
  "../private/ocaml.rhm" open
  "../private/hol_quote.rhm" open

fun ignore(_): #void

def goal = @hol|{p /\ q ==> q /\ p}|
fun ACCEPT_CONJUNCT(sel): FIRST_ASSUM(o(ACCEPT_TAC)(sel))

ignore(g(goal))
ignore(e(DISCH_TAC))
ignore(e(CONJ_TAC))
def first_goal = snd(top_goal(#void))
check length(fst(top_goal(#void))) ~is 1
// Rotating twice swaps the two conjuncts and back again.
ignore(r(1))
check snd(top_goal(#void)) == first_goal ~is #false
ignore(r(1))
check snd(top_goal(#void)) == first_goal ~is #true
// Backing up undoes one refinement.
def depth = length(p(#void))
ignore(b(#void))
check length(p(#void)) ~is depth - 1
// The state is now rotated once: p comes before q.
ignore(e(ACCEPT_CONJUNCT(CONJUNCT1)))
ignore(e(ACCEPT_CONJUNCT(CONJUNCT2)))
def th = top_thm(#void)
check aconv(concl(th))(goal) ~is #true
check hyp(th) ~is PairList []

// er proves the head subgoal and moves on to the next one of the same split.
def goal2 = @hol|{p /\ q ==> p /\ q}|
ignore(g(goal2))
ignore(e(DISCH_TAC))
ignore(e(CONJ_TAC))
ignore(er(ACCEPT_CONJUNCT(CONJUNCT1)))
ignore(e(ACCEPT_CONJUNCT(CONJUNCT2)))
check aconv(concl(top_thm(#void)))(goal2) ~is #true

def backed_out:
  try:
    for (i in 0 .. 10): b(#void)
    "no failure"
    ~catch Failure(m): m
check backed_out ~is "Can't back up any more"
