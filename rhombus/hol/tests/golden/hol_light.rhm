#lang rhombus
// Differential check against the logical state of pinned HOL Light.
// hol_light.tsv is produced by tools/hol_light_golden/dump.ml after hol.ml;
// it is only compared against, never imported as theorems.
import: "serial.rhm" open
import: "../../fusion.rhm" open
import:
  "../../lib.rhm" open:
    except:
      check
      report
  "../../private/ocaml.rhm" open
import: "../../thecops.rhm" as Thecops
import:
  lib("racket/base.rkt") as R:
    only:
      #{dynamic-require}
      #{module->exports}
      #{collection-file-path}
      #{car}
      #{cdr}
      #{eprintf}
      #{getenv}
      #{symbol->string}
      #{string->immutable-string}
      #{regexp-replace*}
      #{open-input-file}
      #{close-input-port}
      #{open-output-bytes}
      #{get-output-bytes}
      #{open-input-bytes}
  lib("racket/file.rkt") as F:
    only:
      #{file->lines}
  lib("racket/port.rkt") as P:
    only:
      #{port->lines}
  lib("file/gunzip.rkt") as Z:
    only:
      #{gunzip-through-ports}

// Load order of hol_lib.ml from fusion.ml through define.ml.
def modules = ["fusion", "basics", "nets", "equal", "bool", "drule",
               "tactics", "itab", "simp", "theorems", "ind_defs", "class",
               "trivia", "canon", "meson", "firstorder", "metis", "thecops",
               "quot", "impconv", "pair", "compute", "nums", "recursion",
               "arith", "wf", "calc_num", "normalizer", "grobner",
               "ind_types", "lists", "realax", "calc_int", "realarith",
               "real", "calc_rat", "int", "sets", "iterate", "cart",
               "define"]

fun data_file(name):
  R.#{collection-file-path}(name, "rhombus/hol/tests/golden")

fun read_lines(name :: String):
  if name.length() > 3 && name.substring(name.length() - 3, name.length()) == ".gz"
  | let in = R.#{open-input-file}(data_file(name))
    let out = R.#{open-output-bytes}()
    Z.#{gunzip-through-ports}(in, out)
    R.#{close-input-port}(in)
    P.#{port->lines}(R.#{open-input-bytes}(R.#{get-output-bytes}(out)))
  | F.#{file->lines}(data_file(name))

fun read_table(name):
  for List (line in (read_lines(name) :: PairList)):
    skip_when line == "" || line[0] == #{#\#}
    for List (field in line.split("\t")): R.#{string->immutable-string}(field)

fun is_thm(v):
  try:
    dest_thm(v)
    #true
    ~catch _: #false

// Theorem-valued exports of every module, keyed by HOL Light name.
fun exported_theorems():
  let mutable found :: Map = {}
  for (m in modules):
    let path = PairList[#'lib, "rhombus/hol/" ++ m ++ ".rhm"]
    R.#{dynamic-require}(path, #false)
    let values(vars, _) = R.#{module->exports}(path)
    for (phase_entry in (vars :: PairList)):
      skip_when R.#{car}(phase_entry) != 0
      for (e in (R.#{cdr}(phase_entry) :: PairList)):
        let name = R.#{string->immutable-string}(R.#{symbol->string}(R.#{car}(e)))
        let v = R.#{dynamic-require}(path, R.#{car}(e))
        // Later modules shadow earlier bindings, as in the HOL Light toplevel.
        when is_thm(v)
        | found := found ++ { name: [m, v] }
  found

fun rhombus_name(name :: String): name.replace("'", "_prime", ~all: #true)

// Theorems that database.ml names through an OCaml module path.
def qualified_theorems :: Map:
  {"Hashek.hashek_def": Thecops.Hashek.hashek_def,
   "Hashek.hashek_eq": Thecops.Hashek.hashek_eq,
   "Hashek.hashek_prop": Thecops.Hashek.hashek_prop,
   "Hashek.hashek_thm": Thecops.Hashek.hashek_thm}

// Names invented at run time: genvar variables and constants (_<n>), type
// inference's invented type variables (?<n>) and the parser's set-notation
// variables (GEN%PVAR%<n>). HOL Light's session advances these counters
// over work the port does not replay (other quotations, the printer, the
// toplevel), so the numbering differs while the statements agree. Number
// them by first occurrence to compare up to that renaming.
fun invented_canonical(s :: String) :: String:
  let mutable seen :: Map = {}
  R.#{string->immutable-string}(
    R.#{regexp-replace*}(#{#rx"\"([?_]|GEN%PVAR%)[0-9]+\""}, s,
                         fun(m, kind, & _):
                           let key = R.#{string->immutable-string}(m)
                           unless seen.has_key(key)
                           | seen := seen ++ { key: seen.length() }
                           // The kind stays, so a genvar never matches a
                           // type variable or a parser variable.
                           "\"" +& kind +& "#" +& seen[key] +& "\""))

fun report(fmt, & args): R.#{eprintf}(fmt, & args)

def golden = read_table("hol_light.tsv.gz")
def known :: Map:
  for Map (row in read_table("known_differences.tsv")):
    values(row[0] ++ "\t" ++ row[1], row[2])
def theorems = exported_theorems()

def mutable failures = []
def mutable matched = 0
def mutable renamed = []
def mutable seen_known = []

fun record(kind, name, msg):
  let key = kind ++ "\t" ++ name
  if known.has_key(key)
  | seen_known := seen_known.add(key)
  | failures := failures.add(key ++ "\t" ++ msg)

fun compare_row(kind, name, expected, actual):
  cond
  | expected == actual:
      if known.has_key(kind ++ "\t" ++ name)
      | failures := failures.add(kind ++ "\t" ++ name ++ "\tlisted as known difference but matches")
      | matched := matched + 1
  | invented_canonical(expected) == invented_canonical(actual):
      renamed := renamed.add(kind ++ "\t" ++ name)
  | ~else:
      record(kind, name, "mismatch\n  hol-light: " ++ expected ++ "\n  rhombus:   " ++ actual)

fun numbered(l):
  for List (x in plist_to_list(l).reverse(), i in 0..): [to_string(i), x]
fun plist_to_list(l): for List (x in (l :: PairList)): x

def actual_types = for Map ([_, a] in numbered(types())): values(a[0], to_string(a[1]))
fun is_invented_name(name :: String):
  name.length() > 1 && name[0] == #{#\_} && (for all (c in name.substring(1, name.length())): Char.is_numeric(c))
def actual_consts = for Map ([_, a] in numbered(constants())):
  skip_when is_invented_name(a[0])
  values(a[0], serial_type(a[1]))
// Constants named by genvar are matched by their order of definition.
def actual_invented_consts:
  for List ([_, a] in numbered(constants())):
    skip_when !is_invented_name(a[0])
    a
def actual_axioms = for Map ([i, th] in numbered(axioms())): values(i, serial_thm(th))
def actual_defs = for Map ([i, th] in numbered(definitions())): values(i, serial_thm(th))

fun check_table(kind, actual :: Map, expected_name, expected):
  if actual.has_key(expected_name)
  | compare_row(kind, expected_name, expected, actual[expected_name])
  | record(kind, expected_name, "missing in Rhombus/HOL")

def mutable invented_index = 0
for (row in golden):
  let [kind, name, expected] = row
  match kind
  | "type": check_table(kind, actual_types, name, expected)
  | "const":
      if is_invented_name(name)
      | if invented_index < actual_invented_consts.length()
        | let [actual_name, ty] = actual_invented_consts[invented_index]
          compare_row(kind, name, "c\"" ++ name ++ "\":" ++ expected,
                      "c\"" ++ actual_name ++ "\":" ++ serial_type(ty))
        | record(kind, name, "missing in Rhombus/HOL")
        invented_index := invented_index + 1
      | check_table(kind, actual_consts, name, expected)
  | "axiom": check_table(kind, actual_axioms, name, expected)
  | "definition": check_table(kind, actual_defs, name, expected)
  | "thm":
      let rname = rhombus_name(name)
      cond
      | qualified_theorems.has_key(name):
          compare_row(kind, name, expected, serial_thm(qualified_theorems[name]))
      | theorems.has_key(rname):
          compare_row(kind, name, expected, serial_thm(theorems[rname][1]))
      | ~else:
          record(kind, name, "not exported by any module")

def expected_counts:
  for values(m :: Map = {}) (row in golden):
    m ++ { row[0]: m.get(row[0], 0) + 1 }
report("hol-light golden: ~a rows, ~a exact, ~a up to invented names, ~a known differences, ~a failures\n",
       golden.length(), matched, renamed.length(), seen_known.length(), failures.length())
when R.#{getenv}("HOL_GOLDEN_VERBOSE")
| for (r in renamed):
    report("RENAMED ~a\n", r)
report("  rows by kind: ~a; actual types ~a, constants ~a, axioms ~a, definitions ~a\n",
       expected_counts, actual_types.length(), actual_consts.length(),
       actual_axioms.length(), actual_defs.length())
for (f in failures):
  report("FAIL ~a\n", f)
for (k in known.keys()):
  unless seen_known.has_element(k) || failures.has_element(k)
  | report("NOTE stale known difference: ~a\n", k)

check failures ~is []
