#lang rhombus
import: "../private/hol_quote.rhm" open
import: "../fusion.rhm" as Kernel
import: "../bool.rhm" as BoolTheory
import: "../basics.rhm" as Basics
import: "../parser.rhm" as Parser
import: "../lists.rhm" as Lists
import:
  "../lib.rhm" open:
    only:
      explode

// `@hol|{...}|` reads HOL Light text against the theories loaded so far:
// `:` starts a type, anything else is a term elaborated by type inference.
let a = Kernel.mk_vartype("A")
let x = Kernel.mk_var(["x", a])
check @hol|{:A->bool}| ~is Kernel.mk_fun_ty(a)(Kernel.bool_ty)
check @hol|{\x:A. x}| ~is Kernel.mk_abs([x, x])
let eq = Kernel.mk_eq([x, x])
check @hol|{(x:A) = x}| ~is eq
check @hol|{!x:A. x = x}| ~is BoolTheory.mk_forall([x, eq])
let p = Kernel.mk_var(["p", Kernel.bool_ty])
let q = Kernel.mk_var(["q", Kernel.bool_ty])
check @hol|{p /\ q}| ~is BoolTheory.mk_conj([p, q])
check @hol|{p ==> q}| ~is BoolTheory.mk_imp([p, q])
// Infix precedence: /\ binds tighter than ==>, which is right associative.
check @hol|{p /\ q ==> q ==> p}| ~is BoolTheory.mk_imp([BoolTheory.mk_conj([p, q]), BoolTheory.mk_imp([q, p])])
// A parenthesized infix is the constant itself.
check @hol|{(==>) T F}| ~is @hol|{T ==> F}|
check @hol|{(==>)}| ~is Basics.mk_mconst(["==>", Kernel.mk_fun_ty(Kernel.bool_ty)(Kernel.mk_fun_ty(Kernel.bool_ty)(Kernel.bool_ty))])
// Type inference unifies the uses of a free variable.
let function = Kernel.mk_var(["f", Kernel.mk_fun_ty(a)(a)])
check @hol|{(f:A->A) x}| ~is Kernel.mk_comb([function, x])
let b = Kernel.mk_vartype("B")
let inner = Kernel.mk_var(["x", b])
check @hol|{\x:A. \x:B. x}| ~is Kernel.mk_abs([x, Kernel.mk_abs([inner, inner])])
// Quotations may span lines; `//` starts a comment as in HOL Light.
check @hol|{p /\  // the left conjunct
  q}| ~is BoolTheory.mk_conj([p, q])
check Parser.parse_term("~p") ~is BoolTheory.mk_neg(p)
check Parser.parse_type("bool->bool") ~is Kernel.mk_fun_ty(Kernel.bool_ty)(Kernel.bool_ty)

// String literals are byte strings as in OCaml: `\xHH` and `\DDD` escapes
// give single bytes, and a non-ASCII character gives its UTF-8 bytes.
check @hol|{"a\x41b"}| ~is @hol|{"aAb"}|
check @hol|{"\065"}| ~is @hol|{"A"}|
check @hol|{"é"}| ~is @hol|{"\195\169"}|
check Parser.lex(explode("a // comment\nb")) ~is PairList[Parser.Ident("a"), Parser.Ident("b")]
