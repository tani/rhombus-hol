#lang rhombus
import: "../private/hol_quote.rhm" open
import: "../fusion.rhm" as Kernel
import: "../bool.rhm" as BoolTheory

let a = Kernel.mk_vartype("A")
let x = Kernel.mk_var(["x", a])
check (hol_type: A -> bool) ~is Kernel.mk_fun_ty(a)(Kernel.bool_ty)
check (hol:
         fun (x :: A): x) ~is Kernel.mk_abs([x, x])
let eq = Kernel.mk_eq([x, x])
check (hol:
         var x :: A
         x == x) ~is eq
check (hol:
         forall x :: A: x == x) ~is BoolTheory.mk_forall([x, eq])
let p = Kernel.mk_var(["p", Kernel.bool_ty])
let q = Kernel.mk_var(["q", Kernel.bool_ty])
check (hol:
         var p :: bool
         var q :: bool
         p && q) ~is BoolTheory.mk_conj([p, q])
check (hol:
         var p :: bool
         var q :: bool
         p ==> q) ~is BoolTheory.mk_imp([p, q])
let function = Kernel.mk_var(["f", Kernel.mk_fun_ty(a)(a)])
check (hol:
         var f :: A -> A
         var x :: A
         f(x)) ~is Kernel.mk_comb([function, x])
let b = Kernel.mk_vartype("B")
let inner = Kernel.mk_var(["x_2", b])
check (hol:
         fun (x :: A, x_2 :: B): x) ~is Kernel.mk_abs([x, Kernel.mk_abs([inner, x])])
check (hol: var line_name as "line\nname" :: bool; line_name) ~is Kernel.mk_var(["line\nname", Kernel.bool_ty])

// Variables are monomorphic within a quotation; constants instantiate their
// declared scheme independently at every occurrence.
check Kernel.aconv(hol: var p; var q; p && q)(BoolTheory.mk_conj([p, q])) ~is #true
check Kernel.type_of(hol: fun (x): x && #true) ~is Kernel.mk_fun_ty(Kernel.bool_ty)(Kernel.bool_ty)
check Kernel.type_of(hol: var f; var x :: A; f(x) == x) ~is Kernel.bool_ty
let polymorphic_equality = hol:
  const #{=} :: A -> A -> bool
  #{=}(#true, #true) && #{=}(fun (x :: bool): x, fun (y :: bool): y)
check Kernel.type_of(polymorphic_equality) ~is Kernel.bool_ty
let shadowed_constant = hol:
  const T :: bool
  fun (T :: bool): const.T
check Kernel.aconv(shadowed_constant)(Kernel.mk_abs([Kernel.mk_var(["T", Kernel.bool_ty]), Kernel.mk_const(["T", PairList []])])) ~is #true

// A qualified free variable survives a same-named lexical binder.
let shadowed_variable = hol:
  var x :: A
  fun (x :: A): var.x
check Kernel.vfree_in(x)(shadowed_variable) ~is #true
check Kernel.aconv(shadowed_variable)(Kernel.mk_abs([Kernel.mk_var(["fresh_x", a]), x])) ~is #true
