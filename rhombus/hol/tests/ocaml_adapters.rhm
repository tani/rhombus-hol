#lang rhombus
// Differential tests: each OCaml module adapter of private/ocaml.rhm against
// a literal model of the OCaml semantics it replaces.
import: "../private/ocaml.rhm" open
import:
  "../lib.rhm" open:
    except: check

// Map.Make over (string * int) keys, modelled as an association list.
fun model_find(k):
  fun(m):
    match assoc_opt(k, m)
    | Some(v): v
    | None(): throw Not_found()
fun assoc_opt(k, m):
  match m
  | PairList []: None()
  | PairList [[k2, v], & rest]:
      if k == k2 | Some(v) | assoc_opt(k, rest)
fun model_add(k): fun(v): fun(m): PairList.cons([k, v], filter(fun([k2, _]): k2 != k)(m))
fun model_union(f):
  fun(m1):
    fun(m2):
      itlist(fun([k, v2]):
               fun(acc):
                 match assoc_opt(k, acc)
                 | Some(v1):
                     match f(k)(v1)(v2)
                     | Some(v): model_add(k)(v)(acc)
                     | None(): filter(fun([k3, _]): k3 != k)(acc)
                 | None(): model_add(k)(v2)(acc))(m2)(m1)

def M = OCamlMap.Make(fun(a): fun(b): compare(a)(b))
def keys = PairList [["a", 1], ["a", 2], ["b", 1], ["c", 3]]

fun same(m, model):
  for values(ok = #true) (k in keys):
    ok && (try:
             M.find(k)(m) == model_find(k)(model)
             ~catch Not_found():
               try:
                 model_find(k)(model)
                 #false
                 ~catch Not_found(): #true)

// A deterministic sequence of insertions and unions.
let values(m1, model1):
  for values(m = M.empty, model = PairList []) (i in 0 .. 40):
    let k = el(i mod 4)(keys)
    values(M.add(k)(i)(m), model_add(k)(i)(model))
let values(m2, model2):
  for values(m = M.empty, model = PairList []) (i in 0 .. 10):
    let k = el((3 * i) mod 4)(keys)
    values(M.add(k)(100 + i)(m), model_add(k)(100 + i)(model))
check same(m1, model1) ~is #true
check same(m2, model2) ~is #true
let plus = fun(_): fun(a): fun(b): Some(a + b)
check same(M.union(plus)(m1)(m2), model_union(plus)(model1)(model2)) ~is #true
let drop = fun(_): fun(_): fun(_): None()
check same(M.union(drop)(m1)(m2), model_union(drop)(model1)(model2)) ~is #true
check (try:
         M.find(["z", 0])(m1)
         "found"
         ~catch Not_found(): "Not_found") ~is "Not_found"

// String.compare and integer compare.
check [OCamlString.compare("a")("b"), OCamlString.compare("b")("b"), OCamlString.compare("c")("b")] ~is [-1, 0, 1]
check [OCamlInt.compare(1)(2), OCamlInt.compare(2)(2), OCamlInt.compare(3)(2)] ~is [-1, 0, 1]

// Polymorphic compare against its previous, literal implementation.
import: "../fusion.rhm" as Kernel
fun old_cmp_scalar(x,y): if x == y | 0 | (if x < y | -1 | 1)
fun old_compare(x):
  fun(y):
    if x === y | 0 | old_compare_distinct(x,y)
fun old_compare_lists(a,b):
  if a == []
  | 0
  | let c = old_compare(a.first)(b.first)
    if c != 0 | c | old_compare_lists(a.rest,b.rest)
fun old_compare_distinct(x,y):
  cond
  | x is_a OcamlValue && y is_a OcamlValue:
      let vx = x.ocaml_view()
      let vy = y.ocaml_view()
      if vx is_a List && vy is_a List | old_compare_lists(vx,vy) | old_compare(vx)(vy)
  | x == y: 0
  | x is_a Function || y is_a Function: throw InvalidArgument("compare: functional value")
  | x is_a PairList && y is_a PairList && x != PairList [] && y != PairList []:
      let c = old_compare(x.first)(y.first)
      if c != 0 | c | old_compare(x.rest)(y.rest)
  | x is_a List && y is_a List: old_compare_lists(x,y)
  | x == PairList []: -1
  | y == PairList []: 1
  | ~else: old_cmp_scalar(x,y)

def ty_a = Kernel.mk_vartype("A")
def ty_b = Kernel.mk_vartype("B")
def leaves:
  [0, 1, -3, 7, "", "a", "b", "ab", PairList [], None(), Some(1), Some("a"),
   ty_a, ty_b, Kernel.mk_fun_ty(ty_a)(ty_b), Kernel.bool_ty,
   Kernel.mk_var(["x", ty_a]), Kernel.mk_var(["y", ty_a]), Kernel.mk_var(["x", ty_b]),
   Kernel.mk_abs([Kernel.mk_var(["x", ty_a]), Kernel.mk_var(["x", ty_a])])]
fun gen(seed, depth):
  let k = seed mod 7
  if depth == 0 || k < 3
  | leaves[seed mod leaves.length()]
  | match k
    | 3: [gen(seed * 31 + 1, depth - 1), gen(seed * 17 + 2, depth - 1)]
    | 4: [gen(seed * 13 + 3, depth - 1), gen(seed * 7 + 4, depth - 1), gen(seed * 5 + 5, depth - 1)]
    | 5: PairList [gen(seed * 11 + 6, depth - 1), gen(seed * 3 + 7, depth - 1)]
    | _: Some(gen(seed * 19 + 8, depth - 1))
// Ill-typed pairs (a tuple against an option) cannot arise from OCaml; both
// implementations must still agree on whether they fail.
fun outcome(f):
  try:
    f()
    ~catch
    | InvalidArgument(_): "Invalid_argument"
    | _: "error"
def samples = for List (i in 0 .. 400): gen(i * 7919 + 13, 4)
check (for values(bad = 0) (x in samples, i in 0 ..):
         let y = samples[(i * 37 + 11) mod samples.length()]
         if outcome(fun(): compare(x)(y)) == outcome(fun(): old_compare(x)(y)) | bad | bad + 1) ~is 0
check (for values(bad = 0) (x in samples):
         if compare(x)(x) == 0 | bad | bad + 1) ~is 0
