#lang rhombus
// OCaml Stdlib functions of private/ocaml.rhm that generated code calls
// under their OCaml names (tools/ml2rhm): the results OCaml gives.
import:
  "../private/ocaml.rhm" open

check Printf.sprintf("%d-%s%%")(3)("x") ~is "3-x%"
check Printf.sprintf("no directives") ~is "no directives"
check OCamlString.sub("abcdef")(2)(3) ~is "cde"
check OCamlString.get("abc")(1) ~is "b"
check OCamlString.length("abc") ~is 3
check OCamlString.concat(", ")(PairList ["a", "b", "c"]) ~is "a, b, c"
check OCamlString.trim("  a b\n") ~is "a b"
check OCamlString.index("hello")("l") ~is 2
check (try: OCamlString.index("hello")("z"); ~catch Not_found(): "nf") ~is "nf"
check OCamlString.starts_with(~prefix: "ab", "abc") ~is #true
check OCamlChar.code("A") ~is 65
check OCamlChar.chr(66) ~is "B"
check OCamlArray.to_list(OCamlArray.of_list(PairList [1, 2, 3])) ~is PairList [1, 2, 3]
check (block:
         let a = OCamlArray.make(3)(0)
         OCamlArray.set(a)(1)(5)
         OCamlArray.fold_left(fun(x): fun(y): x + y)(0)(a)) ~is 5
check not(#false) ~is #true
check abs(-3) ~is 3
check max(2)(5) ~is 5
check min("a")("b") ~is "a"
check int_of_string("0x1F") ~is 31
check (block:
         let r = Box(1)
         incr(r)
         incr(r)
         decr(r)
         r.value) ~is 2
check (try: invalid_arg("x"); ~catch InvalidArgument(m): m) ~is "x"
check OCamlList.length(PairList [1, 2]) ~is 2
check OCamlList.rev(PairList [1, 2]) ~is PairList [2, 1]
check lsl(1)(4) ~is 16
check land(12)(10) ~is 8
check (try: assert(1 == 2); ~catch Assert_failure(): "af") ~is "af"
check Sys.time(#void) >= 0 ~is #true
