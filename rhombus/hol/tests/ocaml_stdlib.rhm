#lang rhombus
// OCaml Stdlib functions of private/ocaml.rhm that generated code calls
// under their OCaml names (tools/ml2rhm): the results OCaml gives.
import:
  "../private/ocaml.rhm" open
  lib("racket/base.rkt") as Rkt
  lib("racket/file.rkt") as RktFile

check Printf.sprintf("%d-%s%%")(3)("x") ~is "3-x%"
check Printf.sprintf("no directives") ~is "no directives"
// OCaml's %b prints true/false, %f six decimals, and %! takes no argument.
check Printf.sprintf("%b %b%!")(#true)(#false) ~is "true false"
check Printf.sprintf("%f|%f")(0.031)(-2.5) ~is "0.031000|-2.500000"
check OCamlString.sub("abcdef")(2)(3) ~is "cde"
check OCamlString.get("abc")(1) ~is "b"
check OCamlString.length("abc") ~is 3
check OCamlString.concat(", ")(PairList ["a", "b", "c"]) ~is "a, b, c"
check OCamlString.trim("  a b\n") ~is "a b"
check OCamlString.index("hello")("l") ~is 2
check (try: OCamlString.index("hello")("z"); ~catch Not_found(): "nf") ~is "nf"
check OCamlString.starts_with(~prefix: "ab", "abc") ~is #true
check OCamlChar.code("A") ~is 65
check OCamlChar.chr(66) ~is "B"
check OCamlArray.to_list(OCamlArray.of_list(PairList [1, 2, 3])) ~is PairList [1, 2, 3]
check (block:
         let a = OCamlArray.make(3)(0)
         OCamlArray.set(a)(1)(5)
         OCamlArray.fold_left(fun(x): fun(y): x + y)(0)(a)) ~is 5
check not(#false) ~is #true
check abs(-3) ~is 3
check max(2)(5) ~is 5
check min("a")("b") ~is "a"
check int_of_string("0x1F") ~is 31
check (block:
         let r = Box(1)
         incr(r)
         incr(r)
         decr(r)
         r.value) ~is 2
check (try: invalid_arg("x"); ~catch InvalidArgument(m): m) ~is "x"
check OCamlList.length(PairList [1, 2]) ~is 2
check OCamlList.rev(PairList [1, 2]) ~is PairList [2, 1]
// List.combine, List.split and List.remove_assoc (Boyer_Moore/ uses them).
check OCamlList.combine(PairList [1, 2])(PairList ["a", "b"]) ~is PairList [[1, "a"], [2, "b"]]
check (try:
         OCamlList.combine(PairList [1])(PairList [])
         ~catch InvalidArgument(m): m) ~is "List.combine"
check OCamlList.append(PairList [1])(PairList [2, 3]) ~is PairList [1, 2, 3]
check OCamlList.split(PairList [[1, "a"], [2, "b"]]) ~is [PairList [1, 2], PairList ["a", "b"]]
check OCamlList.remove_assoc(1)(PairList [[2, "x"], [1, "a"], [1, "b"]]) ~is PairList [[2, "x"], [1, "b"]]
check lsl(1)(4) ~is 16
check land(12)(10) ~is 8
check (try: assert(1 == 2); ~catch Assert_failure(): "af") ~is "af"
check Sys.time(#void) >= 0 ~is #true

// Channels
check (block:
         let name = Rkt.#{path->string}(RktFile.#{make-temporary-file}())
         let oc = open_out(name)
         output_string(oc)("first\nsecond\n")
         close_out(oc)
         let ic = open_in(name)
         let a = input_line(ic)
         let b = input_line(ic)
         let c = (try: input_line(ic); ~catch End_of_file(): "eof")
         close_in(ic)
         let ic2 = open_in_bin(name)
         let all = really_input_string(ic2)(in_channel_length(ic2))
         close_in(ic2)
         [a, b, c, all]) ~is ["first", "second", "eof", "first\nsecond\n"]
check (try: open_in("/nonexistent/x"); ~catch Sys_error(_): "sys_error") ~is "sys_error"
check Printexc.to_string(Failure("x")) ~is "Failure(\"x\")"
// OCaml: List.sort_uniq compare [3;1;2;1;3] = [1;2;3]; the first of equal elements stays
check OCamlList.sort_uniq(fun(x): fun(y): x - y)(PairList [3, 1, 2, 1, 3]) ~is PairList [1, 2, 3]
check OCamlList.sort_uniq(fun(x): fun(y): x[0] - y[0])(PairList [[1, "a"], [0, "b"], [1, "c"]]) ~is PairList [[0, "b"], [1, "a"]]
// OCaml: List.sort is stable: [(0,"b"); (1,"a"); (1,"c")]
check OCamlList.sort(fun(x): fun(y): x[0] - y[0])(PairList [[1, "a"], [0, "b"], [1, "c"]]) ~is PairList [[0, "b"], [1, "a"], [1, "c"]]
