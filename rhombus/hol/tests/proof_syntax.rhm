#lang rhombus
import: "../private/proof_syntax.rhm" open
import:
  "../lib.rhm" open:
    except: check
import: "../fusion.rhm" as Kernel
import: "../bool.rhm" as Bool
import: "../equal.rhm" as Equal
import: "../tactics.rhm" as Tactics
let p = Kernel.mk_var(["p", Kernel.bool_ty])
let reflexivity = Kernel.mk_eq([p, p])
check Kernel.concl(Tactics.prove([reflexivity, Tactics.ALL_TAC then_tac Tactics.REFL_TAC])) ~is reflexivity
check Kernel.concl((Kernel.REFL then_conv Kernel.REFL)(p)) ~is Kernel.mk_eq([p, p])
check Kernel.concl(Tactics.prove([reflexivity, Tactics.FAIL_TAC("test") or_tac Tactics.REFL_TAC])) ~is reflexivity
let q = Kernel.mk_var(["q", Kernel.bool_ty])
let conjunction_elim = Bool.mk_imp([Bool.mk_conj([p, q]), p])
let strip_conjunction = Tactics.REPEAT(Tactics.STRIP_TAC) then_tac Tactics.FIRST_ASSUM(Tactics.ACCEPT_TAC)
check Kernel.concl(Tactics.prove([conjunction_elim, strip_conjunction])) ~is conjunction_elim
