#lang rhombus
import: "../private/quoted_ast.rhm" open
import: "../fusion.rhm" as Kernel
import: "../bool.rhm" as BoolTheory

let a = Kernel.mk_vartype("A")
let x = Kernel.mk_var(["x", a])
check hol_term(Fun(Tvar("A"), Bool)) ~is Kernel.mk_fun_ty(a)(Kernel.bool_ty)
check hol_term(Lambda("x", Tvar("A"), Ref("x"))) ~is Kernel.mk_abs([x, x])
let eq = Kernel.mk_eq([x, x])
check hol_term(Eq(Tvar("A"), Var("x", Tvar("A")), Var("x", Tvar("A")))) ~is eq
check hol_term(Forall("x", Tvar("A"), Eq(Tvar("A"), Ref("x"), Ref("x")))) ~is BoolTheory.mk_forall([x, eq])
let p = Kernel.mk_var(["p", Kernel.bool_ty])
let q = Kernel.mk_var(["q", Kernel.bool_ty])
check hol_term(And(Var("p", Bool), Var("q", Bool))) ~is BoolTheory.mk_conj([p, q])
check hol_term(Implies(Var("p", Bool), Var("q", Bool))) ~is BoolTheory.mk_imp([p, q])
let function = Kernel.mk_var(["f", Kernel.mk_fun_ty(a)(a)])
check hol_term(App(Var("f", Fun(Tvar("A"), Tvar("A"))), [Var("x", Tvar("A"))])) ~is Kernel.mk_comb([function, x])
let b = Kernel.mk_vartype("B")
let inner = Kernel.mk_var(["x", b])
check hol_term(Lambda("x", Tvar("A"), Lambda("x", Tvar("B"), Var("x", Tvar("A"))))) ~is Kernel.mk_abs([x, Kernel.mk_abs([inner, x])])
check hol_term(Var("line\nname", Bool)) ~is Kernel.mk_var(["line\nname", Kernel.bool_ty])
