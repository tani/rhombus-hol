#lang rhombus
import:
  "support/reference.rkt" open:
    only: #{reference-equivalent?}
let bool_type = "T\"bool\"()"
let p = "v\"p\":" ++ bool_type
let q = "v\"q\":" ++ bool_type
let a = "v\"a\":V\"A\""
let b = "v\"b\":V\"B\""
check #{reference-equivalent?}("[]|-\\" ++ p ++ "." ++ p, "[]|-\\" ++ q ++ "." ++ q) ~is #true
check #{reference-equivalent?}("[]|-\\" ++ p ++ "." ++ p, "[]|-\\" ++ q ++ "." ++ p) ~is #false
check #{reference-equivalent?}("[" ++ p ++ ";" ++ q ++ "]|-" ++ p, "[" ++ q ++ ";" ++ p ++ "]|-" ++ p) ~is #true
check #{reference-equivalent?}("[" ++ p ++ "]|-" ++ p, "[" ++ p ++ "]|-" ++ q) ~is #false
check #{reference-equivalent?}("[]|-" ++ a, "[]|-" ++ b) ~is #true
check #{reference-equivalent?}("T\"fun\"(V\"A\",V\"A\")", "T\"fun\"(V\"B\",V\"C\")") ~is #false
check #{reference-equivalent?}("c\"T\":" ++ bool_type, "c\"F\":" ++ bool_type) ~is #false
check #{reference-equivalent?}("c\"_0\":T\"num\"()", "c\"_1\":T\"num\"()") ~is #false
check #{reference-equivalent?}("c\"_12\":" ++ bool_type, "c\"_39\":" ++ bool_type) ~is #true
let same_type = "(v\"f\":T\"fun\"(V\"A\",V\"A\") v\"x\":V\"A\")"
let different_types = "(v\"g\":T\"fun\"(V\"B\",V\"C\") v\"y\":V\"B\")"
check #{reference-equivalent?}(same_type, different_types) ~is #false
