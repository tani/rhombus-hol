#lang rhombus
import: "../fusion.rhm" open
import: "support/statement.rhm" open
let p = mk_var(["statement_p", bool_ty])
let q = mk_var(["statement_q", bool_ty])
let p_id = mk_abs([p, p])
let q_id = mk_abs([q, q])
check same_statement(REFL(p_id), REFL(q_id)) ~is #true
check same_statement(REFL(p), REFL(q)) ~is #false
check proves(REFL(p), mk_eq([p, p])) ~is #true
check proves(ASSUME(mk_eq([p, p])), mk_eq([p, p])) ~is #false
check proves(REFL(p), mk_eq([p, q])) ~is #false
check same_statement(ASSUME(mk_eq([p, p])), REFL(p)) ~is #false
check same_assumptions(PairList [p, q], PairList [q, p]) ~is #true
check same_assumptions(PairList [p], PairList [q]) ~is #false
