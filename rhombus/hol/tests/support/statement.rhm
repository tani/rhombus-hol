#lang rhombus
// Test contracts use kernel terms, not printer output. Free names and
// constants retain their identity; bound names are compared up to alpha.
import: "../../fusion.rhm" as Kernel
export: same_statement same_assumptions proves unchanged_axioms

fun same_assumptions(left, right):
  (for all (x in left): for any (y in right): Kernel.aconv(x)(y))
    && (for all (y in right): for any (x in left): Kernel.aconv(x)(y))

fun same_statement(left, right):
  Kernel.aconv(Kernel.concl(left))(Kernel.concl(right))
    && same_assumptions(Kernel.hyp(left), Kernel.hyp(right))

fun proves(theorem, goal):
  Kernel.hyp(theorem) == PairList []
    && Kernel.aconv(Kernel.concl(theorem))(goal)

fun unchanged_axioms(before):
  let after = Kernel.axioms()
  before.length() == after.length()
    && (for all (x in before): for any (y in after): same_statement(x, y))
