#lang rhombus
// Port of UnitTests/basic_tests.ml from the pinned HOL Light revision.
// Quotations are upstream's text, parsed in test order as upstream does, and
// every proof is replayed through the Rhombus kernel. Upstream sections that
// test the printer, the pa_j preprocessor, the goalstack (g/e/er/b/top_thm),
// OCaml's bignum `pow`, or hol_lib.ml's check_axioms are outside the port.
import: "../../private/hol_quote.rhm" open
import:
  "../../lib.rhm" open:
    except: check
  "../../private/ocaml.rhm" open
import: "../../private/theory_support.rhm" as Lib
import: "../../fusion.rhm" open
import: "../../equal.rhm" as Equal
import: "../../tactics.rhm" as Tactics
import: "../../itab.rhm" as Itab
import: "../../simp.rhm" as Simp
import: "../../ind_defs.rhm" as IndDefs
import: "../../compute.rhm" as Compute
import: "../../arith.rhm" as Arith
import: "../../calc_num.rhm" as CalcNum
import: "../../lists.rhm" as Lists
import: "../../int.rhm" as Int
import: "../../define.rhm" as Define

fun assert_conv(conv, tm, tm_prime):
  let [asl, etm] = dest_thm(conv(tm))
  asl == PairList [] && is_eq(etm) && Equal.lhs(etm) == tm && Equal.rhs(etm) == tm_prime

fun result(conv, tm): Equal.rhs(concl(conv(tm)))

// Test COMPUTE_CONVs.
def compute_if_open = @hol|{if x then 1 + 2 else 3 + 4}|
def compute_if_true = @hol|{if true then 1 + 2 else 3 + 4}|
def compute_three = @hol|{3}|
def compute_lambda = @hol|{\x. x + (1 + 2)}|
def compute_beta = @hol|{(\x. x + (1 + 2)) (3 + 4)}|
def compute_ten = @hol|{10}|
def compute_unknown = @hol|{(unknown_fn:num->num) (1+2)}|
def compute_unknown_reduced = @hol|{(unknown_fn:num->num) 3}|
check result(CalcNum.NUM_COMPUTE_CONV, compute_if_open) ~is compute_if_open
check result(CalcNum.NUM_COMPUTE_CONV, compute_if_true) ~is compute_three
check result(CalcNum.NUM_COMPUTE_CONV, compute_lambda) ~is compute_lambda
check result(CalcNum.NUM_COMPUTE_CONV, compute_beta) ~is compute_ten
// Arguments are reduced when the fn is a constant.
check result(CalcNum.NUM_COMPUTE_CONV, compute_unknown) ~is compute_unknown_reduced

// Test list-specific evaluation conversions.
def list_of_seq_in = @hol|{list_of_seq (\i. f(i + 17):B) 3}|
def list_of_seq_out = @hol|{[f (0 + 17):B; f (1 + 17); f (2 + 17)]}|
def el_in = @hol|{EL 1 [0;1;2;3;4]}|
def el_out = @hol|{1}|
def length_in = @hol|{LENGTH[1;2;3;4;5]}|
def length_out = @hol|{5}|
def reverse_in = @hol|{REVERSE[a:X;b;c;d]}|
def reverse_out = @hol|{[d:X;c;b;a]}|
check assert_conv(Lists.LIST_OF_SEQ_CONV, list_of_seq_in, list_of_seq_out) ~is #true
check assert_conv(Lists.EL_CONV, el_in, el_out) ~is #true
check assert_conv(Lists.LENGTH_CONV, length_in, length_out) ~is #true
check assert_conv(Lists.REVERSE_CONV, reverse_in, reverse_out) ~is #true

// Test basic_compset.
def cbv_genabs_in = @hol|{(\((x,y),(z,w)). x + y + z + w) ((1,2),(3,4))}|
def cbv_genabs_out = @hol|{1 + 2 + 3 + 4}|
def cbv_body_in = @hol|{(\((x,y),(z,w)):(num#num)#(num#num). true /\ true)}|
def cbv_body_out = @hol|{(\((x,y),(z,w)):(num#num)#(num#num). true)}|
def cbv_match_in = @hol|{match [1;2;3;4;5] with [] -> [] | CONS x (CONS y z) -> z}|
def cbv_match_out = @hol|{[3; 4; 5]}|
def cbv_let_in = @hol|{let x = 1 in x + 2}|
def cbv_let_out = @hol|{1 + 2}|
def cs = Compute.Compute.basic_compset(#void)
def cv = Compute.Compute.CBV_CONV(cs)
def wcv = Compute.Compute.WEAK_CBV_CONV(cs)
// Generalized abstraction
check result(wcv, cbv_genabs_in) ~is cbv_genabs_out
check result(cv, cbv_genabs_in) ~is cbv_genabs_out
// Abstraction body is not reduced if WEAK_CBV is used
check result(wcv, cbv_body_in) ~is cbv_body_in
check result(cv, cbv_body_in) ~is cbv_body_out
// Match
check result(wcv, cbv_match_in) ~is cbv_match_out
check result(cv, cbv_match_in) ~is cbv_match_out
// Let
check result(wcv, cbv_let_in) ~is cbv_let_out
check result(cv, cbv_let_in) ~is cbv_let_out

// Test benign redefinition when polymorphic type is involved.
// The second quotation is expanded after the first definition, so it
// mentions the new constant exactly as the upstream parser would.
def benign_define_first = @hol|{(h_benign:A list -> num) [] = 0 /\
  h_benign (CONS _ t) = 1 + h_benign t}|
def benign_define_1 = Define.define(benign_define_first)
def benign_define_second = @hol|{(h_benign:A list -> num) [] = 0 /\
  h_benign (CONS _ t) = 1 + h_benign t}|
def benign_define_2 = Define.define(benign_define_second)
check concl(benign_define_2) ~is concl(benign_define_1)

// Test benign redefinition of an inductive datatype.
def benign_inductive_first = @hol|{(forall s. steps (step:S->S->bool) 0 (s:S) (s:S)) /\
  (forall s s'' n. (exists s'. step s s' /\ steps step n s' s'')
     ==> steps step (n+1) s s'')}|
def benign_inductive_1 = IndDefs.new_inductive_definition(benign_inductive_first)
def benign_inductive_second = @hol|{(forall s. steps (step:S->S->bool) 0 (s:S) (s:S)) /\
  (forall s s'' n. (exists s'. step s s' /\ steps step n s' s'')
     ==> steps step (n+1) s s'')}|
def benign_inductive_2 = IndDefs.new_inductive_definition(benign_inductive_second)
check map(concl)(PairList [benign_inductive_2[0], benign_inductive_2[1], benign_inductive_2[2]]) ~is map(concl)(PairList [benign_inductive_1[0], benign_inductive_1[1], benign_inductive_1[2]])

// The THEN-form proofs of the 'er' subgoal-package tests.
def er_goal_1 = @hol|{x + 1 = 1 + x /\ 1 + 1 = 2}|
def er_goal_2 = @hol|{(x + 1 = 1 + x /\ (x + y) + z = x + (y + z)) /\ 1 + 1 = 2}|
check concl(Tactics.prove([er_goal_1,
                           Tactics.THEN(Tactics.THENL(Tactics.CONJ_TAC)(PairList [Tactics.ALL_TAC, Int.ARITH_TAC]))(
                             Simp.REWRITE_TAC(PairList [Arith.ADD_SYM]))])) ~is er_goal_1
check concl(Tactics.prove([er_goal_2,
                           Tactics.THEN(Tactics.THENL(Tactics.CONJ_TAC)(PairList [Tactics.CONJ_TAC, Int.ARITH_TAC]))(
                             Simp.REWRITE_TAC(PairList [Arith.ADD_AC]))])) ~is er_goal_2
check concl(Tactics.prove([er_goal_1,
                           Tactics.THENL(Tactics.CONJ_TAC)(PairList [Int.ARITH_TAC, Int.ARITH_TAC])])) ~is er_goal_1

// Test functions in lib.
fun option_value(o):
  match o
  | Some(v): v
  | None(): #false
check option_value(find_index(fun(x): x == 10)(PairList [0, 10, 20])) ~is 1
check option_value(find_index(fun(x): x == 99)(PairList [0, 10, 20])) ~is #false
check index(10)(PairList [0, 10, 20]) ~is 1
check can(index(99))(PairList [0, 10, 20]) ~is #false

// Test bignum.
check power_num(0)(0) ~is 1
check power_num(2)(3) ~is 8
check power_num(1 / 2)(3) ~is 1 / 8
check power_num(1 / 2)(4) ~is 1 / 16
check power_num(1 / 2)(-3) ~is 8
check power_num(1 / 2)(-4) ~is 16
check power_num(1 / 2)(0) ~is 1

// Test UNIFY_REFL_TAC.
def unify_refl_1 = @hol|{?x. 1 = x}|
def unify_refl_2 = @hol|{?f. y + z = f y z}|
def unify_refl_3 = @hol|{?f. y + 1 = f y 0}|
def unify_refl_tac = Tactics.THEN(Tactics.META_EXISTS_TAC)(Itab.UNIFY_REFL_TAC)
check concl(Tactics.prove([unify_refl_1, unify_refl_tac])) ~is unify_refl_1
check concl(Tactics.prove([unify_refl_2, unify_refl_tac])) ~is unify_refl_2
check concl(Tactics.prove([unify_refl_3, unify_refl_tac])) ~is unify_refl_3
