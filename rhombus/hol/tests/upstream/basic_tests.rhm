#lang rhombus
// Port of UnitTests/basic_tests.ml from the pinned HOL Light revision.
// Quotations are expanded offline by tools/hol_light_golden/basic_tests_terms.ml
// and replayed through the Rhombus kernel. Upstream sections that test the
// text parser/printer, the pa_j preprocessor, the goalstack (g/e/er/b/top_thm),
// OCaml's bignum `pow`, or hol_lib.ml's check_axioms are outside the port.
import: "../../private/quoted_ast.rhm" open
import: "../../private/compat.rhm" open
import: "../../private/data_types.rhm" open
import: "../../private/theory_support.rhm" as Lib
import: "../../fusion.rhm" open
import: "../../equal.rhm" as Equal
import: "../../tactics.rhm" as Tactics
import: "../../itab.rhm" as Itab
import: "../../simp.rhm" as Simp
import: "../../ind_defs.rhm" as IndDefs
import: "../../compute.rhm" as Compute
import: "../../arith.rhm" as Arith
import: "../../calc_num.rhm" as CalcNum
import: "../../lists.rhm" as Lists
import: "../../int.rhm" as Int
import: "../../define.rhm" as Define

fun assert_conv(conv, tm, tm_prime):
  let [asl, etm] = dest_thm(conv(tm))
  asl == PairList [] && is_eq(etm) && Equal.lhs(etm) == tm && Equal.rhs(etm) == tm_prime

fun result(conv, tm): Equal.rhs(concl(conv(tm)))

// Test COMPUTE_CONVs.
def compute_if_open = hol_term(App(Const("COND", Fun(Bool, Fun(Num, Fun(Num, Num)))), [Var("x", Bool), App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])]), App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])])])]))
def compute_if_true = hol_term(App(Const("COND", Fun(Bool, Fun(Num, Fun(Num, Num)))), [Const("T", Bool), App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])]), App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])])])]))
def compute_three = hol_term(App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]))
def compute_lambda = hol_term(Abs(Var("x", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("x", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])])])))
def compute_beta = hol_term(App(Abs(Var("x", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("x", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])])])), [App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])])])]))
def compute_ten = hol_term(App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])])]))
def compute_unknown = hol_term(App(Var("unknown_fn", Fun(Num, Num)), [App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])])]))
def compute_unknown_reduced = hol_term(App(Var("unknown_fn", Fun(Num, Num)), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])]))
check result(CalcNum.NUM_COMPUTE_CONV, compute_if_open) ~is compute_if_open
check result(CalcNum.NUM_COMPUTE_CONV, compute_if_true) ~is compute_three
check result(CalcNum.NUM_COMPUTE_CONV, compute_lambda) ~is compute_lambda
check result(CalcNum.NUM_COMPUTE_CONV, compute_beta) ~is compute_ten
// Arguments are reduced when the fn is a constant.
check result(CalcNum.NUM_COMPUTE_CONV, compute_unknown) ~is compute_unknown_reduced

