#lang rhombus
// Port of UnitTests/basic_tests.ml from the pinned HOL Light revision.
// Quotations are expanded offline by
// tools/hol_light_golden/basic_tests_terms.ml and to_hol.py, and replayed
// through the Rhombus kernel. Upstream sections that test the text
// parser/printer, the pa_j preprocessor, the goalstack (g/e/er/b/top_thm),
// OCaml's bignum `pow`, or hol_lib.ml's check_axioms are outside the port.
import: "../../private/hol_quote.rhm" open
import:
  "../../lib.rhm" open:
    except: check
  "../../private/ocaml.rhm" open
import: "../../private/theory_support.rhm" as Lib
import: "../../fusion.rhm" open
import: "../../equal.rhm" as Equal
import: "../../tactics.rhm" as Tactics
import: "../../itab.rhm" as Itab
import: "../../simp.rhm" as Simp
import: "../../ind_defs.rhm" as IndDefs
import: "../../compute.rhm" as Compute
import: "../../arith.rhm" as Arith
import: "../../calc_num.rhm" as CalcNum
import: "../../lists.rhm" as Lists
import: "../../int.rhm" as Int
import: "../../define.rhm" as Define
import: "../support/statement.rhm" open

fun assert_conv(conv, tm, tm_prime):
  let [asl, etm] = dest_thm(conv(tm))
  asl == PairList [] && is_eq(etm) && aconv(Equal.lhs(etm))(tm) && aconv(Equal.rhs(etm))(tm_prime)

// Test COMPUTE_CONVs.
def compute_if_open = hol:
  var x :: bool
  if x | (1 :: num) + (2 :: num) | (3 :: num) + (4 :: num)
def compute_if_true = hol:
  if #true | (1 :: num) + (2 :: num) | (3 :: num) + (4 :: num)
def compute_three = hol:
  (3 :: num)
def compute_lambda = hol:
  fun (x :: num): x + ((1 :: num) + (2 :: num))
def compute_beta = hol:
  (fun (x :: num): x + ((1 :: num) + (2 :: num)))((3 :: num) + (4 :: num))
def compute_ten = hol:
  (10 :: num)
def compute_unknown = hol:
  var unknown_fn :: num -> num
  unknown_fn((1 :: num) + (2 :: num))
def compute_unknown_reduced = hol:
  var unknown_fn :: num -> num
  unknown_fn((3 :: num))
check assert_conv(CalcNum.NUM_COMPUTE_CONV, compute_if_open, compute_if_open) ~is #true
check assert_conv(CalcNum.NUM_COMPUTE_CONV, compute_if_true, compute_three) ~is #true
check assert_conv(CalcNum.NUM_COMPUTE_CONV, compute_lambda, compute_lambda) ~is #true
check assert_conv(CalcNum.NUM_COMPUTE_CONV, compute_beta, compute_ten) ~is #true
// Arguments are reduced when the fn is a constant.
check assert_conv(CalcNum.NUM_COMPUTE_CONV, compute_unknown, compute_unknown_reduced) ~is #true

// Test list-specific evaluation conversions.
def list_of_seq_in = hol:
  var f :: num -> B
  const list_of_seq :: (num -> A) -> num -> list(A)
  list_of_seq(fun (i :: num): f(i + (17 :: num)), (3 :: num))
def list_of_seq_out = hol:
  var f :: num -> B
  const CONS :: A -> list(A) -> list(A)
  const NIL :: list(A)
  CONS(
    f((0 :: num) + (17 :: num)),
    CONS(f((1 :: num) + (17 :: num)), CONS(f((2 :: num) + (17 :: num)), NIL))
  )
def el_in = hol:
  const EL :: num -> list(A) -> A
  const CONS :: A -> list(A) -> list(A)
  const NIL :: list(A)
  EL(
    (1 :: num),
    CONS(
      (0 :: num),
      CONS((1 :: num), CONS((2 :: num), CONS((3 :: num), CONS((4 :: num), NIL))))
    )
  )
def el_out = hol:
  (1 :: num)
def length_in = hol:
  const LENGTH :: list(A) -> num
  const CONS :: A -> list(A) -> list(A)
  const NIL :: list(A)
  LENGTH(
    CONS(
      (1 :: num),
      CONS((2 :: num), CONS((3 :: num), CONS((4 :: num), CONS((5 :: num), NIL))))
    )
  )
def length_out = hol:
  (5 :: num)
def reverse_in = hol:
  var a :: X
  var b :: X
  var c :: X
  var d :: X
  const REVERSE :: list(A) -> list(A)
  const CONS :: A -> list(A) -> list(A)
  const NIL :: list(A)
  REVERSE(CONS(a, CONS(b, CONS(c, CONS(d, NIL)))))
def reverse_out = hol:
  var d :: X
  var c :: X
  var b :: X
  var a :: X
  const CONS :: A -> list(A) -> list(A)
  const NIL :: list(A)
  CONS(d, CONS(c, CONS(b, CONS(a, NIL))))
check assert_conv(Lists.LIST_OF_SEQ_CONV, list_of_seq_in, list_of_seq_out) ~is #true
check assert_conv(Lists.EL_CONV, el_in, el_out) ~is #true
check assert_conv(Lists.LENGTH_CONV, length_in, length_out) ~is #true
check assert_conv(Lists.REVERSE_CONV, reverse_in, reverse_out) ~is #true

// Test basic_compset.
def cbv_genabs_in = hol:
  const GABS :: (A -> bool) -> A
  const GEQ :: A -> A -> bool
  const #{|,|} :: A -> B -> pair(A, B)
  GABS(
    fun (f :: pair(pair(num, num), pair(num, num)) -> num):
      forall (x :: num, y :: num, z :: num, w :: num):
        GEQ(f(#{|,|}(#{|,|}(x, y), #{|,|}(z, w))), x + (y + (z + w))),
    #{|,|}(#{|,|}((1 :: num), (2 :: num)), #{|,|}((3 :: num), (4 :: num)))
  )
def cbv_genabs_out = hol:
  (1 :: num) + ((2 :: num) + ((3 :: num) + (4 :: num)))
def cbv_body_in = hol:
  const GABS :: (A -> bool) -> A
  const GEQ :: A -> A -> bool
  const #{|,|} :: A -> B -> pair(A, B)
  GABS(
    fun (f :: pair(pair(num, num), pair(num, num)) -> bool):
      forall (x :: num, y :: num, z :: num, w :: num):
        GEQ(f(#{|,|}(#{|,|}(x, y), #{|,|}(z, w))), #true && #true)
  )
def cbv_body_out = hol:
  const GABS :: (A -> bool) -> A
  const GEQ :: A -> A -> bool
  const #{|,|} :: A -> B -> pair(A, B)
  GABS(
    fun (f :: pair(pair(num, num), pair(num, num)) -> bool):
      forall (x :: num, y :: num, z :: num, w :: num):
        GEQ(f(#{|,|}(#{|,|}(x, y), #{|,|}(z, w))), #true)
  )
def cbv_match_in = hol:
  const _MATCH :: A -> (A -> B -> bool) -> B
  const CONS :: A -> list(A) -> list(A)
  const NIL :: list(A)
  const _SEQPATTERN :: (A -> B -> bool) -> (A -> B -> bool) -> A -> B -> bool
  const _UNGUARDED_PATTERN :: bool -> bool -> bool
  const GEQ :: A -> A -> bool
  _MATCH(
    CONS(
      (1 :: num),
      CONS((2 :: num), CONS((3 :: num), CONS((4 :: num), CONS((5 :: num), NIL))))
    ),
    _SEQPATTERN(
      fun (gen_pvar_372 :: list(num), gen_pvar_373 :: list(num)):
        _UNGUARDED_PATTERN(GEQ(NIL, gen_pvar_372), GEQ(NIL, gen_pvar_373)),
      fun (gen_pvar_374 :: list(num), gen_pvar_375 :: list(num)):
        exists (x :: num, y :: num, z :: list(num)):
          _UNGUARDED_PATTERN(GEQ(CONS(x, CONS(y, z)), gen_pvar_374), GEQ(z, gen_pvar_375))
    )
  )
def cbv_match_out = hol:
  const CONS :: A -> list(A) -> list(A)
  const NIL :: list(A)
  CONS((3 :: num), CONS((4 :: num), CONS((5 :: num), NIL)))
def cbv_let_in = hol:
  const LET :: (A -> B) -> A -> B
  const LET_END :: A -> A
  LET(fun (x :: num): LET_END(x + (2 :: num)), (1 :: num))
def cbv_let_out = hol:
  (1 :: num) + (2 :: num)
def cs = Compute.Compute.basic_compset(#void)
def cv = Compute.Compute.CBV_CONV(cs)
def wcv = Compute.Compute.WEAK_CBV_CONV(cs)
// Generalized abstraction
check assert_conv(wcv, cbv_genabs_in, cbv_genabs_out) ~is #true
check assert_conv(cv, cbv_genabs_in, cbv_genabs_out) ~is #true
// Abstraction body is not reduced if WEAK_CBV is used
check assert_conv(wcv, cbv_body_in, cbv_body_in) ~is #true
check assert_conv(cv, cbv_body_in, cbv_body_out) ~is #true
// Match
check assert_conv(wcv, cbv_match_in, cbv_match_out) ~is #true
check assert_conv(cv, cbv_match_in, cbv_match_out) ~is #true
// Let
check assert_conv(wcv, cbv_let_in, cbv_let_out) ~is #true
check assert_conv(cv, cbv_let_in, cbv_let_out) ~is #true

// Test benign redefinition when polymorphic type is involved.
// The second quotation is expanded after the first definition, so it
// mentions the new constant exactly as the upstream parser would.
def benign_define_first = hol:
  var h_benign :: list(A) -> num
  var #{_} :: A
  var t :: list(A)
  const NIL :: list(A)
  const CONS :: A -> list(A) -> list(A)
  h_benign(NIL) == (0 :: num) && h_benign(CONS(#{_}, t)) == (1 :: num) + h_benign(t)
def benign_define_1 = Define.define(benign_define_first)
def benign_define_second = hol:
  var #{_} :: #{?143304}
  var t :: list(#{?143304})
  const h_benign :: list(A) -> num
  const NIL :: list(A)
  const CONS :: A -> list(A) -> list(A)
  h_benign(NIL) == (0 :: num) && h_benign(CONS(#{_}, t)) == (1 :: num) + h_benign(t)
def benign_define_2 = Define.define(benign_define_second)
check same_statement(benign_define_2, benign_define_1) ~is #true

// Test benign redefinition of an inductive datatype.
def benign_inductive_first = hol:
  var steps :: (S -> S -> bool) -> num -> S -> S -> bool
  var step :: S -> S -> bool
  (forall s :: S: steps(step, (0 :: num), s, s))
    && (forall (s :: S, s_prime2 :: S, n :: num):
          (exists s_prime :: S: step(s, s_prime) && steps(step, n, s_prime, s_prime2))
            ==> steps(step, n + (1 :: num), s, s_prime2))
def benign_inductive_1 = IndDefs.new_inductive_definition(benign_inductive_first)
def benign_inductive_second = hol:
  var step :: S -> S -> bool
  const steps :: (S -> S -> bool) -> num -> S -> S -> bool
  (forall s :: S: steps(step, (0 :: num), s, s))
    && (forall (s :: S, s_prime2 :: S, n :: num):
          (exists s_prime :: S: step(s, s_prime) && steps(step, n, s_prime, s_prime2))
            ==> steps(step, n + (1 :: num), s, s_prime2))
def benign_inductive_2 = IndDefs.new_inductive_definition(benign_inductive_second)
check (for all (i in [0, 1, 2]): same_statement(benign_inductive_2[i], benign_inductive_1[i])) ~is #true

// The THEN-form proofs of the 'er' subgoal-package tests.
def er_goal_1 = hol:
  var x :: num
  x + (1 :: num) == (1 :: num) + x && (1 :: num) + (1 :: num) == (2 :: num)
def er_goal_2 = hol:
  var x :: num
  var y :: num
  var z :: num
  x + (1 :: num) == (1 :: num) + x
    && x + y + z == x + (y + z)
    && (1 :: num) + (1 :: num) == (2 :: num)
check proves(
  Tactics.prove([
    er_goal_1,
    Tactics.THEN(Tactics.THENL(Tactics.CONJ_TAC)(PairList [Tactics.ALL_TAC, Int.ARITH_TAC]))(
      Simp.REWRITE_TAC(PairList [Arith.ADD_SYM]))
  ]),
  er_goal_1
) ~is #true
check proves(
  Tactics.prove([
    er_goal_2,
    Tactics.THEN(Tactics.THENL(Tactics.CONJ_TAC)(PairList [Tactics.CONJ_TAC, Int.ARITH_TAC]))(
      Simp.REWRITE_TAC(PairList [Arith.ADD_AC]))
  ]),
  er_goal_2
) ~is #true
check proves(
  Tactics.prove([
    er_goal_1,
    Tactics.THENL(Tactics.CONJ_TAC)(PairList [Int.ARITH_TAC, Int.ARITH_TAC])
  ]),
  er_goal_1
) ~is #true

// Test functions in lib.
fun option_value(o):
  match o
  | Some(v): v
  | None(): #false
check option_value(find_index(fun(x): x == 10)(PairList [0, 10, 20])) ~is 1
check option_value(find_index(fun(x): x == 99)(PairList [0, 10, 20])) ~is #false
check index(10)(PairList [0, 10, 20]) ~is 1
check can(index(99))(PairList [0, 10, 20]) ~is #false

// Test bignum.
check power_num(0)(0) ~is 1
check power_num(2)(3) ~is 8
check power_num(1 / 2)(3) ~is 1 / 8
check power_num(1 / 2)(4) ~is 1 / 16
check power_num(1 / 2)(-3) ~is 8
check power_num(1 / 2)(-4) ~is 16
check power_num(1 / 2)(0) ~is 1

// Test UNIFY_REFL_TAC.
def unify_refl_1 = hol:
  exists x :: num: (1 :: num) == x
def unify_refl_2 = hol:
  var y :: num
  var z :: num
  exists f :: num -> num -> num: y + z == f(y, z)
def unify_refl_3 = hol:
  var y :: num
  exists f :: num -> num -> num: y + (1 :: num) == f(y, (0 :: num))
def unify_refl_tac = Tactics.THEN(Tactics.META_EXISTS_TAC)(Itab.UNIFY_REFL_TAC)
check proves(Tactics.prove([unify_refl_1, unify_refl_tac]), unify_refl_1) ~is #true
check proves(Tactics.prove([unify_refl_2, unify_refl_tac]), unify_refl_2) ~is #true
check proves(Tactics.prove([unify_refl_3, unify_refl_tac]), unify_refl_3) ~is #true
