def cbv_match_out = hol_term(App(Const("CONS", Fun(Num, Fun(Tyapp("list", [Num]), Tyapp("list", [Num])))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]), App(Const("CONS", Fun(Num, Fun(Tyapp("list", [Num]), Tyapp("list", [Num])))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])]), App(Const("CONS", Fun(Num, Fun(Tyapp("list", [Num]), Tyapp("list", [Num])))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])]), Const("NIL", Tyapp("list", [Num]))])])]))
def cbv_let_in = hol_term(App(Const("LET", Fun(Fun(Num, Num), Fun(Num, Num))), [Abs(Var("x", Num), App(Const("LET_END", Fun(Num, Num)), [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("x", Num), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])])])), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]))
def cbv_let_out = hol_term(App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])]))
def cs = Compute.Compute.basic_compset(#void)
def cv = Compute.Compute.CBV_CONV(cs)
def wcv = Compute.Compute.WEAK_CBV_CONV(cs)
// Generalized abstraction
check result(wcv, cbv_genabs_in) ~is cbv_genabs_out
check result(cv, cbv_genabs_in) ~is cbv_genabs_out
// Abstraction body is not reduced if WEAK_CBV is used
check result(wcv, cbv_body_in) ~is cbv_body_in
check result(cv, cbv_body_in) ~is cbv_body_out
// Match
check result(wcv, cbv_match_in) ~is cbv_match_out
check result(cv, cbv_match_in) ~is cbv_match_out
// Let
check result(wcv, cbv_let_in) ~is cbv_let_out
check result(cv, cbv_let_in) ~is cbv_let_out

// Test benign redefinition when polymorphic type is involved.
// The second quotation is expanded after the first definition, so it
// mentions the new constant exactly as the upstream parser would.
def benign_define_first = hol_term(App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Var("h_benign", Fun(Tyapp("list", [Tvar("A")]), Num)), [Const("NIL", Tyapp("list", [Tvar("A")]))]), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]), App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Var("h_benign", Fun(Tyapp("list", [Tvar("A")]), Num)), [App(Const("CONS", Fun(Tvar("A"), Fun(Tyapp("list", [Tvar("A")]), Tyapp("list", [Tvar("A")])))), [Var("_", Tvar("A")), Var("t", Tyapp("list", [Tvar("A")]))])]), App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), App(Var("h_benign", Fun(Tyapp("list", [Tvar("A")]), Num)), [Var("t", Tyapp("list", [Tvar("A")]))])])])]))
def benign_define_1 = Define.define(benign_define_first)
def benign_define_second = hol_term(App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Const("h_benign", Fun(Tyapp("list", [Tvar("A")]), Num)), [Const("NIL", Tyapp("list", [Tvar("A")]))]), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])]), App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Const("h_benign", Fun(Tyapp("list", [Tvar("?143304")]), Num)), [App(Const("CONS", Fun(Tvar("?143304"), Fun(Tyapp("list", [Tvar("?143304")]), Tyapp("list", [Tvar("?143304")])))), [Var("_", Tvar("?143304")), Var("t", Tyapp("list", [Tvar("?143304")]))])]), App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), App(Const("h_benign", Fun(Tyapp("list", [Tvar("?143304")]), Num)), [Var("t", Tyapp("list", [Tvar("?143304")]))])])])]))
def benign_define_2 = Define.define(benign_define_second)
check concl(benign_define_2) ~is concl(benign_define_1)

// Test benign redefinition of an inductive datatype.
def benign_inductive_first = hol_term(App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("!", Fun(Fun(Tvar("S"), Bool), Bool)), [Abs(Var("s", Tvar("S")), App(Var("steps", Fun(Fun(Tvar("S"), Fun(Tvar("S"), Bool)), Fun(Num, Fun(Tvar("S"), Fun(Tvar("S"), Bool))))), [Var("step", Fun(Tvar("S"), Fun(Tvar("S"), Bool))), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]), Var("s", Tvar("S")), Var("s", Tvar("S"))]))]), App(Const("!", Fun(Fun(Tvar("S"), Bool), Bool)), [Abs(Var("s", Tvar("S")), App(Const("!", Fun(Fun(Tvar("S"), Bool), Bool)), [Abs(Var("s''", Tvar("S")), App(Const("!", Fun(Fun(Num, Bool), Bool)), [Abs(Var("n", Num), App(Const("==>", Fun(Bool, Fun(Bool, Bool))), [App(Const("?", Fun(Fun(Tvar("S"), Bool), Bool)), [Abs(Var("s'", Tvar("S")), App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Var("step", Fun(Tvar("S"), Fun(Tvar("S"), Bool))), [Var("s", Tvar("S")), Var("s'", Tvar("S"))]), App(Var("steps", Fun(Fun(Tvar("S"), Fun(Tvar("S"), Bool)), Fun(Num, Fun(Tvar("S"), Fun(Tvar("S"), Bool))))), [Var("step", Fun(Tvar("S"), Fun(Tvar("S"), Bool))), Var("n", Num), Var("s'", Tvar("S")), Var("s''", Tvar("S"))])]))]), App(Var("steps", Fun(Fun(Tvar("S"), Fun(Tvar("S"), Bool)), Fun(Num, Fun(Tvar("S"), Fun(Tvar("S"), Bool))))), [Var("step", Fun(Tvar("S"), Fun(Tvar("S"), Bool))), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("n", Num), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]), Var("s", Tvar("S")), Var("s''", Tvar("S"))])]))]))]))])]))
def benign_inductive_1 = IndDefs.new_inductive_definition(benign_inductive_first)
def benign_inductive_second = hol_term(App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("!", Fun(Fun(Tvar("S"), Bool), Bool)), [Abs(Var("s", Tvar("S")), App(Const("steps", Fun(Fun(Tvar("S"), Fun(Tvar("S"), Bool)), Fun(Num, Fun(Tvar("S"), Fun(Tvar("S"), Bool))))), [Var("step", Fun(Tvar("S"), Fun(Tvar("S"), Bool))), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)]), Var("s", Tvar("S")), Var("s", Tvar("S"))]))]), App(Const("!", Fun(Fun(Tvar("S"), Bool), Bool)), [Abs(Var("s", Tvar("S")), App(Const("!", Fun(Fun(Tvar("S"), Bool), Bool)), [Abs(Var("s''", Tvar("S")), App(Const("!", Fun(Fun(Num, Bool), Bool)), [Abs(Var("n", Num), App(Const("==>", Fun(Bool, Fun(Bool, Bool))), [App(Const("?", Fun(Fun(Tvar("S"), Bool), Bool)), [Abs(Var("s'", Tvar("S")), App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Var("step", Fun(Tvar("S"), Fun(Tvar("S"), Bool))), [Var("s", Tvar("S")), Var("s'", Tvar("S"))]), App(Const("steps", Fun(Fun(Tvar("S"), Fun(Tvar("S"), Bool)), Fun(Num, Fun(Tvar("S"), Fun(Tvar("S"), Bool))))), [Var("step", Fun(Tvar("S"), Fun(Tvar("S"), Bool))), Var("n", Num), Var("s'", Tvar("S")), Var("s''", Tvar("S"))])]))]), App(Const("steps", Fun(Fun(Tvar("S"), Fun(Tvar("S"), Bool)), Fun(Num, Fun(Tvar("S"), Fun(Tvar("S"), Bool))))), [Var("step", Fun(Tvar("S"), Fun(Tvar("S"), Bool))), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("n", Num), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]), Var("s", Tvar("S")), Var("s''", Tvar("S"))])]))]))]))])]))
def benign_inductive_2 = IndDefs.new_inductive_definition(benign_inductive_second)
check map(concl)(PairList [benign_inductive_2[0], benign_inductive_2[1], benign_inductive_2[2]]) ~is map(concl)(PairList [benign_inductive_1[0], benign_inductive_1[1], benign_inductive_1[2]])

// The THEN-form proofs of the 'er' subgoal-package tests.
def er_goal_1 = hol_term(App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("x", Num), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]), App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), Var("x", Num)])]), App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])])]))
def er_goal_2 = hol_term(App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("x", Num), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]), App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), Var("x", Num)])]), App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("x", Num), Var("y", Num)]), Var("z", Num)]), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("x", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("y", Num), Var("z", Num)])])])]), App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Const("+", Fun(Num, Fun(Num, Num))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT0", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])])])]))
check concl(Tactics.prove([er_goal_1,
                           Tactics.THEN(Tactics.THENL(Tactics.CONJ_TAC)(PairList [Tactics.ALL_TAC, Int.ARITH_TAC]))(
                             Simp.REWRITE_TAC(PairList [Arith.ADD_SYM]))])) ~is er_goal_1
check concl(Tactics.prove([er_goal_2,
                           Tactics.THEN(Tactics.THENL(Tactics.CONJ_TAC)(PairList [Tactics.CONJ_TAC, Int.ARITH_TAC]))(
                             Simp.REWRITE_TAC(PairList [Arith.ADD_AC]))])) ~is er_goal_2
check concl(Tactics.prove([er_goal_1,
                           Tactics.THENL(Tactics.CONJ_TAC)(PairList [Int.ARITH_TAC, Int.ARITH_TAC])])) ~is er_goal_1

// Test functions in lib.
fun option_value(o):
  match o
  | Some(v): v
  | None(): #false
check option_value(Lib.find_index(fun(x): x == 10)(PairList [0, 10, 20])) ~is 1
check option_value(Lib.find_index(fun(x): x == 99)(PairList [0, 10, 20])) ~is #false
check Lib.index(10)(PairList [0, 10, 20]) ~is 1
check can(Lib.index(99))(PairList [0, 10, 20]) ~is #false

// Test bignum.
check Lib.power_num(Lib.num(0))(Lib.num(0)) ~is Lib.num(1)
check Lib.power_num(Lib.num(2))(Lib.num(3)) ~is Lib.num(8)
check Lib.power_num(Lib.num(1) / Lib.num(2))(Lib.num(3)) ~is Lib.num(1) / Lib.num(8)
check Lib.power_num(Lib.num(1) / Lib.num(2))(Lib.num(4)) ~is Lib.num(1) / Lib.num(16)
check Lib.power_num(Lib.num(1) / Lib.num(2))(Lib.num(-3)) ~is Lib.num(8)
check Lib.power_num(Lib.num(1) / Lib.num(2))(Lib.num(-4)) ~is Lib.num(16)
check Lib.power_num(Lib.num(1) / Lib.num(2))(Lib.num(0)) ~is Lib.num(1)

// Test UNIFY_REFL_TAC.
def unify_refl_1 = hol_term(App(Const("?", Fun(Fun(Num, Bool), Bool)), [Abs(Var("x", Num), App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])]), Var("x", Num)]))]))
def unify_refl_2 = hol_term(App(Const("?", Fun(Fun(Fun(Num, Fun(Num, Num)), Bool), Bool)), [Abs(Var("f", Fun(Num, Fun(Num, Num))), App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("y", Num), Var("z", Num)]), App(Var("f", Fun(Num, Fun(Num, Num))), [Var("y", Num), Var("z", Num)])]))]))
def unify_refl_3 = hol_term(App(Const("?", Fun(Fun(Fun(Num, Fun(Num, Num)), Bool), Bool)), [Abs(Var("f", Fun(Num, Fun(Num, Num))), App(Const("=", Fun(Num, Fun(Num, Bool))), [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("y", Num), App(Const("NUMERAL", Fun(Num, Num)), [App(Const("BIT1", Fun(Num, Num)), [Const("_0", Num)])])]), App(Var("f", Fun(Num, Fun(Num, Num))), [Var("y", Num), App(Const("NUMERAL", Fun(Num, Num)), [Const("_0", Num)])])]))]))
def unify_refl_tac = Tactics.THEN(Tactics.META_EXISTS_TAC)(Itab.UNIFY_REFL_TAC)
check concl(Tactics.prove([unify_refl_1, unify_refl_tac])) ~is unify_refl_1
check concl(Tactics.prove([unify_refl_2, unify_refl_tac])) ~is unify_refl_2
check concl(Tactics.prove([unify_refl_3, unify_refl_tac])) ~is unify_refl_3
