#lang rhombus
// Port of Examples/dickson.ml from the pinned HOL Light revision: Dickson's
// lemma by the minimal bad sequence argument. Quotations are expanded
// offline by tools/hol_light_golden/capture.ml (q<n> in upstream parse
// order); golden_DICKSON is HOL Light's own theorem in the encoding of
// golden/serial.rhm. THEN/THENL share one left-associative level in OCaml,
// so mixed chains are parenthesized explicitly.
import: "../../private/quoted_ast.rhm" open
import: "../../private/compat.rhm" open
import: "../../private/proof_syntax.rhm" open
import: "../golden/serial.rhm" open
import:
  "../../fusion.rhm" open:
    only:
      ASSUME
  "../../equal.rhm" open:
    only:
      GSYM
      LAND_CONV
      ONCE_DEPTH_CONV
  "../../bool.rhm" open:
    only:
      SPEC
      SPECL
  "../../drule.rhm" open:
    only:
      MATCH_MP
  "../../tactics.rhm" open:
    only:
      ALL_TAC
      CONJ_TAC
      DISCH_TAC
      DISCH_THEN
      EXISTS_TAC
      FIRST_X_ASSUM
      GEN_TAC
      MAP_EVERY
      MATCH_ACCEPT_TAC
      MATCH_MP_TAC
      MP_TAC
      REPEAT
      STRIP_ASSUME_TAC
      STRIP_TAC
      SUBGOAL_THEN
      SUBST_ALL_TAC
      UNDISCH_TAC
      X_GEN_TAC
      prove
  "../../simp.rhm" open:
    only:
      ABBREV_TAC
      ASM_REWRITE_TAC
      EXPAND_TAC
      GEN_REWRITE_TAC
      ONCE_REWRITE_TAC
      REWRITE_TAC
      SIMP_TAC
  "../../theorems.rhm" open:
    only:
      LEFT_IMP_EXISTS_THM
      MONO_EXISTS
  "../../class.rhm" open:
    only:
      COND_CASES_TAC
      CONTRAPOS_THM
      NOT_EXISTS_THM
      NOT_FORALL_THM
      NOT_IMP
  "../../meson.rhm" open:
    only:
      ASM_MESON_TAC
      MESON_TAC
  "../../nums.rhm" open:
    only:
      INDUCT_TAC
  "../../arith.rhm" open:
    only:
      ADD_CLAUSES
      LE_LT
      LT
      LT_REFL
      LT_SUC_LE
      LT_TRANS
      NOT_LE
      NOT_LT
      SUB_REFL
  "../../wf.rhm" open:
    only:
      MINIMAL_BAD_SEQUENCE
      WF_MEASURE_GEN
      WF_num
  "../../int.rhm" open:
    only:
      ARITH_RULE

// (a:num < i /\ ~(b < i) /\ i < j ==> a < j + b - i) /\
// (~(a < i) /\ a < b /\ i < j ==> j + a - i < j + b - i)
def q1 = hol_term(App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("==>", Fun(Bool, Fun(Bool, Bool))), [App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("a", Num), Var("i", Num)]), App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("~", Fun(Bool, Bool)), [App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("b", Num), Var("i", Num)])]), App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("i", Num), Var("j", Num)])])]), App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("a", Num), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("j", Num), App(Const("-", Fun(Num, Fun(Num, Num))), [Var("b", Num), Var("i", Num)])])])]), App(Const("==>", Fun(Bool, Fun(Bool, Bool))), [App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("~", Fun(Bool, Bool)), [App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("a", Num), Var("i", Num)])]), App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("a", Num), Var("b", Num)]), App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("i", Num), Var("j", Num)])])]), App(Const("<", Fun(Num, Fun(Num, Bool))), [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("j", Num), App(Const("-", Fun(Num, Fun(Num, Num))), [Var("a", Num), Var("i", Num)])]), App(Const("+", Fun(Num, Fun(Num, Num))), [Var("j", Num), App(Const("-", Fun(Num, Fun(Num, Num))), [Var("b", Num), Var("i", Num)])])])])]))
// bad (SUC n) (x:num->num->num):bool
def q2 = hol_term(App(Var("bad", Fun(Num, Fun(Fun(Num, Fun(Num, Num)), Bool))), [App(Const("SUC", Fun(Num, Num)), [Var("n", Num)]), Var("x", Fun(Num, Fun(Num, Num)))]))
// i:num
def q3 = hol_term(Var("i", Num))
// \k. if k < i then (x:num->num->num) k else x (j + k - i)
def q4 = hol_term(Abs(Var("k", Num), App(Const("COND", Fun(Bool, Fun(Fun(Num, Num), Fun(Fun(Num, Num), Fun(Num, Num))))), [App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("k", Num), Var("i", Num)]), App(Var("x", Fun(Num, Fun(Num, Num))), [Var("k", Num)]), App(Var("x", Fun(Num, Fun(Num, Num))), [App(Const("+", Fun(Num, Fun(Num, Num))), [Var("j", Num), App(Const("-", Fun(Num, Fun(Num, Num))), [Var("k", Num), Var("i", Num)])])])])))
// k:num
def q5 = hol_term(Var("k", Num))
// j:num
def q6 = hol_term(Var("j", Num))
// ~(bad (n:num) (x:num->num->num))
def q7 = hol_term(App(Const("~", Fun(Bool, Bool)), [App(Var("bad", Fun(Num, Fun(Fun(Num, Fun(Num, Num)), Bool))), [Var("n", Num), Var("x", Fun(Num, Fun(Num, Num)))])]))
// y:num->num->num
def q8 = hol_term(Var("y", Fun(Num, Fun(Num, Num))))
// SUC j
def q9 = hol_term(App(Const("SUC", Fun(Num, Num)), [Var("j", Num)]))
// x:num->num->num
def q10 = hol_term(Var("x", Fun(Num, Fun(Num, Num))))
// ?x. bad (SUC n) (x:num->num->num) /\
// !y j. bad (SUC n) y /\ (!i. i < j ==> y i = x i)
// ==> x j n <= y j n
def q11 = hol_term(App(Const("?", Fun(Fun(Fun(Num, Fun(Num, Num)), Bool), Bool)), [Abs(Var("x", Fun(Num, Fun(Num, Num))), App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Var("bad", Fun(Num, Fun(Fun(Num, Fun(Num, Num)), Bool))), [App(Const("SUC", Fun(Num, Num)), [Var("n", Num)]), Var("x", Fun(Num, Fun(Num, Num)))]), App(Const("!", Fun(Fun(Fun(Num, Fun(Num, Num)), Bool), Bool)), [Abs(Var("y", Fun(Num, Fun(Num, Num))), App(Const("!", Fun(Fun(Num, Bool), Bool)), [Abs(Var("j", Num), App(Const("==>", Fun(Bool, Fun(Bool, Bool))), [App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Var("bad", Fun(Num, Fun(Fun(Num, Fun(Num, Num)), Bool))), [App(Const("SUC", Fun(Num, Num)), [Var("n", Num)]), Var("y", Fun(Num, Fun(Num, Num)))]), App(Const("!", Fun(Fun(Num, Bool), Bool)), [Abs(Var("i", Num), App(Const("==>", Fun(Bool, Fun(Bool, Bool))), [App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("i", Num), Var("j", Num)]), App(Const("=", Fun(Fun(Num, Num), Fun(Fun(Num, Num), Bool))), [App(Var("y", Fun(Num, Fun(Num, Num))), [Var("i", Num)]), App(Var("x", Fun(Num, Fun(Num, Num))), [Var("i", Num)])])]))])]), App(Const("<=", Fun(Num, Fun(Num, Bool))), [App(Var("x", Fun(Num, Fun(Num, Num))), [Var("j", Num), Var("n", Num)]), App(Var("y", Fun(Num, Fun(Num, Num))), [Var("j", Num), Var("n", Num)])])]))]))])]))]))
// !n:num x:num->num->num. ~(bad n x)
def q12 = hol_term(App(Const("!", Fun(Fun(Num, Bool), Bool)), [Abs(Var("n", Num), App(Const("!", Fun(Fun(Fun(Num, Fun(Num, Num)), Bool), Bool)), [Abs(Var("x", Fun(Num, Fun(Num, Num))), App(Const("~", Fun(Bool, Bool)), [App(Var("bad", Fun(Num, Fun(Fun(Num, Fun(Num, Num)), Bool))), [Var("n", Num), Var("x", Fun(Num, Fun(Num, Num)))])]))]))]))
// bad = \n x:num->num->num. !i j. i < j ==> ?k. k < n /\ x j k < x i k
def q13 = hol_term(App(Const("=", Fun(Fun(Num, Fun(Fun(Num, Fun(Num, Num)), Bool)), Fun(Fun(Num, Fun(Fun(Num, Fun(Num, Num)), Bool)), Bool))), [Var("bad", Fun(Num, Fun(Fun(Num, Fun(Num, Num)), Bool))), Abs(Var("n", Num), Abs(Var("x", Fun(Num, Fun(Num, Num))), App(Const("!", Fun(Fun(Num, Bool), Bool)), [Abs(Var("i", Num), App(Const("!", Fun(Fun(Num, Bool), Bool)), [Abs(Var("j", Num), App(Const("==>", Fun(Bool, Fun(Bool, Bool))), [App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("i", Num), Var("j", Num)]), App(Const("?", Fun(Fun(Num, Bool), Bool)), [Abs(Var("k", Num), App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("k", Num), Var("n", Num)]), App(Const("<", Fun(Num, Fun(Num, Bool))), [App(Var("x", Fun(Num, Fun(Num, Num))), [Var("j", Num), Var("k", Num)]), App(Var("x", Fun(Num, Fun(Num, Num))), [Var("i", Num), Var("k", Num)])])]))])]))]))])))]))
// !n x:num->num->num. ?i j. i < j /\ (!k. k < n ==> x i k <= x j k)
def q14 = hol_term(App(Const("!", Fun(Fun(Num, Bool), Bool)), [Abs(Var("n", Num), App(Const("!", Fun(Fun(Fun(Num, Fun(Num, Num)), Bool), Bool)), [Abs(Var("x", Fun(Num, Fun(Num, Num))), App(Const("?", Fun(Fun(Num, Bool), Bool)), [Abs(Var("i", Num), App(Const("?", Fun(Fun(Num, Bool), Bool)), [Abs(Var("j", Num), App(Const("/\\", Fun(Bool, Fun(Bool, Bool))), [App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("i", Num), Var("j", Num)]), App(Const("!", Fun(Fun(Num, Bool), Bool)), [Abs(Var("k", Num), App(Const("==>", Fun(Bool, Fun(Bool, Bool))), [App(Const("<", Fun(Num, Fun(Num, Bool))), [Var("k", Num), Var("n", Num)]), App(Const("<=", Fun(Num, Fun(Num, Bool))), [App(Var("x", Fun(Num, Fun(Num, Num))), [Var("i", Num), Var("k", Num)]), App(Var("x", Fun(Num, Fun(Num, Num))), [Var("j", Num), Var("k", Num)])])]))])]))]))]))]))]))

def golden_DICKSON = "[]|-(c\"!\":T\"fun\"(T\"fun\"(T\"num\"(),T\"bool\"()),T\"bool\"()) \\v\"n\":T\"num\"().(c\"!\":T\"fun\"(T\"fun\"(T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"num\"())),T\"bool\"()),T\"bool\"()) \\v\"x\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"num\"())).(c\"?\":T\"fun\"(T\"fun\"(T\"num\"(),T\"bool\"()),T\"bool\"()) \\v\"i\":T\"num\"().(c\"?\":T\"fun\"(T\"fun\"(T\"num\"(),T\"bool\"()),T\"bool\"()) \\v\"j\":T\"num\"().((c\"/\\\\\":T\"fun\"(T\"bool\"(),T\"fun\"(T\"bool\"(),T\"bool\"())) ((c\"<\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"bool\"())) v\"i\":T\"num\"()) v\"j\":T\"num\"())) (c\"!\":T\"fun\"(T\"fun\"(T\"num\"(),T\"bool\"()),T\"bool\"()) \\v\"k\":T\"num\"().((c\"==>\":T\"fun\"(T\"bool\"(),T\"fun\"(T\"bool\"(),T\"bool\"())) ((c\"<\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"bool\"())) v\"k\":T\"num\"()) v\"n\":T\"num\"())) ((c\"<=\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"bool\"())) ((v\"x\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"num\"())) v\"i\":T\"num\"()) v\"k\":T\"num\"())) ((v\"x\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"num\"())) v\"j\":T\"num\"()) v\"k\":T\"num\"())))))))))"

def dickson_tactic:
  let case_bad_sequence:
    ((REWRITE_TAC(PairList [GSYM(NOT_LT)]) \
        then_tac MATCH_MP_TAC(MINIMAL_BAD_SEQUENCE) \
        then_tac ASM_REWRITE_TAC(PairList []) \
        then_tac CONJ_TAC) \
       then_list PairList [MATCH_ACCEPT_TAC(MATCH_MP(WF_MEASURE_GEN)(WF_num)), ALL_TAC]) \
      then_tac X_GEN_TAC(q10) \
      then_tac EXPAND_TAC("bad") \
      then_tac REWRITE_TAC(PairList [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM]) \
      then_tac MAP_EVERY(X_GEN_TAC)(PairList [q3, q6]) \
      then_tac STRIP_TAC \
      then_tac EXISTS_TAC(q9) \
      then_tac X_GEN_TAC(q8) \
      then_tac GEN_REWRITE_TAC(o(LAND_CONV)(ONCE_DEPTH_CONV))(PairList [LT_SUC_LE]) \
      then_tac REWRITE_TAC(PairList [LE_LT]) \
      then_tac STRIP_TAC \
      then_tac MAP_EVERY(EXISTS_TAC)(PairList [q3, q6]) \
      then_tac ASM_MESON_TAC(PairList [])
  let case_minimal:
    (SUBGOAL_THEN(q7)(MP_TAC) \
       then_list PairList [ASM_MESON_TAC(PairList []),
                           EXPAND_TAC("bad") then_tac REWRITE_TAC(PairList [])]) \
      then_tac MAP_EVERY(X_GEN_TAC)(PairList [q3, q6]) \
      then_tac DISCH_TAC \
      then_tac MP_TAC(ASSUME(q2)) \
      then_tac EXPAND_TAC("bad") \
      then_tac REWRITE_TAC(PairList []) \
      then_tac DISCH_THEN(o(MP_TAC)(SPECL(PairList [q3, q6]))) \
      then_tac ASM_REWRITE_TAC(PairList [LT]) \
      then_tac MATCH_MP_TAC(MONO_EXISTS) \
      then_tac X_GEN_TAC(q5) \
      then_tac STRIP_TAC \
      then_tac ASM_REWRITE_TAC(PairList [LT_REFL]) \
      then_tac FIRST_X_ASSUM(SUBST_ALL_TAC) \
      then_tac FIRST_X_ASSUM(o(MP_TAC)(SPEC(q4))) \
      then_tac DISCH_THEN(o(MP_TAC)(SPEC(q3))) \
      then_tac ASM_REWRITE_TAC(PairList [LT_REFL, SUB_REFL, ADD_CLAUSES, NOT_IMP, NOT_LE]) \
      then_tac SIMP_TAC(PairList []) \
      then_tac UNDISCH_TAC(q2) \
      then_tac ONCE_REWRITE_TAC(PairList [GSYM(CONTRAPOS_THM)]) \
      then_tac EXPAND_TAC("bad") \
      then_tac REWRITE_TAC(PairList [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM]) \
      then_tac REPEAT(GEN_TAC) \
      then_tac REPEAT(COND_CASES_TAC then_tac ASM_REWRITE_TAC(PairList [])) \
      then_tac ASM_MESON_TAC(PairList [LT_TRANS, ARITH_RULE(q1)])
  (((((ABBREV_TAC(q13) \
        then_tac SUBGOAL_THEN(q12)(MP_TAC)) \
       then_list PairList [ALL_TAC, EXPAND_TAC("bad") then_tac MESON_TAC(PairList [NOT_LT])]) \
      then_tac INDUCT_TAC) \
     then_list PairList [EXPAND_TAC("bad") then_tac MESON_TAC(PairList [LT]), ALL_TAC]) \
    then_tac REWRITE_TAC(PairList [GSYM(NOT_EXISTS_THM)]) \
    then_tac DISCH_TAC \
    then_tac SUBGOAL_THEN(q11)(STRIP_ASSUME_TAC)) \
    then_list PairList [case_bad_sequence, case_minimal]

check serial_thm(prove([q14, dickson_tactic])) ~is golden_DICKSON
