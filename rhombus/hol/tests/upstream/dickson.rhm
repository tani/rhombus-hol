#lang rhombus
// Port of Examples/dickson.ml from the pinned HOL Light revision: Dickson's
// lemma by the minimal bad sequence argument. Quotations are expanded
// offline by tools/hol_light_golden/capture.ml and to_hol.py (q<n> in
// upstream parse order); golden_DICKSON is HOL Light's own theorem in the
// encoding of golden/serial.rhm. THEN/THENL share one left-associative level
// in OCaml, so mixed chains are parenthesized explicitly.
import: "../../private/hol_quote.rhm" open
import:
  "../../lib.rhm" open:
    except: check
  "../../private/ocaml.rhm" open
import: "../../private/proof_syntax.rhm" open
import: "../golden/serial.rhm" open
import:
  "../../fusion.rhm" open:
    only:
      ASSUME
  "../../equal.rhm" open:
    only:
      GSYM
      LAND_CONV
      ONCE_DEPTH_CONV
  "../../bool.rhm" open:
    only:
      SPEC
      SPECL
  "../../drule.rhm" open:
    only:
      MATCH_MP
  "../../tactics.rhm" open:
    only:
      ALL_TAC
      CONJ_TAC
      DISCH_TAC
      DISCH_THEN
      EXISTS_TAC
      FIRST_X_ASSUM
      GEN_TAC
      MAP_EVERY
      MATCH_ACCEPT_TAC
      MATCH_MP_TAC
      MP_TAC
      REPEAT
      STRIP_ASSUME_TAC
      STRIP_TAC
      SUBGOAL_THEN
      SUBST_ALL_TAC
      UNDISCH_TAC
      X_GEN_TAC
      prove
  "../../simp.rhm" open:
    only:
      ABBREV_TAC
      ASM_REWRITE_TAC
      EXPAND_TAC
      GEN_REWRITE_TAC
      ONCE_REWRITE_TAC
      REWRITE_TAC
      SIMP_TAC
  "../../theorems.rhm" open:
    only:
      LEFT_IMP_EXISTS_THM
      MONO_EXISTS
  "../../class.rhm" open:
    only:
      COND_CASES_TAC
      CONTRAPOS_THM
      NOT_EXISTS_THM
      NOT_FORALL_THM
      NOT_IMP
  "../../meson.rhm" open:
    only:
      ASM_MESON_TAC
      MESON_TAC
  "../../nums.rhm" open:
    only:
      INDUCT_TAC
  "../../arith.rhm" open:
    only:
      ADD_CLAUSES
      LE_LT
      LT
      LT_REFL
      LT_SUC_LE
      LT_TRANS
      NOT_LE
      NOT_LT
      SUB_REFL
  "../../wf.rhm" open:
    only:
      MINIMAL_BAD_SEQUENCE
      WF_MEASURE_GEN
      WF_num
  "../../int.rhm" open:
    only:
      ARITH_RULE

// (a:num < i /\ ~(b < i) /\ i < j ==> a < j + b - i) /\
// (~(a < i) /\ a < b /\ i < j ==> j + a - i < j + b - i)
def q1 = hol:
  var a :: num
  var i :: num
  var b :: num
  var j :: num
  (a < i && (!(b < i) && i < j) ==> a < j + (b - i))
    && (!(a < i) && (a < b && i < j) ==> j + (a - i) < j + (b - i))
// bad (SUC n) (x:num->num->num):bool
def q2 = hol:
  var bad :: num -> (num -> num -> num) -> bool
  var n :: num
  var x :: num -> num -> num
  const SUC :: num -> num
  bad(SUC(n), x)
// i:num
def q3 = hol: var i :: num; i
// \k. if k < i then (x:num->num->num) k else x (j + k - i)
def q4 = hol:
  var i :: num
  var x :: num -> num -> num
  var j :: num
  fun (k :: num): if k < i | x(k) | x(j + (k - i))
// k:num
def q5 = hol: var k :: num; k
// j:num
def q6 = hol: var j :: num; j
// ~(bad (n:num) (x:num->num->num))
def q7 = hol:
  var bad :: num -> (num -> num -> num) -> bool
  var n :: num
  var x :: num -> num -> num
  !bad(n, x)
// y:num->num->num
def q8 = hol: var y :: num -> num -> num; y
// SUC j
def q9 = hol:
  var j :: num
  const SUC :: num -> num
  SUC(j)
// x:num->num->num
def q10 = hol: var x :: num -> num -> num; x
// ?x. bad (SUC n) (x:num->num->num) /\
// !y j. bad (SUC n) y /\ (!i. i < j ==> y i = x i)
// ==> x j n <= y j n
def q11 = hol:
  var bad :: num -> (num -> num -> num) -> bool
  var n :: num
  const SUC :: num -> num
  exists x :: num -> num -> num:
    bad(SUC(n), x)
      && (forall (y :: num -> num -> num, j :: num):
            bad(SUC(n), y) && (forall i :: num: i < j ==> y(i) == x(i)) ==> x(j, n) <= y(j, n))
// !n:num x:num->num->num. ~(bad n x)
def q12 = hol:
  var bad :: num -> (num -> num -> num) -> bool
  forall (n :: num, x :: num -> num -> num): !bad(n, x)
// bad = \n x:num->num->num. !i j. i < j ==> ?k. k < n /\ x j k < x i k
def q13 = hol:
  var bad :: num -> (num -> num -> num) -> bool
  bad
    == (fun (n :: num, x :: num -> num -> num):
          forall (i :: num, j :: num): i < j ==> (exists k :: num: k < n && x(j, k) < x(i, k)))
// !n x:num->num->num. ?i j. i < j /\ (!k. k < n ==> x i k <= x j k)
def q14 = hol:
  forall (n :: num, x :: num -> num -> num):
    exists (i :: num, j :: num): i < j && (forall k :: num: k < n ==> x(i, k) <= x(j, k))

def golden_DICKSON = "[]|-(c\"!\":T\"fun\"(T\"fun\"(T\"num\"(),T\"bool\"()),T\"bool\"()) \\v\"n\":T\"num\"().(c\"!\":T\"fun\"(T\"fun\"(T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"num\"())),T\"bool\"()),T\"bool\"()) \\v\"x\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"num\"())).(c\"?\":T\"fun\"(T\"fun\"(T\"num\"(),T\"bool\"()),T\"bool\"()) \\v\"i\":T\"num\"().(c\"?\":T\"fun\"(T\"fun\"(T\"num\"(),T\"bool\"()),T\"bool\"()) \\v\"j\":T\"num\"().((c\"/\\\\\":T\"fun\"(T\"bool\"(),T\"fun\"(T\"bool\"(),T\"bool\"())) ((c\"<\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"bool\"())) v\"i\":T\"num\"()) v\"j\":T\"num\"())) (c\"!\":T\"fun\"(T\"fun\"(T\"num\"(),T\"bool\"()),T\"bool\"()) \\v\"k\":T\"num\"().((c\"==>\":T\"fun\"(T\"bool\"(),T\"fun\"(T\"bool\"(),T\"bool\"())) ((c\"<\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"bool\"())) v\"k\":T\"num\"()) v\"n\":T\"num\"())) ((c\"<=\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"bool\"())) ((v\"x\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"num\"())) v\"i\":T\"num\"()) v\"k\":T\"num\"())) ((v\"x\":T\"fun\"(T\"num\"(),T\"fun\"(T\"num\"(),T\"num\"())) v\"j\":T\"num\"()) v\"k\":T\"num\"())))))))))"

def dickson_tactic:
  let case_bad_sequence:
    ((REWRITE_TAC(PairList [GSYM(NOT_LT)]) \
        then_tac MATCH_MP_TAC(MINIMAL_BAD_SEQUENCE) \
        then_tac ASM_REWRITE_TAC(PairList []) \
        then_tac CONJ_TAC) \
       then_list PairList [MATCH_ACCEPT_TAC(MATCH_MP(WF_MEASURE_GEN)(WF_num)), ALL_TAC]) \
      then_tac X_GEN_TAC(q10) \
      then_tac EXPAND_TAC("bad") \
      then_tac REWRITE_TAC(PairList [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM]) \
      then_tac MAP_EVERY(X_GEN_TAC)(PairList [q3, q6]) \
      then_tac STRIP_TAC \
      then_tac EXISTS_TAC(q9) \
      then_tac X_GEN_TAC(q8) \
      then_tac GEN_REWRITE_TAC(o(LAND_CONV)(ONCE_DEPTH_CONV))(PairList [LT_SUC_LE]) \
      then_tac REWRITE_TAC(PairList [LE_LT]) \
      then_tac STRIP_TAC \
      then_tac MAP_EVERY(EXISTS_TAC)(PairList [q3, q6]) \
      then_tac ASM_MESON_TAC(PairList [])
  let case_minimal:
    (SUBGOAL_THEN(q7)(MP_TAC) \
       then_list PairList [ASM_MESON_TAC(PairList []),
                           EXPAND_TAC("bad") then_tac REWRITE_TAC(PairList [])]) \
      then_tac MAP_EVERY(X_GEN_TAC)(PairList [q3, q6]) \
      then_tac DISCH_TAC \
      then_tac MP_TAC(ASSUME(q2)) \
      then_tac EXPAND_TAC("bad") \
      then_tac REWRITE_TAC(PairList []) \
      then_tac DISCH_THEN(o(MP_TAC)(SPECL(PairList [q3, q6]))) \
      then_tac ASM_REWRITE_TAC(PairList [LT]) \
      then_tac MATCH_MP_TAC(MONO_EXISTS) \
      then_tac X_GEN_TAC(q5) \
      then_tac STRIP_TAC \
      then_tac ASM_REWRITE_TAC(PairList [LT_REFL]) \
      then_tac FIRST_X_ASSUM(SUBST_ALL_TAC) \
      then_tac FIRST_X_ASSUM(o(MP_TAC)(SPEC(q4))) \
      then_tac DISCH_THEN(o(MP_TAC)(SPEC(q3))) \
      then_tac ASM_REWRITE_TAC(PairList [LT_REFL, SUB_REFL, ADD_CLAUSES, NOT_IMP, NOT_LE]) \
      then_tac SIMP_TAC(PairList []) \
      then_tac UNDISCH_TAC(q2) \
      then_tac ONCE_REWRITE_TAC(PairList [GSYM(CONTRAPOS_THM)]) \
      then_tac EXPAND_TAC("bad") \
      then_tac REWRITE_TAC(PairList [NOT_FORALL_THM, NOT_IMP, LEFT_IMP_EXISTS_THM]) \
      then_tac REPEAT(GEN_TAC) \
      then_tac REPEAT(COND_CASES_TAC then_tac ASM_REWRITE_TAC(PairList [])) \
      then_tac ASM_MESON_TAC(PairList [LT_TRANS, ARITH_RULE(q1)])
  (((((ABBREV_TAC(q13) \
        then_tac SUBGOAL_THEN(q12)(MP_TAC)) \
       then_list PairList [ALL_TAC, EXPAND_TAC("bad") then_tac MESON_TAC(PairList [NOT_LT])]) \
      then_tac INDUCT_TAC) \
     then_list PairList [EXPAND_TAC("bad") then_tac MESON_TAC(PairList [LT]), ALL_TAC]) \
    then_tac REWRITE_TAC(PairList [GSYM(NOT_EXISTS_THM)]) \
    then_tac DISCH_TAC \
    then_tac SUBGOAL_THEN(q11)(STRIP_ASSUME_TAC)) \
    then_list PairList [case_bad_sequence, case_minimal]

check serial_thm(prove([q14, dickson_tactic])) ~is golden_DICKSON
