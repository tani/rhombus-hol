#lang rhombus
// Port of Examples/lagrange_lemma.ml from the pinned HOL Light revision:
// Lagrange's four- and eight-square identities via the ring normalizer,
// REAL_ARITH, and ordered rewriting. Quotations are expanded offline by
// tools/hol_light_golden/capture.ml (q<n> in upstream parse order); the
// golden strings are HOL Light's own theorems in the encoding of
// golden/serial.rhm. The ordered-rewriting proof of LAGRANGE_8 is omitted:
// it takes about seven minutes even in native HOL Light.
import: "../../private/quoted_ast.rhm" open
import:
  "../../lib.rhm" open:
    except: check
  "../../private/ocaml.rhm" open
import: "../golden/serial.rhm" open
import: "../../tactics.rhm" as Tactics
import: "../../equal.rhm" as Equal
import: "../../simp.rhm" as Simp
import: "../../realax.rhm" as Realax
import: "../../realarith.rhm" as Realarith
import: "../../calc_int.rhm" as CalcInt
import: "../../real.rhm" as Real
import: "../../calc_rat.rhm" as CalcRat

