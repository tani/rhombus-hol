#lang rhombus
// Port of Examples/lagrange_lemma.ml from the pinned HOL Light revision:
// Lagrange's four- and eight-square identities via the ring normalizer,
// REAL_ARITH, and ordered rewriting. Quotations are expanded offline by
// tools/hol_light_golden/capture.ml and to_hol.py (q<n> in upstream parse
// order); the golden strings are HOL Light's own theorems in the encoding of
// golden/serial.rhm. The ordered-rewriting proof of LAGRANGE_8 is omitted:
// it takes about seven minutes even in native HOL Light.
import: "../../private/hol_quote.rhm" open
import:
  "../../lib.rhm" open:
    except: check
  "../../private/ocaml.rhm" open
import: "../golden/serial.rhm" open
import: "../../tactics.rhm" as Tactics
import: "../../equal.rhm" as Equal
import: "../../simp.rhm" as Simp
import: "../../realax.rhm" as Realax
import: "../../realarith.rhm" as Realarith
import: "../../calc_int.rhm" as CalcInt
import: "../../real.rhm" as Real
import: "../../calc_rat.rhm" as CalcRat

// ((x1 pow 2) + (x2 pow 2) + (x3 pow 2) + (x4 pow 2)) *
// ((y1 pow 2) + (y2 pow 2) + (y3 pow 2) + (y4 pow 2)) =
// (((((x1*y1) - (x2*y2)) - (x3*y3)) - (x4*y4)) pow 2)  +
// (((((x1*y2) + (x2*y1)) + (x3*y4)) - (x4*y3)) pow 2)  +
// (((((x1*y3) - (x2*y4)) + (x3*y1)) + (x4*y2)) pow 2)  +
// (((((x1*y4) + (x2*y3)) - (x3*y2)) + (x4*y1)) pow 2)
def q1 = hol:
  var x1 :: real
  var x2 :: real
  var x3 :: real
  var x4 :: real
  var y1 :: real
  var y2 :: real
  var y3 :: real
  var y4 :: real
  const real_pow :: real -> num -> real
  ((real_pow(x1, (2 :: num))
      + (real_pow(x2, (2 :: num)) + (real_pow(x3, (2 :: num)) + real_pow(x4, (2 :: num)))))
     * (real_pow(y1, (2 :: num))
          + (real_pow(y2, (2 :: num)) + (real_pow(y3, (2 :: num)) + real_pow(y4, (2 :: num))))))
    == (real_pow(x1 * y1 - x2 * y2 - x3 * y3 - x4 * y4, (2 :: num))
          + (real_pow(x1 * y2 + x2 * y1 + x3 * y4 - x4 * y3, (2 :: num))
               + (real_pow(x1 * y3 - x2 * y4 + x3 * y1 + x4 * y2, (2 :: num))
                    + real_pow(x1 * y4 + x2 * y3 - x3 * y2 + x4 * y1, (2 :: num)))))
// (p1 pow 2 + q1 pow 2 + r1 pow 2 + s1 pow 2 + t1 pow 2 + u1 pow 2 + v1 pow 2 + w1 pow 2) *
// (p2 pow 2 + q2 pow 2 + r2 pow 2 + s2 pow 2 + t2 pow 2 + u2 pow 2 + v2 pow 2 + w2 pow 2)
// = (p1 * p2 - q1 * q2 - r1 * r2 - s1 * s2 - t1 * t2 - u1 * u2 - v1 * v2 - w1 * w2) pow 2 +
// (p1 * q2 + q1 * p2 + r1 * s2 - s1 * r2 + t1 * u2 - u1 * t2 - v1 * w2 + w1 * v2) pow 2 +
// (p1 * r2 - q1 * s2 + r1 * p2 + s1 * q2 + t1 * v2 + u1 * w2 - v1 * t2 - w1 * u2) pow 2 +
// (p1 * s2 + q1 * r2 - r1 * q2 + s1 * p2 + t1 * w2 - u1 * v2 + v1 * u2 - w1 * t2) pow 2 +
// (p1 * t2 - q1 * u2 - r1 * v2 - s1 * w2 + t1 * p2 + u1 * q2 + v1 * r2 + w1 * s2) pow 2 +
// (p1 * u2 + q1 * t2 - r1 * w2 + s1 * v2 - t1 * q2 + u1 * p2 - v1 * s2 + w1 * r2) pow 2 +
// (p1 * v2 + q1 * w2 + r1 * t2 - s1 * u2 - t1 * r2 + u1 * s2 + v1 * p2 - w1 * q2) pow 2 +
// (p1 * w2 - q1 * v2 + r1 * u2 + s1 * t2 - t1 * s2 - u1 * r2 + v1 * q2 + w1 * p2) pow 2
def q2 = hol:
  var p1 :: real
  var q1 :: real
  var r1 :: real
  var s1 :: real
  var t1 :: real
  var u1 :: real
  var v1 :: real
  var w1 :: real
  var p2 :: real
  var q2 :: real
  var r2 :: real
  var s2 :: real
  var t2 :: real
  var u2 :: real
  var v2 :: real
  var w2 :: real
  const real_pow :: real -> num -> real
  ((real_pow(p1, (2 :: num))
      + (real_pow(q1, (2 :: num))
           + (real_pow(r1, (2 :: num))
                + (real_pow(s1, (2 :: num))
                     + (real_pow(t1, (2 :: num))
                          + (real_pow(u1, (2 :: num))
                               + (real_pow(v1, (2 :: num)) + real_pow(w1, (2 :: num)))))))))
     * (real_pow(p2, (2 :: num))
          + (real_pow(q2, (2 :: num))
               + (real_pow(r2, (2 :: num))
                    + (real_pow(s2, (2 :: num))
                         + (real_pow(t2, (2 :: num))
                              + (real_pow(u2, (2 :: num))
                                   + (real_pow(v2, (2 :: num)) + real_pow(w2, (2 :: num))))))))))
    == (real_pow(
          p1 * p2 - q1 * q2 - r1 * r2 - s1 * s2 - t1 * t2 - u1 * u2 - v1 * v2 - w1 * w2,
          (2 :: num)
        )
          + (real_pow(
               p1 * q2
                 + (q1 * p2 + (r1 * s2 - s1 * r2 + (t1 * u2 - u1 * t2 - v1 * w2 + w1 * v2))),
               (2 :: num)
             )
               + (real_pow(
                    p1 * r2
                      - q1 * s2
                      + (r1 * p2 + (s1 * q2 + (t1 * v2 + (u1 * w2 - v1 * t2 - w1 * u2)))),
                    (2 :: num)
                  )
                    + (real_pow(
                         p1 * s2
                           + (q1 * r2
                                - r1 * q2
                                + (s1 * p2 + (t1 * w2 - u1 * v2 + (v1 * u2 - w1 * t2)))),
                         (2 :: num)
                       )
                         + (real_pow(
                              p1 * t2
                                - q1 * u2
                                - r1 * v2
                                - s1 * w2
                                + (t1 * p2 + (u1 * q2 + (v1 * r2 + w1 * s2))),
                              (2 :: num)
                            )
                              + (real_pow(
                                   p1 * u2
                                     + (q1 * t2
                                          - r1 * w2
                                          + (s1 * v2 - t1 * q2 + (u1 * p2 - v1 * s2 + w1 * r2))),
                                   (2 :: num)
                                 )
                                   + (real_pow(
                                        p1 * v2
                                          + (q1 * w2
                                               + (r1 * t2
                                                    - s1 * u2
                                                    - t1 * r2
                                                    + (u1 * s2 + (v1 * p2 - w1 * q2)))),
                                        (2 :: num)
                                      )
                                        + real_pow(
                                            p1 * w2
                                              - q1 * v2
                                              + (r1 * u2
                                                   + (s1 * t2 - t1 * s2 - u1 * r2 + (v1 * q2 + w1 * p2))),
                                            (2 :: num)
                                          ))))))))
// (a = b - c) = (a + c = b)
def q3 = hol:
  var a :: real
  var b :: real
  var c :: real
  a == b - c <=> a + c == b
// (a - b = c) = (a = b + c)
def q4 = hol:
  var a :: real
  var b :: real
  var c :: real
  a - b == c <=> a == b + c
// (a - b) - c = a - (b + c)
def q5 = hol:
  var a :: real
  var b :: real
  var c :: real
  a - b - c == a - (b + c)
// (a - b) + c = (a + c) - b
def q6 = hol:
  var a :: real
  var b :: real
  var c :: real
  a - b + c == a + c - b
// a - (b - c) = a + (c - b)
def q7 = hol:
  var a :: real
  var b :: real
  var c :: real
  a - (b - c) == a + (c - b)
// a + (b - c) = (a + b) - c
def q8 = hol:
  var a :: real
  var b :: real
  var c :: real
  a + (b - c) == a + b - c

