fun lagrange(goal, tac): serial_thm(Tactics.prove([goal, tac]))

// Do the problems the (relatively) efficient way using the normalizer.
check lagrange(q1, Tactics.CONV_TAC(CalcRat.REAL_RING)) ~is golden_LAGRANGE_4
check lagrange(q2, Tactics.CONV_TAC(CalcRat.REAL_RING)) ~is golden_LAGRANGE_8

// Or we can just use REAL_ARITH, which is also reasonably fast.
check lagrange(q1, CalcRat.REAL_ARITH_TAC) ~is golden_LAGRANGE_4
check lagrange(q2, CalcRat.REAL_ARITH_TAC) ~is golden_LAGRANGE_8

// But they can be done (slowly) simply by ordered rewriting.
// OCaml evaluates list elements right to left, hence q8 .. q3.
check lagrange(q1,
               Simp.REWRITE_TAC(PairList [Realarith.REAL_POW_2, Realax.REAL_ADD_LDISTRIB, Real.REAL_ADD_RDISTRIB,
                                          Real.REAL_SUB_LDISTRIB, Real.REAL_SUB_RDISTRIB,
                                          CalcRat.REAL_ARITH(q8),
                                          CalcRat.REAL_ARITH(q7),
                                          CalcRat.REAL_ARITH(q6),
                                          CalcRat.REAL_ARITH(q5),
                                          CalcRat.REAL_ARITH(q4),
                                          CalcRat.REAL_ARITH(q3),
                                          CalcInt.REAL_ADD_AC, Real.REAL_MUL_AC])) ~is golden_LAGRANGE_4
