namespace Ncproof:
  export:
    rename thecops_Ncproof_ctor_Lemma as Lemma
    rename thecops_Ncproof_ctor_Reduction as Reduction
    rename thecops_Ncproof_ctor_Decomposition as Decomposition
    rename thecops_Ncproof_ctor_Extension as Extension
    pp_print_proof
