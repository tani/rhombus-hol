  fun thecops_Ncprint_pp_print_litmat(fi):
    fun(f):
      fun
      | (Ncmatrix.Lit(l)): Print.pp_print_lit(f)(l)
      | (Ncmatrix.Mat(m)): thecops_Ncprint_pp_print_imatrix(fi)(f)(m)

  fun thecops_Ncprint_pp_print_imatrix(fi):
    fun(f):
      fun([i, m]):
        Host.pp_open_box(f)(1)
        fi(f)(i)
        thecops_Ncprint_pp_print_matrix(fi)(f)(m)
        Host.hol_apply_unit(Host.pp_close_box(f))

  fun thecops_Ncprint_pp_print_matrix(fi): Print.pp_with_box(1)(Print.pp_enclose_cut("[")("]")(Print.pp_iter_sp("&")(thecops_Ncprint_pp_print_iclause(fi))))

