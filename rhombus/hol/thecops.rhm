      let port_tmp_3 = Firstorder.Utils.List.map(Fusion.hyp)(prfs)
      let port_tmp_4 = Basics.disjuncts(Fusion.concl(th))
      (if Firstorder.Utils.List.for_all2(Firstorder.Utils.List.mem)(port_tmp_4)(port_tmp_3) | #void | failwith("Assertion failed"))
      let c = Fusion.concl(Firstorder.Utils.List.hd(prfs))
      (if Firstorder.Utils.List.fold_left((fun(acc): (fun(x): (acc && Host.hol_equal(Fusion.concl(x))(c)))))(#true)(prfs) | #void | failwith("Assertion failed"))
      match prfs
      | PairList []: failwith("DISJ_CASES_LIST")
      | PairList [p, & PairList []]: Bool.MP(Bool.DISCH(Fusion.concl(th))(p))(th)
      | PairList [p1, & PairList [p2, & PairList []]]: Bool.DISJ_CASES(th)(p1)(p2)
      | PairList [p, & ps]: Bool.DISJ_CASES(th)(p)(thecops_Ncrecon_DISJ_CASES_LIST(Fusion.ASSUME(snd(Basics.dest_disj(Fusion.concl(th)))))(ps))
    port_tmp_5

