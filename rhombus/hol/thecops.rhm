  fun thecops_Ncsearch_unify_vars([sub, off]):
    fun(l1):
      fun(l2):
        try:
          Host.Some([Cop.Subst.unify_tms(sub)(Firstorder.Utils.List.map(Fol_term.var)(l1))(Firstorder.Utils.List.map(Fol_term.var)(l2)), off])
          ~catch exn:
            match exn
            | Cop.Subst.Unify(): Host.None()
            | exn: Host.hol_raise(exn)

  fun thecops_Ncsearch_unify_rename([sub, off]):
    fun(args1):
      fun([clext, args2, _, vars]):
        try:
          Host.Some((if Host.hol_equal(vars)(0) | [[Cop.Subst.unify_tms(sub)(args1)(args2), off], clext] | [[Cop.Subst.unify_tms_off(off)(sub)(args1)(args2), Host.hol_add(off)(vars)], Extclause.offset_clause_ext(off)(clext)]))
          ~catch exn:
            match exn
            | Cop.Subst.Unify(): Host.None()
            | exn: Host.hol_raise(exn)

  fun thecops_Ncsearch_pick(f):
    fun(l):
      fun go(acc):
        fun
        | (PairList [x, & xs]):
            match f(x)
            | Host.Some(y): [y, (fun(z): Firstorder.Utils.List.rev_append(acc)(PairList.cons(z, xs)))]
            | Host.None(): go(PairList.cons(x, acc))(xs)
        | (PairList []): failwith("pick: no element found")
      go(PairList [])(l)

  fun thecops_Ncsearch_nth_clause(i): (fun([[[j, k], v], _] as c): (if Host.hol_equal(i)(j) | Host.Some(c) | Host.None()))

  fun thecops_Ncsearch_nth_matrix(i):
    fun
    | (Ncmatrix.Lit(_)): Host.None()
    | (Ncmatrix.Mat([[j, k], _] as m)): (if Host.hol_equal(i)(j) | Host.Some(m) | Host.None())

  fun thecops_Ncsearch_unique(f): (fun(l): Host.hol_equal(Firstorder.Utils.List.length(Firstorder.Utils.List.filter_map(f)(l)))(1))

  fun thecops_Ncsearch_prove_ec(k):
    fun(sub):
      fun([[i, v], _, lmext] as clext):
        fun(mi):
          fun(pi):
            (if thecops_Ncsearch_unique(thecops_Ncsearch_nth_clause(i))(mi) | #void | failwith("Assertion failed"))
            (if Host.hol_equal(Firstorder.Utils.List.length(pi))(k) | #void | failwith("Assertion failed"))
            let [[[[i, k1], v1], cla1], miAB] = thecops_Ncsearch_pick(thecops_Ncsearch_nth_clause(i))(mi)
            let alt1_2:
              fun(_):
                match lmext
                | Extclause.Matext(j,_,clext_prime):
                    if Firstorder.Utils.List.mem([j, k1])(pi)
                    | match thecops_Ncsearch_unify_vars(sub)(v)(v1)
                      | Host.None(): Strom.nil
                      | Host.Some(sub2):
                          let [[[j, k1_prime], mi2], claDE] = thecops_Ncsearch_pick(thecops_Ncsearch_nth_matrix(j))(cla1)
                          (if thecops_Ncsearch_unique(thecops_Ncsearch_nth_matrix(j))(cla1) | #void | failwith("Assertion failed"))
                          (if Host.hol_equal(k1)(k1_prime) | #void | failwith("Assertion failed"))
                          Host.hol_pipe(thecops_Ncsearch_prove_ec(k)(sub2)(clext_prime)(mi2)(pi))(Strom.map((fun([sub3, [prefix, postfix], claB1, mi3]): [sub3, [PairList.cons([[i, v1], j], prefix), postfix], claB1, miAB([[[i, k1], v1], claDE(Ncmatrix.Mat([[j, k1], mi3]))])])))
                    | match lmext
                      | _: Strom.nil
                | _: Strom.nil
            let alt2_2:
              fun(_):
                if (Firstorder.Utils.List.mem([i, k1])(pi) && Host.hol_equal(v)(PairList []))
                | Strom.nil
                | let [claB, claC] = Extclause.claBC_of_litmat_ext(lmext)
                  let index_2 = (fun(cla): [[[i, k], v], Ncmatrix.copy_clause(k)(cla)])
                  Strom.cons([sub, [PairList [], clext], index_2(claB), miAB(index_2(claC))])(Strom.nil)
            Strom.append(Strom.cache(alt1_2))(Strom.cache(alt2_2))

  fun thecops_Ncsearch_cut(p): (fun(xs): (fun(ys): (if p | Strom.cut(xs)(ys) | Strom.append(xs)(ys))))

  fun thecops_Ncsearch_prove_lit(opt):
    fun(sub):
      fun([mi, path, pi, lem, lim]):
        fun(lit):
          (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Lit: %s\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit))) | #void)
          (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Path: %s\n%!")(Print.string_of_lits(path)) | #void)
          (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Lemmas: %s\n%!")(Print.string_of_lits(lem)) | #void)
          let neglit_2 = Fol_term.negate_lit(lit)
          let k_2 = Host.hol_lazy((fun(): Firstorder.Utils.List.length(pi)))
          let lemmas_2:
            if Firstorder.Utils.List.exists(Cop.Subst.eq(sub)(lit))(lem)
            | (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("lemma\n%!") | #void)
              Strom.cons([sub, lem, Ncproof.Lemma()])(Strom.nil)
            | Strom.nil
          let reductions_2:
            Host.hol_pipe(Strom.of_list(path))(
              Strom.filter_map(
                fun(p):
                  (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Reduction try %s\n%!")(Print.string_of_lit(p)) | #void)
                  match Cop.Subst.unify(sub)(neglit_2)(p)
                  | Host.Some(sub1):
                      (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Reduction works\n%!") | #void)
                      Host.Some([sub1, lem, Ncproof.Reduction()])
                  | Host.None(): Host.None()))
          let extensions_2:
            Host.hol_pipe(Host.hol_pipe(Ncdatabase.db_entries(neglit_2))(Strom.of_list))(
              Strom.concat_map(
                fun([_, args, ground, vars] as contra):
                  (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Extension try (for lit %s, args (%s), lim %d, vars %d)\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit)))(Host.hol_string_concat(",")(Firstorder.Utils.List.map(Print.string_of_fterm)(args)))(lim)(vars) | #void)
                  if (Host.hol_lt(lim)(0) && Host.hol_not(ground))
                  | Strom.nil
                  | match thecops_Ncsearch_unify_rename(sub)(snd(lit))(contra)
                    | Host.Some([sub1, clext]):
                        (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Extension works (for lit %s, lim %d)\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub1))(lit)))(lim) | #void)
                        (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Old/new offsets: %d/%d\n%!")(snd(sub))(snd(sub1)) | #void)
                        Host.hol_pipe(thecops_Ncsearch_prove_ec(Host.hol_force(k_2))(sub1)(clext)(mi)(pi))(
                          Strom.concat_map(
                            fun([sub2, position, [[i, v], claB1], mi1]):
                              (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Extension clause %s found\n%!")(Ncprint.string_of_nclause(claB1)) | #void)
                              Host.hol_pipe(thecops_Ncsearch_prove_clause(opt)(sub2)([mi1, PairList.cons(lit, path), PairList.cons(i, pi), lem, Host.hol_sub(lim)(1)])(claB1))(Strom.map((fun([sub3, prfs]): [sub3, PairList.cons(lit, lem), Ncproof.Extension(PairList.cons(Ncmatrix.Lit(neglit_2), claB1), position, prfs)])))))
                    | Host.None(): Strom.nil))
          Host.hol_pipe(thecops_Ncsearch_cut(Cop.Subst.ground_lit(fst(sub))(lit))(thecops_Ncsearch_cut(opt.cut1)(lemmas_2)(thecops_Ncsearch_cut(opt.cut2)(reductions_2)(thecops_Ncsearch_cut(opt.cut3)(extensions_2)(Strom.nil))))(Strom.nil))(Strom.map((fun([sub1, lem1, prf1]): [sub1, lem1, [Ncmatrix.Lit(lit), prf1]])))

  fun thecops_Ncsearch_prove_mat(opt):
    fun(sub):
      fun([mi, path, pi, lem, lim]):
        fun([j, mat1]):
          (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("prove_mat\n%!") | #void)
          Host.hol_pipe(Strom.of_list(mat1))(
            Strom.concat_map(
              fun([[i, _] as idx, cla1]):
                (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Decomposition chose: %s\n%!")(Ncprint.string_of_nclause(cla1)) | #void)
                Host.hol_pipe(thecops_Ncsearch_prove_clause(opt)(sub)([mi, path, PairList.cons(i, PairList.cons(j, pi)), lem, lim])(cla1))(Strom.map((fun([sub1, prf1]): [sub1, lem, [Ncmatrix.Mat([j, mat1]), Ncproof.Decomposition(cla1, idx, prf1)]])))))

  fun thecops_Ncsearch_prove_litmat(opt): (fun(sub): (fun(st): Ncmatrix.map_litmat(thecops_Ncsearch_prove_lit(opt)(sub)(st))(thecops_Ncsearch_prove_mat(opt)(sub)(st))))

  fun thecops_Ncsearch_prove_clause(opt):
    fun(sub):
      fun([mi, path, pi, lem, lim]):
        fun
        | (PairList [lm, & cla]):
            let check_2 = Firstorder.Utils.List.exists((fun(x): Firstorder.Utils.List.exists(Cop.Subst.eq(sub)(x))(path)))
            let regularity:
              if opt.improved_regularity
              | check_2(Ncmatrix.clause_lits(PairList.cons(lm, cla)))
              | match lm
                | Ncmatrix.Mat(_): #false
                | Ncmatrix.Lit(l): check_2(PairList.cons(l, Ncmatrix.clause_lits(cla)))
            if regularity
            | (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("regularity\n%!") | #void)
              Strom.nil
            | Host.hol_pipe(thecops_Ncsearch_prove_litmat(opt)(sub)([mi, path, pi, lem, lim])(lm))(Strom.concat_map((fun([sub1, lem1, prf1]): Host.hol_pipe(thecops_Ncsearch_prove_clause(opt)(sub1)([mi, path, pi, lem1, lim])(cla))(Strom.map((fun([sub2, prf2]): [sub2, PairList.cons(prf1, prf2)]))))))
        | (PairList []):
            (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("axiom\n%!") | #void)
            Strom.cons([sub, PairList []])(Strom.nil)

  def unify_vars = thecops_Ncsearch_unify_vars

  def unify_rename = thecops_Ncsearch_unify_rename

  def pick = thecops_Ncsearch_pick

  def nth_clause = thecops_Ncsearch_nth_clause

  def nth_matrix = thecops_Ncsearch_nth_matrix

  def unique = thecops_Ncsearch_unique

  def prove_ec = thecops_Ncsearch_prove_ec

  def cut = thecops_Ncsearch_cut

  def prove_lit = thecops_Ncsearch_prove_lit

  def prove_mat = thecops_Ncsearch_prove_mat

  def prove_litmat = thecops_Ncsearch_prove_litmat

  def prove_clause = thecops_Ncsearch_prove_clause

