                                    »;
                                    (block:«
                                      let bot:«
                                        Ncrecon.bot_of_proof(data)(PairList [])(th)(prfs)
                                      »;
                                      (block:«
                                        (block:«
                                          if Host.ref_get(Firstorder.copverb)
                                          | (block:«
                                            Host.hol_printf("Reconstruction:\n%!");
                                            Host.print_thm(bot)
                                          »)
                                          | #void
                                        »);
                                        (block:«
                                          (block:«
                                            if (block:«
                                              let port_tmp_10 = Fusion.hyp(th);
                                              let port_tmp_11 = Fusion.hyp(bot);
                                              Host.set_eq(port_tmp_11)(port_tmp_10)
                                            »)
                                            | #void
                                            | failwith("Assertion failed")
                                          »);
                                          (block:«
                                            (block:«
                                              if Host.hol_equal(Fusion.concl(bot))(Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]"))
                                              | #void
                                              | failwith("Assertion failed")
                                            »);
                                            bot
                                          »)
                                        »)
                                      »)
                                    »)
                                  »)
                                »)
                              »)
                            »)
                          »)
                        »)
                      »)
                    »)
                  »)
                »)
              »)
            »)
          »)
        »)
