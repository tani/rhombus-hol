      match f(i)
      | Host.Some(x): x
      | Host.None(): thecops_Cop_deepen(f)(Host.hol_add(i)(1))

  fun thecops_Cop_deepen_to(n):
    fun(f):
      fun(i):
        if Host.hol_gt(i)(n)
        | Host.None()
        | match f(i)
          | Host.None(): thecops_Cop_deepen_to(n)(f)(Host.hol_add(i)(1))
          | s: s

  fun thecops_Cop_strategy(opt):
    fun(f):
      if (opt.cut1 || (opt.cut2 || opt.cut3))
      | match thecops_Cop_deepen_to(opt.comp)(f(opt))(0)
        | Host.None(): thecops_Cop_deepen(f(opt.port_update({"cut1": #false, "cut2": #false, "cut3": #false})))(0)
        | Host.Some(prf): prf
      | thecops_Cop_deepen(f(opt))(0)

  def search_opts = thecops_Cop_search_opts

  def deepen = thecops_Cop_deepen

  def deepen_to = thecops_Cop_deepen_to

  def strategy = thecops_Cop_strategy

namespace Equality:
  export:
    create_equality_axioms
    create_eq_axs

  def thecops_Equality_create_equality_axioms:
    let eq_thms = o(Bool.CONJUNCTS)(Tactics.prove)([Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"z\",[\"Tyvar\",\"A\"]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]],[\"Var\",\"z\",[\"Tyvar\",\"A\"]]]]]]]"), Tactics.THEN(Tactics.THEN(Tactics.THEN(Simp.REWRITE_TAC(PairList []))(Class.ASM_CASES_TAC(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]"))))(Simp.ASM_REWRITE_TAC(PairList [])))(Tactics.CONV_TAC(Class.TAUT))])
    let imp_elim_CONV = Simp.REWR_CONV(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]]")))
    let eq_elim_RULE = Drule.MATCH_MP(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]]]")))
    let veq_tm = Fusion.rator(Fusion.rator(Fusion.concl(hd(eq_thms))))
    let create_equivalence_axioms:
      fun([eq, _]):
        let tyins = Basics.type_match(Fusion.type_of(veq_tm))(Fusion.type_of(eq))(PairList [])
        map(Fusion.INST_TYPE(tyins))(eq_thms)
    fun tm_consts(tm):
      fun(acc):
        let [fn, args] = Basics.strip_comb(tm)
        (if Host.hol_equal(args)(PairList []) | acc | itlist(tm_consts)(args)(insert([fn, length(args)])(acc)))
    fun fm_consts(tm):
      fun([preds, funs] as acc):
        try:
          fm_consts(snd(Basics.dest_forall(tm)))(acc)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  fm_consts(snd(Basics.dest_exists(tm)))(acc)
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let [l, r] = Basics.dest_conj(tm)
                          fm_consts(l)(fm_consts(r)(acc))
                          ~catch exn:
                            match exn
                            | Failure(_):
                                try:
                                  let [l, r] = Basics.dest_disj(tm)
                                  fm_consts(l)(fm_consts(r)(acc))
                                  ~catch exn:
                                    match exn
                                    | Failure(_):
                                        try:
                                          let [l, r] = Basics.dest_imp(tm)
                                          fm_consts(l)(fm_consts(r)(acc))
                                          ~catch exn:
                                            match exn
                                            | Failure(_):
                                                try:
                                                  fm_consts(Basics.dest_neg(tm))(acc)
                                                  ~catch exn:
                                                    match exn
                                                    | Failure(_):
                                                        try:
                                                          let [l, r] = Fusion.dest_eq(tm)
                                                          (if Host.hol_equal(Fusion.type_of(l))(Fusion.bool_ty) | fm_consts(r)(fm_consts(l)(acc)) | failwith("atomic equality"))
                                                          ~catch exn:
                                                            match exn
                                                            | Failure(_):
                                                                let [pred, args] = Basics.strip_comb(tm)
                                                                (if Host.hol_equal(args)(PairList []) | acc | [insert([pred, length(args)])(preds), itlist(tm_consts)(args)(funs)])
                                                            | exn: Host.hol_raise(exn)
                                                    | exn: Host.hol_raise(exn)
                                            | exn: Host.hol_raise(exn)
                                    | exn: Host.hol_raise(exn)
                            | exn: Host.hol_raise(exn)
                    | exn: Host.hol_raise(exn)
            | exn: Host.hol_raise(exn)
    let create_congruence_axiom:
      fun(pflag):
        fun([tm, len]):
          let [atys, rty]:
            splitlist(
              fun(ty):
                let [op, l] = Fusion.dest_type(ty)
                (if Host.hol_equal(op)("fun") | [hd(l), hd(tl(l))] | Host.hol_apply_unit(fail)))(Fusion.type_of(tm))
          let ctys = fst(Host.chop_list(len)(atys))
          let largs_2 = map(Basics.genvar)(ctys)
          let rargs_2 = map(Basics.genvar)(ctys)
          let th1 = rev_itlist(C(curry(Fusion.MK_COMB)))(map(o(Fusion.ASSUME)(Fusion.mk_eq))(zip(largs_2)(rargs_2)))(Fusion.REFL(tm))
          let th2 = (if pflag | eq_elim_RULE(th1) | th1)
          itlist((fun(e): (fun(th): Equal.CONV_RULE(imp_elim_CONV)(Bool.DISCH(e)(th)))))(Fusion.hyp(th2))(th2)
    fun(tms):
      let [preds, funs] = itlist(fm_consts)(tms)([PairList [], PairList []])
      let [eqs0, noneqs] = partition((fun([t, _]): (Fusion.is_const(t) && Host.hol_equal(fst(Fusion.dest_const(t)))("="))))(preds)
      if Host.hol_equal(eqs0)(PairList [])
      | PairList []
      | let pcongs_2 = map(create_congruence_axiom(#true))(noneqs)
        let fcongs_2 = map(create_congruence_axiom(#false))(funs)
        let [preds1, _] = itlist(fm_consts)(map(Fusion.concl)(append(pcongs_2)(fcongs_2)))([PairList [], PairList []])
        let eqs1 = filter((fun([t, _]): (Fusion.is_const(t) && Host.hol_equal(fst(Fusion.dest_const(t)))("="))))(preds1)
        let eqs = union(eqs0)(eqs1)
        let equivs = itlist(o(Host.union_prime(Fusion.equals_thm))(create_equivalence_axioms))(eqs)(PairList [])
        append(equivs)(append(pcongs_2)(fcongs_2))

  fun thecops_Equality_create_eq_axs(sym):
    match sym
    | #true: thecops_Equality_create_equality_axioms
    | #false: Meson.Meson.create_equality_axioms

  def create_equality_axioms = thecops_Equality_create_equality_axioms

  def create_eq_axs = thecops_Equality_create_eq_axs

namespace Prepare:
