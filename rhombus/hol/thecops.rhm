namespace Hashek:
  export:
    hashek_def
    hashek_tm
    hashek_thm
    hashek_prop
    hashek_eq
    MARK_CONCL
    MARK_ASSUMS

  def hashek_def = new_definition(Host.hol_term(Iff(Var("hashek", Bool), True)))

  def hashek_tm = Host.hol_term(Const("hashek", Bool))

  def hashek_thm = prove([Host.hol_term(Const("hashek", Bool)), SIMP_TAC(PairList [hashek_def])])

  def hashek_prop:
    prove(
      [
        Host.hol_term(Implies(
          Implies(And(Var("x", Bool), Const("hashek", Bool)), And(Var("y", Bool), Const("hashek", Bool))),
          Implies(Var("x", Bool), Var("y", Bool))
        )),
        SIMP_TAC(PairList [hashek_def])
      ]
    )

  def hashek_eq = prove([Host.hol_term(Iff(Not(Const("hashek", Bool)), False)), SIMP_TAC(PairList [hashek_def])])

  fun MARK_CONCL(label):
    (
      (
        (
          (
            (
              (
                (
                  (
                    USE_THEN(label)((fun(th): UNDISCH_TAC(concl(th)))) then_tac \
                    (
                      fun(g):
                        (if is_imp(snd(g)) | #void | failwith("Assertion failed"))
                        (if Host.hol_equal(snd(dest_imp(snd(g))))(Host.hol_term(False)) | #void | failwith("Assertion failed"))
                        ALL_TAC(g)
                    )
                  ) then_tac \
                  REWRITE_TAC(
                    PairList [
                      TAUT(Host.hol_term(Forall("t", Bool, Iff(Implies(Not(Ref("t")), False), Ref("t")))))
                    ]
                  )
                ) then_tac \
                POP_ASSUM_LIST(
                  (fun(l): ASSUME_TAC((if Host.hol_equal(l)(PairList []) | TRUTH | end_itlist(CONJ)(l))))
                )
              ) then_tac \
              (
                fun(g):
                  (if Host.hol_equal(length(fst(g)))(1) | #void | failwith("Assertion failed"))
                  ALL_TAC(g)
              )
            ) then_tac \
            W(o(MAP_EVERY(o(o(UNDISCH_TAC)(concl))(snd)))(fst))
          ) then_tac \
          MATCH_MP_TAC(hashek_prop)
        ) then_tac \
        DISCH_THEN((fun(th): EVERY(map(ASSUME_TAC)(CONJUNCTS(th)))))
      ) then_tac \
      REFUTE_THEN(ASSUME_TAC)
    )

  def MARK_ASSUMS = RULE_ASSUM_TAC(DISCH(Host.hol_term(Const("hashek", Bool))))

namespace Strom:
  export:
    End_of_strom
    nil
    cons
    rename append_impl as append
    of_list
    to_list
    iter
    rename map_impl as map
    rename mapi_impl as mapi
    take
    take_while
    rename filter_impl as filter
    filter_map
    concat
    concat_map
    next_opt
    cache
    cut
    integers_from

  class End_of_strom()

  fun nil(_): Host.hol_raise(End_of_strom())

  curried fun cons(x, l):
    let past = Box(#false)
    fun(_):
      if Host.ref_get(past)
      | Host.hol_apply_unit(l)
      | Host.ref_set(past)(#true)
        x

  curried fun append_impl(xs, ys):
    let past = Box(#false)
    fun(_):
      if Host.ref_get(past)
      | Host.hol_apply_unit(ys)
      | try:
          Host.hol_apply_unit(xs)
          ~catch exn:
            match exn
            | End_of_strom():
                Host.ref_set(past)(#true)
                Host.hol_apply_unit(ys)
            | exn: Host.hol_raise(exn)

  fun of_list(l):
    let r = Box(l)
    fun(_):
      match Host.ref_get(r)
      | PairList []: Host.hol_raise(End_of_strom())
      | PairList [x, & xs]:
          Host.ref_set(r)(xs)
          x

  fun to_list(l):
    try:
      let x = Host.hol_apply_unit(l)
      PairList [x, & to_list(l)]
      ~catch exn:
        match exn
        | End_of_strom(): PairList []
        | exn: Host.hol_raise(exn)

  curried fun iter(f, l):
    curried fun iter(_):
      let x = Host.hol_apply_unit(l)
      f(x)
      Host.hol_apply_unit(iter)
    try:
      Host.hol_apply_unit(iter)
      ~catch exn:
        match exn
        | End_of_strom(): #void
        | exn: Host.hol_raise(exn)

  curried fun map_impl(f, l, _): f(Host.hol_apply_unit(l))

  curried fun mapi_impl(f, l):
    let i = Box(0)
    fun(_):
      let h = Host.ref_get(i)
      Host.hol_incr(i)
      f(h)(Host.hol_apply_unit(l))

  curried fun take(n, l):
    let i = Box(n)
    fun(_):
      if Host.hol_equal(Host.ref_get(i))(0)
      | Host.hol_raise(End_of_strom())
      | Host.hol_decr(i)
        Host.hol_apply_unit(l)

  curried fun take_while(p, l, _):
    let x = Host.hol_apply_unit(l)
    (if p(x) | x | Host.hol_raise(End_of_strom()))

  curried fun filter_impl(p, l, _):
    let x = Host.hol_apply_unit(l)
    (if p(x) | x | Host.hol_apply_unit(filter_impl(p)(l)))

  curried fun filter_map(f, l, _):
    match f(Host.hol_apply_unit(l))
    | Host.None(): Host.hol_apply_unit(filter_map(f)(l))
    | Host.Some(y): y

  fun concat(ls):
    let last_2 = Box(nil)
    fun concat(_):
      try:
        Host.hol_apply_unit(Host.ref_get(last_2))
        ~catch exn:
          match exn
          | End_of_strom():
              Host.ref_set(last_2)(Host.hol_apply_unit(ls))
              Host.hol_apply_unit(concat)
          | exn: Host.hol_raise(exn)
    concat

  curried fun concat_map(f, l):
    let last_3 = Box(nil)
    curried fun concat_map(_):
      try:
        Host.hol_apply_unit(Host.ref_get(last_3))
        ~catch exn:
          match exn
          | End_of_strom():
              Host.ref_set(last_3)(f(Host.hol_apply_unit(l)))
              Host.hol_apply_unit(concat_map)
          | exn: Host.hol_raise(exn)
    concat_map

  fun next_opt(l):
    try:
      Host.Some(Host.hol_apply_unit(l))
      ~catch exn:
        match exn
        | End_of_strom(): Host.None()
        | exn: Host.hol_raise(exn)

  fun cache(f):
    let result = Box(Host.None())
    fun(_):
      match Host.ref_get(result)
      | Host.None():
          let l = Host.hol_apply_unit(f)
          Host.ref_set(result)(Host.Some(l))
          Host.hol_apply_unit(l)
      | Host.Some(l): Host.hol_apply_unit(l)

  curried fun cut(xs, ys):
    let cut_2 = Box(#false)
    let past_2 = Box(#false)
    fun(_):
      if Host.ref_get(past_2)
      | Host.hol_apply_unit(ys)
      | if Host.ref_get(cut_2)
        | Host.hol_apply_unit(nil)
        | try:
            let x = Host.hol_apply_unit(xs)
            Host.ref_set(cut_2)(#true)
            x
            ~catch exn:
              match exn
              | End_of_strom():
                  Host.ref_set(past_2)(#true)
                  Host.hol_apply_unit(ys)
              | exn: Host.hol_raise(exn)

  fun integers_from(n):
    let i = Box(n)
    fun(_):
      let h = Host.ref_get(i)
      Host.hol_incr(i)
      h

namespace Fol_term:
  export:
    var
    negate_lit
    term_max_var
    lit_max_var
    map_term_vars
    map_lit_vars
    map_term
    term_ground
    lit_ground

  fun var(v): Fvar(v)

  fun negate_lit([i, l]): [Host.hol_neg(i), l]

  fun term_max_var(acc):
    fun
    | (Fvar(x)): Host.hol_max(acc)(x)
    | (Fnapp(_,l)): Utils.List.fold_left(term_max_var)(acc)(l)

  curried fun lit_max_var(acc, [_, a]): Utils.List.fold_left(term_max_var)(acc)(a)

  fun map_term_vars(f):
    fun
    | (Fvar(v)): f(v)
    | (Fnapp(p,t)): Fnapp(p, Utils.List.map(map_term_vars(f))(t))

  curried fun map_lit_vars(f, [p, a]): [p, Utils.List.map(map_term_vars(f))(a)]

  curried fun map_term(fv, fa):
    fun
    | (Fvar(v)): fv(v)
    | (Fnapp(p,a)): fa([p, a])

  fun term_ground(t): map_term(Utils.const(#false), lit_ground)(t)

  fun lit_ground([p, a]): Utils.List.for_all(term_ground)(a)

namespace Print:
  export:
    pp_interleave
    pp_iter
    pp_iter_sp
    pp_enclose
    pp_enclose_cut
    pp_enum
    pp_with_box
    pp_nl
    pp_print_null
    pp_print_var
    pp_print_fterm
    pp_print_lit
    string_of_fterm
    string_of_lit
    string_of_lits

  curried fun pp_interleave(sep, fn, f):
    fun
    | (PairList [x, & PairList [_, & _] as xs]):
        fn(f)(x)
        sep(f)
        pp_interleave(sep, fn, f)(xs)
    | (PairList [x, & PairList []]): fn(f)(x)
    | (PairList []): #void

  fun pp_iter(sep): pp_interleave((fun(f): Host.OCamlFormat.pp_print_string(f)(sep)))

  curried fun pp_iter_sp(sep, fn):
    let sep:
      fun(f):
        Host.pp_print_char(f)(" ")
        Host.OCamlFormat.pp_print_string(f)(sep)
        Host.hol_apply_unit(Host.pp_print_space(f))
    pp_interleave(sep, fn)

  curried fun pp_enclose(start, stop, fn, f, x):
    Host.OCamlFormat.pp_print_string(f)(start)
    fn(f)(x)
    Host.OCamlFormat.pp_print_string(f)(stop)

  curried fun pp_enclose_cut(start, stop, fn):
    pp_enclose(
      start,
      stop,
      fun(f):
        fun(x):
          fn(f)(x)
          Host.hol_apply_unit(Host.pp_print_cut(f))
    )

  curried fun pp_enum(sep, start, stop, fn): pp_enclose(start)(stop)(pp_iter(sep)(fn))

  curried fun pp_with_box(i, fn, f, x):
    Host.pp_open_box(f)(i)
    fn(f)(x)
    Host.hol_apply_unit(Host.pp_close_box(f))

  curried fun pp_nl(fn, f, x):
    fn(f)(x)
    Host.hol_apply_unit(Host.pp_print_newline(f))

  curried fun pp_print_null(f, x): #void

  curried fun pp_print_var(f, i):
    Host.pp_print_char(f)(Host.hol_char_chr(Host.hol_add(65)(Host.hol_mod(i)(26))))
    (if Host.hol_gt(i)(25) | Host.pp_print_int(f)(Host.hol_div(i)(26)) | #void)

  fun pp_print_fterm(f):
    fun
    | (Fvar(i)): pp_print_var(f, i)
    | (Fnapp(i,l)):
        Host.pp_print_term(f)(Meson.Meson.hol_of_const(i))
        (if Host.hol_unequal(l)(PairList []) | pp_enum(",", "(", ")", pp_print_fterm)(f)(l) | #void)

  curried fun pp_print_lit(f, [i, l]):
    (if Host.hol_lt(i)(0) | Host.pp_print_char(f)("~") | #void)
    Host.pp_print_term(f)(Meson.Meson.hol_of_const(Host.abs(i)))
    (if Host.hol_unequal(l)(PairList []) | pp_enum(",", "(", ")", pp_print_fterm)(f)(l) | #void)

  def string_of_fterm = Host.print_to_string(pp_print_fterm)

  def string_of_lit = Host.print_to_string(pp_print_lit)

  def string_of_lits = Host.print_to_string(pp_iter(", ")(pp_print_lit))

namespace Database:
  export:
    clause_max_var
    mapentry
    db
    axioms2db
    db_entries

  fun clause_max_var(cl): Host.hol_add(1)(Host.OCamlList.fold_left(Fol_term.lit_max_var)(-1)(cl))

  fun mapentry([[cl_rest, [p, args]], th]): [args, cl_rest, clause_max_var(PairList [[p, args], & cl_rest]), th]

  def db = Host.Hashtbl.create(10017)

  fun axioms2db(ths):
    Host.Hashtbl.clear(db)
    Host.hol_pipe(Mapping.fol_of_hol_clauses(ths))(Host.OCamlList.iter((fun([p, l]): Host.Hashtbl.add(db)(Host.hol_neg(p))(map(mapentry)(l)))))

  fun db_entries(lit):
    try:
      Host.Hashtbl.find(db)(fst(lit))
      ~catch exn:
        match exn
        | Host.Not_found(): PairList []
        | exn: Host.hol_raise(exn)

curried fun offset_term(off, tm):
  match tm
  | Fvar(v): Fvar(Host.hol_add(v)(off))
  | Fnapp(f,a): Fnapp(f, Host.OCamlList.map(offset_term(off))(a))

curried fun offset_lit(off, [p, pa]): [p, Host.OCamlList.map(offset_term(off))(pa)]

namespace Substlist:
  export:
    Unify
    istriv
    add_subst
    unify_tm
    unify_tms
    unify_lit
    unify_tm_off
    unify_tms_off
    eq_var_tm
    eq_term
    eq_terms
    eq_lit
    inst_tm
    inst_lit
    ground_tm
    ground_lit
    empty
    to_list

  class Unify()

  curried fun istriv(sub, x):
    fun
    | (Fvar(y)):
        if Host.hol_equal(y)(x)
        | #true
        | try:
            let t = Host.OCamlList.assoc(y)(sub)
            istriv(sub, x)(t)
            ~catch exn:
              match exn
              | Host.Not_found(): #false
              | exn: Host.hol_raise(exn)
    | (Fnapp(f,a)): (Host.OCamlList.exists(istriv(sub, x))(a) && Host.hol_raise(Unify()))

  curried fun add_subst(sub, x, t): (if istriv(sub, x)(t) | sub | PairList [[x, t], & sub])

  curried fun unify_tm(sub, tm1, tm2):
    match [tm1, tm2]
    | [Fnapp(f,fargs), Fnapp(g,gargs)]: (if Host.hol_unequal(f)(g) | Host.hol_raise(Unify()) | unify_tms(sub, fargs, gargs))
    | [tm, Fvar(x)]:
        try:
          let t = Host.OCamlList.assoc(x)(sub)
          unify_tm(sub, tm, t)
          ~catch exn:
            match exn
            | Host.Not_found(): add_subst(sub, x, tm)
            | exn: Host.hol_raise(exn)
    | [Fvar(x), tm]:
        try:
          let t = Host.OCamlList.assoc(x)(sub)
          unify_tm(sub, tm, t)
          ~catch exn:
            match exn
            | Host.Not_found(): add_subst(sub, x, tm)
            | exn: Host.hol_raise(exn)

  curried fun unify_tms(sub, l1, l2): Host.OCamlList.fold_left2(unify_tm)(sub)(l1)(l2)

  curried fun unify_lit(env, [h1, l1], [h2, l2]): (if Host.hol_unequal(h1)(h2) | Host.hol_raise(Unify()) | unify_tms(env, l1, l2))

  curried fun unify_tm_off(off, sub, t1, t2):
    match [t1, t2]
    | [Fnapp(f,fargs), Fnapp(g,gargs)]: (if Host.hol_unequal(f)(g) | Host.hol_raise(Unify()) | unify_tms_off(off)(sub)(fargs)(gargs))
    | [_, Fvar(x)]:
        let x = Host.hol_add(x)(off)
        try:
          let t = Host.OCamlList.assoc(x)(sub)
          unify_tm_off(0, sub, t1, t)
          ~catch exn:
            match exn
            | Host.Not_found(): add_subst(sub, x, t1)
            | exn: Host.hol_raise(exn)
    | [Fvar(x), _]:
        try:
          let t = Host.OCamlList.assoc(x)(sub)
          unify_tm_off(off, sub, t, t2)
          ~catch exn:
            match exn
            | Host.Not_found(): add_subst(sub)(x)(offset_term(off, t2))
            | exn: Host.hol_raise(exn)

  fun unify_tms_off(off): Host.OCamlList.fold_left2(unify_tm_off(off))

  curried fun eq_var_tm(sub, x):
    fun
    | (Fvar(y)):
        if Host.hol_equal(y)(x)
        | #true
        | try:
            let t = Host.OCamlList.assoc(y)(sub)
            eq_var_tm(sub, x)(t)
            ~catch exn:
              match exn
              | Host.Not_found(): #false
              | exn: Host.hol_raise(exn)
    | (Fnapp(f,a)): #false

  curried fun eq_term(sub, tm1, tm2):
    match [tm1, tm2]
    | [Fnapp(f,fa), Fnapp(g,ga)]: (Host.hol_equal(f)(g) && eq_terms(sub)(fa)(ga))
    | [_, Fvar(x)]:
        try:
          let t = Host.OCamlList.assoc(x)(sub)
          eq_term(sub, tm1, t)
          ~catch exn:
            match exn
            | Host.Not_found(): eq_var_tm(sub, x)(tm1)
            | exn: Host.hol_raise(exn)
    | [Fvar(x), _]:
        try:
          let t = Host.OCamlList.assoc(x)(sub)
          eq_term(sub, t, tm2)
          ~catch exn:
            match exn
            | Host.Not_found(): eq_var_tm(sub, x)(tm2)
            | exn: Host.hol_raise(exn)

  fun eq_terms(sub): Host.OCamlList.for_all2(eq_term(sub))

  curried fun eq_lit(sub, [p, pa], [q, qa]): (Host.hol_equal(p)(q) && eq_terms(sub)(pa)(qa))

  fun inst_tm(sub):
    fun
    | (Fvar(v)):
        try:
          let t = Host.OCamlList.assoc(v)(sub)
          inst_tm(sub)(t)
          ~catch exn:
            match exn
            | Host.Not_found(): Fvar(v)
            | exn: Host.hol_raise(exn)
    | (Fnapp(f,args)): Fnapp(f, Host.OCamlList.map(inst_tm(sub))(args))

  curried fun inst_lit(sub, [p, l]): [p, Host.OCamlList.map(inst_tm(sub))(l)]

  fun ground_tm(sub):
    fun
    | (Fvar(v)):
        try:
          let t = Host.OCamlList.assoc(v)(sub)
          ground_tm(sub)(t)
          ~catch exn:
            match exn
            | Host.Not_found(): #false
            | exn: Host.hol_raise(exn)
    | (Fnapp(f,args)): Host.OCamlList.for_all(ground_tm(sub))(args)

  curried fun ground_lit(sub, [p, l]): Host.OCamlList.for_all(ground_tm(sub))(l)

  fun empty(_): PairList []

  fun to_list(sub): sub

