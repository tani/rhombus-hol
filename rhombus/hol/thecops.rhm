    string_of_inst_litmat
    print_proofa
    print_proof_def

  class thecops_Ncproof_ctor_Lemma():
    extends Host.HolVariant
    override port_view(): [0, [0, PairList []]]

  class thecops_Ncproof_ctor_Reduction():
    extends Host.HolVariant
    override port_view(): [0, [1, PairList []]]

  class thecops_Ncproof_ctor_Decomposition(field0, field1, field2):
    extends Host.HolVariant
    override port_view(): [1, [0, PairList [this.field0, this.field1, this.field2]]]

  class thecops_Ncproof_ctor_Extension(field0, field1, field2):
    extends Host.HolVariant
    override port_view(): [1, [1, PairList [this.field0, this.field1, this.field2]]]

  fun thecops_Ncproof_pp_print_proof([fl, fc]):
    fun(sub):
      fun(f):
        fun([lit, prf]):
          Host.pp_open_vbox(f)(2)
          Host.OCamlFormat.pp_print_string(f)(fl(sub)(lit))
          Host.pp_print_char(f)(" ")
          thecops_Ncproof_pp_print_prf([fl, fc])(sub)(f)(prf)
          Host.hol_apply_unit(Host.pp_close_box(f))

  fun thecops_Ncproof_pp_print_prf([fl, fc]):
    fun(sub):
      fun(f):
        fun
        | (thecops_Ncproof_ctor_Reduction()): Host.OCamlFormat.pp_print_string(f)("Red")
        | (thecops_Ncproof_ctor_Lemma()): Host.OCamlFormat.pp_print_string(f)("Lem")
        | (thecops_Ncproof_ctor_Decomposition(cl,recon,prfs)):
            Host.OCamlFormat.pp_print_string(f)(Host.hol_concat("Dec ")(fc(cl)))
            thecops_Ncproof_pp_print_proofs([fl, fc])(sub)(f)(prfs)
        | (thecops_Ncproof_ctor_Extension(cl,recon,prfs)):
            Host.OCamlFormat.pp_print_string(f)(Host.hol_concat("Ext ")(fc(cl)))
            thecops_Ncproof_pp_print_proofs([fl, fc])(sub)(f)(prfs)

  fun thecops_Ncproof_pp_print_proofs([fl, fc]):
    fun(sub):
      fun(f):
        Host.OCamlList.iter(
          fun(x):
            Host.hol_apply_unit(Host.pp_print_cut(f))
            thecops_Ncproof_pp_print_proof([fl, fc])(sub)(f)(x))

  fun thecops_Ncproof_string_of_inst_litmat(sub): (fun(litmat): Ncprint.string_of_litmat(litmat))

  fun thecops_Ncproof_print_proofa([fl, fc]): (fun(sub): (fun(prf): Print.pp_nl(thecops_Ncproof_pp_print_proof([fl, fc])(sub))(Host.std_formatter)(prf)))

  fun thecops_Ncproof_print_proof_def(sub): (fun(prf): thecops_Ncproof_print_proofa([thecops_Ncproof_string_of_inst_litmat, Ncprint.string_of_nclause])(sub)(prf))

  def pp_print_proof = thecops_Ncproof_pp_print_proof

  def pp_print_prf = thecops_Ncproof_pp_print_prf

  def pp_print_proofs = thecops_Ncproof_pp_print_proofs

  def string_of_inst_litmat = thecops_Ncproof_string_of_inst_litmat

  def print_proofa = thecops_Ncproof_print_proofa

  def print_proof_def = thecops_Ncproof_print_proof_def

