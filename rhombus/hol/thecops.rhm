    | (thecops_Extclause_ctor_Litext(claB,claC)): thecops_Extclause_ctor_Litext(Firstorder.Utils.Pair.mapn(Ncmatrix.offset_clause(off))(claB), Ncmatrix.offset_clause(off)(claC))
    | (thecops_Extclause_ctor_Matext(j,claLR,clext)): thecops_Extclause_ctor_Matext(j, Firstorder.Utils.Pair.mapn(Ncmatrix.offset_clause(off))(claLR), thecops_Extclause_offset_clause_ext(off)(clext))

  fun thecops_Extclause_offset_clause_ext(off): (fun([iv, matLR, lmext]): [thecops_Extclause_offset_iv(off)(iv), Firstorder.Utils.Pair.mapn(Ncmatrix.offset_matrix(off))(matLR), thecops_Extclause_offset_litmat_ext(off)(lmext)])

  fun thecops_Extclause_claBC_of_litmat_ext
  | thecops_Extclause_claBC_of_litmat_ext(thecops_Extclause_ctor_Litext([claL, claR],claC)): [Firstorder.Utils.List.rev_append(claL)(claR), claC]
  | thecops_Extclause_claBC_of_litmat_ext(thecops_Extclause_ctor_Matext(j,[claL, claR],clext)):
      let [matB_2, matC_2] = thecops_Extclause_matBC_of_clause_ext(clext)
      let claLR_2 = Firstorder.Utils.List.rev_append(claL)(claR)
      [append(matB_2)(claLR_2), PairList.cons(Ncmatrix.Mat([j, matC_2]), claLR_2)]

  fun thecops_Extclause_matBC_of_clause_ext([iv, [matL, matR], lmext]):
    let [claB, claC] = thecops_Extclause_claBC_of_litmat_ext(lmext)
    [claB, PairList.cons([iv, claC], Firstorder.Utils.List.rev_append(matL)(matR))]

  fun thecops_Extclause_litext_of_litmat_ext
  | thecops_Extclause_litext_of_litmat_ext(thecops_Extclause_ctor_Litext(claB,claC)): [claB, claC]
  | thecops_Extclause_litext_of_litmat_ext(thecops_Extclause_ctor_Matext(_,_,clext)): thecops_Extclause_litext_of_clause_ext(clext)

  fun thecops_Extclause_litext_of_clause_ext([_, _, lmext]): thecops_Extclause_litext_of_litmat_ext(lmext)

  fun thecops_Extclause_assert_iclause(matLR): (fun([iv, c]): Host.hol_pipe(Host.hol_pipe(Firstorder.Utils.List.list_rest(c))(Firstorder.Utils.List.concat_map((fun([lm, claLR]): Ncmatrix.map_litmat((fun(lit): PairList.cons([lit, thecops_Extclause_ctor_Litext(claLR, c)], PairList [])))(thecops_Extclause_assert_imatrix(claLR))(lm)))))(Firstorder.Utils.List.map((fun([lit, lmext]): [lit, [iv, matLR, lmext]]))))

  fun thecops_Extclause_assert_imatrix(claLR): (fun([j, mat]): Host.hol_pipe(Host.hol_pipe(Firstorder.Utils.List.list_rest(mat))(Firstorder.Utils.List.concat_map((fun([cla, matLR]): thecops_Extclause_assert_iclause(matLR)(cla)))))(Firstorder.Utils.List.map((fun([lit, claext]): [lit, thecops_Extclause_ctor_Matext(j, claLR, claext)]))))

  fun thecops_Extclause_assert_matrix(mat): Host.hol_pipe(Firstorder.Utils.List.list_rest(mat))(Firstorder.Utils.List.concat_map((fun([cla, matLR]): thecops_Extclause_assert_iclause(matLR)(cla))))

  def offset_iv = thecops_Extclause_offset_iv

  def offset_litmat_ext = thecops_Extclause_offset_litmat_ext

  def offset_clause_ext = thecops_Extclause_offset_clause_ext

