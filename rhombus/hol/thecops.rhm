  fun thecops_Nanocop_start(mat):
    fun port_tmp_6(opt):
      fun port_tmp_5(lim):
        (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Start %d\n%!")(Host.hol_add(lim)(1)) | #void)
        let mati = Ncmatrix.copy_matrix(0)(mat)
        let sub0 = Cop.Subst.empty(1000000)
        let hashek = Firstorder.Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
        fun port_tmp_2(port_tmp_1):
          match port_tmp_1
          | [[[i, _], v] as idx, PairList [Ncmatrix.Lit(lit), & PairList []] as cla]:
              if Host.hol_equal(lit)(hashek)
              | Firstorder.Utils._op3e__op3e__op3d_(Host.hol_pipe(Ncsearch.prove_clause(opt)([sub0, 0])([mati, PairList [], PairList.cons([i, 0],PairList []), PairList [], lim])(cla))(Strom.next_opt))((fun([sub, prfs]): Host.Some([sub, Ncproof.Decomposition(cla,idx,prfs)])))
              | match port_tmp_1
                | _: Host.None()
          | _: Host.None()
        let port_tmp_3 = Strom.filter_map(port_tmp_2)
        let port_tmp_4 = Strom.of_list(mati)
        Firstorder.Utils._op3e__op3e__op3d_(Host.hol_pipe(Host.hol_pipe(port_tmp_4)(port_tmp_3))(Strom.next_opt))((fun([sub, prf]): Host.Some([fst(sub), [Ncmatrix.Mat([[-1, 0], mati]), prf]])))
      port_tmp_5
    port_tmp_6

  fun thecops_Nanocop_fol_of_thm(th):
    let lconsts = Fusion.freesl(Fusion.hyp(th))
    let tm = Fusion.concl(th)
    (if Firstorder.Utils.List.for_all((fun(x): Firstorder.Utils.List.mem(x)(lconsts)))(Fusion.frees(tm)) | #void | failwith("Assertion failed"))
    Firstorder.Mapping.fol_of_form(PairList [])(lconsts)(tm)

  fun thecops_Nanocop_NANOCOP_DEEPEN(opt):
    fun port_tmp_13(ths):
      if Host.ref_get(Firstorder.copverb)
      | Host.hol_printf("NANOCOP_DEEPEN with ths:\n%!")
        Firstorder.Utils.List.iter(o(Host.hol_printf("  th: %s\n%!"))(Host.string_of_thm))(ths)
      | #void
      Host.hol_apply_unit(Firstorder.Mapping.reset_vars)
      Host.hol_apply_unit(Firstorder.Mapping.reset_consts)
      let port_tmp_9 = map(Fusion.concl)
      let port_tmp_7 = Equality.create_eq_axs(opt.add_eq_symmetry)
      let port_tmp_8 = map(Bool.GEN_ALL)
      let port_tmp_10 = o(port_tmp_8)(port_tmp_7)
      let gen_eq = o(port_tmp_10)(port_tmp_9)
      let ths_prime = (if Firstorder.Utils.List.exists((fun(th): Host.hol_equal(Fusion.concl(th))(Hashek.hashek_tm)))(ths) | ths | PairList.cons(Hashek.hashek_thm,ths))
      let ths_prime = Host.setify(append(ths_prime)(gen_eq(ths_prime)))
      let th = end_itlist(Bool.CONJ)(ths_prime)
      let fol = thecops_Nanocop_fol_of_thm(th)
      let mat = Ncmatrix.index_matrix(Ncmatrix.matrix_of_form(fol))
      if Host.ref_get(Firstorder.copverb)
      | Host.hol_printf("Matrix:\n%!")
        Ncprint.print_matrix_i(mat)
      | #void
      Ncdatabase.matrix2db(mat)
      (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Matrix loaded.\n%!") | #void)
      let [sub, prfs] = Cop.strategy(opt)(thecops_Nanocop_start(mat))
      if Host.ref_get(Firstorder.copverb)
      | Host.hol_printf("Theorem\n%!")
        Ncproof.print_proof_def(sub)(prfs)
      | #void
      let data = Ncrecon.mk_recon_data([th, mat, sub])
      let bot = Ncrecon.bot_of_proof(data)(PairList [])(th)(prfs)
      if Host.ref_get(Firstorder.copverb)
      | Host.hol_printf("Reconstruction:\n%!")
        Host.print_thm(bot)
      | #void
      let port_tmp_11 = Fusion.hyp(th)
      let port_tmp_12 = Fusion.hyp(bot)
      (if Host.set_eq(port_tmp_12)(port_tmp_11) | #void | failwith("Assertion failed"))
      (if Host.hol_equal(Fusion.concl(bot))(Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]")) | #void | failwith("Assertion failed"))
      bot
    port_tmp_13

  fun thecops_Nanocop_PRINT_TAC(g):
