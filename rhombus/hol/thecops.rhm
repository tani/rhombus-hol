    unify_lit
    offset_vars
    unify_tm_off
    unify_tms_off
    eq_var_tm
    eq_tm
    eq_lit
    empty
    to_list
    inst_term
    inst_tm
    inst_lit
    ground_tm
    ground_lit

  class Unify()

  fun restore_subst([[suba, env], subl]):
    fun loop():
      if Host.hol_not(Host.hol_physical_equal(Host.ref_get(env))(subl))
      | match Host.ref_get(env)
        | PairList [h, & t]:
            Host.hol_array_set(suba)(h)(Host.None())
            Host.ref_set(env)(t)
        | PairList []: failwith("restore_subst")
        loop()
      | #void
    loop()

  curried fun istriv(suba, x):
    fun
    | (Fvar(y)):
        if Host.hol_equal(y)(x)
        | #true
        | match Host.hol_array_get(suba)(y)
          | Host.Some(t): istriv(suba, x)(t)
          | Host.None(): #false
    | (Fnapp(f,a)): (Host.OCamlList.exists(istriv(suba, x))(a) && Host.hol_raise(Unify()))

  curried fun add_subst([[suba, env], subl] as sub, x, tm):
    if istriv(suba, x)(tm)
    | sub
    | Host.hol_array_set(suba)(x)(Host.Some(tm))
      Host.ref_set(env)(PairList [x, & Host.ref_get(env)])
      [[suba, env], Host.ref_get(env)]

  curried fun unify_tm([[suba, env], subl] as sub, tm1, tm2):
    match [tm1, tm2]
    | [Fnapp(f,fargs), Fnapp(g,gargs)]: (if Host.hol_unequal(f)(g) | Host.hol_raise(Unify()) | Host.OCamlList.fold_left2(unify_tm)(sub)(fargs)(gargs))
    | [tm, Fvar(x)]:
        match Host.hol_array_get(suba)(x)
        | Host.Some(t): unify_tm(sub, tm, t)
        | Host.None(): add_subst(sub, x, tm)
    | [Fvar(x), tm]:
        match Host.hol_array_get(suba)(x)
        | Host.Some(t): unify_tm(sub, tm, t)
        | Host.None(): add_subst(sub, x, tm)

  curried fun unify_tms(sub, l1, l2):
    restore_subst(sub)
    Host.OCamlList.fold_left2(unify_tm)(sub)(l1)(l2)

  curried fun unify_lit(env, [h1, l1], [h2, l2]): (if Host.hol_unequal(h1)(h2) | Host.hol_raise(Unify()) | unify_tms(env, l1, l2))

  fun offset_vars(off):
    fun
    | (Fvar(x)): Fvar(Host.hol_add(x)(off))
    | (Fnapp(x,l)): Fnapp(x, Host.OCamlList.map(offset_vars(off))(l))

  curried fun unify_tm_off(off, [[suba, env], subl] as sub, t1, t2):
    match [t1, t2]
    | [Fnapp(f,fargs), Fnapp(g,gargs)]: (if Host.hol_unequal(f)(g) | Host.hol_raise(Unify()) | Host.OCamlList.fold_left2(unify_tm_off(off))(sub)(fargs)(gargs))
    | [_, Fvar(x)]:
        let x = Host.hol_add(x)(off)
        match Host.hol_array_get(suba)(x)
        | Host.Some(t): unify_tm_off(0, sub, t1, t)
        | Host.None(): add_subst(sub, x, t1)
    | [Fvar(x), _]:
        match Host.hol_array_get(suba)(x)
        | Host.Some(t): unify_tm_off(off, sub, t, t2)
        | Host.None():
            let t2_prime = offset_vars(off)(t2)
            add_subst(sub, x, t2_prime)

  curried fun unify_tms_off(off, sub, l1, l2):
    restore_subst(sub)
    Host.OCamlList.fold_left2(unify_tm_off(off))(sub)(l1)(l2)

  curried fun eq_var_tm(suba, x):
    fun
    | (Fvar(y)):
        if Host.hol_equal(y)(x)
        | #true
        | match Host.hol_array_get(suba)(y)
          | Host.Some(t): eq_var_tm(suba, x)(t)
          | Host.None(): #false
    | (Fnapp(f,a)): #false

  curried fun eq_tm(suba, tm1, tm2):
    match [tm1, tm2]
    | [Fnapp(f,fargs), Fnapp(g,gargs)]: (Host.hol_equal(f)(g) && Host.OCamlList.for_all2(eq_tm(suba))(fargs)(gargs))
    | [_, Fvar(x)]:
        match Host.hol_array_get(suba)(x)
        | Host.Some(t): eq_tm(suba, tm1, t)
        | Host.None(): eq_var_tm(suba, x)(tm1)
    | [Fvar(x), _]:
        match Host.hol_array_get(suba)(x)
        | Host.Some(t): eq_tm(suba, t, tm2)
        | Host.None(): eq_var_tm(suba, x)(tm2)

  curried fun eq_lit([[suba, _], _] as sub, [p1, args1], [p2, args2]):
    if Host.hol_equal(p1)(p2)
    | restore_subst(sub)
      Host.OCamlList.for_all2(eq_tm(suba))(args1)(args2)
    | #false

  fun empty(n):
    let suba_2 = Host.hol_array_make(n)(Host.None())
    let env_2 = Box(PairList [])
    let subl_2 = PairList []
    [[suba_2, env_2], subl_2]

  fun to_list([[suba, env], subl]):
    Host.OCamlList.map(
      fun(v):
        match Host.hol_array_get(suba)(v)
        | Host.None(): failwith("convert_subst")
        | Host.Some(t): [v, t]
    )(subl)

  fun inst_term(suba):
    fun
    | (Fvar(x)):
        match Host.hol_array_get(suba)(x)
        | Host.Some(t): inst_term(suba)(t)
        | Host.None(): Fvar(x)
    | (Fnapp(f,a)): Fnapp(f, Host.OCamlList.map(inst_term(suba))(a))

  curried fun inst_tm([[suba, _], _] as sub, t):
    restore_subst(sub)
    inst_term(suba)(t)

  curried fun inst_lit([[suba, _], _] as sub, [p, l]):
    restore_subst(sub)
    [p, Host.OCamlList.map(inst_term(suba))(l)]

  fun ground_tm(suba):
    fun
    | (Fvar(x)):
        match Host.hol_array_get(suba)(x)
        | Host.Some(t): ground_tm(suba)(t)
        | Host.None(): #false
    | (Fnapp(f,a)): Host.OCamlList.for_all(ground_tm(suba))(a)

  curried fun ground_lit([[suba, _], _] as sub, [p, l]):
    restore_subst(sub)
    Host.OCamlList.for_all(ground_tm(suba))(l)

namespace Cop:
  export:
    Subst
    SearchOpts
    search_opts
    deepen
    deepen_to
    strategy

  namespace Subst:
    export:
      rename include_1.Unify as Unify
      rename included_restore_subst as restore_subst
      rename included_istriv as istriv
      rename included_add_subst as add_subst
      rename included_unify_tm as unify_tm
      rename included_unify_tms as unify_tms
      rename included_unify_lit as unify_lit
      rename included_offset_vars as offset_vars
      rename included_unify_tm_off as unify_tm_off
      rename included_unify_tms_off as unify_tms_off
      rename included_eq_var_tm as eq_var_tm
      rename included_eq_tm as eq_tm
      rename included_eq_lit as eq_lit
      rename included_empty as empty
      rename included_to_list as to_list
      rename included_inst_term as inst_term
      rename included_inst_tm as inst_tm
      rename included_inst_lit as inst_lit
      rename included_ground_tm as ground_tm
      rename included_ground_lit as ground_lit
      eq
      unify
      unify_rename_subst
      unify_rename

    import: .Substarray as include_1

    def included_restore_subst = include_1.restore_subst

    def included_istriv = include_1.istriv

    def included_add_subst = include_1.add_subst

    def included_unify_tm = include_1.unify_tm

    def included_unify_tms = include_1.unify_tms

    def included_unify_lit = include_1.unify_lit

    def included_offset_vars = include_1.offset_vars

    def included_unify_tm_off = include_1.unify_tm_off

    def included_unify_tms_off = include_1.unify_tms_off

    def included_eq_var_tm = include_1.eq_var_tm

    def included_eq_tm = include_1.eq_tm

    def included_eq_lit = include_1.eq_lit

    def included_empty = include_1.empty

    def included_to_list = include_1.to_list

    def included_inst_term = include_1.inst_term

    def included_inst_tm = include_1.inst_tm

    def included_inst_lit = include_1.inst_lit

    def included_ground_tm = include_1.ground_tm

    def included_ground_lit = include_1.ground_lit

    curried fun eq([sub, off], l1, l2): included_eq_lit(sub)(l1)(l2)

    curried fun unify([sub, off], l1, l2):
      try:
        Host.Some([included_unify_lit(sub)(l1)(l2), off])
        ~catch exn:
          match exn
          | include_1.Unify(): Host.None()
          | exn: Host.hol_raise(exn)

    curried fun unify_rename_subst(off, l1, l2, sub, list): [included_unify_tms_off(off)(sub)(l1)(l2), Host.OCamlList.map(offset_lit(off))(list)]

    curried fun unify_rename([s, off], args1, [args2, rest, vars, _]):
      try:
        Host.Some(
          if Host.hol_equal(vars)(0)
          | [[included_unify_tms(s)(args1)(args2), off], rest]
          | let [s, rest] = unify_rename_subst(off, args1, args2, s, rest)
            [[s, Host.hol_add(off)(vars)], rest]
        )
        ~catch exn:
          match exn
          | include_1.Unify(): Host.None()
          | exn: Host.hol_raise(exn)

  record SearchOpts(cut1, cut2, cut3, comp, improved_lemmas, improved_regularity, add_eq_symmetry)

  def search_opts = SearchOpts(#true, #true, #true, 7, #true, #true, #true)

  curried fun deepen(f, i):
    match f(i)
    | Host.Some(x): x
    | Host.None(): deepen(f)(Host.hol_add(i)(1))

  curried fun deepen_to(n, f, i):
    if Host.hol_gt(i)(n)
    | Host.None()
    | match f(i)
      | Host.None(): deepen_to(n)(f)(Host.hol_add(i)(1))
      | s: s

  curried fun strategy(opt, f):
    if (opt.cut1 || (opt.cut2 || opt.cut3))
    | match deepen_to(opt.comp)(f(opt))(0)
      | Host.None(): deepen(f(opt.port_update({"cut1": #false, "cut2": #false, "cut3": #false})), 0)
      | Host.Some(prf): prf
    | deepen(f(opt), 0)

namespace Equality:
  export:
    create_equality_axioms
    create_eq_axs

  def create_equality_axioms:
    let eq_thms:
      o(CONJUNCTS)(prove)(
        [
          Host.hol_term(And(
            Eq(Tvar("A"), Var("x", Tvar("A")), Var("x", Tvar("A"))),
            And(
              Or(
                Not(Eq(Tvar("A"), Var("x", Tvar("A")), Var("y", Tvar("A")))),
                Eq(Tvar("A"), Var("y", Tvar("A")), Var("x", Tvar("A")))
              ),
              Or(
                Not(Eq(Tvar("A"), Var("x", Tvar("A")), Var("y", Tvar("A")))),
                Or(
                  Not(Eq(Tvar("A"), Var("x", Tvar("A")), Var("z", Tvar("A")))),
                  Eq(Tvar("A"), Var("y", Tvar("A")), Var("z", Tvar("A")))
                )
              )
            )
          )),
          (
            (
              (
                REWRITE_TAC(PairList []) then_tac \
                ASM_CASES_TAC(Host.hol_term(Eq(Tvar("A"), Var("x", Tvar("A")), Var("y", Tvar("A")))))
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            CONV_TAC(TAUT)
          )
        ]
      )
    let imp_elim_CONV:
      REWR_CONV(
        TAUT(
          Host.hol_term(Iff(Implies(Var("a", Bool), Var("b", Bool)), Or(Not(Var("a", Bool)), Var("b", Bool))))
        )
      )
    let eq_elim_RULE:
      MATCH_MP(
        TAUT(
          Host.hol_term(Implies(Iff(Var("a", Bool), Var("b", Bool)), Or(Var("b", Bool), Not(Var("a", Bool)))))
        )
      )
    let veq_tm = rator(rator(concl(hd(eq_thms))))
    let create_equivalence_axioms:
      fun([eq, _]):
        let tyins = type_match(type_of(veq_tm))(type_of(eq))(PairList [])
        map(INST_TYPE(tyins))(eq_thms)
    fun tm_consts(tm):
      fun(acc):
        let [fn, args] = strip_comb(tm)
        (if Host.hol_equal(args)(PairList []) | acc | itlist(tm_consts)(args)(insert([fn, length(args)])(acc)))
    fun fm_consts(tm):
      fun([preds, funs] as acc):
        try:
          fm_consts(snd(dest_forall(tm)))(acc)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  fm_consts(snd(dest_exists(tm)))(acc)
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let [l, r] = dest_conj(tm)
                          fm_consts(l)(fm_consts(r)(acc))
                          ~catch exn:
                            match exn
                            | Failure(_):
                                try:
                                  let [l, r] = dest_disj(tm)
                                  fm_consts(l)(fm_consts(r)(acc))
                                  ~catch exn:
                                    match exn
                                    | Failure(_):
                                        try:
                                          let [l, r] = dest_imp(tm)
                                          fm_consts(l)(fm_consts(r)(acc))
                                          ~catch exn:
                                            match exn
                                            | Failure(_):
                                                try:
                                                  fm_consts(dest_neg(tm))(acc)
                                                  ~catch exn:
                                                    match exn
                                                    | Failure(_):
                                                        try:
                                                          let [l, r] = dest_eq(tm)
                                                          (if Host.hol_equal(type_of(l))(bool_ty) | fm_consts(r)(fm_consts(l)(acc)) | failwith("atomic equality"))
                                                          ~catch exn:
                                                            match exn
                                                            | Failure(_):
                                                                let [pred, args] = strip_comb(tm)
                                                                (if Host.hol_equal(args)(PairList []) | acc | [insert([pred, length(args)])(preds), itlist(tm_consts)(args)(funs)])
                                                            | exn: Host.hol_raise(exn)
                                                    | exn: Host.hol_raise(exn)
                                            | exn: Host.hol_raise(exn)
                                    | exn: Host.hol_raise(exn)
                            | exn: Host.hol_raise(exn)
                    | exn: Host.hol_raise(exn)
            | exn: Host.hol_raise(exn)
    let create_congruence_axiom:
      fun(pflag):
        fun([tm, len]):
          let [atys, rty]:
            splitlist(
              fun(ty):
                let [op, l] = dest_type(ty)
                (if Host.hol_equal(op)("fun") | [hd(l), hd(tl(l))] | Host.hol_apply_unit(fail))
            )(type_of(tm))
          let ctys = fst(Host.chop_list(len)(atys))
          let largs_2 = map(genvar)(ctys)
          let rargs_2 = map(genvar)(ctys)
          let th1 = rev_itlist(C(curry(MK_COMB)))(map(o(ASSUME)(mk_eq))(zip(largs_2)(rargs_2)))(REFL(tm))
          let th2 = (if pflag | eq_elim_RULE(th1) | th1)
          itlist((fun(e): (fun(th): CONV_RULE(imp_elim_CONV)(DISCH(e)(th)))))(hyp(th2))(th2)
    fun(tms):
      let [preds, funs] = itlist(fm_consts)(tms)([PairList [], PairList []])
      let [eqs0, noneqs] = partition((fun([t, _]): (is_const(t) && Host.hol_equal(fst(dest_const(t)))("="))))(preds)
      if Host.hol_equal(eqs0)(PairList [])
      | PairList []
      | let pcongs_2 = map(create_congruence_axiom(#true))(noneqs)
        let fcongs_2 = map(create_congruence_axiom(#false))(funs)
        let [preds1, _] = itlist(fm_consts)(map(concl)(append(pcongs_2)(fcongs_2)))([PairList [], PairList []])
        let eqs1 = filter((fun([t, _]): (is_const(t) && Host.hol_equal(fst(dest_const(t)))("="))))(preds1)
        let eqs = union(eqs0)(eqs1)
        let equivs = itlist(o(Host.union_prime(equals_thm))(create_equivalence_axioms))(eqs)(PairList [])
        append(equivs)(append(pcongs_2)(fcongs_2))

  fun create_eq_axs(sym):
    match sym
    | #true: create_equality_axioms
    | #false: Meson.Meson.create_equality_axioms

namespace Prepare:
  export:
    PREPARE_COP_TAC

  fun PREPARE_COP_TAC(ths):
    (
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REFUTE_THEN(LABEL_TAC("copconcl")) then_tac \
                          Meson.Meson.POLY_ASSUME_TAC(map(GEN_ALL)(ths))
                        ) then_tac \
                        (Hashek.MARK_CONCL("copconcl") or_tac Hashek.MARK_ASSUMS)
                      ) then_tac \
                      W(o(MAP_EVERY(o(o(UNDISCH_TAC)(concl))(snd)))(fst))
                    ) then_tac \
                    SELECT_ELIM_TAC
                  ) then_tac \
                  W((fun([asl, w]): MAP_EVERY((fun(v): SPEC_TAC([v, v])))(frees(w))))
                ) then_tac \
                CONV_TAC(
                  (
                    (
                      (
                        (PRESIMP_CONV then_conv TOP_DEPTH_CONV(BETA_CONV)) then_conv \
                        LAMBDA_ELIM_CONV
                      ) then_conv \
                      CONDS_CELIM_CONV
                    ) then_conv \
                    Meson.Meson.QUANT_BOOL_CONV
                  )
                )
              ) then_tac \
              REPEAT((GEN_TAC or_tac DISCH_TAC))
            ) then_tac \
            REFUTE_THEN(ASSUME_TAC)
          ) then_tac \
          RULE_ASSUM_TAC(CONV_RULE((NNF_CONV then_conv SKOLEM_CONV)))
        ) then_tac \
        REPEAT(FIRST_X_ASSUM(CHOOSE_TAC))
      ) then_tac \
      ASM_FOL_TAC
    )

namespace Proof:
  export:
    Lemma
    Reduction
    Extension

  variant proof:
    Lemma()
    Reduction()
    Extension(clause, subproofs)

namespace Search:
  export:
    cut
    prove_lit
    prove_clause

  curried fun cut(p, xs, ys): (if p | Strom.cut(xs)(ys) | Strom.append(xs)(ys))

  curried fun prove_lit(opt, sub, [path, lem, lim], lit):
    (if Host.ref_get(copverb) | Host.hol_printf("Lit: %s\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit))) | #void)
    (if Host.ref_get(copverb) | Host.hol_printf("Path: %s\n%!")(Print.string_of_lits(Utils.List.map(Cop.Subst.inst_lit(fst(sub)))(path))) | #void)
    (if Host.ref_get(copverb) | Host.hol_printf("Lemmas: %s\n%!")(Print.string_of_lits(Utils.List.map(Cop.Subst.inst_lit(fst(sub)))(lem))) | #void)
    let neglit = Fol_term.negate_lit(lit)
    let lemmas_2:
      if opt.improved_lemmas
      | if Utils.List.exists(Cop.Subst.eq(sub)(lit))(lem)
        | (if Host.ref_get(copverb) | Host.hol_printf("lemma\n%!") | #void)
          Strom.cons([sub, lem, Proof.Lemma()])(Strom.nil)
        | Strom.nil
      | Host.hol_pipe(Host.hol_pipe(Strom.of_list(lem))(Strom.filter(Cop.Subst.eq(sub)(lit))))(
          Strom.map(
            fun(l):
              (if Host.ref_get(copverb) | Host.hol_printf("lemma\n%!") | #void)
              [sub, PairList [lit, & lem], Proof.Lemma()]
          )
        )
    let reductions_2:
      Strom.filter_map(
        fun(p):
          (if Host.ref_get(copverb) | Host.hol_printf("Reduction try %s (for lit %s, lim %d)\n%!")(Print.string_of_lit(p))(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit)))(lim) | #void)
          Utils._op3e__op3e__op3d_(Cop.Subst.unify(sub)(neglit)(p))(
            fun(sub1):
              (if Host.ref_get(copverb) | Host.hol_printf("Reduction works\n%!") | #void)
              Host.Some([sub1, PairList [lit, & lem], Proof.Reduction()])
          )
      )(Strom.of_list(path))
    let extensions_2:
      Host.hol_pipe(Host.hol_pipe(Database.db_entries(neglit))(Strom.of_list))(
        Strom.concat_map(
          fun([_, _, vars, hsh] as contra):
            if (Host.hol_lt(lim)(0) && Host.hol_gt(vars)(0))
            | Strom.nil
            | match Cop.Subst.unify_rename(sub)(snd(lit))(contra)
              | Host.Some([sub1, cla1]): Host.hol_pipe(prove_clause(opt)(sub1)([PairList [lit, & path], lem, Host.hol_sub(lim)(1)])([cla1, hsh]))(Strom.map((fun([sub2, prfs]): [sub2, PairList [lit, & lem], Proof.Extension(hsh, prfs)])))
              | Host.None(): Strom.nil
        )
      )
    cut(opt.cut1)(lemmas_2)(cut(opt.cut2)(reductions_2)(cut(opt.cut3, extensions_2, Strom.nil)))

  curried fun prove_clause(opt, sub, [path, lem, lim], [cl, cl_hsh]):
    match cl
    | PairList [lit, & lits]:
        if Utils.List.exists((fun(x): Utils.List.exists(Cop.Subst.eq(sub)(x))(path)))(cl)
        | (if Host.ref_get(copverb) | Host.hol_printf("regularity\n%!") | #void)
          Strom.nil
        | Host.hol_pipe(prove_lit(opt, sub, [path, lem, lim], lit))(
            Strom.concat_map(
              (fun([sub1, lem1, prf1]): Host.hol_pipe(prove_clause(opt, sub1, [path, lem1, lim], [lits, cl_hsh]))(Strom.map((fun([sub2, prfs]): [sub2, PairList [[lit, prf1], & prfs]]))))
            )
          )
    | PairList []: Strom.cons([sub, PairList []])(Strom.nil)

namespace Recon:
  export:
    hol_negate
    hashek_of_proof

  fun hol_negate(tm):
    try:
      dest_neg(tm)
      ~catch exn:
        match exn
        | Failure(_): mk_neg(tm)
        | exn: Host.hol_raise(exn)

  curried fun hashek_of_proof(sub, lem, lit):
    let liti = Mapping.hol_of_literal(Substarray.inst_lit(sub)(lit))
    fun
    | (Proof.Lemma()): find((fun(x): Host.hol_equal(concl(x))(liti)))(lem)
    | (Proof.Reduction()): ASSUME(liti)
    | (Proof.Extension(contra,prfs)):
        let [_, ths]:
          Utils.List.fold_map(
            fun(lem):
              fun([lit, prf]):
                let p = hashek_of_proof(sub, lem, lit)(prf)
                [PairList [p, & lem], p]
          )(lem)(prfs)
        let cth = Meson.Meson.make_hol_contrapos(contra)
        let hth = (if Host.hol_equal(ths)(PairList []) | cth | MATCH_MP(cth)(end_itlist(CONJ)(ths)))
        let ith = PART_MATCH(I)(hth)(liti)
        Meson.Meson.finish_RULE(DISCH(hol_negate(concl(ith)))(ith))

namespace Leancop:
  export:
    start
    LEANCOP_DEEPEN
    PREPARE_LEAN_TAC
    PURE_LEANCOP
    GEN_LEANCOP_TAC
    LEANCOP_TAC
    LEANCOP

  curried fun start(opt, lim):
    (if Host.ref_get(copverb) | Host.hol_printf("Start %d\n%!")(Host.hol_add(lim)(1)) | #void)
    let sub0 = Cop.Subst.empty(1000000)
    let hashek = Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
    let hashek_neg = Fol_term.negate_lit(hashek)
    let prfs = Search.prove_lit(opt)([sub0, 0])([PairList [], PairList [], lim])(hashek_neg)
    match Strom.next_opt(prfs)
    | Host.Some([sub, _, prf]): Host.Some([fst(sub), prf])
    | Host.None(): Host.None()

  curried fun LEANCOP_DEEPEN(opt, ths):
    Host.hol_apply_unit(Meson.Meson.clear_contrapos_cache)
    Host.hol_apply_unit(Mapping.reset_vars)
    Host.hol_apply_unit(Mapping.reset_consts)
    let ths_prime = append(ths)(Equality.create_eq_axs(opt.add_eq_symmetry)(map(concl)(ths)))
    Database.axioms2db(ths_prime)
    let [sub, prf] = Cop.strategy(opt)(start)
    let hashek = Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
    let hashek_neg = Fol_term.negate_lit(hashek)
    let th = Recon.hashek_of_proof(sub)(PairList [])(hashek_neg)(prf)
    EQ_MP(Hashek.hashek_eq)(th)

  fun PREPARE_LEAN_TAC(ths):
    (
      (
        (
          (
            (
              Prepare.PREPARE_COP_TAC(ths) then_tac \
              RULE_ASSUM_TAC(CONV_RULE((PRENEX_CONV then_conv WEAK_CNF_CONV)))
            ) then_tac \
            RULE_ASSUM_TAC(
              Host.repeat(
                (fun(th): SPEC(genvar(type_of(fst(dest_forall(concl(th))))))(th))
              )
            )
          ) then_tac \
          REPEAT(FIRST_X_ASSUM(Meson.Meson.CONJUNCTS_THEN_prime(ASSUME_TAC)))
        ) then_tac \
        RULE_ASSUM_TAC(CONV_RULE(ASSOC_CONV(DISJ_ASSOC)))
      ) then_tac \
      REPEAT(FIRST_X_ASSUM(SUBST_VAR_TAC))
    )

  curried fun PURE_LEANCOP(opt, gl):
    (
      FIRST_ASSUM(CONTR_TAC) or_tac \
      W(o(o(o(ACCEPT_TAC)(LEANCOP_DEEPEN(opt)))(map(snd)))(fst))
    )(gl)

  curried fun GEN_LEANCOP_TAC(opt, ths): (PREPARE_LEAN_TAC(ths) then_tac PURE_LEANCOP(opt))

  fun LEANCOP_TAC(ths): GEN_LEANCOP_TAC(Cop.search_opts, ths)

  curried fun LEANCOP(ths, tm): prove([tm, LEANCOP_TAC(ths)])

namespace Ncmatrix:
  export:
    Lit
    Mat
    map_litmat
    lit
    mat
    lit_of_litmat
    clause_lits
    clause_of_matrix
    strip_disj
    strip_conj
    strip_forallq
    litmat_of_form
    matrix_of_form
    clause_of_form
    iclause_of_form
    litmat_max_var
    imatrix_max_var
    iclause_max_var
    matrix_max_var
    clause_max_var
    clause_offset
    iclause_offset
    clause_ground
    index_imatrix
    rename index_matrix_v2 as index_matrix
    index_iclause
    index_clause
    index_litmat
    map_imatrix
    map_matrix
    map_iclause
    map_clause
    copy_matrix
    copy_clause
    break_map
    litmat_positive
    lit_positive
    imatrix_positive
    matrix_positive
    iclause_positive
    clause_positive
    map_litmat_vars
    map_imatrix_vars
    map_matrix_vars
    map_iclause_vars
    map_clause_vars
    offset_iclause
    offset_clause
    offset_matrix

  variant litmat:
    Lit(literal)
    Mat(matrix)

  curried fun map_litmat(fl, fm):
    fun
    | (Lit(lit)): fl(lit)
    | (Mat(mat)): fm(mat)

  fun lit(x): Lit(x)

  fun mat(x): Mat(x)

  fun lit_of_litmat
  | lit_of_litmat(Lit(l)): Host.Some(l)
  | lit_of_litmat(Mat(_)): Host.None()

  fun clause_lits(c): Utils.List.filter_map(lit_of_litmat)(c)

  fun clause_of_matrix
  | clause_of_matrix(PairList [[[_, PairList []], c], & PairList []]): c
  | clause_of_matrix(lm): PairList [Mat([#void, lm])]

  fun strip_disj
  | strip_disj(Disj(l,r)): append(strip_disj(l))(strip_disj(r))
  | strip_disj(x): PairList [x]

  fun strip_conj
  | strip_conj(Conj(l,r)): append(strip_conj(l))(strip_conj(r))
  | strip_conj(x): PairList [x]

  fun strip_forallq(acc):
    fun
    | (Forallq(x,t)): strip_forallq(PairList [x, & acc])(t)
    | (t): [Utils.List.rev(acc), t]

  fun litmat_of_form
  | litmat_of_form(Atom(t)): Lit(t)
  | litmat_of_form(Conj(_,_) as t): Mat([#void, matrix_of_form(t)])
  | litmat_of_form(Forallq(_,_) as t): Mat([#void, matrix_of_form(t)])
  | litmat_of_form(_): failwith("litmat_of_form")

  fun matrix_of_form(t): Utils.List.map(iclause_of_form)(strip_conj(t))

  fun clause_of_form(t): Utils.List.map(litmat_of_form)(strip_disj(t))

  fun iclause_of_form(t):
    let [univ, t_prime] = strip_forallq(PairList [])(t)
    [[#void, univ], clause_of_form(t_prime)]

  fun litmat_max_var(acc): map_litmat(Fol_term.lit_max_var(acc))(imatrix_max_var(acc))

  curried fun imatrix_max_var(acc, [_, m]): matrix_max_var(acc, m)

  curried fun iclause_max_var(acc, [_, c]): clause_max_var(acc, c)

  curried fun matrix_max_var(acc, m): Utils.List.fold_left(iclause_max_var)(acc)(m)

  curried fun clause_max_var(acc, c): Utils.List.fold_left(litmat_max_var)(acc)(c)

  fun clause_offset(c): Host.hol_add(1)(clause_max_var(-1, c))

  fun iclause_offset(c): Host.hol_add(1)(iclause_max_var(-1, c))

  fun clause_ground(c):
    Utils.List.for_all(
      fun
      | (Lit(l)): Fol_term.lit_ground(l)
      | (Mat(_)): #false
    )(c)

  curried fun index_imatrix(i, [_, m]):
    let [j, m_prime] = index_matrix_impl(Host.hol_add(i)(1), m)
    [j, [i, m_prime]]

  curried fun index_matrix_impl(i, m): Utils.List.fold_map(index_iclause)(i)(m)

  curried fun index_iclause(i, [[_, v], c]):
    let [j, c_prime] = index_clause(Host.hol_add(i)(1), c)
    [j, [[i, v], c_prime]]

  curried fun index_clause(i, c): Utils.List.fold_map(index_litmat)(i)(c)

  fun index_litmat(i):
    fun
    | (Lit(l)): [i, Lit(l)]
    | (Mat(m)):
        let [j, m_prime] = index_imatrix(i, m)
        [j, Mat(m_prime)]

  fun index_matrix_v2(m): snd(index_matrix_impl(0, m))

  curried fun map_imatrix(f, [t, m]): [f(t), map_matrix(f)(m)]

  fun map_matrix(f): Utils.List.map(map_iclause(f))

  curried fun map_iclause(f, [[t, v], c]): [[f(t), v], map_clause(f)(c)]

  fun map_clause(f): Utils.List.map(map_litmat(lit)(Utils._op25_(mat)(map_imatrix(f))))

  fun copy_matrix(k): map_matrix((fun(i): [i, k]))

  fun copy_clause(k): map_clause((fun(i): [i, k]))

  fun break_map(f):
    fun
    | (PairList []): Host.Some(PairList [])
    | (PairList [x, & xs]):
        Utils._op3e__op3e__op3d_(f(x))(
          (fun(y): Utils._op3e__op3e__op3d_(break_map(f)(xs))((fun(ys): Host.Some(PairList [y, & ys]))))
        )

  fun litmat_positive(lm): map_litmat(lit_positive, imatrix_positive)(lm)

  fun lit_positive([p, a]): (if Host.hol_lt(p)(0) | Host.Some(Lit([p, a])) | Host.None())

  fun imatrix_positive([i, m]):
    match matrix_positive(m)
    | PairList []: Host.None()
    | m_prime: Host.Some(Mat([i, m_prime]))

  fun matrix_positive(m): Utils.List.filter_map(iclause_positive)(m)

  fun iclause_positive([i, c]): Utils._op3e__op3e__op3d_(clause_positive(c))((fun(c_prime): Host.Some([i, c_prime])))

  fun clause_positive(c): break_map(litmat_positive)(c)

  fun map_litmat_vars(f): map_litmat(Utils._op25_(lit)(Fol_term.map_lit_vars(Utils._op25_(Fol_term.var)(f))))(Utils._op25_(mat)(map_imatrix_vars(f)))

  curried fun map_imatrix_vars(f, [i, m]): [i, map_matrix_vars(f, m)]

  curried fun map_matrix_vars(f, m): Utils.List.map(map_iclause_vars(f))(m)

  curried fun map_iclause_vars(f, [[i, v], c]): [[i, Utils.List.map(f)(v)], map_clause_vars(f, c)]

  curried fun map_clause_vars(f, c): Utils.List.map(map_litmat_vars(f))(c)

  fun offset_iclause(off): map_iclause_vars(Host.hol_add(off))

  fun offset_clause(off): map_clause_vars(Host.hol_add(off))

  fun offset_matrix(off): map_matrix_vars(Host.hol_add(off))

namespace Ncprint:
  export:
    pp_print_litmat
    pp_print_imatrix
    pp_print_matrix
    pp_print_iclause
    pp_print_nclause
    pp_print_index
    string_of_litmat
    string_of_iclause
    string_of_iclause_i
    string_of_nclause
    string_of_matrix
    pp_print_matrix_ni
    print_iclause
    print_iclause_i
    print_nclause
    print_matrix_i

  curried fun pp_print_litmat(fi, f):
    fun
    | (Ncmatrix.Lit(l)): Print.pp_print_lit(f)(l)
    | (Ncmatrix.Mat(m)): pp_print_imatrix(fi, f, m)

  curried fun pp_print_imatrix(fi, f, [i, m]):
    Host.pp_open_box(f)(1)
    fi(f)(i)
    pp_print_matrix(fi)(f)(m)
    Host.hol_apply_unit(Host.pp_close_box(f))

  fun pp_print_matrix(fi): Print.pp_with_box(1)(Print.pp_enclose_cut("[")("]")(Print.pp_iter_sp("&")(pp_print_iclause(fi))))

  curried fun pp_print_iclause(fi, f, [[i, v], c]):
    Host.pp_open_box(f)(1)
    fi(f)(i)
    Print.pp_enum(",")("{")("}")(Print.pp_print_var)(f)(v)
    Host.pp_print_char(f)(":")
    Host.hol_apply_unit(Host.pp_print_space(f))
    pp_print_nclause(fi)(f)(c)
    Host.hol_apply_unit(Host.pp_close_box(f))

  fun pp_print_nclause(fi): Print.pp_with_box(1)(Print.pp_enclose_cut("[")("]")(Print.pp_iter_sp("|")(pp_print_litmat(fi))))

  def pp_print_index = Print.pp_enclose("<")(">")(Host.pp_print_int)

  fun string_of_litmat(c): Host.print_to_string(pp_print_litmat(Print.pp_print_null))(c)

  fun string_of_iclause(c): Host.print_to_string(pp_print_iclause(Print.pp_print_null))(c)

  def string_of_iclause_i = Host.print_to_string(pp_print_iclause(pp_print_index))

  fun string_of_nclause(c): Host.print_to_string(pp_print_nclause(Print.pp_print_null))(c)

  fun string_of_matrix(m): Host.print_to_string(pp_print_matrix(Print.pp_print_null))(m)

  curried fun pp_print_matrix_ni(fmt, x): pp_print_matrix(Print.pp_print_null)(fmt)(x)

  fun print_iclause(c): Print.pp_nl(pp_print_iclause(Print.pp_print_null))(Host.std_formatter)(c)

  def print_iclause_i = Print.pp_nl(pp_print_iclause(pp_print_index))(Host.std_formatter)

  fun print_nclause(c): Print.pp_nl(pp_print_nclause(Print.pp_print_null))(Host.std_formatter)(c)

  def print_matrix_i = Print.pp_nl(pp_print_matrix(pp_print_index))(Host.hol_std_formatter)

namespace Ncproof:
  export:
    Lemma
    Reduction
    Decomposition
    Extension
    pp_print_proof
    pp_print_prf
    pp_print_proofs
    string_of_inst_litmat
    print_proofa
    print_proof_def

  variant proof:
    Lemma()
    Reduction()
    Decomposition(clause, reconstruction, subproofs)
    Extension(clause, extension, subproofs)

  curried fun pp_print_proof([fl, fc], sub, f, [lit, prf]):
    Host.pp_open_vbox(f)(2)
    Host.OCamlFormat.pp_print_string(f)(fl(sub)(lit))
    Host.pp_print_char(f)(" ")
    pp_print_prf([fl, fc], sub, f)(prf)
    Host.hol_apply_unit(Host.pp_close_box(f))

  curried fun pp_print_prf([fl, fc], sub, f):
    fun
    | (Reduction()): Host.OCamlFormat.pp_print_string(f)("Red")
    | (Lemma()): Host.OCamlFormat.pp_print_string(f)("Lem")
    | (Decomposition(cl,recon,prfs)):
        Host.OCamlFormat.pp_print_string(f)(Host.hol_concat("Dec ")(fc(cl)))
        pp_print_proofs([fl, fc], sub, f)(prfs)
    | (Extension(cl,recon,prfs)):
        Host.OCamlFormat.pp_print_string(f)(Host.hol_concat("Ext ")(fc(cl)))
        pp_print_proofs([fl, fc], sub, f)(prfs)

  curried fun pp_print_proofs([fl, fc], sub, f):
    Host.OCamlList.iter(
      fun(x):
        Host.hol_apply_unit(Host.pp_print_cut(f))
        pp_print_proof([fl, fc], sub, f, x)
    )

  curried fun string_of_inst_litmat(sub, litmat): Ncprint.string_of_litmat(litmat)

  curried fun print_proofa([fl, fc], sub, prf): Print.pp_nl(pp_print_proof([fl, fc], sub))(Host.std_formatter)(prf)

  curried fun print_proof_def(sub, prf): print_proofa([string_of_inst_litmat, Ncprint.string_of_nclause], sub, prf)

namespace Extclause:
  export:
    Litext
    Matext
    offset_iv
    offset_litmat_ext
    offset_clause_ext
    claBC_of_litmat_ext
    matBC_of_clause_ext
    litext_of_litmat_ext
    litext_of_clause_ext
    assert_iclause
    assert_imatrix
    assert_matrix

  variant litmat_ext:
    Litext(surrounding, clause)
    Matext(index, surrounding, path)

  curried fun offset_iv(off, [i, v]): [i, Utils.List.map(Host.hol_add(off))(v)]

  fun offset_litmat_ext(off):
    fun
    | (Litext(claB,claC)):
        Litext(
          Utils.Pair.mapn(Ncmatrix.offset_clause(off))(claB),
          Ncmatrix.offset_clause(off)(claC)
        )
    | (Matext(j,claLR,clext)):
        Matext(
          j,
          Utils.Pair.mapn(Ncmatrix.offset_clause(off))(claLR),
          offset_clause_ext(off, clext)
        )

  curried fun offset_clause_ext(off, [iv, matLR, lmext]):
    [
      offset_iv(off, iv),
      Utils.Pair.mapn(Ncmatrix.offset_matrix(off))(matLR),
      offset_litmat_ext(off)(lmext)
    ]

  fun claBC_of_litmat_ext
  | claBC_of_litmat_ext(Litext([claL, claR],claC)): [Utils.List.rev_append(claL)(claR), claC]
  | claBC_of_litmat_ext(Matext(j,[claL, claR],clext)):
      let [matB_2, matC_2] = matBC_of_clause_ext(clext)
      let claLR_2 = Utils.List.rev_append(claL)(claR)
      [append(matB_2)(claLR_2), PairList [Ncmatrix.Mat([j, matC_2]), & claLR_2]]

  fun matBC_of_clause_ext([iv, [matL, matR], lmext]):
    let [claB, claC] = claBC_of_litmat_ext(lmext)
    [claB, PairList [[iv, claC], & Utils.List.rev_append(matL)(matR)]]

  fun litext_of_litmat_ext
  | litext_of_litmat_ext(Litext(claB,claC)): [claB, claC]
  | litext_of_litmat_ext(Matext(_,_,clext)): litext_of_clause_ext(clext)

  fun litext_of_clause_ext([_, _, lmext]): litext_of_litmat_ext(lmext)

  curried fun assert_iclause(matLR, [iv, c]):
    Host.hol_pipe(
      Host.hol_pipe(Utils.List.list_rest(c))(
        Utils.List.concat_map(
          (fun([lm, claLR]): Ncmatrix.map_litmat((fun(lit): PairList [[lit, Litext(claLR, c)]]))(assert_imatrix(claLR))(lm))
        )
      )
    )(Utils.List.map((fun([lit, lmext]): [lit, [iv, matLR, lmext]])))

  curried fun assert_imatrix(claLR, [j, mat]):
    Host.hol_pipe(
      Host.hol_pipe(Utils.List.list_rest(mat))(Utils.List.concat_map((fun([cla, matLR]): assert_iclause(matLR, cla))))
    )(Utils.List.map((fun([lit, claext]): [lit, Matext(j, claLR, claext)])))

  fun assert_matrix(mat): Host.hol_pipe(Utils.List.list_rest(mat))(Utils.List.concat_map((fun([cla, matLR]): assert_iclause(matLR, cla))))

namespace Ncdatabase:
  export:
    db
    insert_db
    matrix2db
    db_entries

  def db = Host.Hashtbl.create(10000)

  curried fun insert_db(db, [[p, a], clext]):
    let matC = snd(Extclause.matBC_of_clause_ext(clext))
    let off = Host.hol_add(1)(Ncmatrix.matrix_max_var(-1)(matC))
    let ground = Host.hol_pipe(Host.hol_pipe(Extclause.litext_of_clause_ext(clext))(snd))(Ncmatrix.clause_ground)
    let v = [clext, a, ground, off]
    try:
      Host.hol_pipe(Host.hol_pipe(Host.Hashtbl.find(db)(p))((fun(l): PairList [v, & l])))(Host.Hashtbl.replace(db)(p))
      ~catch exn:
        match exn
        | Host.Not_found(): Host.Hashtbl.add(db)(p)(PairList [v])
        | exn: Host.hol_raise(exn)

  fun matrix2db(m):
    let predb = Extclause.assert_matrix(m)
    Host.Hashtbl.clear(db)
    Host.OCamlList.iter(insert_db(db))(Host.OCamlList.rev(predb))

  fun db_entries(lit):
    try:
      Host.Hashtbl.find(db)(fst(lit))
      ~catch exn:
        match exn
        | Host.Not_found(): PairList []
        | exn: Host.hol_raise(exn)

namespace Ncsearch:
  export:
    unify_vars
    unify_rename
    pick
    nth_clause
    nth_matrix
    unique
    prove_ec
    cut
    prove_lit
    prove_mat
    prove_litmat
    prove_clause

  curried fun unify_vars([sub, off], l1, l2):
    try:
      Host.Some(
        [
          Cop.Subst.unify_tms(sub)(Utils.List.map(Fol_term.var)(l1))(Utils.List.map(Fol_term.var)(l2)),
          off
        ]
      )
      ~catch exn:
        match exn
        | Cop.Subst.Unify(): Host.None()
        | exn: Host.hol_raise(exn)

  curried fun unify_rename([sub, off], args1, [clext, args2, _, vars]):
    try:
      Host.Some(
        if Host.hol_equal(vars)(0)
        | [[Cop.Subst.unify_tms(sub)(args1)(args2), off], clext]
        | [
            [Cop.Subst.unify_tms_off(off)(sub)(args1)(args2), Host.hol_add(off)(vars)],
            Extclause.offset_clause_ext(off)(clext)
          ]
      )
      ~catch exn:
        match exn
        | Cop.Subst.Unify(): Host.None()
        | exn: Host.hol_raise(exn)

  curried fun pick(f, l):
    fun go(acc):
      fun
      | (PairList [x, & xs]):
          match f(x)
          | Host.Some(y): [y, (fun(z): Utils.List.rev_append(acc)(PairList [z, & xs]))]
          | Host.None(): go(PairList [x, & acc])(xs)
      | (PairList []): failwith("pick: no element found")
    go(PairList [])(l)

  curried fun nth_clause(i, [[[j, k], v], _] as c): (if Host.hol_equal(i)(j) | Host.Some(c) | Host.None())

  fun nth_matrix(i):
    fun
    | (Ncmatrix.Lit(_)): Host.None()
    | (Ncmatrix.Mat([[j, k], _] as m)): (if Host.hol_equal(i)(j) | Host.Some(m) | Host.None())

  curried fun unique(f, l): Host.hol_equal(Utils.List.length(Utils.List.filter_map(f)(l)))(1)

  curried fun prove_ec(k, sub, [[i, v], _, lmext] as clext, mi, pi):
    (if unique(nth_clause(i), mi) | #void | failwith("Assertion failed"))
    (if Host.hol_equal(Utils.List.length(pi))(k) | #void | failwith("Assertion failed"))
    let [[[[i, k1], v1], cla1], miAB] = pick(nth_clause(i), mi)
    let alt1_2:
      fun(_):
        match lmext
        | Extclause.Matext(j,_,clext_prime):
            if Utils.List.mem([j, k1])(pi)
            | match unify_vars(sub, v, v1)
              | Host.None(): Strom.nil
              | Host.Some(sub2):
                  let [[[j, k1_prime], mi2], claDE] = pick(nth_matrix(j), cla1)
                  (if unique(nth_matrix(j), cla1) | #void | failwith("Assertion failed"))
                  (if Host.hol_equal(k1)(k1_prime) | #void | failwith("Assertion failed"))
                  Host.hol_pipe(prove_ec(k, sub2, clext_prime, mi2, pi))(
                    Strom.map(
                      fun([sub3, [prefix, postfix], claB1, mi3]):
                        [
                          sub3,
                          [PairList [[[i, v1], j], & prefix], postfix],
                          claB1,
                          miAB([[[i, k1], v1], claDE(Ncmatrix.Mat([[j, k1], mi3]))])
                        ]
                    )
                  )
            | match lmext
              | _: Strom.nil
        | _: Strom.nil
    let alt2_2:
      fun(_):
        if (Utils.List.mem([i, k1])(pi) && Host.hol_equal(v)(PairList []))
        | Strom.nil
        | let [claB, claC] = Extclause.claBC_of_litmat_ext(lmext)
          let index_2 = (fun(cla): [[[i, k], v], Ncmatrix.copy_clause(k)(cla)])
          Strom.cons([sub, [PairList [], clext], index_2(claB), miAB(index_2(claC))])(Strom.nil)
    Strom.append(Strom.cache(alt1_2))(Strom.cache(alt2_2))

  curried fun cut(p, xs, ys): (if p | Strom.cut(xs)(ys) | Strom.append(xs)(ys))

  curried fun prove_lit(opt, sub, [mi, path, pi, lem, lim], lit):
    (if Host.ref_get(copverb) | Host.hol_printf("Lit: %s\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit))) | #void)
    (if Host.ref_get(copverb) | Host.hol_printf("Path: %s\n%!")(Print.string_of_lits(path)) | #void)
    (if Host.ref_get(copverb) | Host.hol_printf("Lemmas: %s\n%!")(Print.string_of_lits(lem)) | #void)
    let neglit_2 = Fol_term.negate_lit(lit)
    let k_2 = Host.hol_lazy((fun(): Utils.List.length(pi)))
    let lemmas_2:
      if Utils.List.exists(Cop.Subst.eq(sub)(lit))(lem)
      | (if Host.ref_get(copverb) | Host.hol_printf("lemma\n%!") | #void)
        Strom.cons([sub, lem, Ncproof.Lemma()])(Strom.nil)
      | Strom.nil
    let reductions_2:
      Host.hol_pipe(Strom.of_list(path))(
        Strom.filter_map(
          fun(p):
            (if Host.ref_get(copverb) | Host.hol_printf("Reduction try %s\n%!")(Print.string_of_lit(p)) | #void)
            match Cop.Subst.unify(sub)(neglit_2)(p)
            | Host.Some(sub1):
                (if Host.ref_get(copverb) | Host.hol_printf("Reduction works\n%!") | #void)
                Host.Some([sub1, lem, Ncproof.Reduction()])
            | Host.None(): Host.None()
        )
      )
    let extensions_2:
      Host.hol_pipe(Host.hol_pipe(Ncdatabase.db_entries(neglit_2))(Strom.of_list))(
        Strom.concat_map(
          fun([_, args, ground, vars] as contra):
            (if Host.ref_get(copverb) | Host.hol_printf("Extension try (for lit %s, args (%s), lim %d, vars %d)\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit)))(Host.hol_string_concat(",")(Utils.List.map(Print.string_of_fterm)(args)))(lim)(vars) | #void)
            if (Host.hol_lt(lim)(0) && Host.hol_not(ground))
            | Strom.nil
            | match unify_rename(sub)(snd(lit))(contra)
              | Host.Some([sub1, clext]):
                  (if Host.ref_get(copverb) | Host.hol_printf("Extension works (for lit %s, lim %d)\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub1))(lit)))(lim) | #void)
                  (if Host.ref_get(copverb) | Host.hol_printf("Old/new offsets: %d/%d\n%!")(snd(sub))(snd(sub1)) | #void)
                  Host.hol_pipe(prove_ec(Host.hol_force(k_2), sub1, clext, mi, pi))(
                    Strom.concat_map(
                      fun([sub2, position, [[i, v], claB1], mi1]):
                        (if Host.ref_get(copverb) | Host.hol_printf("Extension clause %s found\n%!")(Ncprint.string_of_nclause(claB1)) | #void)
                        Host.hol_pipe(
                          prove_clause(opt)(sub2)([mi1, PairList [lit, & path], PairList [i, & pi], lem, Host.hol_sub(lim)(1)])(claB1)
                        )(
                          Strom.map(
                            fun([sub3, prfs]):
                              [
                                sub3,
                                PairList [lit, & lem],
                                Ncproof.Extension(PairList [Ncmatrix.Lit(neglit_2), & claB1], position, prfs)
                              ]
                          )
                        )
                    )
                  )
              | Host.None(): Strom.nil
        )
      )
    Host.hol_pipe(
      cut(Cop.Subst.ground_lit(fst(sub))(lit))(cut(opt.cut1)(lemmas_2)(cut(opt.cut2)(reductions_2)(cut(opt.cut3, extensions_2, Strom.nil))))(Strom.nil)
    )(Strom.map((fun([sub1, lem1, prf1]): [sub1, lem1, [Ncmatrix.Lit(lit), prf1]])))

  curried fun prove_mat(opt, sub, [mi, path, pi, lem, lim], [j, mat1]):
    (if Host.ref_get(copverb) | Host.hol_printf("prove_mat\n%!") | #void)
    Host.hol_pipe(Strom.of_list(mat1))(
      Strom.concat_map(
        fun([[i, _] as idx, cla1]):
          (if Host.ref_get(copverb) | Host.hol_printf("Decomposition chose: %s\n%!")(Ncprint.string_of_nclause(cla1)) | #void)
          Host.hol_pipe(prove_clause(opt, sub, [mi, path, PairList [i, j, & pi], lem, lim])(cla1))(
            Strom.map(
              (fun([sub1, prf1]): [sub1, lem, [Ncmatrix.Mat([j, mat1]), Ncproof.Decomposition(cla1, idx, prf1)]])
            )
          )
      )
    )

  curried fun prove_litmat(opt, sub, st): Ncmatrix.map_litmat(prove_lit(opt, sub, st))(prove_mat(opt, sub, st))

  curried fun prove_clause(opt, sub, [mi, path, pi, lem, lim]):
    fun
    | (PairList [lm, & cla]):
        let check_2 = Utils.List.exists((fun(x): Utils.List.exists(Cop.Subst.eq(sub)(x))(path)))
        let regularity:
          if opt.improved_regularity
          | check_2(Ncmatrix.clause_lits(PairList [lm, & cla]))
          | match lm
            | Ncmatrix.Mat(_): #false
            | Ncmatrix.Lit(l): check_2(PairList [l, & Ncmatrix.clause_lits(cla)])
        if regularity
        | (if Host.ref_get(copverb) | Host.hol_printf("regularity\n%!") | #void)
          Strom.nil
        | Host.hol_pipe(prove_litmat(opt, sub, [mi, path, pi, lem, lim])(lm))(
            Strom.concat_map(
              (fun([sub1, lem1, prf1]): Host.hol_pipe(prove_clause(opt, sub1, [mi, path, pi, lem1, lim])(cla))(Strom.map((fun([sub2, prf2]): [sub2, PairList [prf1, & prf2]]))))
            )
          )
    | (PairList []):
        (if Host.ref_get(copverb) | Host.hol_printf("axiom\n%!") | #void)
        Strom.cons([sub, PairList []])(Strom.nil)

namespace Ncrecon:
  export:
    DISJ_CASES_LIST
    CONTRADICTION
    flip_neg
    nth_disj
    nth_conj
    inst_var
    spec_vars
    ReconData
    clause_index_mapping
    matrix_index_mapping
    mk_recon_data
    prefix_problem
    eat_proofs
    bot_of_clause_ext
    bot_of_litmat_ext
    bot_of_proof

  curried fun DISJ_CASES_LIST(th, prfs):
    (if Host.hol_equal(Utils.List.length(prfs))(Utils.List.length(disjuncts(concl(th)))) | #void | failwith("Assertion failed"))
    (if Utils.List.for_all2(Utils.List.mem)(disjuncts(concl(th)))(Utils.List.map(hyp)(prfs)) | #void | failwith("Assertion failed"))
    let c = concl(Utils.List.hd(prfs))
    (if Utils.List.fold_left((fun(acc): (fun(x): (acc && Host.hol_equal(concl(x))(c)))))(#true)(prfs) | #void | failwith("Assertion failed"))
    match prfs
    | PairList []: failwith("DISJ_CASES_LIST")
    | PairList [p, & PairList []]: MP(DISCH(concl(th))(p))(th)
    | PairList [p1, & PairList [p2, & PairList []]]: DISJ_CASES(th)(p1)(p2)
    | PairList [p, & ps]: DISJ_CASES(th)(p)(DISJ_CASES_LIST(ASSUME(snd(dest_disj(concl(th)))), ps))

  def initialization_1:
    if (
      Host.hol_equal(
        Host.hol_pipe(
          DISJ_CASES_LIST(ASSUME(Host.hol_term(Or(Var("a", Bool), Or(Var("b", Bool), Var("c", Bool))))))(
            PairList [
              Host.hol_pipe(
                TAUT(Host.hol_term(Implies(Var("a", Bool), Or(Var("c", Bool), Or(Var("b", Bool), Var("a", Bool))))))
              )(UNDISCH),
              Host.hol_pipe(
                TAUT(Host.hol_term(Implies(Var("b", Bool), Or(Var("c", Bool), Or(Var("b", Bool), Var("a", Bool))))))
              )(UNDISCH),
              Host.hol_pipe(
                TAUT(Host.hol_term(Implies(Var("c", Bool), Or(Var("c", Bool), Or(Var("b", Bool), Var("a", Bool))))))
              )(UNDISCH)
            ]
          )
        )(concl)
      )(Host.hol_term(Or(Var("c", Bool), Or(Var("b", Bool), Var("a", Bool)))))
    )
    | #void
    | failwith("Assertion failed")

  curried fun CONTRADICTION(x, y):
    let [xc, yc] = [concl(x), concl(y)]
    (if Host.ref_get(copverb) | Host.hol_printf("contra: %s with %s\n%!")(Host.string_of_term(xc))(Host.string_of_term(yc)) | #void)
    if (is_neg(xc) && Host.hol_not(is_neg(yc)))
    | MP(NOT_ELIM(x))(y)
    | (if (is_neg(yc) && Host.hol_not(is_neg(xc))) | MP(NOT_ELIM(y))(x) | failwith("no contradiction found"))

  def initialization_2:
    if (
      Host.hol_equal(
        concl(
          CONTRADICTION(ASSUME(Host.hol_term(Not(Var("p", Bool)))))(ASSUME(Host.hol_term(Var("p", Bool))))
        )
      )(Host.hol_term(False))
    )
    | #void
    | failwith("Assertion failed")

  def initialization_3:
    if (
      Host.hol_equal(
        concl(
          CONTRADICTION(ASSUME(Host.hol_term(Var("p", Bool))))(ASSUME(Host.hol_term(Not(Var("p", Bool)))))
        )
      )(Host.hol_term(False))
    )
    | #void
    | failwith("Assertion failed")

  fun flip_neg(tm): (if is_neg(tm) | dest_neg(tm) | mk_neg(tm))

  curried fun nth_disj(j, th):
    (if Host.ref_get(copverb) | Host.hol_printf("nth_disj %d %s\n%!")(j)(Host.string_of_term(concl(th))) | #void)
    Host.hol_pipe(
      Host.hol_pipe(Host.hol_pipe(concl(th))(disjuncts))(Utils.List.map(ASSUME))
    )(Utils.List.nth_rest(j))

  curried fun nth_conj(i, th):
    (if Host.ref_get(copverb) | Host.hol_printf("nth_conj %d %s\n%!")(i)(Host.string_of_term(concl(th))) | #void)
    Utils.List.nth(CONJUNCTS(th))(i)

  curried fun inst_var(sub, ty, v):
    let ftm = Substarray.inst_tm(sub)(Fvar(v))
    try:
      Mapping.hol_of_term(ty)(ftm)
      ~catch exn:
        match exn
        | Failure(e): failwith(Host.hol_concat("inst_var: ")(e))
        | exn: Host.hol_raise(exn)

  curried fun spec_vars(sub, vs, th):
    (if Host.ref_get(copverb) | Host.hol_printf("spec_vars: |vars| = %d, th = %s\n%!")(Utils.List.length(vs))(Host.string_of_term(concl(th))) | #void)
    let tys = Host.hol_pipe(Host.hol_pipe(Host.hol_pipe(concl(th))(strip_forall))(fst))(Utils.List.map(type_of))
    (if Host.hol_equal(Utils.List.length(tys))(Utils.List.length(vs)) | #void | failwith("Assertion failed"))
    Utils.List.fold_left2((fun(th): (fun(ty): (fun(v): SPEC(inst_var(sub, ty, v))(th)))))(th)(tys)(vs)

  record ReconData(problem, mapping, sub)

  fun clause_index_mapping(cl):
    Host.hol_pipe(
      Host.hol_pipe(cl)(
        Utils.List.mapi(
          fun(idx):
            fun
            | (Ncmatrix.Lit(_)): PairList []
            | (Ncmatrix.Mat([j, mat])): PairList [[j, idx], & matrix_index_mapping(mat)]
        )
      )
    )(Utils.List.concat)

  fun matrix_index_mapping(mat):
    Host.hol_pipe(
      Host.hol_pipe(mat)(
        Utils.List.mapi((fun(idx): (fun([[i, v], cl]): PairList [[i, idx], & clause_index_mapping(cl)])))
      )
    )(Utils.List.concat)

  fun mk_recon_data([problem, mat, sub]): ReconData(problem, matrix_index_mapping(mat), sub)

  fun prefix_problem(data):
    let rel = (fun(i): Utils.List.assoc(i)(data.mapping))
    Utils.List.fold_left(
      fun(th):
        fun([[i, v], j]):
          Host.hol_pipe(
            Host.hol_pipe(Host.hol_pipe(Host.hol_pipe(th)(nth_conj(rel(i))))(spec_vars(data.sub, v)))(nth_disj(rel(j)))
          )(fst)
    )(data.problem)

  fun eat_proofs(data):
    Utils.List.fold_map(
      fun([lem, prfs]):
        fun(th):
          match prfs
          | PairList [prf, & prfs]:
              let bot = bot_of_proof(data, lem, th)(prf)
              [[PairList [[concl(th), bot], & lem], prfs], bot]
          | PairList []: failwith("eat_proofs")
    )

  curried fun bot_of_clause_ext(data, [[i, v], [matL, matR], lmext], acc, th):
    let i_prime = Utils.List.assoc(i)(data.mapping)
    (if Host.hol_equal(i_prime)(Utils.List.length(matL)) | #void | failwith("Assertion failed"))
    (if Host.hol_equal(Utils.List.length(CONJUNCTS(th)))(Host.hol_add(1)(Utils.List.length(append(matL)(matR)))) | #void | failwith("Assertion failed"))
    bot_of_litmat_ext(data)(acc)(Host.hol_pipe(nth_conj(i_prime, th))(spec_vars(data.sub, v)))(lmext)

  curried fun bot_of_litmat_ext(data, acc, thi):
    fun
    | (Extclause.Litext([claL, claR],claC)):
        let j = Utils.List.length(claL)
        let [thj, [thL, thR]] = nth_disj(j, thi)
        let [acc1, botsL] = eat_proofs(data)(acc)(thL)
        let [acc2, botsR] = eat_proofs(data)(acc1)(thR)
        (if Host.ref_get(copverb) | Host.hol_printf("bot_of_litmat_ext: thi = %s\n%!")(Host.string_of_thm(thi)) | #void)
        let tmj = concl(thj)
        (if Host.hol_not((is_conj(tmj) || is_disj(tmj))) | #void | failwith("Assertion failed"))
        let botj = CONTRADICTION(thj)(Host.hol_pipe(Host.hol_pipe(concl(thj))(flip_neg))(ASSUME))
        [acc2, DISJ_CASES_LIST(thi)(append(botsL)(PairList [botj, & botsR]))]
    | (Extclause.Matext(j,[claL, claR],clext)):
        let j_prime = Utils.List.assoc(j)(data.mapping)
        (if Host.hol_equal(j_prime)(Utils.List.length(claL)) | #void | failwith("Assertion failed"))
        let [thj, [thL, thR]] = nth_disj(j_prime, thi)
        let [acc1, botj] = bot_of_clause_ext(data, clext, acc, thj)
        let [acc2, botsL] = eat_proofs(data)(acc1)(thL)
        let [acc3, botsR] = eat_proofs(data)(acc2)(thR)
        [acc3, DISJ_CASES_LIST(thi)(append(botsL)(PairList [botj, & botsR]))]

  curried fun bot_of_proof(data, lem, th):
    fun
    | ([Ncmatrix.Mat([j, mat]), Ncproof.Decomposition(cla,[[i, k], v],prfs)]):
        let i_prime = Utils.List.assoc(i)(data.mapping)
        (if Host.hol_lt(i_prime)(Utils.List.length(mat)) | #void | failwith("Assertion failed"))
        (if Host.hol_equal(snd(Utils.List.nth(mat)(i_prime)))(cla) | #void | failwith("Assertion failed"))
        (if Host.ref_get(copverb) | Host.hol_printf("Decomposition %d: %s\n%!")(i_prime)(Host.string_of_term(concl(th))) | #void)
        let thi = Host.hol_pipe(nth_conj(i_prime, th))(spec_vars(data.sub, v))
        let djs = disjuncts(concl(thi))
        (if Host.hol_equal(Utils.List.length(djs))(Utils.List.length(prfs)) | #void | failwith("Assertion failed"))
        Host.hol_pipe(
          Host.hol_pipe(Host.hol_pipe(Utils.List.map(ASSUME)(djs))(eat_proofs(data)([lem, prfs])))(snd)
        )(DISJ_CASES_LIST(thi))
    | ([Ncmatrix.Lit(lit), prf]):
        let liti = Mapping.hol_of_literal(Substarray.inst_lit(data.sub)(lit))
        (if Host.ref_get(copverb) | Host.hol_printf("bot_of_proof: lit = %s\n%!")(Host.string_of_term(liti)) | #void)
        (if Host.hol_equal(liti)(concl(th)) | #void | failwith("Assertion failed"))
        match prf
        | Ncproof.Reduction(): Host.hol_pipe(Host.hol_pipe(flip_neg(liti))(ASSUME))(CONTRADICTION(th))
        | Ncproof.Lemma():
            (if Utils.List.mem_assoc(liti)(lem) | #void | failwith("Assertion failed"))
            Utils.List.assoc(liti)(lem)
        | Ncproof.Extension(_,[prefix, postfix],prfs):
            let prefix_th = prefix_problem(data)(prefix)
            (if Host.ref_get(copverb) | Host.hol_printf("prefix_th = %s\n%!")(Host.string_of_thm(prefix_th)) | #void)
            let [[_, prfs_prime], bot] = bot_of_clause_ext(data, postfix, [lem, prfs], prefix_th)
            (if Host.hol_equal(prfs_prime)(PairList []) | #void | failwith("Assertion failed"))
            (if Utils.List.mem(concl(th))(hyp(bot)) | #void | failwith("Assertion failed"))
            MP(DISCH(concl(th))(bot))(th)
        | _: failwith("bot_of_proof: not a well-formed proof")
    | (_): failwith("bot_of_proof: not a well-formed proof")

namespace Nanocop:
  export:
    start
    fol_of_thm
    NANOCOP_DEEPEN
    PRINT_TAC
    PRINT_ID_TAC
    PREPARE_NANOCOP_TAC
    PURE_NANOCOP
    GEN_NANOCOP_TAC
    NANOCOP_TAC
    NANOCOP

  curried fun start(mat, opt, lim):
    (if Host.ref_get(copverb) | Host.hol_printf("Start %d\n%!")(Host.hol_add(lim)(1)) | #void)
    let mati = Ncmatrix.copy_matrix(0)(mat)
    let sub0 = Cop.Subst.empty(1000000)
    let hashek = Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
    Utils._op3e__op3e__op3d_(
      Host.hol_pipe(
        Host.hol_pipe(Strom.of_list(mati))(
          Strom.filter_map(
            fun(arg_2):
              match arg_2
              | [[[i, _], v] as idx, PairList [Ncmatrix.Lit(lit), & PairList []] as cla]:
                  if Host.hol_equal(lit)(hashek)
                  | Utils._op3e__op3e__op3d_(
                      Host.hol_pipe(
                        Ncsearch.prove_clause(opt)([sub0, 0])([mati, PairList [], PairList [[i, 0]], PairList [], lim])(cla)
                      )(Strom.next_opt)
                    )((fun([sub, prfs]): Host.Some([sub, Ncproof.Decomposition(cla, idx, prfs)])))
                  | match arg_2
                    | _: Host.None()
              | _: Host.None()
          )
        )
      )(Strom.next_opt)
    )((fun([sub, prf]): Host.Some([fst(sub), [Ncmatrix.Mat([[-1, 0], mati]), prf]])))

  fun fol_of_thm(th):
    let lconsts = freesl(hyp(th))
    let tm = concl(th)
    (if Utils.List.for_all((fun(x): Utils.List.mem(x)(lconsts)))(frees(tm)) | #void | failwith("Assertion failed"))
    Mapping.fol_of_form(PairList [])(lconsts)(tm)

  curried fun NANOCOP_DEEPEN(opt, ths):
    if Host.ref_get(copverb)
    | Host.hol_printf("NANOCOP_DEEPEN with ths:\n%!")
      Utils.List.iter(o(Host.hol_printf("  th: %s\n%!"))(Host.string_of_thm))(ths)
    | #void
    Host.hol_apply_unit(Mapping.reset_vars)
    Host.hol_apply_unit(Mapping.reset_consts)
    let gen_eq = o(o(map(GEN_ALL))(Equality.create_eq_axs(opt.add_eq_symmetry)))(map(concl))
    let ths_prime = (if Utils.List.exists((fun(th): Host.hol_equal(concl(th))(Hashek.hashek_tm)))(ths) | ths | PairList [Hashek.hashek_thm, & ths])
    let ths_prime = Host.setify(append(ths_prime)(gen_eq(ths_prime)))
    let th = end_itlist(CONJ)(ths_prime)
    let fol = fol_of_thm(th)
    let mat = Ncmatrix.index_matrix(Ncmatrix.matrix_of_form(fol))
    if Host.ref_get(copverb)
    | Host.hol_printf("Matrix:\n%!")
      Ncprint.print_matrix_i(mat)
    | #void
    Ncdatabase.matrix2db(mat)
    (if Host.ref_get(copverb) | Host.hol_printf("Matrix loaded.\n%!") | #void)
    let [sub, prfs] = Cop.strategy(opt)(start(mat))
    if Host.ref_get(copverb)
    | Host.hol_printf("Theorem\n%!")
      Ncproof.print_proof_def(sub)(prfs)
    | #void
    let data = Ncrecon.mk_recon_data([th, mat, sub])
    let bot = Ncrecon.bot_of_proof(data)(PairList [])(th)(prfs)
    if Host.ref_get(copverb)
    | Host.hol_printf("Reconstruction:\n%!")
      Host.print_thm(bot)
    | #void
    (if Host.set_eq(hyp(bot))(hyp(th)) | #void | failwith("Assertion failed"))
    (if Host.hol_equal(concl(bot))(Host.hol_term(False)) | #void | failwith("Assertion failed"))
    bot

  fun PRINT_TAC(g):
    (if Host.ref_get(copverb) | Host.print_goal(g) | #void)
    ALL_TAC(g)

  curried fun PRINT_ID_TAC(s, g):
    (if Host.ref_get(copverb) | Host.hol_print_endline(s) | #void)
    PRINT_TAC(g)

  fun PREPARE_NANOCOP_TAC(ths):
    (
      (
        (
          Prepare.PREPARE_COP_TAC(ths) then_tac \
          RULE_ASSUM_TAC(CONV_RULE(DEPTH_CONV(CHANGED_CONV(ASSOC_CONV(DISJ_ASSOC)))))
        ) then_tac \
        RULE_ASSUM_TAC(CONV_RULE(DEPTH_CONV(CHANGED_CONV(ASSOC_CONV(CONJ_ASSOC)))))
      ) then_tac \
      REPEAT(FIRST_X_ASSUM(SUBST_VAR_TAC))
    )

  curried fun PURE_NANOCOP(opt, gl):
    (
      FIRST_ASSUM(CONTR_TAC) or_tac \
      W(o(o(o(ACCEPT_TAC)(NANOCOP_DEEPEN(opt)))(map(snd)))(fst))
    )(gl)

  curried fun GEN_NANOCOP_TAC(opt, ths): (PREPARE_NANOCOP_TAC(ths) then_tac PURE_NANOCOP(opt))

  fun NANOCOP_TAC(ths): GEN_NANOCOP_TAC(Cop.search_opts, ths)

  curried fun NANOCOP(ths, tm): prove([tm, NANOCOP_TAC(ths)])

def LEANCOP_TAC = Leancop.LEANCOP_TAC

def LEANCOP = Leancop.LEANCOP

def NANOCOP_TAC = Nanocop.NANOCOP_TAC

def NANOCOP = Nanocop.NANOCOP
