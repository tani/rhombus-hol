  fun thecops_Nanocop_PREPARE_NANOCOP_TAC(ths):«
    let port_tmp_10 = Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Tactics.SUBST_VAR_TAC));
    let port_tmp_11 = (block:«
      let port_tmp_12 = Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.DEPTH_CONV(Equal.CHANGED_CONV(Canon.ASSOC_CONV(Theorems.CONJ_ASSOC)))));
      let port_tmp_13 = (block:«
