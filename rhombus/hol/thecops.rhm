                »)
              »)
            »)
          »)
        »)
      »)
    »)
  »;
  fun thecops_Leancop_PREPARE_LEAN_TAC(ths):«
    (block:«
      let port_tmp_4 = Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Tactics.SUBST_VAR_TAC));
      let port_tmp_5 = (block:«
        let port_tmp_6 = Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Canon.ASSOC_CONV(Theorems.DISJ_ASSOC)));
        let port_tmp_7 = (block:«
          let port_tmp_8 = Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Meson.Meson.CONJUNCTS_THEN_prime(Tactics.ASSUME_TAC)));
          let port_tmp_9 = (block:«
            let port_tmp_10 = Tactics.RULE_ASSUM_TAC(Host.repeat((fun(th):«
              Bool.SPEC(Basics.genvar(Fusion.type_of(fst(Basics.dest_forall(Fusion.concl(th))))))(th)
            »)));
            let port_tmp_11 = (block:«
              let port_tmp_12 = Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.THENC(Canon.PRENEX_CONV)(Canon.WEAK_CNF_CONV)));
              let port_tmp_13 = Prepare.PREPARE_COP_TAC(ths);
              Tactics.THEN(port_tmp_13)(port_tmp_12)
            »);
            Tactics.THEN(port_tmp_11)(port_tmp_10)
          »);
          Tactics.THEN(port_tmp_9)(port_tmp_8)
        »);
        Tactics.THEN(port_tmp_7)(port_tmp_6)
      »);
      Tactics.THEN(port_tmp_5)(port_tmp_4)
    »)
  »;
