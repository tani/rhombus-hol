namespace Ncdatabase:
  export:
    db
    insert_db
    matrix2db
    db_entries

  def thecops_Ncdatabase_db = Host.Hashtbl.create(10000)

  fun thecops_Ncdatabase_insert_db(db):
    fun([[p, a], clext]):
      let matC = snd(Extclause.matBC_of_clause_ext(clext))
      let off = Host.hol_add(1)(Ncmatrix.matrix_max_var(-1)(matC))
      let ground = Host.hol_pipe(Host.hol_pipe(Extclause.litext_of_clause_ext(clext))(snd))(Ncmatrix.clause_ground)
      let v = [clext, a, ground, off]
      try:
        Host.hol_pipe(Host.hol_pipe(Host.Hashtbl.find(db)(p))((fun(l): PairList.cons(v, l))))(Host.Hashtbl.replace(db)(p))
        ~catch exn:
          match exn
          | Host.Not_found(): Host.Hashtbl.add(db)(p)(PairList.cons(v, PairList []))
          | exn: Host.hol_raise(exn)

  fun thecops_Ncdatabase_matrix2db(m):
    let predb = Extclause.assert_matrix(m)
    Host.Hashtbl.clear(thecops_Ncdatabase_db)
    Host.OCamlList.iter(thecops_Ncdatabase_insert_db(thecops_Ncdatabase_db))(Host.OCamlList.rev(predb))

  fun thecops_Ncdatabase_db_entries(lit):
    try:
      Host.Hashtbl.find(thecops_Ncdatabase_db)(fst(lit))
      ~catch exn:
        match exn
        | Host.Not_found(): PairList []
        | exn: Host.hol_raise(exn)

  def db = thecops_Ncdatabase_db

  def insert_db = thecops_Ncdatabase_insert_db

  def matrix2db = thecops_Ncdatabase_matrix2db

  def db_entries = thecops_Ncdatabase_db_entries

