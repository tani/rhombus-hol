  fun thecops_Nanocop_PREPARE_NANOCOP_TAC(ths):
    let port_tmp_19 = Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Tactics.SUBST_VAR_TAC))
    let port_tmp_17 = Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.DEPTH_CONV(Equal.CHANGED_CONV(Canon.ASSOC_CONV(Theorems.CONJ_ASSOC)))))
    let port_tmp_15 = Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.DEPTH_CONV(Equal.CHANGED_CONV(Canon.ASSOC_CONV(Theorems.DISJ_ASSOC)))))
    let port_tmp_16 = Prepare.PREPARE_COP_TAC(ths)
    let port_tmp_18 = Tactics.THEN(port_tmp_16)(port_tmp_15)
    let port_tmp_20 = Tactics.THEN(port_tmp_18)(port_tmp_17)
    Tactics.THEN(port_tmp_20)(port_tmp_19)

  fun thecops_Nanocop_PURE_NANOCOP(opt):
    fun port_tmp_25(gl):
      let port_tmp_21 = map(snd)
      let port_tmp_22 = o(Tactics.ACCEPT_TAC)(thecops_Nanocop_NANOCOP_DEEPEN(opt))
      let port_tmp_23 = W(o(o(port_tmp_22)(port_tmp_21))(fst))
      let port_tmp_24 = Tactics.FIRST_ASSUM(Tactics.CONTR_TAC)
      Tactics.ORELSE(port_tmp_24)(port_tmp_23)(gl)
    port_tmp_25

  fun thecops_Nanocop_GEN_NANOCOP_TAC(opt):
    fun port_tmp_28(ths):
      let port_tmp_26 = thecops_Nanocop_PURE_NANOCOP(opt)
      let port_tmp_27 = thecops_Nanocop_PREPARE_NANOCOP_TAC(ths)
      Tactics.THEN(port_tmp_27)(port_tmp_26)
    port_tmp_28

