                                      | #void
                                    »);
                                    (block:«
                                      let port_tmp_33 = Strom.map((fun([sub3, prfs]):« [sub3, PairList.cons(lit,lem), Ncproof.Extension(PairList.cons(Ncmatrix.Lit(port_tmp_20_neglit),claB1),position,prfs)] »));
                                      let port_tmp_34 = thecops_Ncsearch_prove_clause(opt)(sub2)([mi1, PairList.cons(lit,path), PairList.cons(i,pi), lem, Host.hol_sub(lim)(1)])(claB1);
                                      Host.hol_pipe(port_tmp_34)(port_tmp_33)
                                    »)
                                  »));
                                  let port_tmp_35 = thecops_Ncsearch_prove_ec(Host.hol_force(port_tmp_21_k))(sub1)(clext)(mi)(pi);
                                  Host.hol_pipe(port_tmp_35)(port_tmp_32)
                                »)
                              »)
                          »
                          | Host.None(): Strom.nil
                        »)
                      »)
                    »));
                    let port_tmp_36 = Host.hol_pipe(Ncdatabase.db_entries(port_tmp_20_neglit))(Strom.of_list);
                    Host.hol_pipe(port_tmp_36)(port_tmp_27)
                  »;
                  (block:«
