                  let port_tmp_23_reductions:«
                    let port_tmp_24 = Strom.filter_map((fun(p):«
                      (block:«
                        if Host.ref_get(Firstorder.copverb)
                        | Host.hol_printf("Reduction try %s\n%!")(Print.string_of_lit(p))
                        | #void
                      »);
                      (block:«
                        match Cop.Subst.unify(sub)(port_tmp_20_neglit)(p)
                        | Host.Some(sub1):«
                            (block:«
                              if Host.ref_get(Firstorder.copverb)
                              | Host.hol_printf("Reduction works\n%!")
                              | #void
                            »);
                            Host.Some([sub1, lem, Ncproof.Reduction()])
                        »
                        | Host.None(): Host.None()
                      »)
                    »));
                    let port_tmp_25 = Strom.of_list(path);
                    Host.hol_pipe(port_tmp_25)(port_tmp_24)
                  »;
                  let port_tmp_26_extensions:«
                    let port_tmp_27 = Strom.concat_map((fun([_, args, ground, vars] as contra):«
                      (block:«
                        if Host.ref_get(Firstorder.copverb)
                        | (block:«
                          let port_tmp_28 = Host.hol_string_concat(",")(Firstorder.Utils.List.map(Print.string_of_fterm)(args));
                          let port_tmp_29 = Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit));
                          Host.hol_printf("Extension try (for lit %s, args (%s), lim %d, vars %d)\n%!")(port_tmp_29)(port_tmp_28)(lim)(vars)
                        »)
                        | #void
                      »);
                      (block:«
                        if (Host.hol_lt(lim)(0) && Host.hol_not(ground))
                        | Strom.nil
                        | (block:«
                          match thecops_Ncsearch_unify_rename(sub)(snd(lit))(contra)
                          | Host.Some([sub1, clext]):«
                              (block:«
                                if Host.ref_get(Firstorder.copverb)
                                | Host.hol_printf("Extension works (for lit %s, lim %d)\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub1))(lit)))(lim)
                                | #void
                              »);
                              (block:«
                                (block:«
                                  if Host.ref_get(Firstorder.copverb)
                                  | (block:«
                                    let port_tmp_30 = snd(sub1);
                                    let port_tmp_31 = snd(sub);
                                    Host.hol_printf("Old/new offsets: %d/%d\n%!")(port_tmp_31)(port_tmp_30)
                                  »)
                                  | #void
                                »);
                                (block:«
                                  let port_tmp_32 = Strom.concat_map((fun([sub2, position, [[i, v], claB1], mi1]):«
                                    (block:«
                                      if Host.ref_get(Firstorder.copverb)
