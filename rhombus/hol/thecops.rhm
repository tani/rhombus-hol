        »);
        (block:«
          let sub0:«
            Cop.Subst.empty(1000000)
          »;
          (block:«
            let hashek:«
              Firstorder.Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
            »;
            (block:«
