    rename index_matrix_v2 as index_matrix
    index_iclause
    index_clause
    index_litmat
    map_imatrix
    map_matrix
    map_iclause
    map_clause
    copy_matrix
    copy_clause
    break_map
    litmat_positive
    lit_positive
    imatrix_positive
    matrix_positive
    iclause_positive
    clause_positive
    map_litmat_vars
    map_imatrix_vars
