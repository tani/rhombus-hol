  fun thecops_Ncsearch_unique(f):« (fun(l):« Host.hol_equal(Firstorder.Utils.List.length(Firstorder.Utils.List.filter_map(f)(l)))(1) ») »;
  fun thecops_Ncsearch_prove_ec(k):«
    (fun(sub):«
      (fun([[i, v], _, lmext] as clext):«
        (fun(mi):«
          (fun(pi):«
            (block:«
              if thecops_Ncsearch_unique(thecops_Ncsearch_nth_clause(i))(mi)
              | #void
              | failwith("Assertion failed")
            »);
            (block:«
              (block:«
                if Host.hol_equal(Firstorder.Utils.List.length(pi))(k)
                | #void
                | failwith("Assertion failed")
              »);
              (block:«
                let [[[[i, k1], v1], cla1], miAB] = thecops_Ncsearch_pick(thecops_Ncsearch_nth_clause(i))(mi);
                (block:«
                  let port_tmp_11_alt1:«
                    (fun(_):«
                      match lmext
                      | Extclause.Matext(j,_,clext_prime):«
                          if Firstorder.Utils.List.mem([j, k1])(pi)
                          | (block:«
                            match thecops_Ncsearch_unify_vars(sub)(v)(v1)
                            | Host.None(): Strom.nil
                            | Host.Some(sub2):«
                                let [[[j, k1_prime], mi2], claDE] = thecops_Ncsearch_pick(thecops_Ncsearch_nth_matrix(j))(cla1);
                                (block:«
                                  (block:«
