          let port_tmp_52 = Host.hol_add(1)(Firstorder.Utils.List.length(append(matL)(matR)))
          let port_tmp_53 = Firstorder.Utils.List.length(Bool.CONJUNCTS(th))
          (if Host.hol_equal(port_tmp_53)(port_tmp_52) | #void | failwith("Assertion failed"))
          let port_tmp_54 = thecops_Ncrecon_spec_vars(data.sub)(v)
          let port_tmp_55 = thecops_Ncrecon_nth_conj(i_prime)(th)
          thecops_Ncrecon_bot_of_litmat_ext(data)(acc)(Host.hol_pipe(port_tmp_55)(port_tmp_54))(lmext)
