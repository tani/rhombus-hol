  fun thecops_Prepare_PREPARE_COP_TAC(ths): Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Class.REFUTE_THEN(Tactics.LABEL_TAC("copconcl")))(Meson.Meson.POLY_ASSUME_TAC(map(Bool.GEN_ALL)(ths))))(Tactics.ORELSE(Hashek.MARK_CONCL("copconcl"))(Hashek.MARK_ASSUMS)))(W(o(Tactics.MAP_EVERY(o(o(Tactics.UNDISCH_TAC)(Fusion.concl))(snd)))(fst))))(Canon.SELECT_ELIM_TAC))(W((fun([asl, w]): Tactics.MAP_EVERY((fun(v): Tactics.SPEC_TAC([v, v])))(Fusion.frees(w))))))(Tactics.CONV_TAC(Equal.THENC(Equal.THENC(Equal.THENC(Equal.THENC(Canon.PRESIMP_CONV)(Equal.TOP_DEPTH_CONV(Equal.BETA_CONV)))(Canon.LAMBDA_ELIM_CONV))(Canon.CONDS_CELIM_CONV))(Meson.Meson.QUANT_BOOL_CONV))))(Tactics.REPEAT(Tactics.ORELSE(Tactics.GEN_TAC)(Tactics.DISCH_TAC))))(Class.REFUTE_THEN(Tactics.ASSUME_TAC)))(Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.THENC(Canon.NNF_CONV)(Canon.SKOLEM_CONV)))))(Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Tactics.CHOOSE_TAC))))(Canon.ASM_FOL_TAC)

  def PREPARE_COP_TAC = thecops_Prepare_PREPARE_COP_TAC

namespace Proof:
  export:
    rename thecops_Proof_ctor_Lemma as Lemma
    rename thecops_Proof_ctor_Reduction as Reduction
    rename thecops_Proof_ctor_Extension as Extension

  class thecops_Proof_ctor_Lemma():
    extends Host.HolVariant
    override port_view(): [0, [0, PairList []]]

  class thecops_Proof_ctor_Reduction():
    extends Host.HolVariant
    override port_view(): [0, [1, PairList []]]

  class thecops_Proof_ctor_Extension(field0, field1):
    extends Host.HolVariant
    override port_view(): [1, [0, PairList [this.field0, this.field1]]]

namespace Search:
  export:
    cut
    prove_lit
    prove_clause

  fun thecops_Search_cut(p): (fun(xs): (fun(ys): (if p | Strom.cut(xs)(ys) | Strom.append(xs)(ys))))

  fun thecops_Search_prove_lit(opt):
    fun(sub):
      fun([path, lem, lim]):
        fun(lit):
          (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Lit: %s\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit))) | #void)
          (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Path: %s\n%!")(Print.string_of_lits(Firstorder.Utils.List.map(Cop.Subst.inst_lit(fst(sub)))(path))) | #void)
          (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Lemmas: %s\n%!")(Print.string_of_lits(Firstorder.Utils.List.map(Cop.Subst.inst_lit(fst(sub)))(lem))) | #void)
          let neglit = Fol_term.negate_lit(lit)
          let lemmas_2:
            if opt.improved_lemmas
            | if Firstorder.Utils.List.exists(Cop.Subst.eq(sub)(lit))(lem)
              | (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("lemma\n%!") | #void)
                Strom.cons([sub, lem, Proof.Lemma()])(Strom.nil)
              | Strom.nil
            | Host.hol_pipe(Host.hol_pipe(Strom.of_list(lem))(Strom.filter(Cop.Subst.eq(sub)(lit))))(
                Strom.map(
                  fun(l):
                    (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("lemma\n%!") | #void)
                    [sub, PairList.cons(lit, lem), Proof.Lemma()]))
          let reductions_2:
            Strom.filter_map(
              fun(p):
                (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Reduction try %s (for lit %s, lim %d)\n%!")(Print.string_of_lit(p))(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit)))(lim) | #void)
                Firstorder.Utils._op3e__op3e__op3d_(Cop.Subst.unify(sub)(neglit)(p))(
                  fun(sub1):
                    (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Reduction works\n%!") | #void)
                    Host.Some([sub1, PairList.cons(lit, lem), Proof.Reduction()])))(Strom.of_list(path))
          let extensions_2:
            Host.hol_pipe(Host.hol_pipe(Database.db_entries(neglit))(Strom.of_list))(
              Strom.concat_map(
                fun([_, _, vars, hsh] as contra):
                  if (Host.hol_lt(lim)(0) && Host.hol_gt(vars)(0))
                  | Strom.nil
                  | match Cop.Subst.unify_rename(sub)(snd(lit))(contra)
                    | Host.Some([sub1, cla1]): Host.hol_pipe(thecops_Search_prove_clause(opt)(sub1)([PairList.cons(lit, path), lem, Host.hol_sub(lim)(1)])([cla1, hsh]))(Strom.map((fun([sub2, prfs]): [sub2, PairList.cons(lit, lem), Proof.Extension(hsh, prfs)])))
                    | Host.None(): Strom.nil))
          thecops_Search_cut(opt.cut1)(lemmas_2)(thecops_Search_cut(opt.cut2)(reductions_2)(thecops_Search_cut(opt.cut3)(extensions_2)(Strom.nil)))

  fun thecops_Search_prove_clause(opt):
    fun(sub):
      fun([path, lem, lim]):
        fun([cl, cl_hsh]):
          match cl
          | PairList [lit, & lits]:
              if Firstorder.Utils.List.exists((fun(x): Firstorder.Utils.List.exists(Cop.Subst.eq(sub)(x))(path)))(cl)
              | (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("regularity\n%!") | #void)
                Strom.nil
              | Host.hol_pipe(thecops_Search_prove_lit(opt)(sub)([path, lem, lim])(lit))(Strom.concat_map((fun([sub1, lem1, prf1]): Host.hol_pipe(thecops_Search_prove_clause(opt)(sub1)([path, lem1, lim])([lits, cl_hsh]))(Strom.map((fun([sub2, prfs]): [sub2, PairList.cons([lit, prf1], prfs)]))))))
          | PairList []: Strom.cons([sub, PairList []])(Strom.nil)

  def cut = thecops_Search_cut

  def prove_lit = thecops_Search_prove_lit

  def prove_clause = thecops_Search_prove_clause

namespace Recon:
  export:
    hol_negate
    hashek_of_proof

  fun thecops_Recon_hol_negate(tm):
    try:
      Basics.dest_neg(tm)
      ~catch exn:
        match exn
        | Failure(_): Bool.mk_neg(tm)
        | exn: Host.hol_raise(exn)

  fun thecops_Recon_hashek_of_proof(sub):
    fun(lem):
      fun(lit):
        let liti = Firstorder.Mapping.hol_of_literal(Substarray.inst_lit(sub)(lit))
        fun
        | (Proof.Lemma()): find((fun(x): Host.hol_equal(Fusion.concl(x))(liti)))(lem)
        | (Proof.Reduction()): Fusion.ASSUME(liti)
        | (Proof.Extension(contra,prfs)):
            let [_, ths]:
              Firstorder.Utils.List.fold_map(
                fun(lem):
                  fun([lit, prf]):
                    let p = thecops_Recon_hashek_of_proof(sub)(lem)(lit)(prf)
                    [PairList.cons(p, lem), p])(lem)(prfs)
            let cth = Meson.Meson.make_hol_contrapos(contra)
            let hth = (if Host.hol_equal(ths)(PairList []) | cth | Drule.MATCH_MP(cth)(end_itlist(Bool.CONJ)(ths)))
            let ith = Drule.PART_MATCH(I)(hth)(liti)
            Meson.Meson.finish_RULE(Bool.DISCH(thecops_Recon_hol_negate(Fusion.concl(ith)))(ith))

  def hol_negate = thecops_Recon_hol_negate

  def hashek_of_proof = thecops_Recon_hashek_of_proof

namespace Leancop:
  export:
    start
    LEANCOP_DEEPEN
    PREPARE_LEAN_TAC
    PURE_LEANCOP
    GEN_LEANCOP_TAC
    LEANCOP_TAC
    LEANCOP

  fun thecops_Leancop_start(opt):
    fun(lim):
      (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Start %d\n%!")(Host.hol_add(lim)(1)) | #void)
      let sub0 = Cop.Subst.empty(1000000)
      let hashek = Firstorder.Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
      let hashek_neg = Fol_term.negate_lit(hashek)
      let prfs = Search.prove_lit(opt)([sub0, 0])([PairList [], PairList [], lim])(hashek_neg)
      match Strom.next_opt(prfs)
      | Host.Some([sub, _, prf]): Host.Some([fst(sub), prf])
      | Host.None(): Host.None()

  fun thecops_Leancop_LEANCOP_DEEPEN(opt):
    fun(ths):
      Host.hol_apply_unit(Meson.Meson.clear_contrapos_cache)
      Host.hol_apply_unit(Firstorder.Mapping.reset_vars)
      Host.hol_apply_unit(Firstorder.Mapping.reset_consts)
      let ths_prime = append(ths)(Equality.create_eq_axs(opt.add_eq_symmetry)(map(Fusion.concl)(ths)))
      Database.axioms2db(ths_prime)
      let [sub, prf] = Cop.strategy(opt)(thecops_Leancop_start)
      let hashek = Firstorder.Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
      let hashek_neg = Fol_term.negate_lit(hashek)
      let th = Recon.hashek_of_proof(sub)(PairList [])(hashek_neg)(prf)
      Fusion.EQ_MP(Hashek.hashek_eq)(th)

  fun thecops_Leancop_PREPARE_LEAN_TAC(ths): Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Tactics.THEN(Prepare.PREPARE_COP_TAC(ths))(Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.THENC(Canon.PRENEX_CONV)(Canon.WEAK_CNF_CONV)))))(Tactics.RULE_ASSUM_TAC(Host.repeat((fun(th): Bool.SPEC(Basics.genvar(Fusion.type_of(fst(Basics.dest_forall(Fusion.concl(th))))))(th))))))(Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Meson.Meson.CONJUNCTS_THEN_prime(Tactics.ASSUME_TAC)))))(Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Canon.ASSOC_CONV(Theorems.DISJ_ASSOC)))))(Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Tactics.SUBST_VAR_TAC)))

  fun thecops_Leancop_PURE_LEANCOP(opt): (fun(gl): Tactics.ORELSE(Tactics.FIRST_ASSUM(Tactics.CONTR_TAC))(W(o(o(o(Tactics.ACCEPT_TAC)(thecops_Leancop_LEANCOP_DEEPEN(opt)))(map(snd)))(fst)))(gl))

  fun thecops_Leancop_GEN_LEANCOP_TAC(opt): (fun(ths): Tactics.THEN(thecops_Leancop_PREPARE_LEAN_TAC(ths))(thecops_Leancop_PURE_LEANCOP(opt)))

  fun thecops_Leancop_LEANCOP_TAC(ths): thecops_Leancop_GEN_LEANCOP_TAC(Cop.search_opts)(ths)

  fun thecops_Leancop_LEANCOP(ths): (fun(tm): Tactics.prove([tm, thecops_Leancop_LEANCOP_TAC(ths)]))

  def start = thecops_Leancop_start

  def LEANCOP_DEEPEN = thecops_Leancop_LEANCOP_DEEPEN

  def PREPARE_LEAN_TAC = thecops_Leancop_PREPARE_LEAN_TAC

  def PURE_LEANCOP = thecops_Leancop_PURE_LEANCOP

  def GEN_LEANCOP_TAC = thecops_Leancop_GEN_LEANCOP_TAC

  def LEANCOP_TAC = thecops_Leancop_LEANCOP_TAC

  def LEANCOP = thecops_Leancop_LEANCOP

