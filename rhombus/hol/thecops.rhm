                  | Host.hol_printf("bot_of_proof: lit = %s\n%!")(Host.string_of_term(liti))
                  | #void
                »);
                (block:«
                  (block:«
                    if Host.hol_equal(liti)(Fusion.concl(th))
                    | #void
                    | failwith("Assertion failed")
                  »);
                  (block:«
                    match prf
                    | Ncproof.Reduction():«
                        let port_tmp_49 = thecops_Ncrecon_CONTRADICTION(th);
                        let port_tmp_50 = Host.hol_pipe(thecops_Ncrecon_flip_neg(liti))(Fusion.ASSUME);
                        Host.hol_pipe(port_tmp_50)(port_tmp_49)
                    »
                    | Ncproof.Lemma():«
                        (block:«
                          if Firstorder.Utils.List.mem_assoc(liti)(lem)
                          | #void
                          | failwith("Assertion failed")
                        »);
                        Firstorder.Utils.List.assoc(liti)(lem)
                    »
                    | Ncproof.Extension(_,[prefix, postfix],prfs):«
                        let prefix_th = thecops_Ncrecon_prefix_problem(data)(prefix);
                        (block:«
                          (block:«
                            if Host.ref_get(Firstorder.copverb)
                            | Host.hol_printf("prefix_th = %s\n%!")(Host.string_of_thm(prefix_th))
                            | #void
                          »);
                          (block:«
                            let [[_, prfs_prime], bot] = thecops_Ncrecon_bot_of_clause_ext(data)(postfix)([lem, prfs])(prefix_th);
                            (block:«
                              (block:«
                                if Host.hol_equal(prfs_prime)(PairList [])
                                | #void
                                | failwith("Assertion failed")
                              »);
                              (block:«
                                (block:«
                                  if (block:«
                                    let port_tmp_51 = Fusion.hyp(bot);
                                    let port_tmp_52 = Fusion.concl(th);
                                    Firstorder.Utils.List.mem(port_tmp_52)(port_tmp_51)
                                  »)
                                  | #void
                                  | failwith("Assertion failed")
                                »);
                                Bool.MP(Bool.DISCH(Fusion.concl(th))(bot))(th)
                              »)
                            »)
                          »)
                        »)
                    »
                    | _: failwith("bot_of_proof: not a well-formed proof")
                  »)
                »)
              »)
          »
          | _: failwith("bot_of_proof: not a well-formed proof")
        »)
      »)
    »)
  »;
