  fun thecops_Ncsearch_prove_lit(opt):«
    (fun(sub):«
      (fun([mi, path, pi, lem, lim]):«
        (fun(lit):«
          (block:«
            if Host.ref_get(Firstorder.copverb)
            | Host.hol_printf("Lit: %s\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit)))
            | #void
          »);
          (block:«
            (block:«
              if Host.ref_get(Firstorder.copverb)
              | Host.hol_printf("Path: %s\n%!")(Print.string_of_lits(path))
              | #void
            »);
            (block:«
              (block:«
                if Host.ref_get(Firstorder.copverb)
                | Host.hol_printf("Lemmas: %s\n%!")(Print.string_of_lits(lem))
                | #void
              »);
              (block:«
                let port_tmp_20_neglit = Fol_term.negate_lit(lit);
                let port_tmp_21_k:«
                  Host.hol_lazy(fun():«
                    Firstorder.Utils.List.length(pi)
                  »)
                »;
                (block:«
                  let port_tmp_22_lemmas:«
                    if Firstorder.Utils.List.exists(Cop.Subst.eq(sub)(lit))(lem)
                    | (block:«
                      (block:«
                        if Host.ref_get(Firstorder.copverb)
                        | Host.hol_printf("lemma\n%!")
                        | #void
                      »);
                      Strom.cons([sub, lem, Ncproof.Lemma()])(Strom.nil)
                    »)
                    | Strom.nil
