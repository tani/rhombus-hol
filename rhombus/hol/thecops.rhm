  fun thecops_Ncrecon_DISJ_CASES_LIST(th):
    fun(prfs):
      (if Host.hol_equal(Firstorder.Utils.List.length(prfs))(Firstorder.Utils.List.length(Basics.disjuncts(Fusion.concl(th)))) | #void | failwith("Assertion failed"))
      (if Firstorder.Utils.List.for_all2(Firstorder.Utils.List.mem)(Basics.disjuncts(Fusion.concl(th)))(Firstorder.Utils.List.map(Fusion.hyp)(prfs)) | #void | failwith("Assertion failed"))
      let c = Fusion.concl(Firstorder.Utils.List.hd(prfs))
      (if Firstorder.Utils.List.fold_left((fun(acc): (fun(x): (acc && Host.hol_equal(Fusion.concl(x))(c)))))(#true)(prfs) | #void | failwith("Assertion failed"))
      match prfs
      | PairList []: failwith("DISJ_CASES_LIST")
      | PairList [p, & PairList []]: Bool.MP(Bool.DISCH(Fusion.concl(th))(p))(th)
      | PairList [p1, & PairList [p2, & PairList []]]: Bool.DISJ_CASES(th)(p1)(p2)
      | PairList [p, & ps]: Bool.DISJ_CASES(th)(p)(thecops_Ncrecon_DISJ_CASES_LIST(Fusion.ASSUME(snd(Basics.dest_disj(Fusion.concl(th)))))(ps))

  (if Host.hol_equal(Host.hol_pipe(thecops_Ncrecon_DISJ_CASES_LIST(Fusion.ASSUME(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"c\",[\"Tyapp\",\"bool\",[]]]]]")))(PairList.cons(Host.hol_pipe(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"c\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]]]")))(Bool.UNDISCH), PairList.cons(Host.hol_pipe(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"c\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]]]")))(Bool.UNDISCH), PairList.cons(Host.hol_pipe(Class.TAUT(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"c\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"c\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]]]")))(Bool.UNDISCH), PairList [])))))(Fusion.concl))(Host.expand_quote("[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"c\",[\"Tyapp\",\"bool\",[]]]],[\"Comb\",[\"Comb\",[\"Const\",\"\\\\/\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"b\",[\"Tyapp\",\"bool\",[]]]],[\"Var\",\"a\",[\"Tyapp\",\"bool\",[]]]]]")) | #void | failwith("Assertion failed"))

  fun thecops_Ncrecon_CONTRADICTION(x):
    fun(y):
      let [xc, yc] = [Fusion.concl(x), Fusion.concl(y)]
      (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("contra: %s with %s\n%!")(Host.string_of_term(xc))(Host.string_of_term(yc)) | #void)
      if (Basics.is_neg(xc) && Host.hol_not(Basics.is_neg(yc)))
      | Bool.MP(Bool.NOT_ELIM(x))(y)
      | (if (Basics.is_neg(yc) && Host.hol_not(Basics.is_neg(xc))) | Bool.MP(Bool.NOT_ELIM(y))(x) | failwith("no contradiction found"))

  (if Host.hol_equal(Fusion.concl(thecops_Ncrecon_CONTRADICTION(Fusion.ASSUME(Host.expand_quote("[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]]")))(Fusion.ASSUME(Host.expand_quote("[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]")))))(Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]")) | #void | failwith("Assertion failed"))

  (if Host.hol_equal(Fusion.concl(thecops_Ncrecon_CONTRADICTION(Fusion.ASSUME(Host.expand_quote("[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]")))(Fusion.ASSUME(Host.expand_quote("[\"Comb\",[\"Const\",\"~\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]],[\"Var\",\"p\",[\"Tyapp\",\"bool\",[]]]]")))))(Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]")) | #void | failwith("Assertion failed"))

  fun thecops_Ncrecon_flip_neg(tm): (if Basics.is_neg(tm) | Basics.dest_neg(tm) | Bool.mk_neg(tm))

  fun thecops_Ncrecon_nth_disj(j):
    fun(th):
      (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("nth_disj %d %s\n%!")(j)(Host.string_of_term(Fusion.concl(th))) | #void)
      Host.hol_pipe(Host.hol_pipe(Host.hol_pipe(Fusion.concl(th))(Basics.disjuncts))(Firstorder.Utils.List.map(Fusion.ASSUME)))(Firstorder.Utils.List.nth_rest(j))

  fun thecops_Ncrecon_nth_conj(i):
    fun(th):
      (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("nth_conj %d %s\n%!")(i)(Host.string_of_term(Fusion.concl(th))) | #void)
      Firstorder.Utils.List.nth(Bool.CONJUNCTS(th))(i)

  fun thecops_Ncrecon_inst_var(sub):
    fun(ty):
      fun(v):
        let ftm = Substarray.inst_tm(sub)(Meson.Fvar(v))
        try:
          Firstorder.Mapping.hol_of_term(ty)(ftm)
          ~catch exn:
            match exn
            | Failure(e): failwith(Host.hol_concat("inst_var: ")(e))
            | exn: Host.hol_raise(exn)

  fun thecops_Ncrecon_spec_vars(sub):
    fun(vs):
      fun(th):
        (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("spec_vars: |vars| = %d, th = %s\n%!")(Firstorder.Utils.List.length(vs))(Host.string_of_term(Fusion.concl(th))) | #void)
        let tys = Host.hol_pipe(Host.hol_pipe(Host.hol_pipe(Fusion.concl(th))(Basics.strip_forall))(fst))(Firstorder.Utils.List.map(Fusion.type_of))
        (if Host.hol_equal(Firstorder.Utils.List.length(tys))(Firstorder.Utils.List.length(vs)) | #void | failwith("Assertion failed"))
        Firstorder.Utils.List.fold_left2((fun(th): (fun(ty): (fun(v): Bool.SPEC(thecops_Ncrecon_inst_var(sub)(ty)(v))(th)))))(th)(tys)(vs)

  class thecops_Ncrecon_rec_recon_data(problem, mapping, sub):
    extends Host.HolVariant
    override port_view(): PairList [this.problem, this.mapping, this.sub]
    method port_update(updates):
      thecops_Ncrecon_rec_recon_data((if updates.has_key("problem") | updates["problem"] | this.problem), (if updates.has_key("mapping") | updates["mapping"] | this.mapping), (if updates.has_key("sub") | updates["sub"] | this.sub))

  fun thecops_Ncrecon_clause_index_mapping(cl):
    Host.hol_pipe(
      Host.hol_pipe(cl)(
        Firstorder.Utils.List.mapi(
          fun(idx):
            fun
            | (Ncmatrix.Lit(_)): PairList []
            | (Ncmatrix.Mat([j, mat])): PairList.cons([j, idx], thecops_Ncrecon_matrix_index_mapping(mat)))))(Firstorder.Utils.List.concat)

  fun thecops_Ncrecon_matrix_index_mapping(mat): Host.hol_pipe(Host.hol_pipe(mat)(Firstorder.Utils.List.mapi((fun(idx): (fun([[i, v], cl]): PairList.cons([i, idx], thecops_Ncrecon_clause_index_mapping(cl)))))))(Firstorder.Utils.List.concat)

  fun thecops_Ncrecon_mk_recon_data([problem, mat, sub]): thecops_Ncrecon_rec_recon_data(problem, thecops_Ncrecon_matrix_index_mapping(mat), sub)

  fun thecops_Ncrecon_prefix_problem(data):
    let rel = (fun(i): Firstorder.Utils.List.assoc(i)(data.mapping))
    Firstorder.Utils.List.fold_left((fun(th): (fun([[i, v], j]): Host.hol_pipe(Host.hol_pipe(Host.hol_pipe(Host.hol_pipe(th)(thecops_Ncrecon_nth_conj(rel(i))))(thecops_Ncrecon_spec_vars(data.sub)(v)))(thecops_Ncrecon_nth_disj(rel(j))))(fst))))(data.problem)

  fun thecops_Ncrecon_eat_proofs(data):
    Firstorder.Utils.List.fold_map(
      fun([lem, prfs]):
        fun(th):
          match prfs
          | PairList [prf, & prfs]:
              let bot = thecops_Ncrecon_bot_of_proof(data)(lem)(th)(prf)
              [[PairList.cons([Fusion.concl(th), bot], lem), prfs], bot]
          | PairList []: failwith("eat_proofs"))

  fun thecops_Ncrecon_bot_of_clause_ext(data):
    fun([[i, v], [matL, matR], lmext]):
      fun(acc):
        fun(th):
          let i_prime = Firstorder.Utils.List.assoc(i)(data.mapping)
          (if Host.hol_equal(i_prime)(Firstorder.Utils.List.length(matL)) | #void | failwith("Assertion failed"))
          (if Host.hol_equal(Firstorder.Utils.List.length(Bool.CONJUNCTS(th)))(Host.hol_add(1)(Firstorder.Utils.List.length(append(matL)(matR)))) | #void | failwith("Assertion failed"))
          thecops_Ncrecon_bot_of_litmat_ext(data)(acc)(Host.hol_pipe(thecops_Ncrecon_nth_conj(i_prime)(th))(thecops_Ncrecon_spec_vars(data.sub)(v)))(lmext)

  fun thecops_Ncrecon_bot_of_litmat_ext(data):
    fun(acc):
      fun(thi):
        fun
        | (Extclause.Litext([claL, claR],claC)):
            let j = Firstorder.Utils.List.length(claL)
            let [thj, [thL, thR]] = thecops_Ncrecon_nth_disj(j)(thi)
            let [acc1, botsL] = thecops_Ncrecon_eat_proofs(data)(acc)(thL)
            let [acc2, botsR] = thecops_Ncrecon_eat_proofs(data)(acc1)(thR)
            (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("bot_of_litmat_ext: thi = %s\n%!")(Host.string_of_thm(thi)) | #void)
            let tmj = Fusion.concl(thj)
            (if Host.hol_not((Basics.is_conj(tmj) || Basics.is_disj(tmj))) | #void | failwith("Assertion failed"))
            let botj = thecops_Ncrecon_CONTRADICTION(thj)(Host.hol_pipe(Host.hol_pipe(Fusion.concl(thj))(thecops_Ncrecon_flip_neg))(Fusion.ASSUME))
            [acc2, thecops_Ncrecon_DISJ_CASES_LIST(thi)(append(botsL)(PairList.cons(botj, botsR)))]
        | (Extclause.Matext(j,[claL, claR],clext)):
            let j_prime = Firstorder.Utils.List.assoc(j)(data.mapping)
            (if Host.hol_equal(j_prime)(Firstorder.Utils.List.length(claL)) | #void | failwith("Assertion failed"))
            let [thj, [thL, thR]] = thecops_Ncrecon_nth_disj(j_prime)(thi)
            let [acc1, botj] = thecops_Ncrecon_bot_of_clause_ext(data)(clext)(acc)(thj)
            let [acc2, botsL] = thecops_Ncrecon_eat_proofs(data)(acc1)(thL)
            let [acc3, botsR] = thecops_Ncrecon_eat_proofs(data)(acc2)(thR)
            [acc3, thecops_Ncrecon_DISJ_CASES_LIST(thi)(append(botsL)(PairList.cons(botj, botsR)))]

  fun thecops_Ncrecon_bot_of_proof(data):
    fun(lem):
      fun(th):
        fun
        | ([Ncmatrix.Mat([j, mat]), Ncproof.Decomposition(cla,[[i, k], v],prfs)]):
            let i_prime = Firstorder.Utils.List.assoc(i)(data.mapping)
            (if Host.hol_lt(i_prime)(Firstorder.Utils.List.length(mat)) | #void | failwith("Assertion failed"))
            (if Host.hol_equal(snd(Firstorder.Utils.List.nth(mat)(i_prime)))(cla) | #void | failwith("Assertion failed"))
            (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Decomposition %d: %s\n%!")(i_prime)(Host.string_of_term(Fusion.concl(th))) | #void)
            let thi = Host.hol_pipe(thecops_Ncrecon_nth_conj(i_prime)(th))(thecops_Ncrecon_spec_vars(data.sub)(v))
            let djs = Basics.disjuncts(Fusion.concl(thi))
            (if Host.hol_equal(Firstorder.Utils.List.length(djs))(Firstorder.Utils.List.length(prfs)) | #void | failwith("Assertion failed"))
            Host.hol_pipe(Host.hol_pipe(Host.hol_pipe(Firstorder.Utils.List.map(Fusion.ASSUME)(djs))(thecops_Ncrecon_eat_proofs(data)([lem, prfs])))(snd))(thecops_Ncrecon_DISJ_CASES_LIST(thi))
        | ([Ncmatrix.Lit(lit), prf]):
            let liti = Firstorder.Mapping.hol_of_literal(Substarray.inst_lit(data.sub)(lit))
            (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("bot_of_proof: lit = %s\n%!")(Host.string_of_term(liti)) | #void)
            (if Host.hol_equal(liti)(Fusion.concl(th)) | #void | failwith("Assertion failed"))
            match prf
            | Ncproof.Reduction(): Host.hol_pipe(Host.hol_pipe(thecops_Ncrecon_flip_neg(liti))(Fusion.ASSUME))(thecops_Ncrecon_CONTRADICTION(th))
            | Ncproof.Lemma():
                (if Firstorder.Utils.List.mem_assoc(liti)(lem) | #void | failwith("Assertion failed"))
                Firstorder.Utils.List.assoc(liti)(lem)
            | Ncproof.Extension(_,[prefix, postfix],prfs):
                let prefix_th = thecops_Ncrecon_prefix_problem(data)(prefix)
                (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("prefix_th = %s\n%!")(Host.string_of_thm(prefix_th)) | #void)
                let [[_, prfs_prime], bot] = thecops_Ncrecon_bot_of_clause_ext(data)(postfix)([lem, prfs])(prefix_th)
                (if Host.hol_equal(prfs_prime)(PairList []) | #void | failwith("Assertion failed"))
                (if Firstorder.Utils.List.mem(Fusion.concl(th))(Fusion.hyp(bot)) | #void | failwith("Assertion failed"))
                Bool.MP(Bool.DISCH(Fusion.concl(th))(bot))(th)
            | _: failwith("bot_of_proof: not a well-formed proof")
        | (_): failwith("bot_of_proof: not a well-formed proof")

  def DISJ_CASES_LIST = thecops_Ncrecon_DISJ_CASES_LIST

  def CONTRADICTION = thecops_Ncrecon_CONTRADICTION

  def flip_neg = thecops_Ncrecon_flip_neg

  def nth_disj = thecops_Ncrecon_nth_disj

  def nth_conj = thecops_Ncrecon_nth_conj

  def inst_var = thecops_Ncrecon_inst_var

  def spec_vars = thecops_Ncrecon_spec_vars

  def clause_index_mapping = thecops_Ncrecon_clause_index_mapping

  def matrix_index_mapping = thecops_Ncrecon_matrix_index_mapping

  def mk_recon_data = thecops_Ncrecon_mk_recon_data

  def prefix_problem = thecops_Ncrecon_prefix_problem

  def eat_proofs = thecops_Ncrecon_eat_proofs

  def bot_of_clause_ext = thecops_Ncrecon_bot_of_clause_ext

  def bot_of_litmat_ext = thecops_Ncrecon_bot_of_litmat_ext

  def bot_of_proof = thecops_Ncrecon_bot_of_proof

namespace Nanocop:
  export:
    start
    fol_of_thm
    NANOCOP_DEEPEN
    PRINT_TAC
    PRINT_ID_TAC
    PREPARE_NANOCOP_TAC
    PURE_NANOCOP
    GEN_NANOCOP_TAC
    NANOCOP_TAC
    NANOCOP

  fun thecops_Nanocop_start(mat):
    fun(opt):
      fun(lim):
        (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Start %d\n%!")(Host.hol_add(lim)(1)) | #void)
        let mati = Ncmatrix.copy_matrix(0)(mat)
        let sub0 = Cop.Subst.empty(1000000)
        let hashek = Firstorder.Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
        Firstorder.Utils._op3e__op3e__op3d_(
          Host.hol_pipe(
            Host.hol_pipe(Strom.of_list(mati))(
              Strom.filter_map(
                fun(arg_2):
                  match arg_2
                  | [[[i, _], v] as idx, PairList [Ncmatrix.Lit(lit), & PairList []] as cla]:
                      if Host.hol_equal(lit)(hashek)
                      | Firstorder.Utils._op3e__op3e__op3d_(Host.hol_pipe(Ncsearch.prove_clause(opt)([sub0, 0])([mati, PairList [], PairList.cons([i, 0], PairList []), PairList [], lim])(cla))(Strom.next_opt))((fun([sub, prfs]): Host.Some([sub, Ncproof.Decomposition(cla, idx, prfs)])))
                      | match arg_2
                        | _: Host.None()
                  | _: Host.None())))(Strom.next_opt))((fun([sub, prf]): Host.Some([fst(sub), [Ncmatrix.Mat([[-1, 0], mati]), prf]])))

  fun thecops_Nanocop_fol_of_thm(th):
    let lconsts = Fusion.freesl(Fusion.hyp(th))
    let tm = Fusion.concl(th)
    (if Firstorder.Utils.List.for_all((fun(x): Firstorder.Utils.List.mem(x)(lconsts)))(Fusion.frees(tm)) | #void | failwith("Assertion failed"))
    Firstorder.Mapping.fol_of_form(PairList [])(lconsts)(tm)

  fun thecops_Nanocop_NANOCOP_DEEPEN(opt):
    fun(ths):
      if Host.ref_get(Firstorder.copverb)
      | Host.hol_printf("NANOCOP_DEEPEN with ths:\n%!")
        Firstorder.Utils.List.iter(o(Host.hol_printf("  th: %s\n%!"))(Host.string_of_thm))(ths)
      | #void
      Host.hol_apply_unit(Firstorder.Mapping.reset_vars)
      Host.hol_apply_unit(Firstorder.Mapping.reset_consts)
      let gen_eq = o(o(map(Bool.GEN_ALL))(Equality.create_eq_axs(opt.add_eq_symmetry)))(map(Fusion.concl))
      let ths_prime = (if Firstorder.Utils.List.exists((fun(th): Host.hol_equal(Fusion.concl(th))(Hashek.hashek_tm)))(ths) | ths | PairList.cons(Hashek.hashek_thm, ths))
      let ths_prime = Host.setify(append(ths_prime)(gen_eq(ths_prime)))
      let th = end_itlist(Bool.CONJ)(ths_prime)
      let fol = thecops_Nanocop_fol_of_thm(th)
      let mat = Ncmatrix.index_matrix(Ncmatrix.matrix_of_form(fol))
      if Host.ref_get(Firstorder.copverb)
      | Host.hol_printf("Matrix:\n%!")
        Ncprint.print_matrix_i(mat)
      | #void
      Ncdatabase.matrix2db(mat)
      (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Matrix loaded.\n%!") | #void)
      let [sub, prfs] = Cop.strategy(opt)(thecops_Nanocop_start(mat))
      if Host.ref_get(Firstorder.copverb)
      | Host.hol_printf("Theorem\n%!")
        Ncproof.print_proof_def(sub)(prfs)
      | #void
      let data = Ncrecon.mk_recon_data([th, mat, sub])
      let bot = Ncrecon.bot_of_proof(data)(PairList [])(th)(prfs)
      if Host.ref_get(Firstorder.copverb)
      | Host.hol_printf("Reconstruction:\n%!")
        Host.print_thm(bot)
      | #void
      (if Host.set_eq(Fusion.hyp(bot))(Fusion.hyp(th)) | #void | failwith("Assertion failed"))
      (if Host.hol_equal(Fusion.concl(bot))(Host.expand_quote("[\"Const\",\"F\",[\"Tyapp\",\"bool\",[]]]")) | #void | failwith("Assertion failed"))
      bot

  fun thecops_Nanocop_PRINT_TAC(g):
    (if Host.ref_get(Firstorder.copverb) | Host.print_goal(g) | #void)
    Tactics.ALL_TAC(g)

  fun thecops_Nanocop_PRINT_ID_TAC(s):
    fun(g):
      (if Host.ref_get(Firstorder.copverb) | Host.hol_print_endline(s) | #void)
      thecops_Nanocop_PRINT_TAC(g)

  fun thecops_Nanocop_PREPARE_NANOCOP_TAC(ths): Tactics.THEN(Tactics.THEN(Tactics.THEN(Prepare.PREPARE_COP_TAC(ths))(Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.DEPTH_CONV(Equal.CHANGED_CONV(Canon.ASSOC_CONV(Theorems.DISJ_ASSOC)))))))(Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.DEPTH_CONV(Equal.CHANGED_CONV(Canon.ASSOC_CONV(Theorems.CONJ_ASSOC)))))))(Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Tactics.SUBST_VAR_TAC)))

  fun thecops_Nanocop_PURE_NANOCOP(opt): (fun(gl): Tactics.ORELSE(Tactics.FIRST_ASSUM(Tactics.CONTR_TAC))(W(o(o(o(Tactics.ACCEPT_TAC)(thecops_Nanocop_NANOCOP_DEEPEN(opt)))(map(snd)))(fst)))(gl))

  fun thecops_Nanocop_GEN_NANOCOP_TAC(opt): (fun(ths): Tactics.THEN(thecops_Nanocop_PREPARE_NANOCOP_TAC(ths))(thecops_Nanocop_PURE_NANOCOP(opt)))

  fun thecops_Nanocop_NANOCOP_TAC(ths): thecops_Nanocop_GEN_NANOCOP_TAC(Cop.search_opts)(ths)

  fun thecops_Nanocop_NANOCOP(ths): (fun(tm): Tactics.prove([tm, thecops_Nanocop_NANOCOP_TAC(ths)]))

  def start = thecops_Nanocop_start

  def fol_of_thm = thecops_Nanocop_fol_of_thm

  def NANOCOP_DEEPEN = thecops_Nanocop_NANOCOP_DEEPEN

  def PRINT_TAC = thecops_Nanocop_PRINT_TAC

  def PRINT_ID_TAC = thecops_Nanocop_PRINT_ID_TAC

  def PREPARE_NANOCOP_TAC = thecops_Nanocop_PREPARE_NANOCOP_TAC

  def PURE_NANOCOP = thecops_Nanocop_PURE_NANOCOP

  def GEN_NANOCOP_TAC = thecops_Nanocop_GEN_NANOCOP_TAC

  def NANOCOP_TAC = thecops_Nanocop_NANOCOP_TAC

  def NANOCOP = thecops_Nanocop_NANOCOP

def LEANCOP_TAC = Leancop.LEANCOP_TAC

