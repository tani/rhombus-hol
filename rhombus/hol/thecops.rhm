  fun thecops_Ncsearch_pick(f):
    fun port_tmp_16(l):
      fun go(acc):
        fun port_tmp_15(port_tmp_14):
          match port_tmp_14
          | PairList [x, & xs]:
              match f(x)
              | Host.Some(y): [y, (fun(z): Firstorder.Utils.List.rev_append(acc)(PairList.cons(z,xs)))]
              | Host.None(): go(PairList.cons(x,acc))(xs)
          | PairList []: failwith("pick: no element found")
        port_tmp_15
      go(PairList [])(l)
    port_tmp_16

  fun thecops_Ncsearch_nth_clause(i): (fun([[[j, k], v], _] as c): (if Host.hol_equal(i)(j) | Host.Some(c) | Host.None()))

  fun thecops_Ncsearch_nth_matrix(i):
    fun port_tmp_18(port_tmp_17):
      match port_tmp_17
      | Ncmatrix.Lit(_): Host.None()
      | Ncmatrix.Mat([[j, k], _] as m): (if Host.hol_equal(i)(j) | Host.Some(m) | Host.None())
    port_tmp_18

