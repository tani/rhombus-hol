  fun thecops_Leancop_start(opt):
    fun port_tmp_1(lim):
      (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Start %d\n%!")(Host.hol_add(lim)(1)) | #void)
      let sub0 = Cop.Subst.empty(1000000)
      let hashek = Firstorder.Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
      let hashek_neg = Fol_term.negate_lit(hashek)
      let prfs = Search.prove_lit(opt)([sub0, 0])([PairList [], PairList [], lim])(hashek_neg)
      match Strom.next_opt(prfs)
      | Host.Some([sub, _, prf]): Host.Some([fst(sub), prf])
      | Host.None(): Host.None()
    port_tmp_1

  fun thecops_Leancop_LEANCOP_DEEPEN(opt):
    fun port_tmp_4(ths):
      Host.hol_apply_unit(Meson.Meson.clear_contrapos_cache)
      Host.hol_apply_unit(Firstorder.Mapping.reset_vars)
      Host.hol_apply_unit(Firstorder.Mapping.reset_consts)
      let port_tmp_2 = map(Fusion.concl)(ths)
      let port_tmp_3 = opt.add_eq_symmetry
      let ths_prime = append(ths)(Equality.create_eq_axs(port_tmp_3)(port_tmp_2))
      Database.axioms2db(ths_prime)
      let [sub, prf] = Cop.strategy(opt)(thecops_Leancop_start)
      let hashek = Firstorder.Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
      let hashek_neg = Fol_term.negate_lit(hashek)
      let th = Recon.hashek_of_proof(sub)(PairList [])(hashek_neg)(prf)
      Fusion.EQ_MP(Hashek.hashek_eq)(th)
    port_tmp_4

  fun thecops_Leancop_PREPARE_LEAN_TAC(ths):
    let port_tmp_13 = Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Tactics.SUBST_VAR_TAC))
    let port_tmp_11 = Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Canon.ASSOC_CONV(Theorems.DISJ_ASSOC)))
    let port_tmp_9 = Tactics.REPEAT(Tactics.FIRST_X_ASSUM(Meson.Meson.CONJUNCTS_THEN_prime(Tactics.ASSUME_TAC)))
    let port_tmp_7 = Tactics.RULE_ASSUM_TAC(Host.repeat((fun(th): Bool.SPEC(Basics.genvar(Fusion.type_of(fst(Basics.dest_forall(Fusion.concl(th))))))(th))))
    let port_tmp_5 = Tactics.RULE_ASSUM_TAC(Equal.CONV_RULE(Equal.THENC(Canon.PRENEX_CONV)(Canon.WEAK_CNF_CONV)))
    let port_tmp_6 = Prepare.PREPARE_COP_TAC(ths)
    let port_tmp_8 = Tactics.THEN(port_tmp_6)(port_tmp_5)
    let port_tmp_10 = Tactics.THEN(port_tmp_8)(port_tmp_7)
    let port_tmp_12 = Tactics.THEN(port_tmp_10)(port_tmp_9)
    let port_tmp_14 = Tactics.THEN(port_tmp_12)(port_tmp_11)
    Tactics.THEN(port_tmp_14)(port_tmp_13)

  fun thecops_Leancop_PURE_LEANCOP(opt):
    fun port_tmp_19(gl):
      let port_tmp_15 = map(snd)
      let port_tmp_16 = o(Tactics.ACCEPT_TAC)(thecops_Leancop_LEANCOP_DEEPEN(opt))
      let port_tmp_17 = W(o(o(port_tmp_16)(port_tmp_15))(fst))
      let port_tmp_18 = Tactics.FIRST_ASSUM(Tactics.CONTR_TAC)
      Tactics.ORELSE(port_tmp_18)(port_tmp_17)(gl)
    port_tmp_19

  fun thecops_Leancop_GEN_LEANCOP_TAC(opt):
    fun port_tmp_22(ths):
      let port_tmp_20 = thecops_Leancop_PURE_LEANCOP(opt)
      let port_tmp_21 = thecops_Leancop_PREPARE_LEAN_TAC(ths)
      Tactics.THEN(port_tmp_21)(port_tmp_20)
    port_tmp_22

  fun thecops_Leancop_LEANCOP_TAC(ths): thecops_Leancop_GEN_LEANCOP_TAC(Cop.search_opts)(ths)

  fun thecops_Leancop_LEANCOP(ths): (fun(tm): Tactics.prove([tm, thecops_Leancop_LEANCOP_TAC(ths)]))

  def start = thecops_Leancop_start

  def LEANCOP_DEEPEN = thecops_Leancop_LEANCOP_DEEPEN

  def PREPARE_LEAN_TAC = thecops_Leancop_PREPARE_LEAN_TAC

  def PURE_LEANCOP = thecops_Leancop_PURE_LEANCOP

  def GEN_LEANCOP_TAC = thecops_Leancop_GEN_LEANCOP_TAC

  def LEANCOP_TAC = thecops_Leancop_LEANCOP_TAC

  def LEANCOP = thecops_Leancop_LEANCOP

