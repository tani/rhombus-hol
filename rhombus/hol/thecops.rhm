namespace Hashek:
  export:
    hashek_def
    hashek_tm
    hashek_thm
    hashek_prop
    hashek_eq
    MARK_CONCL
    MARK_ASSUMS

  def hashek_def = new_definition(@hol|{hashek = T}|)

  def hashek_tm = @hol|{hashek}|

  def hashek_thm = prove([@hol|{hashek}|, SIMP_TAC(PairList [hashek_def])])

  def hashek_prop:
    prove(
      [
        @hol|{((x /\ hashek) ==> (y /\ hashek)) ==> (x ==> y)}|,
        SIMP_TAC(PairList [hashek_def])
      ]
    )

  def hashek_eq = prove([@hol|{~ hashek <=> F}|, SIMP_TAC(PairList [hashek_def])])

  fun MARK_CONCL(label):
    (
      (
        (
          (
            (
              (
                (
                  (
                    USE_THEN(label)((fun(th): UNDISCH_TAC(concl(th)))) then_tac \
                    (
                      fun(g):
                        (if is_imp(snd(g)) | #void | failwith("Assertion failed"))
                        (if (snd(dest_imp(snd(g))) == @hol|{F}|) | #void | failwith("Assertion failed"))
                        ALL_TAC(g)
                    )
                  ) then_tac \
                  REWRITE_TAC(
                    PairList [
                      TAUT(@hol|{!t. (~t ==> F <=> t)}|)
                    ]
                  )
                ) then_tac \
                POP_ASSUM_LIST(
                  (fun(l): ASSUME_TAC((if (l == (PairList [])) | TRUTH | end_itlist(CONJ)(l))))
                )
              ) then_tac \
              (
                fun(g):
                  (if (length(fst(g)) == 1) | #void | failwith("Assertion failed"))
                  ALL_TAC(g)
              )
            ) then_tac \
            W(o(MAP_EVERY(o(o(UNDISCH_TAC)(concl))(snd)))(fst))
          ) then_tac \
          MATCH_MP_TAC(hashek_prop)
        ) then_tac \
        DISCH_THEN((fun(th): EVERY(map(ASSUME_TAC)(CONJUNCTS(th)))))
      ) then_tac \
      REFUTE_THEN(ASSUME_TAC)
    )

  def MARK_ASSUMS = RULE_ASSUM_TAC(DISCH(@hol|{hashek}|))

namespace Strom:
  export:
    End_of_strom
    nil
    cons
    rename append_impl as append
    of_list
    to_list
    iter
    rename map_impl as map
    rename mapi_impl as mapi
    take
    take_while
    rename filter_impl as filter
    filter_map
    concat
    concat_map
    next_opt
    cache
    cut
    integers_from

  class End_of_strom()

  fun nil(_): (throw End_of_strom())

  fun cons(x):
    fun(l):
      let past = Box(#false)
      fun(_):
        if past.value
        | l(#void)
        | past.value := #true
          x

  fun append_impl(xs):
    fun(ys):
      let past = Box(#false)
      fun(_):
        if past.value
        | ys(#void)
        | try:
            xs(#void)
            ~catch exn:
              match exn
              | End_of_strom():
                  past.value := #true
                  ys(#void)
              | exn: (throw exn)

  fun of_list(l):
    let r = Box(l)
    fun(_):
      match r.value
      | PairList []: (throw End_of_strom())
      | PairList [x, & xs]:
          r.value := xs
          x

  fun to_list(l):
    try:
      let x = l(#void)
      PairList [x, & to_list(l)]
      ~catch exn:
        match exn
        | End_of_strom(): PairList []
        | exn: (throw exn)

  fun iter(f):
    fun(l):
      fun iter(_):
        let x = l(#void)
        f(x)
        iter(#void)
      try:
        iter(#void)
        ~catch exn:
          match exn
          | End_of_strom(): #void
          | exn: (throw exn)

  fun map_impl(f): fun(l): fun(_): f(l(#void))

  fun mapi_impl(f):
    fun(l):
      let i = Box(0)
      fun(_):
        let h = i.value
        i.value := i.value + 1
        f(h)(l(#void))

  fun take(n):
    fun(l):
      let i = Box(n)
      fun(_):
        if (i.value == 0)
        | (throw End_of_strom())
        | i.value := i.value - 1
          l(#void)

  fun take_while(p):
    fun(l):
      fun(_):
        let x = l(#void)
        (if p(x) | x | (throw End_of_strom()))

  fun filter_impl(p):
    fun(l):
      fun(_):
        let x = l(#void)
        (if p(x) | x | filter_impl(p)(l)(#void))

  fun filter_map(f):
    fun(l):
      fun(_):
        match f(l(#void))
        | None(): filter_map(f)(l)(#void)
        | Some(y): y

  fun concat(ls):
    let last_2 = Box(nil)
    fun concat(_):
      try:
        last_2.value(#void)
        ~catch exn:
          match exn
          | End_of_strom():
              last_2.value := ls(#void)
              concat(#void)
          | exn: (throw exn)
    concat

  fun concat_map(f):
    fun(l):
      let last_3 = Box(nil)
      fun concat_map(_):
        try:
          last_3.value(#void)
          ~catch exn:
            match exn
            | End_of_strom():
                last_3.value := f(l(#void))
                concat_map(#void)
            | exn: (throw exn)
      concat_map

  fun next_opt(l):
    try:
      Some(l(#void))
      ~catch exn:
        match exn
        | End_of_strom(): None()
        | exn: (throw exn)

  fun cache(f):
    let result = Box(None())
    fun(_):
      match result.value
      | None():
          let l = f(#void)
          result.value := Some(l)
          l(#void)
      | Some(l): l(#void)

  fun cut(xs):
    fun(ys):
      let cut_2 = Box(#false)
      let past_2 = Box(#false)
      fun(_):
        if past_2.value
        | ys(#void)
        | if cut_2.value
          | nil(#void)
          | try:
              let x = xs(#void)
              cut_2.value := #true
              x
              ~catch exn:
                match exn
                | End_of_strom():
                    past_2.value := #true
                    ys(#void)
                | exn: (throw exn)

  fun integers_from(n):
    let i = Box(n)
    fun(_):
      let h = i.value
      i.value := i.value + 1
      h

namespace Fol_term:
  export:
    var
    negate_lit
    term_max_var
    lit_max_var
    map_term_vars
    map_lit_vars
    map_term
    term_ground
    lit_ground

  fun var(v): Fvar(v)

  fun negate_lit([i, l]): [(-i), l]

  fun term_max_var(acc):
    fun(arg):
      match arg
      | Fvar(x): hol_max(acc)(x)
      | Fnapp(_,l): Utils.List.fold_left(term_max_var)(acc)(l)

  fun lit_max_var(acc): fun([_, a]): Utils.List.fold_left(term_max_var)(acc)(a)

  fun map_term_vars(f):
    fun(arg):
      match arg
      | Fvar(v): f(v)
      | Fnapp(p,t): Fnapp(p, Utils.List.map(map_term_vars(f))(t))

  fun map_lit_vars(f): fun([p, a]): [p, Utils.List.map(map_term_vars(f))(a)]

  fun map_term(fv):
    fun(fa):
      fun
      | (Fvar(v)): fv(v)
      | (Fnapp(p,a)): fa([p, a])

  fun term_ground(t): map_term(Utils.const(#false))(lit_ground)(t)

  fun lit_ground([p, a]): Utils.List.for_all(term_ground)(a)

namespace Print:
  export:
    pp_interleave
    pp_iter
    pp_iter_sp
    pp_enclose
    pp_enclose_cut
    pp_enum
    pp_with_box
    pp_nl
    pp_print_null
    pp_print_var
    pp_print_fterm
    pp_print_lit
    string_of_fterm
    string_of_lit
    string_of_lits

  fun pp_interleave(sep):
    fun(fn):
      fun(f):
        fun
        | (PairList [x, & PairList [_, & _] as xs]):
            fn(f)(x)
            sep(f)
            pp_interleave(sep)(fn)(f)(xs)
        | (PairList [x, & PairList []]): fn(f)(x)
        | (PairList []): #void

  fun pp_iter(sep): pp_interleave((fun(f): Host.OCamlFormat.pp_print_string(f)(sep)))

  fun pp_iter_sp(sep):
    fun(fn):
      let sep:
        fun(f):
          Host.pp_print_char(f)(" ")
          Host.OCamlFormat.pp_print_string(f)(sep)
          Host.pp_print_space(f)()
      pp_interleave(sep)(fn)

  fun pp_enclose(start):
    fun(stop):
      fun(fn):
        fun(f):
          fun(x):
            Host.OCamlFormat.pp_print_string(f)(start)
            fn(f)(x)
            Host.OCamlFormat.pp_print_string(f)(stop)

  fun pp_enclose_cut(start):
    fun(stop):
      fun(fn):
        pp_enclose(
          start)(
          stop)(
      fun(f):
            fun(x):
              fn(f)(x)
              Host.pp_print_cut(f)()
        )

  fun pp_enum(sep): fun(start): fun(stop): fun(fn): pp_enclose(start)(stop)(pp_iter(sep)(fn))

  fun pp_with_box(i):
    fun(fn):
      fun(f):
        fun(x):
          Host.pp_open_box(f)(i)
          fn(f)(x)
          Host.pp_close_box(f)()

  fun pp_nl(fn):
    fun(f):
      fun(x):
        fn(f)(x)
        Host.pp_print_newline(f)()

  fun pp_print_null(f): fun(x): #void

  fun pp_print_var(f):
    fun(i):
      Host.pp_print_char(f)(hol_char_chr((65 + (i rem 26))))
      (if (i > 25) | Host.pp_print_int(f)((i div 26)) | #void)

  fun pp_print_fterm(f):
    fun(arg):
      match arg
      | Fvar(i): pp_print_var(f)(i)
      | Fnapp(i,l):
          Host.pp_print_term(f)(Meson.Meson.hol_of_const(i))
          (if (l != (PairList [])) | pp_enum(",")("(")(")")(pp_print_fterm)(f)(l) | #void)

  fun pp_print_lit(f):
    fun([i, l]):
      (if (i < 0) | Host.pp_print_char(f)("~") | #void)
      Host.pp_print_term(f)(Meson.Meson.hol_of_const(math.abs(i)))
      (if (l != (PairList [])) | pp_enum(",")("(")(")")(pp_print_fterm)(f)(l) | #void)

  def string_of_fterm = Host.print_to_string(pp_print_fterm)

  def string_of_lit = Host.print_to_string(pp_print_lit)

  def string_of_lits = Host.print_to_string(pp_iter(", ")(pp_print_lit))

namespace Database:
  export:
    clause_max_var
    mapentry
    db
    axioms2db
    db_entries

  fun clause_max_var(cl): (1 + OCamlList.fold_left(Fol_term.lit_max_var)(-1)(cl))

  fun mapentry([[cl_rest, [p, args]], th]): [args, cl_rest, clause_max_var(PairList [[p, args], & cl_rest]), th]

  def db = Hashtbl.create(10017)

  fun axioms2db(ths):
    Hashtbl.clear(db)
    (Mapping.fol_of_hol_clauses(ths) |> OCamlList.iter((fun([p, l]): Hashtbl.add(db)((-p))(map(mapentry)(l)))))

  fun db_entries(lit):
    try:
      Hashtbl.find(db)(fst(lit))
      ~catch exn:
        match exn
        | Not_found(): PairList []
        | exn: (throw exn)

fun offset_term(off):
  fun(tm):
    match tm
    | Fvar(v): Fvar((v + off))
    | Fnapp(f,a): Fnapp(f, OCamlList.map(offset_term(off))(a))

fun offset_lit(off): fun([p, pa]): [p, OCamlList.map(offset_term(off))(pa)]

namespace Substlist:
  export:
    Unify
    istriv
    add_subst
    unify_tm
    unify_tms
    unify_lit
    unify_tm_off
    unify_tms_off
    eq_var_tm
    eq_term
    eq_terms
    eq_lit
    inst_tm
    inst_lit
    ground_tm
    ground_lit
    empty
    to_list

  class Unify()

  fun istriv(sub):
    fun(x):
      fun
      | (Fvar(y)):
          if (y == x)
          | #true
          | try:
              let t = OCamlList.assoc(y)(sub)
              istriv(sub)(x)(t)
              ~catch exn:
                match exn
                | Not_found(): #false
                | exn: (throw exn)
      | (Fnapp(f,a)): (OCamlList.exists(istriv(sub)(x))(a) && (throw Unify()))

  fun add_subst(sub): fun(x): fun(t): (if istriv(sub)(x)(t) | sub | PairList [[x, t], & sub])

  fun unify_tm(sub):
    fun(tm1):
      fun(tm2):
        match [tm1, tm2]
        | [Fnapp(f,fargs), Fnapp(g,gargs)]: (if (f != g) | (throw Unify()) | unify_tms(sub)(fargs)(gargs))
        | [tm, Fvar(x)]:
            try:
              let t = OCamlList.assoc(x)(sub)
              unify_tm(sub)(tm)(t)
              ~catch exn:
                match exn
                | Not_found(): add_subst(sub)(x)(tm)
                | exn: (throw exn)
        | [Fvar(x), tm]:
            try:
              let t = OCamlList.assoc(x)(sub)
              unify_tm(sub)(tm)(t)
              ~catch exn:
                match exn
                | Not_found(): add_subst(sub)(x)(tm)
                | exn: (throw exn)

  fun unify_tms(sub): fun(l1): fun(l2): OCamlList.fold_left2(unify_tm)(sub)(l1)(l2)

  fun unify_lit(env): fun([h1, l1]): fun([h2, l2]): (if (h1 != h2) | (throw Unify()) | unify_tms(env)(l1)(l2))

  fun unify_tm_off(off):
    fun(sub):
      fun(t1):
        fun(t2):
          match [t1, t2]
          | [Fnapp(f,fargs), Fnapp(g,gargs)]: (if (f != g) | (throw Unify()) | unify_tms_off(off)(sub)(fargs)(gargs))
          | [_, Fvar(x)]:
              let x = (x + off)
              try:
                let t = OCamlList.assoc(x)(sub)
                unify_tm_off(0)(sub)(t1)(t)
                ~catch exn:
                  match exn
                  | Not_found(): add_subst(sub)(x)(t1)
                  | exn: (throw exn)
          | [Fvar(x), _]:
              try:
                let t = OCamlList.assoc(x)(sub)
                unify_tm_off(off)(sub)(t)(t2)
                ~catch exn:
                  match exn
                  | Not_found(): add_subst(sub)(x)(offset_term(off)(t2))
                  | exn: (throw exn)

  fun unify_tms_off(off): OCamlList.fold_left2(unify_tm_off(off))

  fun eq_var_tm(sub):
    fun(x):
      fun
      | (Fvar(y)):
          if (y == x)
          | #true
          | try:
              let t = OCamlList.assoc(y)(sub)
              eq_var_tm(sub)(x)(t)
              ~catch exn:
                match exn
                | Not_found(): #false
                | exn: (throw exn)
      | (Fnapp(f,a)): #false

  fun eq_term(sub):
    fun(tm1):
      fun(tm2):
        match [tm1, tm2]
        | [Fnapp(f,fa), Fnapp(g,ga)]: ((f == g) && eq_terms(sub)(fa)(ga))
        | [_, Fvar(x)]:
            try:
              let t = OCamlList.assoc(x)(sub)
              eq_term(sub)(tm1)(t)
              ~catch exn:
                match exn
                | Not_found(): eq_var_tm(sub)(x)(tm1)
                | exn: (throw exn)
        | [Fvar(x), _]:
            try:
              let t = OCamlList.assoc(x)(sub)
              eq_term(sub)(t)(tm2)
              ~catch exn:
                match exn
                | Not_found(): eq_var_tm(sub)(x)(tm2)
                | exn: (throw exn)

  fun eq_terms(sub): OCamlList.for_all2(eq_term(sub))

  fun eq_lit(sub): fun([p, pa]): fun([q, qa]): ((p == q) && eq_terms(sub)(pa)(qa))

  fun inst_tm(sub):
    fun(arg):
      match arg
      | Fvar(v):
          try:
            let t = OCamlList.assoc(v)(sub)
            inst_tm(sub)(t)
            ~catch exn:
              match exn
              | Not_found(): Fvar(v)
              | exn: (throw exn)
      | Fnapp(f,args): Fnapp(f, OCamlList.map(inst_tm(sub))(args))

  fun inst_lit(sub): fun([p, l]): [p, OCamlList.map(inst_tm(sub))(l)]

  fun ground_tm(sub):
    fun(arg):
      match arg
      | Fvar(v):
          try:
            let t = OCamlList.assoc(v)(sub)
            ground_tm(sub)(t)
            ~catch exn:
              match exn
              | Not_found(): #false
              | exn: (throw exn)
      | Fnapp(f,args): OCamlList.for_all(ground_tm(sub))(args)

  fun ground_lit(sub): fun([p, l]): OCamlList.for_all(ground_tm(sub))(l)

  fun empty(_): PairList []

  fun to_list(sub): sub

namespace Substarray:
  export:
    Unify
    restore_subst
    istriv
    add_subst
    unify_tm
    unify_tms
    unify_lit
    offset_vars
    unify_tm_off
    unify_tms_off
    eq_var_tm
    eq_tm
    eq_lit
    empty
    to_list
    inst_term
    inst_tm
    inst_lit
    ground_tm
    ground_lit

  class Unify()

  fun restore_subst([[suba, env], subl]):
    fun loop():
      if !(env.value === subl)
      | match env.value
        | PairList [h, & t]:
            (suba[h] := None())
            env.value := t
        | PairList []: failwith("restore_subst")
        loop()
      | #void
    loop()

  fun istriv(suba):
    fun(x):
      fun
      | (Fvar(y)):
          if (y == x)
          | #true
          | match suba[y]
            | Some(t): istriv(suba)(x)(t)
            | None(): #false
      | (Fnapp(f,a)): (OCamlList.exists(istriv(suba)(x))(a) && (throw Unify()))

  fun add_subst([[suba, env], subl] as sub):
    fun(x):
      fun(tm):
        if istriv(suba)(x)(tm)
        | sub
        | (suba[x] := Some(tm))
          env.value := PairList [x, & env.value]
          [[suba, env], env.value]

  fun unify_tm([[suba, env], subl] as sub):
    fun(tm1):
      fun(tm2):
        match [tm1, tm2]
        | [Fnapp(f,fargs), Fnapp(g,gargs)]: (if (f != g) | (throw Unify()) | OCamlList.fold_left2(unify_tm)(sub)(fargs)(gargs))
        | [tm, Fvar(x)]:
            match suba[x]
            | Some(t): unify_tm(sub)(tm)(t)
            | None(): add_subst(sub)(x)(tm)
        | [Fvar(x), tm]:
            match suba[x]
            | Some(t): unify_tm(sub)(tm)(t)
            | None(): add_subst(sub)(x)(tm)

  fun unify_tms(sub):
    fun(l1):
      fun(l2):
        restore_subst(sub)
        OCamlList.fold_left2(unify_tm)(sub)(l1)(l2)

  fun unify_lit(env): fun([h1, l1]): fun([h2, l2]): (if (h1 != h2) | (throw Unify()) | unify_tms(env)(l1)(l2))

  fun offset_vars(off):
    fun(arg):
      match arg
      | Fvar(x): Fvar((x + off))
      | Fnapp(x,l): Fnapp(x, OCamlList.map(offset_vars(off))(l))

  fun unify_tm_off(off):
    fun([[suba, env], subl] as sub):
      fun(t1):
        fun(t2):
          match [t1, t2]
          | [Fnapp(f,fargs), Fnapp(g,gargs)]: (if (f != g) | (throw Unify()) | OCamlList.fold_left2(unify_tm_off(off))(sub)(fargs)(gargs))
          | [_, Fvar(x)]:
              let x = (x + off)
              match suba[x]
              | Some(t): unify_tm_off(0)(sub)(t1)(t)
              | None(): add_subst(sub)(x)(t1)
          | [Fvar(x), _]:
              match suba[x]
              | Some(t): unify_tm_off(off)(sub)(t)(t2)
              | None():
                  let t2_prime = offset_vars(off)(t2)
                  add_subst(sub)(x)(t2_prime)

  fun unify_tms_off(off):
    fun(sub):
      fun(l1):
        fun(l2):
          restore_subst(sub)
          OCamlList.fold_left2(unify_tm_off(off))(sub)(l1)(l2)

  fun eq_var_tm(suba):
    fun(x):
      fun
      | (Fvar(y)):
          if (y == x)
          | #true
          | match suba[y]
            | Some(t): eq_var_tm(suba)(x)(t)
            | None(): #false
      | (Fnapp(f,a)): #false

  fun eq_tm(suba):
    fun(tm1):
      fun(tm2):
        match [tm1, tm2]
        | [Fnapp(f,fargs), Fnapp(g,gargs)]: ((f == g) && OCamlList.for_all2(eq_tm(suba))(fargs)(gargs))
        | [_, Fvar(x)]:
            match suba[x]
            | Some(t): eq_tm(suba)(tm1)(t)
            | None(): eq_var_tm(suba)(x)(tm1)
        | [Fvar(x), _]:
            match suba[x]
            | Some(t): eq_tm(suba)(t)(tm2)
            | None(): eq_var_tm(suba)(x)(tm2)

  fun eq_lit([[suba, _], _] as sub):
    fun([p1, args1]):
      fun([p2, args2]):
        if (p1 == p2)
        | restore_subst(sub)
          OCamlList.for_all2(eq_tm(suba))(args1)(args2)
        | #false

  fun empty(n):
    let suba_2 = Array.make(n, None())
    let env_2 = Box(PairList [])
    let subl_2 = PairList []
    [[suba_2, env_2], subl_2]

  fun to_list([[suba, env], subl]):
    OCamlList.map(
      fun(v):
        match suba[v]
        | None(): failwith("convert_subst")
        | Some(t): [v, t]
    )(subl)

  fun inst_term(suba):
    fun(arg):
      match arg
      | Fvar(x):
          match suba[x]
          | Some(t): inst_term(suba)(t)
          | None(): Fvar(x)
      | Fnapp(f,a): Fnapp(f, OCamlList.map(inst_term(suba))(a))

  fun inst_tm([[suba, _], _] as sub):
    fun(t):
      restore_subst(sub)
      inst_term(suba)(t)

  fun inst_lit([[suba, _], _] as sub):
    fun([p, l]):
      restore_subst(sub)
      [p, OCamlList.map(inst_term(suba))(l)]

  fun ground_tm(suba):
    fun(arg):
      match arg
      | Fvar(x):
          match suba[x]
          | Some(t): ground_tm(suba)(t)
          | None(): #false
      | Fnapp(f,a): OCamlList.for_all(ground_tm(suba))(a)

  fun ground_lit([[suba, _], _] as sub):
    fun([p, l]):
      restore_subst(sub)
      OCamlList.for_all(ground_tm(suba))(l)

namespace Cop:
  export:
    Subst
    SearchOpts
    search_opts
    deepen
    deepen_to
    strategy

  namespace Subst:
    export:
      rename include_1.Unify as Unify
      rename included_restore_subst as restore_subst
      rename included_istriv as istriv
      rename included_add_subst as add_subst
      rename included_unify_tm as unify_tm
      rename included_unify_tms as unify_tms
      rename included_unify_lit as unify_lit
      rename included_offset_vars as offset_vars
      rename included_unify_tm_off as unify_tm_off
      rename included_unify_tms_off as unify_tms_off
      rename included_eq_var_tm as eq_var_tm
      rename included_eq_tm as eq_tm
      rename included_eq_lit as eq_lit
      rename included_empty as empty
      rename included_to_list as to_list
      rename included_inst_term as inst_term
      rename included_inst_tm as inst_tm
      rename included_inst_lit as inst_lit
      rename included_ground_tm as ground_tm
      rename included_ground_lit as ground_lit
      eq
      unify
      unify_rename_subst
      unify_rename

    import: .Substarray as include_1

    def included_restore_subst = include_1.restore_subst

    def included_istriv = include_1.istriv

    def included_add_subst = include_1.add_subst

    def included_unify_tm = include_1.unify_tm

    def included_unify_tms = include_1.unify_tms

    def included_unify_lit = include_1.unify_lit

    def included_offset_vars = include_1.offset_vars

    def included_unify_tm_off = include_1.unify_tm_off

    def included_unify_tms_off = include_1.unify_tms_off

    def included_eq_var_tm = include_1.eq_var_tm

    def included_eq_tm = include_1.eq_tm

    def included_eq_lit = include_1.eq_lit

    def included_empty = include_1.empty

    def included_to_list = include_1.to_list

    def included_inst_term = include_1.inst_term

    def included_inst_tm = include_1.inst_tm

    def included_inst_lit = include_1.inst_lit

    def included_ground_tm = include_1.ground_tm

    def included_ground_lit = include_1.ground_lit

    fun eq([sub, off]): fun(l1): fun(l2): included_eq_lit(sub)(l1)(l2)

    fun unify([sub, off]):
      fun(l1):
        fun(l2):
          try:
            Some([included_unify_lit(sub)(l1)(l2), off])
            ~catch exn:
              match exn
              | include_1.Unify(): None()
              | exn: (throw exn)

    fun unify_rename_subst(off): fun(l1): fun(l2): fun(sub): fun(list): [included_unify_tms_off(off)(sub)(l1)(l2), OCamlList.map(offset_lit(off))(list)]

    fun unify_rename([s, off]):
      fun(args1):
        fun([args2, rest, vars, _]):
          try:
            Some(
              if (vars == 0)
              | [[included_unify_tms(s)(args1)(args2), off], rest]
              | let [s, rest] = unify_rename_subst(off)(args1)(args2)(s)(rest)
                [[s, (off + vars)], rest]
            )
            ~catch exn:
              match exn
              | include_1.Unify(): None()
              | exn: (throw exn)

  record SearchOpts(cut1, cut2, cut3, comp, improved_lemmas, improved_regularity, add_eq_symmetry)

  def search_opts = SearchOpts(#true, #true, #true, 7, #true, #true, #true)

  fun deepen(f):
    fun(i):
      match f(i)
      | Some(x): x
      | None(): deepen(f)((i + 1))

  fun deepen_to(n):
    fun(f):
      fun(i):
        if (i > n)
        | None()
        | match f(i)
          | None(): deepen_to(n)(f)((i + 1))
          | s: s

  fun strategy(opt :~ SearchOpts):
    fun(f):
      if (opt.cut1 || (opt.cut2 || opt.cut3))
      | match deepen_to(opt.comp)(f(opt))(0)
        | None(): deepen(f(opt with (cut1 = #false, cut2 = #false, cut3 = #false)))(0)
        | Some(prf): prf
      | deepen(f(opt))(0)

namespace Equality:
  export:
    create_equality_axioms
    create_eq_axs

  def create_equality_axioms:
    let eq_thms:
      o(CONJUNCTS)(prove)(
        [
          @hol|{(x:A = x) /\ (~(x = y) \/ y = x) /\
             (~(x:A = y) \/ ~(x = z) \/ (y = z))}|,
          (
            (
              (
                REWRITE_TAC(PairList []) then_tac \
                ASM_CASES_TAC(@hol|{x:A = y}|)
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            CONV_TAC(TAUT)
          )
        ]
      )
    let imp_elim_CONV:
      REWR_CONV(
        TAUT(
          @hol|{(a ==> b) <=> ~a \/ b}|
        )
      )
    let eq_elim_RULE:
      MATCH_MP(
        TAUT(
          @hol|{(a <=> b) ==> b \/ ~a}|
        )
      )
    let veq_tm = rator(rator(concl(hd(eq_thms))))
    let create_equivalence_axioms:
      fun([eq, _]):
        let tyins = type_match(type_of(veq_tm))(type_of(eq))(PairList [])
        map(INST_TYPE(tyins))(eq_thms)
    // Recursive term collection needs the local definition before its first use.
    fun tm_consts(tm):
      fun(acc):
        let [fn, args] = strip_comb(tm)
        (if (args == (PairList [])) | acc | itlist(tm_consts)(args)(insert([fn, length(args)])(acc)))
    // Recursive formula collection needs the local definition before its first use.
    fun fm_consts(tm):
      fun([preds, funs] as acc):
        try:
          fm_consts(snd(dest_forall(tm)))(acc)
          ~catch exn:
            match exn
            | Failure(_):
                try:
                  fm_consts(snd(dest_exists(tm)))(acc)
                  ~catch exn:
                    match exn
                    | Failure(_):
                        try:
                          let [l, r] = dest_conj(tm)
                          fm_consts(l)(fm_consts(r)(acc))
                          ~catch exn:
                            match exn
                            | Failure(_):
                                try:
                                  let [l, r] = dest_disj(tm)
                                  fm_consts(l)(fm_consts(r)(acc))
                                  ~catch exn:
                                    match exn
                                    | Failure(_):
                                        try:
                                          let [l, r] = dest_imp(tm)
                                          fm_consts(l)(fm_consts(r)(acc))
                                          ~catch exn:
                                            match exn
                                            | Failure(_):
                                                try:
                                                  fm_consts(dest_neg(tm))(acc)
                                                  ~catch exn:
                                                    match exn
                                                    | Failure(_):
                                                        try:
                                                          let [l, r] = dest_eq(tm)
                                                          (if (type_of(l) == bool_ty) | fm_consts(r)(fm_consts(l)(acc)) | failwith("atomic equality"))
                                                          ~catch exn:
                                                            match exn
                                                            | Failure(_):
                                                                let [pred, args] = strip_comb(tm)
                                                                (if (args == (PairList [])) | acc | [insert([pred, length(args)])(preds), itlist(tm_consts)(args)(funs)])
                                                            | exn: (throw exn)
                                                    | exn: (throw exn)
                                            | exn: (throw exn)
                                    | exn: (throw exn)
                            | exn: (throw exn)
                    | exn: (throw exn)
            | exn: (throw exn)
    let create_congruence_axiom:
      fun(pflag):
        fun([tm, len]):
          let [atys, rty]:
            splitlist(
              fun(ty):
                let [op, l] = dest_type(ty)
                (if (op == "fun") | [hd(l), hd(tl(l))] | fail())
            )(type_of(tm))
          let ctys = fst(chop_list(len)(atys))
          let largs_2 = map(genvar)(ctys)
          let rargs_2 = map(genvar)(ctys)
          let th1 = rev_itlist(C(curry(MK_COMB)))(map(o(ASSUME)(mk_eq))(zip(largs_2)(rargs_2)))(REFL(tm))
          let th2 = (if pflag | eq_elim_RULE(th1) | th1)
          itlist(fun(e): fun(th): CONV_RULE(imp_elim_CONV)(DISCH(e)(th)))(hyp(th2))(th2)
    fun(tms):
      let [preds, funs] = itlist(fm_consts)(tms)([PairList [], PairList []])
      let [eqs0, noneqs] = partition((fun([t, _]): (is_const(t) && (fst(dest_const(t)) == "="))))(preds)
      if (eqs0 == (PairList []))
      | PairList []
      | let pcongs_2 = map(create_congruence_axiom(#true))(noneqs)
        let fcongs_2 = map(create_congruence_axiom(#false))(funs)
        let [preds1, _] = itlist(fm_consts)(map(concl)(append(pcongs_2)(fcongs_2)))([PairList [], PairList []])
        let eqs1 = filter((fun([t, _]): (is_const(t) && (fst(dest_const(t)) == "="))))(preds1)
        let eqs = union(eqs0)(eqs1)
        let equivs = itlist(o(union_prime(equals_thm))(create_equivalence_axioms))(eqs)(PairList [])
        append(equivs)(append(pcongs_2)(fcongs_2))

  fun create_eq_axs(sym):
    match sym
    | #true: create_equality_axioms
    | #false: Meson.Meson.create_equality_axioms

namespace Prepare:
  export:
    PREPARE_COP_TAC

  fun PREPARE_COP_TAC(ths):
    (
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REFUTE_THEN(LABEL_TAC("copconcl")) then_tac \
                          Meson.Meson.POLY_ASSUME_TAC(map(GEN_ALL)(ths))
                        ) then_tac \
                        (Hashek.MARK_CONCL("copconcl") or_tac Hashek.MARK_ASSUMS)
                      ) then_tac \
                      W(o(MAP_EVERY(o(o(UNDISCH_TAC)(concl))(snd)))(fst))
                    ) then_tac \
                    SELECT_ELIM_TAC
                  ) then_tac \
                  W((fun([asl, w]): MAP_EVERY((fun(v): SPEC_TAC([v, v])))(frees(w))))
                ) then_tac \
                CONV_TAC(
                  (
                    (
                      (
                        (PRESIMP_CONV then_conv TOP_DEPTH_CONV(BETA_CONV)) then_conv \
                        LAMBDA_ELIM_CONV
                      ) then_conv \
                      CONDS_CELIM_CONV
                    ) then_conv \
                    Meson.Meson.QUANT_BOOL_CONV
                  )
                )
              ) then_tac \
              REPEAT((GEN_TAC or_tac DISCH_TAC))
            ) then_tac \
            REFUTE_THEN(ASSUME_TAC)
          ) then_tac \
          RULE_ASSUM_TAC(CONV_RULE((NNF_CONV then_conv SKOLEM_CONV)))
        ) then_tac \
        REPEAT(FIRST_X_ASSUM(CHOOSE_TAC))
      ) then_tac \
      ASM_FOL_TAC
    )

namespace Proof:
  export:
    Lemma
    Reduction
    Extension

  variant proof:
    Lemma()
    Reduction()
    Extension(clause, subproofs)

namespace Search:
  export:
    cut
    prove_lit
    prove_clause

  fun cut(p): fun(xs): fun(ys): (if p | Strom.cut(xs)(ys) | Strom.append(xs)(ys))

  fun prove_lit(opt):
    fun(sub):
      fun([path, lem, lim]):
        fun(lit):
          (if copverb.value | hol_printf("Lit: %s\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit))) | #void)
          (if copverb.value | hol_printf("Path: %s\n%!")(Print.string_of_lits(Utils.List.map(Cop.Subst.inst_lit(fst(sub)))(path))) | #void)
          (if copverb.value | hol_printf("Lemmas: %s\n%!")(Print.string_of_lits(Utils.List.map(Cop.Subst.inst_lit(fst(sub)))(lem))) | #void)
          let neglit = Fol_term.negate_lit(lit)
          let lemmas_2:
            if opt.improved_lemmas
            | if Utils.List.exists(Cop.Subst.eq(sub)(lit))(lem)
              | (if copverb.value | hol_printf("lemma\n%!") | #void)
                Strom.cons([sub, lem, Proof.Lemma()])(Strom.nil)
              | Strom.nil
            | ((Strom.of_list(lem) |> Strom.filter(Cop.Subst.eq(sub)(lit))) |> Strom.map(
                  fun(l):
                    (if copverb.value | hol_printf("lemma\n%!") | #void)
                    [sub, PairList [lit, & lem], Proof.Lemma()]
                ))
          let reductions_2:
            Strom.filter_map(
              fun(p):
                (if copverb.value | hol_printf("Reduction try %s (for lit %s, lim %d)\n%!")(Print.string_of_lit(p))(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit)))(lim) | #void)
                Utils._op3e__op3e__op3d_(Cop.Subst.unify(sub)(neglit)(p))(
                  fun(sub1):
                    (if copverb.value | hol_printf("Reduction works\n%!") | #void)
                    Some([sub1, PairList [lit, & lem], Proof.Reduction()])
                )
            )(Strom.of_list(path))
          let extensions_2:
            ((Database.db_entries(neglit) |> Strom.of_list) |> Strom.concat_map(
                fun([_, _, vars, hsh] as contra):
                  if ((lim < 0) && (vars > 0))
                  | Strom.nil
                  | match Cop.Subst.unify_rename(sub)(snd(lit))(contra)
                    | Some([sub1, cla1]): (prove_clause(opt)(sub1)([PairList [lit, & path], lem, (lim - 1)])([cla1, hsh]) |> Strom.map((fun([sub2, prfs]): [sub2, PairList [lit, & lem], Proof.Extension(hsh, prfs)])))
                    | None(): Strom.nil
              ))
          cut(opt.cut1)(lemmas_2)(cut(opt.cut2)(reductions_2)(cut(opt.cut3)(extensions_2)(Strom.nil)))

  fun prove_clause(opt):
    fun(sub):
      fun([path, lem, lim]):
        fun([cl, cl_hsh]):
          match cl
          | PairList [lit, & lits]:
              if Utils.List.exists((fun(x): Utils.List.exists(Cop.Subst.eq(sub)(x))(path)))(cl)
              | (if copverb.value | hol_printf("regularity\n%!") | #void)
                Strom.nil
              | (prove_lit(opt)(sub)([path, lem, lim])(lit) |> Strom.concat_map(
                    (fun([sub1, lem1, prf1]): (prove_clause(opt)(sub1)([path, lem1, lim])([lits, cl_hsh]) |> Strom.map((fun([sub2, prfs]): [sub2, PairList [[lit, prf1], & prfs]]))))
                  ))
          | PairList []: Strom.cons([sub, PairList []])(Strom.nil)

namespace Recon:
  export:
    hol_negate
    hashek_of_proof

  fun hol_negate(tm):
    try:
      dest_neg(tm)
      ~catch exn:
        match exn
        | Failure(_): mk_neg(tm)
        | exn: (throw exn)

  fun hashek_of_proof(sub):
    fun(lem):
      fun(lit):
        let liti = Mapping.hol_of_literal(Substarray.inst_lit(sub)(lit))
        fun
        | (Proof.Lemma()): find((fun(x): (concl(x) == liti)))(lem)
        | (Proof.Reduction()): ASSUME(liti)
        | (Proof.Extension(contra,prfs)):
            let [_, ths]:
              Utils.List.fold_map(
                fun(lem):
                  fun([lit, prf]):
                    let p = hashek_of_proof(sub)(lem)(lit)(prf)
                    [PairList [p, & lem], p]
              )(lem)(prfs)
            let cth = Meson.Meson.make_hol_contrapos(contra)
            let hth = (if (ths == (PairList [])) | cth | MATCH_MP(cth)(end_itlist(CONJ)(ths)))
            let ith = PART_MATCH(I)(hth)(liti)
            Meson.Meson.finish_RULE(DISCH(hol_negate(concl(ith)))(ith))

namespace Leancop:
  export:
    start
    LEANCOP_DEEPEN
    PREPARE_LEAN_TAC
    PURE_LEANCOP
    GEN_LEANCOP_TAC
    LEANCOP_TAC
    LEANCOP

  fun start(opt):
    fun(lim):
      (if copverb.value | hol_printf("Start %d\n%!")((lim + 1)) | #void)
      let sub0 = Cop.Subst.empty(1000000)
      let hashek = Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
      let hashek_neg = Fol_term.negate_lit(hashek)
      let prfs = Search.prove_lit(opt)([sub0, 0])([PairList [], PairList [], lim])(hashek_neg)
      match Strom.next_opt(prfs)
      | Some([sub, _, prf]): Some([fst(sub), prf])
      | None(): None()

  fun LEANCOP_DEEPEN(opt):
    fun(ths):
      Meson.Meson.clear_contrapos_cache(#void)
      Mapping.reset_vars(#void)
      Mapping.reset_consts(#void)
      let ths_prime = append(ths)(Equality.create_eq_axs(opt.add_eq_symmetry)(map(concl)(ths)))
      Database.axioms2db(ths_prime)
      let [sub, prf] = Cop.strategy(opt)(start)
      let hashek = Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
      let hashek_neg = Fol_term.negate_lit(hashek)
      let th = Recon.hashek_of_proof(sub)(PairList [])(hashek_neg)(prf)
      EQ_MP(Hashek.hashek_eq)(th)

  fun PREPARE_LEAN_TAC(ths):
    (
      (
        (
          (
            (
              Prepare.PREPARE_COP_TAC(ths) then_tac \
              RULE_ASSUM_TAC(CONV_RULE((PRENEX_CONV then_conv WEAK_CNF_CONV)))
            ) then_tac \
            RULE_ASSUM_TAC(
              repeat(
                (fun(th): SPEC(genvar(type_of(fst(dest_forall(concl(th))))))(th))
              )
            )
          ) then_tac \
          REPEAT(FIRST_X_ASSUM(Meson.Meson.CONJUNCTS_THEN_prime(ASSUME_TAC)))
        ) then_tac \
        RULE_ASSUM_TAC(CONV_RULE(ASSOC_CONV(DISJ_ASSOC)))
      ) then_tac \
      REPEAT(FIRST_X_ASSUM(SUBST_VAR_TAC))
    )

  fun PURE_LEANCOP(opt):
    fun(gl):
      (
        FIRST_ASSUM(CONTR_TAC) or_tac \
        W(o(o(o(ACCEPT_TAC)(LEANCOP_DEEPEN(opt)))(map(snd)))(fst))
      )(gl)

  fun GEN_LEANCOP_TAC(opt): fun(ths): (PREPARE_LEAN_TAC(ths) then_tac PURE_LEANCOP(opt))

  fun LEANCOP_TAC(ths): GEN_LEANCOP_TAC(Cop.search_opts)(ths)

  fun LEANCOP(ths): fun(tm): prove([tm, LEANCOP_TAC(ths)])

namespace Ncmatrix:
  export:
    Lit
    Mat
    map_litmat
    lit
    mat
    lit_of_litmat
    clause_lits
    clause_of_matrix
    strip_disj
    strip_conj
    strip_forallq
    litmat_of_form
    matrix_of_form
    clause_of_form
    iclause_of_form
    litmat_max_var
    imatrix_max_var
    iclause_max_var
    matrix_max_var
    clause_max_var
    clause_offset
    iclause_offset
    clause_ground
