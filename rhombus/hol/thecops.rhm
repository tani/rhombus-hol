  fun thecops_Ncrecon_bot_of_litmat_ext(data):
    fun port_tmp_62(acc):
      fun port_tmp_61(thi):
        fun port_tmp_60(port_tmp_59):
          match port_tmp_59
          | Extclause.Litext([claL, claR],claC):
              let j = Firstorder.Utils.List.length(claL)
              let [thj, [thL, thR]] = thecops_Ncrecon_nth_disj(j)(thi)
              let [acc1, botsL] = thecops_Ncrecon_eat_proofs(data)(acc)(thL)
              let [acc2, botsR] = thecops_Ncrecon_eat_proofs(data)(acc1)(thR)
              (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("bot_of_litmat_ext: thi = %s\n%!")(Host.string_of_thm(thi)) | #void)
              let tmj = Fusion.concl(thj)
              (if Host.hol_not((Basics.is_conj(tmj) || Basics.is_disj(tmj))) | #void | failwith("Assertion failed"))
              let botj = thecops_Ncrecon_CONTRADICTION(thj)(Host.hol_pipe(Host.hol_pipe(Fusion.concl(thj))(thecops_Ncrecon_flip_neg))(Fusion.ASSUME))
              [acc2, thecops_Ncrecon_DISJ_CASES_LIST(thi)(append(botsL)(PairList.cons(botj,botsR)))]
          | Extclause.Matext(j,[claL, claR],clext):
              let j_prime = Firstorder.Utils.List.assoc(j)(data.mapping)
              (if Host.hol_equal(j_prime)(Firstorder.Utils.List.length(claL)) | #void | failwith("Assertion failed"))
              let [thj, [thL, thR]] = thecops_Ncrecon_nth_disj(j_prime)(thi)
              let [acc1, botj] = thecops_Ncrecon_bot_of_clause_ext(data)(clext)(acc)(thj)
              let [acc2, botsL] = thecops_Ncrecon_eat_proofs(data)(acc1)(thL)
              let [acc3, botsR] = thecops_Ncrecon_eat_proofs(data)(acc2)(thR)
              [acc3, thecops_Ncrecon_DISJ_CASES_LIST(thi)(append(botsL)(PairList.cons(botj,botsR)))]
        port_tmp_60
      port_tmp_61
    port_tmp_62

  fun thecops_Ncrecon_bot_of_proof(data):
    fun port_tmp_78(lem):
      fun port_tmp_77(th):
        fun port_tmp_76(port_tmp_63):
          match port_tmp_63
          | [Ncmatrix.Mat([j, mat]), Ncproof.Decomposition(cla,[[i, k], v],prfs)]:
              let i_prime = Firstorder.Utils.List.assoc(i)(data.mapping)
              (if Host.hol_lt(i_prime)(Firstorder.Utils.List.length(mat)) | #void | failwith("Assertion failed"))
              (if Host.hol_equal(snd(Firstorder.Utils.List.nth(mat)(i_prime)))(cla) | #void | failwith("Assertion failed"))
              (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("Decomposition %d: %s\n%!")(i_prime)(Host.string_of_term(Fusion.concl(th))) | #void)
              let port_tmp_64 = thecops_Ncrecon_spec_vars(data.sub)(v)
              let port_tmp_65 = thecops_Ncrecon_nth_conj(i_prime)(th)
              let thi = Host.hol_pipe(port_tmp_65)(port_tmp_64)
              let djs = Basics.disjuncts(Fusion.concl(thi))
              let port_tmp_66 = Firstorder.Utils.List.length(prfs)
              let port_tmp_67 = Firstorder.Utils.List.length(djs)
              (if Host.hol_equal(port_tmp_67)(port_tmp_66) | #void | failwith("Assertion failed"))
              let port_tmp_70 = thecops_Ncrecon_DISJ_CASES_LIST(thi)
              let port_tmp_68 = thecops_Ncrecon_eat_proofs(data)([lem, prfs])
              let port_tmp_69 = Firstorder.Utils.List.map(Fusion.ASSUME)(djs)
              let port_tmp_71 = Host.hol_pipe(Host.hol_pipe(port_tmp_69)(port_tmp_68))(snd)
              Host.hol_pipe(port_tmp_71)(port_tmp_70)
          | [Ncmatrix.Lit(lit), prf]:
              let liti = Firstorder.Mapping.hol_of_literal(Substarray.inst_lit(data.sub)(lit))
              (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("bot_of_proof: lit = %s\n%!")(Host.string_of_term(liti)) | #void)
              (if Host.hol_equal(liti)(Fusion.concl(th)) | #void | failwith("Assertion failed"))
              match prf
              | Ncproof.Reduction():
                  let port_tmp_72 = thecops_Ncrecon_CONTRADICTION(th)
                  let port_tmp_73 = Host.hol_pipe(thecops_Ncrecon_flip_neg(liti))(Fusion.ASSUME)
                  Host.hol_pipe(port_tmp_73)(port_tmp_72)
              | Ncproof.Lemma():
                  (if Firstorder.Utils.List.mem_assoc(liti)(lem) | #void | failwith("Assertion failed"))
                  Firstorder.Utils.List.assoc(liti)(lem)
              | Ncproof.Extension(_,[prefix, postfix],prfs):
                  let prefix_th = thecops_Ncrecon_prefix_problem(data)(prefix)
                  (if Host.ref_get(Firstorder.copverb) | Host.hol_printf("prefix_th = %s\n%!")(Host.string_of_thm(prefix_th)) | #void)
                  let [[_, prfs_prime], bot] = thecops_Ncrecon_bot_of_clause_ext(data)(postfix)([lem, prfs])(prefix_th)
                  (if Host.hol_equal(prfs_prime)(PairList []) | #void | failwith("Assertion failed"))
                  let port_tmp_74 = Fusion.hyp(bot)
                  let port_tmp_75 = Fusion.concl(th)
                  (if Firstorder.Utils.List.mem(port_tmp_75)(port_tmp_74) | #void | failwith("Assertion failed"))
                  Bool.MP(Bool.DISCH(Fusion.concl(th))(bot))(th)
              | _: failwith("bot_of_proof: not a well-formed proof")
          | _: failwith("bot_of_proof: not a well-formed proof")
        port_tmp_76
      port_tmp_77
    port_tmp_78

