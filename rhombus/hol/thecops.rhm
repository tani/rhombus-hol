        let port_tmp_15 = Prepare.PREPARE_COP_TAC(ths);
        Tactics.THEN(port_tmp_15)(port_tmp_14)
      »);
      Tactics.THEN(port_tmp_13)(port_tmp_12)
    »);
    Tactics.THEN(port_tmp_11)(port_tmp_10)
  »;
  fun thecops_Nanocop_PURE_NANOCOP(opt):«
    (fun(gl):«
      let port_tmp_16 = W(o((block:«
        let port_tmp_17 = map(snd);
        let port_tmp_18 = o(Tactics.ACCEPT_TAC)(thecops_Nanocop_NANOCOP_DEEPEN(opt));
