    offset_clause
    offset_matrix

  variant litmat:
    Lit(literal)
    Mat(matrix)

  fun map_litmat(fl):
    fun(fm):
      fun
      | (Lit(lit)): fl(lit)
      | (Mat(mat)): fm(mat)

  fun lit(x): Lit(x)

  fun mat(x): Mat(x)

  fun lit_of_litmat
  | lit_of_litmat(Lit(l)): Some(l)
  | lit_of_litmat(Mat(_)): None()

  fun clause_lits(c): Utils.List.filter_map(lit_of_litmat)(c)

  fun clause_of_matrix
  | clause_of_matrix(PairList [[[_, PairList []], c], & PairList []]): c
  | clause_of_matrix(lm): PairList [Mat([#void, lm])]

  fun strip_disj
  | strip_disj(Disj(l,r)): append(strip_disj(l))(strip_disj(r))
  | strip_disj(x): PairList [x]

  fun strip_conj
  | strip_conj(Conj(l,r)): append(strip_conj(l))(strip_conj(r))
  | strip_conj(x): PairList [x]

  fun strip_forallq(acc):
    fun(arg):
      match arg
      | Forallq(x,t): strip_forallq(PairList [x, & acc])(t)
      | t: [Utils.List.rev(acc), t]

  fun litmat_of_form
  | litmat_of_form(Atom(t)): Lit(t)
  | litmat_of_form(Conj(_,_) as t): Mat([#void, matrix_of_form(t)])
  | litmat_of_form(Forallq(_,_) as t): Mat([#void, matrix_of_form(t)])
  | litmat_of_form(_): failwith("litmat_of_form")

  fun matrix_of_form(t): Utils.List.map(iclause_of_form)(strip_conj(t))

  fun clause_of_form(t): Utils.List.map(litmat_of_form)(strip_disj(t))

  fun iclause_of_form(t):
    let [univ, t_prime] = strip_forallq(PairList [])(t)
    [[#void, univ], clause_of_form(t_prime)]

  fun litmat_max_var(acc): map_litmat(Fol_term.lit_max_var(acc))(imatrix_max_var(acc))

  fun imatrix_max_var(acc): fun([_, m]): matrix_max_var(acc)(m)

  fun iclause_max_var(acc): fun([_, c]): clause_max_var(acc)(c)

  fun matrix_max_var(acc): fun(m): Utils.List.fold_left(iclause_max_var)(acc)(m)

  fun clause_max_var(acc): fun(c): Utils.List.fold_left(litmat_max_var)(acc)(c)

  fun clause_offset(c): (1 + clause_max_var(-1)(c))

  fun iclause_offset(c): (1 + iclause_max_var(-1)(c))

  fun clause_ground(c):
    Utils.List.for_all(
      fun
      | (Lit(l)): Fol_term.lit_ground(l)
      | (Mat(_)): #false
    )(c)

  fun index_imatrix(i):
    fun([_, m]):
      let [j, m_prime] = index_matrix_impl((i + 1))(m)
      [j, [i, m_prime]]

  fun index_matrix_impl(i): fun(m): Utils.List.fold_map(index_iclause)(i)(m)

  fun index_iclause(i):
    fun([[_, v], c]):
      let [j, c_prime] = index_clause((i + 1))(c)
      [j, [[i, v], c_prime]]

  fun index_clause(i): fun(c): Utils.List.fold_map(index_litmat)(i)(c)

  fun index_litmat(i):
    fun(arg):
      match arg
      | Lit(l): [i, Lit(l)]
      | Mat(m):
          let [j, m_prime] = index_imatrix(i)(m)
          [j, Mat(m_prime)]

  fun index_matrix_v2(m): snd(index_matrix_impl(0)(m))

  fun map_imatrix(f): fun([t, m]): [f(t), map_matrix(f)(m)]

  fun map_matrix(f): fun(m): Utils.List.map(map_iclause(f))(m)

  fun map_iclause(f): fun([[t, v], c]): [[f(t), v], map_clause(f)(c)]

  fun map_clause(f): fun(c): Utils.List.map(map_litmat(lit)(Utils._op25_(mat)(map_imatrix(f))))(c)

  fun copy_matrix(k): fun(m): map_matrix((fun(i): [i, k]))(m)

  fun copy_clause(k): fun(c): map_clause((fun(i): [i, k]))(c)

  fun break_map(f):
    fun(arg):
      match arg
      | PairList []: Some(PairList [])
      | PairList [x, & xs]:
          Utils._op3e__op3e__op3d_(f(x))(
            (fun(y): Utils._op3e__op3e__op3d_(break_map(f)(xs))((fun(ys): Some(PairList [y, & ys]))))
          )

  fun litmat_positive(lm): map_litmat(lit_positive)(imatrix_positive)(lm)

  fun lit_positive([p, a]): (if (p < 0) | Some(Lit([p, a])) | None())

  fun imatrix_positive([i, m]):
    match matrix_positive(m)
    | PairList []: None()
    | m_prime: Some(Mat([i, m_prime]))

  fun matrix_positive(m): Utils.List.filter_map(iclause_positive)(m)

  fun iclause_positive([i, c]): Utils._op3e__op3e__op3d_(clause_positive(c))((fun(c_prime): Some([i, c_prime])))

  fun clause_positive(c): break_map(litmat_positive)(c)

  fun map_litmat_vars(f): map_litmat(Utils._op25_(lit)(Fol_term.map_lit_vars(Utils._op25_(Fol_term.var)(f))))(Utils._op25_(mat)(map_imatrix_vars(f)))

  fun map_imatrix_vars(f): fun([i, m]): [i, map_matrix_vars(f)(m)]

  fun map_matrix_vars(f): fun(m): Utils.List.map(map_iclause_vars(f))(m)

  fun map_iclause_vars(f): fun([[i, v], c]): [[i, Utils.List.map(f)(v)], map_clause_vars(f)(c)]

  fun map_clause_vars(f): fun(c): Utils.List.map(map_litmat_vars(f))(c)

  fun offset_iclause(off): map_iclause_vars((fun (y): off + y))

  fun offset_clause(off): map_clause_vars((fun (y): off + y))

  fun offset_matrix(off): map_matrix_vars((fun (y): off + y))

namespace Ncprint:
  export:
    pp_print_litmat
    pp_print_imatrix
    pp_print_matrix
    pp_print_iclause
    pp_print_nclause
    pp_print_index
    string_of_litmat
    string_of_iclause
    string_of_iclause_i
    string_of_nclause
    string_of_matrix
    pp_print_matrix_ni
    print_iclause
    print_iclause_i
    print_nclause
    print_matrix_i

  fun pp_print_litmat(fi):
    fun(f):
      fun
      | (Ncmatrix.Lit(l)): Print.pp_print_lit(f)(l)
      | (Ncmatrix.Mat(m)): pp_print_imatrix(fi)(f)(m)

  fun pp_print_imatrix(fi):
    fun(f):
      fun([i, m]):
        Host.pp_open_box(f)(1)
        fi(f)(i)
        pp_print_matrix(fi)(f)(m)
        Host.pp_close_box(f)()

  fun pp_print_matrix(fi): Print.pp_with_box(1)(Print.pp_enclose_cut("[")("]")(Print.pp_iter_sp("&")(pp_print_iclause(fi))))

  fun pp_print_iclause(fi):
    fun(f):
      fun([[i, v], c]):
        Host.pp_open_box(f)(1)
        fi(f)(i)
        Print.pp_enum(",")("{")("}")(Print.pp_print_var)(f)(v)
        Host.pp_print_char(f)(":")
        Host.pp_print_space(f)()
        pp_print_nclause(fi)(f)(c)
        Host.pp_close_box(f)()

  fun pp_print_nclause(fi): Print.pp_with_box(1)(Print.pp_enclose_cut("[")("]")(Print.pp_iter_sp("|")(pp_print_litmat(fi))))

  def pp_print_index = Print.pp_enclose("<")(">")(Host.pp_print_int)

  fun string_of_litmat(c): Host.print_to_string(pp_print_litmat(Print.pp_print_null))(c)

  fun string_of_iclause(c): Host.print_to_string(pp_print_iclause(Print.pp_print_null))(c)

  def string_of_iclause_i = Host.print_to_string(pp_print_iclause(pp_print_index))

  fun string_of_nclause(c): Host.print_to_string(pp_print_nclause(Print.pp_print_null))(c)

  fun string_of_matrix(m): Host.print_to_string(pp_print_matrix(Print.pp_print_null))(m)

  fun pp_print_matrix_ni(fmt): fun(x): pp_print_matrix(Print.pp_print_null)(fmt)(x)

  fun print_iclause(c): Print.pp_nl(pp_print_iclause(Print.pp_print_null))(Host.std_formatter)(c)

  def print_iclause_i = Print.pp_nl(pp_print_iclause(pp_print_index))(Host.std_formatter)

  fun print_nclause(c): Print.pp_nl(pp_print_nclause(Print.pp_print_null))(Host.std_formatter)(c)

  def print_matrix_i = Print.pp_nl(pp_print_matrix(pp_print_index))(Host.hol_std_formatter)

namespace Ncproof:
  export:
    Lemma
    Reduction
    Decomposition
    Extension
    pp_print_proof
    pp_print_prf
    pp_print_proofs
    string_of_inst_litmat
    print_proofa
    print_proof_def

  variant proof:
    Lemma()
    Reduction()
    Decomposition(clause, reconstruction, subproofs)
    Extension(clause, extension, subproofs)

  fun pp_print_proof([fl, fc]):
    fun(sub):
      fun(f):
        fun([lit, prf]):
          Host.pp_open_vbox(f)(2)
          Host.OCamlFormat.pp_print_string(f)(fl(sub)(lit))
          Host.pp_print_char(f)(" ")
          pp_print_prf([fl, fc])(sub)(f)(prf)
          Host.pp_close_box(f)()

  fun pp_print_prf([fl, fc]):
    fun(sub):
      fun(f):
        fun
        | (Reduction()): Host.OCamlFormat.pp_print_string(f)("Red")
        | (Lemma()): Host.OCamlFormat.pp_print_string(f)("Lem")
        | (Decomposition(cl,recon,prfs)):
            Host.OCamlFormat.pp_print_string(f)(("Dec " +& fc(cl)))
            pp_print_proofs([fl, fc])(sub)(f)(prfs)
        | (Extension(cl,recon,prfs)):
            Host.OCamlFormat.pp_print_string(f)(("Ext " +& fc(cl)))
            pp_print_proofs([fl, fc])(sub)(f)(prfs)

  fun pp_print_proofs([fl, fc]):
    fun(sub):
      fun(f):
        OCamlList.iter(
          fun(x):
            Host.pp_print_cut(f)()
            pp_print_proof([fl, fc])(sub)(f)(x)
        )

  fun string_of_inst_litmat(sub): fun(litmat): Ncprint.string_of_litmat(litmat)

  fun print_proofa([fl, fc]): fun(sub): fun(prf): Print.pp_nl(pp_print_proof([fl, fc])(sub))(Host.std_formatter)(prf)

  fun print_proof_def(sub): fun(prf): print_proofa([string_of_inst_litmat, Ncprint.string_of_nclause])(sub)(prf)

namespace Extclause:
  export:
    Litext
    Matext
    offset_iv
    offset_litmat_ext
    offset_clause_ext
    claBC_of_litmat_ext
    matBC_of_clause_ext
    litext_of_litmat_ext
    litext_of_clause_ext
    assert_iclause
    assert_imatrix
    assert_matrix

  variant litmat_ext:
    Litext(surrounding, clause)
    Matext(index, surrounding, path)

  fun offset_iv(off): fun([i, v]): [i, Utils.List.map((fun (y): off + y))(v)]

  fun offset_litmat_ext(off):
    fun(arg):
      match arg
      | Litext(claB,claC):
          Litext(
            Utils.Pair.mapn(Ncmatrix.offset_clause(off))(claB),
            Ncmatrix.offset_clause(off)(claC)
          )
      | Matext(j,claLR,clext):
          Matext(
            j,
            Utils.Pair.mapn(Ncmatrix.offset_clause(off))(claLR),
            offset_clause_ext(off)(clext)
          )

  fun offset_clause_ext(off):
    fun([iv, matLR, lmext]):
      [
        offset_iv(off)(iv),
        Utils.Pair.mapn(Ncmatrix.offset_matrix(off))(matLR),
        offset_litmat_ext(off)(lmext)
      ]

  fun claBC_of_litmat_ext
  | claBC_of_litmat_ext(Litext([claL, claR],claC)): [Utils.List.rev_append(claL)(claR), claC]
  | claBC_of_litmat_ext(Matext(j,[claL, claR],clext)):
      let [matB_2, matC_2] = matBC_of_clause_ext(clext)
      let claLR_2 = Utils.List.rev_append(claL)(claR)
      [append(matB_2)(claLR_2), PairList [Ncmatrix.Mat([j, matC_2]), & claLR_2]]

  fun matBC_of_clause_ext([iv, [matL, matR], lmext]):
    let [claB, claC] = claBC_of_litmat_ext(lmext)
    [claB, PairList [[iv, claC], & Utils.List.rev_append(matL)(matR)]]

  fun litext_of_litmat_ext
  | litext_of_litmat_ext(Litext(claB,claC)): [claB, claC]
  | litext_of_litmat_ext(Matext(_,_,clext)): litext_of_clause_ext(clext)

  fun litext_of_clause_ext([_, _, lmext]): litext_of_litmat_ext(lmext)

  fun assert_iclause(matLR):
    fun([iv, c]):
      ((Utils.List.list_rest(c) |> Utils.List.concat_map(
            (fun([lm, claLR]): Ncmatrix.map_litmat((fun(lit): PairList [[lit, Litext(claLR, c)]]))(assert_imatrix(claLR))(lm))
          )) |> Utils.List.map((fun([lit, lmext]): [lit, [iv, matLR, lmext]])))

  fun assert_imatrix(claLR):
    fun([j, mat]):
      ((Utils.List.list_rest(mat) |> Utils.List.concat_map((fun([cla, matLR]): assert_iclause(matLR)(cla)))) |> Utils.List.map((fun([lit, claext]): [lit, Matext(j, claLR, claext)])))

  fun assert_matrix(mat): (Utils.List.list_rest(mat) |> Utils.List.concat_map((fun([cla, matLR]): assert_iclause(matLR)(cla))))

namespace Ncdatabase:
  export:
    db
    insert_db
    matrix2db
    db_entries

  def db = Hashtbl.create(10000)

  fun insert_db(db):
    fun([[p, a], clext]):
      let matC = snd(Extclause.matBC_of_clause_ext(clext))
      let off = (1 + Ncmatrix.matrix_max_var(-1)(matC))
      let ground = ((Extclause.litext_of_clause_ext(clext) |> snd) |> Ncmatrix.clause_ground)
      let v = [clext, a, ground, off]
      try:
        ((Hashtbl.find(db)(p) |> (fun(l): PairList [v, & l])) |> Hashtbl.replace(db)(p))
        ~catch exn:
          match exn
          | Not_found(): Hashtbl.add(db)(p)(PairList [v])
          | exn: (throw exn)

  fun matrix2db(m):
    let predb = Extclause.assert_matrix(m)
    Hashtbl.clear(db)
    OCamlList.iter(insert_db(db))(PairList.reverse(predb))

  fun db_entries(lit):
    try:
      Hashtbl.find(db)(fst(lit))
      ~catch exn:
        match exn
        | Not_found(): PairList []
        | exn: (throw exn)

namespace Ncsearch:
  export:
    unify_vars
    unify_rename
    pick
    nth_clause
    nth_matrix
    unique
    prove_ec
    cut
    prove_lit
    prove_mat
    prove_litmat
    prove_clause

  fun unify_vars([sub, off]):
    fun(l1):
      fun(l2):
        try:
          Some(
            [
              Cop.Subst.unify_tms(sub)(Utils.List.map(Fol_term.var)(l1))(Utils.List.map(Fol_term.var)(l2)),
              off
            ]
          )
          ~catch exn:
            match exn
            | Cop.Subst.Unify(): None()
            | exn: (throw exn)

  fun unify_rename([sub, off]):
    fun(args1):
      fun([clext, args2, _, vars]):
        try:
          Some(
            if (vars == 0)
            | [[Cop.Subst.unify_tms(sub)(args1)(args2), off], clext]
            | [
                [Cop.Subst.unify_tms_off(off)(sub)(args1)(args2), (off + vars)],
                Extclause.offset_clause_ext(off)(clext)
              ]
          )
          ~catch exn:
            match exn
            | Cop.Subst.Unify(): None()
            | exn: (throw exn)

  fun pick(f):
    fun(l):
      // Recursive selection needs the local definition before its first use.
      fun go(acc):
        fun(arg):
          match arg
          | PairList [x, & xs]:
              match f(x)
              | Some(y): [y, (fun(z): Utils.List.rev_append(acc)(PairList [z, & xs]))]
              | None(): go(PairList [x, & acc])(xs)
          | PairList []: failwith("pick: no element found")
      go(PairList [])(l)

  fun nth_clause(i): fun([[[j, k], v], _] as c): (if (i == j) | Some(c) | None())

  fun nth_matrix(i):
    fun(arg):
      match arg
      | Ncmatrix.Lit(_): None()
      | Ncmatrix.Mat([[j, k], _] as m): (if (i == j) | Some(m) | None())

  fun unique(f): fun(l): (Utils.List.length(Utils.List.filter_map(f)(l)) == 1)

  fun prove_ec(k):
    fun(sub):
      fun([[i, v], _, lmext] as clext):
        fun(mi):
          fun(pi):
            (if unique(nth_clause(i))(mi) | #void | failwith("Assertion failed"))
            (if (Utils.List.length(pi) == k) | #void | failwith("Assertion failed"))
            let [[[[i, k1], v1], cla1], miAB] = pick(nth_clause(i))(mi)
            let alt1_2:
              fun(_):
                match lmext
                | Extclause.Matext(j,_,clext_prime):
                    if Utils.List.mem([j, k1])(pi)
                    | match unify_vars(sub)(v)(v1)
                      | None(): Strom.nil
                      | Some(sub2):
                          let [[[j, k1_prime], mi2], claDE] = pick(nth_matrix(j))(cla1)
                          (if unique(nth_matrix(j))(cla1) | #void | failwith("Assertion failed"))
                          (if (k1 == k1_prime) | #void | failwith("Assertion failed"))
                          (prove_ec(k)(sub2)(clext_prime)(mi2)(pi) |> Strom.map(
                              fun([sub3, [prefix, postfix], claB1, mi3]):
                                [
                                  sub3,
                                  [PairList [[[i, v1], j], & prefix], postfix],
                                  claB1,
                                  miAB([[[i, k1], v1], claDE(Ncmatrix.Mat([[j, k1], mi3]))])
                                ]
                            ))
                    | match lmext
                      | _: Strom.nil
                | _: Strom.nil
            let alt2_2:
              fun(_):
                if (Utils.List.mem([i, k1])(pi) && (v == (PairList [])))
                | Strom.nil
                | let [claB, claC] = Extclause.claBC_of_litmat_ext(lmext)
                  let index_2 = (fun(cla): [[[i, k], v], Ncmatrix.copy_clause(k)(cla)])
                  Strom.cons([sub, [PairList [], clext], index_2(claB), miAB(index_2(claC))])(Strom.nil)
            Strom.append(Strom.cache(alt1_2))(Strom.cache(alt2_2))

  fun cut(p): fun(xs): fun(ys): (if p | Strom.cut(xs)(ys) | Strom.append(xs)(ys))

  fun prove_lit(opt):
    fun(sub):
      fun([mi, path, pi, lem, lim]):
        fun(lit):
          (if copverb.value | hol_printf("Lit: %s\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit))) | #void)
          (if copverb.value | hol_printf("Path: %s\n%!")(Print.string_of_lits(path)) | #void)
          (if copverb.value | hol_printf("Lemmas: %s\n%!")(Print.string_of_lits(lem)) | #void)
          let neglit_2 = Fol_term.negate_lit(lit)
          let k_2 = hol_lazy((fun(): Utils.List.length(pi)))
          let lemmas_2:
            if Utils.List.exists(Cop.Subst.eq(sub)(lit))(lem)
            | (if copverb.value | hol_printf("lemma\n%!") | #void)
              Strom.cons([sub, lem, Ncproof.Lemma()])(Strom.nil)
            | Strom.nil
          let reductions_2:
            (Strom.of_list(path) |> Strom.filter_map(
                fun(p):
                  (if copverb.value | hol_printf("Reduction try %s\n%!")(Print.string_of_lit(p)) | #void)
                  match Cop.Subst.unify(sub)(neglit_2)(p)
                  | Some(sub1):
                      (if copverb.value | hol_printf("Reduction works\n%!") | #void)
                      Some([sub1, lem, Ncproof.Reduction()])
                  | None(): None()
              ))
          let extensions_2:
            ((Ncdatabase.db_entries(neglit_2) |> Strom.of_list) |> Strom.concat_map(
                fun([_, args, ground, vars] as contra):
                  (if copverb.value | hol_printf("Extension try (for lit %s, args (%s), lim %d, vars %d)\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub))(lit)))(hol_string_concat(",")(Utils.List.map(Print.string_of_fterm)(args)))(lim)(vars) | #void)
                  if ((lim < 0) && !ground)
                  | Strom.nil
                  | match unify_rename(sub)(snd(lit))(contra)
                    | Some([sub1, clext]):
                        (if copverb.value | hol_printf("Extension works (for lit %s, lim %d)\n%!")(Print.string_of_lit(Cop.Subst.inst_lit(fst(sub1))(lit)))(lim) | #void)
                        (if copverb.value | hol_printf("Old/new offsets: %d/%d\n%!")(snd(sub))(snd(sub1)) | #void)
                        (prove_ec(hol_force(k_2))(sub1)(clext)(mi)(pi) |> Strom.concat_map(
                            fun([sub2, position, [[i, v], claB1], mi1]):
                              (if copverb.value | hol_printf("Extension clause %s found\n%!")(Ncprint.string_of_nclause(claB1)) | #void)
                              (prove_clause(opt)(sub2)([mi1, PairList [lit, & path], PairList [i, & pi], lem, (lim - 1)])(claB1) |> Strom.map(
                                  fun([sub3, prfs]):
                                    [
                                      sub3,
                                      PairList [lit, & lem],
                                      Ncproof.Extension(PairList [Ncmatrix.Lit(neglit_2), & claB1], position, prfs)
                                    ]
                                ))
                          ))
                    | None(): Strom.nil
              ))
          (cut(Cop.Subst.ground_lit(fst(sub))(lit))(cut(opt.cut1)(lemmas_2)(cut(opt.cut2)(reductions_2)(cut(opt.cut3)(extensions_2)(Strom.nil))))(Strom.nil) |> Strom.map((fun([sub1, lem1, prf1]): [sub1, lem1, [Ncmatrix.Lit(lit), prf1]])))

  fun prove_mat(opt):
    fun(sub):
      fun([mi, path, pi, lem, lim]):
        fun([j, mat1]):
          (if copverb.value | hol_printf("prove_mat\n%!") | #void)
          (Strom.of_list(mat1) |> Strom.concat_map(
              fun([[i, _] as idx, cla1]):
                (if copverb.value | hol_printf("Decomposition chose: %s\n%!")(Ncprint.string_of_nclause(cla1)) | #void)
                (prove_clause(opt)(sub)([mi, path, PairList [i, j, & pi], lem, lim])(cla1) |> Strom.map(
                    (fun([sub1, prf1]): [sub1, lem, [Ncmatrix.Mat([j, mat1]), Ncproof.Decomposition(cla1, idx, prf1)]])
                  ))
            ))

  fun prove_litmat(opt): fun(sub): fun(st): Ncmatrix.map_litmat(prove_lit(opt)(sub)(st))(prove_mat(opt)(sub)(st))

  fun prove_clause(opt):
    fun(sub):
      fun([mi, path, pi, lem, lim]):
        fun
        | (PairList [lm, & cla]):
            let check_2 = Utils.List.exists((fun(x): Utils.List.exists(Cop.Subst.eq(sub)(x))(path)))
            let regularity:
              if opt.improved_regularity
              | check_2(Ncmatrix.clause_lits(PairList [lm, & cla]))
              | match lm
                | Ncmatrix.Mat(_): #false
                | Ncmatrix.Lit(l): check_2(PairList [l, & Ncmatrix.clause_lits(cla)])
            if regularity
            | (if copverb.value | hol_printf("regularity\n%!") | #void)
              Strom.nil
            | (prove_litmat(opt)(sub)([mi, path, pi, lem, lim])(lm) |> Strom.concat_map(
                  (fun([sub1, lem1, prf1]): (prove_clause(opt)(sub1)([mi, path, pi, lem1, lim])(cla) |> Strom.map((fun([sub2, prf2]): [sub2, PairList [prf1, & prf2]]))))
                ))
        | (PairList []):
            (if copverb.value | hol_printf("axiom\n%!") | #void)
            Strom.cons([sub, PairList []])(Strom.nil)

namespace Ncrecon:
  export:
    DISJ_CASES_LIST
    CONTRADICTION
    flip_neg
    nth_disj
    nth_conj
    inst_var
    spec_vars
    ReconData
    clause_index_mapping
    matrix_index_mapping
    mk_recon_data
    prefix_problem
    eat_proofs
    bot_of_clause_ext
    bot_of_litmat_ext
    bot_of_proof

  fun DISJ_CASES_LIST(th):
    fun(prfs):
      (if (Utils.List.length(prfs) == Utils.List.length(disjuncts(concl(th)))) | #void | failwith("Assertion failed"))
      (if Utils.List.for_all2(Utils.List.mem)(disjuncts(concl(th)))(Utils.List.map(hyp)(prfs)) | #void | failwith("Assertion failed"))
      let c = concl(Utils.List.hd(prfs))
      (if Utils.List.fold_left(fun(acc): fun(x): (acc && (concl(x) == c)))(#true)(prfs) | #void | failwith("Assertion failed"))
      match prfs
      | PairList []: failwith("DISJ_CASES_LIST")
      | PairList [p, & PairList []]: MP(DISCH(concl(th))(p))(th)
      | PairList [p1, & PairList [p2, & PairList []]]: DISJ_CASES(th)(p1)(p2)
      | PairList [p, & ps]: DISJ_CASES(th)(p)(DISJ_CASES_LIST(ASSUME(snd(dest_disj(concl(th)))))(ps))

  def initialization_1:
    if (
      ((DISJ_CASES_LIST(ASSUME(@hol|{a \/ b \/ c}|))(
            PairList [
              (TAUT(@hol|{a ==> c \/ b \/ a}|) |> UNDISCH),
              (TAUT(@hol|{b ==> c \/ b \/ a}|) |> UNDISCH),
              (TAUT(@hol|{c ==> c \/ b \/ a}|) |> UNDISCH)
            ]
          ) |> concl) == @hol|{c \/ b \/ a}|)
    )
    | #void
    | failwith("Assertion failed")

  fun CONTRADICTION(x):
    fun(y):
      let [xc, yc] = [concl(x), concl(y)]
      (if copverb.value | hol_printf("contra: %s with %s\n%!")(Host.string_of_term(xc))(Host.string_of_term(yc)) | #void)
      if (is_neg(xc) && !is_neg(yc))
      | MP(NOT_ELIM(x))(y)
      | (if (is_neg(yc) && !is_neg(xc)) | MP(NOT_ELIM(y))(x) | failwith("no contradiction found"))

  def initialization_2:
    if (
      (concl(
          CONTRADICTION(ASSUME(@hol|{~p}|))(ASSUME(@hol|{p:bool}|))
        ) == @hol|{F}|)
    )
    | #void
    | failwith("Assertion failed")

  def initialization_3:
    if (
      (concl(
          CONTRADICTION(ASSUME(@hol|{p:bool}|))(ASSUME(@hol|{~p}|))
        ) == @hol|{F}|)
    )
    | #void
    | failwith("Assertion failed")

  fun flip_neg(tm): (if is_neg(tm) | dest_neg(tm) | mk_neg(tm))

  fun nth_disj(j):
    fun(th):
      (if copverb.value | hol_printf("nth_disj %d %s\n%!")(j)(Host.string_of_term(concl(th))) | #void)
      (((concl(th) |> disjuncts) |> Utils.List.map(ASSUME)) |> Utils.List.nth_rest(j))

  fun nth_conj(i):
    fun(th):
      (if copverb.value | hol_printf("nth_conj %d %s\n%!")(i)(Host.string_of_term(concl(th))) | #void)
      Utils.List.nth(CONJUNCTS(th))(i)

  fun inst_var(sub):
    fun(ty):
      fun(v):
        let ftm = Substarray.inst_tm(sub)(Fvar(v))
        try:
          Mapping.hol_of_term(ty)(ftm)
          ~catch exn:
            match exn
            | Failure(e): failwith(("inst_var: " +& e))
            | exn: (throw exn)

  fun spec_vars(sub):
    fun(vs):
      fun(th):
        (if copverb.value | hol_printf("spec_vars: |vars| = %d, th = %s\n%!")(Utils.List.length(vs))(Host.string_of_term(concl(th))) | #void)
        let tys = (((concl(th) |> strip_forall) |> fst) |> Utils.List.map(type_of))
        (if (Utils.List.length(tys) == Utils.List.length(vs)) | #void | failwith("Assertion failed"))
        Utils.List.fold_left2(fun(th): fun(ty): fun(v): SPEC(inst_var(sub)(ty)(v))(th))(th)(tys)(vs)

  record ReconData(problem, mapping, sub)

  fun clause_index_mapping(cl):
    ((cl |> Utils.List.mapi(
          fun(idx):
            fun
            | (Ncmatrix.Lit(_)): PairList []
            | (Ncmatrix.Mat([j, mat])): PairList [[j, idx], & matrix_index_mapping(mat)]
        )) |> Utils.List.concat)

  fun matrix_index_mapping(mat):
    ((mat |> Utils.List.mapi(fun(idx): fun([[i, v], cl]): PairList [[i, idx], & clause_index_mapping(cl)])) |> Utils.List.concat)

  fun mk_recon_data([problem, mat, sub]): ReconData(problem, matrix_index_mapping(mat), sub)

  fun prefix_problem(data):
    let rel = (fun(i): Utils.List.assoc(i)(data.mapping))
    Utils.List.fold_left(
      fun(th):
        fun([[i, v], j]):
          ((((th |> nth_conj(rel(i))) |> spec_vars(data.sub)(v)) |> nth_disj(rel(j))) |> fst)
    )(data.problem)

  fun eat_proofs(data):
    Utils.List.fold_map(
      fun([lem, prfs]):
        fun(th):
          match prfs
          | PairList [prf, & prfs]:
              let bot = bot_of_proof(data)(lem)(th)(prf)
              [[PairList [[concl(th), bot], & lem], prfs], bot]
          | PairList []: failwith("eat_proofs")
    )

  fun bot_of_clause_ext(data):
    fun([[i, v], [matL, matR], lmext]):
      fun(acc):
        fun(th):
          let i_prime = Utils.List.assoc(i)(data.mapping)
          (if (i_prime == Utils.List.length(matL)) | #void | failwith("Assertion failed"))
          (if (Utils.List.length(CONJUNCTS(th)) == (1 + Utils.List.length(append(matL)(matR)))) | #void | failwith("Assertion failed"))
          bot_of_litmat_ext(data)(acc)((nth_conj(i_prime)(th) |> spec_vars(data.sub)(v)))(lmext)

  fun bot_of_litmat_ext(data):
    fun(acc):
      fun(thi):
        fun
        | (Extclause.Litext([claL, claR],claC)):
            let j = Utils.List.length(claL)
            let [thj, [thL, thR]] = nth_disj(j)(thi)
            let [acc1, botsL] = eat_proofs(data)(acc)(thL)
            let [acc2, botsR] = eat_proofs(data)(acc1)(thR)
            (if copverb.value | hol_printf("bot_of_litmat_ext: thi = %s\n%!")(Host.string_of_thm(thi)) | #void)
            let tmj = concl(thj)
            (if !(is_conj(tmj) || is_disj(tmj)) | #void | failwith("Assertion failed"))
            let botj = CONTRADICTION(thj)(((concl(thj) |> flip_neg) |> ASSUME))
            [acc2, DISJ_CASES_LIST(thi)(append(botsL)(PairList [botj, & botsR]))]
        | (Extclause.Matext(j,[claL, claR],clext)):
            let j_prime = Utils.List.assoc(j)(data.mapping)
            (if (j_prime == Utils.List.length(claL)) | #void | failwith("Assertion failed"))
            let [thj, [thL, thR]] = nth_disj(j_prime)(thi)
            let [acc1, botj] = bot_of_clause_ext(data)(clext)(acc)(thj)
            let [acc2, botsL] = eat_proofs(data)(acc1)(thL)
            let [acc3, botsR] = eat_proofs(data)(acc2)(thR)
            [acc3, DISJ_CASES_LIST(thi)(append(botsL)(PairList [botj, & botsR]))]

  fun bot_of_proof(data):
    fun(lem):
      fun(th):
        fun
        | ([Ncmatrix.Mat([j, mat]), Ncproof.Decomposition(cla,[[i, k], v],prfs)]):
            let i_prime = Utils.List.assoc(i)(data.mapping)
            (if (i_prime < Utils.List.length(mat)) | #void | failwith("Assertion failed"))
            (if (snd(Utils.List.nth(mat)(i_prime)) == cla) | #void | failwith("Assertion failed"))
            (if copverb.value | hol_printf("Decomposition %d: %s\n%!")(i_prime)(Host.string_of_term(concl(th))) | #void)
            let thi = (nth_conj(i_prime)(th) |> spec_vars(data.sub)(v))
            let djs = disjuncts(concl(thi))
            (if (Utils.List.length(djs) == Utils.List.length(prfs)) | #void | failwith("Assertion failed"))
            (((Utils.List.map(ASSUME)(djs) |> eat_proofs(data)([lem, prfs])) |> snd) |> DISJ_CASES_LIST(thi))
        | ([Ncmatrix.Lit(lit), prf]):
            let liti = Mapping.hol_of_literal(Substarray.inst_lit(data.sub)(lit))
            (if copverb.value | hol_printf("bot_of_proof: lit = %s\n%!")(Host.string_of_term(liti)) | #void)
            (if (liti == concl(th)) | #void | failwith("Assertion failed"))
            match prf
            | Ncproof.Reduction(): ((flip_neg(liti) |> ASSUME) |> CONTRADICTION(th))
            | Ncproof.Lemma():
                (if Utils.List.mem_assoc(liti)(lem) | #void | failwith("Assertion failed"))
                Utils.List.assoc(liti)(lem)
            | Ncproof.Extension(_,[prefix, postfix],prfs):
                let prefix_th = prefix_problem(data)(prefix)
                (if copverb.value | hol_printf("prefix_th = %s\n%!")(Host.string_of_thm(prefix_th)) | #void)
                let [[_, prfs_prime], bot] = bot_of_clause_ext(data)(postfix)([lem, prfs])(prefix_th)
                (if (prfs_prime == (PairList [])) | #void | failwith("Assertion failed"))
                (if Utils.List.mem(concl(th))(hyp(bot)) | #void | failwith("Assertion failed"))
                MP(DISCH(concl(th))(bot))(th)
            | _: failwith("bot_of_proof: not a well-formed proof")
        | (_): failwith("bot_of_proof: not a well-formed proof")

namespace Nanocop:
  export:
    start
    fol_of_thm
    NANOCOP_DEEPEN
    PRINT_TAC
    PRINT_ID_TAC
    PREPARE_NANOCOP_TAC
    PURE_NANOCOP
    GEN_NANOCOP_TAC
    NANOCOP_TAC
    NANOCOP

  fun start(mat):
    fun(opt):
      fun(lim):
        (if copverb.value | hol_printf("Start %d\n%!")((lim + 1)) | #void)
        let mati = Ncmatrix.copy_matrix(0)(mat)
        let sub0 = Cop.Subst.empty(1000000)
        let hashek = Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
        Utils._op3e__op3e__op3d_(
          ((Strom.of_list(mati) |> Strom.filter_map(
                fun(arg_2):
                  match arg_2
                  | [[[i, _], v] as idx, PairList [Ncmatrix.Lit(lit), & PairList []] as cla]:
                      if (lit == hashek)
                      | Utils._op3e__op3e__op3d_(
                          (Ncsearch.prove_clause(opt)([sub0, 0])([mati, PairList [], PairList [[i, 0]], PairList [], lim])(cla) |> Strom.next_opt)
                        )((fun([sub, prfs]): Some([sub, Ncproof.Decomposition(cla, idx, prfs)])))
                      | match arg_2
                        | _: None()
                  | _: None()
              )) |> Strom.next_opt)
        )((fun([sub, prf]): Some([fst(sub), [Ncmatrix.Mat([[-1, 0], mati]), prf]])))

  fun fol_of_thm(th):
    let lconsts = freesl(hyp(th))
    let tm = concl(th)
    (if Utils.List.for_all((fun(x): Utils.List.mem(x)(lconsts)))(frees(tm)) | #void | failwith("Assertion failed"))
    Mapping.fol_of_form(PairList [])(lconsts)(tm)

  fun NANOCOP_DEEPEN(opt):
    fun(ths):
      if copverb.value
      | hol_printf("NANOCOP_DEEPEN with ths:\n%!")
        Utils.List.iter(o(hol_printf("  th: %s\n%!"))(Host.string_of_thm))(ths)
      | #void
      Mapping.reset_vars(#void)
      Mapping.reset_consts(#void)
      let gen_eq = o(o(map(GEN_ALL))(Equality.create_eq_axs(opt.add_eq_symmetry)))(map(concl))
      let ths_prime = (if Utils.List.exists((fun(th): (concl(th) == Hashek.hashek_tm)))(ths) | ths | PairList [Hashek.hashek_thm, & ths])
      let ths_prime = setify(append(ths_prime)(gen_eq(ths_prime)))
      let th = end_itlist(CONJ)(ths_prime)
      let fol = fol_of_thm(th)
      let mat = Ncmatrix.index_matrix(Ncmatrix.matrix_of_form(fol))
      if copverb.value
      | hol_printf("Matrix:\n%!")
        Ncprint.print_matrix_i(mat)
      | #void
      Ncdatabase.matrix2db(mat)
      (if copverb.value | hol_printf("Matrix loaded.\n%!") | #void)
      let [sub, prfs] = Cop.strategy(opt)(start(mat))
      if copverb.value
      | hol_printf("Theorem\n%!")
        Ncproof.print_proof_def(sub)(prfs)
      | #void
      let data = Ncrecon.mk_recon_data([th, mat, sub])
      let bot = Ncrecon.bot_of_proof(data)(PairList [])(th)(prfs)
      if copverb.value
      | hol_printf("Reconstruction:\n%!")
        Host.print_thm(bot)
      | #void
      (if set_eq(hyp(bot))(hyp(th)) | #void | failwith("Assertion failed"))
      (if (concl(bot) == @hol|{F}|) | #void | failwith("Assertion failed"))
      bot

  fun PRINT_TAC(g):
    (if copverb.value | Host.print_goal(g) | #void)
    ALL_TAC(g)

  fun PRINT_ID_TAC(s):
    fun(g):
      (if copverb.value | println(s) | #void)
      PRINT_TAC(g)

  fun PREPARE_NANOCOP_TAC(ths):
    (
      (
        (
          Prepare.PREPARE_COP_TAC(ths) then_tac \
          RULE_ASSUM_TAC(CONV_RULE(DEPTH_CONV(CHANGED_CONV(ASSOC_CONV(DISJ_ASSOC)))))
        ) then_tac \
        RULE_ASSUM_TAC(CONV_RULE(DEPTH_CONV(CHANGED_CONV(ASSOC_CONV(CONJ_ASSOC)))))
      ) then_tac \
      REPEAT(FIRST_X_ASSUM(SUBST_VAR_TAC))
    )

  fun PURE_NANOCOP(opt):
    fun(gl):
      (
        FIRST_ASSUM(CONTR_TAC) or_tac \
        W(o(o(o(ACCEPT_TAC)(NANOCOP_DEEPEN(opt)))(map(snd)))(fst))
      )(gl)

  fun GEN_NANOCOP_TAC(opt): fun(ths): (PREPARE_NANOCOP_TAC(ths) then_tac PURE_NANOCOP(opt))

  fun NANOCOP_TAC(ths): GEN_NANOCOP_TAC(Cop.search_opts)(ths)

  fun NANOCOP(ths): fun(tm): prove([tm, NANOCOP_TAC(ths)])

def LEANCOP_TAC = Leancop.LEANCOP_TAC

def LEANCOP = Leancop.LEANCOP

def NANOCOP_TAC = Nanocop.NANOCOP_TAC

def NANOCOP = Nanocop.NANOCOP
