                                    | #void
                                    | failwith("Assertion failed")
                                  »);
                                  (block:«
                                    (block:«
                                      if Host.hol_equal(k1)(k1_prime)
                                      | #void
                                      | failwith("Assertion failed")
                                    »);
                                    (block:«
                                      let port_tmp_12 = Strom.map((fun([sub3, [prefix, postfix], claB1, mi3]):« [sub3, [PairList.cons([[i, v1], j],prefix), postfix], claB1, miAB([[[i, k1], v1], claDE(Ncmatrix.Mat([[j, k1], mi3]))])] »));
                                      let port_tmp_13 = thecops_Ncsearch_prove_ec(k)(sub2)(clext_prime)(mi2)(pi);
                                      Host.hol_pipe(port_tmp_13)(port_tmp_12)
                                    »)
                                  »)
                                »)
                            »
                          »)
                          | (block:«
                            match lmext
                            | _: Strom.nil
                          »)
                      »
                      | _: Strom.nil
                    »)
                  »;
                  let port_tmp_14_alt2:«
                    (fun(_):«
                      if (Firstorder.Utils.List.mem([i, k1])(pi) && Host.hol_equal(v)(PairList []))
                      | Strom.nil
                      | (block:«
                        let [claB, claC] = Extclause.claBC_of_litmat_ext(lmext);
                        (block:«
                          let port_tmp_15_index = (fun(cla):« [[[i, k], v], Ncmatrix.copy_clause(k)(cla)] »);
                          Strom.cons((block:«
                            let port_tmp_16 = miAB(port_tmp_15_index(claC));
                            let port_tmp_17 = port_tmp_15_index(claB);
                            [sub, [PairList [], clext], port_tmp_17, port_tmp_16]
                          »))(Strom.nil)
                        »)
                      »)
                    »)
                  »;
                  (block:«
                    let port_tmp_18 = Strom.cache(port_tmp_14_alt2);
                    let port_tmp_19 = Strom.cache(port_tmp_11_alt1);
                    Strom.append(port_tmp_19)(port_tmp_18)
                  »)
                »)
              »)
            »)
          »)
        »)
      »)
    »)
  »;
