        try:
          let port_tmp_11:
            if Host.hol_equal(vars)(0)
            | [[Cop.Subst.unify_tms(sub)(args1)(args2), off], clext]
            | let port_tmp_9 = Extclause.offset_clause_ext(off)(clext)
              let port_tmp_7 = Host.hol_add(off)(vars)
              let port_tmp_8 = Cop.Subst.unify_tms_off(off)(sub)(args1)(args2)
              let port_tmp_10 = [port_tmp_8, port_tmp_7]
