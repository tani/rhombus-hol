        fi(f)(i)
        Print.pp_enum(",")("{")("}")(Print.pp_print_var)(f)(v)
        Host.pp_print_char(f)(":")
        Host.hol_apply_unit(Host.pp_print_space(f))
        thecops_Ncprint_pp_print_nclause(fi)(f)(c)
        Host.hol_apply_unit(Host.pp_close_box(f))

