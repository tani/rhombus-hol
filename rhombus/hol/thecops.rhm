  fun thecops_Nanocop_start(mat):«
    (fun(opt):«
      (fun(lim):«
        (block:«
          (block:«
            if Host.ref_get(Firstorder.copverb)
            | Host.hol_printf("Start %d\n%!")(Host.hol_add(lim)(1))
            | #void
          »);
          (block:«
            let mati:«
              Ncmatrix.copy_matrix(0)(mat)
            »;
            (block:«
              let sub0:«
                Cop.Subst.empty(1000000)
              »;
              (block:«
                let hashek:«
                  Firstorder.Mapping.fol_of_literal(PairList [])(PairList [])(Hashek.hashek_tm)
                »;
                Firstorder.Utils._op3e__op3e__op3d_(Host.hol_pipe((block:«
                  let port_tmp_1 = Strom.filter_map((fun(port_tmp_2):«
                    let port_tmp_3 = port_tmp_2;
                    match port_tmp_3
                    | Pair(Pair(Pair(i,_),v) as idx,PairList [Ncmatrix.Lit(lit), & PairList []] as cla):«
                        if Host.hol_equal(lit)(hashek)
                        | Firstorder.Utils._op3e__op3e__op3d_(Host.hol_pipe(Ncsearch.prove_clause(opt)(Pair(sub0,0))(Host.HolTuple5(mati,PairList [],PairList.cons(Pair(i,0),PairList []),PairList [],lim))(cla))(Strom.next_opt))((fun(Pair(sub,prfs)):«
                          Host.Some(Pair(sub,Ncproof.Decomposition(cla,idx,prfs)))
                        »))
                        | (block:«
                          let port_tmp_4 = port_tmp_3;
                          match port_tmp_4
                          | _:«
                              Host.None()
                          »
                        »)
                    »
                    | _:«
                        Host.None()
                    »
                  »));
                  let port_tmp_5 = Strom.of_list(mati);
                  Host.hol_pipe(port_tmp_5)(port_tmp_1)
                »))(Strom.next_opt))((fun(Pair(sub,prf)):«
                  Host.Some(Pair(fst(sub),Pair(Ncmatrix.Mat(Pair(Pair(-1,0),mati)),prf)))
                »))
              »)
            »)
          »)
        »)
      »)
    »)
  »;
  fun thecops_Nanocop_fol_of_thm(th):«
    (block:«
      let lconsts:«
        Fusion.freesl(Fusion.hyp(th))
      »;
      (block:«
        let tm:«
          Fusion.concl(th)
        »;
        (block:«
          (block:«
            if Firstorder.Utils.List.for_all((fun(x):«
              Firstorder.Utils.List.mem(x)(lconsts)
            »))(Fusion.frees(tm))
            | #void
            | failwith("Assertion failed")
          »);
          Firstorder.Mapping.fol_of_form(PairList [])(lconsts)(tm)
        »)
      »)
    »)
  »;
  fun thecops_Nanocop_NANOCOP_DEEPEN(opt):«
    (fun(ths):«
      (block:«
        (block:«
          if Host.ref_get(Firstorder.copverb)
          | (block:«
            Host.hol_printf("NANOCOP_DEEPEN with ths:\n%!");
            Firstorder.Utils.List.iter(o(Host.hol_printf("  th: %s\n%!"))(Host.string_of_thm))(ths)
          »)
          | #void
        »);
        (block:«
          Host.hol_apply_unit(Firstorder.Mapping.reset_vars);
          (block:«
            Host.hol_apply_unit(Firstorder.Mapping.reset_consts);
            (block:«
              let gen_eq:«
                (block:«
                  let port_tmp_6 = map(Fusion.concl);
                  let port_tmp_7 = (block:«
                    let port_tmp_8 = Equality.create_eq_axs(opt["add_eq_symmetry"]);
                    let port_tmp_9 = map(Bool.GEN_ALL);
                    o(port_tmp_9)(port_tmp_8)
                  »);
                  o(port_tmp_7)(port_tmp_6)
                »)
              »;
              (block:«
                let ths_prime:«
                  (block:«
                    if Firstorder.Utils.List.exists((fun(th):«
                      Host.hol_equal(Fusion.concl(th))(Hashek.hashek_tm)
                    »))(ths)
                    | ths
                    | PairList.cons(Hashek.hashek_thm,ths)
                  »)
                »;
                (block:«
                  let ths_prime:«
                    Host.setify(append(ths_prime)(gen_eq(ths_prime)))
                  »;
                  (block:«
                    let th:«
                      end_itlist(Bool.CONJ)(ths_prime)
                    »;
                    (block:«
                      let fol:«
                        thecops_Nanocop_fol_of_thm(th)
                      »;
                      (block:«
                        let mat:«
                          Ncmatrix.index_matrix(Ncmatrix.matrix_of_form(fol))
                        »;
                        (block:«
                          (block:«
                            if Host.ref_get(Firstorder.copverb)
                            | (block:«
                              Host.hol_printf("Matrix:\n%!");
                              Ncprint.print_matrix_i(mat)
                            »)
                            | #void
                          »);
                          (block:«
                            Ncdatabase.matrix2db(mat);
                            (block:«
                              (block:«
                                if Host.ref_get(Firstorder.copverb)
                                | Host.hol_printf("Matrix loaded.\n%!")
                                | #void
                              »);
                              (block:«
                                let Pair(sub,prfs):«
                                  Cop.strategy(opt)(thecops_Nanocop_start(mat))
                                »;
                                (block:«
                                  (block:«
                                    if Host.ref_get(Firstorder.copverb)
                                    | (block:«
                                      Host.hol_printf("Theorem\n%!");
                                      Ncproof.print_proof_def(sub)(prfs)
                                    »)
                                    | #void
                                  »);
                                  (block:«
                                    let data:«
