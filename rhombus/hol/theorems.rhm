            Bool,
            Iff(And(Or(Ref("p"), Ref("q")), Ref("r")), Or(And(Ref("p"), Ref("r")), And(Ref("q"), Ref("r"))))
          )
        )
      )),
      ITAUT_TAC
    ]
  )

def FORALL_SIMP:
  prove(
    [
      Host.hol_term(Forall("t", Bool, Iff(Forall("x", Tvar("A"), Ref("t")), Ref("t")))),
      ITAUT_TAC
    ]
  )

def EXISTS_SIMP:
  prove(
    [
      Host.hol_term(Forall("t", Bool, Iff(Exists("x", Tvar("A"), Ref("t")), Ref("t")))),
      ITAUT_TAC
    ]
  )

def EQ_IMP:
  ITAUT(
    Host.hol_term(Implies(Iff(Var("a", Bool), Var("b", Bool)), Implies(Var("a", Bool), Var("b", Bool))))
  )

def EQ_CLAUSES:
  prove(
    [
      Host.hol_term(Forall(
        "t",
        Bool,
        And(
          Iff(Iff(True, Ref("t")), Ref("t")),
          And(
            Iff(Iff(Ref("t"), True), Ref("t")),
            And(Iff(Iff(False, Ref("t")), Not(Ref("t"))), Iff(Iff(Ref("t"), False), Not(Ref("t"))))
          )
        )
      )),
      ITAUT_TAC
    ]
  )

def NOT_CLAUSES_WEAK = prove([Host.hol_term(And(Iff(Not(True), False), Iff(Not(False), True))), ITAUT_TAC])

def AND_CLAUSES:
  prove(
    [
      Host.hol_term(Forall(
        "t",
        Bool,
        And(
          Iff(And(True, Ref("t")), Ref("t")),
          And(
            Iff(And(Ref("t"), True), Ref("t")),
            And(
              Iff(And(False, Ref("t")), False),
              And(Iff(And(Ref("t"), False), False), Iff(And(Ref("t"), Ref("t")), Ref("t")))
            )
          )
        )
      )),
      ITAUT_TAC
    ]
  )

def OR_CLAUSES:
  prove(
    [
      Host.hol_term(Forall(
        "t",
        Bool,
        And(
          Iff(Or(True, Ref("t")), True),
          And(
            Iff(Or(Ref("t"), True), True),
            And(
              Iff(Or(False, Ref("t")), Ref("t")),
              And(Iff(Or(Ref("t"), False), Ref("t")), Iff(Or(Ref("t"), Ref("t")), Ref("t")))
            )
          )
        )
      )),
      ITAUT_TAC
    ]
  )

def IMP_CLAUSES:
  prove(
    [
      Host.hol_term(Forall(
        "t",
        Bool,
        And(
          Iff(Implies(True, Ref("t")), Ref("t")),
          And(
            Iff(Implies(Ref("t"), True), True),
            And(
              Iff(Implies(False, Ref("t")), True),
              And(Iff(Implies(Ref("t"), Ref("t")), True), Iff(Implies(Ref("t"), False), Not(Ref("t"))))
            )
          )
        )
      )),
      ITAUT_TAC
    ]
  )

def initialization_1:
  let IMP_EQ_CLAUSE:
    prove(
      [
        Host.hol_term(Iff(
          Implies(Eq(Tvar("?851"), Var("x", Tvar("?851")), Var("x", Tvar("?851"))), Var("p", Bool)),
          Var("p", Bool)
        )),
        REWRITE_TAC(PairList [EQT_INTRO(SPEC_ALL(EQ_REFL)), IMP_CLAUSES])
      ]
    )
  extend_basic_rewrites(
    PairList [
      REFL_CLAUSE,
      EQ_CLAUSES,
      NOT_CLAUSES_WEAK,
      AND_CLAUSES,
      OR_CLAUSES,
      IMP_CLAUSES,
      FORALL_SIMP,
      EXISTS_SIMP,
      BETA_THM,
      IMP_EQ_CLAUSE
    ]
  )

def initialization_2:
  extend_basic_congs(
    PairList [
      ITAUT(
        Host.hol_term(Implies(
          Iff(Var("p", Bool), Var("p'", Bool)),
          Implies(
            Implies(Var("p'", Bool), Iff(Var("q", Bool), Var("q'", Bool))),
            Iff(Implies(Var("p", Bool), Var("q", Bool)), Implies(Var("p'", Bool), Var("q'", Bool)))
          )
        ))
      )
    ]
  )

def EXISTS_UNIQUE_THM:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Iff(
          ExistsUnique("x", Tvar("A"), App(Ref("P"), [Ref("x")])),
          And(
            Exists("x", Tvar("A"), App(Ref("P"), [Ref("x")])),
            Forall(
              "x",
              Tvar("A"),
              Forall(
                "x'",
                Tvar("A"),
                Implies(
                  And(App(Ref("P"), [Ref("x")]), App(Ref("P"), [Ref("x'")])),
                  Eq(Tvar("A"), Ref("x"), Ref("x'"))
                )
              )
            )
          )
        )
      )),
      (GEN_TAC then_tac REWRITE_TAC(PairList [EXISTS_UNIQUE_DEF]))
    ]
  )

def EXISTS_REFL:
  prove(
    [
      Host.hol_term(Forall("a", Tvar("A"), Exists("x", Tvar("A"), Eq(Tvar("A"), Ref("x"), Ref("a"))))),
      (
        (GEN_TAC then_tac EXISTS_TAC(Host.hol_term(Var("a", Tvar("A"))))) then_tac \
        REFL_TAC
      )
    ]
  )

def EXISTS_UNIQUE_REFL:
  prove(
    [
      Host.hol_term(Forall("a", Tvar("A"), ExistsUnique("x", Tvar("A"), Eq(Tvar("A"), Ref("x"), Ref("a"))))),
      (
        (
          (
            (GEN_TAC then_tac REWRITE_TAC(PairList [EXISTS_UNIQUE_THM])) then_tac \
            REPEAT((EQ_TAC or_tac STRIP_TAC))
          ) then_list \
          PairList [
            EXISTS_TAC(Host.hol_term(Var("a", Tvar("A")))),
            ASM_REWRITE_TAC(PairList [])
          ]
        ) then_tac \
        REFL_TAC
      )
    ]
  )

def UNWIND_THM1:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Forall(
          "a",
          Tvar("A"),
          Iff(
            Exists("x", Tvar("A"), And(Eq(Tvar("A"), Ref("a"), Ref("x")), App(Ref("P"), [Ref("x")]))),
            App(Ref("P"), [Ref("a")])
          )
        )
      )),
      (
        (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
        PairList [
          DISCH_THEN(CHOOSE_THEN(CONJUNCTS_THEN2(SUBST1_TAC)(ACCEPT_TAC))),
          (
            (
              (
                (DISCH_TAC then_tac EXISTS_TAC(Host.hol_term(Var("a", Tvar("A"))))) then_tac \
                CONJ_TAC
              ) then_tac \
              TRY(FIRST_ASSUM(MATCH_ACCEPT_TAC))
            ) then_tac \
            REFL_TAC
          )
        ]
      )
    ]
  )

def UNWIND_THM2:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Forall(
          "a",
          Tvar("A"),
          Iff(
            Exists("x", Tvar("A"), And(Eq(Tvar("A"), Ref("x"), Ref("a")), App(Ref("P"), [Ref("x")]))),
            App(Ref("P"), [Ref("a")])
          )
        )
      )),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          CONV_TAC(LAND_CONV(ONCE_DEPTH_CONV(SYM_CONV)))
        ) then_tac \
        MATCH_ACCEPT_TAC(UNWIND_THM1)
      )
    ]
  )

def FORALL_UNWIND_THM2:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Forall(
          "a",
          Tvar("A"),
          Iff(
            Forall("x", Tvar("A"), Implies(Eq(Tvar("A"), Ref("x"), Ref("a")), App(Ref("P"), [Ref("x")]))),
            App(Ref("P"), [Ref("a")])
          )
        )
      )),
      (
        (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
        PairList [
          (
            DISCH_THEN(o(MP_TAC)(SPEC(Host.hol_term(Var("a", Tvar("A")))))) then_tac \
            REWRITE_TAC(PairList [])
          ),
          (
            ((DISCH_TAC then_tac GEN_TAC) then_tac DISCH_THEN(SUBST1_TAC)) then_tac \
            ASM_REWRITE_TAC(PairList [])
          )
        ]
      )
    ]
  )

def FORALL_UNWIND_THM1:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Forall(
          "a",
          Tvar("A"),
          Iff(
            Forall("x", Tvar("A"), Implies(Eq(Tvar("A"), Ref("a"), Ref("x")), App(Ref("P"), [Ref("x")]))),
            App(Ref("P"), [Ref("a")])
          )
        )
      )),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          CONV_TAC(LAND_CONV(ONCE_DEPTH_CONV(SYM_CONV)))
        ) then_tac \
        MATCH_ACCEPT_TAC(FORALL_UNWIND_THM2)
      )
    ]
  )

def SWAP_FORALL_THM:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
        Iff(
          Forall("x", Tvar("A"), Forall("y", Tvar("B"), App(Ref("P"), [Ref("x"), Ref("y")]))),
          Forall("y", Tvar("B"), Forall("x", Tvar("A"), App(Ref("P"), [Ref("x"), Ref("y")])))
        )
      )),
      ITAUT_TAC
    ]
  )

def SWAP_EXISTS_THM:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
        Iff(
          Exists("x", Tvar("A"), Exists("y", Tvar("B"), App(Ref("P"), [Ref("x"), Ref("y")]))),
          Exists("y", Tvar("B"), Exists("x", Tvar("A"), App(Ref("P"), [Ref("x"), Ref("y")])))
        )
      )),
      ITAUT_TAC
    ]
  )

def FORALL_AND_THM:
  prove(
    [
      Host.hol_term(Forall(
        "P",
        Fun(Tvar("A"), Bool),
        Forall(
          "Q",
          Fun(Tvar("A"), Bool),
          Iff(
            Forall("x", Tvar("A"), And(App(Ref("P"), [Ref("x")]), App(Ref("Q"), [Ref("x")]))),
            And(
              Forall("x", Tvar("A"), App(Ref("P"), [Ref("x")])),
              Forall("x", Tvar("A"), App(Ref("Q"), [Ref("x")]))
            )
          )
        )
      )),
      ITAUT_TAC
    ]
