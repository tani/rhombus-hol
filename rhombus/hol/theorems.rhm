def theorems_EQ_REFL:«
  Up_tactics.prove((block:«
    let port_tmp_1 = Up_tactics.THEN(Up_tactics.GEN_TAC)(Up_tactics.REFL_TAC);
    let port_tmp_2 = Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]]]");
    Pair(port_tmp_2,port_tmp_1)
  »))
»

def theorems_REFL_CLAUSE:«
  Up_tactics.prove((block:«
    let port_tmp_3 = (block:«
      let port_tmp_4 = Up_tactics.MATCH_ACCEPT_TAC(Up_bool.EQT_INTRO(Up_bool.SPEC_ALL(theorems_EQ_REFL)));
      let port_tmp_5 = Up_tactics.GEN_TAC;
      let port_tmp_6 = Up_tactics.THEN;
      port_tmp_6(port_tmp_5)(port_tmp_4)
    »);
    let port_tmp_7 = Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]],[\"Const\",\"T\",[\"Tyapp\",\"bool\",[]]]]]]");
    Pair(port_tmp_7,port_tmp_3)
  »))
»

