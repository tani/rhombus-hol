def theorems_EQ_TRANS:«
  Up_tactics.prove((block:«
    let port_tmp_21 = (block:«
      let port_tmp_22 = Up_tactics.REFL_TAC;
      let port_tmp_23 = (block:«
        let port_tmp_24 = Up_simp.PURE_ASM_REWRITE_TAC(PairList []);
        let port_tmp_25 = Up_tactics.REPEAT(Up_tactics.STRIP_TAC);
        let port_tmp_26 = Up_tactics.THEN;
        port_tmp_26(port_tmp_25)(port_tmp_24)
      »);
      let port_tmp_27 = Up_tactics.THEN;
      port_tmp_27(port_tmp_23)(port_tmp_22)
    »);
    let port_tmp_28 = Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"y\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"z\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]],[\"Var\",\"z\",[\"Tyvar\",\"A\"]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"z\",[\"Tyvar\",\"A\"]]]]]]]]]]");
    Pair(port_tmp_28,port_tmp_21)
  »))
»

fun theorems_AC(acsuite):«
  (block:«
    let port_tmp_29 = Up_simp.PURE_REWRITE_CONV(PairList.cons(acsuite,PairList.cons(theorems_REFL_CLAUSE,PairList [])));
    let port_tmp_30 = Up_bool.EQT_ELIM;
    let port_tmp_31 = o;
    port_tmp_31(port_tmp_30)(port_tmp_29)
  »)
»

