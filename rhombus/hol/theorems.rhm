»

def theorems_EQ_SYM:«
  Up_tactics.prove(Pair(Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"y\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]]]]]]"),(block:«
    let port_tmp_1 = Up_tactics.DISCH_THEN(o(Up_tactics.ACCEPT_TAC)(Up_equal.SYM));
    let port_tmp_2 = Up_tactics.REPEAT(Up_tactics.GEN_TAC);
    Up_tactics.THEN(port_tmp_2)(port_tmp_1)
  »)))
»

def theorems_EQ_SYM_EQ:«
  Up_tactics.prove(Pair(Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"y\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]]]]]]]"),(block:«
    let port_tmp_3 = Up_tactics.MATCH_ACCEPT_TAC(theorems_EQ_SYM);
    let port_tmp_4 = Up_tactics.THEN(Up_tactics.REPEAT(Up_tactics.GEN_TAC))(Up_tactics.EQ_TAC);
    Up_tactics.THEN(port_tmp_4)(port_tmp_3)
  »)))
»

def theorems_EQ_TRANS:«
  Up_tactics.prove(Pair(Host.expand_quote("[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"x\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"y\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Const\",\"!\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]],[\"Tyapp\",\"bool\",[]]]]],[\"Abs\",[\"Var\",\"z\",[\"Tyvar\",\"A\"]],[\"Comb\",[\"Comb\",[\"Const\",\"==>\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"/\\\\\",[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"fun\",[[\"Tyapp\",\"bool\",[]],[\"Tyapp\",\"bool\",[]]]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"y\",[\"Tyvar\",\"A\"]]],[\"Var\",\"z\",[\"Tyvar\",\"A\"]]]]],[\"Comb\",[\"Comb\",[\"Const\",\"=\",[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"fun\",[[\"Tyvar\",\"A\"],[\"Tyapp\",\"bool\",[]]]]]]],[\"Var\",\"x\",[\"Tyvar\",\"A\"]]],[\"Var\",\"z\",[\"Tyvar\",\"A\"]]]]]]]]]]"),Up_tactics.THEN((block:«
    let port_tmp_5 = Up_simp.PURE_ASM_REWRITE_TAC(PairList []);
    let port_tmp_6 = Up_tactics.REPEAT(Up_tactics.STRIP_TAC);
    Up_tactics.THEN(port_tmp_6)(port_tmp_5)
  »))(Up_tactics.REFL_TAC)))
»

fun theorems_AC(acsuite):«
  o(Up_bool.EQT_ELIM)(Up_simp.PURE_REWRITE_CONV(PairList.cons(acsuite,PairList.cons(theorems_REFL_CLAUSE,PairList []))))
»

