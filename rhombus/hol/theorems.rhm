def EQ_REFL:
  prove(
    [
      (hol:
         forall x :: A: x == x),
      (GEN_TAC then_tac REFL_TAC)
    ]
  )

def REFL_CLAUSE:
  prove(
    [
      (hol:
         forall x :: A: x == x <=> #true),
      (GEN_TAC then_tac MATCH_ACCEPT_TAC(EQT_INTRO(SPEC_ALL(EQ_REFL))))
    ]
  )

def EQ_SYM:
  prove(
    [
      (hol:
         forall (x :: A, y :: A): x == y ==> y == x),
      (REPEAT(GEN_TAC) then_tac DISCH_THEN(o(ACCEPT_TAC)(SYM)))
    ]
  )

def EQ_SYM_EQ:
  prove(
    [
      (hol:
         forall (x :: A, y :: A): x == y <=> y == x),
      (
        (REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac \
        MATCH_ACCEPT_TAC(EQ_SYM)
      )
    ]
  )

def EQ_TRANS:
  prove(
    [
      (hol:
         forall (x :: A, y :: A, z :: A): x == y && y == z ==> x == z),
      (
        (REPEAT(STRIP_TAC) then_tac PURE_ASM_REWRITE_TAC(PairList [])) then_tac \
        REFL_TAC
      )
    ]
  )

fun AC(acsuite): o(EQT_ELIM)(PURE_REWRITE_CONV(PairList [acsuite, REFL_CLAUSE]))

def BETA_THM:
  prove(
    [
      (hol:
         forall (f :: A -> B, y :: A): (fun (x :: A): f(x))(y) == f(y)),
      ((REPEAT(GEN_TAC) then_tac BETA_TAC) then_tac REFL_TAC)
    ]
  )

def ABS_SIMP:
  prove(
    [
      (hol:
         forall (t1 :: A, t2 :: B): (fun (x :: B): t1)(t2) == t1),
      (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [BETA_THM, REFL_CLAUSE]))
    ]
  )

def CONJ_ASSOC:
  prove(
    [
      (hol:
         forall (t1 :: bool, t2 :: bool, t3 :: bool): t1 && (t2 && t3) <=> t1 && t2 && t3),
      ITAUT_TAC
    ]
  )

def CONJ_SYM:
  prove(
    [
      (hol:
         forall (t1 :: bool, t2 :: bool): t1 && t2 <=> t2 && t1),
      ITAUT_TAC
    ]
  )

def CONJ_ACI:
  prove(
    [
      (hol:
         var p :: bool
         var q :: bool
         var r :: bool
         (p && q <=> q && p)
           && ((p && q && r <=> p && (q && r))
                 && ((p && (q && r) <=> q && (p && r)) && ((p && p <=> p) && (p && (p && q) <=> p && q))))),
      ITAUT_TAC
    ]
  )

def DISJ_ASSOC:
  prove(
    [
      (hol:
         forall (t1 :: bool, t2 :: bool, t3 :: bool): t1 || (t2 || t3) <=> t1 || t2 || t3),
      ITAUT_TAC
    ]
  )

def DISJ_SYM:
  prove(
    [
      (hol:
         forall (t1 :: bool, t2 :: bool): t1 || t2 <=> t2 || t1),
      ITAUT_TAC
    ]
  )

def DISJ_ACI:
  prove(
    [
      (hol:
         var p :: bool
         var q :: bool
         var r :: bool
         (p || q <=> q || p)
           && ((p || q || r <=> p || (q || r))
                 && ((p || (q || r) <=> q || (p || r)) && ((p || p <=> p) && (p || (p || q) <=> p || q))))),
      ITAUT_TAC
    ]
  )

def IMP_CONJ:
  prove(
    [
      (hol:
         var p :: bool
         var q :: bool
         var r :: bool
         p && q ==> r <=> p ==> q ==> r),
      ITAUT_TAC
    ]
  )

def IMP_IMP = GSYM(IMP_CONJ)

def IMP_CONJ_ALT:
  prove(
    [
      (hol:
         var p :: bool
         var q :: bool
         var r :: bool
         p && q ==> r <=> q ==> p ==> r),
      ITAUT_TAC
    ]
  )

def LEFT_OR_DISTRIB:
  prove(
    [
      (hol:
         forall (p :: bool, q :: bool, r :: bool): p && (q || r) <=> p && q || p && r),
      ITAUT_TAC
    ]
  )

def RIGHT_OR_DISTRIB:
  prove(
    [
      (hol:
         forall (p :: bool, q :: bool, r :: bool): (p || q) && r <=> p && r || q && r),
      ITAUT_TAC
    ]
  )

def FORALL_SIMP:
  prove(
    [
      (hol:
         forall t :: bool: (forall x :: A: t) <=> t),
      ITAUT_TAC
    ]
  )

def EXISTS_SIMP:
  prove(
    [
      (hol:
         forall t :: bool: (exists x :: A: t) <=> t),
      ITAUT_TAC
    ]
  )

def EQ_IMP:
  ITAUT(
    (hol:
       var a :: bool
       var b :: bool
       (a <=> b) ==> a ==> b)
  )

def EQ_CLAUSES:
  prove(
    [
      (hol:
         forall t :: bool:
           ((#true <=> t) <=> t)
             && (((t <=> #true) <=> t) && (((#false <=> t) <=> !t) && ((t <=> #false) <=> !t)))),
      ITAUT_TAC
    ]
  )

def NOT_CLAUSES_WEAK = prove([(hol:
                                 (!#true <=> #false) && (!#false <=> #true)), ITAUT_TAC])

def AND_CLAUSES:
  prove(
    [
      (hol:
         forall t :: bool:
           (#true && t <=> t)
             && ((t && #true <=> t)
                   && ((#false && t <=> #false) && ((t && #false <=> #false) && (t && t <=> t))))),
      ITAUT_TAC
    ]
  )

def OR_CLAUSES:
  prove(
    [
      (hol:
         forall t :: bool:
           (#true || t <=> #true)
             && ((t || #true <=> #true)
                   && ((#false || t <=> t) && ((t || #false <=> t) && (t || t <=> t))))),
      ITAUT_TAC
    ]
  )

def IMP_CLAUSES:
  prove(
    [
      (hol:
         forall t :: bool:
           (#true ==> t <=> t)
             && ((t ==> #true <=> #true)
                   && ((#false ==> t <=> #true) && ((t ==> t <=> #true) && (t ==> #false <=> !t))))),
      ITAUT_TAC
    ]
  )

def initialization_1:
  let IMP_EQ_CLAUSE:
    prove(
      [
        (hol:
           var x :: #{?851}
           var p :: bool
           x == x ==> p <=> p),
        REWRITE_TAC(PairList [EQT_INTRO(SPEC_ALL(EQ_REFL)), IMP_CLAUSES])
      ]
    )
  extend_basic_rewrites(
    PairList [
      REFL_CLAUSE,
      EQ_CLAUSES,
      NOT_CLAUSES_WEAK,
      AND_CLAUSES,
      OR_CLAUSES,
      IMP_CLAUSES,
      FORALL_SIMP,
      EXISTS_SIMP,
      BETA_THM,
      IMP_EQ_CLAUSE
    ]
  )

def initialization_2:
  extend_basic_congs(
    PairList [
      ITAUT(
        (hol:
           var p :: bool
           var #{|p'|} :: bool
           var q :: bool
           var #{|q'|} :: bool
           (p <=> var.#{|p'|}) ==> (var.#{|p'|} ==> (q <=> var.#{|q'|})) ==> (p ==> q <=> var.#{|p'|} ==> var.#{|q'|}))
      )
    ]
  )

def EXISTS_UNIQUE_THM:
  prove(
    [
      (hol:
         forall P :: A -> bool:
           (exists1 x :: A: P(x))
             <=> ((exists x :: A: P(x))
                    && (forall (x :: A, x_prime :: A): P(x) && P(x_prime) ==> x == x_prime))),
      (GEN_TAC then_tac REWRITE_TAC(PairList [EXISTS_UNIQUE_DEF]))
    ]
  )

def EXISTS_REFL:
  prove(
    [
      (hol:
         forall a :: A: exists x :: A: x == a),
      (
        (GEN_TAC then_tac EXISTS_TAC(hol: var a :: A; a)) then_tac \
        REFL_TAC
      )
    ]
  )

def EXISTS_UNIQUE_REFL:
  prove(
    [
      (hol:
         forall a :: A: exists1 x :: A: x == a),
      (
        (
          (
            (GEN_TAC then_tac REWRITE_TAC(PairList [EXISTS_UNIQUE_THM])) then_tac \
            REPEAT((EQ_TAC or_tac STRIP_TAC))
          ) then_list \
          PairList [
            EXISTS_TAC(hol: var a :: A; a),
            ASM_REWRITE_TAC(PairList [])
          ]
        ) then_tac \
        REFL_TAC
      )
    ]
  )

def UNWIND_THM1:
  prove(
    [
      (hol:
         forall (P :: A -> bool, a :: A): (exists x :: A: a == x && P(x)) <=> P(a)),
      (
        (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
        PairList [
          DISCH_THEN(CHOOSE_THEN(CONJUNCTS_THEN2(SUBST1_TAC)(ACCEPT_TAC))),
          (
            (
              (
                (DISCH_TAC then_tac EXISTS_TAC(hol: var a :: A; a)) then_tac \
                CONJ_TAC
              ) then_tac \
              TRY(FIRST_ASSUM(MATCH_ACCEPT_TAC))
            ) then_tac \
            REFL_TAC
          )
        ]
      )
    ]
  )

def UNWIND_THM2:
  prove(
    [
      (hol:
         forall (P :: A -> bool, a :: A): (exists x :: A: x == a && P(x)) <=> P(a)),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          CONV_TAC(LAND_CONV(ONCE_DEPTH_CONV(SYM_CONV)))
        ) then_tac \
        MATCH_ACCEPT_TAC(UNWIND_THM1)
      )
    ]
  )

def FORALL_UNWIND_THM2:
  prove(
    [
      (hol:
         forall (P :: A -> bool, a :: A): (forall x :: A: x == a ==> P(x)) <=> P(a)),
      (
        (REPEAT(GEN_TAC) then_tac EQ_TAC) then_list \
        PairList [
          (
            DISCH_THEN(o(MP_TAC)(SPEC(hol: var a :: A; a))) then_tac \
            REWRITE_TAC(PairList [])
          ),
          (
            ((DISCH_TAC then_tac GEN_TAC) then_tac DISCH_THEN(SUBST1_TAC)) then_tac \
            ASM_REWRITE_TAC(PairList [])
          )
        ]
      )
    ]
  )

def FORALL_UNWIND_THM1:
  prove(
    [
      (hol:
         forall (P :: A -> bool, a :: A): (forall x :: A: a == x ==> P(x)) <=> P(a)),
      (
        (
          REPEAT(GEN_TAC) then_tac \
          CONV_TAC(LAND_CONV(ONCE_DEPTH_CONV(SYM_CONV)))
        ) then_tac \
        MATCH_ACCEPT_TAC(FORALL_UNWIND_THM2)
      )
    ]
  )

def SWAP_FORALL_THM:
  prove(
    [
      (hol:
         forall P :: A -> B -> bool:
           (forall (x :: A, y :: B): P(x, y)) <=> (forall (y :: B, x :: A): P(x, y))),
      ITAUT_TAC
    ]
  )

def SWAP_EXISTS_THM:
  prove(
    [
      (hol:
         forall P :: A -> B -> bool:
           (exists (x :: A, y :: B): P(x, y)) <=> (exists (y :: B, x :: A): P(x, y))),
      ITAUT_TAC
    ]
  )

def FORALL_AND_THM:
  prove(
    [
      (hol:
         forall (P :: A -> bool, Q :: A -> bool):
           (forall x :: A: P(x) && Q(x)) <=> (forall x :: A: P(x)) && (forall x :: A: Q(x))),
      ITAUT_TAC
    ]
  )

def AND_FORALL_THM:
  prove(
    [
      (hol:
         forall (P :: A -> bool, Q :: A -> bool):
           (forall x :: A: P(x)) && (forall x :: A: Q(x)) <=> (forall x :: A: P(x) && Q(x))),
      ITAUT_TAC
    ]
  )

def LEFT_AND_FORALL_THM:
  prove(
    [
      (hol:
         forall (P :: A -> bool, Q :: bool): (forall x :: A: P(x)) && Q <=> (forall x :: A: P(x) && Q)),
      ITAUT_TAC
    ]
  )

def RIGHT_AND_FORALL_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: A -> bool): P && (forall x :: A: Q(x)) <=> (forall x :: A: P && Q(x))),
      ITAUT_TAC
    ]
  )

def EXISTS_OR_THM:
  prove(
    [
      (hol:
         forall (P :: A -> bool, Q :: A -> bool):
           (exists x :: A: P(x) || Q(x)) <=> (exists x :: A: P(x)) || (exists x :: A: Q(x))),
      ITAUT_TAC
    ]
  )

def OR_EXISTS_THM:
  prove(
    [
      (hol:
         forall (P :: A -> bool, Q :: A -> bool):
           (exists x :: A: P(x)) || (exists x :: A: Q(x)) <=> (exists x :: A: P(x) || Q(x))),
      ITAUT_TAC
    ]
  )

def LEFT_OR_EXISTS_THM:
  prove(
    [
      (hol:
         forall (P :: A -> bool, Q :: bool): (exists x :: A: P(x)) || Q <=> (exists x :: A: P(x) || Q)),
      ITAUT_TAC
    ]
  )

def RIGHT_OR_EXISTS_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: A -> bool): P || (exists x :: A: Q(x)) <=> (exists x :: A: P || Q(x))),
      ITAUT_TAC
    ]
  )

def LEFT_EXISTS_AND_THM:
  prove(
    [
      (hol:
         forall (P :: A -> bool, Q :: bool): (exists x :: A: P(x) && Q) <=> (exists x :: A: P(x)) && Q),
      ITAUT_TAC
    ]
  )

def RIGHT_EXISTS_AND_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: A -> bool): (exists x :: A: P && Q(x)) <=> P && (exists x :: A: Q(x))),
      ITAUT_TAC
    ]
  )

def TRIV_EXISTS_AND_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: bool):
           (exists x :: A: P && Q) <=> (exists x :: A: P) && (exists x :: A: Q)),
      ITAUT_TAC
    ]
  )

def LEFT_AND_EXISTS_THM:
  prove(
    [
      (hol:
         forall (P :: A -> bool, Q :: bool): (exists x :: A: P(x)) && Q <=> (exists x :: A: P(x) && Q)),
      ITAUT_TAC
    ]
  )

def RIGHT_AND_EXISTS_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: A -> bool): P && (exists x :: A: Q(x)) <=> (exists x :: A: P && Q(x))),
      ITAUT_TAC
    ]
  )

def TRIV_AND_EXISTS_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: bool):
           (exists x :: A: P) && (exists x :: A: Q) <=> (exists x :: A: P && Q)),
      ITAUT_TAC
    ]
  )

def TRIV_FORALL_OR_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: bool):
           (forall x :: A: P || Q) <=> (forall x :: A: P) || (forall x :: A: Q)),
      ITAUT_TAC
    ]
  )

def TRIV_OR_FORALL_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: bool):
           (forall x :: A: P) || (forall x :: A: Q) <=> (forall x :: A: P || Q)),
      ITAUT_TAC
    ]
  )

def RIGHT_IMP_FORALL_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: A -> bool):
           P ==> (forall x :: A: Q(x)) <=> (forall x :: A: P ==> Q(x))),
      ITAUT_TAC
    ]
  )

def RIGHT_FORALL_IMP_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: A -> bool):
           (forall x :: A: P ==> Q(x)) <=> P ==> (forall x :: A: Q(x))),
      ITAUT_TAC
    ]
  )

def LEFT_IMP_EXISTS_THM:
  prove(
    [
      (hol:
         forall (P :: A -> bool, Q :: bool):
           (exists x :: A: P(x)) ==> Q <=> (forall x :: A: P(x) ==> Q)),
      ITAUT_TAC
    ]
  )

def LEFT_FORALL_IMP_THM:
  prove(
    [
      (hol:
         forall (P :: A -> bool, Q :: bool):
           (forall x :: A: P(x) ==> Q) <=> (exists x :: A: P(x)) ==> Q),
      ITAUT_TAC
    ]
  )

def TRIV_FORALL_IMP_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: bool):
           (forall x :: A: P ==> Q) <=> (exists x :: A: P) ==> (forall x :: A: Q)),
      ITAUT_TAC
    ]
  )

def TRIV_EXISTS_IMP_THM:
  prove(
    [
      (hol:
         forall (P :: bool, Q :: bool):
           (exists x :: A: P ==> Q) <=> (forall x :: A: P) ==> (exists x :: A: Q)),
      ITAUT_TAC
    ]
  )

def MONO_AND:
  ITAUT(
    (hol:
       var A :: bool
       var B :: bool
       var C :: bool
       var D :: bool
       (A ==> B) && (C ==> D) ==> A && C ==> B && D)
  )

def MONO_OR:
  ITAUT(
    (hol:
       var A :: bool
       var B :: bool
       var C :: bool
       var D :: bool
       (A ==> B) && (C ==> D) ==> A || C ==> B || D)
  )

def MONO_IMP:
  ITAUT(
    (hol:
       var B :: bool
       var A :: bool
       var C :: bool
       var D :: bool
       (B ==> A) && (C ==> D) ==> (A ==> C) ==> B ==> D)
  )

def MONO_NOT:
  ITAUT(
    (hol:
       var B :: bool
       var A :: bool
       (B ==> A) ==> !A ==> !B)
  )

def MONO_FORALL:
  prove(
    [
      (hol:
         var P :: A -> bool
         var Q :: A -> bool
         (forall x :: A: P(x) ==> Q(x)) ==> (forall x :: A: P(x)) ==> (forall x :: A: Q(x))),
      (
        (REPEAT(STRIP_TAC) then_tac FIRST_ASSUM(MATCH_MP_TAC)) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def MONO_EXISTS:
  prove(
    [
      (hol:
         var P :: A -> bool
         var Q :: A -> bool
         (forall x :: A: P(x) ==> Q(x)) ==> (exists x :: A: P(x)) ==> (exists x :: A: Q(x))),
      (
        (
          (
            (
              DISCH_TAC then_tac \
              DISCH_THEN(X_CHOOSE_TAC(hol: var x :: A; x))
            ) then_tac \
            EXISTS_TAC(hol: var x :: A; x)
          ) then_tac \
          FIRST_ASSUM(MATCH_MP_TAC)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def WLOG_RELATION:
  prove(
    [
      (hol:
         forall (R :: A -> A -> bool, P :: A -> A -> bool):
           ((forall (x :: A, y :: A): P(x, y) ==> P(y, x))
              && ((forall (x :: A, y :: A): R(x, y) || R(y, x))
                    && (forall (x :: A, y :: A): R(x, y) ==> P(x, y))))
             ==> (forall (x :: A, y :: A): P(x, y))),
      (
        (
          (
            (
              REPEAT(GEN_TAC) then_tac \
              DISCH_THEN(
                CONJUNCTS_THEN2(ASSUME_TAC)(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC))
              )
            ) then_tac \
            REPEAT((MATCH_MP_TAC(MONO_FORALL) then_tac GEN_TAC))
          ) then_tac \
          STRIP_TAC
        ) then_tac \
        ASM_SIMP_TAC(PairList [])
      )
    ]
  )

def EXISTS_UNIQUE_ALT:
  prove(
    [
      (hol:
         forall P :: A -> bool:
           (exists1 x :: A: P(x)) <=> (exists x :: A: forall y :: A: P(y) <=> x == y)),
      (
        (
          (GEN_TAC then_tac REWRITE_TAC(PairList [EXISTS_UNIQUE_THM])) then_tac \
          EQ_TAC
        ) then_list \
        PairList [
          (
            (
              (
                (
                  DISCH_THEN(
                    CONJUNCTS_THEN2(X_CHOOSE_TAC(hol: var x :: A; x))(ASSUME_TAC)
                  ) then_tac \
                  EXISTS_TAC(hol: var x :: A; x)
                ) then_tac \
                GEN_TAC
              ) then_tac \
              EQ_TAC
            ) then_list \
            PairList [
              (
                (DISCH_TAC then_tac FIRST_ASSUM(MATCH_MP_TAC)) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ),
              (
                DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
                FIRST_ASSUM(MATCH_ACCEPT_TAC)
              )
            ]
          ),
          (
            (
              (
                (
                  DISCH_THEN(X_CHOOSE_TAC(hol: var x :: A; x)) then_tac \
                  ASM_REWRITE_TAC(PairList [GSYM(EXISTS_REFL)])
                ) then_tac \
                REPEAT(GEN_TAC)
              ) then_tac \
              DISCH_THEN(CONJUNCTS_THEN(o(SUBST1_TAC)(SYM)))
            ) then_tac \
            REFL_TAC
          )
        ]
      )
    ]
  )

def EXISTS_UNIQUE:
  prove(
    [
      (hol:
         forall P :: A -> bool:
           (exists1 x :: A: P(x)) <=> (exists x :: A: P(x) && (forall y :: A: P(y) ==> y == x))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (GEN_TAC then_tac REWRITE_TAC(PairList [EXISTS_UNIQUE_ALT])) then_tac \
                      AP_TERM_TAC
                    ) then_tac \
                    ABS_TAC
                  ) then_tac \
                  GEN_REWRITE_TAC(o(LAND_CONV)(BINDER_CONV))(
                    PairList [
                      ITAUT(
                        (hol:
                           var a :: bool
                           var b :: bool
                           (a <=> b) <=> (a ==> b) && (b ==> a))
                      )
                    ]
                  )
                ) then_tac \
                GEN_REWRITE_TAC(o(LAND_CONV)(ONCE_DEPTH_CONV))(PairList [EQ_SYM_EQ])
              ) then_tac \
              REWRITE_TAC(PairList [FORALL_AND_THM])
            ) then_tac \
            SIMP_TAC(PairList [])
          ) then_tac \
          REWRITE_TAC(PairList [LEFT_FORALL_IMP_THM, EXISTS_REFL])
        ) then_tac \
        REWRITE_TAC(PairList [CONJ_ACI])
      )
    ]
  )

def [theorems_DESTRUCT_TAC_v2, theorems_FIX_TAC_v2, theorems_INTRO_TAC_v2, HYP_TAC]:
  let PURE_GEN_TAC_2:
    fun([asl, w]):
      try:
        let x = fst(dest_forall(w))
        let avoids = itlist(o(o(union)(thm_frees))(snd))(asl)(frees(w))
        (if mem(x)(avoids) | fail() | X_GEN_TAC(x)([asl, w]))
        ~catch exn:
          match exn
          | Failure(_): failwith("PURE_GEN_TAC")
          | exn: (throw exn)
  let NAME_GEN_TAC_2:
    fun(s):
      fun(gl):
        let ty = o(o(o(o(snd)(dest_var))(fst))(dest_forall))(snd)(gl)
        X_GEN_TAC(mk_var([s, ty]))(gl)
  let OBTAIN_THEN_2:
    fun(v):
      fun(ttac):
        fun(th):
          let ty = o(o(o(o(snd)(dest_var))(fst))(dest_exists))(concl)(th)
          X_CHOOSE_THEN(mk_var([v, ty]))(ttac)(th)
  let CONJ_LIST_TAC_2 = end_itlist(fun(t1): fun(t2): (CONJ_TAC then_list PairList [t1, t2]))
  let NUM_DISJ_TAC_2:
    fun(n):
      if (n <= 0)
      | failwith("NUM_DISJ_TAC")
      | (
          REPLICATE_TAC((n - 1))(DISJ2_TAC) then_tac \
          REPEAT(DISJ1_TAC)
        )
  let SWAP_FORALL_CONV_2 = REWR_CONV(SWAP_FORALL_THM)
  let AND_FORALL_CONV_2 = GEN_REWRITE_CONV(I)(PairList [AND_FORALL_THM])
  let RIGHT_IMP_FORALL_CONV_2 = GEN_REWRITE_CONV(I)(PairList [RIGHT_IMP_FORALL_THM])
  let NAME_PULL_FORALL_CONV_2:
    fun(s):
      fun PULL_FORALL(tm):
        if is_forall(tm)
        | (if (Host.name_of(fst(dest_forall(tm))) == s) | REFL(tm) | (BINDER_CONV(PULL_FORALL) then_conv SWAP_FORALL_CONV_2)(tm))
        | if is_imp(tm)
          | (RAND_CONV(PULL_FORALL) then_conv RIGHT_IMP_FORALL_CONV_2)(tm)
          | (if is_conj(tm) | (BINOP_CONV(PULL_FORALL) then_conv AND_FORALL_CONV_2)(tm) | fail())
      PULL_FORALL
  let pa_ident:
    fun(p):
      fun(arg_2):
        match arg_2
        | PairList [Host.Ident(s), & rest]:
            if p(s)
            | [s, rest]
            | match arg_2
              | _: (throw Host.Noparse())
        | _: (throw Host.Noparse())
  let pa_label_2 = pa_ident(Host.isalnum)
  let pa_var_2 = pa_ident(Host.isalpha)
  let fix_var_2 = (fun(v): (CONV_TAC(NAME_PULL_FORALL_CONV_2(v)) then_tac PURE_GEN_TAC_2))
  let fix_rename_2:
    fun
    | ([u, PairList [v, & PairList []]]): (CONV_TAC(NAME_PULL_FORALL_CONV_2(v)) then_tac NAME_GEN_TAC_2(u))
    | ([u, _]): NAME_GEN_TAC_2(u)
  let oname = Host.possibly(Host.parser_map(Host.parser_sequence(Host.a(Host.Ident("/")))(pa_var_2))(snd))
  let pa_rename:
    Host.parser_map(
      Host.parser_sequence(
        Host.parser_sequence(Host.parser_map(Host.parser_sequence(Host.a(Host.Resword("[")))(pa_var_2))(snd))(oname)
      )(Host.a(Host.Resword("]")))
    )(fst)
  let vars_2:
    Host.parser_map(
      Host.many(
        Host.parser_choice(Host.parser_map(pa_rename)(fix_rename_2))(Host.parser_map(pa_var_2)(fix_var_2))
      )
    )(EVERY)
  let star_2 = Host.possibly(Host.parser_map(Host.a(Host.Ident("*")))(K(#void)))
  let fix_tac_2:
    Host.parser_map(Host.parser_sequence(vars_2)(star_2))(
      fun
      | ([tac, PairList []]): tac
      | ([tac, _]): (tac then_tac REPEAT(GEN_TAC))
    )
  let OBTAINL_THEN = o(EVERY_TCL)(map(OBTAIN_THEN_2))
  fun destruct_2(inp): disj_2(inp)
  fun disj_2(inp):
    let DISJ_CASES_LIST = end_itlist(DISJ_CASES_THEN2)
    Host.parser_map(Host.listof(conj_2)(Host.a(Host.Resword("|")))("Disjunction"))(DISJ_CASES_LIST)(inp)
  fun conj_2(inp): Host.parser_map(Host.atleast(1)(atom_2))(end_itlist(CONJUNCTS_THEN2))(inp)
  fun obtain_2(inp):
    let var_list = Host.atleast(1)(pa_var_2)
    let obtain_prfx:
      Host.parser_map(
        Host.parser_sequence(Host.parser_map(Host.parser_sequence(Host.a(Host.Ident("@")))(var_list))(snd))(Host.a(Host.Resword(".")))
      )(fst)
    Host.parser_map(Host.parser_sequence(obtain_prfx)(destruct_2))(uncurry(OBTAINL_THEN))(inp)
  fun atom_2(inp):
    let label_2:
      fun(arg_3):
        match arg_3
        | PairList [Host.Ident("_"), & res]: [K(ALL_TAC), res]
        | PairList [Host.Ident("+"), & res]: [MP_TAC, res]
        | PairList [Host.Ident(s), & res]:
            if Host.isalnum(s)
            | [LABEL_TAC(s), res]
            | match arg_3
              | _: (throw Host.Noparse())
        | _: (throw Host.Noparse())
    let paren_2:
      Host.parser_map(
        Host.parser_sequence(Host.parser_map(Host.parser_sequence(Host.a(Host.Resword("(")))(destruct_2))(snd))(Host.a(Host.Resword(")")))
      )(fst)
    Host.parser_choice(Host.parser_choice(obtain_2)(label_2))(paren_2)(inp)
  let destruct_tac_2 = destruct_2
  let number_2:
    fun
    | (PairList [Host.Ident(s), & rest]):
        try:
          [check(fun (n): 1 <= n)(hol_int_of_string(s)), rest]
          ~catch exn:
            match exn
            | Failure(_): (throw Host.Noparse())
            | exn: (throw exn)
    | (_): (throw Host.Noparse())
  let pa_fix_2 = Host.parser_map(Host.parser_sequence(Host.a(Host.Ident("!")))(fix_tac_2))(snd)
  let pa_dest_2 = Host.parser_map(destruct_tac_2)(DISCH_THEN)
  let pa_prefix = Host.elistof(Host.parser_choice(pa_fix_2)(pa_dest_2))(Host.a(Host.Resword(";")))("Prefix intro pattern")
  fun pa_intro_2(toks): Host.parser_map(Host.parser_map(Host.parser_sequence(pa_prefix)(Host.possibly(pa_postfix_2)))(uncurry(append)))(EVERY)(toks)
  fun pa_postfix_2(toks): Host.parser_choice(pa_conj_2)(pa_disj_2)(toks)
  fun pa_conj_2(toks):
    let conjs = Host.parser_map(Host.listof(pa_intro_2)(Host.a(Host.Ident("&")))("Intro pattern"))(CONJ_LIST_TAC_2)
    Host.parser_map(
      Host.parser_sequence(Host.parser_map(Host.parser_sequence(Host.a(Host.Resword("{")))(conjs))(snd))(Host.a(Host.Resword("}")))
    )(fst)(toks)
  fun pa_disj_2(toks):
    let disj = Host.parser_map(number_2)(NUM_DISJ_TAC_2)
    Host.parser_map(
      Host.parser_sequence(Host.parser_map(Host.parser_sequence(Host.a(Host.Ident("#")))(disj))(snd))(pa_intro_2)
    )(uncurry(THEN))(toks)
  let intro_tac = pa_intro_2
  let hyp_tac:
    fun(rule):
      let pa_action:
        fun
        | (PairList [Host.Resword(":"), & rest]): [REMOVE_THEN, rest]
        | (PairList [Host.Resword("->"), & rest]): [USE_THEN, rest]
        | (_): (throw Host.Noparse())
      Host.parser_map(
        Host.parser_sequence(pa_label_2)(Host.possibly(Host.parser_sequence(pa_action)(destruct_tac_2)))
      )(
        fun
        | ([lbl, PairList [[action, tac], & PairList []]]): action(lbl)(o(tac)(rule))
        | ([lbl, _]): REMOVE_THEN(lbl)(o(LABEL_TAC(lbl))(rule))
      )
  let DESTRUCT_TAC_2:
    fun(s):
      let [tac, rest] = o(o(Host.fix("Destruct pattern")(destruct_tac_2))(Host.lex))(explode)(s)
      (if (rest == (PairList [])) | tac | failwith("Garbage after destruct pattern"))
  let INTRO_TAC_2:
    fun(s):
      let [tac, rest] = o(o(Host.fix("Introduction pattern")(intro_tac))(Host.lex))(explode)(s)
      (if (rest == (PairList [])) | tac | failwith("Garbage after intro pattern"))
  let FIX_TAC_2:
    fun(s):
      let [tac, rest] = o(o(fix_tac_2)(Host.lex))(explode)(s)
      (if (rest == (PairList [])) | tac | failwith("FIX_TAC: invalid pattern"))
  let HYP_TAC_2:
    fun(s):
      fun(rule):
        let [tac, rest] = o(o(hyp_tac(rule))(Host.lex))(explode)(s)
        (if (rest == (PairList [])) | tac | failwith("HYP_TAC: invalid pattern"))
  [DESTRUCT_TAC_2, FIX_TAC_2, INTRO_TAC_2, HYP_TAC_2]

fun CLAIM_TAC(s): fun(tm): SUBGOAL_THEN(tm)(theorems_DESTRUCT_TAC_v2(s))

def DESTRUCT_TAC = theorems_DESTRUCT_TAC_v2

def FIX_TAC = theorems_FIX_TAC_v2

def INTRO_TAC = theorems_INTRO_TAC_v2
