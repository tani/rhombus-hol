// Quotations are HOL Light text, `@hol|{...}|`; every proof is replayed here.

import:
  "simp.rhm" open:
    only:
      REWR_CONV
      extend_basic_rewrites
      extend_basic_congs
      GEN_REWRITE_CONV
      PURE_REWRITE_CONV
      GEN_REWRITE_TAC
      REWRITE_TAC
      PURE_ASM_REWRITE_TAC
      ASM_REWRITE_TAC
      SIMP_TAC
      ASM_SIMP_TAC
  "itab.rhm" open:
    only:
      ITAUT_TAC
      ITAUT
  "tactics.rhm" open:
    only:
      THEN
      ALL_TAC
      TRY
      REPEAT
      EVERY
      REPLICATE_TAC
      EVERY_TCL
      LABEL_TAC
      ASSUME_TAC
      FIRST_ASSUM
      USE_THEN
      REMOVE_THEN
      ACCEPT_TAC
      CONV_TAC
      REFL_TAC
      ABS_TAC
      AP_TERM_TAC
      SUBST1_TAC
      BETA_TAC
      DISCH_TAC
      MP_TAC
      EQ_TAC
      X_GEN_TAC
      X_CHOOSE_TAC
      EXISTS_TAC
      GEN_TAC
      CONJ_TAC
      DISJ1_TAC
      DISJ2_TAC
      MATCH_ACCEPT_TAC
      MATCH_MP_TAC
      CONJUNCTS_THEN2
      CONJUNCTS_THEN
      DISJ_CASES_THEN2
      DISCH_THEN
      X_CHOOSE_THEN
      CHOOSE_THEN
      STRIP_TAC
      SUBGOAL_THEN
      prove
  "bool.rhm" open:
    only:
      EQT_ELIM
      EQT_INTRO
      SPEC
      SPEC_ALL
      EXISTS_UNIQUE_DEF
  "equal.rhm" open:
    only:
      SYM
      RAND_CONV
      LAND_CONV
      BINDER_CONV
      BINOP_CONV
      ONCE_DEPTH_CONV
      SYM_CONV
      GSYM
  "basics.rhm" open:
    only:
      thm_frees
      is_conj
      is_imp
      is_forall
      dest_forall
      dest_exists
  "fusion.rhm" open:
    only:
      mk_var
      dest_var
      frees
      concl
      REFL
  "lib.rhm" open
  "private/ocaml.rhm" open
  "private/hol_quote.rhm" open
  "printer.rhm" as Host
  "parser.rhm" as Parser:
    expose:
      |||
      ++
      >>
      Ident
      Resword
      Noparse
      many
      fix
      listof
      elistof
      possibly
      a
      atleast
      lex
  "private/declarations.rhm" open
  "private/proof_syntax.rhm" open
  "preterm.rhm" as TypeInference
  "fusion.rhm" as Fusion
  "basics.rhm" as Basics
  "nets.rhm" as Nets
  "equal.rhm" as Equal
  "bool.rhm" as Bool
  "drule.rhm" as Drule
  "tactics.rhm" as Tactics
  "itab.rhm" as Itab
  "simp.rhm" as Simp

export:
  EQ_REFL
  REFL_CLAUSE
  EQ_SYM
  EQ_SYM_EQ
  EQ_TRANS
  AC
  BETA_THM
  ABS_SIMP
  CONJ_ASSOC
  CONJ_SYM
  CONJ_ACI
  DISJ_ASSOC
  DISJ_SYM
  DISJ_ACI
  IMP_CONJ
  IMP_IMP
  IMP_CONJ_ALT
  LEFT_OR_DISTRIB
  RIGHT_OR_DISTRIB
  FORALL_SIMP
  EXISTS_SIMP
  EQ_IMP
  EQ_CLAUSES
  NOT_CLAUSES_WEAK
  AND_CLAUSES
  OR_CLAUSES
  IMP_CLAUSES
  EXISTS_UNIQUE_THM
  EXISTS_REFL
  EXISTS_UNIQUE_REFL
  UNWIND_THM1
  UNWIND_THM2
  FORALL_UNWIND_THM2
  FORALL_UNWIND_THM1
  SWAP_FORALL_THM
  SWAP_EXISTS_THM
  FORALL_AND_THM
  AND_FORALL_THM
  LEFT_AND_FORALL_THM
  RIGHT_AND_FORALL_THM
  EXISTS_OR_THM
  OR_EXISTS_THM
  LEFT_OR_EXISTS_THM
  RIGHT_OR_EXISTS_THM
  LEFT_EXISTS_AND_THM
  RIGHT_EXISTS_AND_THM
  TRIV_EXISTS_AND_THM
  LEFT_AND_EXISTS_THM
  RIGHT_AND_EXISTS_THM
  TRIV_AND_EXISTS_THM
  TRIV_FORALL_OR_THM
  TRIV_OR_FORALL_THM
  RIGHT_IMP_FORALL_THM
  RIGHT_FORALL_IMP_THM
  LEFT_IMP_EXISTS_THM
  LEFT_FORALL_IMP_THM
  TRIV_FORALL_IMP_THM
  TRIV_EXISTS_IMP_THM
  MONO_AND
  MONO_OR
  MONO_IMP
  MONO_NOT
  MONO_FORALL
  MONO_EXISTS
  WLOG_RELATION
  EXISTS_UNIQUE_ALT
  EXISTS_UNIQUE
  DESTRUCT_TAC
  FIX_TAC
  INTRO_TAC
  HYP_TAC
  CLAIM_TAC

def EQ_REFL:
  prove(
    [
      @hol|{!x:A. x = x}|,
      GEN_TAC then_tac REFL_TAC
    ]
  )

def REFL_CLAUSE:
  prove(
    [
      @hol|{!x:A. (x = x) <=> T}|,
      GEN_TAC then_tac MATCH_ACCEPT_TAC(EQT_INTRO(SPEC_ALL(EQ_REFL)))
    ]
  )

def EQ_SYM:
  prove(
    [
      @hol|{!(x:A) y. (x = y) ==> (y = x)}|,
      REPEAT(GEN_TAC) then_tac DISCH_THEN(o(ACCEPT_TAC)(SYM))
    ]
  )

def EQ_SYM_EQ:
  prove(
    [
      @hol|{!(x:A) y. (x = y) <=> (y = x)}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_tac \
      MATCH_ACCEPT_TAC(EQ_SYM)
    ]
  )

def EQ_TRANS:
  prove(
    [
      @hol|{!(x:A) y z. (x = y) /\ (y = z) ==> (x = z)}|,
      REPEAT(STRIP_TAC) then_tac PURE_ASM_REWRITE_TAC(PairList []) then_tac \
      REFL_TAC
    ]
  )

fun AC(acsuite): o(EQT_ELIM)(PURE_REWRITE_CONV(PairList [acsuite, REFL_CLAUSE]))

def BETA_THM:
  prove(
    [
      @hol|{!(f:A->B) y. (\x. (f:A->B) x) y = f y}|,
      REPEAT(GEN_TAC) then_tac BETA_TAC then_tac REFL_TAC
    ]
  )

def ABS_SIMP:
  prove(
    [
      @hol|{!(t1:A) (t2:B). (\x. t1) t2 = t1}|,
      REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [BETA_THM, REFL_CLAUSE])
    ]
  )

def CONJ_ASSOC:
  prove(
    [
      @hol|{!t1 t2 t3. t1 /\ t2 /\ t3 <=> (t1 /\ t2) /\ t3}|,
      ITAUT_TAC
    ]
  )

def CONJ_SYM:
  prove(
    [
      @hol|{!t1 t2. t1 /\ t2 <=> t2 /\ t1}|,
      ITAUT_TAC
    ]
  )

def CONJ_ACI:
  prove(
    [
      @hol|{(p /\ q <=> q /\ p) /\
         ((p /\ q) /\ r <=> p /\ (q /\ r)) /\
         (p /\ (q /\ r) <=> q /\ (p /\ r)) /\
         (p /\ p <=> p) /\
         (p /\ (p /\ q) <=> p /\ q)}|,
      ITAUT_TAC
    ]
  )

def DISJ_ASSOC:
  prove(
    [
      @hol|{!t1 t2 t3. t1 \/ t2 \/ t3 <=> (t1 \/ t2) \/ t3}|,
      ITAUT_TAC
    ]
  )

def DISJ_SYM:
  prove(
    [
      @hol|{!t1 t2. t1 \/ t2 <=> t2 \/ t1}|,
      ITAUT_TAC
    ]
  )

def DISJ_ACI:
  prove(
    [
      @hol|{(p \/ q <=> q \/ p) /\
         ((p \/ q) \/ r <=> p \/ (q \/ r)) /\
         (p \/ (q \/ r) <=> q \/ (p \/ r)) /\
         (p \/ p <=> p) /\
         (p \/ (p \/ q) <=> p \/ q)}|,
      ITAUT_TAC
    ]
  )

def IMP_CONJ:
  prove(
    [
      @hol|{p /\ q ==> r <=> p ==> q ==> r}|,
      ITAUT_TAC
    ]
  )

def IMP_IMP = GSYM(IMP_CONJ)

def IMP_CONJ_ALT:
  prove(
    [
      @hol|{p /\ q ==> r <=> q ==> p ==> r}|,
      ITAUT_TAC
    ]
  )

def LEFT_OR_DISTRIB:
  prove(
    [
      @hol|{!p q r. p /\ (q \/ r) <=> p /\ q \/ p /\ r}|,
      ITAUT_TAC
    ]
  )

def RIGHT_OR_DISTRIB:
  prove(
    [
      @hol|{!p q r. (p \/ q) /\ r <=> p /\ r \/ q /\ r}|,
      ITAUT_TAC
    ]
  )

def FORALL_SIMP:
  prove(
    [
      @hol|{!t. (!x:A. t) = t}|,
      ITAUT_TAC
    ]
  )

def EXISTS_SIMP:
  prove(
    [
      @hol|{!t. (?x:A. t) = t}|,
      ITAUT_TAC
    ]
  )

def EQ_IMP:
  ITAUT(
    @hol|{(a <=> b) ==> a ==> b}|
  )

def EQ_CLAUSES:
  prove(
    [
      @hol|{!t. ((T <=> t) <=> t) /\ ((t <=> T) <=> t) /\
         ((F <=> t) <=> ~t) /\ ((t <=> F) <=> ~t)}|,
      ITAUT_TAC
    ]
  )

def NOT_CLAUSES_WEAK = prove([@hol|{(~T <=> F) /\ (~F <=> T)}|, ITAUT_TAC])

def AND_CLAUSES:
  prove(
    [
      @hol|{!t. (T /\ t <=> t) /\ (t /\ T <=> t) /\ (F /\ t <=> F) /\
         (t /\ F <=> F) /\ (t /\ t <=> t)}|,
      ITAUT_TAC
    ]
  )

def OR_CLAUSES:
  prove(
    [
      @hol|{!t. (T \/ t <=> T) /\ (t \/ T <=> T) /\ (F \/ t <=> t) /\
         (t \/ F <=> t) /\ (t \/ t <=> t)}|,
      ITAUT_TAC
    ]
  )

def IMP_CLAUSES:
  prove(
    [
      @hol|{!t. (T ==> t <=> t) /\ (t ==> T <=> T) /\ (F ==> t <=> T) /\
         (t ==> t <=> T) /\ (t ==> F <=> ~t)}|,
      ITAUT_TAC
    ]
  )

def initialization_1:
  let IMP_EQ_CLAUSE:
    prove(
      [
        @hol|{((x = x) ==> p) <=> p}|,
        REWRITE_TAC(PairList [EQT_INTRO(SPEC_ALL(EQ_REFL)), IMP_CLAUSES])
      ]
    )
  extend_basic_rewrites(
    PairList [
      REFL_CLAUSE,
      EQ_CLAUSES,
      NOT_CLAUSES_WEAK,
      AND_CLAUSES,
      OR_CLAUSES,
      IMP_CLAUSES,
      FORALL_SIMP,
      EXISTS_SIMP,
      BETA_THM,
      IMP_EQ_CLAUSE
    ]
  )

def initialization_2:
  extend_basic_congs(
    PairList [
      ITAUT(
        @hol|{(p <=> p') ==> (p' ==> (q <=> q')) ==> (p ==> q <=> p' ==> q')}|
      )
    ]
  )

def EXISTS_UNIQUE_THM:
  prove(
    [
      @hol|{!P. (?!x:A. P x) <=> (?x. P x) /\ (!x x'. P x /\ P x' ==> (x = x'))}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [EXISTS_UNIQUE_DEF])
    ]
  )

def EXISTS_REFL:
  prove(
    [
      @hol|{!a:A. ?x. x = a}|,
      GEN_TAC then_tac EXISTS_TAC(@hol|{a:A}|) then_tac \
      REFL_TAC
    ]
  )

def EXISTS_UNIQUE_REFL:
  prove(
    [
      @hol|{!a:A. ?!x. x = a}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [EXISTS_UNIQUE_THM]) then_tac \
      REPEAT(EQ_TAC or_tac STRIP_TAC) then_list \
      PairList [
        EXISTS_TAC(@hol|{a:A}|),
        ASM_REWRITE_TAC(PairList [])
      ] then_tac \
      REFL_TAC
    ]
  )

def UNWIND_THM1:
  prove(
    [
      @hol|{!P (a:A). (?x. a = x /\ P x) <=> P a}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [
        DISCH_THEN(CHOOSE_THEN(CONJUNCTS_THEN2(SUBST1_TAC)(ACCEPT_TAC))),
        DISCH_TAC then_tac EXISTS_TAC(@hol|{a:A}|) then_tac \
        CONJ_TAC then_tac \
        TRY(FIRST_ASSUM(MATCH_ACCEPT_TAC)) then_tac \
        REFL_TAC
      ]
    ]
  )

def UNWIND_THM2:
  prove(
    [
      @hol|{!P (a:A). (?x. x = a /\ P x) <=> P a}|,
      REPEAT(GEN_TAC) then_tac \
      CONV_TAC(LAND_CONV(ONCE_DEPTH_CONV(SYM_CONV))) then_tac \
      MATCH_ACCEPT_TAC(UNWIND_THM1)
    ]
  )

def FORALL_UNWIND_THM2:
  prove(
    [
      @hol|{!P (a:A). (!x. x = a ==> P x) <=> P a}|,
      REPEAT(GEN_TAC) then_tac EQ_TAC then_list \
      PairList [
        DISCH_THEN(o(MP_TAC)(SPEC(@hol|{a:A}|))) then_tac \
        REWRITE_TAC(PairList []),
        DISCH_TAC then_tac GEN_TAC then_tac DISCH_THEN(SUBST1_TAC) then_tac \
        ASM_REWRITE_TAC(PairList [])
      ]
    ]
  )

def FORALL_UNWIND_THM1:
  prove(
    [
      @hol|{!P (a:A). (!x. a = x ==> P x) <=> P a}|,
      REPEAT(GEN_TAC) then_tac \
      CONV_TAC(LAND_CONV(ONCE_DEPTH_CONV(SYM_CONV))) then_tac \
      MATCH_ACCEPT_TAC(FORALL_UNWIND_THM2)
    ]
  )

def SWAP_FORALL_THM:
  prove(
    [
      @hol|{!P:A->B->bool. (!x y. P x y) <=> (!y x. P x y)}|,
      ITAUT_TAC
    ]
  )

def SWAP_EXISTS_THM:
  prove(
    [
      @hol|{!P:A->B->bool. (?x y. P x y) <=> (?y x. P x y)}|,
      ITAUT_TAC
    ]
  )

def FORALL_AND_THM:
  prove(
    [
      @hol|{!P Q. (!x:A. P x /\ Q x) <=> (!x. P x) /\ (!x. Q x)}|,
      ITAUT_TAC
    ]
  )

def AND_FORALL_THM:
  prove(
    [
      @hol|{!P Q. (!x. P x) /\ (!x. Q x) <=> (!x:A. P x /\ Q x)}|,
      ITAUT_TAC
    ]
  )

def LEFT_AND_FORALL_THM:
  prove(
    [
      @hol|{!P Q. (!x:A. P x) /\ Q <=> (!x:A. P x /\ Q)}|,
      ITAUT_TAC
    ]
  )

def RIGHT_AND_FORALL_THM:
  prove(
    [
      @hol|{!P Q. P /\ (!x:A. Q x) <=> (!x. P /\ Q x)}|,
      ITAUT_TAC
    ]
  )

def EXISTS_OR_THM:
  prove(
    [
      @hol|{!P Q. (?x:A. P x \/ Q x) <=> (?x. P x) \/ (?x. Q x)}|,
      ITAUT_TAC
    ]
  )

def OR_EXISTS_THM:
  prove(
    [
      @hol|{!P Q. (?x. P x) \/ (?x. Q x) <=> (?x:A. P x \/ Q x)}|,
      ITAUT_TAC
    ]
  )

def LEFT_OR_EXISTS_THM:
  prove(
    [
      @hol|{!P Q. (?x. P x) \/ Q <=> (?x:A. P x \/ Q)}|,
      ITAUT_TAC
    ]
  )

def RIGHT_OR_EXISTS_THM:
  prove(
    [
      @hol|{!P Q. P \/ (?x. Q x) <=> (?x:A. P \/ Q x)}|,
      ITAUT_TAC
    ]
  )

def LEFT_EXISTS_AND_THM:
  prove(
    [
      @hol|{!P Q. (?x:A. P x /\ Q) <=> (?x:A. P x) /\ Q}|,
      ITAUT_TAC
    ]
  )

def RIGHT_EXISTS_AND_THM:
  prove(
    [
      @hol|{!P Q. (?x:A. P /\ Q x) <=> P /\ (?x:A. Q x)}|,
      ITAUT_TAC
    ]
  )

def TRIV_EXISTS_AND_THM:
  prove(
    [
      @hol|{!P Q. (?x:A. P /\ Q) <=> (?x:A. P) /\ (?x:A. Q)}|,
      ITAUT_TAC
    ]
  )

def LEFT_AND_EXISTS_THM:
  prove(
    [
      @hol|{!P Q. (?x:A. P x) /\ Q <=> (?x:A. P x /\ Q)}|,
      ITAUT_TAC
    ]
  )

def RIGHT_AND_EXISTS_THM:
  prove(
    [
      @hol|{!P Q. P /\ (?x:A. Q x) <=> (?x:A. P /\ Q x)}|,
      ITAUT_TAC
    ]
  )

def TRIV_AND_EXISTS_THM:
  prove(
    [
      @hol|{!P Q. (?x:A. P) /\ (?x:A. Q) <=> (?x:A. P /\ Q)}|,
      ITAUT_TAC
    ]
  )

def TRIV_FORALL_OR_THM:
  prove(
    [
      @hol|{!P Q. (!x:A. P \/ Q) <=> (!x:A. P) \/ (!x:A. Q)}|,
      ITAUT_TAC
    ]
  )

def TRIV_OR_FORALL_THM:
  prove(
    [
      @hol|{!P Q. (!x:A. P) \/ (!x:A. Q) <=> (!x:A. P \/ Q)}|,
      ITAUT_TAC
    ]
  )

def RIGHT_IMP_FORALL_THM:
  prove(
    [
      @hol|{!P Q. (P ==> !x:A. Q x) <=> (!x. P ==> Q x)}|,
      ITAUT_TAC
    ]
  )

def RIGHT_FORALL_IMP_THM:
  prove(
    [
      @hol|{!P Q. (!x. P ==> Q x) <=> (P ==> !x:A. Q x)}|,
      ITAUT_TAC
    ]
  )

def LEFT_IMP_EXISTS_THM:
  prove(
    [
      @hol|{!P Q. ((?x:A. P x) ==> Q) <=> (!x. P x ==> Q)}|,
      ITAUT_TAC
    ]
  )

def LEFT_FORALL_IMP_THM:
  prove(
    [
      @hol|{!P Q. (!x. P x ==> Q) <=> ((?x:A. P x) ==> Q)}|,
      ITAUT_TAC
    ]
  )

def TRIV_FORALL_IMP_THM:
  prove(
    [
      @hol|{!P Q. (!x:A. P ==> Q) <=> ((?x:A. P) ==> (!x:A. Q))}|,
      ITAUT_TAC
    ]
  )

def TRIV_EXISTS_IMP_THM:
  prove(
    [
      @hol|{!P Q. (?x:A. P ==> Q) <=> ((!x:A. P) ==> (?x:A. Q))}|,
      ITAUT_TAC
    ]
  )

def MONO_AND:
  ITAUT(
    @hol|{(A ==> B) /\ (C ==> D) ==> (A /\ C ==> B /\ D)}|
  )

def MONO_OR:
  ITAUT(
    @hol|{(A ==> B) /\ (C ==> D) ==> (A \/ C ==> B \/ D)}|
  )

def MONO_IMP:
  ITAUT(
    @hol|{(B ==> A) /\ (C ==> D) ==> ((A ==> C) ==> (B ==> D))}|
  )

def MONO_NOT:
  ITAUT(
    @hol|{(B ==> A) ==> (~A ==> ~B)}|
  )

def MONO_FORALL:
  prove(
    [
      @hol|{(!x:A. P x ==> Q x) ==> ((!x. P x) ==> (!x. Q x))}|,
      REPEAT(STRIP_TAC) then_tac FIRST_ASSUM(MATCH_MP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def MONO_EXISTS:
  prove(
    [
      @hol|{(!x:A. P x ==> Q x) ==> ((?x. P x) ==> (?x. Q x))}|,
      DISCH_TAC then_tac \
      DISCH_THEN(X_CHOOSE_TAC(@hol|{x:A}|)) then_tac \
      EXISTS_TAC(@hol|{x:A}|) then_tac \
      FIRST_ASSUM(MATCH_MP_TAC) then_tac \
      ASM_REWRITE_TAC(PairList [])
    ]
  )

def WLOG_RELATION:
  prove(
    [
      @hol|{!R P. (!x y. P x y ==> P y x) /\
         (!x y. R x y \/ R y x) /\
         (!x y. R x y ==> P x y)
         ==> !x y:A. P x y}|,
      REPEAT(GEN_TAC) then_tac \
      DISCH_THEN(
        CONJUNCTS_THEN2(ASSUME_TAC)(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC))
      ) then_tac \
      REPEAT(MATCH_MP_TAC(MONO_FORALL) then_tac GEN_TAC) then_tac \
      STRIP_TAC then_tac \
      ASM_SIMP_TAC(PairList [])
    ]
  )

def EXISTS_UNIQUE_ALT:
  prove(
    [
      @hol|{!P:A->bool. (?!x. P x) <=> (?x. !y. P y <=> (x = y))}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [EXISTS_UNIQUE_THM]) then_tac \
      EQ_TAC then_list \
      PairList [
        DISCH_THEN(
          CONJUNCTS_THEN2(X_CHOOSE_TAC(@hol|{x:A}|))(ASSUME_TAC)
        ) then_tac \
        EXISTS_TAC(@hol|{x:A}|) then_tac \
        GEN_TAC then_tac \
        EQ_TAC then_list \
        PairList [
          DISCH_TAC then_tac FIRST_ASSUM(MATCH_MP_TAC) then_tac \
          ASM_REWRITE_TAC(PairList []),
          DISCH_THEN(o(SUBST1_TAC)(SYM)) then_tac \
          FIRST_ASSUM(MATCH_ACCEPT_TAC)
        ],
        DISCH_THEN(X_CHOOSE_TAC(@hol|{x:A}|)) then_tac \
        ASM_REWRITE_TAC(PairList [GSYM(EXISTS_REFL)]) then_tac \
        REPEAT(GEN_TAC) then_tac \
        DISCH_THEN(CONJUNCTS_THEN(o(SUBST1_TAC)(SYM))) then_tac \
        REFL_TAC
      ]
    ]
  )

def EXISTS_UNIQUE:
  prove(
    [
      @hol|{!P:A->bool. (?!x. P x) <=> (?x. P x /\ !y. P y ==> (y = x))}|,
      GEN_TAC then_tac REWRITE_TAC(PairList [EXISTS_UNIQUE_ALT]) then_tac \
      AP_TERM_TAC then_tac \
      ABS_TAC then_tac \
      GEN_REWRITE_TAC(o(LAND_CONV)(BINDER_CONV))(
        PairList [
          ITAUT(
            @hol|{(a <=> b) <=> (a ==> b) /\ (b ==> a)}|
          )
        ]
      ) then_tac \
      GEN_REWRITE_TAC(o(LAND_CONV)(ONCE_DEPTH_CONV))(PairList [EQ_SYM_EQ]) then_tac \
      REWRITE_TAC(PairList [FORALL_AND_THM]) then_tac \
      SIMP_TAC(PairList []) then_tac \
      REWRITE_TAC(PairList [LEFT_FORALL_IMP_THM, EXISTS_REFL]) then_tac \
      REWRITE_TAC(PairList [CONJ_ACI])
    ]
  )

def [theorems_DESTRUCT_TAC_v2, theorems_FIX_TAC_v2, theorems_INTRO_TAC_v2, HYP_TAC]:
  let PURE_GEN_TAC:
    fun([asl, w]):
      try:
        let x = fst(dest_forall(w))
        let avoids = itlist(o(o(union)(thm_frees))(snd))(asl)(frees(w))
        (if mem(x)(avoids) | fail(#void) | X_GEN_TAC(x)([asl, w]))
        ~catch exn:
          match exn
          | Failure(_): failwith("PURE_GEN_TAC")
          | exn: (throw exn)
  let NAME_GEN_TAC:
    fun(s):
      fun(gl):
        let ty = o(o(o(o(snd)(dest_var))(fst))(dest_forall))(snd)(gl)
        X_GEN_TAC(mk_var([s, ty]))(gl)
  let OBTAIN_THEN:
    fun(v):
      fun(ttac):
        fun(th):
          let ty = o(o(o(o(snd)(dest_var))(fst))(dest_exists))(concl)(th)
          X_CHOOSE_THEN(mk_var([v, ty]))(ttac)(th)
  let CONJ_LIST_TAC = end_itlist(fun(t1): fun(t2): (CONJ_TAC then_list PairList [t1, t2]))
  let NUM_DISJ_TAC:
    fun(n):
      if (n <= 0)
      | failwith("NUM_DISJ_TAC")
      | (
          REPLICATE_TAC((n - 1))(DISJ2_TAC) then_tac \
          REPEAT(DISJ1_TAC)
        )
  let SWAP_FORALL_CONV = REWR_CONV(SWAP_FORALL_THM)
  let AND_FORALL_CONV = GEN_REWRITE_CONV(I)(PairList [AND_FORALL_THM])
  let RIGHT_IMP_FORALL_CONV = GEN_REWRITE_CONV(I)(PairList [RIGHT_IMP_FORALL_THM])
  let NAME_PULL_FORALL_CONV:
    fun(s):
      fun PULL_FORALL(tm):
        if is_forall(tm)
        | (if (Host.name_of(fst(dest_forall(tm))) == s) | REFL(tm) | (BINDER_CONV(PULL_FORALL) then_conv SWAP_FORALL_CONV)(tm))
        | if is_imp(tm)
          | (RAND_CONV(PULL_FORALL) then_conv RIGHT_IMP_FORALL_CONV)(tm)
          | (if is_conj(tm) | (BINOP_CONV(PULL_FORALL) then_conv AND_FORALL_CONV)(tm) | fail(#void))
      PULL_FORALL
  let pa_ident:
    fun(p):
      fun(toks):
        match toks
        | PairList [Ident(s), & rest] when p(s): [s, rest]
        | _: throw Noparse()
  let pa_label = pa_ident(Host.isalnum)
  let pa_var = pa_ident(Host.isalpha)
  let fix_tac:
    let fix_var = fun(v): CONV_TAC(NAME_PULL_FORALL_CONV(v)) then_tac PURE_GEN_TAC
    let fix_rename:
      fun
      | ([u, PairList [v]]): CONV_TAC(NAME_PULL_FORALL_CONV(v)) then_tac NAME_GEN_TAC(u)
      | ([u, _]): NAME_GEN_TAC(u)
    let vars:
      let pa_rename:
        let oname = possibly(a(Ident("/")) ++ pa_var >> snd)
        (a(Resword("[")) ++ pa_var >> snd) ++ oname ++ a(Resword("]")) >> fst
      many((pa_rename >> fix_rename) ||| (pa_var >> fix_var)) >> EVERY
    let star = possibly(a(Ident("*")) >> K(#void))
    (vars ++ star
       >> (fun
           | ([tac, PairList []]): tac
           | ([tac, _]): tac then_tac REPEAT(GEN_TAC)))
  let destruct_tac:
    let OBTAINL_THEN = o(EVERY_TCL)(map(OBTAIN_THEN))
    fun destruct(inp): disj(inp)
    fun disj(inp):
      let DISJ_CASES_LIST = end_itlist(DISJ_CASES_THEN2)
      (listof(conj)(a(Resword("|")))("Disjunction") >> DISJ_CASES_LIST)(inp)
    fun conj(inp): (atleast(1)(atom) >> end_itlist(CONJUNCTS_THEN2))(inp)
    fun obtain(inp):
      let obtain_prfx:
        let var_list = atleast(1)(pa_var)
        (a(Ident("@")) ++ var_list >> snd) ++ a(Resword(".")) >> fst
      (obtain_prfx ++ destruct >> uncurry(OBTAINL_THEN))(inp)
    fun atom(inp):
      let label:
        fun(toks):
          match toks
          | PairList [Ident("_"), & res]: [K(ALL_TAC), res]
          | PairList [Ident("+"), & res]: [MP_TAC, res]
          | PairList [Ident(s), & res] when Host.isalnum(s): [LABEL_TAC(s), res]
          | _: throw Noparse()
      let paren = (a(Resword("(")) ++ destruct >> snd) ++ a(Resword(")")) >> fst
      (obtain ||| label ||| paren)(inp)
    destruct
  let intro_tac:
    let number:
      fun(toks):
        match toks
        | PairList [Ident(s), & rest]:
            try:
              [check(fun(n): 1 <= n)(hol_int_of_string(s)), rest]
              ~catch Failure(_): throw Noparse()
        | _: throw Noparse()
    let pa_fix = a(Ident("!")) ++ fix_tac >> snd
    let pa_dest = destruct_tac >> DISCH_THEN
    let pa_prefix = elistof(pa_fix ||| pa_dest)(a(Resword(";")))("Prefix intro pattern")
    fun pa_intro(toks):
      (pa_prefix ++ possibly(pa_postfix) >> uncurry(append) >> EVERY)(toks)
    fun pa_postfix(toks): (pa_conj ||| pa_disj)(toks)
    fun pa_conj(toks):
      let conjs = listof(pa_intro)(a(Ident("&")))("Intro pattern") >> CONJ_LIST_TAC
      ((a(Resword("{")) ++ conjs >> snd) ++ a(Resword("}")) >> fst)(toks)
    fun pa_disj(toks):
      let disj = number >> NUM_DISJ_TAC
      ((a(Ident("#")) ++ disj >> snd) ++ pa_intro >> uncurry(THEN))(toks)
    pa_intro
  let hyp_tac:
    fun(rule):
      let pa_action:
        fun(toks):
          match toks
          | PairList [Resword(":"), & rest]: [REMOVE_THEN, rest]
          | PairList [Resword("->"), & rest]: [USE_THEN, rest]
          | _: throw Noparse()
      (pa_label ++ possibly(pa_action ++ destruct_tac)
         >> (fun
             | ([lbl, PairList [[action, tac]]]): action(lbl)(o(tac)(rule))
             | ([lbl, _]): REMOVE_THEN(lbl)(o(LABEL_TAC(lbl))(rule))))
  let DESTRUCT_TAC_2:
    fun(s):
      let [tac, rest] = o(o(fix("Destruct pattern")(destruct_tac))(lex))(explode)(s)
      if rest == PairList [] | tac | failwith("Garbage after destruct pattern")
  let INTRO_TAC_2:
    fun(s):
      let [tac, rest] = o(o(fix("Introduction pattern")(intro_tac))(lex))(explode)(s)
      if rest == PairList [] | tac | failwith("Garbage after intro pattern")
  let FIX_TAC_2:
    fun(s):
      let [tac, rest] = o(o(fix_tac)(lex))(explode)(s)
      if rest == PairList [] | tac | failwith("FIX_TAC: invalid pattern")
  let HYP_TAC_2:
    fun(s):
      fun(rule):
        let [tac, rest] = o(o(hyp_tac(rule))(lex))(explode)(s)
        if rest == PairList [] | tac | failwith("HYP_TAC: invalid pattern")
  [DESTRUCT_TAC_2, FIX_TAC_2, INTRO_TAC_2, HYP_TAC_2]

fun CLAIM_TAC(s): fun(tm): SUBGOAL_THEN(tm)(theorems_DESTRUCT_TAC_v2(s))

def DESTRUCT_TAC = theorems_DESTRUCT_TAC_v2

def FIX_TAC = theorems_FIX_TAC_v2

def INTRO_TAC = theorems_INTRO_TAC_v2
