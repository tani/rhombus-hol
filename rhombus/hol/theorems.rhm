def EQ_REFL:
  prove(
    [
      Host.hol_term(Forall("x", Tvar("A"), Eq(Tvar("A"), Ref("x"), Ref("x")))),
      (GEN_TAC then_tac REFL_TAC)
    ]
  )

def REFL_CLAUSE:
  prove(
    [
      Host.hol_term(Forall("x", Tvar("A"), Iff(Eq(Tvar("A"), Ref("x"), Ref("x")), True))),
      (GEN_TAC then_tac MATCH_ACCEPT_TAC(EQT_INTRO(SPEC_ALL(EQ_REFL))))
    ]
  )

def EQ_SYM:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Tvar("A"),
        Forall(
          "y",
          Tvar("A"),
          Implies(Eq(Tvar("A"), Ref("x"), Ref("y")), Eq(Tvar("A"), Ref("y"), Ref("x")))
        )
      )),
      (REPEAT(GEN_TAC) then_tac DISCH_THEN(o(ACCEPT_TAC)(SYM)))
    ]
  )

def EQ_SYM_EQ:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Tvar("A"),
        Forall(
          "y",
          Tvar("A"),
          Iff(Eq(Tvar("A"), Ref("x"), Ref("y")), Eq(Tvar("A"), Ref("y"), Ref("x")))
        )
      )),
      (
        (REPEAT(GEN_TAC) then_tac EQ_TAC) then_tac \
        MATCH_ACCEPT_TAC(EQ_SYM)
      )
    ]
  )

def EQ_TRANS:
  prove(
    [
      Host.hol_term(Forall(
        "x",
        Tvar("A"),
        Forall(
          "y",
          Tvar("A"),
          Forall(
            "z",
            Tvar("A"),
            Implies(
              And(Eq(Tvar("A"), Ref("x"), Ref("y")), Eq(Tvar("A"), Ref("y"), Ref("z"))),
              Eq(Tvar("A"), Ref("x"), Ref("z"))
            )
          )
        )
      )),
      (
        (REPEAT(STRIP_TAC) then_tac PURE_ASM_REWRITE_TAC(PairList [])) then_tac \
        REFL_TAC
      )
    ]
  )

fun AC(acsuite): o(EQT_ELIM)(PURE_REWRITE_CONV(PairList [acsuite, REFL_CLAUSE]))

def BETA_THM:
  prove(
    [
      Host.hol_term(Forall(
        "f",
        Fun(Tvar("A"), Tvar("B")),
        Forall(
          "y",
          Tvar("A"),
          Eq(
            Tvar("B"),
            App(Lambda("x", Tvar("A"), App(Ref("f"), [Ref("x")])), [Ref("y")]),
            App(Ref("f"), [Ref("y")])
          )
        )
      )),
      ((REPEAT(GEN_TAC) then_tac BETA_TAC) then_tac REFL_TAC)
    ]
  )

def ABS_SIMP:
  prove(
    [
      Host.hol_term(Forall(
        "t1",
        Tvar("A"),
        Forall(
          "t2",
          Tvar("B"),
          Eq(Tvar("A"), App(Lambda("x", Tvar("B"), Ref("t1")), [Ref("t2")]), Ref("t1"))
        )
      )),
      (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [BETA_THM, REFL_CLAUSE]))
    ]
  )

def CONJ_ASSOC:
  prove(
    [
      Host.hol_term(Forall(
        "t1",
        Bool,
        Forall(
          "t2",
          Bool,
          Forall(
            "t3",
            Bool,
            Iff(And(Ref("t1"), And(Ref("t2"), Ref("t3"))), And(And(Ref("t1"), Ref("t2")), Ref("t3")))
          )
        )
      )),
      ITAUT_TAC
    ]
  )

def CONJ_SYM:
  prove(
    [
      Host.hol_term(Forall(
        "t1",
        Bool,
        Forall("t2", Bool, Iff(And(Ref("t1"), Ref("t2")), And(Ref("t2"), Ref("t1"))))
      )),
      ITAUT_TAC
    ]
  )

def CONJ_ACI:
  prove(
    [
      Host.hol_term(And(
        Iff(And(Var("p", Bool), Var("q", Bool)), And(Var("q", Bool), Var("p", Bool))),
        And(
          Iff(
            And(And(Var("p", Bool), Var("q", Bool)), Var("r", Bool)),
            And(Var("p", Bool), And(Var("q", Bool), Var("r", Bool)))
          ),
          And(
            Iff(
              And(Var("p", Bool), And(Var("q", Bool), Var("r", Bool))),
              And(Var("q", Bool), And(Var("p", Bool), Var("r", Bool)))
            ),
            And(
              Iff(And(Var("p", Bool), Var("p", Bool)), Var("p", Bool)),
              Iff(
                And(Var("p", Bool), And(Var("p", Bool), Var("q", Bool))),
                And(Var("p", Bool), Var("q", Bool))
              )
            )
          )
        )
      )),
      ITAUT_TAC
    ]
  )

def DISJ_ASSOC:
  prove(
    [
      Host.hol_term(Forall(
        "t1",
        Bool,
        Forall(
          "t2",
          Bool,
          Forall(
            "t3",
            Bool,
            Iff(Or(Ref("t1"), Or(Ref("t2"), Ref("t3"))), Or(Or(Ref("t1"), Ref("t2")), Ref("t3")))
          )
        )
      )),
      ITAUT_TAC
    ]
  )

def DISJ_SYM:
  prove(
    [
      Host.hol_term(Forall("t1", Bool, Forall("t2", Bool, Iff(Or(Ref("t1"), Ref("t2")), Or(Ref("t2"), Ref("t1")))))),
      ITAUT_TAC
    ]
  )

def DISJ_ACI:
  prove(
    [
      Host.hol_term(And(
        Iff(Or(Var("p", Bool), Var("q", Bool)), Or(Var("q", Bool), Var("p", Bool))),
        And(
          Iff(
            Or(Or(Var("p", Bool), Var("q", Bool)), Var("r", Bool)),
            Or(Var("p", Bool), Or(Var("q", Bool), Var("r", Bool)))
          ),
          And(
            Iff(
              Or(Var("p", Bool), Or(Var("q", Bool), Var("r", Bool))),
              Or(Var("q", Bool), Or(Var("p", Bool), Var("r", Bool)))
            ),
            And(
              Iff(Or(Var("p", Bool), Var("p", Bool)), Var("p", Bool)),
              Iff(Or(Var("p", Bool), Or(Var("p", Bool), Var("q", Bool))), Or(Var("p", Bool), Var("q", Bool)))
            )
          )
        )
      )),
      ITAUT_TAC
    ]
  )

def IMP_CONJ:
  prove(
    [
      Host.hol_term(Iff(
        Implies(And(Var("p", Bool), Var("q", Bool)), Var("r", Bool)),
        Implies(Var("p", Bool), Implies(Var("q", Bool), Var("r", Bool)))
      )),
      ITAUT_TAC
    ]
  )

def IMP_IMP = GSYM(IMP_CONJ)

def IMP_CONJ_ALT:
  prove(
    [
      Host.hol_term(Iff(
        Implies(And(Var("p", Bool), Var("q", Bool)), Var("r", Bool)),
        Implies(Var("q", Bool), Implies(Var("p", Bool), Var("r", Bool)))
      )),
      ITAUT_TAC
    ]
  )

