                          | failwith("HYP_TAC: invalid pattern")
                        »)
                      »)
                    »)
                  »)
                »;
                Host.HolTuple4(port_tmp_170_DESTRUCT_TAC,port_tmp_172_FIX_TAC,port_tmp_171_INTRO_TAC,port_tmp_173_HYP_TAC)
              »)
            »)
          »)
        »)
      »)
    »)
  »)
»

fun theorems_CLAIM_TAC(s):«
  (fun(tm):«
    Up_tactics.SUBGOAL_THEN(tm)(theorems_DESTRUCT_TAC(s))
  »)
»

