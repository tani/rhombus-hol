  prove(
    [
      Host.hol_term(Forall(
        "p",
        Bool,
        Forall(
          "q",
          Bool,
          Forall(
            "r",
            Bool,
            Iff(And(Ref("p"), Or(Ref("q"), Ref("r"))), Or(And(Ref("p"), Ref("q")), And(Ref("p"), Ref("r"))))
          )
        )
      )),
      ITAUT_TAC
    ]
  )

def RIGHT_OR_DISTRIB:
  prove(
