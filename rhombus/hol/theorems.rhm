def [DESTRUCT_TAC, FIX_TAC, INTRO_TAC, HYP_TAC]:
  let PURE_GEN_TAC_2:
    fun([asl, w]):
      try:
        let x = fst(Basics.dest_forall(w))
        let avoids = itlist(o(o(union)(Basics.thm_frees))(snd))(asl)(Fusion.frees(w))
        (if mem(x)(avoids) | Host.hol_apply_unit(fail) | Tactics.X_GEN_TAC(x)([asl, w]))
        ~catch exn:
          match exn
          | Failure(_): failwith("PURE_GEN_TAC")
          | exn: Host.hol_raise(exn)
  let NAME_GEN_TAC_2:
    fun(s):
      fun(gl):
        let ty = o(o(o(o(snd)(Fusion.dest_var))(fst))(Basics.dest_forall))(snd)(gl)
        Tactics.X_GEN_TAC(Fusion.mk_var([s, ty]))(gl)
  let OBTAIN_THEN_2:
    fun(v):
      fun(ttac):
        fun(th):
          let ty = o(o(o(o(snd)(Fusion.dest_var))(fst))(Basics.dest_exists))(Fusion.concl)(th)
          Tactics.X_CHOOSE_THEN(Fusion.mk_var([v, ty]))(ttac)(th)
  let CONJ_LIST_TAC_2 = end_itlist((fun(t1): (fun(t2): Tactics.THENL(Tactics.CONJ_TAC)(PairList.cons(t1, PairList.cons(t2, PairList []))))))
  let NUM_DISJ_TAC_2 = (fun(n): (if Host.hol_le(n)(0) | failwith("NUM_DISJ_TAC") | Tactics.THEN(Tactics.REPLICATE_TAC(Host.hol_sub(n)(1))(Tactics.DISJ2_TAC))(Tactics.REPEAT(Tactics.DISJ1_TAC))))
  let SWAP_FORALL_CONV_2 = Simp.REWR_CONV(SWAP_FORALL_THM)
  let AND_FORALL_CONV_2 = Simp.GEN_REWRITE_CONV(I)(PairList.cons(AND_FORALL_THM, PairList []))
  let RIGHT_IMP_FORALL_CONV_2 = Simp.GEN_REWRITE_CONV(I)(PairList.cons(RIGHT_IMP_FORALL_THM, PairList []))
  let NAME_PULL_FORALL_CONV_2:
    fun(s):
      fun PULL_FORALL(tm):
        if Basics.is_forall(tm)
        | (if Host.hol_equal(Host.name_of(fst(Basics.dest_forall(tm))))(s) | Fusion.REFL(tm) | Equal.THENC(Equal.BINDER_CONV(PULL_FORALL))(SWAP_FORALL_CONV_2)(tm))
        | if Basics.is_imp(tm)
          | Equal.THENC(Equal.RAND_CONV(PULL_FORALL))(RIGHT_IMP_FORALL_CONV_2)(tm)
          | (if Basics.is_conj(tm) | Equal.THENC(Equal.BINOP_CONV(PULL_FORALL))(AND_FORALL_CONV_2)(tm) | Host.hol_apply_unit(fail))
      PULL_FORALL
  let pa_ident:
    fun(p):
      fun(arg_2):
        match arg_2
        | PairList [Host.Ident(s), & rest]:
            if p(s)
            | [s, rest]
            | match arg_2
              | _: Host.hol_raise(Host.Noparse())
        | _: Host.hol_raise(Host.Noparse())
  let pa_label_2 = pa_ident(Host.isalnum)
  let pa_var_2 = pa_ident(Host.isalpha)
  let fix_var_2 = (fun(v): Tactics.THEN(Tactics.CONV_TAC(NAME_PULL_FORALL_CONV_2(v)))(PURE_GEN_TAC_2))
  let fix_rename_2:
    fun
    | ([u, PairList [v, & PairList []]]): Tactics.THEN(Tactics.CONV_TAC(NAME_PULL_FORALL_CONV_2(v)))(NAME_GEN_TAC_2(u))
    | ([u, _]): NAME_GEN_TAC_2(u)
  let oname = Host.possibly(Host.parser_map(Host.parser_sequence(Host.a(Host.Ident("/")))(pa_var_2))(snd))
  let pa_rename = Host.parser_map(Host.parser_sequence(Host.parser_sequence(Host.parser_map(Host.parser_sequence(Host.a(Host.Resword("[")))(pa_var_2))(snd))(oname))(Host.a(Host.Resword("]"))))(fst)
  let vars_2 = Host.parser_map(Host.many(Host.parser_choice(Host.parser_map(pa_rename)(fix_rename_2))(Host.parser_map(pa_var_2)(fix_var_2))))(Tactics.EVERY)
  let star_2 = Host.possibly(Host.parser_map(Host.a(Host.Ident("*")))(Host.hol_apply_unit(K)))
  let fix_tac_2:
    Host.parser_map(Host.parser_sequence(vars_2)(star_2))(
      fun
      | ([tac, PairList []]): tac
      | ([tac, _]): Tactics.THEN(tac)(Tactics.REPEAT(Tactics.GEN_TAC)))
  let OBTAINL_THEN = o(Tactics.EVERY_TCL)(map(OBTAIN_THEN_2))
  fun destruct_2(inp): disj_2(inp)
  fun disj_2(inp):
    let DISJ_CASES_LIST = end_itlist(Tactics.DISJ_CASES_THEN2)
    Host.parser_map(Host.listof(conj_2)(Host.a(Host.Resword("|")))("Disjunction"))(DISJ_CASES_LIST)(inp)
  fun conj_2(inp): Host.parser_map(Host.atleast(1)(atom_2))(end_itlist(Tactics.CONJUNCTS_THEN2))(inp)
  fun obtain_2(inp):
    let var_list = Host.atleast(1)(pa_var_2)
    let obtain_prfx = Host.parser_map(Host.parser_sequence(Host.parser_map(Host.parser_sequence(Host.a(Host.Ident("@")))(var_list))(snd))(Host.a(Host.Resword("."))))(fst)
    Host.parser_map(Host.parser_sequence(obtain_prfx)(destruct_2))(uncurry(OBTAINL_THEN))(inp)
  fun atom_2(inp):
    let label_2:
      fun(arg_3):
        match arg_3
        | PairList [Host.Ident("_"), & res]: [K(Tactics.ALL_TAC), res]
        | PairList [Host.Ident("+"), & res]: [Tactics.MP_TAC, res]
        | PairList [Host.Ident(s), & res]:
            if Host.isalnum(s)
            | [Tactics.LABEL_TAC(s), res]
            | match arg_3
              | _: Host.hol_raise(Host.Noparse())
        | _: Host.hol_raise(Host.Noparse())
    let paren_2 = Host.parser_map(Host.parser_sequence(Host.parser_map(Host.parser_sequence(Host.a(Host.Resword("(")))(destruct_2))(snd))(Host.a(Host.Resword(")"))))(fst)
    Host.parser_choice(Host.parser_choice(obtain_2)(label_2))(paren_2)(inp)
  let destruct_tac_2 = destruct_2
  let number_2:
    fun
    | (PairList [Host.Ident(s), & rest]):
        try:
          [Host.check(Host.hol_le(1))(Host.hol_int_of_string(s)), rest]
          ~catch exn:
            match exn
            | Failure(_): Host.hol_raise(Host.Noparse())
            | exn: Host.hol_raise(exn)
    | (_): Host.hol_raise(Host.Noparse())
  let pa_fix_2 = Host.parser_map(Host.parser_sequence(Host.a(Host.Ident("!")))(fix_tac_2))(snd)
  let pa_dest_2 = Host.parser_map(destruct_tac_2)(Tactics.DISCH_THEN)
  let pa_prefix = Host.elistof(Host.parser_choice(pa_fix_2)(pa_dest_2))(Host.a(Host.Resword(";")))("Prefix intro pattern")
  fun pa_intro_2(toks): Host.parser_map(Host.parser_map(Host.parser_sequence(pa_prefix)(Host.possibly(pa_postfix_2)))(uncurry(append)))(Tactics.EVERY)(toks)
  fun pa_postfix_2(toks): Host.parser_choice(pa_conj_2)(pa_disj_2)(toks)
  fun pa_conj_2(toks):
    let conjs = Host.parser_map(Host.listof(pa_intro_2)(Host.a(Host.Ident("&")))("Intro pattern"))(CONJ_LIST_TAC_2)
    Host.parser_map(Host.parser_sequence(Host.parser_map(Host.parser_sequence(Host.a(Host.Resword("{")))(conjs))(snd))(Host.a(Host.Resword("}"))))(fst)(toks)
  fun pa_disj_2(toks):
    let disj = Host.parser_map(number_2)(NUM_DISJ_TAC_2)
    Host.parser_map(Host.parser_sequence(Host.parser_map(Host.parser_sequence(Host.a(Host.Ident("#")))(disj))(snd))(pa_intro_2))(uncurry(Tactics.THEN))(toks)
  let intro_tac = pa_intro_2
  let hyp_tac:
    fun(rule):
      let pa_action:
        fun
        | (PairList [Host.Resword(":"), & rest]): [Tactics.REMOVE_THEN, rest]
        | (PairList [Host.Resword("->"), & rest]): [Tactics.USE_THEN, rest]
        | (_): Host.hol_raise(Host.Noparse())
      Host.parser_map(Host.parser_sequence(pa_label_2)(Host.possibly(Host.parser_sequence(pa_action)(destruct_tac_2))))(
        fun
        | ([lbl, PairList [[action, tac], & PairList []]]): action(lbl)(o(tac)(rule))
        | ([lbl, _]): Tactics.REMOVE_THEN(lbl)(o(Tactics.LABEL_TAC(lbl))(rule)))
  let DESTRUCT_TAC_2:
    fun(s):
      let [tac, rest] = o(o(Host.fix("Destruct pattern")(destruct_tac_2))(Host.lex))(explode)(s)
      (if Host.hol_equal(rest)(PairList []) | tac | failwith("Garbage after destruct pattern"))
  let INTRO_TAC_2:
    fun(s):
      let [tac, rest] = o(o(Host.fix("Introduction pattern")(intro_tac))(Host.lex))(explode)(s)
      (if Host.hol_equal(rest)(PairList []) | tac | failwith("Garbage after intro pattern"))
  let FIX_TAC_2:
    fun(s):
      let [tac, rest] = o(o(fix_tac_2)(Host.lex))(explode)(s)
      (if Host.hol_equal(rest)(PairList []) | tac | failwith("FIX_TAC: invalid pattern"))
  let HYP_TAC_2:
    fun(s):
      fun(rule):
        let [tac, rest] = o(o(hyp_tac(rule))(Host.lex))(explode)(s)
        (if Host.hol_equal(rest)(PairList []) | tac | failwith("HYP_TAC: invalid pattern"))
  [DESTRUCT_TAC_2, FIX_TAC_2, INTRO_TAC_2, HYP_TAC_2]

fun CLAIM_TAC(s): (fun(tm): Tactics.SUBGOAL_THEN(tm)(DESTRUCT_TAC(s)))
