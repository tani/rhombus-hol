def WF:
  new_definition(
    (hol:
       var WF :: (A -> A -> bool) -> bool
       var ll as "<<" :: A -> A -> bool
       WF(ll)
         <=> (forall P :: A -> bool:
                (exists x :: A: P(x)) ==> (exists x :: A: P(x) && (forall y :: A: ll(y, x) ==> !P(y)))))
  )

