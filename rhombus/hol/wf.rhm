                                    (
                                      (
                                        (
                                          (
                                            (
                                              (
                                                (
                                                  (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [WF])) then_tac \
                                                  STRIP_TAC
                                                ) then_tac \
                                                X_GEN_TAC(@hol|{P:A#B->bool}|)
                                              ) then_tac \
                                              REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM])
                                            ) then_tac \
                                            GEN_REWRITE_TAC(I)(PairList [FORALL_PAIR_THM])
                                          ) then_tac \
                                          MAP_EVERY(X_GEN_TAC)(PairList [@hol|{a0:A}|, @hol|{b0:B}|])
                                        ) then_tac \
                                        DISCH_TAC
                                      ) then_tac \
                                      FIRST_X_ASSUM(
                                        o(MP_TAC)(
                                          SPEC(
                                            @hol|{\a:A. ?b:B. P(a,b)}|
                                          )
                                        )
                                      )
                                    ) then_tac \
                                    REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM])
                                  ) then_tac \
                                  DISCH_THEN(
                                    o(MP_TAC)(
                                      SPECL(PairList [@hol|{a0:A}|, @hol|{b0:B}|])
                                    )
                                  )
                                ) then_tac \
                                ASM_REWRITE_TAC(PairList [])
                              ) then_tac \
                              DISCH_THEN(
                                X_CHOOSE_THEN(@hol|{a:A}|)(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC))
                              )
                            ) then_tac \
                            DISCH_THEN(X_CHOOSE_TAC(@hol|{b1:B}|))
                          ) then_tac \
                          FIRST_X_ASSUM(
                            o(MP_TAC)(
                              SPECL(
                                PairList [
                                  @hol|{a:A}|,
                                  @hol|{\b. (P:A#B->bool) (a,b)}|
                                ]
                              )
                            )
                          )
                        ) then_tac \
                        REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM])
                      ) then_tac \
                      DISCH_THEN(o(MP_TAC)(SPEC(@hol|{b1:B}|)))
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_tac \
                  DISCH_THEN(
                    X_CHOOSE_THEN(@hol|{b:B}|)(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC))
                  )
                ) then_tac \
                DISCH_TAC
              ) then_tac \
              EXISTS_TAC(
                @hol|{(a:A,b:B)}|
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          REWRITE_TAC(PairList [FORALL_PAIR_THM])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def WF_LEX:
  prove(
    [
      @hol|{!R:A->A->bool S:B->B->bool. WF(R) /\ WF(S)
         ==> WF(\(r1,s1) (r2,s2). R r1 r2 \/ (r1 = r2) /\ S s1 s2)}|,
      SIMP_TAC(PairList [WF_LEX_DEPENDENT, ETA_AX])
    ]
  )

def WF_POINTWISE:
  prove(
    [
      @hol|{WF((<<) :A->A->bool) /\ WF((<<<) :B->B->bool)
         ==> WF(\(x1,y1) (x2,y2). x1 << x2 /\ y1 <<< y2)}|,
      (
        (
          (
            (STRIP_TAC then_tac MATCH_MP_TAC(WF_SUBSET)) then_tac \
            EXISTS_TAC(
              @hol|{\(x1,y1) (x2,y2). x1 << x2 \/ (x1:A = x2) /\ (y1:B) <<< (y2:B)}|
            )
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (REWRITE_TAC(PairList [FORALL_PAIR_THM]) then_tac CONV_TAC(TAUT)),
          (MATCH_MP_TAC(WF_LEX) then_tac ASM_REWRITE_TAC(PairList []))
        ]
      )
    ]
  )

def WF_num:
  prove(
    [
      @hol|{WF(<)}|,
      REWRITE_TAC(PairList [WF_IND, num_WF])
    ]
  )

def WF_REC_num:
  prove(
    [
      @hol|{!H. (!f g n. (!m. m < n ==> (f m = g m)) ==> (H f n = H g n))
         ==> ?f:num->A. !n. f n = H f n}|,
      MATCH_ACCEPT_TAC(MATCH_MP(WF_REC)(WF_num))
    ]
  )

def MEASURE:
  new_definition(
    @hol|{MEASURE (m:A->num) = \x y. m(x) < m(y)}|
  )

def WF_MEASURE:
  prove(
    [
      @hol|{!m:A->num. WF(MEASURE m)}|,
      (
        (
          (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [MEASURE])) then_tac \
          MATCH_MP_TAC(WF_MEASURE_GEN)
        ) then_tac \
        MATCH_ACCEPT_TAC(WF_num)
      )
    ]
  )

def MEASURE_LE:
  prove(
    [
      @hol|{!m:A->num. (!y. MEASURE m y a ==> MEASURE m y b) <=> m(a) <= m(b)}|,
      (
        REWRITE_TAC(PairList [MEASURE]) then_tac \
        MESON_TAC(PairList [NOT_LE, LTE_TRANS, LT_REFL])
      )
    ]
  )

def WF_ANTISYM:
  prove(
    [
      @hol|{!(<<) x y:A. WF(<<) ==> ~(x << y /\ y << x)}|,
      (
        (
          (
            REPEAT(STRIP_TAC) then_tac \
            FIRST_X_ASSUM(o(MP_TAC)(GEN_REWRITE_RULE(I)(PairList [WF])))
          ) then_tac \
          DISCH_THEN(
            o(MP_TAC)(
              SPEC(
                @hol|{\z:A. z = x \/ z = y}|
              )
            )
          )
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def WF_REFL:
  prove(
    [
      @hol|{!x:A. WF(<<) ==> ~(x << x)}|,
      MESON_TAC(PairList [WF_ANTISYM])
    ]
  )

def WF_FALSE:
  prove(
    [
      @hol|{WF(\x y:A. F)}|,
      REWRITE_TAC(PairList [WF])
    ]
  )

def MINIMAL_BAD_SEQUENCE:
  prove(
    [
      @hol|{!(<<) (bad:(num->A)->bool).
         WF(<<) /\
         (!x. ~bad x ==> ?n. !y. (!k. k < n ==> y k = x k) ==> ~bad y) /\
         (?x. bad x)
          ==> ?y. bad y /\
                  !z n. bad z /\ (!k. k < n ==> z k = y k) ==> ~(z n << y n)}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (REPEAT(GEN_TAC) then_tac DISCH_TAC) then_tac \
                                  SUBGOAL_THEN(
                                    @hol|{?x:num->A. !n. (?y. bad y /\ (!k. k < n ==> y k = x k) /\ y n = x n) /\
                                       !z. bad z /\ (!k. k < n ==> z k = x k) ==> ~(z n << x n)}|
                                  )(MP_TAC)
                                ) then_list \
                                PairList [
                                  (MATCH_MP_TAC(MATCH_MP(WF_REC_EXISTS)(WF_num)) then_tac SIMP_TAC(PairList [])),
                                  (MATCH_MP_TAC(MONO_EXISTS) then_tac ASM_MESON_TAC(PairList []))
                                ]
                              ) then_tac \
                              MAP_EVERY(X_GEN_TAC)(PairList [@hol|{x:num->A}|, @hol|{n:num}|])
                            ) then_tac \
                            DISCH_TAC
                          ) then_tac \
                          REWRITE_TAC(
                            PairList [
                              MESON(
                                PairList [])(
                                @hol|{(?a. (?y. P y /\ Q y /\ f y = a) /\ (!z. A z ==> ~B a z)) <=>
                                   ?y. (P y /\ Q y) /\ (!z. B (f y) z ==> ~A z)}|
                              )
                            ]
                          )
                        ) then_tac \
                        MP_TAC(
                          ISPECL(
                            PairList [
                              @hol|{(<<):A->A->bool}|,
                              @hol|{\x:num->A. x n}|
                            ])(
                            WF_MEASURE_GEN
                          )
                        )
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_tac \
                    REWRITE_TAC(PairList [WF])
                  ) then_tac \
                  DISCH_THEN(MATCH_MP_TAC)
                ) then_tac \
                POP_ASSUM_LIST(o(MP_TAC)(end_itlist(CONJ)))
              ) then_tac \
              SPEC_TAC([@hol|{n:num}|, @hol|{n:num}|])
            ) then_tac \
            INDUCT_TAC
          ) then_tac \
          SIMP_TAC(PairList [LT])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def WF_REC_TAIL:
  let lemma1_2:
    prove(
      [
        @hol|{~(P 0) ==> ((?n. P(SUC n)) <=> (?n. P(n)))}|,
        MESON_TAC(PairList [num_CASES, NOT_SUC])
      ]
    )
  let lemma2_2:
    prove(
      [
        @hol|{(P 0) ==> ((!m. m < n ==> P(SUC m)) <=> (!m. m < SUC n ==> P(m)))}|,
        (
          (REPEAT((DISCH_TAC or_tac EQ_TAC)) then_tac INDUCT_TAC) then_tac \
          ASM_MESON_TAC(PairList [LT_SUC, LT_0])
        )
      ]
    )
  prove(
    [
      @hol|{!P g h. ?f:A->B. !x. f x = if P(x) then f(g x) else h x}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(GEN_TAC) then_tac \
                          MP_TAC(
                            GEN(@hol|{x:A}|)(
                              ISPECL(
                                PairList [
                                  @hol|{x:A}|,
                                  @hol|{\y:A n:num. g(y):A}|
                                ])(
                                num_RECURSION
                              )
                            )
                          )
                        ) then_tac \
                        REWRITE_TAC(PairList [SKOLEM_THM, FORALL_AND_THM])
                      ) then_tac \
                      DISCH_THEN(
                        X_CHOOSE_THEN(@hol|{s:A->num->A}|)(STRIP_ASSUME_TAC)
                      )
                    ) then_tac \
                    EXISTS_TAC(
                      @hol|{\x:A. if ?n:num. ~P(s x n)
                         then (h:A->B)(@y. ?n. (y = s x n) /\ ~P(s x n) /\
                                               !m. m < n ==> P(s x m))
                         else something_arbitrary:B}|
                    )
                  ) then_tac \
                  X_GEN_TAC(@hol|{x:A}|)
                ) then_tac \
                SUBGOAL_THEN(
                  @hol|{!n x:A. s (g x) n :A = s x (SUC n)}|
                )(ASSUME_TAC)
              ) then_list \
              PairList [
                (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [])),
                UNDISCH_THEN(
                  @hol|{!x:A n. s x (SUC n) :A = g (s x n)}|
                )(K(ALL_TAC))
              ]
            ) then_tac \
            ASM_CASES_TAC(@hol|{(P:A->bool) x}|)
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_list \
        PairList [
          (
            (
              (
                (ASM_SIMP_TAC(PairList [lemma1_2]) then_tac COND_CASES_TAC) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              CONV_TAC(SYM_CONV)
            ) then_tac \
            ASM_SIMP_TAC(PairList [lemma2_2, lemma1_2])
          ),
          (
            (
              (
                (
                  (
                    (
                      (COND_CASES_TAC then_list PairList [ALL_TAC, ASM_MESON_TAC(PairList [])]) then_tac \
                      AP_TERM_TAC
                    ) then_tac \
                    MATCH_MP_TAC(SELECT_UNIQUE)
                  ) then_tac \
                  REWRITE_TAC(PairList [])
                ) then_tac \
                X_GEN_TAC(@hol|{y:A}|)
              ) then_tac \
              EQ_TAC
            ) then_list \
            PairList [
              (
                (
                  (SIMP_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac INDUCT_TAC) then_tac \
                  ASM_REWRITE_TAC(PairList [])
                ) then_tac \
                ASM_MESON_TAC(PairList [LT_0])
              ),
              ASM_MESON_TAC(PairList [LT])
            ]
          )
        ]
      )
    ]
  )

def WF_REC_TAIL_GENERAL:
  prove(
    [
      @hol|{!P G H. WF(<<) /\
         (!f g x. (!z. z << x ==> (f z = g z))
                  ==> (P f x <=> P g x) /\ G f x = G g x /\ H f x = H g x) /\
         (!f g x. (!z. z << x ==> (f z = g z)) ==> (H f x = H g x)) /\
         (!f x y. P f x /\ y << G f x ==> y << x)
         ==> ?f:A->B. !x. f x = if P f x then f(G f x) else H f x}|,
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(STRIP_TAC) then_tac \
                    CHOOSE_THEN(MP_TAC)(
                      prove_inductive_relations_exist(
                        @hol|{(!x:A. ~(P f x) ==> terminates f x) /\
                           (!x. P (f:A->B) x /\ terminates f (G f x) ==> terminates f x)}|
                      )
                    )
                  ) then_tac \
                  REWRITE_TAC(PairList [FORALL_AND_THM])
                ) then_tac \
                DISCH_THEN(o(STRIP_ASSUME_TAC)(GSYM))
              ) then_tac \
              SUBGOAL_THEN(
                @hol|{?while. !f:A->B x:A. while f x = if P f x then while f (G f x) else x}|
              )(o(STRIP_ASSUME_TAC)(GSYM))
            ) then_list \
            PairList [
              REWRITE_TAC(PairList [GSYM(SKOLEM_THM), WF_REC_TAIL]),
              ALL_TAC
            ]
          ) then_tac \
          SUBGOAL_THEN(
            @hol|{?f:A->B. !x. f x = if terminates f x then H f (while f x :A) else anything}|
          )(MP_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                (
                  FIRST_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(WF_REC))) then_tac \
                  REPEAT(STRIP_TAC)
                ) then_tac \
                MATCH_MP_TAC(
                  MESON(
                    PairList [])(
                    @hol|{(a = b) /\ (a /\ b ==> (x = y) /\ (f x = g x))
                       ==> ((if a then f x else d) = (if b then g y else d))}|
                  )
                )
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_list \
            PairList [
              (
                (
                  (
                    (
                      (
                        (
                          (
                            SUBGOAL_THEN(
                              @hol|{!f g x.
                                 (!x y. P f x /\ y << G (f:A->B) x ==> y << x) /\
                                 (!y:A. (!z:A. z << y ==> z << x)
                                        ==> (P f y = P g y) /\ (G f y = G g y))
                                     ==> terminates f x ==> terminates g x}|
                            )(
                              (fun(th): ((EQ_TAC then_tac MATCH_MP_TAC(th)) then_tac ASM_MESON_TAC(PairList [])))
                            ) then_tac \
                            GEN_TAC
                          ) then_tac \
                          GEN_TAC
                        ) then_tac \
                        REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM, IMP_CONJ])
                      ) then_tac \
                      DISCH_TAC
                    ) then_tac \
                    ONCE_REWRITE_TAC(
                      PairList [
                        TAUT(
                          @hol|{a ==> b ==> c <=> b ==> a ==> c}|
                        )
                      ]
                    )
                  ) then_tac \
                  FIRST_X_ASSUM(MATCH_MP_TAC)
                ) then_tac \
                ASM_MESON_TAC(PairList [])
              ),
              (
                (
                  (
                    SUBGOAL_THEN(
                      @hol|{!x:A. terminates (f:A->B) x /\
                         (!y:A. (!z:A. z << y ==> z << x)
                                ==> (P f y <=> P g y) /\ (G f y :A = G g y))
                         ==> (while f x :A = while g x)}|
                    )((fun(th): (MATCH_MP_TAC(th) then_tac ASM_MESON_TAC(PairList [])))) then_tac \
                    REWRITE_TAC(PairList [IMP_CONJ])
                  ) then_tac \
                  FIRST_X_ASSUM(MATCH_MP_TAC)
                ) then_tac \
                ASM_MESON_TAC(PairList [])
              ),
              (
                (
                  (
                    (
                      (
                        FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
                        SUBGOAL_THEN(
                          @hol|{!f:A->B. (!x:A y:A. P f x /\ y << G f x ==> y << x)
                             ==> !x. terminates f x ==> !y. y << while f x ==> y << x}|
                        )((fun(th): ASM_MESON_TAC(PairList [th])))
                      ) then_tac \
                      GEN_TAC
                    ) then_tac \
                    DISCH_TAC
                  ) then_tac \
                  FIRST_X_ASSUM(MATCH_MP_TAC)
                ) then_tac \
                ASM_MESON_TAC(PairList [])
              )
            ]
          ),
          (
            (
              (
                (
                  (
                    (MATCH_MP_TAC(MONO_EXISTS) then_tac GEN_TAC) then_tac \
                    DISCH_THEN((fun(th): (ASSUME_TAC(GSYM(th)) then_tac MP_TAC(th))))
                  ) then_tac \
                  MATCH_MP_TAC(MONO_FORALL)
                ) then_tac \
                X_GEN_TAC(@hol|{x:A}|)
              ) then_tac \
              ASM_CASES_TAC(
                @hol|{P (f:A->B) (x:A) :bool}|
              )
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

def WF_INDUCT_TAC:
  let pth:
    prove(
      [
        @hol|{(!x. P x ==> !y. Q x y) <=> !y x. P x ==> Q x y}|,
        MESON_TAC(PairList [])
      ]
    )
  let qqconv_2 = GEN_REWRITE_CONV(I)(PairList [pth])
  let pth:
    prove(
      [
        @hol|{(!m. P m ==> (m = e) ==> Q) <=> (P e ==> Q)}|,
        MESON_TAC(PairList [])
      ]
    )
  let eqconv_2 = REWR_CONV(pth)
  fun qqconvs(tm):
    try:
      (qqconv_2 then_conv BINDER_CONV(qqconvs))(tm)
      ~catch exn:
        match exn
        | Failure(_): eqconv_2(tm)
        | exn: (throw exn)
  fun(tm):
    fun([asl, w] as gl):
      let fvs_2 = frees(tm)
      let gv_2 = genvar(type_of(tm))
      let pat = list_mk_forall([PairList [gv_2, & fvs_2], mk_imp([mk_eq([gv_2, tm]), w])])
      let th0 = UNDISCH(PART_MATCH(rand)(num_WF)(pat))
      let th1 = MP(SPECL(PairList [tm, & fvs_2])(th0))(REFL(tm))
      let th2 = CONV_RULE(LAND_CONV(qqconvs))(DISCH_ALL(th1))
      (
        (
          (MATCH_MP_TAC(th2) then_tac MAP_EVERY(X_GEN_TAC)(fvs_2)) then_tac \
          CONV_TAC(LAND_CONV(qqconvs))
        ) then_tac \
        DISCH_THEN(ASSUME_TAC)
      )(gl)
