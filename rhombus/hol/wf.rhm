def WF:
  new_definition(
    @hol|{WF(<<) <=> !P:A->bool. (?x. P(x)) ==> (?x. P(x) /\ !y. y << x ==> ~P(y))}|
  )

def WF_EQ:
  prove(
    [
      @hol|{WF(<<) <=> !P:A->bool. (?x. P(x)) <=> (?x. P(x) /\ !y. y << x ==> ~P(y))}|,
      (REWRITE_TAC(PairList [WF]) then_tac MESON_TAC(PairList []))
    ]
  )

def WF_IND:
  prove(
    [
      @hol|{WF(<<) <=> !P:A->bool. (!x. (!y. y << x ==> P(y)) ==> P(x)) ==> !x. P(x)}|,
      (
        (
          (
            (
              ((REWRITE_TAC(PairList [WF]) then_tac EQ_TAC) then_tac DISCH_TAC) then_tac \
              GEN_TAC
            ) then_tac \
            POP_ASSUM(
              o(MP_TAC)(
                SPEC(@hol|{\x:A. ~P(x)}|)
              )
            )
          ) then_tac \
          REWRITE_TAC(PairList [])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def WF_DCHAIN:
  prove(
    [
      @hol|{WF(<<) <=> ~(?s:num->A. !n. s(SUC n) << s(n))}|,
      (
        (
          (
            REWRITE_TAC(
              PairList [
                WF,
                TAUT(
                  @hol|{(a <=> ~b) <=> (~a <=> b)}|
                ),
                NOT_FORALL_THM
              ]
            ) then_tac \
            EQ_TAC
          ) then_tac \
          DISCH_THEN(CHOOSE_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                POP_ASSUM(o(MP_TAC)(REWRITE_RULE(PairList [NOT_IMP]))) then_tac \
                                DISCH_THEN(
                                  CONJUNCTS_THEN2(X_CHOOSE_TAC(@hol|{a:A}|))(ASSUME_TAC)
                                )
                              ) then_tac \
                              SUBGOAL_THEN(
                                @hol|{!x:A. ?y. P(x) ==> P(y) /\ y << x}|
                              )(MP_TAC)
                            ) then_list \
                            PairList [ASM_MESON_TAC(PairList []), REWRITE_TAC(PairList [SKOLEM_THM])]
                          ) then_tac \
                          DISCH_THEN(
                            X_CHOOSE_THEN(@hol|{f:A->A}|)(STRIP_ASSUME_TAC)
                          )
                        ) then_tac \
                        CHOOSE_TAC(
                          prove_recursive_functions_exist(num_RECURSION)(
                            @hol|{(s(0) = a:A) /\ (!n. s(SUC n) = f(s n))}|
                          )
                        )
                      ) then_tac \
                      EXISTS_TAC(@hol|{s:num->A}|)
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_tac \
                  SUBGOAL_THEN(
                    @hol|{!n. P(s n) /\ s(SUC n):A << s(n)}|
                  )((fun(th): ASM_MESON_TAC(PairList [th])))
                ) then_tac \
                INDUCT_TAC
              ) then_tac \
              ASM_REWRITE_TAC(PairList [])
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          ),
          (
            (
              EXISTS_TAC(
                @hol|{\y:A. ?n:num. y = s(n)}|
              ) then_tac \
              REWRITE_TAC(PairList [])
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

def WF_DHAIN_TRANSITIVE:
  prove(
    [
      @hol|{!(<<):A->A->bool.
         (!x y z. x << y /\ y << z ==> x << z)
         ==> (WF(<<) <=> ~(?s:num->A. !i j. i < j ==> s j << s i))}|,
      (
        (
          (
            (
              (
                (
                  (
                    (
                      ((GEN_TAC then_tac DISCH_TAC) then_tac REWRITE_TAC(PairList [WF_DCHAIN])) then_tac \
                      AP_TERM_TAC
                    ) then_tac \
                    EQ_TAC
                  ) then_tac \
                  MATCH_MP_TAC(MONO_EXISTS)
                ) then_tac \
                X_GEN_TAC(@hol|{s:num->A}|)
              ) then_tac \
              SIMP_TAC(PairList [LT])
            ) then_tac \
            DISCH_TAC
          ) then_tac \
          MATCH_MP_TAC(TRANSITIVE_STEPWISE_LT)
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def WF_UREC:
  prove(
    [
      @hol|{WF(<<) ==>
         !H. (!f g x. (!z. z << x ==> (f z = g z)) ==> (H f x = H g x))
              ==> !(f:A->B) g. (!x. f x = H f x) /\ (!x. g x = H g x)
                                ==> (f = g)}|,
      (
        (
          (
            (
              (
                (REWRITE_TAC(PairList [WF_IND]) then_tac REPEAT(STRIP_TAC)) then_tac \
                REWRITE_TAC(PairList [FUN_EQ_THM])
              ) then_tac \
              FIRST_ASSUM(MATCH_MP_TAC)
            ) then_tac \
            GEN_TAC
          ) then_tac \
          DISCH_THEN(ANTE_RES_THEN(MP_TAC))
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def WF_UREC_WF:
  prove(
    [
      @hol|{(!H. (!f g x. (!z. z << x ==> (f z = g z)) ==> (H f x = H g x))
              ==> !(f:A->bool) g. (!x. f x = H f x) /\ (!x. g x = H g x)
                                ==> (f = g))
         ==> WF(<<)}|,
      (
        (
          (
            (
              (
                ((REWRITE_TAC(PairList [WF_IND]) then_tac DISCH_TAC) then_tac GEN_TAC) then_tac \
                DISCH_TAC
              ) then_tac \
              FIRST_X_ASSUM(
                o(MP_TAC)(
                  SPEC(
                    @hol|{\f x. P(x:A) \/ !z:A. z << x ==> f(z)}|
                  )
                )
              )
            ) then_tac \
            REWRITE_TAC(PairList [])
          ) then_tac \
          W(
            o(
              o(C(SUBGOAL_THEN)((fun(t): REWRITE_TAC(PairList [t]))))(funpow(2)(lhand))
            )(snd)
          )
        ) then_list \
        PairList [
          MESON_TAC(PairList []),
          (
            (
              DISCH_THEN(
                o(MP_TAC)(
                  SPECL(
                    PairList [
                      @hol|{P:A->bool}|,
                      @hol|{\x:A. T}|
                    ]
                  )
                )
              ) then_tac \
              REWRITE_TAC(PairList [FUN_EQ_THM])
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

def WF_REC_INVARIANT:
  let lemma:
    prove_inductive_relations_exist(
      @hol|{!f:A->B x. (!z. z << x ==> R z (f z)) ==> R x (H f x)}|
    )
  prove(
    [
      @hol|{WF(<<)
         ==> !H S. (!f g x. (!z. z << x ==> (f z = g z) /\ S z (f z))
                            ==> (H f x = H g x) /\ S x (H f x))
                   ==> ?f:A->B. !x. (f x = H f x)}|,
      (
        (
          (
            (
              (
                (
                  (
                    (REWRITE_TAC(PairList [WF_IND]) then_tac REPEAT(STRIP_TAC)) then_tac \
                    X_CHOOSE_THEN(@hol|{R:A->B->bool}|)(STRIP_ASSUME_TAC)(lemma)
                  ) then_tac \
                  SUBGOAL_THEN(
                    @hol|{!x:A. ?!y:B. R x y}|
                  )((fun(th): ASM_MESON_TAC(PairList [th])))
                ) then_tac \
                FIRST_X_ASSUM(MATCH_MP_TAC)
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            FIRST_X_ASSUM((fun(th): GEN_REWRITE_TAC(BINDER_CONV)(PairList [th])))
          ) then_tac \
          SUBGOAL_THEN(
            @hol|{!x:A y:B. R x y ==> S x y}|
          )(MP_TAC)
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def WF_REC:
  prove(
    [
      @hol|{WF(<<)
         ==> !H. (!f g x. (!z. z << x ==> (f z = g z)) ==> (H f x = H g x))
                 ==> ?f:A->B. !x. f x = H f x}|,
      (
        (
          (
            REPEAT(STRIP_TAC) then_tac \
            FIRST_X_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(WF_REC_INVARIANT)))
          ) then_tac \
          EXISTS_TAC(@hol|{\x:A y:B. T}|)
        ) then_tac \
        ASM_REWRITE_TAC(PairList [])
      )
    ]
  )

def WF_REC_WF:
  prove(
    [
      @hol|{(!H. (!f g x. (!z. z << x ==> (f z = g z)) ==> (H f x = H g x))
                       ==> ?f:A->num. !x. f x = H f x)
         ==> WF(<<)}|,
      (
        (
          (
            (
