def WF_REC_num:
  prove(
    [
      Host.hol_term(Forall(
        "H",
        Fun(Fun(Num, Tvar("A")), Fun(Num, Tvar("A"))),
        Implies(
          Forall(
            "f",
            Fun(Num, Tvar("A")),
            Forall(
              "g",
              Fun(Num, Tvar("A")),
              Forall(
                "n",
                Num,
                Implies(
                  Forall(
                    "m",
                    Num,
                    Implies(
                      App(Const("<", Fun(Num, Fun(Num, Bool))), [Ref("m"), Ref("n")]),
                      Eq(Tvar("A"), App(Ref("f"), [Ref("m")]), App(Ref("g"), [Ref("m")]))
                    )
                  ),
                  Eq(Tvar("A"), App(Ref("H"), [Ref("f"), Ref("n")]), App(Ref("H"), [Ref("g"), Ref("n")]))
                )
              )
            )
          ),
          Exists(
            "f",
            Fun(Num, Tvar("A")),
            Forall("n", Num, Eq(Tvar("A"), App(Ref("f"), [Ref("n")]), App(Ref("H"), [Ref("f"), Ref("n")])))
          )
        )
      )),
      MATCH_ACCEPT_TAC(MATCH_MP(WF_REC)(WF_num))
    ]
  )

