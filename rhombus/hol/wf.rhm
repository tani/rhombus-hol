def MINIMAL_BAD_SEQUENCE:
  prove(
    [
      (hol:
         const WF :: (A -> A -> bool) -> bool
         forall (ll as "<<" :: A -> A -> bool, bad :: (num -> A) -> bool):
           (WF(ll)
              && ((forall x :: num -> A:
                     !bad(x)
                       ==> (exists n :: num:
                              forall y :: num -> A:
                                (forall k :: num: k < n ==> y(k) == x(k)) ==> !bad(y)))
                    && (exists x :: num -> A: bad(x))))
             ==> (exists y :: num -> A:
                    bad(y)
                      && (forall (z :: num -> A, n :: num):
                            bad(z) && (forall k :: num: k < n ==> z(k) == y(k)) ==> !ll(z(n), y(n))))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (REPEAT(GEN_TAC) then_tac DISCH_TAC) then_tac \
                                  SUBGOAL_THEN(
                                    (hol:
                                       var bad :: (num -> A) -> bool
                                       var ll as "<<" :: A -> A -> bool
                                       exists x :: num -> A:
                                         forall n :: num:
                                           (exists y :: num -> A:
                                              bad(y) && ((forall k :: num: k < n ==> y(k) == x(k)) && y(n) == x(n)))
                                             && (forall z :: num -> A:
                                                   bad(z) && (forall k :: num: k < n ==> z(k) == x(k)) ==> !ll(z(n), x(n))))
                                  )(MP_TAC)
                                ) then_list \
                                PairList [
                                  (MATCH_MP_TAC(MATCH_MP(WF_REC_EXISTS)(WF_num)) then_tac SIMP_TAC(PairList [])),
                                  (MATCH_MP_TAC(MONO_EXISTS) then_tac ASM_MESON_TAC(PairList []))
                                ]
                              ) then_tac \
                              MAP_EVERY(X_GEN_TAC)(PairList [(hol: var x :: num -> A; x), (hol: var n :: num; n)])
                            ) then_tac \
                            DISCH_TAC
                          ) then_tac \
                          REWRITE_TAC(
                            PairList [
                              MESON(
                                PairList [])(
                                (hol:
                                   var P :: #{?25504} -> bool
                                   var Q :: #{?25504} -> bool
                                   var f :: #{?25504} -> #{?25503}
                                   var A :: #{?25506} -> bool
                                   var B :: #{?25503} -> #{?25506} -> bool
                                   (exists a :: #{?25503}:
                                      (exists y :: #{?25504}: P(y) && (Q(y) && f(y) == a))
                                        && (forall z :: #{?25506}: A(z) ==> !B(a, z)))
                                     <=> (exists y :: #{?25504}: P(y) && Q(y) && (forall z :: #{?25506}: B(f(y), z) ==> !A(z))))
                              )
                            ]
                          )
                        ) then_tac \
                        MP_TAC(
                          ISPECL(
                            PairList [
                              (hol: var ll as "<<" :: A -> A -> bool; ll),
                              (hol:
                                 var n :: num
                                 fun (x :: num -> A): x(n))
                            ])(
                            WF_MEASURE_GEN
                          )
                        )
                      ) then_tac \
                      ASM_REWRITE_TAC(PairList [])
                    ) then_tac \
                    REWRITE_TAC(PairList [WF])
                  ) then_tac \
                  DISCH_THEN(MATCH_MP_TAC)
                ) then_tac \
                POP_ASSUM_LIST(o(MP_TAC)(end_itlist(CONJ)))
              ) then_tac \
              SPEC_TAC([(hol: var n :: num; n), (hol: var n :: num; n)])
            ) then_tac \
            INDUCT_TAC
          ) then_tac \
          SIMP_TAC(PairList [LT])
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

def WF_REC_TAIL:
  let lemma1_2:
    prove(
      [
        (hol:
           var P :: num -> bool
           const SUC :: num -> num
           !P((0 :: num)) ==> ((exists n :: num: P(SUC(n))) <=> (exists n :: num: P(n)))),
        MESON_TAC(PairList [num_CASES, NOT_SUC])
      ]
    )
  let lemma2_2:
    prove(
      [
        (hol:
           var P :: num -> bool
           var n :: num
           const SUC :: num -> num
           P((0 :: num))
             ==> ((forall m :: num: m < n ==> P(SUC(m))) <=> (forall m :: num: m < SUC(n) ==> P(m)))),
        (
          (REPEAT((DISCH_TAC or_tac EQ_TAC)) then_tac INDUCT_TAC) then_tac \
          ASM_MESON_TAC(PairList [LT_SUC, LT_0])
        )
      ]
    )
  prove(
    [
      (hol:
         forall (P :: A -> bool, g :: A -> A, h :: A -> B):
           exists f :: A -> B: forall x :: A: f(x) == (if P(x) | f(g(x)) | h(x))),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          REPEAT(GEN_TAC) then_tac \
                          MP_TAC(
                            GEN(hol: var x :: A; x)(
                              ISPECL(
                                PairList [
                                  (hol: var x :: A; x),
                                  (hol:
                                     var g :: A -> A
                                     fun (y :: A, n :: num): g(y))
                                ])(
                                num_RECURSION
                              )
                            )
                          )
                        ) then_tac \
                        REWRITE_TAC(PairList [SKOLEM_THM, FORALL_AND_THM])
                      ) then_tac \
                      DISCH_THEN(
                        X_CHOOSE_THEN(hol: var s :: A -> num -> A; s)(STRIP_ASSUME_TAC)
                      )
                    ) then_tac \
                    EXISTS_TAC(
                      (hol:
                         var P :: A -> bool
                         var s :: A -> num -> A
                         var h :: A -> B
                         var something_arbitrary :: B
                         const select as "@" :: (A -> bool) -> A
                         fun (x :: A):
                           if (exists n :: num: !P(s(x, n)))
                           | h(
                               select(
                                 fun (y :: A):
                                   exists n :: num:
                                     y == s(x, n) && (!P(s(x, n)) && (forall m :: num: m < n ==> P(s(x, m))))
                               )
                             )
                           | something_arbitrary)
                    )
                  ) then_tac \
                  X_GEN_TAC(hol: var x :: A; x)
                ) then_tac \
                SUBGOAL_THEN(
                  (hol:
                     var s :: A -> num -> A
                     var g :: A -> A
                     const SUC :: num -> num
                     forall (n :: num, x :: A): s(g(x), n) == s(x, SUC(n)))
                )(ASSUME_TAC)
              ) then_list \
              PairList [
                (INDUCT_TAC then_tac ASM_REWRITE_TAC(PairList [])),
                UNDISCH_THEN(
                  (hol:
                     var s :: A -> num -> A
                     var g :: A -> A
                     const SUC :: num -> num
                     forall (x :: A, n :: num): s(x, SUC(n)) == g(s(x, n)))
                )(K(ALL_TAC))
              ]
            ) then_tac \
            ASM_CASES_TAC(hol:
                            var P :: A -> bool
                            var x :: A
                            P(x))
          ) then_tac \
          ASM_REWRITE_TAC(PairList [])
        ) then_list \
        PairList [
          (
            (
              (
                (ASM_SIMP_TAC(PairList [lemma1_2]) then_tac COND_CASES_TAC) then_tac \
                ASM_REWRITE_TAC(PairList [])
              ) then_tac \
              CONV_TAC(SYM_CONV)
            ) then_tac \
            ASM_SIMP_TAC(PairList [lemma2_2, lemma1_2])
          ),
          (
            (
              (
                (
                  (
                    (
                      (COND_CASES_TAC then_list PairList [ALL_TAC, ASM_MESON_TAC(PairList [])]) then_tac \
                      AP_TERM_TAC
                    ) then_tac \
                    MATCH_MP_TAC(SELECT_UNIQUE)
                  ) then_tac \
                  REWRITE_TAC(PairList [])
                ) then_tac \
                X_GEN_TAC(hol: var y :: A; y)
              ) then_tac \
              EQ_TAC
            ) then_list \
            PairList [
              (
                (
                  (SIMP_TAC(PairList [LEFT_IMP_EXISTS_THM]) then_tac INDUCT_TAC) then_tac \
                  ASM_REWRITE_TAC(PairList [])
                ) then_tac \
                ASM_MESON_TAC(PairList [LT_0])
              ),
              ASM_MESON_TAC(PairList [LT])
            ]
          )
        ]
      )
    ]
  )

def WF_REC_TAIL_GENERAL:
  prove(
    [
      (hol:
         var ll as "<<" :: A -> A -> bool
         const WF :: (A -> A -> bool) -> bool
         forall (P :: (A -> B) -> A -> bool, G :: (A -> B) -> A -> A, H :: (A -> B) -> A -> B):
           (WF(ll)
              && ((forall (f :: A -> B, g :: A -> B, x :: A):
                     (forall z :: A: ll(z, x) ==> f(z) == g(z))
                       ==> (P(f, x) <=> P(g, x)) && (G(f, x) == G(g, x) && H(f, x) == H(g, x)))
                    && ((forall (f :: A -> B, g :: A -> B, x :: A):
                           (forall z :: A: ll(z, x) ==> f(z) == g(z)) ==> H(f, x) == H(g, x))
                          && (forall (f :: A -> B, x :: A, y :: A):
                                P(f, x) && ll(y, G(f, x)) ==> ll(y, x)))))
             ==> (exists f :: A -> B: forall x :: A: f(x) == (if P(f, x) | f(G(f, x)) | H(f, x)))),
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(STRIP_TAC) then_tac \
                    CHOOSE_THEN(MP_TAC)(
                      prove_inductive_relations_exist(
                        (hol:
                           var P :: (A -> B) -> A -> bool
                           var f :: A -> B
                           var terminates :: (A -> B) -> A -> bool
                           var G :: (A -> B) -> A -> A
                           (forall x :: A: !P(f, x) ==> terminates(f, x))
                             && (forall x :: A: P(f, x) && terminates(f, G(f, x)) ==> terminates(f, x)))
                      )
                    )
                  ) then_tac \
                  REWRITE_TAC(PairList [FORALL_AND_THM])
                ) then_tac \
                DISCH_THEN(o(STRIP_ASSUME_TAC)(GSYM))
              ) then_tac \
              SUBGOAL_THEN(
                (hol:
                   var P :: (A -> B) -> A -> bool
                   var G :: (A -> B) -> A -> A
                   exists while :: (A -> B) -> A -> A:
                     forall (f :: A -> B, x :: A): while(f, x) == (if P(f, x) | while(f, G(f, x)) | x))
              )(o(STRIP_ASSUME_TAC)(GSYM))
            ) then_list \
            PairList [
              REWRITE_TAC(PairList [GSYM(SKOLEM_THM), WF_REC_TAIL]),
              ALL_TAC
            ]
          ) then_tac \
          SUBGOAL_THEN(
            (hol:
               var terminates :: (A -> B) -> A -> bool
               var H :: (A -> B) -> A -> B
               var while :: (A -> B) -> A -> A
               var anything :: B
               exists f :: A -> B:
                 forall x :: A: f(x) == (if terminates(f, x) | H(f, while(f, x)) | anything))
          )(MP_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                (
                  FIRST_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(WF_REC))) then_tac \
                  REPEAT(STRIP_TAC)
                ) then_tac \
                MATCH_MP_TAC(
                  MESON(
                    PairList [])(
                    (hol:
                       var a :: bool
                       var b :: bool
                       var x :: #{?26061}
                       var y :: #{?26061}
                       var f :: #{?26061} -> #{?26049}
                       var g :: #{?26061} -> #{?26049}
                       var d :: #{?26049}
                       (a <=> b) && (a && b ==> x == y && f(x) == g(x)) ==> (if a | f(x) | d) == (if b | g(y) | d))
                  )
                )
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_list \
            PairList [
              (
                (
                  (
                    (
                      (
                        (
                          (
                            SUBGOAL_THEN(
                              (hol:
                                 var P :: (A -> B) -> A -> bool
                                 var ll as "<<" :: A -> A -> bool
                                 var G :: (A -> B) -> A -> A
                                 var terminates :: (A -> B) -> A -> bool
                                 forall (f :: A -> B, g :: A -> B, x :: A):
                                   ((forall (x :: A, y :: A): P(f, x) && ll(y, G(f, x)) ==> ll(y, x))
                                      && (forall y :: A:
                                            (forall z :: A: ll(z, y) ==> ll(z, x))
                                              ==> (P(f, y) <=> P(g, y)) && G(f, y) == G(g, y)))
                                     ==> terminates(f, x)
                                     ==> terminates(g, x))
                            )(
                              (fun(th): ((EQ_TAC then_tac MATCH_MP_TAC(th)) then_tac ASM_MESON_TAC(PairList [])))
                            ) then_tac \
                            GEN_TAC
                          ) then_tac \
                          GEN_TAC
                        ) then_tac \
                        REWRITE_TAC(PairList [RIGHT_FORALL_IMP_THM, IMP_CONJ])
                      ) then_tac \
                      DISCH_TAC
                    ) then_tac \
                    ONCE_REWRITE_TAC(
                      PairList [
                        TAUT(
                          (hol:
                             var a :: bool
                             var b :: bool
                             var c :: bool
                             a ==> b ==> c <=> b ==> a ==> c)
                        )
                      ]
                    )
                  ) then_tac \
                  FIRST_X_ASSUM(MATCH_MP_TAC)
                ) then_tac \
                ASM_MESON_TAC(PairList [])
              ),
              (
                (
                  (
                    SUBGOAL_THEN(
                      (hol:
                         var terminates :: (A -> B) -> A -> bool
                         var f :: A -> B
                         var ll as "<<" :: A -> A -> bool
                         var P :: (A -> B) -> A -> bool
                         var g :: A -> B
                         var G :: (A -> B) -> A -> A
                         var while :: (A -> B) -> A -> A
                         forall x :: A:
                           (terminates(f, x)
                              && (forall y :: A:
                                    (forall z :: A: ll(z, y) ==> ll(z, x))
                                      ==> (P(f, y) <=> P(g, y)) && G(f, y) == G(g, y)))
                             ==> while(f, x) == while(g, x))
                    )((fun(th): (MATCH_MP_TAC(th) then_tac ASM_MESON_TAC(PairList [])))) then_tac \
                    REWRITE_TAC(PairList [IMP_CONJ])
                  ) then_tac \
                  FIRST_X_ASSUM(MATCH_MP_TAC)
                ) then_tac \
                ASM_MESON_TAC(PairList [])
              ),
              (
                (
                  (
                    (
                      (
                        FIRST_X_ASSUM(MATCH_MP_TAC) then_tac \
                        SUBGOAL_THEN(
                          (hol:
                             var P :: (A -> B) -> A -> bool
                             var ll as "<<" :: A -> A -> bool
                             var G :: (A -> B) -> A -> A
                             var terminates :: (A -> B) -> A -> bool
                             var while :: (A -> B) -> A -> A
                             forall f :: A -> B:
                               (forall (x :: A, y :: A): P(f, x) && ll(y, G(f, x)) ==> ll(y, x))
                                 ==> (forall x :: A: terminates(f, x) ==> (forall y :: A: ll(y, while(f, x)) ==> ll(y, x))))
                        )((fun(th): ASM_MESON_TAC(PairList [th])))
                      ) then_tac \
                      GEN_TAC
                    ) then_tac \
                    DISCH_TAC
                  ) then_tac \
                  FIRST_X_ASSUM(MATCH_MP_TAC)
                ) then_tac \
                ASM_MESON_TAC(PairList [])
              )
            ]
          ),
          (
            (
              (
                (
                  (
                    (MATCH_MP_TAC(MONO_EXISTS) then_tac GEN_TAC) then_tac \
                    DISCH_THEN((fun(th): (ASSUME_TAC(GSYM(th)) then_tac MP_TAC(th))))
                  ) then_tac \
                  MATCH_MP_TAC(MONO_FORALL)
                ) then_tac \
                X_GEN_TAC(hol: var x :: A; x)
              ) then_tac \
              ASM_CASES_TAC(
                (hol:
                   var P :: (A -> B) -> A -> bool
                   var f :: A -> B
                   var x :: A
                   P(f, x))
              )
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

def WF_INDUCT_TAC:
  let pth:
    prove(
      [
        (hol:
           var P :: #{?26326} -> bool
           var Q :: #{?26326} -> #{?26325} -> bool
           (forall x :: #{?26326}: P(x) ==> (forall y :: #{?26325}: Q(x, y)))
             <=> (forall (y :: #{?26325}, x :: #{?26326}): P(x) ==> Q(x, y))),
        MESON_TAC(PairList [])
      ]
    )
  let qqconv_2 = GEN_REWRITE_CONV(I)(PairList [pth])
  let pth:
    prove(
      [
        (hol:
           var P :: #{?26344} -> bool
           var e :: #{?26344}
           var Q :: bool
           (forall m :: #{?26344}: P(m) ==> m == e ==> Q) <=> P(e) ==> Q),
        MESON_TAC(PairList [])
      ]
    )
  let eqconv_2 = REWR_CONV(pth)
  fun qqconvs(tm):
    try:
      (qqconv_2 then_conv BINDER_CONV(qqconvs))(tm)
      ~catch exn:
        match exn
        | Failure(_): eqconv_2(tm)
        | exn: (throw exn)
  fun(tm):
    fun([asl, w] as gl):
      let fvs_2 = frees(tm)
      let gv_2 = genvar(type_of(tm))
      let pat = list_mk_forall([PairList [gv_2, & fvs_2], mk_imp([mk_eq([gv_2, tm]), w])])
      let th0 = UNDISCH(PART_MATCH(rand)(num_WF)(pat))
      let th1 = MP(SPECL(PairList [tm, & fvs_2])(th0))(REFL(tm))
      let th2 = CONV_RULE(LAND_CONV(qqconvs))(DISCH_ALL(th1))
      (
        (
          (MATCH_MP_TAC(th2) then_tac MAP_EVERY(X_GEN_TAC)(fvs_2)) then_tac \
          CONV_TAC(LAND_CONV(qqconvs))
        ) then_tac \
        DISCH_THEN(ASSUME_TAC)
      )(gl)
