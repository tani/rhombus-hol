                Implies(
                  And(App(Ref("<<"), [Ref("x"), Ref("y")]), App(Ref("<<"), [Ref("y"), Ref("z")])),
                  App(Ref("<<"), [Ref("x"), Ref("z")])
                )
              )
            )
          ),
          Iff(
            App(Const("WF", Fun(Fun(Tvar("A"), Fun(Tvar("A"), Bool)), Bool)), [Ref("<<")]),
            Not(
              Exists(
                "s",
                Fun(Num, Tvar("A")),
                Forall(
                  "i",
                  Num,
                  Forall(
                    "j",
                    Num,
                    Implies(
                      App(Const("<", Fun(Num, Fun(Num, Bool))), [Ref("i"), Ref("j")]),
                      App(Ref("<<"), [App(Ref("s"), [Ref("j")]), App(Ref("s"), [Ref("i")])])
                    )
                  )
                )
              )
            )
          )
        )
      )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      ((GEN_TAC then_tac DISCH_TAC) then_tac REWRITE_TAC(PairList [WF_DCHAIN])) then_tac \
                      AP_TERM_TAC
                    ) then_tac \
                    EQ_TAC
                  ) then_tac \
                  MATCH_MP_TAC(MONO_EXISTS)
