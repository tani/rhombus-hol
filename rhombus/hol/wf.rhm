         var ll as "<<" :: A -> A -> bool
         const WF :: (A -> A -> bool) -> bool
         WF(ll)
           ==> (forall H :: (A -> B) -> A -> B:
                  (forall (f :: A -> B, g :: A -> B, x :: A):
                     (forall z :: A: ll(z, x) ==> f(z) == g(z)) ==> H(f, x) == H(g, x))
                    ==> (exists1 f :: A -> B: forall x :: A: f(x) == H(f, x)))),
      MESON_TAC(PairList [WF_REC, WF_UREC])
    ]
  )

def WF_REC_EXISTS:
  prove(
    [
      (hol:
         var ll as "<<" :: A -> A -> bool
         const WF :: (A -> A -> bool) -> bool
         WF(ll)
           ==> (forall P :: (A -> B) -> A -> B -> bool:
                  ((forall (f :: A -> B, g :: A -> B, x :: A, y :: B):
                      (forall z :: A: ll(z, x) ==> f(z) == g(z)) ==> (P(f, x, y) <=> P(g, x, y)))
                     && (forall (f :: A -> B, x :: A):
                           (forall z :: A: ll(z, x) ==> P(f, z, f(z))) ==> (exists y :: B: P(f, x, y))))
                    ==> (exists f :: A -> B: forall x :: A: P(f, x, f(x))))),
      (
        (
          REPEAT(STRIP_TAC) then_tac \
          SUBGOAL_THEN(
            (hol:
               var P :: (A -> B) -> A -> B -> bool
               const select as "@" :: (B -> bool) -> B
               exists f :: A -> B: forall x :: A: f(x) == select(fun (y :: B): P(f, x, y)))
          )(MP_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    FIRST_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(WF_REC))) then_tac \
                    REPEAT(STRIP_TAC)
                  ) then_tac \
                  AP_TERM_TAC
                ) then_tac \
                ABS_TAC
              ) then_tac \
              FIRST_X_ASSUM(MATCH_MP_TAC)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ),
          (
            (
              (
                (
                  (
                    MATCH_MP_TAC(MONO_EXISTS) then_tac \
                    X_GEN_TAC(hol: var f :: A -> B; f)
                  ) then_tac \
                  DISCH_THEN((fun(th): (ONCE_REWRITE_TAC(PairList [th]) then_tac ASSUME_TAC(GSYM(th)))))
                ) then_tac \
                CONV_TAC(BINDER_CONV(SELECT_CONV))
              ) then_tac \
              FIRST_ASSUM(o(MATCH_MP_TAC)(GEN_REWRITE_RULE(I)(PairList [WF_IND])))
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

Host.parse_as_infix(["<<<", [12, "right"]])

def WF_SUBSET:
  prove(
    [
      (hol:
         const WF :: (A -> A -> bool) -> bool
         forall (ll as "<<" :: A -> A -> bool, lll as "<<<" :: A -> A -> bool):
           (forall (x :: A, y :: A): ll(x, y) ==> lll(x, y)) && WF(lll) ==> WF(ll)),
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(GEN_TAC) then_tac \
                    DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC))
                  ) then_tac \
                  REWRITE_TAC(PairList [WF])
                ) then_tac \
                DISCH_TAC
              ) then_tac \
              GEN_TAC
            ) then_tac \
            DISCH_THEN(ANTE_RES_THEN(MP_TAC))
          ) then_tac \
          UNDISCH_TAC(
            (hol:
               var ll as "<<" :: A -> A -> bool
               var lll as "<<<" :: A -> A -> bool
               forall (x :: A, y :: A): ll(x, y) ==> lll(x, y))
          )
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

