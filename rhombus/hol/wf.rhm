def MINIMAL_BAD_SEQUENCE:
  prove(
    [
      Host.hol_term(Forall(
        "<<",
        Fun(Tvar("A"), Fun(Tvar("A"), Bool)),
        Forall(
          "bad",
          Fun(Fun(Num, Tvar("A")), Bool),
          Implies(
            And(
              App(Const("WF", Fun(Fun(Tvar("A"), Fun(Tvar("A"), Bool)), Bool)), [Ref("<<")]),
              And(
                Forall(
                  "x",
                  Fun(Num, Tvar("A")),
                  Implies(
                    Not(App(Ref("bad"), [Ref("x")])),
                    Exists(
                      "n",
                      Num,
                      Forall(
                        "y",
                        Fun(Num, Tvar("A")),
                        Implies(
                          Forall(
                            "k",
                            Num,
                            Implies(
                              App(Const("<", Fun(Num, Fun(Num, Bool))), [Ref("k"), Ref("n")]),
                              Eq(Tvar("A"), App(Ref("y"), [Ref("k")]), App(Ref("x"), [Ref("k")]))
                            )
                          ),
                          Not(App(Ref("bad"), [Ref("y")]))
                        )
                      )
                    )
                  )
                ),
                Exists("x", Fun(Num, Tvar("A")), App(Ref("bad"), [Ref("x")]))
              )
            ),
            Exists(
              "y",
              Fun(Num, Tvar("A")),
              And(
                App(Ref("bad"), [Ref("y")]),
                Forall(
                  "z",
                  Fun(Num, Tvar("A")),
                  Forall(
                    "n",
                    Num,
                    Implies(
                      And(
                        App(Ref("bad"), [Ref("z")]),
                        Forall(
                          "k",
                          Num,
                          Implies(
                            App(Const("<", Fun(Num, Fun(Num, Bool))), [Ref("k"), Ref("n")]),
                            Eq(Tvar("A"), App(Ref("z"), [Ref("k")]), App(Ref("y"), [Ref("k")]))
