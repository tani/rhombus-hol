def WF_LEX_DEPENDENT:
  prove(
    [
      (hol:
         const WF :: (A -> A -> bool) -> bool
         const WF_2 as WF :: (B -> B -> bool) -> bool
         const WF_3 as WF :: (pair(A, B) -> pair(A, B) -> bool) -> bool
         const GABS :: ((pair(A, B) -> pair(A, B) -> bool) -> bool) -> pair(A, B) -> pair(A, B) -> bool
         const GEQ :: (pair(A, B) -> bool) -> (pair(A, B) -> bool) -> bool
         const comma as "," :: A -> B -> pair(A, B)
         const GABS_2 as GABS :: ((pair(A, B) -> bool) -> bool) -> pair(A, B) -> bool
         const GEQ_2 as GEQ :: bool -> bool -> bool
         forall (R :: A -> A -> bool, S :: A -> B -> B -> bool):
           WF(R) && (forall a :: A: WF_2(S(a)))
             ==> WF_3(
                   GABS(
                     fun (f :: pair(A, B) -> pair(A, B) -> bool):
                       forall (r1 :: A, s1 :: B):
                         GEQ(
                           f(comma(r1, s1)),
                           GABS_2(
                             fun (f :: pair(A, B) -> bool):
                               forall (r2 :: A, s2 :: B):
                                 GEQ_2(f(comma(r2, s2)), R(r1, r2) || r1 == r2 && S(r1, s1, s2))
                           )
                         )
                   )
                 )),
      (
        (
          (
            (
              (
                (
                  (
                    (
                      (
                        (
                          (
                            (
                              (
                                (
                                  (
                                    (
                                      (
                                        (
                                          (
                                            (
                                              (
                                                (
                                                  (REPEAT(GEN_TAC) then_tac REWRITE_TAC(PairList [WF])) then_tac \
                                                  STRIP_TAC
                                                ) then_tac \
                                                X_GEN_TAC(hol: var P :: pair(A, B) -> bool; P)
                                              ) then_tac \
                                              REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM])
                                            ) then_tac \
                                            GEN_REWRITE_TAC(I)(PairList [FORALL_PAIR_THM])
                                          ) then_tac \
                                          MAP_EVERY(X_GEN_TAC)(PairList [(hol: var a0 :: A; a0), (hol: var b0 :: B; b0)])
                                        ) then_tac \
                                        DISCH_TAC
                                      ) then_tac \
                                      FIRST_X_ASSUM(
                                        o(MP_TAC)(
                                          SPEC(
                                            (hol:
                                               var P :: pair(A, B) -> bool
                                               const comma as "," :: A -> B -> pair(A, B)
                                               fun (a :: A): exists b :: B: P(comma(a, b)))
                                          )
                                        )
                                      )
                                    ) then_tac \
                                    REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM])
                                  ) then_tac \
                                  DISCH_THEN(
                                    o(MP_TAC)(
                                      SPECL(PairList [(hol: var a0 :: A; a0), (hol: var b0 :: B; b0)])
                                    )
                                  )
                                ) then_tac \
                                ASM_REWRITE_TAC(PairList [])
                              ) then_tac \
                              DISCH_THEN(
                                X_CHOOSE_THEN(hol: var a :: A; a)(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC))
                              )
                            ) then_tac \
                            DISCH_THEN(X_CHOOSE_TAC(hol: var b1 :: B; b1))
                          ) then_tac \
                          FIRST_X_ASSUM(
                            o(MP_TAC)(
                              SPECL(
                                PairList [
                                  (hol: var a :: A; a),
                                  (hol:
                                     var P :: pair(A, B) -> bool
                                     var a :: A
                                     const comma as "," :: A -> B -> pair(A, B)
                                     fun (b :: B): P(comma(a, b)))
                                ]
                              )
                            )
                          )
                        ) then_tac \
                        REWRITE_TAC(PairList [LEFT_IMP_EXISTS_THM])
                      ) then_tac \
                      DISCH_THEN(o(MP_TAC)(SPEC(hol: var b1 :: B; b1)))
                    ) then_tac \
                    ASM_REWRITE_TAC(PairList [])
                  ) then_tac \
                  DISCH_THEN(
                    X_CHOOSE_THEN(hol: var b :: B; b)(CONJUNCTS_THEN2(MP_TAC)(ASSUME_TAC))
                  )
                ) then_tac \
                DISCH_TAC
              ) then_tac \
              EXISTS_TAC(
                (hol:
                   var a :: A
                   var b :: B
                   const comma as "," :: A -> B -> pair(A, B)
                   comma(a, b))
              )
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ) then_tac \
          REWRITE_TAC(PairList [FORALL_PAIR_THM])
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

def WF_LEX:
  prove(
    [
      (hol:
         const WF :: (A -> A -> bool) -> bool
         const WF_2 as WF :: (B -> B -> bool) -> bool
         const WF_3 as WF :: (pair(A, B) -> pair(A, B) -> bool) -> bool
         const GABS :: ((pair(A, B) -> pair(A, B) -> bool) -> bool) -> pair(A, B) -> pair(A, B) -> bool
         const GEQ :: (pair(A, B) -> bool) -> (pair(A, B) -> bool) -> bool
         const comma as "," :: A -> B -> pair(A, B)
         const GABS_2 as GABS :: ((pair(A, B) -> bool) -> bool) -> pair(A, B) -> bool
         const GEQ_2 as GEQ :: bool -> bool -> bool
         forall (R :: A -> A -> bool, S :: B -> B -> bool):
           WF(R) && WF_2(S)
             ==> WF_3(
                   GABS(
                     fun (f :: pair(A, B) -> pair(A, B) -> bool):
                       forall (r1 :: A, s1 :: B):
                         GEQ(
                           f(comma(r1, s1)),
                           GABS_2(
                             fun (f :: pair(A, B) -> bool):
                               forall (r2 :: A, s2 :: B):
                                 GEQ_2(f(comma(r2, s2)), R(r1, r2) || r1 == r2 && S(s1, s2))
                           )
                         )
                   )
                 )),
      SIMP_TAC(PairList [WF_LEX_DEPENDENT, ETA_AX])
    ]
  )

def WF_POINTWISE:
  prove(
    [
      (hol:
         var ll as "<<" :: A -> A -> bool
         var lll as "<<<" :: B -> B -> bool
         const WF :: (A -> A -> bool) -> bool
         const WF_2 as WF :: (B -> B -> bool) -> bool
         const WF_3 as WF :: (pair(A, B) -> pair(A, B) -> bool) -> bool
         const GABS :: ((pair(A, B) -> pair(A, B) -> bool) -> bool) -> pair(A, B) -> pair(A, B) -> bool
         const GEQ :: (pair(A, B) -> bool) -> (pair(A, B) -> bool) -> bool
         const comma as "," :: A -> B -> pair(A, B)
         const GABS_2 as GABS :: ((pair(A, B) -> bool) -> bool) -> pair(A, B) -> bool
         const GEQ_2 as GEQ :: bool -> bool -> bool
         WF(ll) && WF_2(lll)
           ==> WF_3(
                 GABS(
                   fun (f :: pair(A, B) -> pair(A, B) -> bool):
                     forall (x1 :: A, y1 :: B):
                       GEQ(
                         f(comma(x1, y1)),
                         GABS_2(
                           fun (f :: pair(A, B) -> bool):
                             forall (x2 :: A, y2 :: B):
                               GEQ_2(f(comma(x2, y2)), ll(x1, x2) && lll(y1, y2))
                         )
                       )
                 )
               )),
      (
        (
          (
            (STRIP_TAC then_tac MATCH_MP_TAC(WF_SUBSET)) then_tac \
            EXISTS_TAC(
              (hol:
                 var ll as "<<" :: A -> A -> bool
                 var lll as "<<<" :: B -> B -> bool
                 const GABS :: ((pair(A, B) -> pair(A, B) -> bool) -> bool) -> pair(A, B) -> pair(A, B) -> bool
                 const GEQ :: (pair(A, B) -> bool) -> (pair(A, B) -> bool) -> bool
                 const comma as "," :: A -> B -> pair(A, B)
                 const GABS_2 as GABS :: ((pair(A, B) -> bool) -> bool) -> pair(A, B) -> bool
                 const GEQ_2 as GEQ :: bool -> bool -> bool
                 GABS(
                   fun (f :: pair(A, B) -> pair(A, B) -> bool):
                     forall (x1 :: A, y1 :: B):
                       GEQ(
                         f(comma(x1, y1)),
                         GABS_2(
                           fun (f :: pair(A, B) -> bool):
                             forall (x2 :: A, y2 :: B):
                               GEQ_2(f(comma(x2, y2)), ll(x1, x2) || x1 == x2 && lll(y1, y2))
                         )
                       )
                 ))
            )
          ) then_tac \
          CONJ_TAC
        ) then_list \
        PairList [
          (REWRITE_TAC(PairList [FORALL_PAIR_THM]) then_tac CONV_TAC(TAUT)),
          (MATCH_MP_TAC(WF_LEX) then_tac ASM_REWRITE_TAC(PairList []))
        ]
      )
    ]
  )

