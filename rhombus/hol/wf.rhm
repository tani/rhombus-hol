def WF_REC_INVARIANT:
  let lemma:
    prove_inductive_relations_exist(
      (hol:
         var ll as "<<" :: A -> A -> bool
         var R :: A -> B -> bool
         var H :: (A -> B) -> A -> B
         forall (f :: A -> B, x :: A): (forall z :: A: ll(z, x) ==> R(z, f(z))) ==> R(x, H(f, x)))
    )
  prove(
    [
      (hol:
         var ll as "<<" :: A -> A -> bool
         const WF :: (A -> A -> bool) -> bool
         WF(ll)
           ==> (forall (H :: (A -> B) -> A -> B, S :: A -> B -> bool):
                  (forall (f :: A -> B, g :: A -> B, x :: A):
                     (forall z :: A: ll(z, x) ==> f(z) == g(z) && S(z, f(z)))
                       ==> H(f, x) == H(g, x) && S(x, H(f, x)))
                    ==> (exists f :: A -> B: forall x :: A: f(x) == H(f, x)))),
      (
        (
          (
            (
              (
                (
                  (
                    (REWRITE_TAC(PairList [WF_IND]) then_tac REPEAT(STRIP_TAC)) then_tac \
                    X_CHOOSE_THEN(hol: var R :: A -> B -> bool; R)(STRIP_ASSUME_TAC)(lemma)
                  ) then_tac \
                  SUBGOAL_THEN(
                    (hol:
                       var R :: A -> B -> bool
                       forall x :: A: exists1 y :: B: R(x, y))
                  )((fun(th): ASM_MESON_TAC(PairList [th])))
                ) then_tac \
                FIRST_X_ASSUM(MATCH_MP_TAC)
              ) then_tac \
              REPEAT(STRIP_TAC)
            ) then_tac \
            FIRST_X_ASSUM((fun(th): GEN_REWRITE_TAC(BINDER_CONV)(PairList [th])))
          ) then_tac \
          SUBGOAL_THEN(
            (hol:
               var R :: A -> B -> bool
               var S :: A -> B -> bool
               forall (x :: A, y :: B): R(x, y) ==> S(x, y))
          )(MP_TAC)
        ) then_tac \
        ASM_MESON_TAC(PairList [])
      )
    ]
  )

