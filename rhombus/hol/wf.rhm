                            (
                              (
                                (DISCH_TAC then_tac REWRITE_TAC(PairList [WF_DCHAIN])) then_tac \
                                DISCH_THEN(X_CHOOSE_TAC(@hol|{x:num->A}|))
                              ) then_tac \
                              SUBGOAL_THEN(
                                @hol|{!n. (x:num->A)(@m. x(m) << x(n)) << x(n)}|
                              )(ASSUME_TAC)
                            ) then_list \
                            PairList [
                              (CONV_TAC(BINDER_CONV(SELECT_CONV)) then_tac ASM_MESON_TAC(PairList [])),
                              ALL_TAC
                            ]
                          ) then_tac \
                          FIRST_ASSUM(
                            o(MP_TAC)(
                              SPEC(
                                @hol|{\f:A->num. \y:A. if ?p:num. y = x(p)
                                   then SUC(f(x(@m. x(m) << y)))
                                   else 0}|
                              )
                            )
                          )
                        ) then_tac \
                        REWRITE_TAC(PairList [NOT_IMP])
                      ) then_tac \
                      CONJ_TAC
                    ) then_list \
                    PairList [
                      (
                        (
                          (
                            (
                              (
                                (REPEAT(STRIP_TAC) then_tac COND_CASES_TAC) then_tac \
                                REWRITE_TAC(PairList [])
                              ) then_tac \
                              FIRST_ASSUM(X_CHOOSE_THEN(@hol|{p:num}|)(SUBST_ALL_TAC))
                            ) then_tac \
                            AP_TERM_TAC
                          ) then_tac \
                          FIRST_ASSUM(MATCH_MP_TAC)
                        ) then_tac \
                        FIRST_ASSUM(MATCH_ACCEPT_TAC)
                      ),
                      ALL_TAC
                    ]
                  ) then_tac \
                  DISCH_THEN(X_CHOOSE_THEN(@hol|{f:A->num}|)(MP_TAC))
                ) then_tac \
                DISCH_THEN(
                  o(o(MP_TAC)(GEN(@hol|{n:num}|)))(SPEC(@hol|{(x:num->A) n}|))
                )
              ) then_tac \
              SUBGOAL_THEN(
                @hol|{!n. ?p. (x:num->A) n = x p}|
              )((fun(th): REWRITE_TAC(PairList [th])))
            ) then_list \
            PairList [MESON_TAC(PairList []), DISCH_TAC]
          ) then_tac \
          SUBGOAL_THEN(
            @hol|{!n:num. ?k. f(x(k):A) < f(x(n))}|
          )(ASSUME_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                GEN_TAC then_tac \
                EXISTS_TAC(
                  @hol|{@m:num. x(m):A << x(n)}|
                )
              ) then_tac \
              FIRST_ASSUM((fun(th): GEN_REWRITE_TAC(RAND_CONV)(PairList [th])))
            ) then_tac \
            REWRITE_TAC(PairList [LT])
          ),
          (
            (
              MP_TAC(
                SPEC(
                  @hol|{\n:num. ?i:num. n = f(x(i):A)}|
                )(num_WOP)
              ) then_tac \
              REWRITE_TAC(PairList [])
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

def WF_EREC:
  prove(
    [
      @hol|{WF(<<) ==>
         !H. (!f g x. (!z. z << x ==> (f z = g z)) ==> (H f x = H g x))
              ==> ?!f:A->B. !x. f x = H f x}|,
      MESON_TAC(PairList [WF_REC, WF_UREC])
    ]
  )

def WF_REC_EXISTS:
  prove(
    [
      @hol|{WF((<<):A->A->bool)
         ==> !P. (!f g x y. (!z. z << x ==> f z = g z) ==> (P f x y <=> P g x y)) /\
                 (!f x. (!z. z << x ==> P f z (f z)) ==> ?y. P f x y)
                 ==> ?f:A->B. !x. P f x (f x)}|,
      (
        (
          REPEAT(STRIP_TAC) then_tac \
          SUBGOAL_THEN(
            @hol|{?f:A->B. !x. f x = @y. P f x y}|
          )(MP_TAC)
        ) then_list \
        PairList [
          (
            (
              (
                (
                  (
                    FIRST_ASSUM(o(MATCH_MP_TAC)(MATCH_MP(WF_REC))) then_tac \
                    REPEAT(STRIP_TAC)
                  ) then_tac \
                  AP_TERM_TAC
                ) then_tac \
                ABS_TAC
              ) then_tac \
              FIRST_X_ASSUM(MATCH_MP_TAC)
            ) then_tac \
            ASM_REWRITE_TAC(PairList [])
          ),
          (
            (
              (
                (
                  (
                    MATCH_MP_TAC(MONO_EXISTS) then_tac \
                    X_GEN_TAC(@hol|{f:A->B}|)
                  ) then_tac \
                  DISCH_THEN((fun(th): (ONCE_REWRITE_TAC(PairList [th]) then_tac ASSUME_TAC(GSYM(th)))))
                ) then_tac \
                CONV_TAC(BINDER_CONV(SELECT_CONV))
              ) then_tac \
              FIRST_ASSUM(o(MATCH_MP_TAC)(GEN_REWRITE_RULE(I)(PairList [WF_IND])))
            ) then_tac \
            ASM_MESON_TAC(PairList [])
          )
        ]
      )
    ]
  )

Host.parse_as_infix(["<<<", [12, "right"]])

def WF_SUBSET:
  prove(
    [
      @hol|{!(<<) (<<<). (!(x:A) y. x << y ==> x <<< y) /\ WF(<<<) ==> WF(<<)}|,
      (
        (
          (
            (
              (
                (
                  (
                    REPEAT(GEN_TAC) then_tac \
                    DISCH_THEN(CONJUNCTS_THEN2(ASSUME_TAC)(MP_TAC))
                  ) then_tac \
                  REWRITE_TAC(PairList [WF])
                ) then_tac \
                DISCH_TAC
              ) then_tac \
              GEN_TAC
            ) then_tac \
            DISCH_THEN(ANTE_RES_THEN(MP_TAC))
          ) then_tac \
          UNDISCH_TAC(
            @hol|{!(x:A) (y:A). x << y ==> x <<< y}|
          )
        ) then_tac \
        MESON_TAC(PairList [])
      )
    ]
  )

