def WF_INDUCT_TAC:
  let pth:
    prove(
      [
        Host.hol_term(Iff(
          Forall(
            "x",
            Tvar("?26326"),
            Implies(
              App(Var("P", Fun(Tvar("?26326"), Bool)), [Ref("x")]),
              Forall(
                "y",
                Tvar("?26325"),
                App(Var("Q", Fun(Tvar("?26326"), Fun(Tvar("?26325"), Bool))), [Ref("x"), Ref("y")])
              )
            )
          ),
          Forall(
            "y",
            Tvar("?26325"),
            Forall(
              "x",
              Tvar("?26326"),
              Implies(
                App(Var("P", Fun(Tvar("?26326"), Bool)), [Ref("x")]),
                App(Var("Q", Fun(Tvar("?26326"), Fun(Tvar("?26325"), Bool))), [Ref("x"), Ref("y")])
              )
            )
          )
        )),
        MESON_TAC(PairList [])
      ]
    )
  let qqconv_2 = GEN_REWRITE_CONV(I)(PairList [pth])
  let pth:
    prove(
      [
        Host.hol_term(Iff(
          Forall(
            "m",
            Tvar("?26344"),
            Implies(
              App(Var("P", Fun(Tvar("?26344"), Bool)), [Ref("m")]),
              Implies(Eq(Tvar("?26344"), Ref("m"), Var("e", Tvar("?26344"))), Var("Q", Bool))
            )
          ),
          Implies(App(Var("P", Fun(Tvar("?26344"), Bool)), [Var("e", Tvar("?26344"))]), Var("Q", Bool))
        )),
        MESON_TAC(PairList [])
      ]
    )
  let eqconv_2 = REWR_CONV(pth)
  fun qqconvs(tm):
    try:
      (qqconv_2 then_conv BINDER_CONV(qqconvs))(tm)
      ~catch exn:
        match exn
        | Failure(_): eqconv_2(tm)
        | exn: (throw exn)
  fun(tm):
    fun([asl, w] as gl):
      let fvs_2 = frees(tm)
      let gv_2 = genvar(type_of(tm))
      let pat = list_mk_forall([PairList [gv_2, & fvs_2], mk_imp([mk_eq([gv_2, tm]), w])])
      let th0 = UNDISCH(PART_MATCH(rand)(num_WF)(pat))
      let th1 = MP(SPECL(PairList [tm, & fvs_2])(th0))(REFL(tm))
      let th2 = CONV_RULE(LAND_CONV(qqconvs))(DISCH_ALL(th1))
      (
        (
          (MATCH_MP_TAC(th2) then_tac MAP_EVERY(X_GEN_TAC)(fvs_2)) then_tac \
          CONV_TAC(LAND_CONV(qqconvs))
        ) then_tac \
        DISCH_THEN(ASSUME_TAC)
      )(gl)
