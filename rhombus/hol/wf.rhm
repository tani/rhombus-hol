           (forall (f :: num -> A, g :: num -> A, n :: num):
              (forall m :: num: m < n ==> f(m) == g(m)) ==> H(f, n) == H(g, n))
             ==> (exists f :: num -> A: forall n :: num: f(n) == H(f, n))),
      MATCH_ACCEPT_TAC(MATCH_MP(WF_REC)(WF_num))
    ]
