def WF_REC_INVARIANT:
  let lemma:
    prove_inductive_relations_exist(
      Host.hol_term(Forall(
        "f",
        Fun(Tvar("A"), Tvar("B")),
        Forall(
          "x",
          Tvar("A"),
          Implies(
            Forall(
              "z",
              Tvar("A"),
              Implies(
                App(Var("<<", Fun(Tvar("A"), Fun(Tvar("A"), Bool))), [Ref("z"), Ref("x")]),
                App(Var("R", Fun(Tvar("A"), Fun(Tvar("B"), Bool))), [Ref("z"), App(Ref("f"), [Ref("z")])])
              )
            ),
            App(
              Var("R", Fun(Tvar("A"), Fun(Tvar("B"), Bool))),
              [
                Ref("x"),
                App(Var("H", Fun(Fun(Tvar("A"), Tvar("B")), Fun(Tvar("A"), Tvar("B")))), [Ref("f"), Ref("x")])
              ]
            )
          )
        )
      ))
    )
  prove(
    [
      Host.hol_term(Implies(
        App(
          Const("WF", Fun(Fun(Tvar("A"), Fun(Tvar("A"), Bool)), Bool)),
          [Var("<<", Fun(Tvar("A"), Fun(Tvar("A"), Bool)))]
        ),
        Forall(
          "H",
          Fun(Fun(Tvar("A"), Tvar("B")), Fun(Tvar("A"), Tvar("B"))),
          Forall(
            "S",
            Fun(Tvar("A"), Fun(Tvar("B"), Bool)),
            Implies(
              Forall(
                "f",
                Fun(Tvar("A"), Tvar("B")),
                Forall(
                  "g",
                  Fun(Tvar("A"), Tvar("B")),
                  Forall(
                    "x",
                    Tvar("A"),
                    Implies(
                      Forall(
                        "z",
                        Tvar("A"),
                        Implies(
                          App(Var("<<", Fun(Tvar("A"), Fun(Tvar("A"), Bool))), [Ref("z"), Ref("x")]),
                          And(
                            Eq(Tvar("B"), App(Ref("f"), [Ref("z")]), App(Ref("g"), [Ref("z")])),
                            App(Ref("S"), [Ref("z"), App(Ref("f"), [Ref("z")])])
                          )
                        )
                      ),
                      And(
                        Eq(Tvar("B"), App(Ref("H"), [Ref("f"), Ref("x")]), App(Ref("H"), [Ref("g"), Ref("x")])),
                        App(Ref("S"), [Ref("x"), App(Ref("H"), [Ref("f"), Ref("x")])])
                      )
                    )
                  )
                )
              ),
              Exists(
                "f",
                Fun(Tvar("A"), Tvar("B")),
                Forall(
                  "x",
                  Tvar("A"),
                  Eq(Tvar("B"), App(Ref("f"), [Ref("x")]), App(Ref("H"), [Ref("f"), Ref("x")]))
                )
              )
            )
          )
